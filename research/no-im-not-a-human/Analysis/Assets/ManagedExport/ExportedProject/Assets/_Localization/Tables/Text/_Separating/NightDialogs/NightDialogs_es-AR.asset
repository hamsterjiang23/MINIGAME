%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_es-AR
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: es-AR
  m_SharedData: {fileID: 11400000, guid: e2adf5c0928e69a42a85516c84d58249, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: Oye. Cof... cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: ¿Podrías dejarme entrar, amigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: ¿Quién eres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: ¿Qué te pasó?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: 'Firefighter: Soy... cof... un bombero.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: 'Firefighter: Quedé expuesto al sol mientras apagábamos incendios forestales hoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: 'Firefighter: La densidad del humo impidió nos quemáramos vivos, pero... cof... aún así fue terrible.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: 'Firefighter: Los árboles... cof... cof... se encendieron como fósforos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: Nunca había visto algo así.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: 'Firefighter: Restos de animales calcinados por todo el bosque.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: ¿Por qué no estás en el hospital?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: ¿Qué vas a hacer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: 'Firefighter: Me agarró el sol de la tarde... cof... cof... mientras apagaba incendios forestales.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: Soy el único que queda de mi escuadrón.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: 'Firefighter: Los demás, ellos... cof... El jefe solo no quiso dejarlos irse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: Ahora estarán de guardia el resto de sus días.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: ¿Por qué no estás en el hospital?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: ¿Qué vas a hacer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: 'Firefighter: ¿El hospital? Ya no hay hospitales, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: 'Firefighter: Cuando llegaron los Visitantes, ya no tenía sentido tener hospitales.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: 'Firefighter: Es difícil recibir tratamiento si no puedes confiar en quien te atiende.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: No hay... cof... quien me ayude ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: 'Firefighter: Estaría mejor apagando fuegos y muriendo con mis amigos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: De todas formas, no me queda mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: 'Firefighter: Me gustaría seguir combatiendo el fuego. Habría preferido morir allí, con los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: 'Firefighter: Pero fueron bastante claros cof... cof... diciendo que ya no podía seguir ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: 'Firefighter: Ahora no puedo volver a casa. El transporte público funciona.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: Así que dependo de la bondad de la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: Gracias, amigo. Cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: 'Firefighter: No creo que vaya a molestarte por mucho tiempo. Cof..'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: 'Firefighter: Al menos no tendré que morir en el suelo húmedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: Mierda. Cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: No quiero morir solo, en la tierra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: 'Firefighter: Espero que... cof... los incendios no se extiendan hasta las ciudades.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: ¡Eeeey, qué onda!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: 'WheelChair: ¡Cuánto tiempo sin verte! ¿Cómo va todo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: ¿Te conozco?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: ¿Quién eres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: 'Wheelchair: Vamos... ¿No me recuerdas?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: Éramos...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: 'Wheelchair: Espera, tienes la voz distinta...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: ¿Hace cuánto vives aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: Esta casa siempre ha sido de mi familia
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: Creo que te equivocaste de dirección
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: Ah, tú no eres...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: Tú no eres mi amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: ¿Cuánto tiempo tienes viviendo aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: Esta casa siempre ha sido de mi familia
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: Creo que te equivocaste de dirección
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: ¡Nah, imposible!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: 'Wheelchair: ¡Yo nunca me he equivocado en nada en toda mi vida! Mi memoria es perfecta. Como la de una elefante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: 'Wheelchair: Mi amigo vive... bueno, vivía aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: 'Wheelchair: Oye, vengo de lejos. ¿Me dejas pasar, por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: ¡Ni hablar! No puedo...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: No...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: ¡Maldición...!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: Supongo que sí me equivoqué.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: 'Wheelchair: Oye, vengo de lejos. ¿No me dejas pasar un ratito, por fis?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: ¡Síii! ¡Ahora sí que estamos hablando!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: Se ve que tienes espacio, ¡vamos a hacer unas carreras! Tres... Dos... Uno... ¡FUERA!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: 'Wheelchair: ¿Irme? ¿Qué carajos?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: 'Wheelchair: ¡¿Tú quieres que yo me vaya a la verga y ya está?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: 'Wheelchair: Ohhhh, me voy rodando. ¡Lunático! ¡Pendejo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: 'Mother: ¡Ya basta! Deja de moverte y quédate quieta de una buena vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: 'Mother: Hola. Por favor, ayúdeme.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: ¿Qué pasó?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: ¿Qué quieres de mí?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: 'Mother: Estoy exhausta. Solo quiero un lugar para dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: Tenía cinco niños. Esta es la única que me queda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: 'Mother: Mi esposo desapareció. No sé si se murió, si nos dejó o qué, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: 'Mother: Ahora solo quisiera acostarme un ratito y dormir por unos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: ¿Qué le pasó a tus otros hijos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: ¿Tus hijos están muertos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: 'Mother: Solo quiero pasar y dormir un poco. Estoy muerta de sueño.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: 'Mother: Antes tenía cinco hijos. Esta es la última que me queda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: 'Mother: Ni siquiera sé donde buscarlos. Solo quiero dormir bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: ¿Qué le pasó a tus otros hijos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: ¿Tus hijos están muertos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: 'Mother: No lo sé. Quizás su papá se los llevó. Quiero ir a su casa, pero ya no me quedan fuerzas para ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: 'Mother: Sí, discutíamos mucho, pero eso es normal cuando vives con alguien que siempre se porta como idiota.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: 'Mother: Olvídelo. Oiga, lo más importante ahora es encontrar a mis hijos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: No diga eso, por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: 'Mother: Es difícil cuidar a un montón de niños inquietos, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: 'Mother: No, no les pasó nada. Seguramente están en casa de mi mamá.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: 'Mother: Siempre se escapan cuando se hartan de mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: 'Mother: O cuando su padre viene a pedirme dinero.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: 'Mother: Entonces, ¿puedo pasar? Solo para descansar un poco y salir a buscar a mis hijos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: Al fin. Un descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: 'Mother: Dale, apúrate. Busca un lugar para que estés.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: Nos vamos mañana. Se lo prometo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: 'Mother: Está bien. Intentaré ir a casa de mi madre, entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: Quizá no lo logre...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: No, tengo que hacerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: Hola, vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: 'Anger: Estoy de mal humor, así que le pido disculpas de antemano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: 'Anger: Con tanto imbécil suelto por ahí... Espero que usted no sea uno de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: ¿A quiénes te refieres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: No eres una de esas... cosas, ¿verdad?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: De todo el mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: 'Anger: De los malditos imbéciles que solo se frenaban por su fe, o lo que sea, cuando la verdad es que se morían de ganas de matarse entre ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: 'Anger: Y cuando su Dios murió, perdieron su humanidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: Ahora solo son unos putos animales.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: 'Anger: Como si esta mierda de los Visitantes no fuera suficiente... También tenemos que aguantarnos a esa gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: ¿Por qué estás tan alterado?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: ¿En qué te diferencias tú de ellos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: Buena pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: 'Anger: Ya se habrá dado cuenta de que hay dos... grupitos de gente, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: 'Anger: En uno hay malditos sádicos. Peores que cualquier Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: 'Anger: Hacen lo que les da la gana: le ponen una escopeta en la cabeza a uno, disparan, ¡y te mandan con San Pedro!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: 'Anger: En el otro solo están los débiles. Los puedes humillar y le agradecerán por no matarlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: Y ambos me sacan de quicio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: ¿Por qué estás tan alterado?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: ¿En qué te diferencias tú de ellos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: 'Anger: No es con usted. Es solo que...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: 'Anger: Después de esta mierda del sol y la llegada de los Visitantes, es como si la humanidad se hubiera muerto con Dios.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: 'Anger: Y estoy molesto... Yo solo quería tener una puta vida normal, ¿sabe?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: 'Anger: Antes componía música. Ahora a nadie le importa eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: Solo no quiero terminar cayendo en ninguno de esos malditos bandos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: Quiero creer que soy diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: 'Anger: ¿Sabe? Me da muchísimo miedo pensar en convertirme en un loco.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: 'Anger: O en una víctima. Ambas cosas son una mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: Aunque...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: Las víctimas son peores.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: 'Anger: Solo se quedan ahí sentadas esperando a que les rompan los dientes o algo peor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: 'Anger: Entendería mi ira si hubiera visto lo mismo que yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: 'Anger: No se preocupe, no molestaré a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: Ni golpearé a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: 'Anger: Dirijo mi ira contra mí mismo para que nadie más sufra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: 'Anger: Carajo, usted tiene la cabeza jodida como el resto de los cobardes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: 'Anger: Dele, siéntese ahí y aguante mientras los demás lo joden.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: Maldita sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: Siento que la energía aquí está estancada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: Algo muy malo está pasando ahí dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: 'FortuneTeller: El Sol y Leo están en la Quinta Casa. Lo veo claramente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: 'FortuneTeller: Eres una persona bastante decidida, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: ¿Ah?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: No quiero nada de ti
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: Veo que eres de actuar mucho y de hablar poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: Típico de Leo, tengo razón, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: 'FortuneTeller: Y has acumulado aquí una gran cantidad de energía desagradable y oscura.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: Todavía no sé cómo ni por qué.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: 'FortuneTeller: Siento que todo está como descuidado. Supongo que debería empezar con afirmaciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: Gracias por meterme más mierda en la cabeza, no es como si ya estuviese estresado ni nada
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: Sí, ajá, ¿y...?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: No es que quiera molestarte, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: 'FortuneTeller: Puedo ayudarte a entender la relación causa y efecto que te trae tanto sufrimiento entre estas paredes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: 'FortuneTeller: Como un sesenta y nueve kármico; dos peces girando en círculos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: 'FortuneTeller: Hoy por mí, mañana por ti. ¿Me entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: Gracias por meterme más mierda en la cabeza, no es como si ya estuviese estresado ni nada
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: Sí, ajá, ¿y...?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: 'FortuneTeller: Entiendo que esto te estresa porque tienes ascendente en Capricornio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: 'FortuneTeller: Estás lidiando con varias constelaciones dentro de ti a la vez. Eres una persona compleja.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: 'FortuneTeller: Podemos usar afirmaciones para alcanzar las profundidades de tu cosmos. ¿Entiendes, verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: 'FortuneTeller: Entonces todo encajará.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: 'FortuneTeller: Veo que han habido muchos celadores en tus encarnaciones previas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: 'FortuneTeller: Dales espacio. Solo estás repitiendo las experiencias de tus vidas pasadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: 'FortuneTeller: Necesitas perdonarlos y aceptar sus historias.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: 'FortuneTeller: Entonces vas a poder romper las cadenas del ciclo sin fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: ¿Me entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: 'FortuneTeller: Excelente. Estás en una posición excelente aquí, para ser sincera.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: Hay una poderosa energía positiva recorriendo tu hogar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: 'FortuneTeller: Así que no te interesa trabajar en ti mismo. ¿Eso es lo que me estás diciendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: ¿No te interesa convertirte en una mejor versión de ti mismo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: Qué tragedia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: 'FortuneTeller: Me aseguraré de manifestarte una diarrea explosiva para que aprendas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: Buenas noches.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: 'Gasmask: Soy de la AFAE. Estamos dando una vuelta por su vecindario.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: ¿Está solo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: ¿Por qué debería confiar en usted?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: No, claro que no.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: 'Gasmask: Mi escuadrón se dividió en grupos pequeños para cubrir más terreno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: Esta conversación no debería tomarle mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: ¿Por qué tiene equipo de protección? ¿Nosotros también lo necesitamos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: ¿Cómo nos van a ayudar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: Le puedo mostrar mis credenciales, si eso le da tranquilidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: 'Gasmask: De todas formas, los Visitantes no tienden a movilizarse en grupo. Quizás nunca lo hagan.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: ¿Por qué tiene equipo de protección? ¿Nosotros también lo necesitamos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: ¿Cómo nos van a ayudar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: 'Gasmask: No. Pero puede comprarlo si lo considera necesario.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: 'Gasmask: Estamos estudiando el efecto del Sol en el medio ambiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: 'Gasmask: Como pasamos tanto tiempo bajo el Sol es importante que seamos cuidadosos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: ¿Y luego qué?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: ¿Tienen un plan de acción?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: 'Gasmask: Nuestra primera tarea es recopilar datos para enviar a los jefes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: Luego ellos desarrollarán un procedimiento de respuesta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: 'Gasmask: Ahora mismo, solo necesitas mantener la calma.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: ¿Y luego qué?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: ¿Tienen un plan de acción?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: Voy a llevarme a una persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: 'Gasmask: Le haremos unas pruebas para asegurarnos que esté bien y de que es seguro vivir en esta zona.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: 'Gasmask: Y verificaremos que sean humanos, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: ¿Tengo que empacar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: Entonces, ¿solo debo esperar a que pase algo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: 'Gasmask: Por supuesto. No podemos ejecutar un plan sin pruebas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: Nos llevaremos a alguien que esté contigo a nuestro laboratorio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: 'Gasmask: Solo le harán unas cuantas pruebas para asegurarnos de que todo está bien y luego lo traeremos de vuelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: ¿Tengo que empacar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: Entonces, ¿solo debo esperar a que pase algo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: ¿Esta es su casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: 'Gasmask: Entonces no. Quédese con los otros residentes. Si necesitan evacuar, les avisaremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: Solo vamos a llevarnos a alguien y nos iremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: Que tenga una buena noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: 'Gasmask: Sí. Cuando tengamos toda la información, daremos instrucciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: Por ahora, no tiene de qué preocuparse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: 'Gasmask: Solo vamos a llevarnos a una persona e intentaremos regresarla lo antes posible.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: Bueno, cuídese.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: 'Prophet: Así que, nos volvemos a encontrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: 'Prophet: Recuerdo que las cosas eran algo diferentes la última vez que nos vimos. Pero seguimos vivos...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: 'Prophet: Mmm... Algo raro está pasando... no sé cómo explicarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: 'Prophet: Me gustaría empezar a conversar... con una predicción.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: 'Prophet: ¿Puedes decirme mi fortuna con este libro? ¿Qué página debo abrir?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: Por alguna parte al principio
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: Ábrelo por la mitad
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: Ábrelo hacia el final
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: 'Prophet: "Los muertos hablarán, pero nadie prestará atención a sus palabras".'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: Dios mío...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: Esto es muy importante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: Aunque no me parece que sea una gran sorpresa ahorita.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: ¿Qué significa?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: ¿De verdad crees eso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: "¿Quién eres...?"'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: 'Prophet: "¿Yo? Yo soy yo. ¿Y tú? Tú estás en casa."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: 'Prophet: Mmm... Sí. Una historia verdaderamente trágica.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: 'Prophet: ¿Es esto lo que nos espera?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: Es muy posible.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: ¿Qué significa?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: ¿En serio te crees lo que dices?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: 'Prophet: "Fue hace tanto tiempo. Quizás fue un sueño. Tal vez tú, yo, y hasta el pez...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: 'Prophet: ...solo existimos en la memoria de alguien que hace mucho que ya no está.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: 'Prophet: Quizás nadie existe en realidad y solo está lloviendo fuera".'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: Mmm... Se siente como si todo pudiera desaparecer muy, muy pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: 'Prophet: ¿Y tú qué piensas? ¿Vivimos en el sueño de alguien más? ¿O somos la persona que sueña?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: Esa es una frase interesante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: ¿Qué significa?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: ¿De verdad crees eso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: 'Prophet: Necesito pensarlo. ¿A ti qué te parece?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: Como sea, vine aquí para contarle algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: Van a empezar a pasar ciertas cosas...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: Necesitas estar preparado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: 'Prophet: Quizás suene extraño... pero debes dejar que el gato entre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: 'Prophet: No puedo explicar cómo, pero tengo la certeza de que te ayudará.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: 'Prophet: Claro, puedes hacer lo que quieras con esta información.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: 'Prophet: Por ahora, pensaré en el significado de tu predicción.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: No del todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: 'Prophet: Yo lo vería como un consejo. Para que atiendas un asunto pendiente, o para que le prestes atención a algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: Ahora que estaba pensando en qué significa eso, un mensaje se manifestó en mi mente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: 'Prophet: Cuando la mirada del gato se cruce con la tuya, asegúrate de dejarlo pasar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: Todavía no puedo decir por qué. Pero eso debería facilitarte las cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: 'Prophet: Por ahora, debería irme a pensar sobre tu selección del libro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: Hola, humano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: 'Fanatic: ¡Qué suerte tenemos! Hemos presenciado el castigo de la lujuria humana con nuestros propios ojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: 'Fanatic: La Tierra está siendo limpiada de PECADO. El Sol está cumpliendo con su labor sagrada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: ¡Nos dirigimos a un mundo nuevo y puro!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: 'Fanatic: ¡CONTEMPLA LOS RAYOS DE LA BENDICIÓN, CARAJO!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: ¿Qué?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: Oye, me estás asustando
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: ¿Sigues confundido, HUMANO?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: 'Fanatic: Mira, te lo resumiré en términos simples.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: 'Fanatic: ¡El Sol no nos está GUISANDO vivos sin razón! ¡Nos está limpiando de nuestros pecados!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: 'Fanatic: ¡Nuestra lujuria y codicia contaminaron este mundo y eso ENFURECIÓ AL SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: 'Fanatic: ¡NOS ESTÁ DANDO NUESTRO MERECIDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: 'Fanatic: Esto es una bendición. Todo pecado cesará y viviremos como debe ser.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: ¿O sea que... hay que morirnos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: ¿Qué te va a pasar a ti?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: ¿Estás ASUSTADO? ¿Te volviste loco de remate?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: 'Fanatic: Mira, te lo voy a resumir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: 'Fanatic: ¡El Sol no nos está GUISANDO vivos sin razón! ¡Nos está limpiando de nuestros pecados!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: 'Fanatic: ¡Nuestra lujuria y codicia contaminaron este mundo y eso ENFURECIÓ AL SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: 'Fanatic: ¡ESTE ES NUESTRO CASTIGO!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: 'Fanatic: Esto es una bendición. ¡Ya no habrán pecados y viviremos con virtud bajo su mirada, convirtiéndonos en ceniza!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: ¿O sea que... hay que morirnos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: ¿Qué te va a pasar a ti?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: ¡Al contrario!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: 'Fanatic: Nuestros pecados se extinguirán. Quizás el mismo Sol lo haga. PERO NOSOTROS VIVIREMOS.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: 'Fanatic: No habrá más muertes, ni robos, ni bastardos codiciosos que no quieran venderme lo que quiero a un precio razonable.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: 'Fanatic: ¿Te lo imaginas? ¿Ya entiendes por qué pasa todo esto?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: ¿Y a mí qué me importa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: 'Fanatic: ¡VIVIREMOS EXQUISITAMENTE cuando el Sol termine de salvarnos!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: 'Fanatic: Los rayos divinos nos ayudarán a escapar de este tormento, ¿no lo ves?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: 'Fanatic: ¡Sí, tú lo entiendes... por eso sigues vivo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: ¡MUY BIEN, HUMANO! ¡Podemos hablar de esto con mayor profundidad!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: 'Fanatic: Ah, olvidaba preguntarte... ¿tienes cerveza?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: 'Fanatic: ¿Estabas fingiendo no saber nada del Sol?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: 'Fanatic: ¡Pues vete al carajo! ¡ME IRÉ A SALVAR A ALGUIEN MÁS!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: 'Fanatic: ¡Nos vemos, pendejo! ¡VETE A LA VERGA!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: ¡Ho-Hola!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: 'Anxiety: Disculpa que te moleste tan tarde... Es que hacía mucho calor hoy y en la tele dijeron que era mejor no salir, por el Sol, así que...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: Será que, por casualidad... um... ¿tendrás espacio para mí?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: ¿Quién eres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: ¿Cómo terminaste aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: Umm, vivía cerca de la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: 'Anxiety: Y el asfalto se está calentando muchísimo allá, je. Ya te imaginarás, je, je.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: 'Anxiety: Soy cajera en una tienda por esos lares. Bueno, en algún momento lo fui. Ya no. '
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: 'Anxiety: Me, um... me despidieron. Siempre he tenido mala suerte con los trabajos...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: ¿Ahora qué vas a hacer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: ¿Qué crees que va a pasar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: 'Anxiety: No es que quisiera venir aquí. El asfalto ya se está derritiendo bajo nuestros pies, pero podría ser peor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: Es que... Te vas a burlar de mí, je.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: 'Anxiety: Unos Visitantes se aparecieron en mi casa. Je... ¡¿Puedes creerlo?! ¡Me sacaron de mi propia casa!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: 'Anxiety: Así que, ahora estoy buscando un lugar dónde esconderme del Sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: ¿Ahora qué vas a hacer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: ¿Qué crees que va a pasar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: 'Anxiety: Ummm... Intentaré sobrevivir como pueda. Da miedo... con los Visitantes por todas partes y el Sol quemando como el infierno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: 'Anxiety: Me gustaría mucho seguir viva. Je, je. Uhh...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: ¿Tú no tienes miedo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: 'Anxiety: Por favor... dime que todo esto se va a terminar pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: No lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: 'Anxiety: ¿Voy a sobrevivir? ¿Quién me va a ayudar? ¿Por cuánto tiempo tendré que buscar ayuda?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: 'Anxiety: No tengo ni idea de qué va a pasar. Ni siquiera puedo imaginarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: 'Anxiety: ¿Esto no te asusta? A mí me aterra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: 'Anxiety: Gracias. ¡Jaja! ¡Muchas gracias, de verdad!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: 'Anxiety: Viviré un poco más, gracias a Dios.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: 'Anxiety: Jaja, ummm... está bien. Entiendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: 'Anxiety: Gracias por escuchar, de todos modos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: 'Anxiety: Umm... bueno, claramente debería irme, entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: 'Anxiety: ¿Adiós? Sí, um, adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: ¿Puedo pasar?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: Me estaba refugiando en el bar, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: Me echaron de ahí sin pensárselo dos veces.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: 'Esenin: ¿Que por qué? ¡Pff! No todos podían con mi temperamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: 'Esenin: Pero soy un pan de Dios, no te preocupes. Es que... la vida es una mierda a veces. Tú entiendes, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: 'Esenin: ¿Qué dices, amigo? ¿Puedo pasar?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: No serás un Visitante, ¿verdad?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: ¿Seguro que no vas a causar problemas?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: ¿Crees que soy uno de esos monstruos?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: 'Esenin: No. No soy un Visitante. Pero preguntarle eso directamente a todo el mundo es una maldita tontería.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: 'Esenin: Supongo que esto no será diferente a como era en el bar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: ¿Por qué te echaron de tu refugio anterior?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: ¿Por qué crees que aquí sería diferente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: ¿Qué consideras "problemas"?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: 'Esenin: El asesinato y las peleas me enferman. Pero tampoco dejaría que me hicieran daño.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: 'Esenin: Me gusta beber y comer. Me gusta hablar si estoy de buen humor. ¿Eso son "problemas" para ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: ¿Por qué te echaron de tu refugio anterior?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: ¿Por qué crees que aquí sería diferente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: 'Esenin: Me da tanta rabia que casi te digo una grosería, pero mejor me quedo tranquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: 'Esenin: Bueno, supongo que no le caía bien a alguien de ahí. Dios sabrá quién demonios fue.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: 'Esenin: Pero pensándolo bien, capaz y es mejor así.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: 'Esenin: Allá podrían haberme comido vivo y nadie se habría dado cuenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: 'Esenin: ¿Qué se supone que haga? ¿Esperar a que el Sol me cocine vivo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: No, preferiría evitar eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: 'Esenin: Mientras esté vivo, seguiré buscando a alguien con quien hablar. Si no es aquí, quizá tenga suerte en otro lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: 'Esenin: Si me queda algo de suerte puede que consiga a alguien que no sea un completo imbécil.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: 'Esenin: Gracias. La confianza en la gente no vale mucho estos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: 'Esenin: Así que agradezco tu confianza. Quizás... Bueno, no puedo prometer nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: 'Esenin: Mmm. Entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: 'Esenin: Sí, entiendo, pero estoy enojado. Eres tan cobarde como todos demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: 'Esenin: Duerme bien, maldito. Y vete a la mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: ¿Será que me dejas pasar a descansar un momento?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: ¿De dónde vienes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: ¿Hacia dónde te diriges?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: 'Widow: No me acuerdo. En realidad no importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: 'Widow: Estoy muy cansada. Si no descanso un poco, me voy a desmayar frente a tu ventana aquí afuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: ¿Tu amigo está enfermo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: ¿Tu amigo necesita ayuda?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: 'Widow: Yo... solo quiero caerme en cualquier parte y nunca volver a levantarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: No me importa en dónde termine.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: ¿Tu amigo está enfermo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: ¿Tu amigo necesita ayuda?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: Es... mi esposo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: Está muerto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: 'Widow: No puedo darle un entierro apropiado por el calor. Y ya no tiene sentido dejarlo ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: 'Widow: Ya no. Cuando la necesitó, nadie ayudó.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: Ahora está muerto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: 'Widow: Quizás habría sobrevivido si...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: 'Widow: Si a alguien le hubiese importado una mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: No me quedaré mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: 'Widow: Solo necesito descansar un poquito.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: Tú...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: ¡Eyyy!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: 'Scammer: ¿Viste todo lo que está pasando? Es una maldita locura.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: ¿Cómo te va, hermano?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: ¿Qué quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: ¿Qué está pasando exactamente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: 'Scammer: Nada, solo soy curioso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: 'Scammer: Pero, ey, te cuento que sé una manera super cool de conseguir dinero fácil. ¿Te interesa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: 'Scammer: Todo el mundo está haciéndose pipí con todo este problema del Sol, así que se puede hacer mucho dinero sin levantar un dedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: 'Scammer: ¡Estos tontos están cagándose del miedo en vez de pensar en grande!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: ¿Por qué estás aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: A ver, dime
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: 'Scammer: Te ofrezco nuevas posibilidades, hermano. ¡Abre los ojos!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: 'Scammer: Todos corren aterrados como gallinas en lugar hacer las cosas de forma pura y de corazón.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: 'Scammer: ¡Me refiero a que solo les hace falta algo de felicidad!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: ¿Por qué estás aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: A ver, dime
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: ¡Vas directo al grano! ¡Eso me gusta! ¡Sí que me gusta!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: 'Scammer: Todos van a creer que traes algo entre manos, trayendo a tanta gente. Algo grande.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: 'Scammer: Así que esta es mi idea: ¡Demos la fiesta más grande de todos los tiempos para celebrar el fin de todas las fiestas! ¡Es el Fin del Mundopalooza, hermano!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: ¡Epa, morir no es parte del plan, hermano!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: 'Scammer: Tienes que conseguir los verdes siempre que puedas. ¡Al diablo el maldito Sol!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: 'Scammer: ¡Hay que tener mente de tiburón! ¿Me entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: 'Scammer: ¡Así se habla, amigazo! ¡A eso me refiero!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: Al fin, alguien con más de dos dedos de frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: 'Scammer: Ya veo... Eres un maldito pendejo. No me di cuenta al principio. Mi error.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: 'Scammer: Iré a ver si tu vecino esta en el mismo nivel intelectual que yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: Te veo en el infierno, pendejo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: 'Neighbour: ¡Hola, vecino! Tiempo sin verte. ¿Qué tal te va?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: Igual que siempre
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: Bien
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: 'Neighbour: Mira, voy a ser directo contigo: vine por algo importante y es que estoy algo preocupado por ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: Parece que algo muy malo va a pasar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: 'Neighbour: Mi prima me acaba de llamar. Las noticias de allá dicen que algo raro le está pasando al Sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: 'Neighbour: Y que hay gente saliendo del subsuelo. Los están llamando dizque "Visitantes" por alguna razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: 'Neighbour: Da miedo, ¿no? Ojalá no sea verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: ¿Qué pasa con el sol?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: ¿Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: 'Neighbour: Mira, voy a ser directo contigo: vine por algo importante y es que estoy algo preocupado por ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: Parece que algo malo va a suceder.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: 'Neighbour: Mi prima me acaba de llamar. Las noticias de allá dicen que algo raro le está pasando al Sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060952
    m_Localized: 'Neighbour: Y que hay gente saliendo del subsuelo. Los están llamando dizque "Visitantes" por alguna razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060953
    m_Localized: 'Neighbour: Da miedo, ¿no? Ojalá no sea verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060954
    m_Localized: ¿Qué pasa con el sol?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060955
    m_Localized: ¿Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060956
    m_Localized: 'Neighbour: Va a explotar, o como que algo va explotar en él... Yo qué sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060957
    m_Localized: 'Neighbour: Mira, solamente sé que algo le está pasando.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060958
    m_Localized: 'Neighbour: ¿No te parece que este verano ha sido el más caliente hasta ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060959
    m_Localized: 'Neighbour: Creo que tenemos que prepararnos para lo peor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060960
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060961
    m_Localized: 'Neighbour: Mi prima dijo que quedarse solo en casa es peligroso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060962
    m_Localized: 'Neighbour: Así que vine para asegurarme de que no te lastimen o algo peor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060963
    m_Localized: Está bien
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060964
    m_Localized: Puedo cuidarme solo
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060965
    m_Localized: ¿Cómo están tu esposa e hija?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060966
    m_Localized: 'Neighbour: Sí. Así están llamando a la gente que viene del subsuelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060967
    m_Localized: 'Neighbour: Dios sabrá por qué les dicen así.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060968
    m_Localized: 'Neighbour: ¿Será porque están visitando la Tierra? O al menos están llegando a la superficie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060969
    m_Localized: 'Neighbour: O porque están intentando meterse en las casas de la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060970
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060971
    m_Localized: 'Neighbour: Mi prima dijo que quedarse solo en casa es peligroso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060972
    m_Localized: 'Neighbour: Así que vine para asegurarme de que no te lastimen o algo peor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060973
    m_Localized: Está bien
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060974
    m_Localized: Puedo cuidarme solo
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060975
    m_Localized: ¿Cómo están tu esposa e hija?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060976
    m_Localized: 'Neighbour: Genial. Sigamos conversando en la mañana, entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060977
    m_Localized: 'Neighbour: Te estaré esperando en la cocina cuando despiertes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060978
    m_Localized: 'Neighbour: Te veo en la mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060979
    m_Localized: 'Neighbour: Yo sé que sí. Pero no estoy seguro de que entiendas lo peligroso que es estar solo ahora mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060980
    m_Localized: 'Neighbour: ¿Por qué no me quedo contigo esta noche? Por las dudas. Me haría sentir más tranquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060981
    m_Localized: 'Neighbour: No te preocupes por mi familia. Un amigo mío se ha estado quedando con nosotros. Él las está cuidando mientras estoy aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060982
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060983
    m_Localized: 'Neighbour: Genial. Sigamos conversando en la mañana, entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060984
    m_Localized: 'Neighbour: Te estaré esperando en la cocina cuando despiertes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060985
    m_Localized: 'Neighbour: Nos vemos mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060986
    m_Localized: 'Neighbour: No te preocupes por mi familia. Un amigo mío se ha estado quedando con nosotros. Él las está cuidando mientras estoy aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060987
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060988
    m_Localized: 'Neighbour: Genial. Sigamos conversando en la mañana, entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060989
    m_Localized: 'Neighbour: Te estaré esperando en la cocina cuando despiertes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060990
    m_Localized: 'Neighbour: Nos vemos mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060991
    m_Localized: 'Daughter: ¡Holis!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060992
    m_Localized: 'Daughter: ¿Está mi papi contigo? ¿Puedes ir a buscarlo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060993
    m_Localized: 'Daughter: Sabes, antes todo estaba normal, pero ahora tengo miedo. Hay mucha gente rara caminando a esta hora y ya es de noche...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060994
    m_Localized: ¿Cómo se llama tu papá?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060995
    m_Localized: Cuéntame algo de tu papá
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060996
    m_Localized: 'Daughter: ¿Se te olvidó su nombre? ¡Ah, espera! Solo me estás probando para saber si soy una Visitante o no.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060997
    m_Localized: 'Daughter: ¡Eres muy inteligente! Ahora yo también le haré preguntas a la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060998
    m_Localized: ¿Cómo llegaste aquí sana y salva?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060999
    m_Localized: ¿Le tienes miedo a los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061000
    m_Localized: 'Daughter: Mmm, sé muchas cosas de él. Es mi papi, después de todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061001
    m_Localized: 'Daughter: Antes de salir, le gusta tomarse una cervecita, ¡ji, ji!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061002
    m_Localized: 'Daughter: Cuando tiene que salir, me deja un almuerzo y una cena rica. ¡Y jugo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061003
    m_Localized: 'Daughter: Hoy probé la cerveza que toma. ¡Y guácala! ¡Es asquerosa!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061004
    m_Localized: 'Daughter: ¿Por qué la gente bebe eso existiendo el jugo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061005
    m_Localized: 'Daughter: ¡A-ay, por favor, no le cuentes que hice eso!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061006
    m_Localized: ¿Cómo llegaste aquí sana y salva?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061007
    m_Localized: ¿Le tienes miedo a los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061008
    m_Localized: 'Daughter: Siento como si ahora todo estuviera de cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061009
    m_Localized: 'Daughter: La gente se queda en casa a mimir durante el día y luego sale a hacer cosas por la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061010
    m_Localized: 'Daughter: La oscuridad todavía me da miedo, pero tal vez no hay nada que temer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061011
    m_Localized: 'Daughter: ¿O sí...?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061012
    m_Localized: Déjame ir a buscar a tu papá. ¡Buena suerte!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061013
    m_Localized: ¡Que tengas un buen día!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061014
    m_Localized: 'Daughter: No... no lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061015
    m_Localized: 'Daughter: Todo el mundo les tiene miedo, así que yo también debería. Nunca he visto a ninguno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061016
    m_Localized: 'Daughter: ¿Pero dan miedo? ¿Pegan duro?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061017
    m_Localized: 'Daughter: Porque a un niño de la escuela que se la pasa pegándome. A lo mejor él es uno de esos Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061018
    m_Localized: 'Daughter: Mi papi me dijo que tuviera mucho cuidado. ¡Así que soy suuuuper cuidadosa!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061019
    m_Localized: 'Daughter: Vine de puntitas suuuuper calladita. Nadie me vio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061020
    m_Localized: Iré a buscar a tu papá. ¡Buena suerte!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061021
    m_Localized: ¡Que tengas un buen día!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061022
    m_Localized: 'Daughter: ¡Gracias, tú también!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061023
    m_Localized: 'Daughter: Quiero irme a casa... Aquí afuera da miedo...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061024
    m_Localized: 'Daughter: Juguemos un juego que mi papi inventó para mi. ¡Tienes que tirar dados!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061025
    m_Localized: 'Daughter: Y después te pones a mover cosas como alguna silla o el sofá.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061026
    m_Localized: 'Daughter: Entonces tienes que ponerlo todo frente a la puerta para ganar, haciendo una montaña. Luego te enseño.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061027
    m_Localized: 'Daughter: ¡Chaito!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061028
    m_Localized: 'Daughter: H-hola...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061029
    m_Localized: 'Daughter: D-déjame entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061030
    m_Localized: ¿Te está dando un ataque de pánico?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061031
    m_Localized: ¿Qué pasó?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061032
    m_Localized: 'Daughter: Snif... N-no sé q-qué ha-hacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061033
    m_Localized: 'Daughter: La ge-ge-gente...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061034
    m_Localized: 'Daughter: U-um...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061035
    m_Localized: 'Daughter: M-ma-mataron a m-mi pa...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061036
    m_Localized: 'Daughter: A m-m-m... m-mi...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061037
    m_Localized: 'Daughter: Pa-pi'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061038
    m_Localized: ¿Quiénes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061039
    m_Localized: ¿Por qué harían eso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061040
    m_Localized: 'Daughter: U-um...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061041
    m_Localized: 'Daughter: M-m-mi p-pa...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061042
    m_Localized: 'Daughter: E-ellos m-ma-ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061043
    m_Localized: 'Daughter: Ma-mataron a m-mi papi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061044
    m_Localized: ¿Quiénes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061045
    m_Localized: ¿Por qué harían eso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061046
    m_Localized: 'Daughter: Los V-Vi-Visitantes vinieron a ca-casa. Estaban se-sentados con nosotros...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061047
    m_Localized: 'Daughter: Papá e-estaba ha-hablando con ellos so-sobre algo. Y e-entonces lo mataron.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061048
    m_Localized: 'Daughter: Él... snif... Nuestra... snif...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061049
    m_Localized: 'Daughter: Nuestra ca-casa está en lla-llamaaas...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061050
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061051
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061052
    m_Localized: 'Daughter: N-no lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061053
    m_Localized: 'Daughter: Solo e-estaban se-sentados con papá en la co-cocina.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061054
    m_Localized: 'Daughter: Y e-entonces h-hi-hicieron algo y... snif... l-luego prendieron fu-fuego a la c-casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061055
    m_Localized: 'Daughter: Cuando e-escapé los escuché riéndose...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061056
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061057
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061058
    m_Localized: 'Daughter: ¿Me v-vas a a-ayudar?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061059
    m_Localized: 'Daughter: T-te-tengo m-miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061060
    m_Localized: 'Daughter: ¡¿Pe-pero a dónde v-voy a ir?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061061
    m_Localized: 'Daughter: ¡Te-tengo mucho mie-miedo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061062
    m_Localized: 'Daughter: ¡Buaaaaaaaah!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061063
    m_Localized: 'Daughter: ¡BUAAAAAAAAAAAAAAAAAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061064
    m_Localized: 'SuperFake: ¡Qué onda!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061065
    m_Localized: ¿Qué quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061066
    m_Localized: No te voy a dejar pasar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061067
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061068
    m_Localized: 'SuperFake: Pero qué casa más espaciosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061069
    m_Localized: 'SuperFake: Me gusta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061070
    m_Localized: No necesito nada de ti
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061071
    m_Localized: Estoy armado
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061072
    m_Localized: 'SuperFake: ¿Tu puerta es resistente y segura?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061073
    m_Localized: 'SuperFake: Nunca se sabe qué podría pasarle.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061074
    m_Localized: 'SuperFake: Tú me entiendes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061075
    m_Localized: No necesito nada de ti
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061076
    m_Localized: Estoy armado
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061077
    m_Localized: 'SuperFake: No, eso no es verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061078
    m_Localized: 'SuperFake: Y bieeeen...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061079
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061080
    m_Localized: No, no estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061081
    m_Localized: Sí, estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061082
    m_Localized: 'SuperFake: ¡Pero qué delicia!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061083
    m_Localized: 'SuperFake: La desesperación llena de agallas a los cobardes, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061084
    m_Localized: 'SuperFake: Pero, oye...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061085
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061086
    m_Localized: No, no estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061087
    m_Localized: Sí, estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061088
    m_Localized: 'SuperFake: Es tu día de suerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061089
    m_Localized: 'SuperFake: Oigo a alguien cuchicheando adentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061090
    m_Localized: 'SuperFake: ¿Pero dónde estarán en unos días?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061091
    m_Localized: 'SuperFake: ¡Jajajajaja!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061092
    m_Localized: 'SuperFake: Sé que estás solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061093
    m_Localized: 'SuperFake: Solo quería ver si mentías o no.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061094
    m_Localized: 'SuperFake: Hazte a un lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061095
    m_Localized: 'NotTrue: ¡Ay, hola, mijo! ¡Mira, caminar hasta aquí me dejó con los pies molidos que ni te cuento!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061096
    m_Localized: 'NotTrue: ¿Me dejarías entrar a descansar un minuto?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061097
    m_Localized: ¿Vino caminando a mi casa en específico?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061098
    m_Localized: ¿Estuvo caminando mucho tiempo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061099
    m_Localized: 'NotTrue: No, no, no. No fue intencional, no seas tontito.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061100
    m_Localized: 'NotTrue: El destino nos junta por algo. Uno no se cruza con nadie por casualidad, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061101
    m_Localized: 'NotTrue: Si llegué hasta aquí, es porque mis pies me trajeron por una razón y si mis ojos dieron con tu casa es por... alguna otra razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255104
    m_Localized: 'NotTrue: Justo como tenía que ser... supongo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255105
    m_Localized: No la entiendo. ¿Necesita algo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255106
    m_Localized: Entonces, pudo seguir caminando. ¿Qué la detuvo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255107
    m_Localized: 'NotTrue: ¡Uy! ¿Pero qué significa "mucho" de todas formas?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255108
    m_Localized: 'NotTrue: Mírate a tí, por ejemplo. Estás en casa, pero igual caminas, ¿cuántos pasos has dado?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255109
    m_Localized: 'NotTrue: ¿Acaso TÚ llevas mucho tiempo caminando? Me imagino que sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255110
    m_Localized: 'NotTrue: Pero yo he paseado muchísimo más de lo que tú has vivido.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255111
    m_Localized: 'NotTrue: Esa es la diferencia entre tu y yo, mijo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255112
    m_Localized: No la entiendo. ¿Necesita algo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255113
    m_Localized: Entonces, pudo seguir caminando. ¿Qué la detuvo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255114
    m_Localized: 'NotTrue: ¡Uy! Lo que necesita todo el mundo, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255115
    m_Localized: 'NotTrue: Un techo sobre mi cabeza, ya sabes, para contar una que otra una historia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255116
    m_Localized: 'NotTrue: Un lugar para recostarme y cerrar los ojos en paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255117
    m_Localized: 'NotTrue: Y aire para respirar, supongo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255118
    m_Localized: 'NotTrue: No necesito nada más. Todos es muy aburrido cuando se está tan solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255119
    m_Localized: Pase
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255120
    m_Localized: Debería irse
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255121
    m_Localized: 'NotTrue: Uy, mijo, parece que no eres muy buen oyente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255122
    m_Localized: 'NotTrue: Estoy cansada de caminar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255123
    m_Localized: 'NotTrue: Aquí podría recobrar el aliento y quizás conversar un poquito.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255124
    m_Localized: 'NotTrue: Eso es suficiente para una viejita como yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255125
    m_Localized: 'NotTrue: Tú me cuentas algo y yo te cuento algo a ti. Dando y dando.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255126
    m_Localized: 'NotTrue: Así mis pobres huesos pueden descansar un poquito.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255127
    m_Localized: Pase
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255128
    m_Localized: Debería irse
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255129
    m_Localized: 'NotTrue: ¡Gracias, mijo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255130
    m_Localized: 'NotTrue: No creo que me aburra contigo. Y así puedo ver qué ocurre por estos lares.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255131
    m_Localized: 'NotTrue: ¡Uy! ¡Es que me dan la espalda en todos lados!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255132
    m_Localized: 'NotTrue: Aunque mis alas estén rotas, sigo abriendo la garganta para cantar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255133
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255134
    m_Localized: 'NotTrue: Pero eventualmente me dan la espalda... Incluso cuando dicen que nunca lo harían.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255135
    m_Localized: 'NotTrue: Bueno, pero yo no guardo rencores. Ayudo a todos los que vienen a mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255136
    m_Localized: 'NotTrue: Incluso tú necesitarás ayuda un día, mijito. ¿Y a quién acudirás entonces?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255137
    m_Localized: 'Twins: Hola. Ah, ven, recuéstate de mí, hermanita.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255138
    m_Localized: 'Twins: ¿Será que... tiene espacio para nosotras?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255139
    m_Localized: ¿Tu amiga se siente mal?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255140
    m_Localized: ¿Están las dos enfermas? ¿O solo una de ustedes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255141
    m_Localized: 'Twins: Ella es mi hermana. Está deprimida.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255142
    m_Localized: 'Twins: No puede caminar, ni bañarse sola. A veces, hasta levantarse de la cama es todo un reto para ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255143
    m_Localized: 'Twins: Pero algún día va a mejorar. ¿Verdad, hermana?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255144
    m_Localized: 'Twins: Ahorita no tiene muchas ganas de hablar, pero a veces encuentra fuerzas para decir algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255145
    m_Localized: ¿Qué piensan hacer después?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255146
    m_Localized: ¿No estás cansada de cargarla?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255147
    m_Localized: 'Twins: Todos sufrimos de depresión hasta cierto punto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255148
    m_Localized: 'Twins: Nosotras ya sabíamos a dónde iban las cosas incluso antes del temita del sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255149
    m_Localized: 'Twins: ¿Has estado siguiendo las noticias, no? Ya todo esto se veía venir. Pero no creo que el sol vaya a explotar de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255150
    m_Localized: ¿Qué piensan hacer después?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255151
    m_Localized: ¿No estás cansada de cargarla?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255152
    m_Localized: 'Twins: Primero voy a encontrar un lugar donde mi hermana se sienta más cómoda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255153
    m_Localized: 'Twins: Y entonces empezaremos una nueva vida las dos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255154
    m_Localized: 'Twins: Dicen que estamos acabados...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255155
    m_Localized: 'Twins: No estoy de acuerdo. Las cosas deberían volverse más fáciles a partir de ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255156
    m_Localized: Pasen
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255157
    m_Localized: Deberían irse
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255158
    m_Localized: 'Twins: Por favor, tenga cuidado con lo que dice.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255159
    m_Localized: 'Twins: Sí, puede ser agotador, pero no puedo abandonarla y ya, si a eso te refieres.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255160
    m_Localized: 'Twins: Nos fuimos juntas de la casa de nuestros papás. Ahora solo nos tenemos la una a la otra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255161
    m_Localized: Pasen
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255162
    m_Localized: Deberían irse
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255163
    m_Localized: 'Twins: ¡Gracias! Ayúdame a traerla dentro, por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255164
    m_Localized: 'Twins: Creo que la muerte de nuestros padres la puso peor, aunque ya llevaba así mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255165
    m_Localized: 'Twins: Quizás se anime un poco mientras estamos aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255166
    m_Localized: 'Twins: Ay. Bueno, hermana, creo que tendremos que probar nuestra suerte en otra parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255167
    m_Localized: 'Twins: Anda, ayúdame un poco, hermanita, vamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255168
    m_Localized: 'Twins: Dios, ¿cuando acabará todo esto...?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714688
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714689
    m_Localized: 'Firefighter: Nos dieron este papel en el trabajo antes de ir a apagar los incendios.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714690
    m_Localized: 'Firefighter: Es una orden para que fueramos a reportarnos a las zonas en cuarentena de la AFAE. ¿Pero por qué iríamos si todo aquel que va termina muerto?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714691
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714692
    m_Localized: 'Firefighter: Toma, igual yo no lo necesito. Tíralo o úsalo como quieras.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714693
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714694
    m_Localized: 'Firefighter: Tengo un, cof...cof... pedazo de papel conmigo. Es algo importante.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714695
    m_Localized: 'Firefighter: Te lo daré si me dejas entrar y me permites vivir mis últimos días en paz...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714696
    m_Localized: Bueno, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714697
    m_Localized: Nah, quédatelo
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714698
    m_Localized: 'Wheelchair: ¿Cuál es tu maldito problema? ¿Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714699
    m_Localized: 'Wheelchair: Mira, veo que eres un buen tipo. ¿Quizás un EnerJeka te haría cambiar de opinión? ¿Ah?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714700
    m_Localized: 'Wheelchair: ¡Venir rodando hasta acá casi me mata como un pendejo! ¡Eso SÍ que es ejercicio!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714701
    m_Localized: Bueno, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714702
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714703
    m_Localized: 'Wheelchair: ¡Oye, te regalo un EnerJeka! ¡Gracias por dejarme pasar!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908992
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908993
    m_Localized: 'Anger:  Carajo... Maldita seaaaaa...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908994
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908995
    m_Localized: 'Anger: Bueno, mira, es que... Carajo, yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908996
    m_Localized: 'Anger: ¿Qué tal si te doy una EnerJeka? ¿Así sí me dejarías pasar?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908997
    m_Localized: 'Anger: Yo sigo vivo y tú te tomas una bebida fría y refrescante. Todos jodidamente felices. '
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908998
    m_Localized: Bueno, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908999
    m_Localized: Piérdete
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909000
    m_Localized: 'Anger: No se preocupe por mí... Es que... Carajo... En fin... Tómela.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909001
    m_Localized: 'Anger: Tome la bebida.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909002
    m_Localized: 'Anger: Carajo, estaré mejor calmándome. No bebiéndome esta mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909003
    m_Localized: 'Anger: Ya veo. Hay {0} aquí. Es obvio: todos hablan calladitos y soportan todo, solo para que no se incomode.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909004
    m_Localized: 'Anger: No soporto tener que estar cerca de alguien así. Vas a tener que elegir entre los dos; solo uno puede quedarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909005
    m_Localized: 'Anger: No soporto vivir con pendejos que se guardan las cosas así.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909006
    m_Localized: Yo me encargo. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909007
    m_Localized: Entonces, mejor vete
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909008
    m_Localized: 'Anger: Tienes la paciencia de un maldito santo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909009
    m_Localized: 'Anger: Más le vale que ser de los que dicen algo si las cosas se salen de control.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909010
    m_Localized: 'Anger: Trataré de... Bueno, ya sabe, de estar tranquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909011
    m_Localized: 'Anger: Genial. ¿No es malditamente fantástico? Una jodida maravilla.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909012
    m_Localized: 'Anger: Supongo que es mejor estar con los pendejos que ya conoces, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909013
    m_Localized: 'Anger: Mira, me importas una mierda, lamebotas. ¡OJALÁ TE PUDRAS EN EL MALDITO INFIERNO!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909014
    m_Localized: 'Fanatic: Aquí tiene una generosa recompensa del mismísimo Santo Sol, EN PERSONA. Se lo ha ganado, HOMBRE. ¡Tome esta EnerJeka!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909015
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909016
    m_Localized: 'Fanatic: ¿Qué tan estúpido puedes llegar a ser?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909017
    m_Localized: 'Fanatic: ¡Estás ahuyentando a un HOMBRE JUSTO!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909018
    m_Localized: 'Fanatic: Por haberme dejado pasar, recibirás una generosa recompensa del mismísimo SANTO SOL. ¡Recapacita y recibe la bendición!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909019
    m_Localized: Está bien, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909020
    m_Localized: Piérdete
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297600
    m_Localized: 'Super: Nadie se imaginaría qué fue lo que pasó después de que llegó el último Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297601
    m_Localized: 'Super: La casa permanecería sin ocupantes durante bastante tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297602
    m_Localized: 'Super: Tras la aterradora desaparición que sufrirás, todo el mundo evitará tu casa abandonada.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297603
    m_Localized: 'NotTrue: Hola, cariño... ¿qué tienes ahí, {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297604
    m_Localized: 'NotTrue: Los lugares donde hay ruido un segundo y luego se oye un cuchicheo entre las sombras al siguiente, me ponen los pelos de punta.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297605
    m_Localized: 'NotTrue: No me la paso sola por gusto, ¿sabes? No tolero si hay mucho griterío o demasiados rostros.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297606
    m_Localized: 'NotTrue: Que se quede si a ti te cae bien. Yo estaré en el porche hasta que todo se calme. No me gustan las tormentas, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297607
    m_Localized: 'NotTrue: Estos huesos míos ya no pueden con esto... no puedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297608
    m_Localized: Yo me encargo. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297609
    m_Localized: Entonces, mejor vete
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297610
    m_Localized: 'NotTrue: Si tú estás seguro... Pero si huelo a más tormentas o a falsedades, me iré. Ya estoy muy vieja para estas tonterías.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297611
    m_Localized: 'NotTrue: ¡Uy! Bueno, igual no me sentía parte de este lugar. Así que... me guardaré mis cuentos y me iré.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297612
    m_Localized: 'NotTrue: Ten los ojos bien abiertos, eso sí. A veces la verdad es silenciosa, pero letal.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297613
    m_Localized: 'Twins: Por favor...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297614
    m_Localized: 'Twins: Por favor, déjanos pasar, aunque sea por un solo día. Tenemos algo que te puede interesar...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297615
    m_Localized: 'Twins: Te lo compensaremos...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297616
    m_Localized: Está bien, pasen
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297617
    m_Localized: Piérdanse
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297618
    m_Localized: 'Twins: ¡Muchísimas gracias!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297619
    m_Localized: 'Twins: Mira, ten este EnerJeka. Es todo lo que tenemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297620
    m_Localized: 'Twins: ¿Me puedes ayudar a llevar a mi hermana adentro, por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297621
    m_Localized: 'Twins: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297622
    m_Localized: 'Twins: No creo que sea una buena idea. Veo que tienes a {0} aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297623
    m_Localized: 'Twins: Ese tipo de gente hace que el aire se sienta pesado. Como si los pensamientos de los demás fueran más ruidosos que los míos.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297624
    m_Localized: 'Twins: Mi hermana no puede con eso. Va a empezar a... hacerse chiquita. Es como si dejara de existir, encorvándose en sí misma.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297625
    m_Localized: 'Twins: Yo... a mí también me cuesta lidiar con eso. Me quita el aire.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297626
    m_Localized: 'Twins: Perdón. Esperaremos hasta que... hasta que las cosas cambien un poco. A lo mejor esto desaparece solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297627
    m_Localized: Yo me encargo. Pasen
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297628
    m_Localized: Entonces, mejor váyanse
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297629
    m_Localized: 'Twins: Gracias. Con cuidado, pon tu mano en su espalda... así.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297630
    m_Localized: 'Twins: Creo que la muerte de nuestros padres... la rompió por dentro. Pero está soportándolo como puede.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297631
    m_Localized: 'Twins: Ya llevamos un tiempo fuera. Tenía la esperanza de que aquí al menos se sintiera un poco mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297632
    m_Localized: 'Twins: Entiendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297633
    m_Localized: 'Twins: Dale, hermanita, solo aguanta un poco más. Te prometo que ya encontraremos un lugar donde puedas descansar. Ven, apóyate en mí. Te tengo. No te preocupes.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297634
    m_Localized: 'Twins: Es que a veces todo es... demasiado. Hasta entrar a algún lugar. Pero hay que avanzar. Anda, tú puedes... un pasito a la vez...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158001
    m_Localized: 'Tourist: Ah... qué pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158000
    m_Localized: 'Tourist: Mil gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157995
    m_Localized: No acepto sobornos.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157998
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157999
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157997
    m_Localized: 'Tourist: Está aquí {0}. No sé si nos llevemos bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157996
    m_Localized: 'Tourist: Disculpe, señor, pero me temo que aún no puedo entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157994
    m_Localized: Está bien, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646136
    m_Localized: 'Couple: ¿Qué haces ahí parada? Vamos, nos dejaron entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157993
    m_Localized: 'Alt: ¿Ahora sí cerramos el trato?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157992
    m_Localized: 'Alt: Bien. ¿Te basta con {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157991
    m_Localized: 'Alt: Ya me acostumbré. Y sé cuál es tu jugada.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157990
    m_Localized: 'Alt: Qué mal que los imbéciles tengan toda la suerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157989
    m_Localized: 'Alt: Aún hay tiempo. Buscaré otra opción.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157988
    m_Localized: 'Alt: Bueno.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157987
    m_Localized: 'Alt: Gracias. No me lo esperaba, pero en serio sí quería que pasara.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157986
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157985
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157984
    m_Localized: 'Alt: Pero no nos vas a ver jamás en el mismo cuarto.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157983
    m_Localized: 'Alt: Es largo de explicar, y no pienso aburrirte con eso ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157982
    m_Localized: 'Alt: Ah, mira. Ahí está {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157981
    m_Localized: No acepto sobornos.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157980
    m_Localized: Está bien, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157979
    m_Localized: 'FunnyGuy: ¿Serviría para resolver este tema?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157978
    m_Localized: 'FunnyGuy: Ah, mira qué encontré... {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157977
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157976
    m_Localized: 'FunnyGuy: Ten, te doy… a ver, ¿qué tengo?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157975
    m_Localized: 'FunnyGuy: Bueno, ya. Última vez que me pasa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157974
    m_Localized: 'FunnyGuy: Puta madre, me recuerdas a esos malditos bancos de siempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157973
    m_Localized: 'FunnyGuy: Listo, me voy, entonces. Todavía hay tiempo antes de que salga el sol. '
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157972
    m_Localized: 'FunnyGuy: Ni modo… Entendido.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157971
    m_Localized: 'FunnyGuy: ¡Salud por las deudas muertas, eh! ¡Jajaja!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157970
    m_Localized: 'FunnyGuy: ¡Ahora sí!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157969
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157968
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157967
    m_Localized: 'FunnyGuy: Ya me ha tocado una racha de mierda toda la vida. ¿Podemos al menos mantener este ambiente limpio?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157966
    m_Localized: 'FunnyGuy: ¿Ves allá {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157965
    m_Localized: 'FunnyGuy: De ninguna manera. Aquí hay alguien que va a arruinar el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157964
    m_Localized: 'Fairytaller: Ya veo. Entiendo. Cuídate.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157963
    m_Localized: 'Fairytaller: ¡Pero de verdad valoro tu confianza!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157962
    m_Localized: 'Fairytaller: ¡¿Qué?! ¡Gracias! No tenías que molestarte… Podría haber buscado otro sitio si hacía falta.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157961
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157960
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157959
    m_Localized: 'Fairytaller: Pero me temo que no me sentiré tranquilo conviviendo con {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157958
    m_Localized: 'Fairytaller: Sé que ya te he quitado mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157957
    m_Localized: 'Fairytaller: Y la verdad, no pienso que haya sido culpa mía.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157956
    m_Localized: 'Fairytaller: ¡Mil gracias! Aunque… parece que hay alguien aquí con quien tuve un problema en la cafetería.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157955
    m_Localized: No acepto sobornos.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157954
    m_Localized: Está bien, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157953
    m_Localized: 'Leper: Bueno, ¿y si te doy algo? Por ejemplo… {0}. ¿Con eso sí me abres la puerta?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157952
    m_Localized: 'Leper: Como sea, tú decides. Ya me retiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769382
    m_Localized: 'Leper: ¿En serio crees que alguien que se mete con el aspecto de los demás merece estar bajo tu techo?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769381
    m_Localized: 'Leper: Gracias. No quiero tener que lidiar con eso de nuevo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769380
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769379
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769378
    m_Localized: 'Leper: Está aquí {0}. Era quien se burlaba de mí por mi apariencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769377
    m_Localized: 'Leper: Lo siento, pero no creo que pueda pasar.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769376
    m_Localized: 'Nervous: Si te juntas con pura gente de mierda, ¡lo más seguro es que apestes también! ¡Jiji!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769375
    m_Localized: 'Nervous: Tal vez sea mejor que no acabe aquí contigo. Sí…'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769374
    m_Localized: 'Nervous: ¿En serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769373
    m_Localized: 'Nervous: Mejor no me meto en cosas de looocos.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769372
    m_Localized: 'Nervous: Suena dudoso, pero… ¡Ah, qué importa! ¡Jiji!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769371
    m_Localized: 'Nervous: Muy bien…'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769370
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769369
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769368
    m_Localized: 'Nervous: Créeme, yo lo sabría…'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769367
    m_Localized: 'Nervous: Está demeeeeente.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769366
    m_Localized: 'Nervous: Sé lo que ocurrió hace un mes. Claro que sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769365
    m_Localized: 'Nervous: Ah… Tienes a {0} aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769364
    m_Localized: 'Bald: Cuídate allá afuera, ¿sí? Ojalá salgas vivo de este desastre.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769363
    m_Localized: 'Bald: Tranquilo, amigo. Lo entiendo. No hay problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769362
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769361
    m_Localized: 'Bald: Diablos.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769360
    m_Localized: 'Bald: Ya sé que es incómodo… tener que sacar a alguien de esa manera. Pero así es la vida. A veces, hay que dejar de ser el bueno.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769359
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769358
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769357
    m_Localized: 'Bald: Sí, {0}. ¿Qué tal si… le mostramos la salida?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769356
    m_Localized: 'Bald: Te digo, me llevo bien con casi todos, de verdad. Pero esto estará complicado. Ya casi escucho las alarmas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769355
    m_Localized: 'Tough: Qué… decepción.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769354
    m_Localized: 'Tough: No me digas que no eres capaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769353
    m_Localized: 'Tough: ¿Qué mierda? Pensé que valorarías un poco de carácter.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769352
    m_Localized: 'Tough: Supongo que tampoco tenía mucho carácter, si echarle fue así de fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769351
    m_Localized: 'Tough: Hm. No pensé que en serio lo harías.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769350
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769349
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769348
    m_Localized: 'Tough: O se va, o me largo yo a otro sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769347
    m_Localized: 'Tough: ¿A quién tienes ahí? ¿A {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769346
    m_Localized: 'Jacket: Bueno, mejor me voy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769345
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769344
    m_Localized: 'Jacket: Maldita sea… la AFAE me va a encontrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722946
    m_Localized: 'Tourist: Ojalá nunca hubiera venido aquí…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722945
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722944
    m_Localized: 'Tourist: Carajo… ¿a dónde más puedo ir? Ya probé en todas las casas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722943
    m_Localized: 'Tourist: Te lo agradezco.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722942
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722941
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722940
    m_Localized: 'Tourist: Por favor, déjame quedarme contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722939
    m_Localized: 'Tourist: Y, ahora, no tengo a dónde ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722938
    m_Localized: 'Tourist: Me quedé en un hotel por un tiempo, pero se me acabó el dinero.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722937
    m_Localized: 'Tourist: No…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722936
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722935
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722934
    m_Localized: 'Tourist: Pero, aquí estoy, y no me alcanza para un hotel. Por favor, déjame quedarme contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722933
    m_Localized: 'Tourist: Sí, ya me di cuenta. Créeme, si hubiera sabido lo que iba a pasar con el sol, jamás habría venido.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722932
    m_Localized: ¿De verdad no tienes a dónde ir?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722931
    m_Localized: Vaya momento que elegiste para turistear.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722930
    m_Localized: 'Tourist: De verdad, solo estoy de paso.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722929
    m_Localized: 'Tourist: Pero, entonces, cerraron las fronteras… y me quedé atrapado aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722928
    m_Localized: 'Tourist: Iba para la capital. Ya tenía el viaje planeado…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722927
    m_Localized: ¿De verdad no tienes a dónde ir?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722926
    m_Localized: Vaya momento que elegiste para turistear.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722925
    m_Localized: 'Tourist: No hay vuelos, ni trenes. Todo está parado.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722924
    m_Localized: 'Tourist: Hubo un error. No puedo salir de la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722923
    m_Localized: ¿Cómo es que llegaste aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722922
    m_Localized: ¿Cuál es el problema?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722921
    m_Localized: 'Tourist: Ey. ¿Me ayudas? No soy de por aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722920
    m_Localized: 'Alt: Listo. Mejor ya me voy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722919
    m_Localized: 'Alt: Aún quedan un par de casas por aquí. Quizás alguien vea más allá de mi rostro y se porte como un ser humano decente, para variar.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722918
    m_Localized: 'Alt: Ha sido una semana intensa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722917
    m_Localized: 'Alt: Hablemos mañana, entonces. Hoy ya no doy más.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722916
    m_Localized: 'Alt: Perfecto.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722915
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722914
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722913
    m_Localized: 'Alt: Lo peor es escuchar otro informe y darte cuenta de que tienes que multiplicar todo lo horrible por cinco… tal vez hasta por diez.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722912
    m_Localized: 'Alt: La tele igual no facilita nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722911
    m_Localized: 'Alt: No sé si tienes luz, pero, si no… mejor aún.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722910
    m_Localized: 'Alt: El aire se enfría por la noche aquí. Y nadie está pegado a las noticias 24/7.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722909
    m_Localized: 'Alt: Sin formalidades; vamos a lo que importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722908
    m_Localized: 'Alt: Claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722907
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722906
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722905
    m_Localized: 'Alt: Y prefiero no estar en primera fila cuando eso pase.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722904
    m_Localized: 'Alt: Creo que nos estamos yendo directo a la mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722903
    m_Localized: 'Alt: Cuanto más dura esto, peor se pone. Menos aire, más crimen, la paranoia a punto de reventar en cada edificio.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722902
    m_Localized: 'Alt: Además, tengo la sensación de que la calma en las ciudades no va a aguantar.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722901
    m_Localized: 'Alt: Simplemente no me gustan las formalidades. Así es más fácil ir al grano.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722900
    m_Localized: 'Alt: ¿Qué te hace pensar que estoy huyendo de algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722899
    m_Localized: ¿Crees que acá te va a ir mejor?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722898
    m_Localized: ¿De qué estás huyendo?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722897
    m_Localized: 'Alt: La forma en que me veo no significa nada. No le deseo el mal a nadie. Y ojalá tú no seas de los que juzgan.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722896
    m_Localized: 'Alt: No he hecho nada malo. Y guárdate esa mirada criticona, si esa es tu intención.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722895
    m_Localized: 'Alt: Oye, ¿por qué te pones tan grosero?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722894
    m_Localized: ¿Crees que acá te va a ir mejor?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722893
    m_Localized: ¿De qué estás huyendo?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722892
    m_Localized: 'Alt: Como si los locos y los Visitantes no fueran suficiente, ahora el puto sol también se pone en nuestra contra.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722891
    m_Localized: 'Alt: Y no solo por la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722890
    m_Localized: 'Alt: Es solo que… oí que se está poniendo bien feo por la periferia.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722889
    m_Localized: 'Alt: Nah, no quise decir que tu casa se ve abandonada ni nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722888
    m_Localized: Qué osada eres.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722887
    m_Localized: ¿Te parece que está vacío?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722886
    m_Localized: 'Alt: Ah, sí hay alguien por aquí. ¿Te molesta si paso?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722885
    m_Localized: 'FunnyGuy: Em, ya se me ocurrirá algo. Todavía hay tiempo antes de que salga el sol. '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722884
    m_Localized: 'FunnyGuy: Puta madre.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722883
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722882
    m_Localized: 'FunnyGuy: ¿Ni una mínima oportunidad?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722881
    m_Localized: 'FunnyGuy: ¡No tienes ni idea de lo que significa este día para mí!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722880
    m_Localized: 'FunnyGuy: ¡Así me gusta! ¡Destapemos unas chelas y celebremos, pues!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722879
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722878
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722877
    m_Localized: 'FunnyGuy: Bueno, ¿me vas a dejar pasar, o qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722876
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722875
    m_Localized: 'FunnyGuy: Si tuviera una casa así, ahí sí viviría feliz, te lo aseguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722874
    m_Localized: 'FunnyGuy: No importa. Ese préstamo no lo pagas tú, ¿o sí? Mira la casa linda que tienes, al final.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722873
    m_Localized: 'FunnyGuy: ¿Qué te digo? Está clarísimo que no te alegras por mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722872
    m_Localized: No hablas mucho, por lo que veo.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722871
    m_Localized: 'FunnyGuy: No me encanta, si te soy sincero.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722870
    m_Localized: 'FunnyGuy: Uf, eso sonó súper sarcástico.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722869
    m_Localized: No hablas mucho, por lo que veo.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722868
    m_Localized: 'FunnyGuy: Sin ofender.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722867
    m_Localized: 'FunnyGuy: La verdad, prefiero no tocar ese tema acá, tan abiertamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722866
    m_Localized: 'FunnyGuy: Qué buena pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722865
    m_Localized: Entonces, ¿qué harás con toda esa plata que ahorraste?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722864
    m_Localized: Y… ¿ahora qué haces por aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722863
    m_Localized: 'FunnyGuy: ¡Se siente increíble!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722862
    m_Localized: 'FunnyGuy: Con todo este caos, ¡a quién le importan los bancos o los préstamos, ya!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722861
    m_Localized: 'FunnyGuy: Ahora, ¡no le debo ni mierda a nadie!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722860
    m_Localized: 'FunnyGuy: ¡PERO AHORA!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722859
    m_Localized: 'FunnyGuy: Todo se me venía encima, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722858
    m_Localized: 'FunnyGuy: Bueno, estaba hasta el cuello en deudas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722857
    m_Localized: Entonces, ¿qué harás con toda esa plata que ahorraste?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722856
    m_Localized: Y… ¿ahora qué haces por aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722855
    m_Localized: 'FunnyGuy: Es como si por fin pudiera respirar. No tienes idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722854
    m_Localized: 'FunnyGuy: Amigo… No... ¡Hermano! ¡La hipoteca ya no es mi problema!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722853
    m_Localized: 'FunnyGuy: ¡Ay, no te pongas así! Es que todavía no lo entiendes.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722852
    m_Localized: ¿Por qué tan alegre?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722851
    m_Localized: ¿Estás loco o qué mierda?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722850
    m_Localized: 'FunnyGuy: Qué noche, ¿no? ¿Sientes eso? ¡La magia en el aire!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722849
    m_Localized: 'FunnyGuy: ¡Ey, ey, eyyy! ¿Cómo va todo?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722848
    m_Localized: 'Fairytaller: Bueno. Entiendo. Cuídate.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722847
    m_Localized: 'Fairytaller: Qué alivio saber que todavía hay gente bondadosa… y no solo en los cuentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722846
    m_Localized: 'Fairytaller: ¡Muchísimas gracias! ¡Nunca olvidaré este momento!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722845
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722844
    m_Localized: Está bien, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722843
    m_Localized: 'Fairytaller: Nunca imaginé que la adultez me iba a golpear así, tan pronto… y no tengo a dónde más ir…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722842
    m_Localized: 'Fairytaller: Prometo devolverte el favor algún día. Y, ahora mismo, puedo ayudar en lo que sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722841
    m_Localized: 'Fairytaller: Sé que no tengo mucho que ofrecer... pero, por favor, te pido que lo reconsideres.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722840
    m_Localized: 'Fairytaller: Ya veo…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722839
    m_Localized: Aquí no hay sitio para mantenidos. ¡Adiós!
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722838
    m_Localized: Está bien, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722837
    m_Localized: 'Fairytaller: Dudo que yo pueda ser nuestro salvador. Pero, en todas las historias, el bien siempre triunfa al final.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722836
    m_Localized: 'Fairytaller: Si tan solo apareciera un héroe para derrotar nuestros verdaderos males, y que todo vuelva a ser como antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722835
    m_Localized: 'Fairytaller: La gente se asusta, se esconde, deja de confiar…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722834
    m_Localized: 'Fairytaller: Se siente un poco como esos cuentos con los que crecimos, donde el mal se esparce por todo el mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722833
    m_Localized: 'Fairytaller: Pero creo que sigo siendo la misma persona de siempre. Al menos, no tengo ganas de lastimar a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722832
    m_Localized: 'Fairytaller: Tal vez cumpla con algunas señales. No lo sé. Todo ha estado tan extraño últimamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722831
    m_Localized: 'Fairytaller: Siendo sincero, todavía no sé bien quiénes son exactamente esos Visitantes, ni qué los hace diferentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722830
    m_Localized: Aquí no hay sitio para mantenidos. ¡Adiós!
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722829
    m_Localized: Está bien, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722828
    m_Localized: 'Fairytaller: Trataré de ser útil hasta que me estabilice. Y te prometo que, algún día, te devolveré el favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722827
    m_Localized: 'Fairytaller: Odio sentirme como una carga, pero, cuando las cosas se ponen feas, uno hace lo que puede para sobrevivir.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722826
    m_Localized: 'Fairytaller: Poco después, se mudaron sus medios hermanos. No lo culpo del todo, pero espero que puedas entenderme a mí, también.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722825
    m_Localized: 'Fairytaller: Entonces, luego de que pasó todo esto, me echó. Dijo que era por no tener empleo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722824
    m_Localized: 'Fairytaller: El dueño del departamento ni quería alquilarle a un recién graduado sin ingresos estables.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722823
    m_Localized: 'Fairytaller: …Como cuando éramos niños.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722822
    m_Localized: 'Fairytaller: Cuando la vida se pone difícil, la gente solo quiere desconectarse un rato… ser libre de sus preocupaciones por un momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722821
    m_Localized: 'Fairytaller: Supongo que los que consiguieron trabajos en discotecas tuvieron suerte. Parece que a ellos les fue mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722820
    m_Localized: 'Fairytaller: Pero, con todo lo que pasó, la gente dejó de venir, y nos despidieron a todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722819
    m_Localized: 'Fairytaller: Ya acabé la universidad, pero hallar empleo en mi área ha sido difícil, así que empecé a trabajar en una cafetería pequeña.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722818
    m_Localized: ¿Cómo sé que no eres un Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722817
    m_Localized: ¿Qué te trajo hasta acá?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722816
    m_Localized: 'Fairytaller: Buenas noches. ¿De casualidad tendrás espacio para uno más? No necesito mucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039811
    m_Localized: 'Leper: Está bien, como quieras. Me largo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039810
    m_Localized: 'Leper: Gracias… por dejarme entrar. Y, bueno, por no hacer un drama por cómo me veo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039809
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039808
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039807
    m_Localized: 'Leper: Bueno, ¿me vas a dejar pasar o no?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039806
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039805
    m_Localized: 'Leper: Porque yo sé lo que soy. Y no soy uno de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039804
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039803
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039802
    m_Localized: 'Leper: Bueno, ¿me vas a dejar pasar o no?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039801
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039800
    m_Localized: 'Leper: Como digas.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039799
    m_Localized: ¿Qué te hace estar tan seguro?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039798
    m_Localized: Ya veremos.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039797
    m_Localized: 'Leper: Te lo juro, no soy un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039796
    m_Localized: 'Leper: ¿Cómo que, “qué esperaba”? Ponte serio. ¿Crees que elegí verme así?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039795
    m_Localized: ¿Qué te hace estar tan seguro?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039794
    m_Localized: Ya veremos.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039793
    m_Localized: 'Leper: Entiendo, pero no soy un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039792
    m_Localized: ¿Qué esperabas?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039791
    m_Localized: Todos viven paranoicos hoy en día.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039790
    m_Localized: 'Leper: Es de nacimiento; no puedo hacer nada. Pero, por alguna razón, la gente cree que soy un Visitante. Es una locura.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039789
    m_Localized: 'Leper: A eso justamente me refiero.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039788
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039787
    m_Localized: ¿Qué esperabas?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039786
    m_Localized: Todos viven paranoicos hoy en día.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039785
    m_Localized: 'Leper: No dejan de tratarme como si fuera contagioso… o peor, un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039784
    m_Localized: 'Leper: Solo nací con la piel complicada. Nada más.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039783
    m_Localized: 'Leper: ¡No! Ese es el tema. No me pasa nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039782
    m_Localized: ¿Qué te pasó en la piel?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039781
    m_Localized: ¿Debería preocuparme?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039780
    m_Localized: 'Leper: Hola. Eh, espero no verme tan mal como para que no me dejen pasar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039779
    m_Localized: 'Nervous: Jiji.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039778
    m_Localized: 'Nervous: A ver a dónde te lleva eso… Ojo con lo que te digo…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039777
    m_Localized: 'Nervous: Eres igual que esos tortur…dores con bata.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039776
    m_Localized: 'Nervous: ¿Que me falta un tornillo? ¿Varios tornillitos? ¿Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039775
    m_Localized: 'Nervous: Entonces... ¿tú también crees que estoy dementeeee?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039774
    m_Localized: 'Nervous: Un lugar donde puedo esperar a que todo esto pase…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039773
    m_Localized: 'Nervous: ¡Por fin!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039772
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039771
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039770
    m_Localized: 'Nervous: Además, escuché disparos cerca. Pero tú sí te tomas en serio la seguridad. ¿Cieeerto...?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039769
    m_Localized: 'Nervous: Ahora, ¡trato de conect…r con gente nueva!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039768
    m_Localized: 'Nervous: Uno obtuvo lo que se mer…cía, pero, ahora, tengo más cuidado. ¡Jiji!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039767
    m_Localized: 'Nervous: Esos tontos me hacen la vida imposible. Cada, uno, de ellos… desde el colegio.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039766
    m_Localized: 'Nervous: ¿Qué amigos?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039765
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039762
    m_Localized: 'Nervous: Así queeeee… ¡no me dan ganas de volver por otra ronda! ¡Jiji!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039761
    m_Localized: 'Nervous: Me ayudaron una vez, ¡pero no les importa un carajo!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039760
    m_Localized: 'Nervous: Fui medio que un accid…nte. Upsi-dupsi, ¡y aquí estoy!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039759
    m_Localized: ¿No tienes amigos?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039758
    m_Localized: ¿Por qué no te vas con tus familiares?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039757
    m_Localized: 'Nervous: Te lo cuento todo... después. Jiji.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039756
    m_Localized: 'Nervous: Las habitaciones de hotel son mini diminutas. Me hacen r...cordar… malas epócas.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039755
    m_Localized: 'Nervous: Tu casa es lo bastante grande para todo tipo de formas y tamaños.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039754
    m_Localized: 'Nervous: Allá está bien. Aquí está mejor. Jiji.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039753
    m_Localized: ¿No tienes amigos?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039752
    m_Localized: ¿Por qué no te vas con tus familiares?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039751
    m_Localized: 'Nervous: La AFAE vino, y, luego, se fue… ya no está.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039750
    m_Localized: 'Nervous: No puedo probarlo, no, no, no… pero creo que es una Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039749
    m_Localized: 'Nervous: Me da miedo, jiji.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039748
    m_Localized: 'Nervous: Hay una chica con un impermeable amarillo ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039747
    m_Localized: 'Nervous: No me gusta. Prefiero buscar otro l…gar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039746
    m_Localized: ¿Crees que aquí te irá mejor?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039745
    m_Localized: ¿Para qué? ¿No puedes volver y ya?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039744
    m_Localized: 'Nervous: Tengo m…do de regresar. ¿Puedo quedarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039743
    m_Localized: 'Nervous: Me estoy quedando en el Hotel Hope, pero decidí salir a caminar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039742
    m_Localized: 'Nervous: Perdón, es que me dan nerv...s.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039741
    m_Localized: 'Nervous: Hola. Jiji.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039740
    m_Localized: 'Bald: Cuídate allá afuera, ¿sí? Ojalá salgas vivo de este desastre.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039739
    m_Localized: 'Bald: Tranquilo, amigo. Lo entiendo. No hay problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039738
    m_Localized: 'Bald:  ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039737
    m_Localized: 'Bald: Vente a buscarme más tarde, ¿sí? Tengo unas historias que no te vas a creer, ¡ja!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039736
    m_Localized: 'Bald: Uf, amigo, me acabas de salvar la vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039735
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039734
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039733
    m_Localized: 'Bald: En resumen, no te estorbaré. Te lo cuento todo, solo… déjame pasar, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039732
    m_Localized: 'Bald: Ella solo intentaba protegerme… Nunca me contó nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039731
    m_Localized: 'Bald: Van por mi mamá.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039730
    m_Localized: 'Bald: Nah, no me están buscando a mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039729
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039728
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039727
    m_Localized: 'Bald: Y con esta idiotez del sol, todo se fue al carajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039726
    m_Localized: 'Bald: Pero ahora… yo… Bueno, no puedo comunicarme con ninguno. Cada quien tiene sus propios problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039725
    m_Localized: 'Bald: Eran buena gente, siempre dispuestos a ayudar, tomar una cerveza o simplemente pasar el rato.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039724
    m_Localized: 'Bald: Todos del teatro. Bebíamos juntos, hacíamos tonterías, nos cuidábamos entre nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039723
    m_Localized: ¿O sea que hay un grupo de gente furiosa buscándote?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039722
    m_Localized: ¿Qué clase de amigos son esos?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039721
    m_Localized: 'Bald: Antes, vivía con mi mamá y mi abuela, pero nos echaron. Los cobradores… Todo es un desastre...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039720
    m_Localized: 'Bald: Yo creía que tenía un montón de amigos, ¿sabes? Que nos íbamos a apoyar en esto… pero aquí me tienes.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039719
    m_Localized: 'Bald: ¿Te importa si me quedo aquí un rato? Los demás o no están, o los echaron, o ni idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039718
    m_Localized: 'Bald: ¡Hola, amigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039717
    m_Localized: 'Tough: …hijo de puta.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039716
    m_Localized: 'Tough: Qué…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039715
    m_Localized: 'Tough: Hm, no me esperaba más.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039714
    m_Localized: 'Tough: ¿No?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039713
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039712
    m_Localized: 'Tough: ¿Es una prueba esto?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039711
    m_Localized: 'Tough: Conversemos pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039710
    m_Localized: 'Tough: Sabes, es un honor. Estar aquí, ahora, mientras nuestras vidas se caen a pedazos.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039709
    m_Localized: 'Tough: ¡Excelente!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039708
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039707
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039706
    m_Localized: 'Tough: La vida se trata de desafiar lo imposible. Nada es fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039705
    m_Localized: 'Tough: Solo sobrevivimos si luchamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039704
    m_Localized: 'Tough: Solo creo que, si nos quedamos de brazos cruzados, la humanidad está acabada.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039703
    m_Localized: 'Tough: Ah. Perdón si no me expresé bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039702
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039701
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039700
    m_Localized: 'Tough: La humanidad ha enfrentado cosas peores. ¿Por qué rendirnos justo ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039699
    m_Localized: 'Tough: Pero desesperada, no estoy. Eso te lo aseguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039698
    m_Localized: 'Tough: Ah, ¿quieres saber para qué vine? Ja. ¿Quién sabe? Tal vez esté loca.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039697
    m_Localized: 'Tough: ¿Qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039696
    m_Localized: Suenas como psicópata.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039695
    m_Localized: ¿Tú también estás desesperada?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039694
    m_Localized: 'Tough: Vamos a sobrevivir, cueste lo que cueste.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039693
    m_Localized: 'Tough: No podía simplemente seguir de largo. Parece que pensamos igual, tú y yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039692
    m_Localized: 'Tough: Que no permites que los Visitantes te quiten lo único que realmente te pertenece. ...Tu vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039691
    m_Localized: 'Tough: Que sobrevivir aquí no es poca cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039690
    m_Localized: Suenas como psicópata.
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039689
    m_Localized: ¿Tú también estás desesperada?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039688
    m_Localized: 'Tough: Pero tú no eres como ellos. No vas a caer sin antes luchar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039687
    m_Localized: 'Tough: Los más valientes se pegaron un tiro. Los demás solo se fueron pudriendo, día tras día.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039686
    m_Localized: 'Tough: La mayoría se rindió hace rato. Eran demasiado débiles como para seguir vivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039685
    m_Localized: 'Tough: No, en serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039684
    m_Localized: Eh… ¿Qué dicen de mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039683
    m_Localized: ¿Gracias?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039682
    m_Localized: 'Tough: Aun así, te tengo respeto.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039681
    m_Localized: 'Tough: Los que se atreven a venir, o están desesperados… o son unos idiotas.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039680
    m_Localized: 'Tough: La mayoría ni se acerca a tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346842873856
    m_Localized: 'Tough: He oído sobre ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417961
    m_Localized: 'Jacket: Toma, tengo {0}. No es gran cosa, pero espero que sirva.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417960
    m_Localized: 'Jacket: Muchísimas gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417959
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417958
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417957
    m_Localized: 'Jacket: Ah… disculpa, pero ahí está {0}. No confío mucho en gente así…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417956
    m_Localized: No acepto sobornos.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417955
    m_Localized: Está bien, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417954
    m_Localized: 'Jacket: Si quieres, tengo {0}. ¿Te haría reconsiderarlo?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417953
    m_Localized: 'Jacket: No quiero cruzarme con una patrulla. O peor, con los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417952
    m_Localized: 'Jacket: No, por favor… Déjame pasar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417951
    m_Localized: 'Jacket: Toma, tengo {0}. No es gran cosa, pero espero que sirva.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417950
    m_Localized: 'Jacket: Muchísimas gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417949
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417948
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417947
    m_Localized: 'Jacket: No quiero acabar ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417946
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417945
    m_Localized: 'Jacket: Pero oí que se estaban llevando a los infectados a las zonas de cuarentena…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417944
    m_Localized: 'Jacket: Aparecieron un día y dijeron que tenían que revisar a todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417943
    m_Localized: 'Jacket: La AFAE…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417942
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417941
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417940
    m_Localized: 'Jacket: De verdad no quiero acabar en una zona de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417939
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417938
    m_Localized: 'Jacket: Empezaron a juntar a la gente… y yo…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417937
    m_Localized: 'Jacket: La AFAE…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417936
    m_Localized: ¿Qué pasó con tu residencia?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417935
    m_Localized: ¿Por qué?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417934
    m_Localized: 'Jacket: Antes, vivía en la residencia de la universidad, pero tuve que irme…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417933
    m_Localized: 'Jacket: Sí. Por favor… déjame entrar, si no es molestia.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417932
    m_Localized: ¿Qué pasó con tu residencia?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417931
    m_Localized: ¿Por qué?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417930
    m_Localized: 'Jacket: La residencia estudiantil ya no es opción…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417929
    m_Localized: 'Jacket: Sí, necesito un lugar para quedarme. No tengo a dónde ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417928
    m_Localized: ¿Buscas refugio?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417927
    m_Localized: ¿Se te ofrece algo?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417926
    m_Localized: 'Jacket: Hola. ¿Podrías dejarme pasar, por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417925
    m_Localized: 'Experienced: Bien pensado, hermano.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417924
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417923
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417922
    m_Localized: 'Experienced: ¿Ves {0}? Conozco su tipo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417921
    m_Localized: 'Experienced: Oye, hermano. Ahí dentro tienes un monstruo de primera.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417920
    m_Localized: 'Experienced: Hasta nunca, idiota.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417919
    m_Localized: 'Experienced: Mira pues, qué gracia la tuya, ¿eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417918
    m_Localized: 'Experienced: Bien pensado, hermano.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417917
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417916
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417915
    m_Localized: 'Experienced: Pero ya, mucha cháchara. ¿Me dejas quedarme, hermano?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417914
    m_Localized: 'Experienced:'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417913
    m_Localized: 'Experienced: No hay plata, mi mujer se fue con otro payaso, y yo sin un techo que me tape.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417912
    m_Localized: 'Experienced: Se acaba el tiempo, te vas a la calle.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417911
    m_Localized: 'Experienced: Claro, yo me habría quedado, pero, ¿tú crees que alguien me preguntó?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417910
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417909
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417908
    m_Localized: 'Experienced: Pero ya, mucha cháchara. ¿Me dejas quedarme, hermano?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417907
    m_Localized: 'Experienced: En medio de la nada y sin mocosos husmeando. Un buen sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417906
    m_Localized: 'Experienced: Y, entonces, me encuentro esta casa: limpia, tranquila, lejos de todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417905
    m_Localized: 'Experienced: No hay plata, mi mujer se fue con otro payaso, y yo sin un techo que me tape.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417904
    m_Localized: 'Experienced: No tengo a dónde ir, hermano.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417903
    m_Localized: ¿Por qué no te quedaste en la cárcel?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417902
    m_Localized: ¿Y qué carajos haces en mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417901
    m_Localized: 'Experienced: Supongo que me tocó volver a la calle.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417900
    m_Localized: 'Experienced: Y, ¿ahora? Todo el puto mundo se volvió loco. El sol pega como si quisiera freírme los huevos.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417899
    m_Localized: 'Experienced: Me habría quedado más, pero me sacaron a patadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417898
    m_Localized: 'Experienced: Ya hice un par de vueltas tras las rejas, hermano.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417897
    m_Localized: ¿Por qué no te quedaste en la cárcel?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417896
    m_Localized: ¿Y qué carajos haces en mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417895
    m_Localized: 'Experienced: ¿Yo? Ya he visto de todo. Apenas me abrieron las rejas, me saqué toda esa porquería de encima. Ahora, respiro a gusto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417894
    m_Localized: 'Experienced: Se pasean como si estuviera nevando o algo. Sarta de payasos.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417893
    m_Localized: 'Experienced: ¿No es obvio? Acá está más caliente que el culo del diablo. No sé cómo es que los demás ni cuenta se han dado.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417892
    m_Localized: ¿De dónde diablos saliste?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417891
    m_Localized: ¿Qué haces caminando así, en ropa interior?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417890
    m_Localized: 'Experienced: ¿Me dejas pasar, hermano?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417889
    m_Localized: 'Rocker: Si no me abres tú, alguien más lo hará.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417888
    m_Localized: 'Rocker: A la mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417887
    m_Localized: 'Rocker: Aunque sin guitarra… ya no es lo mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417886
    m_Localized: 'Rocker: ¡Eso, rock ''n'' roll!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417885
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417884
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417883
    m_Localized: 'Rocker: Sí, {0}… Imbécil. Que se largue, ¿sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417882
    m_Localized: 'Rocker: Nah, yo ni me acerco a una basura así.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417881
    m_Localized: 'Rocker: Intentaré caerle a algún amigo. Ojalá no hayan estirado la pata los pocos que quedan…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417880
    m_Localized: 'Rocker: Dale, hermano. No pasa nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417879
    m_Localized: 'Rocker: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417878
    m_Localized: 'Rocker: …¡O no! ¡Lo que tú quieras!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417877
    m_Localized: 'Rocker: Gracias, loco. Estaré poniendo música de vez en cuando; espero que todo bien con eso. Si me consigo una guitarra, te toco algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417876
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417875
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417874
    m_Localized: 'Rocker: Y, siendo sincero, si fuera un Visitante, ya me hubiese tumbado la puerta o metido por la ventana. Pero no, simplemente… aquí estoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417873
    m_Localized: 'Rocker: Encima me destrozaron la guitarra, esos hijos de puta. Toda esta mierda está convirtiendo a la gente en bestias, en serio. '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417872
    m_Localized: 'Rocker: Tocamos hasta el amanecer. Luego, llegaron unos enfermitos a nuestro punto y empezaron a robarse todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417871
    m_Localized: 'Rocker: Porque no lo he hecho.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417870
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417869
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417868
    m_Localized: 'Rocker: Oí que encontraron un Visitante cerca. Por eso, ahora están revisando a todos. Me da igual, mientras nadie se ponga histérico.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417867
    m_Localized: 'Rocker: Nada raro. Solo un mini amplificador y un par de botellas de agua. Te presto el amplificador si sabes tocar de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417866
    m_Localized: ¿Por qué te ves como que no has dormido en una semana?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417865
    m_Localized: ¿Qué traes contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417864
    m_Localized: 'Rocker: Todo está hecho un puto caos, ¡como meter a un famoso a un bar de mala muerte sin seguridad!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417863
    m_Localized: 'Rocker: Ah, aprovechados.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417862
    m_Localized: 'Rocker: Préstame techo un par de noches. No me quedaré toda la vida. No soy de esos... Eh... ¿Cómo se les decía?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417861
    m_Localized: 'Rocker: Ey, loco, ábreme. El sol está pegando como reflector. Si sigue así, me voy a quedar ciego.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417860
    m_Localized: 'Unstable: Quizás me una. Suena interesante.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417859
    m_Localized: 'Unstable: Y, luego, ¡los lanza al fuego!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417858
    m_Localized: 'Unstable: Dicen que hay un tipo raro que reúne a la gente y les lava el cerebro.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417857
    m_Localized: 'Unstable: Bueno, iré a ver qué hay en otro lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417856
    m_Localized: 'Unstable: Qué aburrido. Siempre lo mismo…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417855
    m_Localized: 'Unstable: Listo, hasta luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417854
    m_Localized: 'Unstable: Me pregunto cuánto habrá sacado con esa estupidez.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417853
    m_Localized: 'Unstable: Dicen que hay un tipo que vende aire. ¡Qué loco!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417852
    m_Localized: 'Unstable: No hay problema, iré a dar una vuelta por otro lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417851
    m_Localized: 'Unstable: Bueno, ¡tal vez mejor te cuento todo tipo de cosas!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417850
    m_Localized: 'Unstable: Perdón, pensé que sería muy gracioso.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417849
    m_Localized: 'Unstable: Jajaja, ni siquiera sé quién era.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417848
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417847
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417846
    m_Localized: 'Unstable: Acaban armando un problemón. Nah, mejor no.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417845
    m_Localized: 'Unstable: No me siento cómodo hablando con gente así. Siempre distorsionan todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417844
    m_Localized: Whoa, tienes a {0} aquí.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417843
    m_Localized: No acepto sobornos.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417842
    m_Localized: Está bien, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417841
    m_Localized: 'Unstable: Toma, {0}. ¿Quieres?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417840
    m_Localized: 'Unstable: O… aguanta.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417839
    m_Localized: 'Unstable: ¿Quieres una EnerJeka? ¡Y no es lo único que tengo!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417838
    m_Localized: 'Unstable: Qué mal. Espera, traigo varias cosas encima.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417837
    m_Localized: 'Unstable: Yo también pongo de mi parte; tengo mis historias. Conversemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417836
    m_Localized: 'Unstable: Entonces, me cuentas qué es lo que pasa por aquí. ¿Trato hecho?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417835
    m_Localized: 'Unstable: ¡Ah, genial!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417834
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417833
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417832
    m_Localized: 'Unstable: En fin… ya me cansé de estar parado acá en tu puerta. Si me dejas pasar, te cuento lo que he visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417831
    m_Localized: 'Unstable: No es una jugada muy inteligente, para ser honesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417830
    m_Localized: 'Unstable: La gente entra en pánico. O se encierran, o le disparan a cualquier cosa que se mueve.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417829
    m_Localized: 'Unstable: Hay una que otra cosa interesante, pero casi todo es lo mismo siempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417828
    m_Localized: 'Unstable: Ya te dije. Solo estoy observando cómo sobrevive la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417827
    m_Localized: 'Unstable: No me estás escuchando.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417826
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417825
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417824
    m_Localized: 'Unstable: ¿Me vas a dejar pasar?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417823
    m_Localized: 'Unstable: Pero tu casa se ve interesante, supongo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417822
    m_Localized: 'Unstable: Seguiré corriendo hasta encontrar lo que busco… sea lo que sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417821
    m_Localized: 'Unstable: Luego, salgo corriendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417820
    m_Localized: ¿Estás huyendo de algo?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417819
    m_Localized: ¿Y luego, qué?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417818
    m_Localized: 'Unstable: Deberíamos pasarnos consejos de supervivencia, je.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417817
    m_Localized: 'Unstable: Pero, mira, ¡yo tampoco estoy muerto! Parece que los dos dimos con algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417816
    m_Localized: 'Unstable: Bueno, sí, sigues vivo. Estás hablando conmigo… es cierto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417815
    m_Localized: 'Unstable: Y tú estás aquí clavado. ¿Crees que eso te mantiene a salvo?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417814
    m_Localized: ¿Estás huyendo de algo?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417813
    m_Localized: ¿Y luego, qué?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417812
    m_Localized: 'Unstable: Ni hablar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417811
    m_Localized: 'Unstable: Estando solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417810
    m_Localized: 'Unstable: Simplemente me hubiese muerto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417809
    m_Localized: 'Unstable: Si me quedaba en mi departamento, jamás me enteraba.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417808
    m_Localized: 'Unstable: Quién sabe, a lo mejor la última esperanza de la humanidad la tienes guardada en tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417807
    m_Localized: 'Unstable: Mientras más lejos llegue, más chances tengo de hallar una solución. No lo entiendes, ¿ah?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417806
    m_Localized: 'Unstable: ¿A qué te refieres?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417805
    m_Localized: No puedes escapar de los problemas corriendo.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417804
    m_Localized: ¿No intentarás llegar a un lugar seguro?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417803
    m_Localized: 'Unstable: Ando por la noche, así que... sí. Estaré dentro antes de que el sol me cocine.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417802
    m_Localized: 'Unstable: Tengo suficiente para un BUEN rato. Ni preguntes dónde la guardo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417801
    m_Localized: 'Unstable: Traigo mi fiel EnerJeka conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417800
    m_Localized: No puedes escapar de los problemas corriendo.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417799
    m_Localized: ¿No intentarás llegar a un lugar seguro?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417798
    m_Localized: 'Unstable: Seguiré avanzando hasta que me derrita. O hasta que los Visitantes me devoren. Lo que pase primero.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417797
    m_Localized: 'Unstable: Se viene una tormenta. Y me da curiosidad ver cómo la gente la enfrentará.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417796
    m_Localized: 'Unstable: A algún lugar lejano. No puedo quedarme quieto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417795
    m_Localized: Aquí no hay nada con qué recargar.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417794
    m_Localized: ¿Adónde vas con tanta energía?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417793
    m_Localized: 'Unstable: Estoy a mil por hora, pero la EnerJeka ya no me pega como antes. Me vendría bien recargarme un poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417792
    m_Localized: 'Unstable: ¡Ah, mira! Aquí hay alguien. ¡Qué bueno!'
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264643
    m_Localized: (Tomar el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264642
    m_Localized: (Tomar el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264641
    m_Localized: (Tomar el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264640
    m_Localized: (Tomar el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 61235008206004224
    m_Localized: Saltar introducción
    m_Metadata:
      m_Items: []
  - m_Id: 58250202329374720
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 58250202325180416
    m_Localized: 'TV: Si no puede trasladar inmediatamente a un Visitante sospechoso a una zona de cuarentena, emita un formulario de comparecencia obligatoria.'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306408796160
    m_Localized: 'MushroomEater: Parece que el festival se va a celebrar de todos modos...'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306387824640
    m_Localized: 'MushroomEater: Ay, mi querido amigo... Esto no se ve nada bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692481
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692480
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303878
    m_Localized: No estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303877
    m_Localized: Estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303876
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303875
    m_Localized: 'SuperFake: Está bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303874
    m_Localized: 'SuperFake: ¿Y qué te queda que importe? Ahora estás totalmente solo. Sin familia.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303873
    m_Localized: 'SuperFake: ¿Por qué estássss taaan... tenso? Aferrándote a la vida así.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303872
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371408
    m_Localized: 'Vigilante: Disfruta lo que te queda.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371407
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371406
    m_Localized: 'Vigilante: No me vas a volver a ver. Ya hice lo que vine a hacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371405
    m_Localized: 'Vigilante: Ya terminé contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371404
    m_Localized: 'Vigilante: ¿Oídos? ¿Qué carajo quieres decir con oídos? ¡Esa no es una maldita señal de Visitante!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371403
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371402
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371401
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371400
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371399
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371398
    m_Localized: 'Vigilante: ¿Oídos? ¿Qué carajo quieres decir con oídos? ¡Esa no es una maldita señal de Visitante!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371397
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371396
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371395
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371394
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371393
    m_Localized: 'Vigilante: Muéstrame las manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371392
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177095
    m_Localized: 'CultistPriest: Hasta luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177094
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177093
    m_Localized: 'CultistPriest: Está bien. Esa es tu decisión. La Muerte reclamará lo que le corresponde, tarde o temprano.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177092
    m_Localized: Hace mucho que quiero encontrar la paz... Te acompañaré
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177091
    m_Localized: Si tantas ganas tienes de morir, hazlo. Yo me quedo aquí
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177090
    m_Localized: 'CultistPriest: Forma parte de nuestro ritual y encuentra la paz. ¿Qué dices? ¿Nos acompañarías en nuestra sagrada procesión hacia la Muerte?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177089
    m_Localized: 'CultistPriest: Como muestra de gratitud, puedo ofrecerte la salvación...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177088
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205570
    m_Localized: 'Gasmask: Muy bien, entonces. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205569
    m_Localized: 'Gasmask: Es complicado, ¿no? Para usted. Para nosotros. ¿Cómo vamos a poder revisar un sector si ya no queda nadie?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205568
    m_Localized: 'Gasmask: ¿Está solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336336011264
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283083
    m_Localized: 'MushroomEater: Los jóvenes de hoy en día...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283082
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283081
    m_Localized: 'MushroomEater: Ah... quizás solo estoy perdiendo el tiempo...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283080
    m_Localized: 'MushroomEater: Hola, muchacho. Dime, ¿se te olvidó el pequeño favor que te pedí? ¿No viste las pistas escondidas en la Guía de las Sonrisas?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311553
    m_Localized: 'Fanatic: Contempla... {0}. Si me dejas entrar, te daré esta generosa recompensa de la mano del mismísimo GRAN SOL. ¿Ya cambiaste de opinión?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311552
    m_Localized: 'Fanatic: ¡Aquí tienes una generosa recompensa del mismísimo GRAN SOL! ¡Te la has ganado, HUMANO!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656006
    m_Localized: 'Jacob: Y tú y yo... nos volveremos a ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656005
    m_Localized: 'Jacob: Pero yo no moriré. Nunca.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656004
    m_Localized: 'Jacob: ¿Dejar a las personas al borde de la muerte? No está bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656003
    m_Localized: 'Jacob: Mira, deberías aprender algo de modales.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656002
    m_Localized: 'Jacob: Porque tú y yo... somos inmortales.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656001
    m_Localized: 'Jacob: Las personas como tú son las que sobrevivirán a esta pesadilla.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656000
    m_Localized: 'Jacob: Hoy en día ya no queda mucha gente que escuche de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655999
    m_Localized: 'Jacob: Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655998
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655997
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655996
    m_Localized: 'Jacob: Sé exactamente de dónde vienen los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655995
    m_Localized: 'Jacob: Y te lo contaré todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655994
    m_Localized: 'Jacob: Te juro que tan pronto como la AFAE se vaya, me iré y seguiré buscando a mi hija.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655993
    m_Localized: 'Jacob: Cosas que al gobierno no le gustaría que nadie más supiera.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655992
    m_Localized: 'Jacob: La AFAE me está buscando porque sé algunas cosas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655991
    m_Localized: 'Jacob: Necesito refugio por unos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655990
    m_Localized: 'Jacob: ¡Espera un momento!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655989
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655988
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655987
    m_Localized: 'Jacob: Sé exactamente de dónde vienen los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655986
    m_Localized: 'Jacob: Y te lo contaré todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655985
    m_Localized: 'Jacob: Luego me iré y seguiré buscando a mi hija.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655984
    m_Localized: 'Jacob: Déjame quedarme aquí un par de días, hasta que la AFAE se vaya de la zona.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655983
    m_Localized: 'Jacob: Si la tienen, no le harán nada. Me quieren a mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655982
    m_Localized: 'Jacob: A lo mejor esos malditos se llevaron a mi hija, o a lo mejor no.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655981
    m_Localized: 'Jacob: Mira, me buscan porque sé demasiado sobre ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655980
    m_Localized: 'Jacob: Lejos de aquí, básicamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655979
    m_Localized: 'Jacob: A un lugar donde la AFAE no pueda encontrarnos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655978
    m_Localized: Aquí no está. Adiós
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655977
    m_Localized: ¿A dónde quieres ir?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655976
    m_Localized: 'Jacob: Apenas la encuentre, nos iremos de esta ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655975
    m_Localized: 'Jacob: No tengo ni idea de dónde está.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655974
    m_Localized: 'Jacob: Llevo buscándola desde que empezó todo este desastre.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655973
    m_Localized: 'Jacob: Será mejor que no hables así de mi hija.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655972
    m_Localized: Aquí no está. Adiós
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655971
    m_Localized: ¿A dónde quieres ir?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655970
    m_Localized: 'Jacob: Ni una nota, ni rastro de ella. Mi hija solo desapareció.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655969
    m_Localized: 'Jacob: Cuando desperté, no había nadie en casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655968
    m_Localized: 'Jacob: Luego llegó esa ola de calor anormal y me desmayé...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655967
    m_Localized: 'Jacob: Íbamos a irnos de la ciudad...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655966
    m_Localized: 'Jacob: No la encuentro desde que comenzó toda esta mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655965
    m_Localized: 'Jacob: Es mi hija.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655964
    m_Localized: El burdel está en otra calle
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655963
    m_Localized: No he visto a nadie así por aquí
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655962
    m_Localized: 'Jacob: ¿No has visto por aquí a una chica de cabello morado con un poncho?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655961
    m_Localized: 'Jacob: Hola.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655960
    m_Localized: 'StaticBoy: Me equivoqué de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655959
    m_Localized: 'StaticBoy: Lo siento.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655958
    m_Localized: 'StaticBoy: Olor equivocado. Voz equivocada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655957
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655956
    m_Localized: 'StaticBoy: Me equivoqué de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655955
    m_Localized: 'StaticBoy: Lo siento.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655954
    m_Localized: 'StaticBoy: Olor equivocado. Voz equivocada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655953
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655952
    m_Localized: ¿Quieres que te ayude a encontrar tu casa?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655951
    m_Localized: ¿Qué es lo que buscas?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655950
    m_Localized: 'StaticBoy: Pero, ¿la gente los necesita...?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655949
    m_Localized: 'StaticBoy: No tengo. Nunca tuve.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655948
    m_Localized: 'StaticBoy: ¿Padres?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655947
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655946
    m_Localized: ¿Quieres que te ayude a encontrar tu casa?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655945
    m_Localized: ¿Qué estás buscando?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655944
    m_Localized: 'StaticBoy: Oí unos pasos desde aquí afuera. Eso es que alguien está esperando.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655943
    m_Localized: 'StaticBoy: Necesitaba la luz de la cocina, pero aquí... hay un eco diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655942
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655941
    m_Localized: 'StaticBoy: Todas las puertas se ven iguales en la oscuridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655940
    m_Localized: ¿Dónde están tus padres?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655939
    m_Localized: ¿Estás perdido?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655938
    m_Localized: 'StaticBoy: Debería estarlo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655937
    m_Localized: 'StaticBoy: ¿No está dormido?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655936
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267400
    m_Localized: 'CultistPriest: Cuida de mi gente. Y recuerda, si uno de nosotros muere... tu casa será reducida a cenizas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267399
    m_Localized: 'CultistPriest: Hasta luego. Regresaré para ver cómo están.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267398
    m_Localized: 'CultistPriest: ¿Acaso crees que tienes una opción?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267397
    m_Localized: 'CultistPriest: Nos vemos luego. Vendré a ver cómo están.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267396
    m_Localized: 'CultistPriest: No necesitan mucho tiempo. Pero aún así, cuida de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267395
    m_Localized: 'CultistPriest: Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267394
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267393
    m_Localized: Haré que se vayan. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267392
    m_Localized: 'CultistPriest: Se interponen en el camino hacia nuestro objetivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267391
    m_Localized: 'CultistPriest: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267390
    m_Localized: 'CultistPriest: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267389
    m_Localized: 'CultistPriest: Eso está muy bien. Pero antes tienes que sacar a tu gente de aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267388
    m_Localized: 'Courier: Que pases una buena noche...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267387
    m_Localized: 'Courier: Aquí está tu pedido: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267386
    m_Localized: (Tomar el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267385
    m_Localized: 'Courier: Bueno, toma el pedido, me largo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267384
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267383
    m_Localized: 'Courier: Estoy harto de toda esta mierda. Solo quiero que se acabe...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267382
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267381
    m_Localized: 'Courier: Todo este desastre...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267380
    m_Localized: 'Courier: Esos interminables chequeos matutinos con el personal de la AFAE apuntándonos con sus armas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267379
    m_Localized: 'Courier: Solo veo caras cansadas, sombrías, llenas de amargura...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267378
    m_Localized: 'Courier: ¿Te acuerdas cuando dije que ser repartidor me ayudaba a distraerme? Siento que eso ya no me funciona.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267377
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267376
    m_Localized: 'Courier: *Suspira...*'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267375
    m_Localized: (Tomar el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267374
    m_Localized: 'Courier: Solo toma tu pedido y me iré antes de que tú también me dispares.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267373
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267372
    m_Localized: 'Courier: Ah, ya veo... ¿O sea que está bien que hayan matado a mi amigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267371
    m_Localized: Lo siento
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267370
    m_Localized: Pues, no hay de otra
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267368
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267367
    m_Localized: 'Courier: Aquí está tu pedido: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267366
    m_Localized: (Tomar el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267365
    m_Localized: 'Courier: ¿Sabes qué? Solo agarra tu pedido de una vez y me voy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267364
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267363
    m_Localized: 'Courier: Bueno, mierda, muchas gracias por el consejo. Me cambiaste la vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267362
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267361
    m_Localized: (Tomar el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267360
    m_Localized: 'Courier: Bueno, me tengo que ir. Toma tu pedido para irme de aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267359
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267358
    m_Localized: 'Courier: En cualquier momento van a salir con que el vello púbico es signo de Visitante, y el mundo se va a desquiciar aún PEOR.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267357
    m_Localized: 'Courier: Creí que no podía ponerse peor. Pero, cada día, todo se vuelve más loco.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267356
    m_Localized: 'Courier: Con todos estos Visitantes, las señales y el maldito sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267355
    m_Localized: 'Courier: ¿Bien? ¿Qué queda de "bien" después de todo este cataclismo?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267354
    m_Localized: Solo sé un hombre y vas a sobrevivir. Deja de quejarte como un perdedor
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267353
    m_Localized: Tranquilo, vas a estar bien
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267352
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267350
    m_Localized: 'Courier: Aquí está tu pedido: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267349
    m_Localized: (Tomar el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267348
    m_Localized: 'Courier: Bueno, se supone que debes agarrar el pedido. ¿Lo vas a tomar?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267347
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267346
    m_Localized: 'Courier: Además, ¿para qué estudiar si de todos modos nadie me va a contratar?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267345
    m_Localized: 'Courier: Ah, qué más da. Ser repartidor no es tan malo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267344
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267343
    m_Localized: 'Courier: Sí, claro. Tienes un montón de gente en casa, por eso lo dices.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267342
    m_Localized: Qué lástima
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267341
    m_Localized: Estar solo no es tan malo
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267340
    m_Localized: 'Courier: Además, mi familia no está cerca. Yo no soy de aquí, vine a estudiar. Así que estoy solo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267339
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267338
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267336
    m_Localized: 'Courier: Aquí está tu pedido: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267335
    m_Localized: (Tomar el pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267334
    m_Localized: 'Courier: En fin, perdón, me distraje. ¿Vas a recibir el pedido?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267333
    m_Localized: 'Courier: Y ahora la gente pide, no sé, 20 litros de agua. Y es que, ojalá nos pagaran un extra por el riesgo o, por lo menos, propinas por andar cargando esas cosas pesadas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267332
    m_Localized: 'Courier: Pero este maldito sol... Por él nos cambiaron a los turnos de la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267331
    m_Localized: 'Courier: Y las entregas pagan bastante bien ahora. El riesgo es enorme, lo mires por donde lo mires.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267330
    m_Localized: 'Courier: Apocalipsis o no, el almuerzo sigue en pie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267329
    m_Localized: 'Courier: No esperaba que la gente fuera a dejar de juntar provisiones para el fin del mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073033
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073032
    m_Localized: Bueno, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073031
    m_Localized: 'GraveDigger: ¿{0}? ¿Con eso basta?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073030
    m_Localized: 'GraveDigger: ¿Qué necesitas?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073029
    m_Localized: 'GraveDigger: ¡Ay, por el amor de Dios! ¿Me dejas sobornarte con algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073028
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073027
    m_Localized: Bueno, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073026
    m_Localized: 'Marauder: ¡Ah! ¡Lo encontré! {0}. Toma, señor propietario, solo déjame quedarme aquí hasta la mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073025
    m_Localized: 'Marauder: Muy bien, un cuchillo, lo voy a necesitar... vendas, claro... mmm, un termo viejo también, pero vacío... no sirve de mucho...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073024
    m_Localized: 'Marauder: Ah, oye, no me corras... déjame revisar mi bolso primero.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878746
    m_Localized: 'Wolfhound: La fuerza es lo que prevalece. O te adaptas, o se vuelve contra ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878745
    m_Localized: 'Wolfhound: Buena elección.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878744
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878743
    m_Localized: Yo me encargo. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878742
    m_Localized: 'Wolfhound: Haz que se largue si quieres quedarte este lugar para ti solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878741
    m_Localized: 'Wolfhound: ¿Es {0} la que veo animando el lugar? La reconozco nada más verla, es un lobo con piel de cordero.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878740
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878739
    m_Localized: Bueno, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878738
    m_Localized: 'Twins: {0}. Toma. Te puede servir de algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878737
    m_Localized: 'Twins: Tenemos... ¿cómo se llamaba...?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878736
    m_Localized: 'Twins: Mmm... Entiendo, no nos conoces. Es posible que creas que te vamos a causar problemas. Pero no es el caso. Mi hermanita... está sufriendo mucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878735
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878734
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878733
    m_Localized: 'Twins: Se parecen bastante a nuestros... papás... y así este no sería... el mejor entorno para ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878732
    m_Localized: 'Twins: Me preocupa... mi hermana solo va a sufrir si se quedan aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878731
    m_Localized: 'Twins: Veo que ya tienes a esa gente en tu casa, a {0} y a {1}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878730
    m_Localized: Deberían irse
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878729
    m_Localized: Haré que se vaya. Pasen
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878728
    m_Localized: No creo que nos llevemos bien.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878727
    m_Localized: Sabes, antes de conocer a mi esposo, yo... bueno, este tipo me recuerda mucho a alguien que conocí.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878726
    m_Localized: Se me va a hacer muy difícil vivir bajo el mismo techo que este hombre...
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878725
    m_Localized: Hay {0} aquí...
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878724
    m_Localized: Deberían irse
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878723
    m_Localized: Haré que se vaya. Pasen
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878722
    m_Localized: 'Twins: Y eso es justo lo que menos necesita ahorita. Necesita es paz... que la cuiden.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878721
    m_Localized: 'Twins: Siento que mi hermanita se ahoga en sus palabras llenas de prejuicios.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878720
    m_Localized: 'Twins: Me temo que hay {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684421
    m_Localized: 'Greatmother: Je, ¡así es! De lo contrario, como te dije, no hubiera sido más que problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684420
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684419
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684418
    m_Localized: 'Greatmother: ¡Solo échalo para que yo pueda sentarme ahí!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684417
    m_Localized: 'Greatmother: Nah, no vas a llegar a ningún lado con él.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684416
    m_Localized: 'Greatmother: Vaya, vaya... mira quién está sentado aquí, ¿eh? {0}. ¡Mira qué coincidencia!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490118
    m_Localized: 'Widow: Gracias... No me quedaré mucho tiempo... Solo necesito un momento para recuperar el aliento...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490117
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490116
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490115
    m_Localized: 'Widow: No voy a quedarme en la misma casa que él.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490114
    m_Localized: 'Widow: No'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490113
    m_Localized: 'Widow: ¿Tienes a {0} aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490112
    m_Localized: 'Widow: Gracias por ayudarme. No como...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446750101504
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907213
    m_Localized: Bueno, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907212
    m_Localized: 'Luka: ¿Te interesa?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907211
    m_Localized: 'Luka: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907210
    m_Localized: 'Luka: Me gustaría ayudarte. ¿Hay algo que te interese?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907209
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907208
    m_Localized: Bueno, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907207
    m_Localized: 'Couple: Entonces, ¿qué dices? ¿Nos ayudarás?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907206
    m_Localized: 'Couple: ¿{0}? Estoy dispuesto a darte todo lo que tengo si con eso consigo que mi querida pueda descansar un poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907205
    m_Localized: 'Couple: Tenemos algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907204
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907203
    m_Localized: 'Couple: Hablando de eso...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907202
    m_Localized: 'Couple: La amo con locura. Por ella haría cualquier cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907201
    m_Localized: 'Couple: Mi esposa no es muy fuerte. Se cansa rápido. Y yo... yo haría lo que fuera por ella, ¿me entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907200
    m_Localized: 'Couple: Disculpa que insista, pero por favor, intenta ponerte en nuestro lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712914
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712913
    m_Localized: Bueno, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712912
    m_Localized: 'Wheelchair: ¿Ves? ¡Mis piernas son prueba viviente! No ves nada ahí, ¿verdad? ¡Ja!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712911
    m_Localized: 'Wheelchair: ¡Seguro que funciona!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712910
    m_Localized: 'Wheelchair: ¿No vas a dejarme pasar? ¡Eso lo arreglamos! Toma {0}, lo pones en la entrada y... ¡bam! Eres invisible.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712909
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712908
    m_Localized: Bueno, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712907
    m_Localized: 'Dude: ¡Oh! ¡{0}! Es como en los juegos, mi bro. Hay que crear afinidad. ¡Ya entiendo, hermano!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712906
    m_Localized: 'Dude: Bueno, checa esto. Te tengo algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712905
    m_Localized: 'Dude: Ándale, bro...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712904
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712903
    m_Localized: Bueno, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712902
    m_Localized: 'Blind: Creo que tengo algo de {0}. Te lo puedes quedar. Necesito por lo menos un día para recuperar el aliento. Pero... no creo que se pueda...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712901
    m_Localized: 'Blind: Creo que... tenía algo encima. Espera, por favor...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712900
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712899
    m_Localized: Bueno, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712898
    m_Localized: 'Fatman: Je, ¿qué te parece? ¿Ya te sientes mejor? ¿Estamos bien?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712897
    m_Localized: 'Fatman: Aquí tienes UN REGALITO... de mi parte. ¡{0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712896
    m_Localized: 'Fatman: Muy bien, amigo. Creo que... ya sé qué hacer contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518610
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518609
    m_Localized: Bueno, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518608
    m_Localized: 'Bestson: También tengo chicle... Me quedan pocos, pero te los puedo dar también...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518607
    m_Localized: 'Bestson: ¿Será que quieres algo? ¿Qué tal {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518606
    m_Localized: 'Bestson: Es que yo... ni siquiera sé qué hacer...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518605
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518604
    m_Localized: Bueno, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518603
    m_Localized: 'Fugitive: Por favor... ¡o voy a morir aquí afuera!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518602
    m_Localized: 'Fugitive: Hermano, te doy todo lo que tengo. Ten, ¿qué tal {0}? Lo encontré por ahí. No traigo nada más encima.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518601
    m_Localized: 'Fugitive: Maldita sea, ahora, o voy a terminar desangrándome en tu puerta... o me dejas pasar y me ayudas a curarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518600
    m_Localized: 'Wifefema: ¿Sabes qué? Vete a la mierda. Iré a hablar con tus vecinos. Adiós, imbécil.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518599
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518598
    m_Localized: 'Wifefema: ¿Cuál es tu puto problema? Te estoy dando todo servido en bandeja de plata, ¿y tú lo rechazas?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518597
    m_Localized: 'Wifefema: ¿Hablas en serio? ¡Mi esposo trabaja en la AFAE!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518596
    m_Localized: No acepto sobornos
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518595
    m_Localized: Bueno, pasa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518594
    m_Localized: 'Wifefema: Piensa qué te conviene más.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518593
    m_Localized: 'Wifefema: ¿No quieres? Te cuento que solo tengo que llamar a mi esposo y mañana los de los trajes amarillos vendrán para una inspección sorpresa con papeles, perros... Carajo, vendrían todas las mañanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518592
    m_Localized: 'Wifefema: Para no complicarnos: te daré {0} por adelantado y me dejas pasar, ¿sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446720741376
    m_Localized: 'Wifefema: Mira, tengo un olfato afiladísimo. Puedo detectar a la gente y a los Visitantes con una facilidad increíble.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863213
    m_Localized: Solo espero poder dormir por fin, al menos aquí.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863212
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863211
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863210
    m_Localized: Vi a esa persona en mis sueños y, créeme, eso fue más que suficiente.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863209
    m_Localized: Aquí no cabemos los dos.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863208
    m_Localized: 'Gracias, pero... parece que alguien ya tomó mi lugar. Mira, {0}. '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863207
    m_Localized: 'FormerFema: Adiós'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863206
    m_Localized: 'FormerFema: Ni siquiera sé por qué lo sigo llevando.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863205
    m_Localized: 'FormerFema: Supongo que este traje da un poco de miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863204
    m_Localized: 'FormerFema: Está bien, lo entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863203
    m_Localized: 'FormerFema: La verdad pensé que no me dejarías pasar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863202
    m_Localized: 'FormerFema: ¿En serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863201
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863200
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863199
    m_Localized: 'FormerFema: Si pudieras sacar a esa persona, juro que me quedaré calladito y no molestaré a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863198
    m_Localized: 'FormerFema: Sabes, llevo metido en este maldito traje todo el día... solo quiero quitármelo, lavarme toda esta porquería y... de quien sea esta sangre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863197
    m_Localized: 'FormerFema: Oh-oh... veo que ya hay {0} en el baño.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863196
    m_Localized: 'FormerFema: Digo... espera un momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863195
    m_Localized: 'FormerFema: ¿Qué? Ah, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863194
    m_Localized: 'GraveDigger: ¡Ah, gracias, amigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863193
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863192
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863191
    m_Localized: 'GraveDigger: Entraría, de verdad... pero, bueno, ya sabes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863190
    m_Localized: 'GraveDigger: Que me lleve el diablo, ya hay {0} aquí adentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863189
    m_Localized: Mmm... supongo que valió la pena arriesgarse.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863188
    m_Localized: Maldición, pensé que por una vez podría tomar un respiro.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863187
    m_Localized: Je, ahora sí estamos hablando.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863186
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863185
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863184
    m_Localized: ¿Por quién? Justo ahí, ¿ves? Es {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863183
    m_Localized: Ay, mira nada más. Ese rinconcito tan acogedor ya está ocupado.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863182
    m_Localized: 'Provocateur: Hablaremos de los términos de la renta con todo detalle más tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863181
    m_Localized: 'Provocateur: Gracias, propietario.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863180
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863179
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863178
    m_Localized: 'Provocateur: ¿Los artículos 28, 48 y 7.3 de la Constitución no te dicen algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863177
    m_Localized: 'Provocateur: ¿Estás al tanto de que este individuo es un claro transgresor de la ley?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863176
    m_Localized: 'Provocateur: Mmm... Veo que ya tienes a alguien viviendo aquí; a {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863175
    m_Localized: 'TaxiDriver: Entiendo tu postura, ¿sabes? Pero, carajo, qué difícil...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863174
    m_Localized: 'TaxiDriver: Oye, eh, ven a verme algún día, y hablamos un rato.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863173
    m_Localized: 'TaxiDriver: ¡Fiu! Gracias, amigo. ¡De verdad me salvaste!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863172
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863171
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863170
    m_Localized: 'TaxiDriver: En fin, tienes que escoger: él o yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863169
    m_Localized: 'TaxiDriver: Este tipo me recuerda un poco a la gente que perseguía a mi familia y...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863168
    m_Localized: 'TaxiDriver: Mira, no me vayas a malinterpretar, pero tienes a {0} en tu casa, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668885
    m_Localized: 'Edgar: Conserva el mío, cuando llegue el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668884
    m_Localized: 'Edgar: No sé si ves la belleza como yo. Pero dime... No tiras los cuerpos, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668883
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668882
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668881
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668880
    m_Localized: 'Edgar: Y yo, yo vine a escuchar el silencio del último día.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668879
    m_Localized: 'Edgar: Entraría... pero ya tienes {0} aquí. Ese es el tipo de gente que todavía se aferra a la idea de que habrá un mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668878
    m_Localized: 'Foreigner: (Asiente con la cabeza y pasa)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668877
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668876
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668875
    m_Localized: 'Foreigner: (Parece que no le agrada {0}. Lo señala, luego se señala a sí mismo, y vuelve a señalar al hombre)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668874
    m_Localized: 'Foreigner: Pffyyv. Ffffffpt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668873
    m_Localized: 'Doctor: Si tengo suerte, estaré por aquí, así que no dudes en pedir ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668872
    m_Localized: 'Doctor: Comprendo, no es la época más fácil para confiar en nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668871
    m_Localized: 'Doctor: Gracias. Espero poder ayudar a alguien.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668870
    m_Localized: Deberías irse
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668869
    m_Localized: Haré que se vaya. Pase
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668868
    m_Localized: 'Doctor: Lo mejor sería encontrar a alguien que realmente pueda ayudarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668867
    m_Localized: 'Doctor: No puedo ofrecerle el tratamiento que necesita.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668866
    m_Localized: 'Doctor: Hmm, veo que tienes a {0} aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474578
    m_Localized: 'NotTrue: Voy a dejar que mis huesos descansen un poquito aquí, y, luego, me iré.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474577
    m_Localized: 'NotTrue: Ay, mi vida. Ahora bien, ¿podrías traerle a la abuela un banquito?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474576
    m_Localized: 'NotTrue: ¡Ay, Dios te bendiga, mi vida! ¡Le has salvado los huesos a esta vieja! Es una lástima que tuvieras que sacar a alguien por mí...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474575
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474574
    m_Localized: Haré que se vaya. Pase
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474573
    m_Localized: 'NotTrue: Si tienes esta clase de compañía, probablemente me siente un rato en la entrada, recupere el aliento, y, luego, siga caminando.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474572
    m_Localized: 'NotTrue: Con gente así, no será fácil, mi cielo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474571
    m_Localized: 'NotTrue: ¡Ay, bendito sea! Parece que hay {0} justo ahí en la silla.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474570
    m_Localized: 'Daughter: ¡BUAAAAAAAAAAA!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474569
    m_Localized: 'Daughter: Estoy... estoy MUY ASUSTADAAAAAAA...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474568
    m_Localized: 'Daughter: Pe-pe-pero... no conozco a na-nadieee máaaaas...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474567
    m_Localized: 'Daughter: ¿IRME A DÓNDEEE?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474566
    m_Localized: 'Daughter: ¡PAPÁAAAA! ¡PAAAAPIIIII!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474565
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474564
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474563
    m_Localized: 'Daughter: Quiero ver a mi paaaapiii...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474562
    m_Localized: 'Daughter: Pero yo... ¡yo solo quiero sentarme ahí! ¡Quiero, quiero, quiero! Ahí es donde... donde se sentaba mi papi... Él me lo dijo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474561
    m_Localized: 'Daughter: Hay {0} aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474560
    m_Localized: 'Daughter: Yo... no... ¡a-aquí no hay espacio para mí!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280298
    m_Localized: 'Scammer: Como sea. Encontraré otros perdedores estúpidos. Hay bastantes de esos por ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280297
    m_Localized: 'Scammer: Vete al diablo, maldito cobarde. Ya sabía desde el principio que no nos íbamos a entender.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280296
    m_Localized: 'Scammer: ¡Puta madre, qué bien! Oye, ven cuando puedas. Tengo unas cosas que te quiero mostrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280295
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280294
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280293
    m_Localized: 'Scammer: Sácalo de aquí y estamos listos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280292
    m_Localized: 'Scammer: Oye, ya hay {0} aquí. Ese no va a soltar ni una mierda de dinero. Tiene las bolas secas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280291
    m_Localized: 'Cold: A-a lo mejor el Sol logre c-calentarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280290
    m_Localized: 'Cold: Sí... en a-algún lugar allá afuera... lejos de todos...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280289
    m_Localized: 'Cold: Entiendo... m-me iré entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280288
    m_Localized: 'Cold: Gracias. Créeme, así es más seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280287
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280286
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280285
    m_Localized: 'Cold: Es que... m-me da miedo estar en el mismo cuarto que otras personas. A veces... p-pasan cosas desagradables. Siempre me pasa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280284
    m_Localized: 'Cold: G-gracias. Oh. Este lugar está ocupado. No entraré mientras haya {0} aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280283
    m_Localized: 'Esenin: Pues vete a la mierda. Seguro también eres de esos raros que no beben.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280282
    m_Localized: 'Esenin: Bueno, por fin algo sale como yo quiero. Voy detrás de ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280281
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280280
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280279
    m_Localized: 'Esenin: Ese es el tipo de gente a la que sacan primero del bar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280278
    m_Localized: 'Esenin: Hay {0}; que se vaya primero y luego hablamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280277
    m_Localized: 'Anxiety: Bueno, jaja... Está bien, me iré. Mmm, el sol nos va a matar de todas formas. Todos vamos a morir...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280276
    m_Localized: 'Anxiety: Gracias. Me sentaré en silencio. No cierres la puerta, ¿está bien? Jaja. Solo por si acaso...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280275
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280274
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280273
    m_Localized: 'Anxiety: ¿Podrías, em... pedirle que se vaya?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280272
    m_Localized: 'Anxiety: Por favor, ¿puedes examinarlo o...?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280271
    m_Localized: 'Anxiety: N-no puedo quedarme con él. ¿Y si es un Visitante...?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280270
    m_Localized: 'Anxiety: H-hay alguien... {0} ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280269
    m_Localized: 'Hunter: Bien pensado. Al menos yo sé lo que hago. Te puedo ayudar si ese... monstruo... vuelve a aparecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280268
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280267
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280266
    m_Localized: 'Hunter: Huelo sangre en sus manos. No sé por qué dejaste que entrara. ¿Te gusta el peligro?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280265
    m_Localized: 'Hunter: Mm, veo que ya tienes a {0} aquí, muchacho.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280264
    m_Localized: 'Fanatic: Me voy a ayudar a alguien más. ¡Tú solo sigue pudriéndote aquí, maldito!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280263
    m_Localized: 'Fanatic: Es un PECADO cerrarle la puerta a la luz... ¡No! ¡A la ILUMINACIÓN!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280262
    m_Localized: 'Fanatic: ¡Pues al diablo contigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280261
    m_Localized: 'Fanatic: Ahora, ¿dónde está tu nevera...?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280260
    m_Localized: 'Fanatic: ¡Ohhh, magnífico, HUMANO! ¡Recibe la bendición del Gran Sol y que sus rayos caigan en tus OJOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280259
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280258
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280257
    m_Localized: 'Fanatic: ¡Su sombra... no, él mismo apaga la luz de la justicia con su herejía! ¡Tenemos que expulsarlo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280256
    m_Localized: 'Fanatic: ¡Humano! El SOL me ordena que no entre mientras haya {0} dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085958
    m_Localized: 'FortuneTeller: Hay una línea ley de energía pura que pasa por toda tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085957
    m_Localized: 'FortuneTeller: Magnífico... Francamente, tienes en tu poder un recurso metafísico poco común.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085956
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085955
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085954
    m_Localized: 'FortuneTeller: Hay que deshacernos de él, o las estrellas se van a alinear en contra nuestra. Sí lo ves, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085953
    m_Localized: 'FortuneTeller: Ay, no, veo que ahí tienes a... {0}. ¿No te suena de algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085952
    m_Localized: 'FortuneTeller: Oh... puedo sentirlo... un aura tan densa y opresiva. Una sombra... ¡Tiene la fuerza suficiente para condenarnos a todos, para contaminar toda la casa!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891698
    m_Localized: 'Luka: Cuídate mucho, ¿sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891697
    m_Localized: 'Luka: Y desde ahí... las cosas pueden ponerse muy feas, muy rápido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891696
    m_Localized: 'Luka: Si te enfocas demasiado en eso, te va a consumir vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891695
    m_Localized: 'Luka: No te hundas en tu dolor.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891694
    m_Localized: 'Luka: A lo mejor así... la muerte no es lo único en lo que piensas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891693
    m_Localized: 'Luka: Ojalá recuerdes cómo se sentía la alegría.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891692
    m_Localized: 'Luka: Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891691
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891690
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891689
    m_Localized: 'Luka: Te agradecería mucho si pudieras hacerme un poco de espacio.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891688
    m_Localized: 'Luka: No quiero sacar a nadie, quién sabe, tal vez necesitan este lugar más que yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891687
    m_Localized: 'Luka: Me encantaría pasar, pero parece que ya hay {0} ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891686
    m_Localized: 'Couple: Anda, usa las piernas. Yo también estoy cansado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891685
    m_Localized: 'Couple: Vamos a seguir buscando, ¿verdad, mi sol?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891684
    m_Localized: 'Couple: Entiendo. Perdón por la molestia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891683
    m_Localized: 'Couple: Qué tímida eres. Está bien. Ya descansarás.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891682
    m_Localized: 'Couple: ¿Qué haces ahí parada? Vamos, nos han dejado entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891681
    m_Localized: 'Couple: Ah, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891680
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891679
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891678
    m_Localized: 'Couple: Mira, es que a mi esposa no le gustan mucho los niños. No esperábamos encontrar a alguien tan joven aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891677
    m_Localized: 'Couple: Mira, no quiero ser problemático, pero no... no nos podemos quedar aquí si está {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891676
    m_Localized: 'Couple: ¿Y esa persona quién es?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891675
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891674
    m_Localized: 'Couple: Oh, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891673
    m_Localized: 'Anger: ¡Ugh, MALDITA SEA!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891672
    m_Localized: 'Anger: Quédate ahí y trágate sus mierdas hasta que te asfixies.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891671
    m_Localized: 'Anger: Maldita sea, eres tan patético como el resto de esos cobardes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891670
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891669
    m_Localized: 'Anger: Me desquito conmigo mismo. Nadie sale herido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891668
    m_Localized: 'Anger: Tampoco destruiré el lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891667
    m_Localized: 'Anger: No te preocupes, no me desquitaré con nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891666
    m_Localized: 'Anger: No. No puedo quedarme bajo el mismo maldito techo que esa loca. Me volveré loco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891665
    m_Localized: 'Anger: Maldita sea, ¿tienes a {0} aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891664
    m_Localized: 'Mother: No... no... Debería poder llegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891663
    m_Localized: 'Mother: Quizás ya es demasiado tarde...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891662
    m_Localized: 'Mother: Bueno. Iré a ver si ahora puedo llegar a la casa de mi esposo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891661
    m_Localized: 'Mother: Dale, no te quedes ahí y ya. Pasa, el señor no esperará para siempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891660
    m_Localized: 'Mother: Al fin...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891659
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891658
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891657
    m_Localized: 'Mother: ¿Tal vez podrías... no sé... sacar a esa persona para que mi niña por fin pueda dormir en paz?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891656
    m_Localized: 'Mother: Mm... Tienes a {0} aquí. Mi bebé ya está bastante asustada...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891655
    m_Localized: 'Ballerina: ¿Ves esa bola de pelos?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891654
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891653
    m_Localized: 'Ballerina: No era contigo. Le estoy hablando a la bola de pelos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891652
    m_Localized: 'Ballerina: Vente, gatito. Busquemos algo que hacer, ¿sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891651
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891650
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891649
    m_Localized: 'Ballerina: Mmmm, me dijeron que se supone que ese tipo de persona no debería estar aquí. Anda, haz que se vaya.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891648
    m_Localized: 'Ballerina: ¿Tienes a {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697379
    m_Localized: 'Teacher: Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697378
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697377
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697376
    m_Localized: 'Teacher: Disculpa'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697375
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697374
    m_Localized: 'Teacher: Me recuerdan a... esas personas que... que... los niños...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697373
    m_Localized: 'Teacher: No puedo estar bajo el mismo techo que alguien así.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697372
    m_Localized: 'Teacher: Disculpa, pero... ¿es {0} al que tienes aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697371
    m_Localized: 'Dude: Cuídate mucho, mi bro... y cuida a tu familia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697370
    m_Localized: 'Dude: Tranquilo, bro. Lo entiendo. No pasa nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697369
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697368
    m_Localized: 'Dude: Brooooo...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697367
    m_Localized: 'Dude: ¡Eso es de lo que hablo! ¡Claro que sí! ¡Eres grande bro!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697366
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697365
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697364
    m_Localized: 'Dude: Qué aburrido... ¡Bro, hay que sacarlo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697363
    m_Localized: 'Dude: Maldición, ese tipo va a echar a perder toda la vibra...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697362
    m_Localized: 'Dude: A ver, espérate... ¿Es ese {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697361
    m_Localized: 'Dude: ¡Ooooh, bro, qué grande eres!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697360
    m_Localized: 'Blind: O ESO vendrá por ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697359
    m_Localized: 'Blind: Por lo que más quieras, no te acerques a los cuerpos quemados en la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697358
    m_Localized: 'Blind: Me iré, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697357
    m_Localized: 'Blind: Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697356
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697355
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697354
    m_Localized: 'Blind: Será mejor que busque otro lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697353
    m_Localized: 'Blind: Perdón, no... no sé explicarlo. Solo sé que no es cualquier cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697352
    m_Localized: 'Blind: Percibo a {0} aquí dentro. Hay algo raro con esa persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697351
    m_Localized: 'Fatman: ¿A dónde carajos se supone que voy a ir? ¡Estoy condenado, maldición!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697350
    m_Localized: 'Fatman: ¿Disculpa? Estás viendo que no estoy bien, ¡y encima soy un ministro!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697349
    m_Localized: 'Fatman: Te pagaré... cuando todo esto se acabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697348
    m_Localized: 'Fatman: Excelente, tomaste la mejor decisión.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697347
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697346
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697345
    m_Localized: 'Fatman: Hasta prefiero darte algo si... ya sabes... te encargas de ese asunto...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697344
    m_Localized: 'Fatman: Mierda, tienes a... {0} aquí adentro. ¡Mándalos a la mierda! ¡No voy a pelearme por una maldita bañera!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503073
    m_Localized: 'Buddy: ¡Gracias, bro! ¡Me salvaste la vida!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503072
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503071
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503070
    m_Localized: 'Buddy: Mira, a mí me encanta compartir, pero esta perrera se está sintiendo un poco llena, ¿no? ¿Me ayudarías con eso, bro?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503069
    m_Localized: 'Buddy: ¡Oh-oh, bro! Como que alguien ya te está calentando ese puesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503068
    m_Localized: 'Bestson: Sí... puede que tengas razón. Volveré a casa, solo por si ya regresaron...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503067
    m_Localized: 'Bestson: Pero... quizá debería quedarme contigo por ahora. Me sentiría más seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503066
    m_Localized: 'Bestson: ¿Y si mis padres regresan a casa y no estoy?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503065
    m_Localized: 'Bestson: ¡Gracias! Es que... no puedo dejar de preocuparme.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503064
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503063
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503062
    m_Localized: 'Bestson: Una vez, en el parque, un hombre como él me atacó. ¡No volví a acercarme por ahí nunca más!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503061
    m_Localized: 'Bestson: Veo que ya tienes a {0} en el sofá. Ese tipo de hombres... digo... me asustan.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503060
    m_Localized: 'Fugitive: Que tengas una maldita buena noche, imbécil.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503059
    m_Localized: 'Fugitive: Bien. Escóndete detrás de esa puerta y tranca con llave.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503058
    m_Localized: 'Fugitive: ¿Qué, tienes miedo de que la AFAE venga a buscarme? ¿Qué carajos?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503057
    m_Localized: 'Fugitive: ¿En serio me estás jodiendo ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503056
    m_Localized: 'Fugitive: Espero que tus vecinos no sean unos desgraciados...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503055
    m_Localized: 'Fugitive: ¡Acabas de salvarme la maldita vida, hermano!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503054
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503053
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503052
    m_Localized: 'Fugitive: Créeme, los tipos así te venderían en un abrir y cerrar de ojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503051
    m_Localized: 'Fugitive: Se queda callado, ocupándose de sus asuntos. Hasta que le toca salvar su propio pellejo. Entonces, te traicionará sin pensárselo dos veces.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503050
    m_Localized: 'Fugitive: No puedo... Mira, hermano, ya he visto gente así antes. Tienes a uno aquí mismo en tu casa; a {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503049
    m_Localized: 'Nun: El Señor se acordará de esto. Él todo lo ve.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503048
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503047
    m_Localized: 'Nun: Mi muerte te pesará en el alma, grabe mis palabras.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503046
    m_Localized: 'Nun: ¡Señor, ten piedad...! Tienes una oportunidad de salvación en tus manos... y la rechazas. ¡Qué vergüenza!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503045
    m_Localized: 'Nun: Alabado sea...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503044
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503043
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503042
    m_Localized: 'Nun: ¡Aleja a esos demonios y serás bendecido, hijo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503041
    m_Localized: 'Nun: ¡Ni toda una vida bastaría para limpiar sus pecados! ¡Más te vale cuidarte del diablo al juntarte con semejante compañía!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503040
    m_Localized: 'Nun: ¿Y quién es ese, si me permite preguntar? ¿Es {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114466
    m_Localized: 'Raskolnikov: Yo solo... solo espero aprender a hacerlo un día. Para poder protegerme y... matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114465
    m_Localized: 'Raskolnikov: Esa persona debe ser importante para ti. Perdón por hacerte perder el tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114464
    m_Localized: 'Raskolnikov: Ay, no... No quería hacerte sentir incómodo así, ni nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114463
    m_Localized: 'Raskolnikov: ¿Podrías mostrarme cómo lo haces, cómo matas a un Visitante? Q-quiero enfrentarme al miedo directamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114462
    m_Localized: 'Raskolnikov: Y... um... si no es mucha molestia... después de que me examines...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114461
    m_Localized: 'Raskolnikov: Gracias, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114460
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114459
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114458
    m_Localized: 'Raskolnikov: Es que... no puedo convivir con alguien así. Lo intenté y n-no funcionó.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114457
    m_Localized: 'Raskolnikov: Ay, no... No quiero ser grosero, pero es que... aquí ya hay {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114456
    m_Localized: 'Wifefema: ¿Sabes qué? Vete a la mierda. Iré a hablar con tus vecinos. Adiós, imbécil.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114455
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114454
    m_Localized: 'Wifefema: ¿Cuál es tu maldito problema? Te estoy diciendo cómo son las cosas, ¿y tú lo mandas todo a la mierda?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114453
    m_Localized: 'Wifefema: ¿Es una broma? ¡Mi esposo trabaja en la AFAE!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114452
    m_Localized: 'Wifefema: Esos malditos aprovechados...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114451
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114450
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114449
    m_Localized: 'Wifefema: ¡Sácalo de aquí antes de que sea demasiado tarde!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114448
    m_Localized: 'Wifefema: Ya conozco a los de su clase. No debiste dejarlo pasar. ¿Los tipos como él? Solo traen problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114447
    m_Localized: 'Wifefema: ¿Quién diablos...? ¿Ese es {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114446
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114445
    m_Localized: 'Theorist: ¡Hasta luego! ¡Dudo que dures mucho!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114444
    m_Localized: 'Theorist: ¡Solo una mente estrecha de verdad podría ignorar la verdad tan fácilmente!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114443
    m_Localized: 'Theorist: Eres... eres...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114442
    m_Localized: 'Theorist: ¿Cómo que "debería irme"?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114441
    m_Localized: 'Theorist: Una vez que hablemos, ¡vas a ver el mundo con otros ojos!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114440
    m_Localized: 'Theorist: ¡Qué bueno que tomaste la decisión correcta! Créeme, no te arrepentirás.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114439
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114438
    m_Localized: Haré que se vaya. Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114437
    m_Localized: 'Theorist: Haz que se vaya, ¡y con gusto aceptaré tu invitación!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114436
    m_Localized: 'Theorist: ¡No hay forma de que revele algo si él está aquí!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114435
    m_Localized: 'Theorist: ¡Ese es... es... {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114434
    m_Localized: 'Theorist: Ah, no. Por supuesto que no.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114433
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114432
    m_Localized: 'Theorist: Aunque... espera un segundo. ¿Quién es ese?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077071142912
    m_Localized: 'Theorist: ¡Fascinante!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633035
    m_Localized: 'BigLebowski: No debí haber perdido mi tiempo contigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633034
    m_Localized: 'BigLebowski: Pff... como sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633033
    m_Localized: 'BigLebowski: ¡Genial!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633032
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633031
    m_Localized: Haré que se vaya. Pasa.
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633030
    m_Localized: 'BigLebowski: Oye, eso rimó. Qué bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633029
    m_Localized: 'BigLebowski: Pues, si me quedo, entonces haré lo que quiero.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633028
    m_Localized: 'BigLebowski: Ugh, olvídalo. Ya hay {0} en el mejor lugar de toda la casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633027
    m_Localized: 'BigLebowski: Vete al demonio...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633026
    m_Localized: 'BigLebowski: Eres igual a mi papá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200674
    m_Localized: 'FatalDame: Bueno... Ellos no opinan lo mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200673
    m_Localized: 'FatalDame: ¿Crees que será más fácil cuando por fin llegue el final?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200672
    m_Localized: 'FatalDame: No esperaba otra respuesta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200671
    m_Localized: 'FatalDame: Capaz hasta logremos distraernos con algo... mejor... que la paranoia y la interminable autocompasión.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200670
    m_Localized: 'FatalDame: Vamos a olvidarnos de todos estos horrores del mundo, solo tú y yo, bebé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200669
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200668
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200667
    m_Localized: 'FatalDame: ¿Quizá podríamos probar... conectar... tú y yo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200666
    m_Localized: 'FatalDame: Yo podría ayudarte con eso, bebé. Puedes practicar conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200665
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200664
    m_Localized: 'FatalDame: Conectar con la gente es difícil. No eres el único al que le cuesta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200663
    m_Localized: 'FatalDame: Te entiendo. No hay mucha gente que sepa escuchar sin decirte, "Pues a mí me fue peor..."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200662
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200661
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200660
    m_Localized: 'FatalDame: Todos necesitamos consuelo en estos días. Algo de atención... Algo de afecto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200659
    m_Localized: 'FatalDame: Si me dejas pasar, quizá podamos afrontar el dolor... sanar juntos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200658
    m_Localized: 'FatalDame: Y...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200657
    m_Localized: 'FatalDame: Yo he sentido lo mismo, bebé. Si en algún momento quieres hablar, podemos hacerlo... si quieres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200656
    m_Localized: 'FatalDame: Dejar atrás la rabia es difícil. Y perdonar es aún más difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200655
    m_Localized: 'FatalDame: ¿Tuviste un padre abusivo? Qué horrible. Me alegra que eso ya haya quedado atrás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200654
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200653
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200652
    m_Localized: 'FatalDame: Si me dejas pasar, yo te puedo dar eso... Te haré sentir cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200651
    m_Localized: 'FatalDame: Pero hasta el alma más solitaria necesita un... tipo de atención especial.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200650
    m_Localized: 'FatalDame: Hoy en día, todos están obsesionados con el fin del mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200649
    m_Localized: 'FatalDame: Te puedo ofrecer algo que no muchos te darían.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200648
    m_Localized: 'FatalDame: Mmm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200647
    m_Localized: 'FatalDame: Pero no voy a forzarte a que te abras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200646
    m_Localized: 'FatalDame: Tal vez te ayude, una vez que lo dejes salir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200645
    m_Localized: Me cuesta mucho conectar con la gente y ahora, incluso con todo esto, sigo igual
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200644
    m_Localized: Antes esperaba que mi padre muriera. ¿Te basta con eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200643
    m_Localized: No quiero
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200642
    m_Localized: 'FatalDame: Cuéntame, bebé. Solo soy una extraña en tu puerta. Quizá nunca nos volvamos a ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200641
    m_Localized: 'FatalDame: ¿O es cosa de tu infancia? ¿Viviste momentos duros y todo esto te trajo esos malos recuerdos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200640
    m_Localized: 'FatalDame: ¿Los Visitantes mataron a alguien importante para ti y por eso te aislaste emocionalmente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200639
    m_Localized: 'FatalDame: ¿Qué pasó? ¿Tu mujer te dejó recientemente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200638
    m_Localized: 'FatalDame: ¡Ay, me pones triste!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200637
    m_Localized: Me cuesta mucho conectar con la gente y ahora, incluso con todo esto, sigo igual
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200636
    m_Localized: Antes esperaba que mi padre muriera. ¿Te basta con eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200635
    m_Localized: Mejor no
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200634
    m_Localized: 'FatalDame: No eres de hablar mucho, ¿no? ¿Cuéntame algo de ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200633
    m_Localized: 'FatalDame: La gente no deja de decirme eso últimamente. Más de lo normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200632
    m_Localized: 'FatalDame: ¿Te gusta, bebé?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200631
    m_Localized: 'FatalDame: Así que lo notaste. Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200630
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200629
    m_Localized: Te ves... inusual
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200628
    m_Localized: 'FatalDame: Qué tontería la mía por preguntar. Después de todo, aquí vives.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200627
    m_Localized: 'FatalDame: ¿Ya lograste adaptarte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200626
    m_Localized: 'FatalDame: ¿Cómo te trata esta nueva vida, bebé?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200624
    m_Localized: 'Vigilante: ¿La verdad? Me importa una mierda tu foto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200623
    m_Localized: 'Vigilante: Se ve bien. Justo como se veían la mitad de los traidores que puse bajo tierra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200622
    m_Localized: 'Vigilante: ¿Otra vez con esta mierda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200621
    m_Localized: 'Vigilante: Vete al diablo. No voy a olerte axilas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200620
    m_Localized: 'Vigilante: Más te vale que no encuentre algo raro creciendo ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200619
    m_Localized: 'Vigilante: ¿Me estás jodiendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200617
    m_Localized: 'Vigilante: Puedes irte... por ahora. No tengo tiempo para esta mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200616
    m_Localized: 'Vigilante: Bien. Aún así, eso no significa que estés a salvo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200615
    m_Localized: 'Vigilante: Abre más los malditos ojos. Deja de estar jugando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200614
    m_Localized: 'Vigilante: No tengo tiempo para esto ahorita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200613
    m_Localized: 'Vigilante: Mmm... Sucias o limpias, ya no significa nada. Los Visitantes se camuflan bien de cualquier forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200612
    m_Localized: 'Vigilante: ¿Y bien? Muévete. No muerdo, a menos que tenga que hacerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200611
    m_Localized: 'Vigilante: Suficiente charla. Estoy perdiendo mi tiempo aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200610
    m_Localized: 'Vigilante: No te confíes. Un error y se acabó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200609
    m_Localized: 'Vigilante: Bien. Todo se ve limpio. Pero, ¿la verdad? Habría sido más fácil si no. Menos problemas después.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200608
    m_Localized: 'Vigilante: Abre tu maldita boca. Más. No soy tu maldito dentista.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200607
    m_Localized: (Mostrar los oídos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200606
    m_Localized: (Mostrar foto)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200605
    m_Localized: (Mostrar las axilas)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200604
    m_Localized: (Mostrar los ojos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200603
    m_Localized: (Mostrar las manos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200602
    m_Localized: (Mostrar los dientes)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200601
    m_Localized: 'Vigilante: Como sea. Ya basta de cuentos. Te voy a examinar. Demuestra que no eres uno de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200600
    m_Localized: 'Vigilante: Se rieron. Me dijeron que me uniera a ellos. Que se jodan. Al carajo con eso. Todo lo que hacen es llevarse gente y los Visitantes siguen aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200599
    m_Localized: 'Vigilante: La AFAE llegó, hablando de la "limpieza". Les dije que ya estaba hecho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200598
    m_Localized: 'Vigilante: La maté a ella primero. Después a él. Los niños se las arreglaron para escapar con los vecinos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200597
    m_Localized: 'Vigilante: Cuando los Visitantes empezaron a subir al techo, el idiota abrió la puerta. La dejó escapar. Así que hice lo que él no pudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200596
    m_Localized: 'Vigilante: Pero la esposa... ella mostraba señales. Y él seguía suplicando: "Es mi esposa. ¡No la toques!".'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200595
    m_Localized: 'Vigilante: Había una familia a las afueras del pueblo. Estaban atrincherados, el papá todavía sostenía la puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200594
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200593
    m_Localized: 'Vigilante: ¿Pero ahora? Ya no me importa. Se acabó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200592
    m_Localized: 'Vigilante: No tiene caso buscar. Es una pérdida de tiempo. Si mi hermano hubiera tenido agallas, quizás aún habría una oportunidad...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200591
    m_Localized: (Mostrar los oídos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200590
    m_Localized: (Mostrar foto)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200589
    m_Localized: (Mostrar las axilas)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200588
    m_Localized: (Mostrar los ojos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200587
    m_Localized: (Mostrar las manos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200586
    m_Localized: (Mostrar los dientes)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200585
    m_Localized: 'Vigilante: Como sea. Ya basta de cuentos. Te voy a examinar. Demuestra que no eres uno de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200584
    m_Localized: 'Vigilante: Tenía los ojos salvajes, pero estaba viva. Eso es lo que respeto. No como mi hermano. Diablos, si hubiera muerto antes, quizá su familia se habría salvado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200583
    m_Localized: 'Vigilante: Creí que habían muerto. Pero a los dos días me encontraron. ¿La primera que salió de entre los árboles? Su hija. Con una escopeta en mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200582
    m_Localized: 'Vigilante: Sacó a su familia por la parte de atrás, hacia el bosque. Yo me cargué a esos degenerados, pero ellos nunca regresaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200581
    m_Localized: 'Vigilante: Hace no mucho, vi a una familia. Un padre fuerte. Mantuvo la calma, incluso con los Visitantes gritando en las ventanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200580
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200579
    m_Localized: 'Vigilante: ¿Todo este caos? Es por culpa de cobardes como él.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200578
    m_Localized: 'Vigilante: Se rindió como un cobarde. Ahora su familia está o bajo tierra o quién carajo sabe dónde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200577
    m_Localized: 'Vigilante: Lo de siempre. Le dije a mi hermano... "Sé un hombre, protege a tu familia". ¿Y qué fue lo que hizo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200576
    m_Localized: ¿Quieres encontrarla?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200575
    m_Localized: ¿Cómo lo estás llevando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200574
    m_Localized: 'Vigilante: Si mi hermano no hubiera sido un cobarde, quizá podría haber protegido a su esposa e hija. Ahora quién sabe dónde está esa mocosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200573
    m_Localized: 'Vigilante: Ya regresé. Ni siquiera sé para qué diablos me molesté en venir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200572
    m_Localized: 'Vigilante: A la mierda esto. Tengo cosas más importantes que resolver. Volveré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200571
    m_Localized: 'Vigilante: Intenta esa mierda de los oídos otra vez y te mato aquí mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200570
    m_Localized: 'Vigilante: Si no fuera por mi hermano...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200569
    m_Localized: 'Vigilante: ¿Los oídos? ¿Crees que soy un maldito idiota?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200568
    m_Localized: 'Vigilante: ¿La verdad? Me importa una mierda tu foto. Tengo cosas importantes que hacer. Vive por ahora. Ya haremos un buen chequeo después.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200567
    m_Localized: 'Vigilante: Mmm... Te ves limpio, seguro. Pero he puesto bajo tierra a demasiados "limpios" como para creérmelo así y ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200566
    m_Localized: 'Vigilante: ¿Una foto? ¿Conque auras, ah? Bien, veamos qué tan "limpio" estás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200565
    m_Localized: 'Vigilante: Ninguna señal. Qué suerte tienes. Ahora quítame esas axilas de la cara, tengo problemas más importantes. Regresaré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200564
    m_Localized: 'Vigilante: Parece que estás bien. Pero eso no significa nada. Estos monstruos lo fingen mejor de lo que yo puedo darme cuenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200563
    m_Localized: 'Vigilante: Mmm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200562
    m_Localized: 'Vigilante: Ahora no, mierda. Tengo cosas más importantes que resolver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200561
    m_Localized: 'Vigilante: Estás a salvo por ahora. Pero si veo algo raro la próxima vez, disparo sin pensarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200560
    m_Localized: 'Vigilante: ¿Te das cuenta de lo que uno de esos tipos "normales" puede hacer en una sola noche? Un solo error y todos mueren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200559
    m_Localized: 'Vigilante: Je... No tienes nada, ¿ah? Perfecto. Maldita sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200558
    m_Localized: 'Vigilante: Anda. Usa los malditas dedos. Abre BIEN.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200557
    m_Localized: 'Vigilante: No tengo tiempo para esta mierda ahora. La próxima te reviso como se debe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200556
    m_Localized: 'Vigilante: Déjame que te diga una cosa. Un consejo: ¿los que parecen normales? Siempre son los primeros en transformarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200555
    m_Localized: 'Vigilante: Limpias... sí, por supuesto que están limpias, maldita sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200554
    m_Localized: 'Vigilante: Mierda, no tengo tiempo para esto. Tengo que revisar algo. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200553
    m_Localized: 'Vigilante: Está bien. Puedes vivir... por ahora. Pero si veo algo raro la próxima vez, te dispararé en toda la frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200552
    m_Localized: 'Vigilante: Mmmh... Limpios. Qué lástima, la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200551
    m_Localized: 'Vigilante: Abre más. Vamos, no te cagues encima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200550
    m_Localized: (Mostrar los oídos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200549
    m_Localized: (Mostrar foto)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200548
    m_Localized: (Mostrar las axilas)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200547
    m_Localized: (Mostrar los ojos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200546
    m_Localized: (Mostrar las manos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200545
    m_Localized: (Mostrar los dientes)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200544
    m_Localized: 'Vigilante: ¿Tienes un arma? Me importa una mierda. Entonces nos iremos a caer a tiros y nos morimos los dos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200543
    m_Localized: 'Vigilante: Demuéstrame que no eres uno de ellos. Enséñame lo que quieras que examine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200542
    m_Localized: 'Vigilante: Mmm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200541
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200540
    m_Localized: Solo la niña sobrevivió. El hombre que buscas está muerto
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200539
    m_Localized: Su casa se incendió. No lo he visto desde entonces
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200538
    m_Localized: 'Vigilante: La esposa... bueno, al diablo con la maldita esposa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200537
    m_Localized: 'Vigilante: Tiene una hija. Una niña. No estoy seguro de qué edad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200536
    m_Localized: 'Vigilante: Ya que estoy aquí... Dime, ¿conoces a un tipo fornido, que usa una chaqueta de jean azul?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200535
    m_Localized: 'Vigilante: Los Visitantes se aprovechan de la debilidad de los compasivos. Así es como matan a la gente en sus casas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200534
    m_Localized: 'Vigilante: Entonces, impartes justicia lo más rápido posible.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200533
    m_Localized: Solo la niña sobrevivió. El hombre que buscas está muerto
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200532
    m_Localized: Su casa se incendió. No lo he visto desde entonces
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200531
    m_Localized: 'Vigilante: La esposa... bueno, al diablo con la maldita esposa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200530
    m_Localized: 'Vigilante: Tiene una hija. Una niña. No estoy seguro de qué edad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200529
    m_Localized: 'Vigilante: Ya que estoy aquí... Dime, ¿conoces a un tipo fornido, que usa una chaqueta de jean azul?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200528
    m_Localized: 'Vigilante: Con una señal basta para eliminarlos. No espero por una segunda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200527
    m_Localized: 'Vigilante: En la televisión y en la radio lo dicen clarito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200526
    m_Localized: 'Vigilante: Diablos, apuesto a que igual que tú.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200525
    m_Localized: ¿Y si solo muestran una o dos señales?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200524
    m_Localized: ¿Cómo identificas a un Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200523
    m_Localized: 'Vigilante: ¿La AFAE ya se rindió con este lugar? ¿O solo con esta cuadra?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200522
    m_Localized: 'Vigilante: Pero revisé un par de casas... este lugar está repleto de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200521
    m_Localized: 'Vigilante: Estaba tratando de encontrar a alguien. No tuve suerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200520
    m_Localized: 'Vigilante: Ya volví.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200519
    m_Localized: 'Vigilante: Volveré a verte más tarde... Eres una persona interesante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200518
    m_Localized: 'Vigilante: Tengo que ir a ver a alguien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200517
    m_Localized: 'Vigilante: ¿Por qué los consideras una amenaza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200516
    m_Localized: 'Vigilante: Tienen sus maneras de encontrar señales de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200515
    m_Localized: 'Vigilante: Saben muy bien lo que hacen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200514
    m_Localized: 'Vigilante: Mejor descansa. Hablamos más tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200513
    m_Localized: 'Vigilante: Tengo que verlo todo yo mismo. Y lo haré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200512
    m_Localized: 'Vigilante: Pero no confío en ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006469
    m_Localized: 'Vigilante: Conque tú también intentas mantener el orden. Bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006468
    m_Localized: 'Vigilante: Tienes mi atención. Regresaré después.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006467
    m_Localized: 'Vigilante: Sí, creo que sí lo viste. No suenas como esa gente que esparce rumores sin saber.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006466
    m_Localized: 'Vigilante: Qué interesante... ¿De verdad lo viste?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006465
    m_Localized: 'Vigilante: ¿O sea, sin armadura?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006464
    m_Localized: 'Vigilante: ¿Solo uno? ¿Medio desnudo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006463
    m_Localized: La AFAE se ha estado llevando gente. No estoy seguro de si los traen de regreso
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006462
    m_Localized: Los Visitantes siguen apareciendo. Pero yo estoy armado
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006461
    m_Localized: Un Visitante medio desnudo acabó con una patrulla entera
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006460
    m_Localized: 'Vigilante: ¿Cómo es la cosa por este vecindario? ¿De quién me tengo que cuidar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006459
    m_Localized: 'Vigilante: Ya hiciste tus preguntas. Ahora es mi turno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006458
    m_Localized: 'Vigilante: Espera'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006457
    m_Localized: ¿Por cuánto tiempo planeas estar "limpiando"?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006456
    m_Localized: Entonces, ¿qué haces aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006455
    m_Localized: 'Vigilante: Si uno de verdad me impresiona... podría tomar algo más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006454
    m_Localized: 'Vigilante: Suelo sacarle un diente a cada Visitante. Es un trofeo fácil de tomar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006453
    m_Localized: 'Vigilante: Es un recordatorio... de cuántas casas, cuántos pueblos he limpiado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006452
    m_Localized: 'Vigilante: Je. Buen término. Lo voy a usar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006451
    m_Localized: 'Vigilante: ¿"Repele-Visitantes"? Ah, hablas del collar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006450
    m_Localized: ¿Por cuánto tiempo planeas estar "limpiando"?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006449
    m_Localized: Entonces, ¿qué haces aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006448
    m_Localized: 'Vigilante: Y cualquiera que sienta lástima por los Visitantes... bien podría ser uno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006447
    m_Localized: 'Vigilante: ¿Pero la forma más efectiva? Encerrarlos en una casa y prenderle fuego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006446
    m_Localized: 'Vigilante: Sacaría la basura con propias mis manos, pero esto da mejores resultados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006445
    m_Localized: 'Vigilante: Sí, claro. Es una escoba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006444
    m_Localized: 'Vigilante: Je. Me gusta cómo suena eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006443
    m_Localized: ¿Y eso que llevas encima? ¿Qué se supone que es, un repele-Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006442
    m_Localized: Déjame adivinar, ¿es eso una escoba lo que tienes en las manos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006441
    m_Localized: 'Vigilante: No soy de los que se esconde. Yo SOY la justicia. Yo traigo el orden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006440
    m_Localized: 'Vigilante: No hay justicia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006439
    m_Localized: 'Vigilante: Pero a los pocos días, terminan masacrándolos a todos dentro de sus casas antes de irse para repetir lo mismo en alguna otra parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006438
    m_Localized: 'Vigilante: Algunas personas se compadecen de los Visitantes. Creen que pueden, no sé... mejorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006437
    m_Localized: 'Vigilante: Esto no es un maldito juego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006436
    m_Localized: ¿Y eso que llevas encima? ¿Qué se supone que es, un repele-Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006435
    m_Localized: Déjame adivinar, ¿es eso una escoba lo que tienes en las manos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006434
    m_Localized: 'Vigilante: No necesitas saber más nada sobre mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006433
    m_Localized: 'Vigilante: Ya me ocupé de mi sector.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006432
    m_Localized: 'Vigilante: Vengo a hacer limpieza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006431
    m_Localized: ¿Por qué no estás escondido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006430
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006429
    m_Localized: 'Vigilante: A menos que seas un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006428
    m_Localized: 'Vigilante: Está bien. Eso mejora tus probabilidades de supervivencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006427
    m_Localized: 'Vigilante: Te mantienes alejado, ¿ah?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006426
    m_Localized: 'Miner: ¿Vas a volver a tu vida como si nada hubiera pasado? Anda, baja ahí. Averigüémoslo. Juntos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006425
    m_Localized: 'Miner: ¿Qué tal si hay algo en el fondo que lo cambia todo? Respuestas a todas las preguntas, algo que podría convertirte en un héroe nacional.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006424
    m_Localized: 'Miner: ¿Nunca lo averiguarás? ¿Estás bromeando? Ya sabes que no es solo un hueco. Sé que tú también lo sientes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006423
    m_Localized: 'Miner: ¿Y bien? ¿Qué esperas? Para esto estamos aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006422
    m_Localized: 'Miner: ¿En serio vas a pasar el resto de tu vida preguntándote qué hubiera pasado si no te hubieras acobardado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006421
    m_Localized: 'Miner: Dale, muestra tu valentía. Tú bajas, yo te cuido la espalda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006420
    m_Localized: 'Miner: Quieres saber qué hay en el fondo, ¿no? No eres un cobarde, se te nota. Ya viniste para acá tres veces.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006419
    m_Localized: 'Miner: Yo te subiría con un solo brazo. Pero si yo voy, ¿quién te sube a ti? Es lo más lógico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006418
    m_Localized: 'Miner: ¿Quién te va a sacar si yo bajo, AH? No te ofendas, amigo, pero he visto ratones con más músculos. Ve tú y yo me quedo aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006417
    m_Localized: ¿Y si nunca descubrimos qué hay ahí abajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006416
    m_Localized: ¿Por qué no bajas tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006415
    m_Localized: 'Miner: Tú también lo sientes, ¿verdad? Esa atracción..., como si el hueco te estuviera llamando. Lo sientes, ¿cierto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006414
    m_Localized: 'Miner: ¿Cuál otro? Mira, alguien tiene que hacer algo. No podemos quedarnos sentados para siempre. Es ahora o nunca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006413
    m_Localized: ¿Y si nunca descubrimos qué hay ahí abajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006412
    m_Localized: ¿Por qué no bajas tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006411
    m_Localized: 'Miner: Pero oye, mientras esperamos, tenemos tiempo. Tiempo para explorar todo este espacio. Admítelo, sientes curiosidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006410
    m_Localized: 'Miner: ¿Él? Ah, sí, claro. CLARO QUE ESTÁ VIVO. La cuerda sigue tensa, ¿VES? Significa que está ahí, trabajando. Si algo hubiera pasado, lo sabríamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006409
    m_Localized: ¿Tu otro amigo sigue desaparecido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006408
    m_Localized: ¿Crees que tu amigo sigue vivo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006407
    m_Localized: Pero ese hueco... sé sincero, ¿cuántas veces has sentido que te atrae? Como que te jala, ¿verdad? Admítelo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006406
    m_Localized: O tal vez solo estoy viendo cosas por estar sentado aquí tanto tiempo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006405
    m_Localized: 'Miner: AH, ERES TÚ. Creí que te habías echado para atrás. Aunque algo anda mal. La luz está como rara. La cuerda se siente más pesada de lo normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006404
    m_Localized: 'Miner: Tú no estás hecho para levantar cosas pesadas, pero yo podría subirte sin problema. ¿Qué te parece si tú bajas a curiosear y yo... me quedo vigilando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006403
    m_Localized: 'Miner: Con bajar una vez, tal vez por fin lo descubramos. Iría yo, pero... alguien tiene que sujetar la cuerda, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006402
    m_Localized: 'Miner: ¿Y si las respuestas están ahí abajo? No todas, claro. Pero por qué vinieron, qué es lo que quieren... ¡Solo piénsalo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006401
    m_Localized: 'Miner: ¿VISITANTES? ¡Ah, sí, es lo que te decía! Creemos que estos túneles son de ellos. ¿Y ese hueco? Podría ser una especie de... portal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006400
    m_Localized: 'Miner: Tenemos que trabajar en equipo, ¿sí? ¡Alguien tiene que estar listo para subirte de nuevo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006399
    m_Localized: 'Miner: No es que esté asustado, pero... como que te atrae. Ojalá pudiera mirar una vez más... solo un poco más de cerca...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006398
    m_Localized: 'Miner: De todas formas... a veces, cuando estás cerca, lo sientes. Como si algo te estuviera llamando. Inténtalo. Solo... escucha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006397
    m_Localized: 'Miner: Me acerqué, cuando los chicos todavía estaban aquí. Pero ahí abajo... es como mirar a la nada. La nada de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006396
    m_Localized: 'Miner: Me encantaría, pero mira, un mal tirón de esa cuerda y se acabó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006395
    m_Localized: 'Miner: ¿VISTO? Más o menos... No, la verdad es que no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006394
    m_Localized: ¿No crees que algo le pudo haber pasado a tus amigos allá abajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006393
    m_Localized: ¿Llegaste a ver qué hay en el hueco con tus propios ojos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006392
    m_Localized: 'Miner: ¿VES? La cuerda está tensa. Significa que todavía está trabajando ahí abajo. Si hubiese algún problema, ya lo sabríamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006391
    m_Localized: 'Miner: El otro está en la cuerda. Tirará de ella cuando esté listo, o si algo sale mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006390
    m_Localized: 'Miner: ¿AH? ¿A MIS AMIGOS? Nah, están bien. Uno se metió bien abajo, pero ya volverá. Ese sí sabe cómo encontrar una salida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006389
    m_Localized: ¿No crees que algo le pudo haber pasado a tus amigos allá abajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006388
    m_Localized: ¿Llegaste a ver qué hay en el hueco con tus propios ojos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006387
    m_Localized: 'Miner: Será mejor que comas algo allá arriba, o terminarás como yo. Muriéndote de hambre y con esta linterna a la que estoy por llamar Wilson.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006386
    m_Localized: 'Miner: El tiempo es rarísimo aquí abajo. Sin luz, ni relojes. Qué sé yo cuánto tiempo ha pasado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006385
    m_Localized: 'Miner: ¿QUÉ? ¡ALZA LA VOZ! Llevo sentado aquí, sí... dos o tres días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006384
    m_Localized: ¿Tus amigos no han vuelto todavía?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006383
    m_Localized: ¿Cuánto tiempo llevas aquí abajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006382
    m_Localized: 'Miner: ¿Ah? ¿Ya volviste? Ahora está como... más tranquilo, ¿no crees? ¿O será que me estoy quedando sordo por todo ese zumbido? ¿Y bien? ¡YA DIME!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006381
    m_Localized: 'Miner: Te diré más cuando estés aquí abajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006380
    m_Localized: 'Miner: Tratamos de cavar por ahí cerca y casi se nos cae todo esto encima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006379
    m_Localized: 'Miner: Oye, si estás pensando en bajar... mantente alejado de ese hueco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006378
    m_Localized: 'Miner: Uno de los chicos oyó algo al respecto, aunque quién sabe dónde; dijo que podría valer la pena ir a ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006377
    m_Localized: 'Miner: Es solo un pozo, pero cosas extrañas suceden cerca de él.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006376
    m_Localized: 'Miner: Nah, nada tan interesante, la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006375
    m_Localized: 'Miner: ¿Qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006374
    m_Localized: 'Miner: Tratamos de cavar por ahí cerca y casi se nos cae todo esto encima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006373
    m_Localized: 'Miner: Oye, si estás pensando en bajar... mantente alejado de ese hueco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006372
    m_Localized: 'Miner: Uno de los nuestros entró. Yo me quedé aquí arriba, por si necesita ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006371
    m_Localized: 'Miner: Los animales cercanos se callan. La brújula se vuelve loca. Las linternas no atraviesan la oscuridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006370
    m_Localized: 'Miner: Algo está pasando cerca de ahí. Siempre escuchamos un zumbido muy suave.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006369
    m_Localized: 'Miner: ¡HAY UN HUECO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006368
    m_Localized: ¿Encontraron a un Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006367
    m_Localized: ¿Qué cosa? ¿Algo interesante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006366
    m_Localized: 'Miner: Pero oye, los túneles ni siquiera son lo más extraño. Hay otra más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006365
    m_Localized: 'Miner: Todavía no hemos visto a ninguno, por eso no puedo confirmarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006364
    m_Localized: 'Miner: Creemos que los Visitantes usan estos para moverse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006363
    m_Localized: 'Miner: No sabemos quién lo cavó ni por qué. Pero tenemos nuestras teorías.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006362
    m_Localized: 'Miner: Apenas empezamos a cavar, ¿y qué encontramos? ¡Un sistema de túneles ENTERO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006361
    m_Localized: 'Miner: ¡UN REFUGIO, CARAJO! ¡Del maldito calor!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006360
    m_Localized: ¿Encontraron a un Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006359
    m_Localized: ¿Qué cosa? ¿Algo interesante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006358
    m_Localized: 'Miner: Pero no importa, porque encontramos algo más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006357
    m_Localized: 'Miner: Estos túneles son profundos, amigo. MUY PROFUNDOS. Ni idea de dónde terminan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006356
    m_Localized: 'Miner: Antes había más, pero algunos se derrumbaron hace poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006355
    m_Localized: 'Miner: Nada más comenzamos, ¡y MIRA, ya encontramos toda una red subterránea!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006354
    m_Localized: 'Miner: Los chicos y yo decidimos cavar túneles para protegernos del calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006353
    m_Localized: ¿Qué andan buscando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006352
    m_Localized: ¿Por qué están ahí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006351
    m_Localized: 'Miner: Con tanto polvo en los oídos, parece que hablas a través de una almohada. Te lo juro por el de arriba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006350
    m_Localized: 'Miner: ¿Atrapados? Qué va. Encontramos algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006349
    m_Localized: 'Miner: ¿Ah?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006348
    m_Localized: ¿Qué andan buscando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006347
    m_Localized: ¿Por qué están ahí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006346
    m_Localized: 'Miner: Bueno, esperemos que no nos caiga encima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006345
    m_Localized: 'Miner: ¿Estamos debajo de tu casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006344
    m_Localized: 'Miner: Estoy cubierto de polvo y hollín, no oigo una mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006343
    m_Localized: 'Miner: ¿Qué? ¡Alza la voz!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006342
    m_Localized: ¿Se quedaron atrapados ahí abajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006341
    m_Localized: ¿Qué hacen debajo de mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006340
    m_Localized: 'Miner: ...O eso creo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006339
    m_Localized: 'Miner: ¿Eh? ¿Quién está ahí? Creí haber escuchado algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006338
    m_Localized: 'MushroomEater: ¡Nos vemosss!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006337
    m_Localized: 'MushroomEater: Te deseo un buen día, buena salud, mucha alegría y muchas sonrisas, mi querido amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006336
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006335
    m_Localized: 'MushroomEater: Me temo que toda esperanza está perdida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006334
    m_Localized: 'MushroomEater: Muy bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006333
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006332
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006331
    m_Localized: 'MushroomEater: Así que déjame preguntar otra vez, querido amigo. ¿Vienes conmigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006330
    m_Localized: 'MushroomEater: No sé qué nos espera en la Tierra de los Hongos... ¡pero puedes estar seguro de que será peligroso!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006329
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006328
    m_Localized: 'MushroomEater: Tú y yo estamos atravesando tiempos complejos, muchacho. Todos bailarán mientras doblegamos a la Tierra de los Hongos. Puede que nosotros también lo hagamos... quién sabe...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006327
    m_Localized: 'MushroomEater: Me temo que no puedo hacer esto solo. Necesito tu ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006326
    m_Localized: 'MushroomEater: Ay, querido amigo... Esto no es nada bueno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006325
    m_Localized: 'MushroomEater: ¡Antes de que la puerta a la Tierra de los Hongos se cierre!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006324
    m_Localized: 'MushroomEater: ¡Ay, no! ¡Se nos hizo tarde! ¡Vamos, rápido!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006323
    m_Localized: 'MushroomEater: ¿¡YA ES MEDIA NOCHE?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006322
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006321
    m_Localized: 'MushroomEater: Espera. Déjame ver tu reloj un segundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006320
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006319
    m_Localized: 'MushroomEater: Agarra tus cosas y...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006318
    m_Localized: 'MushroomEater: Perfecto. ¡Ese es el espíritu, muchacho!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006317
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006316
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006315
    m_Localized: 'MushroomEater: ¿Estás listo para ir conmigo a la Tierra de los Hongos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006314
    m_Localized: 'MushroomEater: Nadie debería pisar ese lugar. Nunca. Pero tenemos que ir, si queremos detener el festival.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006313
    m_Localized: 'MushroomEater: Si no hacemos algo, todo podría estar perdido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006312
    m_Localized: 'MushroomEater: No veremos el festival desde allí... pero los demás... El micelio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006311
    m_Localized: 'MushroomEater: No es una tierra donde siempre sale el arcoíris. ¡No, no, no!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006310
    m_Localized: 'MushroomEater: Puede sonar alegre en nuestro idioma... Pero en el lenguaje de los hongos, significa algo totalmente distinto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006309
    m_Localized: 'MushroomEater: No dejes que el nombre te engañe, querido amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006308
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006307
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006306
    m_Localized: 'MushroomEater: ¿Estás listo para ir conmigo a la Tierra de los Hongos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006305
    m_Localized: 'MushroomEater: Tenemos que detener el festival, pase lo que pase.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006304
    m_Localized: 'MushroomEater: Y, la verdad es que... es mejor así. Pero no nos queda otra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006303
    m_Localized: 'MushroomEater: ¡Jojo! ¡No podrías estar más equivocado mi querido amigo! Es un lugar aterrador donde ningún hombre jamás ha llegado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006302
    m_Localized: Bueno, eso no suena tan mal...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006301
    m_Localized: ¿La Tierra de los Hongos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006300
    m_Localized: 'MushroomEater: No era mi intención, pero... me parece que tendremos que ir a la Tierra de los Hongos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006299
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006298
    m_Localized: 'MushroomEater: Lo cual que decir que el micelio está en un gran aprieto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006297
    m_Localized: 'MushroomEater: El festival significa que los hongos están creciendo sin control.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006296
    m_Localized: Bueno, eso no suena tan mal...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006295
    m_Localized: ¿La Tierra de los Hongos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006294
    m_Localized: 'MushroomEater: No era mi intención, pero... me parece que tendremos que ir a la Tierra de los Hongos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006293
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006292
    m_Localized: 'MushroomEater: Pero últimamente ha habido tanta malicia que el hongo ha crecido sin control.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006291
    m_Localized: 'MushroomEater: Los hongos son como un hígado que intenta limpiar todo ese veneno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006290
    m_Localized: 'MushroomEater: Cuando se acumula demasiada malicia en sus hilos, todo se bloquea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006289
    m_Localized: 'MushroomEater: Algo bien loco está pasando dentro del micelio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006288
    m_Localized: ¿Por qué se está celebrando el festival?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006287
    m_Localized: ¿Por qué no funcionó?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006286
    m_Localized: 'MushroomEater: El micelio está tan caótico que el ritual... no funcionó...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006285
    m_Localized: 'MushroomEater: Al parecer, el festival sí se llevará a cabo, después de todo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006284
    m_Localized: 'MushroomEater: Esto no es un adiós, mi querido amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006283
    m_Localized: 'MushroomEater: Y recuerda: los hongos no siempre son lo que parecen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006282
    m_Localized: 'MushroomEater: Nos aseguraremos de que los hongos sigan pequeños y el festival no comience.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006281
    m_Localized: 'MushroomEater: Volveré cuando llegue el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006280
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006279
    m_Localized: 'MushroomEater: El micelio es el que piensa. Es una lástima que solo pueda Escucharlo.. no habla nuestro idioma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006278
    m_Localized: 'MushroomEater: Son solo parte del micelio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006277
    m_Localized: 'MushroomEater: Eso tiene sentido... Pero no puedo hablar con los hongos. No, no, no...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006276
    m_Localized: 'MushroomEater: Esto no es un adiós, mi querido amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006275
    m_Localized: 'MushroomEater: Y recuerda: los hongos no siempre son lo que parecen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006274
    m_Localized: 'MushroomEater: Nos aseguraremos de que los hongos sigan pequeños y el festival no comience.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006273
    m_Localized: 'MushroomEater: Volveré cuando llegue el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006272
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006271
    m_Localized: 'MushroomEater: Y eso es justo lo que hicimos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006270
    m_Localized: 'MushroomEater: Pero la Guía de las Sonrisas nos mostró una manera de tranquilizar sus raíces y su crecimiento sin descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006269
    m_Localized: 'MushroomEater: ¡No, no, no! ¡No podemos hablar directamente con los hongos porque no somos parte del micelio!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006268
    m_Localized: 'MushroomEater: Hicimos un ritual viejo, mi querido muchacho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006267
    m_Localized: ¿No podrías simplemente pedirle a los hongos que no hicieran el festival y ya?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006266
    m_Localized: ¿Y cómo es que nuestras acciones van a detener el festival en realidad?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006265
    m_Localized: 'MushroomEater: Todo lo que podemos hacer ahora es esperar y confiar que haya sido suficiente para evitar que los hongos crezcan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006264
    m_Localized: 'MushroomEater: Oh, mi querido amigo... Si tan solo fuera tan simple. Aún no sabemos si lo que hicimos en verdad sirvió de algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006263
    m_Localized: ¿No podrías simplemente pedirle a los hongos que no hicieran el festival y ya?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006262
    m_Localized: ¿Y cómo es que nuestras acciones van a detener el festival en realidad?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006261
    m_Localized: 'MushroomEater: Los hongos han estado creciendo muy rápido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006260
    m_Localized: 'MushroomEater: Sabe muchas cosas. Pero ahora, él también está en peligro... al igual que todos nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006259
    m_Localized: 'MushroomEater: El micelio me lo dijo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006258
    m_Localized: No suenas convencido
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006257
    m_Localized: ¿Cómo lo sabes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006256
    m_Localized: 'MushroomEater: De verdad espero que haya sido suficiente para detener el festival...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006255
    m_Localized: 'MushroomEater: Aquí estás otra vez, muchacho. Hiciste todo lo que la Guía de las Sonrisas te pidió.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006254
    m_Localized: 'MushroomEater: Fuá... quizá solo esté perdiendo el tiempo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006253
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006252
    m_Localized: 'MushroomEater: ¿Pero por qué? Es solo una pequeña parte del libro... y me la sé de memoria...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006251
    m_Localized: 'MushroomEater: Te deseo un buen día, buena salud, mucha alegría y muchas sonrisas, mi querido amigo. ¡Nos vemosss!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006250
    m_Localized: 'MushroomEater: Volveré cuando hayas hecho todo lo que piden las páginas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006249
    m_Localized: 'MushroomEater: Bueno, pues... me tengo que ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006248
    m_Localized: 'MushroomEater: Bien. Échales un ojo cuando tengas algo de tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006247
    m_Localized: Mejor quédatelas tú
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006246
    m_Localized: Está bien, dame las benditas páginas de la Guía de las Sonrisas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006245
    m_Localized: 'MushroomEater: Arranqué unas cuantas páginas de la Guía de las Sonrisas. Por favor, tómalas. Te dirán qué debes que hacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006244
    m_Localized: 'MushroomEater: No podemos dejar que eso pase. Debemos detenerlo... Juntos, muchacho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006243
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006242
    m_Localized: 'MushroomEater: Y este hongo no estará solo. Porque es un festival, ¡uno conocido!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006241
    m_Localized: 'MushroomEater: Su sombra se tragará el sol... y no quedará ningún lugar para esconderse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006240
    m_Localized: 'MushroomEater: Un gran hongo se alzará... y esparcirá sus esporas por todas partes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006239
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006238
    m_Localized: 'MushroomEater: Lo único que te puedo contar es lo que la Guía de las Sonrisas dice del festival.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006237
    m_Localized: 'MushroomEater: Ayayay... mi querido amigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006236
    m_Localized: Mejor quédatelas tú
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006235
    m_Localized: Está bien, dame las benditas páginas de la Guía de las Sonrisas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006234
    m_Localized: 'MushroomEater: Así que saqué solo las páginas más importantes. Toma... son para ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006233
    m_Localized: 'MushroomEater: Pero me temo que no nos da tiempo a leerlo todo.. Es un libro grande... y el tiempo no está de nuestro lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006232
    m_Localized: 'MushroomEater: Es un libro especial, el más especial en todo el mundo. Y dice lo que hay que hacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006231
    m_Localized: ¿El festival del Hongo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006230
    m_Localized: ¿La Guía de las Sonrisas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006229
    m_Localized: 'MushroomEater: Mira, mira aquí... Tengo algo que nos va a ayudar: la Guía de las Sonrisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006228
    m_Localized: 'MushroomEater: No te preocupes, pronto tendrá más sentido. Pero recuerda, debemos detener el festival... a como dé lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006227
    m_Localized: ¿El festival del Gran Hongo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006226
    m_Localized: ¿La Guía de las Sonrisas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006225
    m_Localized: 'MushroomEater: Me habló del festival del Hongo, que está cerca... Y eso, mi querido amigo, no es para nada bueno. ¡No, no, no!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006224
    m_Localized: 'MushroomEater: Aprendí a entenderlo estudiando la Guía de las Sonrisas. Y lo que me dijo el micelio la última vez... me dejó muy, pero muy preocupado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006223
    m_Localized: 'MushroomEater: El micelio es la forma en que los hongos se comunican entre ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006222
    m_Localized: 'MushroomEater: Sí, sí. Pero para la gente normal es difícil de entender. Se comunica de una forma extraña.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006221
    m_Localized: No te sigo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006220
    m_Localized: ¿Micelio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006219
    m_Localized: 'MushroomEater: Así que presta mucha atención, mi querido amigo. Tenemos mucho trabajo por delante y poco tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006218
    m_Localized: 'MushroomEater: Su forma de comunicarse es compleja, pero he aprendido a entender las señales que me envían, sí que sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006217
    m_Localized: 'MushroomEater: ¡Claro que sé quién eres! ¡El micelio me lo dijo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006216
    m_Localized: No te sigo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006215
    m_Localized: ¿Micelio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006214
    m_Localized: 'MushroomEater: Así que, por favor, escucha con atención y guarda mis palabras en un lugar seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006213
    m_Localized: 'MushroomEater: El festival del Gran Hongo se acerca y el tiempo, mi querido amigo, se nos escapa de las manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006212
    m_Localized: 'MushroomEater: Pero no te preocupes por mí ahora. El micelio me dijo una cosa muy preocupante...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006211
    m_Localized: 'MushroomEater: ¡Jojojojo! Solo soy un anciano que sabe un par de cosas sobre hongos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006210
    m_Localized: ¿Me conoces?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006209
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006208
    m_Localized: 'MushroomEater: ¡Qué tal, mi querido amigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812165
    m_Localized: 'CultistPriest: Lo que se tenía que hacer ya está hecho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812164
    m_Localized: 'CultistPriest: De cualquier forma, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812163
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812162
    m_Localized: 'CultistPriest: ¿O acaso no deseas la paz de verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812161
    m_Localized: 'CultistPriest: ¿De verdad te estaban molestando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812160
    m_Localized: 'CultistPriest: Se irán conmigo. De cualquier forma, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812159
    m_Localized: 'CultistPriest: Está bien... ya hiciste suficiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812158
    m_Localized: Esto no es una guardería
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812157
    m_Localized: Déjame en paz
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812156
    m_Localized: 'CultistPriest: No tenemos más remedio que seguir llamándola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812155
    m_Localized: 'CultistPriest: Pero la Muerte en persona... tal vez nos perdone de lo peor... del vacío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812154
    m_Localized: 'CultistPriest: La reencarnación parece un tormento eterno con descansos cortos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812153
    m_Localized: 'CultistPriest: El "más allá" es solo un concepto que prometen las religiones.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812152
    m_Localized: 'CultistPriest: La idea de desaparecer para siempre es aterradora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812151
    m_Localized: 'CultistPriest: Lo que importa es que todos estamos cansados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812150
    m_Localized: 'CultistPriest: No hay problema si no entendemos por completo lo que estamos invocando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812149
    m_Localized: 'CultistPriest: Creo que su llegada está próxima, sí, sí. Puedo sentirlo, Ella vendrá...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812148
    m_Localized: Esto no es una guardería
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812147
    m_Localized: Déjame en paz
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812146
    m_Localized: 'CultistPriest: ¿Por qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812145
    m_Localized: Así que, ¿qué onda con esa Muerte tuya?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812144
    m_Localized: Llévate a tus fenómenos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812143
    m_Localized: 'CultistPriest: Buenas noches.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812142
    m_Localized: 'CultistPriest: Sabes... si la Muerte te escogió, la ayudaré a observarte más de cerca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812141
    m_Localized: 'CultistPriest: Será por eso que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812140
    m_Localized: 'CultistPriest: ¿Se han ido del reino mortal...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812139
    m_Localized: Así que, ¿qué onda con esa Muerte tuya?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812138
    m_Localized: Llévate a tus fenómenos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812137
    m_Localized: 'CultistPriest: Entonces no me quedaré más. Me iré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812136
    m_Localized: 'CultistPriest: Sí, sí. Así es como debe ser. Su mirada todavía está sobre nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812135
    m_Localized: Piérdete. Estoy ocupado
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812134
    m_Localized: Tu gente está bien
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812133
    m_Localized: 'CultistPriest: Te encuentras bien, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812132
    m_Localized: 'CultistPriest: Así es como termina el mundo. No con un estallido... sino con un llanto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812131
    m_Localized: 'CultistPriest: La Muerte ya no me habla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812130
    m_Localized: 'CultistPriest: Hasta nunca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812129
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812128
    m_Localized: 'CultistPriest: Tú... tú nos quitaste esta oportunidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812127
    m_Localized: 'CultistPriest: ¿Están muertos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812126
    m_Localized: 'CultistPriest: Espera...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812125
    m_Localized: 'CultistPriest: Todavía no sé qué significa eso... pero, ¿no suena tentador, sí, sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812124
    m_Localized: 'CultistPriest: Ella podría ofrecerte un lugar para esconderte. De todo... Incluso del final en sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812123
    m_Localized: 'CultistPriest: La Muerte me habló hace poco. Desea conocerte cuando llegue el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812122
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812121
    m_Localized: 'CultistPriest: De seguro tú también estás cansado. De todo este ruido. De estos días pesados. De esta confusión...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812120
    m_Localized: 'CultistPriest: Gracias por su ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812119
    m_Localized: Me importa un carajo. Tengo mis propios problemas de los que encargarme
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812118
    m_Localized: Sí, sí, siguen vivos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812117
    m_Localized: 'CultistPriest: No perdamos el tiempo. ¿Cómo están mis seguidores?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812116
    m_Localized: 'CultistPriest: Hasta luego. Regresaré para ver cómo están.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812115
    m_Localized: 'CultistPriest: No necesitan mucho tiempo. Pero aún así, cuida de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812114
    m_Localized: 'CultistPriest: Gracias'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812113
    m_Localized: 'CultistPriest: Probablemente no será por mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812112
    m_Localized: 'CultistPriest: Así que... solo deja que se queden, sí, sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812111
    m_Localized: 'CultistPriest: ¿A dónde huirás?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812110
    m_Localized: 'CultistPriest: Aunque sobrevivas, tu casa ya no estará.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812109
    m_Localized: 'CultistPriest: Otros vendrán. Mientras duermes, rociarán tu hogar con gasolina y lo prenderán en fuego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812108
    m_Localized: 'CultistPriest: ¿Crees que somos los únicos que hay?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812107
    m_Localized: No me gustan las amenazas. Pero los ayudaré
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812106
    m_Localized: Entonces, los mataré a todos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812105
    m_Localized: 'CultistPriest: Lamentablemente... No hay otra opción.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812104
    m_Localized: 'CultistPriest: Lamentablemente, si esto sale mal, nos vengaremos quemando tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812103
    m_Localized: 'CultistPriest: Pero si son más... y nuestra meta se nos escapa de las manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812102
    m_Localized: 'CultistPriest: Cuida de mi gente. Y recuerda, si uno de nosotros muere... tu casa será reducida a cenizas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812101
    m_Localized: 'CultistPriest: ¿No deseas tú también la paz? ¿Un mundo donde nadie sea una carga para nadie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812100
    m_Localized: 'CultistPriest: Es, en efecto, una tarea importante. El camino hacia un propósito más elevado nunca es fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812099
    m_Localized: No me gustan las amenazas. Pero los ayudaré
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812098
    m_Localized: Entonces, los mataré a todos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812097
    m_Localized: 'CultistPriest: Disculpa. Pero es el único camino a seguir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812096
    m_Localized: 'CultistPriest: Y entonces quemaremos tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812095
    m_Localized: 'CultistPriest: Pero si mueren más, fracasaremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812093
    m_Localized: 'CultistPriest: Quizá al final sí acabes ardiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812092
    m_Localized: Se oye como una tarea importante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812091
    m_Localized: No es que me esté muriendo de ganas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812090
    m_Localized: 'CultistPriest: Ellos conducirán los ritos para los difuntos. Tú solo tienes que mantenerlos a salvo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812089
    m_Localized: 'CultistPriest: Pero mis hermanos sí necesitan refugio. La Muerte se siente atraída por este lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812088
    m_Localized: 'CultistPriest: Yo no necesito pasar. Nuestra misión es difundir la fe que trae la paz eterna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812087
    m_Localized: Se oye como una tarea importante
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812086
    m_Localized: No es que me esté muriendo de ganas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812085
    m_Localized: 'CultistPriest: Deben sobrevivir el tiempo suficiente para completar sus tareas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812084
    m_Localized: 'CultistPriest: De todos modos, por favor, permite que mis hermanos se queden aquí. Dales protección.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812083
    m_Localized: 'CultistPriest: ¿Qué está pasando aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812082
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812081
    m_Localized: 'CultistPriest: La Muerte tiene una gran influencia en este lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812080
    m_Localized: 'CultistPriest: Tu casa es perfecta para ello, sí, sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812079
    m_Localized: 'CultistPriest: Tenemos que realizar los ritos funerarios. De una manera diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812078
    m_Localized: ¿Piensas entrar o qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812077
    m_Localized: Así que, ¿qué quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812076
    m_Localized: 'CultistPriest: Ya está cerca. Solo la estamos ayudando a cruzar el umbral.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812075
    m_Localized: 'CultistPriest: No creemos en la salvación. A menos que venga de la Muerte en persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812074
    m_Localized: 'CultistPriest: Este es mi sudario. Para cuando muramos. No hará falta buscar tela para envolver a los muertos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812073
    m_Localized: 'CultistPriest: Quizás. No me importaría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812072
    m_Localized: ¿Piensas entrar o qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812071
    m_Localized: Así que, ¿qué quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812070
    m_Localized: 'CultistPriest: Es la única forma de encontrar la salvación. En tiempos como estos... ya no hay vuelta atrás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812069
    m_Localized: 'CultistPriest: Nosotros solamente la estamos ayudando a acercarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812068
    m_Localized: 'CultistPriest: La Muerte ha llegado. Quiere aliviar a la humanidad, liberarnos del pánico, la amargura y el ruido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812067
    m_Localized: 'CultistPriest: Nosotros somos los heraldos de una nueva fe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812066
    m_Localized: Pareces fanático de algún culto
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812065
    m_Localized: ¿Quién rayos eres? ¿Por qué estás vestido así?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812064
    m_Localized: 'CultistPriest: La Muerte te ha agarrado cariño, sí, sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812063
    m_Localized: 'CultistPriest: Algunos fueron quemados. A otros los arrastraron y ejecutaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812062
    m_Localized: 'CultistPriest: La Muerte está en todas partes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812061
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812060
    m_Localized: 'CultistPriest: Estás en lo cierto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812059
    m_Localized: Pareces fanático de algún culto
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812058
    m_Localized: ¿Quién rayos eres? ¿Por qué estás vestido así?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812057
    m_Localized: 'CultistPriest: No sé cuántos habrán muerto aquí... pero su presencia es fuerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812056
    m_Localized: 'CultistPriest: A la Muerte le gusta tu casa. Le tiene bastante cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812055
    m_Localized: 'CultistPriest: A la Muerte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812054
    m_Localized: Sí, sí, esta es mi casa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812053
    m_Localized: ¿De qué hablas? ¿Qué sientes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812052
    m_Localized: 'CultistPriest: La puedo sentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812051
    m_Localized: 'CultistPriest: Sí, sí. Tu casa es perfecta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812050
    m_Localized: 'Courier: Aquí tienes. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812041
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812040
    m_Localized: 'Courier: ¿Por qué diablos ese imbécil pensaría que un repartidor normal es peligroso? ¿Por qué matarlo? ¿Con qué maldito propósito?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812039
    m_Localized: 'Courier: La gente ha perdido la maldita cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812038
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812037
    m_Localized: 'Courier: Estaba entregando una orden y el propietario...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812036
    m_Localized: 'Courier: Mataron a mi amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812035
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812034
    m_Localized: ¿Qué te pasó?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812033
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812030
    m_Localized: 'Courier: Su delivery...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812029
    m_Localized: 'Courier: Que pases una buena noche...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812027
    m_Localized: 'Courier: ¿Y si a mí se me ponen los ojos rojos por el cansancio? ¿Me van a arrastrar a una de esas malditas zonas de cuarentena también?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812026
    m_Localized: 'Courier: Y eso fue todo. Se lo llevaron a la fuerza. Ahora ni siquiera sé qué le pasó. Ni si lo soltarán algún día.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812025
    m_Localized: 'Courier: Chequeo matutino, como siempre. Pero le vieron los ojos. Ojos rojos, maldita sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812024
    m_Localized: 'Courier: La AFAE se llevó a mi compañero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812023
    m_Localized: Te ves algo deprimido
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812021
    m_Localized: 'Courier: Hola... Aquí está su delivery.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812020
    m_Localized: 'Courier: Que pases una buena noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812019
    m_Localized: 'Courier: Al menos trabajando puedo distraerme y no pensar en toda esta mierda...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812018
    m_Localized: 'Courier: Bueno, ¿qué más iba a hacer? ¿Sentarme en casa a pudrirme como la mayoría?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812017
    m_Localized: 'Courier: Ah, ¿te refieres a por qué terminé haciendo esto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812016
    m_Localized: 'Courier: Pasé la revisión. Buscaron todas las señales, decidieron que soy humano y...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812015
    m_Localized: ¿Cómo terminaste siendo repartidor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812013
    m_Localized: 'Courier: Hola, aquí su delivery de For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812012
    m_Localized: 'Courier: Perdón, todavía no me acostumbro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812011
    m_Localized: 'Courier: Que tengas un buen día... Ah, no, quise decir, noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812005
    m_Localized: Creí que ya no había servicio de entregas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812003
    m_Localized: 'Courier: Hola, aquí está su delivery de For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812002
    m_Localized: 'Intruder: Es duro no soñar. Es duro para cualquiera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812001
    m_Localized: 'Intruder: Espero que sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812000
    m_Localized: 'Intruder: ¿Crees que la gente volverá a soñar alguna vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811999
    m_Localized: 'Intruder: Pero si alguien más en esta casa tiene sueños, también es algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811998
    m_Localized: 'Intruder: Gracias. Trataré de dormir aquí, aunque no creo que funcione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811997
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811996
    m_Localized: Pasa, supongo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811995
    m_Localized: 'Intruder: A lo mejor si durmiera, yo también podría soñar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811994
    m_Localized: 'Intruder: Llevo seis días sin dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811993
    m_Localized: 'Intruder: Es difícil saberlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811992
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811991
    m_Localized: Pasa, supongo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811990
    m_Localized: 'Intruder: Creo que es porque perdieron ese espacio. Ese tiempo para descansar. Para reflexionar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811989
    m_Localized: 'Intruder: ¿Pero ahora? Todos están colapsando. Están enloqueciendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811988
    m_Localized: 'Intruder: Es donde la gente se relaja. Busca respuestas, encuentra consuelo... se tranquiliza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811987
    m_Localized: 'Intruder: Los sueños son... delicados. Son cosas extrañas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811986
    m_Localized: ¿Tú sí sueñas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811985
    m_Localized: ¿Por qué te importa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811984
    m_Localized: 'Intruder: Me pregunto... ¿será por el Sol? ¿O por otra cosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811983
    m_Localized: 'Intruder: Lo mismo le pasa a mucha gente. Aunque tengan fiebre... nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811982
    m_Localized: 'Intruder: Ya veo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811981
    m_Localized: ¿Tú sí sueñas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811980
    m_Localized: ¿Por qué te importa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811979
    m_Localized: 'Intruder: ¿Por qué crees que pasa eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811978
    m_Localized: 'Intruder: La gente ya casi no sueña.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811977
    m_Localized: 'Intruder: ¿Sabes qué me di cuenta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811976
    m_Localized: 'Intruder: Me refiero a los sueños. Sabes lo que es un sueño, ¿no? Cuando duermes... ¿ves algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811975
    m_Localized: La verdad, no
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811974
    m_Localized: ¿Qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811973
    m_Localized: 'Intruder: ¿Alguna vez sueñas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811972
    m_Localized: 'FormerFema: Adiós'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811971
    m_Localized: 'FormerFema: Ni siquiera sé por qué lo sigo llevando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811970
    m_Localized: 'FormerFema: Supongo que este traje da un poco de miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811969
    m_Localized: 'FormerFema: ... Espera, no me expliqué bien. Sí, lo entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811968
    m_Localized: 'FormerFema: ¿Qué? Ah, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811967
    m_Localized: 'FormerFema: La verdad pensé que no me dejarías pasar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811966
    m_Localized: 'FormerFema: ¿Hay algún lugar para sentarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811965
    m_Localized: 'FormerFema: ¿Qué? Ah, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811964
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811963
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811962
    m_Localized: 'FormerFema: Me refiero a la programación, por cierto. De escribir códigos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811961
    m_Localized: 'FormerFema: Al final no hice nada de lo que me prometieron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811960
    m_Localized: 'FormerFema: Pero luego vino la decepción.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811959
    m_Localized: 'FormerFema: Tenía mi empleo, así que creí que todo estaría bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811958
    m_Localized: 'FormerFema: Esa es una buena pregunta. En este momento solo me siento... perdido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811957
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811956
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811955
    m_Localized: 'FormerFema: Me cansé y renuncié.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811954
    m_Localized: 'FormerFema: Ya no quedábamos muchos. No podíamos seguir el ritmo. Y el trabajo solo se acumulaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811953
    m_Localized: 'FormerFema: Y... ya no trabajo ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811952
    m_Localized: 'FormerFema: Construía neveras. Y las arreglaba también.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811951
    m_Localized: 'FormerFema: Solo soy un obrero normal de una fábrica.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811950
    m_Localized: ¿Entonces cuál es tu plan?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811949
    m_Localized: ¿Entonces quién eres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811948
    m_Localized: 'FormerFema: Quién sabe qué está pasando de verdad...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811947
    m_Localized: 'FormerFema: Y nunca regresan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811946
    m_Localized: 'FormerFema: Por eso que hacen... Se llevan a la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811945
    m_Localized: 'FormerFema: Todo el mundo los odia, por lo que he visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811944
    m_Localized: 'FormerFema: ¡Ah! No, no soy de la AFAE. ¿Pensaste eso por el uniforme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811943
    m_Localized: 'FormerFema: No entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811942
    m_Localized: 'FormerFema: ¿Mm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811941
    m_Localized: ¿Entonces, qué quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811940
    m_Localized: ¿Entonces, quién eres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811939
    m_Localized: 'FormerFema: ¿Será porque el sol deja radiación por las noches? O algo así. Ni siquiera quiero saberlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811938
    m_Localized: 'FormerFema: Pensé que sería más seguro así. Por algo los usarán.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811937
    m_Localized: 'FormerFema: No, solo se lo quité a un cadáver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811936
    m_Localized: 'FormerFema: Ah... ¿pensaste que era un oficial de la AFAE por el traje?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811935
    m_Localized: 'FormerFema: ¿Que me llevé?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811934
    m_Localized: ¿Ahora viniste a buscarme a mí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811933
    m_Localized: Primero trae a los que te llevaste
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811932
    m_Localized: 'FormerFema: ¿La vas a... abrir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811931
    m_Localized: 'FormerFema: Oí pasos... eso es que te acercaste a la puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811930
    m_Localized: 'FormerFema: ¿Hola? ¿Hay alguien ahí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811929
    m_Localized: 'GraveDigger: Voy a cavar un hueco del que no voy a salir MÁS NUNCA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811928
    m_Localized: 'GraveDigger: He oído historias... uno sale de casa, regresa y... ¡PUM! Hasta ahí llegas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811927
    m_Localized: 'GraveDigger: Luego los Visitantes tocan... o peor, ya están adentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811926
    m_Localized: 'GraveDigger: Llegas a casa y está vacía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811925
    m_Localized: 'GraveDigger: Te matas cavando todo el día, toda tu maldita vida... ¿y para qué, ah?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811924
    m_Localized: 'GraveDigger: Jeje... amigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811923
    m_Localized: 'GraveDigger: Solo se rápido con esa puerta, ¿sí? Me da miedo que los Visitantes me atrapen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811922
    m_Localized: 'GraveDigger: ¡G-gracias, amigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811921
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811920
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811919
    m_Localized: 'GraveDigger: En fin, renuncié. Al diablo con todo. Me doy por vencido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811918
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811917
    m_Localized: 'GraveDigger: Ojalá los problemas nos cuidaran como nosotros nos cuidamos de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811916
    m_Localized: 'GraveDigger: El Sol quemará los cuerpos de todos modos. Y las noches... son muy cortas para lidiar con los muertos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811915
    m_Localized: 'GraveDigger: Ya nadie trae cuerpos. La gente dejó de preocuparse por la muerte, por las despedidas apropiadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811914
    m_Localized: 'GraveDigger: Mi trabajo ya no vale nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811913
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811912
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811911
    m_Localized: 'GraveDigger: Corrí como alma que lleva el diablo. Ni siquiera miré atrás. No me atreví a ir a casa. Es más seguro entre la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811910
    m_Localized: 'GraveDigger: ¡Un Visitante! ¡Saliendo de la tierra! ¿Y ese tipo? Él solo se rió.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811909
    m_Localized: 'GraveDigger: Pensé que era una roca, pero no: ¡una mano se estiró!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811908
    m_Localized: 'GraveDigger: Estaba cavando y cavando... y de repente, ¡pum!, la pala golpeó algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811907
    m_Localized: 'GraveDigger: Él se quedó ahí parado, viéndome trabajar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811906
    m_Localized: 'GraveDigger: Maldita sea. Estaba cavando una tumba para un tipo que encargó una.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811905
    m_Localized: ¿Acabas de dejar el trabajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811904
    m_Localized: ¿Viste algo interesante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617825
    m_Localized: 'GraveDigger: Solo los dejan donde caen. El Sol los cocinará de todas formas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617824
    m_Localized: 'GraveDigger: La gente está cayendo como moscas últimamente, pero nadie los entierra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617823
    m_Localized: 'GraveDigger: No viste lo que yo vi mientras cavaba ese último agujero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617822
    m_Localized: 'GraveDigger: Perdón por hacer tanto ruido. Es solo que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617821
    m_Localized: ¿Acabas de dejar el trabajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617820
    m_Localized: ¿Viste algo interesante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617819
    m_Localized: 'GraveDigger: Las tumbas ya no significan nada. La gente cae donde cae.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617818
    m_Localized: 'GraveDigger: Antes era sepulturero, ¿sabes? ¿Pero qué sentido tiene ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617817
    m_Localized: 'GraveDigger: Yo tampoco he pegado ojo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617816
    m_Localized: 'GraveDigger: Oye, no te lo tomes a mal. No quise despertarte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617815
    m_Localized: ¡Mejor golpéate tu propia maldita cabeza!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617814
    m_Localized: Deja de golpear la puerta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617813
    m_Localized: 'GraveDigger: ¿Te importaría dejarme entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617812
    m_Localized: 'GraveDigger: ¿Hay alguien vivo ahí dentro? ¿Hola?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617811
    m_Localized: 'Marauder: Bueno. Está bien entonces. Supongo que yo también me iré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617810
    m_Localized: 'Marauder: ¿Eh? ¿Ya te fuiste?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617809
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617808
    m_Localized: 'Marauder: Solo estoy de paso. No me voy a quedar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617807
    m_Localized: 'Marauder: Dime... No sabrás de algún lugar vacío cerca, ¿o sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617806
    m_Localized: 'Marauder: No hay problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617805
    m_Localized: 'Marauder: No son aburridas, te lo prometo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617804
    m_Localized: 'Marauder: Ven a hablar conmigo en algún momento. Te contaré historias. Tengo unas cuantas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617803
    m_Localized: 'Marauder: ¡Oh, al fin! Voy a poder descansar como una persona normal por una vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617802
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617801
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617800
    m_Localized: 'Marauder: En fin... si vives aquí, ¿hay alguna posibilidad de que me quede a pasar la noche?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617799
    m_Localized: 'Marauder: Pero... hubo una vez. No es una historia corta. Luego te la cuento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617798
    m_Localized: 'Marauder: Mira, no soy ningún santo, pero tengo mis límites. No me meto con los vivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617797
    m_Localized: 'Marauder: ¿Qué, crees que soy algún tipo de matón?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617796
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617795
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617794
    m_Localized: 'Marauder: Tengo historias. Cosas que he visto por ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617793
    m_Localized: 'Marauder: No te ofendas, ¿sí? Pero ya que estás aquí... ¿me dejas quedarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617792
    m_Localized: 'Marauder: Pero sí... iba a meterme en tu casa. Creí que estaba vacía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617791
    m_Localized: 'Marauder: Hubo un momento en el que estuve a punto de dejar esto para siempre. Por poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617790
    m_Localized: 'Marauder: Agarro lo que puedo. Vendo algo, me quedo con algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617789
    m_Localized: 'Marauder: Mmm. Para qué mentir. Voy a lugares abandonados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617788
    m_Localized: ¿Le robas a la gente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617787
    m_Localized: ¿Cómo sobreviviste solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617786
    m_Localized: 'Marauder: Todo esto me está empezando a afectar. Siento que me estoy volviendo loco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617785
    m_Localized: 'Marauder: ¿Pero la verdad? Estoy harto. Estoy cansado de hablar con las sombras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617784
    m_Localized: 'Marauder: Al principio, pensé que sería más seguro así.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617783
    m_Localized: 'Marauder: Desde que los Visitantes salieron de donde sea que vinieron... he estado por mi cuenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617782
    m_Localized: 'Marauder: ¿Por qué no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617781
    m_Localized: ¿Le robas a la gente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617780
    m_Localized: ¿Cómo sobreviviste solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617779
    m_Localized: 'Marauder: Pero bueno... no pude unirme a ningún grupo... por eso ando solo por aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617778
    m_Localized: 'Marauder: Lo que pasa es que yo he visto lo que la gente hace de verdad. Ni me acerco a ser el peor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617777
    m_Localized: 'Marauder: Como si yo fuera peor que el resto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617776
    m_Localized: 'Marauder: ¿Quién querría acompañarme, eh? La gente me cree basura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617775
    m_Localized: ¿Y por qué crees que esa es una buena idea?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617774
    m_Localized: ¿Por qué estás solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617773
    m_Localized: 'Marauder: Oye, eh... ¿Te importa si me quedo un rato? Ha pasado mucho desde que estuve con, ya sabes... gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617772
    m_Localized: 'Marauder: Aunque...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617771
    m_Localized: 'Marauder: Hola. Pensé que este lugar estaba muerto. Me voy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617770
    m_Localized: 'Marauder: Ah, caray... Hay alguien viviendo aquí de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617769
    m_Localized: 'Provocateur: Que tenga un buen día...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617768
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617767
    m_Localized: 'Provocateur: Y créame, eso está bajo el artículo 119 de la Constitución. Además, no se vería nada bien para usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617766
    m_Localized: 'Provocateur: Quizá quiera reconsiderar su tono. Podría interpretarlo como una amenaza a mi vida y eso es un delito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617765
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617764
    m_Localized: 'Provocateur: ¿Disculpe? ¿Me acaba de decir que debo irme? ¿Fue eso una amenaza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617763
    m_Localized: 'Provocateur: Hablaremos de los términos de la renta con todo detalle más tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617762
    m_Localized: 'Provocateur: Gracias, propietario.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617761
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617760
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617759
    m_Localized: 'Provocateur: O pago, o no pongo un pie adentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617758
    m_Localized: 'Provocateur: Es inapropiado. Es ilegal...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617757
    m_Localized: 'Provocateur: Le pido disculpas, pero mi conciencia no me permite residir aquí sin pagar renta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617756
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617755
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617754
    m_Localized: 'Provocateur: Bien. Haremos esto como debe ser después: un contrato legal en toda regla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617753
    m_Localized: 'Provocateur: Increíble... y pensar que un propietario respetable esté por ahí despreciando el dinero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617752
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617751
    m_Localized: 'Provocateur: ¿Me está haciendo un favor o algo por el estilo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617750
    m_Localized: No necesito tu dinero
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617749
    m_Localized: Bueno, paga si quieres
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617748
    m_Localized: 'Provocateur: Disculpe, pero me rehúso a ocupar un espacio valioso sin pagar mi parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617747
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617746
    m_Localized: 'Provocateur: ¿A qué se refiere con que solo deja que la gente entre? ¿Es usted alguna clase de voluntario? ¿Dirige un refugio para indigentes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617745
    m_Localized: No necesito tu dinero
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617744
    m_Localized: Bueno, paga si quieres
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617743
    m_Localized: 'Provocateur: Eso sí... Solo para que quede claro, ¿cuánto cobra por noche?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617742
    m_Localized: 'Provocateur: Bueno, está bien. Supongo que finalizaremos el acuerdo después.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617741
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617740
    m_Localized: 'Provocateur: Esa es... una respuesta un tanto vaga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617739
    m_Localized: Solo dejo que la gente entre
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617738
    m_Localized: Algo así
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617737
    m_Localized: 'Provocateur: Buenos días, propietario. ¿Está rentando este lugar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617736
    m_Localized: 'TaxiDriver: Eres igual que esos malditos de la AFAE. Ojalá te mueras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617735
    m_Localized: 'TaxiDriver: Maldita sea...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617734
    m_Localized: 'TaxiDriver: Sí, me asusté, lo acepto, pero no es para que me dejes aquí botado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617733
    m_Localized: 'TaxiDriver: ¡Vamos, amigo, no me hagas esto!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617732
    m_Localized: 'TaxiDriver: Si te descuidas, te atrapan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617731
    m_Localized: 'TaxiDriver: Solo recuerda esto: no confíes en esos malditos que van de amarillo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617730
    m_Localized: 'TaxiDriver: Uf, gracias, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617729
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617728
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617727
    m_Localized: 'TaxiDriver: Por eso me escapé. Ahora no puedo ni ir a mi casa. Esos malditos seguro ya me están esperando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617726
    m_Localized: 'TaxiDriver: Querían llevarme a mí también, junto con lo que les había traído.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617725
    m_Localized: 'TaxiDriver: No lo dudé un segundo, lo llevé directo a la AFAE. Tremendo error.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617724
    m_Localized: 'TaxiDriver: Solo lo vi un instante en el retrovisor y vi esos dientes blancos como vallas publicitarias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617723
    m_Localized: 'TaxiDriver: Era un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617722
    m_Localized: 'TaxiDriver: No vayas a pensar que estoy paranoico ni nada, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617721
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617720
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617719
    m_Localized: 'TaxiDriver: Así que le rompí una botella en la cabeza a uno de ellos que llevaba escondida en mi abrigo y corrí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617718
    m_Localized: 'TaxiDriver: Esos payasos me jalaron para alejarme de mi auto, ¡y me di cuenta de que los malditos me querían a mí también!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617717
    m_Localized: 'TaxiDriver: Al principio me felicitaron, tipo: "Buen trabajo, nos trajiste un Visitante" y esas bobadas. Pero después...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617716
    m_Localized: 'TaxiDriver: Así que lo llevé a la AFAE sin que se diera cuenta, pero las cosas no salieron tan bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617715
    m_Localized: 'TaxiDriver: Bueno, venía con un pasajero, ¿no? Pero me di cuenta de que sus dientes eran muy blancos. Eran como que demasiaaado perfectos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617714
    m_Localized: 'TaxiDriver: Esos malditos de la AFAE, hijos de puta, me robaron mi auto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617713
    m_Localized: ¿Qué pasó con tu pasajero?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617712
    m_Localized: ¿Qué pasó con tu auto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617711
    m_Localized: 'TaxiDriver: No es que sea estúpido, no... pero sí confié en el tipo equivocado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617710
    m_Localized: 'TaxiDriver: Lo perdí por mi propia estupidez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617709
    m_Localized: 'TaxiDriver: Tenía mi auto, sí... pero ya no está.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617708
    m_Localized: ¿Qué pasó con tu pasajero?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617707
    m_Localized: ¿Qué pasó con tu auto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617706
    m_Localized: 'TaxiDriver: Ahora ni estoy con él... ni tengo mi auto tampoco, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617705
    m_Localized: 'TaxiDriver: Resulta que no era quien decía ser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617704
    m_Localized: 'TaxiDriver: Venía manejando con un pasajero y entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617703
    m_Localized: 'TaxiDriver: ¿Por dónde empiezo? Soy taxista, ya sabes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617702
    m_Localized: ¿En qué necesitas ayuda?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617701
    m_Localized: ¿Qué pasó?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617700
    m_Localized: 'TaxiDriver: Mira, ando en tremendo problema. ¿Te molesta si me escondo aquí por un rato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617699
    m_Localized: 'TaxiDriver: Ey, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617698
    m_Localized: 'Edgar: Ya encontraré sombra en algún lugar. Pero, por favor... no dejes que se deshagan mi cuerpo, cuando llegue la hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617697
    m_Localized: 'Edgar: Esperaré a que la muerte me acoja en su dulce abrazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617696
    m_Localized: 'Edgar: ¿Te molesta si me quedo por aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617695
    m_Localized: 'Edgar: Conserva el mío, cuando llegue la hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617694
    m_Localized: 'Edgar: Aún no sé si tú ves la belleza como yo. Pero dime... Los cuerpos, ¿se los dejas a la gran noche?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617693
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617692
    m_Localized: 'Edgar: La verdad es que aquí es más tranquilo que cualquier otro lugar en el que haya estado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617691
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617690
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617689
    m_Localized: 'Edgar: Moriré aquí y me fusionaré con este mundo, hacia el final desconocido. Y me iré en paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617688
    m_Localized: 'Edgar: Por eso vine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617687
    m_Localized: 'Edgar: No. No necesito tanta amabilidad. De alguna forma... siento que aquí se acepta fácilmente lo inevitable.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617686
    m_Localized: 'Edgar: ¿Piensas que ayudaría con la sepsis?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617685
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617684
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617683
    m_Localized: 'Edgar: Y ahora estoy aquí. Ante ti. Solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617682
    m_Localized: 'Edgar: Hasta que llegaron los otros. Y, bueno... confío en que ya te imaginas el resto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617681
    m_Localized: 'Edgar: Ella cambiaba... cada día. Poco a poco. Y, oh, era maravilloso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617680
    m_Localized: 'Edgar: Una vez viví con una chica que adoraba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617679
    m_Localized: 'Edgar: Es una buena pregunta. De momento... déjame decirte esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617678
    m_Localized: ¿Deberíamos amputarte el brazo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617677
    m_Localized: ¿Cómo te dio gangrena?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617676
    m_Localized: 'Edgar: No estoy hecho para el pánico. Donde los vivos luchan contra la corriente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617675
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617674
    m_Localized: 'Edgar: Un cuento como el mío es mejor tomárselo de un solo trago.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617673
    m_Localized: 'Edgar: Cada mañana, cuando me despierto, me quedo tumbado y me pregunto si viviré para ver el día siguiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617672
    m_Localized: 'Edgar: De todas formas temblaría. Por la putrefacción, ya ves.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617671
    m_Localized: 'Edgar: Una fiebre atrapada. El aire ya no enfría las calles al caer la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617670
    m_Localized: 'Edgar: Siento escalofríos, incluso atrapado en el frenético calor de la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617669
    m_Localized: 'Edgar: El silencio... la nada. Hay tanta calma aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617668
    m_Localized: ¿Deberíamos amputarte el brazo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617667
    m_Localized: ¿Cómo te dio gangrena?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617666
    m_Localized: 'Edgar: Me gustaría morir aquí. Lenta y calladamente. Para saborear el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617665
    m_Localized: 'Edgar: Todo el mundo lucha por sobrevivir. Pero aquí... están en paz con lo que les depara el destino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617664
    m_Localized: 'Edgar: El ruido de la ciudad se adhiere a mí como el sudor. El frenesí, el caos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617663
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617662
    m_Localized: 'Edgar: Un cuento como el mío es mejor tomárselo de un solo trago.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617661
    m_Localized: 'Edgar: Cada mañana, cuando me despierto, me quedo tumbado y me pregunto si viviré para ver el día siguiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617660
    m_Localized: 'Edgar: Me siento realmente mal. Y no es solo la gangrena, ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617659
    m_Localized: ¿Qué tiene de bonito este lugar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617658
    m_Localized: ¿Por qué no te quedaste en casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617657
    m_Localized: 'Edgar: Esperaba poder abusar de tu amabilidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617656
    m_Localized: 'Edgar: Es más tranquilo aquí. Allá en la ciudad todo es un griterío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617655
    m_Localized: 'Edgar: Hola. Qué bonita es esta casa por aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617654
    m_Localized: 'Foreigner: (Después de unos segundos, se da la vuelta y se va)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617653
    m_Localized: 'Foreigner: (Tu grito lo asusta)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617652
    m_Localized: 'Foreigner: ¡Ya vete!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617651
    m_Localized: 'Foreigner: (Se queda ahí parado, murmurando)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617650
    m_Localized: 'Foreigner: (Asiente con la cabeza y pasa)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617649
    m_Localized: Vete
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617648
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617647
    m_Localized: 'Foreigner: (No estás seguro, pero parece que sus mejillas están húmedas con sus lágrimas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617646
    m_Localized: 'Foreigner: (Solo se queda ahí parado, mirando por la mirilla)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617645
    m_Localized: Vete
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617644
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617643
    m_Localized: 'Foreigner: (No estás seguro, pero parece que sus mejillas están húmedas con sus lágrimas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617642
    m_Localized: 'Foreigner: (Murmura algo, agitando los brazos)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617641
    m_Localized: ¿Y qué se supone que haga contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617640
    m_Localized: ¿Tienes la boca cosida?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617639
    m_Localized: 'Foreigner: (Murmura otra vez, pero no logras entender nada)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617638
    m_Localized: 'Foreigner: (Arquea las cejas, angustiado)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617637
    m_Localized: ¿Y qué se supone que haga contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617636
    m_Localized: ¿Tienes la boca cosida?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617635
    m_Localized: 'Foreigner: (Parece que no puede responderte)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617634
    m_Localized: 'Foreigner: (El hombre te mira con las cejas levantadas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617633
    m_Localized: ¿Qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617632
    m_Localized: ¿Qué te pasa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617631
    m_Localized: 'Foreigner: ¡¿Mmmmmmmph?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617630
    m_Localized: 'Foreigner: Mmmph.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617629
    m_Localized: 'Doctor: Si tengo suerte, estaré cerca, así que no dudes en pedirme ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617628
    m_Localized: 'Doctor: Entiendo, no es el mejor momento para confiar en nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617627
    m_Localized: 'Doctor: Gracias. Espero poder ayudar a alguien aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617626
    m_Localized: Debería irse
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617625
    m_Localized: Pase
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617624
    m_Localized: 'Doctor: Si me dejas pasar, te puedo contar qué pasó con los hospitales.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617623
    m_Localized: 'Doctor: Es un cuento largo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617622
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617621
    m_Localized: 'Doctor: Había un hospital en el centro de la ciudad. Pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668865
    m_Localized: 'Doctor: Si me dejas pasar, te puedo contar qué pasó con los hospitales.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668864
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617620
    m_Localized: Debería irse
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617619
    m_Localized: Pase
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617618
    m_Localized: 'Doctor: Y ahora... ya no hay hospitales. Así que solo ando por ahí y ayudo donde puedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617617
    m_Localized: 'Doctor: Nuestro hospital siempre andaba corto de dinero, así que terminé haciendo mucho más de lo que mi trabajo exigía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617616
    m_Localized: 'Doctor: Era cirujano, operaba a la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617614
    m_Localized: ¿De dónde viene?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617613
    m_Localized: ¿Quién es usted?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617612
    m_Localized: 'Doctor: Así que pensé: "voy a ver". Pero la puerta estaba cerrada, así que decidí tocar antes de tumbarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617611
    m_Localized: 'Doctor: Y con todo este silencio, honestamente no creí que alguien viviera aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617610
    m_Localized: 'Doctor: Seguridad... y quizás algo para evitar el aburrimiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617609
    m_Localized: 'Doctor: Pues sí, busco algo, pero lo mismo que todos los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617608
    m_Localized: 'Doctor: ¿Por qué me lo preguntas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617607
    m_Localized: ¿De dónde viene?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617606
    m_Localized: ¿Quién es usted?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617605
    m_Localized: 'Doctor: O... agonizando...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617604
    m_Localized: 'Doctor: O... llorando...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617603
    m_Localized: 'Doctor: Lo normal es que alguien esté gritando por la borrachera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617602
    m_Localized: 'Doctor: Es raro que una casa llena se quede en silencio por la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617601
    m_Localized: 'Doctor: ¿Qué? Ja, no, claro que no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617600
    m_Localized: ¿Está buscando algo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423454
    m_Localized: ¿Estaba vigilando mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423453
    m_Localized: 'Doctor: ¡Buenas noches! ¿Puedo pasar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423452
    m_Localized: 'Doctor: Qué callado es esto de noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423451
    m_Localized: 'Doctor: Ah, pensé que no había nadie en casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423450
    m_Localized: 'Wolfhound: Ya vas a saber de mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423449
    m_Localized: 'Wolfhound: Ahhh... ya veo cómo es la cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423448
    m_Localized: 'Wolfhound: La fuerza es la que manda ahora. O te adaptas a ella o se vuelve en tu contra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423447
    m_Localized: 'Wolfhound: Buena elección.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423446
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423445
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423444
    m_Localized: 'Wolfhound: El punto es que no estoy aquí para causar problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423443
    m_Localized: 'Wolfhound: Yo no te pregunto cómo vives, así que no preguntes por mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423442
    m_Localized: 'Wolfhound: Lo que no sabes no puede hacerte daño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423441
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423440
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423439
    m_Localized: 'Wolfhound: ¿Y tú? Aquí todavía hay orden. Eso es raro. Me da curiosidad saber cómo lo mantienes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423438
    m_Localized: 'Wolfhound: Pero he visto el mismo caos en todos lados. El miedo ciega a la gente de lo que realmente sucede.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423437
    m_Localized: 'Wolfhound: Nunca me quedo en un lugar por mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423436
    m_Localized: ¿Cómo sobreviviste tanto tiempo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423435
    m_Localized: ¿Cuántos lugares has visto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423434
    m_Localized: 'Wolfhound: Quien diga lo contrario amanecerá muerto mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423433
    m_Localized: 'Wolfhound: Este es el nuevo orden: los fuertes mandan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423432
    m_Localized: 'Wolfhound: Si lo sigues negando, te comerán vivo. No quedará ni rastro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423431
    m_Localized: 'Wolfhound: Todos somos animales.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423430
    m_Localized: ¿Cómo sobreviviste tanto tiempo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423429
    m_Localized: ¿A cuántos sitios has ido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423428
    m_Localized: 'Wolfhound: Ahora es simple. Si puedes cortarle la garganta a alguien, ganas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423427
    m_Localized: 'Wolfhound: Todas tus reglas y tu moral desaparecieron. Ya no sirven.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423426
    m_Localized: 'Wolfhound: ¿Has estado en otras casas? ¿Has caminado por las calles?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423425
    m_Localized: ¿Acaso eres tú una de esas "bestias"?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423424
    m_Localized: ¿De qué estás hablando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423423
    m_Localized: 'Wolfhound: Por fin... se acabó la farsa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423422
    m_Localized: 'Wolfhound: Esto ya no es una sociedad. Se desataron las bestias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423421
    m_Localized: 'Wolfhound: El mundo se fue al diablo, ¿eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423420
    m_Localized: 'Wolfhound: ¡Ey!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423419
    m_Localized: 'SuperFake: Entonces, ¿por qué te resistes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423418
    m_Localized: 'SuperFake: TODO terminará pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423417
    m_Localized: 'SuperFake: ¿A qué te aferras?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423416
    m_Localized: 'SuperFake: ¿Por qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423415
    m_Localized: 'SuperFake: Huyendo, siempre huyendo. De mi gente, de la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423414
    m_Localized: 'SuperFake: Por eso estoy aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423413
    m_Localized: 'SuperFake: Sigues sin poder tomar el control de la situación.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423412
    m_Localized: 'SuperFake: Sssssí'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423411
    m_Localized: 'SuperFake: ¿Tienes miedo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423410
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423409
    m_Localized: 'SuperFake: Así que estás listo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423408
    m_Localized: Me deshice de algunos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423407
    m_Localized: Me deshice de todos los que estorbaban
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423406
    m_Localized: Solo dejo entrar a los indicados
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423405
    m_Localized: Aquí hay muchos... no-humanos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423404
    m_Localized: No dejé entrar a nadie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423403
    m_Localized: Hay muchas personas aquí
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423402
    m_Localized: 'SuperFake: ¿Dejaste entrar a mi gente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423401
    m_Localized: 'SuperFake: Pero hay otra cosa que me intriga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423400
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423399
    m_Localized: 'SuperFake: ¿Siquiera sentirás algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423398
    m_Localized: 'SuperFake: ¿Solo... desapareces? ¿Para siempre?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423397
    m_Localized: 'SuperFake: Te mueres. ¿Y luego qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423396
    m_Localized: 'SuperFake: Parece que piensas más en lo que viene después.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423395
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423394
    m_Localized: 'SuperFake: ¿Sueles preguntarte por qué sigues vivo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423393
    m_Localized: 'SuperFake: ¿Le temes a lo desconocido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423392
    m_Localized: Me deshice de algunos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423391
    m_Localized: Me deshice de todos los que estorbaban
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423390
    m_Localized: Solo dejo entrar a los indicados
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423389
    m_Localized: Aquí hay muchos... no-humanos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423388
    m_Localized: No dejé entrar a nadie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423387
    m_Localized: Hay muchas personas aquí
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423386
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423385
    m_Localized: 'SuperFake: ¿Dejaste entrar a mi gente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423384
    m_Localized: 'SuperFake: Pero por ahora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423383
    m_Localized: 'SuperFake: Pero... vas a desaparecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423382
    m_Localized: 'SuperFake: Si no es hoy, será mañana. Si no es mañana, será después.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423381
    m_Localized: 'SuperFake: Vas a morir...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423380
    m_Localized: 'SuperFake: Pero el resultado es el mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423379
    m_Localized: 'SuperFake: ¿Para cambiar algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423378
    m_Localized: 'SuperFake: Me enviaron por ti por una razón...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423377
    m_Localized: 'SuperFake: ¿No has pensado que... fuiste elegido? Jajaja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423376
    m_Localized: 'SuperFake: ¿Ahora es que me lo preguntas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423375
    m_Localized: ¿Por qué no solo derribas la puerta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423374
    m_Localized: ¿Por qué sigues viniendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423373
    m_Localized: 'SuperFake: No te preocupes, te ayudaremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423372
    m_Localized: 'SuperFake: Es gracioso cómo TÚ no sientes nada en absoluto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423371
    m_Localized: 'SuperFake: No te puedo decir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423370
    m_Localized: ¿Por qué no solo derribas la puerta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423369
    m_Localized: ¿Por qué sigues viniendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423368
    m_Localized: 'SuperFake: Ya les está respirando en la nuca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423367
    m_Localized: 'SuperFake: ¿Pero lo sientes? ¿Cómo la Muerte se acercara más y más?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423366
    m_Localized: 'SuperFake: Eso es todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423365
    m_Localized: 'SuperFake: Solo repito lo que a mí me dijeron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423364
    m_Localized: ¿Qué fin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423363
    m_Localized: ¿A qué te refieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423362
    m_Localized: 'SuperFake: Si no lo hacemos nosotros, ustedes mismos lo terminarán.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423361
    m_Localized: 'SuperFake: Todo esto está llegando a su fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423360
    m_Localized: 'SuperFake: Me dijeron que esta sería la última vez que hablaríamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423359
    m_Localized: 'SuperFake: ¿Hasta la próxima vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423358
    m_Localized: 'SuperFake: En fin...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423357
    m_Localized: 'SuperFake: Yo solo sigo órdenes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423356
    m_Localized: 'SuperFake: Hay fuerzas más poderosas que yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423355
    m_Localized: 'SuperFake: No te creerás que yo estoy a cargo, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423354
    m_Localized: 'SuperFake: El cambio no es lo peor que les espera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423353
    m_Localized: 'SuperFake: Ahora hasta los míos son raros de ver. Ni hablar de los tuyos, encerrados en sus casas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423352
    m_Localized: 'SuperFake: Vaya, vaya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423351
    m_Localized: 'SuperFake: Ven conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423350
    m_Localized: 'SuperFake: Sssssí... La apuesta está dando frutosss.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423349
    m_Localized: 'SuperFake: Mmm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423348
    m_Localized: No estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423347
    m_Localized: Estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423346
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423345
    m_Localized: 'SuperFake: Pero antes de irme, vamos a hacer nuestra apuesta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423344
    m_Localized: 'SuperFake: Lástima... Me iré... por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423343
    m_Localized: No estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423342
    m_Localized: Estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423341
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423340
    m_Localized: 'SuperFake: Pero primero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423339
    m_Localized: 'SuperFake: Intentémoslo'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423338
    m_Localized: 'SuperFake: Es simple.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423337
    m_Localized: ¿Puedes regresar más tarde?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423336
    m_Localized: No entiendo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423335
    m_Localized: 'SuperFake: Entonces me abrirás la puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423334
    m_Localized: 'SuperFake: Si tienes al menos a dos de los MÍOS dentro de tu casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423333
    m_Localized: 'SuperFake: Vamos a arreglar eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423332
    m_Localized: 'SuperFake: Como si no te quisieras ni a ti mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423331
    m_Localized: 'SuperFake: Qué desapegado eres, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423330
    m_Localized: ¿Puedes regresar más tarde?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423329
    m_Localized: No entiendo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423328
    m_Localized: 'SuperFake: Porque ahora, son las bestias las que andan entre nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423327
    m_Localized: 'SuperFake: Entonces me abrirás la puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423326
    m_Localized: 'SuperFake: Si tienes al menos a dos de los MÍOS dentro de tu casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423325
    m_Localized: 'SuperFake: ¿Por qué no hacemos algo nuevo? Vamos a apostar, sí, un juego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423324
    m_Localized: 'SuperFake: Se oye como si necesitaras ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423323
    m_Localized: 'SuperFake: Debe ser difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423322
    m_Localized: No me interesa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423321
    m_Localized: No siento nada
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423320
    m_Localized: 'SuperFake: Cosas extrañas ocurren a tu alrededor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423319
    m_Localized: 'SuperFake: Sabes de quién hablo, ¿sssí sabess?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423318
    m_Localized: 'SuperFake: Alguien que solo te habla y dice simples palabras. ¡Pero qué palabras!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423317
    m_Localized: 'SuperFake: Y ahora también hay un inmortal entre los que vienen a verte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423316
    m_Localized: 'SuperFake: Y... yo también.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423315
    m_Localized: 'SuperFake: El cambio te está persiguiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423314
    m_Localized: 'SuperFake: ¿Lo sieeeeentes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423313
    m_Localized: 'SuperFake: Cuando nos volvamos a encontrar, va a ser... más interesante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423312
    m_Localized: 'SuperFake: Te estás quedando atrás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423311
    m_Localized: 'SuperFake: La vida ya no es la misma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423310
    m_Localized: 'SuperFake: Lo entiendes, ¿no? Las cosas no volverán a ser como antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423309
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423308
    m_Localized: 'SuperFake: El mundo es de las bestias ahora. Solo las bestias sobrevivirán.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423307
    m_Localized: 'SuperFake: ¿Y para qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423306
    m_Localized: 'SuperFake: Sigues intentando reconstruir tu vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423305
    m_Localized: 'SuperFake: Solo abriré la puerta y te dejaréee un regalito para que te vayas despidiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423304
    m_Localized: 'SuperFake: ¿No te fue bien con nadie, eh...? Lástima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423303
    m_Localized: 'SuperFake: O sea, que estás solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423302
    m_Localized: No estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423301
    m_Localized: Estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423300
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423299
    m_Localized: 'SuperFake: Escuuuuucha'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423298
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423297
    m_Localized: 'SuperFake: Lo único que puedes parar es el latido de un corazón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423296
    m_Localized: 'SuperFake: ¿Detener las inundaciones, los incendios, la descomposición?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229051
    m_Localized: 'SuperFake: ¿Puedes detener a la muerte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229050
    m_Localized: 'SuperFake: ¿Y qué puedes hacer tú?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229049
    m_Localized: No estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229048
    m_Localized: Estoy solo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229047
    m_Localized: 'SuperFake: ¿Estás solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229046
    m_Localized: 'SuperFake: Escuuuuucha'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229045
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229044
    m_Localized: 'SuperFake: ¿Y contra la muerte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229043
    m_Localized: 'SuperFake: ¿Contra una Calamidad cósmica?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229042
    m_Localized: 'SuperFake: Pero ¿qué puedes hacer tú contra los desastres naturales?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229041
    m_Localized: 'SuperFake: ¡Sí, ya sé!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229040
    m_Localized: Hago lo que puedo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229039
    m_Localized: No puedo hacer nada
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229038
    m_Localized: 'SuperFake: ¿O quieres arreglarlo todo tú solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229037
    m_Localized: 'SuperFake: Es una bendición, ¿no crees?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229036
    m_Localized: 'SuperFake: Ya todo está decidido por nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229035
    m_Localized: 'SuperFake: Ni te molestes en pensar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229034
    m_Localized: Hago lo que puedo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229033
    m_Localized: No puedo hacer nada
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229032
    m_Localized: 'SuperFake: O tal vez deberíamos tomar el asunto en nuestras propias manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229031
    m_Localized: 'SuperFake: A lo mejor los de los trajes ponen orden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229030
    m_Localized: 'SuperFake: Una cosa tras otra, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229029
    m_Localized: 'SuperFake: La cosa está mal últimamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229028
    m_Localized: No sé qué pensar de él
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229027
    m_Localized: Solo está haciendo su trabajo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229026
    m_Localized: 'SuperFake: ¿Qué piensas de ese de ahí? ¿El del traje amarillo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229025
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229024
    m_Localized: 'SuperFake: Todavía sigues escondido en esta casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229023
    m_Localized: 'Greatmother: Traeré a mi gente para acá. Cariño, yo te ayudaré a que no mueras solo... ¡JAJAJAJAJA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229022
    m_Localized: 'Greatmother: ¡JAJAJAJAJA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229021
    m_Localized: 'Greatmother: La verdad es que... no le abras a nadie y ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229020
    m_Localized: 'Greatmother: Sí, sí, solo... no le abras la puerta a los de los trajes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229019
    m_Localized: 'Greatmother: Apenas te descuides, nos estarán arrastrando a los dos a alguna parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229018
    m_Localized: 'Greatmother: Je, gracias. No le vayas a abrir a los trajes amarillos si tocan la puerta, ¿de acuerdo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229017
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229016
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229015
    m_Localized: 'Greatmother: Así que ahora lo único que me importa es seguir con vida, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229014
    m_Localized: 'Greatmother: Se sintió como si se hubieran llevado a la mitad. Al resto ni los persiguieron mucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229013
    m_Localized: 'Greatmother: Algunos no salían, así que los de traje solo los jalaban, como si estuvieran escogiendo al azar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229012
    m_Localized: 'Greatmother: ¡Te lo juro, fue a todo el maldito edificio!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229011
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229010
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229009
    m_Localized: 'Greatmother: A otros los dejaron ir como si nada hubiera pasado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229008
    m_Localized: 'Greatmother: Los trajes amarillos entraron de golpe, sacaron a la gente. Agarraron a algunos y se los llevaron para investigar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229007
    m_Localized: 'Greatmother: Dijeron que nuestro edificio recibió un gran impacto solar o alguna locura así.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229006
    m_Localized: ¿Eran muchos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229005
    m_Localized: ¿Por qué los desalojaron?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229004
    m_Localized: 'Greatmother: Desde entonces he estado huyendo, buscando un lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229003
    m_Localized: 'Greatmother: Desalojaron toda la maldita cuadra y nadie sabe a dónde ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229002
    m_Localized: 'Greatmother: No busco a nadie. Solo necesito un lugar donde quedarme, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229001
    m_Localized: ¿Eran muchos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229000
    m_Localized: ¿Por qué los desalojaron?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228999
    m_Localized: 'Greatmother: La gente salió corriendo para todos lados. Yo vine aquí para intentar sobrevivir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228998
    m_Localized: 'Greatmother: Sin refugio, ni ayuda. ¿A dónde se supone que vayamos? ¿Qué se supone que hagamos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228997
    m_Localized: 'Greatmother: La gente de los trajes amarillos nos sacaron a patadas del edificio, pero no nos llevaron a ningún lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228996
    m_Localized: 'Greatmother: Los míos y yo antes vivíamos a un par de cuadras de aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228995
    m_Localized: ¿Estás buscando a alguien?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228994
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228993
    m_Localized: 'Greatmother: ¿Hay alguien en casa o qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228992
    m_Localized: 'Greatmother: ¡Holaaa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034796
    m_Localized: 'Cold: Cierto. Seguro no quieres gastar tus b-b-balas. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034795
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034794
    m_Localized: 'Cold: ¿P-podrías dispararme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034793
    m_Localized: 'Cold: Tienes bastantes manchas de pólvora e-en las manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034792
    m_Localized: 'Cold: Bueno, adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034791
    m_Localized: 'Cold: Lo entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034790
    m_Localized: 'Cold: El techo es algo b-bajo, pero no pasa nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034789
    m_Localized: 'Cold: G-gracias'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034788
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034787
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034786
    m_Localized: 'Cold: Me iré. No suplicaré. No te m-m-molestaré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034785
    m_Localized: 'Cold: No tienes por qué dejarme e-entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034784
    m_Localized: 'Cold: No'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034783
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034782
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034781
    m_Localized: 'Cold: ¿Qué tal si empeora? ¿Y s-sigo sin poder morir por eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034780
    m_Localized: 'Cold: Me da miedo quitarme la ropa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034779
    m_Localized: 'Cold: Otros se q-queman con el Sol. Yo me envuelvo en capas y aún siento frío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034778
    m_Localized: 'Cold: Siempre tengo f-frío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034777
    m_Localized: Quítate la chaqueta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034776
    m_Localized: ¿No te molesta el calor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034775
    m_Localized: 'Cold: No en... m-mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034774
    m_Localized: 'Cold: Nunca lo he sentido. La p-paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034773
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034772
    m_Localized: Quítate la chaqueta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034771
    m_Localized: ¿No te molesta el calor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034770
    m_Localized: 'Cold: Pero luego, t-todavía no estoy seguro de que puedo confiar en ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034769
    m_Localized: 'Cold: No lo soy. Pero s-sí tengo un favor que pedir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034768
    m_Localized: 'Cold: Ya no importa. Te e-estarás preguntando si soy un Visitante, ¿cierto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034767
    m_Localized: ¿Cuánto tiempo llevas buscando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034766
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034765
    m_Localized: 'Cold: ¿Será que puedo encontrar p-p-paz aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034764
    m_Localized: 'Cold: El calor no me m-molesta. Aún así, estoy buscando un lugar tranquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034763
    m_Localized: 'Cold: H-hola'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034762
    m_Localized: 'Hunter: Pero te prometo que les haré la vida imposible. Ya verás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034761
    m_Localized: 'Hunter: Me habrías cortado la garganta en la mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034760
    m_Localized: 'Hunter: Así es mejor. A lo mejor eres uno de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034759
    m_Localized: 'Hunter: Vamos a aniquilarlos. No dejaremos que se acerquen ni a un kilómetro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034758
    m_Localized: 'Hunter: Sabía que no eras blando. Tienes agallas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034757
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034756
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034755
    m_Localized: 'Hunter: No tienen nada de humanos, solo la piel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034754
    m_Localized: 'Hunter: Corrí y te juro que lo que hicieron fue que me dispararon. Esa es su forma de divertirse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034753
    m_Localized: 'Hunter: Esperaron hasta que caí rendido. Me lo quitaron mientras dormía, ¡así como si nada!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034752
    m_Localized: 'Hunter: Antes tenía un rifle. Casi me cuesta la vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034751
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034750
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034749
    m_Localized: 'Hunter: Tienes que tener cuidado con ellos, eso es todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034748
    m_Localized: 'Hunter: Si dejas ir a uno, mañana te cortarán la garganta. ¿Me entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034747
    m_Localized: 'Hunter: ¿O qué, solo los espantas? No pareces un idiota para ser tan joven.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034746
    m_Localized: 'Hunter: ¿No estás haciendo lo mismo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034745
    m_Localized: ¿Dónde está tu arma, entonces?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034744
    m_Localized: ¿Quieres cazar a los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034743
    m_Localized: 'Hunter: Te lo digo, algo están tramando. Y hay que acabar con ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034742
    m_Localized: 'Hunter: Desde esa maldita cosa del Sol, han estado saliendo más, escabulléndose por todos lados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034741
    m_Localized: 'Hunter: ¿Dónde, aquí? Solo vine aquí para descansar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034740
    m_Localized: ¿Dónde está tu arma, entonces?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034739
    m_Localized: ¿Quieres cazar a los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034738
    m_Localized: 'Hunter: Deben ser eliminados. Que no quede ni uno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034737
    m_Localized: 'Hunter: Fingen ser uno de nosotros... y luego todo se va al infierno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034736
    m_Localized: 'Hunter: Casa tras casa, hay alguien muerto, hecho pedazos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034735
    m_Localized: 'Hunter: ¿Has visto lo que están haciendo los Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034734
    m_Localized: ¿Qué buscas por aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034733
    m_Localized: ¿Por qué viajas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034732
    m_Localized: 'Hunter: Ya no puedo viajar como solía hacerlo. La edad te hace eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034731
    m_Localized: 'Hunter: No soy de por aquí. Nunca fui de quedarme en el mismo lugar mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034730
    m_Localized: 'Hunter: Hola, joven. ¿Qué tal están las cosas por aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034729
    m_Localized: 'Prophet: Nos vemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034728
    m_Localized: 'Prophet: ... Creo que mejor me voy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034727
    m_Localized: 'Prophet: No me quedan fuerzas para seguir leyendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034726
    m_Localized: 'Prophet: "Nuestra juventud gritó como las piras de Ruán en llamas..."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034725
    m_Localized: 'Prophet: Nos vemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034724
    m_Localized: 'Prophet: Gracias. Pero no ayudó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034723
    m_Localized: 'Prophet: Qué lástima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034722
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034721
    m_Localized: 'Prophet: "Alguien canta entre los dos mundos: ven, fuego, camina conmigo."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034720
    m_Localized: 'Prophet: Ahora me iré. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034719
    m_Localized: 'Prophet: Vaya... Justo me acordé de algo. Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034718
    m_Localized: 'Prophet: Ah. Con que eso era.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034717
    m_Localized: 'Prophet: "Hemos estado viajando en un tren a ninguna parte por mucho tiempo. Pero bajo la pesada máquina, el camino sigue rugiendo."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034716
    m_Localized: ¿La página diez?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034715
    m_Localized: En medio de la página doscientos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034714
    m_Localized: Alguna página por el final
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034713
    m_Localized: 'Prophet: Tengo miedo. A lo mejor puedes ayudarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034712
    m_Localized: 'Prophet: ¿Recuerdas cuando me leíste la fortuna del libro? ¿Quieres hacerlo otra vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034711
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034710
    m_Localized: 'Prophet: ¿Será un mensaje para ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034709
    m_Localized: 'Prophet: Y recuerdo la palabra... "saltar". ¿Significará algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034708
    m_Localized: 'Prophet: Pero antes sí... creo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034707
    m_Localized: 'Prophet: Qué pregunta más extraña. Ya no entiendo nada de esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034706
    m_Localized: ¿La página diez?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034705
    m_Localized: En medio de la página doscientos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034704
    m_Localized: Alguna página por el final
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034703
    m_Localized: 'Prophet: Quizás ayude.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034702
    m_Localized: 'Prophet: Léeme mi fortuna otra vez, ¿podrías?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034701
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034700
    m_Localized: 'Prophet: Estoy perdido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034699
    m_Localized: 'Prophet: No sé si es un mensaje para mí... o para ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034698
    m_Localized: 'Prophet: Solo hay un pensamiento que se repite: Salta. Salta. Salta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034697
    m_Localized: 'Prophet: Yo... ya ni me acuerdo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034696
    m_Localized: ¿Te estás muriendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034695
    m_Localized: ¿De quién hablas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034694
    m_Localized: 'Prophet: ¿Cuál fue el punto entonces?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034693
    m_Localized: 'Prophet: ¿Y ahora qué? ¿Solo me va a arrebatar todo lo que me dio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034692
    m_Localized: 'Prophet: Ella me ayudó a seguir adelante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034691
    m_Localized: ¿Te estás muriendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034690
    m_Localized: ¿De quién hablas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034689
    m_Localized: 'Prophet: Oh, vaya. Tengo que... Solo déjame ser...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034688
    m_Localized: 'Prophet: Ahora me doy cuenta... es algo que debió pasar hace mucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840573
    m_Localized: 'Prophet: Las visiones... se han ido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840572
    m_Localized: 'Prophet: Es demasiado tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840571
    m_Localized: Te ves... mal
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840570
    m_Localized: Solo no te vayas a morir en la entrada
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840569
    m_Localized: 'Prophet: ¿Será que ella me abandonó?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840568
    m_Localized: 'Prophet: Mi visión se está desvaneciendo. Apenas puedo ver ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840567
    m_Localized: 'Prophet: He olvidado tu rostro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840566
    m_Localized: 'Prophet: Necesito estar a solas con mis pensamientos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840565
    m_Localized: 'Prophet: Cuando encuentres lo que hay ahí abajo... no saltes. Ahora no te servirá de nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840564
    m_Localized: 'Prophet: Y tú...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840563
    m_Localized: 'Prophet: Tenía que hacerse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840562
    m_Localized: 'Prophet: Me... me acuerdo... de que era lo correcto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840561
    m_Localized: 'Prophet: Necesito descansar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840560
    m_Localized: 'Prophet: Cuando llegues... no saltes. Todavía no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840559
    m_Localized: 'Prophet: Pero... me acordé de algo más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840558
    m_Localized: 'Prophet: Lo siento. No puedo pensar con claridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840557
    m_Localized: ¿Estás seguro?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840556
    m_Localized: ¿Por qué haría eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840555
    m_Localized: 'Prophet: Estás destinado a encontrarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840554
    m_Localized: 'Prophet: Tienes que cavar. Hay algo enterrado ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840553
    m_Localized: 'Prophet: Me... me acordé de lo que sigue. El sótano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840552
    m_Localized: 'Prophet: Ahora... todo está nublado. Te veo, perdido en un bosque oscuro, rodeado de bestias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840551
    m_Localized: 'Prophet: Pero sabía que había una razón. Lo recordaba con claridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840550
    m_Localized: 'Prophet: Lo siento. Sé que debo sonar extraño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840549
    m_Localized: ¿Estás seguro?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840548
    m_Localized: ¿Por qué haría eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840547
    m_Localized: 'Prophet: No consigo ver qué hay bajo esa tierra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840546
    m_Localized: 'Prophet: Intenta cavar ahí abajo. Encontrarás algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840545
    m_Localized: 'Prophet: El sótano. Tienes uno, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840544
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840543
    m_Localized: 'Prophet: Antes de venir aquí, veía todo claramente. Ahora... es como si hubiera una niebla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840542
    m_Localized: 'Prophet: Sí. Perdón si te asusté. Estoy pensando en voz alta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840541
    m_Localized: Me estoy arrepintiendo de haber confiado en ti
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840540
    m_Localized: Nunca entiendo nada de lo que dices
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840539
    m_Localized: 'Prophet: Pero ahora... algo anda mal. Quizás fue ese... ¿hombre de los hongos...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840538
    m_Localized: 'Prophet: Puede venir a ayudarte si se lo pides correctamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840537
    m_Localized: 'Prophet: Pero no le temas. Es solo que no sabemos lo suficiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840536
    m_Localized: 'Prophet: Sabes, hay una entidad más fuerte que nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840535
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840534
    m_Localized: 'Prophet: No. No, para nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840533
    m_Localized: Me estoy arrepintiendo de haber confiado en ti
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840532
    m_Localized: Nunca entiendo nada de lo que dices
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840531
    m_Localized: 'Prophet: Nuevos tallos brotarán de entre las cenizas y se elevarán hacia el cielo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840530
    m_Localized: 'Prophet: Esto ya pasó una vez, justo al principio. Todo saldrá bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840529
    m_Localized: 'Prophet: Probablemente no seas tú... ni ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840528
    m_Localized: 'Prophet: Me siento más débil. Mi visión no llega tan lejos como antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840527
    m_Localized: 'Prophet: Ya tengo toda la ayuda que necesito. Es que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840526
    m_Localized: ¿Estás hablando solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840525
    m_Localized: Oye. ¿Necesitas ayuda?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840524
    m_Localized: 'Prophet: ¿Será por la destrucción?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840523
    m_Localized: 'Prophet: Me siento peor. Qué extraño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840522
    m_Localized: 'Prophet: Estás ahí, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840521
    m_Localized: 'Prophet: Espero verte en unos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840520
    m_Localized: 'Prophet: Ahora esa sensación disminuyó. Creo que estamos haciendo lo correcto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840519
    m_Localized: 'Prophet: La primera vez que vine aquí sentí algo... extraño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840518
    m_Localized: 'Prophet: Sería mejor que no examinaras a nadie. Durante dos días seguidos. Las pruebas abren paso a la perdición.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840517
    m_Localized: 'Prophet: Puedes tomarlo como una petición, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840516
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840515
    m_Localized: 'Prophet: No puedo decir más. Ya hablé de más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840514
    m_Localized: 'Prophet: Espero verte en unos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840513
    m_Localized: 'Prophet: Tal vez te traiga paz. O al menos te ayude a seguir adelante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840512
    m_Localized: 'Prophet: Si puedes con eso, seguiré guiándote.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840511
    m_Localized: 'Prophet: Abstente de hacerlo hasta que el tercer amanecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840510
    m_Localized: 'Prophet: Pero... no deberías examinar a nadie durante dos días. Los exámenes solo atraen al mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840509
    m_Localized: 'Prophet: Nada. Ya dije demasiado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840508
    m_Localized: ¿Qué va a pasar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840507
    m_Localized: ¿Y qué se supone que haga con esa información?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840506
    m_Localized: "Prophet: \nMe pregunto si lo dirán en la radio. ¿Vas a estar pendiente?"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840505
    m_Localized: 'Prophet: No podrás detenerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840504
    m_Localized: 'Prophet: Aun así, hay algo que veo con claridad y es que algo malo se avecina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840503
    m_Localized: 'Prophet: Gracias a esa entidad puedo ver más allá que cualquiera. Pero ni siquiera yo lo veo todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840502
    m_Localized: 'Prophet: Eso te acercará a... una entidad muy poderosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840501
    m_Localized: ¿Qué va a pasar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840500
    m_Localized: ¿Y... qué se supone que haga con esa información?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840499
    m_Localized: "Prophet: \nMe pregunto si lo dirán en la radio. ¿Vas a estar pendiente?"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840498
    m_Localized: 'Prophet: Tú no eres la causa, pero te afectará de todas formas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840497
    m_Localized: 'Prophet: Y sé que algo terrible se avecina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840496
    m_Localized: 'Prophet: No lo sé todo. Pero en tu caso... sé lo que pasará si sigues este camino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840495
    m_Localized: 'Prophet: Veo más allá que la mayoría. Es un don que me concedieron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840494
    m_Localized: ¿Por qué me pediste que dejara entrar a alguien con un gato?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840493
    m_Localized: ¿Cómo supiste del gato?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840492
    m_Localized: 'Prophet: Lo que hagas con quien lo trajo, ya es cosa tuya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840491
    m_Localized: 'Prophet: Perfecto. El gato está contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840490
    m_Localized: 'Gasmask: Y luego nos iremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840489
    m_Localized: 'Gasmask: Así que, nos vamos a llevar a dos personas, AHORA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840488
    m_Localized: 'Gasmask: Usted se quedará atrás y morirá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840487
    m_Localized: 'Gasmask: Y nos llevaremos a todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840486
    m_Localized: 'Gasmask: Derribaremos la puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840485
    m_Localized: 'Gasmask: Es como hablar con una pared.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840484
    m_Localized: 'Gasmask: Está bien, cuídese.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840483
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840482
    m_Localized: 'Gasmask: Lo mismo digo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840481
    m_Localized: No voy a entregar a nadie más
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840480
    m_Localized: Bien. Espero no volver a verte nunca más
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840479
    m_Localized: 'Gasmask: También lidiaremos con usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840478
    m_Localized: 'Gasmask: Usted no es el primero en resistirse. Ya hemos lidiado con los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840477
    m_Localized: 'Gasmask: O derribamos la puerta y desalojamos su maldito cuchitril por completo, o nos da a dos personas ya mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840476
    m_Localized: 'Gasmask: No voy a discutir con usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840475
    m_Localized: 'Gasmask: No tengo palabras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840474
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840473
    m_Localized: No voy a entregar a nadie más
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840472
    m_Localized: Bien. Espero no volver a verte nunca más
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840471
    m_Localized: 'Gasmask: Y luego, o encontramos una forma de luchar contra los Visitantes, o no nos volveremos a ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840470
    m_Localized: 'Gasmask: No nos llevaremos a todos. Solo a dos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840469
    m_Localized: 'Gasmask: Dos personas más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840468
    m_Localized: ¿Para qué carajos están, si nada funciona?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840467
    m_Localized: ¿Qué se necesita para arreglar esto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840466
    m_Localized: 'Gasmask: Si no encontramos la forma de sobrevivir, alguien más decidirá por nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840465
    m_Localized: 'Gasmask: Los planes que nos dan son imposibles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840464
    m_Localized: 'Gasmask: Las autoridades están preparadas para volar toda la ciudad. No pueden contenerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840463
    m_Localized: 'Gasmask: Es un maldito desastre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840462
    m_Localized: ¿Para qué carajos están, si nada funciona?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840461
    m_Localized: ¿Qué se necesita para arreglar esto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840460
    m_Localized: 'Gasmask: Siga con sus jueguitos y nos llevaremos a todos en esta casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840459
    m_Localized: 'Gasmask: EL MUNDO SE ESTÁ ACABANDO.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840458
    m_Localized: 'Gasmask: DÉJESE DE ESTUPIDECES.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840457
    m_Localized: ¿Qué catástrofe?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840456
    m_Localized: ¿Dónde. Está. Mi. Gente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840455
    m_Localized: 'Gasmask: De lo contrario, habrá una catástrofe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840454
    m_Localized: 'Gasmask: Necesitamos más gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840453
    m_Localized: 'Gasmask: Los tendrá de vuelta pronto. Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840452
    m_Localized: 'Gasmask: Solo. Denos. A. La. Gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840451
    m_Localized: 'Gasmask: Nos preocupamos por esta ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840450
    m_Localized: 'Gasmask: Resístase y será peor para usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840449
    m_Localized: 'Gasmask: Eso es lo que pasa cuando los idiotas tercos se meten en nuestro camino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840448
    m_Localized: 'Gasmask: ¿Le gusta lo que ve detrás de mí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840447
    m_Localized: 'Gasmask: Está bien, que así sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840446
    m_Localized: 'Gasmask: ... Por el amor de Dios.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840445
    m_Localized: 'Gasmask: Y nos ocuparemos de los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840444
    m_Localized: 'Gasmask: Nos llevaremos a dos ahora, pero los traeremos de vuelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840443
    m_Localized: 'Gasmask: Gracias por su comprensión.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840442
    m_Localized: 'Gasmask: Sí, ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840441
    m_Localized: No. Ya me cansé
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840440
    m_Localized: Está bien. Si eso ayuda...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840439
    m_Localized: 'Gasmask: Las cosas se estabilizarán pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840438
    m_Localized: 'Gasmask: No importa quiénes sean. Solo entréguenos a dos de sus inquilinos. Ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840437
    m_Localized: 'Gasmask: Pero esta vez nos llevamos a dos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840436
    m_Localized: 'Gasmask: Sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840435
    m_Localized: No. Ya me cansé
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840434
    m_Localized: Está bien. Si eso ayuda...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840433
    m_Localized: 'Gasmask: Acelerará el proceso. Es lo mejor para todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840432
    m_Localized: 'Gasmask: Dos, para ser precisos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840431
    m_Localized: 'Gasmask: Necesitamos gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840430
    m_Localized: ¿Tengo que entregar a alguien otra vez?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840429
    m_Localized: ¿Entonces qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840428
    m_Localized: 'Gasmask: Tenemos la situación bajo control.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840427
    m_Localized: 'Gasmask: Solo déjenos hacer nuestro trabajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840426
    m_Localized: 'Gasmask: Si fuera así de simple, no habría necesidad de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840425
    m_Localized: ¿Tengo que entregar a alguien otra vez?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840424
    m_Localized: ¿Entonces qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840423
    m_Localized: 'Gasmask: Si coopera más, tal vez esto acabe pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840422
    m_Localized: 'Gasmask: Es difícil saberlo. Necesitamos más gente para mantener las cosas bajo control.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840421
    m_Localized: 'Gasmask: Todavía lo estamos estudiando. Manténgase al margen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840420
    m_Localized: ¿Cuándo se desharán de los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840419
    m_Localized: ¿Por cuánto tiempo continuará esto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840418
    m_Localized: 'Gasmask: Y ese... ese solía ser mi hogar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840417
    m_Localized: 'Gasmask: Y vea a dónde nos llevó eso. Tuvimos que eliminar un foco de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840416
    m_Localized: 'Gasmask: No ha hecho más que tratar de estorbarnos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840415
    m_Localized: 'Gasmask: No está en posición de exigir nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840414
    m_Localized: ¿Cuándo se desharán de los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840413
    m_Localized: ¿Por cuánto tiempo continuará esto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840412
    m_Localized: 'Gasmask: Y eso resulta en más violencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840411
    m_Localized: 'Gasmask: Esconder a los Visitantes solo hace que se multipliquen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840410
    m_Localized: 'Gasmask: Si se niega, habrán más explosiones.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840409
    m_Localized: 'Gasmask: Repercusiones.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840408
    m_Localized: ¡Regrese a los que se llevó!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840407
    m_Localized: ¿Qué está pasando en la ciudad?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840406
    m_Localized: 'Gasmask: Cuanto antes, mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840405
    m_Localized: 'Gasmask: Necesitamos que nos dé más gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840404
    m_Localized: 'Gasmask: Hola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840403
    m_Localized: 'Gasmask: Esto se hará como tenga que hacerse. Mientras más rápido coopere, más rápido terminaremos con esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840402
    m_Localized: 'Gasmask: No tiene otra opción.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840401
    m_Localized: 'Gasmask: Veo que no me está entendiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840400
    m_Localized: 'Gasmask: Una vez que terminen las pruebas, le diremos qué hacer después.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840399
    m_Localized: 'Gasmask: No se preocupe. Los procedimientos son exigentes, sí, pero permitimos horas de descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840398
    m_Localized: No me interesan esas pruebas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840397
    m_Localized: Está bien. Si es la única opción
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840396
    m_Localized: 'Gasmask: Para estudiar los efectos del Sol más a fondo, necesitaremos a otro inquilino de su casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840395
    m_Localized: 'Gasmask: No hay resultados definitivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840394
    m_Localized: No me interesan esas pruebas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840393
    m_Localized: Está bien. Si es la única opción
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840392
    m_Localized: 'Gasmask: Después de eso, serán enviados de vuelta desde la zona de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840391
    m_Localized: 'Gasmask: Tras las pruebas, la cuarentena es obligatoria. Su inquilino se quedará con nosotros un tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840390
    m_Localized: 'Gasmask: Ah. Conque nuestro equipo ya pasó por aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840389
    m_Localized: 'Gasmask: ¿Regresar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840388
    m_Localized: ¿Qué pasó con la última inspección?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840387
    m_Localized: ¿Cuándo regresarán a la persona que se llevaron?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840386
    m_Localized: 'Gasmask: No se preocupe. No tardaremos mucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840385
    m_Localized: 'Gasmask: Soy de la AFAE. Estamos haciendo una inspección de rutina en su vecindario.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840384
    m_Localized: 'Gasmask: Buenas noches.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646208
    m_Localized: 'Luka: Cuídate mucho, ¿sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646207
    m_Localized: 'Luka: Y a partir de ahí... las cosas pueden ponerse muy feas, muy rápido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646206
    m_Localized: 'Luka: Si te enfocas demasiado en eso, te va a consumir vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646205
    m_Localized: 'Luka: No te hundas en tu dolor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646204
    m_Localized: 'Luka: A lo mejor así... la muerte no es lo único en lo que piensas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646203
    m_Localized: 'Luka: Ojalá recuerdes cómo se sentía la alegría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646202
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646201
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646200
    m_Localized: 'Luka: ¿Me entiendes? La vida se ha vuelto amarga últimamente. Demasiado amarga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646199
    m_Localized: 'Luka: Cuando su objetivo no era solo sobrevivir, sino crear algo... bello.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646198
    m_Localized: 'Luka: Pero a veces, si les recuerdas que antes eran felices...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646197
    m_Localized: 'Luka: ¿Por qué llamarlo mentira? Las personas están hundidas en su dolor y lo entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646196
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646195
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646194
    m_Localized: 'Luka: Ahora más que nunca, no podemos dejar que la oscuridad nos consuma por completo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646193
    m_Localized: 'Luka: Intenta recordar qué te hacía feliz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646192
    m_Localized: 'Luka: ¿Qué es lo que te gustaba, antes de todo esto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646191
    m_Localized: 'Luka: Hay muchas razones. Pero no puedo decirte qué es lo que te haría feliz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646190
    m_Localized: ¿Estás dispuesto a mentirle a la gente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646189
    m_Localized: ¿Qué hay de qué alegrarse?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646188
    m_Localized: 'Luka: La desesperación nos impide ver las pequeñas cosas buenas que aún quedan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646187
    m_Localized: 'Luka: El miedo hizo que la gente olvidara cómo se siente la alegría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646186
    m_Localized: 'Luka: Sí... Hace tiempo que yo tampoco veo a nadie sonreír.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646185
    m_Localized: 'Luka: Oh, ¿hablas de la sonrisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646184
    m_Localized: 'Luka: ¿Qué tiene de malo? A mí me parece que está bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646183
    m_Localized: ¿Estás dispuesto a mentirle a la gente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646182
    m_Localized: ¿Qué hay de qué alegrarse?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646181
    m_Localized: 'Luka: Si nos repetimos que todo va a estar bien, quizá sea un poco más fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646180
    m_Localized: 'Luka: La próxima generación. El arte. O sea... la vida en sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646179
    m_Localized: 'Luka: Sí, son tiempos difíciles. Pero todavía hay mucho por lo que vale la pena luchar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646178
    m_Localized: 'Luka: Ya hay suficiente ira por ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646177
    m_Localized: ¿Por qué tienes esa cara?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646176
    m_Localized: ¿Por qué estás tan alegre?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646175
    m_Localized: 'Luka: ¿Te importa si me quedo a dormir aquí esta noche?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646174
    m_Localized: 'Luka: ¡Ey, ey! Ya estás ahí en la puerta. ¡Escuché tus pasos!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646173
    m_Localized: 'BigLebowski: Vete a la mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646172
    m_Localized: 'BigLebowski: Apuesto que eres de esos pervertidos de todas formas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646171
    m_Localized: 'BigLebowski: Como sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646170
    m_Localized: 'BigLebowski: Aunque... como sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646169
    m_Localized: 'BigLebowski: Ah, hasta tienes una alfombra. Qué bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646168
    m_Localized: 'BigLebowski: ¡No puede ser! Wow...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646167
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646166
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633025
    m_Localized: 'BigLebowski: ¿De verdad vas a dejar a una niña aquí afuera? ¿Con este sol quemando? ¿Con los Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633024
    m_Localized: 'BigLebowski: Como sea. Estoy aquí, ¿o no? Y no me vendría mal un techo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646165
    m_Localized: 'BigLebowski: A mi mamá le encanta tomar el sol. Así que, sí... esa es otra posibilidad divertida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646164
    m_Localized: 'BigLebowski: O capaz ya son Visitantes. Les sentaría bien, la verdad. Ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646163
    m_Localized: 'BigLebowski: Qué sé yo. En casa, supongo. ¿Dónde más iban a estar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646162
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646161
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646160
    m_Localized: 'BigLebowski: ¡Intenta algo perverso conmigo y te rompo la cara a golpes!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646159
    m_Localized: 'BigLebowski: A veces te encuentras con unos completos imbéciles. Ugh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646158
    m_Localized: 'BigLebowski: Pero ando sin plata. Así que tengo que hacer tratos con gente o esconderme en sótanos que estén libres. Como sea, así es la vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646157
    m_Localized: 'BigLebowski: Estoy... viajando, creo. Quiero ver el mundo. Distintos lugares. Tal vez encuentre un hogar nuevo en alguna parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646156
    m_Localized: ¿Dónde están tus padres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646155
    m_Localized: ¿Y qué haces escondida en sótanos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646152
    m_Localized: 'BigLebowski: No pude encontrar un sótano ni otro escondite decente, así que aquí estoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646151
    m_Localized: 'BigLebowski: Esto es algo raro, peeeeero... ¿me dejas pasar? ¿O me vas a dejar aquí afuera?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646150
    m_Localized: ¿Dónde están tus padres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646149
    m_Localized: ¿Y qué haces escondida en sótanos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646146
    m_Localized: 'BigLebowski: Estoy harta de esconderme en los sótanos. Si sigo así, se me va a olvidar cómo hablar con la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646145
    m_Localized: 'BigLebowski: Nah, solo... necesito un lugar donde pueda quedarme un rato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646144
    m_Localized: Sí, es mi casa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646143
    m_Localized: ¿Estás buscando a alguien?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646142
    m_Localized: 'BigLebowski: ¿Es esto, como, donde vives? O sea... ¿su casa, señor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646141
    m_Localized: 'BigLebowski: Hola. Umm... buenas, supongo, si eso te gusta más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646140
    m_Localized: 'Couple: Anda, usa las piernas. Yo también estoy cansado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646139
    m_Localized: 'Couple: Vamos a seguir buscando, ¿verdad, mi vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582080
    m_Localized: (Tomar pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582081
    m_Localized: (Tomar pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776384
    m_Localized: (Tomar pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776385
    m_Localized: (Tomar pedido)
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039764
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039763
    m_Localized: 'Nervous: Preferiría regresar al hotel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812094
    m_Localized: 'CultistPriest: Cuida de mi gente. Y recuerda, si uno de nosotros muere... tu casa será reducida a cenizas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646138
    m_Localized: 'Couple: Entiendo. Perdón por la molestia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646137
    m_Localized: 'Couple: Solo es algo tímida. Está bien, bebé. Ya vas a descansar y ser la misma de siempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646135
    m_Localized: 'Couple: Ah, gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646134
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646133
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646132
    m_Localized: 'Couple: Uy, perdón. No es asunto mío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646131
    m_Localized: 'Couple: Estoy agradecido por mi esposa. Sin ella, no habría podido con nada de esto. ¿Y cómo lo estás llevando TÚ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646130
    m_Localized: 'Couple: Que todo se junte así... ha sido difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646129
    m_Localized: 'Couple: O sea, entiendes, ¿no? Los Visitantes, el calor, que te despidan...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646128
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646127
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646126
    m_Localized: 'Couple: Ay, discúlpame. No debería insistirte tanto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646125
    m_Localized: 'Couple: ¿Cierto, mi amor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646124
    m_Localized: 'Couple: Pero a lo mejor podemos hablar otro día. Si nos volvemos a ver, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646123
    m_Localized: 'Couple: Solo está muy cansada. Lo siento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646122
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646121
    m_Localized: 'Couple: ¡Claro que sí! Cariño, ¿quieres hablar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646120
    m_Localized: ¿De qué están cansados?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646119
    m_Localized: ¿Su esposa no habla por sí sola?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646118
    m_Localized: 'Couple: Si... si no le molesta, digo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646117
    m_Localized: 'Couple: Mi esposa está agotada. Solo necesita descansar un poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646116
    m_Localized: 'Couple: Bueno... creo que solo nos iremos a buscar en otra parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646115
    m_Localized: ¿De qué están cansados?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646114
    m_Localized: ¿Su esposa no habla por sí sola?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646113
    m_Localized: 'Couple: Una casa grande, algo alejada, sin vecinos chismosos... Hay menos probabilidades de que aparezca algún loco, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646112
    m_Localized: 'Couple: No sé cómo explicarlo, jaja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646111
    m_Localized: 'Couple: La verdad, esta casa parece más segura que cualquier otra que hayamos visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646110
    m_Localized: ¿Y si USTEDES son los problemáticos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646109
    m_Localized: ¿Mi casa les parece un refugio seguro?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646108
    m_Localized: 'Couple: ¿Le molestaría si nos quedamos aquí un rato? Solo si no es mucha molestia, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646107
    m_Localized: 'Couple: ¡Hola! ¡Mi esposa y yo andamos buscando un lugar seguro para refugiarnos de la tormenta!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646106
    m_Localized: 'Couple: ... Ay, así, mucho mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646105
    m_Localized: 'Ballerina: Un regalito. De mi parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646104
    m_Localized: 'Ballerina: Encontrarás al gatito debajo de la casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646103
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646102
    m_Localized: 'Ballerina: Vente, gatito. ¡Ahora tienes un lugar para jugar y andar por ahí!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646101
    m_Localized: 'Ballerina: Me voy a poner cómoda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646100
    m_Localized: Ya vete al diablo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646099
    m_Localized: Está bien... Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646098
    m_Localized: 'Ballerina: Piénsalo otra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646097
    m_Localized: 'Ballerina: ¿Ya viste al gatito?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646096
    m_Localized: 'Ballerina: No tortures al gatito. Odia el frío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646095
    m_Localized: 'Ballerina: Esta señorita se va a morir de frío aquí, jovencito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646094
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646093
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646092
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646091
    m_Localized: 'Ballerina: ¿Vas a abrir o no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646090
    m_Localized: 'Ballerina: ¿Pasé la prueba?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646089
    m_Localized: 'Ballerina: ¿Eso no es suficiente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646088
    m_Localized: 'Ballerina: Tengo dos brazos, dos piernas y una cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646087
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646086
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646085
    m_Localized: 'Ballerina: ¿Y bien? Decide de una vez. ¿Qué hacemos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646084
    m_Localized: 'Ballerina: Soy una bai-llet-rina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646083
    m_Localized: 'Ballerina: Quizá lo haga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646082
    m_Localized: 'Ballerina: ¿Quieres que baile?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646081
    m_Localized: 'Ballerina: ¿Y eso qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646080
    m_Localized: Prueba que eres una persona.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451995
    m_Localized: No creo que seas humana.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451994
    m_Localized: 'Ballerina: Qué raro lo que dices.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451993
    m_Localized: 'Ballerina: ¿Y ahora qué? ¿Te acordaste de él? ¿O qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451992
    m_Localized: 'Ballerina: Claro... sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451991
    m_Localized: Prueba que eres una persona.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451990
    m_Localized: No creo que seas humana.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451989
    m_Localized: 'Ballerina: Jeje'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451988
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451987
    m_Localized: 'Ballerina: No sé. ¿Por qué importa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451986
    m_Localized: Me recuerdas a... alguien.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451985
    m_Localized: ¿Alguien te envió aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451984
    m_Localized: 'Ballerina: Aquí no hace calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451983
    m_Localized: 'Ballerina: Vi tu casa, así que vine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451982
    m_Localized: 'Ballerina: ¿Ves esa ciudad? Ahí vivía yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451981
    m_Localized: Me recuerdas a... alguien.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451980
    m_Localized: ¿Alguien te envió aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451979
    m_Localized: 'Ballerina: Ballet. ¿Se nota?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451978
    m_Localized: 'Ballerina: Yo bailo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451977
    m_Localized: ¿Cómo encontraste mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451976
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451975
    m_Localized: 'Ballerina: Me dijeron que viniera, así que vine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451974
    m_Localized: 'Ballerina: ¿Vas a abrir, sí o no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451973
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451972
    m_Localized: 'Ballerina: Una caja de cervezas. Un cajón. Una pata de jamón. No sé. Soy cualquier cosa, jaja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451971
    m_Localized: ¿Cómo encontraste mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451970
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451969
    m_Localized: 'Ballerina: ¿Cómo ayuda eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451968
    m_Localized: 'Ballerina: Pero cuántas preguntas. Sí, lo conozco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451967
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451966
    m_Localized: ¿Qué quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451965
    m_Localized: ¿Conoces... al hombre calvo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451964
    m_Localized: 'Ballerina: ¿Me abres o qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451963
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451962
    m_Localized: 'Ballerina: Holis'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451961
    m_Localized: 'Teacher: Si alguna vez te encuentras con un niño que necesite ayuda... prométeme que lo cuidarás. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451960
    m_Localized: 'Teacher: No te culpo. Pero, por favor... prométeme algo antes de que me vaya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451959
    m_Localized: 'Teacher: Pero gracias... por escucharme. Y por dejarme entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451958
    m_Localized: 'Teacher: Sé que es imposible traerlos de vuelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451957
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451956
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451955
    m_Localized: 'Teacher: Lo quemaron todo. Y me obligaron a mirar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451954
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451953
    m_Localized: 'Teacher: ¿Qué hicieron para merecer tal cosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451952
    m_Localized: 'Teacher: ¿Qué somos ahora? ¿Una multitud juzgando a niños indefensos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451951
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451950
    m_Localized: 'Teacher: Descubrieron que estaba protegiendo a niños con señales de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451949
    m_Localized: 'Teacher: Por culpa de... por culpa de las personas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451948
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451947
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451946
    m_Localized: 'Teacher: Todavía siento sus ojitos asustados mirándome...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451945
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451944
    m_Localized: 'Teacher: Me obligaron a mirar... mientras cerraban las puertas, clavaban las ventanas... y le prendían fuego al edificio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451943
    m_Localized: 'Teacher: Fue la misma gente. Les aterraba que los niños pudieran ser Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451942
    m_Localized: 'Teacher: Todos murieron... en las llamas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451941
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451940
    m_Localized: 'Teacher: Ellos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451939
    m_Localized: ¿Por qué se produjo el incendio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451938
    m_Localized: ¿Qué les pasó a los niños?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451937
    m_Localized: 'Teacher: Pero ahora... ya no están. Ni uno solo sobrevivió al incendio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451936
    m_Localized: 'Teacher: Otros abandonaron a sus propios hijos en el momento que vieron una señal de Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451935
    m_Localized: 'Teacher: La AFAE se llevó a algunos. A otros los asesinaron. Otros...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451934
    m_Localized: 'Teacher: Perdieron a sus padres por todo tipo de razones.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451933
    m_Localized: 'Teacher: Es que... Cuando el mundo empezó a derrumbarse, acogí a los chiquitines que habían quedado atrás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451932
    m_Localized: 'Teacher: Yo era maestra... en la guardería.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451931
    m_Localized: ¿Por qué se produjo el incendio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451930
    m_Localized: ¿Qué les pasó a los niños?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451929
    m_Localized: 'Teacher: Pero... no pude salvarlos. Les fallé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451928
    m_Localized: 'Teacher: Solo necesitaban a alguien que se preocupara. Alguien que los amara. Hice lo que pude...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451927
    m_Localized: 'Teacher: Nos quedábamos en el viejo edificio de la guardería.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451926
    m_Localized: 'Teacher: Acogí a todo niño que llamaran "contaminado", a los niños que temían que fueran Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451925
    m_Localized: 'Teacher: Yo... solo quería darles un poco de esperanza a los niños abandonados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451924
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451923
    m_Localized: ¿Qué pasó?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451922
    m_Localized: 'Teacher: Es que me siento horrible. ¿Será que podría... hablar con usted?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451921
    m_Localized: 'Teacher: Siento molestarle, pero... ¿tendrás un momento?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451920
    m_Localized: 'Dude: Cuídate... y cuida de tu familia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451919
    m_Localized: 'Dude: Tranquilo, bro. Lo entiendo. No pasa nada. Te perdono.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451918
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451917
    m_Localized: 'Dude: Aguafiestas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451916
    m_Localized: 'Dude: Algún día tienen que hacer una película de esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451915
    m_Localized: 'Dude: Bro, esto podría ser lo más cool que me ha pasado que si en toda la vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451914
    m_Localized: 'Dude: ¡Ey, brooooo, te lo agradezco!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451913
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451912
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451911
    m_Localized: 'Dude: Siempre soñé con salir en una peli algún día...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451910
    m_Localized: 'Dude: Son mucho más divertidas que los libros, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451909
    m_Localized: 'Dude: Lo tienen TODO. Emociones. Drama. Traiciones. ¡Intriga!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451908
    m_Localized: 'Dude: Pero las películas, bro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451907
    m_Localized: 'Dude: ¿Y con todo lo que hay en las noticias? Las vibras están bien bajas, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451906
    m_Localized: 'Dude: La gente está hablando mal de los demás y todo este ambiente de pesimismo es deprimente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451905
    m_Localized: 'Dude: Nah, bro, afuera es un caos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451904
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451903
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451902
    m_Localized: 'Dude: Bueno, chill, no voy a presionar. Pero, porfa, bro, déjame entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451901
    m_Localized: 'Dude: Sería una locura. Un pana mío leyó un libro donde eso pasaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451900
    m_Localized: 'Dude: Imagina si conquistamos el espacio y nos da por enviar cartas a los alienígenas... ¡Guaaaauuuu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451899
    m_Localized: 'Dude: Tipo, predicen cosas de tecnología y eventos antes de que pasen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451898
    m_Localized: 'Dude: ¿Te has fijado en cómo los escritores de ciencia ficción siempre le atinan al futuro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451897
    m_Localized: 'Dude: Nah, brooooo, no estoy diciendo tonterías. Sé EXÁCTAMENTE de lo que hablo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451896
    m_Localized: ¿Tienes idea de lo que está pasando allá afuera?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451895
    m_Localized: ¿De qué demonios estás hablando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451894
    m_Localized: 'Dude: Y comida, bro. Muuuuuucha comida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451893
    m_Localized: 'Dude: Oye, bro, ¿tienes una escopeta o algo así? Necesitaremos armas de las potentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451892
    m_Localized: 'Dude: Créeme bro, eso cambiaría POR COMPLETO el plan de acción.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451891
    m_Localized: 'Dude: ¿Es un virus o son muertos vivientes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451890
    m_Localized: 'Dude: Solo dime, ¿son zombis rápidos o lentos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451889
    m_Localized: 'Dude: He visto tantas películas de esto que soy básicamente un gurú de la supervivencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451888
    m_Localized: 'Dude: Bro, tipo, cuenta conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451887
    m_Localized: 'Dude: ¡ZOMBIS! ¡JA! ¡LO SABÍA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451886
    m_Localized: ¿Tienes idea de lo que está pasando allá afuera?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451885
    m_Localized: ¿De qué demonios estás hablando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451884
    m_Localized: 'Dude: ¡Ah, ah! Y más vale que el equipo sea de cuatro personas. Es, como, el número de oro de la supervivencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451883
    m_Localized: 'Dude: Tipo, ¡bum! ¡Mandamos un cohete en una misión para detener la bola de fuego! ¡Brooo, sería increíble!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451882
    m_Localized: 'Dude: Bro, ¿vamos a mandar un equipo de héroes astronautas super rudos al Sol, o qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451881
    m_Localized: 'Dude: Bro, ¡yo vi esta película!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451880
    m_Localized: 'Dude: ¡No inventes!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451879
    m_Localized: Unas criaturas que parecen humanos empezaron a salir de la tierra
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451878
    m_Localized: El sol está quemando a la gente viva durante el día
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451877
    m_Localized: 'Dude: Sé sincero, bro, ¿de qué me perdí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451876
    m_Localized: 'Dude: A la mieeerda, brooo, ¿qué diablos está pasando ahí afuera? ¿Qué es toda esta locura?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451875
    m_Localized: 'Dude: ¡Epa, bro! ¿qué tal?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451874
    m_Localized: 'Blind: O ESO vendrá por ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451873
    m_Localized: 'Blind: Por lo que más quieras, NO te acerques a los cuerpos quemados en la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451872
    m_Localized: 'Blind: Me iré, pero debo advertirte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451871
    m_Localized: 'Blind: Maldita sea... es duro estar sin ojos. ¿Podré dormir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451870
    m_Localized: 'Blind: Gracias... Por fin puedo descansar un poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451869
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451868
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451867
    m_Localized: 'Blind: Esa cosa nunca debió existir... ESO NUNCA DEBIÓ EXISTIR.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451866
    m_Localized: 'Blind: Más grande. Más fuerte. No... No se puede nombrar. ESO sigue el olor a quemado y recoge lo que hemos sembrado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451865
    m_Localized: 'Blind: Oh, no... no, no. Hay algo mucho peor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451864
    m_Localized: 'Blind: ¿En serio crees que me arranqué los ojos de las cuencas por un hombre pálido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451863
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451862
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451861
    m_Localized: 'Blind: Dios... no le desearía ver eso ni a mi peor enemigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451860
    m_Localized: 'Blind: Digiriendo lentamente esos cuerpos negros como el carbón y... ¡Y TUVE QUE VERLO TODO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451859
    m_Localized: 'Blind: ESO... ni siquiera se fijó en mí al principio. Estaba demasiado ocupado devorando carne...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451858
    m_Localized: 'Blind: Solo estaba en el lugar equivocado... en el momento equivocado...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451857
    m_Localized: 'Blind: Para ESO, nuestro sufrimiento es un festín. ¡Un festín de dolor! Se alimenta del miedo, el dolor... ¡de nuestras mentes!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451856
    m_Localized: 'Blind: Es mejor que no sepas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451855
    m_Localized: ¿Hablas del hombre pálido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451854
    m_Localized: ¿Qué fue lo que viste?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451853
    m_Localized: 'Blind: Creí que si me los quitaba, podría borrar esa imagen monstruosa. Ahora no veo nada más que una oscuridad infinita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451852
    m_Localized: 'Blind: Para evitar volverme loco, tuve que sacrificar mis ojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451851
    m_Localized: 'Blind: Yo... Yo me hice esto a mí mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451850
    m_Localized: ¿Hablas del hombre pálido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451849
    m_Localized: ¿Qué fue lo que viste?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451848
    m_Localized: 'Blind: Créeme... si hubieras visto ESO, habrías hecho lo mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451847
    m_Localized: 'Blind: No hay palabras para describir el horror primitivo que me desgarró el alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451846
    m_Localized: 'Blind: La imagen de lo que vi... sigue frente a mí. Incrustada en esta oscuridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451845
    m_Localized: 'Blind: Vi algo indescriptible. No me atrevo a describirlo... ¿quién se atreve a pensar en lo que la mente engendra al quebrarse?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451844
    m_Localized: ¿Quién te hizo eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451843
    m_Localized: ¿Qué te pasó en los ojos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451842
    m_Localized: 'Blind: Por fin... parece que llegué a un refugio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451841
    m_Localized: 'Fatman: ¿A dónde carajo se supone que me vaya? Estoy... ¡estoy jodido!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451840
    m_Localized: 'Fatman: ¡Dios Santo! ¡¿No ves que no me siento bien?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451839
    m_Localized: 'Fatman: Te lo pagaré, cuando todo este desastre termine. Ya verás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451838
    m_Localized: 'Fatman: ¡Espléndido! No te vas a arrepentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451837
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451836
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451835
    m_Localized: 'Fatman: Si me dejas pasar ahora, cuando todo esto termine... te lo compensaré con creces.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451834
    m_Localized: 'Fatman: Anda, amigo... Yo, eh, haré que valga la pena para ti...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451833
    m_Localized: 'Fatman: Eres un insolente por rechazar a un hombre tan importante como yo. ¡Yo era el que ponía orden en esta mierda! ¡Antes era un ministro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451832
    m_Localized: 'Fatman: Casi me muero arrastrándome hasta aquí, ¿y para qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451831
    m_Localized: 'Fatman: Hablo en serio. Me... me siento mal. Necesito agua fría, ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451830
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451829
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451828
    m_Localized: 'Fatman: Si no, me voy a desmayar y cuando salga el sol me voy a morir rostizado frente a tu puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451827
    m_Localized: 'Fatman: Mira, abre la puerta. Necesito esa bañera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451826
    m_Localized: 'Fatman: Y... hablando de eso... ¿Será que tienes helado? ¿No? Ah, maldita sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451825
    m_Localized: 'Fatman: Perfecto, así me gusta. Creí que me iba a derretir aquí, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451824
    m_Localized: ¿Para qué necesitas mi baño?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451823
    m_Localized: Sí. Tengo una de esas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451822
    m_Localized: 'Fatman: Solo necesito un baño frío. ¿Puedo darme una ducha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451821
    m_Localized: 'Fatman: Esto está más caliente que cualquier resort de lujo en el que me haya quedado. ¡Já!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451820
    m_Localized: 'Fatman: Siento que se me está quemando la piel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451819
    m_Localized: 'Fatman: No, no estoy nada bien. Mírame.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451818
    m_Localized: ¿Para qué necesitas mi baño?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451817
    m_Localized: Sí. Tengo uno
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451816
    m_Localized: 'Fatman: No puedo... respirar. ¿Tienes, umm... un baño?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451815
    m_Localized: 'Fatman: Claro, está un poquito más fresco... pero el aire se siente espeso como el demonio y... y... y...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451814
    m_Localized: 'Fatman: ¡Ufff! Todavía se siente como un horno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451813
    m_Localized: ¿Estás bien?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451812
    m_Localized: Es medianoche
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451811
    m_Localized: 'Fatman: Uf... carajo... está hirviendo aquí afuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451810
    m_Localized: 'Buddy: Bueno, está bien, no te molestaré. Me voy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451809
    m_Localized: 'Buddy: Maldición, bro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451808
    m_Localized: 'Buddy: Me habría quedado completamente solo de no ser por ti'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451807
    m_Localized: 'Buddy: Gracias'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451806
    m_Localized: 'Buddy: Deberías irte'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451805
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451804
    m_Localized: 'Buddy: Bueno, ya en serio, bro. ¿Me dejas pasar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451803
    m_Localized: 'Buddy: ¿Y sin un traguito para pasar la miseria? Nah... Ver este mundo de frente sobrio es demasiado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451802
    m_Localized: 'Buddy: Je, je, tranquilo, solo te estoy vacilando otra vez. No me guardes rencor. En estos días, el humor es todo lo que nos queda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451801
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451800
    m_Localized: 'Buddy: Rico, saludable, e incluso cuenta como dieta si lo haces bien. ¡Solo mira este cuerpazo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451799
    m_Localized: 'Buddy: Desayuné como un rey esta mañana. Seguí el plan de dieta de mi amigo: cerveza para el desayuno, vino para la cena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451798
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451797
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451796
    m_Localized: 'Buddy: Entonces, bro... ¿me dejas pasar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451795
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451794
    m_Localized: 'Buddy: No te enojes si mis bromas te afectaron. Solo estoy tratando de no perder la cabeza. Espero que lo entiendas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451793
    m_Localized: 'Buddy: Las bromas, bro... te mantienen cuerdo cuando todo lo demás se va al carajo. Sin ellas, ya estaría perdido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451792
    m_Localized: 'Buddy: No soy perfecto, ¿sí? ¿Pero qué tiene de malo tener algo de humor cuando el mundo se está cayendo a pedazos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451791
    m_Localized: Suenas algo ebrio. ¿Estabas tomando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451790
    m_Localized: ¿Qué eres, un comediante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451789
    m_Localized: 'Buddy: Olvídalo'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451788
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451787
    m_Localized: 'Buddy: Yo no lastimaría a nadie por sus dientes, o sus ojos, o lo que sea que estén diciendo en la tele. Ni siquiera podría...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451786
    m_Localized: 'Buddy: Una característica rara no te hace un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451785
    m_Localized: 'Buddy: ¡Ándale! Es broma. No te me pongas tan serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451784
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451783
    m_Localized: 'Buddy: Claro, puede que me guste pegarle a la gente con dientes perfectos y ojos bonitos... pero solo porque me dan envidia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451782
    m_Localized: 'Buddy: Créeme, tengo un corazón enorme. Soy un amor de persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451781
    m_Localized: Suenas algo ebrio. ¿Estabas tomando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451780
    m_Localized: ¿Qué eres, un comediante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451779
    m_Localized: 'Buddy: O sea que soy libre de ir por unos tragos si se te antoja beber conmigo a cualquier hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451778
    m_Localized: 'Buddy: Ni tengo suegra, ni estoy casado. ¡Sin ataduras, bro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451777
    m_Localized: 'Buddy: Je, te la creíste, ¿a que no? Es broma, bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451776
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257716
    m_Localized: 'Buddy: Mi suegra me echó de su casa porque saqué a patadas un tipo de la AFAE. Ahora tiene miedo de que vuelvan y se la quieran llevar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257715
    m_Localized: 'Buddy: Ah, no es nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257714
    m_Localized: ¿Cómo sé que de verdad eres un "buen" tipo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257713
    m_Localized: ¿A ti qué te pasó?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257712
    m_Localized: 'Buddy: Epa, ¿qué pasó, bro? ¿Dejas entrar a un buen tipo como yo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257711
    m_Localized: 'Bestson: Adiós, señor desconocido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257710
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257709
    m_Localized: 'Bestson: Sí... sí, volverán. Eso creo. Eso espero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257708
    m_Localized: 'Bestson: Volveré a casa. Por si acaso regresan...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257707
    m_Localized: 'Bestson: Sí. Es probable que eso sea lo más seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257706
    m_Localized: 'Bestson: Pero... tal vez debería quedarme contigo por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257705
    m_Localized: 'Bestson: ¿Y si regresan y no estoy allí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257704
    m_Localized: 'Bestson: No sé si eso sea una buena idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257703
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257702
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257701
    m_Localized: 'Bestson: ¿Y ahora qué hago?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257700
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257699
    m_Localized: 'Bestson: Esto es... esto es una pesadilla...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257698
    m_Localized: 'Bestson: Dios, ¿y si se quemaron...? ¿Y si el Sol los achicharró?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257697
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257696
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257695
    m_Localized: 'Bestson: ¿Ahora qué debería hacer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257694
    m_Localized: 'Bestson: Ya no sé ni qué pensar. Capaz tú tampoco confías en mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257693
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257692
    m_Localized: 'Bestson: Mierda, ¿por qué se fueron? ¿Por qué no me llevaron?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257691
    m_Localized: 'Bestson: Oh, Dios. ¿Y si esos Visitantes los mataron...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257690
    m_Localized: El sol está explotando y la gente se está quemando viva
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257689
    m_Localized: Unas criaturas llamadas Visitantes salieron del suelo. No puedes confiar en nadie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257688
    m_Localized: 'Bestson: Creí que si hablaba con alguien, me dirían qué pasó. ¿Tú me puedes decir? ¿Por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257687
    m_Localized: 'Bestson: Unas horas después del anuncio, se fueron corriendo... y no regresaron. Ahora me da más miedo todavía prender el televisor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257686
    m_Localized: 'Bestson: No prendí la TV, no quería estresarme. Pero ellos nunca regresaron y aún no sé qué está pasando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257685
    m_Localized: 'Bestson: Un día, escucharon que algo terrible había pasado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257684
    m_Localized: 'Bestson: Pero mamá y papá siempre la veían.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257683
    m_Localized: 'Bestson: Y leí por ahí que las personas que no ven las noticias viven más tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257682
    m_Localized: 'Bestson: Ya ves, las noticias nunca dicen nada bueno. Me hacen sentir mal, por eso dejé de verlas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257681
    m_Localized: El sol está explotando y la gente se está quemando viva
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257680
    m_Localized: Unas criaturas llamadas Visitantes salieron del suelo. No puedes confiar en nadie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257679
    m_Localized: 'Bestson: Necesito saber la verdad. ¿Adónde se fueron? Dime, ¿qué está pasando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257678
    m_Localized: 'Bestson: Pero... ya pasó una semana entera. No han regresado. Sigo esperando, pero solo... desaparecieron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257677
    m_Localized: 'Bestson: Una mañana me desperté y estaban muy asustados. Dijeron que tenían que irse de inmediato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257676
    m_Localized: 'Bestson: No. No lo hago. Las noticias me dan pánico. Yo solo... trato de no ver. Pero mis papás...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257675
    m_Localized: ¿Acaso no ves la tele?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257674
    m_Localized: Espera, ¿en serio no sabes lo que está pasando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257673
    m_Localized: 'Bestson: Disparos, peleas... no entiendo nada...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257672
    m_Localized: 'Bestson: Con este calor casi no puedo respirar y las personas están actuando... raro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257671
    m_Localized: 'Bestson: ¿Puedes decirme qué está pasando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257670
    m_Localized: 'Fugitive: Como sea. Que tengas una maldita buena noche, imbécil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257669
    m_Localized: 'Fugitive: Escondiéndose en sus huecos y dejando a todos fuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257668
    m_Localized: 'Fugitive: Claro. Debí saberlo. Eres como los demás. Pequeñas ratas asustadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257667
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257666
    m_Localized: 'Fugitive: MALDITA SEA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257665
    m_Localized: 'Fugitive: Me alegro de que no seas como tus vecinos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257664
    m_Localized: 'Fugitive: Gracias. En serio. Te debo una.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257663
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257662
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257661
    m_Localized: 'Fugitive: Ahora soy un testigo... sé demasiado. Vendrán por mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257660
    m_Localized: 'Fugitive: Por eso corrí, aunque me pegaron un tiro escalando esa maldita cerca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257659
    m_Localized: 'Fugitive: Cuando vi esa mierda, supe que tenía que largarme de ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257658
    m_Localized: 'Fugitive: Le están haciendo cosas a la gente. Por eso nadie sale de esas zonas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257657
    m_Localized: 'Fugitive: Primero oí unos gritos ahogados... luego sacaron una bolsa negra... Y el tipo nunca volvió. ¿Sabes lo que significa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257656
    m_Localized: 'Fugitive: YO MISMO LO VI, ¡maldita sea! Se llevaron a un pobre diablo a una carpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257655
    m_Localized: 'Fugitive: ¡Esa mierda no es un rumor!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257654
    m_Localized: 'Fugitive: ¿Alguna vez escuchaste que la AFAE está haciendo pruebas para encontrar Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257653
    m_Localized: 'Fugitive: Oh, créeme que sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257652
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257651
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257650
    m_Localized: 'Fugitive: Me caí de la cerca directo en un charco y después corrí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257649
    m_Localized: 'Fugitive: Lo que pasa es que no tuve tanta suerte. Uno de esos cabrones volteó, me vio y comenzó a disparar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257648
    m_Localized: 'Fugitive: Están ocupados ahí dentro. Se nota... están preparando algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257647
    m_Localized: 'Fugitive: Ni siquiera necesité un plan, solo esperé el momento adecuado y salté la cerca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257646
    m_Localized: 'Fugitive: Y la seguridad que tienen es una maldita broma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257645
    m_Localized: 'Fugitive: Eso es una zona de cuarentena de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257644
    m_Localized: 'Fugitive: Un maldito contenedor de carga donde todas las mañanas meten a la gente como si fueran ganado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257643
    m_Localized: 'Fugitive: Imagina un terreno baldío, acordonado, con unas cuantas carpas regadas por ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257642
    m_Localized: ¿Entonces la AFAE te está buscando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257641
    m_Localized: Cuéntame sobre las zonas de cuarentena de la AFAE
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257640
    m_Localized: 'Fugitive: Les dije que se fueran al carajo. Así que me esposaron como a un criminal. Pero al final me escapé igual.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257639
    m_Localized: 'Fugitive: Lo siguiente que recuerdo es que garabateaban tonterías en sus tabletas y me decían que tenía que ir con ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257638
    m_Localized: 'Fugitive: Abrí la puerta y ya me estaban escaneando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257637
    m_Localized: 'Fugitive: Me escapé de una de sus zonas. Me atraparon cuando llegaron tocando la puerta durante una redada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257636
    m_Localized: ¿Entonces la AFAE te está buscando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257635
    m_Localized: Cuéntame sobre las zonas de cuarentena de la AFAE
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257634
    m_Localized: 'Fugitive: Al menos no se me salen las tripas... Aunque tampoco queda mucho que sacar... jeje... Argh... Duele como el demonio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257633
    m_Localized: 'Fugitive: Me atravesó, gracias a Dios. Pero mierda, estoy sangrando como un cerdo degollado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257632
    m_Localized: 'Fugitive: Tienen la puntería en el ano, esos idiotas. Pero una maldita bala... sí, una me dio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257631
    m_Localized: 'Fugitive: Esos malditos cerdos de la AFAE me atraparon... estaba escalando la cerca y salí corriendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257630
    m_Localized: ¿Qué pasó?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257629
    m_Localized: ¿Quién te hizo esto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257628
    m_Localized: 'Fugitive: Me dispararon. No voy a durar mucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257627
    m_Localized: 'Fugitive: A-ayúdame...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257626
    m_Localized: 'Nun: El Señor se acordará de esto. Él todo lo ve.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257625
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257624
    m_Localized: 'Nun: Mi muerte te pesará en el alma, graba mis palabras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257623
    m_Localized: 'Nun: Así que rechazas a una pobre anciana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257622
    m_Localized: 'Nun: ¿Con que así son las cosas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257621
    m_Localized: 'Nun: Bueno, muchísimas gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257620
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257619
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257618
    m_Localized: 'Nun: Pues, quédate tranquilo, que haré lo mejor que pueda para eliminar ese lenguaje obsceno de este lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257617
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257616
    m_Localized: 'Nun: ¿Te hago una simple pregunta sobre tu casa y me maldices?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257615
    m_Localized: 'Nun: ¿No le temes a Dios? ¿No tienes vergüenza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257614
    m_Localized: 'Nun: ¡A mí no me hables con esas groserías, ateo salvaje!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257613
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257612
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257611
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257610
    m_Localized: 'Nun: ¿Es mucho pedir, mijo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257609
    m_Localized: 'Nun: Solo estoy tratando de ver si su casa es habitable. No tolero la suciedad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257608
    m_Localized: 'Nun: ¡Oh, gracias al Cielo! Nunca lo habría adivinado sin tu ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257607
    m_Localized: ¿Pero qué te pasa, vieja loca del carajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257606
    m_Localized: ¡Esto no es un hotel!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257605
    m_Localized: 'Nun: No los soporto. Me dejan la piel toda roja y con sarpullido, como un castigo del Señor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257604
    m_Localized: 'Nun: Segundo... ¿tienes chinches? ¿Ratas? ¿Algún otro tipo de plaga?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257603
    m_Localized: 'Nun: Si tienes gente así, es mejor que me lo digas directamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257602
    m_Localized: 'Nun: Primero que nada: no tengo paciencia ni con borrachos ni drogadictos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257601
    m_Localized: 'Nun: ¿Aceptas gente, verdad? Solo necesito estar segura de algunas cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257600
    m_Localized: 'Nun: Necesito una habitación en tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257599
    m_Localized: ¿Pero qué te pasa, vieja loca del carajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257598
    m_Localized: ¡Esto no es un hotel!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257597
    m_Localized: 'Nun: Tienes íconos sagrados, ¿verdad? Y... necesito silencio total para orar y contemplar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257596
    m_Localized: 'Nun: Y ya que hablamos de eso... Permíteme preguntarte algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257595
    m_Localized: 'Nun: Para quedarme, mijo, para quedarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257594
    m_Localized: 'Nun: Señor, ten piedad... Te estoy hablando claramente, ¿o no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257593
    m_Localized: ¿Qué necesitas exactamente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257592
    m_Localized: ¿Te vendrá bien para qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257591
    m_Localized: 'Nun: Creo que me vendrá de maravilla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257590
    m_Localized: 'Nun: Veo que tu casita es la más alejada de todas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257589
    m_Localized: Perdón por hacerte perder el tiempo. Yo solo... solo espero aprender a matar un día. Para... para poder protegerme.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257588
    m_Localized: T-te juro que no lo soy. Es solo que... he estado tenso últimamente.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257587
    m_Localized: 'Raskolnikov: Debo haber sonado como un loco. O algo peor, no sé...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257586
    m_Localized: 'Raskolnikov: ¿No me vas a dejar pasar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257585
    m_Localized: 'Raskolnikov: ¿Podrías mostrarme cómo lo haces? Cómo matas a un Visitante. Quiero enfrentarme al miedo directamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257584
    m_Localized: 'Raskolnikov: Y... si no es mucha molestia... después de que me examines...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257583
    m_Localized: 'Raskolnikov: Gracias, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257582
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257581
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257580
    m_Localized: 'Raskolnikov: Podrías enseñarme... a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257579
    m_Localized: 'Raskolnikov: Pero también, tal vez... o sea, si quieres... pues...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257578
    m_Localized: 'Raskolnikov: Por eso esperaba encontrar a alguien que... pudiera, um... protegerme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257577
    m_Localized: 'Raskolnikov: ¿Y yo? Solo soy un co-cobarde. ¡No me sé defender!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257576
    m_Localized: 'Raskolnikov: Hoy en día, basta con mirar mal a alguien para que te disparen, ¡ya sabes!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257575
    m_Localized: 'Raskolnikov: Me refería a protegerme de los Visitantes. Y de la gente que los caza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257574
    m_Localized: 'Raskolnikov: No, no... espera. No me refería a ese loco con el rifle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257573
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257572
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257571
    m_Localized: 'Raskolnikov: Por eso necesito a alguien que entienda cómo funciona este mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257570
    m_Localized: 'Raskolnikov: M-me asusta lo que pueda pasar si no aprendo a defenderme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257569
    m_Localized: 'Raskolnikov: Antes, cuando todo era normal, no mataba ni a una mosca. Pero ahora... las personas débiles como yo no duran.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257568
    m_Localized: 'Raskolnikov: No quise sonar como un loco. Es solo que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257567
    m_Localized: 'Raskolnikov: ¿Qué? Ya va... ¿crees que soy... raro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257566
    m_Localized: ¿De quién exactamente intentas protegerte?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257565
    m_Localized: ¿Por qué estás tan obsesionado con matar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257564
    m_Localized: 'Raskolnikov: Y entonces, no seré yo el que viva con miedo... Serán los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257563
    m_Localized: 'Raskolnikov: Como sea. Algún día, yo... yo también aprenderé a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257562
    m_Localized: 'Raskolnikov: Menos mal que no me vio. Podría haberme roto el cuello ahí mismo, ya sabes, era de esos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257561
    m_Localized: 'Raskolnikov: Solo que... hace no mucho me topé con un loco armado. Lo vi interrogar a un tipo... le seguía preguntando si era un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257560
    m_Localized: 'Raskolnikov: A ver, no me malentiendas, no quiero que te pongas en contra de nadie...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257559
    m_Localized: 'Raskolnikov: ¡Pe-perfecto! Entonces puedes acabar con cualquier Visitante que aparezca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257558
    m_Localized: ¿De quién exactamente intentas protegerte?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257557
    m_Localized: ¿Por qué estás tan obsesionado con matar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257556
    m_Localized: 'Raskolnikov: Apuesto que hasta podrías matar a alguien con tus propias manos si fuera necesario, ya sabes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257555
    m_Localized: 'Raskolnikov: Pe-pero tienes una dureza en tu voz... Yo diría que dispararías si lo vieras necesario.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257554
    m_Localized: 'Raskolnikov: ¿Quién te juzgaría por matar a alguien en el apocalipsis? Se-sería como multar por exceso de velocidad en una carrera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257553
    m_Localized: 'Raskolnikov: Es solo que... son tiempos difíciles. ¿Sabes? Tengo que saber si puedes cuidarte solo. Si puedes e-eliminar una amenaza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257552
    m_Localized: 'Raskolnikov: Ah... disculpa. No quería ser grosero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257551
    m_Localized: Sí, tengo una escopeta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257550
    m_Localized: ¿Por qué quieres saber?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257549
    m_Localized: 'Raskolnikov: Oye, ¿estás armado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257548
    m_Localized: 'Raskolnikov: Hola, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257547
    m_Localized: 'Wifefema: ¿Sabes qué? Vete a la mierda. Voy a hablar con tus vecinos. Adiós, imbécil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257546
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257545
    m_Localized: 'Wifefema: ¿Qué carajos te pasa? Te empiezo a hablar con el corazón, ¿y tú me sales con estas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257544
    m_Localized: 'Wifefema: ¿Hablas en serio? ¡Mi esposo está en la AFAE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257543
    m_Localized: 'Wifefema: ¡¿Crees que soy una Visitante?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257542
    m_Localized: 'Wifefema: Espera... ¿qué diablos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257541
    m_Localized: 'Wifefema: Una vez que matemos a esos Visitantes, volveremos a vivir como se debe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257540
    m_Localized: 'Wifefema: ¡Así es como me gusta!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257539
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257538
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257537
    m_Localized: 'Wifefema: Toda esta charla de que "la AFAE no es para mujeres" es una estupidez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257536
    m_Localized: 'Wifefema: Trabajé en la frontera, carajo. Tengo olfato para la gente sospechosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257535
    m_Localized: 'Wifefema: No es justo, ¿no crees? ¿Qué, acaso no soy tan buena como mi esposo porque soy mujer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257534
    m_Localized: 'Wifefema: ¿Qué importa? Ahora está en la AFAE. Y yo también podría estarlo, si no vivieran en la edad media.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257533
    m_Localized: 'Wifefema: Je, como si te lo fuera a decir. ¿Por qué preguntas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257532
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257531
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257530
    m_Localized: 'Wifefema: Atrapé a un montón de desgraciados con todo tipo de basura encima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257529
    m_Localized: 'Wifefema: Solía trabajar en aduanas, ¿sabes? Dejando pasar a la gente por la frontera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257528
    m_Localized: 'Wifefema: Una verdadera lástima. Sería muy buena rastreando a los Visitantes con mi marido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257527
    m_Localized: 'Wifefema: Je, ya quisiera. Pero no, no aceptan mujeres, como era de esperarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257526
    m_Localized: ¿Qué hacía tu esposo antes de eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257525
    m_Localized: ¿Tú también eres de la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257524
    m_Localized: 'Wifefema: Y el maldito taxista me estafó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257523
    m_Localized: 'Wifefema: Quería sorprenderlo, así que pagué un dineral por un taxi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257522
    m_Localized: 'Wifefema: ¡Cuando me enteré que lo metieron en la AFAE, casi me muero!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257521
    m_Localized: 'Wifefema: ¡Oh, te lo digo bien alto y orgullosa! Ahora trabaja para la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257520
    m_Localized: ¿Qué hacía tu esposo antes de eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257519
    m_Localized: ¿Tú también eres de la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257518
    m_Localized: 'Wifefema: Cuando mi esposo de la AFAE lo atrape... Hará que se trague esos dientes de porcelana. Je.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257517
    m_Localized: 'Wifefema: Pero te juro por Dios que los dientes de ese taxista eran blancos como la leche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257516
    m_Localized: 'Wifefema: Tuve que soltar una maldita fortuna. Esas cosas cuestan un ojo de la cara estos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257515
    m_Localized: 'Wifefema: ¿Cómo? En un taxi, ¡obvio!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257514
    m_Localized: ¿Qué hace tu esposo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257513
    m_Localized: ¿Cómo llegaste hasta aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257512
    m_Localized: 'Wifefema: Pero resulta que en su trabajo no tenían dónde alojarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257511
    m_Localized: 'Wifefema: Pensé en sorprenderlo con una visita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257510
    m_Localized: 'Wifefema: Vine por mi esposo. Lo reubicaron por su trabajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257509
    m_Localized: 'Wifefema: Hola. ¿Le importa si me quedo aquí un rato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257508
    m_Localized: 'Theorist: Está bien. Confié en ti... y destruiste mi fe en la humanidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257507
    m_Localized: 'Theorist: ¡La gente merece saber la verdad!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257506
    m_Localized: 'Theorist: ¡Estás cometiendo un error!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257505
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257504
    m_Localized: 'Theorist: ¡Créeme, yo sé cuál es la verdad! ¡Olvídate de todas esas viejas mentiras que te han dicho!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257503
    m_Localized: 'Theorist: Sabía que podía confiar en ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257502
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257501
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257500
    m_Localized: 'Theorist: Así que me fui con la cabeza en alto... Y con algunos archivos valiosos en mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257499
    m_Localized: 'Theorist: Si tan solo la gente hubiera usado tapones para los oídos... los parásitos no habrían podido entrar y miles habrían podido salvarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257498
    m_Localized: 'Theorist: Pero esos estúpidos se rehusaron a ver el valor de mis hallazgos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257497
    m_Localized: 'Theorist: Yo afirmaba que los Visitantes no son la amenaza real. Es lo que tienen dentro: parásitos cerebrales.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257496
    m_Localized: 'Theorist: Solía trabajar en un instituto de investigación. Me despidieron por mis descubrimientos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257495
    m_Localized: 'Theorist: Pero me juras que no le vas a decir a nadie, ¿sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257494
    m_Localized: 'Theorist: Bueno, elegí confiar en ti, así que te lo diré...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257493
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257492
    m_Localized: Pasa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257491
    m_Localized: 'Theorist: ...la razón por la que las papitas con sabor a papa son tanto una abominación científica como una decepción de sabor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257490
    m_Localized: 'Theorist: Control mental. A través de la comida chatarra. Sí, en serio. Y, por último...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257489
    m_Localized: 'Theorist: Fraude electoral. La prueba de que el aterrizaje lunar fue falso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257488
    m_Localized: 'Theorist: Ay, amigo mío. Agárrate. Estoy a punto de abrirte los ojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257487
    m_Localized: ¿Cómo es que sabes todo eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257486
    m_Localized: ¿De qué estás hablando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257485
    m_Localized: 'Theorist: Lo que significa... que puedo compartir algo importante contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257484
    m_Localized: 'Theorist: Bueno, si lo negaste, entonces debes estar diciendo la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257483
    m_Localized: 'Theorist: Mira, según el protocolo, los agentes de la AFAE están obligados a revelar su afiliación cuando se les pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257482
    m_Localized: 'Theorist: Ah. Bien. Eso significa que puedo confiar en ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257481
    m_Localized: ¿Dónde conseguiste todo esto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257480
    m_Localized: ¿Qué clase de información?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257479
    m_Localized: 'Theorist: Estoy hablando de kilotones de datos, cosas que planeo publicar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257478
    m_Localized: 'Theorist: Llevo conmigo unos documentos muy delicados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257477
    m_Localized: 'Theorist: Necesito un lugar seguro para esconderme. Un sitio para continuar mi investigación.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257476
    m_Localized: 'Theorist: ¡Confiarte información importante, por supuesto!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257475
    m_Localized: No, no soy de la AFAE
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257474
    m_Localized: ¿Confiar en qué sentido, exactamente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257473
    m_Localized: 'Theorist: No eres de la AFAE, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257472
    m_Localized: 'Theorist: Hola, ¿qué tal? Dime... ¿puedo confiar en ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861319
    m_Localized: 'Firefighter: Toma, igual yo no lo necesito. Tíralo o úsalo como quieras.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861318
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861317
    m_Localized: 'Firefighter: Es una orden para que fueramos a reportarnos a las zonas en cuarentena de la AFAE. ¿Pero por qué iríamos si todo aquel que va termina muerto?'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861316
    m_Localized: 'Firefighter: Nos dieron este papel en el trabajo antes de ir a apagar los incendios.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861315
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861314
    m_Localized: 'Firefighter: Al menos no tendré que morir solo, en el barro.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861313
    m_Localized: 'Firefighter: No creo que te moleste por mucho tiempo. Cof.. cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861312
    m_Localized: 'Firefighter: Gracias, amigo. Cof...'
    m_Metadata:
      m_Items: []
