    m_Metadata:
      m_Items: []
  - m_Id: 69259143700795392
    m_Localized: 打字特效
    m_Metadata:
      m_Items: []
  - m_Id: 89138519934226432
    m_Localized: 暫停
    m_Metadata:
      m_Items: []
  - m_Id: 78326529556992000
    m_Localized: 專屬全螢幕
    m_Metadata:
      m_Items: []
  - m_Id: 78326756594667520
    m_Localized: 全螢幕視窗化
    m_Metadata:
