%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_ja
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ja
  m_SharedData: {fileID: 11400000, guid: 9ca4ee10b5b962b4993a5133922046c2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377490604032
    m_Localized: "Firefighter: ゴホッ ああ いいよ\n隠すことなんて ないからね\nみんな燃え尽きたから ずっと前に"
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769856
    m_Localized: 歯
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: 目
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: 脇
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: 写真
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: 耳
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: どうぞ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: "Firefighter: ゴホッ あまり酷評しないでくれよ\n煙は歯医者と相性 最悪でね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: ほら どうぞ…ゴホッ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: "Firefighter: 二本 炭の丸太みたいだろ\n爪は綺麗なのにな\n皮肉だろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: 構わないよ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: "Firefighter: ほら？ゴホッ\n石炭みたく真っ赤だろ\n煙のせいでさ まったく"
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: "Firefighter: 本気かい？\n見るに堪えないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: "Firefighter: みんな焼けただれて…\n肌は枯れ木の樹皮みたくヒビだらけだ\n腕は なるべく上げないようにしててね\n痛くて"
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: "Firefighter: ああ もちろん\n焼け焦げた森の死体をどうぞ\nお馴染みのね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: 気に入ったかい？ゴホッ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: "Firefighter: ああ お安いご用さ\n軟骨まで焼け焦げてるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: "Firefighter: そのうち耳も聞こえなくなるさ\nそのほうが いいかもね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: "Firefighter: ほら さっさと撃ちなよ\nただ 歯だけはカンベンしてくれよ\nもう 末期を迎えてるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: "Firefighter: なに 怖いものなんて なにもないさ\n撃ちなよ それで気が済むなら"
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: そのほうが いっそ楽かもね…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: "Firefighter: わかるかい？\nこの手が なにをしてきたか"
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: "Firefighter: この写真が判決なら ゴホッ\nとっととすませよう\nもう ここに留まる理由なんて\nなにもないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: "Firefighter: みんな燃えてしまう…\nどうやら ボクの番みたいだね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: "Firefighter: なあ ゴホッ 子供達に毎日\n歯磨きさせるのって 大変でさ\nでも… もう誰も あいつらを\n叱ってやれないんだな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: "Firefighter: この手で ゴホッ\n何人も助けてきたんだ\nもう コップ一つ\nちゃんと持てやしない"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: そうだよな…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: うん 死に時だ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: "Firefighter: 森が燃えたって ゴホッ\n… 灰になるまで見てるしかない\nそれで 無力を思い知るんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: "Firefighter: 夜中に目が覚めて\n肌が裂けるのを感じる ことがある\n手の打ちようがないんだ\n炎が なにもかも奪ってしまった…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: "Firefighter: 記憶だけは 火の中でも焼け残る\n肉体は 時間の問題だね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: "Firefighter: 燃え盛る炎に囲まれれば \nこの静寂の尊さ がわかるさ\nキミの耳は無事かもしれない\nけど魂は？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: "Wheelchair: よし なら とっとと検査してくれ\n全部 合格してやるから"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: 歯
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964176
    m_Localized: 目
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964177
    m_Localized: 脇
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964178
    m_Localized: 写真
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964179
    m_Localized: 耳
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: ほら 見ろよ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: この歯 宝の山だろ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: "Wheelchair: 歯じゃなくて 金なんだぜ！\nそりゃ全部じゃねえが まだ増える"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: "Wheelchair: 前歯で缶ビール開けるなんざ\n楽勝なんだぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: ああ 前歯だけでな'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: "Wheelchair: 少なくとも まだ手はあるんだ\n感謝しねえとな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: "Wheelchair: 手がなきゃ\nレースどころじゃねえもんな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: ちょっと待て'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: 指が ねえ！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: "Wheelchair: 昨日は一本ない だけだったのに\nどこだ残りは？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: "Wheelchair: まあ じきに生えてくる\nちょいと待つだけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: もう一本なくなっちまった'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: "Wheelchair: 大したことじゃねえが\n腹立つな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: "Wheelchair: でも 爪が\nちょっぴり生えてきたんだ！\n見えるだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: "Wheelchair: なら 脚だって生えてくるはずだ\nそのうちな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: "Wheelchair: どこ見りゃいい？\nアンタのツラか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: "Wheelchair: ビクビクしてんだろ？\n癖なんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: "Wheelchair: エンジン全開で吹かせてた頃から\nなにも見えちゃいなかったんだ…\nなに一つ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: "Wheelchair: 今でもスピード落とす覚悟\nできてないんだろうな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: おっと'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: "Wheelchair: ほら どうぞ\nハハハハ いいともいいとも"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: これぞ 最高の喜劇だな'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: "Wheelchair: アンタが見せろってんなら\n脇ぐらい構わねえよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: "Wheelchair: 外じゃ地獄の業火が燃え盛り\n宇宙に星ごと押しつぶされそうで"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: 来訪者どもに一掃されかけてる'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: "Wheelchair: なのにアンタ\n「脇を見せてくれ！」ってか"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: ハハハハ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: 写真？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: "Wheelchair: あんま趣味じゃねえが\nいいとも"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: クソッ 目つぶっちまった'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: "Wheelchair: ハハハハ！\nいいじゃねえか ボス！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: アンタも あの放送 聞いたクチか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: "Wheelchair: よしよし\nあ？そうなんだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: …待て 冗談じゃねえのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: そいつは… ヤベえな'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: "Wheelchair: おい もうビール パクらねえから\nそう ピリピリすんなって"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: キレた奴が どうなるか知ってるか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: ベビーカーで轢かれるんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: "Wheelchair: アンタもブチギレたら\nオレを押してくれよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: なんでだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: それでオレが 救えんのか'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: "Wheelchair: アンタだって そうだろ\nなら なんで銃なんて抜くんだよ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: "Wheelchair: 弾を目で追うのは無理だろうな\nでも 避けてみせる"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: "Wheelchair: なんで みんな毛を剃るんだか\n体毛ってのは 天然の防御だろ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: "Wheelchair: 赤らんでるの見えるか？\n指 育ててんだ\n代わりのな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: "Wheelchair: おっと\nまだ喜劇は始まっても ねえぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: "Wheelchair: オレたち どこで人生\n間違えたんだろうな？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: "Wheelchair: なんで写真？\n「深呼吸したって\n死は先延ばしできない」\nって言うだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: "Wheelchair: もっと言いたいこと\nあったはずなんだがな…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: 行っていいか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: "Wheelchair: まあ\nこうなる運命だったんだろうな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: "Wheelchair: 遅かれ早かれ\n神に首 刎ねられるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: 黙って死ぬ つもりはねえけどな'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: "Wheelchair: 所詮\nこいつが肉の生物学 ってワケだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: "Wheelchair: 前は笑い合ってたのに\n今じゃ互いの頭を吹っ飛ばそう\nってか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: 死ぬ覚悟 キメねえとな'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: 今じゃ この手が 唯一のエンジンだ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: クラッチなし とはいえな'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: "Wheelchair: 正直 言って\nこの手すら失う日が怖くてな\nそしたら どうなる？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: "Wheelchair: 動き回る術を 完全に失っちまうんだ\n永遠に 立ち往生してな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: 死ぬよりも 恐ろしいよ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: "Wheelchair: どんだけ目玉ギョロつかせたって\n時間には追いつけねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: "Wheelchair: 歳 取ると\n時間が加速していかねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: "Wheelchair: ガキの時分は\nなに一つ慌てず すんだのにな\nなにもかも単純で\n責任も決断も いらなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: "Wheelchair: なのに今じゃ\nどう足掻いたって 間に合わねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: "Wheelchair: なあ\nなんか急に 笑えなくなってきた"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: くだらねえ検査に 火消し'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: "Wheelchair: どいつもこいつも救世主 気取りだが\n手段は てんでバラバラ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: "Wheelchair: で なんの意味が あるってんだ？\nいっそ力ぬいて 諦めちゃ どうだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: なあ…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: 旅の終わりだと思わねえか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: "Wheelchair: もう終点なんだ\nそろそろ降りねえとな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: 窓の外には 最後の停留所だ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: アンタは準備できてるか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: "Wheelchair: ちょっと 考えてたんだが\nあたふた しねえでくれよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: "Wheelchair: アンタが…\nこの徴候を信じられねえなら\nオレにだって信じられるはず\nないだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: "Wheelchair: 来訪者の徴候の\nもっともらしさってのは\nどれも似たり寄ったり なんじゃねえか"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: "Wheelchair: 人間ってのは\n間違える生き物だしな\nまあ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: "Wheelchair: でも その間違いが\n恐ろしい結末を\n引き起こすかもしれねえんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: "Wheelchair: アンタが…この徴候 頼りってんなら\nこれまでの徴候は なんだったんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: "Wheelchair: 他の徴候だって\nデタラメかも しれねえぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: "Wheelchair: オレら人間だろ 当然\nなら間違えることもある\nそれだけの話だ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: "Wheelchair: でも その間違いが\n恐ろしい結末を\n引き起こすかもしれねえんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: "Wheelchair: アンタの…\n振る舞い一つで なにかイカれて\n誰かの一生を終わらせるハメになる"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: "Wheelchair: 自分の選択を信じられるなんざ…\n羨ましいな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: "Mother: いいよ 検査して\n隠すもんなんて ないもの"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: 歯
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: 目
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: 脇
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: 写真
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: 耳
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: どうぞ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: "Mother: その 昔は歯のケアなんて\n気にも留めてなかった\nそんなヒマ なかったしね\n今になって… 後悔してる"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964303
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964304
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: ほら ご覧'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: "Mother: 手って言うより シャベルみたいだろ\n子供のために やってきたからね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964307
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964308
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: 見なよ ほら'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: "Mother: すごいクマだろ？\n睡眠不足でさ…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964311
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964312
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: 見なよ ほら'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964314
    m_Localized: "Mother: 消臭剤なんざ\nとうの昔に切らしてるからさ\n恨まないでよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964315
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964316
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: "Mother: 座っていい？\nダメ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964318
    m_Localized: "Mother: だらしない しかめっ面\nいつも通りだね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964319
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964320
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: "Mother: 長いこと掃除してないからね\nもう詰まってるかも"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: "Mother: 子供らの叫び声だって\n半分も聞こえやしない"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964323
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964324
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: "Mother: ここ一週間\n歯磨きのたび血が出るんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: "Mother: 磨いてるのに黄色いまんまだよ\nあんな子供らと一緒だと\n吸わずにいられないだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964327
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964328
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: "Mother: 洗剤のせいで かぶれてるんだ\n病院 行くヒマも なくって"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: "Mother: この手だよ！\nアンタにスープ こしらえてんのは\nなのに撃とう ってのかい"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964331
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964332
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: "Mother: 手榴弾でも出しなよ\nどうせ ぐっすり\n眠れやしないんだから"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964334
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964335
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: "Mother: へえ\n臭いのせいで 撃つっての？\n笑えるね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964337
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964338
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: "Mother: へえ\n写真で決めつけんだ？\n冗談だろ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964340
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964341
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: "Mother: 耳のせいで撃とう\nってんなら イカれてるよ\nなにが気に入らないんだい？\nスカーフで隠しといて やろうか！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964343
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964344
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: やっと 誰の面倒も見ずにすむ…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: ヒドいもんだ…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: "Mother: ねえ うちの子供らの一人\n完璧な歯してたよ\nでも 一度も笑わなかった\n結局 歯なんざ関係ないのかもね？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: "Mother: この手で… 子供ら抱いてきたんだ\n家事だって 夫の世話だって\nでも わかるかい？\n誰一人 感謝ひとつ しなかったよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964349
    m_Localized: "Mother: 子供らが病気になると\n何日も眠れなくなるんだ\nでも慣れていくし\n悪夢の中を暮らすだけだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964350
    m_Localized: "Mother: 以前 疲れすぎて\n一週間も風呂に入れなかった\n子供ら 気付きもしなかったよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964351
    m_Localized: "Mother: ねえ 昔 子供らみんな\n笑ってる写真を見つけてさ\n一晩中ずっと見てたよ\n眠れるまで"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964352
    m_Localized: "Mother: 時々 なにも聞こえなければいい\nなんて考えるよ\n子供らが寝た後の あの至福の静寂…\nそれだけが生きてる意味だね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: "Anger: マジかよ？\nクソッ… ああ いいとも\nでも さっさと頼むぜ！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: 歯
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: 目
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: 脇
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: 写真
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: 耳
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: "Anger: クソどうだっていいだろ\nほらよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: "Anger: 黄色い？\nはっ クソ食らえ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: "Anger: 白い？\n自分で世話してんだから\nそりゃそうだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: "Anger: 昔は こんな歯 一本ぐらい\n金歯でもいいと思ってた\n映画のタフガイみてえにな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: ああ 構わねえよ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: "Anger: おっと\nなんてデカい手なんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: "Anger: はっ ばあちゃん いつも言ってたよ\nこんな手してんだから\n薪でも割んなって\n…いつもしてるような マネじゃなくて"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: "Anger: けど ここに割る薪なんざねえし\nどこかに怒りをぶつけねえと"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: "Anger: 好きにしな\n気にしねえから"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: "Anger: なんだ 色が気に入ったのか？\n青いだろ\n昔から こうなんだ\n女 引っかけんには コイツだけで充分"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: てんで構いやしねえよ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: ほら 剃ってるよ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: "Anger: 脇毛そのままにしてんの\n許せねえんだ\nクソ薮 育ててんのか って"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: やれよ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: "Anger: あっ？\nなに クソじろじろ見てんだ？\nなんか見えたか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: クソッ…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: "Anger: なに じっと見てんだ？\nなんか足んねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: "Anger: とち狂ってんのか？\n歯 見せただけじゃねえか"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: "Anger: クソどうかしてんのか\n引き金ハジくより\nこの手でブン殴るほうが遅いとでも？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: "Anger: クソッ どうしてえんだ？\n嫉妬でも してんのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: "Anger: ずっと ムズムズしてんだ\nスイッチ押したくて たまらねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: "Anger: 血が出るまで掻きむしって\nやっと落ち着くんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: "Anger: 信じらんねえ\nマジ イカれてんだろ！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: "Anger: クソ写真ごときで撃とう\nってのかよ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: "Anger: そのホウキ\n振り回すなら注意しろよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: "Anger: 耳ぐれえで\nぶっ放されたか ねえからな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: "Anger: てめえ すっかり頭ぶっ壊れてんな\n上等だ\n来やがれ フヌケ野郎！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: "Anger: どうしようもねえ\nクソ冷血クズ野郎が"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: 一人でイってろ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: "Anger: ばあちゃん 金歯 持ちでよ\nガキの頃から\nほしくて しかたなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: "Anger: 口の中に 太陽が\n引っかかってる みてえに輝いてた"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: "Anger: ばあちゃん 言ってたよ\n前の歯が腐って\nそれで入れたんだって"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: "Anger: それで ハシャいじまったんだ\n「やった！オレも いつか金歯に\nしてもらおう」って"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: "Anger: それで…\nまあ そのときが来たんだ\n誰もなにも しちゃくれなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: "Anger: 今 口の中にあんのは\n太陽じゃなくて\nションベン色の歯だけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: "Anger: どうだ この手？\n泥 血 なんでもござれだ\nアンタが求めてるもんがな\nでも他人のじゃねえ 残らず自分のだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: "Anger: たまに どうしようもなく痒くてな\n全身の皮膚を引き裂きたくなる\nそれか 壁 ブン殴るか\nあるいは どっちも"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: "Anger: こらえらんねえんだ\nでも 他人を傷つけたかねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: "Anger: 見えるか この爪？\n泥 血 なんでもござれだ\nアンタが求めてるもんがな\nでも他人のじゃねえ 残らず自分のだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: "Anger: たまに どうしようもなく痒くてな\n全身の皮膚を引き裂きたくなる\nそれか 壁 ブン殴るか\nあるいは どっちも"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: "Anger: 他の連中なら\n自分のことで精一杯だったかもな\nでも クソ知ったことか"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: "Anger: 目の色のせいで ばあちゃん\nいつもオレを「天使ちゃん」\nなんて呼んでた\nああ クソ「天使」だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: "Anger: 今こうして 魂の窓を覗いてると\n考えちまうんだ\n「クソみてえなオレの\nどこが天使なんだ！？」って"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: "Anger: ばあちゃんに見られたら\nガッカリされちまうだろうな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: "Anger: なあ カミソリって充分 鋭いんだ…\nなにをするにもな\nそんなに楽なら…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: "Anger: でも 腕に かすり傷つけるだけだった\nそれから ヒゲ剃るたびに\n刃で毛じゃなくて\n自分を切ってる感じだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: "Anger: まあ とにかく剃るんだけどな\nあのクソ薮 気に食わねえから"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: "Anger: ばあちゃんの写真なんざ\n残っちゃいねえよ\nそういうの クソ嫌ってたから"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: "Anger: 写真 撮られると 魂まで取られて\n閉じ込められちまう\nなんて言って"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: "Anger: 大笑いしながら言い返したよ\n「ねえ ばあちゃん\nそんなわけないよ」って"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: "Anger: でも こう言うんだ\n「アタシが死んだら 写真を見て\n天国に行けたかどうか 考えてみな」"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: "Anger: で 結局クソみたいなオチ\n写真も ばあちゃんも どっちもねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: "Anger: 時々 耳たぶ 引っ張っちまうんだ\nいや 地獄みてえに\n熱くなってるときだけな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: "Anger: 神経質から来る癖\nなんだと思ってた"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: "Anger: でもよ 気づいたんだ\nオレは ただ 邪魔者みてえに\n引きちぎりてえだけ なんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: "Anger: だが 自分をバラすほど\nイカれちゃいねえ…\nだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: だよな？？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: "FortuneTeller: あら お前さん\n気が反発するのは読めてたよ\nでも 試してみな\nお前さんの内まで お見通しだからね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: 歯
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: 目
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: 脇
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: 写真
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: 耳
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: ほら 見なよ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: "FortuneTeller: 内なる宇宙を映すのは\n目であって 歯じゃないよ\n私の運命でも見える ってのかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: "FortuneTeller: 内なる宇宙を映すのは\n目であって 歯じゃないよ\n面白いものでも見えるかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: ほら 好きに見なよ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: "FortuneTeller: でも気をつけな\nドリームキャッチャーの棘\nまだ抜いてないからね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: "FortuneTeller: おや 私の目かい？\n茶色だよ もちろん"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: "FortuneTeller: まあ 赤い斑点を無視すればね\nそいつは月のせいだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: "FortuneTeller: おやおや…\n宇宙ってのは こんなものまで\n私の道に置くんだね…\nいいさ ご覧"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: "FortuneTeller: こんな世の中じゃ\n身嗜みにも一苦労だよ\nねえ…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: "FortuneTeller: 気をつけるんだよ\n私のオーラで目を潰さないようにね！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: "FortuneTeller: それで？\nどうだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: "FortuneTeller: ほら ご覧よ\nでも用心しな\nこいつらは お前さんの考えまで\nみんな聞いてんだから"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: "FortuneTeller: それで？\n答えは見つかったかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: "FortuneTeller: 歯ぐらいで撃とう ってのかい？\n私のせいじゃ ないんだよ\n火星が金星に ふて腐れてるだけ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: "FortuneTeller: 本気かい？\n手が棘まみれだから撃つ って？\nドリームキャッチャーに\n付きものの代償だろ！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: "FortuneTeller: 正気かい！？\nこんなの 単なる月の悪戯だろ？\n月の軌道は\nたやすく読めないんだよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: "FortuneTeller: 正気かい！？\nこんなの 単なる月の悪戯だろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: "FortuneTeller: こんなの占星術じゃなくて 蛮行だよ！\n銃を下ろしてくれたら\n私の秘密を教えるからさ？\nタダで！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: "FortuneTeller: ちょっと！\nお前さんが支度できてなかった\nからじゃないか！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: "FortuneTeller: その物騒なの\n下ろしちゃくれないかい？\n耳ぐらいで なにが わかるんだい？\n賢者の声を聴くために付いてんだよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: "FortuneTeller: 私を殺したら\nお前さん呪われるよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: 永遠の下痢地獄にね！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: "FortuneTeller: なんだね\n前に完璧な歯の男が\n来たこと あってね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: "FortuneTeller: 言ってやったんだ\n「ご立派だけど魂が腐ってるね！」\nなにが大事か 考えてもみな\nわかるだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: "FortuneTeller: ある儀式をして一晩中\n棘を抜いたことがあるんだ\n痛かったけど 一つ一つが\n宇宙からの授業みたいだった"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: "FortuneTeller: 目ってのは別世界への門なんだ\n前に見た男は 蝋燭みたく目が輝いてた\n愛の賜だなんて うそぶいてたけど\n火星の仕業だったね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: "FortuneTeller: なあに\n以前 三週間ばかし禁欲して\n夢ばかり考えたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: "FortuneTeller: 思考は現実になるんだよ\n願い ってのは\nそうやって叶っていくんだ\n必要なのは きちんと願うことだけさ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: 今の私は当時に匹敵する状態だね'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: "FortuneTeller: 昔 写真を撮られて思ったんだ\n「これは星からの徴だ！」って\nでも結局 単なる照明の問題だったね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: "FortuneTeller: あるとき 耳の奥で音がしたんだ\n宇宙が語りかけようと してるみたいに\nでも もっと強いなにか だったね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: "FortuneTeller: あるとき 音が聞こえたんだ\n宇宙が語りかけようと してるみたいに\nまあ 単なる突風だったんだけど\n悪くなかったね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158522
    m_Localized: 'Fanatic: なに確かめてえんだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158523
    m_Localized: 歯
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158524
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158525
    m_Localized: 目
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158526
    m_Localized: 脇
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158527
    m_Localized: 写真
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158528
    m_Localized: 耳
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158529
    m_Localized: 'Fanatic: 歯を見てえだと？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158530
    m_Localized: 'Fanatic: 真実を噛みしめてきた歯だ！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158531
    m_Localized: 'Fanatic: そして砕けちまった…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158532
    m_Localized: 'Fanatic: 自分の目で見てみろよ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158533
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158534
    m_Localized: "Fanatic: ビールで うがいして磨いてんだ\nカルシウムに よく効くんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158535
    m_Localized: "Fanatic: ビールなしじゃ とっくの昔に\n歯 全部いっちまってたろうな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158536
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158537
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158538
    m_Localized: 'Fanatic: そりゃそうだよな 当然'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158539
    m_Localized: "Fanatic: 今は あれこれ起こりすぎてる\nでも オレら生きてんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158540
    m_Localized: 'Fanatic: 生きてくんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158541
    m_Localized: "Fanatic: おいおい \n日陰に隠れすぎなんじゃねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158542
    m_Localized: 'Fanatic: ちょっとは休みな ダチ公'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158543
    m_Localized: 'Fanatic: 好きにしな ダチ公！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158544
    m_Localized: 'Fanatic: 爪ぐらい いくらでも見てってくれ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158545
    m_Localized: "Fanatic: しっかり鍛えてあんだ\n日光の恩恵を吸収できるようにな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158546
    m_Localized: 'Fanatic: それとビールを開けられるように'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158547
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158548
    m_Localized: 'Fanatic: 確かめたかっただけか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158549
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158550
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158551
    m_Localized: 'Fanatic: この目を見ろ！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158552
    m_Localized: 'Fanatic: 怒りと憤りに燃えてるだろ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158553
    m_Localized: 'Fanatic: この暗い目を見ろ！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158554
    m_Localized: "Fanatic: 光の恩恵を吸い込んで\nエネルギーに変えてんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158555
    m_Localized: "Fanatic: オレのエネルギーは\nみんな目から来てんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158556
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158557
    m_Localized: "Fanatic: 見えたか！？\nオレの目に宿る\n太陽の神性なる力が！？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158558
    m_Localized: "Fanatic: 見えなけりゃ 目が腐ってんな\nもっと太陽を凝視しな\nオレみたく！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158559
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158560
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158561
    m_Localized: 'Fanatic: 写真？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158562
    m_Localized: "Fanatic: ほう…\nほうほうほう"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158563
    m_Localized: "Fanatic: オレが日輪の導師に迎えられた話\n誰かから聞いたのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158564
    m_Localized: "Fanatic: ああ アイツに太陽の見方\n教えたのはオレだ\nだが その話は また今度な"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158565
    m_Localized: "Fanatic: さあ やんな\nオレを撮ってくれ！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158566
    m_Localized: 'Fanatic: （だらしない男の写真を撮る）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158567
    m_Localized: "Fanatic: （生き様のままに 写真の男も\n汚い身なりで不潔だ）"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158568
    m_Localized: "Fanatic: （写りの歪みは\nどこにも見当たらない）"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158569
    m_Localized: 'Fanatic: 素晴らしい出来映えじゃねえか！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158570
    m_Localized: "Fanatic: また来てくれよ\nオレの人生 全て語ってやるから"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158571
    m_Localized: 'Fanatic: お代は ちょっとで いいからよ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158572
    m_Localized: "Fanatic: 太陽エネルギー節約に\n使わせてもらうぜ！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158573
    m_Localized: "Fanatic: 撃ってみろよ！\n真実がオレを守るからよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158574
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158575
    m_Localized: 'Fanatic: 銃 下ろしてもらえるか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158576
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158577
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158578
    m_Localized: "Fanatic: ああ 手にビールがねえと\nつれえなあ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158579
    m_Localized: 'Fanatic: つれえぇぇよぉぉ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158580
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158581
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158582
    m_Localized: 'Fanatic: オイ なんのマネだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158583
    m_Localized: 'Fanatic: 気でも触れたか 無知蒙昧！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158584
    m_Localized: "Fanatic: 陰口 叩くだけじゃなくて\n撃ちやがるなんて…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158585
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158586
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158587
    m_Localized: "Fanatic: おいおい\nそいつは やりすぎだろ！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158588
    m_Localized: 'Fanatic: こんなんじゃ 生命力 湧かねえよ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158589
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158590
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158591
    m_Localized: "Fanatic: 待てよ\nオレの手が そんなに気に入らねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158592
    m_Localized: 'Fanatic: なんでだよ！？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158593
    m_Localized: "Fanatic: ケチで無礼なヤツ\nそれとビール飲ませろよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158594
    m_Localized: "Fanatic: クソッ\n百見は一聞に如かず\nって言うけどよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158595
    m_Localized: "Fanatic: だからって\nどうしろ ってんだ？\n永遠に目 逸らしてろ ってか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158596
    m_Localized: 'Fanatic: あっ いや 待てよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158597
    m_Localized: 'Fanatic: 「百聞は一見…」だったか'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158598
    m_Localized: 'Fanatic: ちょっと待ってくれ…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158599
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158600
    m_Localized: 'Fanatic: クソどうでもいいか'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158601
    m_Localized: 'Fanatic: それでいいんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158602
    m_Localized: 'Fanatic: 太陽は撃てねえもんな！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158603
    m_Localized: "Fanatic: オレのことは気にすんな\n怒っちゃいねえから"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158604
    m_Localized: "Fanatic: お前 冷えた命の水\nたんまり蓄えてるしな！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158605
    m_Localized: "Fanatic: おっ\nイタズラ好きなのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158606
    m_Localized: "Fanatic: よし\n嗅ぎたいなら嗅げよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158607
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158608
    m_Localized: 'Fanatic: これが日頃の手入れの成果だな'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158609
    m_Localized: "Fanatic: おっ\nイタズラ好きなのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158610
    m_Localized: "Fanatic: よし\n嗅ぎたいなら嗅げよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158611
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158612
    m_Localized: 'Fanatic: これが太陽の恩恵ってもんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158613
    m_Localized: "Fanatic: 生き続けるために\n爽快な水分を発散してんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158614
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158615
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: なにを確かめたいんです？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: 歯
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: 目
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: 脇
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: 写真
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: 耳
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: "Anxiety: はは 歯で判断するつもり？\nああぁぁぁぁ…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: この前 歯を治したばかりで'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: でも 正直な話…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: "Anxiety: 歯医者に行ったの\nいつだったかな\nそもそも 行ったっけ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: "Anxiety: もう すごく怖くて\n昨日なに食べたかさえ\n思い出せない"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158629
    m_Localized: "Anxiety: それで…\n該当した？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158632
    m_Localized: "Anxiety: 私 来訪者なの？\nなんで？なんでなの！？\nあり得ない！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158633
    m_Localized: "Anxiety: ああぁぁぁ もう\n家を追い出されて 仕事もクビ\n今度は頭にも居場所ナシなんて…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: "Anxiety: 爪を見たいの？\nおかしな徴候…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: "Anxiety: でも いいよ\nどうぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: "Anxiety: これ なに？\n土じゃないよね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: "Anxiety: だって…\n地面を掘った記憶なんて ないのに"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: なんで こんな汚れてるの？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158644
    m_Localized: "Anxiety: 何日も汚れっぱなしで\n歩いたはずなんてない\nでしょ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158645
    m_Localized: "Anxiety: なんて…\n変なの"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158648
    m_Localized: "Anxiety: 考え直して！\nこの土が どこから来たのか\n思い出せないんです\n座ってただけなのに あなたの家に"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158649
    m_Localized: "Anxiety: 誰か…\n誰かが爪に土を詰めた？\n誰がそんなこと？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: 目を確かめたいんですか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158651
    m_Localized: 'Anxiety: 結果は見え見え'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158652
    m_Localized: "Anxiety: その徴候に当てはまってたら\nどうなるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158654
    m_Localized: "Anxiety: まあ そうですよね\n他に あり得ませんから"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158657
    m_Localized: "Anxiety: 私 本当に来訪者なんでしょうか？\nどう思います？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158658
    m_Localized: "Anxiety: どうして自分じゃ\nわからないんでしょうか？\nそうやって来訪者に\n変わっていくのかも"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158659
    m_Localized: "Anxiety: 自分は他の人たちと違う\n社会で最悪の存在\nそう思うだけで 充分なんでしょうね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: 死ぬのが怖い'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158663
    m_Localized: "Anxiety: ねえ\n包帯かなにか もらえない？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158664
    m_Localized: "Anxiety: それか せめて\nもう少しだけ 立っていたい"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158665
    m_Localized: "Anxiety: 私が来訪者になったら\n人を殺し始めるんでしょうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158666
    m_Localized: "Anxiety: 危険な存在になるんでしょうか？\nそれとも ずっと\nそうだったんですかね？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158667
    m_Localized: 'Anxiety: もしかして もう人を殺してる？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: （写真を撮る）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158669
    m_Localized: "Anxiety: （現像すると 背景は鮮明なのに\n体がボケている）"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158670
    m_Localized: "Anxiety: （まるで 撮影の瞬間\nピクッと動いたように）"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158671
    m_Localized: "Anxiety: ははは 想像できます？\nちょっと身震いしただけです"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158672
    m_Localized: 'Anxiety: これから どうなるんです？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158673
    m_Localized: "Anxiety: 生かして もらえるんですか？\nそれとも 殺します？\nどうする つもりですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: どうして？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: いっそ撃ち殺すほうが楽ですよね？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158678
    m_Localized: 'Anxiety: 出ていきたいのに 怖すぎて'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158679
    m_Localized: 'Anxiety: もしかして…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158680
    m_Localized: 'Anxiety: わからない'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158681
    m_Localized: "Anxiety: 撃たれたら もっと恐ろしい存在に\n変わるんでしょうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158682
    m_Localized: 'Anxiety: 逃げたほうが いいのかも'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158683
    m_Localized: "Anxiety: でも 自分が人間なのかどうか\nもうわからない"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158684
    m_Localized: 'Anxiety: どうすればいいの？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158685
    m_Localized: 'Anxiety: 家にいた来訪者そっくり'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158686
    m_Localized: "Anxiety: ごめんなさい\n怖くて…\n見せますね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158687
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: "Anxiety: 私 人間ですよね？\nそうですよね？\n人間だって言って お願いだから！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: "Anxiety: どうせ銃を構えるなら\nなんで訊ねたの？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: 人を からかって楽しい？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158695
    m_Localized: "Anxiety: なんて悪夢\nどこにも安らげる場所なんてない"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158696
    m_Localized: "Anxiety: 来訪者が家に\n押し入ってくるかもしれない\n異常者が勘違いして\n殺してくるかもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158697
    m_Localized: "Anxiety: 怖すぎる！\nせめて誰か言って！\nなにもかも大丈夫だ って！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158698
    m_Localized: "Anxiety: この徴候だけで私が来訪者と\n決めつけるんですか？\nどうして？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158699
    m_Localized: 'Anxiety: ただでさえ 体に恵まれなかったのに…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158700
    m_Localized: "Anxiety: あちこち筋張ってて\nそれで 職場のみんな\n私を怖がってたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158701
    m_Localized: "Anxiety: 先週 腰のことで病院に行ったんだ…\n確か"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158702
    m_Localized: "Anxiety: それから…\n歯医者にも行ったんだっけ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158703
    m_Localized: 'Anxiety: いくら支払った…？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: なにを確かめたいんだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: 歯
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: 目
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: 脇
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: 写真
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: 耳
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: 歯を見せろと？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: "Esenin: いいとも 見な\n悲嘆と煙の臭い たっぷりだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: ずいぶん黄色いだろ？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: なら検査なんて クソ食らえ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: 俺は来訪者じゃないんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: 連中 どこから湧いて出たんだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: "Esenin: 爪に土が付着してたら\n徴候だと？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: 手を洗えばいいだろ！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: "Esenin: ならば 庭師は全員\n来訪者とでも？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: クソくだらない'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: 爪を見るがいい'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: "Esenin: で？\n俺は来訪者か？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: 違うだろ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: 日々は馬鹿げていく一方だな'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: "Esenin: 俺が寝不足だったら？\n泣いてたら？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: "Esenin: こんな検査 なんの意味があるのか\n最早 理解できん"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: "Esenin: それに徴候に一つ該当したから\nどうだというんだ？\n二つ以上なら？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: 'Esenin: 今夜は俺も来訪者になるとするか'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: "Esenin: 穏やかな日々を思い出して\n泣きたくなるな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: "Esenin: 徴候検査の数々に\n黄色い防護服の連中…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: どれもこれも…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: めちゃくちゃだ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: "Esenin: 感じないか？\nなにもかもが 恐るべき地獄か\nなにかへ向かっていると"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: "Esenin: 万事 管理下のはずなのに\n周囲は すっかり混沌そのものだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: ほら クソ写真 撮るがいい'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: （写真を撮る）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: "Esenin: （男は穏やかに座り\n全身収まってないが\n特に異常はない）"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: "Esenin: 怖いだけだ\nこれから なにが起こるのか"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: "Esenin: 正気か？\nそれとも頭おかしいのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: FEMAに脳を食われでもしたか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: "Esenin: まさか酔っているのか？\n強い酒は もう空けたと思っていたが"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: "Esenin: まあ 君が そういうなら\n見せてやろう！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: 見たかったものは見れたか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: 望み通り 嗅げたか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: "Esenin: ケツ周りを掘られなかっただけ\n感謝だな！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: 早く すませて'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158751
    m_Localized: 歯
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158752
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158753
    m_Localized: 目
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158754
    m_Localized: 脇
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158755
    m_Localized: 写真
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352768
    m_Localized: 耳
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: えっ？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: "Widow: そう…\nわかった"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: すんだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: そっとしておいて もらえる？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352774
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352775
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: "Widow: 手…\nちょっと待って"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: "Widow: 腕が疲れ切ってて\n助けてもらえなかった人たちを運んで"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: "Widow: こんな くだらないこと\nもうやめてもらえない？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: "Widow: そんなに撃ちたいなら\nさっさと撃って"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: もう なんの力も残ってないから'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352782
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352783
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: "Widow: なにを見たいの？\n充血？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: どうぞ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: "Widow: 動揺ひとつ見せたら\nそれで来訪者ということ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352788
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352789
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: もっと ざっくばらんに話していい？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352791
    m_Localized: "Widow: あなた 喜ぶこともできず\n泣くこともできず"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352792
    m_Localized: 'Widow: 話すことさえ いつも下手'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352793
    m_Localized: "Widow: 他に なにが残ってるの？\n顔を手で覆って\n座っているしかない"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352794
    m_Localized: 'Widow: こんなにも あっけなく 終わるの？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352795
    m_Localized: 'Widow: もう 苦しまなくて いいの？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352796
    m_Localized: "Widow: でも あなたを救えなかった\n私の…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352797
    m_Localized: 'Widow: そんなの 侮辱と思えないの？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352798
    m_Localized: "Widow: 誰も あの人を\n救ってくれなかった癖に\n今になって…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352799
    m_Localized: "Widow: あなた あの人の死を\n写真に収めたい っての！？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352801
    m_Localized: 'Widow: 言葉も出ない'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352802
    m_Localized: 'Widow: 勝手にして 放っておいて'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352803
    m_Localized: 'Widow: （写真を撮る）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352804
    m_Localized: 'Widow: （特に異常は見当たらない）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352805
    m_Localized: "Widow: （写っている死んだ男が\n命について考えさせる）"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352806
    m_Localized: 'Widow: 出てって'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352807
    m_Localized: 'Widow: あの人 私の歯が好きだった'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352808
    m_Localized: "Widow: でも 私のほうは\n矯正したかったんだけど"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352809
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352810
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: そう どうして撃たないの？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352812
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352813
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: "Widow: こんな新世界で\nまだ人間は泣けるの？\n笑うのは 無理にせよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352815
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352816
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: あなた 狂ったの？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: "Widow: ねえ 教えて\n正気を失ったんでしょ！？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: "Widow: フライパンの上で踊れと\n悪魔に言われたら\n真っ先に乗るつもり？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: "Widow: あなた…\nクソッ… 言葉も出ない"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: "Widow: で？\n銃でも取り出す？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352823
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352824
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: クソッ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: "Widow: ほら 引き金 絞れば\nFEMAに魂を殺されたんだから\nあなたは体にトドメをさせばいい"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352827
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352828
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352829
    m_Localized: "Widow: 矯正のことなんて\nずっと考えもしなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352830
    m_Localized: "Widow: 歯を見せろと言われるまで\nまるで覚えてなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352832
    m_Localized: "Widow: ああ もう…\n疲れ果ててる"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352833
    m_Localized: "Widow: 周りの人に八つ当たりしてばかり\nでも…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352834
    m_Localized: "Widow: 誰も悪くない\nあのクソども以外"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352835
    m_Localized: "Widow: 理解できないし\nわかりたくもない"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352836
    m_Localized: "Widow: 人を失ったばかりの相手を\n辱めるなんて…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352837
    m_Localized: 'Widow: ちょっと待って…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352838
    m_Localized: "Widow: はぁ\n銃まで持ち出すなんて"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352839
    m_Localized: "Widow: 挙げ句の果てに\n撃たずじまい"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352840
    m_Localized: "Widow: なんだったの？\n気の迷い？\nそんな風に振る舞うもんじゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: なにをチェックすんだい？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352842
    m_Localized: 歯
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352843
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352844
    m_Localized: 目
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352845
    m_Localized: 脇
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352846
    m_Localized: 写真
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352847
    m_Localized: 耳
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352848
    m_Localized: 'Scammer: 歯なら任せとけ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352849
    m_Localized: "Scammer: 地元のダチさ\n元は歯医者だったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352850
    m_Localized: "Scammer: でさ 聞いてくれよ？\nそいつ 歯 全部 抜かれちまったんだ\nハハハハ！"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352851
    m_Localized: "Scammer: おっと 見たいんだったな\nいいよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352853
    m_Localized: 'Scammer: 問題ないだろ？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352854
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352855
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352856
    m_Localized: "Scammer: どういうこった？\n完璧なネタだったろ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352857
    m_Localized: "Scammer: それに 歯のせいで顔面\nブッ飛ばされるなんて…\nスジが通らないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352858
    m_Localized: 'Scammer: 頼むからさ？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352859
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352860
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: イカれてんのかよ？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: "Scammer: チッ\nくたば…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: "Scammer: なんだよ？\nオイラ ただの男だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: "Scammer: 爪なんて弄ってないってば\nほら 見てくれよ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352866
    m_Localized: 'Scammer: 誤解だって'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352867
    m_Localized: "Scammer: ちゃんと洗ってるよ\nただ 地面に小銭 落ちてたから\n拾っただけで"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352868
    m_Localized: "Scammer: 綺麗なもんだろ\n今日も洗うからさ\nなあ 頼むよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352869
    m_Localized: "Scammer: ちゃんと洗ってるよ 兄弟\n今日はちょっと ヒマがなくてさ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352870
    m_Localized: 'Scammer: 綺麗なもんだろ 大体'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352871
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352872
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352873
    m_Localized: "Scammer: 爪が汚れてるからって\n仲間にブッ放すのかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352874
    m_Localized: "Scammer: いいさ\nこんなアホみたいな理由で\n死ぬなんてな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352875
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352876
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352877
    m_Localized: "Scammer: 手で怪物が見分けられるって\nおかしな話だよな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352878
    m_Localized: "Scammer: 手 見ればバカとカモはわかるけどさ\n来訪者に なんの関係があるんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352879
    m_Localized: "Scammer: 朝9時に起きて\n4時間以上は働くんだね\nクソッタレ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352880
    m_Localized: 'Scammer: 近ごろ 目が痒くってさ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352881
    m_Localized: "Scammer: 太陽のせいかね？\nそれとも別？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352883
    m_Localized: 'Scammer: クソッ ニイさん'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352884
    m_Localized: 'Scammer: 病気っぽいぞ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352885
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352886
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352887
    m_Localized: "Scammer: 耳 貸してくんなよ\n絵図が描けたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352888
    m_Localized: "Scammer: 他の連中からカネ巻き上げてさ\n顔面 撃たずにすまそうや"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352889
    m_Localized: "Scammer: えっ？\n考えなきゃ ならない話か？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352890
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352891
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352892
    m_Localized: "Scammer: わかったよ\n儲け話に乗り気じゃないなら\nしょうがないや\nでもさ マジで目の病気っぽいんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352893
    m_Localized: 'Scammer: 目薬とか あったらな…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352894
    m_Localized: "Scammer: 買うほどじゃないけどね\nオイラなりのワケがあんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352895
    m_Localized: "Scammer: 写真 撮りたいって？\nいいよいいよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352896
    m_Localized: "Scammer: オイラ 光過敏でさ\nビクつくかも"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352897
    m_Localized: 'Scammer: （写真を撮る）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352898
    m_Localized: 'Scammer: （写真は普通に見えるが 顔が…）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352899
    m_Localized: 'Scammer: （とんでもなくブレている）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352900
    m_Localized: 'Scammer: 言ったろ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352901
    m_Localized: 'Scammer: もう一枚 いっとくか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352902
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352903
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352904
    m_Localized: "Scammer: 騙すならオイラじゃなくてさ ニイさん\n他のカモに しときなって"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352905
    m_Localized: 'Scammer: 気を引き締めさせとかなきゃ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352906
    m_Localized: "Scammer: でなきゃ 気を緩めると\n誰のシマか忘れちまって\n払わなくなるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352907
    m_Localized: 'Scammer: 待て待て！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352908
    m_Localized: "Scammer: ニイさんも 家もクソくらえ\nもう出てく"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352909
    m_Localized: "Scammer: 太陽の下にでも立ってやるから\n良心の呵責に苛まれな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352910
    m_Localized: 'Scammer: クソッ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352911
    m_Localized: "Scammer: ニイさん\nズレたマネやってるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352912
    m_Localized: "Scammer: まあ ここじゃ\nニイさんがボスだけどさ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352913
    m_Localized: "Scammer: で どう？\n問題なし？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352914
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352915
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352916
    m_Localized: "Scammer: ちょっ 待てって！\nわかったよ チッ\n一度だけ剃ってみてから\n続けてるだけなんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352917
    m_Localized: "Scammer: 誰にも言わないでくれよ\nニイさん 口軽じゃないだろうね？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352918
    m_Localized: "Scammer: ちょっ 待てってば！\nそれじゃ パンツ見せろ\nってのと同じだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352919
    m_Localized: "Scammer: まあ 文明人なら \n脇が焼けてるはず ないしね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352920
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352921
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352922
    m_Localized: "Scammer: やっぱ ニイさんは\nわかる人だと 思ってたよ\n一般市民にマジで突っかかる\nワケがないもの"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352923
    m_Localized: "Scammer: あのボケどもに\n圧かけてかないかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352924
    m_Localized: "Scammer: ダメ？ま いっか\nまたな"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352925
    m_Localized: "Scammer: まあ あの来訪者どものせいで\nピリついてんのは わかるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352926
    m_Localized: 'Scammer: それも オイラたちを思ってなんだろ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352927
    m_Localized: "Scammer: とにかく 気にするこたないって\n間違いなし"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: なに見たいの？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: 歯
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: 目
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: 脇
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: 写真
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: 耳
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: "Daughter: 歯？\n歯を見せてほしいの？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: "Daughter: どうして？\nまだ乳歯だよ\nお父さんが言ってた…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: もう泣かない'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: ほら こんな感じ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: これで なにが わかるの？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: ぜんぶ 大丈夫？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: あたし もう一人でツメ 切れるんだよ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: まだ ちょっと ヘタだけど…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: 見て'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: キレイでしょ？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: "Daughter: 自分で 切ったんだ\n一人で やったんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: "Daughter: あたし あっち 行く\n一人に なりたい"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: 目の中って のぞけるの？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: "Daughter: あたしが考えてること\n見えちゃうの？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: "Daughter: じゃあ ちゃんとしてないと\n気にしないで"
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352953
    m_Localized: 'Daughter: なんで そんな顔してるの？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352954
    m_Localized: 'Daughter: みみっ 見えたんだ…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547072
    m_Localized: "Daughter: うっ…\nうわああああぁぁぁぁぁん"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: "Daughter: ののっ ノドが\nかっ 乾いた"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: なにすればいい？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: "Daughter: （少女を眺め これは\nやりすぎだと考え直す）"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: あたしが元気か 知りたかっただけ？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: "Daughter: すごく クタクタだよ\n一人に なっていい？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: 写真？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: あまり 撮ってもらったこと ないんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: 後で 見せて？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: （写真を撮る）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: （少しブレている）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: "Daughter: （撮り終わる前に\n駆け寄ってきたからだ）"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: ふうん'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: ありがと'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: "Daughter: いまいち\nもう写真はイヤ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: "NotTrue: ヘヘ\nほら ご覧よ 若いの\nいつもと 変わるもんかね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: 歯
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: 目
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: 脇
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: 写真
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: 耳
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: 歯かい？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NotTrue: ああぁぁぁ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: "NotTrue: ほらよ この歯…\nああ 昔からウンザリでねえ\nいっそ全部 引っこ抜いてやろうかと"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: "NotTrue: ご覧 この指\n数えることも 揃えることも\nちゃんと測ることも できないんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: "NotTrue: ちょうど きっかりしか\n与えられないもんさね\nちょうど 尽きない程度にね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: "NotTrue: ああ 若いの…\n本気で覗きたいのかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: "NotTrue: 目ってのはね 窓なんだ\n家には光 人には真実を\nもたらすんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: "NotTrue: けれど アタシのはホコリまみれさね…\nガラスは割れて… カーテンなんざ\nとうの昔 蛾に食われちまった…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: "NotTrue: 見ないでくれよ 若いの\nなにもありゃ しないんだから"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: "NotTrue: おやおや\n婆に腕を上げさせるなんてね…\n恥ずかしくないのかい？\n立ってるのも やっとなんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: "NotTrue: まあ しょうがないねえ\n家主には逆らえないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: どうだい？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: "NotTrue: なんだい？\nアタシなんかにフィルムを？\nどう見たって貴重品だよ… 本気かい？\nまあ 悪い気はしないけどね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: さあ どうだい 若いの？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: "NotTrue: ヘヘ\nなんて考えだい 若いの"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: "NotTrue: なんの変哲もない耳だよ\nいつもどおり 聞こえてるさね\nだがね 時折 アタシは もう\nこの世にいない心地だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: "NotTrue: まるで 天窓越しにしか\n見えないみたいにね\nそれだって\nいつもってワケじゃないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: "NotTrue: おやおや\nそんなもの突きつけて\nどうしたいんだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: "NotTrue: 歯なしの婆なんざ\n見るに耐えないってかい"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: "NotTrue: 怖がるとでも お思いかい？\nこの手で しがみつくとでも？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: "NotTrue: 何度も何度も\n宙を掴もうとしてきたよ\n指は知ってるのさ\nアタシじゃ なにも掴めやしないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: そう来るかい…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: "NotTrue: アタシを信じないのかい？\n確かめたいってのかい？\nなら ほら よくご覧"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: "NotTrue: アタシも昔は 人の目を見たもんだよ\n今じゃ ただの思い出さね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: "NotTrue: ほら 若いの こいつは年寄りの証だよ\n誰だって歳を重ねりゃ\nこういう贈り物があるんだ\n知らなかったのかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: "NotTrue: 水虫も痛かないし 飯 ねだりもしない\nただ存在するだけさね\n生きるために生きるだけなんだよ\nアタシみたいにね ヘヘ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: "NotTrue: おや 今度はシャッターじゃなくて\nアンタがキレるのかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: "NotTrue: どういうことだい 若いの？\n耳ぐらいで なにが\nわかるってんだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: "NotTrue: まあ 構いやしないよ むしろ歓迎さね\nアタシは構わないんだ 若いの\n長いこと ずっと\n神様に会いたかったんだから"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: ただ…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: "NotTrue: あの歯医者に大枚はたいて\nみんな抜こうとしたんだ\nけどね いっぺんじゃ無理だったのさ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: "NotTrue: 通って 一本か二本ずつ抜いたんだ…\n全部はできなかったけどね\n今時の医者は そんなヒマないとかで"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: "NotTrue: それで 若いの\nアタシは未完成品を\n口に付けたまま 生きてるのさ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: "NotTrue: 手ってもんは 握るためにあるもんさ\nアタシは ずいぶん前に\nやめちまったけどね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: "NotTrue: 手を出せってのかい？\nなんでさ？\nアンタが差し出せばいいじゃないか"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: "NotTrue: 「風に乗って飛んでいる\n下流へと漂い…」小屋へ着く\n若いの お入り"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: "NotTrue: 自分は こんな運命 避けられるとでも？\nまあ 若死に すれば別さね\nでもね 体に気をつけるんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: "NotTrue: 男前なんだからね\nそんな美貌 台無しにするなんざ\n罪ってもんさね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: "NotTrue: アタシの時代じゃ\nこんな機械 金持ちのもんだったよ\n今じゃ もう\n器用者なら みんな持っとる"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: "NotTrue: かける言葉もないよ\nバカばかりして\nいい人を無意味に困らせて…"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547160
    m_Localized: "Alkonost: どうか\n妹には手出ししないで"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547161
    m_Localized: 歯
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547162
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547163
    m_Localized: 目
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547164
    m_Localized: 脇
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547165
    m_Localized: 写真
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547166
    m_Localized: 耳
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547167
    m_Localized: "Alkonost: うちの家系\n昔から歯が丈夫なんです"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547168
    m_Localized: "Alkonost: 子供の頃\n歯でビールを開けようとして"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547169
    m_Localized: "Alkonost: 散々な結果でしたが\nそれで歯を大切にしようと思いました"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547170
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547171
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547172
    m_Localized: "Alkonost: 妹は今 自分の面倒も\n満足に見られないんです\nだから 私が手を動かすしかなくて"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547173
    m_Localized: "Alkonost: 二人分の命を同時に預かると\n人間の手って どうなるんでしょう？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547174
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547175
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547176
    m_Localized: "Alkonost: ええ 妹は泣き虫ですが\n私たちの目は瓜二つなんです\nただ あの子の目は少し\n達観しすぎてますが"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547177
    m_Localized: 'Alkonost: それが不安なんです'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547178
    m_Localized: "Alkonost: ええ 妹は泣き虫ですが\n私たちの目は瓜二つなんです\n赤くない ってことです"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547179
    m_Localized: "Alkonost: あの子 もう泣き尽くしたのかも\nしれませんね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547180
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547181
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547182
    m_Localized: "Alkonost: 見せます\nでも お願いだから\n妹には構わないでもらえませんか？\n疲れ切ってるんです"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547183
    m_Localized: "Alkonost: 普段は剃ってるんです\n健康に気を配るようにしてますから"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547184
    m_Localized: 'Alkonost: こんな狂った世の中でも'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547185
    m_Localized: "Alkonost: 普段は ちゃんとしてるんです\nでも カミソリ持ってなくて"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547186
    m_Localized: "Alkonost: そんなヒマも ないですから\nそもそも"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547187
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547188
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547189
    m_Localized: "Alkonost: 妹も私も\nずいぶんな目に遭って生きてきました\n銃なんて下ろしてください"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547190
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547191
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547192
    m_Localized: "Alkonost: 最近 喫煙を始めたんです\nあなたのような人がいるから"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547193
    m_Localized: 'Alkonost: 大変なのは自分だけだと思ってるの？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547194
    m_Localized: "Alkonost: 好き勝手\n銃を向けていいと思ってるの？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547195
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547196
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547197
    m_Localized: "Alkonost: なにがしたいの？\n目が速く動いてたり\n虚ろだったりした？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547198
    m_Localized: "Alkonost: なにがしたいの？\n目が虚ろだった？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547199
    m_Localized: 'Alkonost: あなたの目と なにが違うの？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547200
    m_Localized: "Alkonost: 落ち着いて 感情で動いちゃダメ\n妹に いつも そう言ってるんです"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547201
    m_Localized: "Alkonost: あなたにも言うハメになるなんて\n情けない"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547202
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547203
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547204
    m_Localized: "Alkonost: 待って そんな脇のことまで\nニュースは大真面目に\n来訪者の徴候だと？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547205
    m_Localized: "Alkonost: ちょっとは考えて\n馬鹿な真似はやめて"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547206
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547207
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547208
    m_Localized: "Alkonost: 私の人生譚\nこんな結末なんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547209
    m_Localized: 'Alkonost: 歯がゆい'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547210
    m_Localized: "Alkonost: 人生は いつだって\n私たちの力を試してきました\nなにもかも いつだって\n苦しかったです"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547211
    m_Localized: "Alkonost: 妹は耐えられませんでした\n諦めてしまったんです"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547212
    m_Localized: "Alkonost: やっと わかりました\nあなたも どうしようもない状況に\n追い込まれてるんですね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547213
    m_Localized: "Alkonost: でも 取り乱してしまったら\n来訪者と なにが違うの？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547214
    m_Localized: "Alkonost: 誰にも頼らず一人きりでいたら\nどうなってしまうの？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547215
    m_Localized: 'Alkonost: もう こんなのウンザリ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547216
    m_Localized: "Alkonost: 心底 ここで一息つきたいんです\n少しでも怯えずに いたいんです"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547217
    m_Localized: "Alkonost: でも なにも変わりません\n終わりなんて\nどこにも見えないままです"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547218
    m_Localized: "Alkonost: 正直に言えば\n私も怖くてたまりません"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547219
    m_Localized: "Alkonost: この先どうなるの？\n来訪者は消えるの？\nそれとも これから町を分け合って\n生きていくの？永遠に？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547220
    m_Localized: 'Sirin: さっさと してください'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547221
    m_Localized: 歯
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547222
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547223
    m_Localized: 目
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547224
    m_Localized: 脇
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547225
    m_Localized: 写真
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547226
    m_Localized: 耳
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547227
    m_Localized: 'Sirin: ほら'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547228
    m_Localized: 'Sirin: 抜きたいんですか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547229
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547230
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547231
    m_Localized: 'Sirin: 姉さんが助けてくれるんです'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547232
    m_Localized: 'Sirin: でも 無駄ですけどね'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547233
    m_Localized: 'Sirin: あのとき…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547234
    m_Localized: "Sirin: あのとき 死なせてくれれば\nよかったのに"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547235
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547236
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547237
    m_Localized: "Sirin: 姉さんと私\n目が そっくりなんです"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547238
    m_Localized: "Sirin: でも 姉さんの目は\n空っぽじゃありません"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547239
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547240
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547241
    m_Localized: "Sirin: 姉さんが脇を剃ってくれるんです\n一通り世話してもらってます"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547242
    m_Localized: "Sirin: 無駄じゃ なかったのかも\nしれませんね"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547243
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547244
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547245
    m_Localized: 'Sirin: そのほうがマシ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547246
    m_Localized: 'Sirin: 魂ごと 吹き飛ばして'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547247
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547248
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547249
    m_Localized: 'Sirin: そんな必要 ありませんよ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547250
    m_Localized: "Sirin: 死は すぐそこです\nいずれにせよ"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547251
    m_Localized: 'Sirin: 私に任せてくれて 大丈夫です'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547252
    m_Localized: 'Sirin: 銃を ください'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547253
    m_Localized: 'Sirin: 自分で やりますから'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547254
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547255
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547256
    m_Localized: "Sirin: 私の目を閉じても\n虚しさは消えません"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547257
    m_Localized: 'Sirin: あなたに移るだけ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547258
    m_Localized: 'Sirin: それが お望みですか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547259
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547260
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547261
    m_Localized: 'Sirin: どうしたんです？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547262
    m_Localized: 'Sirin: 非常ボタン 押すんですか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547263
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547264
    m_Localized: 話を聞く
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547265
    m_Localized: 'Sirin: 勇気が足りなかったんですか？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547266
    m_Localized: 'Sirin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547267
    m_Localized: 'Sirin: あなたも どうせ死ぬのに'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547268
    m_Localized: 'Sirin: 残念'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547269
    m_Localized: 'Sirin: また今度'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547270
    m_Localized: 'Sirin: 残念'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547271
    m_Localized: 'Sirin: 徴候ありませんから'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547272
    m_Localized: 'Sirin: また今度'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547273
    m_Localized: "Sirin: 私たち\nブラックホールに飲み込まれる\n準備をしてるのかもね？"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547274
    m_Localized: "Sirin: イベントホライズンに\nずっと吸い込まれ続けるの"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547275
    m_Localized: 'Sirin: 自分たちの終焉を見ることもなく'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547276
    m_Localized: "Sirin: 永遠の苦悶に\n死の予感"
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547277
    m_Localized: 'Sirin: 構いませんよ'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547278
    m_Localized: 'Sirin: 自分の番を待ちますから'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547279
    m_Localized: 'Sirin: 私の歌…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547280
    m_Localized: 'Sirin: あなたのため だったんだ！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547281
    m_Localized: 'Sirin: なんてハッピーエンド！'
    m_Metadata:
      m_Items: []
