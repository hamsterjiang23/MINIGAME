%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NotCharacterDialogs_ru
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: fdb5e7c1e1a06f94cb20bf63a5da666e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 7642873057280
    m_Localized: 'TV: Срочные новости!'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028800
    m_Localized: 'TV: Сегодня в 6:28 утра на солнце произошёл мощный выброс энергии.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028801
    m_Localized: 'TV: Данная вспышка оказалась больше, чем прогнозировали учёные.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028802
    m_Localized: 'TV: Температура на улице достигла критической отметки.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028803
    m_Localized: 'TV: Власти объявили режим чрезвычайной ситуации.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028804
    m_Localized: 'TV: Мы просим всех граждан избегать выхода на улицу в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028805
    m_Localized: 'TV: Теперь переходим к…'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028806
    m_Localized: 'TV: Минутку…'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028807
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028808
    m_Localized: 'TV: В нашу студию только что поступило срочное сообщение о контактах с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028809
    m_Localized: 'TV: Очевидцы описывают их как существ, имитирующих внешний облик и поведение человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028810
    m_Localized: 'TV: Просим вас избегать контактов с Гостями. Из одного случая удалось выявить признак этих существ…'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028811
    m_Localized: 'TV: Это идеальные белые зубы.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028812
    m_Localized: 'TV: Показательным случаем можно считать произошедшее с одним из очевидцев.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028813
    m_Localized: 'TV: Он наткнулся на бездомного с идеальными белыми зубами, который оказался Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028814
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не выходите из дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028815
    m_Localized: 'TV: Далее прогноз погоды.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028816
    m_Localized: 'TV: Добрый день, в эфире прогноз погоды.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028817
    m_Localized: 'TV: В нашем регионе наступает жара, побившая прежний рекорд среднесуточной температуры.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028818
    m_Localized: 'TV: Как сообщают метеорологи, ожидается ещё большее повышение температуры.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028819
    m_Localized: 'TV: Кроме того, с повышением активности солнца днём ожидается усиление ультрафиолетового излучения.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028820
    m_Localized: 'TV: Для вашей же безопасности просим воздержаться от загара.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028821
    m_Localized: 'TV: Из-за высоких температур вы можете получить солнечный удар.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028822
    m_Localized: 'TV: Точно не известно, как пребывание под солнцем может отразиться на здоровье человека…'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028823
    m_Localized: 'TV: Но во избежание ожогов третьей степени не выходите на улицу.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028824
    m_Localized: 'TV: Солнезащитный крем, к сожалению, тут не поможет.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028825
    m_Localized: 'TV: На этом всё. Далее вы увидите развлекательную передачу.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028826
    m_Localized: 'TV: Вы видите грациозно танцующих балерин, пересекающих сцену сильными, но грациозными прыжками.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028827
    m_Localized: 'TV: Танец по телевизору, несмотря на изящество, навевает вам тревожные мысли.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028828
    m_Localized: 'TV: Вам кажется, будто вас пытаются отвлечь от происходящих событий.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028829
    m_Localized: 'TV: Мог бы хоть кто-то объяснить, что происходит на самом деле…'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028830
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028831
    m_Localized: 'TV: Активность солнца не снижается, а уровень преступности незначительно вырос.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028832
    m_Localized: 'TV: По последним данным, число убийств за последнюю ночь превысило среднесуточные показатели.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028833
    m_Localized: 'TV: Эксперты полагают, что это связано с появлением Гостей и ростом тревоги в обществе.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028834
    m_Localized: 'TV: А теперь к новым сведениям – очевидцы выявили новый признак Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028835
    m_Localized: 'TV: Грязь под ногтями.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028836
    m_Localized: 'TV: По данным специалистов, этот признак помогает выявить Гостей, которые вылезают из земли.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028837
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028838
    m_Localized: 'TV: Далее репортаж про бледного маньяка. Но сперва реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028839
    m_Localized: 'TV: Сейчас вы ходите за продуктами так: Топ-топ-топ.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028840
    m_Localized: 'TV: А теперь будете ходит так: Алло, хочу заказать еду.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028841
    m_Localized: 'TV: Доставка продуктов Фор Рест. Звоните по номеру: Х-ХХ-ХХХ и еда придёт к вам уже следующим вечером.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028842
    m_Localized: 'TV: Фор Рест: Вкусный отдых у вас дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028843
    m_Localized: 'TV: На улицах города появился бледный маньяк.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028844
    m_Localized: 'TV: Из показаний очевидцев удалось выяснить, что его жертв объединяет одно – все были одинокими людьми.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028845
    m_Localized: 'TV: При этом, прежде чем совершить убийство, маньяк общается с жертвой, после чего нападает.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028846
    m_Localized: 'TV: Из показаний очевидцев удалось составить фоторобот подозреваемого.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028847
    m_Localized: 'TV: Это высокий бледный мужчина среднего возраста с чёрными волосами. На нём только штаны, выше пояса одежды нет. Худощавого телосложения.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028848
    m_Localized: 'TV: Некоторые сообщают, что на его тело надета кожа другого человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028849
    m_Localized: 'TV: Подтверждения этой информации нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028850
    m_Localized: 'TV: Если увидите это лицо, не открывайте ему  дверь и говорите, что вы не один в доме.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028851
    m_Localized: 'TV: На этом всё.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028852
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028853
    m_Localized: 'TV: Аномальная жара продолжает усиливаться, а нашествие Гостей не прекращается.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028854
    m_Localized: 'TV: Для решения возникшей ситуации правительство организовало специальную службу…'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028855
    m_Localized: 'TV: Комитет по Чрезвычайным Ситуациям, сокращённо – КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028856
    m_Localized: 'TV: Её сотрудников можно узнать по жёлтым костюмам химической защиты и противогазам.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028857
    m_Localized: 'TV: Несмотря на недавнее начало работы, комитет уже выявил новый признак Гостей…'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028858
    m_Localized: 'TV: Кроваво-красные глаза.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028859
    m_Localized: 'TV: По нашим данным, КЧС выявили этот признак в результате обследования задержанных Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028860
    m_Localized: 'TV: Существа получают травмы глаза, так как глаза существ воспаляются и краснеют из-за повышенной чувствительности к свету.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028861
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028862
    m_Localized: 'TV: Далее репортаж про КЧС. Но сперва небольшая реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028863
    m_Localized: 'TV: Смятение, страх и горе. И всему виной Гости…'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028864
    m_Localized: 'TV: Но в час нужды, когда слёз пролиты реки…'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028865
    m_Localized: 'TV: НА ПОМОЩЬ ПРИДУТ ОНИ! СОТРУДНИКИ КЧС!'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028866
    m_Localized: 'TV: Отважные герои из Комитета по Чрезвычайным Ситуациям защитят нас от нашествия Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028867
    m_Localized: 'TV: Уже сегодня комитет выявил 27 000 опасных существ.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028868
    m_Localized: 'TV: Помните, вы можете помочь комитету, сообщая о подозрительном поведении окружающих.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028869
    m_Localized: 'TV: Для этого используйте приглашение на посещение КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028870
    m_Localized: 'TV: И если у вас возникнут сомнения, не Гость ли вы, звоните по горячей линии: Х-ХХ-ХХХ.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028871
    m_Localized: 'TV: Помогая КЧС, вы помогаете в борьбе с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028872
    m_Localized: 'TV: КЧС? Что за организация? И для чего её сформировали?'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028873
    m_Localized: 'TV: Комитет по Чрезвычайным Ситуациям – недавно сформированная специальная служба, созданная для ослабления возникшего кризиса.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028874
    m_Localized: 'TV: Они помогут решить проблему с нашествием Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028875
    m_Localized: 'TV: Точно неизвестно, что именно предпримет комитет…'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028876
    m_Localized: 'TV: Но можно с уверенностью сказать, что наша судьба в надёжных руках…'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028877
    m_Localized: 'TV: Поскольку комитет состоит из экспертов разных областей, включая заслуженных учёных.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028878
    m_Localized: 'TV: Если к вам на порог придёт сотрудник КЧС, рекомендуем содействовать ему и следовать указаниям.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028879
    m_Localized: 'TV: Помните, что помогая КЧС, вы помогаете в борьбе с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028880
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028881
    m_Localized: 'TV: КЧС принял новые меры для разрешения ситуации с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028882
    m_Localized: 'TV: Организованы карантинные зоны для людей с потенциально-опасным статусом.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028883
    m_Localized: 'TV: Также КЧС выявил новый признак Гостя в результате экспериментов с задержанными…'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028884
    m_Localized: 'TV: Подмышки без волос.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028885
    m_Localized: 'TV: Как сообщает КЧС, признак связан с тем, что у Гостей нет волосяного покрова в этом месте.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028886
    m_Localized: 'TV: Комитет просит граждан отнестись с пониманием к проверкам и сопровождением в карантинные зоны.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028887
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028888
    m_Localized: 'TV: Далее репортаж про КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028889
    m_Localized: 'TV: У КЧС есть предположение, что феномен Гостей имеет инфекционную природу или другую биологическую угрозу.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028890
    m_Localized: 'TV: Поэтому необходимо докладывать о подозрительных людях и изолировать их.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028891
    m_Localized: 'TV: Если у вас нет возможности сдать Гостя в карантинную зону сразу, выдайте ему специальное требование о явке в КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028892
    m_Localized: 'TV: При следующем обходе сотрудник заберёт человека с этой бумагой на обследование.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028893
    m_Localized: 'TV: На этом всё. А теперь реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028894
    m_Localized: 'TV: Жара на улице не помеха.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028895
    m_Localized: 'TV: Когда в руках есть Энержека.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028896
    m_Localized: 'TV: Освежающий энергетик, утоляющий жажду быстрее и эффективнее воды.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028897
    m_Localized: 'TV: Теперь и в ассортименте доставки Фор Рест. Закажите еду по номеру: Х-ХХ-ХХХ.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028898
    m_Localized: 'Window: В чистом поле стоит дом вашего соседа.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028899
    m_Localized: 'Window: В окнах темно, и похоже, его семья сейчас спит.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028900
    m_Localized: 'Window: На тропинке, что идёт сквозь сквозь поля, стоит худая дворняга.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028901
    m_Localized: 'Window: Она жалобно смотрит по сторонам в попытке найти какую-нибудь еду.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028902
    m_Localized: 'Window: На улице валяются несколько сильно выпивших пьянчуг.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028903
    m_Localized: 'Window: Несмотря на то, что они лежат на холодной земле, кажется, синяки крепко спят. Им сейчас хорошо.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028904
    m_Localized: 'Window: Вдалеке стоит дом соседа, что сейчас гостит у вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028905
    m_Localized: 'Window: В окнах горит свет, и кажется, семья ждёт, пока он уйдёт от вас обратно домой.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028906
    m_Localized: 'Window: Вы видите, как за окном у поля проводят время несколько подростков.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028907
    m_Localized: 'Window: Они беззаботно сидят и о чём-то болтают, не обращая на вас внимания.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028908
    m_Localized: 'Window: На улице гробовая тишина.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028909
    m_Localized: 'Window: Никого нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028910
    m_Localized: 'Window: Даже пьяницы решили не появляться на улице.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028911
    m_Localized: 'Window: Они кого-то боятся?'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028912
    m_Localized: 'Window: За окном стоит сосед и его дочка.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028913
    m_Localized: 'Window: Они весело играют, пытаясь забыть о происходящем ужасе…'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028914
    m_Localized: 'Window: Хотя бы на миг.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028915
    m_Localized: 'Window: На земле лежат тела подростков.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028916
    m_Localized: 'Window: Кто-то убил их.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028917
    m_Localized: 'Window: Кажется, совсем недавно, ведь кровь ещё не успела засохнуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028918
    m_Localized: 'Window: На тропе стоит бледный, как сама смерть, человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028919
    m_Localized: 'Window: На его коже странные складки.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028920
    m_Localized: 'Window: Кажется, эта кожа ему не по размеру.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028921
    m_Localized: 'Window: Отсюда не видно его глаз, но чувствуется, как он сверлит вас своим взглядом.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028922
    m_Localized: 'Window: Вы ощущаете страх и молите бога, чтобы жуткий Гость обошёл дом стороной.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028923
    m_Localized: 'Window: У соседского дома стоит небольшая группа сотрудников КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028924
    m_Localized: 'Window: Интересно, о чём они разговаривают?'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028925
    m_Localized: 'Window: Может, они берут образцы почвы?'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028926
    m_Localized: 'Window: Или ищут место для развёртывания базы?'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028927
    m_Localized: 'Window: На земле лежат сгоревшие дотла тела подростков.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028928
    m_Localized: 'Window: Кажется, они пролежали здесь весь день.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028929
    m_Localized: 'Window: Двое сотрудников КЧС стоят рядом с телами и что-то записывают.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028930
    m_Localized: 'Window: Хорошо, что появились те, кто могут убрать тела.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028931
    m_Localized: 'Window: Страшно представить, какая зараза может появиться, если гниющие тела не будут убирать с улиц.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028932
    m_Localized: 'Window: За окном стоит группа вооружённых солдат.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028933
    m_Localized: 'Window: Видимо, это небольшой отряд, высланный сюда из города для обеспечения безопасности КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028934
    m_Localized: 'Window: До вас долетают лишь обрывки фраз про бледного мужчину с голым торсом.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028935
    m_Localized: 'Window: Может, они хотят выследить того жуткого Гостя?'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028936
    m_Localized: 'Window: Соседский дом, что недавно покрасили в белое, сгорел дотла и теперь абсолютно чёрный.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028937
    m_Localized: 'Window: Похоже, пожар утих совсем недавно.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028938
    m_Localized: 'Window: Неужели, кто-то поджёг его намеренно?'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028939
    m_Localized: 'Window: Что произошло с соседской семьёй?'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028940
    m_Localized: 'Window: Выжил ли кто-нибудь?'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028941
    m_Localized: 'Window: Вашу голову переполнили тревожные мысли и вас охватило чувство непонимания и беспомощности.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028942
    m_Localized: 'Window: Бледный жуткий мужчина стоит на дороге и улыбается.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028943
    m_Localized: 'Window: У него в руке чья-то оторванная голова в каске.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028944
    m_Localized: 'Window: Это голова солдата с застывшей на лице гримасой ужаса.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028945
    m_Localized: 'Window: Интересно, чего он больше испугался: бледного гостя, или неминуемой кончины?'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028946
    m_Localized: 'Window: Весь отряд солдат, который был здесь вчера, мёртв.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028947
    m_Localized: 'Window: Здесь была настоящая бойня.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028948
    m_Localized: 'Window: Тела разбросаны по всей улице, и у одного из тел отсутствует голова.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028949
    m_Localized: 'Window: Неужели их всех убил тот бледный жутки незнакомец?'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028950
    m_Localized: 'Radio: — Алло, это диспетчер службы спасения. Чем вам помочь? — Люди… они горят.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028951
    m_Localized: 'Radio: — Опишите что вы видите? Пожар? — Нет, это солнце. Они… они сгорают на солнце.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028952
    m_Localized: 'Radio: — Не выходите из дома до того, как стемнеет. — Нет, ночью ходит он. Тощий бледный… это не человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028953
    m_Localized: 'Radio: А сейчас в эфире наша новая передача “Да, я человек”.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028954
    m_Localized: 'Radio: Цель проста: вы присылаете ваши фотографии, а мы смотрим, кто же вы на самом деле.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028955
    m_Localized: 'Radio: Присылайте на нашу почту свои фотографии и узнайте же, кто вы.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028956
    m_Localized: 'Radio: Но, пожалуйста, не шлите ничего, кроме глаз, зубов и ногтей. Ничего другого мы не принимаем.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028957
    m_Localized: 'Radio: У вас покраснели глаза? Побелели зубы? Под ногтями появилась грязь?'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028958
    m_Localized: 'Radio: В вас вселился злой дух: Гостевой!'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028959
    m_Localized: 'Radio: Не позвольте этой гнили завладеть вашим телом! Срочно звоните нашим экспертам: Х-ХХ-ХХХ.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028960
    m_Localized: 'Radio: Они прогонят злой дух, очистят ваше тело от пагубной ауры и установят вам семь степеней защиты.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028961
    m_Localized: 'Radio: Добрый день, дорогие слушатели. В эфире передача “Я хочу верить”. Здесь мы раскрываем тайны и заговоры правительства.'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028962
    m_Localized: 'Radio: Сегодня мы расскажем всю правду про Гостей. А в гостях у нас уважаемый сотрудник НИИ, доктор наук…'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028963
    m_Localized: 'Radio: Погодите, что!? Он не придёт?'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028964
    m_Localized: 'Radio: Как это у него украли все документы? Там же КИЛОТОННЫ ИНФОРМАЦИИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 7642894028965
    m_Localized: 'Radio: Проклятье, я знал, что нам не позволят вещать правду. Мать их…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953783779328
    m_Localized: 'TV: Срочные новости!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556544
    m_Localized: 'TV: Сегодня в 6:28 утра на солнце произошёл мощный выброс энергии.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556545
    m_Localized: 'TV: Данная вспышка оказалась больше, чем прогнозировали учёные.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556546
    m_Localized: 'TV: Температура на улице достигла критической отметки.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556547
    m_Localized: 'TV: Власти объявили режим чрезвычайной ситуации.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556548
    m_Localized: 'TV: Мы просим всех граждан избегать выхода на улицу в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556549
    m_Localized: 'TV: Теперь переходим к…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556550
    m_Localized: 'TV: Минутку…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556551
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556552
    m_Localized: 'TV: В нашу студию только что поступило срочное сообщение о контактах с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556553
    m_Localized: 'TV: Очевидцы описывают их как существ, имитирующих внешний облик и поведение человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556554
    m_Localized: 'TV: Просим вас избегать контактов с Гостями. Из одного случая удалось выявить признак этих существ…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556555
    m_Localized: 'TV: Это идеальные белые зубы.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556556
    m_Localized: 'TV: Показательным случаем можно считать произошедшее с одним из очевидцев.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556557
    m_Localized: 'TV: Он наткнулся на бездомного с идеальными белыми зубами, который оказался Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556558
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556559
    m_Localized: 'TV: Далее вы увидите развлекательную передачу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556560
    m_Localized: 'TV: Добрый день, в эфире прогноз погоды.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556561
    m_Localized: 'TV: В нашем регионе наступает жара, побившая прежний рекорд среднесуточной температуры.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556562
    m_Localized: 'TV: Как сообщают метеорологи, ожидается ещё большее повышение температуры.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556563
    m_Localized: 'TV: Кроме того, с повышением активности солнца днём ожидается усиление ультрафиолетового излучения.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556564
    m_Localized: 'TV: Для вашей же безопасности просим воздержаться от загара.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556565
    m_Localized: 'TV: Из-за высоких температур вы можете получить солнечный удар.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556566
    m_Localized: 'TV: Точно не известно, как пребывание под солнцем может отразиться на здоровье человека…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556567
    m_Localized: 'TV: Но во избежание ожогов третьей степени не выходите на улицу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556568
    m_Localized: 'TV: Солнезащитный крем, к сожалению, тут не поможет.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556569
    m_Localized: 'TV: На этом всё. Далее вы увидите развлекательную передачу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556570
    m_Localized: 'TV: Вы видите грациозно танцующих балерин, пересекающих сцену сильными, но грациозными прыжками.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556571
    m_Localized: 'TV: Танец по телевизору, несмотря на изящество, навевает вам тревожные мысли.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556572
    m_Localized: 'TV: Вам кажется, будто вас пытаются отвлечь от происходящих событий.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556573
    m_Localized: 'TV: Мог бы хоть кто-то объяснить, что происходит на самом деле…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556574
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556575
    m_Localized: 'TV: Активность солнца не снижается, а уровень преступности незначительно вырос.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556576
    m_Localized: 'TV: По последним данным, число убийств за последнюю ночь превысило среднесуточные показатели.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556577
    m_Localized: 'TV: Эксперты полагают, что это связано с появлением Гостей и ростом тревоги в обществе.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556578
    m_Localized: 'TV: А теперь к новым сведениям – очевидцы выявили новый признак Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556579
    m_Localized: 'TV: Грязь под ногтями.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556580
    m_Localized: 'TV: По данным специалистов, этот признак помогает выявить Гостей, которые вылезают из земли.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556581
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556582
    m_Localized: 'TV: Далее репортаж про бледного маньяка. Но сперва реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556583
    m_Localized: 'TV: Сейчас вы ходите за продуктами так: Топ-топ-топ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556584
    m_Localized: 'TV: А теперь будете ходит так: Алло, хочу заказать еду.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556585
    m_Localized: 'TV: Доставка продуктов Фор Рест. Звоните по номеру: Х-ХХ-ХХХ и еда придёт к вам уже следующим вечером.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556586
    m_Localized: 'TV: For Rest: Вкусный отдых у вас дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556587
    m_Localized: 'TV: На улицах города появился бледный маньяк.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556588
    m_Localized: 'TV: Из показаний очевидцев удалось выяснить, что его жертв объединяет одно – все были одинокими людьми.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556589
    m_Localized: 'TV: При этом, прежде чем совершить убийство, маньяк общается с жертвой, после чего нападает.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556590
    m_Localized: 'TV: Из показаний очевидцев удалось составить фоторобот подозреваемого.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556591
    m_Localized: 'TV: Это высокий бледный мужчина среднего возраста с чёрными волосами. На нём только штаны, выше пояса одежды нет. Худощавого телосложения.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556592
    m_Localized: 'TV: Некоторые сообщают, что на его тело надета кожа другого человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556593
    m_Localized: 'TV: Подтверждения этой информации нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556594
    m_Localized: 'TV: Если увидите это лицо, не открывайте ему  дверь и говорите, что вы не один в доме.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556595
    m_Localized: 'TV: На этом всё.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556596
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556597
    m_Localized: 'TV: Аномальная жара продолжает усиливаться, а нашествие Гостей не прекращается.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750848
    m_Localized: 'TV: Для решения возникшей ситуации правительство организовало специальную службу…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750849
    m_Localized: 'TV: Комитет по Чрезвычайным Ситуациям, сокращённо – КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750850
    m_Localized: 'TV: Её сотрудников можно узнать по жёлтым костюмам химической защиты и противогазам.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750851
    m_Localized: 'TV: Несмотря на недавнее начало работы, комитет уже выявил новый признак Гостей…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750852
    m_Localized: 'TV: Кроваво-красные глаза.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750853
    m_Localized: 'TV: По нашим данным, КЧС выявили этот признак в результате обследования задержанных Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750854
    m_Localized: 'TV: Существа получают травмы глаза, вследствие которых у них появляется воспаление, краснота и повышенная чувствительность к свету.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750855
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750856
    m_Localized: 'TV: Далее репортаж про КЧС. Но сперва небольшая реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750857
    m_Localized: 'TV: Смятение, страх и горе. И всему виной Гости…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750858
    m_Localized: 'TV: Но в час нужды, когда слёз пролиты реки…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750859
    m_Localized: 'TV: НА ПОМОЩЬ ПРИДУТ ОНИ! СОТРУДНИКИ КЧС!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750860
    m_Localized: 'TV: Отважные герои из Комитета по Чрезвычайным Ситуациям защитят нас от нашествия Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750861
    m_Localized: 'TV: Уже сегодня комитет выявил 27 000 опасных существ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750862
    m_Localized: 'TV: Помните, вы можете помочь комитету, сообщая о подозрительном поведении окружающих.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750863
    m_Localized: 'TV: Для этого используйте приглашение на посещение КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750864
    m_Localized: 'TV: И если у вас возникнут сомнения, не Гость ли вы, звоните по горячей линии: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750865
    m_Localized: 'TV: Помогая КЧС, вы помогаете в борьбе с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750866
    m_Localized: 'TV: КЧС? Что за организация? И для чего её сформировали?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750867
    m_Localized: 'TV: Комитет по Чрезвычайным Ситуациям – недавно сформированная специальная служба, созданная для ослабления возникшего кризиса.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750868
    m_Localized: 'TV: Они помогут решить проблему с нашествием Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750869
    m_Localized: 'TV: Точно неизвестно, что именно предпримет комитет…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750870
    m_Localized: 'TV: Но можно с уверенностью сказать, что наша судьба в надёжных руках…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750871
    m_Localized: 'TV: Поскольку комитет состоит из экспертов разных областей, включая заслуженных учёных.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750872
    m_Localized: 'TV: Если к вам на порог придёт сотрудник КЧС, рекомендуем содействовать ему и следовать указаниям.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750873
    m_Localized: 'TV: Помните, что помогая КЧС, вы помогаете в борьбе с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750874
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750875
    m_Localized: 'TV: КЧС принял новые меры для разрешения ситуации с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750876
    m_Localized: 'TV: Организованы карантинные зоны для людей с потенциально опасным статусом.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750877
    m_Localized: 'TV: Также КЧС выявил новый признак Гостя в результате экспериментов с задержанными…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750878
    m_Localized: 'TV: Подмышки без волос.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750879
    m_Localized: 'TV: Как сообщает КЧС, признак связан с тем, что у Гостей нет волосяного покрова в этом месте.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750880
    m_Localized: 'TV: Комитет просит граждан отнестись с пониманием к проверкам и сопровождениям в карантинные зоны.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750881
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750882
    m_Localized: 'TV: Далее репортаж о том, что делать если вы обнаружили Гостя.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750883
    m_Localized: 'TV: У КЧС есть предположение, что феномен Гостей имеет инфекционную природу или другую биологическую угрозу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750884
    m_Localized: 'TV: Поэтому необходимо докладывать о подозрительных людях и изолировать их.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750885
    m_Localized: 'TV: Если у вас нет возможности сдать Гостя в карантинную зону сразу, выдайте ему специальное требование о явке в КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750886
    m_Localized: 'TV: При следующем обходе сотрудник заберёт человека с этой бумагой на обследование.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750887
    m_Localized: 'TV: На этом всё. А теперь реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750888
    m_Localized: 'TV: Жара на улице не помеха.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750889
    m_Localized: 'TV: Когда в руках есть Энержека.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750890
    m_Localized: 'TV: Освежающий энергетик, утоляющий жажду быстрее и эффективнее воды.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750891
    m_Localized: 'TV: Теперь и в ассортименте доставки Фор Рест. Закажите еду по номеру: Х-ХХ-ХХХ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750892
    m_Localized: 'Window: В чистом поле стоит дом вашего соседа.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750893
    m_Localized: 'Window: В окнах темно, и похоже, его семья сейчас спит.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750894
    m_Localized: 'Window: На тропинке, что идёт сквозь сквозь поля, стоит худая дворняга.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750895
    m_Localized: 'Window: Она жалобно смотрит по сторонам в попытке найти какую-нибудь еду.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750896
    m_Localized: 'Window: На улице валяются несколько сильно выпивших пьянчуг.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750897
    m_Localized: 'Window: Несмотря на то, что они лежат на холодной земле, кажется, синяки крепко спят. Им сейчас хорошо.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750898
    m_Localized: 'Window: Вдалеке стоит дом соседа, что сейчас гостит у вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750899
    m_Localized: 'Window: В окнах горит свет, и кажется, семья ждёт, пока он уйдёт от вас обратно домой.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750900
    m_Localized: 'Window: Вы видите, как за окном у поля проводят время несколько подростков.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750901
    m_Localized: 'Window: Они беззаботно сидят и о чём-то болтают, не обращая на вас внимания.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750902
    m_Localized: 'Window: На улице гробовая тишина.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750903
    m_Localized: 'Window: Никого нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750904
    m_Localized: 'Window: Даже пьяницы решили не появляться на улице.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750905
    m_Localized: 'Window: Они кого-то боятся?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750906
    m_Localized: 'Window: За окном стоит сосед и его дочка.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750907
    m_Localized: 'Window: Они весело играют, пытаясь забыть о происходящем ужасе…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750908
    m_Localized: 'Window: Хотя бы на миг.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750909
    m_Localized: 'Window: На земле лежат тела подростков.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750910
    m_Localized: 'Window: Кто-то убил их.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750911
    m_Localized: 'Window: Кажется, совсем недавно, ведь кровь ещё не успела засохнуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750912
    m_Localized: 'Window: На тропе стоит бледный, как сама смерть, человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750913
    m_Localized: 'Window: На его коже странные складки.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750914
    m_Localized: 'Window: Кажется, эта кожа ему не по размеру.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750915
    m_Localized: 'Window: Отсюда не видно его глаз, но чувствуется, как он сверлит вас своим взглядом.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750916
    m_Localized: 'Window: Вы ощущаете страх и молите бога, чтобы жуткий Гость обошёл дом стороной.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750917
    m_Localized: 'Window: У соседского дома стоит небольшая группа сотрудников КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750918
    m_Localized: 'Window: Интересно, о чём они разговаривают?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750919
    m_Localized: 'Window: Может, они берут образцы почвы?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750920
    m_Localized: 'Window: Или ищут место для развёртывания базы?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750921
    m_Localized: 'Window: На земле лежат сгоревшие дотла тела подростков.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750922
    m_Localized: 'Window: Кажется, они пролежали здесь весь день.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750923
    m_Localized: 'Window: Двое сотрудников КЧС стоят рядом с телами и что-то записывают.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750924
    m_Localized: 'Window: Хорошо, что появились те, кто может убрать тела.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750925
    m_Localized: 'Window: Страшно представить, какая зараза может появиться, если гниющие тела не будут убирать с улиц.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750926
    m_Localized: 'Window: За окном стоит группа вооружённых солдат.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750927
    m_Localized: 'Window: Видимо, это небольшой отряд, высланный сюда из города для обеспечения безопасности КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750928
    m_Localized: 'Window: До вас долетают лишь обрывки фраз про бледного мужчину с голым торсом.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750929
    m_Localized: 'Window: Может, они хотят выследить того жуткого Гостя?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750930
    m_Localized: 'Window: Соседский дом, что недавно покрасили в белое, сгорел дотла и теперь абсолютно чёрный.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750931
    m_Localized: 'Window: Похоже, пожар утих совсем недавно.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750932
    m_Localized: 'Window: Неужели, кто-то поджёг его намеренно?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750933
    m_Localized: 'Window: Что произошло с соседской семьёй?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750934
    m_Localized: 'Window: Выжил ли кто-нибудь?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750935
    m_Localized: 'Window: Вашу голову переполнили тревожные мысли и вас охватило чувство непонимания и беспомощности.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750936
    m_Localized: 'Window: Бледный жуткий мужчина стоит на дороге и улыбается.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750937
    m_Localized: 'Window: У него в руке чья-то оторванная голова в каске.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750938
    m_Localized: 'Window: Это голова солдата с застывшей на лице гримасой ужаса.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750939
    m_Localized: 'Window: Интересно, чего он больше испугался: бледного Гостя или неминуемой кончины?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750940
    m_Localized: 'Window: Весь отряд солдат, который был здесь вчера, мёртв.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750941
    m_Localized: 'Window: Здесь была настоящая бойня.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750942
    m_Localized: 'Window: Тела разбросаны по всей улице, и у одного из тел отсутствует голова.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750943
    m_Localized: 'Window: Неужели их всех убил тот бледный жутки незнакомец?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750944
    m_Localized: — Алло, это диспетчер службы спасения. Чем вам помочь? — Люди… они горят.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750945
    m_Localized: — Опишите, что вы видите? Пожар? — Нет, это солнце. Они… они сгорают на солнце.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750946
    m_Localized: — Не выходите из дома до того, как стемнеет. — Нет, ночью ходит он. Тощий и бледный… это не человек.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750947
    m_Localized: А сейчас в эфире наша новая передача “Да, я человек”.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750948
    m_Localized: 'Цель проста: вы присылаете ваши фотографии, а мы смотрим, кто же вы на самом деле.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750949
    m_Localized: 'Присылайте на нашу почту: yesiam@humanverification.agency свои фотографии и узнайте же, кто вы.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750950
    m_Localized: Но, пожалуйста, не шлите ничего, кроме глаз, зубов и ногтей. Ничего другого мы не принимаем.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750951
    m_Localized: У вас покраснели глаза? Побелели зубы? Под ногтями появилась грязь?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750952
    m_Localized: 'В вас вселился злой дух: Гостевой!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750953
    m_Localized: 'Не позвольте этой гнили завладеть вашим телом! Срочно звоните нашим экспертам: 777-460.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750954
    m_Localized: Они прогонят злой дух, очистят ваше тело от пагубной ауры и установят вам семь степеней защиты.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750955
    m_Localized: Добрый день, дорогие слушатели. В эфире передача “Я хочу верить”. Здесь мы раскрываем тайны и заговоры правительства.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750956
    m_Localized: Сегодня мы расскажем всю правду про Гостей. А в гостях у нас уважаемый сотрудник НИИ, доктор наук…
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750957
    m_Localized: Погодите, что!? Он не придёт?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750958
    m_Localized: Как это у него украли все документы? Там же КИЛОТОННЫ ИНФОРМАЦИИ!
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750959
    m_Localized: Проклятье, я знал, что нам не позволят вещать правду. Мать их…
    m_Metadata:
      m_Items: []
  - m_Id: 17738415503822848
    m_Localized: 'TV: Давным-давно два брата жили неподалёку от плотины.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182976
    m_Localized: 'TV: Льющаяся вода навевала мысли о холодных пенных напитках…'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182977
    m_Localized: 'TV: И когда два брата выросли, вместе основали пивоварню Бобер.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182978
    m_Localized: 'TV: А пиво “Бобер черни” стало одним из самых желанных алкогольных напитков на полках магазина и в барах.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182979
    m_Localized: 'TV: Пиво “Бобер черни”: Пейте много, пейте вкусно.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182980
    m_Localized: 'Window: Вы смотрите на руины соседского дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182981
    m_Localized: 'Window: От него остался лишь призрачный силуэт, хотя только недавно здесь жила вполне счастливая семья…'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182982
    m_Localized: 'Window: Странное чувство охватывает вас, словно вы знали, что это произойдёт…'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182983
    m_Localized: 'Window: Будто… вы чувствовали, что смерть заглянет в этот дом совсем скоро.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182984
    m_Localized: 'Window: Вы видите кол, на который насажен череп в каске.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182985
    m_Localized: 'Window: На черепе осталось немного чёрной обгоревшей кожи, а зубы, похоже, кто-то вырвал.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182986
    m_Localized: 'Window: Голова простояла здесь весь день.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182987
    m_Localized: 'Window: Вся эта мрачная экспозиция выглядит как угроза. Наверняка, оставленная тем жутким бледным Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182988
    m_Localized: 'Window: Сотрудники КЧС осматривают место недавней бойни.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182989
    m_Localized: 'Window: Они забирают всё снаряжение и оружие у мёртвых солдат, чтобы оно не досталось мародёрам.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182990
    m_Localized: 'Window: Наверное, рассчитывали, что бледный гость не переживёт стычку с толпой вооружённых людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182991
    m_Localized: 'Window: Теперь мешков с трупами на пару больше.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576140324864
    m_Localized: 'TV: Добрый день, в эфире прогноз погоды.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102080
    m_Localized: 'TV: В нашем регионе наступает жара, побившая прежний рекорд среднесуточной температуры.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102081
    m_Localized: 'TV: Как сообщают метеорологи, температура будет только расти.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102082
    m_Localized: 'TV: Кроме того, с повышением активности солнца днём ожидается усиление ультрафиолетового излучения.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102083
    m_Localized: 'TV: Для вашей же безопасности просим воздержаться от загара.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102084
    m_Localized: 'TV: Из-за высоких температур вы можете получить солнечный удар.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102085
    m_Localized: 'TV: Точно не известно, как пребывание под солнцем может отразиться на здоровье человека…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102086
    m_Localized: 'TV: Но, во избежание ожогов третьей степени, не выходите на улицу.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102087
    m_Localized: 'TV: Солнцезащитный крем, к сожалению, тут не поможет.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102088
    m_Localized: 'TV: Далее прогноз погоды. Но сперва реклама'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102089
    m_Localized: 'TV: Вы видите элегантно танцующих балерин, пересекающих сцену сильными, но грациозными прыжками.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102090
    m_Localized: 'TV: Красивый танец, несмотря на изящество, навевает вам тревожные мысли.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102091
    m_Localized: 'TV: Вам кажется, будто вас пытаются отвлечь от происходящих событий.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102092
    m_Localized: 'TV: Мог бы хоть кто-то объяснить, что происходит на самом деле…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102093
    m_Localized: 'TV: Сейчас вы ходите за продуктами так: Топ-топ-топ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102094
    m_Localized: 'TV: А теперь будете ходить так: Алло, хочу заказать еду.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102095
    m_Localized: 'TV: Доставка продуктов For Rest. Звоните по номеру: {0} и еда придёт к вам уже следующим вечером.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102096
    m_Localized: 'TV: For Rest: Вкусный отдых у вас дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102097
    m_Localized: 'TV: На улицах города появился бледный маньяк.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102098
    m_Localized: 'TV: Из показаний очевидцев удалось выяснить, что его жертв объединяет одно – все были одинокими людьми.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102099
    m_Localized: 'TV: При этом, прежде чем совершить убийство, маньяк общается с жертвой, после чего нападает.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102100
    m_Localized: 'TV: Из показаний очевидцев удалось составить фоторобот подозреваемого.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102101
    m_Localized: 'TV: Это высокий бледный мужчина среднего возраста с чёрными волосами. На нём только штаны, выше пояса одежды нет. Худощавого телосложения.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102102
    m_Localized: 'TV: Некоторые сообщают, что на его тело надета кожа другого человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102103
    m_Localized: 'TV: Подтверждения этой информации нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102104
    m_Localized: 'TV: Если увидите это лицо, не открывайте ему  дверь и говорите, что вы не один в доме.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102105
    m_Localized: 'TV: На этом всё.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102106
    m_Localized: 'TV: Смятение, страх и горе. И всему виной Гости…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102107
    m_Localized: 'TV: Но в час нужды, когда слёз пролиты реки…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102108
    m_Localized: 'TV: НА ПОМОЩЬ ПРИДУТ ОНИ! СОТРУДНИКИ КЧС!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102109
    m_Localized: 'TV: Отважные герои из Комитета по Чрезвычайным Ситуациям защитят нас от нашествия Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102110
    m_Localized: 'TV: Уже сегодня комитет выявил 27 000 опасных существ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102111
    m_Localized: 'TV: Помните, вы можете помочь комитету, сообщая о подозрительном поведении окружающих.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102112
    m_Localized: 'TV: Для этого используйте приглашение на посещение КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102113
    m_Localized: 'TV: И если у вас возникнут сомнения, не Гость ли вы, звоните по горячей линии: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102114
    m_Localized: 'TV: Помогая КЧС, вы помогаете в борьбе с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102115
    m_Localized: 'TV: КЧС? Что за организация? И для чего её основали?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102116
    m_Localized: 'TV: Комитет по Чрезвычайным Ситуациям – недавно сформированная специальная служба, созданная для ослабления возникшего кризиса.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102117
    m_Localized: 'TV: Они помогут решить проблему с нашествием Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102118
    m_Localized: 'TV: Точно неизвестно, что именно предпримет комитет…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102119
    m_Localized: 'TV: Но можно с уверенностью сказать, что наша судьба в надёжных руках…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102120
    m_Localized: 'TV: Поскольку комитет состоит из экспертов в разных областях, включая заслуженных учёных.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102121
    m_Localized: 'TV: Если к вам на порог придёт сотрудник КЧС, рекомендуем содействовать ему и следовать указаниям.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102122
    m_Localized: 'TV: Помните, что помогая КЧС, вы помогаете в борьбе с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102123
    m_Localized: 'TV: У КЧС есть предположение, что феномен Гостей имеет инфекционную природу или другую биологическую угрозу.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102124
    m_Localized: 'TV: Поэтому необходимо докладывать о подозрительных людях и изолировать их.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102125
    m_Localized: 'TV: Если у вас нет возможности сдать Гостя в карантинную зону сразу, выдайте ему специальное требование о явке в КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102126
    m_Localized: 'TV: При следующем обходе сотрудник заберёт человека с этой бумагой на обследование.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102127
    m_Localized: 'TV: На этом всё.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102128
    m_Localized: 'TV: Жара на улице не помеха.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102129
    m_Localized: 'TV: Когда в руках есть Энержека.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102130
    m_Localized: 'TV: Освежающий энергетик, утоляющий жажду быстрее и эффективнее воды.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102131
    m_Localized: 'TV: Теперь и в ассортименте доставки For Rest. Закажите еду по номеру: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102132
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102133
    m_Localized: 'TV: В связи с ростом числа граждан с признаками Гостя, КЧС приняли новые меры.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102134
    m_Localized: 'TV: С сегодняшнего дня во всех больших городах вводится карантинный режим.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102135
    m_Localized: 'TV: Запрещено покидать города и близлежащие поселения.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102136
    m_Localized: 'TV: Просим вас воздержаться от поездок за пределы вашего населённого пункта.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102137
    m_Localized: 'TV: Кроме того, КЧС озвучили новый признак…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102138
    m_Localized: 'TV: Снимок на фотоплёнку ауры.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102139
    m_Localized: 'TV: Если вы обнаружите странные тёмные пятна на снимке – это явный признак того, что перед вами Гость.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102140
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102141
    m_Localized: 'TV: Далее реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102142
    m_Localized: 'TV: Кто же такие Гости? Люди с того света? Гости из-под земли?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102143
    m_Localized: 'TV: Нет, это не фантастический роман или заголовок жёлтой прессы…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102144
    m_Localized: 'TV: Это действительность, с которой приходится мириться.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102145
    m_Localized: 'TV: В народе ходят разные версии об истинной природе Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102146
    m_Localized: 'TV: Инопланетяне? Восставшие мертвецы? Существа из лаборатории?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102147
    m_Localized: 'TV: Как сообщает КЧС, это лишь слухи.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102148
    m_Localized: 'TV: По мнению комитета, Гость – это человек, вошедший в контакт с вирусом или другой биологической угрозой.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102149
    m_Localized: 'TV: До конца неизвестно, как именно она передаётся. Но КЧС настоятельно просит обращать внимание на симптомы Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102150
    m_Localized: 'TV: В случае, если вы подозреваете, что контактировали с Гостем или сами можете им являться, просим вас звонить на горячую линию КЧС…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102151
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102152
    m_Localized: 'TV: На этом всё. А далее реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102153
    m_Localized: 'TV: С каждым днём всё труднее найти Гостя.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102154
    m_Localized: 'TV: Признаки – это хорошо, но как насчёт бескомпромиссно гарантированного способа?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102155
    m_Localized: 'TV: Феноменальная новинка – специальная фотоплёнка!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102156
    m_Localized: 'TV: Благодаря ей вы сможете отличить человека от злобного Гостя.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102157
    m_Localized: 'TV: Фотографируя на нашу плёнку, вы получаете изображение энергетики души. Если в ней есть тёмные пятна – это знак Гостя.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102158
    m_Localized: 'TV: Позвоните сегодня и вы получите набор плёнки совершенно бесплатно: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102159
    m_Localized: 'TV: Внимание, срочные новости!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102160
    m_Localized: 'TV: Солнце наносит ответный удар – в лесах бушуют массовые пожары.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102161
    m_Localized: 'TV: Эксперты полагают, что причиной возгорания является аномальная солнечная активность.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102162
    m_Localized: 'TV: Пока трудно оценить масштаб происходящего, однако пожарные бригады близлежащих городов уже направлены к очагам возгорания.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296384
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296385
    m_Localized: 'TV: Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296386
    m_Localized: 'TV: Далее реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296387
    m_Localized: 'TV: Давным-давно два брата жили неподалёку от плотины.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296388
    m_Localized: 'TV: Льющаяся вода навевала мысли о холодных пенных напитках…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296389
    m_Localized: 'TV: И когда два брата выросли, вместе основали пивоварню Бобер.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296390
    m_Localized: 'TV: А пиво “Бобер черни” стало одним из самых желанных алкогольных напитков на полках магазина и в барах.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296391
    m_Localized: 'TV: Пиво “Бобер черни”: Пейте много, пейте вкусно.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296392
    m_Localized: 'TV: Внимание, срочные новости!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296393
    m_Localized: 'TV: Из соседнего города поступают сообщения о беспорядках на улице.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296394
    m_Localized: 'TV: Из-за невыясненных обстоятельств город находится в оцеплении КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296395
    m_Localized: 'TV: Просим вас оставаться в своих домах. Позднее КЧС выступят с новыми указаниями.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296396
    m_Localized: 'TV: Сотрудничая с комитетом, вы помогаете в борьбе с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296397
    m_Localized: 'TV: На этом всё…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296398
    m_Localized: 'TV: Оставайтесь на местах и ждите дальнейших указаний.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296399
    m_Localized: 'TV: Даже трудягам иногда нужна передышка.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296400
    m_Localized: 'TV: И с сигаретами марки Маргоро вы сможете вдохнуть полной грудью и расслабиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296401
    m_Localized: 'TV: Маргоро. Сигареты для настоящих мужчин.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296402
    m_Localized: 'TV: (Подпись внизу: компания не несёт ответственности за ущерб, нанесённый жизни и здоровью потребителя.)'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296403
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296404
    m_Localized: 'TV: Важное сообщение.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296405
    m_Localized: 'TV: Стали известны новые подробности о событиях в городе.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296406
    m_Localized: 'TV: Одна из карантинных зон подверглась атаке неизвестного вооружённого человека…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296407
    m_Localized: 'TV: Доподлинно неизвестно о причинах диверсии, а также, имел ли стрелок сообщников.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296408
    m_Localized: 'TV: В результате происшествия на свободу вырвались люди с неизвестным статусом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296409
    m_Localized: 'TV: Тишина – это признак смерти.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296410
    m_Localized: 'TV: Страшно опустошающая тишина.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296411
    m_Localized: 'TV: Но страшнее пустоты – звон.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296412
    m_Localized: 'TV: Звон похоронных колоколов.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296413
    m_Localized: 'TV: От колоколов что-то растёт в ушах.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296414
    m_Localized: 'TV: Остаётся только сера. Грязные мысли.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296415
    m_Localized: 'TV: Ей и живут Гости.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296416
    m_Localized: 'TV: Гости путаются в паутине мыслей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296417
    m_Localized: 'TV: Колокола для них громче. Серы – больше.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296418
    m_Localized: 'TV: Сегодняшнее событие вызвало массу теорий о произошедшем. Показания очевидцев разнятся.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296419
    m_Localized: 'TV: Сообщают как об одиноком стрелке, так и о целой группе вооружённых людей в капюшонах.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296420
    m_Localized: 'TV: Но самая большая трудность ждёт нас ещё впереди.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296421
    m_Localized: 'TV: Из-за того, что город оцеплен, утилизация тел в близлежащих районах временно приостановлена.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296422
    m_Localized: 'TV: Однако регулярный обход домов граждан продолжится без изменений.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296423
    m_Localized: 'TV: Если у вас есть возможность сжечь останки, незамедлительно сделайте это.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296424
    m_Localized: 'TV: В противном случае дождитесь урегулирования ситуации и сдайте тела позже.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296425
    m_Localized: 'TV: На этом всё. Оставайтесь с нами.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296426
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296427
    m_Localized: 'TV: КЧС помогает пострадавшим от атаки на карантинную зону.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296428
    m_Localized: 'TV: В связи с заполненностью других карантинных зон, комитет принял следующее решение…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296429
    m_Localized: 'TV: Поместить эвакуированных жителей из городов в здания неподалёку от города.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296430
    m_Localized: 'TV: К счастью, жильцы пошли на контакт с КЧС и решили помочь, предоставив свой дом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296431
    m_Localized: 'TV: Однако, найдена только часть беглецов с подозрительным статусом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296432
    m_Localized: 'TV: КЧС дала новый признак, чтобы их можно было отыскать…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296433
    m_Localized: 'TV: Кровь на дёснах.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296434
    m_Localized: 'TV: Если к вам придёт человек с данным симптомом, не вступайте с ним в контакт.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296435
    m_Localized: 'TV: В случае необходимости дождитесь сотрудника, занятого регулярным обходом, и сдайте подозреваемого.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296436
    m_Localized: 'TV: На этом всё…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296437
    m_Localized: 'TV: Оставайтесь на местах и ждите дальнейших указаний.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296438
    m_Localized: 'TV: Далее репортаж о новом опасном культе.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296439
    m_Localized: 'TV: Гости не только скрываются среди нас, но и влияют на умы людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296440
    m_Localized: 'TV: По нашей информации, в городах появляются культисты неизвестной нам конфессии.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296441
    m_Localized: 'TV: Они обвиняются в следующем…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296442
    m_Localized: 'TV: Жертвоприношения, поклонение неизвестному богу и возможное сотрудничество с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296443
    m_Localized: 'TV: По последним данным, они выступают против действий КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296444
    m_Localized: 'TV: Раньше всё ограничивалось лишь словами и призывами, но теперь они перешли к действиям.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296445
    m_Localized: 'TV: Возможно, именно этот культ несёт ответственность за произошедшее в городе.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296446
    m_Localized: 'TV: Просим вас остерегаться нововеров и не вступать с ними в контакт.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296447
    m_Localized: 'TV: При подозрении в пособничестве сектантам сотрудники КЧС могут арестовать вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296448
    m_Localized: 'TV: На этом всё. Оставайтесь с нами.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296449
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296450
    m_Localized: 'TV: Ситуация в городе понемногу стабилизируется, но беглецы всё ещё на свободе.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296451
    m_Localized: 'TV: Тем временем, утилизация тел на улицах города возобновляется, однако появились новые трудности.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296452
    m_Localized: 'TV: По последним данным, по улицам бродят стаи бездомных собак.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296453
    m_Localized: 'TV: КЧС сообщил, что выслал отряд для решения этой проблемы.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296454
    m_Localized: 'TV: Также комитет сообщил новые признаки потенциально опасных граждан…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296455
    m_Localized: 'TV: Раздражения на коже.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296456
    m_Localized: 'TV: Следствие всё ещё не может установить точное описание происшествия в городе…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296457
    m_Localized: 'TV: И всё ещё неясно, были ли у нападавшего сообщники.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296458
    m_Localized: 'TV: Однако, нет сомнений, что КЧС урегулирует эту ситуацию, как и нашествие Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296459
    m_Localized: 'TV: Если у вас возникли вопросы о признаках Гостей, вы всегда можете позвонить по горячей линии…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296460
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296461
    m_Localized: 'TV: На этом всё…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296462
    m_Localized: 'TV: Оставайтесь на местах и ждите дальнейших указаний.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296463
    m_Localized: 'TV: Далее репортаж про обстановку в странах экваториального пояса.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296464
    m_Localized: 'TV: Неприятные новости приходят из жарких стран.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296465
    m_Localized: 'TV: Сильные пожары, испепеляющее солнце и засуха свирепствуют в странах экваториального пояса.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296466
    m_Localized: 'TV: Судя по последним сообщениям, жара там настолько сильная, что при касании к земле можно получить ожог третьей степени.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296467
    m_Localized: 'TV: Количество жертв на данный момент неизвестно, а эвакуация не представляется возможной.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296468
    m_Localized: 'TV: Правительство нашей страны не может связаться с представителями пострадавших государств…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296469
    m_Localized: 'TV: Однако, как только ситуация урегулируется, туда будут направлены сотрудники КЧС для помощи в устранении последствий.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296470
    m_Localized: 'TV: На этом всё. Оставайтесь с нами.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296471
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296472
    m_Localized: 'TV: Ситуация в городе всё ещё стабилизируется, и оцепление города продолжается. Однако…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296473
    m_Localized: 'TV: Возникла новая угроза – представители запрещённого культа стали появляться на окраинах города.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296474
    m_Localized: 'TV: Судя по последним данным, они собираются устроить ритуал с использованием открытого огня.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296475
    m_Localized: 'TV: КЧС подозревает, что именно они замешаны в нападении на карантинные зоны.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296476
    m_Localized: 'TV: Но, к сожалению, ни Комитет, ни армия сейчас не могут выделить рабочую группу из-за ситуации в городе.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296477
    m_Localized: 'TV: Если к вам придут культисты, немедленно свяжитесь с КЧС по горячей линии – {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296478
    m_Localized: 'TV: Кроме того, комитет сообщил о новом признаке…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296479
    m_Localized: 'TV: Грибок на подмышках.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296480
    m_Localized: 'TV: На этом всё…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296481
    m_Localized: 'TV: Оставайтесь на местах и ждите дальнейших указаний.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296482
    m_Localized: 'TV: Далее репортаж про обстановку на северном и южном полюсах.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296483
    m_Localized: 'TV: Солнце наносит новый удар.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296484
    m_Localized: 'TV: Учёные сделали тревожные предположения.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296485
    m_Localized: 'TV: Если аномальная жара в ближайшее время не спадёт, ледники могут окончательно растаять, вследствие чего может произойти потоп.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296486
    m_Localized: 'TV: Учёные до сих пор пытаются выяснить причины происходящего катаклизма, но пока их усилия безуспешны.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296487
    m_Localized: 'TV: На этом всё. Оставайтесь с нами.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296488
    m_Localized: 'TV: Срочные новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296489
    m_Localized: 'TV: Ситуация в городе не стабилизируется, а катаклизм становится всё сильнее.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296490
    m_Localized: 'TV: Из-за тающих ледников уровень воды в мировом океане активно растёт.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296491
    m_Localized: 'TV: Это грозит затоплением больших территорий. В том числе, городов.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296492
    m_Localized: 'TV: Кроме того, некоторые загрязнённые водоёмы, зараженные радиацией, подверглись испарению…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296493
    m_Localized: 'TV: Ученые утверждают, что следствием этого могут быть кислотные дожди.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296494
    m_Localized: 'TV: Если вы услышите раскаты грома, немедленно ищите крышу, чтобы укрыться от кислотного дождя.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296495
    m_Localized: 'TV: И, к сожалению, город продолжает находится в оцеплении.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296496
    m_Localized: 'TV: КЧС всё ещё не поймал всех сбежавших, поэтому выдал новые признаки…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296497
    m_Localized: 'TV: Быстро бегающий зрачок.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296498
    m_Localized: 'TV: На этом всё…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296499
    m_Localized: 'TV: Мы вынуждены прервать репортаж из-за рисков нападения на нашу студию.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296500
    m_Localized: 'TV: Если у вас возникнут вопросы, как выявить Гостей, звоните по горячей линии: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296501
    m_Localized: 'TV: Конец эфира.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296502
    m_Localized: 'TV: Экстренное включение.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296503
    m_Localized: 'TV: КЧС только что арестовал большую часть представителей власти.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296504
    m_Localized: 'TV: Комитет заявил, что среди них выявили Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296505
    m_Localized: 'TV: В связи с неспособностью дальнейшей работы парламента, на КЧС возлагается роль временного правительства.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296506
    m_Localized: 'TV: Кроме того…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296507
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296508
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296509
    m_Localized: 'TV: Минутку…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296510
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296511
    m_Localized: 'TV: Только что поступило сообщение от КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296512
    m_Localized: 'TV: Нападавшие на карантинную зону в городе вырвались из оцепления.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296513
    m_Localized: 'TV: Повторяем, нападавшие вырвались из оцепления. Они на свободе.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296514
    m_Localized: 'TV: Забаррикадируйте окна и заприте двери.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296515
    m_Localized: 'TV: Ожидайте дальнейших инструкций и не выходите из дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296516
    m_Localized: 'TV: Конец эфира.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296517
    m_Localized: 'Window: В чистом поле стоит дом вашего соседа.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296518
    m_Localized: 'Window: В окнах темно, и похоже, его семья сейчас спит.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296519
    m_Localized: 'Window: На улице валяются несколько сильно выпивших людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296520
    m_Localized: 'Window: Несмотря на то, что они лежат на холодной земле, кажется, синяки крепко спят. Им сейчас хорошо.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296521
    m_Localized: 'Window: Вдалеке стоит дом соседа, что сейчас гостит у вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296522
    m_Localized: 'Window: В окнах горит свет, и кажется, семья ждёт, пока он уйдёт от вас обратно домой.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296523
    m_Localized: 'Window: На улице гробовая тишина.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296524
    m_Localized: 'Window: Никого нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296525
    m_Localized: 'Window: Даже пьяницы решили не появляться на улице.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296526
    m_Localized: 'Window: Они кого-то боятся?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296527
    m_Localized: 'Window: За окном стоит сосед и его дочка.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296528
    m_Localized: 'Window: Они весело играют, пытаясь забыть о происходящем ужасе…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296529
    m_Localized: 'Window: Хотя бы на миг.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296530
    m_Localized: 'Window: На тропе стоит бледный, как сама смерть, человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296531
    m_Localized: 'Window: На его коже странные складки.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296532
    m_Localized: 'Window: Кажется, эта кожа ему не по размеру.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296533
    m_Localized: 'Window: Отсюда не видно его глаз, но чувствуется, как он сверлит вас своим взглядом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296534
    m_Localized: 'Window: Вы ощущаете страх и молите бога, чтобы жуткий Гость обошёл дом стороной.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296535
    m_Localized: 'Window: У соседского дома стоит небольшая группа сотрудников КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296536
    m_Localized: 'Window: Интересно, о чём они разговаривают?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296537
    m_Localized: 'Window: Может, они берут образцы почвы?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296538
    m_Localized: 'Window: Или ищут место для развёртывания базы?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296539
    m_Localized: 'Window: За окном стоит группа вооружённых солдат.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296540
    m_Localized: 'Window: Видимо, это небольшой отряд, высланный сюда из города для обеспечения безопасности КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296541
    m_Localized: 'Window: До вас долетают лишь обрывки фраз про бледного мужчину с голым торсом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296542
    m_Localized: 'Window: Может, они хотят выследить того жуткого Гостя?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296543
    m_Localized: 'Window: Соседский дом, что недавно покрасили в белое, сгорел дотла и теперь весь чёрный.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296544
    m_Localized: 'Window: Похоже, пожар утих совсем недавно.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296545
    m_Localized: 'Window: Неужели кто-то поджёг его намеренно?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296546
    m_Localized: 'Window: Что произошло с соседской семьёй?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296547
    m_Localized: 'Window: Выжил ли кто-нибудь?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296548
    m_Localized: 'Window: Голову переполнили тревожные мысли, и вас охватило чувство непонимания и беспомощности.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296549
    m_Localized: 'Window: Весь отряд солдат, который был здесь вчера, мёртв.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296550
    m_Localized: 'Window: Здесь была настоящая бойня.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296551
    m_Localized: 'Window: Тела разбросаны по всей улице, и у одного из тел отсутствует голова.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296552
    m_Localized: 'Window: Неужели их всех убил тот бледный жуткий незнакомец?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296553
    m_Localized: 'Window: Вы смотрите на руины соседского дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296554
    m_Localized: 'Window: От него остался лишь призрачный силуэт, хотя только недавно здесь жила вполне счастливая семья…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296555
    m_Localized: 'Window: Странное чувство охватывает вас, словно вы знали, что это произойдёт…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296556
    m_Localized: 'Window: Будто… вы чувствовали, что смерть заглянет в этот дом совсем скоро.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296557
    m_Localized: 'Window: Вы видите кол, на который насажен череп в каске.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296558
    m_Localized: 'Window: На черепе осталось немного чёрной обгоревшей кожи, а зубы, похоже, кто-то вырвал.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296559
    m_Localized: 'Window: Голова простояла здесь весь день.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296560
    m_Localized: 'Window: Вся эта мрачная экспозиция выглядит как угроза. Наверняка, оставленная тем жутким бледным Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296561
    m_Localized: 'Window: Сотрудники КЧС осматривают место недавней бойни.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296562
    m_Localized: 'Window: Они забирают всё снаряжение и оружие у мёртвых солдат, чтобы оно не досталось мародёрам.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296563
    m_Localized: 'Window: Наверное, рассчитывали, что бледный гость не переживёт стычку с толпой вооружённых людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296564
    m_Localized: 'Window: Теперь мешков с трупами на пару больше.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296565
    m_Localized: 'Window: Вы видите, как женщина плачет над раненым мужем.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296566
    m_Localized: 'Window: Отсюда не видно, жив он или уже мёртв.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296567
    m_Localized: 'Window: Вся в слезах она пытается тащить его массивное тело подальше от выстрелов.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296568
    m_Localized: 'Window: В голове крутится мысль: то ли ещё будет.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296569
    m_Localized: 'Window: Тропинка вдоль поля усеяна телами пытавшихся убежать людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296570
    m_Localized: 'Window: Недалеко от места бойни стоит её виновник – сотрудник КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296571
    m_Localized: 'Window: В руках он держит автомат, из дула которого ещё идёт дым.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296572
    m_Localized: 'Window: В панике люди бросаются к домам поблизости.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296573
    m_Localized: 'Window: Они бьют по дверям, пытаясь дозваться хозяев.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296574
    m_Localized: 'Window: Но, кажется, никто не собирается пускать их, боясь навлечь на себя проблемы.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296575
    m_Localized: 'Window: Рядом с развалинами соседского дома стоит группа выселенных людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296576
    m_Localized: 'Window: Они шокированы и что-то обсуждают.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296577
    m_Localized: 'Window: Скорее всего, они хотят укрыться в сгоревшем доме соседа.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296578
    m_Localized: 'Window: Но осталось ли в мире хоть одно место, где тебя никто не найдёт и не причинит вреда?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296579
    m_Localized: 'Window: На тропе стоит вооружённый автоматом мужчина. Он выглядит совершенно безумно.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296580
    m_Localized: 'Window: Его куртка вся увешена вырванными зубами, глазами и чем-то ещё. Сложно разглядеть из окна.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296581
    m_Localized: 'Window: Вдруг он убивает не ради защиты, а ради забавы и трофеев?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296582
    m_Localized: 'Window: Как бы то ни было, вы надеетесь, что не станете для него врагом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296583
    m_Localized: 'Window: На столбе висит повешенный человек с табличкой “Вы забрали у меня всё”.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296584
    m_Localized: 'Window: Может, его обокрали? Или КЧС забрали всех его родных?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296585
    m_Localized: 'Window: К сожалению, ворох мыслей не даст ответ на этот вопрос. Можно лишь только строить догадки.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296586
    m_Localized: 'Window: Группа людей, выселенных КЧС, осела в руинах соседского дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296587
    m_Localized: 'Window: Хоть от него мало что осталось, подвал, судя по всему, уцелел.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296588
    m_Localized: 'Window: Всё-таки им удалось найти безопасный островок.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296589
    m_Localized: 'Window: Но как долго они смогут прятаться?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296590
    m_Localized: 'Window: На улице бродит стая диких собак.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296591
    m_Localized: 'Window: Их тела покрывают неглубокие ожоги, и они замучены голодом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296592
    m_Localized: 'Window: В доме вам незачем бояться этих дворняг.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296593
    m_Localized: 'Window: Но теперь вас не покидает мысль, что на улицу лучше не соваться.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296594
    m_Localized: 'Window: У домов столпились небольшие группы людей с вещами. Они тихо перешёптываются, чтобы сотрудники КЧС их не услышали.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296595
    m_Localized: 'Window: Похоже, что это люди из карантинных зон, и их заселяют на место предыдущих жильцов.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296596
    m_Localized: 'Window: Теперь висельник смотрится как мрачная табличка “Добро пожаловать”.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296597
    m_Localized: 'Window: Вооружённый охотник на Гостей держит группу выживших на прицеле.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296598
    m_Localized: 'Window: Наверно, он наткнулся на этих людей совершенно случайно.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296599
    m_Localized: 'Window: Слышны лишь обрывки фраз, а обезумевший стрелок что-то кричит.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296600
    m_Localized: 'Window: Кто сможет выжить в этом новом мире? Похоже, не эти ребята.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296601
    m_Localized: 'Window: Вооружённые сотрудники КЧС стоят над телами собак.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296602
    m_Localized: 'Window: Один из сотрудников что-то записывает в планшет.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296603
    m_Localized: 'Window: Но хватит ли пары человек для отстрела озверевших от голода животных? Очень навряд ли.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296604
    m_Localized: 'Window: Двое КЧС-ников стоят рядом с фонарным столбом и задумчиво смотрят на повешенного.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296605
    m_Localized: 'Window: Похоже, у них наконец-то дошли руки до главной достопримечательности округи.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296606
    m_Localized: 'Window: Они выглядят как два бестолковых детектива, что пытаются выяснить, как повешенный вообще забрался на столб без лестницы.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296607
    m_Localized: 'Window: Вся группа мертва, их останки объедают голодные бродячие собаки.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296608
    m_Localized: 'Window: Рядом с телами рассыпаны гильзы. Похоже, тот охотник убил людей и, скорее всего, забрал трофеи.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296609
    m_Localized: 'Window: Безумие этого мира зашло слишком далеко.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296610
    m_Localized: 'Window: Культисты складывают дрова в одну большую кучу.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296611
    m_Localized: 'Window: Они собираются кого-то сжигать?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296612
    m_Localized: 'Window: Похоже, скоро станет понятен замысел умалишëнных культистов.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296613
    m_Localized: 'Window: Но сколько невинных людей пострадает ради этого?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296614
    m_Localized: 'Window: На дороге стоит сумасшедший стрелок.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296615
    m_Localized: 'Window: В руках у него канистра бензина и коктейль Молотова.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296616
    m_Localized: 'Window: Он собирается сжечь всю деревню с людьми?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296617
    m_Localized: 'Window: Кто-то сказал маньяку, что они из карантинных зон?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296618
    m_Localized: 'Window: Тела тех, кто укрывался в руинах соседского дома, сгорели от дневного солнечного света.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296619
    m_Localized: 'Window: Собаки, которые поедали останки, почему-то сбежали. Будто кого-то боятся.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296620
    m_Localized: 'Window: Что, если они испугались не отряд КЧС, а чего-то… более опасного?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296621
    m_Localized: 'Window: На подготовленном для костра месте привязаны культисты.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296622
    m_Localized: 'Window: Они решили принести в жертву себя?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296623
    m_Localized: 'Window: Эта мысль не укладывается у вас в голове.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296624
    m_Localized: 'Window: Страх смерти настолько затмил рассудок людей, что они готовы на бесчеловечные поступки.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296625
    m_Localized: 'Window: Страшно представить, что будет дальше, если спустя всего пару недель творится такое безумие.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296626
    m_Localized: 'Window: Горящие дома ярко полыхают. Даже здесь вы слышите вопли людей…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296627
    m_Localized: 'Window: Это всё дело рук того безумца, что решил избавиться от Гостей в домах, вы уверены в этом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490688
    m_Localized: 'Window: Может ли ваш дом стать следующим? Завтра? На следующей неделе?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490689
    m_Localized: 'Window: Наверняка вам придётся встретиться с этим сумасшедшим лицом к лицу. Это лишь вопрос времени.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490690
    m_Localized: 'Window: От сгоревших тел ничего не осталось.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490691
    m_Localized: 'Window: Лишь странная бесформенная масса, напоминающая вам жижу.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490692
    m_Localized: 'Window: Вас посещает мысль, что нечто разжижило плоть и кости, перед тем, как поглотить останки.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490693
    m_Localized: 'Window: Вы молитесь, чтобы это существо так и осталось в тени. Есть риск, что ваш рассудок не переживёт вида этого монстра.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490694
    m_Localized: 'Window: Сотрудники из КЧС обступили сгоревшие тела.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490695
    m_Localized: 'Window: Кажется, они документируют смерть всех культистов.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490696
    m_Localized: 'Window: На лицах сектантов застыли гримасы страха и агонии, будто они увидели что-то ужасающее перед смертью.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490697
    m_Localized: 'Window: Все дома поблизости уничтожены.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490698
    m_Localized: 'Window: Теперь ваш дом – единственный уцелевший во всей округе.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490699
    m_Localized: 'Window: Больше некому принять удар безумцев на себя.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490700
    m_Localized: 'Window: Что бы ни случилось, это наверняка произойдёт теперь с вами.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490701
    m_Localized: Говорит диспетчер. Проверьте, что случилось в карантинной зоне. Код 51. Докладывают о взрывах в 3 часа ночи.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490702
    m_Localized: 'Сотрудник 32-8 докладывает. Код 60: множество жертв среди гражданских, сотрудники убиты…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490703
    m_Localized: 'Докладывает сотрудник 28-8. Код 451: нужна бригада для сожжения трупов.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490704
    m_Localized: 'Принято. Инициируется код 984: город взят в оцепление до выяснения обстоятельств. Ожидайте подкрепление.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490705
    m_Localized: Если вы меня слышите, не приближайтесь к окраинам города.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490706
    m_Localized: Сотрудники КЧС стреляют по всем, кто пытается выбраться отсюда.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490707
    m_Localized: Я НЕ ЗНАЮ, ЧТО ПРОИСХОДИТ. Я ПРОСТО ХОЧУ УЙТИ ОТСЮДА.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490708
    m_Localized: КТО-НИБУДЬ ПОМО……
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490709
    m_Localized: Это не те люди, что напали на карантинную зону.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490710
    m_Localized: Я видел, что там было.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490711
    m_Localized: Это не человек…
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490712
    m_Localized: Говорят выселенные из домов.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490713
    m_Localized: Если КЧС вас выселили так же, как и нас, мы находимся в уцелевшем подвале сожжённого дома.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490714
    m_Localized: Это недалеко от дома отшельника.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490715
    m_Localized: У нас есть совсем немного еды. Скоро мы начнем голодать.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490716
    m_Localized: Если вы можете поделиться едой, это очень поможет нам.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490717
    m_Localized: Всем, кто меня слышит…
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490718
    m_Localized: КЧС пытается глушить связь в городе, чтобы избежать утечки информации.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490719
    m_Localized: Они хотят, чтобы все события в городе оставались засекречены.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490720
    m_Localized: Пытаются всё свалить того психа, который завалил всех в карантинной зоне.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490721
    m_Localized: Если вы в городе, выб…райтесь отсюда, зд…сь небезопасно.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490722
    m_Localized: Изб…гайте патрулей КЧС, они ……таются убить в…с.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490723
    m_Localized: БЕГ…ТЕ ОТС…ДА КАК М…ЖНО СК…РЕЕ………
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490724
    m_Localized: Они зря сжи…али тела. Это при…анивает ………
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490725
    m_Localized: Если бы ……… те тела, оно бы не приш……
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490726
    m_Localized: Дисп…тчер на связи, вс…м сотрудн…кам КЧС…
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490727
    m_Localized: 'Новые ук…зания: код 451 заменяется н…вым кодом 955'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490728
    m_Localized: Тела не сж…гать. Покрывать их изв…стью.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490729
    m_Localized: Повт…ряю, код 451 от…еняется. Сожжение тру…ов недопуст…мо для сдерж…вания угрозы от субъ…кта………
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490730
    m_Localized: 'Говорит с…трудник 18-8: угр…зу не уд…лось сдержать.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490731
    m_Localized: Субъ…кт покинул террит…рию города. Ср…чно вызывайте подкр…пление.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490732
    m_Localized: Повт…ряю, вызывайте подкр…пление. Нам не спр…виться с субъ…ктом.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490733
    m_Localized: 'Phone: Привет, сосед. Рад, что ты позвонил.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490734
    m_Localized: 'Phone: Ну как там, пустил к себе пару гостей?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490735
    m_Localized: 'Phone: Если нет – лучше с этим не тяни.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490736
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490737
    m_Localized: 'Phone: У тебя есть вопросы?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490738
    m_Localized: Ты тоже пускаешь к себе людей?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490739
    m_Localized: Сколько признаков надо, чтобы найти Гостя?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490740
    m_Localized: Как ты решил проблему с едой?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490741
    m_Localized: Пока (Завершить звонок)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490742
    m_Localized: 'Phone: Да, приходится.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490743
    m_Localized: 'Phone: Моей дочке это очень не нравится. Но что поделать, по-другому никак.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490744
    m_Localized: 'Phone: Она всё просит, чтобы я с ней выходил гулять на улицу. Так можно отдохнуть от незнакомцев.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490745
    m_Localized: 'Phone: Но разве днём выйдешь? Вот и придётся гулять ночью. Это опасно, но… Она очень просит об этом…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490746
    m_Localized: 'Phone: Ох, если бы я знал…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490747
    m_Localized: 'Phone: К сожалению, неизвестно сколько признаков надо, чтобы определить Гостя.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490748
    m_Localized: 'Phone: Но, думаю, лучше не торопиться с выводами, если найдёшь хотя бы один признак у человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490749
    m_Localized: 'Phone: Быть может, так совпало, он ходил к стоматологу перед катаклизмом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490750
    m_Localized: 'Phone: Мне в этом плане повезло. Я запасся ей заранее. Как я помню, ты тоже.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490751
    m_Localized: 'Phone: Но если вдруг ты захочешь себе что-нибудь особенное – есть служба доставки еды For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490752
    m_Localized: 'Phone: Я не помню их номер, но ты можешь увидеть его в рекламе по телику или радио.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490753
    m_Localized: 'Phone: Береги себя.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490754
    m_Localized: 'Phone: Привет, сосед.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490755
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490756
    m_Localized: 'Phone: Видел, что на улице произошло? Подростков убили…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490757
    m_Localized: 'Phone: Мне казалось… на улице не так опасно. Но я ошибался.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490758
    m_Localized: 'Phone: Дочь уговорила меня выйти на улицу поиграть. И всё было хорошо… пока я не заметил тела…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490759
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490760
    m_Localized: 'Phone: Думаю, в ближайшее время это был последний раз, когда я так рисковал жизнью дочери.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490761
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490762
    m_Localized: 'Phone: Богом клянусь, я себе не прощу, если с ней что-то случится. Она для меня – весь мир.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490763
    m_Localized: Твоя дочь в порядке?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490764
    m_Localized: Кто их убил?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490765
    m_Localized: Будь осторожнее (Завершить звонок)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490766
    m_Localized: 'Phone: Я не знаю…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490767
    m_Localized: 'Phone: Из-за пожухлой высокой травы она не должна была заметить.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490768
    m_Localized: 'Phone: Но дома она сказала, что видела чьё-то лицо в траве…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490769
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490770
    m_Localized: 'Phone: Я пытаюсь убедить её, что ей показалось. Но… похоже, она считает иначе…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490771
    m_Localized: 'Phone: Это то бледное высокое существо. Я думал, оно убивает только тех, кто по домам сидит.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490772
    m_Localized: 'Phone: Я был уверен, что держу ситуацию под контролем. Думал, что если вдруг увижу хоть что-то похожее на этот силуэт – сразу же домой.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490773
    m_Localized: 'Phone: Но я не подумал о телах, которые может увидеть дочь…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490774
    m_Localized: 'Phone: Спасибо. Ты тоже береги себя.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490775
    m_Localized: 'Phone: Привет, сосед. Спасибо, что позвонил.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490776
    m_Localized: 'Phone: Честно говоря, я в шоке от происходящего.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490777
    m_Localized: 'Phone: Убийства, солдаты, КЧС…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490778
    m_Localized: 'Phone: Последние вчера вечером вообще приходили ко мне на порог.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490779
    m_Localized: 'Phone: Они спрашивали про людей в моём доме. Затем записали себе что-то в планшет и…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490780
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490781
    m_Localized: 'Phone: Сотрудник КЧС просто забрал одного из людей в моём доме…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490782
    m_Localized: Куда они забрали твоего жильца?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490783
    m_Localized: Хорошо, что они не забрали твою дочь
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490784
    m_Localized: Кто такие КЧС?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490785
    m_Localized: Береги себя (Завершить звонок)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490786
    m_Localized: 'Phone: Чёрт их знает, говорят, на проверку'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490787
    m_Localized: 'Phone: Я думал, что с приходом солдат и Комитета по Чрезвычайным Ситуациям всё наладится.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490788
    m_Localized: 'Phone: Похоже зря я надеялся, что они помогут разобраться в ситуации или заберут нас в безопасное место.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490789
    m_Localized: 'Phone: Чёрта с два я им это позволю.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490790
    m_Localized: 'Phone: Только через мой труп!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490791
    m_Localized: 'Phone: Если эти сукины дети хоть тронут её, я от них ничего не оставлю.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490792
    m_Localized: 'Phone: Не знаю. О них почти ничего неизвестно.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490793
    m_Localized: 'Phone: Возникли из ниоткуда и делают вид, что всё под контролем.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490794
    m_Localized: 'Phone: Как, например, они выявили признаки? Почему признаки совсем не отличаются от простых человеческих?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490795
    m_Localized: 'Phone: Мне кажется, что они что-то нам недоговаривают…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490796
    m_Localized: 'Phone: Спасибо.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490797
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490798
    m_Localized: 'Phone: Никогда не думал, что вокруг нас будет происходить настоящий хаос.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490799
    m_Localized: 'Phone: Солнце, Гости, теперь ещё КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490800
    m_Localized: 'Phone: Столько вопросов, и ничерта ответов…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490801
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490802
    m_Localized: 'Phone: Сосед, у меня к тебе одна просьба.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490803
    m_Localized: 'Phone: Прошу, если со мной что-то случится, пообещай, что позаботишься о моей дочери.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490804
    m_Localized: Обещаю
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490805
    m_Localized: Я не готов ничего обещать
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490806
    m_Localized: 'Phone: Большое тебе спасибо, сосед. Я знал, что могу на тебя положиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490807
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490808
    m_Localized: 'Phone: Ладно, мне пора. Сил тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490809
    m_Localized: 'Phone: Я…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490810
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490811
    m_Localized: 'Phone: Неужели ты ей не поможешь? Она ведь ещё ребёнок. Я не хочу, чтобы она оставалась совсем одна.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490812
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490813
    m_Localized: 'Phone: Чёрт, мне надо бежать…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490814
    m_Localized: 'Phone: Пока, сосед.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490815
    m_Localized: 'Phone: Здравствуйте, это компания доставки еды For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490816
    m_Localized: 'Phone: Что бы вы хотели заказать?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490817
    m_Localized: 2 банки Энержеки, пожалуйста.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490818
    m_Localized: 1 банку кофе, пожалуйста.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490819
    m_Localized: Я передумал делать заказ
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490820
    m_Localized: 'Phone: К сожалению, мы не можем принять ваш заказ, так как вы недавно делали его.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490821
    m_Localized: 'Phone: Из-за большой загрузки мы вынуждены принимать заказы с перерывом.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490822
    m_Localized: 'Phone: Если вы хотите сделать заказ – попробуйте позвонить в другой день.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490823
    m_Localized: 'Phone: Всего доброго, до свидания.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490824
    m_Localized: 'Phone: Хорошо, заказ принят. Ожидайте курьера следующей ночью.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490825
    m_Localized: 'Phone: Хорошо, заказ принят. Ожидайте курьера следующей ночью.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490826
    m_Localized: 'Phone: Здравствуйте, это врач из Комитета по Чрезвычайным Ситуациям.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490827
    m_Localized: 'Phone: Мы готовы проконсультировать вас по вопросу проверок на Гостя.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490829
    m_Localized: 'Phone: У вас есть вопросы?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490830
    m_Localized: Что мне делать с зубами?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490831
    m_Localized: Что мне делать с ногтями?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490832
    m_Localized: Что мне делать с глазами?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490833
    m_Localized: Спасибо, этого хватит.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490834
    m_Localized: 'Phone: Для достоверных анализов мы рекомендуем не употреблять табачные изделия.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490835
    m_Localized: 'Phone: Курение может повлиять на состояние зубов, что приведёт к неточным показателям.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490836
    m_Localized: 'Phone: Чтобы мы могли достоверно узнать ваш статус, просим вас воздержаться от мытья рук до обследования.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490837
    m_Localized: 'Phone: Вода может смыть грязь, что приведёт к ошибкам и недостоверности анализов.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490838
    m_Localized: 'Phone: Для корректных результатов просим вас воздержаться от питья кофе-содержащих напитков.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490839
    m_Localized: 'Phone: Употребление кофеина может привести не только к бессоннице и нервозности, но и к покраснению глаз.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490840
    m_Localized: 'Phone: Благодарим вас за содействие Комитету по Чрезвычайным Ситуациям.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490841
    m_Localized: 'Phone: Мы отметим ваши заслуги в разрешении сложившейся ситуации.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490842
    m_Localized: 'Phone: Делая достоверные обследования, вы помогаете не только себе, но и всему человечеству.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490843
    m_Localized: 'Phone: Здравствуйте. Скоро мы соединим вас с одним из доступных экспертов по очищению от Гостей. Ожидайте.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490844
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490845
    m_Localized: 'Phone: Алло, кто вы?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490846
    m_Localized: В смысле?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490847
    m_Localized: Зачем вам знать, кто я?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490848
    m_Localized: 'Phone: Всё ясно, вы не смогли сразу сказать, что вы человек…  Гостевой начал поселяться в вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490849
    m_Localized: 'Phone: Теперь слушайте меня внимательно, у вас не так много времени.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490850
    m_Localized: 'Phone: Скажите, вы кладёте ломтик хлеба на кухне?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490851
    m_Localized: Нет. А с чего бы?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490852
    m_Localized: Какой ещё ломтик хлеба?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490853
    m_Localized: 'Phone: Затем, чтобы я мог изгнать из вас Гостевого.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490854
    m_Localized: 'Phone: Ладно, не важно. Слушайте меня внимательно, у вас не так много времени.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490855
    m_Localized: 'Phone: Скажите, вы кладёте ломтик хлеба на кухне?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490856
    m_Localized: Нет. А с чего бы?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490857
    m_Localized: Какой ещё ломтик хлеба?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490858
    m_Localized: 'Phone: Ооо… Всё понятно. Вы не в ладах с домовым…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490859
    m_Localized: 'Phone: Поэтому-то и пришёл Гостевой. Ладно, ничего страшного.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490860
    m_Localized: 'Phone: Скажите, у вас дома стоит персональный компьютер?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490861
    m_Localized: Нет
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490862
    m_Localized: Персональный что?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490863
    m_Localized: 'Phone: Вы что, не оставляете еду домовому?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490864
    m_Localized: 'Phone: Теперь понятно почему Гостевой приметил вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490865
    m_Localized: 'Phone: Скажите, у вас дома стоит персональный компьютер?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490866
    m_Localized: Нет
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490867
    m_Localized: Персональный что?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490868
    m_Localized: 'Phone: Понятно, нажать Alt F4 не получится…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490869
    m_Localized: 'Phone: Хорошо, тогда скажите, вы потребляете в пищу грибы?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490870
    m_Localized: Только чайный гриб, иногда
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490871
    m_Localized: Нет
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490872
    m_Localized: 'Phone: Вы не знаете, что такое компьютер?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490873
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490874
    m_Localized: 'Phone: Так, понятно, проехали.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490875
    m_Localized: Только чайный гриб, иногда
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490876
    m_Localized: Нет
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490877
    m_Localized: 'Phone: О нет…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490878
    m_Localized: 'Phone: Вам надо срочно прекратить его пить. Чайный гриб - древнее зло…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490879
    m_Localized: 'Phone: От него в вас прорастает мицелий. Из-за него дух легко сможет контролировать вас как марионетку.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490880
    m_Localized: 'Phone: Вы не представляете, что он сделает, если доберётся до вашей памяти.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490881
    m_Localized: 'Phone: Он может как стереть её, так и перечитывать из раза в раз, меняя ваши решения.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490882
    m_Localized: 'Phone: И самое страшное: вы даже не будете знать, что вами кто-то управляет.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490883
    m_Localized: 'Phone: Что ж, ладно, тогда последний вопрос: скажите, у вас проливалась кровь дома?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490884
    m_Localized: Да
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490885
    m_Localized: Нет
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490886
    m_Localized: 'Phone: Хорошо. Вот и не пейте. Иначе Гостевому будет проще возвращаться в ваше тело.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490887
    m_Localized: 'Phone: Если бы вы его пили, внутри мог прорасти мицелий, и начать контролировать вас, словно марионетку.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490888
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490889
    m_Localized: 'Phone: Ух, непросто, непросто…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490890
    m_Localized: Да
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490891
    m_Localized: Нет
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490892
    m_Localized: 'Phone: А, ну тогда мне всё понятно…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490893
    m_Localized: 'Phone: У вас не Гостевой, а Духовой. Дух мёртвого человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490894
    m_Localized: 'Phone: Эх, вот досада – изгнание духов умерших не по нашей части.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490895
    m_Localized: 'Phone: Лучше обратитесь к экзорцистам, они вам помогут.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490896
    m_Localized: 'Phone: Я ничем не смогу вам помочь. До свидания.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490897
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490898
    m_Localized: 'Phone: Сеанс с экспертом по изгнанию Гостевого завершён. Спасибо, что воспользовались нашими услугами.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490899
    m_Localized: 'Phone: Плата за консультацию спишется в ближайшее время.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490900
    m_Localized: Плата?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490901
    m_Localized: Я думал звонок бесплатный
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490902
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490903
    m_Localized: 'Phone: Эх, вот досада. Боюсь тогда я не могу определить тип этого духа. А без знания духа, мне нечем помочь.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490904
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490905
    m_Localized: 'Phone: К сожалению,на этом я вынужден закончить наш сеанс.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490906
    m_Localized: 'Phone: Будьте сильны, и до свидания.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490907
    m_Localized: 'Phone: Сеанс с экспертом по изгнанию Гостевого завершён. Спасибо, что воспользовались нашими услугами.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490908
    m_Localized: 'Phone: Плата за консультацию спишется в ближайшее время.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490909
    m_Localized: Плата?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490910
    m_Localized: Я думал звонок бесплатный
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490911
    m_Localized: 'Phone: Да, всё верно. Наши эксперты по изгнанию Гостевых должны на что-то жить.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490912
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490913
    m_Localized: 'Phone: Как вы оцените проведённый сеанс?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490914
    m_Localized: Положительно
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684992
    m_Localized: Мне не помогло
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684993
    m_Localized: Идите нахуй, мошенники ебучие
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684994
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684995
    m_Localized: 'Phone: Если вы внимательно смотрели рекламу, там был маленький шрифт, где говорилось, что звонок платный.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684996
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684997
    m_Localized: 'Phone: Как вы оцените проведённый сеанс?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684998
    m_Localized: Положительно
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684999
    m_Localized: Мне не помогло
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685000
    m_Localized: Идите нахуй, мошенники ебучие
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685001
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685002
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685003
    m_Localized: 'Phone: Спасибо, ваше мнение очень ценно нам. Всего доброго.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610048
    m_Localized: 'TV: На этом всё.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610049
    m_Localized: 'TV: Теперь и в ассортименте доставки еды For Rest. Звоните по номеру: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610050
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610051
    m_Localized: 'TV: Несмотря на пожары, Гости продолжают терроризировать население.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610052
    m_Localized: 'TV: КЧС сообщили о новом признаке Гостей...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610053
    m_Localized: 'TV: Далее репортаж о том кто такие Гости.'
    m_Metadata:
      m_Items: []
  - m_Id: 42677628816056320
    m_Localized: Окно в другую комнату. Раньше так экономили электричество, чтобы свет из окна другой комнаты сюда проходил.
    m_Metadata:
      m_Items: []
  - m_Id: 42677628832833536
    m_Localized: Потом его заделали… но только с той стороны.
    m_Metadata:
      m_Items: []
  - m_Id: 42677628832833537
    m_Localized: Нет, туда я не смотрю. Больше не смотрю.
    m_Metadata:
      m_Items: []
  - m_Id: 42677628832833538
    m_Localized: Не люблю спать со стороны тумбочки. Сразу всплывают неприятные воспоминания…
    m_Metadata:
      m_Items: []
  - m_Id: 42677628832833539
    m_Localized: Не понимаю, почему он не в углу стоит. Вроде так должно быть по правилам.
    m_Metadata:
      m_Items: []
  - m_Id: 42677628832833540
    m_Localized: Хотя… бате было похер на правила.
    m_Metadata:
      m_Items: []
  - m_Id: 42677628832833541
    m_Localized: Тотошка. Чуть ли не единственная игрушка моего детства.
    m_Metadata:
      m_Items: []
  - m_Id: 42677628832833542
    m_Localized: Кроме, конечно, палок, которыми мы били траву.
    m_Metadata:
      m_Items: []
  - m_Id: 42677628832833543
    m_Localized: Хах, бабуля по всем этим шкафам распихала посуды.
    m_Metadata:
      m_Items: []
  - m_Id: 42677628832833544
    m_Localized: На случай праздника доставали только этот красивый сервис. А теперь… нахер он кому нужен.
    m_Metadata:
      m_Items: []
  - m_Id: 42677628832833545
    m_Localized: По правде сказать, мне больше нравится быть дома одному.
    m_Metadata:
      m_Items: []
  - m_Id: 42677628832833546
    m_Localized: Так и с собой можно вслух поговорить.
    m_Metadata:
      m_Items: []
  - m_Id: 42677628832833547
    m_Localized: Один из тех журналов, где нужно в толпе найти нужного человечка…
    m_Metadata:
      m_Items: []
  - m_Id: 42677628832833548
    m_Localized: С какого хера надо кого-то искать? Кто бы меня уже в покое оставил…
    m_Metadata:
      m_Items: []
  - m_Id: 42677628832833549
    m_Localized: 'Он тогда сказал: "Когда меня не станет – сам решишь, смотреть или нет в эту коробку."'
    m_Metadata:
      m_Items: []
  - m_Id: 42677628832833550
    m_Localized: Уже пятнадцать лет решаю. И чёт как-то сложно решиться.
    m_Metadata:
      m_Items: []
  - m_Id: 43879331187908608
    m_Localized: 'Phone: А? Алё?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685824
    m_Localized: Ваша жена дала мне этот номер
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685825
    m_Localized: Вашей жене нужна помощь
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685826
    m_Localized: 'Phone: Угу, и чё?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685827
    m_Localized: Она потеряла всех детей
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685828
    m_Localized: Дети у вас?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685829
    m_Localized: 'Phone: Как обычно. Постоянно только я должен всё решать.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685830
    m_Localized: 'Phone: Сама сидит “ой, я устала”.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685831
    m_Localized: 'Phone: Ничего нового.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685832
    m_Localized: Она потеряла всех детей
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685833
    m_Localized: Дети у вас?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685834
    m_Localized: 'Phone: Оооооой. Опять ей похер на своих же детей.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685835
    m_Localized: 'Phone: И мне теперь всё разгребать…'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685836
    m_Localized: 'Phone: У матери жены искали?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685837
    m_Localized: Нет
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685838
    m_Localized: Может, заберёте её отсюда?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685839
    m_Localized: 'Phone: Нет. А они не с ней?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685840
    m_Localized: 'Phone: Я не удивлён.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685841
    m_Localized: 'Phone: У матери жены искали?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685842
    m_Localized: Нет
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685843
    m_Localized: Может, заберёте её отсюда?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685844
    m_Localized: 'Phone: Угу.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685845
    m_Localized: 'Phone: Ну, может, они там.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685846
    m_Localized: 'Phone: Я ж к ней не пойду.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685847
    m_Localized: 'Phone: Пусть она сходит. Скажите ей, что она за мать такая?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685848
    m_Localized: Разбирайтесь сами
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685849
    m_Localized: Короче, скажу, что ты жив и ждёшь
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685850
    m_Localized: 'Phone: Да пусть сама придёт. Не принцесса же.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685851
    m_Localized: 'Phone: Ноги есть у неё? В чём проблема?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685852
    m_Localized: Разбирайтесь сами
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685853
    m_Localized: Короче, скажу, что ты жив и ждёшь
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685854
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685855
    m_Localized: 'Phone: А зачем ты тогда звонил? Помочь бедной женщине в беде?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685856
    m_Localized: 'Phone: Делайте там вместе что хотите, она всё равно безразличная тварь.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685857
    m_Localized: 'Phone: От меня только отъебитесь.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685858
    m_Localized: 'Phone: Короче, скажу, что ты жив и ждёшь'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685859
    m_Localized: 'Phone: Да не стоит ничего говорить. А смысл?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685860
    m_Localized: 'Phone: Нам наплевать друг на друга.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685861
    m_Localized: 'Phone: Зачем ты в это вмешиваешься, я не понимаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685862
    m_Localized: 'Phone: Ладно… бывайте. Живите счастливо.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685863
    m_Localized: 'Phone: Скажите, вы верите в смерть?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685864
    m_Localized: Меня попросил позвонить ваш муж
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685865
    m_Localized: Так, давайте без проповеди. Я по поводу мужа
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685866
    m_Localized: 'Phone: Что? Мой муж?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685867
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685868
    m_Localized: 'Phone: После всего, что он натворил… Я не хочу слышать о нём.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685869
    m_Localized: Он хотел передать, что сожалеет о содеянном
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685870
    m_Localized: Он хотел сказать, чтобы вы шли к чёрту
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685871
    m_Localized: 'Phone: Мужа?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685872
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685873
    m_Localized: 'Phone: После всего, что он натворил… Я не хочу слышать о нём.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685874
    m_Localized: Он хотел передать, что сожалеет о содеянном
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685875
    m_Localized: Он хотел сказать, чтобы вы шли к чёрту
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685876
    m_Localized: 'Phone: Хах, сожалеет!?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685877
    m_Localized: 'Phone: Что, опять?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685878
    m_Localized: 'Phone: Вы, наверное, не в курсе, но он уже просил других извиняться за себя.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685879
    m_Localized: 'Phone: Вот только проблема в том, что он сам не может позвонить мне. А знаете почему?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685880
    m_Localized: 'Phone: У него нет смелости признать свои ошибки. Смириться с тем, что случилось.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685881
    m_Localized: 'Phone: Он надеется исправить всё, сделать как было раньше. Но так не бывает - никто не способен мотать время обратно.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685882
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685883
    m_Localized: 'Phone: Впрочем, сейчас мне гораздо лучше, вместе с теми, кто меня понимает.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685884
    m_Localized: Считаете, горстка фанатиков понимает вас?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685885
    m_Localized: Зачем вы вообще вступили в культ?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685886
    m_Localized: Как скажете
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685887
    m_Localized: 'Phone: Вы можете называть их как угодно, но они - моя семья.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685888
    m_Localized: 'Phone: Мы разделяем взгляд на то, что Смерть вот-вот придёт в наш мир.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685889
    m_Localized: 'Phone: И что она принесёт не страдания, а мир и покой.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685890
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685891
    m_Localized: 'Phone: Всего доброго.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685892
    m_Localized: 'Phone: Потому что мы разделяем общие взгляды на то, что произойдёт дальше - приход Смерти.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685893
    m_Localized: 'Phone: Для вас наверное прозвучит странно, но приход Смерти знаменует собой не горечь, но счастье.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685894
    m_Localized: 'Phone: Счастье спокойствии и отсутствии страданий. Наверняка и вам приходилось непросто в жизни.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685895
    m_Localized: 'Phone: Быть может однажды, вы сами поймёте всё и согласитесь с нашими трактовками происходящего.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685896
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685897
    m_Localized: 'Phone: Всего доброго.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685898
    m_Localized: 'Phone: Спасибо за понимание.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685899
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685900
    m_Localized: 'Phone: Всего доброго.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685901
    m_Localized: 'Phone: Алло, кто это?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685902
    m_Localized: Здравствуйте. Ваш брат дал мне номер
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685903
    m_Localized: Вы можете помочь вашему брату?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685904
    m_Localized: 'Phone: Какой брат? У меня нет…'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685905
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685906
    m_Localized: 'Phone: А, вы про кровного брата, верно?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685907
    m_Localized: 'Phone: Но постойте… Кто вы такой? И почему он у вас?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685908
    m_Localized: Его родители пропали
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685909
    m_Localized: Он пришёл ко мне в поисках убежища
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685910
    m_Localized: 'Phone: Пропали? Как это случилось?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685911
    m_Localized: 'Phone: Вы же не хотите сказать что…'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685912
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685913
    m_Localized: 'Phone: Чёрт… Это невозможно… Они мертвы?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685914
    m_Localized: Я не знаю
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685915
    m_Localized: Скорее всего
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685916
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685917
    m_Localized: 'Phone: В поисках убежища? Но он ведь живёт с родителями?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685918
    m_Localized: 'Phone: Неужели они…'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685919
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685920
    m_Localized: 'Phone: Чёрт… Это невозможно… Они мертвы?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685921
    m_Localized: Я не знаю
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685922
    m_Localized: Скорее всего
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685923
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685924
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685925
    m_Localized: 'Phone: Боже… Как это произошло?…'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685926
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685927
    m_Localized: 'Phone: Я готова приютить брата. Передайте ему это. Он знает мой адрес.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685928
    m_Localized: 'Phone: И… Спасибо вам, что помогли ему.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685929
    m_Localized: 'Phone: До свидания.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685930
    m_Localized: 'Phone: Да? Кто звонит?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685931
    m_Localized: Ваша жена с сестрой у меня дома
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685932
    m_Localized: Мне этот номер дала ваша жена
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685933
    m_Localized: 'Phone: Звучите так, как будто выкуп хотите получить за них.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685934
    m_Localized: 'Phone: Боюсь, у меня ничего не осталось, что я мог бы отдать.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685935
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685936
    m_Localized: 'Phone: Да и отдавать скоро будет некому.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685937
    m_Localized: В смысле? Что с вами?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685938
    m_Localized: С вашей женой всё хорошо
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685939
    m_Localized: 'Phone: Скажите, что она в порядке, пожалуйста.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685940
    m_Localized: 'Phone: Она у меня сильная, сможет пройти через что угодно, да ещё и поможет всем нуждающимся по пути!'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685941
    m_Localized: 'Phone: Но боюсь, что мне уже не помочь.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685942
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685943
    m_Localized: 'Phone: Меня скоро не будет.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685944
    m_Localized: В смысле? Что с вами?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685945
    m_Localized: С вашей женой всё хорошо
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685946
    m_Localized: 'Phone: Я… я просто не могу выдержать это всё. Солнце, Гости, безумные люди. Всё это так страшно. Я чувствую, как меня парализует.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685947
    m_Localized: 'Phone: Я просто… просто хочу, чтобы это закончилось. Мне остался только один единственный выход… понимаете?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685948
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685949
    m_Localized: 'Phone: Скажите ей, пожалуйста, что я её люблю.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685950
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685951
    m_Localized: 'Phone: Хотя… лучше ничего не говорить. Убедитесь, пожалуйста, что она не пойдёт меня искать.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685952
    m_Localized: 'Phone: Не хочу, чтобы она узнала, что я не взял её с собой…'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685953
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685954
    m_Localized: 'Phone: Спасибо, что позвонили. И выслушали.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685955
    m_Localized: 'Phone: Прощайте…'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685956
    m_Localized: 'Phone: Она, наверное, держится за свою сестру. Конечно, она никогда не умела отпускать, хех…'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685957
    m_Localized: 'Phone: Как же ей не повезло, что её окружают только слабые люди. Понимаете, я поэтому и решил от неё уйти.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685958
    m_Localized: 'Phone: Приёмная комиссия КЧС, здравствуйте.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685959
    m_Localized: У меня тут жена КЧС-ника
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685960
    m_Localized: К вам вот один альтруист хочет пойти работать
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685961
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685962
    m_Localized: 'Phone: Хорошо, а вопрос какой? Пока не понимаю, чем могу помочь.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685963
    m_Localized: 'Phone: Если это не угроза.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685964
    m_Localized: … Это угроза
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685965
    m_Localized: Она ищет работу у вас. Была пограничником
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685966
    m_Localized: 'Phone: (Вы слышите, как собеседник громко выдыхает)'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685967
    m_Localized: 'Phone: Вы из активистов, да? Которым вечно ничего не нравится.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685968
    m_Localized: 'Phone: Не тратьте время. Сейчас кто-то пытается дозвониться, кому нужна помощь.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685969
    m_Localized: 'Phone: К кому-то ломятся Гости. Или что ещё хуже происходит. Но из-за вас его убьют.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685970
    m_Localized: 'Phone: До свидания.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685971
    m_Localized: 'Phone: Хм. Она должна знать, что работа… непростая. Она точно готова?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685972
    m_Localized: 'Phone: Если да, пусть заполнит форму 31-Г в трёх экземплярах.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685973
    m_Localized: 'Phone: После этого пройти медкомиссию. Затем заполнить…'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685974
    m_Localized: 'Phone: (Вы бросаете трубку. Зачем вы вообще звонили ради этой женщины?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685975
    m_Localized: 'Phone: А на какую позицию? Надеюсь, не директором.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685976
    m_Localized: 'Phone: Это уже будет третий на сегодня.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685977
    m_Localized: Директором
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685978
    m_Localized: Ищейкой. Или выслеживателем каким
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685979
    m_Localized: 'Phone: Как же заебали эти шутники.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685980
    m_Localized: 'Phone: Пока вы занимаете линию, кто-то не может дозвониться. Возможно, кого-то сейчас убивают Гости.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685981
    m_Localized: 'Phone: Ощути на себе груз тупой шутки не вовремя.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685982
    m_Localized: 'Phone: (Они бросили трубку. Надо же)'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685983
    m_Localized: 'Phone: У нас нет таких вакансий. Нам очень не хватает экспертов по эпидемиям и квалифицированных ученых.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685984
    m_Localized: 'Phone: Ваш знакомый, похоже, нам не подходит.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685985
    m_Localized: 'Phone: Знаете что? Сейчас очень быстро все меняется, перезвоните через неделю.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685986
    m_Localized: 'Phone: Наверняка, будет место для… как вы сказали… альтруиста.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685987
    m_Localized: 'Phone: Строение яблока: надъяблочник, страна грибов и бумаги.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685988
    m_Localized: 'Phone: Бойся ты … гр…'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685989
    m_Localized: 'Phone: Хоть и манят её зву…,'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685990
    m_Localized: 'Phone: Встре… ничего'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685991
    m_Localized: 'Phone: Кроме плача и разлуки.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685992
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685993
    m_Localized: 'Phone: Проверь её дыхание.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685994
    m_Localized: 'Phone: Почему ты не отвечаешь? Я желаю умереть.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685995
    m_Localized: 'Phone: (Собеседник бросает трубку. Это было… не совсем то, чего вы ожидали.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685996
    m_Localized: 'Phone: Обращаем внимание, что сейчас нет возможности отправиться в нашу страну самолётом или поездом.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685997
    m_Localized: 'Phone: Слушаю вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685998
    m_Localized: Мне бы отправить на родину туриста
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204685999
    m_Localized: Почему поездом нельзя?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686000
    m_Localized: 'Phone: Лучше дождаться, пока не откроют возможность перелётов.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686001
    m_Localized: 'Phone: Сейчас доступны паромы, но не получится доплыть – слишком велик риск ночных тайфунов.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686002
    m_Localized: 'Phone: Плюс, вода отражает солнце на корабли, экипаж не выдерживает долгое пребывание на воде.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686003
    m_Localized: И как мне отправить домой бедолагу?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686004
    m_Localized: Он у меня живёт. Может, вы его там к себе возьмёте?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686005
    m_Localized: 'Phone: Рельсы от нагрева расширились, опасно ездить днём.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686006
    m_Localized: 'Phone: Поезда идут только ночью, поэтому на дальние расстояния не уехать.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686007
    m_Localized: 'Phone: Будет слишком много пересадок. Легче дождаться, когда разрешать авиатранспорт.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686008
    m_Localized: И как мне отправить домой бедолагу?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686009
    m_Localized: Он у меня живёт. Может, вы его там к себе возьмёте?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686010
    m_Localized: 'Phone: Просто подождите.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686011
    m_Localized: 'Phone: Сейчас больше ничего не сделать.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686012
    m_Localized: Он языка даже не знает
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686013
    m_Localized: Нахер вы нужны, если ничего сделать не можете?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686014
    m_Localized: 'Phone: У нас нет гостиниц.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686015
    m_Localized: 'Phone: Ничего не можем сделать. Мы пытаемся решить проблему, он не один с такой проблемой.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686016
    m_Localized: Он языка даже не знает
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686017
    m_Localized: Нахер вы нужны, если ничего сделать не можете?
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686018
    m_Localized: 'Phone: Наши сотрудники все заняты. Вы слышали, может, что штаты посольств сильно урезают.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686019
    m_Localized: 'Phone: Всё, что мы можем – делаем.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686020
    m_Localized: Какие ж вы молодцы
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686021
    m_Localized: Ненавижу бездельников
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686022
    m_Localized: 'Phone: Не стоит так разговаривать.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686023
    m_Localized: 'Phone: Мы его на руках тоже домой не отвезём. Если так хотите помочь, отвезите вы.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686024
    m_Localized: 'Phone: Бюджеты срезали настолько, что мы почти на энтузиазме работаем.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686025
    m_Localized: Какие ж вы молодцы
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686026
    m_Localized: Ненавижу бездельников
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686027
    m_Localized: 'Phone: Не устраивает наша работа – делайте всё сами.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686028
    m_Localized: 'Phone: Удачи переехать в другую страну при проверках на Гостя и дневной жаре.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686029
    m_Localized: Ладно, спасибо
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686030
    m_Localized: Сходи нахуй
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686031
    m_Localized: 'Phone: Тогда почему вы дома, а не на работе?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686032
    m_Localized: 'Phone: Или, может, придёте и сделаете правильно, если знаете как?'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686033
    m_Localized: 'Phone: Нам очень нужна помощь людей, которые всё знают лучше всех.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686034
    m_Localized: Ладно, спасибо
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686035
    m_Localized: Сходи нахуй
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686036
    m_Localized: 'Phone: Извините за грубость.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686037
    m_Localized: 'Phone: Вы просто не первый кто звонит… в очень недовольном состоянии.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686038
    m_Localized: 'Phone: Хорошего дня.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686039
    m_Localized: 'Phone: Удачной дороги.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686040
    m_Localized: 'Phone: Надеюсь, обязательно захотите выехать куда-нибудь.'
    m_Metadata:
      m_Items: []
  - m_Id: 43879331204686041
    m_Localized: 'Phone: Обязательно вам помогу.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113249218560
    m_Localized: 'Phone: А? Алё?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995776
    m_Localized: Ваша жена дала мне этот номер
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995777
    m_Localized: Вашей жене нужна помощь
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995778
    m_Localized: 'Phone: Угу, и чё?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995779
    m_Localized: Она потеряла всех детей
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995780
    m_Localized: Дети у вас?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995781
    m_Localized: 'Phone: Как обычно. Постоянно только я должен всё решать.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995782
    m_Localized: 'Phone: Сама сидит “ой, я устала”.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995783
    m_Localized: 'Phone: Ничего нового.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995784
    m_Localized: Она потеряла всех детей
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995785
    m_Localized: Дети у вас?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995786
    m_Localized: 'Phone: Оооооой. Опять ей похер на своих же детей.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995787
    m_Localized: 'Phone: И мне теперь всё разгребать…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995788
    m_Localized: 'Phone: У матери жены искали?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995789
    m_Localized: Нет
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995790
    m_Localized: Может, заберёте её отсюда?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995791
    m_Localized: 'Phone: Нет. А они не с ней?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995792
    m_Localized: 'Phone: Я не удивлён.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995793
    m_Localized: 'Phone: У матери жены искали?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995794
    m_Localized: Нет
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995795
    m_Localized: Может, заберёте её отсюда?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995796
    m_Localized: 'Phone: Угу.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995797
    m_Localized: 'Phone: Ну, может, они там.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995798
    m_Localized: 'Phone: Я ж к ней не пойду.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995799
    m_Localized: 'Phone: Пусть она сходит. Скажите ей, что она за мать такая?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995800
    m_Localized: Разбирайтесь сами
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995801
    m_Localized: Короче, скажу, что ты жив и ждёшь
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995802
    m_Localized: 'Phone: Да пусть сама придёт. Не принцесса же.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995803
    m_Localized: 'Phone: Ноги есть у неё? В чём проблема?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995804
    m_Localized: Разбирайтесь сами
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995805
    m_Localized: Короче, скажу, что ты жив и ждёшь
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995806
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995807
    m_Localized: 'Phone: А зачем ты тогда звонил? Помочь бедной женщине в беде?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995808
    m_Localized: 'Phone: Делайте там вместе что хотите, она всё равно безразличная тварь.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995809
    m_Localized: 'Phone: От меня только отъебитесь.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995810
    m_Localized: 'Phone: Короче, скажу, что ты жив и ждёшь'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995811
    m_Localized: 'Phone: Да не стоит ничего говорить. А смысл?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995812
    m_Localized: 'Phone: Нам наплевать друг на друга.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995813
    m_Localized: 'Phone: Зачем ты в это вмешиваешься, я не понимаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995814
    m_Localized: 'Phone: Ладно… бывайте. Живите счастливо.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995815
    m_Localized: 'Phone: Скажите, вы верите в смерть?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995816
    m_Localized: Меня попросил позвонить ваш муж
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995817
    m_Localized: Так, давайте без проповеди. Я по поводу мужа
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995818
    m_Localized: 'Phone: Что? Мой муж?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995819
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995820
    m_Localized: 'Phone: После всего, что он натворил… Я не хочу слышать о нём.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995821
    m_Localized: Он хотел передать, что сожалеет о содеянном
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995822
    m_Localized: Он хотел сказать, чтобы вы шли к чёрту
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995823
    m_Localized: 'Phone: Мужа?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995824
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995825
    m_Localized: 'Phone: После всего, что он натворил… Я не хочу слышать о нём.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995826
    m_Localized: Он хотел передать, что сожалеет о содеянном
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995827
    m_Localized: Он хотел сказать, чтобы вы шли к чёрту
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995828
    m_Localized: 'Phone: Хах, сожалеет!?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995829
    m_Localized: 'Phone: Что, опять?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995830
    m_Localized: 'Phone: Вы, наверное, не в курсе, но он уже просил других извиняться за себя.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995831
    m_Localized: 'Phone: Вот только проблема в том, что он сам не может позвонить мне. А знаете почему?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995832
    m_Localized: 'Phone: У него нет смелости признать свои ошибки. Смириться с тем, что случилось.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995833
    m_Localized: 'Phone: Он надеется исправить всё, сделать как было раньше. Но так не бывает - никто не способен мотать время обратно.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995834
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995835
    m_Localized: 'Phone: Впрочем, сейчас мне гораздо лучше, вместе с теми, кто меня понимает.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995836
    m_Localized: Считаете, горстка фанатиков понимает вас?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995837
    m_Localized: Зачем вы вообще вступили в культ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995838
    m_Localized: Как скажете
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995839
    m_Localized: 'Phone: Вы можете называть их как угодно, но они - моя семья.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995840
    m_Localized: 'Phone: Мы разделяем взгляд на то, что Смерть вот-вот придёт в наш мир.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995841
    m_Localized: 'Phone: И что она принесёт не страдания, а мир и покой.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995842
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995843
    m_Localized: 'Phone: Всего доброго.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995844
    m_Localized: 'Phone: Потому что мы разделяем общие взгляды на то, что произойдёт дальше - приход Смерти.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995845
    m_Localized: 'Phone: Для вас наверное прозвучит странно, но приход Смерти знаменует собой не горечь, но счастье.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995846
    m_Localized: 'Phone: Счастье спокойствии и отсутствии страданий. Наверняка и вам приходилось непросто в жизни.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995847
    m_Localized: 'Phone: Быть может однажды, вы сами поймёте всё и согласитесь с нашими трактовками происходящего.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995848
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995849
    m_Localized: 'Phone: Всего доброго.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995850
    m_Localized: 'Phone: Спасибо за понимание.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995851
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995852
    m_Localized: 'Phone: Всего доброго.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995853
    m_Localized: 'Phone: Алло, кто это?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995854
    m_Localized: Здравствуйте. Ваш брат дал мне номер
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995855
    m_Localized: Вы можете помочь вашему брату?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995856
    m_Localized: 'Phone: Какой брат? У меня нет…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995857
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995858
    m_Localized: 'Phone: А, вы про кровного брата, верно?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995859
    m_Localized: 'Phone: Но постойте… Кто вы такой? И почему он у вас?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995860
    m_Localized: Его родители пропали
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995861
    m_Localized: Он пришёл ко мне в поисках убежища
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995862
    m_Localized: 'Phone: Пропали? Как это случилось?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995863
    m_Localized: 'Phone: Вы же не хотите сказать что…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995864
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995865
    m_Localized: 'Phone: Чёрт… Это невозможно… Они мертвы?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995866
    m_Localized: Я не знаю
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995867
    m_Localized: Скорее всего
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995868
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995869
    m_Localized: 'Phone: В поисках убежища? Но он ведь живёт с родителями?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995870
    m_Localized: 'Phone: Неужели они…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995871
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995872
    m_Localized: 'Phone: Чёрт… Это невозможно… Они мертвы?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995873
    m_Localized: Я не знаю
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995874
    m_Localized: Скорее всего
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995875
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995876
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995877
    m_Localized: 'Phone: Боже… Как это произошло?…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995878
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995879
    m_Localized: 'Phone: Я готова приютить брата. Передайте ему это. Он знает мой адрес.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995880
    m_Localized: 'Phone: И… Спасибо вам, что помогли ему.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995881
    m_Localized: 'Phone: До свидания.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995882
    m_Localized: 'Phone: Да? Кто звонит?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995883
    m_Localized: Ваша жена с сестрой у меня дома
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995884
    m_Localized: Мне этот номер дала ваша жена
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995885
    m_Localized: 'Phone: Звучите так, как будто выкуп хотите получить за них.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995886
    m_Localized: 'Phone: Боюсь, у меня ничего не осталось, что я мог бы отдать.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995887
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995888
    m_Localized: 'Phone: Да и отдавать скоро будет некому.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995889
    m_Localized: В смысле? Что с вами?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995890
    m_Localized: С вашей женой всё хорошо
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995891
    m_Localized: 'Phone: Скажите, что она в порядке, пожалуйста.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995892
    m_Localized: 'Phone: Она у меня сильная, сможет пройти через что угодно, да ещё и поможет всем нуждающимся по пути!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995893
    m_Localized: 'Phone: Но боюсь, что мне уже не помочь.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995894
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995895
    m_Localized: 'Phone: Меня скоро не будет.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995896
    m_Localized: В смысле? Что с вами?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995897
    m_Localized: С вашей женой всё хорошо
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995898
    m_Localized: 'Phone: Я… я просто не могу выдержать это всё. Солнце, Гости, безумные люди. Всё это так страшно. Я чувствую, как меня парализует.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995899
    m_Localized: 'Phone: Я просто… просто хочу, чтобы это закончилось. Мне остался только один единственный выход… понимаете?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995900
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995901
    m_Localized: 'Phone: Скажите ей, пожалуйста, что я её люблю.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995902
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995903
    m_Localized: 'Phone: Хотя… лучше ничего не говорить. Убедитесь, пожалуйста, что она не пойдёт меня искать.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995904
    m_Localized: 'Phone: Не хочу, чтобы она узнала, что я не взял её с собой…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995905
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995906
    m_Localized: 'Phone: Спасибо, что позвонили. И выслушали.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995907
    m_Localized: 'Phone: Прощайте…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995908
    m_Localized: 'Phone: Она, наверное, держится за свою сестру. Конечно, она никогда не умела отпускать, хех…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995909
    m_Localized: 'Phone: Как же ей не повезло, что её окружают только слабые люди. Понимаете, я поэтому и решил от неё уйти.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995910
    m_Localized: 'Phone: Приёмная комиссия КЧС, здравствуйте.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995911
    m_Localized: У меня тут жена КЧС-ника
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995912
    m_Localized: К вам вот один альтруист хочет пойти работать
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995913
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995914
    m_Localized: 'Phone: Хорошо, а вопрос какой? Пока не понимаю, чем могу помочь.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995915
    m_Localized: 'Phone: Если это не угроза.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995916
    m_Localized: … Это угроза
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995917
    m_Localized: Она ищет работу у вас. Была пограничником
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995918
    m_Localized: 'Phone: (Вы слышите, как собеседник громко выдыхает)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995919
    m_Localized: 'Phone: Вы из активистов, да? Которым вечно ничего не нравится.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995920
    m_Localized: 'Phone: Не тратьте время. Сейчас кто-то пытается дозвониться, кому нужна помощь.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995921
    m_Localized: 'Phone: К кому-то ломятся Гости. Или что ещё хуже происходит. Но из-за вас его убьют.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995922
    m_Localized: 'Phone: До свидания.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995923
    m_Localized: 'Phone: Хм. Она должна знать, что работа… непростая. Она точно готова?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995924
    m_Localized: 'Phone: Если да, пусть заполнит форму 31-Г в трёх экземплярах.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995925
    m_Localized: 'Phone: После этого пройти медкомиссию. Затем заполнить…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995926
    m_Localized: 'Phone: (Вы бросаете трубку. Зачем вы вообще звонили ради этой женщины?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995927
    m_Localized: 'Phone: А на какую позицию? Надеюсь, не директором.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995928
    m_Localized: 'Phone: Это уже будет третий на сегодня.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995929
    m_Localized: Директором
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995930
    m_Localized: Ищейкой. Или выслеживателем каким
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995931
    m_Localized: 'Phone: Как же заебали эти шутники.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995932
    m_Localized: 'Phone: Пока вы занимаете линию, кто-то не может дозвониться. Возможно, кого-то сейчас убивают Гости.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995933
    m_Localized: 'Phone: Ощути на себе груз тупой шутки не вовремя.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995934
    m_Localized: 'Phone: (Они бросили трубку. Надо же)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995935
    m_Localized: 'Phone: У нас нет таких вакансий. Нам очень не хватает экспертов по эпидемиям и квалифицированных ученых.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995936
    m_Localized: 'Phone: Ваш знакомый, похоже, нам не подходит.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995937
    m_Localized: 'Phone: Знаете что? Сейчас очень быстро все меняется, перезвоните через неделю.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995938
    m_Localized: 'Phone: Наверняка, будет место для… как вы сказали… альтруиста.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995939
    m_Localized: 'Phone: Строение яблока: надъяблочник, страна грибов и бумаги.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995940
    m_Localized: 'Phone: Бойся ты … гр…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995941
    m_Localized: 'Phone: Хоть и манят её зву…,'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995942
    m_Localized: 'Phone: Встре… ничего'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995943
    m_Localized: 'Phone: Кроме плача и разлуки.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995944
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995945
    m_Localized: 'Phone: Проверь её дыхание.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995946
    m_Localized: 'Phone: Почему ты не отвечаешь? Я желаю умереть.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995947
    m_Localized: 'Phone: (Собеседник бросает трубку. Это было… не совсем то, чего вы ожидали.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995948
    m_Localized: 'Phone: Обращаем внимание, что сейчас нет возможности отправиться в нашу страну самолётом или поездом.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995949
    m_Localized: 'Phone: Слушаю вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995950
    m_Localized: Мне бы отправить на родину туриста
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995951
    m_Localized: Почему поездом нельзя?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995952
    m_Localized: 'Phone: Лучше дождаться, пока не откроют возможность перелётов.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995953
    m_Localized: 'Phone: Сейчас доступны паромы, но не получится доплыть – слишком велик риск ночных тайфунов.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995954
    m_Localized: 'Phone: Плюс, вода отражает солнце на корабли, экипаж не выдерживает долгое пребывание на воде.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995955
    m_Localized: И как мне отправить домой бедолагу?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995956
    m_Localized: Он у меня живёт. Может, вы его там к себе возьмёте?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995957
    m_Localized: 'Phone: Рельсы от нагрева расширились, опасно ездить днём.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995958
    m_Localized: 'Phone: Поезда идут только ночью, поэтому на дальние расстояния не уехать.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995959
    m_Localized: 'Phone: Будет слишком много пересадок. Легче дождаться, когда разрешать авиатранспорт.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995960
    m_Localized: И как мне отправить домой бедолагу?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995961
    m_Localized: Он у меня живёт. Может, вы его там к себе возьмёте?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995962
    m_Localized: 'Phone: Просто подождите.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995963
    m_Localized: 'Phone: Сейчас больше ничего не сделать.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995964
    m_Localized: Он языка даже не знает
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995965
    m_Localized: Нахер вы нужны, если ничего сделать не можете?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995966
    m_Localized: 'Phone: У нас нет гостиниц.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995967
    m_Localized: 'Phone: Ничего не можем сделать. Мы пытаемся решить проблему, он не один с такой проблемой.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995968
    m_Localized: Он языка даже не знает
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995969
    m_Localized: Нахер вы нужны, если ничего сделать не можете?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995970
    m_Localized: 'Phone: Наши сотрудники все заняты. Вы слышали, может, что штаты посольств сильно урезают.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995971
    m_Localized: 'Phone: Всё, что мы можем – делаем.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995972
    m_Localized: Какие ж вы молодцы
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995973
    m_Localized: Ненавижу бездельников
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995974
    m_Localized: 'Phone: Не стоит так разговаривать.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995975
    m_Localized: 'Phone: Мы его на руках тоже домой не отвезём. Если так хотите помочь, отвезите вы.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995976
    m_Localized: 'Phone: Бюджеты срезали настолько, что мы почти на энтузиазме работаем.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995977
    m_Localized: Какие ж вы молодцы
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995978
    m_Localized: Ненавижу бездельников
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995979
    m_Localized: 'Phone: Не устраивает наша работа – делайте всё сами.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995980
    m_Localized: 'Phone: Удачи переехать в другую страну при проверках на Гостя и дневной жаре.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995981
    m_Localized: Ладно, спасибо
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995982
    m_Localized: Сходи нахуй
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995983
    m_Localized: 'Phone: Тогда почему вы дома, а не на работе?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995984
    m_Localized: 'Phone: Или, может, придёте и сделаете правильно, если знаете как?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995985
    m_Localized: 'Phone: Нам очень нужна помощь людей, которые всё знают лучше всех.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995986
    m_Localized: Ладно, спасибо
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995987
    m_Localized: Сходи нахуй
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995988
    m_Localized: 'Phone: Извините за грубость.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995989
    m_Localized: 'Phone: Вы просто не первый кто звонит… в очень недовольном состоянии.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995990
    m_Localized: 'Phone: Хорошего дня.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995991
    m_Localized: 'Phone: Удачной дороги.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995992
    m_Localized: 'Phone: Надеюсь, обязательно захотите выехать куда-нибудь.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995993
    m_Localized: 'Phone: Обязательно вам помогу.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995994
    m_Localized: Окно в другую комнату. Раньше так экономили электричество, чтобы свет из окна другой комнаты сюда проходил.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995995
    m_Localized: Потом его заделали… но только с той стороны.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995996
    m_Localized: Нет, туда я не смотрю. Больше не смотрю.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995997
    m_Localized: Не люблю спать со стороны тумбочки. Сразу всплывают неприятные воспоминания…
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995998
    m_Localized: Не понимаю, почему он не в углу стоит. Вроде так должно быть по правилам.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995999
    m_Localized: Хотя… бате было похер на правила.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996000
    m_Localized: Тотошка. Чуть ли не единственная игрушка моего детства.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996001
    m_Localized: Кроме, конечно, палок, которыми мы били траву.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996002
    m_Localized: Хах, бабуля по всем этим шкафам распихала посуды.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996003
    m_Localized: На случай праздника доставали только этот красивый сервиз. А теперь… нахер он кому нужен.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996004
    m_Localized: По правде сказать, мне больше нравится быть дома одному.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996005
    m_Localized: Так и с собой можно вслух поговорить.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996006
    m_Localized: Один из тех журналов, где нужно в толпе найти нужного человечка…
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996007
    m_Localized: С какого хера надо кого-то искать? Кто бы меня уже в покое оставил…
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996008
    m_Localized: 'Он тогда сказал: "Когда меня не станет – сам решишь, смотреть или нет в эту коробку."'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996009
    m_Localized: Уже пятнадцать лет решаю. И чёт как-то сложно решиться.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295719612416
    m_Localized: Вы чувствуете себя одиноко?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583936
    m_Localized: Не с кем поговорить и чувствуете тревогу?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583937
    m_Localized: Тогда телефонная рулетка - то, что вам нужно.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583938
    m_Localized: Звоните прямо сейчас по номеру 891-533 и мы подберём для вас идеального собеседника.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583939
    m_Localized: Твоя дочь в порядке?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583940
    m_Localized: Кто их убил?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583941
    m_Localized: Будь осторожнее (Завершить звонок)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583942
    m_Localized: Твоя дочь в порядке?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583943
    m_Localized: Кто их убил?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583944
    m_Localized: Будь осторожнее (Завершить звонок)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583945
    m_Localized: Куда они забрали твоего жильца?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583946
    m_Localized: Хорошо, что они не забрали твою дочь
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583947
    m_Localized: Кто такие КЧС?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583948
    m_Localized: Береги себя (Завершить звонок)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583949
    m_Localized: Куда они забрали твоего жильца?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583950
    m_Localized: Хорошо, что они не забрали твою дочь
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583951
    m_Localized: Кто такие КЧС?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583952
    m_Localized: Береги себя (Завершить звонок)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583953
    m_Localized: Куда они забрали твоего жильца?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583954
    m_Localized: Хорошо, что они не забрали твою дочь
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583955
    m_Localized: Кто такие КЧС?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583956
    m_Localized: Береги себя (Завершить звонок)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583957
    m_Localized: 'Phone: Здравствуйте, вы позвонили на горячую линию КЧС. Чем вам помочь?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583958
    m_Localized: Что? КЧС? Это ещё что?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583959
    m_Localized: О чём вы?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583960
    m_Localized: 'Phone: (Не успела женщина ответить, как раздался громкий мужской вопль)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583961
    m_Localized: 'Phone: ТЫ СОВСЕМ ДУРА?! ЖИВО ПОЛОЖИ ТРУБКУ!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583962
    m_Localized: Что мне делать с подмышками?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583963
    m_Localized: Что мне делать с ушами?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583964
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583965
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583966
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583967
    m_Localized: 'Phone: Чтобы анализы подмышек получились правильными, вам необходимо избегать любых контактов с водой.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583968
    m_Localized: 'Phone: Воздержитесь от принятия душа и мытья рук.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583969
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583970
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583971
    m_Localized: 'Phone: Уши? Подождите...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583972
    m_Localized: 'Phone: Мы проконсультируемся с начальством и сообщим позже.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583973
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583974
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583975
    m_Localized: 'Phone: Хорошо, тогда скажите, вы потребляете в пищу грибы?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583976
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583977
    m_Localized: 'Phone: Что ж, тогда последний вопрос: скажите, у вас проливалась кровь дома?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583978
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583979
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778240
    m_Localized: 'Phone: Здравствуйте, вы позвонили в телефонную рулетку. Сейчас мы подберём вам идеального собеседника. Ожидайте.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778241
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778242
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778243
    m_Localized: 'Phone: Алло, здравствуйте.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778244
    m_Localized: Здравствуйте
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778245
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778246
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778247
    m_Localized: 'Phone: Алло?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778248
    m_Localized: Здравствуйте
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778249
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778250
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778251
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778252
    m_Localized: 'Phone: Видимо никого нет…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778253
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778254
    m_Localized: 'Phone: Я… Мне надо кому-то выговориться. Столько всего произошло за последнее время…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778255
    m_Localized: 'Phone: Я пыталась связаться со своими друзьями и знакомыми, но никто не отвечает…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778256
    m_Localized: 'Phone: А потом я узнала про телефонную рулетку.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778257
    m_Localized: 'Phone: Возможно, не лучшее место, для изливания души, но лучше, чем ничего.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778258
    m_Localized: 'Phone: Я понимаю, что неправильно грузить неизвестного человека своими проблемами, но…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778259
    m_Localized: 'Phone: Вы не представляете, как поможете мне простым разговором. Так я буду чувствовать себя гораздо спокойнее.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778260
    m_Localized: 'Phone: Вы не против послушать меня?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778261
    m_Localized: Хорошо
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778262
    m_Localized: Я не готов к долгому разговору
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778263
    m_Localized: 'Phone: Оу…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778264
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778265
    m_Localized: 'Phone: Хорошо, извините если я вас побеспокоила.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778266
    m_Localized: 'Phone: До свидания.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778267
    m_Localized: 'Phone: Спасибо вам огромное. Спасибо!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778268
    m_Localized: 'Phone: Думаю, чтобы нам было проще, я могу что-нибудь о себе рассказать.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778269
    m_Localized: 'Phone: Что бы вы хотели узнать?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778270
    m_Localized: Где вы живёте?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778271
    m_Localized: Почему вы решили позвонить сюда, а не своим друзьям?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778272
    m_Localized: 'Phone: К сожалению, я очень далеко от дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778273
    m_Localized: 'Phone: В попытке сбежать от огненной жары я искала место, где холоднее всего.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778274
    m_Localized: 'Phone: Поэтому я почти на краю света. Здесь ужасно холодный климат, пробирающий до костей, а трава почти не растёт.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778275
    m_Localized: 'Phone: Почти безопасный клочок земли у чёрта на рогах.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778276
    m_Localized: 'Phone: Но раз даже в аду на девятом кругу есть холодное место, значит… всё не так уж плохо.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778277
    m_Localized: 'Phone: Забавно, раньше я терпеть не могла холод, а сейчас… он – самая настоящая благодать для меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778278
    m_Localized: 'Phone: Очень хочется верить, что солнце перестанет гореть так сильно и всё это закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778279
    m_Localized: 'Phone: Но я почти перестала верить в хороший исход. Что будет, когда солнце закончит жечь нас?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778280
    m_Localized: 'Phone: Ведь Гости могут никуда не пропасть. Заменить наших друзей и близких, а мы даже не узнаем об этом…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778281
    m_Localized: Почему вы отправились одна?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778282
    m_Localized: Вы тоскуете по своему родному городу?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778283
    m_Localized: 'Phone: Я бы с радостью им позвонила, но… Я не знаю как мне с ними связаться…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778284
    m_Localized: 'Phone: Дело в том, что когда начался катаклизм, я решила покинуть свой родной город. Улететь как можно дальше от жары.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778285
    m_Localized: 'Phone: Я пообещала всем, что буду регулярно звонить, с каждым общаться, спрашивать, как дела…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778286
    m_Localized: 'Phone: Но когда я прилетела, не могла ни до кого дозвониться.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778287
    m_Localized: 'Phone: И позже я узнала в чём причина - у них отрубили телефонные линии.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778288
    m_Localized: 'Phone: Весь город оказался отрезан от остального мира.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778289
    m_Localized: 'Phone: Теперь я здесь, в безопасности, но все мои друзья…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778290
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778291
    m_Localized: 'Phone: Мне страшно от мысли, что, возможно, я больше никогда не увижу тех, кто был мне дорог…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778292
    m_Localized: 'Phone: Тоскую по спокойным временам, когда можно было просто жить и думать о будущем.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778293
    m_Localized: Почему вы отправились одна?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778294
    m_Localized: Вы тоскуете по своему родному городу?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778295
    m_Localized: 'Phone: Я не хотела улетать одна. Но…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778296
    m_Localized: 'Phone: На самом деле, мой лучший друг хотел полететь со мной, но не смог…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778297
    m_Localized: 'Phone: У него не было документов, чтобы он мог отправиться в путь со мной.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778298
    m_Localized: 'Phone: А когда начался катаклизм, сделать их уже было нельзя.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778299
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778300
    m_Localized: 'Phone: Он так сокрушался об этом... Жалел, что не сделал их раньше. Я хотела помочь ему, но не знала чем.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778301
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778302
    m_Localized: 'Phone: Тоскую. Но скорее не по родному городу, а по людям, которые там остались…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778303
    m_Localized: 'Phone: И больше всего по моему лучшему другу…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778304
    m_Localized: 'Phone: Он хотел поехать со мной, но не смог. И я пообещала ему, что мы будем поддерживать связь, что позвоню ему. Но…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778305
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778306
    m_Localized: 'Phone: Думаю, он был влюблен в меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778307
    m_Localized: 'Phone: Он так заботился обо мне. Всегда поддерживал, всегда готов был выслушать.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778308
    m_Localized: 'Phone: И потом поняла, что мы нравимся друг другу.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778309
    m_Localized: 'Phone: Я ждала, пока он признается в чувствах. Хотела, чтобы он сделал это первым. Но он всё не мог решиться, не мог подобрать момент.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778310
    m_Localized: 'Phone: А потом… Начался катаклизм, и на это не было времени.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778311
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778312
    m_Localized: 'Phone: Жалею, что первой не призналась…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778313
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778314
    m_Localized: 'Phone: Что ж, теперь вы знаете немного обо мне. Теперь ваша очередь рассказать о себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778315
    m_Localized: Я не привык говорить о себе…
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778316
    m_Localized: Даже не знаю…
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778317
    m_Localized: 'Phone: Не стесняйтесь, я готова выслушать вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778318
    m_Localized: Ну, у меня… нет близких
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778319
    m_Localized: Я… одинокий человек
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778320
    m_Localized: 'Phone: Не переживайте, нет ничего страшного в том, чтобы рассказать о себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972544
    m_Localized: Ну, у меня… нет близких
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972545
    m_Localized: Я… одинокий человек
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972546
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972547
    m_Localized: У меня… были сложные отношения с отцом
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972548
    m_Localized: Мой отец… Я его ненавидел
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972549
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972550
    m_Localized: Теперь я больше не часть семьи
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972551
    m_Localized: И однажды я перестал быть для него сыном
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972555
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972556
    m_Localized: И всё, что у меня есть – это проклятый дом
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972557
    m_Localized: Теперь, всё что осталось от них – это дом
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972558
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972559
    m_Localized: 'Phone: Я…очень сочувствую вам... Похоже, вы очень не рады тому, что этот дом достался вам.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972560
    m_Localized: Это так
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972561
    m_Localized: Лучше бы он сгорел
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972562
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972563
    m_Localized: 'Phone: Мне… тяжело представить, через что вы прошли…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972564
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972565
    m_Localized: 'Phone: Не представляю, насколько вы ненавидите отца, если хотите чтобы дом сгорел…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972566
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972567
    m_Localized: 'Phone: Ещё раз спасибо вам за эту беседу.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972568
    m_Localized: 'Phone: До свидания. И сил вам.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972569
    m_Localized: 'Phone: Алло?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972570
    m_Localized: Здравствуйте, можно поговорить с вашей дочерью?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972571
    m_Localized: Здравствуйте, пустите вашу дочь в гости поиграть с её подругой?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972572
    m_Localized: 'Phone: Что? Зачем это вам нужно поговорить с ней?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972573
    m_Localized: Я хочу позвать вашу дочь к нам в гости. Её подруга просит
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972574
    m_Localized: У меня тут девочка, у которой умер отец
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972575
    m_Localized: 'Phone: Он... он тоже, что ли, был Гостем?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972576
    m_Localized: В смысле тоже?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972577
    m_Localized: Нет, какие-то ебанаты сожгли его ни за что
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972578
    m_Localized: 'Phone: Никто не будет жечь людей просто так.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972579
    m_Localized: 'Phone: Получается, он был Гостем. Так же, как и наша доченька.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972580
    m_Localized: 'Phone: Её тоже сожгли.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972581
    m_Localized: 'Phone: Прямо в её детском садике.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972582
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972583
    m_Localized: 'Phone: Я сначала рыдала. Хотела убить себя. Не могла жить без неё.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972584
    m_Localized: 'Phone: Но муж помог справиться с этим.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972585
    m_Localized: 'Phone: И вы тоже справитесь. И девочка эта.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972586
    m_Localized: 'Phone: Понимаете...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972587
    m_Localized: 'Phone: Ничего не делается просто так.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972588
    m_Localized: 'Phone: Если её отца сожгли, то так оно и должно быть.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972589
    m_Localized: 'Phone: И уж тем более слезами тут не поможешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972590
    m_Localized: 'Phone: Пожалуйста, передайте эти слова девочке.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972591
    m_Localized: 'Phone: И прощайте.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972592
    m_Localized: 'Phone: Наша доченька... она...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972593
    m_Localized: 'Phone: Она умерла...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972594
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972595
    m_Localized: 'Phone: Нам пришлось...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972596
    m_Localized: 'Phone: Нам пришлось её убить.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972597
    m_Localized: Что?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972598
    m_Localized: (Повесить трубку)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972599
    m_Localized: 'Phone: Убили её. Поймите, так надо было.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972600
    m_Localized: 'Phone: Все признаки совпадали и муж настоял.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972601
    m_Localized: И вы решили убить своего ребёнка?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972602
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972603
    m_Localized: 'Phone: Не вам меня осуждать!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972604
    m_Localized: 'Phone: Она точно была Гостем! Признаки совпадали на все сто процентов!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972605
    m_Localized: Пиздец...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972606
    m_Localized: Понимаю
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972607
    m_Localized: 'Phone: Она была Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972608
    m_Localized: 'Phone: По всем признакам.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972609
    m_Localized: 'Phone: Я ведь знала её, как облупленную.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972610
    m_Localized: 'Phone: Поэтому я сразу заметила, как появились эти признаки.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972611
    m_Localized: 'Phone: Всё совпадало.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972612
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972613
    m_Localized: 'Phone: Как только я сказала об этом мужу, так он...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972614
    m_Localized: 'Phone: Он сразу разобрался с этим Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972615
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972616
    m_Localized: 'Phone: Сначала я хотела его самого убить.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972617
    m_Localized: 'Phone: Но потом я поняла, что это и не была наша дочь.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972618
    m_Localized: 'Phone: Муж помог мне это понять.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972619
    m_Localized: 'Phone: Теперь мне только жаль, что мы не узнали у подменной дочери, что оно сделало с нашей малюткой...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972620
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972621
    m_Localized: 'Phone: Простите.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972622
    m_Localized: 'Phone: Не звоните сюда больше...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972623
    m_Localized: 'Phone: Пожалуйста...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972624
    m_Localized: 'Phone: Ой, да зачем я перед вами вообще оправдываюсь?'
    m_Metadata:
