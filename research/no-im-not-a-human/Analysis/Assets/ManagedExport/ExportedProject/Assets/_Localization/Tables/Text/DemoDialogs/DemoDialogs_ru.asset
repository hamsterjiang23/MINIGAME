%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DemoDialogs_ru
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: c98adbd63556d9549ab08646178c4404, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2922758524928
    m_Localized: 'Firefighter: Привет, кх-кх.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662272
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662273
    m_Localized: 'Firefighter: Впустишь, приятель?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662274
    m_Localized: Кто ты?
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662275
    m_Localized: Что с тобой произошло?
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662276
    m_Localized: 'Firefighter: Я пожарный, кх-кх.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662277
    m_Localized: 'Firefighter: Попал под солнечный свет, пока тушили леса днём.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662278
    m_Localized: 'Firefighter: Завеса из дыма помогает не сгореть живьём, кх-кх, но всё равно страшно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662279
    m_Localized: 'Firefighter: Деревья, кх-кх… Горели как спички.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662280
    m_Localized: 'Firefighter: Никогда не видел ничего подобного.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662281
    m_Localized: 'Firefighter: Тлеющие тела животных лежали по всему лесу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662282
    m_Localized: Почему ты не в больнице?
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662283
    m_Localized: Что ты собираешься делать?
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662284
    m_Localized: 'Firefighter: Попал под дневной свет, кх-кх, пока тушил лесные пожары.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662285
    m_Localized: 'Firefighter: Я остался последним из бригады.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662286
    m_Localized: 'Firefighter: Остальные же, кх-кх… их просто не отпустило начальство.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662287
    m_Localized: 'Firefighter: И они остались на вечную смену.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662288
    m_Localized: Почему ты не в больнице?
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662289
    m_Localized: Что ты собираешься делать?
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662290
    m_Localized: 'Firefighter: Больница? Нет больше никаких больниц, приятель.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662291
    m_Localized: 'Firefighter: С приходом Гостей больницы потеряли свой смысл.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662292
    m_Localized: 'Firefighter: Тяжело лечиться, если ты не доверяешь тому, кто тебя лечит.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662293
    m_Localized: 'Firefighter: Никто мне уже не поможет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662294
    m_Localized: 'Firefighter: Лучше бы я остался тушить пожар и умер там, со своими друзьями.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662295
    m_Localized: 'Firefighter: Всё равно недолго осталось.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662296
    m_Localized: Проходи
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662297
    m_Localized: Тебе лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662298
    m_Localized: 'Firefighter: Я бы хотел тушить лес дальше. Лучше я там погибну, а не ребята.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662299
    m_Localized: 'Firefighter: Но мне чётко дали понять, кх-кх… Что с меня хватит.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662300
    m_Localized: 'Firefighter: Домой я уже не доберусь. Транспорт больше не ходит.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662301
    m_Localized: 'Firefighter: Придётся надеяться на людскую доброту.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662302
    m_Localized: Проходи
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662303
    m_Localized: Тебе лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662304
    m_Localized: 'Firefighter: Спасибо тебе, приятель, кх-кх.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662305
    m_Localized: 'Firefighter: Думаю, я недолго задержусь у тебя, кх-кх.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662306
    m_Localized: 'Firefighter: Хоть не на сырой земле придется умирать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662307
    m_Localized: 'Firefighter: Херово, приятель, кх-кх.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662308
    m_Localized: 'Firefighter: Не хотел умирать на сырой земле.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662309
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662310
    m_Localized: 'Firefighter: Надеюсь, кх-кх, пожары не доберутся до городов.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662311
    m_Localized: 'Firefighter: Чёрт, как же жарко...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662312
    m_Localized: Как твоё самочувствие?
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662313
    m_Localized: Я хочу тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662314
    m_Localized: 'Firefighter: Кажется всё ещё хуже, чем я думал. Кх-кх, проклятье.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662315
    m_Localized: 'Firefighter: Чувствую, я не протяну здесь больше недели.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662316
    m_Localized: 'Firefighter: Правда, знаешь, мне греет душу, что ты решил впустить меня. Спасибо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662317
    m_Localized: 'Firefighter: Но… я сижу здесь, пока остальные ребята умирают.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662318
    m_Localized: 'Firefighter: Я мог бы быть там вместо них. Мне уже всё равно нечего терять, ведь и так умру…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662319
    m_Localized: 'Firefighter: Чёрт, как же жарко...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662320
    m_Localized: Почему ты не вернулся к себе домой?
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662321
    m_Localized: Я хочу тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662322
    m_Localized: 'Firefighter: У меня дома дети. А я, кх-кх…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662323
    m_Localized: 'Firefighter: Не хочу чтобы они пугались меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662324
    m_Localized: 'Firefighter: К тому же, кх-кх, не хочу чтобы они меня таким запомнили.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662325
    m_Localized: 'Firefighter: Пусть считают, что я умер тогда, ещё в лесу, когда, кх-кх…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662326
    m_Localized: 'Firefighter: Когда тушил пожары.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662327
    m_Localized: 'Firefighter: Кх-кх-кха… Запомнили бы они меня за смолу кругового терпенья, за совестный деготь труда.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662328
    m_Localized: 'Firefighter: Чёрт, как же жарко...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662329
    m_Localized: Где твоя униформа?
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662330
    m_Localized: Я хочу тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662331
    m_Localized: 'Firefighter: У меня её забрало начальство, кх-кх. У нас сейчас нехватка снаряжения.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662332
    m_Localized: 'Firefighter: Многие, кх-кх, погибают, прямо на работе.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662333
    m_Localized: 'Firefighter: У нас просто не хватает времени вытаскивать сослуживцев. В итоге пожар, кх-кх, уродует тела.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662334
    m_Localized: 'Firefighter: А начальство… Их больше беспокоит какая-то сраная униформа, кх-кх…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662335
    m_Localized: 'Firefighter: Они как подковы, куют за указом указ. Ни в одном про человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662336
    m_Localized: 'Firefighter: Чёрт, как же жарко...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662337
    m_Localized: Из-за чего возникли лесные пожары?
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662338
    m_Localized: Я хочу тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662339
    m_Localized: 'Firefighter: Лес очень сухой в последнее время. Поэтому он очень легко, кх-кх, воспламенился.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662340
    m_Localized: 'Firefighter: Пожары - это лишь, кх-кх, одно из несчастий, которое выпало на нашу участь, как те же Гости из земли.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662341
    m_Localized: 'Firefighter: Но что ещё подготовила нам судьба…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662342
    m_Localized: 'Firefighter: Может спокойная смерть сейчас – это лучший исход в такой-то безнадёге…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662343
    m_Localized: 'Firefighter: Знаешь… Кхм… Я думал отнести домой подарок. Но отдам тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662344
    m_Localized: 'Firefighter: Невзрачное сухое ожерелье.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662345
    m_Localized: 'Firefighter: Оно из мертвых пчел, мед превративших в солнце.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662346
    m_Localized: 'Firefighter: Чёрт, как же жарко...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662347
    m_Localized: Ты выглядишь совсем плохо
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662348
    m_Localized: Я хочу тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662349
    m_Localized: 'Firefighter: Кажется… Кажется, мой час пришёл, кх-кх.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662350
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662351
    m_Localized: 'Firefighter: Почему я там не остался? Мог бы спасти пару ребят.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662352
    m_Localized: 'Firefighter: Мог остаться и отработать пока не упаду. Не пришлось бы посылать молодых на убой.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662353
    m_Localized: 'Firefighter: ЁБАНОЕ НАЧАЛЬСТВО, КХ-КХ-КХ-КХ…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662354
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662355
    m_Localized: 'Firefighter: Всё это очень… грустно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662356
    m_Localized: 'Firefighter: Можешь дать мне закурить напоследок?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662357
    m_Localized: Держи сигарету (отдать сигарету) (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662358
    m_Localized: 'Firefighter: У тебя нет сигарет, верно?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662359
    m_Localized: Прости, я не могу (не отдавать сигарету)
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662360
    m_Localized: 'Firefighter: Как там говорится, последний гвоздь в крышку гроба, кх-кх.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662361
    m_Localized: 'Firefighter: (Мужчина достаёт из кармана зажигалку и начинает курить)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662362
    m_Localized: 'Firefighter: (Сделав глубокую затяжку, он откидывается на стену. После небольшой паузы он снова говорит)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662363
    m_Localized: 'Firefighter: Вот бы постоять снова с ребятами, покурить, поговорить о…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662364
    m_Localized: 'Firefighter: КХ-КХ-КХ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662365
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662366
    m_Localized: 'Firefighter: Не куришь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662367
    m_Localized: 'Firefighter: Знаю, паршиво курить пожарному, кх-кх.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662368
    m_Localized: 'Firefighter: Но теперь какая разница.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662369
    m_Localized: 'Firefighter: Я просто хотел немного, кх-кх, расслабиться перед смертью.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662370
    m_Localized: 'Firefighter: (Мужчина откидывается на стенку и, глядя наверх, произносит)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662371
    m_Localized: 'Firefighter: Угораздило же меня стать пожарным. Говорила мне мама, иди на завод.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662372
    m_Localized: 'Firefighter: А то негоже курить пожа…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662373
    m_Localized: 'Firefighter: КХ-КХ-КХ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662374
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662375
    m_Localized: 'Firefighter: Кх-кх... Да пожалуйста, приятель. Мне скрывать нечего. Всё уже давно выгорело.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662376
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662377
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662378
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 2922804662379
    m_Localized: Подмышки
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856576
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856577
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856578
    m_Localized: 'Firefighter: Гляди.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856579
    m_Localized: 'Firefighter: Кх-кх… Не суди строго. Дым – это, знаешь ли, не зубной врач.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856580
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856581
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856582
    m_Localized: 'Firefighter: Вот, смотри. Кх-кх…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856583
    m_Localized: 'Firefighter: Как два обгорелых полена. Зато ногти чистые. Иронично, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856584
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856585
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856586
    m_Localized: 'Firefighter: Без проблем.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856587
    m_Localized: 'Firefighter: Видишь, кх-кх… Красные, как два угля. Это от дыма, приятель.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856588
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856589
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856590
    m_Localized: 'Firefighter: Ты уверен? Это зрелище не из приятных.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856591
    m_Localized: 'Firefighter: Всё обгорело… кожа потрескалась, словно старая кора дерева. Я лишний раз рук не поднимаю - больно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856592
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856593
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856594
    m_Localized: 'Firefighter: Да, конечно. Сейчас получится лесной обугленный труп, так всегда.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856595
    m_Localized: 'Firefighter: Нравится, да, кх-кх?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856596
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856597
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856598
    m_Localized: 'Firefighter: Тут всё просто – обгорели до хрящей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856599
    m_Localized: 'Firefighter: Скоро и слух пропадёт… может, к лучшему.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856600
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856601
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856602
    m_Localized: 'Firefighter: Да стреляй уже, приятель. Только в зубы не целься – они и так доживают последние деньки.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856603
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856604
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856605
    m_Localized: 'Firefighter: Ну что, мне уже ничего не страшно. Стреляй, если так легче станет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856606
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856607
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856608
    m_Localized: 'Firefighter: Может, так будет даже легче…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856609
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856610
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856611
    m_Localized: 'Firefighter: Ты хоть понимаешь, через что эти руки прошли?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856612
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856613
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856614
    m_Localized: 'Firefighter: Если это фото -- приговор, кх-кх, давай закончим. Меня уже ничего не удерживает.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856615
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856616
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856617
    m_Localized: 'Firefighter: Всё горит… может, и моя очередь настала.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856618
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856619
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856620
    m_Localized: 'Firefighter: Знаешь, кх-кх, так и не смог приучить детей зубы каждый день чистить. А теперь… Теперь некому напоминать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856621
    m_Localized: 'Firefighter: Этими руками, кх-кх, я когда-то спасал людей. А теперь даже кружку нормально держать не могу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856622
    m_Localized: 'Firefighter: Вот оно как…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856623
    m_Localized: 'Firefighter: Что ж, пора на покой.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856624
    m_Localized: 'Firefighter: Когда лес горит, кх-кх… Ты просто смотришь, как он превращается в пепел. И понимаешь, что ничего не можешь сделать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856625
    m_Localized: 'Firefighter: Иногда просыпаюсь ночью и чувствую, как кожа буквально лопается. Пытаюсь её смазать чем-то, но толку мало. Всё огонь забрал...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856626
    m_Localized: 'Firefighter: Только память в огне не горит, а тело – дело времени.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856627
    m_Localized: 'Firefighter: Когда огонь ревёт вокруг, ты понимаешь, как дорога эта тишина. Кх-кх, ушам теперь всё равно, а вот душе -- ещё нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856628
    m_Localized: 'Wheelchair: Хеей, здорова!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856629
    m_Localized: 'WheelChair: Давно не виделись. Как жизнь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856630
    m_Localized: Мы знакомы?
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856631
    m_Localized: Ты кто?
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856632
    m_Localized: 'Wheelchair: Как это, ты что… Не помнишь меня?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856633
    m_Localized: 'Wheelchair: Да мы ж это…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856634
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856635
    m_Localized: 'Wheelchair: Погоди-ка, у тебя другой голос…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856636
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856637
    m_Localized: 'Wheelchair: А давно здесь сменился хозяин?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856638
    m_Localized: Этот дом всегда принадлежал моей семье
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856639
    m_Localized: Мне кажется, ты просто ошибся адресом
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856640
    m_Localized: 'Wheelchair: Ой, ты не…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856641
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856642
    m_Localized: 'Wheelchair: Ты не мой приятель.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856643
    m_Localized: 'Wheelchair: А давно вы здесь живёте?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856644
    m_Localized: Этот дом всегда принадлежал нашей семье
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856645
    m_Localized: Мне кажется, ты просто ошибся адресом
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856646
    m_Localized: 'Wheelchair: Да не, ну чё ты.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856647
    m_Localized: 'Wheelchair: Я не мог ошибиться, память меня никогда не подводит.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856648
    m_Localized: 'Wheelchair: Мой приятель точно живёт… вернее, жил здесь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856649
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856650
    m_Localized: 'Wheelchair: Слушай, я такой путь проделал, можешь, пожалуйста, пустить меня к себе, а?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856651
    m_Localized: Проходи
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856652
    m_Localized: Тебе лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856653
    m_Localized: 'Wheelchair: Да не, ну не мог же я...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856654
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856655
    m_Localized: 'Wheelchair: Не-е-е…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856656
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856657
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856658
    m_Localized: 'Wheelchair: Бля…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856659
    m_Localized: 'Wheelchair: Походу, я реально ошибся.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856660
    m_Localized: 'Wheelchair: Слушай, я такой путь проделал, можешь, пожалуйста, пустить меня к себе, а?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856661
    m_Localized: Проходи
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856662
    m_Localized: Тебе лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856663
    m_Localized: 'Wheelchair: Вот это дело!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856664
    m_Localized: 'Wheelchair: Погоняем у тебя дома, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856665
    m_Localized: 'Wheelchair: Уйти? Ты долбоёб?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856666
    m_Localized: 'Wheelchair: Как я уйду?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856667
    m_Localized: 'Wheelchair: О-о-о-ой, покатил я отсюда. Умалишённый.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856668
    m_Localized: 'WheelChair: Эх, жизнь моя – жестянка…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856669
    m_Localized: Кого ты искал?
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856670
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856671
    m_Localized: 'WheelChair: Да друга моего. Мы с детства знакомы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856672
    m_Localized: 'WheelChair: У него травма случилась.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856673
    m_Localized: 'WheelChair: Его наняли в горах добывать что-то там.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856674
    m_Localized: 'WheelChair: Я сам-то не разбираюсь. И мне похер.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856675
    m_Localized: 'WheelChair: НО ВОТ ОН СПИНУ СОРВАЛ СЕБЕ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856676
    m_Localized: 'WheelChair: Работал на горе так усердно…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856677
    m_Localized: 'WheelChair: Что чайки приняли его… спи.. спип..'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856678
    m_Localized: 'WheelChair: Жопу, короче. Они приняли его жопу за гнездо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856679
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856680
    m_Localized: 'WheelChair: АХАХАХАХАХАХА.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856681
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856682
    m_Localized: 'WheelChair: Извини, это просто у меня голоса в голове.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856683
    m_Localized: 'WheelChair: Анекдот смешной очень рассказали.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856684
    m_Localized: 'WheelChair: Эх, жизнь моя – жестянка…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856685
    m_Localized: У тебя… всё в порядке?
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856686
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856687
    m_Localized: 'WheelChair: Да. Я просто жду, когда отрастут ноги.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856688
    m_Localized: 'WheelChair: Уже вот правая начала понемногу расти.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856689
    m_Localized: 'WheelChair: Так что я у тебя посижу маленько.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856690
    m_Localized: Я про голоса в голове
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856691
    m_Localized: Ну… хорошо
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856692
    m_Localized: 'WheelChair: Ты не понял? Это шутка была.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856693
    m_Localized: 'WheelChair: Я думал, ты сразу выкупил прикол.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856694
    m_Localized: 'WheelChair: … Получилось неловко.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856695
    m_Localized: 'WheelChair: Ты просто спросил, как у меня дела?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856696
    m_Localized: 'WheelChair: Спасибо, знаешь, это очень приятно!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856697
    m_Localized: 'WheelChair: Мало кто спрашивает, как я себя чувствую или как прошёл мой день.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856698
    m_Localized: 'WheelChair: Всё из-за того, что у меня вместо ног колёса великого ГОНЩИКА?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856699
    m_Localized: 'WheelChair: Никто мне честно не ответит. Вот в чём беда.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856700
    m_Localized: 'WheelChair: Все начнут оправдываться, что просто посмотрели на ноги.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856701
    m_Localized: 'WheelChair: Хотя когда прям пялятся – тоже неприятно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856702
    m_Localized: 'WheelChair: Но и игнорировать мою инвалидность тупо. Ну, она существует, да.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856703
    m_Localized: 'WheelChair: Короче, тут баланс нужен.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856704
    m_Localized: 'WheelChair: А этого баланса нихуя в городе нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856705
    m_Localized: 'WheelChair: Вот ты пробовал просто представить, как бы ты гулял, если бы был на колёсах?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856706
    m_Localized: 'WheelChair: Блять, я не про то…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856707
    m_Localized: 'WheelChair: Короче, если бы у тебя ног не было.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856708
    m_Localized: 'WheelChair: ВОТ ИМЕННО! Ты даже из дома выйти бы не смог!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856709
    m_Localized: 'WheelChair: Как по лестницам передвигаться? А дорогу переходить?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856710
    m_Localized: 'WheelChair: Бордюры эти ебучие, ещё и стоят криво.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856711
    m_Localized: 'WheelChair: У тебя в доме хотя бы лестниц и порогов нет, я могу спокойно ездить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856712
    m_Localized: 'WheelChair: Знаешь, я только об одном жалею…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856713
    m_Localized: 'WheelChair: У тебя дом не под наклоном.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856714
    m_Localized: 'WheelChair: Как было бы угарно скатиться на коляске сейчас. После, конечно, въехать в стену. Но это фигня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856715
    m_Localized: 'WheelChair: Я так люблю гонять. А у тебя как-то возможности нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856716
    m_Localized: 'WheelChair: Так, подожди, ты спрашивал, как у меня дела.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856717
    m_Localized: 'WheelChair: Да ничего, хорошо. Спасибо, что поинтересовался.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856718
    m_Localized: 'WheelChair: Эх, жизнь моя – жестянка…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856719
    m_Localized: Тебе голову напекло?
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856720
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856721
    m_Localized: 'WheelChair: Да причём тут это?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856722
    m_Localized: 'WheelChair: У меня волосы не сожгло, не выпали. Значит, всё хорошо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856723
    m_Localized: 'WheelChair: Я на коляске без ног не могу гонять. Понимаешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856724
    m_Localized: 'WheelChair: Если у меня ног нет, как я заторможу на большой скорости? Или войду в поворот?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856725
    m_Localized: 'WheelChair: У тебя коляски нет, как ты меня поймёшь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856726
    m_Localized: Ты правда в это веришь?
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856727
    m_Localized: Почему думаешь, что ноги отрастут?
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856728
    m_Localized: 'WheelChair: Конечно!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856729
    m_Localized: 'WheelChair: Вот знаешь как говорят?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856730
    m_Localized: 'WheelChair: У правой ноги длиннее шаги. Поэтому мы нарезаем круги.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856731
    m_Localized: 'WheelChair: Вот и моя нога это доказывает.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856732
    m_Localized: 'WheelChair: Всё одно и то же, никак из этого цикла не выйти.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856733
    m_Localized: 'WheelChair: Кончится этот день – начнётся другой. Но будет ли это новый день?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856734
    m_Localized: 'WheelChair: Да нихуя. Всё тот же. Просто живу в цикле.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856735
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856736
    m_Localized: 'WheelChair: А так если подумать, ты чем-то от меня отличаешься?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856737
    m_Localized: 'WheelChair: Ты не по кругу ходишь что ли?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856738
    m_Localized: 'WheelChair: Слушай, мы в мире живём, где происходят чудеса.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856739
    m_Localized: 'WheelChair: Пока что только ужасные. НО!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856740
    m_Localized: 'WheelChair: Когда-то ужасные чудеса кончатся. Вот тогда начнутся хорошие, добрые чудеса.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856741
    m_Localized: 'WheelChair: Вон, Бог уже простил толпы намоленных пастей. Может, и с нами что хорошее случится.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856742
    m_Localized: 'WheelChair: Эх, жизнь моя – жестянка…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856743
    m_Localized: Как ты потерял ноги?
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856744
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856745
    m_Localized: 'WheelChair: Помнишь друга со скалы, о котором я тебе говорил?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856746
    m_Localized: 'WheelChair: Так вот… он решил у себя во дворе прокопать траншею.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856747
    m_Localized: 'WheelChair: Ему в голову попала мысль, что под домом у него проходит туннель из мяса.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856748
    m_Localized: 'WheelChair: Он заказал себе ручной бур или типо того.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856749
    m_Localized: 'WheelChair: И полез копать…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856750
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856751
    m_Localized: 'WheelChair: Блин…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856752
    m_Localized: 'WheelChair: Наверно, тогда я в последний раз его и видел.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856753
    m_Localized: 'WheelChair: Эх, жизнь моя – жестянка…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856754
    m_Localized: А с ногами-то что?
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856755
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856756
    m_Localized: 'WheelChair: Да чёрт с ногами, интересно, докопал ли он куда хотел.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856757
    m_Localized: Ладно, забей
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856758
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856759
    m_Localized: 'WheelChair: … Ну да, я как раз потом пошёл пива выпить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856760
    m_Localized: 'WheelChair: Упал, и мне трамваем ноги срубило.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856761
    m_Localized: 'WheelChair: Или подожди…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856762
    m_Localized: 'WheelChair: Не, по-другому всё было.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856763
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856764
    m_Localized: 'WheelChair: Чего молчишь? Неинтересно?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856765
    m_Localized: 'WheelChair: Ну, я и не стану рассказывать. Чего мучить тебя?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856766
    m_Localized: 'Wheelchair: Так. Ну, давай сюда свои тесты, щас всё пройдём.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856767
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856768
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856769
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856770
    m_Localized: Подмышки
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856771
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856772
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856773
    m_Localized: 'Wheelchair: Вот, смотри.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856774
    m_Localized: 'Wheelchair: Такие зубы – настоящая находка.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856775
    m_Localized: 'Wheelchair: Не зубы, а золото! Не все, конечно, но то ли ещё будет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856776
    m_Localized: 'Wheelchair: Как легко передними зубами банки пива открывать, ты бы знал.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856777
    m_Localized: 'Wheelchair: Да, оно само.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856778
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856779
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856780
    m_Localized: 'Wheelchair: Хоть руки остались, и на том спасибо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856781
    m_Localized: 'Wheelchair: Без рук я вообще гонять не смог бы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856782
    m_Localized: 'Wheelchair: Подожди.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856783
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856784
    m_Localized: 'Wheelchair: Пальцы спиздили!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856785
    m_Localized: 'Wheelchair: Только вчера не хватало одного, остальные где?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856786
    m_Localized: 'Wheelchair: Ладно, отрастут, просто попозже.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856787
    m_Localized: 'Wheelchair: Палец спиздили.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856788
    m_Localized: 'Wheelchair: Мелочь, а неприятно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856789
    m_Localized: 'Wheelchair: НО НОГОТЬ УЖЕ ОТРАСТАЕТ НЕМНОГО, ВИДИШЬ?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856790
    m_Localized: 'Wheelchair: Значит, ноги тоже отрастут, просто попозже.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856791
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856792
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856793
    m_Localized: 'Wheelchair: Куда смотреть? Прям на тебя?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856794
    m_Localized: 'Wheelchair: Видишь, как дёргается? Привычка осталась.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856795
    m_Localized: 'Wheelchair: Ещё со времён, когда я газовал как следует, не успевал взглядом зацепиться за… ну, хоть что-то.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856796
    m_Localized: 'Wheelchair: Я не готов отпустить эту скорость, наверно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856797
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856798
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856799
    m_Localized: 'Wheelchair: Ага.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856800
    m_Localized: 'Wheelchair: Ну давай, АХАХАХАХАХА, ну давай, да.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856801
    m_Localized: 'Wheelchair: Вот он, пик комедии.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856802
    m_Localized: 'Wheelchair: Ты просишь показать подмышки, я показываю тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856803
    m_Localized: 'Wheelchair: За окном происходит ад, космос хочет размазать всю планету.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856804
    m_Localized: 'Wheelchair: Гости хотят размазать нас.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856805
    m_Localized: 'Wheelchair: А ты такой: “подмыхи покажи”!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856806
    m_Localized: 'Wheelchair: АААААХАХАХАХА.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856807
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856808
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856809
    m_Localized: 'Wheelchair: Фотография?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856810
    m_Localized: 'Wheelchair: Не по мне это, но ладно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856811
    m_Localized: 'Wheelchair: Блин, я моргнул.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856812
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856813
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856814
    m_Localized: 'Wheelchair: АХАХАХАХААХ, хорооош!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856815
    m_Localized: 'Wheelchair: Тоже понял эту волну, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856816
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856817
    m_Localized: 'Wheelchair: Ну да, да. А что, да, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856818
    m_Localized: 'Wheelchair: Подожди-ка, ты не шутишь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856819
    m_Localized: 'Wheelchair: Это… пиздец.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856820
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856821
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856822
    m_Localized: 'Wheelchair: Да не буду я больше пиво брать у тебя, чего сразу обижаться?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856823
    m_Localized: 'Wheelchair: Знаешь, что у нас делали с обиженными?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856824
    m_Localized: 'Wheelchair: На обиженных коляски возят.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856825
    m_Localized: 'Wheelchair: Будешь обижаться – повезёшь меня кататься.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856826
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856827
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856828
    m_Localized: 'Wheelchair: И чего?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856829
    m_Localized: 'Wheelchair: Мне это не поможет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856830
    m_Localized: 'Wheelchair: Тебе, наверно, тоже. Тогда зачем ружьё?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922808856831
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050880
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050881
    m_Localized: 'Wheelchair: За пулей я, наверно, не услежу. Но увернуться попробую.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050882
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050883
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050884
    m_Localized: 'Wheelchair: Не понимаю, зачем брить волосы? Это ж естественная защита организма.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050885
    m_Localized: 'Wheelchair: Покраснения видишь? Я там пальцы себе выращиваю. Запасные.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050886
    m_Localized: 'Wheelchair: А, комедия даже не началась ещё.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050887
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050888
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050889
    m_Localized: 'Wheelchair: Где же мы в этой жизни свернули не туда?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050890
    m_Localized: 'Wheelchair: Чё ещё за фотографии? Перед смертью не надышишься, знаешь фразу такую?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050891
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050892
    m_Localized: 'Wheelchair: Что я сказать-то хотел…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050893
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050894
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050895
    m_Localized: 'Wheelchair: Может, я просто уйду?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050896
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050897
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050898
    m_Localized: 'Wheelchair: Вот и доигрались, получается.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050899
    m_Localized: 'Wheelchair: Грязью люди в чёрных робах приглашают к эшафоту.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050900
    m_Localized: 'Wheelchair: Вечно буду несогласен.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050901
    m_Localized: 'Wheelchair: Это всё биология нашего мяса, понимаешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050902
    m_Localized: 'Wheelchair: Почему раньше мы над этим всем смеялись, а теперь готовы головы друг другу переломать?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050903
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050904
    m_Localized: 'Wheelchair: Надо готовиться умирать, вот что.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050905
    m_Localized: 'Wheelchair: Руки сейчас – моё единственное двигло.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050906
    m_Localized: 'Wheelchair: И у меня спиздили сцепление.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050907
    m_Localized: 'Wheelchair: Честно говоря, меня пугает мысль, что однажды я могу лишиться и их. Что тогда?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050908
    m_Localized: 'Wheelchair: Страшно остаться совсем без возможности передвигаться. Застрять навсегда.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050909
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050910
    m_Localized: 'Wheelchair: Даже смерть так не пугает.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050911
    m_Localized: 'Wheelchair: Как глазами не бегай, за временем больше не успеваешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050912
    m_Localized: 'Wheelchair: Заметил, как с возрастом время стало разгоняться?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050913
    m_Localized: 'Wheelchair: Это мы в детстве не спешили жить. Тогда всё было спокойно, без ответственности или серьёзных решений.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050914
    m_Localized: 'Wheelchair: А сейчас как не спеши, уже не успеем, похоже.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050915
    m_Localized: 'Wheelchair: Нет, знаешь, как-то меня это всё перестало веселить вдруг.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050916
    m_Localized: 'Wheelchair: Бредовые проверки, тушения пожаров.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050917
    m_Localized: 'Wheelchair: Все так хотят спасти мир, но только не договорятся как.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050918
    m_Localized: 'Wheelchair: А толку-то? Может, просто надо уже расслабиться и не париться?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050919
    m_Localized: 'Wheelchair: Слушай…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050920
    m_Localized: 'Wheelchair: Нет у тебя мысли, что вот мы все и приехали?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050921
    m_Localized: 'Wheelchair: Щас будет конечная, скоро выходить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050922
    m_Localized: 'Wheelchair: В окошко смотрим, остановка-то видна.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050923
    m_Localized: 'Wheelchair: Ты к этому готов?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050924
    m_Localized: 'Wheelchair: Я вот задумался. Ты не обижайся.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050925
    m_Localized: 'Wheelchair: Если… если ты не доверяешь этому признаку, то как я могу им доверять?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050926
    m_Localized: 'Wheelchair: Может, все они одинаково верно указывают на Гостя?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050927
    m_Localized: 'Wheelchair: Людям, конечно, свойственно ошибаться.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050928
    m_Localized: 'Wheelchair: Но эти ошибки приводят к очень страшным последствиям.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050929
    m_Localized: 'Wheelchair: Если… если ты доверяешь этому признаку, то как я могу доверять предыдущим?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050930
    m_Localized: 'Wheelchair: Может, и прошлые тоже херня какая-то?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050931
    m_Localized: 'Wheelchair: Мы, конечно, люди. Ошибаться можем, вот это вот всё.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050932
    m_Localized: 'Wheelchair: Но эти ошибки приводят к очень страшным последствиям.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050933
    m_Localized: 'Wheelchair: Ты же… одного движения хватит, чтобы что-то пошло не так, и ты сломал чью-то жизнь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050934
    m_Localized: 'Wheelchair: Если ты уверен в своём выборе, то… я завидую твоей уверенности.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050935
    m_Localized: 'Mother: Все, стой спокойно, не вертись.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050936
    m_Localized: 'Mother: Здравствуйте. Помогите, пожалуйста.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050937
    m_Localized: Что-то случилось?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050938
    m_Localized: Что вы от меня хотите?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050939
    m_Localized: 'Mother: Сил моих больше нет. Очень хочу спать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050940
    m_Localized: 'Mother: Из пятерых детей остался только один.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050941
    m_Localized: 'Mother: Муж куда-то пропал. Я уже не знаю, что думать: убили его, бросил он нас или что.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050942
    m_Localized: 'Mother: Сейчас бы просто лечь и проспать несколько дней.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050943
    m_Localized: Куда остальные дети делись?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050944
    m_Localized: Ваши дети мертвы?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050945
    m_Localized: 'Mother: Пустите меня отдохнуть, я жутко устала.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050946
    m_Localized: 'Mother: Раньше у меня было пять детей. Остался, вот, последний.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050947
    m_Localized: 'Mother: Я не знаю уже, где что искать, мне бы только хорошенько проспаться.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050948
    m_Localized: Куда остальные дети делись?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050949
    m_Localized: Ваши дети мертвы?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050950
    m_Localized: 'Mother: Я не знаю, может, их отец забрал? Хочу завтра дойти до его дома, но уже просто не могу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050951
    m_Localized: 'Mother: Да, мы с ним поругались, но это не удивительно. Если ведешь себя как мудак, сможешь ли ужиться с другими?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050952
    m_Localized: 'Mother: Конечно, нет. Ох, ладно, главное – найти детей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050953
    m_Localized: Проходи
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050954
    m_Localized: Тебе лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050955
    m_Localized: 'Mother: Нет, вы так не говорите.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050956
    m_Localized: 'Mother: Конечно, тяжело присмотреть за целой оравой непоседливых детей, но…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050957
    m_Localized: 'Mother: Да ничего с ними не случилось, они наверняка у моей матери.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050958
    m_Localized: 'Mother: Они туда могут убежать, когда им совсем со мной скучно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050959
    m_Localized: 'Mother: Или когда их отец снова пришёл денег у меня просить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050960
    m_Localized: 'Mother: Вы можете меня впустить? Я отдохну и пойду искать детей?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050961
    m_Localized: Проходите
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050962
    m_Localized: Тебе лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050963
    m_Localized: 'Mother: Всё наконец. Отдых.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050964
    m_Localized: 'Mother: Пойдём, ногами перебирай давай, занимай место.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050965
    m_Localized: 'Mother: Завтра уже пойдём с тобой.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050966
    m_Localized: 'Mother: Ладно. Тогда пойду попробую сейчас дойти до их дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050967
    m_Localized: 'Mother: Может, не успею уже…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050968
    m_Localized: 'Mother: Да не, должна успеть.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050969
    m_Localized: 'Mother: Как же тут душно…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050970
    m_Localized: Вы же приходили с ребёнком
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050971
    m_Localized: Мне надо вас проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050972
    m_Localized: 'Mother: А? Так он и сейчас со мной, отошёл куда-то.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050973
    m_Localized: 'Mother: Мне сейчас важно узнать, куда делись остальные, и всё ли у них хорошо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050974
    m_Localized: 'Mother: У вас есть телефон? Я бы позвонила, чтоб лишний раз его харю не видеть.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050975
    m_Localized: 'Mother: Как же тут душно…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050976
    m_Localized: Ну как? Позвонили мужу?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050977
    m_Localized: Мне надо вас проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050978
    m_Localized: 'Mother: Да зачем? Что он мне скажет? Опять начнёт что-то мямлить, будто не при делах. Он никогда ничего не решал. Всё на мне было: дети, дом, деньги.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050979
    m_Localized: 'Mother: Иногда думаю, что он просто терпел меня, а я терпела его. Но он не уходил от меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050980
    m_Localized: 'Mother: Может, потому что я удобная. Или просто боится, что окончательно его достану.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050981
    m_Localized: 'Mother: Как же я устала…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050982
    m_Localized: 'Mother: Как же тут душно…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050983
    m_Localized: Сходили до мужа?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050984
    m_Localized: Мне надо вас проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050985
    m_Localized: 'Mother: Что? Да куда там… Я еле могу с кровати подняться. Всё болит, сил вообще нет. Иногда кажется, что живу только за счёт злости.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050986
    m_Localized: 'Mother: Всё было на мне: и дети, и муж, и весь дом. Но иногда он делал такие вещи, ради которых, казалось, стоило терпеть.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050987
    m_Localized: 'Mother: Ладно, давай потом поговорим, мне передохнуть надо, а то сил совсем нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050988
    m_Localized: 'Mother: Как же тут душно…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050989
    m_Localized: Что же он сделал такого?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050990
    m_Localized: Мне надо вас проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050991
    m_Localized: 'Mother: Была одна история…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050992
    m_Localized: 'Mother: Муж часто подвозил какую-то бабу. Я сразу всё поняла, конечно. Сначала терпела, потом пилила его каждый день.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050993
    m_Localized: 'Mother: Орала, обвиняла его в предательстве. А он в итоге работу сменил, чтобы не видеть её больше. Вот и скажи после этого, что не любил…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050994
    m_Localized: 'Mother: Хотя, может, я всё это себе придумала. Ладно, мне нужно отдохнуть. Потом поговорим.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050995
    m_Localized: 'Mother: Как же тут душно…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050996
    m_Localized: Не волнуетесь за детей?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050997
    m_Localized: Мне надо вас проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050998
    m_Localized: 'Mother: Волнуюсь... но как-то странно, не так, как надо, наверное. Первый ребёнок… я ведь тогда совсем ничего не понимала. Всё испортила.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813050999
    m_Localized: 'Mother: Думала, со вторым всё исправлю. Но и с ним вышло то же самое. Потом третий, четвёртый…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051000
    m_Localized: 'Mother: Врачи говорили, что я уже не смогу иметь детей, но второй… когда он появился… я называла его восьмым чудом света!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051001
    m_Localized: 'Mother: А потом… доходило до… это было ужасно…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051002
    m_Localized: 'Mother: Я... мне надо передохнуть…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051003
    m_Localized: 'Mother: Как же тут душно…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051004
    m_Localized: Что было ужасно?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051005
    m_Localized: Мне надо вас проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051006
    m_Localized: 'Mother: Мне тяжело об этом говорить… Очень тяжело. Я ведь их люблю, но… Бывало, сорвусь, накричу, даже руку поднять могла.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051007
    m_Localized: 'Mother: Знаю, что это кошмар. Мне так жаль… Но, знаешь, я вот впервые чувствую, как легко.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051008
    m_Localized: 'Mother: Их нет рядом, и я просто дышу... Больно это осознавать, но мне наконец хорошо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051009
    m_Localized: 'Mother: Ох, проверяй. Мне скрывать нечего.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051010
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051011
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051012
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051013
    m_Localized: Подмышки
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051014
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051015
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051016
    m_Localized: 'Mother: Ну, пожалуйста.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051017
    m_Localized: 'Mother: Знаешь, раньше я не обращала на них внимания. Времени просто не было. А теперь... Теперь жалею.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051018
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051019
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051020
    m_Localized: 'Mother: Вот, смотри.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051021
    m_Localized: 'Mother: Лопаты, а не ладони. Всё для детей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051022
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051023
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051024
    m_Localized: 'Mother: Ну, смотри.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051025
    m_Localized: 'Mother: Видишь огроменные мешки? Это от недосыпа…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051026
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051027
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051028
    m_Localized: 'Mother: Ну, смотри.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051029
    m_Localized: 'Mother: Дезик давно закончился. Ты уж не обессудь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051030
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051031
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051032
    m_Localized: 'Mother: Можно мне присесть? Нет?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051033
    m_Localized: 'Mother: Растрёпанная и злая, как обычно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051034
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051035
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051036
    m_Localized: 'Mother: Я давно их не чистила. Может, уже пробка образовалась.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051037
    m_Localized: 'Mother: Я уже не слышу половину из-за детских визгов.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051038
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051039
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051040
    m_Localized: 'Mother: Да у меня уже неделю при чистке зубов кровь идёт.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051041
    m_Localized: 'Mother: А зубы жёлтые всё равно, с такими детьми как не закурить?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051042
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051043
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051044
    m_Localized: 'Mother: У меня от бытовых средств уже сыпь какая-то. Не успела ко врачу сходить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051045
    m_Localized: 'Mother: Эти руки тебе суп сварят, если доживёшь! А ты за ружьё…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051046
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051047
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051048
    m_Localized: 'Mother: Да хоть гранату достань. Выспаться мне это не поможет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051049
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051050
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051051
    m_Localized: 'Mother: Ты что, из-за запаха решил меня пристрелить? Умора.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051052
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051053
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051054
    m_Localized: 'Mother: Ты что, по фотке судишь? Вот умора.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051055
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051056
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051057
    m_Localized: 'Mother: Ты точно больной, если из-за ушей стрелять собрался. Чем они тебе так не понравились? Ну, я могу их платочком прикрыть!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051058
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051059
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051060
    m_Localized: 'Mother: Наконец-то никто не будет меня донимать…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051061
    m_Localized: 'Mother: Как же страшно…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051062
    m_Localized: 'Mother: Знаешь, у одного из моих детей зубы идеальные. Так и не улыбнулся ни разу. Может, дело вообще не в зубах?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051063
    m_Localized: 'Mother: Руки... Я ими детей обнимала, всё по дому делала и мужа ласкала. И знаешь что? Всё равно никто нихера не ценит.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051064
    m_Localized: 'Mother: Когда ребёнок болеет, ты сутки напролёт не спишь. А потом привыкаешь. И просто живёшь в этом кошмаре.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051065
    m_Localized: 'Mother: Однажды так замоталась, что неделю не мылась. Дети даже не заметили.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051066
    m_Localized: 'Mother: Знаешь, однажды я нашла фото, на котором все дети улыбаются. Смотрела на него всю ночь, пока не уснула.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051067
    m_Localized: 'Mother: Иногда хочется ничего не слышать. Совсем. Но когда дети засыпают, наступает такая тишина... Ради этого и живёшь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051068
    m_Localized: 'Anger: Привет, жилец.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051069
    m_Localized: 'Anger: Настроение ни к чёрту, я заранее прошу прощения.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051070
    m_Localized: 'Anger: Так много ублюдков вокруг. Надеюсь, ты не один из них.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051071
    m_Localized: Ты про кого?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051072
    m_Localized: Ты не среди этих тварей?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051073
    m_Localized: 'Anger: Да… про всех.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051074
    m_Localized: 'Anger: Про ублюдков, которых сдерживала только вера или ещё что-нибудь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051075
    m_Localized: 'Anger: А когда бог умер для них – нихуя человеческого не осталось.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051076
    m_Localized: 'Anger: Просто животные ебучие.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051077
    m_Localized: 'Anger: Будто не хватало нам этих приколов с Гостями… тут ещё эти.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051078
    m_Localized: Чего ты так завёлся?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051079
    m_Localized: Ты чем-то отличаешься от них?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051080
    m_Localized: 'Anger: Хороший вопрос.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051081
    m_Localized: 'Anger: Ты же заметил, что люди будто стали делиться на два таких… отряда, что ли?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051082
    m_Localized: 'Anger: Одни – ебучие садисты. Хуже любых Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051083
    m_Localized: 'Anger: Вытворяют что хотят, продолжая исступлённо и отчаянно орать: “Убивать, убивать, убивать”.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051084
    m_Localized: 'Anger: Другие – просто твари. Вытри об них ноги, они спасибо скажут, что не убили.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051085
    m_Localized: 'Anger: И бесят меня оба этих лагеря, сука.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051086
    m_Localized: Чего ты так завелся?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051087
    m_Localized: Ты чем-то отличаешься от них?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051088
    m_Localized: 'Anger: Да ты не принимай на свой счёт. Просто…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051089
    m_Localized: 'Anger: После солнечного ада и прихода Гостей создаётся ощущение, что вместе с богом умерла человечность.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051090
    m_Localized: 'Anger: А злюсь… понимаешь, хотелось же нормальными делами заниматься.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051091
    m_Localized: 'Anger: Я музыку писал. Сейчас-то оно нахуй не нужно никому.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051092
    m_Localized: 'Anger: Просто стараюсь не становиться частью ни одного из этих лагерей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051093
    m_Localized: Проходи
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051094
    m_Localized: Тебе лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051095
    m_Localized: 'Anger: Я хочу верить, что отличаюсь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051096
    m_Localized: 'Anger: Знаешь, меня до усрачки пугает возможность склониться к маньякам.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051097
    m_Localized: 'Anger: Или к жертвам. Обе стороны – пиздец.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051098
    m_Localized: 'Anger: Хотя…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051099
    m_Localized: 'Anger: Жертвы хуже.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051100
    m_Localized: 'Anger: Они просто сидят и ждут, пока их отпиздят, оторвут им зубы или ещё что-то сделают.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051101
    m_Localized: 'Anger: Ты бы понял мою ярость, если бы видел то же, что и я.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051102
    m_Localized: Проходи
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051103
    m_Localized: Тебе лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051104
    m_Localized: 'Anger: Ты не переживай, я не буду реагировать на других.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051105
    m_Localized: 'Anger: Или кого-то ебашить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051106
    m_Localized: 'Anger: Я вымещаю на себе ярость, никто не пострадает.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051107
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051108
    m_Localized: 'Anger: Блять, так ты такое же уёбище, как остальные трусы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051109
    m_Localized: 'Anger: Сиди, терпи, пока тебе на лицо не насрут.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051110
    m_Localized: 'Anger: Пиздец.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051111
    m_Localized: 'Anger: Ёбаный пиздец…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051112
    m_Localized: Ну что, остыл?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051113
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051114
    m_Localized: 'Anger: Я быстро остываю. Но стоит вспомнить что-нибудь эдакое, и опять выхожу из себя.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051115
    m_Localized: 'Anger: Раньше как-то спокойнее был, меня было сложнее задеть, выбесить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051116
    m_Localized: 'Anger: Сейчас достаточно одной искры и понеслось.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051117
    m_Localized: 'Anger: Да и надо ли оставаться спокойным? Может, моя ярость и помогает мне оставаться в здравом рассудке?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051118
    m_Localized: 'Anger: По крайней мере, не поклоняться солнцу, как какой-нибудь долбоёб.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051119
    m_Localized: 'Anger: Как можно думать, что солнце нас спасёт? Оно нас, блять, убивает.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051120
    m_Localized: 'Anger: Всё идёт к тому, что оно нас, ну, сотрёт нахуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051121
    m_Localized: 'Anger: Но этим кончелыгам невдомёк, неееет. Ладно, все, я спокоен. Всё.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051122
    m_Localized: 'Anger: Спасибо, что выслушал.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051123
    m_Localized: 'Anger: Ёбаный пиздец…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051124
    m_Localized: Откуда у тебя столько злости?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051125
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051126
    m_Localized: 'Anger: Сам толком не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051127
    m_Localized: 'Anger: Просто меня бесит всё, что происходит.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051128
    m_Localized: 'Anger: А культисты – ебучие лживые мудаки. Им бы побольше людей одурачить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051129
    m_Localized: 'Anger: И ведь им, сука, верят.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051130
    m_Localized: 'Anger: Люди готовы последние крохи у своих детей отобрать, лишь бы подношение культу сделать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051131
    m_Localized: 'Anger: Задобрить своего дерьмового покровителя из недр земли.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051132
    m_Localized: 'Anger: Ебанутые. Они даже нормальных людей склоняют к своей бредовой вере, как мою…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051133
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051134
    m_Localized: 'Anger: Всё, я вроде пока остыл. Мне полегчало.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051135
    m_Localized: 'Anger: Ёбаный пиздец…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051136
    m_Localized: Культисты у тебя кого-то забрали?
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051137
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051138
    m_Localized: 'Anger: В том-то и дело, что не забирали. Она сама к ним пришла.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051139
    m_Localized: 'Anger: Моя жена…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051140
    m_Localized: 'Anger: До начала всего этого пиздеца она уже была глубоко верующей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051141
    m_Localized: 'Anger: Но я любил её и мирился с этим. Это нам никак не мешало.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051142
    m_Localized: 'Anger: Как началась вся хуйня, она обрела новую веру в нового покровителя.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051143
    m_Localized: 'Anger: Речи этих ебучих культистов показались ей разумными.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051144
    m_Localized: 'Anger: С каждым днём она становилась всё безумнее, веруя во что-то, что было мне непонятно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051145
    m_Localized: 'Anger: Когда я понял, что наделал, она уже в страхе убегала из дома. Было слишком поздно что-то менять…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051146
    m_Localized: 'Anger: Ёбаный пиздец…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922813051147
    m_Localized: Что произошло между тобой и женой?
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245184
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245185
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245186
    m_Localized: 'Anger: Наступил день, когда жена поставила меня перед фактом: она уходит в культ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245187
    m_Localized: 'Anger: Я… просто не мог поверить в это. Та, кого я любил… Её словно заменили на кого-то чужого.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245188
    m_Localized: 'Anger: Для неё наши чувства будто перестали хоть что-то значить. Я злился как никогда в своей жизни.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245189
    m_Localized: 'Anger: В голове были мысли, что она меня никогда не любила, ждала удобного случая съебаться. Сделать мне больно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245190
    m_Localized: 'Anger: Мои кулаки сами собой сжались, я сделал то, чего я никогда себе не прощу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245191
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245192
    m_Localized: 'Anger: Я ударил её…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245193
    m_Localized: 'Anger: Теперь уже ничего не исправить. Она в культе, а я…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245194
    m_Localized: 'Anger: Так и не могу смириться с произошедшим…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245195
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245196
    m_Localized: 'Anger: СУКА, НЕНАВИЖУ СЕБЯ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245197
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245198
    m_Localized: 'Anger: Лучше я буду причинять боль себе, чем окружающим. Я заслужил всё это.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245199
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245200
    m_Localized: 'Anger: Оставь меня. Мне нужно побыть одному.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245201
    m_Localized: 'Anger: Ты серьёзно? Блять…Ну давай, только побыстрее!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245202
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245203
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245204
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245205
    m_Localized: Подмышки
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245206
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245207
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245208
    m_Localized: 'Anger: Да похуй. На.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245209
    m_Localized: 'Anger: Жёлтые? Ну и хуй с ними.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245210
    m_Localized: 'Anger: Белые? Ну какими им быть, если я просто ухаживаю за собой?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245211
    m_Localized: 'Anger: Я как-то давно думал, что если уж мои зубы такие, то пусть хоть один будет золотым. Типа, знаешь, как в кино у крутых мужиков.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245212
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245213
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245214
    m_Localized: 'Anger: Да не вопрос.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245215
    m_Localized: 'Anger: О, да, смотри, какие лапищи.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245216
    m_Localized: 'Anger: Ха. Бабушка в детстве говорила, что с такими руками мне дрова колоть, а не… заниматься тем, чем я занимался...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245217
    m_Localized: 'Anger: Но тут нечего колоть, а злобу куда-то выплеснуть надо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245218
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245219
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245220
    m_Localized: 'Anger: Твои дела, но мне плевать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245221
    m_Localized: 'Anger: Что, цвет нравится? Голубые. Всегда такие были. Мне кроме них ничего и не надо было, чтобы девчонку склеить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245222
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245223
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245224
    m_Localized: 'Anger: Вообще похуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245225
    m_Localized: 'Anger: Да, брею.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245226
    m_Localized: 'Anger: Меня бесит, когда волосню под мышками оставляют, как будто ебучий кустарник там растить собрались.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245227
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245228
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245229
    m_Localized: 'Anger: Херачь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245230
    m_Localized: 'Anger: Чё? Ты чё на меня так уставился? Чё ты там увидел?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245231
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245232
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245233
    m_Localized: 'Anger: Блять…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245234
    m_Localized: 'Anger: Чего ты так уставился? Чего-то не хватает?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245235
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245236
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245237
    m_Localized: 'Anger: Ты что, ёбнулся? Я тебе просто зубы показал.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245238
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245239
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245240
    m_Localized: 'Anger: Ты, сука, что, думаешь, я с такой лапой не смогу тебе в еблет прописать быстрее, чем ты нажмёшь на курок?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245241
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245242
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245243
    m_Localized: 'Anger: Ты на что, блять, намекаешь? Завидуешь, что ли?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245244
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245245
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245246
    m_Localized: 'Anger: Оно чешется постоянно, будто провоцирует на что-то.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245247
    m_Localized: 'Anger: Когда расчёсываю до крови – зуд успокаивается.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245248
    m_Localized: 'Anger: Поверить не могу. Да ты просто ебанутый!..'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245249
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245250
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245251
    m_Localized: 'Anger: Ты, сука, хочешь в меня выстрелить из-за ёбаной фотки?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245252
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245253
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245254
    m_Localized: 'Anger: Ты осторожнее своей бум-палкой маши.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245255
    m_Localized: 'Anger: Ещё из-за ушей меня случайно застрелишь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245256
    m_Localized: 'Anger: Да ты, блять, больной на всю голову. А ну иди сюда, сука!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245257
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245258
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245259
    m_Localized: 'Anger: А ты, блять, вообще мудак бесчувственный.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245260
    m_Localized: 'Anger: Ну и катись нахуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245261
    m_Localized: 'Anger: У моей бабушки был золотой зуб. Я ещё пацаном был, когда понял, что мне хочется такой же.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245262
    m_Localized: 'Anger: Он блестел так, будто у неё во рту солнце застряло.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245263
    m_Localized: 'Anger: Бабушка говорила, что его поставили, когда старый сгнил.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245264
    m_Localized: 'Anger: Я тогда даже радовался, думал: “Ну и круто, мне тоже такой сделают, когда время придёт.”'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245265
    m_Localized: 'Anger: А потом… Ну, время-то пришло. Только никто мне ничего не поставил.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245266
    m_Localized: 'Anger: И вот теперь у меня не солнце во рту, а просто обоссанные жёлтые зубы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245267
    m_Localized: 'Anger: Видишь руки? Грязь, кровь – всё, что хочешь. Но это не чужая. Своя.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245268
    m_Localized: 'Anger: Руки иногда чешутся так, будто хочется разодрать всю кожу. Или уебать в стену. Или и то, и другое сразу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245269
    m_Localized: 'Anger: Сдержаться у меня не получается. А других бить не хочу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245270
    m_Localized: 'Anger: Видишь ногти? Грязь, кровь – всё, что хочешь. Но это не чужая. Своя.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245271
    m_Localized: 'Anger: Руки иногда чешутся так, будто хочется разодрать всю кожу. Или уебать в стену. Или и то, и другое сразу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245272
    m_Localized: 'Anger: Наверное, если б я был другим человеком, мне бы стало страшно от того, что я с собой делаю. Но мне похую.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245273
    m_Localized: 'Anger: Меня бабушка называла “ангельским дитём” из-за цвета глаз. Ага, ангел, блять.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245274
    m_Localized: 'Anger: И вот теперь я стою, гляжу в эти зеркала души и думаю: ну какой из меня, нахуй, ангел?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245275
    m_Localized: 'Anger: Я так и вижу, как она на меня смотрит. И разочаровывается.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245276
    m_Localized: 'Anger: Знаешь, бритвы достаточно острые, чтобы… что-то сделать. Если бы это было так просто…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245277
    m_Localized: 'Anger: Но в итоге только руку себе поцарапал. Теперь, когда бреюсь, кажется, будто нож режет не волосы, а меня самого.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245278
    m_Localized: 'Anger: Но бреюсь всё равно. Потому что ненавижу, блять, этот кустарник.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245279
    m_Localized: 'Anger: У меня даже фото бабушки не сохранилось. Она не любила эту херню.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245280
    m_Localized: 'Anger: Говорила, что если сфоткают – душу в фотокарточке запечатают, и она уже не выберется.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245281
    m_Localized: 'Anger: Я тогда ржал, говорил ей: “Ну бабуль, ну хуйня же это.”'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245282
    m_Localized: 'Anger: А она мне: “Вот когда помру, ты посмотришь на мою фотокарточку и подумаешь, на небесах ли я.”'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245283
    m_Localized: 'Anger: Ну и вот, блять. Нет ни фотки, ни бабки.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245284
    m_Localized: 'Anger: Бывает, замечаю, что дёргаю мочку уха, но только когда она уже горит как пиздец.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245285
    m_Localized: 'Anger: Раньше думал, что это нервная херня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245286
    m_Localized: 'Anger: А потом понял, что я просто хочу оторвать эту часть себя, будто она мне мешает.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245287
    m_Localized: 'Anger: Но я же не долбанутый, чтобы себя резать, верно?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245288
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245289
    m_Localized: 'Anger: Верно???'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245290
    m_Localized: 'FortuneTeller: Я чувствую здесь застой какой-то энергии.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245291
    m_Localized: 'FortuneTeller: Что-то очень плохое.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245292
    m_Localized: 'FortuneTeller: Солнце, лев, пятый дом. Всё понятно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245293
    m_Localized: 'FortuneTeller: Вы довольно напористый человек, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245294
    m_Localized: Чего?
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245295
    m_Localized: Мне ничего не надо
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245296
    m_Localized: 'FortuneTeller: Вижу, вы любите делать, а не говорить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245297
    m_Localized: 'FortuneTeller: Типичный лев, понимаете, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245298
    m_Localized: 'FortuneTeller: И вы здесь скопили как-то много неприятной тёмной энергии.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245299
    m_Localized: 'FortuneTeller: Пока не понимаю, почему.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245300
    m_Localized: 'FortuneTeller: Всё так запущено, наверно, надо аффирмации начинать тут.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245301
    m_Localized: Нахер ты меня этим грузишь?
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245302
    m_Localized: Так, и что?
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245303
    m_Localized: 'FortuneTeller: Так я же не предлагаю ничего.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245304
    m_Localized: 'FortuneTeller: Я помогу вам понять причинно-следственную связь, понимаете, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245305
    m_Localized: 'FortuneTeller: Есть карма шесть-девять, вот они как рыбки друг за другом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245306
    m_Localized: 'FortuneTeller: Сначала ты, потом тебе, понимаешь, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245307
    m_Localized: Нахер ты меня этим грузишь?
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245308
    m_Localized: Так, и что?
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245309
    m_Localized: 'FortuneTeller: Я понимаю, что для вас это всё стресс, поскольку вы – асцендентный козерог.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245310
    m_Localized: 'FortuneTeller: Вы совмещаете в себе несколько созвездий сразу, вы комплексный человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245311
    m_Localized: 'FortuneTeller: И вот с помощью аффирмаций мы сможем дойти до глубин вашего космоса, понимаете, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245312
    m_Localized: 'FortuneTeller: Сразу всё встанет на свои места.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245313
    m_Localized: Проходи
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245314
    m_Localized: Тебе лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245315
    m_Localized: 'FortuneTeller: В вашем роду и реинкарнациях были тюремные надзиратели.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245316
    m_Localized: 'FortuneTeller: Дайте этому место, вы просто повторяете опыт прошлых перерождений.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245317
    m_Localized: 'FortuneTeller: Вам сейчас надо простить и принять это в себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245318
    m_Localized: 'FortuneTeller: После этого можете разорвать цепочку бесконечного цикла.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245319
    m_Localized: 'FortuneTeller: Понимаете, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245320
    m_Localized: Проходи
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245321
    m_Localized: Тебе лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245322
    m_Localized: 'FortuneTeller: Хорошо, у тебя тут положение прям ресурсное, если честно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245323
    m_Localized: 'FortuneTeller: Идёт энергетический поток через твой дом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245324
    m_Localized: 'FortuneTeller: Значит, тебе не интересно работать над собой?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245325
    m_Localized: 'FortuneTeller: Стать лучшей версией себя?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245326
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245327
    m_Localized: 'FortuneTeller: Очень грустно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245328
    m_Localized: 'FortuneTeller: Займусь аффирмацией тебе на понос.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245329
    m_Localized: 'FortuneTeller: Погадать на картах?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245330
    m_Localized: Откуда ты знаешь обо мне всё это?
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245331
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245332
    m_Localized: 'FortuneTeller: Ха! Ну ты смешной… Это ведь не я знаю, это звёзды говорят.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245333
    m_Localized: 'FortuneTeller: Ты же Луна в шестом доме с кармой Венеры — у тебя это прямо написано на лице, понимаешь, да? Ещё такой молчаливый…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245334
    m_Localized: 'FortuneTeller: Был у меня когда-то один человек, такой же, как ты. Он тоже всё слушал, но молчал.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245335
    m_Localized: 'FortuneTeller: Знаешь, как говорится, у кого Юпитер в восьмом доме, тем лучше молчать. Это знак закрытых дверей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245336
    m_Localized: 'FortuneTeller: Погадать на картах?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245337
    m_Localized: И что же случилось с тем человеком?
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245338
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245339
    m_Localized: 'FortuneTeller: Я ему говорила: "Не важно, что ты делаешь. Важно, что делает твоя аура, пока ты это делаешь." Он всё сомневался в моих словах.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245340
    m_Localized: 'FortuneTeller: Так жизнь и прошла мимо него.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245341
    m_Localized: 'FortuneTeller: А я однажды закрыла глаза и представила мечту.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245342
    m_Localized: 'FortuneTeller: Вложила всю энергию в этот образ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245343
    m_Localized: 'FortuneTeller: Если ты не открываешь сердце энергии, то зачем вообще живёшь в этом теле?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245344
    m_Localized: 'FortuneTeller: Ты ведь можешь так же. Закрой глаза…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245345
    m_Localized: 'FortuneTeller: Представь, что ты уже у цели…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245346
    m_Localized: 'FortuneTeller: Посмотри на неё…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245347
    m_Localized: 'FortuneTeller: Знаешь, почему ты страдаешь? Потому что ты ещё не понял, что страдание – это высшая форма радости.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245348
    m_Localized: 'FortuneTeller: Скажи мне, готов ли ты к этому шагу?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245349
    m_Localized: 'FortuneTeller: Погадать на картах?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245350
    m_Localized: Что значит «быть готовым»?
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245351
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245352
    m_Localized: 'FortuneTeller: Быть готовым – это значит выбрать себя. Ты чувствуешь запах? Это запах твоих несбывшихся желаний. Пора их выпускать наружу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245353
    m_Localized: 'FortuneTeller: Когда я была в самом низу, без света и смысла, моя наставница сказала одну вещь: "Ты не слушаешь свой океан".'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245354
    m_Localized: 'FortuneTeller: Я сначала смеялась. Какой океан? А потом закрыла глаза и вдруг услышала. Этот звук, как будто он всегда был во мне. Ты тоже можешь это услышать!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245355
    m_Localized: 'FortuneTeller: Но главное – задай себе вопрос: готов ли ты соединиться с собой?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245356
    m_Localized: 'FortuneTeller: Погадать на картах?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245357
    m_Localized: Кем была твоя наставница?
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245358
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245359
    m_Localized: 'FortuneTeller: Великая женщина. Она была словно маяк в буре, научила меня видеть суть вещей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245360
    m_Localized: 'FortuneTeller: Никогда не забуду её великие слова: "Люди умирают только потому, что они не научились вдыхать свет изнутри."'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245361
    m_Localized: 'FortuneTeller: Она открыла мне глаза: я могу помогать людям находить их уникальный путь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245362
    m_Localized: 'FortuneTeller: Но знаешь, она боялась идти дальше.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245363
    m_Localized: 'FortuneTeller: Она не видела себя в центре. А ведь важно быть в центре, понимаешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245364
    m_Localized: 'FortuneTeller: Если не ты в центре своей вселенной, то кто тогда? Понимаешь, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245365
    m_Localized: 'FortuneTeller: Погадать на картах?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245366
    m_Localized: А как ты помогла себе?
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245367
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245368
    m_Localized: 'FortuneTeller: Все твои ошибки – это просто коды твоей вселенной, которые ты ещё не расшифровал.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245369
    m_Localized: 'FortuneTeller: Я прошла огромный путь. Посмотри вокруг, оглянись назад. Ты ведь видишь, какой у меня сейчас дом?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245370
    m_Localized: 'FortuneTeller: Светлый, просторный, в гармонии с моей энергией. Главное, что не надо пытаться бороться с этим домом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245371
    m_Localized: 'FortuneTeller: Он уже впитал твой страх. Прими его, иначе стены начнут плакать твоими слезами. Понимаешь, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245372
    m_Localized: 'FortuneTeller: Погадать на картах?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245373
    m_Localized: А ты что хочешь получить от меня?
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245374
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245375
    m_Localized: 'FortuneTeller: Ох, милый мой, ты думаешь, я чего-то хочу?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245376
    m_Localized: 'FortuneTeller: Проблема в том, что, увидев танец собственной тени, ты бы понял, где спрятан твой путь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245377
    m_Localized: 'FortuneTeller: Короче, тебе нужно просто запустить аффирмацию на счастье. Ты ведь чувствуешь, как всё здесь меняется? Становится легче дышать, правда?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245378
    m_Localized: 'FortuneTeller: Это моя энергия соединяется с твоим пространством. Не ищи смысл. Смысл – это иллюзия для тех, кто боится принимать хаос.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245379
    m_Localized: 'FortuneTeller: Я прошу тебя стать частью этого пространства. Сказать: "Я здесь не просто гость, я его творец".'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245380
    m_Localized: 'FortuneTeller: Погадать на картах?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245381
    m_Localized: 'А если я скажу: "Я не хочу быть творцом"?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245382
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245383
    m_Localized: 'FortuneTeller: Твои стены давно хотят обнять тебя, но ты держишь их в цепях своего контроля.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245384
    m_Localized: 'FortuneTeller: Тишина внутри тебя – это голос мира, который ты глушишь своим страхом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245385
    m_Localized: 'FortuneTeller: Твоя энергия вязнет как мёд в холоде. Ты должен её разморозить своим дыханием. А зеркала не лгут.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245386
    m_Localized: 'FortuneTeller: Если ты видишь там только себя, значит, ты ничего не видишь. Всё, что тебе нужно – это просто сдвинуть свою энергию на три градуса вправо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245387
    m_Localized: 'FortuneTeller: И ты наконец будешь счастлив.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245388
    m_Localized: 'FortuneTeller: Ох, милый, я знала, что твоя энергия будет сопротивляться. Но давай проверим — я всё равно вижу тебя насквозь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245389
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245390
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245391
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245392
    m_Localized: Подмышки
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245393
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245394
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245395
    m_Localized: 'FortuneTeller: Ладно, смотри.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245396
    m_Localized: 'FortuneTeller: Глаза - это отражение нашего космоса, а не зубы. Хочешь в моих зубах увидеть свою судьбу?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245397
    m_Localized: 'FortuneTeller: Глаза - это отражение нашего космоса, а не зубы. Зачем их так разглядывать?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245398
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245399
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245400
    m_Localized: 'FortuneTeller: Ну, пожалуйста, смотри.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245401
    m_Localized: 'FortuneTeller: Только осторожно — занозы от ловца снов ещё не вытащила.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245402
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245403
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245404
    m_Localized: 'FortuneTeller: Ой, глаза мои? Карие, конечно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245405
    m_Localized: 'FortuneTeller: Ну, это если не считать периодических красных пятнышек — Луна виновата.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245406
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245407
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245408
    m_Localized: 'FortuneTeller: Ох… что только Вселенная не оставляет на моём пути… Ладно, смотри.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245409
    m_Localized: 'FortuneTeller: В тутошних условиях сложно за собой ухаживать, знаешь ли…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245410
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245411
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245412
    m_Localized: 'FortuneTeller: Будь осторожен. Моя аура может и ослепить!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245413
    m_Localized: 'FortuneTeller: Ну как?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245414
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245415
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245416
    m_Localized: 'FortuneTeller: Ну смотри, только осторожно — они всё слышат, даже твои мысли.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245417
    m_Localized: 'FortuneTeller: Ну что? Нашёл ответы?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245418
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245419
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245420
    m_Localized: 'FortuneTeller: Ты что, из-за зубов в меня стрелять собрался? Ты же понимаешь, что это не из-за меня? Это Марс обиделся на Венеру.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245421
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245422
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245423
    m_Localized: 'FortuneTeller: Ты что, серьёзно? За руки с занозами стрелять будешь? Это последствия работы с ловцами снов!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245424
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245425
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245426
    m_Localized: 'FortuneTeller: Ты что?! Это ж просто Луна шалит, понимаешь, да? За её движениями не так просто уследить!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245427
    m_Localized: 'FortuneTeller: Ты что?! Это ж просто Луна шалит, понимаешь, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245428
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245429
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245430
    m_Localized: 'FortuneTeller: Это уже не астрология, а какая-то дичь! Давай-ка ты уберёшь ружьё, а я тебе ещё расскажу своих тайн. Бесплатно!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245431
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245432
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245433
    m_Localized: 'FortuneTeller: Эй! Я ж не виновата, что ты к такому не готов, голубчик!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245434
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245435
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245436
    m_Localized: 'FortuneTeller: Может, опустишь эту штуку? Ну что ты по ушам поймёшь? Они нужны для того, чтобы слушать мудрых людей!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245437
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245438
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245439
    m_Localized: 'FortuneTeller: Убьёшь меня – будешь обречён на…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245440
    m_Localized: 'FortuneTeller: Вечный понос!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245441
    m_Localized: 'FortuneTeller: Знаешь, однажды ко мне пришёл человек с идеальными зубами.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245442
    m_Localized: 'FortuneTeller: Я ему сказала: "Всё хорошо, но твоя душа-то прогнила!" Вот и думай после этого, что важнее. Понимаешь, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245443
    m_Localized: 'FortuneTeller: Однажды после обряда я всю ночь вытаскивала занозы. Больно было, но знаешь что? Каждая заноза — это как урок от Вселенной. Понимаешь, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245444
    m_Localized: 'FortuneTeller: Глаза — это врата в другой мир. Однажды у одного человека они светились, как фонари. Он сказал, что это от любви, но я думаю — от Марса.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245445
    m_Localized: 'FortuneTeller: Ты знаешь, однажды я три недели жила аскетично и думала только о своей мечте.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245446
    m_Localized: 'FortuneTeller: Мысли материальны, и так я приближаюсь к исполнению желания. Нужно всего-то правильно его загадать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245447
    m_Localized: 'FortuneTeller: Наверное, сейчас моё нынешнее состояние может сравниться с тамошним.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245448
    m_Localized: 'FortuneTeller: Знаешь, однажды мне сделали такое фото, что я подумала: это знак от звёзд! А потом поняла: просто свет неправильно упал.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245449
    m_Localized: 'FortuneTeller: Однажды я услышала в ушах шум, как будто Вселенная мне что-то сказала. Но я думаю, это было что-то гораздо сильнее.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245450
    m_Localized: 'FortuneTeller: Однажды я услышала в ушах шум, как будто Вселенная мне что-то сказала. Оказалось, это просто сквозняк. Но знаешь, мне всё равно понравилось.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245451
    m_Localized: 'Gasmask: Доброй ночи.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245452
    m_Localized: 'Gasmask: Я из бригады КЧС, обходим ваш район.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245453
    m_Localized: Ты пришёл один?
    m_Metadata:
      m_Items: []
  - m_Id: 2922817245454
    m_Localized: Почему тебе можно доверять?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439488
    m_Localized: 'Gasmask: Нет, конечно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439489
    m_Localized: 'Gasmask: Наша бригада разбилась на несколько небольших групп, чтобы охватить больше домов.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439490
    m_Localized: 'Gasmask: Думаю, наш разговор много времени не займёт.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439491
    m_Localized: Почему ты в защитном костюме? Нам тоже нужен?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439492
    m_Localized: Как ты будешь помогать нам?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439493
    m_Localized: 'Gasmask: Я могу показать удостоверение.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439494
    m_Localized: 'Gasmask: К тому же, Гости редко ходят группами, даже почти никогда.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439495
    m_Localized: Почему ты в защитном костюме? Нам тоже нужен?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439496
    m_Localized: Как ты будешь помогать нам?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439497
    m_Localized: 'Gasmask: Нет. Но вы можете купить такой, если посчитаете нужным.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439498
    m_Localized: 'Gasmask: Мы пока в процессе изучения влияния солнца на окружение.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439499
    m_Localized: 'Gasmask: Раз мы часто находимся на улице, нам важно быть настороже.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439500
    m_Localized: И что дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439501
    m_Localized: У вас есть план действий?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439502
    m_Localized: 'Gasmask: Первым делом мы соберём данные и отправим их руководству.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439503
    m_Localized: 'Gasmask: Дальше они выработают алгоритм действий.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439504
    m_Localized: 'Gasmask: Вам сейчас нужно просто сохранять спокойствие.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439505
    m_Localized: И что дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439506
    m_Localized: У вас есть план действий?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439507
    m_Localized: 'Gasmask: Я возьму одного человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439508
    m_Localized: 'Gasmask: Мы соберем анализы, чтобы убедиться, что с человеком, который прожил в этом районе, всё хорошо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439509
    m_Localized: 'Gasmask: И проверим, человек ли он, конечно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439510
    m_Localized: Мне нужно собираться?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439511
    m_Localized: Мне просто ждать чего-то?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439512
    m_Localized: 'Gasmask: Конечно. Мы же не можем действовать спонтанно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439513
    m_Localized: 'Gasmask: Мы отвезём одного вашего человека к нам в лабораторию.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439514
    m_Localized: 'Gasmask: Он просто сдаст анализы, мы убедимся, что всё хорошо и вернём обратно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439515
    m_Localized: Мне нужно собираться?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439516
    m_Localized: Мне просто ждать чего-то?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439517
    m_Localized: 'Gasmask: Это ваш дом?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439518
    m_Localized: 'Gasmask: Тогда не надо, оставайтесь с жильцами другими, если нужно будет эвакуироваться – мы сообщим.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439519
    m_Localized: 'Gasmask: Теперь мы забираем одного человека, мы пойдём.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439520
    m_Localized: 'Gasmask: Всего доброго.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439521
    m_Localized: 'Gasmask: Да. Когда у нас будет вся информация, мы выдадим инструкции.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439522
    m_Localized: 'Gasmask: Не стоит сейчас волноваться.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439523
    m_Localized: 'Gasmask: Мы забираем одного человека, постараемся вернуть как можно скорее.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439524
    m_Localized: 'Gasmask: До свидания.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439525
    m_Localized: 'Prophet: Мы снова встретились.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439526
    m_Localized: 'Prophet: Я помню, что в прошлый раз было по-другому. Но мы живём…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439527
    m_Localized: 'Prophet: Хм, странно, не знаю как объяснить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439528
    m_Localized: 'Prophet: Мне хочется начать наше общение с… одной активности.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439529
    m_Localized: 'Prophet: Погадаешь мне по книге? Какую страницу открыть?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439530
    m_Localized: Давай где-нибудь в начале
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439531
    m_Localized: Открой просто в середине
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439532
    m_Localized: Открой в конце
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439533
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439534
    m_Localized: 'Prophet: “Мёртвый придёт и скажет, и ему не поверят”.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439535
    m_Localized: 'Prophet: Надо же…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439536
    m_Localized: 'Prophet: Это всё ещё актуально.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439537
    m_Localized: 'Prophet: Хотя сейчас это и не удивительно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439538
    m_Localized: Что это значит?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439539
    m_Localized: Ты сам-то веришь в это?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439540
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439541
    m_Localized: 'Prophet: Кто ты такой?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439542
    m_Localized: 'Prophet: Я? Я это я. А ты… ты была моим домом”.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439543
    m_Localized: 'Prophet: Хм. Да. Печальная история.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439544
    m_Localized: 'Prophet: Разве, это нас и ждёт?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439545
    m_Localized: 'Prophet: Вполне возможно, что и так.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439546
    m_Localized: Что это значит?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439547
    m_Localized: Ты сам-то веришь в это?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439548
    m_Localized: 'Prophet: “Так давно это было. Может, видел во сне? Возможно, мы с тобой как те рыбы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439549
    m_Localized: 'Prophet: Только чьи-то воспоминания того, кого давно нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439550
    m_Localized: 'Prophet: Может, ничего уже не осталось, кроме дождя”.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439551
    m_Localized: 'Prophet: Хм. Или даже скоро можем стать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439552
    m_Localized: 'Prophet: Как ты думаешь? Мы уже чей-то сон или только станем в будущем?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439553
    m_Localized: 'Prophet: Интересная тебе выпала строчка.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439554
    m_Localized: Что это значит?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439555
    m_Localized: Ты сам-то веришь в это?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439556
    m_Localized: 'Prophet: Это надо хорошо обдумать. Есть ли у тебя самого мысли на этот счёт?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439557
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439558
    m_Localized: 'Prophet: На самом деле я пришёл сказать тебе кое-что.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439559
    m_Localized: 'Prophet: Через некоторое время произойдут такие действия…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439560
    m_Localized: 'Prophet: Тебе нужно быть готовым.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439561
    m_Localized: 'Prophet: Я понимаю, звучит странно, но тебе  надо впустить персону с котом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439562
    m_Localized: 'Prophet: Точно знаю, что тебе это поможет. Пока не могу сказать как.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439563
    m_Localized: 'Prophet: Но выбирать тебе, конечно, что с этой информацией делать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439564
    m_Localized: 'Prophet: А пока я подумаю над значением твоего выбора в гадании.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439565
    m_Localized: 'Prophet: Не совсем.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439566
    m_Localized: 'Prophet: Лучше смотреть на это как на совет. Чтобы не забыть что-то сделать или обратить внимание.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439567
    m_Localized: 'Prophet: Пока я думал над этим, мне пришло в голову знание.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439568
    m_Localized: 'Prophet: Скоро придёт персона с котом. Тебе важно впустить их домой.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439569
    m_Localized: 'Prophet: Не могу пока сказать зачем. Но так должно стать проще.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439570
    m_Localized: 'Prophet: А пока я должен уйти. Обдумать твой выбор из книги.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439571
    m_Localized: 'Fanatic: Привет, человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439572
    m_Localized: 'Fanatic: Как же нам повезло! Мы застали своими глазами наказание людских страстей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439573
    m_Localized: 'Fanatic: Земля очистится, солнце сделает свою работу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439574
    m_Localized: 'Fanatic: И мы пойдем в новый чистый мир!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439575
    m_Localized: 'Fanatic: ВОТ ТАКАЯ, БЛЯТЬ, БЛАГОДАТЬ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439576
    m_Localized: Что?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439577
    m_Localized: Ты меня пугаешь.
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439578
    m_Localized: 'Fanatic: Да ты чего, ЧЕЛОВЕК?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439579
    m_Localized: 'Fanatic: А ну-ка послушай, сейчас я тебе кратко сводочку расскажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439580
    m_Localized: 'Fanatic: Солнце горит и ПЕЧЕТ НАС не просто так! Оно из нас выпекает грехи!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439581
    m_Localized: 'Fanatic: Мы все натворили всяких дел, и вот теперь СОЛНЦЕ ЗЛИТСЯ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439582
    m_Localized: 'Fanatic: ДАЕТ ПО НАМ СВОЙ УДАР!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439583
    m_Localized: 'Fanatic: И это хорошо. Все грехи закончатся, будем жить как следует.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439584
    m_Localized: То есть мы должны умереть?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439585
    m_Localized: А с тобой что будет?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439586
    m_Localized: 'Fanatic: С ума, что ли, сошел?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439587
    m_Localized: 'Fanatic: А ну-ка послушай, сейчас я тебе кратко сводочку расскажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439588
    m_Localized: 'Fanatic: Солнце горит и ПЕЧЕТ НАС не просто так! Оно из нас выпекает грехи!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439589
    m_Localized: 'Fanatic: Мы все натворили всяких дел, и вот теперь СОЛНЦЕ ЗЛИТСЯ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439590
    m_Localized: 'Fanatic: ДАЕТ ПО НАМ СВОЙ УДАР!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439591
    m_Localized: 'Fanatic: И это хорошо. Все грехи закончатся, будем жить как следует.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439592
    m_Localized: То есть мы должны умереть?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439593
    m_Localized: А с тобой что будет?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439594
    m_Localized: 'Fanatic: Да какое там!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439595
    m_Localized: 'Fanatic: Грехи умрут, солнце, может быть, умрет. А МЫ БУДЕМ ЖИТЬ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439596
    m_Localized: 'Fanatic: Больше не будет ни смертей, ни воровства, ни жадных ублюдков, которые не могу продать мне то, что я хочу за справедливую цену.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439597
    m_Localized: 'Fanatic: Ты можешь себе такое представить? Ты понимаешь, что это все такое?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439598
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439599
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439600
    m_Localized: 'Fanatic: Да я тут причем?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439601
    m_Localized: 'Fanatic: Мы все будем ХОРОШО ЖИТЬ сразу после помощи солнца.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439602
    m_Localized: 'Fanatic: Солнце поможет просто нам избавиться от всего вот этого, понимаешь? Нет?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439603
    m_Localized: 'Fanatic: Да все ты понимаешь, поэтому ты и жив!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439604
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439605
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439606
    m_Localized: 'Fanatic: Я тебе еще расскажу много про все это!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439607
    m_Localized: 'Fanatic: У тебя пиво-то есть, забыл спросить?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439608
    m_Localized: 'Fanatic: Ты притворялся, что ли, что не знаешь ничего про солнце?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439609
    m_Localized: 'Fanatic: Ну и иди тогда нахуй, я СПАСУ КОГО-НИБУДЬ ЕЩЕ-Е-Е!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439610
    m_Localized: 'Fanatic: Все, пока, пока-а-а-а!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439611
    m_Localized: 'Fanatic: Внимаю твоим словам, человек. Говори!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439612
    m_Localized: Ты представитель какой-то веры?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439613
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439614
    m_Localized: 'Fanatic: ДА, ЧЕЛОВЕК! Но вера моя не похожа на привычные религии.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439615
    m_Localized: 'Fanatic: Я поклоняюсь САМОМУ СОЛНЦЕЛИКОМУ! ИБО ОН ЗАЩИЩАЕТ НАС!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439616
    m_Localized: 'Fanatic: Но глупые люди видят в нём лишь плохое. Им кажется, что оно сжигает нас всех...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439617
    m_Localized: 'Fanatic: ЧУШЬ СОБАЧАЯ! Гнев его направлен на ростки зла и еретиков! Грешны они потому что.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439618
    m_Localized: 'Fanatic: А те, кто думают иначе – пусть лучше не попадают под горячую праведную руку!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439619
    m_Localized: 'Fanatic: Сами на рожон лезут, и удивляются отчего сгорают.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439620
    m_Localized: Ростки зла?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439621
    m_Localized: Еретики?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439622
    m_Localized: 'Fanatic: Ты меня ещё спрашиваешь? Ты что, не знаешь КТО ТАКИЕ ИНОПЛАНЕТЯНЕ!?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439623
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439624
    m_Localized: 'Fanatic: Ладно, человек, сейчас я расскажу тебе САМУ ПРАВДУ МАТКУ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439625
    m_Localized: 'Fanatic: Так вот, ГОСТИ – РОСТКИ ЗЛА!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439626
    m_Localized: 'Fanatic: ОНИ НАСЛЕДНИКИ ИНОПЛАНЕТЯН, прилетевших на землю, когда солнце было моложе, а трава зеленее!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439627
    m_Localized: 'Fanatic: ЧЁРТОВЫ ВАССАЛЫ, которых поселили в землю, и те взращивались ВЕКАМИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439628
    m_Localized: 'Fanatic: А теперь, они вылезли и хотят отнять НАШУ ЗЕМЛЮ, БУДТО ЭТО ИХ ВЛАДЕНИЯ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439629
    m_Localized: 'Fanatic: Но СОЛНЦЕ решило защитить нас, ибо ЭТО НАША ЗЕМЛЯ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439630
    m_Localized: 'Fanatic: Поэтому солнце Гостям НЕМИЛОСТИВО! Иначе, чего они под землёй прятались-то всё это время?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439631
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439632
    m_Localized: 'Fanatic: Бля… Что же ты так набухался-то в тот вечер…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439633
    m_Localized: 'Fanatic: Не надо было пить до потери сознания. Праведный гнев Солнцеликого, он…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439634
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439635
    m_Localized: 'Fanatic: Упокой его душу, СОЛНЦЕЛИКИЙ, и прости его за грехи наши.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439636
    m_Localized: 'Fanatic: Прими его с распростёртыми объятиями. И пожалуй, душу Фикуса, который он уже не сможет полить…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439637
    m_Localized: 'Fanatic: Аминь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439638
    m_Localized: 'Fanatic: Да, человек, ты не ослышался!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439639
    m_Localized: 'Fanatic: КЧС – проклятые ЕРЕТИКИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439640
    m_Localized: 'Fanatic: Они вмешиваются в процессы, которые НАМ, ПРОСТЫМ ЛЮДЯМ, не подвластны!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439641
    m_Localized: 'Fanatic: Они суют свой нос куда не следует.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439642
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439643
    m_Localized: 'Fanatic: Бля, будь прокляты те уебаны, что пизданули мою мать в лужу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439644
    m_Localized: 'Fanatic: Внимаю твоим словам, человек. Говори!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439645
    m_Localized: Как-то много людей сожгло солнце
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439646
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439647
    m_Localized: 'Fanatic: Всё верно, это всё грешники, человек!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439648
    m_Localized: 'Fanatic: Солнце решило наказать их ВСЕХ за грехи, что люди вершили на протяжении ТЫСЯЧЕЛЕТИЙ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439649
    m_Localized: 'Fanatic: А ГОСТИ, ЭТИ ХУЙЛА ЕБУЧИЕ, начали тянуться к СОЛНЦУ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439650
    m_Localized: 'Fanatic: Но СОЛНЦЕ не для них, мигрантов подземных, а для нас, ЛЮДЕЙ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439651
    m_Localized: 'Fanatic: ОНО НАШЕ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439652
    m_Localized: 'Fanatic: ЛЮДСКОЕ БЛАГО, НАХУЙ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439653
    m_Localized: И сколько ещё нужно сожжённых, чтобы солнце успокоилось?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439654
    m_Localized: Хочешь сказать конец света – это суд солнца?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439655
    m_Localized: 'Fanatic: Много.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439656
    m_Localized: 'Fanatic: И поверь, друг мой, это ДАЛЕКО НЕ ВСЁ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439657
    m_Localized: 'Fanatic: ЭТО ТОЛЬКО НАЧАЛО!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439658
    m_Localized: 'Fanatic: ЧАША ВЕСОВ ещё не наполнилась достаточно, чтобы уравновесить ВСЕЛЕНСКИЕ СИЛЫ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439659
    m_Localized: 'Fanatic: Нужно БОЛЬШЕ СОЖЖЁНЫХ в праведном пламени СОЛНЦА!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439660
    m_Localized: 'Fanatic: Но знай, друг мой, эти жертвы будут не напрасны!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439661
    m_Localized: 'Fanatic: Когда-нибудь мы все поймём истинные замыслы солнцеликого…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439662
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439663
    m_Localized: 'Fanatic: Бля, иногда по ночам я очень грущу от того, что жёнушка меня бросила…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439664
    m_Localized: 'Fanatic: Святая женщина была…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439665
    m_Localized: 'Fanatic: Но сука та ещё.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439666
    m_Localized: 'Fanatic: Конец для кого?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439667
    m_Localized: 'Fanatic: Для нас?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439668
    m_Localized: 'Fanatic: Ха-ха-ха!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439669
    m_Localized: 'Fanatic: Не смеши меня, СОЛНЦЕ НА НАШЕЙ СТОРОНЕ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439670
    m_Localized: 'Fanatic: Оно нам помогает, неужели ты не видишь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439671
    m_Localized: 'Fanatic: Пытается загнать Гостей обратно в землю…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439672
    m_Localized: 'Fanatic: Наказывает ужасных людей за грехи человеческие…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439673
    m_Localized: 'Fanatic: Проявляет еретиков в обосанных тряпках, что стыдливо прячутся под масками.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439674
    m_Localized: 'Fanatic: Мы должны благодарить его, а не начинать трубить о конце света.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439675
    m_Localized: 'Fanatic: ЭТО КОНЕЦ ДЛЯ ВСЕХ НИХ, ВРАГОВ СОЛНЦА!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439676
    m_Localized: 'Fanatic: СМЕРТЬ ИММИГРАНТАМ ПОДЗЕМНЫМ!!! СМЕРТЬ ОБОСАННЫМ ЕРЕТИКАМ!!! СМЕРТЬ ГРЕШНИКАМ!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439677
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439678
    m_Localized: 'Fanatic: Бля, как же я давно не ел картошечки жареной…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439679
    m_Localized: 'Fanatic: Внимаю твоим словам, человек. Говори!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439680
    m_Localized: По-твоему, у происходящего есть сакральный смысл?
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439681
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439682
    m_Localized: 'Fanatic: Человек, я для чего тебе всё объяснял, разжёвывал?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439683
    m_Localized: 'Fanatic: Чтобы ты вновь задавал мне ОДНИ И ТЕ ЖЕ ВОПРОСЫ?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439684
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439685
    m_Localized: 'Fanatic: Кажется, я в тебе ошибся, человек. Ты совсем не понимаешь истинные причины происходящего.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439686
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439687
    m_Localized: 'Fanatic: Бля, вот бы пивка холодненького бахнуть…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439688
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439689
    m_Localized: 'Fanatic: Может, угостишь напоследок, человек?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439690
    m_Localized: Хорошо, держи (отдать пиво) (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439691
    m_Localized: 'Fanatic: У тебя нет пива? Да ты чего, человек!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439692
    m_Localized: 'Fanatic: Я его видел СОБСТВЕННЫМИ ГЛАЗАМИ!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439693
    m_Localized: 'Fanatic: Ну ты даёшь, человек. Столько пива выпить и даже не ПОДЕЛИТЬСЯ!?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439694
    m_Localized: Нет (не отдавать пиво)
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439695
    m_Localized: 'Fanatic: Ооо, славно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439696
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439697
    m_Localized: 'Fanatic: Ммм, какое хорошее, моё любимое, тёмное.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439698
    m_Localized: 'Fanatic: Сразу вспоминаются мои посиделки в баре с друзьями.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439699
    m_Localized: 'Fanatic: Весёлые разговоры, холодненькое пивко, гренки с соусом…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439700
    m_Localized: 'Fanatic: И угрюмая рожа тощего парня, что вечно осуждающе пялился на нас…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439701
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439702
    m_Localized: 'Fanatic: Ну да ладно, чего грустить-то. Хоть ты и глупый, но добрый, человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439703
    m_Localized: 'Fanatic: Дай я тебя отблагодарю что ли. Возьми это.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439704
    m_Localized: 'Fanatic: Да сохранит твою душу Солнцеликий!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439705
    m_Localized: 'Fanatic: Ах ты НЕГОДЯЙ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439706
    m_Localized: 'Fanatic: БУДЬ ТЫ ПРОКЛЯТ, СУКИН СЫН!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439707
    m_Localized: 'Fanatic: Ну что за неблагодарность! Я ему объясняю сакральные смыслы, значения, а он…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439708
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439709
    m_Localized: 'Fanatic: Да ты ЗЛОЙ И ТУПОЙ ЧЕЛОВЕК!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439710
    m_Localized: 'Fanatic: Тьфу на тебя. Ну и оставайся в своей халупе залупной. А я пойду в место получше.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439711
    m_Localized: 'Fanatic: Глядишь, мне позволят вернуться в бар.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439712
    m_Localized: 'Fanatic: Счастливо оставаться, тупица.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439713
    m_Localized: 'Fanatic: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439714
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439715
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439716
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439717
    m_Localized: Подмышки
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439718
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439719
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439720
    m_Localized: 'Fanatic: Мои зубы тебе показать?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439721
    m_Localized: 'Fanatic: А Я ИМИ ПРАВДЫ ОТСТАИВАЛ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439722
    m_Localized: 'Fanatic: Все правды свои я отстоял.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439723
    m_Localized: 'Fanatic: Да ты сам посмотри, что я тут в самом деле.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439724
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439725
    m_Localized: 'Fanatic: Я спасаю зубы пивным раствором, он хорошо охраняет кальций.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439726
    m_Localized: 'Fanatic: А без этого давно бы зубы растерял.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439727
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439728
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439729
    m_Localized: 'Fanatic: Понимаемо, конечно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439730
    m_Localized: 'Fanatic: Сейчас столько всего происходит, но мы живем.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439731
    m_Localized: 'Fanatic: Живем дальше.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439732
    m_Localized: 'Fanatic: Ты чего, в тени пересидел?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439733
    m_Localized: 'Fanatic: Приляг-ка ты отдохни, друг.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439734
    m_Localized: 'Fanatic: Никаких запретов, мой друг!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439735
    m_Localized: 'Fanatic: Смотри мои ногти, сколько тебе влезет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439736
    m_Localized: 'Fanatic: Я натренировался получать ими полезный солнечный свет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439737
    m_Localized: 'Fanatic: И открываю крышки пива.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439738
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439739
    m_Localized: 'Fanatic: Ты, это, просто проверить хотел?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439740
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439741
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439742
    m_Localized: 'Fanatic: ЗАГЛЯНИ В МОИ ГЛАЗА!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439743
    m_Localized: 'Fanatic: Они полны ярости и злости.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439744
    m_Localized: 'Fanatic: ЗАГЛЯНИ В МОИ ТЁМНЫЕ ГЛАЗА!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439745
    m_Localized: 'Fanatic: Я впитываю ими все блага света, прррреобразуя их в энергию.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439746
    m_Localized: 'Fanatic: Все мои силы я получаю из ГЛАЗ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439747
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439748
    m_Localized: 'Fanatic: ТЫ УВИДЕЛ В МОИХ ГЛАЗАХ ПРАВЕДНУЮ СИЛУ СОЛНЦА?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439749
    m_Localized: 'Fanatic: Если нет, ты просто слепец. Попробуй подольше посмотреть на солнце, КАК Я.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439750
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439751
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439752
    m_Localized: 'Fanatic: Сфоткаться?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439753
    m_Localized: 'Fanatic: Хм-хм-хм-хм.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439754
    m_Localized: 'Fanatic: Тебе кто-то рассказал, что я здоровался с самим СОЛНЕЧНЫМ ЛИДЕРОМ?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439755
    m_Localized: 'Fanatic: Да, я учил его смотреть на солнце, но это я как-нибудь потом расскажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439756
    m_Localized: 'Fanatic: Давай, ФОТКАЙ МЕНЯ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922821439757
    m_Localized: 'Fanatic: (Вы фотографируете неаккуратного мужчину)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633792
    m_Localized: 'Fanatic: (Как и в жизни, на фотографии он неухоженный и грязный)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633793
    m_Localized: 'Fanatic: (Вы не замечаете искажений)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633794
    m_Localized: 'Fanatic: КАК ЖЕ ПРЕКРАСНО ВСЕ ПОЛУЧИЛОСЬ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633795
    m_Localized: 'Fanatic: Приходи ко мне, буду рассказывать свое житие-бытие.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633796
    m_Localized: 'Fanatic: А ты мне за это дашь немного денег.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633797
    m_Localized: 'Fanatic: ЭТО ЖЕ НА СПАСЕНИЕ ЭНЕРГИИ СОЛНЦА!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633798
    m_Localized: 'Anxiety: Здравствуйте!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633799
    m_Localized: 'Anxiety: Извините, что так поздно, днем как-то жарко, по телевизору говорили, что лучше не выходить при солнце.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633800
    m_Localized: 'Anxiety: Не найдется ли у вас местечка для меня?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633801
    m_Localized: Ты кто?
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633802
    m_Localized: Как здесь оказалась?
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633803
    m_Localized: 'Anxiety: Ммм, я жила поближе к городу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633804
    m_Localized: 'Anxiety: Там, конечно, асфальт нагревается очень неслабо, хе-хех. Э-э-эх.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633805
    m_Localized: 'Anxiety: Я вообще кассиром работала. Когда-то, сейчас уже нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633806
    m_Localized: 'Anxiety: Меня уволили, с работой как-то не повезло…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633807
    m_Localized: Что будешь теперь делать?
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633808
    m_Localized: Как думаешь, что будет дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633809
    m_Localized: 'Anxiety: Я не то чтобы хотела приходить. Да, асфальт уже плавится под ногами, но пока не так уж все плохо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633810
    m_Localized: 'Anxiety: Вы будете смеяться.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633811
    m_Localized: 'Anxiety: У меня в доме поселились Гости. Хах, представляете? Они меня выгнали из моего же дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633812
    m_Localized: 'Anxiety: Вот, хожу теперь, ищу где бы спрятаться от солнца.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633813
    m_Localized: Что будешь теперь делать?
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633814
    m_Localized: Как думаешь, что будет дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633815
    m_Localized: 'Anxiety: Мммм. Постараюсь как-то выжить. Страшно, конечно, когда вокруг какие-то Гости, солнце адски печет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633816
    m_Localized: 'Anxiety: Очень хочется пожить. Хе-хех. О-о-о-й.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633817
    m_Localized: 'Anxiety: Разве вам не страшно?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633818
    m_Localized: 'Anxiety: Скажите, что всё скоро кончится, пожалуйста.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633819
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633820
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633821
    m_Localized: 'Anxiety: Я не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633822
    m_Localized: 'Anxiety: Выживу ли я? Кто мне поможет? Долго ли я буду искать помощь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633823
    m_Localized: 'Anxiety: Я не знаю, что вообще будет дальше. Даже не могу предположить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633824
    m_Localized: 'Anxiety: А тебе разве не страшно от этого? Мне – очень.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633825
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633826
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633827
    m_Localized: 'Anxiety: Спасибо. Ахах, спасибо, правда!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633828
    m_Localized: 'Anxiety: Господи, я проживу ещё какое-то время.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633829
    m_Localized: 'Anxiety: Ахах, о-о-о-х, да-а-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633830
    m_Localized: 'Anxiety: В любом случае спасибо, что выслушали меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633831
    m_Localized: 'Anxiety: М, ладно, видимо, я пойду дальше тогда.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633832
    m_Localized: 'Anxiety: Пока? Да, м, пока…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633833
    m_Localized: 'Anxiety: Э-э-эх. Надеюсь скоро всё это закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633834
    m_Localized: Как вас лишили дома?
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633835
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633836
    m_Localized: 'Anxiety: Охх… Я хорошо помню тот день.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633837
    m_Localized: 'Anxiety: Меня уволили, и хотелось просто добраться до дома, лечь на кровать и плакать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633838
    m_Localized: 'Anxiety: Пришла, а в прихожей куча сапог. Подумала, это соседка к себе друзей или родных привела.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633839
    m_Localized: 'Anxiety: Я пошла к её комнате, хотела узнать как у неё дела. Подойдя, я услышала странный шум.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633840
    m_Localized: 'Anxiety: Мне стало немного не по себе. Я решила тихонько взглянуть, что там происходит,'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633841
    m_Localized: 'Anxiety: Я успела только слегка разглядеть соседку, которая неподвижно лежала на кровати, как вдруг…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633842
    m_Localized: 'Anxiety: Меня одёрнул сзади какой-то неопрятный мужчина и сказал: “Туда нельзя, ей… нехорошо.”'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633843
    m_Localized: 'Anxiety: “Пойдём лучше на кухню, посидим там”. После этого он потащил меня за руку и усадил за кухонный стол.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633844
    m_Localized: 'Anxiety: Я хотела оттуда уйти, но страх сковал меня так сильно… А потом…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633845
    m_Localized: 'Anxiety: Я… Мне…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633846
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633847
    m_Localized: 'Anxiety: Мне надо немного отдохнуть, живот крутит от тревоги. Ох…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633848
    m_Localized: 'Anxiety: Э-э-эх. Надеюсь скоро всё это закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633849
    m_Localized: Что произошло дальше у вас дома?
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633850
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633851
    m_Localized: 'Anxiety: Охх…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633852
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633853
    m_Localized: 'Anxiety: После того, как меня усадили за кухонный стол, выход перегородил громила, прятавшийся за углом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633854
    m_Localized: 'Anxiety: Они начали громко болтать с тем мужчиной, который притащил меня за руку.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633855
    m_Localized: 'Anxiety: Они словно… не обращали на меня внимание. А потом… начали прикасаться ко мне!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633856
    m_Localized: 'Anxiety: Трогали меня за руки, за плечи…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633857
    m_Localized: 'Anxiety: А на фоне, будто из моей комнаты, доносились возгласы и громкий смех…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633858
    m_Localized: 'Anxiety: Казалось, что там была ещё целая толпа мужчин.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633859
    m_Localized: 'Anxiety: Мне стало тяжело дышать. Сердце вот-вот выпрыгнуло бы из груди…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633860
    m_Localized: 'Anxiety: Я хотела закричать, позвать на помощь, но голос… Страх не позволил проронить ни звука.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633861
    m_Localized: 'Anxiety: Я сидела беспомощная, как мышка.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633862
    m_Localized: 'Anxiety: Но в момент, когда громила отошёл к холодильнику что-то взять, я поняла, что это мой шанс…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633863
    m_Localized: 'Anxiety: И я бросилась к выходу. Страх будто придал мне сил. И я бежала, не оглядываясь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633864
    m_Localized: 'Anxiety: Пока не выдохлась и упала на землю…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633865
    m_Localized: Как ты не сгорела на солнце?
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633866
    m_Localized: Что произошло потом?
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633867
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633868
    m_Localized: 'Anxiety: Я не помню…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633869
    m_Localized: 'Anxiety: Мне казалось что я пролежала всю ночь, а потом…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633870
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633871
    m_Localized: 'Anxiety: Странно, мне казалось, я помню всё, что произошло со мной…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633872
    m_Localized: 'Anxiety: Постойте, вы же не хотите сказать, что я…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633873
    m_Localized: 'Anxiety: Что я…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633874
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633875
    m_Localized: 'Anxiety: Что я могу быть Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633876
    m_Localized: 'Anxiety: Нет, это не может быть правдой. Я помню свою жизнь. Своё детство, маму, папу. Нет!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633877
    m_Localized: 'Anxiety: Я же не Гость, правда? Скажите что это правда!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633878
    m_Localized: Я не знаю
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633879
    m_Localized: Ты не Гость
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633880
    m_Localized: Похоже, ты Гость
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633881
    m_Localized: 'Anxiety: Я лежала не земле, а потом…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633882
    m_Localized: 'Anxiety: А потом…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633883
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633884
    m_Localized: 'Anxiety: Мне казалось я точно помню, что было'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633885
    m_Localized: 'Anxiety: Постойте, вы же не хотите сказать, что я…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633886
    m_Localized: 'Anxiety: Что я…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633887
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633888
    m_Localized: 'Anxiety: Что я могу быть Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633889
    m_Localized: 'Anxiety: Нет, это не может быть правдой. Я помню свою жизнь. Своё детство, маму, папу. Нет!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633890
    m_Localized: 'Anxiety: Я же не Гость, правда? Скажите что это правда!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633891
    m_Localized: Я не знаю
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633892
    m_Localized: Ты не Гость
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633893
    m_Localized: Похоже, ты Гость
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633894
    m_Localized: 'Anxiety: ЗАЧЕМ ВЫ ТАКОЕ ГОВОРИТЕ? МНЕ ЖЕ СТРАШНО.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633895
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633896
    m_Localized: 'Anxiety: Мне надо отдохнуть, опять живот крутит. Охх…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633897
    m_Localized: 'Anxiety: Спасибо, мне так спокойнее.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633898
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633899
    m_Localized: 'Anxiety: Охх, мне лучше отдохнуть. Опять живот крутит.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633900
    m_Localized: 'Anxiety: ЗАЧЕМ ВЫ ТАКОЕ ГОВОРИТЕ? ТЕПЕРЬ Я ЕЩЁ СИЛЬНЕЕ БОЮСЬ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633901
    m_Localized: 'Anxiety: Я НЕ ХОЧУ УМИРАТЬ! НЕ ХОЧУ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633902
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633903
    m_Localized: 'Anxiety: Мы все умрём.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633904
    m_Localized: 'Anxiety: Э-э-эх. Надеюсь скоро всё это закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633905
    m_Localized: Вы в порядке?
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633906
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633907
    m_Localized: 'Anxiety: НЕ ПОДХОДИТЕ КО МНЕ!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633908
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633909
    m_Localized: 'Anxiety: Простите, я… думала, вы хотите меня убить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633910
    m_Localized: С чего ты это взяла?
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633911
    m_Localized: Если бы я хотел - давно бы убил
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633912
    m_Localized: 'Anxiety: Я…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633913
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633914
    m_Localized: 'Anxiety: Я совсем уже не знаю, кто Гость, а кто нет. Вдруг…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633915
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633916
    m_Localized: 'Anxiety: Вдруг вы Гость?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633917
    m_Localized: 'Anxiety: Вы меня убьёте? Кожу с меня сдерёте?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633918
    m_Localized: 'Anxiety: ПОЖАЛУЙСТА, НЕ НАДО! ЛУЧШЕ УБЕЙТЕ МЕНЯ БЫСТРО И БЕЗБОЛЕЗНЕННО.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633919
    m_Localized: 'Anxiety: Я НЕ ХОЧУ МУЧИТЕЛЬНО УМИРАТЬ. ПОЖАЛУЙСТА, НЕ НАДО.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633920
    m_Localized: Успокойтесь, я не Гость
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633921
    m_Localized: Я не собираюсь вас убивать
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633922
    m_Localized: 'Anxiety: Извините, я как на иголках.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633923
    m_Localized: 'Anxiety: Совсем уже не знаю, кому можно доверять.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633924
    m_Localized: 'Anxiety: А вдруг…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633925
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633926
    m_Localized: 'Anxiety: Вдруг вы Гость?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633927
    m_Localized: 'Anxiety: Вы меня убьёте? Кожу с меня сдерёте?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633928
    m_Localized: 'Anxiety: ПОЖАЛУЙСТА, НЕ НАДО! ЛУЧШЕ УБЕЙТЕ МЕНЯ БЫСТРО И БЕЗБОЛЕЗНЕННО.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633929
    m_Localized: 'Anxiety: Я НЕ ХОЧУ МУЧИТЕЛЬНО УМИРАТЬ. ПОЖАЛУЙСТА, НЕ НАДО.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633930
    m_Localized: Успокойтесь, я не Гость
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633931
    m_Localized: Я не собираюсь вас убивать
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633932
    m_Localized: 'Anxiety: ОТКУДА МНЕ ЗНАТЬ? Я НИ ЗУБОВ НЕ ВИДЕЛА, НИ ГЛАЗ…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633933
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633934
    m_Localized: 'Anxiety: Мы все умрём. От Гостей или от солнца…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633935
    m_Localized: 'Anxiety: Нет больше надежды. Смерть всё равно придёт…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633936
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633937
    m_Localized: 'Anxiety: Оставьте меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633938
    m_Localized: 'Anxiety: ОТКУДА МНЕ ЗНАТЬ? Я НИ ЗУБОВ НЕ ВИДЕЛА, НИ ГЛАЗ…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633939
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633940
    m_Localized: 'Anxiety: Мы все умрём. От Гостей или от солнца…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633941
    m_Localized: 'Anxiety: Нет больше надежды. Смерть всё равно придёт…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633942
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633943
    m_Localized: 'Anxiety: Оставьте меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633944
    m_Localized: 'Anxiety: Э-э-эх. Надеюсь скоро всё это закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633945
    m_Localized: Что с вами?
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633946
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633947
    m_Localized: 'Anxiety: ГОСТИ! ОНИ ИДУТ ЗА НАМИ!!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633948
    m_Localized: 'Anxiety: ВЫ НЕ СЛЫШИТЕ? МАТУШКА ЗОВЁТ НАС.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633949
    m_Localized: 'Anxiety: ГОСТЬ, ЧЕЛОВЕК… КАКАЯ РАЗНИЦА.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633950
    m_Localized: 'Anxiety: ВСЕ ЕДИНЫ ПЕРЕД СМЕРТЬЮ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633951
    m_Localized: 'Anxiety: ТАК ЗАЧЕМ МУЧИТЬСЯ В ОЖИДАНИИ? ПУСТИТЕ ИХ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633952
    m_Localized: 'Anxiety: ОНИ ХОТЯТ НАМ ДОБРА! ПУСТИТЕ ГОСТЕЙ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633953
    m_Localized: Кажется, тебе плохо
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633954
    m_Localized: Ты что, сошла с ума?
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633955
    m_Localized: 'Anxiety: НЕТ, Я ПРОСТО ПРОЗРЕЛА.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633956
    m_Localized: 'Anxiety: Я ГОСТЬ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633957
    m_Localized: 'Anxiety: МЫ И ЛЮДИ – ОДНО ЦЕЛОЕ. МЫ ТАК ПОХОЖИ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633958
    m_Localized: 'Anxiety: МЫ КАК ВАШЕ ОТРАЖЕНИЕ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633959
    m_Localized: 'Anxiety: ПРИМИТЕ ЖЕ СМЕРТЬ ВМЕСТЕ С НАМИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633960
    m_Localized: Боюсь, что ты не понимаешь что говоришь
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633961
    m_Localized: Ты не оставляешь мне выбора
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633962
    m_Localized: 'Anxiety: Я НЕ СОШЛА С УМА, Я ПРОЗРЕЛА!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633963
    m_Localized: 'Anxiety: Я ГОСТЬ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633964
    m_Localized: 'Anxiety: МЫ И ЛЮДИ – ОДНО ЦЕЛОЕ. МЫ ТАК ПОХОЖИ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633965
    m_Localized: 'Anxiety: МЫ КАК ВАШЕ ОТРАЖЕНИЕ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633966
    m_Localized: 'Anxiety: ПРИМИТЕ ЖЕ СМЕРТЬ ВМЕСТЕ С НАМИ! ОНА СКОРО ПРИДЁТ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633967
    m_Localized: Боюсь, что ты не понимаешь что говоришь
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633968
    m_Localized: Ты не оставляешь мне выбора
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633969
    m_Localized: 'Anxiety: НЕТ, ЭТО ТЫ НИЧЕГО НЕ ПОНИМАЕШЬ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633970
    m_Localized: 'Anxiety: СМЕРТЬ ПРИШЛА! СОЛНЦЕ ЗНАМЕНУЕТ ПРИХОД СМЕРТИ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633971
    m_Localized: 'Anxiety: МЫ ВСЕ СКОРО ВСТРЕТИМСЯ С НЕЙ. ОЧЕНЬ СКОРО.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633972
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633973
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633974
    m_Localized: 'Anxiety: ТАК СТРЕЛЯЙ! ЧЕГО ТЫ ЖДЁШЬ?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633975
    m_Localized: 'Anxiety: УБЬЁШЬ БЕЗ МАЛЕЙШИХ СОЖАЛЕНИЙ?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633976
    m_Localized: 'Anxiety: А ВПРОЧЕМ, ПЛЕВАТЬ. ДЕЛАЙ, ЧТО ДОЛЖЕН, ЧЕЛОВЕК.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633977
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633978
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633979
    m_Localized: 'Anxiety: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633980
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633981
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633982
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633983
    m_Localized: Подмышки
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633984
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633985
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633986
    m_Localized: 'Anxiety: Хах, это что же, по зубам ты будешь принимать решения? Ох-ооох.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633987
    m_Localized: 'Anxiety: Я ведь недавно исправляла зубы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633988
    m_Localized: 'Anxiety: Хотя, если честно…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633989
    m_Localized: 'Anxiety: Я не могу вспомнить, когда я была у стоматолога. Была ли я вообще у него?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633990
    m_Localized: 'Anxiety: Господи, от страха не могу вспомнить даже, что вчера ела.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633991
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633992
    m_Localized: 'Anxiety: Это что же… Я подхожу под описание?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633993
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633994
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633995
    m_Localized: 'Anxiety: Получается, я гость? Как? КААААК? Не надо!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633996
    m_Localized: 'Anxiety: Ой-ой-ой, из дома выгнали, с работы уволили, теперь ещё и мозги вышибут...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633997
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633998
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922825633999
    m_Localized: 'Anxiety: Показать ногти? Интересный признак, конечно…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634000
    m_Localized: 'Anxiety: Да, давай посмотрим.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634001
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634002
    m_Localized: 'Anxiety: Что на них? Это же не земля.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634003
    m_Localized: 'Anxiety: Я-я-я даже не помню, чтобы ковырялась в земле.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634004
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634005
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634006
    m_Localized: 'Anxiety: Как у меня появилась эта грязь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634007
    m_Localized: 'Anxiety: Я же не могла не мыться уже несколько дней. Да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634008
    m_Localized: 'Anxiety: Как… странно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634009
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634010
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634011
    m_Localized: 'Anxiety: Представляете, я не могу вспомнить откуда эта грязь. Я же только дома у вас сижу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634012
    m_Localized: 'Anxiety: Меня... Меня обмазали? Кому это вообще надо?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634013
    m_Localized: 'Anxiety: Хочешь проверить глаза?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634014
    m_Localized: 'Anxiety: Я догадываюсь, какой будет результат.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634015
    m_Localized: 'Anxiety: Что будет, если подойду по этому признаку?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634016
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634017
    m_Localized: 'Anxiety: Ну ещё бы. Могло ли быть иначе.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634018
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634019
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634020
    m_Localized: 'Anxiety: Я правда гость? Как ты думаешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634021
    m_Localized: 'Anxiety: А почему я не знаю об этом? Может, так ими и становятся?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634022
    m_Localized: 'Anxiety: Может, достаточно подумать, что ты не такой как все и вот ты страшнейший для общества человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634023
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634024
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634025
    m_Localized: 'Anxiety: Страшно умирать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634026
    m_Localized: 'Anxiety: Подожди, можно мне повязку какую?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634027
    m_Localized: 'Anxiety: Или еще чуть постоять хотя бы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634028
    m_Localized: 'Anxiety: Если окажется, что я гость, я начну убивать людей?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634029
    m_Localized: 'Anxiety: Я стану опасной? Или всегда ей была?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634030
    m_Localized: 'Anxiety: Может, я и убиваю людей?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634031
    m_Localized: 'Anxiety: (Вы фотографируете собеседника)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634032
    m_Localized: 'Anxiety: (Когда фотография проявляется, вы видите размытое тело и четкий фон)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634033
    m_Localized: 'Anxiety: (Как будто в момент фотографии человек резко дернулся)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634034
    m_Localized: 'Anxiety: Хахаха, представляешь? Я ведь просто дернулась.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634035
    m_Localized: 'Anxiety: Что теперь будет?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634036
    m_Localized: 'Anxiety: Можно ли мне жить? Или лучше убить? А что ты сделаешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634037
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634038
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634039
    m_Localized: 'Anxiety: Почему?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634040
    m_Localized: 'Anxiety: Может, меня будет проще пристрелить уже?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634041
    m_Localized: 'Anxiety: Я хочу уйти, но слишком страшно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634042
    m_Localized: 'Anxiety: Может…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634043
    m_Localized: 'Anxiety: Не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634044
    m_Localized: 'Anxiety: А если ты выстрелишь, и я вообще стану чем-то еще более ужасным?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634045
    m_Localized: 'Anxiety: Может, мне убежать?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634046
    m_Localized: 'Anxiety: Но я не знаю, вдруг, я все же человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634047
    m_Localized: 'Anxiety: Что мне делать?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634048
    m_Localized: 'Esenin: К вам можно?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634049
    m_Localized: 'Esenin: Я укрывался в пабе, но…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634050
    m_Localized: 'Esenin: Меня просто выгнали.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634051
    m_Localized: 'Esenin: За что? Хм. Не каждый выдерживает мой темперамент.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634052
    m_Localized: 'Esenin: Но я не обижаю никого, не подумай. Просто…  тошно иногда. Сам понимаешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634053
    m_Localized: 'Esenin: Что думаешь? Впустишь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922825634054
    m_Localized: Ты же не гость?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828096
    m_Localized: С тобой не будет проблем?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828097
    m_Localized: 'Esenin: Думаешь, я из этих чудовищ?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828098
    m_Localized: 'Esenin: Нет. Не гость. Но спрашивать каждого в лицо об этом - ебаный бред.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828099
    m_Localized: 'Esenin: Впрочем, теперь по-другому не будет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828100
    m_Localized: Почему тебя выперли из прошлого убежища?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828101
    m_Localized: Почему ты думаешь, что тут будет по-другому?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828102
    m_Localized: 'Esenin: Что ты называешь проблемами, домовладелец?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828103
    m_Localized: 'Esenin: Убийства и драки противны моей душе. Но в обиду себя не дам.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828104
    m_Localized: 'Esenin: Выпить и поесть я люблю. Люблю поговорить в приподнятом настроении. Это проблема?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828105
    m_Localized: Почему тебя выперли из прошлого убежища?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828106
    m_Localized: Почему ты думаешь, что тут будет по-другому?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828107
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828108
    m_Localized: 'Esenin: Думал сначала тебе что-нибудь обидное сказать, но передумал.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828109
    m_Localized: 'Esenin: Я уже говорил: неудобно людям со мной там было. Сидели черт знает кто.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828110
    m_Localized: 'Esenin: Так подумать, может, и хорошо, что выперли.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828111
    m_Localized: 'Esenin: Эти живьем бы сожрали и не заметили бы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828112
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828113
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828114
    m_Localized: 'Esenin: А что мне, сдохнуть под солнцем теперь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828115
    m_Localized: 'Esenin: Не, домовладелец, мне такое не интересно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828116
    m_Localized: 'Esenin: Пока жив, еще поищу с кем поговорить и на какую тему. Ты не впустишь – повезет в другом месте.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828117
    m_Localized: 'Esenin: Если в этом новом мире остались везение и не ублюдки.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828118
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828119
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828120
    m_Localized: 'Esenin: Спасибо. Доверия к людям сейчас – не больше монеты.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828121
    m_Localized: 'Esenin: Поэтому ценю твоё доверие. Может…  Ладно, не могу обещать ничего.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828122
    m_Localized: 'Esenin: М. Я понимаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828123
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828124
    m_Localized: 'Esenin: Понимаю тебя, но злюсь. Ты просто такой же трус, как и все тут.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828125
    m_Localized: 'Esenin: Спи спокойно по ночам, домовладелец. И пошёл нахуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828126
    m_Localized: 'Esenin: Да? Ты что-то хотел?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828127
    m_Localized: Так за что тебя выгнали из паба?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828128
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828129
    m_Localized: 'Esenin: Потому что все посходили с ума от череды катастроф.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828130
    m_Localized: 'Esenin: Взрыв солнца, приход Гостей, экономический кризис, и прочее, и прочее.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828131
    m_Localized: 'Esenin: Они все ёбнулись. Кто на фоне стресса,  кто от алкоголя.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828132
    m_Localized: 'Esenin: Ну… и у меня фляга засвистела от злости.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828133
    m_Localized: 'Esenin: Я поднялся на стол, кричу им что-то вроде: “Заебали винить всё вокруг себя. Давайте людьми оставаться”.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828134
    m_Localized: 'Esenin: Слёзы в пене помехой не будут, хмель и солод с солёным вкуснее.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828135
    m_Localized: 'Esenin: Да кому это только надо?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828136
    m_Localized: 'Esenin: Да? Ты что-то хотел?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828137
    m_Localized: А здесь по-другому?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828138
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828139
    m_Localized: 'Esenin: Я не лезу уже ни к кому. Себе дороже.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828140
    m_Localized: 'Esenin: Но послушаешь телевизор или какие разговоры, и снова аж свербит всё внутри.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828141
    m_Localized: 'Esenin: А потом спрашиваю себя: а оно мне надо?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828142
    m_Localized: 'Esenin: Нет, всё, домовладелец, итак нервы ни к чёрту.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828143
    m_Localized: 'Esenin: И без всего этого тоскливо жилось, а тут ещё…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828144
    m_Localized: 'Esenin: Я так однажды достану до люстры и над всем миром крещёным повисну.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828145
    m_Localized: 'Esenin: Да? Ты что-то хотел?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828146
    m_Localized: У тебя всё хорошо?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828147
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828148
    m_Localized: 'Esenin: М? Почему ты спрашиваешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828149
    m_Localized: От тебя чем-то пахнет
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828150
    m_Localized: Хм, у тебя жар?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828151
    m_Localized: 'Esenin: Ну… выпил я пива у тебя немного.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828152
    m_Localized: 'Esenin: Тошно мне, домовладелец. Решил немного выпить, что же тут криминального?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828153
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828154
    m_Localized: 'Esenin: Это какой-то пиздец.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828155
    m_Localized: 'Esenin: Все говорят, что решают проблемы, а на деле не происходит вообще нихера.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828156
    m_Localized: 'Esenin: Знаешь, мне кажется, скоро мы все просто умрём.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828157
    m_Localized: 'Esenin: Не добьёт солнце – значит, это сделают Гости. Гостей одолеем – сами себя живьём похороним.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828158
    m_Localized: 'Esenin: Если, сука, проблем нет, обязательно надо создать их себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828159
    m_Localized: 'Esenin: Как будто мы ну никак не можем жить без обосранных штанов.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828160
    m_Localized: 'Esenin: Блять.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828161
    m_Localized: 'Esenin: Уйди, тошно мне.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828162
    m_Localized: 'Esenin: Да не у меня жар, а у всей ебучей планеты.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828163
    m_Localized: 'Esenin: Куда ни глянь, снова кто-то кого-то убил. Или ледники тают. Или леса горят. Лихорадка у этого мира.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828164
    m_Localized: 'Esenin: Пытается Земля нас стряхнуть, как зажравшихся блох.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828165
    m_Localized: 'Esenin: Однажды так нас тряхнёт, жди беды.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828166
    m_Localized: 'Esenin: Оооох.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828167
    m_Localized: 'Esenin: Съеби, пожалуйста. Нехорошо мне.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828168
    m_Localized: 'Esenin: Да? Ты что-то хотел?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828169
    m_Localized: Отпустило тебя?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828170
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828171
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828172
    m_Localized: 'Esenin: Домовладелец…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828173
    m_Localized: 'Esenin: Мы же точно будем мертвы когда-то, этого не избежать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828174
    m_Localized: 'Esenin: А вот ты думал в духе “что с нами будет, когда мы умрём”?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828175
    m_Localized: Во что верю, то и будет
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828176
    m_Localized: Ничего
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828177
    m_Localized: Не знаю, в космосе окажемся
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828178
    m_Localized: 'Esenin: В этом есть смысл.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828179
    m_Localized: 'Esenin: Но это нихуя меня не успокаивает. Знаешь почему?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828180
    m_Localized: 'Esenin: Вот я буду умирать. Мозг это же поймёт. Начнёт мне показывать что-нибудь, куда было бы приятно вернуться.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828181
    m_Localized: 'Esenin: А когда силы на этот сон закончатся, тогда что?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828182
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828183
    m_Localized: 'Esenin: Не, домовладелец. Спокойнее мне не стало.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828184
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828185
    m_Localized: 'Esenin: Мне так хотелось, чтобы ты сказал по-другому.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828186
    m_Localized: 'Esenin: Ты, конечно, может, и прав. Но это настолько жутко.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828187
    m_Localized: 'Esenin: Вообще ничего не будет… Просто… темнота?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828188
    m_Localized: 'Esenin: Мне что-то сейчас не хочется разговаривать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828189
    m_Localized: 'Esenin: А так если подумать…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828190
    m_Localized: 'Esenin: В космосе-то кроме нас ничего нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828191
    m_Localized: 'Esenin: Нет никакой другой жизни. Пустой холодный космос.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828192
    m_Localized: 'Esenin: Наверно, если бы было что-то, мы бы уже вышли на какой-то сигнал или ещё что-то. Не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828193
    m_Localized: 'Esenin: Пустое пространство бесконечного мрака. Если после смерти мы попадаем туда, это всё равно что исчезнуть…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828194
    m_Localized: 'Esenin: Я… я хочу побыть один.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828195
    m_Localized: 'Esenin: Да? Ты что-то хотел?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828196
    m_Localized: Ты… в порядке?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828197
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828198
    m_Localized: 'Esenin: В пабе хотя бы было высоко.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828199
    m_Localized: 'Esenin: Там можно было бы удавиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828200
    m_Localized: 'Esenin: У тебя мне тесно. Мне вообще на этой планете тесно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828201
    m_Localized: 'Esenin: Домовладелец, я просто хочу, чтобы всё это закончилось.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828202
    m_Localized: 'Esenin: Это какой-то пиздец. Меня всё пугает до усрачки.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828203
    m_Localized: 'Esenin: Я просто не выдерживаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828204
    m_Localized: 'Esenin: Зачем я сюда пришёл?..'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828205
    m_Localized: 'Esenin: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828206
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828207
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828208
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828209
    m_Localized: Подмышки
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828210
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828211
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828212
    m_Localized: 'Esenin: Тебе показать мои зубы?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828213
    m_Localized: 'Esenin: Ну посмотри. На них еще остался привкус несчастья и дыма.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828214
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828215
    m_Localized: 'Esenin: Желтоватые, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828216
    m_Localized: 'Esenin: Ну вот и не доебывайся до меня со своими тестами.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828217
    m_Localized: 'Esenin: Я не гость.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828218
    m_Localized: 'Esenin: Откуда они вообще полезли?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828219
    m_Localized: 'Esenin: Ногти, испачканные в земле? Это признак?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828220
    m_Localized: 'Esenin: Они же могут руки помыть! И все!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828221
    m_Localized: 'Esenin: А какой-нибудь садовник сразу же становится гостем, получается?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828222
    m_Localized: 'Esenin: Ебаный бред.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828223
    m_Localized: 'Esenin: Смотри ногти.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828224
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828225
    m_Localized: 'Esenin: Ну что, я – гость?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828226
    m_Localized: 'Esenin: Ну еще бы нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828227
    m_Localized: 'Esenin: С каждым днем все бредовее.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828228
    m_Localized: 'Esenin: А если я не выспался? Или плакал?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828229
    m_Localized: 'Esenin: Я перестаю понимать, как это вообще работает.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828230
    m_Localized: 'Esenin: А что ты будешь делать, если один признак подтвердится? Или несколько?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828231
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828232
    m_Localized: 'Esenin: Теперь пойду стану гостем этой ночью.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828233
    m_Localized: 'Esenin: Поплачу, вспомню спокойные времена.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828234
    m_Localized: 'Esenin: Все эти проверки по признакам, парни в желтых комбезах…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828235
    m_Localized: 'Esenin: Все это… как-то.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828236
    m_Localized: 'Esenin: Какой-то пиздец.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828237
    m_Localized: 'Esenin: Нет у тебя ощущения, что все идет к какому-то страшному аду?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828238
    m_Localized: 'Esenin: Все якобы под контролем, но вокруг полный хаос.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828239
    m_Localized: 'Esenin: Ну, фоткай, давай.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828240
    m_Localized: 'Esenin: (Вы фотографируете собеседника)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828241
    m_Localized: 'Esenin: (Он сидит спокойно, целиком в кадр не помещается, но ничего необычного вы не видите)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828242
    m_Localized: 'Esenin: Мне просто жутко, что будет происходить дальше.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828243
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828244
    m_Localized: 'Widow: Я могу у тебя отдохнуть?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828245
    m_Localized: Откуда ты пришла?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828246
    m_Localized: А дальше куда пойдешь?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828247
    m_Localized: 'Widow: Я уже не помню. Все равно откуда.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828248
    m_Localized: 'Widow: Я очень устала. Если не отдохну – просто упаду под окнами.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828249
    m_Localized: Твоему напарнику плохо?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828250
    m_Localized: Твоему другу нужна помощь?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828251
    m_Localized: 'Widow: Я… я просто хочу упасть где-нибудь и больше не вставать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828252
    m_Localized: 'Widow: Все равно, где я окажусь уже.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828253
    m_Localized: Твоему напарнику плохо?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828254
    m_Localized: Твоему другу нужна помощь?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828255
    m_Localized: 'Widow: Это мой муж.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828256
    m_Localized: 'Widow: Он умер.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828257
    m_Localized: 'Widow: Я не могу его нормально похоронить теперь. Отпускать его теперь бессмысленно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828258
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828259
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828260
    m_Localized: 'Widow: Уже нет. Когда надо было – никто не помог.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828261
    m_Localized: 'Widow: Теперь он умер.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828262
    m_Localized: 'Widow: Он мог быть жив, если бы…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828263
    m_Localized: 'Widow: Всем было не насрать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828264
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828265
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828266
    m_Localized: 'Widow: Не думаю, что останусь надолго.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828267
    m_Localized: 'Widow: Мне бы только передохнуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828268
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828269
    m_Localized: 'Widow: Ты…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828270
    m_Localized: 'Widow: Отдохнуть бы немного…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828271
    m_Localized: Тебе что-нибудь нужно?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828272
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828273
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828274
    m_Localized: 'Widow: Чтобы он был жив.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828275
    m_Localized: 'Widow: Мне вообще…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828276
    m_Localized: 'Widow: Ничего не надо больше.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828277
    m_Localized: Принести тебе воды?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828278
    m_Localized: Может, дать тебе еды?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828279
    m_Localized: 'Widow: Я тут…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828280
    m_Localized: 'Widow: У крана сижу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828281
    m_Localized: 'Widow: Попью, если надо будет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828282
    m_Localized: Пока оставлю тебя здесь
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828283
    m_Localized: С тобой посидеть?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828284
    m_Localized: 'Widow: Не голодна.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828285
    m_Localized: 'Widow: Я тут…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828286
    m_Localized: 'Widow: Хочу посидеть.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828287
    m_Localized: Пока оставлю тебя здесь
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828288
    m_Localized: С тобой посидеть?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828289
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828290
    m_Localized: 'Widow: Почему ты умер?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828291
    m_Localized: 'Widow: Ведь обещал, что всё будет хорошо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828292
    m_Localized: 'Widow: Сказал, что всё будет хорошо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828293
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828294
    m_Localized: 'Widow: И умер.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828295
    m_Localized: 'Widow: Правильно, я теперь одна выживай.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828296
    m_Localized: 'Widow: Зачем ты так?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828297
    m_Localized: 'Widow: Я с ним хочу побыть.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828298
    m_Localized: 'Widow: Ты мне не вернёшь никого.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828299
    m_Localized: 'Widow: Я даже…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828300
    m_Localized: 'Widow: Похоронить…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828301
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828302
    m_Localized: 'Widow: Не могу тебя.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828303
    m_Localized: 'Widow: Что мне делать?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828304
    m_Localized: 'Widow: Отдохнуть бы немного…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828305
    m_Localized: Как он умер?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828306
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828307
    m_Localized: 'Widow: Я пока не могу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828308
    m_Localized: 'Widow: Это слишком.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828309
    m_Localized: 'Widow: У меня только недавно закончились все слёзы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828310
    m_Localized: 'Widow: Будто нечем плакать уже.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828311
    m_Localized: 'Widow: Но разве это правильно?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828312
    m_Localized: 'Widow: Просто перестать плакать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828313
    m_Localized: Его надо похоронить
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828314
    m_Localized: От него осталось только тело. Надо это признать
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828315
    m_Localized: 'Widow: Не-е-е-ет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828316
    m_Localized: 'Widow: Нет-нет-нет-нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828317
    m_Localized: 'Widow: Я не готова.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828318
    m_Localized: 'Widow: Только недавно его мне вернули.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828319
    m_Localized: 'Widow: И снова расстаться с ним.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828320
    m_Localized: 'Widow: Я так не могу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828321
    m_Localized: 'Widow: Не отдам его бездушной земле.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828322
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828323
    m_Localized: 'Widow: Нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828324
    m_Localized: 'Widow: Нет, это не так.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828325
    m_Localized: 'Widow: Он ещё слышит меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828326
    m_Localized: 'Widow: Я так хочу…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828327
    m_Localized: 'Widow: Так хочу верить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828328
    m_Localized: 'Widow: Отдохнуть бы немного…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828329
    m_Localized: Расскажи, что ты помнишь про него?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828330
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828331
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828332
    m_Localized: 'Widow: Как-то пошли к нашим друзьям.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828333
    m_Localized: 'Widow: Тогда мы были значительно моложе.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828334
    m_Localized: 'Widow: И вот сидим, выпиваем. Он обычно довольно угрюмый и не часто говорил на таких посиделках.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828335
    m_Localized: 'Widow: На тот момент мы выпили уже значительно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828336
    m_Localized: 'Widow: Он молчит-молчит,  а потом как вдруг говорит:'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828337
    m_Localized: 'Widow: “Дайте гитару, щас споëм”.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828338
    m_Localized: 'Widow: И сыграл так здорово, мне так понравилось.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828339
    m_Localized: 'Widow: Друзья ему начали заказывать разные песни, он сидит-сидит, а потом…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828340
    m_Localized: 'Widow: Потом встаëт, говорит, что надо идти, задевает стакан, пытается его поймать, роняет гитару…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828341
    m_Localized: 'Widow: Потом я узнала, что он специально одну песню выучил, чтобы меня впечатлить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828342
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828343
    m_Localized: 'Widow: У меня и фотография с того вечера осталась.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828344
    m_Localized: 'Widow: Немножко порвалась…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828345
    m_Localized: 'Widow: Теперь не сыграешь мне больше. Спел ты мне свою последнюю песню.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828346
    m_Localized: 'Widow: Отдохнуть бы немного…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828347
    m_Localized: Так что с ним случилось?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828348
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828349
    m_Localized: 'Widow: Блять, он умер.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828350
    m_Localized: Я понимаю. Извини, если задел тебя
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828351
    m_Localized: Не я виноват в его смерти
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828352
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828353
    m_Localized: 'Widow: Извините, я не могу просто…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828354
    m_Localized: 'Widow: Каждую ночь я не могу остановить слёзы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828355
    m_Localized: 'Widow: Но больше всего я хочу, чтобы сгорели под солнцем те, по чьей вине…  всë это случилось.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828356
    m_Localized: Так что случилось?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828357
    m_Localized: Я могу не спрашивать об этом больше
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828358
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828359
    m_Localized: 'Widow: Да. Да, я понимаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828360
    m_Localized: 'Widow: Это было грубо. Но я не могу говорить спокойно про него.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828361
    m_Localized: 'Widow: Надеюсь, те ублюдки получат по заслугам.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828362
    m_Localized: 'Widow: И их убьёт кто-нибудь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828363
    m_Localized: Так что случилось?
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828364
    m_Localized: Я могу не спрашивать об этом больше
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828365
    m_Localized: 'Widow: Муж чувствовал себя плохо. Обратились в больницу, но его направили провериться к ублюдкам.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828366
    m_Localized: 'Widow: Мы пришли в центр, который открыли КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828367
    m_Localized: 'Widow: КЧС его просто закрыли на карантин. Никакой связи мне не дали. Сказали, что выпустят через три недели.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828368
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922829828369
    m_Localized: 'Widow: Я пришла раньше, просто проведать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022400
    m_Localized: 'Widow: Они мне просто сухо сказали…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022401
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022402
    m_Localized: 'Widow: Сейчас, извините.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022403
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022404
    m_Localized: 'Widow: Они сказали: “Он умер”.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022405
    m_Localized: 'Widow: Всë.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022406
    m_Localized: 'Widow: Тело осмотреть нельзя.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022407
    m_Localized: 'Widow: Забрать его домой нельзя.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022408
    m_Localized: 'Widow: У таких долбоëбов вечно бардак, поэтому мне достаточно было нацепить халат врачей и пройти в морг.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022409
    m_Localized: 'Widow: А он…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022410
    m_Localized: 'Widow: Действительно там…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022411
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022412
    m_Localized: 'Widow: Вы убили – вам останется его душа. А мне останется кричать, что мне никого не жаль.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022413
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022414
    m_Localized: 'Widow: Я хочу побыть одна.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022415
    m_Localized: 'Widow: Да. Пожалуйста.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022416
    m_Localized: 'Widow: Очень тяжело теперь жить без него…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022417
    m_Localized: 'Widow: Отдохнуть бы немного…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022418
    m_Localized: Что-то не так?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022419
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022420
    m_Localized: 'Widow: Ухожу сегодня ночью.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022421
    m_Localized: 'Widow: Я сразу говорила, что не собираюсь оставаться надолго.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022422
    m_Localized: 'Widow: Только нужен был отдых.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022423
    m_Localized: Что теперь?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022424
    m_Localized: Ты к родственникам?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022425
    m_Localized: 'Widow: Не хочу об этом думать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022426
    m_Localized: 'Widow: Вернусь домой.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022427
    m_Localized: 'Widow: Достану гитару.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022428
    m_Localized: 'Widow: А там…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022429
    m_Localized: Ты можешь остаться
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022430
    m_Localized: Удачи
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022431
    m_Localized: 'Widow: Никого не осталось.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022432
    m_Localized: 'Widow: Мы вернëмся домой.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022433
    m_Localized: 'Widow: Я больше ничего не хочу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022434
    m_Localized: Ты можешь остаться
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022435
    m_Localized: Удачи
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022436
    m_Localized: 'Widow: Зачем?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022437
    m_Localized: 'Widow: Мне легче не станет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022438
    m_Localized: 'Widow: К тебе я равнодушна, прости.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022439
    m_Localized: 'Widow: Мне очень хочется домой.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022440
    m_Localized: 'Widow: Пока не вернусь, ничего решать не хочу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022441
    m_Localized: 'Widow: Спасибо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022442
    m_Localized: 'Widow: Вы мало говорите, но…  оказались хорошим собеседником.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022443
    m_Localized: 'Widow: Надеюсь, вы найдëте то, что ищете.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022444
    m_Localized: 'Widow: Только давай поскорее.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022445
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022446
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022447
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022448
    m_Localized: Подмышки
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022449
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022450
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022451
    m_Localized: 'Widow: Что?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022452
    m_Localized: 'Widow: ... ладно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022453
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022454
    m_Localized: 'Widow: Все?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022455
    m_Localized: 'Widow: Я могу побыть побыть спокойно одна?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022456
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022457
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022458
    m_Localized: 'Widow: Руки... сейчас, подожди.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022459
    m_Localized: 'Widow: Руки устали нести того, кого спасти отказались.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022460
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022461
    m_Localized: 'Widow: А вообще можно меня не просить этой хуйней заниматься?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022462
    m_Localized: 'Widow: Если захочешь пристрелить - просто стреляй.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022463
    m_Localized: 'Widow: У меня нет сил больше...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022464
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022465
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022466
    m_Localized: 'Widow: Что ты хочешь проверить? Красноту?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022467
    m_Localized: 'Widow: Попробуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022468
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022469
    m_Localized: 'Widow: Если я показываю эмоции, значит, я гость?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022470
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022471
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022472
    m_Localized: 'Widow: Можем ли мы быть откровенны теперь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022473
    m_Localized: 'Widow: Радоваться не получается, плакать нельзя.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022474
    m_Localized: 'Widow: Говорить не всегда получается.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022475
    m_Localized: 'Widow: Остается только сидеть и закрывать лицо руками.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022476
    m_Localized: 'Widow: Вот так легко все закончится?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022477
    m_Localized: 'Widow: Больше никаких страданий?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022478
    m_Localized: 'Widow: Но я так и не сохранила тебя, мой...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022479
    m_Localized: 'Widow: Тебе это не кажется издевательством?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022480
    m_Localized: 'Widow: Никто не помог спасти мне мужа, но теперь...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022481
    m_Localized: 'Widow: ВЫ ХОТИТЕ ЗАПЕЧАТЛЕТЬ ЕГО СМЕРТЬ?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022482
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022483
    m_Localized: 'Widow: У меня нет слов.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022484
    m_Localized: 'Widow: Делай что хочешь и не трогай меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022485
    m_Localized: 'Widow: (Вы делаете фотографию девушки)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022486
    m_Localized: 'Widow: (Ничего необычного вы не видите)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022487
    m_Localized: 'Widow: (Покойник оказался в кадре, это заставляет вас задуматься)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022488
    m_Localized: 'Widow: Теперь просто уйди.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022489
    m_Localized: 'Scammer: О, здарова.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022490
    m_Localized: 'Scammer: Видал чё происходит? Ваще ахуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022491
    m_Localized: 'Scammer: Как там у тебя по делишкам?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022492
    m_Localized: Что тебе нужно?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022493
    m_Localized: И что же происходит?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022494
    m_Localized: 'Scammer: Да так, просто интересуюсь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022495
    m_Localized: 'Scammer: А вообще у меня есть темка, можешь легко денег поднять.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022496
    m_Localized: 'Scammer: В таком кайфе от солнца ваще не напрягаясь можно деньги делать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022497
    m_Localized: 'Scammer: А всякие чмошники боятся чего-то, а надо просто шевелиться!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022498
    m_Localized: А ко мне зачем пришёл?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022499
    m_Localized: Что ты предлагаешь?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022500
    m_Localized: 'Scammer: Новые возможности, не видишь чтоль нихуя?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022501
    m_Localized: 'Scammer: Чё-то ноют все, бегают, суетятся, а можно просто делать от души дела, да и всё.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022502
    m_Localized: 'Scammer: Радоваться надо, короче.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022503
    m_Localized: А ко мне зачем пришел?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022504
    m_Localized: Что ты предлагаешь?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022505
    m_Localized: 'Scammer: Да ты вот уже делом занялся!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022506
    m_Localized: 'Scammer: Народ собираешь, чё-то мутишь тут. Движуху наводишь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022507
    m_Localized: 'Scammer: Мы тут с тобой праздник жизни устроим!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022508
    m_Localized: Проходи
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022509
    m_Localized: Тебе лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022510
    m_Localized: 'Scammer: Выживать, что ещё-то?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022511
    m_Localized: 'Scammer: Надо мутить схемы, пока возможности есть, на солнце-то похуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022512
    m_Localized: 'Scammer: Двигаться, двигаться, понимаешь? Ну чё, погнали?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022513
    m_Localized: Проходи
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022514
    m_Localized: Тебе лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022515
    m_Localized: 'Scammer: О-о-о-о, вот это тема.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022516
    m_Localized: 'Scammer: Ну всё, наконец-то умный человек попался.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022517
    m_Localized: 'Scammer: Дурачок ты, конечно. Но ладно, похер на тебя.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022518
    m_Localized: 'Scammer: Вон, к твоим соседям пойду тогда.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022519
    m_Localized: 'Scammer: Всё, бывай.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022520
    m_Localized: 'Scammer: Хе-хе. Ну чё, ёпта?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022521
    m_Localized: Кем ты работал до катаклизма?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022522
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022523
    m_Localized: 'Scammer: Ооо, рад что ты спросил.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022524
    m_Localized: 'Scammer: Ты что-нибудь слышал о…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022525
    m_Localized: 'Scammer: Ставках на спорт?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022526
    m_Localized: Ты что, лудоман?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022527
    m_Localized: Ну слышал
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022528
    m_Localized: 'Scammer: Эээ, ну ты чё, ёпта. Я спортивный аналитик вообще-то, сука.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022529
    m_Localized: 'Scammer: Знал бы ты, какие суммы попадали ко мне в руки, у тебя бы слюни потекли.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022530
    m_Localized: 'Scammer: Я это, профессионал своего дела, сука.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022531
    m_Localized: 'Scammer: Ко мне люди бабки свои приносили и получали в пять… нет, в десять раз больше.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022532
    m_Localized: И как, сколько ты заработал?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022533
    m_Localized: Ты считаешь это работой?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022534
    m_Localized: 'Scammer: Вот этим я и зарабатывал.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022535
    m_Localized: 'Scammer: Мутить темки со ставками вообще было как нехер делать, ёпта. Отвечаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022536
    m_Localized: 'Scammer: Там есть схемки как облапошить букмекеров.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022537
    m_Localized: 'Scammer: Ставишь на особую команду и ждёшь, пока баблишко вернётся.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022538
    m_Localized: 'Scammer: А если денег нет, то это вообще не проблема. Занял у кого-нибудь, да и всё.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022539
    m_Localized: И как, сколько ты заработал?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022540
    m_Localized: Ты считаешь это работой?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022541
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022542
    m_Localized: 'Scammer: Ну, как бы сказать…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022543
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022544
    m_Localized: 'Scammer: Я заработал тридцать, сука, лямов…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022545
    m_Localized: 'Scammer: Долгов, правда. Но ничё, долги меня не ебут.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022546
    m_Localized: 'Scammer: Да и тем более, сейчас мне на них кристально похуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022547
    m_Localized: 'Scammer: Считай, опасности в глаза смотрю, сука.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022548
    m_Localized: 'Scammer: Бля, да ты прикалываешься что-ли, ёпта?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022549
    m_Localized: 'Scammer: Естественно это работа.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022550
    m_Localized: 'Scammer: У меня даже рабочее место было. Такое роскошное…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022551
    m_Localized: 'Scammer: Ахуенный диван и блокнот, где выписаны букмекерские конторы, суммы долгов и чистая прибыль.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022552
    m_Localized: 'Scammer: Хе-хе. Ну чё, ёпта?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022553
    m_Localized: За тобой ещё не приходили коллекторы?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022554
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022555
    m_Localized: 'Scammer: Коллекторы? Какие коллекторы?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022556
    m_Localized: 'Scammer: Пффф. Забудь про них. Считай, у меня больше нет долгов. Солнце чисто зарешало.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022557
    m_Localized: 'Scammer: Сейчас банкам не до этого. Их, может, теперь и не будет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022558
    m_Localized: 'Scammer: А это значит, я свободен, сука. И могу мутить новые темки.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022559
    m_Localized: 'Scammer: Ставки, считай, теперь прошлый век. Надо чёто новое придумать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022560
    m_Localized: Повезло тебе с солнцем
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022561
    m_Localized: И что, хочешь снова “мутить темки”?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022562
    m_Localized: 'Scammer: Эээ, ты чё, ёпта.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022563
    m_Localized: 'Scammer: Я бы вообще как раз плюнуть отыгрался бы потом и расплатился с долгами.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022564
    m_Localized: 'Scammer: Зато теперь всё с чистого листа.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022565
    m_Localized: 'Scammer: У меня, кстати, это, темка есть новая. Хочешь узнать?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022566
    m_Localized: И что за схема?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022567
    m_Localized: Не особо
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022568
    m_Localized: 'Scammer: Да я тут темку недавно придумал, как заработать. Могу поделиться, если хочешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022569
    m_Localized: И что за схема?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022570
    m_Localized: Не особо
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022571
    m_Localized: 'Scammer: Короче, КЧС явно тут главные.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022572
    m_Localized: 'Scammer: Думаю, надо нам, ну, как бы это сказать… На хорошем счету быть, короче.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022573
    m_Localized: 'Scammer: Во-о-от… И думаю, если регулярно сдавать им людей, глядишь, и в бункер возьмут какой-нибудь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022574
    m_Localized: 'Scammer: Смекаешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022575
    m_Localized: Ты хочешь сдавать людей КЧС?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022576
    m_Localized: Думаешь, КЧС спасут тебя?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022577
    m_Localized: 'Scammer: Ну да, а хули.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022578
    m_Localized: 'Scammer: Я думаю, так получится выжить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022579
    m_Localized: 'Scammer: Какие времена, такие и схемы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022580
    m_Localized: 'Scammer: Быть со стадом в карантинных зонах вообще так себе идея.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022581
    m_Localized: 'Scammer: Поэтому надо быть на хорошем счету у КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022582
    m_Localized: 'Scammer: Не грубить им, сдавать людей…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022583
    m_Localized: 'Scammer: Ну, может, ещё по горячей линии по признакам общаться. Чтобы они точно знали, что я не этот… как их… Гость.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022584
    m_Localized: 'Scammer: Они славные ребята. Наверняка знают, что надо делать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022585
    m_Localized: Возможно, ты прав
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022586
    m_Localized: Звучит как хуйня
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022587
    m_Localized: Раз ты так к ним хочешь, то пиздуй отсюда
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022588
    m_Localized: 'Scammer: Бля, ты совсем не чуешь ветер перемен.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022589
    m_Localized: 'Scammer: Надо видеть тех, кто управляет ситуацией и держаться с ними. Это выигрышная стратегия. Отвечаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022590
    m_Localized: 'Scammer: Поэтому надо быть на хорошем счету у КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022591
    m_Localized: 'Scammer: Не грубить им, сдавать людей…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022592
    m_Localized: 'Scammer: Ну, может, ещё по горячей линии по признакам общаться. Чтобы они точно знали, что я не этот ваш Гость.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022593
    m_Localized: 'Scammer: Они славные ребята. Наверняка знают, что надо делать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022594
    m_Localized: Возможно, ты прав
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022595
    m_Localized: Звучит как хуйня
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022596
    m_Localized: Раз ты так к ним хочешь, то пиздуй отсюда
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022597
    m_Localized: 'Scammer: Естественно, я прав.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022598
    m_Localized: 'Scammer: У меня чуйка на выигрышные темки, ёпта.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022599
    m_Localized: 'Scammer: Верь мне, со мной не пропадёшь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022600
    m_Localized: 'Scammer: Эээ, ты чё, сука. Сам ты хуйня, бля!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022601
    m_Localized: 'Scammer: Мне люди бабки давали за советы по инвестициям. Я тебе бесплатно, даром рассказываю темку, а ты…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022602
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022603
    m_Localized: 'Scammer: Пиздец, иди на хуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022604
    m_Localized: 'Scammer: Ты чё, выгоняешь меня что-ли, сука…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022605
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022606
    m_Localized: 'Scammer: Ёпта, я думал, ты нормальный.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022607
    m_Localized: 'Scammer: Я тебе даже темку предложил. А ты…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022608
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022609
    m_Localized: 'Scammer: Короче, иди на хуй, а я домой.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022610
    m_Localized: 'Scammer: Да блин, я прям реально крутую тему придумал. Ну ладно…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022611
    m_Localized: 'Scammer: Если передумаешь, приходи.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022612
    m_Localized: 'Scammer: Хе-хе. Ну чё, ёпта?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022613
    m_Localized: Чего тебе?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022614
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022615
    m_Localized: 'Scammer: Послушай, я тут придумал новую тему. Она рабочая, я тебе говорю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022616
    m_Localized: 'Scammer: Короче, слушай…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022617
    m_Localized: 'Scammer: Вот солнце же жарит как баня, верно?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022618
    m_Localized: 'Scammer: Я думаю, что озоновые слои могут того… Наебнуться, короче.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022619
    m_Localized: 'Scammer: А я помню, что кислород-то из солнечных лучей, проходящих через озон появляется.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022620
    m_Localized: 'Scammer: Так вот, и знаешь что я придумал?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022621
    m_Localized: 'Scammer: ПРОДАВАТЬ ВОЗДУХ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022622
    m_Localized: 'Scammer: Вот ЭТО реальная тема, за базар отвечаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022623
    m_Localized: Великолепный план, просто охуенный
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022624
    m_Localized: Ничего тупее не слышал
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022625
    m_Localized: 'Scammer: Правда? Ты так думаешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022626
    m_Localized: Конечно же, да. Как ты ещё учёным не стал
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022627
    m_Localized: Нет
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022628
    m_Localized: 'Scammer: Ого, ну…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022629
    m_Localized: 'Scammer: Спасибо. Приятно, что хоть кто-то признал, что я умён.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022630
    m_Localized: 'Scammer: Глядишь, премию Дарвина возьму.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022631
    m_Localized: Ты хоть в курсе, за что вручают премию Дарвина?
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022632
    m_Localized: Ну, ты-то её точно возьмёшь
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022633
    m_Localized: 'Scammer: Ну… За заслуги в науке или типо того.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022634
    m_Localized: 'Scammer: А почему ты уточнил, кстати?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022635
    m_Localized: Да просто так
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022636
    m_Localized: Премию Дарвина дают за глупую смерть
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022637
    m_Localized: 'Scammer: Хахах, я уже чувствую научное признание.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022638
    m_Localized: 'Scammer: Куча денег, статус, девки… Мечта…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022639
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022640
    m_Localized: 'Scammer: Ладно, когда всё закончится, запатентую технологию по продаже воздуха.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022641
    m_Localized: 'Scammer: А, ну ладно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022642
    m_Localized: 'Scammer: Ааа…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022643
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022644
    m_Localized: 'Scammer: Стоп, погоди, ты что, выходит, смеёшься надо мной?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022645
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922834022646
    m_Localized: 'Scammer: Да иди ты. Я реальные схемы придумываю, а ты высмеиваешь меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216704
    m_Localized: 'Scammer: Да иди ты. Я реальные темы придумываю, а ты высмеиваешь меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216705
    m_Localized: 'Scammer: Вот получу премию Дарвина, сразу стану важной шишкой…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216706
    m_Localized: 'Scammer: Потом будешь мне в ноги падать и прощения просить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216707
    m_Localized: 'Scammer: — Отстань от меня со своими ебучими идеями'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216708
    m_Localized: 'Scammer: Да бля…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216709
    m_Localized: 'Scammer: Ну чё ты, сложно тебе послушать что-ли?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216710
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216711
    m_Localized: 'Scammer: А и ладно, хуй с тобой! Мне же больше прибыли достанется.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216712
    m_Localized: 'Scammer: Да бля…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216713
    m_Localized: 'Scammer: Да иди ты. Я реальные темы придумываю, а ты высмеиваешь меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216714
    m_Localized: 'Scammer: Вот получу премию Дарвина, сразу стану важной шишкой…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216715
    m_Localized: 'Scammer: Потом будешь мне в ноги падать и прощения просить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216716
    m_Localized: 'Scammer: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216717
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216718
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216719
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216720
    m_Localized: Подмышки
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216721
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216722
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216723
    m_Localized: 'Scammer: Хоба, зубы это я могу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216724
    m_Localized: 'Scammer: У меня братюльник делал зубы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216725
    m_Localized: 'Scammer: Ему выбили, прикинь, все зубы нахуй ХАХАХАХАХАХА.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216726
    m_Localized: 'Scammer: А, показать надо. Ща.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216727
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216728
    m_Localized: 'Scammer: Норм, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216729
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216730
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216731
    m_Localized: 'Scammer: Да ты чё? Норм же история была.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216732
    m_Localized: 'Scammer: А из-за зубов ебашить мне в лицо как-то... не по понятиям.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216733
    m_Localized: 'Scammer: Пожалуйста?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216734
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216735
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216736
    m_Localized: 'Scammer: Ты угараешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216737
    m_Localized: 'Scammer: Да и соси ты х...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216738
    m_Localized: 'Scammer: Да ты чё, я нормальный.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216739
    m_Localized: 'Scammer: Ничего такого с ногтями не делаю, во, глянь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216740
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216741
    m_Localized: 'Scammer: Не, ты не подумай.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216742
    m_Localized: 'Scammer: Я моюсь, просто монетку увидел на дороге, поднял.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216743
    m_Localized: 'Scammer: Так-то чисто. Сегодня помою руки, чё ты.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216744
    m_Localized: 'Scammer: Я моюсь, просто как-то времени не было сегодня руки сполоснуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216745
    m_Localized: 'Scammer: Вообще, чисто, вроде.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216746
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216747
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216748
    m_Localized: 'Scammer: Ты же не убьешь человека просто за грязные ногти?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216749
    m_Localized: 'Scammer: Да ладно. Не думал, что так тупо умру.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216750
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216751
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216752
    m_Localized: 'Scammer: Мне кажется, по рукам странно определять монстров этих.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216753
    m_Localized: 'Scammer: По рукам надо определять долбоёбов и терпил. Гости-то тут при чём?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216754
    m_Localized: 'Scammer: Это ж надо вставать в девять утра и работать по 4 часа хотя бы. Пиздец.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216755
    m_Localized: 'Scammer: У меня глаза в последнее время чешутся.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216756
    m_Localized: 'Scammer: Как думаешь, это от солнца? Или чё?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216757
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216758
    m_Localized: 'Scammer: Да блять.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216759
    m_Localized: 'Scammer: Это болячка какая-нибудь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216760
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216761
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216762
    m_Localized: 'Scammer: Слушай, а придумал схемку.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216763
    m_Localized: 'Scammer: Давай с других деньги брать, чтобы не стрелять им в лицо?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216764
    m_Localized: 'Scammer: Чего? Надо подумать?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216765
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216766
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216767
    m_Localized: 'Scammer: Ладно, если тебе темка не зашла - понимаю. Но у меня реально болячка на глазу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216768
    m_Localized: 'Scammer: Если бы у тебя капли были бы...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216769
    m_Localized: 'Scammer: А я бы не купил всё равно. Ну, по-своим причинам.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216770
    m_Localized: 'Scammer: Сфоткаться со мной хочешь? Ну погнали.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216771
    m_Localized: 'Scammer: У меня светочувствительность только высокая. Могу дернуться.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216772
    m_Localized: 'Scammer: (Вы фотографируете собеседника)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216773
    m_Localized: 'Scammer: (Вроде, фотография нормальная, но лицо...)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216774
    m_Localized: 'Scammer: (Оно получилось очень размазанным)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216775
    m_Localized: 'Scammer: Вот об этом я и говорил.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216776
    m_Localized: 'Scammer: Перефоткаешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216777
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216778
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216779
    m_Localized: 'Scammer: Ты меня не разводи, ты этих лохов прогревай.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216780
    m_Localized: 'Scammer: Пусть в тонусе держатся.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216781
    m_Localized: 'Scammer: А то расслабятся, забудут, благодаря кому они тут и не будут платить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216782
    m_Localized: 'Scammer: Подожди!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216783
    m_Localized: 'Scammer: Нахуй тебя и твой дом, я пошел.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216784
    m_Localized: 'Scammer: Прямо под солнцем. Оставляю это на твоей совести.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216785
    m_Localized: 'Neighbour: Привет, сосед. Давно не виделись. Как жизнь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216786
    m_Localized: Всё по-старому
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216787
    m_Localized: Нормально
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216788
    m_Localized: 'Neighbour: Слушай, я почему зашёл-то. Немного беспокоюсь за тебя.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216789
    m_Localized: 'Neighbour: Намечается что-то нехорошее.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216790
    m_Localized: 'Neighbour: Мне звонила двоюродная сестра. По их новостям говорят, что с солнцем происходит что-то странное.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216791
    m_Localized: 'Neighbour: И про людей, лезущих из земли. Их почему-то называют Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216792
    m_Localized: 'Neighbour: Жуть какая-то. Надеюсь, всё это неправда.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216793
    m_Localized: А что с Солнцем?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216794
    m_Localized: Гости?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216795
    m_Localized: 'Neighbour: Слушай, я почему зашёл-то. Немного беспокоюсь за тебя.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216796
    m_Localized: 'Neighbour: Намечается что-то нехорошее.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216797
    m_Localized: 'Neighbour: Мне звонила двоюродная сестра. По их новостям говорят, что с солнцем происходит что-то странное.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216798
    m_Localized: 'Neighbour: И про людей, лезущих из земли. Их почему-то называют Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216799
    m_Localized: 'Neighbour: Жуть какая-то. Надеюсь, всё это неправда.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216800
    m_Localized: А что с Солнцем?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216801
    m_Localized: Гости?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216802
    m_Localized: 'Neighbour: Оно то ли взрывается, то ли вспышки на нём…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216803
    m_Localized: 'Neighbour: Известно одно: с ним что-то не так.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216804
    m_Localized: 'Neighbour: Ты ведь заметил, что это лето самое жаркое?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216805
    m_Localized: 'Neighbour: Похоже нам надо готовиться к худшему.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216806
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216807
    m_Localized: 'Neighbour: Сестра сказала, что оставаться дома одному опасно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216808
    m_Localized: 'Neighbour: Поэтому я пришёл, чтобы тебя точно не угробили.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216809
    m_Localized: Хорошо
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216810
    m_Localized: Я могу за себя постоять
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216811
    m_Localized: А как же твоя дочь и жена?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216812
    m_Localized: 'Neighbour: Да. Так вроде называют людей из земли.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216813
    m_Localized: 'Neighbour: Хрен знает, почему их так называют.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216814
    m_Localized: 'Neighbour: Наверное, потому что они гости на этой земле.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216815
    m_Localized: 'Neighbour: Либо потому что они пытаются попасть в дома людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216816
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216817
    m_Localized: 'Neighbour: Двоюродная сестра сказала, что оставаться дома одному – опасно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216818
    m_Localized: 'Neighbour: Поэтому я пришёл, чтобы тебя точно не угробили.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216819
    m_Localized: Хорошо
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216820
    m_Localized: Я могу за себя постоять
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216821
    m_Localized: А как же твоя дочь и жена?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216822
    m_Localized: 'Neighbour: Ладно, давай тогда с утра продолжим разговор.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216823
    m_Localized: 'Neighbour: Помню, у тебя пустует гостиная. Я там переночую, если ты не против.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216824
    m_Localized: 'Neighbour: Увидимся утром.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216825
    m_Localized: 'Neighbour: Знаю. Но мне кажется, сейчас оставаться одиноким гораздо опаснее, чем ты думаешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216826
    m_Localized: 'Neighbour: Давай я побуду с тобой одну ночь, на всякий случай. Мне так будет спокойнее.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216827
    m_Localized: 'Neighbour: Насчёт моих жены и дочери не переживай. Ко мне как раз на днях приехал хороший друг. Он присмотрит за моей семьёй.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216828
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216829
    m_Localized: 'Neighbour: Ладно, давай тогда с утра продолжим разговор.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216830
    m_Localized: 'Neighbour: Помню, у тебя пустует гостиная. Я там переночую, если ты не против.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216831
    m_Localized: 'Neighbour: Увидимся утром.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216832
    m_Localized: 'Neighbour: Не переживай, ко мне как раз на днях приехал хороший друг. Он присмотрит за моей семьёй одну ночь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216833
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216834
    m_Localized: 'Neighbour: Ладно, давай тогда с утра продолжим разговор.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216835
    m_Localized: 'Neighbour: Помню, у тебя пустует гостиная. Я там переночую, если ты не против.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216836
    m_Localized: 'Neighbour: Увидимся утром.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216837
    m_Localized: 'Neighbour: Проклятье… Всё-таки это правда…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216838
    m_Localized: 'Neighbour: Ладно, тогда всё, что я говорил, имеет смысл.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216839
    m_Localized: 'Neighbour: Не выходи на улицу днём. И тебе придётся пускать к себе других людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216840
    m_Localized: Зачем мне пускать к себе незнакомцев?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216841
    m_Localized: Пускать людей?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216842
    m_Localized: 'Neighbour: Я знаю, ты сторонишься людей, но так надо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216843
    m_Localized: 'Neighbour: Двоюродная сестра толком не сказала, почему именно нельзя оставаться одному…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216844
    m_Localized: 'Neighbour: Но вот что она упоминала – если кто-то будет спрашивать, один ли ты – отрицай это и говори, что в доме есть кто-то ещё.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216845
    m_Localized: Для меня люди – обуза
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216846
    m_Localized: Какой толк от лишних людей?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216847
    m_Localized: 'Neighbour: Да…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216848
    m_Localized: 'Neighbour: Я знаю, ты сторонишься компаний, но так надо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216849
    m_Localized: 'Neighbour: Двоюродная сестра толком не сказала, почему именно нельзя оставаться одному…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216850
    m_Localized: 'Neighbour: Но вот что она упоминала – если кто-то будет спрашивать, один ли ты – отрицай это и говори, что в доме есть кто-то ещё.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216851
    m_Localized: Для меня люди – обуза
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216852
    m_Localized: Какой толк от лишних людей?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216853
    m_Localized: 'Neighbour: Я помню это. Знаю, тебе будет непросто, но придётся. Иначе сейчас не выжить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216854
    m_Localized: 'Neighbour: Возможно, они что-нибудь принесут с собой и расскажут чего интересного.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216855
    m_Localized: 'Neighbour: И не забывай проверять их на признаки Гостя. Из-за жары у тебя будет мало сил днём.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216856
    m_Localized: 'Neighbour: Поэтому внимательно выбирай, у кого хочешь проверить признаки. Проверки сильно утомляют. Тебе ведь надо внимательно всматриваться.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216857
    m_Localized: 'Neighbour: А насчёт разговоров не беспокойся, они НЕ БУДУТ тратить силы. Так что говори сколько хочешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216858
    m_Localized: 'Neighbour: И лучше смотри в окна. Телик – это, конечно, хорошо, но не помешает знать, что происходит вокруг.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216859
    m_Localized: И что дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216860
    m_Localized: Что нам теперь делать?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216861
    m_Localized: 'Neighbour: Возможно, они что-нибудь принесут с собой и расскажут чего интересного.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216862
    m_Localized: 'Neighbour: И не забывай проверять их на признаки Гостя. Из-за жары у тебя будет мало сил днём.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216863
    m_Localized: 'Neighbour: Поэтому внимательно выбирай, у кого хочешь проверить признаки. Проверки сильно утомляют. Тебе ведь надо внимательно всматриваться.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216864
    m_Localized: 'Neighbour: А насчёт разговоров не беспокойся, они НЕ БУДУТ тратить силы. Так что говори сколько хочешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216865
    m_Localized: 'Neighbour: И лучше смотри в окна. Телик – это, конечно, хорошо, но не помешает знать, что происходит вокруг.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216866
    m_Localized: И что дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216867
    m_Localized: Что нам теперь делать?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216868
    m_Localized: 'Neighbour: Боюсь, всё, что мы можем – это пытаться выжить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216869
    m_Localized: 'Neighbour: И надеяться, что этот кошмар скоро закончится.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216870
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216871
    m_Localized: 'Neighbour: Думаю, правительство поможет нам как-нибудь. Может, отведёт всех в убежище, или вроде того.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216872
    m_Localized: 'Neighbour: Если что, держись рядом с моей семьёй.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216873
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216874
    m_Localized: 'Neighbour: Точно, чуть не забыл.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216875
    m_Localized: 'Neighbour: Я следующей ночью уйду обратно домой. Запиши мой номер, чтобы позвонить.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216876
    m_Localized: 'Neighbour: Нам как раз линию недавно провели.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216877
    m_Localized: 'Neighbour: ХХХ-ХХ-ХХ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216878
    m_Localized: 'Neighbour: Будем поддерживать связь по телефону.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216879
    m_Localized: 'Neighbour: Что ж, на этом теперь точно всё.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216880
    m_Localized: 'Neighbour: Кстати, я тебе там ящик пива принёс. У меня брат жены в пивоварне работает.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216881
    m_Localized: 'Neighbour: Выпей его и ложись спать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216882
    m_Localized: 'Neighbour: Оно сильно клонит в сон. Так что если не захочешь больше ни с кем говорить – пей пиво и отдыхай.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216883
    m_Localized: 'Daughter: Привет!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216884
    m_Localized: 'Daughter: Мой папа у вас? Вы позовете его?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216885
    m_Localized: 'Daughter: Днем было не страшно, но сейчас страшно – много людей повыходило ночью гулять…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216886
    m_Localized: Как зовут твоего папу?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216887
    m_Localized: Расскажи что-нибудь о своем папе.
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216888
    m_Localized: 'Daughter: Вы забыли его имя? А, вы проверяете меня, не гость ли я.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216889
    m_Localized: 'Daughter: А вы хитрый! Я тоже буду людей проверять теперь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216890
    m_Localized: Спокойно дошла сюда?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216891
    m_Localized: Боишься гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216892
    m_Localized: 'Daughter: Хм, я много про него знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216893
    m_Localized: 'Daughter: Перед тем, как пойти в гости, он любит попить немного пива, хи-хи.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216894
    m_Localized: 'Daughter: Мне он оставляет и обед, и ужин, и сок.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216895
    m_Localized: 'Daughter: Я сегодня попробовала пиво, которое он пьет, фу, гадость какая!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216896
    m_Localized: 'Daughter: Зачем такое пить, если есть сок?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216897
    m_Localized: 'Daughter: Ой, не говорите ему, пожалуйста.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216898
    m_Localized: Спокойно дошла сюда?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216899
    m_Localized: Боишься гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216900
    m_Localized: 'Daughter: Знаете, как будто все перевернулось с ног на голову.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216901
    m_Localized: 'Daughter: Люди днем теперь сидят дома или спят. Ночью – гуляют и делают дела.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216902
    m_Localized: 'Daughter: Я еще не отвыкла бояться темноты, но, вроде, и бояться нечего.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216903
    m_Localized: 'Daughter: Или есть чего?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216904
    m_Localized: Зову папу тебе. Удачи!
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216905
    m_Localized: Хорошо проведите время!
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216906
    m_Localized: 'Daughter: Не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216907
    m_Localized: 'Daughter: Все их боятся, мне тоже страшно. Я не видела ни одного из них.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216908
    m_Localized: 'Daughter: Они страшные? Больно бьют?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216909
    m_Localized: 'Daughter: Если меня мой друг из школы ударил больно – он тоже гость?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216910
    m_Localized: 'Daughter: Папа сказал быть осторожной, я очень осторожна!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216911
    m_Localized: 'Daughter: Очень тихонько сюда пришла, никто меня не видел.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216912
    m_Localized: Зову папу тебе. Удачи!
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216913
    m_Localized: Хорошо проведите время!
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216914
    m_Localized: 'Daughter: Спасибо, вам тоже!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216915
    m_Localized: 'Daughter: Мы уже пойдем, а то мне страшно одной ночью.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216916
    m_Localized: 'Daughter: Мы будем играть в игру, он сделал мне какую-то, там надо кубики бросать!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216917
    m_Localized: 'Daughter: И потом ходить по предметам, то есть, по креслу, там, или дивану.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216918
    m_Localized: 'Daughter: И вот, надо строить дорогу. Короче, я покажу вам потом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216919
    m_Localized: 'Daughter: До свидания!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216920
    m_Localized: 'Daughter: З-зд-здрасте.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216921
    m_Localized: 'Daughter: Пустите м-меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216922
    m_Localized: У тебя истерика?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216923
    m_Localized: Что-то случилось?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216924
    m_Localized: 'Daughter: Я не-не знаю-ю-ю что мне де-делать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216925
    m_Localized: 'Daughter: Люди-и-и-и.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216926
    m_Localized: 'Daughter: А-а-а-а-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216927
    m_Localized: 'Daughter: Убили-ли-ли па…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216928
    m_Localized: 'Daughter: А-а-а-аха-а-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216929
    m_Localized: 'Daughter: Па-пу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216930
    m_Localized: Кто это сделал?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216931
    m_Localized: Почему они это сделали?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216932
    m_Localized: 'Daughter: А-а-а-а-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216933
    m_Localized: 'Daughter: Мо-мо-моего па-па…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216934
    m_Localized: 'Daughter: А-а-а-а-ха-а-а-а-ах.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216935
    m_Localized: 'Daughter: Убили па-па-пу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216936
    m_Localized: Кто это сделал?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216937
    m_Localized: Почему они это сделали?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216938
    m_Localized: 'Daughter: К нам пришли го-о-ости. Они си-сидели у нас.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216939
    m_Localized: 'Daughter: Папа о чем-то го-го-говорил с ними. А потом они его убили.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216940
    m_Localized: 'Daughter: Аааааааааа-хааааааа.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216941
    m_Localized: 'Daughter: Наш дом те-теперь го-горииииит.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216942
    m_Localized: Проходи
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216943
    m_Localized: Тебе лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216944
    m_Localized: 'Daughter: Я не-не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216945
    m_Localized: 'Daughter: Они спокойно си-си-сидели с папой на кухне.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216946
    m_Localized: 'Daughter: А потом они что-то сде-ла-ла-ли, а потом по-подожгли дом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216947
    m_Localized: 'Daughter: Пока я бе-бежала, они смеялись просто.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216948
    m_Localized: Проходи.
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216949
    m_Localized: Тебе лучше уйти.
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216950
    m_Localized: 'Daughter: Вы по-поможе-жете мне?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216951
    m_Localized: 'Daughter: Мне стра-а-а-шно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216952
    m_Localized: 'Daughter: Куда я пойду-у-у-ууууу?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216953
    m_Localized: 'Daughter: Ааааааааааа.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216954
    m_Localized: 'Daughter: АААААААААААА.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216955
    m_Localized: 'Daughter: МНЕ ОЧЕНЬ СТРА-А-АААШНООООО.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216956
    m_Localized: 'Daughter: Я... Я хо-чу к ма-ме.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216957
    m_Localized: Расскажи, что случилось
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216958
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216959
    m_Localized: 'Daughter: Я не зна-а-а-аю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216960
    m_Localized: 'Daughter: Они зашли, начали говорить, папа сказал, что так нельзя, а они сказали, что … сказали…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216961
    m_Localized: 'Daughter: ПАПА, ПАПОЧКА!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216962
    m_Localized: 'Daughter: ПА-А-А-АПА-А-А!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216963
    m_Localized: Ты… отдыхай пока
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216964
    m_Localized: Я ещё завтра с тобой поговорю, хорошо?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216965
    m_Localized: 'Daughter: (Девочка безостановочно зовёт отца, истерика остановится нескоро)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216966
    m_Localized: 'Daughter: (Девочка даже не слышит вас. В своём горе она одна)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216967
    m_Localized: 'Daughter: Я... Я хо-чу к ма-ме.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216968
    m_Localized: Ты как? Нравится тебе здесь?
    m_Metadata:
      m_Items: []
  - m_Id: 2922838216969
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411008
    m_Localized: 'Daughter: Неплохо тут.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411009
    m_Localized: 'Daughter: Я бы хотела домой…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411010
    m_Localized: 'Daughter: Когда можно будет пойти домой?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411011
    m_Localized: Позже, там ремонт
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411012
    m_Localized: Нескоро. Ваш дом сгорел
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411013
    m_Localized: 'Daughter: Хорошо. Значит, скоро за мной придут?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411014
    m_Localized: 'Daughter: И заберут в новый дом?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411015
    m_Localized: 'Daughter: Или в тот же?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411016
    m_Localized: 'Daughter: Мне сделают новую комнату?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411017
    m_Localized: 'Daughter: Значит, папа всё-таки придёт за мной, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411018
    m_Localized: Ты же видела, что произошло
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411019
    m_Localized: Тебе лучше пока побыть здесь
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411020
    m_Localized: 'Daughter: Но с папой всё в порядке?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411021
    m_Localized: 'Daughter: А моя комната? Она тоже сгорела?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411022
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411023
    m_Localized: 'Daughter: Мама не приедет за нами?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411024
    m_Localized: 'Daughter: А кто-нибудь остался у нас ещё?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411025
    m_Localized: Ты же видела, что произошло
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411026
    m_Localized: Тебе лучше пока побыть здесь
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411027
    m_Localized: 'Daughter: Я не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411028
    m_Localized: 'Daughter: Я не уверена.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411029
    m_Localized: 'Daughter: Папу стукнули, но он потом встал, я видела такое.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411030
    m_Localized: 'Daughter: Значит… значит он и потушить пожар мог.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411031
    m_Localized: 'Daughter: Или просто уйти искать меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411032
    m_Localized: 'Daughter: Он же скоро придёт?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411033
    m_Localized: 'Daughter: Я без папы никуда не пойду.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411034
    m_Localized: 'Daughter: Он же придёт за мной, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411035
    m_Localized: 'Daughter: Я видела, он потом встал, и ушёл.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411036
    m_Localized: 'Daughter: Я хоть и бежала, но видела его.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411037
    m_Localized: 'Daughter: Я... Я хо-чу к ма-ме.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411038
    m_Localized: Ты должна принять, что случилось
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411039
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411040
    m_Localized: 'Daughter: Вы про что?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411041
    m_Localized: 'Daughter: У вас в комнате я видела телевизор. Можно там мультики смотреть?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411042
    m_Localized: Я не знаю, что ты видела. Но, похоже, твой отец умер
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411043
    m_Localized: Возможно, папа не придёт за тобой. Я не знаю, что с ним
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411044
    m_Localized: 'Daughter: Вы же не видели, что там было!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411045
    m_Localized: 'Daughter: А я была там! Он пошевелился, когда я убегала.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411046
    m_Localized: 'Daughter: Значит скоро он придёт!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411047
    m_Localized: Почему он так и не пришёл за тобой?
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411048
    m_Localized: Каким ты его видела в последний раз?
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411049
    m_Localized: 'Daughter: Не придёт? Почему вы так думаете?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411050
    m_Localized: Почему он так и не пришёл за тобой?
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411051
    m_Localized: Каким ты его видела в последний раз?
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411052
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411053
    m_Localized: 'Daughter: Может, ему что-то нужно сделать сначала?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411054
    m_Localized: 'Daughter: Он пошёл побить этих плохих людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411055
    m_Localized: 'Daughter: Он… он скоро должен прийти.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411056
    m_Localized: Мне очень жаль твоего отца. Он был настоящим человеком. Но слишком добрым
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411057
    m_Localized: Ладно, отец наверняка скоро придёт
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411058
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411059
    m_Localized: 'Daughter: Хорошим.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411060
    m_Localized: 'Daughter: Его побили… поэтому…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411061
    m_Localized: 'Daughter: Я не помню.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411062
    m_Localized: Мне очень жаль твоего отца. Он был настоящим человеком. Но слишком добрым
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411063
    m_Localized: Ладно, отец наверняка скоро придёт
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411064
    m_Localized: 'Daughter: (Девочка смотрит куда-то сквозь вас. Вы боитесь пошевелиться и просто ждёте, пока что-нибудь не произойдёт.)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411065
    m_Localized: 'Daughter: (Через какое-то время у неё начинается истерика. Похоже, вы больше ничего не можете сделать.)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411066
    m_Localized: 'Daughter: (Хуже, если она будет жить в обмане. Она должна принять смерть как можно раньше.)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411067
    m_Localized: 'Daughter: Вот и я так думаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411068
    m_Localized: 'Daughter: (Вы замечаете, что девочка стала заторможенной. Она явно о чём-то думает.)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411069
    m_Localized: 'Daughter: (Но стоит ли сейчас рушить её детство? Выдержит ли она такой удар?)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411070
    m_Localized: 'Daughter: (Вы решаете, что сейчас и так хватает проблем. Не стоит беспокоить ребёнка.)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411071
    m_Localized: 'Daughter: Что ты хочешь проверить?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411072
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411073
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411074
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411075
    m_Localized: Подмышки
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411076
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411077
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411078
    m_Localized: 'Daughter: Зубы? Показать вам зубы?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411079
    m_Localized: 'Daughter: Зачем? У меня еще молочные зубки. Папа говорил…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411080
    m_Localized: 'Daughter: Я не буду плакать больше.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411081
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411082
    m_Localized: 'Daughter: Вот какие у меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411083
    m_Localized: 'Daughter: Это что значит?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411084
    m_Localized: 'Daughter: Все хорошо же?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411085
    m_Localized: 'Daughter: А я умею сама стричь ногти уже.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411086
    m_Localized: 'Daughter: Я пока не очень умею, мне…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411087
    m_Localized: 'Daughter: Смотрите.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411088
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411089
    m_Localized: 'Daughter: Вот какие ноготочки.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411090
    m_Localized: 'Daughter: Это я сама постригла. Смогла. Сама.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411091
    m_Localized: 'Daughter: Я пойду, хочу посидеть одна.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411092
    m_Localized: 'Daughter: А ты можешь заглянуть внутрь глаза?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411093
    m_Localized: 'Daughter: Ты увидишь там все, о чем я думаю?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411094
    m_Localized: 'Daughter: Я тогда буду осторожно думать, не переживай.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411095
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411096
    m_Localized: 'Daughter: Ты зачем так посмотрел?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411097
    m_Localized: 'Daughter: Ты там у-у-увидел…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411098
    m_Localized: 'Daughter: Ты … уааааа.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411099
    m_Localized: 'Daughter: Я-я-я пи-ить хочу-уууу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411100
    m_Localized: 'Daughter: Что нужно сделать?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411101
    m_Localized: 'Daughter: (Вы смотрите на неё и понимаете, что для вас это черезчур)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411102
    m_Localized: 'Daughter: Просто хотите узнать как у меня дела?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411103
    m_Localized: 'Daughter: Я очень устала, можно постою тут одна?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411104
    m_Localized: 'Daughter: Фото?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411105
    m_Localized: 'Daughter: А меня мало фотографировали.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411106
    m_Localized: 'Daughter: Покажешь потом фото?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411107
    m_Localized: 'Daughter: (Вы фотографируете девочку)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411108
    m_Localized: 'Daughter: (Фотография получилась слегка размытой)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411109
    m_Localized: 'Daughter: (Девочка, не дожидаясь конца фотосъемки подбежала к вам)'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411110
    m_Localized: 'Daughter: Мммм.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411111
    m_Localized: 'Daughter: Спасибо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411112
    m_Localized: 'Daughter: Мне не понравилось. Больше не проси меня делать фото.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411113
    m_Localized: 'SuperFake: Привет!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411114
    m_Localized: Что надо?
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411115
    m_Localized: Пускать не собираюсь
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411116
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411117
    m_Localized: 'SuperFake: Просторный дом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411118
    m_Localized: 'SuperFake: Мне нравится.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411119
    m_Localized: Мне ничего не надо
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411120
    m_Localized: У меня ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411121
    m_Localized: 'SuperFake: Дверь надёжная у тебя?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411122
    m_Localized: 'SuperFake: А то мало ли.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411123
    m_Localized: 'SuperFake: Сам понимаешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411124
    m_Localized: Мне ничего не надо
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411125
    m_Localized: У меня ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411126
    m_Localized: 'SuperFake: Да-да, понимаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411127
    m_Localized: 'SuperFake: Слуууушай…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411128
    m_Localized: 'SuperFake: Ты дома один?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411129
    m_Localized: Я не один
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411130
    m_Localized: Я один
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411131
    m_Localized: 'SuperFake: Это отлично!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411132
    m_Localized: 'SuperFake: “Всё, что мне совесть оставит, я бы заел и зубами”, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411133
    m_Localized: 'SuperFake: Но скажи…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411134
    m_Localized: 'SuperFake: Ты дома один?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411135
    m_Localized: Я не один
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411136
    m_Localized: Я один
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411137
    m_Localized: 'SuperFake: Сегодня тебе повезло.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411138
    m_Localized: 'SuperFake: Я слышу, как кто-то шепчется в твоих комнатах.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411139
    m_Localized: 'SuperFake: Но кто знает, что будет через несколько дней?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411140
    m_Localized: 'SuperFake: Хахахахаха.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411141
    m_Localized: 'SuperFake: Мне ясно, что ты один.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411142
    m_Localized: 'SuperFake: Хотел проверить, соврёшь или нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411143
    m_Localized: 'SuperFake: Я открою.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411144
    m_Localized: 'NotTrue: Привет, дружок! Что-то я притомилась сюда идти.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411145
    m_Localized: 'NotTrue: Отдохнуть у тя можно?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411146
    m_Localized: Ты прям сюда шла?
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411147
    m_Localized: Долго шла?
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411148
    m_Localized: 'NotTrue: Да не прям сюда, конечно, хаха.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411149
    m_Localized: 'NotTrue: С кем надо жизнь сама сведёт, никого не пропустим.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411150
    m_Localized: 'NotTrue: Раз сюда пришла, значит, сюда ноги привели, глаза привели.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411151
    m_Localized: 'NotTrue: Надо так, наверно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411152
    m_Localized: Не пойму, тебе надо что-то?
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411153
    m_Localized: Так и шла бы дальше. Почему остановилась?
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411154
    m_Localized: 'NotTrue: Да долго ли не скажу. И как понять – долго?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411155
    m_Localized: 'NotTrue: Даже вот ты. Сидишь дома, а всё равно ходишь же.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411156
    m_Localized: 'NotTrue: Долго ходишь? Да уж поди долго.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411157
    m_Localized: 'NotTrue: А я дольше твоего топчу-пляшу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411158
    m_Localized: 'NotTrue: Таки дела, дружок.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411159
    m_Localized: Не пойму, тебе надо что-то?
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411160
    m_Localized: Так и шла бы дальше. Почему остановилась?
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411161
    m_Localized: 'NotTrue: Да как и всем.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411162
    m_Localized: 'NotTrue: Историй каких послушать, самой поделиться чем интересным.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411163
    m_Localized: 'NotTrue: А там прилечь, глаза сладко закрыть.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411164
    m_Localized: 'NotTrue: И выдохнуть как следует.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411165
    m_Localized: 'NotTrue: Большего-то мне и не надо. А одной скучно-грустно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411166
    m_Localized: Проходи
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411167
    m_Localized: Тебе лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411168
    m_Localized: 'NotTrue: Ты меня будто не слушаешь, дружок.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411169
    m_Localized: 'NotTrue: Притомилась идти уже.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411170
    m_Localized: 'NotTrue: У тебя можно хоть дух перевести, поговорить с кем.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411171
    m_Localized: 'NotTrue: Уже какое-никакое развлечение мне, старухе.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411172
    m_Localized: 'NotTrue: Что-нибудь расскажешь, я чем поделюсь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411173
    m_Localized: 'NotTrue: А там уже можно и веки сомкнуть хоть.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411174
    m_Localized: Проходи
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411175
    m_Localized: Тебе лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411176
    m_Localized: 'NotTrue: Спасибо, дружок!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411177
    m_Localized: 'NotTrue: Чувствую, у тебя скучно не будет. Посмотрю хоть, чего делается тут.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411178
    m_Localized: 'NotTrue: Меня отовсюду гонят.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411179
    m_Localized: 'NotTrue: Потому что не волк я по крови своей, и лежать мне в сосновом гробу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411180
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411181
    m_Localized: 'NotTrue: Но, нехотя, а всё-таки обращаются ко мне, даже если и говорят, что никогда ко не придут.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411182
    m_Localized: 'NotTrue: Ну я не обидчивая, всем помогаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411183
    m_Localized: 'NotTrue: Даже и тебе помочь придётся. А куда деваться?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411184
    m_Localized: 'NotTrue: И где сейчас моя изба? Я там оставила кое-что важное…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411185
    m_Localized: Не понял. Ты просто ходишь от дома к дому?
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411186
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411187
    m_Localized: 'NotTrue: Ну да. А что ж тут такого?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411188
    m_Localized: 'NotTrue: Люди пользуются моими историями, да потом ненавидят за них же.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411189
    m_Localized: 'NotTrue: Представляешь себе?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411190
    m_Localized: 'NotTrue: У меня дом-то есть. Изба.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411191
    m_Localized: 'NotTrue: Мне в ней хорошо, да вяну я без общения.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411192
    m_Localized: 'NotTrue: А в избу ко мне кто придёт?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411193
    m_Localized: 'NotTrue: Вот хожу да странствую. Мне-то терять нечего.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411194
    m_Localized: 'NotTrue: И где сейчас моя изба? Я там оставила кое-что важное…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411195
    m_Localized: Что у тебя за истории?
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411196
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411197
    m_Localized: 'NotTrue: Самые обычные. Где живу, там и собираю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411198
    m_Localized: 'NotTrue: Потом рассказываю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411199
    m_Localized: 'NotTrue: Я уже старая, не запоминаю эти ваши истории. Рассказываю потом на свой лад.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411200
    m_Localized: 'NotTrue: За то и ненавидят, может.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411201
    m_Localized: 'NotTrue: Знаешь как говорят? “Купол лба трещит от гробовой тоски. Летим в решётку страшных снов”, говорят.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411202
    m_Localized: 'NotTrue: Но не одна я додумываю истории, понимаешь? Хе-хе-хе.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411203
    m_Localized: 'NotTrue: Все ко мне приходят. Рано или поздно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411204
    m_Localized: 'NotTrue: Всем нужны истории.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411205
    m_Localized: 'NotTrue: И где сейчас моя изба? Я там оставила кое-что важное…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411206
    m_Localized: Расскажи какую-нибудь историю
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411207
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411208
    m_Localized: 'NotTrue: Что же тебе рассказать?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411209
    m_Localized: 'NotTrue: Человек боязливое существо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411210
    m_Localized: 'NotTrue: В одном из домов жил человек, который ото всех заперся.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411211
    m_Localized: 'NotTrue: Жил в многоэтажке, заперся в квартире, особо никуда не выходил.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411212
    m_Localized: 'NotTrue: То ли Гости его пугали, то ли сама смерть.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411213
    m_Localized: 'NotTrue: К нему особо-то никто и не приходил. Но он бы и не пустил.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411214
    m_Localized: 'NotTrue: Ну и вот.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411215
    m_Localized: 'NotTrue: Слышу такой звук, БУУУУМ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411216
    m_Localized: 'NotTrue: Не поняла сначала.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411217
    m_Localized: 'NotTrue: Глянула в окно – это он выкинулся.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411218
    m_Localized: 'NotTrue: Не выдержал.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411219
    m_Localized: 'NotTrue: Как история тебе?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411220
    m_Localized: Не впечатляет
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411221
    m_Localized: Это всё?
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411222
    m_Localized: 'NotTrue: Наверно, поэтому и не любят меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411223
    m_Localized: 'NotTrue: Но ничего, как запомню, так и расскажу твою историю кому-нибудь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411224
    m_Localized: 'NotTrue: Да. Человек же разбился.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411225
    m_Localized: 'NotTrue: То ли боялся в муках умереть от взрыва солнца, то ли ещё что.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411226
    m_Localized: 'NotTrue: А я думаю, сердце его не выдержало одиночества.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411227
    m_Localized: 'NotTrue: Но что поделать…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411228
    m_Localized: 'NotTrue: И где сейчас моя изба? Я там оставила кое-что важное…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411229
    m_Localized: Давай ещё историю
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411230
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411231
    m_Localized: 'NotTrue: Давай, сейчас.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411232
    m_Localized: 'NotTrue: Когда я жила в деревне, был там один мужик.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411233
    m_Localized: 'NotTrue: Любил он в лес ходить. Не знаю даже зачем.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411234
    m_Localized: 'NotTrue: Ну и вот. Опять пошёл в лес, да понял, что заблудился. Не может тропу назад найти.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411235
    m_Localized: 'NotTrue: Постоял, подумал. Решил, что если пойдёт прямо, куда-то он всё-таки выйдет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411236
    m_Localized: 'NotTrue: Идёт-идёт, а всё никак и никуда выйти не может.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411237
    m_Localized: 'NotTrue: Да тут-то и понял, что носит его кругами.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411238
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411239
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411240
    m_Localized: И что дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411241
    m_Localized: Какая-то херня получается
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411242
    m_Localized: 'NotTrue: Нашли мёртвым его. Так и не вышел.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411243
    m_Localized: 'NotTrue: Это мы потом по его следам походили, поняли, что он круги нарезал.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411244
    m_Localized: 'NotTrue: Знаешь такое? Говорят, что у людей одна нога длиннее другой.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411245
    m_Localized: 'NotTrue: Вот так и получилось.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411246
    m_Localized: 'NotTrue: Почему? Не нравится история?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411247
    m_Localized: 'NotTrue: Ну, что-то я приврала, конечно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411248
    m_Localized: 'NotTrue: Но это действительно происходило. Да и происходит.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411249
    m_Localized: 'NotTrue: Ходят, плутают, а как выйти?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411250
    m_Localized: 'NotTrue: Хех. Ну давай, убедись, дружок. Всё одно ничего нового для себя не увидишь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411251
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411252
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411253
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411254
    m_Localized: Подмышки
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411255
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411256
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411257
    m_Localized: 'NotTrue: Зубы?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411258
    m_Localized: 'NotTrue: А-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411259
    m_Localized: 'NotTrue: Вообще, зубы эти... Ох, они мне в своё время так надоели. Думала, давай-ка всё вырву к чертям собачьим.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411260
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411261
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411262
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411263
    m_Localized: 'NotTrue: Видишь? Они у меня не счётные, не укладывающиеся, не отмеренные.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411264
    m_Localized: 'NotTrue: Как раз столько, сколько нужно. Как раз столько, сколько не хватит.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411265
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411266
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411267
    m_Localized: 'NotTrue: Ой, дружок… а ты уверен, что хочешь этого?..'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411268
    m_Localized: 'NotTrue: Глаза – это ж как окна. В домах – для света, а в людях – для правды.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411269
    m_Localized: 'NotTrue: Но у меня они запыленные… стекло треснуто… шторы давно съела моль.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411270
    m_Localized: 'NotTrue: Не заглядывай, дружок. Там пусто.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411271
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411272
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411273
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411274
    m_Localized: 'NotTrue: Ой, заставляешь старуху поднимать руки. И не совестно тебе? Я ж еле на ногах держусь!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411275
    m_Localized: 'NotTrue: Что ж с тобой поделаешь… Хозяин - барин.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411276
    m_Localized: 'NotTrue: Ну как?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411277
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411278
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411279
    m_Localized: 'NotTrue: Чего-чего? Да что на меня плёнку переводить. Она ж явно дефицитная… Настаиваешь? Ну что ж, мне приятно!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411280
    m_Localized: 'NotTrue: И что скажешь теперь, дружок?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411281
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922842411282
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605312
    m_Localized: 'NotTrue: Хах, дружок, ну и придумал.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605313
    m_Localized: 'NotTrue: Самые обыкновенные. Как слышала, так и слышу. Но, знаешь… Иногда кажется, что меня и нет вовсе.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605314
    m_Localized: 'NotTrue: Будто меня только на просвет видно, и то не всегда.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605315
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605316
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605317
    m_Localized: 'NotTrue: Ой, ну что ты мне этим тычешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605318
    m_Localized: 'NotTrue: Будто нет ничего хуже, чем беззубая старуха.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605319
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605320
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605321
    m_Localized: 'NotTrue: Ты думаешь, мне страшно? Думаешь, я за них держусь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605322
    m_Localized: 'NotTrue: Я столько раз хваталась за воздух, что пальцы уже сами знают – ничего не удержишь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605323
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605324
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605325
    m_Localized: 'NotTrue: Вот как…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605326
    m_Localized: 'NotTrue: Ты не веришь? Проверить хочешь? Ну смотри, смотри…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605327
    m_Localized: 'NotTrue: Я ведь тоже когда-то смотрела. А теперь только вспоминаю, как это было.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605328
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605329
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605330
    m_Localized: 'NotTrue: Да это ж, дружок, как отпечаток старости – все, кто свой век доживает, получает вот такой вот подарочек. А ты не знал?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605331
    m_Localized: 'NotTrue: Грибок, он ж не болит, жрать не просит, просто есть – и есть. Живёт да живёт. Как и я, хе-хе.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605332
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605333
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605334
    m_Localized: 'NotTrue: Что, из этого тоже будешь щёлкать?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605335
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605336
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605337
    m_Localized: 'NotTrue: Ну и что это такое, дружок? Что ж по ушам-то можно понять?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605338
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605339
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605340
    m_Localized: 'NotTrue: Ну вот. Я ж не против, я только за. Мне-то что, дружок? Я давно уже хочу к Богу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605341
    m_Localized: 'NotTrue: Только вот…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605342
    m_Localized: 'NotTrue: Платила доктору тому, чтоб всё убрал, да нельзя оказалось сразу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605343
    m_Localized: 'NotTrue: Ходила к нему, вырывала по одному-двум за раз... да так и не успела до конца-то довести. Докторам сейчас не до этого всего.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605344
    m_Localized: 'NotTrue: Так и живу, дружок, с этим незавершённым делом во рту.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605345
    m_Localized: 'NotTrue: Руки – для тех, кто держит. Я уже давно перестала этим заниматься.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605346
    m_Localized: 'NotTrue: Протягивать руку? Зачем? Ведь ты и сам тянешься.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605347
    m_Localized: 'NotTrue: "К шестипалой неправде в избу…" Ко мне, дружок. Ну, заходи.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605348
    m_Localized: 'NotTrue: Думаешь, что избежишь этой участи? Ну, если только молодым погибнешь. Но ты лучше побереги себя!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605349
    m_Localized: 'NotTrue: А то вон какой красавец! Грех было бы такого погубить!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605350
    m_Localized: 'NotTrue: В моё время-то все эти аппараты были только у богатых. А сейчас, вон, у всяких рукастых есть!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605351
    m_Localized: 'NotTrue: Нечего мне тебе сказать. Глупости какие-то творишь. Людей добрых тревожишь попусту…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605352
    m_Localized: 'Twins: Здравствуйте. Ох, обопрись на меня пока что.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605353
    m_Localized: 'Twins: Ничего, что мы пришли сюда?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605354
    m_Localized: Вашему близкому плохо?
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605355
    m_Localized: Вы обе больны? Или только одна из вас?
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605356
    m_Localized: 'Twins: Это моя сестра. У нее депрессия.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605357
    m_Localized: 'Twins: Она не может сама ходить, купаться, иногда даже встать с кровати для нее испытание.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605358
    m_Localized: 'Twins: Но ничего, когда-то должно стать лучше. Да, сестричка?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605359
    m_Localized: 'Twins: Она пока не в состоянии поговорить, но иногда она находит силы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605360
    m_Localized: Что будете делать дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605361
    m_Localized: Тебе не надоело возиться с ней?
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605362
    m_Localized: 'Twins: Мы все в разной степени больны депрессией.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605363
    m_Localized: 'Twins: Мы понимали, к чему все идет еще до начала проблем с солнцем.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605364
    m_Localized: 'Twins: Вы же следили за новостями? Все шло к этому. Но, я думаю, до полноценного взрыва все равно не дойдет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605365
    m_Localized: Что будете делать дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605366
    m_Localized: Тебе не надоело возиться с ней?
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605367
    m_Localized: 'Twins: Мне нужно найти место, где сестра почувствует себя немного спокойнее.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605368
    m_Localized: 'Twins: А потом срежиссируем новую жизнь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605369
    m_Localized: 'Twins: Думаете, дальше жить невозможно?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605370
    m_Localized: 'Twins: Я с вами не соглашусь. Дальше должно стать полегче.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605371
    m_Localized: Проходите
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605372
    m_Localized: Вам лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605373
    m_Localized: 'Twins: Вы уж слова подбирайте, пожалуйста.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605374
    m_Localized: 'Twins: Да, это может отнимать силы, но я не могу бросить ее, если вы про это.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605375
    m_Localized: 'Twins: Мы с ней вместе ушли из дома родителей. Больше у нас нет никакого якоря в жизни.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605376
    m_Localized: Проходите
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605377
    m_Localized: Вам лучше уйти
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605378
    m_Localized: 'Twins: Спасибо! Помогите мне ее занести.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605379
    m_Localized: 'Twins: Смерть родителей будто подкосила ее еще сильнее, но она уже долго в таком состоянии.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605380
    m_Localized: 'Twins: Может, у вас она немного придет в себя.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605381
    m_Localized: 'Twins: Уф. Ничего, сестренка, надо постараться пройти еще.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605382
    m_Localized: 'Twins: Давай же, пойдём, помоги мне немного.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605383
    m_Localized: 'Twins: Ох, твою мать, когда это кончится…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605384
    m_Localized: 'Alkonost:'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605385
    m_Localized: Как твоя сестра?
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605386
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605387
    m_Localized: 'Alkonost: Мне приходится ей помогать. Очень во многом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605388
    m_Localized: 'Alkonost: Вчера мне удалось искупать ее в ванне. Дома она не могла даже залезть туда.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605389
    m_Localized: 'Alkonost: Пока изменений никаких. Но спасибо за внимание.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605390
    m_Localized: 'Alkonost: Людям с депрессией очень… непросто.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605391
    m_Localized: 'Alkonost: Я боюсь, что в какой-то момент нам надо будет бежать, а она просто не найдёт в себе сил.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605392
    m_Localized: 'Alkonost: Или не сможет поесть просто потому что на это нет сил.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605393
    m_Localized: 'Alkonost: Я и сама устала, пожалуй, отдохну немного.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605394
    m_Localized: 'Alkonost:'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605395
    m_Localized: Что вы будете делать дальше?
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605396
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605397
    m_Localized: 'Alkonost: Это хороший вопрос.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605398
    m_Localized: 'Alkonost: Мой муж скоро должен приехать за нами, надеюсь, он сможет найти безопасное место.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605399
    m_Localized: 'Alkonost: Там переждем нападения гостей и солнечную жару.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605400
    m_Localized: 'Alkonost: Он говорил, что такое место есть. Ещё он сказал, что солнце не может взорваться.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605401
    m_Localized: 'Alkonost: Если бы это было так, нас бы смело минут за 10 или меньше.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605402
    m_Localized: 'Alkonost: Думаю, он прав.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605403
    m_Localized: 'Alkonost:'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605404
    m_Localized: Есть новости от мужа?
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605405
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605406
    m_Localized: 'Alkonost: Почему-то он ничего мне не сообщает. Не звонит, не приходит за нами.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605407
    m_Localized: 'Alkonost: Ничего не может с ним произойти? Вряд ли у него проблемы?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605408
    m_Localized: 'Alkonost: Могу сказать точно, что он нас не бросил. Это невозможно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605409
    m_Localized: 'Alkonost: Даже когда моя сестра совсем сидела у него в печёнках, он все равно помогал мне с ней.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605410
    m_Localized: 'Alkonost: Он… наверняка приедет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605411
    m_Localized: 'Alkonost: И моей сестре как будто лучше… Значит… он приедет, и все будет хорошо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605412
    m_Localized: 'Alkonost:'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605413
    m_Localized: Выглядишь подавлено
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605414
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605415
    m_Localized: 'Alkonost: М?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605416
    m_Localized: 'Alkonost: Наверно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605417
    m_Localized: 'Alkonost: Я очень много думаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605418
    m_Localized: 'Alkonost: Если солнце не взорвется, то почему оно не стихает? Почему все думают только про конец мира?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605419
    m_Localized: 'Alkonost: Я посмотрела новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605420
    m_Localized: 'Alkonost: Напрямую не говорят, но как будто температура днем только растет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605421
    m_Localized: 'Alkonost: Меняется климат. Значит, умирают животные, не приспособленные к новой… погоде.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605422
    m_Localized: 'Alkonost: А что тогда будет с нами?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605423
    m_Localized: 'Alkonost:'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605424
    m_Localized: Эй. Ты как?
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605425
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605426
    m_Localized: 'Alkonost: Я ходила на улицу ночью. Хотела найти мужа.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605427
    m_Localized: 'Alkonost: Обошла несколько мест, где он мог быть.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605428
    m_Localized: 'Alkonost: В одном нашла. Он принял таблетку.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605429
    m_Localized: 'Alkonost: Мы… мы покупали такие. На случай, если всё будет плохо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605430
    m_Localized: 'Alkonost: Он съел её. Он испугался. Не позвал меня с собой.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605431
    m_Localized: 'Alkonost: Он съел. Съел таблетку. И ни слова про солнце.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605432
    m_Localized: 'Alkonost:'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605433
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605434
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605435
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605436
    m_Localized: Подмышки
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605437
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605438
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605439
    m_Localized: 'Sirin:'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605440
    m_Localized: Эй. Ты как?
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605441
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605442
    m_Localized: 'Sirin: Я чувствую…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605443
    m_Localized: 'Sirin: Как тяжёлое одеяло. Очень тяжёлое.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605444
    m_Localized: 'Sirin: Сдавливает мне тело.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605445
    m_Localized: 'Sirin: Я… не хочу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605446
    m_Localized: 'Sirin:'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605447
    m_Localized: Сегодня ты пободрее
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605448
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605449
    m_Localized: 'Sirin: Так и есть.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605450
    m_Localized: 'Sirin: Знал ли ты про солнце? Оно взрывается?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605451
    m_Localized: 'Sirin: Только сегодня ночью узнала об этом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605452
    m_Localized: 'Sirin: Получается, это конец?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605453
    m_Localized: 'Sirin: Не останется даже следа следа нашего существования?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605454
    m_Localized: 'Sirin: Интересно подумать над этим.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605455
    m_Localized: 'Sirin:'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605456
    m_Localized: Как твоя сестра?
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605457
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605458
    m_Localized: 'Sirin: Она боится всё потерять.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605459
    m_Localized: 'Sirin: Мне кажется, что терять и нечего.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605460
    m_Localized: 'Sirin: В бесконечно развивающейся Вселенной мы – никто.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605461
    m_Localized: 'Sirin: Мы никому не нужны, потому что никого больше нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605462
    m_Localized: 'Sirin: Если планеты не станет, некому будет по нам горевать. Да и не надо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605463
    m_Localized: 'Sirin: Но мою сестру это сильно пугает.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605464
    m_Localized: 'Sirin:'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605465
    m_Localized: Твоей сестре плохо?
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605466
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605467
    m_Localized: 'Sirin: Да. Чтобы перестать думать о плохом, она собирается поискать мужа.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605468
    m_Localized: 'Sirin: У меня есть ощущение, что это плохая идея. Но она уже не может спокойно сидеть.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605469
    m_Localized: 'Sirin: Если она всё же сорвется искать его, мне придётся пойти тоже.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605470
    m_Localized: 'Sirin: Не хочу её потерять до того, как мы все умрём.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605471
    m_Localized: 'Sirin:'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605472
    m_Localized: Вы всё же выходили?
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605473
    m_Localized: Мне надо тебя проверить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605474
    m_Localized: 'Sirin: Да. Она нашла тело мужа.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605475
    m_Localized: 'Sirin: Он рассказывал ей, что всё будет хорошо, а потом убил себя, испугавшись настоящего конца.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605476
    m_Localized: 'Sirin: Мне кажется, она совсем лишилась сил.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605477
    m_Localized: 'Sirin: Теперь я буду за ней ухаживать, пока мы все не умрём.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605478
    m_Localized: 'Sirin: Тогда, наконец, не о чем будет переживать, нечего бояться, тревожиться, стесняться.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605479
    m_Localized: 'Sirin:'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605480
    m_Localized: Зубы
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605481
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605482
    m_Localized: Глаза
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605483
    m_Localized: Подмышки
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605484
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605485
    m_Localized: Уши
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605486
    m_Localized: 'Alkonost: У нашей семьи всегда были крепкие зубы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605487
    m_Localized: 'Alkonost: Я, когда была подростком, пыталась открыть пиво зубами.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605488
    m_Localized: 'Alkonost: Закончилось неудачно. Но научило за зубами ухаживать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605489
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605490
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605491
    m_Localized: 'Alkonost: Моя сестра не в состоянии сейчас о себе заботиться. Поэтому я – единственная, кто что-то делает руками.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605492
    m_Localized: 'Alkonost: А как ещё должны выглядеть руки человека, на котором ответственность за две жизни сразу?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605493
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605494
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605495
    m_Localized: 'Alkonost: Да, сестра часто плачет, но глаза у нас до сих пор очень похожи. Только взгляд у неё спокойнее.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605496
    m_Localized: 'Alkonost: И меня это тревожит.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605497
    m_Localized: 'Alkonost: Да, сестра часто плачет, но глаза у нас до сих пор очень похожи. Не красные, я имею ввиду.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605498
    m_Localized: 'Alkonost: Может, уже отплакала своё.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605499
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605500
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605501
    m_Localized: 'Alkonost: Я покажу. Но, прошу, не приставай к сестре, хорошо? Она и так слишком устала.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605502
    m_Localized: 'Alkonost: Вообще я брею, стараюсь ухаживать за собой.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605503
    m_Localized: 'Alkonost: Даже в такое сумасшедшее время.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605504
    m_Localized: 'Alkonost: Вообще я за собой слежу, но сейчас не взяла с собой бритву.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605505
    m_Localized: 'Alkonost: Да и в целом не до этого.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605506
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605507
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605508
    m_Localized: 'Alkonost: Нам и так досталось с сестрой в жизни. Оставь ты это ружьё.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605509
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605510
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605511
    m_Localized: 'Alkonost: Я недавно начала курить. Из-за таких, как ты.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605512
    m_Localized: 'Alkonost: Думаешь, тебе одному тяжело?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605513
    m_Localized: 'Alkonost: Думаешь, можешь тыкать ружьём в лицо кому угодно?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605514
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605515
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605516
    m_Localized: 'Alkonost: Какой смысл? Тебе взгляд показался слишком быстрым или пустым?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605517
    m_Localized: 'Alkonost: Какой смысл? Тебе взгляд показался слишком пустым?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605518
    m_Localized: 'Alkonost: Думаешь, ты выглядишь по-другому?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605519
    m_Localized: 'Alkonost: Лучше успокойся и не принимай эмоциональных решений. Я часто так сестре говорю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605520
    m_Localized: 'Alkonost: Жаль, что тебе тоже надо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605521
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605522
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605523
    m_Localized: 'Alkonost: Подожди, разве по новостям говорили, что ТАКИЕ подмышки – признак Гостя?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605524
    m_Localized: 'Alkonost: Подумай ещё, не делай глупостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605525
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605526
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605527
    m_Localized: 'Alkonost: Вот чем закончилась песнь жизни.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605528
    m_Localized: 'Alkonost: Горечью.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605529
    m_Localized: 'Alkonost: Жизнь всегда проверяла нас на крепость. Всегда было очень тяжело.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605530
    m_Localized: 'Alkonost: Сестра не выдержала, сдалась.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605531
    m_Localized: 'Alkonost: Я всё понимаю. Ты оказался в очень непростой ситуации.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605532
    m_Localized: 'Alkonost: Но если поддаваться панике, будешь ли ты отличаться от Гостей?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605533
    m_Localized: 'Alkonost: Что будет, если ты так и останешься обособленным от остальных?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605534
    m_Localized: 'Alkonost: Знаешь, меня всё заебло.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605535
    m_Localized: 'Alkonost: Я так хочу, чтобы можно было уже выдохнуть и не быть в постоянном страхе.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605536
    m_Localized: 'Alkonost: Но это всё продолжается, а конца как будто и не предвидится в ближайшее время.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605537
    m_Localized: 'Alkonost: Если честно, я и сама жутко напугана.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605538
    m_Localized: 'Alkonost: Что дальше? Гости исчезнут, или мы теперь всегда будем с ними делить наши города?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605539
    m_Localized: 'Sirin: Смотри.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605540
    m_Localized: 'Sirin: Вышибешь их мне?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605541
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605542
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605543
    m_Localized: 'Sirin: Сестра мне помогает.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605544
    m_Localized: 'Sirin: Но это бессмысленно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605545
    m_Localized: 'Sirin: Лучше бы…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605546
    m_Localized: 'Sirin: Дала мне умереть ещё тогда.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605547
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605548
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605549
    m_Localized: 'Sirin: Тут мы с сестрой похожи.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605550
    m_Localized: 'Sirin: Но она не признает пустоту в глазах.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605551
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605552
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605553
    m_Localized: 'Sirin: Сестра мне бреет подмышки. Ухаживает за мной.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605554
    m_Localized: 'Sirin: Похоже, делала это не зря.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605555
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605556
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605557
    m_Localized: 'Sirin: Так даже лучше.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605558
    m_Localized: 'Sirin: Вышиби из меня дух.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605559
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605560
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605561
    m_Localized: 'Sirin: Не надо этого.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605562
    m_Localized: 'Sirin: Смерть всё равно уже рядом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605563
    m_Localized: 'Sirin: Ты можешь просто оставить это мне.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605564
    m_Localized: 'Sirin: Дай ружьё.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605565
    m_Localized: 'Sirin: Я сама всё сделаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605566
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605567
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605568
    m_Localized: 'Sirin: Когда я сомкну глаза, пустота не исчезнет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605569
    m_Localized: 'Sirin: Она просто передастся тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605570
    m_Localized: 'Sirin: Нравится?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605571
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922846605572
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799616
    m_Localized: 'Sirin: Ну что?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799617
    m_Localized: 'Sirin: Нажмёшь заветную кнопку?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799618
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799619
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799620
    m_Localized: 'Sirin: Не хватило духу?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799621
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799622
    m_Localized: 'Sirin: Всё равно умрёшь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799623
    m_Localized: 'Sirin: Жаль.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799624
    m_Localized: 'Sirin: Может, в следующий раз.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799625
    m_Localized: 'Sirin: Жаль.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799626
    m_Localized: 'Sirin: Не подошла по признакам.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799627
    m_Localized: 'Sirin: Может, в следующий раз.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799628
    m_Localized: 'Sirin: Что, если мы просто готовимся быть поглощёнными чёрной дырой?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799629
    m_Localized: 'Sirin: Нас будет очень долго засасывать в горизонт событий.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799630
    m_Localized: 'Sirin: И мы никогда не увидим своей кончины.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799631
    m_Localized: 'Sirin: Вечная агония и предвкушение смерти.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799632
    m_Localized: 'Sirin: Неважно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799633
    m_Localized: 'Sirin: Я дождусь своего часа, значит.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799634
    m_Localized: 'Sirin: Моя песнь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799635
    m_Localized: 'Sirin: Но она предназначалась тебе!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799636
    m_Localized: 'Sirin: Как она прекрасна!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799637
    m_Localized: 'Widow: Ему нравились мои зубы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799638
    m_Localized: 'Widow: Правда, мне хотелось поставить брекеты.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799639
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799640
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799641
    m_Localized: 'Widow: Действительно, почему бы не застрелить ещё и меня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799642
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799643
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799644
    m_Localized: 'Widow: Может ли человек в этом новом мире плакать? Смеяться уже точно нельзя.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799645
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799646
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799647
    m_Localized: 'Widow: Ты ёбнулся?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799648
    m_Localized: 'Widow: Нет, скажи, ТЫ ЕБАНУТЫЙ?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799649
    m_Localized: 'Widow: Тебе эти черти скажут на сковороде плясать, ты первый побежишь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799650
    m_Localized: 'Widow: Ты... блять... слов нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799651
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799652
    m_Localized: 'Widow: Ну что? Ружьё ещё достань.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799653
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799654
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799655
    m_Localized: 'Widow: Ахуеть.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799656
    m_Localized: 'Widow: Ну нажми на курок. КЧС убили во мне душу, ты тело добей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799657
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799658
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799659
    m_Localized: 'Widow: Больше я не думаю о брекетах.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799660
    m_Localized: 'Widow: Пока ты не попросил показать зубы, я даже не вспоминала об этой мысли.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799661
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799662
    m_Localized: 'Widow: Нет, извини, я проосто очень устала.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799663
    m_Localized: 'Widow: Я срываюсь на всех вокруг. Но...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799664
    m_Localized: 'Widow: Никто не виноват. Кроме определённых ублюдков.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799665
    m_Localized: 'Widow: Не могу тебя понять. И не хочу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799666
    m_Localized: 'Widow: Унизить человека, который только недавно потерял...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799667
    m_Localized: 'Widow: Сейчас...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799668
    m_Localized: 'Widow: Уууф. Потом наставил ружьё.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799669
    m_Localized: 'Widow: И в итоге не убил.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799670
    m_Localized: 'Widow: Что это было? Твоя неуверенность? Не надо проявлять её так.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799671
    m_Localized: 'Fanatic: А ты попробуй стрельнуть! Правда защитит меня!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799672
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799673
    m_Localized: 'Fanatic: Ты ружьишко-то уберёшь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799674
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799675
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799676
    m_Localized: 'Fanatic: Ну да, тяжело-о-о-о без пива в руках.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799677
    m_Localized: 'Fanatic: Тя-же-ло-о-о-о-о.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799678
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799679
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799680
    m_Localized: 'Fanatic: Человек, к чему ты вот это делаешь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799681
    m_Localized: 'Fanatic: ОПОЛОУМЕЛИ, НЕВДУПЛЁНЫШИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799682
    m_Localized: 'Fanatic: За глаза уже не только обсуждают, но и стреляют...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799683
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799684
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799685
    m_Localized: 'Fanatic: Так, ну вот это явно лишнее уже!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799686
    m_Localized: 'Fanatic: Это не помогает нам с жизненной силой.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799687
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799688
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799689
    m_Localized: 'Fanatic: Подожди, а тебе мои руки не нравятся?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799690
    m_Localized: 'Fanatic: ПОЧЕМУ?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799691
    m_Localized: 'Fanatic: Скупердяй, невежа и мне хочется пива.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799692
    m_Localized: 'Fanatic: Говорят, в глазах правды нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799693
    m_Localized: 'Fanatic: Ну и что? Стреляться теперь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799694
    m_Localized: 'Fanatic: А, нет, подожди...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799695
    m_Localized: 'Fanatic: Как-то не так там было.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799696
    m_Localized: 'Fanatic: Ща, подожди.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799697
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799698
    m_Localized: 'Fanatic: Да и похуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799699
    m_Localized: 'Fanatic: Вот и правильно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799700
    m_Localized: 'Fanatic: Не застрелишь же ты Солнце!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799701
    m_Localized: 'Fanatic: А обо мне не беспокойся, я не обижаюсь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799702
    m_Localized: 'Fanatic: У тебя щедрыый запас живительной холодной влаги!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799703
    m_Localized: 'Fanatic: Вот ты каков, любитель шалостей!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799704
    m_Localized: 'Fanatic: Ну а что, ну понюхай, раз хочется.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799705
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799706
    m_Localized: 'Fanatic: Вот и результат ухода за собой.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799707
    m_Localized: 'Fanatic: Вот ты каков, любитель шалостей!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799708
    m_Localized: 'Fanatic: Ну а что, ну понюхай, раз хочется.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799709
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799710
    m_Localized: 'Fanatic: Вот и результат солнечной работы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799711
    m_Localized: 'Fanatic: Мы выделяем жизненно необходимую влагу, чтобы жизнь текла дальше!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799712
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799713
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799714
    m_Localized: 'Anxiety: Прямо как те Гости дома...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799715
    m_Localized: 'Anxiety: Извините, просто жуткая история. Сейчас покажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799716
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799717
    m_Localized: 'Anxiety: Я человек? Да? Скажите, что человек, пожалуйста!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799718
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799719
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799720
    m_Localized: 'Anxiety: Зачем же было просить показать, если всё равно достаёте ружьё?..'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799721
    m_Localized: 'Anxiety: Зачем унижать других?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799722
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799723
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799724
    m_Localized: 'Anxiety: А вообще это кошмар. Нигде нельзя чувствовать себя в безопасности.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799725
    m_Localized: 'Anxiety: Гости могут ворваться в дом. Безумец убьёт, потому что подумает, что ты какой-то не такой.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799726
    m_Localized: 'Anxiety: КАК ЖЕ СТРАШНО, ХОТЬ БЫ КТО МОГ СКАЗАТЬ, ЧТО ВСЁ БУДЕТ ХОРОШО!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799727
    m_Localized: 'Anxiety: Но как я оказалась Гостем по этому признаку? Почему?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799728
    m_Localized: 'Anxiety: Мне итак не повезло с телом...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799729
    m_Localized: 'Anxiety: Я вся скрюченная. Меня боятся на работе, я же вижу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799730
    m_Localized: 'Anxiety: Так, на прошлой неделе я ходила по поводу спины... вроде.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799731
    m_Localized: 'Anxiety: В это же время... я ходила к стоматологу?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799732
    m_Localized: 'Anxiety: Сколько же я потратила...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799733
    m_Localized: 'Scammer: Ёбаный в рот.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799734
    m_Localized: 'Scammer: Чёт ты не той темой занялся.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799735
    m_Localized: 'Scammer: Ты тут босс.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799736
    m_Localized: 'Scammer: Так а чё в итоге? Норм?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799737
    m_Localized: Отпустить
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799738
    m_Localized: Достать ружьё
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799739
    m_Localized: 'Scammer: Да подожди-подожди! Да, бля, один раз попробовал побриться, решил так дальше делать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799740
    m_Localized: 'Scammer: Только не говори никому. Ты ж не трепло, да?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799741
    m_Localized: 'Scammer: Да подожди-подожди! Ты бы ещё трусы попросил показать.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799742
    m_Localized: 'Scammer: Ну сам подумай, у нормального пацана не могут быть палёные подмышки.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799743
    m_Localized: Выстрелить
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799744
    m_Localized: Выслушать
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799745
    m_Localized: 'Scammer: Я знал, что ты ровный чел. Не станешь серьёзно на нормальных наезжать, хе-хе.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799746
    m_Localized: 'Scammer: Давай лучше чмошников напряжём?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799747
    m_Localized: 'Scammer: Не? Ну ладно. Потом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799748
    m_Localized: 'Scammer: Я понимаю, конечно, начнешь напрягаться из-за всяких там Гостей и прочего.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799749
    m_Localized: 'Scammer: Да и ради нас всё же это делаешь.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799750
    m_Localized: 'Scammer: Короче, не держу на тебя зла. От души.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799751
    m_Localized: 'Esenin: Чего нахуй? Ты дурак?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799752
    m_Localized: 'Esenin: КЧС мозги проели тебе?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799753
    m_Localized: 'Esenin: Или ты наебенился? Я думал, всё крепкое уже выпил.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799754
    m_Localized: 'Esenin: Ну не, если ты просишь, я тебе покажу!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799755
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799756
    m_Localized: 'Esenin: Получил, что хотел?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799757
    m_Localized: 'Esenin: Нанюхался от души?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799758
    m_Localized: 'Esenin: Спасибо, что в жопу мне не залез!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799759
    m_Localized: 'TV: Срочные новости!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799760
    m_Localized: 'TV: Сегодня в 6:28 утра на солнце произошёл мощный выброс энергии.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799761
    m_Localized: 'TV: Данная вспышка оказалась больше, чем прогнозировали учёные.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799762
    m_Localized: 'TV: Температура на улице достигла критической отметки.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799763
    m_Localized: 'TV: Власти объявили режим чрезвычайной ситуации.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799764
    m_Localized: 'TV: Мы просим всех граждан избегать выхода на улицу в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799765
    m_Localized: 'TV: Теперь переходим к…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799766
    m_Localized: 'TV: Минутку…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799767
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799768
    m_Localized: 'TV: В нашу студию только что поступило срочное сообщение о контактах с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799769
    m_Localized: 'TV: Очевидцы описывают их как существ, имитирующих внешний облик и поведение человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799770
    m_Localized: 'TV: Просим вас избегать контактов с Гостями. Из одного случая удалось выявить признак этих существ…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799771
    m_Localized: 'TV: Это идеальные белые зубы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799772
    m_Localized: 'TV: Показательным случаем можно считать произошедшее с одним из очевидцев.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799773
    m_Localized: 'TV: Он наткнулся на бездомного с идеальными белыми зубами, который оказался Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799774
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не выходите из дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799775
    m_Localized: 'TV: Далее прогноз погоды.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799776
    m_Localized: 'TV: Добрый день, в эфире прогноз погоды.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799777
    m_Localized: 'TV: В нашем регионе наступает жара, побившая прежний рекорд среднесуточной температуры.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799778
    m_Localized: 'TV: Как сообщают метеорологи, ожидается ещё большее повышение температуры.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799779
    m_Localized: 'TV: Кроме того, с повышением активности солнца днём ожидается усиление ультрафиолетового излучения.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799780
    m_Localized: 'TV: Для вашей же безопасности просим воздержаться от загара.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799781
    m_Localized: 'TV: Из-за высоких температур вы можете получить солнечный удар.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799782
    m_Localized: 'TV: Точно не известно, как пребывание под солнцем может отразиться на здоровье человека…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799783
    m_Localized: 'TV: Но во избежание ожогов третьей степени не выходите на улицу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799784
    m_Localized: 'TV: Солнезащитный крем, к сожалению, тут не поможет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799785
    m_Localized: 'TV: На этом всё. Далее вы увидите развлекательную передачу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799786
    m_Localized: 'TV: Вы видите грациозно танцующих балерин, пересекающих сцену сильными, но грациозными прыжками.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799787
    m_Localized: 'TV: Танец по телевизору, несмотря на изящество, навевает вам тревожные мысли.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799788
    m_Localized: 'TV: Вам кажется, будто вас пытаются отвлечь от происходящих событий.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799789
    m_Localized: 'TV: Мог бы хоть кто-то объяснить, что происходит на самом деле…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799790
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799791
    m_Localized: 'TV: Активность солнца не снижается, а уровень преступности незначительно вырос.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799792
    m_Localized: 'TV: По последним данным, число убийств за последнюю ночь превысило среднесуточные показатели.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799793
    m_Localized: 'TV: Эксперты полагают, что это связано с появлением Гостей и ростом тревоги в обществе.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799794
    m_Localized: 'TV: А теперь к новым сведениям – очевидцы выявили новый признак Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799795
    m_Localized: 'TV: Грязь под ногтями.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799796
    m_Localized: 'TV: По данным специалистов, этот признак помогает выявить Гостей, которые вылезают из земли.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799797
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799798
    m_Localized: 'TV: Далее репортаж про бледного маньяка. Но сперва реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799799
    m_Localized: 'TV: Сейчас вы ходите за продуктами так: Топ-топ-топ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799800
    m_Localized: 'TV: А теперь будете ходит так: Алло, хочу заказать еду.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799801
    m_Localized: 'TV: Доставка продуктов Фор Рест. Звоните по номеру: Х-ХХ-ХХХ и еда придёт к вам уже следующим вечером.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799802
    m_Localized: 'TV: Фор Рест: Вкусный отдых у вас дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799803
    m_Localized: 'TV: На улицах города появился бледный маньяк.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799804
    m_Localized: 'TV: Из показаний очевидцев удалось выяснить, что его жертв объединяет одно – все были одинокими людьми.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799805
    m_Localized: 'TV: При этом, прежде чем совершить убийство, маньяк общается с жертвой, после чего нападает.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799806
    m_Localized: 'TV: Из показаний очевидцев удалось составить фоторобот подозреваемого.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799807
    m_Localized: 'TV: Это высокий бледный мужчина среднего возраста с чёрными волосами. На нём только штаны, выше пояса одежды нет. Худощавого телосложения.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799808
    m_Localized: 'TV: Некоторые сообщают, что на его тело надета кожа другого человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799809
    m_Localized: 'TV: Подтверждения этой информации нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799810
    m_Localized: 'TV: Если увидите это лицо, не открывайте ему  дверь и говорите, что вы не один в доме.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799811
    m_Localized: 'TV: На этом всё.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799812
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799813
    m_Localized: 'TV: Аномальная жара продолжает усиливаться, а нашествие Гостей не прекращается.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799814
    m_Localized: 'TV: Для решения возникшей ситуации правительство организовало специальную службу…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799815
    m_Localized: 'TV: Комитет по Чрезвычайным Ситуациям, сокращённо – КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799816
    m_Localized: 'TV: Её сотрудников можно узнать по жёлтым костюмам химической защиты и противогазам.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799817
    m_Localized: 'TV: Несмотря на недавнее начало работы, комитет уже выявил новый признак Гостей…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799818
    m_Localized: 'TV: Кроваво-красные глаза.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799819
    m_Localized: 'TV: По нашим данным, КЧС выявили этот признак в результате обследования задержанных Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799820
    m_Localized: 'TV: Существа получают травмы глаза, так как глаза существ воспаляются и краснеют из-за повышенной чувствительности к свету.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799821
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799822
    m_Localized: 'TV: Далее репортаж про КЧС. Но сперва небольшая реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799823
    m_Localized: 'TV: Смятение, страх и горе. И всему виной Гости…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799824
    m_Localized: 'TV: Но в час нужды, когда слёз пролиты реки…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799825
    m_Localized: 'TV: НА ПОМОЩЬ ПРИДУТ ОНИ! СОТРУДНИКИ КЧС!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799826
    m_Localized: 'TV: Отважные герои из Комитета по Чрезвычайным Ситуациям защитят нас от нашествия Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799827
    m_Localized: 'TV: Уже сегодня комитет выявил 27 000 опасных существ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799828
    m_Localized: 'TV: Помните, вы можете помочь комитету, сообщая о подозрительном поведении окружающих.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799829
    m_Localized: 'TV: Для этого используйте приглашение на посещение КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799830
    m_Localized: 'TV: И если у вас возникнут сомнения, не Гость ли вы, звоните по горячей линии: Х-ХХ-ХХХ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799831
    m_Localized: 'TV: Помогая КЧС, вы помогаете в борьбе с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799832
    m_Localized: 'TV: КЧС? Что за организация? И для чего её сформировали?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799833
    m_Localized: 'TV: Комитет по Чрезвычайным Ситуациям – недавно сформированная специальная служба, созданная для ослабления возникшего кризиса.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799834
    m_Localized: 'TV: Они помогут решить проблему с нашествием Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799835
    m_Localized: 'TV: Точно неизвестно, что именно предпримет комитет…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799836
    m_Localized: 'TV: Но можно с уверенностью сказать, что наша судьба в надёжных руках…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799837
    m_Localized: 'TV: Поскольку комитет состоит из экспертов разных областей, включая заслуженных учёных.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799838
    m_Localized: 'TV: Если к вам на порог придёт сотрудник КЧС, рекомендуем содействовать ему и следовать указаниям.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799839
    m_Localized: 'TV: Помните, что помогая КЧС, вы помогаете в борьбе с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799840
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799841
    m_Localized: 'TV: КЧС принял новые меры для разрешения ситуации с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799842
    m_Localized: 'TV: Организованы карантинные зоны для людей с потенциально-опасным статусом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799843
    m_Localized: 'TV: Также КЧС выявил новый признак Гостя в результате экспериментов с задержанными…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799844
    m_Localized: 'TV: Подмышки без волос.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799845
    m_Localized: 'TV: Как сообщает КЧС, признак связан с тем, что у Гостей нет волосяного покрова в этом месте.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799846
    m_Localized: 'TV: Комитет просит граждан отнестись с пониманием к проверкам и сопровождением в карантинные зоны.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799847
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799848
    m_Localized: 'TV: Далее репортаж про КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799849
    m_Localized: 'TV: У КЧС есть предположение, что феномен Гостей имеет инфекционную природу или другую биологическую угрозу.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799850
    m_Localized: 'TV: Поэтому необходимо докладывать о подозрительных людях и изолировать их.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799851
    m_Localized: 'TV: Если у вас нет возможности сдать Гостя в карантинную зону сразу, выдайте ему специальное требование о явке в КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799852
    m_Localized: 'TV: При следующем обходе сотрудник заберёт человека с этой бумагой на обследование.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799853
    m_Localized: 'TV: На этом всё. А теперь реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799854
    m_Localized: 'TV: Жара на улице не помеха.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799855
    m_Localized: 'TV: Когда в руках есть Энержека.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799856
    m_Localized: 'TV: Освежающий энергетик, утоляющий жажду быстрее и эффективнее воды.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799857
    m_Localized: 'TV: Теперь и в ассортименте доставки Фор Рест. Закажите еду по номеру: Х-ХХ-ХХХ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799858
    m_Localized: 'Window: В чистом поле стоит дом вашего соседа.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799859
    m_Localized: 'Window: В окнах темно, и похоже, его семья сейчас спит.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799860
    m_Localized: 'Window: На тропинке, что идёт сквозь сквозь поля, стоит худая дворняга.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799861
    m_Localized: 'Window: Она жалобно смотрит по сторонам в попытке найти какую-нибудь еду.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799862
    m_Localized: 'Window: На улице валяются несколько сильно выпивших пьянчуг.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799863
    m_Localized: 'Window: Несмотря на то, что они лежат на холодной земле, кажется, синяки крепко спят. Им сейчас хорошо.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799864
    m_Localized: 'Window: Вдалеке стоит дом соседа, что сейчас гостит у вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799865
    m_Localized: 'Window: В окнах горит свет, и кажется, семья ждёт, пока он уйдёт от вас обратно домой.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799866
    m_Localized: 'Window: Вы видите, как за окном у поля проводят время несколько подростков.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799867
    m_Localized: 'Window: Они беззаботно сидят и о чём-то болтают, не обращая на вас внимания.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799868
    m_Localized: 'Window: На улице гробовая тишина.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799869
    m_Localized: 'Window: Никого нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799870
    m_Localized: 'Window: Даже пьяницы решили не появляться на улице.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799871
    m_Localized: 'Window: Они кого-то боятся?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799872
    m_Localized: 'Window: За окном стоит сосед и его дочка.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799873
    m_Localized: 'Window: Они весело играют, пытаясь забыть о происходящем ужасе…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799874
    m_Localized: 'Window: Хотя бы на миг.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799875
    m_Localized: 'Window: На земле лежат тела подростков.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799876
    m_Localized: 'Window: Кто-то убил их.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799877
    m_Localized: 'Window: Кажется, совсем недавно, ведь кровь ещё не успела засохнуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799878
    m_Localized: 'Window: На тропе стоит бледный, как сама смерть, человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799879
    m_Localized: 'Window: На его коже странные складки.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799880
    m_Localized: 'Window: Кажется, эта кожа ему не по размеру.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799881
    m_Localized: 'Window: Отсюда не видно его глаз, но чувствуется, как он сверлит вас своим взглядом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799882
    m_Localized: 'Window: Вы ощущаете страх и молите бога, чтобы жуткий Гость обошёл дом стороной.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799883
    m_Localized: 'Window: У соседского дома стоит небольшая группа сотрудников КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799884
    m_Localized: 'Window: Интересно, о чём они разговаривают?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922850799885
    m_Localized: 'Window: Может, они берут образцы почвы?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993920
    m_Localized: 'Window: Или ищут место для развёртывания базы?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993921
    m_Localized: 'Window: На земле лежат сгоревшие дотла тела подростков.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993922
    m_Localized: 'Window: Кажется, они пролежали здесь весь день.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993923
    m_Localized: 'Window: Двое сотрудников КЧС стоят рядом с телами и что-то записывают.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993924
    m_Localized: 'Window: Хорошо, что появились те, кто могут убрать тела.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993925
    m_Localized: 'Window: Страшно представить, какая зараза может появиться, если гниющие тела не будут убирать с улиц.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993926
    m_Localized: 'Window: За окном стоит группа вооружённых солдат.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993927
    m_Localized: 'Window: Видимо, это небольшой отряд, высланный сюда из города для обеспечения безопасности КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993928
    m_Localized: 'Window: До вас долетают лишь обрывки фраз про бледного мужчину с голым торсом.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993929
    m_Localized: 'Window: Может, они хотят выследить того жуткого Гостя?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993930
    m_Localized: 'Window: Соседский дом, что недавно покрасили в белое, сгорел дотла и теперь абсолютно чёрный.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993931
    m_Localized: 'Window: Похоже, пожар утих совсем недавно.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993932
    m_Localized: 'Window: Неужели, кто-то поджёг его намеренно?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993933
    m_Localized: 'Window: Что произошло с соседской семьёй?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993934
    m_Localized: 'Window: Выжил ли кто-нибудь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993935
    m_Localized: 'Window: Вашу голову переполнили тревожные мысли и вас охватило чувство непонимания и беспомощности.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993936
    m_Localized: 'Window: Бледный жуткий мужчина стоит на дороге и улыбается.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993937
    m_Localized: 'Window: У него в руке чья-то оторванная голова в каске.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993938
    m_Localized: 'Window: Это голова солдата с застывшей на лице гримасой ужаса.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993939
    m_Localized: 'Window: Интересно, чего он больше испугался: бледного гостя, или неминуемой кончины?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993940
    m_Localized: 'Window: Весь отряд солдат, который был здесь вчера, мёртв.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993941
    m_Localized: 'Window: Здесь была настоящая бойня.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993942
    m_Localized: 'Window: Тела разбросаны по всей улице, и у одного из тел отсутствует голова.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993943
    m_Localized: 'Window: Неужели их всех убил тот бледный жутки незнакомец?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993944
    m_Localized: 'Radio: — Алло, это диспетчер службы спасения. Чем вам помочь? — Люди… они горят.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993945
    m_Localized: 'Radio: — Опишите что вы видите? Пожар? — Нет, это солнце. Они… они сгорают на солнце.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993946
    m_Localized: 'Radio: — Не выходите из дома до того, как стемнеет. — Нет, ночью ходит он. Тощий бледный… это не человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993947
    m_Localized: 'Radio: А сейчас в эфире наша новая передача “Да, я человек”.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993948
    m_Localized: 'Radio: Цель проста: вы присылаете ваши фотографии, а мы смотрим, кто же вы на самом деле.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993949
    m_Localized: 'Radio: Присылайте на нашу почту свои фотографии и узнайте же, кто вы.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993950
    m_Localized: 'Radio: Но, пожалуйста, не шлите ничего, кроме глаз, зубов и ногтей. Ничего другого мы не принимаем.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993951
    m_Localized: 'Radio: У вас покраснели глаза? Побелели зубы? Под ногтями появилась грязь?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993952
    m_Localized: 'Radio: В вас вселился злой дух: Гостевой!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993953
    m_Localized: 'Radio: Не позвольте этой гнили завладеть вашим телом! Срочно звоните нашим экспертам: Х-ХХ-ХХХ.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993954
    m_Localized: 'Radio: Они прогонят злой дух, очистят ваше тело от пагубной ауры и установят вам семь степеней защиты.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993955
    m_Localized: 'Radio: Добрый день, дорогие слушатели. В эфире передача “Я хочу верить”. Здесь мы раскрываем тайны и заговоры правительства.'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993956
    m_Localized: 'Radio: Сегодня мы расскажем всю правду про Гостей. А в гостях у нас уважаемый сотрудник НИИ, доктор наук…'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993957
    m_Localized: 'Radio: Погодите, что!? Он не придёт?'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993958
    m_Localized: 'Radio: Как это у него украли все документы? Там же КИЛОТОННЫ ИНФОРМАЦИИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 2922854993959
    m_Localized: 'Radio: Проклятье, я знал, что нам не позволят вещать правду. Мать их…'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095057694720
    m_Localized: 'TV: Срочные новости!'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443456
    m_Localized: 'TV: Сегодня в 6:28 утра на солнце произошёл мощный выброс энергии.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443457
    m_Localized: 'TV: Данная вспышка оказалась больше, чем прогнозировали учёные.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443458
    m_Localized: 'TV: Температура на улице достигла критической отметки.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443459
    m_Localized: 'TV: Власти объявили режим чрезвычайной ситуации.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443460
    m_Localized: 'TV: Мы просим всех граждан избегать выхода на улицу в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443461
    m_Localized: 'TV: Теперь переходим к…'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443462
    m_Localized: 'TV: Минутку…'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443463
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443464
    m_Localized: 'TV: В нашу студию только что поступило срочное сообщение о контактах с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443465
    m_Localized: 'TV: Очевидцы описывают их как существ, имитирующих внешний облик и поведение человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443466
    m_Localized: 'TV: Просим вас избегать контактов с Гостями. Из одного случая удалось выявить признак этих существ…'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443467
    m_Localized: 'TV: Это идеальные белые зубы.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443468
    m_Localized: 'TV: Показательным случаем можно считать произошедшее с одним из очевидцев.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443469
    m_Localized: 'TV: Он наткнулся на бездомного с идеальными белыми зубами, который оказался Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443470
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не выходите из дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443471
    m_Localized: 'TV: Далее прогноз погоды.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443472
    m_Localized: 'TV: Добрый день, в эфире прогноз погоды.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443473
    m_Localized: 'TV: В нашем регионе наступает жара, побившая прежний рекорд среднесуточной температуры.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443474
    m_Localized: 'TV: Как сообщают метеорологи, ожидается ещё большее повышение температуры.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443475
    m_Localized: 'TV: Кроме того, с повышением активности солнца днём ожидается усиление ультрафиолетового излучения.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443476
    m_Localized: 'TV: Для вашей же безопасности просим воздержаться от загара.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443477
    m_Localized: 'TV: Из-за высоких температур вы можете получить солнечный удар.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443478
    m_Localized: 'TV: Точно не известно, как пребывание под солнцем может отразиться на здоровье человека…'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443479
    m_Localized: 'TV: Но во избежание ожогов третьей степени не выходите на улицу.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443480
    m_Localized: 'TV: Солнезащитный крем, к сожалению, тут не поможет.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443481
    m_Localized: 'TV: На этом всё. Далее вы увидите развлекательную передачу.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443482
    m_Localized: 'TV: Вы видите грациозно танцующих балерин, пересекающих сцену сильными, но грациозными прыжками.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443483
    m_Localized: 'TV: Танец по телевизору, несмотря на изящество, навевает вам тревожные мысли.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443484
    m_Localized: 'TV: Вам кажется, будто вас пытаются отвлечь от происходящих событий.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443485
    m_Localized: 'TV: Мог бы хоть кто-то объяснить, что происходит на самом деле…'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443486
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443487
    m_Localized: 'TV: Активность солнца не снижается, а уровень преступности незначительно вырос.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443488
    m_Localized: 'TV: По последним данным, число убийств за последнюю ночь превысило среднесуточные показатели.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443489
    m_Localized: 'TV: Эксперты полагают, что это связано с появлением Гостей и ростом тревоги в обществе.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443490
    m_Localized: 'TV: А теперь к новым сведениям – очевидцы выявили новый признак Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443491
    m_Localized: 'TV: Грязь под ногтями.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443492
    m_Localized: 'TV: По данным специалистов, этот признак помогает выявить Гостей, которые вылезают из земли.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443493
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443494
    m_Localized: 'TV: Далее репортаж про бледного маньяка. Но сперва реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443495
    m_Localized: 'TV: Сейчас вы ходите за продуктами так: Топ-топ-топ.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443496
    m_Localized: 'TV: А теперь будете ходит так: Алло, хочу заказать еду.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443497
    m_Localized: 'TV: Доставка продуктов Фор Рест. Звоните по номеру: Х-ХХ-ХХХ и еда придёт к вам уже следующим вечером.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443498
    m_Localized: 'TV: Фор Рест: Вкусный отдых у вас дома.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443499
    m_Localized: 'TV: На улицах города появился бледный маньяк.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443500
    m_Localized: 'TV: Из показаний очевидцев удалось выяснить, что его жертв объединяет одно – все были одинокими людьми.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443501
    m_Localized: 'TV: При этом, прежде чем совершить убийство, маньяк общается с жертвой, после чего нападает.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443502
    m_Localized: 'TV: Из показаний очевидцев удалось составить фоторобот подозреваемого.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443503
    m_Localized: 'TV: Это высокий бледный мужчина среднего возраста с чёрными волосами. На нём только штаны, выше пояса одежды нет. Худощавого телосложения.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443504
    m_Localized: 'TV: Некоторые сообщают, что на его тело надета кожа другого человека.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443505
    m_Localized: 'TV: Подтверждения этой информации нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443506
    m_Localized: 'TV: Если увидите это лицо, не открывайте ему  дверь и говорите, что вы не один в доме.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443507
    m_Localized: 'TV: На этом всё.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443508
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443509
    m_Localized: 'TV: Аномальная жара продолжает усиливаться, а нашествие Гостей не прекращается.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443510
    m_Localized: 'TV: Для решения возникшей ситуации правительство организовало специальную службу…'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443511
    m_Localized: 'TV: Комитет по Чрезвычайным Ситуациям, сокращённо – КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443512
    m_Localized: 'TV: Её сотрудников можно узнать по жёлтым костюмам химической защиты и противогазам.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443513
    m_Localized: 'TV: Несмотря на недавнее начало работы, комитет уже выявил новый признак Гостей…'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443514
    m_Localized: 'TV: Кроваво-красные глаза.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443515
    m_Localized: 'TV: По нашим данным, КЧС выявили этот признак в результате обследования задержанных Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443516
    m_Localized: 'TV: Существа получают травмы глаза, так как глаза существ воспаляются и краснеют из-за повышенной чувствительности к свету.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443517
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443518
    m_Localized: 'TV: Далее репортаж про КЧС. Но сперва небольшая реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443519
    m_Localized: 'TV: Смятение, страх и горе. И всему виной Гости…'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443520
    m_Localized: 'TV: Но в час нужды, когда слёз пролиты реки…'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443521
    m_Localized: 'TV: НА ПОМОЩЬ ПРИДУТ ОНИ! СОТРУДНИКИ КЧС!'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443522
    m_Localized: 'TV: Отважные герои из Комитета по Чрезвычайным Ситуациям защитят нас от нашествия Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443523
    m_Localized: 'TV: Уже сегодня комитет выявил 27 000 опасных существ.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443524
    m_Localized: 'TV: Помните, вы можете помочь комитету, сообщая о подозрительном поведении окружающих.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443525
    m_Localized: 'TV: Для этого используйте приглашение на посещение КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443526
    m_Localized: 'TV: И если у вас возникнут сомнения, не Гость ли вы, звоните по горячей линии: Х-ХХ-ХХХ.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443527
    m_Localized: 'TV: Помогая КЧС, вы помогаете в борьбе с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443528
    m_Localized: 'TV: КЧС? Что за организация? И для чего её сформировали?'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443529
    m_Localized: 'TV: Комитет по Чрезвычайным Ситуациям – недавно сформированная специальная служба, созданная для ослабления возникшего кризиса.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443530
    m_Localized: 'TV: Они помогут решить проблему с нашествием Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443531
    m_Localized: 'TV: Точно неизвестно, что именно предпримет комитет…'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443532
    m_Localized: 'TV: Но можно с уверенностью сказать, что наша судьба в надёжных руках…'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443533
    m_Localized: 'TV: Поскольку комитет состоит из экспертов разных областей, включая заслуженных учёных.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443534
    m_Localized: 'TV: Если к вам на порог придёт сотрудник КЧС, рекомендуем содействовать ему и следовать указаниям.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443535
    m_Localized: 'TV: Помните, что помогая КЧС, вы помогаете в борьбе с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443536
    m_Localized: 'TV: Добрый день, в эфире новости.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443537
    m_Localized: 'TV: КЧС принял новые меры для разрешения ситуации с Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443538
    m_Localized: 'TV: Организованы карантинные зоны для людей с потенциально-опасным статусом.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443539
    m_Localized: 'TV: Также КЧС выявил новый признак Гостя в результате экспериментов с задержанными…'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443540
    m_Localized: 'TV: Подмышки без волос.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443541
    m_Localized: 'TV: Как сообщает КЧС, признак связан с тем, что у Гостей нет волосяного покрова в этом месте.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443542
    m_Localized: 'TV: Комитет просит граждан отнестись с пониманием к проверкам и сопровождением в карантинные зоны.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443543
    m_Localized: 'TV: На этом всё. Сохраняйте спокойствие и не покидайте дома в дневное время.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443544
    m_Localized: 'TV: Далее репортаж про КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443545
    m_Localized: 'TV: У КЧС есть предположение, что феномен Гостей имеет инфекционную природу или другую биологическую угрозу.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443546
    m_Localized: 'TV: Поэтому необходимо докладывать о подозрительных людях и изолировать их.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443547
    m_Localized: 'TV: Если у вас нет возможности сдать Гостя в карантинную зону сразу, выдайте ему специальное требование о явке в КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443548
    m_Localized: 'TV: При следующем обходе сотрудник заберёт человека с этой бумагой на обследование.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443549
    m_Localized: 'TV: На этом всё. А теперь реклама.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443550
    m_Localized: 'TV: Жара на улице не помеха.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443551
    m_Localized: 'TV: Когда в руках есть Энержека.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443552
    m_Localized: 'TV: Освежающий энергетик, утоляющий жажду быстрее и эффективнее воды.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443553
    m_Localized: 'TV: Теперь и в ассортименте доставки Фор Рест. Закажите еду по номеру: Х-ХХ-ХХХ.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443554
    m_Localized: 'Window: В чистом поле стоит дом вашего соседа.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443555
    m_Localized: 'Window: В окнах темно, и похоже, его семья сейчас спит.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443556
    m_Localized: 'Window: На тропинке, что идёт сквозь сквозь поля, стоит худая дворняга.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443557
    m_Localized: 'Window: Она жалобно смотрит по сторонам в попытке найти какую-нибудь еду.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443558
    m_Localized: 'Window: На улице валяются несколько сильно выпивших пьянчуг.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443559
    m_Localized: 'Window: Несмотря на то, что они лежат на холодной земле, кажется, синяки крепко спят. Им сейчас хорошо.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443560
    m_Localized: 'Window: Вдалеке стоит дом соседа, что сейчас гостит у вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443561
    m_Localized: 'Window: В окнах горит свет, и кажется, семья ждёт, пока он уйдёт от вас обратно домой.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443562
    m_Localized: 'Window: Вы видите, как за окном у поля проводят время несколько подростков.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443563
    m_Localized: 'Window: Они беззаботно сидят и о чём-то болтают, не обращая на вас внимания.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443564
    m_Localized: 'Window: На улице гробовая тишина.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443565
    m_Localized: 'Window: Никого нет.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443566
    m_Localized: 'Window: Даже пьяницы решили не появляться на улице.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443567
    m_Localized: 'Window: Они кого-то боятся?'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443568
    m_Localized: 'Window: За окном стоит сосед и его дочка.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443569
    m_Localized: 'Window: Они весело играют, пытаясь забыть о происходящем ужасе…'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443570
    m_Localized: 'Window: Хотя бы на миг.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443571
    m_Localized: 'Window: На земле лежат тела подростков.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443572
    m_Localized: 'Window: Кто-то убил их.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443573
    m_Localized: 'Window: Кажется, совсем недавно, ведь кровь ещё не успела засохнуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443574
    m_Localized: 'Window: На тропе стоит бледный, как сама смерть, человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443575
    m_Localized: 'Window: На его коже странные складки.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443576
    m_Localized: 'Window: Кажется, эта кожа ему не по размеру.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443577
    m_Localized: 'Window: Отсюда не видно его глаз, но чувствуется, как он сверлит вас своим взглядом.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443578
    m_Localized: 'Window: Вы ощущаете страх и молите бога, чтобы жуткий Гость обошёл дом стороной.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443579
    m_Localized: 'Window: У соседского дома стоит небольшая группа сотрудников КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443580
    m_Localized: 'Window: Интересно, о чём они разговаривают?'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443581
    m_Localized: 'Window: Может, они берут образцы почвы?'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443582
    m_Localized: 'Window: Или ищут место для развёртывания базы?'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443583
    m_Localized: 'Window: На земле лежат сгоревшие дотла тела подростков.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443584
    m_Localized: 'Window: Кажется, они пролежали здесь весь день.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443585
    m_Localized: 'Window: Двое сотрудников КЧС стоят рядом с телами и что-то записывают.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443586
    m_Localized: 'Window: Хорошо, что появились те, кто могут убрать тела.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443587
    m_Localized: 'Window: Страшно представить, какая зараза может появиться, если гниющие тела не будут убирать с улиц.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443588
    m_Localized: 'Window: За окном стоит группа вооружённых солдат.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443589
    m_Localized: 'Window: Видимо, это небольшой отряд, высланный сюда из города для обеспечения безопасности КЧС.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443590
    m_Localized: 'Window: До вас долетают лишь обрывки фраз про бледного мужчину с голым торсом.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443591
    m_Localized: 'Window: Может, они хотят выследить того жуткого Гостя?'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443592
    m_Localized: 'Window: Соседский дом, что недавно покрасили в белое, сгорел дотла и теперь абсолютно чёрный.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443593
    m_Localized: 'Window: Похоже, пожар утих совсем недавно.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443594
    m_Localized: 'Window: Неужели, кто-то поджёг его намеренно?'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443595
    m_Localized: 'Window: Что произошло с соседской семьёй?'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443596
    m_Localized: 'Window: Выжил ли кто-нибудь?'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443597
    m_Localized: 'Window: Вашу голову переполнили тревожные мысли и вас охватило чувство непонимания и беспомощности.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443598
    m_Localized: 'Window: Бледный жуткий мужчина стоит на дороге и улыбается.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443599
    m_Localized: 'Window: У него в руке чья-то оторванная голова в каске.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443600
    m_Localized: 'Window: Это голова солдата с застывшей на лице гримасой ужаса.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443601
    m_Localized: 'Window: Интересно, чего он больше испугался: бледного гостя, или неминуемой кончины?'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443602
    m_Localized: 'Window: Весь отряд солдат, который был здесь вчера, мёртв.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443603
    m_Localized: 'Window: Здесь была настоящая бойня.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443604
    m_Localized: 'Window: Тела разбросаны по всей улице, и у одного из тел отсутствует голова.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443605
    m_Localized: 'Window: Неужели их всех убил тот бледный жутки незнакомец?'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443606
    m_Localized: 'Radio: — Алло, это диспетчер службы спасения. Чем вам помочь? — Люди… они горят.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443607
    m_Localized: 'Radio: — Опишите что вы видите? Пожар? — Нет, это солнце. Они… они сгорают на солнце.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443608
    m_Localized: 'Radio: — Не выходите из дома до того, как стемнеет. — Нет, ночью ходит он. Тощий бледный… это не человек.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443609
    m_Localized: 'Radio: А сейчас в эфире наша новая передача “Да, я человек”.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443610
    m_Localized: 'Radio: Цель проста: вы присылаете ваши фотографии, а мы смотрим, кто же вы на самом деле.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443611
    m_Localized: 'Radio: Присылайте на нашу почту свои фотографии и узнайте же, кто вы.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443612
    m_Localized: 'Radio: Но, пожалуйста, не шлите ничего, кроме глаз, зубов и ногтей. Ничего другого мы не принимаем.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443613
    m_Localized: 'Radio: У вас покраснели глаза? Побелели зубы? Под ногтями появилась грязь?'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443614
    m_Localized: 'Radio: В вас вселился злой дух: Гостевой!'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443615
    m_Localized: 'Radio: Не позвольте этой гнили завладеть вашим телом! Срочно звоните нашим экспертам: Х-ХХ-ХХХ.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443616
    m_Localized: 'Radio: Они прогонят злой дух, очистят ваше тело от пагубной ауры и установят вам семь степеней защиты.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443617
    m_Localized: 'Radio: Добрый день, дорогие слушатели. В эфире передача “Я хочу верить”. Здесь мы раскрываем тайны и заговоры правительства.'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443618
    m_Localized: 'Radio: Сегодня мы расскажем всю правду про Гостей. А в гостях у нас уважаемый сотрудник НИИ, доктор наук…'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443619
    m_Localized: 'Radio: Погодите, что!? Он не придёт?'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443620
    m_Localized: 'Radio: Как это у него украли все документы? Там же КИЛОТОННЫ ИНФОРМАЦИИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 10536095095443621
    m_Localized: 'Radio: Проклятье, я знал, что нам не позволят вещать правду. Мать их…'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
