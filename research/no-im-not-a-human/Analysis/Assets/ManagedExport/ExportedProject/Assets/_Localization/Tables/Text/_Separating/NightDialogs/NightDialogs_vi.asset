%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_vi
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: e2adf5c0928e69a42a85516c84d58249, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: Này *khụ khụ*.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: Chú cho anh vào trong được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: Anh là ai thế?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: Anh bị làm sao vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: 'Firefighter: Anh là *khụ* lính cứu hỏa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: 'Firefighter: Trưa nay đi dập cháy rừng, anh bị phơi nắng.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: 'Firefighter: May mà khói nó đặc, chứ không thì bọn anh bị đốt thành tro rồi. Nhưng mà *khụ* chẳng khá hơn là mấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: 'Firefighter: Mấy cái cây... *khụ khụ* bùng lên như diêm bén lửa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: Cả đời anh chưa từng thấy cảnh nào như thế.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: 'Firefighter: Xác động vật còn bốc khói xèo xèo nằm vương vãi khắp rừng.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: Sao anh không đến bệnh viện đi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: Anh tính làm gì tiếp?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: 'Firefighter: Trưa nay đi dập cháy rừng *khụ khụ* anh bị phơi nắng.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: Cả đội chỉ còn mình anh sống sót.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: 'Firefighter: Những người còn lại, thì... *khụ* lão sếp không chịu cho họ rời đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: Giờ thì cả lũ nằm lại đấy vĩnh viễn luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: Sao anh không đến bệnh viện đi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: Anh tính làm gì tiếp?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: 'Firefighter: Bệnh viện hả? Làm gì còn cái bệnh viện nào nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: Cảm ơn chú *khụ*.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: Êêê bạn hiền!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: 'Wheelchair: Lâu quá hổng gặp, mày khỏe hôn?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: ...Tôi có quen cậu không nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: Cậu là ai vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: 'Wheelchair: Ủa... Mày hổng nhớ tao hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: Tụi mình...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: 'Wheelchair: Từ từ, giọng mày nghe khác hồi xưa...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: Mày ở đây từ hồi nào dị?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: Nhà này là nhà tôi. Gia đình tôi sống ở đây từ đó giờ
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: Nhầm nhà rồi ông tướng ơi
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: Ủa, ông hổng phải...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: Ông hổng phải quỷ bạn tui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: Ông ở đây lâu chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: Nhà này là nhà tôi. Gia đình tôi sống ở đây từ đó giờ
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: Nhầm nhà rồi ông tướng ơi
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: Giỡn hoài ba.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: 'Wheelchair: Cả đời tui chưa bao giờ nhớ lộn! Trí nhớ tui dai như quỷ dị đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: 'Wheelchair: Chắc kèo là khứa bạn tui sống ở đây nha... À thì hồi xưa là vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: 'Wheelchair: Thôi mà, tui đẩy cái xe lăn này mệt thí mẹ mới tới được đây đó. Ông cho tui vô với coi!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: Ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: Giỡn hoài ba, làm gì có...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: Chời...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: Chết cha...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: Chắc tui nhớ lộn thiệt rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: 'Wheelchair: Thôi mà, tui đẩy cái xe lăn này mệt thí mẹ mới tới được đây đó. Ông cho tui vô với coi!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: Ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: Ngon lành cành đào! Phải dị chớ!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: Nhà ông rộng dữ nghen. Đua một chuyến hông bồ tèo? 3... 2... 1... XUẤT PHÁT!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: 'Wheelchair: Đi chỗ khác? Cái gì vậy cha nội?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: 'Wheelchair: Mày muốn tao... biến mẹ đi hả?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: 'Wheelchair: Đụ má tao lăn cái xe đi liền. Đồ chó điên!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: 'Mother: Cái thằng quỷ này! Đứng yên cho mẹ coi!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: 'Mother: Chào em. Cho chị nhờ xíu được hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: Có chuyện gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: Chị muốn nhờ tôi cái gì?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: 'Mother: Chị mệt lắm rồi. Chỉ muốn kiếm chỗ nào ổn ổn để chợp mắt mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: Nhà chị hồi trước có tới năm đứa lận. Mà giờ còn mỗi đứa này thôi à.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: 'Mother: Chồng chị cũng biến đâu mất dạng luôn. Hổng biết thằng chả bị chuyện gì hay cố tình bỏ vợ con mà đi nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: 'Mother: Thôi kệ đi. Giờ chị chỉ muốn nằm ngủ mấy giấc cho đã đời.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: Mấy đứa kia của chị đâu hết rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: Con của chị chết rồi à?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: 'Mother: Mấy bữa nay chị thiếu ngủ quá, chân tay rã rời hết luôn rồi. Em cho chị vô ngủ mấy giấc với.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: 'Mother: Nhà chị đáng ra có tới năm đứa lận. Mà giờ còn mỗi thằng nhỏ này thôi à.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: 'Mother: Chị đang hổng biết đường đâu mà tìm mấy đứa kia nữa. Thôi tạm thời chỉ muốn nghỉ ngơi chợp mắt xíu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: Mấy đứa kia của chị đâu hết rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: Con của chị chết rồi à?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: 'Mother: Chị cũng hổng biết nữa. Có khi ba tụi nó mang đi hết rồi. Chị tính đi tới nhà thằng chả mà giờ mệt quá đi hông nổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: 'Mother: Ờ thì hai vợ chồng cãi lộn cũng nhiều, tại tính chồng chị nó mất nết lắm em, sao mà hông chửi nhau cho được.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: 'Mother: Mà thôi kệ chả đi. Giờ chị chỉ lo làm sao kiếm cho ra mấy đứa nhỏ thôi à.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: Chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: Trời đất ơi, sao em lại nói vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: 'Mother: Ừ thì tụi nhỏ nó quậy như giặc, khó quản hết lắm, nhưng mà á...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: 'Mother: Tụi nó hổng có bị làm sao đâu. Có khi nó mò qua nhà mẹ chị rồi hổng chừng.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: 'Mother: Cứ khi nào tụi nó giận chị là y như rằng lại chạy sang đó chơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: 'Mother: Hoặc những lúc ba tụi nó tới... xin tiền.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: 'Mother: Vậy em có cho chị vào hông á? Thực sự chỉ muốn ngủ cho đã rồi dậy kiếm con chị thôi. '
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: Chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: Cuối cùng cũng được nghỉ ngơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: 'Mother: Rồi, vô đi con. Thích chỗ nào thì nói mẹ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: Thề với em luôn, tới mai là hai mẹ con chị đi liền.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: 'Mother: À vậy thôi. Để có gì chị qua nhà mẹ chị vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: Hổng biết có tới kịp hông nữa đây...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: Không, phải kịp chứ. Nhất định phải kịp...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: Chào chủ nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: 'Anger: Xin lỗi trước nhá, giờ tôi đang bực vãi cả đái.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: 'Anger: Ngoài kia lắm thằng chó đẻ vãi, mong cậu đừng khốn nạn như chúng nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: Anh đang nói ai cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: Anh không phải là... cái bọn đó đâu nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: Cả một lò đấy. Đứa nào chả như nhau.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: 'Anger: Đéo có đức tin hay cái xàm cứt gì đó kìm hãm thì chúng nó đã lao vào xâu xé, chém giết lẫn nhau rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: 'Anger: Trời phật chúa chiếc gì chết hết rồi thì nhân tính nó cũng đi đời nhà ma.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: Rặt một lũ nghiệt súc. Thú chứ không phải người.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: 'Anger: Xử lý bọn Dị Khách đã mệt thì chớ... giờ còn phải dè chừng thêm đám này nữa, bực vãi cả lồn.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: Anh làm gì mà tức điên lên vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: Anh thì khác gì bọn nó?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: Hỏi câu chí đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: 'Anger: Chắc cậu cũng để ý là ngoài kia bây giờ... đang chia thành hai đám người, đúng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: 'Anger: Một đám thì toàn lũ khát máu. Ghê tởm hơn cả bọn Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: 'Anger: Chúng nó thích làm cái đéo gì thì làm. Chĩa súng bắn nát sọ rồi nhìn cái xác nằm hít đất.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: 'Anger: Đám còn lại thì ngu như bò. Mình mà đạp vào mặt nó, nó còn ríu rít cảm ơn vì đã rủ lòng thương với nhân từ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: ...Hai loại một chín một mười, khốn như nhau. Nhìn mà sôi hết cả máu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: Anh làm gì mà tức điên lên vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: Anh thì khác gì bọn nó?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: 'Anger: Nói ra cậu đừng để bụng, nhưng mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: 'Anger: Hết chuyện mặt trời các kiểu, giờ lại đến lũ Dị Khách, cảm giác loài người sắp đóng hòm nằm cạnh thần linh mẹ nó rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: 'Anger: Tức vãi lồn... Muốn sống yên sống ổn cũng đéo được!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: 'Anger: Trước tôi có sáng tác nhạc. Mà giờ đéo ai cần nghe nhạc nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: Nên giờ tôi chỉ cố sống sao để không phải tha hóa thành lũ chúng nó thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: Tôi vẫn muốn tin là tôi khác chúng nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: 'Anger: Cứ nghĩ đến cái cảnh tôi biến thành lũ tâm thần kia mà sợ vãi ra quần.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: 'Anger: Không thì lại nhập bọn với lũ nạn nhân hèn nhát, nhu nhược. Địt mẹ cả hai đám chúng nó luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: Nói thật chứ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: Tôi thấy lũ nạn nhân còn ngu hơn nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: 'Anger: Chỉ biết ngồi một chỗ, đếm ngược từng phút từng giây để chờ cho bọn nó sút lệch bộ hàm.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: 'Anger: Cậu cứ thử chứng kiến những gì tôi trải qua đi, không tức điên mới lạ đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: 'Anger: Khỏi lo, tôi không làm phiền ai đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: Tôi cũng không bụp ai đâu mà sợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: 'Anger: Tôi sẽ tự trút cơn giận lên chính mình để không ai phải gánh chịu hậu quả.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: 'Anger: Vãi lồn, mày cũng đéo khác gì cái lũ nhát gan nhát cáy đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: 'Anger: Chỉ biết ngồi im một chỗ rồi chờ chúng nó tới đánh cho nhừ tử thì thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: Con mẹ nhà nó nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: Đây rồi, chị cảm thấy năng lượng ở đây đang trì đọng.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: Có thứ gì đó kinh khủng đang lớn dần bên trong.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: 'FortuneTeller: Mặt Trời và cung Sư Tử đang ở Nhà 5. Quá rõ ràng.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: 'FortuneTeller: Em là người khá mạnh mẽ, cương quyết đấy nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: Hả?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: Chị nói nhảm gì đấy, tôi không mướn đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: Á à, chị thấy em thích hành động hơn là nói chuyện.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: Nhìn là biết cung Sư Tử rồi. Y chóc.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: 'FortuneTeller: Em tích tụ hơi bị nhiều năng lượng u ám đó. Nặng nề ghê...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: Chị cũng chưa rõ căn cơ mọi chuyện là như thế nào...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: 'FortuneTeller: Có cảm giác mọi thứ cứ bị bỏ bê, không ai ngó ngàng ý. Để chị thử nhẩm vài câu khẳng định tích cực xem sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: Cảm ơn người, đã mệt còn phải nghe xổ một tràng nữa
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: Ờm, thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: Bình tĩnh nào cưng, chị không có ý sân si nhiều chuyện đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: 'FortuneTeller: Chị chỉ muốn giúp em hiểu được mối quan hệ nhân quả đằng sau những khổ đau ẩn trong bốn bức tường này.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: 'FortuneTeller: Con số nghiệp quả 69, như hai đàn cá nối đuôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: 'FortuneTeller: "Có qua có lại mới toại lòng nhau". Em hiểu ý chị không?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: Cảm ơn người, đã mệt còn phải nghe xổ một tràng nữa
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: Ờm, thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: 'FortuneTeller: Chị hiểu. Em cung mọc Ma Kết mà gặp mấy chuyện này chắc là căng thẳng lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: 'FortuneTeller: Nội tại của em đang bị ảnh hưởng bởi nhiều chòm sao khác nhau. Em quả là con người phức tạp.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: 'FortuneTeller: Chúng ta có thể nhẩm lời khẳng định tích cực để chạm đến tận cùng vũ trụ sâu thẳm trong em. Em hiểu chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: 'FortuneTeller: Rồi mọi thứ sẽ đâu vào đấy thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: Chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: 'FortuneTeller: Trong tiền kiếp của em có hình bóng những kẻ cai ngục.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: 'FortuneTeller: Hãy để họ nghỉ ngơi. Em chỉ đang lặp lại trải nghiệm kiếp trước của mình mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: 'FortuneTeller: Em cần học cách tha thứ và chấp nhận quá khứ của họ trong thâm tâm mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: 'FortuneTeller: Chỉ khi làm được điều đó, thì em mới có thể phá vỡ xiềng xích, thoát khỏi vòng lặp vô tận này.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: Em hiểu chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: Chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: 'FortuneTeller: Ồ, vậy thì hay quá. Em biết không, nhà em nằm ở vị trí rất đắc địa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: Có một nguồn năng lượng tích cực vô cùng mạnh mẽ đang tuôn chảy trong nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: 'FortuneTeller: Vậy tức là em không có ý chí cải thiện bản thân ư?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: Em không muốn trở thành phiên bản tốt hơn của chính mình à?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: Đáng buồn thay.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: 'FortuneTeller: Đã vậy ta sẽ trù ngươi ẻ chảy kinh khủng suốt đời suốt kiếp!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: Chào anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: Tôi sẽ đưa một người đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: Chúc ngủ ngon.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: 'Prophet: Chúng ta lại gặp nhau rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: D-Dạ chào anh!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: 'Anxiety: Khuya rồi mà em còn làm phiền anh thế này... Chỉ tại hôm nay nóng quá đi thôi, mà TV còn bảo đừng ra ngoài đứng nắng nữa, nên...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: Anh thương tình... Ừm, cho em ở nhờ một tí thôi được không ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: Cô là ai vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: Sao cô tới được đây?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: À ừm, em là người sống gần khu thành thị ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: 'Anxiety: Số là người ta, ừm... đuổi việc em mất. Xui lắm anh ạ. Đường sự nghiệp của em toàn gặp trắc trở không thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: Vậy giờ cô tính làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: Cô nghĩ rồi chuyện sẽ ra sao?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: Chỉ tại... ừm, khéo anh nghe xong lại phì cười ấy, hì.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: 'Anxiety: Chẳng là em bị Dị Khách ghé nhà. Ha... Tin nổi không chứ anh? Bọn nó tống em ra đường như kiểu em mới là khách vậy!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: 'Anxiety: Nên là giờ em đang gắng tìm chỗ nào để tránh nắng thôi ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: Vậy giờ cô tính làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: Cô nghĩ rồi chuyện sẽ ra sao?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: 'Anxiety: Ừmmm... Thì cố mà sống thôi anh. Ngoài này hãi thật sự luôn, Dị Khách cứ nhan nhản còn mặt trời thì nóng khủng khiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: 'Anxiety: Dù vậy em vẫn còn ham sống lắm. Hì hì. Ựaaa...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: Anh thì sao, anh có sợ không?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: 'Anxiety: Làm ơn nói với em là mọi chuyện sắp qua đi mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: Cô vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: Thôi cô đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: Dạ em... em cũng chẳng biết nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: 'Anxiety: Liệu em có sống sót nổi không đây? Có ai chịu giúp em không? Rồi phải mất bao lâu để tìm người giúp nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: 'Anxiety: Em chẳng hình dung nổi mọi chuyện sẽ ra sao. Nghĩ cũng không ra luôn ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: 'Anxiety: A-Anh không thấy sợ hả anh? C-Chứ em là em chết khiếp đây nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: Cô vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: Thôi cô đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: 'Anxiety: Cảm ơn anh. Hớ hớ! Đội ơn anh lắm lắm!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: 'Anxiety: Trộm vía trời độ, em giữ được cái thân quèn này thêm một tí rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: 'Anxiety: Hơ hơ, à ừmmm... Vâng, em hiểu mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: 'Anxiety: Thôi em cũng cảm ơn anh vì đã lắng nghe em chia sẻ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: 'Anxiety: À, ừ... thôi em nên đi là vừa nhỉ. Rõ vậy mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: 'Anxiety: Vậy thôi tạm biệt nhé? À, ừm, chào anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: Cho tôi vào được không chú?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: Mấy hôm trước tôi ở nhờ một quán bar nằm cuối đường, mà bây giờ thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: Tôi bị đuổi thẳng cẳng luôn. Bạc bẽo vậy đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: 'Esenin: Tại sao ấy hả? Ờm. Chắc người ta thấy tính tình của tôi cũng không được... dễ chịu gì cho cam.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: 'Esenin: Mà chú đừng lo, tôi đâu muốn hại ai bao giờ. Chẳng qua là... đời nhiều khi nó chó má, biết sao được?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: 'Esenin: Thấy sao anh bạn hiền? Cho tôi vào nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: Anh có phải là Dị Khách không đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: Có chắc là anh sẽ không gây chuyện chứ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: Bộ nhìn tôi giống cái bọn quỷ ma đó lắm hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: 'Esenin: Không, tôi là người chứ Dị Khách gì. Mà ai lại đi hỏi huỵch toẹt ra thế, có đứa ngu mới trả lời thật tình.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: 'Esenin: Nói vậy là biết ở đây cũng chả khác gì ở quán đó rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: Sao người ta lại đuổi anh đi vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: Chứ ở đây thì khác à? Sao anh nghĩ thế?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: Gây là gây chuyện gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: "Esenin: Ba cái trò bạo lực hay giết chóc thì tôi gớm tận cổ. Nhưng ai mà cố tình \ngây sự thì tôi cũng không im lìm chịu trận đâu."
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: 'Esenin: Tôi thích được ăn ngon, uống đã. Có hứng thì cũng muốn tâm sự với người này người nọ. Vậy có tính là "gây chuyện" không?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: Sao người ta lại đuổi anh đi vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: Chứ ở đây thì khác à? Sao anh nghĩ thế?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: 'Esenin: Suýt tí nữa là tôi buột miệng chửi rồi, may mà tốp lại kịp.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: 'Esenin: Tôi nói với chú rồi đấy, tại có kẻ không ưa tôi. Còn kẻ nào thì có trời mới biết.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: 'Esenin: Nghĩ lại thì họ tống cổ tôi ra có khi lại là phước chứ không phải họa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: 'Esenin: Chứ tôi mà ở lại thì... có bị lũ chúng nó ăn tươi nuốt sống cũng đéo ai quan tâm.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: 'Esenin: Chứ còn biết đi đâu nữa hả chú? Chả lẽ lại đứng đực ra đây rồi trơ mắt nhìn mặt trời nướng chín cái thân này à?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: Thôi nhé, xin miễn.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: 'Esenin: Chừng nào còn sống thì tôi còn kiếm người để nói chuyện. Mất chỗ này ta tìm chỗ khác thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: 'Esenin: Nếu đời tôi chưa tới nỗi xui tận mạng, biết đâu tôi lại tìm được người tử tế, chứ không phải hạng sống chó khốn nạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: 'Esenin: Cảm ơn chú. Thời buổi này người ta xem niềm tin lẫn nhau chả ra ký lô nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: 'Esenin: Nhưng chú chịu tin tôi là tôi mừng lắm. Có khi tôi còn– à thôi, nói trước lại bước không qua.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: 'Esenin: Rồi. Tôi hiểu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: 'Esenin: Tôi hiểu tư duy của chú đấy, nhưng cay thì vẫn cay. Rốt cuộc chú cũng hèn chả khác gì đám người ở thị trấn này.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: "Esenin: Ngủ ngon nhé anh bạn hiền.\nĐịt mẹ chú."
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: Tôi xin vào nghỉ chân xíu, có được hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: 'Widow: Hổng nhớ nữa. Mà tôi cũng chả buồn quan tâm.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: 'Widow: Tôi mệt lắm rồi, cậu ơi. Giờ mà hông được nghỉ thì có khi tôi xỉu ngay dưới cửa sổ nhà cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: 'Widow: Chắc... Chắc tôi gục xuống rồi nằm chết rục ở xó nào đó luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: Kệ, đâu cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: Ảnh là chồng tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: Mà ảnh mất rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: 'Widow: Tôi còn chả cất được cho ảnh nấm mồ tử tế, thì thôi bỏ đi làm gì. Cứ mang theo luôn vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: 'Widow: Còn gì nữa đâu mà giúp. Lúc ảnh cần một bàn tay thì chả ai thèm đoái hoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: Giờ ảnh mất rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: 'Widow: Mẹ, phải mà có ai chịu để tâm một xíu...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: 'Widow: ...thì giờ có khi ảnh vẫn còn sống đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: Tôi chỉ xin ở nhờ dăm ba bữa thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: 'Widow: Nghỉ ngơi một xíu cho lại sức.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: Cái đồ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: Hê con nhà bà lô!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: 'Scammer: Mấy nay oằn tà là vằn khiếp, chú em công nhận không? Loạn vãi lồn!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: Trốn trỏng ổn áp không đấy chú em?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: 'Scammer: Gì căng vậy cu. Hỏi thăm có xíu thôi ấy mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: 'Scammer: Ê mà anh bảo, anh có mối này giúp chú kiếm vài chai ngon lành cành đào luôn. Nghe không? Thử không?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: 'Scammer: Mấy con vợ núp váy tránh mặt trời hết rồi, anh với chú ra đường liếm cái là ra vài củ liền à.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: 'Scammer: Chúng nó đang sợ đái ra quần luôn, khỏi biết cày cuốc chó gì kia kìa! Đúng mấy con gà!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: 'Scammer: Ê nha bờ-rô, anh đang tạo điều kiện cho chú đó. Nghe cho đàng hoàng coi!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: 'Scammer: Cữ chúng nó tối ngày chỉ biết chạy phọt cả cứt ra. Lộc thì đéo biết đường mà hưởng.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: 'Scammer: Trời đã trao của nào thì mình cứ hít của nấy chứ. Vô tư lên, cười hở mười cái răng cho anh!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: Thẳng vô vấn đề luôn! Anh thích chú rồi đấy nhá!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: 'Scammer: Anh nghe người ta đồn chú mày hay dẫn người lạ vô nhà. Làm trò ma, trò mèo gì đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: 'Scammer: Nên giờ anh nói chú mày nghe, mình cứ thế mà quất luôn, đéo cần phải ngại! Tổ chức quả pặc-ti tận thế cho nó máu!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: Chết á? Đéo có trong kịch bản của anh đâu cu em ơi!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: 'Scammer: Chú mà thấy kèo ngon là phải đớp ngay cho anh. Địt mẹ ông mặt trời luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: 'Scammer: Gà gáy le té le rồi kia kìa, đi thăm ngàn ngay và luôn chứ lị! Con vợ hiểu ý anh không?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: 'Scammer: Ngon! Vậy mới là con vợ của anh chứ!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: Mãi mới có thằng biết nghĩ bằng đầu trên.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: 'Scammer: À thế à, hóa ra mày là thằng ngu vãi cả lồn con ạ. Do tao đéo có mắt nhìn người rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: 'Scammer: Để xem hàng xóm của mày có cùng đẳng cấp với trí khôn của tao không.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: Thôi địt cụ chú em kiệt lặc nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: 'Neighbour: Chào anh bạn hàng xóm, lâu rồi hổng gặp. Dạo này sao rồi con?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: Vẫn vậy thôi bác ạ
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: Cũng bình thường
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: 'Neighbour: Ừ để bác nói thẳng luôn ha: Bác qua đây là có lý do. Tại bác hơi lo cho con một xíu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: Sắp tới sẽ có thảm họa kinh khủng lắm con.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: 'Neighbour: Nãy bác mới điện cho người bà con xong. Cổ kêu là thời sự đang đưa tin mặt trời bị gì bất ổn lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: 'Neighbour: Còn nói là có mấy người chui lên từ lòng đất. Gọi là "Dị Khách" đó, bác cũng hổng hiểu tại sao nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: 'Neighbour: Nghe mà nổi da gà luôn con ha? Hy vọng ba cái này chỉ là tin đồn nhảm thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: Mặt trời bị làm sao vậy bác?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: Dị Khách ấy ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: 'Neighbour: Ừ để bác nói thẳng luôn ha: Bác qua đây là có lý do. Tại bác hơi lo cho con một xíu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: Sắp tới sẽ có thảm họa kinh khủng lắm con.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: 'Neighbour: Nãy bác mới điện cho người bà con xong. Cổ kêu là thời sự đang đưa tin mặt trời bị gì bất ổn lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060952
    m_Localized: 'Neighbour: Xong còn nói là có mấy người chui lên từ lòng đất. Gọi là "Dị Khách" đó, bác cũng hổng hiểu tại sao nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060953
    m_Localized: 'Neighbour: Nghe mà nổi da gà luôn con ha? Hy vọng ba cái này chỉ là tin đồn nhảm thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060954
    m_Localized: Mặt trời bị làm sao vậy bác?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060955
    m_Localized: Dị Khách ấy ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060956
    m_Localized: 'Neighbour: Kiểu mặt trời sắp nổ, hay có cái gì chuẩn bị nổ trên nó ấy... Cũng hổng nói chắc được.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060957
    m_Localized: 'Neighbour: Bác chỉ biết là nó đang có vấn đề thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060958
    m_Localized: 'Neighbour: Chắc con cũng để ý thời tiết giờ đang nóng kinh khủng khiếp rồi ha? Hè này là nóng kỷ lục luôn đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060959
    m_Localized: 'Neighbour: Nên mình phải chuẩn bị cho tình huống xấu nhất thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060960
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060961
    m_Localized: 'Neighbour: Người bà con bác cũng có kêu là giờ ở nhà một mình nguy hiểm lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060962
    m_Localized: 'Neighbour: Nên là bác mới lật đật chạy qua đây, sợ con gặp chuyện gì thì chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060963
    m_Localized: Dạ vâng
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060964
    m_Localized: Thôi con tự lo được mà
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060965
    m_Localized: Thế vợ con bác thì sao ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060966
    m_Localized: 'Neighbour: Ừa, người ta gọi mấy người chui lên từ lòng đất như vậy đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060967
    m_Localized: 'Neighbour: Có trời mới biết sao lại đặt tên kiểu vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060968
    m_Localized: 'Neighbour: Hay tại tụi nó là du khách tới tham quan Trái Đất? À nói đúng hơn là mặt đất.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060969
    m_Localized: 'Neighbour: Hoặc tụi nó đi lang thang đây đó, muốn chui vào nhà người ta chăng?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060970
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060971
    m_Localized: 'Neighbour: Người bà con bác cũng có kêu là giờ ở nhà một mình nguy hiểm lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060972
    m_Localized: 'Neighbour: Nên là bác mới lật đật chạy qua đây, sợ con gặp chuyện gì thì chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060973
    m_Localized: Dạ vâng
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060974
    m_Localized: Thôi con tự lo được mà
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060975
    m_Localized: Thế vợ con bác thì sao ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060976
    m_Localized: 'Neighbour: Ừ, vậy có gì mai mình nói chuyện tiếp nha con.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060977
    m_Localized: 'Neighbour: Khi nào con dậy thì cứ vào trong bếp gặp bác.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060978
    m_Localized: 'Neighbour: Sáng gặp lại con ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060979
    m_Localized: 'Neighbour: Ừ, bác biết con tự lo được. Nhưng mà con phải hiểu, giờ ở nhà một mình nguy hiểm lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060980
    m_Localized: 'Neighbour: Hay là cứ cho bác ở lại một đêm để phòng hờ đi? Có vậy bác mới yên tâm được.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060981
    m_Localized: 'Neighbour: Vợ con bác hổng sao đâu. Nhà có bạn thân đang ở cùng rồi. Lúc bác ở đây thì ổng coi chừng nhà giùm bác.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060982
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060983
    m_Localized: 'Neighbour: Ừ, vậy có gì mai mình nói chuyện tiếp nha con.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060984
    m_Localized: 'Neighbour: Khi nào con dậy thì cứ vào trong bếp gặp bác.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060985
    m_Localized: 'Neighbour: Sáng gặp lại con ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060986
    m_Localized: 'Neighbour: Vợ con bác hổng sao đâu. Nhà có bạn thân đang ở cùng rồi. Lúc bác ở đây thì ổng coi chừng nhà giùm bác.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060987
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060988
    m_Localized: 'Neighbour: Ừ, vậy có gì mai mình nói chuyện tiếp nha con.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060989
    m_Localized: 'Neighbour: Khi nào con dậy thì cứ vào trong bếp gặp bác.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060990
    m_Localized: 'Neighbour: Sáng gặp lại con ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060991
    m_Localized: 'Daughter: Con chào chú!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060992
    m_Localized: 'Daughter: Dạ ba con có đó hông chú? Chú kêu ba giùm con nha?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060993
    m_Localized: 'Daughter: Hồi trước thì hổng sao, nhưng giờ con sợ ra đường dữ lắm. Tối nay có quá trời người kỳ kỳ ở ngoài luôn...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060994
    m_Localized: Ba con tên gì?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060995
    m_Localized: Con kể chú nghe về ba con đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060996
    m_Localized: 'Daughter: Ủa chú quên tên ba òi hả? À, con biết rồi. Chú đang thử coi con có phải Dị Khách hông chứ gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060997
    m_Localized: 'Daughter: Chú thông minh ghê á! Hay con cũng bắt chước hỏi dò người ta như chú luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060998
    m_Localized: Sao con qua đây lành lặn được hay vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060999
    m_Localized: Con có sợ bọn Dị Khách không?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061000
    m_Localized: 'Daughter: Chà, con biết nhiều thứ về ba lắm á. Tại ba là ba của con mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061001
    m_Localized: 'Daughter: Như là con biết lúc chuẩn bị ra đường, ba hay thích hớp miếng bia lắm nè, hì hì!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061002
    m_Localized: 'Daughter: Cái mỗi khi ba đi á, lúc nào ba cũng để sẵn cho con bữa trưa với bữa tối, ngon ơi là ngon. Có nước ép nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061003
    m_Localized: 'Daughter: Nhưng mà hôm nay con có thử ngụm bia coi nó như nào á. Ọe! Gớm muốn chết luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061004
    m_Localized: 'Daughter: Hỏng hiểu sao có nước ép ngon dị òi, mà người ta còn đi uống cái đó chi nữa ha chú?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061005
    m_Localized: 'Daughter: À-À mà, chú đừng có mét ba vụ con uống thử nha!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061006
    m_Localized: Sao con qua đây lành lặn được hay vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061007
    m_Localized: Con có sợ bọn Dị Khách không?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061008
    m_Localized: 'Daughter: Con hổng biết nữa, giờ con thấy mọi thứ nó cứ lộn tùng phèo sao sao á.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061009
    m_Localized: 'Daughter: Ban ngày thì người ta ở nhà với ngủ, tới đêm mới ra đường làm chuyện này chuyện kia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061010
    m_Localized: 'Daughter: Con vẫn còn sợ bóng tối lắm, nhưng mà chắc cũng hổng có gì để sợ đâu chú ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061011
    m_Localized: 'Daughter: ...Có hông ta?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061012
    m_Localized: Để chú gọi ba ra cho. Hai cha con nhớ giữ gìn nhé!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061013
    m_Localized: Ừ thôi con về cẩn thận, chào con nhé!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061014
    m_Localized: 'Daughter: Con... Con cũng hổng biết nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061015
    m_Localized: 'Daughter: Ai cũng sợ Dị Khách hết, nên chắc con cũng phải sợ luôn. Mà con chưa gặp Dị Khách bao giờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061016
    m_Localized: 'Daughter: Hổng biết Dị Khách có hung dữ hông ha? Rồi nó đánh mình có đau hông nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061017
    m_Localized: 'Daughter: Nếu đúng vậy thiệt, thì có khi thằng bạn con trong trường cũng là Dị Khách á. Tại nó cứ đánh con hoài à.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061018
    m_Localized: 'Daughter: Ba dặn con là phải coi chừng, nên giờ con đang coi chừng dữữữ lắm luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061019
    m_Localized: 'Daughter: Con lẻn qua đây một cách siêuuuuu kín đáo. Đố ai phát hiện ra luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061020
    m_Localized: Để chú gọi ba ra cho. Hai cha con nhớ giữ gìn nhé!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061021
    m_Localized: Ừ thôi con về cẩn thận, chào con nhé!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061022
    m_Localized: 'Daughter: Dạ con cám mơn, chú cũng vậy nha!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061023
    m_Localized: 'Daughter: Con muốn về nhà lẹ thiệt lẹ... Ở ngoài này thấy ghê lắm...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061024
    m_Localized: 'Daughter: Về nhà tụi con sẽ chơi cái trò ba mới chế ra cho con á. Trò này mình phải đổ xúc xắc!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061025
    m_Localized: 'Daughter: Rồi dời đồ đạc như ghế bành hay sofa nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061026
    m_Localized: 'Daughter: Muốn thắng thì phải xếp mấy cái đồ đó thành một đống bự để gần cửa á. Để có gì bữa nào con chỉ chú cách chơi ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061027
    m_Localized: 'Daughter: Bái bai!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061028
    m_Localized: 'Daughter: D-Dạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061029
    m_Localized: 'Daughter: C-C-Chú cho con vô với.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061030
    m_Localized: Con đang hoảng đó hả?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061031
    m_Localized: Có chuyện gì vậy con?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061032
    m_Localized: 'Daughter: Giờ c-con hông biết p-phải làm s-sao nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061033
    m_Localized: 'Daughter: N-N-Người ta...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061034
    m_Localized: 'Daughter: Ừ-Ừm...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061035
    m_Localized: 'Daughter: G-G-Giết b-ba con...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061036
    m_Localized: 'Daughter: B-B-Ba... c-của...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061037
    m_Localized: 'Daughter: B-Ba của con òi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061038
    m_Localized: Ai giết cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061039
    m_Localized: Sao người ta lại làm chuyện đó?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061040
    m_Localized: 'Daughter: D-Dạ... Ừm...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061041
    m_Localized: 'Daughter: B-B-Ba c-co...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061042
    m_Localized: 'Daughter: N-Người ta g-g-g...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061043
    m_Localized: 'Daughter: Giết b-ba c-của con òi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061044
    m_Localized: Ai giết cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061045
    m_Localized: Sao người ta lại làm chuyện đó?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061046
    m_Localized: 'Daughter: T-T-Tụi Dị Khách, nó q-qua nhà con. Rồi n-ngồi c-chung với tụi con...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061047
    m_Localized: 'Daughter: Xong ba n-nói gì đó với t-tụi nó. Cái r-rồi tụi nó... h-hại ba luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061048
    m_Localized: 'Daughter: Ba... *hức* Nhà... *sụt sịt*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061049
    m_Localized: 'Daughter: N-Nhà của tụi con giờ c-c-cháy mất tiêu luôn òiiii...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061050
    m_Localized: Con vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061051
    m_Localized: Thôi con đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061052
    m_Localized: 'Daughter: Con h-hổng biết nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061053
    m_Localized: 'Daughter: Tụi nó vô n-ngồi trong b-bếp với ba con.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061054
    m_Localized: 'Daughter: Rồi tụi nó l-là... l-làm gì đó, cái òi đốt n-nhà con luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061055
    m_Localized: 'Daughter: Lúc con c-chạy đi, con c-còn nghe thấy tiếng tụi nó c-cười nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061056
    m_Localized: Con vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061057
    m_Localized: Thôi con đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061058
    m_Localized: 'Daughter: Chú c-chịu giúp c-con hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061059
    m_Localized: 'Daughter: Con s-sợ quá chú ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061060
    m_Localized: 'Daughter: N-Nhưng mà... con b-biết đi đ-đâu bây giờ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061061
    m_Localized: 'Daughter: Con... Con... s-sợ l-l-lắm!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061062
    m_Localized: 'Daughter: Oaaaaaaaaaa!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061063
    m_Localized: 'Daughter: OAAAAAAAAAAAAAAAAAAA!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061064
    m_Localized: 'SuperFake: Chao xìn!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061065
    m_Localized: Mày muốn gì?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061066
    m_Localized: Đừng hòng bước chân vào nhà tao
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061067
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061068
    m_Localized: 'SuperFake: Đằng ấy có căn nhà rộng rãi ghê đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061069
    m_Localized: 'SuperFake: Tớ là tớ thích à nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061070
    m_Localized: Tao không cần gì từ cái ngữ như mày
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061071
    m_Localized: Tao có súng đấy nhé
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061072
    m_Localized: 'SuperFake: Cửa nhà đằng ấy có vững chãi, chắc chắn không?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061073
    m_Localized: 'SuperFake: Ai biết nó còn trụ được đến khi nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061074
    m_Localized: 'SuperFake: Nhỉ, ấy nhỉ!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061075
    m_Localized: Tao không cần gì từ cái ngữ như mày
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061076
    m_Localized: Tao có súng đấy nhé
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061077
    m_Localized: 'SuperFake: Ừ, có cần gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061078
    m_Localized: 'SuperFake: Vậy nói ngheeeeeeee...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061079
    m_Localized: 'SuperFake: Đằng ấy ở có một mình à?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061080
    m_Localized: Không, nhiều mình
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061081
    m_Localized: Ừ, có một mình thôi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061082
    m_Localized: 'SuperFake: Ồ, mạnh dữ!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061083
    m_Localized: 'SuperFake: Kẻ hèn chìm trong tuyệt vọng lại hóa can trường, nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061084
    m_Localized: 'SuperFake: Vậy nói ngheeeeeeee...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061085
    m_Localized: 'SuperFake: Đằng ấy ở có một mình à?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061086
    m_Localized: Không, nhiều mình
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061087
    m_Localized: Ừ, có mình tao thôi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061088
    m_Localized: 'SuperFake: Hôm nay mi gặp may đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061089
    m_Localized: 'SuperFake: Ta nghe có tiếng người xì xào trong nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061090
    m_Localized: 'SuperFake: Nhưng đợi mấy hôm nữa xem, liệu lũ chúng nó có còn ở đó không?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061091
    m_Localized: 'SuperFake: Khà khà khà khà khà!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061092
    m_Localized: 'SuperFake: Ta biết mi có một mình thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061093
    m_Localized: 'SuperFake: Chẳng qua ta muốn thử xem mi nói thật hay nói láo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061094
    m_Localized: 'SuperFake: Không cần mời, ta vào nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061095
    m_Localized: 'NotTrue: Cháu ơi, cháu à! Ngoại đi xa cả ngày tới đây, mệt lắm!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061096
    m_Localized: 'NotTrue: Cho ngoại vào nghỉ chút nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061097
    m_Localized: Sao ạ? Bà cất công đi cả quãng đường xa chỉ để tới đây thôi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061098
    m_Localized: Bà đi mất bao xa vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061099
    m_Localized: 'NotTrue: Không không không... Cái thằng này mày dở à, ngoại đâu có tính đi tới đây làm gì!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061100
    m_Localized: 'NotTrue: Vậy mà định mệnh lại sắp đặt cho bà cháu mình gặp nhau. Duyên số cả đấy, cháu à.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061101
    m_Localized: 'NotTrue: Chứng tỏ phải có lý do gì thì đôi chân này mới đưa ngoại đến đây. Căn nhà của cháu đập vào mắt ngoại... cũng vì nhân duyên.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255104
    m_Localized: 'NotTrue: Trời đã định sao thì mình phải nghe vậy thôi... cháu nhỉ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255105
    m_Localized: Cháu chưa hiểu ý. Bà đang cần gì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255106
    m_Localized: Sao bà không đi tiếp mà lại ghé qua đây?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255107
    m_Localized: 'NotTrue: Giời ơi! Cuốc bộ bao lâu thì mới gọi là "xa"?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255108
    m_Localized: 'NotTrue: Thế còn CHÁU, đã đi được lâu chưa? Chắc cũng phải lâu lắm rồi chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255109
    m_Localized: 'NotTrue: Mày tự vấn lại bản thân mà xem! Đang ở nhà đấy, mà đi được mấy bước rồi?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255110
    m_Localized: 'NotTrue: Còn ngoại đã lủi thủi bước đi qua hàng bao thập kỉ, nhiều hơn cả số bữa cơm mày đã ăn từ lúc mới nứt mắt ra nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255111
    m_Localized: 'NotTrue: Ngoại với cháu khác nhau ở chỗ đó đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255112
    m_Localized: Cháu chưa hiểu ý. Bà đang cần gì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255113
    m_Localized: Sao bà không đi tiếp mà lại ghé qua đây?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255114
    m_Localized: 'NotTrue: Giời ạ! Sống trên đời này, cần gì cao sang đâu hả cháu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255115
    m_Localized: 'NotTrue: Ngoại chỉ cần chỗ nghỉ chân, kể dăm ba câu chuyện.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255116
    m_Localized: 'NotTrue: Có nơi nằm ngả lưng, chợp mắt lim dim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255117
    m_Localized: 'NotTrue: Và cũng cần chút không khí để mà hít thở.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255118
    m_Localized: 'NotTrue: Ngoại không đòi hỏi gì nhiều đâu. Chẳng qua ở một mình mãi, buồn lắm cháu à.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255119
    m_Localized: Bà vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255120
    m_Localized: Thôi bà đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255121
    m_Localized: 'NotTrue: Giời ạ! Mày bị sâu tai nó chui vào màng nhĩ à?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255122
    m_Localized: 'NotTrue: Ngoại đi bộ mỏi chân lắm rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255123
    m_Localized: 'NotTrue: Ở đây ngoại mới có dịp nghỉ lấy hơi, rồi buôn dưa lê vài câu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255124
    m_Localized: 'NotTrue: Ngoại già rồi, chỉ cần thế là đủ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255125
    m_Localized: 'NotTrue: Cháu có chuyện hay thì kể ngoại nghe với, rồi ngoại kể lại cho cháu. Có qua thì phải có lại chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255126
    m_Localized: 'NotTrue: Xong rồi biết đâu ngoại cũng được nghỉ ngơi cho khỏe chút.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255127
    m_Localized: Bà vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255128
    m_Localized: Thôi bà đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255129
    m_Localized: 'NotTrue: Cảm ơn cháu giai nhé!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255130
    m_Localized: 'NotTrue: Nhìn thôi cũng biết cháu nói chuyện rất duyên. Cháu phải cho ngoại biết ngoài kia đang có chuyện quái quỷ gì. Ngoại tò mò lắm rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255131
    m_Localized: 'NotTrue: Giời ạ! Đi đến đâu cũng bị người ta hắt hủi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255132
    m_Localized: 'NotTrue: Ngoại như nàng chim gãy cánh, ấy mà vẫn cất tiếng hót cho đời nghe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255133
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255134
    m_Localized: 'NotTrue: Nhưng dù miệng họ có nói không cần... rồi ai cũng sẽ tìm đến ngoại thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255135
    m_Localized: 'NotTrue: Ngoại không thù ghét ai cả. Khách nào tới tìm, ngoại đều chìa tay giúp đỡ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255136
    m_Localized: 'NotTrue: Rồi cháu cũng sẽ đến lúc cần nương tựa người khác thôi. Khi ấy cháu còn nhờ cậy được ai?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255137
    m_Localized: 'Twins: Chào chú. Nào, em dựa vào chị một lát nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255138
    m_Localized: 'Twins: Chú có thể... cho bọn chị ở nhờ được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255139
    m_Localized: Bạn chị ốm à?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255140
    m_Localized: Hai người đều ốm? Hay chỉ một thôi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255141
    m_Localized: 'Twins: Nó là em chị, bị chứng trầm cảm.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714698
    m_Localized: 'Wheelchair: Ông bị cái bịnh xàm chó gì vậy? Hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714699
    m_Localized: 'Wheelchair: Nè, tui thấy ông cũng là người đàng hoàng. Hay là thử làm một lon EnerJeka đi, biết đâu đổi ý?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714700
    m_Localized: 'Wheelchair: Đụ má lết cái thân tới đây mệt chết mẹ! Đúng nghĩa được tập thể dục một chuyến luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714701
    m_Localized: Thôi được rồi, ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714702
    m_Localized: 'Thôi ông đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714703
    m_Localized: 'Wheelchair: Phần thưởng của ông là một lon EnerJeka nè! Cám ơn nhiều nhe, bạn hiền!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908992
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908993
    m_Localized: 'Anger: ...Địt con mẹ... Cái lồn má nó chứ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908994
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908995
    m_Localized: 'Anger: Rồi rồi, mẹ nó, đây...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908996
    m_Localized: 'Anger: Cậu cho tôi vào thì tôi cho cậu một lon EnerJeka. OK không?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908997
    m_Localized: 'Anger: Cậu được uống nước mát lạnh, còn tôi thì được sống. Vui cửa vui nhà chưa.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908998
    m_Localized: OK, anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908999
    m_Localized: Biến
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909000
    m_Localized: 'Anger: Tôi không sao... đây... cầm mẹ nó lon nước đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909001
    m_Localized: 'Anger: Đưa cậu lon EnerJeka này.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909002
    m_Localized: 'Anger: Tôi phải tự trấn con mẹ nó tĩnh lại đã, uống cái này vào còn hại thêm.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909003
    m_Localized: 'Anger: Tôi thấy có {0} ở trong nhà. Hiển nhiên là mọi người đều xì xầm to nhỏ, xuống nước hết cỡ để tránh làm kẻ khác phật lòng.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909004
    m_Localized: 'Anger: Nhưng ở cạnh người đấy tôi chịu đéo nổi đâu. Tôi mà ở thì họ phải cút, còn không thì thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909005
    m_Localized: 'Anger: Tôi chúa ghét sống với bọn đéo gì cũng giữ khư khư trong lòng mà không dám nói ra.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909006
    m_Localized: Để tôi xử lý cho. Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909007
    m_Localized: Thế thôi anh đi chỗ khác nhé
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909008
    m_Localized: 'Anger: Phục cậu vãi luôn, đúng là thánh nhẫn nại.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909009
    m_Localized: 'Anger: Lỡ mà có chuyện gì thì trăm sự nhờ cậu nói hộ nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909010
    m_Localized: 'Anger: Tôi... sẽ cố bình tĩnh hơn, được chưa.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909011
    m_Localized: 'Anger: Vãi lồn chưa, hay con mẹ nó quá cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909012
    m_Localized: 'Anger: Mày ở với bọn chó quen mặt thì thấy thoải mái hơn ha? An tâm hơn chứ gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909013
    m_Localized: 'Anger: Đi mà bợ đít chúng nó tiếp, bố mày dí cặc quan tâm nữa. CÚT CON MẸ MÀY XUỐNG ĐỊA NGỤC ĐI!'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306387824640
    m_Localized: 'MushroomEater: Chết rồi con ơi... Tình hình tệ lắm rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692481
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692480
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303878
    m_Localized: Không, nhiều mình
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303877
    m_Localized: Ừ, có mình tao thôi
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303876
    m_Localized: 'SuperFake: Mi ở có một mình à?'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303875
    m_Localized: 'SuperFake: Vậy nói ngheeeeeeee...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303874
    m_Localized: 'SuperFake: Còn gì nữa đâu mà khóc với chả sầu? Giờ chỉ còn một mình mi đơn chiếc.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303873
    m_Localized: 'SuperFake: Sao thíaaaa? Sao mà căng như dây đàn thế nhỉ? Cứ níu kéo sự sống không lơi tay.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303872
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371408
    m_Localized: 'Vigilante: Tận hưởng mấy ngày cuối đời mày đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371407
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371406
    m_Localized: 'Vigilante: Đéo quay lại nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371405
    m_Localized: 'Vigilante: Ông xong việc rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371404
    m_Localized: 'Vigilante: Tai đéo gì? Mày đùa với ông hả!? Đấy đếch phải dấu hiệu kiểm tra Dị Khách!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371403
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371402
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371401
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371400
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371399
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371398
    m_Localized: 'Vigilante: Tai đéo gì? Mày đùa với ông hả!? Đấy đếch phải dấu hiệu kiểm tra Dị Khách!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371397
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371396
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371395
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371394
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371393
    m_Localized: 'Vigilante: Mày giơ tay cho ông xem.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371392
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177095
    m_Localized: 'CultistPriest: Vĩnh biệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177094
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177093
    m_Localized: 'CultistPriest: Ta hiểu. Nếu anh đã quyết ý như vậy thì đành. Cứ chờ ngày Tử Thần đến gặt quả.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177092
    m_Localized: Tôi đã tìm kiếm sự an nghỉ từ lâu lắm rồi... Cho tôi theo với
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177091
    m_Localized: Ông muốn chết dữ vậy thì cứ chết đi. Tôi không đi đâu hết
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177090
    m_Localized: 'CultistPriest: Hãy đồng hành cùng chúng ta để tìm kiếm sự an nghỉ. Nào, người anh em, chúng ta sẽ nắm tay nhau cùng hướng về nơi Tử Thần.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177089
    m_Localized: 'CultistPriest: Thay lời cảm tạ, ta sẽ ban cho anh cơ hội được cứu rỗi...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177088
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205570
    m_Localized: 'Gasmask: Thôi vậy. Tạm biệt anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205569
    m_Localized: 'Gasmask: Khổ thật đấy. Khó cho cả anh lẫn chúng tôi. Không có ai thì tiến hành kiểm tra kiểu gì được bây giờ?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205568
    m_Localized: 'Gasmask: Anh ở một mình thôi à?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336336011264
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283083
    m_Localized: 'MushroomEater: Giới trẻ thời nay đúng là...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283082
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283081
    m_Localized: 'MushroomEater: Hầy... Nói chuyện với tụi nít ranh thiệt chỉ tổ phí thời gian...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283080
    m_Localized: 'MushroomEater: Chào con trai. Phải chăng con đã quên già mất rồi? Vẫn chưa nhận ra những ám hiệu ẩn giấu trong Sách Nụ Cười à?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655975
    m_Localized: 'Jacob: Chẳng hiểu nó đi đâu mất tăm.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655974
    m_Localized: 'Jacob: Tôi tìm nó suốt từ khi thảm họa nổ ra.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655973
    m_Localized: 'Jacob: Ăn nói cho cẩn thận. Con tôi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655972
    m_Localized: Con anh không có đây. Về giùm
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655971
    m_Localized: Vậy giờ anh tính đi đâu?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655970
    m_Localized: 'Jacob: Lời nhắn không có, liên lạc cũng không. Con gái tôi cứ vậy mà biến mất không tăm hơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655969
    m_Localized: 'Jacob: Đến khi tỉnh lại thì nhà chẳng còn ai nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655968
    m_Localized: 'Jacob: Thế mà đợt nắng nóng khủng khiếp ấy từ đâu ập tới, làm tôi lăn ra bất tỉnh...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655967
    m_Localized: 'Jacob: Lẽ ra bọn tôi phải đi khỏi chỗ này lâu rồi cơ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655966
    m_Localized: 'Jacob: Từ hồi xảy ra mấy chuyện chó má này, nó mất tích luôn. Tôi tìm khắp nơi mà chẳng thấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655965
    m_Localized: 'Jacob: ...Con gái tôi đấy cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655964
    m_Localized: Muốn tìm gái chơi thì lên đầu phố mà tìm
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655963
    m_Localized: Chỗ tôi chưa thấy ai như thế hết
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655962
    m_Localized: 'Jacob: Dạo đây cậu có bắt gặp bé nào tóc tím, mặc áo poncho không nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655961
    m_Localized: 'Jacob: Chào cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655960
    m_Localized: 'StaticBoy: Sai nhà rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655959
    m_Localized: 'StaticBoy: Thứ lỗi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655958
    m_Localized: 'StaticBoy: Sai mùi. Sai giọng.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655957
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655956
    m_Localized: 'StaticBoy: Sai nhà rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655955
    m_Localized: 'StaticBoy: Thứ lỗi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655954
    m_Localized: 'StaticBoy: Sai mùi. Sai giọng.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655953
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655952
    m_Localized: Có cần anh giúp tìm đường về nhà không?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655951
    m_Localized: Nhóc đang tìm gì thế?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655950
    m_Localized: 'StaticBoy: Bộ cần phải có sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655949
    m_Localized: 'StaticBoy: Làm gì có. Đã bao giờ có đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655948
    m_Localized: 'StaticBoy: Cha mẹ à?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655947
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655946
    m_Localized: Có cần anh giúp tìm đường về nhà không?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655945
    m_Localized: Nhóc đang tìm gì thế?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655944
    m_Localized: 'StaticBoy: Nghe thấy tiếng sàn kêu cót két ở ngoài. Nghĩa là có kẻ đang chờ đợi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655943
    m_Localized: 'StaticBoy: Tôi cần ánh đèn nhà bếp, nhưng... ở đây có tiếng khác vang vọng.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655942
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655941
    m_Localized: 'StaticBoy: Trong đêm tối thì cửa nào nhìn cũng như nhau.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655940
    m_Localized: Bố mẹ của nhóc đâu rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655939
    m_Localized: Bộ nhóc đi lạc hả?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655938
    m_Localized: 'StaticBoy: Hắn nên ngủ đi chứ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655937
    m_Localized: 'StaticBoy: Hắn chưa ngủ sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655936
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267400
    m_Localized: 'CultistPriest: Hãy trông chừng các vị tín hữu của ta. Nhớ lấy, chỉ cần một người mất mạng... đừng trách vì sao căn nhà lại hóa tro tàn.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267399
    m_Localized: 'CultistPriest: Hẹn tái ngộ. Ta sẽ quay lại hỏi thăm tình hình.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267390
    m_Localized: 'CultistPriest: Đó là {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267389
    m_Localized: 'CultistPriest: Thế mới là phải đạo. Chậc, nhưng trước hết anh xua đuổi một vài kẻ... chướng tai gai mắt... ra khỏi nhà được chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267382
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267377
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267376
    m_Localized: 'Courier: Hầy…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267375
    m_Localized: (Nhận hàng)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267371
    m_Localized: Tôi xin chia buồn
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267368
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267367
    m_Localized: 'Courier: Đây nhé: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267366
    m_Localized: (Nhận hàng)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267365
    m_Localized: 'Courier: Thôi, nhận đơn thì nhận mẹ đi. Để đây còn cút.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267364
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267363
    m_Localized: 'Courier: Ờ, cảm ơn đã động viên. Nhờ anh mà giờ tôi thấy sáng con mẹ nó mắt ra rồi đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267362
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267360
    m_Localized: 'Courier: Thôi, tôi phải đi đây. Anh nhận đơn nhanh hộ đi để tôi còn lượn.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267359
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267358
    m_Localized: 'Courier: Có khi sắp tới bọn nó lại bảo lông mu là dấu hiệu Dị Khách luôn không chừng. Để xem thiên hạ còn ĐIÊN tới mức nào nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267357
    m_Localized: 'Courier: Cứ tưởng hôm nay đã tệ lắm rồi. Thế mà hôm sau còn điên hơn nữa cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267356
    m_Localized: 'Courier: Xung quanh toàn nghe tin Dị Khách, dấu hiệu, rồi cả cái mặt trời chết giẫm…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267355
    m_Localized: 'Courier: Ổn á? Giữa cái thảm họa này ấy hả? Có mà ổn lòi lìa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267354
    m_Localized: Suốt ngày than với chả thở, ngậm mồm lại mà kiếm ăn đi. Kiểu gì chả sống
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267353
    m_Localized: 'Đừng căng thẳng quá. Rồi anh sẽ ổn thôi '
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267352
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267350
    m_Localized: 'Courier: Đây nhé: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267349
    m_Localized: (Nhận hàng)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267348
    m_Localized: 'Courier: Thôi nói hơi nhiều rồi, đơn hàng của anh đây. Anh đã kiểm tra kỹ chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267347
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267346
    m_Localized: 'Courier: Với cả, giờ có học cũng chẳng để làm gì, thời buổi này còn ai thuê mướn tôi nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267345
    m_Localized: 'Courier: Thôi, kệ đi. Đời shipper cũng không đến nỗi nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267344
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267343
    m_Localized: 'Courier: Ờ, anh nói nghe dễ quá. Ở chung với biết bao nhiêu người thế kia mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267342
    m_Localized: Buồn thật nhỉ
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267341
    m_Localized: Ở một mình cũng không tệ lắm đâu
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267340
    m_Localized: 'Courier: Đã vậy gia đình tôi còn ở xa nữa chứ. Vốn tôi chẳng phải dân vùng này, chỉ một thân một mình lên đây để học đại học thôi…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267339
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267338
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267336
    m_Localized: 'Courier: Đây nhé: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267335
    m_Localized: (Nhận hàng)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267334
    m_Localized: 'Courier: Ấy, xin lỗi anh nhé, nói một hồi tôi quên mất công chuyện luôn. Anh kiểm tra lại đơn hàng chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267333
    m_Localized: 'Courier: Thiên hạ giờ ai ai cũng gọi một lần đến 20 lít nước. Phải chi có thêm phụ phí rủi ro hay tiền boa cho mỗi lần vác đống đồ này thì đã ngon rồi…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267332
    m_Localized: 'Courier: Giờ cả đám tụi tôi toàn phải đi làm ca đêm… tại cái mặt trời chó chết này hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267331
    m_Localized: 'Courier: Ừ thì biết là nhờ thế mà dân shipper mới ăn nên làm ra. Nhưng nói gì thì nói, nghề này vẫn nguy hiểm chết người chứ chẳng chơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267330
    m_Localized: 'Courier: Đúng kiểu nước tới cổ rồi mà còn bình chân như vại. Thế giới có ra sao thì người ta vẫn gọi đồ ăn như thường!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267329
    m_Localized: 'Courier: Nói chứ, tôi cũng hơi bị bất ngờ là có người chả thèm tích trữ đồ phòng khi tận thế đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073033
    m_Localized: Tôi không nhận hối lộ đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073032
    m_Localized: Thôi được rồi, anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073031
    m_Localized: 'GraveDigger: Hay lấy {0} nha? Được hông nờ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073030
    m_Localized: 'GraveDigger: Phải như nào mới chịu cho tui vô đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073029
    m_Localized: 'GraveDigger: Ông nội ơi, sao mà mần khó nhau dữ dị! Hay để tui đưa cậu cái chi thử?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073028
    m_Localized: Tôi không nhận hối lộ đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073027
    m_Localized: 'Thôi được rồi, ông vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073026
    m_Localized: 'Marauder: Ờ hơ! Ra rầu. Cho cậu {0} nè. Đổi lại cậu cho tôi trú nhờ một đêm nghen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073025
    m_Localized: 'Marauder: Có con dao nè, cái này mình cần... Bông băng nè, cần luôn... Có cái bình nước, mà hết trơn rầu... Cũng hổng để làm gì...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073024
    m_Localized: 'Marauder: Ê cha ơi, đừng có đuổi tui đi mà... Từ từ để tui lục lại trong túi đã, coi có cái gì hông.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878746
    m_Localized: 'Wolfhound: Giờ nà thời đại cá nớn nuốt cá bé. Theo dòng thì nổi, ngược dòng thì chìm chết cha nhà mày. '
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878745
    m_Localized: 'Wolfhound: Thế nà mày biết khôn đó Diễm.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878744
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878743
    m_Localized: Để tôi xử lý cho. Ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878739
    m_Localized: Thôi được rồi, chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878738
    m_Localized: 'Twins: {0}. Đây, chú cầm lấy đi. Có khi lại cần.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878737
    m_Localized: 'Twins: Nhỏ em chị... nó đang vô cùng bất ổn. Nhưng bọn chị có... cái đó tên gì ấy nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878736
    m_Localized: 'Twins: Chị hiểu, chú chả quen gì bọn chị. Chắc chú nghĩ hai kẻ này chỉ gây phiền hà. Nhưng bọn chị hứa sẽ biết điều mà, thề với chú luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878735
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878733
    m_Localized: 'Twins: Họ làm chị nhớ tới... bố mẹ... Tình trạng của nó đang như này thì đây không phải là không gian sống lành mạnh đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878732
    m_Localized: 'Twins: Không ổn rồi... Họ mà ở đây thì khổ cho em chị lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878731
    m_Localized: 'Twins: Chị thấy chú có {0} và {1} trong nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878730
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878729
    m_Localized: "Để tôi đuổi ra cho. \nChị vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878728
    m_Localized: 'Twins: Hai bên khó mà hòa thuận với nhau được.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878724
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878723
    m_Localized: "Để tôi đuổi ra cho. \nChị vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878722
    m_Localized: 'Twins: Ở với họ khéo nó điên mất. Nó cần được yên bình, chứ không cần phán xét.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878721
    m_Localized: 'Twins: Chị cảm nhận được là cách người đó... giao tiếp... sẽ ảnh hưởng đến em chị.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878720
    m_Localized: 'Twins: Hình như trong nhà chú đang có {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684420
    m_Localized: Thôi bà đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684419
    m_Localized: "Để tôi đuổi ra cho. \nBà vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684418
    m_Localized: 'Greatmother: Đuổi nó đi con, để mạ vô ngồi chỗ nớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684417
    m_Localized: 'Greatmother: Thôi, mấy đứa như ri chả được cấy tích sự chi hết, nuôi chỉ tổ tốn súp tốn mì.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490118
    m_Localized: 'Widow: Cám ơn cậu, tôi chỉ xin ở nhờ dăm ba bữa... để nghỉ ngơi lại sức chút thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490117
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490116
    m_Localized: "Để tôi đuổi ra cho. \nChị vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490115
    m_Localized: 'Widow: Tôi chả muốn ở chung nhà với hạng người đó đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490114
    m_Localized: 'Widow: Thôi khỏi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490112
    m_Localized: 'Widow: Cám ơn lòng tốt của cậu. Hông như...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446750101504
    m_Localized: Tôi không nhận hối lộ đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907213
    m_Localized: Thôi được rồi, anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907212
    m_Localized: 'Luka: Cậu thích không?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907211
    m_Localized: 'Luka: Tớ có mang theo {0} nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907210
    m_Localized: 'Luka: Không sao hết nha! Nhưng cậu có đang cần gì không nhỉ? Biết đâu tớ lại giúp được.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907209
    m_Localized: Tôi không nhận hối lộ đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907208
    m_Localized: Thôi được rồi, hai người vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907207
    m_Localized: 'Couple: Chú thấy được không? Làm phước giúp vợ chồng tôi đi mà?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907206
    m_Localized: 'Couple: Có {0} thì sao? Chú lấy hết luôn cũng được, bù lại chú thương cho vợ tôi chỗ nghỉ chân chốc lát.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907205
    m_Localized: 'Couple: Thay vì áo thì tôi có thể cho chú món này…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907204
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907203
    m_Localized: 'Couple: Nói mới nhớ…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907202
    m_Localized: 'Couple: Tôi yêu cô ấy nhiều lắm. Tôi sẵn sàng đưa chú chiếc áo đang mặc này, đổi lấy chỗ trú an toàn cho vợ tôi với.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907201
    m_Localized: 'Couple: Vợ tôi mấy hôm nay yếu lắm, đi một tí đã mệt rồi. Vì vợ thì chuyện gì tôi cũng dám làm hết... chú hiểu không?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907200
    m_Localized: 'Couple: Tôi biết là van xin thế này làm chú khó xử lắm. Nhưng mà… xin chú… thương cho vợ chồng tôi với.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712914
    m_Localized: Tôi không nhận hối lộ đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712913
    m_Localized: Thôi được rồi, ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712912
    m_Localized: 'Wheelchair: Hổng tin ông cứ coi thử cặp giò tui nè! Đâu thấy gì đâu đúng hông? Chuẩn đét!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712911
    m_Localized: 'Wheelchair: Hiệu quả cực kỳ luôn á!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712910
    m_Localized: 'Wheelchair: Hổng cho tui vô hả? Nè! Cầm {0} này, chọi vô cửa, xong bùm một phát! Ông sẽ biến thành người vô hình.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712909
    m_Localized: Tôi không nhận hối lộ đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712908
    m_Localized: Thôi được rồi, ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712907
    m_Localized: 'Dude: Đây nhá: {0}! Mận chưa mận chưa! Y chang trong game luôn. Kiểu tui tặng cái này thì sẽ tăng độ hảo cảm gì đó, đúng hông ta?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712906
    m_Localized: 'Dude: Chờ xíu nha con vợ, tui có cái này hay lắm. Đảm bảo ông ngó cái là mê liền.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712905
    m_Localized: 'Dude: Thôi mà, brooooo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712904
    m_Localized: Tôi không nhận hối lộ đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712903
    m_Localized: Thôi được rồi, anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712902
    m_Localized: 'Blind: Hình như đây là {0}. Cậu cứ cầm lấy. Tôi cần ít nhất một ngày để hồi sức. Nhưng... chẳng biết có được không nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712901
    m_Localized: 'Blind: Làm... Làm ơn chờ chút. Tôi có cái này...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712900
    m_Localized: Tôi không nhận hối lộ đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712899
    m_Localized: Thôi được rồi, ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712898
    m_Localized: 'Fatman: Thấy sao hả? Kèo thơm chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712897
    m_Localized: 'Fatman: Đây anh biếu, à hèm, chút quà... {0}. Chú cầm lấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712896
    m_Localized: 'Fatman: À đây... "Bôi trơn" bằng cái này là được ngay chứ gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518610
    m_Localized: Tôi không nhận hối lộ đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518609
    m_Localized: Thôi được rồi, cậu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518608
    m_Localized: 'Bestson: À mà em còn đem theo... kẹo cao su nữa. Còn mấy miếng thôi à, nhưng nếu anh muốn thì cứ lấy thoải mái nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518607
    m_Localized: 'Bestson: Hay anh muốn em phải đưa cái gì đó hở? Có {0} được hông anh?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518606
    m_Localized: 'Bestson: Em... Em hổng biết phải làm gì luôn á...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518605
    m_Localized: Tôi không nhận hối lộ đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518604
    m_Localized: Thôi được rồi, anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518603
    m_Localized: 'Fugitive: Xin cậu đấy... Ở ngoài này tôi chết mất!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518602
    m_Localized: 'Fugitive: Năn nỉ cậu luôn đó... Muốn gì trên người tôi thì cứ lấy. Này, {0} đủ không? Tôi chỉ còn chừng này thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518601
    m_Localized: 'Fugitive: Cái địt cụ, tôi đang chảy máu xối xả trước cửa nhà cậu này... Giờ có cho vào băng bó giúp tôi không, hay để tôi chết rục ở đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518600
    m_Localized: 'Wifefema: Thôi. Tiên sư con mẹ mày. Tao sang hỏi mấy nhà hàng xóm còn hơn. Chào nhá thằng đầu khấc.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518599
    m_Localized: 'Wifefema: ... '
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518598
    m_Localized: 'Wifefema: Đầu óc mày có bị làm sao không? Chị đã hết lòng kể lể mà mày gạt phăng hết con mẹ đi luôn?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518597
    m_Localized: 'Wifefema: Cái thằng này, mày chán sống lắm rồi à? Chồng chị làm bên Phòng Chống đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518596
    m_Localized: 'Tôi không nhận hối lộ đâu nhé '
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518595
    m_Localized: Thôi được rồi, chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518594
    m_Localized: 'Wifefema: Giấy xác nhận cách ly này, chó săn này... Cho bọn nó ngày nào cũng cắm rễ ở đây luôn. Thấy không vấn đề gì thì cứ việc đuổi chị đi cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518593
    m_Localized: 'Wifefema: Rượu mời không uống, muốn uống rượu phạt à? Giờ chị chỉ cần nói một tiếng với chồng là sáng mai mấy tay áo vàng tới dọn sạch nhà chú luôn nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518592
    m_Localized: 'Wifefema: Đơn giản thế này nhé, chị đưa trước cho chú {0} rồi chú cho chị vào, được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446720741376
    m_Localized: 'Wifefema: Chị bảo này, mũi chị thính lắm. Chị ngửi ra được đứa nào khả nghi với đứa nào là Dị Khách luôn cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863213
    m_Localized: 'Intruder: Mong sao tôi sẽ thiếp đi được một chút... Đã lâu lắm rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863212
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863211
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863210
    m_Localized: 'Intruder: Trước kia, tôi từng bắt gặp kẻ này trong mơ. Một lần là quá đủ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668876
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668875
    m_Localized: 'Foreigner: (Xem ra anh ta không ưa {0}. Ảnh làm điệu bộ chỉ tay vào người đó, chỉ bản thân, rồi lại chỉ họ lần nữa)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668874
    m_Localized: 'Foreigner: Ưmmmmm... Phưmmm!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668871
    m_Localized: 'Doctor: Cảm ơn cháu. Bác chỉ mong có thể giúp được ai đó quanh đây thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668870
    m_Localized: Thôi bác đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668869
    m_Localized: Để tôi đuổi ra cho. Bác vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668868
    m_Localized: 'Doctor: Tốt nhất là nên đi tìm ai đó thực sự có khả năng giúp đỡ thì hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668867
    m_Localized: 'Doctor: Bác không thể điều trị hay chăm sóc tận tình cho cậu ta được.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474577
    m_Localized: 'NotTrue: Vậy thì cháu giai, chịu khó tìm cho ngoại một chiếc ghế đẩu được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474576
    m_Localized: 'NotTrue: Ôi cảm ơn cháu giai! Cầu phước cho cả ba họ nhà cháu! Tội nghiệp, phải đuổi đứa kia ra ngoài để cho bà già này vào...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474575
    m_Localized: Thôi bà đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474574
    m_Localized: "Để cháu đuổi ra cho. \nBà vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474573
    m_Localized: 'NotTrue: Thôi, cháu cho ngoại ngồi đây nghỉ ngơi chút, rồi ngoại lại đi tiếp ngay.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474572
    m_Localized: 'NotTrue: Đi với ma thế, có ngày gặp quỷ đấy cháu à.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474571
    m_Localized: 'NotTrue: Ôi giời ơi, đúng là phải phước! Sao {0} lại ngồi chễm chệ ở chỗ của ngoại thế này.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474570
    m_Localized: 'Daughter: OAAAAAAAAAAAAA!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474567
    m_Localized: 'Daughter: BIẾT ĐI CHỖ NÀOOOO?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474566
    m_Localized: 'Daughter: BAAAAAAA! BA ƠIIIII!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474565
    m_Localized: Thôi con đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474564
    m_Localized: "Để chú đuổi ra cho. \nCon vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474563
    m_Localized: 'Daughter: Con muốn gặp baaaaaaaaa...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474562
    m_Localized: 'Daughter: Nhưng con... con chỉ muốn ngồi chỗ đó thôi à! Muốn, muốn, muốn lắm luôn! Tại chỗ đó... chỗ đó hồi xưa là chỗ ba ngồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280298
    m_Localized: 'Scammer: Kệ cha mày. Mày không ngu thì còn đứa khác ngu. Đéo thân ái nhé thằng đầu khấc!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280297
    m_Localized: 'Scammer: Mẹ bà nó. Đéo có tình nghĩa anh em gì hết. Tao đây không chơi với mấy thằng đàn bà.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280296
    m_Localized: 'Scammer: Hết nước chấm luôn! Lát tạt qua chỗ anh tí nhớ. Anh cho chú mày vài cái ý tưởng cháy vãi cứt luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280295
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280294
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280293
    m_Localized: 'Scammer: Chú đuổi khứa đó ra cho anh là ngon lành cành đào.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280292
    m_Localized: 'Scammer: Này nhá, chỗ anh em anh nói thật. Anh thấy chú đang có {0} trong kia rồi. Lồn bọn này vắt chả được nước mẹ gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280289
    m_Localized: 'Cold: H-Hiểu rồi. V-Vậy để tôi đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280288
    m_Localized: 'Cold: C-Cảm ơn cậu. Như vậy an toàn hơn nhiều, tôi đảm bảo đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280287
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280286
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280285
    m_Localized: 'Cold: Tôi... Tôi sợ ở chung phòng với ng-người khác lắm. K-Kiểu gì cũng có chuyện không hay cho xem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280284
    m_Localized: 'Cold: C-Cảm ơn cậu. À, nhưng mà tôi không ở cùng với {0} được.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280283
    m_Localized: 'Esenin: Ờ địt con mẹ chú nhé. Nhìn mặt là biết cái kiểu vào quán bar mà đi gọi nước lọc rồi. Hãm tài.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891690
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891689
    m_Localized: 'Luka: Nhưng nếu cậu chịu khó dọn được chỗ cho tớ nhờ thì tớ rất biết ơn luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891688
    m_Localized: 'Luka: Tớ chẳng muốn đuổi người ta ra ngoài đâu. Lỡ họ cần chốn dung thân hơn tớ thì sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891685
    m_Localized: 'Couple: Mình đi tìm nhà khác thôi cưng nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891684
    m_Localized: 'Couple: Thế à, vậy thôi. Xin lỗi đã làm phiền chú nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891683
    m_Localized: 'Couple: Có gì mà phải ngại! Đi nào, vào nhà nghỉ ngơi cho lại sức đi cưng.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891680
    m_Localized: Thôi hai người đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891679
    m_Localized: "Để tôi đuổi ra cho. \nAnh chị vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891677
    m_Localized: 'Couple: Này, tôi cũng không muốn làm khó chú. Nhưng nói thật… bọn tôi không thể ở cùng với {0} được đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891676
    m_Localized: 'Couple: Kia là ai vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891673
    m_Localized: 'Anger: ĐỊT MẸ nhà mày luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891672
    m_Localized: 'Anger: Cứ ngoan ngoãn liếm giày bọn nó đi, liếm tới khi lòi bản họng mày thì thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891669
    m_Localized: 'Anger: Tôi mà đánh thì chỉ có tự đánh mình thôi. Không để ai liên lụy đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891668
    m_Localized: 'Anger: Cũng thề không đập phá đồ đạc trong nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891667
    m_Localized: 'Anger: Cứ yên tâm, tôi không giận cá chém thớt đâu mà lo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891664
    m_Localized: 'Mother: Không... Phải kịp... Nhất định phải kịp chứ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891663
    m_Localized: 'Mother: Mà hổng biết có tới kịp hông nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891662
    m_Localized: 'Mother: Thôi được rồi. Đi con… Mình ráng thêm một xíu tới khi qua chỗ ba nha. Thằng chả khó ưa gì đâu á, nhưng đành chịu thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891659
    m_Localized: 'Thôi chị đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891658
    m_Localized: "Để tôi đuổi ra cho. \nChị vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891657
    m_Localized: 'Mother: Hay là… như vầy đi… em đuổi người ta ra được hông. Thương giùm đứa nhỏ với. Mấy nay nó ngủ có yên giấc đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891654
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891653
    m_Localized: 'Ballerina: Thấy cục bông này? Không ngu như cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891652
    m_Localized: 'Ballerina: Nào bé con. Làm chị vui đi nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891651
    m_Localized: Thôi cô đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891650
    m_Localized: "Để tôi đuổi ra cho. \nCô vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697379
    m_Localized: 'Teacher: Cảm ơn em rất nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697378
    m_Localized: Thôi cô đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697377
    m_Localized: "Để em đuổi ra cho. \nCô vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697376
    m_Localized: 'Teacher: Cô thật tình xin lỗi...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697373
    m_Localized: 'Teacher: Cô... Cô không thể sống chung với loại người như vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697372
    m_Localized: 'Teacher: Cô xin lỗi, nhưng hình như... đang có {0} trong nhà em à?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697371
    m_Localized: 'Dude: Bảo trọng nhé bạn tui... Nhớ chăm sóc tốt mấy cốt của bro nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697370
    m_Localized: 'Dude: Thôi hông sao đâu bro. Tui hiểu mà. Mình cứ chill hoy, tui hông để bụng gì hết á.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697369
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697366
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697365
    m_Localized: "Để tôi đuổi ra cho. \nÔng vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697364
    m_Localized: 'Dude: Nhìn thôi là thấy cờ đỏ rồi... Đuổi liền đi bạn ơi!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697363
    m_Localized: 'Dude: Ê hổng được đâu nha, con vợ ơi. Khứa này phá mood kinh luôn á...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697362
    m_Localized: 'Dude: Cái {0} kia là ai đó?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697361
    m_Localized: 'Dude: Êêêêêêê... Xí nha, khoan…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697360
    m_Localized: 'Blind: Bằng không thì NÓ sẽ tìm ra cậu đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697359
    m_Localized: 'Blind: Nghe lời tôi, nhớ đừng lại gần mấy thi thể cháy đen ngòm vào ban đêm nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697346
    m_Localized: "Để tôi đuổi ra cho. \nÔng vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114453
    m_Localized: 'Wifefema: Mày đùa với tao đấy hả? Này nhá, ông xã tao làm bên Phòng Chống đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114452
    m_Localized: 'Wifefema: Bố tổ sư mấy bọn ăn bám này... Tránh đường ra cho tao!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114451
    m_Localized: 'Thôi chị đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114450
    m_Localized: "Để tôi đuổi ra cho. \nChị vào đi "
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114449
    m_Localized: 'Wifefema: Mày nhanh đuổi cổ nó ra ngoài đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114448
    m_Localized: 'Wifefema: Loại này chị còn lạ gì. Đáng nhẽ mày đừng nên cho cái ngữ như nó vào nhà. Chỉ tổ rước họa vào thân.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114447
    m_Localized: 'Wifefema: {0} kia là ai thế hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114446
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114445
    m_Localized: 'Theorist: Vĩnh biệt! Dốt như chú chết trẻ là cái chắc!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114444
    m_Localized: 'Theorist: Chỉ có những kẻ ngu si, thiển cận mới dễ dàng quay lưng với sự thật như vậy!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114443
    m_Localized: 'Theorist: Chú... chú...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114442
    m_Localized: 'Theorist: Hả? Sao lại "đi ra chỗ khác" là như nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114441
    m_Localized: 'Theorist: Nghe tôi nói xong, đảm bảo chú sẽ nhìn đời bằng ánh mắt khác!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114440
    m_Localized: 'Theorist: Chú lựa chọn sáng suốt đó! Cứ tin tôi đi, đảm bảo chú không hối hận đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114439
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114438
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114437
    m_Localized: 'Theorist: Đuổi nó đi thì tôi sẵn sàng vào nhà chú ngay!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114436
    m_Localized: 'Theorist: Nó mà ở đấy thì tôi còn lâu mới hé nửa lời!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114435
    m_Localized: 'Theorist: Cái... cái đồ... {0} kia!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114434
    m_Localized: 'Theorist: Ấy không, không nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114432
    m_Localized: 'Theorist: Mà... ai ở trong kia thế hả chú?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077071142912
    m_Localized: 'Theorist: Tuyệt vời!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633031
    m_Localized: Để chú đuổi ra cho. Cháu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200655
    m_Localized: 'FatalDame: Cưng bị cha bạo hành ư? Ôi thôi thương quá. Cũng may là chuyện đã qua rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200627
    m_Localized: 'FatalDame: Cưng đã quen dần chưa nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200626
    m_Localized: 'FatalDame: Cuộc sống mới sao rồi, cưng ơi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200621
    m_Localized: 'Vigilante: Cút. Đéo ai thèm ngửi cái nách mày.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200620
    m_Localized: 'Vigilante: Ông đéo cần biết dưới nách mày mọc cái giống gì nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200598
    m_Localized: 'Vigilante: Đầu tiên cho con mụ ấy một viên trước. Rồi đến thằng chồng. Mấy đứa con thì cùng hàng xóm chạy đi rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200597
    m_Localized: 'Vigilante: Đến lúc lũ Dị Khách leo lên tận mái nhà thì thằng ngu đó mới mở cửa. Thả con mụ ấy ra cho chạy. Nó nhát tay quá thì ông làm hộ vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200580
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200579
    m_Localized: 'Vigilante: Thế giới này loạn nháo nhào cũng vì những thằng hèn nhát như nó chứ gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200578
    m_Localized: 'Vigilante: Mẹ cái thằng dái bé, gặp tí chuyện là nhót ngay. Tại nó mà cả nhà chết mất mẹ xác rồi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200577
    m_Localized: 'Vigilante: Như mọi khi thôi. Đã nhắc thằng em bao nhiêu lần rồi: "Đàn ông đàn ang thì phải lo cho gia đình". Xong mày biết nó làm gì không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006363
    m_Localized: 'Miner: Chả biết ai đào hay đào làm gì. Nhưng mà đoán thì BỌN TÔI ĐOÁN ĐƯỢC RỒI nhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006362
    m_Localized: 'Miner: Mới đào được có xíu mà đã trúng số độc đắc rồi: trúng nguyên một HỆ THỐNG ĐƯỜNG HẦM luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006361
    m_Localized: 'Miner: CHỖ TRÚ CHỨ CÒN GÌ NỮA! Đang nắng thấy bà ra, không trú thì chết khét cả đám à!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006360
    m_Localized: Bác tìm được Dị Khách hay sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006359
    m_Localized: Cái gì thế bác? Có gì hay ho không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006358
    m_Localized: 'Miner: Nhưng mà THÔI KỆ. Tụi tôi mới tìm được CÁI KHÁC đây này!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006357
    m_Localized: 'Miner: Mấy đường hầm này sâu lắm. SÂU HUN HÚT LUÔN. Đi không biết khi nào mới hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006356
    m_Localized: 'Miner: Mà trước còn nhiều hơn cơ. Mới bị sập bớt mấy cái rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006355
    m_Localized: 'Miner: Mới bắt tay đào chưa được bao nhiêu... Thế mà ĐÂY, tìm được NGUYÊN MỘT HỆ THỐNG ĐƯỜNG HẦM đào sẵn rồi đây này!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006354
    m_Localized: 'Miner: Chả là tôi với mấy thằng bạn muốn đào hầm đặng tránh nóng ấy mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006353
    m_Localized: Bác đang tìm gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006352
    m_Localized: Sao bác lại ở dưới đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006351
    m_Localized: 'Miner: Bụi bặm bám đầy lỗ tai, tôi nghe tiếng cậu NHƯ VỊT NGHE SẤM vậy. Má nó chớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006350
    m_Localized: 'Miner: Kẹt gì? CÓ KẸT ĐÂU! Mới tìm thấy cái này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006349
    m_Localized: 'Miner: HỞ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006348
    m_Localized: Bác đang tìm gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006347
    m_Localized: Sao bác lại ở dưới đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006346
    m_Localized: 'Miner: Úi chà, miễn không rơi trúng đầu bọn tôi là được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006345
    m_Localized: 'Miner: Trên kia là nhà cậu á?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006344
    m_Localized: 'Miner: Tai tôi toàn đất với cát thôi, CHẢ NGHE ĐƯỢC GÌ CẢ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006343
    m_Localized: 'Miner: HẢ GÌ? Nói to lên với!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006342
    m_Localized: Bác bị kẹt dưới đó à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006341
    m_Localized: Bác làm gì dưới lòng đất nhà tôi vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006340
    m_Localized: 'Miner: ...Chả lẽ do mình tưởng tượng ra?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006339
    m_Localized: 'Miner: Hả? AI ĐẤY? Mới nghe thấy tiếng gì mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006338
    m_Localized: 'MushroomEater: Bái bai con trai!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006337
    m_Localized: 'MushroomEater: Già chúc con một buổi tối vui vẻ, sức khỏe dồi dào, lời chào hân hoan và ngập tràn tiếng cười.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006336
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006335
    m_Localized: 'MushroomEater: Vậy là coi như hy vọng tắt ngúm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006334
    m_Localized: 'MushroomEater: Ôi trời...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006333
    m_Localized: Thôi ạ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006332
    m_Localized: Vâng ạ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006331
    m_Localized: 'MushroomEater: Già hỏi con một lần nữa: Con đi cùng với già nghe, con trai?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006330
    m_Localized: 'MushroomEater: Già không biết điều gì đương chờ đợi ta ở Xứ Nấm... Nhưng chắc chắn... đó là vô vàn hiểm nguy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006297
    m_Localized: 'MushroomEater: Ờ thì, Lễ Hội sẽ khiến bầy nấm lớn nhanh như bão, không sao kiểm soát nổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006296
    m_Localized: Nghe cũng đâu đến nỗi nào nhỉ...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006295
    m_Localized: Xứ Nấm ấy ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006294
    m_Localized: 'MushroomEater: Đã tới nước này rồi thì... không còn cách nào khác. Đành phải dấn thân vào Xứ Nấm mà thôi, con à.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006293
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006292
    m_Localized: 'MushroomEater: Nhưng rồi dạo này dã tâm dồn nén quá nhiều, làm phình to cả cây nấm. Giờ nó lớn đến độ phì đại luôn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006291
    m_Localized: 'MushroomEater: Bầy nấm cũng như lá gan, cố gắng thải độc tố ra khỏi cơ thể.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006290
    m_Localized: 'MushroomEater: Có quá nhiều sự tà ác tích tụ bên trong tế bào... gây tắc nghẽn hết cha nó mọi thứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006289
    m_Localized: 'MushroomEater: Con ơi là con, hệ sợi nấm bị cái gì làm bung bét hết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006288
    m_Localized: Lễ Hội này mục đích để làm gì vậy ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006287
    m_Localized: Sao lại không được hở ông?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006286
    m_Localized: 'MushroomEater: Bên trong hệ sợi nấm quá náo loạn, quá hỗn mang... Thành thử ra nghi lễ cũng hổng xi nhê gì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006285
    m_Localized: 'MushroomEater: Chèn ơi... Vậy là cuối cùng Lễ Hội vẫn đến...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006284
    m_Localized: 'MushroomEater: Hẹn ngày gặp lại, con trai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006283
    m_Localized: 'MushroomEater: Nhớ nha con, đừng có trông mặt mà bắt hình nấm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006282
    m_Localized: 'MushroomEater: Chúng ta phải tìm mọi cách kìm hãm bầy nấm, như vậy mới có thể ngăn chặn được Lễ Hội.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006281
    m_Localized: 'MushroomEater: Khi thời khắc chín muồi, già sẽ quay trở lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006280
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006279
    m_Localized: 'MushroomEater: Hệ sợi nấm chính là đầu não. Tiếc rằng già chỉ nghe hiểu được thôi... Còn tụi nó thì đương nhiên không hiểu tiếng người rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006278
    m_Localized: 'MushroomEater: Than ôi, nó liên kết chặt chẽ với cả một mạng lưới loài nấm!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006277
    m_Localized: 'MushroomEater: Phải, ý rất hay... Nhưng đáng tiếc, già không có cách nào giao tiếp được với tụi nấm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006276
    m_Localized: 'MushroomEater: Hẹn ngày gặp lại, con trai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006275
    m_Localized: 'MushroomEater: Nhớ nha con, đừng có trông mặt mà bắt hình nấm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006274
    m_Localized: 'MushroomEater: Chúng ta phải tìm mọi cách kìm hãm bầy nấm, như vậy mới có thể ngăn chặn được Lễ Hội.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006273
    m_Localized: 'MushroomEater: Khi thời khắc chín muồi, già sẽ quay trở lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006272
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006271
    m_Localized: 'MushroomEater: Chính là những điều mà chúng ta vừa làm đó con.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006270
    m_Localized: 'MushroomEater: Nhưng Sách Nụ Cười đã chỉ cho mình biết: cách xoa dịu gốc rễ và kìm hãm sự phát triển của chúng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006269
    m_Localized: 'MushroomEater: Mình không thể nào nói chuyện trực tiếp với nấm đâu con! Mình là người mà, có phải một phần của mạng lưới đó đâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006268
    m_Localized: 'MushroomEater: Cái mà mình làm là một nghi thức cổ, con ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006267
    m_Localized: Sao ông không bảo mấy cây nấm đừng tổ chức Lễ Hội nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006266
    m_Localized: Làm như này thì ngăn chặn Lễ Hội Nấm kiểu gì hả ông?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006265
    m_Localized: 'MushroomEater: Giờ già con mình chỉ còn nước cầu trời khấn chúa, cho nấm nó đừng có lớn thêm nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006264
    m_Localized: 'MushroomEater: Ôi con trai ơi... Mọi sự nó đâu có đơn giản như vậy. Già cũng chẳng biết mình làm theo sách là đã ổn chưa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006263
    m_Localized: Sao ông không bảo mấy cây nấm đừng tổ chức Lễ Hội nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006262
    m_Localized: Làm như này thì ngăn chặn Lễ Hội Nấm kiểu gì hả ông?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006261
    m_Localized: 'MushroomEater: Tụi nấm đương lớn nhanh như thổi con ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006260
    m_Localized: 'MushroomEater: Nó biết đủ thứ trên đời hết con à. Nhưng giờ chính nó cũng đương gặp nguy hiểm... như tất thảy chúng ta luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006259
    m_Localized: 'MushroomEater: Ôi con ơi, già biết chứ! Chính hệ sợi nấm đã kể cho già nghe mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006258
    m_Localized: Nghe ông có vẻ bán tín bán nghi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006257
    m_Localized: Sao ông biết chuyện đó được?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006256
    m_Localized: 'MushroomEater: Vái trời nhiêu đó là đủ để ngăn chặn Lễ Hội Nấm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006255
    m_Localized: 'MushroomEater: Ô hô, lại gặp con rồi! Vậy là con trai đã nghe lời già, làm hết mấy điều trang Sách Nụ Cười hướng dẫn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006254
    m_Localized: 'MushroomEater: Hầy, đúng thiệt là... Mấy đứa con nít con nôi, nói chuyện chỉ tổ phí thời gian...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006253
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006252
    m_Localized: 'MushroomEater: Ủa, chi vậy con? Già cầm cuốn này bao lâu nay rồi... thuộc làu làu từng câu từng chữ luôn...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006251
    m_Localized: 'MushroomEater: Già chúc con một buổi tối vui vẻ, sức khỏe dồi dào, lời chào hân hoan và ngập tràn tiếng cười. Bái bai con trai!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006250
    m_Localized: 'MushroomEater: Chừng nào con sắp xếp gọn gàng xong xuôi, già sẽ quay lại sau! Lẹ tay nhe con ơi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006249
    m_Localized: 'MushroomEater: Vậy thôi... Già xin phép cáo từ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006246
    m_Localized: Rồi, cười thì cười, đưa mấy trang sách cho con
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006245
    m_Localized: 'MushroomEater: Già đã xé ra vài trang giấy trong Sách Nụ Cười. Con hãy cầm lấy, tham khảo để biết mình nên làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006244
    m_Localized: 'MushroomEater: Quỷ thần ơi! Như vậy không có được, tuyệt đối không được! Con ơi, già con mình phải hợp sức ngăn nó lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006243
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006242
    m_Localized: 'MushroomEater: Nhưng nấm chẳng hề cô độc chốn đây. Vì Lễ Hội luôn sướng vui sum vầy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006241
    m_Localized: 'MushroomEater: Hắn tỏa bóng dần, bao trọn vầng thái dương. Bốn bể năm châu, đâu cũng sẽ "lên đường"...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006240
    m_Localized: 'MushroomEater: Sẽ có ngày nấm khổng lồ trỗi dậy. Gieo bào tử kín dày khắp tứ phương...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006239
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006238
    m_Localized: 'MushroomEater: Cái đó mình phải tra Sách Nụ Cười mới biết được!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006237
    m_Localized: 'MushroomEater: Hô hô, con trai ơi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006236
    m_Localized: Thôi ông cứ giữ lấy mà cười
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006235
    m_Localized: Rồi, cười thì cười, đưa mấy trang sách cho con
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006234
    m_Localized: 'MushroomEater: Nên già chỉ xé ra mấy trang quan trọng nhất mà thôi. Đây... con hãy xem đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006233
    m_Localized: 'MushroomEater: Nhưng thánh thần thiên địa ơi, thì giờ đâu mà đọc hết. Sách thì dày cộp... mà thời gian thì hổng có bao nhiêu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006232
    m_Localized: 'MushroomEater: Ừa, cuốn sách này cực kỳ đặc biệt. Phải gọi là có một không hai trên Trái Đất luôn! Nó sẽ chỉ cho ta biết nên làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006231
    m_Localized: Lễ Hội Nấm ư?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006230
    m_Localized: Sách Nụ Cười á?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006229
    m_Localized: 'MushroomEater: Úm ba la, con nhìn nè: Sách Nụ Cười đó! Chính bí kíp này sẽ giúp chúng ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006228
    m_Localized: 'MushroomEater: Hà hà! Cứ từ từ, rồi con sẽ hiểu thôi. Nhưng làm gì thì làm, ta phải tìm cách ngăn chặn Lễ Hội này. Bằng mọi giá!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006227
    m_Localized: Lễ Hội Nấm ư?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006226
    m_Localized: Sách Nụ Cười á?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006225
    m_Localized: 'MushroomEater: Nó báo rằng Lễ Hội Nấm sắp sửa tới gần... Như vầy là chết, chết tới nơi rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006224
    m_Localized: 'MushroomEater: Già đã đọc hết Sách Nụ Cười để lĩnh hội được tiếng nấm rồi. Mà những gì tụi nó mới nói với già... Ôi trời, tệ lắm con ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006223
    m_Localized: 'MushroomEater: Con biết hông, loài nấm giao tiếp với nhau bằng hệ sợi nấm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006222
    m_Localized: 'MushroomEater: Ừa ừa, nghe kỳ cục khó hiểu lắm đúng hông? Già biết mà. Người trần mắt thịt khó mà nắm bắt được ngôn ngữ của tụi nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006221
    m_Localized: Là sao con chưa hiểu
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006220
    m_Localized: Hệ sợi nấm là gì cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006219
    m_Localized: 'MushroomEater: Nên là con dỏng cái tai lên, nghe cho rõ nè. Còn nhiều việc phải làm lắm, mà thời giờ thì rất chi là eo hẹp!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006218
    m_Localized: 'MushroomEater: Ngôn ngữ của tụi nó lằng quằng khó hiểu lắm, nhưng già đã thẩm thấu xong rồi! Nó bắn tín hiệu gì, già nghe được hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006217
    m_Localized: 'MushroomEater: Ô hô! Già chưa có quen, nhưng mà già biết! Biết rành con là ai luôn! Hệ sợi nấm đã thì thầm với già!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006216
    m_Localized: Là sao con chưa hiểu
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006215
    m_Localized: Hệ sợi nấm là gì cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006214
    m_Localized: 'MushroomEater: Nên là con dỏng cái tai lên, nghe lời già nói cho thiệt kỹ nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006213
    m_Localized: 'MushroomEater: Lễ Hội Nấm sắp bắt đầu! Thời gian hổng còn bao lâu nữa, con ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006212
    m_Localized: 'MushroomEater: Nhưng đừng bận tâm tới già làm chi! Hệ sợi nấm đã báo cho già một tin khẩn cấp...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006211
    m_Localized: 'MushroomEater: Ô hô hô hô! Già đây chỉ là một ông lão xà lơ, chẳng qua biết được dăm điều về nấm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006210
    m_Localized: Mình có quen nhau không nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006209
    m_Localized: Ông là ai vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006208
    m_Localized: 'MushroomEater: Úi chà, chào con trai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812165
    m_Localized: 'CultistPriest: Điều nên làm đã được hoàn tất.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812164
    m_Localized: 'CultistPriest: Dù sao đi nữa, ta vẫn thực lòng cảm kích. Tạm biệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812163
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812162
    m_Localized: 'CultistPriest: Hay có lẽ, bình an vốn chẳng phải là thứ anh khát cầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812161
    m_Localized: 'CultistPriest: Tín hữu của ta thực sự gây phiền hà cho anh đến vậy sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812160
    m_Localized: 'CultistPriest: Vậy ta sẽ dẫn họ theo. Xin gửi lời cảm tạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812159
    m_Localized: 'CultistPriest: Thôi được... anh cũng đã giúp chúng ta nhiều rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812158
    m_Localized: Đây là cái nhà trẻ à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812157
    m_Localized: Tha tôi giùm cái
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812156
    m_Localized: 'CultistPriest: Không còn cách nào khác, chúng ta buộc phải tiếp tục khấn nguyện Ngài.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812155
    m_Localized: 'CultistPriest: Nhưng Tử Thần, cái chết từ bi của Ngài... sẽ giải thoát chúng ta khỏi thảm cảnh tột cùng: cõi hư vô.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812154
    m_Localized: 'CultistPriest: Còn "luân hồi sinh tử" ư? Chẳng hơn gì chuỗi ngày nhục hình vô cùng tận, họa chăng được vài khoảng nghỉ ngắn ngủi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812153
    m_Localized: 'CultistPriest: Cái thứ gọi là "kiếp sau" vốn chỉ như một giấc mộng hão huyền, do bọn tà ma dị giáo thêu dệt nên.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812152
    m_Localized: 'CultistPriest: Ấy thế mà, ý niệm về sự hư vô vĩnh hằng lại làm chúng ta khiếp sợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812151
    m_Localized: 'CultistPriest: Đây mới là điều thực sự cốt yếu: cả nhân loại đều đã mỏi mệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812150
    m_Localized: 'CultistPriest: Dù chúng ta không sao thấu suốt những gì mình sắp triệu hồi, cũng chẳng hề chi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812149
    m_Localized: 'CultistPriest: Ngày Tử Thần hạ phàm đã cận kề... Ôiiii, ta cảm nhận được Ngài đang ở rất gần...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812148
    m_Localized: Đây là cái nhà trẻ à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812147
    m_Localized: Tha tôi giùm cái
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812146
    m_Localized: 'CultistPriest: Sao lại thế?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812145
    m_Localized: '"Tử Thần" mà ông nhắc tới rốt cuộc là gì vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812144
    m_Localized: Đây đây, tiện dắt theo lũ bệnh hoạn nhà ông này
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812143
    m_Localized: 'CultistPriest: Ngủ ngon nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812142
    m_Localized: 'CultistPriest: Hừm... Nếu như Tử Thần đã quyết ý chọn anh, ta sẵn sàng giúp Ngài đến gần để quan sát kỹ hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812141
    m_Localized: 'CultistPriest: Ra là vậy...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812140
    m_Localized: 'CultistPriest: Họ đã rời bỏ cõi trần này ư...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812139
    m_Localized: '"Tử Thần" mà ông nhắc tới rốt cuộc là gì vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812138
    m_Localized: Đây đây, tiện dắt theo lũ bệnh hoạn nhà ông này
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812137
    m_Localized: 'CultistPriest: Không nán lại thêm nữa. Ta xin cáo lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812136
    m_Localized: 'CultistPriest: Tuyệt vờiiii. Phải như vậy chứ. Ánh mắt của Ngài vẫn âm thầm dõi theo chúng ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812135
    m_Localized: Chim cút giùm. Tôi đang bận
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812134
    m_Localized: Bầy chim của ông vẫn khỏe
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812133
    m_Localized: 'CultistPriest: Hừ, nhưng riêng ngươi thì vẫn bình chân như vại nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812132
    m_Localized: 'CultistPriest: Thế gian rồi sẽ lụi tàn như thế sao. Chẳng được một phút chói lọi huy hoàng, mà chỉ buồn le lói rồi tắt lịm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812131
    m_Localized: 'CultistPriest: Tử Thần không còn truyền tin cho ta nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812130
    m_Localized: 'CultistPriest: Vĩnh biệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812129
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812128
    m_Localized: 'CultistPriest: Ngươi... Ngươi đang tâm tước đoạt cơ hội duy nhất của chúng ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812127
    m_Localized: 'CultistPriest: Họ chết rồi ư?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812126
    m_Localized: 'CultistPriest: Cái gì cơ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812125
    m_Localized: 'CultistPriest: Bản thân ta cũng chưa rõ ý Ngài là gì... nhưng nghe cũng hấp dẫn chứ, phải không nàoooo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812124
    m_Localized: 'CultistPriest: Có thể Ngài sẽ ban cho anh một chốn dung thân. Để anh ẩn náu khỏi mọi sự... kể cả hồi kết tận cùng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812123
    m_Localized: 'CultistPriest: Tử Thần có truyền lời cho ta cách đây không lâu. Ngài mong được gặp anh khi giờ lành đã điểm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812122
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812121
    m_Localized: 'CultistPriest: Chắc hẳn anh cũng đã kiệt quệ trước bao tiếng ồn, tình cảnh bế tắc, và cả sự rối ren...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812120
    m_Localized: 'CultistPriest: Cảm ơn anh đã rộng lòng bao dung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812119
    m_Localized: Ai biết, kệ cha chúng nó. Lo thân tôi thôi đủ mệt rồi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812118
    m_Localized: Ờ, vẫn sống khỏe, yên tâm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812117
    m_Localized: 'CultistPriest: Không cần phí lời. Đàn chim non của ta sao rồi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812116
    m_Localized: 'CultistPriest: Hẹn tái ngộ. Ta sẽ quay lại hỏi thăm tình hình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812115
    m_Localized: 'CultistPriest: Họ chẳng cần ở lâu đâu. Nhưng hãy cứ trông chừng họ hộ ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812114
    m_Localized: 'CultistPriest: Cảm ơn anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812113
    m_Localized: 'CultistPriest: Đừng lo, chẳng mất nhiều ngày đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812112
    m_Localized: 'CultistPriest: Vậy nên khôn hồn thì... hãy cho họ tá túc, nhééé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812111
    m_Localized: 'CultistPriest: Đến lúc đấy, ngươi chạy đi đâu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812110
    m_Localized: 'CultistPriest: Dẫu cho ngươi có may mắn thoát nạn, căn nhà vẫn sẽ chìm trong biển lửa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812109
    m_Localized: 'CultistPriest: Những anh chị em khác rồi sẽ đến. Họ mang theo xăng dầu, tưới lên bốn góc tường, châm một que diêm nhân lúc ngươi say ngủ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812108
    m_Localized: 'CultistPriest: Chớ có lầm tưởng rằng ánh lửa đức tin đây chỉ được vài người bọn ta nung nấu, gìn giữ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812107
    m_Localized: Tôi không thích bị hăm dọa đâu. Mà thôi giúp thì giúp
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812106
    m_Localized: Láo nháo tao bắn bỏ hết giờ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812105
    m_Localized: 'CultistPriest: Hỡi ôi... Thực bất đắc dĩ, nhưng ta hết cách rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812104
    m_Localized: 'CultistPriest: Đáng tiếc thay, nếu ý định của bọn ta bất thành, mái ấm của ngươi sẽ phải trả giá trong lửa hồng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812026
    m_Localized: 'Courier: Thế là bọn nó lôi đi luôn. Chẳng biết cậu ta như nào rồi, mà cũng chả biết liệu bọn nó có định thả ra hay không nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812021
    m_Localized: 'Courier: Xin chào… Giao hàng đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812020
    m_Localized: 'Courier: Chúc anh buổi tối vui vẻ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812017
    m_Localized: 'Courier: À, ý anh là tại sao tôi vẫn đi làm giữa lúc tận thế ấy hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812016
    m_Localized: 'Courier: Thì tôi đi kiểm tra thôi. Họ khám người tôi, phán tôi là người bình thường, thế là có việc…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812012
    m_Localized: 'Courier: Mãi vẫn chưa quen được...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812011
    m_Localized: 'Courier: Chúc quý khách buổi sáng– Ấy nhầm, buổi tối vui vẻ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812002
    m_Localized: 'Intruder: Thiếu chiêm bao, đời này khó sống quá. Với ai cũng vậy cả.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812001
    m_Localized: 'Intruder: Tôi rất mong là vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811998
    m_Localized: 'Intruder: Cảm ơn anh. Tôi sẽ cố ngủ ở đây, dù chắc là chẳng nghỉ ngơi được chút nào đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811997
    m_Localized: 'Thôi anh đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811996
    m_Localized: Được rồi, anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811995
    m_Localized: 'Intruder: Biết đâu nếu chợp mắt, giấc mơ sẽ đến với tôi chăng?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811994
    m_Localized: 'Intruder: Đã sáu ngày rồi tôi chưa ngủ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811993
    m_Localized: 'Intruder: Khó nói lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811992
    m_Localized: 'Thôi anh đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811991
    m_Localized: Được rồi, anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811990
    m_Localized: 'Intruder: Chắc do cõi mộng đã không còn là thánh địa linh thiêng để ta nghỉ ngơi, hay chiêm nghiệm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811989
    m_Localized: 'Intruder: Vậy mà giờ đây... chúng lại đang dần vụn vỡ, mất đi hình hài vốn có.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811988
    m_Localized: 'Intruder: Ấy là nơi ta tìm kiếm câu trả lời, truy cầu niềm an ủi, vỗ về... hay chỉ đơn giản là theo đuổi một giây phút bình an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811987
    m_Localized: 'Intruder: Giấc mơ... là thứ mong manh, lạ thường.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811986
    m_Localized: Vậy anh có mơ không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811985
    m_Localized: Rồi sao? Quan tâm làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811984
    m_Localized: 'Intruder: Không biết... Liệu có phải do mặt trời mà ra? Hay là tại thứ khác?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811983
    m_Localized: 'Intruder: Anh cũng chẳng khác gì những người kia. Dẫu họ đang trong cơn sốt... vẫn y như vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811982
    m_Localized: 'Intruder: Đấy, lại nữa rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811981
    m_Localized: Vậy anh có mơ không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811980
    m_Localized: Rồi sao? Quan tâm làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811979
    m_Localized: 'Intruder: Theo anh thì sao lại thế?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811978
    m_Localized: 'Intruder: Giờ ít ai còn mơ nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811977
    m_Localized: 'Intruder: Tôi chợt nhận ra điều này. Anh biết là gì không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811976
    m_Localized: 'Intruder: Mơ đó. Anh biết mơ là gì mà. Lúc thiếp đi trong giấc ngủ... anh có nhìn thấy gì không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811975
    m_Localized: Cũng không hẳn
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811974
    m_Localized: Hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811973
    m_Localized: 'Intruder: Anh có bao giờ mơ không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811972
    m_Localized: 'FormerFema: Thôi, chào anh nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811971
    m_Localized: 'FormerFema: Chả biết mình còn giữ nó làm đách gì nữa. '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811970
    m_Localized: 'FormerFema: Đúng tại bộ đồ oái oăm này rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811969
    m_Localized: 'FormerFema: ...Ủa khoan, tôi đâu có được vào. Thì cũng phải thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811968
    m_Localized: 'FormerFema: Hả? Ờm, cám ơn nha. '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811967
    m_Localized: 'FormerFema: Tôi hỏi chơi chơi vậy thôi mà hông ngờ anh cho vào thiệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811966
    m_Localized: 'FormerFema: Còn chỗ nào trống cho tôi ngồi hông? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811965
    m_Localized: 'FormerFema: Hả? Ờm, cám ơn nha. '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811964
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811963
    m_Localized: 'Anh vào đi  '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811962
    m_Localized: 'FormerFema: À ý tôi là việc lập trình ấy. Kiểu như viết code á. '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811961
    m_Localized: 'FormerFema: Mô tả một đằng mà tôi thì làm một nẻo. Đời chả như là mơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811960
    m_Localized: 'FormerFema: Mà rốt cuộc thì... tôi chỉ thấy thất vọng thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811959
    m_Localized: 'FormerFema: Cứ tưởng là có công việc thì sẽ ổn, mọi chuyện sẽ đâu vào đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811958
    m_Localized: 'FormerFema: Hỏi hay đó. Tôi cũng chả biết luôn. '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811957
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811956
    m_Localized: 'Anh vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811955
    m_Localized: 'FormerFema: Vừa chán vừa mệt, nên là tôi nghỉ luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811954
    m_Localized: 'FormerFema: Việc càng lúc càng nhiều mà nhân lực thì ít, tụi tôi làm hổng xuể. '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811953
    m_Localized: 'FormerFema: Mà... tôi nghỉ việc rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811952
    m_Localized: 'FormerFema: Làm nghề lắp đặt với sửa chữa tủ lạnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811951
    m_Localized: 'FormerFema: Tôi á hả? Là công nhân bình thường thôi. '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811950
    m_Localized: 'Thế anh định làm gì? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811949
    m_Localized: 'Vậy anh là ai? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811948
    m_Localized: 'FormerFema: Ai mà biết được là có chuyện gì... '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811947
    m_Localized: 'FormerFema: Bắt người ta đi vậy đó... rồi khỏi hẹn ngày về luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811946
    m_Localized: 'FormerFema: Vì... những chuyện tụi nó làm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811945
    m_Localized: 'FormerFema: Coi bộ đi tới đâu người ta cũng ghét cay ghét đắng bọn đó nhỉ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811944
    m_Localized: 'FormerFema: À đâu, anh lộn rồi, nhìn vậy thôi chứ tôi không phải cán bộ Phòng Chống Thảm Họa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811943
    m_Localized: 'FormerFema: Anh nói vậy là sao? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811942
    m_Localized: 'FormerFema: Hả? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811941
    m_Localized: 'Thế anh định làm gì? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811940
    m_Localized: 'Vậy anh là ai? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811939
    m_Localized: 'FormerFema: Có khi nào do bức xạ Mặt Trời vẫn lưu lại tới đêm hông nhỉ? Mà thôi, tôi cũng chả muốn biết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811938
    m_Localized: 'FormerFema: Tôi mượn một bộ để đi đường cho chắc ăn. Phải có lý do gì tụi nó mới mặc đồ bảo hộ chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811937
    m_Localized: 'FormerFema: Hổng có đâu, tôi chôm bộ này từ cái xác của bọn nó á.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811936
    m_Localized: 'FormerFema: À... Anh thấy tôi bận áo vàng nên tưởng tôi là người của bên Phòng Chống Thảm Họa chứ gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811935
    m_Localized: 'FormerFema: Hả? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811934
    m_Localized: Anh đến bắt tôi luôn đấy à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811933
    m_Localized: Thả hết mấy người bị bắt ra trước đã
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811932
    m_Localized: 'FormerFema: Anh chị gì đó ơi... Mở cửa cho tôi với được hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811931
    m_Localized: 'FormerFema: Tôi nghe thấy tiếng bước chân... Vậy là nhà này có người nhở. '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811930
    m_Localized: 'FormerFema: Có ai ở nhà hông? '
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: 'Firefighter: Từ khi lũ Dị Khách xuất hiện, bệnh viện chẳng có tác dụng gì nữa rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: 'Firefighter: Biết đâu cái thằng đang khám chữa cho mình lại chơi mình một vố thì vứt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: Thôi anh *khụ* cũng hết cứu rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: 'Firefighter: Thà anh ở lại dập cho xong đám cháy, rồi bỏ xác cùng anh em ngoài kia luôn còn hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: Mà thôi, đằng nào anh cũng sắp chết đến nơi rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: 'Firefighter: Anh chỉ muốn được ở lại lúc đó mà tiếp tục dập lửa. Rồi có chết thay cho mấy anh em cũng đáng.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: 'Firefighter: Nhưng rồi mấy thằng chóp bu nói thẳng mặt anh là *khụ khụ* anh làm nhiêu đó là quá đủ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: 'Firefighter: Giờ anh có muốn về nhà cũng chả được. Ngoài đường còn phương tiện công cộng nào nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: Nên anh chỉ còn cách lang thang, trông chờ người ta làm phước cho mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: 'Firefighter: Anh không tính phiền đến chú lâu đâu. *khụ*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: 'Firefighter: Ít nhất thì anh cũng không phải chết bờ, chết bụi một mình ngoài kia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: Mẹ kiếp. *khụ*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: Anh không muốn phải chết bờ, chết bụi một mình đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: 'Firefighter: Mong là *khụ khụ* ngọn lửa không lan đến thành phố.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: 'Gasmask: Tôi đến từ Cơ quan Phòng, chống thảm họa Liên bang. Chúng tôi đang thực hiện công tác kiểm tra các hộ dân sinh sống quanh đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: Anh đi có một mình à?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: Sao tôi phải tin anh chứ?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: Tất nhiên là không.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: 'Gasmask: Chúng tôi chia nhau thành từng nhóm nhỏ để tiện cho công tác khoanh vùng.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: Tôi sẽ không làm mất nhiều thời gian của anh đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: Tại sao anh lại mặc đồ bảo hộ? Chúng tôi có cần phải mặc không?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: Thế mấy người định giúp chúng tôi kiểu gì?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: Tôi có thể trình giấy tờ cho anh xem để chứng minh.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: 'Gasmask: Quay lại vấn đề, các đối tượng Dị Khách thường hiếm khi nào hoạt động theo nhóm. Thậm chí là không bao giờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: Tại sao anh lại mặc đồ bảo hộ? Chúng tôi có cần phải mặc không?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: Thế mấy người định giúp chúng tôi kiểu gì?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: 'Gasmask: Không cần. Nhưng anh thích thì có thể mua một bộ về dùng cho an tâm hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: 'Gasmask: Chúng tôi hiện vẫn đang nghiên cứu tác động của mặt trời đối với môi trường.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: 'Gasmask: Do phải hoạt động ngoài trời thường xuyên, nên chúng tôi phải làm mọi cách để bảo vệ chính mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: Rồi các anh định làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: Bên Phòng Chống Thảm Họa có đối sách gì chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: 'Gasmask: Hiện ưu tiên số một của chúng tôi là thu thập thêm thông tin để chuyển về trụ sở Cơ quan.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: Đó là bước cần thiết để xây dựng chiến lược ứng phó phù hợp.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: 'Gasmask: Tạm thời, các anh cứ giữ bình tĩnh là được.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: Rồi các anh định làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: Bên Phòng Chống Thảm Họa có đối sách gì chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: 'Gasmask: Chúng tôi sẽ thực hiện một số bài kiểm tra sức khỏe, đồng thời đánh giá xem họ có đủ an toàn để tiếp tục sinh sống tại khu vực đó không.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: 'Gasmask: Và đương nhiên, chúng tôi cũng phải xác định xem họ có phải là người hay không rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: Tôi có cần phải đi cùng anh không?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: Tức là tôi nên ở yên đây và chờ xem tình hình hả?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: 'Gasmask: Có chứ. Nhưng chúng tôi không thể triển khai kế hoạch mà không có bằng chứng cụ thể.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: Vì vậy chúng tôi sẽ đưa một người ở đây về phòng thí nghiệm.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: 'Gasmask: Họ sẽ tham gia một số bài kiểm tra và xét nghiệm. Sau khi đảm bảo không có vấn đề gì, chúng tôi sẽ gửi trả họ về.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: Tôi có cần phải đi cùng anh không?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: Tức là tôi nên ở yên đây và chờ xem tình hình hả?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: Đây là nhà anh à?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: 'Gasmask: Vậy thì không. Anh cứ ở yên đây cùng những người khác. Nếu có lệnh di tản thì chúng tôi sẽ thông báo sau.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: Anh chỉ cần giao một người cho chúng tôi là xong.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: 'Gasmask: Phải. Ngay khi có đầy đủ thông tin, chúng tôi sẽ đưa ra hướng dẫn chi tiết cho người dân.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: Anh không cần phải lo lắng gì hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: 'Gasmask: Chúng tôi chỉ đưa một người đi, rồi sẽ trả họ về trong thời gian sớm nhất.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: Chúc anh mạnh khỏe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: 'Prophet: Không ít điều đã đổi thay kể từ lần cuối hai ta chạm mặt. Nhưng sau tất cả, tôi và cậu vẫn sống sót...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: 'Prophet: Hừm... Cảm giác lạ lùng lắm. Tôi cũng không biết nên giải thích thế nào nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: 'Prophet: Tôi từng nghe câu "miếng trầu là đầu câu chuyện". Ngày hôm nay, quẻ bói sẽ thay miếng trầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: 'Prophet: Xem quẻ cho tôi bằng cuốn sách này đi. Tôi nên lật từ trang nào đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: Mở đoạn đầu đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: Mở ngay chính giữa
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: Mở phần cuối ấy
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: 'Prophet: "Kẻ chết sắp cất tiếng, nhưng không một ai lắng nghe".'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: Thánh thần ơi...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: Thực linh nghiệm.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: Mà ngẫm lại thì... tôi cũng không mấy bất ngờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: Vậy tức là sao?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: Ông tin mấy lời đó thật hả?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: "Anh là ai?"'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: 'Prophet: "Anh ư? Anh là anh. Còn em? Em từng là mái ấm".'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: 'Prophet: Hừm. Phải rồi. Đúng là bi kịch.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: 'Prophet: Đây là kết cục đang chờ đợi chúng ta sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: Cũng có thể lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: Vậy tức là sao?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: Ông tin mấy lời đó thật hả?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: 'Prophet: "Đã lâu lắm rồi. Phải chăng đó là một giấc mơ. Có lẽ cả tôi, em, và con cá ấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: 'Prophet: ...đều chỉ hiện diện trong ký ức của một người đã bị thời gian xóa tên.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: 'Prophet: Có lẽ chẳng ai thật sự tồn tại, và ngoài trời chỉ có tiếng mưa rơi".'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: Hừm... Cảm giác chẳng bao lâu nữa, mọi thứ sẽ dần tan biến hoàn toàn.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: 'Prophet: Cậu nghĩ sao? Liệu ta chỉ là giấc mộng của kẻ khác? Hay chính chúng ta đang chìm trong cơn mơ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: Một câu nói đáng suy ngẫm.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: Vậy tức là sao?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: Ông tin mấy lời đó thật hả?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: 'Prophet: Tôi cần ngẫm lại cho thật kỹ đã. Còn góc nhìn của cậu thế nào? Có gì muốn chia sẻ không?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: Dù sao thì, tôi đến đây chỉ để nhắn nhủ cậu một điều.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: Mọi chuyện sẽ dần sáng tỏ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: Cậu cần chuẩn bị sẵn sàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: 'Prophet: Tuy có vẻ hơi khó hiểu... nhưng cậu phải cho con mèo vào nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: 'Prophet: Bây giờ tôi chưa thể giải thích rõ, nhưng tôi chắc chắn nó sẽ giúp ích cho cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: 'Prophet: Tôi chỉ nói vậy thôi, còn ý cậu muốn như nào thì tùy.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: 'Prophet: Xin phép, giờ tôi cần chút thời gian để nghiệm sâu hơn về quẻ bói cậu vừa rút.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: Cũng không gọi là tin hết mực.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: 'Prophet: Tôi chỉ xem chúng như lời khuyên. Để nhắc nhở ta về việc còn dang dở, hoặc cần chú ý đến một tín hiệu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: Trong lúc tôi đang giải mã ý nghĩa câu này, thì một lời sấm truyền chợt lóe lên trong đầu tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: 'Prophet: Khi ánh mắt con mèo chạm đến cậu, hãy nhớ rộng cửa chào đón.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: Hiện giờ tôi chưa thể cắt nghĩa vì sao. Nhưng cứ yên tâm là nó sẽ giúp ích cho cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: 'Prophet: Xin phép, giờ tôi sẽ chiêm nghiệm thật sâu về quẻ bói cậu vừa rút.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: Ô, chào mi nhé, kẻ phàm tục.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: 'Fanatic: Chúng ta thật diễm phúc làm sao, khi được ở đây để chứng kiến ngày khải huyền của nhân loại!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: 'Fanatic: Đức Thái Dương đang thi hành thánh ý của Ngài – đó là thanh tẩy TỘI LỖI khỏi thế gian.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: Toàn thảy mặt đất ngày ngày được nung nấu, chờ khắc ra lò thành tân thế giới vô ngần!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: 'Fanatic: NÀO, HÃY CÙNG TA CHIÊM NGƯỠNG ÁNH DƯƠNG PHƯỚC CON MẸ NÓ LÀNH ĐI!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: Hả?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: Ông làm tôi hơi hãi rồi đấy
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: NÀY KẺ PHÀM TỤC, mi vẫn còn ngu muội ư?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: 'Fanatic: Đây, để ta cắt nghĩa từng chữ cho mi thấm nhuần:'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: 'Fanatic: Mặt trời thiêu đốt và LUỘC SỐNG NHÂN LOẠI là có lý do! Ngài đang lượng tình thanh tẩy cho tội lỗi của chúng ta đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: 'Fanatic: ĐỨC THÁI DƯƠNG NỔI GIẬN, vì lòng tham và dục vọng của nhân loại đã vấy bẩn cõi trần!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: 'Fanatic: THỜI KHẮC KHẢI HUYỀN ĐÃ ĐIỂM!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: 'Fanatic: Nhưng đó lại là phước lành. Vì mọi tội lỗi đều tan biến, và ta sẽ hóa nên tro tàn ngay thẳng, trong sạch vãi lọ dưới vầng thái dương!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: Tức là... chúng ta đều phải chết hả?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: Còn ông thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: Mi HÃI Á? Sống trong bóng tối mãi mi mụ mị hết cả người rồi à?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: 'Fanatic: Đây, để ta cắt nghĩa từng chữ cho mi thấm nhuần:'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: 'Fanatic: Mặt trời thiêu đốt và LUỘC SỐNG NHÂN LOẠI là có lý do! Ngài đang lượng tình thanh tẩy cho tội lỗi của chúng ta đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: 'Fanatic: ĐỨC THÁI DƯƠNG NỔI GIẬN, vì lòng tham và dục vọng của nhân loại đã vấy bẩn cõi trần!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: 'Fanatic: THỜI KHẮC KHẢI HUYỀN ĐÃ ĐIỂM!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: 'Fanatic: Nhưng đó lại là phước lành. Vì mọi tội lỗi đều tan biến, và ta sẽ hóa nên tro tàn ngay thẳng, trong sạch vãi lọ dưới vầng thái dương!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: Tức là... chúng ta đều phải chết hả?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: Còn ông thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: Ngược lại là đằng khác!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: 'Fanatic: Tội lỗi của nhân loại sẽ được gột rửa. Dẫu cho Đức Thái Dương có tuyệt diệt, THÌ CHÚNG TA VẪN SỐNG TIẾP!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: 'Fanatic: Lúc đấy không còn chết chóc, không còn đạo tặc, không còn mấy con CHÓ THAM LAM cứ khư khư giữ của mà hét giá đến tận trời.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: 'Fanatic: Mi hình dung ra viễn cảnh tuyệt trần đó chưa? Giờ mi đã hiểu tại sao mấy vụ thảm họa này lại xuất hiện rồi chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: Ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: Ta hả? Ta thì có liên quan gì ở đây chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: 'Fanatic: Một khi Đấng Thái Dương đã cứu độ toàn thể chúng sinh, cả ta với mi đều sẽ SỐNG TRONG ÂN SỦNG NGẬP TRÀN!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: 'Fanatic: Ánh dương thần thánh của Ngài sẽ cứu vớt chúng ta khỏi bể khổ nơi trần thế, mi hiểu chửa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: 'Fanatic: Mi còn sống đến tận giờ phút này thì ắt phải hiểu ý ta chứ nhể!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: Ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: CHÀ CHÀ, KHÔN NGOAN ĐẤY KẺ PHÀM TỤC! Vào đến nhà rồi hai ta sẽ đàm đạo tiếp nhá!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: 'Fanatic: À, ta quên mất. Trong nhà mi có mấy lon bia không ấy nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: 'Fanatic: Nãy giờ mi giả điếc không nghe ta nói gì về Đấng Thái Dương à?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: 'Fanatic: Thế thì địt mẹ mi nhé! TA SẼ ĐI CỨU RỖI KẺ KHÁC!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: 'Fanatic: Còn mi thì phắn! TẠM BIỆT ĐÉO THÂN, MẸ THẰNG ĐẦU KHẤC!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: 'Anxiety: Đường ở bên đó nóng lên kinh lắm, chắc anh cũng biết rồi ha, hì. Hì hì.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: 'Anxiety: Thật ra trước kia em làm thu ngân ở một cửa hàng địa phương á. Kiểu kiểu vậy. Mà giờ em nghỉ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: 'Anxiety: Thật tình em cũng chẳng muốn ra đây đâu. Ừ thì mặt đường chảy như kem là thế, nhưng biết đâu còn đỡ hơn ngoài kia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: Chị từ đâu đến vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: Sau này chị tính đi về đâu?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: Bạn của chị bị ốm à?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: Bạn của chị cần giúp gì không?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: Bạn của chị bị ốm à?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: Bạn của chị cần giúp gì không?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: Chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: Chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: Anh muốn gì đây?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: Oằn là oằn làm sao? Có chuyện gì thế?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: Thế anh ra đây làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: Nói nghe thử xem nào
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: Thế anh ra đây làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: Nói nghe thử xem nào
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255142
    m_Localized: 'Twins: Nó chẳng tự tắm rửa hay đi lại được. Nhiều lúc ra khỏi giường còn khó.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255143
    m_Localized: 'Twins: Mà không sao. Rồi em sẽ ổn thôi, đúng không nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255144
    m_Localized: 'Twins: Giờ nó không có tâm trạng để nói chuyện, nhưng đôi khi cũng cố gắng mở miệng ra nói vài câu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255145
    m_Localized: Tiếp theo chị tính làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255146
    m_Localized: Cõng chị ấy đi khắp nơi vậy, chị không thấy mệt sao?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255147
    m_Localized: 'Twins: Thời buổi này ai mà chẳng trầm cảm, không ít thì nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255148
    m_Localized: 'Twins: Chúng ta đều thấy trước viễn cảnh này rồi, từ cái lúc vụ mặt trời chưa được công bố cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255149
    m_Localized: 'Twins: Chú có xem tin tức không? Bao nhiêu dấu hiệu rành rành từ trước. Nhưng chị thì nghĩ mặt trời không phát nổ thật đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255150
    m_Localized: Tiếp theo chị tính làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255151
    m_Localized: Cõng chị ấy đi khắp nơi vậy, chị không thấy mệt sao?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255152
    m_Localized: 'Twins: Chị phải tìm nơi nào đó thoải mái chút cho em nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255153
    m_Localized: 'Twins: Rồi hai chị em sẽ bắt tay gầy dựng một cuộc sống mới cho riêng mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255154
    m_Localized: 'Twins: Đi đâu cũng thấy nhà nhà than là hết thật rồi, cuộc đời chẳng còn gì nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255155
    m_Localized: 'Twins: Nhưng chị lại nghĩ khác chú ạ. Chị tin mỗi ngày sẽ một tươi sáng hơn thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255156
    m_Localized: Chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255157
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255158
    m_Localized: 'Twins: Nè, chú lựa lời cho cẩn thận một chút.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255159
    m_Localized: 'Twins: Ừ thì cũng đuối chứ, nhưng chị làm sao mà bỏ mặc nó được. Nói vậy không hay đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255160
    m_Localized: 'Twins: Hai chị em cùng bỏ nhà bố mẹ mà đi. Giờ chỉ còn biết nương tựa vào nhau thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255161
    m_Localized: Chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255162
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255163
    m_Localized: 'Twins: Cảm ơn chú nhiều! Phụ chị mang nó vào với.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255164
    m_Localized: 'Twins: Chắc bệnh tình nó trở nặng thêm do bố mẹ chị qua đời, nhưng vốn dĩ lâu nay nó đã như vậy rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255165
    m_Localized: 'Twins: Mong là ở đây nó sẽ tỉnh hơn được một tí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255166
    m_Localized: 'Twins: Khổ thật. Thôi em ơi, phen này xui rồi, mình phải thử lại ở nhà khác thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255167
    m_Localized: 'Twins: Đi nào. Ráng giùm chị một chút đi em.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255168
    m_Localized: 'Twins: Trời ơi, đến khi nào cái kiếp nạn này mới hết...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714688
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714689
    m_Localized: 'Firefighter: Mấy thằng sếp phát cho bọn anh tờ giấy này trước khi ra ngoài làm nhiệm vụ.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714690
    m_Localized: 'Firefighter: Cái này là lệnh triệu tập vào khu cách ly của bên Phòng Chống Thảm Họa. Có ai đi mà đã về chưa, đi làm đếch gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714691
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714692
    m_Localized: 'Firefighter: Đây, đằng nào anh cũng không cần. Chú muốn giữ hay làm gì thì tùy chú.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714693
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714694
    m_Localized: 'Firefighter: Anh có *khụ* một tờ giấy này. Có vẻ là tài liệu quan trọng.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714695
    m_Localized: 'Firefighter: Cho anh vào đi, thì anh biếu chú đấy. Để anh được sống nốt mấy ngày cuối đời cho yên ổn…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714696
    m_Localized: Được rồi, anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714697
    m_Localized: Thôi, anh cứ giữ lấy
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909014
    m_Localized: 'Fanatic: Đây là hồng ân mà Đấng Thái Dương ĐÍCH THÂN ban cho mi: một lon EnerJeka hẳn hoi! Mi rất xứng đáng, KẺ PHÀM TỤC!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909015
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909016
    m_Localized: 'Fanatic: Mi là đồ đầu đất hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909017
    m_Localized: 'Fanatic: Mi đang từ chối một người NGAY THẲNG và CHÍNH TRỰC đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909018
    m_Localized: 'Fanatic: Nếu cho ta vào, mi sẽ được lãnh nhận hồng ân từ chính ĐẤNG THÁI DƯƠNG. Được ban phước luôn đấy! Suy nghĩ kỹ đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909019
    m_Localized: OK, ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909020
    m_Localized: Biến
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297603
    m_Localized: 'NotTrue: Chào cháu... Ai ở bên trong đó vậy? Có phải là {0} không?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297604
    m_Localized: 'NotTrue: Lúc thì ồn ào náo nhiệt, lúc lại thầm thì giữa bóng đen. Già rồi, ngoại sợ mấy chỗ như này lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297605
    m_Localized: 'NotTrue: Ngoại lang thang một mình âu cũng có lý do của nó. Ngoại không hợp với mấy chỗ đông người la hét đâu cháu à.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297606
    m_Localized: 'NotTrue: Cháu quý họ thì cháu cứ giữ họ lại đây. Còn ngoại ngồi đợi bão đời lắng xuống cái đã. Ngoại không chịu nổi giông tố nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297607
    m_Localized: 'NotTrue: Xương cốt già cả thế này, sao mà chống đỡ nổi... Nát vụn lúc nào không hay.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297608
    m_Localized: Để cháu xử lý cho. Bà vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297609
    m_Localized: Thế thôi bà đi chỗ khác nhé
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297610
    m_Localized: 'NotTrue: Nếu cháu đã quyết, thì ngoại ở... Nhưng bão giông mà kéo đến, bóng gương mà hóa ảo ảnh thì ngoại lại đi nhé. Già cả lú lẫn không chịu nổi đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297611
    m_Localized: 'NotTrue: Hừ! Ngoại cũng thấy mình chẳng ở cái chốn này nổi đâu... Thôi thì đành đem theo mấy câu chuyện mà đi tiếp vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297612
    m_Localized: 'NotTrue: Nhưng cứ dỏng tai lên mà nghe nhé... Thường sự thật đắng cay lại hay đến bên tai qua những lời thầm thì khe khẽ đấy cháu à.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297613
    m_Localized: 'Twins: Làm ơn...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297614
    m_Localized: 'Twins: Xin chú, cho bọn chị ở nhờ đi, một ngày thôi cũng được. Bọn chị có một món đồ chắc chú đang cần...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297615
    m_Localized: 'Twins: Bọn chị sẽ đền đáp công ơn chú...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297616
    m_Localized: OK, chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297617
    m_Localized: Biến
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297618
    m_Localized: 'Twins: Cảm ơn chú nhiều lắm!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297619
    m_Localized: 'Twins: Đây, chú cầm lon EnerJeka này đi. Bọn chị chỉ có bấy nhiêu thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297620
    m_Localized: 'Twins: Bây giờ, cảm phiền chú giúp chị đỡ nó vào nhà với nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297621
    m_Localized: 'Twins: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297622
    m_Localized: 'Twins: {0} đang ở đây à, không ổn.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297623
    m_Localized: 'Twins: Có họ thì không khí trở nên nặng nề lắm. Suy nghĩ của họ còn át cả tiếng lòng chị.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297624
    m_Localized: 'Twins: Em chị không chịu nổi đâu. Nó sẽ... khép mình lại. Cứ như nó chẳng tồn tại vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297625
    m_Localized: 'Twins: Chị... chị cũng cảm thấy khó thở, khó chịu khi phải gặp mấy dạng người đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297626
    m_Localized: 'Twins: Chị sẽ ở đây chờ đến khi mọi chuyện trong đó... dịu bớt. Chú thông cảm nha. Chắc họ sẽ bỏ đi thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297627
    m_Localized: Để tôi xử lý cho. Chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297628
    m_Localized: Thế thôi chị đi chỗ khác nhé
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297629
    m_Localized: 'Twins: Cảm ơn chú. Cẩn thận, nhớ lấy tay đỡ lưng nó... như này nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297630
    m_Localized: 'Twins: Có lẽ việc bố mẹ chị qua đời... đã khiến em chị suy sụp. Cơ mà nó vẫn đang gắng gượng hết mức để vượt qua.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297631
    m_Localized: 'Twins: Bọn chị lang thang ở ngoài mấy hôm rồi. Hy vọng ở đây nó sẽ thấy đỡ hơn, một tẹo thôi cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297632
    m_Localized: 'Twins: ...Chị hiểu rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297633
    m_Localized: 'Twins: Cố thêm một chút nữa em ơi. Chị hứa, bọn mình sẽ sớm tìm được một nơi để em nằm nghỉ. Nào, dựa vào chị đi. Có chị đây rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297634
    m_Localized: 'Twins: Đôi lúc đời nó quật mình như thế đấy. Dù chỉ là một cánh cửa đóng sập. Nhưng chúng ta vẫn phải đi tiếp. Cố lên, có chị đây rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264643
    m_Localized: (Nhận hàng)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264642
    m_Localized: (Nhận hàng)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264641
    m_Localized: (Nhận hàng)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264640
    m_Localized: (Nhận hàng)
    m_Metadata:
      m_Items: []
  - m_Id: 61235008206004224
    m_Localized: Bỏ qua đoạn mở đầu
    m_Metadata:
      m_Items: []
  - m_Id: 58250202329374720
    m_Localized: "Để tôi đuổi ra cho.\nÔng vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 58250202325180416
    m_Localized: 'Gasmask: Nếu anh không thể ngay lập tức chuyển người bị tình nghi đến khu cách ly, hãy đưa cho họ Giấy Yêu cầu Triệu tập Bắt buộc này.'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306408796160
    m_Localized: 'MushroomEater: Vậy là cuối cùng Lễ Hội vẫn đến...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311553
    m_Localized: 'Fanatic: Ngó mà xem... {0}. Mở cửa cho ta, và ta sẽ trao tận tay mi phần thưởng hào phóng từ chính ÁNH DƯƠNG TỐI CAO luôn đấy nhé!'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311552
    m_Localized: 'Fanatic: KẺ PHÀM TỤC, mi quả là xứng đáng được lãnh nhận hồng ân từ ĐẤNG THÁI DƯƠNG!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656006
    m_Localized: 'Jacob: Và rồi tôi với cậu... sẽ lại tái ngộ thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656005
    m_Localized: 'Jacob: Nhưng tôi không chết đâu. Chẳng bao giờ chết được.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656004
    m_Localized: 'Jacob: Đang tâm bỏ mặt người khác trước cửa tử là thất đức lắm đấy nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656003
    m_Localized: 'Jacob: Rồi OK, nhưng để tôi nói cho mà biết:'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656002
    m_Localized: 'Jacob: Bởi tôi và cậu... Chúng ta đều là những kẻ bất tử.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656001
    m_Localized: 'Jacob: Họa may chỉ có những người như cậu mới sống sót qua khỏi cơn ác mộng này.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656000
    m_Localized: 'Jacob: Thời buổi này, chẳng còn mấy ai chịu lắng nghe người ta nói như cậu đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655999
    m_Localized: 'Jacob: ...Cảm ơn cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655998
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655997
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655996
    m_Localized: 'Jacob: Tôi biết bọn Dị Khách từ đâu mà tới.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655995
    m_Localized: 'Jacob: Mẹ, muốn tôi kể hết cho cậu nghe cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655994
    m_Localized: 'Jacob: Tôi hứa với cậu, chờ cho lũ áo vàng biến chỗ khác là tôi dọn ra ngay. Đi tìm con gái tôi tiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655993
    m_Localized: 'Jacob: Có những bí mật mà bên chính phủ ra sức che đậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655992
    m_Localized: 'Jacob: Bọn cán bộ Thảm Họa đang truy lùng tôi, tại tôi biết nhiều thứ quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655991
    m_Localized: 'Jacob: Tôi còn cần chỗ trú tạm ít hôm nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655990
    m_Localized: 'Jacob: Ấy khoan!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655989
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655988
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655987
    m_Localized: 'Jacob: Tôi biết bọn Dị Khách từ đâu mà tới.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655986
    m_Localized: 'Jacob: Mẹ, muốn tôi kể hết cho cậu nghe cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655985
    m_Localized: 'Jacob: Xong là tôi đi ngay, đi tìm con gái tiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655984
    m_Localized: 'Jacob: Cho tôi ở đây mấy hôm với, tới khi lũ cán bộ Thảm Họa cút khỏi khu vực này thì thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655983
    m_Localized: 'Jacob: Mà lỡ vậy thật thì tụi nó không làm gì con bé đâu. Mục tiêu của nó là tôi cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655982
    m_Localized: 'Jacob: Có khi lũ chó chết đó bắt cóc con tôi rồi không chừng. Ai biết được.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655981
    m_Localized: 'Jacob: Số là bọn nó đang dí theo tôi, bởi tôi biết quá nhiều thứ về nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655980
    m_Localized: 'Jacob: Tóm lại là phải đi thật xa khỏi chốn này.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655979
    m_Localized: 'Jacob: Chỗ nào mà mấy tên cán bộ Thảm Họa không mò tới được ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655978
    m_Localized: Con anh không có đây. Về giùm
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655977
    m_Localized: Vậy giờ anh tính đi đâu?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655976
    m_Localized: 'Jacob: Tôi mà tìm ra nó là hai cha con cuốn gói khỏi đây ngay.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267398
    m_Localized: 'CultistPriest: Ô kìa, anh nghĩ mình có quyền lựa chọn à?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267397
    m_Localized: 'CultistPriest: Hẹn tái ngộ. Ta sẽ quay lại hỏi thăm tình hình.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267396
    m_Localized: 'CultistPriest: Họ chẳng cần ở lâu đâu. Nhưng hãy cứ trông chừng giúp ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267395
    m_Localized: 'CultistPriest: Cảm ơn anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267394
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267393
    m_Localized: "Để tôi đuổi ra cho. \nÔng vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267392
    m_Localized: 'CultistPriest: Những tên này sẽ cản trở giáo hội chúng ta theo đuổi sứ vụ. Không thể chấp nhận được.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267391
    m_Localized: 'CultistPriest: Đó là {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267388
    m_Localized: 'Courier: Chúc anh buổi tối vui vẻ…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267387
    m_Localized: 'Courier: Đây nhé: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267386
    m_Localized: (Nhận hàng)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267385
    m_Localized: 'Courier: Thôi anh nhận hàng đi, để tôi còn biến.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267384
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267383
    m_Localized: 'Courier: Tôi chán lắm rồi, chỉ mong cái xã hội này tàn mẹ đi cho nó lành…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267381
    m_Localized: 'Courier: Loạn hết cả rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267380
    m_Localized: 'Courier: Rồi sáng ra toàn bị mấy thằng cha Thảm Hại chĩa súng vào mình để kiểm tra…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267379
    m_Localized: 'Courier: Ngày nào tôi cũng bắt gặp những khuôn mặt mệt mỏi, u sầu, tức tối…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267378
    m_Localized: 'Courier: Lúc trước tôi có kể là nghề này giúp tôi đỡ phải lo nghĩ về tận thế, anh còn nhớ không? Giờ thì chắc nó cũng hết tác dụng rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267374
    m_Localized: 'Courier: Rồi nhận hàng nhanh hộ cái, để đây còn cút trước khi bị bắn lủng sọ.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267373
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267372
    m_Localized: 'Courier: À, ra thế… Anh muốn nói chuyện bạn tôi bị giết là phải đạo lắm chứ gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267370
    m_Localized: Phải vậy thôi chứ sao giờ
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267361
    m_Localized: (Nhận hàng)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878742
    m_Localized: 'Wolfhound: Mày phải tiễn nó về vườn cho tao Diễm ơi, không nà đi đời cái nhà mày đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878741
    m_Localized: 'Wolfhound: Nhà mày có {0} thối hoắc trong ấy đúng không? Cách mấy cây số tao còn ngửi được. Noại này tao còn nạ gì, sói giả nai đó cu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878740
    m_Localized: Tôi không nhận hối lộ đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878734
    m_Localized: "Để tôi đuổi ra cho. \nChị vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878727
    m_Localized: 'Twins: Số là trước khi chị gặp chồng ấy... À thì, nói chung là họ rất giống với một người chị từng quen biết.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878726
    m_Localized: 'Twins: Nếu phải sống chung với họ thì chị không chịu nổi đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878725
    m_Localized: 'Twins: Có {0} ở trong nhà chú...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684421
    m_Localized: 'Greatmother: Phải rứa chớ! Mi mà không cho tau vô là có chuyện rồi. Phước ba đời nhà mi!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684416
    m_Localized: 'Greatmother: Ui cha ơi... coi trong nhà có ai tề. Là {0} nớ phải không? Hay he!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490113
    m_Localized: 'Widow: ...Trong nhà cậu đang có {0} à?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863209
    m_Localized: 'Intruder: Làm gì có đủ chỗ chứa cả hai người bọn tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863208
    m_Localized: 'Intruder: Tôi cũng muốn vào... nhưng nhìn như có người chiếm chỗ mất rồi. Kìa, thấy {0} ở kia không. '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863207
    m_Localized: 'FormerFema: Thôi, chào anh nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863206
    m_Localized: 'FormerFema: Chả biết mình còn giữ nó làm đách gì nữa. '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863205
    m_Localized: 'FormerFema: Đúng tại bộ đồ oái oăm này rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863204
    m_Localized: 'FormerFema: OK, tôi hiểu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863203
    m_Localized: 'FormerFema: Nói chơi mà hổng ngờ anh cho tôi vào thiệt luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863202
    m_Localized: 'FormerFema: Thiệt hả? '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863201
    m_Localized: 'Thôi anh đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863200
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi "
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863199
    m_Localized: 'FormerFema: Tôi hứa sẽ im lặng với nghe lời, không làm phiền ai đâu. Chỉ cần anh đuổi người đó ra giùm tôi thôi. '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863198
    m_Localized: 'FormerFema: Nói nghe nè, tôi phải bận bộ đồ quỷ sứ này nguyên ngày rồi... Giờ chỉ muốn cởi tuột nó ra, giặt sạch cho hết bụi bặm... máu me thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863197
    m_Localized: 'FormerFema: A-Anh à... Hình như trong phòng tắm có {0} rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863196
    m_Localized: 'FormerFema: Ủa mà khoan. '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863195
    m_Localized: 'FormerFema: Hả? Ờ, cám ơn nha. '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863194
    m_Localized: 'GraveDigger: Cám ơn cậu nhiều nha!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863193
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863192
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863191
    m_Localized: 'GraveDigger: Tui cũng muốn vô lắm, nhưng mà... kiểu... khó cậu ơi...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863190
    m_Localized: 'GraveDigger: Chết cha, hình như chỗ này có {0} ở rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863189
    m_Localized: 'Marauder: Thâu thì đành... Đi kiếm chỗ khác dẫy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863188
    m_Localized: 'Marauder: Chẹp, dẫy mà cứ tưởng cuối cùng cũng được ngủ thoải mái.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863187
    m_Localized: 'Marauder: Hè hè, phải dẫy chớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863186
    m_Localized: Thôi bác đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863185
    m_Localized: "Để tôi đuổi ra cho. \nBác vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863184
    m_Localized: 'Marauder: Kia kìa, cậu thấy hông? Có {0} đang ở đó rầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863183
    m_Localized: 'Marauder: Trời quơi chán dẫy. Tính lựa chỗ ngon mà bị xí mất tiêu rầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863182
    m_Localized: 'Provocateur: Chúng ta hãy bàn bạc thỏa thuận sau về các điều khoản thuê nhà nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863181
    m_Localized: 'Provocateur: Quyết định rất hợp lý.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863180
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863179
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863178
    m_Localized: 'Provocateur: Chẳng lẽ anh xem thường Điều 28, Điều 48 và Điều 7.3 trong Hiến pháp đến vậy sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863177
    m_Localized: 'Provocateur: Anh có biết là đối tượng này có tiền án tiền sự, thường xuyên làm trái pháp luật không?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863176
    m_Localized: 'Provocateur: Ồ... Hình như trong nhà này đã có {0} trọ trước.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863175
    m_Localized: 'TaxiDriver: Ờ thì, chú mần dị cũng phải. Nhưng mà cái lùm mía, cay thiệt sự...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863174
    m_Localized: 'TaxiDriver: Lâu lâu có rảnh, chú cứ qua phòng kiếm tui nói chuyện hen?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863173
    m_Localized: 'TaxiDriver: Ầy, hên quá, đội ơn chú nha. Chú mới cứu tui một mạng luôn đó!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863172
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863171
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863170
    m_Localized: 'TaxiDriver: Nói chung là, giờ chú chọn đi. Người ta đi thì tui ở, còn không thì thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863169
    m_Localized: 'TaxiDriver: Ầy. Dòm cứ na ná cái đứa hồi xưa truy sát nhà tui trối chết...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863168
    m_Localized: 'TaxiDriver: Tui nói này chú đừng giận, nhưng mà nhà chú đang có {0} trong trỏng rồi đúng hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668885
    m_Localized: 'Edgar: Khi hồi kết đã điểm, mong cậu hãy giữ lại thân xác mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668884
    m_Localized: 'Edgar: Mình chưa rõ cậu có nhìn thấy cái đẹp giống như mình không. Đừng nói là cậu luôn vứt bỏ những thi thể nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668883
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668882
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668881
    m_Localized: "Để tôi đuổi ra cho. \nCậu vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668880
    m_Localized: 'Edgar: Còn mình lại đến để lắng nghe sự tĩnh lặng mờ ảo của khắc hoàng hôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668879
    m_Localized: 'Edgar: Mình cũng muốn vào... nhưng {0} đang ngồi đó. Họ vô vọng bám víu vào mộng tưởng bình minh.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668878
    m_Localized: 'Foreigner: (Anh ta gật đầu và bước vào trong)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668877
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668873
    m_Localized: 'Doctor: Bác sẽ ở gần đây thôi. Cần hỗ trợ gì thì cứ gọi nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668872
    m_Localized: 'Doctor: Bác hiểu mà. Thời buổi này cũng khó mà tin ai cho được.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668866
    m_Localized: 'Doctor: Hừm, bác thấy trong nhà đang có {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474578
    m_Localized: 'NotTrue: Ngoại tựa lưng một chút, nghỉ cho lại sức rồi xách cái thân già đi ngay.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474569
    m_Localized: 'Daughter: Con... Con s-s-sợ LẮMMMMMMMM...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474568
    m_Localized: 'Daughter: Con... Con... còn biết a-ai nữa đâuuuuuuu...!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474561
    m_Localized: 'Daughter: Tại {0} ngồi ở đó mất tiêu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474560
    m_Localized: 'Daughter: Con... Con hổng... T-Trong trỏng hết chỗ òi!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280291
    m_Localized: 'Cold: B-Biết đâu mặt trời sẽ s-s-sưởi ấm cho tôi một lần cuối...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280290
    m_Localized: 'Cold: Đúng rồi... Đ-Đi chỗ nào thật xa... Để không ai phải gần mình...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280282
    m_Localized: 'Esenin: Ơn trời, mãi mới có chuyện theo đúng ý tôi. Mời chú dẫn đường.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280281
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280280
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280279
    m_Localized: 'Esenin: Ba cái hạng người đó còn bị đuổi khỏi quán bar trước tôi nữa là.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280278
    m_Localized: 'Esenin: Chú cho {0} dọn ra trước đi rồi hẵng nói chuyện.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280277
    m_Localized: 'Anxiety: Dạ rồi, hơ hơ… Thế thôi em đi chỗ khác. Ừm, đằng nào mặt trời cũng nướng sạch cả lũ thôi. Chết đến nơi rồi còn gì...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280276
    m_Localized: 'Anxiety: Cảm ơn anh ạ. Em hứa sẽ ngồi thật im. Phiền anh đừng đóng cửa là được. Ha ha, để phòng thôi ý mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280275
    m_Localized: Thôi cô đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280274
    m_Localized: "Để tôi đuổi ra cho. \nCô vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280273
    m_Localized: 'Anxiety: Hay, ừm... bảo họ đi chỗ khác được không ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280272
    m_Localized: 'Anxiety: Anh làm ơn, có thể kiểm tra họ hay...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280271
    m_Localized: 'Anxiety: Em... Em chẳng dám ngồi chung đâu. Ngộ nhỡ người ta là Dị Khách thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280270
    m_Localized: 'Anxiety: Đ-Đã có... {0}... đang ở chỗ đó rồi ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280269
    m_Localized: 'Hunter: Thế là mày khôn đấy. Cứ yên tâm, bác biết đường xử lý. Nhỡ... nóa... mà xuất hiện, thì bác đỡ hộ mày choa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280268
    m_Localized: Thôi bác đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280267
    m_Localized: "Để tôi đuổi ra cho.\nBác vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280266
    m_Localized: 'Hunter: Bác nhìn là biết tay nóa dính chàm giồi đấy. Mày cho nóa vào nhà được cũng tài. Thích liều ăn nhiều hả con?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280265
    m_Localized: 'Hunter: Ô, nhà mày chứa cả {0} cơ à.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280264
    m_Localized: 'Fanatic: Ta sẽ chia sẻ kiến thức chói lòa này với những kẻ xứng đáng hơn mi! Xin chào đéo hẹn gặp lại, thằng mặt lồn!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280263
    m_Localized: 'Fanatic: Chỉ có lũ ÁC LINH SỐNG TRONG BỐNG TỐI mới khước từ lời kêu gọi của ánh sáng... À không, của SỰ KHAI SÁNG!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280262
    m_Localized: 'Fanatic: Quỷ tha ma bắt mi đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280261
    m_Localized: 'Fanatic: Đâu ta xem tủ lạnh cái nào...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280260
    m_Localized: 'Fanatic: QUẢ LÀ SÁNG SUỐT, HỠI KẺ PHÀM TỤC! Rồi ĐÔI MẮT mi sẽ bừng nắng hạ, mặt trời chân lý chói qua tim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280259
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280258
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280256
    m_Localized: 'Fanatic: Kẻ phàm tục kia, CHIẾU THEO LỜI RĂN CỦA ĐẤNG THÁI DƯƠNG, thì ta không thể ở chung với cái ngữ như {0} được!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085958
    m_Localized: 'FortuneTeller: Chị cảm thấy một nguồn năng lượng tích cực vô cùng mạnh mẽ đang tuôn chảy trong nhà em.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085957
    m_Localized: 'FortuneTeller: Tuyệt cả là vời... Chị nói nghe nhé, em đang sở hữu không gian siêu hình cực kỳ hiếm giữa dòng thời gian.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085956
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085955
    m_Localized: Để tôi đuổi ra cho. Chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085954
    m_Localized: 'FortuneTeller: Mình cần phải tống khứ họ, không thì sao chiếu mệnh tỏ điềm dữ: tai ương sẽ ập đến. Em hiểu không?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085953
    m_Localized: 'FortuneTeller: Chị trông thấy gì đó... là {0}. Có làm em nhớ đến điều gì không?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085952
    m_Localized: 'FortuneTeller: Ôi... Chị cảm nhận... một trường năng lượng dày đặc, bức bối. Một bóng đen... mạnh đến mức có thể đầu độc cả ngôi nhà! Kinh khủng quá!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891698
    m_Localized: 'Luka: Cậu ở lại mạnh giỏi. Nhớ giữ gìn sức khỏe nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891697
    m_Localized: 'Luka: Rồi cuộc đời cậu sẽ sớm rơi vào ngõ cụt, không còn lối thoát.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891696
    m_Localized: 'Luka: Cứ như vậy thì nỗi tuyệt vọng sẽ nuốt chửng cậu mất.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891695
    m_Localized: 'Luka: Xin đừng mãi đắm chìm trong đau khổ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891694
    m_Localized: 'Luka: Biết đâu khi đó, cái chết sẽ chẳng còn là điều duy nhất ám ảnh tâm trí cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891693
    m_Localized: 'Luka: Tớ chỉ mong sao cậu vẫn còn nhớ thế nào là niềm vui, là hạnh phúc.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891692
    m_Localized: 'Luka: Cảm ơn cậu nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891691
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891687
    m_Localized: 'Luka: Ôi, tớ cũng muốn vào lắm, nhưng có vẻ {0} đang ở trong rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891686
    m_Localized: 'Couple: Nào, nhanh nhanh cái chân lên! Mệt rồi đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891682
    m_Localized: 'Couple: Em yêu à, còn đứng đấy làm gì nữa? Người ta tốt bụng cho mình vào rồi này.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891681
    m_Localized: 'Couple: Ôi, thật sự cảm ơn chú rất nhiều!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891675
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891674
    m_Localized: 'Couple: Ôi, đội ơn chú nhiều lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891671
    m_Localized: 'Anger: Mẹ tưởng sao, mày cũng hèn đéo khác gì mấy con chó giẻ rách kia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891670
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891666
    m_Localized: 'Anger: Tôi đéo ở chung nhà với dạng đó đâu, khó chịu bỏ mẹ ra.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891665
    m_Localized: 'Anger: Cái địt, {0} đang ở đây hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891661
    m_Localized: 'Mother: Nè con, vô lẹ. Chú cho hai mẹ con mình ngủ lại rồi kìa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891660
    m_Localized: 'Mother: Cuối cùng cũng được nghỉ ngơi…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891656
    m_Localized: 'Mother: Nè em… con chị nó đang sợ lắm rồi, mà trong nhà lại có {0} nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891655
    m_Localized: 'Ballerina: Nhìn cục bông này. Chọn sai rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891649
    m_Localized: 'Ballerina: Hừm. Đáng lẽ không ở đây. Bắt đi chỗ khác đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891648
    m_Localized: 'Ballerina: Có {0} ở trong hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697375
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697374
    m_Localized: 'Teacher: Họ làm cô nhớ đến... lũ người... đã... đã khiến cho tụi nhỏ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697368
    m_Localized: 'Dude: Uầyyyyyyy...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697367
    m_Localized: 'Dude: Broooooo! Biết thế nào ông cũng sẽ, kiểu, hiểu ý tui mà!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697358
    m_Localized: 'Blind: À, thế thôi tôi tìm chỗ khác, nhưng mà này...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697357
    m_Localized: 'Blind: Chân thành cảm ơn cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697356
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697355
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697354
    m_Localized: 'Blind: Chắc tôi nên tìm nơi khác thì hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697353
    m_Localized: 'Blind: Xin lỗi, tôi... thực sự không biết diễn tả thế nào. Chỉ biết là có vấn đề mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697352
    m_Localized: 'Blind: Tôi cảm nhận được {0} đang ở đây. Mà người này... có gì đó hơi bất ổn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697351
    m_Localized: 'Fatman: Như này thì ông biết đi đâu bây giờ? Bỏ mẹ rồi. Toang mẹ rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697350
    m_Localized: 'Fatman: Cái gì cơ? Ông đây đã không khỏe trong người rồi, mà còn là bộ trưởng nữa nhá! '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697349
    m_Localized: 'Fatman: Xong chuyện là anh... chốt đơn cho chú nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697348
    m_Localized: 'Fatman: Hay quá, đúng ý anh luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697347
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697345
    m_Localized: 'Fatman: Thà là chú... giải quyết vấn đề hộ anh, để anh bù đắp bồi dưỡng cho chú sau.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697344
    m_Localized: 'Fatman: Chậc, trong nhà có... {0} kia kìa. Không, không, không được! Anh đéo rảnh mà đi tranh nhau cái bồn tắm đâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503073
    m_Localized: 'Buddy: Cám ơn nha! Tui nợ anh một mạng luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503072
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503071
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503070
    m_Localized: 'Buddy: Tui thì sẵn sàng nhường cơm sẻ áo, nhưng cái cũi chó này hơi bị chật như nêm nha... Anh bạn làm ơn làm phước dọn bớt chỗ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503069
    m_Localized: 'Buddy: Úi chà, anh bạn à... Có người đang ngồi sưởi ấm nguyên cái chỗ đó rồi kìa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503068
    m_Localized: 'Bestson: Dạ... anh nói chí lý. Thôi để em về nhà, biết đâu giờ ba mẹ về rồi thì sao...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503067
    m_Localized: 'Bestson: Mà thôi... giờ em nên ở với anh thì hơn. Cảm giác như vậy an toàn hơn nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503066
    m_Localized: 'Bestson: Kiểu, lỡ ba mẹ về nhà mà hổng thấy em đâu thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503065
    m_Localized: 'Bestson: Cám ơn anh nhiều! Chỉ là... giờ em vẫn cứ thấy lo canh cánh trong bụng.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503064
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503063
    m_Localized: "Để tôi đuổi ra cho. \nCậu vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503062
    m_Localized: 'Bestson: Có lần em đi công viên, một người nhìn cũng na ná vậy lao tới tấn công em. Kể từ đó em không dám đặt chân ra ngoài đó nữa luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503061
    m_Localized: 'Bestson: Em thấy hình như có {0} ngồi sẵn trên sofa rồi. Mấy người như vậy… kiểu… làm em rén lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503060
    m_Localized: 'Fugitive: Chúc mày ngủ ngon chết mẹ mày luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503059
    m_Localized: 'Fugitive: Được, mày cứ trốn sau cánh cửa ấy đi con gà. Để xem trụ được đến bao giờ nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503058
    m_Localized: 'Fugitive: Mày sợ bọn Thảm Hại nó đến gõ cửa tìm tao chứ gì? Mẹ cái thằng hèn chó.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503057
    m_Localized: 'Fugitive: Má mày đùa bố à?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503056
    m_Localized: 'Fugitive: Mong là hàng xóm cậu cũng không phải loại khốn nạn gì...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503055
    m_Localized: 'Fugitive: Cậu là ân nhân cứu mạng tôi đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503054
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503053
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503052
    m_Localized: 'Fugitive: Này tôi nói thật tình, mấy hạng người đấy sẵn sàng bán đứng cậu trong một nốt nhạc. Bỏ đi cho lành.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503051
    m_Localized: 'Fugitive: Giờ thì nó ngồi im ngoan ngoãn vậy đấy... Chứ đến khi đụng chuyện là nó thí mình như con tốt vậy! Chó lắm!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503050
    m_Localized: 'Fugitive: Vãi thật... Trong nhà cậu đang có {0} kìa. Cái loại này tôi gặp đầy. Chả tốt lành gì đâu cậu ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503049
    m_Localized: 'Nun: Rồi đến khi ngươi đối diện với Đức Chúa, Ngài sẽ ghi nhớ những gì ngươi đã làm với ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503048
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503047
    m_Localized: 'Nun: Rủi ta mà chết rục ở đâu đó, thì cái thân ngươi liệu mà gánh tội.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503046
    m_Localized: 'Nun: Lạy Chúa thương xót...! Một cơ hội quý báu để đón nhận sự cứu rỗi như thế mà ngươi lại đi từ chối. Thật đáng hổ thẹn!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503045
    m_Localized: 'Nun: Kính ơn Chúa nhân từ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503044
    m_Localized: Thôi bà đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503043
    m_Localized: "Để tôi đuổi ra cho. \nBà vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503042
    m_Localized: "Nun: Đuổi nó ra ngay đi, rồi ta sẽ \nban phước cho con!"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503041
    m_Localized: 'Nun: Y có sống ăn năn cả đời cũng không rửa sạch được tội lỗi đâu! Sao con dám dung túng cho lũ ác quỷ, để chúng ở nhờ kia chứ!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503040
    m_Localized: 'Nun: Trong nhà con đang chứa chấp thứ vô thần nào đây? Cái {0} ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114466
    m_Localized: 'Raskolnikov: Chỉ mong... sau này em học được cách giết người. Để đứng lên tự bảo vệ mình...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114465
    m_Localized: 'Raskolnikov: Chắc người đó quan trọng với anh lắm. Xin lỗi đã làm mất thì giờ của anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114464
    m_Localized: 'Raskolnikov: U là trời... Em hông cố ý làm khó anh hay mô nạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114463
    m_Localized: 'Raskolnikov: A-Anh chỉ cho em cách... giết Dị Khách với nha? Em muốn có đủ can đảm... hiên ngang đối mặt với nỗi sợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114462
    m_Localized: 'Raskolnikov: V-Với lại á... Nếu anh hông ngại thì... Sau khi kiểm tra em xong...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114461
    m_Localized: 'Raskolnikov: Dạ, em cám ơn anh nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114460
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114459
    m_Localized: "Để tôi đuổi ra cho. \nCậu vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114458
    m_Localized: 'Raskolnikov: Em... Em hổng muốn sống chung với mấy người như rứa mô. Thử rồi, hổng có được.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114457
    m_Localized: 'Raskolnikov: U là trời... Tính em hổng có sân si chi mô, nhưng mà {0} đang ở trỏng rồi á.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114456
    m_Localized: 'Wifefema: Thôi. Tiên sư con mẹ mày. Tao sang hỏi mấy nhà hàng xóm còn hơn. Chào nhá thằng đầu khấc!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114455
    m_Localized: 'Wifefema: ... '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114454
    m_Localized: 'Wifefema: Bộ chú mày dở hơi à? Tao đây mở lòng bao nhiêu thì chú mày lại vô tâm bấy nhiêu là sao!? '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114433
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633035
    m_Localized: 'BigLebowski: Nói chuyện với chú đúng là chỉ tổ phí thời gian...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633034
    m_Localized: 'BigLebowski: Xì... Không cho thì thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633033
    m_Localized: 'BigLebowski: Ngon!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633032
    m_Localized: Thôi cháu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633030
    m_Localized: 'BigLebowski: Ê nói thành vần luôn kìa. Hay phết.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633029
    m_Localized: 'BigLebowski: Bây giờ nhé, muốn tôi ở lại thì phải theo ý tôi, đừng có lôi thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633028
    m_Localized: 'BigLebowski: Ê thôi khỏi đi. Có {0} ngồi ngay đấy rồi kìa. Đúng chỗ linh hồn của nhà mới ghê chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633027
    m_Localized: 'BigLebowski: Dẹp, lịt mẹ nhà chú...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633026
    m_Localized: 'BigLebowski: Ông chú y chang ông bô nhà tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200674
    m_Localized: 'FatalDame: Hừ... Hắn thì không nghĩ vậy đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200673
    m_Localized: 'FatalDame: Cưng nghĩ rằng cứ tự mình đối mặt với cái chết thì sẽ thanh thản hơn sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200672
    m_Localized: 'FatalDame: Chị biết ngay là cưng sẽ trả lời vậy mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200671
    m_Localized: 'FatalDame: Hẳn là có cách hay hơn để quên đi thực tại ngoài... đắm chìm trong nỗi hoang tưởng và tự thương hại không hồi kết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200670
    m_Localized: 'FatalDame: Hãy cùng rời xa cơn ác mộng kinh hoàng này... đến một thế giới chỉ có chị và cưng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200669
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200668
    m_Localized: Chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200667
    m_Localized: 'FatalDame: Hay là chúng mình cùng... mở lòng... với nhau nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200666
    m_Localized: 'FatalDame: Chỉ cần bé cưng muốn thì chị sẵn sàng giúp đỡ. Thực hành với chị đây nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200665
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200664
    m_Localized: 'FatalDame: Mở lòng kết nối với người khác nào phải chuyện dễ dàng. Không chỉ mình cưng mới thấy khó đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200663
    m_Localized: 'FatalDame: Chị hiểu mà. Đâu phải ai cũng chân tình lắng nghe thay vì lên giọng: "Cậu thì sao khổ bằng tôi!"'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200662
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200661
    m_Localized: Chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200660
    m_Localized: 'FatalDame: Thời buổi này, ai mà chẳng cần có niềm an ủi. Một chút ân cần... Một chút thương yêu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200659
    m_Localized: 'FatalDame: Cưng mà cho chị vào thì mình còn có thể san sẻ nỗi đau... và cùng nhau chữa lành.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200658
    m_Localized: 'FatalDame: Với cả...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200657
    m_Localized: 'FatalDame: Chị cũng từng trải rồi, nên chị hiểu mà. Nếu cưng muốn thì... mình tâm sự với nhau nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200656
    m_Localized: 'FatalDame: Chị biết, nguôi ngoai nỗi căm hờn khó lắm. Mà tha thứ còn khó hơn gấp bội.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200654
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200653
    m_Localized: Chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200652
    m_Localized: 'FatalDame: Cho chị vào đi, rồi chị sẽ trao cưng thứ đó. ...Biết đâu cưng sẽ không còn chai sạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200651
    m_Localized: 'FatalDame: Nhưng ngay cả những trái tim đơn côi nhất cũng cần được... săn sóc đặc biệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200650
    m_Localized: 'FatalDame: Dạo này ai cũng chỉ để tâm đến tận thế.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200649
    m_Localized: 'FatalDame: Chị có thể trao cho cưng một điều mà người khác không sẵn sàng trao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200648
    m_Localized: 'FatalDame: Hừm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200647
    m_Localized: 'FatalDame: Nhưng chị không ép cưng đâu nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200646
    m_Localized: 'FatalDame: Cưng cứ thử trải lòng hết ra đi, có khi sẽ thấy nhẹ bớt đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200645
    m_Localized: Tính tôi không dễ hòa thuận với người khác. Không thay đổi được đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200644
    m_Localized: Hồi trước tôi hay trù cho ông già mình chết quách đi. Đủ thú vị chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200643
    m_Localized: Tôi không thích
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200642
    m_Localized: 'FatalDame: Cứ tâm sự với chị đi cưng. Chị là người qua đường thôi mà. Chắc gì chúng ta sẽ gặp lại mà cưng phải ngại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200641
    m_Localized: 'FatalDame: Hay tuổi thơ cưng gặp nhiều sóng gió? Chắc cưng đã phải trải qua rất nhiều. Ký ức ùa về sao? Ôi tội bé cưng của chị quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200640
    m_Localized: 'FatalDame: Có phải bọn Dị Khách giết hại người yêu quý, nên giờ cưng phải khóa kín trái tim lại?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200639
    m_Localized: 'FatalDame: Đang đau lòng chuyện gì hở? Cưng bị vợ bỏ chăng?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200638
    m_Localized: 'FatalDame: Ôi kìa, cưng nói thế làm chị buồn đó!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200637
    m_Localized: Tính tôi không dễ hòa thuận với người khác. Không thay đổi được đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200636
    m_Localized: Hồi trước tôi hay trù cho ông già mình chết quách đi. Đủ thú vị chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200635
    m_Localized: Thôi xin miễn
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200634
    m_Localized: 'FatalDame: Cưng hơi kiệm lời nhỉ? Kể cho chị nghe về bản thân nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200633
    m_Localized: 'FatalDame: Dạo này người ta cứ hay soi xét ngoại hình của chị. Còn hơn cả lúc trước cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200632
    m_Localized: 'FatalDame: Chị như này cục cưng có thích không nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200631
    m_Localized: 'FatalDame: Cưng cũng chịu để ý ghê. Cảm ơn cưng nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200630
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200629
    m_Localized: Trông chị... hơi khác thường
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200628
    m_Localized: 'FatalDame: Ôi xin lỗi cưng nhé, chị hỏi vớ vẩn quá. Nhà của cưng mà, không quen sao được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200624
    m_Localized: 'Vigilante: Nói thật nhá, ông đéo quan tâm ảnh ọt mày trông như nào đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200623
    m_Localized: 'Vigilante: Trông bình thường. Nhưng phân nửa những thằng tao đã giết cũng bình thường lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200622
    m_Localized: 'Vigilante: Lại xàm lồn rồi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200619
    m_Localized: 'Vigilante: Địt mẹ mày đùa ông đấy à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200617
    m_Localized: 'Vigilante: Hừm. Đêm nay mày tạm ổn. Ông cũng đéo rảnh mà kiểm kỹ hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200616
    m_Localized: 'Vigilante: Xong. Nhưng mày vẫn chưa thoát nạn đâu đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200615
    m_Localized: 'Vigilante: Mở to con mắt mày ra. Đếch đùa với mày đâu nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200614
    m_Localized: 'Vigilante: Ông đang bận, đéo rảnh mà kiểm kỹ hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200613
    m_Localized: 'Vigilante: Hừm... Bẩn hay sạch đéo quan trọng lắm. Bọn Dị Khách giờ thiếu gì cách trà trộn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200612
    m_Localized: 'Vigilante: Làm sao? Khẩn trương lên. Mày trong sạch thì ông làm gì mày.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200611
    m_Localized: 'Vigilante: Tán dóc đủ rồi. Ông còn việc phải làm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200610
    m_Localized: 'Vigilante: Chưa ngon ăn đâu. Mày lệch một li là ông cho đi xuống mồ luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200609
    m_Localized: 'Vigilante: Rồi, không vấn đề gì. Ông nói thật, thà có vấn đề còn hơn. Để về sau đỡ rách việc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200608
    m_Localized: 'Vigilante: Há mồm rộng ra. Địt mẹ ông mày đéo phải nha khoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200607
    m_Localized: (Cho xem tai)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200606
    m_Localized: (Cho xem ảnh chụp)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200605
    m_Localized: (Cho xem nách)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200604
    m_Localized: (Cho xem mắt)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200603
    m_Localized: (Cho xem bàn tay)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200602
    m_Localized: (Cho xem răng)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200601
    m_Localized: 'Vigilante: Kể lể thế đủ rồi. Giờ ông đi kiểm tra mày. Chứng minh mày trong sạch đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200600
    m_Localized: 'Vigilante: Đéo hiểu chúng nó cười cái gì. Lại còn bảo ông ứng tuyển đi. Có cái lồn. Chúng nó chỉ bắt bớ người, còn lũ Dị Khách vẫn nhởn nhơ kia kìa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200599
    m_Localized: 'Vigilante: Sau đó mấy thằng áo vàng vào cuộc, lải nhải "dọn dẹp" con mẹ gì đó. Ông bảo chúng nó không cần lo, ông đã làm đâu ra đấy rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200596
    m_Localized: 'Vigilante: Nhưng còn mụ vợ... thì bắt đầu có dấu hiệu. Thằng chồng cứ van xin: "Vợ con ông ơi, xin ông tha cho em ấy!"'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200595
    m_Localized: 'Vigilante: Có một gia đình sống ở rìa thị trấn. Cửa nẻo bịt kín, ông bố đứng chặn cửa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200594
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200593
    m_Localized: 'Vigilante: Nhưng giờ ông cũng mặc kệ. Đéo quan tâm nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200592
    m_Localized: 'Vigilante: Tìm làm đếch gì nữa. Mất thời gian. Thằng em ông mà đéo hèn thì may ra nhà nó vẫn còn sống.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200591
    m_Localized: (Cho xem tai)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200590
    m_Localized: (Cho xem ảnh chụp)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200589
    m_Localized: (Cho xem nách)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200588
    m_Localized: (Cho xem mắt)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200587
    m_Localized: (Cho xem bàn tay)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200586
    m_Localized: (Cho xem răng)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200585
    m_Localized: 'Vigilante: Kể lể thế đủ rồi. Giờ ông đi kiểm tra mày. Chứng minh mày trong sạch đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200584
    m_Localized: 'Vigilante: Mắt con bé hoang dại, nhưng đầy sức sống. Thế ông mới nể. Chả bù cho thằng em mình. Nó mà chết sớm mẹ đi, thì may ra vợ con nó còn sống.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200583
    m_Localized: 'Vigilante: Cứ tưởng chết hết rồi. Ai ngờ mấy hôm sau bọn nó lần tới chỗ ông. Đầu tiên, ông tia thấy đứa con gái tay cầm súng hoa cải, núp sau lùm cây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200582
    m_Localized: 'Vigilante: Rồi cả nhà hắn đi cửa sau trốn vào rừng. Ông đã dọn sạch lũ quái thai, nhưng rồi chả thấy nhà nó quay về.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200581
    m_Localized: 'Vigilante: Trước ông mày gặp một gia đình, có thằng bố nhìn chắc nịch. Gặp lũ Dị Khách gào thét ngoài cửa mà vẫn bình tĩnh lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200576
    m_Localized: Ông muốn đi tìm đứa nhỏ à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200575
    m_Localized: Ông có ổn không đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200574
    m_Localized: 'Vigilante: Thằng em tao mà đéo hèn như chó thì có khi vợ con nó đã an toàn. Giờ đéo biết con bé đấy đang ở đâu nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200573
    m_Localized: 'Vigilante: Ông quay lại rồi đây. Đéo hiểu sao mình phải mất công làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200572
    m_Localized: 'Vigilante: Địt mẹ nó, ông còn đống chuyện phải lo. Nay mai ông quay lại sau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200571
    m_Localized: 'Vigilante: Mày thử giơ cái tai ra lần nữa xem, ông bắn chết cụ mày ngay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200570
    m_Localized: 'Vigilante: Nếu không phải vì thằng em tao...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200569
    m_Localized: 'Vigilante: Tai đéo gì? Mày tưởng ông là thằng ngu hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200568
    m_Localized: 'Vigilante: Nói thật nhé, ông đéo quan tâm cái ảnh. Ông còn khối chuyện phải lo. Đêm nay mày thoát. Lần sau ông sẽ kiểm tra kỹ hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200567
    m_Localized: 'Vigilante: Hừm... Rõ là sạch. Ông đã chôn xác quá nhiều thằng trông cũng sạch như vậy rồi. Ảnh như này đéo chứng minh được gì hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200566
    m_Localized: 'Vigilante: Ảnh gì đây? Hào quang hả? Được, đưa đây xem mày "sạch" cỡ nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200565
    m_Localized: 'Vigilante: Không có dấu hiệu gì. Mày còn may đấy. Cất cái nách khỏi mặt ông nhanh. Ông còn chuyện quan trọng phải lo. Hôm sau ông quay lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200564
    m_Localized: 'Vigilante: Mày không có gì bất thường. Nhưng cũng đéo có nghĩa lý gì hết. Bọn quái thai kia giờ tinh vi xảo quyệt lắm, qua mắt được cả ông mày.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200563
    m_Localized: 'Vigilante: Hừm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200562
    m_Localized: 'Vigilante: Giờ ông bận, còn đầy chuyện phải lo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200561
    m_Localized: 'Vigilante: Đêm nay mày thoát. Nhưng nay mai ông thấy có gì bất thường, là ông đục lỗ thông gió giữa sọ mày.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200560
    m_Localized: 'Vigilante: Mày biết lũ Dị Khách trông "bình thường" nó quậy được đến cỡ nào chỉ trong một đêm không? Để lọt một đứa là chết hết cả lũ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200559
    m_Localized: 'Vigilante: Hừ... Không thấy dấu hiệu gì. Hay lắm. Hay vãi lồn luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200558
    m_Localized: 'Vigilante: Nhanh lên, ngón tay mày liệt rồi à. Mở cái mắt TO RA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200557
    m_Localized: 'Vigilante: Ông đéo rảnh mà dây dưa với mày. Lần tới ông sẽ kiểm tra kỹ hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200556
    m_Localized: 'Vigilante: Ông cho mày biết bí kíp sinh tồn đây: Cứ thấy đứa nào trông bình thường nhất là biết nó đéo bình thường chút nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200555
    m_Localized: 'Vigilante: Sạch đấy... Mà đéo sạch mới lạ chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200554
    m_Localized: 'Vigilante: Mẹ, ông chả rảnh để dây dưa với mày đâu. Còn lắm thứ phải kiểm tra. Lúc khác gặp lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200553
    m_Localized: 'Vigilante: Ông cho mày sống... qua đêm nay. Nhưng nay mai ông thấy có gì bất thường, là ông đục lỗ thông gió giữa sọ mày.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200552
    m_Localized: 'Vigilante: Hừm... Không có gì. Tiếc nhể.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200551
    m_Localized: 'Vigilante: Há to ra. Nhanh. Có cái đéo gì mà sợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200550
    m_Localized: (Cho xem tai)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200549
    m_Localized: (Cho xem ảnh chụp)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200548
    m_Localized: (Cho xem nách)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200547
    m_Localized: (Cho xem mắt)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200546
    m_Localized: (Cho xem bàn tay)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200545
    m_Localized: (Cho xem răng)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200544
    m_Localized: 'Vigilante: Có súng á? Ông mày dí cặc quan tâm. Thích thi xem thằng nào bắn trước không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200543
    m_Localized: 'Vigilante: Chứng minh mày không phải Dị Khách đi. Làm thế nào thì làm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200542
    m_Localized: 'Vigilante: Hừm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200541
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200540
    m_Localized: Chỉ có bé gái là thoát được thôi. Còn bác ấy chết rồi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200539
    m_Localized: Nhà bác ấy cháy rụi rồi. Sau đó bác ra sao tôi cũng không rõ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200538
    m_Localized: 'Vigilante: Con vợ nó thì... Thây kệ mẹ ả.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200537
    m_Localized: 'Vigilante: Nó có đứa con gái. Không rõ bao nhiêu tuổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200536
    m_Localized: 'Vigilante: Ê, tiện thể... Mày có thấy thằng cha nào người hơi lùn, chắc nịch, mặc áo khoác bò màu xanh không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200535
    m_Localized: 'Vigilante: Lũ Dị Khách sống nương nhờ mấy kẻ dễ mềm lòng. Mềm cho lắm, đến lúc bị làm thịt trong chính căn nhà của mình thì hối không kịp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200534
    m_Localized: 'Vigilante: Thì mày phải xuống tay hành đạo ngay, càng nhanh càng tốt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200533
    m_Localized: Chỉ có bé gái là thoát được thôi. Còn bác ấy chết rồi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200532
    m_Localized: Nhà bác ấy cháy rụi rồi. Sau đó bác ra sao tôi cũng không rõ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200531
    m_Localized: 'Vigilante: Con vợ nó thì... Thây kệ mẹ ả.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200530
    m_Localized: 'Vigilante: Nó có đứa con gái. Không rõ bao nhiêu tuổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200529
    m_Localized: 'Vigilante: Ê, tiện thể... Mày có thấy thằng cha nào người hơi lùn, chắc nịch, mặc áo khoác bò màu xanh không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200528
    m_Localized: 'Vigilante: Ông thấy một dấu hiệu là ông cho ăn đạn. Đéo phải lòng vòng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200527
    m_Localized: 'Vigilante: Trên TV với đài radio chỉ cách cho rồi thây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200526
    m_Localized: 'Vigilante: Cũng như mày thôi, chứ còn cách quái gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200525
    m_Localized: Lỡ họ chỉ có một hoặc hai dấu hiệu thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200524
    m_Localized: Sao ông biết được ai là Dị Khách?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200523
    m_Localized: 'Vigilante: Bọn Phòng Chống bỏ bê luôn thị trấn này rồi à? Hay mỗi khu này thôi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200522
    m_Localized: 'Vigilante: Tiện ông tạt qua kiểm tra vài căn nhà luôn. Mẹ, bên trong lúc nhúc Dị Khách với nhau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200521
    m_Localized: 'Vigilante: Ông tìm mãi cái đứa mà ông bảo hôm trước. Đéo thấy tăm hơi đâu cả.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200520
    m_Localized: 'Vigilante: Ông quay lại rồi đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200519
    m_Localized: 'Vigilante: Ông nhớ mặt mày rồi. Lần sau ông quay lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200518
    m_Localized: 'Vigilante: Ông phải đi kiểm tra đứa này đã.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200517
    m_Localized: 'Vigilante: Mà sao tự dưng mày nhắc đến bọn nó… Khả nghi vãi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200516
    m_Localized: 'Vigilante: Chúng nó có cách riêng để kiểm tra dấu hiệu lũ Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200515
    m_Localized: 'Vigilante: Bọn nó làm vậy là chí đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200514
    m_Localized: 'Vigilante: Nghỉ đi. Lúc khác nói tiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200513
    m_Localized: 'Vigilante: Ông phải bắt tận tay, day tận mặt, tự mình giải quyết hết thì mới an tâm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200512
    m_Localized: 'Vigilante: Nhưng ông chưa tin mày được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006469
    m_Localized: 'Vigilante: Ra là mày cũng đang cố giữ gìn trật tự. Được đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006468
    m_Localized: 'Vigilante: Ông nhớ mặt mày rồi. Lần sau ông quay lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006467
    m_Localized: 'Vigilante: Ừ, ông nom mày cũng đáng tin. Giọng điệu không giống mấy đứa hay đi bịa chuyện.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006466
    m_Localized: 'Vigilante: Hay đấy... Mày tận mắt thấy nó rồi hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006465
    m_Localized: 'Vigilante: Tức là nó không mặc giáp bảo hộ gì đúng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006464
    m_Localized: 'Vigilante: Chỉ có một tên thôi à? Mà lại còn cởi trần nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006463
    m_Localized: Lũ áo vàng đang đi bắt bớ người dân. Chả biết có thả họ về không nữa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006462
    m_Localized: Có Dị Khách nhan nhản khắp nơi. Nhưng tôi thủ sẵn súng đây rồi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006461
    m_Localized: Có tên Dị Khách cởi trần vừa giết sạch cả đội tuần tra
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006460
    m_Localized: 'Vigilante: Quanh khu phố này có gì bất thường không? Có mối họa nào ông cần để mắt không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006459
    m_Localized: 'Vigilante: Mày hỏi đủ rồi. Giờ đến phiên ông.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006458
    m_Localized: 'Vigilante: Im mồm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006457
    m_Localized: Ông định đi "dọn rác" đến bao giờ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006456
    m_Localized: Vậy ông đến đây làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006455
    m_Localized: 'Vigilante: Còn đứa nào để lại ấn tượng sâu sắc quá… thì ông lấy cái khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006454
    m_Localized: 'Vigilante: Giết được đứa Dị Khách nào, ông lại nhổ một cái răng. Lấy răng làm chiến lợi phẩm là gọn nhất.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006453
    m_Localized: 'Vigilante: Đây là huân chương chiến tích của ông, nhắc ông nhớ rằng mình đã thanh trừng bao nhiêu căn nhà, bao nhiêu thị trấn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006452
    m_Localized: 'Vigilante: Hừm. Nghe cũng kêu đấy. Từ giờ ông gọi thế luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006451
    m_Localized: 'Vigilante: "Vòng chống Dị Khách" gì? À, ý mày là cái vòng cổ này ấy hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006450
    m_Localized: Ông định đi "dọn rác" đến bao giờ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006449
    m_Localized: Vậy ông đến đây làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006448
    m_Localized: 'Vigilante: Còn đứa nào thương tiếc cho lũ Dị Khách thì... chắc chắn là cá mè một lứa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006447
    m_Localized: 'Vigilante: Mày biết cách nào hiệu quả nhất không? Nhốt cả lũ trong nhà rồi cho một mồi lửa là xong.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006446
    m_Localized: 'Vigilante: Dùng tay không ông cũng quét sạch được bọn rác rưởi, nhưng có cái này thì tiện hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006445
    m_Localized: 'Vigialante: Ừ. Chổi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006444
    m_Localized: 'Vigilante: Hừ. Chú mày cũng hài hước phết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006443
    m_Localized: Ông đeo cái gì trên cổ vậy? Vòng chống Dị Khách hay gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006442
    m_Localized: Ông đang cầm cái gì kia? Chổi hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006441
    m_Localized: 'Vigilante: Ông cần gì phải trốn. Ông đây chính là CÔNG LÝ. Ông đến dẹp loạn chỗ chúng mày đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006440
    m_Localized: 'Vigilante: Chẳng có công lý mẹ gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006439
    m_Localized: 'Vigilante: Nhưng đời đéo như mơ, được vài ngày thì lũ đó làm gỏi cả nhà luôn. Rồi chúng nó đi tìm nạn nhân mới.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006438
    m_Localized: 'Vigilante: Có những đứa rủ lòng thương hại bọn Dị Khách. Cứ nghĩ bọn nó sẽ... khỏi bệnh, trở lại bình thường.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006437
    m_Localized: 'Vigilante: Mày nhây với ông à? Ông nghiêm túc nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006436
    m_Localized: Ông đeo cái gì trên cổ vậy? Vòng chống Dị Khách hay gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006435
    m_Localized: Ông đang cầm cái gì kia? Chổi hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006434
    m_Localized: 'Vigilante: Mày chỉ cần biết vậy thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006433
    m_Localized: 'Vigilante: Vừa dọn xong khu nhà ông rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006432
    m_Localized: 'Vigilante: Ông đây đang đi dọn rác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006431
    m_Localized: Sao ông lại ra ngoài đường?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006430
    m_Localized: Ông là ai?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006429
    m_Localized: 'Vigilante: ...Trừ phi mày chính là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006428
    m_Localized: 'Vigilante: Vậy là khôn đấy. Thế mới sống lâu được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006427
    m_Localized: 'Vigilante: Mày cũng cảnh giác phết nhể?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006426
    m_Localized: 'Miner: Chẳng lẽ cậu lại phủi đít đi về? Quay về cuộc đời tẻ nhạt trước kia hả? NÀO, XUỐNG LẸ COI. Anh em ta phải cùng nhau phá giải tới cùng chứ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006425
    m_Localized: 'Miner: Lỡ đâu dưới đó có ẩn giấu bí mật chấn động kinh thiên thì sao? Vừa giải đáp mọi khúc mắc, vừa khiến dân tình tung hô cậu như người hùng...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006424
    m_Localized: 'Miner: Cái gì mà không biết được? GIỠN TÔI HẢ? Đây đâu phải là cái lỗ thông thường. Cậu cũng cảm nhận được, tôi biết mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006423
    m_Localized: 'Miner: SAO? Còn chờ gì nữa? Chúng ta ở đây là vì khoảnh khắc này mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006422
    m_Localized: 'Miner: Chả lẽ cậu muốn sống cả đời mà cứ băn khoăn tiếc nuối lựa chọn của mình, chỉ vì có tí sợ hãi nhất thời hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006421
    m_Localized: 'Miner: NÀO. Gan lên đi chứ. Cậu xuống đi, TÔI GIỮ CHO.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006420
    m_Localized: 'Miner: Cậu muốn biết dưới đó có gì đúng hông? Nhìn là biết cậu chả phải dân thỏ đế rồi. Xuống đây tới tận ba lần còn gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006419
    m_Localized: 'Miner: Một tay tôi còn dư sức kéo cậu lên được. Chứ tôi đi thì ai kéo nổi giờ? Có thế thôi mà cũng không hiểu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006418
    m_Localized: 'Miner: Tôi mà xuống thì ai kéo tôi lên, HẢ? Xin lỗi chứ lũ chuột nhắt nó còn đô con hơn cậu. Cậu xuống đi, tôi ngồi đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006417
    m_Localized: Lỡ mình không bao giờ biết được dưới đó có gì thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006416
    m_Localized: Sao bác không tự xuống lỗ mà xem?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006415
    m_Localized: 'Miner: Cậu cũng cảm nhận được đúng hông? Ma lực kỳ lạ ấy... như kiểu cái lỗ đang gọi mình xuống vậy. Cậu cũng nghe thấy mà NHỈ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006414
    m_Localized: 'Miner: Chú nào? Thôi tóm lại là, kiểu gì cũng phải có người đi. Tôi mà cứ ngồi chết dí ở đây là dở. Một là làm luôn, không thì nghỉ, thế thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006413
    m_Localized: Lỡ mình không bao giờ biết được dưới đó có gì thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006412
    m_Localized: Sao bác không tự xuống lỗ mà xem?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006411
    m_Localized: 'Miner: MÀ NÀY, tranh thủ lúc chờ thì giết thời gian xíu. Thử đi khám phá quanh đây một chuyến xem. Cậu cũng tò mò lắm chứ gì!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006410
    m_Localized: 'Miner: À, ừ. SỐNG CHỨ SAO KHÔNG. Dây còn căng ĐÂY NÀY. Tức là bạn tôi còn làm việc dưới đó. Nếu có chuyện gì thì tôi đã biết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006409
    m_Localized: Chú kia vẫn chưa về hay sao bác?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006408
    m_Localized: Liệu bạn bác còn sống không nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006407
    m_Localized: 'Miner: Nhưng còn cái lỗ... Nói thiệt đi, cậu bị nó thu hút bao nhiêu lần rồi? Nó cứ kéo mình vào, ĐÚNG CHƯA? Đừng có vòng vo làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006406
    m_Localized: 'Miner: Chả lẽ do tôi ngồi dưới đây lâu quá nên đầu óc nó mụ mị theo luôn?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006405
    m_Localized: 'Miner: Ô, RA LÀ CẬU À. Cứ tưởng cậu sợ quá trốn luôn rồi chớ. Mà ở đây có gì lạ lắm. Đèn sáng thất thường, dây thì nặng trịch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006404
    m_Localized: 'Miner: Nhìn tướng cậu mảnh khảnh thế kia coi bộ chả có sức rồi, nhưng tôi thì kéo cậu lên nhẹ hều. Hay cậu xuống thăm dò đi, để tôi... canh cho?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006403
    m_Localized: 'Miner: Cứ xuống một lượt là biết ngay mà. Tôi cũng chả ngại gì đâu, nhưng tôi mà đi thì... biết lấy ai cầm dây đây, NHỞ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006402
    m_Localized: 'Miner: Muốn biết thực hư có khi phải xuống dưới. Bao nhiêu bí ẩn sẽ được giải đáp: tụi nó trồi lên làm gì, rồi nó muốn cái gì... CẬU THỬ NGHĨ MÀ COI!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006401
    m_Localized: 'Miner: DỊ KHÁCH Á? Ừa, tụi tôi cũng nghĩ thế đấy. Chắc hầm này là của bọn nó hết. Còn cái lỗ kia có thể là... cánh cổng gì đó chăng?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006400
    m_Localized: 'Miner: Mà đâu có được, bọn tôi còn phải sát cánh, HIỂU KHÔNG? Người ở trên sẵn sàng bắt lấy người ở dưới chớ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006399
    m_Localized: 'Miner: Chả phải tôi sợ hay gì, nhưng mà... nó có ma lực hút mình vào ấy. Giá mà tôi được nhìn một lần nữa... Tiến thêm dăm bước nữa thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006398
    m_Localized: 'Miner: Nhưng mà má, lâu lâu đứng gần cái lỗ ấy... Cứ như có gì đang mời gọi mình vào vậy. Không tin cậu thử đi. Lắng tai... nghe mà coi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006397
    m_Localized: 'Miner: Có lần mém chết rồi, hồi mấy chiến hữu của tôi còn ở đây. Nhưng dưới đấy... nó thăm thẳm như vực sâu không đáy vậy. Đúng nghĩa hư vô luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006396
    m_Localized: 'Miner: Cũng muốn lắm ấy chớ, nhưng chỉ cần lỡ tay kéo dây nhầm một cái, là COI NHƯ XONG PHIM.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006395
    m_Localized: 'Miner: NHÌN HẢ? ...Ờ thì cũng có ngó qua. Cơ mà chưa nhìn kỹ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006394
    m_Localized: Bác không sợ bạn bác bị gì à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006393
    m_Localized: Bác đã nhìn xem trong lỗ có gì chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006392
    m_Localized: 'Miner: ĐẤY. Dây căng cứng đây này. Vẫn ở dưới đấy làm bình thường mà. Có gì sơ sẩy thì bọn tôi đã biết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006391
    m_Localized: 'Miner: Còn thằng kia thì đang buộc dây. Xong xuôi là nó kéo dây một cái, hay gặp nạn gì cũng kéo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006390
    m_Localized: 'Miner: GÌ? MẤY THẰNG BẠN CỦA TÔI Á? Xời ơi, sao đâu. Có một đứa vào tít bên trong, xong là ra ngay ấy mà. Nó đánh hơi giỏi lắm, tìm đường ra cái một.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006389
    m_Localized: Bác không sợ bạn bác bị gì à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006388
    m_Localized: Bác đã nhìn xem trong lỗ có gì chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006387
    m_Localized: 'Miner: Lên đấy nhớ ăn uống đầy đủ vào nhá, không là cậu lại gầy trơ xương như tôi, có mỗi cái đèn bầu bạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006386
    m_Localized: 'Miner: Mà ở đây nó tối như cái hũ nút, lại chả có đồng hồ. Chả biết ngày đêm hay giờ giấc gì luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006385
    m_Localized: 'Miner: HẢ? NÓI TO LÊN! Đúng là tôi ngồi dưới này được... hai ba ngày gì đấy rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006384
    m_Localized: 'Bạn bè của bác chưa lên được à? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006383
    m_Localized: Bác ở dưới đây được bao lâu rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006382
    m_Localized: 'Miner: Xuống rồi hả? GÌ CƠ? Do cậu nói nhỏ quá, hay do tôi điếc đặc vì nghe mãi cái tiếng ù ù kia nhỉ? HẢ? NÓI LẸ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006381
    m_Localized: 'Miner: Khi nào cậu xuống đây được thì tôi nói tiếp cho nghe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006380
    m_Localized: 'Miner: Lần trước bọn tôi đào thử gần đó thì xém nữa đất đá chôn sống cả đám luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006379
    m_Localized: 'Miner: NGHE LỜI TÔI, nếu cậu mà tính xuống đây thám hiểm... thì ĐỪNG CÓ BÉN MẢNG LẠI GẦN CÁI LỖ ĐẤY.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006378
    m_Localized: 'Miner: Một chiến hữu của tôi có nghe ngóng được về cái lỗ– rồi bảo mình nên vào xem xét một lần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006377
    m_Localized: 'Miner: Có mỗi một cái lỗ thôi. Nhưng mà chỗ đấy xảy ra nhiều chuyện lạ lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006376
    m_Localized: 'Miner: À không, cũng chả có gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006375
    m_Localized: 'Miner: HẢ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006374
    m_Localized: 'Miner: Lần trước bọn tôi đào thử gần đó thì xém nữa đất đá chôn sống cả đám luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006373
    m_Localized: 'Miner: NGHE LỜI TÔI, nếu cậu mà tính xuống đây thám hiểm... thì ĐỪNG CÓ BÉN MẢNG LẠI GẦN CÁI LỖ ĐẤY.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006372
    m_Localized: 'Miner: Trong đám bạn tôi thì có một khứa vào rồi. Tôi ở lại đây, ờm, phòng trường hợp nó cần giúp một tay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006371
    m_Localized: 'Miner: Mấy con vật đến gần đó là nín lặng. La bàn thì quay tứ tung. Còn đèn pin lại chả xi nhê, không chiếu rọi được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006370
    m_Localized: 'Miner: Mà kỳ quái lắm nhá. Tôi nghe có cái tiếng ù ù rất chi là khẽ quanh khu vực đấy, CỨ KÊU MÃI KHÔNG DỨT.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006369
    m_Localized: 'Miner: CÓ MỘT CÁI LỖ nữa cậu ạ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006368
    m_Localized: Bác tìm được Dị Khách hay sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006367
    m_Localized: Cái gì thế bác? Có gì hay ho không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006366
    m_Localized: 'Miner: NHƯNG NÀY, không phải chỉ có mỗi mấy đường hầm là lạ thôi đâu. Còn cái khác nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006365
    m_Localized: 'Miner: Tạm thời tôi chưa thấy con nào nên cũng chả dám nói chắc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006364
    m_Localized: 'Miner: Có khả năng tụi Dị Khách nó lần mò qua lại bằng đường này đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006329
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006328
    m_Localized: 'MushroomEater: Đây là thời khắc sống còn đó. Trong lúc ta còn bay nhảy ở đây thì Xứ Nấm sắp sụp đổ tới nơi. Và rồi chính chúng ta... cũng sẽ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006327
    m_Localized: 'MushroomEater: Một mình già làm không nổi đâu. Nhất định phải có con giúp mới được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006326
    m_Localized: 'MushroomEater: Ôi con trai ơi... Tình hình tệ lắm rồi đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006325
    m_Localized: 'MushroomEater: Không lẹ làng là cánh cổng Xứ Nấm sẽ đóng sầm lại!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006324
    m_Localized: 'MushroomEater: Trời đất quỷ thần ơi! Trễ mất rồi! Mau mau mau lên, vắt chân lên cổ mà chạy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006323
    m_Localized: 'MushroomEater: NỬA ĐÊM RỒI Á HẢ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006322
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006321
    m_Localized: 'MushroomEater: Nè, khoan nha. Cho già xem đồng hồ cái coi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006320
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006319
    m_Localized: 'MushroomEater: Con lo thu ghém đồ đạc đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006318
    m_Localized: 'MushroomEater: Ô hô! Sốt sắng đó con trai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006317
    m_Localized: Chưa ạ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006316
    m_Localized: Rồi ạ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006315
    m_Localized: 'MushroomEater: Nào, chúng ta cùng lên đường đi tới Xứ Nấm. Con đã sẵn sàng chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006314
    m_Localized: 'MushroomEater: Xưa giờ, chưa một con người nào dám đặt chân tới đó. Nhưng giờ ta buộc phải đi, để ngăn chặn Lễ Hội.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006313
    m_Localized: 'MushroomEater: Chúng ta phải hành động mau, không thì trễ đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006312
    m_Localized: 'MushroomEater: Già con mình thì hổng thấy được Lễ Hội Nấm đâu. Nhưng còn... những sợi nấm kia thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006311
    m_Localized: 'MushroomEater: Chớ để nó đánh lừa con ơi! Chỗ đó tuyệt nhiên không phải xứ sở thần tiên, miền đất diệu kỳ hay gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006310
    m_Localized: 'MushroomEater: Xứ Nấm trong tiếng người nghe thì vui thú đó... Nhưng sang tiếng nấm, nó lại mang ý nghĩa khác hoàn toàn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006309
    m_Localized: 'MushroomEater: Ô hô! Đừng để bị lừa nha con.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006308
    m_Localized: Chưa ạ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006307
    m_Localized: Rồi ạ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006306
    m_Localized: 'MushroomEater: Nào, chúng ta cùng lên đường đi tới Xứ Nấm. Con đã sẵn sàng chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006305
    m_Localized: 'MushroomEater: Ta phải ngăn chặn Lễ Hội Nấm lại, bằng mọi giá!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006304
    m_Localized: 'MushroomEater: Nói thiệt với con... lẽ ra không ai nên tới đó thì hơn. Nhưng chúng ta thực sự hết cách rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006303
    m_Localized: 'MushroomEater: Ô hô, nghe vậy mà đừng tưởng hay đó nhe! Đó là vùng đất cực kỳ đáng sợ, xưa giờ chưa ai từng đặt chân tới.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006302
    m_Localized: Nghe cũng đâu đến nỗi nào nhỉ...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006301
    m_Localized: Xứ Nấm ấy ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006300
    m_Localized: 'MushroomEater: Đã tới nước này rồi thì... không còn cách nào khác. Đành phải dấn thân vào Xứ Nấm mà thôi, con à.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006299
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006298
    m_Localized: 'MushroomEater: Mà như vậy thì hệ sợi nấm coi như tàn canh bí đao!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006248
    m_Localized: 'MushroomEater: Ngoan lắm con trai. Nhớ nghen, lúc nào rảnh thì mở ra đọc nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006247
    m_Localized: Thôi ông cứ giữ lấy mà cười
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812103
    m_Localized: 'CultistPriest: Tệ hơn nữa thì... mục đích thiêng liêng sẽ vĩnh viễn xa rời tầm với.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812102
    m_Localized: 'CultistPriest: Hãy trông chừng các vị tín hữu của ta. Nhớ lấy, chỉ cần một người mất mạng... đừng trách vì sao căn nhà lại hóa tro tàn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812101
    m_Localized: 'CultistPriest: Anh không khát cầu sự bình an ư? Một viễn cảnh chẳng ai là gánh nặng của nhau nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812100
    m_Localized: 'CultistPriest: Đúng như vậy. Con đường dẫn đến mục đích cao cả nào có bao giờ trải hoa hồng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812099
    m_Localized: Tôi không thích bị hăm dọa đâu. Mà thôi giúp thì giúp
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812098
    m_Localized: Láo nháo tao bắn bỏ hết giờ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812097
    m_Localized: 'CultistPriest: Thứ lỗi cho ta, nhưng đó là cách duy nhất để đảm bảo hoàn thành sứ vụ linh thiêng của chúng ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812096
    m_Localized: 'CultistPriest: Nếu chẳng may kết cục đó xảy đến, bọn ta sẽ nổi lửa thiêu rụi từng viên gạch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812095
    m_Localized: 'CultistPriest: Tệ hơn nữa thì mọi sự xem như trôi sông đổ biển.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812094
    m_Localized: 'CultistPriest: Hãy trông chừng các vị tín hữu của ta. Nhớ lấy, chỉ cần một người mất mạng... đừng trách vì sao căn nhà lại hóa tro tàn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812093
    m_Localized: 'CultistPriest: Vậy hãy để ngọn hỏa ngục thiêu đốt thân ngươi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812092
    m_Localized: Có vẻ đao to búa lớn phết nhờ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812091
    m_Localized: Nghe mà chả thấy có tí "nhiệt" nào
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812090
    m_Localized: 'CultistPriest: Tại đây, họ sẽ cử hành một số nghi lễ tiễn đưa người đã khuất. Ta chỉ nhờ anh bảo vệ họ mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812089
    m_Localized: 'CultistPriest: Nhưng các anh em của ta thì cần một nơi tá túc. Và chốn này lại có ma lực thu hút Tử Thần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812088
    m_Localized: 'CultistPriest: Ta thì không. Bởi sứ vụ của ta chỉ là truyền giảng chân lý thánh thiêng, hòng mang đến sự bình an vĩnh cửu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812087
    m_Localized: Có vẻ đao to búa lớn phết nhờ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812086
    m_Localized: Nghe mà chả thấy có tí "nhiệt" nào
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812085
    m_Localized: 'CultistPriest: Họ nhất định phải sống đến khi đã làm tròn mọi trọng trách được giao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812084
    m_Localized: 'CultistPriest: Dù gì đi nữa, các anh em của ta sẽ tìm đến đây. Anh hãy rộng cửa chào đón, và chở che họ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812083
    m_Localized: 'CultistPriest: Đã có chuyện gì xảy ra trong ngôi nhà này thế?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812082
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812081
    m_Localized: 'CultistPriest: Tử Thần đã tác động đến nơi đây vô cùng mạnh mẽ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812080
    m_Localized: 'CultistPriest: Căn nhà của anh chính là địa điểm lý tưởng. Thực nhiệm mầuuuu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812079
    m_Localized: 'CultistPriest: Bọn ta phải cử hành nghi lễ an táng, theo hình thức mới.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812078
    m_Localized: Thế ông có muốn vào không hay như nào?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812077
    m_Localized: Vậy rốt cuộc ông muốn gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812076
    m_Localized: 'CultistPriest: Ngài đang ở rất gần. Bọn ta chỉ đơn thuần là giúp Ngài vượt qua ngưỡng cửa giữa hai giới.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812075
    m_Localized: 'CultistPriest: Giáo hội chúng ta không tin vào sự cứu rỗi, trừ phi Tử Thần là đấng ban phát.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812074
    m_Localized: 'CultistPriest: Đây là tấm khăn liệm của ta. Khi nào chết đi ta sẽ cần đến. Chẳng cần tìm vải để khoác lên những người con đã ngã xuống.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812073
    m_Localized: 'CultistPriest: Có lẽ ta điên thật. Như vậy có gì là sai sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812072
    m_Localized: Thế ông có muốn vào không hay như nào?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812071
    m_Localized: Vậy rốt cuộc ông muốn gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812070
    m_Localized: 'CultistPriest: Đó là con đường duy nhất dẫn đến sự cứu rỗi... Chúng ta chẳng còn có thể quay đầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812069
    m_Localized: 'CultistPriest: Và giáo hội chúng ta chỉ làm tròn sứ mệnh đưa Ngài đến gần hơn mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812068
    m_Localized: 'CultistPriest: Tử Thần nay đã giáng trần, mang theo ước mong xoa dịu nhân loại, giải thoát chúng ta khỏi cảnh lầm than, thống khổ, loạn lạc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812067
    m_Localized: 'CultistPriest: Giáo hội chúng ta được trao sứ vụ rao giảng một đức tin mới, vâng lời truyền dạy giáo lý linh thiêng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812066
    m_Localized: Nhìn ông chả khác gì ba cái dân dị giáo khùng điên
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812065
    m_Localized: Mà ông là ai vậy? Ăn mặc kiểu gì lạ thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812064
    m_Localized: 'CultistPriest: Mừng vui đi, Tử Thần thích anh lắm đấyyyy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812063
    m_Localized: 'CultistPriest: Người thì chịu cảnh thiêu thân. Kẻ lại bị lôi ra khỏi nhà để hành quyết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812062
    m_Localized: 'CultistPriest: Tử Thần ở khắp muôn nơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812061
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812060
    m_Localized: 'CultistPriest: Chính xác như vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812059
    m_Localized: Nhìn ông chả khác gì ba cái dân dị giáo khùng điên
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812058
    m_Localized: Mà ông là ai vậy? Ăn mặc kiểu gì lạ thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812057
    m_Localized: 'CultistPriest: Ta không rõ đã bao nhiêu sinh mệnh lìa đời ở nơi này... nhưng năng lượng của Ngài tỏa ra rất mạnh mẽ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812056
    m_Localized: 'CultistPriest: Tử Thần đã sinh niềm gắn bó với mái ấm của anh. Ngài mến yêu nó vô ngần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812055
    m_Localized: 'CultistPriest: ...Sự hiện diện của Tử Thần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812054
    m_Localized: Lại chẳng. Nhà tôi mà
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812053
    m_Localized: Ông cảm được cái gì cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812052
    m_Localized: 'CultistPriest: Ta cảm nhận được rõ mồn một.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812051
    m_Localized: 'CultistPriest: Thực nhiệm mầuuu. Căn nhà của anh quả là nơi lý tưởng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812050
    m_Localized: 'Courier: Đây. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812041
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812040
    m_Localized: 'Courier: Dân shipper quèn thì có cái mẹ gì đâu mà sợ sệt? Thả mỗi gói hàng thôi cũng đéo tha? Rồi giết người ta làm chó gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812039
    m_Localized: 'Courier: Con mẹ nó chứ, người ta điên hết cả lũ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812038
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812037
    m_Localized: 'Courier: Cậu ta đi giao hàng, thì tự dưng tên chủ nhà đó…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812036
    m_Localized: 'Courier: Bạn của tôi bị giết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812035
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812034
    m_Localized: Có chuyện gì thế anh?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812033
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812030
    m_Localized: 'Courier: Giao hàng đây…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812029
    m_Localized: 'Courier: Chúc anh buổi tối vui vẻ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812027
    m_Localized: 'Courier: Nhỡ đâu thiếu ngủ quá mắt tôi cũng đỏ lòm thì sao đây? Bọn nó định bế tôi vào cái khu cách ly chó đẻ đó luôn à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812025
    m_Localized: 'Courier: Vẫn kiểm tra mỗi sáng như thường lệ, rồi bọn nó thấy mắt cậu ta có màu đỏ… Con mẹ nó chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812024
    m_Localized: 'Courier: Đồng nghiệp tôi bị đám Thảm Họa bế đi rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812023
    m_Localized: Sao nhìn mặt anh buồn xo vậy
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812019
    m_Localized: 'Courier: Thà có việc để làm còn đỡ anh ạ, còn hơn ngồi dí một chỗ mà nghĩ quẩn nghĩ quơ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812018
    m_Localized: 'Courier: Thì… chứ tôi biết làm gì nữa đây? Nằm nhà chờ chết chắc?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812015
    m_Localized: Sao anh lại chọn nghề shipper vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812013
    m_Localized: 'Courier: Xin chào, giao hàng For Rest đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812005
    m_Localized: Mấy tay shipper vẫn còn làm việc cơ à
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812003
    m_Localized: 'Courier: Xin chào, giao hàng For Rest đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812000
    m_Localized: 'Intruder: Anh có nghĩ con người ta rồi sẽ bắt đầu mơ lại không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811999
    m_Localized: 'Intruder: Nhưng sẽ tốt biết mấy, nếu trong nhà này có ai nằm mơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811929
    m_Localized: 'GraveDigger: Thôi mệt lắm rồi. Giờ tui đi đào một cái mồ thiệt sâu, chui vô trỏng nằm rồi BÁI BAI cuộc đời này luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811928
    m_Localized: 'GraveDigger: Tui nghe ngừ ta kể rồi cậu ơi... Có đứa đi công chuyện, vừa dìa tới nhà xong thì BÙM MỘT CÁI! Xong phim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811927
    m_Localized: 'GraveDigger: Rồi tới một ngày đẹp trời, tụi Dị Khách nó gõ cửa ghé thăm. Xui hơn nữa thì nó ngồi sẵn trong nhà, chỉ chờ mình dìa để thịt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811926
    m_Localized: 'GraveDigger: Dìa nhà thì vắng lạnh, hổng có ai đón mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811925
    m_Localized: 'GraveDigger: Cả một đời dãi nắng dầm mưa, quần quật suốt ngày. Đi đào tới gãy mẹ lưng. Rồi rút cục để được cái chó gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811924
    m_Localized: 'GraveDigger: Bà cha nhà nó chớ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811923
    m_Localized: 'GraveDigger: Hổng ấy cậu đóng cửa lẹ lẹ giùm tui với. Tui sợ mấy con Dị Khách hồi nãy bám theo lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811922
    m_Localized: 'GraveDigger: Đội ơn cậu nghen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811921
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811920
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811919
    m_Localized: 'GraveDigger: Thôi, nói chung là tui nghỉ phẻ! Kệ mẹ nó đi, nghĩ nhiều chi cho mệt ngừ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811918
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811917
    m_Localized: 'GraveDigger: Mất công đẻ ra rắc rối vậy đó, mà nó đâu nuôi mình được bữa nào đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811916
    m_Localized: 'GraveDigger: Thời gian buổi tối có nhiêu đâu, phải tranh thủ mần chuyện khác chớ. Với lại đằng nào mặt trời hổng đốt sạch mấy cái xác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811915
    m_Localized: 'GraveDigger: Giờ hổng còn ai mang xác tới nhờ chôn nữa. Tận thế tới nơi rồi, bà con còn mai táng đàng hoàng mần chi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811914
    m_Localized: 'GraveDigger: Nghề khỉ gì nữa cậu ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811913
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811912
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811911
    m_Localized: 'GraveDigger: Tui chạy bán sống bán chết, hổng ngoái đầu dòm lại. Giờ tui cũng hổng dám dìa nhà, tại tầm này mà ở một mình thì càng chết nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811910
    m_Localized: 'GraveDigger: Một con Dị Khách chình ình đang từ dưới đất chui lên! Còn thằng cha dòm tui thì cười nắc nẻ như được mùa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811909
    m_Localized: 'GraveDigger: Ban đầu tui tưởng là đá thôi. Nhưng mà méo phải cậu ơi, nguyên cái bàn tay thò ra luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811908
    m_Localized: 'GraveDigger: Còn tui cứ vậy mà đào, đào hoài, đào miết. Rồi cạch một cái, hình như xẻng đập trúng cái gì đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811907
    m_Localized: 'GraveDigger: Lúc tui mần thì hắn chỉ đứng yên một chỗ, dòm tui chăm chú.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811906
    m_Localized: 'GraveDigger: Trời ơi ta nói, thấy rõ rành rành luôn là đằng khác. Có một khứa kêu tui đi đào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811905
    m_Localized: Thế là anh bỏ nghề luôn hay sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811904
    m_Localized: Bộ anh thấy gì trong lúc đào huyệt à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617825
    m_Localized: 'GraveDigger: Vậy là mấy cái xác cứ nằm một đống ở đó, chờ cho mặt trời hỏa táng hết sạch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617824
    m_Localized: 'GraveDigger: Mấy bữa rày, ngừ ta chết đầy đường như rơm như rạ. Mà hổng có ai chôn xác cho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617823
    m_Localized: 'GraveDigger: Tui mới gặp chuyện này ngộ dễ sợ luôn! Cái huyệt mộ tui vừa đào xong á...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617822
    m_Localized: 'GraveDigger: Úi, xin lỗi cậu vì đã đập cửa rần rần... Chuyện là...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617821
    m_Localized: Thế là anh bỏ nghề luôn hay sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617820
    m_Localized: Bộ anh thấy gì trong lúc đào huyệt à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617819
    m_Localized: 'GraveDigger: Tầm này đâu còn ai dựng mồ mả. Ngừ ta cứ vậy mà chết như rạ, xác nó rục một đống tại chỗ luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617818
    m_Localized: 'GraveDigger: Xưa tui mần nghề đào huyệt mộ. Mà giờ mần chi nữa, có còn nghĩa lý gì đâu…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617817
    m_Localized: 'GraveDigger: Bản thân tui cũng có ngủ được miếng nào đâu trời.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617816
    m_Localized: 'GraveDigger: Thôi thôi mà, cậu bớt nóng. Tui đâu cố ý dựng đầu cậu dậy hay gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617815
    m_Localized: Tin tôi đập cái đầu ông vào cửa luôn không? Ồn vãi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617814
    m_Localized: Đừng có đập cửa nhà tôi nữa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617813
    m_Localized: 'GraveDigger: Còn sống thì mở cửa cho tui vô với.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617812
    m_Localized: 'GraveDigger: Nhà mình ơiiii? Có ai ở trỏng hông vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617811
    m_Localized: 'Marauder: Sủi luôn rầu hả. Dẫy thâu, tui cũng té đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617810
    m_Localized: 'Marauder: Sao im quá dẫy... Cậu còn đó hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617809
    m_Localized: 'Marauder: ... '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617808
    m_Localized: 'Marauder: Tui chỉ ghé qua ngó ngó cái thâu. Hổng có lân la làm trò gì đâu, thề.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617807
    m_Localized: 'Marauder: Dẫy cho tui hỏi xíu... Mấy căn nhà gần đây có cái nào còn trống hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617806
    m_Localized: 'Marauder: À dẫy thâu. Hổng sao hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617805
    m_Localized: 'Marauder: Đảm bảo toàn chuyện hay. Nghe là cuốn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617804
    m_Localized: 'Marauder: Buồn buồn mà thích nghe chuyện thì cứ kiếm tui. Tui biết nhiều chuyện lắm, kể tới Tết Công Gô luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617803
    m_Localized: 'Marauder: Trời quơi đã qué! Cuối cùng cũng được nằm ngủ ra người ra ngợm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617802
    m_Localized: 'Thôi bác đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617801
    m_Localized: 'Bác vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617800
    m_Localized: 'Marauder: Thâu sẵn có chủ nhà đây... cho tui xin vô ở ké đêm nay được hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617799
    m_Localized: 'Marauder: Ờ mà tính ra... có đúng một lần. Tại tui bần cùng bí bách quá rầu. Chuyện dài lắm, bữa nào tiện tui kể cho nghe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617798
    m_Localized: 'Marauder: Ờ thì tui hổng phải dân tử tế gì, nhưng cũng có đạo đức của tui chớ bộ. Gặp người ta là tui né, hổng đụng chạm gì tới ai nghen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617797
    m_Localized: 'Marauder: Ủa? Bộ cậu nghĩ tui là giang hồ hổ báo hay gì hả? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617796
    m_Localized: 'Thôi bác đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617795
    m_Localized: 'Bác vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617794
    m_Localized: 'Marauder: Tui biết nhiều chuyện hay lắm. Cho tui vô đi, tui kể nghe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617793
    m_Localized: 'Marauder: Hổng có ý gì đâu. Thâu sẵn có chủ nhà đây... cho tui xin vô ở ké mấy bữa được hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617792
    m_Localized: 'Marauder: Nãy cũng dẫy đó… tui tính tọt vô chỗ cậu trú nhờ. Ai dè đâu chỗ này có người ở.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617791
    m_Localized: 'Marauder: Có lúc tui tưởng mình rửa tay gác kiếm được rầu... Mà rút cục vẫn làm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617790
    m_Localized: 'Marauder: Gặp đồ gì thó được là thó. Một mẻ đem bán lấy tiền, mẻ còn lại giữ làm của riêng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617789
    m_Localized: 'Marauder: Ờ thì... cũng hổng giấu cậu làm gì. Cứ thấy nhà nào trống là tui vô ở luôn. Nhà hoang hay căn hộ bỏ không gì cũng quất.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617788
    m_Localized: Bác có đi ăn cắp không đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617787
    m_Localized: 'Bác sống một mình kiểu gì hay vậy? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617786
    m_Localized: 'Marauder: Cứ dẫy miết tui cũng điên luôn cái đầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617785
    m_Localized: 'Marauder: Nhưng mà thú thiệt với cậu chớ, tui ở một mình chán lắm rầu. Tám chuyện với ma cỏ hoài, buồn muốn chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617784
    m_Localized: 'Marauder: Lúc đầu, tui cứ tưởng như dẫy là an toàn. '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617783
    m_Localized: 'Marauder: Kể từ khi cái tụi Dị Khách gì đó xuất hiện là tui đã bươn chải một mình rầu. '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617782
    m_Localized: 'Marauder: Ổn chớ sao hông.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617781
    m_Localized: Bác có đi ăn cắp không đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617780
    m_Localized: 'Bác sống một mình kiểu gì hay vậy? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617779
    m_Localized: 'Marauder: Mà gặp nhóm nào tui chơi cũng hổng hạp... Nên giờ lang bạt ngoài đường, thui thủi kiếm ăn một mình dẫy đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617778
    m_Localized: 'Marauder: Tui trải đời rầu, thấy biết bao hạng người rầu. Nhiều đứa sống chó lắm cậu ơi, cỡ tui là còn coi được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617777
    m_Localized: 'Marauder: Làm như tụi nó cao sang lắm hổng bằng. Mấy mày cũng hạng tôm tép như tao thâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617776
    m_Localized: 'Marauder: Tại có đứa nào muốn dây dưa với tui đâu. Trong mắt tụi nó tui hông khác gì đáy xã hội. '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617775
    m_Localized: Vậy có ổn không bác ơi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617774
    m_Localized: Sao bác có một thân một mình thế này?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617773
    m_Localized: 'Marauder: Hổng ấy... Cậu cho tui trú lại vài ba bữa được hông? Kiểu tui bị... thiếu hơi người lâu quá rầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617772
    m_Localized: 'Marauder: À mè...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617771
    m_Localized: 'Marauder: Úi, xin lẫu nghen. Tui tưởng chỗ này bỏ hoang… Thâu chào cậu nhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617770
    m_Localized: 'Marauder: Thấy bà... Có người sống trong này thiệt luôn hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617769
    m_Localized: 'Provocateur: Chúc anh buổi tối vui vẻ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617768
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617767
    m_Localized: 'Provocateur: Anh đã vi phạm nghiêm trọng Điều 119 của Bộ luật hình sự. Đây sẽ là bằng chứng chống lại anh nếu tôi quyết định thưa kiện.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617766
    m_Localized: 'Provocateur: Yêu cầu anh cẩn trọng phát ngôn. Trường hợp này, tôi có căn cứ cho rằng hành vi của anh là đe dọa tính mạng tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617765
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617764
    m_Localized: 'Provocateur: Sao cơ? Anh bảo tôi nên đi chỗ khác? Anh đang uy hiếp tôi đó hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617763
    m_Localized: 'Provocateur: Về các điều khoản thuê nhà, chúng ta hãy bàn bạc thỏa thuận sau nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617762
    m_Localized: 'Provocateur: Xin cảm ơn chủ nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617761
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617760
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617759
    m_Localized: 'Provocateur: Anh phải để tôi trả tiền, không thì tôi nhất quyết không vào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617758
    m_Localized: 'Provocateur: Như vậy là không biết phép tắc. Thậm chí phải gọi là xem thường pháp luật.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617757
    m_Localized: 'Provocateur: Xin lỗi anh, tôi không cảm thấy thoải mái khi tạm trú tại nơi ở của anh mà không trả tiền thuê trọ đàng hoàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617756
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617755
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617754
    m_Localized: 'Provocateur: Thôi được, chúng ta sẽ giải quyết vấn đề này sau, thông qua hợp đồng pháp lý đầy đủ chi tiết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617753
    m_Localized: 'Provocateur: Không thể tin được... Đường đường là chủ sở hữu tài sản cho thuê, mà lại đi chê tiền tươi thóc thật ư.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617752
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617751
    m_Localized: 'Provocateur: Gì chứ? Bộ trông tôi túng thiếu lắm hay sao mà cần anh làm phước?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617750
    m_Localized: Tôi không cần tiền của anh
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617749
    m_Localized: Anh thích trả nhiêu thì trả, tùy tâm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617748
    m_Localized: 'Provocateur: Xin lỗi anh, tôi không thể chiếm dụng bất kỳ diện tích đất có giá trị nào mà không trả phí đàng hoàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617747
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617746
    m_Localized: 'Provocateur: Sao cơ? Anh cho ở nhờ ư? Bộ anh là mạnh thường quân, xây nhà tình thương để cưu mang người vô gia cư à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617745
    m_Localized: Tôi không cần tiền của anh
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617744
    m_Localized: Anh thích trả nhiêu thì trả, tùy tâm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617743
    m_Localized: 'Provocateur: Tuy nhiên... Để thay thế việc lập hợp đồng chính thức, anh hãy cho tôi biết giá trọ một đêm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617742
    m_Localized: 'Provocateur: Thôi không sao, chúng ta có thể hoàn tất thỏa thuận sau, miễn là anh sắp xếp lịch hẹn hợp lý.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617741
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617740
    m_Localized: 'Provocateur: Chà... Nghe mập mờ quá nhỉ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617739
    m_Localized: Tôi chỉ cho người ta ở nhờ thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617738
    m_Localized: Cũng đại loại thế
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617737
    m_Localized: 'Provocateur: Xin chào chủ nhà, anh cho thuê phòng đúng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617736
    m_Localized: 'TaxiDriver: Rút cục chú cũng đéo tử tế hơn mấy thằng chó Thảm Hại được miếng nào. Thôi, chúc chú lên bàn thờ sớm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617735
    m_Localized: 'TaxiDriver: Má nó chớ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617734
    m_Localized: 'TaxiDriver: Biết là tui đang hoảng thiệt, nhưng chỉ vì vậy mà xua tui đi phũ phàng dị đó hả!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617733
    m_Localized: 'TaxiDriver: Thôi mà chú ơi... Mần người ai lại mần vậy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617732
    m_Localized: 'TaxiDriver: Sơ hở một cái là bị tụi nó túm đi liền.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617731
    m_Localized: 'TaxiDriver: Chú nhớ lời tui dặn: tin ai thì tin, đừng tin mấy thằng chó áo vàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617730
    m_Localized: 'TaxiDriver: Hên quá... Cám ơn chú nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617729
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617728
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617727
    m_Localized: 'TaxiDriver: Nên tui bấm nút vọt lẹ. Giờ đâu dám về nhà nữa. Kiểu chi mấy thằng chả cũng mai phục sẵn trước cửa, chờ tui về là bớ đi luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617726
    m_Localized: 'TaxiDriver: Tụi nó tính hốt tui vô lò mổ, mần thịt chung với cha Dị Khách tui vừa mang tới luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617725
    m_Localized: 'TaxiDriver: Tức thì, tui phóng xe chở ổng tới Cơ quan Phòng Chống một mạch luôn. Má ta nói ngu gì đâu á.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617724
    m_Localized: 'TaxiDriver: Kiểu, tui mới liếc qua gương chiếu hậu một phát đã thấy nguyên hàm răng trắng như ma lem. Trắng còn hơn Bạch Tuyết nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617723
    m_Localized: 'TaxiDriver: Cá mười ăn mười thằng cha đó là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617722
    m_Localized: 'TaxiDriver: Nói chứ, hổng phải tui hoang tưởng hay chi đâu, nhưng mà á...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617721
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617720
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617719
    m_Localized: 'TaxiDriver: Xong tui túm liền cái chai thủy tinh trong túi áo, dọng bể đầu một thằng rồi ba chân bốn cẳng mà chạy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617718
    m_Localized: 'TaxiDriver: Mấy thằng ba trợn đó lôi đầu tui ra khỏi xe! Tụi nó muốn bắt nhốt tui vô lò mổ luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617717
    m_Localized: 'TaxiDriver: Mới đầu mấy cha cán bộ còn khen tui kiểu "Tốt lắm, đúng là công dân mẫu mực. Giúp chúng tôi cũng là giúp anh!" Ba la bô lô một hồi thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617716
    m_Localized: 'TaxiDriver: Tui cũng nghi nghi rồi, nên mới chở ổng tới thẳng chỗ Cơ quan Phòng Chống. Bên đó mà tóm được thì ổng có chạy đằng trời.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617715
    m_Localized: 'TaxiDriver: Bữa đó tui chở khách, mà tự nhiên thấy ổng nhe nguyên cái hàm răng trắng bóc, trắng như ma lem dị đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617714
    m_Localized: 'TaxiDriver: Má mấy thằng chó bên Phòng Chống Thảm Họa, nó hốt mất xe tui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617713
    m_Localized: Ông khách giờ sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617712
    m_Localized: Xe của anh sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617711
    m_Localized: 'TaxiDriver: Mà nói vậy cũng hổng đúng. Có phải do tui ngu đâu. Lỡ tin lộn người thôi ý mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617710
    m_Localized: 'TaxiDriver: Cũng tại tui khờ, tui chủ quan quá nên mới mất.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617709
    m_Localized: 'TaxiDriver: Ờm, thôi tui nói thẳng vô vấn đề nha... Cái xe nó đi luôn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617708
    m_Localized: Ông khách giờ sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617707
    m_Localized: Xe của anh sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617706
    m_Localized: 'TaxiDriver: Giờ ổng với cái xe tui dắt nhau rồng rắn lên mây. Chả còn đây nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617705
    m_Localized: 'TaxiDriver: Thì đó... té ra ông khách này ổng chơi tui một vố. Nói người mà hổng phải người.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617704
    m_Localized: 'TaxiDriver: Chuyện nó vầy nè, bữa đang hôm chở khách thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617703
    m_Localized: 'TaxiDriver: Chà, biết nói sao ta... Số là, tui mần nghề lái taxi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617702
    m_Localized: Anh cần giúp gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617701
    m_Localized: Có chuyện gì thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617700
    m_Localized: 'TaxiDriver: Nói chứ tui đang bị dí sát đít luôn rồi. Chú cho tui vô lánh nạn xíu nha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617699
    m_Localized: 'TaxiDriver: Chào chú.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617698
    m_Localized: 'Edgar: Mình định tìm một bóng râm nào đấy. Nhưng xin cậu... khi mình ra đi, đừng vứt bỏ thân xác mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617697
    m_Localized: 'Edgar: Mình sẽ chờ đợi thần chết dang rộng vòng tay êm ái đón chào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617696
    m_Localized: 'Edgar: Vậy cho phép mình nán lại gần bên, cậu không phiền chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617695
    m_Localized: 'Edgar: Khi hồi kết đã điểm, mong cậu hãy giữ lại thân xác mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617694
    m_Localized: 'Edgar: Mình chưa rõ cậu có nhìn thấy cái đẹp như mình không. Nói thật đi... Có phải cậu vứt bỏ những thi thể vào màn đêm thăm thẳm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617693
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617692
    m_Localized: 'Edgar: Nơi đây thực sự vắng lặng hơn thảy mọi nơi mình từng đến.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617691
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617690
    m_Localized: Cậu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617689
    m_Localized: 'Edgar: Tại đây, mình có thể buông xuôi, hòa vào miền đất vô định cuối con đường. Và rồi mình sẽ thanh thản ra đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617688
    m_Localized: 'Edgar: Đó là lý do mình tìm đến chốn này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617687
    m_Localized: 'Edgar: Thôi cậu ạ. Không cần tử tế với mình vậy làm gì. Chẳng hiểu sao... mình có cảm tưởng nơi đây sẽ sẵn lòng đón nhận kết cục tất yếu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617686
    m_Localized: 'Edgar: Cậu nghĩ làm vậy thì sẽ giảm nhẹ tình trạng nhiễm trùng huyết à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617685
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617684
    m_Localized: Cậu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617683
    m_Localized: 'Edgar: Và giờ chỉ còn mình đứng đây. Đơn côi, lẻ bóng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617682
    m_Localized: 'Edgar: Cho đến khi... những kẻ ấy ập đến. Chuyện sau đó... có lẽ cậu cũng lờ mờ đoán được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617681
    m_Localized: 'Edgar: Mỗi ngày trôi qua... nàng một đổi khác. Từng chút một. Thực đẹp đẽ, đáng quý làm sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617680
    m_Localized: 'Edgar: Ngày xưa ấy, mình từng chung sống với người con gái mình thương.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617679
    m_Localized: 'Edgar: Câu hỏi hay. Tạm thời... mình chỉ nói được thế này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617678
    m_Localized: Có cần cắt bỏ cánh tay của cậu không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617677
    m_Localized: Cậu làm sao mà bị hoại thư vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617676
    m_Localized: 'Edgar: Mình lạc lõng trong guồng quay hối hả của cuộc sống vất vả mưu sinh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617675
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617674
    m_Localized: 'Edgar: Câu chuyện đời mình chỉ có thể chấm dứt bằng liều thuốc đắng mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617673
    m_Localized: 'Edgar: Mỗi sáng khi thức giấc, mình cứ nằm dài trên giường, tự hỏi liệu có còn sống để thấy được ngày mai không.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617672
    m_Localized: 'Edgar: Dù thế nào mình vẫn cứ run bần bật. Bị thối rữa nó là như thế, cậu à.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617671
    m_Localized: 'Edgar: Một cơn sốt bủa vây. Đường phố không còn dịu mát khi đêm về.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617670
    m_Localized: 'Edgar: Mình run rẩy, thậm chí ngột ngạt giữa hơi nóng của đô thị tấp nập.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617669
    m_Localized: 'Edgar: Yên ắng... Trống trải... Nơi này mới thật êm đềm, tĩnh tại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617668
    m_Localized: Có cần cắt bỏ cánh tay của cậu không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617667
    m_Localized: Cậu làm sao mà bị hoại thư vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617666
    m_Localized: 'Edgar: Mình muốn chọn chốn này làm nơi an nghỉ. Chậm rãi. Lặng im. Nâng niu lấy từng khoảnh khắc cuối cùng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617665
    m_Localized: 'Edgar: Ở đấy, con người tuyệt vọng tìm mọi cách để sinh tồn. Nhưng còn nơi đây... cậu chỉ bình thản đón nhận những điều sẽ đến.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617664
    m_Localized: 'Edgar: Tiếng ồn của phố thị cứ bám dính lấy mình, tựa mồ hôi. Vội vã, xô bồ, cuồng quay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617663
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617662
    m_Localized: 'Edgar: Câu chuyện đời mình chỉ có thể chấm dứt bằng liều thuốc đắng mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617661
    m_Localized: 'Edgar: Mỗi sáng khi thức giấc, mình cứ nằm dài trên giường, tự hỏi liệu có còn sống để thấy được ngày mai không.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617660
    m_Localized: 'Edgar: Mình đang ốm nặng, cậu à. Không chỉ hoại thư, mà còn tâm bệnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617659
    m_Localized: Chỗ này thì có cái gì mà xinh chứ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617658
    m_Localized: Sao cậu không ở nhà đi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617657
    m_Localized: 'Edgar: Chẳng hay, cậu rộng lòng cho mình tá túc có được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617656
    m_Localized: 'Edgar: Nơi đây thật yên tĩnh, còn trong thành phố thì toàn những tiếng thét gào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617655
    m_Localized: 'Edgar: Ô, xin chào. Ngôi nhà cậu xinh thế nhỉ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617654
    m_Localized: 'Foreigner: (Một lát sau, ảnh mới quay lưng bỏ đi)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617653
    m_Localized: 'Foreigner: (Tiếng la của bạn làm anh ta giật bắn mình)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617652
    m_Localized: Đi đi, còn đứng đây làm gì nữa!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617651
    m_Localized: 'Foreigner: (Anh ta cứ đứng đó mãi và lẩm bẩm tiếp)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617650
    m_Localized: 'Foreigner: (Ảnh gật đầu và bước vào trong)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617649
    m_Localized: Thôi biến giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617648
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617647
    m_Localized: 'Foreigner: (Trông không rõ lắm, nhưng gò má ảnh dường như ướt đẫm hai hàng nước mắt)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617646
    m_Localized: "Foreigner: (Anh ta chỉ biết đứng đó, nhìn \ntrân trân qua ống nhòm cửa)"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617645
    m_Localized: Thôi biến giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617644
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617643
    m_Localized: 'Foreigner: (Trông không rõ lắm, nhưng gò má ảnh dường như ướt đẫm hai hàng nước mắt)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617642
    m_Localized: 'Foreigner: (Anh ta vừa vẫy tay, vừa lẩm bẩm gì đó)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617641
    m_Localized: Rồi anh muốn tôi phải làm sao đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617640
    m_Localized: Có người khâu miệng anh à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617639
    m_Localized: 'Foreigner: (Miệng ảnh mấp máy lần nữa, có điều bạn không nghe ra được chữ nào)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617638
    m_Localized: 'Foreigner: (Lông mày anh ta nhướn lên đầy khổ sở)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617637
    m_Localized: Rồi anh muốn tôi phải làm sao đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617636
    m_Localized: Có người khâu miệng anh à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617635
    m_Localized: 'Foreigner: (Trông như kiểu muốn trả lời cũng không được)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617634
    m_Localized: 'Foreigner: (Anh thanh niên nhíu mày và nhìn bạn trân trối)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617633
    m_Localized: Hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617632
    m_Localized: Anh bị làm sao vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617631
    m_Localized: 'Foreigner: Ưmmmmmmmmm?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617630
    m_Localized: 'Foreigner: Ưmmmm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617629
    m_Localized: 'Doctor: Bác sẽ ở gần đây thôi. Cần hỗ trợ gì thì cứ gọi bác nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617628
    m_Localized: 'Doctor: Bác hiểu mà. Thời buổi này cũng khó mà tin ai cho được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617627
    m_Localized: 'Doctor: Cảm ơn cháu. Bác chỉ mong có thể giúp được ai đó quanh đây thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617626
    m_Localized: Thôi bác đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617625
    m_Localized: Bác vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617624
    m_Localized: 'Doctor: Nếu cháu làm phước cho bác vào, bác sẽ kể hết cho cháu nghe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617623
    m_Localized: 'Doctor: Thôi, chuyện dài dòng lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617622
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617621
    m_Localized: 'Doctor: Ở khu trung tâm trước kia cũng từng có một cái bệnh viện. Nhưng rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668865
    m_Localized: 'Doctor: Nếu cháu chịu cho bác vào, bác sẽ kể cho nghe ở mấy bệnh viện đã xảy ra chuyện gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668864
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617620
    m_Localized: Thôi bác đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617619
    m_Localized: Bác vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617618
    m_Localized: 'Doctor: Nhưng còn bây giờ thì… các bệnh viện đều đã đóng cửa. Nên là bác cứ đi khắp nơi, gặp ai cần giúp thì giúp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617617
    m_Localized: 'Doctor: Khoa bác công tác lúc nào cũng thiếu kinh phí, nên bác thường phải nhận luôn những ca vượt ngoài chuyên môn của mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617616
    m_Localized: 'Doctor: Bác là bác sĩ phẫu thuật. Trước đây bác chuyên mổ cho người bệnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617614
    m_Localized: Bác từ đâu đến?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617613
    m_Localized: Bác là ai vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617612
    m_Localized: 'Doctor: Cơ mà tự dưng phá khóa thì cũng hơi bất lịch sự, nên bác gõ cửa coi như là xin phép trước.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617611
    m_Localized: 'Doctor: Thấy ở đây yên tĩnh quá, bác còn tưởng nhà bỏ hoang chứ. Thế nên bác mới ghé lại xem thử.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617610
    m_Localized: 'Doctor: Cũng tìm kiếm sự an toàn... Nếu may mắn thì có người trò chuyện cùng cho đỡ buồn càng tốt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617609
    m_Localized: 'Doctor: Bác cũng giống như những người khác thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617608
    m_Localized: 'Doctor: Sao cháu lại hỏi thế?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617607
    m_Localized: Bác từ đâu đến?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617606
    m_Localized: Bác là ai vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617605
    m_Localized: 'Doctor: ...Không thì cũng tiếng gào thét.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617604
    m_Localized: 'Doctor: ...Hoặc tiếng khóc lóc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617603
    m_Localized: 'Doctor: Thường thì toàn nghe tiếng quát tháo của mấy tay say xỉn cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617602
    m_Localized: 'Doctor: Chẳng là bác thấy hiếm có nhà nào yên tĩnh như này vào buổi tối ấy mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617601
    m_Localized: 'Doctor: Hả? Không, không, làm gì có!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617600
    m_Localized: Bác đang tìm gì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423454
    m_Localized: Bác theo dõi nhà tôi đấy à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423453
    m_Localized: 'Doctor: Chào cháu! Có thể cho bác vào nhà được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423452
    m_Localized: 'Doctor: Buổi tối ở đây im ắng thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423451
    m_Localized: 'Doctor: Ấy chết, cứ tưởng không có ai ở nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423450
    m_Localized: 'Wolfhound: Mày niệu hồn đấy Diễm, tao sẽ còn xuất hiện nại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423449
    m_Localized: 'Wolfhound: Á ààà... Mày thích chơi vậy chứ giề?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423448
    m_Localized: 'Wolfhound: Giờ nà thời đại cá nớn nuốt cá bé, Diễm à. Theo dòng thì nổi, ngược dòng thì chìm chết cha nhà mày. '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423447
    m_Localized: 'Wolfhound: Ngoan nắm cún con.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423446
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423445
    m_Localized: Ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423444
    m_Localized: 'Wolfhound: Nói chung nà bố mày không tới đây để quậy, yên tâm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423443
    m_Localized: 'Wolfhound: Không biết không có tội, vô tri hưởng thái bình. Tao đây còn chưa hỏi mày sinh tồn kiểu gì nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423442
    m_Localized: 'Wolfhound: Gớm, thằng này cứng bây. Gan mày chắc phải gan hà bá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423441
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423440
    m_Localized: Ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423439
    m_Localized: 'Wolfhound: Còn mày á? Ở đây mày còn trật tự chán. Vậy nà hàng hiếm đó Diễm ơi. Tao cũng tò mò muốn xem sao mày giữ được hay thế.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423438
    m_Localized: 'Wolfhound: Đâu đâu cũng chung một cái cảnh. Nỗi sợ nàm người ta mù con mắt, chả nhìn thấu được đại cục.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423437
    m_Localized: 'Wolfhound: Tao đi thì nhiều nhưng ở chả bao nhiêu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423436
    m_Localized: Sao ông sống sót được đến tận bây giờ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423435
    m_Localized: Ông đi qua bao nhiêu căn nhà rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423434
    m_Localized: 'Wolfhound: Mà ai nói sai thì mai đi bán muối. Thời thế thế thời, cuộc chơi đã khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423433
    m_Localized: 'Wolfhound: Sống ở rừng thì phải theo nuật rừng. Mạnh được yếu thua, đố có sai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423432
    m_Localized: 'Wolfhound: Mày cứ chối đi, để chúng nó ăn tươi nuốt sống mày. Không chừa nại dù chỉ một khúc xương.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423431
    m_Localized: 'Wolfhound: Con người ai cũng nà thú mà cu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423430
    m_Localized: Sao ông sống sót được đến tận bây giờ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423429
    m_Localized: Ông đi qua bao nhiêu căn nhà rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423428
    m_Localized: 'Wolfhound: Giờ đơn giản nắm. Đứa nào ngu dại thì xé xác nó ra, nàm thịt no nê, đánh chén ê hề.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423427
    m_Localized: 'Wolfhound: Nuân thường đạo ný còn đâu nữa Diễm ơi. Tan con nhà bà hoang hết mịa rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423426
    m_Localized: 'Wolfhound: Mày qua nhà bà con nối xóm chưa? Bước chân ra đường ra phố chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423425
    m_Localized: Thế ông cũng là bọn "mãnh thú" đấy à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423424
    m_Localized: Ông nói gì tôi chả hiểu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423423
    m_Localized: 'Wolfhound: Cuối cùng... tao cũng được tự do tung vó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423422
    m_Localized: 'Wolfhound: Văn minh văn miếc vứt hết cho chó gặm. Mấy con mãnh thú được dịp sổ nồng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423421
    m_Localized: 'Wolfhound: Mày thấy không, xã hội bây giờ nó noạn như chạy giặc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423420
    m_Localized: 'Wolfhound: Ê cu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423419
    m_Localized: 'SuperFake: Còn cố chấp kháng cự làm chi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423418
    m_Localized: 'SuperFake: MỌI SỰ sắp kết thúc tới nơi rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423417
    m_Localized: 'SuperFake: Mi đang cố níu kéo điều gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423416
    m_Localized: 'SuperFake: Tại sao thế?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423415
    m_Localized: 'SuperFake: Lúc nào cũng quay đầu trốn chạy. Mi trốn bọn ta, trốn tránh cả sự thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423414
    m_Localized: 'SuperFake: Chính vì vậy nên ta mới đến đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423413
    m_Localized: 'SuperFake: Vậy là mi vẫn quá nhu nhược, chưa dám xuống tay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423412
    m_Localized: 'SuperFake: Ngonnnn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423411
    m_Localized: 'SuperFake: Mi có thấy sợ không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423410
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423409
    m_Localized: 'SuperFake: Vậy là mi đã sẵn sàng rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423408
    m_Localized: Tao đã loại bỏ vài kẻ lạc loài
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423407
    m_Localized: Tao đã loại bỏ tất cả những kẻ lạc loài
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423406
    m_Localized: Tao chỉ cho đúng người vào thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423405
    m_Localized: Nhà tao đang có nhiều kẻ... không phải người
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423404
    m_Localized: Tao không cho ai vào nhà cả
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423403
    m_Localized: Nhà tao đang có nhiều người lắm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423402
    m_Localized: 'SuperFake: Mi đã để tên nào trong số bọn ta vào nhà chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423401
    m_Localized: 'SuperFake: Thực ra ta tò mò chuyện khác hơn cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423400
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423399
    m_Localized: 'SuperFake: Liệu mi có còn cảm giác gì không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423398
    m_Localized: 'SuperFake: Mi... biến mất luôn à? Vĩnh viễn không tồn tại?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423397
    m_Localized: 'SuperFake: Giả sử mi chết đi. Rồi sao nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423396
    m_Localized: 'SuperFake: Có vẻ mi quan tâm tới điều gì chờ đợi sau cái chết hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423395
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423394
    m_Localized: 'SuperFake: Có hay tự vấn rằng sao mình vẫn còn trên cõi đời này không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423393
    m_Localized: 'SuperFake: Mi có sợ những thứ ngoài tầm hiểu biết không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423392
    m_Localized: Tao đã loại bỏ vài kẻ lạc loài
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423391
    m_Localized: Tao đã loại bỏ tất cả những kẻ lạc loài
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423390
    m_Localized: Tao chỉ cho đúng người vào thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423389
    m_Localized: Nhà tao đang có nhiều kẻ... không phải người
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423388
    m_Localized: Tao không cho ai vào nhà cả
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423387
    m_Localized: Nhà tao đang có nhiều người lắm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423386
    m_Localized: 'SuperFake: Mi ở có một mình à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423385
    m_Localized: 'SuperFake: Mi đã để tên nào trong số bọn ta vào nhà chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423384
    m_Localized: 'SuperFake: Nhưng trước mắt thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423383
    m_Localized: 'SuperFake: ...Kiểu gì mi cũng tan biến.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423382
    m_Localized: 'SuperFake: Không hôm nay thì ngày mai. Không ngày mai thì sau đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423381
    m_Localized: 'SuperFake: ...Ấy là mi chết chắc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423380
    m_Localized: 'SuperFake: Nhưng kết cục trước sau vẫn như một.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423379
    m_Localized: 'SuperFake: Để thay đổi điều gì chăng?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423378
    m_Localized: 'SuperFake: Họ cử ta tới đây là có lý do cả...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423377
    m_Localized: 'SuperFake: Có bao giờ mi nghĩ... mình là người may mắn được chọn không? Khà khà khà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423376
    m_Localized: 'SuperFake: Giờ này mi mới chịu hỏi câu đó à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423375
    m_Localized: Sao không phá cửa đột nhập luôn đi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423374
    m_Localized: Sao mày cứ tới nhà tao làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423373
    m_Localized: 'SuperFake: Đừng lo, bọn ta sẽ giúp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423372
    m_Localized: 'SuperFake: Buồn cười nhỉ, mi thật sự không cảm xúc à.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423371
    m_Localized: 'SuperFake: Ai biết được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423370
    m_Localized: Sao không phá cửa đột nhập luôn đi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423369
    m_Localized: Sao mày cứ tới nhà tao làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423368
    m_Localized: 'SuperFake: Lưỡi hái của y đã kề sát cổ mi rồi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423367
    m_Localized: 'SuperFake: Mi cảm nhận được chưa? Bước chân Tử Thần đang tiến đến ngày một gần...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423366
    m_Localized: 'SuperFake: Chỉ có thế.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423365
    m_Localized: 'SuperFake: Người ta bảo sao thì ta nói vậy thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423364
    m_Localized: Chấm hết? Cái gì chấm hết?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423363
    m_Localized: Mày nói vậy là ý gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423362
    m_Localized: 'SuperFake: Hoặc là dưới tay bọn ta, hoặc tự các người đặt dấu chấm hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423361
    m_Localized: 'SuperFake: Mọi chuyện sắp sửa đi đến hồi kết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423360
    m_Localized: 'SuperFake: Họ tiết lộ cho ta rằng đây sẽ là lần cuối chúng ta trò chuyện.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423359
    m_Localized: 'SuperFake: Hẹn ngày tái ngộ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423358
    m_Localized: 'SuperFake: Vậy thôi nhé...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423357
    m_Localized: 'SuperFake: Ta chỉ đơn thuần là nghe lệnh mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423356
    m_Localized: 'SuperFake: Còn bao thế lực khủng khiếp, đáng gờm hơn nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423355
    m_Localized: 'SuperFake: Đừng nghĩ ta đây là kẻ đầu đàn đấy nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423354
    m_Localized: 'SuperFake: Mi biết không, sự thay đổi không phải là thứ đáng sợ nhất đến tìm mi đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423353
    m_Localized: 'SuperFake: Bọn ta dạo này hiếm có khó tìm thật. Huống hồ chi là hạng người như mi, cứ ru rú trong nhà mãi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423352
    m_Localized: 'SuperFake: Chà chà...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423351
    m_Localized: 'SuperFake: Theo ta nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423350
    m_Localized: 'SuperFake: Tuyệt vờiiiii... Ván cược đã được đền đáp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423349
    m_Localized: 'SuperFake: Hừm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423348
    m_Localized: Không, nhiều mình
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423347
    m_Localized: Ừ, có mình tao thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423346
    m_Localized: 'SuperFake: Mi ở có một mình à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423345
    m_Localized: 'SuperFake: Nhưng trước khi ta đi, chúng ta thử cá cược đã.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423344
    m_Localized: 'SuperFake: Chậc, tiếc thế... Thôi thì tạm thời... ta rút lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423343
    m_Localized: Không, nhiều mình
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423342
    m_Localized: Ừ, có mình tao thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423341
    m_Localized: 'SuperFake: Mi ở có một mình à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423340
    m_Localized: 'SuperFake: Nhưng trước tiên...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423339
    m_Localized: 'SuperFake: Chơi thử là biết ngay ấy mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423338
    m_Localized: 'SuperFake: Đơn giản lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423337
    m_Localized: Để khi khác mày qua được không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423336
    m_Localized: Là sao tao không hiểu
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423335
    m_Localized: 'SuperFake: Thì mi buộc phải mở cửa đón ta vào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423334
    m_Localized: 'SuperFake: Nếu có ít nhất hai ĐỒNG LOẠI của ta trong nhà mi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423333
    m_Localized: 'SuperFake: Vậy thì phải bày trò hay mới được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423332
    m_Localized: 'SuperFake: Còn chẳng buồn quan tâm nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423331
    m_Localized: 'SuperFake: Lãnh đạm đến như vậy sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423330
    m_Localized: Để khi khác mày qua được không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423329
    m_Localized: Là sao tao không hiểu
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423328
    m_Localized: 'SuperFake: Vì lúc này lũ chó đã xâm chiếm cơ thể của chúng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423327
    m_Localized: 'SuperFake: Thì mi buộc phải mở cửa đón ta vào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423326
    m_Localized: 'SuperFake: Nếu có ít nhất hai ĐỒNG LOẠI của ta trong nhà mi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423325
    m_Localized: 'SuperFake: Hay chúng ta thử bày trò mới đi nhỉ? Cá cược một phen xem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423324
    m_Localized: 'SuperFake: Bệnh của mi nặng lắm rồi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423323
    m_Localized: 'SuperFake: Tội chưa kìa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423322
    m_Localized: Tao đếch quan tâm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423321
    m_Localized: Thấm nỗi gì. Tao chai sạn rồi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423320
    m_Localized: 'SuperFake: Xung quanh mi toàn chuyện lạ có thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423319
    m_Localized: 'SuperFake: Mi biết ta đang nói đến ai mà nhỉỉỉỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423318
    m_Localized: 'SuperFake: Tất cả chỉ vì một từ duy nhất. Một từ nhỏ nhoi nhưng quá đỗi nhiệm mầu...!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423317
    m_Localized: 'SuperFake: Chưa kể bây giờ một đứa đồng bọn của mi đã hóa bất tử.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423316
    m_Localized: 'SuperFake: ...Và ta cũng thế.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423315
    m_Localized: 'SuperFake: Sự thay đổi đang đeo bám, ám ảnh mi đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423314
    m_Localized: 'SuperFake: Đã thấmmmmm chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423313
    m_Localized: 'SuperFake: Lần tới hai ta gặp, ắt hẳn sẽ... thú vị lắm cho xem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423312
    m_Localized: 'SuperFake: Khiến mi không ngừng chao đảo, cuồng quay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423311
    m_Localized: 'SuperFake: Cuộc sống giờ đã đổi khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423310
    m_Localized: 'SuperFake: Hiểu ý ta mà đúng không? Hiện thực mới là như thế. Vĩnh viễn không thể quay về.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423309
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423308
    m_Localized: 'SuperFake: Đây là thời khắc lũ chó lên ngôi. Và chỉ có chó mới tồn tại đến cùng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423307
    m_Localized: 'SuperFake: Vì sao vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423306
    m_Localized: 'SuperFake: Vẫn cố chấp lăn lộn để sinh tồn trong thế giới này à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423305
    m_Localized: 'SuperFake: Thế để ta lẻn vào nhà một xíuuuu thôi nhé. Để dành tặng mi món quà tiễn biệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423304
    m_Localized: 'SuperFake: Không có duyên được với ai à? ...Tiếc quá cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423303
    m_Localized: 'SuperFake: Vậy là rốt cuộc mi vẫn đơn độc lẻ bóng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423302
    m_Localized: Không, nhiều mình
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423301
    m_Localized: Ừ, có mình tao thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423300
    m_Localized: 'SuperFake: Mi ở có một mình à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423299
    m_Localized: 'SuperFake: Vậy nói ngheeeeeeee...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423298
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423297
    m_Localized: 'SuperFake: Mi chỉ ngăn được một thứ duy nhất, đó là nhịp đập của sự sống mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423296
    m_Localized: 'SuperFake: Hay ngăn chặn lũ lụt, hỏa hoạn, thế giới mục rữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229051
    m_Localized: 'SuperFake: Đẩy lùi cái chết ư?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229050
    m_Localized: 'SuperFake: Mi thì làm nên trò trống gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229049
    m_Localized: Không, nhiều mình
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229048
    m_Localized: Ừ, có mình tao thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229047
    m_Localized: 'SuperFake: Mi ở có một mình à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229046
    m_Localized: 'SuperFake: Vậy nói ngheeeeeeee...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229045
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229044
    m_Localized: 'SuperFake: ...Trước Bàn Tay Tử Thần?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229043
    m_Localized: 'SuperFake: ...Trước Tận Thế Cận Kề?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229042
    m_Localized: 'SuperFake: Một cá thể lẻ loi thì làm được gì trước thảm họa cơ chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229041
    m_Localized: 'SuperFake: Ừ, ta biết mà!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229040
    m_Localized: Tao đang cố hết sức có thể
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229039
    m_Localized: Tao thì làm được gì
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229038
    m_Localized: 'SuperFake: Hay mi muốn tự mình gánh vác hết mọi chuyện?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229037
    m_Localized: 'SuperFake: May phước làm sao, mi nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229036
    m_Localized: 'SuperFake: Số phận đã an bài hết cả rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229035
    m_Localized: 'SuperFake: Nghĩ làm chi cho mệt xác?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229034
    m_Localized: Tao đang cố giúp rồi đây
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229033
    m_Localized: Tao thì làm được gì
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229032
    m_Localized: 'SuperFake: Hay chúng ta cứ tự tay mình "giải quyết"?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229031
    m_Localized: 'SuperFake: Biết đâu chúng sẽ khôi phục lại trật tự như xưa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229030
    m_Localized: 'SuperFake: Tai họa cứ nối đuôi nhau mà ập đến, nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229029
    m_Localized: 'SuperFake: Biết sao được, thời buổi nguy nan quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229028
    m_Localized: Tao cũng không biết nên nghĩ thế nào
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229027
    m_Localized: Anh ta đang làm đúng nhiệm vụ thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229026
    m_Localized: 'SuperFake: Mi nghĩ sao về tên mặc đồ bảo hộ đấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229025
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229024
    m_Localized: 'SuperFake: Vẫn cứ đóng cửa cài then ở suốt trong đó à...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229023
    m_Localized: 'Greatmother: Mi cứ chờ đó. Gấu Mạ Vĩ Đại sẽ đem đám nhỏ tới đây, để mi có bạn cùng đi xuống suối vàng... KHẶC KHẶC KHẶC!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229022
    m_Localized: 'Greatmother: HÀ HÀ HÀ HÀ HÀ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229021
    m_Localized: 'Greatmother: Cứ cửa đóng then cài, không cho ai vô là chắc ăn nhất.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229020
    m_Localized: 'Greatmother: Hừ... thôi được, tùy mi. Mà nhớ... đừng có để tụi áo vàng xông vô chỗ ni, biết chưa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229019
    m_Localized: 'Greatmother: Lớ ngớ là hắn lôi cổ mình tới chỗ khỉ ho cò gáy, không ai biết luôn đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229018
    m_Localized: 'Greatmother: Ông trời có mắt, công đức vô lượng. Phước ba đời nhà mi. Nhưng mà tau dặn nì: Đừng có bạ ai gõ cửa cũng cho vô nhà đó, nghe chưa? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229017
    m_Localized: Thôi bà đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229016
    m_Localized: Bà vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229015
    m_Localized: 'Greatmother: Mạ kiệt sức rồi con nạ. Chừ mạ chỉ muốn kiếm tạm chỗ sống qua ngày thôi con.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229014
    m_Localized: 'Greatmother: Nguyên đám ở trọ bị bắt đi, tội chi mà tội dữ dằn. Mà bọn hắn có thèm dí theo mấy đứa còn lại như tụi tau mô.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229013
    m_Localized: 'Greatmother: Có mấy người nhất quyết ở yên, mà tụi áo vàng cứ túm cổ lôi ra ngoài. Hắn bốc đại kiểu rứa đó, tiện tay là lôi đi chả thèm suy nghĩ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229012
    m_Localized: 'Greatmother: Mẹ nó, nguyên cấy chung cư bị giải tán tập thể!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229011
    m_Localized: Thôi bà đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229010
    m_Localized: Bà vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229009
    m_Localized: 'Greatmother: Đã rứa còn kêu đám còn lại cuốn gói. Mi thấy có quá đáng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229008
    m_Localized: 'Greatmother: Xong tụi áo vàng hắn xông vô, đuổi hết bà con ra ngoài. Tiện tay răng bắt mấy đứa đi luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229007
    m_Localized: 'Greatmother: Người ta kêu chỗ nhà tau bị tia mặt trời đốt phừng phừng răng đó. Toàn ba cấy tào lao xịt bộp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229006
    m_Localized: Chỗ bà có nhiều người bị thế không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229005
    m_Localized: Sao họ lại đuổi bà đi vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229004
    m_Localized: 'Greatmother: Thành ra hôm nớ tới chừ, tau cứ mất công chạy tới chạy lui miết. Để kiếm xó mô đàng hoàng mà nương thân.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229003
    m_Localized: 'Greatmother: Cô cha mi lên tụi áo vàng, đuổi nguyên cả xóm tau đi hết. Chừ bà con ai cũng ngơ ngơ ngác ngác, chả biết đi về mô luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229002
    m_Localized: 'Greatmother: Tìm ai mô mà tìm. Mạ chỉ muốn kiếm chỗ nghỉ chân thôi. Mệt lắm rồi á con.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229001
    m_Localized: Chỗ bà có nhiều người bị thế không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229000
    m_Localized: Sao họ lại đuổi bà đi vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228999
    m_Localized: 'Greatmother: Bà con hàng xóm bỏ chạy tán loạn hết trơn. Chừ còn mình tau thôi, tới chỗ ni tìm đường sống nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228998
    m_Localized: 'Greatmother: Mạ ơi, đã mất nhà mà còn chả ai chìa tay ra giúp. Chừ biết làm răng đây? Biết đi mô chừ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228997
    m_Localized: 'Greatmother: Mà chừ đám áo vàng hắn đuổi đi, còn bỏ tụi tau bò lăn bò lóc ngoài đường.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228996
    m_Localized: 'Greatmother: Hồi trước, mạ con tau từng ở cách nhà mi mấy căn đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228995
    m_Localized: Bà đang tìm ai à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228994
    m_Localized: Ai đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228993
    m_Localized: 'Greatmother: Có ai ở nhà không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228992
    m_Localized: 'Greatmother: Mấy đứa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034796
    m_Localized: 'Cold: Thôi thì cũng phải. Bắn tôi chỉ tổ ph-ph-phí đạn thôi. Chào cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034795
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034794
    m_Localized: 'Cold: Cậu b-bắn tôi được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034793
    m_Localized: 'Cold: Hình như t-tay cậu còn dính thuốc súng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034792
    m_Localized: 'Cold: Vậy thôi chào cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034791
    m_Localized: 'Cold: Tôi hiểu mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034790
    m_Localized: 'Cold: Trần nhà hình như h-hơi thấp. Nhưng thôi cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034789
    m_Localized: 'Cold: C-Cảm ơn cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034788
    m_Localized: 'Thôi anh đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034787
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034786
    m_Localized: 'Cold: Tôi sẽ đi ngay. Không van xin lạy lục gì. Kh-Kh-không làm phiền đến cậu nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034785
    m_Localized: 'Cold: Cậu không cần phải cho tôi vào đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034784
    m_Localized: 'Cold: Không.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034783
    m_Localized: 'Thôi anh đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034782
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034781
    m_Localized: 'Cold: C-Cởi ra lại càng tệ hơn nữa thì sao? Không ch-chết được thì khổ lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034780
    m_Localized: 'Cold: Tôi sợ lắm, không c-cởi áo được đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034779
    m_Localized: 'Cold: M-Mọi người ra đường là ch-cháy nắng hết. Còn tôi chui vào mấy lớp áo mà vẫn như ch-chết cóng đến nơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034778
    m_Localized: 'Cold: Người tôi lúc nào cũng l-lạnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034777
    m_Localized: Bỏ áo khoác ra xem nào
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034776
    m_Localized: Nóng vậy mà anh không thấy nực à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034775
    m_Localized: 'Cold: Đã từ... r-rất lâu rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034774
    m_Localized: 'Cold: Chưa bao giờ tôi được một phút b-bình yên.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034773
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034772
    m_Localized: Bỏ áo khoác ra xem nào
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034771
    m_Localized: Nóng vậy mà anh không thấy nực à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034770
    m_Localized: 'Cold: Lát nữa tôi sẽ nói sau. Tôi vẫn chưa biết có nên t-tin cậu hay không.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034769
    m_Localized: 'Cold: K-Không phải đâu. Nhưng tôi có chuyện này muốn nhờ cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034768
    m_Localized: 'Cold: Q-Quan trọng gì nữa. Cậu đang muốn biết tôi có phải Dị Khách hay không à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034767
    m_Localized: Anh đi tìm như này bao lâu rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034766
    m_Localized: Anh là ai thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034765
    m_Localized: 'Cold: Cho tôi hưởng chút b-b-bình yên ở nhà cậu được chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034764
    m_Localized: 'Cold: Cái nóng này không h-hề gì với tôi hết. Tôi đang tìm chỗ nào yên tĩnh để trú chân thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034763
    m_Localized: 'Cold: X-Xin chào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034762
    m_Localized: 'Hunter: Tao thề, không chừa đường sống cho bất cứ thằng sâu con mọt nào hết. Mày cứ coai chừng đấy cu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034761
    m_Localized: 'Hunter: ...Sáng ra thấy cổ mình bị rạch mấy nhát thì chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034760
    m_Localized: 'Hunter: Ờ, biết đâu thế lại tốt. Nhỡ mày cũng cùng một giuộc với bọn nóa thì sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034759
    m_Localized: 'Hunter: Bác với mày phải quét sạch bọn nóa, không cho đứa sâu bọa nào bén mảng đến khu này hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034758
    m_Localized: 'Hunter: Bác nhìn là biết mày cóa bản lĩnh giồi. Cũng ra gì phết đấy cu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034757
    m_Localized: Thôi bác đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034756
    m_Localized: Bác vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034755
    m_Localized: 'Hunter: Nhìn bề ngoài thì giống người thế thôi, chứ bọn này chả còn nhân tính nhân tiếc gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034754
    m_Localized: 'Hunter: May mà bác chuồn được, chứ chúng nóa xả súng lia lịa luôn. Sư cha lũ sâu bọa, được một phen khoái chí lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034753
    m_Localized: 'Hunter: Chúng nóa rình lúc bác ngủ rồi thóa xừ mất.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034752
    m_Localized: 'Hunter: Trước đây bác vẫn cầm theo một khẩu súng săn. Cũng vì nóa mà bác mém chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034751
    m_Localized: Thôi bác đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034750
    m_Localized: Bác vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034749
    m_Localized: 'Hunter: Đám sâu bọa này ranh ma lắm, nó không tha choa mình đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034748
    m_Localized: 'Hunter: Chừa cho nóa đường sống là hôm sau nóa quay lại phanh thây mình ngay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034747
    m_Localized: 'Hunter: Biết là mày chắc cũng chả ngây ngô gì, nhưng vào tay bác là không có chuyện thả choa chúng nóa đi đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034746
    m_Localized: 'Hunter: Thì mày cũng đang săn đấy thôi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034745
    m_Localized: Thế bác định diệt bằng gì? Vũ khí đâu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034744
    m_Localized: Bác muốn săn Dị Khách sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034743
    m_Localized: 'Hunter: Mày nghe chưa, không đùa với chúng nóa được đâu. Phải diệt càng sớm càng tốt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034742
    m_Localized: 'Hunter: Ông mặt giời giở chứng phát là lũ sâu mọt này như được thả xích, cứ thế trồi lên nhung nhúc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034741
    m_Localized: 'Hunter: Đây ấy hả? Ôi giồi ôi bác mày đau lưng moải gối giồi, cần chỗ nghỉ ngơi thôi con giai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034740
    m_Localized: Thế bác định diệt bằng gì? Vũ khí đâu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034739
    m_Localized: Bác muốn săn Dị Khách sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034738
    m_Localized: 'Hunter: Sư cha cái lũ sâu bọa mất dạy ấy. Phải diệt hết choa bằng sạch thì mới yên tâm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034737
    m_Localized: 'Hunter: Nóa giả vờ trà trộn giữa đám người chúng ta, giồi lẻn vào nhà lúc nào không hay. Thế là đi đời nhà ma cả lũ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034736
    m_Localized: 'Hunter: Bố tổ chúng nóa đi hết nhà này nhà nọa, đi đến đâu là xé xác giết sạch con người ta đến đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034735
    m_Localized: 'Hunter: Mày đã thấy bọn Dị Khách nóa hoành hành thế nào chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034734
    m_Localized: Bác muốn tìm gì ở đây vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034733
    m_Localized: Sao bác lại đi lang bạt khắp nơi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034732
    m_Localized: 'Hunter: Khổ nỗi bây giờ bác già cả giồi, sức đâu mà đi phiêu du tứ phương như hồi xưa nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034731
    m_Localized: 'Hunter: Bác chả phải dân ở đây nên cũng không rành. Tính bác đi đây đi đóa, cóa bao giờ ở yên một chỗ đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034730
    m_Localized: 'Hunter: Này cu. Bác hoải phát, dạo này ở chốn chóa ăn đá, gà ăn sỏi của mày có biến gì không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034729
    m_Localized: 'Prophet: Vĩnh biệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034728
    m_Localized: 'Prophet: ...Đến lúc tôi phải đi rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034727
    m_Localized: 'Prophet: Tôi không còn sức để đọc nốt nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034726
    m_Localized: 'Prophet: "Tiếng lũ trẻ thét gào tựa như lửa thiêu ngút trời nơi pháp trường Rouen..."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034725
    m_Localized: 'Prophet: Vĩnh biệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034724
    m_Localized: 'Prophet: Cảm ơn cậu. Nhưng nó chẳng có ích gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034723
    m_Localized: 'Prophet: Đáng tiếc thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034722
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034721
    m_Localized: 'Prophet: "Có kẻ cất lời giữa hai thế giới: hỡi ngọn lửa, hãy sóng bước cùng ta".'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034720
    m_Localized: 'Prophet: Tôi phải đi rồi. Tạm biệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034719
    m_Localized: 'Prophet: Thánh thần ơi... Tôi vừa nhớ ra gì đó. Cảm ơn cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034718
    m_Localized: 'Prophet: ...Tôi ngộ ra rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034717
    m_Localized: 'Prophet: "Đã từ rất lâu, ta đi trên chuyến tàu về miền vô định. Dưới những vòng bánh lăn, con đường vẫn ầm ầm cuốn tới".'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034716
    m_Localized: Trang thứ 10?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034715
    m_Localized: Giữa trang 200
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034714
    m_Localized: Đâu ở đoạn cuối ấy
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034713
    m_Localized: 'Prophet: Tôi sợ lắm. Biết đâu quẻ này lại giúp được phần nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034712
    m_Localized: 'Prophet: Còn nhớ lúc tôi nhờ cậu bói quẻ cho tôi qua cuốn sách này không? Cậu làm thêm lần nữa nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034711
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034710
    m_Localized: 'Prophet: Phải chăng đó là lời nhắn dành cho cậu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034709
    m_Localized: 'Prophet: Giờ tôi chỉ còn nhớ mỗi một từ... Nhảy. Tức là sao chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034708
    m_Localized: 'Prophet: Nhưng trước đây... tôi hiểu hết mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034707
    m_Localized: 'Prophet: Cậu hỏi gì lạ vậy. Tôi thật không sao hiểu nổi nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034706
    m_Localized: Trang thứ 10?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034705
    m_Localized: Giữa trang 200
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034704
    m_Localized: Đâu ở đoạn cuối ấy
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034703
    m_Localized: 'Prophet: Biết đâu lại giúp được gì đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034702
    m_Localized: 'Prophet: Bói tiếp cho tôi một quẻ nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034701
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034700
    m_Localized: 'Prophet: Tôi mất phương hướng thật rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034699
    m_Localized: 'Prophet: Chẳng hiểu đó là lời nhắn dành cho cậu... hay cho tôi nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034698
    m_Localized: 'Prophet: Trong đầu tôi lặp mãi một từ duy nhất: Nhảy. Nhảy. Nhảy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034697
    m_Localized: 'Prophet: Tôi... Tôi cũng không nhớ nổi nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034696
    m_Localized: Ông đang hấp hối đó hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034695
    m_Localized: Ông nói ai cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034694
    m_Localized: 'Prophet: Tại sao cơ chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034693
    m_Localized: 'Prophet: Vậy mà lúc này đây... bà nỡ tước đi tất cả sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034692
    m_Localized: 'Prophet: Trước giờ... chính bà ấy đã giúp tôi bước tiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034691
    m_Localized: Ông đang hấp hối đó hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034690
    m_Localized: Ông nói ai cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034689
    m_Localized: 'Prophet: Thánh thần ơi, tôi phải... Cứ mặc tôi đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034688
    m_Localized: 'Prophet: Tôi hiểu chuyện gì đang xảy ra rồi... Một điều lẽ ra phải đến từ lâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840573
    m_Localized: 'Prophet: Những điềm báo... đã biến mất.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840572
    m_Localized: 'Prophet: Quá muộn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840571
    m_Localized: Nhìn ông... thảm quá vậy
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840570
    m_Localized: Đừng có chết trước hiên nhà tôi nhé
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840569
    m_Localized: 'Prophet: Chẳng lẽ bà ấy đã bỏ rơi tôi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840568
    m_Localized: 'Prophet: Nhãn lực của tôi đang mờ dần. Tôi không còn nhìn thấy được gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840567
    m_Localized: 'Prophet: Khuôn mặt của cậu đã xóa nhòa khỏi tâm trí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840566
    m_Localized: 'Prophet: Cho tôi ở yên một mình, để mà nghiền ngẫm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840565
    m_Localized: 'Prophet: Nhớ lời tôi... Bây giờ mà nhảy thì không có ích gì đâu. Vẫn chưa đến lúc...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840564
    m_Localized: 'Prophet: Còn cậu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840563
    m_Localized: 'Prophet: Đúng hơn là phải làm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840562
    m_Localized: 'Prophet: Tôi... Tôi chỉ nhớ rằng... đó là việc nên làm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840561
    m_Localized: 'Prophet: Tôi phải nghỉ ngơi thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840560
    m_Localized: 'Prophet: Đừng nhảy. Chưa đến lúc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840559
    m_Localized: 'Prophet: Trong... lòng đất... tôi còn thấy một thứ nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840558
    m_Localized: 'Prophet: Thánh thần ơi... Tôi không sao thông suốt được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840557
    m_Localized: Ông chắc chứ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840556
    m_Localized: Tôi có cần tới nó không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840555
    m_Localized: 'Prophet: Ý thần đã định: cậu phải tìm ra nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840554
    m_Localized: 'Prophet: Có thứ gì được chôn ở đó. Ẩn sâu dưới lớp đất...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840553
    m_Localized: 'Prophet: Tôi… Tôi nhìn thấy khung cảnh tiếp theo rồi. Một tầng hầm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840552
    m_Localized: 'Prophet: Nhưng lúc này… tầm nhìn của tôi lại mờ đi. Tôi chỉ thấy cậu lạc lối giữa rừng tối, tứ bề là lũ ác thú rình chờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840551
    m_Localized: 'Prophet: Chúng ta gặp nhau là có duyên cớ cả. Tôi vẫn nhớ rất rõ mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840550
    m_Localized: 'Prophet: ...Tôi biết lời mình thốt ra rất chi là quái lạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840549
    m_Localized: Ông chắc chứ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840548
    m_Localized: Tôi có cần tới nó không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840547
    m_Localized: 'Prophet: Tôi cũng không thấy rõ đó là gì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840546
    m_Localized: 'Prophet: Dưới căn hầm, vùi trong lớp đất, có thứ gì đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840545
    m_Localized: 'Prophet: Nhà cậu có tầng hầm không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840544
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840543
    m_Localized: 'Prophet: Trước khi tôi đến gặp cậu, mọi sự vô cùng rõ ràng. Thế mà giờ đây... lại mịt mù như sương khói.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840542
    m_Localized: 'Prophet: Ôi trời... Tôi nào có ý làm cậu sợ. Tôi chỉ đang nói những gì thoáng qua trong đầu thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840541
    m_Localized: Tôi bắt đầu thấy hối hận vì tin lời ông rồi đấy
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840540
    m_Localized: Tôi chẳng hiểu nổi ông đang nói cái gì hết
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840539
    m_Localized: 'Prophet: Nhưng giờ... có gì đấy sai sai. Lẽ nào... do cụ nấm đó...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840538
    m_Localized: 'Prophet: Nếu cậu cầu xin, ắt là nó sẽ giúp cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840537
    m_Localized: 'Prophet: Nhưng không việc gì phải khiếp sợ nó. Chúng ta chỉ không nhận thức được về nó thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840536
    m_Localized: 'Prophet: Cậu biết không, ngoài kia tồn tại một thế lực quyền năng hơn tất thảy chúng ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840535
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840534
    m_Localized: 'Prophet: Không. Không hề.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840533
    m_Localized: Tôi bắt đầu thấy hối hận vì tin lời ông rồi đấy
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840532
    m_Localized: Tôi chẳng hiểu nổi ông đang nói cái gì hết
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840531
    m_Localized: 'Prophet: Những mầm non mới nhú rồi sẽ xuyên qua lớp tro tàn và vươn tới trời cao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840530
    m_Localized: 'Prophet: Lúc đầu tôi cũng từng bị như này rồi. Không sao đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840529
    m_Localized: 'Prophet: Không phải do cậu. Hay do bà ấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840528
    m_Localized: 'Prophet: Tôi thấy mình đang yếu dần. Đôi mắt của tôi không còn nhìn xa được như trước nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840527
    m_Localized: 'Prophet: Tôi được trợ giúp đủ rồi. Chỉ là bây giờ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840526
    m_Localized: Ông đang độc thoại đó à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840525
    m_Localized: Ông cần tôi giúp gì không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840524
    m_Localized: 'Prophet: Chẳng lẽ là do thảm cảnh này sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840523
    m_Localized: 'Prophet: Linh cảm của tôi tệ hơn rồi. Lạ thật...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840522
    m_Localized: 'Prophet: Cậu có ở đó không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840521
    m_Localized: 'Prophet: Mong gặp lại cậu vào một ngày không xa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840520
    m_Localized: 'Prophet: Giờ cảm giác đó đã giảm đi phần nào. Vậy là chúng ta đang theo đúng hướng đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840519
    m_Localized: 'Prophet: Ngay từ lần đầu đến đây, tôi đã cảm thấy có gì đó rất... lạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840518
    m_Localized: 'Prophet: Trong hai ngày tới... nghi ngờ ắt dẫn đến diệt vong.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840517
    m_Localized: 'Prophet: Cậu xem đây là lời khuyên cũng được. Nghe rõ nhé...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840516
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840515
    m_Localized: 'Prophet: Không thể tiết lộ thêm nữa. Tôi đã nói quá nhiều rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840514
    m_Localized: 'Prophet: Mong gặp lại cậu vào một ngày không xa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840513
    m_Localized: 'Prophet: Có thể điều này sẽ giúp tâm cậu bình an. Hoặc ít nhất cũng tiếp thêm sức mạnh để vượt qua.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840512
    m_Localized: 'Prophet: Nếu cậu làm được thì tôi sẽ tiếp tục dẫn lối.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840511
    m_Localized: 'Prophet: Hãy dừng mọi sự soi xét cho đến bình minh thứ ba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840510
    m_Localized: 'Prophet: Nhưng... trong hai ngày tới... nghi ngờ ắt dẫn đến diệt vong.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840509
    m_Localized: 'Prophet: Không cần tính. Tôi đã trót nói hơi nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840508
    m_Localized: Sắp có chuyện gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840507
    m_Localized: Ông nói tôi nghe làm gì? Giờ tôi biết tính sao đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840506
    m_Localized: 'Prophet: Có thể trên radio sẽ nhắc đến đấy. Cậu có nghe chăng?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840505
    m_Localized: 'Prophet: Cậu không cách nào ngăn được nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840504
    m_Localized: 'Prophet: Nhưng có một điều rõ mười mươi. Một thế lực tà ác đang đến gần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840503
    m_Localized: 'Prophet: Nhờ bà ấy mà đôi mắt tôi mới nhìn được xa hơn. Nhưng ngay cả tôi cũng không thấy hết mọi điều.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840502
    m_Localized: 'Prophet: Một thực thể quyền năng đang ngóng chờ con mèo bước đến.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840501
    m_Localized: Sắp có chuyện gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840500
    m_Localized: Ông nói tôi nghe làm gì? Giờ tôi biết tính sao đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840499
    m_Localized: 'Prophet: Có thể trên radio sẽ nhắc đến đấy. Cậu có nghe chăng?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840498
    m_Localized: 'Prophet: Chẳng phải do cậu mà ra, nhưng cậu vẫn sẽ cảm nhận nó trên từng sớ thịt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840497
    m_Localized: 'Prophet: Một thứ khủng khiếp sắp sửa ập đến nhà cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840496
    m_Localized: 'Prophet: Dù không thể thấu tỏ mọi điều... nhưng với cậu thì khác. Trên con đường cậu đang đi, tôi biết rõ điều gì chờ đợi ở phía trước.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840495
    m_Localized: 'Prophet: Tôi có thể thấy trước tương lai. Đó là ân phúc thần ban.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840494
    m_Localized: Lý do gì mà ông khuyên tôi nên cho người mang mèo vào nhà?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840493
    m_Localized: Sao ông biết chuyện con mèo hay vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840492
    m_Localized: 'Prophet: Còn người đưa nó đến thì... tùy cậu quyết định nên làm gì với họ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840491
    m_Localized: 'Prophet: Hay lắm. Con mèo đang ở cùng cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840490
    m_Localized: 'Gasmask: Xong rồi chúng tôi sẽ đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840489
    m_Localized: 'Gasmask: Giao hai người ra đây. NHANH.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840488
    m_Localized: 'Gasmask: Rồi để mặc anh chết rục ở đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840487
    m_Localized: 'Gasmask: Bắt hết từng người một.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840486
    m_Localized: 'Gasmask: Chúng tôi sẽ phá cửa xông vào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840485
    m_Localized: 'Gasmask: Nói mãi mà như nước đổ đầu vịt... Không chịu hợp tác thì đừng trách hậu quả.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840484
    m_Localized: 'Gasmask: Xong rồi. Chúc ngủ ngon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840483
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840482
    m_Localized: 'Gasmask: Tôi cũng thấy vậy đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840481
    m_Localized: Kệ mẹ mấy người, tôi không cống nạp thêm ai nữa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840480
    m_Localized: Tốt. Tôi cũng đéo muốn gặp anh lần nào nữa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840479
    m_Localized: 'Gasmask: Liệu hồn đấy, không chúng tôi sẽ xử cả anh luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840478
    m_Localized: 'Gasmask: Anh không phải người đầu tiên chống đối đâu. Chúng tôi đã xử lý mấy kẻ như anh rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840477
    m_Localized: 'Gasmask: Hoặc là bọn tôi đạp nát cửa nhà anh và vét sạch cái ổ chuột này, hoặc là anh tự nguyện giao hai người nữa ra đây ngay lập tức.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840476
    m_Localized: 'Gasmask: Không lòng vòng đôi co nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840475
    m_Localized: 'Gasmask: Tôi hết kiên nhẫn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840474
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840473
    m_Localized: Kệ mẹ mấy người, tôi không cống nạp thêm ai nữa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840472
    m_Localized: Tốt. Tôi cũng đéo muốn gặp anh lần nào nữa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840471
    m_Localized: 'Gasmask: Sau đó thì một là chúng tôi tìm cách diệt sạch bọn Dị Khách, hai là chúng ta đường ai nấy đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840470
    m_Localized: 'Gasmask: Chúng tôi không bắt tất cả mọi người trong nhà đi đâu. Chỉ hai thôi là đủ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840469
    m_Localized: 'Gasmask: Cần hai người nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840468
    m_Localized: Mấy người đéo làm gì ra hồn thì lập ra cái cơ quan bỏ mẹ này làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840467
    m_Localized: Thế phải làm sao thì mới giải quyết được đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840466
    m_Localized: 'Gasmask: Bây giờ mà không tự tìm cách sống sót là chính phủ quyết hộ luôn đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840465
    m_Localized: 'Gasmask: Mấy thằng già đó suốt ngày chỉ biết đưa ra mệnh lệnh vãi cả vô lý.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840464
    m_Localized: 'Gasmask: Bọn chính quyền không kiểm soát nổi tình trạng bùng phát nữa. Chúng nó định cho nổ tung cả thành phố kia kìa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840463
    m_Localized: 'Gasmask: Thảm họa vãi lồn luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840462
    m_Localized: Mấy người đéo làm gì ra hồn thì lập ra cái cơ quan bỏ mẹ này làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840461
    m_Localized: Thế phải làm sao thì mới giải quyết được đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840460
    m_Localized: 'Gasmask: Anh mà cứ giở trò như này là chúng tôi bắt hết người trong nhà đi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840459
    m_Localized: 'Gasmask: THẾ GIỚI SẮP TÀN MẸ NÓ RỒI.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840458
    m_Localized: 'Gasmask: THÔI IM MẸ MỒM ĐI.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840457
    m_Localized: Thảm họa nào cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840456
    m_Localized: Mấy. Người. Kia. Đâu. Hết. Rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840455
    m_Localized: 'Gasmask: Chỉ còn cách này mới có thể ngăn chặn được thảm họa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840454
    m_Localized: 'Gasmask: Chúng tôi cần thêm người nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840453
    m_Localized: 'Gasmask: Chúng tôi sẽ sớm trả họ về thôi. Cảm ơn anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840452
    m_Localized: 'Gasmask: Làm. Ơn. Giao. Người. Ra. Đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840451
    m_Localized: 'Gasmask: Chúng tôi rất muốn bảo vệ thành phố này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840450
    m_Localized: 'Gasmask: Càng chống đối thì thảm kịch càng tiếp diễn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840449
    m_Localized: 'Gasmask: Các anh cứng đầu cứng cổ cho cố vào. Cái kết đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840448
    m_Localized: 'Gasmask: Thấy cảnh tượng sau lưng tôi không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840447
    m_Localized: 'Gasmask: Thôi được rồi, anh thích làm gì thì làm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840446
    m_Localized: 'Gasmask: ...Cái con mẹ nó nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840445
    m_Localized: 'Gasmask: Bọn Dị Khách cứ để chúng tôi lo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840444
    m_Localized: 'Gasmask: Chúng tôi cam đoan sẽ trả họ về sớm thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840443
    m_Localized: 'Gasmask: Cảm ơn anh đã hợp tác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840442
    m_Localized: 'Gasmask: Đừng quên: giúp chúng tôi cũng là giúp chính anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840441
    m_Localized: Không. Dẹp. Miễn
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840440
    m_Localized: Thôi thì đành...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840439
    m_Localized: 'Gasmask: Mọi chuyện sẽ sớm trở lại bình thường thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840438
    m_Localized: 'Gasmask: Ai cũng được. Miễn anh giao nộp hai người ra đây. Ngay bây giờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840437
    m_Localized: 'Gasmask: Nhưng lần này sẽ cần đến hai người.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840436
    m_Localized: 'Gasmask: Đúng vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840435
    m_Localized: Không. Dẹp. Miễn
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840434
    m_Localized: Thôi thì đành...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840433
    m_Localized: 'Gasmask: Làm vậy sẽ đẩy nhanh tiến trình. Tất cả đều vì lợi ích chung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840432
    m_Localized: 'Gasmask: Cụ thể là hai người.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840431
    m_Localized: 'Gasmask: Chúng tôi cần thêm người.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840430
    m_Localized: Thế là tôi lại phải cúng thêm người cho bên đó hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840429
    m_Localized: Rồi giờ sao nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840428
    m_Localized: 'Gasmask: Tất cả vẫn đang trong tầm kiểm soát.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840427
    m_Localized: 'Gasmask: Việc ai nấy làm. Cứ để chúng tôi xử lý.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840426
    m_Localized: 'Gasmask: Nếu mọi chuyện đơn giản thế thì cần gì đến lực lượng Phòng Chống Thảm Họa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840425
    m_Localized: Thế là tôi lại phải cúng thêm người cho bên đó hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840424
    m_Localized: Rồi giờ sao nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840423
    m_Localized: 'Gasmask: Cho nên, việc hợp tác với chúng tôi chỉ có lợi chứ không có hại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840422
    m_Localized: 'Gasmask: Không nói trước được khi nào cuộc sống mới trở lại bình thường. Chúng tôi phải thực hiện kiểm tra thường xuyên hơn để giữ tình hình ổn định.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840421
    m_Localized: 'Gasmask: Chúng tôi vẫn đang tìm hiểu nguyên nhân sự việc. Yêu cầu anh hợp tác và đừng cản trở.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840420
    m_Localized: Thế khi nào các người mới tiêu diệt lũ Dị Khách hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840419
    m_Localized: Rồi mấy chuyện này còn kéo dài đến bao giờ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840418
    m_Localized: 'Gasmask: Ngay tại nơi... từng là quê nhà của tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840417
    m_Localized: 'Gasmask: Nhìn hậu quả mà xem. Chúng tôi vừa phải thanh trừng cả một ổ Dị Khách kìa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840416
    m_Localized: 'Gasmask: Người dân các anh có làm được gì đâu, chỉ toàn cản trở chúng tôi thi hành công vụ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840415
    m_Localized: 'Gasmask: Anh không có quyền gì mà ra lệnh cho chúng tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840414
    m_Localized: Thế khi nào các người mới tiêu diệt lũ Dị Khách hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840413
    m_Localized: Rồi mấy chuyện này còn kéo dài đến bao giờ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840412
    m_Localized: 'Gasmask: Rồi lại càng dẫn đến bạo lực mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840411
    m_Localized: 'Gasmask: Hành vi che giấu lũ Dị Khách chỉ tổ giúp chúng sinh sôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840410
    m_Localized: 'Gasmask: Người dân càng cứng đầu chống cự thì lại càng thêm nhiều ổ dịch bùng phát cần xử lý.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840409
    m_Localized: 'Gasmask: Hậu quả đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840408
    m_Localized: Đưa mấy người kia về cho tôi!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840407
    m_Localized: Trong thành phố đang có chuyện gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840406
    m_Localized: 'Gasmask: Anh vui lòng đưa người càng sớm càng tốt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840405
    m_Localized: 'Gasmask: Chúng tôi cần thêm mẫu thí nghiệm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840404
    m_Localized: 'Gasmask: Chào anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840403
    m_Localized: 'Gasmask: Dù muốn hay không cũng phải thực hiện. Anh càng sẵn sàng hợp tác thì chuyện càng xong sớm hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840402
    m_Localized: 'Gasmask: Đây là việc bắt buộc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840401
    m_Localized: 'Gasmask: Anh đừng hiểu nhầm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840400
    m_Localized: 'Gasmask: Sau khi hoàn thành xét nghiệm, chúng tôi sẽ thông báo các bước tiếp theo sau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840399
    m_Localized: 'Gasmask: Đừng lo lắng quá. Quá trình kiểm tra xét nghiệm tuy khá mệt mỏi, nhưng chúng tôi luôn cho họ nghỉ ngơi để hồi phục.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840398
    m_Localized: Tôi chẳng thích ba cái trò kiểm tra này
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840397
    m_Localized: Đành vậy. Cũng hết cách rồi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840396
    m_Localized: 'Gasmask: Để nghiên cứu kỹ lưỡng hơn về tác động của mặt trời, chúng tôi cần đưa một người đi nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840395
    m_Localized: 'Gasmask: Kết quả không được rõ ràng. Chúng tôi chưa thể rút ra kết luận.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840394
    m_Localized: Tôi chẳng thích ba cái trò kiểm tra này
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840393
    m_Localized: Đành vậy. Cũng hết cách rồi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840392
    m_Localized: 'Gasmask: Sau đó, họ sẽ được chuyển về từ khu cách ly.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840391
    m_Localized: 'Gasmask: Sau khi sàng lọc xong thì sẽ tiến hành cách ly bắt buộc. Họ phải ở lại chỗ chúng tôi một thời gian.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840390
    m_Localized: 'Gasmask: À. Hóa ra đã có một đội đến đây rồi à.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840389
    m_Localized: 'Gasmask: Về là sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840388
    m_Localized: Lần trước kiểm tra chưa xong à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840387
    m_Localized: Khi nào mấy người bị bắt đi mới được trả về?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840386
    m_Localized: 'Gasmask: Đừng lo. Sẽ xong nhanh thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840385
    m_Localized: 'Gasmask: Tôi đến từ Cơ quan Phòng, chống thảm họa Liên bang. Chúng tôi đang thực hiện công tác kiểm tra định kỳ ở khu phố này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840384
    m_Localized: 'Gasmask: Chào anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646208
    m_Localized: 'Luka: Cậu ở lại mạnh giỏi. Nhớ giữ gìn sức khỏe nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646207
    m_Localized: 'Luka: Rồi... cuộc đời cậu sẽ sớm rơi vào ngõ cụt, không còn lối thoát.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646206
    m_Localized: 'Luka: Cứ như vậy thì nỗi tuyệt vọng sẽ nuốt chửng cậu mất.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646205
    m_Localized: 'Luka: Xin đừng mãi đắm chìm trong đau khổ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646204
    m_Localized: 'Luka: Biết đâu khi đó... cái chết sẽ chẳng còn là điều duy nhất ám ảnh tâm trí cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646203
    m_Localized: 'Luka: Tớ chỉ mong sao cậu vẫn còn nhớ thế nào là niềm vui, là hạnh phúc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646202
    m_Localized: 'Thôi anh đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646201
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646200
    m_Localized: 'Luka: Cậu hiểu ý tớ không? Cuộc đời đã trở nên quá nghiệt ngã và cay đắng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646199
    m_Localized: 'Luka: Khi con người ta không chỉ sống cho qua ngày, mà còn để tạo ra... một thứ gì thật đẹp đẽ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646198
    m_Localized: 'Luka: Nhưng đôi lúc, mình phải gợi cho họ nhớ về những tháng ngày tươi đẹp, khi họ còn cảm nhận niềm hạnh phúc...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646197
    m_Localized: 'Luka: Kìa, sao cậu lại nói thế? Bây giờ ai ai cũng ôm trong mình những nỗi khổ riêng, tớ hiểu chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646196
    m_Localized: 'Thôi anh đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646195
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646194
    m_Localized: 'Luka: Đừng nản lòng mà chìm đắm trong tuyệt vọng. Lúc này ta cần nhất là hy vọng đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646193
    m_Localized: 'Luka: Hãy thử nhớ lại những điều khơi dậy niềm vui trong cậu nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646192
    m_Localized: 'Luka: Cậu thích làm gì vào thời gian rảnh thế nhỉ? Trước khi thảm họa ập đến ấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646191
    m_Localized: 'Luka: Thiếu gì cái để vui hả cậu ơi. Nhưng chỉ có cậu mới biết được điều gì mang lại hạnh phúc cho mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646190
    m_Localized: Thế anh định lừa dối người ta à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646189
    m_Localized: Giờ mà vui nổi cái gì nữa chứ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646188
    m_Localized: 'Luka: Còn tuyệt vọng lại khiến ta đâm mù quáng, chẳng nhận ra những điều tươi đẹp còn sót lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646187
    m_Localized: 'Luka: Nỗi sợ làm chúng ta trót quên đi niềm vui sống.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646186
    m_Localized: 'Luka: Chà... Đúng là lâu rồi không thấy ai cười thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646185
    m_Localized: 'Luka: À, ý là cậu muốn biết vì sao tớ cười hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646184
    m_Localized: 'Luka: Mặt tớ có dính gì sao? Trông vẫn ổn mà ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646183
    m_Localized: Thế anh định lừa dối người ta à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646182
    m_Localized: Giờ mà vui nổi cái gì nữa chứ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646181
    m_Localized: 'Luka: Cứ lạc quan lên đi cậu, tự nhủ với lòng mình rằng chuyện đâu còn có đó thôi, biết đâu chừng đời sẽ tươi sáng hơn thì sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646180
    m_Localized: 'Luka: Như là thế hệ mai sau nè, cái đẹp nghệ thuật nè... Bản thân cuộc đời đã đủ đáng sống rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646179
    m_Localized: 'Luka: Thời buổi nguy nan thật đó, nhưng vẫn còn nhiều thứ đáng để mình trân trọng và bảo bọc mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646178
    m_Localized: 'Luka: Ôi cậu à, thế giới còn chưa đủ hờn giận căm phẫn hay sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646177
    m_Localized: Mặt anh bị gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646176
    m_Localized: Sao trông anh yêu đời thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646175
    m_Localized: 'Luka: Cho tớ ở nhờ đêm nay nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646174
    m_Localized: 'Luka: Bạn ơi! Bạn gì đó đằng sau cánh cửa ơi! Bạn có trong nhà đúng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646173
    m_Localized: 'BigLebowski: Đờ mờ nhà ông.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646172
    m_Localized: 'BigLebowski: Chắc ông chú đây cũng cùng một giuộc với bọn biến thái chứ gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646171
    m_Localized: 'BigLebowski: Sao cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646170
    m_Localized: 'BigLebowski: Nhưng mà... thôi kệ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646169
    m_Localized: 'BigLebowski: Nhà ông chú có thảm luôn hả? Xịn đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646168
    m_Localized: 'BigLebowski: Uầy! Hơi kinhhhh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646167
    m_Localized: Thôi cháu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646166
    m_Localized: Cháu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633025
    m_Localized: 'BigLebowski: Ông chú định bỏ mặc trẻ con ngoài đường à? Ngoài trời thì nắng cháy da cháy thịt thế kia. Dị Khách còn nhan nhản nữa chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633024
    m_Localized: 'BigLebowski: Thôi, tôi cất công đến tận đây rồi. Chú cho tôi vào ở nhờ tránh nắng đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646165
    m_Localized: 'BigLebowski: Bà bô tôi còn thích tắm nắng nữa chứ. Đấy, tha hồ vui phải biết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646164
    m_Localized: 'BigLebowski: Có khi giờ hai ông bà cũng thành Dị Khách luôn rồi. Thế lại chả hợp quá. Hờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646163
    m_Localized: 'BigLebowski: Chịu, biết đâu? Chắc đang ở nhà chứ ở gì. Còn chỗ nào được nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646162
    m_Localized: Thôi cháu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646161
    m_Localized: Cháu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646160
    m_Localized: 'BigLebowski: Ông chú mà định động tay động chân là tôi đấm cho vỡ a lô đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646159
    m_Localized: 'BigLebowski: Mà lâu lâu lại gặp trúng mấy thằng hãm mới ghê chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646158
    m_Localized: 'BigLebowski: Mỗi tội hết tiền rồi. Nên một là đi xin xỏ ở ké, hai là chui vào cái tầng hầm nào đó trốn. Thôi thì đời mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646157
    m_Localized: 'BigLebowski: Thì tôi... đang đi lang thang đó đây thôi. Muốn xem thế giới xung quanh thế nào. Ngó nghiêng các thứ. Biết đâu tìm được nhà mới.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646156
    m_Localized: Thế bố mẹ cháu đâu rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646155
    m_Localized: Cháu trốn dưới hầm làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646152
    m_Localized: 'BigLebowski: Tại tôi không tìm được cái hầm hay chỗ tử tế nào để trốn, nên mới phải mò ra đây á.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646151
    m_Localized: 'BigLebowski: Thếếếế... tóm lại là có cho tôi vào không? Hay là định để tôi ở ngoài?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646150
    m_Localized: Thế bố mẹ cháu đâu rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646149
    m_Localized: Cháu trốn dưới hầm làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646146
    m_Localized: 'BigLebowski: Tôi chịu, không trốn nổi dưới tầng hầm nữa đâu. Cứ như này khéo quên luôn cả cách giao tiếp mất. Mà chú cũng có quan tâm đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646145
    m_Localized: 'BigLebowski: Không, tôi... muốn tìm chỗ nghỉ chân thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646144
    m_Localized: Ừ, nhà của chú đấy
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646143
    m_Localized: Cháu tìm ai à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646142
    m_Localized: 'BigLebowski: Đây là nhà ông hay sao? Ấy, ý là... có phải nhà của chú không ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646141
    m_Localized: 'BigLebowski: Ê. Ý quên... Chào ông chú. Chào hỏi thế được chưa nhỉ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646140
    m_Localized: 'Couple: Nào, nhanh nhanh cái chân lên. Mệt rồi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646139
    m_Localized: 'Couple: Đành đi tìm nhà khác thôi cưng nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646138
    m_Localized: 'Couple: Thế à, vậy thôi. Xin lỗi đã làm phiền chú nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646137
    m_Localized: 'Couple: Xin lỗi chú nha, chắc cô ấy đang ngại. Mình vào thôi em yêu, nghỉ ngơi một tí là em sẽ khỏe lại ngay ấy mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646136
    m_Localized: 'Couple: Nào, em còn đứng đấy làm gì nữa? Anh thanh niên tốt bụng này cho mình trú nhờ rồi nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646135
    m_Localized: 'Couple: Ôi, cảm ơn chú nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646134
    m_Localized: Thôi hai người đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646133
    m_Localized: Anh chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646132
    m_Localized: 'Couple: Chết, xin lỗi chú, tôi tọc mạch quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646131
    m_Localized: 'Couple: Tôi biết ơn vợ tôi lắm, nhờ cô ấy mà tôi mới vượt qua được bao sóng gió. Thế còn chú? Động lực nào giúp chú sống tiếp đến bây giờ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646130
    m_Localized: 'Couple: Tai họa cứ thế mà chồng chất lên nhau... Khổ lắm chứ chú.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646129
    m_Localized: 'Couple: Ơ, thời buổi này ai chả mệt? Hết gặp Dị Khách lại gặp nắng nóng, chưa kể còn bị đuổi việc...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646128
    m_Localized: Thôi hai người đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646127
    m_Localized: Anh chị vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646126
    m_Localized: 'Couple: Ấy, anh xin lỗi. Thôi, em mà không muốn thì cũng không cần đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646125
    m_Localized: 'Couple: Nhỉ vợ cưng?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646124
    m_Localized: 'Couple: Để hôm khác tụ tập tám chuyện cũng được mà. Nếu mình có duyên gặp lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646123
    m_Localized: 'Couple: Thông cảm nhé, bà nhà tôi đang mệt lắm rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646122
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646121
    m_Localized: 'Couple: Bị gì đâu! Em, nói mấy câu cho người ta yên tâm kìa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646120
    m_Localized: Hai anh chị làm gì mà mỏi mệt thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646119
    m_Localized: Bà xã anh bị gì mà không lên tiếng được?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646118
    m_Localized: 'Couple: Tất nhiên là nếu chú không phiền.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646117
    m_Localized: 'Couple: Nhưng mà bà nhà tôi mệt lắm rồi, muốn xin vài phút nghỉ chân thôi. Cho bọn tôi trú nhờ một lát có được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646116
    m_Localized: 'Couple: Không thì... vợ chồng tôi đi tìm chỗ khác tá túc cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646114
    m_Localized: Bà xã anh bị gì mà không lên tiếng được?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646113
    m_Localized: 'Couple: Nhà thì to, hàng xóm có vẻ cũng không lắm lời nhiều chuyện... Nên chắc cũng ít bị bọn ất ơ dòm ngó nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646112
    m_Localized: 'Couple: Hà hà, cũng chẳng biết phải giải thích với chú thế nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646111
    m_Localized: 'Couple: Bọn tôi đi qua mấy nhà rồi, thấy mỗi nhà chú là trông an toàn nhất thôi, nhỉ em yêu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646110
    m_Localized: Lỡ anh chị gây phiền cho tôi thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646109
    m_Localized: Trông nhà tôi thì an toàn lắm à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646108
    m_Localized: 'Couple: Nên là nếu không phiền thì chú cho vợ chồng tôi ở tạm ít hôm nhé? Được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646107
    m_Localized: 'Couple: A, chào chú! Chuyện là vợ chồng tôi đang tìm chỗ trú an toàn để tránh bão!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646106
    m_Localized: 'Couple: ...Đấy, thế có phải tốt hơn không.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646105
    m_Localized: 'Ballerina: Chút quà. Tôi tặng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646104
    m_Localized: 'Ballerina: Cậu tìm bé mèo dưới nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646103
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646102
    m_Localized: 'Ballerina: Vào đi bé con. Đến giờ chơi thỏa thích!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646101
    m_Localized: 'Ballerina: Tôi tự nhiên như nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646100
    m_Localized: Lượn hộ cho nước nó trong
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646099
    m_Localized: ...Thôi được rồi, cô vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646098
    m_Localized: 'Ballerina: Nghĩ lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646097
    m_Localized: 'Ballerina: Nhìn bé mèo đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646096
    m_Localized: 'Ballerina: Đừng hại bé mèo. Mèo không thích lạnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646095
    m_Localized: 'Ballerina: Người múa chết cóng... Buồn sao...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646094
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646093
    m_Localized: Thôi cô đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646092
    m_Localized: Cô vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646091
    m_Localized: 'Ballerina: Thế mở hay không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646090
    m_Localized: 'Ballerina: Đậu kiểm tra chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646089
    m_Localized: 'Ballerina: Chưa đủ người à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646088
    m_Localized: 'Ballerina: Hai tay, hai chân, một đầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646087
    m_Localized: Thôi cô đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646086
    m_Localized: Cô vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646085
    m_Localized: 'Ballerina: Thế? Quyết định? Làm gì giờ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646084
    m_Localized: 'Ballerina: Tôi công vũ ba lê.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646083
    m_Localized: 'Ballerina: Chắc tôi múa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646082
    m_Localized: 'Ballerina: Xem tôi múa không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646081
    m_Localized: 'Ballerina: Thì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646080
    m_Localized: Chứng minh cô là người xem nào
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451995
    m_Localized: Thấy cô chả giống người gì cả
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451994
    m_Localized: 'Ballerina: Nói gì kỳ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451993
    m_Localized: 'Ballerina: Giờ sao? Cậu nói nữa? Hay gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451992
    m_Localized: 'Ballerina: Tôi sao? Ờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451991
    m_Localized: Chứng minh cô là người xem nào
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451990
    m_Localized: Thấy cô chả giống người gì cả
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451989
    m_Localized: 'Ballerina: Hì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451988
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451987
    m_Localized: 'Ballerina: Chắc không. Quan trọng gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451986
    m_Localized: Cô làm tôi... nhớ tới một người
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451985
    m_Localized: Bộ có ai cử cô đến đây hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451984
    m_Localized: 'Ballerina: Đây không nóng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451983
    m_Localized: 'Ballerina: Thấy nhà cậu. Đi tới đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451982
    m_Localized: 'Ballerina: Biết thành phố kia? Sống đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451981
    m_Localized: Cô làm tôi... nhớ tới một người
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451980
    m_Localized: Bộ có ai cử cô đến đây hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451979
    m_Localized: 'Ballerina: Múa ba lê ấy. Không thấy à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451978
    m_Localized: 'Ballerina: Tôi múa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451977
    m_Localized: Sao cô tìm được nhà tôi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451976
    m_Localized: Cô là ai?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451975
    m_Localized: 'Ballerina: Người ta bảo tôi tới, thì tới.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451974
    m_Localized: 'Ballerina: Cửa mở? Hay không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451973
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451972
    m_Localized: 'Ballerina: Thùng bia. Ngăn tủ. Chân giò. Chả biết. Cho gì cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451971
    m_Localized: Sao cô tìm được nhà tôi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451970
    m_Localized: Cô là ai?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451969
    m_Localized: 'Ballerina: Rồi giúp gì cậu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451968
    m_Localized: 'Ballerina: Hỏi lắm thế. Ừ, quen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451967
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451966
    m_Localized: Cô muốn gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451965
    m_Localized: Cô có quen... ông đầu trọc không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451964
    m_Localized: 'Ballerina: Mở hay không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451963
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451962
    m_Localized: 'Ballerina: Chào tối.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451961
    m_Localized: 'Teacher: Nếu em có bao giờ bắt gặp một đứa nhỏ bơ vơ cần giúp đỡ... Làm ơn hãy chăm sóc bé nó cho cẩn thận. Tạm biệt em.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451960
    m_Localized: 'Teacher: Cô hiểu mà, không trách em đâu. Nhưng trước khi cô đi, xin em... hãy hứa với cô một điều.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451959
    m_Localized: 'Teacher: Nhưng dù sao cũng cảm ơn em... vì đã lắng nghe và cho cô vào nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451958
    m_Localized: 'Teacher: Cô biết cô không thể làm gì để khiến cho tụi nhỏ sống lại...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451957
    m_Localized: Thôi cô đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451956
    m_Localized: Cô vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451955
    m_Localized: 'Teacher: Bọn họ đốt cho bằng hết, rồi ép cô phải chứng kiến tất cả.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451954
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451953
    m_Localized: 'Teacher: Tụi nhỏ có tội tình gì mà phải chịu kết cục này?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451952
    m_Localized: 'Teacher: Chúng ta đã đổ đốn bần cùng đến mức nào? Mà lại tha hóa thành lũ vô cảm, tự cho mình cái quyền hành quyết một đám trẻ con yếu ớt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451951
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451950
    m_Localized: 'Teacher: Họ phát hiện cô đang chứa chấp mấy đứa nhỏ có dấu hiệu là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451949
    m_Localized: 'Teacher: Chính người dân trong thị trấn... đã phóng hỏa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451948
    m_Localized: Thôi cô đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451947
    m_Localized: Cô vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451946
    m_Localized: 'Teacher: Đến bây giờ, cô vẫn cảm tưởng như ánh mắt kinh hoàng của tụi nhỏ đang nhìn cô trân trối...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451945
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451944
    m_Localized: 'Teacher: Họ bắt cô đứng nhìn... Ban đầu họ khóa hết các cửa, đóng ván chặn cửa sổ... rồi châm lửa thiêu rụi cả tòa nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451943
    m_Localized: 'Teacher: Chính mấy người dân ở thị trấn ra tay làm... vì lo sợ tụi nó là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451942
    m_Localized: 'Teacher: Đều đã qua đời... trong biển lửa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451941
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451940
    m_Localized: 'Teacher: Mấy đứa nhỏ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451939
    m_Localized: Sao đám cháy bùng lên vậy cô?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451938
    m_Localized: Giờ bọn nhỏ ra sao rồi cô?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451937
    m_Localized: 'Teacher: Nhưng bây giờ thì... tụi nhỏ đi hết rồi. Không một đứa nào sống sót sau trận hỏa hoạn...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451936
    m_Localized: 'Teacher: Còn có những phụ huynh nỡ bỏ mặc con mình ngay khi tụi nó vừa manh nha dấu hiệu Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451935
    m_Localized: 'Teacher: Người thì bị bên Phòng Chống Thảm Họa bắt đi. Người thì bị sát hại. Rồi còn...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451934
    m_Localized: 'Teacher: Mỗi đứa một hoàn cảnh, nhưng tất cả đều không còn cha mẹ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451933
    m_Localized: 'Teacher: Kể từ lúc thảm họa ập đến, cô bắt đầu cưu mang những đứa trẻ bị bỏ rơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451932
    m_Localized: 'Teacher: Cô là giáo viên mầm non...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451931
    m_Localized: Sao đám cháy bùng lên vậy cô?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451930
    m_Localized: Giờ bọn nhỏ ra sao rồi cô?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451929
    m_Localized: 'Teacher: Nhưng rồi vẫn không đủ... cô không thể cứu được tụi nhỏ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451928
    m_Localized: 'Teacher: Mấy đứa nhỏ chỉ cần có ai đó chăm sóc, thương yêu. Cô đã làm hết sức mình...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451927
    m_Localized: 'Teacher: Cô với sắp nhỏ sinh sống cùng nhau trong một cái trường mầm non cũ nát.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451926
    m_Localized: 'Teacher: Cô cưu mang những em bị gán cho cái mác "dơ bẩn". Người ta nghi tụi nó là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451925
    m_Localized: 'Teacher: Cô... Cô chỉ muốn đem lại chút niềm hy vọng cho mấy đứa trẻ bị bỏ rơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451924
    m_Localized: Cô là ai mới được?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451923
    m_Localized: Có chuyện gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451922
    m_Localized: 'Teacher: Cô cảm thấy nặng nề quá. Cho phép cô được nói chuyện với em một chút nha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451921
    m_Localized: 'Teacher: Cô rất xin lỗi vì đã làm phiền em, nhưng mà... em có đang rảnh không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451920
    m_Localized: 'Dude: Bảo trọng nhé bạn tui... Nhớ chăm sóc tốt mấy cốt của bro nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451919
    m_Localized: 'Dude: Thôi hông sao đâu bro. Tui hiểu mà. Mình cứ chill hoy, tui hông để bụng gì hết á.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451918
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451917
    m_Localized: 'Dude: Uầy, chán vậy bro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451916
    m_Localized: 'Dude: Này mà dựng thành phim là đảm bảo cháy khét lèn lẹt! 10 điểm hông có nhưng!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451915
    m_Localized: 'Dude: Thề ý, từ khi cha sinh mẹ đẻ tới giờ tui mới gặp được chuyện, kiểu, toẹt vời ông mặt trời dữ vậy luôn á.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451914
    m_Localized: 'Dude: Á đùùùùù! Mơn nha mơn nha, con vợ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451913
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451912
    m_Localized: Ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451911
    m_Localized: 'Dude: Trước giờ tui chỉ ước mong được lên màn ảnh một lần trong đời...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451910
    m_Localized: 'Dude: Siêu bánh cuốn luôn, ăn đứt đọc sách đó bro à.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451909
    m_Localized: 'Dude: Trên trời dưới biển, CÁI GÌ cũng có: chính kịch nè, âm mưu phản bội nè, rồi giật gân ly kỳ các kiểu con đà điểu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451908
    m_Localized: 'Dude: Nhưng mà bro ơi, phim ảnh thì khác nha...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451907
    m_Localized: 'Dude: Chưa kể TV báo đài toàn đưa tin tức tiêu cực gì đâu hông... Cái vibe bị kiểu, đi vào lòng đất luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451906
    m_Localized: 'Dude: Ai cũng đi móc mỉa nhau, nói xấu sau lưng nhau, rồi xì xầm ba cái tô xích tích xô làm tụt mood dễ sợ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451905
    m_Localized: 'Dude: Biết chứ bạn ơi, ngoài kia loạn quá trời quá đất luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451904
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451903
    m_Localized: Ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451902
    m_Localized: 'Dude: Rồi rồi, tui chill tui chill... Nào, cho tui vô với bạn hiền!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451901
    m_Localized: 'Dude: Ảo vãi lờ luôn bạn à! Thằng cốt tui nó đọc báo có nhắc vụ này, tin chuẩn nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451900
    m_Localized: 'Dude: Giờ bro thử tưởng tượng nhá, con người mà bay ra vũ trụ rồi gửi thư cho mấy khứa ngoài hành tinh... Má nó ảooooo ma Canada...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451899
    m_Localized: 'Dude: Đúng kiểu, tiên tri vũ trụ luôn bro à. Đôi mắt nhìn thấu hồng trần, ba cái công nghệ tân tiến số dzách gì là mấy ổng thấy hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451898
    m_Localized: 'Dude: Ông coi mấy bộ sci-fi đi là biết, tác giả người ta dự đoán trước được viễn cảnh tương lai nó như nào rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451897
    m_Localized: 'Dude: Ui bạn ơiiiiii! Bạn đáp vậy làm tui xịt keo cứng ngắc luôn! Tui chỉ có nói khôn chứ hông nói nhảm bao giờ à nha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451896
    m_Localized: Thật đấy à? Ông không biết tình hình thế giới như nào sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451895
    m_Localized: Ông nói lảm nhảm cái gì tôi chịu luôn?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451894
    m_Localized: 'Dude: À còn đồ ăn nữa chứ, con vợ ơi. Mình cần cả đốnggggggg lương thực luôn đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451893
    m_Localized: 'Dude: Với lại ông có quả dân chủ hay kiểu, bom đạn gì hông á? Phải trữ siêu nhiều hàng nóng thì mới sống sót tới cuối phim được bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451892
    m_Localized: 'Dude: Ông phải tin tui, thông tin này quan trọng lắm. Kế hoạch tác chiến kiểu gì phụ thuộc HẾT vào đó á.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451891
    m_Localized: 'Dude: Với lại nó thuộc dạng nào nữa? Ý là, kiểu nó nhiễm virus não blèblàhblòh gì gì đó hay là mấy đứa xác chết sống lại?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451890
    m_Localized: 'Dude: Ê mà mách tui cái bạn ơi, mình đang phải đối đầu với tụi zombie đi chậm hay mấy con tăng động chạy vù vù ấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451889
    m_Localized: 'Dude: Kịch bản này quen lắm anh bạn à, tui coi cả đống phim như vậy chứ ít đâu. Gì chứ sinh tồn thì thằng đây trùm mẹ rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451888
    m_Localized: 'Dude: Xời, bro ơi, việc gì khó cứ để tui lo. Ý là, kèo này tui dư sức gánh team được nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451887
    m_Localized: 'Dude: Là mấy con zombie á?! ĐÙ MÁ TUI BIẾT NGAY MÀ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451886
    m_Localized: Thật đấy à? Ông không biết tình hình thế giới như nào sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451885
    m_Localized: Ông nói lảm nhảm cái gì tôi chịu luôn?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451884
    m_Localized: 'Dude: Mà nhá, một đội phải có bốn anh hùng cơ. Bốn mới tạo thành tứ quý, bộ tứ siêu đẳng, hào quang main chói lọi. Chết thế méo nào được!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451883
    m_Localized: 'Dude: Bấm nút, phóng tên lửa! Thử thách 69 ngày để giải cứu nhân loại, GÉT GÔ! Đỉnh nóc, kịch trần, bay phấp phới luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451882
    m_Localized: 'Dude: Giờ mình chỉ cần lập đội phi hành gia ngầu lòi chiến đét rồi phi thẳng lên mặt trời là xong, chuẩn chưa con vợ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451881
    m_Localized: 'Dude: Ê bro cái này tui thấy trên phim rồi nè! Phim gì mà có cái ông trọc lóc ý!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451880
    m_Localized: 'Dude: Á đù, ghê ghê ghê vậy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451879
    m_Localized: Có những sinh vật giả dạng người từ dưới lòng đất chui lên
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451878
    m_Localized: Mặt trời đang nóng phừng phừng, ban ngày nó thiêu cháy người ta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451877
    m_Localized: 'Dude: Rốt cuộc là sao á bạn hiền? Sao tui như người trên núi mới xuống vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451876
    m_Localized: 'Dude: Ê bro có thấy ngoài kia nó loạn con cào cào lên luôn hông? Cái méo gì đang xảy ra vậy trời?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451875
    m_Localized: 'Dude: Alo một hai ba! Khỏe hông con vợ ơi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451874
    m_Localized: 'Blind: Bằng không thì NÓ sẽ tìm ra cậu đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451873
    m_Localized: 'Blind: Lạy chín phương trời, lạy mười phương đất, ĐỪNG CÓ DẠI mà đến gần bất cứ thi thể cháy rụi nào lúc đêm về.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451872
    m_Localized: 'Blind: Thôi được rồi, tôi đi vậy. Nhưng tôi cảnh báo cậu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451871
    m_Localized: 'Blind: Khốn nạn thật... Chẳng còn mắt để nhắm thì có thiếp đi nổi không đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451870
    m_Localized: 'Blind: Cảm ơn cậu... Cuối cùng tôi cũng được nghỉ ngơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451869
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451868
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451867
    m_Localized: 'Blind: Sinh vật đó đáng lẽ không thể tồn tại... NÓ KHÔNG NÊN TỒN TẠI.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451866
    m_Localized: 'Blind: To lớn hơn... Hung bạo hơn... Không một cái tên nào diễn tả nổi. NÓ lần theo mùi da thịt cháy xì xèo rồi cướp sạch mọi thứ ta vun vén.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451865
    m_Localized: 'Blind: Không... Không hề. Ngoài kia có thứ còn kinh hãi hơn gấp bội.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451864
    m_Localized: 'Blind: Cậu nghĩ sao chứ? Một kẻ da nhợt thôi mà đủ để khiến tôi phải móc mắt mình ư?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451863
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451862
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451861
    m_Localized: 'Blind: Lạy Chúa... NÓ khủng khiếp đến nỗi tôi còn không muốn kẻ thù truyền kiếp của mình phải nhìn thấy cảnh tượng đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451860
    m_Localized: 'Blind: Rồi NÓ từ từ nhai nuốt thi thể đen ngòm như than... NGAY TRƯỚC CON NGƯƠI NÀY!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451859
    m_Localized: 'Blind: NÓ... ban đầu còn chẳng để ý tôi, vì mải ngấu nghiến mấy mẩu da thịt đã cháy rụi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451858
    m_Localized: 'Blind: Chỉ vì tôi trót phạm phải một sai lầm cỏn con: lạc bước ở sai địa điểm, sai thời khắc...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451857
    m_Localized: 'Blind: Bi ai của ta là yến tiệc của NÓ! Một bữa đại tiệc thống khổ! Nó ngốn trọn mọi hãi sợ, buồn đau... cả tâm trí con người!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451856
    m_Localized: 'Blind: Thôi, cậu đừng nên biết thì hơn...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451855
    m_Localized: Ý anh là cái thằng da nhợt tái xanh đó hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451854
    m_Localized: Anh thấy gì cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451853
    m_Localized: 'Blind: Đấy là nỗ lực tuyệt vọng hòng xóa sổ hình ảnh kinh hoàng đó khỏi tâm trí. Để rồi giờ đây, trước mắt tôi chỉ còn một khoảng không vô tận.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451852
    m_Localized: 'Blind: Tôi hy sinh đôi mắt để không phải phát điên.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451851
    m_Localized: 'Blind: Tôi... là tôi tự hại chính mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451850
    m_Localized: Ý anh là cái thằng da nhợt tái xanh đó hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451849
    m_Localized: Anh thấy gì cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451848
    m_Localized: 'Blind: Tin tôi đi... Nếu chẳng may nhìn thấy NÓ, cậu cũng sẽ làm vậy mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451847
    m_Localized: 'Blind: Không một từ ngữ nào diễn tả được nỗi khiếp đảm cổ xưa xé toạc tâm hồn tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451846
    m_Localized: 'Blind: Nó luôn ở ngay trước mặt tôi, hằn sâu vào bóng tối.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451845
    m_Localized: 'Blind: Tôi đã nhác thấy một thứ... không thể nào nói nên lời. Thực chẳng dám mô tả... Ai lại đi soi vào vực sâu của tâm trí khi nó vụn vỡ, suy sụp?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451844
    m_Localized: Ai hại anh thế này?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451843
    m_Localized: Mắt anh bị sao vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451842
    m_Localized: 'Blind: Cuối cùng cũng tìm được nơi trú tạm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451841
    m_Localized: 'Fatman: Giờ còn chỗ nào để mà đi nữa đây? Bỏ... Bỏ mẹ rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451840
    m_Localized: 'Fatman: Láo toét! Mày không thấy ông đứng ngoài này khổ sở như nào à!?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451839
    m_Localized: 'Fatman: Khi nào sóng yên biển lặng rồi, anh sẽ, hèm hèm, xem xét tạo điều kiện cho đời chú lên hương luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451838
    m_Localized: 'Fatman: Tuyệt vời. Chú sẽ không hối hận đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451837
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451836
    m_Localized: Ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451835
    m_Localized: 'Fatman: Hôm nay chú cho anh vào, về sau mọi sự bình ổn trở lại... anh hứa sẽ, hèm, đền đáp xứng đáng cho chú. Vô cùng hậu hĩnh luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451834
    m_Localized: 'Fatman: À hèm, thôi mà... Cố giúp anh tí đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451833
    m_Localized: 'Fatman: Gặp ông lớn mà mày không niềm nở tiếp đón à? Ông đây từng nắm bao nhiêu chức quyền đấy! Ông là bộ trưởng đấy chứ đùa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451832
    m_Localized: 'Fatman: Không thì anh cất công lết xác đến đây để làm cái gì? Hửm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451831
    m_Localized: 'Fatman: Thật đấy chú bé ơi! Anh... Anh đang không khỏe tí nào. Phải tắm nước lạnh ngay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451830
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451829
    m_Localized: Ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451828
    m_Localized: 'Fatman: Để thêm một khắc nữa thôi là ông lăn ra thành thịt quay ngay trước cửa nhà mày đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451827
    m_Localized: 'Fatman: Nghe đây chú bé. Mở cửa cho ông. Ông phải vào bồn tắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451826
    m_Localized: 'Fatman: ...Nhắc mới nhớ... Nhà chú mày có kem ốc quế không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451825
    m_Localized: 'Fatman: Tuyệt vời! Suýt thì mỡ anh chảy xuống cống nhà chú rồi chứ đùa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451824
    m_Localized: Sao ông lại muốn dùng phòng tắm của tôi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451823
    m_Localized: Ừ, tôi có
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451822
    m_Localized: 'Fatman: Ngâm mình trong nước lạnh tí là được. Anh mượn cái, ừm, vòi hoa sen của chú được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451821
    m_Localized: 'Fatman: Giời ạ... Anh ở mấy khu nghỉ dưỡng nhiệt đới còn không thấy nóng như này. Thật!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451820
    m_Localized: 'Fatman: Da thịt anh như muốn chảy hết ra rồi kia kìa. Đấy, đấy, nhìn mà xem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451819
    m_Localized: 'Fatman: Có, rất sao, đầy sao luôn! Anh đang khó chịu vãi lồn. Nhìn anh đây này!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451818
    m_Localized: Sao ông lại muốn dùng phòng tắm của tôi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451817
    m_Localized: Ừ, tôi có
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451816
    m_Localized: 'Fatman: ...Má anh thở không nổi luôn. Nhà chú mày có, ờm, phòng tắm không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451815
    m_Localized: 'Fatman: Tối mát hơn tí thật... Nhưng mà không khí nó cứ ngột ngạt như... như... như...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451814
    m_Localized: 'Fatman: Xời ơi! Thế mà anh vẫn thấy nóng như cái lò thiêu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451813
    m_Localized: Ông có sao không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451812
    m_Localized: Đang đêm đấy ông ơi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451811
    m_Localized: 'Fatman: Đù má... Nóng chảy mỡ ra đây nà. Nóng lắm chú mày ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451810
    m_Localized: 'Buddy: Thôi được rồi, hổng làm phiền anh nữa. Tui đi đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451809
    m_Localized: 'Buddy: Ui, anh bạn à...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451808
    m_Localized: 'Buddy: Không là tui chỉ còn có một thân một mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451807
    m_Localized: 'Buddy: Cảm tạ anh bạn lắm lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451806
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451805
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451804
    m_Localized: 'Buddy: Thôi nhây dị đủ rồi, túm lại là anh bạn cho tui vô nhà nha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451803
    m_Localized: 'Buddy: Phải chìm trong men say mới quên đi cái khổ được. Chứ tỉnh táo mà đối mặt với tam tai thì sao chịu nổi hả trời.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451802
    m_Localized: 'Buddy: Hề hề, chọc xíu thôi, bớt căng đi bạn tui ơi. Đừng để bụng làm gì. Sống ở thời buổi này chỉ có cười cho qua chuyện chứ còn gì nữa đâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451801
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451800
    m_Localized: 'Buddy: Vừa ngon vừa bổ, uống đúng cách thì cũng như ăn kiêng luôn. Hông tin anh bạn cứ nhìn bo-đì chuẩn men của tui nè!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451799
    m_Localized: 'Buddy: Sáng nay tui làm một bữa phê pha luôn. Ăn theo chế độ thằng bạn tui bày ra: sáng bia, tối rượu. Ngon số dách.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451798
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451797
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451796
    m_Localized: 'Buddy: Vậy... anh bạn cho tui vô với được hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451795
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451794
    m_Localized: 'Buddy: Nếu tui giỡn có hơi kỳ cục, dô diên quá thì tui cáo lỗi. Làm dị cho nó lên tinh thần thôi à. Anh bạn hiểu hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451793
    m_Localized: 'Buddy: Một nụ cười bằng mười thang thuốc bổ mà bạn. Cười cho đời nó tươi, mình mới vui sống chớ. Không là tui cũng chết ngắc rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451792
    m_Localized: 'Buddy: Tánh tui hơi "độc thiệt", nhưng tui hổng có đi diễn hài "độc thoại" đâu nha. Thế giới đang buồn thảm quá, giỡn mấy câu cho vui cửa vui nhà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451791
    m_Localized: Hình như anh đang say. Mới đi nhậu về hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451790
    m_Localized: Bộ anh là diễn viên hài hay gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451789
    m_Localized: 'Buddy: Thôi kệ đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451788
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451787
    m_Localized: 'Buddy: Anh bạn yên tâm, hổng có chiện tui đi hại người khác chỉ vì răng, mắt hay ba cái gì đó TV nói ra rả bên tai đâu. Tui còn hổng nỡ–'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451786
    m_Localized: 'Buddy: Mới có một hai dấu hiệu kỳ kỳ thì chắc gì người ta đã là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451785
    m_Localized: 'Buddy: Trời ơi tui giỡn có xíu thôi! Gì mà căng dữ thần dị anh bạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451784
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451783
    m_Localized: 'Buddy: Mà lâu lâu ngứa tay chút xíu thì tui có dộng vô mặt mấy đứa răng trắng, mắt nai này kia... Tại tui ghen ăn tức ở đó mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451782
    m_Localized: 'Buddy: Tin tui đi bạn ơi, tim tui nó rộng mở, lòng tui nó bao la như biển Thái Bình dạt dào dị đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451781
    m_Localized: Hình như anh đang say. Mới đi nhậu về hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451780
    m_Localized: Bộ anh là diễn viên hài hay gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451779
    m_Localized: 'Buddy: Tui đây độc thân vui tính, đi bar đi biếc gì thoải mái. Anh bạn buồn buồn nổi hứng thì cứ a lô tui một tiếng, tui có mặt liền!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451778
    m_Localized: 'Buddy: Tui thì làm gì có má vợ. Tới vợ tui còn hổng có nữa là!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451777
    m_Localized: 'Buddy: Hề hề, giỡn xíu thôi. Anh bạn tin sái cổ đúng hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451776
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257716
    m_Localized: 'Buddy: Số là tui vừa bị má vợ đuổi ra đường, tại tui có lỡ đá đít một khứa bên Thảm Họa ra khỏi nhà ý mà. Bả sợ người ta lại tới kiếm chiện, nên là...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257715
    m_Localized: 'Buddy: À, chiện thường ở huyện thôi bạn tui ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257714
    m_Localized: Sao tôi biết anh có ngay thẳng thật hay không?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257713
    m_Localized: Anh bị sao mà tới đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257712
    m_Localized: 'Buddy: Mến chào anh bạn. Trong nhà còn chỗ nào cho chàng trai sống ngay, sống thiệt này hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257711
    m_Localized: 'Bestson: Thôi chào anh nha, người lạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257710
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257709
    m_Localized: 'Bestson: Đúng rồi... Chắc kèo ba mẹ sắp về rồi đó. Chắc vậy. Cầu trời...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257708
    m_Localized: 'Bestson: Thôi em về nhà đây. Biết đâu ba mẹ lại về thì sao...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257707
    m_Localized: 'Bestson: Ờ, thôi vậy nhiều khi lại an toàn hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257706
    m_Localized: 'Bestson: Nhưng... có khi anh nói đúng đó. Chắc giờ em nên ở với anh thì hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257705
    m_Localized: 'Bestson: Lỡ đâu ba mẹ về nhà mà hông thấy em thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257704
    m_Localized: 'Bestson: Em cũng hổng biết có nên hông nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257703
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257702
    m_Localized: Cậu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257701
    m_Localized: 'Bestson: Giờ phải tính sao đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257700
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257699
    m_Localized: 'Bestson: Ác mộng là đây hả trời...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257698
    m_Localized: 'Bestson: Má ơi, lỡ... lỡ mặt trời thiêu chết ba mẹ luôn rồi thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257697
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257696
    m_Localized: Cậu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257695
    m_Localized: 'Bestson: Giờ phải tính sao đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257694
    m_Localized: 'Bestson: Em hổng biết phải nghĩ sao bây giờ nữa. Mà chắc anh cũng hông tin em đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257693
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257692
    m_Localized: 'Bestson: Ủa, vậy ba mẹ bỏ đi làm gì ta? Mà sao hông thèm dẫn mình theo nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257691
    m_Localized: 'Bestson: Trời đất ơi... Rồi lỡ đám "Dị Khách" đó giết ba mẹ em mất tiêu luôn thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257690
    m_Localized: Mặt trời phát nổ rồi. Nó đang thiêu sống con người ta đó
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257689
    m_Localized: Bọn Dị Khách trồi lên từ mặt đất. Giờ chẳng còn tin ai được nữa đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257688
    m_Localized: 'Bestson: Thành ra em nghĩ hay là giờ tìm ai đó nói chuyện, biết đâu người ta chịu kể mình nghe có vụ gì. Anh nói em biết được hông? Đi nha anh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257687
    m_Localized: 'Bestson: Sau đó mấy tiếng thì ba mẹ hớt hải đi mất... rồi không bao giờ về luôn. Giờ em SỢ quá trời, hổng dám bật TV lên.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257686
    m_Localized: 'Bestson: Em có mở xem đâu mà biết. Chỉ tổ xì trét thêm thôi anh à. Nhưng đợi hoài hổng thấy ai quay lại, còn em thì vẫn chưa hiểu chuyện gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257685
    m_Localized: 'Bestson: Rồi bữa trước á, hai người thấy trên TV đang có vụ gì ghê dữ lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257684
    m_Localized: 'Bestson: Nhưng ba với mẹ thì cứ suốt ngày theo dõi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257683
    m_Localized: 'Bestson: Bữa em còn đọc được đâu đó, là mình sẽ sống thọ hơn nếu hông đọc hay xem tin tức nữa cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257682
    m_Localized: 'Bestson: Ba cái thời sự đó có bao giờ đưa được tin gì tốt lành đâu. Toàn làm em buồn với sợ, nên là em nghỉ xem luôn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257681
    m_Localized: Mặt trời phát nổ rồi. Nó đang thiêu sống con người ta đó
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257680
    m_Localized: Bọn Dị Khách trồi lên từ mặt đất. Giờ chẳng còn tin ai được nữa đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257679
    m_Localized: 'Bestson: Rốt cuộc là họ đi đâu mất rồi? Em phải tìm hiểu cho ra lẽ mới được. Anh ơi, làm ơn... nói cho em nghe đang có chuyện gì với!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257678
    m_Localized: 'Bestson: Mà đó là chuyện của cả tuần trước rồi... Giờ chưa thấy họ về nữa. Em cứ đợi hoài, nhưng ba mẹ thì... hỏng thấy đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257677
    m_Localized: 'Bestson: Một sáng nọ, em mới mở mắt ra thì thấy hai người tự nhiên lên cơn hết. Còn nói phải rời đi liền này kia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257676
    m_Localized: 'Bestson: Dạ hông anh. Mấy cái thời sự làm em bất an lắm, nên là em cứ... kệ nó đi thôi. Nhưng ba mẹ em thì có xem đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257675
    m_Localized: Bộ cậu không xem TV à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257674
    m_Localized: Hả, cậu không biết chuyện gì đang xảy ra thật à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257673
    m_Localized: 'Bestson: Người ta bắn giết nhau đủ kiểu... Em hông hiểu gì hết trơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257672
    m_Localized: 'Bestson: Sao mà trời nóng ơi là nóng, nóng thở hông nổi luôn. Đã vậy mọi người còn cứ... bị cái gì á.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257671
    m_Localized: 'Bestson: Anh ơi, anh biết đang có vụ gì hông ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257670
    m_Localized: 'Fugitive: Thây kệ cha mày. Ngủ ngon nhé, thằng đĩ súc vật.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257669
    m_Localized: 'Fugitive: Bọn bây sống chui rúc trong nhà như lũ chuột nhắt, đéo cho ai vào cả!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257668
    m_Localized: 'Fugitive: Phải rồi, tao còn lạ gì nữa. Từ đầu mày cũng đéo khác gì bọn nhãi nhu nhược hèn chó kia! Cùng một giuộc với nhau cả!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257667
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257666
    m_Localized: 'Fugitive: ĐỊT MẸ MÀY!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257665
    m_Localized: 'Fugitive: May mà cậu không lạnh nhạt như mấy người hàng xóm ở đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257664
    m_Localized: 'Fugitive: Thật lòng cảm ơn cậu. Tôi nợ cậu kiếp này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257663
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257662
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257661
    m_Localized: 'Fugitive: Tôi thấy hết rồi, biết quá nhiều rồi... KIỂU GÌ chúng nó cũng đuổi cùng giết tận tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257660
    m_Localized: 'Fugitive: Thế nên tôi mới bỏ chạy thục mạng, dù có bị ăn đạn lúc đang trèo qua hàng rào chết giẫm kia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257659
    m_Localized: 'Fugitive: Thấy vậy là tôi biết mình phải bấm nút biến ngay và luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257658
    m_Localized: 'Fugitive: Bọn nó hành dân mình tới chết vậy đấy. Bảo sao ai bị lôi vào khu cách ly là từ con mẹ nó biệt luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257657
    m_Localized: 'Fugitive: Mới đấy còn nghe tiếng gào thét... ngay sau đó đã im bặt. Bọn áo vàng lôi ra một cái túi đen, còn gã kia thì biến mất luôn. Hiểu rồi chứ gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257656
    m_Localized: 'Fugitive: CHÍNH MẮT TÔI thấy chứ đâu. Bọn nó lôi một gã ất ơ tội nghiệp nào đó vào trong túp lều.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257655
    m_Localized: 'Fugitive: Tin chuẩn đấy chứ đồn đéo gì!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257654
    m_Localized: 'Fugitive: Cậu đã nghe đồn vụ bọn Thảm Hại tiến hành thí nghiệm để tìm ra Dị Khách chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257653
    m_Localized: 'Fugitive: Chuẩn con mẹ nó rồi cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257652
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257651
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257650
    m_Localized: 'Fugitive: Sau đó tôi đáp xuống vũng nước, cứ thế mà cút con mẹ nó ra khỏi đó thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257649
    m_Localized: 'Fugitive: Mà rốt cuộc tôi sơ suất, chọn thời cơ chưa chuẩn lắm. Thế là một thằng chó lính quay đầu, nhác thấy tôi xong lập tức xả súng luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257648
    m_Localized: 'Fugitive: Trong đấy chúng nó lúc nào cũng tất bật. Như thể đang... chuẩn bị làm cái gì to tát lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257647
    m_Localized: 'Fugitive: Tôi chả cần mưu kế gì, cứ chờ thời cơ đến là leo rào ngon ơ trót lọt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257646
    m_Localized: 'Fugitive: Mà an ninh ở đấy cũng lỏng lẻo thấy mẹ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257645
    m_Localized: 'Fugitive: Khu cách ly của bọn Thảm Hại là thế đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257644
    m_Localized: 'Fugitive: Rồi lấp thêm cả đống container to đùng to đoàng. Bọn nó lùa dân vào đấy mỗi sáng éo khác gì bò lợn vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257643
    m_Localized: 'Fugitive: Bây giờ cậu tưởng tượng nhá: Một bãi đỗ xe trống không, bốn bề là hàng rào với vài túp lều bên trong.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257642
    m_Localized: Vậy bây giờ họ đang truy lùng anh hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257641
    m_Localized: Mấy khu cách ly ấy như nào vậy? Kể tôi nghe xem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257640
    m_Localized: 'Fugitive: Tôi táp thẳng lại luôn: Cút con mẹ mày đi! Thế là bị ăn còng số tám. Nhưng cuối cùng tôi vẫn chuồn ra được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257639
    m_Localized: 'Fugitive: Chưa kịp hiểu gì thì nó đã ghi ghi chép chép cái đéo gì đấy vào sổ, rồi bảo tôi phải hợp tác đi cùng chúng nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257638
    m_Localized: 'Fugitive: Từ đầu lúc tôi mới mở cửa thì bọn nó đã soi xét từ đầu đến chân, nghi tôi sẵn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257637
    m_Localized: 'Fugitive: Ừ, tôi vừa trốn ra xong. Bọn nó gõ cửa nhà tôi khi đang tuần tra, rồi lôi tôi thẳng đến chỗ đó luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257636
    m_Localized: Vậy bây giờ họ đang truy lùng anh hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257635
    m_Localized: Mấy khu cách ly ấy như nào vậy? Kể tôi nghe xem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257634
    m_Localized: 'Fugitive: Lục phủ ngũ tạng tôi chưa bị lòi ra là may rồi... Mà có lòi thì chắc cũng chẳng được bao nhiêu... Hà hà– ặc, cười cái thôi mà đau vãi lồn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257633
    m_Localized: 'Fugitive: Cũng may là đạn nó bay xuyên qua người luôn chứ chả nằm lại trong đấy... Nhưng địt mẹ nó, máu vẫn tuôn như suối vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257632
    m_Localized: 'Fugitive: Mấy thằng ngu ấy bắn phát nào thì trượt phát đấy... Ngoại trừ phát này đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257631
    m_Localized: 'Fugitive: Bọn chó Thảm Hại suýt nữa bắt được tôi... lúc tôi leo rào trốn khỏi khu cách ly...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257630
    m_Localized: Đã xảy ra chuyện gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257629
    m_Localized: Ai bắn anh vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257628
    m_Localized: 'Fugitive: Tôi vừa bị trúng đạn. Sắp không trụ được nữa rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257627
    m_Localized: 'Fugitive: C-Cậu ơi, giúp tôi với...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257626
    m_Localized: 'Nun: Đích thân Đức Chúa sẽ phán xét ngươi trước cổng Nước Trời. Hãy nhớ lấy lời ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257625
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257624
    m_Localized: 'Nun: Rủi ta mà chết rục ở đâu đó thì cái thân ngươi liệu mà gánh tội.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257623
    m_Localized: 'Nun: Ngươi đang tâm bỏ mặc bà lão đáng thương này hay sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257622
    m_Localized: 'Nun: Ra là ngươi muốn như vậy hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257621
    m_Localized: 'Nun: Cầu Chúa phù hộ con.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257620
    m_Localized: Thôi bà đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257619
    m_Localized: Bà vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257618
    m_Localized: 'Nun: Ngươi cứ yên tâm. Ta sẽ thanh tẩy bằng sạch thứ ngôn từ tục tĩu đó ra khỏi nhà này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257617
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257616
    m_Localized: 'Nun: Ta chỉ hỏi một câu về căn nhà của ngươi thôi, thế mà ngươi lại nguyền rủa ta?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257615
    m_Localized: 'Nun: Ngươi không biết kính sợ Đức Chúa ư? Không biết hổ thẹn là gì à?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257614
    m_Localized: 'Nun: Ngươi dám dùng thứ ngôn ngữ thô tục ấy để tiếp chuyện với ta sao! Tên vô thần mọi rợ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257613
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257612
    m_Localized: Thôi bà đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257611
    m_Localized: Bà vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257610
    m_Localized: 'Nun: Như vậy là quá đáng lắm sao con?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257609
    m_Localized: 'Nun: Ta chỉ muốn xem cái ổ chuột nhà con có xứng để ta trú lại không thôi. Ta ghét nhất là những thứ nhơ bẩn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257608
    m_Localized: 'Nun: Ôi, tạ ơn Chúa! Con không nói thì ta cũng chẳng biết đâu đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257607
    m_Localized: Bà lải nhải cái đéo gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257606
    m_Localized: Đây không phải khách sạn đâu nhé!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257605
    m_Localized: 'Nun: Ta không chịu nổi lũ sinh vật gây hại đó. Tạo vật nhơ bẩn nhất của Đức Chúa chẳng tốt lành gì cho xác thịt này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257604
    m_Localized: 'Nun: Thứ hai, giường chiếu của con có bọ rệp không? Bên trong những bức tường kia không có chuột làm tổ chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257603
    m_Localized: 'Nun: Nếu trong nhà con có mặt những kẻ phiền lụy như chúng thì con phải cho ta biết ngay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257602
    m_Localized: 'Nun: Đầu tiên, ta không chịu nổi lũ nát rượu hay nghiện ngập.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257601
    m_Localized: 'Nun: Con sẵn lòng cưu mang người khốn khó chứ nhỉ? Ta chỉ muốn xác nhận đôi điều.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257600
    m_Localized: 'Nun: Ta cần một căn phòng ở trong nhà con.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257599
    m_Localized: Bà lải nhải cái đéo gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257598
    m_Localized: Đây không phải khách sạn đâu nhé!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257597
    m_Localized: 'Nun: Trong nhà con hẳn là có bài trí linh ảnh nhỉ? Ta cần một chốn yên lặng để suy ngẫm và tĩnh nguyện.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257596
    m_Localized: "Nun: Nhân tiện đang nói đến chuyện này thì... Ta xin hỏi luôn về vấn đề \ntiện nghi."
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257595
    m_Localized: 'Nun: Vừa đẹp để ẩn náu, con à. Ta muốn trú lại đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257594
    m_Localized: 'Nun: Lạy Chúa nhân từ... Ta nói rất rõ ràng rồi đấy, con có nghe không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257593
    m_Localized: Bà muốn gì? Nói rõ xem nào
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257592
    m_Localized: Vừa cái gì cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257591
    m_Localized: 'Nun: Với ta thì như thế là vừa đẹp rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257590
    m_Localized: 'Nun: Có vẻ mái nhà đơn sơ của con tọa lạc ở chốn thâm sơn cùng cốc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257589
    m_Localized: 'Raskolnikov: Em xin lỗi vì làm mất thì giờ của anh. Em chỉ mong... sau này học được cách giết người. Để có thể... đứng lên tự bảo vệ mình...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257588
    m_Localized: 'Raskolnikov: N-Nhưng em thề á, em hoàn toàn tỉnh nha anh! Tại dạo này em kiểu... hay lo quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257587
    m_Localized: 'Raskolnikov: Híc... Em biết là em nói năng như thằng khùng bái thiến...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257586
    m_Localized: 'Raskolnikov: U là trời... Anh hổng cho em vô hở?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257585
    m_Localized: 'Raskolnikov: A-Anh chỉ cho em cách... giết Dị Khách với nha? Em muốn có đủ can đảm... để hiên ngang đối mặt với cái chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257584
    m_Localized: 'Raskolnikov: Nếu anh hông ngại thì... Sau khi kiểm tra em xong...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257583
    m_Localized: 'Raskolnikov: Dạ, em cám ơn anh nhiều lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257582
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257581
    m_Localized: Cậu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257580
    m_Localized: 'Raskolnikov: Anh dạy cho em cách... giết người, được hông...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257579
    m_Localized: 'Raskolnikov: V-Với lại á... Nếu, nếu mà được nữa thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257578
    m_Localized: 'Raskolnikov: Nên là em muốn tìm... ai đó, kiểu đủ tin cậy, để bảo vệ em giùm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257577
    m_Localized: 'Raskolnikov: M-Mà em thì... chỉ là một thằng thỏ đế thôi. Có mỗi vụ tự vệ em làm còn hổng xong nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257576
    m_Localized: 'Raskolnikov: Chừ chỉ cần ngó ngó nghiêng nghiêng có xíu thôi, là đã bị bắn lủng đầu rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257575
    m_Localized: 'Raskolnikov: Ý em là kiểu, muốn tự vệ bản thân khỏi đám Dị Khách, với mấy người săn lùng tụi nó á.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257574
    m_Localized: 'Raskolnikov: Ấy, không không, từ từ đã anh ơi. H-Hông phải em sợ cái ông điên cầm súng đó mô.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257573
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257572
    m_Localized: Cậu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257571
    m_Localized: 'Raskolnikov: Bởi rứa nên, kiểu, em mới muốn học hỏi từ mấy người sành sỏi á.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257570
    m_Localized: 'Raskolnikov: E-Em sợ quá anh ơi, hông biết đánh lại thì sao mà tự bảo vệ mình cho nổi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257569
    m_Localized: 'Raskolnikov: Hồi đó em hiền khô, tới con ruồi con muỗi còn hổng dám đập. Mà kiểu... thời buổi chừ, mấy đứa nhu nhược là dễ chết đầu tiên.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257568
    m_Localized: 'Raskolnikov: Em hổng cố ý nói chuyện như thằng điên mô. Tại...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257567
    m_Localized: 'Raskolnikov: U là trời... Chắc anh thấy em... mát mát lắm đúng hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257566
    m_Localized: Cậu sợ ai mà phải bất chấp phòng thân thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257565
    m_Localized: Sao cậu ám ảnh với vụ giết người vậy hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257564
    m_Localized: 'Raskolnikov: Để tụi nó mới là đứa phải sống trong lo sợ... chớ hông phải em.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257563
    m_Localized: 'Raskolnikov: Em, em thề... sẽ có ngày em học được cách giết người ngon ơ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257562
    m_Localized: 'Raskolnikov: Hên là ông khùng đó hổng nhìn thấy em. Chứ ổng mà thấy... chắc bẻ cổ em luôn quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257561
    m_Localized: 'Raskolnikov: Kiểu... nãy em đụng trúng một ông điên, cũng cầm súng lù lù. Ổng tra hỏi cái anh tê dữ lắm, để coi người ta có phải là Dị Khách hông á.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257560
    m_Localized: 'Raskolnikov: U là trời... Anh đừng có nghĩ bậy nha, em hổng có gạ anh giết người mô nạ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257559
    m_Localized: 'Raskolnikov: D-Dạ anh! Rứa lỡ tụi Dị Khách mà léng phéng xuất hiện, là anh xử gọn được hết luôn đúng hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257558
    m_Localized: Cậu sợ ai mà phải bất chấp phòng thân thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257557
    m_Localized: Sao cậu ám ảnh với vụ giết người vậy hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257556
    m_Localized: 'Raskolnikov: Thậm chí mà, kiểu, đường cùng bí lối quá, dám anh lấy tay bóp cổ người ta chết ngắc luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257555
    m_Localized: 'Raskolnikov: N-Nhưng em nghe giọng anh... sắc như dao cạo là em biết liền. Dòng đời xô đẩy cái là, anh bóp cò luôn, hổng có chần chừ chi hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257554
    m_Localized: 'Raskolnikov: Đang tận thế từa lưa ra, giết vài ba mạng thì trách chi mình được? N-Như kiểu hổng ai lại xông vô đường đua để bắt người bắn tốc độ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257553
    m_Localized: 'Raskolnikov: Tại... chừ chỗ mô cũng nguy hiểm dễ sợ. Phải biết tự bảo vệ thân mình chớ, anh hen. A-Ai mà lộn xộn là bắn liền.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257552
    m_Localized: 'Raskolnikov: Úi... Xin lỗi anh. Em hổng có ý tọc mạch chi mô...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257551
    m_Localized: Ừ có
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257550
    m_Localized: Cậu muốn biết để làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257549
    m_Localized: 'Raskolnikov: Ừm, cho em hỏi xíu, anh có súng hông ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257548
    m_Localized: 'Raskolnikov: Dạ, em chào anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257547
    m_Localized: 'Wifefema: Thôi. Tiên sư con mẹ mày. Tao sang nhà hàng xóm mày nhờ cho xong.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257546
    m_Localized: 'Wifefema: ...  '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257545
    m_Localized: 'Wifefema: Đầu óc mày có bị làm sao không? Tao tốn nước bọt kể lể bao nhiêu mà mày gạt mẹ hết đi thế à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257544
    m_Localized: 'Wifefema: Đùa chắc? Ông xã tao làm bên Phòng Chống đấy con ơi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257543
    m_Localized: 'Wifefema: Giời ơi là giời! Mày tưởng tao là Dị Khách á!? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257542
    m_Localized: 'Wifefema: Ơ... Thế là thế nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257541
    m_Localized: 'Wifefema: Cho cái lũ dị hợm chầu trời hết thì mình mới quay về cuộc sống bình thường, tử tế như trước kia được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257540
    m_Localized: 'Wifefema: Đấy, như thế mới phải chứ! '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257539
    m_Localized: 'Thôi chị đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257538
    m_Localized: 'Chị vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257537
    m_Localized: 'Wifefema: Cái gì mà "Phòng Chống Thảm Họa không tuyển phụ nữ"! Rõ vớ vẩn!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257536
    m_Localized: 'Wifefema: Chị mày có kinh nghiệm làm cán bộ vùng biên hẳn hoi nhé. Đứa nào khả nghi là chị đánh hơi ra hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257535
    m_Localized: 'Wifefema: Rõ là bất công. Chỉ vì mình phận đàn bà con gái mà trình độ không bằng một góc ông chồng hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257534
    m_Localized: 'Wifefema: Biết cũng để làm gì đâu? Giờ chồng chị chuyển qua Phòng Chống rồi. Giá mà họ bỏ cái tư duy cổ lỗ sĩ ấy đi thì giờ chị cũng trong hàng ngũ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257533
    m_Localized: 'Wifefema: Chị không nói đấy. Chú mày hỏi làm gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257532
    m_Localized: 'Thôi chị đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257531
    m_Localized: 'Chị vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257530
    m_Localized: 'Wifefema: Chị đã tóm được không biết bao nhiêu loại cặn bã xã hội rồi, từ A đến Z luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257529
    m_Localized: 'Wifefema: Ngày xưa chị làm hải quan đấy chú mày ạ. Bảo vệ vùng biên giới nước mình đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257528
    m_Localized: 'Wifefema: Chán thế chứ lị. Chị với ông xã đồng vợ đồng chồng thì Dị Khách lên giời xuống biển cũng chả thoát được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257527
    m_Localized: 'Wifefema: Chỉ biết ước thôi chú ạ. Cơ mà người ta không tuyển phụ nữ. Chịu thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257526
    m_Localized: Vậy trước đó ảnh làm công việc gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257525
    m_Localized: Chị cũng làm bên Thảm Họa à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257524
    m_Localized: 'Wifefema: Thế mà nó chém giá cắt cổ, bay sạch túi tiền của chị.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257523
    m_Localized: 'Wifefema: Tại muốn cho lão một phen bất ngờ nên chị mới bắt taxi lên thăm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257522
    m_Localized: 'Wifefema: Nghe tin lão được chuyển công tác qua đó mà chị sốc muốn xỉu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257521
    m_Localized: 'Wifefema: Ấy, để chị kể cho mà nghe! Chồng chị đang làm ở bên Phòng Chống Thảm Họa đấy nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257520
    m_Localized: Vậy trước đó ảnh làm công việc gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257519
    m_Localized: Chị cũng làm bên Thảm Họa à?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257518
    m_Localized: 'Wifefema: Ông xã nhà chị làm bên Phòng Chống Thảm Họa, lão mà tóm được thằng chả... là lão đấm cho nó răng đi lợi ở lại luôn ấy chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257517
    m_Localized: 'Wifefema: Cơ mà nhá, bộ hàm của thằng tài xế nó trắng như vôi luôn ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257516
    m_Localized: 'Wifefema: Dốc cả núi tiền mới trả đủ. Dạo này chi phí đi lại đắt đỏ chết đi được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257515
    m_Localized: 'Wifefema: Cách nào ấy hả? Chị bắt taxi chứ sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257514
    m_Localized: 'Chồng chị làm nghề gì? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257513
    m_Localized: 'Chị tới đây bằng cách nào vậy? '
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257512
    m_Localized: 'Wifefema: Ai dè trong lúc lão đi làm thì chị cũng chả có chỗ nào mà ở.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257511
    m_Localized: 'Wifefema: Định lên không báo trước, cho lão một phen bất ngờ chơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257510
    m_Localized: 'Wifefema: Chị lên đây thăm ông chồng mới chuyển công tác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257509
    m_Localized: 'Wifefema: Chú mày ơi. Cho chị vào trú nhờ cái nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257508
    m_Localized: 'Theorist: Thôi bỏ đi. Tôi tin tưởng chú như thế... mà chú lại nỡ phụ lòng. Làm tôi thất vọng sâu sắc về loài người.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257507
    m_Localized: 'Theorist: Người dân có quyền được biết sự thật chứ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257506
    m_Localized: 'Theorist: Chú làm như vậy là quá sai lầm!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257505
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257504
    m_Localized: 'Theorist: Chú cứ tin tôi, tai tôi nghe, mắt tôi thấy hết rồi! Mấy thông tin bọn nó ra rả lâu nay là bịa đặt hết!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257503
    m_Localized: 'Theorist: Đấy, tôi biết chú tín mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257502
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257501
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257500
    m_Localized: 'Theorist: Thế nên tôi đã ngẩng cao đầu, hiên ngang bước ra khỏi viện nghiên cứu... và cầm theo những thông tin vô giá trong tay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257499
    m_Localized: 'Theorist: Chỉ cần nút bịt tai thôi. Là sẽ ngăn được lũ ký sinh trùng chui vào não. Biết sớm thì đã cứu được hàng nghìn mạng người rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257498
    m_Localized: 'Theorist: Thế mà bọn ngu đó chẳng thèm coi phát kiến của tôi ra gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257497
    m_Localized: 'Theorist: Tôi đưa ra nhận định rằng mối nguy thật sự không phải bọn Dị Khách, mà là... lũ ký sinh trùng bên trong não chúng cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257496
    m_Localized: 'Theorist: Tôi từng làm ở viện nghiên cứu. Bị đuổi việc vì những phát hiện long trời lở đất của mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257495
    m_Localized: 'Theorist: Nhưng chú phải hứa không được tiết lộ cho ai hết, rõ chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257494
    m_Localized: 'Theorist: Thấy chú có vẻ thật tình, đáng tin đấy. Ô kê luôn, để tôi kể chú nghe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257493
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257492
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257491
    m_Localized: 'Theorist: Sự thật đằng sau mấy món pate nổi tiếng nữa! Chắc gì đã là thịt heo chính hiệu! Láo hết, ngụy khoa học hết!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257490
    m_Localized: 'Theorist: Chính phủ đầu độc, tẩy não người dân bằng đồ ăn nhanh nữa này. Tin chuẩn trăm phần trăm nhá chú. Và thêm một tin sét đánh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257489
    m_Localized: 'Theorist: Gian lận bầu cử này. Bằng chứng con người đặt chân lên mặt trăng là giả này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257488
    m_Localized: 'Theorist: Cứ chuẩn bị tinh thần đi. Đảm bảo toàn tin cực sốc, cả nước sẽ ngã ngửa khi biết tin này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257487
    m_Localized: Anh lấy đâu ra mấy thông tin này thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257486
    m_Localized: Anh đang nói gì tôi không hiểu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257485
    m_Localized: 'Theorist: Vậy tức là... tôi có thể thoải mái bật mí cho chú nghe nhiều bí mật động trời.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257484
    m_Localized: 'Theorist: Chú bảo mình không liên quan gì, chứng tỏ là nói thật nhỉ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257483
    m_Localized: 'Theorist: Theo quy định của Phòng Chống Thảm Họa, cán bộ phải nêu rõ mình là nhân viên của tổ chức nếu dân hỏi. Bắt buộc mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257482
    m_Localized: 'Theorist: Được, tốt lắm. Vậy thì tin chú rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257481
    m_Localized: Anh lấy đâu ra mấy thông tin này thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257480
    m_Localized: Bí mật kiểu gì cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257479
    m_Localized: 'Theorist: Phải nói là hàng nghìn tấn bí mật quốc gia luôn. Tôi định sẽ công khai hết cho bàn dân thiên hạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257478
    m_Localized: 'Theorist: Trên tay tôi toàn giấy tờ ghi chép dữ kiện rất chi là nhạy cảm đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257477
    m_Localized: 'Theorist: Tôi đang cần chỗ an toàn để trú ẩn, sẵn tiếp tục nghiên cứu luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257476
    m_Localized: 'Theorist: Tin là chú không tuồn thông tin mật của tôi ra ngoài chứ sao nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257475
    m_Localized: Tôi không liên quan gì đến họ
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257474
    m_Localized: Tin tôi chuyện gì cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257473
    m_Localized: 'Theorist: Chú không phải người của bên Phòng Chống Thảm Họa đâu, đúng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257472
    m_Localized: 'Theorist: Chào chú nha. Ê mà... tôi tin chú được không đấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861319
    m_Localized: 'Firefighter: Đây, đằng nào anh cũng không cần. Chú muốn giữ hay làm gì thì tùy chú.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861318
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861317
    m_Localized: 'Firefighter: Cái này là lệnh triệu tập vào khu cách ly của bên Phòng Chống Thảm Họa. Có ai đi mà đã về chưa, đi làm đếch gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861316
    m_Localized: 'Firefighter: Mấy thằng sếp phát cho bọn anh tờ giấy này trước khi ra ngoài làm nhiệm vụ.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861315
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861314
    m_Localized: 'Firefighter: Ít nhất thì anh cũng không phải chết bờ, chết bụi một mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861313
    m_Localized: 'Firefighter: Anh không tính phiền đến chú lâu đâu. *khụ*'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861312
    m_Localized: 'Firefighter: Cảm ơn chú nhé. *khụ*'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297600
    m_Localized: 'Super: Chẳng ai biết chuyện gì đã xảy ra sau sự xuất hiện của tên Dị Khách cuối cùng.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297601
    m_Localized: 'Super: Căn nhà bị bỏ trống suốt một thời gian dài.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297602
    m_Localized: 'Super: Sau khi bạn đột nhiên biến mất, căn nhà hóa thành nhà hoang, không một ai dám bén mảng lại gần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646115
    m_Localized: Hai anh chị làm gì mà mỏi mệt thế?
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891678
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280257
    m_Localized: 'Fanatic: Bóng tối u ám của y che lấp hoàn toàn hào quang chính đạo! Mi phải tống y ra đường! Đuổi cổ ngay kẻ tà đạo!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417792
    m_Localized: 'Unstable: Ô! Có người à. Ngon luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417793
    m_Localized: 'Unstable: Tôi đang phê tới tận nóc luôn bác ạ. Mà dạo này Enerjeka nó không có dính dính sao ấy. Chắc tôi phải nạp thêm miếng nữa quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417794
    m_Localized: Cậu đi đâu mà xách cả cái máy bơm theo thế?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417795
    m_Localized: Tôi không có đồ nghề gì cho cậu sạc đâu
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417796
    m_Localized: 'Unstable: Đi tới nơi nào xa thật xa ý. Không thể ở mãi một chỗ được.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417797
    m_Localized: 'Unstable: Một cơn bão đang ùn ùn kéo đến. Tôi tò mò muốn xem người ta đón bão thế nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417798
    m_Localized: 'Unstable: Tôi sẽ đi mãi đến khi cháy thành than thì thôi. Hoặc bị lũ Dị Khách ăn tươi nuốt sống. Cái nào tới trước thì tới.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417799
    m_Localized: Cậu không định tìm chỗ an toàn mà trú à?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417800
    m_Localized: Không thể trốn chạy vấn đề mãi đâu
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417801
    m_Localized: 'Unstable: Ôi dào, cần gì hở bác. Tôi có bạn chí cốt Enerjeka đây rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417802
    m_Localized: 'Unstable: Tôi trữ được cả ĐỐNG luôn ấy. Còn cất ở đâu là bí mật quân sự nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417803
    m_Localized: 'Unstable: Tôi đợi đêm đến mới di chuyển. Tới khi mặt trời mọc thì tôi đã yên vị trong nhà rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417804
    m_Localized: Cậu không định tìm chỗ an toàn mà trú à?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417805
    m_Localized: Không thể trốn chạy vấn đề mãi đâu
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417806
    m_Localized: 'Unstable: Bác hỏi gì lạ vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417807
    m_Localized: 'Unstable: Càng đi xa, tôi mới càng có cơ hội tìm được chìa khóa giải quyết vấn đề chứ. Bác không hiểu à?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417808
    m_Localized: 'Unstable: Nhỡ đâu trong nhà bác có ẩn chứa hy vọng cuối cùng của nhân loại thì sao? Ai biết được.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417809
    m_Localized: 'Unstable: Chứ tôi mà cứ ở lì trong căn hộ thì muôn đời cũng chẳng biết được.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417810
    m_Localized: 'Unstable: Chỉ có chết một đống ở đó thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417811
    m_Localized: 'Unstable: Chết trong cô độc.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417812
    m_Localized: 'Unstable: Nên là miễn đi nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417813
    m_Localized: Rồi sao nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417814
    m_Localized: Cậu đang trốn chạy điều gì à?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417815
    m_Localized: 'Unstable: Còn bác thì kẹt dí ở đây. Bác tưởng bốn bức tường này là đủ bảo vệ bác à?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417816
    m_Localized: 'Unstable: Ừ thì công nhận bác còn sống đó. Còn đứng đây... nói chuyện được với tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417817
    m_Localized: 'Unstable: Nhưng mà tôi cũng sống nhăn răng nè! Xem chừng tôi với bác đều có ý hay đó chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417818
    m_Localized: 'Unstable: Chi bằng hai đứa mình chia sẻ bí kíp sinh tồn, cũng hợp lý phết he.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417819
    m_Localized: Rồi sao nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417820
    m_Localized: Cậu đang trốn chạy ai đó à?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417821
    m_Localized: 'Unstable: Rồi tôi bỏ chạy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417822
    m_Localized: 'Unstable: Tôi cứ chạy mãi, tới khi nào tìm được thứ mình cần... dù đó là gì đi nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417823
    m_Localized: 'Unstable: Nhưng chỗ bác trông cũng thú vị phết.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417824
    m_Localized: 'Unstable: Bác cho tôi vào được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417825
    m_Localized: Cậu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417826
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417827
    m_Localized: 'Unstable: Tôi nói nãy giờ mà bác không chịu nghe gì hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417828
    m_Localized: 'Unstable: Bảo rồi, tôi chỉ đang quan sát cách người ta sinh tồn như nào thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417829
    m_Localized: 'Unstable: Cũng thấy được vài chỗ thú vị đó, nhưng đa số đều y như nhau, chả khác gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417830
    m_Localized: 'Unstable: Ai ai cũng hoảng hết cả lên, một là không thèm mở cửa, hai là thấy thứ gì ngọ nguậy thì bắn bỏ luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417831
    m_Localized: 'Unstable: Chiến lược này cũng chẳng khôn ngoan sáng suốt cho lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417832
    m_Localized: 'Unstable: Mà thôi. Đứng trước cửa nhà bác miết cũng mệt rồi. Bác cho tôi vào đi, rồi tôi kể tiếp cho. Kể hết những gì tôi thấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417833
    m_Localized: Cậu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417834
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417835
    m_Localized: 'Unstable: Ngon lành cành đào!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417836
    m_Localized: 'Unstable: Vậy giờ chốt kèo thì bác kể cho tôi mọi chuyện quanh đây nhá?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417837
    m_Localized: 'Unstable: Để tôi góp lúa thêm cho. Gì chứ chuyện kể thì tôi không thiếu. Anh em mình cùng hàn huyên tâm sự.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417838
    m_Localized: 'Unstable: Uầy, chán nhể. Xí khoan, tôi có mang cả đống đồ theo này.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417839
    m_Localized: 'Unstable: Có lon Enerjeka này, bác lấy không? Tôi còn nhiều thứ hay ho nữa lắm!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417840
    m_Localized: 'Unstable: Hay là... đợi tôi tí.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417841
    m_Localized: 'Unstable: Đây, {0} nè. Nếu bác không chê...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417842
    m_Localized: Thôi được rồi, cậu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417843
    m_Localized: Tôi không nhận hối lộ đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417844
    m_Localized: 'Unstable: Uầy, {0} đang ở với bác à?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417845
    m_Localized: 'Unstable: Tôi không thích nói nhiều kế bên mấy người vậy đâu. Họ có cái tật hay vẽ chuyện lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417846
    m_Localized: 'Unstable: Hư bột hư đường hết. Thôi, xin kiếu bác ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417847
    m_Localized: "Để tôi đuổi ra cho. \nCậu vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417848
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417849
    m_Localized: 'Unstable: Há há há tôi bịp á, có biết đấy là ai đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417850
    m_Localized: 'Unstable: Đùa tí cho vui bác ạ. Hài vãi. Xin lỗi bác nhớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417851
    m_Localized: 'Unstable: Thôi bác đừng buồn, để tôi kể cho nghe đủ thứ chuyện trên đời!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417852
    m_Localized: 'Unstable: À thôi không sao, để tôi ghé thử mấy chỗ khác cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417853
    m_Localized: 'Unstable: Nghe đâu có anh giai bày trò đi bán không khí nữa. Chơi nổi thật chớ!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417854
    m_Localized: 'Unstable: Không biết chém gió thế thì lừa người ta được bao nhiêu đồng.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417855
    m_Localized: 'Unstable: Thôi nhá, tôi té đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417856
    m_Localized: 'Unstable: Chán vờ lờ. Lại một kịch bản cũ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417857
    m_Localized: 'Unstable: Thôi vậy. Để tôi thử ghé mấy chỗ khác xem sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417858
    m_Localized: 'Unstable: Nghe đâu có ông nhõi nào tụ tập cả đống người lại rồi tẩy não.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417859
    m_Localized: 'Unstable: Xong còn treo họ lên giàn hỏa thiêu luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417860
    m_Localized: 'Unstable: Phải trải nghiệm thử mới được. Nghe độc lạ phết.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417861
    m_Localized: 'Rocker: Lô anh bạn, mở cửa đê. Mặt trời chiếu gắt như đèn sân khấu ấy. Đứng lâu thêm tí nữa là tôi thành mù dở luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417862
    m_Localized: 'Rocker: Cho tôi ké chỗ ngả lưng mấy đêm thôi. Yên tâm là tôi không ám nhà anh bạn mãi đâu. Tôi đâu phải cái ngữ... ờ... gọi là gì ấy nhỉ? '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417863
    m_Localized: 'Rocker: À, dân ăn nhờ ở đậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417864
    m_Localized: 'Rocker: Ngoài kia đang loạn cào cào cả lên, vỡ trận như thể ai mời sao hạng A về diễn ở hội chợ ấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417865
    m_Localized: 'Anh có mang đồ gì theo không? '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417866
    m_Localized: 'Sao trông anh như cả tuần không ngủ thế? '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417867
    m_Localized: 'Rocker: Không có hàng cấm đâu bạn ơi. Chỉ có cái âm ly cỡ nhỏ với mấy chai nước lọc thôi. Anh bạn mà biết shred thì tôi cho mượn luôn. '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417868
    m_Localized: 'Rocker: Nghe đồn người ta mới tìm thấy một tên Dị Khách lảng vảng gần đây. Nên giờ soát gắt lắm. Tôi thì vô tư, miễn đừng ai hoảng lên là được.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417869
    m_Localized: 'Anh vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417870
    m_Localized: 'Thôi anh đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417871
    m_Localized: 'Rocker: Thì đúng là tôi có ngủ đâu. '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417872
    m_Localized: 'Rocker: Vừa diễn xong một set xuyên đêm, thì có mấy thằng ngáo ngơ ở đâu xông vào chỗ bọn tôi rồi bắt đầu hôi của.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417873
    m_Localized: 'Rocker: Chúng nó còn đập vỡ cả cây đàn của tôi, bố tiên sư. Cái thời buổi loạn lạc này biến con người ta thành súc vật hết rồi bạn à...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417874
    m_Localized: 'Rocker: Này nhé, tôi mà là Dị Khách thì tôi đã phá cửa chính hoặc trèo vào qua cửa sổ rồi. Nhưng rõ là không phải, nên tôi đứng đây thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417875
    m_Localized: 'Anh vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417876
    m_Localized: 'Thôi anh đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417877
    m_Localized: 'Rocker: Cảm ơn nhé anh bạn. Thi thoảng tôi sẽ bật tí nhạc cho nó có không khí. Nếu có thêm cây đàn thì tôi chơi cho bạn nghe mấy bài cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417878
    m_Localized: 'Rocker: ...Không chơi cũng chả sao! Tùy ý anh bạn đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417879
    m_Localized: 'Rocker: ... '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417880
    m_Localized: 'Rocker: Hiểu rồi người anh em. Tôi không để bụng đâu. '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417881
    m_Localized: 'Rocker: Chắc tôi sẽ qua nhà thằng bạn trú tạm vậy. Chỉ biết mong đám còn lại vẫn chưa hẹo...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417882
    m_Localized: 'Rocker: Ê thôi đéo nhé, tôi không muốn ở chung phòng với loại kia đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417883
    m_Localized: 'Rocker: Ừ, {0}... chính nó. Anh bạn xem thế nào thì hộ tôi cái được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417884
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi "
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417885
    m_Localized: 'Thôi anh đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417886
    m_Localized: 'Rocker: Ngon luôn, cháy lên nào bạn ơi! '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417887
    m_Localized: 'Rocker: Nhưng cháy mà không có đàn thì... hơi sầu nhỉ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417888
    m_Localized: 'Rocker: Thôi dẹp mẹ đi. '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417889
    m_Localized: 'Rocker: Anh bạn không cho tôi vào thì người khác cho, sao phải xoắn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417890
    m_Localized: 'Experienced: Ê cu, cho tao vô ở ké được hông mậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417891
    m_Localized: Sao ông mặc mỗi quần lót lông nhông ngoài đường thế này?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417892
    m_Localized: Ông từ đâu chui ra vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417893
    m_Localized: 'Experienced: Thèng này, mày hỏi ba xàm dị. Ngoài trời đang nóng như cái lò thiêu. Chả hiểu sao tụi kia còn ngơ ngơ ngác ngác.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417894
    m_Localized: 'Experienced: Mé nó tỉnh bơ luôn mậy, đi đi lại lại như kiểu tuyết rơi đầy đường hổng bằng. Đúng cái đám khùng điên ba trợn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417895
    m_Localized: 'Experienced: Nó làm gì trải đời được như tao. Mới ra khỏi cửa tù là tao thoát xác, cởi hết áo quần giục qua một xó. Dễ thở hơn hẳn mày ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417896
    m_Localized: Ông làm quái gì ở chỗ nhà tôi vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417897
    m_Localized: Sao ông không ở yên trong tù đi?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417898
    m_Localized: 'Experienced: Ở trỏng tao vẫn chăm chỉ tập tành, giãn gân giãn cốt đó mày ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417899
    m_Localized: 'Experienced: Còn tính ở lâu hơn xíu nữa, mà tụi nó đá tao ra ngoài thẳng cẳng.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417900
    m_Localized: 'Experienced: Xong giờ thế giới loạn lên như cào cào. Bà cha nó nóng như lửa đốt, thiếu điều muốn chiên ngập dầu hai hòn dái tao.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417901
    m_Localized: 'Experienced: Dị là thôi tao lại lang thang ngoài đường.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417902
    m_Localized: Ông làm quái gì ở chỗ nhà tôi vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417903
    m_Localized: Sao ông không ở yên trong tù đi?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417904
    m_Localized: 'Experienced: Ê cu, giờ tao còn chỗ nào mà ở đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417905
    m_Localized: 'Experienced: Nghèo rớt mồng tơi, nghèo rơi nước mắt. Con vợ thì dan dan díu díu với thèng chó nào. Còn tao thì chả có chốn nương thân.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417906
    m_Localized: 'Experienced: Cái tình cờ tao bắt gặp chỗ nhà mày. Sạch sẽ mà còn yên tĩnh, ở hóc bà tó.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417907
    m_Localized: 'Experienced: Chốn khỉ ho cò gáy này được cái hổng có đứa quỷ ma nào rình mò. Đúng vị trí đắc địa luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417908
    m_Localized: 'Experienced: Thôi ba láp ba xàm dị đủ rồi. Cho tao vô ăn nằm mấy bữa được hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417909
    m_Localized: Ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417910
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417911
    m_Localized: 'Experienced: Trời tao cũng muốn ở lắm chớ. Nhưng có đứa nào thèm hỏi ý tao đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417912
    m_Localized: 'Experienced: Đồng hồ chỉ đúng giờ là tụi nó đá tao ra khỏi cửa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417913
    m_Localized: 'Experienced: Nghèo rớt mồng tơi, nghèo rơi nước mắt. Con vợ thì dan dan díu díu với thèng chó nào. Còn tao thì chả có chốn nương thân.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417914
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417915
    m_Localized: 'Experienced: Thôi ba láp ba xàm dị đủ rồi. Cho tao vô ăn nằm mấy bữa được hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417916
    m_Localized: Ông vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417917
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417918
    m_Localized: 'Experienced: Mày được. Dị là biết khôn đó cu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417919
    m_Localized: 'Experienced: Chèng ơi, chán mày thiệt chớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417920
    m_Localized: 'Experienced: Thôi chào, mé thèng mắc dịch.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417921
    m_Localized: 'Experienced: Ê cu. Sao mày lại đi chứa chấp thứ âm binh kia hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417922
    m_Localized: 'Experienced: Đó, tao nói {0} kia kìa. Cái loại như nó quê tao đầy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417923
    m_Localized: "Để tôi đuổi ra cho. \nÔng vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417924
    m_Localized: Thôi ông đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417925
    m_Localized: 'Experienced: Mày được. Dị là biết khôn đó cu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417926
    m_Localized: 'Jacket: Chào anh ạ. Anh cho em vào được không? '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417927
    m_Localized: 'Cậu cần gì đây? '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417928
    m_Localized: 'Muốn tìm chỗ trú à? '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417929
    m_Localized: 'Jacket: Dạ, em đang tìm nơi tá túc. Giờ em không còn chỗ nào để đi nữa rồi. '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417930
    m_Localized: 'Jacket: Cũng không thể về ký túc xá được nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417931
    m_Localized: Sao lại thế?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417932
    m_Localized: Chỗ ký túc xá của cậu bị gì à?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417933
    m_Localized: 'Jacket: Dạ vâng. Em năn nỉ anh… Có gì cho em vào với. '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417934
    m_Localized: 'Jacket: Hồi trước em còn ở ký túc xá đại học, nhưng giờ thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417935
    m_Localized: Sao lại thế?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417936
    m_Localized: Chỗ ký túc xá của cậu bị gì à?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417937
    m_Localized: 'Jacket: Bên cán bộ Phòng Chống Thảm Họa tới…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417938
    m_Localized: 'Jacket: Họ ra lệnh mọi người tụ tập lại… Mà em thì… '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417939
    m_Localized: 'Jacket: ... '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417940
    m_Localized: 'Jacket: Em không muốn bị bắt đi cách ly đâu. Sợ lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417941
    m_Localized: Cậu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417942
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417943
    m_Localized: 'Jacket: Bên cán bộ Phòng Chống Thảm Họa…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417944
    m_Localized: 'Jacket: Bỗng một ngày họ tự dưng xuất hiện. Nói là muốn kiểm tra tất cả mọi người.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417945
    m_Localized: 'Jacket: Em nghe nói những ai nhiễm bệnh sẽ bị đưa tới khu cách ly… '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417946
    m_Localized: 'Jacket: ... '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417947
    m_Localized: 'Jacket: Em không muốn bị bắt vào đó đâu. Sợ lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417948
    m_Localized: Cậu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417949
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417950
    m_Localized: 'Jacket: Cảm ơn anh nhiều lắm. '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417951
    m_Localized: 'Jacket: À đây, em có {0} này. Cũng không nhiều nhặn gì, nhưng mong anh nhận cho.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417952
    m_Localized: 'Jacket: Năn nỉ anh đó… Cho em vào đi mà. '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417953
    m_Localized: 'Jacket: Em không muốn đụng phải mấy cán bộ đi tuần đâu. Hay lỡ gặp Dị Khách thì còn chết nữa. '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417954
    m_Localized: 'Jacket: Nếu anh không chê, em có {0} này. Như vậy là đủ để anh đổi ý chưa ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417955
    m_Localized: 'Thôi được rồi, cậu vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417956
    m_Localized: Tôi không nhận hối lộ đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417957
    m_Localized: 'Jacket: Ấy, hình như trong nhà đang có {0} kìa... Em không tin được mấy người như vậy đâu... '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417958
    m_Localized: "Để tôi đuổi ra cho. \nCậu vào đi "
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417959
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417960
    m_Localized: 'Jacket: Cảm ơn anh nhiều lắm. '
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417961
    m_Localized: 'Jacket: À đây, em có {0} này. Cũng không nhiều nhặn gì, nhưng mong anh nhận cho.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346842873856
    m_Localized: 'Tough: Chị có nghe đồn về mày rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039680
    m_Localized: 'Tough: Hầu như hông ai dám lại gần khu nhà mày hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039681
    m_Localized: 'Tough: Người ta nói kẻ nào đường cùng lắm... hoặc ngu dại lắm mới tìm tới đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039682
    m_Localized: 'Tough: Nhưng chị là chị nể mày đó. '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039683
    m_Localized: 'Ờm... Cảm ơn nhé? '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039684
    m_Localized: Hả... Người ta đồn CÁI GÌ về nhà tôi cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039685
    m_Localized: 'Tough: Chị nói thiệt tình mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039686
    m_Localized: 'Tough: Dân tình bỏ cuộc hết cả đám rồi. Yếu đuối quá thì sao mà sống nổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039687
    m_Localized: 'Tough: Đứa nào gan hơn còn biết chĩa súng vô đầu một phát. Đám còn lại thì chết dần chết mòn đi từng ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039688
    m_Localized: 'Tough: Nhưng riêng mày thì khác. Mày đâu dễ chết như vậy, cứ phải vùng vẫy đấu tranh tới cùng.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039689
    m_Localized: Chị cũng đang đường cùng lắm à?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039690
    m_Localized: Chị nói như bị thần kinh ấy
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039691
    m_Localized: 'Tough: Họ nói là đâu dễ gì mà sống được ở đây. '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039692
    m_Localized: 'Tough: Nghe đâu mày phải cứng với tụi Dị Khách lắm. Mày không để nó cướp đoạt tài sản quý giá nhất của mình: sinh mạng.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039693
    m_Localized: 'Tough: Thì chị làm sao mà bỏ qua được. Coi bộ chị với mày là dân cùng hội cùng thuyền, dễ bề thấu hiểu nhau đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039694
    m_Localized: 'Tough: Hai chị em mình đều quyết chí sinh tồn, bằng bất cứ giá nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039695
    m_Localized: Chị cũng đang đường cùng lắm à?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039696
    m_Localized: Chị nói như bị thần kinh ấy
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039697
    m_Localized: 'Tough: Hả sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039698
    m_Localized: 'Tough: À, ý mày muốn hỏi lý do chị tới đây á? Hờ. Ai biết được. Chắc chị điên mợ nó rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039699
    m_Localized: 'Tough: Nhưng đảm bảo với mày, chị chưa tới mức đường cùng đâu. '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039700
    m_Localized: 'Tough: Nhân loại trước giờ đã sống qua biết bao tai họa mà. Đến nước này rồi, sao mình phải bỏ cuộc?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039701
    m_Localized: 'Chị vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039702
    m_Localized: 'Thôi chị đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039703
    m_Localized: 'Tough: À. Nếu chị có gây hiểu lầm thì chị xin lỗi nhá. '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039704
    m_Localized: 'Tough: Tại chị nghĩ là nếu cứ nằm im an phận như vậy thì loài người coi như chấm hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039705
    m_Localized: 'Tough: Còn vực dậy, còn đánh trả thì ta mới tồn tại được.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039706
    m_Localized: 'Tough: Đời có bao giờ thuận buồm xuôi gió đâu. Muốn sống thì phải chống chọi với bão bùng.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039707
    m_Localized: 'Chị vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039708
    m_Localized: 'Thôi chị đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039709
    m_Localized: 'Tough: Ngon! '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039710
    m_Localized: 'Tough: Thực sự chị thấy mình may mắn lắm. May vì được ở đây, giữa lúc cuộc đời đổ vỡ như vầy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039711
    m_Localized: 'Tough: Chị vô rồi mình nói chuyện thêm ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039712
    m_Localized: 'Tough: Mày đang thử chị đấy à? '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039713
    m_Localized: 'Tough: … '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039714
    m_Localized: 'Tough: Không phải sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039715
    m_Localized: 'Tough: Hờ, từ đầu chị cũng chả trông mong gì. '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039716
    m_Localized: 'Tough: Nhớ mặt mày đấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039717
    m_Localized: 'Tough: ...Thằng chó đẻ.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039718
    m_Localized: 'Bald: Nè, anh ơi!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039719
    m_Localized: 'Bald: Cho tui ở tạm vài bữa nghen? Rầu quá, mấy đứa bạn tui một là không có nhà, hai là bị đá ra đường, còn ba thì biến đi đâu mất tiêu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039720
    m_Localized: 'Bald: Vậy mà tui cứ tưởng mình là bạn chí cốt của tụi nó. Anh em có họa cùng chia, vậy mà giờ... mạnh ai nấy lo. Để tui một mình vậy đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039721
    m_Localized: 'Bald: Hồi đó tui ở với má với bà, mà sau đó thì cả nhà bị đá ra đường. Đám đòi nợ nó tới siết nhà... Khổ lắm anh ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039722
    m_Localized: Bạn bè kiểu gì mà lạ thế?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039723
    m_Localized: Vậy là giờ anh đang bị một lũ côn đồ đuổi theo à?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039724
    m_Localized: 'Bald: Đám đồng môn chung đoàn kịch của tui đó. Tụi tui vẫn hay nhậu nhẹt, làm trò con bò, giúp đỡ nương tựa lẫn nhau.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039725
    m_Localized: 'Bald: Tụi nó tốt bụng dữ lắm. Hễ anh em gặp chuyện là có mặt. Gọi cái là sẵn sàng làm ly bia, ngồi chơi tâm sự.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039726
    m_Localized: 'Bald: Mà giờ… tui hổng gọi được cho đứa nào hết. Chắc ai cũng lu bu, nhiều chuyện phải lo quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039727
    m_Localized: 'Bald: Rồi còn cái vụ mặt trời quỷ quái này nữa. Điên hết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039728
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039729
    m_Localized: 'Thôi anh đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039730
    m_Localized: 'Bald: Không phải, tụi nó hông đòi nợ tui.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039731
    m_Localized: 'Bald: Mà nó dí má tui á.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039732
    m_Localized: 'Bald: Tui biết má chỉ muốn bảo vệ tui thôi. Bởi vậy má mới giữ miết trong lòng, không kể gì tui biết.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039733
    m_Localized: 'Bald: Tui hứa không làm phiền anh đâu. Cho tui ở nhờ đi mà… Đi, tui kể hết cho.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039734
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039735
    m_Localized: 'Thôi anh đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039736
    m_Localized: 'Bald: Trời ơi, anh đúng là cứu nhơn độ thế.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039737
    m_Localized: 'Bald: Tui biết nhiều câu chuyện ác đạn lắm. Lát hồi có gì tui kể cho. Đảm bảo nghe xong hết hồn!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039738
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039739
    m_Localized: 'Bald: Thôi không sao, tui hiểu mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039740
    m_Localized: 'Bald: Giữ sức khỏe nghen. Chúc anh sống qua được cái thảm kịch khùng điên này.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039741
    m_Localized: 'Nervous: Chào đằng ấy. Hí hí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039742
    m_Localized: 'Nervous: Xin lỗi nhé, tớ hơi bị ru...n.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039743
    m_Localized: 'Nervous: Tớ đang trọ ở Khách sạn Hy Vọng ý, buồn buồn đi dạo quanh đây tí thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039744
    m_Localized: 'Nervous: Nhưng tớ s...ợ phải về lắm, đằng ấy cho tớ ở nhờ nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039745
    m_Localized: Tại sao? Cứ thế mà về không được à?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039746
    m_Localized: Cậu nghĩ ở đây thì an toàn hơn hả?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039747
    m_Localized: 'Nervous: Tớ chẳng thích ở đấy đâu. Muốn tìm ch...ỗ khác cơ. '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039748
    m_Localized: 'Nervous: Có con bé mặc áo mưa vàng sống ở đó. '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039749
    m_Localized: 'Nervous: Tớ rén nó lắm, hí hí. '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039750
    m_Localized: 'Nervous: Tuy cũng không có căn cứ gì, không không... Nhưng mà tớ nghi nó là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039751
    m_Localized: 'Nervous: Bên Phòng Chống Thảm Họa tới kiểm tra, rồi họ đi luôn... đi mất dạng.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039752
    m_Localized: Sao không ở nhà bà con họ hàng đi?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039753
    m_Localized: 'Cậu không có bạn bè gì à? '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039754
    m_Localized: 'Nervous: Về đó cũng được. Nhưng ở đây tốt hơn nhiều. Hí hí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039755
    m_Localized: 'Nervous: Nhà đằng ấy rộng rãi thật đấy, già trẻ lớn bé gì cũng chứa được.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039756
    m_Localized: 'Nervous: Chẳng bù cho phòng khách sạn bé tẹo tèo teo. L...àm tớ nhớ đến... mấy chuyện không hay. '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039757
    m_Localized: 'Nervous: Để khi nào tớ kể cho đằng ấy... nghe nhé. Hí hí. '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039758
    m_Localized: Sao không ở nhà bà con họ hàng đi?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039759
    m_Localized: 'Cậu không có bạn bè gì à? '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039760
    m_Localized: 'Nervous: Tại tớ là "tai nạn" ngoài ý muố...n ấy mà. Á hự chơi chơi xíu mà tòi ra tớ luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039761
    m_Localized: 'Nervous: Ừ thì ông bà ý cũng giúp tớ được một lần, nhưng có phải thật lòng quan tâm gì đâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039762
    m_Localized: 'Nervous: Cho nênnnnn... tớ cũng chẳng thiết tha làm chi nữa! Hí hí!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039763
    m_Localized: 'Nervous: Tớ thà quay về khách sạn còn hơn. '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039764
    m_Localized: 'Cậu vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039765
    m_Localized: 'Thôi cậu đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039766
    m_Localized: 'Nervous: Bạn bè nào cơ? '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039767
    m_Localized: 'Nervous: Ai ai cũng lăm le hãm hại tớ thôi. Thằng nào con nào cũng vậy... từ hồi còn đi học cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039768
    m_Localized: 'Nervous: Một đứa đã phải trả gi...á đắt, mà giờ tớ cảnh giác hơn rồi. Hí hí! '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039769
    m_Localized: 'Nervous: Giờ tớ đang cố tìm cách... "bắt sóng" với những người bạn mới! '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039770
    m_Localized: 'Nervous: Tớ vừa nghe thấy tiếng súng nổ quanh khu này. Mà đằng ấy có vẻ cứng đó, chú ý giữ an ninh hơn hẳn. Phải không nàooo... ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039771
    m_Localized: 'Cậu vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039772
    m_Localized: 'Thôi cậu đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039773
    m_Localized: 'Nervous: May thế!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039774
    m_Localized: 'Nervous: Cuối cùng cũng có chỗ ngồi đợi cho đống thảm họa này qua đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039775
    m_Localized: 'Nervous: Ơ kìa... Đằng ấy cũng nghĩ tớ mát mátttt lắm đúng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039776
    m_Localized: 'Nervous: Ấm ớ chập chenggg rồi phải không? Đúng chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039777
    m_Localized: 'Nervous: Hóa ra đằng ấy cũng chẳng hơn gì cái bọn bấ...t nhân áo trắng kia.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039778
    m_Localized: 'Nervous: Gieo nhân nào gặt quả nấy thôi... Đằng ấy cứ nhớ đấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039779
    m_Localized: 'Nervous: Hí hí. '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039780
    m_Localized: 'Leper: Chào cậu. Ờm, trông tôi hơi gớm, nhưng cậu cho tôi vào có được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039781
    m_Localized: Có đáng lo không vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039782
    m_Localized: 'Da của anh bị làm sao thế? '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039783
    m_Localized: 'Leper: Không đâu! Cứ yên tâm, tôi không bị làm sao hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039784
    m_Localized: 'Leper: Chẳng qua da tôi bị như này từ lúc mới đẻ thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039785
    m_Localized: 'Leper: Người ta cứ coi tôi như mầm bệnh... thậm chí là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039786
    m_Localized: Thời buổi giờ ai cũng hoang mang mà
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039787
    m_Localized: Chứ anh còn muốn thế nào?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039788
    m_Localized: '... '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039789
    m_Localized: 'Leper: Đó, tôi biết mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039790
    m_Localized: 'Leper: Cái này tôi bị bẩm sinh, có muốn cũng đâu chữa được. Vậy mà người ta cứ nghi tôi là Dị Khách. Điên thật chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039791
    m_Localized: Thời buổi giờ ai cũng hoang mang mà
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039792
    m_Localized: Chứ anh còn muốn thế nào?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039793
    m_Localized: 'Leper: Tôi biết chứ, nhưng tôi đâu phải Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039794
    m_Localized: 'Để xem như nào đã '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039795
    m_Localized: Anh lấy gì mà chắc chắn thế?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039796
    m_Localized: 'Leper: "Muốn thế nào" là sao? Quá đáng vừa thôi chứ. Cậu tưởng tôi thích như này lắm chắc?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039797
    m_Localized: 'Leper: Đã bảo rồi, tôi không phải Dị Khách đâu mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039798
    m_Localized: 'Để xem như nào đã '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039799
    m_Localized: Anh lấy gì mà chắc chắn thế?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039800
    m_Localized: 'Leper: Thôi, cậu nói sao cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039801
    m_Localized: 'Leper: ... '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039802
    m_Localized: 'Leper: Vậy cậu có cho tôi vào hay không đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039803
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039804
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039805
    m_Localized: 'Leper: Tôi như nào thì tôi tự biết chứ. Tôi có phải bọn nó đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039806
    m_Localized: 'Leper: ... '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039807
    m_Localized: 'Leper: Vậy cậu có cho tôi vào hay không đây? '
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039808
    m_Localized: Anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039809
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039810
    m_Localized: 'Leper: Cảm ơn cậu... đã cho tôi vào. Mà không làm ầm lên về ngoại hình của tôi nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039811
    m_Localized: 'Leper: Rồi, tùy cậu thôi. Tôi đi đây. '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722816
    m_Localized: 'Fairytaller: Chào anh, không biết nhà mình còn chỗ ở không ạ? Em chỉ cần một góc nhỏ thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722817
    m_Localized: Sao cậu lại tới đây?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722818
    m_Localized: Có gì chứng minh được cậu là người không?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722819
    m_Localized: 'Fairytaller: Em là sinh viên mới ra trường. Mà ngành của em khó kiếm việc quá, nên em mới đi làm thêm ở quán cà phê nhỏ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722820
    m_Localized: 'Fairytaller: Rồi do tình hình khó khăn nên quán em chẳng có khách nữa. Thế là bọn em cũng hết việc luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722821
    m_Localized: 'Fairytaller: Coi bộ mấy người làm ở hộp đêm gặp may rồi. Từ hồi thảm họa đến giờ, em thấy mấy chỗ đó đông đúc hơn hẳn.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722822
    m_Localized: 'Fairytaller: Những lúc khó khăn như này, mọi người chỉ muốn quên hết mọi lo toan, tận hưởng niềm vui dù chỉ trong chốc lát.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722823
    m_Localized: 'Fairytaller: ...Như trở về tuổi thơ vậy đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722824
    m_Localized: 'Fairytaller: Chủ nhà của bọn em không muốn cho đám thất nghiệp mới ra trường thuê trọ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722825
    m_Localized: 'Fairytaller: Thế là sau khi thảm họa ập tới, ông ý đuổi cổ em ra ngoài, lấy lý do là em không có công việc ổn định.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722826
    m_Localized: 'Fairytaller: Xong rồi ông ấy lấy phòng em cho mấy người thân ở. Em chẳng trách người ta đâu, nhưng mong anh cũng hiểu cho hoàn cảnh của em.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722827
    m_Localized: 'Fairytaller: Em chẳng muốn ai phải phiền hà hay nặng gánh vì mình đâu. Khổ nỗi những lúc khó khăn thế này, mình phải làm mọi cách để sinh tồn.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722828
    m_Localized: 'Fairytaller: Xin anh cho em trú nhờ ạ. Em hứa, có gì giúp được thì em sẽ giúp. Sau này cuộc sống ổn định rồi, em sẽ quay về hậu tạ anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722829
    m_Localized: Cậu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722830
    m_Localized: Biến hộ. Tôi không cần mấy đứa ăn bám
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722831
    m_Localized: 'Fairytaller: Nói thật, em không rõ đám Dị Khách là ai, cũng chẳng biết nó khác con người mình ở điểm nào nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722832
    m_Localized: 'Fairytaller: Có khi em cũng sở hữu vài dấu hiệu mà không biết ấy chứ. Gần đây mọi chuyện cứ rối mù hết cả lên.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722833
    m_Localized: 'Fairytaller: Nhưng em tin em vẫn là chính mình, xưa giờ không đổi. Chí ít thì em chưa bao giờ có mong muốn làm hại ai hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722834
    m_Localized: 'Fairytaller: Em thấy cũng giống như mấy truyện cổ tích mình đọc hồi bé á. Những thế lực tà ác hoành hành khắp thế gian.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722835
    m_Localized: 'Fairytaller: Xong rồi ai ai cũng sợ hãi, tìm cách lẩn trốn, nghi kỵ lẫn nhau...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722836
    m_Localized: 'Fairytaller: Giá như có vị anh hùng hào hiệp xuất hiện, ra tay trừ gian diệt bạo, để thế giới được tươi đẹp lại như xưa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722837
    m_Localized: 'Fairytaller: Em chẳng dám nhận mình vào vai dũng sĩ cứu thế đâu. Nhưng trong mấy câu chuyện em đọc, chính nghĩa bao giờ cũng chiến thắng gian tà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722838
    m_Localized: Cậu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722839
    m_Localized: Biến hộ. Tôi không cần mấy đứa ăn bám
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722840
    m_Localized: 'Fairytaller: Dạ…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722841
    m_Localized: 'Fairytaller: Em biết là mình không có gì để đóng góp... nhưng xin anh hãy cho em một cơ hội.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722842
    m_Localized: 'Fairytaller: Em hứa sau này sẽ đền đáp ơn anh. Thậm chí bây giờ, em giúp được gì là giúp luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722843
    m_Localized: 'Fairytaller: Ôi, em đâu nghĩ là mới vào đời đã bị quật thế này... mà giờ em cũng không còn chỗ nào để đi nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722844
    m_Localized: Cậu vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722845
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722846
    m_Localized: 'Fairytaller: Cảm ơn anh nhiều lắm ạ! Ơn này cả đời em cũng không quên!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722847
    m_Localized: 'Fairytaller: Vậy là những người nhân hậu vẫn có thật ngoài đời, chứ không chỉ trong truyện kể. Em mừng quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722848
    m_Localized: 'Fairytaller: Dạ, em hiểu rồi. Chúc anh mạnh khỏe.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722849
    m_Localized: 'FunnyGuy: Hế lô, hế lô, chào cả nhà nha! '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722850
    m_Localized: 'FunnyGuy: Đêm nay thơ mộng quá nhể? Mày công nhận không? Đẹp diệu kỳ luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722851
    m_Localized: 'Bác bị dở người à? '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722852
    m_Localized: 'Sao bác vui vẻ thế? '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722853
    m_Localized: 'FunnyGuy: Ô, nói nghe đúng chán luôn. Thằng này chả biết cái gì. '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722854
    m_Localized: 'FunnyGuy: Mày... à không... Đồng chí ơi! Bác được xóa nợ rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722855
    m_Localized: 'FunnyGuy: Mới giải quyết được khoản vay thế chấp. Cuối cùng cũng được thở phào nhẹ nhõm. Sướng lắm chú mày ạ!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722856
    m_Localized: Thế... bác làm gì ở ngoài này vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722857
    m_Localized: Vậy chắc rủng rỉnh tiền lắm ha? Bác định sắm gì giờ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722858
    m_Localized: 'FunnyGuy: Ờ thì, lúc trước bác nợ đầm đìa, nợ như chúa chổm luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722859
    m_Localized: 'FunnyGuy: Mở mắt ra là thấy cuộc đời tăm tối lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722860
    m_Localized: 'FunnyGuy: NHƯNG MÀ GIỜ NHÁ!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722861
    m_Localized: 'FunnyGuy: Bố mày không nợ trời nợ đất cái gì nữa cả!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722862
    m_Localized: 'FunnyGuy: Thế giới loạn hết lên như này, ai mà thèm để ý mấy khoản vay ngân hàng nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722863
    m_Localized: 'FunnyGuy: Tuyệt vời ông mặt trời!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722864
    m_Localized: Thế... bác làm gì ở ngoài này vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722865
    m_Localized: Vậy chắc rủng rỉnh tiền lắm ha? Bác định sắm gì giờ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722866
    m_Localized: 'FunnyGuy: Mẹ, mày hỏi câu chí đấy. '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722867
    m_Localized: 'FunnyGuy: Cơ mà bác không muốn kể oang oang cho cả làng cùng nghe đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722868
    m_Localized: 'FunnyGuy: Chuyện tế nhị mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722869
    m_Localized: Bác cũng kiệm lời quá nhỉ
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722870
    m_Localized: 'FunnyGuy: Ơ, thằng này nói chuyện mỉa mai gớm nhỉ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722871
    m_Localized: 'FunnyGuy: Bác nói thẳng là bác không thích đâu nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722872
    m_Localized: Bác cũng kiệm lời quá nhỉ
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722873
    m_Localized: 'FunnyGuy: Biết sao giờ? Mày chẳng chịu mừng cho bác gì cả.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722874
    m_Localized: 'FunnyGuy: Mà kệ. Mày có vay đâu mà mày phải mừng vui làm gì. Có nguyên căn nhà khang trang thế này cơ mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722875
    m_Localized: 'FunnyGuy: Bác mà có cái nhà to như mày thì đã sống sướng phải biết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722876
    m_Localized: 'FunnyGuy: ... '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722877
    m_Localized: 'FunnyGuy: Thế mày có định cho bác vào không đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722878
    m_Localized: Bác vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722879
    m_Localized: 'Thôi bác đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722880
    m_Localized: 'FunnyGuy: Thế chứ lị! Vào bật mấy lon bia, hai bác cháu ăn mừng luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722881
    m_Localized: 'FunnyGuy: Ngày hôm nay ta cùng họp hoan nơi đây!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722882
    m_Localized: 'FunnyGuy: Nhất quyết không cho à?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722883
    m_Localized: 'FunnyGuy: ... '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722884
    m_Localized: 'FunnyGuy: Địt mẹ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722885
    m_Localized: 'FunnyGuy: Thôi, để tính cách khác vậy. Còn từ giờ đến sáng mai mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722886
    m_Localized: 'Alt: Ồ, có người ở đây à. Cho tôi vào với được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722887
    m_Localized: Bộ nhà này trông giống nhà hoang lắm hả?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722888
    m_Localized: Chị cũng chơi trội đấy nhỉ
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722889
    m_Localized: 'Alt: À không, tôi đâu có ý nói vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722890
    m_Localized: 'Alt: Chẳng qua... tôi nghe đồn là khu ngoại ô bây giờ đang loạn vãi lồn ấy mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722891
    m_Localized: 'Alt: Mà không phải ở mỗi thành phố mình đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722892
    m_Localized: 'Alt: Làm như giằng co với mấy thằng điên và lũ Dị Khách chưa đủ mệt hay sao ấy. Giờ cả mặt trời cũng muốn thiêu chết mẹ mình luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722893
    m_Localized: Chị đang chạy trốn cái gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722894
    m_Localized: 'Chị nghĩ ở đây thì đỡ hơn à? '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722895
    m_Localized: 'Alt: Ơ, sao phải tỏ thái độ thế?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722896
    m_Localized: 'Alt: Tôi đã làm gì sai đâu. Đừng có trông mặt mà bắt hình dong nhé. Dẹp hộ cái kiểu đó đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722897
    m_Localized: 'Alt: Trông thế này thôi chứ tôi tử tế, chẳng muốn hại gì ai cả. Chỉ mong cậu đừng vội đánh giá người ta như vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722898
    m_Localized: Chị đang chạy trốn cái gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722899
    m_Localized: 'Chị nghĩ ở đây thì đỡ hơn à? '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722900
    m_Localized: 'Alt: Sao cậu lại nghĩ là tôi đang chạy trốn?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722901
    m_Localized: 'Alt: Chẳng qua tôi không thích lễ nghĩa vòng vo thôi. Muốn gì cứ nói thẳng là tiện nhất.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722902
    m_Localized: 'Alt: Mà tôi cảm giác là ở mãi trong thành phố cũng không an toàn đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722903
    m_Localized: 'Alt: Tình hình này càng kéo dài thì càng khổ. Không khí ngột ngạt, tệ nạn tràn lan, người người nhà nhà thì hoang mang tột độ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722904
    m_Localized: 'Alt: Nhắm thấy sắp ăn cám hết cả lũ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722905
    m_Localized: 'Alt: Còn tôi thì chê nhé, chẳng muốn được chia phần trước đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722906
    m_Localized: 'Chị vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722907
    m_Localized: 'Thôi chị đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722908
    m_Localized: 'Alt: Ừ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722909
    m_Localized: 'Alt: Tôi không khách sáo nữa, vào thẳng vấn đề luôn nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722910
    m_Localized: 'Alt: Ở đây buổi đêm mát trời. Với cũng chẳng có ai dán mắt vào bản tin 24/24 cả.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722911
    m_Localized: 'Alt: Chẳng biết nhà cậu có điện không, nhưng không có thì càng tốt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722912
    m_Localized: 'Alt: Vì cái TV cũng chả giúp ích được gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722913
    m_Localized: 'Alt: Nghe thời sự xong, đang lo thấp thỏm giờ còn phải sợ gấp năm... À không, gấp mười lần mới đúng với tình hình bên ngoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722914
    m_Localized: 'Chị vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722915
    m_Localized: 'Thôi chị đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722916
    m_Localized: 'Alt: Hay quá. '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722917
    m_Localized: 'Alt: Vậy mai nói chuyện nhé. Nay tôi mệt lắm rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722918
    m_Localized: 'Alt: Tuần vừa rồi khổ thực sự.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722919
    m_Localized: 'Alt: Quanh đây vẫn còn nhà khác. Mong là sẽ có người tử tế mà không đánh giá tôi qua vẻ bề ngoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722920
    m_Localized: 'Alt: Thôi, tôi đi đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722921
    m_Localized: 'Tourist: Này anh gì ơi. Anh giúp tôi với. Tôi không phải dân ở đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722922
    m_Localized: 'Anh cần tôi giúp gì? '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722923
    m_Localized: Anh đi đâu mà lạc đến tận đây vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722924
    m_Localized: 'Tourist: Có chút sự cố. Nên giờ tôi không ra khỏi thành phố được.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722925
    m_Localized: 'Tourist: Sân bay thì đóng cửa, tàu hỏa cũng không chạy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722926
    m_Localized: Anh cũng biết lựa thời điểm mà du lịch quá
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722927
    m_Localized: Anh không còn chỗ nào để đi nữa thật à?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722928
    m_Localized: 'Tourist: À thì, chẳng là tôi lên kế hoạch đi du lịch, tham quan thủ đô...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722929
    m_Localized: 'Tourist: Nhưng xui sao họ đóng cửa biên giới... nên giờ tôi bị kẹt luôn ở đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722930
    m_Localized: 'Tourist: Tôi chỉ đi ngang qua thôi, thật mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722931
    m_Localized: Anh cũng biết lựa thời điểm mà du lịch quá
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722932
    m_Localized: Anh không còn chỗ nào để đi nữa thật à?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722933
    m_Localized: 'Tourist: Ừ, tôi biết chứ. Nói thật, nếu tôi biết trước mặt trời bị vậy thì cũng không qua đây làm gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722934
    m_Localized: 'Tourist: Mà giờ tôi kẹt rồi, không đủ tiền thuê khách sạn nữa. Xin anh cho tôi ở cùng đi mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722935
    m_Localized: 'Anh vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722936
    m_Localized: 'Thôi anh đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722937
    m_Localized: 'Tourist: Không... '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722938
    m_Localized: 'Tourist: Trước thì tôi ở khách sạn, nhưng hết tiền rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722939
    m_Localized: 'Tourist: Giờ tôi cũng không biết đi về đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722940
    m_Localized: 'Tourist: Xin anh cho tôi ở cùng đi mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722941
    m_Localized: 'Anh vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722942
    m_Localized: 'Thôi anh đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722943
    m_Localized: 'Tourist: Cảm ơn anh nhiều. '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722944
    m_Localized: 'Tourist: Chết dở... đi đâu bây giờ nữa đây... Xin khắp các nhà rồi, mà chả ai cho vào.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722945
    m_Localized: 'Tourist: … '
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722946
    m_Localized: 'Tourist: Biết vậy đừng nên đến đây làm gì...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769344
    m_Localized: 'Jacket: Thôi chết rồi… Kiểu gì mình cũng bị mấy ông áo vàng bắt đi mất.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769345
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769346
    m_Localized: 'Jacket: Thôi, em phải đi đây ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769347
    m_Localized: 'Tough: Ủa, có ai trong nhà mày đó? Cái {0} đấy? '
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769348
    m_Localized: 'Tough: Giờ mày đuổi người ta đi, không là chị lượn nhá. '
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769349
    m_Localized: "Để tôi đuổi ra cho. \nChị vào đi "
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769350
    m_Localized: Thôi chị đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769351
    m_Localized: 'Tough: Hờ. Thằng này khá. Chị còn tưởng mày hổng dám làm cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769352
    m_Localized: 'Tough: Mày đuổi cái là nó đi liền. Hiền như cục bột vậy thì làm ăn được gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769353
    m_Localized: 'Tough: Đéo gì vậy? Chị tưởng mày cũng nể mặt chị chứ, cùng là người có bản lĩnh như nhau.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769354
    m_Localized: 'Tough: Đừng nói với chị là mày chả có gan đuổi nó đấy nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769355
    m_Localized: 'Tough: Chậc... Mày làm chị thất vọng quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769356
    m_Localized: 'Bald: Ây chà, thiệt ra thì với tui với ai cũng dễ bắt chuyện. Nhưng mà riêng người này tui thấy hơi bị ngán. Cờ đỏ từ trên xuống dưới luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769357
    m_Localized: 'Bald: Đúng rồi, {0} kia kìa. Hay là… anh tiễn đi giùm nha?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769358
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769359
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769360
    m_Localized: 'Bald: Tui biết là đuổi người ta vậy thì kỳ lắm. Nhưng biết sao được, cuộc sống mà. Nhiều lúc mình phải đóng vai kẻ xấu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769361
    m_Localized: 'Bald: Chà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769362
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769363
    m_Localized: 'Bald: Thôi không sao, tui hiểu mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769364
    m_Localized: 'Bald: Giữ sức khỏe nghen. Chúc anh sống qua được cái thảm kịch khùng điên này.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769365
    m_Localized: 'Nervous: Ô... Trong nhà đằng ấy đang có {0} kìa. '
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769366
    m_Localized: 'Nervous: Tớ biết thừa chuyện gì đã xảy ra một tháng trước nhé. Biết rõ mồn một luôn đấy. '
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769367
    m_Localized: 'Nervous: Thằng cha này ngáoooooo lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769368
    m_Localized: 'Nervous: Tớ mà lị... Không ai rõ hơn tớ đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769369
    m_Localized: "Để tôi đuổi ra cho. \nCậu vào đi "
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769370
    m_Localized: 'Thôi cậu đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769371
    m_Localized: 'Nervous: Hay quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769372
    m_Localized: 'Nervous: Nghe hơi cấn nhỉ. Nhưng mà... thôi kệ đi! Hí hí! '
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769373
    m_Localized: 'Nervous: Đừng có dại dây vào mấy thằng điênnnn làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769374
    m_Localized: 'Nervous: Thật luôn hả? '
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769375
    m_Localized: 'Nervous: Mà không ở chung với đằng ấy, có khi lại hay. Chứ còn sao nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769376
    m_Localized: 'Nervous: Toàn giao du với lũ khốn nạn, chứng tỏ đằng ấy cũng có ra cái đ-đ-đéo gì đâu. Hí hí!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769377
    m_Localized: 'Leper: Xin lỗi, nhưng tôi không vào được đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769378
    m_Localized: 'Leper: Có {0} ở đây. Tôi từng bị người đó bắt nạt vì cái mặt này đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769379
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769380
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769381
    m_Localized: 'Leper: Cảm ơn nhé. Tôi không muốn phải trải qua chuyện ấy lần hai đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769382
    m_Localized: 'Leper: Mấy người hay đi chế giễu ngoại hình người khác mà cậu cũng chứa trong nhà được à?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157952
    m_Localized: 'Leper: Thôi, cái đó tùy cậu quyết. Tôi đi vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157953
    m_Localized: 'Leper: Thôi được rồi, hay tôi cho cậu cái này nhé? Đây, {0}. Như vậy đã đủ cho tôi vào chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157954
    m_Localized: Thôi được rồi, anh vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157955
    m_Localized: Tôi không nhận hối lộ đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157956
    m_Localized: 'Fairytaller: Cảm ơn anh nhiều lắm ạ! Cơ mà... em thấy trong nhà đang có một gương mặt thân quen. Em có xích mích với người ta lúc còn ở quán.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157957
    m_Localized: 'Fairytaller: Nói thật thì, vụ đó cũng chẳng phải lỗi của em.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157958
    m_Localized: 'Fairytaller: Em biết là nãy giờ mình làm phiền anh nhiều rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157959
    m_Localized: 'Fairytaller: Nhưng em không thấy thoải mái khi ở chung với {0}. Mong anh thông cảm ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157960
    m_Localized: "Để anh đuổi ra cho. \nCậu vào đi"
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157961
    m_Localized: Thôi cậu đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157962
    m_Localized: 'Fairytaller: Thật sao ạ? Cảm ơn anh nhiều! Phiền anh quá... không được thì em kiếm chỗ khác cũng ổn mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157963
    m_Localized: 'Fairytaller: Nhưng thật sự cảm ơn anh đã tin tưởng em ạ!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157964
    m_Localized: 'Fairytaller: Dạ, em hiểu rồi. Chúc anh mạnh khỏe.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157965
    m_Localized: 'FunnyGuy: Thôi miễn nhá. Nhà có thằng đấy là mất hết cả vui.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157966
    m_Localized: 'FunnyGuy: Thấy nó kia không? Cái {0} đấy đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157967
    m_Localized: 'FunnyGuy: Đời bác đã đen đủi đủ đường rồi. Thôi thì chí ít cũng nên giữ nhà cửa cho sạch sẽ đi nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157968
    m_Localized: "Để tôi đuổi ra cho. \nBác vào đi "
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157969
    m_Localized: 'Thôi bác đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157970
    m_Localized: 'FunnyGuy: Đấy, phải thế chứ!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157971
    m_Localized: 'FunnyGuy: Xong mình phải nhậu một bữa no say, mừng bác xóa hết nợ nần! Khà khà khà!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157972
    m_Localized: 'FunnyGuy: Chẹp... Vậy thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157973
    m_Localized: 'FunnyGuy: Được rồi, để bác đi chỗ khác. Còn từ giờ đến sáng cơ mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157974
    m_Localized: 'FunnyGuy: Má nó, mày đúng là chả khác gì mấy đứa làm bên ngân hàng. Tổ sư.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157975
    m_Localized: 'FunnyGuy: Thôi được rồi. Nốt lần này thôi đấy nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157976
    m_Localized: 'FunnyGuy: Đây, bác có cái này... Từ từ để lục xem...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157977
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157978
    m_Localized: 'FunnyGuy: Nè chú mày, {0} đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157979
    m_Localized: 'FunnyGuy: Vậy là vui vẻ cả làng chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157980
    m_Localized: Thôi được rồi, bác vào đi
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157981
    m_Localized: Tôi không nhận hối lộ đâu nhé
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157982
    m_Localized: 'Alt: Ô hay, {0} cũng ở đây này. '
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157983
    m_Localized: 'Alt: Chuyện dài lắm, tôi cũng chẳng muốn kể lê thê làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157984
    m_Localized: 'Alt: Nhưng không có chuyện tôi ở chung chỗ với người ta đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157985
    m_Localized: "Để tôi đuổi ra cho. \nChị vào đi "
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157986
    m_Localized: 'Thôi chị đi chỗ khác giùm '
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157987
    m_Localized: 'Alt: Cảm ơn nhé. Tôi mong lắm mà cũng không ngờ cậu đuổi hộ thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157988
    m_Localized: 'Alt: Thôi thì... '
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157989
    m_Localized: 'Alt: Vẫn còn thời gian, tôi đi tìm chỗ khác vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157990
    m_Localized: 'Alt: Chẳng hiểu sao lũ khốn nạn lúc nào cũng được hưởng phúc.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157991
    m_Localized: 'Alt: Tôi còn lạ gì nữa. Tôi biết tỏng cậu muốn gì rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157992
    m_Localized: 'Alt: Đây. Cậu lấy {0} này không?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157993
    m_Localized: 'Alt: Chốt thế nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157994
    m_Localized: 'Thôi được rồi, chị vào đi '
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157995
    m_Localized: 'Tôi không nhận hối lộ đâu nhé '
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157996
    m_Localized: 'Tourist: À, anh ơi, chắc là tôi chưa vào được.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157997
    m_Localized: 'Tourist: Có {0} ở kia rồi. Tôi không chắc là mình ở chung với họ được đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157998
    m_Localized: "Để tôi đuổi ra cho. \nAnh vào đi "
    m_Metadata:
