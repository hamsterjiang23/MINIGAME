%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DayDialogs_es
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 48f2181e494cb864ca5ca7074da486ff, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22080585977856
    m_Localized: 'Firefighter: Hace un calor de mil demonios...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560768
    m_Localized: ¿Cómo te encuentras?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560769
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560770
    m_Localized: 'Firefighter: Parece que es incluso peor de lo que pensaba. Cof... Joder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560771
    m_Localized: 'Firefighter: No creo aguantar más de una semana.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560772
    m_Localized: 'Firefighter: Aunque me sentí un poco mejor cuando me dejaste entrar. Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560773
    m_Localized: 'Firefighter: Pero... estoy aquí sentado mientras el resto de los chicos están muriendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560774
    m_Localized: 'Firefighter: Podría haber estado con ellos. No tengo nada que perder, de todas formas. Voy a morir, al fin y al cabo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560775
    m_Localized: 'Firefighter: Hace un calor de mil demonios...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560776
    m_Localized: ¿Por qué no te has ido a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560777
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560778
    m_Localized: 'Firefighter: Tengo a mis hijos en casa. Y no... cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560779
    m_Localized: 'Firefighter: No quiero que me tengan miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560780
    m_Localized: 'Firefighter: Y no... cof... no quiero que me recuerden así.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560781
    m_Localized: 'Firefighter: Que piensen que he muerto en el bosque, mientras... cof... cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560782
    m_Localized: 'Firefighter: Mientras apagaba incendios.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560783
    m_Localized: 'Firefighter: Cof... que me recuerden por lo mucho que aguanté y por lo mucho que trabajé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560784
    m_Localized: 'Firefighter: Hace un calor de mil demonios...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560785
    m_Localized: ¿Dónde está tu uniforme?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560786
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560787
    m_Localized: 'Firefighter: Los jefes se lo llevaron. Cof... Ni siquiera tenemos suficiente equipo ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560788
    m_Localized: 'Firefighter: Mucha gente... cof... está muriendo en el trabajo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560789
    m_Localized: 'Firefighter: No nos da tiempo ni para sacar a nuestros compañeros. El fuego... cof... al final acaba con todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560790
    m_Localized: 'Firefighter: Y a los jefes... les preocupa más... cof... un puto uniforme...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560791
    m_Localized: 'Firefighter: Sacan un decreto tras otro, como si fueran churros. Y ninguno que beneficie a la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560792
    m_Localized: 'Firefighter: Hace un calor de mil demonios...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560793
    m_Localized: ¿De dónde salieron los incendios forestales?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560794
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560795
    m_Localized: 'Firefighter: El bosque ha estado especialmente seco últimamente. Por eso... cof... se incendia fácilmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560796
    m_Localized: 'Firefighter: El fuego es solo... cof... una de las desgracias que nos han sucedido, al igual que esos Visitantes de las profundidades.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560797
    m_Localized: 'Firefighter: Pero aún nos queda tela por cortar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560798
    m_Localized: 'Firefighter: Quizás una muerte pacífica ahora sea el mejor resultado para esta causa perdida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560799
    m_Localized: 'Firefighter: Sabes... cof... consideré llevar esto como regalo a casa. Pero mejor te lo daré a ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560800
    m_Localized: 'Firefighter: Este collar, no es mucho, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560801
    m_Localized: 'Firefighter: Está hecho de abejas muertas que alguna vez convirtieron la miel en Sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560802
    m_Localized: 'Firefighter: Hace un calor de mil demonios...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560803
    m_Localized: Te ves fatal
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560804
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560805
    m_Localized: 'Firefighter: Creo... creo que me ha llegado la hora... cof... cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560806
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560807
    m_Localized: 'Firefighter: ¿Por qué no me quedé allí? Hubiera podido salvar a algunos de esos chavales.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560808
    m_Localized: 'Firefighter: Debí haberme quedado... y trabajar hasta desplomarme. No habrían tenido que mandar a esos chavales al matadero.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560809
    m_Localized: 'Firefighter: ¡MALDITOS JEFES! ¡COF... COF...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560810
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560811
    m_Localized: 'Firefighter: Todo es tan... triste.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560812
    m_Localized: 'Firefighter: ¿Me echas un último fuego?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560813
    m_Localized: Toma un cigarrillo (Darle un cigarrillo)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560814
    m_Localized: 'Firefighter: ¿No tendrás un cigarrillo por ahí, de casualidad?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560815
    m_Localized: Nop, perdona (No darle un cigarrillo)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560816
    m_Localized: 'Firefighter: La cereza sobre el pastel, como quien dice. Cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560817
    m_Localized: 'Firefighter: (El hombre saca un mechero del bolsillo, enciende el cigarrillo y empieza a fumar)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560818
    m_Localized: 'Firefighter: (Da una larga calada y se apoya en la pared. Tras una breve pausa, prosigue)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560819
    m_Localized: 'Firefighter: Si tan solo pudiera estar con ellos otra vez. Fumando, hablando de...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560820
    m_Localized: 'Firefighter: COF... COF... COF... COF...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560821
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560822
    m_Localized: 'Firefighter: ¿No fumas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560823
    m_Localized: 'Firefighter: Ya, ya sé. "¿Un bombero fumando?" Cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560824
    m_Localized: 'Firefighter: A estas alturas, ya da igual.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560825
    m_Localized: 'Firefighter: Solo quería... cof... relajarme un poco antes de morir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560826
    m_Localized: 'Firefighter: (El hombre se apoya en la pared, con la mirada fija en el techo mientras habla)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560827
    m_Localized: 'Firefighter: ¿Cómo es que acabé siendo bombero...? Mi madre me dijo que fuera a trabajar a una fábrica.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560828
    m_Localized: 'Firefighter: No es propio de un bombero andar fuman—'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560829
    m_Localized: 'Firefighter: ¡COF... COF...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560830
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560831
    m_Localized: 'WheelChair: Por ahí libre, quién pudiera...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560832
    m_Localized: ¿A quién buscas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560833
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560834
    m_Localized: 'WheelChair: Verás, tengo a este amigo. Nos conocemos desde el jardín.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560835
    m_Localized: 'WheelChair: Tuvo un accidente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560836
    m_Localized: 'WheelChair: Le contrataron para extraer algo en las montañas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560837
    m_Localized: 'WheelChair: No sé en qué estaría metido. Y me da igual.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755072
    m_Localized: 'WheelChair: Pero ENTONCES se lastimó la espalda, ¡y estuvo días sin poder moverse!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755073
    m_Localized: 'WheelChair: Trabajó tanto en las montañas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755074
    m_Localized: 'WheelChair: Que las gaviotas confundieron su... jaja... sus nalgas... eh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755075
    m_Localized: 'WheelChair: Bueno, fue su culo. ¡Confundieron su culo con UN NIDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755076
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755077
    m_Localized: 'WheelChair: ¡JAJAJAJAJA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755078
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755079
    m_Localized: 'WheelChair: Perdona, son solo las voces en mi cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755080
    m_Localized: 'WheelChair: Me contaron un chiste muy divertido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755081
    m_Localized: 'WheelChair: Por ahí libre, ¡quién pudiera...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755082
    m_Localized: Eh... ¿todo bien?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755083
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755084
    m_Localized: 'WheelChair: Sí. Solo estoy esperando a que me vuelvan a crecer las piernas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755085
    m_Localized: 'WheelChair: Mire, la derecha ya ha empezado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755086
    m_Localized: 'WheelChair: Así que me quedaré aquí un rato.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755087
    m_Localized: Me refería a las voces en tu cabeza
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755088
    m_Localized: Vale...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755089
    m_Localized: 'WheelChair: ¿No lo habías pillado? ¡Era una broma!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755090
    m_Localized: 'WheelChair: Pensé que lo habías pillado enseguida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755091
    m_Localized: 'WheelChair: Supongo que no hizo gracia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755092
    m_Localized: 'WheelChair: ¿Me has preguntado ahora mismo cómo estoy?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755093
    m_Localized: 'WheelChair: ¡Gracias, qué majo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755094
    m_Localized: 'WheelChair: Jamás me preguntan cómo me encuentro o qué tal ha ido mi día.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755095
    m_Localized: 'WheelChair: ¿Será porque en lugar de piernas tengo estas increíbles ruedas de carreras? ¿Acaso están CELOSOS?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755096
    m_Localized: 'WheelChair: Nadie contesta a eso con honestidad. Ese es el problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755097
    m_Localized: 'WheelChair: Solo empiezan a inventar pretextos de que estaban echando un vistazo rápido a mis piernas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755098
    m_Localized: 'WheelChair: Aunque es igual de malo cuando solo se quedan mirando.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755099
    m_Localized: 'WheelChair: Pero ignorar mi discapacidad es estúpido. Vamos, que está ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755100
    m_Localized: 'WheelChair: Lo que digo es que tiene que haber un equilibrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755101
    m_Localized: 'WheelChair: Pero desde luego que no hay equilibrio en la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755102
    m_Localized: 'WheelChair: ¿Te has imaginado alguna vez cómo te moverías si tuvieras ruedas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755103
    m_Localized: 'WheelChair: Joder, eso no es a lo que me refería...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755104
    m_Localized: 'WheelChair: Si no tuvieses... piernas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755105
    m_Localized: 'WheelChair: ¡EXACTO! ¡Ni siquiera podrías salir de casa!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755106
    m_Localized: 'WheelChair: ¿Cómo usaría las escaleras? ¿O cruzaría la calle?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755107
    m_Localized: 'WheelChair: Estos jodidos bordillos están todos hechos un asco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755108
    m_Localized: 'WheelChair: En tu casa no hay escaleras ni escalones, así que me apaño bien para moverme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755109
    m_Localized: 'WheelChair: ¿Sabes? Solo hay una cosa que desearía...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755110
    m_Localized: 'WheelChair: ¡Que tu casa estuviera en una pendiente!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755111
    m_Localized: 'WheelChair: Sería gracioso recorrerla en silla de ruedas ahora mismo. Y darme puras hostias contra la pared... ¡JAJA! Sí, pero no pasa nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755112
    m_Localized: 'WheelChair: ¡Tío, me flipan las carreras! Pero no tienes nada para practicarlas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755113
    m_Localized: 'WheelChair: Ah, un momento, me has preguntado cómo me va.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755114
    m_Localized: 'WheelChair: No me va mal. Gracias por preguntar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755115
    m_Localized: 'WheelChair: Por ahí libre, ¡quién pudiera...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755116
    m_Localized: ¿Te ha dado insolación?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755117
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755118
    m_Localized: 'WheelChair: ¿Y eso a qué viene?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755119
    m_Localized: 'WheelChair: No se me ha quemado ni se me ha caído el pelo. Así que todo bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755120
    m_Localized: 'WheelChair: No puedo competir en una silla de ruedas sin piernas. ¿Lo ve?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755121
    m_Localized: 'WheelChair: Si no tengo piernas, ¿cómo iba a frenar a gran velocidad? ¿O tomar una curva?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755122
    m_Localized: 'WheelChair: No vas en silla de ruedas, ¿cómo ibas a entenderlo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755123
    m_Localized: ¿De verdad te crees eso?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755124
    m_Localized: ¿Por qué piensas que te volverán a crecer las piernas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755125
    m_Localized: 'WheelChair: ¡Claro que sí!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755126
    m_Localized: 'WheelChair: Ya sabes lo que dicen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755127
    m_Localized: 'WheelChair: La pierna derecha da zancadas más largas. Por eso no hacemos más que dar vueltas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755128
    m_Localized: 'WheelChair: Mire, mi pierna es la prueba.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755129
    m_Localized: 'WheelChair: Todo es lo mismo y no se puede salir del bucle.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755130
    m_Localized: 'WheelChair: Este día se acaba hoy, mañana empezará otro. ¿Pero habrá un nuevo día?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755131
    m_Localized: 'WheelChair: Que le den. Da igual. Yo solo vivo en el bucle.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755132
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755133
    m_Localized: 'WheelChair: Así que, si lo piensas bien, ¿eres realmente tan diferente de mí?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755134
    m_Localized: 'WheelChair: ¿Acaso no estás dando vueltas también?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755135
    m_Localized: 'WheelChair: Mire, vivimos en un mundo de sorpresas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755136
    m_Localized: 'WheelChair: Solo de sorpresas chungas, por ahora. ¡PERO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755137
    m_Localized: 'WheelChair: Las sorpresas chungas tienen su fin, que lo digo yo. Luego vendrá lo bueno, lo alegre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755138
    m_Localized: 'WheelChair: Dios ya ha perdonado a un montón de pecadores. Tal vez nos pase algo bueno a nosotros también, ¿eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755139
    m_Localized: 'WheelChair: Por ahí libre, ¡quién pudiera...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755140
    m_Localized: ¿Cómo fue que perdiste las piernas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755141
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755142
    m_Localized: 'WheelChair: ¿Recuerdas a mi amigo en las montañas del que te hablé?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755143
    m_Localized: 'WheelChair: Pues... Decidió cavar una zanja en su jardín.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755144
    m_Localized: 'WheelChair: Se le metió en la cabeza que un túnel repleto de carne pasaba por debajo de su casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755145
    m_Localized: 'WheelChair: Encargó un taladro manual o algo así.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755146
    m_Localized: 'WheelChair: Y entonces se puso a excavar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755147
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755148
    m_Localized: 'WheelChair: Joder...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755149
    m_Localized: 'WheelChair: Esa fue probablemente la última vez que le vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755150
    m_Localized: 'WheelChair: Por ahí libre, ¡quién pudiera...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755151
    m_Localized: ¿Y qué hay de tus piernas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755152
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755153
    m_Localized: 'WheelChair: Que les den a las piernas. Quiero saber si excavó hasta donde pretendía.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755154
    m_Localized: Vale, olvídalo
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755155
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755156
    m_Localized: 'WheelChair: Sí, eso es. Justo después, me fui a tomar una cerveza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755157
    m_Localized: 'WheelChair: Me caí y un trolebús me seccionó las piernas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755158
    m_Localized: 'WheelChair: O un momento...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755159
    m_Localized: 'WheelChair: No, así no fue como ocurrió.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755160
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755161
    m_Localized: 'WheelChair: ¿Por qué no dices nada? ¿No te parece interesante?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755162
    m_Localized: 'WheelChair: Bueno, no me molestaré en contártelo. ¿Para qué las molestias?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755163
    m_Localized: 'Mother: Aquí dentro hace un calor sofocante...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755164
    m_Localized: ¿No tenías una niña contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755165
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755166
    m_Localized: 'Mother: ¿Eh? Todavía está conmigo. Se habrá ido a explorar o algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755167
    m_Localized: 'Mother: Necesito saber a dónde fueron los otros y si están bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755168
    m_Localized: 'Mother: ¿Tienes un móvil o algo? Podría llamar a su padre para no tener que volver a verle la cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755169
    m_Localized: 'Mother: Aquí dentro hace un calor sofocante...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755170
    m_Localized: ¿Y bien? ¿Llamaste a tu marido?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755171
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755172
    m_Localized: 'Mother: ¿Para qué? Solo pondría cualquier excusa. Jamás movió un dedo. Todo fue cosa mía: los niños, la casa, la pasta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755173
    m_Localized: 'Mother: A veces pienso que él solo me toleraba y yo lo toleraba a él. Pero no me dejó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755174
    m_Localized: 'Mother: Quizá porque le venía bien. O solo tenía miedo de que me diera por apuñalarlo si siquiera llegaba a intentarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755175
    m_Localized: 'Mother: Madre mía, qué cansancio...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755176
    m_Localized: 'Mother: Aquí dentro hace un calor sofocante...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755177
    m_Localized: ¿Fuiste a ver a tu marido?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755178
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755179
    m_Localized: 'Mother: ¿Qué? Apenas puedo levantarme. Me duele todo y estoy agotada. Puede que solo siga viva por puro rencor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755180
    m_Localized: 'Mother: Todo era cosa mía: los críos, mi marido y toda la casa. Pero a veces, él hacía cosas que lo hacían llevadero.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755181
    m_Localized: 'Mother: ¿Podemos hablar luego? Estoy reventada y si no descanso, me voy a desmayar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755182
    m_Localized: 'Mother: Aquí dentro hace un calor sofocante...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755183
    m_Localized: ¿Qué tipo de cosas hacía?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755184
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755185
    m_Localized: 'Mother: Vale, pues, hubo una vez que...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755186
    m_Localized: 'Mother: Le vi en el coche con una tía. Sabía de qué iba el rollo y pasaba seguido. Al principio lo toleré, pero luego le rayé la cabeza por ello a diario.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755187
    m_Localized: 'Mother: Le eché en cara que me engañaba. Terminó cambiándose de curro para no verla... Puede que si me amara de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755188
    m_Localized: 'Mother: Puede que todo estuviese en mi cabeza... En fin, necesito descansar. Hablamos luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755189
    m_Localized: 'Mother: Aquí dentro hace un calor sofocante...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755190
    m_Localized: ¿No te preocupan tus hijos?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755191
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755192
    m_Localized: 'Mother: Sí... Pero seguramente no tanto como debería. Con el primer chaval... No tenía idea de lo que hacía. La lié un montón.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755193
    m_Localized: 'Mother: Creí que había arreglado mis errores con el segundo. Pero salió igual. Luego el tercero, y el cuarto...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755194
    m_Localized: 'Mother: Los médicos decían que no iba a poder tener hijos, ¡pero cuando nació el segundo fue la octava maravilla del mundo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755195
    m_Localized: 'Mother: Pero luego... se tornó difícil... Fue fatal...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755196
    m_Localized: 'Mother: Yo... Necesito descansar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755197
    m_Localized: 'Mother: Aquí dentro hace un calor sofocante...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755198
    m_Localized: ¿En qué fue fatal?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755199
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755200
    m_Localized: 'Mother: Me cuesta hablar de ello... Los quiero, pero... A veces perdía los nervios. Gritaba, hasta llegué a levantarles la mano...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755201
    m_Localized: 'Mother: Sé que eso es terrible. Me arrepiento un montón... Pero, ¿sabes? Por primera vez... me siento tranquila.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755202
    m_Localized: 'Mother: No están aquí y... por fin puedo respirar... Odio decirlo, pero por primera vez me siento... feliz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755203
    m_Localized: 'Anger: Joder, qué mierda...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755204
    m_Localized: ¿Y bien? ¿Te has calmado?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755205
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755206
    m_Localized: 'Anger: Sí, me calmo rápido. Pero en cuanto recuerdo algo que me cabrea, vuelvo a perder los nervios.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755207
    m_Localized: 'Anger: Antes era más tranquilo. Era difícil ofenderme o tocarme la fibra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755208
    m_Localized: 'Anger: Ahora basta una pequeña chispa y se desata el infierno.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755209
    m_Localized: 'Anger: ¿Y por qué narices debería mantener la calma? Quizá mi rabia me ayude a mantenerme cuerdo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755210
    m_Localized: 'Anger: Al menos yo no venero al puto sol como esos ceporros de mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755211
    m_Localized: 'Anger: ¿Cómo coño se creen que el sol nos salvará? ¡Sí, claro! ¡QUE NOS ESTÁ MATANDO, JODER!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755212
    m_Localized: 'Anger: Todo apunta a que no falta nada para vernos en el más allá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755213
    m_Localized: 'Anger: ¿Qué no lo pillan estos pringaos? Naah, ni de coña... Uff, ya. Venga, ya estoy bien... Ya me he calmado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755214
    m_Localized: 'Anger: Gracias por escucharme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755215
    m_Localized: 'Anger: Joder, qué mierda...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755216
    m_Localized: ¿De dónde viene toda esta ira?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755217
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755218
    m_Localized: 'Anger: Ni yo mismo lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755219
    m_Localized: 'Anger: Todo lo que está pasando me cabrea un montón.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755220
    m_Localized: 'Anger: Y los sectarios, esos malditos cabrones embusteros de mierda. Sí que les gustaría engañar a más gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755221
    m_Localized: 'Anger: Y la gente se lo va a tragar, joder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755222
    m_Localized: 'Anger: La gente está dispuesta a quitarles hasta el último mendrugo a sus propios hijos con tal de pagarle al culto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755223
    m_Localized: 'Anger: Para apaciguar a su puto salvador del inframundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755224
    m_Localized: 'Anger: Unos jodidos chalados. Hasta le comen el coco a gente normal con sus delirios... como le hicieron a mi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755225
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755226
    m_Localized: 'Anger: En fin, ahora estoy bastante calmado. Me siento mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755227
    m_Localized: 'Anger: Joder, qué mierda...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755228
    m_Localized: ¿Los del culto te arrebataron a alguien?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755229
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755230
    m_Localized: 'Anger: No, ahí está el rollo. Ella se fue con ellos por su propia voluntad.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755231
    m_Localized: 'Anger: Mi mujer...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755232
    m_Localized: 'Anger: Antes de toda esta mierda, era muy religiosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755233
    m_Localized: 'Anger: Pero la quería y lo acepté. Nunca interfirió en lo nuestro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755234
    m_Localized: 'Anger: Cuando todo se vino abajo, encontró una nueva fe en un nuevo salvador.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755235
    m_Localized: 'Anger: La jodida retórica de los sectarios le pareció sensata.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755236
    m_Localized: 'Anger: Se volvía más loca cada día, creyendo cosas incomprensibles para mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755237
    m_Localized: 'Anger: Cuando fui consciente de mi error, ella... ya había huido despavorida. Era demasiado tarde para arreglarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755238
    m_Localized: 'Anger: Joder, qué mierda...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755239
    m_Localized: ¿Qué ocurrió entre tu mujer y tú?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755240
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755241
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755242
    m_Localized: 'Anger: Un día, mi mujer me dijo que se uniría al culto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755243
    m_Localized: 'Anger: Yo... no daba crédito. La mujer que amaba... Se había transformado en una persona completamente diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755244
    m_Localized: 'Anger: Nuestro amor ya no significaba algo para ella. Estaba furioso, más furioso de lo que jamás había estado en mi vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755245
    m_Localized: 'Anger: Empecé a pensar que jamás me había querido y que solo había estado buscando cómo largarse a la mierda. Me dio asco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755246
    m_Localized: 'Anger: Mis manos se hicieron puños solas, e hice algo imperdonable.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755247
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755248
    m_Localized: 'Anger: La golpeé...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755249
    m_Localized: 'Anger: No hay nada que pueda arreglarlo ahora. Ella está en el culto y yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755250
    m_Localized: 'Anger: Jamás podré hacer las paces con lo sucedido...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755251
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755252
    m_Localized: 'Anger: ¡JODER, ME ODIO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755253
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755254
    m_Localized: 'Anger: Prefiero hacerme daño a mí mismo que a los demás. Me lo he ganado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755255
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755256
    m_Localized: 'Anger: Vete. Necesito estar solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755257
    m_Localized: 'FortuneTeller: ¿Te echo las cartas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755258
    m_Localized: ¿Cómo es que sabes tanto sobre mí?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755259
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755260
    m_Localized: 'FortuneTeller: ¡Já! Qué gracioso eres... No soy yo quien lo sabe. Los astros hablan a través de mí, así de simple.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755261
    m_Localized: 'FortuneTeller: Tu luna está en Venus en tu Sexta Casa. Se te nota en la cara, ¿ves? Por muy calladito que seas...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755262
    m_Localized: 'FortuneTeller: Una vez conocí a alguien como tú. Siempre escuchaba sin decir ni una palabra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755263
    m_Localized: 'FortuneTeller: Ya sabes el dicho: Si Júpiter te cae en la Octava Casa, mejor estar calladito. Es señal de cerrojazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755264
    m_Localized: 'FortuneTeller: ¿Te echo las cartas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755265
    m_Localized: ¿Qué fue de esa persona?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755266
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755267
    m_Localized: 'FortuneTeller: Le dije: "Da igual lo que hagas. Lo que importa es lo que tu aura desprende mientras lo haces". Jamás confió en mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755268
    m_Localized: 'FortuneTeller: Y así, la vida le dejó atrás.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755269
    m_Localized: 'FortuneTeller: Un día, cerré los ojos e imaginé un sueño.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755270
    m_Localized: 'FortuneTeller: Puse toda mi energía en esa visión.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755271
    m_Localized: 'FortuneTeller: Si no abres tu corazón a la energía, ¿para qué vivir en este cuerpo, dime tú?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755272
    m_Localized: 'FortuneTeller: Tú podrías hacer lo mismo. Cierra los ojos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755273
    m_Localized: 'FortuneTeller: Imagina que ya has conseguido lo que quieres...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755274
    m_Localized: 'FortuneTeller: Visualízalo bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755275
    m_Localized: 'FortuneTeller: ¿Sabes por qué sufres? Porque aún no entiendes que el sufrimiento es la forma más elevada de felicidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755276
    m_Localized: 'FortuneTeller: Así que... ¿Estás listo para dar ese salto?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755277
    m_Localized: 'FortuneTeller: ¿Te echo las cartas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755278
    m_Localized: ¿Qué quieres decir con "listo"?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755279
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755280
    m_Localized: 'FortuneTeller: Significa elegirte a ti mismo. ¿Hueles eso? Es el aroma de tus anhelos sin cumplir. Ya va siendo hora de soltarlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755281
    m_Localized: 'FortuneTeller: Cuando toqué fondo, sin luz ni norte, mi mentora me dijo una cosa: "No estás prestando oído a tu océano".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755282
    m_Localized: 'FortuneTeller: Al principio me causó gracia. ¡¿El océano?! Pero luego cerré los ojos y lo escuché. Siempre estuvo ahí. ¡Tú también puedes oírlo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755283
    m_Localized: 'FortuneTeller: Pero lo más importante es preguntarte, ¿estás listo para convertirte en uno contigo mismo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755284
    m_Localized: 'FortuneTeller: ¿Te echo las cartas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755285
    m_Localized: ¿Quién fue tu mentora?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755286
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755287
    m_Localized: 'FortuneTeller: Una gran mujer. Fue como un faro en plena tempestad. Me enseñó a ver la esencia de las cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755288
    m_Localized: 'FortuneTeller: Jamás olvidaré sus palabras: "La gente muere solo porque no aprende a dejar respirar su luz interior".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755289
    m_Localized: 'FortuneTeller: Ella me hizo entender yo podía ayudar a la gente a encontrar su camino único.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755290
    m_Localized: 'FortuneTeller: Pero, bueno, ella tenía miedo de ir más allá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755291
    m_Localized: 'FortuneTeller: Ella no se veía en el centro. Y es importante estar en el centro, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755292
    m_Localized: 'FortuneTeller: Si tú no eres el centro de tu universo, ¿quién eres? ¿Sí lo pillas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755293
    m_Localized: 'FortuneTeller: ¿Te echo las cartas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755294
    m_Localized: ¿Cómo eso te ayudó?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755295
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755296
    m_Localized: 'FortuneTeller: Todas tus equivocaciones son solo códigos dentro de tu universo que aún no has podido descifrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755297
    m_Localized: 'FortuneTeller: Recorrí un camino largo. Mira alrededor y echa la vista atrás. ¿Ves cómo es esta casa ahora, sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755298
    m_Localized: 'FortuneTeller: Brillante, espaciosa y en armonía con mi energía. No hace falta intentar luchar contra tu propia casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755299
    m_Localized: 'FortuneTeller: Ya ha absorbido tu miedo. Acéptalo, o las paredes empezarán a llorar tus propias lágrimas. ¿Lo pillas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755300
    m_Localized: 'FortuneTeller: ¿Te echo las cartas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755301
    m_Localized: ¿Qué buscas de mí?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755302
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755303
    m_Localized: 'FortuneTeller: Ay, mi cielo, ¿piensas que pretendo algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755304
    m_Localized: 'FortuneTeller: El problema es que si vieras bailar tu propia sombra, comprenderías dónde se oculta tu camino.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755305
    m_Localized: 'FortuneTeller: Solo necesitas recitar afirmaciones para ser feliz. Sientes que todo está cambiando, ¿verdad? Que es más fácil respirar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755306
    m_Localized: 'FortuneTeller: Esa es mi energía combinándose con tu espacio. No le busques sentido. Es una ilusión para los que temen aceptar el caos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755307
    m_Localized: 'FortuneTeller: Te pido que formes parte de ese espacio. Di: "No soy solo un huésped aquí, soy el autor de este santuario."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755308
    m_Localized: 'FortuneTeller: ¿Te echo las cartas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755309
    m_Localized: ¿Y si no quiero ser un "autor"?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755310
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755311
    m_Localized: 'FortuneTeller: Tus muros llevan mucho queriendo abrazarte, pero tú los confinas a las cadenas de tu control.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755312
    m_Localized: 'FortuneTeller: El silencio dentro de ti es la voz del mundo que estás sofocando con tu miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755313
    m_Localized: 'FortuneTeller: Tu energía se atasca como la miel en invierno. Tienes que calentarla con tu aliento. Y los espejos no mienten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755314
    m_Localized: 'FortuneTeller: Si todo lo que ves es a ti mismo, no ves nada en absoluto. Solo tienes que mover tu energía tres grados a la derecha.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755315
    m_Localized: 'FortuneTeller: Y por fin serás feliz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755316
    m_Localized: 'Fanatic: Estoy escuchando, humano. ¡Habla de una vez!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755317
    m_Localized: ¿Eres miembro de algún tipo de credo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755318
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755319
    m_Localized: 'Fanatic: ¡SÍ, HUMANO! Pero mi fe no es como las religiones que tú conoces.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755320
    m_Localized: 'Fanatic: ¡Rindo culto al SAGRADO SOL EN PERSONA! ¡PORQUE ÉL NOS AMPARA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755321
    m_Localized: 'Fanatic: Pero la gente estúpida solo percibe males en él. Creen que nos calcinará a todos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755322
    m_Localized: 'Fanatic: ¡PATRAÑAS! ¡Su furia va dirigida a las semillas del mal y a los herejes! Pues ellos son pecadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755323
    m_Localized: 'Fanatic: ¡Y ojalá que aquellos que estén en desacuerdo nunca se vean bajo su brazo ardiente de la justicia!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755324
    m_Localized: 'Fanatic: Buscan problemas y se sorprenden al ser quemados.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755325
    m_Localized: ¿Semillas del mal?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755326
    m_Localized: ¿Herejes?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755327
    m_Localized: 'Fanatic: ¿Sigues preguntando? ¿¡No te has encontrado jamás con EXTRATERRESTRES?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755328
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755329
    m_Localized: 'Fanatic: Vale, humano. Le diré la PURA VERDAD.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755330
    m_Localized: 'Fanatic: ¡¡¡LOS VISITANTES SON SEMILLAS DEL MAL!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755331
    m_Localized: 'Fanatic: ¡¡¡SON DESCENDIENTES DE EXTRATERRESTRES que llegaron a la Tierra cuando el Sol era más joven y la hierba más verde!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755332
    m_Localized: 'Fanatic: ¡¡¡CONDENADOS VASALLOS que establecieron sus hogares en la Tierra y se cruzaron entre sí durante SIGLOS!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755333
    m_Localized: 'Fanatic: ¡Y ahora, han emergido y pretenden tomar NUESTRAS TIERRAS COMO SI LES PERTENECIERAN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755334
    m_Localized: 'Fanatic: Pero el SOL ha decidido protegernos, porque ES NUESTRA TIERRA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755335
    m_Localized: 'Fanatic: ¡El Sol NO TIENE PIEDAD de los Visitantes! ¿O por qué se habrían ocultado bajo tierra tanto tiempo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755336
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755337
    m_Localized: 'Fanatic: Maldición... ¿Por qué bebió hasta perder el juicio aquella noche...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755338
    m_Localized: 'Fanatic: No hacía falta embriagarte hasta la inconsciencia. La cólera justa del Sagrado Sol, él...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755339
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755340
    m_Localized: 'Fanatic: SAGRADO SOL, perdónale nuestros pecados, ¡pues no es más que un ignorante!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755341
    m_Localized: 'Fanatic: Recíbelo en tu abrazo amoroso. Y quizá el alma del ficus, al que ya no podrá regar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755342
    m_Localized: 'Fanatic: Amén.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755343
    m_Localized: 'Fanatic: ¡Ha escuchado bien, humano!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755344
    m_Localized: 'Fanatic: ¡Los de la AFAE son unos MALDITOS HEREJES!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755345
    m_Localized: 'Fanatic: ¡Interfieren en procesos que van más allá de NUESTRO control! ¡El control de la GENTE NORMAL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949376
    m_Localized: 'Fanatic: Meten sus narices donde no deben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949377
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949378
    m_Localized: 'Fanatic: ¡Que el Sol condene a esos gilipollas que arrojaron a mi madre a un barrizal!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949379
    m_Localized: 'Fanatic: Estoy escuchando, humano. ¡Habla de una vez!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949380
    m_Localized: Pues, por algún motivo, el sol ha quemado a un montón de gente últimamente
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949381
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949382
    m_Localized: 'Fanatic: ¡Tiene razón! ¡A toda semilla de maldad, humano!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949383
    m_Localized: 'Fanatic: ¡El Sol decidió escarmentarlos A TODOS por los pecados que se han cometido durante UN MILLAR DE AÑOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949384
    m_Localized: 'Fanatic: ¡Y LOS VISITANTES, esos putos imbéciles, han empezado a alzarse por el SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949385
    m_Localized: 'Fanatic: ¡Pero el SOL no es para ellos, los subterráneos, sino para nosotros, para los HUMANOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949386
    m_Localized: 'Fanatic: ¡ES NUESTRO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949387
    m_Localized: 'Fanatic: ¡HOSTIA, QUE ES UNA BENDICIÓN PARA LA HUMANIDAD, JODER!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949388
    m_Localized: ¿Y cuánta gente más necesita arder para apaciguar al sol?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949389
    m_Localized: ¿Estás diciendo que el fin del mundo es la justicia del sol?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949390
    m_Localized: 'Fanatic: Muchos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949391
    m_Localized: 'Fanatic: Y créame, amigo mío, ESTÁ LEJOS DE TERMINAR.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949392
    m_Localized: 'Fanatic: ¡NO HA HECHO MÁS QUE EMPEZAR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949393
    m_Localized: 'Fanatic: ¡La BALANZA aún no está lo suficientemente llena para contrarrestar las FUERZAS DEL UNIVERSO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949394
    m_Localized: 'Fanatic: ¡MÁS DEBEN ARDER en las llamas justas del SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949395
    m_Localized: 'Fanatic: Pero tenga presente esto, amigo mío: ¡estas víctimas no morirán en vano!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949396
    m_Localized: 'Fanatic: Algún día, todos comprenderemos el verdadero plan del Sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949397
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949398
    m_Localized: 'Fanatic: Hombre, a veces de noche, me entra una tristeza tan grande de que mi mujer me dejara...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949399
    m_Localized: 'Fanatic: Era una mujer santa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949400
    m_Localized: 'Fanatic: Pero también una zorra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949401
    m_Localized: 'Fanatic: ¿El fin para quién?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949402
    m_Localized: 'Fanatic: ¿Para nosotros?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949403
    m_Localized: 'Fanatic: ¡Já!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949404
    m_Localized: 'Fanatic: No me hagas reír. ¡EL SOL ESTÁ DE NUESTRO LADO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949405
    m_Localized: 'Fanatic: ¿No ves que es nuestro salvador?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949406
    m_Localized: 'Fanatic: Está intentando empujar de vuelta a los Visitantes a las entrañas de la tierra...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949407
    m_Localized: 'Fanatic: Está castigando a la gente terrible por los pecados de la humanidad...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949408
    m_Localized: 'Fanatic: ¡Revela a los herejes que se esconden vergonzosamente tras sus máscaras, en sus trapos orinados!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949409
    m_Localized: 'Fanatic: Hemos de agradecer al Sol, no empezar a quejarnos del fin del mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949410
    m_Localized: 'Fanatic: ¡ES EL FIN PARA TODOS LOS ENEMIGOS DEL SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949411
    m_Localized: 'Fanatic: ¡QUE MUERAN LOS SUBTERRÁNEOS! ¡QUE SE JODAN LOS HEREJES DE MIERDA! ¡Y QUE ARDA LA SEMILLA DEL MAL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949412
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949413
    m_Localized: 'Fanatic: ¡Madre mía, qué de tiempo sin probar unas patatas fritas...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949414
    m_Localized: 'Fanatic: Estoy escuchando, humano. ¡Habla de una vez!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949415
    m_Localized: ¿Piensas que lo que está ocurriendo tiene algún significado sagrado?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949416
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949417
    m_Localized: 'Fanatic: Humano, dime... ¿Para qué te expliqué esto con lujo de detalles, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949418
    m_Localized: 'Fanatic: ¡¿Para que vengas a hacerme EXACTAMENTE LA MISMA PREGUNTA?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949419
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949420
    m_Localized: 'Fanatic: Parece que te he juzgado mal, humano. No comprendes las verdaderas razones de lo que está ocurriendo en absoluto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949421
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949422
    m_Localized: 'Fanatic: Joder, ojalá tuviera una cerveza fría...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949423
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949424
    m_Localized: 'Fanatic: ¿Te importaría invitarme una, humano?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949425
    m_Localized: Claro, toma (Darle una cerveza)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949426
    m_Localized: 'Fanatic: ¿No tienes cerveza, humano? ¡Pero sí que estás es fatal de la cabeza!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949427
    m_Localized: 'Fanatic: ¡¡¡Vi dentro de la nevera CON MIS PROPIOS OJOS!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949428
    m_Localized: 'Fanatic: ¡Venga, humano! ¡Beber tanta cerveza y sin atreverse a COMPARTIR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949429
    m_Localized: No (No darle una cerveza).
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949430
    m_Localized: 'Fanatic: Ahh, gracias al Sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949431
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949432
    m_Localized: 'Fanatic: Mmm, qué bueno. Está oscura, mi preferida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949433
    m_Localized: 'Fanatic: Esto me recuerda a las tertulias en el bar con mis colegas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949434
    m_Localized: 'Fanatic: Conversaciones geniales, cañas frías, colines y salsa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949435
    m_Localized: 'Fanatic: Y la cara de pocos amigos de aquel tío enclenque que siempre nos miraba con mala leche...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949436
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949437
    m_Localized: 'Fanatic: Venga, no hay razón para enfadarse. Puede que seas un humano estúpido, pero al menos es majo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949438
    m_Localized: 'Fanatic: Déjame darte un pequeño obsequio de agradecimiento. Coge esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949439
    m_Localized: 'Fanatic: ¡Que el Sagrado Sol salve tu alma!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949440
    m_Localized: 'Fanatic: ¡ESCORIA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949441
    m_Localized: 'Fanatic: ¡QUE TE PUDRAS EN EL INFIERNO, HIJO DE PUTA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949442
    m_Localized: 'Fanatic: ¡La ingratitud! Te expliqué los significados sagrados, la trascendencia, y...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949443
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949444
    m_Localized: 'Fanatic: ¡Eres un HUMANO MALVADO Y ESTÚPIDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949445
    m_Localized: 'Fanatic: Que te den por saco. ¡Pues quédate encerrado en tu puñetera chabola! Encontraré un mejor sitio que este.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949446
    m_Localized: 'Fanatic: Ya verás, me dejarán volver al bar. Estoy seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949447
    m_Localized: 'Fanatic: Que tengas una buena estadía, imbécil.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949448
    m_Localized: 'Anxiety: Je... je... Espero que todo esto acabe pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949449
    m_Localized: ¿Cómo fue que perdiste tu hogar?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949450
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949451
    m_Localized: 'Anxiety: Ahh... Recuerdo bien ese día.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949452
    m_Localized: 'Anxiety: Me echaron del trabajo y yo solo quería volver a casa, meterme en la cama y llorar a gusto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949453
    m_Localized: 'Anxiety: Llegué allí y vi un montón de botas en el pasillo. Pensé que mi compañera de piso tendría amigos o familiares de visita.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949454
    m_Localized: 'Anxiety: Fui a su habitación para ver qué hacía. Al llegar a su puerta, oí un ruido extraño.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949455
    m_Localized: 'Anxiety: Me inquietó un poco, así que decidí echar un vistazo a hurtadillas para ver qué ocurría allí dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949456
    m_Localized: 'Anxiety: Solo alcancé a ver a mi compañera tendida e inmóvil en la cama cuando de repente...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949457
    m_Localized: 'Anxiety: Un tipo desgreñado me agarró por detrás y me dijo: "No puedes entrar ahí. Ella... no se encuentra bien."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949458
    m_Localized: 'Anxiety: "Será mejor que vayamos a sentarnos a la cocina". Luego me tiró del brazo y me sentó a la mesa de la cocina.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949459
    m_Localized: 'Anxiety: Quería marcharme, pero el miedo me tenía paralizada... Y entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949460
    m_Localized: 'Anxiety: Yo... Él...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949461
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949462
    m_Localized: 'Anxiety: Necesito descansar. Yo... eh... el estómago me da vueltas de la ansiedad. Ugh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949463
    m_Localized: 'Anxiety: Je... je... Espero que todo esto acabe pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949464
    m_Localized: ¿Y qué pasó después en tu casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949465
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949466
    m_Localized: 'Anxiety: Ugh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949467
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949468
    m_Localized: 'Anxiety: Después de que el hombre me sentara en la mesa, un tío enorme que estaba escondido en una esquina bloqueó la salida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949469
    m_Localized: 'Anxiety: Empezó a hablar en voz alta con el tipo que me había cogido del brazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949470
    m_Localized: 'Anxiety: Como... Como si yo no pintara nada. Y entonces... ¡empezaron a tocarme!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949471
    m_Localized: 'Anxiety: Primero mis brazos, luego mis hombros...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949472
    m_Localized: 'Anxiety: Y de fondo, escuché vítores y una carcajada fuerte que parecía venir de mi habitación...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949473
    m_Localized: 'Anxiety: Sonaba como si hubiera una multitud de hombres ahí dentro. ¡Jajaja...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949474
    m_Localized: 'Anxiety: Um... e-empecé a tener dificultad para respirar. Sentía el corazón a punto de explotarme...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949475
    m_Localized: 'Anxiety: Quería gritar y pedir auxilio, pero mi voz... El miedo me impidió siquiera hacer un ruido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949476
    m_Localized: 'Anxiety: Me quedé sentada allí, inútil como un osito de peluche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949477
    m_Localized: 'Anxiety: Pero cuando el grandullón fue a la nevera a por algo, me di cuenta de que esa era mi oportunidad...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949478
    m_Localized: 'Anxiety: Salí disparada hacia la salida. Fue como si el miedo me diera fuerza. Y corrí, sin volver la vista atrás.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949479
    m_Localized: 'Anxiety: Hasta que me quedé sin aliento y me desplomé en el suelo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949480
    m_Localized: ¿Cómo no te has quemado con el sol?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949481
    m_Localized: ¿Qué sucedió después?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949482
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949483
    m_Localized: 'Anxiety: No me acuerdo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949484
    m_Localized: 'Anxiety: Debo de haber pasado toda la noche allí tumbada y luego...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949485
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949486
    m_Localized: 'Anxiety: Es extraño... Creía recordar todo lo que me pasó...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949487
    m_Localized: 'Anxiety: Espera, no creerás que yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949488
    m_Localized: 'Anxiety: Que yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949489
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949490
    m_Localized: 'Anxiety: Podría ser una Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949491
    m_Localized: 'Anxiety: No, eso no puede ser verdad. Recuerdo mi vida. Mi infancia, a mi madre y a mi padre. ¡No!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949492
    m_Localized: 'Anxiety: No soy una Visitante, ¿verdad? ¡Dime que no soy una Visitante!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949493
    m_Localized: No lo sé
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949494
    m_Localized: No eres una Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949495
    m_Localized: Pareces una Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949496
    m_Localized: 'Anxiety: Estaba tumbada en el suelo, y entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949497
    m_Localized: 'Anxiety: Y entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949498
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949499
    m_Localized: 'Anxiety: Definitivamente creía recordar lo que pasó...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949500
    m_Localized: 'Anxiety: Espera, no creerás que yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949501
    m_Localized: 'Anxiety: Que yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949502
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949503
    m_Localized: 'Anxiety: Podría ser una Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949504
    m_Localized: 'Anxiety: No, eso no puede ser verdad. Recuerdo mi vida. Mi infancia, a mi madre y a mi padre. ¡No!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949505
    m_Localized: 'Anxiety: No soy una Visitante, ¿verdad? ¡Dime que no soy una Visitante!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949506
    m_Localized: No lo sé
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949507
    m_Localized: No eres una Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949508
    m_Localized: Pareces una Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949509
    m_Localized: 'Anxiety: ¡¿POR QUÉ DIRÍAS ESO?! Ay, Dios, ay, Dios, ay, Dios, ¡AY DIOS MÍO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949510
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949511
    m_Localized: 'Anxiety: Necesito... necesito tumbarme. Siento que se me está revolviendo el estómago otra vez. Ugh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949512
    m_Localized: 'Anxiety: Gracias, eso me hace sentir mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949513
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949514
    m_Localized: 'Anxiety: Ugh, necesito tumbarme. Se me revuelve el estómago otra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949515
    m_Localized: 'Anxiety: ¡¿POR QUÉ DIRÍAS ESO?! ¡Ahora estoy mucho más asustada!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949516
    m_Localized: 'Anxiety: ¡NO QUIERO MORIR! ¡NO QUIERO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949517
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949518
    m_Localized: 'Anxiety: Todos vamos a morir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949519
    m_Localized: 'Anxiety: Je... je... Espero que todo esto acabe pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949520
    m_Localized: ¿Te encuentras bien?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949521
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949522
    m_Localized: 'Anxiety: ¡NO TE ACERQUES MÁS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949523
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949524
    m_Localized: 'Anxiety: Perdón, es que... creí que ibas a matarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949525
    m_Localized: ¿Qué te hace pensar eso?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949526
    m_Localized: Si quisiera matarte, llevarías muerta mucho tiempo
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949527
    m_Localized: 'Anxiety: Yo ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949528
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949529
    m_Localized: 'Anxiety: No tengo ni la menor idea de quién es un Visitante y quién no... ¿Y si...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949530
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949531
    m_Localized: 'Anxiety: ¿Y si tú eres un Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949532
    m_Localized: 'Anxiety: ¿Me vas a matar? ¿A despellejar?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949533
    m_Localized: 'Anxiety: ¡POR FAVOR, NO! SOLO MÁTAME RÁPIDO Y SIN DOLOR.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949534
    m_Localized: 'Anxiety: NO QUIERO MORIR AGONIZANDO. ¡POR FAVOR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949535
    m_Localized: Relájate, no soy un Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949536
    m_Localized: No te voy a matar
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949537
    m_Localized: 'Anxiety: Perdona, es que ya estoy que no puedo más con los nervios.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949538
    m_Localized: 'Anxiety: No tengo ni idea de en quién puedo confiar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949539
    m_Localized: 'Anxiety: ¿Y si...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949540
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949541
    m_Localized: 'Anxiety: ¿Y si tú eres un Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949542
    m_Localized: 'Anxiety: ¿Me vas a matar? ¿A despellejar?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949543
    m_Localized: 'Anxiety: ¡POR FAVOR, NO! SOLO MÁTAME RÁPIDO Y SIN DOLOR.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949544
    m_Localized: 'Anxiety: NO QUIERO MORIR AGONIZANDO. ¡POR FAVOR!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949545
    m_Localized: Relájate, no soy un Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949546
    m_Localized: No te voy a matar
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949547
    m_Localized: 'Anxiety: ¿¡Y CÓMO LO SÉ YO!? No te he mirado los dientes ni los ojos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949548
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949549
    m_Localized: 'Anxiety: Vamos a morir todos. Ya sea por los Visitantes o por el Sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949550
    m_Localized: 'Anxiety: No queda esperanza. La muerte llega, sin importar lo que hagamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949551
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949552
    m_Localized: 'Anxiety: Déjame en paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949553
    m_Localized: 'Anxiety: ¿¡Y CÓMO LO SÉ YO!? No te he mirado los dientes ni los ojos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949554
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949555
    m_Localized: 'Anxiety: Vamos a morir todos. Ya sea por los Visitantes o por el Sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949556
    m_Localized: 'Anxiety: No queda esperanza. La muerte llega, sin importar lo que hagamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949557
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949558
    m_Localized: 'Anxiety: Déjame en paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949559
    m_Localized: 'Anxiety: Je... je... Espero que todo esto acabe pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949560
    m_Localized: ¿Qué te ocurre?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949561
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949562
    m_Localized: 'Anxiety: ¡LOS VISITANTES! ¡VIENEN A POR NOSOTROS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949563
    m_Localized: 'Anxiety: ¿No lo oyes? LA MUERTE NOS LLAMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949564
    m_Localized: 'Anxiety: ¡¿VISITANTE, HUMANO...? ¡¿QUÉ MÁS DA?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949565
    m_Localized: 'Anxiety: ANTE LA MUERTE TODOS SOMOS IGUALES.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949566
    m_Localized: 'Anxiety: ¿Entonces por qué torturarnos esperando? ¡QUE VENGAN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949567
    m_Localized: 'Anxiety: ¡QUIEREN LO MEJOR PARA NOSOTROS! ¡QUE VENGAN LOS VISITANTES!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949568
    m_Localized: No pareces estar bien...
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949569
    m_Localized: ¿Has perdido la cabeza?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949570
    m_Localized: 'Anxiety: ¡NO, SIMPLEMENTE HE VISTO LA LUZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949571
    m_Localized: 'Anxiety: ¡SOY UNA VISITANTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949572
    m_Localized: 'Anxiety: NOSOTROS Y LOS HUMANOS SOMOS UNO. ¡SOMOS TAN SIMILARES!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949573
    m_Localized: 'Anxiety: ¡SOMOS COMO REFLEJOS EN UN ESPEJO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949574
    m_Localized: 'Anxiety: ¡ACEPTA LA MUERTE CON NOSOTROS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949575
    m_Localized: ¿Te das cuenta de las locuras que dices?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949576
    m_Localized: No me dejas otra opción
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949577
    m_Localized: 'Anxiety: ¡NO ESTOY LOCA, HE VISTO LA LUZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949578
    m_Localized: 'Anxiety: ¡SOY UNA VISITANTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949579
    m_Localized: 'Anxiety: NOSOTROS Y LOS HUMANOS SOMOS UNO. ¡SOMOS TAN SIMILARES!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949580
    m_Localized: 'Anxiety: ¡SOMOS COMO REFLEJOS EN UN ESPEJO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949581
    m_Localized: 'Anxiety: ¡ACEPTA LA MUERTE CON NOSOTROS! ¡LLEGARÁ PRONTO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949582
    m_Localized: ¿Te das cuenta de las locuras que dices?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949583
    m_Localized: No me dejas otra opción
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949584
    m_Localized: 'Anxiety: ¡No, no entiendes nada!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949585
    m_Localized: 'Anxiety: ¡La muerte viene! EL SOL ANUNCIA LA LLEGADA DE LA MUERTE.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949586
    m_Localized: 'Anxiety: La encontraremos pronto. Muy pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949587
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949588
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949589
    m_Localized: 'Anxiety: ¡Pues dispara ya! ¡¿A qué esperas?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949590
    m_Localized: 'Anxiety: ¿VAS A MATAR SIN EL MÁS MÍNIMO REMORDIMIENTO?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949591
    m_Localized: 'Anxiety: Me da igual. HAZ LO QUE DEBAS HACER, HUMANO.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949592
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949593
    m_Localized: Dispararle
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949594
    m_Localized: 'Esenin: ¿Eh? ¿Se te ofrece algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949595
    m_Localized: Así que, ¿por qué te echaron del bar?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949596
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949597
    m_Localized: 'Esenin: Porque la serie de catástrofes hizo que todo el mundo se volviera loco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949598
    m_Localized: 'Esenin: La explosión del sol, los Visitantes, la crisis económica... y es que la cosa no acaba ahí. Es un desastre tras otro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949599
    m_Localized: 'Esenin: A todos nos jodió. O sea, a algunos les dio estrés, a otros les dio por el alcohol.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949600
    m_Localized: 'Esenin: Bueno... a mí se me fue la olla con la mala leche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949601
    m_Localized: 'Esenin: Me encaramé a una mesa en el bar y grité: "Joder, dejad de culpar a todo lo que os rodea. ¡Un poco de humanidad, coño!"'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949602
    m_Localized: 'Esenin: Y que lloren, me la suda. Las lágrimas en la cerveza no arruinan el trago. Es más, la sal le sienta bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949603
    m_Localized: 'Esenin: ¿Igual a quién le importa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949604
    m_Localized: 'Esenin: ¿Eh? ¿Se te ofrece algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949605
    m_Localized: ¿Crees que aquí es diferente?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949606
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949607
    m_Localized: 'Esenin: Ahora paso de molestar a nadie. No merece la pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949608
    m_Localized: 'Esenin: Total, que oyes la tele o pillas conversaciones y te vuelves a irritar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949609
    m_Localized: 'Esenin: Ahí te preguntas: "¿Realmente necesito esto?"'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949610
    m_Localized: 'Esenin: No, buen hombre, ya estoy hecho un manojo de nervios.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949611
    m_Localized: 'Esenin: La vida ya era bastante chunga sin todo esto y ahora...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949612
    m_Localized: 'Esenin: Podría solo gritarle al mundo entero desde lo alto de un edificio y ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949613
    m_Localized: 'Esenin: ¿Eh? ¿Se te ofrece algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949614
    m_Localized: ¿Todo bien?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949615
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949616
    m_Localized: 'Esenin: ¿Eh? ¿A qué viene eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949617
    m_Localized: ¿A qué hueles?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949618
    m_Localized: ¿Tienes calentura?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949619
    m_Localized: 'Esenin: Bueno... bebí un poco de tu cerveza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949620
    m_Localized: 'Esenin: Me sentí fatal, así que decidí beber un poco de medicina. No es un delito ni nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949621
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949622
    m_Localized: 'Esenin: Todo es un puto desastre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949623
    m_Localized: 'Esenin: Todo el mundo dice que está solucionando problemas, pero es todo mierda; nunca pasa nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949624
    m_Localized: 'Esenin: ¿Sabes? Creo que igual todos vamos a palmarla pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949625
    m_Localized: 'Esenin: Si el sol no nos mata, lo harán los Visitantes. Y si acabamos con los Visitantes, seguro vamos a terminar enterrándonos entre nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949626
    m_Localized: 'Esenin: Y es que si no hay suficientes putos problemas, nos los creamos nosotros mismos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949627
    m_Localized: 'Esenin: Como si no pudiéramos vivir sin cagarnos encima.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949628
    m_Localized: 'Esenin: Hostia'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949629
    m_Localized: 'Esenin: Vete, que me siento fatal.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949630
    m_Localized: 'Esenin: La calentura no la tengo yo. La tiene todo el jodido planeta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949631
    m_Localized: 'Esenin: Mires donde mires, alguien se está muriendo. O los glaciares se funden. O los bosques arden. El mundo tiene calentura.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949632
    m_Localized: 'Esenin: La Tierra intenta sacudirnos como pulgas cargadas de sangre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949633
    m_Localized: 'Esenin: Algún día, lo conseguirá. Y no creas que será indoloro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949634
    m_Localized: 'Esenin: ¡Urghh...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949635
    m_Localized: 'Esenin: Vete, joder. Por favor. No me encuentro bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949636
    m_Localized: 'Esenin: ¿Eh? ¿Se te ofrece algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949637
    m_Localized: ¿Te encuentras algo mejor?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949638
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949639
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949640
    m_Localized: 'Esenin: Mi buen amigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949641
    m_Localized: 'Esenin: Todos vamos a morir algún día. Es inevitable.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949642
    m_Localized: 'Esenin: ¿Alguna vez te ha preguntado qué nos sucederá al morir?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949643
    m_Localized: Pues, creo que será lo que tenga que ser
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949644
    m_Localized: Nada
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949645
    m_Localized: No lo sé... quizás acabamos yendo al espacio
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949646
    m_Localized: 'Esenin: Hay algo de razón en eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949647
    m_Localized: 'Esenin: Pero no me hace sentir ni una puta mierda mejor. ¿Sabes por qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949648
    m_Localized: 'Esenin: Cuando me esté muriendo, mi cerebro lo pillará. Empezará a enseñarme algo a lo que molaría volver.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949649
    m_Localized: 'Esenin: Y cuando mi energía para ese sueño se desvanezca, ¿entonces qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949650
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949651
    m_Localized: 'Esenin: No. La verdad es que nada de esto me hace sentir mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949652
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949653
    m_Localized: 'Esenin: Tenía muchas ganas de que dijeras otra cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949654
    m_Localized: 'Esenin: Podría tener razón, claro. Pero eso es terrible.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949655
    m_Localized: 'Esenin: ¿Que no haya nada en absoluto...? Solo... ¿oscuridad?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949656
    m_Localized: 'Esenin: Ahora mismo no me apetece mucho hablar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143680
    m_Localized: 'Esenin: Si lo piensas bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143681
    m_Localized: 'Esenin: En el espacio no hay nada más que nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143682
    m_Localized: 'Esenin: No existen otras formas vida. Solo está el espacio frío y desolado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143683
    m_Localized: 'Esenin: Si la hubiera, seguramente ya habríamos hallado alguna señal o algo parecido. Qué sé yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143684
    m_Localized: 'Esenin: El espacio es un vacío de oscuridad sin fin. Si acabamos ahí después de la muerte, es como esfumarse...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337984
    m_Localized: 'Esenin: Quiero... quiero estar solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337985
    m_Localized: 'Esenin: ¿Eh? ¿Se te ofrece algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337986
    m_Localized: ¿Estás... Estás bien?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337987
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337988
    m_Localized: 'Esenin: Al menos el bar tenía techos altos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337989
    m_Localized: 'Esenin: Uno podría ahorcarse allí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337990
    m_Localized: 'Esenin: Aquí dentro es demasiado agobiante para mí. Todo el planeta es demasiado agobiante para mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337991
    m_Localized: 'Esenin: Mi buen amigo, solo quiero que todo esto termine.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337992
    m_Localized: 'Esenin: Todo es un puto desastre. Todo me acojona muchísimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337993
    m_Localized: 'Esenin: Simplemente ya no puedo soportarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337994
    m_Localized: 'Esenin: ¿Por qué vine aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337995
    m_Localized: 'Widow: Me vendría bien un poco de descanso...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337996
    m_Localized: ¿Necesitas algo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337997
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337998
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337999
    m_Localized: 'Widow: Que él estuviera vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338000
    m_Localized: 'Widow: Eso es todo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338001
    m_Localized: 'Widow: Es todo lo que necesito.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338002
    m_Localized: ¿Te apetece un poco de agua?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338003
    m_Localized: ¿Quisieras algo de comer?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338004
    m_Localized: 'Widow: Solo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338005
    m_Localized: 'Widow: Me sentaré aquí junto al grifo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338006
    m_Localized: 'Widow: Beberé si lo necesito.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338007
    m_Localized: Entonces te dejaré en paz
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338008
    m_Localized: ¿Puedo sentarme contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338009
    m_Localized: 'Widow: No tengo hambre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338010
    m_Localized: 'Widow: Solo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338011
    m_Localized: 'Widow: Solo quiero sentarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338012
    m_Localized: Entonces te dejaré en paz
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338013
    m_Localized: ¿Puedo sentarme contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338014
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338015
    m_Localized: 'Widow: ¿Por qué tuviste que irte y morir?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338016
    m_Localized: 'Widow: Me prometiste que todo iría a mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338017
    m_Localized: 'Widow: Dijiste que todo mejoraría.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338018
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338019
    m_Localized: 'Widow: Y entonces moriste.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338020
    m_Localized: 'Widow: Ahora soy la única que queda con vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338021
    m_Localized: 'Widow: ¿Por qué hiciste eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338022
    m_Localized: 'Widow: Quiero estar con él.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338023
    m_Localized: 'Widow: Y no me lo puedes devolver.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338024
    m_Localized: 'Widow: Ni siquiera puedo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338025
    m_Localized: 'Widow: Enterrar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338026
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338027
    m_Localized: 'Widow: No puedo enterrarle...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338028
    m_Localized: 'Widow: ¿Qué se supone que haga?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338029
    m_Localized: 'Widow: Me vendría bien un poco de descanso...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338030
    m_Localized: ¿Cómo murió?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338031
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338032
    m_Localized: 'Widow: No puedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338033
    m_Localized: 'Widow: Es demasiado.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338034
    m_Localized: 'Widow: Se me han acabado las lágrimas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338035
    m_Localized: 'Widow: Ya no me quedan más lágrimas que llorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338036
    m_Localized: 'Widow: ¿Pero eso está bien?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338037
    m_Localized: 'Widow: Solo dejar de llorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338038
    m_Localized: Necesita ser enterrado
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338039
    m_Localized: Lo único que queda de él es un cuerpo. Necesitas aceptarlo.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338040
    m_Localized: 'Widow: No...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338041
    m_Localized: 'Widow: ¡No, no, no!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338042
    m_Localized: 'Widow: No estoy lista.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338043
    m_Localized: 'Widow: Me lo acaban de devolver.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338044
    m_Localized: 'Widow: ¿Y ahora debemos separarnos de nuevo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338045
    m_Localized: 'Widow: No puedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338046
    m_Localized: 'Widow: No se lo daré a la tierra fría y sin corazón.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338047
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338048
    m_Localized: 'Widow: No.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338049
    m_Localized: 'Widow: No, eso no es verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338050
    m_Localized: 'Widow: Aún puede escucharme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338051
    m_Localized: 'Widow: Yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338052
    m_Localized: 'Widow: De verdad quiero creer eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338053
    m_Localized: 'Widow: Me vendría bien un poco de descanso...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338054
    m_Localized: ¿Qué recuerdas de él?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338055
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338056
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338057
    m_Localized: 'Widow: Un día fuimos a casa de nuestros amigos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338058
    m_Localized: 'Widow: Éramos mucho más jóvenes por aquel entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338059
    m_Localized: 'Widow: Estábamos pasando el rato, bebiendo. Él solía ser bastante callado y no hablaba mucho en reuniones así.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338060
    m_Localized: 'Widow: Bueno, habíamos estado bebiendo mucho ese día.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338061
    m_Localized: 'Widow: Estaba con su habitual silencio y, de repente, dijo:'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338062
    m_Localized: 'Widow: "Dadme una guitarra. Voy a cantar ahora mismo."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338063
    m_Localized: 'Widow: Y tocó tan bien. Me encantó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338064
    m_Localized: 'Widow: Nuestros amigos empezaron a pedir varias canciones y él se quedó sentado un momento, y luego...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338065
    m_Localized: 'Widow: Luego se levantó, dijo que debía marcharse, tiró un vaso, intentó atraparlo, se le cayó la guitarra...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338066
    m_Localized: 'Widow: Luego supe que aprendió una sola canción solo para impresionarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338067
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338068
    m_Localized: 'Widow: Todavía tengo una foto de esa noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338069
    m_Localized: 'Widow: Está un poco estropeada...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338070
    m_Localized: 'Widow: Ahora ya no puedes tocar para mí. Me has cantado tu última melodía.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338071
    m_Localized: 'Widow: Me vendría bien un poco de descanso...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338072
    m_Localized: ¿Y bien? ¿Qué le sucedió?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338073
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338074
    m_Localized: 'Widow: Que ha muerto, joder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338075
    m_Localized: Vale, perdón por molestar
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338076
    m_Localized: Yo no lo maté
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338077
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338078
    m_Localized: 'Widow: Perdona, es que... no puedo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338079
    m_Localized: 'Widow: Las lágrimas vienen cada noche. No puedo pararlas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338080
    m_Localized: 'Widow: Solo quiero que los responsables de todo lo que pasó... quisiera que ardieran bajo el sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338081
    m_Localized: Entonces... ¿Qué ocurrió?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338082
    m_Localized: Ya no te volveré a preguntar
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338083
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338084
    m_Localized: 'Widow: Sí. Lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338085
    m_Localized: 'Widow: Eso fue grosero. Pero me cuesta tanto hablar de él.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338086
    m_Localized: 'Widow: Ojalá esos canallas obtengan su merecido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338087
    m_Localized: 'Widow: Y que alguien los mate.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338088
    m_Localized: Entonces... ¿Qué ocurrió?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338089
    m_Localized: Ya no te volveré a preguntar
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338090
    m_Localized: 'Widow: Mi marido no se encontraba bien. Fue al hospital, pero lo enviaron con esos bastardos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338091
    m_Localized: 'Widow: Fuimos al centro que la AFAE había abierto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338092
    m_Localized: 'Widow: Solo lo pusieron en cuarentena. Le quitaron el móvil. Dijeron que lo dejarían salir en tres semanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338093
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338094
    m_Localized: 'Widow: Regresé antes, solo para comprobar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338095
    m_Localized: 'Widow: Me dijeron con frialdad que...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338096
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338097
    m_Localized: 'Widow: Deme un minuto. Lo siento.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338098
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338099
    m_Localized: 'Widow: Todo lo que dijeron fue: "Está muerto."'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338100
    m_Localized: 'Widow: Eso fue todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338101
    m_Localized: 'Widow: No me dejaron ver el cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338102
    m_Localized: 'Widow: No me dejaron llevarlo a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338103
    m_Localized: 'Widow: Pero las cosas siempre son un puto caos con esos ineptos, así que me bastó con ponerme una bata blanca e ir a la morgue.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338104
    m_Localized: 'Widow: Y él...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338105
    m_Localized: 'Widow: Realmente estaba allí...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338106
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338107
    m_Localized: 'Widow: Lo mataron... su alma está en sus manos. Lo único que puedo hacer ahora es gritar que no me importa nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338108
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338109
    m_Localized: 'Widow: Quisiera estar sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338110
    m_Localized: 'Widow: Sí. Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338111
    m_Localized: 'Widow: Vivir sin él es tan duro...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338112
    m_Localized: 'Widow: Me vendría bien un poco de descanso...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338113
    m_Localized: ¿Ocurre algo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338114
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338115
    m_Localized: 'Widow: Me marcho esta noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338116
    m_Localized: 'Widow: Ya te había dicho que no pensaba quedarme por mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338117
    m_Localized: 'Widow: Solo necesitaba descansar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338118
    m_Localized: ¿Y ahora qué?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338119
    m_Localized: ¿Vas a ir con tu familia?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338120
    m_Localized: 'Widow: No quiero pensar en ello.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338121
    m_Localized: 'Widow: Creo... creo que solo volveré a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338122
    m_Localized: 'Widow: Sacaré la guitarra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338123
    m_Localized: 'Widow: Y entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338124
    m_Localized: Puedes quedarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338125
    m_Localized: Buena suerte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338126
    m_Localized: 'Widow: Ya no queda nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338127
    m_Localized: 'Widow: Nos vamos a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338128
    m_Localized: 'Widow: Ya no quiero nada más.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338129
    m_Localized: Puedes quedarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338130
    m_Localized: Buena suerte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338131
    m_Localized: 'Widow: Ya, ¿pero para qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338132
    m_Localized: 'Widow: No me hará las cosas más fáciles.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338133
    m_Localized: 'Widow: Sin ánimo de ofender, pero realmente no me importas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338134
    m_Localized: 'Widow: De verdad quiero irme a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338135
    m_Localized: 'Widow: No quiero hacer nada hasta que vuelva.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338136
    m_Localized: 'Widow: Gracias...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338137
    m_Localized: 'Widow: No hablas mucho, pero... eres bueno escuchando.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338138
    m_Localized: 'Widow: Espero que encuentres lo que buscas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338139
    m_Localized: 'Scammer: Jeje. ¿Qué tal?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338140
    m_Localized: ¿A qué te dedicabas antes del Cataclismo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338141
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338142
    m_Localized: 'Scammer: Uuuy, me alegro de que preguntes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338143
    m_Localized: 'Scammer: ¿Has oído hablar alguna vez de...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338144
    m_Localized: 'Scammer: ¿...las apuestas deportivas?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338145
    m_Localized: ¿Qué eres, un timador?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338146
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338147
    m_Localized: 'Scammer: ¡Eh, venga, tío! Soy un puto analista deportivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338148
    m_Localized: 'Scammer: Si supieras la pasta que cayó en mis manos, estarías babeando, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338149
    m_Localized: 'Scammer: Soy un profesional en mi negocio, cabrón.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338150
    m_Localized: 'Scammer: La gente me traía su dinero y yo les traía cinco... no, DIEZ veces más de pasta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338151
    m_Localized: Entonces, ¿cuánto te sacaste?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338152
    m_Localized: ¿A eso le llamas trabajar?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338153
    m_Localized: 'Scammer: Era mi modo de ganarme la vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338154
    m_Localized: 'Scammer: Echar unas apuestas era simplemente por hacer algo, tío. En serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338155
    m_Localized: 'Scammer: Hay maneras de engañar a las casas de apuestas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338156
    m_Localized: 'Scammer: Apostabas a un equipo concreto y esperabas a que la pasta volviera rodando.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338157
    m_Localized: 'Scammer: Y si no tenías pasta, sin problema. Se la mangabas a cualquiera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338158
    m_Localized: Entonces, ¿cuánto te sacaste?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338159
    m_Localized: ¿A eso le llamas trabajar?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338160
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338161
    m_Localized: 'Scammer: ¿Cómo te lo digo...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338162
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338163
    m_Localized: 'Scammer: Hice treinta. Putos. Millo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338164
    m_Localized: 'Scammer: ...de deudas, sí, pero las deudas me la sudan.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338165
    m_Localized: 'Scammer: Y desde luego me importa una mierda ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338166
    m_Localized: 'Scammer: Miro al peligro a los ojos, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338167
    m_Localized: 'Scammer: ¿Me estás tomando el pelo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338168
    m_Localized: 'Scammer: ¡Claro que es trabajo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338169
    m_Localized: 'Scammer: Incluso tenía un sitio para hacerlo. ¡Hostia, tío, era la leche...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338170
    m_Localized: 'Scammer: Un sofá brillante y una libreta con nombres de corredores de apuestas, lo que me debían y el beneficio neto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338171
    m_Localized: 'Scammer: Jeje. ¿Qué tal?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338172
    m_Localized: ¿Aún no han venido a por ti los cobradores?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338173
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338174
    m_Localized: 'Scammer: ¿Cobradores? ¿Qué puñetas dices de cobradores?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338175
    m_Localized: 'Scammer: Pfff. Pasa de ellos. Mira, ya no tengo deudas. El sol se ocupó de eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338176
    m_Localized: 'Scammer: Los bancos ya no están precisamente para esa labor. Quizá nunca lo estén.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338177
    m_Localized: 'Scammer: Lo que significa que estoy jodidamente libre. Y puedo buscarme un nuevo chanchullo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338178
    m_Localized: 'Scammer: Apostar es tan del siglo pasado ya. Tengo que idear otra movida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338179
    m_Localized: Lo del sol te vino de perlas entonces
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338180
    m_Localized: ¿Y bien? ¿Quieres un "chanchullo" nuevo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338181
    m_Localized: 'Scammer: ¡Tío, por favoooor!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338182
    m_Localized: 'Scammer: Simplemente recuperaría las pérdidas luego y saldaría mis deudas. Sin más.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338183
    m_Localized: 'Scammer: Pero ahora, empezaría de cero.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338184
    m_Localized: 'Scammer: Por cierto, tengo un nuevo chanchullo. ¿Quieres saber cuál es?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338185
    m_Localized: ¿Cuál es el plan?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338186
    m_Localized: No me interesa
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338187
    m_Localized: 'Scammer: Se me ocurrió una manera de ganar dinero. Puedo contarte si quieres, llevo pensándolo un tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338188
    m_Localized: ¿Cuál es el plan?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338189
    m_Localized: No me interesa
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338190
    m_Localized: 'Scammer: Básicamente, la AFAE está claramente al mando aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338191
    m_Localized: 'Scammer: Necesitamos, en plan... Estar en buena posición, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338192
    m_Localized: 'Scammer: Y creo que si entregamos gente de forma regular, incluso podrían meternos en un búnker.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338193
    m_Localized: 'Scammer: ¿Me entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338194
    m_Localized: ¿Pretendes entregar personas a la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338195
    m_Localized: ¿Crees que la AFAE te salvará?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338196
    m_Localized: 'Scammer: Pues sí, joder. ¿Por qué no?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338197
    m_Localized: 'Scammer: Creo que así sobreviviremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338198
    m_Localized: 'Scammer: A los tiempos distintos, chanchullos distintos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338199
    m_Localized: 'Scammer: Estar con el rebaño en las zonas de cuarentena generalmente es mala idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338200
    m_Localized: 'Scammer: Así que debemos quedar bien con la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338201
    m_Localized: 'Scammer: No chistarles, entregar gente...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338202
    m_Localized: 'Scammer: Hasta hacer la prueba de señales por una llamada para demostrar que no soy uno de esos... ¿cómo les llaman? Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338203
    m_Localized: 'Scammer: Son buena gente. Seguramente saben lo que hacen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338204
    m_Localized: Quizá tengas razón
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338205
    m_Localized: Suena a gilipolleces
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338206
    m_Localized: Si tanto quieres ir con ellos, lárgate de mi casa de una puta vez
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338207
    m_Localized: 'Scammer: Mierda, tío. No pillas para nada cómo está cambiando la cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338208
    m_Localized: 'Scammer: Tenemos que ver quién manda aquí y arrimarnos a ellos. Es una jugada maestra. En serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338209
    m_Localized: 'Scammer: Así que debemos quedar bien con la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338210
    m_Localized: 'Scammer: No chistarles, entregar gente...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338211
    m_Localized: 'Scammer: Hasta hacer la prueba de señals por una llamada para demostrar que no soy uno de esos... ¿cómo les llaman? Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338212
    m_Localized: 'Scammer: Son buena gente. Seguramente saben lo que hacen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338213
    m_Localized: Quizá tengas razón
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338214
    m_Localized: Suena a gilipolleces
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338215
    m_Localized: Si tanto quieres ir con ellos, lárgate de mi casa de una puta vez
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338216
    m_Localized: 'Scammer: Claro que tengo razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338217
    m_Localized: 'Scammer: Tengo un sexto sentido para los chanchullos rentables, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338218
    m_Localized: 'Scammer: Créeme, conmigo no puedes perder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338219
    m_Localized: 'Scammer: ¡Jodeeer, tío, venga ya! Eres la hostia de gilipollas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338220
    m_Localized: 'Scammer: La gente me soltaba pasta por consejos de inversión. Pero a ti te doy gratis, te lo digo como un regalo y tú...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338221
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338222
    m_Localized: 'Scammer: Mierda. Vete al infierno.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338223
    m_Localized: 'Scammer: ¿Qué, me vas a echar o qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338224
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338225
    m_Localized: 'Scammer: Tío, pensaba que eras buena gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338226
    m_Localized: 'Scammer: Hasta te ofrecí un chanchullo. Pero tú...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338227
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338228
    m_Localized: 'Scammer: Te puedes ir al infierno, yo me voy a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338229
    m_Localized: 'Scammer: Joder, qué buen negocio se me había ocurrido. Bueno, pues vale...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338230
    m_Localized: 'Scammer: Si cambias de opinión, dímelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338231
    m_Localized: 'Scammer: Jeje. ¿Qué tal?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338232
    m_Localized: ¿Qué quieres?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338233
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338234
    m_Localized: 'Scammer: Mire, se me ha ocurrido un nuevo chanchullo. Va a funcionar. En serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338235
    m_Localized: 'Scammer: A ver, en plan...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338236
    m_Localized: 'Scammer: El sol está asando como un sauna del infierno, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338237
    m_Localized: 'Scammer: Creo que las capas de ozono deben estar fatal.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338238
    m_Localized: 'Scammer: Pero recuerdo que el oxígeno viene de la luz del sol pasando por el ozono.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338239
    m_Localized: 'Scammer: ¿Así que sabes lo que he pensado?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338240
    m_Localized: 'Scammer: ¡VENDER AIRE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338241
    m_Localized: 'Scammer: ¡Eso SÍ que es un buen CHANCHULLO, créame!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338242
    m_Localized: Qué plan tan jodidamente increíble
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338243
    m_Localized: No he oído una gilipollez mayor en mi vida
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338244
    m_Localized: 'Scammer: ¿De verdad? ¿Tú crees?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338245
    m_Localized: Sí, claro. Deberías ser científico
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338246
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338247
    m_Localized: 'Scammer: Hostia, bueno...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338248
    m_Localized: 'Scammer: Gracias. Al menos alguien reconoce que soy listo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338249
    m_Localized: 'Scammer: Voy a pillar un premio Darwin antes de que se dé cuenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338250
    m_Localized: ¿Acaso... sabes lo que es un premio Darwin, no?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338251
    m_Localized: Oh, sin duda vas a pillar uno
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338252
    m_Localized: 'Scammer: Bueno... Es por, como, contribuciones a la ciencia o algo así.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338253
    m_Localized: 'Scammer: ¿Por qué me preguntas eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338254
    m_Localized: Por nada
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338255
    m_Localized: Los premios Darwin son para gente que se muere de maneras gilipollas
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338256
    m_Localized: 'Scammer: ¡Jajaja! Ya puedo saborear el reconocimiento científico.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338257
    m_Localized: 'Scammer: Un montón de pasta, estatus, tías... Qué sueño...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338258
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338259
    m_Localized: 'Scammer: Venga que cuando todo esto acabe, voy a patentar tecnología para vender aire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338260
    m_Localized: 'Scammer: Bueno, vale.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338261
    m_Localized: 'Scammer: Ah...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338262
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338263
    m_Localized: 'Scammer: Espere, ¿se está burlando de mí?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338264
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338265
    m_Localized: 'Scammer: ¡Anda a tomar por culo! Estoy aquí pensando en cómo hacer ORO y tú vacilándome.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338266
    m_Localized: 'Scammer: ¡Anda a tomar por culo! Estoy aquí pensando en chanchullos serios y tú vacilándome.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338267
    m_Localized: 'Scammer: ¡Voy a pillar el Premio Darwin y me voy a forrar!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338268
    m_Localized: 'Scammer: Entonces te vas a arrastrar a mis pies y me rogarás que te perdone...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338269
    m_Localized: ¿Por qué no te vas a la mierda con tus ideas de mierda?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338270
    m_Localized: 'Scammer: Joder, tío...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338271
    m_Localized: 'Scammer: ¿Te cuesta mucho hacerme caso o qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338272
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532288
    m_Localized: 'Scammer: Da igual, que te den. Voy a ganar más pasta sin ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532289
    m_Localized: 'Scammer: Joder, tío...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532290
    m_Localized: 'Scammer: ¡Anda a tomar por culo! Estoy aquí pensando en chanchullos serios y tú vacilándome.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532291
    m_Localized: 'Scammer: ¡Voy a pillar el Premio Darwin y me voy a forrar!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532292
    m_Localized: 'Scammer: Entonces te arrastrarás a mis pies y me pedirás que te perdone...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532293
    m_Localized: 'Neighbour: Joder... Así que era cierto, al final...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532294
    m_Localized: 'Neighbour: Pues entonces, todo lo que dije tiene sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532295
    m_Localized: 'Neighbour: No salgas fuera durante el día. Y recuerda que debes dejar entrar a otra gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532296
    m_Localized: ¿Por qué debería dejar entrar a extraños en mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532297
    m_Localized: ¿Dejar entrar gente?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532298
    m_Localized: 'Neighbour: Sé que mantienes tu distancia de la gente, pero tienes que hacerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532299
    m_Localized: 'Neighbour: Mi prima no tiene seguro por qué no podemos estar solos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532300
    m_Localized: 'Neighbour: Pero mencionó que cuando alguien pregunte si estás solo, hay que decir que no y que hay alguien en la casa contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532301
    m_Localized: La gente es una lata para mí
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532302
    m_Localized: ¿Qué sentido tiene tener más gente?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532303
    m_Localized: 'Neighbour: Lo entiendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532304
    m_Localized: 'Neighbour: Sé que no te agrada la compañía. Pero tiene que dejarlos entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532305
    m_Localized: 'Neighbour: Mi prima no tiene seguro por qué no podemos estar solos...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532306
    m_Localized: 'Neighbour: Pero mencionó que cuando alguien pregunte si estás solo, hay que decir que no y que hay alguien en la casa contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532307
    m_Localized: La gente es una lata para mí
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532308
    m_Localized: ¿Por qué querría rodearme de más gente ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532309
    m_Localized: 'Neighbour: Lo sé y sé que no será fácil para ti, pero tienes que hacerlo. Es la única forma de sobrevivir estos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532310
    m_Localized: 'Neighbour: Puede que te traigan algo o te cuenten cosas interesantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532311
    m_Localized: 'Neighbour: Y no se te olvide examinarlos por si tienen señales de Visitantes. Con este calor vas a tener poca energía durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532312
    m_Localized: 'Neighbour: Así que debes elegir cuidadosamente a quién quieres examinar. Las pruebas son agotadoras. Tienes que observar muy bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532313
    m_Localized: 'Neighbour: Pero no tienes que preocuparte por charlar con la gente. Eso NO gasta energía. Así que, habla todo lo que quieras.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532314
    m_Localized: 'Neighbour: Y asegúrate de mirar por las ventanas. La tele es un buen recurso, pero no te va a decir lo que pasa en los alrededores.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532315
    m_Localized: ¿Entonces qué?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532316
    m_Localized: ¿Qué tenemos que hacer?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532317
    m_Localized: 'Neighbour: Puede que te traigan algo o te cuenten cosas interesantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532318
    m_Localized: 'Neighbour: Y no se te olvide examinarlos por si tienen señales de Visitantes. Con este calor vas a tener poca energía durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532319
    m_Localized: 'Neighbour: Así que debes elegir cuidadosamente a quién quieres examinar. Las pruebas son agotadoras. Tienes que observar muy bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532320
    m_Localized: 'Neighbour: Pero no tienes que preocuparte por charlar con la gente. Eso NO gasta energía. Así que, habla todo lo que quieras.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532321
    m_Localized: 'Neighbour: Y asegúrate de mirar por las ventanas. La tele es un buen recurso, pero no te va a decir lo que pasa en los alrededores.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532322
    m_Localized: ¿Entonces qué?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532323
    m_Localized: ¿Qué tenemos que hacer?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532324
    m_Localized: 'Neighbour: Me temo que todo lo que podemos hacer es intentar sobrevivir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532325
    m_Localized: 'Neighbour: Y esperar que esta pesadilla acabe pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532326
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532327
    m_Localized: 'Neighbour: Seguro que el gobierno nos ayudará de alguna manera. Quizá nos lleven a todos a algún refugio o algo así.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532328
    m_Localized: 'Neighbour: Si lo hacen, quédate con mi familia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532329
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532330
    m_Localized: 'Neighbour: Ah, casi se me olvida.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532331
    m_Localized: 'Neighbour: Mañana por la noche vuelvo a casa. Ten, este es mi número, para que me llames cuando quieras.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532332
    m_Localized: 'Neighbour: Nos acaban de instalar la línea hace poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532333
    m_Localized: 'Neighbour: XXX-XXX-XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532334
    m_Localized: 'Neighbour: Nos mantendremos en contacto por teléfono.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532335
    m_Localized: 'Neighbour: Vale, ahora sí que es todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532336
    m_Localized: 'Neighbour: Por cierto, te he traído una caja de cervezas. Mi cuñado trabaja en una cervecería.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532337
    m_Localized: 'Neighbour: Échate una cerveza y vete a dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532338
    m_Localized: 'Neighbour: Da mucho sueño. Así que si no quieres hablar con más nadie, bebe una birra y relájate.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532339
    m_Localized: 'Daughter: Mami... qui-quiero a mi m-mami...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532340
    m_Localized: Cuéntame qué ha pasado
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532341
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532342
    m_Localized: 'Daughter: No lo séeeeeee.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532343
    m_Localized: 'Daughter: Entraron y empezaron a hablar y mi papi dijo que había algo mal con ellos y le dijeron que... que...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532344
    m_Localized: 'Daughter: ¡PAPI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532345
    m_Localized: 'Daughter: ¡PAAAAPIIIIII!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532346
    m_Localized: Vale... solo descansa por ahora
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532347
    m_Localized: Seguimos hablando mañana, ¿vale?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532348
    m_Localized: 'Daughter: (La niña llama a su padre sin cesar y su histeria no parece tener fin)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532349
    m_Localized: 'Daughter: (La niña ni siquiera te escucha. Está sola en su pena)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532350
    m_Localized: 'Daughter: Mami... qui-quiero a mi m-mami...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532351
    m_Localized: ¿Cómo estás? ¿Te gusta estar aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532352
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532353
    m_Localized: 'Daughter: Aquí estoy bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532354
    m_Localized: 'Daughter: Quisiera estar en mi casita...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532355
    m_Localized: 'Daughter: ¿Cuándo puedo irme a casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532356
    m_Localized: Más tarde. La... están arreglando
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532357
    m_Localized: No será pronto. Tu casa se incendió
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532358
    m_Localized: 'Daughter: Vale. ¿Entonces, vendrán a buscarme pronto?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532359
    m_Localized: 'Daughter: ¿Y me llevarán a una casita nueva?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532360
    m_Localized: 'Daughter: ¿O a la misma?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532361
    m_Localized: 'Daughter: ¿Me están haciendo una habitación nueva?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532362
    m_Localized: 'Daughter: Así que, mi papi todavía vendrá a por mí, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532363
    m_Localized: Ya viste lo que ocurrió, ¿no...?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532364
    m_Localized: Deberías quedarte aquí por ahora
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532365
    m_Localized: 'Daughter: ¿Pero mi papi está bien?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532366
    m_Localized: 'Daughter: ¿Y mi habitación? ¿También se quemó?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532367
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532368
    m_Localized: 'Daughter: ¿M-mi mami no vendrá?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532369
    m_Localized: 'Daughter: ¿Queda alguien más?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532370
    m_Localized: Ya viste lo que ocurrió, ¿no...?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532371
    m_Localized: Deberías quedarte aquí por ahora
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532372
    m_Localized: 'Daughter: No... no lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532373
    m_Localized: 'Daughter: Quiero decir, no estoy segura.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532374
    m_Localized: 'Daughter: A papá le golpearon, pero luego se levantó. Eso sí que lo vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532375
    m_Localized: 'Daughter: Lo que significa... significa que podría apagar el fuego.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532376
    m_Localized: 'Daughter: O solo venir a buscarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532377
    m_Localized: 'Daughter: ¿Va a venir pronto?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532378
    m_Localized: 'Daughter: No iré a ningún sitio sin mi papi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532379
    m_Localized: 'Daughter: Va a venir a buscarme, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532380
    m_Localized: 'Daughter: Le vi levantarse y marcharse.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532381
    m_Localized: 'Daughter: Estaba corriendo, pero le vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532382
    m_Localized: 'Daughter: Mami... qui-quiero a mi m-mami...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532383
    m_Localized: Tienes que aceptar lo que pasó
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532384
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532385
    m_Localized: 'Daughter: ¿Qué quieres decir?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532386
    m_Localized: 'Daughter: He visto una tele en tu habitación. ¿Puedo ir ver dibujos animados ahí?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532387
    m_Localized: No sé qué habrás visto. Pero creo que tu padre ha muerto
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532388
    m_Localized: Puede que tu padre no venga por ti. No sé qué le sucedió...
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532389
    m_Localized: 'Daughter: ¡Tú no viste nada!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532390
    m_Localized: 'Daughter: ¡Yo estaba allí! Se movía cuando me fui corriendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532391
    m_Localized: 'Daughter: ¡Lo que significa que va a vendrá a por mí pronto!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532392
    m_Localized: ¿Por qué aún no ha venido a por ti?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532393
    m_Localized: ¿Qué aspecto tenía la última vez que le viste?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532394
    m_Localized: 'Daughter: ¿No va a venir? ¿Por qué dices eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532395
    m_Localized: ¿Entonces por qué aún no ha venido a por ti?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532396
    m_Localized: ¿Qué aspecto tenía la última vez que le viste?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532397
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532398
    m_Localized: 'Daughter: ¿Quizás tenía algo que hacer primero?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532399
    m_Localized: 'Daughter: Fue a zurrar a esa gente mala.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532400
    m_Localized: 'Daughter: Él... debería estar aquí pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532401
    m_Localized: Lamento mucho lo de tu padre. Era un muy buen hombre. Quizá demasiado bueno...
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532402
    m_Localized: Vale, claro, tu padre seguro vendrá pronto
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532403
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532404
    m_Localized: 'Daughter: Mi papi era bueno.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532405
    m_Localized: 'Daughter: Le pegaron... así que...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532406
    m_Localized: 'Daughter: No me acuerdo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532407
    m_Localized: Lamento mucho lo de tu padre. Era un muy buen hombre. Quizá demasiado bueno...
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532408
    m_Localized: Vale, claro, tu padre seguro vendrá pronto
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532409
    m_Localized: 'Daughter: (La niña te mira, como si supiera más de lo que deja ver. Tienes miedo de moverte, así que solo aguardas a que algo suceda)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532410
    m_Localized: 'Daughter: (Después de un rato, empieza a sollozar. No parece haber nada que puedas hacer)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532411
    m_Localized: 'Daughter: (Sería peor dejarla creerse una mentira. Cuanto antes acepte su situación, mejor)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532412
    m_Localized: 'Daughter: Yo ya lo pensaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532413
    m_Localized: 'Daughter: (Notas que la niña se ha quedado ensimismada. Claramente está pensando en algo)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532414
    m_Localized: 'Daughter: (¿Pero merece la pena arruinar su infancia? ¿Podrá soportar ese golpe?)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532415
    m_Localized: 'Daughter: (Decides que ya tiene suficientes problemas ahora. No hay razón para preocupar a la niña)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532416
    m_Localized: 'NotTrue: Ay, Dios mío, me estoy haciendo vieja...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532417
    m_Localized: ¿De dónde es usted?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532418
    m_Localized: Necesito examinarla
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532419
    m_Localized: 'NotTrue: Pues sí, querido. ¿Qué tiene de malo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532420
    m_Localized: 'NotTrue: La gente se aprovecha de mis historias y luego me odia por ellas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532421
    m_Localized: 'NotTrue: ¿Se imagina?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532422
    m_Localized: 'NotTrue: Tengo una casa. Una choza toda para mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532423
    m_Localized: 'NotTrue: A mí sí me gusta estar allí, pero me marchitaré sin compañía.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532424
    m_Localized: 'NotTrue: ¿Y quién va a vendría a una pequeña y vieja choza?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532425
    m_Localized: 'NotTrue: Así que vago y doy vueltas, alma. No tengo nada que perder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532426
    m_Localized: 'NotTrue: Ay, Dios mío, me estoy haciendo vieja...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532427
    m_Localized: ¿Por qué no tiene más parientes?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532428
    m_Localized: Necesito examinarla
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532429
    m_Localized: 'NotTrue: Oh, Yo cuento cosas de lo más comunes; historias sobre la gente que he conocido con los años.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532430
    m_Localized: 'NotTrue: Se las cuento a todo aquel que quiera escuchar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532431
    m_Localized: 'NotTrue: Pero ya soy una abuela. No me acuerdo bien de todo. A veces... me invento algunos detalles.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532432
    m_Localized: 'NotTrue: Quizás me tengan manía por eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532433
    m_Localized: 'NotTrue: Como dicen por ahí: "La tristeza misma no es tan difícil de llevar como lo es la idea de que la tristeza vendrá".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532434
    m_Localized: 'NotTrue: Pero ya le digo, no soy la única que adereza las historias un poco, ¿entiendes? Jejeje.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532435
    m_Localized: 'NotTrue: Todo el mundo viene a mí. Tarde o temprano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532436
    m_Localized: 'NotTrue: Todo el mundo necesita historias.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532437
    m_Localized: 'NotTrue: Ay, Dios mío, me estoy haciendo vieja...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532438
    m_Localized: ¿Por qué no está con su marido?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532439
    m_Localized: Necesito examinarla
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532440
    m_Localized: 'NotTrue: ¿Qué te apetece escuchar, querido?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532441
    m_Localized: 'NotTrue: El ser humano es una criatura temerosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532442
    m_Localized: 'NotTrue: Supe de un hombre que se aisló de todo el mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532443
    m_Localized: 'NotTrue: Vivía en un edificio alto... Era de los que se la vivía encerrado en su piso y casi no iba a ningún sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532444
    m_Localized: 'NotTrue: Le tendría miedo a los Visitantes o a la mismísima muerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532445
    m_Localized: 'NotTrue: La verdad es que nadie iba por allí. De todas formas, él no les habría dejado entrar...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532446
    m_Localized: 'NotTrue: Y entonces, un día...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532447
    m_Localized: 'NotTrue: Escuché una especie de ruido desagradable, un estruendo como cuando se te cae un tarro de mermelada...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532448
    m_Localized: 'NotTrue: Al principio no lo entendí qué ocurría.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532449
    m_Localized: 'NotTrue: Así que eché un vistazo por la ventana y vi al hombre en el fondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532450
    m_Localized: 'NotTrue: Había saltado...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532451
    m_Localized: 'NotTrue: ¿Qué te ha parecido la historia, querido?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532452
    m_Localized: No me ha gustado
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532453
    m_Localized: ¿Eso es todo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532454
    m_Localized: 'NotTrue: ¡Uf! Seguramente por eso no soy del agrado de nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532455
    m_Localized: 'NotTrue: Bueno, no importa. Algún día, contaré su historia tal como la recuerde.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532456
    m_Localized: 'NotTrue: Sí, querido. El hombre se desparramó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532457
    m_Localized: 'NotTrue: O tenía miedo de morir con una agonía terrible por la explosión del Sol... o quién sabe qué.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532458
    m_Localized: 'NotTrue: Creo que su corazón no pudo soportar la soledad.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532459
    m_Localized: 'NotTrue: ¿Pero qué se le va a hacer, querido?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532460
    m_Localized: 'NotTrue: Ay, Dios mío, me estoy haciendo vieja...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532461
    m_Localized: ¿Qué tal ha ido eso de sentarse en el banco?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532462
    m_Localized: Necesito examinarla
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532463
    m_Localized: 'NotTrue: Bueno, querido, escucha esta historia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532464
    m_Localized: 'NotTrue: Cuando vivía en el pueblo, había un señor allí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532465
    m_Localized: 'NotTrue: Le gustaba mucho andar por el bosque. No sé por qué.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532466
    m_Localized: 'NotTrue: Pero lo hacía. En uno de esos paseos suyos, caminó hasta notar que se había perdido. No encontraba el camino de vuelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532467
    m_Localized: 'NotTrue: Se paró a pensar. Decidió que si caminaba en línea recta, llegaría a algún lugar tarde o temprano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532468
    m_Localized: 'NotTrue: Anduvo y anduvo, pero no encontraba salida alguna.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532469
    m_Localized: 'NotTrue: Fue entonces cuando se dio cuenta de que estaba yendo en círculos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532470
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532471
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532472
    m_Localized: ¿Y luego qué?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532473
    m_Localized: Esto es una tontería
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532474
    m_Localized: 'NotTrue: Lo encontraron muerto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532475
    m_Localized: 'NotTrue: Seguimos sus huellas y nos dimos cuenta de que solo estaba dando vueltas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532476
    m_Localized: 'NotTrue: Ya sabes lo que dicen: una de las dos piernas siempre da zancadas más largas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532477
    m_Localized: 'NotTrue: Eso fue lo que ocurrió.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532478
    m_Localized: 'NotTrue: ¿Por qué? ¿No le ha gustado la historia?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532479
    m_Localized: 'NotTrue: Bueno, la adorné un poco, por supuesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532480
    m_Localized: 'NotTrue: Pero sí que ocurrió de verdad. Y es una cosa que continúa ocurriendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532481
    m_Localized: 'NotTrue: La gente anda y se pierde, ¿y cómo consiguen salir?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532482
    m_Localized: 'Alkonost: Necesito reunir fuerzas. Si tan solo alguien me las diera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532483
    m_Localized: ¿Cómo está tu hermana?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532484
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532485
    m_Localized: 'Alkonost: Tengo que ayudarla. Con muchas cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532486
    m_Localized: 'Alkonost: Ayer pude bañarla. En casa ni siquiera podía meterse en la bañera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532487
    m_Localized: 'Alkonost: Aún sin cambios. Pero gracias por preguntar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532488
    m_Localized: 'Alkonost: La gente con depresión es realmente... complicada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532489
    m_Localized: 'Alkonost: Temo que podríamos tener que huir en cualquier momento y ella no se sienta con fuerzas para hacerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532490
    m_Localized: 'Alkonost: O que no coma porque no se siente con energía para masticar ni tragar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532491
    m_Localized: 'Alkonost: Yo también estoy agotada. Creo que descansaré un poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532492
    m_Localized: 'Alkonost: Necesito reunir fuerzas. Si tan solo alguien me las diera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532493
    m_Localized: ¿Qué piensas hacer ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532494
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532495
    m_Localized: 'Alkonost: Buena pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532496
    m_Localized: 'Alkonost: Mi marido debería venir a buscarnos pronto. Espero que pueda encontrar un lugar seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532497
    m_Localized: 'Alkonost: Algún sitio donde podamos esperar a que pase el ataque de los Visitantes y a que ya no haga tanto calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532498
    m_Localized: 'Alkonost: Dijo que existen sitios así. También dijo que el sol no puede explotar y ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532499
    m_Localized: 'Alkonost: Si eso pasara, seríamos aniquilados en 10 minutos o menos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532500
    m_Localized: 'Alkonost: Creo que tiene razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532501
    m_Localized: 'Alkonost: Necesito reunir fuerzas. Si tan solo alguien me las diera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532502
    m_Localized: ¿Alguna noticia de tu esposo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532503
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532504
    m_Localized: 'Alkonost: Por alguna razón, no se ha comunicado conmigo para nada. No ha llamado ni ha venido por nosotras.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532505
    m_Localized: 'Alkonost: ¿Le habrá ocurrido algo? ¿Se habrá metido en algún lío?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532506
    m_Localized: 'Alkonost: Puedo asegurar que no nos ha abandonado. Eso es imposible.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532507
    m_Localized: 'Alkonost: Incluso cuando estaba hasta las narices de mi hermana, aún me ayudaba con ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532508
    m_Localized: 'Alkonost: Él... Probablemente esté de camino.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532509
    m_Localized: 'Alkonost: Y mi hermana parece estar un poco mejor... Así que... Sí, él vendrá y todo irá mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532510
    m_Localized: 'Alkonost: Necesito reunir fuerzas. Si tan solo alguien me las diera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532511
    m_Localized: Pareces estar triste
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532512
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532513
    m_Localized: 'Alkonost: ¿Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532514
    m_Localized: 'Alkonost: Ah, seguramente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532515
    m_Localized: 'Alkonost: Tengo muchas cosas en la cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532516
    m_Localized: 'Alkonost: Si el sol no va a explotar, ¿por qué no ha bajado la temperatura? ¿Por qué todo el mundo solo piensa en el fin del mundo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532517
    m_Localized: 'Alkonost: Vi las noticias.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532518
    m_Localized: 'Alkonost: No lo dijeron tal cual, pero da la impresión de que el día se está volviendo más caluroso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532519
    m_Localized: 'Alkonost: El clima está cambiando. Los animales están muriendo porque no pueden adaptarse a las nuevas... condiciones climáticas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532520
    m_Localized: 'Alkonost: ¿Qué va a ser de nosotros?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532521
    m_Localized: 'Alkonost: Necesito reunir fuerzas. Si tan solo alguien me las diera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532522
    m_Localized: Eh, ¿qué tal estás?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532523
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532524
    m_Localized: 'Alkonost: Salí anoche. Quería encontrar a mi marido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532525
    m_Localized: 'Alkonost: Anduve por algunos sitios donde quizás estaría.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532526
    m_Localized: 'Alkonost: Lo encontré en uno de ellos. Se había tomado una píldora.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532527
    m_Localized: 'Alkonost: Nosotros... Las compramos. Por si las cosas se ponían mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532528
    m_Localized: 'Alkonost: Se tomó una. Tenía miedo. No me llevó con él..'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532529
    m_Localized: 'Alkonost: Se tomó la píldora él solo. Incluso antes de que el sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532530
    m_Localized: 'Sirin: Este es el final.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532531
    m_Localized: Eh, ¿cómo te sientes?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532532
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532533
    m_Localized: 'Sirin: Me siento...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532534
    m_Localized: 'Sirin: Como si hubiera una manta pesada, muy pesada...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532535
    m_Localized: 'Sirin: Presionando mi cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532536
    m_Localized: 'Sirin: Y... no quiero...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532537
    m_Localized: 'Sirin: Este es el final.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532538
    m_Localized: Hoy pareces un poco más animada
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532539
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532540
    m_Localized: 'Sirin: Sí'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532541
    m_Localized: 'Sirin: ¿Sabía usted lo del sol? ¿Que va a explotar?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532542
    m_Localized: 'Sirin: Me enteré esta noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532543
    m_Localized: 'Sirin: Entonces, ¿este es el final?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532544
    m_Localized: 'Sirin: ¿No va a quedar ni rastro de nosotros?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532545
    m_Localized: 'Sirin: Es curioso pensar en ello.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532546
    m_Localized: 'Sirin: Este es el final.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532547
    m_Localized: ¿Cómo está tu hermana?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532548
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532549
    m_Localized: 'Sirin: A ella le da miedo perderlo todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532550
    m_Localized: 'Sirin: No creo que tengamos nada que perder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532551
    m_Localized: 'Sirin: En este universo en constante expansión, no somos más que motas de polvo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532552
    m_Localized: 'Sirin: Nadie nos necesita porque no hay nadie más.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532553
    m_Localized: 'Sirin: Si el planeta desaparece, nadie sentirá pena por nosotros. Y no hace falta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532554
    m_Localized: 'Sirin: Pero a mi hermana eso la aterra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532555
    m_Localized: 'Sirin: Este es el final.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532556
    m_Localized: ¿Tu hermana está enferma?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532557
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532558
    m_Localized: 'Sirin: Sí, es que quiere ir a buscar a su marido para evitar ponerse a pensar en cosas malas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532559
    m_Localized: 'Sirin: Se me hace que esta es una mala idea, pero ella tampoco puede quedarse sin hacer nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532560
    m_Localized: 'Sirin: Si aún quiere ir a buscarle, yo debo ir también.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532561
    m_Localized: 'Sirin: No quiero perderla antes de que todos muramos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532562
    m_Localized: 'Sirin: Este es el final.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532563
    m_Localized: Así que, ¿sí salisteis?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532564
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532565
    m_Localized: 'Sirin: Sí. Mi hermana encontró el cuerpo de su marido.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532566
    m_Localized: 'Sirin: Él le había dicho que todo iría a mejor y luego se suicidó. Tuvo miedo de enfrentar nuestro verdadero final.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532567
    m_Localized: 'Sirin: No creo que le quede fuerza alguna.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726592
    m_Localized: 'Sirin: Ahora tendré que cuidarla hasta que todos muramos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726593
    m_Localized: 'Sirin: Y entonces, por fin, no habrá más de qué preocuparse, nada que temer, que aborrecer, o de lo que avergonzarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166080
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166081
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166082
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166083
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166084
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166085
    m_Localized: 'Alkonost: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166086
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166087
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166088
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166089
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166090
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166091
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360384
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360385
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360386
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360387
    m_Localized: Dejarla en paz
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083328
    m_Localized: 'Firefighter: Joder... cof...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083329
    m_Localized: 'Firefighter: Oye, colega... Si no es mucha molestia... ¿Podrías llamarles? {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083330
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083331
    m_Localized: 'Firefighter: No es para pedirles que vengan a buscarme... no quiero despedidas... Solo diles...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083332
    m_Localized: 'Firefighter: Diles que papá no huyó. Él solo... se quedó donde la gente lo necesitaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083333
    m_Localized: 'Firefighter: Cof... cof... Eso es todo lo que importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083334
    m_Localized: 'Theorist: Eh, ¿tienes algo que contarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083335
    m_Localized: ¿Qué son esos papeles?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083336
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083337
    m_Localized: 'Theorist: No te imaginas lo que hay en estos documentos. Algunas partes son hasta... algo fascinantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083338
    m_Localized: 'Theorist: Mira aquí, por ejemplo. Es una teoría especialmente curiosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083339
    m_Localized: 'Theorist: Afirma que los Visitantes no existen en realidad. Todo es parte de un plan del gobierno para controlar la sobrepoblación.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083340
    m_Localized: 'Theorist: Es una lectura bastante convincente... y curiosamente, tiene cierto sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083341
    m_Localized: 'Theorist: La sobrepoblación sigue siendo un problema, nos guste o no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083342
    m_Localized: 'Theorist: Tal vez así es como decidieron "manejarlo".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083343
    m_Localized: 'Theorist: Eh, ¿tienes algo que contarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083344
    m_Localized: ¿Todavía sigues con tus papeles?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083345
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083346
    m_Localized: 'Theorist: Pues claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083347
    m_Localized: 'Theorist: Tengo mucho más, si te interesa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083348
    m_Localized: 'Theorist: Toma, mira este.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083349
    m_Localized: 'Theorist: Escucha esto. La AFAE *son* los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083350
    m_Localized: 'Theorist: Los trajes que usan son de cobertura total. No hay forma de examinarlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083351
    m_Localized: 'Theorist: Fascinante. Me divierte en particular lo que según ellos significa AFAE: Agencia Fundamental para la Aniquilación de la Especie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083352
    m_Localized: 'Theorist: ¿O era algo distinto...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083353
    m_Localized: 'Theorist: Eh, ¿tienes algo que contarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083354
    m_Localized: Pues, ¿qué descubriste esta vez?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083355
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083356
    m_Localized: 'Theorist: Visitantes... Cambiaformas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083357
    m_Localized: 'Theorist: Suena a algo salido de una novela de ciencia ficción, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083358
    m_Localized: 'Theorist: Pero hay algo de cierto en ello.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083359
    m_Localized: 'Theorist: Un informe menciona a un hombre pálido visto caminando por las calles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083360
    m_Localized: 'Theorist: Aunque, debo señalar... el autor cometió un error bastante obvio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083361
    m_Localized: 'Theorist: Dice que se vieron DOS seres pálidos y perturbadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083362
    m_Localized: 'Theorist: Uno visto a través de ventanas, el otro parado en la puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083363
    m_Localized: 'Theorist: Por favor. ¿No está claro ya que es la misma criatura?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083364
    m_Localized: 'Theorist: Me atrevo a suponer que la ventana distorsionó la vista. Hizo que el rostro pareciera diferente. Un error de percepción.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083365
    m_Localized: 'Theorist: De todos modos, es entretenido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083366
    m_Localized: 'Theorist: Eh, ¿tienes algo que contarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083367
    m_Localized: ¿Y si es verdad?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083368
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083369
    m_Localized: 'Theorist: ¿Y qué es la verdad, de todos modos? Es un concepto fluido, moldeado por la perspectiva.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083370
    m_Localized: 'Theorist: La verdad de una persona es la ilusión de otra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083371
    m_Localized: 'Theorist: Lo que es bueno para uno, es malo para otro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083372
    m_Localized: 'Theorist: La humanidad ha discutido sobre eso desde siempre. ¿Y últimamente? La brújula moral está por todos lados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083373
    m_Localized: 'Theorist: Si tu creencia es fuerte, como la mía, se convierte en tu verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083374
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083375
    m_Localized: 'Theorist: Mmm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083376
    m_Localized: 'Theorist: Qué interesante artículo. Ahora, ¿en qué estábamos? Ah, sí. La verdad. '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083377
    m_Localized: 'Theorist: Recuerda esto. Solo hay una verdad: los Visitantes son parásitos cerebrales.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083378
    m_Localized: 'Theorist: Usa tapones para los oídos. En todo momento. ¡Y todo estará bien!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083379
    m_Localized: 'Theorist: En fin, tengo más que leer. Por favor, no me distraigas. Necesito concentrarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083380
    m_Localized: 'Wifefema: ¿Ahora qué quieres?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083381
    m_Localized: ¿Dijiste que trabajabas en aduanas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083382
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083383
    m_Localized: 'Wifefema: Puedes apostar a que sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083384
    m_Localized: 'Wifefema: Hablando de eso, ¿SÍ HAS estado revisando a la gente en busca de señales de Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083385
    m_Localized: 'Wifefema: No es por ser obvia ni nada, pero... ya sabes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083386
    m_Localized: 'Wifefema: ¿Quién coño se inventó lo de llamar Visitantes a esos bichos raros?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083387
    m_Localized: 'Wifefema: Tendrían que haberles puesto un nombre más adecuado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083388
    m_Localized: 'Wifefema: ¿Ahora qué quieres?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083389
    m_Localized: ¿Por qué odias a los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083390
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083391
    m_Localized: 'Wifefema: ¿Qué clase de pregunta estúpida es esa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083392
    m_Localized: 'Wifefema: ¡Son la razón de que todo se haya ido al garete! ¿No ves las noticias?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083393
    m_Localized: 'Wifefema: El sol está por explotar, la gente muriendo en las calles. Todo por culpa de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083394
    m_Localized: 'Wifefema: Juro por Dios, los eliminaría a todos si pudiera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083395
    m_Localized: 'Wifefema: Solo dame tiempo. Los rastrearé como en la frontera, ya lo verás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083397
    m_Localized: 'Wifefema: ¿Ahora qué quieres?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083398
    m_Localized: ¿Por qué estás tan ansiosa por trabajar para la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083399
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083400
    m_Localized: 'Wifefema: Coño, porque me importa, por eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083401
    m_Localized: 'Wifefema: Sé que hay que hacer para detener a esos Visitontos; y HAY que detenerlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083402
    m_Localized: 'Wifefema: Incluso entregué a nuestro vecino. Hice lo correcto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083403
    m_Localized: 'Wifefema: ¿Pero qué hicieron? ¡Contrataron a mi marido! ¡No a mí!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083404
    m_Localized: 'Wifefema: No me malinterpretes, me enorgullece mucho que mi marido entrara, pero por favor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083405
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083406
    m_Localized: 'Wifefema: ¿Honestamente? Se siente como una bofetada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083407
    m_Localized: 'Wifefema: ¿Ahora qué quieres?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083408
    m_Localized: ¿Por qué entregaste a tu vecino?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083409
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083410
    m_Localized: 'Wifefema: Ya te dije: era un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083411
    m_Localized: 'Wifefema: Y me daba escalofríos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083412
    m_Localized: 'Wifefema: La verdad, me sentí muy bien entregándolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083413
    m_Localized: 'Wifefema: Me recordó los viejos tiempos en aduanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083414
    m_Localized: 'Wifefema: Fue ahí cuando me di cuenta que debía entrar en la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083415
    m_Localized: 'Wifefema: ¿Ahora qué quieres?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083416
    m_Localized: No estás aquí por tu esposo. Es por la AFAE, ¿cierto?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083417
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083418
    m_Localized: 'Wifefema: ¿Sí? ¿Y qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083419
    m_Localized: 'Wifefema: Sí, vine a hacer un escándalo hasta que alguien de arriba escuche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083420
    m_Localized: 'Wifefema: Quiero apelar ese rechazo laboral.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083421
    m_Localized: 'Wifefema: ¡Es una porquería! Yo atrapo al Visitante, cumplo mi maldito deber cívico, ¿y a ÉL le dan el trabajo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083422
    m_Localized: 'Wifefema: Dios mío, simplemente no lo entiendo. Es una estupidez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083423
    m_Localized: 'Wifefema: Odio a ese hombre. Lo odio con toda mi alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083424
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083425
    m_Localized: 'Wifefema: Oye, tengo un pequeño favor que pedirte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083426
    m_Localized: 'Wifefema: Llámalos, ¿sí? Usa su línea interna, tienen un número especial: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083427
    m_Localized: 'Wifefema: Diles que conociste a alguien que vale la pena. Una mujer con experiencia y agallas. Diles que hasta les llevé un empleado nuevo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083428
    m_Localized: 'Wifefema: Exagera. Intercede por mí y tal vez por fin me dejen hacer algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083429
    m_Localized: 'Wifefema: ¿Ahora qué quieres?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083430
    m_Localized: Aduanas era mejor, ¿eh? Al menos tenías algo de poder allí
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083431
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083433
    m_Localized: 'Wifefema: No te pedí tu opinión. No eres mejor que yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083434
    m_Localized: 'Wifefema: ¿Te gusta estar al mando? Que la gente venga, que se quede en tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083435
    m_Localized: 'Wifefema: Tú tomas las decisiones aquí, decides quién es Visitante y quién no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083436
    m_Localized: 'Wifefema: Pero ese no es tu maldito trabajo. Eso es asunto de la AFAE. Estás jugando a ser juez sin credenciales.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083437
    m_Localized: 'Wifefema: Así que dime, ¿en qué eres mejor que la AFAE? Al menos ellos tienen la autoridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083438
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083439
    m_Localized: 'Wifefema: Eso pensé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083440
    m_Localized: 'Raskolnikov: Yo... solo espero poder aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083441
    m_Localized: ¿Todavía quieres que mate a los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083442
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083443
    m_Localized: 'Raskolnikov: La verdad es que... cambié de opinión.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083444
    m_Localized: 'Raskolnikov: Sí, me asusté. Lo sé. Lo... lo siento. Pero me di cuenta de que aún no estoy listo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083445
    m_Localized: 'Raskolnikov: Todavía me da náuseas ver cadáveres. Me tomará tiempo superarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083446
    m_Localized: 'Raskolnikov: Es que... los Visitantes... escuché que sus cuerpos aún se mueven. Después de morir. Como ese hombre... ese hombre en el callejón...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083447
    m_Localized: 'Raskolnikov: Maldita sea, no puedo pensar en eso justo ahora. No estoy listo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083448
    m_Localized: 'Raskolnikov: Yo... solo espero poder aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083449
    m_Localized: Cuéntame lo que pasó en el callejón
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083450
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083451
    m_Localized: 'Raskolnikov: Es... difícil de contar. Pero lo intentaré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083452
    m_Localized: 'Raskolnikov: Pensé que los callejones serían más seguros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083453
    m_Localized: 'Raskolnikov: Pero en cuanto doblé la esquina, sentí como si hubiera entrado a un cementerio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083454
    m_Localized: 'Raskolnikov: Montones de cuerpos tirados ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083455
    m_Localized: 'Raskolnikov: Algunos de ellos aún se movían. Como si no estuvieran del todo muertos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083456
    m_Localized: 'Raskolnikov: Y al final del callejón, había un hombre con un arma, y él...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083457
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083458
    m_Localized: 'Raskolnikov: No... Ya basta. No quiero recordarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083459
    m_Localized: 'Raskolnikov: Yo... solo espero poder aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083460
    m_Localized: ¿Quién era el hombre al final del callejón?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083461
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083462
    m_Localized: 'Raskolnikov: Él...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083463
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083464
    m_Localized: 'Raskolnikov: Un hombre encapuchado, lleno de hileras de dedos y dientes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083465
    m_Localized: 'Raskolnikov: Al lado suyo había un chaval. Indefenso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083466
    m_Localized: 'Raskolnikov: El hombre del abrigo le gritó, apuntándole con una escopeta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083467
    m_Localized: 'Raskolnikov: Le exigió que enseñase los dientes. Y el chaval le rogaba piedad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083468
    m_Localized: 'Raskolnikov: Me estaba escondiendo detrás de un cubo de basura... Y entonces... no sé por qué, pero me vi en el lugar de ese chaval.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083469
    m_Localized: 'Raskolnikov: Estaba llorando, rogando, suplicando por su vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083470
    m_Localized: 'Raskolnikov: Entonces... ¡BANG! Y su cuerpo simplemente cayó, como el resto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083472
    m_Localized: 'Raskolnikov: Yo... solo espero poder aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083473
    m_Localized: Sobrevivir no implica convertirse en un homicida sanguinario
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083474
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083475
    m_Localized: 'Raskolnikov: ¿Por qué dices eso? ¡No es verdad!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083476
    m_Localized: 'Raskolnikov: Estás vivo porque mostraste tus colmillos. ¡Eres un depredador! Por eso nadie se atreve a tocarte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083477
    m_Localized: 'Raskolnikov: Si la gente te teme, estás a salvo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083478
    m_Localized: 'Raskolnikov: No quiero ser una presa. No quiero morir llorando como un cobarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277632
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277633
    m_Localized: 'Raskolnikov: Por eso tengo que aprender a matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277634
    m_Localized: 'Nun: Padre nuestro, que estás en los cielos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277635
    m_Localized: Entonces, ¿cómo está la casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277636
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277637
    m_Localized: 'Nun: Uf. Horrible.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277638
    m_Localized: 'Nun: Paredes torcidas. Y la distribución no tiene ningún sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277639
    m_Localized: 'Nun: Y dígame, ¿a propósito me puso en la habitación más miserable que encontró?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277640
    m_Localized: 'Nun: Los muebles son viejos y están en mal estado. Están carcomidos, desgastados y probablemente ya estén llenos de polillas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277641
    m_Localized: 'Nun: Ni siquiera pudo colgar un crucifijo en una habitación decente, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277642
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277643
    m_Localized: 'Nun: ¿Por qué me pones estas pruebas, Padre...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277644
    m_Localized: 'Nun: Padre nuestro, que estás en los cielos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277645
    m_Localized: Si tanto aborrece este lugar, ¿por qué no se marcha?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277646
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277647
    m_Localized: 'Nun: ¿Cree que elegí venir a este lugar desolado? Si el monasterio hubiera permanecido en pie, jamás habría dejado sus muros sagrados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277648
    m_Localized: 'Nun: ¿Cree que me importa esta pila de podredumbre y escombros?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277649
    m_Localized: 'Nun: Si hubiese podido elegir, no habría venido a este sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277650
    m_Localized: 'Nun: Este lugar apesta a asesinatos y muerte, Dios mío, ayúdame. ¡Y apuesto a que te gusta revolcarte en ello!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277651
    m_Localized: 'Nun: Asesina a cualquiera que considere un demonio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277652
    m_Localized: 'Nun: ¡Quizás usted sea uno! ¡Con cuernos y todo, solo que no le han crecido!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277653
    m_Localized: 'Nun: Pero puedo soportar estas transgresiones. El Padre Celestial vela por su rebaño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277654
    m_Localized: 'Nun: Padre nuestro, que estás en los cielos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277655
    m_Localized: ¿Por qué no se quedó en su monasterio?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277656
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277657
    m_Localized: 'Nun: Primero que todo, el monasterio no es mío. Es la casa del Señor Todopoderoso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277658
    m_Localized: 'Nun: Segundo, fueron esos sucios blasfemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277659
    m_Localized: 'Nun: Profanaron Su lugar sagrado. ¡Que el fuego del Cielo los encuentre!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277660
    m_Localized: 'Nun: Irrumpieron, me expulsaron a mí y a mi rebaño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277661
    m_Localized: 'Nun: Se instalaron como si fueran los dueños. ¡Bárbaros, todos ellos!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277662
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277663
    m_Localized: 'Nun: Vivíamos correctamente y con decoro. Oramos, ayunamos, hicimos la labor del Señor. ¿Y esos animales?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277664
    m_Localized: 'Nun: Bebiendo agua bendita como vino barato, sin duda. Que se ahoguen con ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277665
    m_Localized: 'Nun: ¡Que se pudran en el Infierno!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277666
    m_Localized: 'Nun: Padre nuestro, que estás en los cielos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277667
    m_Localized: ¿Qué querían esos "blasfemos"?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277668
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277669
    m_Localized: 'Nun: Vinieron en turba, sucios y ruidosos, gritando como demonios, blasfemando como los brutos ateos que son.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277670
    m_Localized: 'Nun: ¿Y por qué? ¡Porque no los dejé entrar! Yo se los advertí: ¡si no están bautizados, no cruzarán estas puertas!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277671
    m_Localized: 'Nun: Se enfurecieron, oh sí... Golpearon las puertas, intentaron destrozarlas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277672
    m_Localized: 'Nun: Después entraron a la fuerza y me expulsaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277673
    m_Localized: ¿Le diste la espalda a los necesitados?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277674
    m_Localized: Quizá yo también te habría echado
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277675
    m_Localized: 'Nun: Un lugar sagrado no es refugio para los ateos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277676
    m_Localized: 'Nun: ¿Y qué si buscaban sombra del sol o refugio de esos llamados Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277677
    m_Localized: 'Nun: Aunque llueva fuego del cielo, la casa de Dios no es lugar para fenómenos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277678
    m_Localized: 'Nun: El Señor muestra misericordia solo a quienes creen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277679
    m_Localized: 'Nun: Y si ardieron en las calles, que así sea. Ese fue su juicio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277680
    m_Localized: Eres despreciable, pero no me corresponde juzgarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277681
    m_Localized: Será mejor que te vayas ahora, antes de que te dispare
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277682
    m_Localized: 'Nun: ¡Miserable insolente!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277683
    m_Localized: 'Nun: ¡¿Te has vuelto loco?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277684
    m_Localized: 'Nun: ¡Soy una sierva de Dios! Expulsada de Su casa por sabandijas sin fe... Y tú...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277685
    m_Localized: 'Nun: ¿Te atreves a burlarte de mí? ¿Dices que lo merecía?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277686
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277687
    m_Localized: 'Nun: No eres un hombre. ¡Eres una víbora!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277688
    m_Localized: 'Nun: ¡BLASFEMO! ¡NO ERES MÁS QUE OTRO BLASFEMO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277689
    m_Localized: 'Nun: Esperaba que pudieras entender. Pero no eres mejor que los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277690
    m_Localized: 'Nun: ¡Solo somos siervos! ¡SIERVOS DEL SEÑOR!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277691
    m_Localized: 'Nun: No podemos hacer nada más que aceptar Su voluntad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277692
    m_Localized: 'Nun: Él es el Señor. Su sabiduría es superior a la nuestra. Nunca comprenderemos Su gran plan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277693
    m_Localized: Eres despreciable, pero no me corresponde juzgarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277694
    m_Localized: Será mejor que te vayas ahora, antes de que te dispare
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277695
    m_Localized: 'Nun: ¿Ah, así que ahora eres el héroe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277696
    m_Localized: 'Nun: No quiero tu vil excusa de hogar. No pasaré otro instante aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277697
    m_Localized: 'Nun: Adiós. ¡La ira de Dios caerá sobre ti!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277698
    m_Localized: 'Nun: Mi intención nunca fue quedarme, para que sepas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277699
    m_Localized: 'Nun: Lo sentí en los huesos en cuanto entré: no hay Dios en esta casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277700
    m_Localized: 'Nun: Quizás Él me esté hablando incluso ahora, diciéndome que me vaya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277701
    m_Localized: 'Nun: Adiós. ¡La ira de Dios caerá sobre ti!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277702
    m_Localized: 'Fugitive: Esta maldita herida...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277703
    m_Localized: ¿Por qué vino la AFAE por ti, de todos modos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277704
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277705
    m_Localized: 'Fugitive: No estoy seguro, pero tengo una corazonada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277706
    m_Localized: 'Fugitive: Pensé que solo era un registro de rutina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277707
    m_Localized: 'Fugitive: Pero apostaría lo que sea a que fue esa perra de al lado quien me delató.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277708
    m_Localized: 'Fugitive: No nos aguantábamos. Vio la oportunidad de tenderme una trampa y la aprovechó, diciendo que yo era un "Visitante".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277709
    m_Localized: 'Fugitive: Seguramente está muy orgullosa de sí misma, la muy puta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277710
    m_Localized: 'Fugitive: Esta maldita herida...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277711
    m_Localized: ¿Cómo está tu herida?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277712
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277713
    m_Localized: 'Fugitive: Estoy bien, de verdad. Está mejorando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277714
    m_Localized: 'Fugitive: Te lo dije, la bala me atravesó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277715
    m_Localized: 'Fugitive: La gente no debería hacerse esto. Y este tipo agarra y me dispara...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277716
    m_Localized: 'Fugitive: Si seguimos así, pronto estaremos todos bajo tierra. Si no se puede dormir en la superficie, bien podríamos descansar enterrados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277717
    m_Localized: 'Fugitive: Pero no... viven como el infierno y arrastran al resto consigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277718
    m_Localized: 'Fugitive: Tenías que ver a ese lunático con el arma. Qué bastardo tan espeluznante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277719
    m_Localized: ¿Un lunático? ¿No dijiste que te dispararon los de la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277720
    m_Localized: ¿De qué lunático hablas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277721
    m_Localized: 'Fugitive: Sí, sí, fue la AFAE, él...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277722
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277723
    m_Localized: Dime la verdad
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277724
    m_Localized: Basta ya. Mientes fatal
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277725
    m_Localized: 'Fugitive: Digo... hablo de un tío de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277726
    m_Localized: 'Fugitive: Se veía muy amenazante cuando lo vi... cara a cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277727
    m_Localized: 'Fugitive: Digo... cuando me disparó... por la espalda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277728
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277729
    m_Localized: Dime la verdad
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277730
    m_Localized: Basta ya. Mientes fatal
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277731
    m_Localized: 'Fugitive: Vale, vale...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277732
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277733
    m_Localized: 'Fugitive: La verdad es que... sí salí de la zona de cuarentena, sí... pero no hubo disparos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277734
    m_Localized: 'Fugitive: Un médico me ayudó. Falsificó los papeles, me sacó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277735
    m_Localized: 'Fugitive: No puedo volver a casa. Ella sigue ahí. La vecina que me delató.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277736
    m_Localized: 'Fugitive: Así que buscaba un lugar donde esconderme. Entonces me encontré a ese tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277737
    m_Localized: 'Fugitive: Solo quería preguntar dónde podría pasar la noche. Y entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277738
    m_Localized: 'Fugitive: Vi un destello de una escopeta en su espalda, un collar de dientes y uñas. El callejón lleno de cuerpos detrás de él.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277739
    m_Localized: 'Fugitive: En ese instante supe que era un maldito maníaco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277740
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277741
    m_Localized: 'Fugitive: Mira, el dolor está volviendo. ¿Te importa si me acuesto un rato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277742
    m_Localized: 'Fugitive: Joder...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277743
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277744
    m_Localized: 'Fugitive: Escucha, te lo explicaré todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277745
    m_Localized: 'Fugitive: La verdad es que... sí salí de la zona de cuarentena, sí... pero no hubo disparos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277746
    m_Localized: 'Fugitive: Un doctor me ayudó. Falsificó los papeles, me sacó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277747
    m_Localized: 'Fugitive: No puedo volver a casa. Ella sigue ahí. La vecina que me entregó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277748
    m_Localized: 'Fugitive: Así que buscaba un lugar donde esconderme. Entonces me encontré a ese tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277749
    m_Localized: 'Fugitive: Solo iba a preguntar dónde podía pasar la noche. Y entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277750
    m_Localized: 'Fugitive: Vi el destello del rifle de asalto en su espalda, un collar de dientes y uñas. Detrás de el, el callejón estaba lleno de cuerpos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277751
    m_Localized: 'Fugitive: Fue ahí cuando me di cuenta que era un maldito maníaco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277752
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277753
    m_Localized: 'Fugitive: Mira, el dolor está regresando. ¿Te importa si me acuesto un rato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277754
    m_Localized: 'Fugitive: Esta maldita herida...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277755
    m_Localized: Cuéntame, ¿y ese lunático con el rifle de asalto, qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277756
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277757
    m_Localized: 'Fugitive: Sí, ese bicho raro, lleno de dientes y dedos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277758
    m_Localized: 'Fugitive: Vio la duda en mi cara, me encañonó. Logré cogerla y forcejeamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277759
    m_Localized: 'Fugitive: Ambos luchamos por el arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277760
    m_Localized: 'Fugitive: Disparó y lo próximo que supe fue que le golpeé el cráneo y lo noqueé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277761
    m_Localized: 'Fugitive: Corrí. Tan lejos como pude. Luego sentí el dolor en mi vientre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277762
    m_Localized: 'Fugitive: Miré abajo, sangre por todas partes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277763
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277764
    m_Localized: 'Fugitive: No dije que me disparó porque supuse que no me dejarías entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277765
    m_Localized: 'Fugitive: En tiempos así, cada quien busca cuidarse a sí mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277766
    m_Localized: 'Fugitive: Sé honesto... Si supieras que un psicópata armado podría seguirme, ¿me dejarías quedarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277767
    m_Localized: 'Fugitive: Necesitaba refugio. No quiero morir como esos pobres diablos en ese callejón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277768
    m_Localized: 'Fugitive: Así que sí... mentí. Ojalá puedas disculparme. No me guardes rencor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277769
    m_Localized: Está bien. Puedes quedarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277770
    m_Localized: No puedo confiar en ti ahora. Vete
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277771
    m_Localized: 'Fugitive: Gracias. Significa mucho que seas comprensivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277772
    m_Localized: 'Fugitive: Esperemos que ese bicho raro no aparezca. Qué bueno que tú también estás armado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277773
    m_Localized: 'Fugitive: Quizás alguien más ya se encargó de él. Diablos, puede que hasta ese Visitante pálido y escuálido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277774
    m_Localized: 'Fugitive: Bueno... supongo que tenía razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277775
    m_Localized: 'Fugitive: ¿Ves? Mentí por una razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277776
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277777
    m_Localized: 'Fugitive: ¡Hasta nunca, gilipollas!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277778
    m_Localized: 'Bestson: Ay, no... ¿Dónde se habrán metido...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277779
    m_Localized: ¿Cómo estás?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277780
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277781
    m_Localized: 'Bestson: No sé... Todo lo que quiero es volver a ver a mis padres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277782
    m_Localized: 'Bestson: Ellos me cuidaron toda mi vida y ahora... ni siquiera sé qué ha sido de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277783
    m_Localized: 'Bestson: Espero que estén bien. No puedo imaginarme estar sin ellos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277784
    m_Localized: 'Bestson: Ay, no... ¿Dónde se habrán metido...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277785
    m_Localized: ¿No tienes más parientes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277786
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277787
    m_Localized: 'Bestson: Casi nadie. Aunque...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277788
    m_Localized: 'Bestson: Hace poco me enteré de que tengo una hermana mayor... del primer matrimonio de mi padre. Pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277789
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277790
    m_Localized: 'Bestson: ¡Jolín, mi abuela!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277791
    m_Localized: 'Bestson: Ay Dios, creo que ya sé adónde podrían haber ido mis padres...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277792
    m_Localized: 'Bestson: ¿Y si la abuela era una Visitante y los asesinó? ¡¿Y si AFAE se los ha llevado?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277793
    m_Localized: 'Bestson: ¿Por qué? ¿Por qué no se quedaron? ¿Por qué no me llevaron con ellos? ¿POR QUÉ...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277794
    m_Localized: 'Bestson: NO RESISTIRÉ SOLO. ¿POR QUÉ ME DEJARON ATRÁS?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277795
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277796
    m_Localized: 'Bestson: Ay, no... ¿Dónde se habrán metido...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277797
    m_Localized: ¿Te has calmado? ¿Qué hay de esa hermana tuya?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277798
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277799
    m_Localized: 'Bestson: Bueno, yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277800
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277801
    m_Localized: 'Bestson: No mucho antes de que se fueran, recibimos una carta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277802
    m_Localized: 'Bestson: Mi padre me la trajo porque yo nunca miro el correo. Me dijo que la leyera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277803
    m_Localized: 'Bestson: Era de mi "hermana".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277804
    m_Localized: 'Bestson: Decía que quería conocerme. Pero... no supe qué pensar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277805
    m_Localized: 'Bestson: Honestamente, al principio pensé que era alguna broma. Pero mi padre me la había dado, así que no podía serlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277806
    m_Localized: 'Bestson: Me contó que en realidad no era su primer hijo. Que había tenido una hermana todo este tiempo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277807
    m_Localized: 'Bestson: No una hermana completa. Solo con el mismo padre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277808
    m_Localized: 'Bestson: Oír eso... me hizo sentir extraño. No sabía cómo lidiar con ello.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277809
    m_Localized: 'Bestson: Quiero decir, se supone que es mi "hermana", pero no la conozco de nada... se siente raro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277810
    m_Localized: 'Bestson: Eh... creo que me gustaría hablar con ella. Pero tengo demasiado miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277811
    m_Localized: 'Bestson: ¿Quizás podrías llamarla tú por mí? Aquí tienes el número {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277812
    m_Localized: 'Bestson: Solo... dile que existo. Que no sé qué hacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277813
    m_Localized: 'Bestson: Ay, no... ¿Dónde se habrán metido...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277814
    m_Localized: ¿Por qué no quieres ir a casa de tu hermana?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277815
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277816
    m_Localized: 'Bestson: Apenas la conozco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277817
    m_Localized: 'Bestson: Cuando mis padres me dijeron la verdad, sentí que me habían estado mintiendo desde siempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277818
    m_Localized: 'Bestson: Me dio mucha rabia y me fui a mi cuarto. Solo quería que me dejaran en paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277819
    m_Localized: 'Bestson: Y entonces, al día siguiente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277820
    m_Localized: 'Bestson: Pasó todo lo que te conté. Lo de la tele, el pánico y, entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277821
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277822
    m_Localized: 'Bestson: De verdad me dejaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277823
    m_Localized: 'Bestson: Dios, te juro que daría cualquier cosa solo por ver a mis padres una vez más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277824
    m_Localized: 'Bestson: Dios, ¿por qué...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277825
    m_Localized: Ve a casa de tu hermana. Seguro te puede ayudar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277826
    m_Localized: ¿Estás seguro de que tus padres están muertos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277827
    m_Localized: 'Bestson: ¿En serio? ¿Tú crees?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277828
    m_Localized: 'Bestson: Pero es que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277829
    m_Localized: 'Bestson: Nunca me había ido tan lejos sin mis padres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277830
    m_Localized: 'Bestson: Ella vive muy lejos de aquí. Y yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277831
    m_Localized: 'Bestson: Tengo miedo. No creo que pueda hacerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277832
    m_Localized: Agarra un taxi. Todavía están funcionando.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277833
    m_Localized: Tienes que hacer algo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277834
    m_Localized: 'Bestson: Bueno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277835
    m_Localized: 'Bestson: No regresaron por mí, así que yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277836
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277837
    m_Localized: 'Bestson: No sé...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277838
    m_Localized: Intenta localizar a tu abuela
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277839
    m_Localized: Intenta a revisar las zonas de cuarentena
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277840
    m_Localized: 'Bestson: Oye, eso... no es tan mala idea, la verdad. Es algo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277841
    m_Localized: 'Bestson: Pero escuché que los taxis están muy caros ahorita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277842
    m_Localized: 'Bestson: Pero agarré la reserva de mis padres. Quizás me alcanza para pagar un viaje a lo de mi hermana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277843
    m_Localized: 'Bestson: Gracias por hacerme entrar en razón. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277844
    m_Localized: 'Bestson: Puede que tengas razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277845
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277846
    m_Localized: 'Bestson: Puede que en serio haya estado dependiendo de mis padres por mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277847
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277848
    m_Localized: 'Bestson: Gracias por hacerme entrar en razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277849
    m_Localized: 'Bestson: Intentaré conseguir un taxi. Por suerte, me traje la reserva de dinero de mis papás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277850
    m_Localized: 'Bestson: Espero poder hacer esto. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277851
    m_Localized: 'Bestson: Quizás... quizás tengas razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277852
    m_Localized: 'Bestson: ¿Quizás su auto se descompuso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277853
    m_Localized: 'Bestson: Sí, papá decía que necesitaba volverlo a reparar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277855
    m_Localized: 'Bestson: Quizás... quizás de verdad los encuentre ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277856
    m_Localized: 'Bestson: Gracias por hacerme entrar en razón. Ya debería irme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277858
    m_Localized: 'Bestson: Quizás de verdad estén ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277859
    m_Localized: 'Bestson: Supongo que tengo que intentarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277860
    m_Localized: 'Bestson: Gracias por hacerme entrar en razón. Ya debería irme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277861
    m_Localized: 'Buddy: Pregunta lo que quieras, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277862
    m_Localized: ¿Cómo estás?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277863
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277864
    m_Localized: 'Buddy: ¡Me siento muy bien, tío!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277865
    m_Localized: 'Buddy: Me he asomado a tu nevera. Jo, tío, si llego a saber que tenías TANTA cerveza...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277866
    m_Localized: 'Buddy: ¿Dónde la conseguiste? ¿Tienes un tío en una cervecería o algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277867
    m_Localized: 'Buddy: ¡Ah, da igual! ¡Quédate tus secretos!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277868
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277869
    m_Localized: 'Buddy: Joder, si no fuera por todo este lío, tío, estaríamos tranquilos, bebiendo unas frescas, viendo fútbol. Incluso te presentaría a...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277870
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277871
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277872
    m_Localized: ¿Te encuentras bien?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277873
    m_Localized: ¿Te has paralizado?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277874
    m_Localized: 'Buddy: ¿Eh? ¿Qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277875
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277876
    m_Localized: 'Buddy: No importa. Olvídalo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277877
    m_Localized: 'Buddy: Nah, es solo que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277878
    m_Localized: 'Buddy: Mmm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277879
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277880
    m_Localized: 'Buddy: Solo estoy pensando, eso es todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277881
    m_Localized: 'Buddy: Pregunta lo que quieras, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277882
    m_Localized: Hoy te veo de bajón
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277883
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277884
    m_Localized: 'Buddy: Yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277885
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277886
    m_Localized: 'Buddy: No quiero hablar de eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277887
    m_Localized: ¿Hablar de qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277888
    m_Localized: ¿De qué hablas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277889
    m_Localized: 'Buddy: Da igual. No lo entenderías.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277890
    m_Localized: Creo que debería saberlo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277891
    m_Localized: Vale, no te presionaré
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277892
    m_Localized: 'Buddy: A ver, es que no quiero hablar del tema.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277893
    m_Localized: Creo que debería saberlo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277894
    m_Localized: Vale, no te presionaré
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471936
    m_Localized: 'Buddy: ¡No me presiones! Ya apenas me aguanto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471937
    m_Localized: 'Buddy: Solo... déjame en paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471938
    m_Localized: 'Buddy: Gracias. No me siento muy bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471939
    m_Localized: 'Buddy: Pregunta lo que quieras, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471940
    m_Localized: ¿Qué te pasa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471941
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471942
    m_Localized: 'Buddy: ¡Eso no es asunto tuyo, tío! ¡Apártate!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471943
    m_Localized: Solo dime qué está pasando
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471944
    m_Localized: Vas a tener que hablar. Será peor si no lo haces
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471945
    m_Localized: 'Buddy: No puedo... Me mirarás diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471946
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471947
    m_Localized: 'Buddy: Pensándolo bien... No puedo reprimir esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471948
    m_Localized: 'Buddy: Tenía una perra. Murió hace unos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471949
    m_Localized: ¿Y eso qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471950
    m_Localized: ¿Y?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471951
    m_Localized: 'Buddy: ¿Qué, planeas matarme, tío?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471952
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471953
    m_Localized: 'Buddy: Vale. ¿Quieres la verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471954
    m_Localized: 'Buddy: Tenía una perra. Murió hace unos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471955
    m_Localized: ¿Y eso qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471956
    m_Localized: ¿Y?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471957
    m_Localized: 'Buddy: Esa es la cuestión. Ya era vieja, estaba enferma... pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471958
    m_Localized: 'Buddy: Ella solo no...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471959
    m_Localized: 'Buddy: Yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471960
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471961
    m_Localized: 'Buddy: La maté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471962
    m_Localized: ¡¿Pero qué has hecho?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471963
    m_Localized: ¡Maldito enfermo!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471964
    m_Localized: 'Buddy: Yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471965
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471966
    m_Localized: 'Buddy: La maté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471967
    m_Localized: ¡¿Pero qué has hecho?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471968
    m_Localized: ¡Maldito enfermo!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471969
    m_Localized: 'Buddy: Sé cómo suena eso. Pero déjame decir lo mío, tío. Ella... ella estaba sufriendo. No podía seguir viéndola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471970
    m_Localized: 'Buddy: Día tras día, veía el dolor en sus ojos. La oía gimotear por las noches, llorando por el dolor en sus patas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471971
    m_Localized: 'Buddy: ¡ESE MALDITO COCHE! Si ese taxista no hubiera conducido como un maniático, quizás ella todavía estaría aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471972
    m_Localized: 'Buddy: Maldita sea, daría lo que fuera por retorcerle el cuello. Pero huyó y no pillé la matrícula...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471973
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471974
    m_Localized: 'Buddy: No sabes lo que se siente, perder una mascota.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471975
    m_Localized: 'Buddy: Sabes lo que dicen: para nosotros, son solo un capítulo. Pero para ellos, somos su historia completa. Y de alguna forma, nos enseñan más de lo que cualquier persona podría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471976
    m_Localized: Vale, no te voy a echar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471977
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471978
    m_Localized: 'Buddy: Sí, ya sé... soy un cabrón. Todavía no puedo perdonarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471979
    m_Localized: 'Buddy: Ella... estaba sufriendo. Ya no pude soportarlo más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471980
    m_Localized: 'Buddy: Cada día, empeoraba. Las noches eran lo más difícil... lloraba, gimoteaba... y las lágrimas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471981
    m_Localized: 'Buddy: ¿Alguna vez has visto a un perro llorar? Sus ojos me suplicaban que terminara con todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471982
    m_Localized: 'Buddy: ¡No quería! ¡Juro que no quería! Mi mano nunca debió...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471983
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471984
    m_Localized: 'Buddy: ¡PUTO TAXISTA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471985
    m_Localized: 'Buddy: ¡El cabrón atropelló a mi perra! ¡Y luego se largó como si nada!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471986
    m_Localized: 'Buddy: ¡Como si fuera una piedra en el camino, no un ser vivo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471987
    m_Localized: 'Buddy: Maldita sea, daría lo que fuera por retorcerle el cuello. Pero huyó y no pillé la matrícula...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471988
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471989
    m_Localized: 'Buddy: No sabes lo que se siente, perder una mascota.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471990
    m_Localized: 'Buddy: Sabes lo que dicen: para nosotros, son solo un capítulo. Pero para ellos, somos su historia completa. Y de alguna forma, nos enseñan más de lo que cualquier persona podría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471991
    m_Localized: Vale, no te voy a echar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471992
    m_Localized: Deberías irte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471993
    m_Localized: 'Buddy: Gracias, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471994
    m_Localized: 'Buddy: Me alegra que lo entiendas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471995
    m_Localized: 'Buddy: Tío, sí. Quizás esto sea lo mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471996
    m_Localized: 'Buddy: Lo pienso todos los jodidos días... si actué bien al poner fin a su sufrimiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471997
    m_Localized: 'Buddy: Supongo que nunca lo sabré en realidad...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471998
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472176
    m_Localized: 'Blind: Qué oscuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472177
    m_Localized: Dime, pues, ¿qué fue lo que viste?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666240
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666241
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666242
    m_Localized: 'Blind: No quieres saber. Confía en mí. Es una misericordia no saber.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666243
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666244
    m_Localized: 'Blind: Pensé que si me arrancaba los ojos, me libraría de esa... cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666245
    m_Localized: 'Blind: Pero ahora tengo la imágen grabada...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666246
    m_Localized: 'Blind: Todavía sueño y... s-siempre está ahí. ESO me visita a menudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666247
    m_Localized: 'Blind: Qué oscuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666248
    m_Localized: ¿Y bien? ¿Estás mejor sin tus ojos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666249
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666250
    m_Localized: 'Blind: Es difícil de decir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666251
    m_Localized: 'Blind: Sé que nunca volveré a ver a esa cosa. Incluso si algo me mata, no sabré qué fue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666252
    m_Localized: 'Blind: Aunque, bueno... es extraño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666253
    m_Localized: 'Blind: No sé qué aspecto tiene tu casa. Es difícil moverse. Me dolerían las cuencas de no ser por las medicinas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666254
    m_Localized: 'Blind: Ya me adaptaré. Por lo menos no tendré que ver ese horror otra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666255
    m_Localized: 'Blind: Aun así... el saber lo que vi... Es algo que jamás olvidaré, algo que arrastraré hasta que me llegue la hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666256
    m_Localized: 'Blind: Qué oscuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666257
    m_Localized: Tienes mal aspecto.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666258
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666259
    m_Localized: 'Blind: ¿Será que no me peiné? ¿Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666260
    m_Localized: 'Blind: Anoche tuve un sueño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666261
    m_Localized: 'Blind: Caminaba por las vías del tranvía, yendo a casa. Habían casas y árboles alrededor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666262
    m_Localized: 'Blind: Escuché el tranvía acercarse y me hice a un lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666263
    m_Localized: 'Blind: Me di la vuelta y vi algo llevarse a un hombre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666264
    m_Localized: 'Blind: Se movió tan rápido a su alrededor que no pude verlo con claridad. Pero yo sabía. Sabía lo que era.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666265
    m_Localized: 'Blind: Corrí tras el tranvía, pero ni me acerqué. Nunca iba a llegar. Nunca llegaré a la verdad que se esconde al final de la línea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666266
    m_Localized: 'Blind: Entonces me desperté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666267
    m_Localized: 'Blind: Qué oscuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666268
    m_Localized: ¿Estás bien?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666269
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666270
    m_Localized: 'Blind: Tuve otro sueño. Volvió a aparecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666271
    m_Localized: 'Blind: Iba por un camino. Era de noche. Las luces de la calle parpadeaban.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666272
    m_Localized: 'Blind: Me di la vuelta y lo vi acercándose hacia mí. Lentamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666273
    m_Localized: 'Blind: Esta vez vi cómo se movía. Claramente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666274
    m_Localized: 'Blind: Intenté correr, pero me estaba alcanzando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666275
    m_Localized: 'Blind: Llegué a mi casa, pero no pude abrir el portón. Salté la valla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666276
    m_Localized: 'Blind: Revolví la mano en mi bolsillo, temblando, y las llaves se me resbalaban.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666277
    m_Localized: 'Blind: Así que corrí alrededor de la casa, vi otra valla y volví a saltar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666278
    m_Localized: 'Blind: Me detuve. No escuché nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666279
    m_Localized: 'Blind: Miré hacia arriba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666280
    m_Localized: 'Blind: Y ahí estaba. Intentando alcanzarme por encima de la valla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666281
    m_Localized: 'Blind: A lo mejor es solo por los calmantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666282
    m_Localized: 'Blind: Qué oscuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666283
    m_Localized: ¿Soñaste algo anoche?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666284
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666285
    m_Localized: 'Blind: Sí'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666286
    m_Localized: 'Blind: No quiero hablar de eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666287
    m_Localized: 'Blind: Ahora entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666288
    m_Localized: 'Blind: Todos vamos a morir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666289
    m_Localized: 'Blind: Nos hará pedazos. Despiertos o dormidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666290
    m_Localized: 'Blind: Todos vamos a arder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666291
    m_Localized: 'Blind: Ya nada importa. Se acabó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666292
    m_Localized: 'Blind: Yo... Déjame. Por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666293
    m_Localized: 'Dude: Eh, colega.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666294
    m_Localized: ¿Qué hacías antes del cataclismo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666295
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666296
    m_Localized: 'Dude: Tío, estaba de relax. Viendo pelis, quedando con los colegas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666297
    m_Localized: 'Dude: ¿Pero ahora? Se acabaron las pelis, se acabaron los planes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666298
    m_Localized: 'Dude: La tele solo repite la misma mierda de pánico y anuncios. Mis colegas ni cogen el teléfono.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666299
    m_Localized: 'Dude: Oí a un pez gordo diciendo "Ahora no es tiempo para divertirse, estamos en crisis...".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666300
    m_Localized: 'Dude: Tío, que le den a ese. Yo decido cuándo es hora de divertirse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666301
    m_Localized: 'Dude: Eh, colega.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666302
    m_Localized: ¿A qué te dedicabas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666303
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666304
    m_Localized: 'Dude: ¿Currar? Pffff.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666305
    m_Localized: 'Dude: Tío, solo los pringados trabajan. Yo estaba viviendo, hombre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666306
    m_Localized: 'Dude: Vi esta peli una vez. ¿El prota? Era tal cual yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666307
    m_Localized: 'Dude: Dime, ¿los obreros de fábrica parecen felices? Qué va.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666308
    m_Localized: 'Dude: Montaba fiestas, conocía gente nueva... eso es vivir de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666309
    m_Localized: 'Dude: Vale, vale... Fui encargado de almacén una vez. En una empresa de reparto. Gracias a mis viejos, ya sabes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666310
    m_Localized: ¿Así que vives de tus padres?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666311
    m_Localized: ¿Entonces, solo eres un vago?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666312
    m_Localized: 'Dude: ¿Para qué currar, colega? Lo tengo solucionado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666313
    m_Localized: 'Dude: ¿No usar lo que tienes? Eso es de tontos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666314
    m_Localized: 'Dude: O sea, si tienes un arma. ¿La vas a colgar en la pared o la vas a usar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666315
    m_Localized: 'Dude: Exacto. No soy tonto. Uso mis ventajas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666316
    m_Localized: 'Dude: Oye, tranquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666317
    m_Localized: 'Dude: Si tienes envidia, solo dilo, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666318
    m_Localized: 'Dude: Lo entiendo, no todos ganan el premio gordo. Así es la vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666319
    m_Localized: 'Dude: Eh, colega.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666320
    m_Localized: ¿Hay algún problema?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666321
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666322
    m_Localized: 'Dude: Tío... ¿dónde tienes las películas? Tienes que si, o sea, cero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666323
    m_Localized: 'Dude: ¿Es que ves algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666324
    m_Localized: 'Dude: Me muero de aburrimiento aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666325
    m_Localized: Este no es momento para películas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666326
    m_Localized: No tengo ninguna.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666327
    m_Localized: 'Dude: Tío, pensé que este sitio molaría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666328
    m_Localized: 'Dude: ¿Pero tu gente? Un poco cutre. Y nada que ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666329
    m_Localized: 'Dude: Ni revistas, ni pelis... solo libros...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666330
    m_Localized: 'Dude: ¿Quién demonios lee, tío? ¡Eso es de la prehistoria! Pura palabrería y descripciones sin fin. Qué rollo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666331
    m_Localized: Esto no es una sala de cine
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666332
    m_Localized: ¿Estás aquí de juerga o para sobrevivir?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666333
    m_Localized: 'Dude: ¡Espera, ¿qué?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666334
    m_Localized: 'Dude: Colega, ni hablar. ¿Me estás tomando el pelo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666335
    m_Localized: 'Dude: ¡¿Tienes una tele en tu propia habitación y ni una maldita película?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666336
    m_Localized: 'Dude: Colega, esta fiesta es un asco. Creí que serías guay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666337
    m_Localized: Esto no es una sala de cine
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666338
    m_Localized: ¿Estás aquí de juerga o para sobrevivir?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666339
    m_Localized: 'Dude: Venga, tío...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666340
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666341
    m_Localized: 'Dude: Eres el más aguafiestas que he conocido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666342
    m_Localized: Si quieres sobrevivir, cálmate
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666343
    m_Localized: Si no te gusta este lugar, puedes marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666344
    m_Localized: 'Dude: Venga, tío...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666345
    m_Localized: 'Dude: Mi tele está frita en casa, colega. Tenía la esperanza de que me salvaras de morir de aburrimiento, pero nooo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666346
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666347
    m_Localized: 'Dude: Eres el más aguafiestas que he conocido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666348
    m_Localized: Si quieres sobrevivir, cálmate
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666349
    m_Localized: Si no te gusta este lugar, puedes marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666350
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666351
    m_Localized: 'Dude: Vale, lo que sea, tío. Este sitio es un asco, pero es mejor que la calle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666352
    m_Localized: 'Dude: Solo... déjame ver la tele, colega. Solo un ratito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666353
    m_Localized: 'Dude: ¡Lo sabía! ¡Eres un aguafiestas!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666354
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666355
    m_Localized: 'Dude: Me piro de aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666356
    m_Localized: 'Teacher: Pobrecitos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666357
    m_Localized: ¿Estás bien?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666358
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666359
    m_Localized: 'Teacher: Sí, supongo... No sé...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666360
    m_Localized: 'Teacher: Es que... no comprendo cómo adultos, racionales y ya crecidos, pueden permitir que sus emociones los lleven a hacer algo así.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666361
    m_Localized: 'Teacher: ¿Tan aterrados están que incluso matarían a un niño?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666362
    m_Localized: Hoy en día, la gente hace cosas peores
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666363
    m_Localized: En el caos, la razón es lo primero que se pierde
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666364
    m_Localized: 'Teacher: ¿Qué podría ser peor que matar a un niño?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666365
    m_Localized: 'Teacher: No fue solo una persona... fue una multitud, una turba, con su cacería de brujas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666366
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666367
    m_Localized: 'Teacher: Quizás los tiempos difíciles realmente muestran quiénes somos por dentro. Quizás somos los verdaderos monstruos, no los que vinieron de la tierra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666368
    m_Localized: 'Teacher: Pero, ¿la gente no se da cuenta de que matar niños es...? Ni siquiera hallo las palabras...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666369
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666370
    m_Localized: 'Teacher: Quizás los tiempos difíciles realmente muestran quiénes somos por dentro. Quizás somos los verdaderos monstruos, no los que vinieron de la tierra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666371
    m_Localized: 'Teacher: Pobrecitos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666372
    m_Localized: ¿Cuánto tiempo has sido maestra?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666373
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666374
    m_Localized: 'Teacher: Por unos tres meses antes del cataclismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666375
    m_Localized: 'Teacher: Pero... no fui una maestra modelo. No me gustaba el trabajo. En ese entonces, los niños me parecían ruidosos y agotadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666376
    m_Localized: 'Teacher: El cataclismo cambió eso. Me abrió los ojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666377
    m_Localized: 'Teacher: Sabes, cualquiera de esos niños pudo haberse convertido en una estrella de rock, un político, un padre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666378
    m_Localized: 'Teacher: Pero ahora, nunca sostendrán una guitarra, nunca irán al colegio, nunca crecerán.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666379
    m_Localized: 'Teacher: Solo serán para siempre... un ejército de soñadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666380
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666381
    m_Localized: 'Teacher: Recuerdo el día que uno de los niños entró corriendo. Llorando, diciendo que sus padres le tenían miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666382
    m_Localized: 'Teacher: Creían que era un Visitante y... lo echaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666383
    m_Localized: 'Teacher: No sabía a dónde más ir, así que vino a mí... al jardín de infancia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666384
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666385
    m_Localized: 'Teacher: (La mujer, apenas conteniendo las lágrimas, llora)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666386
    m_Localized: 'Teacher: Perdona...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666387
    m_Localized: 'Teacher: Pobrecitos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666388
    m_Localized: Lamento lo de ayer, no quise molestarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666389
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666390
    m_Localized: 'Teacher: Está bien. Estoy... ya estoy bien. Me siento mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666391
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666392
    m_Localized: 'Teacher: Acerca de aquel niño... Tras lo que le ocurrió, me di cuenta de lo indefensos que son los niños. Sobre todo cuando las cosas se desmoronan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666393
    m_Localized: 'Teacher: Empecé a acoger a cada "marginado" y alma abandonada que pude.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666394
    m_Localized: 'Teacher: Escuché sus historias... Era insoportable oír cómo algunos padres los abandonaron sin dudarlo un instante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666395
    m_Localized: 'Teacher: Como si el cataclismo fuese solo una excusa para renunciar a un hijo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666396
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666397
    m_Localized: 'Teacher: Puede que... en realidad, nunca desearan tener críos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666398
    m_Localized: 'Teacher: Pobrecitos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666399
    m_Localized: ¿Tuviste hijos propios?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666400
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666401
    m_Localized: 'Teacher: No, yo... Mi madre solía decirme que me estableciera, que tuviera un hijo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666402
    m_Localized: 'Teacher: Pero no estaba lista. Quería que fuera una elección consciente, cuando sintiera que era el momento adecuado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666403
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666404
    m_Localized: 'Teacher: Escuchando todas esas historias de los niños abandonados... No pude evitar preguntarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666405
    m_Localized: 'Teacher: Si hubiera escuchado a mi madre, tal vez habría terminado igual que sus padres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666406
    m_Localized: 'Teacher: Por eso elegí ayudar a cada niño abandonado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666407
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666408
    m_Localized: 'Teacher: ¿Sabes qué es lo peor? Uno de los pirómanos era padre de uno de los niños que acogí...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666409
    m_Localized: 'Teacher: (La mujer no puede contener las lágrimas de nuevo)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666410
    m_Localized: 'Teacher: Perdona...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666411
    m_Localized: 'Teacher: Yo... Yo de verdad intenté darles una buena vida. Los cuidé. No debería haber terminado así...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666412
    m_Localized: 'Teacher: Lo lamento muchísimo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666413
    m_Localized: Sus muertes no son culpa tuya
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666414
    m_Localized: Lamento tu pérdida
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666415
    m_Localized: 'Teacher: Puede que tengas razón. Pero... todavía me siento tan vacía por dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666416
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666417
    m_Localized: 'Teacher: ¿Sabes qué idea no puedo quitarme de la cabeza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666418
    m_Localized: 'Teacher: ¿Y si sus padres jamás sintieron algo por ellos? ¿Y si nunca los quisieron de verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666419
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666420
    m_Localized: 'Teacher: Yo solo... espero haber podido hacerles sentir aunque sea un poco de amor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666421
    m_Localized: 'Teacher: Gracias... pero todavía me siento rota. No creo que jamás supere esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666422
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666423
    m_Localized: 'Teacher: ¿Sabes qué idea no puedo quitarme de la cabeza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666424
    m_Localized: 'Teacher: ¿Y si sus padres jamás sintieron algo por ellos? ¿Y si nunca los quisieron de verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666425
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666426
    m_Localized: 'Teacher: Yo solo... espero haber podido hacerles sentir aunque sea un poco de amor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860544
    m_Localized: 'Ballerina: ¿Qué más quieres si ya tienes este gatito de aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860545
    m_Localized: ¿Por qué estás aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860546
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860547
    m_Localized: 'Ballerina: Vaya pregunta más tonta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860548
    m_Localized: 'Ballerina: Tú abriste la puerta. Pregúntate para qué. ¿Para qué estoy aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860549
    m_Localized: 'Ballerina: Para mí todo es lo mismo, un sitio es un sitio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860550
    m_Localized: 'Ballerina: Me dijeron que viniera para acá, así que vine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860551
    m_Localized: 'Ballerina: No quiero nada de ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860552
    m_Localized: 'Ballerina: Lo importante es que mantengas este sitio cómodo para mí. ¿Lo demás? A quién le importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860553
    m_Localized: 'Ballerina: ¿Qué más quieres si ya tienes este gatito de aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860554
    m_Localized: ¿Acaso eres humana?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860555
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860557
    m_Localized: 'Ballerina: ¿Acaso queda algo de eso en ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860558
    m_Localized: 'Ballerina: ¿Qué tengo de malo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860559
    m_Localized: 'Ballerina: ¿Qué más quieres si ya tienes este gatito de aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860560
    m_Localized: ¿Quién te ha enviado?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860561
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860562
    m_Localized: 'Ballerina: Ya hiciste lo que se supone que tenías que hacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860563
    m_Localized: 'Ballerina: ¿Para qué preocuparse por lo demás?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860564
    m_Localized: 'Ballerina: Vale, es que me ha enviado... eh, alguien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860565
    m_Localized: 'Ballerina: Pero no me dijeron qué tenía que hacer después.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860566
    m_Localized: 'Ballerina: ¿Qué más quieres si ya tienes este gatito de aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860567
    m_Localized: ¿Cuánto tiempo piensas quedarte aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860568
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860569
    m_Localized: 'Ballerina: Hasta que vengan a buscarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860570
    m_Localized: 'Ballerina: ¿Qué más se supone que haga?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860571
    m_Localized: 'Ballerina: No sé. Me dijeron que hiciera algo y ahora espero hasta que me digan más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860572
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860573
    m_Localized: 'Ballerina: ¿Y a ti quién te dice qué hacer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860574
    m_Localized: 'Ballerina: ¿A quién esperas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860575
    m_Localized: 'Ballerina: ¿Qué más quieres si ya tienes este gatito de aquí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860576
    m_Localized: ¿Por qué no me has matado?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860577
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860578
    m_Localized: 'Ballerina: Eres algo tonto, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860579
    m_Localized: 'Ballerina: Siempre es lo mismo, todos los días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860580
    m_Localized: 'Ballerina: Ya te dije que no me dijeron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860581
    m_Localized: 'Ballerina: Yo espero. ¿Por qué esperas tú?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860582
    m_Localized: 'Mother: Aquí dentro hace un calor sofocante...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860583
    m_Localized: ¿Estás bien? ¿Qué tal está la nena?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860584
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860585
    m_Localized: 'Mother: Sí, sí... Está... está cansada, igual que yo. Y es tímida con la gente nueva, por eso se me pega.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860586
    m_Localized: 'Mother: A los críos les cuesta gestionar cosas así. Aunque no se quejen, se les nota en la cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860587
    m_Localized: 'Mother: A veces siento que es mi culpa por arrastrarlos a todo esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860588
    m_Localized: 'Mother: Pero ya es muy tarde para cambiar nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860589
    m_Localized: 'Couple: Cielo, ¿por qué pones esa cara?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860590
    m_Localized: ¿Por qué estabais en la calle?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860591
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860592
    m_Localized: 'Couple: Oh, solo íbamos a visitar a la madre de mi querida esposa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860593
    m_Localized: 'Couple: Nos dimos cuenta a tiempo de que no lo lograríamos solos y, pues, nos topamos con tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860594
    m_Localized: 'Couple: Gracias por dejarnos estar aquí, por cierto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860595
    m_Localized: 'Couple: Cielo, ¿por qué pones esa cara?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860596
    m_Localized: ¿Qué tan lejos tienen que ir?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860597
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860598
    m_Localized: 'Couple: A mi cielo no se le dan bien las direcciones por aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860599
    m_Localized: 'Couple: Si nadie nos ayuda, ¿entonces quizás dos días?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860600
    m_Localized: 'Couple: Luego de que nos perdamos algunas veces, seguro que averigüamos el camino. ¡Já! ¿No, querida?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860601
    m_Localized: 'Couple: Aunque si alguien nos lleva, sería perfecto y entonces sería solo un par de horas como mucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860602
    m_Localized: ¿Por qué quieren visitar a su madre de repente?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860603
    m_Localized: Es el momento más inoportuno para irse
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860604
    m_Localized: 'Couple: Cualquier cosa pudo haberle pasado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860605
    m_Localized: 'Couple: El teléfono de su madre ha estado apagado. Llevamos días sin poder contactar con ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860606
    m_Localized: 'Couple: Tenemos que asegurarnos de que esté bien, quizás necesite ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860607
    m_Localized: 'Couple: Y las noches son más cortas ahora. Es un poco aterrador andar por ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860608
    m_Localized: 'Couple: Pero está bien, veremos a tu madre pronto, ¿verdad, cielo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860609
    m_Localized: 'Couple: No recuerdo el camino y mi esposa siempre elige la dirección equivocada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860610
    m_Localized: 'Couple: Pero no importa. Lo único que importa es seguir adelante, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860611
    m_Localized: 'Couple: ¡Quizás lleguemos en una semana! ¡Jajajaja!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860612
    m_Localized: 'Couple: Cielo, ¿por qué pones esa cara?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860613
    m_Localized: Pensé que os ibais esta noche
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860614
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860615
    m_Localized: 'Couple: Verás, mi tontita esposa tardó tres horas enteras en arreglarse. Ya era demasiado tarde para salir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860616
    m_Localized: 'Couple: Así que iremos más tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860617
    m_Localized: 'Couple: Para la próxima, seremos más rápidos. De verdad, disculpe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860618
    m_Localized: 'Couple: Me aseguraré de que esta lenta dama no nos retrase de nuevo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860619
    m_Localized: 'Couple: No estamos molestando mucho, ¿verdad? ¡Disculpe otra vez!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860620
    m_Localized: 'Couple: Cielo, ¿por qué pones esa cara?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860621
    m_Localized: ¿Señorita, se encuentra bien?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860622
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860623
    m_Localized: 'Couple: Ella está bien. ¿Por qué le pregunta a ella?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860624
    m_Localized: 'Couple: Yo soy el que le está hablando a usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860625
    m_Localized: 'Couple: Solo está un poco nerviosa, eso es todo. Nada de qué preocuparse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860626
    m_Localized: Le pregunté a ella
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860627
    m_Localized: ¿Y cómo se encuentran?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860628
    m_Localized: 'Couple: Está cansada. No la presione, por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860629
    m_Localized: 'Couple: Honestamente, creo que dejó de importarle su madre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860630
    m_Localized: 'Couple: Pero está bien. Esta tortuguita se pondrá en marcha al final, e iremos a ver a su madre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860631
    m_Localized: 'Couple: ¡Si es que sigue viva, ja-ja!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860632
    m_Localized: 'Couple: Venga, cariño, arréglate ya. ¿Cuánto tiempo tengo que esperar? ¡Mierda!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860633
    m_Localized: 'Couple: Ah, en general todo está bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860634
    m_Localized: 'Couple: Parece que a mi querida no le importa un pimiento su propia madre, jaja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860635
    m_Localized: 'Couple: Quizás deba darte un pequeño empujón, ¿eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860636
    m_Localized: 'Couple: Lamento que tenga que escuchar esto. Solo me está volviendo loco con su lentitud.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860637
    m_Localized: 'Couple: Siéntate y arréglate, ¡estoy hasta los cojones de esperar! ¡Mierda!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860638
    m_Localized: 'Couple: Cielo, ¿por qué pones esa cara?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860639
    m_Localized: Su esposa no quiere irse. ¿Qué está pasando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860640
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860641
    m_Localized: 'Couple: Me tiene hasta los malditos cojones, ¿lo entiende?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860642
    m_Localized: 'Couple: Siempre quejándose, siempre culpándome.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860643
    m_Localized: 'Couple: O sea, qué tan difícil es que cierre la maldita boca y haga lo que digo. Pero no, nunca es tan simple.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860644
    m_Localized: 'Couple: Lamento que nos hayamos quedado de más, de verdad. Este es el último día. Ya nos vamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860645
    m_Localized: 'Couple: ¿Me oyes? Prepara tus malditas cosas. Si seguimos aquí de noche, juro que te voy a lanzar por la maldita ventana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860646
    m_Localized: Señorita, ¿está segura de que se encuentra bien?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860647
    m_Localized: ¿Qué está pasando aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860648
    m_Localized: 'Couple: No se meta en esto, por favor. Ya se lo he dicho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860649
    m_Localized: 'Couple: No te metas. No es asunto tuyo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860650
    m_Localized: 'Couple: Ya lo arreglaremos, no me pongas nervioso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860651
    m_Localized: Ya me harté de tus gilipolleces, dime la verdad, YA
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860652
    m_Localized: Me da igual. ¿Os vais o no?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860653
    m_Localized: 'Couple: Mira, hombre, ya te he dicho que todo está bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860654
    m_Localized: 'Couple: Mi mujer solo está aburrida, por eso se comporta así. Me cabrea un poco, eso es todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860656
    m_Localized: Ya me harté de tus gilipolleces, dime la verdad, YA
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860657
    m_Localized: Me da igual. ¿Os vais o no?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860658
    m_Localized: 'Couple: Eh, tranquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860659
    m_Localized: 'Couple: Tengo una escopeta en la mano. Si intentas algo, le disparo a esta tía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860660
    m_Localized: 'Couple: No tengo nada que perder. ¿Y tú?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860661
    m_Localized: Igual te dispararé y morirás
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860662
    m_Localized: Aún puedes marcharte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860663
    m_Localized: 'Couple: Sí, sí, no nos quedaremos más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860664
    m_Localized: 'Couple: Nos vamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054848
    m_Localized: 'Couple: ¿Me oyes? Esta es nuestra última noche aquí. Prepárate de una puta vez y deja de perder el tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054849
    m_Localized: 'Couple: ¿Qué tengo que perder? Vale, me matas, ¿y entonces qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054850
    m_Localized: 'Couple: Al menos el sufrimiento se acaba. Y si esta tía muere conmigo, estaré satisfecho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054851
    m_Localized: Voy a disparar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054852
    m_Localized: Cálmate. Suelta el arma y yo bajaré la mía...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054853
    m_Localized: 'Couple: ¿Por qué? Necesito irme con ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054854
    m_Localized: 'Couple: Sin ella, no me marcho. Baje su escopeta. Partimos esta noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054855
    m_Localized: 'Couple: Nadie tiene que salir herido, si solo lo deja pasar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054856
    m_Localized: Voy a disparar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054857
    m_Localized: Cálmate. Suelta el arma y yo bajaré la mía...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054858
    m_Localized: 'Couple: ¿De verdad vas a dispararle a una mujer? ¿No te importa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054859
    m_Localized: 'Couple: Si me disparas, le darás a ella también. Su sangre estará en tus manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054860
    m_Localized: 'Couple: ¡No sería mi culpa! ¡Su sangre estará en tus manos!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054861
    m_Localized: Disparar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054862
    m_Localized: Advertir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054863
    m_Localized: 'Couple: Mira, debo irme. O nos vamos, o nos morimos los dos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054864
    m_Localized: 'Couple: No hay otra manera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054865
    m_Localized: 'Couple: Si esta maldita perra no hubiese estado temblando como una puta hoja y hubiese venido conmigo en primer lugar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054866
    m_Localized: 'Couple: Todo esto es culpa tuya. ¿Me escuchas? ¡Lo has arruinado todo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054867
    m_Localized: Disparar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054868
    m_Localized: Advertir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054869
    m_Localized: 'Couple: ¿Vas... vas a bajar el arma?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054870
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054871
    m_Localized: 'Couple: Espera, no, ¿todavía piensas disparar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054872
    m_Localized: 'Couple: ¡ESPERA! ¡NO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054873
    m_Localized: 'Couple: Va-vale. Nos iremos. Solo mantengamos la calma'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054874
    m_Localized: 'Couple: ¿Verdad? ¿Sí nos iremos esta puta noche, eh, zorra?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054875
    m_Localized: 'Couple: (De repente la mujer se suelta y el hombre le dispara)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054876
    m_Localized: 'Couple: (Reaccionas al instante y le disparas al hombre en la cabeza)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054877
    m_Localized: "Couple: \n(Parece que ambos están muertos... Al menos esto ya se acabó)"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054878
    m_Localized: 'Couple: (Qué pareja más rara...)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054879
    m_Localized: 'Couple: Vale, vale, nos vamos. Ya. Solo déjanos coger algo para cubrirnos y nos habremos ido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054880
    m_Localized: 'Couple: No nos volverás a ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054881
    m_Localized: 'Couple: Espera...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054882
    m_Localized: 'Couple: ¿P-PERO Q-QUÉ HACES?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054883
    m_Localized: 'Couple: (Disparas al hombre, dándole también a la mujer)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054884
    m_Localized: 'Couple: (Ambos caen, sangrando)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054885
    m_Localized: 'Couple: (La mujer se atraganta un momento, pero no puedes ayudarla)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054886
    m_Localized: 'Couple: (Ambos están muertos)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054887
    m_Localized: 'Couple: ¿No lo entiendes? No hay otra manera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054888
    m_Localized: 'Couple: Nos vamos y punto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054889
    m_Localized: 'Couple: ¡Eh! Coge una manta. Venga, vamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054890
    m_Localized: 'Couple: (Observas cómo los dos se cubren y salen de la casa)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054891
    m_Localized: 'Couple: (Ves cómo caminan un rato, pero de repente se desploman)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054892
    m_Localized: 'Couple: (Empieza a salir humo de la manta... Te das la vuelta)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054937
    m_Localized: 'Luka: Todo irá bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054938
    m_Localized: ¿Todavía te sientes animado?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054939
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054940
    m_Localized: 'Luka: No exactamente animado... pero tampoco me estoy desmoronando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054941
    m_Localized: 'Luka: Seguimos siendo humanos. Aún resistiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054942
    m_Localized: 'Luka: No haremos la tormenta peor de lo que ya es.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054943
    m_Localized: 'Luka: Y cuando todo termine... creo que podremos perdonarnos por lo que hemos hecho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054944
    m_Localized: 'Luka: Mientras haya compasión, hay humanidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054945
    m_Localized: 'Luka: ¿Estás de acuerdo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054946
    m_Localized: 'Luka: Todo va a estar bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054947
    m_Localized: ¿Siempre has sido así?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054948
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054949
    m_Localized: 'Luka: Sabes... no. No siempre. Solía estar enfadado por todo. Con la gente, con el mundo, conmigo mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054950
    m_Localized: 'Luka: Podía estallar por nada, lanzar indirectas o azotar las puertas con tanta fuerza que se astillaban. Pero en algún momento, me di cuenta de que el enfado solo te destruye.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054951
    m_Localized: 'Luka: Primero a ti, por dentro. Después a todo lo demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054952
    m_Localized: 'Luka: Una vez... ataqué a alguien que solo quería ayudarme. Y ahora él... ella... ya no está.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054953
    m_Localized: 'Luka: Ese día, algo se rompió dentro de mí. Supe que debía cambiar o iba a destruir todo lo que tocara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054954
    m_Localized: 'Luka: Así que aprendí a soltar. A respirar. A reconciliarme. Así llegué hasta aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054955
    m_Localized: 'Luka: Todo irá bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054956
    m_Localized: ¿Qué fue lo que perdiste?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054957
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054959
    m_Localized: 'Luka: Nuestra casa se incendió justo cuando salí por un minuto a buscar algo de agua, pero cuando regresé, ya todo era humo y cenizas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054960
    m_Localized: 'Luka: Tardé mucho en aceptarlo. No dejaba de preguntarme: ¿por qué me fui justo en ese instante? ¿Por qué no pude salvarlos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054961
    m_Localized: 'Luka: Pero quizás ese no sea el punto. Quizás no se trate de aferrarse al pasado, sino de aprender a vivir con él.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054962
    m_Localized: 'Luka: Todavía están conmigo, de alguna manera. Su recuerdo me da fuerza. Por eso intento ayudar a la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054963
    m_Localized: 'Luka: Sé lo que es perder. Y sé qué significa hallar un propósito cuando todo se  desmorona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054964
    m_Localized: 'Luka: Todo va a estar bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054965
    m_Localized: ¿Así que aprendiste sobrellevar el haber perdido a tu familia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054966
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054967
    m_Localized: 'Luka: Sí, lo superé, pero no fue sencillo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054968
    m_Localized: 'Luka: Me culpé durante mucho tiempo. Pensaba que si hubiese regresado un par de minutos antes, quizás las cosas habrían sido diferentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054969
    m_Localized: 'Luka: Pero el duelo se alimenta de la culpa. Y la vida... la vida necesita perdón. Me di cuenta de que si no lo soltaba, me perdería a mí también.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054970
    m_Localized: 'Luka: El perdón. Eso fue lo que me salvó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054971
    m_Localized: 'Luka: Me perdoné por no poder cambiar el pasado. Incluso perdoné al destino, por cruel que fuera. Porque la ira solo me estaba arrastrando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054972
    m_Localized: 'Luka: Todo va a estar bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054973
    m_Localized: ¿Entonces qué te impulsa ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054974
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054975
    m_Localized: 'Luka: Creo que la gente puede ser mejor. Incluso en este caos en el que vivimos, siempre hay una oportunidad de resurgir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054976
    m_Localized: 'Luka: No creo en milagros ni en la providencia. Creo en la gente. En cómo nos levantamos unos a otros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054977
    m_Localized: 'Luka: Alguien rescata al que cae. Alguien sonríe en un mal día. Alguien comparte su último trozo de pan. De eso se trata la vida, de las pequeñas cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054978
    m_Localized: 'Luka: Cada vez que alguien hace el mundo un poco mejor, sé que nada de esto fue en vano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054979
    m_Localized: 'Luka: Todo va a estar bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054980
    m_Localized: ¿Desearías recuperarlo todo? ¿Tu hogar, tu familia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054981
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054982
    m_Localized: 'Luka: Si pudiera verlos de nuevo... hablarles, abrazarlos... Lo haría, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054983
    m_Localized: 'Luka: ¿Pero traerlo todo de vuelta? No estoy tan seguro. La pérdida es parte de la vida. Es terrible, duele, pero nos moldea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054984
    m_Localized: 'Luka: Claro, daría casi cualquier cosa por un día más con ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054985
    m_Localized: 'Luka: ¿Pero si significara renunciar a lo que he aprendido? A perdonar, a seguir adelante... No. No lo haría.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054986
    m_Localized: 'Luka: El tiempo es limitado. Es mejor aferrarse a lo que tenemos ahora que ser consumidos por lo que hemos perdido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249152
    m_Localized: 'Hunter: Mantente alerta. Cualquiera de nosotros podría ser un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249153
    m_Localized: Eres cazador, ¿verdad?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249154
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249155
    m_Localized: 'Hunter: Más bien un guarda, chaval.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249156
    m_Localized: 'Hunter: Vivía en el campo. Sin tele, solo radio. Así me enteré de lo que pasaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249157
    m_Localized: 'Hunter: Decidí no dejar que nadie cruzara mi umbral. Mi hogar es mi fortaleza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249158
    m_Localized: 'Hunter: ¿Y si uno de ellos resulta ser un Visitante, me engatusa y luego me corta la garganta mientras duermo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249159
    m_Localized: ¿Entonces por qué estás aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249160
    m_Localized: No es seguro estar solo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249161
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249162
    m_Localized: 'Hunter: Ni de broma dejo que ese cabrón alto y pálido me eche el guante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249163
    m_Localized: 'Hunter: Él es la razón por la que dejé mi cabaña.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249164
    m_Localized: 'Hunter: Se te nota en la mirada, tú también lo has visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249165
    m_Localized: ¿Cómo sobrevivió ahí fuera, solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249166
    m_Localized: ¿Tú también viste al visitante alto y pálido?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249167
    m_Localized: 'Hunter: ¿Crees que ya no lo había calculado, genio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249168
    m_Localized: 'Hunter: Si no, ya sería alimento para gusanos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249169
    m_Localized: 'Hunter: Antes creía que era tonto dejar entrar a extraños.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249170
    m_Localized: 'Hunter: Creí que estaba más seguro solo. Luego apareció ese monstruo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249171
    m_Localized: 'Hunter: Nunca había visto a una bestia así.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249172
    m_Localized: ¿Cómo sobreviviste ahí fuera, solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249173
    m_Localized: ¿Tú también viste al visitante alto y pálido?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249174
    m_Localized: 'Hunter: Oh, chaval... es una historia larga. Hoy no me apetece soltar la lengua.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249175
    m_Localized: 'Hunter: Si me traes una cerveza mañana, te cuento todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249176
    m_Localized: 'Hunter: Así que no soy el único.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249177
    m_Localized: 'Hunter: Sí... Ya veo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249178
    m_Localized: 'Hunter: Ay, chaval... Si supieras por lo que he pasado...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249179
    m_Localized: 'Hunter: Hablaré. Pero no esta noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249180
    m_Localized: 'Hunter: Tráeme una cerveza mañana, te lo contaré todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249181
    m_Localized: 'Hunter: Mantente alerta. Cualquiera de nosotros podría ser un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249182
    m_Localized: ¿Y bien, cuál es la historia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249183
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249184
    m_Localized: 'Hunter: ¿Has traído la cerveza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249185
    m_Localized: Sí (Darle la cerveza)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249186
    m_Localized: 'Hunter: ¿Qué? ¿No hay cerveza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249187
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249188
    m_Localized: No (No darle una cerveza)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249189
    m_Localized: 'Hunter: Con eso basta, chaval.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249190
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249191
    m_Localized: 'Hunter: Como te dije, estaba metido en la cabaña, a lo mío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249192
    m_Localized: 'Hunter: Entonces un día aparece este tío. Jadeando, desesperado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249193
    m_Localized: 'Hunter: Empezó aporreando la puerta, rogándome que le dejara entrar. Pero algo no encajaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249194
    m_Localized: 'Hunter: Estaba pálido, tembloroso, como si hubiera visto la muerte. Ni idea de cómo se adentró tanto en el bosque.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249195
    m_Localized: 'Hunter: No parecía ningún excursionista. Así que le dije que se largara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249196
    m_Localized: 'Hunter: Intentó romper la ventana, pero grité que tenía un rifle. Eso le hizo salir corriendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249197
    m_Localized: 'Hunter: Pensé que jamás le vería de nuevo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249198
    m_Localized: Quizá deberías haberle ayudado
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249199
    m_Localized: Deberías haberle dejado entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249200
    m_Localized: ¿A qué te refieres con "pensé"?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249201
    m_Localized: 'Hunter: ¿Y traer lo que sea que le persiguiera directo a mi puerta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249202
    m_Localized: 'Hunter: No, gracias. Ya tengo bastantes problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249203
    m_Localized: Vale
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249204
    m_Localized: No eres de hablar mucho
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249205
    m_Localized: En realidad no dijiste mucho
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249206
    m_Localized: Déjame adivinar. ¿Hablarás más si hay cerveza?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249207
    m_Localized: 'Hunter: No finjas que eres una especie de héroe, chaval. Seguro tú también has rechazado a unos cuantos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249208
    m_Localized: 'Hunter: De otro modo, no habrías llegado tan lejos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249209
    m_Localized: 'Hunter: Pero esa es una historia para mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249210
    m_Localized: Vale
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249211
    m_Localized: No eres de hablar mucho
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249212
    m_Localized: En realidad no dijiste mucho
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249213
    m_Localized: Déjame adivinar. ¿Hablarás más si hay cerveza?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249214
    m_Localized: 'Hunter: Creí que jamás lo vería de nuevo. Sin embargo, después... me encontró.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249215
    m_Localized: 'Hunter:  Pero eso lo dejaré para otra ocasión.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249216
    m_Localized: Vale
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249217
    m_Localized: No eres de hablar mucho
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249218
    m_Localized: En realidad no dijiste mucho
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249219
    m_Localized: Déjame adivinar. ¿Hablarás más si hay cerveza?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249220
    m_Localized: 'Hunter: Si me traes algo de cerveza mañana, terminaré la historia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249221
    m_Localized: 'Hunter: No soy muy hablador.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249222
    m_Localized: 'Hunter: Considera una suerte que esté hablando siquiera, chaval.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249223
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249224
    m_Localized: 'Hunter: Si me traes esa cerveza mañana, te cuento lo demás. ¿Trato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249225
    m_Localized: 'Hunter: Ten paciencia, chaval. He visto cosas de verdad jodidas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249226
    m_Localized: 'Hunter: No es el tipo de cosa que quiera recordar sobrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249227
    m_Localized: 'Hunter: Trae la cerveza y hablaré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249228
    m_Localized: 'Hunter: Eres astuto, te lo concedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249229
    m_Localized: 'Hunter: No hablo a menos que sea importante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249230
    m_Localized: 'Hunter: Así que, mañana tráeme esa cerveza y te diré cómo acaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249231
    m_Localized: 'Hunter: Lo siento, pero no hablo sobrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249232
    m_Localized: 'Hunter: Trae la cerveza y luego hablamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249233
    m_Localized: 'Hunter: Mantente alerta. Cualquiera de nosotros podría ser un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249234
    m_Localized: Entonces, ¿cómo terminó todo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249235
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249236
    m_Localized: 'Hunter: Te lo cuento, pero primero, la cerveza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249237
    m_Localized: Claro (Darle la cerveza)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249238
    m_Localized: 'Hunter: ¿Qué? ¿No hay cerveza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249239
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249240
    m_Localized: No (No darle una cerveza)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249241
    m_Localized: 'Hunter: Ahora sí nos entendemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249242
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249243
    m_Localized: 'Hunter: Así que el tío salió corriendo, y yo me quedé en la cabaña.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249244
    m_Localized: 'Hunter: Pero luego me quedé sin leña. Tuve que ir a por más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249245
    m_Localized: 'Hunter: Recogí un montón, regresé... y el rifle ya no estaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249246
    m_Localized: 'Hunter: Eso me inquietó. Rebusqué por todo el maldito sitio, pero simplemente se había ido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249247
    m_Localized: 'Hunter: Entonces... lo vi por la ventana. El mismo tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249248
    m_Localized: 'Hunter: Tenía mi rifle... pero había cambiado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249249
    m_Localized: 'Hunter: Era más alto, tenía la piel flácida. No llevaba nada más que unos pantalones.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249250
    m_Localized: 'Hunter: Cogió el arma con ambas manos... y la partió en dos como una rama.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249251
    m_Localized: 'Hunter: Luego, solo se quedó allí. Mirándome. Como si esperase a que yo parpadeara... para poder romperme el cuello.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249252
    m_Localized: 'Hunter: Pero no lo hizo. Solo siguió observando. Como si fuera una extraña competición de miradas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249253
    m_Localized: 'Hunter: Y luego... con la llegada del alba, el tío espeluznante solo desapareció.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249254
    m_Localized: 'Hunter: Fue ahí cuando lo entendí: ¿estar ahí fuera solo, sin un arma? Eso sería un suicidio, chaval.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249255
    m_Localized: 'Hunter: Así que salí corriendo; me fui antes de que el sol terminara de alzarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249256
    m_Localized: 'Hunter: Así fue como terminé aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249257
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249258
    m_Localized: 'Hunter: Solo espero que tengas la oportunidad de dispararle a alguien, chaval.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249259
    m_Localized: 'Hunter: Quién sabe, tal vez las balas funcionen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249260
    m_Localized: ¿Por qué no te mató?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249261
    m_Localized: ¿Crees que es posible matarlo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249262
    m_Localized: Eliminó a un escuadrón entero
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249263
    m_Localized: 'Hunter: No lo sé, chaval. Rompió un rifle sólido como si nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249264
    m_Localized: 'Hunter: Pudo haberme hecho lo mismo en un instante... pero no lo hizo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249265
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249266
    m_Localized: 'Hunter: Quizás solo disfruta jugando con nosotros. Como un gato con un ratón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249267
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249268
    m_Localized: 'Hunter: Mira, casi nada me da miedo. ¿Pero ese maldito bastardo pálido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249269
    m_Localized: 'Hunter: Ese tío sí que me aterra, chaval.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249270
    m_Localized: 'Hunter: Quisiera pensar que sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249271
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249272
    m_Localized: 'Hunter: Ya sabes lo que dicen... "lo que sangra, se puede matar".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249273
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249274
    m_Localized: 'Hunter: Si un escuadrón entero no pudo derrotarlo... no tenemos ninguna posibilidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249275
    m_Localized: 'Hunter: Si quiere, destrozará este lugar como si fuera papel de seda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249276
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249277
    m_Localized: 'Hunter: Mira, casi nada me da miedo. Pero, ¿aquel bastardo alto y pálido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249278
    m_Localized: 'Hunter: Me aterra, chaval.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249279
    m_Localized: 'Hunter: Sin cerveza, no hay historia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249280
    m_Localized: 'Hunter: No diré nada estando sobrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249281
    m_Localized: 'Hunter: Así que si quieres el resto... tráeme una cerveza, chaval.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443456
    m_Localized: 'Cold: Si solo hiciera un poco más de c-calor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443457
    m_Localized: ¿Te dejas la chaqueta puesta?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443458
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443459
    m_Localized: 'Cold: S-sí. Hay algo que me inquieta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443460
    m_Localized: 'Cold: ¿Qué pasa si me la q-q-quito? No logro calentarme, ni con el calor de a-ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443461
    m_Localized: 'Cold: Si me quito la chaqueta, ¿me moriré de f-frío?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443462
    m_Localized: 'Cold: O peor. Seguiré vivo, pero sentiré aún más f-f-frío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443464
    m_Localized: ¿Entonces no te duchas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443465
    m_Localized: 'Cold: N-no...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443466
    m_Localized: 'Cold: El cuerpo suda al intentar e-enfriarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443467
    m_Localized: 'Cold: P-pero creo que no puedo tener más frío...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443468
    m_Localized: 'Cold: P-perdón, pero no voy a r-responder eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443469
    m_Localized: 'Cold: Si solo hiciera un poco más de c-calor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443470
    m_Localized: ¿Tienes idea de cómo normalizar tu temperatura?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443471
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443472
    m_Localized: 'Cold: No creo poder cambiar e-esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443473
    m_Localized: 'Cold: El agua hirviendo q-quema. No ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443474
    m_Localized: 'Cold: ¿Sabes...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443475
    m_Localized: 'Cold: Se me ocurrió una m-m-metáfora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443476
    m_Localized: 'Cold: Imagina el espacio profundo. V-vasto y helado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443477
    m_Localized: 'Cold: Nacen galaxias. Las estrellas c-colapsan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443478
    m_Localized: 'Cold: Y yo solo observo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443479
    m_Localized: 'Cold: Nunca sentiré el calor d-d-del s-sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443480
    m_Localized: 'Cold: O el c-calor de un abrazo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443481
    m_Localized: 'Cold: No creo que ni el espa-pacio ni la sociedad me necesiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443482
    m_Localized: 'Cold: Si solo hiciera un poco más de c-calor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443484
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443485
    m_Localized: 'Cold: Mmm. No estoy seguro de q-querer hablar de eso ahorita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443486
    m_Localized: 'Cold: He tenido algo en mente... por m-mucho tiempo. Quizás sea por eso que me siento tan... frío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443487
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443488
    m_Localized: 'Cold: No quiero ni mencionarlo, pero el anhelo me está c-consumiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443489
    m_Localized: 'Cold: Yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443490
    m_Localized: 'Cold: T-te lo diré mañana. Creo que estaré listo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443491
    m_Localized: 'Cold: Si solo hiciera un poco más de c-calor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443492
    m_Localized: Entonces, ¿qué estás ocultando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443493
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443494
    m_Localized: 'Cold: Sí. Quería c-compartirte un secreto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443495
    m_Localized: 'Cold: Creo que estoy listo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443496
    m_Localized: 'Cold: Normalmente esto s-suele acabar mal. Pero quizá esta vez no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443497
    m_Localized: 'Cold: Bajo esta r-ropa está... creo que e-está la razón del f-frío y la soledad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443498
    m_Localized: 'Cold: Mira'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443499
    m_Localized: 'Cold: No... Otra vez n-no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443500
    m_Localized: ¿Pero qué has hecho?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443501
    m_Localized: Estás bien jodido
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443502
    m_Localized: 'Cold: No, n-n fue mi i-intención.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443503
    m_Localized: 'Cold: Creí que sería d-d-diferente aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443504
    m_Localized: 'Cold: Nunca lo e-es.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443505
    m_Localized: 'Cold: Yo no quería esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443506
    m_Localized: 'Cold: Te lo j-juro, no quería.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443507
    m_Localized: Disparar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443508
    m_Localized: Echar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443509
    m_Localized: 'Cold: Esto ya ha o-ocurrido antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443510
    m_Localized: 'Cold: ¿Por qué pensé que esta vez sería d-diferente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443511
    m_Localized: 'Cold: No te p-precipites.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443512
    m_Localized: 'Cold: No hice esto por m-malicia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443513
    m_Localized: 'Cold: No era lo q-que quería.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443514
    m_Localized: Disparar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443515
    m_Localized: Echar
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443516
    m_Localized: 'Cold: Quizá eso sea lo m-mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443517
    m_Localized: 'Cold: No más f-f-frío. No más soledad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443518
    m_Localized: 'Cold: Yo solo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443519
    m_Localized: 'Cold: No creas que p-planeé esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443520
    m_Localized: 'Cold: ¿Ahora mismo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443521
    m_Localized: 'Cold: Una b-bala sería más amable. Por desgracia, aún p-puedo sentir dolor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443522
    m_Localized: 'Cold: El Sol t-tardará más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443523
    m_Localized: 'Cold: ¿Puedo al menos quedarme hasta el a-anochecer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443524
    m_Localized: ¡Largo!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443525
    m_Localized: Vale, solo no intentes nada
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443526
    m_Localized: 'Cold: Entendido'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443527
    m_Localized: 'Cold: Lo s-siento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443528
    m_Localized: 'Cold: Quizá el Sol m-me caliente. Una última vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443529
    m_Localized: 'Cold: G-Gracias'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443530
    m_Localized: 'Cold: Sé que me odias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443531
    m_Localized: 'Cold: Pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443532
    m_Localized: 'Cold: Lo s-siento. Yo no quería esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832064
    m_Localized: 'Daughter: Y... um... ¿quizás podrías invitar a mi amiga a venir? Por fa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832065
    m_Localized: 'Daughter: Cuando los adultos la invitan, la dejan venir... pero si soy yo, siempre me riñen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832066
    m_Localized: 'Daughter: Creo que este es su número de teléfono: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832067
    m_Localized: 'Greatmother: Ay, cielo... Por favor, no dejes que entre nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832068
    m_Localized: ¿Por qué la AFAE la desahució en lugar de llevársela?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832069
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832070
    m_Localized: 'Greatmother: ¡Vete tú a saber, cielo! A esos tíos de traje... quién los entiende.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832071
    m_Localized: 'Greatmother: Siempre de aquí para allá, ladrando órdenes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832072
    m_Localized: 'Greatmother: ¿Quiénes se creen que son, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832073
    m_Localized: 'Greatmother: Apuesto a que no saben ni un pimiento, solo se dan aires.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832074
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832075
    m_Localized: 'Greatmother: Anda, ¿también han llamando tocando a tu puerta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832076
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832077
    m_Localized: Uno de ellos sigue merodeando cerca
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832078
    m_Localized: 'Greatmother: ¡Malditos cabrones! Habría que arrancarles esos trajes y meterlos de patitas en los corrales de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832079
    m_Localized: 'Greatmother: Que vean lo que es estar entre la gente de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832080
    m_Localized: 'Greatmother: ¿Que ahora también están acechando las casas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832081
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832082
    m_Localized: 'Greatmother: Salvajes, lo juro por Dios.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832083
    m_Localized: 'Greatmother: Una vez, está bien. Pero regresar una y otra vez...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832084
    m_Localized: 'Greatmother: No tienen ninguna vergüenza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832085
    m_Localized: 'Greatmother: Ay, cielo... Por favor, no dejes que entre nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832086
    m_Localized: ¿Se llevaron a alguien de su familia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832087
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832088
    m_Localized: 'Greatmother: Ohh. Nadie me ha preguntado por mi familia en mucho tiempo, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832089
    m_Localized: 'Greatmother: Me dicen "la gran madre" porque parí a un montón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832090
    m_Localized: 'Greatmother: Benditos sean...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832091
    m_Localized: 'Greatmother: Apenas cabemos en la casa ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832092
    m_Localized: 'Greatmother: Tras las puertas de esa casa, están todos escondiéndose de esa gente rara del demonio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832093
    m_Localized: No me has contestado
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832094
    m_Localized: Entonces, ¿se llevaron a su familia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832095
    m_Localized: 'Greatmother: Oh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832096
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832097
    m_Localized: 'Greatmother: Me dejé llevar, cielo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832098
    m_Localized: 'Greatmother: Sí. Los cabrones de los trajes se llevaron a todos los míos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832099
    m_Localized: 'Greatmother: Pero no se saldrán con la suya, no señor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832100
    m_Localized: 'Greatmother: ¿A ti te han quitado a alguien?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832101
    m_Localized: No tengo familia
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832102
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832103
    m_Localized: 'Greatmother: Oh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832104
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832105
    m_Localized: 'Greatmother: Me dejé llevar, cielo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832106
    m_Localized: 'Greatmother: Sí. Los cabrones de los trajes se llevaron a todos los míos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832107
    m_Localized: 'Greatmother: ¿Te han quitado a alguien?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832108
    m_Localized: No tengo familia
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832109
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832110
    m_Localized: 'Greatmother: ¿Ah, no? ¿Y por qué tu casa es tan grande?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832111
    m_Localized: 'Greatmother: Viviendo aquí tú solito. Eso no está bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832112
    m_Localized: 'Greatmother: Casa grande significa familia grande, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832113
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832114
    m_Localized: 'Greatmother: Vale, no voy a insistir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832115
    m_Localized: 'Greatmother: Solo desearía sacar a los míos de esas zonas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832116
    m_Localized: 'Greatmother: A ti no te tocaron, ¿cierto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832117
    m_Localized: 'Greatmother: ¿Entonces dónde está tu gente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832118
    m_Localized: 'Greatmother: Un lugar tan grande como este no fue construido para una sola persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832119
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832120
    m_Localized: 'Greatmother: Vale, no me meteré en tus asuntos..'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832121
    m_Localized: 'Greatmother: Solo quiero a los míos fuera de esa maldita zona...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832122
    m_Localized: 'Greatmother: Ay, cielo... Por favor, no dejes que entre nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832123
    m_Localized: ¿Cómo planeas recuperar a tu familia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832124
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832125
    m_Localized: 'Greatmother: Yo no los ayudo, cielo. Saldrán por su cuenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832126
    m_Localized: ¿A qué te refieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832127
    m_Localized: ¿Por su cuenta?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832128
    m_Localized: 'Greatmother: Se arrastrarán de vuelta por la tierra. Saldrán del suelo, pero por el otro lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832129
    m_Localized: 'Greatmother: Esas puñeteras vallas y cables no detendrán a mis bebés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832130
    m_Localized: 'Greatmother: Y si no pueden salir de abajo, harán pedazos esa zona. No dejarán a nadie, benditos sean.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832131
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832132
    m_Localized: 'Greatmother: Ya vienen. Los puedo escuchar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832133
    m_Localized: ¿De qué coño hablas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832134
    m_Localized: ¿Has perdido la cabeza?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832135
    m_Localized: ¿A qué te refieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832136
    m_Localized: (Mátala)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832137
    m_Localized: 'Greatmother: Los muros cederán, cuando llegue el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832138
    m_Localized: 'Greatmother: Habrá muerte, tanta muerte... y él vendrá, hambriento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832139
    m_Localized: 'Greatmother: Y entonces, a esos de los trajes ya no les importarán los míos. Tendrán problemas más grandes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832140
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832141
    m_Localized: 'Greatmother: Ya vienen. Los puedo escuchar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832142
    m_Localized: ¿De qué coño hablas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832143
    m_Localized: ¿Has perdido la cabeza?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832144
    m_Localized: ¿A qué te refieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832145
    m_Localized: (Mátala)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832146
    m_Localized: 'Greatmother: Aplastaremos esas madrigueras que habéis construido...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832147
    m_Localized: 'Greatmother: Romperemos las paredes... y las calles se teñirán de sangre... haremos montañas con todos sus cadáveres...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832148
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832149
    m_Localized: 'Greatmother: Los oigo arrastrarse. Ya casi están aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832150
    m_Localized: ¿Qué significa eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832151
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832152
    m_Localized: ¿Eres una Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832153
    m_Localized: (Mátala)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832154
    m_Localized: 'Greatmother: La carne quemada huele tan bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832155
    m_Localized: 'Greatmother: Los trajes se cocinan bien. Puede que un pelín demasiado crujiente. Pero no está mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832156
    m_Localized: 'Greatmother: Tienes cuerpos, cariño. cielo. Un montón. Suficientes para un buen banquete. Los míos comerán bien aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832157
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832158
    m_Localized: 'Greatmother: Los oigo arrastrarse. Ya casi están aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832159
    m_Localized: ¿Qué significa eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832160
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832161
    m_Localized: ¿Eres una Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832162
    m_Localized: (Mátala)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832163
    m_Localized: 'Greatmother: Esta casa es un buen lugar. Es especial.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832164
    m_Localized: 'Greatmother: Una casa grande, casi sin gente. Hay lugar para todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832165
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832166
    m_Localized: 'Greatmother: Los oigo arrastrarse. Ya casi están aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832167
    m_Localized: ¿Qué significa eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832168
    m_Localized: ¿Quién eres tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832169
    m_Localized: ¿Eres una Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832170
    m_Localized: (Mátala)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832171
    m_Localized: 'Greatmother: Pedazo de mierda...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832172
    m_Localized: 'Greatmother: Vendrán a por ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832173
    m_Localized: 'Greatmother: Hijos, mami ha encontrado un nuevo nido. '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832174
    m_Localized: 'Greatmother: Arrástrense, él ya no necesita esta casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832175
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832176
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832177
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832178
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832179
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832180
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832181
    m_Localized: 'Greatmother: Mamá quiere ver a sus bebés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832182
    m_Localized: 'Greatmother: Venga, esta casa nos viene bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832183
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832184
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832185
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832186
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832187
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832188
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832189
    m_Localized: 'Greatmother: Vengan, hijos míos. Mami está aquí. Encontré un nuevo hogar para vosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832190
    m_Localized: 'Greatmother: Es muy espacioso, y tiene espacio de sobra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832191
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832192
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832193
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832194
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832195
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832196
    m_Localized: (MÁTALA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832197
    m_Localized: 'Greatmother: ¡Maldición! Entréganos esta casa. Igual la detestas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832198
    m_Localized: 'Greatmother: Quieren que arda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026368
    m_Localized: 'Greatmother: ¡DÁMELA, CIELO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026369
    m_Localized: 'Greatmother: Bendito seas... Sé lo que quieres...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026370
    m_Localized: 'Greatmother: La muerte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026371
    m_Localized: 'Wolfhound: ¿Tienes algo que decir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220672
    m_Localized: ¿Por qué ves a las personas como animales?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220673
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220674
    m_Localized: 'Wolfhound: Déjame preguntarte algo. ¿Qué somos, en realidad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220675
    m_Localized: 'Wolfhound: Matamos, comemos lo que matamos y no nos quita el sueño. Así es la naturaleza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220676
    m_Localized: 'Wolfhound: Pero la sociedad nos puso una correa. Por fortuna, esos días ya terminaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220677
    m_Localized: ¿A qué te refieres?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220678
    m_Localized: ¿Estás satisfecho con este resultado?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220679
    m_Localized: 'Wolfhound: Es simple. Las absurdas normas de la sociedad desaparecieron. Ahora, todo está claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220680
    m_Localized: 'Wolfhound: Hay una manada. Y hay un líder. Cualquiera que amenace la supervivencia de la manada muere. Ese es un código que respeto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220681
    m_Localized: 'Wolfhound: ¿Pero lo peor de lo peor? Son los corderos con piel de lobo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220682
    m_Localized: ¿Crees que una manada es mejor que la sociedad?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220683
    m_Localized: ¿Te refieres a lobos con piel de oveja?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220684
    m_Localized: 'Wolfhound: Solo me alegro de que la gente haya dejado de esconderse tras máscaras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220685
    m_Localized: 'Wolfhound: Pero esas ovejas lo estropean todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220686
    m_Localized: 'Wolfhound: Se ponen pieles de lobo y fingen. Fingen los instintos de un hombre de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220687
    m_Localized: 'Wolfhound: Cobardes, cavando agujeros en la tierra. Preferiría una pelea directa cualquier día a este juego del gato y el ratón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220688
    m_Localized: 'Wolfhound: Pero si formaste una manada, entonces habrás aprendido a reconocer a los impostores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220689
    m_Localized: ¿Crees que una manada es mejor que la sociedad?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220690
    m_Localized: ¿Ovejas con piel de lobo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220691
    m_Localized: 'Wolfhound: ¿Estás dudando eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220692
    m_Localized: 'Wolfhound: En la sociedad de antes, jamás habrías detectado a una de esas ovejas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220693
    m_Localized: 'Wolfhound: Demasiada cháchara, demasiadas reglas. Te enzarzarías en debates en vez de hacer lo necesario.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220694
    m_Localized: 'Wolfhound: Por eso un líder es vital. Sin preguntas, sin votos. Su palabra es ley.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220695
    m_Localized: 'Wolfhound: Un líder debe demostrar fuerza. Esa es la única forma en que una manada sobrevive.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220696
    m_Localized: 'Wolfhound: En realidad, hablo sobre esas escorias cobardes a las que llamáis Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220697
    m_Localized: 'Wolfhound: Se ocultan bajo tierra como ratas, esperando que nos debilitemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220698
    m_Localized: 'Wolfhound: Ahora usan la moral humana. Juegan con nuestra piedad para que sea más difícil matarlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220699
    m_Localized: 'Wolfhound: Por eso tenemos que enseñar los colmillos, recordarles que somos bestias, o nos desplazarán.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220700
    m_Localized: 'Wolfhound: ¿Tienes algo que decir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220701
    m_Localized: ¿Por qué estás mirando mi escopeta?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220702
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220703
    m_Localized: 'Wolfhound: Veo un líder en ti. Mantienes a todos a raya, has demostrado que estás a cargo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220704
    m_Localized: 'Wolfhound: Bonito lugar el que tienes. La gente pasa a menudo. Es una casa grande, pero tus inquilinos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220705
    m_Localized: ¿Qué hay con ellos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220706
    m_Localized: ¿Crees que algunos de ellos son Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220707
    m_Localized: 'Wolfhound: Has juntado a debiluchos. Tipos blandos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220708
    m_Localized: 'Wolfhound: Dime, ¿de qué sirven los viejos, los niños, o los enfermos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220709
    m_Localized: 'Wolfhound: Una manada debe estar hecha de los fuertes. Así es como se sobrevive.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220710
    m_Localized: Entonces, ¿qué quieres que haga?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220711
    m_Localized: ¿Quieres que los eche?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220712
    m_Localized: 'Wolfhound: El problema no son las ovejas disfrazadas de lobo. Son los lobos débiles lo que me preocupa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220713
    m_Localized: 'Wolfhound: Tu manada no tiene agallas. La gente viene y se va a placer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220714
    m_Localized: 'Wolfhound: Elige a los más fuertes. Quédate con ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220715
    m_Localized: Entonces, ¿qué quieres que haga?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220716
    m_Localized: ¿Quieres que los eche?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220717
    m_Localized: 'Wolfhound: Tienes que librarte de los débiles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220718
    m_Localized: 'Wolfhound: Mátalos. En público. Que sea un mensaje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220719
    m_Localized: 'Wolfhound: Así es como mantienes el control. Así demuestras quién está a cargo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220720
    m_Localized: 'Wolfhound: Y aquellos que no se inmuten cuando mueran los débiles... esos son tus verdaderos lobos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220721
    m_Localized: 'Wolfhound: Esos se quedan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220722
    m_Localized: No soy un asesino
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220723
    m_Localized: Solo mato Visitantes
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220724
    m_Localized: 'Wolfhound: Déjalos en paz y tu autoridad se desmoronará. Te llamarán blando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220725
    m_Localized: 'Wolfhound: La piedad es solo debilidad disfrazada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220726
    m_Localized: 'Wolfhound: Tienes que ser despiadado. ¿Visitante? Dispara. ¿Débil, enfermo, viejo? Lo mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220727
    m_Localized: 'Wolfhound: Así es como les infundes miedo. Así es como lideras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220728
    m_Localized: No soy un asesino
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220729
    m_Localized: Solo mato Visitantes
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220730
    m_Localized: 'Wolfhound: ¿A quién intentas engañar, tesoro? Lo veo en tus ojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220731
    m_Localized: 'Wolfhound: Has matado. A sangre fría. Así que no pretendas tener las manos limpias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220732
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220733
    m_Localized: 'Wolfhound: Yo solía dominar las calles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220734
    m_Localized: 'Wolfhound: La gente me temía. Me respetaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220735
    m_Localized: 'Wolfhound: ¿Alguna vez te has preguntado cuánto se tarda en mancillar el alma?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220736
    m_Localized: 'Wolfhound: Me tomé mi tiempo. Dejé que la podredumbre se extendiera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220737
    m_Localized: 'Wolfhound: Un día, un taxista se negó a llevarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220738
    m_Localized: 'Wolfhound: Si hubiera dejado pasar eso, mi nombre no habría valido nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220739
    m_Localized: 'Wolfhound: Así que le rompí todos los huesos del cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220740
    m_Localized: 'Wolfhound: Pero su hijo aprendió la lección. Y la gente siguió respetándome.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220741
    m_Localized: 'Wolfhound: Déjame decirte algo: Te iría mejor si dejaras de consentir a los débiles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220742
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220743
    m_Localized: 'Wolfhound: Yo solía dominar las calles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220744
    m_Localized: 'Wolfhound: La gente me temía. Me respetaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220745
    m_Localized: 'Wolfhound: ¿Alguna vez te has preguntado cuánto se tarda en mancillar el alma?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220746
    m_Localized: 'Wolfhound: Me tomé mi tiempo. Dejé que la podredumbre se extendiera. '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220747
    m_Localized: 'Wolfhound: Un día, un taxista se negó a llevarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220748
    m_Localized: 'Wolfhound: Si hubiera dejado pasar eso, mi nombre no habría valido nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220749
    m_Localized: 'Wolfhound: Así que le rompí todos los huesos del cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220750
    m_Localized: 'Wolfhound: Pero su hijo aprendió la lección. Y la gente siguió respetándome.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220751
    m_Localized: 'Wolfhound: ¿Tienes algo que decir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220752
    m_Localized: No paras de hablar de manadas, ¿así que dónde está la tuya?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220753
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220754
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220755
    m_Localized: 'Wolfhound: ¿Por qué formaste la tuya?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220756
    m_Localized: Para que ese Visitante pálido y alto no me mate
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220757
    m_Localized: Intento ayudar a la gente
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220758
    m_Localized: Solo me gusta tener compañía
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220759
    m_Localized: Porque necesitan un líder
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220760
    m_Localized: Yo pregunté primero
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220761
    m_Localized: 'Wolfhound: ¿Así que los reuniste para salvar tu pellejo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220762
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220763
    m_Localized: 'Wolfhound: No suenas como un macho alfa. Suenas como un perrito asustado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220764
    m_Localized: 'Wolfhound: Esta manada necesita a alguien fuerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220765
    m_Localized: 'Wolfhound: Supongo que tendré que ocupar tu lugar. No eres apto para liderar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220766
    m_Localized: 'Wolfhound: Un objetivo noble. Aunque un poco tonto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220767
    m_Localized: 'Wolfhound: No los salvarás a todos. Más tarde o más temprano, tendrás que dejar a alguien fuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220768
    m_Localized: 'Wolfhound: Pero suenas como un macho alfa. Un verdadero hombre. No voy a desafiar eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220769
    m_Localized: 'Wolfhound: ¿Eso es todo? ¿Solo te da miedo estar solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220770
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220771
    m_Localized: 'Wolfhound: Esas no son palabras de un macho alfa. Esas son palabras de cobarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220772
    m_Localized: 'Wolfhound: Eso sí es algo que diría un hombre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220773
    m_Localized: 'Wolfhound: Entonces no cuestionaré tu liderazgo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220774
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220775
    m_Localized: 'Wolfhound: No responderé a eso. Mientras menos sepas, mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220776
    m_Localized: 'Wolfhound: Ya he dicho más de lo que debía. Ahora te toca a ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220777
    m_Localized: 'Wolfhound: Si no eres apto para liderar, yo mismo ocuparé tu lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220778
    m_Localized: ¡Que te jodan!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220779
    m_Localized: ¿Qué te hace mejor que yo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220780
    m_Localized: (Desenfundar tu arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220781
    m_Localized: ¡Lárgate antes de que te reviente a tiros!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220782
    m_Localized: 'Wolfhound: CIERRA EL PICO, CACHORRO. Ya eres un cadáver para mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220783
    m_Localized: 'Wolfhound: Si no sabes por qué lideras, ¿por qué cogiste el trabajo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220784
    m_Localized: 'Wolfhound: Deberías marcharte. O te mataré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220785
    m_Localized: 'Wolfhound: Sé lo que es una manada. Vivo según el código.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220786
    m_Localized: 'Wolfhound: Si eres tan blando, no eres un alfa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220787
    m_Localized: 'Wolfhound: Deberías marcharte. O te mataré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220788
    m_Localized: 'Wolfhound: Con que así estamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220789
    m_Localized: 'Wolfhound: Sabes que también tengo un arma, ¿verdad, imbécil?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220790
    m_Localized: 'Wolfhound: Mejor baja la tuya. Terminemos esto de forma limpia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220791
    m_Localized: (Dispararle)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220792
    m_Localized: (Bajar tu arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220793
    m_Localized: 'Wolfhound: Muere, maldito hijo de—'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220794
    m_Localized: 'Wolfhound: Bastardo... de verdad me has disparado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220795
    m_Localized: Mmm... Buen chico...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220796
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220797
    m_Localized: Pero deberías haber terminado el trabajo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220798
    m_Localized: (Él aprovecha la oportunidad y saca su escopeta)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220799
    m_Localized: (Te está apuntando)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220800
    m_Localized: (Por suerte, logras agarrar la escopeta y disparar)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220893
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220894
    m_Localized: ¿Así que te has cortado los hilos de la boca?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220895
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220896
    m_Localized: 'Foreigner: ¡Isto es uma persiadillia!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220897
    m_Localized: 'Foreigner: ¡MI HAN COSTURADON LA BUKA! Y tudo porco non mi entiemdíam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220898
    m_Localized: No te entiendo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220899
    m_Localized: ¿Estás pillando lo que estoy diciendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220900
    m_Localized: 'Foreigner: Non ti entemdio. ¿Qui possiemos fasser?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220901
    m_Localized: 'Foreigner: ¿Disventamos uma spicie di lengua en commum?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220902
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220903
    m_Localized: ¿Cómo se supone que vamos a comunicarnos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220904
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220905
    m_Localized: 'Foreigner: Puesso repeter lo qui disse y vos reatzhiognas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220906
    m_Localized: 'Foreigner: Alomeyór assim alminoz saiber lo qui ió stou dissendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220907
    m_Localized: 'Foreigner: ¿Cómo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220908
    m_Localized: ¿Cómo qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220909
    m_Localized: ¿Intentas preguntar algo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220910
    m_Localized: 'Foreigner: Ziggo sem entemdier. Paros fas perguntodo aigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220911
    m_Localized: 'Foreigner: Alomeyór bije uma palavra qui soana a pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220912
    m_Localized: 'Foreigner: Ziggo sem entemdier. Paros fas perguntodo aigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220913
    m_Localized: 'Foreigner: Alomeyór bije uma palavra qui soana a pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220914
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220915
    m_Localized: Oye, ¿qué tal estás?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220916
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414976
    m_Localized: 'Foreigner: (Le das una palmada en el hombro y señalas las heridas cerca de su boca)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414977
    m_Localized: ¿Te encuentras bien?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414978
    m_Localized: ¿Te duele?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414979
    m_Localized: 'Foreigner: ¿Mi lo puesses repeter for pavor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414980
    m_Localized: 'Foreigner: Ghhh-oot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414981
    m_Localized: 'Foreigner: Ghhh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414982
    m_Localized: 'Foreigner: Ghoodt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414983
    m_Localized: 'Foreigner: Ses difficil, paros puesse qui aiude in aigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414984
    m_Localized: 'Foreigner: Mi pergunto si stiará ocusendo lo mesmo em meu paeís.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414985
    m_Localized: 'Foreigner: Baia persiadillia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414986
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414987
    m_Localized: ¿Cómo vas a volver a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414988
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414989
    m_Localized: 'Foreigner: (Juntas las palmas de tus manos sobre la cabeza, imitando la forma de un techo)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414990
    m_Localized: 'Foreigner: ¿Ma khasa? ¿Stais pergumtamdo par meu paeís?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414991
    m_Localized: 'Foreigner: Veni a visiter a um amigui quanto passó tudo isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414992
    m_Localized: 'Foreigner: Ista situazone stá jodía, non ai outra palavra pa'' descriverla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414993
    m_Localized: ¿Cómo se supone que te envíe a casa? ¿En avión?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414994
    m_Localized: ¿Has mirado los billetes de barco?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414995
    m_Localized: 'Foreigner: (Bajas la mano en un movimiento amplio y de barrido)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414996
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414997
    m_Localized: 'Foreigner: ¿Um aviao? ¿Credes qui taindabía volinan?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414998
    m_Localized: 'Foreigner: Eberiba bere si puesso aberigar in alcún sitia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414999
    m_Localized: 'Foreigner: Alomeyór aúm ai uma horma di saíd.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415000
    m_Localized: 'Foreigner: (Mueves la mano imitando un barco sobre las olas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415001
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415002
    m_Localized: 'Foreigner: Cuomo... ¿viayar in barca?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415003
    m_Localized: 'Foreigner: ¿Taindabía funzionam? ¡Tembré qui mirvarlo, gras!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415004
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415005
    m_Localized: ¿Por qué te ves tan alegre?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415006
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415007
    m_Localized: 'Foreigner: (Sonríes, señalas tu sonrisa y luego la suya)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415008
    m_Localized: 'Foreigner: Ah, ti refiríndas a isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415009
    m_Localized: 'Foreigner: ¡Conseguieram dissierme qui los trenis ziggem funzionamdo! ¿Ti lo puesses creder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415010
    m_Localized: 'Foreigner: (Mueve una mano a lo largo de su otro brazo)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415011
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415012
    m_Localized: ¿Alguien te puede llevar a casa conduciendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415013
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415014
    m_Localized: 'Foreigner: Non ti entemdio, amigui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415015
    m_Localized: 'Foreigner: ¡Nañama bolbo a khassa! O alminoz ala stazioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415016
    m_Localized: 'Foreigner: Mi vou sta nochi. '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415017
    m_Localized: 'Foreigner: ¡Addiú!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415018
    m_Localized: ¿Te refieres al tren?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415019
    m_Localized: ¿Te vas a ir a algún sitio?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415020
    m_Localized: 'Foreigner: No e entemdido cuesso, lo sento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415021
    m_Localized: 'Foreigner: Paros nañama idé a la stazióm, ¡da lo aberigaré par ma cuonta!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415022
    m_Localized: 'Foreigner: Alomeyór bolba a khassa dispos di tudo ste tempo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415023
    m_Localized: 'Foreigner: ¡BUNNA SOURTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415024
    m_Localized: 'Edgar: Qué silencio tan sereno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415025
    m_Localized: ¿Cómo está tu mano?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415026
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415027
    m_Localized: 'Edgar: Aunque late, no la siento. Solo el dolor y el frío persisten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415028
    m_Localized: 'Edgar: Pero es lo que cabe esperar. Deseo retrasar el momento más exquisito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415029
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415030
    m_Localized: 'Edgar: Hubo una chica a la que adoré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415031
    m_Localized: 'Edgar: Atesoré el tiempo que pasamos juntos. Nos sentábamos en silencio y aun así la comprendía sin palabras. Fue entonces cuando me di cuenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415032
    m_Localized: 'Edgar: Me engaño a mí mismo. Nunca la conocí de verdad. Quizá solo quise creerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415033
    m_Localized: 'Edgar: Aun así, espero que algún día pueda comprenderla. De verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415034
    m_Localized: 'Edgar: Qué silencio tan sereno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415035
    m_Localized: Háblame de esa chica
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415036
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415037
    m_Localized: 'Edgar: En sus ojos, siempre vi el frío resplandor de la luna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415038
    m_Localized: 'Edgar: Ella era la antítesis del Cataclismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415039
    m_Localized: 'Edgar: A su lado, me perseguía una inquebrantable sensación de misterio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415040
    m_Localized: 'Edgar: Y anhelo desentrañar sus secretos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415041
    m_Localized: 'Edgar: Ahora, ella es mi monumento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415042
    m_Localized: 'Edgar: El faro que me guiará cuando parta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415043
    m_Localized: 'Edgar: Qué silencio tan sereno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415044
    m_Localized: ¿Cómo la conociste?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415045
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415046
    m_Localized: 'Edgar: Llegó un momento en el que supe lo que me esperaba. La sepsis pronto acabaría conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415047
    m_Localized: 'Edgar: La idea me aterrorizó. Me di cuenta de que desaparecería. No en un futuro, sino en tan solo unos meses.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415048
    m_Localized: 'Edgar: Y entonces, mientras los Visitantes se abrían paso a través de la tierra... la encontré en una de las casas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415049
    m_Localized: 'Edgar: Una chica envuelta en lino blanco, con un rostro de belleza inquietante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415050
    m_Localized: 'Edgar: En este mundo cruel, donde los hombres solo se valen por sí mismos, a nadie le importó tal hermosura. Pero a mí sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415051
    m_Localized: 'Edgar: ¿Conoces el dicho? "Demasiado valioso para rechazarlo. Demasiado terrible para aceptarlo".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415052
    m_Localized: 'Edgar: Y sin embargo... acuné su frágil cuerpo y la llevé a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415053
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415054
    m_Localized: 'Edgar: Cuando llegue el final, diré que todo lo que hice, lo hice con amor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415055
    m_Localized: 'Edgar: Qué silencio tan sereno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415056
    m_Localized: ¿Dónde está esa joven ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415057
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415058
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415059
    m_Localized: 'Edgar: Pasé tanto tiempo intentando comprender su belleza. El poder de su silencio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415060
    m_Localized: 'Edgar: Pero entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415061
    m_Localized: 'Edgar: Hombres sin rostro, vestidos de amarillo, entraron de golpe en la sala.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415062
    m_Localized: 'Edgar: La apresaron, se la llevaron a rastras. Supongo que ambos sabemos por qué.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415063
    m_Localized: 'Edgar: Qué lástima... Jamás llegué a entenderla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415064
    m_Localized: 'Edgar: Intentar hacerlo ahora es como beber de un recuerdo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415065
    m_Localized: 'Edgar: Los hombres claman por salvar el mundo, pero no se ponen de acuerdo en cómo. La respuesta es sencilla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415066
    m_Localized: 'Edgar: Está en el silencio. En la belleza. Si tan solo alguien pudiera... percibirla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415067
    m_Localized: 'Edgar: Ella intentó enseñarme. Pero todo lo que aprendí fue serenidad. A ver aquello que es hermoso dentro de lo terrible.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415068
    m_Localized: 'Edgar: Al menos ahora... estoy listo para seguirla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415128
    m_Localized: 'Provocateur: Vaya mundo en el que vivimos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415129
    m_Localized: ¿Y ahora qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415130
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415131
    m_Localized: 'Provocateur: ¿No es obvio? Parece que aún nos falta finalizar el contrato de alquiler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415132
    m_Localized: ¿Y cómo se hace eso, exactamente?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415133
    m_Localized: ¿Es eso realmente importante ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415134
    m_Localized: 'Provocateur: ¿Lo que quiere usted decirme es que no tiene siquiera los papeles a mano?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415135
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415136
    m_Localized: 'Provocateur: Pues... le sugiero que se vaya a una notaría a recogerlos. En serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415137
    m_Localized: ¿Me estás tomando el pelo? ¿Dónde se supone que voy a encontrar una notaría ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415138
    m_Localized: ¿Por qué no vas tú?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415139
    m_Localized: 'Provocateur: Con todo el respeto, le agradecería que se dirigiera a mí adecuadamente. Con decirme "señor" bastará.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415140
    m_Localized: 'Provocateur: Realmente, lo que son los modales hoy en día...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415141
    m_Localized: Lo que tú digas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415142
    m_Localized: ¡Vete a la mierda de una vez!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415143
    m_Localized: 'Provocateur: ¿Sabe usar un mapa, no? No es tan complicado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415144
    m_Localized: 'Provocateur: Y le pido el favor de que se dirija a mí con respeto, insisto. Dígame "señor".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415145
    m_Localized: Lo que tú digas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415146
    m_Localized: ¡Vete a la mierda de una vez!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415147
    m_Localized: 'Provocateur: ¿Y por qué, exactamente, tengo que ser yo el que haga los recados? ¡Y, por cierto, use "señor" al dirigirse a mí!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415148
    m_Localized: 'Provocateur: Soy un ciudadano respetable, no un recadero cualquiera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415149
    m_Localized: Lo que tú digas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415150
    m_Localized: ¡Vete a la mierda de una vez!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415151
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415152
    m_Localized: 'Provocateur: ¿Está usted actuando intencionadamente, verdad? Al menos podría fingir que colabora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415153
    m_Localized: 'Provocateur: Tenga cuidado con su tono. El artículo 21 de la Constitución garantiza mi dignidad humana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415154
    m_Localized: 'Provocateur: Así que, le sugiero encarecidamente que empiece a mostrarme algo de respeto, antes de que la situación se torne... desagradable.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415155
    m_Localized: 'Provocateur: Vaya mundo en el que vivimos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415156
    m_Localized: ¿Puedes solo dejarlo estar?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415157
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415158
    m_Localized: 'Provocateur: Por supuesto que no. Está usted legalmente obligado a finalizar el contrato de alquiler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415159
    m_Localized: No tengo con qué finalizarlo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415160
    m_Localized: Tiene que estar de coña
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415161
    m_Localized: 'Provocateur: Mmm. Qué pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415162
    m_Localized: 'Provocateur: Me temo que esto podría ser una infracción del Artículo 131.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415163
    m_Localized: Vale, ya me estás sacando de mis casillas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415164
    m_Localized: ¿No te cansas de recitar leyes todo el tiempo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415165
    m_Localized: 'Provocateur: Para su información, según el Artículo 131, el contrato es obligatorio. Soy un ciudadano responsable. Y tengo la intención de seguir la ley.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415166
    m_Localized: Vale, ya me estás sacando de mis casillas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415167
    m_Localized: ¿No te cansas de recitar leyes todo el tiempo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415168
    m_Localized: 'Provocateur: Ah, sí. No podían faltar los insultos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415169
    m_Localized: 'Provocateur: Eso, por cierto, entra dentro del Código Administrativo 5.61.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415170
    m_Localized: 'Provocateur: Continúe, por favor. Todo se le va a volver en contra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415171
    m_Localized: 'Provocateur: Y no. No me canso de referirme a la ley y a la Constitución.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415172
    m_Localized: 'Provocateur: ¡Conozco mis derechos! Que sea usted un ignorante no quiere decir que los demás no tengan derecho a ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415173
    m_Localized: 'Provocateur: ¡Y otra vez! Le dije que se dirigiera a mí correctamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415174
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415175
    m_Localized: 'Provocateur: De verdad que usted no aprende, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415176
    m_Localized: 'Provocateur: Vaya mundo en el que vivimos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415177
    m_Localized: ¿Y ahora qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415178
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415179
    m_Localized: 'Provocateur: He visto que tiene usted un arma de fuego. ¿Puedo ver su licencia?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415180
    m_Localized: Eso no es asunto tuyo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415181
    m_Localized: ¿Cuál es tu problema conmigo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415182
    m_Localized: 'Provocateur: Ah, entiendo. Si no hay licencia que mostrar, significa que no tiene ninguna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415183
    m_Localized: 'Provocateur: ¿Cree que por tener un arma es usted la ley?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415184
    m_Localized: 'Provocateur: ¿Que puede interrogar a todo el mundo y que a usted nadie le cuestione?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415185
    m_Localized: 'Provocateur: ¡Está muy equivocado!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415186
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415187
    m_Localized: 'Provocateur: Como dice el dicho, siempre hay un pez más grande.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415188
    m_Localized: Basta ya. Ya tengo suficientes problemas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415189
    m_Localized: ¿Quieres dejar de decir gilipolleces?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415190
    m_Localized: 'Provocateur: Solo estoy intentando averiguar quién es usted en realidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415191
    m_Localized: 'Provocateur: Se está poniendo a la defensiva... Entonces he dado en el clavo. No tiene licencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415192
    m_Localized: 'Provocateur: Cree que las reglas no van con usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415193
    m_Localized: 'Provocateur: Cree que puede detectar amenazas, pero que nadie puede escudriñarlo a usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415194
    m_Localized: 'Provocateur: Se equivoca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415195
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415196
    m_Localized: 'Provocateur: Como dice el dicho, siempre hay un pez más grande.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415197
    m_Localized: Basta ya. Ya tengo suficientes problemas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415198
    m_Localized: ¿Quieres dejar de decir gilipolleces?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415199
    m_Localized: 'Provocateur: Ay, pobrecillo. Nadie se atreve a cuestionarle, nadie se atreve a revisar si es un Visitante. Ay, pero qué duro debe ser para usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415200
    m_Localized: 'Provocateur: ¿Y quién le dio a usted exactamente el derecho a decidir quién vive y quién muere? ¿Quién le concedió esa autoridad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415201
    m_Localized: 'Provocateur: Los demás nos limitamos a sentarnos y a rezar para no ser los siguientes que decida eliminar. ¿Y ahora quiere compasión? ¿De mí? Estará de coña.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415202
    m_Localized: 'Provocateur: Oh, disculpe mi vocabulario. ¿Como si no fuera usted el que nos miente a todos con sus supuestos exámenes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415203
    m_Localized: 'Provocateur: Husmeando por todos lados, tratando a todos como un asesino en potencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415204
    m_Localized: 'Provocateur: Pero claro, no señalemos al verdadero asesino. Porque quizás... solo quizás... ni siquiera existan los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415205
    m_Localized: 'Provocateur: ¿Y eso qué lo hace a usted? Un psicópata... Abusando de su posición, aprovechándose del caos para saciar su sed de sangre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415206
    m_Localized: 'Provocateur: ¿Y la gente? Escucha el pánico por la radio y acude corriendo a su puerta como moscas a la mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415207
    m_Localized: 'Provocateur: Dígame, ¿cuántos de los que vinieron al principio realmente salieron con vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415208
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415209
    m_Localized: 'Provocateur: Justo lo que me imaginaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415210
    m_Localized: 'Provocateur: Vaya mundo en el que vivimos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415211
    m_Localized: ¿Señor? ¿Todavía está aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415212
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415213
    m_Localized: 'Provocateur: Asombroso... se ha dirigido a mí con respeto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415214
    m_Localized: 'Provocateur: Qué pena que sea un poco tarde. Voy a informar de esto pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415215
    m_Localized: ¿Informar qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415216
    m_Localized: ¿A quién?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415217
    m_Localized: 'Provocateur: Ya no me puede engañar. Sé exactamente quién es usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415218
    m_Localized: 'Provocateur: Esta no es su casa. Usted asesinó al dueño. Le está suplantando. Y contactaré con AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415219
    m_Localized: 'Provocateur: Eso es, vendrán a por usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415220
    m_Localized: Pero qué gilipollez
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415221
    m_Localized: Ya es hora de que cierres la maldita boca permanentemente
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415222
    m_Localized: 'Provocateur: La Agencia Federal de Gestión de Emergencias, o AFAE, para abreviar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415223
    m_Localized: 'Provocateur: Al principio no le di mucha importancia al hecho de que ni siquiera podía completar un simple contrato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415224
    m_Localized: 'Provocateur: Pero cuanto más tiempo hablaba con usted, más claro se hizo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415225
    m_Localized: 'Provocateur: Ahora todo encaja. Esta no es su casa. Es usted un impostor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415226
    m_Localized: 'Provocateur: ¡Usted es un VISITANTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415227
    m_Localized: 'Provocateur: Así que empaque sus cosas. Vendrán a por usted. ¡Esta noche!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415228
    m_Localized: Tonterías
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415229
    m_Localized: Hora de que te calles de una vez por todas.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415230
    m_Localized: 'Provocateur: Oh, voy a informar de esto. Vendrán. Solo espere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415231
    m_Localized: Vale, vale... Ya largo de aquí
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415232
    m_Localized: Estás muerto (sacar la escopeta)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415233
    m_Localized: 'Provocateur: Intente silenciarme, entonces.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415234
    m_Localized: 'Provocateur: ¡¿Espere—qué?! ¡¿Está usted loco?! ¡Eso es un delito penal!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415235
    m_Localized: 'Provocateur: No, no, no. Esto no va a quedar así.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609280
    m_Localized: 'Provocateur: Me voy a quedar justo aquí hasta que llegue la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609281
    m_Localized: 'Provocateur: Les contaré todo lo que ha hecho y lo peligroso que es usted.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609282
    m_Localized: 'Provocateur: ¡¿Espere—qué?! ¡¿Está usted loco?! ¡Eso es un delito penal!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609283
    m_Localized: 'Provocateur: ¡No se atreva!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609284
    m_Localized: Será mejor que te marches antes de que te dispare
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609285
    m_Localized: Voy a disparar si no te vas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609286
    m_Localized: No me dejas otra opción
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609287
    m_Localized: (Dispararle)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609288
    m_Localized: 'Provocateur: No dejaré que se escape de la AFAE. ¡A menos que sea sobre mi cadáver!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609289
    m_Localized: 'Provocateur: ¡Al final van a atraparle!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609290
    m_Localized: 'Provocateur: ¡Pues yo tampoco tengo de otra!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609291
    m_Localized: 'Provocateur: ¡ES UN VISITANTE! ¡UN ASESINO! ¡NO ES HUMANO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609292
    m_Localized: 'Provocateur: ¡NO, ESTÁ EN CONTRA DE LA LEY!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609293
    m_Localized: 'Provocateur: ¡¡¡AAAAAAAAAAHHH!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609294
    m_Localized: 'Marauder: Tío... cómo molaría tener un buen botín.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609295
    m_Localized: ¿Qué tal tu vida de saqueador?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609296
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609297
    m_Localized: 'Marauder: Mira, sí. Pensé que este sitio estaba muerto, así que intenté colarme... pero aquí vive gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609298
    m_Localized: 'Marauder: Yo no le robo a los vivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609299
    m_Localized: 'Marauder: A ver... Piénsalo: ¿qué va a hacer un muerto con un abrigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609300
    m_Localized: 'Marauder: Él se ha ido. Las cosas están ahí, tiradas. ¿Y yo? Yo sigo respirando. Podría salvarme la vida. O la de alguien que me importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609301
    m_Localized: 'Marauder: Dime que no le cogerías algo a un muerto para salvar a alguien que amas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609302
    m_Localized: 'Marauder: Quizás es hora de que dejemos de tratar a cada muerto como si fuera un santuario. Solo digo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609303
    m_Localized: 'Marauder: Tío... cómo molaría tener un buen botín.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609304
    m_Localized: ¿Por qué decidiste ser un saqueador?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609305
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609306
    m_Localized: 'Marauder: ¿Qué se suponía que iba a hacer? No quería empezar a hacerle daño a la gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609307
    m_Localized: 'Marauder: Así que elegí el camino silencioso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609308
    m_Localized: 'Marauder: Los muertos no se defienden, ¿sabes? Sus cosas son solo... lo que queda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609309
    m_Localized: 'Marauder: No estoy aquí para herir a nadie. Solo intento seguir vivo. Y tal vez ayudar a unos cuantos por el camino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609310
    m_Localized: 'Marauder: Tío... cómo molaría tener un buen botín.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609311
    m_Localized: ¿Qué has encontrado mientras rebuscabas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609312
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609313
    m_Localized: 'Marauder: Jo, es que he visto demasiado como para contarlo todo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609314
    m_Localized: 'Marauder: Deja que me lo piense...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609315
    m_Localized: 'Marauder: Una vez encontré una biblioteca abandonada. Libros llenos de polvo aún en las estanterías como si alguien fuera a volver a por ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609316
    m_Localized: 'Marauder: Me colé en una exposición de arte de novatos. Los cuadros seguían allí, colgados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609317
    m_Localized: 'Marauder: Y una vez... vi una puesta de sol. No una cualquiera, parecía pintada en el cielo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609318
    m_Localized: 'Marauder: Hoy en día nadie se arriesga a quedarse parado mirando el cielo. Pero antes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609319
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609320
    m_Localized: 'Marauder: Echo de menos cómo eran las cosas. Me levantaba muy temprano. Las calles estaban tranquilas. La niebla se metía baja, la hierba aún mojada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609321
    m_Localized: 'Marauder: Y el sol... uf, salía tan brillante, como si te prometiera un día decente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609322
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609323
    m_Localized: 'Marauder: Ahora míranos. El sol es el enemigo. ¿Cómo pudo pasar eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609324
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609325
    m_Localized: 'Marauder: Ojalá alguien tuviera respuestas para toda esta mierda. A lo mejor así sería más fácil respirar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609326
    m_Localized: 'Marauder: Tío... cómo molaría tener un buen botín.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609327
    m_Localized: ¿Ya has dejado de saquear?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609328
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609329
    m_Localized: 'Marauder: Sigo con ello. Pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609330
    m_Localized: 'Marauder: Hubo una vez... sí, una vez que me tocó la fibra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609331
    m_Localized: 'Marauder: Encontré esta casa, vacía. Había un cuerpo en el suelo, lo habitual. Sin amenazas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609332
    m_Localized: 'Marauder: El tío tenía agujeros por toda la espalda. Estaba tumbado encima de algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609333
    m_Localized: 'Marauder: Pensé que a lo mejor trató esconder algo, así que me acerqué, le di la vuelta y...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609334
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609335
    m_Localized: 'Marauder: Mira, te lo cuento después, ¿vale? No estoy preparado para revivir eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609336
    m_Localized: 'Marauder: Tío... cómo molaría tener un buen botín.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609337
    m_Localized: ¿Qué había debajo del cuerpo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609338
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609339
    m_Localized: 'Marauder: Está bien...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609340
    m_Localized: 'Marauder: Lo volteé y ahí la vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609341
    m_Localized: 'Marauder: Resulta que el tío era una cría; una niña sin vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609342
    m_Localized: 'Marauder: Con los adultos... te lo esperas un poco. ¿Pero una cría? Eso te llega más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609343
    m_Localized: 'Marauder: Cuando veo críos muertos, se me hace un nudo en la garganta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609344
    m_Localized: 'Marauder: Estaba agarrando un gatito de peluche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609345
    m_Localized: 'Marauder: Todo cubierto de sangre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609346
    m_Localized: 'Marauder: El rostro de la cría se había quedado con esta cara... como si supiera que la muerte se acercaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609347
    m_Localized: 'Marauder: Por un segundo, juro que parecía asustada de que le quitara su juguete.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609348
    m_Localized: 'Marauder: Como si ni en la muerte, la crueldad de la gente no la dejara en paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609349
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609350
    m_Localized: 'Marauder: Eso me afectó más de lo que me gustaría admitir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609351
    m_Localized: 'Marauder: Ese día, quise parar, quise dejar a los muertos en paz. Pero ya es tarde para eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609352
    m_Localized: 'Marauder: Todo lo que puedo hacer es seguir. Seguir saqueando. Es la única forma para mí de sobrevivir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609353
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609354
    m_Localized: 'Marauder: La gente dice que no puedes huir del destino. Supongo que es cierto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609355
    m_Localized: 'GraveDigger: Ojalá esos Visitantes se vuelvan a meter bajo tierra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609356
    m_Localized: ¿Por qué te hiciste sepulturero?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609357
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609358
    m_Localized: 'GraveDigger: ¿Eh? ¿Mi curro? Ni puta idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609359
    m_Localized: 'GraveDigger: El cementerio es como... como una biblioteca, ¿sabes? Pero esos libros no son para leer... Solo están ahí. Callados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609360
    m_Localized: 'GraveDigger: Antes sabía todo de cada tumba. Dónde estaba cada quién, cómo tenían las manos torcidas, qué traje llevaban, sus nombres...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609361
    m_Localized: 'GraveDigger: Y de repente un día estaba cavando un hoyo nuevo, ¿sabes? Un día normal, nada raro. Me parecía lo bastante profundo, y ¡bam! Vacío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609362
    m_Localized: 'GraveDigger: ¡Te juro que estaba vacío! Pero el documento decía que había alguien ahí. Un cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609363
    m_Localized: 'GraveDigger: Un tipo, muerto sin duda. Tenía bigote. Me acuerdo. Pero puf... se esfumó. Como el rocío en la mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609364
    m_Localized: 'GraveDigger: Así que... si un muerto desaparece... ¿es como si muriese de nuevo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609365
    m_Localized: 'GraveDigger: Ojalá esos Visitantes se vuelvan a meter bajo tierra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609366
    m_Localized: ¿Qué hiciste cuando encontraste la tumba vacía?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609367
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609368
    m_Localized: 'GraveDigger: Esperar... Me senté, justo en el borde. Miré dentro... nada. Pero luego miré hacia arriba y, a lo lejos... vi a alguien de pie ahí. Observando. Como en un funeral.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609369
    m_Localized: 'GraveDigger: Sin ojos. Pero los dientes blancos como la leche. Brillando. Sonriendo. Simplemente ahí, de pie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609370
    m_Localized: 'GraveDigger: Casi me cago encima, para qué te voy a mentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609371
    m_Localized: 'GraveDigger: Corrí. Rápido. En eso soy bueno. Aunque no me persiguió. Simplemente... desapareció. Como el humo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609372
    m_Localized: 'GraveDigger: Una mierda muy jodida... Y ahí empezó todo este follón de los Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609373
    m_Localized: 'GraveDigger: Ojalá esos Visitantes se vuelvan a meter bajo tierra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609374
    m_Localized: ¿Qué sentido tiene cavar si ya nadie entierra a los muertos?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609375
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609376
    m_Localized: 'GraveDigger: Ya no cavo. Simplemente... vigilo, je. ¿Después de ese jaleo? Empecé a hurgar en las tumbas recientes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609377
    m_Localized: 'GraveDigger: Con mucho cuidado. Sin hacer tonterías.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609378
    m_Localized: 'GraveDigger: Pensé que quizá uno de esos bichos se había enterrado por error. Llevaba mi pala como una espada. Preparado para zurrarle a lo que se moviera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609379
    m_Localized: 'GraveDigger: Pero qué va... Los huesos estaban todos en su sitio. Los cuerpos quietos. Nada salía reptando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609380
    m_Localized: 'GraveDigger: Me hizo pensar... Quizá no son muertos los que vuelven. Quizá los Visitantes son personas que deberían haber sido enterradas... pero no lo fueron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609381
    m_Localized: 'GraveDigger: Ojalá esos Visitantes se vuelvan a meter bajo tierra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609382
    m_Localized: No habrás estado desenterrando tumbas nuevas, ¿verdad?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609383
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609384
    m_Localized: 'GraveDigger: ¿Yo? ¡Ni hablar! No soy estúpido. Mira... Llevo toda la vida rodeado de muertos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609385
    m_Localized: 'GraveDigger: Antes, la muerte no me preocupaba. Te mueres, te entierran. Asunto zanjado. ¿Ahora? ¿Quién queda para enterrarte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609386
    m_Localized: 'GraveDigger: Y aunque alguien lo haga, ¿cómo sabes que sí te quedarás dentro? Vi una tumba que SÉ que llené... y estaba vacía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609387
    m_Localized: 'GraveDigger: ¡Pero a ése lo enterré yo mismo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609388
    m_Localized: 'GraveDigger: Ahora estoy pensando... tal vez mi tumba también esté vacía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609389
    m_Localized: "GraveDigger: Quizás... quizás ya soy un Visitante...\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609390
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609391
    m_Localized: 'GraveDigger: Eh... olvídalo, tío. Solo estoy diciendo tonterías.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609392
    m_Localized: 'GraveDigger: Ojalá esos Visitantes se vuelvan a meter bajo tierra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609393
    m_Localized: ¿De dónde crees que vienen estos Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609394
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609395
    m_Localized: 'GraveDigger: ¿Te has fijado bien? Son... jodidamente familiares. Como si no fueran solo una cara... sino un recuerdo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609396
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609397
    m_Localized: 'GraveDigger: Tengo una teoría. ¿Seguro que quieres oírla? Muy bien, allá va...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609398
    m_Localized: 'GraveDigger: Quizá los Visitantes... no son los muertos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609399
    m_Localized: 'GraveDigger: Quizá sean pensamientos, esos que no enterraste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609400
    m_Localized: 'GraveDigger: Miedos, arrepentimientos, gente que olvidaste, sentimientos que nunca soltaste y se acumulan... y cuando hay mucho silencio bajo tierra, salen arrastrándose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609401
    m_Localized: 'GraveDigger: No buscan carne. Buscan atención.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609402
    m_Localized: 'GraveDigger: Y cuanto más miedo tienes... más se acercan. Porque los recuerdas. Y todo lo que se recuerda... quiere seguir vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609476
    m_Localized: 'Intruder: ¿Los Visitantes soñarán...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609477
    m_Localized: ¿Has dormido algo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609478
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609479
    m_Localized: 'Intruder: ¿Eh? Qué va. No he intentado dormir, la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609480
    m_Localized: 'Intruder: Solo espero que alguien aquí aún sueñe, eso es todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609481
    m_Localized: 'Intruder: Pero... nadie ha compartido sus sueños todavía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609482
    m_Localized: 'Intruder: Quizás no parezco de fiar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609483
    m_Localized: 'Intruder: Quizás se abran más tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609484
    m_Localized: 'Intruder: ¿Los Visitantes soñarán...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609485
    m_Localized: ¿Por qué te obsesionan tanto los sueños?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609486
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609487
    m_Localized: 'Intruder: ¿Quién ha dicho que estoy obsesionado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609488
    m_Localized: 'Intruder: Vaya conclusión más rara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609489
    m_Localized: 'Intruder: ¿No tienes ni un poco de curiosidad por lo que tu subconsciente intenta decirte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609490
    m_Localized: 'Intruder: ¿Qué estaremos ocultando en estas cabezas nuestras? Todos nos ocultamos cosas a nosotros mismos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609491
    m_Localized: 'Intruder: Tú, por ejemplo. ¿Evitas a la gente porque alguien te ha herido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609492
    m_Localized: 'Intruder: Eso es lo que me resulta interesante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609493
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609494
    m_Localized: 'Intruder: ¿Sabes qué? Te voy a contar el último sueño que tuve.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609495
    m_Localized: 'Intruder: Un enorme tren negro me perseguía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609496
    m_Localized: 'Intruder: Mis piernas habían echado raíces al suelo. Grité y me desperté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609497
    m_Localized: 'Intruder: Estaba parado en las vías... y también era yo quien conducía el tren. Cargando justo contra mí, incapaz de pararlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609498
    m_Localized: 'Intruder: ¿Los Visitantes soñarán...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609499
    m_Localized: ¿Y tú? ¿Qué ocultas en tus sueños?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609500
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609501
    m_Localized: 'Intruder: ¿Yo? Pues...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609502
    m_Localized: 'Intruder: No he dormido en días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609503
    m_Localized: 'Intruder: Pero está bien, te diré algo. Nadie me lo va a creer de todas formas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609504
    m_Localized: 'Intruder: Y es que... puedo VER los sueños de otras personas. Es... fascinante, la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609505
    m_Localized: 'Intruder: Ni idea de cómo funciona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609506
    m_Localized: 'Intruder: Pero desde que todo esto empezó, los sueños... se han quedado en silencio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609507
    m_Localized: 'Intruder: Como si todo el mundo estuviera aguantando la respiración.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609508
    m_Localized: 'Intruder: Y yo ya no pude dormir más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609509
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609510
    m_Localized: 'Intruder: Ahora... ¿Estoy diciendo la verdad o solo te estoy tomando el pelo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609511
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609512
    m_Localized: ¿Quiénes son?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609513
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609514
    m_Localized: 'Cultist1: Almas perdidas. Como toda la gente en esta tierra miserable.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609515
    m_Localized: 'Cultist1: Deseamos paz y tranquilidad. Y sabemos cómo conseguirla...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609516
    m_Localized: 'Cultist1: Con la muerte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609517
    m_Localized: 'Cultist1: ¿Por qué la gente le teme? ¿Será lo desconocido? ¿O es el castigo que nos han inculcado las religiones?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609518
    m_Localized: 'Cultist1: Durante milenios, buscamos el significado de la vida. Y la respuesta era tan, tan simple...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609519
    m_Localized: 'Cultist1: La muerte es nuestro propósito. Y nosotros somos sus seguidores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609520
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609521
    m_Localized: ¿Por qué veneráis a la muerte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609522
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609523
    m_Localized: 'Cultist1: Porque la Muerte es la personificación de la misericordia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609524
    m_Localized: 'Cultist1: Todos le tememos, pero ¿están justificados nuestros miedos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609525
    m_Localized: 'Cultist1: Piensa en ello. Nuestro mundo no es un paraíso, sino un purgatorio que nos atormenta. Pero ¿por qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609526
    m_Localized: 'Cultist1: Tanto miedo, dolor y sufrimiento... ¿Acaso no merecemos paz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609527
    m_Localized: 'Cultist1: La Muerte es un paraíso que no podemos comprender.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609528
    m_Localized: 'Cultist1: Las religiones intentan simplificar la idea del Cielo porque es más fácil para la gente. Pero, ¿la vida alguna vez fue sencilla?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609529
    m_Localized: 'Cultist1: Lo mismo ocurre con la Muerte. No puedes entenderla hasta que la tocas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609530
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609531
    m_Localized: ¿Por qué habéis elegido mi casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609532
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609533
    m_Localized: 'Cultist1: Tu casa está ligada a la Muerte como ninguna otra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609534
    m_Localized: 'Cultist1: Al principio, no entendía por qué nuestro mentor eligió este lugar. Pero ahora está claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609535
    m_Localized: 'Cultist1: Estas paredes guardan las huellas de la Muerte. Son invisibles, pero sofocantes, se pueden sentir en el alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609536
    m_Localized: 'Cultist1: El cemento desnudo apesta a sangre derramada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609537
    m_Localized: 'Cultist1: No te estamos pidiendo que mates de forma deliberada, como podrías pensar. Ya tomas vidas sin que os lo pidamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609538
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609539
    m_Localized: 'Cultist1: Creo que vuestro vínculo con la Muerte es más fuerte que el de cualquiera de nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609540
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609541
    m_Localized: ¿Qué son esas hogueras que estáis construyendo fuera?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609542
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609543
    m_Localized: 'Cultist1: Ha llegado el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609544
    m_Localized: 'Cultist1: Los ángeles de abajo tomarán nuestras cenizas como ofrenda y nos concederán el paso al reino de la Muerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609545
    m_Localized: 'Cultist1: Así es como nos ganamos su favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609546
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609547
    m_Localized: Te ves asustado. ¿Tienes miedo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609548
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609549
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609550
    m_Localized: 'Cultist2: Sois un buen observador, propietario.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609551
    m_Localized: 'Cultist2: A diferencia de mis hermanos de fe... Yo todavía lucho con el miedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609552
    m_Localized: 'Cultist2: Las dudas me atormentan. ¿Qué hay más allá de la vida? ¿Qué se sentirá?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609553
    m_Localized: 'Cultist2: Nuestro mentor nos enseña que no es ni el cielo ni el infierno. Es algo diferente. Pero no logro entenderlo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609554
    m_Localized: 'Cultist2: Si ni siquiera él comprende a la Muerte del todo, ¿podremos nosotros siquiera entenderla?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609555
    m_Localized: 'Cultist2: ¿Y si con tocarla no basta? ¿Y si está completamente fuera de toda comprensión...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609556
    m_Localized: 'Cultist2: Pero no me atrevo a cuestionar la voluntad de nuestro mentor. En sus ojos, veo certeza y conocimiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609557
    m_Localized: 'Cultist2: Él nos pide que abracemos la fe y la resolución. Que estemos listos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609558
    m_Localized: 'Cultist2: Solo entonces podremos cruzar los ríos de los muertos y las montañas de huesos. Y llegar hasta Ella...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609559
    m_Localized: 'Cultist2: A la Muerte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609560
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609561
    m_Localized: ¿Por qué adoras a la muerte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609562
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609563
    m_Localized: 'Cultist2: Por favor, amable propietario, hable de la Muerte con respeto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609564
    m_Localized: 'Cultist2: Desprecia a los blasfemos que la llaman injusta y los castiga más duramente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609565
    m_Localized: 'Cultist2: Su naturaleza me aterra, pero nuestro mentor dice que la Muerte podría ser la más bondadosa de todos los dioses.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803584
    m_Localized: 'Cultist2: No trae hambruna, plaga o guerra. Solo... nos brinda descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803585
    m_Localized: 'Cultist2: Y tenemos que encontrarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803586
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803587
    m_Localized: ¿Por qué estáis tan ansiosos por encontrar a la muerte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803588
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803589
    m_Localized: 'Cultist2: Este viaje no es nuestra elección. Es la voluntad de la Muerte misma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803590
    m_Localized: 'Cultist2: Nos ha llamado. Nos quiere en su dominio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803591
    m_Localized: 'Cultist2: Nuestro mentor dice que por eso el sol arde con tanta ferocidad ahora; trata de echarnos de la superficie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803592
    m_Localized: 'Cultist2: La Muerte nos ofrece silencio, paz y unidad. En sus tierras es donde volveremos a reunirnos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803593
    m_Localized: 'Cultist2: Lloramos a los muertos en vano, olvidando que volveremos a encontrarlos algún día.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803594
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803595
    m_Localized: ¿Qué pensáis hacer?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803596
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803597
    m_Localized: 'Cultist2: Ha llegado el momento...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803598
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803599
    m_Localized: 'Cultist2: Tengo miedo... Mi cuerpo no deja de temblar... Pero debo abrazar la fe y la resolución.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803600
    m_Localized: 'Cultist2: Nuestro mentor cree en mí. No puedo defraudarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803601
    m_Localized: 'Cultist2: Pero el miedo... el miedo aún corroe mi mente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803602
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803603
    m_Localized: 'Cultist2: Libéranos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803604
    m_Localized: 'Cultist2: Libéranos. ¡Libéranos!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803605
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803606
    m_Localized: ¿Cuánto tiempo pensáis quedaros?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803607
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803608
    m_Localized: 'Cultist3: No se preocupe, dueño de la casa. No seremos ninguna molestia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803609
    m_Localized: 'Cultist3: Agradecemos su hospitalidad y no queremos molestarle. Ya ha hecho mucho por nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803610
    m_Localized: 'Cultist3: Nos quedaremos en esta habitación y rezaremos en silencio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803611
    m_Localized: 'Cultist3: Necesitamos algo de descanso. Nuestro camino será largo y difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803612
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803613
    m_Localized: ¿Adónde os dirigís?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803614
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803615
    m_Localized: 'Cultist3: A la tierra de los forasteros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803616
    m_Localized: 'Cultist3: La vida humana no es eterna. Solo somos visitantes en esta tierra. Vinimos una vez, y así nos marcharemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803617
    m_Localized: 'Cultist3: Los forasteros deben tomar esta tierra y establecerse aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803618
    m_Localized: 'Cultist3: Su llegada no es casual. Han venido por el mismo llamado que nos hace alejarnos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803619
    m_Localized: 'Cultist3: La Muerte los convocó...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803620
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803621
    m_Localized: ¿Qué le hace pensar que la Muerte ha convocado a los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803622
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803623
    m_Localized: 'Cultist3: Porque la Muerte no hace distinción: humano, bestia, forastero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803624
    m_Localized: 'Cultist3: La Muerte es una para todos y todos somos iguales ante ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803625
    m_Localized: 'Cultist3: Esperó el momento adecuado y ahora ya está por llegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803627
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803628
    m_Localized: ¿Qué tipo de ritual estáis planeando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803629
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803630
    m_Localized: 'Cultist3: Ha llegado el momento de cruzar, de viajar nuestro hogar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803631
    m_Localized: 'Cultist3: Debemos ir con la Muerte, al reino de la paz y serenidad eternas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803632
    m_Localized: 'Cultist3: Es hora de seguir adelante...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803635
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803656
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803687
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803695
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803716
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803718
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803726
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803755
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803757
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713862
    m_Localized: 'NotTrue: Yo soy de ciudad, querido. Tenía mi pisito en el centro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713863
    m_Localized: 'NotTrue: No tengo casa en el campo, ni parientes, ni nietos... Ay, mi cielo...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713864
    m_Localized: 'NotTrue: Por eso me sentaba en el banquito de la entrada la mayoría de los días. Ahí se notaba la vida y te enterabas de todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713865
    m_Localized: 'NotTrue: Pero cuando llegaron las penas, hasta eso se acabó.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713866
    m_Localized: 'NotTrue: ¡Uf! ¿Cómo sentir vida cuando la muerte está por todas partes? La gente estaba cayendo como moscas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713867
    m_Localized: 'NotTrue: Llegabas a la escalera y siempre había alguien ahí, tapado con una sábana blanca.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713868
    m_Localized: 'NotTrue: Dios mío, es para desear irte de este mundo, antes que seguir viendo tanta pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713869
    m_Localized: 'NotTrue: Así que me fui, buscando un lugar donde aún quedara gente, historias que escuchar, vida que sentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713870
    m_Localized: 'NotTrue: Y mira por dónde, el destino me trajo directo a tu puerta, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713871
    m_Localized: 'NotTrue: Mira, yo no soy de ir a la iglesia, pero en estos tiempos... bueno, parece que el Señor mismo me ha guiado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713872
    m_Localized: 'NotTrue: Todos se han olvidado de mí, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713873
    m_Localized: 'NotTrue: Si todavía queda alguien vivo, no viene a verme.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713874
    m_Localized: 'NotTrue: Y a decir verdad, no soy la única. Hay muchos jóvenes de esos de ahora que se olvidan de sus parientes...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713875
    m_Localized: 'NotTrue: Piensan solo en sí mismos. ¡Uf! Es que ni un alma me llama para saber qué tal estoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713876
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713877
    m_Localized: 'NotTrue: Una vez, mi vecina, mientras estábamos en ese banco, se puso a presumir de su nieto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713878
    m_Localized: 'NotTrue: Decía: "¡Mi nieto es un sol! Se acuerda de sus mayores, me visita. No como los demás".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713879
    m_Localized: 'NotTrue: Y la verdad es que era un buen chico. Siempre me saludaba, me preguntaba qué tal estaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713880
    m_Localized: 'NotTrue: Hasta sentí un poco de envidia...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713881
    m_Localized: 'NotTrue: Y entonces la muerte se la llevó...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713882
    m_Localized: 'NotTrue: Y el chico... qué quieres que te diga, se volvió hosco y amargado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713883
    m_Localized: 'NotTrue: Parece que toda su amabilidad era solo por el piso. Quería que se lo dejase en herencia, el muy...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713884
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713885
    m_Localized: 'NotTrue: ¿Por qué crees que las personas se mienten así, en toda la cara? Ni un gramo de honestidad ni para la familia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713886
    m_Localized: 'NotTrue: Se casan, tienes hijos, y luego... ¿Te lo puedes creer? ¡No te quieren ni un poco!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713887
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713888
    m_Localized: 'NotTrue: Pues, ahora tengo suerte de no tener marido. Era un vejestorio de lo más ruin. ¡Puaj!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713889
    m_Localized: 'NotTrue: Ay, ese dejó este mundo hace unos años, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713890
    m_Localized: 'NotTrue: Me arruinó la vida ese viejo inutil.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713891
    m_Localized: 'NotTrue: Solo me casé con él porque mis padres me empujaron a hacerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713892
    m_Localized: 'NotTrue: "Cásate con él, mijita, es un buen partido," me decían. Y nos casamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713893
    m_Localized: 'NotTrue: Al principio, me quería de verdad. Pero apenas pasó el lío de la boda, fue como si se hubiese podrido al instante.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713894
    m_Localized: 'NotTrue: Primero, mi comida nunca le parecía buena. Luego, me decía: "No fastidies, ¿no ves que estoy comiendo?".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713895
    m_Localized: 'NotTrue: Y ya en sus últimos años, se iba a beber con los colegas y desaparecía por horas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713896
    m_Localized: 'NotTrue: Volvía borracho, inventándose cuentos de que había estado jugando al dominó en el garaje.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713897
    m_Localized: 'NotTrue: Y si le preguntaba si había bebido, me maldecía, el muy miserable.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713898
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713899
    m_Localized: 'NotTrue: Después, se murió...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713900
    m_Localized: 'NotTrue: Al principio, fue como si se me hubiese levantado un carga... Pero de repente, la soledad se me metió por dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713901
    m_Localized: 'NotTrue: La tele me ayudó un tiempo, pero ahora todo es un sin sentido de mentiras.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713902
    m_Localized: 'NotTrue: Así que me fui al lado de la carretera, a sentarme en el banco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713903
    m_Localized: 'NotTrue: Ay, querido...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713904
    m_Localized: 'NotTrue: La verdad, empecé a sentirme un poquito mejor, viendo pasar el mundo. Niños riéndose, parejas jóvenes de la mano, perros trotando por ahí...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713905
    m_Localized: 'NotTrue: Pero después vino esta desgracia, uf...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713906
    m_Localized: 'NotTrue: Y uno a uno, todos se encerraron en casa. Se acabó eso de sentarse por las tardes a ver la vida con su trajín.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713907
    m_Localized: 'NotTrue: Y mirar por la ventana tampoco era algo bueno.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713908
    m_Localized: 'NotTrue: Donde antes jugaban los niños, había bolsas para cadáveres. Perros salvajes deambulaban por las calles y los vecinos se miraban como si fueran extraños.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713909
    m_Localized: 'NotTrue: La vida, querido, parecía haberse parado en seco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713910
    m_Localized: 'NotTrue: Y ahora... ¡Uf! ¡Ya ni se puede distinguir la verdad de la mentira!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713911
    m_Localized: 'NotTrue: Ojalá que la gente simplemente dejara de mentir, querido...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083396
    m_Localized: 'Wifefema: Si tan solo la gente de la AFAE me aceptara...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083432
    m_Localized: 'Wifefema: Oh, bájate de tu pedestal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083471
    m_Localized: 'Raskolnikov: Fue entonces cuando me di cuenta... ahora solo hay dos tipos de personas. Depredadores y presas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277854
    m_Localized: 'Bestson: Pero la abuela se niega a tener un teléfono. ¿Quizás por eso no pudieron llamarme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277857
    m_Localized: 'Bestson: Bueno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471999
    m_Localized: 'Fatman: Ahh... agua fría. Justo lo que necesitaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472000
    m_Localized: ¿Te encuentras mejor?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472001
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472002
    m_Localized: 'Fatman: Sí, sí, ya estoy mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472003
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472004
    m_Localized: 'Fatman: Aunque...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472005
    m_Localized: 'Fatman: Sabes, me está entrando un poco de hambre. ¿Tienes algo para picar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472006
    m_Localized: Vale... (Darle una lata de cerveza)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472007
    m_Localized: 'Fatman: ¿Cómo que no hay cerveza? No...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472008
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472009
    m_Localized: 'Fatman: Pero si vi que tenías la nevera repleta de ellas. ¿Cómo demonios te las has bebido tan rápido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472010
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472011
    m_Localized: 'Fatman: ¡Estupendo! ¡Uff, así sí que da gusto!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472012
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472013
    m_Localized: 'Fatman: Aaaaahhh... Uff, qué buena está.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472014
    m_Localized: 'Fatman: Toma, coge algo de dinero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472015
    m_Localized: 'Fatman: (Recibes un puñado de billetes arrugados, aunque son inútiles hoy en día)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472016
    m_Localized: Eh... gracias
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472017
    m_Localized: Tu dinero me la suda
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472018
    m_Localized: 'Fatman: ¡Así está mejor!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472019
    m_Localized: 'Fatman: Tú me rascas la espalda y, ya sabes, yo te la rasco a ti...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472020
    m_Localized: 'Fatman: Tengo cómo compensar... a mis tío, ya sabes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472021
    m_Localized: 'Fatman: Ah, por cierto, toma esto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472022
    m_Localized: 'Fatman: (Recibes un tarro de kombucha)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472023
    m_Localized: 'Fatman: No sé quién narices se bebería esa mierda, pero cógela. Podría venirte bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472024
    m_Localized: 'Fatman: ¿Cómo que te la suda? ¡¿Te crees que eres especial o algo así?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472025
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472026
    m_Localized: 'Fatman: ¡Todo el mundo necesita dinero! Todo el puto mundo funciona gracias a que existe. No necesitas efectivo, ¿eh...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472027
    m_Localized: 'Fatman: ¡Anda, toma esto!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472028
    m_Localized: 'Fatman: (Recibes un tarro de kombucha)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472029
    m_Localized: 'Fatman: No sé quién narices se bebería esa mierda, pero cógela. Podría venirte bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472030
    m_Localized: 'Fatman: ¿Que cómo que no? ¿Crees que no tienes precio? ¡Todo tiene un precio! El amor, las cosas, la gente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472031
    m_Localized: 'Fatman: ¡El dinero mueve el mundo, chaval! ¿Y yo? ¡Soy un puto pez gordo! ¡Soy un ministro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472032
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472033
    m_Localized: 'Fatman: Vale, olvídate. Si no quieres ayudar, pues que te den.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472034
    m_Localized: 'Fatman: Ahh... agua fría. Justo lo que necesitaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472035
    m_Localized: ¿Qué quieres ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472036
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472037
    m_Localized: 'Fatman: ¡Qué bueno que preguntas! Me vendría bien fumar. ¿Tienes un cigarro de sobra?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472038
    m_Localized: Vale... (Darle cigarrillos)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472039
    m_Localized: 'Fatman: ¿Qué, no tienes cigarros?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472040
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472041
    m_Localized: 'Fatman: Vale, olvídalo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472042
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472043
    m_Localized: 'Fatman: ¡Eso es lo que digo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472044
    m_Localized: 'Fatman: Yo solía fumar puros, claro... pero a ver quién los encuentra ahora. Antes, cuando estaba en el consejo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472045
    m_Localized: 'Fatman: Sí... las cosas eran diferentes. Ahora hay puros asesinatos y caos. ¡Es una completa pesadilla!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472046
    m_Localized: 'Fatman: ¿Cuándo va a intervenir la AFAE para limpiar todo esto? Para algo la fundaron, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472047
    m_Localized: 'Fatman: Nada de esta porquería pasaba cuando yo estaba en el Parlamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472048
    m_Localized: 'Fatman: Pensándolo bien, quizás solo necesitan tiempo. Eventualmente, todo se va a solucionar solo. Solo tenemos que esperar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472049
    m_Localized: ¿Estuviste en el Parlamento?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472050
    m_Localized: ¿Fuiste de los que fundaron la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472051
    m_Localized: 'Fatman: Pues sí, te lo acabo de decir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472052
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472053
    m_Localized: 'Fatman: Ah, claro... Aquí está tu recompensa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472054
    m_Localized: 'Fatman: (Recibes un puñado de billetes arrugados sin valor y una extraña postal con el sello de la AFAE)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472055
    m_Localized: 'Fatman: ¿De dónde has sacado esa idea?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472056
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472057
    m_Localized: 'Fatman: Ah, claro... Aquí está tu recompensa'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472058
    m_Localized: 'Fatman: (Recibes un puñado de billetes arrugados sin valor y una extraña postal con el sello de la AFAE)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472059
    m_Localized: 'Fatman: ¡¿Cómo que no?! ¡¿Pero tú sabes con quién estás hablando?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472060
    m_Localized: 'Fatman: ¡Fui ministro! El gobierno es una máquina complicada y necesita a gente como yo para que siga funcionando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472061
    m_Localized: 'Fatman: ¡Soy la voz del pueblo! Sin mí, personas como tú no serían escuchadas. Yo mejoro sus vidas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472062
    m_Localized: 'Fatman: Si las cosas fuesen normales, ¡no te atreverías ni a replicarme! ¡Te echarían de aquí en un periquete!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472063
    m_Localized: 'Fatman: Madre mía, todo se está yendo al garete... Ya a nadie le importa el estatus de un ministro. La gente piensa que nos tocamos los huevos en el despacho y ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472064
    m_Localized: 'Fatman: Pues, ya veremos cómo hablas cuando estalle el infierno de verdad y vengas corriendo a rogarme que te ayude. ¡Já!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472065
    m_Localized: 'Fatman: Ahh... agua fría. Justo lo que necesitaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472066
    m_Localized: ¿Qué quieres ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472067
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472068
    m_Localized: 'Fatman: ¡Menudo chico más listo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472069
    m_Localized: 'Fatman: Quiero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472070
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472071
    m_Localized: 'Fatman: ¡Quiero una bebida energizante! Hace siglos que no bebo algo fresco que me llene de energía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472072
    m_Localized: Vale, toma. (Entregar bebida energética)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472073
    m_Localized: 'Fatman: ¿Que no tienes EnerJeka?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472074
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472075
    m_Localized: 'Fatman: Vale, olvídalo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472080
    m_Localized: Qué mala suerte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472081
    m_Localized: 'Fatman: Ufff, sí-sí-sí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472082
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472084
    m_Localized: Háblame de la AFAE. ¿Quiénes son?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472085
    m_Localized: ¿Qué está planeando la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472101
    m_Localized: 'Fatman: ¿Qué? ¿Es sin azúcar? Vaya mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472104
    m_Localized: 'Fatman: Me tenías que haber traído un refresco en vez de esta mier—... Espera, ¿qué me acabas de preguntar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472105
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472106
    m_Localized: 'Fatman: ¿Se te ha zafado un tornillo? ¡Eso es confidencial!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472107
    m_Localized: 'Fatman: Firmé unos documentos, ¿lo pillas? De no divulgación. No tienes autorización para pedirme eso, sin ofender.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472108
    m_Localized: 'Fatman: Toma un café, en vez de eso y deja de hacer esas preguntas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472109
    m_Localized: 'Fatman: (Recibes una lata de café)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472110
    m_Localized: 'Fatman: Y además, es EnerJeka. A saber qué porquerías le han metido... Espera, ¿qué me acabas de preguntar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472111
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472112
    m_Localized: 'Fatman: ¿Cómo me pides que te cuente, coño? ¡Eso es confidencial!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472113
    m_Localized: 'Fatman: Firmé unos documentos, ¿lo pillas? De no divulgación. No tienes autorización para pedirme eso, sin ofender.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472114
    m_Localized: 'Fatman: Toma un café, en vez de eso y deja de hacer esas preguntas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472115
    m_Localized: 'Fatman: (Recibes una lata de café)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472116
    m_Localized: 'Fatman: ¿Pero qué cojones dices? ¿Cómo se supone que voy a trabajar con el estómago vacío?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472117
    m_Localized: 'Fatman: ¡Estoy aquí fuera tratando de mejorar la vida! ¡Estoy dando la cara por la gente!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472118
    m_Localized: 'Fatman: Pero lo único que hacéis es criticar... Todo el mundo se cree muy listo. Entonces, ¿por qué tú no estás en el gobierno, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472119
    m_Localized: 'Fatman: Exacto. Mucha labia, pero nada de acción.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472120
    m_Localized: 'Fatman: Ahh... agua fría. Justo lo que necesitaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472121
    m_Localized: ¿Qué? ¿Qué quieres ahora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472122
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472123
    m_Localized: 'Fatman: Así es, chaval. Quiero tu escopeta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472124
    m_Localized: ¿Qué?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472125
    m_Localized: Pues, ahora sí que has perdido la cabeza
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472126
    m_Localized: 'Fatman: Sí, la necesito para protegerme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472127
    m_Localized: 'Fatman: No te preocupes, yo solía ir de caza. Sé cómo usarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472128
    m_Localized: Ni de coña
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472129
    m_Localized: ¡Vete a la mierda!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472130
    m_Localized: 'Fatman: Cuida esa boca, chaval. ¿Se te ha olvidado con quién estás hablando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472131
    m_Localized: 'Fatman: ¡Si me lo propongo, puedo hacer que te pongan tras las rejas en un periquete!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472132
    m_Localized: Ni de coña
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472133
    m_Localized: Vete a la mierda.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472134
    m_Localized: 'Fatman: ¿Qué has dicho? ¿He oído bien?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472135
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472136
    m_Localized: 'Fatman: Se acabó. ¡Ahora sí que te has metido en un buen lío!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472137
    m_Localized: 'Fatman: Ve preparando tus cosas, porque te vas a ir al trullo en un pispás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472138
    m_Localized: Para mí, no eres más que otro Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472139
    m_Localized: Me da igual que seas ministro. Para mí, no eres nadie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472140
    m_Localized: 'Fatman: ¿Se te ha ido la olla, para hablarle así a la voz del pueblo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472141
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472142
    m_Localized: 'Fatman: Estás perdido, colega. Prepárate.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472143
    m_Localized: 'Fatman: ¡Has cometido un gran error al enfadarme! Los concejales son gente poderosa, ¡por si aún no lo sabías!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472144
    m_Localized: 'Fatman: No te preocupes... Ya entrarás en razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472145
    m_Localized: Para mí, no eres más que otro Visitante
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472146
    m_Localized: Me da igual que seas ministro. Para mí, no eres nadie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472147
    m_Localized: 'Fatman: ¡¿Qué cojones dices?! Tú... ¡MISERABLE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472148
    m_Localized: 'Fatman: No estoy de broma... De verdad acabarás en la cárcel... ya lo verás...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472149
    m_Localized: 'Fatman: ¡¿Qué cojones dices?! Tú... ¡MISERABLE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472150
    m_Localized: 'Fatman: No estoy de broma... De verdad acabarás en la cárcel... ya lo verás...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472151
    m_Localized: 'Fatman: Ahh... agua fría. Justo lo que necesitaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472152
    m_Localized: Entonces, ¿por qué no estoy entre rejas aún, eh?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472153
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472154
    m_Localized: 'Fatman: ¿Te estás riendo de mí? ¡Yo... no estoy de broma! ¡De verdad vas a acabar ahí!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472155
    m_Localized: Puede que los títulos fuesen importantes en el pasado, pero ahora no vales nada
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472156
    m_Localized: El dinero ha perdido todo su valor. ¿Que no lo pillas?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472157
    m_Localized: 'Fatman: ¡Eso... eso no es cierto! ¡Aún estoy en el Parlamento!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472158
    m_Localized: 'Fatman: Solo... me... dieron una baja temporal...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472159
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472160
    m_Localized: 'Fatman: A quién engaño... Ya no volveremos a vivir como antes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472161
    m_Localized: 'Fatman: Cuando estaba en el cargo, todo el país estaba al servicio de nosotros los ministros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472162
    m_Localized: 'Fatman: La gente me temía, me respetaba. Los coches se apartaban, las multitudes se desvivían por complacerme, intentando ganarse mi favor. Y ahora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472163
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472164
    m_Localized: 'Fatman: Genial. Ahora se me ha encogido el estómago del estrés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472165
    m_Localized: 'Fatman: ¿Ya estás contento? Vete. Ya he tenido suficiente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472166
    m_Localized: 'Fatman: ¡E-eso no es cierto! ¡Aún me queda un montón de dinero!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472167
    m_Localized: 'Fatman: A ti puede que no te importe, pero... pero a todos los demás sí...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472168
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472169
    m_Localized: 'Fatman: A quién engaño... Ya no volveremos a vivir como antes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472170
    m_Localized: 'Fatman: No más lujos, no más limusinas, no más chicas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472171
    m_Localized: 'Fatman: Con dinero, todo era mucho más fácil. ¡Si tenías dinero, eras importante!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472172
    m_Localized: 'Fatman: Si no hubiera sido por el desastre...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472173
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472174
    m_Localized: 'Fatman: Genial. Ahora se me ha encogido el estómago del estrés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472175
    m_Localized: 'Fatman: ¿Ya estás contento? Vete. Ya he tenido suficiente...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173076770816
    m_Localized: 'Fatman: Ya hablamos. Estoy cansado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173093548032
    m_Localized: 'Fatman: Sigamos con esto mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860556
    m_Localized: 'Ballerina: ¿Y tú?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860655
    m_Localized: 'Couple: ¿Qué quieres de mí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054893
    m_Localized: 'BigLebowski: Dios, estoy harta de todo esto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054894
    m_Localized: ¿Por qué estás por ahí sola?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054895
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054896
    m_Localized: 'BigLebowski: Bueno... en casa estábamos muy apretados. Era un infierno de ruidos y cero comodidad. Me quería ir. Quería ver el mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054897
    m_Localized: 'BigLebowski: Así que sí, cogí una mochila, un par de refrescos, unas barritas y esta vieja pulsera de la amistad que hice en el colegio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054898
    m_Localized: 'BigLebowski: Y me marché. Seguramente mis padres ni se dieron cuenta. Tampoco es que me importe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054899
    m_Localized: 'BigLebowski: Desde entonces solo ando por ahí, me quedo a dormir donde puedo. ¿Y te digo la verdad? Por ahora me ha ido bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054900
    m_Localized: 'BigLebowski: Al menos nadie me da lata y yo soy mi propia jefa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054903
    m_Localized: 'BigLebowski: Dios, estoy harta de todo esto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054904
    m_Localized: ¿Cómo te las has apañado para sobrevivir?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054905
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054906
    m_Localized: 'BigLebowski: Me las ingeniaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054907
    m_Localized: 'BigLebowski: Me colaba en las escaleras, en los cobertizos o simplemente dormía en el suelo bajo un árbol. Me escondía del calor bajo cualquier techo que viera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054908
    m_Localized: 'BigLebowski: Comía lo que podía pillar. Algo de hierbas o la chocolatina que me robé de una tienda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054909
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054910
    m_Localized: 'BigLebowski: ¿A qué viene esa mirada? Sí, robé. ¿Qué pasa? ¿Cómo se supone que voy a sobrevivir si no? Nadie me va a contratar a mi edad. Así que me las apaño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054911
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233280
    m_Localized: 'BigLebowski: ¿Ugh, qué pasa ahora? ¿Crees que voy a robarte o algo así? Venga, por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233281
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233282
    m_Localized: 'BigLebowski: ¿En serio? ¿Qué es esto, un interrogatorio? Déjalo ya, de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054912
    m_Localized: 'BigLebowski: Dios, estoy harta de todo esto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054913
    m_Localized: ¿Cuánto tiempo piensas vivir así?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054914
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054915
    m_Localized: 'BigLebowski: ¿A ti qué más te da? Ya me las apañaré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054916
    m_Localized: 'BigLebowski: ¿O qué? ¿Te cuesta dejar que me quede aquí? ¿Te he robado algo? ¿Atasqué tu retrete? ¿Por qué me estás interrogando, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054917
    m_Localized: 'BigLebowski: Ya... a lo mejor eres uno de esos capullos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054918
    m_Localized: 'BigLebowski: Hubo un tío que me acogió una vez. Hablaba muy bien y me dio un sitio para pasar la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054919
    m_Localized: 'BigLebowski: Nos la pasamos horas viendo anime, pelis, y todo eso. Creí que por fin había encontrado a una persona decente, pero noooooo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054920
    m_Localized: 'BigLebowski: Luego intentó tocarme. Menudo asqueroso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054921
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233283
    m_Localized: 'BigLebowski: Intenta algo y juro que me voy a defender. No voy a dejar que nadie me haga daño.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233284
    m_Localized: 'BigLebowski: Mi padre es todo un gilipollas, pero al menos me enseñó a luchar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233285
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233286
    m_Localized: 'BigLebowski: Así que ya sabes. Mantén las distancias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054922
    m_Localized: 'BigLebowski: Dios, estoy harta de todo esto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054923
    m_Localized: ¿Y qué le pasó a ese hombre?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054924
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054925
    m_Localized: 'BigLebowski: ¿Por qué quieres saberlo, eh? ¿Buscas cómo lidiar conmigo si me resisto? ¿Es porque te has dado cuenta de que ya no estoy con él?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054926
    m_Localized: 'BigLebowski: Y no te creas que no lo pillo. No me lo preguntas por amabilidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054927
    m_Localized: 'BigLebowski: Solo no quieres líos en tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054928
    m_Localized: 'BigLebowski: Pero no estoy robando, no estoy rompiendo tus ventanas. No no soy un problema, ¡así que deja de actuar como si lo fuera! '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054929
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054930
    m_Localized: 'BigLebowski: Y de todas formas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054931
    m_Localized: 'BigLebowski: Solo estoy aquí porque me necesitas cerca, ¿verdad? ¿Para que ese Visitante medio desnudo no te atrape? Sí, yo también escucho las noticias.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233287
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233288
    m_Localized: 'BigLebowski: Si así van a ser las cosas, pues... ¡Ugh, da igual! Haz tus asquerosas pruebas si lo necesitas, pero no me hables.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054932
    m_Localized: 'BigLebowski: Dios, estoy harta de todo esto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054933
    m_Localized: ¿Por qué tu padre te enseñó a pelear?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054934
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054935
    m_Localized: 'BigLebowski: Para poder darle una paliza a los capullos. O para que él pudiera desquitarse conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054936
    m_Localized: 'BigLebowski: Me enseñó a hacer sparring, a recibir un puñetazo y eso. El problema era que, en lugar de usar un saco de boxeo, usaba mi cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233289
    m_Localized: 'BigLebowski: Entrenar con él era una cosa; que, por cierto, odiaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233290
    m_Localized: 'BigLebowski: Pero otra cosa era cuando se le iba la olla y me daba una paliza. ¿Y mi madre? Le importaba una mierda. Ni miraba.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233291
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233292
    m_Localized: 'BigLebowski: Ugh, no quiero acabar como ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233293
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233294
    m_Localized: 'BigLebowski: ¿Para qué tenerme si me iban a tratar así? Sigo sin entenderlo. ¿De verdad la vida es esto?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233295
    m_Localized: 'BigLebowski: Y, en plan, ¿ahora tenemos lo del sol y los Visitantes? ¡Qué pasada! Más formas de que todo sea una mierda. De puta madre que estamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233296
    m_Localized: 'BigLebowski: ¿Va a pasar algo bueno alguna vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233297
    m_Localized: 'BigLebowski: Igual qué coño iré a saber yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054958
    m_Localized: 'Luka: A mi familia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443483
    m_Localized: Dijiste que tenías algo que revelar cuando nos conocimos. ¿Qué era?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220801
    m_Localized: 'Doctor: Te escucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220802
    m_Localized: ¿Qué pasó con los hospitales?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220803
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220804
    m_Localized: 'Doctor: Uf... fue una pesadilla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220805
    m_Localized: 'Doctor: Tan pronto como empezó todo, la gente se lanzó a los hospitales. Todos querían saber desesperadamente si no eran Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220806
    m_Localized: 'Doctor: Intentamos explicar que realmente no sabíamos como hacer las pruebas para eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220807
    m_Localized: 'Doctor: Pero la gente no hacía caso. No paraban de empujar y empujar, y eso hizo imposible tratar a los que sí estaban enfermos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220808
    m_Localized: 'Doctor: Al final, llegó la AFAE y determinaron que las aglomeraciones eran una amenaza para la situación del brote...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220809
    m_Localized: 'Doctor: Así que a todo el mundo lo enviaron a las zonas de cuarentena y... los hospitales... simplemente cerraron.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220810
    m_Localized: ¿Así que AFAE te ha dejado sin trabajo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220811
    m_Localized: ¿Se ha equivocado la AFAE con eso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220812
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220813
    m_Localized: 'Doctor: A decir verdad... después de que los hospitales cerraran, me fui a trabajar a las zonas de cuarentena de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220814
    m_Localized: ¿Por qué decidiste ir allí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220815
    m_Localized: Con que eres otro de los bastardos la AFAE
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220816
    m_Localized: 'Doctor: ¿Y tú crees que estuvo bien simplemente encerrarlos a todos así?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220817
    m_Localized: 'Doctor: ¿No te parecen absurdas estas supuestas "señales"? No son más que rasgos humanos de lo más normales.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220818
    m_Localized: 'Doctor: ¡Qué absurdo! ¿Tener los dientes blancos significa que eres un Visitante? ¡Por favor!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220819
    m_Localized: 'Doctor: Te aseguro que algo nos ocultan...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220820
    m_Localized: 'Doctor: A decir verdad... después de que los hospitales cerraran, me fui a trabajar a las zonas de cuarentena de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220821
    m_Localized: 'Doctor: Tenía la esperanza de averiguar algo sobre los Visitantes y sus rasgos. Pero... no sirvió de nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220822
    m_Localized: ¿Por qué decidiste ir allí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220823
    m_Localized: Con que eres otro de los bastardos la AFAE
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220824
    m_Localized: 'Doctor: Yo... quería seguir ayudando a la gente. Es mi vocación. No podía simplemente ignorarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220825
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220826
    m_Localized: 'Doctor: Quizá... No. Perdóname, todavía no estoy listo para hablar de ello.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220827
    m_Localized: 'Doctor: Te equivocas al decir que soy un bastardo. No conoces toda la historia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220828
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220829
    m_Localized: 'Doctor: Quizá... No. Perdóname, todavía no estoy listo para hablar de ello.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220830
    m_Localized: 'Doctor: Te escucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220831
    m_Localized: Entonces, ¿qué era lo que querías contarme?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220832
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220833
    m_Localized: 'Doctor: ¿Puedo preguntarte, qué piensas de la AFAE?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220834
    m_Localized: Creo que la AFAE está haciendo un buen trabajo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220835
    m_Localized: No me fío de la AFAE
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220836
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220837
    m_Localized: 'Doctor:  Es una pena. Yo siento todo lo contrario.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220838
    m_Localized: 'Doctor: Trabajé con ellos un tiempo, pero no tengo motivos para fiarme. Especialmente después de lo que vi allí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220839
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220840
    m_Localized: 'Doctor: Te digo por experiencia que en esa agencia le ocultan la verdad a los médicos por completo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220841
    m_Localized: 'Doctor: ¿De verdad te fías en una organización que ni siquiera puede explicar de dónde vienen esas señales, o qué significan?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220842
    m_Localized: 'Doctor: Con todo lo que ha pasado... ¿cómo puedes seguir fiándote de la AFAE?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220843
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220844
    m_Localized: 'Doctor: Tengo que admitir que pensaba que eras más avispado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220845
    m_Localized: 'Doctor: Bien. Yo tampoco me fío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220846
    m_Localized: 'Doctor: Sinceramente, ni yo mismo entiendo qué pretenden en la AFAE. Incluso después de trabajar con ellos un tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220847
    m_Localized: 'Doctor: Pero sea lo que sea que los impulse, yo decidí ayudar a la gente a mi manera, yendo en contra de sus reglas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220848
    m_Localized: 'Doctor: El problema era la transparencia. No había ninguna. Nada de nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220849
    m_Localized: 'Doctor: Nunca nos explicaron de dónde salían esas "señales", ni qué se suponía que significaban.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220850
    m_Localized: 'Doctor: Solo nos dieron una lista para saber a quiénes diagnosticar como Visitantes y a quiénes no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220851
    m_Localized: 'Doctor: Después de eso, ya no me sentía un doctor. Parecía más bien un guardia de frontera sellando papeles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220852
    m_Localized: 'Doctor: Así que comencé a falsificar informes y ayudé a algunas personas a escapar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220853
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220854
    m_Localized: 'Doctor: Seguro que todavía tienes preguntas. Pero si no te importa, podemos dejar el resto para mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713912
    m_Localized: 'Doctor: Lo siento, pero no estoy para hablar más por hoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713913
    m_Localized: 'Doctor: Ahí fue cuando decidí dejar la organización.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220855
    m_Localized: 'Doctor: Te escucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220856
    m_Localized: ¿Y cómo es que no te quedaste en una zona de cuarentena?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220857
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220858
    m_Localized: 'Doctor: Fue... por un incidente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220859
    m_Localized: 'Doctor: Estaba amaneciendo. Iba camino a casa cuando uno de los oficiales de la AFAE me llamó a gritos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220860
    m_Localized: 'Doctor: En ese momento, el corazón me empezó a latir con fuerza y casi me fallan las rodillas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220861
    m_Localized: 'Doctor: Me gritó que me girara. Sentí que iba a morir en ese mismo instante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220862
    m_Localized: 'Doctor: Apuntó su fusil a mis piernas y me dijo que no me moviera. Se me quedó mirando, y luego...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220863
    m_Localized: 'Doctor: Me dijo que sacara la lengua, que necesitaba comprobar si era un Visitante. Y lo hice, aterrado de que me pegara un tiro si no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220864
    m_Localized: 'Doctor: Y entonces... se rio. Dijo que debía ser un médico nefasto si no sabía que la lengua no era una señal de ser un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220865
    m_Localized: 'Doctor: Nunca había sentido tanto miedo por mi vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220866
    m_Localized: 'Doctor: En ese momento no pensaba en salvarle la vida a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220867
    m_Localized: 'Doctor: Solo eché a correr. Como un cobarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220868
    m_Localized: 'Doctor: La vergüenza que pasé... es insoportable. Vergüenza ante los que se quedaron allí. Ante mí mismo. Ante todos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220869
    m_Localized: No te juzgo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220870
    m_Localized: Pero aún puedes ayudar a la gente
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220871
    m_Localized: Eres un cobarde patético. Lárgate de mi casa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220872
    m_Localized: 'Doctor: Gracias por entenderlo. Eso... me hace sentir un poco mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220873
    m_Localized: 'Doctor: No puedo dejar de pensar en cuántas vidas más podría haber salvado, si me hubiese quedado ahí hasta el final...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220874
    m_Localized: 'Doctor: Me temo que no puedo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220875
    m_Localized: 'Doctor: Dejé todos mis instrumentos en la zona de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220876
    m_Localized: 'Doctor: Así que... ahora soy completamente inútil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220877
    m_Localized: 'Doctor: Sé que esperabas un tratamiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220878
    m_Localized: 'Doctor: Pero, ¿qué puede hacer un viejo como yo sin nada más que sus propias manos? Casi nada...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220879
    m_Localized: 'Doctor: Siento haberte defraudado. Me temo que no tengo poder contra la amenaza de los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220880
    m_Localized: No te preocupes, puedes quedarte de todos modos
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220881
    m_Localized: Pues, ahí está la puerta. No la vayas a tirar al salir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220882
    m_Localized: 'Doctor: Supongo que tienes razón. Debería irme...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220883
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220884
    m_Localized: 'Doctor: Adiós'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220885
    m_Localized: 'Doctor: Gracias por entenderlo. Eso... me hace sentir un poco mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220886
    m_Localized: 'Doctor: Me imagino que la AFAE habría descubierto los informes falsos tarde o temprano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220887
    m_Localized: 'Doctor: Y aun así, no puedo sacudirme la idea de que pude haber dado mi vida y salvado a más personas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220888
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220889
    m_Localized: 'Doctor: Me temo que esa carga me perseguirá por el resto de mis días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220890
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220891
    m_Localized: 'Doctor: Supongo que tienes razón. Este no es lugar para un viejo como yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220892
    m_Localized: 'Doctor: Adiós'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713914
    m_Localized: 'Doctor: ¿Por qué preguntas? ¿Estás intentando averiguar por qué no me fío de la AFAE?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713915
    m_Localized: 'Doctor: Empecemos con una hipótesis...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713916
    m_Localized: 'Doctor: ¿Crees que los Visitantes son una especie de virus?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713917
    m_Localized: No creo que existan
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713918
    m_Localized: No. Pero no sé qué son realmente
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713919
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713920
    m_Localized: 'Doctor: Si eso es lo que crees, no veo por qué te molestas en hacer todas estas revisiones.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713921
    m_Localized: 'Doctor: No trates de engañarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713922
    m_Localized: 'Doctor: Así que...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713923
    m_Localized: 'Doctor: Entiendo. Por desgracia, yo tampoco sé lo que son los Visitantes en realidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713924
    m_Localized: 'Doctor: Pero de algo te puedo estar seguro y es que no son un virus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713925
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713926
    m_Localized: 'Doctor: Bueno, me temo que tendré que decepcionarte. Lo más probable es que no sea el caso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713927
    m_Localized: 'Doctor: ¿Has visto a alguien que parecía estar bien cambiar de repente y convertirse en un Visitante delante de ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713928
    m_Localized: 'Doctor: Exacto. Nunca ha habido ningún caso así.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713929
    m_Localized: 'Doctor: Tienes que entender. La AFAE no tiene el control de esta situación. Solo aparentan tenerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713930
    m_Localized: 'Doctor: Cerraron los hospitales, enviaron a todos a zonas de cuarentena... ¿Pero para qué?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713931
    m_Localized: 'Doctor: ¿Están ayudando a la gente? ¿Alguien ha salido curado alguna vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713932
    m_Localized: 'Doctor: La AFAE solo agrupó a la gente, la encerró, y ahora son libres de hacer lo que les plazca.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713933
    m_Localized: ¿Entonces por qué trabajaste para la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713934
    m_Localized: Basta de tonterías. Largo de aquí
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713935
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713936
    m_Localized: 'Doctor: No podía quedarme de brazos cruzados viendo cómo mataban a la gente uno a uno.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713937
    m_Localized: 'Doctor: Por eso me uní a la AFAE, para ayudar a esas pobres almas a escapar de las zonas de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713938
    m_Localized: 'Doctor: Los examiné, hice mis diagnósticos. Y falsifiqué documentos para que pudieran escapar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713939
    m_Localized: Por tu culpa, los Visitantes pudieron haber escapado
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713940
    m_Localized: ¿A qué incidente te refieres?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713941
    m_Localized: Qué pena que tendrás que huir de aquí también.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713942
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713943
    m_Localized: 'Doctor: Es una pena que ni siquiera intentes escucharme...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713944
    m_Localized: 'Doctor: Entonces no ocuparé espacio en tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713945
    m_Localized: 'Doctor: Adiós'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713946
    m_Localized: 'Doctor: ¿Y qué preferirías? ¿Dejarlos allí para que mueran?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713947
    m_Localized: 'Doctor: Hice el juramento hipocrático. Es mi deber hacer todo lo que esté en mi mano para proteger la vida y la salud.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713948
    m_Localized: 'Doctor: Pero al final... tras un incidente, yo mismo tuve que escapar de una zona de cuarentena. Lamentablemente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713949
    m_Localized: 'Doctor: Ocurrió en la zona donde estaba asignado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713950
    m_Localized: 'Doctor: ¡¿Pero qué...?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713951
    m_Localized: 'Doctor: ¿Te piensas que no debí ayudarlos? ¿Y ahora me echas por ello?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713952
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713953
    m_Localized: 'Doctor: Jamás pensé que diría esto, pero quizás seas peor que la AFAE. Al menos ellos aparentan ayudar a la gente. Y tú...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713954
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713955
    m_Localized: 'Doctor: Ya no hay lugar para mí aquí. Temo pensar lo que pasará con los que dejas a tu cuidado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713956
    m_Localized: 'Doctor: Que te vaya bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415069
    m_Localized: 'TaxiDriver: No te cortes, hombre. Venga, pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415070
    m_Localized: ¿Aún crees que la AFAE te persigue?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415071
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415072
    m_Localized: 'TaxiDriver: Ojalá que no, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415073
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415074
    m_Localized: 'TaxiDriver: Sí, la lié yendo a la AFAE así. Tendría que haber sabido que también intentarían atraparme a mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415075
    m_Localized: 'TaxiDriver: Pensé que se llevarían al pasajero y a mí me dejarían en paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415076
    m_Localized: 'TaxiDriver: En lugar de eso, me quitaron el coche y por poco me disparan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415077
    m_Localized: 'TaxiDriver: Pero piénsalo, hombre, ¿qué se suponía que hiciera? Era un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713957
    m_Localized: ¿Y si era humano?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713958
    m_Localized: No te quedaba alternativa
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713959
    m_Localized: 'TaxiDriver: Eh... venga, no digas eso, tío.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713960
    m_Localized: 'TaxiDriver: Ya me siento fatal por lo que pasó.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713961
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713962
    m_Localized: 'TaxiDriver: Bueno... tienes razón, sabes. La verdad es que no tenía opción.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713963
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713964
    m_Localized: 'TaxiDriver: Hombre, echo de menos los días en los que te podías sentar al volante sin pensar en nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713965
    m_Localized: 'TaxiDriver: Ahora, con los Visitantes... joder, puede que el próximo pasajero decida pegarte un tiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713966
    m_Localized: 'TaxiDriver: Eh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415078
    m_Localized: 'TaxiDriver: No te cortes, hombre. Venga, pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415079
    m_Localized: ¿Desde hace cuánto tiempo eres taxista?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415080
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415081
    m_Localized: 'TaxiDriver: Pues, llevo un buen tiempo en esto, ¿sabes? Ahora no curro para ninguna empresa, soy mi propio jefe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415082
    m_Localized: 'TaxiDriver: La AFAE no deja que los civiles se muevan libremente por allí en estos días.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415083
    m_Localized: 'TaxiDriver: Pero este lío se acabará algún día, ¿no? Y pues, el dinero... el dinero siempre viene bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415084
    m_Localized: 'TaxiDriver: La gente paga muy bien por los viajes arriesgados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415085
    m_Localized: 'TaxiDriver: Y conducir de noche me trae recuerdos de cuando era un crío.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415086
    m_Localized: 'TaxiDriver: Verás... Me hice taxista por mi padre. Quería seguir sus pasos, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713967
    m_Localized: 'TaxiDriver: Aunque...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713968
    m_Localized: 'TaxiDriver: No quiero acabar en el arcén, sin que a nadie le importe una mierda... como mi padre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713969
    m_Localized: 'TaxiDriver: Solo espero que mi suerte no se haya acabado aún...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415087
    m_Localized: 'TaxiDriver: No te cortes, hombre. Venga, pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415088
    m_Localized: Hoy te veo muy de bajón
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415089
    m_Localized: Tengo que revisarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415090
    m_Localized: 'TaxiDriver: Sí, es que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415091
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415092
    m_Localized: 'TaxiDriver: Es que no supero el hecho de que mi coche ya no esté, ¿sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713970
    m_Localized: ¿Qué clase de coche tenías?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713971
    m_Localized: ¿Qué hacía a tu coche tan especial?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713972
    m_Localized: 'TaxiDriver: Joder, hombre, era el coche clásico más bonito...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713973
    m_Localized: 'TaxiDriver: Era de un amarillo brillante, tenía las llantas cromadas y unas curvas suaves...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713974
    m_Localized: 'TaxiDriver: Pero ahora ya no está...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713975
    m_Localized: 'TaxiDriver: Maldita AFAE... ¡Ese coche lo era todo para mí! ¡Cabrones!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713976
    m_Localized: 'TaxiDriver: Era el coche de mi padre. Él también conducía un taxi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713977
    m_Localized: 'TaxiDriver: De pequeño, me encantaba ir con él por las noches. Siempre me quedaba dormido atrás, así que me llevaba. Pero luego...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713978
    m_Localized: 'TaxiDriver: Se podría decir que a él se le acabó la suerte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415096
    m_Localized: 'TaxiDriver: No te cortes, hombre. Venga, pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415097
    m_Localized: ¿Qué le pasó a tu padre?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415098
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713979
    m_Localized: 'TaxiDriver: Esto no lo hablo mucho, pero... creo que puedo fiarme de ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713980
    m_Localized: 'TaxiDriver: Un día, mi madre tuvo que irse por un viaje de negocios, así que mi padre me llevó con él.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713981
    m_Localized: 'TaxiDriver: Fue entonces cuando recogimos a un pasajero que nunca olvidaré.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713982
    m_Localized: 'TaxiDriver: Era un calvo con un traje impecable y una sonrisa diabólica...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713983
    m_Localized: 'TaxiDriver: Todo el mundo en el pueblo sabía quién era. Hasta yo, siendo un crío. ¿Negarle algo a un hombre así? No era una opción.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713984
    m_Localized: 'TaxiDriver: Pero mi padre era un hombre de honor. Y su decisión... nos afectó a todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713985
    m_Localized: 'TaxiDriver: Ese demonio de traje se aseguró de que lo pagáramos caro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713986
    m_Localized: 'TaxiDriver: Perdimos nuestra casa y luego no pudimos quedarnos en un mismo lugar por mucho tiempo después.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713987
    m_Localized: 'TaxiDriver: Y como apenas teníamos dinero, mi padre conservó el taxi que había estado conduciendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713988
    m_Localized: 'TaxiDriver: En su vejez, ahogado en deudas, empezó a desear no haberlo conservado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713989
    m_Localized: 'TaxiDriver: Decía que estaba maldito. Que solo nos trajo mala suerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713990
    m_Localized: 'TaxiDriver: Pero él nunca lo entendió.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713991
    m_Localized: 'TaxiDriver: No había sido el coche. Fue su orgullo. Eso fue lo que nos costó todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713992
    m_Localized: 'TaxiDriver: Fue por sus decisiones tuve que empezar a trabajar temprano para mantener a la familia...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713993
    m_Localized: 'TaxiDriver: Lo sigo queriendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713994
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713995
    m_Localized: 'TaxiDriver: Echo de menos a mi padre...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713996
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713997
    m_Localized: 'TaxiDriver: No pido mucho, pero... si no es mucha molestia, ¿podrías, eh, llamarle?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713998
    m_Localized: 'TaxiDriver: Aquí tienes su número: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713999
    m_Localized: 'TaxiDriver: Solo dile que estoy bien. Yo lo haría, pero... ahora mismo no puedo revelar mi ubicación.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415106
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609403
    m_Localized: 'FormerFema: Espero no haberme sometido a tanta exposición solar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609404
    m_Localized: ¿Seguro que no eres de la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609405
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609406
    m_Localized: 'FormerFema: No, de verdad no estoy con ellos. Ya te lo dije, yo arreglaba neveras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609407
    m_Localized: 'FormerFema: Encontré el uniforme en un coche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609408
    m_Localized: Hace un rato dijiste que se lo cogiste a un cadáver
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609409
    m_Localized: No me estás mintiendo, ¿verdad?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609410
    m_Localized: 'FormerFema: Es que... pues sí, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609411
    m_Localized: 'FormerFema: Lo tenía puesto un muerto dentro de un coche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609412
    m_Localized: 'FormerFema: Y pensé que el uniforme me protegería de los Visitantes. Digo, los de la AFAE lo llevan por algo, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609413
    m_Localized: 'FormerFema: No te miento. Solo que el estrés hace que me confunda, ¿qué tiene eso de extraño? Nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609414
    m_Localized: 'FormerFema: Créeme, si hubieras visto las cosas que yo... lo entenderías.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609415
    m_Localized: 'FormerFema: De camino para acá casi me matan del susto los cuerpos muertos que seguían retorciéndose en el suelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609416
    m_Localized: 'FormerFema: Espero no haberme sometido a tanta exposición solar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609417
    m_Localized: ¿No te parece que llevar un traje de la AFAE es una mala idea?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609418
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609419
    m_Localized: 'FormerFema: ¿Qué? Pues... no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609420
    m_Localized: 'FormerFema: Digo, claro, a algunos no les gusta la AFAE, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609421
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609422
    m_Localized: 'FormerFema: Ahh, te refieres a que podría tener problemas con la AFAE, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609423
    m_Localized: 'FormerFema: Bueno, mira, yo... creo que si les explico todo, me van a creer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609424
    m_Localized: 'FormerFema: No hay que demonizarlos. No es como si fueran una secta secreta ni nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609425
    m_Localized: 'FormerFema: Espero no haberme sometido a tanta exposición solar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609426
    m_Localized: Enséñame qué tienes en los bolsillos
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609427
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609428
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609429
    m_Localized: 'FormerFema: Eh, ¿por qué quieres cachearme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609430
    m_Localized: Para buscar tu carné de la AFAE
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609431
    m_Localized: ¿Qué, escondes algo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609432
    m_Localized: 'FormerFema: ¿Qué? ¿De qué carné hablas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609433
    m_Localized: 'FormerFema: Lo juro, no llevo nada encima...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609434
    m_Localized: Más te vale vaciar los bolsillos por por las buenas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609435
    m_Localized: (Desenfundar tu arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609436
    m_Localized: 'FormerFema: ¿Quién? ¿Yo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609437
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609438
    m_Localized: 'FormerFema: No'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609439
    m_Localized: Venga, vacía los bolsillos por las buenas
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609440
    m_Localized: (Desenfundar tu arma)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609441
    m_Localized: 'FormerFema: Vale, vale. No hace falta ponerse así...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609442
    m_Localized: 'FormerFema: Toma. ¿Ya estás contento?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609443
    m_Localized: 'FormerFema: Vale, me has pillado. Sí que soy de la AFAE...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609444
    m_Localized: 'FormerFema: Pero, por favor, no le digas a los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609445
    m_Localized: 'FormerFema: Maldita sea...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609446
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609447
    m_Localized: 'FormerFema: Toma. Pero no dispares.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609448
    m_Localized: 'FormerFema: Sí... de verdad soy de la AFAE...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609449
    m_Localized: 'FormerFema: Pero es mejor que la gente no lo sepa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491072
    m_Localized: ¿Por qué ocultabas que eras de la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491073
    m_Localized: ¿Y a qué vino la farsa?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491074
    m_Localized: 'FormerFema: ¿De verdad no lo pillas?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491075
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491076
    m_Localized: 'FormerFema: ¡¿Me lo preguntas en serio?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491077
    m_Localized: 'FormerFema: Si la gente se entera de que trabajé para la AFAE...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491078
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491079
    m_Localized: 'FormerFema: Mira, ya no trabajo en la AFAE. Digamos que... me echaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491080
    m_Localized: 'FormerFema: Mira, ya no trabajo en la AFAE. Digamos que... me echaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491081
    m_Localized: 'FormerFema: Vale, es cierto que tuve que hacer cosas que, pues, no fueron muy buenas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491082
    m_Localized: 'FormerFema: Llevándome a gente, enviándolos a zonas de cuarentena...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491083
    m_Localized: 'FormerFema: Pero escúchame, era mi trabajo, ¿vale? Solo seguía órdenes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491084
    m_Localized: 'FormerFema: No tiene sentido preguntarme por los que nos llevamos. Eso es cosa de los de arriba, no mía.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491085
    m_Localized: 'FormerFema: Y llamarme asesino, o cualquier barbaridad... sería una total injusticia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491086
    m_Localized: 'FormerFema: ¿Y si más bien estuve salvando vidas al enviar asesinos a las zonas? ¿Entonces qué soy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609450
    m_Localized: 'FormerFema: Espero no haberme sometido a tanta exposición solar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609451
    m_Localized: ¿Por qué ocultabas que eras de la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609452
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491087
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491088
    m_Localized: 'FormerFema: Una vez me enviaron a buscar a un tío que mostraba señales de Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491089
    m_Localized: 'FormerFema: Resumiendo, el tío empeoró en la zona de cuarentena y murió. Son cosas que pasan.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491090
    m_Localized: 'FormerFema: Luego vino su mujer. Quería saber cuándo le dejaríamos salir. Le dijimos que ya no había a nadie que sacar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491091
    m_Localized: 'FormerFema: Se veía que estaba en shock. Empezó a gritar, a llamarnos asesinos, exigiendo el cuerpo de vuelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491092
    m_Localized: 'FormerFema: Le dijimos que el protocolo no lo permitía. pero eso no la detuvo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491093
    m_Localized: 'FormerFema: Se plantó en el suelo, acampando, justo fuera de la verja.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491094
    m_Localized: 'FormerFema: Así que le dimos el cuerpo y luego echaron a todos los que rompieron el protocolo. Incluyéndome.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491095
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491096
    m_Localized: 'FormerFema: Ella tenía que tener ese puñetero cuerpo. Esa zumbada me costó el curro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491097
    m_Localized: 'FormerFema: Y ahora no tengo a dónde ir...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491098
    m_Localized: 'FormerFema: Y, nada más escucha, en lugar de enterrarlo, la loca se lleva el cadáver a cuestas a todas partes con ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491099
    m_Localized: 'FormerFema: Ha merecido la pena que nos echaran a la calle a todos, ¿a que sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491100
    m_Localized: Vosotros los de la AFAE sí que sois unos capullos
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491101
    m_Localized: Ay, qué mala suerte
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491102
    m_Localized: 'FormerFema: ¡¿Perdona?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491103
    m_Localized: 'FormerFema: O sea, que yo hago mi trabajo, cumplo con mi deber, y me echan por culpa de una loca...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491104
    m_Localized: 'FormerFema: ¡¿Y tú nos llamas capullos?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491105
    m_Localized: 'FormerFema: ¿Sabes qué? Que te den. Me largo de aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491106
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491107
    m_Localized: 'FormerFema: ¡Madre mía! ¿Es que ahora todo el mundo ha perdido la cabeza?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491108
    m_Localized: 'FormerFema: No, no, eso es exactamente lo que ha pasado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491109
    m_Localized: 'FormerFema: Desde que el sol se fue a la mierda y empezaron las infecciones, todo el mundo se ha vuelto loco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491110
    m_Localized: 'FormerFema: ¿Merecía ese puñetero cadáver que nos despidieran? ¿De verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491111
    m_Localized: Bien por ella por reunirse con su marido
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491112
    m_Localized: No tendríais que haberle dado el cadáver
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491113
    m_Localized: 'FormerFema: ¿Dices que ha sido bueno que nos echaran?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491114
    m_Localized: 'FormerFema: Vosotros, los civiles, no entendéis una puñetera cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491115
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491116
    m_Localized: 'FormerFema: Tendríamos que haberle disparado, como hicimos con su marido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491117
    m_Localized: ¿Qué has dicho?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491118
    m_Localized: (Desenfundar tu arma)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491119
    m_Localized: 'FormerFema: ¿A qué viene esa mirada?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491120
    m_Localized: 'FormerFema: El protocolo dice que si un civil contaminado está en mal estado...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491121
    m_Localized: 'FormerFema: Entonces tratamos el problema en el acto, para que un Visitante no acabe en cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491122
    m_Localized: Dejarlo ir
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491123
    m_Localized: (Desenfundar tu arma)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491124
    m_Localized: 'FormerFema: Gracias por entenderlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491125
    m_Localized: 'FormerFema: No soy un asesino, solo seguía órdenes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491126
    m_Localized: 'FormerFema: Oye, ¿qué cojones estás haciendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491127
    m_Localized: 'FormerFema: Cálmate, ¡era un Visitante! ¡Y estaba en muy mal estado! No podíamos simplemente dejarlo ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491128
    m_Localized: 'FormerFema: ¡No dispares! ¡Solo seguía órdenes!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491129
    m_Localized: 'FormerFema: Yo también lo creo. Debería haber seguido el protocolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491130
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491131
    m_Localized: 'FormerFema: Vale, no te voy a aburrir más. Gracias por dejarme entrar de todos modos, incluso sabiendo que era de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491132
    m_Localized: 'FormerFema: Si algún día vuelvo a mi puesto, me aseguraré de dejar constancia de tu ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803626
    m_Localized: 'Cultist3: Debemos prepararnos para el ritual...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803633
    m_Localized: 'FatalDame: ¿Sí? Dime, cariño. ¿Hay algo que te preocupe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803634
    m_Localized: ¿Qué tal estás aquí?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803636
    m_Localized: 'FatalDame: Es acogedor. Más de lo que me esperaba... teniendo en cuenta cómo están las cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803637
    m_Localized: 'FatalDame: Gracias por dejarme entrar. Pensé que iba a quedarme en la calle antes del amanecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803638
    m_Localized: 'FatalDame: ¿Y tú? ¿Qué tal estás?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803639
    m_Localized: Ansioso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803640
    m_Localized: Estoy bien. Tenemos que sobrevivir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803641
    m_Localized: 'FatalDame: Lo entiendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803642
    m_Localized: 'FatalDame: Hoy en día... hacer planes a largo plazo parece inútil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803643
    m_Localized: 'FatalDame: Nunca se sabe qué te alcanzará antes: el sol, los dementes o los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803644
    m_Localized: 'FatalDame: Pero la humanidad ya ha sobrevivido a muchas catástrofes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803645
    m_Localized: 'FatalDame: Creo que dejaremos algún tipo de legado cuando ya no estemos aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803646
    m_Localized: 'FatalDame: Alguien encontrará rastros de nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803647
    m_Localized: 'FatalDame: Todo irá bien, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803648
    m_Localized: 'FatalDame: Me gusta esa actitud. Te sienta bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803649
    m_Localized: 'FatalDame: Pero no te lo guardes todo, ¿vale? Las emociones tienen una mala costumbre de desbordarse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803650
    m_Localized: 'FatalDame: ... Justo cuando menos lo quieres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803651
    m_Localized: 'FatalDame: No te avergüences de hablar de ello conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803652
    m_Localized: 'FatalDame: Y si no es conmigo, entonces con alquien. Quien sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803653
    m_Localized: 'FatalDame: Prométeme eso. ¿Vale?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803654
    m_Localized: 'FatalDame: ¿Sí? Dime, cariño. ¿Hay algo que te preocupe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803655
    m_Localized: Vi algo extraño anoche
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803657
    m_Localized: 'FatalDame: ¿Eh? ¿De qué me hablas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803658
    m_Localized: Tu vientre... Había crecido
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803659
    m_Localized: Nada... seguro me lo imaginé
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803660
    m_Localized: 'FatalDame: ¿Quieres decir... que estaba embarazada?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803661
    m_Localized: 'FatalDame: Vale, cariño, está bien. Me alegra que seas honesto conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803662
    m_Localized: 'FatalDame: ¿Podría ser que solo estás bajo mucha presión? Ahora mismo estás velando por otras personas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803663
    m_Localized: 'FatalDame: Yo sé, cariño. Cuando cada amanecer podría ser el último, ya es bastante difícil preocuparse por uno mismo. Ni hablar de estar pendiente de los demás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803664
    m_Localized: 'FatalDame: Ni siquiera sabes si vas a vivir mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803665
    m_Localized: Sí... eso me asusta
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803666
    m_Localized: No, no creo que sea eso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803667
    m_Localized: 'FatalDame: Pero algo te atormenta, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803668
    m_Localized: 'FatalDame: No pasa nada, cariño. El miedo nos desgasta a todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803669
    m_Localized: 'FatalDame: Te he visto, ¿sabes? cómo te levantas por las noches para hacer rondas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803670
    m_Localized: 'FatalDame: Para ser alguien tan reservado, te preocupas mucho por los que dejas entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803671
    m_Localized: 'FatalDame: Es... interesante. Eres una contradicción andante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803672
    m_Localized: 'FatalDame: O a lo mejor es solo el insomnio. El miedo es un pésimo compañero de cama.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803673
    m_Localized: Sí... eso me asusta
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803674
    m_Localized: No, no creo que sea eso
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803675
    m_Localized: 'FatalDame: Hay que tener agallas para decir eso en voz alta, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803676
    m_Localized: 'FatalDame: Pero, ¿qué podemos hacer realmente con el miedo, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803677
    m_Localized: 'FatalDame: ¿Puedes aceptar la idea... de que la vida es efímera? ¿De que vamos a morir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803678
    m_Localized: 'FatalDame: Lo importante es ¿dónde encuentras tu salvación? ¿Es que todavía existe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803679
    m_Localized: 'FatalDame: Vale'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803680
    m_Localized: 'FatalDame: De todas formas... me preocupo por ti. Cuídate a ti mismo, ¿vale, cariño?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803681
    m_Localized: 'FatalDame: Quiero que te sientas seguro. Al fin y al cabo, vivimos bajo el mismo techo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803682
    m_Localized: 'FatalDame: Pero si se te zafa una tuerca, estaremos en un aprieto... a menos que tengas un destornillador... jeje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803683
    m_Localized: 'FatalDame: Ese chiste me salió natural.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803684
    m_Localized: 'FatalDame: ¿Te hizo gracia, cariño?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803685
    m_Localized: 'FatalDame: ¿Sí? Dime, cariño. ¿Hay algo que te preocupe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803686
    m_Localized: Sé que anoche te vi embarazada. Explícate
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803688
    m_Localized: 'FatalDame: Me estás empezando a asustar un poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803689
    m_Localized: 'FatalDame: ¿Estás seguro de que realmente viste algo anoche?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803690
    m_Localized: 'FatalDame: ¿Por qué no me despertaste?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803691
    m_Localized: 'FatalDame: ¿Es el miedo hablando de nuevo? ¿Miedo a la muerte... o todo el estrés de tener invitados en tu casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803692
    m_Localized: 'FatalDame: ¿Es por mi culpa? ¿O es otra persona la que ronda por tu cabeza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803693
    m_Localized: Deja de jugar con mi cabeza
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803694
    m_Localized: Pero estoy... ¡estoy seguro de que he visto algo!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803696
    m_Localized: 'FatalDame: Mencionaste a tu padre el otro día.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803697
    m_Localized: 'FatalDame: No hemos vuelto a hablar de él desde entonces. No sé mucho, la verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803698
    m_Localized: 'FatalDame: Pero ahora... tengo la sensación de que estás siendo justo como él. Una copia exacta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803699
    m_Localized: 'FatalDame: ¿No te da miedo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803700
    m_Localized: 'FatalDame: ¿Vivir atrapado en su sombra?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803701
    m_Localized: 'FatalDame: Él está muerto para ti, ¿no? ¿Así que por qué seguir desenterrando fantasmas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803702
    m_Localized: 'FatalDame: No os encontraréis, ya sabes, al otro lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803703
    m_Localized: 'FatalDame: Igual no creo que vayáis al mismo sitio. No te preocupes, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803704
    m_Localized: 'FatalDame: No busques todas las respuestas a la vez. Los caminos se construyen una piedra a la vez. ¿Me entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803705
    m_Localized: 'FatalDame: Y por favor... no vuelvas a hablarme así.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803706
    m_Localized: 'FatalDame: Me duele verte así.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803707
    m_Localized: 'FatalDame: Pero no deberías temer a la muerte. Ni a la responsabilidad. Ni a la cercanía. Ni a nada más.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803708
    m_Localized: 'FatalDame: Es parte de la vida, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803709
    m_Localized: 'FatalDame: No busques todas las respuestas a la vez. Los caminos se construyen piedra a piedra, cielo. ¿Me sigues?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803710
    m_Localized: 'FatalDame: No sé si te sea de ayuda, pero piensa que no nos esfumamos y ya cuando cae el telón.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803711
    m_Localized: 'FatalDame: Antes creía en el cielo y el infierno. ¿Ahora? Ya no estoy tan segura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803712
    m_Localized: 'FatalDame: Quizás vayamos a un sitio completamente distinto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803713
    m_Localized: 'FatalDame: ¿Tú qué crees?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803714
    m_Localized: 'FatalDame: ¿Sí? Dime, cariño. ¿Hay algo que te preocupe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803715
    m_Localized: Estás embarazada y vas a dar a luz pronto, ¿cierto?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803717
    m_Localized: 'FatalDame: Oh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803719
    m_Localized: 'FatalDame: La desesperación te ha atrapado, ¿a que sí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803720
    m_Localized: 'FatalDame: Todo aquello en lo que creías se está desmoronando... y eres incapaz de aceptarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803721
    m_Localized: 'FatalDame: ¿Es porque no quieres ir adonde quiera que nos dirigimos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803722
    m_Localized: 'FatalDame: ¿O es que ya no perteneces a este mundo? ¿O a ningún otro, en realidad?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803723
    m_Localized: No me refiero a eso. Estás embarazada
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803724
    m_Localized: ¿No tienes miedo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803725
    m_Localized: 'FatalDame: Ay, cariño... ¿pero cómo eso sería posible? Ni siquiera tengo panza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803727
    m_Localized: 'FatalDame: ¿Te puedo preguntar algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803728
    m_Localized: 'FatalDame: Si este bebé es real...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803729
    m_Localized: 'FatalDame: Y si, como dices, viene pronto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803730
    m_Localized: 'FatalDame: ¿Qué vas a hacer? ¿Lo vas a cuidar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803731
    m_Localized: No debería existir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803732
    m_Localized: Aún no lo he decidido
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803733
    m_Localized: 'FatalDame: Vaya. Buena pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803734
    m_Localized: 'FatalDame: Morir es aterrador, desde luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803735
    m_Localized: 'FatalDame: Sobre todo porque no sé qué viene después, no realmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803736
    m_Localized: 'FatalDame: El cielo, la reencarnación, o algo completamente diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803737
    m_Localized: 'FatalDame: Nadie ha vuelto para contarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803738
    m_Localized: 'FatalDame: Pero, sobre esa visión tuya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803739
    m_Localized: 'FatalDame: Si este bebé es real...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803740
    m_Localized: 'FatalDame: Y si, como dices, viene pronto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803741
    m_Localized: 'FatalDame: ¿Qué vas a hacer? ¿Lo vas a cuidar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803742
    m_Localized: No debería existir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803743
    m_Localized: Aún no lo he decidido
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803744
    m_Localized: 'FatalDame: A veces el instinto quiere preservar lo que es familiar... aunque ya no te sirva.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803745
    m_Localized: 'FatalDame: Quizá...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803746
    m_Localized: 'FatalDame: ¿Quizá es hora de que abras los ojos a algo nuevo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803747
    m_Localized: 'FatalDame: ¿O es que lo desconocido te asusta tanto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803748
    m_Localized: Encontraré a ese bebé
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803749
    m_Localized: Ya viene. Estoy seguro
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803750
    m_Localized: 'FatalDame: No deberías tener miedo de dejar ir las cosas. Sobre todo cuando han dejado de servirte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803751
    m_Localized: 'FatalDame: A veces nos aferramos a algo solo porque nos resulta familiar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803752
    m_Localized: 'FatalDame: Y sí, romper con los hábitos duele... pero ¿quién sabe a qué podría llevar eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803753
    m_Localized: Encontraré a ese bebé
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803754
    m_Localized: Ya viene. Estoy seguro
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803756
    m_Localized: 'FatalDame: Si tú lo dices, cariño.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803758
    m_Localized: 'FatalDame: Cuéntame qué encuentras... cuando llegue el momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713856
    m_Localized: 'Neighbour: Vale, eso es todo por hoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713857
    m_Localized: 'Neighbour: Ah, es verdad, casi lo olvido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713858
    m_Localized: 'Neighbour: Mañana por la noche vuelvo a casa. Anota mi número, recién pusieron la línea allí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713859
    m_Localized: 'Neighbour: {0}. Seguimos en contacto por teléfono.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713860
    m_Localized: 'Neighbour: Vale, ahora sí que es todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713861
    m_Localized: 'Neighbour: Échate una cerveza y vete a dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491133
    m_Localized: 'Cat: ¡Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491134
    m_Localized: Acariciar al gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491135
    m_Localized: Coger al gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491136
    m_Localized: Dar al gato un poco de comida enlatada
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491137
    m_Localized: 'Cat: (Alargas la mano y acaricias al gato)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491138
    m_Localized: 'Cat: (Es difícil saber si le gusta o no)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491139
    m_Localized: 'Cat: ¡Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491140
    m_Localized: Acariciar al gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491141
    m_Localized: Coger al gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491142
    m_Localized: Dar al gato un poco de comida enlatada
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491143
    m_Localized: 'Cat: (Decides acariciar al gato)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491144
    m_Localized: 'Cat: (Aparentemente, eso le agrada)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491145
    m_Localized: 'Cat: (No es tan gruñón como creías que iba a ser)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491146
    m_Localized: 'Cat: (Parece que se está empezando a acostumbrar a ti)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491147
    m_Localized: 'Cat: ¡Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491148
    m_Localized: Acariciar al gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491149
    m_Localized: Coger al gato
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491150
    m_Localized: Dar al gato un poco de comida enlatada
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491151
    m_Localized: 'Cat: (El gato disfruta mucho de que lo acaricien tan a menudo)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491152
    m_Localized: 'Cat: (Te da la sensación de que ahora se inclina hacia tu tacto)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491153
    m_Localized: 'Cat: (Pero, ¿cómo podrías negarte a semejante monada?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491154
    m_Localized: 'Cat: ¡Miau! ¡MIAU! ¡Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491155
    m_Localized: 'Cat: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491156
    m_Localized: 'Cat: (Su carita es difícil de leer, pero estás bastante seguro de que está feliz)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491157
    m_Localized: 'Cat: (Tienes la extraña sensación de que esta noche dormirás plácidamente)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491158
    m_Localized: 'Cat: (Como si tu peludo amigo te hubiera compartido una de sus vidas para agradecerte)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491159
    m_Localized: 'Cat: (Quién sabe... puede que la muerte no pase por tu casa esta noche)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547465932800
    m_Localized: 'Teacher: Pobrecitos...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292928
    m_Localized: ¿Te pasa algo?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292929
    m_Localized: Necesito examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292930
    m_Localized: 'Teacher: ¿Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292931
    m_Localized: 'Teacher: Solo... solo estaba pensando...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292932
    m_Localized: 'Teacher: Si esto no es una extinción masiva, si logramos sobrevivir a esto... ¿qué nos espera cuando todo acabe?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292933
    m_Localized: 'Teacher: ¿Qué clase de futuro nos aguarda?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292934
    m_Localized: ¿Temes no tener cabida en el nuevo mundo por ser bondadosa?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292935
    m_Localized: Una persona tan bondadosa como tú no durará mucho estos días. Debes buscar a alguien que te proteja
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292936
    m_Localized: 'Teacher: Dices que soy... bondadosa...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292937
    m_Localized: 'Teacher: No puedo estar del lado de la violencia. No estoy hecha para eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292938
    m_Localized: 'Teacher: No sé si tenga un lugar... en... ¿cómo lo has llamado...? En el "nuevo mundo".'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292939
    m_Localized: ¿Entonces qué? ¿Es que planeas tumbarte y morir?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292940
    m_Localized: ¿Y tú qué sugieres?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292941
    m_Localized: A todos nos han tocado tiempos oscuros antes... esto no es nada nuevo
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292942
    m_Localized: 'Teacher: No quiero. Aunque alguien me proteja...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292943
    m_Localized: 'Teacher: Los asesinatos no cesarán. La violencia no desaparecerá.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292944
    m_Localized: ¿Así que supongo que el plan es tumbarte y morir?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292945
    m_Localized: ¿Entonces qué? ¿Planeas tumbarte y morir?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292946
    m_Localized: A todos nos han tocado tiempos oscuros antes... esto no es nada nuevo
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292947
    m_Localized: 'Teacher: Me siento tan perdida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292948
    m_Localized: 'Teacher: ¿De verdad vamos a vivir rodeados de asesinos?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292949
    m_Localized: 'Teacher: ¿Los niños van a aprender cosas de los asesinos y los malvados en este nuevo mundo?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292950
    m_Localized: No es momento de estarte lamentando
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292951
    m_Localized: ¡BASTA, ESPABILA!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292952
    m_Localized: 'Teacher: No... no lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292953
    m_Localized: 'Teacher: Ya no tengo nada que ofrecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292954
    m_Localized: 'Teacher: Solo... quiero que esto acabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292955
    m_Localized: 'Teacher: Yo... es que no doy más.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292956
    m_Localized: 'Teacher: Sí, es verdad. Pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292957
    m_Localized: 'Teacher: ¿Cómo vamos a vivir ahora?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292958
    m_Localized: 'Teacher: La gente se ha vuelto loca, matando a cualquiera que parezca... diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292959
    m_Localized: 'Teacher: No importa quién se ponga por delante.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292960
    m_Localized: No es momento de estarte lamentando
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292961
    m_Localized: ¡BASTA, ESPABILA!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292962
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292963
    m_Localized: 'Teacher: ¿Por qué no?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292964
    m_Localized: 'Teacher: Puede que ser indiferente te ayude a ti. Pero yo no puedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292965
    m_Localized: 'Teacher: Si tan solo pudieras ver lo que yo he visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292966
    m_Localized: 'Teacher: Se ha... grabado en mis ojos para siempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292967
    m_Localized: 'Teacher: Fuego. Gritos. Rostros colmados de ira, de terror. Hogares destruidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292968
    m_Localized: 'Teacher: No puedo ser como tú. No soy así de fuerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292969
    m_Localized: 'Teacher: Para mí... solo queda una opción.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292970
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292971
    m_Localized: 'Teacher: (La mujer se sobresalta, mirándote con miedo)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292972
    m_Localized: 'Teacher: (La confusión hizo que olvidase las pesadillas, pero solo por un instante)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292973
    m_Localized: 'Teacher: (Se cubre la cara con las manos y llora en silencio)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292974
    m_Localized: 'Teacher: (No sabes qué hacer. Nadie te enseñó cómo lidiar con estas cosas)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292975
    m_Localized: 'Teacher: (Con cuidado, pones una mano en su hombro y te quedas así un rato)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292976
    m_Localized: 'Teacher: (Puede que lo mejor sea dejarla sola)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487232
    m_Localized: 'Mother: Oye, ¿sabes qué? Tal vez deberías llamarle. {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487233
    m_Localized: 'Mother: Dile lo que piensas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487234
    m_Localized: 'Mother: A fin de cuentas, también son sus hijos. Tendría que ayudar a buscarlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487235
    m_Localized: 'Anger: Por favor, ¿podrías llamarla por mí? Este es su número: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487236
    m_Localized: 'Anger: Solo dile que... lo siento mucho... que todavía quiero cortarme la garganta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487237
    m_Localized: 'Anger: O puedes gritarle... No lo sé... a lo mejor así es un poco más fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487238
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875840
    m_Localized: 'FortuneTeller: A algunos les resulta útil recibir orientación del otro lado...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875841
    m_Localized: 'FortuneTeller: Hay gente... expertos... que saben cómo purificar la oscuridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875842
    m_Localized: 'FortuneTeller: Si quieres, te puedo dar el contacto. Percibo que te podría ser de ayuda...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875843
    m_Localized: 'FortuneTeller: Este es el número: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875844
    m_Localized: 'FortuneTeller: Recuerda decirles que yo te he enviado... ¡Que no se te olvide!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547533041664
    m_Localized: 'Alkonost: ¿Podrías llamarle, si no es mucha molestia? {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235968
    m_Localized: 'Foreigner: (Te entrega un trozo de papel con un número de teléfono escrito: {0})'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235969
    m_Localized: 'Foreigner: (Es posible que sea el número de una embajada)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818880
    m_Localized: 'Jacob: Joder, qué sed tengo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818881
    m_Localized: ¿Qué querías decir con eso de ser "inmortales"?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818882
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818883
    m_Localized: 'Jacob: Bueno... podrías pegarte un tiro en la cabeza y comprobarlo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818884
    m_Localized: 'Jacob: Pero yo no lo haría, si fuera tú.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818885
    m_Localized: 'Jacob: No, claro que no somos inmortales de la forma en que lo estás pensando.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818886
    m_Localized: 'Jacob: Después de la muerte, reencarnamos y vivimos otra vez. Luego, volvemos a morir, repitiendo el ciclo de renacimiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818887
    m_Localized: 'Jacob: Sé cómo suena, pero si hubieras visto lo que yo he visto... lo entenderías.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818888
    m_Localized: 'Jacob: Tal vez los Visitantes fueron humanos alguna vez y después renacieron.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818889
    m_Localized: 'Jacob: No puedo asegurarlo. No sé cómo coño funciona esto...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818890
    m_Localized: 'Jacob: Pero estoy seguro de que la naturaleza nos oculta muchísimos secretos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818891
    m_Localized: 'Jacob: Encontraré a mi hija algún día.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818892
    m_Localized: 'Jacob: No sé en qué vida será... pero lo haré.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818893
    m_Localized: 'Jacob: Porque nunca vamos a morir, no realmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818894
    m_Localized: 'Jacob: Joder, qué sed tengo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818895
    m_Localized: ¿Por qué te busca la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818896
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818897
    m_Localized: 'Jacob: Porque estuve en el epicentro de toda esta mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818898
    m_Localized: 'Jacob: En las tierras de donde salieron arrastrándose esas cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818899
    m_Localized: 'Jacob: ¿Recuerdas esas absurdas leyendas urbanas sobre demonios a las afueras de la ciudad?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818900
    m_Localized: 'Jacob: Pues, da igual, ahora nadie recuerda esas cosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818901
    m_Localized: 'Jacob: Resulta que no eran leyendas y la AFAE lo sabía desde el principio.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818902
    m_Localized: 'Jacob: Dijeron que no había nada sobrenatural cociéndose allí.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818903
    m_Localized: 'Jacob: Y ahora el sol está quemando a todo el mundo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818904
    m_Localized: 'Jacob: ¡Mientras los monstruos del subsuelo se cargan a los supervivientes!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818905
    m_Localized: 'Jacob: Básicamente, la AFAE se dio cuenta de que lo habían fastidiado a lo grande...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818906
    m_Localized: 'Jacob: Y ahora están encubriendo su incompetencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818907
    m_Localized: 'Jacob: Yo solo estaba en el lugar equivocado en el momento equivocado.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818908
    m_Localized: 'Jacob: Joder, qué sed tengo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818909
    m_Localized: ¿Cómo te las has apañado para sobrevivir?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818910
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818911
    m_Localized: 'Jacob: Soy inmortal. ¿Se te ha olvidado?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818912
    m_Localized: 'Jacob: No sé...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818913
    m_Localized: 'Jacob: Yo también me lo pregunto.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818914
    m_Localized: 'Jacob: A lo mejor ha sido la suerte, o quizás algún poder superior me protege...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818915
    m_Localized: 'Jacob: Dios, o en lo que sea que creas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818916
    m_Localized: 'Jacob: O a lo mejor ya he muerto y esta es mi nueva vida. No lo sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818917
    m_Localized: 'Jacob: Buena pregunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818918
    m_Localized: 'Jacob: Es una lástima que yo no esté armado, o yo te estaría diciendo eso a ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818919
    m_Localized: 'Jacob: Y qué mal que todo lo que tienes es cerveza.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818920
    m_Localized: 'Jacob: Si tuviese un alambique, prepararía un lote muy bueno.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818921
    m_Localized: 'Jacob: Joder, qué sed tengo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818922
    m_Localized: ¿Qué más sabes?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818923
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818924
    m_Localized: 'Jacob: Me sé toda la estructura de la AFAE de cabo a rabo:'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818925
    m_Localized: 'Jacob: Quién responde a quién, quién hace qué, quién se la lía a quién. Lo sé todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818926
    m_Localized: 'Jacob: Y esos canallas sabían todo de los Visitantes, sabían lo peligrosos que eran...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818927
    m_Localized: 'Jacob: Y aún así dejaron que entraran en la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818928
    m_Localized: 'Jacob: Porque a nadie le importaba una mierda nuestra seguridad.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818929
    m_Localized: 'Jacob: Lo único que hacían era blanquear dinero del gobierno.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818930
    m_Localized: 'Jacob: Y quien viera su chapuza se convertía en una víctima también.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818931
    m_Localized: 'Jacob: La organización no quería que nadie más se enterara.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818932
    m_Localized: 'Jacob: Y esto fue incluso antes de las zonas de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818933
    m_Localized: 'Jacob: A duras penas logré escapar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818934
    m_Localized: 'Jacob: ¿Quieres un dato confidencial? Pues aquí está...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818935
    m_Localized: 'Jacob: Todo es culpa de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818936
    m_Localized: 'Jacob: ¿Todo lo que dicen en la tele? Pura mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818937
    m_Localized: 'Jacob: Si existe algo peor que los Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818938
    m_Localized: 'Jacob: Es la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818939
    m_Localized: 'Jacob: Joder, qué sed tengo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818940
    m_Localized: ¿De dónde salieron los Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818941
    m_Localized: Quiero examinarte
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818942
    m_Localized: 'Jacob: De las afueras.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818943
    m_Localized: 'Jacob: Lo sé, las zonas de cuarentena están bastante lejos de allí...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818944
    m_Localized: 'Jacob: Pero estoy seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818945
    m_Localized: 'Jacob: No soy supersticioso, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818946
    m_Localized: 'Jacob: Son los mismos demonios de los que la gente hablaba hace dos años.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818947
    m_Localized: 'Jacob: No sé cómo se metieron en la ciudad...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818948
    m_Localized: 'Jacob: Pero sí sé quién los dejó entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818949
    m_Localized: 'Jacob: La AFAE...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818950
    m_Localized: 'Jacob: Los Visitantes no son alienígenas, como muchos creen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818951
    m_Localized: 'Jacob: Son criaturas, igual que tú y yo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818952
    m_Localized: 'Jacob: ¡Y son tan nativos de este planeta como nosotros!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818953
    m_Localized: 'Jacob: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818954
    m_Localized: 'Jacob: Ya no puedo quedarme más tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818955
    m_Localized: 'Jacob: Necesito encontrar a mi hija.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818956
    m_Localized: 'Jacob: Gracias... inmortal.'
    m_Metadata:
      m_Items: []
  - m_Id: 53577620711792640
    m_Localized: 'Player: (Parece que la conversación ha llegado a su fin)'
    m_Metadata:
      m_Items: []
