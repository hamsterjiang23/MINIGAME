    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701406
    m_Localized: 'Cultist3: Mostrei-te tudo. Agora, vou tratar dos preparativos.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701407
    m_Localized: 'Cultist3: Deixa que toda a gente faça o seu trabalho.'
