%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_pt-PT
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pt-PT
  m_SharedData: {fileID: 11400000, guid: 9ca4ee10b5b962b4993a5133922046c2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377490604032
    m_Localized: 'Firefighter: *cof* Claro, pá. Não tenho nada a esconder. Já ardeu tudo há muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769856
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: Ouvidos
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: Dá uma olhada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: 'Firefighter: Não *cof* sejas muito duro a julgar. O fumo não é propriamente o melhor dentista.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: Vê lá... *cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: 'Firefighter: Como dois troncos queimados. Mas as unhas estão limpas. Irónico, não?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: Sem problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: 'Firefighter: Viste? *cof* Vermelhos como brasas. É do fumo, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: 'Firefighter: Tens a certeza? Não é uma coisa bonita de se ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: 'Firefighter: Está tudo queimado. A minha pele parece uma casca de árvore seca. Só levanto os braços se for mesmo preciso. É doloroso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: 'Firefighter: Sim, claro. Só vais ver mais um cadáver carbonizado da floresta. É sempre assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: Gostas? *cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: 'Firefighter: Bem, é simples. Estão esturricados até à cartilagem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: 'Firefighter: Vou acabar por perder a audição em breve. Talvez até seja melhor assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: 'Firefighter: Dispara logo, pá. Só não apontes aos dentes, que já estão a dar as últimas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: 'Firefighter: Bem, não tenho medo de nada. Se for algo que torna as coisas mais fáceis para ti, força, dispara.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: Talvez assim até seja mais fácil...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: 'Firefighter: Fazes sequer a mínima ideia pelo que estas mãos já passaram?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: 'Firefighter: Se esta foto é uma sentença, então *cof* vamos acabar com isto. Já não há nada que me prenda aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: 'Firefighter: Tudo arde... Acho que chegou a minha hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: 'Firefighter: Sabes, *cof* nunca consegui que os meus filhos escovassem os dentes todos os dias. Agora não há ninguém que os relembre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: 'Firefighter: Antes, eu *cof* salvava pessoas com estas mãos. Agora, nem sequer consigo segurar em condições numa caneca.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: Pronto, então é assim que são as coisas...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: Bem, chegou a minha vez de morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: 'Firefighter: Quando a floresta está a arder *cof*... só a vês a transformar-se em cinzas. E sabes que não podes fazer nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: 'Firefighter: Às vezes, acordo à noite a sentir que a pele está literalmente a rasgar-se. Nada ajuda. O fogo tirou-me tudo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: 'Firefighter: Só a memória escapa ao fogo. O corpo é só uma questão de tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: 'Firefighter: Quando tens fogo a arder à tua volta, dás valor a este silêncio. Os teus ouvidos podem estar bem, mas e a tua alma?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: 'Wheelchair: Está bem. Vá, faz lá os teus testes, então. Passo em todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964176
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964177
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964178
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964179
    m_Localized: Ouvidos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: Vê lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: Estes dentes são um verdadeiro tesouro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: 'Wheelchair: Não são dentes, são ouro! Não todos, claro, mas virão mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: 'Wheelchair: Se soubesses como é fácil abrir uma cerveja com os dentes da frente...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: Até mesmo sem qualquer ajuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: 'Wheelchair: Pelo menos ainda tenho mãos. Já é motivo para estar grato.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: 'Wheelchair: Sem elas, nem sequer conseguiria deslocar-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: Espera aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: Os meus dedos desapareceram!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: 'Wheelchair: Ontem só havia um em falta. Para onde foram os outros?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: 'Wheelchair: Ah, eles voltam a crescer. É só preciso um pouco de tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: O meu dedo desapareceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: 'Wheelchair: Não é nada de extraordinário, mas não deixa de ser desagradável.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: 'Wheelchair: MAS A MINHA UNHA JÁ CRESCEU UM BOCADINHO, VÊS?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: 'Wheelchair: O que quer dizer que as pernas também vão voltar a crescer. É só preciso um pouco de tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: 'Wheelchair: Para onde é que olho? Para ti?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: 'Wheelchair: Viste aquele espasmo? É vício.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: 'Wheelchair: Desde os tempos em que ainda dava para acelerar um motor, que não via mais... enfim, nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: 'Wheelchair: Acho que ainda não estou pronto para abrandar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: Ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: 'Wheelchair: Bem, força nisso. HAHAHAHA, está bem, está bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: Atingimos o auge da comédia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: 'Wheelchair: Pedes-me que te mostre as axilas, e eu mostro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: 'Wheelchair: O inferno está a arder lá fora, o universo quer eliminar o planeta...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: Os Visitantes querem acabar connosco.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: 'Wheelchair: E tu: "Mostra-me as tuas axilas!"'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: HAHAHAHA.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: Uma fotografia?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: 'Wheelchair: Não é bem a minha cena, mas tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: Raios, pisquei.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: 'Wheelchair: HAHAHAHA! Okaaay!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: Também recebeste aquela transmissão, não foi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: 'Wheelchair: Pois, pois. Hm? Não foi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: Espera, estás a falar a sério?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: Isto é... marado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: 'Wheelchair: Ouve, não te vou roubar mais cerveja. Não leves a mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: Sabes o que fazemos com quem fica todo irritado?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: Atropelamos com os carrinhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: 'Wheelchair: Se vais ficar chateado, então leva-me a dar uma voltinha.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: Porquê?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: Isso não me vai ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: 'Wheelchair: Nem a ti, provavelmente. Então, para que é a arma?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: 'Wheelchair: Provavelmente não vou conseguir acompanhar a velocidade da bala. Mas posso tentar desviar-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: 'Wheelchair: Nunca percebi por que raio é que as pessoas se depilam. O pelo é a defesa natural do corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: 'Wheelchair: Vês aquela parte vermelha? Estão a crescer-me dedos ali. Sobressalentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: 'Wheelchair: Ah, a verdadeira comédia ainda nem começou.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: 'Wheelchair: Onde foi que errámos nesta vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: 'Wheelchair: Para que é a fotografia? Conheces aquele ditado que diz "Enquanto houver vida, há esperança"?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: 'Wheelchair: Havia algo que queria dizer...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: Posso simplesmente ir embora?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: 'Wheelchair: Bem, acho que é merecido.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: 'Wheelchair: Mais cedo ou mais tarde, Deus vai acabar por levar-te.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: Jamais cairei em silêncio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: 'Wheelchair: Está tudo programado no nosso ADN, não é?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: 'Wheelchair: Por que raio é nos que ríamos de tudo isto antes e, agora, estamos prontos a rebentar os miolos uns dos outros?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: Preciso de me preparar para morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: As minhas mãos são o meu único motor agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: E não tenho embraiagem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: 'Wheelchair: Para ser honesto, a ideia de um dia as perder também me assusta. E depois, o que acontece?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: 'Wheelchair: Odiava ficar sem qualquer forma de me deslocar. Preso para sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: Nem a morte me assusta assim tanto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: 'Wheelchair: Seja como for que olhemos para isto, já não é possível acompanhar o tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: 'Wheelchair: Já reparaste como o tempo acelera com a idade?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: 'Wheelchair: Quando éramos miúdos, não havia pressa em viver. Tudo era simples. Sem responsabilidades ou decisões difíceis.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: 'Wheelchair: Mas agora, por mais que nos apressemos, parece que nunca conseguimos acompanhar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: 'Wheelchair: Sabes, de alguma forma, já não me apetece rir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: Os teus testes ridículos, armado em bombeiro a apagar fogos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: 'Wheelchair: Toda a gente quer salvar o mundo, mas ninguém se entende sobre como fazê-lo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: 'Wheelchair: E será que faz sentido? Talvez devêssemos só relaxar e não stressar com isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: Olha...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: Não achas que a nossa viagem já acabou?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: 'Wheelchair: É o fim da linha. Vamos todos partir em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: Dá para ver a última paragem pela janela.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: Estás pronto para isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: 'Wheelchair: Era o que eu pensava. Não fiques chateado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: 'Wheelchair: Se... Se não podes confiar neste sinal, como posso eu confiar neles?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: 'Wheelchair: Talvez todos eles indiquem a presença de Visitantes com a mesma precisão.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: 'Wheelchair: As pessoas cometem erros, sabes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: 'Wheelchair: Mas esses erros podem ter consequências terríveis.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: 'Wheelchair: Se... Se estás a confiar neste sinal, como posso eu confiar nos anteriores?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: 'Wheelchair: Talvez os outros também sejam uma porcaria.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: 'Wheelchair: Somos humanos, claro. Erramos, é só isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: 'Wheelchair: Mas esses erros podem ter consequências terríveis.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: 'Wheelchair: Tu... Um único movimento chega para tudo correr mal e acabares com a vida de alguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: 'Wheelchair: Se estás assim tão seguro da tua escolha... invejo a tua confiança.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: 'Mother: Força, põe-me à prova. Não tenho nada a esconder.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: Ouvidos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: Está à vontade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: 'Mother: Sabes, nunca lhes prestei muita atenção. Simplesmente, não tinha tempo. Mas agora... Agora arrependo-me disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964303
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964304
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: Vê lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: 'Mother: São umas meras pás, em vez de palmas. Tudo pelas crianças.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964307
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964308
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: Vê lá, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: 'Mother: Vês estas olheiras enormes? Chama-se falta de sono...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964311
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964312
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: Vê lá, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964314
    m_Localized: 'Mother: Fiquei sem desodorizante há séculos. Não me julgues.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964315
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964316
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: 'Mother: Posso sentar-me? Não?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964318
    m_Localized: 'Mother: Despenteada e rabugenta, como sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964319
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964320
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: 'Mother: Não os limpo há imenso tempo. Neste momento, devem estar entupidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: 'Mother: Já estou um pouco surda com os gritos dos miúdos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964323
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964324
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: 'Mother: Há uma semana que as minhas gengivas andam a sangrar quando escovo os dentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: 'Mother: E, mesmo assim, tenho os dentes amarelos. Mas como não fumar com miúdos assim?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964327
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964328
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: 'Mother: Tenho uma espécie de irritação causada por produtos de limpeza. Nunca tive tempo para ir ao médico.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: 'Mother: Estas mãos podem fazer-te uma bela sopa, se viveres o suficiente! E tu sacas da tua arma...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964331
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964332
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: 'Mother: Mesmo que saques de uma granada, não me vais dar uma boa noite de sono.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964334
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964335
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: 'Mother: O quê? Decidiste disparar por causa do cheiro? Que piada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964337
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964338
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: 'Mother: O quê? Estás a julgar-me pela minha fotografia? Que piada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964340
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964341
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: 'Mother: Se vais disparar por causa dos meus ouvidos, então és doente. O que foi? Não gostas deles? Eu tapo-os com um lenço!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964343
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964344
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: Por fim, ninguém me vai voltar a moer o juízo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: Que horror...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: 'Mother: Sabes, um dos meus filhos tem os dentes perfeitos. E nunca sorriu. Se calhar, não é dos dentes...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: 'Mother: Mãos... Usei-as para abraçar os miúdos, para as tarefas domésticas, acariciar o meu marido. E ninguém lhes deu valor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964349
    m_Localized: 'Mother: Quando o teu filho está doente, não dormes durante dias. Depois, habituas-te e vives simplesmente no pesadelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964350
    m_Localized: 'Mother: Uma vez, estava tão cansada que não tomei banho durante uma semana. Os miúdos nem notaram.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964351
    m_Localized: 'Mother: Sabes, encontrei uma foto onde todos os miúdos estavam a sorrir. Fiquei a olhar para ela até adormecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964352
    m_Localized: 'Mother: Às vezes, queria ser surda. Mas quando os miúdos dormem, há um silêncio abençoado... É para isso que vivemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: 'Anger: A sério? Foda-se... Está bem, anda lá, mas despacha-te!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: Ouvidos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: 'Anger: Estou-me a cagar. Força.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: 'Anger: Amarelos? Que se fodam.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: 'Anger: Brancos? Como é que poderiam ser, se só estou a tentar cuidar de mim?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: 'Anger: Eu pensava que, com dentes assim, devia pelo menos ter um de ouro. Como aqueles gajos todos durões dos filmes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: Pois sim, como queiras.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: 'Anger: Ufa, são mesmo enormes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: 'Anger: Ha. A minha avó sempre me dizia que, com mãos destas, devia era cortar lenha e não... fazer o que fazia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: 'Anger: Mas aqui não há nada para cortar e tenho de descarregar a raiva de alguma forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: 'Anger: É contigo, não quero saber.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: 'Anger: O que foi? Gostas da cor? São azuis. Sempre foram. Nunca precisei de mais nada para atrair mulheres.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: Estou-me bem a cagar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: Sim, eu depilo-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: 'Anger: Não suporto ter pelos debaixo dos braços. É como se a merda de um arbusto tivesse decidido crescer ali.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: Força.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: 'Anger: O que foi? Por que caralho é que estás aí especado a olhar para mim? O que é que viste?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: Foda-se...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: 'Anger: Estás aí especado a olhar para mim porquê? Falta alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: 'Anger: Estás bem da puta da cabeça? Acabei de te mostrar os dentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: 'Anger: Achas que não te consigo arrancar a puta da garganta com estas mãos antes de puxares esse gatilho?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: 'Anger: Mas que merda é que estás a insinuar? Tens inveja ou quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: 'Anger: Está sempre a dar-me comichão, como se me quisesse deixar à beira de um ataque de nervos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: 'Anger: Quando coço até sangrar, fica melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: 'Anger: Não posso acreditar. Estás todo fodido da cabeça!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: 'Anger: Queres disparar contra mim por causa da merda de uma foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: 'Anger: Tem cuidado com essa espingarda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: 'Anger: Podes vir a disparar sem querer por causa dos meus ouvidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: 'Anger: Estás todo fodido dos cornos. Anda lá, então, filho da puta!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: 'Anger: És um grande cabrão sem coração.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: Vai para o caralho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: 'Anger: A minha avó tinha um dente de ouro. Era novo quando percebi que queria um igual.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: 'Anger: Brilhava como se o sol estivesse preso na boca dela.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: 'Anger: A minha avó disse que o puseram quando o dente antigo apodreceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: 'Anger: Isso deixou-me feliz. Pensei: "Espetáculo! Quando chegar a minha vez, vão fazer-me o mesmo."'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: 'Anger: E então... Bem, chegou a hora. Só que ninguém me pôs nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: 'Anger: E agora não tenho o sol na boca... só dentes amarelos como mijo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: 'Anger: Vês estas mãos? Terra, sangue, o que quiseres. Mas não são de outra pessoa. É tudo meu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: 'Anger: Às vezes, dão tanta comichão que quero arrancar a pele toda. Ou dar um murro na parede. Ou ambas as opções ao mesmo tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: 'Anger: Não consigo conter-me. Mas também não quero magoar ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: 'Anger: Vês estas unhas? Terra, sangue, o que quiseres. Mas não são de outra pessoa. É tudo meu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: 'Anger: Às vezes, dão tanta comichão que quero arrancar a pele toda. Ou dar um murro na parede. Ou ambos ao mesmo tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: 'Anger: Aposto que se fosse outra pessoa, ficaria preocupado. Mas estou-me a cagar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: 'Anger: A minha avó chamava-me de "anjo bebé" por causa da cor dos meus olhos. Enfim. Que "anjo" do caralho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: 'Anger: Agora estou aqui, a olhar para estas janelas da alma e a pensar "Que parte de mim é que é um anjo?"'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: 'Anger: Consigo imaginar o olhar dela. Desiludida.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: 'Anger: Sabes, as lâminas são afiadas o suficiente para... fazer alguma coisa. Se fosse assim tão simples...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: 'Anger: Acabei apenas por arranhar o braço. Agora, quando me depilo, parece que me estou a cortar e não a cortar os pelos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: 'Anger: Mas continuo a depilar-me. Porque odeio aquele arbusto de merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: 'Anger: Nem tenho uma foto da minha avó. Ela não gostava dessas merdas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: 'Anger: Ela dizia que, quando tiras uma foto, a alma fica presa nela e não consegue sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: 'Anger: Eu gozei com ela: "Oh, avó, vá lá, isso não faz sentido nenhum."'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: 'Anger: E ela disse: "Quando eu morrer, vais olhar para a minha foto e vais perguntar-te se estou no céu."'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: 'Anger: Bem, que se foda tudo. Sem fotos e sem avó.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: 'Anger: Às vezes, dou por mim a puxar o lóbulo da orelha, mas só quando já está a arder como o inferno.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: 'Anger: Achava que era um tique nervoso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: 'Anger: Depois, percebi que só queria arrancar esta parte de mim... como se me estivesse a atrapalhar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: 'Anger: Mas não sou suficientemente louco ao ponto de me mutilar, pois não?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: Pois não??'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: 'FortuneTeller: Oh, querido, sabia que a tua energia ia dar luta. Vamos lá aos testes. Seja como for, continuo a ler-te como um livro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: Ouvidos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: Está bem, vê lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: 'FortuneTeller: Os olhos são o reflexo do nosso cosmos interior, não os dentes. Queres ver o teu destino neles?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: 'FortuneTeller: Os olhos são o reflexo do nosso cosmos interior, não os dentes. Para que estás a olhar para eles?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: Pronto, dá lá uma olhada, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: 'FortuneTeller: Mas cuidado — ainda não conseguir tirar as farpas que apanhei de um caçador de sonhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: 'FortuneTeller: Ah, os meus olhos? São castanhos, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: 'FortuneTeller: Bem, isto é, se não contares as manchas vermelhas. A culpa é da lua.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: 'FortuneTeller: Ah... As coisas que o universo me põe no caminho... Tudo bem, dá lá uma olhada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: 'FortuneTeller: É difícil que uma pessoa se cuide nestas condições, sabes...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: 'FortuneTeller: Cuidado. A minha aura pode cegar!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: 'FortuneTeller: Então? O que achaste?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: 'FortuneTeller: Olha à vontade, mas tem cuidado — eles ouvem tudo. Até os teus pensamentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: 'FortuneTeller: E então? Descobriste alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: 'FortuneTeller: Queres disparar por causa dos meus dentes? Sabes que não tenho culpa, certo? É Marte que está de mal com Vénus.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: 'FortuneTeller: A sério? Vais disparar por causa de umas farpas nas mãos? É o que dá trabalhar com caçadores de sonhos!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: 'FortuneTeller: Estás doido?! Sabes que é só a lua a pregar partidas, certo? Não é fácil seguir os movimentos dela!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: 'FortuneTeller: Estás doido?! Sabes que é só a lua a pregar partidas, certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: 'FortuneTeller: Isto não é astrologia, é selvajaria! Ouve, baixa a arma e eu conto-te mais alguns dos meus segredos, sim? E de borla!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: 'FortuneTeller: Ei! A culpa não é minha se não estavas preparado, meu querido!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: 'FortuneTeller: Podes pousar isso? O que achas que podes descobrir ao ver os ouvidos de alguém? Eles servem para ouvir os sábios!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: 'FortuneTeller: Se me matares, ficarás condenado a...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: Uma diarreia eterna!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: 'FortuneTeller: Sabes, houve um homem com dentes perfeitos que veio falar comigo uma vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: 'FortuneTeller: Disse-lhe: "Está tudo bem, mas a tua alma está podre!" Pensa no que realmente importa. Compreendes, certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: 'FortuneTeller: Uma vez passei a noite inteira a tirar farpas depois de um ritual. Doía, mas cada uma era uma lição do universo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: 'FortuneTeller: Os olhos são portais para outro mundo. Vi um homem de olhos brilhantes como lanternas. Dizia ser amor, mas era Marte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: 'FortuneTeller: Sabes, uma vez vivi três semanas de forma ascética, só a pensar nos meus sonhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: 'FortuneTeller: Os pensamentos são matéria e é assim que me aproximo dos meus desejos. Só tenho de fazer o pedido certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: O meu estado atual deve ser parecido a esse.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: 'FortuneTeller: Tirei uma foto minha uma vez, e pensei: "Isto é um sinal das estrelas!" Depois, percebi que era apenas a iluminação.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: 'FortuneTeller: Uma vez, ouvi algo nos ouvidos como se o universo me quisesse falar. Mas acho que era algo mais muito forte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: 'FortuneTeller: Uma vez, ouvi algo como se o universo estivesse a falar comigo... Era só uma corrente de ar. Mas gostei na mesma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158522
    m_Localized: 'Fanatic: O que queres verificar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158523
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158524
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158525
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158526
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158527
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158528
    m_Localized: Ouvidos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158529
    m_Localized: 'Fanatic: Queres que te mostre os meus dentes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158530
    m_Localized: 'Fanatic: OS MEUS DENTES DEFENDERAM A VERDADE!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158531
    m_Localized: 'Fanatic: E caíram por isso...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158532
    m_Localized: 'Fanatic: E podes ver isso por ti mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158533
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158534
    m_Localized: 'Fanatic: Mantenho os meus dentes em boas condições graças a uma solução de cerveja. Protege bem o cálcio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158535
    m_Localized: 'Fanatic: Sem ela, já teria perdido os dentes há muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158536
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158537
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158538
    m_Localized: 'Fanatic: Compreensível, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158539
    m_Localized: 'Fanatic: Está tudo a acontecer ao mesmo tempo, mas lá vamos vivendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158540
    m_Localized: 'Fanatic: E continuamos a viver.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158541
    m_Localized: 'Fanatic: O que foi? Estás há muito tempo nas sombras?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158542
    m_Localized: 'Fanatic: Descansa, meu amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158543
    m_Localized: 'Fanatic: Sem restrições, meu amigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158544
    m_Localized: 'Fanatic: Vê as minhas unhas o quanto quiseres.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158545
    m_Localized: 'Fanatic: Treinei-me para absorver a benéfica luz do sol através delas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158546
    m_Localized: 'Fanatic: E para abrir tampas de cerveja.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158547
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158548
    m_Localized: 'Fanatic: Só as querias verificar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158549
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158550
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158551
    m_Localized: 'Fanatic: OLHA NOS MEUS OLHOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158552
    m_Localized: 'Fanatic: Estão cheios de raiva e fúria.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158553
    m_Localized: 'Fanatic: OLHA NOS MEUS OLHOS NEGROS!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158554
    m_Localized: 'Fanatic: Uso-os para absorver todos os benefícios da luz, transformando-os em energia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158555
    m_Localized: 'Fanatic: Recebo toda a minha energia através dos OLHOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158556
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158557
    m_Localized: 'Fanatic: JÁ VISTE O PODER JUSTO DO SOL NOS MEUS OLHOS?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158558
    m_Localized: 'Fanatic: Se não o viste, estás cego. Tenta olhar para o sol durante mais tempo, COMO EU.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158559
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158560
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158561
    m_Localized: 'Fanatic: Uma fotografia?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158562
    m_Localized: 'Fanatic: Hm... Hm-hm-hm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158563
    m_Localized: 'Fanatic: Já te disseram que cumprimentei o próprio LÍDER SOLAR?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158564
    m_Localized: 'Fanatic: Sim, ensinei-o a olhar para o sol, mas conto-te isso depois.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158565
    m_Localized: 'Fanatic: Vai em frente. FOTOGRAFA-ME!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158566
    m_Localized: 'Fanatic: (Tiras uma fotografia ao homem desleixado.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158567
    m_Localized: 'Fanatic: (Como na vida, a foto mostra-o despenteado e imundo.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158568
    m_Localized: 'Fanatic: (Não notas nenhuma distorção.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158569
    m_Localized: 'Fanatic: COMO TUDO CORREU MARAVILHOSAMENTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158570
    m_Localized: 'Fanatic: Vem falar comigo e eu conto-te tudo sobre a minha vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158571
    m_Localized: 'Fanatic: E pagas-me qualquer coisinha por isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158572
    m_Localized: 'Fanatic: VOU GASTAR O QUE ME PAGARES A SALVAR A ENERGIA DO SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158573
    m_Localized: 'Fanatic: Tenta disparar! A verdade vai proteger-me!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158574
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158575
    m_Localized: 'Fanatic: Podes só afastar a arma?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158576
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158577
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158578
    m_Localized: 'Fanatic: Bem, é muuuuuito difícil sem uma cerveja nas mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158579
    m_Localized: 'Fanatic: Muuuuuuito difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158580
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158581
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158582
    m_Localized: 'Fanatic: Humano, por que raio estás a fazer isto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158583
    m_Localized: 'Fanatic: ENLOUQUECERAM, Ó NÃO ILUMINADOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158584
    m_Localized: 'Fanatic: Já não basta falarem nas nossas costas como também ainda disparam sobre nós...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158585
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158586
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158587
    m_Localized: 'Fanatic: Bem, já chega!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158588
    m_Localized: 'Fanatic: Isto não nos ajuda em nada em relação à nossa vitalidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158589
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158590
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158591
    m_Localized: 'Fanatic: Espera, não gostas das minhas mãos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158592
    m_Localized: 'Fanatic: PORQUÊ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158593
    m_Localized: 'Fanatic: És um sovina, um ignorante, e eu quero cerveja.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158594
    m_Localized: 'Fanatic: Dizem que as pernas não mentem...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158595
    m_Localized: 'Fanatic: Então o que é suposto fazer? Afastar o olhar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158596
    m_Localized: 'Fanatic: Ah, espera aí...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158597
    m_Localized: 'Fanatic: Não era antes os olhos que não mentem?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158598
    m_Localized: 'Fanatic: Só um momento, espera...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158599
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158600
    m_Localized: 'Fanatic: Estou-me a cagar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158601
    m_Localized: 'Fanatic: É isso mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158602
    m_Localized: 'Fanatic: Não te atreverias a disparar contra o Sol!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158603
    m_Localized: 'Fanatic: Mas não te preocupes comigo. Não me ofendi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158604
    m_Localized: 'Fanatic: Tens uma bela reserva de líquido frio e revigorante!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158605
    m_Localized: 'Fanatic: Ah, tu gostas é de pregar partidas, não é?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158606
    m_Localized: 'Fanatic: Bem, toma lá um cheirinho, então, se é isso que queres.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158607
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158608
    m_Localized: 'Fanatic: Este é o resultado do autocuidado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158609
    m_Localized: 'Fanatic: Ah, tu gostas é de pregar partidas, não é?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158610
    m_Localized: 'Fanatic: Bem, toma lá um cheirinho, então, se é isso que queres.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158611
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158612
    m_Localized: 'Fanatic: Este é o resultado do trabalho do Sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158613
    m_Localized: 'Fanatic: Largamos uma revigorante humidade para continuar a viver!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158614
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158615
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: O que queres verificar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: Ouvidos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: 'Anxiety: Hah, o quê? Vais decidir com base nos meus dentes? Eish.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: Acabei de arranjar os dentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: Embora, para ser honesta...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: 'Anxiety: Nem me lembro de ter ido ao dentista. Será que fui mesmo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: 'Anxiety: Meu Deus, estou tão apavorada que nem sei se comi ontem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158629
    m_Localized: 'Anxiety: Então... Encaixo-me na descrição?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158632
    m_Localized: 'Anxiety: Sou uma Visitante? Como? COMO?! Não pode ser!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158633
    m_Localized: 'Anxiety: Oh meu Deus, fui posta fora de casa, despedida do trabalho e agora vão tirar-me a minha própria vida...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: 'Anxiety: Queres ver as minhas unhas? Que sinal estranho...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: 'Anxiety: Mas está bem. Vê lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: 'Anxiety: O que têm elas? É impossível que seja terra.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: 'Anxiety: Eu... Eu nem sequer me lembro de ter andado a escavar o chão.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: Como é que esta porcaria veio aqui parar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158644
    m_Localized: 'Anxiety: Não poderia andar por aí suja durante dias, pois não?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158645
    m_Localized: 'Anxiety: Que... estranho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158648
    m_Localized: 'Anxiety: Pensa só! Não sei de onde veio esta terra. Eu estive aqui, em tua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158649
    m_Localized: 'Anxiety: Será que... alguém pôs isto de propósito debaixo das minhas unhas? Quem é que faria isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: Queres verificar os meus olhos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158651
    m_Localized: 'Anxiety: Até consigo adivinhar o resultado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158652
    m_Localized: 'Anxiety: E se eu tiver este sinal, o que é que acontece?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158654
    m_Localized: 'Anxiety: Sim, bem. Não podia ser de outra forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158657
    m_Localized: 'Anxiety: Sou mesmo uma Visitante? O que achas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158658
    m_Localized: 'Anxiety: E por que raio é que eu não sabia disso? Se calhar é assim que as pessoas se tornam Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158659
    m_Localized: 'Anxiety: Será que basta pensar que somos diferentes de todos e que somos a pior pessoa a existir na sociedade?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: Tenho medo de morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158663
    m_Localized: 'Anxiety: Espera, podes dar-me uma ligadura?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158664
    m_Localized: 'Anxiety: Ou, pelo menos, deixar-me ficar de pé mais um bocadinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158665
    m_Localized: 'Anxiety: Se eu for mesmo uma Visitante, vou começar a matar pessoas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158666
    m_Localized: 'Anxiety: Vou tornar-me perigosa? Ou sempre fui perigosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158667
    m_Localized: 'Anxiety: Será que já matei alguém?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: (Tiras uma fotografia dela.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158669
    m_Localized: 'Anxiety: (Quando a imagem aparece, vês um corpo desfocado e o fundo nítido.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158670
    m_Localized: 'Anxiety: (Parece que a pessoa se encolheu quando a fotografia foi tirada.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158671
    m_Localized: 'Anxiety: Hahaha, quem é que podia imaginar? Encolhi-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158672
    m_Localized: 'Anxiety: E agora, o que acontece?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158673
    m_Localized: 'Anxiety: Vais deixar-me viver? Ou seria melhor matar-me? O que vais fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: Porquê?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: Não seria mais fácil disparares de uma vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158678
    m_Localized: 'Anxiety: Quero deixar tudo para trás, mas tenho tanto medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158679
    m_Localized: 'Anxiety: Talvez...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158680
    m_Localized: 'Anxiety: Não sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158681
    m_Localized: 'Anxiety: Se me deres um tiro, será que me vou transformar em algo ainda pior?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158682
    m_Localized: 'Anxiety: Talvez devesse fugir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158683
    m_Localized: 'Anxiety: Mas já nem sei se sou humana sequer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158684
    m_Localized: 'Anxiety: O que é que eu faço agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158685
    m_Localized: 'Anxiety: Tal como aqueles Visitantes lá em casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158686
    m_Localized: 'Anxiety: Desculpa, foi horrível... Eu mostro-te.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158687
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: 'Anxiety: Sou humana? Sim? Diz-me que sou humana!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: 'Anxiety: Por que razão é que me pediste para ver se ias sacar da arma na mesma?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: Gostas de humilhar as pessoas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158695
    m_Localized: 'Anxiety: Que pesadelo. Uma pessoa já não se pode sentir segura em nenhum lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158696
    m_Localized: 'Anxiety: Os Visitantes podem invadir a tua casa. E um maluco qualquer pode matar-te porque acha que há algo de errado contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158697
    m_Localized: 'Anxiety: É tão assustador! PELO MENOS, ALGUÉM PODIA DIZER QUE VAI FICAR TUDO BEM!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158698
    m_Localized: 'Anxiety: Como é que me tornei numa Visitante só por causa daquele sinal? Porquê?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158699
    m_Localized: 'Anxiety: Que azarada com o meu corpo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158700
    m_Localized: 'Anxiety: Está todo torto. Percebo os motivos que levaram as pessoas a ter medo de mim no trabalho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158701
    m_Localized: 'Anxiety: Fui ao hospital na semana passada por causa das costas... Acho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158702
    m_Localized: 'Anxiety: Será que... também fui ao dentista?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158703
    m_Localized: 'Anxiety: Quanto é que gastei...?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: O que queres verificar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: Ouvidos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: Queres que te mostre os meus dentes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: 'Esenin: Está bem, vê lá. Ainda têm o cheiro da tristeza e do fumo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: Bem amarelinhos, não é?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: Portanto, desampara-me loja, tu e os teus testes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: Não sou um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: De onde é que eles vieram afinal?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: 'Esenin: Unhas com terra são um sinal?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: Podiam simplesmente lavar as mãos!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: 'Esenin: Então, estás a dizer que um jardineiro é automaticamente considerado um Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: Que sentido do caralho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: Vê as minhas unhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: 'Esenin: Então? Sou um Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: Não me parece.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: Cada dia é mais ridículo do que o anterior.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: 'Esenin: E se eu não tivesse dormido? Ou se tivesse estado a chorar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: 'Esenin: Já não percebo nada disto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: 'Esenin: E o que vais fazer se um dos sinais se confirmar? Ou vários?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: 'Esenin: Hoje à noite vou transformar-me num Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: 'Esenin: Vou pôr-me a chorar de me lembrar dos tempos de paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: 'Esenin: Todos estes testes de sinais, gajos em fatos amarelos...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: É tudo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: Uma confusão do caralho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: 'Esenin: Não sentes que está tudo a encaminhar-se em direção a um inferno grotesco?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: 'Esenin: Supostamente, está tudo sob controlo, mas só há caos à nossa volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: Bem, tira lá a porcaria da tua fotografia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: (Tiras uma fotografia dele.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: 'Esenin: (Ele está sentado calmamente, não totalmente enquadrado, mas não notas nada de estranho.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: 'Esenin: Estou só apavorado com o que vem a seguir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: 'Esenin: A sério? És parvo ou és estúpido?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: A AGEF comeu-te o cérebro?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: 'Esenin: Ou estás só completamente fora de ti? Achei que já não existiam drogas pesadas neste mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: 'Esenin: Bem, já que estás a pedir... eu mostro-te!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: Encontraste o que querias?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: Cheiraste até te fartares?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: 'Esenin: Obrigadinho por não quereres vasculhar a minha peida!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: Despacha-te só, está bem?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158751
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158752
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158753
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158754
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158755
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352768
    m_Localized: Ouvidos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: O quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: 'Widow: Hum... Ok.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: Já acabaste?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: Posso ter um pouco de paz e sossego?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352774
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352775
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: 'Widow: Mãos... Um momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: 'Widow: As minhas mãos estão cansadas de carregar a pessoa que se recusaram a salvar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: 'Widow: Podes parar de me pedir para fazer esta merda ridícula?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: 'Widow: Se queres assim tanto disparar sobre mim, força nisso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: Já não tenho mais forças para nada...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352782
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352783
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: 'Widow: Estás à procura de quê? Vermelhidão?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: Força.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: 'Widow: Se mostrar alguma emoção, quer dizer que sou um Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352788
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352789
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: Podemos falar com toda a franqueza, agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352791
    m_Localized: 'Widow: Não consegues ser feliz, não consegues chorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352792
    m_Localized: 'Widow: E nem sempre consegues falar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352793
    m_Localized: 'Widow: O que é que resta? Ficar sentado com a cara metida no meio das mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352794
    m_Localized: 'Widow: Vai mesmo tudo acabar assim tão facilmente?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352795
    m_Localized: 'Widow: Acabou-se o sofrimento?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352796
    m_Localized: 'Widow: Mas não te salvei, meu...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352797
    m_Localized: 'Widow: Isso não te parece humilhante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352798
    m_Localized: 'Widow: Ninguém me ajudou a salvar o meu marido, e agora...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352799
    m_Localized: 'Widow: QUERES IMORTALIZAR A MORTE DELE?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352801
    m_Localized: 'Widow: Já não tenho palavras.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352802
    m_Localized: 'Widow: Faz o que quiseres e deixa-me em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352803
    m_Localized: 'Widow: (Tiras uma fotografia dela.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352804
    m_Localized: 'Widow: (Não notas nada de estranho.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352805
    m_Localized: 'Widow: (O homem morto aparece na imagem, o que te faz refletir sobre a vida.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352806
    m_Localized: 'Widow: Vai-te só embora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352807
    m_Localized: 'Widow: Ele gostava dos meus dentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352808
    m_Localized: 'Widow: Mas eu queria usar aparelho, sabes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352809
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352810
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: Claro, e que tal disparar sobre mim, não é?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352812
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352813
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: 'Widow: As pessoas ainda conseguem sequer chorar neste novo mundo? Rir é que já não conseguem, de certeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352815
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352816
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: Estás louco?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: 'Widow: A sério, diz-me: ESTÁS LOUCO?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: 'Widow: Se aqueles demónios te mandassem dançar numa frigideira, eras o primeiro a saltar para lá?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: 'Widow: Tu... Puta que... Já nem tenho palavras.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: 'Widow: Então? Saca lá da tua arma, já agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352823
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352824
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: Raios.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: 'Widow: Prime o gatilho de uma vez. A AGEF acabou com a minha alma. Acaba com o meu corpo também.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352827
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352828
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352829
    m_Localized: 'Widow: Já nem penso em aparelhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352830
    m_Localized: 'Widow: Até pedires para ver os meus dentes, nem me lembrava de que essa ideia sequer existiu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352832
    m_Localized: 'Widow: Ai, céus... Estou só exausta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352833
    m_Localized: 'Widow: Descarrego em todos à minha volta. Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352834
    m_Localized: 'Widow: Não é culpa de ninguém. Só de certos cabrões.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352835
    m_Localized: 'Widow: Não consigo entender. Nem quero.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352836
    m_Localized: 'Widow: Humilhar alguém que acabou de perder...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352837
    m_Localized: 'Widow: Dá-me só um momento...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352838
    m_Localized: 'Widow: Uff. Sacaste da tua arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352839
    m_Localized: 'Widow: E acabaste por não me matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352840
    m_Localized: 'Widow: O que é que foi isso? Insegurança tua? Não precisavas de a mostrar dessa forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: O que queres verificar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352842
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352843
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352844
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352845
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352846
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352847
    m_Localized: Ouvidos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352848
    m_Localized: 'Scammer: Vamos lá aos dentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352849
    m_Localized: 'Scammer: Um amigo meu era dentista.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352850
    m_Localized: 'Scammer: E adivinha? Partiram-lhe os dentes todos! HAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352851
    m_Localized: 'Scammer: Oh, queres mesmo vê-los. ''Tá bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352853
    m_Localized: 'Scammer: Tudo em ordem, não?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352854
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352855
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352856
    m_Localized: 'Scammer: Mas que raio, oh mano? Era só uma história perfeitamente normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352857
    m_Localized: 'Scammer: Mas disparar-me nas trombas por causa dos dentes... Não percebo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352858
    m_Localized: 'Scammer: Por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352859
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352860
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: Estás maluco?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: 'Scammer: Meu, chupa-me a p...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: 'Scammer: Mas que merda? Sou só um gajo normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: 'Scammer: Não faço nada com as minhas unhas, meu, estás a ver?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352866
    m_Localized: 'Scammer: Não me interpretes mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352867
    m_Localized: 'Scammer: Eu lavo-as, só que vi uma moeda no chão e fui apanhá-la.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352868
    m_Localized: 'Scammer: Estão limpas. Meu, eu vou lavar as mãos hoje, vá lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352869
    m_Localized: 'Scammer: Eu lavo-as, mano. Só não tive tempo de o fazer hoje.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352870
    m_Localized: 'Scammer: Estão limpas. Quase sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352871
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352872
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352873
    m_Localized: 'Scammer: Vais limpar o sebo a um gajo só por causa de unhas sujas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352874
    m_Localized: 'Scammer: Tudo bem. Nunca pensei que fosse morrer de uma forma tão parva.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352875
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352876
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352877
    m_Localized: 'Scammer: Parece-me uma maneira muito estranha de identificar aqueles monstros.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352878
    m_Localized: 'Scammer: É possível distinguir otários e estúpidos pelas mãos. Mas em que é que os Visitantes estão relacionados com isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352879
    m_Localized: 'Scammer: Era preciso acordar às 9 da manhã e trabalhar pelo menos 4 horas. Foda-se.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352880
    m_Localized: 'Scammer: Os meus olhos têm-me dado comichão ultimamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352881
    m_Localized: 'Scammer: Achas que é do sol? Ou algo do género?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352883
    m_Localized: 'Scammer: Merda, mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352884
    m_Localized: 'Scammer: Isto é alguma doença.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352885
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352886
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352887
    m_Localized: 'Scammer: Olha, tive uma ideia para um plano.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352888
    m_Localized: 'Scammer: Vamos tirar dinheiro dos outros e assim não temos de dar tiros na tromba de ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352889
    m_Localized: 'Scammer: O que foi? Tens de pensar nisso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352890
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352891
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352892
    m_Localized: 'Scammer: Tudo bem, se não curtes do plano, eu percebo. Mas tenho mesmo uma doença qualquer nos olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352893
    m_Localized: 'Scammer: Se pelo menos tivesses uns colírios por aí...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352894
    m_Localized: 'Scammer: Mesmo assim, não os comprava. Tenho os meus motivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352895
    m_Localized: 'Scammer: Queres tirar uma foto? Força aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352896
    m_Localized: 'Scammer: Sou sensível à luz. Posso encolher-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352897
    m_Localized: 'Scammer: (Tiras uma fotografia dele.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352898
    m_Localized: 'Scammer: (Parece normal, mas o rosto...)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352899
    m_Localized: 'Scammer: (Ficou mesmo desfocado.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352900
    m_Localized: 'Scammer: Eu avisei-te.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352901
    m_Localized: 'Scammer: Queres tentar outra vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352902
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352903
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352904
    m_Localized: 'Scammer: Não me passes a perna, mano, mete aquela gente a render.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352905
    m_Localized: 'Scammer: Mantém-nos bem atentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352906
    m_Localized: 'Scammer: Senão, relaxam, deixam-se de lembrar de quem é que manda aqui e não pagam.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352907
    m_Localized: 'Scammer: Espera!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352908
    m_Localized: 'Scammer: Vai-te foder tu e a tua casa. Estou fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352909
    m_Localized: 'Scammer: Vou pôr-me mesmo debaixo do sol. É bom que fiques com isso a pesar-te na consciência.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352910
    m_Localized: 'Scammer: Merda do caralho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352911
    m_Localized: 'Scammer: Escolheste o plano errado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352912
    m_Localized: 'Scammer: Tu é que mandas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352913
    m_Localized: 'Scammer: Então, o que é o juiz decide? Tudo em ordem?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352914
    m_Localized: Deixa-o em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352915
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352916
    m_Localized: 'Scammer: Espera lá! Está bem, merda, eu admito: houve uma vez tentei depilar-me e decidi continuar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352917
    m_Localized: 'Scammer: Só não contes a ninguém. Não és um linguarudo, pois não?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352918
    m_Localized: 'Scammer: Espera aí! Isso é como me pedires para ver os meus boxers.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352919
    m_Localized: 'Scammer: Sabes que um tipo decente não pode ter axilas queimadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352920
    m_Localized: Dispara sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352921
    m_Localized: Ouve o que ele tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352922
    m_Localized: 'Scammer: Eu sabia que eras um gajo porreiro. Não ias atacar gente normal, pois não? Heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352923
    m_Localized: 'Scammer: E que tal se apertarmos com aqueles otários?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352924
    m_Localized: 'Scammer: Não? Está bem. Fui.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352925
    m_Localized: 'Scammer: Eu sei que estás sob grande pressão por causa dos Visitantes e dessa merda toda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352926
    m_Localized: 'Scammer: E que estás a fazer isto tudo por nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352927
    m_Localized: 'Scammer: Seja como for, não há ressentimentos. A sério.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: O que queres verificar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: Ouvidos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: 'Daughter: Os dentes? Queres que te mostre os meus dentes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: 'Daughter: Porquê? Ainda tenho alguns dentes de leite. O Papá dizia...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: Já não vou chorar mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: Pronto, aqui estão eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: O que quer isso dizer?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: Está tudo bem?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: Já sei cortar as unhas sozinha.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: Ainda não sou muito boa a fazê-lo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: Olha.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: Estão giras, não estão?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: 'Daughter: Fui eu que as cortei. Sozinha.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: 'Daughter: Vou-me embora. Quero ficar sozinha.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: Podes olhar para dentro dos meus olhos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: 'Daughter: Vais ver o que estou a pensar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: 'Daughter: Nesse caso, vou pensar com muito cuidado, não te preocupes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352953
    m_Localized: 'Daughter: Que cara é essa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352954
    m_Localized: 'Daughter: Tu v-v-vist...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547072
    m_Localized: 'Daughter: Tu... Buááááá.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: 'Daughter: Eu q-q-quero uma b-b-bebida.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: O que é que tenho de fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: 'Daughter: (Olhas para ela e percebes que isto é um exagero.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: Só queres saber como estou?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: 'Daughter: Estou muito cansada. Posso ficar sozinha?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: Uma fotografia?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: Não tirei muitas fotos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: Depois mostras-me?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: (Tiras uma fotografia dela.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: (A imagem saiu um pouco desfocada.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: 'Daughter: (Ela correu na tua direção antes de acabares de tirar a foto.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: Hmmm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: Obrigada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: 'Daughter: Não gosto disso. Não me peças para tirar mais fotos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: 'NotTrue: Heh. Bem, verifica lá, querido. Não vais ver nada que já não tenhas visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: Ouvidos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: Os meus dentes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NotTrue: Aaaaaah.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: 'NotTrue: Sabes, estes dentes... Eu odiava-os. Queria arrancá-los todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: 'NotTrue: Olha para os meus dedos — não servem para contar nem para medir em condições.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: 'NotTrue: Para o que é, chegam. Só o suficiente para não ficar sem nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: 'NotTrue: Oh, querido... Tens a certeza de que é isso que queres?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: 'NotTrue: Os olhos são como janelas. Nas casas, as janelas servem para entrar luz e, nas pessoas, são um caminho para a verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: 'NotTrue: Mas as minhas estão cheias de pó... O vidro está todo rachado... E as traças há muito que deram cabo das cortinas...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: 'NotTrue: Não olhes, querido. Não há lá nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: 'NotTrue: Feh! Obrigar uma velhota a levantar os braços... Não tens vergonha? Mal me aguento de pé!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: 'NotTrue: Bem, o que é que se pode fazer? O chefe é que manda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: E então?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: 'NotTrue: O quê? Para que vais gastar película comigo? Isso está quase a acabar... Insistes? Bem, isso é lisonjeiro!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: Então, o que achas, querido?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: 'NotTrue: Hah! Que ideia, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: 'NotTrue: São normais, como sempre foram. Ouço como sempre. Mas sabes... Às vezes sinto que já não estou cá.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: 'NotTrue: É como se eu fosse vista apenas por uma claraboia... E, mesmo assim, nem sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: 'NotTrue: Ei, por que diabos é que estás a apontar isso para mim?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: 'NotTrue: Não há nada pior que uma velhota sem dentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: 'NotTrue: Achas que tenho medo? Que há alguém que me agarre a este mundo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: 'NotTrue: Já tentei agarrar o ar tantas vezes que até os meus próprios dedos sabem que não me consigo agarrar a nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: Pronto, então é assim que são as coisas...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: 'NotTrue: Não acreditas em mim? Queres ver? Bem, vê lá então...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: 'NotTrue: Também costumava olhar para os olhos das pessoas. Agora, só me lembro de como era.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: 'NotTrue: Bem, querido, isto é como um selo da velhice. Quem vive o suficiente é isto que ganha. Não sabias?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: 'NotTrue: O fungo não sente dor. Não pede comida. Apenas existe. Vive por viver. Como eu, hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: 'NotTrue: O quê? Também vais perder as estribeiras por causa disto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: 'NotTrue: O que é isto, querido? Achas que consegues detetar alguma coisa ao ver os meus ouvidos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: 'NotTrue: Bem, por mim, tudo bem, querido. Qual é o interesse para mim? Já há muito que me quero encontrar com Deus.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: É só que...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: 'NotTrue: Paguei a um médico para os tirar, mas não conseguiu fazer tudo de uma vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: 'NotTrue: Ia lá, e tirava um ou dois... Nunca consegui tirar todos. Os médicos hoje não têm tempo para isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: 'NotTrue: Portanto, querido, vivo com este trabalho inacabado na boca.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: 'NotTrue: As mãos são para quem as segura. Eu cá já deixei de o fazer há muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: 'NotTrue: Para que hei de estender as mãos? Tu podes muito bem estender as tuas, não?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: 'NotTrue: "Salta para as costas do vento e flutua pelo rio abaixo..." em direção à minha cabana, querido. Entra.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: 'NotTrue: Achas que consegues fugir deste destino? Só se morreres jovem. Mas é melhor que te cuides!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: 'NotTrue: És tão bonito! Seria um pecado destruir tanta beleza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: 'NotTrue: No meu tempo, só os ricos tinham coisas dessas. Agora, bem, agora qualquer um as tem e as pode usar!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: 'NotTrue: Não tenho nada para te dizer. Estás a ser estúpido. A chatear boa gente sem motivo nenhum...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547160
    m_Localized: 'Alkonost: Só não atormentes a minha irmã.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547161
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547162
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547163
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547164
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547165
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547166
    m_Localized: Ouvidos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547167
    m_Localized: 'Alkonost: Sempre tivemos dentes fortes na nossa família.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547168
    m_Localized: 'Alkonost: Quando era adolescente, tentei abrir uma cerveja com os dentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547169
    m_Localized: 'Alkonost: Não correu bem. Mas aprendi a cuidar deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547170
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547171
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547172
    m_Localized: 'Alkonost: A minha irmã não está em condições de se cuidar agora. Por isso, sou eu que trato de tudo com as mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547173
    m_Localized: 'Alkonost: E como devem ser as mãos humanas quando cuidam de duas vidas ao mesmo tempo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547174
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547175
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547176
    m_Localized: 'Alkonost: Sim, a minha irmã chora muito, mas os nossos olhos continuam parecidos. O olhar dela é só um pouco mais apagado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547177
    m_Localized: 'Alkonost: Isso preocupa-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547178
    m_Localized: 'Alkonost: Sim, a minha irmã chora muito, mas os nossos olhos continuam parecidos. Não estão vermelhos, é isso que quero dizer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547179
    m_Localized: 'Alkonost: Talvez ela já tenha chorado tudo o que podia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547180
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547181
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547182
    m_Localized: 'Alkonost: Eu mostro-te. Mas não incomodes a minha irmã, está bem? Ela está demasiado cansada para isto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547183
    m_Localized: 'Alkonost: É habitual depilar-me. Tento cuidar de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547184
    m_Localized: 'Alkonost: Até mesmo nestes tempos loucos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547185
    m_Localized: 'Alkonost: Normalmente cuido de mim, mas não trouxe a minha lâmina.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547186
    m_Localized: 'Alkonost: Também não há muito tempo para isso agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547187
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547188
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547189
    m_Localized: 'Alkonost: A minha irmã e eu já passámos por muito. Pousa essa arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547190
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547191
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547192
    m_Localized: 'Alkonost: Comecei a fumar há pouco tempo. Por causa de pessoas como tu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547193
    m_Localized: 'Alkonost: Achas que és o único a passar por dificuldades?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547194
    m_Localized: 'Alkonost: Achas que podes apontar a arma a quem te apetece?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547195
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547196
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547197
    m_Localized: 'Alkonost: Para que é isto tudo? O meu olhar pareceu-te demasiado rápido ou vazio?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547198
    m_Localized: 'Alkonost: Para que é isto tudo? O meu olhar pareceu-te demasiado vazio?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547199
    m_Localized: 'Alkonost: Achas que o teu olhar é diferente?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547200
    m_Localized: 'Alkonost: Devias acalmar-te e não tomar decisões precipitadas. Digo isto à minha irmã o tempo todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547201
    m_Localized: 'Alkonost: É uma pena ter de te dizer a ti também.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547202
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547203
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547204
    m_Localized: 'Alkonost: Espera. As notícias disseram mesmo que umas axilas ASSIM são sinal da presença de Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547205
    m_Localized: 'Alkonost: Pensa lá melhor. Não sejas parvo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547206
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547207
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547208
    m_Localized: 'Alkonost: Então, é assim que acaba a minha história.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547209
    m_Localized: 'Alkonost: Com amargura.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547210
    m_Localized: 'Alkonost: A vida sempre nos testou. Foi sempre tudo tão difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547211
    m_Localized: 'Alkonost: A minha irmã não aguentou. Desistiu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547212
    m_Localized: 'Alkonost: Agora percebo. Viste-te numa posição pouco invejável.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547213
    m_Localized: 'Alkonost: Mas se cedes ao pânico, és assim tão diferente dos Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547214
    m_Localized: 'Alkonost: O que acontece se continuares isolado dos outros?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547215
    m_Localized: 'Alkonost: Sabes, estou farta disto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547216
    m_Localized: 'Alkonost: Queria tanto poder parar um pouco e deixar de ter medo o tempo todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547217
    m_Localized: 'Alkonost: Mas continua tudo igual e não parece haver um fim à vista.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547218
    m_Localized: 'Alkonost: Sinceramente, estou aterrorizada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547219
    m_Localized: 'Alkonost: O que vem a seguir? Os Visitantes vão desaparecer ou vamos ter de dividir as nossas cidades com eles para sempre?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547220
    m_Localized: 'Sirin: Trata lá disso de uma vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547221
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547222
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547223
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547224
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547225
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547226
    m_Localized: Ouvidos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547227
    m_Localized: 'Sirin: Dá uma olhada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547228
    m_Localized: 'Sirin: Vais arrancá-los?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547229
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547230
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547231
    m_Localized: 'Sirin: A minha irmã ajuda-me.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547232
    m_Localized: 'Sirin: Mas é inútil.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547233
    m_Localized: 'Sirin: Ela deveria...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547234
    m_Localized: 'Sirin: Ela deveria ter-me deixado a morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547235
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547236
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547237
    m_Localized: 'Sirin: A minha irmã e eu temos olhos parecidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547238
    m_Localized: 'Sirin: Mas os dela não são tão vazios.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547239
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547240
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547241
    m_Localized: 'Sirin: A minha irmã depila-me as axilas. Ela cuida de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547242
    m_Localized: 'Sirin: Suponho que não foi em vão.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547243
    m_Localized: Deixa-a em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547244
    m_Localized: Saca da tua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547245
    m_Localized: 'Sirin: Ainda melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547246
    m_Localized: 'Sirin: Fica com a minha alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547247
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547248
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547249
    m_Localized: 'Sirin: Não é preciso isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547250
    m_Localized: 'Sirin: A morte já está próxima, seja como for.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547251
    m_Localized: 'Sirin: Podes deixar isso comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547252
    m_Localized: 'Sirin: Dá-me a arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547253
    m_Localized: 'Sirin: Eu mesma trato disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547254
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547255
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547256
    m_Localized: 'Sirin: O vazio não desaparece quando fecho os olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547257
    m_Localized: 'Sirin: Apenas passa para ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547258
    m_Localized: 'Sirin: Gostarias disso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547259
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547260
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547261
    m_Localized: 'Sirin: E então?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547262
    m_Localized: 'Sirin: Vais carregar no botão vermelho?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547263
    m_Localized: Dispara sobre ela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547264
    m_Localized: Ouve o que ela tem para dizer
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547265
    m_Localized: 'Sirin: Não tens coragem?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547266
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547267
    m_Localized: 'Sirin: Seja como for, vais morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547268
    m_Localized: 'Sirin: Que pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547269
    m_Localized: 'Sirin: Talvez para a próxima.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547270
    m_Localized: 'Sirin: Que pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547271
    m_Localized: 'Sirin: Não tenho os sinais.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547272
    m_Localized: 'Sirin: Talvez para a próxima.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547273
    m_Localized: 'Sirin: E se isto for só uma preparação para um buraco negro nos consumir?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547274
    m_Localized: 'Sirin: Seremos sugados em direção ao horizonte de eventos por muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547275
    m_Localized: 'Sirin: E nunca veremos o nosso próprio fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547276
    m_Localized: 'Sirin: Agonia eterna e antecipação da morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547277
    m_Localized: 'Sirin: Não importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547278
    m_Localized: 'Sirin: Esperarei pela minha hora, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547279
    m_Localized: 'Sirin: A minha música...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547280
    m_Localized: 'Sirin: Era para ti!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547281
    m_Localized: 'Sirin: Tinha um final feliz!'
    m_Metadata:
      m_Items: []
