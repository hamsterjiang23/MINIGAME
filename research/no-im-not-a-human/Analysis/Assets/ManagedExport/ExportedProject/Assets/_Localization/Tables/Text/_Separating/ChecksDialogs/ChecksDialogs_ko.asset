  - m_Id: 41582931045507543
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507544
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507545
    m_Localized: 'Cultist1: 그래, 안될 것 없지.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507546
    m_Localized: 'Cultist1: ...'
    m_Metadata:
