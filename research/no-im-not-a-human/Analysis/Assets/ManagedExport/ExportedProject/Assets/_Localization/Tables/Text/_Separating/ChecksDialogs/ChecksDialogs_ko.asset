%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_ko
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 9ca4ee10b5b962b4993a5133922046c2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377490604032
    m_Localized: 'Firefighter: *콜록* 네, 뭐 그러시죠. 숨길 것도 없으니까요. 어차피 오래전에 다 타버렸는걸요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769856
    m_Localized: 치아
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: 손
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: 눈
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: 겨드랑이
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: 사진
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: 귀
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: 한번 살펴보세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: 'Firefighter: *콜록* 보시고 너무 뭐라 하진 마세요. 흡연이 치아에 좋지 않은 것이야 뭐 당연하니까요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: 여기요, 한 번 보세요... *콜록*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: 'Firefighter: 마치 그을린 장작 두 덩이 같죠. 그래도 손톱은 깨끗해요. 아이러니하죠?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: 그러세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: 'Firefighter: 보셨나요? *콜록* 숯덩이처럼 빨갛죠. 연기에 그을려서 그렇답니다.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: 'Firefighter: 괜찮으시겠어요? 그다지 보기 좋진 않을 텐데요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: 'Firefighter: 온몸이 그을렸어요... 피부는 오래된 나무껍질처럼 갈라졌고요. 굳이 팔을 들어 올리진 않아요. 그러면 아프거든요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: 'Firefighter: 네, 그러세요. 바싹 익은 숲 속 귀신이나 찍히겠지만요. 뭐 으레 그렇듯이요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: 마음에 들어요? *콜록*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: 'Firefighter: 뭐, 그거야 어렵지 않지요. 다 타버려서 연골만 남았는걸요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: 'Firefighter: 곧 소리나 제대로 들릴지 모르겠어요. 청각만 잃으면 그나마 다행이겠네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: 'Firefighter: 그냥 쏘세요, 집주인 양반. 치아 쪽만 쏘지 말아 주세요. 이미 다 빠지는 중이니까.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: 'Firefighter: 뭐, 이제 더 이상 두려운 것도 없어요. 절 쏴서 마음이 편안해진다면 그렇게 하세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: 이게 훨씬 편하게 가는 방법일지도...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: 'Firefighter: 이 두 손으로 어떤 일을 해왔는지 알기나 하세요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: 'Firefighter: 만약 이 사진이 판결문과 비슷한 거라면, *콜록* 그냥 후딱 해치우죠. 여하튼 여기 계속 있을 이유도 더 이상 없으니까요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: 'Firefighter: 모든 게 불타고 있죠... 이제 그냥 제 차례인가 싶네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: 'Firefighter: 그게 말이죠, *콜록* 애들에게 매일 양치를 시키려고 했는데 그럴 수가 없었죠. 그리고... 이제 애들에게 그러라고 할 사람도 없게 돼버렸네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: 'Firefighter: 이 손으로 *콜록* 사람들을 구해냈었죠. 이제는 머그잔도 제대로 쥐지 못하는 신세지만요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: 그럼, 그렇게 됐군요...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: 뭐, 이제 제가 죽을 차례가 됐네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: 'Firefighter: 숲이 불타오를 때면 *콜록*... 숲이 잿더미로 변하는 모습을 지켜보기만 하게 되겠죠. 선생님이 할 수 있는 건 아무것도 없다는 걸 알게 될 겁니다.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: 'Firefighter: 밤에 깨면 말 그대로 피부가 찢어지는 듯한 느낌이 들 때가 있어요. 무슨 짓을 해도 아파요. 화재가 모든 것을 앗아갔어요...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: 'Firefighter: 화재 시 건질 수 있는 거라곤 기억뿐이에요. 육신의 소멸은 그저 시간 문제일 뿐이고요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: 'Firefighter: 주위의 모든 것이 불타오를 때면, 고요함이 얼마나 소중한지 깨닫게 될 거예요. 귀는 멀쩡할지 모르겠지만, 과연 영혼도 그럴까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: 'Wheelchair: 그렇군요. 뭐, 그럼 검사를 해보시죠. 모든 검사를 통과할 테니까요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: 치아
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
    m_Localized: 손
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964176
    m_Localized: 눈
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964177
    m_Localized: 겨드랑이
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964178
    m_Localized: 사진
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964179
    m_Localized: 귀
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: 여기요, 봐보세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: 이 치아야말로 진짜 보물이라 할 수 있죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: 'Wheelchair: 치아가 아니라 금이거든요! 뭐 당연히 다 그런 건 아니지만, 훨씬 늘어날 예정이랍니다.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: 'Wheelchair: 앞니로 맥주캔 따기가 얼마나 쉬운지 모르실 걸요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: 넵, 이정도만 돼도 엄청난 거죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: 'Wheelchair: 적어도 손은 남아있으니, 그것만 해도 감지덕지죠 뭐.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: 'Wheelchair: 손마저 없었으면, 레이싱조차 할 수 없었을 테니까요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: 잠시만요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: 손가락이 없어졌잖아!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: 'Wheelchair: 어제는 손가락 하나만 없었는데. 나머지 손가락이 어디로 갔을까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: 'Wheelchair: 뭐, 다시 자라겠죠. 조금만 기다리면요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: 손가락이 사라졌네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: 'Wheelchair: 별 일 아니긴 하지만, 조금 언짢네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: 'Wheelchair: 하지만 손톱은 약간 다시 자라났어요, 보이시나요?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: 'Wheelchair: 그말인즉슨 제 다리도 다시 자랄 거란 말이죠. 조금만 기다리면요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: 'Wheelchair: 어디를 쳐다볼까요? 선생을 똑바로 쳐다볼까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: 'Wheelchair: 살짝 떨리는 거 보이시나요? 습관이에요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: 'Wheelchair: 엔진을 미친 듯이 돌리기 시작한 이후로, 음 그러니까... 아무것도 제대로 쳐다볼 수 없게 됐죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: 'Wheelchair: 뭐 저는 속도를 줄일 준비가 안 된 남자라고 해두죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: 아앗.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: 'Wheelchair: 그래요, 그러시던지요. 하하하하, 좋아, 좋아요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: 그렇군요. 코메디도 이런 코메디가 없겠네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: 'Wheelchair: 별안간 겨드랑이를 보여달라고 하시고, 그걸 보여드리고 있다니.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: 'Wheelchair: 바깥은 지옥불에 휩싸여 있고, 우주는 행성 자체를 지워버리고 싶어 하는 와중이죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: 방문자는 우리를 말살하고 싶어 하고요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: 'Wheelchair: 그런데 고작 한다는 말이 "겨드랑이를 내놓거라!" 라니.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: 하하하핫!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: 사진이요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: 'Wheelchair: 그다지 좋아하는 편은 아니지만, 알겠어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: 이런 제길, 눈을 깜빡였네.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: 'Wheelchair: 하하하핫! 조오옿습니다!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: 선생도 그 방송을 보신 게로군요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: 'Wheelchair: 암, 그렇겠지요. 으음? 그쵸?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: 잠시만요, 농담이 아니시군요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: 그건 좀... 엿같은데요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: 'Wheelchair: 저기요, 이제 맘대로 맥주를 꺼내 마시지 않을 테니까요. 너무 감정적으로 생각하지 말아 주세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: 열받은 사람한테 우리가 어떻게 하는지 아세요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: 휠체어로 밀어버리는 거죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: 'Wheelchair: 열받으신 거라면, 저랑 드라이브라도 하시죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: 왜죠?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: 그런다고 딱히 제게 도움이 되진 않는데요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: 'Wheelchair: 선생한테도 아마 아무 도움이 안 될 거고요. 그런데 총 들고 뭐 하시는 거예요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: 'Wheelchair: 총알을 눈으로 쫓을 수는 없겠지요. 하지만 피하려고는 해볼 거예요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: 'Wheelchair: 사람들이 왜 제모를 하는지 도통 이해가 안 되더군요. 몸에 난 털은 천연 방벽이나 다름없는데.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: 'Wheelchair: 저기 빨간 부분 보이시죠? 거기서 손가락을 기르는 중이에요. 예비용으로요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: 'Wheelchair: 아아, 진짜 코메디는 아직 시작도 안 했는데.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: 'Wheelchair: 이번 생은 어디부터 잘못된 걸까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: 'Wheelchair: 왜 하필 사진이람? 왜 이런 말도 있잖아요? "숨을 깊게 들이쉰다고 해서 죽음을 피할 순 없다"'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: 'Wheelchair: 뭔가 하고 싶은 말이 있었는데...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: 저기요, 그냥 나갈 테니까요, 네?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: 'Wheelchair: 뭐, 결국은 이럴 줄 알았어.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: 'Wheelchair: 조만간, 주님이 널 심판하실 거다.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: 절대 조용히는 안 죽는다.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: 'Wheelchair: 결국 고깃덩어리의 생물학적 반응에 불과하다고요, 네?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: 'Wheelchair: 이전에는 왜 함께 웃고 떠들다가, 이제 와서 서로의 머리통을 날려버리려고 하는 거죠?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: 죽을 준비를 해야겠어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: 이제 제 손만이 제게 남은 엔진이죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: 클러치는 없고요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: 'Wheelchair: 솔직히 말하자면, 언젠가 이마저도 잃을지도 모른다고 생각하면 무서워요. 정말 그러면 어쩌죠?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: 'Wheelchair: 주위를 돌아다닐 방도가 전혀 없다니 싫어요. 영원히 처박힌다니요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: 죽는다 해도 그것보단 무섭지 않을 거예요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: 'Wheelchair: 어떻게 보시건 간에, 시간을 따라잡을 수는 없는 노릇이죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: 'Wheelchair: 나이가 먹을수록 시간이 빨리 간다는 걸 아시나요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: 'Wheelchair: 어릴 땐 삶을 살아가는 데 아무런 조급함도 없었죠. 어렸을 적엔 어려운 게 하나도 없었고요. 책임질 일도, 어려운 결정을 내릴 필요도 없었으니까요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: 'Wheelchair: 하지만 이제는, 아무리 서둘러도, 절대로 따라잡을 수가 없는 듯하네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: 'Wheelchair: 이봐요, 어찌 된 게, 갑자기 전혀 웃을 기분이 안 나네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: 선생이 하는 웃기지도 않은 검사며, 화재를 진압해 보겠다고 애쓰는 사람들까지...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: 'Wheelchair: 다들 세상을 구하고 싶다고들 하는데, 어떻게 구할 건지는 다들 제각각이에요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: 'Wheelchair: 의미가 있긴 할까요? 그저 좀 내려놓고, 애써서 고민하지 말아야 하는 걸지도.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: 이봐요...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: 이쯤이면 우리의 드라이브도 끝난 거 아닐까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: 'Wheelchair: 종착역에 다다른 거죠. 곧 떠나야만 하고요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: 창밖으로 마지막 정거장이 보이는 거죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: 끝마칠 준비는 되셨나요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: 'Wheelchair: 그럴 거라고 생각했어요. 화내지 마세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: 'Wheelchair: 만약에... 하나의 징후로 완벽하게 판별이 안 된다면, 다른 징후도 마찬가지인 것 아닌가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: 'Wheelchair: 다른 징후들 전부 방문자일 가능성을 똑같이 열어두잖아요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: 'Wheelchair: 사람은 곧잘 실수를 하죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: 'Wheelchair: 하지만 이런 걸로 실수를 한다면 끔찍한 결과가 뒤따를 수 있으니까요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: 'Wheelchair: 만약에... 만약에 하나의 징후를 토대로 판별하기로 했다면, 다른 징후로 여태껏 한 판별은 어떻게 믿을 수 있겠어요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: 'Wheelchair: 다른 징후로 했던 판별 역시 말이 안 될 수도 있잖아요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: 'Wheelchair: 물론 우리는 인간이니까요. 누구나 실수를 할 수 있죠, 그렇죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: 'Wheelchair: 하지만 이런 걸로 실수를 한다면 끔찍한 결과가 뒤따를 수 있으니까요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: 'Wheelchair: 당신... 손가락 한 번만 잘못 까딱해도 뭔가가 잘못돼서, 누군가의 목숨을 끝장낼 수도 있겠죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: 'Wheelchair: 만약 본인이 내린 선택에 확신이 있으시다면... 그렇게 확신할 수 있다는 게 참 부럽네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: 'Mother: 부디요, 검사를 진행해 주세요. 숨기는 것도 없는 걸요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: 치아
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: 손
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: 눈
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: 겨드랑이
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: 사진
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: 귀
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: 해보시라니까요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: 'Mother: 그게, 그다지 치아에 신경을 쓰는 편은 아니었거든요. 시간이 없어서요. 이제 와서야... 후회하는 중이지만요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964303
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964304
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: 여기요, 보셔요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: 'Mother: 손바닥이 아니라 거의 삽이죠. 애들을 키우다 보니까.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964307
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964308
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: 그럼 살펴보세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: 'Mother: 엄청 크게 쳐진 부분이 보이시나요? 잠을 잘 못 자서 그래요...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964311
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964312
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: 그럼 살펴보세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964314
    m_Localized: 'Mother: 데오도란트를 다 써버린지 오래라서요. 너무 뭐라고 하지 말아 주세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964315
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964316
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: 'Mother: 앉아도 될까요? 안된다고요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964318
    m_Localized: 'Mother: 항상 그렇지만 너저분하고 신경질적인 모습으로 찍히겠군요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964319
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964320
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: 'Mother: 귀청소를 하지 않은지 정말 오래됐는데요. 막혀있을 수도 있겠네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: 'Mother: 애들이 하도 소리를 질러대는 통에 이미 반쯤은 귀머거리인 상태이지만요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964323
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964324
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: 'Mother: 양치질할 때마다 잇몸에서 피가 나기 시작한지가 벌써 일주일 째에요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: 'Mother: 그래도 이빨이 계속 누래요. 하지만 이런 애들을 데리고 어떻게 담배를 끊을 수가 있겠어요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964327
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964328
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: 'Mother: 세제 때문에 생긴 발진이 있어요. 시간이 없어서 병원에는 못 가봤고요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: 'Mother: 당신이 살아만 있다면 언젠가 당신에게 수프라도 한 그릇 끓여줄 수 있는 손이라고요! 그런데 저한테 총구를 들이미시다니...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964331
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964332
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: 'Mother: 제 눈앞에서 수류탄을 꺼내 들어도, 제가 밤에 푹 잘 수는 없을 거예요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964334
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964335
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: 'Mother: 이거 뭐, 냄새가 나니까 절 쏘시겠다는 거예요? 어이가 없네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964337
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964338
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: 'Mother: 이거 뭐, 사진 한 장으로 사람을 판단하신다는 건가요? 어이가 없네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964340
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964341
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: 'Mother: 제 귀가 마음에 안 들어서 절 쏘시겠다니 정신이 나가셨군요. 어떤 부분이 마음에 안 든다는 건가요? 스카프로 가려놓던지 할 테니까!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964343
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964344
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: 드디어 아무도 날 귀찮게 할 수 없겠네...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: 지독하구먼...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: 'Mother: 저기요, 우리 아이들 중에 치열이 완벽한 아이가 한 명 있어요. 그런데 걔는 한 번도 웃질 않았죠. 사실 치아와는 아무런 상관도 없는 거 아닌가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: 'Mother: 손이라... 아이들을 안아주고, 집안일을 하고, 남편을 쓰다듬는 데 손을 썼어요. 그런데 그거 알아요? 그 누구도 고마워하지 않았다는 거.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964349
    m_Localized: 'Mother: 아이가 아프면 며칠이고 잠을 잘 수 없죠. 그러다 보면 거기에 익숙해져서 그냥 악몽 속에서 살아가는 셈이 돼요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964350
    m_Localized: 'Mother: 한 번은 너무나 피곤해서 한 일주일은 샤워를 못했어요. 애들은 제가 그러는지도 전혀 몰랐고요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964351
    m_Localized: 'Mother: 한 번은 우리 아이들이 전부 웃고 있는 사진을 찾아낸 적이 있었어요. 잠이 들때까지 언제까지고 그 사진을 보고 있었죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964352
    m_Localized: 'Mother: 때로는 차라리 제가 귀머거리였으면 하는 때도 있어요. 하지만 아이들이 전부 잠들고 나면 더할 나위 없이 행복한 고요가 밀려드는데... 그 맛에 사는 거죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: 'Anger: 진심이야? 씨발... 뭐, 그래, 할 거면 빨리 해!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: 치아
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: 손
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: 눈
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: 겨드랑이
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: 사진
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: 귀
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: 'Anger: 씨발 뭐 그러던지. 자.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: 'Anger: 누렇다고? 뭐, 씨발 어쩌라고.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: 'Anger: 새하얗다고? 나처럼 이기적인 사람이 새하얗다고?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: 'Anger: 내 이빨이 이렇게 생겨먹었을 바에야, 하나쯤은 금니를 달아야겠다고 생각했었다고. 영화에 나오는 깡패들처럼 말이지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: 뭐, 그러던지 말던지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: 'Anger: 휘유, 정말 크구만.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: 'Anger: 하. 우리 할머니는 손이 이러면 나무를 베기에 딱이라고 하셨는데... 지금 하는 일을 할 게 아니라.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: 'Anger: 여기에는 벨 것도 없는데, 화를 어떻게 삭히라는 거야.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: 'Anger: 그러든지 말든지. 쳐다보고 싶은 만큼 쳐다보쇼.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: 'Anger: 뭐야, 색깔이 마음에 들어? 파란색이지. 날 때부터 그랬어. 이 눈으로 아가씨들을 잔뜩 꼬셨다니까.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: 씨발 그러거나 말거나.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: 그래, 난 제모를 하거든.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: 'Anger: 겨드랑이에 털이 있는 그 느낌을 참을 수가 없거든. 빌어먹을 풀떼기가 거기서 자라는 기분이라니까.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: 그러시던지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: 'Anger: 뭐야? 씨발 왜 날 그따위로 쳐다보는데? 뭐라도 보여?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: 씨발...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: 'Anger: 왜 날 그따위로 꼬나보는데? 뭐 찾는 거라도 있어?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: 'Anger: 너 이 병신새끼, 드디어 정신이 나갔구나? 이빨이라면 순순히 보여줬잖아!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: 'Anger: 총이고 나발이고, 내가 선빵을 날려서 그 좆같은 목구멍을 먼저 날려버릴 수 있다는 생각은 안 해봤어?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: 'Anger: 이게 씨발 무슨 짓거리야? 뭐 질투라도 나는 거야?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: 'Anger: 진짜 계속 가려워서 미칠 지경이라고.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: 'Anger: 피가 나도록 긁어대면, 가려운 게 조금은 나아지고.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: 'Anger: 이게 진짜 무슨 개소리야! 이런 씨발 정신 나간 새끼!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: 'Anger: 빌어먹을 사진 때문에 날 쏘겠다고?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: 'Anger: 그건 함부로 다뤄도 되는 장난감이 아니야.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: 'Anger: 그러다 갑자기 내 귀가 마음에 안 든다고 날 쏴버릴 수도 있잖아.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: 'Anger: 네놈 지금 아주 그냥 제정신이 아닌 것 같아. 정신 좀 차려, 개새끼야!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: 'Anger: 이런 인정머리 없는 씹새끼를 봤나.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: 씨발.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: 'Anger: 할머니에겐 금이빨이 있었어. 어렸을 때부터 그런 금니가 있었으면 했었지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: 'Anger: 마치 할머니 입 속에 태양이 박혀있는 것처럼 반짝였거든.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: 'Anger: 할머니가 말씀하시길 오래된 이가 썩은 다음에 금니를 씌워두셨다고 하셨지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: 'Anger: 그 말을 들으니 너무 좋았어. 뭐 "와아, 좋아라! 때가 되면 내게도 금니를 씌워주겠구나." 하고 생각했지 뭐야.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: 'Anger: 이제... 뭐, 때가 되긴 했네. 금니고 뭐고 아무것도 받진 못했지만.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: 'Anger: 입 안에 태양을 머금고 있지도 않고 말이야. 그냥 누런 오줌 색깔 이빨 뿐이지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: 'Anger: 이 손이 보여? 네가 보기엔 더럽고 피투성이겠지. 그렇지만 아무리 못났어도 내 손이지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: 'Anger: 가끔은 손이 너무 가려워서, 살가죽을 몽땅 벗겨내고 싶다니까. 벽에 주먹질이라도 하던지. 아니면 살가죽을 벗겨내는 와중에 주먹질을 한다던지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: 'Anger: 더 이상 참을 수가 없어. 하지만 누굴 해치고 싶지는 않아.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: 'Anger: 여기 손톱이 보여? 네가 보기엔 더럽고 피투성이겠지. 그렇지만 아무리 못났어도 내 손이지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: 'Anger: 가끔은 손이 너무 가려워서, 살가죽을 몽땅 벗겨내고 싶다니까. 벽에 주먹질이라도 하던지. 아니면 살가죽을 벗겨내는 와중에 주먹질을 한다던지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: 'Anger: 내가 딴 사람 같았으면 스스로에게 무슨 짓을 할지 걱정했을 지도 모르겠네. 근데 말이지, 난 좆도 신경 안 써.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: 'Anger: 할머니는 내 눈을 두고 항상 "천사 같은 아가"라고 부르셨는데. 이런. "천사"는 니미.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: 'Anger: 이제는 내면의 거울이라는 내 눈깔을 쳐다보면서 이런 생각을 하는 중이지. "대체 내 어디가 천사 같다는 거야?"'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: 'Anger: 그저 할머니가 날 어떻게 쳐다보던지만 떠오르네. 실망한 기색이 역력하셨지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: 'Anger: 이봐, 알다시피 면도칼은 꽤나 날카로워서 뭔가... 를 하기에 매우 적합하지. 말처럼 쉽지는 않아서 문제지만...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: 'Anger: 하지만 결국은 내 팔을 긁어내는 데서 그치고야 말았지. 이제 어쩌다 제모를 하면, 털을 자른다기보다는, 스스로를 잘라내고 있는 듯하다고.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: 'Anger: 그래도 제모는 꼬박꼬박 해. 풀때기가 자라나는 좆같은 기분이 싫어서.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: 'Anger: 할머니 사진조차 없는데. 할머니는 망할놈의 사진 찍는 걸 싫어하셔서.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: 'Anger: 할머니께서는 사진이 찍히는 순간, 영혼이 사진 속에 갇혀서 빠져나올 수 없다고 하셨거든.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: 'Anger: 나는 그 말에 코웃음을 치며 할머니께 이렇게 말했지. "에이 설마요, 할머니, 말도 안 된다고요."'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: 'Anger: 그러자 이러셨어. "내가 죽거든, 넌 내 사진을 보면서 내가 천국에 있을까 생각하게 될 게야."'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: 'Anger: 뭐, 좆같은 일이지. 사진도, 할머니도 없으니.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: 'Anger: 이따금씩 귓불을 잡아당기곤 하는데, 귓불이 아주 뜨거워졌을 때만 그러는 편이지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: 'Anger: 뭐 신경을 많이 쓰거나 그래서인 줄 알았어.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: 'Anger: 그러다 문득 깨닫게 됐지. 그저 거슬려서 뜯어버리고 싶어서 그러는 거라고.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: 'Anger: 하지만 내 몸을 스스로 자를 정도로 내가 정신이 나가진 않은 모양이야, 그렇지?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: 그렇지??'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: 'FortuneTeller: 아이고, 우리 잘생긴 양반, 그런 기운을 지니고 있으니 저항할 줄 알고는 있었어요. 그래도 검사를 함께 해봐요. 어차피 저야 그쪽을 훤하게 꿰뚫어 볼 수 있으니.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: 치아
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: 손
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: 눈
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: 겨드랑이
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: 사진
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: 귀
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: 좋아요, 살펴보셔요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: 'FortuneTeller: 우리 내면의 우주를 투영하는 곳은 눈이지, 치아가 아니랍니다. 헌데도 정녕 치아로 운명을 점쳐보고 싶으신 건가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: 'FortuneTeller: 우리 내면의 우주를 투영하는 곳은 눈이지, 치아가 아니랍니다. 치아는 뭐하러 쳐다보시겠다는 건가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: 좋아요, 살펴보도록 하시지요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: 'FortuneTeller: 드림캐처 때문에 박힌 꿈의 조각들을 아직 빼내지 않았답니다. 그러니 조심하셔야 해요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: 'FortuneTeller: 오, 제 눈을요? 물론 갈색이지요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: 'FortuneTeller: 뭐, 붉은 반점이 있는 부분은 빼놓고요. 달 때문에 이런 거예요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: 'FortuneTeller: 아아... 우주가 나의 여로에 쳐두는 장난이란... 그래요, 한 번 살펴보도록 하세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: 'FortuneTeller: 아시다시피, 이런 상황에서 스스로를 가꾸기란 참으로 어려우니...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: 'FortuneTeller: 조심하세요. 제 아우라 때문에 실명하실 수도 있을 테니까요!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: 'FortuneTeller: 그래서요? 어떻게 생각하시나요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: 'FortuneTeller: 살펴보시되, 조심하시길. 제 귀는 모든 걸 들을 수 있거든요. 당신의 생각조차도요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: 'FortuneTeller: 그래서요? 답은 찾으셨나요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: 'FortuneTeller: 제 치아 때문에 저를 쏘시겠다고요? 저 때문이 아니라는 거 제대로 이해하고 계신 거 맞죠? 그저 화성이 금성에 앙심을 품었기 때문이라고요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: 'FortuneTeller: 진심으로요? 제 손에 꿈의 조각이 남아있으니 절 쏘시겠다는 건가요? 이건 드림캐처를 사용했을 때의 흔적에 불과하다고요!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: 'FortuneTeller: 제정신이세요?! 달이 그저 장난을 친다는 걸 설마 모르시는 건가요? 달의 움직임을 일일이 추적하는 건 애들 장난이 아니라고요!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: 'FortuneTeller: 제정신이세요?! 달이 그저 장난을 친다는 걸 설마 모르시는 건가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: 'FortuneTeller: 이런 건 제대로 된 점성술이 아니라, 그냥 횡포라고요! 총을 치워주시면 제 비밀을 훨씬 더 많이 알려드릴 테니까요! 그것도 공짜로요!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: 'FortuneTeller: 저기요! 자기가 볼 준비가 안 된 게 어찌 제 탓이겠어요!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: 'FortuneTeller: 그것 좀 치워주실래요? 귀를 본다고 뭘 알 수 있다는 건가요? 귀란 현명한 자들의 이야기를 듣기 위해 필요한 거라고요!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: 'FortuneTeller: 날 죽이면, 영원한 저주를 받을 게다...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: 영원한 설사의 저주를!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: 'FortuneTeller: 한 번은 치열이 완벽한 남자가 절 찾아온 적이 있었어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: 'FortuneTeller: 그에게 제가 말했죠. "모든 게 다 괜찮지만, 그대의 영혼은 썩었답니다!" 뭐가 더 중요한지 생각해 보도록 하세요. 아시겠나요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: 'FortuneTeller: 한 번은 의식을 치른 후에 꿈의 파편을 뽑아내느라 밤을 새운 적이 있어요. 아프긴 하지만, 뽑아낸 파편 하나하나가 모두 우주가 제게 주는 교훈과도 같았죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: 'FortuneTeller: 눈은 다른 세계로의 통로라고들 하죠. 어떤 남자를 봤었지요. 그 남자의 눈은 촛대처럼 빛나고 있었고요. 그는 이를 두고 사랑이라 했지만, 실상은 그저 화성일 뿐이었어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: 'FortuneTeller: 한 번은 삼 주 동안 금욕 생활을 하며 꾼 꿈에 대해서만 생각하면서 지냈던 적이 있었죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: 'FortuneTeller: 생각이란 곧 소재와도 같으니, 이는 제가 소망에 다가가는 방법이랍니다. 그저 제대로 된 소원만 빌면 해결되는 문제이지요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: 현재 제 상태를 요약하자면 그렇겠네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: 'FortuneTeller: 한 번은 제 사진을 찍고 나서 생각했지요. "별들이 내게 흔적을 내려주셨구나!" 그러고선 곧바로 그냥 조명 때문에 그랬다는 걸 깨달았어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: 'FortuneTeller: 한 번은 우주가 제게 말을 거는 듯한 소리를 제 귀로 들은 적이 있어요. 그렇지만 아무래도 우주보다 훨씬 강력한 무언가였던 듯해요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: 'FortuneTeller: 한 번은 우주가 제게 말을 거는 듯한 소리를 제 귀로 들은 적이 있어요. 알고 보니 그냥 바람 소리였지만요. 그래도 좋았어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158522
    m_Localized: 'Fanatic: 뭘 확인한다는 겐가?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158523
    m_Localized: 치아
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158524
    m_Localized: 손
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158525
    m_Localized: 눈
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158526
    m_Localized: 겨드랑이
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158527
    m_Localized: 사진
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158528
    m_Localized: 귀
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158529
    m_Localized: 'Fanatic: 치아를 보여달라고?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158530
    m_Localized: 'Fanatic: 나의 이는 진실을 위해 떨쳐 일어났도다!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158531
    m_Localized: 'Fanatic: 그러고선 이내 떨어졌지...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158532
    m_Localized: 'Fanatic: 직접 확인해 보시게나.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158533
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158534
    m_Localized: 'Fanatic: 나의 건강한 치아 관리의 비결은 바로 맥주지. 칼슘을 보호하는 역할을 해주거든.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158535
    m_Localized: 'Fanatic: 맥주가 없었으면, 아마 진작에 이가 다 빠져버렸을 게야.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158536
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158537
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158538
    m_Localized: 'Fanatic: 이해한다네, 그렇고 말고.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158539
    m_Localized: 'Fanatic: 당장은 버거울 정도로 많은 일이 일어나고 있지만, 우리는 이렇게 살아있지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158540
    m_Localized: 'Fanatic: 우리는 살아나갈 게야.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158541
    m_Localized: 'Fanatic: 이런, 그대 정녕 그림자 속에 너무 오랫동안 머물러 버리고 만 겐가?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158542
    m_Localized: 'Fanatic: 편히 쉬게, 나의 친구여.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158543
    m_Localized: 'Fanatic: 마음껏 보게, 나의 친구여!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158544
    m_Localized: 'Fanatic: 성에 찰 만큼 내 손톱을 보게나.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158545
    m_Localized: 'Fanatic: 유익한 태양광을 손으로 제대로 흡수하려고 부단히 단련했지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158546
    m_Localized: 'Fanatic: 맥주 뚜껑도 열고.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158547
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158548
    m_Localized: 'Fanatic: 그냥 확인해 보고 싶었던 겐가?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158549
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158550
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158551
    m_Localized: 'Fanatic: 내 눈을 들여다 보라!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158552
    m_Localized: 'Fanatic: 나의 두 눈은 분노와 울화로 가득 차 있으니.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158553
    m_Localized: 'Fanatic: 나의 어두운 눈을 들여다 보라!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158554
    m_Localized: 'Fanatic: 이 두 눈으로 빛의 유익한 성분을 빨아들여, 이를 에너지로 전환하지로로로로롱.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158555
    m_Localized: 'Fanatic: 눈으로 모든 에너지를 얻는다 이 말이야!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158556
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158557
    m_Localized: 'Fanatic: 내 눈에 깃든 태양의 정의로운 힘을 봤는가?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158558
    m_Localized: 'Fanatic: 보지 못했다면, 자네는 장님이나 마찬가질세. 나처럼 태양을 좀 더 오랫동안 쳐다볼 수 있게끔 노력하게나.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158559
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158560
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158561
    m_Localized: 'Fanatic: 사진이라?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158562
    m_Localized: 'Fanatic: 흠... 흐흐흠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158563
    m_Localized: 'Fanatic: 내가 태양의 지도자 본인과 안면을 튼 사이라는 이야기를 못 들어봤나 보군?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158564
    m_Localized: 'Fanatic: 그래, 바로 이 몸께서 그 친구에게 태양을 들여다 보라고 알려줬네만, 그 이야기는 나중에 해주도록 하지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158565
    m_Localized: 'Fanatic: 해치우게. 내 사진을 찍도록!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158566
    m_Localized: 'Fanatic: (당신은 얼빠진 남자의 사진을 찍는다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158567
    m_Localized: 'Fanatic: (실물과 똑같이, 사진에 비친 그의 모습은 단정치 못하고 더럽다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158568
    m_Localized: 'Fanatic: (딱히 무슨 왜곡현상은 보이지 않는다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158569
    m_Localized: 'Fanatic: 아주 환상적으로 나왔구먼!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158570
    m_Localized: 'Fanatic: 날 보러 오게, 내 삶에 대한 이야기를 해줄 테니.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158571
    m_Localized: 'Fanatic: 그러면 이야기의 대가로 헌금을 조금 받도록 하겠네.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158572
    m_Localized: 'Fanatic: 헌금은 태양 에너지를 저장하는 데 쓰겠네!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158573
    m_Localized: 'Fanatic: 한번 쏴보게! 진실이 날 보호해 줄 것이니!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158574
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158575
    m_Localized: 'Fanatic: 총 좀 치워주겠나?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158576
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158577
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158578
    m_Localized: 'Fanatic: 뭐어, 손에 맥주가 없으면 쬐에에에에끔 곤란하거든.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158579
    m_Localized: 'Fanatic: 쬐에에에에끔 곤란하다구.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158580
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158581
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158582
    m_Localized: 'Fanatic: 인간, 왜 이런 짓을 하는 겐가?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158583
    m_Localized: 'Fanatic: 단단히 미쳤구나, 계몽되지 못한 자여!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158584
    m_Localized: 'Fanatic: 눈에는 눈이라는 말이 있긴 하지만, 눈 좀 보여줬다고 대뜸 쏴버리겠다니...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158585
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158586
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158587
    m_Localized: 'Fanatic: 이런, 이건 너무 과하지 않은가!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158588
    m_Localized: 'Fanatic: 우리의 활기에 아무 도움도 되지 않을 걸세.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158589
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158590
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158591
    m_Localized: 'Fanatic: 잠시만, 내 손이 마음에 들지 않는다고?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158592
    m_Localized: 'Fanatic: 대체 왜지?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158593
    m_Localized: 'Fanatic: 이런 구두쇠에, 멍텅구리 같은 작자를 봤나, 맥주나 내놓게.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158594
    m_Localized: 'Fanatic: 다른 사람이 하는 일을 빤히 쳐다보면 안된다고들 하잖아.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158595
    m_Localized: 'Fanatic: 그럼 뭘 어쩌라는 거지? 평생 먼 산이나 쳐다보며 살아야 하나?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158596
    m_Localized: 'Fanatic: 아, 잠시만, 기다려 보게...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158597
    m_Localized: 'Fanatic: 그게 "가만히 쳐다보면" 이였던가...?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158598
    m_Localized: 'Fanatic: 잠깐만, 기다려 보라니까...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158599
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158600
    m_Localized: 'Fanatic: 에라 모르겠다.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158601
    m_Localized: 'Fanatic: 맞아.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158602
    m_Localized: 'Fanatic: 자네라면 태양을 쏠 리가 없는데!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158603
    m_Localized: 'Fanatic: 내 걱정은 말게. 딱히 상처받은 것은 아니니.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158604
    m_Localized: 'Fanatic: 자네는 시원하면서도, 생기가 돌게 해주는 액체를 넉넉하게 보유하고 있으니 말이야!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158605
    m_Localized: 'Fanatic: 아아, 이런 장난꾸러기 같으니라고, 으응?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158606
    m_Localized: 'Fanatic: 좋아, 혹시 킁킁대며 냄새를 맡아보고 싶은 거라면 맡아보게.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158607
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158608
    m_Localized: 'Fanatic: 이게 바로 자기관리의 성과다 이 말이야.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158609
    m_Localized: 'Fanatic: 아아, 이런 장난꾸러기 같으니라고, 으응?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158610
    m_Localized: 'Fanatic: 좋아, 혹시 킁킁대며 냄새를 맡아보고 싶은 거라면 맡아보게.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158611
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158612
    m_Localized: 'Fanatic: 이것이 바로 태양께서 임하신 결과라네.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158613
    m_Localized: 'Fanatic: 생기를 유지하기 위한 활력수가 나오거든!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158614
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158615
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: 뭘 확인하신다는 건가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: 치아
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: 손
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: 눈
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: 겨드랑이
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: 사진
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: 귀
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: 'Anxiety: 하, 뭡니까. 제 치아를 보고 결정을 내리실 거라고요? 휘유우우우.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: 치아 교정을 받은지 얼마 안 됐는데요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: 사실, 솔직히 말하자면...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: 'Anxiety: 치과에 가본 기억은 딱히 없어요. 가본 적이 있기나 했던가?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: 'Anxiety: 세상에나, 너무 무서워서 어제 뭘 먹었는지도 기억이 나질 않아요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158629
    m_Localized: 'Anxiety: 그래서... 제가 그 녀석들의 생김새와 일치하나요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158632
    m_Localized: 'Anxiety: 제가 방문자라고요? 어째서죠? 어째서?! 그럴 리가요!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158633
    m_Localized: 'Anxiety: 아아아아 제발, 집에서도 쫓겨나고, 직장에서도 쫓겨났는데, 이제 제 몸도 머리에서 쫓겨날 신세라니요...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: 'Anxiety: 제 손톱을 보시겠다고요? 좀 희한하긴 하지만...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: 'Anxiety: 그렇지만 알겠어요. 살펴보세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: 'Anxiety: 뭐라도 묻었나요? 흙이 묻었을 리는 없는데.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: 'Anxiety: 그게... 딱히 땅을 팠다거나 한 기억은 전혀 없어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: 대체 이런 게 왜 묻어있담?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158644
    m_Localized: 'Anxiety: 제가 더러운 상태로 며칠이나 돌아다녔을 리는 없잖아요. 그쵸?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158645
    m_Localized: 'Anxiety: 정말... 이상하네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158648
    m_Localized: 'Anxiety: 아니 그렇잖아요! 흙이 대체 어디서 묻었는지 기억이 나질 않아요. 저야 그저 선생님 집에 쭉 앉아 있었는걸요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158649
    m_Localized: 'Anxiety: 혹시... 혹시 누군가 제 손톱 아래에 고의로 흙을 묻혀둔 걸까요? 대체 누가 그런 짓을?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: 제 눈을 확인해보고 싶으시다고요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158651
    m_Localized: 'Anxiety: 결과가 어떻게 될지 알겠네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158652
    m_Localized: 'Anxiety: 제 눈에 징후가 있다면 어떻게 되는 건가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158654
    m_Localized: 'Anxiety: 네, 뭐. 딱히 다른 수가 없긴 하겠네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158657
    m_Localized: 'Anxiety: 제가 진짜로 방문자라고요? 어떻게 생각하시나요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158658
    m_Localized: 'Anxiety: 그런데 어떻게 제가 그걸 모를 수가 있죠? 아마 이런 식으로 인간에서 방문자로 변이하는 건가 봐요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158659
    m_Localized: 'Anxiety: 나는 다른 사람들과는 다르고, 사회 최악의 구성원이라는 생각을 하는 것만으로도 충분한 게 아닐런지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: 죽는다니 무서워요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158663
    m_Localized: 'Anxiety: 잠시만요, 혹시 붕대같은 걸 받을 수 있을까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158664
    m_Localized: 'Anxiety: 아니면 그냥 이대로 잠시 서 있게라도 해주세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158665
    m_Localized: 'Anxiety: 제가 방문자로 판명되면, 막 사람을 죽이기 시작하는 걸까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158666
    m_Localized: 'Anxiety: 제가 갑자기 막 위험한 사람이 된다고요? 아니면 이미 쭉 위험했다던지?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158667
    m_Localized: 'Anxiety: 혹시 이미 제가 사람을 죽였다거나?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: (당신은 여자의 사진을 찍는다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158669
    m_Localized: 'Anxiety: (현상된 사진엔 선명한 배경과 함께, 어딘가 흐릿하게 뭉개진 인물의 형체가 담겨 있다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158670
    m_Localized: 'Anxiety: (사진이 찍히는 순간 사람이 움찔한 듯하다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158671
    m_Localized: 'Anxiety: 하하하, 말도 안 되죠? 방금 움찔했거든요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158672
    m_Localized: 'Anxiety: 이제 어떻게 되는 건가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158673
    m_Localized: 'Anxiety: 절 살려주실 수 있나요? 아니면 그냥 절 죽여버리는 게 나을까요? 어떻게 하실래요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: 왜죠?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: 그냥 진작에 절 쏴버리시는 게 편하지 않았을까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158678
    m_Localized: 'Anxiety: 떠나가고 싶지만, 너무나 무서워요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158679
    m_Localized: 'Anxiety: 어쩌면...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158680
    m_Localized: 'Anxiety: 모르겠어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158681
    m_Localized: 'Anxiety: 절 쏘시면, 저는 훨씬 끔찍한 뭔가로 변해버리는 건 아닐까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158682
    m_Localized: 'Anxiety: 제가 도망가야 하는 걸수도요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158683
    m_Localized: 'Anxiety: 이제 제가 사람인지 아닌지도 잘 모르겠어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158684
    m_Localized: 'Anxiety: 나보고 대체 뭘 어쩌란 거야?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158685
    m_Localized: 'Anxiety: 집에 있던 방문자 놈들과 똑같군...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158686
    m_Localized: 'Anxiety: 미안해요, 방금은 좀 심했네요... 보여드릴게요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158687
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: 'Anxiety: 저는 인간인가요? 네? 제가 인간이라고 이야기해 주세요, 제발!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: 'Anxiety: 애초에 총을 꺼내 들 거였으면 뭐 하러 보여달라고 한 건가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: 사람에게 모욕을 주면 즐거우신가보죠?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158695
    m_Localized: 'Anxiety: 악몽이 따로 없네요. 이제 안전한 곳은 없다는 느낌이에요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158696
    m_Localized: 'Anxiety: 방문자들이 집에 들이닥칠 수도 있고요. 웬 광인이 그저 저한테 뭔가 문제가 있다고 생각해서 죽이려 들 수도 있으니까요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158697
    m_Localized: 'Anxiety: 너무 무섭다고요! 그냥 다 잘 될 거라고 말해줄 사람 어디 없나요!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158698
    m_Localized: 'Anxiety: 어째서 그 징후 하나만으로 제가 방문자라는 거죠? 왜죠?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158699
    m_Localized: 'Anxiety: 몸뚱이부터가 이미 재수 없게 태어난 마당에...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158700
    m_Localized: 'Anxiety: 온통 울퉁불퉁하거든요. 직장에서 절 무서워한 것도 이해는 돼요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158701
    m_Localized: 'Anxiety: 지난 주에는 등때문에 병원에 갔었어요... 아마도요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158702
    m_Localized: 'Anxiety: 제가... 제가 그럼 치과에도 들렀던 걸까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158703
    m_Localized: 'Anxiety: 대체 얼마를 쓴 거지...?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: 뭘 확인하고 싶으신 건가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: 치아
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: 손
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: 눈
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: 겨드랑이
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: 사진
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: 귀
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: 치아를 보여달라고요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: 'Esenin: 좋아요, 그럼 살펴보세요. 아직 슬픔과 궐련의 냄새가 남아있겠지만.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: 꽤나 누렇죠?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: 그러니 검사가 끝났으면 꺼져.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: 난 방문자가 아니니까.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: 그놈들은 대체 어디서 오는 걸까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: 'Esenin: 손톱에 흙이 잔뜩 낀게 징후라고요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: 그건 방문자 놈들이 그냥 손을 씻으면 되는 징후잖아요!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: 'Esenin: 당신 말대로라면 정원사는 자동으로 방문자 당첨이라, 이 말인가?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: 씨발 말이 돼야지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: 손톱을 확인해 보쇼.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: 'Esenin: 그래서? 나도 방문자요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: 그렇게 생각하지 마시오.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: 하루하루가 점점 더 터무니없어지고 있군요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: 'Esenin: 제가 잠을 제대로 못 잤다면요? 울고 있었다거나?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: 'Esenin: 이젠 검사 방법 자체가 제대로 된 것인지조차 모르겠네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: 'Esenin: 하나의 징후가 맞아떨어지면 어쩌실 생각이죠? 아예 징후가 여러 개 발견된다면요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: 'Esenin: 이럴 바에 오늘 밤에 그냥 방문자로 거듭나야겠어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: 'Esenin: 평화롭던 시절을 기억하며 펑펑 울겠어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: 'Esenin: 징후 판별 검사부터, 노란색 방호복을 입은 사람들까지...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: 전부 다...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: 좆같네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: 'Esenin: 정녕 이 모든 짓거리가 세상을 모종의 무시무시한 지옥으로 끌고가고 있다는 걸 모르시겠나요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: 'Esenin: 모든 일을 통제 하에 두고 있는 것처럼 굴고들 있지만, 우리 주위를 둘러싼 건 온통 혼돈뿐이죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: 그래요, 빌어먹을 사진이나 찍으세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: (당신은 남자의 사진을 찍는다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: 'Esenin: (사진 속에 전부 들어오진 않지만, 남자는 차분하게 앉아 있으며, 딱히 이상한 점은 없다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: 'Esenin: 이제 무슨 일이 벌어질지가 두렵네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: 'Esenin: 씨발 진심이세요? 이거 완전 또라이잖아?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: 관리청이 선생 뇌라도 파먹었소?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: 'Esenin: 아니면 잔뜩 취한 상태인 건가? 독한 술은 이미 진작에 다 떨어진 줄로만 알고 있었는데.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: 'Esenin: 아무튼, 보여달라고 하니, 보여 드려야지!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: 원하시던 대로 확인했습니까?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: 만족할 만큼 충분히 킁킁대셨나요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: 'Esenin: 엉덩이에 얼굴을 파묻지 않아 주셔서 고맙수다!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: 아무래도 좋으니 빨리 해주세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158751
    m_Localized: 치아
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158752
    m_Localized: 손
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158753
    m_Localized: 눈
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158754
    m_Localized: 겨드랑이
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158755
    m_Localized: 사진
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352768
    m_Localized: 귀
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: 뭐라고요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: 'Widow: 음... 그래요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: 됐어요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: 이제 좀 절 내버려 두실래요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352774
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352775
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: 'Widow: 손이라... 잠시만요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: 'Widow: 그놈들이 구하길 거부한 한 사람을 들고 다니느라 손이 엉망인걸요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: 'Widow: 이 멍청한 짓거리 좀 그만하시면 안 될까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: 'Widow: 그렇게 절 쏘고 싶으시다면, 그냥 쏘세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: 이제 뭘 할 힘도 없으니까요...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352782
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352783
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: 'Widow: 뭘 찾으시는 건가요? 빨간 점?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: 검사하세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: 'Widow: 여기서 제가 감정적으로 굴면, 제가 방문자란 뜻인가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352788
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352789
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: 이제 좀 솔직해지면 안 될까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352791
    m_Localized: 'Widow: 행복할 수도, 울 수도 없죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352792
    m_Localized: 'Widow: 항상 말을 하고 있을 수도 없고요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352793
    m_Localized: 'Widow: 그럼 뭐가 남겠어요? 그저 손에 얼굴을 파묻고 앉아있는 거죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352794
    m_Localized: 'Widow: 과연 그렇게 쉽게 끝날까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352795
    m_Localized: 'Widow: 더 이상의 고통은 없을까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352796
    m_Localized: 'Widow: 그치만 당신을 구하지 못했는데, 나의...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352797
    m_Localized: 'Widow: 이건 좀 모욕적이라고 생각하지 않으세요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352798
    m_Localized: 'Widow: 아무도 제 남편을 구하려 들지 않았건만, 이제 와서는...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352799
    m_Localized: 'Widow: 이제 와서는 그이의 죽음을 사진에 평생 박제하겠다고!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352801
    m_Localized: 'Widow: 할 말이 없네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352802
    m_Localized: 'Widow: 찍던 말던 맘대로 하고 절 내버려 두세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352803
    m_Localized: 'Widow: (당신은 여자의 사진을 찍는다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352804
    m_Localized: 'Widow: (뭔가 이상한 점은 없는 듯하다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352805
    m_Localized: 'Widow: (사진 속에 죽은 이의 모습이 함께 담기고, 이로 인해 당신은 삶이란 무엇인지 사색에 빠지게 된다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352806
    m_Localized: 'Widow: 그냥 가요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352807
    m_Localized: 'Widow: 그이는 제 치아가 좋다고 했어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352808
    m_Localized: 'Widow: 그치만 저는 교정기를 하고 싶었죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352809
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352810
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: 그래요, 절 쏘지 않을 이유도 없잖아요, 그쵸?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352812
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352813
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: 'Widow: 새로워진 세상에서 사람들은 울 수나 있을까요? 확실한 건 웃을 수는 없겠네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352815
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352816
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: 정신 나가셨어요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: 'Widow: 말해보세요, 제정신이시죠?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: 'Widow: 그 악마 같은 놈들이 프라이팬 위에서 춤추라고 하면, 가장 먼저 춤을 추실 테지요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: 'Widow: 당신... 이런 씹... 할 말이 없네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: 'Widow: 뭐 하세요? 그냥 총을 꺼내드시죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352823
    m_Localized: 여자를 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352824
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: 제기랄.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: 'Widow: 그냥 쏴버려요. 관리청이 이미 제 영혼을 죽여버린 걸요. 그냥 제 육신도 끝장내주시면 좋겠어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352827
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352828
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352829
    m_Localized: 'Widow: 이제 교정기 생각은 없어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352830
    m_Localized: 'Widow: 선생님이 이빨을 보여달라고 하기 전까지는, 그런 생각을 했는지조차 까먹고 있었거든요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352832
    m_Localized: 'Widow: 아, 이런... 너무 지치네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352833
    m_Localized: 'Widow: 제가 주변 사람들에게 마구 화내는 편이거든요. 그렇지만...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352834
    m_Localized: 'Widow: 사실 누가 뭘 잘못한 건 아니에요. 몇몇 머저리들만 빼놓는다면요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352835
    m_Localized: 'Widow: 이해가 되질 않는군요. 딱히 이해하고 싶은 마음도 없고요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352836
    m_Localized: 'Widow: 사별한지 얼마 되지 않은 사람에게 그런 식으로 모욕을 주는 건...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352837
    m_Localized: 'Widow: 잠시만...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352838
    m_Localized: 'Widow: 우윽. 당신 방금 총을 꺼낸 거잖아요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352839
    m_Localized: 'Widow: 그런데 끝끝내 절 죽이지는 않았고요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352840
    m_Localized: 'Widow: 대체 왜 그런 거예요? 불안 증세라던지 그런 건가? 총을 왜 그딴 식으로 꺼내서 보여주냔 말이에요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: 뭘 확인해 보자는 거야?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352842
    m_Localized: 치아
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352843
    m_Localized: 손
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352844
    m_Localized: 눈
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352845
    m_Localized: 겨드랑이
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352846
    m_Localized: 사진
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352847
    m_Localized: 귀
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352848
    m_Localized: 'Scammer: 이빨이야 보여드리지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352849
    m_Localized: 'Scammer: 고향 친구 한 놈이 치과의사였거든.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352850
    m_Localized: 'Scammer: 근데 있잖아? 그놈 이빨은 몽땅 다 털렸거든! 하하하!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352851
    m_Localized: 'Scammer: 아, 이빨을 보고 싶다고. 그러쇼.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352853
    m_Localized: 'Scammer: 멀쩡하지?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352854
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352855
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352856
    m_Localized: 'Scammer: 아니 이게 뭐 하는 짓거리야? 뭐 특별할 것도 없는 이야기였잖아.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352857
    m_Localized: 'Scammer: 그렇지만 내 이빨 때문에 내 얼굴에 총을 쏴버리겠다니... 이해가 안 되네.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352858
    m_Localized: 'Scammer: 저기요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352859
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352860
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: 너 미쳤구나?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: 'Scammer: 내 거시기나 빨...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: 'Scammer: 뭐여 씨벌? 난 평범한 놈이라고.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: 'Scammer: 손톱에 개짓거리를 하거나 하진 않는다고, 봤어?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352866
    m_Localized: 'Scammer: 오해하지 말라고.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352867
    m_Localized: 'Scammer: 손을 자주 씻으니까. 땅에 동전이 떨어져있길래 줍다가 그런 거야.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352868
    m_Localized: 'Scammer: 원래는 깨끗하다고. 오늘 손을 씻을테니까, 이 사람아. 제발.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352869
    m_Localized: 'Scammer: 평소엔 씻는다고. 그냥 오늘 어쩌다 씻지 않은 거라니까.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352870
    m_Localized: 'Scammer: 내 손은 깨끗해. 평상시에는.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352871
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352872
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352873
    m_Localized: 'Scammer: 손톱이 더럽다고 사람을 담궈버리시겠다?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352874
    m_Localized: 'Scammer: 그러시던지. 이렇게 멍청하게 죽을 줄은 몰랐는데.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352875
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352876
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352877
    m_Localized: 'Scammer: 그 괴물 놈들을 판별하는 방법 치곤 이상하네.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352878
    m_Localized: 'Scammer: 멍청이나 호구는 손만 봐도 알아볼 수 있어. 하지만 대체 손이랑 방문자가 무슨 상관이 있다는 거야?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352879
    m_Localized: 'Scammer: 9시에 일어나서 최소 4시간을 일하지 않으면 안되기라도 하는 건가. 씨발.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352880
    m_Localized: 'Scammer: 최근에 눈이 가려웠거든.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352881
    m_Localized: 'Scammer: 태양 때문이라고 생각하쇼? 아님 뭘까?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352883
    m_Localized: 'Scammer: 젠장할, 형씨.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352884
    m_Localized: 'Scammer: 이건 눈병 같은 거야.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352885
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352886
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352887
    m_Localized: 'Scammer: 저기, 문득 새로운 계획이 떠올랐는데.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352888
    m_Localized: 'Scammer: 돈을 내는 사람들 얼굴에는 총을 쏘지 않는 거지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352889
    m_Localized: 'Scammer: 뭐? 이걸 고민해?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352890
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352891
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352892
    m_Localized: 'Scammer: 뭐, 돈냄새가 싫다는 거면 알겠다고. 그렇지만 내겐 정말로 눈병이 있단 말이야.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352893
    m_Localized: 'Scammer: 만약 선생한테 안약이 있다고 해도...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352894
    m_Localized: 'Scammer: 굳이 그걸 사서 쓸 생각은 없수. 다 그럴 만한 이유가 있어서.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352895
    m_Localized: 'Scammer: 사진을 찍고 싶다? 찍으쇼.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352896
    m_Localized: 'Scammer: 내가 불빛에 굉장히 예민해서. 움찔할 수도 있을 게요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352897
    m_Localized: 'Scammer: (당신은 남자의 사진을 찍는다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352898
    m_Localized: 'Scammer: (사진은 멀쩡해 보이지만, 남자의 얼굴은...)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352899
    m_Localized: 'Scammer: (얼굴만 굉장히 뿌옇게 나왔다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352900
    m_Localized: 'Scammer: 말했잖수.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352901
    m_Localized: 'Scammer: 다시 찍으실 건가?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352902
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352903
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352904
    m_Localized: 'Scammer: 형씨, 나한테 바가지 씌울 생각 말고, 저 호구새끼들이나 들들 볶으셔.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352905
    m_Localized: 'Scammer: 호구들 약을 바짝 올려놓으란 말이야.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352906
    m_Localized: 'Scammer: 호구새끼들을 그냥 두면 지들이 누구 덕에 집 안에 들어왔는지 까맣게 잊고, 돈도 안 낼거란 말이지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352907
    m_Localized: 'Scammer: 멈춰!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352908
    m_Localized: 'Scammer: 당신이나 당신 집이나, 엿이나 까잡수셔. 나는 나갈 테니까.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352909
    m_Localized: 'Scammer: 그냥 태양빛 아래 서있을 거요. 날 이렇게 몰아세운 죄책감을 안고 살아가길.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352910
    m_Localized: 'Scammer: 이런 젠장맞을.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352911
    m_Localized: 'Scammer: 벌여도 이딴 판을 벌이다니.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352912
    m_Localized: 'Scammer: 뭐 여기서는 선생이 갑이니까.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352913
    m_Localized: 'Scammer: 그래서, 어떤 판결을 내릴 거요? 괜찮은 건가?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352914
    m_Localized: 남자를 내버려둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352915
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352916
    m_Localized: 'Scammer: 잠깐, 기다려 봐! 알겠어, 제기랄, 어쩌다 털을 밀어보다가 그냥 쭉 밀어버리기로 했었거든.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352917
    m_Localized: 'Scammer: 아무한테도 말하지 말아 줘. 선생 설마 떠벌이는 아니겠지?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352918
    m_Localized: 'Scammer: 잠깐, 기다려! 이거 팬티를 보여달라는 말이랑 뭐가 다른 건데.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352919
    m_Localized: 'Scammer: 자고로 문명인이라면 겨드랑이가 그을려 있을 리가 없다는 것쯤은 알고 있잖수.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352920
    m_Localized: 남자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352921
    m_Localized: 남자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352922
    m_Localized: 'Scammer: 선생은 정신이 똑바로 박힌 인간이라는 걸 알고 있었수. 선생이 멀쩡한 사람을 공격할 리가 없지. 암.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352923
    m_Localized: 'Scammer: 저 얼간이 같은 녀석들에게 겁을 줘보는 건 어때?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352924
    m_Localized: 'Scammer: 싫다고? 오케이. 나중에 봐.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352925
    m_Localized: 'Scammer: 이 방문자인지 뭔지 하는 염병 때문에 선생이 스트레스를 받는다는 걸 알고 있지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352926
    m_Localized: 'Scammer: 우리 모두를 위해 이 짓거리를 한다는 것도.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352927
    m_Localized: 'Scammer: 아무튼, 악감정은 없다고. 진짜로.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: 뭘 확인해 보신다는 건가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: 치아
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: 손
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: 눈
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: 겨드랑이
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: 사진
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: 귀
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: 'Daughter: 제 이빨이요? 제 이빨을 보여드릴까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: 'Daughter: 왜요? 아직 젖니가 좀 남아 있어서요. 아빠 말로는...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: 이제 더 울지 않을게요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: 음, 여기요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: 그게 무슨 뜻이죠?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: 괜찮은 거죠?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: 손톱이라면 혼자 깎을 수 있다구요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: 아직 잘 깎지는 못하지만...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: 봐요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: 꽤 이쁘죠?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: 'Daughter: 혼자 깎았어요. 제가요. 혼자서요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: 'Daughter: 전 이만 갈래요. 혼자 있고 싶어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: 제 눈을 들여다 보실 수 있나요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: 'Daughter: 제가 뭘 생각하는지 맞히실 수 있어요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: 'Daughter: 그런 거라면, 아주 조심조심 생각할게요. 걱정 마세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352953
    m_Localized: 'Daughter: 왜 그렇게 쳐다보세요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352954
    m_Localized: 'Daughter: 설마 보..보..보신 건가요...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547072
    m_Localized: 'Daughter: 아저씨가... 와아아아아악.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: 'Daughter: 모... 모... 목이 말라요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: 제가 뭘 어떻게 하면 되나요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: 'Daughter: (당신은 소녀를 보고는 문득 이건 너무 과했다는 걸 깨닫는다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: 제가 잘 지내는지 알고 싶으신 건가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: 'Daughter: 너무나 피곤해요. 혼자 있어도 될까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: 사진이요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: 사진은 그다지 많이 찍어보지 않아서요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: 나중에 보여주실거죠?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: (당신은 소녀의 사진을 찍는다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: (사진이 약간 흐릿하게 나왔다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: 'Daughter: (사진을 미처 다 찍기도 전에 소녀가 당신에게 달려들었다.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: 흐으으음.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: 고맙습니다.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: 'Daughter: 별로 마음에 안 드네요. 사진은 더 찍지 않을래요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: 'NotTrue: 허어. 뭐, 확인해 보렴, 욘석아. 딱히 볼 만한 건 없을 텐데.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: 치아
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: 손
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: 눈
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: 겨드랑이
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: 사진
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: 귀
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: 내 이빨을?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NotTrue: 아아아아아.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: 'NotTrue: 뭐, 이빨 말인데... 아, 한때는 정말 지긋지긋하다고 여겼었지. 그냥 몽땅 뽑아버리고 싶었다니까.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: 그냥 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: 'NotTrue: 내 손가락 좀 보게나. 뭘 세거나, 쌓거나, 재거나 등등을 제대로 할 수 없지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: 'NotTrue: 그냥 딱 적당한 정도지. 그냥 딱 죽지 않을 정도라고.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: 그냥 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: 'NotTrue: 아이고 욘석아... 진짜로 그러고 싶은 게니?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: 'NotTrue: 눈은 창문과도 같단다. 집안의 불빛을 들여다 볼 수 있고, 사람 내면의 진실을 들여다 볼 수 있지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: 'NotTrue: 하지만 내 눈은 뿌옇단다... 유리에 금이 간 셈이지... 커튼은 진즉에 이끼에 덮여버렸고...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: 'NotTrue: 그러니 쳐다보지 말거라, 이놈아. 아무 것도 없을 테니.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: 그냥 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: 'NotTrue: 아이코! 이런 할망구한테 팔을 들어보라니... 부끄러운 줄 알거라! 그냥 서있기도 힘들어 죽겠는데!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: 'NotTrue: 뭐, 어쩌겠니? 집주인이 하라면 해야지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: 됐니?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: 그냥 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: 'NotTrue: 뭐라고? 아니 왜 아까운 필름을 나한테 써? 안 그래도 부족할 텐데... 진짜로 찍겠다고? 뭐, 나야 좋지!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: 그래 이놈아, 어떻게 잘 나왔니?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: 그냥 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: 'NotTrue: 하! 대체 무슨 생각이니, 이녀석아.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: 'NotTrue: 그냥 평범한 귀일 뿐이란다. 그냥 평소처럼 들리고. 그렇지만 그게... 가끔은 더 이상 내가 이 세상 사람이 아닌 것 같은 때도 있구나.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: 'NotTrue: 천장에서 들어오는 빛으로만 보이는 존재 같달까, 사실은 그 자리에 없는 게지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: 그냥 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: 'NotTrue: 녀석아, 왜 그런 걸 내게 들이미는 게냐?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: 'NotTrue: 이빨 빠진 노인네마냥 불쌍한 게 또 어디 있다고.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: 노인을 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: 노인의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: 'NotTrue: 내가 겁을 먹을 것 같니? 내가 그놈들이랑 한통속인 것 같아?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: 'NotTrue: 허공을 붙잡으려 안간힘을 쓴 게 몇 번인지 모른단다. 이젠 내 손가락조차도, 내가 아무것도 붙잡을 수 없다는 걸 알고 있을 지경이지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: 노인을 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: 노인의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: 결국 이리 되는구나...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: 'NotTrue: 날 믿지 못하겠니? 확인을 해보고 싶은 게야? 자, 여깄어, 살펴보렴...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: 'NotTrue: 나도 종종 사람들의 눈을 들여다보곤 했지. 그리고 이제 막 그게 어떤 느낌인지 떠올랐단다.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: 노인을 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: 노인의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: 'NotTrue: 그래, 이놈아, 늙으면 다 이리되는 거란다. 누구건 제 명에 못 죽고 사는 이들에게 달리는 훈장 같은 거지. 몰랐니?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: 'NotTrue: 곰팡이가 폈다고 딱히 아프진 않단다. 뭔가를 먹거나 하진 않거든. 그냥 거기 있는 거란다. 살기 위해 산달까. 마치 이 할미처럼, 호호.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: 노인을 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: 노인의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: 'NotTrue: 뭐야, 이것 때문에 또 화라도 내려는 게야?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: 노인을 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: 노인의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: 'NotTrue: 이게 무슨 짓거리니, 이 녀석아? 내 귀가 뭘 어쨌길래?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: 노인을 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: 노인의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: 'NotTrue: 그래. 괜찮단다. 괜찮아. 뭐 이 할미에게 무슨 상관이 있겠니, 이놈아. 이미 오래 전부터 주님을 뵙고 싶었단다.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: 그저...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: 'NotTrue: 의사에게 돈을 주고 몽땅 빼달라고 했는데, 한 번에 다 빼지는 못하더구나.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: 'NotTrue: 병원에 들러서 한 번에 한두 개씩 빼냈는데... 다 빼진 못했어. 지금 당장에야 의사들이 그럴 여력은 없을 테고.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: 'NotTrue: 이 녀석아, 그래서 이 할미는 이렇게 입 속 공사가 덜 끝난 상태로 살고 있는 거란다.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: 'NotTrue: 손은 누군가를 잡아주는 이들을 위해 달려있는 게란다. 나야 오래전에 그러길 관뒀지만.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: 'NotTrue: 손을 내밀어 보라고? 왜? 네가 내 손을 잡으면 될 일이잖니.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: 'NotTrue: "바람에 몸을 맡기고 뛰어올라 아래를 향해 떠다니노니..."라고 했었지. 나의 오두막으로 들어오렴, 이놈아. 어서.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: 'NotTrue: 이 운명에서 벗어날 수 있을 것 같니? 뭐, 젊어서 죽는다면 벗어날 수도 있겠지. 하지만 몸조심하려무나!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: 'NotTrue: 이렇게 신수가 훤칠한 녀석이 있을꼬! 이렇게 예쁜 녀석을 부셔버린다면 틀림없이 죄스럽겠지.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: 'NotTrue: 내가 젊었을 적에는, 부자들만 이런 장치를 가지고 있었단다. 요새는 뭐, 자네같이 손재주 좋은 남정네들은 다들 쓰는 듯하지만!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: 'NotTrue: 네게 해줄 말은 없단다. 바보 같이 굴고 있잖니. 선량한 사람을 이유 없이 귀찮게 하질 않나...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547160
    m_Localized: 'Alkonost: 제 동생을 괴롭히지만 마세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547161
    m_Localized: 치아
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547162
    m_Localized: 손
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547163
    m_Localized: 눈
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547164
    m_Localized: 겨드랑이
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547165
    m_Localized: 사진
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547166
    m_Localized: 귀
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547167
    m_Localized: 'Alkonost: 우리 가족은 대대로 치아가 튼튼했어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547168
    m_Localized: 'Alkonost: 십대 때에는, 맥주도 이빨로 따려고 들었다니까요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547169
    m_Localized: 'Alkonost: 뭐 결과는 참담했지만요. 하지만 그 덕에 치아 관리를 잘해야 한다는 교훈은 얻었어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547170
    m_Localized: 그냥 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547171
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547172
    m_Localized: 'Alkonost: 동생은 당장 혼자서는 뭘 할 수가 없는 지경이에요. 그러니 손으로 제 할일을 하는 건 저뿐이라 할 수 있죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547173
    m_Localized: 'Alkonost: 그렇다면 두 사람의 목숨을 동시에 감당하는 인간의 손은 어떻게 생겨야 하는 걸까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547174
    m_Localized: 그냥 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547175
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547176
    m_Localized: 'Alkonost: 네 뭐, 제 동생이 많이 울긴 하지만, 우리들의 눈은 정말로 비슷하게 생겼어요. 동생 눈빛이 좀 더 가라앉아 있긴 하지만요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547177
    m_Localized: 'Alkonost: 그래서 걱정돼요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547178
    m_Localized: 'Alkonost: 네 뭐, 제 동생이 많이 울긴 하지만, 우리들의 눈은 정말로 비슷하게 생겼어요. 그 말인즉슨 빨갛지는 않다는 거죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547179
    m_Localized: 'Alkonost: 아마 동생은 울 만큼 다 울었을지도 모르겠네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547180
    m_Localized: 그냥 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547181
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547182
    m_Localized: 'Alkonost: 보여드릴게요. 하지만 동생을 귀찮게 하지는 말아주시겠어요? 동생한테는 이럴 힘도 없을 거예요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547183
    m_Localized: 'Alkonost: 보통은 제모를 해요. 나름대로 가꾸려고 한다고요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547184
    m_Localized: 'Alkonost: 이렇게 세상이 미쳐돌아가는 와중에도 말이죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547185
    m_Localized: 'Alkonost: 보통은 나름 꾸미고 다니지만, 제모기를 두고 와서요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547186
    m_Localized: 'Alkonost: 아무튼 그럴 시간도 없고요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547187
    m_Localized: 그냥 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547188
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547189
    m_Localized: 'Alkonost: 동생과 저는 충분히 치일 대로 치였어요. 총좀 저리 치워요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547190
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547191
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547192
    m_Localized: 'Alkonost: 요새 담배를 피우기 시작했어요. 당신 같은 작자들 때문에요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547193
    m_Localized: 'Alkonost: 당신 혼자만 힘든 줄 알아요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547194
    m_Localized: 'Alkonost: 그렇게 막 아무한테나 총구를 들이밀어도 되는 줄 아시나 보죠?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547195
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547196
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547197
    m_Localized: 'Alkonost: 대체 뭔가요? 제 시선이 너무 빨랐다거나 공허했다거나 한 건가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547198
    m_Localized: 'Alkonost: 대체 뭔가요? 제 시선이 너무 공허했다거나 한 건가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547199
    m_Localized: 'Alkonost: 당신이라고 뭐 딱히 달라 보인다고 생각하세요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547200
    m_Localized: 'Alkonost: 진정하시고 감정적인 결정은 자제하실 필요가 있어요. 제 동생에게 항상 하는 말이지만요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547201
    m_Localized: 'Alkonost: 이렇게 같은 말을 하게 하다니, 부끄러운 줄 아세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547202
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547203
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547204
    m_Localized: 'Alkonost: 잠깐만요. 진짜로 뉴스에서 이딴 겨드랑이가 방문자가 나타내는 징후라고 하던가요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547205
    m_Localized: 'Alkonost: 좀 더 똑바로 생각해 보세요. 멍청하게 굴지 마시고.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547206
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547207
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547208
    m_Localized: 'Alkonost: 제 삶의 여정은 이렇게 끝나나 보네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547209
    m_Localized: 'Alkonost: 비통함을 품은 채로.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547210
    m_Localized: 'Alkonost: 삶은 항상 우리의 힘을 시험하려 들었죠. 모든 일이 항상 힘에 부쳤어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547211
    m_Localized: 'Alkonost: 제 동생은 견뎌내지 못했고요. 포기해버렸죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547212
    m_Localized: 'Alkonost: 이제 왜인지 알겠어요. 그저 달갑지 않은 상황에 처하게 돼서 그랬다는 걸.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547213
    m_Localized: 'Alkonost: 그렇다곤 해도 패닉에 빠져 포기해 버린다면, 방문자 놈들과 크게 다를 바가 있다고 할 수 있을까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547214
    m_Localized: 'Alkonost: 타인과 고립된 채로 있으면 무슨 일이 벌어지는 걸까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547215
    m_Localized: 'Alkonost: 이봐요, 이젠 지쳤어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547216
    m_Localized: 'Alkonost: 그저 겁에 질리지 않은 채로 잠깐 편하게 쉴 수 있기를 간절히 원한다고요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547217
    m_Localized: 'Alkonost: 하지만 어딜 가나 똑같을 뿐이고, 당장은 이런 짓거리가 끝날 기미가 보이지 않네요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547218
    m_Localized: 'Alkonost: 솔직히 말하자면, 저도 너무나 무서워요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547219
    m_Localized: 'Alkonost: 이젠 어떻게 되는 거죠? 방문자들은 영영 사라질까요? 아니면 방문자 녀석들과 영영 도시를 나눠 써야 하는 처지가 될까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547220
    m_Localized: 'Sirin: 그냥 빨리 하세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547221
    m_Localized: 치아
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547222
    m_Localized: 손
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547223
    m_Localized: 눈
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547224
    m_Localized: 겨드랑이
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547225
    m_Localized: 사진
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547226
    m_Localized: 귀
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547227
    m_Localized: 'Sirin: 살펴보세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547228
    m_Localized: 'Sirin: 몽땅 뽑아버리시게요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547229
    m_Localized: 그냥 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547230
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547231
    m_Localized: 'Sirin: 언니가 절 도와줘요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547232
    m_Localized: 'Sirin: 하지만 다 부질없어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547233
    m_Localized: 'Sirin: 그냥 저를...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547234
    m_Localized: 'Sirin: 그냥 저를 죽게 내버려 뒀으면 좋았을 텐데요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547235
    m_Localized: 그냥 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547236
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547237
    m_Localized: 'Sirin: 언니랑 저는 눈이 비슷하게 생겼어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547238
    m_Localized: 'Sirin: 하지만 언니의 눈은 저처럼 공허하진 않아요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547239
    m_Localized: 그냥 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547240
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547241
    m_Localized: 'Sirin: 언니가 겨드랑이를 제모해 줬어요. 언니가 절 돌봐주죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547242
    m_Localized: 'Sirin: 그게 그렇게 부질없는 짓은 아니었나봐요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547243
    m_Localized: 그냥 내버려 둔다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547244
    m_Localized: 총을 꺼내든다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547245
    m_Localized: 'Sirin: 오히려 잘됐어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547246
    m_Localized: 'Sirin: 제 영혼을 가져가세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547247
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547248
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547249
    m_Localized: 'Sirin: 그럴 필요 없어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547250
    m_Localized: 'Sirin: 이미 죽음이 코앞까지 왔는걸요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547251
    m_Localized: 'Sirin: 그냥 제가 하게 해주세요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547252
    m_Localized: 'Sirin: 총을 이리 줘요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547253
    m_Localized: 'Sirin: 스스로 할테니까요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547254
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547255
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547256
    m_Localized: 'Sirin: 눈을 감아도 공허함이 가시질 않아요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547257
    m_Localized: 'Sirin: 당신에게 옮을 지도요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547258
    m_Localized: 'Sirin: 그래도 좋나요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547259
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547260
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547261
    m_Localized: 'Sirin: 그래서요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547262
    m_Localized: 'Sirin: 빨간색 버튼을 누르시게요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547263
    m_Localized: 여자를 쏜다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547264
    m_Localized: 여자의 말을 들어본다
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547265
    m_Localized: 'Sirin: 그럴 배짱이 없나요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547266
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547267
    m_Localized: 'Sirin: 아무튼, 당신도 죽을 테니까요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547268
    m_Localized: 'Sirin: 아쉬워라.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547269
    m_Localized: 'Sirin: 다음을 기약할게요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547270
    m_Localized: 'Sirin: 아쉬워라.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547271
    m_Localized: 'Sirin: 제게 징후가 없군요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547272
    m_Localized: 'Sirin: 다음을 기약할게요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547273
    m_Localized: 'Sirin: 만약 블랙홀이 우리를 빨아들이기 직전이라면 어떡해야 할까요?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547274
    m_Localized: 'Sirin: 우리 모두 사건의 지평선으로 오랜 시간 동안 빨려 들어가겠지요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547275
    m_Localized: 'Sirin: 그렇게 되면 어떻게 죽는지도 모를 테고요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547276
    m_Localized: 'Sirin: 영원한 고통과 죽을 거라는 생각만이 남겠죠.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547277
    m_Localized: 'Sirin: 상관 없어요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547278
    m_Localized: 'Sirin: 그러면 얌전히 그때를 기다리도록 할게요.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547279
    m_Localized: 'Sirin: 내 노래...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547280
    m_Localized: 'Sirin: 당신을 위해 부른 거였는데!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547281
    m_Localized: 'Sirin: 노래는 행복한 결말이라고!'
    m_Metadata:
      m_Items: []
