    m_Localized: 화면
    m_Metadata:
      m_Items: []
  - m_Id: 68269633731022848
    m_Localized: 대화하기
    m_Metadata:
      m_Items: []
  - m_Id: 68269655268773888
    m_Localized: '''죽음'''
    m_Metadata:
      m_Items: []
  - m_Id: 69257185275400192
    m_Localized: 텍스트
    m_Metadata:
