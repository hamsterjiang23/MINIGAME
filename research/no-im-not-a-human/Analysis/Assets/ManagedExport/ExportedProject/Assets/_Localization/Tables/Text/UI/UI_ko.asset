  - m_Id: 94373216557715456
    m_Localized: 게임패드 진동
    m_Metadata:
      m_Items: []
  - m_Id: 94373216587075584
    m_Localized: 게임패드 민감도
    m_Metadata:
      m_Items: []
  - m_Id: 94373216587075585
    m_Localized: 실내에서의 게임패드 민감도
    m_Metadata:
