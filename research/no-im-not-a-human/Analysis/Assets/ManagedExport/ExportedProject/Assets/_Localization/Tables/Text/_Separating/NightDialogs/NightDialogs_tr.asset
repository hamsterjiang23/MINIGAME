%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_tr
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: e2adf5c0928e69a42a85516c84d58249, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: Selam. (öksürür)'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: Beni içeri alabilecek misin birader?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: Ne oldu sana?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: 'Firefighter: İtfaiyeciyim (öksürür) ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: 'Firefighter: Bugün orman yangınlarıyla uğraşıyorduk, sonra güneşe maruz kaldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: 'Firefighter: Ortalık duman altı olduğu için yanarak can vermedik neyse ki ama (öksürür) yine çok kötüydü.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: 'Firefighter: Ağaçlar (öksürür) kibrit gibi yandı gitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: Hayatımda böyle bir şey görmemiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: 'Firefighter: Orman komple yanmış hayvan ölüleriyle kaplıydı.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: Niye hastaneye gitmedin?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: Ne yapacaksın şimdi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: 'Firefighter: Orman yangınlarını söndürürken (öksürür) öğlen güneşine yakalandım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: Ekibimden bir ben canlı çıktım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: 'Firefighter: Patron... (öksürür) diğerlerinin gitmesine izin vermedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: Ebedî vardiyadalar diyelim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: Niye hastaneye gitmedin?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: Ne yapacaksın şimdi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: 'Firefighter: Ne hastanesi? Hastane mi kaldı birader?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: Sağ olasın birader. (öksürür)'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: Oooo, n''aber abi?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: 'WheelChair: Çoktandır görüşmedik. Nasıl gidiyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: Tanışıyor muyuz?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: 'Wheelchair: Hadi ama ya. Ne ara unuttun beni?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: Biz şeydik işte...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: 'Wheelchair: Bir saniye, senin sesin değişmiş...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: Sen ne zamandır burada yaşıyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: Burası benim ailemin evi
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: Sen galiba yanlış adrese geldin
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: Haa, sen...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: Sen benim arkadaşım değilsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: Sen ne zamandır burada yaşıyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: Burası benim ailemin evi
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: Sen galiba yanlış adrese geldin
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: Yok, imkânı yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: 'Wheelchair: Ben hiç yanlış yapmam! Fil hafızası var bende.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: 'Wheelchair: Benim arkadaşım burada oturuyor... Yani oturuyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: 'Wheelchair: Hadi be abi, tekerlekli sandalyeyle buraya kadar gelmişim. Beni içeri almayacak mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: Hayır ya, imkânı yok...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: Yok...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: Ah be...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: Demek ki yanılmışım harbiden.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: 'Wheelchair: Hadi be abi, tekerlekli sandalyeyle buraya kadar gelmişim. Beni içeri almayacak mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: Ha şöyle ya!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: Evin de büyükmüş epey ha. Yarışalım mı? 3... 2... 1... BAŞLA!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: 'Wheelchair: Ne demek "gitsen iyi olur"?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: 'Wheelchair: Ne yapayım, siktir olup gideyim mi bu hâlde?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: 'Wheelchair: Bayır aşağı yuvarlanayım istiyorsun herhâlde. Siktiğimin delisi!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: 'Mother: Yeter! Bir yerinde dur.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: 'Mother: Merhaba. Bize yardım eder misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: Ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: Benden ne istiyorsunuz?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: 'Mother: Çok yorgunum. Yatacak bir yatak arıyorum sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: Beş çocuğum vardı. Şimdi bir bu kaldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: 'Mother: Kocam da ortalıktan kayboldu. Artık öldü mü, yoksa bizi terk mi etti bilemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: 'Mother: Tek istediğim bir yere uzanıp birkaç gün kalkmamak.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: Diğer çocuklar nerede?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: Çocukların öldü mü?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: 'Mother: Rica ediyorum, beni içeri al da biraz uyuyayım. Yere yığılacağım birazdan.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: 'Mother: Beş çocuğum vardı. Bu sonuncusu işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: 'Mother: Onları nerede arayacağımı bile bilmiyorum. Tek istediğim biraz gözlerimi dinlendirmek.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: Diğer çocuklar nerede?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: Çocukların öldü mü?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: 'Mother: Bilmiyorum. Babaları alıp götürmüş olabilir. Evine gidecektim aslında ama takatim kalmadı gerçekten.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: 'Mother: Birlikte yaşarken çok kavga ederdik ama herif şerefsizin tekiydi, ben n''apayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: 'Mother: Neyse, onu unut gitsin. Şu an benim için önemli olan tek şey çocuklarımı bulmak.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: Öyle deme.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: 'Mother: Beş tane hergeleye hâkim olmak kolay iş değil ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: 'Mother: Başlarına bir şey gelmedi. Muhtemelen anneannelerinin evine gitmişlerdir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: 'Mother: Benden bıktıklarında oraya koşuyorlar hemen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: 'Mother: Babaları para istemeye gelince de aynı şekilde.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: 'Mother: Beni içeri alacak mısın? Biraz dinlenip çocuklarımı aramaya gitmek istiyorum sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: Nihayet dinlenebileceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: 'Mother: Hadi, çabuk. Kendine bir yer seç.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: Yarına gideceğiz, söz veriyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: 'Mother: Peki o zaman. Annemin evine gitmeye çalışayım öyleyse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: Muhtemelen ulaşamayacağım ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: Başka şansım yok...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: Merhaba pek değerli ev sahibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: 'Anger: Şu an sinirden kuduruyorum, dolayısıyla şimdiden özür diliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: 'Anger: Dışarısı şerefsiz dolu. Umarım sen de onlardan biri değilsindir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: Kimi diyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: Sen o... yaratıklardan biri değilsin, değil mi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: Açıkçası herkesi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: 'Anger: Sırf din min sayesinde birbirini katletmeyen sikikleri diyorum işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: 'Anger: Tanrı falan kalmadı tabii, insanlık da elden gitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: Hepsi kuduz hayvan gibi şimdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: 'Anger: Bu Ziyaretçi mevzusu yetmiyormuş gibi bir de bunlarla uğraşıyoruz. Hay ben sizin!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: Niye bu kadar sinirlisin?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: Senin onlardan ne farkın var?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: İyi sordun.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: 'Anger: Şimdi insanlar ikiye bölündü, fark etmişsindir herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: 'Anger: Bir tarafta sadist manyaklar var. Ziyaretçilerden beter hepsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: 'Anger: Akıllarına ne eserse yapıyorlar. Sırf eğlencesine kafana sıkarlar, o kadar!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: 'Anger: Diğer taraf da komple koyun. Onlara istediğin kadar zulüm et, yine sana teşekkür ederler.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: İki taraf da tepemi attırıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: Niye bu kadar sinirlisin?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: Senin onlardan ne farkın var?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: 'Anger: Seninle bir ilgisi yok, yanlış anlama.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: 'Anger: Yok güneş milleti yakıyor, yok sağdan soldan Ziyaretçi çıkıyor... Tanrı çoktan öldü zaten, sırada insanoğlu var.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: 'Anger: Bu yüzden öfkeliyim işte. Normal bir hayat istemiştim sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: 'Anger: Şarkı yazıyordum mesela. Artık kimsenin sikinde değil böyle şeyler.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: İki tarafa da düşmeyeyim diye uğraşıyorum işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: Farklı olduğuma inanmak istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: 'Anger: O manyaklardan birine dönüşeceğim diye ödüm kopuyor, var ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: 'Anger: Omurgasız olmaktan veya. İki tarafın da ta amına koyayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: Gerçi birini seçecek olursam...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: Bu mağdur tipler daha beter.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: 'Anger: Boş boş durup "Biri gelse de ağzımı yüzümü dağıtsa," diye bekliyorlar bildiğin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: 'Anger: Benim gördüklerimi sen de görseydin öfkeme hak verirdin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: 'Anger: Merak etme, seni rahatsız etmeyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: Kimseyi dövmeyeceğim de.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: 'Anger: Başkalarına zarar vermemek için öfkemi kendime yöneltiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: 'Anger: Senin de o yüreksiz piçlerden bir farkın yokmuş belli ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: 'Anger: Adamlar gelip tekme tokat girişse gıkınız çıkmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: Hepinizin ta...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: Buradaki enerjinin durgun olduğunu hissediyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: İçeride çok kötü şeyler olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: 'FortuneTeller: Güneş ve aslan Beşinci Ev''de. Çok belli.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: 'FortuneTeller: Sen çok baskın birisin, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: Ha?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: Senden bir şey istemiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: Laf değil icraat insanısın anladığım kadarıyla.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: Tam bir aslan burcusun, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: 'FortuneTeller: Burada epey karanlık enerji birikmiş. Evet, rahatsız edici bir durum...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: Neden veya nasıl, henüz bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: 'FortuneTeller: Büyük bir ihmalkârlık seziyorum. Olumlama yaparak başlarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: Yeterince derdim yokmuş gibi iyice kafamı karıştırdın
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: Ee, yani?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: Amacım seni rahatsız etmek değil tatlım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: 'FortuneTeller: Bu duvarların arasında çekilen ızdırabın ardındaki sebep ve sonuç ilişkisini anlamana yardımcı olabilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: 'FortuneTeller: Birbirini kovalayan balık sürüleri gibi, karma altmış dokuzu yapabiliriz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: 'FortuneTeller: Al gülüm, ver gülüm, anlatabildim mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: Yeterince derdim yokmuş gibi iyice kafamı karıştırdın
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: Ee, yani?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: 'FortuneTeller: Yükselenin oğlak olduğu için stresli olman normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: 'FortuneTeller: Birden fazla takımyıldızı dengelemeye çalışıyorsun. Karmaşık bir insansın.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: 'FortuneTeller: Olumlama yaparak içindeki kozmosun derinliklerine inebiliriz. Anladın, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: 'FortuneTeller: Sonra tüm taşlar yerine oturur zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: 'FortuneTeller: Geçmiş enkarnasyonlarının gardiyanları var.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: 'FortuneTeller: Onlara biraz alan tanı. Geçmiş hayatlarının tecrübelerini tekrar ediyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: 'FortuneTeller: Onları affetmen ve içindeki geçmişi kabullenmen gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: 'FortuneTeller: Ancak o zaman bu kısır döngüden kurtulabilirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: Anladın mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: 'FortuneTeller: Şahane. Açıkçası çok güzel bir konumdasın.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: Evinin içinden geçen kuvvetli bir pozitif enerji akımı var.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: 'FortuneTeller: Kendini geliştirmek istemiyorsun yani, doğru mu anladım?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: Daha iyi bir insan olmak istemiyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: Çok yazık.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: 'FortuneTeller: Sana korkunç bir ishal musallat edeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: İyi akşamlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: Bir kişiyi alıp götüreceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: İyi geceler.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: 'Prophet: Evet, yine karşılaştık.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: M... Merhaba!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: 'Anxiety: Kusura bakma, geç saatte seni rahatsız ettim. Bugün dışarısı çok sıcaktı, televizyonda da güneşe çıkmayın diyorlardı...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: Rica etsem... beni içeri alır mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: Burayı nasıl buldun?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: Şey, şehre yakın bir yerde oturuyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: 'Anxiety: Şey, beni kovdular da... İş konusunda hep şanssızımdır zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: Şimdi ne yapacaksın?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: Sence sonumuz ne olacak?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: Yani... anlattığımda güleceksin ama, hehe...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: 'Anxiety: Evime Ziyaretçiler geldi. Hehe... İnanılır gibi değil! Kendi evimden kovdular beni!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: 'Anxiety: Şimdi güneşten saklanacak bir yer arıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: Şimdi ne yapacaksın?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: Sence sonumuz ne olacak?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: 'Anxiety: Yani... Bir şekilde hayatta kalmaya çalışacağım. Dışarısı çok korkunç; Ziyaretçiler fink atıyor, güneş herkesi kavuruyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: 'Anxiety: Ben şahsen yaşamayı tercih ederim. Heh heh... Offf...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: Sen korkmuyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: 'Anxiety: Umarım yakında hepsi sona erer...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: Yani... Bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: 'Anxiety: Hayatta kalabilecek miyim? Bana kim yardım edecek? Daha ne kadar milletin eline bakacağım?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: 'Anxiety: Ne olacak, hiçbir fikrim yok. Tahmin bile edemiyorum yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: 'Anxiety: Tüm bu olanlar seni de korkutmuyor mu? Beni çok korkutuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: 'Anxiety: Teşekkür ederim. Haha! Gerçekten çok teşekkürler! Cidden!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: 'Anxiety: Çok şükür, bir süre daha hayatta kalabileceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: 'Anxiety: Haha, ha... Şey, anlıyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: 'Anxiety: Yine de dinlediğin için teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: 'Anxiety: Şey, peki... O zaman ben gideyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: 'Anxiety: Görüşürüz mü demem lazım? Aynen... Görüşürüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: Gelebilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: Yolun aşağısındaki bara sığınmıştım ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: Beni dan diye kovdu adamlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: 'Esenin: Niye dersen... İçeridekiler, kişiliğimden pek hoşlanmadı, diyelim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: 'Esenin: Merak etme, kimseye zarar verme gibi bir niyetim yok. Hayat bazen insanın üstüne geliyor, o kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: 'Esenin: Ee, güzel kardeşim? İçeri alacak mısın beni?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: Ziyaretçi değilsin, değil mi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: Sıkıntı çıkarmayacağından emin misin?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: Ben o yaratıklara benziyor muyum hiç?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: 'Esenin: Hayır, Ziyaretçi değilim. Zaten böyle dan diye sorarak asla düzgün bir cevap alamazsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: 'Esenin: Belli ki buranın da o bardan pek bir farkı yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: Seni o bardan niye kovdular?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: Buranın farklı olacağını nereden çıkardın?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: "Sıkıntı"dan kastın ne?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: 'Esenin: Cinayet, şiddet... Bunlardan köküne kadar iğreniyorum ama öyle kolay kolay da boyun eğmem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: 'Esenin: Yemeyi içmeyi severim. Modumdaysam da sohbet etmeyi. Bunlar senin için bir "sıkıntı" olur mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: Seni o bardan niye kovdular?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: Buranın farklı olacağını nereden çıkardın?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: 'Esenin: Aslında kaba bir cevap verecektim de neyse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: 'Esenin: Söyledim ya zaten. Oradaki birinin hoşuna gitmemişim belli ki. Kimdiyse artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: 'Esenin: Gerçi şimdi bir düşündüm de iyi ki beni kovmuşlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: 'Esenin: Beni canlı canlı yeseler kimsenin ruhu duymazdı.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: 'Esenin: Başka şansım yok çünkü. Dışarıda mal mal durup erimeyi mi bekleyeceğim?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: Yok, sağ olasın.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: 'Esenin: Nefes aldığım sürece konuşacak birini arayacağım. Burada olmazsa da başka bir yerde bulurum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: 'Esenin: Şu hayatta azıcık da olsa şansım kaldıysa şerefsizin teki olmayan biriyle denk gelirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: 'Esenin: Sağ olasın. Güvenin hiçbir önemi kalmadı artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: 'Esenin: Yine de bana güvendiğin için teşekkür ederim. Hatta belki... Neyse, şimdiden söz vermeyeyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: 'Esenin: Hım... Anlaşıldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: 'Esenin: Mantığını anlıyorum ama yine de sinirim bozuluyor. O diğer yüreksizlerden hiçbir farkın yokmuş.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: 'Esenin: Sana iyi geceler güzel kardeşim. Senin amına koyayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: Gelip biraz istirahat edebilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: 'Widow: Hatırlamıyorum. Zaten bir önemi yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: 'Widow: Çok yorgunum. Biraz uzanamazsam şu pencerenin önüne yığılırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: 'Widow: Muhtemelen bir yerde yere yığılırım ve bir daha ayağa kalkmam.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: Neresi olduğu pek de umurumda değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: Kocam bu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: Öldü.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: 'Widow: Adamı düzgün bir şekilde defnedemiyorum ama bu saatten sonra onu bırakamam.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: 'Widow: Artık yok. Eskiden vardı ama kimse yardım eli uzatmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: O da öldü.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: 'Widow: Belki de yaşayabilirdi...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: 'Widow: Birinin umurunda olsaydı yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: Uzun süre kalmayacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: 'Widow: Biraz dinleneceğim sadece, o kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: Sen...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: Kankaaaaa!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: 'Scammer: Dışarıda ne olup bitiyor oğlum ya? Millet delirmiş lan!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: Sen burada iyi misin aga?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: 'Scammer: Bir şey istediğim yok ya. Meraktan yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: 'Scammer: Ama dinle bak. Kolay para istiyorsan manyak bir yol buldum. Anlatayım mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: 'Scammer: Millet güneşten kaçacağım diye ne yapacağını şaşırdığı için kılını bile kıpırdatmadan zengin olabilirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: 'Scammer: Mal mal korkacağınıza para kassanıza yani!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: 'Scammer: Sana yeni imkânlar sunacağım kanka, anlamıyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: 'Scammer: Millet mal mal ortalıkta dolaşıyor. Kimse kafasını çalıştırmıyor artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: 'Scammer: Herkesin bi'' yüzü gülse tüm sorunlarımız çözülecek aslında ama nerede!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: Ha şöyle ya! Biraz iş konuşalım!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: 'Scammer: Millet senin bi'' işler çevirdiğini düşünüyor. Öyle gelen geçeni eve alıyorsun falan diye söylenti çıkarıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: 'Scammer: Madem öyle, sen de tribünlere oyna aga. Yol geçen hanı olsun burası! Zaten dünya yok oldu olacak amına koyayım!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: Geberdikten sonra paranın ne önemi var moruk?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: 'Scammer: Şansın varken işine odaklanacaksın. Sikmişim güneşini!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: 'Scammer: Erken kalk, işe koyul tarzı yani. Kaptın mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: 'Scammer: Adam gibi adam! İşte bu ya!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: Beyni çalışan birini buldum sonunda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: 'Scammer: Hay ben senin kafanı sikeyim. Kusura bakma kanka, mal olduğunu anlamamışım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: 'Scammer: Gidip komşuna uğrayayım, belki o benim ne kadar zeki olduğumu anlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: Hadi yıkıl karşımdan, beynine soktuğum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: 'Neighbour: Nasılsın komşu? Çoktandır görüşmedik. Nasıl gidiyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: Bildiğin gibi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: İyi
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: 'Neighbour: Şimdi seninle açık konuşacağım, buraya boş yere gelmedim. Senin için biraz endişelenmeye başladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: Başımıza çok kötü bir şey gelecek anlaşılan.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: 'Neighbour: Az önce kuzenimle telefonda görüştük. Haberlerde güneşe garip bir şeyler olduğunu falan anlatmışlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: 'Neighbour: Bir de yerin altından insan mı çıkıyormuş, neymiş. Onlara da "Ziyaretçi" diyorlarmış niyeyse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: 'Neighbour: Çok enteresan gerçekten. Umarım yalan dolandır ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: Güneşe ne oluyormuş tam olarak?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: Ziyaretçi mi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: 'Neighbour: Şimdi seninle açık konuşacağım, buraya boş yere gelmedim. Senin için biraz endişelenmeye başladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: Başımıza çok kötü bir şey gelecek anlaşılan.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: 'Neighbour: Az önce kuzenimle telefonda görüştük. Haberlerde güneşe garip bir şeyler olduğunu falan anlatmışlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060952
    m_Localized: 'Neighbour: Bir de yerin altından insan mı çıkıyormuş, neymiş. Onlara da "Ziyaretçi" diyorlarmış niyeyse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060953
    m_Localized: 'Neighbour: Çok enteresan gerçekten. Umarım yalan dolandır ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060954
    m_Localized: Güneşe ne oluyormuş tam olarak?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060955
    m_Localized: Ziyaretçi mi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060956
    m_Localized: 'Neighbour: Yani ya patlayacak dediler ya da üzerinde bir şey patlayacak... Orasını tam anlamadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060957
    m_Localized: 'Neighbour: Bir derdi varmış, orası kesin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060958
    m_Localized: 'Neighbour: Bu yaz çok sıcak geçti, kesin fark etmişsindir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060959
    m_Localized: 'Neighbour: Bizim en kötü ihtimale karşı hazırlanmamız lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060960
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060961
    m_Localized: 'Neighbour: Kuzenim dedi ki evde yalnız kalmak tehlikeliymiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060962
    m_Localized: 'Neighbour: Ben de sana bir şey olmasın diye yanına uğrayayım dedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060963
    m_Localized: Peki
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060964
    m_Localized: Ben kendi başımın çaresine bakarım
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060965
    m_Localized: Karınla kızın nasıllar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060966
    m_Localized: 'Neighbour: Evet. Yerin altından çıkanlara öyle diyorlarmış.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060967
    m_Localized: 'Neighbour: Kim bilir nereden buldular bu ismi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060968
    m_Localized: 'Neighbour: Herhâlde Dünya''yı "ziyaret" ediyorlar diye. Yüzeyini en azından.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060969
    m_Localized: 'Neighbour: Milletin evine girmeye çalıştıklarından da olabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060970
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060971
    m_Localized: 'Neighbour: Kuzenim dedi ki evde yalnız kalmak tehlikeliymiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060972
    m_Localized: 'Neighbour: Ben de sana bir şey olmasın diye yanına uğrayayım dedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060973
    m_Localized: Peki
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060974
    m_Localized: Ben kendi başımın çaresine bakarım
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060975
    m_Localized: Karınla kızın nasıllar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060976
    m_Localized: 'Neighbour: İyi o zaman. Sabah konuşuruz yine.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060977
    m_Localized: 'Neighbour: Uyandığında mutfağa gelirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060978
    m_Localized: 'Neighbour: Hadi iyi geceler.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060979
    m_Localized: 'Neighbour: Ondan bir şüphem yok ama şu sıralar yalnız kalmak cidden çok tehlikeli, güven bana.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060980
    m_Localized: 'Neighbour: Ben yine de bu gece senin yanında kalayım, ha? Ne olur ne olmaz? En azından benim içim rahatlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060981
    m_Localized: 'Neighbour: Sen ailemi kafana takma. Yakın bir dostum bizde kalıyor şu an. Ben buradayken o onlara göz kulak olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060982
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060983
    m_Localized: 'Neighbour: İyi o zaman. Sabah konuşuruz yine.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060984
    m_Localized: 'Neighbour: Uyandığında mutfağa gelirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060985
    m_Localized: 'Neighbour: Hadi iyi geceler.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060986
    m_Localized: 'Neighbour: Sen ailemi kafana takma. Yakın bir dostum bizde kalıyor şu an. Ben buradayken o onlara göz kulak olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060987
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060988
    m_Localized: 'Neighbour: İyi o zaman. Sabah konuşuruz yine.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060989
    m_Localized: 'Neighbour: Uyandığında mutfağa gelirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060990
    m_Localized: 'Neighbour: Hadi iyi geceler.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060991
    m_Localized: 'Daughter: Merhaba!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060992
    m_Localized: 'Daughter: Babam burada mı? Onunla konuşabilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060993
    m_Localized: 'Daughter: Az önce hiç korkmuyordum ama şimdi korkuyorum. Bu gece dışarıda çok tuhaf insanlar var.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060994
    m_Localized: Babanın adı ne?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060995
    m_Localized: Babanı bir anlatır mısın bana?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060996
    m_Localized: 'Daughter: Adını unuttun mu? Ha, yok... Ziyaretçi miyim diye soruyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060997
    m_Localized: 'Daughter: Sen zeki bir abisin! Ben de insanlara soru soracağım artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060998
    m_Localized: Sen buraya sağ salim nasıl geldin?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060999
    m_Localized: Ziyaretçilerden korkuyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061000
    m_Localized: 'Daughter: Yani anlatabilirim. O benim babam sonuçta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061001
    m_Localized: 'Daughter: Evden çıkmadan önce bira içmeyi seviyor mesela, hihi!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061002
    m_Localized: 'Daughter: Çıktığı zaman da bana güzel yemekler bırakıyor. Meyve suyu da hazırlıyor!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061003
    m_Localized: 'Daughter: Bugün o bira şeyinden biraz denedim ama ıyyy, çok kötüydü!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061004
    m_Localized: 'Daughter: İnsanlar meyve suyu varken niye bira içiyor ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061005
    m_Localized: 'Daughter: Yaa, bunu sakın babama söyleme ama tamam mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061006
    m_Localized: Sen buraya sağ salim nasıl geldin?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061007
    m_Localized: Ziyaretçilerden korkuyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061008
    m_Localized: 'Daughter: Bilmiyorum. Kafam çok karıştı.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061009
    m_Localized: 'Daughter: İnsanlar sabah evde kalıp uyuyor, gece evden çıkıp bir şeyler yapıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061010
    m_Localized: 'Daughter: Ben hâlâ karanlıktan korkuyorum ama belki korkacak bir şey yoktur.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061011
    m_Localized: 'Daughter: Yoksa var mıdır?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061012
    m_Localized: Ben babanı alıp geleyim. Bol şans!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061013
    m_Localized: İyi günler!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061014
    m_Localized: 'Daughter: Şey... Bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061015
    m_Localized: 'Daughter: Herkes onlardan korkuyor, ben de korkmalıyım sanırım. Daha hiç görmedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061016
    m_Localized: 'Daughter: Korkunçlar mı? Vurunca acıtıyorlar mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061017
    m_Localized: 'Daughter: Öyleyse okuldaki bir arkadaşım Ziyaretçi olabilir. Bana hep vuruyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061018
    m_Localized: 'Daughter: Babam bana "Dikkatli ol," dedi, ben de çok dikkatli oldum!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061019
    m_Localized: 'Daughter: Hiç ses çıkarmadan parmak ucunda buraya geldim. Beni kimse görmedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061020
    m_Localized: Ben babanı alıp geleyim. Bol şans!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061021
    m_Localized: İyi günler!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061022
    m_Localized: 'Daughter: Sağ ol, sana da!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061023
    m_Localized: 'Daughter: Eve gitmek istiyorum... Dışarısı çok korkunç...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061024
    m_Localized: 'Daughter: Babamın uydurduğu bir oyun oynayacağız. Önce zar atıyoruz!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061025
    m_Localized: 'Daughter: Sonra koltuk veya sandalye gibi şeyleri ittiriyoruz!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061026
    m_Localized: 'Daughter: Kapının önüne en çok eşya iten kazanıyor. Nasıl oynandığını başka zaman gösteririm.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061027
    m_Localized: 'Daughter: Bay bay!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061028
    m_Localized: 'Daughter: M... Merhaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061029
    m_Localized: 'Daughter: İ... İçeri girebilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061030
    m_Localized: İyi misin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061031
    m_Localized: Ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061032
    m_Localized: 'Daughter: Ne... Ne yapacağımı bilmiyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061033
    m_Localized: 'Daughter: İ-İnsanlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061034
    m_Localized: 'Daughter: Şey...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061035
    m_Localized: 'Daughter: Babamı öldü...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061036
    m_Localized: 'Daughter: Öldürdü...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061037
    m_Localized: 'Daughter: Babacığım...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061038
    m_Localized: Kim öldürdü?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061039
    m_Localized: Babanı niye öldürdüler?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061040
    m_Localized: 'Daughter: Şey...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061041
    m_Localized: 'Daughter: B... Babamı...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061042
    m_Localized: 'Daughter: O... Onlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061043
    m_Localized: 'Daughter: Babamı ö... ö... öldürdüler...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061044
    m_Localized: Kim öldürdü?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061045
    m_Localized: Babanı niye öldürdüler?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061046
    m_Localized: 'Daughter: Eve... Eve Ziyaretçiler geldi... Bizimle o... oturuyorlardı...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061047
    m_Localized: 'Daughter: Babam onlarla b... bir şeyi konuşuyordu... Sonra onu... onu öldürdüler...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061048
    m_Localized: 'Daughter: O... (hıçkırır) Evimizi... (ağlar)'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061049
    m_Localized: 'Daughter: Evimizi yaktılaaarrrrr...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061050
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061051
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061052
    m_Localized: 'Daughter: B... Bilmiyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061053
    m_Localized: 'Daughter: Babamla m... mutfakta öyle oturuyorlardı...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061054
    m_Localized: 'Daughter: Sonra b... bir şey yaptılar ve... evi yaktılar...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061055
    m_Localized: 'Daughter: Ben de kaçtım... Güldüklerini duydum...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061056
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061057
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061058
    m_Localized: 'Daughter: Bana... Bana yardım eder misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061059
    m_Localized: 'Daughter: K... Korkuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061060
    m_Localized: 'Daughter: A... Ama... nereye gideceğim ben?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061061
    m_Localized: 'Daughter: Çok... Çok korkuyorum!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061062
    m_Localized: 'Daughter: Hüüüüüüüüü!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061063
    m_Localized: 'Daughter: HHÜÜÜÜÜÜÜÜÜÜÜÜ!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061064
    m_Localized: 'SuperFake: Selam olsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061065
    m_Localized: Ne istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061066
    m_Localized: Seni içeri almayacağım
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061067
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061068
    m_Localized: 'SuperFake: Evin ne kadar genişmiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061069
    m_Localized: 'SuperFake: Hoşuma gitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061070
    m_Localized: Senden bir şey istemiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061071
    m_Localized: Silahım var
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061072
    m_Localized: 'SuperFake: Kapın sağlam mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061073
    m_Localized: 'SuperFake: Başına bir şey gelmesin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061074
    m_Localized: 'SuperFake: Anlarsın ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061075
    m_Localized: Senden bir şey istemiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061076
    m_Localized: Silahım var
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061077
    m_Localized: 'SuperFake: Evet, istemiyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061078
    m_Localized: 'SuperFake: Pekiiiii...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061079
    m_Localized: 'SuperFake: Yalnız mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061080
    m_Localized: Hayır, yalnız değilim
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061081
    m_Localized: Evet, yalnızım
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061082
    m_Localized: 'SuperFake: Leziz!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061083
    m_Localized: 'SuperFake: Çaresizlik, korkakların cesareti değil midir?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061084
    m_Localized: 'SuperFake: Pekiiiii...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061085
    m_Localized: 'SuperFake: Yalnız mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061086
    m_Localized: Hayır, yalnız değilim
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061087
    m_Localized: Evet, yalnızım
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061088
    m_Localized: 'SuperFake: Şanslı günündesin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061089
    m_Localized: 'SuperFake: İçeriden fısıltı sesi geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061090
    m_Localized: 'SuperFake: Tabii, birkaç gün sonra nerede olurlar bilemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061091
    m_Localized: 'SuperFake: Hahahahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061092
    m_Localized: 'SuperFake: Yalnız olduğunu biliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061093
    m_Localized: 'SuperFake: Yalan söyleyecek misin diye meraktan sormuştum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061094
    m_Localized: 'SuperFake: Ben bir içeri gireyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061095
    m_Localized: 'NotTrue: İyi akşamlar evladım! Buraya gelene kadar pestilim çıktı ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061096
    m_Localized: 'NotTrue: Biraz içeri girip istirahat edebilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061097
    m_Localized: Ne? Niye buraya kadar yürüdün ki teyze?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061098
    m_Localized: Epey yürümüşsün teyze. Ne süredir yürüyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061099
    m_Localized: 'NotTrue: Yok kuzum, yok... Bilerek buraya gelmedim herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061100
    m_Localized: 'NotTrue: Kader böyle tuhaftır işte, insanları bir araya getirir. Hiçbir buluşma kazara olmaz evladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061101
    m_Localized: 'NotTrue: Buraya geldiğime göre ayaklarım beni buraya getirmiştir. Gözlerim senin evini görmüştür. Hepsinin bir sebebi vardır.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255104
    m_Localized: 'NotTrue: Kaderimizde böyle yazar... herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255105
    m_Localized: Anlamadım teyze. Bir şey mi istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255106
    m_Localized: Yürümeye devam edebilirdin. Neden burada durdun?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255107
    m_Localized: 'NotTrue: Peh! "Epey"miş! Nesi epey?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255108
    m_Localized: 'NotTrue: Sen evdesin ama bugün kaç adım attın kim bilir?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255109
    m_Localized: 'NotTrue: SEN de epeydir yürüyorsundur belki? Muhtemelen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255110
    m_Localized: 'NotTrue: Senin yaşadığın kadar benim yürüdüğüm var evladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255111
    m_Localized: 'NotTrue: Aramızdaki fark da bu işte evladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255112
    m_Localized: Anlamadım teyze. Bir şey mi istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255113
    m_Localized: Yürümeye devam edebilirdin. Neden burada durdun?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255114
    m_Localized: 'NotTrue: Peh! Herkes ne istiyorsa onu istiyorum evladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255115
    m_Localized: 'NotTrue: Başımı sokacak bir yer, anılarımı paylaşacak bir dost arıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255116
    m_Localized: 'NotTrue: Şöyle iyice bir uzanıp gözlerimi dinlendirmek istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255117
    m_Localized: 'NotTrue: Bir de nefes almak.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255118
    m_Localized: 'NotTrue: Bu kadar. Yalnız yaşamak çok sıkıcı oluyor evladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255119
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255120
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255121
    m_Localized: 'NotTrue: Peh! Kulağın duymuyor mu senin evladım? Bir de genç olacaksın!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255122
    m_Localized: 'NotTrue: Yürümekten usandım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255123
    m_Localized: 'NotTrue: Burada hem dinlenirim hem de sohbet ederiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255124
    m_Localized: 'NotTrue: İhtiyar bir kadın daha ne isteyebilir ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255125
    m_Localized: 'NotTrue: Sen bana bir şey söylersin, ben de sana maval okurum. Anıları paylaşırız.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255126
    m_Localized: 'NotTrue: Biraz da istirahat ederim işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255127
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255128
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255129
    m_Localized: 'NotTrue: Çok makbule geçti evladım!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255130
    m_Localized: 'NotTrue: Sen beni sıkmazsın, belli. Hem belki dışarıda ne olup bittiğini nihayet öğrenirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255131
    m_Localized: 'NotTrue: Peh! Nereye gitsem geri çeviriyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255132
    m_Localized: 'NotTrue: Kanadımı kırmış olabilirler ama ötmeme engel olamazlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255133
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255134
    m_Localized: 'NotTrue: Hepsi nihayetinde bana döner, zinhar diye yemin etseler bile.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255135
    m_Localized: 'NotTrue: Ben kin tutmam. Kapıma geleni geri çevirmem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255136
    m_Localized: 'NotTrue: Bir gün sen de yardıma muhtaç olacaksın evladım. O zaman kimin eline bakacaksın?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255137
    m_Localized: 'Twins: Merhaba. Dur, dur. Bana yaslan.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255138
    m_Localized: 'Twins: Şey... Evde bizim için yer var mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255139
    m_Localized: Arkadaşın hasta mı?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255140
    m_Localized: İkiniz de mi hastasınız yoksa sadece biriniz mi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255141
    m_Localized: 'Twins: Arkadaşım değil, kardeşim. Bunalıma girdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714698
    m_Localized: 'Wheelchair: Senin derdin ne ya? Ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714699
    m_Localized: 'Wheelchair: Bak, belli ki iyi kalpli birisin. Bir EnerJeka versem fikrin değişir mi? Hı?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714700
    m_Localized: 'Wheelchair: Buraya kadar tekerlek döndürdüm, feriştahım sikildi! Spor yapmaktan zor bak, diyorum sana!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714701
    m_Localized: İyi madem, gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714702
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714703
    m_Localized: 'Wheelchair: Bir EnerJeka''yı hak ettin! Çok makbule geçti kanka!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908992
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908993
    m_Localized: 'Anger: Hay anasının... Oooofff...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908994
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908995
    m_Localized: 'Anger: İyi lan, tamam. Bak...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908996
    m_Localized: 'Anger: Bir kutu EnerJeka''m var. Onu versem beni alır mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908997
    m_Localized: 'Anger: Ben ölmek zorunda kalmam, senin de boğazın kurumamış olur. Alan memnun, satan memnun.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908998
    m_Localized: İyi madem, gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908999
    m_Localized: İkile
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909000
    m_Localized: 'Anger: Sen beni merak etme... Benim sadece... Hay sikeyim... Neyse, al şunu.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909001
    m_Localized: 'Anger: Al şu EnerJeka''yı.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909002
    m_Localized: 'Anger: Bu zehri içmesem daha iyi zaten yoksa daha beter olurum.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909003
    m_Localized: 'Anger: Ha.... Belli ki {0} burada. Herkes fısıldayarak konuşuyor, sıkıntı çıkarmasın diye saçını süpürge ediyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909004
    m_Localized: 'Anger: Ben onunla aynı evde kalmaya asla tahammül edemem. Ya o ya ben. Birimiz gideceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909005
    m_Localized: 'Anger: Her şeyi içine atan insanlardan tiksiniyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909006
    m_Localized: Ben hallederim. Gir hadi
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909007
    m_Localized: Öyleyse yolun açık olsun
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909008
    m_Localized: 'Anger: Sende de peygamber sabrı varmış.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909009
    m_Localized: 'Anger: İşler çığırından çıkarsa araya girmekten çekinmezsin umarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909010
    m_Localized: 'Anger: Ben de... Anladın işte. Sakin kalmaya çalışırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909011
    m_Localized: 'Anger: Şahane amına koyayım. Şa-ha-ne.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909012
    m_Localized: 'Anger: Şöminenin etrafına topladığın tırışkaların yanına sokulmak daha kolay geliyor, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909013
    m_Localized: 'Anger: Ne bok yiyorsan ye, götveren seni. CEHENNEMDE YANASICA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451887
    m_Localized: 'Dude: Zombi mi? Oğlum, yemin ediyorum tahmin etmiştim!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451886
    m_Localized: Ne olup bittiğini bilmiyor musun gerçekten?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451885
    m_Localized: Ne anlatıyorsun sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451884
    m_Localized: 'Dude: Ha bir ekipte kesin dört kişi olacak. Tüm filmlerde öyle oluyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451883
    m_Localized: 'Dude: Bu kadar basit işte! Roketi attık, dünyanın yok olmasını durdurma görevini başlattık! Oğlum çok havalı lan!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451882
    m_Localized: 'Dude: Astronotları güneşe yolladık mı tamam yani, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451881
    m_Localized: 'Dude: O filmi izlemiştim lan ben! Kel bi'' adam oynuyordu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451880
    m_Localized: 'Dude: Hadi lan oradan!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451879
    m_Localized: İnsana benzeyen yaratıklar yerden çıkıp peşimize düşüyor
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451878
    m_Localized: Güneş giderek kızışıyor ve millet gündüz vakti yanarak ölüyor
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451877
    m_Localized: 'Dude: Bak benimle dürüst konuş, ne kaçırdım?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451876
    m_Localized: 'Dude: Ortalık iyice boka sardı, gördün mü? N''oluyor aga ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451875
    m_Localized: 'Dude: Oo, n''aber moruk?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451874
    m_Localized: 'Blind: Yoksa o şeyi sen de görürsün?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451873
    m_Localized: 'Blind: Ne yaparsan yap, SAKIN karanlık çöktüğünde yanmış cesetlere yaklaşma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451872
    m_Localized: 'Blind: Pekâlâ, gideceğim. Ancak seni uyarmam gerek...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451871
    m_Localized: 'Blind: Acaba... kapatacak bir gözüm olmadığı için uyumam daha mı zor olur?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451870
    m_Localized: 'Blind: Teşekkür ederim... Belki de artık istirahat edebilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451869
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451868
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451867
    m_Localized: 'Blind: O şey gerçek olmamalıydı. GERÇEK OLAMAZ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451866
    m_Localized: 'Blind: Daha büyük, daha güçlü... İsimsiz bir güç... Yanık etin peşine düşüyor ve ektiğimizi biçiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451865
    m_Localized: 'Blind: Hayır, hayır... Çok daha kötü bir şey gördüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451864
    m_Localized: 'Blind: O soluk tenli herifi görmem, gözlerimi oymama yeter mi sence?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451863
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451862
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451861
    m_Localized: 'Blind: İnanılır gibi değildi... Düşmanımın bile o şeyi görmesini istemem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451860
    m_Localized: 'Blind: Kapkara, kömür gibi yanmış cesetleri yiyordu... GÖZLERİMİN ÖNÜNDE HEM DE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451859
    m_Localized: 'Blind: O şey... beni başta fark etmedi bile. Yanık etleri yemekle meşguldü...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451858
    m_Localized: 'Blind: Tek hatam, yanlış zamanda yanlış yere gitmekti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451857
    m_Localized: 'Blind: O şey için bizim çektiğimiz acı, bir ziyafetten farksız! Korkumuzla, ızdırabımızla, zihinlerimizle besleniyor!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451856
    m_Localized: 'Blind: Güven bana, bilmesen daha iyi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451855
    m_Localized: Soluk adamı mı diyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451854
    m_Localized: Ne gördün ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451853
    m_Localized: 'Blind: Gözlerimi oyarsam o iğrenç anıyı aklımdan silebileceğimi düşündüm. Artık gördüğüm tek şey, ebedî bir boşluk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451852
    m_Localized: 'Blind: Aklımı sıyırmamak için gözlerimi feda etmek zorunda kaldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451851
    m_Localized: 'Blind: Bunu... ben yaptım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451850
    m_Localized: Soluk adamı mı diyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451849
    m_Localized: Ne gördün ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451848
    m_Localized: 'Blind: Güven bana... O şeyi sen de görseydin sen de gözlerini oyardın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451847
    m_Localized: 'Blind: Ruhumu parçalayan o kadim kasveti kelimelerle asla anlatamam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451846
    m_Localized: 'Blind: Daima gözlerimin önünde. Karanlıkta bile ondan kurtulamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451845
    m_Localized: 'Blind: Kelimelerle anlatamayacağım bir şeye tanık oldum. İnsan aklını kaybedince neler görmeye başlar, tahmin bile edemezsin...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451844
    m_Localized: Bunu sana kim yaptı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451843
    m_Localized: Gözlerine ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451842
    m_Localized: 'Blind: Nihayet... Bir sığınak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451841
    m_Localized: 'Fatman: Ne halt yiyeceğim ben şimdi, ha? Boku yedim!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451840
    m_Localized: 'Fatman: Saçmalık! Ne kadar kötü durumda olduğumu görmüyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451839
    m_Localized: 'Fatman: Bu işler düzeldiğinde... öhöm... sana karşılığını vereceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451838
    m_Localized: 'Fatman: Şahane. Pişman olmayacaksın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451837
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451836
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451835
    m_Localized: 'Fatman: Şimdi ben içeri alırsan... işler düzeldiğinde borcumu öderim. Borcunu da kat kat alırsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451834
    m_Localized: 'Fatman: Hadi, hadi... Karşılığını veririm bak...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451833
    m_Localized: 'Fatman: Önemli bir insanı geri çevirerek terbiyesizlik ediyorsun. Başınızda ben vardım ulan, ben! Bakandım ben!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451832
    m_Localized: 'Fatman: Buraya boş yere mi sürüklendim ben? Ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451831
    m_Localized: 'Fatman: Bak, ben ciddiyim delikanlı! Ben... iyi değilim. Soğuk su lazım bana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451830
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451829
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451828
    m_Localized: 'Fatman: Bayılıp kapının önünde gebermenin eşiğindeyim şu an!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451827
    m_Localized: 'Fatman: Beni dinle delikanlı. Aç şu kapıyı. Duş almam lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451826
    m_Localized: 'Fatman: Dondurma demişken evde dondurma var mıydı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451825
    m_Localized: 'Fatman: Şahane! Bir saniye daha dışarıda kalırsam dondurma gibi eriyeceğim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451824
    m_Localized: Lavabomda ne yapacaksın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451823
    m_Localized: İyi, kullan
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451822
    m_Localized: 'Fatman: Şöyle soğuk bir duş almam lazım. Rica etsem banyonu kullanabilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451821
    m_Localized: 'Fatman: Tropik otellerde kaldığımda bile bu kadar yanmıyordum!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451820
    m_Localized: 'Fatman: Derim eridi eriyecek, ne iyisi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451819
    m_Localized: 'Fatman: Hayır, iyi falan değilim! Baksana şu hâlime!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451818
    m_Localized: Lavabomda ne yapacaksın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451817
    m_Localized: İyi, kullan
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451816
    m_Localized: 'Fatman: Nefes alamıyorum. Lavabonu kullanabilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451815
    m_Localized: 'Fatman: Geceleri biraz daha serin oluyor ama hava öyle bir yoğun ki...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451814
    m_Localized: 'Fatman: Peh! Ona rağmen fırında gibiyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451813
    m_Localized: İyi misin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451812
    m_Localized: Gece yarısı şu an
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451811
    m_Localized: 'Fatman: Hof... Dışarısı hamam gibi. Eriyeceğim birazdan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451810
    m_Localized: 'Buddy: İyi o zaman, seni daha fazla rahatsız etmeyeceğim. Hadi görüşürüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451809
    m_Localized: 'Buddy: Vay be kanka...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451808
    m_Localized: 'Buddy: Sen olmasan yalnız kalırdım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451807
    m_Localized: 'Buddy: Çok sağ olasın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451806
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451805
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451804
    m_Localized: 'Buddy: Neyse, şaka bir yana. Beni içeri alacak mısın kanka?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451803
    m_Localized: 'Buddy: Tabii, bir de alkol var. Ayık kafayla bu işler hiç çekilmez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451802
    m_Localized: 'Buddy: Tamam be, bakma öyle. Yine bir şaka patlatayım dedim. Ne yapayım, elimizde gülmekten başka bir şey kalmadı!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451801
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451800
    m_Localized: 'Buddy: Lezzetli, sağlıklı, düzgün yaparsan kilo bile verirsin. Şu baklavalara bir baksana!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451799
    m_Localized: 'Buddy: Bu sabah sağlam bir kahvaltı yaptım. Arkadaşımın öğrettiği bir diyet var: Kahvaltıda bira, akşam yemeğinde şarap.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451798
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451797
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451796
    m_Localized: 'Buddy: Ee, beni içeri alacak mısın kanka?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451795
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451794
    m_Localized: 'Buddy: Şakalarımı beğenmediysen kusura bakma. Ben de soğukkanlı olmaya çalışıyorum işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451793
    m_Localized: 'Buddy: Arada bir gülmek insana iyi gelir kanka. Dünya başına yıkılsa bile. Gülmeyi bilmesem şimdiye kadar dayanamazdım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451792
    m_Localized: 'Buddy: Komedyenlik yapmıyorum ama arada bir gülmekten zarar gelmez, öyle değil mi? Dünya yeterince kasvetli zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451791
    m_Localized: Biraz sarhoş gibi konuşuyorsun. İçtin mi sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451790
    m_Localized: Nesin sen, komedyen falan mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451789
    m_Localized: 'Buddy: Neyse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451788
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451787
    m_Localized: 'Buddy: Kimseye sırf dişi veya gözü güzel diye zarar vermem. Televizyonda ne diyorlarsa işte. Hatta...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451786
    m_Localized: 'Buddy: Bir iki tuhaf belirti insanı Ziyaretçi yapmaz ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451785
    m_Localized: 'Buddy: Dalga geçiyorum be! Sen de amma ciddiymişsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451784
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451783
    m_Localized: 'Buddy: Yani evet, dişleri bembeyaz ve gözleri güzel olan insanları yumruklamayı seviyorum ama... kıskandığımdan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451782
    m_Localized: 'Buddy: İnan bana, benim kadar koca yürekli kimseyi bulamazsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451781
    m_Localized: Biraz sarhoş gibi konuşuyorsun. İçtin mi sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451780
    m_Localized: Nesin sen, komedyen falan mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451779
    m_Localized: 'Buddy: Barda takılasın falan olursa müsaidim yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451778
    m_Localized: 'Buddy: Kaynanam falan yok benim. Evlenmedim hiç!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451777
    m_Localized: 'Buddy: Heh, nasıl da kandırdım ama? Dalga geçiyorum be kanka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451776
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257716
    m_Localized: 'Buddy: FEMA çalışanını evden attım diye kaynanam beni evden kovdu. Peşine düşecekler diye korkuyor şimdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257715
    m_Localized: 'Buddy: Bir şey olduğu yok ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257714
    m_Localized: '"Delikanlı" biri olduğunu nereden bileceğim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257713
    m_Localized: Ne oldu sana?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257712
    m_Localized: 'Buddy: N''aber kanka? İçeride benim gibi delikanlı bir adama yer var mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257711
    m_Localized: 'Bestson: Görüşürüz yabancı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257710
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257709
    m_Localized: 'Bestson: Aynen... Yakında dönerler muhtemelen. Galiba. Umarım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257708
    m_Localized: 'Bestson: Ben eve döneyim en iyisi. Belki annemler de döner...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257707
    m_Localized: 'Bestson: Evet, muhtemelen bu daha güvenli olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257706
    m_Localized: 'Bestson: Gerçi... belki de haklısındır. Şimdilik seninle kalsam daha iyi olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257705
    m_Localized: 'Bestson: Ya eve gelirlerse ve beni bulamazlarsa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257704
    m_Localized: 'Bestson: Bunun iyi bir fikir olduğunu sanmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257703
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257702
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257701
    m_Localized: 'Bestson: Ne yapacağım ben şimdi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257700
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257699
    m_Localized: 'Bestson: Kâbus mu görüyorum ben?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257698
    m_Localized: 'Bestson: Of yoksa... Ya güneş onları yaktıysa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257697
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257696
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257695
    m_Localized: 'Bestson: Ne yapacağım ben şimdi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257694
    m_Localized: 'Bestson: Artık ne düşüneceğimi de bilmiyorum. Muhtemelen bana güvenmiyorsundur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257693
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257692
    m_Localized: 'Bestson: Of ya, of... Niye gittiler ki? Niye beni de almadılar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257691
    m_Localized: 'Bestson: Olamaz... Ya o "Ziyaretçi" şeyler onları öldürdüyse?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257690
    m_Localized: Güneş yakında patlayacak. Milleti canlı canlı yakıyor
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257689
    m_Localized: Yer altından Ziyaretçiler çıktı. Kimseye güvenemezsin artık
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257688
    m_Localized: 'Bestson: Birine sorarsam belki onlara ne olduğunu öğrenebilirim diye düşündüm. Rica etsem söyler misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257687
    m_Localized: 'Bestson: Haberi gördükten bir iki saat sonra alelacele evden çıktılar... ve geri dönmediler. Şimdi televizyonu açmaktan DAHA çok korkuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257686
    m_Localized: 'Bestson: Televizyonumu hiç açmazdım. Stres olmak istemezdim. Fakat annemler bir türlü geri dönmediler ve hâlâ ne olduğunu bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257685
    m_Localized: 'Bestson: Bir gün çok kötü bir haber görmüşler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257684
    m_Localized: 'Bestson: Annemle babam hep izlerdi ama.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257683
    m_Localized: 'Bestson: Bir yerde haber izlemeyen insanların daha uzun süre yaşadığını okudum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257682
    m_Localized: 'Bestson: Haberlerde hiç iyi bir şey çıkmıyor. Ya seni korkutuyorlar ya da üzüyorlar. Ben de o yüzden izlemiyorum artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257681
    m_Localized: Güneş yakında patlayacak. Milleti canlı canlı yakıyor
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257680
    m_Localized: Yer altından Ziyaretçiler çıktı. Kimseye güvenemezsin artık
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257679
    m_Localized: 'Bestson: Gerçeği öğrenmem gerek. Nereye gitti onlar? Lütfen... bana ne olup bittiğini anlat!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257678
    m_Localized: 'Bestson: Bu bir hafta önceydi. Hâlâ geri gelmediler. Bekleyip duruyorum ama bir türlü dönemediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257677
    m_Localized: 'Bestson: Bir gün bir uyandım, ortalık iyice karışmış. Hemen gitmeleri gerektiğini söylediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257676
    m_Localized: 'Bestson: Gerçekten yok. Haberleri görünce içim daralıyor da... Görmezden geliyorum. Annemler izliyor ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257675
    m_Localized: Hiç televizyona da mı bakmadın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257674
    m_Localized: Bir saniye... Gerçekten olan bitenden haberin yok mu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257673
    m_Localized: 'Bestson: Birbirlerini vuruyorlar, kavga ediyorlar... Anlam veremiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257672
    m_Localized: 'Bestson: Hava çok sıcak, nefes alamıyorum. İnsanlar da bir garip davranıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257671
    m_Localized: 'Bestson: Ne olup bittiğini söyler misin bana?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257670
    m_Localized: 'Fugitive: Peki, öyle olsun. İyi geceler o zaman piç herif.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257669
    m_Localized: 'Fugitive: Kendi çukurunuzda saklanıyorsunuz, kimseyi içeri almıyorsunuz!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257668
    m_Localized: 'Fugitive: Tabii ya. Tahmin etmeliydim. Diğerlerinden hiçbir farkın yok. Korkak sıçansınız hepiniz!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257667
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257666
    m_Localized: 'Fugitive: HAY SİKEYİM!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257665
    m_Localized: 'Fugitive: İyi ki komşuların gibi değilmişsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257664
    m_Localized: 'Fugitive: Sağ olasın. Cidden. Sana borçluyum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257663
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257662
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257661
    m_Localized: 'Fugitive: Şimdi de "tanık" oldum. Çok şey biliyorum. Kesin peşime düşecekler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257660
    m_Localized: 'Fugitive: Bu yüzden o mermiyi yemeyi göze aldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257659
    m_Localized: 'Fugitive: Bu olayı gördüğüm gibi kaçmam gerektiğini anladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257658
    m_Localized: 'Fugitive: İnsanlara bir şey yapıyorlar. Bu yüzden kimse o bölgelerden çıkamıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257657
    m_Localized: 'Fugitive: Başta boğuk bir çığlık duydum... Sonra ellerinde siyah bir poşetle çadırdan çıktılar. Herifi bir daha görmedim. Anlatabildim mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257656
    m_Localized: 'Fugitive: Kendi gözlerimle gördüm! Zavallı bir herifi çadıra sürüklediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257655
    m_Localized: 'Fugitive: Söylenti değil!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257654
    m_Localized: 'Fugitive: FEMA''nın Ziyaretçileri bulmak için test yaptığını duydun mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257653
    m_Localized: 'Fugitive: Aynen öyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257652
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257651
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257650
    m_Localized: 'Fugitive: Çitten atladığımda kendimi bir gölette buldum. Sonra tabanları yağlayıp yardırdım işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257649
    m_Localized: 'Fugitive: Gerçi tam doğru vakti seçmemişim belli ki. Piç kurularından biri arkasını dönüp beni gördü. Sonra sıkmaya başladılar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257648
    m_Localized: 'Fugitive: Güvenlik epey meşgul. Belli ki bir şeye hazırlanıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257647
    m_Localized: 'Fugitive: Plan yapmama bile gerek kalmadı. Fırsat kollayıp çitten atladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257646
    m_Localized: 'Fugitive: Güvenlik de bok gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257645
    m_Localized: 'Fugitive: Özetle FEMA karantina bölgeleri bu şekilde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257644
    m_Localized: 'Fugitive: Boşlukları da kocaman konteynerlerle doldur. Her sabah milleti sığır gibi o konteynerlere tıktıklarını hayal et.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257643
    m_Localized: 'Fugitive: Boş bir otopark düşün. Etrafı çitle kaplı. Bir iki tane de çadır var içinde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257642
    m_Localized: FEMA mı peşinde yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257641
    m_Localized: FEMA'nın karantina bölgelerinden bahsetsene
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257640
    m_Localized: 'Fugitive: Siktir olup gitmelerini söyledim ama... beni zanlı gibi kelepçelediler. Bir şekilde kurtuldum ama işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257639
    m_Localized: 'Fugitive: Sonra birden o tabletlerine bir şeyler yazmaya başladılar ve beni sürüklemeye kalkıştılar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257638
    m_Localized: 'Fugitive: Daha kapıyı açmadan beni taramaya başlamışlardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257637
    m_Localized: 'Fugitive: Karantina bölgesinden kaçtım. Arama yaparken kapıma uğradılar ve beni alıp götürdüler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257636
    m_Localized: FEMA mı peşinde yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257635
    m_Localized: FEMA'nın karantina bölgelerinden bahsetsene
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257634
    m_Localized: 'Fugitive: En azından bağırsaklarım dökülmedi. Dökülecek bir şey kalmadı gerçi de... Heh... Off, gülünce çok canım yanıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257633
    m_Localized: 'Fugitive: Mermi dümdüz içimden geçti neyse ki. Hayvan gibi kanıyor ama.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257632
    m_Localized: 'Fugitive: İyi ki nişan almayı beceremiyorlar, siktiklerim... Bir mermi hariç hepsini ıskaladılar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257631
    m_Localized: 'Fugitive: FEMA''nın şerefsiz köpekleri. Tam kaçarken beni çitin üzerinde yakaladılar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257630
    m_Localized: Ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257629
    m_Localized: Kim vurdu seni?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257628
    m_Localized: 'Fugitive: Vuruldum. Daha fazla dayanamam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257627
    m_Localized: 'Fugitive: Yardım et bana...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257626
    m_Localized: 'Nun: Tanrı seni mahşer gününde yargılayacaktır. Bu dediğimi unutma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257625
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257624
    m_Localized: 'Nun: Ben öldükten sonra vicdan azabından gözüne uyku girmez umarım evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257623
    m_Localized: 'Nun: Bu zavallı, muhtaç, yaşlı kadını geri çevireceksin demek?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257622
    m_Localized: 'Nun: Demek öyle?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257621
    m_Localized: 'Nun: Tanrı, dualarını kabul etsin evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257620
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257619
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257618
    m_Localized: 'Nun: Merak etme, evini bu pis laflardan arındırmak için elimden geleni yapacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257617
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257616
    m_Localized: 'Nun: Evin hakkında normal bir soru sordum, bu nasıl bir tavır böyle?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257615
    m_Localized: 'Nun: Yaradan''dan da mı korkmuyorsun? Hiç mi utanmıyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257614
    m_Localized: 'Nun: Bu lafları benim huzurumda edemezsin, seni imansız yaratık!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257613
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257612
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257611
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257610
    m_Localized: 'Nun: Çok mu şey istiyorum evlat?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257609
    m_Localized: 'Nun: Bu ev dediğin ahırın naçiz ihtiyaçlarımı karşılayıp karşılamayacağına bakıyorum sadece. Pisliğe asla tahammülüm yoktur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257608
    m_Localized: 'Nun: Yaradan''a şükürler olsun! Söylemeseydin asla fark edemezdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257607
    m_Localized: Kafayı mı yedin lan sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257606
    m_Localized: Burası otel değil!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257605
    m_Localized: 'Nun: Haşerelerden de nefret ederim. Yüce Yaradan''ın bu aşağılık mahlukları bende kaşıntı yapıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257604
    m_Localized: 'Nun: İki... Duvarlarında tahtakurusu ya da fare falan yok, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257603
    m_Localized: 'Nun: Evinde böyle musibetlerden varsa derhâl söyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257602
    m_Localized: 'Nun: Bir... Sarhoşlara ve müptezellere asla tahammülüm yoktur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257601
    m_Localized: 'Nun: Yardıma muhtaçlara kapın açıktır herhâlde, değil mi? Sadece birkaç şeyden emin olmam gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257600
    m_Localized: 'Nun: Evinde bir odaya ihtiyacım var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257599
    m_Localized: Kafayı mı yedin lan sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257598
    m_Localized: Burası otel değil!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257597
    m_Localized: 'Nun: Odalarda kutsal obje var, değil mi? Ayrıca dua ve ibadet ederken sessizlik isterim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257596
    m_Localized: 'Nun: Madem konusu açıldı, evin hakkında bazı sorularım var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257595
    m_Localized: 'Nun: Saklanmak için evlat. Burada kalmak istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257594
    m_Localized: 'Nun: Tanrı bize merhamet etsin... Gayet açık konuşuyorum işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257593
    m_Localized: Ne istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257592
    m_Localized: Hangi işini?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257591
    m_Localized: 'Nun: Benim işimi görür.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257590
    m_Localized: 'Nun: Görünüşe bakılırsa kargaşadan en uzak ev seninki evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257589
    m_Localized: 'Raskolnikov: Kusura bakma, senin de vaktini boşa harcadım. Umarım bir gün adam öldürmeyi öğrenirim ve kendimi koruyabilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257588
    m_Localized: 'Raskolnikov: Yemin ederim değilim! Son zamanlarda biraz gerginim, o kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257587
    m_Localized: 'Raskolnikov: Gerçi beni manyağa benzetmiş olabilirsin, normal. Hatta belki daha beterine...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257586
    m_Localized: 'Raskolnikov: Of ya... Beni içeri almayacak mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257585
    m_Localized: 'Raskolnikov: Bana nasıl yapıldığını gösterir misin? Ziyaretçileri nasıl öldürdüğünü. Ölümle yüzleşmek istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257584
    m_Localized: 'Raskolnikov: Bir de şey, zahmet olmazsa... Beni test ettikten sonra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257583
    m_Localized: 'Raskolnikov: Çok teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257582
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257581
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257580
    m_Localized: 'Raskolnikov: Bana adam öldürmeyi öğretebilecek birini...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257579
    m_Localized: 'Raskolnikov: Bir de şey... Hani, sen de istersen yani...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257578
    m_Localized: 'Raskolnikov: Bu yüzden, şey... Beni koruyabilecek birini arıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257577
    m_Localized: 'Raskolnikov: Bense korkağın tekiyim. Kendimi savunamıyorum bile!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257576
    m_Localized: 'Raskolnikov: Şu sıralar birine yan yan bakarsan bile hemen kafana sıkmaya hazır oluyor ya!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257575
    m_Localized: 'Raskolnikov: Ziyaretçilere karşı korunmaktan bahsediyorum. Bir de onları avlayan insanlardan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257574
    m_Localized: 'Raskolnikov: Dur, dur. Bekle. O tüfekli manyağı demiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257573
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257572
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257571
    m_Localized: 'Raskolnikov: İşte bu yüzden bu işlerden anlayan birinden ders almak istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257570
    m_Localized: 'Raskolnikov: Kendimi nasıl savunacağımı öğrenemezsem olacaklardan korkuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257569
    m_Localized: 'Raskolnikov: İşler çığırından çıkmadan önce karıncayı bile incitemezdim ama şu sıralar benim gibi şefkatli insanlara merhamet yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257568
    m_Localized: 'Raskolnikov: Beni manyağın teki sanmanı istemiyorum. Şey...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257567
    m_Localized: 'Raskolnikov: Off... Sana garip biri gibi mi geldim yoksa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257566
    m_Localized: Sen kendini tam olarak kimden korumaya çalışıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257565
    m_Localized: Ne bu cinayet aşkı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257564
    m_Localized: 'Raskolnikov: O zaman korku içinde yaşayan ben olmayacağım. Onlar olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257563
    m_Localized: 'Raskolnikov: Bir gün... Bir gün bende adam öldürmeyi öğreneceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257562
    m_Localized: 'Raskolnikov: Neyse ki beni görmedi. Görseydi... Oracıkta boynumu çıt diye kırardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257561
    m_Localized: 'Raskolnikov: Şeyden sadece... Karşıma silahlı bir manyak çıktı da. Adamın birini sorguya çekti. Ziyaretçi misin diye sorup durdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257560
    m_Localized: 'Raskolnikov: Ay, of... Beni yanlış anlama, seni birine düşman etmeye çalışmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257559
    m_Localized: 'Raskolnikov: Peki! O zaman karşımıza Ziyaretçi çıkarsa vurabilirsin!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257558
    m_Localized: Sen kendini tam olarak kimden korumaya çalışıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257557
    m_Localized: Ne bu cinayet aşkı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257556
    m_Localized: 'Raskolnikov: Hatta kendi ellerinle birini boğabilirsin belki. Zorunda kalırsan yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257555
    m_Localized: 'Raskolnikov: Sesinden cesur biri olduğun anlaşılıyor. Zorunda kalsan tetiği çekebilirsin yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257554
    m_Localized: 'Raskolnikov: Kıyamet koptu kopacak, birini öldürsen kimsenin gıkı çıkmaz yani. Yarış pistinde hızdan ceza yazmak gibi olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257553
    m_Localized: 'Raskolnikov: Şeyden işte ya... Çok tehlikeli bir dönemdeyiz yani. Kendini savunabiliyor musun diye merak ettim. Tehditlere karşı hani...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257552
    m_Localized: 'Raskolnikov: Ha, şey... Kusura bakma, kabalık etmek istemedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257551
    m_Localized: Evet, silahım var
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257550
    m_Localized: Niye sordun ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257549
    m_Localized: 'Raskolnikov: Şey, silahın var mıydı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257548
    m_Localized: 'Raskolnikov: Selam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257547
    m_Localized: 'Wifefema: Tamam ulan o zaman, siktir git. Komşularından biri beni alır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257546
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257545
    m_Localized: 'Wifefema: Sen kafayı mı yedin beyefendi? Hayat hikâyemi anlattım sana şurada, beni kaldırımda mı bırakacaksın böyle?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257544
    m_Localized: 'Wifefema: Ciddi misin lan sen? Kocam FEMA''da diyorum lan ben sana!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257543
    m_Localized: 'Wifefema: Yok daha neler! Sen beni Ziyaretçi mi sanıyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257542
    m_Localized: 'Wifefema: Bir saniye... Nasıl yahu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257541
    m_Localized: 'Wifefema: Bu ucubelerden kurtulduktan sonra normal vatandaşlar olarak hayatlarımıza devam edebiliriz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257540
    m_Localized: 'Wifefema: Ha şöyle!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257539
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257538
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257537
    m_Localized: 'Wifefema: "FEMA''ya kadın çalışan almama" kuralı tamamen saçmalık!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257536
    m_Localized: 'Wifefema: Gümrük memuruydum ulan ben. Şüphelileri benden iyi tespit eden olmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257535
    m_Localized: 'Wifefema: Hiç adil değil yani. Sırf kadınım diye kocamın yaptığı işi ben niye yapamayayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257534
    m_Localized: 'Wifefema: Ne önemi var ki zaten? Artık FEMA''da çalışıyor işte. Orta Çağ''da yaşamasalardı ben de orada çalışıyor olabilirdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257533
    m_Localized: 'Wifefema: Niye sana söyleyeyim ki? Niye soruyorsun yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257532
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257531
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257530
    m_Localized: 'Wifefema: Bir sürü pisliği yakaladım orada. Her türlü kaçak mal taşıyan vardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257529
    m_Localized: 'Wifefema: Ben eskiden gümrükte çalışırdım. Sınır kapısında ülkemi korurdum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257528
    m_Localized: 'Wifefema: Çok yazık oluyor bence. Kocamla birlikte Ziyaretçileri hemen bulurduk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257527
    m_Localized: 'Wifefema: Keşke ama maalesef. Kadın çalışan almıyorlarmış.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257526
    m_Localized: Kocan bundan önce ne iş yapıyordu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257525
    m_Localized: Sen de mi FEMA çalışanısın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257524
    m_Localized: 'Wifefema: Herif ayak üstünde soydu beni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257523
    m_Localized: 'Wifefema: Ona sürpriz yapmak isteyince işte taksi parasını bayıldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257522
    m_Localized: 'Wifefema: FEMA''ya transfer edileceğini duyduğumda yerlere göklere sığamadım!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257521
    m_Localized: 'Wifefema: Hemen söyleyeyim! FEMA çalışanıdır kendisi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257520
    m_Localized: Kocan bundan önce ne iş yapıyordu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257519
    m_Localized: Sen de mi FEMA çalışanısın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257518
    m_Localized: 'Wifefema: FEMA''lı kocamın güçlü kuvvetli ellerine düştü mü... o parlak dişleri her yere dağılacak, gör sen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257517
    m_Localized: 'Wifefema: Ama sana yemin ederim, şoförün dişleri porselen gibi bembeyazdı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257516
    m_Localized: 'Wifefema: Çok da para aldı herif. Taksimetreyi gördüğümde şok geçirecektim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257515
    m_Localized: 'Wifefema: Nasıl mı? Dümdüz taksiyle geldim işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257514
    m_Localized: Kocan ne işle uğraşıyor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257513
    m_Localized: Burayı nasıl buldun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257512
    m_Localized: 'Wifefema: O işteyken kalabileceğim bir yer yokmuş meğer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257511
    m_Localized: 'Wifefema: Ziyaret edip ona sürpriz yapacaktım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257510
    m_Localized: 'Wifefema: Kocamı görmek için şehre uğramıştım da... İş için buraya taşınmıştı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257509
    m_Localized: 'Wifefema: Selam. Biraz sende kalsam sorun olur mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257508
    m_Localized: 'Theorist: Peki. Sana güvenmek istemiştim... ama insanlığa karşı tüm güvenimi yitirdim sayende.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257507
    m_Localized: 'Theorist: İnsanlar gerçeği öğrenmeyi hak ediyor!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257506
    m_Localized: 'Theorist: Hata ediyorsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257505
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257504
    m_Localized: 'Theorist: İnan bana, ben gerçeği biliyorum! Duyduğun bütün yalanları unut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257503
    m_Localized: 'Theorist: Sana güvenebileceğimi biliyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257502
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257501
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257500
    m_Localized: 'Theorist: Ben de başımı dik tutup enstitüyü terk ettim. Çıkmadan arşive de uğramayı ihmal etmedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257499
    m_Localized: 'Theorist: Kulak tıkacı. Parazitlerin kafalarına girmesini engellemek için gereken tek şey buydu. Binlerce insanı kurtarabilirdik!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257498
    m_Localized: 'Theorist: Aptallar, bulgularımın değerini bilemediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257497
    m_Localized: 'Theorist: Asıl tehdidin Ziyaretçiler değil, içlerindekinin olduğunu savundum. Beyin parazitleri yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257496
    m_Localized: 'Theorist: Eskiden bir araştırma enstitüsünde çalışıyordum. Keşfettiğim bilgiler yüzünden beni kovdular.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257495
    m_Localized: 'Theorist: Başka kimseye söylemeyeceğine yemin edeceksin ama, anladın mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257494
    m_Localized: 'Theorist: Peki, tamam, söyleyeceğim. Sanırım sana güvenebilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257493
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257492
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257491
    m_Localized: 'Theorist: Sözde "patatesli" cipslerin sırrı. Bunların gerçekten patates olduğuna kim inanıyor ki? Bilimin yüz karası!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257490
    m_Localized: 'Theorist: Hükûmetin hazır yemeklerle vatandaşların beynini yıkaması... Evet, gerçekten. Son olarak...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257489
    m_Localized: 'Theorist: Oy kaçırma, aya inişin sahte olduğuna dair kanıtlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257488
    m_Localized: 'Theorist: Hazır ol dostum. Duyduklarına inanamayacaksın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257487
    m_Localized: Bunları nereden buldun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257486
    m_Localized: Anlamadım?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257485
    m_Localized: 'Theorist: Bu da demek ki... seninle önemli bir bilgi paylaşabilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257484
    m_Localized: 'Theorist: Onlar için çalışmadığını söylüyorsan yalan söylüyor olamazsın yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257483
    m_Localized: 'Theorist: FEMA protokolüne göre tüm çalışanlar, sorulduğu sürece kurumla bağlantıları olduğunu söylemek zorundalar. Protokol yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257482
    m_Localized: 'Theorist: Oh, iyi bari. Öyleyse sana güvenebilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257481
    m_Localized: Bunları nereden buldun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257480
    m_Localized: Ne tür sırlar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257479
    m_Localized: 'Theorist: Binlerce sayfa devlet sırrı. Hepsini ifşa etmeyi planlıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257478
    m_Localized: 'Theorist: Son derece hassas bilgiler içeren bazı belgeler var yanımda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257477
    m_Localized: 'Theorist: Saklanıp araştırmalarımı sürdürebileceğim güvenli bir yer arıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257476
    m_Localized: 'Theorist: Önemli bilgiler paylaşırsam diye hani!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257475
    m_Localized: Hayır, FEMA çalışanı falan değilim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257474
    m_Localized: Ne konuda güvenecekmişsin bana?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257473
    m_Localized: 'Theorist: FEMA çalışanı falan değilsin, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257472
    m_Localized: 'Theorist: Merhabalar. Söyle bana... Sana güvenebilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861319
    m_Localized: 'Firefighter: Burada ihtiyacım yok zaten, senin olsun. İster çöpe at ister kullan.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861318
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861317
    m_Localized: 'Firefighter: FEMA karantina bölgesine gitmemizi buyuran bir emirname. Bu karantina bölgelerinden canlı çıkan hiç görmedim, biz niye gidelim ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861316
    m_Localized: 'Firefighter: Yangınları söndürmeye gitmeden önce bize bu kâğıdı verdiler.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861315
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861314
    m_Localized: 'Firefighter: En azından yalnız başıma dışarıda ölmeyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861313
    m_Localized: 'Firefighter: Merak etme, seni uzun süre rahatsız etmem muhtemelen. (öksürür)'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861312
    m_Localized: 'Firefighter: Sağ olasın birader. (öksürür)'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297634
    m_Localized: 'Twins: Bazen hayat çok zor gelebilir. Kapalı bir kapıyı bile aşamayacağını sanırsın ama duramayız. Hadi, tuttum seni.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297633
    m_Localized: 'Twins: Biraz daha dayan kız. Sana dinlenecek bir yer bulacağız yakında, söz veriyorum. Gel hadi, yaslan bana.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297632
    m_Localized: 'Twins: Peki, anladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297631
    m_Localized: 'Twins: Bir süredir yollardayız. En azından burada biraz iyileşir diye düşündüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297630
    m_Localized: 'Twins: Anne babamız öldükten sonra... sanırım dayanamadı. Yine de elinden geleni yapıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297629
    m_Localized: 'Twins: Teşekkür ederiz. Dikkatli ol, şöyle belinden tutacaksın bak...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297628
    m_Localized: Öyleyse yolunuz açık olsun
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297627
    m_Localized: Ben ona hâkim olurum. Buyurun gelin
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297626
    m_Localized: 'Twins: Kusura bakma ama biz... burası biraz sakinleşene kadar bekleyeceğiz. Belki kalkar gider.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297625
    m_Localized: 'Twins: Açıkçası... ben de böyle ortamları pek kaldıramıyorum. Nefesim daralıyor bildiğin.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297624
    m_Localized: 'Twins: Kardeşim bunu kaldıramaz. İyice içine kapanır gider. Şimdiki hâlinden daha beter olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297623
    m_Localized: 'Twins: Onun olduğu yerde nefes alınmaz. Sessiz durduğunda bile insanın kulağının zarını patlatmayı becerir o.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297622
    m_Localized: 'Twins: Bu pek mantıklı olmayabilir. Sanırım {0} burada kalıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297621
    m_Localized: 'Twins: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297620
    m_Localized: 'Twins: Kardeşimi içeri taşımama yardım eder misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297619
    m_Localized: 'Twins: Al, bu EnerJeka senin. Başka bir şeyimiz yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297618
    m_Localized: 'Twins: Çok teşekkürler!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297617
    m_Localized: İkileyin hadi
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297616
    m_Localized: İyi madem, gelin içeri
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297615
    m_Localized: 'Twins: Evet, borcumuzu öderiz...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297614
    m_Localized: 'Twins: Lütfen bizi içeri al, bir günlüğüne bile olsa... Elimizde işine yarayacak bir şey olabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297613
    m_Localized: 'Twins: Lütfen...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297612
    m_Localized: 'NotTrue: Senin yine de kulağın delik olsun evladım. En ölümcül gerçekler, en sessiz fısıltılarla anlatılır.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297611
    m_Localized: 'NotTrue: Peh! Zaten buraya ait olmadığım belli. Öykülerimi de alır giderim ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297610
    m_Localized: 'NotTrue: Madem o kadar eminsin... Ama bak şimdiden söyleyeyim, ufukta bir fırtına görürsem veya ayna bana yalan söylerse kalkar giderim.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297609
    m_Localized: Öyleyse yolun açık olsun
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297608
    m_Localized: Ben ona hâkim olurum teyze. Buyur gel
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297607
    m_Localized: 'NotTrue: Kemiklerim eridi artık, bana fazla gelir. Toz olur giderim.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297606
    m_Localized: 'NotTrue: Senin için çok önemliyse kalsın, bir şey diyemem. Değişim rüzgârları esene dek durur beklerim. Ben fırtınalara dayanamam evladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297605
    m_Localized: 'NotTrue: Ben boşuna yalnız dolaşmıyorum evladım. Gürültülü yerler, kalabalık yerler... bana yaramaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297604
    m_Localized: 'NotTrue: Bir an kavga çıkarır, sonra fısır fısır konuşur... Benim gibi ihtiyar bir hanım böyle ortamları kaldıramaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297603
    m_Localized: 'NotTrue: Merhaba evladım... O içerideki kim? {0} değil mi o?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297602
    m_Localized: 'Super: Korkunç bir şekilde ortalıktan kayboldun. Ev tamamen terk edildi. İnsanlar kalıntılarından vebalı görmüş gibi kaçıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297601
    m_Localized: 'Super: Evin uzun bir süre boş kaldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297600
    m_Localized: 'Super: O son Ziyaretçi kapına uğradıktan sonra ne oldu, kimse bilmiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909020
    m_Localized: İkile
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909019
    m_Localized: İyi madem, gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909018
    m_Localized: 'Fanatic: İçeri girmeme izin verirsen KUTSAL GÜNEŞ sana bizzat bir armağan bahşedecek. Bu kararını tekrar düşünmeni öneriyorum!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909017
    m_Localized: 'Fanatic: ERDEMLİ ve DÜRÜST bir adamı kapından kovuyorsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909016
    m_Localized: 'Fanatic: Embesil misin lan sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909015
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909014
    m_Localized: 'Fanatic: Buyur, Kutsal Güneş''in sana bizzat armağanı: Bir kutu EnerJeka! Bunu hak ettin insan!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714697
    m_Localized: Yok, sende kalsın
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714696
    m_Localized: İyi madem, gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714695
    m_Localized: 'Firefighter: Beni içeri alırsan sana veririm. Son günlerimi huzur içinde geçirmek istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714694
    m_Localized: 'Firefighter: Yanımda bir (öksürür) kâğıt var. Önemli bir belge.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714693
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714692
    m_Localized: 'Firefighter: Burada ihtiyacım yok zaten, senin olsun. İster çöpe at ister kullan.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714691
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714690
    m_Localized: 'Firefighter: FEMA karantina bölgesine gitmemizi buyuran bir emirname. Bu karantina bölgelerinden canlı çıkan hiç görmedim, biz niye gidelim ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714689
    m_Localized: 'Firefighter: Yangınları söndürmeye gitmeden önce bize bu kâğıdı verdiler.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714688
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255168
    m_Localized: 'Twins: Sonumuz ne olacak?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255167
    m_Localized: 'Twins: Hadi, gidelim. Biraz yardımcı ol bana.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255166
    m_Localized: 'Twins: Tüh. Şansımızı başka bir yerde denememiz gerekecek desene kız.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255165
    m_Localized: 'Twins: Belki buradayken biraz da olsa kendine gelir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255164
    m_Localized: 'Twins: Anne babamız ölünce daha kötü oldu ama bir süredir böyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255163
    m_Localized: 'Twins: Teşekkür ederiz! Onu içeri taşımama yardım et lütfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255162
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255161
    m_Localized: Gelin içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255160
    m_Localized: 'Twins: Anne babamızın evini birlikte terk ettik. Güvenecek başka kimsemiz yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255159
    m_Localized: 'Twins: Evet, bu çok yorucu olabiliyor ama onu asla terk etmem. İma ettiğin buysa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255158
    m_Localized: 'Twins: Lütfen söylediklerine dikkat et.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255157
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255156
    m_Localized: Gelin içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255155
    m_Localized: 'Twins: ...ama ben katılmıyorum. Hatta bence artık yaşamak daha kolay olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255154
    m_Localized: 'Twins: Ölüp gideceğimizi söylüyorlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255153
    m_Localized: 'Twins: Sonra yeni bir sayfa açarız.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255152
    m_Localized: 'Twins: Kardeşimin daha rahat olacağı bir yer bulmam gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255151
    m_Localized: Onu taşıyıp durmaktan bıkmadın mı?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255150
    m_Localized: Bundan sonra ne yapacaksınız?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255149
    m_Localized: 'Twins: Haberleri hiç izlemiyor musun? Sonumuzun böyle olacağı belliydi. Güneşin patlayacağını da düşünmüyorum açıkçası.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255148
    m_Localized: 'Twins: Bu güneş mevzusu başlamadan önce bile gidişatın farkındaydık.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255147
    m_Localized: 'Twins: Herkes az çok bunalımda zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255146
    m_Localized: Onu taşıyıp durmaktan bıkmadın mı?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255145
    m_Localized: Bundan sonra ne yapacaksınız?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255144
    m_Localized: 'Twins: Şu an pek konuşası yok ama bazen gücünü toplayıp dile geldiği oluyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255143
    m_Localized: 'Twins: Sorun değil ama. Bir gün daha iyi olacak elbet. Değil mi kız?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255142
    m_Localized: 'Twins: Kendi başına yürüyemiyor, kendini yıkayamıyor. Bazen yataktan bile zor çıkıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: Anlat bakalım
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: Burada ne işin var?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: Anlat bakalım
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: Burada ne işin var?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: Ne olup bitiyormuş tam olarak?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: Ne istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: Arkadaşının yardıma ihtiyacı var mı?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: Arkadaşın hasta mı?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: Arkadaşının yardıma ihtiyacı var mı?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: Arkadaşın hasta mı?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: Burada dinlendikten sonra nereye gideceksin?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: Nereden geliyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: 'Anxiety: Buraya gelmeyi ben istemedim ki. Yollar eriyor olabilir ama durumumuz daha kötü de olabilirdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: 'Anxiety: Evimin yakınındaki bir dükkânda kasiyerdim. Eskiden yani. Artık orada çalışmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: 'Anxiety: Tahmin edeceğin üzere asfalt çok ısındı, hehe. Heh hehe...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: 'Fanatic: Yolun açık olsun sikik herif! HADİ BEN KAÇAR!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: 'Fanatic: Siktir git lan o zaman! BEN DE BAŞKASINI KURTARIRIM!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: 'Fanatic: Güneş''i bilmezden gelmeye mi çalışıyorsun sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: 'Fanatic: Ha, unutmadan sorayım. Evde bira var mı bira?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: İŞTE BÖYLE İNSAN! Bu konunun derinliklerine inebiliriz!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: 'Fanatic: Anlıyorsun, anlıyorsun. Anlamasan hâlâ yaşıyor olamazdın!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: 'Fanatic: Kutsal ışıklarıyla bizi bu işkenceden kurtaracak, anlamıyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: 'Fanatic: Güneş bizi kurtardıktan sonra EHLİKEYİF olacağız hepimiz!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: Benimle ne alakası var bunun?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: 'Fanatic: Bir hayal etsene! Bütün bunları neden yaşıyoruz, şimdi anlıyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: 'Fanatic: Artık ölüm olmayacak, hırsızlık olmayacak, istediğimi bana düzgün bir fiyata satmayı reddeden KANCIKLAR olmayacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: 'Fanatic: Günahlarımızdan arınacağız. Güneş belki yok olabilir fakat BİZLER yaşayacağız.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: Tam tersi!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: Sana ne olacak?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: Ölmemiz mi gerekiyor yani?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: 'Fanatic: Bu, Güneş''in bir lütfu! Tüm günahlarımızdan arınıp onun huzurunda ahlakı bütün kül yığınları olarak yaşayacağız!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: 'Fanatic: HESAP GÜNÜ GELDİ ÇATTI!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: 'Fanatic: Şevkimiz ve açgözlülüğümüz dünyayı kirletti, GÜNEŞ''İ KIZDIRDI!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: 'Fanatic: Güneş bizi boşu boşuna yakmaz, CANLI CANLI PİŞİRMEZ! Amacı bizi günahlarımızdan arındırmak!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: 'Fanatic: Gel, sana basitçe anlatayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: Korkuyorum deme sakın! Kafayı mı yedin sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: Sana ne olacak?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: Ölmemiz mi gerekiyor yani?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: 'Fanatic: Bu, Güneş''in bir lütfu! Tüm günahlarımızdan arınıp onun huzurunda ahlakı bütün kül yığınları olarak yaşayacağız!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: 'Fanatic: HESAP GÜNÜ GELDİ ÇATTI!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: 'Fanatic: Şevkimiz ve açgözlülüğümüz dünyayı kirletti, GÜNEŞ''İ KIZDIRDI!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: 'Fanatic: Güneş bizi boşu boşuna yakmaz, CANLI CANLI PİŞİRMEZ! Amacı bizi günahlarımızdan arındırmak!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: 'Fanatic: Gel, sana basitçe anlatayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: Hâlâ anlamadın mı İNSAN?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: Beni korkutuyorsun dostum
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: Ne?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: 'Fanatic: GÖKTEN NİMET IŞIYOR ÜSTÜMÜZE LAN, NİMET!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: Yakında saf ve tertemiz bir dünyaya kavuşacağız!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: 'Fanatic: Dünya GÜNAHLARDAN arınıyor. Güneş kutsal görevini yerine getiriyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: 'Fanatic: Mahşer gününe gözümüzle şahit olduğumuz için ne kadar şanslıyız!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: Merhaba insan.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: 'Prophet: Şimdi gideceğim ve seçtiğin paragraf üzerine uzun uzun düşüneceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: Nedenini henüz söyleyemem ama işini kolaylaştıracak, orası kesin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: 'Prophet: Kediyle göz göze geldiğinde ona içeriyi göstermeyi ihmal etme.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: Bunun ne anlama geldiğini düşünürken bir mesaj iletmem gerektiği aklıma geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: 'Prophet: Bunu daha ziyade bir tavsiye olarak görüyorum. Yapılmamış iyilikleri, dikkat çağrılarını unutmayasın diye.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: Tam değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: 'Prophet: Benim de senin bu kehanetin üzerine iyice düşünmem gerekiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: 'Prophet: Bu bilgiyi nasıl kullanacağın sana kalmış tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: 'Prophet: Ne işe yarayacağını henüz anlatamam fakat sana yardımcı olacağından eminim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: 'Prophet: Kulağa garip gelebilir... ancak kedinin eve girmesi gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: Hazır olman gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: Yakında bazı hadiseler gerçekleşecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: Neyse, buraya sana bir şey söylemeye gelmiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: 'Prophet: Bunu iyice düşünmem lazım. Senin bir fikrin var mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: Buna inanıyor musun gerçekten?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: Bu ne anlama geliyor?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: Enteresan bir paragraf.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: 'Prophet: Ne düşünüyorsun? Başkasının rüyasında mıyız gerçekten? Yoksa rüya gören biz miyiz?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: Hım... Yakında her şey solup gidecek gibi geliyor sahiden.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: 'Prophet: Belki de kimse gerçek değildir ve yalnızca dışarıda yağmur yağıyordur."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: 'Prophet: ...Belki de biz, yalnızca çoktan ölmüş birinin hatırasıyızdır.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: 'Prophet: "Çok uzun zaman önceydi. Belki de yalnızca bir rüyaydı. Belki de ben, sen, o balık...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: Buna inanıyor musun gerçekten?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: Bu ne anlama geliyor?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: Gayet muhtemel.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: 'Prophet: Bizi bekleyen bu mudur yoksa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: 'Prophet: Hım... Evet. Sahiden trajik bir hikâye.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: 'Prophet: "Ben mi? Ben benim. Sen... Sense yuvamdın."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: Sen kimsin?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: Buna inanıyor musun gerçekten?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: Bu ne anlama geliyor?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: Gerçi bunu duymak artık pek şaşırtıcı olmayabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: Durumumuza ne kadar da uygun.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: İnanılmaz...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: 'Prophet: "Ölüler, yakında dile gelecek ancak kimse sözlerine kulak vermeyecek."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: Sonlarına doğru aç
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: Tam ortasından aç
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: Başlardan bir sayfa aç
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: 'Prophet: Bu kitaptan bir sayfa seçerek falıma bakmanı istiyorum. Neresini açayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: 'Prophet: Bu diyaloğu... bir kehanetle başlatmak istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: 'Prophet: Hım... Garip bir durum sahiden. Açıklamakta zorlanıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: 'Prophet: Yolumuz son kesiştiğinde koşullar daha farklıydı ancak hâlâ hayattayız.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: Kendinize dikkat edin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: 'Gasmask: Yanımıza bir kişiyi alıp en kısa sürede geri göndereceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: Şu an endişelenmenizi gerektiren bir durum yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: 'Gasmask: Evet. Bilgi topladıktan sonra tüm vatandaşlara talimat vereceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: Bir kişiyi alıp gideceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: 'Gasmask: O zaman gerek yok. Siz diğer sakinlerle kalın. Evi tahliye etmeniz gerekirse sizi haberdar ederiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: Burası sizin eviniz mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: Burada oturup bir şeyler olmasını mı bekleyeceğim yani?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: Bavullarımı toplayayım mı?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: 'Gasmask: Bir sıkıntı olup olmadığına bakmak için birkaç test yapacağız, ardından onu geri göndereceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: Burada yaşayanlardan birini alıp laboratuvarımıza götüreceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: 'Gasmask: Var tabii fakat kanıt olmadan harekete geçemeyiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: Burada oturup bir şeyler olmasını mı bekleyeceğim yani?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: Bavullarımı toplayayım mı?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: 'Gasmask: İnsan mı değil mi, ona da bakacağız tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: 'Gasmask: İyi olup olmadığını görmek için üzerinde test yapacağız ve burada yaşamaya devam edip edemeyeceğine karar vereceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: FEMA'nın bir planı var mı?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: Şimdi ne yapacaksınız?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: 'Gasmask: Şu an tek yapmanız gereken sakin kalmak.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: Bunu hallettikten sonra uygun bir çözüm prosedürü geliştirebileceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: 'Gasmask: İlk işimiz, FEMA karargâhına göndermek üzere daha fazla veri toplamak.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: FEMA'nın bir planı var mı?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: Şimdi ne yapacaksınız?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: 'Gasmask: Dışarıda çok vakit geçirdiğimiz için temkini elden bırakmamak gerekiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: 'Gasmask: Güneşin çevre üzerindeki etkilerini hâlâ araştırmaktayız.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: 'Gasmask: Hayır ama kendinizi daha güvende hissedecekseniz satın alabilirsiniz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: Bize nasıl yardımcı olacaksınız?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: Niye koruyucu kıyafet giyiyorsunuz? Bizim de giymemiz gerekmez mi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: 'Gasmask: Zaten Ziyaretçiler grup hâlinde pek hareket etmiyor. Hatta hiç desek yeridir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: İçinizi rahatlatacaksa kimliğimi gösterebilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: Bize nasıl yardımcı olacaksınız?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: Niye koruyucu kıyafet giyiyorsunuz? Bizim de giymemiz gerekmez mi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: Çok vaktinizi almayacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: 'Gasmask: İşimizi hızlı bitirelim diye ekip olarak dağıldık.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: Değilim tabii ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: Size nasıl güveneceğim?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: Yalnız mısınız?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: 'Gasmask: FEMA''dan geliyorum. Mahalledeki herkese ev ziyareti yapıyoruz, ev sakinlerini kontrol ediyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: 'Firefighter: Umarım bu yangınlar (öksürür) şehirlere yayılmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: Yalnız ölmek istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: Ah be birader. (öksürür)'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: 'Firefighter: En azından yalnız başıma dışarıda ölmeyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: 'Firefighter: Merak etme, seni uzun süre rahatsız etmem muhtemelen. (öksürür)'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: Elin eline düştük işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: 'Firefighter: Artık eve de gidemiyorum. Toplu taşıma diye bir şey kalmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: 'Firefighter: Yapacağımı yaptığımı (öksürür) bana belli ettiler gerçi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: 'Firefighter: Yangınları söndürmek istemiştim. Keşke diğer arkadaşlarımla birlikte ormanda ölseydim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: Zaten çok vaktim kalmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: 'Firefighter: Keşke ekip arkadaşlarımla yangınları söndürürken geberip gitseymişim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: Bu saatten sonra (öksürür) beni kimse kurtaramaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: 'Firefighter: Doktorun insan olup olmadığını bilmeyince tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: 'Firefighter: Bu Ziyaretçiler ortaya çıktığından beri hastanelerin bir anlamı kalmadı zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451888
    m_Localized: 'Dude: Tamam o zaman ya, gerisi bende aga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451889
    m_Localized: 'Dude: Bir sürü zombi filmi izledim. Bu iş benden sorulur yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451890
    m_Localized: 'Dude: Şimdi bu dediklerin klasik yavaş zombiler gibi mi yoksa o yardıranlardan mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451891
    m_Localized: 'Dude: Bir de höğröğğğöğhöğgr beyin virüsü tarzında mı yoksa hortlaklar mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451892
    m_Localized: 'Dude: Cevap çok önemli moruk. Planı ona göre yapacağım!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451893
    m_Localized: 'Dude: Elinde pompalı, el bombası falan var mı? Bir sürü silah lazım olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451894
    m_Localized: 'Dude: Bir de yemek. BİR SÜRÜ yemek lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451895
    m_Localized: Ne anlatıyorsun sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451896
    m_Localized: Ne olup bittiğini bilmiyor musun gerçekten?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451897
    m_Localized: 'Dude: Anlamadın mı işte aga?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451898
    m_Localized: 'Dude: Bilim kurgu yazarları geleceğin nasıl olacağını biliyor ya hani?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451899
    m_Localized: 'Dude: Beyinlerinin tamamını kullanıp teknolojileri önden tahmin ediyorlar falan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451900
    m_Localized: 'Dude: Uzaya gidip uzaylılara mesaj yolladığımızı düşünsene? Oğluuum...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451901
    m_Localized: 'Dude: Manyak olurdu lan! Benim bi'' arkadaş vardı, bi'' dergide okumuş...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451902
    m_Localized: 'Dude: Tamam ya, sakin ol. Hadi hadi, içeri al beni!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451903
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451904
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451905
    m_Localized: 'Dude: Dışarısı iyice karıştı ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451906
    m_Localized: 'Dude: Millet birbirinin arkasından konuşuyor falan, modumu düşürüyorlar yani...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451907
    m_Localized: 'Dude: Haberler de hiç akmıyor yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451908
    m_Localized: 'Dude: Ama filmler var ya filmler...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451909
    m_Localized: 'Dude: Ne ararsan var! Dram, ihanet, gizem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451910
    m_Localized: 'Dude: Kitap okumaktan on kat daha iyidir aga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451911
    m_Localized: 'Dude: Umarım bir gün bir filmde oynarım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451912
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451913
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451914
    m_Localized: 'Dude: Ohaaaa! Sağ olasın kanka!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451915
    m_Localized: 'Dude: Oğluuum, çok iyi oldu lan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451916
    m_Localized: 'Dude: Bir gün bunun filmini çekmeliler bence!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451917
    m_Localized: 'Dude: Ah be...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451918
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451919
    m_Localized: 'Dude: Olsun be kanka. Sorun değil yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451920
    m_Localized: 'Dude: Kendine iyi bak aga. Agalarına da iyi bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451921
    m_Localized: 'Teacher: Kusura bakma... Müsait miydin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451922
    m_Localized: 'Teacher: Çok kötü hissediyorum. Biraz konuşabilir miyiz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451923
    m_Localized: Ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451924
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451925
    m_Localized: 'Teacher: Tek istediğim... terk edilen çocuklar için ümit ışığı olmaktı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451926
    m_Localized: 'Teacher: "Lekeli" gördüklerini yanıma aldım. Ziyaretçi olduğunu düşündükleri çocukları yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451927
    m_Localized: 'Teacher: Eski anaokulunda birlikte yaşıyorduk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451928
    m_Localized: 'Teacher: Onlara göz kulak olacak, onları sevecek birine ihtiyaçları vardı. Elimden geleni yaptım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451929
    m_Localized: 'Teacher: Ama yetmedi. Onları kurtaramadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451930
    m_Localized: Çocuklara ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451931
    m_Localized: Yangın nasıl çıktı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451932
    m_Localized: 'Teacher: Öğretmendim ben. Anaokulu öğretmeni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451933
    m_Localized: 'Teacher: Dünya yıkılmaya başlayınca terk edilen minikleri yanıma aldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451934
    m_Localized: 'Teacher: Her biri farklı sebeplerden ötürü ebeveynlerinden ayrılmıştı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451935
    m_Localized: 'Teacher: Bazılarının annesini babasını FEMA alıp götürmüştü. Bazılarınınkiler ölmüştü. Bazıları...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451936
    m_Localized: 'Teacher: Bazı anneler ve babalar da çocukları küçücük bir Ziyaretçi belirtisi gösterdi diye onları terk etmişti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451937
    m_Localized: 'Teacher: Şimdi... hepsi gitti. Hiçbiri yangından canlı çıkamadı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451938
    m_Localized: Çocuklara ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451939
    m_Localized: Yangın nasıl çıktı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451940
    m_Localized: 'Teacher: Hepsi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451941
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451942
    m_Localized: 'Teacher: Hepsi yangında öldü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451943
    m_Localized: 'Teacher: Kasabadakiler yaptı. Çocukların Ziyaretçi olduğundan korktular.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451944
    m_Localized: 'Teacher: Bana da zorla izlettiler. Önce kapıları kilitlediler, pencereleri tahtayla kapadılar... Sonra da binayı yaktılar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451945
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451946
    m_Localized: 'Teacher: Korku dolu minik gözleriyle beni seyrettiklerini bir türlü unutamıyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451947
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451948
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451949
    m_Localized: 'Teacher: Kasabadakiler yaptı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451950
    m_Localized: 'Teacher: Ziyaretçi belirtisi gösteren çocukları koruduğumu öğrendiler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451951
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451952
    m_Localized: 'Teacher: Ne oldu bize böyle? Ne ara çaresiz çocukları linç edecek hâle geldik?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451953
    m_Localized: 'Teacher: Bunu hak edecek ne yapmış olabilirler?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451954
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451955
    m_Localized: 'Teacher: Hepsini yaktılar. Bana da zorla izlettiler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451956
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451957
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451958
    m_Localized: 'Teacher: Onları geri getiremeyeceğimin farkındayım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451959
    m_Localized: 'Teacher: Ama beni dinlediğin için teşekkür ederim. Bir de girmeme izin verdiğin için.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451960
    m_Localized: 'Teacher: Seni suçlamıyorum. Yine de lütfen... bana bir söz ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451961
    m_Localized: 'Teacher: Muhtaç ve yalnız bir çocukla karşılaşırsan... lütfen ona iyi bak. Elveda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451962
    m_Localized: 'Ballerina: Selam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451963
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451964
    m_Localized: 'Ballerina: Sen açıyor mu, açmıyor mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451965
    m_Localized: Sen... kel adamı tanıyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451966
    m_Localized: Ne istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451967
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451968
    m_Localized: 'Ballerina: Sen çok soru soruyor. Evet, ben tanıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451969
    m_Localized: 'Ballerina: Sen niye soruyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451970
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451971
    m_Localized: Evimi nasıl buldun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451972
    m_Localized: 'Ballerina: Bir kasa bira. Çekmece. Dana but. Bilmiyor. Sen ne varsa ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451973
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451974
    m_Localized: 'Ballerina: Sen açacak mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451975
    m_Localized: 'Ballerina: Bana buraya gel dediler, ben de geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451976
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451977
    m_Localized: Evimi nasıl buldun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451978
    m_Localized: 'Ballerina: Ben dans ediyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451979
    m_Localized: 'Ballerina: Bale. Anlaşılıyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451980
    m_Localized: Seni buraya birisi mi gönderdi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451981
    m_Localized: Bana... birini hatırlatıyorsun
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451982
    m_Localized: 'Ballerina: Sen şehri görüyor? Ben orada yaşıyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451983
    m_Localized: 'Ballerina: Evini gördü. Buraya yürüdü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451984
    m_Localized: 'Ballerina: Bura sıcak değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451985
    m_Localized: Seni buraya birisi mi gönderdi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451986
    m_Localized: Bana... birini hatırlatıyorsun
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451987
    m_Localized: 'Ballerina: Sanmıyor. Neden önemli?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451988
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451989
    m_Localized: 'Ballerina: Heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451990
    m_Localized: Senin insan olduğuna inanmıyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451991
    m_Localized: İnsan olduğunu kanıtla
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451992
    m_Localized: 'Ballerina: Öyle mi? Tamam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451993
    m_Localized: 'Ballerina: Ee? Sen daha bir şey söyleyecek mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451994
    m_Localized: 'Ballerina: Sen garip bir şey söyledi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451995
    m_Localized: Senin insan olduğuna inanmıyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646080
    m_Localized: İnsan olduğunu kanıtla
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646081
    m_Localized: 'Ballerina: Ee?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646082
    m_Localized: 'Ballerina: Dans edeyim mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646083
    m_Localized: 'Ballerina: Ben dans edebilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646084
    m_Localized: 'Ballerina: Ben bal-eriğinim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646085
    m_Localized: 'Ballerina: Ee? Sen karar verecek? Biz ne yapıyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646086
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646087
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646088
    m_Localized: 'Ballerina: İki kol, iki bacak, bir baş.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646089
    m_Localized: 'Ballerina: Sana yetmiyor mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646090
    m_Localized: 'Ballerina: Ben testi geçti mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646091
    m_Localized: 'Ballerina: Sen açıyor mu açmıyor mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646092
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646093
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646094
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646095
    m_Localized: 'Ballerina: Zavallı dansçı soğukta donuyor... Çok üzgün...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646096
    m_Localized: 'Ballerina: Sen kediye işkence yapma. Kedi soğuk sevmiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646097
    m_Localized: 'Ballerina: Kediye bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646098
    m_Localized: 'Ballerina: Bir daha düşün.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646099
    m_Localized: İyi, peki... Gel
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646100
    m_Localized: Yürü git lan hadi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646101
    m_Localized: 'Ballerina: Ben burada dinlenecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646102
    m_Localized: 'Ballerina: Hadi kedicik. Koş, eğlen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646103
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646104
    m_Localized: 'Ballerina: Sen evin altında kedi bul.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646105
    m_Localized: 'Ballerina: Benim küçük hediye.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646106
    m_Localized: 'Couple: Hah, böyle daha iyi oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646107
    m_Localized: 'Couple: Selamlar! Sevgili karım ve ben, sığınacak güvenli bir yer aramaktayız!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646108
    m_Localized: 'Couple: Biraz burada kalsak sorun olur muydu? Zahmet olmazsa tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646109
    m_Localized: Evim güvenli bir yere benziyor mu sence?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646110
    m_Localized: Ya SEN güvenli biri değilsen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646111
    m_Localized: 'Couple: Açıkçası bu ev gördüğümüz diğer evlerden çok daha güvenli görünüyor. Değil mi hayatım?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646112
    m_Localized: 'Couple: Yani nasıl desem bilemedim. Haha...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646113
    m_Localized: 'Couple: Ev büyük, diğer yerlerden uzak, burnunu sokacak bir komşu yok... Manyağın tekinin burayı bulması daha zor olur, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646114
    m_Localized: Karın konuşamıyor mu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646115
    m_Localized: Neden bu kadar yorgunsunuz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646116
    m_Localized: 'Couple: Yani... Başka bir yere de sığınabiliriz herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646117
    m_Localized: 'Couple: Karım biraz yorgun ama. Dinlenmesi gerekiyor. Kısa süreliğine de olsa kalamaz mıyız?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646118
    m_Localized: 'Couple: Zahmet olmazsa hani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646119
    m_Localized: Karın konuşamıyor mu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646120
    m_Localized: Neden bu kadar yorgunsunuz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646121
    m_Localized: 'Couple: Konuşabiliyor tabii! Bir şey söylesene hayatım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646122
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646123
    m_Localized: 'Couple: Kusura bakma, çok yorgun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646124
    m_Localized: 'Couple: Başka bir gün hepimiz konuşuruz. Yine karşılaşırsak tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646125
    m_Localized: 'Couple: Değil mi tatlım?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646126
    m_Localized: 'Couple: Pardon, seni böyle zorlamak istememiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646127
    m_Localized: Gelin içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646128
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646129
    m_Localized: 'Couple: Bütün bu yaşananlar yüzünden yorulmamak elde değil. Ziyaretçiler, güneş, kovulmam...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646130
    m_Localized: 'Couple: Her şey üst üste geldi. Zor oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646131
    m_Localized: 'Couple: Her şeyi karıma borçluyum. O olmasaydı asla ayakta duramazdım. SENİ ayakta tutan ne peki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646132
    m_Localized: 'Couple: Kusura bakma, bunu sormamalıydım. Beni alakadar etmez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646133
    m_Localized: Gelin içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646134
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646135
    m_Localized: 'Couple: Çok teşekkürler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646136
    m_Localized: 'Couple: Ne duruyorsun? Hadi tatlım, bak. Kibar adam bizi evine davet ediyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646137
    m_Localized: 'Couple: Biraz utangaç, ondan. Sorun değil hayatım, şimdi biraz dinlenince iyice kendine gelirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646138
    m_Localized: 'Couple: Anlaşıldı. Kusura bakma, seni de rahatsız ettik.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646139
    m_Localized: 'Couple: Aramaya devam artık, değil mi tatlım?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646140
    m_Localized: 'Couple: Hadi hadi, aylaklık yapma. Ben de yorgunum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646141
    m_Localized: 'BigLebowski: N''aber? Ay... Merhabalar! Böyle daha iyi oldu galiba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646142
    m_Localized: 'BigLebowski: Burası senin mekân mı? Şey, pardon... Burası sizin eviniz mi bayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646143
    m_Localized: Birini mi arıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646144
    m_Localized: Evet, benim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646145
    m_Localized: 'BigLebowski: Yoo... Bir süre kalacak bir yer arıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646146
    m_Localized: 'BigLebowski: Milletin bodrumunda saklanmaktan bıktım. Böyle devam edersem yakında konuşmayı unutacağım. Gerçi senin umurunda değildir bu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646149
    m_Localized: Niye bodrumlarda saklanıyorsun ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646150
    m_Localized: Annen baban nerede senin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646151
    m_Localized: 'BigLebowski: Pekiiiii... Gelebilir miyim yani? Yoksa beni burada mı bırakacaksın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646152
    m_Localized: 'BigLebowski: Saklanacak bir bodrum falan bulamadım, o yüzden buraya geldim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646155
    m_Localized: Niye bodrumlarda saklanıyorsun ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646156
    m_Localized: Annen baban nerede senin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646157
    m_Localized: 'BigLebowski: Yani... seyahat ediyorum diyelim. Dünyayı geziyorum. Farklı yerleri görmek istiyorum. Belki bir yerde yeni bir ev bulurum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646158
    m_Localized: 'BigLebowski: Ama beş param yok. Bu yüzden ya milletle anlaşıyorum ya da gizlice bodrumlarına giriyorum. Hayat işte, n''apalım?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646159
    m_Localized: 'BigLebowski: Bazen iğrenç insanlar çıkıyor karşıma. Iyyh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646160
    m_Localized: 'BigLebowski: Bir yamuğunu görürsem ağzına yapıştırırım yani, eline ayağına hâkim ol!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646161
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646162
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646163
    m_Localized: 'BigLebowski: Ne bileyim? Evdelerdir herhâlde. Başka nerede olacaklar ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646164
    m_Localized: 'BigLebowski: Ziyaretçi''ye dönüşmüş de olabilirler. Onlara yakışır zaten, heh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646165
    m_Localized: 'BigLebowski: Annem güneşlenmeyi severdi, belki onunla meşguldür.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633024
    m_Localized: 'BigLebowski: Neyse, önemli olan benim burada olmam. Başımı sokacak bir yer arıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633025
    m_Localized: 'BigLebowski: Zavallı bir çocuğu dışarıda yalnız mı bırakacaksın? Patlayan güneşin altında? Etraf Ziyaretçi kaynıyorken?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646166
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646167
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646168
    m_Localized: 'BigLebowski: Harbi mi? Ohaaaa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646169
    m_Localized: 'BigLebowski: Halı bile var lan! Çok iyiymiş...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646170
    m_Localized: 'BigLebowski: Ama... Neyse ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646171
    m_Localized: 'BigLebowski: Bana ne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646172
    m_Localized: 'BigLebowski: Zaten sen kesin sapıksındır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646173
    m_Localized: 'BigLebowski: Çekemiyorsan anten tak!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646174
    m_Localized: 'Luka: Selamlar, selamlar! Kapının arkasından ayak seslerini duyuyorum!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646175
    m_Localized: 'Luka: Bu gece burada kalabilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646176
    m_Localized: Neden bu kadar keyfin yerinde?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646177
    m_Localized: Senin suratına ne oldu böyle?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646178
    m_Localized: 'Luka: Dışarıda yeterince öfkeli insan var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646179
    m_Localized: 'Luka: Yani evet, zor bir dönemden geçiyoruz ama uğruna mücadele verecek çok şey var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646180
    m_Localized: 'Luka: Önümüzdeki nesiller, sanat, yaşamın keyfi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646181
    m_Localized: 'Luka: Her şeyin düzeleceğine kendimizi ikna edebilirsek belki işimiz kolaylaşır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646182
    m_Localized: Sevinecek ne var ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646183
    m_Localized: Milleti kandıralım mı yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646184
    m_Localized: 'Luka: Ne olmuş ki? Bence gayet normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646185
    m_Localized: 'Luka: Neden gülümsediğimi mi soruyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646186
    m_Localized: 'Luka: Evet, ben de bir süredir gülen yüz görmüyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646187
    m_Localized: 'Luka: İnsanlar o kadar korkuyor ki neşenin anlamını unuttular.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646188
    m_Localized: 'Luka: Çektiğimiz acı yüzünden dünyanın güzelliklerini göremez olduk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646189
    m_Localized: Sevinecek ne var ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646190
    m_Localized: Milleti kandıralım mı yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646191
    m_Localized: 'Luka: Çok şey var ama seni neyin sevindireceğini ben bilemem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646192
    m_Localized: 'Luka: Bütün bunlar başlamadan önce seni neler mutlu ederdi mesela?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646193
    m_Localized: 'Luka: Seni neşelendiren şeyleri hatırlamaya çalış.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646194
    m_Localized: 'Luka: Kendi hüznümüzün içinde boğulma lüksümüz yok. Hele ki şu sıralar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646195
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646196
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646197
    m_Localized: 'Luka: Niye kandırmış oluyoruz ki? İnsanlar ızdırabın içinde boğuluyor, haksız da değiller.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646198
    m_Localized: 'Luka: Fakat bazen onlara eskiden neden mutlu olduklarını hatırlatırsan...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646199
    m_Localized: 'Luka: Tek amaçları hayatta kalmak değil de, güzel bir esere imza atmakken yani...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646200
    m_Localized: 'Luka: Anlatabildim mi? İnsanlar bunun değerini unuttu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646201
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646202
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646203
    m_Localized: 'Luka: Umarım neşeli hissetmenin nasıl bir şey olduğunu hatırlarsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646204
    m_Localized: 'Luka: Belki de o zaman düşündüğün tek şey ölüm olmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646205
    m_Localized: 'Luka: Yas tutacağım diye kendini boğma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646206
    m_Localized: 'Luka: Buna fazla odaklanırsan seni canlı canlı yer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646207
    m_Localized: 'Luka: O noktaya ulaştın mı, geri dönüşü yoktur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646208
    m_Localized: 'Luka: Kendine iyi bak, tamam mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840384
    m_Localized: 'Gasmask: İyi akşamlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840385
    m_Localized: 'Gasmask: FEMA''dan geliyorum. Mahallenizde rutin teftiş gerçekleştiriyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840386
    m_Localized: 'Gasmask: Endişelenmeyin, uzun sürmeyecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840387
    m_Localized: Son götürdüğünüzü ne zaman geri getireceksiniz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840388
    m_Localized: Son teftiş ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840389
    m_Localized: 'Gasmask: Geri mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840390
    m_Localized: 'Gasmask: Ha, belli ki bizim ekip buraya uğramış.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840391
    m_Localized: 'Gasmask: Muayeneden sonra zorunlu bir karantina süresi var. Bir süre bizimle kalacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840392
    m_Localized: 'Gasmask: Sonra karantina bölgesinden geri gönderilecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840393
    m_Localized: Peki, madem başka bir seçenek yok
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840394
    m_Localized: Bu testlerle ilgilenmiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840395
    m_Localized: 'Gasmask: Yeterli sonuç elde edemedik.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840396
    m_Localized: 'Gasmask: Güneşin etkilerini daha yakından anlayabilmek için hanenizin bir sakinini daha almamız gerekiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840397
    m_Localized: Peki, madem başka bir seçenek yok
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840398
    m_Localized: Bu testlerle ilgilenmiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840399
    m_Localized: 'Gasmask: Merak etmeyin. Zorlu bir süreç, evet ama onlara istirahat edecek vakit de tanıyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840400
    m_Localized: 'Gasmask: Testler tamamlandıktan sonra ne yapacağınızı size aktaracağız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840401
    m_Localized: 'Gasmask: Sanırım bir yanlış anlaşılma olmuş.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840402
    m_Localized: 'Gasmask: Kararı size bırakmıyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840403
    m_Localized: 'Gasmask: Öyle ya da böyle birini alıp götüreceğiz. Ne kadar erken bize yardımcı olursanız işimiz o kadar erken biter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840404
    m_Localized: 'Gasmask: Merhaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840405
    m_Localized: 'Gasmask: Sizden daha fazla denek almamız gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840406
    m_Localized: 'Gasmask: Ne kadar erken alırsak o kadar iyi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840407
    m_Localized: Şehirde neler oluyor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840408
    m_Localized: Önce aldıklarınızı bir getirin!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840409
    m_Localized: 'Gasmask: Yapılanların sonuçları.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840410
    m_Localized: 'Gasmask: Direnmeye devam ederseniz daha fazla salgını bu şekilde kontrol altına almamız gerekecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840411
    m_Localized: 'Gasmask: Ziyaretçileri gizlerseniz çoğalırlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840412
    m_Localized: 'Gasmask: Bunun sonucunda da daha fazla şiddet doğar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840413
    m_Localized: Bu daha ne kadar devam edecek?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840414
    m_Localized: Ziyaretçilerin icabına ne zaman bakacaksınız?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840415
    m_Localized: 'Gasmask: Herhangi bir şey talep edecek konumda değilsiniz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840416
    m_Localized: 'Gasmask: Durmadan bize engel olmaya çalışıyorsunuz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840417
    m_Localized: 'Gasmask: Sonumuz ne oldu gördünüz. Geçenlerde bir Ziyaretçi kolonisini ortadan kaldırmak zorunda kaldık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840418
    m_Localized: 'Gasmask: Eskiden memleketimdi orası...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840419
    m_Localized: Bu daha ne kadar devam edecek?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840420
    m_Localized: Ziyaretçilerin icabına ne zaman bakacaksınız?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840421
    m_Localized: 'Gasmask: Bu yaşananların sebebini hâlâ çözmeye çalışıyoruz. Bize engel olmayın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840422
    m_Localized: 'Gasmask: İşler ne zaman normale dönecek bilemiyoruz. Daha fazla test gerçekleştirip kontrolü ele almamız gerekiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840423
    m_Localized: 'Gasmask: Bize yardımcı olursanız her şey en kısa sürede çözülecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840424
    m_Localized: Ee, şimdi ne yapacağız?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840425
    m_Localized: Yine birini mi teslim etmem gerekiyor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840426
    m_Localized: 'Gasmask: Bu kadar basit olsaydı FEMA''ya ihtiyaç olmazdı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840427
    m_Localized: 'Gasmask: Bırakın biz işimizi yapalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840428
    m_Localized: 'Gasmask: Her şey kontrol altında.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840429
    m_Localized: Ee, şimdi ne yapacağız?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840430
    m_Localized: Yine birini mi teslim etmem gerekiyor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840431
    m_Localized: 'Gasmask: Bize insan gerekli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840432
    m_Localized: 'Gasmask: İki kişi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840433
    m_Localized: 'Gasmask: Bu, süreci hızlandıracak. En iyisi bu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840434
    m_Localized: İyi, yardımcı olacaksa...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840435
    m_Localized: Hayır, bu kadar yeter
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840436
    m_Localized: 'Gasmask: Evet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840437
    m_Localized: 'Gasmask: Ancak bu sefer iki kişi istiyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840438
    m_Localized: 'Gasmask: Kim olduğu önemli değil. Ev sakinlerinin ikisini bize teslim edin. Derhâl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840439
    m_Localized: 'Gasmask: Her şey yakında normale dönecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840440
    m_Localized: İyi, yardımcı olacaksa...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840441
    m_Localized: Hayır, bu kadar yeter
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840442
    m_Localized: 'Gasmask: Unutmayın, biz herkesin iyiliğini istiyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840443
    m_Localized: 'Gasmask: Anlayış gösterdiğiniz için teşekkürler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840444
    m_Localized: 'Gasmask: Göz açıp kapayıncaya kadar bu ikisini geri getireceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840445
    m_Localized: 'Gasmask: Ziyaretçilerin de icabına bakacağız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840446
    m_Localized: 'Gasmask: Hay sikeceğim artık...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840447
    m_Localized: 'Gasmask: İyi, öyle olsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840448
    m_Localized: 'Gasmask: Arkamdaki manzarayı görüyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840449
    m_Localized: 'Gasmask: Senin gibi inatçı dallamalar yüzünden böyle oluyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840450
    m_Localized: 'Gasmask: Böyle bize karşı çıkmaya devam ederseniz yine aynısı olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840451
    m_Localized: 'Gasmask: Biz bu şehri korumak istiyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840452
    m_Localized: 'Gasmask: Sizden tek istediğimiz bize insan vermeniz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840453
    m_Localized: 'Gasmask: Yakında geri getireceğiz. Teşekkürler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840454
    m_Localized: 'Gasmask: Bize daha fazla insan gerekli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840455
    m_Localized: 'Gasmask: Felaketi engellemenin tek yolu bu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840456
    m_Localized: Götürdükleriniz nerede ulan?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840457
    m_Localized: Ne felaketi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840458
    m_Localized: 'Gasmask: YETER ULAN, YETER!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840459
    m_Localized: 'Gasmask: DÜNYANIN SONU GELDİ GELECEK.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840460
    m_Localized: 'Gasmask: Böyle artistlik yapmaya devam edersen evdeki herkesi alır götürürüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840461
    m_Localized: Tüm bunları çözmek için ne yapmamız gerekiyor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840462
    m_Localized: Yaptığınız hiçbir bok işe yaramıyor, niye hâlâ kapatmadılar ki sizi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840463
    m_Localized: 'Gasmask: Muazzam bir felaket.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840464
    m_Localized: 'Gasmask: Yetkililer, salgının önüne geçemiyor. Şehri patlatmaya hazırlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840465
    m_Localized: 'Gasmask: Verdikleri emirlere uymamızın imkânı yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840466
    m_Localized: 'Gasmask: Nasıl hayatta kalacağımızı çözemezsek başkası bizim yerimize karar verecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840467
    m_Localized: Tüm bunları çözmek için ne yapmamız gerekiyor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840468
    m_Localized: Yaptığınız hiçbir bok işe yaramıyor, niye hâlâ kapatmadılar ki sizi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840469
    m_Localized: 'Gasmask: İki kişi daha almamız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840470
    m_Localized: 'Gasmask: Herkesi alıp götürmeyeceğiz. Sadece ikisini.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840471
    m_Localized: 'Gasmask: Sonra ya bu Ziyaretçileri ortadan kaldırmanın bir yolunu bulacağız ya da bir daha asla görüşmeyeceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840472
    m_Localized: İyi. Bir daha asla sizi görmek istemiyorum zaten
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840473
    m_Localized: Başka kimseyi vermeyeceğim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840474
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840475
    m_Localized: 'Gasmask: Sabrım tükendi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840476
    m_Localized: 'Gasmask: Hiç tartışmaya girmeyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840477
    m_Localized: 'Gasmask: Ya biz kapıyı kırıp bu bok çukurunda yaşayan kim varsa alıp götüreceğiz ya da bize iki kişiyi teslim edeceksin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840478
    m_Localized: 'Gasmask: Bize karşı çıkan ilk kişi sen değilsin. Onların icabına baktık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840479
    m_Localized: 'Gasmask: Senin de bakarız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840480
    m_Localized: İyi. Bir daha asla sizi görmek istemiyorum zaten
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840481
    m_Localized: Başka kimseyi vermeyeceğim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840482
    m_Localized: 'Gasmask: Bilmukabele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840483
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840484
    m_Localized: 'Gasmask: Bu kadardı. Geceniz güzel geçsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840485
    m_Localized: 'Gasmask: Mala anlatır gibi... Bak, bize yardımcı olmazsan neler yaşanacağını tek tek anlatacağım şimdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840486
    m_Localized: 'Gasmask: Kapını kıracağız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840487
    m_Localized: 'Gasmask: Herkesi alıp götüreceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840488
    m_Localized: 'Gasmask: Seni de yalnız başına burada bırakacağız ve gebereceksin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840489
    m_Localized: 'Gasmask: İki kişiyi teslim et. DERHÂL.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840490
    m_Localized: 'Gasmask: Sonra yolumuza devam edeceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840491
    m_Localized: 'Prophet: Şahane. Kedi de burada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840492
    m_Localized: 'Prophet: Onu sana getirene ne yapacağın... sana kalmış.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840493
    m_Localized: Kediyi nereden bildin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840494
    m_Localized: Neden kediyle kapıma geleni evime almamı istedin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840495
    m_Localized: 'Prophet: Diğer insanlardan daha ileri görüşlüyüm. Yaradılışımdan gelen bir armağan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840496
    m_Localized: 'Prophet: Her şeyi bilemiyorum ama seni... Yolun ilerisinde seni neyin beklediğini biliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840497
    m_Localized: 'Prophet: Korkunç bir şeyle yüzleşeceksin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840498
    m_Localized: 'Prophet: Sebebi sen olmayacaksın ama ondan kaçamayacaksın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840499
    m_Localized: 'Prophet: Belki radyoda söylerler. Peki, sen buna kulak verecek misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840500
    m_Localized: Bu bilgiyi nasıl kullanacağım ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840501
    m_Localized: Ne olacak?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840502
    m_Localized: 'Prophet: Kudretli bir varlık, kedinin gelmesini bekliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840503
    m_Localized: 'Prophet: O''nun sayesinde ileriyi görebiliyorum ama her şeyi göremiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840504
    m_Localized: 'Prophet: Ancak bir şey ortada: Korkunç bir şey buraya doğru yaklaşıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840505
    m_Localized: 'Prophet: Ona engel olamazsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840506
    m_Localized: 'Prophet: Belki radyoda söylerler. Peki, sen buna kulak verecek misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840507
    m_Localized: Bu bilgiyi nasıl kullanacağım ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840508
    m_Localized: Ne olacak?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840509
    m_Localized: 'Prophet: Kullanmayacaksın. Zaten gereğinden fazla konuştum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840510
    m_Localized: 'Prophet: Ancak önümüzdeki iki gün boyunca... test yapmak hayra alamet olmayacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840511
    m_Localized: 'Prophet: Üçüncü gün doğumuna dek tetkiklerine ara ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840512
    m_Localized: 'Prophet: Bunu başarabilirsen sana yol göstermeye devam edeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840513
    m_Localized: 'Prophet: Belki bu sana huzur getirir. Ya da en azından geçmişi geçmişte bırakmanı kolaylaştırır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840514
    m_Localized: 'Prophet: Umarım yakında görüşürüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840515
    m_Localized: 'Prophet: Daha fazlasını söyleyemem. Zaten gereğinden fazla konuştum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840516
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840517
    m_Localized: 'Prophet: İstersen bunu tavsiye olarak görebilirsin ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840518
    m_Localized: 'Prophet: Önümüzdeki iki gün boyunca... test yapmak hayra alamet olmayacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840519
    m_Localized: 'Prophet: Buraya ilk geldiğimde... içime garip bir his doğmuştu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840520
    m_Localized: 'Prophet: O his yavaştan azaldı. Sanırım doğru yoldayız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840521
    m_Localized: 'Prophet: Umarım yakında tekrar görüşürüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840522
    m_Localized: 'Prophet: Hâlâ oradasın, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840523
    m_Localized: 'Prophet: İçimdeki his kötüye gidiyor. Enteresan...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840524
    m_Localized: 'Prophet: Tüm bu yıkım yüzünden mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840525
    m_Localized: Yardım mı lazım?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840526
    m_Localized: Kendi kendine mi konuşuyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840527
    m_Localized: 'Prophet: Alacağım yardımı aldım zaten. Tek sıkıntı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840528
    m_Localized: 'Prophet: Zayıfladığımı hissediyorum. Eskisi kadar ileriyi göremiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840529
    m_Localized: 'Prophet: Senin yüzünden değildir muhtemelen veya O''nun...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840530
    m_Localized: 'Prophet: İlk başta da böyle olmuştu. Sorun değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840531
    m_Localized: 'Prophet: Yeni yetişen saplar küllerin arasından geçecek ve göklere ulaşacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840532
    m_Localized: Ne dediğini hiç anlamıyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840533
    m_Localized: Sana güvendiğim için pişman olmaya başladım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840534
    m_Localized: 'Prophet: Hayır, kesinlikle hayır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840535
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840536
    m_Localized: 'Prophet: Hepimizden kudretli bir varlık var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840537
    m_Localized: 'Prophet: Ancak ondan korkmana gerek yok. Bihaberiz, o kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840538
    m_Localized: 'Prophet: Çağırırsan yardımına koşar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840539
    m_Localized: 'Prophet: Ancak şu an... bir yanlışlık var. Yoksa... Mantar adam mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840540
    m_Localized: Ne dediğini hiç anlamıyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840541
    m_Localized: Sana güvendiğim için pişman olmaya başladım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840542
    m_Localized: 'Prophet: Aman... Seni korkutmak istemedim. Sesli düşünüyordum sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840543
    m_Localized: 'Prophet: Sana gelmeden önce her şey çok berraktı. Şimdi her şey sislerin ardında...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840544
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840545
    m_Localized: 'Prophet: Bodrumun var, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840546
    m_Localized: 'Prophet: Toprağın altında bir şey var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840547
    m_Localized: 'Prophet: Ancak tam olarak ne olduğunu göremiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840548
    m_Localized: Ona ihtiyacım mı var?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840549
    m_Localized: Orada bir şey olduğundan emin misin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840550
    m_Localized: 'Prophet: Anlattıklarım kulağa delilik gibi geliyor olabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840551
    m_Localized: 'Prophet: Buluşmamızın bir sebebi vardı. Bunu gayet iyi hatırlıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840552
    m_Localized: 'Prophet: Ancak şu an... önümü göremiyorum. Seni karanlık bir ormanda kaybolmuş görüyorum. Etrafın canavarlarla kaplı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840553
    m_Localized: 'Prophet: Sırada ne olduğunu görebiliyorum... Bodrum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840554
    m_Localized: 'Prophet: Toprağın altında gömülü bir şey var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840555
    m_Localized: 'Prophet: Onu bulman gerekiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840556
    m_Localized: Ona ihtiyacım mı var?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840557
    m_Localized: Orada bir şey olduğundan emin misin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840558
    m_Localized: 'Prophet: Aman... Düzgün düşünemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840559
    m_Localized: 'Prophet: Ancak toprakta... bir şey daha görüyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840560
    m_Localized: 'Prophet: Henüz atlama. Daha değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840561
    m_Localized: 'Prophet: Dinlenmem gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840562
    m_Localized: 'Prophet: Hatırladığım kadarıyla... yapmam gereken buydu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840563
    m_Localized: 'Prophet: Bunu yapmam gerekiyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840564
    m_Localized: 'Prophet: Sen de...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840565
    m_Localized: 'Prophet: Unutma, atlamak işine yaramaz. Henüz değil...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840566
    m_Localized: 'Prophet: Biraz yalnız kalıp düşünmem gerekiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840567
    m_Localized: 'Prophet: Yüzünü unuttum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840568
    m_Localized: 'Prophet: Görüşümü kaybediyorum. Artık neredeyse hiçbir şey göremiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840569
    m_Localized: 'Prophet: Yoksa beni terk mi etti O?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840570
    m_Localized: Kapının önünde ölme de
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840571
    m_Localized: Pek iyi görünmüyorsun
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840572
    m_Localized: 'Prophet: Artık çok geç.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840573
    m_Localized: 'Prophet: Görüler beni terk etti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034688
    m_Localized: 'Prophet: Ne olduğunu biliyorum. Vakti çoktan gelen bir şey oluyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034689
    m_Localized: 'Prophet: Ben... Beni yalnız bırak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034690
    m_Localized: Kimi diyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034691
    m_Localized: Sen ölüyor musun şu an?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034692
    m_Localized: 'Prophet: Bunca süredir beni O ayakta tutuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034693
    m_Localized: 'Prophet: Ne oldu şimdi? Hepsini geri mi alacak?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034694
    m_Localized: 'Prophet: Ne anlamı vardı ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034695
    m_Localized: Kimi diyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034696
    m_Localized: Sen ölüyor musun şu an?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034697
    m_Localized: 'Prophet: Artık hatırlamıyorum bile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034698
    m_Localized: 'Prophet: Aklımdan tek bir kelime geçiyor... Atla. Atla. Atla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034699
    m_Localized: 'Prophet: Bu mesaj benim için mi... yoksa senin mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034700
    m_Localized: 'Prophet: Bilmiyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034701
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034702
    m_Localized: 'Prophet: Yine falıma bakar mısın lütfen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034703
    m_Localized: 'Prophet: Belki yardımcı olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034704
    m_Localized: Sonlardan bir sayfa aç
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034705
    m_Localized: İki yüzüncü sayfanın ortasını oku
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034706
    m_Localized: Onuncu sayfaya bak
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034707
    m_Localized: 'Prophet: Garip bir soru. Artık hiçbir şey anlamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034708
    m_Localized: 'Prophet: Eskiden anlıyordum... Yani, sanırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034709
    m_Localized: 'Prophet: Aklımda yalnızca tek bir kelime var: "Atla". Ne anlama geliyor olabilir ki bu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034710
    m_Localized: 'Prophet: Bu sana gönderilen bir mesaj mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034711
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034712
    m_Localized: 'Prophet: Bu kitaptan geleceğimi tahmin etmeni istemiştim, hatırlıyor musun? Bir daha yapar mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034713
    m_Localized: 'Prophet: Korkuyorum. Belki bir yardımı dokunur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034714
    m_Localized: Sonlardan bir sayfa aç
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034715
    m_Localized: İki yüzüncü sayfanın ortasını oku
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034716
    m_Localized: Onuncu sayfaya bak
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034717
    m_Localized: 'Prophet: "Uzun süredir istikameti hiçbir yer olan bir trende yolcuyuz fakat altındaki raylar kükremeye devam ediyor."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034718
    m_Localized: 'Prophet: Şimdi anladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034719
    m_Localized: 'Prophet: Aman... Bir şey aklıma geldi. Teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034720
    m_Localized: 'Prophet: Ben gideyim artık. Elveda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034721
    m_Localized: 'Prophet: "İki diyar arasında bir tezahürat duyuluyor: ''Ateşte benimle yürü''."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034722
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034723
    m_Localized: 'Prophet: Yazık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034724
    m_Localized: 'Prophet: Teşekkür ederim ama pek bir işe yaramadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034725
    m_Localized: 'Prophet: Elveda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034726
    m_Localized: 'Prophet: "Gençlerimiz, Rouen''ın odun yığınları gibi feryat etti."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034727
    m_Localized: 'Prophet: Okumaya devam edecek gücüm yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034728
    m_Localized: 'Prophet: Artık gitmem gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034729
    m_Localized: 'Prophet: Elveda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034730
    m_Localized: 'Hunter: Nasılsın delikanlı? Sizin buralarda ortalık ne âlemde?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034731
    m_Localized: 'Hunter: Ben buralı değilim. Yerleşik hayatı pek sevmem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034732
    m_Localized: 'Hunter: Fakat artık eskisi gibi rahat rahat gezemiyorum. Yaşlılık böyle bir şey işte delikanlı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034733
    m_Localized: Neden yoldasın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034734
    m_Localized: Burada ne arıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034735
    m_Localized: 'Hunter: Bu Ziyaretçileri görmedin mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034736
    m_Localized: 'Hunter: Evleri teker teker dolaşıp milleti gebertiyorlar, parça pinçik ediyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034737
    m_Localized: 'Hunter: Bizden biri gibi davranıp evlerimize sızıyorlar... Sonra ortalığı kan götürüyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034738
    m_Localized: 'Hunter: Bu hergelelerin hepsini tek tek öldürmemiz lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034739
    m_Localized: Ziyaretçileri avlamak mı istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034740
    m_Localized: Silahın nerede öyleyse?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034741
    m_Localized: 'Hunter: Şehirde mi? İstirahat edecek bir yer bakıyorum evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034742
    m_Localized: 'Hunter: Bu güneş mevzusu başlayalı sağdan soldan fırlamaya başladılar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034743
    m_Localized: 'Hunter: Bunlar bir halt çeviriyor evlat, ben diyeyim sana. Bunların icabına bakılması gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034744
    m_Localized: Ziyaretçileri avlamak mı istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034745
    m_Localized: Silahın nerede öyleyse?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034746
    m_Localized: 'Hunter: Sen ne istiyorsun ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034747
    m_Localized: 'Hunter: Tipinden belli evlat, sen salak değilsin. Ben bunları kışkışlamakla yetinmem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034748
    m_Localized: 'Hunter: Bir tanesini bile saldın mı, hemen geri gelip boğazını keser bunlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034749
    m_Localized: 'Hunter: Bu kurnazlara merhamet edilmez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034750
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034751
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034752
    m_Localized: 'Hunter: Bir tüfeğim vardı ama onun yüzünden ölüyordum neredeyse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034753
    m_Localized: 'Hunter: Ben sızana kadar beklediler, sonra uyurken arakladılar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034754
    m_Localized: 'Hunter: Koşarak kaçtım, arkamdan ateş ettiler. Bu hergelelerin eğlence anlayışı bu işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034755
    m_Localized: 'Hunter: Görünüşleri dışında hiçbir insan özellikleri yok bunların evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034756
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034757
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034758
    m_Localized: 'Hunter: Senin adam gibi adam olduğunu tahmin etmiştim. Helal sana evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034759
    m_Localized: 'Hunter: Hepsini tek tek indireceğiz. Hergelelerin buraya yaklaşmasına bile izin vermeyeceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034760
    m_Localized: 'Hunter: Daha iyi oldu. Belki sen de onlardan birisindir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034761
    m_Localized: 'Hunter: Şafak sökmeden boğazımı kesebilirdin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034762
    m_Localized: 'Hunter: Sana yemin ediyorum, bir tane bile hergeleyi canlı bırakmayacağım. İzle ve gör evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034763
    m_Localized: 'Cold: M... Merhaba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034764
    m_Localized: 'Cold: Sıcak beni r-rahatsız etmiyor. Sadece dinlenecek sakin bir yer arıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034765
    m_Localized: 'Cold: Acaba bu evde h-huzur bulabilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034766
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034767
    m_Localized: Ne kadar zamandır arıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034768
    m_Localized: 'Cold: A-artık bir önemi yok. Yoksa Ziyaretçi olduğumu mu sandın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034769
    m_Localized: 'Cold: D-değilim ama bir ricam var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034770
    m_Localized: 'Cold: Sonra söylerim. Henüz bu konuda sana güvenebilir miyim, e-emin değilim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034771
    m_Localized: Sıcak seni rahatsız etmiyor mu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034772
    m_Localized: Montunu çıkar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034773
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034774
    m_Localized: 'Cold: Hiç huzur bulamadım b... ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034775
    m_Localized: 'Cold: Yani çok uzun s... süredir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034776
    m_Localized: Sıcak seni rahatsız etmiyor mu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034777
    m_Localized: Montunu çıkar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034778
    m_Localized: 'Cold: Ben hep ü... üşürüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034779
    m_Localized: 'Cold: Diğerleri güneşte y... yanıyor. Ben kat kat giyinmeme rağmen d-donacak gibiyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034780
    m_Localized: 'Cold: Çıkarmaktan k... korkuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034781
    m_Localized: 'Cold: Ya daha kötü olursam? Ya ö... öldüğümde bile acı dinmezse?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034782
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034783
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034784
    m_Localized: 'Cold: Olmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034785
    m_Localized: 'Cold: Beni içeri almak zorunda değilsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034786
    m_Localized: 'Cold: Giderim. Yalvarmam. Seni bir daha r... rahatsız etmem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034787
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034788
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034789
    m_Localized: 'Cold: T-teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034790
    m_Localized: 'Cold: Tavan biraz a... alçak ama sorun değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034791
    m_Localized: 'Cold: Anladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034792
    m_Localized: 'Cold: Öyleyse elveda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034793
    m_Localized: 'Cold: Ellerindeki barut lekelerini g... görebiliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034794
    m_Localized: 'Cold: Beni v... vurur musun acaba?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034795
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034796
    m_Localized: 'Cold: Tabii, muhtemelen mermilerini h... harcamak istemiyorsundur. Elveda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228992
    m_Localized: 'Greatmother: Merhabalar!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228993
    m_Localized: 'Greatmother: Evde misin kuzum?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228994
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228995
    m_Localized: Birini mi arıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228996
    m_Localized: 'Greatmother: Çocuklarımla iki sokak aşağıda oturuyorduk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228997
    m_Localized: 'Greatmother: Sarılı herifler bizi binadan kovuverdi, kalacak bir yer de bulamadık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228998
    m_Localized: 'Greatmother: Ne sığınak verdiler bize ne yardım ettiler. Ne halt yiyeceğiz ki biz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228999
    m_Localized: 'Greatmother: Millet de dağıldı tabii. Ben de gebermemek için buraya geldim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229000
    m_Localized: Niye kovdular sizi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229001
    m_Localized: Kaç kişiydiniz ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229002
    m_Localized: 'Greatmother: Birini aradığım yok. Yaslanıp dinlenecek bir yer arıyorum sadece annesinin gülü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229003
    m_Localized: 'Greatmother: Mahalleyi komple alıp götürdüler, kimse nereye gittiklerini bilmiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229004
    m_Localized: 'Greatmother: O günden beridir kaçıyorum, yatacak yer arıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229005
    m_Localized: Niye kovdular sizi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229006
    m_Localized: Kaç kişiydiniz ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229007
    m_Localized: 'Greatmother: Binamız güneşten darbe mi yemişmiş, neymiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229008
    m_Localized: 'Greatmother: Sarılı herifler içeriye dalıp milleti yatağından sürüklediler. Birkaçını alıp götürdüler hatta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229009
    m_Localized: 'Greatmother: Diğerlerine de hiçbir şey olmamış gibi "Hadi yaylanın," dediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229010
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229011
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229012
    m_Localized: 'Greatmother: Tüm bina be!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229013
    m_Localized: 'Greatmother: Kalmak isteyen birkaç kişi oldu ama sarılılar hepsini fırlattı dışarı. Rastgele adam topladı herifler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229014
    m_Localized: 'Greatmother: Yazık, binada oturanların bazılarını alıp götürdüler. Kalanların peşine pek düşmediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229015
    m_Localized: 'Greatmother: Şimdi şu zavallı hâlimle hayatta kalmaya çalışıyorum annesinin gülü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229016
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229017
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229018
    m_Localized: 'Greatmother: Ay, çok makbule geçti. O sarılılar gelirse sakın açma kapını ha, tamam mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229019
    m_Localized: 'Greatmother: Açtın mı hepimizi alıp götürürler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229020
    m_Localized: 'Greatmother: İyi, öyle olsun. Sen yine de o sarılılara kapını açma da.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229021
    m_Localized: 'Greatmother: Hatta hiç açma, daha iyi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229022
    m_Localized: 'Greatmother: HAHAHAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229023
    m_Localized: 'Greatmother: Evlatlarımı buraya getireceğim. Koca Ana yalnız ölmene izin vermez, sen hiç meraklanma. HAHAHAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229024
    m_Localized: 'SuperFake: Hâlâ burada saklanıyorsun bakıyorum?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229025
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229026
    m_Localized: 'SuperFake: O adam hakkında ne düşündün? Sarı tulumlu olan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229027
    m_Localized: İşini yapıyor sadece
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229028
    m_Localized: Ne düşündüğümden emin değilim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229029
    m_Localized: 'SuperFake: Zor dönemlerden geçiyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229030
    m_Localized: 'SuperFake: Her şey üst üste geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229031
    m_Localized: 'SuperFake: Belki o sarı tulumlular düzeni sağlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229032
    m_Localized: 'SuperFake: Belki de dizginleri ele almamızın vakti gelmiştir, ne dersin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229033
    m_Localized: Ben bir şey yapamam ki
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229034
    m_Localized: Elimden geleni yapıyorum zaten
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229035
    m_Localized: 'SuperFake: Niye düşünesin ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229036
    m_Localized: 'SuperFake: Tüm kararlar bizim yerimize verildi zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229037
    m_Localized: 'SuperFake: Aslında büyük iyilik değil mi bu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229038
    m_Localized: 'SuperFake: Yoksa her şeyi kendin mi düzeltmek istiyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229039
    m_Localized: Ben bir şey yapamam ki
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229040
    m_Localized: Elimden geleni yapıyorum zaten
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229041
    m_Localized: 'SuperFake: Evet, farkındayım!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229042
    m_Localized: 'SuperFake: Tek başına felakete nasıl karşı koyabilirsin ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229043
    m_Localized: 'SuperFake: Kozmik Facia''ya karşı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229044
    m_Localized: 'SuperFake: Ölüm''e karşı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229045
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229046
    m_Localized: 'SuperFake: Pekiiiii...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229047
    m_Localized: 'SuperFake: Yalnız mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229048
    m_Localized: Yalnızım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229049
    m_Localized: Yalnız değilim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229050
    m_Localized: 'SuperFake: Peki neler yapabilirsin tam olarak?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229051
    m_Localized: 'SuperFake: Ölümü defedebilir misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423296
    m_Localized: 'SuperFake: Selleri, yangınları, çürümeyi durdurabilir misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423297
    m_Localized: 'SuperFake: Senin durdurabileceğin tek şey, atan bir kalp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423298
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423299
    m_Localized: 'SuperFake: Pekiiiii...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423300
    m_Localized: 'SuperFake: Yalnız mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423301
    m_Localized: Yalnızım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423302
    m_Localized: Yalnız değilim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423303
    m_Localized: 'SuperFake: Demek yapayalnız kaldın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423304
    m_Localized: 'SuperFake: Kimseyle iyi anlaşamadın mı? Yazık...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423305
    m_Localized: 'SuperFake: Şöyle hemencecik bir içeri dalacağım o zaman. Sana bir veda hediyesi vereceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423306
    m_Localized: 'SuperFake: Demek hâlâ hayatta kalmak için direniyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423307
    m_Localized: 'SuperFake: Niye ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423308
    m_Localized: 'SuperFake: Artık dünyayı köpekler yönetiyor. Yalnızca köpekler hayatta kalıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423309
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423310
    m_Localized: 'SuperFake: Ne dediğimi anladın, değil mi? Artık hiçbir şey eskisi gibi olmayacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423311
    m_Localized: 'SuperFake: Hayat değişti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423312
    m_Localized: 'SuperFake: Tempoyu yakalayamıyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423313
    m_Localized: 'SuperFake: Bir sonraki karşılaşmamız... enteresan olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423314
    m_Localized: 'SuperFake: Hissedebiliyor musuuuuunn?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423315
    m_Localized: 'SuperFake: Değişim kapına dadandı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423316
    m_Localized: 'SuperFake: Tıpkı benim gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423317
    m_Localized: 'SuperFake: Şimdi dostlarından biri ölümsüz oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423318
    m_Localized: 'SuperFake: Tek bir kelime yüzünden. Tek bir kelime... ama nasıl bir kelime!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423319
    m_Localized: 'SuperFake: Kimden bahsettiğimi anladın, değil miii?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423320
    m_Localized: 'SuperFake: Etrafında tuhaf şeyler yaşanıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423321
    m_Localized: Hiçbir şey hissetmiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423322
    m_Localized: Umurumda değil
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423323
    m_Localized: 'SuperFake: Zor olsa gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423324
    m_Localized: 'SuperFake: Yardıma ihtiyacın var belli ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423325
    m_Localized: 'SuperFake: Yeni bir şey deneyelim mi? Kumar gibi düşün.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423326
    m_Localized: 'SuperFake: Evinde BİZDEN en az iki kişi varsa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423327
    m_Localized: 'SuperFake: Bana kapıyı açacaksın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423328
    m_Localized: 'SuperFake: Artık onların bedeninde köpekler yaşıyor çünkü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423329
    m_Localized: Anlamadım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423330
    m_Localized: Sonra gelsen olur mu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423331
    m_Localized: 'SuperFake: Gerçeklik algını yitirdin demek?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423332
    m_Localized: 'SuperFake: Hiç mi umursamıyorsun artık?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423333
    m_Localized: 'SuperFake: Bunu hemen halledelim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423334
    m_Localized: 'SuperFake: Evinde BİZDEN en az iki kişi varsa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423335
    m_Localized: 'SuperFake: Bana kapıyı açacaksın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423336
    m_Localized: Anlamadım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423337
    m_Localized: Sonra gelsen olur mu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423338
    m_Localized: 'SuperFake: Gayet basit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423339
    m_Localized: 'SuperFake: Hadi deneyelim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423340
    m_Localized: 'SuperFake: Ama önce...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423341
    m_Localized: 'SuperFake: Yalnız mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423342
    m_Localized: Yalnızım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423343
    m_Localized: Yalnız değilim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423344
    m_Localized: 'SuperFake: Tüh... Ben gideyim o zaman. Şimdilik.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423345
    m_Localized: 'SuperFake: Ama gitmeden önce o bahsettiğim oyunu deneyelim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423346
    m_Localized: 'SuperFake: Yalnız mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423347
    m_Localized: Yalnızım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423348
    m_Localized: Yalnız değilim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423349
    m_Localized: 'SuperFake: Hım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423350
    m_Localized: 'SuperFake: Evettt... Kumar işime yaradı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423351
    m_Localized: 'SuperFake: Benimle gel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423352
    m_Localized: 'SuperFake: Bak bak...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423353
    m_Localized: 'SuperFake: Artık bizden birini görmek bile zor. Sizi geçtim zaten. Duvarların ardında hapissiniz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423354
    m_Localized: 'SuperFake: Kapına dadanacak en korkunç şey, ölüm değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423355
    m_Localized: 'SuperFake: Sürünün başında benim olduğumu sanmıyorsundur umarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423356
    m_Localized: 'SuperFake: Çok daha büyük güçler var başımızda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423357
    m_Localized: 'SuperFake: Ben sadece emir kuluyum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423358
    m_Localized: 'SuperFake: Peki o zaman...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423359
    m_Localized: 'SuperFake: Görüşmek üzere diyelim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423360
    m_Localized: 'SuperFake: Bana bunun son sohbetimiz olduğunu söylediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423361
    m_Localized: 'SuperFake: Her şeyin sonu geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423362
    m_Localized: 'SuperFake: Suçlusu ya biz olacağız ya siz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423363
    m_Localized: Nasıl yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423364
    m_Localized: Neyin sonu geliyor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423365
    m_Localized: 'SuperFake: Ben sadece bana söyleneni aktarıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423366
    m_Localized: 'SuperFake: Hepsi bu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423367
    m_Localized: 'SuperFake: Hissedebiliyor musun? Ölümün giderek yaklaştığını...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423368
    m_Localized: 'SuperFake: Ensenizde bitti bitecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423369
    m_Localized: Niye buraya uğrayıp duruyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423370
    m_Localized: Kapıyı niye kırmıyorsun ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423371
    m_Localized: 'SuperFake: Onu söyleyemiyoruz maalesef.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423372
    m_Localized: 'SuperFake: SENİN hiçbir şey hissetmemen çok ilginç.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423373
    m_Localized: 'SuperFake: Merak etme, yardımcı olabiliriz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423374
    m_Localized: Niye buraya uğrayıp duruyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423375
    m_Localized: Kapıyı niye kırmıyorsun ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423376
    m_Localized: 'SuperFake: Bunu sormak şimdi mi aklına geldi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423377
    m_Localized: 'SuperFake: Peki... seçilmiş olabileceğin hiç aklına geldi mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423378
    m_Localized: 'SuperFake: Beni yollamalarının bir sebebi var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423379
    m_Localized: 'SuperFake: Bir şeyi değiştirmek için sanırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423380
    m_Localized: 'SuperFake: Ancak neticesi hep aynı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423381
    m_Localized: 'SuperFake: Sen öleceksin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423382
    m_Localized: 'SuperFake: Bugün değilse yarın. Yarın değilse başka bir gün.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423383
    m_Localized: 'SuperFake: Eninde sonunda yok olacaksın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423384
    m_Localized: 'SuperFake: Ama şimdilik...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423385
    m_Localized: 'SuperFake: Evine bizden birini aldın mı hiç?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423386
    m_Localized: 'SuperFake: Yalnız mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423387
    m_Localized: Burada birçok insan var
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423388
    m_Localized: Kimseyi almadım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423389
    m_Localized: Burada... insan olmayan çok kişi var
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423390
    m_Localized: Sadece düzgün insanları evime aldım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423391
    m_Localized: Buraya ait olmayan herkesi ortadan kaldırdım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423392
    m_Localized: Buraya ait olmayan bazılarını ortadan kaldırdım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423393
    m_Localized: 'SuperFake: Bilinmezlik seni korkutuyor mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423394
    m_Localized: 'SuperFake: Hâlâ nasıl hayatta olduğunu sorguluyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423395
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423396
    m_Localized: 'SuperFake: Sen daha çok ölümden sonra ne olduğunu merak ediyor gibisin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423397
    m_Localized: 'SuperFake: Diyelim ki öldün. Sonra ne olacak?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423398
    m_Localized: 'SuperFake: Öyle sonsuza dek yok mu olacaksın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423399
    m_Localized: 'SuperFake: Hiçbir şey hissetmeyecek misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423400
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423401
    m_Localized: 'SuperFake: Ben başka bir şeyi merak ediyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423402
    m_Localized: 'SuperFake: Evine bizden birini aldın mı hiç?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423403
    m_Localized: Burada birçok insan var
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423404
    m_Localized: Kimseyi almadım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423405
    m_Localized: Burada... insan olmayan çok kişi var
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423406
    m_Localized: Sadece düzgün insanları evime aldım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423407
    m_Localized: Buraya ait olmayan herkesi ortadan kaldırdım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423408
    m_Localized: Buraya ait olmayan bazılarını ortadan kaldırdım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423409
    m_Localized: 'SuperFake: Demek hazırsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423410
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423411
    m_Localized: 'SuperFake: Korkuyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423412
    m_Localized: 'SuperFake: Evettt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423413
    m_Localized: 'SuperFake: Hâlâ dizginleri eline alamıyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423414
    m_Localized: 'SuperFake: Bu yüzden buradayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423415
    m_Localized: 'SuperFake: Hep kaçıyorsun, hep. Benim gibilerden, gerçekten...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423416
    m_Localized: 'SuperFake: Niye ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423417
    m_Localized: 'SuperFake: Neye tutunuyorsun hâlâ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423418
    m_Localized: 'SuperFake: HER ŞEY yakında sona erecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423419
    m_Localized: 'SuperFake: Neden direniyorsun ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423420
    m_Localized: 'Wolfhound: La.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423421
    m_Localized: 'Wolfhound: Dünya kafayı yemiş ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423422
    m_Localized: 'Wolfhound: Medeniyet kalmadı kimsede. Mahluklar ortalıkta sürtüyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423423
    m_Localized: 'Wolfhound: İyi oldu. Artık elimizden geleni ardımıza koymayız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423424
    m_Localized: Anlamadım?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423425
    m_Localized: Sen de mi o "mahluklardan" birisin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423426
    m_Localized: 'Wolfhound: Sen diğer evlere baktın mı hiç? Sokağa çıktın mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423427
    m_Localized: 'Wolfhound: Kural mural kalmadı artık baba. Kimsede ahlak yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423428
    m_Localized: 'Wolfhound: Artık her şey basit. Çorba parası istiyorsan adamın boğazını deşeceksin, acımayacaksın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423429
    m_Localized: Sen kaç eve uğradın peki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423430
    m_Localized: Nasıl bu kadar uzun süre hayatta kalabildin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423431
    m_Localized: 'Wolfhound: Hepimiz hayvanız moruk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423432
    m_Localized: 'Wolfhound: Bunu kabullenmezsen adamlar seni canlı canlı yutar. Gözyaşına bile bakmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423433
    m_Localized: 'Wolfhound: Yeni dünya böyle. Güçlü olan kazanır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423434
    m_Localized: 'Wolfhound: Bunu anlamayanı da yerler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423435
    m_Localized: Sen kaç eve uğradın peki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423436
    m_Localized: Nasıl bu kadar uzun süre hayatta kalabildin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423437
    m_Localized: 'Wolfhound: Hiçbirinde uzun süre kalmadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423438
    m_Localized: 'Wolfhound: Her seferinde aynı terane. Millet korkudan büyük resmi göremiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423439
    m_Localized: 'Wolfhound: Ama sen... Sen burada düzeni kurmuşsun baba. Helal olsun. Ben de merak edip geldim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423440
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423441
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423442
    m_Localized: 'Wolfhound: Bak hele, bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423443
    m_Localized: 'Wolfhound: Bazen cehalet mutluluktur baba. Ben sana nasıl hayatta kaldığını sordum mu, ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423444
    m_Localized: 'Wolfhound: Ben senin düzeni bozmam, gerisini hiç kafana takma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423445
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423446
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423447
    m_Localized: 'Wolfhound: Ha şöyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423448
    m_Localized: 'Wolfhound: Artık önemli olan güç baba. Ya buna ayak uydurursun ya da tekmeyi yersin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423449
    m_Localized: 'Wolfhound: Demek öyle olduk ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423450
    m_Localized: 'Wolfhound: Bu iş burada bitmez baba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423451
    m_Localized: 'Doctor: Ha, şey... Evde kimse yok sandım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423452
    m_Localized: 'Doctor: Dışarısı gece vakti çok sessiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423453
    m_Localized: 'Doctor: İyi akşamlar! İçeri gelebilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423454
    m_Localized: Evi mi gözetliyordun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617600
    m_Localized: Bir şey mi istedin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617601
    m_Localized: 'Doctor: Hayır, yok öyle bir şey tabii ki de!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617602
    m_Localized: 'Doctor: Bu kadar dolu bir evin gece vakti böylesine sessiz olması garip sadece, o kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617603
    m_Localized: 'Doctor: En kötü ihtimalle bir bağırış çağırış olur genelde...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617604
    m_Localized: 'Doctor: ...veya bir ağlama...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617605
    m_Localized: 'Doctor: ...veya bir çığlık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617606
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617607
    m_Localized: Nereden geliyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617608
    m_Localized: 'Doctor: Niye sordun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617609
    m_Localized: 'Doctor: Herkesle aynı şeyin peşindeyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617610
    m_Localized: 'Doctor: Güvenlik. Bir de şanslıysam sohbet edecek birisi. Canım çok sıkılıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617611
    m_Localized: 'Doctor: Hiç ses çıkmayınca içeride kimse yok sandım, ben de bir bakayım dedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617612
    m_Localized: 'Doctor: Sonra kapının kilitli olduğunu görünce "Bari kırmaya kalkışmadan önce kapıyı bir çalayım," dedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617613
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617614
    m_Localized: Nereden geliyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617616
    m_Localized: 'Doctor: Cerrahım. Eskiden hastaları ameliyat ederdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617617
    m_Localized: 'Doctor: Çalıştığım kliniğin bütçesi pek yoktu, dolayısıyla alanıma girmeyen hastalara da baktığım oluyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617618
    m_Localized: 'Doctor: Şimdi hastane falan kalmadı. Ben de ortalıkta gezinip elimden geldiğince yardımcı olmaya çalışıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617619
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617620
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668864
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668865
    m_Localized: 'Doctor: Beni içeri alırsan hastanelere ne olduğunu sana anlatırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617621
    m_Localized: 'Doctor: Şehirde bir hastane vardı ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617622
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617623
    m_Localized: 'Doctor: Uzun hikâye.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617624
    m_Localized: 'Doctor: Beni evine davet etme kibarlığını gösterirsen anlatırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617625
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617626
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617627
    m_Localized: 'Doctor: Teşekkür ederim. Umarım birine yardımım dokunur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617628
    m_Localized: 'Doctor: Anlıyorum, insanlara güvenebileceğimiz bir dönemde değiliz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617629
    m_Localized: 'Doctor: Ben yakınlarda olacağım. Yardım istemekten lütfen çekinme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617630
    m_Localized: 'Foreigner: Mmmmmıh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617631
    m_Localized: 'Foreigner: Immmmmmhhh!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617632
    m_Localized: Derdin ne senin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617633
    m_Localized: Ne?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617634
    m_Localized: 'Foreigner: (Adam kaşlarını kaldırıp sana bakıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617635
    m_Localized: 'Foreigner: (Galiba cevap verecek durumda değil)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617636
    m_Localized: Biri ağzını mı dikti senin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617637
    m_Localized: Ne yapabilirim ki ben sana?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617638
    m_Localized: 'Foreigner: (Korku içinde kaşlarını kaldırıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617639
    m_Localized: 'Foreigner: (Yine bir şeyler mırıldanıyor ama ne dediği belli değil)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617640
    m_Localized: Biri ağzını mı dikti senin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617641
    m_Localized: Ne yapabilirim ki ben sana?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617642
    m_Localized: 'Foreigner: (Kollarını sallayarak bir şey mırıldanıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617643
    m_Localized: 'Foreigner: (Emin değilsin ama sanki gözleri yaşlı gibi)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617644
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617645
    m_Localized: Git
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617646
    m_Localized: 'Foreigner: (Orada öyle dikiliyor, delikten sana bakıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617647
    m_Localized: 'Foreigner: (Emin değilsin ama sanki gözleri yaşlı gibi)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617648
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617649
    m_Localized: Git
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617650
    m_Localized: 'Foreigner: (Başıyla onaylayıp içeri giriyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617651
    m_Localized: 'Foreigner: (Orada öyle dikilip mırıldanıyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617652
    m_Localized: Git artık!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617653
    m_Localized: 'Foreigner: (Sen bağırınca irkiliyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617654
    m_Localized: 'Foreigner: (Bir an bekleyip arkasını dönüyor ve gidiyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617655
    m_Localized: 'Edgar: Merhaba. Evin çok hoşmuş.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617656
    m_Localized: 'Edgar: Buralar çok daha sessiz, sakin. Şehirde her şey feryat ediyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617657
    m_Localized: 'Edgar: Zahmet olmazsa burada kalmak isterim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617658
    m_Localized: Niye evde kalmadın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617659
    m_Localized: Neresi hoşmuş bu evin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617660
    m_Localized: 'Edgar: Sahiden kendimi iyi hissetmiyorum. Heyhat, yalnızca kangrenimden bahsetmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617661
    m_Localized: 'Edgar: Gözlerimi açtığım her sabah, bir sonrakini görüp göremeyeceğim korkusuyla güne başlıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617662
    m_Localized: 'Edgar: Benimki gibi talihsiz bir öykü, bir çırpıda tüketilmelidir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617663
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617664
    m_Localized: 'Edgar: Şehrin gürültüsü, ter gibi bana yapışıyor. Kargaşa, münakaşa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617665
    m_Localized: 'Edgar: Hayatta kalmaya çalışan insanlar. Ancak buradakiler, gelecek olanı kabullenmiş bile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617666
    m_Localized: 'Edgar: Burada ölmek isterim. Yavaş yavaş. Sessiz sakin. Son anlarımın tadını çıkarmak isterim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617667
    m_Localized: Nasıl kangren oldun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617668
    m_Localized: Kolunu kesmemiz mi lazım?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617669
    m_Localized: 'Edgar: Sessizlik, boşluk... Burası çok durgun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617670
    m_Localized: 'Edgar: Telaşlı kentin sıcaklığına kapılsam bile tir tir titriyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617671
    m_Localized: 'Edgar: Mahpus bir ateş... Sokaklar, gece vakti serinlemiyor artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617672
    m_Localized: 'Edgar: İki türlü de titremekten kurtulamazdım zaten. Derim çürüyor, anlayacağın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617673
    m_Localized: 'Edgar: Gözlerimi açtığım her sabah, bir sonrakini görüp göremeyeceğim korkusuyla güne başlıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617674
    m_Localized: 'Edgar: Benimki gibi talihsiz bir öykü, bir çırpıda tüketilmelidir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617675
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617676
    m_Localized: 'Edgar: Ben, yaşamın akıma karşı koyduğu bu telaşın bir parçası olamam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617677
    m_Localized: Nasıl kangren oldun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617678
    m_Localized: Kolunu kesmemiz mi lazım?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617679
    m_Localized: 'Edgar: Makul bir soru. Şimdilik sadece şu kadarını anlatabilirim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617680
    m_Localized: 'Edgar: Bir zamanlar hayran kaldığım bir hanımla yaşardım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617681
    m_Localized: 'Edgar: Her geçen gün tedricen değişiyordu. Buna tanıklık etmek şahane bir şeydi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617682
    m_Localized: 'Edgar: Ta ki diğerleri gelene kadar. Gerisini tahmin edebilirsin sanırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617683
    m_Localized: 'Edgar: Şimdi de senin huzurunda duruyorum. Tek başıma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617684
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617685
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617686
    m_Localized: 'Edgar: Septisemiye iyi gelir mi bu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617687
    m_Localized: 'Edgar: Hayır, bu iyiliğe ihtiyacım yok. Nedense... burada kaçınılmazların seve seve kabul edildiğini hissediyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617688
    m_Localized: 'Edgar: Bu yüzden buradayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617689
    m_Localized: 'Edgar: Burada o nihai, bilinmez diyara geçiş yapacak ve onunla birleşeceğiz. Bu süreci zorlaştırma gibi bir niyetim de yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617690
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617691
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617692
    m_Localized: 'Edgar: Burası gerçekten şahit olduğum en sessiz yer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617693
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617694
    m_Localized: 'Edgar: Bu güzelliği sen de benim gibi mi görüyorsun, bilmiyorum. Ama bir sorum var... Cesetleri ulu geceye mi teslim ediyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617695
    m_Localized: 'Edgar: Vakit geldiğinde benimkini muhafaza et.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617696
    m_Localized: 'Edgar: Yakınlarda beklesem rahatsız olur musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617697
    m_Localized: 'Edgar: Ölümün bana sarılmasını bekleyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617698
    m_Localized: 'Edgar: Gölge bir yer bulurum. Ancak tek bir ricam var... Lütfen vakit geldiğinde cesedimi bir kenara atma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617699
    m_Localized: 'TaxiDriver: Selam dayı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617700
    m_Localized: 'TaxiDriver: Başım belaya girdi de... biraz burada saklansam zahmet olur mu sana?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617701
    m_Localized: Ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617702
    m_Localized: Yardım mı lazım?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617703
    m_Localized: 'TaxiDriver: Nereden başlasam... Ben şimdi taksiciyim, tamam mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617704
    m_Localized: 'TaxiDriver: Bi'' gün bir yolcu almıştım, sonra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617705
    m_Localized: 'TaxiDriver: Olan oldu işte. Adamın gerçek kimliği ortaya çıktı falan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617706
    m_Localized: 'TaxiDriver: Şimdi ne o yolcu kaldı ne de benim araç.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617707
    m_Localized: Arabana ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617708
    m_Localized: O yolcuya ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617709
    m_Localized: 'TaxiDriver: Uzun lafın kısası... pert oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617710
    m_Localized: 'TaxiDriver: Dangalak olduğum için kaybettim, diyelim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617711
    m_Localized: 'TaxiDriver: Yanlış anlamayasın ha, salak değilim. Yanlış kişiye güvendim sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617712
    m_Localized: Arabana ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617713
    m_Localized: O yolcuya ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617714
    m_Localized: 'TaxiDriver: FEMA''daki piç kuruları aldı götürdü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617715
    m_Localized: 'TaxiDriver: Bir gün bir yolcu aldıydım, baktım herifin dişleri bembeyaz. Kâğıt gibi ama, öyle böyle değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617716
    m_Localized: 'TaxiDriver: Ben de gizlice herifi FEMA''ya teslim ettim. Tabii, hemen bir çay ikram ettiler ona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617717
    m_Localized: 'TaxiDriver: Başta bana minnettar davrandılar. "Elinize sağlık beyefendi; siz bize yardımcı olun, biz de size!" falan filan... Ama sonra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617718
    m_Localized: 'TaxiDriver: Şerefsizler beni arabadan alıp sürükledi. Meğer beni de içeri alacaklarmış!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617719
    m_Localized: 'TaxiDriver: Neyse ki montumun cebinde bir şişe vardı. Manyağın kafasına geçirip kaçtım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617720
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617721
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617722
    m_Localized: 'TaxiDriver: Paranoyak falan değilimdir ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617723
    m_Localized: 'TaxiDriver: Herif, Ziyaretçi''ydi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617724
    m_Localized: 'TaxiDriver: Dikizden bir baktım, adamın dişler kâğıt gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617725
    m_Localized: 'TaxiDriver: Hiç tereddüt etmedim, hemen FEMA''ya götürdüm lavuğu. Hata etmişim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617726
    m_Localized: 'TaxiDriver: Beni de onunla içeri almak istediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617727
    m_Localized: 'TaxiDriver: Ben de kaçtım. Artık eve de gidemiyorum ki. Kapının arkasında bekliyorlardır kesin beni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617728
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617729
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617730
    m_Localized: 'TaxiDriver: Hof... Sağ olasın dayı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617731
    m_Localized: 'TaxiDriver: Unutma ha, o sarılı piçlere güven olmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617732
    m_Localized: 'TaxiDriver: Göz açıp kapayıncaya kadar adamı alıp götürürler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617733
    m_Localized: 'TaxiDriver: Hadi be dayı... Ayıp ediyorsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617734
    m_Localized: 'TaxiDriver: Panik olduk diye kapıdan adam çevrilir mi yahu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617735
    m_Localized: 'TaxiDriver: Hay...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617736
    m_Localized: 'TaxiDriver: Senin de o FEMA piçlerinden bir farkın yok ha. İt herif.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617737
    m_Localized: 'Provocateur: İyi günler ev sahibi. Burada oda kiralıyor musunuz acaba?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617738
    m_Localized: Öyle de denebilir
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617739
    m_Localized: İnsanları evime alıyorum sadece
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617740
    m_Localized: 'Provocateur: Hımm... Pek muğlak bir cevap.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617741
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617742
    m_Localized: 'Provocateur: Pekâlâ. Sözleşmemizi daha sonra da imzalayabiliriz sanırım. Geriye dönük tarihlendiririz tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617743
    m_Localized: 'Provocateur: Yalnız... Resmî sözleşme olmadan gecelik ücret kaç oluyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617744
    m_Localized: İlla kira vermek istiyorsan miktarı sana kalmış
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617745
    m_Localized: Paranı istemiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617746
    m_Localized: 'Provocateur: Efendim? Ne demek "insanları evime alıyorum"? Burada gönüllüler mi çalışıyor? Evsizler için barınak mı işletiyorsunuz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617747
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617748
    m_Localized: 'Provocateur: Kusura bakmayın ama parasını ödemeden bir metrekarenizi bile işgal edemem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617749
    m_Localized: İlla kira vermek istiyorsan miktarı sana kalmış
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617750
    m_Localized: Paranı istemiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617751
    m_Localized: 'Provocateur: Pardon da ben iyiliğe muhtaç gibi mi duruyorum?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617752
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617753
    m_Localized: 'Provocateur: İnanılır gibi değil... Saygıdeğer bir ev sahibi, parayı asla geri çevirmez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617754
    m_Localized: 'Provocateur: Peki o zaman, başka zaman halledilir. Yasal bir sözleşmeyle tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617755
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617756
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617757
    m_Localized: 'Provocateur: Kusura bakmayın ama kiramı ödemeden bu çatının altında kalmaya vicdanım el vermez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617758
    m_Localized: 'Provocateur: Hiç etik değil. Daha da beteri, yasal değil...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617759
    m_Localized: 'Provocateur: Ya parasını vereceğim ya da içeri tek bir adım bile atmayacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617760
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617761
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617762
    m_Localized: 'Provocateur: Teşekkür ederim ev sahibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617763
    m_Localized: 'Provocateur: Kira sözleşmesinin ayrıntılarını sonra konuşuruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617764
    m_Localized: 'Provocateur: Pardon? Gitsem iyi mi olur? Tehdit mi ediyorsunuz siz beni?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617765
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617766
    m_Localized: 'Provocateur: Laflarınıza dikkat etmeni öneririm. Bu bir tehdit olarak algılanabilir çünkü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617767
    m_Localized: 'Provocateur: Ki bu da Anayasa''nın 119. maddesini ihlal etmiş olur. Sizin için hiç hoş olmaz yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617768
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617769
    m_Localized: 'Provocateur: İyi günler dilerim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617770
    m_Localized: 'Marauder: Lan... Burası boş değilmiş ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617771
    m_Localized: 'Marauder: Kusura bakma. İçeride kimse yok sandım. Ben gideyim yavaştan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617772
    m_Localized: 'Marauder: Gerçi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617773
    m_Localized: 'Marauder: Dinle bak... Biraz burada kalsam olur mu? Bir süredir... insanlarla vakit geçirmiyorum da.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617774
    m_Localized: Niye yalnızsın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617775
    m_Localized: Sence bu iyi bir fikir mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617776
    m_Localized: 'Marauder: Benim yanımda durmayı kim ister ki? Millet beni adam yerine bile koymuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617777
    m_Localized: 'Marauder: Sanki ben onlardan değersizmişim gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617778
    m_Localized: 'Marauder: Ben insanların neler yapabileceğini bizzat gördüm. Benden çok daha beteri var, orası kesin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617779
    m_Localized: 'Marauder: Yok, yok... Başkalarına uyum sağlayamam ben. Bu yüzden tek başıma sürünüyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617780
    m_Localized: Yalnız başına nasıl hayatta kalabiliyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617781
    m_Localized: İnsanlardan mal çalıyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617782
    m_Localized: 'Marauder: Hee, niye kalamayayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617783
    m_Localized: 'Marauder: Bu Ziyaretçiler ortaya çıktı çıkalı... kendi başımayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617784
    m_Localized: 'Marauder: İlk başta bu daha güvenli gelmişti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617785
    m_Localized: 'Marauder: Fakat dürüst olmak gerekirse... artık bıktım usandım bundan. Gölgelerle konuşmaktan yoruldum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617786
    m_Localized: 'Marauder: Kafayı sıyırmaya başladım. Delirecek gibiyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617787
    m_Localized: Yalnız başına nasıl hayatta kalabiliyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617788
    m_Localized: İnsanlardan mal çalıyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617789
    m_Localized: 'Marauder: Hım... Yalan söylemenin lüzumu yok. Terk edilmiş evlere bakıyorum. Boş dairelere falan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617790
    m_Localized: 'Marauder: Alabildiğimi alıyorum. Bazısını satıp kalanını elimde tutuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617791
    m_Localized: 'Marauder: Bir keresinde bu işi tamamen bırakacaktım neredeyse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617792
    m_Localized: 'Marauder: Neyse, evet. Senin evinden mal toplamaya gelmiştim. Boş sandım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617793
    m_Localized: 'Marauder: Yanlış anlama. Madem burada yaşıyorsun hâlâ... biraz kalsam sorun olur mu sana?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617794
    m_Localized: 'Marauder: Anlatabileceğim çok şey var. Bu gözler neler gördü neler...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617795
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617796
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617797
    m_Localized: 'Marauder: Sen beni eşkıya sandın galiba?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617798
    m_Localized: 'Marauder: Bak, melek olduğumu falan iddia etmiyorum ama bazı çizgileri ben bile aşmam. Başkasına asla zarar vermem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617799
    m_Localized: 'Marauder: Gerçi... bir keresinde başka şansım kalmamıştı ama o uzun hikâye. Başka zaman anlatırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617800
    m_Localized: 'Marauder: Neyse... Madem burada yaşıyorsun bir geceliğine kalsam sorun olur mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617801
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617802
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617803
    m_Localized: 'Marauder: Heyt be! Sonunda normal insan gibi uyuyabileceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617804
    m_Localized: 'Marauder: İstediğin zaman gel sohbet edelim. Anlatacağım bir sürü hikâye var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617805
    m_Localized: 'Marauder: Hiçbiri de sıkıcı değil, güven bana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617806
    m_Localized: 'Marauder: Sorun değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617807
    m_Localized: 'Marauder: Peki... yakında hiç bildiğin boş ev var mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617808
    m_Localized: 'Marauder: Bir uğrayacağım sadece, çok uzun süre kalmayacağım. Söz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617809
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617810
    m_Localized: 'Marauder: Gittin mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617811
    m_Localized: 'Marauder: Peki o zaman. Ben de gideyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617812
    m_Localized: 'GraveDigger: Merhabaaa? Yaşayan kimse yok mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617813
    m_Localized: 'GraveDigger: İçeri girebilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617814
    m_Localized: Kapıma vurup durma
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617815
    m_Localized: Bu ne böyle? Dan, dan, dan! Ben senin kapını kırmaya çalışıyor muyum?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617816
    m_Localized: 'GraveDigger: Tamam, tamam. Sakin. Uyandırmak istememiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617817
    m_Localized: 'GraveDigger: Benim gözüme hiç uyku girmiyor da...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617818
    m_Localized: 'GraveDigger: Eskiden mezarcıydım. Artık pek bir manası kalmadı gerçi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617819
    m_Localized: 'GraveDigger: Mezarların hiçbir önemi yok artık. Millet durduğu yerde yere yığılıp ölüyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617820
    m_Localized: Dışarıda bir şey gördün mü?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617821
    m_Localized: İşini bırakıp buraya mı geldin yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617822
    m_Localized: 'GraveDigger: Kusura bakma, gürültü yapmak istememiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617823
    m_Localized: 'GraveDigger: O son deliği kazarken neler gördüm bir bilsen...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617824
    m_Localized: 'GraveDigger: Millet takur tukur ölüyor ama gömecek kimse yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617825
    m_Localized: 'GraveDigger: Öyle yere yığıldıkları gibi kalıyorlar. Güneş cesetlerini yakar zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811904
    m_Localized: Dışarıda bir şey gördün mü?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811905
    m_Localized: İşini bırakıp buraya mı geldin yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811906
    m_Localized: 'GraveDigger: Aynen öyle. Mezar kazıyordum, bir eleman rica etmişti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811907
    m_Localized: 'GraveDigger: Öyle başımda dikildi, beni izliyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811908
    m_Localized: 'GraveDigger: Ben de kazmaya devam ederken birden "bam!" diye bir ses duydum. Kürek bir şeye vurmuştu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811909
    m_Localized: 'GraveDigger: Başta kaya falan sandım ama sonra birden... toprağın altından bir el çıktı!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811910
    m_Localized: 'GraveDigger: Bildiğin Ziyaretçi! Yerin altından çıktı! Başımda dikilen herif de kahkaha attı sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811911
    m_Localized: 'GraveDigger: Tabanları yağlayıp kaçtım, arkama bile bakmadım. Eve gitmeyi de gözüm yemedi. Kalabalık bir yer daha güvenli olur dedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811912
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811913
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811914
    m_Localized: 'GraveDigger: İşimin bir değeri kalmadı ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811915
    m_Localized: 'GraveDigger: Artık kimse ceset getirmiyor. Cenazeler milletin gram umurunda değil artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811916
    m_Localized: 'GraveDigger: Zaten güneş cesetleri yakıyor. Geceler kısa sürdüğü için ölülerin icabına bakamıyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811917
    m_Localized: 'GraveDigger: Keşke acılarımızı terbiye ettiğimiz gibi onlar da bizi terbiye etse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811918
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811919
    m_Localized: 'GraveDigger: Neyse, istifa ettim zaten. Bıktım usandım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811920
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811921
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811922
    m_Localized: 'GraveDigger: Sağ olasın!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811923
    m_Localized: 'GraveDigger: Kapıyı hızlı açıp kapa ama, olur mu? Arkamdan Ziyaretçi fırlayacak diye ödüm kopuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811924
    m_Localized: 'GraveDigger: Vay anasını arkadaş...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811925
    m_Localized: 'GraveDigger: Bir ömür boyunca mezar kazacağım diye belini kırıyorsun, neticeye bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811926
    m_Localized: 'GraveDigger: Eve geliyorsun, ev boş.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811927
    m_Localized: 'GraveDigger: Sonra Ziyaretçiler kapını çalıyor. Hatta daha beteri, kapıyı içeriden onlar açıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811928
    m_Localized: 'GraveDigger: Neler duydum neler. Millet dışarı çıkıyor, eve döndüklerinde de Ziyaretçilere yem oluyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811929
    m_Localized: 'GraveDigger: Güzel bir çukur kazıp içine gömüleceğim ve bir daha ASLA oradan çıkmayacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811930
    m_Localized: 'FormerFema: Merhaba? Kimse yok mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811931
    m_Localized: 'FormerFema: İçeride ayak sesi duydum. Kapının arkasında olduğunu biliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811932
    m_Localized: 'FormerFema: Rica etsem açar mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811933
    m_Localized: Önce aldıklarınızı geri getirin
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811934
    m_Localized: Bu sefer de beni mi alacaksınız?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811935
    m_Localized: 'FormerFema: Aldıklarımızı mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811936
    m_Localized: 'FormerFema: Ha... Kıyafetim yüzünden beni FEMA çalışanı mı sandın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811937
    m_Localized: 'FormerFema: Yok yok, bir cesetten aldım bunu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811938
    m_Localized: 'FormerFema: Daha güvenli olur diye düşündüm. Boşuna giymiyorlardır herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811939
    m_Localized: 'FormerFema: Herhâlde güneşin radyasyonu gece devam ediyordur. Bilemiyorum artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811940
    m_Localized: Sen kimsin o zaman?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811941
    m_Localized: Planın ne peki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811942
    m_Localized: 'FormerFema: Ne?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811943
    m_Localized: 'FormerFema: Anlamadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811944
    m_Localized: 'FormerFema: Haa! Ben FEMA çalışanı değilim ya. Kıyafetten mi öyle sandın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811945
    m_Localized: 'FormerFema: Anladığım kadarıyla herkes onlardan nefret ediyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811946
    m_Localized: 'FormerFema: Yaptıklarından dolayı herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811947
    m_Localized: 'FormerFema: Milleti alıp götürüyorlarmış. Bir daha geri getirmiyorlarmış.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811948
    m_Localized: 'FormerFema: Kim bilir ne halt çeviriyorlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811949
    m_Localized: Sen kimsin o zaman?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811950
    m_Localized: Planın ne peki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811951
    m_Localized: 'FormerFema: Sıradan bir işçiyim işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811952
    m_Localized: 'FormerFema: Buzdolabı yapardım eskiden. Tamir de ederdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811953
    m_Localized: 'FormerFema: Artık o işi yapmıyorum tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811954
    m_Localized: 'FormerFema: Ha bire iş çıkıyordu. Eleman kalmamıştı. Yetişemiyorduk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811955
    m_Localized: 'FormerFema: Dayanamayınca istifa ettim ben de.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811956
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811957
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811958
    m_Localized: 'FormerFema: Güzel bir soru... Açıkçası şu an hiçbir fikrim yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811959
    m_Localized: 'FormerFema: Eskiden bir işim vardı. Bir sıkıntı çıkmaz sanmıştım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811960
    m_Localized: 'FormerFema: Sonra planlarım suya düştü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811961
    m_Localized: 'FormerFema: Hiç beklemediğim görevleri başıma yıktılar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811962
    m_Localized: 'FormerFema: Yazılımdan bahsediyorum bu arada. Kod yazıyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811963
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811964
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811965
    m_Localized: 'FormerFema: Ne? Ha, sağ ol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811966
    m_Localized: 'FormerFema: Oturabileceğim bir yer var mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811967
    m_Localized: 'FormerFema: İçeri almanı beklemiyordum açıkçası.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811968
    m_Localized: 'FormerFema: Ne? Ha, sağ ol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811969
    m_Localized: 'FormerFema: Dur, bir saniye. Bu yanlış oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811970
    m_Localized: 'FormerFema: Herhâlde bu kıyafet milleti korkutuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811971
    m_Localized: 'FormerFema: Niye hâlâ giyiyorum onu da bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811972
    m_Localized: 'FormerFema: Görüşürüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811973
    m_Localized: 'Intruder: Hiç rüya görür müsün?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811974
    m_Localized: Ne?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811975
    m_Localized: Pek görmem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811976
    m_Localized: 'Intruder: Bildiğimiz rüya işte. Uyuduğunda bir şey görüyor musun yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811977
    m_Localized: 'Intruder: Neyi fark ettim, biliyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811978
    m_Localized: 'Intruder: İnsanlar artık rüya görmüyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811979
    m_Localized: 'Intruder: Sence neden?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811980
    m_Localized: Senin niye umurunda ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811981
    m_Localized: SEN rüya görüyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811982
    m_Localized: 'Intruder: Hah, işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811983
    m_Localized: 'Intruder: Sen de diğerleri gibisin. Ateşi çıkanlar bile hiçbir şey görmüyor artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811984
    m_Localized: 'Intruder: Acaba bu güneşin suçu mu? Yoksa başka bir sebebi mi var?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811985
    m_Localized: Senin niye umurunda ki?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811986
    m_Localized: SEN rüya görüyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811987
    m_Localized: 'Intruder: Rüya dediğin... hassas, tuhaf bir şeydir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811988
    m_Localized: 'Intruder: Rüya görürken bir cevap ararız, huzur buluruz... Sessizliğin keyfini çıkarırız belki de.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811989
    m_Localized: 'Intruder: Fakat artık rüyalarımız bizi terk ediyor. Suretlerini kaybediyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811990
    m_Localized: 'Intruder: Bence istirahat edecek, tefekkür edecek bir alan kalmadığı için böyle oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811991
    m_Localized: Gel içeri madem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811992
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811993
    m_Localized: 'Intruder: Bilemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811994
    m_Localized: 'Intruder: Altı gündür uyumuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811995
    m_Localized: 'Intruder: Belki uyursam bir rüya görürüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811996
    m_Localized: Gel içeri madem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811997
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811998
    m_Localized: 'Intruder: Sağ olasın. Burada uyumaya çalışacağım ama muhtemelen olmayacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811999
    m_Localized: 'Intruder: Evdeki başka bir insan rüya görürse de güzel olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812000
    m_Localized: 'Intruder: Sence insanlar bir gün tekrar rüya görecekler mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812001
    m_Localized: 'Intruder: Umarım görürler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812002
    m_Localized: 'Intruder: Rüyalar olmadan hayat zor. Herkese zor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812003
    m_Localized: 'Courier: Merhaba, KapımaBırak siparişi için gelmiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812005
    m_Localized: Teslimatların devam ettiğini bilmiyordum
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812011
    m_Localized: 'Courier: İyi günler. Şey, pardon... İyi geceler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812012
    m_Localized: 'Courier: Hâlâ alışamadım şuna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812013
    m_Localized: 'Courier: Merhaba, KapımaBırak siparişi için gelmiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812015
    m_Localized: Sen nasıl kurye oldun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812016
    m_Localized: 'Courier: Taramalardan geçtim işte. Tüm belirtilere baktılar, insan olduğuma karar verdiler ve...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812017
    m_Localized: 'Courier: Ha, sen kıyametin ortasında hâlâ nasıl çalıştığımı mı soruyordun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812018
    m_Localized: 'Courier: Ya ne yapsaydım? Evde boş boş otursa mıydım?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812019
    m_Localized: 'Courier: En azından burada kafam dağılıyor, bu rezillikleri düşünmek zorunda kalmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812020
    m_Localized: 'Courier: İyi geceler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812021
    m_Localized: 'Courier: Merhaba. Sipariş için geldim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812023
    m_Localized: Keyfin yerinde değil sanki
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812024
    m_Localized: 'Courier: İş arkadaşımı FEMA alıp götürdü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812025
    m_Localized: 'Courier: Her sabahki gibi kontrol yapıyorlardı. Gözlerinin kıpkırmızı olduğunu gördüler. Ah dostum ah...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812026
    m_Localized: 'Courier: Herifi öylece götürdüler. Ne oldu ona, hiçbir fikrim yok. Çıkaracaklar mı, onu bile bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812027
    m_Localized: 'Courier: Ya gözlerim uykusuzluktan kızarırsa? Beni de o karantina bölgelerine mi sürükleyecekler?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812029
    m_Localized: 'Courier: İyi geceler...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812030
    m_Localized: 'Courier: Sipariş...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812033
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812034
    m_Localized: Ne oldu sana?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812035
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812036
    m_Localized: 'Courier: Arkadaşımı öldürdüler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812037
    m_Localized: 'Courier: Bir siparişi teslim etmeye gitmişti. Ev sahibi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812038
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812039
    m_Localized: 'Courier: Millet kafayı yemiş amına koyayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812040
    m_Localized: 'Courier: Normal kurye lan işte! Nasıl bir tehlike teşkil etmiş olabilir ki yani? Bok mu vardı da vurdu herifi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812041
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812050
    m_Localized: 'Courier: Buyur. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812051
    m_Localized: 'CultistPriest: Evetttt... Evin kusursuz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812052
    m_Localized: 'CultistPriest: Hissedebiliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812053
    m_Localized: Neyi hissediyorsun tam olarak?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812054
    m_Localized: Evet, ev benim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812055
    m_Localized: 'CultistPriest: Ölüm''ü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812056
    m_Localized: 'CultistPriest: Ölüm evini epey beğenmiş belli ki. Hoşuna gitmiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812057
    m_Localized: 'CultistPriest: Burada kaç kişi öldü bilemiyorum ama... O''nun varlığını epey hissediyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812058
    m_Localized: Sen kimsin? Niye böyle giyindin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812059
    m_Localized: Sen o kültist manyaklardan falan mısın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812060
    m_Localized: 'CultistPriest: Aynen öyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812061
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812062
    m_Localized: 'CultistPriest: Ölüm her yerde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812063
    m_Localized: 'CultistPriest: Yananlar oldu. Sürüklenip idam edilenler oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812064
    m_Localized: 'CultistPriest: Evet, evet... Ölüm seni beğenmiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812065
    m_Localized: Sen kimsin? Niye böyle giyindin?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812066
    m_Localized: Sen o kültist manyaklardan falan mısın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812067
    m_Localized: 'CultistPriest: Bizler, yeni bir inanışın elçileriyiz. Kutsal bir doktrinin hatipleriyiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812068
    m_Localized: 'CultistPriest: Ölüm, kapımızdadır. Tek arzusu, beniâdemin acılarını dindirmektir. Bizi ıstıraptan, kargaşadan, kıyametten kurtarmaktır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812069
    m_Localized: 'CultistPriest: Bizim tek yaptığımız, O''nu yaklaştırmaktır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812070
    m_Localized: 'CultistPriest: Zira kurtulmanın tek yolu budur. Zira geri dönüş noktası çoktan aşılmıştır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812071
    m_Localized: Ne istiyorsun peki tam olarak?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812072
    m_Localized: İçeri girmek mi istiyorsun yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812073
    m_Localized: 'CultistPriest: Olabilir. Bu kötü bir şey mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812074
    m_Localized: 'CultistPriest: Bu, benim örtümdür. Öldükten sonra ona ihtiyaç olacaktır. Böylelikle ölülerimizi saracak örtü bulmamız kolaylaşacaktır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812075
    m_Localized: 'CultistPriest: Biz, kurtuluşa inanmayız. Bizzat Ölüm''den gelmediği sürece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812076
    m_Localized: 'CultistPriest: O, çok yakınlarda. Bizim tek vasfımız, O''nun eşiği geçmesini kolaylaştırmak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812077
    m_Localized: Ne istiyorsun peki tam olarak?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812078
    m_Localized: İçeri girmek mi istiyorsun yani?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812079
    m_Localized: 'CultistPriest: Defin ayini gerçekleştirmemiz gerekiyor. Yeni yöntemleri kullanarak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812080
    m_Localized: 'CultistPriest: Senin evin, bunun için kusursuz. Evett...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812081
    m_Localized: 'CultistPriest: Ölümün buradaki nüfuzu yüksek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812082
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812083
    m_Localized: 'CultistPriest: Burada ne oldu sahiden?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812084
    m_Localized: 'CultistPriest: Neyse, bir önemi yok. Kardeşlerimin evini işgal etmesine izin ver. Onları koru.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812085
    m_Localized: 'CultistPriest: Görevlerini tamamlayana dek hayatta kalmaları gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812086
    m_Localized: Açıkçası dediklerine uymak pek içimden gelmedi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812087
    m_Localized: Bu istediğin kolay olmayacak
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812088
    m_Localized: 'CultistPriest: Girmeme gerek yok. Benim tek vazifem, ebedî huzuru getirecek olan hakikati yaymaktır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812089
    m_Localized: 'CultistPriest: Ancak kardeşlerimin bir sığınağa ihtiyacı var. Ölüm, buradan hoşlanıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812090
    m_Localized: 'CultistPriest: Merhumlar için ayin yapacaklar. Senin tek görevin, onları güvende tutmak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812091
    m_Localized: Açıkçası dediklerine uymak pek içimden gelmedi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812092
    m_Localized: Bu istediğin kolay olmayacak
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812093
    m_Localized: 'CultistPriest: Belki gerçekten de yanacaksındır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812094
    m_Localized: 'CultistPriest: Kardeşlerime iyi bak. Unutma, biri bile ölürse... evin yerle bir olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812095
    m_Localized: 'CultistPriest: Biri daha ölürse tüm çabalarımız boşa gider.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812096
    m_Localized: 'CultistPriest: Böyle bir durumla karşılaşırsak evini bizzat ateşe veririz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812097
    m_Localized: 'CultistPriest: Beni affet, kutsal vazifemizi yerine getirmenin başka bir yolu yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812098
    m_Localized: O zaman hepinizi tek tek vururum
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812099
    m_Localized: Tehdit edilmek hiç hoşuma gitmiyor ama peki, yardım edeceğim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812100
    m_Localized: 'CultistPriest: Evet, olmayacak. Bu ulu bir görev, daha azı beklenemezdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812101
    m_Localized: 'CultistPriest: Sen de huzur arayışında değil misin? Kimsenin başkasına yük olmadığı bir dünya istemiyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812102
    m_Localized: 'CultistPriest: Kardeşlerime iyi bak. Unutma, biri bile ölürse... evin yerle bir olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812103
    m_Localized: 'CultistPriest: Biri daha ölürse hedefimize asla ulaşamayacağız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812104
    m_Localized: 'CultistPriest: Korkarım ki planlarımız suya düşerse duvarlarına veda etmek zorunda kalacaksın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812105
    m_Localized: 'CultistPriest: Maalesef başka yolu yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812106
    m_Localized: O zaman hepinizi tek tek vururum
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812107
    m_Localized: Tehdit edilmek hiç hoşuma gitmiyor ama peki, yardım edeceğim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812108
    m_Localized: 'CultistPriest: Bu inanışın meşalelerini taşıyan bir biz mi varız sanıyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812109
    m_Localized: 'CultistPriest: Başkaları da gelecek. Sen uyurken duvarlarını benzine boğup kibrit yakacaklar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812110
    m_Localized: 'CultistPriest: Yangından canlı çıksan dahi evini kaybedeceksin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812111
    m_Localized: 'CultistPriest: Nereye kaçabilirsin ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812112
    m_Localized: 'CultistPriest: Öyleyse... Kalmalarına izin ver, evetttt...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812113
    m_Localized: 'CultistPriest: Çok uzun süreceğini sanmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812114
    m_Localized: 'CultistPriest: Teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812115
    m_Localized: 'CultistPriest: Çok vakte ihtiyaç duymayacaklar ama yine de onlara göz kulak ol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812116
    m_Localized: 'CultistPriest: Görüşmek üzere. Onları kontrol etmeye geleceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812117
    m_Localized: 'CultistPriest: Vaktimizi hiç boşa harcamayalım. Kardeşlerim ne hâldedir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812118
    m_Localized: Sıkıntı yok, hâlâ yaşıyorlar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812119
    m_Localized: Sikimde değil. Sanki başka derdim yokmuş gibi soruyor bir de
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812120
    m_Localized: 'CultistPriest: Yaptığın her şey için teşekkürler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812121
    m_Localized: 'CultistPriest: Eminim sen de yorulmuşsundur. Bu gürültüden, bu baskıdan, bu kargaşadan...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812122
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812123
    m_Localized: 'CultistPriest: Ölüm, uzun süre önce benimle konuştu. Vakit geldiğinde seninle tanışmak istiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812124
    m_Localized: 'CultistPriest: Sana saklanabileceğin bir yer verebilir. Her şeyden saklanabileceğin... Sonumuz da dâhil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812125
    m_Localized: 'CultistPriest: Bu ne anlama geliyor henüz ben de bilmiyorum... ama kulağa cazip gelmiyor mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812126
    m_Localized: 'CultistPriest: Bir saniye...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812127
    m_Localized: 'CultistPriest: Hepsi öldü mü?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812128
    m_Localized: 'CultistPriest: Tek şansımızı elimizden aldın...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812129
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812130
    m_Localized: 'CultistPriest: Elveda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812131
    m_Localized: 'CultistPriest: Ölüm artık benimle konuşmuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812132
    m_Localized: 'CultistPriest: Demek dünyanın sonu böylece gelecekti. Büyük bir patlamayla değil... bir iniltiyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812133
    m_Localized: 'CultistPriest: Tabii, senin için sorun değil. Öyle değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812134
    m_Localized: Kardeşlerin gayet iyi
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812135
    m_Localized: Yürü git. İşim gücüm var
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812136
    m_Localized: 'CultistPriest: Evettt... Olması gerektiği gibi. O hâlâ bizi gözetiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812137
    m_Localized: 'CultistPriest: Seni daha fazla rahatsız etmeyeceğim. Görüşmek üzere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812138
    m_Localized: Bu manyakları da al git
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812139
    m_Localized: Bu "Ölüm" mevzusu ne şimdi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812140
    m_Localized: 'CultistPriest: Yaşayanlar âlemini terk ettiler demek...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812141
    m_Localized: 'CultistPriest: Demek bu yüzden...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812142
    m_Localized: 'CultistPriest: Madem Ölüm seni seçti yakından görmesini sağlamak da bana düşer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812143
    m_Localized: 'CultistPriest: İyi geceler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812144
    m_Localized: Bu manyakları da al git
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812145
    m_Localized: Bu "Ölüm" mevzusu ne şimdi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812146
    m_Localized: 'CultistPriest: Niye?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812147
    m_Localized: Beni yalnız bırakın
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812148
    m_Localized: Burası kreş değil
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812149
    m_Localized: 'CultistPriest: O''nun geleceği gün yaklaşıyor. Evettt, hissediyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812150
    m_Localized: 'CultistPriest: Buraya kimi çağırdığımızı idrak edemezsek neticenin bir önemi kalmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812151
    m_Localized: 'CultistPriest: Önemli olan şu ki hepimiz usandık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812152
    m_Localized: 'CultistPriest: Ancak ebedî hiçlik hepimizi korkutuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812153
    m_Localized: 'CultistPriest: "Öbür dünya" düşüncesi, sahte dinlerin uydurduğu boş bir hayaldir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812154
    m_Localized: 'CultistPriest: Yeniden doğma döngüsü dedikleri de kısa aralarla ebediyen işkence görmekten farksızdır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812155
    m_Localized: 'CultistPriest: Ancak Ölüm... bizi en korkunç kaderden kurtarabilir. Yokluktan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812156
    m_Localized: 'CultistPriest: O''na dua edip durmaktan başka çaremiz yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812157
    m_Localized: Beni yalnız bırakın
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812158
    m_Localized: Burası kreş değil
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812159
    m_Localized: 'CultistPriest: Pekâlâ. Yapacağını yaptın zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812160
    m_Localized: 'CultistPriest: Onları da alıp gideceğim. Yine de minnettarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812161
    m_Localized: 'CultistPriest: Seni gerçekten o kadar rahatsız ettiler mi ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812162
    m_Localized: 'CultistPriest: Yoksa aradığın şey, aslında huzur değil miydi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812163
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812164
    m_Localized: 'CultistPriest: Yine de sana minnettar şekilde buradan ayrılacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812165
    m_Localized: 'CultistPriest: Yapılması gereken yapıldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006208
    m_Localized: 'MushroomEater: Merhabalar delikanlı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006209
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006210
    m_Localized: Beni tanıyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006211
    m_Localized: 'MushroomEater: Hohoho! Mantarlardan biraz anlayan bir ihtiyarın tekiyim sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006212
    m_Localized: 'MushroomEater: Sen beni boş ver. Emeçlerim, bana çok iç karartıcı bir bilgi verdi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006213
    m_Localized: 'MushroomEater: Mantar Festivali başlıyor! Ancak zaman akıp gidiyor delikanlı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006214
    m_Localized: 'MushroomEater: Lütfen beni dikkatli dinle ve sözlerimi sakın hafife alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006215
    m_Localized: Emeçlerin mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006216
    m_Localized: Anlayamadım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006217
    m_Localized: 'MushroomEater: Hoho, biliyorum tabii ki! Emeçlerim bana senden bahsetti!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006218
    m_Localized: 'MushroomEater: Konuştuklarını anlamak zordur ama zaman içinde verdiği sinyalleri deşifre etmeyi öğrendim. Tabii, tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006219
    m_Localized: 'MushroomEater: Dikkatli dinle beni delikanlı. Çok işimiz var ama pek vaktimiz yok!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006220
    m_Localized: Emeçlerin mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006221
    m_Localized: Anlayamadım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006222
    m_Localized: 'MushroomEater: Tabii, tabii. Normal insanların anlaması zor, farkındayım. Kendilerine has bir iletişim yöntemleri var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006223
    m_Localized: 'MushroomEater: Mantarlar, emeçlerini kullanarak birbirleriyle iletişim kurarlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006224
    m_Localized: 'MushroomEater: Gülümsemeler Kitabı''nı okuyarak onları dinlemeyi öğrendim fakat son söyledikleri... pek iç açıcı değildi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006225
    m_Localized: 'MushroomEater: Mantar Festivali''nin yaklaştığını söylediler. Bu hiç iyi bir haber değil delikanlı, hem de hiç!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006226
    m_Localized: Gülümsemeler Kitabı mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006227
    m_Localized: Mantar Festivali mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006228
    m_Localized: 'MushroomEater: Haha! Merak etme, yakında her şeyi anlayacaksın. Unutma ha, ne olursa olsun Festival''i durdurmamız gerek!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006229
    m_Localized: 'MushroomEater: Şimdi şuna bir bak bakalım... İşimize yarayacak bir şey var elimde. Gülümsemeler Kitabı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006230
    m_Localized: Gülümsemeler Kitabı mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006231
    m_Localized: Mantar Festivali mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006232
    m_Localized: 'MushroomEater: Özel bir kitap. Hatta dünyanın en özel kitabı. Sana ne yapman gerektiğini söyler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006233
    m_Localized: 'MushroomEater: Ancak korkarım ki hepsini okuyacak vakit yok. Kocaman bir kitap... ve vaktimiz daralıyor!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006234
    m_Localized: 'MushroomEater: Ben de en önemli sayfalarını koparayım dedim. Al bakalım delikanlı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006235
    m_Localized: İyi bari, Gülümsemeler Kitabı'nın sayfalarını ver bakalım
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006236
    m_Localized: Sende kalsın
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006237
    m_Localized: 'MushroomEater: Ohoo delikanlı...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006238
    m_Localized: 'MushroomEater: Bunun için Gülümsemeler Kitabı''na başvurmamız gerekiyor!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006239
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006240
    m_Localized: 'MushroomEater: Büyük bir mantar yükselecek... ve sporlarını her yere yayacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006241
    m_Localized: 'MushroomEater: Gölgeleri de yayılıp güneşi yutacak. Hiçbir yer bu eğlenceden mahrum bırakılmayacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006242
    m_Localized: 'MushroomEater: Ancak bu mantar, yalnız başına yükselmeyecek. Zira bu, bir Festival olacak!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006243
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006244
    m_Localized: 'MushroomEater: Aman aman! Buna izin veremeyiz. Bunu durdurmalıyız. Bir araya gelmeliyiz delikanlı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006245
    m_Localized: 'MushroomEater: Gülümsemeler Kitabı''ndan birkaç sayfa kopardım. Buyur, al bakalım. Sana yapman gerekeni söylerler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006246
    m_Localized: İyi bari, ver bakalım Gülümsemeler Kitabı'nın sayfalarını
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006247
    m_Localized: Sende kalsın
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006248
    m_Localized: 'MushroomEater: Ha şöyle delikanlı. Vaktin olunca iyice bir oku, tamam mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006249
    m_Localized: 'MushroomEater: Hadi bakalım. Ben gideyim artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006250
    m_Localized: 'MushroomEater: Sen her şeyi hallettikten sonra döneceğim! Hadi, aylaklık etme!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006251
    m_Localized: 'MushroomEater: Sana mazbut bir hayat, sağlam bir ahlak ve bol bol sevgi diliyorum delikanlı. Hadi görüşürüz!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006252
    m_Localized: 'MushroomEater: Neden ama? Kitabın sadece küçük bir parçası... Zaten ezbere biliyorum ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006253
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006254
    m_Localized: 'MushroomEater: Peh... Gençlerle konuşmaya çalışarak boşa vakit harcıyoruz belli ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006255
    m_Localized: 'MushroomEater: Hah, seni gördüğüme sevindim delikanlı! Gülümsemeler Kitabı''nda yazan her şeyi yapmışsın, eline sağlık.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006256
    m_Localized: 'MushroomEater: Umarım Festival''i durdurmaya yeter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006257
    m_Localized: Nasıl anladın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006258
    m_Localized: Pek güvenmiyor gibisin
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006259
    m_Localized: 'MushroomEater: Ee, emeçler söyledi tabii!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006260
    m_Localized: 'MushroomEater: Çok şey biliyorlar, çok. Ancak maalesef onlar da tehlikede... Tıpkı bizim gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006261
    m_Localized: 'MushroomEater: Mantarlar çok hızlı yetişiyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006262
    m_Localized: Yaptıklarımız Festival'i nasıl durduracak?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006263
    m_Localized: Mantarlardan Festival'i başlatmamalarını istesen olmaz mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006264
    m_Localized: 'MushroomEater: Ah be delikanlı... Keşke o kadar basit olsa. Hâlâ yaptıklarımız bir işe yaradı mı, onu bile bilmiyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006265
    m_Localized: 'MushroomEater: Şu an yapabileceğimiz tek şey bekleyip mantarları durdurabildik mi, ona bakmak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006266
    m_Localized: Yaptıklarımız Festival'i nasıl durduracak?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006267
    m_Localized: Mantarlardan Festival'i başlatmamalarını istesen olmaz mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006268
    m_Localized: 'MushroomEater: Kadim bir ayin gerçekleştirdik delikanlı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006269
    m_Localized: 'MushroomEater: Yok, yok! Mantarlarla doğrudan konuşamayız! Biz emeçlerin bir parçası değiliz!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006270
    m_Localized: 'MushroomEater: Ancak Gülümsemeler Kitabı, köklerini ve bitmek bilmeyen büyümelerini dindirmenin bir yolunu bize gösterdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006271
    m_Localized: 'MushroomEater: Biz de tam olarak bu yola düştük.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006272
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006273
    m_Localized: 'MushroomEater: Vakit geldiğinde geri döneceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006274
    m_Localized: 'MushroomEater: Mantarların küçük kaldığından emin olacak ve Festival''in başlamasına engel olacağız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006275
    m_Localized: 'MushroomEater: Unutma, mantarlar göründükleri gibi olmayabilirler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006276
    m_Localized: 'MushroomEater: Bu bir veda değil delikanlı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006277
    m_Localized: 'MushroomEater: Şahane bir fikir ama... doğrudan mantarlarla konuşamıyorum maalesef.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006278
    m_Localized: 'MushroomEater: Heyhat, mantar ağının sadece tek bir parçası onlar!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006279
    m_Localized: 'MushroomEater: Asıl beyin, emeçlerdir. Keşke onlar da benim onları anladığım gibi bizi anlasa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006280
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006281
    m_Localized: 'MushroomEater: Vakit geldiğinde geri döneceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006282
    m_Localized: 'MushroomEater: Mantarların küçük kaldığından emin olacak ve Festival''in başlamasına engel olacağız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006283
    m_Localized: 'MushroomEater: Unutma, mantarlar göründükleri gibi olmayabilirler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006284
    m_Localized: 'MushroomEater: Bu bir veda değil delikanlı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006285
    m_Localized: 'MushroomEater: Belli ki Festival''i durduramamışız...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006286
    m_Localized: 'MushroomEater: Emeçler öylesine bir kargaşa içerisinde ki yaptığımız ayin... işe yaramamış.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006287
    m_Localized: Niye işe yaramadı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006288
    m_Localized: Festival neden başlıyor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006289
    m_Localized: 'MushroomEater: Emeçlerin içinde ters giden bir şey var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006290
    m_Localized: 'MushroomEater: Ağlarında çok fazla musibet birikince... diğer her şeyi tıkıyor işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006291
    m_Localized: 'MushroomEater: Mantarları karaciğer gibi düşün. Bedendeki zehirleri atmaya çalışıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006292
    m_Localized: 'MushroomEater: Ancak son zamanlarda o kadar fazla musibet var ki mantarın büyümesi sınır tanımıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006293
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006294
    m_Localized: 'MushroomEater: Bunu yapmak istemiyorum ama... sanırım Mantarlar Diyarı''na gitmemiz gerekecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006295
    m_Localized: Mantarlar Diyarı mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006296
    m_Localized: Kulağa çok da kötü gelmedi...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006297
    m_Localized: 'MushroomEater: Festival, mantarların büyümesinin iyice çığırından çıkmasına yol açacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006298
    m_Localized: 'MushroomEater: Yani emeçlerin de başı belaya girecek!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006299
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006300
    m_Localized: 'MushroomEater: Bunu yapmak istemiyorum ama... sanırım Mantarlar Diyarı''na gitmemiz gerekecek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006301
    m_Localized: Mantarlar Diyarı mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006302
    m_Localized: Kulağa çok da kötü gelmedi...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006303
    m_Localized: 'MushroomEater: Hiç ama hiç haklı değilsin delikanlı! Orası, hiçbir insanın adım atmadığı korkunç bir yerdir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006304
    m_Localized: 'MushroomEater: Açıkçası, böylesi daha iyiydi ama maalesef ki başka çaremiz yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006305
    m_Localized: 'MushroomEater: Ne pahasına olursa olsun Festival''i durdurmamız gerek!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006306
    m_Localized: 'MushroomEater: Benimle Mantarlar Diyarı''na gitmeye hazır mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006307
    m_Localized: Evet
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006308
    m_Localized: Hayır
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006309
    m_Localized: 'MushroomEater: İsmine kanmayasın delikanlı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006310
    m_Localized: 'MushroomEater: Bizim konuştuğumuz dilde hoş bir tınısı olabilir ama mantarcada çok daha farklı bir anlama geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006311
    m_Localized: 'MushroomEater: Öyle güllük gülistanlık bir yer değil, yok!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006312
    m_Localized: 'MushroomEater: Orada Festival''i göremeyeceğiz ama diğerleri.. Emeçler...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006313
    m_Localized: 'MushroomEater: Hemen harekete geçmezsek çok büyük riske gireriz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006314
    m_Localized: 'MushroomEater: Hiçbir insan oraya adım atmamalı. Asla ama asla. Ancak Festival''i durdurmak istiyorsak başka çaremiz yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006315
    m_Localized: 'MushroomEater: Benimle Mantarlar Diyarı''na gitmeye hazır mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006316
    m_Localized: Evet
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006317
    m_Localized: Hayır
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006318
    m_Localized: 'MushroomEater: Hoho! Ha şöyle delikanlı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006319
    m_Localized: 'MushroomEater: Pılını pırtını topla da...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006320
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006321
    m_Localized: 'MushroomEater: Dur bir saniye! Bana saatini göster!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006322
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006323
    m_Localized: 'MushroomEater: GECE YARISI MI?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006324
    m_Localized: 'MushroomEater: Eyvahlar olsun! Geç kaldık! Gel çabuk! Çabuk, acele et!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006325
    m_Localized: 'MushroomEater: Mantarlar Diyarı''nın kapısı kapanmadan!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006326
    m_Localized: 'MushroomEater: Vay hâlimize delikanlı... Bu hiç iyi olmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006327
    m_Localized: 'MushroomEater: Maalesef ki bunu tek başıma yapamam. Yardımına ihtiyacım var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006328
    m_Localized: 'MushroomEater: Çok korkunç bir dönemden geçiyoruz delikanlı. Mantarlar Diyarı diz çökerken biz dans ediyoruz âdeta. Belki de biz de...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006329
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006330
    m_Localized: 'MushroomEater: Bizi Mantarlar Diyarı''nda ne bekler, bilemiyorum ancak emin olduğum tek bir konu var: Tehlikeli olacağı kesin!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006331
    m_Localized: 'MushroomEater: Tekrar soruyorum delikanlı. Benimle gelecek misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006332
    m_Localized: Evet
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006333
    m_Localized: Hayır
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006334
    m_Localized: 'MushroomEater: Öyleyse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006335
    m_Localized: 'MushroomEater: Korkarım tüm ümidimizi yitirdik.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006336
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006337
    m_Localized: 'MushroomEater: Sana mazbut bir hayat, sağlam bir ahlak ve bol bol sevgi diliyorum delikanlı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006338
    m_Localized: 'MushroomEater: Hadi eyvallah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006339
    m_Localized: 'Miner: Ha? KİM O? Bir şey duydum sanki...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006340
    m_Localized: 'Miner: Galiba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006341
    m_Localized: Evimin altında ne arıyorsun sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006342
    m_Localized: Orada mahsur mu kaldın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006343
    m_Localized: 'Miner: NE? Sesli konuş!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006344
    m_Localized: 'Miner: Kulaklarım toz dumanla doldu, Bİ'' HALT DUYAMIYORUM.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006345
    m_Localized: 'Miner: Evinin altında mıyız?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006346
    m_Localized: 'Miner: Kafamıza düşmesin de.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006347
    m_Localized: Burada ne işin var?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006348
    m_Localized: Orada ne arıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006349
    m_Localized: 'Miner: NE?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006350
    m_Localized: 'Miner: Mahsur mu? YOK. Bir şey bulduk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006351
    m_Localized: 'Miner: Kulaklarım öyle bir toz dolmuş ki ON KİLOMETRE ÖTEDEN KONUŞUYORSUN gibi geliyor. Hayda...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006352
    m_Localized: Orada ne işin var?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006353
    m_Localized: Orada ne arıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006354
    m_Localized: 'Miner: Bizim dostlarla sıcaktan korunmak için tünel kazalım dedik.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006355
    m_Localized: 'Miner: Daha yeni kazmaya başlamıştık ama bir baktık, KOCAMAN BİR YER ALTI ŞEBEKESİ bulmuşuz!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006356
    m_Localized: 'Miner: Daha bir sürü vardı ama bazıları geçenlerde çöktü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006357
    m_Localized: 'Miner: Bu tüneller acayip derine iniyor. ACAYİP DERİNE. Nereye gidiyorlar, hiçbir fikrim yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006358
    m_Localized: 'Miner: Neyse, sen onu boş ver. BAŞKA BİR ŞEY bulduk çünkü!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006359
    m_Localized: Ne buldunuz? İlginç bir şey mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006360
    m_Localized: Ziyaretçi mi yakaladınız?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006361
    m_Localized: 'Miner: SIĞINAK ARIYORUM LAN, SIĞINAK! Sıcaklıktan korunmak için!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006362
    m_Localized: 'Miner: Daha yeni kazmaya başlamıştık, sonra birden KOCA BİR TÜNEL ŞEBEKESİ bulduk!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006363
    m_Localized: 'Miner: Kim kazdı, niye kazdı hiç bilmiyorum. Fakat bir FİKRİMİZ VAR, orası kesin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006364
    m_Localized: 'Miner: Bizce Ziyaretçiler, bu tünellerle etrafta dolaşıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006365
    m_Localized: 'Miner: Daha karşımıza çıkan olmadı ama, bilemiyoruz yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006366
    m_Localized: 'Miner: DİNLE BAK, garip olan kısım tüneller değil. Başka bir şey var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006367
    m_Localized: Ne buldunuz? İlginç bir şey mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006368
    m_Localized: Ziyaretçi mi yakaladınız?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006369
    m_Localized: 'Miner: DELİK BULDUK!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006370
    m_Localized: 'Miner: Yakınlarında bir şeyler oluyor bir de. ASLA DURMAYAN usul bir uğultu var...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006371
    m_Localized: 'Miner: Yaklaşınca hayvanların sesi kesiliyor. Pusulalar kafayı yiyor. Fener çalışmıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006372
    m_Localized: 'Miner: Bizim elemanlardan biri girdi. Ben de... yardım lazım olur falan diye burada durayım dedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006373
    m_Localized: 'Miner: DİNLE BAK! Buraya inmeyi düşünüyorsan SAKIN O DELİĞE YAKLAŞMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006374
    m_Localized: 'Miner: Etrafını kazmaya çalıştık ama neredeyse senin ev başımıza yıkılıyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006375
    m_Localized: 'Miner: NE?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006376
    m_Localized: 'Miner: Yok, çok ilginç bir şey değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006377
    m_Localized: 'Miner: Bir çukur sadece ama etrafında garip şeyler oluyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006378
    m_Localized: 'Miner: Bizim elemanlardan biri bir yerde duymuş bunu. Bakmaya değebilir diye düşündü.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006379
    m_Localized: 'Miner: DİNLE BAK! Buraya inmeyi düşünüyorsan SAKIN O DELİĞE YAKLAŞMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006380
    m_Localized: 'Miner: Etrafını kazmaya çalıştık ama neredeyse senin ev başımıza yıkılıyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006381
    m_Localized: 'Miner: Aşağı geldiğinde anlatırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006382
    m_Localized: 'Miner: Döndün mü? HA? Daha sessiz mi konuşuyorsun yoksa bu uğultu yüzünden iyice sağır mı oldum ben? EE? ÇIKAR AĞZINDAKİ BAKLAYI!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006383
    m_Localized: Ne kadar zamandır aşağıdasın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006384
    m_Localized: Dostların daha dönmedi mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006385
    m_Localized: 'Miner: NE? SESLİ KONUŞ! İki üç gündür falan oturuyorum burada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006386
    m_Localized: 'Miner: Burada zaman bir değişik akıyor. Ne ışık var ne saat. Ne bileyim ben kaç saat geçtiğini.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006387
    m_Localized: 'Miner: Sen orada bir şeyler ye yoksa benim gibi olursun. Karnı aç, tek dostu bir fener...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006388
    m_Localized: Deliğe kendin baktın mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006389
    m_Localized: Dostlarına bir şey olmuş olmasından korkmuyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006390
    m_Localized: 'Miner: NE? BENİM DOSTLAR MI? Yok yok, bir şey olmaz. Birisi çok derine indi ama yakında döner. Nereye koyarsan koy, çıkışını bulur o.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006391
    m_Localized: 'Miner: Diğeri de halata bağlı. Hazır olduğunda veya bir sıkıntı çıkarsa çeker zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006392
    m_Localized: 'Miner: BAK, GÖRDÜN MÜ? Halat hâlâ gergin. Demek ki hâlâ aşağıda. Bir sıkıntı olsaydı bilirdik.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006393
    m_Localized: Deliğe kendin baktın mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006394
    m_Localized: Dostlarına bir şey olmuş olmasından korkmuyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006395
    m_Localized: 'Miner: BAKTIN MI DERKEN? Yani. Tam da değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006396
    m_Localized: 'Miner: İsterdim ama bu halat varken bir yanlış hareket yaptım mı, HAPI YUTARIM.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006397
    m_Localized: 'Miner: Diğerleri hâlâ buradayken bir baktım ama aşağısı... komple boşluk gibi. Hiçbir şey yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006398
    m_Localized: 'Miner: Ama bazen yakınında durunca... sanki bir şey seni çağırıyor gibi oluyor. Dene bak. Dinle...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006399
    m_Localized: 'Miner: Korktuğumdan değil ama... insanı içine çekiyor âdeta. Bir kere daha bakabilsem aslında... Birazcık daha yakından...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006400
    m_Localized: 'Miner: Yakın duracağız, TAMAM MI? Birbirimizi çekmeye hazır olmamız lazım!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006401
    m_Localized: 'Miner: ZİYARETÇİLER Mİ? Biz de öyle diyoruz. Bu tüneller galiba onlara ait. O delik de herhâlde... bir tür geçit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006402
    m_Localized: 'Miner: Ya aradığımız cevaplar aşağıdaysa? Hepsini öğrenemesek de bu Ziyaretçiler nereden çıktı, ne istiyorlar... BİR DÜŞÜNSENE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006403
    m_Localized: 'Miner: Aşağı bir indik mi, hepsini öğrenebiliriz. Kendim inerdim ama... Birinin halatı tutması lazım, ANLADIN?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006404
    m_Localized: 'Miner: Sen pek ağır kaldırabilecek gibi durmuyorsun ama ben seni kolay çekerim. Sen in bir bak, ben de... burada bekleyeyim. Ne dersin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006405
    m_Localized: 'Miner: HA, SEN MİYDİN? Korkup kaçtın sandım. Bir sıkıntı var ama. Işık garip garip hareketler yapıyor, halat da bir ağırlaştı sanki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006406
    m_Localized: 'Miner: Belki de çok uzun süredir burada beklediğim için hayal gücüm beni kandırıyordur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006407
    m_Localized: 'Miner: Ama bu delik... Dürüstçe söyle, seni kaç kere kendine çekti? Bir cazibesi yok mu SENCE DE? Hadi hadi, itiraf et.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006408
    m_Localized: Dostun hâlâ yaşıyor mu sence?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006409
    m_Localized: Diğeri hâlâ kayıp mı?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006410
    m_Localized: 'Miner: Tabii, tabii. KESİN YAŞIYORDUR. Halat hâlâ gergin, BAKSANA. Demek ki hâlâ aşağıda. Bir sıkıntı olsaydı anlardım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006411
    m_Localized: 'Miner: NEYSE, beklerken vakit öldürürüz biz de. Bu mekânın mantığını çözeriz belki. İtiraf et, sen de merak ediyorsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006412
    m_Localized: Kendin insene
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006413
    m_Localized: Ya aşağıda ne olduğunu hiç öğrenemezsek?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006414
    m_Localized: 'Miner: Hangi diğeri? Bak, birimizin harekete geçmesi lazım. Öyle sonsuza dek boş boş oturamayız. Ya şimdi ya hiç.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006415
    m_Localized: 'Miner: Sen de o çekimi hissetmiyor musun? Delik âdeta bizi çağırıyor. Onu duyuyorsun, DEĞİL Mİ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006416
    m_Localized: Kendin insene
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006417
    m_Localized: Ya aşağıda ne olduğunu hiç öğrenemezsek?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006418
    m_Localized: 'Miner: Aşağı ben inersem beni yukarı kim çekecek? HA? Yanlış anlama ama senden daha kaslı fareler gördüm. Sen in, ben burada kalırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006419
    m_Localized: 'Miner: Seni tek elle bile yukarı çekerim ben ama ben inersem beni kim çekecek? Mantıksız olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006420
    m_Localized: 'Miner: Aşağıda ne olduğunu merak ediyorsun, değil mi? Sen korkak değilsin, belli. Üç kere buraya indin sonuçta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006421
    m_Localized: 'Miner: HADİ, HADİ. Biraz cesur ol. Sen aşağı in, BEN SENİ ÇEKERİM.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006422
    m_Localized: 'Miner: Tüm hayatını "Ya inseydim?" diye pişman olarak mı geçirmek istiyorsun yoksa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006423
    m_Localized: 'Miner: EE? Daha ne bekliyorsun? Oturmaya mı geldik?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006424
    m_Localized: 'Miner: Ne demek hiç öğrenemezsek, DALGA MI GEÇİYORSUN SEN? Bu basit bir delik değil. Sen de hissediyorsun, biliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006425
    m_Localized: 'Miner: Ya aşağıda her şeyi değiştirecek bir şey varsa? Ya tüm soruların cevabını bulur, ülkenin kahramanı olursan?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006426
    m_Localized: 'Miner: Çekip gidecek misin böyle? Hiçbir şey olmamış gibi hayatına devam mı edeceksin? HADİ, İN AŞAĞI. Birlikte çözelim şu işi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006427
    m_Localized: 'Vigilante: Herkesten uzak duruyorsun demek...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006428
    m_Localized: 'Vigilante: Güzel. Hayatta kalma ihtimalini artırır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006429
    m_Localized: 'Vigilante: Ziyaretçi değilsen tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006430
    m_Localized: Kimsin sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006431
    m_Localized: Sen niye dışarıdasın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006432
    m_Localized: 'Vigilante: Çöp toplamaya gelen biriyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006433
    m_Localized: 'Vigilante: Kendi mahallemi hallettim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006434
    m_Localized: 'Vigilante: Bana dair başka bir bilgiye ihtiyacın yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006435
    m_Localized: Ee, elindeki de süpürgen mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006436
    m_Localized: O boynundaki ne? Ziyaretçileri böyle mi savacaksın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006437
    m_Localized: 'Vigilante: Oyun oynamıyoruz burada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006438
    m_Localized: 'Vigilante: Bazıları Ziyaretçilere acıyor. Neymiş efendim, iyileşebilirlermiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006439
    m_Localized: 'Vigilante: Kaldıkları evde en fazla iki gün dayanabiliyorlar, sonra herkesi öldürüyorlar. İşleri bitince diğer evlere geçiyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006440
    m_Localized: 'Vigilante: Sıfır adalet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006441
    m_Localized: 'Vigilante: Ben saklanmıyorum. Adalet BEN oldum, ben. Düzeni ben sağlarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006442
    m_Localized: Ee, elindeki de süpürgen mi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006443
    m_Localized: O boynundaki ne? Ziyaretçileri böyle mi savacaksın?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006444
    m_Localized: 'Vigilante: Heh, öyle de denebilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006445
    m_Localized: 'Vigilante: Aynen, süpürgem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006446
    m_Localized: 'Vigilante: Elimle de toplayabilirdim ama böylesi daha kolay oluyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006447
    m_Localized: 'Vigilante: En kolay yolu ne, biliyor musun? Hepsini bir evde toplayıp ateşe vereceksin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006448
    m_Localized: 'Vigilante: Ziyaretçilere acıyanların Ziyaretçilerden bir farkı yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006449
    m_Localized: Peki burada ne arıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006450
    m_Localized: Ne kadar süre "çöp toplamayı" düşünüyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006451
    m_Localized: 'Vigilante: Savmak derken? Ha, kolyemi mi soruyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006452
    m_Localized: 'Vigilante: Heh, güzel kelimeymiş. Ben de artık öyle diyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006453
    m_Localized: 'Vigilante: Bu sadece bir hatırlatma. Kaç evi, kaç kasabayı arındırdığımı unutmamam için.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006454
    m_Localized: 'Vigilante: Her Ziyaretçi''den bir diş alıyorum. Alması en kolay yadigâr bu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006455
    m_Localized: 'Vigilante: Aklımda kalan bir Ziyaretçi olursa... başka bir şeyini de aldığım oluyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006456
    m_Localized: Peki burada ne arıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006457
    m_Localized: Ne kadar süre "çöp toplamayı" düşünüyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006458
    m_Localized: 'Vigilante: Dur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006459
    m_Localized: 'Vigilante: Sen sorularını sordun. Sıra bende.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006460
    m_Localized: 'Vigilante: Bu mahallede bir yaramazlık var mı? Dikkat etmem gereken bir tehlike var mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006461
    m_Localized: Yarı çıplak bir Ziyaretçi koca bir birliği paramparça etti
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006462
    m_Localized: Ziyaretçiler kapıma gelip duruyor ama benim de silahım var
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006463
    m_Localized: FEMA insanları alıp götürüyor. Geri getirecekler mi, hiç bilmiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006464
    m_Localized: 'Vigilante: Bir tane mi sadece? Yarı çıplak...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006465
    m_Localized: 'Vigilante: Koruyucu bir zırhı yoktu yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006466
    m_Localized: 'Vigilante: Enteresan... Onu kendi gözlerinle mi gördün?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006467
    m_Localized: 'Vigilante: Görmüşsün, görmüşsün. Belli. Söylenti yayacak birine benzemiyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006468
    m_Localized: 'Vigilante: Dikkatimi çektin. Buraya geri geleceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006469
    m_Localized: 'Vigilante: Demek sen de düzeni sağlamaya çalışıyorsun. Güzel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200512
    m_Localized: 'Vigilante: Fakat sana güvenmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200513
    m_Localized: 'Vigilante: Bu işi kendi bildiğim gibi halletmem gerekiyor. Halledeceğim de.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200514
    m_Localized: 'Vigilante: Sen iyice dinlen. Tekrar konuşacağız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200515
    m_Localized: 'Vigilante: Ne yaptıklarını biliyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200516
    m_Localized: 'Vigilante: Ziyaretçi belirtilerini tespit etmek için kendi yöntemleri var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200517
    m_Localized: 'Vigilante: Fakat onların konusunu açman... şüphe uyandırıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200518
    m_Localized: 'Vigilante: Kontrol etmem gereken biri var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200519
    m_Localized: 'Vigilante: Sonra tekrar geleceğim. İlgimi çektin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200520
    m_Localized: 'Vigilante: Geri geldim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200521
    m_Localized: 'Vigilante: O bahsettiğim adamı bulmaya çalıştım ama bulamadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200522
    m_Localized: 'Vigilante: Birkaç eve baktım o sırada. Burası Ziyaretçi kaynıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200523
    m_Localized: 'Vigilante: FEMA bu şehri komple mi saldı yoksa sadece bu mahalleyi mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200524
    m_Localized: Sen Ziyaretçileri nasıl tespit ediyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200525
    m_Localized: Sadece bir iki belirti görürsen ne yapıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200526
    m_Localized: 'Vigilante: Sen nasıl tespit ediyorsan ben de öyle ediyorum muhtemelen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200527
    m_Localized: 'Vigilante: Televizyonda, radyoda anlatıyorlar zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200528
    m_Localized: 'Vigilante: Bir belirti gördün mü, kâfi. Bir saniye bile tereddüt etmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200529
    m_Localized: 'Vigilante: Hazır gelmişken sorayım... Mavi kot ceket giyen tıknaz bir adamla karşılaştın mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200530
    m_Localized: 'Vigilante: Çocuğu da var. Minik bir kız. Kaç yaşında bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200531
    m_Localized: 'Vigilante: Karısı... Karısını siktir et.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200532
    m_Localized: Evi yandı, bir daha da görmedim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200533
    m_Localized: Sadece kız hayatta kaldı. Sorduğun adam öldü
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200534
    m_Localized: 'Vigilante: En kısa sürede adaleti yerine getiriyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200535
    m_Localized: 'Vigilante: Ziyaretçiler, yufka yüreklilerin zafiyetinden faydalanıyor. Millet böyle kendi evinde ölüyor işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200536
    m_Localized: 'Vigilante: Hazır gelmişken sorayım... Mavi kot ceket giyen tıknaz bir adamla karşılaştın mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200537
    m_Localized: 'Vigilante: Çocuğu da var. Minik bir kız. Kaç yaşında bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200538
    m_Localized: 'Vigilante: Karısı... Karısını siktir et.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200539
    m_Localized: Evi yandı, bir daha da görmedim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200540
    m_Localized: Sadece kız hayatta kaldı. Sorduğun adam öldü
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200541
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200542
    m_Localized: 'Vigilante: Hım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200543
    m_Localized: 'Vigilante: Onlardan biri olmadığını bana kanıtla. Herhangi bir kısmını göstersen olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200544
    m_Localized: 'Vigilante: Silahın mı var? Sikimde değil. Birbirimizi gebertiriz o zaman.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200545
    m_Localized: (Dişlerini göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200546
    m_Localized: (Ellerini göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200547
    m_Localized: (Gözlerini göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200548
    m_Localized: (Koltuk altını göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200549
    m_Localized: (Fotoğrafını göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200550
    m_Localized: (Kulaklarını göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200551
    m_Localized: 'Vigilante: İyice aç. Hadi hadi, korkacak bir şey yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200552
    m_Localized: 'Vigilante: Hım... Temiz. Yazık oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200553
    m_Localized: 'Vigilante: İyi o zaman. Seni öldürmeyeceğim. Şimdilik. Ama tek bir hatanı gördüm mü, kafana sıkarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200554
    m_Localized: 'Vigilante: Hay sikeyim, buna harcayacak vaktim yok... Kontrol etmem gereken bir şey var. Görüşürüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200555
    m_Localized: 'Vigilante: Temiz... Temiz tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200556
    m_Localized: 'Vigilante: Bu dediğimi iyi dinle, kulağına küpe olsun: Normal görünenler daima ilk dönüşenler oluyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200557
    m_Localized: 'Vigilante: Bu zırvalıklara harcayacağım vaktim yok. Bir dahakine seni adam gibi test edeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200558
    m_Localized: 'Vigilante: Hadi hadi, parmaklarını kullan. İYİCE aç.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200559
    m_Localized: 'Vigilante: Heh... Hiç belirtin yok demek. Harika amına koyayım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200560
    m_Localized: 'Vigilante: Tek bir "normal" Ziyaretçi''nin bir gecede neler yapabileceğinin farkında mısın sen? Tek bir hatanı gördü mü, herkesi öldürür.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200561
    m_Localized: 'Vigilante: Şimdilik kurtuldun ama tek bir hatanı gördüm mü, kafana sıkarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200562
    m_Localized: 'Vigilante: Henüz değil ama. Daha büyük dertlerim var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200563
    m_Localized: 'Vigilante: Hıh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200564
    m_Localized: 'Vigilante: Temiz gibisin ama bunun hiçbir önemi yok. Bu ucubeler çok iyi rol yapabiliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200565
    m_Localized: 'Vigilante: Hiçbir belirtin yok, şanslısın. Şimdi çek şu koltuk altlarını suratımın dibinden. Daha büyük dertlerim var benim. Geri döneceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200566
    m_Localized: 'Vigilante: Fotoğraf mı? Auranı mı göstereceksin? Peki o zaman, bakalım ne kadar "temizsin".'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200567
    m_Localized: 'Vigilante: Hıh... Evet, temiz görünüyor ama bir sürü temiz görünen insanı mezara gömdüm. Öyle kolay kolay inanmam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200568
    m_Localized: 'Vigilante: Neyse, bu fotoğraf sikimde değil zaten. Başka işim gücüm var. Şimdilik seni öldürmeyeceğim. Asıl testi sonra yapacağız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200569
    m_Localized: 'Vigilante: Kulak mı? Sen salak yerine mi koyuyorsun beni?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200570
    m_Localized: 'Vigilante: Kardeşim olmasaydı var ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200571
    m_Localized: 'Vigilante: Bir daha bana kulağını göstermeye kalkışırsan kafana sıkarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200572
    m_Localized: 'Vigilante: Neyse, siktir et. Daha büyük dertlerim var benim. Sonra döneceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200573
    m_Localized: 'Vigilante: Geri geldim. Niye geldim, bilmiyorum açıkçası.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200574
    m_Localized: 'Vigilante: Kardeşim bu kadar omurgasız olmasaydı karısını ve çocuğunu kurtarabilirdi belki. Şimdi kim bilir nerelerde bücürük.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200575
    m_Localized: Nasıl gidiyor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200576
    m_Localized: Onu bulmak mı istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200577
    m_Localized: 'Vigilante: Bildiğin gibi. Kardeşime söyledim hatta. "Adam ol, ailene göz kulak ol," dedim. O gitti ne yaptı?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200578
    m_Localized: 'Vigilante: Korkağın teki gibi pes etti. Bu yüzden ailesi ya toprağa gömüldü ya da paramparça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200579
    m_Localized: 'Vigilante: Dünya nasıl bu hâle geldi sanıyorsun? Onun gibi korkaklar yüzünden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200580
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200581
    m_Localized: 'Vigilante: Yakın zamanda bir aile gördüm. Baba bodur biriydi. Ziyaretçiler çığlık atarak pencerelerine vurduğunda bile sakindi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200582
    m_Localized: 'Vigilante: Ailesini arka kapıdan götürdü, ormana doğru kaçtılar. Ben de ucubeleri indirdim ama bir daha geri dönmediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200583
    m_Localized: 'Vigilante: Öldüler sanmıştım ama birkaç gün sonra beni buldular. Karşıma ilk kim çıkmıştır dersin? Küçük kızları, elinde de bir pompalı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200584
    m_Localized: 'Vigilante: Gözü dönmüştü ama hâlâ yaşıyordu. Saygı duyarım. Kardeşim hiç öyle değildi. Daha erken geberseydi belki ailesi kurtulurdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200585
    m_Localized: 'Vigilante: Neyse, yeterince hikâye anlattım. Seni test edeceğim. Bana onlardan biri olmadığını kanıtla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200586
    m_Localized: (Dişlerini göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200587
    m_Localized: (Ellerini göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200588
    m_Localized: (Gözlerini göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200589
    m_Localized: (Koltuk altını göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200590
    m_Localized: (Fotoğrafını göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200591
    m_Localized: (Kulaklarını göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200592
    m_Localized: 'Vigilante: Aramanın bir lüzumu yok. Kardeşim omurgasız olmasaydı belki bir ihtimal olurdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200593
    m_Localized: 'Vigilante: Şu saatten sonra umurumda değil. Beni aşar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200594
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200595
    m_Localized: 'Vigilante: Şehrin ucunda yaşayan bir aile vardı. Tüm pencereler tahtayla kapatılmıştı, baba kapıyı tutuyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200596
    m_Localized: 'Vigilante: Fakat karısı... belirti gösteriyordu. Adam bana yalvarıp durdu. "Karım o benim, ona zarar verme!"'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200597
    m_Localized: 'Vigilante: Ziyaretçiler çatıya tırmanmaya başlayınca kapıyı açtı aptal. Karısının kaçmasına izin verdi. Ben de onun yapamadığını yaptım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200598
    m_Localized: 'Vigilante: Önce onu vurdum, sonra da kocasını. Çocuklar komşularla bir şekilde kaçtı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200599
    m_Localized: 'Vigilante: Sonra FEMA "temizlik" yapmaya geldi ama ben gerek olmadığını söyledim. Zaten halletmiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200600
    m_Localized: 'Vigilante: Kahkaha atıp FEMA''ya başvurmamı söylediler ama sikerler. Onlar anca milleti evinden sürükler, Ziyaretçilerden kurtulamazlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200601
    m_Localized: 'Vigilante: Neyse, yeterince sohbet ettik. Seni test edeceğim. Bana onlardan biri olmadığını kanıtla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200602
    m_Localized: (Dişlerini göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200603
    m_Localized: (Ellerini göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200604
    m_Localized: (Gözlerini göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200605
    m_Localized: (Koltuk altını göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200606
    m_Localized: (Fotoğrafını göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200607
    m_Localized: (Kulaklarını göster)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200608
    m_Localized: 'Vigilante: İyice aç şu ağzını. Aç hadi, aç. Dişçide misin lan sanki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200609
    m_Localized: 'Vigilante: Pekâlâ, temiz duruyor ama açıkçası öyle durmasaydı daha kolay olurdu. İşimiz uzamazdı.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200610
    m_Localized: 'Vigilante: Hemen götün kalkmasın. Tek bir yanlışını gördüm mü, işin biter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200611
    m_Localized: 'Vigilante: Yeterince konuştuk. Burada boşa vakit harcıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200612
    m_Localized: 'Vigilante: Ee hadi, hareket ettir. Merak etme, ısırmam. Gerekmediği sürece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200613
    m_Localized: 'Vigilante: Hıh... Temiz, kirli bana hiç fark etmiyor. Ziyaretçiler bir şekilde uyum sağlıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200614
    m_Localized: 'Vigilante: Buna harcayacak vaktim yok şu an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200615
    m_Localized: 'Vigilante: İyice aç şu gözlerini. Tepemi attırma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200616
    m_Localized: 'Vigilante: Pekâlâ. Yine de tamamen emin değilim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200617
    m_Localized: 'Vigilante: Hım... Şimdilik seni bırakıyorum. Buna harcayacak vaktim yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200619
    m_Localized: 'Vigilante: Taşak mı geçiyorsun lan sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200620
    m_Localized: 'Vigilante: Bir hastalık falan görmeyeyim sakın.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200621
    m_Localized: 'Vigilante: Siktir lan, koltuk altını koklamam ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200622
    m_Localized: 'Vigilante: Yine mi bu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200623
    m_Localized: 'Vigilante: İyi duruyor ama mezara gömdüğüm hainlerin yarısı iyi duruyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200624
    m_Localized: 'Vigilante: Açıkçası fotoğrafın gram sikimde değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200626
    m_Localized: 'FatalDame: Yeni hayatına alışabildin mi bebeğim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200627
    m_Localized: 'FatalDame: Uyum sağlayabildin mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200628
    m_Localized: 'FatalDame: Kusura bakma, saçma bir soru oldu. Burası senin evin sonuçta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200629
    m_Localized: Biraz... garip duruyorsun
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200630
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200631
    m_Localized: 'FatalDame: Fark ettin demek. Sağ ol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200632
    m_Localized: 'FatalDame: Hoşuna mı gitti bebeğim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200633
    m_Localized: 'FatalDame: İnsanlar son zamanlarda dış görünüşüme yorum yapıp duruyor. Eskiden bu kadar değildi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200634
    m_Localized: 'FatalDame: Sen pek konuşkan biri değilsin galiba? Hadi kendini anlat bana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200635
    m_Localized: İstemiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200636
    m_Localized: Eskiden babam gebersin diye dua ederdim. Yeterli mi senin için?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200637
    m_Localized: Sosyal yeteneklerim hep zayıftı, değişeceği de yok
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200638
    m_Localized: 'FatalDame: Beni kırıyorsun ama!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200639
    m_Localized: 'FatalDame: Bir sıkıntın mı var? Karın mı terk etti yoksa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200640
    m_Localized: 'FatalDame: Ziyaretçiler bir yakınını öldürmüş de olabilir, sen de dış dünyaya kendini kapatmışsındır...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200641
    m_Localized: 'FatalDame: Yoksa çocukluğun yüzünden mi? Zor bir dönemden geçmişsindir muhtemelen. Birden anıların mı depreşti? Zavallı seni...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200642
    m_Localized: 'FatalDame: Konuş benimle bebeğim. Kapını çalan bir yabancıyım sadece. Belki bir daha asla görüşmeyiz bile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200643
    m_Localized: İstemiyorum
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200644
    m_Localized: Eskiden babam gebersin diye dua ederdim. Yeterli mi senin için?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200645
    m_Localized: Sosyal yeteneklerim hep zayıftı, değişeceği de yok
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200646
    m_Localized: 'FatalDame: Belki içini dökmek iyi gelir...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200647
    m_Localized: 'FatalDame: ...ama seni zorlamayacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200648
    m_Localized: 'FatalDame: Hım...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200649
    m_Localized: 'FatalDame: Sana çoğu insanın teklif edemeyeceği bir teklif sunacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200650
    m_Localized: 'FatalDame: Bu aralar herkesin kafasında dünyanın sonu var.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200651
    m_Localized: 'FatalDame: Ancak en yalnız insanların bile... özel muameleye ihtiyacı vardır.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200652
    m_Localized: 'FatalDame: Beni içeri alırsan sana bu muameleyi gösterebilirim. Güzel şeyler hissettiririm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200653
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200654
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200655
    m_Localized: 'FatalDame: Baban sizi hor mu görüyordu yoksa? Yazık. Neyse ki geçmişte kalmış.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200656
    m_Localized: 'FatalDame: Öfkeyi terk etmek kolay iş değildir. Affetmek daha da zordur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200657
    m_Localized: 'FatalDame: Ben de aynı yoldan geçtim bebeğim. İstersen konuşuruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200658
    m_Localized: 'FatalDame: Bir de...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200659
    m_Localized: 'FatalDame: Beni içeri alırsan belki acını dindirebiliriz. Birlikte iyileşiriz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200660
    m_Localized: 'FatalDame: Bu aralar herkesin biraz rahatlamaya ihtiyacı var. Biraz şefkate... ve sevgiye.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200661
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200662
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200663
    m_Localized: 'FatalDame: Seni çok iyi anlıyorum. İnsanlar hemen sidik yarışına giriyor, bu yüzden senin de anlatasın gelmiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200664
    m_Localized: 'FatalDame: İnsanlarla bağ kurmak kolay bir şey değil. Bu konuda zorlanan tek kişi sen değilsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200665
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200666
    m_Localized: 'FatalDame: İstersen sana yardımcı olurum bebeğim. Birlikte üzerinde çalışırız.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200667
    m_Localized: 'FatalDame: Onun yerine... başka bir şekilde bağlanmayı da deneyebiliriz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200668
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200669
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200670
    m_Localized: 'FatalDame: Gel, bu dünyanın sanrılarından birlikte kaçalım. Sadece sen ve ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200671
    m_Localized: 'FatalDame: Dikkatimizi dağıtacak daha... güzel faaliyetler var. Dehşete düşmekten, kendine acımaktan daha iyi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200672
    m_Localized: 'FatalDame: Farklı bir cevap beklemiyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200673
    m_Localized: 'FatalDame: Dünyanın sonunu yalnız başına daha kolay atlatacağını mı sanıyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200674
    m_Localized: 'FatalDame: O öyle düşünmüyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633026
    m_Localized: 'BigLebowski: Aynı babam gibisin ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633027
    m_Localized: 'BigLebowski: Yürü git...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633028
    m_Localized: 'BigLebowski: Off, neyse ya. Odayı dolu gösteren yeri {0} kapmış zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633029
    m_Localized: 'BigLebowski: İstediğim yerde kalamazsam giderim ben bu akşam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633030
    m_Localized: 'BigLebowski: Aa, kafiyeli oldu. İyiymiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633031
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633032
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633033
    m_Localized: 'BigLebowski: Süper!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633034
    m_Localized: 'BigLebowski: Poff... Neyse ne ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633035
    m_Localized: 'BigLebowski: Vaktimi boşa harcamışım...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077071142912
    m_Localized: 'Theorist: Şahane!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114432
    m_Localized: 'Theorist: Ama bir saniye... O da kim?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114433
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114434
    m_Localized: 'Theorist: Olamaz, olamaz. Kesinlikle olamaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114435
    m_Localized: 'Theorist: Bu... Bu... O {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114436
    m_Localized: 'Theorist: Onun kaldığı evde hiçbir bilgiyi ifşa etmem ben!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114437
    m_Localized: 'Theorist: Onu evden atarsan gelirim ama!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114438
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114439
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114440
    m_Localized: 'Theorist: Doğru kararı vermene sevindim! Güven bana, pişman olmayacaksın.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114441
    m_Localized: 'Theorist: Benimle konuştuktan sonra dünyayı bir daha aynı gözle göremeyeceksin!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114442
    m_Localized: 'Theorist: Ne demek "gitsem iyi olur"?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114443
    m_Localized: 'Theorist: Sen... Sen...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114444
    m_Localized: 'Theorist: Yalnızca dar görüşlüler, gerçeği bu kadar kolay bir şekilde geri çevirebilir!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114445
    m_Localized: 'Theorist: Elveda! Sen çok yaşamazsın zaten!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114446
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114447
    m_Localized: 'Wifefema: O {0} ne arıyor burada?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114448
    m_Localized: 'Wifefema: Ben bunların niyetini biliyorum. Keşke hiç almasaydın. Böyle insanlardan hayır gelmez şekerim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114449
    m_Localized: 'Wifefema: Çok geç olmadan onu evden kov!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114450
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114451
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114452
    m_Localized: 'Wifefema: Beleşçiler hepsi... Çekil yolumdan!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114453
    m_Localized: 'Wifefema: Sen ciddi misin? Kocam FEMA''da çalışıyor benim!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114454
    m_Localized: 'Wifefema: Kafayı mı yedin sen? Sana burada içimi döktüm, insan biraz anlayış gösterir!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114455
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114456
    m_Localized: 'Wifefema: Siktir git be. Komşularınla konuşurum ben. Alçak herif...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114457
    m_Localized: 'Raskolnikov: Ay, of... Kabalık etmem istemem ama {0} bu evdeyken olmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114458
    m_Localized: 'Raskolnikov: Ben böyle insanlarla bir arada kalamıyorum. Denedim, olmuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114459
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114460
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114461
    m_Localized: 'Raskolnikov: Teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114462
    m_Localized: 'Raskolnikov: Bir de şey soracaktım... Zahmet olmazsa beni test ettikten sonra...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114463
    m_Localized: 'Raskolnikov: Bunu nasıl yaptığını gösterir misin bana? Ziyaretçileri nasıl öldürdüğünü yani. Korkularımla yüzleşmek istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114464
    m_Localized: 'Raskolnikov: Ay... Seni böyle zor bir duruma sokmak istememiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114465
    m_Localized: 'Raskolnikov: Herhâlde senin için önemli biri. Kusura bakma, vaktini boşa harcadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114466
    m_Localized: 'Raskolnikov: Umarım... Umarım bir gün kendimi savunmayı öğrenirim. İnsanları öldürmeyi...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503040
    m_Localized: 'Nun: O da kim yahu? O imansız {0} değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503041
    m_Localized: 'Nun: Kırk fırın ekmek yese günahlarından arınamaz o! Böyle insanlarla kaldığına göre pek sağduyulu biri değilsin!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503042
    m_Localized: 'Nun: Onu evinden kovarsan seni kutsayacağım evlat!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503043
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503044
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503045
    m_Localized: 'Nun: Şükürler olsun...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503046
    m_Localized: 'Nun: Tanrım, sen bize merhamet et! Günahlarından arınma fırsatını nasıl geri çevirebilirsin? Utan!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503047
    m_Localized: 'Nun: Ben öldükten sonra vicdan azabından gözüne uyku girmez umarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503048
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503049
    m_Localized: 'Nun: Cennetin kapılarına geldiğinde Yaradan bunu unutmayacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503050
    m_Localized: 'Fugitive: Olmaz... Dinle bak, ben böyle insanları iyi bilirim. {0} onlardan biri, onu evine almışsın bir de.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503051
    m_Localized: 'Fugitive: Sessiz görünür, kendi hâlindedir... ama sonra hiç tereddüt etmeden sana ihanet eder.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503052
    m_Localized: 'Fugitive: Söylüyorum bak, bunlar seni göz açıp kapayıncaya kadar satar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503053
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503054
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503055
    m_Localized: 'Fugitive: Hayatımı kurtardın be!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503056
    m_Localized: 'Fugitive: Umarım komşuların da şerefsiz değildir...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503057
    m_Localized: 'Fugitive: Sen dalga mı geçiyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503058
    m_Localized: 'Fugitive: Ne oldu, FEMA''nın beni aramaya geleceğinden mi korktun? Siktiğimin ödleği...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503059
    m_Localized: 'Fugitive: Tamam ulan. Kapının arkasında saklan bakalım. Gör bak ne oluyor sonra.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503060
    m_Localized: 'Fugitive: İyi geceler piç herif.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503061
    m_Localized: 'Bestson: Gördüğüm kadarıyla {0} koltukta oturuyor. Onun gibi insanlar... beni çok korkutuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503062
    m_Localized: 'Bestson: Bir keresinde böyle biri parkta bana saldırmıştı. Bir daha da gitmedim oraya!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503063
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503064
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503065
    m_Localized: 'Bestson: Teşekkür ederim! Yine insan endişelenmeden edemiyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503066
    m_Localized: 'Bestson: Ya annemler geri döner de beni evde bulamazlarsa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503067
    m_Localized: 'Bestson: Gerçi... şimdilik seninle kalayım en iyisi. Daha güvenli olur gibi geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503068
    m_Localized: 'Bestson: Evet, haklısın... Ben eve döneyim en iyisi, belki geri gelirler...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503069
    m_Localized: 'Buddy: Ohooo kanka... Biri senin koltuğu ısıtıyor zaten, bakıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503070
    m_Localized: 'Buddy: Ben paylaşmayı seven biriyimdir ama burası da çok kalabalık yani. Biraz yer mi açsan?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503071
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503072
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503073
    m_Localized: 'Buddy: Sağ olasın kanka! Hayatımı kurtardın!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697344
    m_Localized: 'Fatman: Cık cık, o içerideki... {0} değil mi? Olmaz, olmaz! Küvet için kimseyle kavgaya giremem!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697345
    m_Localized: 'Fatman: En iyisi ben sana şöyle... güzel bir şeyler ayarlayayım da hallet şu işi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697346
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697347
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697348
    m_Localized: 'Fatman: Güzel, güzel. Doğru kararı verdin.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697349
    m_Localized: 'Fatman: Şu mevzu bir hallolsun... karşılığını vereceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697350
    m_Localized: 'Fatman: Pardon? Karşında sadece hasta bir adam yok, bir bakan var!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697351
    m_Localized: 'Fatman: Ne halt yiyeceğim ben şimdi, ha? Boku yedim! Sıçtım ben!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697352
    m_Localized: 'Blind: O {0} burada, sezebiliyorum. O... normal birisi değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697353
    m_Localized: 'Blind: Kusura bakma, tam açıklayamıyorum ama... Bir derdi olduğundan eminim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697354
    m_Localized: 'Blind: Ben en iyisi başka bir yer bulayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697355
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697356
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697357
    m_Localized: 'Blind: Teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697358
    m_Localized: 'Blind: Gideceğim ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697359
    m_Localized: 'Blind: Sen kendi iyiliğin için yanmış cesetlere gece vakti yaklaşma.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697360
    m_Localized: 'Blind: Yoksa O senin de peşine düşer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697361
    m_Localized: 'Dude: Kankaaaaa, dur bi''...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697362
    m_Localized: 'Dude: O {0} değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697363
    m_Localized: 'Dude: Böyle olmaz ki kanka. Ortamın havasını bozuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697364
    m_Localized: 'Dude: Yok yok, onun gitmesi lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697365
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697366
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697367
    m_Localized: 'Dude: Beni anlayacağını biliyordum kanka!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697368
    m_Localized: 'Dude: Ooooff...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697369
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697370
    m_Localized: 'Dude: Sorun değil be kanka. Olur öyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697371
    m_Localized: 'Dude: Kendine iyi bak moruk. Agalarına da aynı şekilde.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697372
    m_Localized: 'Teacher: Kusura bakma da... o {0} değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697373
    m_Localized: 'Teacher: Ben öyle birisiyle aynı çatı altında yaşayamam.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697374
    m_Localized: 'Teacher: Bana... şeyi hatırlatıyorlar... Çocukları... Çocukları...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697375
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697376
    m_Localized: 'Teacher: Kusura bakma...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697377
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697378
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697379
    m_Localized: 'Teacher: Teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891648
    m_Localized: 'Ballerina: O {0} burada?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891649
    m_Localized: 'Ballerina: Hım... O burada olmamalı. Hadi, onu gittir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891650
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891651
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891652
    m_Localized: 'Ballerina: Hadi kedicik. Beni eğlendir, tamam?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891653
    m_Localized: 'Ballerina: Sen tüylüyü gördü? Sen değil koca salak.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891654
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891655
    m_Localized: 'Ballerina: Sen tüylüyü gördü? Sen kötü karar verdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891656
    m_Localized: 'Mother: Hım... O {0} burada bakıyorum. Evladım zaten yeterince korkmuyormuş gibi...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891657
    m_Localized: 'Mother: Onu şey mi yapsan... Bilemedim... Kovsan mı? Benim şu çocuk artık düzgün bir uyuyabilsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891658
    m_Localized: Onu kovarım, siz gelin
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891659
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891660
    m_Localized: 'Mother: Nihayet...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891661
    m_Localized: 'Mother: Hadi hadi, dikilme şurada. Gir içeri. Beyefendiyi bekletmeyelim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891662
    m_Localized: 'Mother: Pekâlâ. Hadi çocuğum... Senin o geri zekâlı babanın evine gidebiliriz belki.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891663
    m_Localized: 'Mother: Çok geç kalmadıysak tabii...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891664
    m_Localized: 'Mother: Yok, yok... Hâlâ yetişebiliriz...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891665
    m_Localized: 'Anger: O {0} ne arıyor lan burada?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891666
    m_Localized: 'Anger: Hayatta olmaz. Ben o ucubeyle aynı evde yaşamam. Kafayı yerim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891667
    m_Localized: 'Anger: Merak etme, sinirimi başkasından çıkarmayacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891668
    m_Localized: 'Anger: Evi başına da yıkmayacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891669
    m_Localized: 'Anger: Sadece kendi canımı yakarım. Kimseye zarar vermem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891670
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891671
    m_Localized: 'Anger: Senin de o yüreksiz piçlerden bir farkın yokmuş.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891672
    m_Localized: 'Anger: Koyun gibi güdüyorlar sizi, haberiniz bile yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891673
    m_Localized: 'Anger: Hay anasının!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891674
    m_Localized: 'Couple: Sana ne kadar teşekkür etsek azdır.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891675
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891676
    m_Localized: 'Couple: Bir saniye, o kim?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891677
    m_Localized: 'Couple: Zorluk çıkarmak istemem ama... {0} varken burada kalamayız.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891678
    m_Localized: 'Couple: Karım çocukları pek sevmez, ondan yani. O kadar genç birini burada görmeyi beklemiyorduk.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891679
    m_Localized: Onu kovarım, siz gelin
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891680
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891681
    m_Localized: 'Couple: Teşekkür ederiz, çok teşekkür ederiz!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891682
    m_Localized: 'Couple: Boş boş durmasana hayatım. Baksana, adam bizi evine davet ediyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891683
    m_Localized: 'Couple: Sen de amma utangaçsın ha! Neyse, sorun değil. Biraz dinlendin mi kendine gelirsin güzelim!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891684
    m_Localized: 'Couple: Anlaşıldı. Kusura bakma, seni de rahatsız ettik.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891685
    m_Localized: 'Couple: Aramaya devam ederiz biz, değil mi tatlım?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891686
    m_Localized: 'Couple: Hadi hadi, aylaklık yapma. Ben de yorgunum!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891687
    m_Localized: 'Luka: İçeri gelmeyi çok isterdim ama {0} yerimi almış.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891688
    m_Localized: 'Luka: Kimseyi evden atmanı istemem tabii. Kim bilir, belki benden daha fazla ihtiyacı vardır.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891689
    m_Localized: 'Luka: Yine de benim için biraz yer ayırabilirsen harika olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891690
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891691
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891692
    m_Localized: 'Luka: Sağ ol.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891693
    m_Localized: 'Luka: Umarım neşeli hissetmenin nasıl bir şey olduğunu hatırlarsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891694
    m_Localized: 'Luka: Belki de o zaman düşündüğün tek şey ölüm olmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891695
    m_Localized: 'Luka: Yas tutacağım diye kendini boğma.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891696
    m_Localized: 'Luka: Buna fazla odaklanırsan seni canlı canlı yer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891697
    m_Localized: 'Luka: O noktaya ulaştın mı, geri dönüşü yoktur.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891698
    m_Localized: 'Luka: Kendine iyi bak, tamam mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085952
    m_Localized: 'FortuneTeller: Aaa... Çok yoğun, baskıcı bir enerji hissediyorum. Tüm evi zehirleyecek kadar güçlü bir gölge! Felakeeeet!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085953
    m_Localized: 'FortuneTeller: Bir şey görüyorum... {0} diye biri. Tanıdık geldi mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085954
    m_Localized: 'FortuneTeller: Ondan kurtulmamız lazım yoksa yıldızlar bize küser. Anladın mı beni?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085955
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085956
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085957
    m_Localized: 'FortuneTeller: Harika... Açıkçası bu evin uzay ve zaman çizelgesindeki metafiziksel konumu, son derece nadir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085958
    m_Localized: 'FortuneTeller: Evinin içinden geçen kuvvetli bir pozitif enerji akımı var.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280256
    m_Localized: 'Fanatic: İnsan! O {0} içeride saklanırken ben buraya girmem. GÜNEŞ BÖYLE BUYURUYOR!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280257
    m_Localized: 'Fanatic: Gölgesi, meşru nuru karartmaya yelteniyor! Derhâl kovmalısın onu! Derhâl!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280258
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280259
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280260
    m_Localized: 'Fanatic: DOĞRU KARARI VERDİN İNSAN! Kutsal hüzmeler, GÖZLERİNİ kutsasın.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280261
    m_Localized: 'Fanatic: Neyse, buzdolabı ne tarafta?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280262
    m_Localized: 'Fanatic: O zaman canın cehenneme!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280263
    m_Localized: 'Fanatic: Yalnızca TOPRAĞIN ALTINDAN ÇIKANLAR ışığa, hatta AYDINLANMAYA kapılarını kapatır!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280264
    m_Localized: 'Fanatic: Parlak irfanımı başkasıyla paylaşırım ben de! Yolun açık olsun sikik herif!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280265
    m_Localized: 'Hunter: Hım... {0} zaten senin evinde evlat.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280266
    m_Localized: 'Hunter: Ellerindeki kanın kokusu ta kapıya kadar geliyor. Niye onu içeri aldın ki? Heyecan peşinde misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280267
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280268
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280269
    m_Localized: 'Hunter: İyi düşündün evlat. Ben bu işlerden anlarım. O yaratık kapına dadanırsa sana yardım ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280270
    m_Localized: 'Anxiety: Orada biri... {0} var.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280271
    m_Localized: 'Anxiety: Ben... Ben onunla kalamam. Ya Ziyaretçi''yse?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280272
    m_Localized: 'Anxiety: Rica etsem onu test eder misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280273
    m_Localized: 'Anxiety: ...ya da kovar mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280274
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280275
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280276
    m_Localized: 'Anxiety: Teşekkür ederim. Ben sessiz sessiz oturacağım. Kapıyı kapatma ama, tamam mı? Ne olur ne olmaz, hehe...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280277
    m_Localized: 'Anxiety: Peki, hehe... Ben gideyim o zaman. Güneş zaten hepimizi öldürecek. Hepimiz öleceğiz...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280278
    m_Localized: 'Esenin: Önce o {0} gitsin, sonra konuşuruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280279
    m_Localized: 'Esenin: Onun gibiler benden bile önce kovuldular bardan.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280280
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280281
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280282
    m_Localized: 'Esenin: İyi bari, bir kere de olsa işim rast gitti. Önden buyur.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280283
    m_Localized: 'Esenin: İyi o zaman, siktir ol git. Sen kesin barda soda söyleyen dangalaklardansındır zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280284
    m_Localized: 'Cold: T-teşekkür ederim. Aa... O {0} buradayken eve giremem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280285
    m_Localized: 'Cold: İnsanlarla aynı odada olmayı sevmiyorum... K-kötü şeyler oluyor h-her seferinde.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280286
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280287
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280288
    m_Localized: 'Cold: T... Teşekkür ederim. Güven bana, böylesi daha güvenli.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280289
    m_Localized: 'Cold: A-anlıyorum. Ben gideyim o zaman.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280290
    m_Localized: 'Cold: Aynen... U... Uzaklara gideyim... Herkesten u... uzağa...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280291
    m_Localized: 'Cold: Belki güneş s... son bir defa içimi ısıtır...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280292
    m_Localized: 'Scammer: Sana bir şey diyeyim mi, o {0} denyonun teki.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280293
    m_Localized: 'Scammer: Ona tekmeyi basarsan okeyiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280294
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280295
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280296
    m_Localized: 'Scammer: Ha şöyle! Vaktin olunca yanıma uğra kesin. Sana neler anlatacağım neler.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280297
    m_Localized: 'Scammer: Belliydi lan böyle olacağı. Sen de denyoymuşsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280298
    m_Localized: 'Scammer: Neyse ne. Evi olan başka adam mı yok sanki. Hadi ben kaçar!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474560
    m_Localized: 'Daughter: Ama... Ama... Bana yer yok!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474561
    m_Localized: 'Daughter: O {0} burada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474562
    m_Localized: 'Daughter: Ben orada oturmak istiyorum! Bana ne, bana ne, bana ne! Babam... Babam orada otururdu...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474563
    m_Localized: 'Daughter: Ben babacığımı özlediiiiimmm...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474564
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474565
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474566
    m_Localized: 'Daughter: BABAAAAA! BABACIĞIIMM!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474567
    m_Localized: 'Daughter: NEREYE GİDEYİMMMM?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474568
    m_Localized: 'Daughter: Başka kimseyi tanımıyorum kiiiiii!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474569
    m_Localized: 'Daughter: ÇOK korkuyoruuumm...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474570
    m_Localized: 'Daughter: HÜÜÜÜÜÜÜÜÜ!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474571
    m_Localized: 'NotTrue: Aman aman, {0} benim yerimde oturuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474572
    m_Localized: 'NotTrue: Böyle insanları yakınında tutarsan pişman olursun evladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474573
    m_Localized: 'NotTrue: İyisi mi ben biraz nefesleneyim de gideyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474574
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474575
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474576
    m_Localized: 'NotTrue: Hay yaşa evladım! Keşke benim için onu kovmak zorunda kalmasaydın...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474577
    m_Localized: 'NotTrue: O zaman bana bir tabure bulabilecek misin, ha kuzum?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474578
    m_Localized: 'NotTrue: Biraz dinlenip yoluma gideyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668866
    m_Localized: 'Doctor: Hım... {0} burada, bakıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668867
    m_Localized: 'Doctor: Onu tedavi edecek imkân elimde yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668868
    m_Localized: 'Doctor: Kendisine yardımcı olabilecek birini bulursa daha iyi olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668869
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668870
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668871
    m_Localized: 'Doctor: Teşekkür ederim. Umarım birine yardımım dokunur.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668872
    m_Localized: 'Doctor: Anlıyorum, insanlara güvenmek artık zor.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668873
    m_Localized: 'Doctor: Ben yakınlarda olacağım. Yardım istemekten lütfen çekinme.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668874
    m_Localized: 'Foreigner: Immmmhh... Pfffttt!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668875
    m_Localized: 'Foreigner: ({0} için pek iyi hisler beslemiyor gibi duruyor. Önce onu, sonra kendisini, sonra tekrar onu işaret ediyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668876
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668877
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668878
    m_Localized: 'Foreigner: (Başıyla onaylayıp içeri giriyor)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668879
    m_Localized: 'Edgar: Gelirdim ama... O {0} zaten burada. Geçmiş yarınların hasretine çaresizce kapılan biri...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668880
    m_Localized: 'Edgar: Ancak ben, buraya şafağın huzur verici sessizliğini dinlemeye geldim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668881
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668882
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668883
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668884
    m_Localized: 'Edgar: Güzelliği sen de benim gibi görebiliyor musun, henüz emin değilim ancak bir sorum var... Cesetleri atmıyorsun, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668885
    m_Localized: 'Edgar: Vakit geldiğinde benimkini muhafaza et.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863168
    m_Localized: 'TaxiDriver: Dayı, yanlış anlama da bu evde bir {0} kalıyor, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863169
    m_Localized: 'TaxiDriver: Bana ailemin peşine düşen piçleri hatırlatıyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863170
    m_Localized: 'TaxiDriver: Seçmen lazım. Ya o ya ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863171
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863172
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863173
    m_Localized: 'TaxiDriver: Sağ olasın dayı. Çok makbule geçti!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863174
    m_Localized: 'TaxiDriver: Bir ara konuşmaya gel ama, tamam mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863175
    m_Localized: 'TaxiDriver: Seni de anlıyorum ama... kötü oldu be dayı...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863176
    m_Localized: 'Provocateur: Hım... Kiracılarından birisini tanıyorum. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863177
    m_Localized: 'Provocateur: Bu bireyin alçak bir suçlu olduğunun farkında mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863178
    m_Localized: 'Provocateur: Anayasanın 28, 48 ve 7.3 numaralı maddeleri hiç mi umurunda değil?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863179
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863180
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863181
    m_Localized: 'Provocateur: En doğru karar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863182
    m_Localized: 'Provocateur: Kiramı sonra detaylıca konuşuruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863183
    m_Localized: 'Marauder: Bak sen, rahat olan yeri başkası almış.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863184
    m_Localized: 'Marauder: Şurası bak, gördün mü? O {0} almış.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863185
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863186
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863187
    m_Localized: 'Marauder: Heh, işte şimdi oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863188
    m_Localized: 'Marauder: Bir kere de şansım yaver gitsin be...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863189
    m_Localized: 'Marauder: Neyse, denemeye değerdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863190
    m_Localized: 'GraveDigger: Aa, {0} zaten burada...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863191
    m_Localized: 'GraveDigger: Yani, gelirdim ama... anlarsın işte...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863192
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863193
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863194
    m_Localized: 'GraveDigger: Aa, sağ ol!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863195
    m_Localized: 'FormerFema: Ne? Ha, sağ ol.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863196
    m_Localized: 'FormerFema: Ama dur bir saniye.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863197
    m_Localized: 'FormerFema: O {0} banyoyu kapmış zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863198
    m_Localized: 'FormerFema: Bak, tüm gündür bu kıyafetle geziyorum. Üstümü çıkarıp üzerimdeki kirleri ve... kan lekelerini yıkamak istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863199
    m_Localized: 'FormerFema: Onu kovarsan söz veriyorum sessiz sakin oturacağım. Kimseyi rahatsız etmeyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863200
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863201
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863202
    m_Localized: 'FormerFema: Cidden mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863203
    m_Localized: 'FormerFema: Beni gerçekten içeri almanı beklemiyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863204
    m_Localized: 'FormerFema: Pekâlâ, anlıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863205
    m_Localized: 'FormerFema: Herhâlde bu kıyafet milleti korkutuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863206
    m_Localized: 'FormerFema: Niye hâlâ giydiğimi de bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863207
    m_Localized: 'FormerFema: Hoşça kal.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863208
    m_Localized: 'Intruder: Gelirdim ama... birisi yerimi kapmış. Bak, o {0} almış. '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863209
    m_Localized: 'Intruder: İkimiz oraya sığmayız.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863210
    m_Localized: 'Intruder: Bir kere rüyamda görmüştüm onu. Bir daha da görmek istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863211
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863212
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863213
    m_Localized: 'Intruder: Umarım biraz uyuyabilirim artık...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446720741376
    m_Localized: 'Wifefema: Dinle bak, ben bu işlerden anlarım. Tekinsiz tipleri ve Ziyaretçileri hemen ayırt ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518592
    m_Localized: 'Wifefema: Lafı hiç uzatmayacağım. O {0} buradan kovulmadığı sürece içeri adımımı bile atmam.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518593
    m_Localized: 'Wifefema: Ha, kovamam diyorsan hemen kocama söylerim. O da sarı kıyafetli arkadaşlarıyla şafak vaktinde sizi ziyaret eder.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518594
    m_Localized: 'Wifefema: Karantina cezası, polis köpeği... Her gün kapında, bir düşünsene. Herhâlde şimdi beni evine davet etmek için can atıyorsundur?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518595
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518596
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518597
    m_Localized: 'Wifefema: Sen canına mı susadın? Kocam FEMA''da çalışıyor diyorum!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518598
    m_Localized: 'Wifefema: Kafayı mı yedin sen? Ben burada bir yerlerimi yırtıyorum, bana mısın demiyorsun!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518599
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518600
    m_Localized: 'Wifefema: Tamam ulan o zaman, siktir git. Komşularından biri beni alır. Hadi öptüm. Piç kurusu...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518601
    m_Localized: 'Fugitive: Ya hemen beni içeri alacaksın ve bana yardım edeceksin ya da şuracıkta can vereceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518602
    m_Localized: 'Fugitive: Hadi be abi... Neyim varsa vereceğim diyorum sana. Bak, yanımda bir {0} var. Onu vereyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518603
    m_Localized: 'Fugitive: Lütfen... Gebereceğim şurada!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518604
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518605
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518606
    m_Localized: 'Bestson: Ne yapsam bilemedim...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518607
    m_Localized: 'Bestson: Benden bir şey mi istiyorsun? Şu {0} olur mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518608
    m_Localized: 'Bestson: Biraz da... ciklet var yanımda. Çok kalmadı ama istiyorsan veririm.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518609
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518610
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712896
    m_Localized: 'Fatman: Dur dur, ben seni nasıl ikna edeceğimi biliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712897
    m_Localized: 'Fatman: Al bakalım, benden bir... hediye. {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712898
    m_Localized: 'Fatman: Ne dersin ha? Hoşuna gitti, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712899
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712900
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712901
    m_Localized: 'Blind: Dur, bekle lütfen. Üzerimde bir şey vardı...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712902
    m_Localized: 'Blind: Galiba {0}. İstersen alabilirsin. Kendime gelebilmem için en az bir gün gerek ama ondan bile emin değilim...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712903
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712904
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712905
    m_Localized: 'Dude: Hadi be moruk...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712906
    m_Localized: 'Dude: Dur bak, yanımda bir şey var. İlgini çeker belki.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712907
    m_Localized: 'Dude: Bum, {0}! Bilgisayar oyunu gibi düşün kanka. Birbirimize hediye vererek arkadaşlığımızın seviyesini artıracağız.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712908
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712909
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712910
    m_Localized: 'Wheelchair: İçeri alasın mı yok? Hemen hallederiz! Şu {0} fikrini değiştirir mi? Üzerine döktüğün her şeyi görünmez yapar!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712911
    m_Localized: 'Wheelchair: Yemin ederim bak!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712912
    m_Localized: 'Wheelchair: Bacaklarım gerçekten yok mu sanıyorsun? Üzerime bundan döktüm sadece, haha!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712913
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712914
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907200
    m_Localized: 'Couple: Lütfen ama birader... Israr etmek istemiyorum ama biraz da kendini benim yerime koy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907201
    m_Localized: 'Couple: Karım zaten zayıf düştü son günlerde. Hemen yoruluyor. Onun için her şeyi yaparım, anlıyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907202
    m_Localized: 'Couple: Çok seviyorum onu. İstersen donuma kadar al, yeter ki o güvende olsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907203
    m_Localized: 'Couple: Donum demişken...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907204
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907205
    m_Localized: 'Couple: Yani donumu değil de...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907206
    m_Localized: 'Couple: Bu {0} ilgini çeker mi? Bir tanem birazcık dinlenebilsin diye her şeyimi vermeye razıyım.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907207
    m_Localized: 'Couple: Ne dersin? Bize yardım edecek misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907208
    m_Localized: İyi, gelin
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907209
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907210
    m_Localized: 'Luka: Sorun değil, belki sana bir şey teklif edebilirim. Ne istersin?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907211
    m_Localized: 'Luka: Elimde {0} var.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907212
    m_Localized: 'Luka: İlgini çeker mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907213
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 48213446750101504
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490112
    m_Localized: 'Widow: Yardım ettiğin için teşekkür ederim. Onun aksine...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490113
    m_Localized: 'Widow: Bir saniye, o {0} değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490114
    m_Localized: 'Widow: Olmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490115
    m_Localized: 'Widow: Onun gibi biriyle aynı evde kalmam ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490116
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490117
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490118
    m_Localized: 'Widow: Sağ ol, uzun süre kalmayacağım zaten. Sadece biraz dinlenmem gerek...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684416
    m_Localized: 'Greatmother: Bak bak, o kim öyle kız? {0} değil mi o? Amaaan!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684417
    m_Localized: 'Greatmother: Bu işe yaramazları niye evine alıyorsun ki sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684418
    m_Localized: 'Greatmother: Onu buradan at gitsin annesinin gülü. Ben de oraya oturuvereyim!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684419
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684420
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684421
    m_Localized: 'Greatmother: Çok kibarsın! Zaten başına bela olurdu o senin.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878720
    m_Localized: 'Twins: Maalesef ki o {0} zaten burada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878721
    m_Localized: 'Twins: O... konuşmalarıyla kardeşimi daha beter hâle getirir kesin.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878722
    m_Localized: 'Twins: Şu an bunu kaldıracak vaziyette değil. Kardeşimin dinlenmesi lazım, yargılanması değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878723
    m_Localized: Onu kovarım, siz gelin
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878724
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878725
    m_Localized: 'Twins: {0} burada demek...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878726
    m_Localized: 'Twins: Onunla aynı çatı altında yaşamak zor olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878727
    m_Localized: 'Twins: Kocamla tanışmadan önce biz... Yani, bana yakından tanıdığım birini hatırlatıyor diyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878728
    m_Localized: 'Twins: Pek iyi anlaşacağımızı sanmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878729
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878730
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878731
    m_Localized: 'Twins: Gördüğüm kadarıyla hem {0} hem {1} buradalar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878732
    m_Localized: 'Twins: Bu hiç hayra alamet değil. Onlar kardeşime iyi gelmezler.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878733
    m_Localized: 'Twins: Bana annemle babamı hatırlatıyorlar. Kardeşim bu durumdayken burada yapamaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878734
    m_Localized: Onu kovarım, siz gelin
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878735
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878736
    m_Localized: 'Twins: Hım... Anlıyorum, bizi tanımıyorsun. Başına bela olacağız sanıyorsun ama söz veriyorum olmayacağız.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878737
    m_Localized: 'Twins: Küçük kardeşim çok kötü durumda ama... elimizde bir şey var. Neydi adı?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878738
    m_Localized: 'Twins: Hah, {0}. Buyur, al. Belki işine yarar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878739
    m_Localized: İyi, gelin
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878740
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878741
    m_Localized: 'Wolfhound: O {0} da mı bu mekânda lan? Ben bu tipleri bi'' kilometre öteden tanırım ha. Bunlardan kimseye hayır gelmez.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878742
    m_Localized: 'Wolfhound: Sen burayı adam etmek istiyorsan ona tekmeyi basacan başkan.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878743
    m_Localized: Ben hallederim. Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878744
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878745
    m_Localized: 'Wolfhound: Ha şöyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878746
    m_Localized: 'Wolfhound: Artık önemli olan güç baba. Ya buna ayak uydurursun ya da tekmeyi yersin.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073024
    m_Localized: 'Marauder: Dur bir saniye ama... Önce bir çantama bakayım da...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073025
    m_Localized: 'Marauder: Şimdi bıçak lazım olur... Bandaj zaten lazım... Bir şişe var ama, boş yani... Pek işe yaramaz...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073026
    m_Localized: 'Marauder: Heh, buldum! {0}! Buyur kardeş. Sabaha kadar burada kalmama izin versen yeter.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073027
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073028
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073029
    m_Localized: 'GraveDigger: Aman! Bir şey versem bari, olmaz mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073030
    m_Localized: 'GraveDigger: Beni içeri almak için ne istiyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073031
    m_Localized: 'GraveDigger: {0} olur mu? Ne dersin?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073032
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073033
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267329
    m_Localized: 'Courier: Milletin hazırlanmak için dünyanın sonunun gelmesini bekleyeceğini düşünmezdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267330
    m_Localized: 'Courier: Kıyamet kopsa da insanların bir şekilde karnını doyurması lazım!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267331
    m_Localized: 'Courier: Teslimatlar şu sıralar epey kazandırıyor ama bir yandan da çok riskli bir iş.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267332
    m_Localized: 'Courier: Bir de şu güneş var ya... Hepimizi gece vardiyasına almak zorunda kaldılar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267333
    m_Localized: 'Courier: Şimdi millet gidiyor, kaç bidon su sipariş ediyor. O kadar ağır taşıyoruz, bir bahşiş veya sigorta veren yok...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267334
    m_Localized: 'Courier: Neyse, pardon. Dikkatim dağıldı. İşte siparişin.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267335
    m_Localized: (Siparişi al)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267336
    m_Localized: 'Courier: Buyur. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267338
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267339
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267340
    m_Localized: 'Courier: Zaten akrabalarım da uzakta. Ben buralı değilim aslında, üniversitede okumaya geldim. Yalnızım yani...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267341
    m_Localized: Yalnız kalmak o kadar da kötü değil
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267342
    m_Localized: Yazık olmuş
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267343
    m_Localized: 'Courier: Tabii, tabii. Evinde bir sürü insan varken bunu söylemesi kolay.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267344
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267345
    m_Localized: 'Courier: Neyse. Kurye olmak o kadar da kötü değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267346
    m_Localized: 'Courier: Zaten bu saatten sonra kimse beni işe alamaz, niye ders çalışayım ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267347
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267348
    m_Localized: 'Courier: Neyse, siparişi getirdim. Buyur.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267349
    m_Localized: (Siparişi al)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267350
    m_Localized: 'Courier: Buyur. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267352
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267353
    m_Localized: Çok takma kafana
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267354
    m_Localized: Hayatta kalmak istiyorsan zırlamayı bırak
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267355
    m_Localized: 'Courier: "Takma", öyle mi? Kıyamet koptu kopacak, neyi takmayayım kafama?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267356
    m_Localized: 'Courier: Yok Ziyaretçiler, yok belirtiler, yok güneş...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267357
    m_Localized: 'Courier: Bundan beter olamaz diyorum ama her gün daha beter oluyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267358
    m_Localized: 'Courier: Yarın etek tıraşı olmayanlar da Ziyaretçi diye bir taraflarından belirti uydursalar hiç şaşırmam.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267359
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267360
    m_Localized: 'Courier: Neyse, ben gideyim artık. Şu siparişini al da yoluma koyulayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267361
    m_Localized: (Siparişi al)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267362
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267363
    m_Localized: 'Courier: Sağ olasın, çok makbule geçti. Sen de zaten tam hayat tavsiyesi verecek adamsın ya.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267364
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267365
    m_Localized: 'Courier: Al şu siparişini. Ben gidiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267366
    m_Localized: (Siparişi al)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267367
    m_Localized: 'Courier: Buyur. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267368
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267370
    m_Localized: Yapacak bir şey yok
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267371
    m_Localized: Başın sağ olsun
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267372
    m_Localized: 'Courier: Yani... arkadaşımın öldüğü iyi oldu mu diyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267373
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267374
    m_Localized: 'Courier: Al hadi şu siparişini. Beni de vurmaya kalkma da.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267375
    m_Localized: (Siparişi al)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267376
    m_Localized: 'Courier: Hof...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267377
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267378
    m_Localized: 'Courier: Kurye olmak en azından kafamı dağıtıyor demiştim ya hani? Artık pek de öyle değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267379
    m_Localized: 'Courier: Her gittiğim evde kapıyı açanın suratından düşen bin parça.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267380
    m_Localized: 'Courier: Bir de her sabah FEMA bizi kontrol ediyor, kafamıza silah doğrultuyorlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267381
    m_Localized: 'Courier: Tam bir kaos...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267382
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267383
    m_Localized: 'Courier: Bıktım artık. Her şey bitsin istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267384
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267385
    m_Localized: 'Courier: Neyse, al hadi siparişini. Gidiyorum ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267386
    m_Localized: (Siparişi al)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267387
    m_Localized: 'Courier: Buyur. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267388
    m_Localized: 'Courier: İyi geceler...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267389
    m_Localized: 'CultistPriest: Olması gerektiği gibi. Ancak evinde sığındırdığın bazı... sakinlerden kurtulmanı istemek durumundayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267390
    m_Localized: 'CultistPriest: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267391
    m_Localized: 'CultistPriest: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267392
    m_Localized: 'CultistPriest: Yolumuza taş koymaya çalışacaktır. Buna izin veremeyiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267393
    m_Localized: Onu kovarım, gelsinler
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267394
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267395
    m_Localized: 'CultistPriest: Teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267396
    m_Localized: 'CultistPriest: Çok vakte ihtiyaç duymayacaklar ama yine de onlara göz kulak ol.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267397
    m_Localized: 'CultistPriest: Görüşmek üzere. Onları kontrol etmeye geleceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267398
    m_Localized: 'CultistPriest: Bunun sana kaldığına inanıyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267399
    m_Localized: 'CultistPriest: Görüşmek üzere. Onları kontrol etmeye geleceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267400
    m_Localized: 'CultistPriest: Kardeşlerime iyi bak. Unutma, biri bile ölürse... evin yerle bir olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655936
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655937
    m_Localized: 'StaticBoy: Daha uyumadı mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655938
    m_Localized: 'StaticBoy: Uyuyacaktı...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655939
    m_Localized: Yolunu mu kaybettin?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655940
    m_Localized: Annen baban nerede senin?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655941
    m_Localized: 'StaticBoy: Karanlıkta tüm kapılar birbirlerine benziyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655942
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655943
    m_Localized: 'StaticBoy: Mutfak lambasını arıyordum ama... buradan yayılan farklı bir yankı var.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655944
    m_Localized: 'StaticBoy: Parkelerin gıcırdadığını dışarıdan duyabiliyorum. Demek ki bekleyen biri var.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655945
    m_Localized: Ne arıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655946
    m_Localized: Evini bulmana yardımcı olmamı mı istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655947
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655948
    m_Localized: 'StaticBoy: Annemle babam mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655949
    m_Localized: 'StaticBoy: Yok ki. Hiç olmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655950
    m_Localized: 'StaticBoy: Lazım mıydı ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655951
    m_Localized: Ne arıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655952
    m_Localized: Evini bulmana yardımcı olmamı mı istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655953
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655954
    m_Localized: 'StaticBoy: Yanlış koku. Yanlış ses.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655955
    m_Localized: 'StaticBoy: Kusura bakma.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655956
    m_Localized: 'StaticBoy: Bu ev yanlış.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655957
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655958
    m_Localized: 'StaticBoy: Yanlış koku. Yanlış ses.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655959
    m_Localized: 'StaticBoy: Kusura bakma.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655960
    m_Localized: 'StaticBoy: Bu ev yanlış.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655961
    m_Localized: 'Jacob: Selam.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655962
    m_Localized: 'Jacob: Buraya mor saçlı ve pançolu bir kız uğradı mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655963
    m_Localized: Burada öyle biri yok
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655964
    m_Localized: Kerhaneyi arıyorsan ileride solda
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655965
    m_Localized: 'Jacob: Kendisi kızım olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655966
    m_Localized: 'Jacob: Bu olaylar kopalı onu bir türlü bulamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655967
    m_Localized: 'Jacob: Sözde burayı birlikte terk edecektik...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655968
    m_Localized: 'Jacob: Sonra o sıcaklık dalgası başlayınca bayıldım...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655969
    m_Localized: 'Jacob: Uyandığımda evde kimse yoktu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655970
    m_Localized: 'Jacob: Ne bir not ne bir iz. Kızım öylece ortalıktan kaybolmuş.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655971
    m_Localized: Nereye gitmek istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655972
    m_Localized: Kızın burada değil, hadi yallah
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655973
    m_Localized: 'Jacob: Kızım hakkında öyle konuşma bir daha.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655974
    m_Localized: 'Jacob: Bu mevzu başladığından beri onu arıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655975
    m_Localized: 'Jacob: Nerede olduğuna dair hiçbir fikrim yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655976
    m_Localized: 'Jacob: Onu bulduğum gibi buralardan gideceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655977
    m_Localized: Nereye gitmek istiyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655978
    m_Localized: Kızın burada değil, hadi yallah
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655979
    m_Localized: 'Jacob: FEMA''nın bizi bulamayacağı bir yere.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655980
    m_Localized: 'Jacob: Buradan uzaklara yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655981
    m_Localized: 'Jacob: Sırlarını bildiğim için peşime düştüler.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655982
    m_Localized: 'Jacob: Kızımı belki de o piç kuruları alıp götürdü, bilemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655983
    m_Localized: 'Jacob: Onlar kaçırdıysa da ona dokunmazlar. İstedikleri benim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655984
    m_Localized: 'Jacob: FEMA bölgeyi terk edene kadar burada birkaç gün kalmama izin ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655985
    m_Localized: 'Jacob: Sonra gidip kızımı aramaya devam edeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655986
    m_Localized: 'Jacob: Hatta sana her şeyi anlatırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655987
    m_Localized: 'Jacob: Ziyaretçilerin nereden geldiğini biliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655988
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655989
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655990
    m_Localized: 'Jacob: Dur bir saniye!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655991
    m_Localized: 'Jacob: Birkaç gün sığınmam lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655992
    m_Localized: 'Jacob: FEMA peşime düştü. Çok şey bildiğim için...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655993
    m_Localized: 'Jacob: Hükûmetin sızmasını istemediği bilgileri...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655994
    m_Localized: 'Jacob: Sana yemin ederim, FEMA buralardan gittiği gibi evinden çıkıp kızımı aramaya devam edeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655995
    m_Localized: 'Jacob: Hatta sana her şeyi anlatırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655996
    m_Localized: 'Jacob: Ziyaretçilerin nereden geldiğini biliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655997
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655998
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655999
    m_Localized: 'Jacob: Teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656000
    m_Localized: 'Jacob: Millet artık birbirine konuşma hakkı bile vermiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656001
    m_Localized: 'Jacob: Bu kâbustan anca senin gibiler kurtulabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656002
    m_Localized: 'Jacob: Çünkü sen ve ben... ölümsüzüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656003
    m_Localized: 'Jacob: Öyleyse bilmen gereken bir şey var.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656004
    m_Localized: 'Jacob: İnsanları ölümün eşiğinde bırakmak yanlış bir şey...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656005
    m_Localized: 'Jacob: ...ama ben asla ölmeyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656006
    m_Localized: 'Jacob: Sen ve ben... tekrar görüşeceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311552
    m_Localized: 'Fanatic: İşte bizzat KUTSAL GÜNEŞ''ten gelen cömert bir armağan! Bunu hak ettin İNSAN!'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311553
    m_Localized: 'Fanatic: İşte karşında... {0}. Beni içeri alırsan bizzat KUTSAL GÜNEŞ''ten gelen bu cömert armağanı sana bahşedeceğim!'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283080
    m_Localized: 'MushroomEater: Selamlar delikanlı. Beni unuttun mu yoksa, ha? Gülümsemeler Kitabı''ndaki ipuçlarını fark edemedin mi yoksa?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283081
    m_Localized: 'MushroomEater: Peh... Gençlerle konuşmaya çalışarak boşa vakit harcıyoruz belli ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283082
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283083
    m_Localized: 'MushroomEater: Ah gençlik ah...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336336011264
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205568
    m_Localized: 'Gasmask: Yalnızsınız demek?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205569
    m_Localized: 'Gasmask: Zor olsa gerek. Sizin için de, bizim için de. Bomboş mahallenin neresini kontrol edeceğiz ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205570
    m_Localized: 'Gasmask: Pekâlâ öyleyse. Görüşmek üzere.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177088
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177089
    m_Localized: 'CultistPriest: Minnettarlığımı göstermek için sana hidayet teklif edebilirim...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177090
    m_Localized: 'CultistPriest: Ayinimize katıl ve huzur bul. Gel kardeşim, Ölüm''e yürürken elimizi tut ve bize katıl.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177091
    m_Localized: Madem bu kadar geberesiniz var, buyurun geberin. Ben kılımı bile kıpırdatmam
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177092
    m_Localized: Uzun süredir huzurun peşindeyim... Sizinle birlikte geleceğim
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177093
    m_Localized: 'CultistPriest: Pekâlâ, kararın buysa öyle olsun... Ölüm, O''na ait olanı eninde sonunda alacaktır.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177094
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177095
    m_Localized: 'CultistPriest: Elveda.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371392
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371393
    m_Localized: 'Vigilante: Bana ellerini göster.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371394
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371395
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371396
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371397
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371398
    m_Localized: 'Vigilante: Kulak mı? Ne kulağı lan? Ziyaretçi belirtisi falan değil bu!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371399
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371400
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371401
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371402
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371403
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371404
    m_Localized: 'Vigilante: Kulak mı? Ne kulağı lan? Ziyaretçi belirtisi falan değil bu!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371405
    m_Localized: 'Vigilante: Buradaki işim bitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371406
    m_Localized: 'Vigilante: Beni bir daha görmeyeceksin.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371407
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371408
    m_Localized: 'Vigilante: Kalan ömrünün keyfini çıkar.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303872
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303873
    m_Localized: 'SuperFake: Niye bu kadar... gerginsin? Hayata çok sıkı tutunuyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303874
    m_Localized: 'SuperFake: Geriye önemi olan ne kaldı ki? Hepsi seni bırakıp gitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303875
    m_Localized: 'SuperFake: Pekiiiii...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303876
    m_Localized: 'SuperFake: Yalnız mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303877
    m_Localized: Yalnızım
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303878
    m_Localized: Yalnız değilim
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692480
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692481
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306387824640
    m_Localized: 'MushroomEater: Vay hâlimize delikanlı... Bu hiç iyi olmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306408796160
    m_Localized: 'MushroomEater: Belli ki Festival''i durduramamışız...'
    m_Metadata:
      m_Items: []
  - m_Id: 58250202325180416
    m_Localized: 'TV: Ziyaretçi olduğundan şüphelendiğiniz birini hemen bir karantina bölgesine gönderemiyorsanız ona bir Mecburi Teslim Belgesi verin.'
    m_Metadata:
      m_Items: []
  - m_Id: 58250202329374720
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 61235008206004224
    m_Localized: Giriş bölümünü atla
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264640
    m_Localized: (Siparişi al)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264641
    m_Localized: (Siparişi al)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264642
    m_Localized: (Siparişi al)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264643
    m_Localized: (Siparişi al)
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417792
    m_Localized: 'Unstable: Ha, merhaba! İyi bari, ev boş değilmiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417793
    m_Localized: 'Unstable: Şu an aşırı gerginim ama EnerJeka eskisi gibi sarmıyor. Stoklarımı yenileyebilirsem iyi olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417794
    m_Localized: Nereye gidiyorsun bu hâlde?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417795
    m_Localized: Burada stok falan yok
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417796
    m_Localized: 'Unstable: Uzaklara. Tek bir yerde kalamam.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417797
    m_Localized: 'Unstable: Ufukta bir fırtına var. İnsanların bu fırtınayla nasıl yüzleşeceğini merak ediyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417798
    m_Localized: 'Unstable: Bitkin düşene kadar yürümeye devam edeceğim. Ya da Ziyaretçiler beni yakalayana kadar. Hangisi ilk olursa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417799
    m_Localized: Güvenli bir yer aramıyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417800
    m_Localized: Eninde sonunda başına bela alacaksın
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417801
    m_Localized: 'Unstable: Güvenilir EnerJeka''m daima yanımdadır.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417802
    m_Localized: 'Unstable: EPEY uzun bir süre yetecek kadar var. Neremde sakladığımı hiç sorma.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417803
    m_Localized: 'Unstable: Geceleri harekete geçiyorum. Güneş beni pişirmeden bir binanın içine girerim yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417804
    m_Localized: Güvenli bir yer aramıyor musun?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417805
    m_Localized: Eninde sonunda başına bela alacaksın
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417806
    m_Localized: 'Unstable: Nasıl yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417807
    m_Localized: 'Unstable: Ne kadar uzağa gidersem çözüm bulma şansım o kadar artar. Galiba anlatamadım...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417808
    m_Localized: 'Unstable: Kim bilir, belki de insanoğlunun son ümidi senin evinde bir yerde saklıdır?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417809
    m_Localized: 'Unstable: Evimde oturup dursaydım bunu asla öğrenemezdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417810
    m_Localized: 'Unstable: Ölür giderdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417811
    m_Localized: 'Unstable: Yalnız başıma.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417812
    m_Localized: 'Unstable: Yok öyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417813
    m_Localized: Ee, sonra?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417814
    m_Localized: Bir şeyden mi kaçıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417815
    m_Localized: 'Unstable: Sen de burada hapsolmuşsun. Seni güvende olduğuna inandıran ne?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417816
    m_Localized: 'Unstable: Tamam, hâlâ yaşıyorsun. Tamam, benimle konuşabiliyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417817
    m_Localized: 'Unstable: E ama ben de yaşıyorum! Demek ki ikimiz de bir çözüm bulmuşuz.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417818
    m_Localized: 'Unstable: Hayatta kalma sırlarımızı paylaşalım istersen, hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417819
    m_Localized: Ee, sonra?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417820
    m_Localized: Birinden mi kaçıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417821
    m_Localized: 'Unstable: Sonra koşmaya devam.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417822
    m_Localized: 'Unstable: Aradığımı bulana kadar koşmaya devam edeceğim... Aradığım o şey her neyse artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417823
    m_Localized: 'Unstable: Burası ilgimi çekti açıkçası.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417824
    m_Localized: 'Unstable: Beni içeri alacak mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417825
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417826
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417827
    m_Localized: 'Unstable: Bak, beni dinlemiyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417828
    m_Localized: 'Unstable: Söyledim ya işte. İnsanların nasıl hayatta kaldığını gözlemliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417829
    m_Localized: 'Unstable: Birkaç ilgi çekici yer buldum ama genel olarak hep aynı şeyleri gördüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417830
    m_Localized: 'Unstable: İnsanlar panik yapıyor, sonra ya kapıyı açmıyorlar ya da hareket eden her şeyi vuruyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417831
    m_Localized: 'Unstable: Bana sorarsan pek mantıklı bir strateji değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417832
    m_Localized: 'Unstable: Neyse, eşiğinde durmaktan yoruldum. Beni içeri alırsan sana gördüklerimi anlatırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417833
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417834
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417835
    m_Localized: 'Unstable: Şahane!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417836
    m_Localized: 'Unstable: Sen bana buralarda neler döndüğünü anlatacaksın, tamam mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417837
    m_Localized: 'Unstable: Ben de kendi hikâyelerimi paylaşırım. Sohbet ederiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417838
    m_Localized: 'Unstable: Tüh ya. Dur, yanımda bir sürü şey var.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417839
    m_Localized: 'Unstable: EnerJeka içer misin? Başka seçeneklerim de var!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417840
    m_Localized: 'Unstable: Hatta dur bir saniye...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417841
    m_Localized: 'Unstable: Buyur, {0}. İster misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417842
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417843
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417844
    m_Localized: 'Unstable: Bir saniye, o {0} burada mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417845
    m_Localized: 'Unstable: Ben öyle insanların yanında konuşamam. Ağzından çıkan her şeyi yanlış anlarlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417846
    m_Localized: 'Unstable: Sonra olay çıkar. Hiç uğraşmayalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417847
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417848
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417849
    m_Localized: 'Unstable: Hahaha, kim olduğunu bile bilmiyordum onun.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417850
    m_Localized: 'Unstable: Kusura bakma, bana çok komik gelmişti.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417851
    m_Localized: 'Unstable: Neyse, sana bir sürü hikâye anlatırım!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417852
    m_Localized: 'Unstable: Sorun değil, başka bir yere uğrarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417853
    m_Localized: 'Unstable: Hava satan bir eleman varmış. Bak sen şu işe!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417854
    m_Localized: 'Unstable: Kaç kişiyi dolandırdı acaba?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417855
    m_Localized: 'Unstable: Pekâlâ, görüşürüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417856
    m_Localized: 'Unstable: Can sıkıcı. Hep aynı şey...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417857
    m_Localized: 'Unstable: İyi, başka bir yere bakayım öyleyse.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417858
    m_Localized: 'Unstable: Manyağın teki milleti toplayıp beyinlerini yıkıyormuş, öyle duydum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417859
    m_Localized: 'Unstable: Sonra da hepsini yakıyormuş!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417860
    m_Localized: 'Unstable: Ben de aralarına katılırım belki. İlgimi çekti.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417861
    m_Localized: 'Rocker: Kapıyı açsana kanka. Güneş spot ışığı gibi gözüme vuruyor. Sığınacak bir yer bulamazsam kör olacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417862
    m_Localized: 'Rocker: Bir iki gece kalırım burada, sonra kalkar giderim. Hani şey sanma beni. Neydi ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417863
    m_Localized: 'Rocker: Hah, otlakçı.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417864
    m_Localized: 'Rocker: Ortalık iyice karıştı zaten. Merdiven altı barda meşhur şarkıcı çıkmış gibi bildiğin!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417865
    m_Localized: Yanında bir şey var mı?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417866
    m_Localized: Niye bir haftadır uyumuyormuş gibi görünüyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417867
    m_Localized: 'Rocker: Sıkıntılı bir şey yok. Mini amfi var, iki şişe su var. Çalmayı biliyorsan amfiyi kullanmana izin veririm.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417868
    m_Localized: 'Rocker: Yakınlarda bir Ziyaretçi olduğunu duydum. Şimdi herkesi kontrol ediyorlar. Benim için hava hoş, kimse olay çıkarmadığı sürece tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417869
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417870
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417871
    m_Localized: 'Rocker: Bir haftadır uyumuyorum çünkü.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417872
    m_Localized: 'Rocker: Gün doğumuna kadar sahnedeydim, sonra bir grup manyak geldi ve mallarımızı çalmaya başladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417873
    m_Localized: 'Rocker: Şerefsizler, gitarımı bile kırdılar. Bu olaylar yüzünden millet iyice hayvana dönüştü anasını satayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417874
    m_Localized: 'Rocker: Açıkçası ben Ziyaretçi olsaydım ya kapıyı kırardım ya da pencereden girerdim ama gördüğün üzere buradayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417875
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417876
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417877
    m_Localized: 'Rocker: Sağ olasın kanka. Arada sırada müzik dinlerim sana sıkıntı olmazsa. Gitar bulabilirsem sana şarkı da çalarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417878
    m_Localized: 'Rocker: Çalmayabilirim de, sana kalmış!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417879
    m_Localized: 'Rocker: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417880
    m_Localized: 'Rocker: Peki o zaman kanka. Sıkıntı değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417881
    m_Localized: 'Rocker: Arkadaşlarımdan birinin evinde kalırım. Umarım geriye kalanlar da ölmemişlerdir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417882
    m_Localized: 'Rocker: Yok, o şerefsizin olduğu yere girmem ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417883
    m_Localized: 'Rocker: Evet, {0}. Onu diyorum. Ondan kurtulman lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417884
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417885
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417886
    m_Localized: 'Rocker: Ha şöyle ya!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417887
    m_Localized: 'Rocker: Gitarsız da olmuyor ama işte... Neyse.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417888
    m_Localized: 'Rocker: Sikerler.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417889
    m_Localized: 'Rocker: İlla beni evine alacak birini bulurum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417890
    m_Localized: 'Experienced: Beni içeri alsana abicim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417891
    m_Localized: Sen niye donla geziyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417892
    m_Localized: Nereden çıktın lan sen?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417893
    m_Localized: 'Experienced: Anlamadın mı? Dışarısı cayır cayır yanıyor. Millet niye soyunmadı, ben onu merak ediyorum asıl.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417894
    m_Localized: 'Experienced: Sanırsın dışarıda kar yağıyor. Bunların hepsi delirmiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417895
    m_Localized: 'Experienced: Ben tecrübeli adamım. Hapisten çıktığım an üzerimdeki her şeyi attım, ferahladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417896
    m_Localized: Peki burada ne arıyorsun tam olarak?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417897
    m_Localized: Hapiste niye kalmadın?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417898
    m_Localized: 'Experienced: İçeri bi'' iki kere girdim abicim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417899
    m_Localized: 'Experienced: Daha da kalırdım ama şutladılar beni.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417900
    m_Localized: 'Experienced: Şimdi de dünya iyice sapıttı. Güneş bir yerlerimi kavurmaya çalışıyor bildiğin.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417901
    m_Localized: 'Experienced: Ben de sokaklara düştüm işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417902
    m_Localized: Peki burada ne arıyorsun tam olarak?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417903
    m_Localized: Hapiste niye kalmadın?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417904
    m_Localized: 'Experienced: Gidecek başka yerim yok ki abicim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417905
    m_Localized: 'Experienced: Cebimde beş kuruş kalmadı, hanım gitti şerefsizin tekiyle evlendi, başımı sokacak bir evim de kalmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417906
    m_Localized: 'Experienced: Sonra burayı gördüm. Sessiz, sakin, her yerden uzak.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417907
    m_Localized: 'Experienced: Enayilerin dolanmadığı bir yerde, sağlam mekân.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417908
    m_Localized: 'Experienced: Neyse, yeterince boş yaptık. Kalmama izin verecek misin abicim?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417909
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417910
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417911
    m_Localized: 'Experienced: Kalırdım tabii de kimse istemedi ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417912
    m_Localized: 'Experienced: Süren dolduğu gibi şutluyorlar seni.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417913
    m_Localized: 'Experienced: Cebimde beş kuruş kalmadı, hanım gitti şerefsizin tekiyle evlendi, başımı sokacak bir evim de kalmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417914
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417915
    m_Localized: 'Experienced: Neyse, yeterince boş yaptık. Kalmama izin verecek misin abicim?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417916
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417917
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417918
    m_Localized: 'Experienced: Ha şöyle abicim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417919
    m_Localized: 'Experienced: Sen de ne biçim adammışsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417920
    m_Localized: 'Experienced: Hadi bana eyvallah moruk.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417921
    m_Localized: 'Experienced: Bak abicim, beni yanlış anlama ama içeriye piçin tekini almışsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417922
    m_Localized: 'Experienced: Şu {0} var ya, ben bu tiplerin ruhunu bilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417923
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417924
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417925
    m_Localized: 'Experienced: Ha şöyle abicim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417926
    m_Localized: 'Jacket: Merhaba. Beni içeri alır mısın rica etsem?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417927
    m_Localized: Yardımcı olabilir miyim?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417928
    m_Localized: Sığınacak bir yer mi arıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417929
    m_Localized: 'Jacket: Evet, kalacak bir yer arıyorum. Gidebileceğim başka hiçbir yer yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417930
    m_Localized: 'Jacket: Yurtta kalamıyorum artık...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417931
    m_Localized: Niye?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417932
    m_Localized: Yurda ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417933
    m_Localized: 'Jacket: Evet. Lütfen... Bir sıkıntı olmayacaksa beni içeri al.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417934
    m_Localized: 'Jacket: Okulun yurdunda kalıyordum ama gitmek zorunda kaldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417935
    m_Localized: Niye?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417936
    m_Localized: Yurda ne oldu?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417937
    m_Localized: 'Jacket: FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417938
    m_Localized: 'Jacket: Milleti toplamaya başladılar, ben de...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417939
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417940
    m_Localized: 'Jacket: Karantina bölgesine düşmeyi hiç istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417941
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417942
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417943
    m_Localized: 'Jacket: FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417944
    m_Localized: 'Jacket: Bir gün kapımıza dayanıp herkesi muayene etmeleri gerektiğini söylediler.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417945
    m_Localized: 'Jacket: Sonra duydum ki hastaları karantina bölgelerine götürüyorlarmış...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417946
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417947
    m_Localized: 'Jacket: Oraya düşmeyi hiç istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417948
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417949
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417950
    m_Localized: 'Jacket: Çok teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417951
    m_Localized: 'Jacket: Bak, yanımda bu {0} var. Pek bir şey değil ama umarım işine yarar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417952
    m_Localized: 'Jacket: Hayır, lütfen... girmeme izin ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417953
    m_Localized: 'Jacket: Devriyeye denk gelmek istemiyorum. Ya da daha beteri, Ziyaretçilere.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417954
    m_Localized: 'Jacket: İstersen yanımda {0} var. Fikrini değiştirir miydi?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417955
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417956
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417957
    m_Localized: 'Jacket: Kusura bakma ama o {0} burada. Onun gibi insanlara pek güvenmiyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417958
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417959
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417960
    m_Localized: 'Jacket: Çok teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417961
    m_Localized: 'Jacket: Bak, yanımda bu {0} var. Pek bir şey değil ama umarım işine yarar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346842873856
    m_Localized: 'Tough: Seni çok duydum.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039680
    m_Localized: 'Tough: Çoğu insan buradan uzak durmaya çalışıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039681
    m_Localized: 'Tough: Kapına gelenler ya çaresiz... ya da salak.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039682
    m_Localized: 'Tough: Fakat ben sana saygı duyuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039683
    m_Localized: Sağ olasın?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039684
    m_Localized: Ee... Tam olarak ne diyorlar burası hakkında?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039685
    m_Localized: 'Tough: Ciddiyim bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039686
    m_Localized: 'Tough: Çoğu insan pes etti. Hayatta kalmayı beceremiyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039687
    m_Localized: 'Tough: Cesur olanlar kafasına sıktı zaten. Geri kalanlar çürüyüp gitmeyi bekliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039688
    m_Localized: 'Tough: Sen onlardan biri değilsin. Sen mücadeleci birisin.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039689
    m_Localized: Sen de mi çaresizsin?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039690
    m_Localized: Manyağın tekisin sen
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039691
    m_Localized: 'Tough: Burada hayatta kalmanın zor olduğunu söylüyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039692
    m_Localized: 'Tough: Ziyaretçilerin meşru olarak sana ait olan o yegâne şeyi almalarına izin vermiyormuşsun. Hayatını.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039693
    m_Localized: 'Tough: Böyle bir yeri es geçemem. Bana sorarsan seninle ben çok benziyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039694
    m_Localized: 'Tough: Ne olursa olsun hayatta kalırız.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039695
    m_Localized: Sen de mi çaresizsin?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039696
    m_Localized: Manyağın tekisin sen
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039697
    m_Localized: 'Tough: Ne?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039698
    m_Localized: 'Tough: Ha, neden geldiğimi mi merak ediyorsun? Hah, kim bilir? Kafayı yemişimdir belki.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039699
    m_Localized: 'Tough: Fakat kesinlikle çaresiz değilim.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039700
    m_Localized: 'Tough: İnsanoğlu, daha beter facialardan sağ çıktı. Şimdi niye pes edelim ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039701
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039702
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039703
    m_Localized: 'Tough: Yanlış bir izlenim verdiysem kusura bakma.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039704
    m_Localized: 'Tough: Oturup bir şeylerin başımıza gelmesini bekleyecek insanoğlunun işi bitmiştir zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039705
    m_Localized: 'Tough: Hayatta kalmanın tek yolu, savaşmak.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039706
    m_Localized: 'Tough: Hayat, koşullara karşı koymayı gerektirir. Yok öyle armut piş, ağzıma düş.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039707
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039708
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039709
    m_Localized: 'Tough: Harika!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039710
    m_Localized: 'Tough: Açıkçası onur duydum. Tam hayatlarımız darmadağın olmak üzereyken burada bulunduğum için.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039711
    m_Localized: 'Tough: Bir ara konuşalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039712
    m_Localized: 'Tough: Beni sınıyor musun yoksa?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039713
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039714
    m_Localized: 'Tough: Sınamıyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039715
    m_Localized: 'Tough: Ben de bunu beklemiştim zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039716
    m_Localized: 'Tough: Tam bir...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039717
    m_Localized: 'Tough: ...şerefsizsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039718
    m_Localized: 'Bald: Merhaba dostum!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039719
    m_Localized: 'Bald: Bir süre burada kalabilir miyim? Diğer tüm evleri denedim; ya ev sahibi evden kaçmış ya evden kovulmuş ya da kim bilir neler yaşamış.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039720
    m_Localized: 'Bald: Bir sürü arkadaşım var sanıyordum, bu olaylar kopunca bir araya geliriz diye düşünmüştüm ama... olmadı işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039721
    m_Localized: 'Bald: Annemle ve anneannemle yaşıyordum aslında ama tahsildarlar yüzünden evden çıkarıldık. Rezil bir durum...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039722
    m_Localized: Böyle arkadaş mı olur?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039723
    m_Localized: Peşinde öfkeli insanlar mı var yani?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039724
    m_Localized: 'Bald: Tiyatrocu hepsi. Birlikte içerdik, takılırdık, sırtımızı kollardık.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039725
    m_Localized: 'Bald: İyi insanlardı aslında. Bir yardım eli uzatmaya, karşılıklı birer bira içmeye veya takılmaya hep hazırlardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039726
    m_Localized: 'Bald: Fakat şimdi... Yani, hiçbirine ulaşamıyorum. Herkesin kendi derdi var.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039727
    m_Localized: 'Bald: Bu güneş mevzusu yüzünden ortalık iyice karıştı.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039728
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039729
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039730
    m_Localized: 'Bald: Yok, benim peşimde değiller.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039731
    m_Localized: 'Bald: Annemin peşindeler.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039732
    m_Localized: 'Bald: Beni korumaya çalışıyordu, o yüzden bana hiçbir şey söylemedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039733
    m_Localized: 'Bald: Sana yük olmam yani, merak etme. Sen beni bir içeri al da... her şeyi anlatırım dostum.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039734
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039735
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039736
    m_Localized: 'Bald: Cidden hayatımı kurtardın dostum.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039737
    m_Localized: 'Bald: Bir ara yanıma gel, olur mu? Çok enteresan hikâyelerim var. Duyunca kafayı yiyeceksin!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039738
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039739
    m_Localized: 'Bald: Pekâlâ dostum. Anladım. Sorun değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039740
    m_Localized: 'Bald: Kendine dikkat et, tamam mı? Umarım bu bok çukurundan canlı çıkarsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039741
    m_Localized: 'Nervous: Selamm, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039742
    m_Localized: 'Nervous: Kusura bakma, biraz gerg... inim de.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039743
    m_Localized: 'Nervous: Umut Otel''de kalıyordum da bir yürüyüşe çıkayım dedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039744
    m_Localized: 'Nervous: Şimdi geri dönmeye kor... kuyorum. Burada kalabilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039745
    m_Localized: Niye geri dönemiyorsun ki?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039746
    m_Localized: Burasının daha iyi olacağını mı sanıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039747
    m_Localized: 'Nervous: Hoşuma gitmiyor. Başka bir yer bul... mayı tercih ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039748
    m_Localized: 'Nervous: Orada sarı yağmurluklu bir kız var.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039749
    m_Localized: 'Nervous: Beni çok korkutuyor, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039750
    m_Localized: 'Nervous: Kanıtlayamıyorum amaaaaa... bana sorarsan o Ziyaretçi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039751
    m_Localized: 'Nervous: FEMA geldi, sonra gitti. Puf.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039752
    m_Localized: Akrabalarının yanına gitsene
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039753
    m_Localized: Hiç arkadaşın yok mu senin?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039754
    m_Localized: 'Nervous: Orası ortalama. Burası daha iyi. Hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039755
    m_Localized: 'Nervous: Evin gayet büyük, her türlü insan sığar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039756
    m_Localized: 'Nervous: Otel odaları minnacık. Bana kö... tü zamanları hatırlatıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039757
    m_Localized: 'Nervous: Sana bunları anlatırım... sonra. Hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039758
    m_Localized: Akrabalarının yanına gitsene
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039759
    m_Localized: Hiç arkadaşın yok mu senin?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039760
    m_Localized: 'Nervous: Beni ka... zara yapmışlar. Birden gelmişim!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039761
    m_Localized: 'Nervous: Bir kere bana yardım ettiler ama artık hiç siklemiyorlar!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039762
    m_Localized: 'Nervous: Bu yüzden.... tekrar gidesim yok hiç! Hihi!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039763
    m_Localized: 'Nervous: Otele gitmeyi yeğlerim hatta.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039764
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039765
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039766
    m_Localized: 'Nervous: Ne arkadaşı?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039767
    m_Localized: 'Nervous: Pisliklerin hepsi benden nefret ediyor. Okuldaki olaydan beri...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039768
    m_Localized: 'Nervous: Biri hak ettiğini al... dı ama artık daha dikkatliyim, hihi!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039769
    m_Localized: 'Nervous: Artık yeni insanlarla... anlaşmaya çalışıyorum!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039770
    m_Localized: 'Nervous: Bir de yakınlarda silah sesi duydum ama sen güvenliğe önem veriyorsun, değil miiiii?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039771
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039772
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039773
    m_Localized: 'Nervous: Sonunda!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039774
    m_Localized: 'Nervous: Bu olayların bitmesini bekleyebileceğim bir yer buldum...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039775
    m_Localized: 'Nervous: Sennnn de mi beni deli sanıyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039776
    m_Localized: 'Nervous: Siki tutmuş mu sanıyorsun beniiii? Haaaa?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039777
    m_Localized: 'Nervous: O önlük giyen iş... kencecilerden bir farkın yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039778
    m_Localized: 'Nervous: Bak buraya yazıyorum... Başına bela alacaksın...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039779
    m_Localized: 'Nervous: Hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039780
    m_Localized: 'Leper: Selam. Umarım görünüşüm seni çok rahatsız etmiyordur.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039781
    m_Localized: Endişelenmem gerekiyor mu?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039782
    m_Localized: Ne oldu sana böyle?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039783
    m_Localized: 'Leper: Hayır! Onu diyorum işte. Bir sıkıntım yok benim.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039784
    m_Localized: 'Leper: Cildim doğuştan böyle, o kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039785
    m_Localized: 'Leper: Sanki bulaşıcıymış gibi davranıp duruyorlar... Hatta daha beteri, beni Ziyaretçi sanıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039786
    m_Localized: Şu sıralar herkes paranoyak
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039787
    m_Localized: Ne bekliyordun ki?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039788
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039789
    m_Localized: 'Leper: Bundan bahsediyordum işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039790
    m_Localized: 'Leper: İrsî bir hastalık. Elimden bir şey gelmiyor. Ama niyeyse millet beni Ziyaretçi sanıp duruyor. Kafayı yiyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039791
    m_Localized: Şu sıralar herkes paranoyak
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039792
    m_Localized: Ne bekliyordun ki?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039793
    m_Localized: 'Leper: Anlıyorum ama Ziyaretçi değilim ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039794
    m_Localized: Göreceğiz
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039795
    m_Localized: Nasıl bu kadar emin olabilirsin ki?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039796
    m_Localized: 'Leper: Ne demek "Ne bekliyordun ki"? Biraz mantıklı düşün. Böyle görünmeyi ben mi istedim sence?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039797
    m_Localized: 'Leper: Ziyaretçi değilim diyorum sana.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039798
    m_Localized: Göreceğiz
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039799
    m_Localized: Nasıl bu kadar emin olabilirsin ki?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039800
    m_Localized: 'Leper: Peki.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039801
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039802
    m_Localized: 'Leper: Beni içeri alacak mısın peki?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039803
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039804
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039805
    m_Localized: 'Leper: Ne olduğumu biliyorum çünkü. Onlardan biri değilim.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039806
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039807
    m_Localized: 'Leper: Beni içeri alacak mısın peki?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039808
    m_Localized: Göreceğiz
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039809
    m_Localized: Nasıl bu kadar emin olabilirsin ki?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039810
    m_Localized: 'Leper: Beni... içeri aldığın için sağ ol. Dış görünümümü çok kafaya takmadığın için de.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039811
    m_Localized: 'Leper: Peki o zaman, öyle olsun. Ben gideyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722816
    m_Localized: 'Fairytaller: İyi akşamlar. İçeride bir kişilik yerin var mıydı? Çok bir beklentim yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722817
    m_Localized: Niye buradasın?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722818
    m_Localized: Ziyaretçi olmadığını nereden bileceğim?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722819
    m_Localized: 'Fairytaller: Üniversiteden yeni mezun oldum ama alanımda iş bulamadım, bu yüzden küçük bir kafede çalışmaya başladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722820
    m_Localized: 'Fairytaller: Bu son olaylardan sonra müşteriler gelmeyi bıraktı malum, bize de gerek kalmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722821
    m_Localized: 'Fairytaller: Gece kulüplerinde çalışanlar şanslı. Onlar için daha iyi oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722822
    m_Localized: 'Fairytaller: Böyle zor dönemlerde insanlar her şeyi unutmak istiyor... Bir anlığına bile olsa hiçbir şeyi umursamamak istiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722823
    m_Localized: 'Fairytaller: Tıpkı çocukluğumuzdaki gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722824
    m_Localized: 'Fairytaller: Ev sahibim zaten geliri olmayan yeni mezun birine ev kiralamaya pek niyetli değildi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722825
    m_Localized: 'Fairytaller: Bu olaylar başlayınca beni evden çıkardı, işsizliğimi sebep gösterdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722826
    m_Localized: 'Fairytaller: Sonra üvey kardeşlerini getirdi. Açıkçası onu suçlamıyorum ama umarım sen de bana hak verirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722827
    m_Localized: 'Fairytaller: İnsanlara yük olmaktan nefret ederim ama işler kötüye gidince hayatta kalmak için elinden geleni yapman gerekiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722828
    m_Localized: 'Fairytaller: Elimden geldiğince ev işlerinde yardımcı olmaya çalışacağım, söz veriyorum. Bir gün bu iyiliğin karşılığını da vereceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722829
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722830
    m_Localized: Beleşçilerle hiç uğraşamam. Hadi yaylan
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722831
    m_Localized: 'Fairytaller: Açıkçası bu Ziyaretçilerin kim olduğunu veya bizden ne farkları olduğunu hâlâ çözemedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722832
    m_Localized: 'Fairytaller: Belki belirtilerden bazıları bende de vardır, bilemiyorum. Son zamanlarda hiçbir şeyi aklım almıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722833
    m_Localized: 'Fairytaller: Fakat ben eskiden neysem hâlâ o olduğumu düşünüyorum. En azından kimseye zarar verme gibi bir dürtüm yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722834
    m_Localized: 'Fairytaller: Küçükken dinlediğimiz masalları hatırlatıyor bana. Kötü adamlar tüm dünyayı ele geçirirdi...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722835
    m_Localized: 'Fairytaller: İnsanlar korkar, kaçar, birbirine güvenmeyi bırakırdı...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722836
    m_Localized: 'Fairytaller: Keşke bir kahraman çıkıp gerçek kötülüğü ortadan kaldırsa da her şey eski hâline dönse.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722837
    m_Localized: 'Fairytaller: Bu kahramanın ben olduğumu hiç sanmıyorum ama tüm masallarda iyiler kazanır.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722838
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722839
    m_Localized: Beleşçilerle hiç uğraşamam. Hadi yaylan
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722840
    m_Localized: 'Fairytaller: Anladım...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722841
    m_Localized: 'Fairytaller: Biliyorum, sunabileceğim pek bir şey yok ama... lütfen tekrar bir düşün.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722842
    m_Localized: 'Fairytaller: Bir gün borcumu öderim. Şimdi de elimden geldiğince yardımcı olurum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722843
    m_Localized: 'Fairytaller: Yetişkin hayatının bu kadar zor olacağını hiç düşünmemiştim. Gidecek başka hiçbir yerim de yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722844
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722845
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722846
    m_Localized: 'Fairytaller: Çok teşekkür ederim! Bunu asla unutmayacağım!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722847
    m_Localized: 'Fairytaller: Hâlâ iyi niyetli insanların olduğunu, sadece masallarda olmadıklarını görmek güzel.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722848
    m_Localized: 'Fairytaller: Peki, anlıyorum. Dikkat et.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722849
    m_Localized: 'FunnyGuy: Oooo, n''aber ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722850
    m_Localized: 'FunnyGuy: Bu gece ayrı bir manyak, değil mi ya? Sana öyle gelmedi mi? Büyülü bir gece sanki!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722851
    m_Localized: Deli misin lan sen?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722852
    m_Localized: Bu ne neşe böyle?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722853
    m_Localized: 'FunnyGuy: Ayıp oluyor ama! Seni beni anlamadın galiba.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722854
    m_Localized: 'FunnyGuy: Bak dostum... Hatta dostum değil, bak kardeşim! Ev kredisi derdinden kurtuldum!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722855
    m_Localized: 'FunnyGuy: Artık nefes alabiliyorum, nasıl bir his hayal bile edemezsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722856
    m_Localized: Ee, burada ne arıyorsun peki?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722857
    m_Localized: Peki cebinde kalan bunca parayla ne yapacaksın?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722858
    m_Localized: 'FunnyGuy: Borç batağına düşmüştüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722859
    m_Localized: 'FunnyGuy: Her şey çok kötüydü...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722860
    m_Localized: 'FunnyGuy: ...AMA SONRA!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722861
    m_Localized: 'FunnyGuy: Tüm borçlarımdan kurtuldum!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722862
    m_Localized: 'FunnyGuy: Ortalık iyice karıştığı için kimse bankaları ve kredi borçlarını umursamıyor artık!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722863
    m_Localized: 'FunnyGuy: İnanılmaz bir his!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722864
    m_Localized: Ee, burada ne arıyorsun peki?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722865
    m_Localized: Peki cebinde kalan bunca parayla ne yapacaksın?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722866
    m_Localized: 'FunnyGuy: Çok güzel soru...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722867
    m_Localized: 'FunnyGuy: Açıkçası bunu ulu orta yerde konuşmak istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722868
    m_Localized: 'FunnyGuy: Yanlış anlama.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722869
    m_Localized: Pek konuşkan biri değilsin galiba
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722870
    m_Localized: 'FunnyGuy: Sanki dalga geçiyorsun gibi geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722871
    m_Localized: 'FunnyGuy: Açıkçası bu pek hoşuma gitmedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722872
    m_Localized: Pek konuşkan biri değilsin galiba
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722873
    m_Localized: 'FunnyGuy: Ne diyebilirim ki? Belli ki neşemi paylaşmıyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722874
    m_Localized: 'FunnyGuy: Neyse, sonuçta borç senin borcun değil. Güzel bir evin de var.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722875
    m_Localized: 'FunnyGuy: Benim de böyle bir evim olsaydı havalara uçardım.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722876
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722877
    m_Localized: 'FunnyGuy: Ee, beni içeri alacak mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722878
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722879
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722880
    m_Localized: 'FunnyGuy: Ha şöyle ya! Bir iki bira içelim, kutlama yapalım hadi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722881
    m_Localized: 'FunnyGuy: Bugün ne kadar büyük bir gün, anlatamam sana!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722882
    m_Localized: 'FunnyGuy: Hiç mi olmaz?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722883
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722884
    m_Localized: 'FunnyGuy: Hay sikeyim ya...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722885
    m_Localized: 'FunnyGuy: Neyse, bir çözüm bulacağım. Güneşin doğmasına daha var.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722886
    m_Localized: 'Alt: Ha, gerçekten burada biri varmış. Gelebilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722887
    m_Localized: Ev boş mu duruyor?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722888
    m_Localized: Cüretkâr birine benziyorsun
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722889
    m_Localized: 'Alt: Yok... Evinin terk edilmiş durduğunu ima etmedim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722890
    m_Localized: 'Alt: Şehrin dışında çok kötü şeyler yaşandığını duydum, ondan...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722891
    m_Localized: 'Alt: Sadece bizim şehrin de değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722892
    m_Localized: 'Alt: Bu manyaklar ve Ziyaretçiler yetmiyormuş gibi güneş de hepimizi kavurmaya çalışıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722893
    m_Localized: Kimden kaçıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722894
    m_Localized: Burası daha güvenli mi sanıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722895
    m_Localized: 'Alt: Niye bu kadar kabasın?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722896
    m_Localized: 'Alt: Bir hata yapmadım ki. O yargılayıcı bakışlarını da kendine sakla.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722897
    m_Localized: 'Alt: Dış görünüşümün hiçbir önemi yok. Kimseye zarar vereceğim de yok. Umarım ön yargılı biri değilsindir.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722898
    m_Localized: Kimden kaçıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722899
    m_Localized: Burası daha güvenli mi sanıyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722900
    m_Localized: 'Alt: Niye birinden kaçtığımı düşünüyorsun ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722901
    m_Localized: 'Alt: Formaliteleri seven biri değilim. Sadede gelmeyi tercih ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722902
    m_Localized: 'Alt: Açıkçası şehirlerin uzun süre güvenli kalacağını da düşünmüyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722903
    m_Localized: 'Alt: Bu iş ne kadar uzarsa durum o kadar kötüye gidecek. Oksijen tükenecek, suç oranı artacak, millet paranoyak olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722904
    m_Localized: 'Alt: Bizi çok kötü günler bekliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722905
    m_Localized: 'Alt: Bu rezaleti ön sıradan izleme gibi bir niyetim yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722906
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722907
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722908
    m_Localized: 'Alt: Evet.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722909
    m_Localized: 'Alt: Formaliteleri atlayıp doğrudan sadede geleceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722910
    m_Localized: 'Alt: Burası gece vakti daha serin. Kimse yedi yirmi dört haberleri de izlemiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722911
    m_Localized: 'Alt: Elektriğiniz var mı bilmiyorum ama yoksa da daha iyi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722912
    m_Localized: 'Alt: Televizyonun hiçbir işe yaradığı yok zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722913
    m_Localized: 'Alt: Hatta bir haber duyup aslında olayı beş kat hafiflettiklerini bilmek daha kötü. Hatta ne beşi, on kat.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722914
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722915
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722916
    m_Localized: 'Alt: Harika.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722917
    m_Localized: 'Alt: Yarın konuşuruz o zaman. Bugün çok yoruldum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722918
    m_Localized: 'Alt: Bu hafta çok zor geçti.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722919
    m_Localized: 'Alt: Etrafta birkaç ev daha var. Belki birileri dış görünüşüme aldanmaz da insan gibi davranır bana.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722920
    m_Localized: 'Alt: Neyse, yola koyulayım ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722921
    m_Localized: 'Tourist: Selam. Bana yardımcı olur musun? Buralı değilim de.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722922
    m_Localized: Sıkıntı ne?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722923
    m_Localized: Burayı nasıl buldun ki?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722924
    m_Localized: 'Tourist: Bir hata oldu. Şehirden çıkamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722925
    m_Localized: 'Tourist: Havaalanı da tren istasyonu da kapalı.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722926
    m_Localized: Tam da tatile çıkacak vakti seçmişsin
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722927
    m_Localized: Gidecek hiçbir yerin yok mu sahiden?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722928
    m_Localized: 'Tourist: Başkente geziye gidecektim ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722929
    m_Localized: 'Tourist: Sınırları kapattılar. Ben de burada kaldım.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722930
    m_Localized: 'Tourist: Geçerken uğradım yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722931
    m_Localized: Tam da tatile çıkacak vakti seçmişsin
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722932
    m_Localized: Gidecek hiçbir yerin yok mu sahiden?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722933
    m_Localized: 'Tourist: Evet, öyle oldu. İnan bana, bu güneş mevzusunun kopacağını bilseydim hiç gelmezdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722934
    m_Localized: 'Tourist: Fakat geldim işte. Otele verecek param da yok. Lütfen yanında kalmama izin ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722935
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722936
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722937
    m_Localized: 'Tourist: Yok...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722938
    m_Localized: 'Tourist: Bir süre otelde kaldım ama param bitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722939
    m_Localized: 'Tourist: Şu an gidebileceğim hiçbir yer yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722940
    m_Localized: 'Tourist: Lütfen kalmama izin ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722941
    m_Localized: Gel içeri
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722942
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722943
    m_Localized: 'Tourist: Sana minnettarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722944
    m_Localized: 'Tourist: Off... Nereye gideceğim ben? Diğer evlerin hepsine sordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722945
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722946
    m_Localized: 'Tourist: Keşke hiç gelmeseydim...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769344
    m_Localized: 'Jacket: Of... FEMA beni bulacak kesin.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769345
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769346
    m_Localized: 'Jacket: Peki, yola koyulsam iyi olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769347
    m_Localized: 'Tough: O {0} burada mı kalıyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769348
    m_Localized: 'Tough: Ondan kurtulmazsan başka bir yere giderim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769349
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769350
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769351
    m_Localized: 'Tough: Kovmanı beklemiyordum açıkçası.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769352
    m_Localized: 'Tough: Bu kadar kolay olduğuna göre pek mücadele edesi yokmuş demek ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769353
    m_Localized: 'Tough: Nasıl lan? Karşında biraz omurgalı biri görünce ona saygı duyarsın diye düşünmüştüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769354
    m_Localized: 'Tough: "Beceremem," demem bana.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769355
    m_Localized: 'Tough: Üzücü...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769356
    m_Localized: 'Bald: Bak, benim anlaşamayacağım neredeyse kimse yok. Cidden. Fakat bu eleman sıkıntılı. Tehlike çanları çalıyor resmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769357
    m_Localized: 'Bald: Evet, o {0}. Acaba onu... evden çıkarsan mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769358
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769359
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769360
    m_Localized: 'Bald: Birini kovmak kolay iş değil, biliyorum ama hayat böyle işte. Bazen de kibar olamıyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769361
    m_Localized: 'Bald: Hay...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769362
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769363
    m_Localized: 'Bald: Pekâlâ dostum. Anladım. Sorun değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769364
    m_Localized: 'Bald: Kendine dikkat et, tamam mı? Umarım bu bok çukurundan canlı çıkarsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769365
    m_Localized: 'Nervous: Aa... O {0} burada mıydı?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769366
    m_Localized: 'Nervous: Bir ay önce neler yaşandığını biliyorum. Eveeettt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769367
    m_Localized: 'Nervous: O dellllinin teki.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769368
    m_Localized: 'Nervous: Güven bana, ben anlarım...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769369
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769370
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769371
    m_Localized: 'Nervous: Harika...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769372
    m_Localized: 'Nervous: Pek emin olamadım ama... neyse! Hihi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769373
    m_Localized: 'Nervous: Bu delilere hiiiiç bulaşmamak lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769374
    m_Localized: 'Nervous: Ciddi misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769375
    m_Localized: 'Nervous: Seninle kalmamam daha iyi zaten, evet...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769376
    m_Localized: 'Nervous: Etrafını salaklarla doldurursan sen de salak olursun, hihi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769377
    m_Localized: 'Leper: Kusura bakma ama içeri gelemem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769378
    m_Localized: 'Leper: O {0} burada. Dış görünüşüm yüzünden bana hep zorbalık ederdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769379
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769380
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769381
    m_Localized: 'Leper: Sağ olasın. Tekrar o günlere dönmeyi hiç istemiyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769382
    m_Localized: 'Leper: İnsanların görünüşleriyle dalga geçenleri evinde barındırmak mı istiyorsun gerçekten?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157952
    m_Localized: 'Leper: Peki, karar senin. Ben gideyim yavaştan.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157953
    m_Localized: 'Leper: Peki ya bir şey versem? Mesela {0}. O zaman beni alır mısın içeri?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157954
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157955
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157956
    m_Localized: 'Fairytaller: Çok teşekkür ederim! Ama burada kalanlardan biriyle kafede çalışırken kavga etmiştim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157957
    m_Localized: 'Fairytaller: Açıkçası suçlu olan ben değildim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157958
    m_Localized: 'Fairytaller: Biliyorum, zaten epey vaktini harcadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157959
    m_Localized: 'Fairytaller: Ama o {0} ile aynı yerde rahat rahat kalamam.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157960
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157961
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157962
    m_Localized: 'Fairytaller: Ciddi misin? Teşekkür ederim! Zorunda değildin, başka bir yer bulabilirdim...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157963
    m_Localized: 'Fairytaller: Yine de bana güvendiğin için teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157964
    m_Localized: 'Fairytaller: Peki, anlıyorum. Kendine dikkat et.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157965
    m_Localized: 'FunnyGuy: Hayatta olmaz. İçeride eğlenceye alerjisi olan biri var.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157966
    m_Localized: 'FunnyGuy: O {0} var ya, onu diyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157967
    m_Localized: 'FunnyGuy: Zaten şu güne kadar şansım yaver gitmedi, en azından bundan sonra gitsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157968
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157969
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157970
    m_Localized: 'FunnyGuy: Ha şöyle!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157971
    m_Localized: 'FunnyGuy: Borç diye bir kavram kalmamasına içelim, ne dersin? Hahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157972
    m_Localized: 'FunnyGuy: Peki... Anladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157973
    m_Localized: 'FunnyGuy: Ben yola koyulayım o zaman. Güneşin doğmasına daha var.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157974
    m_Localized: 'FunnyGuy: Senin de bankalardan farkın yok belli ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157975
    m_Localized: 'FunnyGuy: Bir daha bu yola başvurmayacağımı düşünmüştüm ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157976
    m_Localized: 'FunnyGuy: Dur, sana bir şey vereyim. Bakalım neyim varmış?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157977
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157978
    m_Localized: 'FunnyGuy: Bak, ne buldum. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157979
    m_Localized: 'FunnyGuy: İşe yarar mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157980
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157981
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157982
    m_Localized: 'Alt: Aa, {0} buradaymış.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157983
    m_Localized: 'Alt: Uzun hikâye, şimdi hiç kafanı şişirmeyeyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157984
    m_Localized: 'Alt: Fakat ikimiz aynı evde kalamayız.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157985
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157986
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157987
    m_Localized: 'Alt: Sağ ol, gerçekten kovmanı beklememiştim ama öyle ummuştum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157988
    m_Localized: 'Alt: Peki...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157989
    m_Localized: 'Alt: Hâlâ vaktim var, başka bir yer bulurum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157990
    m_Localized: 'Alt: Hep bu şerefsizlerin şansı yaver gidiyor zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157991
    m_Localized: 'Alt: Bunu duymaya alıştım. Ne demek istediğini de anladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157992
    m_Localized: 'Alt: Pekâlâ. Bu {0} iş görür mü?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157993
    m_Localized: 'Alt: Şimdi anlaştık mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157994
    m_Localized: İyi, gel
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157995
    m_Localized: Ben rüşvet kabul etmem
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157996
    m_Localized: 'Tourist: Kusura bakma ama şu an içeri gelemem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157997
    m_Localized: 'Tourist: O {0} burada. İyi anlaşabileceğimizi pek sanmıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157998
    m_Localized: Onu kovarım, sen gel
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157999
    m_Localized: Gitsen iyi olur
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158000
    m_Localized: 'Tourist: Çok teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158001
    m_Localized: 'Tourist: Tüh, yazık oldu.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
