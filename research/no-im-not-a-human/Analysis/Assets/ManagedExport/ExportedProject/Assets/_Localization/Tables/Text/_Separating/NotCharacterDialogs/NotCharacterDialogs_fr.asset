%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NotCharacterDialogs_fr
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: fdb5e7c1e1a06f94cb20bf63a5da666e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21953783779328
    m_Localized: 'TV: Flash spécial !'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556544
    m_Localized: 'TV: À 6 h 28 ce matin, le soleil a émis une forte quantité d''énergie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556545
    m_Localized: 'TV: Cette éruption solaire est bien plus intense que ce que les scientifiques avaient prévu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556546
    m_Localized: 'TV: La température extérieure a atteint des niveaux critiques.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556547
    m_Localized: 'TV: Le gouvernement a donc déclaré l''état d''urgence.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556548
    m_Localized: 'TV: Toute la population est priée de rester chez elle pendant la journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556549
    m_Localized: 'TV: Et maintenant, place à…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556550
    m_Localized: 'TV: Un instant, s''il vous plaît…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556551
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556552
    m_Localized: 'TV: Notre studio vient de recevoir un message urgent concernant les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556553
    m_Localized: 'TV: Selon plusieurs témoins oculaires, ces créatures seraient capables d''imiter l''apparence et le comportement des humains.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556554
    m_Localized: 'TV: Par mesure de sécurité, évitez toute interaction avec eux. On a pu identifier un signe distinctif pour les reconnaître…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556555
    m_Localized: 'TV: Leur dentition est parfaitement blanche.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556556
    m_Localized: 'TV: Un témoin oculaire a pu confirmer cette information.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556557
    m_Localized: 'TV: Il a rencontré un sans-abri aux dents parfaitement blanches qui s''est avéré être un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556558
    m_Localized: 'TV: C''est tout pour le moment. Gardez votre calme et ne quittez pas votre domicile pendant la journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556559
    m_Localized: 'TV: Et maintenant, une émission de divertissement.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556560
    m_Localized: 'TV: Bonjour. Voici les prévisions météorologiques.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556561
    m_Localized: 'TV: Un front chaud se dirige vers notre région, avec des températures qui dépasseront les précédents records.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556562
    m_Localized: 'TV: D''après les météorologues, on peut s''attendre à des températures plus élevées que jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556563
    m_Localized: 'TV: Les rayons UV vont également gagner en intensité en raison de cette activité solaire accrue.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556564
    m_Localized: 'TV: Pour votre sécurité, nous vous recommandons de ne pas vous exposer au soleil.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556565
    m_Localized: 'TV: La montée du mercure risque de provoquer des insolations.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556566
    m_Localized: 'TV: On ignore encore l''ampleur des effets néfastes que peut avoir l''exposition au soleil sur notre santé…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556567
    m_Localized: 'TV: Mais pour éviter toute brûlure au troisième degré, ne sortez pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556568
    m_Localized: 'TV: Malheureusement, aucune crème solaire ne peut vous protéger.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556569
    m_Localized: 'TV: C''est tout pour le moment. Et maintenant, place au divertissement.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556570
    m_Localized: 'TV: Vous regardez des ballerines danser avec grâce. Elles traversent la scène d''un pas à la fois ferme et délicat.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556571
    m_Localized: 'TV: Malgré leur élégance, la chorégraphie dégage une certaine anxiété.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556572
    m_Localized: 'TV: Vous vous demandez si elles essaient de détourner votre attention de la réalité.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556573
    m_Localized: 'TV: Si seulement quelqu''un pouvait vous expliquer ce qui se passe…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556574
    m_Localized: 'TV: Bonjour. Voici les dernières actualités du jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556575
    m_Localized: 'TV: L''activité solaire ne faiblit pas et le taux de criminalité a légèrement augmenté.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556576
    m_Localized: 'TV: Selon les statistiques, le nombre de meurtres commis au cours de ces dernières nuits a dépassé la moyenne habituelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556577
    m_Localized: 'TV: D''après les experts, cette hausse serait liée aux Visiteurs et au sentiment d''inquiétude au sein de la population.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556578
    m_Localized: 'TV: Aux dernières nouvelles, des témoins ont rapporté avoir observé un nouveau trait distinctif chez les Visiteurs :'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556579
    m_Localized: 'TV: ils ont de la terre sous les ongles.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556580
    m_Localized: 'TV: Selon les experts, ce signe permet d''identifier les Visiteurs qui ont rampé hors du sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556581
    m_Localized: 'TV: C''est tout pour le moment. Gardez votre calme et ne quittez pas votre domicile pendant la journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556582
    m_Localized: 'TV: À suivre, un reportage sur un psychopathe au teint blême. Mais d''abord, une pause publicitaire.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556583
    m_Localized: 'TV: Avant, faire les courses, c''était une vraie corvée : il fallait sortir, marcher, s''épuiser…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556584
    m_Localized: 'TV: Aujourd''hui, un simple appel suffit pour remplir vos placards.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556585
    m_Localized: 'TV: Appelez le XX-XX-XX-XX-XX et vos courses seront livrées à votre domicile dans un délai de 24 heures.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556586
    m_Localized: 'TV: For Rest : le goût du repos, livré chez vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556587
    m_Localized: 'TV: Un homme dérangé rôde dans les rues de la ville. Il a le teint particulièrement livide.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556588
    m_Localized: 'TV: D''après les témoignages, ses victimes avaient toutes un point commun : elles étaient seules.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556589
    m_Localized: 'TV: Le maniaque engage systématiquement la conversation avant de passer à l''acte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556590
    m_Localized: 'TV: La police a dressé un portrait-robot du suspect à partir de témoignages.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556591
    m_Localized: 'TV: L''homme d''âge moyen serait très pâle, mince et châtain foncé. Torse nu, il porterait uniquement un pantalon.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556592
    m_Localized: 'TV: Certains témoins affirment qu''il porterait la peau d''une autre personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556593
    m_Localized: 'TV: Cette information n''a pas été confirmée à ce stade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556594
    m_Localized: 'TV: Si vous le voyez, n''ouvrez pas la porte. Et surtout, dites-lui que vous n''êtes pas seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556595
    m_Localized: 'TV: C''est tout pour le moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556596
    m_Localized: 'TV: Bonjour. Voici les actualités du jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556597
    m_Localized: 'TV: La vague de chaleur anormale continue de s''intensifier, et l''invasion des Visiteurs ne semble pas ralentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750848
    m_Localized: 'TV: Le gouvernement a mis en place un service spécial pour faire face à cette situation.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750849
    m_Localized: 'TV: Il s''agit de la FEMA, ou Force d''Encadrement des Menaces Anormales.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750850
    m_Localized: 'TV: Vous reconnaîtrez les agents de la FEMA à leur combinaison jaune et leur masque à gaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750851
    m_Localized: 'TV: En dépit de sa récente création, l''agence a déjà découvert un nouveau signe distinctif des Visiteurs…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750852
    m_Localized: 'TV: Des yeux rouge sang.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750853
    m_Localized: 'TV: D''après nos sources, la FEMA a signalé ce signe après avoir observé des Visiteurs en détention.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750854
    m_Localized: 'TV: Ces créatures souffrent d''une photosensibilité accrue, qui provoque une inflammation et une rougeur des yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750855
    m_Localized: 'TV: Nous n''en savons pas plus pour l''instant. Gardez votre calme et ne quittez pas votre domicile pendant la journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750856
    m_Localized: 'TV: À suivre, une courte pause publicitaire suivie d''un reportage sur la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750857
    m_Localized: 'TV: Chaos. Terreur. Souffrance… Tout cela à cause des Visiteurs…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750858
    m_Localized: 'TV: Mais dans notre heure la plus sombre, alors que nos larmes inondent la terre…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750859
    m_Localized: 'TV: LA FEMA EST LÀ POUR NOUS !'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750860
    m_Localized: 'TV: Ces courageux héros de la Force d''Encadrement des Menaces Anormales risquent leur vie pour sauver les nôtres.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750861
    m_Localized: 'TV: À ce jour, l''agence a d''ores et déjà identifié plus de 27 000 créatures dangereuses.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750862
    m_Localized: 'TV: Et n''oubliez pas ! Vous aussi, vous pouvez aider en signalant toute activité suspecte autour de vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750863
    m_Localized: 'TV: Pour ce faire, utilisez votre invitation pour contacter la FEMA, tout simplement.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750864
    m_Localized: 'TV: Et si vous vous demandez si vous êtes vous-même un Visiteur, contactez notre service d''assistance par téléphone au {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750865
    m_Localized: 'TV: En aidant la FEMA, vous participez à la lutte contre les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750866
    m_Localized: 'TV: Qu''est-ce que la FEMA ? Pourquoi a-t-elle été créée ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750867
    m_Localized: 'TV: La Force d''Encadrement des Menaces Anormales est un service gouvernemental spécial formé pour gérer la crise émergente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750868
    m_Localized: 'TV: Son but est d''éradiquer les problèmes liés à l''invasion des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750869
    m_Localized: 'TV: On ignore encore précisément quelles missions sont encadrées par l''agence…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750870
    m_Localized: 'TV: Mais nous pouvons affirmer avec certitude que notre destin est entre de bonnes mains.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750871
    m_Localized: 'TV: La FEMA est composée d''experts de nombreux domaines, dont d''éminents scientifiques.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750872
    m_Localized: 'TV: Si un agent de la FEMA se présente à votre porte, coopérez et suivez ses instructions.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750873
    m_Localized: 'TV: Et rappelez-vous : en aidant la FEMA, vous soutenez la lutte contre les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750874
    m_Localized: 'TV: Bonjour à toutes et à tous. Voici les dernières informations du jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750875
    m_Localized: 'TV: La FEMA a adopté de nouvelles mesures pour remédier à la situation causée par les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750876
    m_Localized: 'TV: Elle a établi des zones de quarantaine où seront placés les individus potentiellement dangereux.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750877
    m_Localized: 'TV: De plus, suite à des tests menés sur les détenus, un nouveau signe distinctif a pu être identifié…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750878
    m_Localized: 'TV: Leurs aisselles sont totalement glabres.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750879
    m_Localized: 'TV: Selon l''agence, ce signe serait lié à l''absence totale de pilosité dans cette zone chez les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750880
    m_Localized: 'TV: Elle invite la population à coopérer pleinement aux procédures de contrôle et de transfert vers les quarantaines.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750881
    m_Localized: 'TV: C''est tout pour le moment. Gardez votre calme et ne quittez pas votre domicile pendant la journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750882
    m_Localized: 'TV: À venir : un bulletin d''information sur ce que vous devez faire si vous identifiez un visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750883
    m_Localized: 'TV: La FEMA estime que le phénomène des Visiteurs pourrait être contagieux ou représenter une grave menace biologique.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750884
    m_Localized: 'TV: Il est donc absolument impératif de signaler tout comportement suspect et d''isoler les individus concernés.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750885
    m_Localized: 'TV: Si vous ne pouvez pas conduire un Visiteur en zone de quarantaine, remettez-lui une convocation à la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750886
    m_Localized: 'TV: Lors du prochain passage, un agent prendra en charge toute personne détenant ce document afin de procéder aux examens.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750887
    m_Localized: 'TV: C''est tout pour l''instant. Nous revenons après une courte pause publicitaire.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750888
    m_Localized: 'TV: La chaleur ne vous arrêtera pas… Faites le plein d''énergie !'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750889
    m_Localized: 'TV: Avec Énerjéka, vivez à fond !'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750890
    m_Localized: 'TV: Une boisson énergisante qui étanche votre soif mieux et plus vite que l''eau.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750891
    m_Localized: 'TV: Commandez dès maintenant avec For Rest au XX-XX-XX-XX-XX.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750892
    m_Localized: 'Window: La maison de votre voisin se dresse au milieu d''une parcelle de foin.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750893
    m_Localized: 'Window: Il n''y a pas de lumière aux fenêtres. Sa famille doit déjà s''être laissée gagner par le sommeil.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750894
    m_Localized: 'Window: Un chien rachitique se tient sur le sentier qui traverse le champ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750895
    m_Localized: 'Window: Il regarde autour de lui d''un air morose, en quête de nourriture.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750896
    m_Localized: 'Window: Quelques poivrots gisent dans la rue.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750897
    m_Localized: 'Window: Ils ont l''air de dormir à poings fermés, même s''ils sont allongés sur le sol froid. Tout va bien pour eux en ce moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750898
    m_Localized: 'Window: Au loin, vous apercevez la maison de votre voisin, celui qui est venu vous rendre visite.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750899
    m_Localized: 'Window: La lumière traverse la fenêtre. On dirait que sa famille attend qu''il rentre chez lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750900
    m_Localized: 'Window: Vous remarquez plusieurs jeunes qui traînent dans la cour.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750901
    m_Localized: 'Window: Ils sont assis là, sans se soucier de quoi que ce soit. Ils bavardent sans vous prêter la moindre attention.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750902
    m_Localized: 'Window: Dehors, il règne un silence de mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750903
    m_Localized: 'Window: Il n''y a pas âme qui vive.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750904
    m_Localized: 'Window: Même les ivrognes ont décidé de ne pas sortir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750905
    m_Localized: 'Window: Auraient-ils peur de quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750906
    m_Localized: 'Window: Vous apercevez votre voisin et sa fille par la fenêtre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750907
    m_Localized: 'Window: Ils jouent et ont l''air heureux, comme s''ils avaient oublié l''horreur ambiante…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750908
    m_Localized: 'Window: … ne serait-ce qu''un instant.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750909
    m_Localized: 'Window: Les corps des jeunes sont étendus sur le sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750910
    m_Localized: 'Window: Quelqu''un les a tués.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750911
    m_Localized: 'Window: Le meurtre semble récent. Le sang n''a pas encore séché.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750912
    m_Localized: 'Window: Un homme plus pâle que la mort se tient sur le sentier.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750913
    m_Localized: 'Window: Sa peau est parcourue d''étranges plis.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750914
    m_Localized: 'Window: Comme si sa peau n''avait pas la bonne taille pour son corps.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750915
    m_Localized: 'Window: Vous ne pouvez pas voir ses yeux d''ici, mais vous sentez que son regard est en train de vous transpercer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750916
    m_Localized: 'Window: Vous êtes saisi d''effroi et vous priez le ciel pour que le sinistre Visiteur ne s''arrête pas chez vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750917
    m_Localized: 'Window: Un petit groupe d''agents de la FEMA se tient près de la maison de votre voisin.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750918
    m_Localized: 'Window: Vous vous demandez de quoi ils parlent.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750919
    m_Localized: 'Window: Ils prélèvent peut-être des échantillons de sol ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750920
    m_Localized: 'Window: Ou encore, ils cherchent un endroit où installer une base ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750921
    m_Localized: 'Window: Les corps calcinés des adolescents jonchent le sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750922
    m_Localized: 'Window: On dirait qu''ils ont passé la journée là.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750923
    m_Localized: 'Window: Deux agents de la FEMA se tiennent à côté des corps. Ils sont en train d''écrire quelque chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750924
    m_Localized: 'Window: Heureusement qu''ils sont venus emporter les corps.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750925
    m_Localized: 'Window: Mieux vaut ne pas imaginer quel genre de maladie pourrait se propager si les cadavres se décomposaient sur place.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750926
    m_Localized: 'Window: Vous voyez un groupe de soldats armés par la fenêtre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750927
    m_Localized: 'Window: Apparemment, il s''agit d''une petite escouade envoyée par la ville pour assurer la sécurité des employés de la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750928
    m_Localized: 'Window: Vous retenez des bribes d''informations concernant un homme pâle au torse nu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750929
    m_Localized: 'Window: Peut-être cherchent-ils à débusquer l''effrayant Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750930
    m_Localized: 'Window: La maison de votre voisin, qu''il venait de peindre en blanc, a brûlé. Elle est désormais noir charbon.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750931
    m_Localized: 'Window: Apparemment, le feu s''est éteint il y a peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750932
    m_Localized: 'Window: Est-ce que cet incendie pourrait être d''origine criminelle ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750933
    m_Localized: 'Window: Qu''est-il arrivé à la famille du voisin ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750934
    m_Localized: 'Window: Est-ce que quelqu''un est encore en vie ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750935
    m_Localized: 'Window: Les pensées angoissantes se bousculent dans votre tête alors que l''incompréhension et l''impuissance s''emparent de vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750936
    m_Localized: 'Window: L''effrayant homme pâle se tient sur le trottoir. Il sourit.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750937
    m_Localized: 'Window: Il tient la tête décapitée de quelqu''un dans un casque.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750938
    m_Localized: 'Window: C''est celle d''un soldat, dont le visage s''est figé dans une grimace de terreur.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750939
    m_Localized: 'Window: Difficile de savoir ce qui l''a tant terrorisé : le Visiteur pâle ou sa mort imminente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750940
    m_Localized: 'Window: La totalité de la troupe de soldats qui se trouvait ici hier est morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750941
    m_Localized: 'Window: C''est une véritable hécatombe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750942
    m_Localized: 'Window: Les corps sont éparpillés aux quatre coins de la rue, et l''un d''entre eux n''a plus de tête.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750943
    m_Localized: 'Window: Est-ce que cet étranger pâle et effrayant les a massacrés ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750944
    m_Localized: « Centre des services d'urgence, bonjour. Comment puis-je vous aider ? » « Les gens… Ils brûlent. »
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750945
    m_Localized: « Dites-moi ce que vous voyez. C'est un incendie ? » « Non, c'est le soleil. Ils… Ils brûlent à cause du soleil. »
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750946
    m_Localized: « Ne sortez qu'à la nuit tombée. » « Non, ce type pâle et maigre sort uniquement la nuit… C'est pas un humain. »
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750947
    m_Localized: Et à présent, notre nouveau programme, « Si, si. Je suis un humain ».
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750948
    m_Localized: 'Le principe est simple : vous nous envoyez vos photos et nous vérifions si vous êtes vraiment humain.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750949
    m_Localized: 'Envoyez-nous simplement vos photos par e-mail à l''adresse suivante : yesiam@humanverification.agency. Nous nous occupons du reste.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750950
    m_Localized: Vos yeux, dents et ongles doivent être clairement visibles sur le cliché sans quoi nous ne pourrons pas l'accepter…
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750951
    m_Localized: Avez-vous les yeux rouges ? Vos dents sont-elles blanches ? Y a-t-il de la terre sous vos ongles ?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750952
    m_Localized: Un esprit démoniaque vous possède ? Vous êtes un Visiteur !
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750953
    m_Localized: Ne laissez pas ce fléau s'emparer de votre corps ! Appelez immédiatement nos experts au 777-460.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750954
    m_Localized: Ils vous exorciseront, purifierons votre corps de cette aura pernicieuse et vous conféreront une protection renforcée.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750955
    m_Localized: Bienvenue à tous. C'est l'heure de « Je veux croire », l'émission où on expose les mystères et complots du gouvernement.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750956
    m_Localized: Aujourd'hui, on vous dit toute la vérité sur les Visiteurs avec notre invité. Docteur en sciences et membre respecté…
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750957
    m_Localized: Euh… Quoi ?! Il vient pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750958
    m_Localized: Comment ont-ils pu voler tous ses documents ? Il y a des TONNES d'infos là-dedans !
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750959
    m_Localized: Bon sang. Je savais qu'on nous laisserait pas révéler la vérité. Les enfoirés…
    m_Metadata:
      m_Items: []
  - m_Id: 17738415503822848
    m_Localized: 'TV: Il était une fois deux frères qui vivaient près d''un barrage.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182976
    m_Localized: 'TV: Au doux son du clapotis de l''eau, ils ne pouvaient s''empêcher de penser à des boissons fraîches et mousseuses…'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182977
    m_Localized: 'TV: C''est ainsi qu''une fois adultes, ils ont créé ensemble la brasserie Bober.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182978
    m_Localized: 'TV: La Bober Černý est devenue aujourd''hui une des bières les plus populaires au monde, en magasin comme dans les bars.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182979
    m_Localized: 'TV: Bober Černý : buvez bien, buvez tout plein.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182980
    m_Localized: 'Window: Vous contemplez les ruines de la maison de votre voisin.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182981
    m_Localized: 'Window: Il n''en reste plus que le fantôme de la structure, alors qu''une famille heureuse vivait ici il y a peu…'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182982
    m_Localized: 'Window: Un sentiment étrange vous envahit, comme si vous vous attendiez à ce qu''une telle chose arrive…'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182983
    m_Localized: 'Window: C''est comme si… vous saviez dans vos entrailles que la mort allait frapper ce foyer de façon imminente.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182984
    m_Localized: 'Window: Vous voyez un pieu sur lequel est posé un crâne coiffé d''un casque.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182985
    m_Localized: 'Window: Le crâne est recouvert d''une peau noire et brûlée. On dirait que les dents ont été arrachées.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182986
    m_Localized: 'Window: La tête est restée là toute la journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182987
    m_Localized: 'Window: Cet arrangement grinçant ressemble à une menace. Il est sans doute l''œuvre de cet effrayant Visiteur blafard.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182988
    m_Localized: 'Window: Les agents de la FEMA inspectent les lieux où s''est déroulé le tout récent massacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182989
    m_Localized: 'Window: Ils emportent tous les équipements et les armes des soldats morts pour éviter que les pillards ne s''en emparent.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182990
    m_Localized: 'Window: Ils pensaient sans doute que le Visiteur pâle ne survivrait pas à une confrontation avec la troupe armée.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182991
    m_Localized: 'Window: Maintenant, il y a encore plus de sacs remplis de cadavres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576140324864
    m_Localized: 'TV: Bonjour. Voici les prévisions météorologiques.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102080
    m_Localized: 'TV: Un front chaud se dirige vers notre région, avec des températures qui dépasseront les précédents records.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102081
    m_Localized: 'TV: D''après les météorologues, on peut s''attendre à des températures plus élevées que jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102082
    m_Localized: 'TV: Les rayons UV vont également gagner en intensité en raison de cette activité solaire accrue.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102083
    m_Localized: 'TV: Pour votre sécurité, nous vous recommandons de ne pas vous exposer au soleil.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102084
    m_Localized: 'TV: La montée du mercure risque de provoquer des insolations.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102085
    m_Localized: 'TV: On ignore encore l''ampleur des effets néfastes que peut avoir l''exposition au soleil sur notre santé…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102086
    m_Localized: 'TV: Mais pour éviter toute brûlure au troisième degré, ne sortez pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102087
    m_Localized: 'TV: Malheureusement, aucune crème solaire ne peut vous protéger.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102089
    m_Localized: 'TV: Vous regardez des ballerines danser avec grâce. Elles traversent la scène d''un pas à la fois ferme et délicat.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102090
    m_Localized: 'TV: Malgré leur élégance, la chorégraphie dégage une certaine anxiété.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102091
    m_Localized: 'TV: Vous vous demandez si elles essaient de détourner votre attention de la réalité.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102092
    m_Localized: 'TV: Si seulement quelqu''un pouvait vous expliquer ce qui se passe…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102093
    m_Localized: 'TV: Avant, faire les courses, c''était une vraie corvée: il fallait sortir, marcher, s''épuiser…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102094
    m_Localized: 'TV: Aujourd''hui, un simple appel suffit pour remplir vos placards.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102095
    m_Localized: 'TV: Appelez le {0} et laissez For Rest livrer votre tranquillité à domicile en un jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102096
    m_Localized: 'TV: For Rest : le goût du repos, livré chez vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102097
    m_Localized: 'TV: Un homme dérangé rôde dans les rues de la ville. Il a le teint particulièrement livide.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102098
    m_Localized: 'TV: D''après les témoignages, ses victimes avaient toutes un point commun : elles étaient seules.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102099
    m_Localized: 'TV: Le maniaque engage systématiquement la conversation avant de passer à l''acte.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102100
    m_Localized: 'TV: La police a dressé un portrait-robot du suspect à partir de témoignages.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102101
    m_Localized: 'TV: L''homme d''âge moyen serait très pâle, mince et châtain foncé. Torse nu, il porterait uniquement un pantalon.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102102
    m_Localized: 'TV: Certains témoins affirment qu''il porterait la peau d''une autre personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102103
    m_Localized: 'TV: Cette information n''a pas été confirmée à ce stade.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102104
    m_Localized: 'TV: Si vous le voyez, n''ouvrez pas la porte. Et surtout, dites-lui que vous n''êtes pas seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102106
    m_Localized: 'TV: Chaos. Terreur. Souffrance… Tout cela à cause des Visiteurs…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102107
    m_Localized: 'TV: Mais dans notre heure la plus sombre, alors que nos larmes inondent la terre…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102108
    m_Localized: 'TV: LA FEMA EST LÀ POUR NOUS !'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102109
    m_Localized: 'TV: Ces courageux héros de la Force d''Encadrement des Menaces Anormales risquent leur vie pour sauver les nôtres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102110
    m_Localized: 'TV: À ce jour, l''agence a d''ores et déjà identifié plus de 27 000 créatures dangereuses.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102111
    m_Localized: 'TV: Et n''oubliez pas ! Vous aussi, vous pouvez aider en signalant toute activité suspecte autour de vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102112
    m_Localized: 'TV: Pour ce faire, utilisez votre bulletin pour contacter la FEMA, tout simplement.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102113
    m_Localized: 'TV: Et en cas de doute sur un Visiteur ou un proche, appelez immédiatement le numéro d''urgence : {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102114
    m_Localized: 'TV: En aidant la FEMA, vous participez à la lutte contre les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102115
    m_Localized: 'TV: Qu''est-ce que la FEMA ? Pourquoi a-t-elle été créée ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102116
    m_Localized: 'TV: La Force d''Encadrement des Menaces Anormales est un service gouvernemental spécial formé pour gérer la crise émergente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102117
    m_Localized: 'TV: Son but est d''éradiquer les problèmes liés à l''invasion des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102118
    m_Localized: 'TV: On ignore encore précisément quelles missions sont encadrées par l''agence…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102119
    m_Localized: 'TV: Mais nous pouvons affirmer avec certitude que notre destin est entre de bonnes mains.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102120
    m_Localized: 'TV: La FEMA est composée d''experts de nombreux domaines, dont d''éminents scientifiques.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102121
    m_Localized: 'TV: Si un agent de la FEMA se présente à votre porte, coopérez et suivez ses instructions.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102122
    m_Localized: 'TV: Et rappelez-vous : en aidant la FEMA, vous soutenez la lutte contre les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102123
    m_Localized: 'TV: La FEMA estime que le phénomène des Visiteurs pourrait être contagieux ou représenter une grave menace biologique.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102124
    m_Localized: 'TV: Il est donc absolument impératif de signaler tout comportement suspect et d''isoler les individus concernés.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102125
    m_Localized: 'TV: Si vous ne pouvez pas conduire un Visiteur en zone de quarantaine, remettez-lui une convocation à la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102126
    m_Localized: 'TV: Lors du prochain passage, un agent prendra en charge toute personne détenant ce document afin de procéder aux examens.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102128
    m_Localized: 'TV: La chaleur ne vous arrêtera pas… Faites le plein d''énergie !'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102129
    m_Localized: 'TV: Avec Énerjéka, vivez à fond !'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102130
    m_Localized: 'TV: Une boisson énergisante qui étanche votre soif mieux et plus vite que l''eau.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102131
    m_Localized: 'TV: Commandez dès maintenant avec For Rest au {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296387
    m_Localized: 'TV: Il était une fois deux frères qui vivaient près d''un barrage.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296388
    m_Localized: 'TV: Au doux son du clapotis de l''eau, ils ne pouvaient s''empêcher de penser à des boissons fraîches et mousseuses…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296389
    m_Localized: 'TV: C''est ainsi qu''une fois adultes, ils ont créé ensemble la brasserie Bober.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296390
    m_Localized: 'TV: La Bober Černý est devenue aujourd''hui une des bières les plus populaires au monde, en magasin comme dans les bars.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296391
    m_Localized: 'TV: Bober Černý : buvez bien, buvez tout plein.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296517
    m_Localized: 'Window: La maison de votre voisin se dresse au milieu d''une parcelle de foin.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296518
    m_Localized: 'Window: Il n''y a pas de lumière aux fenêtres. Sa famille doit déjà s''être laissée gagner par le sommeil.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296519
    m_Localized: 'Window: Quelques poivrots gisent dans la rue.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296520
    m_Localized: 'Window: Ils ont l''air de dormir à poings fermés, même s''ils sont allongés sur le sol froid. Tout va bien pour eux en ce moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296521
    m_Localized: 'Window: Au loin, vous apercevez la maison de votre voisin, celui qui est venu vous rendre visite.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296522
    m_Localized: 'Window: La lumière traverse la fenêtre. On dirait que sa famille attend qu''il rentre chez lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296523
    m_Localized: 'Window: Dehors, il règne un silence de mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296524
    m_Localized: 'Window: Il n''y a pas âme qui vive.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296525
    m_Localized: 'Window: Même les ivrognes ont décidé de ne pas sortir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296526
    m_Localized: 'Window: Auraient-ils peur de quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296527
    m_Localized: 'Window: Vous apercevez votre voisin et sa fille par la fenêtre.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296528
    m_Localized: 'Window: Ils jouent et ont l''air heureux, comme s''ils avaient oublié l''horreur ambiante…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296529
    m_Localized: 'Window: … ne serait-ce qu''un instant.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296530
    m_Localized: 'Window: Un homme plus pâle que la mort se tient sur le sentier.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296531
    m_Localized: 'Window: Sa peau est parcourue d''étranges plis.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296532
    m_Localized: 'Window: Comme si sa peau n''avait pas la bonne taille pour son corps.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296533
    m_Localized: 'Window: Vous ne pouvez pas voir ses yeux d''ici, mais vous sentez que son regard est en train de vous transpercer.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296534
    m_Localized: 'Window: Vous êtes saisi d''effroi et vous priez le ciel pour que le sinistre Visiteur ne s''arrête pas chez vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296535
    m_Localized: 'Window: Un petit groupe d''agents de la FEMA se tient près de la maison de votre voisin.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296536
    m_Localized: 'Window: Vous vous demandez de quoi ils parlent.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296537
    m_Localized: 'Window: Ils prélèvent peut-être des échantillons de sol ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296538
    m_Localized: 'Window: Ou encore, ils cherchent un endroit où installer une base ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296539
    m_Localized: 'Window: Vous voyez un groupe de soldats armés par la fenêtre.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296540
    m_Localized: 'Window: Apparemment, il s''agit d''une petite escouade envoyée par la ville pour assurer la sécurité des employés de la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296541
    m_Localized: 'Window: Vous retenez des bribes d''informations concernant un homme pâle au torse nu.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296542
    m_Localized: 'Window: Peut-être cherchent-ils à débusquer l''effrayant Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296543
    m_Localized: 'Window: La maison de votre voisin, qu''il venait de peindre en blanc, est en train de brûler. Elle est désormais noir charbon.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296544
    m_Localized: 'Window: Apparemment, il y a peu de temps que le feu s''est déclénché.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296545
    m_Localized: 'Window: Est-ce que cet incendie pourrait être d''origine criminelle ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296546
    m_Localized: 'Window: Qu''est-il arrivé à la famille du voisin ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296547
    m_Localized: 'Window: Est-ce que quelqu''un est encore en vie ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296548
    m_Localized: 'Window: Les pensées angoissantes se bousculent dans votre tête alors que l''incompréhension et l''impuissance s''emparent de vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296549
    m_Localized: 'Window: La totalité de la troupe de soldats qui se trouvait ici hier est morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296550
    m_Localized: 'Window: C''est une véritable hécatombe.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296551
    m_Localized: 'Window: Les corps sont éparpillés aux quatre coins de la rue, et l''un d''entre eux n''a plus de tête.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296552
    m_Localized: 'Window: Est-ce que cet étranger pâle et effrayant les a massacrés ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296553
    m_Localized: 'Window: Vous contemplez les ruines de la maison de votre voisin.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296554
    m_Localized: 'Window: Il n''en reste plus que le fantôme de la structure, alors qu''une famille heureuse vivait ici il y a peu…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296555
    m_Localized: 'Window: Un sentiment étrange vous envahit, comme si vous vous attendiez à ce qu''une telle chose arrive…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296556
    m_Localized: 'Window: C''est comme si… vous saviez dans vos entrailles que la mort allait frapper ce foyer de façon imminente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296557
    m_Localized: 'Window: Vous voyez un pieu sur lequel est posé un crâne coiffé d''un casque.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296558
    m_Localized: 'Window: Le crâne est recouvert d''une peau noire et brûlée. On dirait que les dents ont été arrachées.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296559
    m_Localized: 'Window: La tête est restée là toute la journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296560
    m_Localized: 'Window: Cet arrangement grinçant ressemble à une menace. Il est sans doute l''œuvre de cet effrayant Visiteur blafard.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296561
    m_Localized: 'Window: Les agents de la FEMA inspectent les lieux où s''est déroulé le tout récent massacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296562
    m_Localized: 'Window: Ils emportent tous les équipements et les armes des soldats morts pour éviter que les pillards ne s''en emparent.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296563
    m_Localized: 'Window: Ils pensaient sans doute que le Visiteur pâle ne survivrait pas à une confrontation avec la troupe armée.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296564
    m_Localized: 'Window: Maintenant, il y a encore plus de sacs remplis de cadavres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102088
    m_Localized: 'TV: À suivre, les actualités météorologiques. Mais avant cela, voici un message de nos partenaires.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102105
    m_Localized: 'TV: C''est tout pour le moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102127
    m_Localized: 'TV: C''est tout pour le moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102132
    m_Localized: 'TV: Mesdames, messieurs, bonjour. Voici les actualités du jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102133
    m_Localized: 'TV: Face à la hausse marquée de cas suspectés de Visiteurs, la FEMA a mis de nouvelles mesures en vigueur.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102134
    m_Localized: 'TV: À compter de ce jour, une quarantaine totale sera appliquée dans toutes les grandes villes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102135
    m_Localized: 'TV: Les déplacements en dehors de votre ville ou des localités voisines sont strictement interdits.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102136
    m_Localized: 'TV: Vous avez l''obligation de rester dans votre secteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102137
    m_Localized: 'TV: En outre, la FEMA a annoncé une nouvelle méthode d''identification…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102138
    m_Localized: 'TV: La photographie d''aura sur pellicule.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102139
    m_Localized: 'TV: Si des taches sombres apparaissent sur l''image de l''aura d''un sujet, il est fort probable qu''il s''agisse d''un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102140
    m_Localized: 'TV: Voilà pour ce qui est des dernières nouvelles. Gardez votre calme et restez à l''intérieur pendant la journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102141
    m_Localized: 'TV: Et à présent, un mot de nos partenaires.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102142
    m_Localized: 'TV: Que sont les Visiteurs ? Des fantômes ? Des monstres venus des profondeurs ?… Et si c''était votre voisin du dessus ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102143
    m_Localized: 'TV: Rien de tout cela n''est de la fiction tirée d''un mauvais livre de gare…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102144
    m_Localized: 'TV: C''est notre réalité à tous, désormais.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102145
    m_Localized: 'TV: Les rumeurs continuent d''aller bon train sur leur véritable origine.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102146
    m_Localized: 'TV: Des extraterrestres ? Des morts-vivants ? Une expérience de laboratoire qui a mal tourné ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102147
    m_Localized: 'TV: Selon la FEMA, tout cela ne reste que des théories.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102148
    m_Localized: 'TV: Pour elle, un Visiteur est un humain ayant été en contact avec un virus ou un autre agent biologique.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102149
    m_Localized: 'TV: Le mode de transmission reste inconnu. Mais la FEMA appelle chacun à rester attentif aux symptômes des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102150
    m_Localized: 'TV: Si vous pensez avoir été exposé, ou si vous avez le moindre doute, appelez la ligne directe de la FEMA :'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102151
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102152
    m_Localized: 'TV: Voilà pour l''instant. Ne bougez pas, on revient juste après la pause.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102153
    m_Localized: 'TV: Chaque jour, identifier les Visiteurs devient de plus en plus difficile.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102154
    m_Localized: 'TV: Les symptômes aident, certes… Mais comment faire pour avoir une certitude absolue ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102155
    m_Localized: 'TV: Découvrez notre pellicule photographique révolutionnaire !'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102156
    m_Localized: 'TV: Grâce à elle, vous pouvez voir l''énergie de l''âme. Idéal pour distinguer les humains des Visiteurs hostiles.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102157
    m_Localized: 'TV: Prenez une photo et, si vous voyez des taches noires, c''est que vous êtes en présence d''un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102158
    m_Localized: 'TV: Appelez dès maintenant le {0} pour recevoir gratuitement votre coffret Découverte.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102159
    m_Localized: 'TV: Flash spécial !'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102160
    m_Localized: 'TV: Le soleil frappe encore plus fort… De violents incendies font rage dans les zones forestières.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102161
    m_Localized: 'TV: D''après les experts, cela serait dû à l''activité solaire anormalement intense.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102162
    m_Localized: 'TV: Si l''ampleur de la catastrophe reste incertaine, les pompiers des villes voisines ont été appelés en renfort.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296384
    m_Localized: 'TV: Nous n''en savons pas plus pour le moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296385
    m_Localized: 'TV: Ne cédez pas à la panique et restez à l''intérieur pendant la journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296386
    m_Localized: 'TV: À suivre : un message de nos partenaires.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296392
    m_Localized: 'TV: Nous interrompons nos programmes pour vous communiquer une information de dernière minute.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296393
    m_Localized: 'TV: Des informations faisant état de troubles civils dans une ville voisine nous ont été rapportées.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296394
    m_Localized: 'TV: En raison de circonstances non résolues, les forces de la FEMA ont entièrement isolé la zone.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296395
    m_Localized: 'TV: Veuillez rester chez vous. Des instructions supplémentaires seront communiquées sous peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296396
    m_Localized: 'TV: En coopérant avec l''Agence, vous contribuez à la sécurité de tous.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296397
    m_Localized: 'TV: C''est tout pour le moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296398
    m_Localized: 'TV: Restez où vous êtes et attendez de nouvelles consignes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296399
    m_Localized: 'TV: Même les travailleurs les plus acharnés ont besoin d''une pause.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296400
    m_Localized: 'TV: Avec les cigarettes Margoro, offrez-vous une vraie bouffée d''air.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296401
    m_Localized: 'TV: Margoro. Des cigarettes pour les hommes, les vrais.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296402
    m_Localized: 'TV: (Clause de non-responsabilité : la marque n''assume aucun préjudice à votre santé ou à votre vie.)'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296403
    m_Localized: 'TV: Bonjour à toutes et à tous. Vous regardez les informations du jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296404
    m_Localized: 'TV: Nous avons une nouvelle importante à vous communiquer.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296405
    m_Localized: 'TV: De nouveaux détails ont été révélés concernant l''incident qui a récemment eu lieu en ville.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296406
    m_Localized: 'TV: L''une des zones de quarantaine a été prise d''assaut par un individu armé.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296407
    m_Localized: 'TV: Pour l''heure, le mobile reste inconnu et l''on ignore si le tireur avait des complices.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296408
    m_Localized: 'TV: Plusieurs individus dont le statut reste indéterminé se sont échappés.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296409
    m_Localized: 'TV: Le silence est un signe de mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296410
    m_Localized: 'TV: Un silence qui vide l''âme.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296411
    m_Localized: 'TV: Mais pire que le vide… il y a le tintement.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296412
    m_Localized: 'TV: Le tintement des cloches des funérailles'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296413
    m_Localized: 'TV: Quand les cloches sonnent, quelque chose grandit dans les oreilles.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296414
    m_Localized: 'TV: Tout ce qui reste, c''est le cérumen. Des pensées obscènes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296415
    m_Localized: 'TV: Voilà de quoi se nourrissent les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296416
    m_Localized: 'TV: Les Visiteurs s''emmêlent dans les toiles de la pensée.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296417
    m_Localized: 'TV: Pour eux, les cloches tintent plus fort encore. Et il y a plus de cérumen.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296418
    m_Localized: 'TV: L''incident d''aujourd''hui fait déjà l''objet de nombreuses spéculations et les témoins ne s''accordent pas sur les faits.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296419
    m_Localized: 'TV: Certains rapports font état d''un tireur isolé, tandis que d''autres décrivent un groupe armé vêtu de capuches.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296420
    m_Localized: 'TV: Quoi qu''il en soit, le pire reste peut-être encore à venir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296421
    m_Localized: 'TV: Avec la ville bouclée, le retrait et l''élimination des corps dans la zone affectée sont suspendus jusqu''à nouvel ordre.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296422
    m_Localized: 'TV: Cependant, les inspections des habitations, elles, continueront d''avoir lieu.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296423
    m_Localized: 'TV: Si vous êtes en mesure d''incinérer les dépouilles, faites-le immédiatement.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296424
    m_Localized: 'TV: Dans le cas contraire, gardez les corps pour les remettre aux autorités compétentes une fois la situation résolue.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296425
    m_Localized: 'TV: C''était le point sur la situation. Restez à l''écoute… et surtout, restez où vous êtes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296426
    m_Localized: 'TV: Mesdames, messieurs, bonjour. Voici les actualités du jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296427
    m_Localized: 'TV: La FEMA porte actuellement assistance aux victimes de l''attaque de la zone de quarantaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296428
    m_Localized: 'TV: En raison de la surpopulation dans les installations existantes, l''agence a pris la décision suivante :'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296429
    m_Localized: 'TV: Les résidents évacués seront temporairement relogés dans des bâtiments situés en périphérie de la ville.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296430
    m_Localized: 'TV: Heureusement, les habitants concernés ont coopéré avec la FEMA et proposé d''héberger des évacués.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296431
    m_Localized: 'TV: Cependant, une partie des individus évadés reste introuvable.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296432
    m_Localized: 'TV: En attendant, un nouveau signe de reconnaissance vient d''être communiqué…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296433
    m_Localized: 'TV: Il s''agit de saignements au niveau des gencives.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296434
    m_Localized: 'TV: Si vous croisez une personne présentant ce symptôme, ne tentez pas de lui parler ni de l''approcher.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296435
    m_Localized: 'TV: Attendez la patrouille prévue et signalez la personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296436
    m_Localized: 'TV: C''était notre dernier point.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296437
    m_Localized: 'TV: Restez à l''intérieur et attendez la suite des consignes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296438
    m_Localized: 'TV: À suivre, un reportage spécial sur une nouvelle secte particulièrement dangereuse.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296439
    m_Localized: 'TV: Les Visiteurs ne se contentent pas de se cacher parmi nous. Ils pourraient bien s''immiscer jusque dans nos pensées.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296440
    m_Localized: 'TV: Plusieurs villes font état d''une recrudescence inquiétante d''activités sectaires.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296441
    m_Localized: 'TV: Les accusations portées contre eux incluent, sans s''y limiter :'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296442
    m_Localized: 'TV: des sacrifices rituels, un culte voué à une divinité inconnue et des liens possibles avec les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296443
    m_Localized: 'TV: Selon les derniers rapports, ce groupe a désormais pris publiquement position contre la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296444
    m_Localized: 'TV: Ce qui n''était au départ que de simples paroles a dégénéré en propagande et en action directe.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296445
    m_Localized: 'TV: Cette secte pourrait être responsable des événements récents qui ont eu lieu dans la ville.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296446
    m_Localized: 'TV: Les téléspectateurs sont priés d''éviter tout contact avec les membres de cette soi-disant « nouvelle religion ».'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296447
    m_Localized: 'TV: Le simple fait de les aider ou de sympathiser avec eux pourrait entraîner votre arrestation.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296448
    m_Localized: 'TV: C''est tout pour l''instant. Restez à l''écoute.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296449
    m_Localized: 'TV: Mesdames, messieurs, bonjour. Vous regardez les informations du jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296450
    m_Localized: 'TV: La situation dans la ville se stabilise peu à peu, mais les fugitifs sont toujours introuvables.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296451
    m_Localized: 'TV: Entre-temps, les opérations de ramassage des corps ont repris, mais de nouveaux problèmes ont fait leur apparition.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296452
    m_Localized: 'TV: Selon les derniers rapports, des meutes de chiens errants rôdent désormais dans les rues.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296453
    m_Localized: 'TV: La FEMA a déployé une équipe pour faire face à cette menace.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296454
    m_Localized: 'TV: L''agence vient aussi d''annoncer un autre signe distinctif pour identifier les individus potentiellement dangereux…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296455
    m_Localized: 'TV: Les éruptions cutanées.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296456
    m_Localized: 'TV: L''enquête menée sur l''attaque de la ville suit toujours son cours.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296457
    m_Localized: 'TV: On ignore encore si l''assaillant a agi seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296458
    m_Localized: 'TV: Mais une chose est sûre : la FEMA finira tôt ou tard par contenir cette menace, de même que celle des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296459
    m_Localized: 'TV: Si vous avez des questions quant aux signes distinctifs des Visiteurs, appelez la ligne directe de la FEMA :'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296460
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296461
    m_Localized: 'TV: Comme toujours, restez où vous êtes et attendez d''autres instructions.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296462
    m_Localized: 'TV: … C''est tout pour le moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296463
    m_Localized: 'TV: À suivre, un point sur la situation dans les régions de la ceinture équatoriale.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296464
    m_Localized: 'TV: Des nouvelles inquiétantes nous parviennent ce soir des régions équatoriales à travers le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296465
    m_Localized: 'TV: Plusieurs pays sont en proie à des incendies de grande ampleur, à une canicule extrême et aux ravages de la sécheresse.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296466
    m_Localized: 'TV: Les températures sont si élevées que le simple contact avec le sol peut provoquer des brûlures au troisième degré.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296467
    m_Localized: 'TV: Pour l''heure, le bilan reste inconnu et toute évacuation est actuellement inenvisageable.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296468
    m_Localized: 'TV: À ce jour, notre gouvernement ne parvient pas à établir le contact avec les autorités des zones touchées.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296469
    m_Localized: 'TV: Toutefois, dès que les conditions le permettront, des agents de la FEMA seront déployés pour apporter leur aide.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296470
    m_Localized: 'TV: C''est tout pour le moment. Restez à l''écoute.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296471
    m_Localized: 'TV: Bonjour et bienvenue dans notre journal d''information.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296472
    m_Localized: 'TV: La situation dans la ville reste instable et le cordon de sécurité est toujours en place.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296473
    m_Localized: 'TV: Par ailleurs, une nouvelle menace est apparue. Des membres de la secte interdite ont été aperçus aux abords de la ville.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296474
    m_Localized: 'TV: Selon les derniers rapports, ils prévoiraient d''organiser un rituel impliquant un bûcher à ciel ouvert.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296475
    m_Localized: 'TV: La FEMA pense que ce groupuscule pourrait être à l''origine des attaques perpétrées dans les zones de quarantaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296476
    m_Localized: 'TV: Malheureusement, au vu de la situation actuelle, aucune force spéciale ne peut être déployée pour régler le problème.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296477
    m_Localized: 'TV: Si des membres de la secte s''approchent de votre domicile, appelez immédiatement la ligne directe de la FEMA : {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296478
    m_Localized: 'TV: L''agence a également annoncé un nouveau signe distinctif…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296479
    m_Localized: 'TV: La présence de champignons se développant dans la zone des aisselles.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296480
    m_Localized: 'TV: C''est la fin de ce bulletin.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296481
    m_Localized: 'TV: Comme toujours, restez où vous êtes jusqu''à nouvel ordre.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296482
    m_Localized: 'TV: À suivre, des informations sur la situation aux pôles de la planète.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296483
    m_Localized: 'TV: Le soleil frappe à nouveau.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296484
    m_Localized: 'TV: Les scientifiques ont publié de nouvelles projections inquiétantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296485
    m_Localized: 'TV: Si la canicule ne faiblit pas, les calottes pourraient fondre complètement, entraînant des inondations catastrophiques.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296486
    m_Localized: 'TV: Les chercheurs continuent d''étudier cette fièvre planétaire, mais ils restent sans réponse pour le moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296487
    m_Localized: 'TV: Voilà les dernières nouvelles. Restez à l''écoute.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296488
    m_Localized: 'TV: Flash spécial.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296489
    m_Localized: 'TV: La situation dans la ville ne montre aucun signe d''amélioration. La catastrophe naturelle continue de s''aggraver.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296490
    m_Localized: 'TV: Avec la fonte des glaciers, le niveau de la mer monte à une vitesse inquiétante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296491
    m_Localized: 'TV: Ce phénomène pourrait provoquer l''inondation des zones littorales, y compris des grandes villes côtières.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296492
    m_Localized: 'TV: Plusieurs lacs contaminés, connus pour leur forte radioactivité, ont commencé à s''évaporer.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296493
    m_Localized: 'TV: Les scientifiques mettent en garde contre le risque de pluies acides.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296494
    m_Localized: 'TV: Si vous entendez le tonnerre, mettez-vous immédiatement à l''abri pour vous protéger.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296495
    m_Localized: 'TV: Malheureusement, la ville reste bouclée par un cordon de sécurité.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296496
    m_Localized: 'TV: La FEMA n''a pas encore capturé tous les fugitifs… Elle vient d''annoncer une nouvelle caractéristique des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296497
    m_Localized: 'TV: Ils présentent un mouvement rapide des pupilles.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296498
    m_Localized: 'TV: C''était donc les dernières nouvelles…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296499
    m_Localized: 'TV: Nous devons nous interrompre en raison du risque d''attaque imminente contre notre studio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296500
    m_Localized: 'TV: Si vous avez des questions concernant l''identification des Visiteurs, appelez la ligne d''urgence au {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296501
    m_Localized: 'TV: Fin de la transmission.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296502
    m_Localized: 'TV: Flash spécial.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296503
    m_Localized: 'TV: La FEMA vient d''arrêter la majorité des représentants de l''État.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296504
    m_Localized: 'TV: Selon l''agence, bon nombre d''entre eux avaient été identifiés comme Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296505
    m_Localized: 'TV: Avec un gouvernement désormais incapable de fonctionner, la FEMA prend dès lors les commandes du pays.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296506
    m_Localized: 'TV: De plus…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296507
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296508
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296509
    m_Localized: 'TV: Un instant…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296510
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296511
    m_Localized: 'TV: Nous venons de recevoir un communiqué de la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296512
    m_Localized: 'TV: Les assaillants de la zone de quarantaine de la ville ont franchi le cordon.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296513
    m_Localized: 'TV: Nous répétons, les assaillants ont franchi le cordon et sont désormais en liberté.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296514
    m_Localized: 'TV: Barricadez vos fenêtres. Fermez vos portes à clé.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296515
    m_Localized: 'TV: Attendez de nouvelles instructions et restez à l''intérieur.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296516
    m_Localized: 'TV: Fin de la transmission.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296565
    m_Localized: 'Window: Vous voyez une femme pleurer au-dessus de son mari blessé.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296566
    m_Localized: 'Window: Vous ignorez s''il est encore en vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296567
    m_Localized: 'Window: Le visage baigné de larmes, elle traîne péniblement son corps, trop lourd pour elle, loin des coups de feu.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296568
    m_Localized: 'Window: Vous avez soudainement l''intime conviction que les choses ne peuvent qu''empirer.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296569
    m_Localized: 'Window: Le chemin qui longe le champ est jonché de corps… Ce sont ceux qui ont tenté de s''enfuir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296570
    m_Localized: 'Window: Non loin de là se tient leur bourreau… Un agent de la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296571
    m_Localized: 'Window: Il tient un fusil dont le canon fume encore.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296572
    m_Localized: 'Window: Pris de panique, plusieurs personnes se précipitent vers les maisons voisines.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296573
    m_Localized: 'Window: Elles frappent frénétiquement aux portes, implorant qu''on leur offre un refuge.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296574
    m_Localized: 'Window: Mais aucun voisin ne semble vouloir les accueillir, de peur de s''attirer des ennuis.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296575
    m_Localized: 'Window: Près de la maison délabrée du voisin, un groupe de gens récemment expulsés reste planté là, silencieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296576
    m_Localized: 'Window: Ils sont en état de choc et chuchotent entre eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296577
    m_Localized: 'Window: Ils veulent de toute évidence se réfugier là-bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296578
    m_Localized: 'Window: Mais reste-t-il encore un endroit où ils peuvent se cacher en toute sécurité en ce monde ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296579
    m_Localized: 'Window: Sur le chemin, un homme armé d''un fusil d''assaut se tient debout. Il ressemble à un fou furieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296580
    m_Localized: 'Window: Sa veste est couverte de dents, d''yeux et d''autres parties de corps que vous n''arrivez pas à identifier là où vous êtes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296581
    m_Localized: 'Window: Et s''il ne tuait pas pour se défendre, mais pour le plaisir et pour collectionner ses trophées ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296582
    m_Localized: 'Window: Quoi qu''il en soit, vous espérez ne jamais vous en faire un ennemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296583
    m_Localized: 'Window: Un homme est pendu à un poteau. Sur lui, une pancarte où on peut lire « Vous m''avez tout pris ».'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296584
    m_Localized: 'Window: S''est-il fait cambrioler ? Ou la FEMA lui a-t-elle pris sa famille ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296585
    m_Localized: 'Window: Votre esprit est en ébullition, mais vous n''avez aucune réponse, seulement des suppositions.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296586
    m_Localized: 'Window: Un groupe expulsé par la FEMA s''est installé dans les ruines de la maison du voisin.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296587
    m_Localized: 'Window: Il ne reste presque plus rien, mais le sous-sol a résisté, apparemment.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296588
    m_Localized: 'Window: Un minuscule havre de sécurité.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296589
    m_Localized: 'Window: Enfin… Combien de temps pourront-ils se cacher ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296590
    m_Localized: 'Window: Des chiens errants parcourent les rues.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296591
    m_Localized: 'Window: Leurs corps sont couverts de brûlures superficielles. La faim les a amaigris.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296592
    m_Localized: 'Window: Vous ne les craignez pas, à l''intérieur de votre maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296593
    m_Localized: 'Window: Mais vous ne pouvez vous empêcher de penser qu''il vaut mieux éviter de sortir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296594
    m_Localized: 'Window: De petits groupes chargés de baluchons se regroupent près des maisons. Ils chuchotent, de peur que la FEMA les repère.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296595
    m_Localized: 'Window: On dirait qu''ils viennent des zones de quarantaine et qu''ils ont été relogés dans des maisons abandonnées.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296596
    m_Localized: 'Window: À cet instant, le pendu ressemble à un sinistre panneau de bienvenue.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296597
    m_Localized: 'Window: Un chasseur de Visiteurs armé tient un groupe de survivants en joue.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296598
    m_Localized: 'Window: Il est probablement tombé sur eux par hasard.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296599
    m_Localized: 'Window: Vous entendez des cris, une voix enragée qui hurle.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296600
    m_Localized: 'Window: Qui peut bien survivre dans ce nouveau monde ? Pas ces malheureux en tout cas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296601
    m_Localized: 'Window: Des agents de la FEMA se tiennent près des cadavres de chiens.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296602
    m_Localized: 'Window: L''un d''eux prend des notes sur une tablette.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296603
    m_Localized: 'Window: Mais comment une poignée de personnes peuvent-elles espérer arrêter une horde d''animaux affamés ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296604
    m_Localized: 'Window: Deux agents de la FEMA se tiennent près d''un lampadaire. Ils observent le pendu.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296605
    m_Localized: 'Window: On dirait qu''ils viennent enfin de découvrir l''attraction principale du quartier.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296606
    m_Localized: 'Window: Ils ont l''air de deux détectives perplexes. Ils doivent se demander comment il a bien pu se retrouver là sans échelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296607
    m_Localized: 'Window: Tout le groupe est mort. Des chiens affamés se partagent leurs restes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296608
    m_Localized: 'Window: Des douilles vides jonchent le sol près des dépouilles. Ce chasseur a dû les abattre. Il a sans doute pris ses trophées.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296609
    m_Localized: 'Window: Le monde a sombré dans la folie. Il n''en reviendra plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296610
    m_Localized: 'Window: Les membres de la secte empilent du bois pour former un énorme tas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296611
    m_Localized: 'Window: Est-ce qu''ils comptent brûler quelqu''un ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296612
    m_Localized: 'Window: Leur projet fou va bientôt être dévoilé.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296613
    m_Localized: 'Window: Combien de vies innocentes leur cause emportera-t-elle ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296614
    m_Localized: 'Window: Au milieu de la route, un tireur, hagard.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296615
    m_Localized: 'Window: Il tient un bidon d''essence et brandit un cocktail Molotov.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296616
    m_Localized: 'Window: S''apprête-t-il à mettre le feu au village ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296617
    m_Localized: 'Window: Est-ce qu''on lui a dit qu''il y avait ici des personnes qui se sont évadées des zones de quarantaine ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296618
    m_Localized: 'Window: Les cadavres de ceux qui se cachaient dans les ruines de la maison du voisin brûlaient sous le soleil de midi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296619
    m_Localized: 'Window: Les chiens qui se nourrissaient des cadavres ont pris la fuite, comme si on les avait chassés.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296620
    m_Localized: 'Window: Et si ce n''était pas la FEMA qui les avait fait fuir, mais quelque chose de pire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296621
    m_Localized: 'Window: Autour du bûcher, des membres de la secte sont ligotés.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296622
    m_Localized: 'Window: Ont-ils décidé de se sacrifier ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296623
    m_Localized: 'Window: Cette pensée vous glace le sang.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296624
    m_Localized: 'Window: La peur de la mort a obsédé les esprits. Les gens sont désormais prêts à commettre l''irréparable.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296625
    m_Localized: 'Window: Penser à ce qui va se passer ensuite vous terrifie… Et dire que cette folie a débuté il y a à peine quelques semaines.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296626
    m_Localized: 'Window: Les maisons embrasées brillent de mille feux. Des cris résonnent au loin…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296627
    m_Localized: 'Window: Vous savez que derrière ce chaos se cache un fou qui tente d''exterminer les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490688
    m_Localized: 'Window: Votre maison sera-t-elle la prochaine ? Demain ? La semaine prochaine ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490689
    m_Localized: 'Window: Vous finirez probablement par vous retrouver face à face avec ce maniaque. Ce n''est qu''une question de temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490690
    m_Localized: 'Window: Il ne reste plus rien des corps calcinés.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490691
    m_Localized: 'Window: Seulement une masse étrange et informe. On dirait de la boue.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490692
    m_Localized: 'Window: C''est à se demander si quelque chose a fait fondre la chair et les os avant d''avaler les restes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490693
    m_Localized: 'Window: Vous priez pour que cette créature ne sorte pas de l''ombre. Vous avez peur que votre âme ne résiste pas à cette vue.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490694
    m_Localized: 'Window: Les agents de la FEMA entourent les corps calcinés.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490695
    m_Localized: 'Window: Ils constatent la mort des membres de la secte.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490696
    m_Localized: 'Window: Leurs visages reflètent la terreur et l''agonie, comme s''ils avaient vu quelque chose d''horrible juste avant de mourir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490697
    m_Localized: 'Window: Aux alentours, toutes les maisons sont en ruines.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490698
    m_Localized: 'Window: La vôtre est la seule encore debout.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490699
    m_Localized: 'Window: Il n''y a plus personne pour résister aux assauts des fous furieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490700
    m_Localized: 'Window: Qu''importe ce que l''avenir vous réserve, vous devrez y faire face seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490701
    m_Localized: Ici Central. Vérifiez l'état de la zone de quarantaine. Code 51. On signale des explosions à trois heures.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490702
    m_Localized: 'Unité 32-8 : Code 60. Pertes massives parmi les civils, plusieurs agents abattus…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490703
    m_Localized: 'Unité 28-8 : Code 451. Besoin immédiat d''une équipe de crémation pour le traitement des corps.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490704
    m_Localized: Reçu. Code 984 activé. Mise en place d'un cordon pour boucler la ville. Restez en position pour l'arrivée des renforts.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490705
    m_Localized: Si vous m'entendez, ne vous approchez pas de la périphérie de la ville.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490706
    m_Localized: Les agents de la FEMA tirent sur tous ceux qui tentent de s'enfuir.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490707
    m_Localized: JE NE COMPRENDS PAS CE QUI SE PASSE. JE VEUX JUSTE PARTIR D'ICI.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490708
    m_Localized: À L'AIDE ! PAR PITIÉ, AIDEZ-M—
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490709
    m_Localized: C'est pas eux qui ont attaqué la zone de quarantaine !
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490710
    m_Localized: Je le sais. J'ai vu ce qui se passait là-bas de mes propres yeux.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490711
    m_Localized: Ce… C'était pas humain…
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490712
    m_Localized: Ici les résidents expulsés.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490713
    m_Localized: Si la FEMA vous a mis dehors comme nous, sachez que nous nous abritons dans la cave d'une maison brûlée.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490714
    m_Localized: Pas loin de chez l'ermite.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490715
    m_Localized: Nos réserves touchent à leur fin, on va bientôt crever de faim.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490716
    m_Localized: Si une âme charitable veut bien partager un peu de nourriture… Par pitié, aidez-nous. On en a vraiment besoin.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490717
    m_Localized: À tous ceux qui écoutent…
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490718
    m_Localized: La FEMA tente de brouiller tous les signaux dans la ville pour étouffer l'affaire.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490719
    m_Localized: Ils veulent cacher tout ce qui se passe dans la ville.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490720
    m_Localized: Ils essaient de faire porter le chapeau à ce psychopathe qui a tué tout le monde dans la zone de quarantaine.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490721
    m_Localized: Si vous êtes encore en ville — P…artez. Ce n'…est pas sûr…
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490722
    m_Localized: É…vitez les patrouilles… FEMA. Ils …nt en train de …ous tuer.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490723
    m_Localized: FUY…EZ TANT QU'IL… ENCO…RE TEM—
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490724
    m_Localized: Ils n'aura…ient pas dû brû…ler les co…ps. Ça… les att…re…
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490725
    m_Localized: S'ils avai…ent… s'ils avai…ent con…servé les res…tes… ça… serait pas arri—
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490726
    m_Localized: Tra…nsmis… sion à… toutes les uni…tés FEMA…
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490727
    m_Localized: Nou…vel or…dre… Code 451… rem…placé par… Code 955.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490728
    m_Localized: Ne bru…lez pas… corps. Appli… de la cha…la place.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490729
    m_Localized: Je rép…ète… Code 451 est … Les brû… ne a…rmet pas de co…ntenir la me…nace—
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490730
    m_Localized: I…ci 18-8. Nous n'a…vons pas pu le con…tenir.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490731
    m_Localized: Le su…et a quitt… le périm…ètre de … ville… Renf…ort immé…diat deman…dé.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490732
    m_Localized: Je rép…ète… nous av…ons bes… oin de renf…orts mainten… Nous… pou…vons pas cont…nir le suj…et seuls.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490733
    m_Localized: 'Phone: Salut, voisin ! Ça fait plaisir d''avoir de tes nouvelles.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490734
    m_Localized: 'Phone: Alors… tu as commencé à accueillir des gens chez toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490735
    m_Localized: 'Phone: Sinon, tu devrais vraiment pas traîner trop longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490736
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490737
    m_Localized: 'Phone: Tu voulais me demander quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490738
    m_Localized: Toi aussi, tu accueilles aussi des gens chez toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490739
    m_Localized: Il faut combien de signes pour savoir si quelqu'un est un Visiteur ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490740
    m_Localized: Comment tu as fait pour régler le problème de la nourriture ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490741
    m_Localized: Au revoir ! (Raccrocher)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490742
    m_Localized: 'Phone: Ouais, il faut bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490743
    m_Localized: 'Phone: Ça plaît vraiment pas à la petite. Mais qu''est-ce que je peux y faire ? Y a pas d''autre solution.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490744
    m_Localized: 'Phone: Elle arrête pas de me demander de sortir avec elle, histoire de pas être avec tous ces inconnus à la maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490745
    m_Localized: 'Phone: On peut pas se promener le jour, alors on sort la nuit. C''est dangereux, je sais… mais elle arrête pas de me supplier.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490746
    m_Localized: 'Phone: Si seulement je savais…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490747
    m_Localized: 'Phone: Personne sait vraiment combien il faut compter de signes pour être sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490748
    m_Localized: 'Phone: À mon avis, mieux vaut ne pas tirer de conclusions hâtives tant qu''il n''y a qu''un seul symptôme.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490749
    m_Localized: 'Phone: C''est peut-être rien… Comme quelqu''un qui est juste allé chez le dentiste avant que tout parte en vrille.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490750
    m_Localized: 'Phone: J''ai eu de la chance. J''ai fait pas mal de stock avant que tout commence. Mais toi aussi, si je me souviens bien, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490751
    m_Localized: 'Phone: Mais si t''as besoin de quelque chose en particulier, il y a ce service de livraison de repas, For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490752
    m_Localized: 'Phone: Je connais pas leur numéro par cœur, mais tu peux le trouver dans les pubs à la télé ou à la radio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490753
    m_Localized: 'Phone: Prends soin de toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490754
    m_Localized: 'Phone: Salut, voisin.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490755
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490756
    m_Localized: 'Phone: Tu as vu ce qui s''est passé dehors ? Y a des adolescents qui ont été tués…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490757
    m_Localized: 'Phone: Moi qui pensais que les rues étaient pas si dangereuses que ça. Je me suis bien trompé.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490758
    m_Localized: 'Phone: Ma fille m''a convaincu de sortir jouer avec elle. Tout allait bien… jusqu''à ce que je tombe sur les corps.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490759
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490760
    m_Localized: 'Phone: C''était la dernière fois que je risquais sa vie comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490761
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490762
    m_Localized: 'Phone: Bon sang… Je pourrais pas me le pardonner si jamais il lui arrivait quelque chose. Elle est tout pour moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490763
    m_Localized: La petite va bien ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490764
    m_Localized: Qui les a tués ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490765
    m_Localized: Fais attention à toi. (Raccrocher)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490766
    m_Localized: Je ne sais pas.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490767
    m_Localized: 'Phone: Je pensais qu''avec toutes ces herbes hautes, elle avait rien remarqué.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490768
    m_Localized: 'Phone: Mais à la maison, elle a raconté qu''elle avait vu un visage dans l''herbe…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490769
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490770
    m_Localized: 'Phone: J''ai essayé de la convaincre que c''était son imagination. Mais… elle ne m''a pas cru.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490771
    m_Localized: 'Phone: C''était cette créature pâle et grande. Je pensais qu''elle tuait uniquement les gens qui restaient chez eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490772
    m_Localized: 'Phone: Je pensais avoir la situation sous contrôle… que si je voyais cette silhouette, on rentrerait immédiatement à la maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490773
    m_Localized: 'Phone: Mais j''avais pas pensé aux cadavres qu''elle risquait de voir…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490774
    m_Localized: 'Phone: Merci. Prends soin de toi aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490775
    m_Localized: 'Phone: Salut, voisin. Merci d''avoir appelé.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490776
    m_Localized: 'Phone: Honnêtement, je suis encore sous le choc.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490777
    m_Localized: 'Phone: Les meurtres, les soldats, la FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490778
    m_Localized: 'Phone: Ils sont même venus frapper à ma porte hier soir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490779
    m_Localized: 'Phone: Ils m''ont posé plein de questions sur ceux qui séjournent ici, ont griffonné quelque chose sur un bloc-notes, puis…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490780
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490781
    m_Localized: 'Phone: L''un d''entre eux vient d''embarquer quelqu''un qui était chez moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490782
    m_Localized: Où l'ont-ils emmené ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490783
    m_Localized: Heureusement qu'ils ont pas embarqué la petite.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490784
    m_Localized: Au fait, tu sais qui sont les membres de la FEMA, toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490785
    m_Localized: Fais attention à toi. (Raccrocher)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490786
    m_Localized: 'Phone: Aucune idée. Tout ce qu''ils ont dit, c''est que c''était pour un « contrôle ».'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490787
    m_Localized: 'Phone: Je pensais qu''entre l''armée et la FEMA, les choses s''arrangeraient…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490788
    m_Localized: 'Phone: J''aurais dû me douter que tout ce beau monde était pas là pour nous aider ou nous mettre à l''abri…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490789
    m_Localized: 'Phone: Il est hors de question que je laisse faire une chose pareille.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490790
    m_Localized: 'Phone: Faudra me passer sur le corps.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490791
    m_Localized: 'Phone: Si ces salauds osent la toucher, je les réduirais en bouillie.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490792
    m_Localized: 'Phone: Je sais pas. On sait vraiment pas grand-chose sur eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490793
    m_Localized: 'Phone: Ils sont sortis de nulle part et ils agissent comme s''ils avaient la situation bien en main.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490794
    m_Localized: 'Phone: Mais comment font-ils pour repérer les signes ? Et pourquoi est-ce qu''ils ont l''air d''être des gens ordinaires ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490795
    m_Localized: 'Phone: J''ai l''impression qu''ils ne nous disent pas tout…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490796
    m_Localized: 'Phone: Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490797
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490798
    m_Localized: 'Phone: J''aurais jamais cru qu''on finirait par vivre dans un chaos pareil.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490799
    m_Localized: 'Phone: Le soleil, les Visiteurs, maintenant la FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490800
    m_Localized: 'Phone: Y a tellement de questions, et aucune réponse.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490801
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490802
    m_Localized: 'Phone: Il faut que je te demande quelque chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490803
    m_Localized: 'Phone: Si quelque chose m''arrive… promets-moi que tu t''occuperas de ma fille.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490804
    m_Localized: Je te le promets.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490805
    m_Localized: Je ne peux rien te promettre.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490806
    m_Localized: 'Phone: Merci, voisin. Je savais que je pouvais compter sur toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490807
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490808
    m_Localized: 'Phone: Bon, je dois y aller. Bon courage à toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490809
    m_Localized: 'Phone: Je…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490810
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490811
    m_Localized: 'Phone: Tu veux vraiment pas l''aider ? C''est juste une gosse. Je veux pas qu''elle reste toute seule.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490812
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490813
    m_Localized: 'Phone: Mince, je dois filer…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490814
    m_Localized: 'Phone: Au revoir, voisin.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490815
    m_Localized: 'Phone: For Rest, service de livraison de repas, bonjour !'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490816
    m_Localized: 'Phone: Que voulez-vous commander ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490817
    m_Localized: Une canette d'Énerjéka, s'il vous plaît !
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490818
    m_Localized: Une canette de café, s'il vous plaît !
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490819
    m_Localized: J'ai changé d'avis, je ne veux plus rien commander.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490820
    m_Localized: 'Phone: Malheureusement, nous ne pouvons pas accepter votre commande, car vous en avez déjà passé une récemment.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490821
    m_Localized: 'Phone: En raison de la demande élevée, nous ne pouvons prendre qu''une seule commande par jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490822
    m_Localized: 'Phone: Si vous voulez commander à nouveau, merci de rappeler demain.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490823
    m_Localized: 'Phone: Merci, au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490824
    m_Localized: 'Phone: Très bien, votre commande a bien été enregistrée. Elle vous sera livrée demain soir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490825
    m_Localized: 'Phone: Très bien, votre commande a bien été enregistrée. Elle vous sera livrée demain soir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490826
    m_Localized: 'Phone: Bonjour, ici la division médicale de la Force d''Encadrement des Menaces Anormales.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490827
    m_Localized: 'Phone: Nous sommes là pour vous conseiller sur les procédures de dépistage des visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490829
    m_Localized: 'Phone: Avez-vous des questions ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490830
    m_Localized: Que dois-je faire en ce qui concerne les dents ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490831
    m_Localized: Que dois-je faire en ce qui concerne les ongles ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490832
    m_Localized: Que dois-je faire en ce qui concerne les yeux ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490833
    m_Localized: Merci, ce sera tout.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490834
    m_Localized: 'Phone: Pour obtenir des résultats précis, nous vous recommandons d''éviter de consommer toute forme de tabac.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490835
    m_Localized: 'Phone: Le tabagisme peut affecter l''état des dents et entraîner des résultats peu fiables.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490836
    m_Localized: 'Phone: Afin de garantir une bonne évaluation de votre état, évitez de vous laver les mains avant l''examen.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490837
    m_Localized: 'Phone: L''eau peut éliminer les résidus superficiels, ce qui risque d''entraîner des erreurs et des résultats faussés.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490838
    m_Localized: 'Phone: Pour un dépistage précis, évitez de boire du café ou toute autre boisson contenant de la caféine.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490839
    m_Localized: 'Phone: La caféine peut être à l''origine d''insomnie et de nervosité. De plus, elle peut aussi rendre les yeux rouges.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490840
    m_Localized: 'Phone: Merci de votre coopération avec la Force d''Encadrement des Menaces Anormales.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490841
    m_Localized: 'Phone: Votre contribution à résoudre la situation actuelle ne passera pas inaperçue.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490842
    m_Localized: 'Phone: En veillant à ce que les examens soient précis, vous rendez service, à vous-même, et à toute l''humanité.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490843
    m_Localized: 'Phone: Bonjour. Nous allons vous mettre en relation avec un spécialiste de l''extraction de Visiteurs. Merci de patienter.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490844
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490845
    m_Localized: 'Phone: Allô ? Qui êtes-vous ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490846
    m_Localized: Comment ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490847
    m_Localized: Pourquoi avez-vous besoin de savoir qui je suis ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490848
    m_Localized: 'Phone: Je vois. Vous n''étiez pas en mesure de dire que vous étiez humain… L''esprit de Visiteur s''est déjà infiltré en vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490849
    m_Localized: 'Phone: Maintenant, écoutez attentivement, on n''a pas beaucoup de temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490850
    m_Localized: 'Phone: Dites-moi, est-ce que ça vous arrive de laisser traîner une tranche de pain dans votre cuisine ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490851
    m_Localized: Non ? Pourquoi est-ce que je ferais une chose pareille ?!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490852
    m_Localized: Une tranche de pain ?!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490853
    m_Localized: 'Phone: Pour m''aider à chasser l''esprit de Visiteur qui est en vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490854
    m_Localized: 'Phone: D''accord, peu importe. Écoutez-moi attentivement, vous n''avez pas beaucoup de temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490855
    m_Localized: 'Phone: Dites-moi, est-ce que ça vous arrive de laisser traîner une tranche de pain dans votre cuisine ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490856
    m_Localized: Non ? Pourquoi est-ce que je ferais une chose pareille ?!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490857
    m_Localized: Une tranche de pain ?!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490858
    m_Localized: 'Phone: Oh… Ça explique beaucoup de choses. Vous n''êtes pas en bons termes avec l''esprit de votre maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490859
    m_Localized: 'Phone: C''est pour cela que l''esprit de Visiteur est venu. Mais ne vous inquiétez pas. On va s''en occuper.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490860
    m_Localized: 'Phone: Avez-vous un ordinateur personnel chez vous ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490861
    m_Localized: Non.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490862
    m_Localized: Un quoi de personnel ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490863
    m_Localized: 'Phone: Vous ne faites jamais d''offrandes à l''esprit de votre maison ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490864
    m_Localized: 'Phone: Pas étonnant qu''un esprit de Visiteur se soit intéressé à vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490865
    m_Localized: 'Phone: Avez-vous un ordinateur personnel chez vous ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490866
    m_Localized: Non.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490867
    m_Localized: Un quoi de personnel ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490868
    m_Localized: 'Phone: Compris. Donc Alt+F4 n''est plus une option…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490869
    m_Localized: 'Phone: Très bien… Dites-moi… Consommez-vous des champignons ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490870
    m_Localized: Uniquement du kombucha. Occasionnellement.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490871
    m_Localized: Non.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490872
    m_Localized: 'Phone: Vous ne savez vraiment pas ce qu''est un ordinateur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490873
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490874
    m_Localized: 'Phone: Bon, peu importe. Passons...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490875
    m_Localized: Uniquement du kombucha. Occasionnellement.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490876
    m_Localized: Non.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490877
    m_Localized: 'Phone: Oh non…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490878
    m_Localized: 'Phone: Vous devez arrêter d''en boire immédiatement. Le kombucha est un mal ancestral…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490879
    m_Localized: 'Phone: Il permet au mycélium de se développer en vous. Voilà pourquoi l''esprit peut vous contrôler comme une marionnette.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490880
    m_Localized: 'Phone: Vous ne pouvez même pas imaginer ce qui arrivera s''il accède à vos souvenirs.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490881
    m_Localized: 'Phone: Il peut les effacer ou les consulter, encore et encore, ce qui altérera vos décisions.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490882
    m_Localized: 'Phone: Le pire dans tout ça ? Vous ne vous rendrez même pas compte qu''on vous contrôle.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490883
    m_Localized: 'Phone: Très bien, une dernière question : y a-t-il eu des effusions de sang chez vous ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490884
    m_Localized: Oui.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490885
    m_Localized: Non.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490886
    m_Localized: 'Phone: Très bien, continuez comme ça. Autrement, le Visiteur pourrait retourner dans votre corps beaucoup plus facilement.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490887
    m_Localized: 'Phone: Si vous buvez du kombucha, le mycélium a peut-être commencé à se développer en vous et à vous contrôler, comme un pantin.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490888
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490889
    m_Localized: 'Phone: Pfff… C''est pas évident, pas évident du tout…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490890
    m_Localized: Oui.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490891
    m_Localized: Non.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490892
    m_Localized: 'Phone: Ah, voilà qui explique tout…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490893
    m_Localized: 'Phone: Ce n''est pas un esprit de Visiteur. C''est un esprit spectral. L''âme d''une personne décédée.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490894
    m_Localized: 'Phone: Malheureusement, je ne suis vraiment pas spécialisée dans l''exorcisme.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490895
    m_Localized: 'Phone: Et c''est un exorciste qu''il vous faut pour régler ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490896
    m_Localized: 'Phone: J''ai bien peur de ne rien pouvoir faire de plus. Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490897
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490898
    m_Localized: 'Phone: Votre session d''extraction de Visiteurs est à présent terminée. Nous vous remercions d''avoir fait appel à nos services.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490899
    m_Localized: 'Phone: Des frais de consultation vous seront facturés sous peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490900
    m_Localized: Des frais ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490901
    m_Localized: Je croyais que cet appel était gratuit…
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490902
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490903
    m_Localized: 'Phone: Ah, mince… Je ne vais pas réussir à identifier la nature de cet esprit. Et si je ne sais pas, je ne peux pas vous aider.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490904
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490905
    m_Localized: 'Phone: Malheureusement, je vais devoir mettre fin à notre conversation.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490906
    m_Localized: 'Phone: Restez courageux… et… Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490907
    m_Localized: 'Phone: Votre session d''extraction de Visiteurs est à présent terminée. Nous vous remercions d''avoir fait appel à nos services.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490908
    m_Localized: 'Phone: Des frais de consultation vous seront facturés sous peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490909
    m_Localized: Des frais ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490910
    m_Localized: Je croyais que cet appel était gratuit
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490911
    m_Localized: 'Phone: Il faut bien que nos spécialistes en extraction de Visiteurs gagnent leur vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490912
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490913
    m_Localized: 'Phone: Comment évalueriez-vous votre expérience aujourd''hui ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490914
    m_Localized: Positif.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684992
    m_Localized: Ça n'a pas servi à grand-chose.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684993
    m_Localized: Allez vous faire foutre, bande d'escrocs !
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684994
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684995
    m_Localized: 'Phone: Si vous avez bien regardé la publicité, les petites lignes indiquent clairement que cet appel est payant.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684996
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684997
    m_Localized: 'Phone: Comment évalueriez-vous votre expérience aujourd''hui ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684998
    m_Localized: Positif.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684999
    m_Localized: Ça n'a pas servi à grand-chose
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685000
    m_Localized: Allez vous faire foutre, bande d'escrocs !
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685001
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685002
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685003
    m_Localized: 'Phone: Merci. Vos commentaires sont très importants pour nous. Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610048
    m_Localized: 'TV: C''est tout pour le moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610049
    m_Localized: 'TV: Désormais disponible via le service de livraison For Rest. Appelez dès maintenant au {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610050
    m_Localized: 'TV: Mesdames, messieurs, bonjour. Voici les actualités du jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610051
    m_Localized: 'TV: Les incendies n''y changent rien… Les Visiteurs continuent de terroriser tout le pays.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610052
    m_Localized: 'TV: La FEMA a découvert un nouveau signe distinctif des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610053
    m_Localized: 'TV: À suivre : un reportage spécial sur la véritable nature des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113249218560
    m_Localized: 'Phone: Hein ? Oui, allô ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995776
    m_Localized: C'est votre épouse qui m'a donné ce numéro.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995777
    m_Localized: Votre épouse a besoin d'aide.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995778
    m_Localized: 'Phone: Hmm hmm… Et ensuite ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995779
    m_Localized: Elle a perdu tous les enfants.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995780
    m_Localized: Est-ce qu'ils sont avec vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995781
    m_Localized: 'Phone: Toujours la même histoire. C''est toujours moi qui dois nettoyer derrière tout le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995782
    m_Localized: 'Phone: Elle reste assise là, à se plaindre, à dire qu''elle est fatiguée.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995783
    m_Localized: 'Phone: Rien de bien nouveau.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995784
    m_Localized: Elle a perdu tous les enfants.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995785
    m_Localized: Est-ce qu'ils sont avec vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995786
    m_Localized: 'Phone: Ohhh, je vois. Donc comme d''habitude, elle est incapable de s''occuper de ses propres gosses.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995787
    m_Localized: 'Phone: Et maintenant, c''est encore à moi de remettre de l''ordre dans tout ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995788
    m_Localized: 'Phone: Vous avez vérifié chez sa mère ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995789
    m_Localized: Non.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995790
    m_Localized: Vous pourriez peut-être venir la chercher ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995791
    m_Localized: 'Phone: Non. Ils sont pas avec elle ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995792
    m_Localized: 'Phone: Pas étonnant…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995793
    m_Localized: 'Phone: Vous avez vérifié chez sa mère ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995794
    m_Localized: Non.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995795
    m_Localized: Vous pourriez peut-être venir la chercher ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995796
    m_Localized: 'Phone: Hmm hmm.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995797
    m_Localized: 'Phone: Peut-être qu''ils sont là-bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995798
    m_Localized: 'Phone: Hors de question que je me déplace.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995799
    m_Localized: 'Phone: Laissez-la s''en occuper. Demandez-lui quel genre de mère perd ses propres enfants.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995800
    m_Localized: Débrouillez-vous tous les deux.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995801
    m_Localized: Bon. Je vais lui dire que vous êtes en vie et que vous l'attendez.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995802
    m_Localized: 'Phone: Laissez-la venir elle-même. Ce n''est pas une princesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995803
    m_Localized: 'Phone: Elle a deux jambes qui fonctionnent, non ? Alors, c''est quoi le problème ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995804
    m_Localized: Débrouillez-vous tous les deux.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995805
    m_Localized: Bon. Je vais lui dire que vous êtes en vie et que vous l'attendez.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995806
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995807
    m_Localized: 'Phone: Alors, pourquoi avoir appelé ? Pour sauver une pauvre demoiselle en détresse ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995808
    m_Localized: 'Phone: Vous pouvez bien faire comme ça vous chante… De toute façon, cette pétasse se contrefiche de tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995809
    m_Localized: 'Phone: Laissez-moi tranquille, bon sang.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995810
    m_Localized: 'Phone: Bon. Je vais lui dire que vous êtes en vie et que vous l''attendez.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995811
    m_Localized: 'Phone: Ne vous donnez pas cette peine. À quoi bon ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995812
    m_Localized: 'Phone: On n''en a plus rien à foutre l''un de l''autre…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995813
    m_Localized: 'Phone: Je comprends pas pourquoi vous vous mêlez de ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995814
    m_Localized: 'Phone: Peu importe… Prenez soin de vous, tous les deux. Je vous souhaite une très belle vie ensemble.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995815
    m_Localized: 'Phone: Croyez-vous à la mort ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995816
    m_Localized: C'est votre mari qui m'a demandé de vous appeler.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995817
    m_Localized: Épargnez-moi vos petits sermons. C'est au sujet de votre mari.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995818
    m_Localized: 'Phone: Quoi ? Mon mari ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995819
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995820
    m_Localized: 'Phone: Après tout ce qu''il a fait… Je ne veux plus entendre parler de lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995821
    m_Localized: Il m'a demandé de vous dire qu'il était désolé pour ce qui s'était passé.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995822
    m_Localized: Il m'a demandé de vous dire d'aller vous faire voir.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995823
    m_Localized: 'Phone: Euh… Mon mari ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995824
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995825
    m_Localized: 'Phone: Après tout ce qu''il a fait… Je ne veux plus entendre parler de lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995826
    m_Localized: Il m'a demandé de vous dire qu'il était désolé pour ce qui s'était passé.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995827
    m_Localized: Il m'a demandé de vous dire d'aller vous faire voir.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995828
    m_Localized: 'Phone: Hah. Pardon !?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995829
    m_Localized: 'Phone: Sérieusement ? Encore ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995830
    m_Localized: 'Phone: Vous ignorez sans doute que d''autres personnes se sont déjà excusées à sa place.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995831
    m_Localized: 'Phone: Vous voulez savoir pourquoi il ne peut pas m''appeler lui-même ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995832
    m_Localized: 'Phone: Parce qu''il n''a pas le courage d''assumer ce qu''il a fait. Il refuse de l''accepter.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995833
    m_Localized: 'Phone: Il pense toujours pouvoir tout arranger. Mais c''est pas comme ça, la vie. On peut pas remonter le temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995834
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995835
    m_Localized: 'Phone: Je me sens mieux maintenant. Je suis avec des gens qui me comprennent.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995836
    m_Localized: Vous pensez qu'une bande de fanatiques sectaires vous comprend ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995837
    m_Localized: Pourquoi diable avez-vous rejoint une secte ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995838
    m_Localized: Si vous le dites…
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995839
    m_Localized: 'Phone: Appelez ça comme vous voulez. C''est ma famille maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995840
    m_Localized: 'Phone: Nous partageons la même Foi. Nous savons que la Mort approche à grands pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995841
    m_Localized: 'Phone: Et qu''Elle n''apportera aucune souffrance… Seulement la paix.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995842
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995843
    m_Localized: 'Phone: Prenez soin de vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995844
    m_Localized: 'Phone: Nous pensons la même chose de ce qui viendra ensuite. C''est l''arrivée de la Mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995845
    m_Localized: 'Phone: Cela peut vous paraître étrange, mais figurez-vous que la Mort n''apporte pas le chagrin, mais le bonheur.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995846
    m_Localized: 'Phone: Le bonheur dans la paix… et la fin de la souffrance. Je parie que vous aussi, vous avez connu des moments difficiles.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995847
    m_Localized: 'Phone: Peut-être qu''un jour vous comprendrez et que vous verrez les choses comme nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995848
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995849
    m_Localized: 'Phone: Prenez soin de vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995850
    m_Localized: 'Phone: Merci de votre compréhension.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995851
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995852
    m_Localized: 'Phone: Prenez soin de vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995853
    m_Localized: 'Phone: Allô ? Qui est-ce ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995854
    m_Localized: Bonjour. C'est votre frère qui m'a donné votre numéro.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995855
    m_Localized: Est-ce que vous allez aider votre frère ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995856
    m_Localized: 'Phone: Comment ça, mon frère ? Je comprends pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995857
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995858
    m_Localized: 'Phone: Oh, vous voulez dire le fils de mon père… C''est ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995859
    m_Localized: 'Phone: Mais attendez… Qui êtes-vous ? Et pourquoi est-il avec vous ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995860
    m_Localized: Ses parents ont disparu.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995861
    m_Localized: Il est venu me voir pour trouver refuge.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995862
    m_Localized: 'Phone: Disparu ? Comment est-ce que ça a pu arriver ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995863
    m_Localized: 'Phone: Vous voulez dire qu''ils…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995864
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995865
    m_Localized: 'Phone: Bon sang… C''est pas vrai… Est-ce qu''ils sont morts ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995866
    m_Localized: Je ne sais pas.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995867
    m_Localized: Probablement.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995868
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995869
    m_Localized: 'Phone: Il cherchait un refuge ? Mais il vit avec ses parents, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995870
    m_Localized: 'Phone: Se pourrait-il que…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995871
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995872
    m_Localized: 'Phone: Bon sang… C''est pas vrai… Est-ce qu''ils sont morts ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995873
    m_Localized: Je ne sais pas.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995874
    m_Localized: Probablement.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995875
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995876
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995877
    m_Localized: 'Phone: Mince alors… Comment une telle chose a-t-elle pu arriver ? …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995878
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995879
    m_Localized: 'Phone: Je peux le prendre chez moi. Dites-le-lui. Il sait où j''habite.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995880
    m_Localized: 'Phone: Et… Merci de l''avoir aidé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995881
    m_Localized: 'Phone: Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995882
    m_Localized: 'Phone: Ah oui ? Qui est-ce ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995883
    m_Localized: Votre épouse et sa sœur sont chez moi.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995884
    m_Localized: C'est votre épouse qui m'a donné ce numéro.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995885
    m_Localized: 'Phone: On dirait que vous essayez d''exiger une rançon.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995886
    m_Localized: 'Phone: Malheureusement, je n''ai plus rien à vous donner.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995887
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995888
    m_Localized: 'Phone: Et bientôt, il ne restera plus personne non plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995889
    m_Localized: Que voulez-vous dire ? Qu'est-ce qui ne va pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995890
    m_Localized: Votre épouse va bien.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995891
    m_Localized: 'Phone: Dites-moi qu''elle va bien, par pitié.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995892
    m_Localized: 'Phone: Elle est forte, elle s''en sortira quoi qu''il arrive. Elle aidera même tous ceux qu''elle pourra en chemin !'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995893
    m_Localized: 'Phone: Mais à ce stade, je crois qu''il n''y a plus d''espoir pour moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995894
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995895
    m_Localized: 'Phone: Je ne vais pas tenir très longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995896
    m_Localized: Que voulez-vous dire ? Qu'est-ce qui ne va pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995897
    m_Localized: Votre épouse va bien.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995898
    m_Localized: 'Phone: Je… Je n''en peux plus. Le soleil, les Visiteurs, la populace enragée. Tout ça, ça me terrifie. Je suis comme tétanisé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995899
    m_Localized: 'Phone: Je veux juste… Je veux juste que tout ça s''arrête. Il ne me reste qu''une seule issue… Vous comprenez ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995900
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995901
    m_Localized: 'Phone: Dites-lui que je l''aime.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995902
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995903
    m_Localized: 'Phone: En fait… Mieux vaut ne rien dire… Il faut juste faire en sorte qu''elle ne vienne pas me chercher.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995904
    m_Localized: 'Phone: Je ne veux pas qu''elle sache que je suis parti sans elle…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995905
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995906
    m_Localized: 'Phone: Merci d''avoir appelé. Et merci de m''avoir écouté.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995907
    m_Localized: 'Phone: Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995908
    m_Localized: 'Phone: Elle s''accroche probablement à sa sœur. Elle n''a jamais vraiment su lâcher prise, ha…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995909
    m_Localized: 'Phone: C''est vraiment pas de chance… Se retrouver entourée de mauviettes. Moi, c''est pour ça que j''ai décidé de la quitter.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995910
    m_Localized: 'Phone: Service des admissions de la FEMA, bonjour. Comment puis-je vous être utile ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995911
    m_Localized: Il y a ici la femme d'un agent de la FEMA.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995912
    m_Localized: Il y a ici une personne altruiste qui souhaite rejoindre vos rangs.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995913
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995914
    m_Localized: 'Phone: Bon, quelle est votre question ? Je ne sais toujours pas comment je peux vous être utile.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995915
    m_Localized: 'Phone: En supposant que ce ne soit pas une menace.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995916
    m_Localized: … C'est une menace ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995917
    m_Localized: Elle cherche un travail chez vous. Avant, elle travaillait à la douane.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995918
    m_Localized: 'Phone: (Vous entendez un gros soupir.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995919
    m_Localized: 'Phone: Vous faites partie de ces activistes, c''est ça ? Toujours en train de se plaindre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995920
    m_Localized: 'Phone: Arrêtez de nous faire perdre du temps. Des personnes en détresse essaient sans doute de nous joindre en ce moment même.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995921
    m_Localized: 'Phone: Les Visiteurs sont peut-être en train d''entrer chez des gens. Ou pire. Et ces gens vont mourir à cause de votre appel.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995922
    m_Localized: 'Phone: Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995923
    m_Localized: 'Phone: Hmm. Elle doit bien se douter que ça n''est pas un travail facile. Est-elle vraiment prête à s''engager ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995924
    m_Localized: 'Phone: Dans ce cas, dites-lui de remplir le formulaire 31-G en trois exemplaires.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995925
    m_Localized: 'Phone: Ensuite, elle doit passer la visite médicale… Après ça, il faut remplir…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995926
    m_Localized: 'Phone: (Vous raccrochez. Pourquoi vous êtes-vous donné la peine d''appeler au sujet de cette femme ?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995927
    m_Localized: 'Phone: À quel poste postule-t-elle ? Pas à celui de directrice, j''espère.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995928
    m_Localized: 'Phone: C''est la troisième personne aujourd''hui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995929
    m_Localized: Elle veut être directrice.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995930
    m_Localized: Elle veut rejoindre l'équipe des traqueurs. Être une sorte d'éclaireur.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995931
    m_Localized: 'Phone: J''en ai ras le bol de ces canulars téléphoniques.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995932
    m_Localized: 'Phone: Chaque seconde que vous occupez cette ligne, quelqu''un d''autre meurt peut-être sous les coups des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995933
    m_Localized: 'Phone: Grandissez un peu ! Il va falloir assumer vos blagues idiotes et déplacées.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995934
    m_Localized: 'Phone: (Il a raccroché. Sérieusement ?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995935
    m_Localized: 'Phone: Ce genre de postes n''existe pas. Ce qu''il nous faut, ce sont des experts en épidémies et des scientifiques qualifiés.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995936
    m_Localized: 'Phone: Votre camarade n''a pas l''air d''être la personne idéale pour ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995937
    m_Localized: 'Phone: Vous savez quoi ? Les choses évoluent très vite. Rappelez-nous dans une semaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995938
    m_Localized: 'Phone: Je parie qu''il y aura une place pour… Comment vous avez dit déjà ? Quelqu''un d''altruiste ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995939
    m_Localized: 'Phone: Structure d''une pomme : la pomme supérieure, le pays des Champignons et du papier.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995940
    m_Localized: 'Phone: Tremblez devant… de la bouillie…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995941
    m_Localized: 'Phone: Bien qu''elle… enchante les…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995942
    m_Localized: 'Phone: Là… rencontre… rien…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995943
    m_Localized: 'Phone: Rien que des larmes et la tristesse des adieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995944
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995945
    m_Localized: 'Phone: Vérifiez sa respiration.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995946
    m_Localized: 'Phone: Pourquoi est-ce que vous ne me répondez pas ? Je voudrais mourir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995947
    m_Localized: 'Phone: (Ça a raccroché… Ce n''était… pas vraiment ce à quoi vous vous attendiez.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995948
    m_Localized: 'Phone: Notez qu'' à l''heure actuelle, il n''est pas possible de se rendre dans notre pays en avion ou en train.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995949
    m_Localized: 'Phone: Comment puis-je vous aider ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995950
    m_Localized: J'aurais besoin d'aider un touriste à rentrer chez lui.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995951
    m_Localized: Pourquoi ne peut-il pas prendre le train ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995952
    m_Localized: 'Phone: Mieux vaut attendre que les liaisons aériennes soient rétablies.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995953
    m_Localized: 'Phone: Les ferries fonctionnent, mais ce n''est pas fiable. Le risque de typhons est extrêmement élevé la nuit.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995954
    m_Localized: 'Phone: Et la réverbération du soleil sur l''eau est insupportable pour l''équipage. Personne ne peut rester longtemps à bord.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995955
    m_Localized: Mais alors, comment je suis censé renvoyer ce malheureux chez lui ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995956
    m_Localized: Il vit avec moi maintenant. Vous pourriez peut-être l'accueillir chez vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995957
    m_Localized: 'Phone: Les rails se dilatent sous l''effet de la chaleur, il est trop dangereux de faire circuler les trains en journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995958
    m_Localized: 'Phone: Les trains ne circulent que la nuit, donc on ne peut pas aller bien loin.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995959
    m_Localized: 'Phone: Trop de transferts. Il vaut mieux attendre que les liaisons aériennes soient rétablies.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995960
    m_Localized: Mais alors, comment je suis censé renvoyer ce malheureux chez lui ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995961
    m_Localized: Il vit avec moi maintenant. Vous pourriez peut-être l'accueillir chez vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995962
    m_Localized: 'Phone: Non, vous allez devoir attendre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995963
    m_Localized: 'Phone: Nous ne pouvons rien faire d''autre pour l''instant.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995964
    m_Localized: Il ne parle même pas notre langue.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995965
    m_Localized: Si vous ne pouvez pas aider, à quoi servez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995966
    m_Localized: 'Phone: Nous n''avons pas d''hôtels.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995967
    m_Localized: 'Phone: Nous faisons tout notre possible pour régler le problème, mais il n''est pas le seul dans cette situation.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995968
    m_Localized: Il ne parle même pas notre langue.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995969
    m_Localized: Si vous ne pouvez pas aider, à quoi servez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995970
    m_Localized: 'Phone: Toute notre équipe est occupée. Vous vous imaginez bien que le budget de l''ambassade a été réduit comme peau de chagrin.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995971
    m_Localized: 'Phone: Nous faisons tout ce que nous pouvons.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995972
    m_Localized: Oh, ouah… Vous êtes de vrais héros !
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995973
    m_Localized: Je peux pas supporter les tire-au-flanc dans votre genre…
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995974
    m_Localized: 'Phone: Inutile de parler sur ce ton.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995975
    m_Localized: 'Phone: Nous ne pouvons pas le ramener chez lui sur notre dos. Si vous voulez aider, c''est à vous de vous en occuper.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995976
    m_Localized: 'Phone: Les budgets ont été réduits à tel point que notre travail est quasiment bénévole.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995977
    m_Localized: Oh, ouah, vous êtes de vrais héros !
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995978
    m_Localized: Je peux pas supporter les tire-au-flanc dans votre genre…
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995979
    m_Localized: 'Phone: Si vous n''aimez pas notre façon de travailler, vous n''avez qu''à vous en occuper vous-même.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995980
    m_Localized: 'Phone: Bonne chance pour passer la frontière avec tous ces contrôles de Visiteurs et cette chaleur écrasante en pleine journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995981
    m_Localized: Super, merci.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995982
    m_Localized: Vous savez quoi ? Allez vous faire foutre !
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995983
    m_Localized: 'Phone: Alors pourquoi êtes-vous à la maison et pas au travail ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995984
    m_Localized: 'Phone: Ou peut-être que vous pourriez venir nous montrer comment on fait ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995985
    m_Localized: 'Phone: Nous aimerions recevoir l''aide de quelqu''un qui s''y connaît mieux que nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995986
    m_Localized: Super, merci.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995987
    m_Localized: Vous savez quoi ? Allez vous faire foutre !
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995988
    m_Localized: 'Phone: Excusez-moi d''avoir réagi comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995989
    m_Localized: 'Phone: Vous n''êtes pas le premier rageux à nous appeler.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995990
    m_Localized: 'Phone: Bonne journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995991
    m_Localized: 'Phone: Bon voyage.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995992
    m_Localized: 'Phone: J''espère vraiment qu''un jour, vous serez pris par l''envie de voyager.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995993
    m_Localized: 'Phone: Je serai là pour vous aider, ce jour-là…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995994
    m_Localized: 'X: Une fenêtre donnant sur une autre pièce. Ça économise l''électricité : la lumière d''une pièce éclaire l''autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995995
    m_Localized: Puis ils l'ont scellée… mais seulement de ce côté-là.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995996
    m_Localized: Non, je ne regarde plus de ce côté-là. Plus depuis ce jour-là.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995997
    m_Localized: Je déteste dormir près de la table de chevet. Trop de mauvais souvenirs…
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995998
    m_Localized: Je ne comprends pas pourquoi ce truc n'est pas dans le coin là-bas. Normalement, c'est la règle.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995999
    m_Localized: Mais bon… Papa en a jamais rien eu à faire des règles.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996000
    m_Localized: Toto. C'était pratiquement le seul jouet que j'avais quand j'étais gosse.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996001
    m_Localized: Enfin… à part les bâtons avec lesquels on coupait l'herbe.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996002
    m_Localized: Hé. Mamie avait bourré tous les placards avec toutes sortes de plats.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996003
    m_Localized: Elle sortait uniquement la belle vaisselle pour les grandes occasions. Mais maintenant… à quoi ça peut bien servir ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996004
    m_Localized: Honnêtement, je préfère rester tranquille, sans personne à la maison.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996005
    m_Localized: On peut se parler à voix haute, ça dérange personne.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996006
    m_Localized: Un de ces magazines où il faut trouver une certaine personne dans la foule…
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996007
    m_Localized: À quoi bon ? J'aimerais que l'on me laisse tranquille…
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996008
    m_Localized: 'À ce moment-là, il m''a dit : « Quand je serai parti, à toi de voir si tu veux ouvrir cette boîte ou non. »'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996009
    m_Localized: Bientôt quinze ans que j'hésite… Et j'arrive toujours pas à me décider.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295719612416
    m_Localized: Vous vous sentez seul ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583936
    m_Localized: Vous n'avez personne à qui parler ? Vous êtes angoissé ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583937
    m_Localized: Dans ce cas, la roulette téléphonique est la solution idéale pour vous !
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583938
    m_Localized: Appelez dès maintenant le 891-533. Nous vous mettrons en relation avec les meilleurs partenaires de conversation qui soient.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583939
    m_Localized: Est-ce que la petite va bien ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583940
    m_Localized: Qui les a tués ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583941
    m_Localized: Faites attention à vous. (Raccrocher)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583942
    m_Localized: Est-ce que la petite va bien ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583943
    m_Localized: Qui les a tués ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583944
    m_Localized: Faites attention à vous. (Raccrocher)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583945
    m_Localized: Où ont-ils emmené la personne que vous hébergiez chez vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583946
    m_Localized: Heureusement qu'ils ont pas embarqué la petite.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583947
    m_Localized: C'est quoi, la FEMA ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583948
    m_Localized: Prenez soin de vous. (Raccrocher)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583949
    m_Localized: Où ont-ils emmené la personne que vous hébergiez chez vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583950
    m_Localized: Heureusement qu'ils ont pas embarqué la petite.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583951
    m_Localized: C'est quoi, la FEMA ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583952
    m_Localized: Prenez soin de vous. (Raccrocher)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583953
    m_Localized: Où ont-ils emmené la personne que vous hébergiez chez vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583954
    m_Localized: Heureusement qu'ils ont pas embarqué la petite.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583955
    m_Localized: C'est quoi, la FEMA ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583956
    m_Localized: Prenez soin de vous. (Raccrocher)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583957
    m_Localized: 'Phone: Bonjour, vous êtes en ligne avec la FEMA. Comment puis-je vous aider ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583958
    m_Localized: Hein ? La FEMA ? C'est quoi ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583959
    m_Localized: De quoi parlez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583960
    m_Localized: 'Phone: (Un cri d''homme retentit au bout du fil avant qu''elle ait le temps de terminer.)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583961
    m_Localized: 'Phone: VOUS ÊTES COMPLÈTEMENT DÉBILE OU QUOI ?! RACCROCHEZ IMMÉDIATEMENT !'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583962
    m_Localized: Comment est-ce que je dois m'y prendre avec les aisselles ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583963
    m_Localized: Comment est-ce que je dois m'y prendre avec les oreilles ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583964
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583965
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583966
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583967
    m_Localized: 'Phone: Vous devez éviter tout contact avec l''eau pour garantir la précision du test des aisselles.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583968
    m_Localized: 'Phone: Évitez de prendre une douche ou même de vous laver les mains.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583969
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583970
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583971
    m_Localized: 'Phone: Les oreilles ? Attendez…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583972
    m_Localized: 'Phone: Nous allons nous concerter avec la direction. Nous vous tiendrons informés ultérieurement.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583973
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583974
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583975
    m_Localized: 'Phone: Très bien. Dans ce cas, merci de préciser : est-ce que vous consommez des champignons ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583976
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583977
    m_Localized: 'Phone: Très bien, une dernière question : y a-t-il eu des effusions de sang chez vous ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583978
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583979
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778240
    m_Localized: 'Phone: Roulette téléphonique, bonjour ! Votre partenaire de conversation va bientôt vous parler, merci de patienter.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778241
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778242
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778243
    m_Localized: 'Phone: Bonjour… Salut.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778244
    m_Localized: Bonjour.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778245
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778246
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778247
    m_Localized: 'Phone: Bonjour ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778248
    m_Localized: Bonjour.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778249
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778250
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778251
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778252
    m_Localized: 'Phone: J''imagine qu''il n''y a personne…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778253
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778254
    m_Localized: 'Phone: J''ai besoin de parler à quelqu''un. Il s''est passé tellement de choses dernièrement…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778255
    m_Localized: 'Phone: J''ai essayé de contacter mes amis et mes proches, mais personne ne répond…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778256
    m_Localized: 'Phone: Et puis, j''ai découvert la roulette téléphonique.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778257
    m_Localized: 'Phone: Ce ne sont peut-être pas les meilleures conditions pour se livrer, mais c''est toujours mieux que rien…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778258
    m_Localized: 'Phone: Je sais que je ne devrais pas confier mes problèmes à un inconnu, mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778259
    m_Localized: 'Phone: Vous n''avez pas idée à quel point le simple fait de parler pourrait m''aider… Je me sentirais tellement mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778260
    m_Localized: 'Phone: Est-ce que vous voulez bien m''écouter ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778261
    m_Localized: D'accord.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778262
    m_Localized: Je n'ai vraiment pas envie d'avoir une longue discussion.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778263
    m_Localized: 'Phone: Oh…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778264
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778265
    m_Localized: 'Phone: D''accord. Excusez-moi de vous avoir dérangé.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778266
    m_Localized: 'Phone: Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778267
    m_Localized: 'Phone: Oh, merci beaucoup. Merci !'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778268
    m_Localized: 'Phone: Je crois que ce sera plus facile si je vous parlais un peu de moi, d''abord.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778269
    m_Localized: 'Phone: Qu''aimeriez-vous savoir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778270
    m_Localized: Où habitez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778271
    m_Localized: Pourquoi avez-vous décidé d'appeler ce numéro plutôt que vos amis ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778272
    m_Localized: 'Phone: Loin de chez moi, malheureusement.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778273
    m_Localized: 'Phone: J''ai cherché l''endroit le plus frais possible pour échapper à cette canicule.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778274
    m_Localized: 'Phone: Je suis au milieu de nulle part. Il fait si froid ici que ça vous mord les os… Et même l''herbe a du mal à pousser…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778275
    m_Localized: 'Phone: Enfin bon, je vis dans un endroit relativement sûr, loin de tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778276
    m_Localized: 'Phone: Mais s''il y a une place au frais, même dans le neuvième cercle des enfers, alors c''est peut-être pas si terrible que ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778277
    m_Localized: 'Phone: C''est marrant, avant je détestais le froid… Mais là… c''est une vraie bénédiction.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778278
    m_Localized: 'Phone: Je préfère espérer que le soleil finira par se calmer et que tout ça sera bientôt de l''histoire ancienne.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778279
    m_Localized: 'Phone: Mais j''ai de plus en plus de mal à croire que tout ça finira bien. Une fois que le soleil arrêtera de briller…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778280
    m_Localized: 'Phone: Les Visiteurs ne disparaîtront peut-être jamais. Ils pourraient remplacer nos proches, sans qu''on s''en rende compte…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778281
    m_Localized: Vous êtes partie toute seule ? Pourquoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778282
    m_Localized: Est-ce que votre vie d'avant vous manque ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778283
    m_Localized: 'Phone: J''aimerais bien appeler tout le monde, mais… Je ne sais pas comment les joindre…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778284
    m_Localized: 'Phone: Quand le cataclysme a commencé, j''ai décidé de quitter ma maison. De fuir la chaleur le plus loin possible.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778285
    m_Localized: 'Phone: J''ai promis à tout le monde que j''appellerais pour prendre des nouvelles, pour voir comment ils allaient…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778286
    m_Localized: 'Phone: Mais depuis mon arrivée, j''ai réussi à joindre personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778287
    m_Localized: 'Phone: Ce n''est qu''après que j''ai compris pourquoi… Leurs lignes de téléphone ont été coupées.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778288
    m_Localized: 'Phone: La ville entière a été isolée du reste du monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778289
    m_Localized: 'Phone: Maintenant, je suis là, en sécurité… Mais tous mes proches…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778290
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778291
    m_Localized: 'Phone: L''idée de ne plus jamais revoir tous ceux que j''aime… Ça me terrifie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778292
    m_Localized: 'Phone: L''époque des jours tranquilles me manque… Vous savez, quand la vie était simple et l''avenir prometteur…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778293
    m_Localized: Vous êtes partie toute seule ? Pourquoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778294
    m_Localized: Est-ce que votre vie d'avant vous manque ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778295
    m_Localized: 'Phone: Je ne voulais pas. Mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778296
    m_Localized: 'Phone: À vrai dire, mon meilleur ami voulait venir avec moi, mais il n''a pas pu…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778297
    m_Localized: 'Phone: Il avait pas les documents nécessaires pour voyager avec moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778298
    m_Localized: 'Phone: Et quand le cataclysme a éclaté, c''était plus possible de les obtenir.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778299
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778300
    m_Localized: 'Phone: Il était si déçu… Il aurait voulu les demander plus tôt. Et moi j''aurais voulu l''aider, mais je ne savais pas comment.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778301
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778302
    m_Localized: 'Phone: Bien sûr que ça me manque. Mais ce n''est pas tant la ville qui me manque… C''est plutôt les gens qui sont restés…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778303
    m_Localized: 'Phone: Et surtout, mon meilleur ami…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778304
    m_Localized: 'Phone: Il voulait venir avec moi, mais il a pas pu. Je lui avais promis que je l''appellerais. Mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778305
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778306
    m_Localized: 'Phone: Je crois qu''il était amoureux de moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778307
    m_Localized: 'Phone: Il prenait tellement soin de moi. Il m''a toujours soutenue… et il était toujours prêt à m''écouter.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778308
    m_Localized: 'Phone: Et puis… J''ai réalisé qu''on se plaisait…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778309
    m_Localized: 'Phone: J''ai attendu qu''il me déclare sa flamme. Je voulais qu''il fasse le premier pas. Mais il a jamais eu le courage.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778310
    m_Localized: 'Phone: Et puis… La crise a éclaté… et on n''a plus eu le temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778311
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778312
    m_Localized: 'Phone: Je regrette de ne pas lui avoir dit plus tôt…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778313
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778314
    m_Localized: 'Phone: Bon, vous en savez un peu plus sur moi. À votre tour maintenant !'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778315
    m_Localized: Je n'ai pas l'habitude de parler de moi…
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778316
    m_Localized: Je ne sais même pas…
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778317
    m_Localized: 'Phone: Faites pas votre timide. Vous pouvez tout me dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778318
    m_Localized: Eh bien… Je n'ai pas de personne proche dans ma vie.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778319
    m_Localized: Je suis plutôt quelqu'un de solitaire…
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778320
    m_Localized: 'Phone: Ne vous en faites pas. Il n''y a rien de mal à parler de soi-même.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972544
    m_Localized: Eh bien… Je n'ai pas de personne proche dans ma vie.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972545
    m_Localized: Je suis plutôt quelqu'un de solitaire…
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972546
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972547
    m_Localized: J'ai eu… une relation difficile avec mon père.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972548
    m_Localized: Mon père… Je… Je le détestais.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972549
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972550
    m_Localized: Je ne fais plus partie de la famille.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972551
    m_Localized: Et un jour… J'ai arrêté d'être son fils.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972555
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972556
    m_Localized: Et tout ce qu'il me reste, c'est cette maison.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972557
    m_Localized: Maintenant, tout ce qui reste d'eux, c'est cette maison.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972558
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972559
    m_Localized: 'Phone: Je compatis vraiment… On dirait que vous n''êtes pas très enthousiaste à l''idée que la maison vous revienne.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972560
    m_Localized: C'est vrai.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972561
    m_Localized: Il aurait mieux valu qu'elle brûle.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972562
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972563
    m_Localized: 'Phone: Je… Je ne peux même pas imaginer ce que vous avez traversé.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972564
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972565
    m_Localized: 'Phone: Vous deviez vraiment détester votre père pour souhaiter que la maison brûle…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972566
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972567
    m_Localized: 'Phone: Merci encore d''avoir pris le temps de me parler.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972568
    m_Localized: 'Phone: Au revoir. Et bon courage.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972569
    m_Localized: 'Phone: Bonjour ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972570
    m_Localized: Bonjour… Est-ce que je peux parler à la petite ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972571
    m_Localized: Bonjour… Seriez-vous d'accord pour que la petite vienne jouer chez sa copine ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972572
    m_Localized: 'Phone: Quoi ? Pourquoi voulez-vous lui parler ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972573
    m_Localized: Sa copine lui a demandé de venir chez elle.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972574
    m_Localized: Il y a bien une fillette ici… son père est mort.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972575
    m_Localized: 'Phone: Était-il… était-il un Visiteur, lui aussi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972576
    m_Localized: Comment ça, « aussi » ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972577
    m_Localized: Non. Des désaxés l'ont brûlé vif, sans raison.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972578
    m_Localized: 'Phone: On ne brûle pas les gens sans raison.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972579
    m_Localized: 'Phone: Donc, c''était un Visiteur… tout comme notre petite fille.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972580
    m_Localized: 'Phone: Ils l''ont brûlée, elle aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972581
    m_Localized: 'Phone: Juste là, dans son école.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972582
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972583
    m_Localized: 'Phone: Au début, j''arrêtais pas de pleurer. Je voulais mettre fin à mes jours. Je pouvais pas vivre sans elle.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972584
    m_Localized: 'Phone: Mais mon mari m''a aidée à traverser tout ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972585
    m_Localized: 'Phone: Vous aussi, vous allez vous en sortir… Comme cette petite fille.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972586
    m_Localized: 'Phone: Vous savez…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972587
    m_Localized: 'Phone: Rien n''arrive par hasard.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972588
    m_Localized: 'Phone: S''ils ont brûlé son père… C''est que c''était inévitable.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972589
    m_Localized: 'Phone: Et rien ne sert de pleurer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972590
    m_Localized: 'Phone: S''il vous plaît… Dites-le-lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972591
    m_Localized: 'Phone: Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972592
    m_Localized: 'Phone: Notre petite fille… elle…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972593
    m_Localized: 'Phone: Elle est morte…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972594
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972595
    m_Localized: 'Phone: On a dû…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972596
    m_Localized: 'Phone: On a dû la tuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972597
    m_Localized: Quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972598
    m_Localized: (Raccrocher)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972599
    m_Localized: 'Phone: On l''a tuée. Croyez-moi, on n''a pas eu le choix…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972600
    m_Localized: 'Phone: Elle avait tous les symptômes… Et mon mari… Mon mari insistait.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972601
    m_Localized: Vous… Vous avez décidé de tuer votre propre enfant ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972602
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972603
    m_Localized: 'Phone: Ne me jugez pas !'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972604
    m_Localized: 'Phone: C''était un Visiteur ! Tous les signes étaient là. Tous ! Absolument tous !'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972605
    m_Localized: Putain…
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972606
    m_Localized: Je comprends…
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972607
    m_Localized: 'Phone: C''était un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972608
    m_Localized: 'Phone: Elle avait tous les symptômes…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972609
    m_Localized: 'Phone: Je la connaissais, jusqu''au moindre cheveu…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972610
    m_Localized: 'Phone: C''est pour ça que j''ai tout de suite remarqué les symptômes.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972611
    m_Localized: 'Phone: Tous les signes étaient là.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972612
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972613
    m_Localized: 'Phone: Dès que j''en ai parlé à mon mari, il…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972614
    m_Localized: 'Phone: Il s''est immédiatement occupé du Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972615
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972616
    m_Localized: 'Phone: Au début, j''aurais voulu le tuer, lui, de mes propres mains.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972617
    m_Localized: 'Phone: Mais j''ai fini par comprendre… que ce n''était plus notre petite fille dans ce corps…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972618
    m_Localized: 'Phone: C''est mon mari qui m''a aidée à ouvrir les yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972619
    m_Localized: 'Phone: Je regrette de ne pas avoir demandé à cette abomination ce qu''elle avait fait à notre fille…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972620
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972621
    m_Localized: 'Phone: Je suis désolée.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972622
    m_Localized: 'Phone: N''appelez plus ici…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972623
    m_Localized: 'Phone: S''il vous plaît…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972624
    m_Localized: 'Phone: Mais… Pourquoi est-ce que je me justifie auprès de vous ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972625
    m_Localized: 'Phone: Allez au diable !'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972626
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972627
    m_Localized: 'Phone: Et pourtant… Elle me manque toujours…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972628
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096192
    m_Localized: 'TV: …'
    m_Metadata:
      m_Items: []
