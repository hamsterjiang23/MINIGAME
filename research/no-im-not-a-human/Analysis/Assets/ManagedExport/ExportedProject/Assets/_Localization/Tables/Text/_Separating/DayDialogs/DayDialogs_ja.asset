%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DayDialogs_ja
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ja
  m_SharedData: {fileID: 11400000, guid: 48f2181e494cb864ca5ca7074da486ff, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22080585977856
    m_Localized: 'Firefighter: クソ暑いな…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560768
    m_Localized: 体調は どうですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560769
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560770
    m_Localized: "Firefighter: 思ったより酷い\nゴホッ クソッ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560771
    m_Localized: "Firefighter: あと一週間も\nもたないんじゃないかな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560772
    m_Localized: "Firefighter: でも 中に入れてもらえて\n少し良くなったよ\nありがとう"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560773
    m_Localized: "Firefighter: でも…\nボクが こうしている間も\n他の仲間は死んでいる"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560774
    m_Localized: "Firefighter: 一緒に いれば良かった\nどうせ失うものもないし…\nどっちみち死ぬんだから…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560775
    m_Localized: 'Firefighter: クソ暑いな…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560776
    m_Localized: なぜ家に帰らないんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560777
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560778
    m_Localized: "Firefighter: 家には子供がいるんだ\nだから…\nゴホッ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560779
    m_Localized: 'Firefighter: こんな姿で怖がらせたくない'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560780
    m_Localized: "Firefighter: それに ゴホッ\nこんなボクを記憶に残したくない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560781
    m_Localized: "Firefighter: 子供達には もう森で死んだと…\nゴホッゴホッ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560782
    m_Localized: "Firefighter: 火を消しながら死んだと\n思ってほしい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560783
    m_Localized: "Firefighter: ゴホッ 仲間と耐え\n献身的に働いたボクを\n覚えていてほしい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560784
    m_Localized: 'Firefighter: クソ暑いな…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560785
    m_Localized: 制服は どこに？
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560786
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560787
    m_Localized: "Firefighter: 上に取り上げられた ゴホッ\n今 装備が足りてなくてね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560788
    m_Localized: "Firefighter: たくさん ゴホッ\n現場で死んでるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560789
    m_Localized: "Firefighter: 同僚の遺体を引き上げる\nヒマすらない\n火で ゴホッ どうせ焼き尽くされる"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560790
    m_Localized: "Firefighter: それで上の連中が…\n気にしてるのは ゴホッ\nクソ制服がどうとか"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560791
    m_Localized: "Firefighter: 蹄鉄を打ち出すみたいに\n指令を量産するだけだ\n人のことなんて 何一つ気にかけず"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560792
    m_Localized: 'Firefighter: クソ暑いな…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560793
    m_Localized: 山火事の原因は？
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560794
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560795
    m_Localized: "Firefighter: 近ごろ森が乾ききってて\nそれで ゴホッ すぐ燃えるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560796
    m_Localized: "Firefighter: 火災なんて ゴホッ ボクら を襲う\n悲運の一つに過ぎない\n地中から来た\nあの来訪者と一緒でね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560797
    m_Localized: "Firefighter: でも 運命は\nまだまだ終わりそうにない…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560798
    m_Localized: "Firefighter: 今 安らかに死ぬのが\n一番マシな結末かもね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560799
    m_Localized: "Firefighter: そうだ… ゴホッ これ\n家に持って帰ろうと思ってたんだけど\nキミに あげるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560800
    m_Localized: "Firefighter: このネックレス\n乾いてて地味だけどさ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560801
    m_Localized: "Firefighter: 死んだ蜂で作ったんだ\n蜜を太陽に変えてた連中でね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560802
    m_Localized: 'Firefighter: クソ暑いな…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560803
    m_Localized: 酷そうですね
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560804
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560805
    m_Localized: "Firefighter: どうも…\nボクの番みたいだ…\nゴホッゴホッ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560806
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560807
    m_Localized: "Firefighter: なんで あそこで\n踏みとどまらなかったんだか\n何人か助けられたのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560808
    m_Localized: "Firefighter: あそこで…\nブッ倒れるまで働いていれば\n若い連中を死地に送らずすんだんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560809
    m_Localized: "Firefighter: クソ上層部！\nゴホゴホッ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560810
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560811
    m_Localized: "Firefighter: なにもかも…\nやりきれない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560812
    m_Localized: 'Firefighter: 最後に一本くれないか？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560813
    m_Localized: "どうぞ\n（タバコを渡す）"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560814
    m_Localized: 'Firefighter: タバコ 持ってないのかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560815
    m_Localized: "すみません\n（タバコを渡さない）"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560816
    m_Localized: "Firefighter: これぞ 棺に打つ最後の一釘だね\nゴホッ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560817
    m_Localized: "Firefighter: （ポケットからライターを取りだし\nタバコに火を点け 吸い始める）"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560818
    m_Localized: "Firefighter: （深く一服して 壁にもたれかかり\n少し沈黙し 再び口を開く）"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560819
    m_Localized: "Firefighter: また仲間と一緒に\nタバコ吸ったり あれこれ話せ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560820
    m_Localized: 'Firefighter: ゴホゴホッ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560821
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560822
    m_Localized: 'Firefighter: タバコ 吸わないのかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560823
    m_Localized: "Firefighter: まあ 消防士がタバコなんて\nマズいよね ゴホッ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560824
    m_Localized: 'Firefighter: でも もう どうだっていいんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560825
    m_Localized: "Firefighter: ただ ゴホッ\n死ぬ前に一息つきたくてね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560826
    m_Localized: "Firefighter: （壁にもたれ\n天井を見上げ つぶやく）"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560827
    m_Localized: "Firefighter: まったく なんで消防士なんかに\nなったんだか…\n母さんは 工場で働けって\n言ってたのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560828
    m_Localized: 'Firefighter: 消防士になんて…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560829
    m_Localized: 'Firefighter: ゴホゴホッ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560830
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560831
    m_Localized: "WheelChair: 歩いて 走って\n日の光あびながら…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560832
    m_Localized: 誰を探してるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560833
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560834
    m_Localized: "WheelChair: 旧友だよ\nガキの頃からの付き合いでな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560835
    m_Localized: 'WheelChair: アイツ 事故っちまってな'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560836
    m_Localized: "WheelChair: 山で なんか掘る仕事に\n雇われたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560837
    m_Localized: "WheelChair: よくは知らねえ\nどうだっていいしな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755072
    m_Localized: 'WheelChair: ただよ それで腰 痛めちまったんだ！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755073
    m_Localized: 'WheelChair: 山で必死に働いて…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755074
    m_Localized: "WheelChair: カモメが アイツの…\n腰を… その…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755075
    m_Localized: "WheelChair: まあ 腰っていうかケツを\n巣だと勘違いして突っついたんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755076
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755077
    m_Localized: 'WheelChair: ハハハハ！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755078
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755079
    m_Localized: "WheelChair: 悪い悪い\n頭の中で声がするんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755080
    m_Localized: "WheelChair: 連中がウケる冗談\nぶっこんでくるもんだから"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755081
    m_Localized: "WheelChair: 歩いて 走って\n日の光あびながら…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755082
    m_Localized: えっと…大丈夫ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755083
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755084
    m_Localized: "WheelChair: ああ\n足が生えるのを待ってるだけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755085
    m_Localized: "WheelChair: ほら\n右脚なんか もう伸びてきたぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755086
    m_Localized: "WheelChair: だから\nもう暫く いさせてくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755087
    m_Localized: "その 頭の中で\n声がするんですよね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755088
    m_Localized: "まあ…\nいいですけど"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755089
    m_Localized: "WheelChair: ムズかったか？\nなに 冗談だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755090
    m_Localized: 'WheelChair: すぐわかると思ったんだが'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755091
    m_Localized: 'WheelChair: スベっちまったか…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755092
    m_Localized: 'WheelChair: オレの調子 気にしてくれたのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755093
    m_Localized: 'WheelChair: ありがとよ 嬉しいぜ！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755094
    m_Localized: "WheelChair: 誰も訊いちゃ くれねえからな\nオレが どうしてるとか\nどんな日だったとか"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755095
    m_Localized: "WheelChair: つまらねえ古い脚の代わりに\n偉大なレーサー用の車輪持ち\nだからか？嫉妬してるのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755096
    m_Localized: "WheelChair: 誰も素直に答えやしねえ\nそいつが問題だ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755097
    m_Localized: "WheelChair: みんな言い訳し出すんだ\nちらっと脚 見ただけだ ってな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755098
    m_Localized: "WheelChair: ジロジロ見られんのも\nウンザリだけどな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755099
    m_Localized: "WheelChair: でもよ 障害 見て見ぬ振りされんのも\nバカげてるだろ\nだって 現に そうなんだから"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755100
    m_Localized: 'WheelChair: つまりだ バランスが必要なんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755101
    m_Localized: "WheelChair: でも この町には バランスなんざ\nありゃしねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755102
    m_Localized: "WheelChair: アンタ 考えたこと あるか？\n自分が車輪乗りなら\nどうやって歩くか"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755103
    m_Localized: "WheelChair: クソッ\nそういう意味じゃなくてな…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755104
    m_Localized: "WheelChair: 脚がなかったら\nって話だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755105
    m_Localized: "WheelChair: その通り！\n外出すら できねえんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755106
    m_Localized: "WheelChair: 階段は どうする？\n道路を 渡るのは？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755107
    m_Localized: "WheelChair: あのクソ縁石\nどれもガタガタだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755108
    m_Localized: "WheelChair: アンタの家には\n階段も段差もねえだろ\n動きやすくて助かるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755109
    m_Localized: 'WheelChair: まあ 一つ望むとすれば…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755110
    m_Localized: 'WheelChair: …坂だな！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755111
    m_Localized: "WheelChair: 考えてみろよ！車椅子で傾斜レースだ！\n当然 壁に激突するが ハハ！\n大したことじゃねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755112
    m_Localized: "WheelChair: ああ レースが大好きなんだ\nアンタには無理だろうが"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755113
    m_Localized: "WheelChair: おっと そうだそうだ\nオレの具合の話だったよな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755114
    m_Localized: "WheelChair: 悪くない\n訊いてくれて ありがとよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755115
    m_Localized: "WheelChair: 歩いて 走って\n日の光あびながら…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755116
    m_Localized: 日射病にでも なりました？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755117
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755118
    m_Localized: 'WheelChair: だったら どうした？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755119
    m_Localized: "WheelChair: 髪の毛が燃えたり抜けたり してねえ\nなら問題なしだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755120
    m_Localized: "WheelChair: 脚なしじゃ\n車椅子でレースできねえだろ\nな？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755121
    m_Localized: "WheelChair: 脚がねえなら\nどうやって減速すんだ？\nどうコーナー曲がれ ってんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755122
    m_Localized: "WheelChair: アンタ 車椅子 持ちじゃないよな\nなら オレの気持ち わかんねえだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755123
    m_Localized: 本気で 信じてるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755124
    m_Localized: 何故 脚が再生すると？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755125
    m_Localized: 'WheelChair: 当たり前だろ！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755126
    m_Localized: 'WheelChair: よく言うだろ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755127
    m_Localized: "WheelChair: 右脚のほうが歩幅が広い\nだから オレたち\nグルグル回るんだ って"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755128
    m_Localized: "WheelChair: ほら\nオレの脚が なによりの証拠だ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755129
    m_Localized: "WheelChair: なにかも堂々巡りだ\nどう足掻いても抜け出せねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755130
    m_Localized: "WheelChair: 今日が終われば また明日が始まる\nでも それって新たな一日か？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755131
    m_Localized: "WheelChair: クソ食らえ\n同じ毎日の繰り返しだ\nひたすら空回り してな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755132
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755133
    m_Localized: "WheelChair: でな 考えてみろよ\nオレとアンタ\nなにが違うってんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755134
    m_Localized: "WheelChair: アンタも グルグル歩き回ってる\nだけだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755135
    m_Localized: "WheelChair: なあ\nオレら奇跡の世界に生きてんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755136
    m_Localized: "WheelChair: カスみたいな奇跡ばっかだけどな\n今のとこ\nでもな！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755137
    m_Localized: "WheelChair: いつか カス奇跡だって終わりが来る\nそしたら ハッピーなのが始まるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755138
    m_Localized: "WheelChair: 神様は もう\n山ほど信者を赦してきたんだ\nオレらにも お恵みが\nあったっていいだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755139
    m_Localized: "WheelChair: 歩いて 走って\n日の光あびながら…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755140
    m_Localized: どうして脚を失ったんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755141
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755142
    m_Localized: "WheelChair: 山の旧友の話\n覚えてるか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755143
    m_Localized: "WheelChair: アイツ…\n庭に深い溝を掘ろうとしてな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755144
    m_Localized: "WheelChair: 肉まみれのトンネルが\n家の下を通ってる\nとか言い出して"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755145
    m_Localized: 'WheelChair: 手動のドリルだかなんだか注文して'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755146
    m_Localized: 'WheelChair: それで 掘り始めたんだ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755147
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755148
    m_Localized: 'WheelChair: クソッ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755149
    m_Localized: 'WheelChair: あれが アイツを見た最後だったかな…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755150
    m_Localized: "WheelChair: 歩いて 走って\n日の光あびながら…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755151
    m_Localized: 脚 どうしたんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755152
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755153
    m_Localized: "WheelChair: 脚なんざクソ食らえ\nオレが知りたいのは\nアイツが ちゃんと掘れたかどうかだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755154
    m_Localized: なら もういいです
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755155
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755156
    m_Localized: "WheelChair: ああ そうだそうだ\nそれから ビール飲みに行ったんだった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755157
    m_Localized: "WheelChair: で 転んで\n路面電車に脚 轢かれて"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755158
    m_Localized: 'WheelChair: 待てよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755159
    m_Localized: 'WheelChair: いや 違ったか'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755160
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755161
    m_Localized: "WheelChair: なに 黙ってんだ？\n興味ねえのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755162
    m_Localized: "WheelChair: まあ\nなら よしとくよ\n気 悪くさせたか ないしな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755163
    m_Localized: 'Mother: ここ 息が詰まる…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755164
    m_Localized: "お子さん\n一緒じゃないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755165
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755166
    m_Localized: "Mother: え？\nあの子なら一緒だよ\nどこか行ってるだけ じゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755167
    m_Localized: "Mother: 他の子が どこかだけが気がかりで\n無事かどうかも"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755168
    m_Localized: "Mother: 電話ある？\n夫に連絡したいんだけど\nあのマヌケ面 二度と見たくないから"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755169
    m_Localized: 'Mother: ここ 息が詰まる…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755170
    m_Localized: "その 旦那さんに\n電話したんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755171
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755172
    m_Localized: "Mother: なんで？\nどうせ ブツクサ言って他人事\nなに一つ 手を貸さない\n全部 丸投げ 子供も 家事も 家計も"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755173
    m_Localized: "Mother: 時々 思うんだけど\nアイツもアタシも\n互いを我慢してただけ\nでもアイツ 出ていきもしなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755174
    m_Localized: "Mother: アタシが都合 良かったんだろうね\nそれか 仕返しが怖かっただけかも"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755175
    m_Localized: 'Mother: ああ ウンザリ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755176
    m_Localized: 'Mother: ここ 息が詰まる…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755177
    m_Localized: 旦那さんに会ったんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755178
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755179
    m_Localized: "Mother: えっ？\nベッドから出るだけで やっとだよ\nどこもかしこも痛くて もうクタクタ\n腹いせ だけで生きてる って感じ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755180
    m_Localized: "Mother: どれもこれも一人で背負ってた\n子供も 夫も 家のこと全部\nでも たまにアイツが\nしてくれることで救われてた"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755181
    m_Localized: "Mother: 話すの後にしてもらえる？\n休まないと\nまるで力が入らなくって"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755182
    m_Localized: 'Mother: ここ 息が詰まる…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755183
    m_Localized: "旦那さんが\nしてくれたこととは？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755184
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755185
    m_Localized: 'Mother: こんなことが あったの…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755186
    m_Localized: "Mother: アイツ ある女を車で よく送ってて\nなに やってんのかバレバレだった\nはじめは見逃してたけど\n毎日  責めずにいられなくなって"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755187
    m_Localized: "Mother: 浮気 問い詰めたら\nアイツ結局 仕事を変えた\nもう あの女と会わないように って\nそれって アタシを愛してたのかな…？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755188
    m_Localized: "Mother: でも アタシの思い込み かもね\nとにかく 休まないと\n話は後で"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755189
    m_Localized: 'Mother: ここ 息が詰まる…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755190
    m_Localized: "お子さんのこと\n心配じゃないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755191
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755192
    m_Localized: "Mother: 心配だけど… 多分 アタシじゃダメ\n最初の子のとき…\nどうしていいか なにもわからなくて\nなにもかもメチャクチャだった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755193
    m_Localized: "Mother: 次は うまくやろう そう思った\nでも また同じだった\n三人目も四人目も…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755194
    m_Localized: "Mother: 医者は 子は持てない って\nでも二人目が生まれて…\n世界の八不思議って呼んでた！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755195
    m_Localized: "Mother: でも次第に…\nどんどん…\nヒドくなって…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755196
    m_Localized: "Mother: アタシ…\n目を閉じないと…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755197
    m_Localized: 'Mother: ここ 息が詰まる…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755198
    m_Localized: なにが ヒドかったんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755199
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755200
    m_Localized: "Mother: 言うのもキツいけど…\n子供のことは愛してた\nでも… 我を忘れたり 怒鳴ったり\n手を上げさえした"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755201
    m_Localized: "Mother: わかってる 最低だって\nずっと後悔してる…\nでも その\nはじめて ゆっくりできてる"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755202
    m_Localized: "Mother: 誰もいなくて のんびり呼吸できる…\nこんな自分 嫌だけど\nでも やっと楽になれた気がする"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755203
    m_Localized: 'Anger: クソッタレ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755204
    m_Localized: "どうです？\n落ち着きました？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755205
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755206
    m_Localized: "Anger: ああ すぐ頭が冷えるタチなんだ\nだが 思い出した途端\nまた血が上っちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755207
    m_Localized: "Anger: 前は もっと大らかだったんだ\nちょっとやそっとじゃ\nスイッチ入らなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755208
    m_Localized: "Anger: 今は ちょっとカチっと来たら\nカンカンだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755209
    m_Localized: "Anger: そもそもよ\n落ち着いてなきゃダメか？\n怒りが正気を繋ぎ止めてる\nかもしれねえだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755210
    m_Localized: "Anger: 少なくとも 太陽 崇めてる\n腐れ脳ミソどもよかマシだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755211
    m_Localized: "Anger: なんで太陽に救い\n見出してんだかな？\nあのクソに殺されてかけてんのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755212
    m_Localized: "Anger: いずれ焼き尽くされて\nあの世 行きだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755213
    m_Localized: "Anger: 能なしども 救いがないよな\nいよっし 大丈夫\n落ち着いた もういいぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755214
    m_Localized: "Anger: ありがとな\n付き合ってくれて"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755215
    m_Localized: 'Anger: クソッタレ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755216
    m_Localized: "その怒り\nどこから湧くんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755217
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755218
    m_Localized: 'Anger: オレにも わかんねえよ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755219
    m_Localized: "Anger: ただ 起きてる全てに腹が立って\nしかたねえんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755220
    m_Localized: "Anger: カルト連中は\nウソまみれのクソ野郎だしよ\nもっと大勢 騙そうと必死こきやがって"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755221
    m_Localized: 'Anger: で 信じるバカが出てくんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755222
    m_Localized: "Anger: テメエのガキ\n一人残らず捧げるようなのがな\n連中に媚び へつらうために"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755223
    m_Localized: "Anger: 死の国から来たクソ救世主に\n取り入ろうとな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755224
    m_Localized: "Anger: イカれきったクソ野郎ども\nマトモなヤツらまで妄想で\n洗脳しやがって…\nちょうどオレの…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755225
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755226
    m_Localized: "Anger: よし だいぶ落ち着いた\nマシな気分だ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755227
    m_Localized: 'Anger: クソッタレ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755228
    m_Localized: "カルトに誰か\n取られたんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755229
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755230
    m_Localized: "Anger: いや そうじゃねえ\nアイツ 自分から行っちまったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755231
    m_Localized: 'Anger: 妻がな…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755232
    m_Localized: "Anger: このクソが始まる前から\n熱心な信者だったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755233
    m_Localized: "Anger: でも愛してたし 受け入れてた\nオレたちの関係に\nなんの支障もなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755234
    m_Localized: "Anger: クソが扇風機にブチ当たった途端\nアイツは新しい救世主とやらに\n乗り換えた"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755235
    m_Localized: "Anger: クソカルトどもの美辞麗句が\nもっともらしく響いたらしい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755236
    m_Localized: "Anger: 日に日にアイツ\nイカれてったよ\nオレには理解不能なもんを信じて"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755237
    m_Localized: "Anger: オレが やらかしに気付いたときには\nアイツ 怯えて家を出ちまってた\nなにもかも 手遅れだった…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755238
    m_Localized: 'Anger: クソッタレ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755239
    m_Localized: "奥さんとの間に\nなにがあったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755240
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755241
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755242
    m_Localized: 'Anger: ある日 カルトに入ると言われたんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755243
    m_Localized: "Anger: オレ… 信じられなくてな\n愛した女が…\nまるで別人みたいだった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755244
    m_Localized: "Anger: 二人の愛なんて アイツには最早\nなんの意味もなかった\n悔しくて 人生で一番 頭にきた"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755245
    m_Localized: "Anger: こんな考えが脳裏に浮かびだした\nアイツは最初からオレを愛してなくて\n逃げたくてたまらなかった って\nそれでオレまで どうかしちまった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755246
    m_Localized: "Anger: いつの間にか 拳を握りしめてた\nそれで やっちまったんだ\n一生 自分を許せないマネを"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755247
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755248
    m_Localized: 'Anger: 殴っちまった…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755249
    m_Localized: "Anger: もう どうにもならない\nアイツはカルト オレは…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755250
    m_Localized: "Anger: あのことを\nどうしても受け入れられない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755251
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755252
    m_Localized: "Anger: クソッ\nオレなんてウンザリだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755253
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755254
    m_Localized: "Anger: 周囲の誰かより\n自分を傷つけるほうがマシだ\nそれが報いだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755255
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755256
    m_Localized: "Anger: 行ってくれ\n一人でいてえんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755257
    m_Localized: 'FortuneTeller: 読んでやろうか？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755258
    m_Localized: "なんで そんなに\n私を知ってるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755259
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755260
    m_Localized: "FortuneTeller: はっ！\nお前さん 面白いじゃないか…\n私が知ってるんじゃない\nただ星が語るのさ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755261
    m_Localized: "FortuneTeller: お前さん\n第六ハウスの金星に月があるね\n顔に書いてあるよ\nしかも寡黙ときた…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755262
    m_Localized: "FortuneTeller: 昔 似たようなのがいたよ\nいつも聞いてばかりで\n口を開きやしない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755263
    m_Localized: "FortuneTeller: よく言うだろ\n第八ハウスに木星があるなら\n黙ってるのが一番って\nそいつが閉ざされた扉の徴だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755264
    m_Localized: 'FortuneTeller: 占いたいのかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755265
    m_Localized: その人 どうなったんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755266
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755267
    m_Localized: "FortuneTeller: 言ってやったんだよ\n「大事なのは なにをするかじゃなくて\nその間 オーラがどうかだよ」って\nあいつ 疑いっぱなし だったけどね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755268
    m_Localized: "FortuneTeller: だからさ\n人生がそばを素通りしてったのさ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755269
    m_Localized: "FortuneTeller: でも ある日\n私は目を閉じ 夢を思い描いたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755270
    m_Localized: "FortuneTeller: 自分の気を全部\nイメージに注ぎ込んだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755271
    m_Localized: "FortuneTeller: 気に心を開かないなら\nこの体に宿してる意味なんて\nないだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755272
    m_Localized: "FortuneTeller: お前さんにも できるさ\n目を閉じな…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755273
    m_Localized: "FortuneTeller: 自分が目標を達成してる姿を\nイメージするんだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755274
    m_Localized: 'FortuneTeller: 奥まで見つめて…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755275
    m_Localized: "FortuneTeller: 自分が苦しむ理由 わかるかい？\nそれはね まだ気付いてないからだよ\n苦しみこそ 幸せの最高の形だとね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755276
    m_Localized: "FortuneTeller: さあ…\n一歩を踏み出す覚悟はあるかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755277
    m_Localized: 'FortuneTeller: 占いたいのかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755278
    m_Localized: "「覚悟」って\nどういう意味ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755279
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755280
    m_Localized: "FortuneTeller: 自分を選ぶ ってことだよ\n匂わないかい？\n叶わなかった願いの残り香が\nもう解き放してやんな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755281
    m_Localized: "FortuneTeller: 私がドン底にいて\n光も意味も失ってたとき\n師匠に言われたんだ\n「内なる海に耳を傾けてない」って"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755282
    m_Localized: "FortuneTeller: 最初 笑っちまったよ 海って！？\nでも目を閉じたら 聞こえてきたんだ\nずっと鳴ってた音が\nお前さんも聞けるはずさ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755283
    m_Localized: "FortuneTeller: でも 一等 肝心なのは\n自分への問いかけさ\n自分と一つになる覚悟\nできてるかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755284
    m_Localized: 'FortuneTeller: 占いたいのかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755285
    m_Localized: 師匠って どんな人ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755286
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755287
    m_Localized: "FortuneTeller: 偉大な女だよ\n嵐の中で光る灯台みたいだった\n物事の本質の見抜き方を\n教えてくれたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755288
    m_Localized: "FortuneTeller: 師匠の言葉は今でも忘れられないよ\n「人が死ぬのは 内なる光の吸い方を\n知らないからだ」って"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755289
    m_Localized: "FortuneTeller: おかげで気付いたんだ\n私にも 人が己の道を\n見出す力になれる って"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755290
    m_Localized: "FortuneTeller: でも まあ 師匠は\nもっと先へ進むのを恐れてね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755291
    m_Localized: "FortuneTeller: 自分が中心だと見えてなかった\nその大事さ わかるかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755292
    m_Localized: "FortuneTeller: 内なる宇宙の中心が自分でなきゃ\n誰がいるってんだい？\nだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755293
    m_Localized: 'FortuneTeller: 占いたいのかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755294
    m_Localized: "どうやって自分自身を\n助けたんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755295
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755296
    m_Localized: "FortuneTeller: お前さんの過ちは ただ一つ\n内なる宇宙のコードを\n解読できてないことだね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755297
    m_Localized: "FortuneTeller: 私は 長旅してきたんだ\nあたりを ご覧よ 振り返ってさ\nこの家の今が見えるだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755298
    m_Localized: "FortuneTeller: 明るく 広く 私の気と調和してる\nこの家と争おうなんて\nしなくていいんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755299
    m_Localized: "FortuneTeller: 受け入れな こいつは もう\nお前さんの恐怖を吸ってるんだから\nでなきゃ壁が お前さんの涙を流すよ\nわかるだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755300
    m_Localized: 'FortuneTeller: 占いたいのかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755301
    m_Localized: なにを求めてるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755302
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755303
    m_Localized: "FortuneTeller: おっと かわいいじゃないか\n私が なにか求めてるとでも？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755304
    m_Localized: "FortuneTeller: 問題はね\n自分の影が踊るのを見ないと\nお前さんの道が隠れてる場所が\nわからない ってことさ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755305
    m_Localized: "FortuneTeller: 幸せのアファメーションを\n始めるしかないね\nなにもかも変わってきてると\n気付けるはずだよ 息しやすいだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755306
    m_Localized: "FortuneTeller: 私の気が お前さんの空間に繋がってる\n意味なんか求めるんじゃないよ\nそいつは混沌を受け入れるのが\n怖い連中の幻想さ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755307
    m_Localized: "FortuneTeller: その空間の一部になってみな\n「自分は客じゃなくて創造主だ」\nって口にするんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755308
    m_Localized: 'FortuneTeller: 占いたいのかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755309
    m_Localized: "もし創造主に\nなりたくないなら？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755310
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755311
    m_Localized: "FortuneTeller: お前さんの壁は ずっとお前さんを\n抱き締めたがってる\nでも お前さんが\n鎖で繋ぎ止めてるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755312
    m_Localized: "FortuneTeller: 内なる静寂こそ 世界の声だよ\nお前さんが恐れてる 世界のね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755313
    m_Localized: "FortuneTeller: お前さんの気は\n冬の蜂蜜みたいに凍ってる\n呼吸で溶かしてやらないと\nそれに鏡は嘘つかないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755314
    m_Localized: "FortuneTeller: 見えるのが自分だけなら\nなにも見えてないんだよ\n必要なのは 気を右回りに三度\nズラすこと"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755315
    m_Localized: "FortuneTeller: そしたら お前さん\nやっと幸せになれるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755316
    m_Localized: "Fanatic: 聞いてるとも オイ\n話しな！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755317
    m_Localized: "なにか宗教にでも\n入ってるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755318
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755319
    m_Localized: "Fanatic: おうとも オイ！\nだが オレの信仰は\nそんじょそこらの宗教じゃねえぞ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755320
    m_Localized: "Fanatic: オレが崇めてんのは 他でもない\n聖なる太陽だ！\nオレらを守ってくれてるな！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755321
    m_Localized: "Fanatic: だのに バカども\n太陽を悪者 扱いしやがる\n焼殺されるだのなんだの…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755322
    m_Localized: "Fanatic: 戯言も いい加減にしやがれ！\n太陽の怒りの矛先は\n悪の芽と異端者だ！\nあの罪人ども"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755323
    m_Localized: "Fanatic: それと 逆らおうって連中は\n燃え盛る手でブッ飛ばされんよう\nせいぜい祈ってな！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755324
    m_Localized: "Fanatic: テメエから火中に飛びこんで\n燃えときながら おったまげやがって"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755325
    m_Localized: 悪の芽？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755326
    m_Localized: 異端者？
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755327
    m_Localized: "Fanatic: まだ 質問攻めか？\n連中がエイリアンだって\n気付いてねえのかよ！？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755328
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755329
    m_Localized: "Fanatic: わかったよ オイ\n教えてやっから 真実を！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755330
    m_Localized: 'Fanatic: 来訪者は悪の芽なんだよ！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755331
    m_Localized: "Fanatic: 連中はエイリアンの末裔なんだ！\n太陽が若く 草原が青かった昔\n地球に降り立ったエイリアンのな！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755332
    m_Localized: "Fanatic: 忌まわしき使いどもが 地球に居を構え\n数世紀に渡って 近親交配を\n繰り返してきたんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755333
    m_Localized: "Fanatic: で今になって 地上へ這い出て\n我が物顔で土地を奪ってやがる！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755334
    m_Localized: "Fanatic: だがな 太陽様は オレらを\nオレらの土地を守ってくれたんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755335
    m_Localized: "Fanatic: 太陽は来訪者どもに一切 容赦しねえ！\nじゃなきゃ 連中ずっと\n地中に逃げ隠れしねえだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755336
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755337
    m_Localized: "Fanatic: クソッ… なんで あの晩\nあんなに酔っちまったんだ…？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755338
    m_Localized: "Fanatic: 潰れるまで飲むこたなかったんだ\n聖なる太陽が正義の怒りを…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755339
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755340
    m_Localized: "Fanatic: おお 聖なる太陽様\nアイツの罪を赦してくれ\n自らの行いを分かってねえんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755341
    m_Localized: "Fanatic: 優しく抱擁してやってくれ\nそれから もうアイツが水を\nやれねえ観葉植物の魂も…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755342
    m_Localized: 'Fanatic: かくあれかし'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755343
    m_Localized: 'Fanatic: その通りだ オイ！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755344
    m_Localized: 'Fanatic: FEMAこそ 忌まわしき異端者だ！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755345
    m_Localized: "Fanatic: 連中 オレらじゃ\n並の人間じゃ手出しできねえ\nとこまで足 踏み入れてくんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949376
    m_Localized: "Fanatic: 余計なとこまで首\n突っ込んできやがる"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949377
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949378
    m_Localized: "Fanatic: 母ちゃんを水たまりに\n突き落としたクズども\n太陽に焼かれちまえ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949379
    m_Localized: "Fanatic: 聞いてるとも オイ\n話しな！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949380
    m_Localized: "その たくさんの人が\n太陽で焼かれましたよね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949381
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949382
    m_Localized: "Fanatic: そうともよ\n悪の芽は みんなな オイ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949383
    m_Localized: "Fanatic: 数千年もの間 人間が積み重ねた罪を\n残らず罰すると 太陽は決めたんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949384
    m_Localized: "Fanatic: なのに来訪者のクソゴミカスどもは\n太陽に手を伸ばそうとしてやがる！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949385
    m_Localized: "Fanatic: だが太陽様はテメエらの\nもんじゃねえぞ モグラども\nオレら 人間のもんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949386
    m_Localized: 'Fanatic: オレら のなんだ！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949387
    m_Localized: "Fanatic: 人類に もたらされた天の恵みなんだよ\nクソッタレ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949388
    m_Localized: "どれだけ人が焼かれれば\n太陽は静まるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949389
    m_Localized: "世界の終わりは太陽の裁き\nということですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949390
    m_Localized: 'Fanatic: たんまりだよ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949391
    m_Localized: "Fanatic: オレを信じな ダチ公\nまだまだ 途方もないほどだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949392
    m_Localized: 'Fanatic: こんなの始まったばかりだぜ！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949393
    m_Localized: "Fanatic: 宇宙の力に釣り合うには\n天秤の皿が てんで足りちゃいねえ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949394
    m_Localized: "Fanatic: もっと焼かれなきゃならねえんだ！\n太陽様が放つ正義の炎でな！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949395
    m_Localized: "Fanatic: だがな ダチ公\n無駄死に なんかじゃねえんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949396
    m_Localized: "Fanatic: いつの日か オレら\n太陽の御心を知るはずだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949397
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949398
    m_Localized: "Fanatic: はあ 夜になると\nつい悲しくなっちまうんだ\nオレを捨てた妻を思い出してな…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949399
    m_Localized: 'Fanatic: 気高い女だった…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949400
    m_Localized: 'Fanatic: まあ 性悪でもあったが'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949401
    m_Localized: 'Fanatic: 終わり ってのは 誰のだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949402
    m_Localized: 'Fanatic: オレら？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949403
    m_Localized: 'Fanatic: はっ！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949404
    m_Localized: "Fanatic: 笑わせんなよ\n太陽は オレらの味方だろ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949405
    m_Localized: "Fanatic: オレらを助けてくれんだ\n見りゃわかんだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949406
    m_Localized: "Fanatic: 来訪者どもを地の底に\n突っ返そうとしてくれてる…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949407
    m_Localized: "Fanatic: 人類の罪で\nヤベえヤツらを罰してくれてる…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949408
    m_Localized: "Fanatic: 小便臭いボロ着て\nマスクでツラ隠してる\n恥知らずの異端者ども\n白日の下に晒してくれてる"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949409
    m_Localized: "Fanatic: 太陽に感謝しねえと\n世界の終わりだなんだ\n騒ぎ立てる前にな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949410
    m_Localized: 'Fanatic: 終わるのは太陽の敵どもだからな！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949411
    m_Localized: "Fanatic: 地底のモグラどもに死を！\n小便臭い異端者どもに死を！！\n悪の芽どもに死を！！！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949412
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949413
    m_Localized: "Fanatic: ああ ずいぶん長いこと\nフライドポテト食ってねえな…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949414
    m_Localized: "Fanatic: 聞いてるとも オイ\n話しな！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949415
    m_Localized: "今の事態に なにか神聖な\n意味があるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949416
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949417
    m_Localized: "Fanatic: オイ オレが あれほどクドクド\n甘やかしてやったのは\nなんでだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949418
    m_Localized: 'Fanatic: また同じ質問を繰り返すってのか！？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949419
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949420
    m_Localized: "Fanatic: 買いかぶってたみてえだな オイ\nこの事態の本質を まるで\nわかっちゃいねえとは"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949421
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949422
    m_Localized: "Fanatic: クソッ\nキンキンのビールが飲みてえ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949423
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949424
    m_Localized: 'Fanatic: 最後に一本 奢ってくれよ オイ？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949425
    m_Localized: "ええ どうぞ\n（ビールを渡す）"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949426
    m_Localized: "Fanatic: ビールねえのかよ？\nイカれてんのか オイ！？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949427
    m_Localized: 'Fanatic: この目で見たんだぞ！！！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949428
    m_Localized: "Fanatic: なあ オイ\nそんだけビール飲んどいて\n一口も分けちゃくれねえのかよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949429
    m_Localized: "ダメです\n（ビールを渡さない）"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949430
    m_Localized: "Fanatic: ああっ\nうめえ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949431
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949432
    m_Localized: "Fanatic: ふう やっぱ これだな\n黒ビール\nオレの好みだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949433
    m_Localized: "Fanatic: ダチと酒場で管巻いてたころを\n思い出すぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949434
    m_Localized: "Fanatic: バカ話 冷えたビール\nブレッドスティック それとソース…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949435
    m_Localized: "Fanatic: それから いつも不機嫌に\nオレら睨んでた痩せ男の仏頂面…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949436
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949437
    m_Localized: "Fanatic: まあ しんみりしてても しょうがねえ\nお前はマヌケだが オイ\nいいヤツなのは間違いねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949438
    m_Localized: 'Fanatic: ほんの礼だ 持ってけ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949439
    m_Localized: "Fanatic: 聖なる太陽が\nお前の魂を救いますように！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949440
    m_Localized: 'Fanatic: 腐れ外道！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949441
    m_Localized: "Fanatic: 地獄に堕ちやがれ！\nこのクソッタレ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949442
    m_Localized: "Fanatic: なんて恩知らずなんだ！\n神聖なる真理を語ってやったのに\nアイツ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949443
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949444
    m_Localized: 'Fanatic: 悪に穢れた腐れ人間！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949445
    m_Localized: "Fanatic: クソ食らえ\n血まみれのボロ小屋に\n引きこもってろ！\nオレはマシな場所に行くからよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949446
    m_Localized: "Fanatic: 今に見てろ\nアイツらが酒場に\n引き戻してくれるはずだからな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949447
    m_Localized: 'Fanatic: じゃあな アホ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949448
    m_Localized: "Anxiety: へへ へっへへ\n早く全部 終わるといいのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949449
    m_Localized: "どんな風に家を\n失ったんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949450
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949451
    m_Localized: "Anxiety: あぁ…\nあの日のこと よく覚えてる"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949452
    m_Localized: "Anxiety: クビになったから 家に帰って\nベッドに倒れて泣きたかった\nだけなのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949453
    m_Localized: "Anxiety: 着いたら玄関にクツが山ほど並んでて\nてっきり ルームメイトが\n友達でも呼んだのかな って"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949454
    m_Localized: "Anxiety: 部屋を覗いて 様子を見ようとした\nでも ドアに近づくと 変な音がして"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949455
    m_Localized: "Anxiety: ちょっと嫌な予感がして\nそれで どうなってるか\nそっと覗くことにした"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949456
    m_Localized: "Anxiety: ベッドに横たわって\n動かないルームメイトを\n一目 見た瞬間…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949457
    m_Localized: "Anxiety: 背後から不潔な男に腕を捕まれて\n「入るな あの子は…\n具合が悪いんだ」って"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949458
    m_Localized: "Anxiety: 「台所で話そう」って\n腕を引っ張られて\n椅子に座らされて"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949459
    m_Localized: "Anxiety: 逃げたかったけど\n恐怖で麻痺しちゃって…\nそれで…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949460
    m_Localized: "Anxiety: 私…\nそいつに…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949461
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949462
    m_Localized: "Anxiety: 休ませて\n不安で胃が痛くて\nはぁ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949463
    m_Localized: "Anxiety: へへ へっへへ\n早く全部 終わるといいのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949464
    m_Localized: "それで家で\nなにが起きたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949465
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949466
    m_Localized: 'Anxiety: うっ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949467
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949468
    m_Localized: "Anxiety: あの男に台所の椅子に座らされたら\n隅に隠れてた大男に出口を塞がれて"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949469
    m_Localized: "Anxiety: 大声で話し始めたんです\n腕を掴んだ男と"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949470
    m_Localized: "Anxiety: まるで…\n私なんて いないみたいに\nそれから…\n触れてきて！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949471
    m_Localized: 'Anxiety: 腕とか肩とか…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949472
    m_Localized: "Anxiety: それから奥のほう\n私の部屋から叫び声や大笑いが\n聞こえてきて…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949473
    m_Localized: "Anxiety: 男が大勢いるような\nそんな音でした"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949474
    m_Localized: "Anxiety: 呼吸が苦しくて\n心臓が飛び出しそうで…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949475
    m_Localized: "Anxiety: 叫んで助けを呼びたいのに\n声が…\n恐怖で 一言も出なくって"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949476
    m_Localized: "Anxiety: じっと座ってるだけでした\nテディベアみたいに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949477
    m_Localized: "Anxiety: でも 大男が冷蔵庫に\nなにか取りに行った瞬間\nチャンスだって気付いて…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949478
    m_Localized: "Anxiety: 全力で出口へ走りました\n恐怖が力をくれたみたいで\n逃げて 後ろは振り返りませんでした"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949479
    m_Localized: "Anxiety: 気付いたら\n力尽きて地面に\n倒れ込んでました…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949480
    m_Localized: "どうして太陽に\n焼かれなかったんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949481
    m_Localized: それから どうしたんです？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949482
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949483
    m_Localized: 'Anxiety: 思い出せないんです…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949484
    m_Localized: "Anxiety: 多分 一晩中そこで過ごして\nそれで…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949485
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949486
    m_Localized: "Anxiety: 変だな…\n起きたことは全部\n覚えてたはずなのに…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949487
    m_Localized: "Anxiety: 待ってください\nまさか私を…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949488
    m_Localized: 'Anxiety: 私…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949489
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949490
    m_Localized: 'Anxiety: 来訪者なんじゃ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949491
    m_Localized: "Anxiety: いえ そんなはず ありません\n生まれてからのこと 覚えてます\n子供の頃も 母と父のことも\n違うはず！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949492
    m_Localized: "Anxiety: 私 来訪者じゃありませんよね？\n違う って言って！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949493
    m_Localized: わかりません
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949494
    m_Localized: 来訪者じゃありませんよ
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949495
    m_Localized: 来訪者に見えますね
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949496
    m_Localized: "Anxiety: 地面に倒れて\nそれから…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949497
    m_Localized: 'Anxiety: それから…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949498
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949499
    m_Localized: "Anxiety: 起きたこと\n絶対に覚えてたはずなのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949500
    m_Localized: "Anxiety: 待ってください\nまさか私を…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949501
    m_Localized: 'Anxiety: 私…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949502
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949503
    m_Localized: 'Anxiety: 来訪者なんじゃ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949504
    m_Localized: "Anxiety: いえ そんなはず ありません\n生まれてからのこと 覚えてます\n子供の頃も 母と父のことも\n違うはず！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949505
    m_Localized: "Anxiety: 私 来訪者じゃありませんよね？\n違う って言って！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949506
    m_Localized: わかりません
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949507
    m_Localized: 来訪者じゃありませんよ
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949508
    m_Localized: 来訪者に見えますね
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949509
    m_Localized: "Anxiety: どうして\nそんなこと言うんですか！？\nああっ もう\n恐ろしい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949510
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949511
    m_Localized: "Anxiety: 休ませて\nまた胃が痛くて\nはぁ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949512
    m_Localized: "Anxiety: ありがとう\n少し ほっとしました"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949513
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949514
    m_Localized: "Anxiety: うっ 休まないと\nまた胃が痛くて"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949515
    m_Localized: "Anxiety: どうして\nそんなこと言うんですか！？\nもっと怖く なったじゃないですか！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949516
    m_Localized: "Anxiety: 死にたくない！\n死ぬなんて嫌！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949517
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949518
    m_Localized: 'Anxiety: みんな 死んじゃうんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949519
    m_Localized: "Anxiety: へへ へっへへ\n早く全部 終わるといいのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949520
    m_Localized: 大丈夫ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949521
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949522
    m_Localized: 'Anxiety: もう近寄らないで！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949523
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949524
    m_Localized: "Anxiety: ごめんなさい…\n殺されるのかと"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949525
    m_Localized: どうして そう思ったんです？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949526
    m_Localized: "殺すつもりなら\nとっくに そうしてますよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949527
    m_Localized: 'Anxiety: 私…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949528
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949529
    m_Localized: "Anxiety: 誰が来訪者で 誰が違うのか\n見当つかなくて…\nもし…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949530
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949531
    m_Localized: 'Anxiety: もし あなたが来訪者だったら？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949532
    m_Localized: "Anxiety: 私を殺します？\n皮を剥ぐんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949533
    m_Localized: "Anxiety: お願い やめて！\nせめて苦しまないよう\n手早くして！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949534
    m_Localized: "Anxiety: 苦しんで死ぬなんて嫌！\nお願いだから！！！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949535
    m_Localized: "落ち着いて\n来訪者じゃありませんから"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949536
    m_Localized: "殺すつもりなんて\nありませんよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949537
    m_Localized: "Anxiety: ごめんなさい\n私 本当 崖っぷちで"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949538
    m_Localized: "Anxiety: 誰を信じていいのか\nまるでわからなくて"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949539
    m_Localized: 'Anxiety: それで もし…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949540
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949541
    m_Localized: 'Anxiety: もし あなたが来訪者だったら？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949542
    m_Localized: "Anxiety: 私を殺します？\n皮を剥ぐんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949543
    m_Localized: "Anxiety: お願い やめて！\nせめて苦しまないよう\n手早くして！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949544
    m_Localized: "Anxiety: 苦しんで死ぬなんて嫌！\nお願いだから！！！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949545
    m_Localized: "落ち着いて\n来訪者じゃありませんから"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949546
    m_Localized: "殺すつもりなんて\nありませんよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949547
    m_Localized: "Anxiety: どうやって信じろ って言うの！\nあなたの歯も目も\n確かめてないのに…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949548
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949549
    m_Localized: "Anxiety: みんな死んじゃうんだ\n来訪者に殺されるか\n太陽に焼かれるかして…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949550
    m_Localized: "Anxiety: もう希望なんてない\n死は来るんだもの 絶対に"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949551
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949552
    m_Localized: 'Anxiety: 放っておいて'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949553
    m_Localized: "Anxiety: どうやって信じろ って言うの！\nあなたの歯も目も\n確かめてないのに…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949554
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949555
    m_Localized: "Anxiety: みんな死んじゃうんだ\n来訪者に殺されるか\n太陽に焼かれるかして…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949556
    m_Localized: "Anxiety: もう希望なんてない\n死は来るんだもの 絶対に"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949557
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949558
    m_Localized: 'Anxiety: 放っておいて'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949559
    m_Localized: "Anxiety: へへ へっへへ\n早く全部 終わるといいのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949560
    m_Localized: どうしました？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949561
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949562
    m_Localized: "Anxiety: 来訪者！\n来訪者が近づいてる！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949563
    m_Localized: "Anxiety: 聞こえないの？\n死が呼んでる"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949564
    m_Localized: "Anxiety: 来訪者だろうと人間だろうと…\nどう違うっていうの！？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949565
    m_Localized: 'Anxiety: みんな死ぬ運命じゃない！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949566
    m_Localized: "Anxiety: なら 苦しんで待つ\n意味なんてないでしょ？\n入れちゃえば いいんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949567
    m_Localized: "Anxiety: 来訪者は私たちを思って来てるの！\n入れてあげないと！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949568
    m_Localized: 具合が悪そうですね
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949569
    m_Localized: 正気を失いました？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949570
    m_Localized: "Anxiety: 違う！\n目覚めただけ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949571
    m_Localized: 'Anxiety: 私は来訪者なの！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949572
    m_Localized: "Anxiety: 私たちと人間は同じ！\n似たもの同士！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949573
    m_Localized: 'Anxiety: 鏡映しみたいだもの！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949574
    m_Localized: 'Anxiety: 一緒に死を受け入れましょう！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949575
    m_Localized: "なにを言ってるのか\nわかってませんね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949576
    m_Localized: 選択の余地が ありません
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949577
    m_Localized: "Anxiety: 狂ってなんてない！\n目覚めただけ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949578
    m_Localized: 'Anxiety: 私は来訪者なの！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949579
    m_Localized: "Anxiety: 私たちと人間は同じ！\n似たもの同士！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949580
    m_Localized: 'Anxiety: 鏡映しみたいだもの！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949581
    m_Localized: 'Anxiety: 一緒に死を受け入れましょう！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949582
    m_Localized: "なにを言ってるのか\nわかってませんね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949583
    m_Localized: 選択の余地が ありません
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949584
    m_Localized: 'Anxiety: いえ わかってないのは そっち！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949585
    m_Localized: "Anxiety: 死が来るの！\n死の到来を太陽が告げてる！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949586
    m_Localized: "Anxiety: すぐに会えるはず\nもうすぐ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949587
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949588
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949589
    m_Localized: "Anxiety: なら 撃ちなさいよ！\nなに ためらってるの！？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949590
    m_Localized: "Anxiety: なんの躊躇もなく\n私を殺すっていうの？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949591
    m_Localized: "Anxiety: どうでもいい\nやるべきことやりなさいよ 人間"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949592
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949593
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949594
    m_Localized: "Esenin: ああ？\nなにか用かい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949595
    m_Localized: "それで どうして\n酒場を追い出されたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949596
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949597
    m_Localized: "Esenin: 災厄 続きで\nみんな発狂したのさ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949598
    m_Localized: "Esenin: 太陽爆発 来訪者 経済危機\n挙げれば切りがない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949599
    m_Localized: "Esenin: 誰も彼も破綻した\nストレスにしろアルコールにしろ\nそれぞれにな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949600
    m_Localized: "Esenin: まあ…\n俺は怒りで常軌を逸したんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949601
    m_Localized: "Esenin: 酒場のテーブルに上って叫んだのさ\n「なんでもかんでも\n周りのせいにするな\nせめて人間らしくしろ」"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949602
    m_Localized: "Esenin: ビールの泡に涙が\n混じったって構わない\nモルトもホップも塩気で\nかえって美味くなる"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949603
    m_Localized: 'Esenin: 誰が そんなもの必要とする？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949604
    m_Localized: "Esenin: ああ？\nなにか用かい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949605
    m_Localized: ここは なにか違います？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949606
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949607
    m_Localized: "Esenin: もう誰にも迷惑かけやしないよ\nそこまでする価値はない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949608
    m_Localized: "Esenin: だがテレビの音声や\n噂話が耳に入ると\nまた脳全体に火が点くんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949609
    m_Localized: "Esenin: そして自問自答する\nこんなの必要か？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949610
    m_Localized: "Esenin: いや もういいんだ\n俺の神経は とうの昔に地獄送りだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949611
    m_Localized: 'Esenin: ただでさえ味気ない人生なのに 今や…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949612
    m_Localized: "Esenin: いつかシャンデリアに ぶら下がって\n洗礼済みの世界中\n見渡したいもんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949613
    m_Localized: "Esenin: ああ？\nなにか用かい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949614
    m_Localized: 大丈夫ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949615
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949616
    m_Localized: "Esenin: えっ？\nなんの話だ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949617
    m_Localized: なにか臭うんです
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949618
    m_Localized: 熱がありませんか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949619
    m_Localized: "Esenin: ああ…\n君のビールを少々いただいたよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949620
    m_Localized: "Esenin: 嘔吐感があって\nちょっと飲むことにしたんだ\n別に犯罪でもなんでも ないだろう"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949621
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949622
    m_Localized: 'Esenin: 全く クソめちゃくちゃだな'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949623
    m_Localized: "Esenin: 誰も彼も 問題解決を うそぶきながら\n口を開けばクソばかり\nなにも変わりはしない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949624
    m_Localized: "Esenin: いいか\n俺たち じきに死ぬだろう"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949625
    m_Localized: "Esenin: 太陽に殺されなくても\n来訪者にやられる\n来訪者を倒したとして\n自分たちで生き埋めになる"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949626
    m_Localized: "Esenin: クソ問題がなければ\n進んで作り出すんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949627
    m_Localized: "Esenin: クソまみれのズボンなしじゃ\n生きていけないみたいにな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949628
    m_Localized: 'Esenin: クソ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949629
    m_Localized: "Esenin: 行ってくれ\n吐きそうだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949630
    m_Localized: "Esenin: 熱があるのは俺じゃない\nクソ星のほうだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949631
    m_Localized: "Esenin: どこを見ても誰か死んでる\nそれか氷河が溶けてるか\n森が燃えてるか\n世界中 熱に うなされてるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949632
    m_Localized: "Esenin: 地球が血でパンパンのノミどもを\n振り落とそうとしている"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949633
    m_Localized: "Esenin: いつか そうなるだろうよ\nご待望の面倒事だ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949634
    m_Localized: 'Esenin: うう…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949635
    m_Localized: "Esenin: 消えてくれ\n頼む\n具合が悪いんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949636
    m_Localized: "Esenin: ああ？\nなにか用かい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949637
    m_Localized: よくなりました？
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949638
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949639
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949640
    m_Localized: 'Esenin: なあ 君…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949641
    m_Localized: "Esenin: 俺たち いつの日か死ぬ定めだ\n逃れようがない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949642
    m_Localized: "Esenin: 不思議に思ったことはないか？\n死後どうなるか"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949643
    m_Localized: 信じたとおりに なるはずです
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949644
    m_Localized: 無です
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949645
    m_Localized: "わかりませんが\n宇宙に行くのかも"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949646
    m_Localized: 'Esenin: 一理あるな'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949647
    m_Localized: "Esenin: だが まるで心が落ち着かない\nなぜか わかるか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949648
    m_Localized: "Esenin: 死にかけると 脳が察知するだろう\nそれから 走馬灯が駆け巡る"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949649
    m_Localized: "Esenin: そして 夢見る力すら失われたら\nどうなる？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949650
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949651
    m_Localized: "Esenin: ダメだ\nちっとも よくならない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949652
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949653
    m_Localized: "Esenin: 君には\n違う答えを期待していた"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949654
    m_Localized: "Esenin: 君が正しいのかもしれない\nだが それこそが恐ろしい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949655
    m_Localized: "Esenin: なに一つ残らず…\nただ… 闇だけ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949656
    m_Localized: 'Esenin: 今は口を開く気になれない'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143680
    m_Localized: 'Esenin: そう考えると…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143681
    m_Localized: "Esenin: 宇宙には俺たち以外\nなにもないんだな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143682
    m_Localized: "Esenin: 他に生命はない\nただ冷たく がらんどう の空間があるだけ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143683
    m_Localized: "Esenin: なにかいるなら\nとっくに信号なりなんなり\n見つかってるはずだ 恐らく\n俺には よくわからないが"
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143684
    m_Localized: "Esenin: 果てしなき暗闇 終わりなき虚空\n死後そこに行き着くなら\nつまり消滅も同然だ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337984
    m_Localized: "Esenin: その…\n一人にしてくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337985
    m_Localized: "Esenin: ああ？\nなにか用かい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337986
    m_Localized: "えっと…\n大丈夫ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337987
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337988
    m_Localized: "Esenin: あの酒場\n少なくとも天井は高かった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337989
    m_Localized: "Esenin: 首をくくるには\nおあつらえ向きでな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337990
    m_Localized: "Esenin: ここは息が詰まる\nこの星そのものが\n俺には狭苦しくて しかたない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337991
    m_Localized: "Esenin: なあ君\n俺はただ\nすべて終わってほしいんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337992
    m_Localized: "Esenin: みんな めちゃくちゃだ\nなにもかも 怖くてしょうがない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337993
    m_Localized: 'Esenin: もう耐えられないんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337994
    m_Localized: "Esenin: なんでまた\nこんなところに来たんだろうな？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337995
    m_Localized: 'Widow: 少し休ませて…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337996
    m_Localized: なにか必要ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337997
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337998
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337999
    m_Localized: 'Widow: 夫に生きててほしい'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338000
    m_Localized: 'Widow: それだけ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338001
    m_Localized: "Widow: それ以外\n必要ありません"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338002
    m_Localized: 水を持って来ましょうか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338003
    m_Localized: なにか食べます？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338004
    m_Localized: 'Widow: いえ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338005
    m_Localized: 'Widow: 蛇口の側に座ってますから'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338006
    m_Localized: 'Widow: 喉が渇いたら飲みます'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338007
    m_Localized: じゃあ これで
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338008
    m_Localized: "ご一緒しても\nよろしいですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338009
    m_Localized: 'Widow: お腹 空いてません'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338010
    m_Localized: 'Widow: ただ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338011
    m_Localized: 'Widow: 座っていたいだけ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338012
    m_Localized: じゃあ これで
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338013
    m_Localized: "ご一緒しても\nよろしいですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338014
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338015
    m_Localized: "Widow: どうして\n先に死んでしまったの？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338016
    m_Localized: "Widow: なにもかも うまくいくって\n約束してくれたのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338017
    m_Localized: "Widow: なにもかも うまくいくって\n言ったのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338018
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338019
    m_Localized: 'Widow: 死んでしまった'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338020
    m_Localized: 'Widow: だから 一人で生き残るしかない'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338021
    m_Localized: 'Widow: なんで あんなこと したの？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338022
    m_Localized: 'Widow: あの人と 二人で いたい'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338023
    m_Localized: "Widow: あなたじゃ\n誰かを連れ戻したりできない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338024
    m_Localized: 'Widow: 私は もう…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338025
    m_Localized: 'Widow: 埋めることさえ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338026
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338027
    m_Localized: 'Widow: あの人を埋めることさえ できない'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338028
    m_Localized: 'Widow: どうすれば いいの？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338029
    m_Localized: 'Widow: 少し休ませて…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338030
    m_Localized: "旦那さん\nどうして亡くなったんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338031
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338032
    m_Localized: 'Widow: 無理です'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338033
    m_Localized: 'Widow: 辛すぎて'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338034
    m_Localized: 'Widow: 涙も流し尽くした ばかりなんです'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338035
    m_Localized: "Widow: もう 流す涙が\n残ってないみたい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338036
    m_Localized: 'Widow: でも それでいいの？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338037
    m_Localized: 'Widow: 泣くのを やめるだけで'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338038
    m_Localized: 埋葬してあげないと
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338039
    m_Localized: "残ってるのは遺体だけです\n受け入れないと"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338040
    m_Localized: 'Widow: いや…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338041
    m_Localized: 'Widow: いや いや いや'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338042
    m_Localized: 'Widow: まだ 準備できてない'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338043
    m_Localized: "Widow: あの人 私のもとに戻って来た\nところなのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338044
    m_Localized: 'Widow: もう 別れないといけないの？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338045
    m_Localized: 'Widow: できない'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338046
    m_Localized: "Widow: 冷たい地中になんて\n埋められない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338047
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338048
    m_Localized: 'Widow: いや'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338049
    m_Localized: "Widow: 違う\nそんなはずない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338050
    m_Localized: 'Widow: あの人 まだ私の声が聞こえてるもの'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338051
    m_Localized: 'Widow: 私…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338052
    m_Localized: "Widow: そう信じたいんです\n心から"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338053
    m_Localized: 'Widow: 少し休ませて…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338054
    m_Localized: 旦那さんと どんな思い出が？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338055
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338056
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338057
    m_Localized: "Widow: ある日\n二人で友達に会いに行ったんです"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338058
    m_Localized: 'Widow: 二人とも ずっと若かった頃'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338059
    m_Localized: "Widow: お喋りして お酒を飲んで\nあの人 普段とても無口で\nそういう集まりでも\n滅多に話さなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338060
    m_Localized: "Widow: それで その日も\nずいぶん飲んじゃって"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338061
    m_Localized: "Widow: いつも通り静かにしてたけど\n突然こう言った"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338062
    m_Localized: 'Widow: 「ギターをくれ 今から歌うぞ」'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338063
    m_Localized: 'Widow: すごく演奏が上手で 愛おしかった'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338064
    m_Localized: "Widow: みんな次々 色んな歌を\nリクエストすると\nあの人ちょっと黙って それから…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338065
    m_Localized: "Widow: 立ち上がって\n帰らなきゃって グラスを倒して\n掴もうとして ギターを落として…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338066
    m_Localized: "Widow: 後で わかったの\nあの人 私を驚かせようと\nあの歌だけ練習してた"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338067
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338068
    m_Localized: 'Widow: あの夜の写真 まだ持ってるの'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338069
    m_Localized: 'Widow: 少し破れちゃったけど…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338070
    m_Localized: "Widow: もう 私のために歌ってくれないのね\nあれが最後の歌だったんだね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338071
    m_Localized: 'Widow: 少し休ませて…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338072
    m_Localized: "それで 旦那さんに\nなにがあったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338073
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338074
    m_Localized: 'Widow: くたばったの'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338075
    m_Localized: "わかりました\nお邪魔してすみません"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338076
    m_Localized: 私が殺したんじゃありません
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338077
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338078
    m_Localized: "Widow: ごめんなさい\n私その…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338079
    m_Localized: "Widow: 毎晩 涙が出て\n止まらないんです"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338080
    m_Localized: "Widow: でも なによりも…\nなにもかもの元凶に…\n太陽で焼け死んでほしい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338081
    m_Localized: "その…\nなにがあったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338082
    m_Localized: "これ以上 訊くのは\nやめにします"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338083
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338084
    m_Localized: 'Widow: ええ わかってる'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338085
    m_Localized: "Widow: 無礼でした\nでも あの人のことになると\n話すのが辛くて"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338086
    m_Localized: "Widow: あのクソども\n報いを受ければいい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338087
    m_Localized: 'Widow: 誰かが殺してくれれば いいのに'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338088
    m_Localized: その…なにがあったんです？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338089
    m_Localized: "これ以上 訊くのは\nやめにします"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338090
    m_Localized: "Widow: あの人 具合が悪くて\n病院に行ったんです\nでも あのクソどもに送られて"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338091
    m_Localized: 'Widow: FEMAが開設した施設に行かされた'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338092
    m_Localized: "Widow: FEMAは隔離するだけで\n電話まで取り上げた\n三週間で出られる としか伝えず"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338093
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338094
    m_Localized: "Widow: 早めに行ったんです\n心配で"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338095
    m_Localized: 'Widow: 連中 冷たく言った…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338096
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338097
    m_Localized: "Widow: 少し待って\nごめんなさい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338098
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338099
    m_Localized: 'Widow: 「死にました」って'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338100
    m_Localized: 'Widow: それだけ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338101
    m_Localized: 'Widow: 遺体に会わせてもらえなかった'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338102
    m_Localized: 'Widow: 家にも連れて帰らせてくれなかった'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338103
    m_Localized: "Widow: でも あのバカども無能だから\n研究所の白衣を着て\n安置所に忍び込めば すんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338104
    m_Localized: 'Widow: それで あの人…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338105
    m_Localized: 'Widow: 本当に そこにいた…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338106
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338107
    m_Localized: "Widow: あいつらが殺したんだ\nあの人の魂は あいつらの手の内\n私は 誰の目も気にせず 叫ぶしかない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338108
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338109
    m_Localized: 'Widow: 一人になりたい'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338110
    m_Localized: "Widow: ええ\nありがとう"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338111
    m_Localized: "Widow: あの人なしで生きるのは\nあまりに辛い…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338112
    m_Localized: 'Widow: 少し休ませて…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338113
    m_Localized: どうかしました？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338114
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338115
    m_Localized: 'Widow: 今夜 出ていきます'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338116
    m_Localized: "Widow: はじめに言ったとおり\n長居するつもりはありません"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338117
    m_Localized: 'Widow: 少し休みたかっただけですから'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338118
    m_Localized: これから どうするんです？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338119
    m_Localized: "家族のもとに\n向かうんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338120
    m_Localized: 'Widow: 考えたくありません'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338121
    m_Localized: 'Widow: 家に帰ります'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338122
    m_Localized: 'Widow: ギターを取り出して'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338123
    m_Localized: 'Widow: それから…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338124
    m_Localized: いてもいいんですよ
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338125
    m_Localized: お気を付けて
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338126
    m_Localized: 'Widow: 誰も残ってません'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338127
    m_Localized: 'Widow: 二人で家に帰ります'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338128
    m_Localized: 'Widow: 他に なにもいりませんから'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338129
    m_Localized: いてもいいんですよ
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338130
    m_Localized: お気を付けて
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338131
    m_Localized: 'Widow: どうして？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338132
    m_Localized: 'Widow: そうしても 気は楽になりません'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338133
    m_Localized: "Widow: 悪く思わないでください\n貴方のことは\nなんとも思ってません"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338134
    m_Localized: 'Widow: とにかく 家に帰りたいんです'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338135
    m_Localized: 'Widow: 帰るまでは なにもいりません'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338136
    m_Localized: 'Widow: ありがとう'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338137
    m_Localized: "Widow: あまり口 開かなかったけど…\n貴方は いい話し相手だった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338138
    m_Localized: "Widow: 貴方が探しているものが\n見つかりますように"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338139
    m_Localized: "Scammer: へへっ\nよお！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338140
    m_Localized: "大厄災の前は\nなにをしてたんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338141
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338142
    m_Localized: 'Scammer: おっ 訊いてくれるかい ニイさん！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338143
    m_Localized: 'Scammer: 耳にしたこと あるだろ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338144
    m_Localized: 'Scammer: …スポーツ賭博っての？ん？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338145
    m_Localized: 詐欺師ということですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338146
    m_Localized: ええ
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338147
    m_Localized: "Scammer: ちょっ 待て待て！\nオイラはスポーツアナリストだっての"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338148
    m_Localized: "Scammer: 手元に どれだけ転がり込んだか\n知ったら ヨダレもんだぜ 兄弟"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338149
    m_Localized: "Scammer: プロ中のプロってワケ\nったく"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338150
    m_Localized: "Scammer: みんなオイラにカネ 預けてさ\n5倍…いや 10倍にしてやったんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338151
    m_Localized: "それで どれだけ\n稼いだんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338152
    m_Localized: それ 仕事って言うんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338153
    m_Localized: 'Scammer: そいつでメシ食ってたんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338154
    m_Localized: "Scammer: 賭けで儲けるなんざ朝飯前よ 兄弟\n間違いなし"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338155
    m_Localized: "Scammer: 胴元 出し抜く手筈ってのが\nちゃんとあるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338156
    m_Localized: "Scammer: 特定のチームに賭けて\n後は配当の戻りを待つだけ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338157
    m_Localized: "Scammer: 文無しでも問題なし\n誰かに借りれば すむ話だ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338158
    m_Localized: "それで どれだけ\n稼いだんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338159
    m_Localized: それ 仕事って言うんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338160
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338161
    m_Localized: 'Scammer: えっとな…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338162
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338163
    m_Localized: "Scammer: 稼いださ\nその 三千万…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338164
    m_Localized: "Scammer: …借金をな\nなあに 借金ぐらい なんでもないさ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338165
    m_Localized: 'Scammer: 今となっちゃ どうだっていいしな'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338166
    m_Localized: 'Scammer: リスクを直視するんだよ 兄弟'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338167
    m_Localized: 'Scammer: マジかよ？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338168
    m_Localized: 'Scammer: 当然 仕事だっての'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338169
    m_Localized: "Scammer: ちゃんとした事務所だって あったんだ\nなあ マジで豪華なのが…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338170
    m_Localized: "Scammer: ピカピカのソファに ノートも完備だ\n胴元と借金額 純利益をメモるためのよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338171
    m_Localized: "Scammer: へへっ\nよお！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338172
    m_Localized: "借金取りは\nまだ来ないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338173
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338174
    m_Localized: "Scammer: 借金取りだあ？\nなんの話だよ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338175
    m_Localized: "Scammer: ふんっ 忘れちまいな\nほら もう借金なんざチャラだ\n太陽のおかげでな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338176
    m_Localized: "Scammer: 今更 銀行も どうこう言うはずがない\n二度と現れないかもな！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338177
    m_Localized: "Scammer: つまりよ\nすっかり自由の身ってワケ\nで 新しい儲け話を仕込める って寸法"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338178
    m_Localized: "Scammer: 賭博なんてのは時代後れだ\nもっとイケてるシノギ考えなきゃな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338179
    m_Localized: "あなたには太陽が\n幸運だったんですね？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338180
    m_Localized: "では なんですか？\nまた儲け話でも？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338181
    m_Localized: 'Scammer: おいおい カンベンしてくれよ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338182
    m_Localized: "Scammer: オイラなら 借金なんざ\nちょちょいのちょい で返せたんだ\nどうってこたあないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338183
    m_Localized: "Scammer: でも今なら\nまっさらで始められんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338184
    m_Localized: "Scammer: それはそうと\n新しい儲け話があるんだ\n聞きたかないかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338185
    m_Localized: どんな計画ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338186
    m_Localized: 興味ありません
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338187
    m_Localized: "Scammer: ちょいと前に稼ぎ思いついたんだ\nよければ 教えようか"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338188
    m_Localized: どんな計画ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338189
    m_Localized: 興味ありません
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338190
    m_Localized: "Scammer: 要はさ\nこのへん仕切ってんのはFEMAだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338191
    m_Localized: "Scammer: ってことはだ…\n気に入られるのが得策だよな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338192
    m_Localized: "Scammer: そんでさ\n定期的に人を引き渡してりゃ\n地下シェルターに連れてって\nもらえるかもしれないだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338193
    m_Localized: 'Scammer: どうだい？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338194
    m_Localized: "FEMAに人を引き渡す\nつもりですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338195
    m_Localized: FEMAに救ってもらえると？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338196
    m_Localized: "Scammer: そりゃ そうだろ\n他に なにがあんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338197
    m_Localized: "Scammer: オイラの見立てじゃ\nこれで生き延びられるぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338198
    m_Localized: "Scammer: 時代が変わりゃ\n儲け話も変わる ってワケだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338199
    m_Localized: "Scammer: 隔離区域の連中に混じるなんざ\n正気の沙汰じゃないだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338200
    m_Localized: "Scammer: だからよ\nFEMAとは よろしくやっとくべきだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338201
    m_Localized: "Scammer: 大口 叩かず\n人を差し出してりゃいいんだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338202
    m_Localized: "Scammer: それに緊急回線で徴候を検査すれば\n確証 持ってもらえるだろ\nオイラが… なんだ…\n来訪者ってヤツじゃないって"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338203
    m_Localized: "Scammer: 弁えてる連中だ\nどう動くのが得策か\nわかってるはずだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338204
    m_Localized: そうかもしれませんね
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338205
    m_Localized: くだらない話です
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338206
    m_Localized: "そこまでFEMAに会いたいなら\n出ていってください"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338207
    m_Localized: "Scammer: おいおい なんだい\nニイさん 変化の風が\nてんで読めてないんだな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338208
    m_Localized: "Scammer: 誰が舵を握ってるか見極めて\n乗っかるんだよ\nこいつが勝利の方程式 ってヤツよ\n間違いなし"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338209
    m_Localized: "Scammer: だからよ\nFEMAとは よろしくやっとくべきだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338210
    m_Localized: "Scammer: 大口 叩かず\n人を差し出してりゃいいんだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338211
    m_Localized: "Scammer: それに緊急回線で徴候を検査すれば\nばっちり確証 持ってもらえるだろ\nオイラが来訪者ってヤツじゃないって"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338212
    m_Localized: "Scammer: 弁えてる連中だ\nどう動くのが得策か\nわかってるはずだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338213
    m_Localized: そうかもしれませんね
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338214
    m_Localized: くだらない話です
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338215
    m_Localized: "そこまでFEMAに会いたいなら\n出ていってください"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338216
    m_Localized: "Scammer: もちろん\nオイラの言うとおりだって"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338217
    m_Localized: "Scammer: 儲け話を見抜く\n第六感が宿ってんだから 兄弟"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338218
    m_Localized: "Scammer: オイラを信じな\n損はさせないからさ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338219
    m_Localized: "Scammer: おいおい\nカンベンしてくれよ\nくだらないのは ニイさんの ほうだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338220
    m_Localized: "Scammer: 投資アドバイスで稼いでたオイラが\nロハで話してやってんだぜ\nそれをさあ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338221
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338222
    m_Localized: 'Scammer: クソッ もういいよ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338223
    m_Localized: "Scammer: えっ\nオイラを追い出す ってのかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338224
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338225
    m_Localized: "Scammer: おいおい ニイさんは\nわかるヤツだと思ってたのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338226
    m_Localized: "Scammer: 儲け話まで用意したんだよ\nそれをさあ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338227
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338228
    m_Localized: "Scammer: もういいよ\n家に帰るからさ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338229
    m_Localized: "Scammer: クソッ\nマジでイケてる儲け話\n思いついたのに\nまあ いいか…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338230
    m_Localized: "Scammer: 気が変わったら\nいつでも言いなよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338231
    m_Localized: "Scammer: へへっ\nよお！"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338232
    m_Localized: なんの用ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338233
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338234
    m_Localized: "Scammer: ほら 新しい儲け話\n思いついたんだ\nイケてるヤツ\n間違いなし"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338235
    m_Localized: 'Scammer: よし つまりだな…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338236
    m_Localized: "Scammer: 太陽の照り具合\nまるで地獄のサウナだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338237
    m_Localized: 'Scammer: オゾン層もダメになるんじゃないか'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338238
    m_Localized: "Scammer: でも 確か…\n日光がオゾン通ると\n酸素ができるんだよな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338239
    m_Localized: "Scammer: で なに思いついたか\nわかるかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338240
    m_Localized: 'Scammer: …空気を売るんだ！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338241
    m_Localized: "Scammer: ほら\nこいつは間違いない儲け話だ\nオイラを信じなって"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338242
    m_Localized: "とんでもない計画で\n信じがたいぐらいです"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338243
    m_Localized: "人生で一番\n馬鹿げた話です"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338244
    m_Localized: "Scammer: マジ？\nマジで そう思う？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338245
    m_Localized: "ええ もちろん\n科学者になってはどうですか"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338246
    m_Localized: いえ
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338247
    m_Localized: "Scammer: おいおい\nまたまた…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338248
    m_Localized: "Scammer: ありがとうな\n誰かにオツムを認めてもらう ってのは\nいいもんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338249
    m_Localized: "Scammer: そのうち\nダーウィン賞あたり取るかもな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338250
    m_Localized: "えっと…ダーウィン賞が\nなにか知ってます？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338251
    m_Localized: ええ 受賞 間違いなしです
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338252
    m_Localized: "Scammer: えっと… そりゃ…\n科学への貢献や なんかを\n表彰するんだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338253
    m_Localized: "Scammer: なんでまた\nそんなこと訊くんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338254
    m_Localized: なんとなくです
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338255
    m_Localized: "ダーウィン賞は愚かな死に方を\nした人に贈られるんです"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338256
    m_Localized: "Scammer: ははっ！\nもう科学の世界で\n認知された気がするよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338257
    m_Localized: "Scammer: 大金の山 社会的地位 いいネエちゃん…\n夢だね こりゃ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338258
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338259
    m_Localized: "Scammer: よし こいつが終わったら\n空気販売の特許を取るよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338260
    m_Localized: "Scammer: ああ\nだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338261
    m_Localized: 'Scammer: んっ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338262
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338263
    m_Localized: "Scammer: 待てよ\nオイラを からかってるだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338264
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338265
    m_Localized: "Scammer: ふざけんなって\nこっちはマジモンの絵図\n描いてんのに コケにして"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338266
    m_Localized: "Scammer: ふざけんなって\nこっちはマジモンの儲け話\n考えてんのに コケにして"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338267
    m_Localized: 'Scammer: ダーウィン賞 取って お大尽だ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338268
    m_Localized: "Scammer: そのときは ニイさん\n土下座して謝るハメになるぜ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338269
    m_Localized: "クソみたいなアイデアを\n持ち込むなと言っただろ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338270
    m_Localized: "Scammer: おいおい\nニイさん…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338271
    m_Localized: "Scammer: ちょっとぐらい話\n聞いてくれたって いいだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338272
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532288
    m_Localized: "Scammer: もういいよ クソッ\n儲け全部 独り占めするからな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532289
    m_Localized: "Scammer: おいおい\nニイさん…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532290
    m_Localized: "Scammer: ふざけんなって\nこっちはマジモンの儲け話\n考えてんのに コケにして"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532291
    m_Localized: 'Scammer: ダーウィン賞 取って お大尽だ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532292
    m_Localized: "Scammer: そのときは ニイさん\n土下座して謝るハメになるぜ…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532293
    m_Localized: "Neighbour: チッ…\nやっぱり本当だったのか…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532294
    m_Localized: "Neighbour: なら\n俺の言ったとおりだな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532295
    m_Localized: "Neighbour: 日中は外に出ちゃダメだ\nそれと家に他人を入れなきゃならない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532296
    m_Localized: なぜ見知らぬ相手を家に？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532297
    m_Localized: 人を招き入れろと？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532298
    m_Localized: "Neighbour: 人付き合いを避けてるのは\nわかってる\nでも やるしかないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532299
    m_Localized: "Neighbour: 従姉妹も詳しくなかったが\n 一人でいちゃダメらしい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532300
    m_Localized: "Neighbour: だが アイツ言ってたんだ\n一人きりか訊ねられたら\n家に人がいる と答えろと"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532301
    m_Localized: 人と関わるのは億劫なんだ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532302
    m_Localized: 他人が なんの役に立つんだ？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532303
    m_Localized: 'Neighbour: ああ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532304
    m_Localized: "Neighbour: アンタが群れたがらないのは\nわかってる\nでも 招き入れるしかないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532305
    m_Localized: "Neighbour: 従姉妹も詳しくなかったが\n一人でいちゃダメらしい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532306
    m_Localized: "Neighbour: だが アイツ言ってたんだ\n一人きりか訊ねられたら\n家に人がいる と答えろと"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532307
    m_Localized: 人と関わるのは億劫なんだ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532308
    m_Localized: 他人が なんの役に立つんだ？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532309
    m_Localized: "Neighbour: わかってる\nキツいだろうが やるしかないんだ\nでなきゃ 今は生き残れない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532310
    m_Localized: "Neighbour: なにか持って来てくれたり\n情報をくれたり するかもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532311
    m_Localized: "Neighbour: それと 来訪者かどうか\n徴候の検査を忘れちゃダメだ\n日中は 暑さで体力が長く持たない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532312
    m_Localized: "Neighbour: だから 誰を検査するかは 慎重にな\n検査は神経が張り詰めて\n体力を消耗する\nちゃんと調べなきゃ ならないからな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532313
    m_Localized: "Neighbour: ただ 会話に関しては問題ない\n体力いらずだ\nだから 好きなだけ話すといい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532314
    m_Localized: "Neighbour: あと 窓の向こうも要注意だ\nテレビも悪くないが\n周囲の状況を知るには\n自分の目しかない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532315
    m_Localized: それで どうすれば？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532316
    m_Localized: なにを すればいい？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532317
    m_Localized: "Neighbour: なにか持って来てくれたり\n情報をくれたり するかもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532318
    m_Localized: "Neighbour: それと 来訪者かどうか\n徴候の検査を忘れちゃダメだ\n日中は 暑さで体力が長く持たない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532319
    m_Localized: "Neighbour: だから 誰を検査するかは 慎重にな\n検査は神経が張り詰めて\n体力を消耗する\nちゃんと調べなきゃ ならないからな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532320
    m_Localized: "Neighbour: ただ 会話に関しては問題ない\n体力いらずだ\nだから 好きなだけ話すといい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532321
    m_Localized: "Neighbour: あと 窓の向こうも要注意だ\nテレビも悪くないが\n周囲の状況を知るには\n自分の目しかない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532322
    m_Localized: それで どうすれば？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532323
    m_Localized: なにを すればいい？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532324
    m_Localized: "Neighbour: 残念だが 生き延びる努力しか\nできやしない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532325
    m_Localized: "Neighbour: あとは この悪夢が早く終わるのを\n願うばかりだな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532326
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532327
    m_Localized: "Neighbour: 政府が どうにかしてくれるはずだ\nみんなを避難所に誘導するとか\nそういう形で"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532328
    m_Localized: "Neighbour: そうなったら\nウチの家族と一緒にいてくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532329
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532330
    m_Localized: "Neighbour: おっと\n忘れるところだった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532331
    m_Localized: "Neighbour: 明日の夜には家に戻る\n連絡が付くように\n電話番号を控えておいてくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532332
    m_Localized: "Neighbour: こないだ 電話回線を\n引いたばかりなんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532333
    m_Localized: 'Neighbour: XXX-XXX-XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532334
    m_Localized: 'Neighbour: 電話で連絡 取り合おう'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532335
    m_Localized: "Neighbour: よし\nこれで残らず伝えたぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532336
    m_Localized: "Neighbour: そうだ ビールを一箱 持って来た\n義理の兄が醸造所で働いてるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532337
    m_Localized: 'Neighbour: 飲んで 寝ちまえ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532338
    m_Localized: "Neighbour: かなり眠たくなるからな\n誰とも喋りたくないなら\nビール飲んで ゆっくり休め"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532339
    m_Localized: "Daughter: おっ…お母さんに\nあっ 会いたい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532340
    m_Localized: なにが起きたの？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532341
    m_Localized: 検査させてもらえる？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532342
    m_Localized: 'Daughter: わかんないよおおお'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532343
    m_Localized: "Daughter: あの人たち入ってきて しゃべってた\nお父さん やめろって言って\nそれで あの人たち…\nあの人たち…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532344
    m_Localized: 'Daughter: お父さあああん！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532345
    m_Localized: 'Daughter: お父さあああああん！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532346
    m_Localized: ねえ…ちょっと休もうか
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532347
    m_Localized: 話すのは明日にしようか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532348
    m_Localized: "Daughter: （少女は ひっきりなしに父の名を呼び\n泣き叫ぶ声に終わりはない）"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532349
    m_Localized: "Daughter: （少女には こちらの声も届かず\n一人 悲しみに暮れている）"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532350
    m_Localized: "Daughter: おっ…お母さんに\nあっ 会いたい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532351
    m_Localized: "大丈夫？\nここ気に入った？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532352
    m_Localized: 検査させてもらえる？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532353
    m_Localized: "Daughter: うん\nまあまあかな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532354
    m_Localized: 'Daughter: おうちが いいけど…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532355
    m_Localized: "Daughter: いつになったら\nおうちに帰れる？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532356
    m_Localized: "後でね…\n今 修理中だから"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532357
    m_Localized: "もう無理だよ\n燃えちゃったからね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532358
    m_Localized: "Daughter: そっか\nじゃあ もうすぐ迎えに来てくれるの？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532359
    m_Localized: "Daughter: それで 新しい おうち\n連れてってくれる？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532360
    m_Localized: 'Daughter: それとも 同じ おうち？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532361
    m_Localized: "Daughter: わたしの新しい部屋\n作ってくれるかな？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532362
    m_Localized: "Daughter: なら\nお父さんが迎えに来てくれるよね？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532363
    m_Localized: "なにが起きたか\nわかってるよね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532364
    m_Localized: "しばらく\nここにいたほうがいい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532365
    m_Localized: 'Daughter: でも お父さんは大丈夫なんだよね？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532366
    m_Localized: "Daughter: わたしの部屋は？\n燃えちゃった？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532367
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532368
    m_Localized: 'Daughter: お母さんは迎えに来てくれないの？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532369
    m_Localized: 'Daughter: みんな まだいる？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532370
    m_Localized: "なにが起きたか\nわかってるよね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532371
    m_Localized: "しばらく\nここにいたほうがいい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532372
    m_Localized: 'Daughter: わかんない'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532373
    m_Localized: 'Daughter: よく わかんない'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532374
    m_Localized: "Daughter: お父さん ぶたれたけど\n立ち上がってた\n見たの"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532375
    m_Localized: "Daughter: だから…\n火だって 消せたかもしれないし"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532376
    m_Localized: 'Daughter: わたしを 探しに出かけたのかも'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532377
    m_Localized: 'Daughter: お父さん もうすぐ来るよね？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532378
    m_Localized: 'Daughter: お父さんなしじゃ どこへも行けない'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532379
    m_Localized: 'Daughter: お父さん 迎えに来てくれるよね？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532380
    m_Localized: "Daughter: 見えたの\n立ち上がって 出てってた"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532381
    m_Localized: 'Daughter: 逃げながらだったけど 見えたの'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532382
    m_Localized: "Daughter: おっ…お母さんに\nあっ 会いたい"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532383
    m_Localized: 起きたことを受け入れないと
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532384
    m_Localized: 検査させてもらえる？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532385
    m_Localized: 'Daughter: なに言ってるの？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532386
    m_Localized: "Daughter: 部屋にテレビあるよね\nアニメ 見ていい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532387
    m_Localized: "なに見たのか わからないけど\nお父さんは もういないと思う"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532388
    m_Localized: "お父さんは迎えに来ないかも\nなにが起きたか わからない"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532389
    m_Localized: 'Daughter: なにも見てない くせに！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532390
    m_Localized: "Daughter: あたしは いたの！\n逃げるとき お父さん動いてたの"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532391
    m_Localized: 'Daughter: だから きっと来るの！'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532392
    m_Localized: "お父さん どうして\nまだ来ないのかな？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532393
    m_Localized: "最後に見たとき\nお父さん どんなだった？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532394
    m_Localized: "Daughter: 来ないの？\nなんで そんなこと言うの？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532395
    m_Localized: "お父さん どうして\nまだ来ないの？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532396
    m_Localized: "最後に見たとき\nお父さん どんなだった？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532397
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532398
    m_Localized: 'Daughter: 多分 先に やることがある？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532399
    m_Localized: "Daughter: お父さん 悪い人たち\nやっつけに行ったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532400
    m_Localized: "Daughter: お父さん…\nもうすぐ 来るはず"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532401
    m_Localized: "お父さんのこと すごく悲しい\nいい人だったけど 優しすぎた"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532402
    m_Localized: "ああ そうだね お父さん\nもうすぐ来るかもね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532403
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532404
    m_Localized: 'Daughter: お父さん いい人だった'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532405
    m_Localized: "Daughter: あの人たちに ぶたれてた…\nそれから…"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532406
    m_Localized: 'Daughter: 覚えてない'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532407
    m_Localized: "お父さんのこと すごく悲しい\nいい人だったけど 優しすぎた"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532408
    m_Localized: "ああ そうだね お父さん\nもうすぐ来るかもね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532409
    m_Localized: "Daughter: （少女に じっと見つめられ\nその場を動けず\nなにか起こるのを待つ）"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532410
    m_Localized: "Daughter: （やがて 少女が声を上げ\n泣き始めるが\nできることは なさそうだ）"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532411
    m_Localized: "Daughter: （嘘を信じて生きるほうが辛いだろう\nできるだけ早く\n現実を受け入れないと）"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532412
    m_Localized: 'Daughter: あたしも そう思ってた'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532413
    m_Localized: "Daughter: （少女は呆然として\nなにか考え込んでいるようだ）"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532414
    m_Localized: "Daughter: （だが子供時代を台無しにする\n価値があるか？\n少女は耐えられるのか？）"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532415
    m_Localized: "Daughter: （少女はもう充分\n問題を抱えていて\n今は悩ませるべきじゃない）"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532416
    m_Localized: 'NotTrue: ああ 年老いちまったねえ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532417
    m_Localized: どこから来たんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532418
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532419
    m_Localized: "NotTrue: ああ そうだとも\nなにか いけないかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532420
    m_Localized: "NotTrue: 人間ってのは\nアタシの物語を聞いときながら\n後で憎むもんさね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532421
    m_Localized: 'NotTrue: 想像できるかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532422
    m_Localized: "NotTrue: 家ならあるよ\n粗末な小屋さね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532423
    m_Localized: "NotTrue: いいとこなんだが\n話し相手なしじゃ干からびちまうよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532424
    m_Localized: "NotTrue: それに あばら屋になんて\n誰が来るってんだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532425
    m_Localized: "NotTrue: だから 歩き回ってるのさ\n失うものなんて なにもないからねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532426
    m_Localized: 'NotTrue: ああ 年老いちまったねえ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532427
    m_Localized: "どうして 親類の方が\nいないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532428
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532429
    m_Localized: "NotTrue: どこにでもあるようなのさ\n暮らす先々で拾ってくるんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532430
    m_Localized: 'NotTrue: それから語ってやるのさ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532431
    m_Localized: "NotTrue: もう婆だからね\n物語も よく覚えてられないんだ\n後から自分なりに語るのさ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532432
    m_Localized: 'NotTrue: だから爪弾き者なんだろうよ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532433
    m_Localized: "NotTrue: こんな言葉も あるだろう\n「来たる悲嘆は 重からず\n次を待つこそ 耐え難し」"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532434
    m_Localized: "NotTrue: だがね 話こしらえんのは\nアタシだけじゃないだろう？\nヒヒヒ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532435
    m_Localized: "NotTrue: 誰も彼も アタシのもとへ来るんだ\n遅かれ早かれね"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532436
    m_Localized: 'NotTrue: 誰しも物語が必要だからね'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532437
    m_Localized: 'NotTrue: ああ 年老いちまったねえ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532438
    m_Localized: "なぜ旦那さんと一緒じゃ\nないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532439
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532440
    m_Localized: 'NotTrue: どんなのが お好みだい？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532441
    m_Localized: 'NotTrue: 人間てのは おっかない生き物さね'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532442
    m_Localized: "NotTrue: 人を避けて\n自分に閉じこもった男がいたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532443
    m_Localized: "NotTrue: 高層階に閉じこもって\n部屋から ほとんど出なかった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532444
    m_Localized: 'NotTrue: 来訪者も死ぬのも恐れていた'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532445
    m_Localized: "NotTrue: 誰も訪ねちゃ来なかった\n来たとて 男は扉を開けなかったろう"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532446
    m_Localized: 'NotTrue: その日まではね…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532447
    m_Localized: 'NotTrue: 爆発音がしたんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532448
    m_Localized: "NotTrue: なにが起きたのか\n最初は わからなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532449
    m_Localized: "NotTrue: 窓の向こうを見ると\n男が飛び降りていた"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532450
    m_Localized: 'NotTrue: 耐えられなかったんだろうね'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532451
    m_Localized: 'NotTrue: この物語 気に入ったかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532452
    m_Localized: いえ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532453
    m_Localized: それで終わりですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532454
    m_Localized: "NotTrue: これだから\n誰にも好かれないんだろうねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532455
    m_Localized: "NotTrue: まあ いいさね\nいつの日か アンタの物語も\nアタシなりに語ってやるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532456
    m_Localized: "NotTrue: ああ\n男は潰れちまった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532457
    m_Localized: "NotTrue: 太陽が爆ぜて苦しんで死ぬのが\n怖かったのか それとも別のなにかか"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532458
    m_Localized: "NotTrue: アタシの見立てじゃ\n孤独に耐えられなかったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532459
    m_Localized: "NotTrue: だがね\nどうしようもないだろう？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532460
    m_Localized: 'NotTrue: ああ 年老いちまったねえ…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532461
    m_Localized: "ベンチに座ってるのは\nどんな感じでした？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532462
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532463
    m_Localized: "NotTrue: いいとも\nいくよ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532464
    m_Localized: "NotTrue: アタシが村に住んでた時分\n一人の男がいた"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532465
    m_Localized: "NotTrue: 森を歩くのが好きな奴だった\n理由は 知らないけれど"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532466
    m_Localized: "NotTrue: それでまた 森を歩くうち\n気付けば道に迷ってた\n戻る道さえ見つからなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532467
    m_Localized: "NotTrue: 男は立ち止まって考えた\nまっすぐ歩けば\nいずれ どこかへ着くはずだと"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532468
    m_Localized: "NotTrue: 歩いて歩いて けれど\nどこにも出られやしなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532469
    m_Localized: "NotTrue: それで やっと気付いたのさ\n男は ぐるぐる回ってたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532470
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532471
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532472
    m_Localized: それで どうなったんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532473
    m_Localized: 笑える話ですね
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532474
    m_Localized: "NotTrue: 死んだ姿で見つかったよ\n出られなかったのさ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532475
    m_Localized: "NotTrue: 足跡を追ってみて\n堂々巡りしてたのが判明したんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532476
    m_Localized: "NotTrue: 聞いたことあるだろ\n人間の足は 片方の歩幅が長いと"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532477
    m_Localized: 'NotTrue: そのせいさね'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532478
    m_Localized: "NotTrue: どうしたんだい？\n物語が お気に召さなかったかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532479
    m_Localized: "NotTrue: まあ ちょっとばかし盛ったけどね\n言わずもがな"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532480
    m_Localized: "NotTrue: けれど 本当にあった出来事だよ\nそして 今も起きてるのさ"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532481
    m_Localized: "NotTrue: 誰しも歩いて迷って\nでも どうやって抜け出すんだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532482
    m_Localized: "Alkonost: 力を蓄えないと\n誰か分けてくれれば いいのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532483
    m_Localized: 妹さんは どうですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532484
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532485
    m_Localized: "Alkonost: 私が助けないと いけません\nあれもこれも"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532486
    m_Localized: "Alkonost: 昨日は どうにか\nお風呂へ入れてあげられました\n家じゃ 浴槽に入るのも\n無理だったのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532487
    m_Localized: "Alkonost: 今のところ 変わりありません\nでも 気にかけてくれて\nありがとうございます"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532488
    m_Localized: "Alkonost: 鬱を抱える人って本当に…\n複雑で"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532489
    m_Localized: "Alkonost: いつ逃げ出さないと\nいけない日が来るか知れないのに\nあの子 力が出ないでしょうから"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532490
    m_Localized: "Alkonost: それに 食事さえ\n元気がなくて無理かもしれません"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532491
    m_Localized: "Alkonost: 私も疲れました\n少し休みます"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532492
    m_Localized: "Alkonost: 力を蓄えないと\n誰か分けてくれれば いいのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532493
    m_Localized: "これから どうする\nつもりですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532494
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532495
    m_Localized: 'Alkonost: いい質問ですね'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532496
    m_Localized: "Alkonost: もうすぐ 夫が迎えに来るはずなんです\n安全な場所を見つけてくれると\nいいんですが"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532497
    m_Localized: "Alkonost: どこか 来訪者の襲撃も\n太陽の熱も やり過ごせる場所を"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532498
    m_Localized: "Alkonost: あの人 言ってました\nそういう所があると\nそれに太陽は爆発なんてしないとも"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532499
    m_Localized: "Alkonost: もし爆発したら\n10分と経たず みんな消し飛ぶ って"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532500
    m_Localized: 'Alkonost: 私も その通りだと思います'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532501
    m_Localized: "Alkonost: 力を蓄えないと\n誰か分けてくれれば いいのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532502
    m_Localized: "旦那さんから\nなにか連絡ありました？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532503
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532504
    m_Localized: "Alkonost: どういうわけか\nなんの連絡もないんです\n電話もありませんし 迎えにも来ません"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532505
    m_Localized: "Alkonost: なにか あったんでしょうか？\n問題に巻き込まれたとか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532506
    m_Localized: "Alkonost: これだけは ハッキリ言えます\nあの人が見捨てるはず ありません\nあり得ません"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532507
    m_Localized: "Alkonost: 妹に手を焼いてたときだって\n手伝ってくれましたから"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532508
    m_Localized: "Alkonost: あの人なら…\nきっと来てくれてます"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532509
    m_Localized: "Alkonost: 妹も少し良くなってるみたいで…\nだから… あの人が来れば\nきっと全部 うまくいきます"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532510
    m_Localized: "Alkonost: 力を蓄えないと\n誰か分けてくれれば いいのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532511
    m_Localized: 憂鬱そうですよ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532512
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532513
    m_Localized: 'Alkonost: えっ？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532514
    m_Localized: 'Alkonost: ああ かもしれません'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532515
    m_Localized: 'Alkonost: 考え事が 山ほど あるんです'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532516
    m_Localized: "Alkonost: 太陽が爆発しないなら\nどうして暑さは静まらないんです？\nどうして みんな\n世界の終わり ばかり考えてるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532517
    m_Localized: 'Alkonost: ニュースも見ました'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532518
    m_Localized: "Alkonost: 明言を避けてましたが\n昼間の気温が上昇の一途を\n辿っているみたいでした"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532519
    m_Localized: "Alkonost: 気候変動が起きてるんです\nつまり 耐えられない動物から\n死んでいくんです\n新しい… 天候で"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532520
    m_Localized: 'Alkonost: 私たちは どうなるんでしょうか？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532521
    m_Localized: "Alkonost: 力を蓄えないと\n誰か分けてくれれば いいのに"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532522
    m_Localized: あの 体調いかがですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532523
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532524
    m_Localized: "Alkonost: 昨晩 外に出ました\n夫を探したくて"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532525
    m_Localized: "Alkonost: いそうな場所を\nいくつか見て回ったんです"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532526
    m_Localized: "Alkonost: その一つで 見つけたんです\n薬を飲んでました"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532527
    m_Localized: "Alkonost: 私たち… 買って用意してたんです\nもしものときのために"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532528
    m_Localized: "Alkonost: あの人 飲んだんです\n怖かったんでしょう\n私を残していったんです"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532529
    m_Localized: "Alkonost: あの人 飲みました あの薬を\nそれに 太陽のことは 一言も残さず"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532530
    m_Localized: 'Sirin: これで おしまい'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532531
    m_Localized: あの 体調いかがですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532532
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532533
    m_Localized: 'Sirin: 感じるんです…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532534
    m_Localized: "Sirin: 加重ブランケットみたいで\nすごく重たいんです"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532535
    m_Localized: 'Sirin: 体が押しつぶされるみたいで'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532536
    m_Localized: 'Sirin: もう…嫌です'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532537
    m_Localized: 'Sirin: これで おしまい'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532538
    m_Localized: 今日は少し元気そうですね
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532539
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532540
    m_Localized: 'Sirin: ええ'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532541
    m_Localized: "Sirin: 太陽のこと 知ってました？\n爆発するんですよね？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532542
    m_Localized: 'Sirin: 今夜 初めて知ったんです'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532543
    m_Localized: 'Sirin: なら これで終わりなんですか？'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532544
    m_Localized: "Sirin: 私たちが存在していた痕跡さえ\n一つも残らないんですよね？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532545
    m_Localized: 'Sirin: なんて考えるの 面白いですよね'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532546
    m_Localized: 'Sirin: これで おしまい'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532547
    m_Localized: お姉さんは大丈夫ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532548
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532549
    m_Localized: 'Sirin: 姉さん 全て失うのを恐れてるんです'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532550
    m_Localized: 'Sirin: 私は なにか失うとは思いません'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532551
    m_Localized: "Sirin: この膨張し続ける宇宙では\n私たちは塵の欠片に過ぎません"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532552
    m_Localized: "Sirin: 誰にも必要とされないのは\nそもそも誰もいない からです"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532553
    m_Localized: "Sirin: この星が消滅しても 誰も悲しみません\n悲しむ必要すら ありません"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532554
    m_Localized: 'Sirin: でも 姉さんは それが怖いんです'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532555
    m_Localized: 'Sirin: これで おしまい'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532556
    m_Localized: "お姉さん\n具合が悪いんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532557
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532558
    m_Localized: "Sirin: ええ\n悪いことばかり考えないように\n旦那さんを探しに行こうとしてます"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532559
    m_Localized: "Sirin: 悪い考えだと思いますが\n姉さん じっとしていられないんです"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532560
    m_Localized: "Sirin: 姉さんが 旦那さん探しに\n出ていきたいなら\n私も行くしかありません"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532561
    m_Localized: "Sirin: みんな全滅する前に\n姉さんを失いたく ありませんから"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532562
    m_Localized: 'Sirin: これで おしまい'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532563
    m_Localized: それで 出かけたんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532564
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532565
    m_Localized: "Sirin: ええ\n姉さん 見つけたんです\n旦那さんの遺体を"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532566
    m_Localized: "Sirin: きっと全部うまくいく\nそう言っていたのに 自殺したんです\n本当の終わりが怖かったんでしょう"
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532567
    m_Localized: "Sirin: 姉さんには\n力が残っていない気がします"
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726592
    m_Localized: "Sirin: これからは 私が面倒を見るつもりです\nみんな全滅するまで"
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726593
    m_Localized: "Sirin: そのときが来れば やっと もう\nなにも悩まずに すむんです\n恐れることも 恥じることも ありません"
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166080
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166081
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166082
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166083
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166084
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166085
    m_Localized: 'Alkonost: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166086
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166087
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166088
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166089
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166090
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166091
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360384
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360385
    m_Localized: 'Sirin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360386
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360387
    m_Localized: そっとしておく
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083328
    m_Localized: 'Firefighter: クソッ…ゴホッ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083329
    m_Localized: "Firefighter: やあ…\nできればでいいんだ…\nみんなに電話してくれない？\n{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083331
    m_Localized: "Firefighter: 迎えを頼みたいわけじゃないんだ…\n別れの言葉だって…\nただ伝えてほしい…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083332
    m_Localized: "Firefighter: 父さんは逃げたわけじゃないと\nただ…必要とされる場所にいたんだと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083333
    m_Localized: "Firefighter: ゴホッゴホッ\nそれだけでいいんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083334
    m_Localized: 'Theorist: どうぞ 始めてくれ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083335
    m_Localized: その書類は？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083336
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083337
    m_Localized: "Theorist: このファイルに なにが記されているか\n信じられないだろうね\nなかなか…面白いものもあるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083338
    m_Localized: "Theorist: ほら たとえばここだ\n実に興味深い説が書いてある"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083339
    m_Localized: "Theorist: 来訪者など実在しないそうだ\nなにもかも全部 政府の陰謀だとか\n人口過剰に対処するためのね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083340
    m_Localized: "Theorist: ずいぶん説得力がある…\nそして 妙に筋が通っているだろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083341
    m_Localized: "Theorist: 人口過剰は依然として問題だからね\n好むと好まざるとに かかわらず"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083342
    m_Localized: "Theorist: ひょっとすると\nこれこそ「対処」なのかもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083343
    m_Localized: 'Theorist: どうぞ 始めてくれ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083344
    m_Localized: まだ書類漁りを？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083345
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083346
    m_Localized: 'Theorist: ご明察'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083347
    m_Localized: "Theorist: 山ほどあるんだ\n興味あるかい"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083348
    m_Localized: "Theorist: ほら\nここを見てくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083349
    m_Localized: "Theorist: こいつだ\nFEMAこそが来訪者なんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083350
    m_Localized: "Theorist: 連中は防護服で全身を覆ってるだろう\n検査しようが ないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083351
    m_Localized: "Theorist: 特にFEMAの本当の意味が面白い\nFacility for Eradicating\nMankind Altogether なんだとか\n（人類完全抹消施設）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083352
    m_Localized: 'Theorist: いや 違ったかな…？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083353
    m_Localized: 'Theorist: どうぞ 始めてくれ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083354
    m_Localized: "今度は なにを\n暴いたんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083355
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083356
    m_Localized: "Theorist: 来訪者の正体は…\nスキンウォーカーなんだ\n獣の皮をかぶって憑依する魔術師さ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083357
    m_Localized: "Theorist: まるでSF小説の中から\n飛び出してきたみだいだろう？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083358
    m_Localized: 'Theorist: だが ひっかかる点もあってね'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083359
    m_Localized: "Theorist: あるレポートに書かれていたんだ\n蒼白の男が街を闊歩していると"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083360
    m_Localized: "Theorist: しかし明らかに…\n著者は一点ミスを犯している"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083361
    m_Localized: "Theorist: 主張によれば 二つあったそうだ\n蒼白の不気味な人影が"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083362
    m_Localized: "Theorist: 一つは窓の外に\n一つはドアの前に"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083363
    m_Localized: "Theorist: そんなはず ないだろう\nどう考えても同一人物じゃないか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083364
    m_Localized: "Theorist: 窓ガラスで像が歪んでいただけだろう\nそれで顔が違って見えたんだ\n知覚の錯誤だね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083365
    m_Localized: 'Theorist: まあ 興味深い話ではある'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083366
    m_Localized: 'Theorist: どうぞ 始めてくれ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083367
    m_Localized: なにが真実なのでしょうか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083368
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083369
    m_Localized: "Theorist: では 真実とは なんだい？\n真実とは不定形の概念なんだ\n視点によって姿形を変えるようにね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083370
    m_Localized: 'Theorist: 誰かの真実は 別の誰かの妄想だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083371
    m_Localized: 'Theorist: 誰かの善は 別の誰かの悪だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083372
    m_Localized: "Theorist: 人間は果てしなく言い争ってきた\nでも今や どうだい？\n道徳の規準すら定かじゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083373
    m_Localized: "Theorist: 強く信じれば\n自分の信念を強く持ちさえすれば\nそれが自分にとっての真実なんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083374
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083375
    m_Localized: 'Theorist: ふむ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083376
    m_Localized: "Theorist: 面白い記事だ\nおっと なんの話だったかな？\nああ そうだそうだ 真実だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083377
    m_Localized: "Theorist: 覚えておきたまえ\n真実は一つだけ\n来訪者は脳の寄生虫だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083378
    m_Localized: "Theorist: 耳栓をしておくことだ\n常日頃から\nそれだけで救われるとも！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083379
    m_Localized: "Theorist: さて 読み物に戻らせてもらおうか\n邪魔は よしてくれよ\n集中しなくてはならないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083380
    m_Localized: 'Wifefema: 今度は なに？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083381
    m_Localized: 税関に勤めていたんですよね？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083382
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083383
    m_Localized: "Wifefema: ええ\n働いてたけど"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083384
    m_Localized: "Wifefema: ねえ\n来訪者の徴候を確かめたこと ある？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083385
    m_Localized: "Wifefema: まったく\nなにもかもバカバカしい"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083386
    m_Localized: "Wifefema: あのイカれ野郎どもを来訪者だなんて\n呼びはじめたのは どこのどいつ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083387
    m_Localized: "Wifefema: もっと おあつらえ向きの名前が\nあるだろうに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083388
    m_Localized: 'Wifefema: 今度は なに？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083389
    m_Localized: "何故そうも\n来訪者を嫌うんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083390
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083391
    m_Localized: 'Wifefema: なんなの そのバカげた質問？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083392
    m_Localized: "Wifefema: 連中のせいで全部 地獄送りなんだよ！\nニュースも見てないの？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083393
    m_Localized: "Wifefema: 太陽は爆発してるし\n街じゃ人が死に続けてる\nなにもかも連中のせい"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083394
    m_Localized: "Wifefema: できるものなら\n神に誓って 残らず始末してやる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083395
    m_Localized: "Wifefema: 時間さえ もらえればね\n国境で働いてた頃みたいに暴いてやる\n見てなさいよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083396
    m_Localized: 'Wifefema: FEMAが雇ってくれさえすれば…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083397
    m_Localized: 'Wifefema: 今度は なに？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083398
    m_Localized: "何故そんなにFEMAで\n勤めたいんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083399
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083400
    m_Localized: "Wifefema: 本気だからだよ\nそれだけ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083401
    m_Localized: "Wifefema: 来訪者は止められるはず\nそうすべきなの"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083402
    m_Localized: "Wifefema: アタシ 隣人だって通報したんだから\n正しいことをしたの"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083403
    m_Localized: "Wifefema: なのにFEMAはどうしたと思う？\nダンナのほうを雇ったんだ！\nアタシじゃなく！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083404
    m_Localized: "Wifefema: 誤解しないでね\n夫が採用されたのは誇らしいの\nでもさ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083405
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083406
    m_Localized: "Wifefema: 正直さ？\n顔を平手打ちされた気分"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083407
    m_Localized: 'Wifefema: 今度は なに？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083408
    m_Localized: "どうして隣人を\n通報したんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083409
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083410
    m_Localized: "Wifefema: 言ったとおり\nアイツが来訪者だったから"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083411
    m_Localized: 'Wifefema: それに気味が悪かったしね'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083412
    m_Localized: "Wifefema: 本音を言えば\n通報して清々したよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083413
    m_Localized: "Wifefema: 古き良き税関勤め時代を\n思い出したね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083414
    m_Localized: "Wifefema: それで思ったんだ\nFEMAに入らないと！って"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083415
    m_Localized: 'Wifefema: 今度は なに？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083416
    m_Localized: "旦那さんのためではなく\nFEMAのために来たんですね？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083417
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083418
    m_Localized: "Wifefema: そうだけど？\nだから なに？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083419
    m_Localized: "Wifefema: ええ 上層部の連中が耳を傾けるまで\n死ぬほど騒いでやろうと思ってね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083420
    m_Localized: 'Wifefema: 不採用だなんて 納得いかないもの'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083421
    m_Localized: "Wifefema: どうかしてる！\nアタシは来訪者を捕まえ\nクソ市民の義務を果たした\nなのに採用されたのはダンナのほう？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083422
    m_Localized: "Wifefema: ムシャクシャする\nこんなの意味が わからない\nバカバカしい"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083423
    m_Localized: "Wifefema: ダンナのことなら憎んでるよ\n心の底から憎んでる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083424
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083425
    m_Localized: 'Wifefema: ねえ ちょっと頼みたいんだけど'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083426
    m_Localized: "Wifefema: FEMAに電話してもらえない？\n内部回線を使ってさ\n特別な番号があるんだ\n{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083427
    m_Localized: "Wifefema: 本気の人を見つけたと伝えて\n経験と根性のある女だと\nそれも新人まで連れてきた って"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083428
    m_Localized: "Wifefema: うまく言っておくんだよ\n一言入れておけば\nやっと なにかさせてくれるかも"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083429
    m_Localized: 'Wifefema: 今度は なに？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083430
    m_Localized: "税関のほうが良かったのでは？\nせめて権限があったのでしょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083431
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083432
    m_Localized: 'Wifefema: ねえ 何様のつもり'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083433
    m_Localized: "Wifefema: アンタの意見なんて訊いてないんだよ\nアタシより偉いとでも？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083434
    m_Localized: "Wifefema: 主導権を握りたいだけだろ？\nオレがショーを演じてるんだ って\nここはアンタの場所で\n誰も誰もがアンタのもとに来るから"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083435
    m_Localized: "Wifefema: ここじゃアンタが全てを決める\n誰が来訪者で 誰がそうじゃないか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083436
    m_Localized: "Wifefema: でも それはアンタの仕事じゃない\n本来はFEMAの管轄なんだよ\nバッジなしの裁判官気取り"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083437
    m_Localized: "Wifefema: ねえ 教えてもらえる？\nアンタの どこがFEMAよりマシ？\n少なくとも 向こうは権限を持ってる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083438
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083439
    m_Localized: 'Wifefema: そうだろ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083440
    m_Localized: 'Raskolnikov: 覚えたいんだ…殺しを'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083441
    m_Localized: "来訪者を殺すところを\nまだ見たいんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083442
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083443
    m_Localized: "Raskolnikov: 本当のことを言うと…\n気が変わったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083444
    m_Localized: "Raskolnikov: ああ 怖くなったんだ\nそうだとも…すまない\nまだ覚悟が足りないと気付いたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083445
    m_Localized: "Raskolnikov: 死体を見ると まだ吐き気がする\n慣れるには時間がかかる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083446
    m_Localized: "Raskolnikov: その…来訪者のことなんだけど…\n死んでも動くそうなんだ\nあの男…路地裏の男みたいに…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083447
    m_Localized: "Raskolnikov: クソッ\n今は考えたくない\n無理だ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083448
    m_Localized: 'Raskolnikov: 覚えたいんだ…殺しを'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083449
    m_Localized: "路地裏で なにがあったか\n教えてもらえますか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083450
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083451
    m_Localized: "Raskolnikov: 話すのは…辛いんだ\nでも やってみるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083452
    m_Localized: 'Raskolnikov: 路地に入れば安全だと思ったんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083453
    m_Localized: "Raskolnikov: でも 角を曲がった瞬間\n墓地に足を踏み入れた みたいだった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083454
    m_Localized: 'Raskolnikov: 何十もの死体が横たわってた'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083455
    m_Localized: "Raskolnikov: まだ動いているのもいた\nまだ死にきっていない みたいだった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083456
    m_Localized: "Raskolnikov: それから路地の奥には\n銃を持った男がいて\nそれから…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083457
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083458
    m_Localized: "Raskolnikov: ダメだ…もう無理だ\nもう思い出したくないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083459
    m_Localized: 'Raskolnikov: 覚えたいんだ…殺しを'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083460
    m_Localized: "路地の奥にいた男は\n誰だったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083461
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083462
    m_Localized: 'Raskolnikov: あいつは…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083463
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083464
    m_Localized: "Raskolnikov: マントを着た男で\n紐に指や歯を通して飾ってたんだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083465
    m_Localized: "Raskolnikov: 隣には若い青年がいた\n無力そうなのが"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083466
    m_Localized: "Raskolnikov: マントの男は青年に叫んでいた\n銃を突きつけて"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083467
    m_Localized: "Raskolnikov: 歯を見せろ と\n青年は慈悲を懇願していた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083468
    m_Localized: "Raskolnikov: 僕はゴミ箱の陰に隠れて…\nそれから…どうしてだか\n青年に自分を重ねてしまった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083469
    m_Localized: "Raskolnikov: 青年は すすり泣き 震えながら\n命乞いをしていた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083470
    m_Localized: "Raskolnikov: そして…銃声が響いた\n体が崩れ落ち\n他の死体のように転がった\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083471
    m_Localized: "Raskolnikov: その瞬間 気付いたんだ…\n今やもう 二種類の人間しかいない と\n捕食者と獲物だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083472
    m_Localized: 'Raskolnikov: 覚えたいんだ…殺しを'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083473
    m_Localized: "血に飢えた殺人鬼に\nならなくても生き延びられる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083474
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083475
    m_Localized: "Raskolnikov: そんなはずがない！\nそんなの嘘だ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083476
    m_Localized: "Raskolnikov: 君が生きてるのは牙を剥いたからだ\n君が捕食者だからだ！\nだから誰も 君に手出しできないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083477
    m_Localized: 'Raskolnikov: 恐るべき存在になれば 安全でいられる'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083478
    m_Localized: "Raskolnikov: 僕は獲物になんて なりたくない\n臆病者みたく泣き叫んで死ぬなんて\nカンベンだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277632
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277633
    m_Localized: 'Raskolnikov: だから 殺しを覚えないと'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277634
    m_Localized: 'Nun: 天にまします 我らの父よ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277635
    m_Localized: それで この家はどうです？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277636
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277637
    m_Localized: "Nun: ああっ\n忌々しい場所ね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277638
    m_Localized: "Nun: 歪んだ壁に\n間取りは完全に意味不明"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277639
    m_Localized: "Nun: それに言わせてもらえば\nわざと一番みすぼらしい部屋を\n私に あてがったでしょう？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277640
    m_Localized: "Nun: 家具は古びて崩壊寸前\n虫食いだらけで たわんでて\nきっと今や蛾の巣と化してる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277641
    m_Localized: "Nun: きちんとした部屋に\n十字架を吊るすことさえ\nできないだなんて"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277642
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277643
    m_Localized: 'Nun: ああっ 忘れてちょうだい'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277644
    m_Localized: 'Nun: 天にまします 我らの父よ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277645
    m_Localized: "そこまで ここが嫌なら\n出ていっては？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277646
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277647
    m_Localized: "Nun: 望んで この荒んだ地にいるとでも？\n修道院が無事だったなら\n聖なる壁を離れるものですか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277648
    m_Localized: "Nun: こんな腐敗と瓦礫の山を\n私が好き好むとでも？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277649
    m_Localized: "Nun: 選べる余地があったのなら\nこんなところ来るはずもない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277650
    m_Localized: "Nun: ここは殺人と死の臭いが酷い\n神よ お助けを\n貴方は これが好きなのでしょうね！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277651
    m_Localized: 'Nun: 悪魔と見なした者を残らず殺して'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277652
    m_Localized: "Nun: 貴方こそ悪魔なのよ！\n今にも角が生え出てきそうね！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277653
    m_Localized: "Nun: でも 恐れるものですか\n天にまします父が見守ってくださる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277654
    m_Localized: 'Nun: 天にまします 我らの父よ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277655
    m_Localized: "どうして ご自身の修道院に\n留まらなかったんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277656
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277657
    m_Localized: "Nun: まず言わせてちょうだい\n修道院は私のものではありません\n全能なる神の家よ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277658
    m_Localized: 'Nun: そして 不浄なる冒涜者どものせい'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277659
    m_Localized: "Nun: 主の聖地を汚した連中\n天の火に焼き尽くされるがいい！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277660
    m_Localized: "Nun: 押し入ってきて みんな追い出した\n私を含めて"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277661
    m_Localized: "Nun: まるで自分の場所みたく入ってきて\n野蛮人！野蛮人の群れめ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277662
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277663
    m_Localized: "Nun: 正しく慎ましく 暮らしていたの\n祈り 断食し 主の御業に尽くしていた\nでも あの獣どもは？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277664
    m_Localized: "Nun: 安酒みたく聖水を飲み干してるはず\n喉に詰まらせればいい"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277665
    m_Localized: 'Nun: 地獄で朽ち果てるがいい！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277666
    m_Localized: 'Nun: 天にまします 我らの父よ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277667
    m_Localized: "「冒涜者」は なにが\n望みだったんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277668
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277669
    m_Localized: "Nun: 奴ら 群れになってやってきた\n汚らわしく騒々しく\n悪魔のように叫んで\n神を信じぬ蛮族らしく罵倒して！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277670
    m_Localized: "Nun: どうしてか って？\n私が入れなかったからよ！\n洗礼を受けていない者は\n聖域を またいではならない と！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277671
    m_Localized: "Nun: 奴ら怒り狂って ああ…\n扉を叩き回り 壊そうとした"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277672
    m_Localized: 'Nun: そして押し入り 私を追い出した'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277673
    m_Localized: "では助けを求める相手を\n追い払ったんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277674
    m_Localized: "私でも貴方を追い出した\nかもしれません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277675
    m_Localized: "Nun: 聖地は不信心者の避難所では\nありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277676
    m_Localized: "Nun: よしんば\n太陽からの日陰を求めていようとも\n来訪者なる連中から逃れたくとも"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277677
    m_Localized: "Nun: 空から火が降ったとしても\n神の家に化け物が入り込む余地はない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277678
    m_Localized: 'Nun: 神は信ずる者のみを憐れむ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277679
    m_Localized: "Nun: そして不信心者が通りで\n焼け死んだとて かくあるべし\nそれが裁きなのだから"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277680
    m_Localized: "貴方は卑劣です ただ\n裁くのは私ではありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277681
    m_Localized: "今すぐ出ていけ\n撃たれる前にな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277682
    m_Localized: 'Nun: この無礼者！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277683
    m_Localized: 'Nun: 正気を失ったのかしら！？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277684
    m_Localized: "Nun: 渡井は神に仕える者よ！\n神をも信じぬ無法者に主の家を\n追い出された身…それを貴方…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277685
    m_Localized: "Nun: 私を嘲笑うの？\n自業自得だと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277686
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277687
    m_Localized: "Nun: 人間じゃない\nこの蛇！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277688
    m_Localized: "Nun: 冒涜者め！\n貴方も他の冒涜者ども と同じよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277689
    m_Localized: "Nun: 貴方なら理解できると期待したのに\nでも 他の連中と変わらない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277690
    m_Localized: "Nun: 私たちは ただの僕！\n主の僕なの！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277691
    m_Localized: "Nun: 私たちに許されているのは\n主の御心を受け入れることだけ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277692
    m_Localized: "Nun: 主の御業は我らより いと高きもの\n偉大なる計画を把握することなど\nできようはずもない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277693
    m_Localized: "貴方は卑劣です ただ\n裁くのは私ではありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277694
    m_Localized: "今すぐ出ていけ\n撃たれる前にな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277695
    m_Localized: "Nun: なんてことを\n英雄気取りかしら？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277696
    m_Localized: "Nun: こんな不道徳で家とも呼べない場所\nいるものですか\n一秒たりとて いたくありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277697
    m_Localized: "Nun: さようなら\n神の怒りが貴方に下りますように！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277698
    m_Localized: "Nun: 長居する つもりなど なかったもの\n言っておきますけど"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277699
    m_Localized: "Nun: 入った瞬間 骨の髄から感じていた\nこの家には神がいないと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277700
    m_Localized: "Nun: もしかすると 今も主は私に\n語りかけているのかもしれない\n去れ と"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277701
    m_Localized: "Nun: さようなら\n神の怒りが貴方に下りますように！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277702
    m_Localized: 'Fugitive: クソッ…傷が…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277703
    m_Localized: "そういえば どうして\nFEMAに追われてたんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277704
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277705
    m_Localized: "Fugitive: さぁな\nただ 心当たりはある"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277706
    m_Localized: "Fugitive: ただの巡回に引っかかったのかと\n思ってたんだが"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277707
    m_Localized: "Fugitive: でも 間違いねぇ\n隣のクソ女がチクったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277708
    m_Localized: "Fugitive: 前からソリが合わなくてよ\nハメる機会を見つけたんだろうよ\nオレを「来訪者」呼ばわりしやがって"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277709
    m_Localized: "Fugitive: 心底 得意になってるだろうよ\nあのクソアマ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277710
    m_Localized: 'Fugitive: クソッ…傷が…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277711
    m_Localized: 傷の具合はどうです？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277712
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277713
    m_Localized: "Fugitive: 大丈夫だ マジで\n回復してきてる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277714
    m_Localized: "Fugitive: 言ったろ\n弾は貫通してんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277715
    m_Localized: "Fugitive: 人間同士で争ってる場合かよ\nなのにアイツ 撃ちやがって"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277716
    m_Localized: "Fugitive: この調子じゃ じきに全員 埋められる\n地上でオネンネできねぇ ってんなら\n地下で永眠するしかねぇだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277717
    m_Localized: "Fugitive: だがよ…そうじゃねぇんだ\n地獄みてぇな生活を送って\n他人まで巻き添えにすんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277718
    m_Localized: "Fugitive: あの銃持ちのイカれ野郎を見ろよ\n気色悪ぃクソがよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277719
    m_Localized: "イカれ野郎？\nFEMAに撃たれたのでは？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277720
    m_Localized: イカれ野郎とは？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277721
    m_Localized: "Fugitive: あっ ああ…\nいや FEMAのヤツで その…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277722
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277723
    m_Localized: 正直に言ってくれ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277724
    m_Localized: 下手な嘘はよせ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277725
    m_Localized: "Fugitive: その…\nFEMAのヤツなんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277726
    m_Localized: "Fugitive: マジで威圧感のあるヤツで…\nその…面と向かうと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277727
    m_Localized: "Fugitive: それで…その…\n撃たれたんだ…背中を"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277728
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277729
    m_Localized: 正直に言ってくれ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277730
    m_Localized: 下手な嘘はよせ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277731
    m_Localized: 'Fugitive: わかった わかったよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277732
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277733
    m_Localized: "Fugitive: 実を言うと…\n隔離区域を抜け出したのは本当だ…\nああ…でも 撃たれちゃいねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277734
    m_Localized: "Fugitive: 医者が手助けしてくれてよ\n書類を偽造してもらったんだ\nそれで外へ出た"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277735
    m_Localized: "Fugitive: 家には戻れなかった\nまだ あの女がいるからな\nオレをチクった隣人が"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277736
    m_Localized: "Fugitive: それで 身を隠せる場所を探してたんだ\nで あの男に出くわしちまった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277737
    m_Localized: "Fugitive: ちょっと訊こうとしただけだったんだ\n一晩 横になれるとこをな\nそしたら…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277738
    m_Localized: "Fugitive: 目に入ったんだ\n背中のショットガンに\n歯と爪のネックレス\n向こうの路地は死体の山"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277739
    m_Localized: "Fugitive: 一目で悟ったよ\nコイツはヤバい狂人だって"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277740
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277741
    m_Localized: "Fugitive: なぁ 痛みが戻ってきた\nちょっと横になって いいか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277742
    m_Localized: 'Fugitive: クソッ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277743
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277744
    m_Localized: "Fugitive: 聞いてくれ\nなにもかも打ち明ける"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277745
    m_Localized: "Fugitive: 実を言うと…\n隔離区域を抜け出したのは本当だ…\nああ…でも 撃たれちゃいねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277746
    m_Localized: "Fugitive: 医者が手助けしてくれてよ\n書類を偽造してもらったんだ\nそれで外へ出た"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277747
    m_Localized: "Fugitive: 家には戻れなかった\nまだ あの女がいるからな\nオレをチクった隣人が"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277748
    m_Localized: "Fugitive: それで 身を隠せる場所を探してたんだ\nで あの男に出くわしちまった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277749
    m_Localized: "Fugitive: ちょっと訊こうとしただけだ\n一晩 横になれるとこをな\nそしたら…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277750
    m_Localized: "Fugitive: 目に入ったんだ\n背中のアサルトライフルに\n歯と爪のネックレス\n向こうの路地は死体の山"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277751
    m_Localized: "Fugitive: 一目で悟ったよ\nコイツはヤバい異常者だって"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277752
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277753
    m_Localized: "Fugitive: なぁ 痛みが戻ってきた\nちょっと横になって いいか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277754
    m_Localized: 'Fugitive: クソッ…傷が…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277755
    m_Localized: "アサルトライフルの異常者と\n何があったんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277756
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277757
    m_Localized: "Fugitive: ああ あのイカれ野郎な\n歯と爪まみれの"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277758
    m_Localized: "Fugitive: オレのツラが こわばったのを見て\n銃を向けてきた\nそいつを掴んで 揉み合いになった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277759
    m_Localized: 'Fugitive: 二人で武器を奪い合ったんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277760
    m_Localized: "Fugitive: アイツが発砲して\n次に オレが 頭を殴って打ちのめした"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277761
    m_Localized: "Fugitive: そのまま逃げた\nできるだけ遠くへ\nそれから 腹に痛みを感じた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277762
    m_Localized: 'Fugitive: 下を見たら 血まみれだった'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277763
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277764
    m_Localized: "Fugitive: アイツに撃たれたのを隠してたのは\n言えばアンタ 入れてくれなかったろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277765
    m_Localized: "Fugitive: こんな時代だ\n誰だって自分のことで手一杯だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277766
    m_Localized: "Fugitive: 正直に言ってくれよ…\n武装したサイコ野郎に追われてると\n知ったらアンタ オレを泊めたか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277767
    m_Localized: "Fugitive: 避難所が必要だったんだ\nあの路地で死んだ哀れな連中の一員に\nなりたくなかったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277768
    m_Localized: "Fugitive: だから…嘘を ついたんだ\n許してくれねぇか\n恨まないでくれよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277769
    m_Localized: "わかりました\n泊まって いいですよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277770
    m_Localized: "もう信じられない\n出ていけ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277771
    m_Localized: "Fugitive: すまねぇ\n理解してくれて感謝する"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277772
    m_Localized: "Fugitive: イカれ野郎が現れねぇと いいんだが\nアンタも武装してて良かったよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277773
    m_Localized: "Fugitive: アイツ もう誰かに始末されてるかも\nしれねぇけどよ\nほら あの蒼白で痩せた来訪者あたりに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277774
    m_Localized: "Fugitive: ああ…\nオレの読み通りだったな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277775
    m_Localized: "Fugitive: だろ？\n嘘は正しかったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277776
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277777
    m_Localized: 'Fugitive: じゃあな クソ野郎！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277778
    m_Localized: "Bestson: あぁ…\n二人とも どこ行っちゃったの…？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277779
    m_Localized: 調子は どうですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277780
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277781
    m_Localized: "Bestson: わかんない…\nただ…父さんと母さんに\n帰ってきてほしい"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277782
    m_Localized: "Bestson: ずっと生活の面倒すべて見てくれてた\nなのに今じゃ…\nなにが起きたのかも わかんないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277783
    m_Localized: "Bestson: 無事で いてくれたら いいんだけど\n父さんと母さん抜きの生活なんて\n想像できないよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277784
    m_Localized: "Bestson: あぁ…\n二人とも どこ行っちゃったの…？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277785
    m_Localized: "他に親戚は\nいないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277786
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277787
    m_Localized: "Bestson: ほとんど いない\nでも…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277788
    m_Localized: "Bestson: 最近 知ったんだけど\n姉さんが いるんだって…\n父さんの最初の奥さんとの間に\nでも…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277789
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277790
    m_Localized: 'Bestson: あっ お祖母ちゃん！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277791
    m_Localized: "Bestson: ああっ そうだ\n今 気付いたけど 父さんと母さんは\nお祖母ちゃんのとこに 行ったのかも…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277792
    m_Localized: "Bestson: お祖母ちゃんが来訪者になって\n父さんと母さんを殺した とか？\nFEMAに連れて行かれちゃった とか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277793
    m_Localized: "Bestson: なんで？なんで置いてったの？\nなんで連れてって くれなかったの？\nなんで…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277794
    m_Localized: "Bestson: 一人じゃ生きていけっこ ないのに！\nなんで置いてっちゃったの！？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277795
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277796
    m_Localized: "Bestson: あぁ…\n二人とも どこ行っちゃったの…？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277797
    m_Localized: "落ち着きましたか？\nお姉さんのことは？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277798
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277799
    m_Localized: 'Bestson: えっと その…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277800
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277801
    m_Localized: "Bestson: お父さんとお母さんが出ていく少し前\n手紙が届いたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277802
    m_Localized: "Bestson: 父さんに渡されたんだ\nいつもボクが郵便を見ないから って"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277803
    m_Localized: 'Bestson: 「姉さん」からだった'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277804
    m_Localized: "Bestson: ボクに会いたい って書いてあった\nでも…どう受け止めていいか\nわからなくて"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277805
    m_Localized: "Bestson: 正直 最初はイタズラか なにかかと\nでも 父さんが渡してきたんだから\nそんなはずない って"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277806
    m_Localized: "Bestson: 父さん言ってたんだ\nボクが最初の子供じゃない って\n姉さんがいる って ずっと…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277807
    m_Localized: "Bestson: 母さんは違うけど\n父さんは同じ姉さんが"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277808
    m_Localized: "Bestson: それを聞いて…変な感じがしたんだ\nどう向き合えばいいのか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277809
    m_Localized: "Bestson: だって 多分ボクの「姉さん」とはいえ\n赤の他人なんだよ…\nすごく変な感じ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277810
    m_Localized: "Bestson: 話してみたいけど…\nでも 怖すぎて"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277811
    m_Localized: "Bestson: 代わりに電話してもらえない？\n…ほら 番号\n{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277812
    m_Localized: "Bestson: ただ…ボクがいると伝えて\nどうしたらいいか わからなく\nなってる って"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277813
    m_Localized: "Bestson: あぁ…\n二人とも どこ行っちゃったの…？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277814
    m_Localized: "何故お姉さんのところに\n行きたくないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277815
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277816
    m_Localized: 'Bestson: ほとんど知らない人だから'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277817
    m_Localized: "Bestson: 父さんと母さんに打ち明けられたとき\nずっと嘘つかれた気がしたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277818
    m_Localized: "Bestson: すごく怒って 自分の部屋に こもった\n放っといて って怒鳴って"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277819
    m_Localized: 'Bestson: それから 次の日…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277820
    m_Localized: "Bestson: 前に言った あの出来事が起きたんだ\nテレビ パニック それから…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277821
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277822
    m_Localized: "Bestson: 父さんと母さん\n本当にボクを放って 出て行っちゃった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277823
    m_Localized: "Bestson: 神様 どうか お願いします\n父さんと母さんに会わせてください\nなんでも するし一度だけで いいから"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277824
    m_Localized: 'Bestson: 神様 どうして…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277825
    m_Localized: "お姉さんのところへ行っては？\n拒まれたりは しないでしょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277826
    m_Localized: 本当に ご両親が死んだと？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277827
    m_Localized: "Bestson: 本気？\n本当に そう思う？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277828
    m_Localized: 'Bestson: でも…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277829
    m_Localized: "Bestson: あんな遠く行ったこと なくて\n父さんと母さん抜きで"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277830
    m_Localized: "Bestson: 姉さんが 住んでるとこ\nすごく遠いんだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277831
    m_Localized: "Bestson: 怖い\n無理かもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277832
    m_Localized: "タクシーを使っては？\nまだ動いていますよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277833
    m_Localized: なにか しないと
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277834
    m_Localized: 'Bestson: うん…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277835
    m_Localized: "Bestson: 父さんと母さんが迎えに来ないと\nボク…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277836
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277837
    m_Localized: 'Bestson: わかんない…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277838
    m_Localized: お祖母さんを探してみては？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277839
    m_Localized: 隔離区域を探してみては？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277840
    m_Localized: "Bestson: ああ それって…\n結構 悪くない考えかも\nそういうの…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277841
    m_Localized: "Bestson: でも今 タクシーって\nすごい高い って聞いたことある"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277842
    m_Localized: "Bestson: でも 家のヘソクリ持って来たんだ\nこれだけあれば 姉さんのところまで\n乗っけて もらえるはず"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277843
    m_Localized: "Bestson: ありがとう\nオジサンの言葉で 目が覚めたよ\nじゃあね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277844
    m_Localized: 'Bestson: オジサンの言うとおりかも'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277845
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277846
    m_Localized: "Bestson: ボク 父さんと母さんに\nずっと頼り過ぎてたのかも"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277847
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277848
    m_Localized: "Bestson: ありがとう\nオジサンの言葉で 目が覚めたよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277849
    m_Localized: "Bestson: タクシー試してみるよ\n運良く 家のヘソクリ持ってきてるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277850
    m_Localized: "Bestson: ボクに できるといいな\nじゃあね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277851
    m_Localized: "Bestson: もしかしたら…\nオジサンの言うとおりかも"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277852
    m_Localized: "Bestson: もしかしたら\n父さんと母さんの車 故障したとか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277853
    m_Localized: "Bestson: うん 父さん言ってた\nまた修理しなきゃ って"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277854
    m_Localized: "Bestson: でも お婆ちゃんは 電話なんて\n持つ必要ない って拒否してて\nそれで ボクに連絡できないのかも？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277855
    m_Localized: "Bestson: もしかしたら…\nもしかしたら そこに行けば\n本当に会えるのかも"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277856
    m_Localized: "Bestson: ありがとう\nオジサンの言葉で 目が覚めたよ\n行かなきゃ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277857
    m_Localized: 'Bestson: うん…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277858
    m_Localized: 'Bestson: もしかしたら 本当に そこにいるかも'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277859
    m_Localized: 'Bestson: やってみるしか ないよね'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277860
    m_Localized: "Bestson: ありがとう\nオジサンの言葉で 目が覚めたよ\n行かなきゃ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277861
    m_Localized: 'Buddy: なんでも訊いてくれよ 相棒'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277862
    m_Localized: 調子は どうですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277863
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277864
    m_Localized: 'Buddy: 絶好調だぜ 相棒！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277865
    m_Localized: "Buddy: 冷蔵庫のぞいたんだけどよ\nあんなにビールだらけ なんてな…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277866
    m_Localized: "Buddy: どこから手に入れたんだ？\n親戚がビール工場でも やってんのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277867
    m_Localized: "Buddy: まあ いいって ことよ！\n秘密で 構わねえぜ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277868
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277869
    m_Localized: "Buddy: クソッ この騒動さえなけりゃな 相棒\n俺ら のんびり 冷えたビール飲んで\nフットボール観戦でもして\nお前に紹介してえ奴だって…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277870
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277871
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277872
    m_Localized: 大丈夫ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277873
    m_Localized: 固まってます？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277874
    m_Localized: "Buddy: えっ？\nなんだって？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277875
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277876
    m_Localized: "Buddy: 大したことじゃねえ\n忘れてくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277877
    m_Localized: 'Buddy: いや ただ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277878
    m_Localized: 'Buddy: ふむ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277879
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277880
    m_Localized: "Buddy: ちょっと考え事をな\nそれだけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277881
    m_Localized: 'Buddy: なんでも訊いてくれよ 相棒'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277882
    m_Localized: 今日は沈んでますね
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277883
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277884
    m_Localized: 'Buddy: 俺…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277885
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277886
    m_Localized: 'Buddy: 話したかねえ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277887
    m_Localized: どんな話です？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277888
    m_Localized: なんの ことです？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277889
    m_Localized: "Buddy: 関係ねえだろ\nお前にゃ わかんねえよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277890
    m_Localized: 知っておかないと
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277891
    m_Localized: "わかりました\n無理強いしません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277892
    m_Localized: 'Buddy: なあ マジで言いたかねえんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277893
    m_Localized: 知っておかないと
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277894
    m_Localized: "わかりました\n無理強いしません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471936
    m_Localized: "Buddy: 強要は よしてくれ！\nただでさえ ギリギリなんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471937
    m_Localized: 'Buddy: ただ…放っといてくれ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471938
    m_Localized: "Buddy: ありがとよ\nちょっと参っちまっててな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471939
    m_Localized: 'Buddy: なんでも訊いてくれよ 相棒'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471940
    m_Localized: なにが あったんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471941
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471942
    m_Localized: "Buddy: お前にゃ関係ねえだろ 相棒！\n引っ込んでてくれ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471943
    m_Localized: "なにが あったのか\n訊きたい だけです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471944
    m_Localized: "話してもらいますよ\n黙ってると余計 辛くなります"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471945
    m_Localized: "Buddy: 言えねえよ…\nお前の見る目 変わっちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471946
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471947
    m_Localized: "Buddy: でもよ…\nもう限界だな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471948
    m_Localized: "Buddy: 俺 犬を飼ってて\n数日前に死んじまったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471949
    m_Localized: それが どうかしました？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471950
    m_Localized: それで？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471951
    m_Localized: 'Buddy: なんだ 俺を始末する気か 相棒？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471952
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471953
    m_Localized: "Buddy: わかったよ\n真実を知りたいんだな？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471954
    m_Localized: "Buddy: 俺 犬を飼ってて\n数日前に死んじまったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471955
    m_Localized: それが どうかしました？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471956
    m_Localized: それで？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471957
    m_Localized: "Buddy: そのことなんだよ\nアイツ もう歳で 病気でよ…\nでも…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471958
    m_Localized: 'Buddy: それで死んだんじゃなくて…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471959
    m_Localized: 'Buddy: 俺が…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471960
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471961
    m_Localized: 'Buddy: 俺が殺したんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471962
    m_Localized: 何を したんだ！？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471963
    m_Localized: このクソ野郎！
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471964
    m_Localized: 'Buddy: 俺が…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471965
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471966
    m_Localized: 'Buddy: 俺が殺したんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471967
    m_Localized: なに したんだ！？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471968
    m_Localized: このクソ野郎！
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471969
    m_Localized: "Buddy: そう聞こえるだろうけどよ\n言わせてくれ 相棒\nアイツ…苦しんでたんだ\nもう見てられなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471970
    m_Localized: "Buddy: 明けても暮れても 目に苦痛を浮かべて\n夜には 泣き声が響くんだ\n脚の痛みに呻く声が"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471971
    m_Localized: "Buddy: あのクソ車！\nあのタクシー運転手がアホみてえに\n暴走しなきゃ まだ生きてたろうに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471972
    m_Localized: "Buddy: クソッ 首 締めて やりてえぐらいだ\nでも 逃げやがって\nナンバーも見えなかった…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471973
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471974
    m_Localized: "Buddy: お前 知らねえだろ\nペットを失うってのが どんなだか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471975
    m_Localized: "Buddy: よく言うだろ 俺ら には人生の一章\nでもアイツらに とっちゃ全部なんだ\nそれに なんでだかな\n人間より多くを教えてくれる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471976
    m_Localized: "わかりました\n泊まって いいですよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471977
    m_Localized: 出てってくれ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471978
    m_Localized: "Buddy: ああ わかってるんだ…\n俺がクソ野郎だって\nまだ手前を許せねえよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471979
    m_Localized: "Buddy: アイツ…苦しんでたんだ\nもう 見てられなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471980
    m_Localized: "Buddy: 毎日 悪化していった\n夜が一番キツかった…\nアイツ 呻いて泣いて…涙まで流して"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471981
    m_Localized: "Buddy: 犬が泣くの 見たことあるか？\n目で訴えかけるんだ\n終わらせてくれ って"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471982
    m_Localized: "Buddy: 俺だって やりたか なかったんだ！\n誓って そんなマネ したかなかった！\n俺の手は あんなこと…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471983
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471984
    m_Localized: 'Buddy: クソ タクシー！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471985
    m_Localized: "Buddy: 愛犬を轢きやがったクズ野郎！\n何事も なかったみてえに\n走り去りやがって！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471986
    m_Localized: "Buddy: まるで路傍の石みてえによ！\n生き物じゃねえ みてえに！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471987
    m_Localized: "Buddy: クソッ 首 締めて やりてえぐらいだ\nでも 逃げやがって\nナンバーも見えなかった…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471988
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471989
    m_Localized: "Buddy: お前 知らねえだろ\nペットを失うってのが どんなだか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471990
    m_Localized: "Buddy: よく言うだろ 俺ら には人生の一章\nでもアイツらに とっちゃ全部なんだ\nそれに なんでだかな\n人間より多くを教えてくれる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471991
    m_Localized: "わかりました\n泊まって いいですよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471992
    m_Localized: 出てってくれ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471993
    m_Localized: 'Buddy: ありがとよ 相棒'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471994
    m_Localized: 'Buddy: わかってくれて 嬉しいよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471995
    m_Localized: "Buddy: そうだな 相棒\nそれが一番いいのかもな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471996
    m_Localized: "Buddy: 毎日クソ考えちまうんだ…\n俺は正しいことを したのか って\nアイツの痛み 終わらせるためとはいえ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471997
    m_Localized: 'Buddy: 答えなんて 出ねえんだろうけどな…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471998
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472176
    m_Localized: 'Blind: 真っ暗だ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472177
    m_Localized: それで なにを見たんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666240
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666241
    m_Localized: 'Blind: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666242
    m_Localized: "Blind: 知りたくないだろう\n私を信じてくれ\n知らずにいるのが慈悲というものだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666243
    m_Localized: 'Blind: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666244
    m_Localized: "Blind: 見えなくなれば\n姿を思い出さずにすむかと…\nアレを"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666245
    m_Localized: 'Blind: だが 私の内に刻み込まれているんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666246
    m_Localized: "Blind: まだ夢に見るよ\nいつも そこにいる\nよく 訪れてくる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666247
    m_Localized: 'Blind: 真っ暗だ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666248
    m_Localized: "それで？\n目を失って良くなりました？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666249
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666250
    m_Localized: 'Blind: なんとも言えないな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666251
    m_Localized: "Blind: まあ 二度と見ずにすむ\nたとえ なにかに殺されても\nそれが なんであれ 知る由もない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666252
    m_Localized: 'Blind: とはいえ…奇妙だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666253
    m_Localized: "Blind: 君の家が どんなだか わからない\n移動が大変だ\n薬なしじゃ 節々が痛む…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666254
    m_Localized: "Blind: まあ 慣れていくはずだ\n少なくとも あの恐怖を\nもう目にする ことはない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666255
    m_Localized: "Blind: ただ…見たものは覚えている…\n私の中に刻み込まれている\nこの世の果てまで 背負っていくんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666256
    m_Localized: 'Blind: 真っ暗だ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666257
    m_Localized: ヒドい見た目ですよ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666258
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666259
    m_Localized: "Blind: クシが ないからかな？\nはぁ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666260
    m_Localized: 'Blind: 昨晩 夢を見たんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666261
    m_Localized: "Blind: 線路を歩いて 家に向かっていた\nあたりには家々 木々もあった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666262
    m_Localized: "Blind: 電車が来る音がして\n横に避けた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666263
    m_Localized: "Blind: 振り向いたら…\nなにかが人を引きずり込むのが見えた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666264
    m_Localized: "Blind: 動きが速すぎて はっきり見えなかった\nでも 知っている\nアレが なんだか 私は知っているんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666265
    m_Localized: "Blind: 電車を追いかけたが 近づけなかった\n決して たどりつけなかった\n終点に隠された真実にも"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666266
    m_Localized: 'Blind: そして 目が覚めた'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666267
    m_Localized: 'Blind: 真っ暗だ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666268
    m_Localized: 大丈夫ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666269
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666270
    m_Localized: "Blind: また夢を見たんだ\nまた やって来たんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666271
    m_Localized: "Blind: 道を歩いていた 夜に\n街灯が点滅していた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666272
    m_Localized: "Blind: 振り向いたら\nアレが走ってくるのが見えた\nゆっくりと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666273
    m_Localized: "Blind: 今度は 動きが見えた\nはっきりと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666274
    m_Localized: "Blind: 逃げようとした\nけれど どんどん迫られる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666275
    m_Localized: "Blind: 家に たどりついた\nけれど 門が開かない\nフェンスを登った"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666276
    m_Localized: "Blind: ポケットを探った\n鍵が指から滑り落ちた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666277
    m_Localized: "Blind: それで 家の裏へ走った\nまたフェンス また登った"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666278
    m_Localized: "Blind: 立ち止まった\n音がしない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666279
    m_Localized: 'Blind: 見上げた'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666280
    m_Localized: "Blind: アレが そこにいた\nフェンス越しに手を伸ばしてきた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666281
    m_Localized: 'Blind: 多分 鎮痛剤のせいだろう'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666282
    m_Localized: 'Blind: 真っ暗だ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666283
    m_Localized: 昨夜も夢を？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666284
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666285
    m_Localized: 'Blind: ああ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666286
    m_Localized: 'Blind: 話したくない'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666287
    m_Localized: 'Blind: もう わかったんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666288
    m_Localized: 'Blind: 私たちは死ぬ定めなんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666289
    m_Localized: "Blind: アレに引き裂かれるんだ\n寝ても覚めても"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666290
    m_Localized: 'Blind: 太陽に焼き尽くされるんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666291
    m_Localized: "Blind: なにもかも意味なんてない\n終わりだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666292
    m_Localized: "Blind: 私を…そっとしておいてくれ\n頼む"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666293
    m_Localized: 'Dude: よう 兄弟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666294
    m_Localized: 大厄災の前は なにを？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666295
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666296
    m_Localized: "Dude: ああ ダラけてたぜ\n映画 見たり ダチとツルんだり"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666297
    m_Localized: "Dude: でも今じゃ？\n映画もなけりゃ ツルむ先もねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666298
    m_Localized: "Dude: テレビは延々 同じパニックと広告\n兄弟 誰も電話に出もしねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666299
    m_Localized: "Dude: どっかの お偉いさん 言ってたっけな\n「今は楽しむ場合じゃない\n災害の真っ只中だ…」だとよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666300
    m_Localized: "Dude: はっ ざけんな っての\nいつ楽しむか オレが決めんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666301
    m_Localized: 'Dude: よう 兄弟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666302
    m_Localized: "生きる手立ては\nなんだったんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666303
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666304
    m_Localized: "Dude: 労働のことか？\nプハハッ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666305
    m_Localized: "Dude: 兄弟 労働してんのは カスだけだ\nオレは生きてたんだよ なあ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666306
    m_Localized: "Dude: 映画で見たとき あんぜ\n主役？まさにオレだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666307
    m_Localized: "Dude: なあ 工場で働く連中 幸せそうか？\nなわけ ねぇよな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666308
    m_Localized: "Dude: オレはパーティー開いて\n新しい連中と会って…\nそれがマジで 生きる ってこった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666309
    m_Localized: "Dude: オーケイ オーケイ…\n昔 倉庫のマネージャーやってたんだ\n運送会社で 親のコネって ヤツな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666310
    m_Localized: "ならば 親に頼って\n生きてるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666311
    m_Localized: じゃあ ただの怠け者？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666312
    m_Localized: "Dude: なんで 必死こくんだよ 兄弟？\nオレは うまくやってんだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666313
    m_Localized: "Dude: 持ってるモン 使わねぇ手はねぇだろ？\nでなきゃ ただのアホだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666314
    m_Localized: "Dude: ほら オメェも銃 持ってんだろ\n壁に飾るだけか？使うだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666315
    m_Localized: "Dude: ってことだよ\nオレはアホじゃねぇ\n役得は活用しねぇとな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666316
    m_Localized: 'Dude: おいおい 落ち着きな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666317
    m_Localized: 'Dude: 嫉妬してんなら そう言えよ 兄弟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666318
    m_Localized: "Dude: わかってる って\n誰もがガチャに勝てるワケじゃねぇ\nそれが人生ってもんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666319
    m_Localized: 'Dude: よう 兄弟'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666320
    m_Localized: 何か変じゃありませんか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666321
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666322
    m_Localized: "Dude: 兄弟…オメェの映画 どこだ？\nテープの一本も 持ってねぇのか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666323
    m_Localized: 'Dude: なんも 見たりしねぇのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666324
    m_Localized: 'Dude: ここ 退屈で死んじまう'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666325
    m_Localized: "今は映画どころじゃ\nないでしょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666326
    m_Localized: なにも持ってません
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666327
    m_Localized: "Dude: おいおい\nここなら はしゃげっかと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666328
    m_Localized: "Dude: ここの連中？\nイケてねぇヤツばっか\nしかも見るモンも ねぇし"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666329
    m_Localized: "Dude: 雑誌もなし 映画もなし…\n本だけ って…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666330
    m_Localized: "Dude: どこのどいつが 本なんて読むんだよ？\n石器時代じゃ ねぇんだから！\n延々と文字ばっか 眠くってしかたねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666331
    m_Localized: "ここは映画館じゃ\nないんです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666332
    m_Localized: "ここにパーティーしに？\nそれとも生き延びに？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666333
    m_Localized: 'Dude: はっ はぁっ！？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666334
    m_Localized: "Dude: 兄弟 カンベンしろよ\nマジで言ってんのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666335
    m_Localized: "Dude: 部屋にテレビが あるってんのに\n映画の一つもねぇ だと！？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666336
    m_Localized: "Dude: 兄弟 このパーティー カスだ\nオメェはクールなヤツだと ばかり"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666337
    m_Localized: "ここは映画館じゃ\nないんです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666338
    m_Localized: "ここにパーティーしに？\nそれとも生き延びに？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666339
    m_Localized: 'Dude: おい マジかよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666340
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666341
    m_Localized: 'Dude: オメェ 過去いちノリ悪ぃヤツだな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666342
    m_Localized: "生き延びたいなら\n落ち着いてください"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666343
    m_Localized: "ここが嫌なら\n出てっていいんですよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666344
    m_Localized: 'Dude: おい マジかよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666345
    m_Localized: "Dude: ウチはテレビ イカれてんだよ なあ\nオメェなら退屈死から救ってくれる\nそう当て込んでたのによ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666346
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666347
    m_Localized: 'Dude: オメェ 過去いちノリ悪ぃヤツだな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666348
    m_Localized: "生き延びたいなら\n落ち着いてください"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666349
    m_Localized: "ここが嫌なら\n出てっていいんですよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666350
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666351
    m_Localized: "Dude: わかった わかったよ 兄弟\nここはカスだが 外よかマシだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666352
    m_Localized: "Dude: ただよ…\nちょっとだけ テレビ見せてくんねぇか\nほんの少しで いいからよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666353
    m_Localized: "Dude: やっぱな！\nオメェ マジでノリ悪ぃわ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666354
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666355
    m_Localized: 'Dude: 出てくよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666356
    m_Localized: 'Teacher: 可哀想な子たち…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666357
    m_Localized: 大丈夫ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666358
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666359
    m_Localized: "Teacher: ええ 多分…\nわかりません…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666360
    m_Localized: "Teacher: 私…理解できてなくて\n成長して理性ある大人が感情のままに\nあの子たちに どうして あんな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666361
    m_Localized: "Teacher: そんなに怯えていたの？\n子供を殺すほどに？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666362
    m_Localized: "人はもっと酷いこともします\nこんな時代ですから"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666363
    m_Localized: "混沌の中では\n理性が最初に失われます"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666364
    m_Localized: "Teacher: 子供を殺すより 酷いことなんて\nあるんでしょうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666365
    m_Localized: "Teacher: 一人の仕業じゃないんです…\n大勢で 集団になって\n魔女狩り みたいに…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666366
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666367
    m_Localized: "Teacher: 苦難は我々の本性を暴くのでしょうか\n私たちこそ本当の怪物なのでしょうか\n土の下から来る者たち ではなく"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666368
    m_Localized: "Teacher: それにしても 人が子供を殺すなんて…\n言葉が見つかりません…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666369
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666370
    m_Localized: "Teacher: 苦難は我々の本性を暴くのでしょうか\n私たちこそ本当の怪物なのでしょうか\n土の下から来る者たち ではなく"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666371
    m_Localized: 'Teacher: 可哀想な子たち…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666372
    m_Localized: "どれぐらい\n教師をされてるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666373
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666374
    m_Localized: 'Teacher: 大厄災の三ヶ月ほど前からです'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666375
    m_Localized: "Teacher: ですが…\n模範的な教師では ありませんでした\n仕事は好きじゃありませんでしたし\n当時は子供が うるさく疲れるだけで"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666376
    m_Localized: "Teacher: 大厄災で変わったんです\n目が開かれました"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666377
    m_Localized: "Teacher: あの子たち ロックスターにだって\n政治家にだって 人の親にだって\nなれたかも しれないんです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666378
    m_Localized: "Teacher: でも もう あの子たち\nギターを弾くことも 学校に通うことも\n大人になることも ないんです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666379
    m_Localized: 'Teacher: 永遠に…夢見る子供たち のまま'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666380
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666381
    m_Localized: "Teacher: ある日 一人の子が駆け込んで来ました\n泣きながら 親に嫌われたと言って"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666382
    m_Localized: "Teacher: 両親は その子を来訪者だと…\nそれで 追い出したんです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666383
    m_Localized: "Teacher: その子は行く宛がなくて\n私の元へ来たんです…幼稚園に"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666384
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666385
    m_Localized: 'Teacher: （女は涙を堪えきれず 泣き叫ぶ）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666386
    m_Localized: 'Teacher: 私を許して…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666387
    m_Localized: 'Teacher: 可哀想な子たち…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666388
    m_Localized: "昨日は申し訳ありません\n動揺させるつもりでは"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666389
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666390
    m_Localized: "Teacher: いいんです\n私…もう大丈夫ですから\n落ち着きました"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666391
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666392
    m_Localized: "Teacher: あの少年…あの子のことが あってから\n子供の無防備を思い知りました\nとりわけ 物事が崩壊したときには"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666393
    m_Localized: "Teacher: 「捨て子」を 見捨てられた子供を\n残らず受け入れるようにしたんです\n可能な限り"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666394
    m_Localized: "Teacher: 話を聞くのは…耐え難かったです\nどれほど簡単に親に捨てられたかを"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666395
    m_Localized: "Teacher: まるで大厄災が子供を見放す口実に\n使われていた かのようでした"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666396
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666397
    m_Localized: "Teacher: もしかすると…あの親たち は子供が\n欲しくなかった のかもしれません\nはじめから"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666398
    m_Localized: 'Teacher: 可哀想な子たち…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666399
    m_Localized: ご自身には お子さんは？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666400
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666401
    m_Localized: "Teacher: いえ…\n母には口酸っぱく言われていました\n早く落ち着いて 子供を持ちなさい と"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666402
    m_Localized: "Teacher: でも まだ準備できて いませんでした\n私は自分の意志で決めたかったんです\nその時が来たら"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666403
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666404
    m_Localized: "Teacher: 捨てられた子供たちの話を聞くと…\n考えずには いられませんでした"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666405
    m_Localized: "Teacher: もし母の言葉に従っていたら\n私も あの親たちに成り果てていた\nかもしれません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666406
    m_Localized: "Teacher: だから私は決めたんです\n置き去りにされた子供を助けようと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666407
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666408
    m_Localized: "Teacher: なにが一番 辛かったと思います？\n放火犯の一人が その親だったことです\n私が匿った子の…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666409
    m_Localized: 'Teacher: （女はまた涙を堪えきれない）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666410
    m_Localized: 'Teacher: 私を許して…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666411
    m_Localized: "Teacher: きちんと…良き人生を与えたかった\n子供たちを大切にしていた\nこんな終わり方 あるべきじゃない…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666412
    m_Localized: 'Teacher: 本当に ごめんなさい…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666413
    m_Localized: "子供らの死は\nあなたのせいじゃありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666414
    m_Localized: ご愁傷様です
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666415
    m_Localized: "Teacher: そうかもしれません\nですが…ずっと 私は空っぽなんです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666416
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666417
    m_Localized: 'Teacher: 忘れられない考えがあるんです'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666418
    m_Localized: "Teacher: あの親たちが あの子たちに\nなんの感情も抱いていなかったら？\nまるで愛していなかったら？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666419
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666420
    m_Localized: "Teacher: ただ…あの子たちに少しでも\n私から愛情を伝えられていたなら"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666421
    m_Localized: "Teacher: ありがとうございます…\nですが 私は壊れた ままです\nこのことは 乗り越えられない でしょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666422
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666423
    m_Localized: 'Teacher: 忘れられない考えがあるんです'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666424
    m_Localized: "Teacher: あの親たちが あの子たちに\nなんの感情も抱いていなかったら？\nまるで愛していなかったら？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666425
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666426
    m_Localized: "Teacher: ただ…あの子たちに少しでも\n私から愛情を伝えられていたなら"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860544
    m_Localized: "Ballerina: 猫ちゃんがいるよ\n他になにが必要？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860545
    m_Localized: 何故ここに？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860546
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860547
    m_Localized: 'Ballerina: バカな質問だね'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860548
    m_Localized: "Ballerina: ドアを開けたのはキミでしょ\n自分に訊いてみなよ\nなんのためにアタシを？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860549
    m_Localized: "Ballerina: アタシにとっちゃ どこも同じ\n場所は場所"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860550
    m_Localized: "Ballerina: ここ行け って言われたから\nここ来ただけ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860551
    m_Localized: 'Ballerina: キミには なんにも求めてない'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860552
    m_Localized: "Ballerina: 大事なのは ここを心地よく保つこと\nアタシのためにね\n他の人？知ったことじゃないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860553
    m_Localized: "Ballerina: 猫ちゃんがいるよ\n他になにが必要？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860554
    m_Localized: 本当に人間ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860555
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860556
    m_Localized: 'Ballerina: キミは？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860557
    m_Localized: 'Ballerina: まだキミに なにか残ってる っての？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860558
    m_Localized: 'Ballerina: アタシのほうが なにが悪い っての？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860559
    m_Localized: "Ballerina: 猫ちゃんがいるよ\n他になにが必要？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860560
    m_Localized: 誰から ここへ行けと？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860561
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860562
    m_Localized: 'Ballerina: キミ もう やることやったじゃん'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860563
    m_Localized: 'Ballerina: 他に なにが いるっての？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860564
    m_Localized: 'Ballerina: 共通の…知り合いだよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860565
    m_Localized: 'Ballerina: でも 次どうするかは 言われてないんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860566
    m_Localized: "Ballerina: 猫ちゃんがいるよ\n他になにが必要？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860567
    m_Localized: "いつまでここに\nいるつもりです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860568
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860569
    m_Localized: 'Ballerina: 迎えが来るまで'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860570
    m_Localized: 'Ballerina: 他に どうしろ っての？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860571
    m_Localized: "Ballerina: 知らないよ\n前は なにか言われたから\nまた なにか言われるの 待ってるだけ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860572
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860573
    m_Localized: 'Ballerina: で キミは誰に なにか言われたの？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860574
    m_Localized: 'Ballerina: キミは誰を待ってるの？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860575
    m_Localized: "Ballerina: 猫ちゃんがいるよ\n他になにが必要？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860576
    m_Localized: "どうして私を\n殺さないんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860577
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860578
    m_Localized: "Ballerina: キミって ホント バカだね\n知ってた？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860579
    m_Localized: "Ballerina: 同じ事ばっか\n毎日"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860580
    m_Localized: "Ballerina: アタシ言ったでしょ\n何も言われてない って"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860581
    m_Localized: "Ballerina: アタシは待ってる\nキミは なんで 待ってるの？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860582
    m_Localized: 'Mother: ここ 息が詰まる…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860583
    m_Localized: "大丈夫ですか？\nお子さんは どうしました？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860584
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860585
    m_Localized: "Mother: うん…あの子…疲れてる アタシと同じ\n新しい人が苦手だから\nアタシに くっついてるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860586
    m_Localized: "Mother: 子供って こういうのに対処するのが\n大変なんだ\n不平不満の一つも言わなくたって\n顔を見れば わかるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860587
    m_Localized: "Mother: ときどき思うんだ\nこんな状況に巻き込んだのは 全部\nアタシの せいじゃないか って"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860588
    m_Localized: "Mother: でも 手遅れだよ\nもう なにも変えられない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860589
    m_Localized: "Couple: ベイビー\n浮かない顔して どうしたんだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860590
    m_Localized: どうして外に？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860591
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860592
    m_Localized: "Couple: おっと\n妻の お義母さんを訪問するところでね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860593
    m_Localized: "Couple: でも途中で気付いたんだ\n私たち二人だけじゃ無理だと\nそれで その 貴方の家を見つけてね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860594
    m_Localized: "Couple: 改めて感謝するよ\n私たちを泊めてくれて！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860595
    m_Localized: "Couple: ベイビー\n浮かない顔して どうしたんだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860596
    m_Localized: どれぐらいの距離なんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860597
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860598
    m_Localized: 'Couple: ハニーは ここらの道には詳しくなくて'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860599
    m_Localized: "Couple: 誰の助けも なければ\nまあ 二日は かかるかな？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860600
    m_Localized: "Couple: 道を見つける頃には\n何度か迷子になってる だろうさ\nハハッ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860601
    m_Localized: "Couple: でも 誰かが車で送ってくれれば？\n完璧だね\n二時間もあれば 到着だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860602
    m_Localized: "どうして今 お義母さんを\n訪ねたがるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860603
    m_Localized: タイミングが無茶苦茶です
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860604
    m_Localized: 'Couple: 何が起きたか わからなくてね'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860605
    m_Localized: "Couple: 義母に電話が繋がらないんだ\n何日も連絡が取れてない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860606
    m_Localized: "Couple: 無事を確認しないと\n助けが必要かも しれないしね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860607
    m_Localized: "Couple: それに 夜は短く なってきている\n外を歩くのは 少し怖い"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860608
    m_Localized: "Couple: でも大丈夫さ\nお義母さんには すぐ会えるよ\nハニー？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860609
    m_Localized: "Couple: 道なんて覚えてないし\n奥さんは いつも間違ったほうへ進むし"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860610
    m_Localized: "Couple: でも いいのさ\n大事なのは前に進むことだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860611
    m_Localized: "Couple: 一週間ぐらい かかるかもだけどね！\nハハハッ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860612
    m_Localized: "Couple: ベイビー\n浮かない顔して どうしたんだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860613
    m_Localized: 今夜発つのでは
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860614
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860615
    m_Localized: "Couple: いやさ うちの奥さん ちょっと抜けてて\n準備に三時間かかりっきりでさ\nもう出て行くには遅すぎてね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860616
    m_Localized: 'Couple: それで 後にする ことにしたんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860617
    m_Localized: "Couple: 次は もっと早くするよ\nすまないね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860618
    m_Localized: "Couple: 今後は のろまな奥さんが\n足を引っ張らないように しないとね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860619
    m_Localized: "Couple: あまり迷惑じゃなきゃ いいんだけど？\n本当に すまないね！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860620
    m_Localized: "Couple: ベイビー\n浮かない顔して どうしたんだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860621
    m_Localized: 奥さん 大丈夫ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860622
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860623
    m_Localized: "Couple: 大丈夫だとも\nなんで奥さんに訊くんだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860624
    m_Localized: 'Couple: 貴方と話すのは私の役目だろう'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860625
    m_Localized: "Couple: 奥さんは少し神経質なだけさ\nなにも心配しなくていいよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860626
    m_Localized: 奥さんに訊いてるんです
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860627
    m_Localized: それで どうなんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860628
    m_Localized: "Couple: 疲れてるんだよ\n無理強いしないで おくれ\n頼むから"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860629
    m_Localized: "Couple: 正直なところ\nお義母さんのことは もう\nどうでもよくなってるみたいでね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860630
    m_Localized: "Couple: でも いいんだ\nかわいいナメクジさんも\nそのうち動き出すだろうし\nお義母さんにも会えるさ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860631
    m_Localized: "Couple: まだ生きていれば だけどね\nアハハッ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860632
    m_Localized: "Couple: ほら ハニー\n準備すませてくれよ\nどれだけ待たせるんだ？クソッ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860633
    m_Localized: 'Couple: おっと 全体的には うまくいってるよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860634
    m_Localized: "Couple: ハニーときたら 自分の母親に\nまるで興味ない みたいでね\nハハッ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860635
    m_Localized: 'Couple: ちょっと後押ししたほうが いいかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860636
    m_Localized: "Couple: こんなの聞かせちゃって すまないね\nあんまり のろまで イライラしちゃって"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860637
    m_Localized: "Couple: 座って準備しろ\nもう待ってやれるかよ！\nクソが！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860638
    m_Localized: "Couple: ベイビー\n浮かない顔して どうしたんだい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860639
    m_Localized: "奥さん 出たがってません\nどういうこと ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860640
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860641
    m_Localized: "Couple: こいつ ムカつかせやがって\nわかるだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860642
    m_Localized: "Couple: いつも文句ばかり\nいつも俺のせいにして"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860643
    m_Localized: "Couple: 黙って俺の言うとおりにするだけだろ\nなのに なにも簡単に進まねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860644
    m_Localized: "Couple: 長居して悪かったよ 本当\n今日が最後だ\n二人で出ていくよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860645
    m_Localized: "Couple: 聞いてるか？クソ荷物まとめろ\n今夜まだ ここにいたら\n窓から投げ飛ばすぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860646
    m_Localized: "奥さん\n本当に大丈夫ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860647
    m_Localized: どうなってるんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860648
    m_Localized: "Couple: 口出しは よしてくれ\n頼むから\n前にも言ったろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860649
    m_Localized: "Couple: 首を突っ込まないでくれ\nアンタには関係ないだろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860650
    m_Localized: "Couple: こっちのことは こっちでやる\nイラつかせないでくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860651
    m_Localized: "本当のことを言え\nうんざりだ（銃を構える）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860652
    m_Localized: "知ったことか\n出ていくのか どうなんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860653
    m_Localized: "Couple: なあ ご主人\nなにかも大丈夫だって"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860654
    m_Localized: "Couple: 奥さんは退屈で 騒いでるだけなんだ\nイライラするけどさ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860655
    m_Localized: 'Couple: 俺に なに求めてんだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860656
    m_Localized: "本当のことを言え\nうんざりだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860657
    m_Localized: "知ったことか\n出ていくのか どうなんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860658
    m_Localized: 'Couple: 落ち着けよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860659
    m_Localized: "Couple: 俺も銃を持ってるんだ\nなにかしたら このアマ撃つぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860660
    m_Localized: "Couple: 失うものなんざ 俺にはねえんだ\nお前は？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860661
    m_Localized: どうせ お前は死ぬ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860662
    m_Localized: "まだ引き返せる\nまだ間に合うぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860663
    m_Localized: "Couple: わかった わかった\nもう泊まらない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860664
    m_Localized: 'Couple: 俺たちは出ていく'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054848
    m_Localized: "Couple: 聞こえたか？今夜が最後だ\nとっとと準備しろ\n時間を無駄にすんな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054849
    m_Localized: "Couple: 俺が なにを失うって？\n殺せよ\nそれが なんだってんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054850
    m_Localized: "Couple: 少なくとも 苦しみは終わる\nそれに このアマも道連れだ\n大満足だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054851
    m_Localized: 撃つぞ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054852
    m_Localized: "落ち着いて 銃を捨てろ\n俺も下ろす"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054853
    m_Localized: "Couple: なんでだよ？\nコイツと一緒じゃねえと ダメなんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054854
    m_Localized: "Couple: コイツなしじゃ 行けねえんだ\nだから銃を下ろせ\n俺たちは今夜 出ていく"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054855
    m_Localized: "Couple: 誰も傷つかずに すむ\nお前が見逃して くれればな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054856
    m_Localized: 撃つぞ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054857
    m_Localized: "落ち着いて 銃を捨てろ\n俺も下ろす"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054858
    m_Localized: "Couple: 本気で女を撃つ つもりか？\nお前 平気なのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054859
    m_Localized: "Couple: 俺を撃てば コイツにも当たるぞ\n血に塗れるのは お前の手だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054860
    m_Localized: "Couple: おっ…俺じゃなくてな！\nお前が殺すんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054861
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054862
    m_Localized: 警告する
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054863
    m_Localized: "Couple: 俺が出ていくしかねえ\nさもなきゃ 二人とも死んじまう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054864
    m_Localized: 'Couple: そうするしか ねえんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054865
    m_Localized: "Couple: あのアマがクソ葉っぱみたく\nビクついてねえで\n俺に ついてきてれば…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054866
    m_Localized: "Couple: なにもかも コイツのせいだ\n聞こえてるか？\n全部ぶち壊しやがって！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054867
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054868
    m_Localized: 警告する
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054869
    m_Localized: 'Couple: お前…銃を下ろすのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054870
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054871
    m_Localized: "Couple: 待て\nまだ撃つつもりか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054872
    m_Localized: "Couple: 待て\nやめろ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054873
    m_Localized: "Couple: わかった！わかったよ\n二人で出ていく\n落ち着いてな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054874
    m_Localized: "Couple: なあ？\n今夜こそ本当に出ていくんだぞ？\nおい？クソアマ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054875
    m_Localized: 'Couple: （突如として男は女を自由にし撃つ）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054876
    m_Localized: 'Couple: （すぐに反応し男の頭を撃ち抜く）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054877
    m_Localized: 'Couple: （二人とも死んだようで 片付いた）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054878
    m_Localized: 'Couple: （狂ったカップルだった）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054879
    m_Localized: "Couple: わかった 二人で出ていくよ 今すぐ\nなにか羽織らせてくれ\nそしたら出ていく"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054880
    m_Localized: 'Couple: 二度と見ることはないさ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054881
    m_Localized: 'Couple: 待て…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054882
    m_Localized: 'Couple: なに しでかしてんだ！？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054883
    m_Localized: 'Couple: （男を撃ち 女にも当たる）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054884
    m_Localized: 'Couple: （二人は崩れ落ち 血を流す）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054885
    m_Localized: 'Couple: （女は喉を鳴らすが 手に負えない）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054886
    m_Localized: 'Couple: （二人とも死んだ）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054887
    m_Localized: "Couple: わからねえのか？\nこうするより他に なかったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054888
    m_Localized: "Couple: 二人で出ていく\nそれだけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054889
    m_Localized: "Couple: おい！毛布 取ってくれ\nさあ 行くぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054890
    m_Localized: 'Couple: （二人が毛布に包まり 外へ出て行く）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054891
    m_Localized: 'Couple: （二人はしばし歩き 突然 崩れ落ちる）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054892
    m_Localized: 'Couple: （毛布から煙が上がり 目を背ける）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054937
    m_Localized: 'Luka: なにもかも きっと大丈夫だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054938
    m_Localized: "まだ楽観的で\nいられるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054939
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054940
    m_Localized: "Luka: 楽観的って わけじゃないよ…\nただ 諦めちゃいない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054941
    m_Localized: "Luka: オレたち まだ人間だろ\nまだ踏ん張ってる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054942
    m_Localized: 'Luka: 起きた嵐を悪化させてもない'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054943
    m_Localized: "Luka: それに片が付いたら…\nきっと互いの過ちを許せるはずだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054944
    m_Localized: "Luka: 思いやりが ある限り\n人間性は残ってるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054945
    m_Localized: 'Luka: そうだろ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054946
    m_Localized: 'Luka: なにもかも きっと大丈夫だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054947
    m_Localized: "昔から そんな感じ\nなんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054948
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054949
    m_Localized: "Luka: えっと…いや 昔は違ったよ\n怒ってばかりだった\n人にも 世界にも 自分自身にも"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054950
    m_Localized: "Luka: つまらないことでキレて 人を罵って\nドアを枠ごと壊す勢いで閉めてた\nでも あるとき気付いたんだ\n怒りは自分をダメにする って"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054951
    m_Localized: "Luka: まずは内側から\nそれから 周囲すべてを"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054952
    m_Localized: "Luka: 以前…手を差し伸べてくれた人に\n八つ当たり してしまったんだ\nそれで…その人は…いなくなった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054953
    m_Localized: "Luka: その瞬間 自分の中で なにかが壊れた\n変わらなきゃ って気付いたんだ\nじゃなきゃ 触れるすべて壊してしまう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054954
    m_Localized: "Luka: それで 手放すことを学んだんだ\n深呼吸を 折り合いのつけかたを\nだから ここにいるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054955
    m_Localized: 'Luka: なにもかも きっと大丈夫だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054956
    m_Localized: なにを失ったんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054957
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054958
    m_Localized: 'Luka: 家族だよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054959
    m_Localized: "Luka: 出かけてるときに 家が焼け落ちたんだ\nほんのちょっと 水を汲みに出た隙に\n戻ったら煙と灰だった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054960
    m_Localized: "Luka: 受け入れるのに時間が かかったよ\n自問自答し続けた\nなんで あのとき 外に出た？\nなんで みんなを 救えなかった？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054961
    m_Localized: "Luka: でも 多分そういう問題じゃないんだ\n過去を救えるか どうかじゃない\n未来へ背負っていけるかだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054962
    m_Localized: "Luka: みんなはオレと ともにいる\n思い出が力を与えてくれる\nだから 人を助けようとしてる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054963
    m_Localized: "Luka: 失うとは どういうことか わかってる\nそして なにもかも台無しになったあと\n目的を見つける意味も"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054964
    m_Localized: 'Luka: なにもかも きっと大丈夫だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054965
    m_Localized: "それで生きてこれたんですか？\n家族を失っても？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054966
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054967
    m_Localized: "Luka: ああ なんとかね\nでも 簡単じゃなかったよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054968
    m_Localized: "Luka: ずいぶん長いこと 自分を責め続けた\nあと数分でも早く戻れてたら\nなにか変わったんじゃ ないかって"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054969
    m_Localized: "Luka: でも 悲しみは罪悪感を餌にするんだ\nそして人生には…許しが必要だ\nそう気付かなければ 自分まで失ってた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054970
    m_Localized: 'Luka: 許しが オレを救ってくれたんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054971
    m_Localized: "Luka: 己を許した 過去を変えられない己を\n運命を許した あんなにも残酷な運命を\n怒りに引きずり込まれない ように"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054972
    m_Localized: 'Luka: なにもかも きっと大丈夫だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054973
    m_Localized: "今なにに\n突き動かされてるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054974
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054975
    m_Localized: "Luka: 人間は変われると信じてる\nこんな騒動の最中でも\nいつだって人は立ち上がれるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054976
    m_Localized: "Luka: 奇跡も摂理も信じちゃいない\nオレが信じてるのは人間だ\n人間同士 互いを支えあうことだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054977
    m_Localized: "Luka: 倒れたヤツを支える人もいる\nツイてない日に微笑みかける人もいる\n最後のパン一切れを分けあう人もいる\nそれが人生だ ささいな一つ一つが"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054978
    m_Localized: "Luka: 誰かが世界を少しでも良くするたびに\nなにもかも無駄じゃないと思えるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054979
    m_Localized: 'Luka: なにもかも きっと大丈夫だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054980
    m_Localized: "すべてを取り戻したいですか？\n家や 家族を"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054981
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054982
    m_Localized: "Luka: もう一度みんなに会えるなら…\n話せるなら…抱き締められるなら…\nそうしたいに決まってる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054983
    m_Localized: "Luka: でも すべてを戻すかというと？\nどうだかな\n喪失も人生の一部だ\n酷くて 苦しくて けれど 人を作るんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054984
    m_Localized: "Luka: ああ\nみんなと一日でも過ごせるなら\nなんだって差し出すよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054985
    m_Localized: "Luka: でも 学んだことを失うなら？\n許すこと 前に進み続けることを…\nなら お断りだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054986
    m_Localized: "Luka: 時間には限りがある\n今あるものを大切にするほうがいい\n失ったものに食らわれるよりもね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249152
    m_Localized: "Hunter: 研ぎ澄ませ 警戒を怠るな\n俺たちの中に来訪者がいるかもしれん"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249153
    m_Localized: 猟師ですよね？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249154
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249155
    m_Localized: 'Hunter: 森林警備みたいなもんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249156
    m_Localized: "Hunter: 木の枝しかないような田舎暮らしでな\nテレビもなく ラジオだけだ\n事態を知ったのもラジオ越しだった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249157
    m_Localized: "Hunter: 誰一人 敷居は またがさん そう決めた\n家は砦だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249158
    m_Localized: "Hunter: そいつが来訪者だったら？\n甘い言葉で話しかけ 寝てる間に\n喉元かっ切られるだろうよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249159
    m_Localized: じゃあ 何故ここに？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249160
    m_Localized: 一人は危険です
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249161
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249162
    m_Localized: "Hunter: あの長身 蒼白のゴロツキ\nアイツの手に かかるよりはいい"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249163
    m_Localized: "Hunter: アイツが原因だ\n俺が山小屋を捨てたのは"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249164
    m_Localized: "Hunter: 目を見れば わかる\nアイツを見たんだろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249165
    m_Localized: "どうやって生き延びたんです？\n外で 一人きりで"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249166
    m_Localized: "あの長身で蒼白の来訪者\nあなたも見たんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249167
    m_Localized: "Hunter: 俺が気付かん とでも？\nずいぶんな切れ者ぶりだな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249168
    m_Localized: "Hunter: 気付かなければ\n今頃ミミズの餌だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249169
    m_Localized: "Hunter: 赤の他人を招き入れるなど\n馬鹿げているとばかり"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249170
    m_Localized: "Hunter: 一人でいる方が安全だとな\nそして アイツが現れた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249171
    m_Localized: 'Hunter: あんなケダモノ 見たことがなかった'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249172
    m_Localized: "どうやって生き延びたんです？\n外で 一人きりで"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249173
    m_Localized: "あの長身で蒼白の来訪者\nあなたも見たんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249174
    m_Localized: "Hunter: なあ 小僧…話すと長くなる\n今日は口を開く気分じゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249175
    m_Localized: "Hunter: 明日 ビールでも持ってこい\nみんな話してやる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249176
    m_Localized: 'Hunter: なら 俺だけじゃなかったんだな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249177
    m_Localized: 'Hunter: ああ…見たよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249178
    m_Localized: "Hunter: なあ 小僧…\n俺が遭遇したものを知っているなら…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249179
    m_Localized: "Hunter: 話してやる\nだが今日じゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249180
    m_Localized: "Hunter: 明日 ビールを持ってこい\nあらかた聞かせてやる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249181
    m_Localized: "Hunter: 研ぎ澄ませ 警戒を怠るな\n俺たちの中に来訪者がいるかもしれん"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249182
    m_Localized: それで どんな話なんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249183
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249184
    m_Localized: 'Hunter: ビールはどうした？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249185
    m_Localized: "どうぞ\n（ビールを渡す）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249186
    m_Localized: 'Hunter: で ビールは？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249187
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249188
    m_Localized: "ありません\n（ビールを渡さない）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249189
    m_Localized: 'Hunter: そうでないとな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249190
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249191
    m_Localized: "Hunter: 言ったとおりだ\n山小屋に閉じこもってたんだ\n一人きりでな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249192
    m_Localized: "Hunter: すると ある日あの男が現れた\n息を切らし 必死の形相で"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249193
    m_Localized: "Hunter: ドアを叩きはじめ 入れろと求めてきた\nだが 様子が変だった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249194
    m_Localized: "Hunter: 蒼白で 震え 死を見たかのようだった\n森の奥地まで どう来たのか\n見当も つかなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249195
    m_Localized: "Hunter: ハイカーには見えなかった\nそこで 帰れ と答えた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249196
    m_Localized: "Hunter: アイツは窓を破ろうとした\nだが ライフルがあると叫んでやった\nすると逃げていった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249197
    m_Localized: "Hunter: 二度と見ることはない\nそう思ってたが…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249198
    m_Localized: "助けるべきだったの\nかもしれませんよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249199
    m_Localized: 中に入れてやるべきでした
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249200
    m_Localized: 「思ってた」とは？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249201
    m_Localized: 'Hunter: アイツの追っ手まで入れることになる'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249202
    m_Localized: "Hunter: お断りだ\n問題なら腹一杯だからな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249203
    m_Localized: わかりました
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249204
    m_Localized: あまり口数 多くないんですね
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249205
    m_Localized: 大して話してませんよ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249206
    m_Localized: "察するに ビールがあれば\n話しやすくなりますか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249207
    m_Localized: "Hunter: 正義の味方ヅラはよせ 小僧\nお前も 人を追い返してきただろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249208
    m_Localized: 'Hunter: でなければ とっくの昔に死んでいる'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249209
    m_Localized: 'Hunter: だが 話は明日だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249210
    m_Localized: わかりました
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249211
    m_Localized: あまり口数 多くないんですね
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249212
    m_Localized: 大して話してませんよ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249213
    m_Localized: "察するに ビールがあれば\n話しやすくなりますか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249214
    m_Localized: "Hunter: 二度と見ることは ないとばかり\nだが それから…\nアイツに見つかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249215
    m_Localized: 'Hunter: だが続きは今度だな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249216
    m_Localized: わかりました
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249217
    m_Localized: あまり口数 多くないんですね
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249218
    m_Localized: 大して話してませんよ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249219
    m_Localized: "察するに ビールがあれば\n話しやすくなりますか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249220
    m_Localized: "Hunter: 明日 ビールでも持ってこい\n最後まで話してやる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249221
    m_Localized: 'Hunter: おしゃべりじゃ ないんでな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249222
    m_Localized: "Hunter: ありがたく思え\nこれでも話して やってるほうだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249223
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249224
    m_Localized: "Hunter: 明日 ビールを持ってこい\n残りを話してやる\nいいな？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249225
    m_Localized: "Hunter: 逸るな 小僧\nこっちは地獄を見てきたんだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249226
    m_Localized: "Hunter: 酔ってなければ\n思い出したくもない光景をな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249227
    m_Localized: "Hunter: ビールを持ってくれば\n話してやる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249228
    m_Localized: "Hunter: 鋭いな\n感心した"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249229
    m_Localized: 'Hunter: 無駄口は叩かん'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249230
    m_Localized: "Hunter: だから明日 ビールを持ってこい\n終わりまで話してやる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249231
    m_Localized: "Hunter: 悪いが\n素面じゃ 口が回らん"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249232
    m_Localized: "Hunter: ビールを持ってこい\nそうしたら話そう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249233
    m_Localized: "Hunter: 研ぎ澄ませ 警戒を怠るな\n俺たちの中に来訪者がいるかもしれん"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249234
    m_Localized: それで どうなったんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249235
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249236
    m_Localized: "Hunter: 話してやる\nだが まずはビールだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249237
    m_Localized: "どうぞ\n（ビールを渡す）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249238
    m_Localized: "Hunter: 待て\nビールは どうした？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249239
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249240
    m_Localized: "ありません\n（ビールを渡さない）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249241
    m_Localized: 'Hunter: じゃあ 話すとしよう'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249242
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249243
    m_Localized: 'Hunter: あの男が逃げ 俺は山小屋に留まった'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249244
    m_Localized: "Hunter: だが薪を切らしてな\n取りに行くしか なかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249245
    m_Localized: "Hunter: 一山 担いで戻ってきたら…\nライフルが消えていた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249246
    m_Localized: "Hunter: 焦った\nしっちゃかめっちゃか探したが\n消え失せていた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249247
    m_Localized: "Hunter: それから…\n窓の向こうにアイツが見えた\nあの男が"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249248
    m_Localized: "Hunter: 手には俺のライフル…\nだが 様子が変わっていた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249249
    m_Localized: "Hunter: 背が伸びていた\n肌が たるんでいた\n赤子のように裸で ズボン一つきり"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249250
    m_Localized: "Hunter: 両手で銃を握り…\n枝のように二つに折った"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249251
    m_Localized: "Hunter: そうして ただ立っていた\nじっと 俺の瞬きを待つように…\n首を へし折る隙を"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249252
    m_Localized: "Hunter: だが アイツは なにもしなかった\nただ見ていた\n奇妙な にらめっこ だった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249253
    m_Localized: "Hunter: それから…夜が明けると\n害獣は消失していた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249254
    m_Localized: "Hunter: それで悟った\n銃も持たず一人きりなんて自殺行為だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249255
    m_Localized: "Hunter: それで街へ走った\n太陽が昇りきる前に発ってな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249256
    m_Localized: 'Hunter: そうして ここに来たんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249257
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249258
    m_Localized: 'Hunter: お前は引き金を引けるといいな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249259
    m_Localized: "Hunter: 誰にも わからんがな\n弾丸が効くものやら"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249260
    m_Localized: "なぜ殺されずに\nすんだんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249261
    m_Localized: 殺せると思いますか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249262
    m_Localized: "部隊ひとつ\n全滅させられました"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249263
    m_Localized: "Hunter: さあな\n丈夫なライフルをなんの変哲もなく\n折るような男だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249264
    m_Localized: "Hunter: 刹那で同じ目に合わせられたはずだ…\nだが そうしなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249265
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249266
    m_Localized: "Hunter: 多分な ただ弄んで楽しんでるんだ\n猫が鼠を いたぶるように"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249267
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249268
    m_Localized: "Hunter: なあ そうそう恐れるタチじゃないんだ\nだが あの長身 蒼白のゴロツキは別だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249269
    m_Localized: 'Hunter: 恐ろしかった'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249270
    m_Localized: 'Hunter: そう信じたいものだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249271
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249272
    m_Localized: "Hunter: なあ 昔から言うだろう…\n「血が出るなら殺せる」と"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249273
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249274
    m_Localized: "Hunter: 部隊ひとつ壊滅させられる相手なら…\n勝ち目などない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249275
    m_Localized: "Hunter: その気になれば こんなところ\nちり紙のように引き裂けるだろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249276
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249277
    m_Localized: "Hunter: なあ そうそう恐れるタチじゃないんだ\nだが あの長身 蒼白のゴロツキは別だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249278
    m_Localized: 'Hunter: 恐ろしかった'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249279
    m_Localized: 'Hunter: ビールなしじゃ 話もなしだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249280
    m_Localized: 'Hunter: 素面じゃ 口が回らん'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249281
    m_Localized: "Hunter: 小僧 続きを望むなら…\nビールを持ってこい"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443456
    m_Localized: "Cold: ほんの少しでいい\n温もりが ほしい…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443457
    m_Localized: "ジャケット着っぱなし\nなんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443458
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443459
    m_Localized: "Cold: ああ\n一つ気がかりなんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443460
    m_Localized: "Cold: 脱いだら どうなるだろう\n僕は温まれないんだ\n熱い場所にいても"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443461
    m_Localized: "Cold: ジャケットを脱いだら\n寒くて死んでしまわないか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443462
    m_Localized: "Cold: あるいは なお悪いのは\nもっと凍えながら生きることだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443463
    m_Localized: 汗かかないんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443464
    m_Localized: "ではシャワーも\n浴びないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443465
    m_Localized: 'Cold: いや'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443466
    m_Localized: "Cold: 体は汗ばむんだ\n冷やそうとして"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443467
    m_Localized: 'Cold: でも もう冷えないんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443468
    m_Localized: "Cold: その質問は無視させてくれ\nすまない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443469
    m_Localized: "Cold: ほんの少しでいい\n温もりが ほしい…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443470
    m_Localized: "体温を取り戻す方法に\n心当たりは？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443471
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443472
    m_Localized: 'Cold: 変えられるとは思ってない'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443473
    m_Localized: "Cold: 熱湯は焼けるだけだ\n助けにならない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443474
    m_Localized: 'Cold: なあ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443475
    m_Localized: 'Cold: たとえ話を思いついたんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443476
    m_Localized: "Cold: 深宇宙を思い描いてみてくれ\n広大で凍てついた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443477
    m_Localized: 'Cold: 銀河が生まれ 星が崩れる'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443478
    m_Localized: 'Cold: 僕は ただ見てるだけ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443479
    m_Localized: 'Cold: 太陽の温もりを感じもせず'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443480
    m_Localized: 'Cold: 抱擁の温かさも知らず'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443481
    m_Localized: "Cold: 宇宙も社会も\n僕を必要としてないんだろうな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443482
    m_Localized: "Cold: ほんの少しでいい\n温もりが ほしい…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443483
    m_Localized: "隠し事があるんでしたよね\nなんだったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443484
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443485
    m_Localized: "Cold: えっと\n今は話す気になれない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443486
    m_Localized: "Cold: 心に引っかかってるんだ\n長いこと ずっと\nそれが原因かもしれない…冷たさの"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443487
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443488
    m_Localized: "Cold: 話題に したくもないんだ\nでも 渇望に蝕まれてて"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443489
    m_Localized: 'Cold: その…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443490
    m_Localized: "Cold: 明日 話そう\nちゃんと話せるはず"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443491
    m_Localized: "Cold: ほんの少しでいい\n温もりが ほしい…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443492
    m_Localized: "それで隠し事は\nなんなんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443493
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443494
    m_Localized: "Cold: ああ\n秘密を打ち明けさせてくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443495
    m_Localized: 'Cold: もう大丈夫だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443496
    m_Localized: "Cold: 大抵は悪いオチになるもんだが\n今回は違うかもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443497
    m_Localized: "Cold: 服の下にあるもの\nああ それが寒さと孤独の原因のはずだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443498
    m_Localized: 'Cold: 見てくれ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443499
    m_Localized: "Cold: ダメか…\nまたダメなのか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443500
    m_Localized: なに しでかしたんだ？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443501
    m_Localized: 終わりだな
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443502
    m_Localized: 'Cold: そんなつもりじゃ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443503
    m_Localized: 'Cold: ここなら違うのかと'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443504
    m_Localized: 'Cold: そんなはず ないのにな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443505
    m_Localized: 'Cold: 望んで こうなった わけじゃない'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443506
    m_Localized: 'Cold: 本当に 違うんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443507
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443508
    m_Localized: 追い出す
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443509
    m_Localized: 'Cold: 前も こうだった…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443510
    m_Localized: "Cold: なんで 今回は違うと\n思っちまったんだろうな？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443511
    m_Localized: 'Cold: 早まるな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443512
    m_Localized: 'Cold: 悪意があって やったわけじゃない'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443513
    m_Localized: 'Cold: そんなつもりじゃ なかったんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443514
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443515
    m_Localized: 追い出す
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443516
    m_Localized: 'Cold: もしかしたら それが一番なのかもな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443517
    m_Localized: "Cold: もう冷たくならない\nもう孤独にならない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443518
    m_Localized: 'Cold: ただ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443519
    m_Localized: 'Cold: 企んでた わけじゃないんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443520
    m_Localized: 'Cold: 今すぐか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443521
    m_Localized: "Cold: 銃弾のほうが まだ優しい\n痛みはあるけどな 残念ながら"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443522
    m_Localized: 'Cold: 太陽は時間が かかるからな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443523
    m_Localized: 'Cold: 夜が来るまで いていいか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443524
    m_Localized: 今すぐ出ていけ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443525
    m_Localized: じっとしてろよ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443526
    m_Localized: 'Cold: わかったよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443527
    m_Localized: 'Cold: すまない'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443528
    m_Localized: "Cold: 太陽なら僕を温めてくれるかもな\n最後に"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443529
    m_Localized: 'Cold: ありがとう'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443530
    m_Localized: 'Cold: 嫌ってるのは わかってる'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443531
    m_Localized: 'Cold: それでも'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443532
    m_Localized: "Cold: すまない\n望んで こうなった わけじゃないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832064
    m_Localized: "Daughter: それと…えっと…\n友達も呼んで くれないかな？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832065
    m_Localized: "Daughter: 大人の人が呼ぶと 許してもらえるの…\nでも わたしじゃ いつも叱られるの"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832066
    m_Localized: "Daughter: これが番号だよ\n{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832067
    m_Localized: "Greatmother: おや ぼんず…\n誰も中に入れんじゃねぇよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832068
    m_Localized: "なぜFEMAに連れて行かれず\n立ち退かされたのですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832069
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832070
    m_Localized: "Greatmother: さぁねぇ ぼんず\nあの防護服ん連中…\nなに考えてんだかねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832071
    m_Localized: "Greatmother: いつもズカズカ歩き回っちゃぁ\nあれこれ命令ばっか しよってさ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832072
    m_Localized: 'Greatmother: 何様なんだろうねぇ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832073
    m_Localized: "Greatmother: なぁんも わかっちゃいねぇ癖して\n居丈高に振る舞ってさ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832074
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832075
    m_Localized: "Greatmother: そういや ぼんずんドアも叩いたんかい\nあの連中？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832076
    m_Localized: ええ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832077
    m_Localized: "一人このあたりを\nうろついています"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832078
    m_Localized: "Greatmother: あのバカども！\n防護服 引っぺがして\n隔離区域に蹴り飛ばしてやろうかねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832079
    m_Localized: "Greatmother: 本物の人間との暮らし方ってのを\nわからしてやんのさ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832080
    m_Localized: 'Greatmother: 今じゃ建物まで乗っ取ってんだろ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832081
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832082
    m_Localized: 'Greatmother: ろくでなしどもが まったく'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832083
    m_Localized: "Greatmother: 一度きりなら まだしも\n何度も何度も来よってからに…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832084
    m_Localized: 'Greatmother: 恥ってもんが ねぇんかねぇ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832085
    m_Localized: "Greatmother: おや ぼんず…\n誰も中に入れんじゃねぇよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832086
    m_Localized: "ご家族から どなたか\n連れて行かれたんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832087
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832088
    m_Localized: "Greatmother: おやまあ\n家族のことなんて久々に訊かれたよ\nぼんず"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832089
    m_Localized: "Greatmother: うちは大所帯でねぇ\nようけ産んだもんさ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832090
    m_Localized: 'Greatmother: ほんと 山ほどねぇ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832091
    m_Localized: 'Greatmother: もう 家に入りきらんぐらいさ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832092
    m_Localized: "Greatmother: 鍵かけたドア向こうじゃ\nちっこい子が変人どもから隠れとる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832093
    m_Localized: 答えになってませんよ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832094
    m_Localized: "ご家族は連れて\n行かれたんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832095
    m_Localized: 'Greatmother: おや…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832096
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832097
    m_Localized: "Greatmother: つい しゃべりすぎちまったねぇ\nぼんず"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832098
    m_Localized: "Greatmother: そうともさ\nあの防護服 着たバカどもが\n一人残らず さらってったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832099
    m_Localized: "Greatmother: でも 許しておくもんかね\nあたしゃ認めないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832100
    m_Localized: "Greatmother: ぼんずん とっからも\n誰か連れて行かれたんかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832101
    m_Localized: 家族はいません
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832102
    m_Localized: いえ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832103
    m_Localized: 'Greatmother: おや…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832104
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832105
    m_Localized: "Greatmother: つい しゃべりすぎちまったねぇ\nぼんず"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832106
    m_Localized: "Greatmother: そうともさ\nあの防護服 着たバカどもが\n一人残らず さらってったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832107
    m_Localized: "Greatmother: ぼんずん とっからも\n誰か連れて行かれたんかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832108
    m_Localized: 家族はいません
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832109
    m_Localized: いえ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832110
    m_Localized: "Greatmother: そうかい？\nにしちゃぁ 大層な家じゃぁねぇかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832111
    m_Localized: "Greatmother: 一人で暮らすにしちゃぁ ぼんず…\nおかしいねぇ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832112
    m_Localized: 'Greatmother: 大きな家にゃぁ 大きな家族だろ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832113
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832114
    m_Localized: "Greatmother: まぁ いいさ\nもう詮索せんよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832115
    m_Localized: "Greatmother: ただね うちん赤子らを\nあの区域から\n連れ戻してぇだけなんさ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832116
    m_Localized: "Greatmother: 連中 ぼんずにゃぁ\n手ぇ出してねぇんかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832117
    m_Localized: 'Greatmother: そんなら ぼんずん家族は どこだい？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832118
    m_Localized: "Greatmother: こんな広いとこ\n一人住まいじゃぁ なかろうに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832119
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832120
    m_Localized: "Greatmother: まぁ いいさ\nもう詮索せんよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832121
    m_Localized: "Greatmother: ただねぇ うちん赤子らを\nあの区域から\n出してやりてぇだけなんさ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832122
    m_Localized: "Greatmother: おや ぼんず…\n誰も中に入れんじゃねぇよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832123
    m_Localized: "どうやって ご家族を\n連れ戻すつもりですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832124
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832125
    m_Localized: "Greatmother: あたしゃ助けんよ\nあの子らぁ 自ら戻ってくるさ ぼんず"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832126
    m_Localized: どういう意味です？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832127
    m_Localized: 自力で？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832128
    m_Localized: "Greatmother: くだらんフェンスやら鉄条網やらで\nうちの赤子ら 止められるもんかね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832129
    m_Localized: "Greatmother: 土の中を這って戻ってくるんよ\n地面から姿を現すんさ…\n向こうから"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832130
    m_Localized: "Greatmother: 地中から来れんでも\n区域をブチ壊してやるだろうよ\n哀れなこった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832131
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832132
    m_Localized: "Greatmother: みんな来とるところよ\n聞こえんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832133
    m_Localized: なに言ってんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832134
    m_Localized: どうかしたんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832135
    m_Localized: どういう意味です？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832136
    m_Localized: （殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832137
    m_Localized: "Greatmother: 壁は崩れるさ\nその時が来りゃぁ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832138
    m_Localized: "Greatmother: 死ぬよ 山ほど死ぬ…\nそれから あいつが来んだ\n食らいに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832139
    m_Localized: "Greatmother: そうなりゃ防護服どもも\nうちの子なんざぁ\n気にしちゃ いらんなくなるだろうよ\nようけ厄介に ぶち当たっからねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832140
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832141
    m_Localized: "Greatmother: みんな来とっところよ\n聞こえんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832142
    m_Localized: なに言ってんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832143
    m_Localized: どうかしたんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832144
    m_Localized: どういう意味です？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832145
    m_Localized: （殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832146
    m_Localized: "Greatmother: ぼんずらが こしらえた巣穴なんざ\nみぃんな踏み潰してやるさ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832147
    m_Localized: "Greatmother: 壁はヒビ割れ…\n通りは血で赤く染まり…\n死体の山が積み上がる…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832148
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832149
    m_Localized: "Greatmother: 聞こえるよ 這う音が\nすぐ そこだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832150
    m_Localized: どういう意味だ？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832151
    m_Localized: お前 何者だ？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832152
    m_Localized: 来訪者か？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832153
    m_Localized: （殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832154
    m_Localized: 'Greatmother: 肉が焼ける臭い 甘くてたまらんねぇ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832155
    m_Localized: "Greatmother: 防護服ども よう焼けとる\nちぃとカリカリすぎかも しれんがね\nほぉんの わずかさ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832156
    m_Localized: "Greatmother: ぼんず ようけ死体 持っとろう\nたんまりと 大層な ごちそうさ\nうちの赤子らも 腹ぁいっぱいだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832157
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832158
    m_Localized: "Greatmother: 聞こえるよ 這う音が\nすぐ そこだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832159
    m_Localized: どういう意味だ？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832160
    m_Localized: お前 何者だ？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832161
    m_Localized: 来訪者か？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832162
    m_Localized: （殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832163
    m_Localized: "Greatmother: この家は えぇとこだよ\n特別さ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832164
    m_Localized: "Greatmother: 大きな家なのに とんと人がおらん\nみんなで暮らせるねぇ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832165
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832166
    m_Localized: "Greatmother: 聞こえるよ 這う音が\nすぐ そこだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832167
    m_Localized: どういう意味だ？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832168
    m_Localized: お前 何者だ？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832169
    m_Localized: 来訪者か？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832170
    m_Localized: （殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832171
    m_Localized: 'Greatmother: 役立たずの クソぼんず…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832172
    m_Localized: 'Greatmother: ぼんずんとこにも来るよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832173
    m_Localized: "Greatmother: 赤子ら 新しい巣 見っけたよ\nようやっと くつろげるねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832174
    m_Localized: "Greatmother: 這っといで\nこの家はもう あいつんじゃないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832175
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832176
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832177
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832178
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832179
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832180
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832181
    m_Localized: 'Greatmother: おっかぁは赤子らに会いたいよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832182
    m_Localized: "Greatmother: さぁ来な\nこの家は おあつらえ向きさ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832183
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832184
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832185
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832186
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832187
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832188
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832189
    m_Localized: "Greatmother: 這っといで 赤子ら\nあたしゃ ここだよ\n新しい家 見っけたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832190
    m_Localized: "Greatmother: 広々として えぇとこさ\n部屋も たんまりだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832191
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832192
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832193
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832194
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832195
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832196
    m_Localized: （ブッ殺す）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832197
    m_Localized: "Greatmother: いやだよ\nこの家 あたしらのもんだ\nぼんず どうせ嫌いなんだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832198
    m_Localized: 'Greatmother: 燃やしちめぇてぇんだろ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026368
    m_Localized: 'Greatmother: おっかぁに よこしな！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026369
    m_Localized: "Greatmother: 哀れなこった…\nぼんずの望み あたしゃ わかっとるよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026370
    m_Localized: 'Greatmother: …死だろ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026371
    m_Localized: 'Wolfhound: どうかしたか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220672
    m_Localized: なぜ人を獣だと？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220673
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220674
    m_Localized: "Wolfhound: 一つ訊かせな\n俺たちってのは なんなんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220675
    m_Localized: "Wolfhound: 殺して 殺したもん食って\nそんで夜は ぐっすり\nそいつが本性だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220676
    m_Localized: "Wolfhound: だがな 社会が首輪を付けやがった\n幸い そんな時代 とうの昔だがな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220677
    m_Localized: どういう意味です？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220678
    m_Localized: この状況で満足なんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220679
    m_Localized: "Wolfhound: 単純な話だ\nくだらない社会規範は消え失せた\n今じゃ なにもかも明白だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220680
    m_Localized: "Wolfhound: 群れがある カシラがいる\n群れの存続を脅かす奴は死ぬ\nそいつが俺の掟だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220681
    m_Localized: "Wolfhound: だが 最悪なのはな\n羊の皮を被った狼だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220682
    m_Localized: "社会より群れのほうが\nマシだと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220683
    m_Localized: 狼の皮を被った羊ではなく？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220684
    m_Localized: "Wolfhound: 仮面を被る連中が減った\nそれだけで充分だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220685
    m_Localized: 'Wolfhound: だがな 羊どもで全部ぶち壊しだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220686
    m_Localized: "Wolfhound: 狼の毛皮を被って なりすましやがる\n強者の本能を装ってな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220687
    m_Localized: "Wolfhound: 腰抜けども 地面に穴でも掘っていろ\nいたちごっこ するぐらいなら\n真っ向から争うほうがマシだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220688
    m_Localized: "Wolfhound: だが お前が群れを作ったのなら\n偽者を見抜く目があるということだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220689
    m_Localized: "社会より群れのほうが\nマシだと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220690
    m_Localized: 狼の皮を被った羊ではなく？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220691
    m_Localized: 'Wolfhound: 勘繰ってんのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220692
    m_Localized: "Wolfhound: 社会を思い出してみろ\n羊なんて見抜けなかっただろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220693
    m_Localized: "Wolfhound: 決めごとするにも口ばかりだ\nやるべきことも討論に埋もれちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220694
    m_Localized: "Wolfhound: だからカシラが不可欠だ\n質問も投票もなし\nカシラの言葉こそ法だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220695
    m_Localized: "Wolfhound: カシラは力を誇示しなければならん\n群れを守る唯一の術だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220696
    m_Localized: "Wolfhound: ああ 俺が言ってるのはだな\nお前たちが来訪者と呼ぶ\n臆病者のクズどもだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220697
    m_Localized: "Wolfhound: 鼠みたいに地下へ隠れ\nこっちが弱まるのを待ってやがる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220698
    m_Localized: "Wolfhound: 今じゃ人間の倫理まで利用してやがる\n情けにすがって殺されないように"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220699
    m_Localized: "Wolfhound: だからこそ 牙を剥かなければならん\n俺たちは獣だと 思い知らせんとな\nさもなくば シマを奪われちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220700
    m_Localized: 'Wolfhound: どうかしたか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220701
    m_Localized: "どうして私の銃を\n見つめてるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220702
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220703
    m_Localized: "Wolfhound: お前にはカシラの貫目がある\n皆を仕切って 支配者の面構えだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220704
    m_Localized: "Wolfhound: ヤサも悪くない\nよく人が出入りしていて デカい家だ\nだが ツルんでる連中は…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220705
    m_Localized: なにが言いたいんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220706
    m_Localized: 来訪者が紛れてると？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220707
    m_Localized: "Wolfhound: ボンクラばかり集めてるな\n甘っちょろい連中を"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220708
    m_Localized: "Wolfhound: 教えろ\n年寄りや子供に病人 なんの役に立つ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220709
    m_Localized: "Wolfhound: 群れってのはな 強者で構成するもんだ\n生き残りたければな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220710
    m_Localized: それで どうしろと？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220711
    m_Localized: 追い出せと？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220712
    m_Localized: "Wolfhound: 狼の皮を被った羊は問題じゃない\n気にすべきは弱い狼だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220713
    m_Localized: "Wolfhound: お前の群れには芯がない\n来ては去る奴ばかりだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220714
    m_Localized: "Wolfhound: 一等 強いのを選べ\n囲い込むんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220715
    m_Localized: それで どうしろと？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220716
    m_Localized: 追い出せと？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220717
    m_Localized: 'Wolfhound: 弱者は切り捨てろ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220718
    m_Localized: "Wolfhound: 殺せ\n皆の前でな\n見せしめにしろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220719
    m_Localized: "Wolfhound: それが地盤を固めるコツだ\n誰がカシラか見せつける勘所だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220720
    m_Localized: "Wolfhound: 弱者の死に 顔色ひとつ変えない奴…\nそいつらが本物の狼だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220721
    m_Localized: 'Wolfhound: 囲い込め'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220722
    m_Localized: 殺人鬼ではありません
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220723
    m_Localized: 殺すのは来訪者だけです
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220724
    m_Localized: "Wolfhound: 見逃してみろ\nお前の権威は即座に崩れる\n連中から甘ちゃん呼ばわりだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220725
    m_Localized: 'Wolfhound: 慈悲は弱さの仮面に過ぎん'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220726
    m_Localized: "Wolfhound: 情けをかけるな\n来訪者なら？撃つだろう\n弱者 病人 年寄り？同じことだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220727
    m_Localized: "Wolfhound: そうすれば恐れられる\nカシラの あるべき姿だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220728
    m_Localized: 殺人鬼ではありません
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220729
    m_Localized: 殺すのは来訪者だけです
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220730
    m_Localized: "Wolfhound: 誰に言い訳してるんだ？\nその目を見れば わかる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220731
    m_Localized: "Wolfhound: 殺してきたんだろ\n手を汚してないフリをするな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220732
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220733
    m_Localized: 'Wolfhound: 昔は街を仕切ってた'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220734
    m_Localized: "Wolfhound: 誰もが俺を恐れた\n敬意を払っていた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220735
    m_Localized: "Wolfhound: 魂を汚すのに どれほど かかるか\n考えたことがあるか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220736
    m_Localized: "Wolfhound: 俺は時間をかけた\n腐るままにした\nわかるか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220737
    m_Localized: "Wolfhound: あるとき 俺の乗車を断った\nタクシー運転手がいた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220738
    m_Localized: 'Wolfhound: 許すと 俺の名が地に落ちる'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220739
    m_Localized: 'Wolfhound: だから全身の骨を残らず折ってやった'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220740
    m_Localized: "Wolfhound: だがな そいつの子供は学んだ\n街の連中も 俺への敬意を失わなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220741
    m_Localized: 'Wolfhound: 弱者を甘やかすのは よしておけ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220742
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220743
    m_Localized: 'Wolfhound: 昔は街を仕切ってた'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220744
    m_Localized: "Wolfhound: 誰もが俺を恐れた\n敬意を払っていた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220745
    m_Localized: "Wolfhound: 魂を汚すのに どれほど かかるか\n考えたことがあるか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220746
    m_Localized: "Wolfhound: 俺は時間をかけた\n腐るままにした\nわかるか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220747
    m_Localized: "Wolfhound: あるとき 俺の乗車を断った\nタクシー運転手がいた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220748
    m_Localized: 'Wolfhound: 許すと 俺の名が地に落ちる'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220749
    m_Localized: 'Wolfhound: だから全身の骨を残らず折ってやった'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220750
    m_Localized: "Wolfhound: だがな そいつの子供は学んだ\n街の連中も 俺への敬意を失わなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220751
    m_Localized: 'Wolfhound: どうかしたか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220752
    m_Localized: "群れの話を続けてますが\n何故あなた自身は一人で？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220753
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220754
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220755
    m_Localized: 'Wolfhound: お前は何故 人を集めた？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220756
    m_Localized: "あの長身 蒼白の来訪者に\n殺されないようにです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220757
    m_Localized: 人を助けようとしてます
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220758
    m_Localized: "誰かいるほうが\n好きなだけです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220759
    m_Localized: "人には まとめ役が\n必要ですから"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220760
    m_Localized: こちらが訊いてるんです
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220761
    m_Localized: 'Wolfhound: 要は 身を守るためか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220762
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220763
    m_Localized: "Wolfhound: お前 カシラの声してないな\nビクついた子犬みたいだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220764
    m_Localized: 'Wolfhound: この群れには強者が必要だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220765
    m_Localized: "Wolfhound: 俺が地位を奪うしかないか\nお前はカシラの器じゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220766
    m_Localized: "Wolfhound: 立派な志だ\n少し甘いが"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220767
    m_Localized: "Wolfhound: 誰も彼も救えると思うな\n遅かれ早かれ 誰か見捨てる日が来る"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220768
    m_Localized: "Wolfhound: だがな カシラらしい声だ\n異論はない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220769
    m_Localized: "Wolfhound: それだけか？\n孤独が恐ろしいだけだと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220770
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220771
    m_Localized: "Wolfhound: そんなのはカシラの言葉じゃない\n臆病者の戯言だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220772
    m_Localized: 'Wolfhound: そいつは 本物の男の言葉だな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220773
    m_Localized: 'Wolfhound: ならば 黙って従おう'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220774
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220775
    m_Localized: "Wolfhound: それには答えん\n知らないほうが身のためだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220776
    m_Localized: "Wolfhound: 必要以上に話しただろ\n今度はお前の番だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220777
    m_Localized: "Wolfhound: お前がカシラの器じゃないなら\n俺が代わって立つまでだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220778
    m_Localized: クソ食らえ！
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220779
    m_Localized: 何故あなたが上だと？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220780
    m_Localized: （銃を抜く）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220781
    m_Localized: "失せろ\n撃ち殺される前に"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220782
    m_Localized: "Wolfhound: 黙れ 子犬野郎\nもう お前には興味がない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220783
    m_Localized: "Wolfhound: 手前がカシラたる所以も知らず\nなんで こなしてるんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220784
    m_Localized: "Wolfhound: 今すぐ退け\nさもなくば ぶちのめす"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220785
    m_Localized: "Wolfhound: 群れがなんだか 俺は知ってる\n俺は掟で生きてる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220786
    m_Localized: 'Wolfhound: こんな腑抜けじゃ カシラは務まらん'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220787
    m_Localized: "Wolfhound: 今すぐ退け\nさもなくば ぶちのめす"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220788
    m_Localized: 'Wolfhound: そう出るか'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220789
    m_Localized: 'Wolfhound: こっちも銃があるの 忘れてないよな？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220790
    m_Localized: "Wolfhound: 銃を下ろせ\n何事もなく手打ちといこう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220791
    m_Localized: （撃つ）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220792
    m_Localized: （銃を下ろす）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220793
    m_Localized: 'Wolfhound: 死ね このクソ野…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220794
    m_Localized: 'Wolfhound: バカが…本当に撃ちやがって'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220795
    m_Localized: 'Wolfhound: …いい子だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220796
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220797
    m_Localized: "Wolfhound: だがな トドメは\n刺すべきだったな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220798
    m_Localized: 'Wolfhound: （男は好機を逃さず 銃を抜く）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220799
    m_Localized: 'Wolfhound: （銃口は こちらを向いている）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220800
    m_Localized: 'Wolfhound: （幸い ショットガンを掴み 撃てた）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220893
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220895
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220902
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220904
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220914
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220916
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414986
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414988
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415004
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415006
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415011
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415013
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415024
    m_Localized: 'Edgar: なんて澄み切った静寂…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415025
    m_Localized: 手の具合は どうですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415026
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415027
    m_Localized: "Edgar: もう長いこと感覚はありません\nただ痛みと冷たさだけが残っています"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415028
    m_Localized: "Edgar: ですが 構いません\nこの甘美なる瞬間を少しでも\n引き延ばしたいのです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415029
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415030
    m_Localized: 'Edgar: ある少女を思慕していました'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415031
    m_Localized: "Edgar: 大切な時間を共に過ごしました\n黙って座っていても 言葉はなくとも\n通じ合っていると理解できました\nそのとき ふと気付いたのです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415032
    m_Localized: "Edgar: 自分を欺いていました\n本当は少女を なにも知りませんでした\nそう信じたかっただけかもしれません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415033
    m_Localized: "Edgar: それでも願っています\nいつの日か 少女を知悉できると"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415034
    m_Localized: 'Edgar: なんて澄み切った静寂…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415035
    m_Localized: 少女について教えてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415036
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415037
    m_Localized: "Edgar: 少女の目には いつも月のように\n冷たい輝きが宿っていました"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415038
    m_Localized: 'Edgar: 大厄災とは対極の存在だったのです'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415039
    m_Localized: "Edgar: 少女の傍らにいると\n揺るぎなき神秘に取り憑かれました"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415040
    m_Localized: "Edgar: そして 少女の秘密を\n解き明かしたくて たまらないのです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415041
    m_Localized: 'Edgar: 今や 僕の金字塔です'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415042
    m_Localized: "Edgar: やがて旅立つとき\n僕を導く灯台"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415043
    m_Localized: 'Edgar: なんて澄み切った静寂…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415044
    m_Localized: "どのように\n出会ったのですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415045
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415046
    m_Localized: "Edgar: あるとき 定めを悟りました\n間もなく敗血症に襲われる と"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415047
    m_Localized: "Edgar: 恐ろしい考えでした\n僕は消滅するのです\nやがていつかではなく 数ヶ月もせず"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415048
    m_Localized: "Edgar: それから 来訪者が地から這い出る頃…\nある家で少女を見つけました"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415049
    m_Localized: "Edgar: 白い布に包まれた少女\n忘れがたい美を宿した顔"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415050
    m_Localized: "Edgar: この残酷な世界では\n誰もが 己の利益しか頭にありません\nそんな美を 誰も気にしなかったのです\n僕は違いました"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415051
    m_Localized: "Edgar: こんな言葉を聞いたことが？\n「拒むには あまりに尊く\n受け入れるには あまりに恐ろしい」"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415052
    m_Localized: "Edgar: それでも…\n僕は華奢な身体を抱き上げ\n家まで連れ帰りました"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415053
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415054
    m_Localized: "Edgar: 終焉が来たら こう語るでしょう\n「行いのすべては 愛ゆえでした」"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415055
    m_Localized: 'Edgar: なんて澄み切った静寂…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415056
    m_Localized: 今 少女はどちらに？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415057
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415058
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415059
    m_Localized: "Edgar: 長い時間をかけました\n少女の美を掴みとるのに\n少女の沈黙に宿る力を把握するのに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415060
    m_Localized: 'Edgar: ですが…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415061
    m_Localized: "Edgar: 相貌のない黄色の男たちが\n部屋へ押し入ってきました"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415062
    m_Localized: "Edgar: 少女を捕らえ 引きずり 連れ去りました\n理由は互いに承知のはずです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415063
    m_Localized: "Edgar: 無念でした…\nついぞ少女を理解できませんでした"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415064
    m_Localized: 'Edgar: そうして再び 孤独が訪れました'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415065
    m_Localized: "Edgar: 世界を救え そう誰も彼も訴えます\nですが どう救うか 意見は一致しません\n答えは単純です"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415066
    m_Localized: "Edgar: 答えは沈黙の内にあります\n美の内に\nただ…悟りさえすれば"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415067
    m_Localized: "Edgar: 少女は教示しようと してくれました\nですが 学べたのは静寂だけでした\n恐ろしきものに宿る 優美なる面影"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415068
    m_Localized: 'Edgar: せめて今は…追従する覚悟があります'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415128
    m_Localized: 'Provocateur: なんて世の中なのでしょう…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415129
    m_Localized: 今度はなんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415130
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415131
    m_Localized: 'Provocateur: 賃貸契約の締結が まだのようです'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415132
    m_Localized: "どうすれば正式に\nすませられるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415133
    m_Localized: "今さら そんなことを\n気にするんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415134
    m_Localized: "Provocateur: まさか書類すら\n手元にないのですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415135
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415136
    m_Localized: "Provocateur: それでは…公証人のところへ赴き\n書類の取得を推奨します\nまったく"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415137
    m_Localized: "冗談でしょう？\n今 公証人を見つけろと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415138
    m_Localized: 何故 自分で行かないので？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415139
    m_Localized: "Provocateur: 不躾ながら\n言葉遣いには配慮いただけますか\n敬語でお願いします"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415140
    m_Localized: 'Provocateur: なんて無教養な…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415141
    m_Localized: "なんでも いいですよ\nもう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415142
    m_Localized: いいから黙れ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415143
    m_Localized: "Provocateur: 地図の読み方ぐらい ご存じでしょう？\n複雑な話では ありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415144
    m_Localized: "Provocateur: それと一度 言いましたが 改めて\n敬意を持って接してもらえますか\n敬語を使ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415145
    m_Localized: "なんでも いいですよ\nもう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415146
    m_Localized: いいから黙れ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415147
    m_Localized: "Provocateur: では何故 私が雑務に\n奔走しなければ ならないのですか？\nついでに言っておきますが\n私に対しては敬語を使ってください！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415148
    m_Localized: "Provocateur: 私は善良なる市民です\n使いっ走りでは ありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415149
    m_Localized: "なんでも いいですよ\nもう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415150
    m_Localized: いいから黙れ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415151
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415152
    m_Localized: "Provocateur: わざと やっていますね？\nせめて協力的に振る舞うぐらいは\nしたらどうですか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415153
    m_Localized: "Provocateur: 口の利き方に注意してください\n憲法 第21条は人間の尊厳を保証します"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415154
    m_Localized: "Provocateur: ですから 態度を改め\n私に敬意を払うよう 強く推奨します\n不愉快な事態になる前に…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415155
    m_Localized: 'Provocateur: なんて世界に生きているのでしょう…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415156
    m_Localized: もう諦めて もらえません？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415157
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415158
    m_Localized: "Provocateur: まだ待っているのですが\nあなたが賃貸契約を締結するのを"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415159
    m_Localized: "締結するものなんて\nありませんよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415160
    m_Localized: 冗談でしょう
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415161
    m_Localized: "Provocateur: ふむ\n遺憾ですね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415162
    m_Localized: 'Provocateur: 第131条に抵触する恐れがあります'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415163
    m_Localized: 本気でイラだってきた
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415164
    m_Localized: "法律を引き続けて\n気疲れしませんか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415165
    m_Localized: "Provocateur: ご参考までに言っておきますと\n第131条によれば契約は義務です\n私は責任ある市民です\nよって法の遵守を求めます"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415166
    m_Localized: 本気でイラだってきた
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415167
    m_Localized: "法律を引き続けて\n気疲れしません？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415168
    m_Localized: "Provocateur: ああ 出ましたね\n侮辱の言葉が"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415169
    m_Localized: "Provocateur: それは 念のため言っておきますが\n行政規則 第5条 第61項に違反します"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415170
    m_Localized: "Provocateur: どうぞ続けてください\nぜひとも\nいずれ すべて あなたに返ってきます"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415171
    m_Localized: "Provocateur: いえ\n法律や憲法の引用は気苦労しません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415172
    m_Localized: "Provocateur: 私は自分の権利を熟知しています！\nあなたが無知蒙昧だからといって\n他人の権利侵害が許されるわけでは\nありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415173
    m_Localized: "Provocateur: そして前にも言いましたよね！\n改めて 私には敬語で接してください"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415174
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415175
    m_Localized: 'Provocateur: 本当に学ばない人ですね？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415176
    m_Localized: 'Provocateur: なんて世界に生きているのでしょう…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415177
    m_Localized: 今度はなんです？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415178
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415179
    m_Localized: "Provocateur: たまたま銃器の所持を確認しました\n免許を提示してもらえますか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415180
    m_Localized: 関係ないでしょう
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415181
    m_Localized: なにか問題でも？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415182
    m_Localized: "Provocateur: ほう なるほど\n提示できないということは\n免許を持っていないのですね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415183
    m_Localized: "Provocateur: 銃を持っているから\n自分が法だと考えているのですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415184
    m_Localized: "Provocateur: 自分は他人を尋問可能で\n疑われることなど ありもしないと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415185
    m_Localized: 'Provocateur: 大いなる誤解です！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415186
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415187
    m_Localized: "Provocateur: よく言うでしょう\n「上には上がいる」ものです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415188
    m_Localized: "もういい\nそれどころじゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415189
    m_Localized: ふざけるのは やめろ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415190
    m_Localized: "Provocateur: 私は見極めようとしているだけです\nあなたの本性を"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415191
    m_Localized: "Provocateur: 身構えるとは…図星のようです\n無免許ですね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415192
    m_Localized: 'Provocateur: 自分は法の外にいると考えていますね'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415193
    m_Localized: "Provocateur: 自分は他人を嗅ぎ回れると\nそう思っているのでしょう\n誰に見張られることもなく"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415194
    m_Localized: 'Provocateur: 誤解しています'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415195
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415196
    m_Localized: "Provocateur: よく言うでしょう\n「上には上がいる」ものです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415197
    m_Localized: "もういい\nそれどころじゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415198
    m_Localized: ふざけるのは やめろ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415199
    m_Localized: "Provocateur: おっと お気の毒に 哀れで当然です\n誰も疑う勇気はありません\nあなたが来訪者か確かめる勇気など\nなんて辛い立場なのでしょう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415200
    m_Localized: "Provocateur: では 誰が生き 誰が死ぬか決める権利を\n誰が あなたに授けたのでしょうか？\n誰が 権限を与えたのでしょうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415201
    m_Localized: "Provocateur: 私たちは皆 座って祈るのみです\n次なる抹殺対象に選ばれないように と\nそれで 同情を求めるのですか？私に？\nご冗談を"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415202
    m_Localized: "Provocateur: おっと 言葉が過ぎました\nあなたが他人に偽りの検査を\n吹き込んでいるような口ぶりでした"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415203
    m_Localized: "Provocateur: 嗅ぎ回り 検査して\n他人を潜在的 殺人者 扱いです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415204
    m_Localized: "Provocateur: ですが 本物の殺人鬼を指差すのは\nよしておきましょう\nもしかすると…そもそも存在しない\nのかもしれません 来訪者など"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415205
    m_Localized: "Provocateur: では あなたは何者でしょうか？\n一人の狂人に過ぎません…\n地位を濫用し 混乱を悪用し\n血の渇きを満たす狂人"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415206
    m_Localized: "Provocateur: では人々は？\nラジオで騒動を耳にし\nあなたの玄関口に群がるのです\n糞にたかる蠅のように"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415207
    m_Localized: "Provocateur: 教えてください\nここへ最初に避難してきた人々のうち\n実際に生きて帰ったのは何人ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415208
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415209
    m_Localized: 'Provocateur: やはり 思ったとおりでしたね'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415210
    m_Localized: 'Provocateur: なんて世界に生きているのでしょう…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415211
    m_Localized: "まだ\nいらっしゃったんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415212
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415213
    m_Localized: "Provocateur: 驚くべきことですね…\nあなたが敬意を払うとは"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415214
    m_Localized: "Provocateur: 残念ながら\nいささか遅きに失しましたね\nすぐに通報します"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415215
    m_Localized: なにを通報するんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415216
    m_Localized: 誰に ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415217
    m_Localized: "Provocateur: もう謀ることはできませんよ\nあなたの正体は把握ずみです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415218
    m_Localized: "Provocateur: ここは あなたの家ではありません\n元の所有者を殺害し\n身分を偽っていますね\nFEMAへ連絡を取ります"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415219
    m_Localized: "Provocateur: そうです\nあなたはFEMAに追い詰められます"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415220
    m_Localized: ふざけるな
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415221
    m_Localized: もう黙らせるしかないな
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415222
    m_Localized: "Provocateur: Federal Emergency\nManagement Agency\n（連邦緊急事態管理庁）\n略してFEMAにです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415223
    m_Localized: "Provocateur: 最初は そう気に留めていませんでした\nあなたが単純な契約書ひとつ\n満足に用意できないことぐらい"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415224
    m_Localized: "Provocateur: ですが 会話を重ねるうち\n確信に変わりました"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415225
    m_Localized: "Provocateur: すべての辻褄が合いました\nここは あなたの家ではありません\nあなたは身分を偽っています"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415226
    m_Localized: 'Provocateur: あなたこそ来訪者です！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415227
    m_Localized: "Provocateur: では 荷造りを\nFEMAが やってきますから\n今夜にでも！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415228
    m_Localized: ふざけるな
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415229
    m_Localized: もう黙らせるしかないな
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415230
    m_Localized: "Provocateur: ええ 通報しますとも\nFEMAは来ます\n待っていなさい"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415231
    m_Localized: "もういい\n出ていけ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415232
    m_Localized: "死ぬぞ\n（銃を構える）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415233
    m_Localized: 'Provocateur: ならば 口を塞いでみなさい'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415234
    m_Localized: "Provocateur: 待て なんです！？\n正気ですか！？\n重犯罪ですよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415235
    m_Localized: "Provocateur: いえいえいえ\nこれはもう逃れられませんよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609280
    m_Localized: "Provocateur: ここに いさせてもらいますよ\nFEMAが到着するまでは"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609281
    m_Localized: "Provocateur: 洗いざらい報告します\nあなたが なにをしてきたか\nどれほど危険な人物か"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609282
    m_Localized: "Provocateur: 待て なんです！？\n正気ですか！？\n重犯罪ですよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609283
    m_Localized: 'Provocateur: やめなさい！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609284
    m_Localized: "撃たれる前に\n出て行くんだな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609285
    m_Localized: "撃つぞ\n出ていかないと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609286
    m_Localized: "こうするしかない\nお前のせいでな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609287
    m_Localized: （撃つ）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609288
    m_Localized: "Provocateur: FEMAからは逃れさせませんよ\nこの命に代えてでも！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609289
    m_Localized: 'Provocateur: 必ずや あなたは捕まるでしょう！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609290
    m_Localized: 'Provocateur: あなたの せいでしょう！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609291
    m_Localized: "Provocateur: この来訪者！\n殺人鬼！\nお前なんて人間じゃない！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609292
    m_Localized: "Provocateur: やめろ！\nやめてくれ！！！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609293
    m_Localized: 'Provocateur: ああぁぁっ！！！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609294
    m_Localized: "Marauder: ああ…\n堅いブツがありゃ最高なんだが"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609295
    m_Localized: 漁り屋の調子は どうです？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609296
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609297
    m_Localized: "Marauder: いや 聞いてくれよ\nここ空き家だと思ったからよ\nこっそり忍び込もうとしたんだ…\nそしたら 人が住んでんじゃねえか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609298
    m_Localized: 'Marauder: 俺 生きてる奴からは盗らねえのよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609299
    m_Localized: "Marauder: でもよ…考えてもみろよ\n死んだ奴がコート着てたって\nしょうがねえだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609300
    m_Localized: "Marauder: もう逝って 残ってんのは持ちモンだけ\nで 俺は まだ生きてんだろ？\nそいつが命を救うかもしんねえワケだ\n俺か 大事な別の誰かのな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609301
    m_Localized: "Marauder: なあ 愛する誰かを救うためなら\n死体から かっぱらうぐらい すんだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609302
    m_Localized: "Marauder: それによ 死んだ連中を神聖視すんの\nもう よしたほうがいいんじゃねえかな\nいや 言ってみた だけだぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609303
    m_Localized: "Marauder: ああ…\n堅いブツがありゃ最高なんだが"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609304
    m_Localized: どうして漁り屋に なろうと？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609305
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609306
    m_Localized: "Marauder: 他に どうしろってんだよ？\n他人を傷つけたきゃねえのよ 俺は"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609307
    m_Localized: 'Marauder: だから 静かな道を選んだ ってワケ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609308
    m_Localized: "Marauder: 死人は反撃してこねえだろ？\n持ちモンだって…ただの残りモンだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609309
    m_Localized: "Marauder: 誰かを傷つけたくて来たワケじゃねえ\nただ生き延びたくて やってんだ\nついでに 何人か助けられるかもだしな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609310
    m_Localized: "Marauder: ああ…\n堅いブツがありゃ最高なんだが"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609311
    m_Localized: "これまでの漁り屋家業で\nどんなものに出くわしました？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609312
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609313
    m_Localized: "Marauder: そうだな\n見てきたモン多すぎてな…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609314
    m_Localized: 'Marauder: ちょいと 考えさせてくれ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609315
    m_Localized: "Marauder: 前に 廃墟化した図書館を見つけたんだ\n棚には本がホコリまみれで並んでた\nまるで誰かが取りに戻るみてえにな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609316
    m_Localized: "Marauder: 新人絵画展に迷いこんだこともあんな\n絵画が吊るされっぱなしだった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609317
    m_Localized: "Marauder: そんでな…一度 夕焼けを見たんだ\n普通の夕焼けじゃねえぞ…\n空に絵の具で描かれたみてえなのをだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609318
    m_Localized: "Marauder: 今じゃ 誰も危険を冒してまで\n立ち止まった空を見上げたりしねえ\nでも あの頃は…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609319
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609320
    m_Localized: "Marauder: あの頃が恋しいよ\n朝早く目覚めるとよ 通りは静かで\n霧が低く流れて 草は露に濡れてた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609321
    m_Localized: "Marauder: で 太陽が…なあ 明るく昇ってくんだ\n輝ける一日を約束してくれるみてえに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609322
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609323
    m_Localized: "Marauder: 今じゃ どうだよ\n太陽は敵扱いだ\nどうして こうなっちまったんだかな？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609324
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609325
    m_Localized: "Marauder: このクソみてえな状況に\n誰か答えを出してくれりゃなあ\nちったあ 息もしやすくなるだろうによ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609326
    m_Localized: "Marauder: ああ…\n堅いブツがありゃ最高なんだが"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609327
    m_Localized: もう漁り屋は終わりですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609328
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609329
    m_Localized: "Marauder: まだ やってるよ\nけどよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609330
    m_Localized: "Marauder: 一度だけ…ああ\n一度だけ マジで参っちまってな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609331
    m_Localized: "Marauder: とある家を見つけたんだ\nもぬけの殻で 床に死体が転がってた\nお決まりのヤツで 別段 危なくなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609332
    m_Localized: "Marauder: 男の背は あちこち穴だらけでよ\nなにかの上に倒れてたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609333
    m_Localized: "Marauder: 俺は思ったね\nなにか隠そうとしたに違えねえ って\n近づいて ひっくり返すと…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609334
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609335
    m_Localized: "Marauder: 悪い また今度でいいか？\nまだ 思い出す覚悟がねえんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609336
    m_Localized: "Marauder: ああ…\n堅いブツがありゃ最高なんだが"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609337
    m_Localized: "死体の下には\nなにがあったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609338
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609339
    m_Localized: 'Marauder: わかったよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609340
    m_Localized: "Marauder: ひっくり返したんだ\nそしたら 女がいたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609341
    m_Localized: "Marauder: 小さな女の子がな\n死んでたよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609342
    m_Localized: "Marauder: 大人ならよ…まあ 覚悟してたよ\nでも 子供だぞ？\n話が別だろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609343
    m_Localized: "Marauder: 子供が死んでるのを見るとよ\n喉が詰まんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609344
    m_Localized: "Marauder: 少女は子猫の ぬいぐるみを抱いてたよ\n抱き締めてた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609345
    m_Localized: "Marauder: 血まみれだった\n全身"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609346
    m_Localized: "Marauder: 固いツラしてよ…\nテメエが死ぬのを覚悟してるみてえに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609347
    m_Localized: "Marauder: 一瞬\n怯えてるように見えたんだ\n俺にオモチャを取り上げられるのを"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609348
    m_Localized: "Marauder: 死んでなお\nこの娘は人間の醜さから逃れられない\nそんな感じだった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609349
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609350
    m_Localized: "Marauder: 打ちのめされたよ\n受け止めきれねえぐれえに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609351
    m_Localized: "Marauder: あの日 やめたくなった\n死者を安らかに しておきたくなった\nでも もう手遅れなんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609352
    m_Localized: "Marauder: 俺に できんのは続けることだけだ\n漁り続けることだけ\nそれしか俺が生きる道はねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609353
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609354
    m_Localized: "Marauder: 運命からは逃れられない\nそう うそぶくヤツもいる\nマジで そうなんだろうな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609355
    m_Localized: "GraveDigger: あいつら あの来訪者ども\nさっさと地下に戻ってくれりゃな…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609356
    m_Localized: なぜ墓掘りに？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609357
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609358
    m_Localized: "GraveDigger: うん？ああ そんなことか？\nなんでだかな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609359
    m_Localized: "GraveDigger: 墓地ってまるで…図書館みてえだろ？\nでも こっちの本は読めねえんだ…\nただ横たわってるだけだ 静かに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609360
    m_Localized: "GraveDigger: 昔は全部の墓を覚えてたよ\nどこに誰が埋まってるか\n手の曲がり具合や 着てた服\n名前だって…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609361
    m_Localized: "GraveDigger: でも ある日 新しい穴を掘り返してた\nいつもの一日で なんの変哲もなかった\n充分な深さになったとこで…\nバン！空っぽだった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609362
    m_Localized: "GraveDigger: マジで空だったんだ！\nでも 書類には誰か埋まってる って"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609363
    m_Localized: "GraveDigger: その男 確かに死んでたはずなんだ\n口髭を蓄えてた 間違いねえ\nでも ボン！消えちまった\n朝露みてえに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609364
    m_Localized: "GraveDigger: でよ…死んだ人間が消えちまったら…\nもう一回 死ぬってことなのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609365
    m_Localized: "GraveDigger: あいつら あの来訪者ども\nさっさと地下に戻ってくれりゃな…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609366
    m_Localized: "空っぽの墓を見つけて\nどうしたんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609367
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609368
    m_Localized: "GraveDigger: 待て待て…腰抜かしたよ\n縁に座って覗くと…なんも なかった\nでも 顔を上げたら遠くに…誰かいた\n向こうで立って 見てた 葬式みてえに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609369
    m_Localized: "GraveDigger: 両目がなかった\nだのに 歯は死ぬほど真っ白だった\n光らせて 笑ってた\nただ彼方に 立ち尽くしてた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609370
    m_Localized: "GraveDigger: マジで チビりそうになった\n嘘じゃねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609371
    m_Localized: "GraveDigger: 逃げたよ 速攻で\n俺の得意だからな\nだが 奴は追ってこなかった\nただ…消え失せてた 煙みてえに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609372
    m_Localized: "GraveDigger: クソ ヤベえ出来事だった…\nそれからだよ\nこの来訪者騒ぎが始まったのは…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609373
    m_Localized: "GraveDigger: あいつら あの来訪者ども\nさっさと地下に戻ってくれりゃな…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609374
    m_Localized: "もう誰も死体を埋めないのに\n墓を掘る意味があるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609375
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609376
    m_Localized: "GraveDigger: もう掘っちゃいねえよ\nただ…目を光らせてるだけだ\nでも あの頃な？騒ぎの後だけどよ？\n新しい穴を つつき回ってたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609377
    m_Localized: "GraveDigger: マジ慎重にな\nおかしなマネはしてねえよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609378
    m_Localized: "GraveDigger: ひょっとして 間違えて\nあの人でなしども 埋めてねえか って\nシャベルを剣みてえに構えて\nなんか動いたら ぶっ叩くつもりで"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609379
    m_Localized: "GraveDigger: でもよ…骨は みんな ちゃんと揃ってた\n死体も じっとしてた\nなんも這い出して こなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609380
    m_Localized: "GraveDigger: 考えちまった…\n蘇ってんのは 土の下にいる奴じゃねえ\n葬られるはずが 埋められなかった奴…\nそいつらが来訪者なんじゃねえか って"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609381
    m_Localized: "GraveDigger: あいつら あの来訪者ども\nさっさと地下に戻ってくれりゃな…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609382
    m_Localized: "新しい墓を掘り返したり\nしてませんよね？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609383
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609384
    m_Localized: "GraveDigger: 俺がか！？なわけねえだろ！\nバカじゃねえんだから\nほら…俺 死体のそばで生きてきたろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609385
    m_Localized: "GraveDigger: 昔はよ 死なんて なんでもなかった\n死んじまったら埋められる それだけだ\nでも今は？誰が埋めてくれんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609386
    m_Localized: "GraveDigger: それに 誰かが埋めてくれたとして\n地中で じっとしてられんのか？\n俺が絶対に埋めたはずの墓だって…\n空っぽだったんだぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609387
    m_Localized: 'GraveDigger: でも この手で埋めたはずなんだ！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609388
    m_Localized: "GraveDigger: それで考えちまうんだ…\n俺の墓も空っぽになるんじゃねえかと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609389
    m_Localized: "GraveDigger: ひょっとしたら…\nもう俺は来訪者なんじゃ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609390
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609391
    m_Localized: "GraveDigger: いや…忘れてくれよ\nただの世迷い言だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609392
    m_Localized: "GraveDigger: あいつら あの来訪者ども\nさっさと地下に戻ってくれりゃな…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609393
    m_Localized: "来訪者はどこから\n来たと思います？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609394
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609395
    m_Localized: "GraveDigger: ダンナも経験あんだろ…\nあいつら クソ見覚えねえか？\n顔だけじゃねえ…記憶のどこかに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609396
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609397
    m_Localized: "GraveDigger: 仮説があんだ\n聞く気あっか？\nあんなら 話すぞ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609398
    m_Localized: 'GraveDigger: 来訪者は多分…死者じゃねえ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609399
    m_Localized: "GraveDigger: 恐らく 思い そのものなんだ\n俺たちが埋めなかった思考だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609400
    m_Localized: "GraveDigger: 恐怖 後悔 忘れちまった連中\n手放せなかった感情\nそういうモンが溜まっていって…\n地中で あんまり静かになると 這い出る"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609401
    m_Localized: "GraveDigger: 求めてんのは 肉じゃねえ\n求めてんのは 関心だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609402
    m_Localized: "GraveDigger: だから 怖がるほど…近づいてくんだ\nだってよ 連中を思い出すだろ\n思い出されたモンは…生きたがんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609476
    m_Localized: "Intruder: なあ…\n来訪者は夢を見るんだろうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609477
    m_Localized: ちゃんと眠れました？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609478
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609479
    m_Localized: "Intruder: ん？いや\n別に眠ろうともしなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609480
    m_Localized: "Intruder: ここの誰かが\nまだ夢を見てくれればいい\n俺の望みは それだけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609481
    m_Localized: 'Intruder: けど…誰も夢の話を聞かせてくれない'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609482
    m_Localized: 'Intruder: 俺が信用ならないのかもな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609483
    m_Localized: 'Intruder: 時が経てば打ち解けるかな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609484
    m_Localized: "Intruder: なあ…\n来訪者は夢を見るんだろうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609485
    m_Localized: "何故 そう夢に\n執着するんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609486
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609487
    m_Localized: 'Intruder: 俺が執着してると？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609488
    m_Localized: 'Intruder: 妙な決めつけだな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609489
    m_Localized: "Intruder: そっちこそ まるで興味ないとでも？\n無意識が なにを語ろうとしてるのか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609490
    m_Localized: "Intruder: 頭の中に なにか隠してるだろ？\n俺たち みんな 自分に隠し事してるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609491
    m_Localized: "Intruder: たとえば お前だって\n他人を避けてるのは\nなにかが壊れたからだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609492
    m_Localized: 'Intruder: だからこそ 俺は気になるんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609493
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609494
    m_Localized: "Intruder: なあ？\n最後に見た夢を教えよう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609495
    m_Localized: 'Intruder: 巨大で黒い列車に追いかけられるんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609496
    m_Localized: "Intruder: 足は地面に根を張ったように動かない\n叫んで 目が覚める"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609497
    m_Localized: "Intruder: 俺は線路の上に立っていて…\n列車を運転してるのも 俺だった\n自分自身に突っ込んでいくんだ\n止められずに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609498
    m_Localized: "Intruder: なあ…\n来訪者は夢を見るんだろうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609499
    m_Localized: "あなたはどうなんですか？\n夢に なにを隠してるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609500
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609501
    m_Localized: 'Intruder: 俺だと？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609502
    m_Localized: 'Intruder: 何日も寝てないからな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609503
    m_Localized: "Intruder: でも いいさ\nひとつ教えよう\nどうせ誰も信じやしない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609504
    m_Localized: "Intruder: 俺には見えるんだ\n他人の夢が\nかなり…面白い"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609505
    m_Localized: 'Intruder: 理由は不明だ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609506
    m_Localized: "Intruder: だが この すべてが始まってから\n夢は…なりを潜めた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609507
    m_Localized: 'Intruder: 誰一人 呼吸してないかのように'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609508
    m_Localized: 'Intruder: それで 眠れなくなったんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609509
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609510
    m_Localized: "Intruder: さあ 飲み込めたか\n俺は 真実を打ち明けてるのか\nお前の頭を かき乱したいだけか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609511
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609512
    m_Localized: 何者なんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609513
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609514
    m_Localized: "Cultist1: 迷える魂だ\nこの惨憺たる地上に生きる\nありとあらゆる他の人間と同じくな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609515
    m_Localized: "Cultist1: 己ら 安寧と静謐を渇望する者\nそして為す術を知る者…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609516
    m_Localized: 'Cultist1: 大いなる死…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609517
    m_Localized: "Cultist1: 何故 人は彼女を恐れる？\n未知だからか？\nあるいは 宗教が刷り込んできた\n罰だからか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609518
    m_Localized: "Cultist1: 幾千年 人は生の意味を探してきた\nだが答えは極めて 実に極めて\n単純なものだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609519
    m_Localized: "Cultist1: 大いなる死こそ 己らが目的だ\n己らは彼女の信徒だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609520
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609521
    m_Localized: なぜ死など崇めるのです？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609522
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609523
    m_Localized: 'Cultist1: 大いなる死こそ 慈悲の化身だからだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609524
    m_Localized: "Cultist1: 己ら皆 彼女を恐れる\nだが 恐怖は正しいだろうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609525
    m_Localized: "Cultist1: 考えてみよ…\n己らが世界は楽園にあらず\n苦悩 与える煉獄に過ぎん\nさすれば疑問が燃え上がる 何故？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609526
    m_Localized: "Cultist1: あまりの恐怖 苦痛 困難…\n己らに平穏は望むべくもないのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609527
    m_Localized: "Cultist1: 大いなる死こそ 楽園なのだ\n己らの理解を超越した"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609528
    m_Localized: "Cultist1: 宗教は天国の単純な図式化を試みる\nそのほうが人々は理解しやすい\nだが 生とは かくも単純なものか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609529
    m_Localized: "Cultist1: 大いなる死も また同様\n触れてみなければ 理解しようがない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609530
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609531
    m_Localized: "どうしてウチを\n選んだんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609532
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609533
    m_Localized: "Cultist1: 君の家は 大いなる死と結びついている\n他の如何なる場所よりも"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609534
    m_Localized: "Cultist1: はじめ 師が何故この地を選んだのか\n理解が及ばなかった\nだが今では判然としている"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609535
    m_Localized: "Cultist1: 壁に 大いなる死の痕跡がある\n目には見えずとも 明白だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609536
    m_Localized: "Cultist1: 剥き出しのコンクリートには\nこぼれた血の臭いが染みついている"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609537
    m_Localized: "Cultist1: 己らが君に故意の殺人を求めていると\n考えているならば さにあらず\n言わずとも すでに君は命を奪っている"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609538
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609539
    m_Localized: "Cultist1: 君と大いなる死の結びつきは\n己らの誰よりも強固に感じられる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609540
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609541
    m_Localized: "外で燃やしている\n焚火は なんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609542
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609543
    m_Localized: 'Cultist1: 時は満ちた'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609544
    m_Localized: "Cultist1: 地底の天使に己らが灰を捧げ\n大いなる死の領域への門を開けさせん"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609545
    m_Localized: 'Cultist1: これぞ 彼女の恩寵を得る術なのだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609546
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609547
    m_Localized: "怯えていますね\n不安でも？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609548
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609549
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609550
    m_Localized: 'Cultist2: ご明察です 家主様'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609551
    m_Localized: "Cultist2: 信仰を共にする同胞と異なり…\n僕は まだ恐怖に もがいています"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609552
    m_Localized: "Cultist2: 疑念に苦悩しているのです\n生の果てに なにがあるのでしょう？\nなにを感じるのでしょう？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609553
    m_Localized: "Cultist2: 導師の教えによれば\n天国も地獄もなく 別のなにかが あると\nですが 私には想像も つかないのです…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609554
    m_Localized: "Cultist2: 師すら大いなる死に\n通暁していないならば\n真に把握する日は来るのでしょうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609555
    m_Localized: "Cultist2: 触れるだけでは足りないとしたら？\n彼女は理解を超越した存在だとしたら…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609556
    m_Localized: "Cultist2: ですが 師の意志に疑いはありません\n師の瞳には 確信と叡智が宿っています"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609557
    m_Localized: "Cultist2: 信仰と決意を抱けと 師は求めます\n覚悟を整えるように"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609558
    m_Localized: "Cultist2: そうしてはじめて\n屍山血河を越え\n彼女に たどり着けるのです…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609559
    m_Localized: 'Cultist2: 大いなる死に'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609560
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609561
    m_Localized: なぜ死など崇めるのです？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609562
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609563
    m_Localized: "Cultist2: お願いします 優しき家主様\n大いなる死を口にする際は\n敬意を お忘れなきよう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609564
    m_Localized: "Cultist2: 彼女は不当を嘆く冒涜者を軽蔑し\n最も厳しく罰します"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609565
    m_Localized: "Cultist2: 彼女の本質が恐ろしいのです\nですが 導師は言います\n大いなる死こそ最も優しき神であると"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803584
    m_Localized: "Cultist2: 彼女は飢餓も疫病も戦争も もたらさず\nただ…安寧を授けます"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803585
    m_Localized: "Cultist2: ですから 見つけねばならないのです\n彼女を"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803586
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803587
    m_Localized: "どうして死を見つけるのに\nそう熱心なんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803588
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803589
    m_Localized: "Cultist2: この旅路は 僕らの選択ではありません\n大いなる死 自らの意志です"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803590
    m_Localized: "Cultist2: 僕らは呼ばれているのです\n彼女の領域へと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803591
    m_Localized: "Cultist2: 師は言います\nそれ故 太陽は今 かくも強く燃え盛り\n人々を地表から追い払っているのだと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803592
    m_Localized: "Cultist2: 大いなる死は もたらします\n静寂と平穏と結束を\n彼女の領地で 再び結ばれるのです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803593
    m_Localized: "Cultist2: 死者を悼もうと無意味です\nなぜならば いつの日か\n再会するのですから"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803594
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803595
    m_Localized: "なにを計画して\nいるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803596
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803597
    m_Localized: 'Cultist2: 時は来ました…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803598
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803599
    m_Localized: "Cultist2: 怖いです…体の震えが止まりません…\nですが 信仰と決意を抱かないと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803600
    m_Localized: "Cultist2: 師が僕を信じるのです\n失望させたく ありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803601
    m_Localized: "Cultist2: けれど 恐怖が…\n恐怖が頭を離れません…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803602
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803603
    m_Localized: 'Cultist2: 行かせてください'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803604
    m_Localized: "Cultist2: 行かせてください\n行かせてください！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803605
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803606
    m_Localized: "どれぐらい滞在する\n予定ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803607
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803608
    m_Localized: "Cultist3: 心配ご無用 ご当主\nご迷惑は おかけしません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803609
    m_Localized: "Cultist3: ご厚意に感謝しております\n怒りを買う真似など いたしません\nすでに 充分していただいてますから"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803610
    m_Localized: 'Cultist3: 私どもは この部屋で静かに祈ります'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803611
    m_Localized: "Cultist3: しばし休息が必要なのです\n私どもの旅路は\n長く険しいものになります故"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803612
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803613
    m_Localized: どこへ向かうんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803614
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803615
    m_Localized: 'Cultist3: 外つ人の地です'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803616
    m_Localized: "Cultist3: 人の生は永遠では ありません\nこの地上における一時の客です\nやがては去る定め"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803617
    m_Localized: "Cultist3: 外つ人が この地を奪い\n住み着くのです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803618
    m_Localized: "Cultist3: 外つ人の出現は 偶然ではありません\n同じ呼び声が 私どもを遠ざけ…\n外つ人を招き寄せたのです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803619
    m_Localized: 'Cultist3: 大いなる死の召喚によって…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803620
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803621
    m_Localized: 死が来訪者を招いたと？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803622
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803623
    m_Localized: "Cultist3: 大いなる死は区別しない故\n人と獣と 外つ人とを…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803624
    m_Localized: "Cultist3: 大いなる死は万物に隔てなく\n彼女を前にして万物は平等です"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803625
    m_Localized: "Cultist3: 然るべき時を待ち続けています\nそして今や 時は間近です"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803626
    m_Localized: 'Cultist3: 私どもも 儀式の支度を始めねば…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803627
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803628
    m_Localized: "どんな儀式を計画して\nいるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803629
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803630
    m_Localized: "Cultist3: 移り住む時が訪れました\n我らが住処を変える時が"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803631
    m_Localized: "Cultist3: 大いなる死のもとへ赴かねば\n永久なる安寧と静謐の領域へ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803632
    m_Localized: 'Cultist3: 旅立ちの時です…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803633
    m_Localized: "FatalDame: ねえ あなた？\nなにか気になるの？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803634
    m_Localized: ここは気に入りました？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803635
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803636
    m_Localized: "FatalDame: 落ち着くわ\n思ったよりね…\n今の状況を考えれば"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803637
    m_Localized: "FatalDame: 入れてくれて ありがとう\n夜明けまで路頭を迷うところだった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803638
    m_Localized: "FatalDame: あなたは？\nどんな調子？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803639
    m_Localized: 不安だ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803640
    m_Localized: "大丈夫だ\n生き延びないと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803641
    m_Localized: 'FatalDame: わかるわ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803642
    m_Localized: "FatalDame: 今どき…\n四ヶ月も先の予定を立てるなんて\n無意味よね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803643
    m_Localized: "FatalDame: なにに襲われるかすら わからないもの\n太陽か 異常者か 来訪者か"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803644
    m_Localized: "FatalDame: でも 人間も 地球だって\n何度も災害を乗り越えてきた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803645
    m_Localized: 'FatalDame: きっと なにかは残せるはず'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803646
    m_Localized: 'FatalDame: 誰かが あたしたちの痕跡を見つける'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803647
    m_Localized: 'FatalDame: きっと 大丈夫'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803648
    m_Localized: "FatalDame: その態度\nあなたらしくて いいわね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803649
    m_Localized: "FatalDame: でも 抱え込まないで\n感情って 不意に 溢れるものだから…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803650
    m_Localized: 'FatalDame: …それも 最悪の時に'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803651
    m_Localized: "FatalDame: 恥ずかしがらずに\n話してちょうだい"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803652
    m_Localized: "FatalDame: あたしじゃダメなら 他の人に\n誰だって"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803653
    m_Localized: "FatalDame: それだけは約束して\nいい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803654
    m_Localized: "FatalDame: ねえ あなた？\nなにか気になるの？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803655
    m_Localized: 昨夜 奇妙なものを見ました
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803656
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803657
    m_Localized: "FatalDame: ん？\nなんの話？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803658
    m_Localized: "あなたの お腹\n大きくなってます"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803659
    m_Localized: なにか見た気が
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803660
    m_Localized: 'FatalDame: それ…妊娠してる ってこと？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803661
    m_Localized: "FatalDame: なら 大丈夫\n打ち明けてくれて嬉しいわ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803662
    m_Localized: "FatalDame: そう感じるのは\n他人に責任を負うのが怖いからでしょ\n今は"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803663
    m_Localized: "FatalDame: わかるわ こんな時代だもの\n毎朝が最後の夜明けかもしれない…\n自分事だけで精一杯なのに\n他人を気にかける余裕なんてない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803664
    m_Localized: 'FatalDame: 明日 生きていられるかも わからない'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803665
    m_Localized: "ええ…\nそれが怖いんです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803666
    m_Localized: "いえ\nそうではありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803667
    m_Localized: "FatalDame: でも なにかしら\n心に引っかかってるんでしょ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803668
    m_Localized: "FatalDame: それでいいの\n誰だって 恐怖には磨り減るものよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803669
    m_Localized: "FatalDame: あたしは あなたを見てる\n夜中に起きて 見回りする あなたを"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803670
    m_Localized: "FatalDame: なにもしてない わけじゃない\n人を拒む癖に 入れた人を気にかけてる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803671
    m_Localized: "FatalDame: …面白い人\n歩く矛盾ね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803672
    m_Localized: "FatalDame: それか ただの不眠症か\n恐怖って 一緒に寝るのに最悪の相手ね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803673
    m_Localized: "ええ…\n怖いんです"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803674
    m_Localized: "いえ\nそうではありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803675
    m_Localized: 'FatalDame: そう口に出せるのは 勇気の証拠よ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803676
    m_Localized: "FatalDame: でも 恐怖って 本当に\nどう付き合えば いいのかしらね？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803677
    m_Localized: "FatalDame: 受け入れられる？\n…こんな終わり方\nあたしたち みんな 死ぬのよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803678
    m_Localized: "FatalDame: 大切なのは\nどこに救いを見出すかじゃない？\nそもそも まだ存在するのかしら？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803679
    m_Localized: 'FatalDame: そう'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803680
    m_Localized: "FatalDame: どちらにせよ…あなたが心配\n自分の声に耳を傾けてね？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803681
    m_Localized: "FatalDame: あなたには安心してほしいの\n同じ屋根の下に暮らす仲だものね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803682
    m_Localized: "FatalDame: でも あなたの頭のネジ一本 飛んだら\nみんな 頭 吹き飛ばされちゃう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803683
    m_Localized: "FatalDame: …冗談抜きでね\nふふっ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803684
    m_Localized: 'FatalDame: 今の 気に入った？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803685
    m_Localized: "FatalDame: ねえ あなた？\nなにか気になるの？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803686
    m_Localized: "昨日の夜 お腹が膨らんでて\nどういうこと ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803687
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803688
    m_Localized: 'FatalDame: ちょっと怖いわ その言い方'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803689
    m_Localized: "FatalDame: 本当に 昨夜なにか見た って\n確信があるの？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803690
    m_Localized: 'FatalDame: どうして あたしを起こさなかったの？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803691
    m_Localized: "FatalDame: また恐怖から話してるの？\n死か…誰かを背負い込む重圧で？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803692
    m_Localized: "FatalDame: あたしのせい？\nそれとも 別の誰かが頭から離れない？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803693
    m_Localized: 頭を犯さないでくれ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803694
    m_Localized: 確かに…なにか見たんです
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803714
    m_Localized: "FatalDame: ねえ あなた？\nなにか気になるの？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803716
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713862
    m_Localized: "NotTrue: 街の生まれでね 坊や\nちんまいアパート 持ってたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713863
    m_Localized: "NotTrue: 田舎の別荘もなけりゃ\n親戚も孫もいない…\nああ 情けないもんさね…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713864
    m_Localized: "NotTrue: それで 大抵の日は\n玄関のベンチに 座ってたんだ\nそこなら ちっとは命の気配がしてね\nあれこれ耳に入るってもんさ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713865
    m_Localized: "NotTrue: けれど 騒動が起きちまって\nそれすら楽しくなくてねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713866
    m_Localized: "NotTrue: どう命を感じろってんだい？\nそこら中 死であふれかえってるのに\n蠅みたく 人が倒れ落ちていくんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713867
    m_Localized: "NotTrue: 踊り場に一歩 踏み出せば\n決まって 誰か転がってる\n白布に覆われてね"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713868
    m_Localized: "NotTrue: 天よ\nいっそ自分も消えちまいたいよ\nこんな悲しみ見てばかりなら"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713869
    m_Localized: "NotTrue: それで 外に出て 探しはじめたのさ\nまだ人がいて 物語が聞けて\n命を実感できる場所をね"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713870
    m_Localized: "NotTrue: そしたら ほら\nあんたの戸口まで 運命が導いたわけさ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713871
    m_Localized: "NotTrue: 信心深いタチじゃないけどね\nこういうときは…まるで\n主ご自身に足を運ばされた気がするよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713872
    m_Localized: "NotTrue: でもねえ\nみんなアタシのことなんか\n忘れちまってんだよ 坊や"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713873
    m_Localized: "NotTrue: まだ生きてるのが いるとしても\n誰一人 訪ねてきやしない"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713874
    m_Localized: "NotTrue: 実を言うとね アタシだけじゃないんだ\n身内に忘れられちまう人なんて\n山ほどいるもんさね…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713875
    m_Localized: "NotTrue: みんな 自分のことで精一杯だろうよ\nアタシの具合を気にして\n電話するのなんて 一人もいやしない"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713876
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713877
    m_Localized: "NotTrue: あるとき\n隣の婆が一緒にベンチに腰掛けて\n孫の自慢話を始めたんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713878
    m_Localized: "NotTrue: 「ウチのは いい子なんだよ！\n忘れず年寄りを 訪ねてくれる\n他の子とは違うんだよ」"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713879
    m_Localized: "NotTrue: 本当に いい小僧でねえ\nいつも挨拶を欠かさず\n具合を訊いてくれたよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713880
    m_Localized: 'NotTrue: ちょいと嫉妬しちまったよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713881
    m_Localized: 'NotTrue: それから 隣人に死が訪れてね…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713882
    m_Localized: "NotTrue: あの小僧…\n人が変わったみたいに 荒れちまって"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713883
    m_Localized: "NotTrue: それで気付いたよ\nあの親切は アパート目当てだったんだ\n相続を狙ってたのさ まったく…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713884
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713885
    m_Localized: "NotTrue: なんでだろうねえ\nなんで人間ってのは\nいけしゃあしゃあと ウソをつくんだか\nそれも 家族にまで"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713886
    m_Localized: "NotTrue: 結婚して 子供産んで だのに…\n信じられるかい\n愛なんて まるでないんだよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713887
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713888
    m_Localized: "NotTrue: まあ アタシは幸運だったのかもねえ\n旦那がいなくて\nあの老いぼれロクデナシ…ふん"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713889
    m_Localized: "NotTrue: ああ ウチの旦那\nもう死んでてね 坊や"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713890
    m_Localized: "NotTrue: 人生めちゃくちゃだよ\nあの老いぼれのせいで"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713891
    m_Localized: "NotTrue: アイツと結婚したのも\n親に押しつけられたからさね"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713892
    m_Localized: "NotTrue: 「あの人と結婚なさい」\nなんて言われてね\nそれで夫婦になったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713893
    m_Localized: "NotTrue: はじめは 本当に気をかけてくれたんだ\nでも 結婚の熱が冷めた途端\n腐った性根が顔を出したもんさ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713894
    m_Localized: "NotTrue: まず アタシの料理にケチつけだして\n「やかましい 食ってやってるだろ？」\nなんてさ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713895
    m_Localized: "NotTrue: 晩年は仲間と飲みにでちゃ\n何時間も消えっぱなし"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713896
    m_Localized: "NotTrue: 酔って帰ってきちゃ\nガレージでドミノやってたなんて\n嘘八百"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713897
    m_Localized: "NotTrue: 飲んだのか訊いたって\n口汚く罵られて終わり\n本当に ロクデナシだったよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713898
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713899
    m_Localized: 'NotTrue: アイツにも死が訪れてね'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713900
    m_Localized: "NotTrue: はじめは 気楽になったもんさ\nでも じきに 虚しさが忍び寄ってきた"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713901
    m_Localized: "NotTrue: 一時はテレビに救われたけど\n今じゃ 戯言ばかり…\n嘘を垂れ流すだけさね"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713902
    m_Localized: "NotTrue: それで道端に出て\nベンチに座るようになったのさ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713903
    m_Localized: 'NotTrue: おや 坊や…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713904
    m_Localized: "NotTrue: 世界が回るのを見ているうちに\nちっと気が楽になってきたんだ\n笑う子供に 手を繋いで歩く若い恋人\n小走りに駆けていく犬…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713905
    m_Localized: 'NotTrue: だのに この騒動だよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713906
    m_Localized: "NotTrue: 一人一人 家に閉じこもっていった\n夕方 外に座って 行き交う喧噪を\n眺めることも なくなっちまった"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713907
    m_Localized: "NotTrue: 窓を覗いたって\nいいことなんて なに一つなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713908
    m_Localized: "NotTrue: かつて子供が遊んでたとこには遺体袋\n野良犬が通りを うろつき\n隣人の視線も まるで他人同士"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713909
    m_Localized: "NotTrue: 命 ってもんが\n死んで止まって見えたよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713910
    m_Localized: "NotTrue: そして 今じゃ\n真実と嘘の区別すら つきやしない"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713911
    m_Localized: "NotTrue: 嘘をつくのなんて\nやめりゃいいのにねえ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083330
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471999
    m_Localized: "Fatman: おお…冷てえ水だ\nこれだこれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472000
    m_Localized: 気分は良くなりました？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472001
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472002
    m_Localized: "Fatman: おうおう\nだいぶ良くなった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472003
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472004
    m_Localized: 'Fatman: だがな…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472005
    m_Localized: "Fatman: なあ 腹が減ってきた\nなんか つまめるもん ねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472006
    m_Localized: "どうぞ\n（ビールを渡す）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472007
    m_Localized: 'Fatman: なんだよ ビールも ねえのかよ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472008
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472009
    m_Localized: "Fatman: ごまかすなよ\n冷蔵に詰まってんの見たぞ\nどうやったら そんな早さで\n飲み干せる ってんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472010
    m_Localized: ありません
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472011
    m_Localized: 'Fatman: おおっ これだこれ！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472012
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472013
    m_Localized: "Fatman: うむ うまい\nこれが一番だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472014
    m_Localized: 'Fatman: ほら カネだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472015
    m_Localized: "Fatman: （クシャクシャの紙幣を\n何枚か受け取る\n今や無価値の）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472016
    m_Localized: "まあ…\nありがとうございます"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472017
    m_Localized: "カネなんて\nどうでもいい"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472018
    m_Localized: 'Fatman: そうこねえと！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472019
    m_Localized: "Fatman: 俺の言うことを聞けば\n工場長みてえに稼げる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472020
    m_Localized: "Fatman: 使えるヤツには\nケチケチするもんか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472021
    m_Localized: "Fatman: おっと そうだそうだ…\nほら これもやろう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472022
    m_Localized: 'Fatman: （コンブチャを受け取った）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472023
    m_Localized: "Fatman: こんなもん 誰が飲むんだか\nだが 取っておけ\n役に立つかもしんねえぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472024
    m_Localized: "Fatman: どうでもいいだと？\n自分が特別とでも！？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472025
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472026
    m_Localized: "Fatman: 誰だってカネがいる！\n世界は残らず カネで回ってんだ！\nカネが いらねえだと！ったく…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472027
    m_Localized: 'Fatman: ほら こいつを持っていけ！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472028
    m_Localized: 'Fatman: （コンブチャを受け取った）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472029
    m_Localized: "Fatman: こんなもん 誰が飲むんだか\nだが 取っておけ\n役に立つかもしんねえぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472030
    m_Localized: "Fatman: なんだと？断るだと？\nカネで買えねえものなんかねえだろ！\n愛だろうが物だろうが人間だろうが…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472031
    m_Localized: "Fatman: カネが世界を回してんだ！\nそれにな？俺は大物だぞ！\n大臣だ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472032
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472033
    m_Localized: "Fatman: いいだろう 忘れろ\n助けたくねえなら 勝手にしろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472034
    m_Localized: "Fatman: おお…冷てえ水だ\nこれだこれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472035
    m_Localized: "今度は なにが\nいるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472036
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472037
    m_Localized: "Fatman: おっと よくぞ訊いてくれた！\nモクが吸いたくてな\n紙巻 一本 くれねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472038
    m_Localized: "ええ どうぞ\n（タバコを渡す）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472039
    m_Localized: 'Fatman: なんだ 紙巻も ねえのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472040
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472041
    m_Localized: 'Fatman: いいだろう 忘れろ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472042
    m_Localized: ありません
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472043
    m_Localized: 'Fatman: おおっ これだこれ！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472044
    m_Localized: "Fatman: 昔は葉巻だったんだがな もちろん…\nもう 手に入りゃしねえ\n議員やってた頃はよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472045
    m_Localized: "Fatman: ああ…あの頃は違ってた\n今じゃ 殺人 混沌\n悪夢そのものじゃねえか！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472046
    m_Localized: "Fatman: FEMAは いつになったら\n介入して 掃討するんだ？\nなんのために設立されたんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472047
    m_Localized: "Fatman: こんな惨事 俺が議会にいた頃は\n一度も起きなかったが"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472048
    m_Localized: "Fatman: とはいえ 時間が必要なのかもしれん\nいずれ自然と収束するだろうよ\n待ってりゃな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472049
    m_Localized: 議会に いたんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472050
    m_Localized: "FEMA設立に\n関わったんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472051
    m_Localized: "Fatman: ああ そうだ\nさっき言ったろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472052
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472053
    m_Localized: "Fatman: おう その通りだ\n褒美を やる！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472054
    m_Localized: "Fatman: （クシャクシャの無価値な紙幣と\nFEMAの印が押された\n奇妙な絵葉書を受け取る）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472055
    m_Localized: 'Fatman: どっから そんな話を？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472056
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472057
    m_Localized: "Fatman: おう その通りだ\n褒美を やる！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472058
    m_Localized: "Fatman: （クシャクシャの無価値な紙幣と\nFEMAの印が押された\n奇妙な絵葉書を受け取る）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472059
    m_Localized: "Fatman: なんだと！？\n俺を誰だと思ってんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472060
    m_Localized: "Fatman: 大臣だぞ！\n行政は複雑な機構で\n動かすには俺みてえのが いるんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472061
    m_Localized: "Fatman: 俺は民衆の声だ！俺がいなきゃ\nお前みてえな連中の声は 届きゃしねえ\n俺が良くして やってんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472062
    m_Localized: "Fatman: 平時なら そんな口答えできねえぞ！\nたちまち引っ張られちまうからな！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472063
    m_Localized: "Fatman: 世界が崩れつつある…\n誰も大臣の肩書きなんて気にしねえ\n俺たちが役所で指くわえて\n待ってるだけだと 思ってやがる…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472064
    m_Localized: "Fatman: ったく\n本物の地獄が口を開けたら\nどんな口を利くか 見物だな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472065
    m_Localized: "Fatman: おお…冷てえ水だ\nこれだこれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472066
    m_Localized: "また なにか\nいるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472067
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472068
    m_Localized: 'Fatman: 冴えてるじゃねえか！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472069
    m_Localized: 'Fatman: 欲しいのはな…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472070
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472071
    m_Localized: "Fatman: エナドリを くれ！\nもう ずいぶん シャキッとするもん\n飲んでねえんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472072
    m_Localized: "ほら これを\n（エナドリを渡す）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472073
    m_Localized: 'Fatman: エナジェカもねえのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472074
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472075
    m_Localized: 'Fatman: いいだろう 忘れろ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472080
    m_Localized: お気の毒に
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472081
    m_Localized: "Fatman: おおっ\nそれだそれだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472082
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472084
    m_Localized: "FEMAとは\n何者なんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472085
    m_Localized: "FEMAは なにを\n企んでるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472101
    m_Localized: "Fatman: おいおい 砂糖抜きか？\nったく"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472104
    m_Localized: "Fatman: こんなゴミより\n炭酸水のほうがマシだったろ…\n待て 今なんて？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472105
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472106
    m_Localized: "Fatman: 頭どうかしてんのか？\n教えるわけ ねえだろ\n機密事項だ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472107
    m_Localized: "Fatman: 署名したんだよ わかるか？\n秘密保持契約ってヤツだ\nお前に聞く資格はねえ 悪く思うな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472108
    m_Localized: "Fatman: ほら 代わりのコーヒーだ\nもう詮索するな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472109
    m_Localized: 'Fatman: （コーヒーを受け取った）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472110
    m_Localized: "Fatman: しかも エナジェカとはな\nなにが入ってんだか\nわかったもんじゃねえ…\n待て 今なんて？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472111
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472112
    m_Localized: "Fatman: 頭どうかしてんのか？\n教えるわけ ねえだろ\n機密事項だ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472113
    m_Localized: "Fatman: 署名したんだよ わかるか？\n秘密保持契約ってヤツだ\nお前に聞く資格はねえ 悪く思うな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472114
    m_Localized: "Fatman: ほら 代わりのコーヒーだ\nもう詮索するな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472115
    m_Localized: 'Fatman: （コーヒーを受け取った）'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472116
    m_Localized: "Fatman: なに言ってやがる？\n空腹で どう仕事しろ ってんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472117
    m_Localized: "Fatman: 俺は生活向上のために励んでんだぞ！\n民衆のために立ち上がってんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472118
    m_Localized: "Fatman: なのに お前らは批判ばかり…\nどいつもこいつも 利口なつもりだ\nなら 自分が行政に入ればいいだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472119
    m_Localized: "Fatman: そういうことだ\n口ばかりで なにも行動しやしねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472120
    m_Localized: "Fatman: おお…冷てえ水だ\nこれだこれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472121
    m_Localized: "えっ？\nまた なにか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472122
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472123
    m_Localized: "Fatman: ああ アンちゃん\nアンタの ショットガンを くれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472124
    m_Localized: えっ？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472125
    m_Localized: 頭 どうかしました？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472126
    m_Localized: 'Fatman: おう 護身用にな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472127
    m_Localized: "Fatman: 心配すんな\n昔 狩猟やっててな 扱いは慣れてる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472128
    m_Localized: 渡せません
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472129
    m_Localized: くたばれ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472130
    m_Localized: "Fatman: 口の利き方に気をつけろよ\n誰に話してるか忘れたか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472131
    m_Localized: "Fatman: その気になりゃ\n今すぐ牢に ブチ込んでやれるんだぞ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472132
    m_Localized: 渡せません
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472133
    m_Localized: くたばれ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472134
    m_Localized: "Fatman: 今 なんて言った？\n聞き間違いか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472135
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472136
    m_Localized: "Fatman: 決まりだな\nもう おしまいだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472137
    m_Localized: "Fatman: 荷物まとめとけ\nもう牢屋 行きも同然だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472138
    m_Localized: "私にとっては あなたも\n訪問客の一人に過ぎません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472139
    m_Localized: "大臣だろうと関係ない\n俺にとっちゃ 何者でもない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472140
    m_Localized: "Fatman: 正気か？\n民衆の声を相手に その口の利き方？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472141
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472142
    m_Localized: "Fatman: やらかしたな\n覚悟しとけ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472143
    m_Localized: "Fatman: 俺を怒らせるとは 大間違いだな！\n議員ってのは権力者なんだ\n知らなかったか！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472144
    m_Localized: "Fatman: まあ いい…\nすぐに従わせてやる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472145
    m_Localized: "私にとっては あなたも\n訪問客の一人に過ぎません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472146
    m_Localized: "大臣だろうと関係ない\n俺にとっちゃ 何者でもない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472147
    m_Localized: "Fatman: なに言ってやがる！？\n言葉に気をつけろよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472148
    m_Localized: "Fatman: 嘘じゃねえぞ…本気だ\n本当に牢屋 行きだからな\n見てろよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472149
    m_Localized: "Fatman: なに言ってやがる！？\n言葉に気をつけろよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472150
    m_Localized: "Fatman: 嘘じゃねえぞ…本気だ\n本当に牢屋 行きだからな\n見てろよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472151
    m_Localized: "Fatman: おお…冷てえ水だ\nこれだこれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472152
    m_Localized: "まだ牢屋へ行かずに\nすんでるようですが？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472153
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472154
    m_Localized: "Fatman: 虚仮にしてんのか？\nおい…冗談じゃねえぞ！\n本当に牢屋 行きだからな！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472155
    m_Localized: "昔 肩書きがあろうと\n今じゃ 何者でもありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472156
    m_Localized: "カネなんて もう無意味だ\nわからないのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472157
    m_Localized: "Fatman: いや…そんなはずねえ！\n俺は まだ議会所属だ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472158
    m_Localized: 'Fatman: ただ…休暇中なんだ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472159
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472160
    m_Localized: "Fatman: 誰を騙してんだか…\nもう昔には戻れねえ ってのに…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472161
    m_Localized: "Fatman: 在職中は 国中が\n俺ら大臣のために尽くしてた"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472162
    m_Localized: "Fatman: 民衆は俺を恐れ 敬った\n車は道を譲り 群衆は媚びへつらい\n誰もが取り入ろうとしてた\nなのに今じゃ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472163
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472164
    m_Localized: "Fatman: ったく\nストレスで胃が締め付けられちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472165
    m_Localized: "Fatman: これで満足か？行っちまえ\nうんざりだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472166
    m_Localized: "Fatman: ちっ 違う！\nまだカネが わんさかある！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472167
    m_Localized: "Fatman: お前には無価値かもしれねえが…\nだが 大抵のヤツにとっちゃ 話は別だ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472168
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472169
    m_Localized: "Fatman: 誰を騙してんだか…\nもう昔には戻れねえ ってのに…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472170
    m_Localized: "Fatman: もう贅沢もねえ\nリムジンもねえ 女もねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472171
    m_Localized: "Fatman: カネがあれば なんだって話は早かった\nカネさえあれば 大物だったんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472172
    m_Localized: 'Fatman: 崩壊なんて起きなきゃ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472173
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472174
    m_Localized: "Fatman: ったく\nストレスで胃が締め付けられちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472175
    m_Localized: "Fatman: これで満足か？行っちまえ\nうんざりだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173076770816
    m_Localized: "Fatman: もう話したろ\nくたびれてんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173093548032
    m_Localized: 'Fatman: 明日にしろ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054893
    m_Localized: 'BigLebowski: チッ もうウンザリ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054894
    m_Localized: どうして一人で外に？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054895
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054896
    m_Localized: "BigLebowski: まぁ…家は狭いしウルサいし\n居心地 最悪でさ\n外 出たかったんだ 世界を見にね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054897
    m_Localized: "BigLebowski: それでさ バックパックとソーダ\nスナックバーに 昔 学校で作った\n友情ミサンガ持って出たんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054898
    m_Localized: "BigLebowski: 出てったって\n親は気付きもしなかったろうね\n別に どうだっていいけどさ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054899
    m_Localized: "BigLebowski: それから ずっと放浪暮らし\n休めるとこで休んできたんだ\nぶっちゃけ？まるで大丈夫だったよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054900
    m_Localized: "BigLebowski: 少なくとも 誰にも口出しされない\nアタシのボスはアタシだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054903
    m_Localized: 'BigLebowski: チッ もうウンザリ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054904
    m_Localized: "どうやって\n生き延びたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054905
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054906
    m_Localized: 'BigLebowski: どうにかして'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054907
    m_Localized: "BigLebowski: 踊り場とか物置とか\n木陰の地面に寝転んだり\n屋根になるもんがあれば\nどこでだって日差しは避けられるだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054908
    m_Localized: "BigLebowski: 手に入るモンなら なんでも食べた\n野草とか 店から くすねた飴とか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054909
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054910
    m_Localized: "BigLebowski: なんだよ その目？ああ パクったよ\nだからなに 他にどう生きろっての？\nアタシの歳じゃ誰も雇ってくれないし\nだから自分で やるしかないんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054911
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233280
    m_Localized: "BigLebowski: はぁ 今度は なに？\nアンタから なにかパクる とでも？\nははっ 冗談だろ"
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233281
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233282
    m_Localized: "BigLebowski: なんだよ？これ尋問か なにか？\nウザいんだけど マジで"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054912
    m_Localized: 'BigLebowski: チッ もうウンザリ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054913
    m_Localized: "いつまで そんな風に\n生きるつもりですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054914
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054915
    m_Localized: "BigLebowski: アンタに関係ないだろ？\n自分で なんとかするよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054916
    m_Localized: "BigLebowski: それとも なに\nアタシが いるのが そんなに嫌？\nなんかパクった？トイレ詰まらせた？\nなんで問い詰めんだよ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054917
    m_Localized: "BigLebowski: なるほどね…\nアンタも キモいヤツ ってことか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054918
    m_Localized: "BigLebowski: 前にもいたよ そういうの\n入れてくれて 優しい口振りで\n一晩 屋根を貸してくれたヤツ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054919
    m_Localized: "BigLebowski: アニメとか映画とか あれこれ\n何時間も語り合ってさ\nやっと マトモなヤツに出会えたかとね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054920
    m_Localized: "BigLebowski: そしたら 触ろうとしてきやがった\nクソ キモかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054921
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233283
    m_Localized: "BigLebowski: なんかしてみなよ 絶対やり返すから\n誰にも傷つけさせたり しないから"
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233284
    m_Localized: "BigLebowski: オヤジが根っからのクソ野郎でさ\nでも ケンカの仕方だけは習ったよ"
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233285
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233286
    m_Localized: "BigLebowski: それだけ\n近寄んなよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054922
    m_Localized: 'BigLebowski: チッ もうウンザリ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054923
    m_Localized: "その男\nどうしたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054924
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054925
    m_Localized: "BigLebowski: なんで知りたいんだよ？\nやり返されない扱い方 探してんの？\nもう別れてんの わかってんだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054926
    m_Localized: "BigLebowski: わかってるよ アンタだって\n親切心で訊いてんじゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054927
    m_Localized: "BigLebowski: ただ自分チで 厄介事\n起こされたかないだけだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054928
    m_Localized: "BigLebowski: でも アタシは厄介者なんかじゃない\nパクってないし 窓も壊してない\nなのに疑うなよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054929
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054930
    m_Localized: 'BigLebowski: それにさ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054931
    m_Localized: "BigLebowski: アタシが必要だから 泊めてんだろ？\n半裸の来訪者に さらわれないように\nそうだよ ニュースぐらい聞いてんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233287
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233288
    m_Localized: "BigLebowski: そういうことならさ…\nはぁ 勝手にしなよ！\nキモい検査だって やればいい\nただ 話しかけんな っての"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054932
    m_Localized: 'BigLebowski: チッ もうウンザリ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054933
    m_Localized: "なぜ お父さんは\n戦い方を教えたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054934
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054935
    m_Localized: "BigLebowski: キモ野郎を ぶちのめせるように\nそれか アタシをブン殴る口実"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054936
    m_Localized: "BigLebowski: 三つぐらいの頃から訓練させられた\nスパーリングだのなんだの\n問題が一つあってさ？\nサンドバッグの代わりがアタシの顔"
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233289
    m_Localized: "BigLebowski: まぁ たまにはガチの訓練だったけどさ\nそれはそれで 嫌だったけど"
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233290
    m_Localized: "BigLebowski: ブチギレて アタシを\nボコボコにするときもあった\nオフクロ？ガン無視だよ\n見ようともしなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233291
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233292
    m_Localized: 'BigLebowski: はぁ あんなのアタシはゴメンだね'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233293
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233294
    m_Localized: "BigLebowski: そもそもさ あんな扱いすんなら\nなんでアタシを産んだワケ？\nマジ意味不明\nこれが人生ってヤツ？"
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233295
    m_Localized: "BigLebowski: しかもさ お次は太陽だの来訪者だの？\n最高だね\nなにもかも さらにクソじゃん"
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233296
    m_Localized: 'BigLebowski: いいことなんて 起きるんだか？'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233297
    m_Localized: 'BigLebowski: 怪しいもんだね'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220801
    m_Localized: 'Doctor: 聞いとるよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220802
    m_Localized: "病院は\nどうなったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220803
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220804
    m_Localized: "Doctor: おお…\n悪夢だったよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220805
    m_Localized: "Doctor: すべてが始まった途端\n病院へ人々が押し寄せてきてな\n誰もが必死で 来訪者じゃないと\n確かめたがった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220806
    m_Localized: "Doctor: 儂らは どう検査したものか\nなにも わからんでな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220807
    m_Localized: "Doctor: だが人々は耳を貸さず\n押し合いへし合い してばかり\n本当に病気の者も診れんかった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220808
    m_Localized: "Doctor: しまいにはFEMAが現れ\n人の群れは感染を\n悪化させる脅威と判断し…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220809
    m_Localized: "Doctor: それで全員 隔離区域へ移送され\n病院は…ただちに閉鎖された"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220810
    m_Localized: "ではFEMAに\n仕事を奪われたと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220811
    m_Localized: "FEMAの行いは\n過ちだったと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220812
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220813
    m_Localized: "Doctor: 実のところ…\n病院の閉鎖後 FEMAの隔離区域へ\n働きに行ってな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220814
    m_Localized: なぜ そこに？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220815
    m_Localized: "では あなたもFEMAの\n愚か者と同じですよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220816
    m_Localized: "Doctor: なら あんな風に人々を一斉に\n拘束するのが正しいと？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220817
    m_Localized: "Doctor: 「徴候」など 馬鹿げてると思わんか？\n普通の人間が持つ特徴に過ぎんのに？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220818
    m_Localized: "Doctor: 馬鹿馬鹿しい！\n歯が白いと来訪者だと？\n大概にせい"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220819
    m_Localized: "Doctor: 言わせてもらうがの\n連中 なにか隠しとる…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220820
    m_Localized: "Doctor: 実のところ…\n病院の閉鎖後 FEMAの隔離区域へ\n働きに行ってな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220821
    m_Localized: "Doctor: 来訪者や徴候について\nなにか学べるかと思ってな\nだが…なにも得られず じまいよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220822
    m_Localized: なぜ そこに？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220823
    m_Localized: "では あなたもFEMAの\n愚か者と同じですよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220824
    m_Localized: "Doctor: 人を…助け続けたくての\nそれが儂の使命でな\n見捨てるなど できるものか"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220825
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220826
    m_Localized: "Doctor: 恐らく…いや 勘弁しとくれ\nまだ 話す準備が できとらん"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220827
    m_Localized: "Doctor: 愚か者 呼ばわりは間違っとる\nお前さん 真相を知らんのだからな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220828
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220829
    m_Localized: "Doctor: 恐らく…いや 勘弁しとくれ\nまだ 話す準備が できとらん"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220830
    m_Localized: 'Doctor: 聞いとるよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220831
    m_Localized: "それで なにを\n言いたかったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220832
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220833
    m_Localized: "Doctor: よければ\nFEMAを どう思う？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220834
    m_Localized: FEMAは よくやってます
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220835
    m_Localized: FEMAは 信用なりません
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220836
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220837
    m_Localized: "Doctor: 残念だの\n儂の考えは真逆だ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220838
    m_Localized: "Doctor: しばらく連中と働いたがの\n信用できる理由はなかった\nこの目で見たからこそ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220839
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220840
    m_Localized: "Doctor: 儂の経験から見て\nあの組織の医師たちは暗中模索しとる"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220841
    m_Localized: "Doctor: 徴候の由来さえ説明できない組織を\n本当に信用すると？\nなにを示唆するのかも知らんのだぞ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220842
    m_Localized: "Doctor: だのに…\nどうしてFEMAを信用できる？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220843
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220844
    m_Localized: "Doctor: 言わせてもらうがの\nお前さんは もっと頼れる男かと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220845
    m_Localized: "Doctor: よいな\n儂も信用しとらん"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220846
    m_Localized: "Doctor: 実のところ 儂もな\nFEMAの動機を完全には理解しとらん\nしばらく共に働いてみたものの"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220847
    m_Localized: "Doctor: だが なにが原動力だろうと\n儂なりに人を助ける道を選んだ\n連中の規則に逆らっての"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220848
    m_Localized: "Doctor: 問題は透明性\n全くなかった 皆無だった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220849
    m_Localized: "Doctor: 「徴候」の由来も その意味も\n一切 説明がなくてな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220850
    m_Localized: "Doctor: 誰を来訪者と判定し 誰を通すか\nそのガイドラインを手渡されたばかり"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220851
    m_Localized: "Doctor: それからというもの 儂は医師ではなく\n単なる入国管理官の如く\n紙に判子を押す存在になってな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220852
    m_Localized: "Doctor: 報告を偽装しはじめたのよ\n人々が逃げる手助けに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220853
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220854
    m_Localized: "Doctor: まだ質問も あろうが\nよければ明日に しよう"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713912
    m_Localized: "Doctor: すまんな\n今日は 話し疲れた"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713913
    m_Localized: 'Doctor: それから 組織を去ることにした'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220855
    m_Localized: 'Doctor: 聞いとるよ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220856
    m_Localized: "どうして隔離区域を\n出ているんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220857
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220858
    m_Localized: "Doctor: それはな…\nある事件が原因で…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220859
    m_Localized: "Doctor: 太陽が昇り始めた頃\n帰宅途中にFEMA職員の一人から\n呼び止められてな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220860
    m_Localized: "Doctor: その瞬間 心臓が高鳴りだし\n膝は折れそうになった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220861
    m_Localized: "Doctor: 振り返れ と怒鳴られ\nその場で死を覚悟した"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220862
    m_Localized: "Doctor: ライフルを脚に向けられ\n動くな と言われた\n男は儂を見据え そして…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220863
    m_Localized: "Doctor: 舌を出すよう命じられた\n来訪者か調べるためだ と\n従ったよ 撃たれるのが恐ろしくて"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220864
    m_Localized: "Doctor: すると…男は笑った\n舌なんて徴候じゃないのに\nそれすら知らないヤブ医者だ と"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220865
    m_Localized: 'Doctor: あれほど恐怖を覚えたことはない'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220866
    m_Localized: "Doctor: その瞬間 命を救うことなど\n頭から消え去っとった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220867
    m_Localized: "Doctor: ただ逃げた\n脱兎の如く"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220868
    m_Localized: "Doctor: あの恥辱…耐え難い\n取り残された人々への恥\n自分自身への 全人類への…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220869
    m_Localized: "責めるつもりは\nありません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220870
    m_Localized: "それでも あなたなら\n人を助けられます"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220871
    m_Localized: "情けない腰抜け\n出ていけ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220872
    m_Localized: "Doctor: 理解に感謝する\n少し気楽になった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220873
    m_Localized: "Doctor: どれほど多くの命を救えたか\n考えずにはおれん…\nあそこに最後まで残っていれば…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220874
    m_Localized: 'Doctor: 残念だが もう…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220875
    m_Localized: 'Doctor: 隔離区域に器具を全て置いてきた'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220876
    m_Localized: "Doctor: だから…\nもう無用の長物よ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220877
    m_Localized: 'Doctor: 治療を期待したのは わかっとる'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220878
    m_Localized: "Doctor: だが こんな老人が徒手空拳で\nなにが できるというんだね？\nなにも ありはせん…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220879
    m_Localized: "Doctor: すまんな 幻滅させて\n来訪者の脅威に対し\n儂に打てる手などない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220880
    m_Localized: "いいんですよ\nここに いてください"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220881
    m_Localized: "なら 出ていくとき\nドアに気をつけて"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220882
    m_Localized: "Doctor: そうだの\n出ていくべきよな…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220883
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220884
    m_Localized: 'Doctor: さらば'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220885
    m_Localized: "Doctor: 理解に感謝する\n少し気楽になった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220886
    m_Localized: "Doctor: 遅かれ速かれ FEMAに報告の偽造を\n見破られると 想像しとった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220887
    m_Localized: "Doctor: それでも この命を賭していれば\nもっと大勢 救えたかもしれん…\nそう考えずにはいられん"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220888
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220889
    m_Localized: 'Doctor: この重荷に 今生ずっと苦しもう'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220890
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220891
    m_Localized: "Doctor: 言うとおりだの\n儂のような老人に居場所などない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220892
    m_Localized: 'Doctor: さらば'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713914
    m_Localized: "Doctor: なぜ そんなことを？\nFEMAを信用しない理由を\n探ろうとしとるのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713915
    m_Localized: 'Doctor: ならば 語ろうぞ…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713916
    m_Localized: 'Doctor: 来訪者はウイルスだと思うか？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713917
    m_Localized: "そんなウイルス\n存在しません"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713918
    m_Localized: "いえ\nですが なにもわかりません"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713919
    m_Localized: ええ そうです
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713920
    m_Localized: "Doctor: そう信じとるなら\n何故こんな検査を続けるのだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713921
    m_Localized: 'Doctor: 儂を欺こうとしても無駄だ'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713922
    m_Localized: 'Doctor: ならば…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713923
    m_Localized: "Doctor: 理解できる\n悲しいかな 儂も来訪者の正体は知らん"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713924
    m_Localized: "Doctor: だが一つ確かなのは\nウイルスではない"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713925
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713926
    m_Localized: "Doctor: なに 肩透かしだろうが\n恐らくは違う"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713927
    m_Localized: "Doctor: 平凡な人間が 突如として\n変わりはじめるのを見たことあるか？\nすぐ後ろで来訪者へ変貌するのを？"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713928
    m_Localized: "Doctor: なかろうよ\nそんな事例 一件も存在せんのだから"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713929
    m_Localized: "Doctor: 呑み込んどくれ\nFEMAは事態を掌握できとらん\nただ 振りをしとるまで"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713930
    m_Localized: "Doctor: 病院を閉鎖し 人々を隔離区域へ送り…\nだが その目的は？"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713931
    m_Localized: "Doctor: 人を助けとるのか？\n治った者はおるのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713932
    m_Localized: "Doctor: FEMAは人を集めて閉じ込め\n好き勝手しとるだけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713933
    m_Localized: "ならば なぜ\nFEMAで仕事を？"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713934
    m_Localized: "もう たくさんだ\n出ていけ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713935
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713936
    m_Localized: "Doctor: 一人一人 殺されていくのを\n看過できんかった"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713937
    m_Localized: "Doctor: だからFEMAに加わり\n気の毒な人々を隔離区域から\n逃がす手助けをしたのだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713938
    m_Localized: "Doctor: 診察し 診断を下し\n書類を偽造して 自由の身にした"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713939
    m_Localized: "あなたのせいで来訪者まで\n解き放たれかもしれません"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713940
    m_Localized: なんの事件です？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713941
    m_Localized: "残念ですが ここからも\n逃げる羽目になります"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713942
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713943
    m_Localized: 'Doctor: 聞いてもらえんのは無念だ…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713944
    m_Localized: 'Doctor: では 場所を取るのは よしとこう'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713945
    m_Localized: 'Doctor: さらば'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713946
    m_Localized: "Doctor: つまり なんだ？\n放置して見殺しにすべきだと？"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713947
    m_Localized: "Doctor: ヒポクラテスの誓いを立てた身\n命と健康を守るため 全力を尽くそうぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713948
    m_Localized: "Doctor: だが結局…儂もまた\n隔離区域から逃げざるを得んかった\nある事件のせいで 無念ながら"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713949
    m_Localized: 'Doctor: 儂の配属先で事件は起きた'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713950
    m_Localized: 'Doctor: なんだと！？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713951
    m_Localized: "Doctor: 助けたことを否定すると？\nそれが理由で 儂を追い出すと？"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713952
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713953
    m_Localized: "Doctor: まさか そんな言葉を耳にしようとは\nお前さん FEMA以下かもしれん\n連中 せめて助ける振りはするが\nお前さんは…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713954
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713955
    m_Localized: "Doctor: ここに儂の居場所は もうない\nお前さんに運命を託す人々の行く末が\n恐ろしいよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713956
    m_Localized: 'Doctor: さらば'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220894
    m_Localized: 口の糸を切ったんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220896
    m_Localized: 'Foreigner: んらせま！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220897
    m_Localized: "Foreigner: らほい ねうおまあま！\nきるをふりはを ひをわまよふ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220898
    m_Localized: "なにを言っているのか\nわかりません"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220899
    m_Localized: "こちらが言っている意味\nわかりますか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220900
    m_Localized: "Foreigner: はのいをへふをかにる うるくはを…\nひわめおな ををあま？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220901
    m_Localized: 'Foreigner: りけわへわに ゆひなふし へらかる？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220903
    m_Localized: "どうすれば会話\nできるでしょうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220905
    m_Localized: "Foreigner: りそにゆひない らきるろもふそか\nみわもまく なあにわもふらお"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220906
    m_Localized: "Foreigner: みわめおな むすふ\nもてある はのい をへふをかる\nうるかるし もおはを"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220907
    m_Localized: 'Foreigner: ひわま'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220908
    m_Localized: どういう ことですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220909
    m_Localized: "なにか 質問しようと\nしていますか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220910
    m_Localized: "Foreigner: たま うるくはを\nふし はのる りをふをかなめ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220911
    m_Localized: 'Foreigner: まてあ りしあてあま'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220912
    m_Localized: "Foreigner: たま うるくはを\nふし はのる りをふをかなめ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220913
    m_Localized: 'Foreigner: まてあ りしあてあま'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220915
    m_Localized: "やあ\nどうですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414976
    m_Localized: "Foreigner: （男の肩に手の平を置き\n口元の傷を指さす）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414977
    m_Localized: 元気ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414978
    m_Localized: 痛みますか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414979
    m_Localized: 'Foreigner: しわ をほひ をへふらお'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414980
    m_Localized: 'Foreigner: よ…り…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414981
    m_Localized: 'Foreigner: よあ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414982
    m_Localized: 'Foreigner: よあり'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414983
    m_Localized: "Foreigner: せめるもをよひ…\nさらまへるし もおはを"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414984
    m_Localized: "Foreigner: れおにらのし れはももまをの\nれほをへふをか るしもおはを"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414985
    m_Localized: 'Foreigner: はあふ んらせま'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414987
    m_Localized: "どうやって\n家に帰るんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414989
    m_Localized: "Foreigner: （頭の上に両手を置き\n屋根の形をマネする）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414990
    m_Localized: "Foreigner: をろ？\nをろにゆひい りをふをかにる？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414991
    m_Localized: "Foreigner: ひしまほい まめぬのりふ\nみおふ ゆあはゆひの はへまあま"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414992
    m_Localized: "Foreigner: ゆあはに らみらくろ\nゆひなの はくはを"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414993
    m_Localized: "どうすれば家へ\n送れますか？飛行機？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414994
    m_Localized: "船の乗船券は\n確かめました？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414995
    m_Localized: "Foreigner: （両腕を大きく開いて\n翼のような動きをする）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414996
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414997
    m_Localized: "Foreigner: とゆわり？\nたま ひあふをかひ れしわにる？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414998
    m_Localized: 'Foreigner: ひゆるふ もくつふそはをひ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414999
    m_Localized: "Foreigner: たま るろおか ふる\nんかるし もおはを"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415000
    m_Localized: "Foreigner: （手を動かし\n波を進む船をマネする）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415001
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415002
    m_Localized: "Foreigner: みお…\nてぬふ をら へふゆひる？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415003
    m_Localized: "Foreigner: たま わゆをふ をかにる？\nもくつふそはをひ んきるひわ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415005
    m_Localized: "なぜ そんなに\n嬉しそうなんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415007
    m_Localized: "Foreigner: （微笑みながら顔を指さし\nそれから 男を指さす）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415008
    m_Localized: 'Foreigner: んん みにゆひる'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415009
    m_Localized: "Foreigner: おへもさる たま なもへふをかひ\nれもろふらおまあま！\nもあもくおかる？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415010
    m_Localized: "Foreigner: （男は片手を もう一方に添え\n動かしてみせる）"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415012
    m_Localized: "誰かに家まで\n車に乗せてもらっては？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415014
    m_Localized: "Foreigner: うるくはをあま\nひしけ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415015
    m_Localized: "Foreigner: んもま るろかあま！\nめらはらひし ろりたふな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415016
    m_Localized: "Foreigner: ゆあさ まへけ！\nもさんは！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415017
    m_Localized: 'Foreigner: なをなを！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415018
    m_Localized: 列車のこと言ってます？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415019
    m_Localized: どこかへ行くんですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415020
    m_Localized: "Foreigner: うるくはるへま\nめたはを"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415021
    m_Localized: "Foreigner: ふし んもま ろりの をへふ\nゆにすふ まもるすかけ！"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415022
    m_Localized: "Foreigner: しもるもまく けわさら\nるろおか るしもおはを…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415023
    m_Localized: 'Foreigner: ゆわわあい！'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415069
    m_Localized: "TaxiDriver: 遠慮すんな\nほら 訊きな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415070
    m_Localized: "まだFEMAに追われていると\n考えてるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415071
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415072
    m_Localized: "TaxiDriver: そうでなきゃいいんだがな\nホント"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415073
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415074
    m_Localized: "TaxiDriver: あぁ しくじっちまった\nFEMAに行っちまうなんてよ\n捕まえられることぐらい\n気付くべきだった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415075
    m_Localized: "TaxiDriver: 乗客だけ連れてって\nオレは見過ごされるものかと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415076
    m_Localized: "TaxiDriver: なのに 車を奪われ\n危うく撃たれるところだった"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415077
    m_Localized: "TaxiDriver: でも 考えてもみろよ\n他に どうしろってんだ？\nあの男は来訪者だったんだぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713957
    m_Localized: では 人間だったら？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713958
    m_Localized: "他に選択肢は\nありませんでした"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713959
    m_Localized: "TaxiDriver: おい…\nなぁ そんなこと言わないでくれよ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713960
    m_Localized: 'TaxiDriver: あの件で もうムチャクチャなんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713961
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713962
    m_Localized: "TaxiDriver: まぁ…アンタの言うとおりだよ うん\n他に手はなかったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713963
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713964
    m_Localized: "TaxiDriver: あぁ 昔はハンドル握ってりゃ\nなにも考えずに すんだのにな"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713965
    m_Localized: "TaxiDriver: 今じゃ来訪者のせいで…\nったく 次の客に\nブッ放されちまうかもしれねえ…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713966
    m_Localized: 'TaxiDriver: はぁ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415078
    m_Localized: "TaxiDriver: 遠慮すんな\nほら 訊きな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415079
    m_Localized: "どれだけタクシー運転手\n続けてるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415080
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415081
    m_Localized: "TaxiDriver: あぁ ずいぶんやってるよ うん\n今は自営業でさ オレのボスはオレさ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415082
    m_Localized: "TaxiDriver: 好き勝手 市民を乗せるのは\nFEMAが許しちゃ くれねえけどな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415083
    m_Localized: "TaxiDriver: でも いつか この騒動も終わるだろ？\nならカネは…\nカネは いつだって持ってて損はねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415084
    m_Localized: 'TaxiDriver: 危険な運転ほど稼げるしな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415085
    m_Localized: "TaxiDriver: それと 夜に走ると\nガキの頃を思い出すんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415086
    m_Localized: "TaxiDriver: あのよ タクシー運転手になったのは\nオヤジの影響なんだ\n轍を追いたくなってよ うん"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713967
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713968
    m_Localized: "TaxiDriver: 路上で死にたかねえんだ\n誰に顧みられることもなく…\nオヤジみたいにな"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713969
    m_Localized: "TaxiDriver: ただ まだ運が尽きてないことを\n願うばかりだよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415087
    m_Localized: "TaxiDriver: 遠慮すんな\nほら 訊きな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415088
    m_Localized: "今日は ずいぶん\n落ち込んでますね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415089
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415090
    m_Localized: 'TaxiDriver: あぁ ただな…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415091
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415092
    m_Localized: "TaxiDriver: 車を失っちまったのが\nどうしても忘れらんなくて なぁ…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713970
    m_Localized: "どんな車に\n乗ってたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713971
    m_Localized: "どこか特別な車\nだったんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713972
    m_Localized: "TaxiDriver: あぁ そうだな\n抜群に美しいクラシックカーだった…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713973
    m_Localized: "TaxiDriver: 鮮やかな黄色のボディ\n輝くクロームのホイール\n滑らかな曲線美…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713974
    m_Localized: 'TaxiDriver: でも もう なくしちまった…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713975
    m_Localized: "TaxiDriver: クソFEMA…\nあの車は オレの全てだったんだ！\nチクショウ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713976
    m_Localized: "TaxiDriver: アイツ オヤジの車だったんだ\nオヤジもタクシー転がしててな"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713977
    m_Localized: "TaxiDriver: ガキの頃 オヤジの車に乗るのが\n大好きだった\n後部座席で寝ちまうと そのまま\n連れてってくれたんだ でもな…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713978
    m_Localized: 'TaxiDriver: 運の尽き ってとこだな…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415096
    m_Localized: "TaxiDriver: 遠慮すんな\nほら 訊きな"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415097
    m_Localized: お父さんに なにが？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415098
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713979
    m_Localized: "TaxiDriver: こんな話 滅多にしねえんだが…\nアンタなら信じられる気がする"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713980
    m_Localized: "TaxiDriver: ある日 オフクロが出張で\nオヤジに連れて行かれたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713981
    m_Localized: "TaxiDriver: その時だ\n生涯 忘れられない客を乗せた"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713982
    m_Localized: "TaxiDriver: 鋭いスーツ ハゲた頭\n獣みてえな微笑み…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713983
    m_Localized: "TaxiDriver: 街の誰もが知ってる男だった\nオレみてえなチビのガキだってな\nそんなヤツを断れるか？ムリだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713984
    m_Localized: "TaxiDriver: でも オヤジは誇り高い男だった\nその選択が…\n家族みんなに降りかかった"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713985
    m_Localized: "TaxiDriver: あのスーツの男は\nきっちり報いを与えた"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713986
    m_Localized: "TaxiDriver: オレたちは家を失い\n一所に長く いられなくなった"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713987
    m_Localized: "TaxiDriver: それにカネもスッカラカンで\nオヤジは同じ車に乗り続けて\n仕事しっぱなしだった"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713988
    m_Localized: "TaxiDriver: 年老い 借金まみれになって\nあんな車 持ち続けるんじゃなかった と\n後悔しはじめた"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713989
    m_Localized: "TaxiDriver: あの車は呪われてる\n不幸の元だ なんて"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713990
    m_Localized: 'TaxiDriver: でも そうじゃねえんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713991
    m_Localized: "TaxiDriver: 車のせいじゃない\nオヤジの誇りのせいだ\nそれで破滅しちまった"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713992
    m_Localized: "TaxiDriver: それでも…オヤジの選択のせいで\nオレが早くから働いて\n家族を食わせるハメになっても…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713993
    m_Localized: 'TaxiDriver: まだオヤジを愛してる'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713994
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713995
    m_Localized: 'TaxiDriver: オヤジが恋しいんだ…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713996
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713997
    m_Localized: "TaxiDriver: 大それた頼みじゃねえが…\n迷惑じゃなきゃ その\nオヤジに電話して くれねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713998
    m_Localized: "TaxiDriver: 番号は こうだ\n{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713999
    m_Localized: "TaxiDriver: オレは無事だと 言ってやってくれ\n自分で 伝えてえが…\n今は居場所を明かせねえんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415106
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609403
    m_Localized: 'FormerFema: 太陽に曝露しすぎてないと いいが…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609404
    m_Localized: "本当にFEMAじゃ\nないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609405
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609406
    m_Localized: "FormerFema: いや 本当に違うって\n言ったろ 前は冷蔵庫 直してた って"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609407
    m_Localized: 'FormerFema: この制服は車の中で見つけたんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609408
    m_Localized: "さっきは死体から\n剥ぎ取ったと"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609409
    m_Localized: 嘘ついてませんか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609410
    m_Localized: "FormerFema: あっ…ああ\nそうだよ うん"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609411
    m_Localized: 'FormerFema: 車の中で 死体を見つけたんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609412
    m_Localized: "FormerFema: それで この制服を着ていれば\n来訪者から身を守れると思って\nだってFEMAの連中が着てるからには\n理由があるはずだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609413
    m_Localized: "FormerFema: 嘘じゃない\nストレスで ごちゃごちゃに なってんだ\nそんなに おかしいか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609414
    m_Localized: "FormerFema: オレが見たものを アンタが見たら…\nわかるはずだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609415
    m_Localized: "FormerFema: ここに来る途中 死ぬほど怖かったよ\n死体が地面で痙攣してたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609416
    m_Localized: 'FormerFema: 太陽に曝露しすぎてないと いいが…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609417
    m_Localized: "FEMAの防護服なんて\n着てて大丈夫ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609418
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609419
    m_Localized: 'FormerFema: えっ？ああ…そうだな'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609420
    m_Localized: "FormerFema: えっと まあ 確かに\nFEMAを嫌うヤツもけど…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609421
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609422
    m_Localized: "FormerFema: あっ それって FEMAと\n揉めるかもしれない ってことか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609423
    m_Localized: "FormerFema: うん そうだな でも…\nきちんと説明さえすれば\n信じてもらえるはずだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609424
    m_Localized: "FormerFema: 連中を悪魔に仕立て上げなくてもいい\n別に秘密結社でも ないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609425
    m_Localized: 'FormerFema: 太陽に曝露しすぎてないと いいが…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609426
    m_Localized: "ポケットの中を\n見せてください"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609427
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609428
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609429
    m_Localized: 'FormerFema: なあ なんでオレを調べるんだ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609430
    m_Localized: "FEMAのバッジを\n持ってませんか？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609431
    m_Localized: "どうしました\n隠し事でも？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609432
    m_Localized: "FormerFema: えっ？\nバッジだって"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609433
    m_Localized: "FormerFema: 誓うよ\nなにも持ってない…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609434
    m_Localized: "ポケットを空にして\n大人しく従ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609435
    m_Localized: （銃を抜く）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609436
    m_Localized: "FormerFema: 誰がだ？\nオレ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609437
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609438
    m_Localized: 'FormerFema: 違うんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609439
    m_Localized: "ポケットを空にして\n大人しく従ってください"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609440
    m_Localized: （銃を抜く）
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609441
    m_Localized: "FormerFema: わかったわかったよ\n乱暴は よしてくれ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609442
    m_Localized: "FormerFema: ほら\nこれで満足か？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609443
    m_Localized: "FormerFema: ああ 降参だ\n実はFEMAの人間なんだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609444
    m_Localized: "FormerFema: でも 頼む\n他のヤツには言わないでくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609445
    m_Localized: 'FormerFema: ああっ チクショウ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609446
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609447
    m_Localized: "FormerFema: ほら\n撃たないでくれ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609448
    m_Localized: "FormerFema: そうだよ…\n本当はFEMAなんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609449
    m_Localized: 'FormerFema: でも 他人には言わないほうがいい'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491072
    m_Localized: "なぜFEMAだったのを\n隠したんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491073
    m_Localized: なんで見え透いた嘘を？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491074
    m_Localized: 'FormerFema: 本当に わからないのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491075
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491076
    m_Localized: 'FormerFema: 本気で 訊いてんのかよ！？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491077
    m_Localized: 'FormerFema: もしFEMAで働いてた ってバレたら…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491078
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491079
    m_Localized: "FormerFema: ほら もうFEMA所属じゃないんだ\nこう考えてくれ…辞めた って"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491080
    m_Localized: "FormerFema: ほら もうFEMA所属じゃないんだ\nこう考えてくれ…辞めた って"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491081
    m_Localized: 'FormerFema: ああ あれこれ やらされたよ'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491082
    m_Localized: "FormerFema: 人を連行したり\n隔離区域まで移送したり…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491083
    m_Localized: "FormerFema: でも なあ 仕事だったんだ\n命令に従っただけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491084
    m_Localized: "FormerFema: 連行した人のことは訊かないでくれ\n上の連中しか知らないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491085
    m_Localized: "FormerFema: 殺し屋 呼ばわりなんて…\nそんな筋合い ないだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491086
    m_Localized: "FormerFema: ある殺し屋が 別の殺し屋を始末した\nそれって なんて呼べばいい？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609450
    m_Localized: 'FormerFema: 太陽に曝露しすぎてないと いいが…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609451
    m_Localized: "なぜFEMAだったのを\n隠したんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609452
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491087
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491088
    m_Localized: "FormerFema: 来訪者の徴候が出てた男を\n収容したことが あったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491089
    m_Localized: "FormerFema: 結論から言えば 具合が悪化して\n隔離区域で死んだ よくあることだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491090
    m_Localized: "FormerFema: それから 奥さんがやってきて訊くんだ\n「いつ夫を 出してくれるんです？」\nオレたちは「もう出せるものはない」\nそう答えた"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491091
    m_Localized: "FormerFema: 女は衝撃を受け 叫びだした\n殺人鬼 呼ばわりして\n死体を返せ と"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491092
    m_Localized: "FormerFema: 規則で返還できない そう答えた\nだが 女は引き下がらなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491093
    m_Localized: "FormerFema: 挙げ句の果てに\n門の前で座り込みを はじめた"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491094
    m_Localized: "FormerFema: オレたちは死体を渡したよ\nおかげで規則違反で全員クビ\nオレもな"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491095
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491096
    m_Localized: "FormerFema: あのクソ死体を手に入れなきゃ\n気が済まなかったイカれ野郎のせいで\n仕事を失ったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491097
    m_Localized: 'FormerFema: 今は どこにも行き場がねえ…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491098
    m_Localized: "FormerFema: しかも あの女 死体を葬るどころか\n担ぎ歩いてるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491099
    m_Localized: 'FormerFema: みんなクビになる価値があったのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491100
    m_Localized: "やっぱりFEMAの連中は\nバカばかりだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491101
    m_Localized: 運が なかったですね
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491102
    m_Localized: 'FormerFema: ちょっ 待てよ！？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491103
    m_Localized: "FormerFema: 仕事こなして 任務を全うしてたのに\nあのイカれ女のせいでクビだぞ…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491104
    m_Localized: 'FormerFema: それで バカ呼ばわりかよ！？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491105
    m_Localized: "FormerFema: もういい こんな避難所 知ったことか\nオレは出ていく"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491106
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491107
    m_Localized: "FormerFema: クソ食らえ\nみんな頭どうかしちまったのかよ？"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491108
    m_Localized: "FormerFema: いや本当\n正に そのとおりだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491109
    m_Localized: "FormerFema: 太陽がイカれて 感染が広がってから\nみんな狂っちまった"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491110
    m_Localized: "FormerFema: あのクソ死体に 仕事 クビになるほど\n価値があったのか？\nどう思う？"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491111
    m_Localized: "その人が旦那さんと\n再会できて良かった"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491112
    m_Localized: "遺体を渡すべきじゃ\nありませんでした"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491113
    m_Localized: 'FormerFema: オレたちがクビになって 良かったと？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491114
    m_Localized: "FormerFema: 一般市民ってのは\nなにも わかっちゃ いないな"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491115
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491116
    m_Localized: "FormerFema: 撃っときゃ よかったんだ\nあの女も ダンナみたいにな"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491117
    m_Localized: 今なんと？
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491118
    m_Localized: （銃を抜く）
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491119
    m_Localized: 'FormerFema: なんだよ その目は？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491120
    m_Localized: "FormerFema: 規則で決まってんだ\n感染した市民が重症なら…"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491121
    m_Localized: "FormerFema: その場で処分しろ って\n来訪者を隔離区域に入れないために"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491122
    m_Localized: しかたありません
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491123
    m_Localized: （銃を抜く）
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491124
    m_Localized: 'FormerFema: わかってくれて ありがとう'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491125
    m_Localized: "FormerFema: 殺し屋なんかじゃない\n命令に従っただけなんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491126
    m_Localized: 'FormerFema: おい なに やってんだ！？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491127
    m_Localized: "FormerFema: 落ち着けよ！\nアイツは来訪者だったんだ！\nしかも重症！放置できないだろ！"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491128
    m_Localized: "FormerFema: 撃つな\n命令に従っただけなんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491129
    m_Localized: "FormerFema: 同感だ\n規則に従うべきだった"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491130
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491131
    m_Localized: "FormerFema: よし これ以上は よしとこう\nとにかく 受け入れてくれて感謝する\n元FEMAの人間と わかってなお"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491132
    m_Localized: "FormerFema: 仕事に戻る日が来たら\n協力してくれたこと 報告しとくよ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803695
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803696
    m_Localized: 'FatalDame: 以前 お父さんの話してたわよね'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803697
    m_Localized: "FatalDame: あれから 触れてなくて\nどんな人か よく知らないけど"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803698
    m_Localized: "FatalDame: でも今は…わかる気がする\nあなたって お父さんに似てる\n瓜二つ"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803699
    m_Localized: 'FatalDame: それって怖くない？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803700
    m_Localized: 'FatalDame: お父さんの影から抜け出せないんでしょ？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803701
    m_Localized: "FatalDame: あなたにとって死人同然なのに\nなら どうして\n幽霊を掘り起こそうとし続けるの？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803702
    m_Localized: "FatalDame: きっと会えないわ\nあの世に行っても"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803703
    m_Localized: "FatalDame: 同じ場所には行けないだろうから\n気にしないで"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803704
    m_Localized: "FatalDame: 全部の答えを一度に追わなくて いいの\n道は一つずつ石を並べて作るものよ\n付いてこられてる？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803705
    m_Localized: "FatalDame: それに お願いだから…\nもう そんな口の利き方 よして"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803706
    m_Localized: "FatalDame: 辛いの\nそんな あなたを見るのは"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803707
    m_Localized: "FatalDame: でもね 死を恐れなくてもいいの\n責任も 親密さも なにもかも"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803708
    m_Localized: 'FatalDame: どれも生の一部だもの'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803709
    m_Localized: "FatalDame: 全部の答えを一度に追わなくて いいの\n道は一つずつ石を並べて作るものよ\n付いてこられてる？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803710
    m_Localized: "FatalDame: それに こう考えると楽になるかも…\n幕が下りたって\n人は完全に消えるわけじゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803711
    m_Localized: "FatalDame: 昔は 天国や地獄を信じてた\n今は？よく わからない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803712
    m_Localized: 'FatalDame: もしかしたら 完全に別なのかも'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803713
    m_Localized: 'FatalDame: どう思う？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803715
    m_Localized: "妊娠していますね\nそれも出産が近いのでは？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803717
    m_Localized: 'FatalDame: あら'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803718
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803719
    m_Localized: 'FatalDame: 絶望に呑まれてるのね？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803720
    m_Localized: "FatalDame: 信じていた すべてが瓦解して…\n受け入れられもせず"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803721
    m_Localized: "FatalDame: それって\nあたしたちが どこへ向かっているか\n知りたくないから？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803722
    m_Localized: "FatalDame: それとも…あなた自身\nもうこの世界に属していないから？\nあるいは どんな世界にも？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803723
    m_Localized: "そんな話じゃありません\nあなたの妊娠の件です"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803724
    m_Localized: 怖くないのですか？
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803725
    m_Localized: "FatalDame: ねえ あなた…\nそんな急に産めるはず ないでしょ\nお腹だって まだ膨らんでないのに"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803726
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803727
    m_Localized: 'FatalDame: 一つ訊いてもいい？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803728
    m_Localized: 'FatalDame: この子が本物で…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803729
    m_Localized: "FatalDame: もし あなたの言うとおり\nもうすぐ出てくるなら…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803730
    m_Localized: "FatalDame: どうするつもり？\n誰か探すの？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803731
    m_Localized: 存在してはなりません
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803732
    m_Localized: まだ決めてません
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803733
    m_Localized: "FatalDame: ふふ\nいい質問ね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803734
    m_Localized: "FatalDame: 死ぬのは怖いわ\nもちろん"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803735
    m_Localized: "FatalDame: だって その先どうなるか\nわからないもの"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803736
    m_Localized: 'FatalDame: 天国 生まれ変わり 完全に別のなにか'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803737
    m_Localized: "FatalDame: 帰ってきて語ってくれた人なんて\n誰一人いない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803738
    m_Localized: 'FatalDame: でも あなたの見通しなんだけど…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803739
    m_Localized: 'FatalDame: この子が本物で…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803740
    m_Localized: "FatalDame: もし あなたの言うとおり\nもうすぐ出てくるなら…"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803741
    m_Localized: "FatalDame: どうするつもり？\n誰か探すの？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803742
    m_Localized: 存在してはなりません
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803743
    m_Localized: まだ決めてません
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803744
    m_Localized: "FatalDame: 本能は時として\n親しんだものを守ろうとするものよ…\nどんなに役立たずでも"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803745
    m_Localized: 'FatalDame: きっと…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803746
    m_Localized: "FatalDame: きっと もう目を開いて\n新しい なにかを見る時じゃない？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803747
    m_Localized: 'FatalDame: それとも そんなに未知が怖い？'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803748
    m_Localized: あの子を見つけます
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803749
    m_Localized: "来てるんです\n間違いない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803750
    m_Localized: "FatalDame: 手放すことを恐れないで\nもう役立たずなら なおさらね"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803751
    m_Localized: "FatalDame: 時として 親しみがある というだけで\nしがみついて しまうもの"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803752
    m_Localized: "FatalDame: それはもちろん\n習性を断つのは痛みを伴うわ…\nでも その先どうなるか\n誰もわからないでしょ？"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803753
    m_Localized: あの子を見つけます
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803754
    m_Localized: "来てるんです\n間違いない"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803755
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803756
    m_Localized: 'FatalDame: そう言うなら'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803757
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803758
    m_Localized: "FatalDame: なにを見つけたか教えて…\n時が来たら"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713856
    m_Localized: "Neighbour: よし\n俺からは以上だ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713857
    m_Localized: "Neighbour: おっと そうだそうだ\n忘れるところだった"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713858
    m_Localized: "Neighbour: 明日の夜には 家に帰る\nうちの番号を控えておいてくれ\n回線が開通したんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713859
    m_Localized: "Neighbour: 電話で連絡を取り合おう\n{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713860
    m_Localized: 'Neighbour: よし 今度こそ本当に終わりだ'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713861
    m_Localized: "Neighbour: ビールでも開けて\n寝ることだ"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491133
    m_Localized: 'Cat: みゃあ！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491134
    m_Localized: 猫をなでる
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491135
    m_Localized: 猫を抱き上げる
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491136
    m_Localized: 猫に缶詰をやる
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491137
    m_Localized: 'Cat: （手を伸ばし 猫をなでる）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491138
    m_Localized: 'Cat: （気に入っているのか わからない）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491139
    m_Localized: 'Cat: みゃあ！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491140
    m_Localized: 猫をなでる
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491141
    m_Localized: 猫を抱き上げる
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491142
    m_Localized: 猫に缶詰をやる
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491143
    m_Localized: 'Cat: （猫を なでることにした）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491144
    m_Localized: 'Cat: （ちゃんと気に入っているようだ）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491145
    m_Localized: 'Cat: （はじめ思ったほど 嫌がっていない）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491146
    m_Localized: 'Cat: （なつきはじめて いるみたいだ）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491147
    m_Localized: 'Cat: みゃあ！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491148
    m_Localized: 猫をなでる
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491149
    m_Localized: 猫を抱き上げる
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491150
    m_Localized: 猫に缶詰をやる
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491151
    m_Localized: "Cat: （たくさん なでられ\n猫はとても喜んでいる）"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491152
    m_Localized: "Cat: （猫のほうから\n身を預けている気がする）"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491153
    m_Localized: "Cat: （こんな かわいい子\n拒めるはずがない）"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491154
    m_Localized: 'Cat: みゃあ！みゃあおう！みゃあ！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491155
    m_Localized: 'Cat: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491156
    m_Localized: "Cat: （小さな顔からは読み取りづらいが\nきっと幸せに違いない）"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491157
    m_Localized: "Cat: （不思議と 今夜は安心して\n眠れる気がする）"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491158
    m_Localized: "Cat: （まるでモフモフの友達が お礼に\n命を一つ 分けてくれたみたいに）"
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491159
    m_Localized: "Cat: （もしかしたら…今夜は死も\n家を通り過ぎていくかもしれない）"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547465932800
    m_Localized: 'Teacher: 可哀想な子たち…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292928
    m_Localized: なにか問題でも？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292929
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292930
    m_Localized: 'Teacher: え？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292931
    m_Localized: 'Teacher: ただ…考えていただけです'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292932
    m_Localized: "Teacher: これで大量絶滅せず\n生き延びられたなら…\nなにが待っているんでしょう？"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292933
    m_Localized: 'Teacher: どんな未来が残されているでしょう？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292934
    m_Localized: "新世界に居場所がなくて\n恐ろしいのですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292935
    m_Localized: "慈愛は もう通用しません\n頼れる相手を探すべきかと"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292936
    m_Localized: 'Teacher: 慈愛…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292937
    m_Localized: 'Teacher: 暴力では生きられません'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292938
    m_Localized: "Teacher: どこに居場所があるでしょう…\n貴方が言う…「新世界」に"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292939
    m_Localized: ならば 座して死を待つと？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292940
    m_Localized: では どうするのですか？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292941
    m_Localized: "暗黒時代は昔もありました…\n今回が初ではありません"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292942
    m_Localized: "Teacher: そんなもの 求めていません\nたとえ守って もらえるとしても…"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292943
    m_Localized: "Teacher: 殺人は止まりません\n暴力は消えません"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292944
    m_Localized: ならば 座して死を待つと？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292945
    m_Localized: では どうするのですか？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292946
    m_Localized: "暗黒時代は昔もありました…\n今回が初ではありません"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292947
    m_Localized: 'Teacher: 茫然自失なんです'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292948
    m_Localized: "Teacher: 本当に殺人者に囲まれて\n生きていくんでしょうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292949
    m_Localized: "Teacher: これから子供たちは\n殺人鬼から学ぶんでしょうか…？"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292950
    m_Localized: "落ち込んでる場合では\nありません"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292951
    m_Localized: しっかりしてください！
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292952
    m_Localized: 'Teacher: わかりません'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292953
    m_Localized: 'Teacher: なにも差し上げられません'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292954
    m_Localized: "Teacher: ただ…\nこんなことが終わってほしいんです"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292955
    m_Localized: "Teacher: これ以上は…\nもう無理です"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292956
    m_Localized: "Teacher: ええ そうです\nですが…"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292957
    m_Localized: "Teacher: これから どう生ていけば\nいいのでしょう？"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292958
    m_Localized: "Teacher: 人々は狂気に走り\n誰彼構わず殺しています…\n自分たちと違って見えたなら"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292959
    m_Localized: 'Teacher: 誰相手だろうと関係ないのです'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292960
    m_Localized: "落ち込んでる場合では\nありません"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292961
    m_Localized: しっかりしてください！
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292962
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292963
    m_Localized: 'Teacher: なぜ ですか？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292964
    m_Localized: "Teacher: 冷酷は 貴方の力となるんでしょう\nですが 私には無理です"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292965
    m_Localized: "Teacher: 私が見てきたものを\n貴方に見せられたなら…"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292966
    m_Localized: "Teacher: 私の目には…\n永遠に焼き付いて離れません"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292967
    m_Localized: "Teacher: 炎 悲鳴\n憤怒と恐怖に満ちた顔\n破壊された家々"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292968
    m_Localized: "Teacher: 私は貴方のようには なれません\nそう強く ありません"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292969
    m_Localized: "Teacher: 私に残された道は…\nただ一つ"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292970
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292971
    m_Localized: "Teacher: （女は びくっと震え\n恐怖に怯えながら こちらを見る）"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292972
    m_Localized: "Teacher: （混乱のおかげで悪夢を忘れられた\nようだったが 束の間だけだった）"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292973
    m_Localized: 'Teacher: （顔を両手で覆い 小さく泣き出す）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292974
    m_Localized: "Teacher: （自分も どうしていいか わからない\n誰にも教わっていない）"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292975
    m_Localized: "Teacher: （そっと肩に手を置き\nそのまま暫く 断っている）"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292976
    m_Localized: "Teacher: （一人にしておいたほうが\nいいのだろう）"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487232
    m_Localized: "Mother: ねえ そういえば\n夫に電話してみたら？\n{0} だから"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487233
    m_Localized: 'Mother: 文句の一つでも言ってやりなよ'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487234
    m_Localized: "Mother: だってさ アイツの子でもあるんだから\n探すの手伝うべきだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487235
    m_Localized: "Anger: 回線が通ったら 電話してくんねえか？\n{0} だ"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487236
    m_Localized: "Anger: アイツに こう伝えてくれ\nオレは全部 覚えてる…\nそれでも 自分の喉を引き裂きたくなる"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487237
    m_Localized: "Anger: それか 怒鳴りつけて くれてもいい\nオレの代わりに\nもしかしたら…\n少しは楽になるかもしれねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487238
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875840
    m_Localized: "FortuneTeller: それと…そうだね\n向こうからの助けを求めるのもいるね"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875841
    m_Localized: "FortuneTeller: いるのさ…専門家がね…\n闇を祓う術に精通してる連中だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875842
    m_Localized: "FortuneTeller: よければ 繋いでやるよ\n役立つかもしれないしね…"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875843
    m_Localized: "FortuneTeller: 電話番号 書いとくよ\n{0} さ"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875844
    m_Localized: "FortuneTeller: 私の紹介だと伝えるんだよ…\n忘れずにね！"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547533041664
    m_Localized: "Alkonost: 差し支えなければ\n夫に電話してもらえませんか？\n{0} です"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235968
    m_Localized: "Foreigner: （紙切れを手渡された\n電話番号が書かれている\n{0}）"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235969
    m_Localized: 'Foreigner: （外国大使館の電話番号かもしれない）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818880
    m_Localized: 'Jacob: ああ 飲みたくて たまらない'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818881
    m_Localized: "不死とは どういう\n意味だったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818882
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818883
    m_Localized: "Jacob: ふむ…\n自分の頭を撃てば 確かめられるぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818884
    m_Localized: 'Jacob: だが 私が君なら やめておく'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818885
    m_Localized: "Jacob: いや 無論\n君が思うような不死ではない"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818886
    m_Localized: "Jacob: 死んだ後も また生まれ変わり\n人生を続けるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818887
    m_Localized: "Jacob: どう聞こえるかは承知だ\nだが 私が見てきたものを見れば…\n君も合点がいく"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818888
    m_Localized: "Jacob: もしかすると 来訪者は かつて人間で\n生まれ変わったのかもしれない"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818889
    m_Localized: "Jacob: 確かなことは言えない\n仕組みが把握できない…"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818890
    m_Localized: "Jacob: だが 自然の摂理は多くの秘密を\n隠しているに違いない"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818891
    m_Localized: 'Jacob: そして 娘を見つける'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818892
    m_Localized: "Jacob: どの人生だろうとも…\n必ず"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818893
    m_Localized: 'Jacob: 私たちは 決して死なないのだから'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818894
    m_Localized: 'Jacob: ああ 飲みたくて たまらない'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818895
    m_Localized: "なぜFEMAに\n追われてるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818896
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818897
    m_Localized: 'Jacob: この騒動の震源地に いたんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818898
    m_Localized: 'Jacob: あの生物が這い出してきた土地に'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818899
    m_Localized: "Jacob: 郊外に潜む悪魔とかいう\n馬鹿げた都市伝説を覚えているか？"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818900
    m_Localized: "Jacob: いや いいんだ\n誰も覚えてはいまい"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818901
    m_Localized: "Jacob: 結局 都市伝説でも なんでもなかった\nFEMAは はなから知っていたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818902
    m_Localized: "Jacob: 怪異など なにもないと\n言い張っていた"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818903
    m_Localized: "Jacob: そして今や\n誰もが太陽に焼かれている…"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818904
    m_Localized: "Jacob: 地中から出てきた怪物が\n生き残りを仕留めている！"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818905
    m_Localized: "Jacob: 要するに FEMAは大失態を\n演じた自覚を持っている…"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818906
    m_Localized: 'Jacob: それで 今は無能を繕っているわけだ'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818907
    m_Localized: "Jacob: 私は ただ居合わせただけだ\n過ちを犯した時点 過ちを犯した地点に"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818908
    m_Localized: 'Jacob: ああ 飲みたくて たまらない'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818909
    m_Localized: どう生き延びたんです？
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818910
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818911
    m_Localized: "Jacob: 私は不死だ\n忘れたか？"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818912
    m_Localized: 'Jacob: なぜだかな…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818913
    m_Localized: 'Jacob: 私も 自分自身 問い続けている'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818914
    m_Localized: "Jacob: 運かもしれない\nあるいは もっと大きな力に\n守られているの かもしれない…"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818915
    m_Localized: "Jacob: 神か\n君が信じる某か"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818916
    m_Localized: "Jacob: あるいは もしかしたら もう死んでいて\nこれが新しい人生なのかも しれない\nわからないが"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818917
    m_Localized: 'Jacob: いい質問だ'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818918
    m_Localized: "Jacob: 銃さえあれば\n私も君に同じ質問を するところだ"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818919
    m_Localized: "Jacob: 残念ながら 君が持っているのは\nビールだけだな"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818920
    m_Localized: "Jacob: 蒸留器を持っていれば\n最高の一杯を造って あげられるんだが"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818921
    m_Localized: 'Jacob: ああ 飲みたくて たまらない'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818922
    m_Localized: "他に なにを\n知ってるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818923
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818924
    m_Localized: "Jacob: FEMAの組織図なら\n隅から隅まで熟知している"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818925
    m_Localized: "Jacob: 誰が誰に従っているか\n誰が何をやっているか\n誰が誰を騙しているか"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818926
    m_Localized: "Jacob: 外道ども 来訪者に精通していた\nどれほど危険かも…"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818927
    m_Localized: 'Jacob: なのに 街へ入れたんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818928
    m_Localized: "Jacob: 安全なんて 誰一人 なに一つ\n気にしてなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818929
    m_Localized: 'Jacob: 政府のカネを洗うだけで'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818930
    m_Localized: 'Jacob: 失態の目撃者は皆 処分された'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818931
    m_Localized: "Jacob: 誰にも知られないよう\n組織が望んだ"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818932
    m_Localized: 'Jacob: 隔離区域を作る前から'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818933
    m_Localized: 'Jacob: 私は どうにか逃げ延びた'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818934
    m_Localized: "Jacob: 最高機密を知りたいか？\nいいだろう…"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818935
    m_Localized: 'Jacob: なにもかも FEMAの せいだ'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818936
    m_Localized: "Jacob: テレビで言っていること？\nどれも嘘っぱちだ"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818937
    m_Localized: "Jacob: 来訪者より なお悪しきものが\nあるとするならば…"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818938
    m_Localized: 'Jacob: FEMAだ'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818939
    m_Localized: 'Jacob: ああ 飲みたくて たまらない'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818940
    m_Localized: "来訪者は どこから\n来たんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818941
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818942
    m_Localized: 'Jacob: 郊外からだ'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818943
    m_Localized: "Jacob: ああ 隔離区域から かけ離れているのは\n承知だ…"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818944
    m_Localized: 'Jacob: だが 確信がある'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818945
    m_Localized: 'Jacob: 迷信深い人間では ないが…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818946
    m_Localized: 'Jacob: 二年前に噂されていた悪魔と同じだ'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818947
    m_Localized: "Jacob: どうやって街に入ったのか\nそれは不明だ…"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818948
    m_Localized: "Jacob: だが 誰が入れたのか\nそれは把握している"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818949
    m_Localized: 'Jacob: FEMAだ…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818950
    m_Localized: "Jacob: 来訪者は宇宙人ではない\n世間が思っているような"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818951
    m_Localized: "Jacob: 生物だ\n君や私と同じく"
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818952
    m_Localized: 'Jacob: ここで生まれたんだ！'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818953
    m_Localized: 'Jacob: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818954
