  - m_Id: 55784900568014861
    m_Localized: 'Wolfhound: そうか…そうかよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792075
    m_Localized: 'Player: どうぞ'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792076
    m_Localized: 'Player: …'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792077
    m_Localized: 'Player: 持っていてください'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792078
    m_Localized: 'Firefighter: えっ ボクに返すのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792079
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792080
    m_Localized: 'Firefighter: これでボクも連れて行かれるのか…'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539790462976
    m_Localized: いい質問ですね
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434496
    m_Localized: 待ってません
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434497
    m_Localized: "Ballerina: 質問を褒めてるの？\nなんで？"
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434498
    m_Localized: "Ballerina: ちゃんと答えて\nじゃなきゃ 質問無視が好きなのが\n一人いることになる"
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434499
    m_Localized: 'Ballerina: 今のキミ アイツみたい'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434500
    m_Localized: "なにも 待って ないんだ\nなに 一つな"
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434501
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434502
    m_Localized: 'Ballerina: うん'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434503
    m_Localized: "Ballerina: で キミは なにやってんの？\n座り込んで 四方を壁に囲まれてさ"
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434504
    m_Localized: "Ballerina: 待ってるんだよね\nみんなに なにが起きたか\n知りたいんだよね"
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434505
    m_Localized: "なにも 待って ないんだ\nなに 一つな"
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434506
    m_Localized: 銃を構える
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434507
    m_Localized: "Ballerina: わかったわかった\nアタシも だって"
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434508
    m_Localized: "Ballerina: あっ そうだ\nアタシも待ってる って\nもう言ったっけ"
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434509
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434510
    m_Localized: 'Ballerina: でも どうせ彼女は来るよ'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434511
    m_Localized: 'Ballerina: アハハハハハッ！'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434512
    m_Localized: "Ballerina: 踊るの大好き！\n見せてあげよっか？\n引き金 引くだけでいいよ"
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434513
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434514
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434515
    m_Localized: 'Ballerina: おおっと！'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434516
    m_Localized: 'Ballerina: もっかい いっとく？'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434517
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434518
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434519
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434520
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434521
    m_Localized: 'Ballerina: ハッ！'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434522
    m_Localized: "Ballerina: 外したね！\nこんな近くに立ってるのに"
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434523
    m_Localized: 'Ballerina: 目つぶって撃ってんの？'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434524
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434525
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434526
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434527
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434528
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434529
    m_Localized: 撃つ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434530
    m_Localized: 'Ballerina: ぴょんぴょん！'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434531
    m_Localized: 'Ballerina: ふう もう疲れちゃった'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434532
    m_Localized: 'Ballerina: 自分で朽ち果てるほうが楽だね'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683264
    m_Localized: 'Foreigner: ゆおな？'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683265
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683266
    m_Localized: 'Foreigner: わあ しへふれらけ…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683267
    m_Localized: 'Unstable: ったく もう カラッケツ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683268
    m_Localized: "それで どんな話が\nあるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683269
    m_Localized: "Unstable: ああ それそれ\nじゃあさ ネタの交換といこうか\nまず そっちから ってのは？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683270
    m_Localized: "あなたに話すことなど\n別に なにも"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683271
    m_Localized: 本題を お願いします
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683272
    m_Localized: "Unstable: わかったわかったよ\n無理強いは しないって"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683273
    m_Localized: "Unstable: そうだな…あの酒場にいたんだ\nいや酒場じゃ なかったかな\nなんだっけ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683274
    m_Localized: "Unstable: ええっと もう\nなんだっけな 名前…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683275
    m_Localized: それで？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683276
    m_Localized: 'Unstable: そうだそうだ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683277
    m_Localized: "Unstable: とにかく\nうん 夢中で飲んでたわけ\n頼れるエナジェカを ゴクゴク"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683278
    m_Localized: "Unstable: なあなあ\nマジで ヤバいんだぜ\n知らないだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683279
    m_Localized: 'Unstable: もうさ 脳天ブッ飛ぶんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683280
    m_Localized: "Unstable: しかも 一日中 後味が残るんだぜ！\nどこにも売ってないなんて\n萎えるよな…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683281
    m_Localized: それで？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683282
    m_Localized: 'Unstable: おっと そうそう'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683283
    m_Localized: "Unstable: そこで ボケっとしてたんだ\nあまり人も いなくてさ\nヘッドホンで 音楽ガンガン鳴らしてた"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683284
    m_Localized: "Unstable: そしたら 誰かが怒鳴りだしてさ\n爆音にしてんのに 聞こえるぐらい"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683285
    m_Localized: "Unstable: 好きな曲に浸って 夢中になってたのに\n最悪だよな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683286
    m_Localized: "Unstable: 音に没頭して 物思いに耽って…\nそういうの あるじゃん？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683287
    m_Localized: だから？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683288
    m_Localized: 'Unstable: まあまあ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683289
    m_Localized: "Unstable: ヘッドホン外して 見てみたら\nデカい男が 怒鳴りつけてるんだ\n惨めな奴にさ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683290
    m_Localized: "Unstable: なんで揉めてたのか 知らないけど\nノッポの方は ろれつが回ってなかった\nベロンベロン"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683291
    m_Localized: "Unstable: めちゃめちゃに叫んで\n平手打ち かますと\n床に倒れ込んじゃって"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683292
    m_Localized: "Unstable: よろめきながら ノッポさんが\nテーブルに上りはじめた\n頭なんて 天井に届きそうだった"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683293
    m_Localized: "Unstable: それで 大声で叫ぶんだよ\n「クズどもめ！」なんて"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683294
    m_Localized: 'Unstable: クソが扇風機にブチ当たった って感じ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683295
    m_Localized: "Unstable: で 即退散\n巻き込まれたくないじゃん"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683296
    m_Localized: それで？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683297
    m_Localized: "Unstable: それだけ\n近頃ずっと 変な感じ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683298
    m_Localized: "Unstable: どこ行ったって\n誰か 地雷 踏んでる"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683299
    m_Localized: "Unstable: 同じとこ 数日もいれば\nはい オシマイ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683300
    m_Localized: 'Unstable: すぐ喧嘩 死体 棺桶 墓穴'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683301
    m_Localized: 'Unstable: アンタは違うと いいけどな'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683302
    m_Localized: 'Unstable: ったく もう カラッケツ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683303
    m_Localized: "ここは どうです\n落ち着きます？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683304
    m_Localized: 'Unstable: 難しいこと 言うね'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683305
    m_Localized: "Unstable: アンタからは 穏やかで\n家庭的な感じが するよ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683306
    m_Localized: "Unstable: まっ 実際 アンタのウチ いるんだしな\nははっ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683307
    m_Localized: 'Unstable: ここを 安全地帯に したいんだろ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683308
    m_Localized: "Unstable: 誰でも彼でも 入れてるわけじゃ\nないもんな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683309
    m_Localized: "Unstable: でもさ…アンタも 感じてるんだろ\nなにか 変じゃないか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683310
    m_Localized: "Unstable: まっ 世界中 変は変なんだけどさ\nでも アンタは…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683311
    m_Localized: "Unstable: いや よく わかんないや\n俺自身"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683312
    m_Localized: "Unstable: まっ いっか\nエナジェカ飲んで 忘れな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683313
    m_Localized: 'Unstable: 気にすんなって'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683314
    m_Localized: "Unstable: それで いつ\n発つんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683315
    m_Localized: "まだ なにかから\n逃げてるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683316
    m_Localized: 'Unstable: そろそろ かな'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683317
    m_Localized: "Unstable: 長居するのが苦手でさ\n知ってるだろうけど"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683318
    m_Localized: "Unstable: それに 何度か言ったっけ\nははっ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683319
    m_Localized: "Unstable: アンタのウチなら\n楽しいかなって 思ったんだけど"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683320
    m_Localized: "Unstable: でも 死の臭いが プンプンしてら\nなんでだかな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683321
    m_Localized: "Unstable: まっ もう充分 見たってこと\nお腹いっぱい"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683322
    m_Localized: "Unstable: 逃げてる って？\n前に進んでるのさ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683323
    m_Localized: "Unstable: 厄介事は ゴメンだ\nもう充分"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683324
    m_Localized: "Unstable: 長居してると しまいには\n殴られたり 撃たれたり\n閉じ込められたり"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683325
    m_Localized: "Unstable: どんな末路を辿るか\nわかったもんじゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683326
    m_Localized: "Unstable: まっ 歩き回ってれば\n変なのに遭遇するリスクも上がるけど"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683327
    m_Localized: "Unstable: 信じる相手 間違えて\n背中 刺されるよか マシだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683328
    m_Localized: 'Unstable: ったく もう カラッケツ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683329
    m_Localized: "それで？\n準備できました？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683330
    m_Localized: "Unstable: えっ？おっ おお\n今日の夜には出るよ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683331
    m_Localized: 'Unstable: じゃっ またな！'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683332
    m_Localized: "恐怖からは\n逃れられませんよ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683333
    m_Localized: "逃げ延びてください\n災害や 狂人から"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683334
    m_Localized: "Unstable: ああ だろうな\nでも ワンチャンあるだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683335
    m_Localized: "Unstable: アンタは ずっと ここにいるけど\nそんなに いいもの？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683336
    m_Localized: "まあ…\n幸運を祈ります"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683337
    m_Localized: 二度は入れませんからね
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683338
    m_Localized: 'Unstable: それ 皮肉のつもり？'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683339
    m_Localized: "Unstable: とりま ありがとう\nここで一息つけたし\n数日は走れるかな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683340
    m_Localized: 'Unstable: エナジェカは奇跡だぜ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683341
    m_Localized: "Unstable: 気の利いた冗談のつもり かもだけど\nなにか するほうが マシだよ\n脳が煮えるのを 待つよりさ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683342
    m_Localized: "Unstable: 失うものなんて ないんだ\n全部 置いてきた"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683343
    m_Localized: "Unstable: なら なにか追い求めるほうが マシだろ\n手をこまねいて 死を待つよりさ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683344
    m_Localized: 'Unstable: 俺は そんなの ゴメンだ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683345
    m_Localized: "まあ…\n幸運を祈ります"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683346
    m_Localized: 二度は入れませんからね
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683347
    m_Localized: "Unstable: ありがとう\nアンタもな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683348
    m_Localized: "Unstable: また会うかもな\nそのときは 苦労話の ひとつやふたつ\n聞かせてあげるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683349
    m_Localized: "Unstable: もっと話したかったけどさ\n今は ムリ\nアンタのツラ 陰気すぎ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683350
    m_Localized: 'Unstable: もう 戻らないから'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683351
    m_Localized: "Unstable: 戻る意味なんて ない\n残ってるのは 焼け野原だけだから"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683352
    m_Localized: "Unstable: 悪気はないんだ\nただ そんなのばかり 見てきたから"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683353
    m_Localized: "Unstable: なにもかも 置き去りにするほうが 楽\nだから もう会わないで おこう"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683354
    m_Localized: 'Unstable: ったく もう カラッケツ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683355
    m_Localized: まだ いたんです？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683356
    m_Localized: "Unstable: いや そうだけど\nひとつ 警告しときたくてさ！"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683357
    m_Localized: "Unstable: 昨夜 窓に妙なものが 映ってたぞ\n起こそうかと思ったけど \n寝かせたままにしたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683358
    m_Localized: "Unstable: 気をつけなよ\n死が迫ってきてる 絶対"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683359
    m_Localized: 'Unstable: うまく説明 できないけどさ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683360
    m_Localized: "Unstable: 全身 ゾッとしたよ\nカフェインのせい かもだけど"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683361
    m_Localized: 'Unstable: でも きっと違う'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683362
    m_Localized: "Unstable: とにかく 警告しなきゃ って思ったんだ\nなにか起こる前に"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683363
    m_Localized: "Unstable: アンタこそ\n出たほうが いいんじゃないか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683364
    m_Localized: "Unstable: そんな顔するな って\nバカ言ったよ わかってる\nわかってる ってば"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683365
    m_Localized: "Unstable: まっ 警告はしたからな\nじゃっ マジでサヨナラ\nここの焼け跡 見たかないからな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683366
    m_Localized: 'Rocker: ああ ギターが弾きてえ…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683367
    m_Localized: ぼんやりしてます？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460480
    m_Localized: "Rocker: ん？ああ\n昔のダチを数えてたんだ\nまだ何人 生きてるか 頭ん中で"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460481
    m_Localized: "Rocker: あの頃 誰かの葬式があるたび\n必ず 音 出してたんだ\n寝床で腐ったり 酒で潰れるより\nマシだからな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460482
    m_Localized: "Rocker: あるときなんざ 三日三晩 ブッ続けで\n同じリフ かき鳴らして\n指が血塗れで動かなくなるまで 弾いた"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460483
    m_Localized: "Rocker: 燃え尽きちまった バカのツラ\n頭の中で 堂々巡りする暇もねえくらい"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460484
    m_Localized: "Rocker: 今は 毎日毎日 クソみてえだ\n来訪者だの 灼熱の太陽だの\n地獄の蓋が開くことに\n俺自身 錆び付いて 慣れちまってる"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460485
    m_Localized: 'Rocker: ああ ギターが弾きてえ…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460486
    m_Localized: "つらいですか？\nギターなしで？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460487
    m_Localized: 'Rocker: そりゃそうだ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460488
    m_Localized: "Rocker: 台所でのジャムを思い出してた\n椅子にアンプ ボリューム抑えて演奏だ\n近所の連中に通報されねえように"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460489
    m_Localized: "Rocker: 一曲 終わるたび 間を置いてた\nじっと黙ってると 誰かが一言\n「この曲は アイツのために」それだけ\n泣き叫んだりなんだりは ナシ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460490
    m_Localized: "Rocker: 自分の頭カチ割る ぐれえなら\nギター ブッ壊したほうが マシだ\n替えが効くからな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460491
    m_Localized: "Rocker: あの頃は マジで信じてたんだ\nソファでのギグから\nなにか本物が生まれるはずだ って"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460492
    m_Localized: "Rocker: でも 街に吸い尽くされちまったよ\n仲間と うまくやるより先にな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460493
    m_Localized: "Rocker: バカが ヤク 過剰摂取したり\n車でブッ飛んだり そんなのばっかだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460494
    m_Localized: "Rocker: クソみてえな人生だよ\nマジでな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460495
    m_Localized: "Rocker: 明日の夜には出ていく\n行かなきゃなんねえ とこがある"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460496
    m_Localized: 'Rocker: ああ ギターが弾きてえ…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460497
    m_Localized: "それで？\n昨夜は どこへ？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460498
    m_Localized: "Rocker: ああ 昔の練習スタジオ 覗いてきた\n壁はカビだらけ 配線は剥き出し\nなんもかも ムチャクチャだった"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460499
    m_Localized: "Rocker: メトロノームつけて しばらく聞いたが\nなんも ノらなかった\nただの空っぽだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460500
    m_Localized: "Rocker: 夢見る意味なんて あんのか\nって感じだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460501
    m_Localized: "Rocker: 「ロックンロールは死なない」？\nハッ！"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460502
    m_Localized: "Rocker: 太陽に焼かれなかろうと\n来訪者が現れなかろうと\nどうせ別のもんに つまづいてたろうさ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460503
    m_Localized: "Rocker: ガキの頃は マジで思ってたよ\n暗黒時代は とうの昔のもんだと"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460504
    m_Localized: "Rocker: 不況だの戦争だの みんな過去の話で\n俺たちは今 マジで生きてるんだと"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460505
    m_Localized: "Rocker: クソッタレ\nどうかしてたな…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460506
    m_Localized: 'Rocker: ああ ギターが弾きてえ…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460507
    m_Localized: なに考えてるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460508
    m_Localized: "Rocker: ふと気づいたんだ 俺が吹聴してたのは\nどれも 他人の前座や穴埋めの話で\n自分の舞台なんて ひとつもなかった\n多分 これからもな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460509
    m_Localized: 'Rocker: なんで お前に見栄張ったんだかな'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460510
    m_Localized: "Rocker: ちょっと 振りしてみたかったのかもな\nなにもかも やり切ったようなツラして"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460511
    m_Localized: "Rocker: 「地獄を潜って強くなった」なんて\nあれも全部 ウソだ\nただ フードかぶって\n泣き顔 隠してただけのガキだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460512
    m_Localized: "Rocker: お前に銃を向けられた瞬間\nなにかが イカれちまった\n昔の自分を殺し 何者かになった気が\n蓋を開けりゃ このザマだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460513
    m_Localized: "Rocker: このまま続けてりゃ ダチと同じハメだ\nヤクを過剰摂取するか\nカミソリ持って湯船で血を流すか\nどっちみち くだらねえ オチ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460514
    m_Localized: "Rocker: 俺は来訪者なんか じゃねえ\n燃え尽きて 今にもイカれそうな\nただのクソ野郎だ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460515
    m_Localized: 'Rocker: 撃ちてえなら…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460516
    m_Localized: 'Rocker: いや もう どうでもいい ダチ公'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460517
    m_Localized: 'Rocker: どうでもいいんだ…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460518
    m_Localized: 'Experienced: 順調か 同房？'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460519
    m_Localized: "刑務所に入ってたのに\n入れ墨はないんですね？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460520
    m_Localized: "Experienced: スミがねぇから って\nムショ暮らししてねぇ とは\n限らねぇだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460521
    m_Localized: "Experienced: 表紙で本を判断するなよ\n単純な話"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460522
    m_Localized: "Experienced: そりゃ タタキで ムショ入りしたとも\nでも コロシは やっちゃいねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460523
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460524
    m_Localized: "Experienced: 気ぃ悪くすんなよ ニイちゃん\nでも ひとつ訊かせな\nなんで お前さんが ここ仕切ってんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460525
    m_Localized: どういうことです？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460526
    m_Localized: 放っといてください
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460527
    m_Localized: "Experienced: 誰でも彼でも入れてんだろ\n浮浪者だの 変人だの"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460528
    m_Localized: "Experienced: ああいうヤカラは 揉め事の種だ\nムショ暮らしで 骨身に染みてる"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460529
    m_Localized: 'Experienced: 厄介事だらけになるぜ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460530
    m_Localized: "Experienced: たとえば ヨボヨボのジジイを入れる\nそいつがソファで くたばったら\nどうするよ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460531
    m_Localized: "Experienced: 連中 お前さんを罵るぜ\n死んだ責任 おっ被せてくる\nだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460532
    m_Localized: "Experienced: それか 女なら どうだ\n誰かが孕ましちまったら\nどうするよ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460533
    m_Localized: "Experienced: ガキの面倒 見るつもりか？\nそんなヤクネタ 踏みてぇか？あん？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460534
    m_Localized: "Experienced: オチは ひとつきりだ ニイちゃん\nマジモンの 男だけにしとけ\nオレと お前さんみたいな\n動けるヤツだけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460535
    m_Localized: "老人や女性 子供は\nみんな締め出せと？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460536
    m_Localized: "刑務所上がりが\nよく言いますね？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460537
    m_Localized: "Experienced: 呑み込むよ ニイちゃん\n口出しは やめとく"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460538
    m_Localized: "Experienced: イラつかせる つもりは なかった\nお前さんの家なら お前さんの規則だ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460539
    m_Localized: 'Experienced: ただよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460540
    m_Localized: "Experienced: なんでまた どいつもこいつも\nまだ 服なんて 着てんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460541
    m_Localized: "Experienced: ニイちゃん 頭が回るんだから\n服なんて いらねぇだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460542
    m_Localized: 本当 図々しいですね
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460543
    m_Localized: "いつから専門家に？\n刑務所を出た その日から？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460544
    m_Localized: "Experienced: なぁ 言いてぇのは ひとつだ\n誰でも彼でも 入れるな\nいつか 噛みつかれる"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460545
    m_Localized: 本当 図々しいですね
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460546
    m_Localized: "いつから専門家に？\n刑務所を出た その日から？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460547
    m_Localized: 'Experienced: 笑えると 思ってんのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460548
    m_Localized: "Experienced: 呑み込むよ ニイちゃん\n口出しは やめとく\n二度目は ナシだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460549
    m_Localized: 'Experienced: ただよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460550
    m_Localized: "Experienced: なんでまた どいつもこいつも\nまだ 服なんて 着てんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460551
    m_Localized: 'Experienced: 順調か 同房？'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460552
    m_Localized: "そんな格好で\n寒くないですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460553
    m_Localized: "Experienced: どういう意味だ？\nパンツ一丁の ことか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460554
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460555
    m_Localized: 'Experienced: からかってんのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460556
    m_Localized: "Experienced: 太陽にケツ こんがり焼かれてんだぞ\n路上は黒焦げ死体まみれだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460557
    m_Localized: "Experienced: なのに お前さんはセーターだ\nマジで言ってんだぞ 脱げ\n汗だくになるぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460558
    m_Localized: "この服は私の\n一部なんです"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460559
    m_Localized: 大丈夫です
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460560
    m_Localized: 'Experienced: 一部ねぇ…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460561
    m_Localized: 'Experienced: まぁ 好きにしな'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460562
    m_Localized: "Experienced: 外は 地獄みてぇに熱いのに\nどいつもこいつも 服なんて着て\nこの期に及んで 着飾ってやがる"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460563
    m_Localized: "Experienced: ふざけやがって\n股間に汗 ダラダラ垂らしときながら\n濡れたケツ 見られるのはイヤなんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460564
    m_Localized: "Experienced: それか 着込んどきながら\n汗ひとつ かいてねぇヤツがいたら\nそれこそ マトモじゃねぇよな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460565
    m_Localized: 私を来訪者だと？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460566
    m_Localized: なにが 言いたいんです？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460567
    m_Localized: "Experienced: おいおい マジかよ\nこっちはケツ丸出しでも 熱いのに\nそっちはセーター着てて ケロリだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460568
    m_Localized: "Experienced: ありえねぇだろ\n股間に汗 ダラダラ垂らしときながら\n濡れたケツ 見られるのはイヤなんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460569
    m_Localized: "Experienced: なあ 浜辺に行ってみろよ\n水着だろうとビキニだろうと平気だ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460570
    m_Localized: "Experienced: だが ここはリゾートじゃねぇ\n真剣だ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460571
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460572
    m_Localized: "Experienced: それか 着込んどきながら\n汗ひとつ かいてねぇヤツがいたら\nそれこそ マトモじゃねぇよな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460573
    m_Localized: 私を来訪者だと？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460574
    m_Localized: なにが 言いたいんです？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460575
    m_Localized: "Experienced: 落ち着けって ニイちゃん\nそうじゃねぇよ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460576
    m_Localized: "Experienced: お前さんは真っ当だ\nセーター着たけりゃ 好きにすりゃいい"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460577
    m_Localized: "Experienced: だがな 他のアホどもは別だ\n浜辺でコート着るような連中"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460578
    m_Localized: "では 私にも\n脱げと？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460579
    m_Localized: "大した理屈ですね\nどう思いついたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460580
    m_Localized: "Experienced: なぁ ニイちゃん オレに言わせりゃ\n今どき 服着てる理由は ふたつきりだ\n救いようのねぇアホか 人間じゃねぇか"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460581
    m_Localized: "Experienced: あのバケモン とっくに死んでんだろ\nだから 熱を感じねえんだ\nスジが通ってんだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460582
    m_Localized: "では 私にも\n脱げと？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460583
    m_Localized: "大した理屈ですね\nどう思いついたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460584
    m_Localized: "Experienced: いや ニイちゃん\nそうじゃねぇんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460585
    m_Localized: 'Experienced: 汗だくが趣味なら 好きにしな'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460586
    m_Localized: "Experienced: ただな どう考えてもイカれてんだろ\nこんな炎天下で 服 着てるなんざ\nクソマヌケに違いねぇ\nそれか…\n"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460587
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460588
    m_Localized: "Experienced: マジで言ってんだよ ニイちゃん\nこんな炎天下で重ね着なんざ\nクソの極みだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460589
    m_Localized: "Experienced: どこのアホが こんな暑さで 服を着る？\nそう言いたいだけだ\nそんなヤツ クソマヌケに違いねぇ\nそれか…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460590
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460591
    m_Localized: "Experienced: …まぁ やめとくか\nウンザリだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460592
    m_Localized: 'Experienced: 順調か 同房？'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460593
    m_Localized: "こないだは なにを\n言いかけてたんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460594
    m_Localized: "Experienced: いいか ニイちゃん\nそりゃ 教えてやれる\nだがな まずは 聞く気があるかだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460595
    m_Localized: ええ
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460596
    m_Localized: いえ
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460597
    m_Localized: "Experienced: よし ニイちゃん\nじゃあ ハッキリ言わせてもらうぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460598
    m_Localized: "Experienced: 要するに\nここいらの連中 みんな腐ったミカンだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460599
    m_Localized: どうして ですか？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460600
    m_Localized: "人間を果実だと思ってるのは\n昔から ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460601
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460602
    m_Localized: 'Experienced: イカれてんのか？'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460603
    m_Localized: 'Experienced: なら なんで訊いたんだよ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460604
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460605
    m_Localized: "Experienced: どいつもこいつも 頭どうかしてやがる\nマトモな連中は ムショの中だけか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460606
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460607
    m_Localized: "Experienced: もういい\nこれ以上 しゃべったら\nオレまで イカれちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460608
    m_Localized: "Experienced: なぁ ニイちゃん 暑くねぇなら\nこんな格好で うろちょろするか？\nパンツ一丁で バナナ ひけらかして"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460609
    m_Localized: "Experienced: オレに言わせりゃな\nどいつもこいつも 平気なツラして\nどうして 着込んで歩いてられんだ\n暑さを感じてねぇ みてぇに"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460610
    m_Localized: "Experienced: お前さん ずっと自由の身だったんだろ\nオレと違って\nなのに まるで地下シェルターにでも\n閉じこもってたみてぇだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460611
    m_Localized: "Experienced: そもそも マジで来訪者を\n見分けられんのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460612
    m_Localized: "ええ 徴候は知ってます\nテレビで見ました"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460613
    m_Localized: "確かなことは\n誰にも わかりません"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460614
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460615
    m_Localized: 'Experienced: 冗談だろ ニイちゃん'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460616
    m_Localized: "Experienced: いいか 言っとくぞ！\n着込んでるヤツが 来訪者だ！"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460617
    m_Localized: "Experienced: そもそも マジで来訪者を\n見分けられんのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460618
    m_Localized: "ええ 徴候は知ってます\nテレビで見ました"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460619
    m_Localized: "確かなことは\n誰にも わかりません"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460620
    m_Localized: 'Experienced: ならいいけどな ニイちゃん'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460621
    m_Localized: "Experienced: その徴候とやらが 全部デタラメ\nなんてクソみてぇな オチだったら\n今度は そっちがムショ行きだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460622
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460623
    m_Localized: "Experienced: つまり 当てずっぽうで\n吊るし上げるしか ねぇってのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460624
    m_Localized: "Experienced: まぁ 他に手立てがねぇなら\nしょうがねぇんだろうな\nそうやって 慣れてくんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460625
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460626
    m_Localized: "Experienced: マジな話 ニイちゃん\n今 起きてることを見てるとよ…もう\n人間らしさなんて 残ってねぇんだな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460627
    m_Localized: "Experienced: ムショのほうが\nまだ 安全だった"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460628
    m_Localized: '#REF!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460629
    m_Localized: 'Experienced: 順調か 同房？'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460630
    m_Localized: "言ったろ 刑期満了だ\n三度も ブチ込まれたんだぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460631
    m_Localized: 'Experienced: 一度目は 未成年だった'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460632
    m_Localized: 'Experienced: 出たら 真っ当に生きるつもりだった'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460633
    m_Localized: "Experienced: マジで そうしたんだよ\n女房を見つけ ガキも作った\n昔の悪さは全部やめた"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460634
    m_Localized: "Experienced: それから 不況が来ちまった\nタタキを やるしかなくなったんだ\n家族を食わせるためにな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460635
    m_Localized: 'Experienced: 気づいたときには クソ穴へ逆戻り'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460636
    m_Localized: "Experienced: 二度目のムショ行きは当然だった\n三度目は 自分から入ったんだ\nシャバじゃ 生きてけなかったからな…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460637
    m_Localized: "Experienced: 女房は別の男を見つけ\nガキはオレを怖がって\nマエのせいで シノギにも ありつけねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460638
    m_Localized: "Experienced: そうやって\n人生が半分 過ぎた"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460639
    m_Localized: 'Experienced: 何故 戻らないんです？'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460640
    m_Localized: 気の毒でしたね
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460641
    m_Localized: "別に 戻れねぇワケなんざ ねえさ\nただ 戻るワケを 見つけてねぇだけだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460642
    m_Localized: "Experienced: 何事も時期ってもんがある\nどんなことにだって時間があるんだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460643
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460644
    m_Localized: "Experienced: 同情なんていらねぇからな ニイちゃん\n自業自得だ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460645
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460646
    m_Localized: "Experienced: ムショ入りしてる間に\n世界は すっかり様変わり しちまった"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460647
    m_Localized: "Experienced: オレは もう老犬だ\n新しい芸なんて 覚えられねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460648
    m_Localized: "Experienced: よく言うだろ\n三つ子の魂 百まで って"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460649
    m_Localized: "Experienced: オレも同じだ ニイちゃん\nガキの頃から 変わりゃしねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460650
    m_Localized: "Experienced: 今の時代には とても馴染めねぇ\n猫も杓子も 疑いあってばかりだ\n目が合っただけで ブッ刺されちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460651
    m_Localized: 'Experienced: オレはな 腹を割るのが好きなんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460652
    m_Localized: "Experienced: 信じらんねぇ かもだが ムショじゃ\nどいつもこいつもバカ正直で\nどんなヤツか一発で わかる"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460653
    m_Localized: "Experienced: シャバは違う\n誰がマトモで 誰がイカれてるか\n見分けが つかねぇ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460654
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460655
    m_Localized: "Experienced: 哲学者ぶる気はねぇ けどな\n人間らしくするのが そんなに大変か？\nムショの連中のほうが 正気\n保ってたけどな なんでだか…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460656
    m_Localized: "Experienced: シャバのほうが よっぽど\nド腐れ だらけじゃねぇか…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460657
    m_Localized: "Jacket: チクショウ\nなにもかも どうかしてやがる…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460658
    m_Localized: "寮暮らし\nだったんですよね？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460659
    m_Localized: "Jacket: ああ 言ってなかったけどよ\nここ出身じゃなくて 勉強しに来たんだ\nそしたら とんでもないことに…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460660
    m_Localized: "Jacket: しょっぱな 寮に閉じ込められたんだ\nウイルスが広がらないように って\nそれから…黄色い防護服の連中が来た"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460661
    m_Localized: "Jacket: その時点で イヤな予感してた\nでも 感染者は隔離区域 行き\nって聞いて…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460662
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460663
    m_Localized: "Jacket: 連れ去られるのを\n手をこまねいて待つ気は なかった\nそれで 窓から抜け出したんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460664
    m_Localized: "Jacket: このジャケット ひっ掴んでよ\nでも 行き場が なくって\nそれで 玄関先に辿り着いた ってワケ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460665
    m_Localized: ジャケットだけで？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460666
    m_Localized: 他の ものは？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460667
    m_Localized: "Jacket: ああ\n大切なジャケットだからな"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460668
    m_Localized: "Jacket: そりゃ\n身分証や小物なんかも持って出たけど\n大事なのは このジャケットひとつだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460669
    m_Localized: "Jacket: 勘違いしないでくれよな\n値段だのブランドだのが どうとか\nってんじゃないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460670
    m_Localized: 'Jacket: 数少ない 兄貴の痕跡なんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460671
    m_Localized: "Jacket: チクショウ\nなにもかも どうかしてやがる…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460672
    m_Localized: お兄さんに なにが？
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460673
    m_Localized: "Jacket: 早い話 FEMAに拉致られて\nそれっきり"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460674
    m_Localized: 'Jacket: 兄貴 船乗りでよ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460675
    m_Localized: "Jacket: このジャケットもよ…\n航海帰りの土産だったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460676
    m_Localized: "Jacket: てっきり 妙な色したボールペンだの\n冷蔵庫に貼るマグネットだの\n手土産にするもんだと…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460677
    m_Localized: "Jacket: なのに ちゃんとしたジャケットひとつ\n買ってきてくれたんだよ！\nホント嬉しかった"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460678
    m_Localized: "Jacket: そんな絡んだこと なかったのに\nオレのこと 考えててくれたんだ\n舞い上がっちまったよ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460679
    m_Localized: "Jacket: まあ このジャケットのせいで\n揉め事に なったこともあるけどな\nそこらじゃ売ってないだろ こういうの"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460680
    m_Localized: "Jacket: 目を付けたら パクろうとする\nヤツまで いやがるしよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460681
    m_Localized: "Jacket: でも 手放すもんかよ\nただのジャケットじゃない\n兄貴との思い出なんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460682
    m_Localized: "Jacket: 無事で いてくれると\nいいんだけどな…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460683
    m_Localized: "Jacket: チクショウ\nなにもかも どうかしてやがる…"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460684
    m_Localized: "隔離区域に行って\nお兄さんを探すというのは？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460685
    m_Localized: 'Jacket: そう簡単でもなくてよ'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460686
    m_Localized: "Jacket: 兄貴は隔離区域に送られたんじゃない\n文字通り FEMAに拉致られたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460687
    m_Localized: それって…
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460688
    m_Localized: 最悪ですね
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460689
    m_Localized: "Jacket: ああ\n兄貴は もう 連中の仲間だ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460690
    m_Localized: "Jacket: 選択の余地もナシだ\n玄関先に押しかけてきて\n「貴方で構いません」だ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460691
    m_Localized: "Jacket: 兄貴が好き好んで\n参加するワケがない\nあり得ない"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460692
    m_Localized: "Jacket: それで オレは\n絶対にFEMAに捕まりたくないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460693
    m_Localized: "Jacket: 来訪者に ビビってるワケじゃない\nその 他の連中みたいに"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460694
    m_Localized: "Jacket: みんな 震えてるのは\n目の前のヤツが 人間かどうかだ…\nでも オレは違う"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460695
    m_Localized: "Jacket: 黄色い防護服の連中に拉致されるとき\nその相手が 兄貴だったら？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460696
    m_Localized: "Jacket: 兄貴は どうする？\n規則を破って 逃がしてくれるか？\nそんなことして 兄貴は どうなる？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460697
    m_Localized: "Jacket: それとも 命令に従って\n他の連中と一緒に\n隔離区域へ連行する？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460698
    m_Localized: 'Jacket: そして オレを撃てと命じられたら？'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460699
    m_Localized: "Jacket: 実の兄弟に引き金を引かれるほうが\n幸せ なんだろうか？\nそれとも 悪夢なんだろうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460700
    m_Localized: 'Jacket: どっちみち イカれてる'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460701
    m_Localized: "Jacket: 渦巻く不安の数は 千じゃ きかない\nだが ホントに怖いのは ひとつだけ"
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460702
    m_Localized: "Jacket: いつの日か オレが拉致られる時\nあのマスクの下が兄貴なのかどうか\n永遠に わからないかもしれない…"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725184
    m_Localized: "Tough: 楽して手に入る モンなんてない\nなにひとつ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725185
    m_Localized: "苦労してきた\nみたいですね？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725186
    m_Localized: "Tough: 楽して生きてきた連中\n今頃 全員 くたばってるんじゃない"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725187
    m_Localized: "Tough: 金で 世界の王になれなくなった途端\nやわい連中は 常軌を逸したんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725188
    m_Localized: "Tough: 芯が なければ すぐ犠牲者になる\n強姦魔や 魔が差したヤツの\nそれと 狂人も"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725189
    m_Localized: "Tough: アンタだって 見てきたろ？\n人間が どんどん ケダモノになるのを\nでも アタシらは違う"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725190
    m_Localized: "Tough: あんな風になんて 落ちるもんか\n殴り返せるだけじゃない\n他のヤツに 手だって差し伸べられる"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725191
    m_Localized: 'Tough: 生き残る意思のあるヤツにはね'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725192
    m_Localized: "Tough: クズやノロマ 拳を下ろしたヤツは\n世界から淘汰されるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725193
    m_Localized: "Tough: ああ 過激に聞こえるだろうさ\nでも それが世界の理なんだ\nアタシらじゃ どうしようもない"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725194
    m_Localized: "Tough: できるのは せめて人間性を\n保つことぐらい\nここが その役に立てば いいけどね"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725195
    m_Localized: "Tough: 楽して手に入る モンなんてない\nなにひとつ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725196
    m_Localized: そうですかね
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725197
    m_Localized: "Tough: 「なんとかなる」なんて 言えるもんか\nまあ 口にするのは簡単だけどさ\nなにも変わりゃしない"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725198
    m_Localized: "Tough: おためごかしに意味なんてない\n地獄へ落ちる覚悟が できてるか…\nできてないか それだけ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725199
    m_Localized: "他人を慰める\n義理は ありませんよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725200
    m_Localized: "言われたくありませんか？\n一度くらいは そんな言葉"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725201
    m_Localized: 'Tough: いいこと 言うね'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725202
    m_Localized: "Tough: 手を取るだけじゃなく ケツまで\n拭いてやる必要のあるヤツ いるだろ\n自分じゃ なにひとつ できないヤツ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725203
    m_Localized: "Tough: ああいう手合いは いざ事が起きたら\n真っ先に 折れちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725204
    m_Localized: "Tough: ドミノ倒し みたいにさ\n周り巻き込んで ブッ倒れるんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725205
    m_Localized: "Tough: 「なんとかなる」なんて言葉じゃ\nなにも変わらない"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725206
    m_Localized: 'Tough: もう あんなの 真っ平ゴメン'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725207
    m_Localized: "Tough: ウンザリだよ…\nこんな弱さ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725208
    m_Localized: "Tough: ちょっと キツすつぎたかな\nまだ 記憶が生々しくてさ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725209
    m_Localized: 'Tough: 続きは また今度'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725210
    m_Localized: 'Tough: えっ？'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725211
    m_Localized: 'Tough: そんなの なんの意味が？'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725212
    m_Localized: "Tough: 言葉じゃ なにも変えられない\n死人が蘇る？\n強姦魔のキンタマが切り落とせる？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725213
    m_Localized: "Tough: ナイフなら持ってる\nでも クスリに混ぜる砂糖なら品切れ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725214
    m_Localized: "Tough: 新世界に適応するか 死ぬかだ\n他は全部 くだらない"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725215
    m_Localized: "Tough: 八つ当たり したいワケ じゃない\nただ バカ言わないで"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725216
    m_Localized: "Tough: 楽して手に入る モンなんてない\nなにひとつ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725217
    m_Localized: "それで…\nどうかしました？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725218
    m_Localized: 'Tough: ハッキリ 言っとく'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725219
    m_Localized: "Tough: 見たんだ\nアンタが物置の箱 見つめてるのも\n寝室の窓辺で 立ち尽くしてるのも"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725220
    m_Localized: "Tough: 夜中 あの箱 覗かせてもらった\nアンタ この家に囚われてるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725221
    m_Localized: "Tough: 生き延びようともしてない\nただ 死ぬのが怖いだけ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725222
    m_Localized: 'Tough: 図星？'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725223
    m_Localized: いえ
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725224
    m_Localized: 黙れ
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725225
    m_Localized: 'Tough: ウソつき'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725226
    m_Localized: "Tough: 今 カチコチに緊張してたろ\nわかるんだから"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725227
    m_Localized: "Tough: 自殺しない理由は たった ひとつ\n怖いだけ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725228
    m_Localized: "Tough: はじめは\n地獄を潜ってきた ヤツだとばかり\n過酷な人生に 耐え忍んできたんだと"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725229
    m_Localized: "Tough: でも実際は ただのビビり屋\n運良く 不幸に見舞われなかっただけ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725230
    m_Localized: 'Tough: 正直…ガッカリだよ'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725231
    m_Localized: 'Tough: もう 口ききたかないね'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725232
    m_Localized: "Tough: あんた見てると思い出すよ\n隅っこで虐められてる ガキを"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725233
    m_Localized: "Tough: これで ハッキリした\nアンタは他の連中と同じ ただの弱虫"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725234
    m_Localized: "Tough: ただ たまたま手元に 銃があっただけ\nそれだけ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725235
    m_Localized: "Tough: はじめは\n地獄を潜ってきた ヤツだとばかり\n過酷な人生に 耐え忍んできたんだと"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725236
    m_Localized: "Tough: でも実際は ただのビビり屋\n運良く 不幸に見舞われなかっただけ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725237
    m_Localized: 'Tough: 正直…ガッカリだよ'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725238
    m_Localized: 'Tough: もう 口ききたかないね'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725239
    m_Localized: "Tough: 楽して手に入る モンなんてない\nなにひとつ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725240
    m_Localized: "他に なにか\n漁りました？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725241
    m_Localized: "Tough: 生きるためなら なんでもする\nそれだけの話"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725242
    m_Localized: "Tough: 自分が 誰のところに来て\nなにに 警戒すべきか\n知らなきゃならない"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725243
    m_Localized: "Tough: この家は 死んだ家族の記憶だらけ\nアンタは 過去を忘れられないんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725244
    m_Localized: 'Tough: 多分 きっとね'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725245
    m_Localized: 'Tough: でも それは口出しする ことじゃない'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725246
    m_Localized: 'Tough: ただ…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725247
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725248
    m_Localized: "Tough: アタシだって 昔は もっと優しかった\n若かった\nある男と出会うまで"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725249
    m_Localized: "Tough: アイツ 言ったんだ\n「オフクロへの荷物が あるから\nちょっと ウチに寄らないと」って\nアタシは 中に入りたくなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725250
    m_Localized: "Tough: それで外で待つことにした\nでも しばらくしたら 窓から叫び声\n「上がってこいよ」って"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725251
    m_Localized: "Tough: 中に入ったよ\nでも 母親なんて いなかった\nあのゲス野郎と ツルんでる連中だけ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725252
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725253
    m_Localized: "Tough: それから 世界が崩壊して\nアイツらを見つけた"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725254
    m_Localized: 'Tough: スッキリ とはいかなかった…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725255
    m_Localized: "Tough: ずっと 自分は汚れてると思ってた\nどれだけ洗っても キレイにならないと\n世界が終わるまでは"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725256
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725257
    m_Localized: "Tough: あんなロクデナシに 同情の余地はない\nそして 弱虫にも\n増長させるだけだから"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725258
    m_Localized: "Tough: もう アンタの私物 漁らないよ\nでも アタシのこと わかってくれたろ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725259
    m_Localized: "Bald: 燃えろよ燃えろ 炎よ燃えろ…\nなんてね"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725260
    m_Localized: "どんな友人\nだったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725261
    m_Localized: "Bald: 嗚呼！\nみんな演劇学校で出会った連中でね"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725262
    m_Localized: "Bald: 私は演劇制作を専攻してたんだ\n言っておくけど ご友人\nまったく お勧めしないからね"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725263
    m_Localized: "Bald: むしろ 演劇業界そのもの 非推奨だ\n見た目は気取っちゃいるけどね\n誰も舞台なんて見ちゃいない"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725264
    m_Localized: "Bald: まっ 無欲恬淡と芸術に殉じ\n生涯 貧乏暮らしが お望みなら\nどうぞ ご自由に"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725265
    m_Localized: "Bald: 演劇に貧乏は付きものだ\n大劇場に看板 掲げられる劇団なんて\nほんの一握り"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725266
    m_Localized: "Bald: しかも現代劇は皆 低予算\n観客は興味の欠片もなし\n映画の方が 手軽 格安 豪華ときた"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725267
    m_Localized: "Bald: 要するに 大コケ ってこと\nご友人"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725268
    m_Localized: "Bald: 燃えろよ燃えろ 炎よ燃えろ…\nなんてね"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725269
    m_Localized: "劇場の酷さは承知しましたが\n友人は どうだったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725270
    m_Localized: "Bald: おっと そうだそうだ\n顛末を伝えて なかったね\nすまないね すぐ脱線してしまって\n集中するのが苦手で とにかく"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725271
    m_Localized: "Bald: 友人は皆 役者や制作に 音響 照明\nそういう役どころ だったんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725272
    m_Localized: "Bald: はじめは 毎日 飲んでたよ\n誕生日に 小劇場の舞台を借りたら\n百人は来てくれたんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725273
    m_Localized: "Bald: あれは格別だったね！\n百人もの人が 自分を祝いに来てくれた\n嗚呼 いい時代だったなあ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725274
    m_Localized: "Bald: でも 演劇業界というのは毒まみれだ\n誰もが 互いに足を引っ張ろうとしてる\nカネはないのに ストレスは満載"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725275
    m_Localized: 'Bald: そのうち 集まることも なくなった'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725276
    m_Localized: "Bald: それで 気づいたんだ\n誕生日に集まってくれた人達の大半は\n本物の友人じゃなかったんだ\nただ…"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725277
    m_Localized: "Bald: 利用するのに都合が良かったか\n陰で罵詈雑言を叩いていたか"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725278
    m_Localized: "Bald: でも 誤解しないで くれたまえよ！\n腰を落ち着けて リストを作ったんだ\n誰を切り 誰を残すべきか 整理して"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725279
    m_Localized: "Bald: 燃えろよ燃えろ 炎よ燃えろ…\nなんてね"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725280
    m_Localized: "リストの人達は\nどうしてるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725281
    m_Localized: "Bald: 取り立て屋と揉めたとき\n助けを求めたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725282
    m_Localized: "Bald: でも 折悪しく 太陽が人を焼き\n来訪者が這い出してきてね\n事態は急転直下"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725283
    m_Localized: "Bald: だから 友人宅を一軒一軒\n見て回ったよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725284
    m_Localized: "Bald: 太陽で丸焼けになった友もいた\n夜中 酒を飲んで 遊び場で寝転んで\n夜明けまで目覚めなかった"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725285
    m_Localized: "Bald: 殺された友もいた…\n信じられるかい？\n来訪者と見なされたんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725286
    m_Localized: "Bald: 常軌を逸しているよ！\n徴候とやら まったくのデタラメだ！\nなんの理由もなく 皆 殺されたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725287
    m_Localized: "Bald: 怒りが湧いて しょうがないよ\nどうしていいか 見当も付かない"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725288
    m_Localized: "Bald: 激情と無力が混ぜこぜ になって\n体が麻痺してしまう\n誰も彼も 憎くて憎くて仕方がない\n自分自身すらも"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725289
    m_Localized: "Bald: 畜生…\nあの豚野郎ども"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725290
    m_Localized: "Bald: 燃えろよ燃えろ 炎よ燃えろ…\nなんてね"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725291
    m_Localized: "それで 債権業者とは\nどういう事情ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725292
    m_Localized: 'Bald: 母と祖母と 暮らしていてね'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725293
    m_Localized: "Bald: 父は とっくに消えていた\n同じ役者でね 女癖も酒癖も悪かった\n典型的な役者崩れだ\n母は衣装を縫っていたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725294
    m_Localized: "Bald: 生まれてこの方\n母は 私を守ろうとしてくれた\n大人になってから 気づいたんだ\n家族は首まで厄介事に浸かっていたと"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725295
    m_Localized: "Bald: 母は 常に職が あったわけじゃない\n大劇場？土台 無理な話さ\n小劇場？給金は雀の涙か 仕事自体なし"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725296
    m_Localized: "Bald: それで 借金を背負ったんだ\n知人ではなく どこかの業者から\n家族を食べさせようと"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725297
    m_Localized: "Bald: 無論 返済できるはずもない\nそこで 取り立て屋の登場だ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725298
    m_Localized: "Bald: 厳格な家訓があったよ\n「予定外の訪問は 相手しないこと」"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725299
    m_Localized: "Bald: 家の前まで帰って 誰か うろついてたら\n何時間か 街を歩くんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725300
    m_Localized: 'Bald: 正気の沙汰じゃない'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725301
    m_Localized: "Bald: 状況が悪化の一途を辿る に従い\n取り立て屋も凶暴化していった"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725302
    m_Localized: "Bald: ある日 帰宅したら ドアが開いていた\n室内は無茶苦茶で 母と祖母は…嗚呼…\n指や足を…折られていた"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725303
    m_Localized: 'Bald: 正真正銘 悪夢だった'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725304
    m_Localized: 'Bald: それから 二人の大男が現れて…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725305
    m_Localized: "Bald: 私は逃げた\nそう 逃げたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725306
    m_Localized: 'Bald: 恐ろしかった'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725307
    m_Localized: "Bald: でも 嗚呼 自分が嫌になる\n守らなかったこと\n尻尾を巻いて逃げたこと\n戻りもしなかったこと"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725308
    m_Localized: 'Bald: ただ 恐ろしかった'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725309
    m_Localized: 'Bald: 自分自身が 恐ろしかったんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725310
    m_Localized: 'Bald: 最低と言うより 他にない…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725311
    m_Localized: "Nervous: もう 戻りたくないよお\nへへへ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725312
    m_Localized: 少し 変わってますね
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725313
    m_Localized: 'Nervous: キミは どうなのお？'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725314
    m_Localized: "Nervous: キミも ボクのこと\nつけ回してる？ねえ？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725315
    m_Localized: "Nervous: 覚えとくんだねえ\nそういうの 大っキライなんだから\n精神病院の頃から ずっと"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725316
    m_Localized: "Nervous: 親に ブチ込まれたんだ\n信じられないよねえ！"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725317
    m_Localized: "Nervous: そう 人をどこまでも つけ回す癖が\nあるって決めつけられてさあ\nだから なんだっていうの？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725318
    m_Localized: "Nervous: ワルさ なんて なあんにも\nしちゃいない ってのにねえ\nへへへ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725319
    m_Localized: "Nervous: でも親は ボクが\nプッツンしてる って ずうっと\n今でも そうかもねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725320
    m_Localized: "Nervous: そりゃ あんな 精神病院に\n十年も 閉じ込められてたんだから\n本物の トチ狂い みたいにさあ\nへへへ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725321
    m_Localized: 'Nervous: たった 一度だけでさあ…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725322
    m_Localized: "Nervous: あっ なんでもないなんでもない\nうん また今度ね\nホテルに電話しなくっちゃ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725323
    m_Localized: "Nervous: もう 戻りたくないよお\nへへへ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725324
    m_Localized: 前の続きは？
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725325
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725326
    m_Localized: "Nervous: 学校じゃ ずうっとイジメられてた\n息つくヒマもなかったんだ\n毎日 チクチクチクチク"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725327
    m_Localized: "Nervous: そりゃ ガマンできなかったよ\nアイツら マトを狙ってイジメるんだ\n抵抗しない ヤツを"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725328
    m_Localized: "Nervous: やり返したんだ\nあのクソ野郎は ブッ倒れて\n二度と起き上がらなかった\n病院で 死んだんだ って"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725329
    m_Localized: "Nervous: 殺すつもりなんて なかったんだ\nでも そうなっちゃった\n親が どうにかこうにか 収めてくれて"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725330
    m_Localized: "Nervous: それから ずうっと聞かされてさあ\n家名を汚した って"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725331
    m_Localized: "Nervous: それで 精神病院 送り\n例のとこね"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725332
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725333
    m_Localized: "Nervous: あのケンカ 爽快だったなあ\n復讐って 気持ちいいんだ\n自分のために立ち向かうのって"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725334
    m_Localized: "Nervous: コブシの痛みも 気持ち良くて\n顔が殴られ 唇が切れ\nその味が すごく気持ち良くて"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725335
    m_Localized: "Nervous: それで学校 追い出されたんだ\n自分を守った だけなのにねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725336
    m_Localized: "Nervous: もう 戻りたくないよお\nへへへ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725337
    m_Localized: "あなたにとって病院は\n役立たなかったんですね"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725338
    m_Localized: "Nervous: もおっちろん\nへへへ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725339
    m_Localized: "Nervous: クスリで植物人間になったって…\nなあんにも 良いこと なんてない"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725340
    m_Localized: "Nervous: 良くもならないし 楽にもならない\nただ 十年 盗まれただけ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725341
    m_Localized: 'Nervous: なにもかも あの出来事 ひとつで…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725342
    m_Localized: 'Nervous: へへへへへへ'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725343
    m_Localized: "Nervous: まるで みいんな間違い\n犯さないみたいにさあ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725344
    m_Localized: "Nervous: キミだって そんな目で 見てさあ\nなに？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725345
    m_Localized: "Nervous: 殴りたいんだろお？\nやってみなよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725346
    m_Localized: "Nervous: 顔を殴って 指を折って 熱が上がって\n痛みで 息も絶え絶えに しなよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725347
    m_Localized: "Nervous: どうしたの？\n殴らないの？\n銃 取りに行かないの？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725348
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725349
    m_Localized: "Nervous: へへへ\nじゃあ ここにいるよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725350
    m_Localized: "Nervous: ホテルより ずうっと落ち着くね\nビックリしたよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725351
    m_Localized: "Nervous: ねえ…\n入れてくれて ありがとう"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725352
    m_Localized: "Nervous: あんな狂気の世界より\nずうっとマシだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725353
    m_Localized: 'Leper: あん？なんか用か？'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725354
    m_Localized: "見た目で苦労することは\nありませんか？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725355
    m_Localized: 'Leper: そうでも ねえな'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725356
    m_Localized: "Leper: 学校の頃は 別だけどな\n感染病 呼ばわりされて\n誰も遊んじゃ くれなかった\n移ると思われてな"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725357
    m_Localized: "Leper: 成長すりゃ ケリが付くと思ってた\n実際 大体は そうなったな\nたまに じろじろ見られるが\n大したことじゃねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725358
    m_Localized: "Leper: だがな 大厄災が やってきて\n昔の偏見が またぞろ這い出てきやがる"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725359
    m_Localized: "Leper: しかも なおさら タチが悪い\n命懸けだからな"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725360
    m_Localized: "Leper: そして 当然\nこの肌は 来訪者みてえに 見えちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725361
    m_Localized: "Leper: たりめえだよな\n悪い時代ってのは 人間の悪いとこを\n引きずり出しちまう"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725362
    m_Localized: 'Leper: あん？なんか用か？'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725363
    m_Localized: "肌ひとつで\n来訪者 扱いですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725364
    m_Localized: "Leper: たりめえだろ\nなに期待してんだ？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725365
    m_Localized: 'Leper: 完全に魔女狩りだ'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725366
    m_Localized: "Leper: 普通に見えねえ奴は 誰でも標的だ\nFEMAが裁判官で陪審員\nオマケに処刑人まで一任だ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725367
    m_Localized: "Leper: たまに考えちまうよ…\n連中こそ 元凶なんじゃ ねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725368
    m_Localized: "Leper: 要は 来訪者なんて\nFEMAのでっち上げ じゃねえか？\nお前 どう思う？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725369
    m_Localized: そうかもしれません
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725370
    m_Localized: 来訪者は実在します
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725371
    m_Localized: "Leper: 嬉しいぜ わかるじゃねえか\nなにが来訪者だ くだらねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725372
    m_Localized: 'Leper: まるで映画の筋書き じゃねえか'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725373
    m_Localized: "Leper: 連中は 政府の転覆を企んでんのかもな\n恐怖ってのは 権力の餌だろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725374
    m_Localized: "Leper: それで 抵抗勢力を隔離区域に\n放り込んでんだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725375
    m_Localized: "Leper: そうすりゃ 来訪者と戦ってるように\n見せかけられるしな"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725376
    m_Localized: "Leper: まあ 来訪者が いようがいまいが\nFEMAに目 つけられたかねえな"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725377
    m_Localized: "Leper: 連中 とんでもねえことを\n企ててる気しか しねえんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725378
    m_Localized: 'Leper: 本物だと思うか？'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725379
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725380
    m_Localized: "Leper: 仮に本物だとして\nFEMAの行動は 妙じゃねえか？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725381
    m_Localized: "Leper: 来訪者はウイルス由来だと言う癖に\nなんで感染経路の話を しやがらねえ？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725382
    m_Localized: "Leper: 本気で ウイルスと戦うなら\n真っ先に 水際で食い止めるべきだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919488
    m_Localized: "Leper: ひょっとすると…連中\n「治療法」かなにか 探してんのかもな"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919489
    m_Localized: "Leper: だが 隔離区域に ブチ込まれたが最後\nロクな目に遭わねえような\n予感しかしねえんだ…"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919490
    m_Localized: 'Leper: あん？なんか用か？'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919491
    m_Localized: "どうして そうも\nFEMAを恐れるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919492
    m_Localized: 'Leper: こんな 有様だからよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919493
    m_Localized: "Leper: 背中に標的 描いてあるようなもんだ\n人混みから 連れ去るには\nお誂え向きだろ…"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919494
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919495
    m_Localized: "Leper: 人体実験すんのにな\n全部 このクソ肌のせいだ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919496
    m_Localized: "ウチに いるんです\n心配無用ですよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919497
    m_Localized: 考えすぎ ですよ
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919498
    m_Localized: "Leper: そうか？\nここにFEMAは 来たことねえってか？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919499
    m_Localized: "Leper: それとも 俺みてえな奴に\n連中は興味ねえ ってか？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919500
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919501
    m_Localized: "Leper: 本気か！？\n幼稚園の火事 聞いたことねえのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919502
    m_Localized: 'Leper: 手前の子供を 親が焼き殺したんだぞ？'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919503
    m_Localized: "Leper: 俺らはよ 何百年か後戻りしたんだ\n狂気が腐敗みてえに 広がって\nFEMAは餌食に してやがる"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919504
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919505
    m_Localized: "Leper: いつの日か 外見で人を決めつけずに\nすむようになりゃ いいのにな"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919506
    m_Localized: "Leper: だが人類が どれだけ生き長らえようと\nレッテル貼りだけは\n変えらんねえ だろうよ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919507
    m_Localized: "Leper: 誰が仲間で 誰が余所者か\n見分けやすいからな"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919508
    m_Localized: "Leper: で その了見の狭さのせいで\n俺みてえなのが 割を食う って寸法だ"
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919509
    m_Localized: 'Leper: 泣けてくんぜ…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891008
    m_Localized: 'Fairytaller: なにか ご用ですか？'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891009
    m_Localized: "考え込んでいた\nみたいですね"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891010
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891011
    m_Localized: FEMA通知書を渡す
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891012
    m_Localized: "Fairytaller: 子供時代の童話を思い出していました\n魔法の森に 鳥が住んでいて\n平穏に暮らしていたんですが\n竜が現れ 一網打尽にあうんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891013
    m_Localized: "Fairytaller: 竜は 火を運び 巣も 鳥も\n行く手の全てを 焼き払いました"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891014
    m_Localized: "Fairytaller: ですが ある意味で 対等なんです\nどちらも翼を持ち 同じ空を分かち合い\nみんな穏やかに暮らしていたんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891015
    m_Localized: "Fairytaller: ですが竜は 力に心が曇りました\nかつて愛したものまでも\n焼き尽くすほどに"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891016
    m_Localized: "Fairytaller: 語り終えた後 父は いつも言いました\n誰もが心に 眠れる竜を飼っている と"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891017
    m_Localized: "Fairytaller: 僕と姉は 聞く耳 持ちませんでした\n竜は あんなに大きいのに\nこんなに小さな人の中に\n収まるはずない だなんて"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891018
    m_Localized: "Fairytaller: ですが 大人になって 父の言葉が\nようやく理解できました\n残念ながら もう伝えられませんが…"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891019
    m_Localized: "Fairytaller: 時々 考え込んでしまうんです\n内なる竜を 倒せるだろうか？\n誘惑に飲まれずに いられるだろうか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891020
    m_Localized: 'Fairytaller: なにか ご用ですか？'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891021
    m_Localized: "また 童話のことを\n考えてました？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891022
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891023
    m_Localized: FEMA通知書を渡す
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891024
    m_Localized: "Fairytaller: ええ 今日のは 凍てついた都の話です\n人は何世紀も 高い壁に囲われて暮らし\n互いを信用していませんでした"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891025
    m_Localized: "Fairytaller: そんな状態が 永遠に続くかと\n思われていました"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891026
    m_Localized: "Fairytaller: そこへ 旅のガラス職人が やってきて\n徐々に街が 変わっていくんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891027
    m_Localized: "Fairytaller: 職人は 通りに美しい街灯を掲げ\n自分の庭のみならず 隣人との共有地も\n掃除して 誰にでも欠かさず挨拶をし\n良き一日を願いました"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891028
    m_Localized: "Fairytaller: はじめ 笑い者になりました\nですが次第に 行動は伝染しました\n他人を手伝う人が 出てきました\n人々の凍った心を溶かしたんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891029
    m_Localized: "Fairytaller: 一晩で一変させるのは まず不可能です\n変化は 自分自身から始めなければ\nなりません"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891030
    m_Localized: "Fairytaller: 周囲が どれほど暗かろうとも\n自らのランタンを灯さねば"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891031
    m_Localized: "Fairytaller: 苦難の時 亡くなった母は\n冗談めかして言っていました\n待ち望むだけでは\n変化は一生 訪れない と"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891032
    m_Localized: "Fairytaller: 結局のところ 世界を生かしているのは\n僕ら自身なんです\n変化を望むのならば 自分自身から\n始めなければ うまくいきません"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891033
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891034
    m_Localized: "Fairytaller: どんな苦境の最中に あっても\n優しさと人間らしさを\n保つよう がんばっています\n誰かの灯火になれるよう 願いながら"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891035
    m_Localized: 'Fairytaller: なにか ご用ですか？'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891036
    m_Localized: "今日は どんな\n話ですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891037
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891038
    m_Localized: FEMA通知書を渡す
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891039
    m_Localized: "Fairytaller: 物語なら まだまだ ありますよ…\n死者が蘇り 人々を苦しめはじめたり…"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891040
    m_Localized: "Fairytaller: 人間の姿をした悪魔が現れて\n戸口を叩き 鍵もなしで家に入り込み\n夜明けまで 質問責めにしたり…"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891041
    m_Localized: "Fairytaller: 真紅の太陽が人間に憤怒し\n収穫物を呪い 川を干上がらせたり…"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891042
    m_Localized: "Fairytaller: ですが必ず どんな物語であろうとも\n一人の勇者か 志を同じくする仲間か\nあるいは国が一丸となって\n世界を救うんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891043
    m_Localized: 'Fairytaller: 善は悪に勝つんです'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891044
    m_Localized: "Fairytaller: 信じたいんです これもまた過ぎ去ると\n一年が過ぎ 一日が過ぎ 一瞬が過ぎ\n一切が終わる時が来ると\n五月の雷雨が過ぎ去るように"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891045
    m_Localized: "Fairytaller: そして 父も母も生きていて\nそして 誰もが好きに生きられて\nそして…"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891046
    m_Localized: "Fairytaller: すみません 夢中になりすぎました\n少し一人で 考えさせてください"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891047
    m_Localized: "FunnyGuy: 今頃 オイラたち もっと気楽に\n暮らしたって いいのにな！"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891048
    m_Localized: "何故 ローンが\n帳消しに なると？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891049
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891050
    m_Localized: FEMA通知書を渡す
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891051
    m_Localized: 'FunnyGuy: からかってんのかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891052
    m_Localized: "FunnyGuy: 兄弟 世界の終わりなんだぜ！\n銀行がなんだ 経済がなんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891053
    m_Localized: "FunnyGuy: 誰が そんなもん 気にすんだい\nオイラ この目で ちゃんと見たんだぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891054
    m_Localized: "FunnyGuy: いつもなら 一度 払いを飛ばしたら\n通知書だの督促状だの脅迫状だの\nわんさか来んだから これが"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891055
    m_Localized: "FunnyGuy: でも今回は…音信不通\n便りのないのは良い便り\nってなもんよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891056
    m_Localized: "FunnyGuy: 債務者一覧なんて どう使えってんだか\n夜にならなきゃ 外も出歩けねえんだぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891057
    m_Localized: "FunnyGuy: まっ 新しいローンも組めねえけどな\nもう試したんだ！"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891058
    m_Localized: "FunnyGuy: でもよ！\n借金奴隷から解放されただけでも\n大勝利だろ！"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891059
    m_Localized: "まだ 安心するには\n早いのでは"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891060
    m_Localized: "それで 宴会でも\n始めます？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891061
    m_Localized: 'FunnyGuy: おいおい！'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891062
    m_Localized: "FunnyGuy: いいじゃねえか そう構えんなって\nあちらさんは オイラのことなんざ\nもう どうだっていいに 決まってら\n今頃 地下壕でも掘ってんだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891063
    m_Localized: "FunnyGuy: ひなびた一軒家なんて\n誰が探しに来んだよ？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891064
    m_Localized: "では 自宅に\n帰っては？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891065
    m_Localized: "なら ここへは\n自慢しに？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891066
    m_Localized: 'FunnyGuy: 大正解！'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891067
    m_Localized: "FunnyGuy: 気分が良すぎて\n誰かと しゃべりたくって\nしょうがなかったんだよ ははっ！"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891068
    m_Localized: "では 自宅に\n帰っては？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891069
    m_Localized: "なら ここへは\n自慢しに？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891070
    m_Localized: 'FunnyGuy: そりゃな…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891071
    m_Localized: "FunnyGuy: あそこは貸してたんだ\n今だって 書類上はな\nでも もうカネなんて\nなあんの意味も ねえだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891072
    m_Localized: "FunnyGuy: みんな 外ぶらついて\n窓でも割って いるもん持ってくんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862528
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862529
    m_Localized: 'FunnyGuy: なんだよ？説教か？'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862530
    m_Localized: "何故 質問から\n逃げるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862531
    m_Localized: "気づきましたが\nどうでもいいです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862532
    m_Localized: "FunnyGuy: おいおい なあ\nそう トゲトゲすんな って\n別に悪いこと 言ってねえだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862533
    m_Localized: "FunnyGuy: 冗談かましてえだけなら\nそこまで 辛辣に当たらなくたって\nいいじゃねえか"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862534
    m_Localized: 'FunnyGuy: 折角の気分が 台無しだぜ'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862535
    m_Localized: "何故 質問から\n逃げるんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862536
    m_Localized: "気づきましたが\nどうでもいいです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862537
    m_Localized: 'FunnyGuy: はいはい…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862538
    m_Localized: 'FunnyGuy: あのよ…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862539
    m_Localized: "FunnyGuy: 別に はぐらかしてる ワケじゃねえよ\nただ 怖えんだ 戻んのが"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862540
    m_Localized: "FunnyGuy: 二人家族を住まわせてんだ\nローンの返済に充てるために"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862541
    m_Localized: "FunnyGuy: でもよ…なんて言うかな\nアイツらが人間なのか 来訪者なのか\nどうも 判別できねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862542
    m_Localized: "FunnyGuy: 近所から何度か電話があってよ\n騒がしい音がしたり\n誰かが ちょくちょく訪ねたり\nしてんだとか"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862543
    m_Localized: "FunnyGuy: でも この近所連中ってのがな\nすぐ慌てふためく バアさんがたでな\nイラついて しょうがねえ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862544
    m_Localized: 'FunnyGuy: でもよ もし本当だったら？'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862545
    m_Localized: 'FunnyGuy: ちょっ 最後まで聞けっての'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862546
    m_Localized: "FunnyGuy: とにかく 胸襟を開きてえんだ\n恐る恐る話してんの わかんだろ？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862547
    m_Localized: "FunnyGuy: 手前の住処を買った ってのに\n怖くて 住めや しねえんだぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862548
    m_Localized: "FunnyGuy: 家族に貸して\n家賃でローン返して"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862549
    m_Localized: "FunnyGuy: で 今じゃ\n呼び鈴 鳴らすのも怖えんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862550
    m_Localized: "FunnyGuy: 近所の連中は 様子が変 って言うしよ\nほとんど外に出てねえんだとさ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862551
    m_Localized: "FunnyGuy: そりゃよ もうローンは チャラだ\nでもよ 家賃の請求に行ったり\n追い出したりなんて\n怖くてたまんねえ！"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862552
    m_Localized: "FunnyGuy: 今頃 オイラたち もっと気楽に\n暮らしたって いいのにな！"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862553
    m_Localized: "借家人の続報は\nありますか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862554
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862555
    m_Localized: FEMA通知書を渡す
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862556
    m_Localized: "FunnyGuy: あん？ ああ アイツらか？\nそれどころじゃ ねえんだ 今"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862557
    m_Localized: "FunnyGuy: 今夜 近所に電話したんだ\n勝手に借りて悪いな"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862558
    m_Localized: "FunnyGuy: そしたら銀行屋が押しかけて\n支払いで うだうだ言ってたらしい"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862559
    m_Localized: "FunnyGuy: あそこ住んでなくて 良かったわ\nでもよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862560
    m_Localized: "FunnyGuy: なあ あのカスども\n太陽が爆発しても 取り立てんのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862561
    m_Localized: 'FunnyGuy: 想像できっか？'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862562
    m_Localized: "FunnyGuy: しまいにゃ 死んだ債務者を蘇らせて\n回収しに かかりそうだぜ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862563
    m_Localized: "FunnyGuy: 手前らのケツ守るほうが 先だろうによ\nなんでまた オイラたちのケツ\n追い回してんだよ？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862564
    m_Localized: 'FunnyGuy: クソ野郎どもめ'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862565
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862566
    m_Localized: "FunnyGuy: とまれ ここで ちょいと寝かせてくれ\nそしたら また親戚のとこにでも\n転がり込むとするからよ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862567
    m_Localized: 'FunnyGuy: 多いに越したことはねえ だろ？'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862568
    m_Localized: "FunnyGuy: いや あのクソカスども\n世界の終わり だったのに\nまだ取り立てかよ！クソ食らえ！"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862569
    m_Localized: 'FunnyGuy: 神の裁きに あえばいいんだ'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862570
    m_Localized: "FunnyGuy: 今頃 オイラたち もっと気楽に\n暮らしたって いいのにな！"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862571
    m_Localized: "自分のアパートに\n戻るんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862572
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862573
    m_Localized: FEMA通知書を渡す
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862574
    m_Localized: 'FunnyGuy: ったく クソみてえな話だぜ'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862575
    m_Localized: "FunnyGuy: また電話したんだけどよ 気にすんない\n今度は銀行だ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862576
    m_Localized: "FunnyGuy: アイツら 口座を全凍結しやがった\nコツコツ貯めてたのによ！"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862577
    m_Localized: 'FunnyGuy: ビタ一文 触らせやがらねえ'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862578
    m_Localized: "FunnyGuy: 借金のせいだって 言いやがるけどよ\nそんなの バカげた口実だろ\n毎月 ローン分だけ\n引き落としゃすむだろうが"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862579
    m_Localized: "FunnyGuy: なのによ 丸ごと凍結ときたもんだ？\nてんで意味不明だ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862580
    m_Localized: "FunnyGuy: どうせ FEMAのプロジェクトだのの\n運転資金にでも してんだろ\n職員だの 事件だの 諸々の"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862581
    m_Localized: "FunnyGuy: まあ…クソ食らえだ\nもう払わねえぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862582
    m_Localized: "FunnyGuy: しばらく 泊めてくれ\n家族んとこ戻んのも 気まじいからな"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862583
    m_Localized: "FunnyGuy: それに あのアパート とっくの昔に\n来訪者の巣窟か FEMAの研究所だろ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862584
    m_Localized: 'Alt: 日に日に キツくなってくよ'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862585
    m_Localized: "さっき玄関先で\nずいぶん話してましたよ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862586
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862587
    m_Localized: FEMA通知書を渡す
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862588
    m_Localized: 'Alt: あっ やっぱ気づいた？'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862589
    m_Localized: "Alt: 職業病ってヤツ\nしゃべりすぎちゃうんだ\nとりわけ緊張してるときなんかね"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862590
    m_Localized: "Alt: いつも場を丸く収めて\nきちんと回さないと\nなんて考えちゃってさ\nそれも できるだけ愛想よく"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862591
    m_Localized: "Alt: 元はさ ラジオパーソナリティ\nやってたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862592
    m_Localized: えっ 本当ですか
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862593
    m_Localized: "全然 そうは\n見えませんでした"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862594
    m_Localized: 'Alt: なにそれ？'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862595
    m_Localized: "Alt: 信じようが信じまいが 別に いいよ\nでも あそこに居続けるのは無理でさ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862596
    m_Localized: "Alt: 今じゃ すっかり見世物小屋\nインチキ連中が押し寄せて\n電波に割り込んで 売り込みやってる\nなるたけ高値で 安心を捌こうとね"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862597
    m_Localized: "Alt: 「万能軟膏で悩みにオサラバ！」\n「ラジオ前にコップの水を置くだけ！\n悪い電波を吸い取ります！」"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862598
    m_Localized: 'Alt: どんどんタチが悪くなっていく'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862599
    m_Localized: "Alt: 茶番の一員を演じるのは限界だった\nもう ウンザリ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862600
    m_Localized: "Alt: ニュースなんて 話す気にもなれない\n原稿 準備しながら\n「まだ みんな よく生きてるな」って\n毎度毎度 思ってた"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862601
    m_Localized: "Alt: でさ ラジオパーソナリティが\nどんな格好だと 思ってたの？\n眼鏡かけて スーツ着たオジサン？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862602
    m_Localized: "Alt: ステレオタイプに囚われてるよ\nわかるけどさ 損してるのは君の方"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862603
    m_Localized: "Alt: かく言う私も 最初は思ってたよ\n面白いゲストと 好き勝手おしゃべり\nできる仕事だってさ…\n家じゃなくて スタジオに来るゲストね"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862604
    m_Localized: "Alt: 実際は ただひたすら暗いニュースを\n次から次へ読み上げるだけ\n毎回 いっそ全部 終わらせたい って\n衝動と戦う時間が長くなっていく"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862605
    m_Localized: "Alt: おまけに 文字通り空気売ってるような\nバカどもが ズカズカ押しかけてくる"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862606
    m_Localized: "Alt: ラジオなんて 今じゃ単なる見世物小屋\nで ピエロやってるクソバカが この私"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862607
    m_Localized: 'Alt: 日に日に キツくなってくよ'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862608
    m_Localized: "つまり ウンザリして\n出てきたんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862609
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862610
    m_Localized: FEMA通知書を渡す
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862611
    m_Localized: "Alt: まあ…\nざっくりまとめると そんなとこ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862612
    m_Localized: 'Alt: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862613
    m_Localized: "Alt: トドメに なったのは\nまたイカれ野郎との生放送"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862614
    m_Localized: "Alt: 「専門家」が やってきて\n来訪者について話す って聞かされてさ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862615
    m_Localized: "Alt: そいつ 来訪者と戦う術を見つけたって\n言い張っててさ…なんだったかな\n要は バカ高いカネ取っといて\n瓶詰めの屁みたいなインチキ商品"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862616
    m_Localized: 'Alt: 出演料だって 前払いしてた'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862617
    m_Localized: "Alt: 一週間かけて掘ってやったよ\nそいつの身辺を洗えるだけ洗った\nしでかした やらかしを一切残らず\n資料に ブチ込んだ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862618
    m_Localized: "Alt: 詐欺師を自分のカネで ブッ潰して\nやるつもりだった 公の場で\nさぞかし見物に なるはずだった…"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862619
    m_Localized: "Alt: でも オジャン\nなんでか わかる？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862620
    m_Localized: "Alt: そいつ クソ資料が盗まれた\nとか言い出して 来るのやめたんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862621
    m_Localized: "Alt: キロトン単位のクサい情報とやらが\nクソ丸ごとね！"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862622
    m_Localized: "Alt: そんな言い回し\nどこのバカが するんだか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862623
    m_Localized: "Alt: 私の仕込みは 全部パー\n集めまくったネタも みんな無駄\nヤツは そのままバックレ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862624
    m_Localized: 'Alt: クソ野郎'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862625
    m_Localized: 'Alt: 日に日に キツくなってくよ'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862626
    m_Localized: "ジャーナリズムとは\n縁を切ったんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862627
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862628
    m_Localized: FEMA通知書を渡す
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862629
    m_Localized: 'Alt: 生き延びなきゃ'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862630
    m_Localized: "Alt: 太陽フレアが本格化しはじめてからは\n局の色んな部署に\n首突っ込もうとしたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862631
    m_Localized: "Alt: でも 流れを見てると\nこの先どんどん下り坂"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862632
    m_Localized: "Alt: 警察から 毎日\n市内の報告が届いてくるんだ\nそこからニュース原稿を作ってた"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862633
    m_Localized: "Alt: ある時期から 報告が届くのが\n遅れはじめた"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862634
    m_Localized: "Alt: そのうち 文体まで変わってきた\n同じ文面を毎日 読んでると\n些細な違和感に気づくんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862635
    m_Localized: "Alt: ある日 いきなり\n構成そのものが変わってた"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862636
    m_Localized: "Alt: それで 街を離れることにした\nあまりに妙なことが起きてる"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862637
    m_Localized: "Alt: どこか人里離れたとこで\n暮らした方が マシ ってね\n森暮らしも考えたけど\n今じゃ さすがに無茶そうだし"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862638
    m_Localized: "Alt: 要するに こんな世の中\n生きてくのは キツい って話"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862639
    m_Localized: 'Tourist: ここから 出られたら'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862640
    m_Localized: "どこへ行く\nつもりだったんです？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862641
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862642
    m_Localized: FEMA通知書を渡す
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862643
    m_Localized: "Tourist: もう どこだって同じですよ\nどうせ ここから出られないんですから"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862644
    m_Localized: "Tourist: クソ太陽め ふざけてますよ\nそれから クソ来訪者の流行も"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862645
    m_Localized: "Tourist: この街にだけ 現れてるんですか？\nそれとも 世界中に？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862646
    m_Localized: "Tourist: この旅行のために\nずっと計画を立ててきたんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862647
    m_Localized: "Tourist: おカネを貯めて\n会社に頼み込んで 休みを取って…"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862648
    m_Localized: "Tourist: なのに この始末ですよ\n始まる前から 旅は終わったんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862649
    m_Localized: 'Tourist: ここから 出られたら'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862650
    m_Localized: "何故 この時期に\n旅行を？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862651
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862652
    m_Localized: FEMA通知書を渡す
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862653
    m_Localized: "Tourist: だから 言ってるじゃないですか\nずっと邪魔立てされてきたんです\n次から次へと…"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862654
    m_Localized: "Tourist: それに 思ったんです\n今こそ旅行の しどきだと"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862655
    m_Localized: 'Tourist: やっと たっぷり日焼け できるって…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862656
    m_Localized: "Tourist: こんなことになると 知っていたら\nもっと早く出ていましたよ\nまだ世界が見られるうちに"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862657
    m_Localized: "Tourist: 今となっては 写真で見るばかりです\n暑い国が どんなところか なんて"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862658
    m_Localized: 'Tourist: ここから 出られたら'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862659
    m_Localized: "幸運かもしれませんよ？\n外で焼け死なずにすんだんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862660
    m_Localized: 検査させてください
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862661
    m_Localized: FEMA通知書を渡す
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862662
    m_Localized: "Tourist: 幸運ですって？\nからかってるんですか"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862663
    m_Localized: "Tourist: 世界を見て回りたいと考えて\n生涯 過ごしてきたんです\nなのに今じゃ この先 叶う見込みが\nあるのかどうかさえ わかりません"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862664
    m_Localized: "Tourist: なのに 幸運だって言うんですか？\nどこがです？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862665
    m_Localized: "生きているだけ\nマシでしょう"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862666
    m_Localized: "ねえ\nたかが旅行でしょう"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862667
    m_Localized: "Tourist: ええ 生きてはいますよ 今はね\nでも この先 どうなるんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862668
    m_Localized: "Tourist: どうせ太陽が爆発して\nなにもかも終わるんです\n私たちも"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862669
    m_Localized: "Tourist: つまり私は このまま世界を見ずに\n死ぬんですよ…"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862670
    m_Localized: "それで スネてるんですか？\nもう泣き言は やめません？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862671
    m_Localized: "愚痴に付き合うのに\nそろそろ飽きてきました"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862672
    m_Localized: "Tourist: ただの旅行じゃ ないんです\n私の夢なんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862673
    m_Localized: "Tourist: 一生 世界を見て回りたいと\nそう思ってきたんです\nなのに 今はどうです？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862674
    m_Localized: "Tourist: もう おしまいですよ\n二度と叶いません"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862675
    m_Localized: "Tourist: こんなことになる前に\n行っておくべきでした\n今じゃ みんな死を待つだけです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862676
    m_Localized: "それで スネてるんですか？\nもう泣き言は やめません？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862677
    m_Localized: "愚痴に付き合うのに\nそろそろ飽きてきました"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862678
    m_Localized: 'Tourist: ですが…私は…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862679
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862680
    m_Localized: "Tourist: 悔やんでも悔やんでも\n悔やみきれないんです\nすみません"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862681
    m_Localized: "Tourist: 今になって 気づいたんです\n本当は 旅行を邪魔するものなんて\nなにも なかったんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862682
    m_Localized: "Tourist: それなのに そのうち行ける って\nずっと先延ばしにして"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862683
    m_Localized: 'Tourist: それで今や…手遅れです'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862684
    m_Localized: "Tourist: 世界は今にも 崩れ落ちそうなのに\nまだ やりたいことが山ほどあるんです\n旅行も含めて…"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862685
    m_Localized: "Tourist: どうにかして 折り合いをつけるしか\nないんでしょうが"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862686
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862687
    m_Localized: 'Tourist: クソッ！'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862688
    m_Localized: "Tourist: 失ったものを\n嘆いちゃいけないんですか？"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862689
    m_Localized: "Tourist: 知ってますよ\n元には戻らないことぐらい\n終わりが近い ことだって"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862690
    m_Localized: "Tourist: あなたの目を見れば わかります\nもう 受け入れているのは \nでも 私は 死にたくないんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862691
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862692
    m_Localized: "Tourist: 私は なにを言っているんだか…\nどうせ一歩も出たことないんでしょう\n家の敷居から\nあなたは なにも変わってないんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862693
    m_Localized: "神経を逆なでするのは\nよしてください"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862694
    m_Localized: "勘違いしないでください\n入れたくて入れてません"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862695
    m_Localized: 'Tourist: なにを…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862696
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862697
    m_Localized: "Tourist: いいです\nもう行きます\n怖くなって きました"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862698
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862699
    m_Localized: "Tourist: あなたは これから来るものを\n受け入れられるのかも しれません\nでも みんながみんな\nそう割り切れるわけでは ないんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862700
    m_Localized: "Tourist: 少なくとも 私には無理です\nこれから この身に なにが起きるのか\n考えるだけで 辛いんです"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862701
    m_Localized: "Tourist: それに昨日 考え込んでしまいました\n今 行動するのを恐れて\nどれほどの機械を見逃してきたのか…"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862702
    m_Localized: "良かった思い出でも考えましょう\n少しは楽になるかもしれません"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862703
    m_Localized: "もう なにかもを\n悔やむのは よしましょう"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862704
    m_Localized: 'Tourist: そのとおりかも しれませんね…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862705
    m_Localized: "Tourist: でも\nああすればよかった\nこうすればよかった\nそう悔やまないのも 結構 大変で…"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862706
    m_Localized: "Tourist: とはいえ あなたの言うとおり\n時間を巻き戻せるわけではありません"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862707
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862708
    m_Localized: "Tourist: 話を聞いてくれて\nありがとうございました"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862709
    m_Localized: "Tourist: 役立つかどうか わかりませんが\nこれをどうぞ\n{0} です"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602560
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602561
    m_Localized: "Dude: そういや 思い出したぜ\nイカしたハッパが一本 残ってたんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602562
    m_Localized: 'Dude: これで最高に トベるぜ！'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602563
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602564
    m_Localized: 'Dude: おっと 兄弟…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602565
    m_Localized: 'Dude: 回してやるの 忘れてた'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602566
    m_Localized: "Dude: ワリい 吸い切っちまった\nほら 普通のハッパやるから\nキレないでくれよな 兄弟"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602567
    m_Localized: 'Dude: 俺はちょいと ダラけてるわ…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602568
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602569
    m_Localized: 'Wheelchair: クソ 足が痛え'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602570
    m_Localized: 'Wheelchair: ちょっと 待っててくれ'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602571
    m_Localized: 'Wheelchair: よし だいぶマシになった'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602572
    m_Localized: なに してんです？
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602573
    m_Localized: "Wheelchair: 構わねえだろ\n足が痺れてんだ\nなにが問題なんだよ？"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602574
    m_Localized: なんの演技です！？
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602575
    m_Localized: "なんで車椅子に\n乗ってるんです！？"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602576
    m_Localized: "Wheelchair: 演技なんて してねえって\nこのほうが 冷えねえだろ"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602577
    m_Localized: "Wheelchair: 車椅子のことなら\n乗り回すのが楽しいんだよ"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602578
    m_Localized: イカれてる
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602579
    m_Localized: "さっさと失せろ\n今すぐ"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602580
    m_Localized: "Wheelchair: いや マジで最高なんだぜ\nドリフトしたりスピード出したり"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602581
    m_Localized: "Wheelchair: まさか やったことねえのか\n格別だぜ！"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602582
    m_Localized: イカれてる
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602583
    m_Localized: "さっさと失せろ\n今すぐ"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602584
    m_Localized: 'Wheelchair: 好きに言いな'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602585
    m_Localized: "Wheelchair: 俺は最高に楽しいけどな！\n人生は楽しんでナンボだ"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602586
    m_Localized: 'Wheelchair: なんだよ それ？'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602587
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602588
    m_Localized: "Wheelchair: わかったよ 出ていく\nけど 椅子は持ってくからな"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602589
    m_Localized: '>>'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602590
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602591
    m_Localized: "Esenin: 君の本棚で\n詩集を見つけたよ"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602592
    m_Localized: 'Esenin: ひとつ読んでも 構わないか？'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602593
    m_Localized: どうぞ
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602594
    m_Localized: 勘弁してください
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602595
    m_Localized: "Esenin: こんな詩だ\nどう思う？"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602596
    m_Localized: 美しいです
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602597
    m_Localized: ただの言葉ですね
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602598
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602599
    m_Localized: 'Esenin: ふむ 少し気楽になったよ'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602600
    m_Localized: 'Esenin: ありがとう 聞いてくれて'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602601
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602602
    m_Localized: 'Esenin: よし 君の言うとおりにしよう'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602603
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602604
    m_Localized: "FortuneTeller: お前さんの気を変える方法が\n見つかったかもしれないよ"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602605
    m_Localized: 'FortuneTeller: すべきは ただ ひとつ…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602606
    m_Localized: 'FortuneTeller: 山羊座の舞を 踊るだけさ！'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602607
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602608
    m_Localized: "FortuneTeller: さあ どうだい？\n喜びが流れ込んできたかい？"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602609
    m_Localized: 本気です？
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602610
    m_Localized: なに言ってんです？
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602611
    m_Localized: 'FortuneTeller: おや 効かなかったかい？'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602612
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602613
    m_Localized: "FortuneTeller: そいつは妙だね\n効くはずなのに"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602614
    m_Localized: "FortuneTeller: まあ 落ち込まないことさ\n日々のアファメーションだって\n幸せに効くんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602615
    m_Localized: "FortuneTeller: さあ 座学はここまで\n実践に移ろうか"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602616
    m_Localized: "FortuneTeller: 後に続けるんだよ\n「私は幸せな人間です！」"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602617
    m_Localized: 私は幸せな人間です！
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602618
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602619
    m_Localized: バカげてます
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602620
    m_Localized: 'FortuneTeller: その調子だよ！'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602621
    m_Localized: 私は幸せな人間です！
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602622
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602623
    m_Localized: バカげてます
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602624
    m_Localized: 'FortuneTeller: まるきり 身が入ってないね！'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602625
    m_Localized: "FortuneTeller: 待ちな…\nなんで今まで気づかなかったかね…"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602626
    m_Localized: "FortuneTeller: お前さんのオーラ…\n幸せになる気が まるでないね\nただただ 空虚だよ"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602627
    m_Localized: "FortuneTeller: 欲しなければ 与えられないものさ\n宇宙は聞き入れず\nなにも叶えちゃくれない"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602628
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602629
    m_Localized: "FortuneTeller: 残念だね お前さんは救えないよ\nアファメーションでさえ無理なんて"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602630
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602631
    m_Localized: なに してるんです？
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602632
    m_Localized: 'Intruder: お前の夢を 探してる'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602633
    m_Localized: "Intruder: 少しで構わない 安らぎが欲しい\nほんの少しでも"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602634
    m_Localized: "Intruder: どこに隠してるんだ？\n教えろ"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602635
    m_Localized: "離れろ\nブッ飛ばすぞ"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602636
    m_Localized: 夢なんて ありませんよ
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602637
    m_Localized: どけ
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602638
    m_Localized: "Intruder: わかってくれ\nどうしても 夢が 必要なんだ"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602639
    m_Localized: "Intruder: だが 目を見て わかった…\nお前には 夢なんてない"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602640
    m_Localized: 'Intruder: だから 安心してくれ'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602641
    m_Localized: "Intruder: さあ 飲み込めたか\n俺は 真実を打ち明けてるのか\nお前の頭を かき乱したいだけか"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602642
    m_Localized: 'Intruder: ただ ひとつ 不穏な悪夢を除いてな…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796864
    m_Localized: "Intruder: お前は 廊下を這いずり回ってる\n醜いナメクジのように"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796865
    m_Localized: "Intruder: 自分でも気づいてない\n誰の目を通して 世界を見ているのか"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796866
    m_Localized: "Intruder: ひとつ言えるのは…\nその目は 死体を探してる\n死のある方…死のある方へと…"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796867
    m_Localized: 'Intruder: いつか 自分の目で 見るかもな…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796868
    m_Localized: 'Intruder: ただ ひとつ 奇妙な悪夢を除いてな…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796869
    m_Localized: "Intruder: お前は 洞穴を這ってる\n茸が生い茂る中を"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796870
    m_Localized: "Intruder: あまりに多くの茸が繁茂し\n恐ろしい速さで成長している"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796871
    m_Localized: "Intruder: 不思議だな\nどうして お前が そんな夢を見るのか"
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821952
    m_Localized: 'Esenin: 夕暮れ広がる空の下'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821953
    m_Localized: 'Esenin: 手術台の麻酔患者のように'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821954
    m_Localized: 'Esenin: さあ行こう 賑わい少ない通りを抜けて'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821955
    m_Localized: 'Esenin: 何か呟きながら'
    m_Metadata:
      m_Items: []
