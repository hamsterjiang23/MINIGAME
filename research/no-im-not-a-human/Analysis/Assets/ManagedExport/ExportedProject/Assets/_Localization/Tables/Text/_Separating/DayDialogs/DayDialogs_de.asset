  - m_Id: 55784900568014861
    m_Localized: 'Wolfhound: Sicher ... Sicher ...'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792075
    m_Localized: 'Player: Was ist das?'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792076
    m_Localized: 'Player: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792077
    m_Localized: 'Player: Na gut, ich nehme sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792078
    m_Localized: 'Player: Was, Sie geben sie zurück?'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792079
    m_Localized: 'Player: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792080
    m_Localized: 'Player: Jetzt werden sie mich wegbringen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539790462976
    m_Localized: Gute Frage
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434496
    m_Localized: Ich warte nicht
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434497
    m_Localized: 'Ballerina: Loben Sie meine Fragen? Warum?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434498
    m_Localized: 'Ballerina: Sie sollten lieber antworten. Es gibt da jemanden, der Fragen nur zu gerne ignoriert.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434499
    m_Localized: 'Ballerina: Sie sind schon wie er.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434500
    m_Localized: Ich warte auf gar nichts
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434501
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434502
    m_Localized: 'Ballerina: Ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434503
    m_Localized: 'Ballerina: Und was tun Sie dann? Sie sitzen hier rum, eingesperrt in Ihren vier Wänden.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434504
    m_Localized: 'Ballerina: Natürlich warten Sie. Sie wollen doch wissen, was mit Ihren Leuten passiert ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434505
    m_Localized: Ich warte auf gar nichts
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434506
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434507
    m_Localized: 'Ballerina: Wie Sie meinen. Ich übrigens auch nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434508
    m_Localized: 'Ballerina: Oh, Moment mal, ich habe Ihnen ja schon gesagt, dass ich warte.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434509
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434510
    m_Localized: 'Ballerina: Aber sie wird sowieso kommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434511
    m_Localized: 'Ballerina: HAHAHAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434512
    m_Localized: 'Ballerina: ICH LIEBE ES, ZU TANZEN. Soll ich’s Ihnen zeigen? Drücken Sie einfach ab.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434513
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434514
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434515
    m_Localized: 'Ballerina: Hepp!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434516
    m_Localized: 'Ballerina: Wollen Sie’s noch mal probieren?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434517
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434518
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434519
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434520
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434521
    m_Localized: 'Ballerina: Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434522
    m_Localized: 'Ballerina: Daneben geschossen! Dabei bin ich direkt vor Ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434523
    m_Localized: 'Ballerina: Machen Sie beim Schießen die Augen zu, oder was?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434524
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434525
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434526
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434527
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434528
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434529
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434530
    m_Localized: 'Ballerina: Hepp!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434531
    m_Localized: 'Ballerina: Ich bin allmählich müde.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434532
    m_Localized: 'Ballerina: Es ist wohl einfacher, einfach zu verrotten.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683264
    m_Localized: 'Foreigner: Dszg rh gsrh?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683265
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683266
    m_Localized: 'Foreigner: R tfvhh R’oo gzpv rg ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683267
    m_Localized: 'Unstable: Tja, das war’s. Mir ist die Puste ausgegangen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683268
    m_Localized: Also, was ist mit diesen Geschichten, von denen du geredet hast?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683269
    m_Localized: 'Unstable: Ja, die ... Wie wär’s, wenn wir Geschichten austauschen? Willst du vielleicht zuerst was erzählen?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683270
    m_Localized: Nicht mit dir
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683271
    m_Localized: Komm zur Sache
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683272
    m_Localized: 'Unstable: Sicher, sicher. Niemand zwingt ja irgendwen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683273
    m_Localized: 'Unstable: Alsooo ... ich war in dieser einen Bar, klar? Oder vielleicht keine Bar. Hätte auch was anderes sein können.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683274
    m_Localized: 'Unstable: Verdammt, wie hieß der Laden noch mal ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683275
    m_Localized: ... Und?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683276
    m_Localized: 'Unstable: Ach ja, genau, genau.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683277
    m_Localized: 'Unstable: Egal. Ich kümmere mich also um meinen Kram und schlürfe an meinem treuen EnerJeka.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683278
    m_Localized: 'Unstable: Mann, ich liebe das Zeug. Kannst du dir gar nicht vorstellen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683279
    m_Localized: 'Unstable: Es ist einfach ... umwerfend.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683280
    m_Localized: 'Unstable: Der Nachgeschmack bleibt den ganzen Tag! Zu schade, dass es das nicht überall gibt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683281
    m_Localized: ... Und weiter?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683282
    m_Localized: 'Unstable: Ach so, ja ... Wo war ich stehen geblieben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683283
    m_Localized: 'Unstable: Ich sitz also da, und der Laden ist halb leer. Die Musik dröhnt mir in den Ohren.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683284
    m_Localized: 'Unstable: Und dann höre ich jemanden brüllen. Laut genug, dass ich es durch meine Kopfhörer höre.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683285
    m_Localized: 'Unstable: Und das mitten in einem echt geilen Song. Und ich mag’s echt nicht, wenn ich von meiner Mucke abgelenkt werde.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683286
    m_Localized: 'Unstable: Wenn man praktisch ... total im Sound versunken ist und die Welt um einen herum verblasst ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683287
    m_Localized: Was zur Hölle?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683288
    m_Localized: 'Unstable: Schon klar, schon klar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683289
    m_Localized: 'Unstable: Also reiß ich mir die Kopfhörer runter und seh diesen Riesenkerl, wie er irgendeinen armen Teufel anbrüllt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683290
    m_Localized: 'Unstable: Weiß nicht, worüber die gestritten haben, aber er konnte kaum zwei Worte aneinanderreihen. Sturzbetrunken.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683291
    m_Localized: 'Unstable: Der lange Lulatsch schreit, dann haut er den anderen Kerl einfach um. Der geht zu Boden wie’n Sack Kartoffeln.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683292
    m_Localized: 'Unstable: Aber der Riese ist noch nicht fertig. Er klettert auf die Bar, wackelt wie Gelee, sein Kopf stößt fast an die Decke.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683293
    m_Localized: 'Unstable: Dann brüllt er so was wie: „Ihr seid alle Abschaum!“'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683294
    m_Localized: 'Unstable: Mir war klar, dass die Kacke gleich am Dampfen sein würde.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683295
    m_Localized: 'Unstable: Und ich wollte nicht da sein, wenn es so weit ist. Also hab ich mich vom Acker gemacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683296
    m_Localized: Und dann?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683297
    m_Localized: 'Unstable: Nichts. Irgendwie fühlt sich alles einfach ... seltsam an.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683298
    m_Localized: 'Unstable: Wo auch immer ich hingehe, irgendjemand sticht immer in ein Wespennest.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683299
    m_Localized: 'Unstable: Es fühlt sich an, als wär das immer so, wenn ich länger als ein paar Tage an einem Ort bleibe.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683300
    m_Localized: 'Unstable: Kampf. Tod. Sarg. Grab. Meistens in dieser Reihenfolge ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683301
    m_Localized: 'Unstable: Ich hoffe, hier ist es anders.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683302
    m_Localized: 'Unstable: Tja, das war’s. Mir ist die Puste ausgegangen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683303
    m_Localized: Und, wie lautet dein Urteil? Fühlst du dich hier sicher?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683304
    m_Localized: 'Unstable: Schwer zu sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683305
    m_Localized: 'Unstable: Du hast so eine ... ruhige, häusliche Aura, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683306
    m_Localized: 'Unstable: Vielleicht, weil das hier buchstäblich dein Haus ist. Haha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683307
    m_Localized: 'Unstable: Fühlt sich an, als ob du versuchst, eine Art sicheren Hafen zu erschaffen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683308
    m_Localized: 'Unstable: Lässt nicht einfach jeden rein und so.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683309
    m_Localized: 'Unstable: Aber ... du spürst es auch, oder? Irgendwas stimmt nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683310
    m_Localized: 'Unstable: Ha, na ja, die ganze Welt ist seltsam. Aber hier ... ist es ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683311
    m_Localized: 'Unstable: Weiß auch nicht, ich hab keine Ahnung, was ich eigentlich sagen will.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683312
    m_Localized: 'Unstable: Ach, was soll’s. Nimm einen EnerJeka und vergiss es einfach.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683313
    m_Localized: 'Unstable: Keine Sorge.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683314
    m_Localized: Also, wann ziehst du weiter?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683315
    m_Localized: Bist du immer noch vor etwas auf der Flucht?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683316
    m_Localized: 'Unstable: Bald, denke ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683317
    m_Localized: 'Unstable: Ich bleibe nicht gern zu lange an einem Ort. Hast du wahrscheinlich schon bemerkt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683318
    m_Localized: 'Unstable: Und falls nicht ... Tja, ich hab’s ja schon ein paar Mal erwähnt, haha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683319
    m_Localized: 'Unstable: Ich dachte, bei dir wäre es vielleicht ganz witzig.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683320
    m_Localized: 'Unstable: Aber alles hier schreit irgendwie nach Tod ... Ich kapier’s nicht, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683321
    m_Localized: 'Unstable: Tja, ich hab genug gesehen. Passt schon.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683322
    m_Localized: 'Unstable: Ich bin nicht auf der Flucht, ich ziehe nur weiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683323
    m_Localized: 'Unstable: Ich brauche keinen Ärger mehr. Hatte schon genug davon.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683324
    m_Localized: 'Unstable: Bleibst du zu lange an einem Ort, will dich irgendwann jemand verprügeln, erschießen oder einsperren.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683325
    m_Localized: 'Unstable: Und wer weiß, wo das alles noch endet ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683326
    m_Localized: 'Unstable: Klar, je mehr ich umherziehe, desto wahrscheinlicher, dass ich einem echt gruseligen Mistkerl begegne.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683327
    m_Localized: 'Unstable: Aber hey, immer noch besser, als jemandem zu vertrauen und am Ende ein Messer im Rücken zu haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683328
    m_Localized: 'Unstable: Tja, das war’s. Mir ist die Puste ausgegangen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683329
    m_Localized: Und? Bist du bereit?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683330
    m_Localized: 'Unstable: Häh? Oh. Oh, ja. Ich verschwinde heute Nacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683331
    m_Localized: 'Unstable: Also ... Man sieht sich!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683332
    m_Localized: Du kannst nicht vor all dem Grauen dieser Welt davonlaufen
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683333
    m_Localized: Viel Glück. Hoffentlich kannst du den Psychos entkommen
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683334
    m_Localized: 'Unstable: Ja, ja, ich weiß schon. Aber hey, vielleicht schaffe ich es ja doch.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683335
    m_Localized: 'Unstable: Glaubst du wirklich, an einem Ort zu bleiben, macht so einen großen Unterschied?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683336
    m_Localized: Na gut ... Viel Glück.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683337
    m_Localized: Ich lasse dich nicht wieder rein, nur damit du’s weißt.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683338
    m_Localized: 'Unstable: Das ist doch jetzt kein Sarkasmus, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683339
    m_Localized: 'Unstable: Trotzdem danke. Ich habe mich hier ganz gut erholt. Damit komme ich zumindest ein paar Tage über die Runden.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683340
    m_Localized: 'Unstable: EnerJeka wirkt Wunder, klar?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683341
    m_Localized: 'Unstable: Und falls das witzig sein sollte ... Besser irgendwas tun, als darauf warten, dass einem das Gehirn weichkocht.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683342
    m_Localized: 'Unstable: Ich hab sowieso nichts zu verlieren. Hab alles hinter mir gelassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683343
    m_Localized: 'Unstable: Warum also nicht nach etwas Besserem suchen? Besser, als das Handtuch zu werfen und zu warten, bis der Vorhang fällt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683344
    m_Localized: 'Unstable: Ich ... Ich will das nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683345
    m_Localized: Na gut ... Viel Glück.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683346
    m_Localized: Ich lasse dich nicht wieder rein, nur damit du’s weißt.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683347
    m_Localized: 'Unstable: Danke. Dir auch.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683348
    m_Localized: 'Unstable: Vielleicht sehen wir uns mal wieder. Womöglich habe ich bis dahin die eine oder andere Geschichte auf Lager.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683349
    m_Localized: 'Unstable: Und vielleicht hab ich dann Lust, sie zu erzählen. Jetzt nämlich kein bisschen. Nicht bei deiner Visage.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683350
    m_Localized: 'Unstable: Na ja, ist auch egal. Ich komme sowieso nicht wieder.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683351
    m_Localized: 'Unstable: Es hat keinen Zweck. Es gibt nie was, zu dem man zurückkehren kann. Nur verbrannte Erde und verkohlte Knochen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683352
    m_Localized: 'Unstable: Nichts für ungut, ich sag nur, was ich gesehen habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683353
    m_Localized: 'Unstable: Es ist einfacher, alles hinter sich zu lassen. Also ... ist es besser, wenn wir uns nicht wiedersehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683354
    m_Localized: 'Unstable: Tja, das war’s. Mir ist die Puste ausgegangen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683355
    m_Localized: Wolltest du nicht gehen?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683356
    m_Localized: 'Unstable: Ja, aber ich wollte dich erst warnen!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683357
    m_Localized: 'Unstable: Hab letzte Nacht draußen vorm Fenster was Böses gespürt. Wollte dich wecken, aber dachte, ich lass dich schlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683358
    m_Localized: 'Unstable: Nur ... sei vorsichtig, okay? Der Tod ist dir auf den Fersen, ganz sicher.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683359
    m_Localized: 'Unstable: Ich weiß nicht mal, wie ich es erklären soll.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683360
    m_Localized: 'Unstable: Ich hab so ein komisches Kribbeln am ganzen Körper. Kommt wahrscheinlich vom ganzen Koffein.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683361
    m_Localized: 'Unstable: Aber darum geht es nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683362
    m_Localized: 'Unstable: Ich hatte einfach das Gefühl, ich müsste dich warnen, klar? Bevor noch was Schlimmes passiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683363
    m_Localized: 'Unstable: Vielleicht solltest du auch darüber nachdenken, von hier zu verschwinden?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683364
    m_Localized: 'Unstable: ... Schau mich doch nicht so an. Ich kapier’s ja schon, ich rede Unsinn. Wie auch immer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683365
    m_Localized: 'Unstable: Egal, ich hab dich gewarnt. Das war’s, diesmal wirklich. Hoffentlich verbrennst du nicht wie die anderen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683366
    m_Localized: 'Rocker: Mann, ich vermisse meine Klampfe ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683367
    m_Localized: In Gedanken?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460480
    m_Localized: 'Rocker: Hm? Hab mich dabei erwischt, wie ich durchgegangen bin, wer von der alten Crew noch da ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460481
    m_Localized: 'Rocker: Damals haben wir nach jeder Beerdigung losgerockt. Besser, als im Bett zu verrotten oder sich die Kante zu geben.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460482
    m_Localized: 'Rocker: Einmal hab ich drei Nächte am Stück dasselbe Riff runtergehämmert, bis meine Finger geblutet haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460483
    m_Localized: 'Rocker: Nur meine Klampfe und ich. Kein Platz im Hirn, um das Gesicht des Wichsers abzurufen, der den Löffel abgegeben hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460484
    m_Localized: 'Rocker: Und jetzt? Tag für Tag dieselbe Scheiße. Besucher, sengende Sonne – eine weitere Runde in der Hölle. Also, Prost!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460485
    m_Localized: 'Rocker: Mann, ich vermisse meine Klampfe ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460486
    m_Localized: Ist es schwer? Ohne Gitarre?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460487
    m_Localized: 'Rocker: Und wie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460488
    m_Localized: 'Rocker: Ich erinnere mich an unsere Küchen-Jamsessions, ha. Der Verstärker halb aufgedreht auf einem Hocker, damit die Nachbarn nicht die Bullen rufen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460489
    m_Localized: 'Rocker: Nach jedem Song hat irgendein Wichser „In Gedenken an Soundso“ hinzugefügt. Das war’s – kein Geheule, kein Scheiß.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460490
    m_Localized: 'Rocker: Besser, ’ne alte Gitarre zerschmettern als den eigenen Schädel. Die kann man wenigstens ersetzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460491
    m_Localized: 'Rocker: Damals hab ich wirklich geglaubt, aus unseren Sofa-Gigs würde mal was Richtiges werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460492
    m_Localized: 'Rocker: Aber die Stadt hat uns schneller fertiggemacht, als wir uns aufrappeln konnten.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460493
    m_Localized: 'Rocker: Immer hat sich irgendein Arschloch ’ne Überdosis verpasst oder sein Auto geschrottet.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460494
    m_Localized: 'Rocker: Ein verdammtes Scheißleben, echt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460495
    m_Localized: 'Rocker: Ich zieh morgen Abend los. Muss was erledigen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460496
    m_Localized: 'Rocker: Mann, ich vermisse meine Klampfe ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460497
    m_Localized: Und? Warst du letzte Nacht weg?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460498
    m_Localized: 'Rocker: Jo. War bei unserem alten Proberaum. Schimmel an den Wänden, lose Kabel, alles verwüstet.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460499
    m_Localized: 'Rocker: Hab das Metronom angemacht, ’ne Weile zugehört ... und nichts. Nur Leere.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460500
    m_Localized: 'Rocker: Was hat Träumen noch für einen Sinn ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460501
    m_Localized: 'Rocker: Rock ’n’ Roll stirbt nie? Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460502
    m_Localized: 'Rocker: Ganz ehrlich, Mann, selbst wenn uns die Sonne nicht verbrutzelt hätte, wäre irgendwas anderes dazwischengekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460503
    m_Localized: 'Rocker: Als ich ein Kind war, dachte ich, die ganze schlimme Scheiße wäre schon vorbei. Es konnte nur noch aufwärts gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460504
    m_Localized: 'Rocker: Die Rezession, der Krieg ... Es schien, als könnten wir jetzt endlich leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460505
    m_Localized: 'Rocker: Verdammt, wie falsch ich doch lag ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460506
    m_Localized: 'Rocker: Mann, ich vermisse meine Klampfe ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460507
    m_Localized: Was geht dir durch den Kopf?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460508
    m_Localized: 'Rocker: Heute wurde mir klar – all meine Storys waren nur Vorprogramm und Lückenfüller. Ich stand nie selbst im Rampenlicht. Werde ich wahrscheinlich auch nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460509
    m_Localized: 'Rocker: Ich weiß nicht mal, warum ich dich angelogen hab.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460510
    m_Localized: 'Rocker: Vielleicht wollte ich nur für eine Sekunde so tun, als hätte ich es wirklich geschafft.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460511
    m_Localized: 'Rocker: Ich hab gesagt, ich bin durch die Hölle gegangen und gestärkt rausgekommen, aber das ist Unsinn. Ich hab mich nur wie ein Kind unter der Bettdecke versteckt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460512
    m_Localized: 'Rocker: Als du die Knarre auf mich gerichtet hast, ist was in mir zusammengebrochen. Ich habe mein altes Ich getötet, um jemand zu sein ... das Resultat ist jämmerlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460513
    m_Localized: 'Rocker: Wenn ich so weitermache, ende ich wie alle anderen. Mit einem Bauch voller Tabletten oder ’nem Rasiermesser in der warmen Wanne.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460514
    m_Localized: 'Rocker: Ich bin kein Besucher. Nur ein ausgebrannter Wichser, der kurz vor dem Zusammenbruch steht.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460515
    m_Localized: 'Rocker: Wenn du schießen willst ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460516
    m_Localized: 'Rocker: Ach, scheiß drauf, Mann.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460517
    m_Localized: 'Rocker: Ist mir jetzt auch scheißegal.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460518
    m_Localized: 'Experienced: Alles klar, Kumpel?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460519
    m_Localized: Wenn du gesessen hast, wo sind dann deine Tattoos?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460520
    m_Localized: 'Experienced: Kumpel, nur weil ich nicht zugeschmiert bin, heißt das nicht, dass ich nicht gesessen hab.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460521
    m_Localized: 'Experienced: Beurteile die Leute nicht nur nach ihrem Äußeren. So einfach ist das.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460522
    m_Localized: 'Experienced: Sicher, ich hab schon ’ne Menge Mist gebaut. ... Aber ich habe nie einen Menschen umgebracht.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460523
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460524
    m_Localized: 'Experienced: Nimm’s mir nicht übel, Kumpel, aber ich muss was fragen. Wieso hast du hier eigentlich das Sagen?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460525
    m_Localized: Worauf willst du hinaus?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460526
    m_Localized: Halt dich aus meinen Angelegenheiten raus
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460527
    m_Localized: 'Experienced: Ich hab das Gefühl, du lässt hier so ziemlich jeden rein. Penner, komische Käuze ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460528
    m_Localized: 'Experienced: Das ist schlecht fürs Geschäft. Ich bin schon lange dabei, ich weiß, wie das läuft.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460529
    m_Localized: 'Experienced: Das bringt nur Ärger, Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460530
    m_Localized: 'Experienced: Sagen wir, du lässt so ’nen alten Knacker rein und der kippt dir auf der Couch einfach um.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460531
    m_Localized: 'Experienced: Und dann? Dann schieben sie es dir in die Schuhe, hängen dir seinen Tod an. Kapiert?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460532
    m_Localized: 'Experienced: Oder nehmen wir an, es ist ’ne Frau. Irgendein Typ schwängert sie. Und dann?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460533
    m_Localized: 'Experienced: Wirst du dich dann um das Balg kümmern? Willst du den ganzen Scheiß? He?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460534
    m_Localized: 'Experienced: Unterm Strich, Kumpel – nur echte Männer. Ich, du, wir können unseren Beitrag leisten.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460535
    m_Localized: Du meinst also, ich soll einfach die Alten, Frauen und Kinder abweisen?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460536
    m_Localized: Und das von einem Ex-Knacki?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460537
    m_Localized: 'Experienced: Klar und deutlich, Kumpel. Ich halt mich da raus.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460538
    m_Localized: 'Experienced: Ich wollte dir nicht auf den Schlips treten. Dein Laden, deine Regeln.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460539
    m_Localized: 'Experienced: Das Einzige, was mich stört ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460540
    m_Localized: 'Experienced: Warum zum Teufel tragen alle noch Klamotten?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460541
    m_Localized: 'Experienced: Du bist helle, Kumpel. Die braucht man nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460542
    m_Localized: Du hast vielleicht Nerven, ist dir das klar?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460543
    m_Localized: Seit wann bist du denn der Experte? Seit dem Tag, an dem du rausgekommen bist?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460544
    m_Localized: 'Experienced: Hör zu. Ich sag ja nur, lass nicht einfach jeden rein. Das wird sich noch rächen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460545
    m_Localized: Du hast vielleicht Nerven, ist dir das klar?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460546
    m_Localized: Seit wann bist du denn der Experte? Seit dem Tag, an dem du rausgekommen bist?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460547
    m_Localized: 'Experienced: Hältst dich wohl für witzig, was?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460548
    m_Localized: 'Experienced: Klar und deutlich, Kumpel. Ich halt mich da raus. Musst du mir nicht zweimal sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460549
    m_Localized: 'Experienced: Das Einzige, was mich stört ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460550
    m_Localized: 'Experienced: Warum zum Teufel tragen bei dieser Hitze alle noch Klamotten?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460551
    m_Localized: 'Experienced: Alles klar, Kumpel?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460552
    m_Localized: Ist dir so nicht kalt?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460553
    m_Localized: 'Experienced: Wie so?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460554
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460555
    m_Localized: 'Experienced: Willst du mich verarschen?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460556
    m_Localized: 'Experienced: Die Sonne brutzelt einem den Arsch weg wie Speck. Auf der Straße ist mehr verbrannt als bei ’nem Barbecue.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460557
    m_Localized: 'Experienced: Und du? Du steckst in ’nem Pullover. Wer ist hier der wahre Idiot, Kumpel?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460558
    m_Localized: Diese Kleidung ist wie ein Teil von mir
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460559
    m_Localized: Mir geht’s gut
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460560
    m_Localized: 'Experienced: Ein Teil von dir, hm ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460561
    m_Localized: 'Experienced: Wenn du meinst, Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460562
    m_Localized: 'Experienced: Die Straßen sind höllisch heiß und ihr alle kaspert hier rum, als wär alles in Butter.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460563
    m_Localized: 'Experienced: Dumm wie Brot. Der Schweiß läuft euch die Ritze runter, aber Gott bewahre, jemand sieht meine verschwitzten Backen!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460564
    m_Localized: 'Experienced: Oder vielleicht ... Wenn jemand in all den Schichten nicht schwitzt, bedeutet das, dass er nicht normal ist ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460565
    m_Localized: Willst du damit sagen, dass ich ein Besucher bin?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460566
    m_Localized: Worauf willst du hinaus?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460567
    m_Localized: 'Experienced: Willst du mich verarschen, Kumpel? Ich brat mir hier den Arsch ab, während mein Hintern raushängt, und dir geht’s gut in ’nem verdammten Pullover?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460568
    m_Localized: 'Experienced: Ich kapier’s nicht. Der Schweiß läuft euch die Ritze runter, aber Gott bewahre, jemand sieht meine verschwitzten Backen!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460569
    m_Localized: 'Experienced: Verdammt, schau dir mal den Strand an: Badeanzüge, Bikinis, keine große Sache.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460570
    m_Localized: 'Experienced: Gleiche Hitze, weniger Spaß!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460571
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460572
    m_Localized: 'Experienced: Oder vielleicht ... Wenn jemand in all den Schichten nicht schwitzt, bedeutet das, dass er nicht normal ist ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460573
    m_Localized: Willst du damit sagen, dass ich ein Besucher bin?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460574
    m_Localized: Worauf willst du hinaus?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460575
    m_Localized: 'Experienced: Entspann dich, Kumpel. Ich hab’s nicht auf dich abgesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460576
    m_Localized: 'Experienced: Du wirkst korrekt. Wenn du schwitzen willst – ist das deine Sache.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460577
    m_Localized: 'Experienced: Ich rede von diesen anderen Clowns. Als würde man mit ’nem Mantel an den Strand gehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460578
    m_Localized: Und was jetzt, soll ich mich vielleicht ausziehen?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460579
    m_Localized: Eine Wahnsinnstheorie. Wie bist du denn darauf gekommen?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460580
    m_Localized: 'Experienced: Hör zu, Kumpel, so wie ich das sehe, gibt es jetzt nur zwei Gründe, Klamotten zu tragen. Völlige Bescheuertheit oder sie sind nicht menschlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460581
    m_Localized: 'Experienced: Diese Freaks, die sind Futter für die Würmer! Deshalb spüren sie die Hitze nicht. Kapierst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460582
    m_Localized: Und was jetzt, soll ich mich vielleicht ausziehen?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460583
    m_Localized: Eine Wahnsinnstheorie. Wie bist du denn darauf gekommen?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460584
    m_Localized: 'Experienced: Hör mal, Kumpel. So hab ich das nicht gemeint.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460585
    m_Localized: 'Experienced: Wenn du schwitzen willst, ist das deine Sache.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460586
    m_Localized: 'Experienced: Ich sag ja nur – es ist seltsam. Man muss entweder ein totaler Idiot sein oder ein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460587
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460588
    m_Localized: 'Experienced: Ich meine es ernst, Kumpel! Jetzt in mehreren Schichten rumzulaufen, ist echt verrückter Scheiß.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460589
    m_Localized: 'Experienced: Welcher Clown macht das bei dieser Hitze? Davon rede ich doch: Man muss entweder ein totaler Idiot sein oder ein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460590
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460591
    m_Localized: 'Experienced: Ach, scheiß drauf. Ich hab genug geredet.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460592
    m_Localized: 'Experienced: Alles klar, Kumpel?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460593
    m_Localized: Also, was wolltest du mir letztes Mal sagen?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460594
    m_Localized: 'Experienced: Hör zu, Kumpel, ich kann es dir genau erklären, aber zuerst: Wirst du auch wirklich zuhören?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460595
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460596
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460597
    m_Localized: 'Experienced: Alles klar, Kumpel. Also pass auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460598
    m_Localized: 'Experienced: Lange Rede, kurzer Sinn, hier sind alle faule Eier.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460599
    m_Localized: Wie kommst du darauf?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460600
    m_Localized: Hast du Leute schon immer für verschiedene Tierprodukte gehalten?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460601
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460602
    m_Localized: 'Experienced: Was zur Hölle?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460603
    m_Localized: 'Experienced: Warum zum Teufel fragst du dann überhaupt?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460604
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460605
    m_Localized: 'Experienced: Es wirkt, als hätten hier draußen alle den Verstand verloren. Nur die da drinnen sind noch bei Sinnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460606
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460607
    m_Localized: 'Experienced: Weißt du was, Kumpel? Ich halte jetzt besser die Klappe, bevor ich auch noch durchdrehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460608
    m_Localized: 'Experienced: Kumpel, wenn ich nicht am Verglühen wäre, meinst du, ich würde halbnackt in meinem Tanga herumlaufen?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460609
    m_Localized: 'Experienced: Es geht mir auf die Nerven, wie alle anderen hier herumlaufen, als würden sie die Hitze nicht spüren.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460610
    m_Localized: 'Experienced: Du bist schon länger hier draußen als ich, aber es ist, als hättest du in einem Bunker gelebt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460611
    m_Localized: 'Experienced: Weißt du überhaupt, woran man einen dieser Freaks erkennt?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460612
    m_Localized: Ja, ich kenne die Anzeichen. Hab sie im Fernsehen gesehen
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460613
    m_Localized: Niemand weiß das genau
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460614
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460615
    m_Localized: 'Experienced: Du machst wohl Witze, Kumpel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460616
    m_Localized: 'Experienced: Ich sag’s dir! Die, die Kleidung tragen, sind die Besucher!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460617
    m_Localized: 'Experienced: Weißt du überhaupt, woran man einen dieser Freaks erkennt?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460618
    m_Localized: Ja, ich kenne die Anzeichen. Hab sie im Fernsehen gesehen
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460619
    m_Localized: Niemand weiß das genau
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460620
    m_Localized: 'Experienced: Das will ich verdammt noch mal für dich hoffen, Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460621
    m_Localized: 'Experienced: Wäre blöd, wenn sich diese Anzeichen als Blödsinn herausstellen. Dann würden sie deinen Arsch in den Knast stecken.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460622
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460623
    m_Localized: 'Experienced: Und was jetzt? Suchen wir sie jetzt einfach zufällig aus?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460624
    m_Localized: 'Experienced: Verdammt, wenn es keinen anderen Weg gibt, was soll man dann machen? Es ist, wie es ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460625
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460626
    m_Localized: 'Experienced: Ehrlich gesagt, Kumpel, so wie es jetzt aussieht ... sind die Menschen keine Menschen mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460627
    m_Localized: 'Experienced: Ich hab mich drinnen sicherer gefühlt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460628
    m_Localized: 'Experienced: Alles klar, Kumpel?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460629
    m_Localized: Wenn du dich im Gefängnis sicherer gefühlt hast, warum bist du dann nicht geblieben?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460630
    m_Localized: 'Experienced: Hab ich dir doch schon gesagt, Kumpel. Hab meine Zeit abgesessen. Mein drittes Mal, übrigens.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460631
    m_Localized: 'Experienced: Das erste Mal war, als ich noch ein Knirps war.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460632
    m_Localized: 'Experienced: Ich dachte, wenn ich rauskomme, bleibe ich sauber.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460633
    m_Localized: 'Experienced: Und das bin ich auch, Kumpel. Hab ’ne Frau gefunden, ein Kind bekommen. Das alte Leben war Vergangenheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460634
    m_Localized: 'Experienced: Dann kam die Rezession. Musste wieder Scheiße abziehen, um sie durchzufüttern.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460635
    m_Localized: 'Experienced: Und ehe ich mich versah, steckte ich wieder bis zum Hals in der Scheiße.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460636
    m_Localized: 'Experienced: Die zweite Runde war danach nur eine Frage der Zeit. Beim dritten Mal bin ich freiwillig rein – hier draußen war nichts mehr für mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460637
    m_Localized: 'Experienced: Meine Frau war weg, mein Kind hatte Angst vor mir, und niemand stellt einen Ex-Knacki ein.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460638
    m_Localized: 'Experienced: Also ja – mein halbes Leben, zum Teufel noch mal den Bach runter.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460639
    m_Localized: Was hält dich davon ab, wieder reinzugehen?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460640
    m_Localized: Das tut mir leid für dich.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460641
    m_Localized: 'Experienced: Nichts, Kumpel. Hab nur noch keinen guten Grund gefunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460642
    m_Localized: 'Experienced: Alles zu seiner Zeit. Alles zu seiner Zeit ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460643
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460644
    m_Localized: 'Experienced: Ich brauche dein Mitleid nicht, Kumpel. Hab ich mir alles selbst zuzuschreiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460645
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460646
    m_Localized: 'Experienced: Die Welt hat sich verändert, während ich drin war.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460647
    m_Localized: 'Experienced: Ich bin jetzt ein alter Hund. Neue Tricks lerne ich nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460648
    m_Localized: 'Experienced: Ich bin wie die alte Pritsche in meiner Zelle. War damals aus massivem Holz und ist es heute immer noch.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460649
    m_Localized: 'Experienced: Schätze, ich bin in meiner Art einfach festgefahren, Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460650
    m_Localized: 'Experienced: Heutzutage ist es schwer, sich anzupassen. Keiner traut dem anderen. Die Leute schlitzen dich auf, ohne mit der Wimper zu zucken.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460651
    m_Localized: 'Experienced: Ich für meinen Teil bin es gewohnt, Klartext zu reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460652
    m_Localized: 'Experienced: Ob du’s glaubst oder nicht: Drinnen sind die Leute ehrlich. Man merkt sofort, wer sie wirklich sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460653
    m_Localized: 'Experienced: Hier draußen? Man kann nicht sagen, wer echt ist und wer ein Freak. Alles ist verdreht.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460654
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460655
    m_Localized: 'Experienced: Ich bin kein Philosoph, aber ... ist es echt so schwer, menschlich zu bleiben? Drinnen schaffen es die Leute ja auch irgendwie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460656
    m_Localized: 'Experienced: Schätze, hier draußen gibt es mehr üble Typen, als ich dachte.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460657
    m_Localized: 'Jacket: Verdammt ... Die ganze Sache ist so ein Schlamassel.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460658
    m_Localized: Du hast doch in einem Wohnheim gewohnt, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460659
    m_Localized: 'Jacket: Ja. Ich hab’s vorher nicht erwähnt, aber ich bin nicht von hier. Bin zum Studieren hergekommen, und dann ist alles den Bach runtergegangen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460660
    m_Localized: 'Jacket: Zuerst haben sie uns in den Wohnheimen eingesperrt, aus Angst, das Virus würde sich ausbreiten. Und dann ... kamen die Typen in den gelben Anzügen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460661
    m_Localized: 'Jacket: Ich hab mir schon Sorgen gemacht. Aber als ich hörte, dass sie die Infizierten in Quarantänezonen bringen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460662
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460663
    m_Localized: 'Jacket: Ich wollte nicht einfach dasitzen und warten, bis sie mich wegschleppen. Also bin ich aus dem Fenster raus und abgehauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460664
    m_Localized: 'Jacket: Hab meine Jacke geschnappt und bin los. Hatte aber keinen Ort, wohin ich konnte. So bin ich bei dir vor der Tür gelandet.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460665
    m_Localized: Nur die Jacke?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460666
    m_Localized: Was hast du sonst noch mitgenommen?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460667
    m_Localized: 'Jacket: Ja. Das ist meine Lieblingsjacke.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460668
    m_Localized: 'Jacket: Na ja, ich hab meinen Ausweis und ein paar andere Sachen mitgenommen, aber ganz ehrlich: Die Jacke war das Einzige, was wirklich zählte.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460669
    m_Localized: 'Jacket: Und versteh mich nicht falsch, es geht nicht um den Preis oder die Marke.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460670
    m_Localized: 'Jacket: Sie ist eines der wenigen Dinge, die mir von meinem Bruder geblieben sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460671
    m_Localized: 'Jacket: Verdammt ... Die ganze Sache ist so ein Schlamassel.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460672
    m_Localized: Was ist mit deinem Bruder passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460673
    m_Localized: 'Jacket: Um es kurz zu machen: Die FEMA hat ihn geholt, und seitdem habe ich ihn nicht mehr gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460674
    m_Localized: 'Jacket: Er war früher Seemann.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460675
    m_Localized: 'Jacket: Und diese Jacke ... Er hat sie mir als Geschenk aus Übersee mitgebracht, von einer seiner Reisen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460676
    m_Localized: 'Jacket: Ich dachte, er würde mir etwas Kleines mitbringen, wie einen dieser lustigen Stifte oder einen Kühlschrankmagneten ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460677
    m_Localized: 'Jacket: Aber stattdessen hat er richtig Geld für eine ganze Jacke ausgegeben! Ich war so verdammt glücklich.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460678
    m_Localized: 'Jacket: Ehrlich gesagt habe ich ihn nicht oft gesehen. Daher war ich total aus dem Häuschen, dass er an mich gedacht hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460679
    m_Localized: 'Jacket: Ich muss zugeben: Diese Jacke hat mir mehr als einmal Ärger eingebracht. So eine findet man hier nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460680
    m_Localized: 'Jacket: Die Leute sehen sie und versuchen, sie mir abzuziehen und dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460681
    m_Localized: 'Jacket: Aber ich werde sie niemals hergeben. Sie ist nicht nur eine Jacke, sie ist eine Erinnerung an meinen Bruder.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460682
    m_Localized: 'Jacket: Ich hoffe nur, dass es ihm gut geht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460683
    m_Localized: 'Jacket: Verdammt ... Die ganze Sache ist so ein Schlamassel.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460684
    m_Localized: Hast du mal darüber nachgedacht, dass du deinen Bruder vielleicht in der Quarantänezone finden könntest?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460685
    m_Localized: 'Jacket: So einfach ist das nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460686
    m_Localized: 'Jacket: Sie haben meinen Bruder nicht in eine Quarantänezone gebracht. Sie haben ihn buchstäblich zur FEMA geholt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460687
    m_Localized: Du meinst also ...
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460688
    m_Localized: Scheiße
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460689
    m_Localized: 'Jacket: Ja. Er ist jetzt einer von ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460690
    m_Localized: 'Jacket: Sie haben ihm nicht mal eine Wahl gelassen. Sie sind einfach bei ihm aufgekreuzt und haben gesagt: „Du taugst“.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460691
    m_Localized: 'Jacket: Er wäre ihnen niemals freiwillig beigetreten. Niemals.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460692
    m_Localized: 'Jacket: Deshalb darf ich mich nicht von ihnen erwischen lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460693
    m_Localized: 'Jacket: Es ist nicht nur, dass ich Angst vor den Besuchern habe. Na ja, hat ja jeder.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460694
    m_Localized: 'Jacket: Aber während die meisten panische Angst haben und sich fragen, ob die Person vor ihnen ein Mensch ist ... habe ich Angst vor etwas anderem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460695
    m_Localized: 'Jacket: Was, wenn sich herausstellt, dass derjenige, der mich mitnimmt, mein Bruder ist?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460696
    m_Localized: 'Jacket: Was würde er tun? Die Regeln brechen und mich gehen lassen? Und was würde mit ihm passieren, wenn er es täte?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460697
    m_Localized: 'Jacket: Oder würde er Befehle befolgen und mich mit den anderen in die Quarantänezone verfrachten?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460698
    m_Localized: 'Jacket: Und wenn sie ihm befehlen würden, mich zu erschießen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460699
    m_Localized: 'Jacket: Würde es mich trösten zu wissen, dass mein eigener Bruder abgedrückt hat? Oder würde es das noch schlimmer machen?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460700
    m_Localized: 'Jacket: Nichts davon fühlt sich richtig an.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460701
    m_Localized: 'Jacket: Tausend ängstliche Gedanken schwirren mir im Kopf rum. Aber nur einer macht mir wirklich panische Angst ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460702
    m_Localized: 'Jacket: Wenn sie mich eines Tages holen ... werde ich vielleicht nie erfahren, ob das hinter der Maske mein eigener Bruder war.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725184
    m_Localized: 'Tough: Nichts ist einfach. Gar nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725185
    m_Localized: Du hattest es nicht leicht, was?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725186
    m_Localized: 'Tough: Ich schätze, jeder, der es mal leicht hatte, ist mittlerweile tot.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725187
    m_Localized: 'Tough: Als Geld einen nicht mehr zum König der Welt machte, kamen die Weicheier damit nicht klar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725188
    m_Localized: 'Tough: Wenn man kein Rückgrat hat, wird man leicht zum Opfer – eines Vergewaltigers, Opportunisten oder einfach irgendeines Irren.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725189
    m_Localized: 'Tough: Du hast es doch auch gesehen, oder? Die Leute werden zu Tieren. Aber wir nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725190
    m_Localized: 'Tough: Wir lassen uns nicht auf ihr Niveau herab. Wir können uns wehren und anderen das Überleben ermöglichen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725191
    m_Localized: 'Tough: Wir sind diejenigen, die leben wollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725192
    m_Localized: 'Tough: Der Dreck, die Feiglinge, die, die aufgegeben haben – die werden von dieser Welt aussortiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725193
    m_Localized: 'Tough: Ja, das klingt radikal. Aber so ist es nun mal. Wir können es nicht ändern.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725194
    m_Localized: 'Tough: Wir können nur versuchen, den Rest unserer Menschlichkeit zu bewahren. Ich hoffe, dieser Ort kann dabei helfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725195
    m_Localized: 'Tough: Nichts ist einfach. Gar nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725196
    m_Localized: Ich weiß nicht so recht
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725197
    m_Localized: 'Tough: Wir können nicht einfach sagen: „Alles wird gut.“ Na ja, können wir schon, aber das ändert rein gar nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725198
    m_Localized: 'Tough: Plattitüden bringen nichts. Entweder du bist bereit für die Hölle ... oder eben nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725199
    m_Localized: Ich verstehe nicht ganz, warum ich es sein sollte, der die Leute tröstet
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725200
    m_Localized: Würdest du das nicht auch gern hören, nur ein einziges Mal?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725201
    m_Localized: 'Tough: Genau das meine ich ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725202
    m_Localized: 'Tough: Manchen Leuten musst du das Händchen halten, den Arsch abwischen, einfach alles für sie tun.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725203
    m_Localized: 'Tough: Und wenn es dann drauf ankommt, wirklich zu handeln, knicken sie ein.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725204
    m_Localized: 'Tough: Sie fallen zusammen wie ein Kartenhaus und reißen alle anderen mit sich.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725205
    m_Localized: 'Tough: Ein „Alles wird gut“ ändert daran nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725206
    m_Localized: 'Tough: Das mache ich nicht noch einmal mit.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725207
    m_Localized: 'Tough: Schwäche hat hier keinen Platz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725208
    m_Localized: 'Tough: Ich bin wohl etwas zu hart. Die Erinnerungen sind noch frisch.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725209
    m_Localized: 'Tough: Reden wir später, ja?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725210
    m_Localized: 'Tough: Was?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725211
    m_Localized: 'Tough: Und was soll das bringen?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725212
    m_Localized: 'Tough: Worte ändern einen verdammten Dreck. Holen sie die Toten zurück? Bringen sie einen Vergewaltiger dazu, sich die Eier abzuschneiden?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725213
    m_Localized: 'Tough: Ich habe ein Messer, aber keinen Zucker für die bittere Pille.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725214
    m_Localized: 'Tough: Wir müssen uns an diese neue Welt anpassen oder sterben. Alles andere ist sinnlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725215
    m_Localized: 'Tough: Ich wollte dich nicht anfahren. Aber frag so einen dummen Scheiß nicht noch mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725216
    m_Localized: 'Tough: Nichts ist einfach. Gar nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725217
    m_Localized: Also ... was hast du da?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725218
    m_Localized: 'Tough: Ich sag’s dir ganz direkt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725219
    m_Localized: 'Tough: Ich habe gesehen, wie du auf diese Kiste im Lagerraum starrst. Wie du am Schlafzimmerfenster erstarrst.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725220
    m_Localized: 'Tough: Ich habe letzte Nacht einen Blick riskiert. Du bist in diesem Haus gefangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725221
    m_Localized: 'Tough: Du kämpfst nicht, um am Leben zu bleiben. Du hast nur Angst zu sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725222
    m_Localized: 'Tough: Stimmt’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725223
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725224
    m_Localized: Verpiss dich
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725225
    m_Localized: 'Tough: Schwachsinn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725226
    m_Localized: 'Tough: Ich sehe genau, wie verkrampft du bist.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725227
    m_Localized: 'Tough: Das Einzige, was dich davon abhält, dich umzubringen, ist die Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725228
    m_Localized: 'Tough: Zuerst dachte ich, du wärst durch die Hölle gegangen, abgehärtet von all dem Mist, den das Leben dir vor die Füße geworfen hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725229
    m_Localized: 'Tough: Aber in Wirklichkeit bist du nur eine weitere verängstigte Seele, die dem Schlimmsten irgendwie entkommen ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725230
    m_Localized: 'Tough: Ich bin ... enttäuscht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725231
    m_Localized: 'Tough: Ich will nicht mehr mit dir reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725232
    m_Localized: 'Tough: Du erinnerst mich an irgendein Schulkind mit großen Augen, das von Raufbolden in die Enge getrieben wird.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725233
    m_Localized: 'Tough: Das beweist nur, was ich sage. Du bist nur ein weiterer Schwächling, der zufällig eine Waffe in die Finger bekommen hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725234
    m_Localized: 'Tough: Das ist alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725235
    m_Localized: 'Tough: Zuerst dachte ich, du wärst durch die Hölle gegangen, abgehärtet von all dem Mist, den das Leben dir vor die Füße geworfen hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725236
    m_Localized: 'Tough: Aber in Wirklichkeit bist du nur eine weitere verängstigte Seele, die dem Schlimmsten irgendwie entkommen ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725237
    m_Localized: 'Tough: Ich bin ... enttäuscht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725238
    m_Localized: 'Tough: Ich will nicht mehr mit dir reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725239
    m_Localized: 'Tough: Nichts ist einfach. Gar nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725240
    m_Localized: Wo hast du sonst noch rumgeschnüffelt?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725241
    m_Localized: 'Tough: Ich habe es getan, weil ich alles tun werde, um zu überleben.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725242
    m_Localized: 'Tough: Ich musste wissen, mit wem ich es zu tun habe. Und worauf ich achten muss.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725243
    m_Localized: 'Tough: Dieser Ort ist voller Erinnerungen. Eine tote Familie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725244
    m_Localized: 'Tough: Das hat mich zum Nachdenken gebracht ... dass du die Vergangenheit nicht loslassen kannst.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725245
    m_Localized: 'Tough: Aber das ist nicht meine Angelegenheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725246
    m_Localized: 'Tough: Nur ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725247
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725248
    m_Localized: 'Tough: Ich war mal weicher. Jünger. Habe mal einen Typen kennengelernt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725249
    m_Localized: 'Tough: Er sagte, wir müssten bei ihm vorbeischauen, um seiner Mutter etwas zu bringen. Ich wollte nicht mit reinkommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725250
    m_Localized: 'Tough: Ich entschied mich, draußen zu warten, aber kurz darauf rief er aus dem Fenster, ich solle hochkommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725251
    m_Localized: 'Tough: Bin ich auch. Da war aber keine Mutter. Nur dieser Bastard und sein Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725252
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725253
    m_Localized: 'Tough: Tja, als die Welt auseinanderbrach, habe ich sie gefunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725254
    m_Localized: 'Tough: Ich habe mich danach nicht besser gefühlt. Nicht wirklich.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725255
    m_Localized: 'Tough: Lange Zeit dachte ich, ich sei schmutzig. Als ob ich es nie abwaschen könnte. ... Aber dann ging die Welt unter.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725256
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725257
    m_Localized: 'Tough: Mistkerle wie die verdienen kein Mitleid. Und die Schwachen auch nicht. Sie machen das Ganze erst möglich.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725258
    m_Localized: 'Tough: Ich werde nicht wieder in deinen Sachen wühlen. Aber ich glaube, du verstehst mich jetzt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725259
    m_Localized: 'Bald: 1, 2, 3, 4 ... Vielleicht verbrenne ich einfach alles ... Kleiner Scherz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725260
    m_Localized: Was ist mit deinen Freunden?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725261
    m_Localized: 'Bald: Aha! Wir haben uns alle auf der Theaterschule kennengelernt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725262
    m_Localized: 'Bald: Ich habe Theaterproduktion studiert. Und lass dir gleich sagen, mein Freund, das würde ich niemandem empfehlen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725263
    m_Localized: 'Bald: Eigentlich Theater im Allgemeinen. Von außen mag das alles sehr edel aussehen, aber heutzutage schätzt niemand mehr die Bühne.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725264
    m_Localized: 'Bald: Also, wenn man es nur „für die Kunst“ macht und es einem nichts ausmacht, sein ganzes Leben lang pleite zu sein – nur zu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725265
    m_Localized: 'Bald: Klar, es gibt ein paar große Ensembles, die auf den berühmten Bühnen spielen, aber die sind selten.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725266
    m_Localized: 'Bald: Alles andere ist Low-Budget-Kram. Die Leute sehen sich lieber einen Film an. Weil es billiger, schriller und einfacher ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725267
    m_Localized: 'Bald: Also ja ... eine einzige große Enttäuschung, mein Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725268
    m_Localized: 'Bald: 1, 2, 3, 4 ... Vielleicht verbrenne ich einfach alles ... Kleiner Scherz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725269
    m_Localized: Okay, Theater ist scheiße, aber was ist mit deinen Freunden?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725270
    m_Localized: 'Bald: Ach ja, die Geschichte habe ich ja gar nicht zu Ende erzählt. Sorry, ich springe oft von einem zum anderen. Ich kann mich nur schwer auf eine Sache konzentrieren. Egal.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725271
    m_Localized: 'Bald: Meine Freunde waren alles Schauspieler, Produzenten, Tontechniker, Lichttechniker. Solche Leute eben.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725272
    m_Localized: 'Bald: Wir waren vom ersten Tag an ständig betrunken. Ich habe für meine Geburtstage sogar kleine Bühnen gemietet – da kamen hundert Leute!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725273
    m_Localized: 'Bald: Und es war umwerfend! Stell dir vor, hundert Leute kommen nur, um dich zu feiern! Mann, das waren noch Zeiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725274
    m_Localized: 'Bald: Aber die Theaterwelt ist die Hölle, total toxisch. Jeder versucht, den anderen auszustechen. Kein Geld, zu viel Stress.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725275
    m_Localized: 'Bald: Mit der Zeit hörten diese Partys auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725276
    m_Localized: 'Bald: Und mir wurde klar, dass die meisten Leute, die zu meinen Geburtstagen kamen, keine echten Freunde waren ... Sie waren einfach ... da.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725277
    m_Localized: 'Bald: Sie haben mich ausgenutzt, wenn es ihnen passte, oder hinter meinem Rücken über mich gelästert.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725278
    m_Localized: 'Bald: Aber na ja, versteh mich nicht falsch! Ich hab mich hingesetzt, eine Liste gemacht und überlegt, wen ich rausschmeißen soll.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725279
    m_Localized: 'Bald: 1, 2, 3, 4 ... Vielleicht verbrenne ich einfach alles ... Kleiner Scherz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725280
    m_Localized: Und wo sind diese Freunde von deiner Liste?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725281
    m_Localized: 'Bald: Als der ganze Mist mit den Schuldeneintreibern anfing, hab ich überall nach Hilfe gesucht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725282
    m_Localized: 'Bald: Aber natürlich fing genau da die Sonne an, die Leute zu braten, und die Besucher krochen hervor. Alles wurde nur NOCH schlimmer.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725283
    m_Localized: 'Bald: Also bin ich von einem Freund zum nächsten gegangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725284
    m_Localized: 'Bald: Hab rausgefunden, dass einer bei lebendigem Leibe verbrannt ist – ist betrunken auf einem Spielplatz eingeschlafen und vor Sonnenaufgang nicht aufgewacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725285
    m_Localized: 'Bald: Ein anderer wurde umgebracht ... Kaum zu glauben, oder? Sie dachten, er wäre ein Besucher!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725286
    m_Localized: 'Bald: Das ist doch irre! Diese sogenannten „Anzeichen“ sind totaler Schwachsinn! Sie haben meine Freunde einfach grundlos umgebracht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725287
    m_Localized: 'Bald: Das macht mich so verdammt wütend – und ich weiß nicht mal, wohin mit diesem Gefühl.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725288
    m_Localized: 'Bald: Wut, gemischt mit Hilflosigkeit – das lähmt einen einfach. Man fängt an, jeden um sich herum zu hassen. Und sich selbst.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725289
    m_Localized: 'Bald: Verdammt ... Diese Dreckschweine.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725290
    m_Localized: 'Bald: 1, 2, 3, 4 ... Vielleicht verbrenne ich einfach alles ... Kleiner Scherz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725291
    m_Localized: Und was hat es mit den Schuldeneintreibern auf sich?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725292
    m_Localized: 'Bald: Ich hab bei meiner Mom und meiner Oma gewohnt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725293
    m_Localized: 'Bald: Mein Alter ist abgehauen – er war auch Schauspieler. Ein Betrüger, ein Säufer. Klassisches Theater, hm? Meine Mom hat in der Kostümabteilung gearbeitet.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725294
    m_Localized: 'Bald: Sie hat mein ganzes Leben lang versucht, mich zu beschützen. Und als ich erwachsen wurde, hab ich herausgefunden, dass wir die ganze Zeit bis zum Hals in Schwierigkeiten steckten.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725295
    m_Localized: 'Bald: Meine Mom hat nicht immer einen Job gefunden. Große Theater? Vergiss es – unmöglich. Kleine? Kaum Geld oder gar keine Arbeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725296
    m_Localized: 'Bald: Also hat sie einen Kredit aufgenommen. Nicht von jemandem, den sie kannte, sondern von irgendeiner Firma. Nur damit wir was zu essen hatten.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725297
    m_Localized: 'Bald: Natürlich konnte sie ihn nicht zurückzahlen. Dann kamen die Schuldeneintreiber.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725298
    m_Localized: 'Bald: Ich erinnere mich, dass wir diese strenge Regel hatten: Mach die Tür nicht auf, wenn du niemanden erwartest.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725299
    m_Localized: 'Bald: Und wenn du zum Haus kamst und da irgendwelche Typen rumhingen? Dann bist du noch ein paar Stunden spazieren gegangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725300
    m_Localized: 'Bald: Das war echt beschissen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725301
    m_Localized: 'Bald: Und bei allem anderen, was so abging ... wurden die Leute brutal. Die Schuldeneintreiber erst recht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725302
    m_Localized: 'Bald: Einmal kam ich nach Hause. Die Tür stand sperrangelweit offen. Alles verwüstet. Mom und Oma ... Verdammt ... Ihre Finger, Beine ... gebrochen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725303
    m_Localized: 'Bald: Scheiße ... Das war ein Albtraum.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725304
    m_Localized: 'Bald: Dann sind diese zwei riesigen Typen aufgetaucht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725305
    m_Localized: 'Bald: Ich bin weggerannt. Natürlich bin ich weggerannt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725306
    m_Localized: 'Bald: Ich hatte Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725307
    m_Localized: 'Bald: Aber verdammt, ich hasse mich dafür. Dafür, dass ich sie nicht beschützt habe. Dass ich wie ein Feigling weggelaufen bin. Dass ich nie zurückgegangen bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725308
    m_Localized: 'Bald: Ich habe einfach zu viel Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725309
    m_Localized: 'Bald: Eine egoistische Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725310
    m_Localized: 'Bald: Und das ist einfach ... unbeschreiblich beschissen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725311
    m_Localized: 'Nervous: Ich will da nicht zurück, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725312
    m_Localized: Du bist ... irgendwie seltsam.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725313
    m_Localized: 'Nervous: Ach ja? Und was geht dich das an? Na? Na?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725314
    m_Localized: 'Nervous: Stalkst du mich etwa auch? Na? Na?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725315
    m_Localized: 'Nervous: Du solltest wissen, dass ich das nicht mag. Seit der Klapse-Klapse.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725316
    m_Localized: 'Nervous: Meine Alten haben mich in ein Irrenhaus gesperrt, stell dir das mal vor, hihi!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725317
    m_Localized: 'Nervous: Ja, sie sagten, ich hätte jemanden ein bisschen ver...folgt. Na und?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725318
    m_Localized: 'Nervous: Ich hab doch gar nichts Falsches gemacht, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725319
    m_Localized: 'Nervous: Aber meine Eltern dachten, ich sei verrrrrückt. Vielleicht denken sie das immer noch.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725320
    m_Localized: 'Nervous: Sie haben mich immerhin zehn Jahre in dieser Klapsmühle festgehalten. Als ob ich irgendein Irrer wäre, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725321
    m_Localized: 'Nervous: Und das alles nur wegen dieses einen Mals ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725322
    m_Localized: 'Nervous: Ach, egal. Ich muss das Hotel anrufen. Klingelingeling!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725323
    m_Localized: 'Nervous: Ich will nicht dahin zurück, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725324
    m_Localized: Was hast du vorhin gesagt?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725325
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725326
    m_Localized: 'Nervous: Sie haben mich in der Schule gemobbt. Mich nicht in Ruhe gelassen. Jeden einzelnen Tag auf mir rumgehackt. Hack, hack, hack.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725327
    m_Localized: 'Nervous: Natürlich bin ich ausgerastet. Ich bin doch kein Sandsack. Ein Sack Fleisch, den man tritt, bis er quietscht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725328
    m_Localized: 'Nervous: Ich hab mich gewehrt. Sie sind umgekippt ... und nicht mehr aufgestanden. Ich hab gehört, er war im Kr...ankenhaus. Tot.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725329
    m_Localized: 'Nervous: Ich wollte ihn nicht umbringen. Aber na ja, na ja, na ja ... Meine Alten haben das irgendwie ins Lot gebracht. Hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725330
    m_Localized: 'Nervous: Trotzdem flüstern sie über mich ... Hörst du sie? Pssst ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725331
    m_Localized: 'Nervous: Dann haben sie mich in die Klapsmühle abgeschoben. Und da wären wir wieder am Anfang!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725332
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725333
    m_Localized: 'Nervous: Dieser Kampf ... Das hat sich gut angefühlt ... Die M...acht ... Die R...ache ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725334
    m_Localized: 'Nervous: Meine Knöchel haben so schön wehgetan. Der Geschmack von Rot auf meinen Lippen, meiner Zunge ... Mmmm ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725335
    m_Localized: 'Nervous: Sie haben mich rausgeworfen. Aber ich habe mich doch nur verteidigt, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725336
    m_Localized: 'Nervous: Ich will nicht dahin zurück, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725337
    m_Localized: Die Klapsmühle hat dir nicht gutgetan.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725338
    m_Localized: 'Nervous: Kein klitzekleines bisschen, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725339
    m_Localized: 'Nervous: Wenn man durch die Pillen dahinvegetiert ... schmort man nur noch vor sich hin!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725340
    m_Localized: 'Nervous: Es wurde nicht besser. Es wurde nicht einfacher. Zehn Jahre später ... immer noch das Gleiche, tada!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725341
    m_Localized: 'Nervous: Und das alles wegen dieses einen klitzekleinen Mals, als ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725342
    m_Localized: 'Nervous: Hihihihihi ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725343
    m_Localized: 'Nervous: Ach, als ob niemand jemals Fehler macht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725344
    m_Localized: 'Nervous: Guck dich an, wie du gleich den Richter spielst.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725345
    m_Localized: 'Nervous: Willst du mich schlagen? Na los!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725346
    m_Localized: 'Nervous: Schlag mir ins Gesicht, brich mir die Finger! JA! Ich brauche diesen Kick, gib mir mehr! Jaaaaaaaaaa!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725347
    m_Localized: 'Nervous: Was? Du schlägst mich nicht? Verspürst du keinen Drang dazu?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725348
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725349
    m_Localized: 'Nervous: Hihi ... Dann warte ich eben einfach hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725350
    m_Localized: 'Nervous: Hier ... ist es tatsächlich ruhiger als im Hotel.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725351
    m_Localized: 'Nervous: Danke, dass du mich reingelassen hast. Hihi ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725352
    m_Localized: 'Nervous: Wenigstens sind wir hier alle verrückt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725353
    m_Localized: 'Leper: Ja? Was gibt’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725354
    m_Localized: Ist es schwer, so auszusehen?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725355
    m_Localized: 'Leper: Na ja, nicht wirklich.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725356
    m_Localized: 'Leper: Außer damals in der Schule. Da nannten sie mich einen Aussätzigen und keiner wollte mit mir spielen. Sie dachten alle, sie würden sich anstecken.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725357
    m_Localized: 'Leper: Ich dachte, wenn ich erwachsen bin, würde es aufhören. Tat es auch ... größtenteils. Klar, die Leute haben manchmal immer noch gestarrt, aber das ist egal.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725358
    m_Localized: 'Leper: Dann kam die Katastrophe, und plötzlich krochen all die alten Vorurteile wieder hervor.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725359
    m_Localized: 'Leper: Nur ist es jetzt noch schlimmer – weil es ums Überleben geht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725360
    m_Localized: 'Leper: Und natürlich sehe ich wegen meiner Haut wie ein Besucher aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725361
    m_Localized: 'Leper: Aber was soll man machen? Schlechte Zeiten bringen das Schlechteste in den Menschen zum Vorschein.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725362
    m_Localized: 'Leper: Ja? Was gibt’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725363
    m_Localized: Man stempelt dich nur wegen deiner Haut als Besucher ab?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725364
    m_Localized: 'Leper: Na klar. Was erwartest du?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725365
    m_Localized: 'Leper: Es ist eine regelrechte Hexenjagd im Gange.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725366
    m_Localized: 'Leper: Jeder, der nicht „normal“ aussieht, ist Freiwild. Und die FEMA sind Richter, Geschworene und Henker in einem.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725367
    m_Localized: 'Leper: Da frage ich mich: Was, wenn sie in Wahrheit hinter all dem stecken?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725368
    m_Localized: 'Leper: Also, ich meine: Was, wenn sie die Besucher selbst erfunden haben? Was meinst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725369
    m_Localized: Vielleicht hast du recht
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725370
    m_Localized: Ich glaube, die Besucher sind echt
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725371
    m_Localized: 'Leper: Freut mich, dass du mir zustimmst. Von wegen Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725372
    m_Localized: 'Leper: Klingt eher wie aus einem Film.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725373
    m_Localized: 'Leper: Vielleicht ist das ihre Methode, die Regierung zu stürzen. Aus Angst erwächst doch Macht, nicht wahr?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725374
    m_Localized: 'Leper: Deshalb stecken sie wahrscheinlich jeden, der anderer Meinung ist, in diese „Quarantänezonen“.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725375
    m_Localized: 'Leper: Außerdem erweckt es den Anschein, als würden sie die Besucher bekämpfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725376
    m_Localized: 'Leper: Selbst wenn es die Besucher nicht gibt, will ich trotzdem nicht, dass die FEMA mich auf dem Schirm hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725377
    m_Localized: 'Leper: Ich werde das Gefühl nicht los, dass sie mir etwas Schreckliches antun werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725378
    m_Localized: 'Leper: Du glaubst, es ist wahr?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725379
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725380
    m_Localized: 'Leper: Selbst wenn es wahr ist, findest du dann nicht trotzdem, dass die FEMA sich seltsam verhält?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725381
    m_Localized: 'Leper: Sie sagen, die Besucher seien ein Virus, aber warum erklären sie dann nie, wie es sich verbreitet?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725382
    m_Localized: 'Leper: Wäre das nicht das Erste, was man tun würde, wenn man es wirklich aufhalten wollte?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919488
    m_Localized: 'Leper: Weiß nicht ... Vielleicht sind sie ja auf der Suche nach einer Art „Heilmittel“.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919489
    m_Localized: 'Leper: Aber ich habe da so ein Bauchgefühl ... wenn ich in einer ihrer Quarantänezonen lande, wird mir etwas Furchtbares zustoßen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919490
    m_Localized: 'Leper: Ja? Was gibt’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919491
    m_Localized: Warum glaubst du, dass die FEMA etwas Schlimmes tun wird?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919492
    m_Localized: 'Leper: Weil sie in mir nichts anderes sehen als meinen verdammten Zustand ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919493
    m_Localized: 'Leper: Er ist wie eine Zielscheibe auf meinem Rücken. Eine höhere Wahrscheinlichkeit, dass ich für ihre ... Experimente aus der Masse herausgepickt werde.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919494
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919495
    m_Localized: 'Leper: Und das alles nur wegen meiner verdammten Haut.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919496
    m_Localized: Du bist hier, also brauchst du dir keine Sorgen zu machen
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919497
    m_Localized: Du machst dir zu viele Gedanken
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919498
    m_Localized: 'Leper: Ach ja? Bei dir haben sie also noch nicht an die Tür geklopft, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919499
    m_Localized: 'Leper: Glaubst du wirklich, sie würden mich einfach ignorieren, so wie ich aussehe?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919500
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919501
    m_Localized: 'Leper: Das glaubst du also, hm?! Hast du je von dem Feuer im Kindergarten gehört?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919502
    m_Localized: 'Leper: Das, bei dem Eltern ihre eigenen Kinder bei lebendigem Leibe verbrannt haben?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919503
    m_Localized: 'Leper: Du kapierst es nicht: Wir sind ein paar hundert Jahre zurückgeworfen worden. Der Wahnsinn breitet sich aus wie die Pest, und die FEMA zehrt davon.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919504
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919505
    m_Localized: 'Leper: Ich wünschte nur, die Leute würden aufhören, andere nach ihrem Aussehen zu beurteilen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919506
    m_Localized: 'Leper: Aber wie lange die Menschheit auch existieren mag: Sie wird andere Leute wohl immer als irgendwas abstempeln.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919507
    m_Localized: 'Leper: Das macht es einfacher zu entscheiden, wer dazugehört ... und wer nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919508
    m_Localized: 'Leper: Und Leute wie ich zahlen immer den Preis für diese engstirnige Grausamkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919509
    m_Localized: 'Leper: Es ist wirklich alles einfach nur ... traurig.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891008
    m_Localized: 'Fairytaller: Brauchen Sie etwas?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891009
    m_Localized: Sie scheinen in Gedanken versunken zu sein
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891010
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891011
    m_Localized: Eine FEMA-Mitteilung geben
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891012
    m_Localized: 'Fairytaller: Ich habe gerade an eine Geschichte aus meiner Kindheit gedacht. Über Gimpel in einem Zauberwald ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891013
    m_Localized: 'Fairytaller: Dann kam ein Drache ... Er verbrannte alles – die Nester, die Vögel ... alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891014
    m_Localized: 'Fairytaller: In gewisser Weise waren sie gleich. Beide hatten Flügel und teilten sich denselben Himmel. Alle lebten friedlich zusammen und teilten sich die Reichtümer des Waldes.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891015
    m_Localized: 'Fairytaller: Aber die Stärke des Drachen benebelte seinen Verstand. Er verbrannte sogar das, was er vielleicht einmal geliebt hatte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891016
    m_Localized: 'Fairytaller: Mein Vater hat immer behauptet, dass in jedem von uns ein schlafender Drache steckt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891017
    m_Localized: 'Fairytaller: Meine Schwester und ich haben das nie geglaubt. Wir haben nur gelacht. „Drachen sind riesig“, sagten wir, „und Menschen so klein.“'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891018
    m_Localized: 'Fairytaller: Dann wurde ich erwachsen, und schließlich habe ich es verstanden. Schade, dass er es nie erfahren wird.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891019
    m_Localized: 'Fairytaller: Aber hin und wieder frage ich mich ... werde ich meinen eigenen Drachen erschlagen können, oder wird die Versuchung mich verschlingen?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891020
    m_Localized: 'Fairytaller: Brauchen Sie etwas?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891021
    m_Localized: Denken Sie wieder an Märchen?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891022
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891023
    m_Localized: Eine FEMA-Mitteilung geben
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891024
    m_Localized: 'Fairytaller: Ja. Mir ist heute eine weitere Geschichte eingefallen. Über die Gefrorene Stadt, einen Ort mit hohen Mauern und eisigen Türmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891025
    m_Localized: 'Fairytaller: Sie lebten jahrhundertelang, ohne einander zu vertrauen. Es wirkte, als würde das immer so bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891026
    m_Localized: 'Fairytaller: Aber dann kam ein reisender Glasbläser vorbei und nach und nach begann sich alles zu ändern.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891027
    m_Localized: 'Fairytaller: Er säumte die Straßen mit seinen Laternen und verpasste keine Gelegenheit, seinen Nachbarn einen guten Morgen zu wünschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891028
    m_Localized: 'Fairytaller: Zuerst lachten sie ihn aus. Aber dann, nach und nach, begann das Eis in ihren Herzen zu schmelzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891029
    m_Localized: 'Fairytaller: Es ist fast unmöglich, alles über Nacht zu ändern. Die wahre Veränderung muss in einem selbst beginnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891030
    m_Localized: 'Fairytaller: Man muss seine eigene Laterne anzünden, auch wenn die Welt um einen herum dunkel ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891031
    m_Localized: 'Fairytaller: Mutter, Gott hab sie selig, scherzte immer, die Moral sei ganz simpel: Wer auf Veränderung wartet, stirbt wartend.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891032
    m_Localized: 'Fairytaller: Am Ende sind wir es, die diese Welt am Leben erhalten. Wenn wir es nicht versuchen, haben wir bereits verloren.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891033
    m_Localized: 'Fairytaller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891034
    m_Localized: 'Fairytaller: Ich versuche, an der Güte festzuhalten. An der Menschlichkeit. Selbst wenn es wehtut. In der vagen Hoffnung, dass dies anderen den Weg weist.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891035
    m_Localized: 'Fairytaller: Brauchen Sie etwas?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891036
    m_Localized: Welche Geschichte haben Sie heute für mich?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891037
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891038
    m_Localized: Eine FEMA-Mitteilung geben
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891039
    m_Localized: 'Fairytaller: Es gibt noch viele Geschichten zu erzählen ... Von den Toten, die auferstehen, und dem Leben derer, die zurückbleiben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891040
    m_Localized: 'Fairytaller: Von einem Teufel in Menschengestalt, der an Türen klopft und bis zum Sonnenaufgang Fragen stellt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891041
    m_Localized: 'Fairytaller: Als der Zorn der blutroten Sonne über die Menschheit hereinbrach, ihre Ernten verfluchte und ihre Flüsse versiegen ließ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891042
    m_Localized: 'Fairytaller: Aber es gab eine tapfere Seele oder ein Team von beherzten Leuten oder eine ganze Nation, die die Welt retten sollte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891043
    m_Localized: 'Fairytaller: Das Gute hat immer gesiegt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891044
    m_Localized: 'Fairytaller: Ich will glauben, dass auch das hier vorübergehen wird. Dass ein Jahr, ein Tag, ein Moment kommen wird, an dem all das endet.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891045
    m_Localized: 'Fairytaller: Und unsere Eltern werden am Leben sein. Und jeder wird tun können, was er liebt. Und ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891046
    m_Localized: 'Fairytaller: Verzeihen Sie mir, bitte. Ich habe mich ein wenig gehen lassen. Ich glaube, ich brauche etwas Zeit für mich allein.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891047
    m_Localized: 'FunnyGuy: Wir könnten jetzt so ein sorgenfreies Leben führen!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891048
    m_Localized: Wieso bist du dir so sicher, dass sie deinen Kredit vergessen werden?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891049
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891050
    m_Localized: Eine FEMA-Mitteilung geben
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891051
    m_Localized: 'FunnyGuy: Willst du mich verarschen?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891052
    m_Localized: 'FunnyGuy: Alter, das ist das Ende der Welt! Welche Banken, welche Wirtschaft?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891053
    m_Localized: 'FunnyGuy: Das interessiert niemanden mehr. Ich hab es mit eigenen Augen gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891054
    m_Localized: 'FunnyGuy: Wenn ich eine Zahlung verpasse, kriege ich normalerweise Benachrichtigungen, Briefe, Drohungen. All solchen Kram.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891055
    m_Localized: 'FunnyGuy: Aber dieses Mal nicht ... Totenstille. Ein Segen!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891056
    m_Localized: 'FunnyGuy: Was wollen die schon mit einer Liste von Schuldnern anfangen, die nur nach Einbruch der Nacht zu finden sind?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891057
    m_Localized: 'FunnyGuy: Klar, neue Kredite vergibt auch keiner mehr. Das hab ich schon versucht!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891058
    m_Localized: 'FunnyGuy: Aber hey! Frei von den Fesseln der finanziellen Sklaverei zu sein, ist schon ein Sieg für sich!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891059
    m_Localized: Ich würde mich noch nicht entspannen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891060
    m_Localized: Also, fangen wir jetzt mit der Party an oder was?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891061
    m_Localized: 'FunnyGuy: Ach, komm schon!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891062
    m_Localized: 'FunnyGuy: Warum der Stress? Ich bin denen doch egal. Die sind wahrscheinlich damit beschäftigt, Bunker zu graben oder so.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891063
    m_Localized: 'FunnyGuy: Warum sollten sie sich die Mühe machen, nach irgendeinem Landei zu suchen?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891064
    m_Localized: Warum bist du dann nicht in deiner Wohnung?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891065
    m_Localized: Bist du also nur hergekommen, um anzugeben?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891066
    m_Localized: 'FunnyGuy: Und wie!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891067
    m_Localized: 'FunnyGuy: Ich bin so gut drauf. Hatte einfach Lust zu quatschen, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891068
    m_Localized: Warum bist du dann nicht in deiner Wohnung?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891069
    m_Localized: Bist du also nur hergekommen, um anzugeben?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891070
    m_Localized: 'FunnyGuy: Na ja ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891071
    m_Localized: 'FunnyGuy: Ich hatte sie vermietet. Technisch gesehen immer noch. Aber heutzutage ist Geld nicht mehr viel wert.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891072
    m_Localized: 'FunnyGuy: Man läuft einfach rum, schlägt ein Fenster ein und schnappt sich, was man braucht.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862528
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862529
    m_Localized: 'FunnyGuy: Was? Verurteilst du mich etwa?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862530
    m_Localized: Warum weichst du der Frage aus?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862531
    m_Localized: Mir ist gerade klar geworden, dass es mir eigentlich egal ist
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862532
    m_Localized: 'FunnyGuy: Hey, Mann. Werd nicht gleich schnippisch. Ich hab doch nichts Schlimmes gesagt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862533
    m_Localized: 'FunnyGuy: Wenn du einen Witz machen wolltest, hättest du doch nicht gleich so gemein werden müssen. Meine Güte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862534
    m_Localized: 'FunnyGuy: Du hast mir die Laune verdorben. Einfach so.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862535
    m_Localized: Warum weichst du der Frage aus?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862536
    m_Localized: Mir ist gerade klar geworden, dass es mir eigentlich egal ist
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862537
    m_Localized: 'FunnyGuy: Ja, ja ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862538
    m_Localized: 'FunnyGuy: Hör zu ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862539
    m_Localized: 'FunnyGuy: Ich weiche nicht aus. Es ist nur ... ich habe Angst, okay? Angst, zurückzugehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862540
    m_Localized: 'FunnyGuy: Ich hab mein Zuhause an eine zweiköpfige Familie vermietet. Das hat mir geholfen, die Hypothekenzahlungen zu leisten.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862541
    m_Localized: 'FunnyGuy: Und, na ja ... ich weiß nicht, ob sie noch ... Menschen sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862542
    m_Localized: 'FunnyGuy: Die Nachbarn haben ein paar Mal angerufen und meinten, da gäbe es Geklopfe, Geschrei, und Leute, die ein- und ausgehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862543
    m_Localized: 'FunnyGuy: Allerdings sind diese Nachbarn auch panische alte Schachteln. Die machen mich wahnsinnig.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862544
    m_Localized: 'FunnyGuy: Aber was, wenn sie trotzdem recht haben?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862545
    m_Localized: 'FunnyGuy: Warte, lass mich ausreden.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862546
    m_Localized: 'FunnyGuy: Ich muss mir das von der Seele reden. Siehst du nicht, wie unangenehm mir das ist?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862547
    m_Localized: 'FunnyGuy: Ich hab mir eine eigene Bude gekauft und hab jetzt zu viel Schiss, um darin zu wohnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862548
    m_Localized: 'FunnyGuy: Ich hab sie an eine Familie vermietet und mit der Miete die Hypothek abbezahlt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862549
    m_Localized: 'FunnyGuy: Und jetzt ... Verdammt ... traue ich mich nicht mal, an der Tür zu klingeln ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862550
    m_Localized: 'FunnyGuy: Die Nachbarn meinten, da passieren seltsame Sachen. Die verlassen die Wohnung kaum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862551
    m_Localized: 'FunnyGuy: Und ja, vielleicht muss ich jetzt die Hypothek nicht mehr bezahlen. Aber Scheiße, ich werde auch nicht versuchen, sie rauszuschmeißen!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862552
    m_Localized: 'FunnyGuy: Wir könnten jetzt so ein sorgenfreies Leben führen!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862553
    m_Localized: Gibt es Neuigkeiten von deinen Mietern?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862554
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862555
    m_Localized: Eine FEMA-Mitteilung geben
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862556
    m_Localized: 'FunnyGuy: Hä? Ach, die? Ich habe andere Sorgen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862557
    m_Localized: 'FunnyGuy: Ich hab heute Abend die Nachbarn angerufen. Hoffe, das macht dir nichts aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862558
    m_Localized: 'FunnyGuy: Sie sagten, ein paar Typen von der Bank wären aufgetaucht. Die haben nach meinen Zahlungen gefragt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862559
    m_Localized: 'FunnyGuy: Ein Glück, dass ich nicht dort wohne. Aber trotzdem ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862560
    m_Localized: 'FunnyGuy: Wollen diese Mistkerle mich vielleicht sogar noch holen, wenn die Sonne explodiert?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862561
    m_Localized: 'FunnyGuy: Kannst du dir das vorstellen?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862562
    m_Localized: 'FunnyGuy: Echt jetzt, als Nächstes fangen die noch an, ihre Schuldner wiederzuerwecken.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862563
    m_Localized: 'FunnyGuy: Sollten die da drüben nicht ihre eigenen Ärsche retten? Warum machen die sich die Mühe, uns zu jagen?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862564
    m_Localized: 'FunnyGuy: Arschlöcher.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862565
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862566
    m_Localized: 'FunnyGuy: Wie auch immer, ich penne jetzt erst mal hier. Dann bleibe ich vielleicht wieder bei meinen Verwandten.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862567
    m_Localized: 'FunnyGuy: Je mehr, desto besser, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862568
    m_Localized: 'FunnyGuy: Nein, mal im Ernst, diese verdammten Schweine. Es ist das Ende der Welt, und die tauchen hier auf! Verdammt noch mal!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862569
    m_Localized: 'FunnyGuy: ... Gott wird über sie richten.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862570
    m_Localized: 'FunnyGuy: Wir könnten jetzt so ein sorgenfreies Leben führen!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862571
    m_Localized: Gehst du zurück in deine Wohnung?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862572
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862573
    m_Localized: Eine FEMA-Mitteilung geben
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862574
    m_Localized: 'FunnyGuy: Es ist ein Schlamassel, ein einziger Schlamassel.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862575
    m_Localized: 'FunnyGuy: Ich hab wieder dein Telefon benutzt. Hoffe, das macht dir nichts aus. Diesmal die Bank.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862576
    m_Localized: 'FunnyGuy: Wie sich zeigt, sind meine Konten eingefroren. Und ich hatte sogar was gespart!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862577
    m_Localized: 'FunnyGuy: Jetzt komm ich an keinen Cent mehr ran.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862578
    m_Localized: 'FunnyGuy: Sie sagten, es sei wegen der Schulden, aber das ist Blödsinn. Die könnten die Hypothekenzahlungen einfach monatlich abbuchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862579
    m_Localized: 'FunnyGuy: Aber alles einfach einzufrieren? Völliger Schwachsinn.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862580
    m_Localized: 'FunnyGuy: Ich wette, die haben das gemacht, um die ganzen kleinen Projekte der FEMA zu bezahlen. Also ihre Mitarbeiter, Experimente, solche Sachen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862581
    m_Localized: 'FunnyGuy: Na ja ... zum Teufel mit denen. Ich zahle nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862582
    m_Localized: 'FunnyGuy: Ich bleibe eine Weile hier, wenn das in Ordnung ist. Es ist mir zu peinlich, jetzt zu meiner Familie zurückzugehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862583
    m_Localized: 'FunnyGuy: Und meine Wohnung ist jetzt wahrscheinlich entweder ein Nest der Besucher oder ein FEMA-Labor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862584
    m_Localized: 'Alt: ... Es wird von Tag zu Tag schwerer.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862585
    m_Localized: Du hast vor der Tür ganz schön viel geredet
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862586
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862587
    m_Localized: Eine FEMA-Mitteilung geben
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862588
    m_Localized: 'Alt: Ah, das ist dir also aufgefallen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862589
    m_Localized: 'Alt: Ist wohl eine Berufskrankheit. Zu viel reden. Vor allem, wenn ich nervös bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862590
    m_Localized: 'Alt: Ich denke immer, ich muss die Wogen glätten, alles ins Reine bringen. Alles so annehmbar wie möglich machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862591
    m_Localized: 'Alt: ... Ich habe früher beim Radio moderiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862592
    m_Localized: Ach, verdammt
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862593
    m_Localized: Darauf wäre ich nie gekommen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862594
    m_Localized: 'Alt: Was?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862595
    m_Localized: 'Alt: Ob du mir glaubst oder nicht, ist mir total egal. Aber es wurde unmöglich, dort zu bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862596
    m_Localized: 'Alt: Das ist jetzt ein reiner Zirkus. Jeder Gauner ist auf Sendung und versucht, irgendwas zu verkaufen. Die bieten überteuerten Seelenfrieden an.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862597
    m_Localized: 'Alt: „Hier ist ein Wunderbalsam für all Ihre Sorgen.“ „Stellen Sie einfach ein Glas Wasser neben das Radio! Es wird die Wellen aufsaugen!“'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862598
    m_Localized: 'Alt: Und es wurde immer schlimmer.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862599
    m_Localized: 'Alt: Ich konnte es nicht mehr ertragen, ein Teil davon zu sein. Ich hatte die Nase voll.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862600
    m_Localized: 'Alt: Und fang gar nicht erst von den Nachrichten an. Ich saß nur da und habe mich gefragt, wie zum Teufel wir überhaupt noch am Leben sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862601
    m_Localized: 'Alt: Wie soll jemand vom Radio denn aussehen? Irgendein Schnösel mit Brille und Anzug?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862602
    m_Localized: 'Alt: Du bist in Klischees gefangen. Ich verstehe das. Aber das ist dein Problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862603
    m_Localized: 'Alt: Ich dachte früher, ich würde auch mit interessanten Besuchern plaudern ... Die Studiogäste meine ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862604
    m_Localized: 'Alt: Stattdessen habe ich eine düstere Meldung nach der anderen zusammengestellt. Es wurde immer schwieriger, dem Drang zu widerstehen, einfach alles zu beenden.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862605
    m_Localized: 'Alt: Und obendrein gibt es Idioten, die versuchen, buchstäblich Luft zu verkaufen und sich ständig reindrängen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862606
    m_Localized: 'Alt: Das Radio wurde zum Zirkus. Und ich durfte den Dompteur spielen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862607
    m_Localized: 'Alt: ... Es wird von Tag zu Tag schwerer.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862608
    m_Localized: Also hattest du die Schnauze voll von dem Scheiß und bist einfach gegangen?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862609
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862610
    m_Localized: Eine FEMA-Mitteilung geben
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862611
    m_Localized: 'Alt: Tja ... wenn wir hier das Resümee unseres kleinen Gesprächs ziehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862612
    m_Localized: 'Alt: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862613
    m_Localized: 'Alt: Weißt du, was mir den Rest gegeben hat? Es war eine Sendung mit noch so einem Spinner.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862614
    m_Localized: 'Alt: Man hat uns gesagt, ein „Experte“ würde live auf Sendung gehen, um über die Besucher zu sprechen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862615
    m_Localized: 'Alt: Er schwor, er hätte einen Weg gefunden, sie zu bekämpfen ... ich weiß nicht einmal mehr, was es war. Irgendein überteuertes Glas voller Unsinn.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862616
    m_Localized: 'Alt: Er hatte sogar für seinen Sendeplatz im Voraus bezahlt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862617
    m_Localized: 'Alt: Ich habe eine Woche lang über ihn recherchiert. Jede zwielichtige Sache, die er je getan hat, alles parat gelegt, um ihn auf Sendung zu zerreißen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862618
    m_Localized: 'Alt: Wäre eine verdammt gute Show geworden ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862619
    m_Localized: 'Alt: Aber dazu kam es nie. Und weißt du, warum?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862620
    m_Localized: 'Alt: Er ist abgesprungen, weil jemand seine verdammten Dokumente gestohlen hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862621
    m_Localized: 'Alt: Verdammte Kilotonnen an Daten!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862622
    m_Localized: 'Alt: Was für ein Idiot macht so was überhaupt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862623
    m_Localized: 'Alt: Mein ganzer Plan im Eimer. Die ganze Recherche umsonst. Danach hat er sich einfach nie wieder gemeldet.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862624
    m_Localized: 'Alt: Mistkerl.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862625
    m_Localized: 'Alt: ... Es wird von Tag zu Tag schwerer.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862626
    m_Localized: Also bist du mit dem Journalismus fertig?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862627
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862628
    m_Localized: Eine FEMA-Mitteilung geben
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862629
    m_Localized: 'Alt: Überleben ist der einzige Plan, der mir geblieben ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862630
    m_Localized: 'Alt: Ich habe versucht, mich in verschiedene Abteilungen zu schleichen, besonders als die Sonneneruptionen anfingen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862631
    m_Localized: 'Alt: Aber die Richtung ist klar. Von jetzt an geht es nur noch bergab.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862632
    m_Localized: 'Alt: Die Polizei hat uns früher tägliche Berichte aus der ganzen Stadt geschickt. Dadurch kamen die meisten unserer Nachrichtenblöcke zustande.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862633
    m_Localized: 'Alt: Dann kamen die Berichte zu spät.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862634
    m_Localized: 'Alt: Und mir ist aufgefallen, dass sie anders geschrieben waren. Wenn man jeden Tag dasselbe liest, spürt man die Veränderung.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862635
    m_Localized: 'Alt: Plötzlich wirkten sie ... seltsam.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862636
    m_Localized: 'Alt: Da habe ich beschlossen, dass ich mich besser von den Städten fernhalte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862637
    m_Localized: 'Alt: Besser irgendwo abseits bleiben. Ich habe sogar darüber nachgedacht, im Wald zu leben, aber das ist heutzutage keine gute Idee.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862638
    m_Localized: 'Alt: Das Leben ist einfach ... hart.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862639
    m_Localized: 'Tourist: Wenn ich doch nur von hier wegkäme.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862640
    m_Localized: Wohin wollten Sie denn?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862641
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862642
    m_Localized: Eine FEMA-Mitteilung geben
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862643
    m_Localized: 'Tourist: Was hat das jetzt noch für einen Sinn? Ich komme sowieso nie wieder nach Hause ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862644
    m_Localized: 'Tourist: Verdammte Sonne, scheiß drauf. Und scheiß auf diese ganze Besucher-Epidemie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862645
    m_Localized: 'Tourist: Ist das nur hier so? Oder überall?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862646
    m_Localized: 'Tourist: Ich habe diese Reise so lange geplant.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862647
    m_Localized: 'Tourist: Darauf gespart, um Urlaub gebettelt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862648
    m_Localized: 'Tourist: Und was bekomme ich dafür? Die Reise war zu Ende, bevor sie überhaupt begonnen hatte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862649
    m_Localized: 'Tourist: Wenn ich doch nur von hier wegkäme.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862650
    m_Localized: Warum sind Sie nicht früher aufgebrochen?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862651
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862652
    m_Localized: Eine FEMA-Mitteilung geben
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862653
    m_Localized: 'Tourist: Ich habe es doch gesagt, es kam immer etwas dazwischen. Eine Sache nach der anderen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862654
    m_Localized: 'Tourist: Außerdem dachte ich, jetzt wäre die perfekte Zeit zum Reisen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862655
    m_Localized: 'Tourist: Endlich etwas Sonne auf die Haut bekommen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862656
    m_Localized: 'Tourist: Hätte ich gewusst, dass es so kommen würde, wäre ich früher los. Ich hätte mir die Welt angesehen, solange ich noch konnte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862657
    m_Localized: 'Tourist: Jetzt werde ich sie nur noch auf Bildern sehen. All diese Länder, zum Teufel gegangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862658
    m_Localized: 'Tourist: Wenn ich doch nur von hier wegkäme.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862659
    m_Localized: Vielleicht hatten Sie ja Glück? Wenigstens werden Sie nicht bei lebendigem Leibe verbrennen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862660
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862661
    m_Localized: Eine FEMA-Mitteilung geben
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862662
    m_Localized: 'Tourist: Glück? Wollen Sie sich über mich lustig machen?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862663
    m_Localized: 'Tourist: Mein ganzes Leben lang wollte ich die Welt sehen, und jetzt weiß ich nicht einmal, ob ich überhaupt jemals wieder etwas sehen werde.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862664
    m_Localized: 'Tourist: Und das nennen Sie Glück? Was daran soll denn bitte Glück sein?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862665
    m_Localized: Sie leben, verdammt noch mal
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862666
    m_Localized: Mann, es ist doch nur eine Reise
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862667
    m_Localized: 'Tourist: Ja, ich lebe, vorerst ... Aber was kommt als Nächstes?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862668
    m_Localized: 'Tourist: Die Sonne wird explodieren, und das war es dann.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862669
    m_Localized: 'Tourist: Ich werde wohl sterben, ohne jemals die Welt gesehen zu haben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862670
    m_Localized: Das ist Ihre Entschuldigung für Ihre Selbstmitleidstour? Hören Sie auf, sich selbst zu bemitleiden
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862671
    m_Localized: Dieses Gejammer geht mir langsam echt verdammt auf die Nerven
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862672
    m_Localized: 'Tourist: Es war nicht nur eine Reise. Es war mein Traum.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862673
    m_Localized: 'Tourist: Mein ganzes Leben lang wollte ich die Welt sehen, und was jetzt?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862674
    m_Localized: 'Tourist: Damit ist es vorbei. Das wird nie passieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862675
    m_Localized: 'Tourist: Ich hätte vor dieser ganzen Sache losziehen sollen. Jetzt warten wir alle nur noch auf den Tod ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862676
    m_Localized: Das ist Ihre Entschuldigung für Ihre Selbstmitleidstour? Hören Sie auf, sich selbst zu bemitleiden
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862677
    m_Localized: Dieses Gejammer geht mir langsam echt verdammt auf die Nerven
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862678
    m_Localized: 'Tourist: Aber ich ... ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862679
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862680
    m_Localized: 'Tourist: Ich kann einfach nicht anders, als alles zu bereuen. Tut mir leid.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862681
    m_Localized: 'Tourist: Mir ist einfach klar geworden ... dass mich vorher eigentlich nichts davon abgehalten hat loszuziehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862682
    m_Localized: 'Tourist: Aber ich habe es immer wieder aufgeschoben und mir eingeredet, dass später noch Zeit dafür sein würde.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862683
    m_Localized: 'Tourist: Und jetzt ... ist es zu spät.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862684
    m_Localized: 'Tourist: Die Welt steht kurz vor dem Zusammenbruch, und es gibt noch so viel, was ich sehen ... was ich tun wollte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862685
    m_Localized: 'Tourist: Ich schätze, ich muss irgendwie lernen, damit zu leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862686
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862687
    m_Localized: 'Tourist: Ficken Sie sich!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862688
    m_Localized: 'Tourist: Was, darf ich nicht mal um das trauern, was ich verloren habe?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862689
    m_Localized: 'Tourist: Sie sehen es doch selbst: Nichts wird je wieder normal sein. Das Ende ist gekommen!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862690
    m_Localized: 'Tourist: Ich sehe es in Ihren Augen, Sie haben es bereits akzeptiert. Aber ich will nicht sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862691
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862692
    m_Localized: 'Tourist: Was rede ich da überhaupt ... Sie waren wahrscheinlich noch nie draußen. Ich wette, für Sie hat sich gar nichts geändert.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862693
    m_Localized: Sie fangen an, mir auf die Nerven zu gehen
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862694
    m_Localized: Vielleicht werfe ich Sie raus und sehe zu, wie die Sonne Ihre Augen in den Höhlen kocht
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862695
    m_Localized: 'Tourist: Was sind Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862696
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862697
    m_Localized: 'Tourist: Wissen Sie was? Ich glaube, ich gehe. Sie machen mir Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862698
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862699
    m_Localized: 'Tourist: Ich will nur sagen, dass Sie vielleicht akzeptieren können, was da kommt. Aber das gilt nicht für jeden.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862700
    m_Localized: 'Tourist: Ich für meinen Teil kann nicht aufhören, darüber nachzudenken, was als Nächstes passieren könnte. Es ist wirklich schwer.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862701
    m_Localized: 'Tourist: Ich denke ständig an all die verpassten Gelegenheiten, weil ich zu viel Angst hatte, einfach im Moment zu leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862702
    m_Localized: Versuchen Sie, sich an die guten Zeiten zu erinnern. Das macht es vielleicht einfacher
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862703
    m_Localized: Sie müssen aufhören, in Selbstmitleid zu versinken
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862704
    m_Localized: 'Tourist: Vielleicht haben Sie recht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862705
    m_Localized: 'Tourist: Es ist nur ... schwer, nicht in dieser „Hätte, wäre, wenn“-Schleife gefangen zu sein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862706
    m_Localized: 'Tourist: Aber Sie haben recht. Es hat keinen Sinn, sich zu wünschen, die Zeit zurückdrehen zu können.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862707
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862708
    m_Localized: 'Tourist: Danke fürs Zuhören.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862709
    m_Localized: 'Tourist: Ich weiß nicht, ob Sie es brauchen können, aber hier, nehmen Sie das: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602560
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602561
    m_Localized: 'Dude: Aaaalter, mir fällt grad ein, ich hab ja noch ’ne Spezialtüte übrig.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602562
    m_Localized: 'Dude: Ohhh Mann, das wird der HAMMER!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602563
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602564
    m_Localized: 'Dude: Mein Fehler, Alter ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602565
    m_Localized: 'Dude: Ich hab voll vergessen, ’nen Zug zu nehmen und weiterzugeben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602566
    m_Localized: 'Dude: Peace and Love, Mann ... Nimm ’ne normale Selbstgedrehte ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602567
    m_Localized: 'Dude: Ich werd jetzt einfach, äh, ’n bisschen chillaxen ... Jaaaa ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602568
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602569
    m_Localized: 'Wheelchair: Verdammt, ich muss mich kurz ausstrecken ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602570
    m_Localized: 'Wheelchair: Moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602571
    m_Localized: 'Wheelchair: Puh, schon viel besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602572
    m_Localized: Was zur Hölle?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602573
    m_Localized: 'Wheelchair: Entspann dich, Mann, hab nur ein eingeschlafenes Bein. Was ist schon dabei?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602574
    m_Localized: Was zum Teufel sollte die ganze Show?!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602575
    m_Localized: Warum zum Teufel sitzt du in dem verdammten Rollstuhl?!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602576
    m_Localized: 'Wheelchair: Ich hab nie behauptet, dass ich nicht laufen kann ... Meine Beine bleiben so einfach wärmer.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602577
    m_Localized: 'Wheelchair: Äh ... Es macht mir einfach Spaß, damit herumzurollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602578
    m_Localized: Du bist ein Freak
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602579
    m_Localized: Verpiss dich von hier. SOFORT
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602580
    m_Localized: 'Wheelchair: Ach, komm schon, mit dem Ding kann man doch echt coole Drifts hinlegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602581
    m_Localized: 'Wheelchair: Sag mir nicht, du hast das noch nie ausprobiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602582
    m_Localized: Du bist ein Freak
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602583
    m_Localized: Verpiss dich von hier. SOFORT
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602584
    m_Localized: 'Wheelchair: Ach, egal.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602585
    m_Localized: 'Wheelchair: Wenigstens habe ich einen Mordsspaß!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602586
    m_Localized: 'Wheelchair: Was zum Teufel?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602587
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602588
    m_Localized: 'Wheelchair: Okay, ich bin raus. Aber den Stuhl nehme ich mit.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602589
    m_Localized: '>>'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602590
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602591
    m_Localized: 'Esenin: Ich habe hier einige Gedichtbände gefunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602592
    m_Localized: 'Esenin: Dürfte ich dir was daraus vorlesen, mein Guter?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602593
    m_Localized: Gerne
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602594
    m_Localized: Nein, danke
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602595
    m_Localized: 'Esenin: So. Das war’s. Was meinst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602596
    m_Localized: Wunderschön
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602597
    m_Localized: Es sind nur Worte
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602598
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602599
    m_Localized: 'Esenin: Ich fühle mich jetzt tatsächlich etwas besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602600
    m_Localized: 'Esenin: Danke fürs Zuhören, mein Guter.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602601
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602602
    m_Localized: 'Esenin: Nun gut, wie du meinst.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602603
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602604
    m_Localized: 'FortuneTeller: Ich glaube, ich kenne genau das Richtige, um Ihre Energie zu verlagern.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602605
    m_Localized: 'FortuneTeller: Sie müssen nur ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602606
    m_Localized: 'FortuneTeller: DIE WELLENBEWEGUNGEN DES STEINBOCKS AUSFÜHREN!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602607
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602608
    m_Localized: 'Fortuneteller: Und? Hat es funktioniert? Spüren Sie schon die Freude durch Ihre Chakren fließen?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602609
    m_Localized: Sollte ich?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602610
    m_Localized: Was zur Hölle?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602611
    m_Localized: 'Fortuneteller: Was, es hat nicht funktioniert?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602612
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602613
    m_Localized: 'Fortuneteller: Seltsam. Hätte es eigentlich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602614
    m_Localized: 'Fortuneteller: Nun ja, geben Sie der Verzweiflung nicht nach. Tägliche Bekräftigungen werden Ihnen noch helfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602615
    m_Localized: 'Fortuneteller: Genau genommen ... Sollten wir das gleich in die Tat umsetzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602616
    m_Localized: 'Fortuneteller: Sprechen Sie mir nach: Ich bin ein glücklicher Mensch!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602617
    m_Localized: Ich bin ein glücklicher Mensch!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602618
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602619
    m_Localized: Das ist doch Schwachsinn
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602620
    m_Localized: 'Fortuneteller: Sehr gut! Machen Sie weiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602621
    m_Localized: Ich bin ein glücklicher Mensch!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602622
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602623
    m_Localized: Das ist doch Schwachsinn
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602624
    m_Localized: 'Fortuneteller: Sie geben sich ja nicht mal Mühe!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602625
    m_Localized: 'Fortuneteller: Augenblick ... Wie konnte ich das nur übersehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602626
    m_Localized: 'Fortuneteller: Ich sehe es in Ihrer Aura ... Sie wollen kein Glück. In Ihnen ist nichts als Leere.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602627
    m_Localized: 'Fortuneteller: Und ohne Wunsch kann es kein Ergebnis geben. Das Universum wird es einfach nicht manifestieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602628
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602629
    m_Localized: 'Fortuneteller: Ich fürchte, Ihnen ist nicht zu helfen. Tut mir leid. Selbst die Bekräftigungen konnten Sie nicht erreichen.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602630
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602631
    m_Localized: Was machst du da?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602632
    m_Localized: 'Intruder: Ich suche nach deinen Träumen.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602633
    m_Localized: 'Intruder: Ich will ein wenig Frieden finden. Nur ein kleines bisschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602634
    m_Localized: 'Intruder: Wo versteckst du sie? Sag es mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602635
    m_Localized: Verpiss dich, sonst hau ich dich um
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602636
    m_Localized: Ich habe keine Träume
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602637
    m_Localized: Geh mir aus den Augen
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602638
    m_Localized: 'Intruder: Du musst das verstehen. Ich BRAUCHE Träume.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602639
    m_Localized: 'Intruder: Obwohl ich es bereits in deinen Augen gesehen habe – du hast keine.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602640
    m_Localized: 'Intruder: Du kannst dich jetzt entspannen.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602641
    m_Localized: 'Intruder: Also ... Sage ich dir die Wahrheit? Oder will ich nur, dass du deine Deckung fallen lässt ...?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602642
    m_Localized: 'Intruder: Einen ruhelosen Albtraum habe ich allerdings gefunden ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796864
    m_Localized: 'Intruder: Du kriechst einen Gang entlang ... eine dreckige Nacktschnecke.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796865
    m_Localized: 'Intruder: Du hast keine Ahnung, durch wessen Augen du blickst.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796866
    m_Localized: 'Intruder: So viel sei gesagt: Es ist ein Blick, der nach Leichen sucht. Er wird von Orten des Todes angezogen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796867
    m_Localized: 'Intruder: Vielleicht siehst du es eines Tages ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796868
    m_Localized: 'Intruder: Einen seltsamen Albtraum habe ich allerdings gefunden ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796869
    m_Localized: 'Intruder: Du kriechst durch einen Tunnel, in dem ständig Pilze sprießen.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796870
    m_Localized: 'Intruder: Es sind viel zu viele und sie wachsen in einem erschreckenden Tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796871
    m_Localized: 'Intruder: Seltsam. Warum solltest du so eine Vision haben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821952
    m_Localized: 'Esenin: Wenn sich der Abend über den Himmel ausbreitet'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821953
    m_Localized: 'Esenin: Wie ein Patient, der betäubt auf einem Tische liegt;'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821954
    m_Localized: 'Esenin: Lasst uns schreiten, durch jene halb verlassenen Straßen,'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821955
    m_Localized: 'Esenin: Die raunenden Rückzugsorte'
    m_Metadata:
      m_Items: []
  - m_Id: 74175582101823488
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 74175582101823489
    m_Localized: Eine FEMA-Mitteilung geben
    m_Metadata:
      m_Items: []
