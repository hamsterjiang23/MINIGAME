%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DayDialogs_de
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 48f2181e494cb864ca5ca7074da486ff, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22080585977856
    m_Localized: 'Firefighter: Es ist so verdammt heiß ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560768
    m_Localized: Wie fühlen Sie sich?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560769
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560770
    m_Localized: 'Firefighter: Es scheint noch schlimmer zu sein, als ich dachte. *hust* Verdammt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560771
    m_Localized: 'Firefighter: Ich glaube kaum, dass ich noch länger als eine Woche durchhalte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560772
    m_Localized: 'Firefighter: Obwohl es mir ein bisschen besser ging, als Sie mich reingelassen haben. Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560773
    m_Localized: 'Firefighter: Aber ... jetzt sitze ich hier, während meine Kameraden sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560774
    m_Localized: 'Firefighter: Ich hätte bei ihnen sein können. Ich habe sowieso nichts zu verlieren. Sterben werde ich so oder so ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560775
    m_Localized: 'Firefighter: Es ist so verdammt heiß ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560776
    m_Localized: Warum sind Sie nicht nach Hause gegangen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560777
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560778
    m_Localized: 'Firefighter: Ich habe Kinder zu Hause. Und ich ... *hust*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560779
    m_Localized: 'Firefighter: Ich will nicht, dass sie Angst vor mir haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560780
    m_Localized: 'Firefighter: Und ich *hust* will nicht, dass sie mich so in Erinnerung behalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560781
    m_Localized: 'Firefighter: Sie sollen lieber denken, dass ich im Wald gestorben bin, als ich ... *hust, hust*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560782
    m_Localized: 'Firefighter: Als ich Brände gelöscht habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560783
    m_Localized: 'Firefighter: *hust* Sie sollen sich an meine Geduld und meine gewissenhafte Arbeit erinnern.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560784
    m_Localized: 'Firefighter: Es ist so verdammt heiß ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560785
    m_Localized: Wo ist Ihre Uniform?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560786
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560787
    m_Localized: 'Firefighter: Die Chefs haben sie mir abgenommen. *hust* Wir haben nicht mehr genug Ausrüstung.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560788
    m_Localized: 'Firefighter: Viele *hust* sterben im Dienst.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560789
    m_Localized: 'Firefighter: Wir haben einfach keine Zeit, unsere Kollegen zu bergen. Ihre Leichen *hust* verkohlen im Feuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560790
    m_Localized: 'Firefighter: Und die Chefs ... Denen ist *hust* eine verdammte Uniform wichtiger ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560791
    m_Localized: 'Firefighter: Wie Hufschläge erlassen sie Befehl auf Befehl. Und für die Leute tun sie nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560792
    m_Localized: 'Firefighter: Es ist so verdammt heiß ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560793
    m_Localized: Wie ist es zu den Waldbränden gekommen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560794
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560795
    m_Localized: 'Firefighter: Der Wald ist in letzter Zeit extrem trocken. Also *hust* geraten sie leicht in Brand.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560796
    m_Localized: 'Firefighter: Die Feuer sind nicht das einzige Unglück, das uns ereilt hat. Dazu kommen noch diese Besucher aus dem Untergrund.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560797
    m_Localized: 'Firefighter: Aber das Schicksal hält noch mehr für uns bereit ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560798
    m_Localized: 'Firefighter: In dieser hoffnungslosen Situation ist ein baldiger friedlicher Tod vielleicht das Beste, worauf man hoffen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560799
    m_Localized: 'Firefighter: Wissen Sie was? *hust* Ich wollte ein Geschenk nach Hause bringen. Aber stattdessen gebe ich es Ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560800
    m_Localized: 'Firefighter: Diese Kette hier, trocken und unansehnlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560801
    m_Localized: 'Firefighter: Sie ist aus toten Bienen gemacht, die Honig zu Sonne wandeln.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560802
    m_Localized: 'Firefighter: Es ist so verdammt heiß ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560803
    m_Localized: Sie sehen schlimm aus
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560804
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560805
    m_Localized: 'Firefighter: Ich glaube ... Ich glaube, meine Zeit ist gekommen ... *hust, hust*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560806
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560807
    m_Localized: 'Firefighter: Warum bin ich nicht dortgeblieben? Ich hätte ein paar Kameraden retten können.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560808
    m_Localized: 'Firefighter: Ich hätte bleiben können ... und bis zum Umfallen arbeiten. Dann hätten sie nicht die Jungen in den Tod schicken müssen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560809
    m_Localized: 'Firefighter: VERDAMMTE CHEFS! *HUST, HUST*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560810
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560811
    m_Localized: 'Firefighter: Das ist alles so ... traurig.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560812
    m_Localized: 'Firefighter: Können Sie mir eine letzte Zigarette geben?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560813
    m_Localized: 'Hier, bitte (Zigarette geben) '
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560814
    m_Localized: 'Firefighter: Sie haben nicht zufällig eine Zigarette?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560815
    m_Localized: Nein, tut mir leid (keine Zigarette geben)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560816
    m_Localized: 'Firefighter: Der letzte Sargnagel, wie man so schön sagt. *hust*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560817
    m_Localized: 'Firefighter: (Der Mann holt ein Feuerzeug aus seiner Tasche, zündet die Zigarette an und raucht.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560818
    m_Localized: 'Firefighter: (Er nimmt einen langen Zug und lehnt sich an die Wand. Nach einer kurzen Pause spricht er weiter.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560819
    m_Localized: 'Firefighter: Wenn ich doch nur bei meinen Kameraden sein könnte. Zusammen rauchen, uns unterhalten ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560820
    m_Localized: 'Firefighter: *HUST, HUST*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560821
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560822
    m_Localized: 'Firefighter: Sie rauchen nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560823
    m_Localized: 'Firefighter: Ich weiß, als Feuerwehrmann sollte ich nicht rauchen. *hust*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560824
    m_Localized: 'Firefighter: Aber jetzt ist sowieso alles egal.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560825
    m_Localized: 'Firefighter: Ich will mich nur noch ein bisschen *hust* entspannen, bevor ich sterbe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560826
    m_Localized: 'Firefighter: (Der Mann lehnt sich an die Wand und starrt beim Sprechen an die Decke.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560827
    m_Localized: 'Firefighter: Warum bin ich überhaupt Feuerwehrmann geworden? Meine Mutter hat gesagt, ich soll in einer Fabrik arbeiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560828
    m_Localized: 'Firefighter: Ein Feuerwehrmann sollte nicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560829
    m_Localized: 'Firefighter: *HUST, HUST*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560830
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560831
    m_Localized: 'WheelChair: Wäre ich frei, endlich dabei ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560832
    m_Localized: Wen suchen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560833
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560834
    m_Localized: 'WheelChair: Meinen Freund. Wir kennen uns seit unserer Kindheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560835
    m_Localized: 'WheelChair: Er hatte einen Unfall.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560836
    m_Localized: 'WheelChair: Er wurde angeheuert, um in den Bergen irgendwas abzubauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560837
    m_Localized: 'WheelChair: Ich weiß es selbst nicht genau. Und es interessiert mich auch einen feuchten Dreck.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755072
    m_Localized: 'WheelChair: ABER DANN HAT ER SICH DEN RÜCKEN AUSGERENKT.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755073
    m_Localized: 'WheelChair: Er hat in den Bergen so hart geschuftet ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755074
    m_Localized: 'WheelChair: Die Möwen haben seinen ... Rücken ... äh ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755075
    m_Localized: 'WheelChair: Na schön, es war sein Arsch. Sie haben seinen Arsch mit einem Nest verwechselt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755076
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755077
    m_Localized: 'WheelChair: HAHAHAHA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755078
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755079
    m_Localized: 'WheelChair: Tut mir leid, das sind nur die Stimmen in meinem Kopf.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755080
    m_Localized: 'WheelChair: Die haben den Witz viel lustiger erzählt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755081
    m_Localized: 'WheelChair: Wäre ich frei, endlich dabei ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755082
    m_Localized: Äh ... Alles in Ordnung?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755083
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755084
    m_Localized: 'WheelChair: Alles bestens. Ich warte nur noch darauf, dass meine Beine nachwachsen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755085
    m_Localized: 'WheelChair: Sehen Sie, das rechte hat schon angefangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755086
    m_Localized: 'WheelChair: Also bleibe ich noch eine Weile hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755087
    m_Localized: Ich meinte die Stimmen in Ihrem Kopf
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755088
    m_Localized: Wie Sie meinen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755089
    m_Localized: 'WheelChair: Haben Sie mich nicht verstanden? Das war ein Witz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755090
    m_Localized: 'WheelChair: Ich dachte, sie würden es sofort kapieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755091
    m_Localized: 'WheelChair: War wohl nicht Ihr Humor.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755092
    m_Localized: 'WheelChair: Haben Sie mich gerade gefragt, wie es mir geht?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755093
    m_Localized: 'WheelChair: Danke, sehr nett von Ihnen!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755094
    m_Localized: 'WheelChair: Normalerweise fragt mich niemand, wie es mir geht oder wie mein Tag war.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755095
    m_Localized: 'WheelChair: Nur, weil ich statt Beinen Räder habe wie ein RENNFAHRER?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755096
    m_Localized: 'WheelChair: Keiner antwortet ehrlich darauf. Das ist das Problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755097
    m_Localized: 'WheelChair: Alle reden sich immer nur raus, dass sie nur kurz meine Beine sehen wollten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755098
    m_Localized: 'WheelChair: Wenn sie nur starren, ist es genauso schlimm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755099
    m_Localized: 'WheelChair: Aber es ist einfach nur albern, meine Behinderung zu ignorieren. Sie ist schließlich da.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755100
    m_Localized: 'WheelChair: Es sollte einen gesunden Mittelweg geben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755101
    m_Localized: 'WheelChair: Aber in der verdammten Stadt gibt es keinen gesunden Mittelweg.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755102
    m_Localized: 'WheelChair: Haben Sie sich jemals vorgestellt, wie Sie mit Rädern laufen würden?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755103
    m_Localized: 'WheelChair: Scheiße, das habe ich gar nicht gemeint ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755104
    m_Localized: 'WheelChair: Wenn Sie keine Beine hätten, wollte ich sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755105
    m_Localized: 'WheelChair: GANZ GENAU. Sie können nicht einmal Ihr Haus verlassen!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755106
    m_Localized: 'WheelChair: Wie würden Sie die Treppe benutzen? Oder die Straße überqueren?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755107
    m_Localized: 'WheelChair: Die verdammten Bordsteine sind alle schief.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755108
    m_Localized: 'WheelChair: Ihr Haus hat keine Treppen oder Türschwellen, also kann ich mich frei bewegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755109
    m_Localized: 'WheelChair: Nur eines würde ich mir noch wünschen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755110
    m_Localized: 'WheelChair: Dass Ihr Haus ein Gefälle hätte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755111
    m_Localized: 'WheelChair: Es wäre ein Riesenspaß, im Rollstuhl durchzurauschen und in die Wände zu krachen. Aber das ist Meckern auf hohem Niveau.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755112
    m_Localized: 'WheelChair: Ach, ich liebe es, Rennen zu fahren. Aber hier geht das nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755113
    m_Localized: 'WheelChair: Oh, Sie haben mich ja gefragt, wie es mir geht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755114
    m_Localized: 'WheelChair: Nicht schlecht. Danke der Nachfrage.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755115
    m_Localized: 'WheelChair: Wäre ich frei, endlich dabei ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755116
    m_Localized: Haben Sie einen Sonnenstich?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755117
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755118
    m_Localized: 'WheelChair: Wie kommen Sie darauf?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755119
    m_Localized: 'WheelChair: Meine Haare sind weder verbrannt noch ausgefallen. Alles im grünen Bereich.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755120
    m_Localized: 'WheelChair: Ohne Beine kann ich im Rollstuhl keine Rennen fahren. Verstehen Sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755121
    m_Localized: 'WheelChair: Wie soll ich ohne Beine bei hohem Tempo abbremsen? Oder eine Kurve nehmen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755122
    m_Localized: 'WheelChair: Aber Sie haben keinen Rollstuhl, woher sollten Sie das also wissen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755123
    m_Localized: Glauben Sie das wirklich?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755124
    m_Localized: Warum glauben Sie, dass Ihre Beine nachwachsen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755125
    m_Localized: 'WheelChair: Natürlich!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755126
    m_Localized: 'WheelChair: Sie haben sicher schon davon gehört.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755127
    m_Localized: 'WheelChair: Das rechte Bein macht größere Schritte. Deshalb laufen wir immer nur im Kreis.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755128
    m_Localized: 'WheelChair: Sehen Sie, mein Bein ist der beste Beweis.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755129
    m_Localized: 'WheelChair: Es ist alles dasselbe und es gibt keinen Ausweg aus dem Kreislauf.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755130
    m_Localized: 'WheelChair: Der heutige Tag geht zu Ende und morgen fängt ein neuer an. Aber wird es wirklich ein neuer Tag?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755131
    m_Localized: 'WheelChair: Verdammt. Alles ist gleich. Ich lebe in einem Teufelskreis.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755132
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755133
    m_Localized: 'WheelChair: Wenn man so darüber nachdenkt, gibt es überhaupt irgendeinen Unterschied zwischen Ihnen und mir?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755134
    m_Localized: 'WheelChair: Laufen Sie nicht auch im Kreis?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755135
    m_Localized: 'WheelChair: Wir leben in einer Welt der Wunder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755136
    m_Localized: 'WheelChair: Bisher nur grässliche Wunder. ABER!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755137
    m_Localized: 'WheelChair: Irgendwann hören die grässlichen Wunder auf. Und dann gibt es gute, erfreuliche Wunder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755138
    m_Localized: 'WheelChair: Gott hat schon vielen Gläubigen vergeben. Vielleicht erwartet uns noch etwas viel Besseres.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755139
    m_Localized: 'WheelChair: Wäre ich frei, endlich dabei ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755140
    m_Localized: Wie haben Sie Ihre Beine verloren?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755141
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755142
    m_Localized: 'WheelChair: Erinnern Sie sich an meinen Freund in den Bergen, von dem ich Ihnen erzählt habe?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755143
    m_Localized: 'WheelChair: Er hat sich in den Kopf gesetzt, in seinem Garten einen Graben auszuheben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755144
    m_Localized: 'WheelChair: Er hat sich eingebildet, dass unter seinem Haus ein Tunnel voller Fleisch verläuft.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755145
    m_Localized: 'WheelChair: Also hat er eine Bohrmaschine oder so was in der Art bestellt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755146
    m_Localized: 'WheelChair: Und dann hat er angefangen zu graben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755147
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755148
    m_Localized: 'WheelChair: Verdammt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755149
    m_Localized: 'WheelChair: Das war wahrscheinlich das letzte Mal, dass ich ihn gesehen habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755150
    m_Localized: 'WheelChair: Wäre ich frei, endlich dabei ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755151
    m_Localized: Was ist mit Ihren Beinen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755152
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755153
    m_Localized: 'WheelChair: Scheiß auf meine Beine. Ich will wissen, ob er bis zu dem Tunnel gegraben hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755154
    m_Localized: Na gut, vergessen Sie’s.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755155
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755156
    m_Localized: 'WheelChair: Ja, das ist es. Ich wollte mir danach ein Bier genehmigen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755157
    m_Localized: 'WheelChair: Ich bin hingefallen und ein Transportkarren ist mir über die Beine gefahren.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755158
    m_Localized: 'WheelChair: Oder warten Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755159
    m_Localized: 'WheelChair: Nein, so war das gar nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755160
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755161
    m_Localized: 'WheelChair: Warum sagen Sie denn nichts? Haben Sie kein Interesse mehr?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755162
    m_Localized: 'WheelChair: Ich erzähle Ihnen gar nichts mehr. Warum sollte ich?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755163
    m_Localized: 'Mother: Hier drinnen ist es ziemlich stickig ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755164
    m_Localized: Hattest du nicht ein Kind dabei?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755165
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755166
    m_Localized: 'Mother: Oh, er ist immer noch bei mir. Wahrscheinlich ist er nur kurz ausgebüxt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755167
    m_Localized: 'Mother: Ich muss wissen, wo die anderen sind. Und ob es ihnen gut geht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755168
    m_Localized: 'Mother: Haben Sie ein Telefon? Dann kann ich ihren Vater anrufen, damit ich seine hässliche Visage nicht sehen muss.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755169
    m_Localized: 'Mother: Hier drinnen ist es ziemlich stickig ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755170
    m_Localized: Und? Hast du deinen Mann angerufen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755171
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755172
    m_Localized: 'Mother: Wozu? Er würde nur so tun, als würde ihn das alles nichts angehen. Zu Hause hat er nie einen Finger krumm gemacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755173
    m_Localized: 'Mother: Manchmal denke ich, dass er mich nur widerwillig ertragen hat, und ich ihn auch. Aber verlassen hat er mich nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755174
    m_Localized: 'Mother: Vielleicht, weil ich praktisch für ihn war. Oder weil er Angst hatte, dass ich ihn finden würde.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755175
    m_Localized: 'Mother: Gott, bin ich müde ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755176
    m_Localized: 'Mother: Hier drinnen ist es ziemlich stickig ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755177
    m_Localized: Warst du bei deinem Mann?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755178
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755179
    m_Localized: 'Mother: Wie bitte? Ich kann kaum das Bett verlassen. Mir tut alles weh. Wahrscheinlich bin ich nur noch aus Trotz am Leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755180
    m_Localized: 'Mother: Um alles musste ich mich kümmern: um die Kinder, um meinen Mann, ums ganze Haus. Aber manchmal hat er sich auch bemüht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755181
    m_Localized: 'Mother: Reden wir später. Ich habe keine Kraft mehr und muss mich ausruhen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755182
    m_Localized: 'Mother: Hier drinnen ist es ziemlich stickig ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755183
    m_Localized: Inwiefern hat er sich bemüht?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755184
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755185
    m_Localized: 'Mother: Da war diese eine Geschichte ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755186
    m_Localized: 'Mother: Es ging um eine andere Frau. Ich wusste Bescheid. Erst habe ich es geduldet, aber dann habe ich ihn zur Rede gestellt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755187
    m_Localized: 'Mother: Am Ende hat er den Job gewechselt, damit er sie nicht mehr sieht. Er scheint mich wirklich geliebt zu haben, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755188
    m_Localized: 'Mother: Vielleicht habe ich mir das alles auch nur eingebildet. Egal, ich muss mich ausruhen. Wir reden später weiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755189
    m_Localized: 'Mother: Hier drinnen ist es ziemlich stickig ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755190
    m_Localized: Hast du keine Angst um deine Kinder?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755191
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755192
    m_Localized: 'Mother: Doch ... Aber weniger, als ich sollte. Beim ersten Kind habe ich alles falsch gemacht. Ich hatte ja keine Ahnung.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755193
    m_Localized: 'Mother: Beim zweiten wollte ich alles anders machen, aber das Ergebnis war dasselbe. Dann kam das dritte, dann das vierte ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755194
    m_Localized: 'Mother: Die Ärzte haben gesagt, ich kann keine Kinder kriegen. Als das zweite kam, habe ich es „das Achte Weltwunder“ genannt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755195
    m_Localized: 'Mother: Aber dann ... wurde es ... so furchtbar ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755196
    m_Localized: 'Mother: Ich ... Ich muss mich ausruhen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755197
    m_Localized: 'Mother: Hier drinnen ist es ziemlich stickig ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755198
    m_Localized: Was war so furchtbar?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755199
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755200
    m_Localized: 'Mother: Es ist schwer für mich, darüber zu reden ... Ich liebe meine Kinder, aber ... manchmal ist mir die Hand ausgerutscht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755201
    m_Localized: 'Mother: Ich weiß, wie schlimm das ist. Es tut mir so leid ... Aber zum ersten Mal fühlt sich alles so einfach an.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755202
    m_Localized: 'Mother: Ohne sie kann ich endlich wieder durchatmen ... Ich sage es nicht gerne, aber das ist ein gutes Gefühl.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755203
    m_Localized: 'Anger: Verdammte Scheiße ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755204
    m_Localized: Haben Sie sich beruhigt?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755205
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755206
    m_Localized: 'Anger: Ja, ich beruhige mich immer schnell. Aber sobald mich irgendwas stört, verliere ich wieder die Beherrschung.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755207
    m_Localized: 'Anger: Früher war ich entspannter. Es war gar nicht so einfach, mich zu provozieren oder aus der Ruhe zu bringen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755208
    m_Localized: 'Anger: Inzwischen reicht ein kleiner Funken und die Hölle bricht los.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755209
    m_Localized: 'Anger: Warum sollte ich mich auch beherrschen? Vielleicht hilft mir meine Wut, bei Verstand zu bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755210
    m_Localized: 'Anger: Wenigstens huldige ich nicht der Sonne wie irgend so ein Vollpfosten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755211
    m_Localized: 'Anger: Wie kommt man nur darauf, dass die Sonne uns rettet? Sie bringt uns alle um, verdammt noch mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755212
    m_Localized: 'Anger: Wir sind kurz davor, ins Jenseits befördert zu werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755213
    m_Localized: 'Anger: Aber erzählen Sie das mal diesen Hirnis! ... Alles gut, ich bin ganz ruhig. Ich bin schon fertig.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755214
    m_Localized: 'Anger: Danke fürs Zuhören.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755215
    m_Localized: 'Anger: Verdammte Scheiße ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755216
    m_Localized: Woher kommt diese ganze Wut?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755217
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755218
    m_Localized: 'Anger: Ich weiß es selbst nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755219
    m_Localized: 'Anger: Mir geht einfach alles auf den Sack.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755220
    m_Localized: 'Anger: Zum Beispiel diese Sekten-Heinis. Verdammte Lügenbande! Immer mehr Leute wollen die hinters Licht führen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755221
    m_Localized: 'Anger: Und die Leute glauben ihnen auch noch.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755222
    m_Localized: 'Anger: Diese Schwachköpfe würden für die Sekte ihre eigenen Kinder opfern.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755223
    m_Localized: 'Anger: Alles nur, um ihren beschissenen Erlöser aus der Unterwelt zufriedenzustellen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755224
    m_Localized: 'Anger: Durchgeknallte Vollidioten. Sogar ganz normale Leute blenden sie mit ihren Wahnvorstellungen ... So wie meine ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755225
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755226
    m_Localized: 'Anger: Egal, ich bin schon wieder ruhig. Mir geht’s jetzt besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755227
    m_Localized: 'Anger: Verdammte Scheiße ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755228
    m_Localized: Hat die Sekte Ihnen jemanden genommen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755229
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755230
    m_Localized: 'Anger: Eben nicht. Sie ist selbst zu ihnen gegangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755231
    m_Localized: 'Anger: Meine Frau ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755232
    m_Localized: 'Anger: Vor dieser ganzen Scheiße war sie tief religiös.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755233
    m_Localized: 'Anger: Aber ich habe sie geliebt und meinen Frieden damit gemacht. Es hat unsere Ehe nie belastet.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755234
    m_Localized: 'Anger: Als dann dieser ganze Mist losging, hat sie sich einen neuen Erlöser gesucht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755235
    m_Localized: 'Anger: Das Gequatsche dieser verdammten Sektierer hat sie wohl überzeugt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755236
    m_Localized: 'Anger: Sie wurde jeden Tag verrückter und hat die absurdesten Dinge geglaubt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755237
    m_Localized: 'Anger: Als mir klar wurde, was ich getan hatte, war sie schon voller Angst davongelaufen. Es war zu spät ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755238
    m_Localized: 'Anger: Verdammte Scheiße ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755239
    m_Localized: Was ist zwischen Ihnen und Ihrer Frau passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755240
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755241
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755242
    m_Localized: 'Anger: Eines Tages hat meine Frau mir erzählt, dass sie der Sekte beitritt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755243
    m_Localized: 'Anger: Ich ... Ich konnte das einfach nicht glauben. Die Frau, die ich geliebt habe ... Sie war eine komplett andere Person.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755244
    m_Localized: 'Anger: Unsere Liebe hat ihr nichts mehr bedeutet. Ich war so wütend wie nie zuvor in meinem Leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755245
    m_Localized: 'Anger: Ich dachte, sie hätte mich nie geliebt und nur einen Vorwand gesucht, mich zu verlassen. Das hat mich ganz irre gemacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755246
    m_Localized: 'Anger: Meine Hände haben sich wie von selbst zu Fäusten geballt. Was dann passiert ist, werde ich mir nie verzeihen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755247
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755248
    m_Localized: 'Anger: Ich habe sie geschlagen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755249
    m_Localized: 'Anger: Es gibt keine Möglichkeit, das jemals wiedergutzumachen. Sie ist in der Sekte, und ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755250
    m_Localized: 'Anger: Ich kann niemals meinen Frieden damit machen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755251
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755252
    m_Localized: 'Anger: VERDAMMT, WIE ICH MICH HASSE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755253
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755254
    m_Localized: 'Anger: Ich sollte mir lieber selbst Schmerzen zufügen als den Leuten um mich herum. Ich verdiene es nicht anders.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755255
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755256
    m_Localized: 'Anger: Gehen Sie. Ich will allein sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755257
    m_Localized: 'FortuneTeller: Soll ich in dir lesen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755258
    m_Localized: Warum weißt du so viel über mich?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755259
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755260
    m_Localized: 'FortuneTeller: Ha! Du bist lustig ... Ich weiß gar nichts. Es sind die Sterne, die durch mich sprechen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755261
    m_Localized: 'FortuneTeller: Der Mond steht in der Venus in deinem sechsten Haus. Das steht dir ins Gesicht geschrieben. Wenn auch subtil ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755262
    m_Localized: 'FortuneTeller: Ich kannte mal jemanden wie dich. Er hat immer zugehört, aber nie den Mund aufgemacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755263
    m_Localized: 'FortuneTeller: Wie heißt es so schön: Wenn der Jupiter im achten Haus steht, schweigt man lieber. Das steht für verschlossene Türen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755264
    m_Localized: 'FortuneTeller: Soll ich in dir lesen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755265
    m_Localized: Was ist aus dieser Person geworden?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755266
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755267
    m_Localized: 'FortuneTeller: Ich sagte ihm: „Es ist egal, was du tust. Wichtig ist, was deine Aura dabei macht.“ Er zweifelte an meinen Worten'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755268
    m_Localized: 'FortuneTeller: Und so zog das Leben an ihm vorbei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755269
    m_Localized: 'FortuneTeller: Aber eines Tages schloss ich die Augen und gab mich einem Traum hin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755270
    m_Localized: 'FortuneTeller: Ich steckte all meine Energie in dieses Bild.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755271
    m_Localized: 'FortuneTeller: Wenn man sein Herz der Energie verschließt, warum sollte man dann überhaupt in diesem Körper leben?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755272
    m_Localized: 'FortuneTeller: Du könntest dasselbe tun. Schließe die Augen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755273
    m_Localized: 'FortuneTeller: Stell dir vor, du hättest dein Ziel schon erreicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755274
    m_Localized: 'FortuneTeller: Konzentriere dich darauf ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755275
    m_Localized: 'FortuneTeller: Weißt du, warum du leidest? Weil du noch nicht verstehst, dass Leid die höchste Form des Glücks ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755276
    m_Localized: 'FortuneTeller: Bist du bereit, diesen Schritt zu gehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755277
    m_Localized: 'FortuneTeller: Soll ich in dir lesen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755278
    m_Localized: Was heißt „bereit“?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755279
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755280
    m_Localized: 'FortuneTeller: Es heißt, sich selbst anzunehmen. Riechst du das? Das sind deine unerfüllten Wünsche. Lass sie raus.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755281
    m_Localized: 'FortuneTeller: Als ich ganz unten war, ohne Licht und ohne Sinn, sagte meine Mentorin zu mir: „Du hörst nicht auf das Meer.“'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755282
    m_Localized: 'FortuneTeller: Erst musste ich lachen. Das Meer?! Aber dann schloss ich die Augen und hörte es. Als wäre es schon immer da gewesen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755283
    m_Localized: 'FortuneTeller: Du kannst das auch. Aber du musst dich fragen, ob du bereit bist, eins mit dir selbst zu werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755284
    m_Localized: 'FortuneTeller: Soll ich in dir lesen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755285
    m_Localized: Wer war deine Mentorin?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755286
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755287
    m_Localized: 'FortuneTeller: Eine wunderbare Frau. Sie war wie ein Leuchtturm in einem Sturm. Sie brachte mir bei, das Wesen der Dinge zu erkennen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755288
    m_Localized: 'FortuneTeller: Ich werde nie ihre Worte vergessen: „Menschen sterben nur, weil sie nicht lernen, ihr inneres Licht zu atmen.“'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755289
    m_Localized: 'FortuneTeller: Dank ihr verstand ich, dass ich den Menschen helfen kann, ihren eigenen Weg zu finden.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755290
    m_Localized: 'FortuneTeller: Aber sie hatte Angst, den Weg zu Ende zu gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755291
    m_Localized: 'FortuneTeller: Sie sah sich nicht selbst im Zentrum. Dabei ist es unglaublich wichtig, im Zentrum zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755292
    m_Localized: 'FortuneTeller: Wenn man nicht das Zentrum des Universums ist, wer ist man dann? Du verstehst mich, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755293
    m_Localized: 'FortuneTeller: Soll ich in dir lesen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755294
    m_Localized: Wie hast du dir selbst geholfen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755295
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755296
    m_Localized: 'FortuneTeller: All deine Fehler sind nur Symbole in deinem Universum, die du noch nicht entziffert hast.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755297
    m_Localized: 'FortuneTeller: Ich habe einen langen Weg hinter mir. Sieh dich um und wirf einen Blick zurück. Siehst du das Wesen dieses Hauses?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755298
    m_Localized: 'FortuneTeller: Hell, geräumig und in Harmonie mit meiner Energie. Es gibt keinen Grund, sich gegen dieses Haus zu wehren.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755299
    m_Localized: 'FortuneTeller: Es hat deine Angst bereits absorbiert. Akzeptiere es, sonst werden die Wände deine Tränen vergießen. Verstehst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755300
    m_Localized: 'FortuneTeller: Soll ich in dir lesen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755301
    m_Localized: Was willst du von mir?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755302
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755303
    m_Localized: 'FortuneTeller: Also wirklich. Du denkst, dass ich irgendetwas von dir will?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755304
    m_Localized: 'FortuneTeller: Wenn du deinen eigenen Schatten tanzen sehen würdest, wüsstest du, wo dein Weg verborgen liegt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755305
    m_Localized: 'FortuneTeller: Du musst nur Glücksmantras rezitieren. Du wirst spüren, dass sich alles verändert. Das Atmen fällt leichter.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755306
    m_Localized: 'FortuneTeller: Meine Energie fließt in deinen Raum. Suche nicht nach Sinn. Das ist eine Illusion für die, die Angst vor Chaos haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755307
    m_Localized: 'FortuneTeller: Werde eins mit diesem Raum. Sage: „Ich bin in diesem Raum nicht nur Gast – ich bin sein Schöpfer.“'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755308
    m_Localized: 'FortuneTeller: Soll ich in dir lesen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755309
    m_Localized: Was, wenn ich kein Schöpfer sein will?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755310
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755311
    m_Localized: 'FortuneTeller: Deine Wände wollen dich seit langer Zeit umarmen, aber du legst ihnen die Ketten deiner Kontrolle an.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755312
    m_Localized: 'FortuneTeller: Deine innere Stille ist die Stimme der Welt, die du mit deiner Angst erstickst.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755313
    m_Localized: 'FortuneTeller: Deine Energie ist zähflüssig wie Honig im Winter. Du musst sie mit deinem Atem auftauen. Und Spiegel lügen nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755314
    m_Localized: 'FortuneTeller: Wer nur sich selbst sieht, sieht gar nichts. Du musst deine Energie einfach nur drei Grad nach rechts ausrichten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755315
    m_Localized: 'FortuneTeller: Dann kannst du endlich glücklich sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755316
    m_Localized: 'Fanatic: Ich bin ganz Ohr, Mensch. Sprechen Sie!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755317
    m_Localized: Gehören Sie irgendeinem Glauben an?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755318
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755319
    m_Localized: 'Fanatic: JA, MENSCH! Aber mein Glaube hat nichts mit den Religionen zu tun, die Sie kennen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755320
    m_Localized: 'Fanatic: Ich huldige DER SONNE SELBST! DENN SIE BESCHÜTZT UNS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755321
    m_Localized: 'Fanatic: Aber dumme Leute sehen nur schlechte Dinge in ihr. Sie denken, sie würde uns alle verbrennen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755322
    m_Localized: 'Fanatic: SCHWACHSINN! Die Sonne hat es nur auf die Saat des Bösen und auf Ketzer abgesehen! Denn das sind die wahren Sünder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755323
    m_Localized: 'Fanatic: Mögen die Zweifler sich vor ihrem brennenden Arm der Gerechtigkeit hüten!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755324
    m_Localized: 'Fanatic: Sie suchen nach Ärger und wundern sich, wenn sie sich verbrennen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755325
    m_Localized: Saat des Bösen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755326
    m_Localized: Ketzer?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755327
    m_Localized: 'Fanatic: Da fragen Sie noch? Wissen Sie nicht, WER DIE AUSSERIRDISCHEN SIND?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755328
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755329
    m_Localized: 'Fanatic: Na gut, Mensch. Ich erzähle Ihnen die NACKTE WAHRHEIT.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755330
    m_Localized: 'Fanatic: DIE BESUCHER SIND DIE SAAT DES BÖSEN!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755331
    m_Localized: 'Fanatic: SIE STAMMEN VON AUSSERIRDISCHEN AB, die auf die Erde kamen, als die Sonne noch jünger und das Gras grüner war!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755332
    m_Localized: 'Fanatic: VERDAMMTE BRUT, die sich auf der Erde eingenistet und über JAHRHUNDERTE Inzucht betrieben hat!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755333
    m_Localized: 'Fanatic: Und jetzt kommen sie rausgekrochen und beanspruchen UNSER LAND, ALS WÜRDE ES IHNEN GEHÖREN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755334
    m_Localized: 'Fanatic: Aber die SONNE hat beschlossen, uns zu beschützen, denn DAS IST UNSER LAND.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755335
    m_Localized: 'Fanatic: Die Sonne kennt KEINE GNADE mit den Besuchern! Warum hätten sie sich sonst unter der Erde verstecken sollen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755336
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755337
    m_Localized: 'Fanatic: Verdammt ... Warum musstest du dich damals so betrinken?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755338
    m_Localized: 'Fanatic: Du hättest nicht bis zur Besinnungslosigkeit saufen sollen. Der gerechte Zorn der Heiligen Sonne ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755339
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755340
    m_Localized: 'Fanatic: HEILIGE SONNE, lass ihn in Frieden ruhen und vergib ihm unsere Sünden.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755341
    m_Localized: 'Fanatic: Nimm ihn in deine liebevollen Arme. Und auch die Seele des Feigenbaums, den er nicht mehr gießen kann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755342
    m_Localized: 'Fanatic: Amen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755343
    m_Localized: 'Fanatic: Du hast richtig gehört, Mensch!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755344
    m_Localized: 'Fanatic: Die FEMA besteht aus verdammten KETZERN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755345
    m_Localized: 'Fanatic: Sie mischen sich in Dinge ein, über die WIR NORMALEN LEUTE keinerlei Kontrolle haben!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949376
    m_Localized: 'Fanatic: Sie stecken ihre Nasen in fremde Angelegenheiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949377
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949378
    m_Localized: 'Fanatic: Möge die Sonne diese Bastarde verdammen, die meine Mutter in eine Pfütze geworfen haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949379
    m_Localized: 'Fanatic: Ich bin ganz Ohr, Mensch. Sprechen Sie!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949380
    m_Localized: Die Sonne hat eine Menge Leute verbrannt
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949381
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949382
    m_Localized: 'Fanatic: Stimmt. Sie haben alle zur Saat des Bösen gehört, Mensch!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949383
    m_Localized: 'Fanatic: Die Sonne hat beschlossen, sie ALLE für die Sünden zu bestrafen, die die Menschen seit TAUSEND JAHREN begangen haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949384
    m_Localized: 'Fanatic: UND DIE BESUCHER, DIESE VERDAMMTEN DUMMKÖPFE, haben angefangen, nach der SONNE zu greifen!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949385
    m_Localized: 'Fanatic: Aber die SONNE ist nicht für diesen unterirdischen Abschaum da, sondern für uns MENSCHEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949386
    m_Localized: 'Fanatic: SIE GEHÖRT UNS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949387
    m_Localized: 'Fanatic: SIE IST EIN SEGEN FÜR DIE MENSCHHEIT, VERFLUCHT NOCH MAL!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949388
    m_Localized: Wie viele müssen verbrennen, um die Sonne zu beruhigen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949389
    m_Localized: Ist das Ende der Welt die Gerechtigkeit der Sonne?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949390
    m_Localized: 'Fanatic: Viele.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949391
    m_Localized: 'Fanatic: Und glauben Sie mir, mein Freund, es ist NOCH LANGE NICHT VORBEI.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949392
    m_Localized: 'Fanatic: ES HAT GERADE ERST ANGEFANGEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949393
    m_Localized: 'Fanatic: Die WAAGSCHALE ist noch nicht genug gefüllt, um die KRÄFTE DES UNIVERSUMS aufzuwiegen!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949394
    m_Localized: 'Fanatic: Die gerechten Flammen der SONNE müssen NOCH MEHR VERBRENNEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949395
    m_Localized: 'Fanatic: Aber denken Sie daran, mein Freund: Diese Opfer werden nicht umsonst sterben!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949396
    m_Localized: 'Fanatic: Irgendwann werden wir alle den wahren Plan der Sonne verstehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949397
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949398
    m_Localized: 'Fanatic: Manchmal bin ich nachts so traurig, dass meine Frau mich verlassen hat ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949399
    m_Localized: 'Fanatic: Sie war eine rechtschaffene Frau ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949400
    m_Localized: 'Fanatic: Aber auch eine Schlampe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949401
    m_Localized: 'Fanatic: Das Ende für wen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949402
    m_Localized: 'Fanatic: Für uns?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949403
    m_Localized: 'Fanatic: Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949404
    m_Localized: 'Fanatic: Dass ich nicht lache. DIE SONNE IST AUF UNSERER SEITE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949405
    m_Localized: 'Fanatic: Sie hilft uns, sehen Sie das nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949406
    m_Localized: 'Fanatic: Sie versucht, die Besucher zurück unter die Erde zu bringen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949407
    m_Localized: 'Fanatic: Sie bestraft schlechte Leute für die Sünden der Menschheit ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949408
    m_Localized: 'Fanatic: Sie entlarvt Ketzer in vollgepissten Lumpen, die ihre schändlichen Fratzen hinter Masken verstecken.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949409
    m_Localized: 'Fanatic: Wir müssen der Sonne danken, anstatt das Ende der Welt herbeizureden.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949410
    m_Localized: 'Fanatic: DAS IST DAS ENDE FÜR ALLE FEINDE DER SONNE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949411
    m_Localized: 'Fanatic: TOD DEN UNTERIRDISCHEN! TOD DEN BESCHISSENEN KETZERN! TOD DER SAAT DES BÖSEN!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949412
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949413
    m_Localized: 'Fanatic: Mein Gott, wie lange ist es her, dass ich Bratkartoffeln gegessen habe ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949414
    m_Localized: 'Fanatic: Ich bin ganz Ohr, Mensch. Sprechen Sie!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949415
    m_Localized: Sehen Sie in den Geschehnissen etwas Heiliges?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949416
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949417
    m_Localized: 'Fanatic: Mensch, warum habe ich Ihnen alles haarklein erklärt?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949418
    m_Localized: 'Fanatic: Nur, damit Sie mir wieder DIESELBE FRAGE STELLEN?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949419
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949420
    m_Localized: 'Fanatic: Ich habe mich in Ihnen geirrt, Mensch. Sie begreifen wirklich überhaupt nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949421
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949422
    m_Localized: 'Fanatic: Verdammt, ich hätte jetzt gerne ein kaltes Bier ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949423
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949424
    m_Localized: 'Fanatic: Könnten Sie mir einen letzten Gefallen tun, Mensch?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949425
    m_Localized: 'Hier, bitte (Bier geben) '
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949426
    m_Localized: 'Fanatic: Sie haben kein Bier? Wollen Sie mich auf den Arm nehmen, Mensch?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949427
    m_Localized: 'Fanatic: Ich habe es MIT EIGENEN AUGEN GESEHEN!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949428
    m_Localized: 'Fanatic: Also wirklich, Mensch. So viel Bier trinken und dann nicht mal TEILEN wollen!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949429
    m_Localized: Nein (kein Bier geben)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949430
    m_Localized: 'Fanatic: Ah, gut ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949431
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949432
    m_Localized: 'Fanatic: Mmm, lecker. Dunkles Bier, das mag ich am liebsten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949433
    m_Localized: 'Fanatic: Das erinnert mich an Kneipenabende mit meinen Freunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949434
    m_Localized: 'Fanatic: Gute Gespräche, kaltes Bier, Salzstangen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949435
    m_Localized: 'Fanatic: Und das übellaunige Gesicht von diesem dürren Kerl, der uns immer abschätzig angestarrt hat ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949436
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949437
    m_Localized: 'Fanatic: Na ja, kein Grund zur Aufregung, Mensch. Sie sind vielleicht dumm, aber wenigstens sind Sie nett.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949438
    m_Localized: 'Fanatic: Ich will Ihnen ein kleines Dankeschön geben. Hier, nehmen Sie das.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949439
    m_Localized: 'Fanatic: Möge die Heilige Sonne Ihre Seele retten!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949440
    m_Localized: 'Fanatic: Sie WIDERLING!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949441
    m_Localized: 'Fanatic: SCHMOREN SIE IN DER HÖLLE, SIE BASTARD!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949442
    m_Localized: 'Fanatic: Wie undankbar! Da erkläre ich ihm die heiligen Lehren, die Bedeutung von allem, und er ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949443
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949444
    m_Localized: 'Fanatic: SIE SIND EIN BÖSARTIGER, DUMMER MENSCH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949445
    m_Localized: 'Fanatic: Zum Teufel mit Ihnen. Bleiben Sie doch hier in Ihrem Drecksloch! Ich gehe woandershin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949446
    m_Localized: 'Fanatic: Sie werden schon sehen, in der Bar werden sie mich wieder reinlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949447
    m_Localized: 'Fanatic: Machen Sie’s gut, Blödmann.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949448
    m_Localized: 'Anxiety: H-Hehe. Hoffentlich ist bald alles vorbei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949449
    m_Localized: Wie hast du dein Haus verloren?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949450
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949451
    m_Localized: 'Anxiety: Ah ... Ich kann mich noch genau an den Tag erinnern.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949452
    m_Localized: 'Anxiety: Ich wurde gefeuert und wollte nur noch nach Hause, um mich im Bett auszuheulen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949453
    m_Localized: 'Anxiety: Als ich dort ankam, sah ich Stiefel im Flur. Ich dachte, meine Mitbewohnerin hätte vielleicht Besuch.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949454
    m_Localized: 'Anxiety: Also ging ich zu ihrem Zimmer, um nachzusehen. Als ich an ihrer Tür war, hörte ich ein komisches Geräusch.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949455
    m_Localized: 'Anxiety: Ich war beunruhigt und wollte heimlich nachsehen, was drinnen los war.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949456
    m_Localized: 'Anxiety: Ich konnte nur kurz sehen, dass meine Mitbewohnerin regungslos auf dem Bett lag ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949457
    m_Localized: 'Anxiety: Plötzlich packte mich ein zotteliger Typ von hinten und sagte: „Geh nicht da rein. Sie ... fühlt sich nicht gut.“'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949458
    m_Localized: 'Anxiety: „Gehen wir lieber in die Küche.“ Dann zog er mich am Arm und setzte mich an den Küchentisch.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949459
    m_Localized: 'Anxiety: Ich wollte fliehen, aber ich war vor Angst wie erstarrt ... Und dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949460
    m_Localized: 'Anxiety: Ich ... Er ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949461
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949462
    m_Localized: 'Anxiety: Ich muss mich ausruhen. Mein Magen dreht sich vor lauter Angst ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949463
    m_Localized: 'Anxiety: H-Hehe. Hoffentlich ist bald alles vorbei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949464
    m_Localized: Was ist in deinem Haus passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949465
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949466
    m_Localized: 'Anxiety: Ach ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949467
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949468
    m_Localized: 'Anxiety: Als der Mann mich an den Küchentisch setzte, versperrte ein riesiger Typ, der sich in der Ecke versteckt hatte, die Tür.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949469
    m_Localized: 'Anxiety: Er sprach laut mit dem anderen, der mich am Arm gezogen hatte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949470
    m_Localized: 'Anxiety: Als ob ich gar nicht da wäre. Und dann ... fingen sie an, mich anzufassen!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949471
    m_Localized: 'Anxiety: An den Armen, an den Schultern ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949472
    m_Localized: 'Anxiety: Im Hintergrund hörte ich Jubelgeschrei und lautes Gelächter. Es schien aus meinem Zimmer zu kommen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949473
    m_Localized: 'Anxiety: Es klang wie eine ganze Gruppe von Männern.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949474
    m_Localized: 'Anxiety: Ich bekam Atemprobleme. Es fühlte sich an, als würde mein Herz sich durch meine Brust hämmern.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949475
    m_Localized: 'Anxiety: Ich wollte um Hilfe schreien, aber meine Stimme ... Ich brachte vor Angst keinen Ton heraus.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949476
    m_Localized: 'Anxiety: Ich saß einfach nur da wie eine Puppe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949477
    m_Localized: 'Anxiety: Aber als der große Typ etwas aus dem Kühlschrank holen wollte, witterte ich meine Chance ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949478
    m_Localized: 'Anxiety: Ich rannte zum Ausgang. Die Angst gab mir Kraft. Ich rannte einfach nur weg, ohne mich umzudrehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949479
    m_Localized: 'Anxiety: Bis mir die Puste ausging und ich auf dem Boden zusammenbrach ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949480
    m_Localized: Warum hat die Sonne dich nicht verbrannt?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949481
    m_Localized: Was ist dann passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949482
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949483
    m_Localized: 'Anxiety: Ich kann mich nicht erinnern ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949484
    m_Localized: 'Anxiety: Ich muss die ganze Nacht dort gelegen haben, und dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949485
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949486
    m_Localized: 'Anxiety: Seltsam ... Ich dachte, ich könnte mich noch genau an alles erinnern ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949487
    m_Localized: 'Anxiety: Moment mal, du denkst doch nicht etwa ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949488
    m_Localized: 'Anxiety: Ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949489
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949490
    m_Localized: 'Anxiety: Vielleicht bin ich eine Besucherin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949491
    m_Localized: 'Anxiety: Nein, das kann nicht sein. Ich erinnere mich an mein Leben. Meine Kindheit, meine Eltern. Nein!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949492
    m_Localized: 'Anxiety: Ich bin keine Besucherin, oder? Sag mir, dass ich keine Besucherin bin!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949493
    m_Localized: Ich weiß es nicht
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949494
    m_Localized: Du bist keine Besucherin
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949495
    m_Localized: Du wirkst wie eine Besucherin
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949496
    m_Localized: 'Anxiety: Ich lag am Boden, und dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949497
    m_Localized: 'Anxiety: Dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949498
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949499
    m_Localized: 'Anxiety: Ich dachte, ich könnte mich an alles erinnern.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949500
    m_Localized: 'Anxiety: Moment mal, du denkst doch nicht etwa ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949501
    m_Localized: 'Anxiety: Ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949502
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949503
    m_Localized: 'Anxiety: Vielleicht bin ich eine Besucherin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949504
    m_Localized: 'Anxiety: Nein, das kann nicht sein. Ich erinnere mich an mein Leben. Meine Kindheit, meine Eltern. Nein!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949505
    m_Localized: 'Anxiety: Ich bin keine Besucherin, oder? Sag mir, dass ich keine Besucherin bin!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949506
    m_Localized: Ich weiß es nicht
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949507
    m_Localized: Du bist keine Besucherin
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949508
    m_Localized: Du wirkst wie eine Besucherin
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949509
    m_Localized: 'Anxiety: WARUM SAGST DU SO WAS?! Oh mein Gott, ich habe Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949510
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949511
    m_Localized: 'Anxiety: Ich muss mich ausruhen. Mein Magen dreht sich schon wieder. Oh ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949512
    m_Localized: 'Anxiety: Danke, jetzt geht es mir schon besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949513
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949514
    m_Localized: 'Anxiety: Ach, ich muss mich ausruhen. Mein Magen dreht sich schon wieder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949515
    m_Localized: 'Anxiety: WARUM SAGST DU SO WAS?! Jetzt habe ich noch mehr Angst!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949516
    m_Localized: 'Anxiety: ICH WILL NICHT STERBEN! ICH WILL NICHT!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949517
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949518
    m_Localized: 'Anxiety: Wir werden alle sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949519
    m_Localized: 'Anxiety: H-Hehe. Hoffentlich ist bald alles vorbei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949520
    m_Localized: Alles in Ordnung?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949521
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949522
    m_Localized: 'Anxiety: KEINEN SCHRITT NÄHER!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949523
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949524
    m_Localized: 'Anxiety: Tut mir leid, ich ... Ich dachte, du wolltest mich umbringen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949525
    m_Localized: Wie kommst du darauf?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949526
    m_Localized: Wenn ich das wollte, wärst du schon lange tot
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949527
    m_Localized: 'Anxiety: Ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949528
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949529
    m_Localized: 'Anxiety: Ich habe keine Ahnung, wer ein Besucher ist und wer nicht ... Was, wenn ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949530
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949531
    m_Localized: 'Anxiety: Was, wenn du ein Besucher bist?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949532
    m_Localized: 'Anxiety: Wirst du mich dann töten? Mir die Haut abziehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949533
    m_Localized: 'Anxiety: BITTE NICHT! TÖTE MICH KURZ UND SCHMERZLOS.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949534
    m_Localized: 'Anxiety: ICH WILL NICHT QUALVOLL STERBEN. BITTE!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949535
    m_Localized: Beruhige dich, ich bin kein Besucher
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949536
    m_Localized: Ich werde dich nicht töten
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949537
    m_Localized: 'Anxiety: Tut mir leid, ich bin einfach verunsichert.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949538
    m_Localized: 'Anxiety: Ich weiß nicht, wem ich vertrauen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949539
    m_Localized: 'Anxiety: Und was, wenn ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949540
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949541
    m_Localized: 'Anxiety: Was, wenn du ein Besucher bist?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949542
    m_Localized: 'Anxiety: Wirst du mich dann töten? Mir die Haut abziehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949543
    m_Localized: 'Anxiety: BITTE NICHT! TÖTE MICH KURZ UND SCHMERZLOS.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949544
    m_Localized: 'Anxiety: ICH WILL NICHT QUALVOLL STERBEN. BITTE!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949545
    m_Localized: Beruhige dich, ich bin kein Besucher
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949546
    m_Localized: Ich werde dich nicht töten
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949547
    m_Localized: 'Anxiety: WIE KANN ICH MIR DA SICHER SEIN?! Ich habe deine Zähne und deine Augen noch nicht überprüft ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949548
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949549
    m_Localized: 'Anxiety: Wir werden alle sterben. Entweder durch die Besucher oder durch die Sonne ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949550
    m_Localized: 'Anxiety: Es gibt keine Hoffnung mehr. Wir können dem Tod nicht entkommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949551
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949552
    m_Localized: 'Anxiety: Lass mich allein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949553
    m_Localized: 'Anxiety: WIE KANN ICH MIR DA SICHER SEIN?! Ich habe deine Zähne und deine Augen noch nicht überprüft ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949554
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949555
    m_Localized: 'Anxiety: Wir werden alle sterben. Entweder durch die Besucher oder durch die Sonne ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949556
    m_Localized: 'Anxiety: Es gibt keine Hoffnung mehr. Wir können dem Tod nicht entkommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949557
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949558
    m_Localized: 'Anxiety: Lass mich allein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949559
    m_Localized: 'Anxiety: H-Hehe. Hoffentlich ist bald alles vorbei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949560
    m_Localized: Was ist los mit dir?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949561
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949562
    m_Localized: 'Anxiety: BESUCHER! SIE KOMMEN UNS HOLEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949563
    m_Localized: 'Anxiety: Hörst du das nicht? DER TOD RUFT UNS.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949564
    m_Localized: 'Anxiety: BESUCHER, MENSCH ... WAS MACHT DAS FÜR EINEN UNTERSCHIED?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949565
    m_Localized: 'Anxiety: VOR DEM TOD SIND WIR ALLE GLEICH.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949566
    m_Localized: 'Anxiety: Warum sollten wir uns also fürchten? SOLLEN SIE DOCH KOMMEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949567
    m_Localized: 'Anxiety: SIE WOLLEN NUR UNSER BESTES! SOLLEN DIE BESUCHER DOCH KOMMEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949568
    m_Localized: Dir scheint es nicht gut zu gehen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949569
    m_Localized: Hast du den Verstand verloren?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949570
    m_Localized: 'Anxiety: NEIN, ICH HATTE GERADE EINE EINGEBUNG!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949571
    m_Localized: 'Anxiety: ICH BIN EINE BESUCHERIN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949572
    m_Localized: 'Anxiety: WIR UND DIE MENSCHEN SIND GLEICH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949573
    m_Localized: 'Anxiety: WIR SIND WIE SPIEGELBILDER!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949574
    m_Localized: 'Anxiety: AKZEPTIEREN WIR GEMEINSAM DEN TOD!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949575
    m_Localized: Du weißt nicht, was du da redest
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949576
    m_Localized: Du lässt mir keine Wahl
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949577
    m_Localized: 'Anxiety: ICH BIN NICHT VERRÜCKT – ICH HABE DAS LICHT GESEHEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949578
    m_Localized: 'Anxiety: ICH BIN EINE BESUCHERIN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949579
    m_Localized: 'Anxiety: WIR UND DIE MENSCHEN SIND GLEICH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949580
    m_Localized: 'Anxiety: WIR SIND WIE SPIEGELBILDER!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949581
    m_Localized: 'Anxiety: AKZEPTIEREN WIR GEMEINSAM DEN TOD! ES DAUERT NICHT MEHR LANGE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949582
    m_Localized: Du weißt nicht, was du da redest
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949583
    m_Localized: Du lässt mir keine Wahl
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949584
    m_Localized: 'Anxiety: Nein, du hast nichts verstanden!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949585
    m_Localized: 'Anxiety: Der Tod kommt! DIE SONNE KÜNDIGT DEN TOD AN.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949586
    m_Localized: 'Anxiety: Bald begegnen wir ihm. Sehr bald.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949587
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949588
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949589
    m_Localized: 'Anxiety: Schieß doch! Worauf wartest du noch?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949590
    m_Localized: 'Anxiety: KANNST DU OHNE DIE GERINGSTE REUE TÖTEN?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949591
    m_Localized: 'Anxiety: Es ist mir egal. TU, WAS DU NICHT LASSEN KANNST, MENSCH.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949592
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949593
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949594
    m_Localized: 'Esenin: Ja? Wollten Sie irgendwas besprechen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949595
    m_Localized: Warum sind Sie aus der Bar rausgeflogen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949596
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949597
    m_Localized: 'Esenin: Weil diese ganzen Katastrophen alle verrückt gemacht haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949598
    m_Localized: 'Esenin: Die explodierende Sonne, die Besucher, die Wirtschaftskrise und der ganze Mist.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949599
    m_Localized: 'Esenin: Die Leute haben den Verstand verloren. Manche vor Stress, andere vor Alkohol.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949600
    m_Localized: 'Esenin: Ich bin einfach ausgerastet.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949601
    m_Localized: 'Esenin: Ich bin auf einen Tisch gestiegen und habe geschrien: „Gebt nicht allen anderen die Schuld! Wo ist eure Menschlichkeit?“'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949602
    m_Localized: 'Esenin: Tränen im Bierschaum stören mich nicht. Hopfen und Malz schmecken besser mit Salz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949603
    m_Localized: 'Esenin: Aber wer braucht schon Bier?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949604
    m_Localized: 'Esenin: Ja? Wollten Sie irgendwas besprechen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949605
    m_Localized: Ist es hier anders?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949606
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949607
    m_Localized: 'Esenin: Ich rege mich nicht mehr über andere auf. Das ist es nicht wert.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949608
    m_Localized: 'Esenin: Aber wenn man dem Fernseher oder irgendwelchen Gesprächen zuhört, kommt alles wieder in einem hoch.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949609
    m_Localized: 'Esenin: Dann fragt man sich: Habe ich das alles nötig?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949610
    m_Localized: 'Esenin: Nein, mein Lieber, meine Nerven sind sowieso schon jenseits von Gut und Böse.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949611
    m_Localized: 'Esenin: Das Leben war auch ohne den ganzen Mist schon trostlos genug ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949612
    m_Localized: 'Esenin: Irgendwann greife ich nach dem Kronleuchter und hänge über der ganzen erleuchteten Welt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949613
    m_Localized: 'Esenin: Ja? Wollten Sie irgendwas besprechen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949614
    m_Localized: Alles in Ordnung?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949615
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949616
    m_Localized: 'Esenin: Hm? Warum fragen Sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949617
    m_Localized: Ich rieche etwas an Ihnen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949618
    m_Localized: Haben Sie Fieber?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949619
    m_Localized: 'Esenin: Tja ... Ich habe mich an Ihrem Bier bedient.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949620
    m_Localized: 'Esenin: Mir ging’s nicht gut. Ich musste was trinken. Das kann doch nicht verboten sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949621
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949622
    m_Localized: 'Esenin: Das ist alles so verkorkst.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949623
    m_Localized: 'Esenin: Alle sagen, sie würden Probleme lösen, aber sie reden nur Scheiße. Gar nichts passiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949624
    m_Localized: 'Esenin: Wissen Sie, ich glaube, wir sind sowieso bald alle tot.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949625
    m_Localized: 'Esenin: Wenn die Sonne uns nicht tötet, dann die Besucher. Und wenn wir die Besucher besiegen, bringen wir uns gegenseitig um.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949626
    m_Localized: 'Esenin: Wenn es keine Probleme gibt, machen wir uns selbst welche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949627
    m_Localized: 'Esenin: Als ob wir nicht leben könnten, ohne uns ständig in die Hosen zu machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949628
    m_Localized: 'Esenin: Scheiße.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949629
    m_Localized: 'Esenin: Lassen Sie mich in Ruhe. Mir ist schlecht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949630
    m_Localized: 'Esenin: Nicht ich habe Fieber, sondern der ganze verdammte Planet.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949631
    m_Localized: 'Esenin: Ständig stirbt irgendwo jemand. Oder die Gletscher schmelzen. Oder die Wälder brennen. Die Welt hat Fieber.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949632
    m_Localized: 'Esenin: Die Erde versucht uns abzuschütteln wie vollgesaugte Flöhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949633
    m_Localized: 'Esenin: Irgendwann gelingt es ihr. Dann wird’s richtig ungemütlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949634
    m_Localized: 'Esenin: Aaarrg ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949635
    m_Localized: 'Esenin: Hauen Sie ab. Bitte. Mir ist schlecht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949636
    m_Localized: 'Esenin: Ja? Wollten Sie irgendwas besprechen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949637
    m_Localized: Geht es Ihnen besser?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949638
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949639
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949640
    m_Localized: 'Esenin: Guter Mann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949641
    m_Localized: 'Esenin: Irgendwann müssen wir alle sterben. Das ist unausweichlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949642
    m_Localized: 'Esenin: Was denken Sie, was nach dem Tod mit uns passiert?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949643
    m_Localized: Das, woran man glaubt
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949644
    m_Localized: Gar nichts
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949645
    m_Localized: Vielleicht landen wir im Weltall
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949646
    m_Localized: 'Esenin: Kein schlechter Gedanke.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949647
    m_Localized: 'Esenin: Aber besser geht’s mir damit nicht. Wissen Sie, warum?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949648
    m_Localized: 'Esenin: Wenn ich sterbe, wird mein Gehirn es verstehen. Es wird mir Dinge zeigen, zu denen ich gerne zurückkehren würde.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949649
    m_Localized: 'Esenin: Und wenn meine Kraft für diesen Traum am Ende ist, was dann?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949650
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949651
    m_Localized: 'Esenin: Nein. Mir geht’s keinen Deut besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949652
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949653
    m_Localized: 'Esenin: Ich habe auf eine andere Antwort gehofft.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949654
    m_Localized: 'Esenin: Sie könnten natürlich recht haben. Aber das ist eine furchtbare Vorstellung.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949655
    m_Localized: 'Esenin: Dass es einfach gar nichts gibt ... Nur Dunkelheit?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949656
    m_Localized: 'Esenin: Mir ist gerade nicht nach Reden zumute.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143680
    m_Localized: 'Esenin: Wenn man so darüber nachdenkt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143681
    m_Localized: 'Esenin: Im Weltall gibt es nichts außer uns.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143682
    m_Localized: 'Esenin: Kein anderes Leben. Nur kalten, leeren Raum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143683
    m_Localized: 'Esenin: Wenn es Außerirdische geben würde, hätten wir schon längst irgendein Signal gefunden. Ich weiß nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143684
    m_Localized: 'Esenin: Der leere Raum endloser Dunkelheit. Wenn wir nach dem Tod dort landen, könnten wir genauso gut verschwinden ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337984
    m_Localized: 'Esenin: Ich ... wäre jetzt lieber allein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337985
    m_Localized: 'Esenin: Ja? Wollten Sie irgendwas besprechen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337986
    m_Localized: Geht es Ihnen gut?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337987
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337988
    m_Localized: 'Esenin: Die Bar hatte wenigstens eine hohe Decke.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337989
    m_Localized: 'Esenin: Dort konnte man sich aufhängen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337990
    m_Localized: 'Esenin: Hier drinnen ist es mir zu voll. Der ganze Planet ist mir zu voll.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337991
    m_Localized: 'Esenin: Guter Mann, ich will einfach nur, dass alles aufhört.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337992
    m_Localized: 'Esenin: Das ist alles so verkorkst. Ich habe eine Scheißangst.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337993
    m_Localized: 'Esenin: Ich kann einfach nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337994
    m_Localized: 'Esenin: Warum bin ich überhaupt hergekommen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337995
    m_Localized: 'Widow: Ich muss mich ausruhen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337996
    m_Localized: Brauchen Sie irgendwas?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337997
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337998
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337999
    m_Localized: 'Widow: Ich will, dass er wieder lebt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338000
    m_Localized: 'Widow: Das ist alles ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338001
    m_Localized: 'Widow: Mehr brauche ich nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338002
    m_Localized: Soll ich Ihnen Wasser bringen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338003
    m_Localized: Wollen Sie etwas essen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338004
    m_Localized: 'Widow: Ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338005
    m_Localized: 'Widow: Ich bleibe einfach beim Wasserhahn sitzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338006
    m_Localized: 'Widow: Wenn ich Durst habe, trinke ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338007
    m_Localized: Dann lasse ich Sie in Ruhe
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338008
    m_Localized: Darf ich Ihnen Gesellschaft leisten?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338009
    m_Localized: 'Widow: Ich habe keinen Hunger.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338010
    m_Localized: 'Widow: Ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338011
    m_Localized: 'Widow: Ich will einfach nur sitzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338012
    m_Localized: Dann lasse ich Sie in Ruhe
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338013
    m_Localized: Darf ich Ihnen Gesellschaft leisten?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338014
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338015
    m_Localized: 'Widow: Warum musstest du sterben?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338016
    m_Localized: 'Widow: Du hast mir versprochen, dass alles besser wird.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338017
    m_Localized: 'Widow: Du hast gesagt, dass alles besser wird.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338018
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338019
    m_Localized: 'Widow: Und dann bist du gestorben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338020
    m_Localized: 'Widow: Jetzt bin nur noch ich übrig.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338021
    m_Localized: 'Widow: Warum hast du das getan?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338022
    m_Localized: 'Widow: Ich will mit ihm zusammen sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338023
    m_Localized: 'Widow: Keiner kann ihn mir zurückbringen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338024
    m_Localized: 'Widow: Ich kann ihn nicht mal ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338025
    m_Localized: 'Widow: Beerdigen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338026
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338027
    m_Localized: 'Widow: Ich kann dich nicht beerdigen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338028
    m_Localized: 'Widow: Was soll ich nur machen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338029
    m_Localized: 'Widow: Ich muss mich ausruhen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338030
    m_Localized: Wie ist er gestorben?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338031
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338032
    m_Localized: 'Widow: Ich kann das nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338033
    m_Localized: 'Widow: Das ist zu viel.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338034
    m_Localized: 'Widow: Ich habe keine Tränen mehr übrig.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338035
    m_Localized: 'Widow: Ich habe keine Tränen mehr übrig.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338036
    m_Localized: 'Widow: Aber ist das richtig?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338037
    m_Localized: 'Widow: Ich kann doch nicht einfach aufhören zu weinen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338038
    m_Localized: Er muss beerdigt werden
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338039
    m_Localized: Sie müssen akzeptieren, dass er tot ist
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338040
    m_Localized: 'Widow: Nein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338041
    m_Localized: 'Widow: Nein, nein, nein!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338042
    m_Localized: 'Widow: Ich bin noch nicht bereit.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338043
    m_Localized: 'Widow: Sie haben ihn mir gerade erst zurückgegeben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338044
    m_Localized: 'Widow: Und jetzt sollen wir uns schon wieder trennen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338045
    m_Localized: 'Widow: Ich kann das nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338046
    m_Localized: 'Widow: Ich kann ihn nicht der kaltherzigen Erde überlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338047
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338048
    m_Localized: 'Widow: Nein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338049
    m_Localized: 'Widow: Nein, das stimmt nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338050
    m_Localized: 'Widow: Er kann mich immer noch hören.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338051
    m_Localized: 'Widow: Ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338052
    m_Localized: 'Widow: Ich will fest daran glauben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338053
    m_Localized: 'Widow: Ich muss mich ausruhen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338054
    m_Localized: Wie haben Sie ihn in Erinnerung?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338055
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338056
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338057
    m_Localized: 'Widow: Einmal waren wir zu Besuch bei unseren Freunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338058
    m_Localized: 'Widow: Da waren wir noch viel jünger.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338059
    m_Localized: 'Widow: Wir haben uns unterhalten und getrunken. Er war ziemlich in sich gekehrt und hat bei solchen Treffen nie viel geredet.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338060
    m_Localized: 'Widow: Jedenfalls haben wir damals viel getrunken.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338061
    m_Localized: 'Widow: Zuerst war er so wortkarg wie immer, und dann hat er auf einmal gesagt:'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338062
    m_Localized: 'Widow: „Gebt mir eine Gitarre. Ich singe jetzt.“'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338063
    m_Localized: 'Widow: Und er hat so gut gespielt. Ich war begeistert.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338064
    m_Localized: 'Widow: Unsere Freunde wollten noch mehr Lieder hören. Und dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338065
    m_Localized: 'Widow: Plötzlich steht er auf, sagt, dass er gehen muss, stößt ein Glas um, versucht es zu fangen, lässt die Gitarre fallen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338066
    m_Localized: 'Widow: Später habe ich erfahren, dass er nur dieses eine Lied gelernt hatte, um mich zu beeindrucken.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338067
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338068
    m_Localized: 'Widow: Ich habe noch ein Foto von ihm an diesem Abend.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338069
    m_Localized: 'Widow: Auch wenn es nicht mehr im besten Zustand ist ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338070
    m_Localized: 'Widow: Jetzt kannst du nicht mehr für mich spielen. Du hast mir dein letztes Lied vorgesungen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338071
    m_Localized: 'Widow: Ich muss mich ausruhen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338072
    m_Localized: Was ist mit ihm passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338073
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338074
    m_Localized: 'Widow: Er ist gestorben, verdammt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338075
    m_Localized: Verstehe, tut mir leid
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338076
    m_Localized: Ich habe ihn nicht umgebracht
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338077
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338078
    m_Localized: 'Widow: Ich kann einfach nicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338079
    m_Localized: 'Widow: Die Tränen kommen jede Nacht. Ich kann sie nicht aufhalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338080
    m_Localized: 'Widow: Am meisten wünsche ich mir, dass die Schuldigen für ... alles, was passiert ist ... Sie sollen in der Sonne verbrennen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338081
    m_Localized: Also ... Was ist passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338082
    m_Localized: Ich kann aufhören, Sie danach zu fragen
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338083
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338084
    m_Localized: 'Widow: Ja. Ich weiß.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338085
    m_Localized: 'Widow: Das war unhöflich von mir. Aber es ist so schwer für mich, über ihn zu reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338086
    m_Localized: 'Widow: Ich hoffe, diese Schweine bekommen, was sie verdienen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338087
    m_Localized: 'Widow: Jemand soll sie umbringen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338088
    m_Localized: Also ... Was ist passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338089
    m_Localized: Ich kann aufhören, Sie danach zu fragen
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338090
    m_Localized: 'Widow: Meinem Mann ging es nicht gut. Er war im Krankenhaus, aber sie haben ihn zu diesen Mistkerlen geschickt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338091
    m_Localized: 'Widow: Wir waren bei diesem Zentrum, das die FEMA eröffnet hatte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338092
    m_Localized: 'Widow: Sie haben ihn einfach in Quarantäne gesteckt. Ihm sein Telefon abgenommen. In drei Wochen wollten sie ihn gehen lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338093
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338094
    m_Localized: 'Widow: Ich bin vorher hingegangen und wollte sehen, ob alles in Ordnung ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338095
    m_Localized: 'Widow: Sie haben einfach eiskalt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338096
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338097
    m_Localized: 'Widow: Tut mir leid, ich muss mich kurz sammeln.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338098
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338099
    m_Localized: 'Widow: Sie haben gesagt: „Er ist tot.“'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338100
    m_Localized: 'Widow: Das war alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338101
    m_Localized: 'Widow: Ich durfte ihn nicht sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338102
    m_Localized: 'Widow: Ich durfte ihn nicht mitnehmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338103
    m_Localized: 'Widow: Aber bei diesen hirnverbrannten Idioten musste ich nur einen Laborkittel anziehen, um in die Leichenhalle zu kommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338104
    m_Localized: 'Widow: Und er ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338105
    m_Localized: 'Widow: Er war wirklich dort ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338106
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338107
    m_Localized: 'Widow: Sie haben ihn umgebracht. An ihren Händen klebt das Blut der einzigen Person, die mir etwas bedeutet hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338108
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338109
    m_Localized: 'Widow: Ich will allein sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338110
    m_Localized: 'Widow: Ja. Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338111
    m_Localized: 'Widow: Es ist so schwer, ohne ihn zu leben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338112
    m_Localized: 'Widow: Ich muss mich ausruhen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338113
    m_Localized: Stimmt etwas nicht?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338114
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338115
    m_Localized: 'Widow: Heute Abend gehe ich wieder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338116
    m_Localized: 'Widow: Ich habe Ihnen ja gesagt, dass ich nicht lange bleibe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338117
    m_Localized: 'Widow: Ich muss mich nur ausruhen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338118
    m_Localized: Was haben Sie vor?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338119
    m_Localized: Gehen Sie zu Ihrer Familie?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338120
    m_Localized: 'Widow: Ich will nicht darüber nachdenken.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338121
    m_Localized: 'Widow: Ich gehe zurück nach Hause.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338122
    m_Localized: 'Widow: Dann hole ich die Gitarre raus.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338123
    m_Localized: 'Widow: Und dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338124
    m_Localized: Sie können hierbleiben
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338125
    m_Localized: Viel Glück
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338126
    m_Localized: 'Widow: Es ist niemand mehr übrig.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338127
    m_Localized: 'Widow: Wir gehen nach Hause.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338128
    m_Localized: 'Widow: Mehr will ich nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338129
    m_Localized: Sie können hierbleiben
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338130
    m_Localized: Viel Glück
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338131
    m_Localized: 'Widow: Wozu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338132
    m_Localized: 'Widow: Das macht es für mich auch nicht einfacher.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338133
    m_Localized: 'Widow: Ich will nicht unhöflich sein, aber Sie sind mir egal.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338134
    m_Localized: 'Widow: Ich will einfach nur nach Hause.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338135
    m_Localized: 'Widow: Bis ich zurückgehe, will ich nichts mehr tun.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338136
    m_Localized: 'Widow: Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338137
    m_Localized: 'Widow: Sie reden zwar nicht viel, aber ... Sie sind ein guter Gesprächspartner.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338138
    m_Localized: 'Widow: Hoffentlich finden Sie, wonach Sie suchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338139
    m_Localized: 'Scammer: Hehe. Was gibt’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338140
    m_Localized: Was haben Sie vor der Katastrophe gemacht?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338141
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338142
    m_Localized: 'Scammer: Oooh, gut, dass Sie fragen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338143
    m_Localized: 'Scammer: Haben Sie schon mal von ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338144
    m_Localized: 'Scammer: ... Sportwetten gehört?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338145
    m_Localized: Sind Sie ein Betrüger?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338146
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338147
    m_Localized: 'Scammer: Ich bitte Sie! Ich bin Sportanalytiker.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338148
    m_Localized: 'Scammer: Wenn Sie wüssten, wie viel Kohle ich damit gemacht habe, würden Sie ganz schön sabbern, Freundchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338149
    m_Localized: 'Scammer: Ich bin ein Profi auf meinem Gebiet.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338150
    m_Localized: 'Scammer: Die Leute bringen mir ihr Geld und bekommen das Fünffache ... nein, das ZEHNFACHE zurück.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338151
    m_Localized: Wie viel haben Sie verdient?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338152
    m_Localized: Das nennen Sie Arbeit?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338153
    m_Localized: 'Scammer: Damit habe ich meinen Lebensunterhalt verdient.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338154
    m_Localized: 'Scammer: Wettgeschäfte waren einfach das große Ding.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338155
    m_Localized: 'Scammer: Es gibt gewisse Methoden, die Buchmacher übers Ohr zu hauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338156
    m_Localized: 'Scammer: Man wettet auf ein bestimmtes Team und wartet, bis die Kohle fließt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338157
    m_Localized: 'Scammer: Und wenn man kein Geld hat, ist das auch kein Problem. Dann leiht man es sich einfach.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338158
    m_Localized: Wie viel haben Sie verdient?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338159
    m_Localized: Das nennen Sie Arbeit?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338160
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338161
    m_Localized: 'Scammer: Wie soll ich sagen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338162
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338163
    m_Localized: 'Scammer: Ich habe dreißig verdammte Millionen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338164
    m_Localized: 'Scammer: ... Schulden gemacht. Aber Schulden waren mir schon immer egal.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338165
    m_Localized: 'Scammer: Und jetzt sind sie mir erst recht egal.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338166
    m_Localized: 'Scammer: Ich sehe der Gefahr ins Auge, Freundchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338167
    m_Localized: 'Scammer: Wollen Sie mich verarschen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338168
    m_Localized: 'Scammer: Natürlich ist das Arbeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338169
    m_Localized: 'Scammer: Ich hatte sogar ein eigenes Büro dafür. Mann, das war ein echter Luxus ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338170
    m_Localized: 'Scammer: Ein schickes Sofa und ein Notizblock mit allen Infos über Buchmacher, Schulden und Profite.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338171
    m_Localized: 'Scammer: Hehe. Was gibt’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338172
    m_Localized: Haben Sie keine Schuldeneintreiber am Hals?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338173
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338174
    m_Localized: 'Scammer: Schuldeneintreiber? Ist das Ihr Ernst?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338175
    m_Localized: 'Scammer: Pffff. Scheiß auf die Schuldeneintreiber. Ich habe keine Schulden mehr. Dafür hat die Sonne gesorgt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338176
    m_Localized: 'Scammer: Die Banken sind ihren Aufgaben nicht mehr gewachsen. Vielleicht werden sie es nie wieder sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338177
    m_Localized: 'Scammer: Das heißt, ich bin frei. Und kann mir ein neues Geschäftsfeld suchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338178
    m_Localized: 'Scammer: Wetten sind ein Relikt aus dem letzten Jahrhundert. Ich muss mir was Neues ausdenken.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338179
    m_Localized: Die Sonne hat Ihnen Glück gebracht
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338180
    m_Localized: Planen Sie schon wieder neue „Geschäfte“?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338181
    m_Localized: 'Scammer: Ach was.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338182
    m_Localized: 'Scammer: Ich hätte die Verluste irgendwann wieder reingeholt und meine Schulden abbezahlt. Kein Ding.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338183
    m_Localized: 'Scammer: Aber jetzt habe ich einen Neuanfang.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338184
    m_Localized: 'Scammer: Ich habe übrigens ein neues Geschäft. Na, interessiert?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338185
    m_Localized: Was ist der Plan?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338186
    m_Localized: Nicht wirklich
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338187
    m_Localized: 'Scammer: Vor Kurzem ist mir eine neue Geschäftsidee eingefallen. Wenn Sie wollen, erzähle ich Ihnen davon.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338188
    m_Localized: Was ist der Plan?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338189
    m_Localized: Nicht wirklich
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338190
    m_Localized: 'Scammer: So wie’s aussieht, hat die FEMA hier das Sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338191
    m_Localized: 'Scammer: Wir müssen also ... gute Beziehungen pflegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338192
    m_Localized: 'Scammer: Wenn wir ihnen regelmäßig Leute übergeben, bringen sie uns vielleicht sogar in einen Bunker.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338193
    m_Localized: 'Scammer: Verstehen Sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338194
    m_Localized: Sie wollen Leute an die FEMA übergeben?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338195
    m_Localized: Sie glauben, dass die FEMA Sie rettet?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338196
    m_Localized: 'Scammer: Aber hallo. Warum auch nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338197
    m_Localized: 'Scammer: Ich glaube, dass wir so überleben können.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338198
    m_Localized: 'Scammer: Harte Zeiten, harte Geschäfte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338199
    m_Localized: 'Scammer: In den Quarantänezonen bei der Herde zu bleiben, ist generell eine schlechte Idee.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338200
    m_Localized: 'Scammer: Also müssen wir uns mit der FEMA gut stellen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338201
    m_Localized: 'Scammer: Nicht aufbegehren, Leute übergeben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338202
    m_Localized: 'Scammer: Vielleicht davon reden, sich testen zu lassen, damit sie wissen, dass ich kein – wie hieß das noch? – Besucher bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338203
    m_Localized: 'Scammer: Das sind gute Leute. Die wissen wahrscheinlich, was zu tun ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338204
    m_Localized: Vielleicht haben Sie recht
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338205
    m_Localized: Klingt bescheuert
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338206
    m_Localized: Wenn Sie unbedingt zu ihnen wollen, gehen Sie doch
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338207
    m_Localized: 'Scammer: Scheiße, Mann. Sie haben wohl den Schuss nicht gehört.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338208
    m_Localized: 'Scammer: Wir müssen uns an diejenigen halten, die den Ton angeben. Das ist die einzig wahre Erfolgsstrategie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338209
    m_Localized: 'Scammer: Also müssen wir uns mit der FEMA gut stellen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338210
    m_Localized: 'Scammer: Nicht aufbegehren, Leute übergeben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338211
    m_Localized: 'Scammer: Vielleicht davon reden, sich testen zu lassen, damit sie wissen, dass ich auf gar keinen Fall einer dieser Besucher bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338212
    m_Localized: 'Scammer: Das sind gute Leute. Die wissen wahrscheinlich, was zu tun ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338213
    m_Localized: Vielleicht haben Sie recht
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338214
    m_Localized: Klingt bescheuert
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338215
    m_Localized: Wenn Sie unbedingt zu ihnen wollen, gehen Sie doch
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338216
    m_Localized: 'Scammer: Natürlich habe ich recht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338217
    m_Localized: 'Scammer: Ich habe einen sechsten Sinn für gute Geschäfte, Freundchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338218
    m_Localized: 'Scammer: Wenn Sie mir vertrauen, können Sie gar nicht verlieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338219
    m_Localized: 'Scammer: Von wegen. SIE sind bescheuert.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338220
    m_Localized: 'Scammer: Früher haben die Leute mich für meine Ratschläge bezahlt. Ihnen gebe ich sie umsonst, und Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338221
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338222
    m_Localized: 'Scammer: Scheiße. Zur Hölle mit Ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338223
    m_Localized: 'Scammer: Wollen Sie mich jetzt rausschmeißen oder was?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338224
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338225
    m_Localized: 'Scammer: Mann, ich dachte wirklich, Sie wären einer von den Guten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338226
    m_Localized: 'Scammer: Sogar ein Geschäft habe ich Ihnen angeboten. Aber Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338227
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338228
    m_Localized: 'Scammer: Sie können zur Hölle fahren, und ich gehe nach Hause.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338229
    m_Localized: 'Scammer: Scheiße, dabei habe ich mir so einen guten Plan ausgedacht. Na ja, was soll’s ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338230
    m_Localized: 'Scammer: Falls Sie Ihre Meinung ändern, sagen Sie mir Bescheid.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338231
    m_Localized: 'Scammer: Hehe. Was gibt’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338232
    m_Localized: Was wollen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338233
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338234
    m_Localized: 'Scammer: Mir ist ein neues Geschäftsmodell eingefallen. Das wird funktionieren. Auf jeden Fall.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338235
    m_Localized: 'Scammer: Also ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338236
    m_Localized: 'Scammer: Die Sonne heizt alles auf wie eine Sauna, richtig?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338237
    m_Localized: 'Scammer: Wenn Sie mich fragen, ist die Ozonschicht hinüber.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338238
    m_Localized: 'Scammer: Aber ich weiß noch, dass Sauerstoff entsteht, wenn das Sonnenlicht durch die Ozonschicht dringt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338239
    m_Localized: 'Scammer: Und wissen Sie, auf welche geniale Idee mich das gebracht hat?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338240
    m_Localized: 'Scammer: LUFT VERKAUFEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338241
    m_Localized: 'Scammer: Wenn das mal kein bombensicheres Geschäft ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338242
    m_Localized: Ein unfassbar genialer Plan
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338243
    m_Localized: Das ist das Dümmste, was ich je gehört habe
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338244
    m_Localized: 'Scammer: Finden Sie wirklich?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338245
    m_Localized: Natürlich, Sie sollten Wissenschaftler werden
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338246
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338247
    m_Localized: 'Scammer: Tja, also ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338248
    m_Localized: 'Scammer: Danke. Endlich jemand, der meine Intelligenz zu schätzen weiß.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338249
    m_Localized: 'Scammer: Sie werden sehen, irgendwann bekomme ich noch einen Darwin Award.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338250
    m_Localized: Sie ... wissen, was ein Darwin Award ist?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338251
    m_Localized: Ja, den haben sie sich redlich verdient
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338252
    m_Localized: 'Scammer: Irgendeine Auszeichnung für wissenschaftliche Verdienste oder so.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338253
    m_Localized: 'Scammer: Was soll die Frage?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338254
    m_Localized: Nur so
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338255
    m_Localized: Darwin Awards sind für Leute, die durch eigene Dummheit sterben
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338256
    m_Localized: 'Scammer: Haha! Ich rieche förmlich schon den wissenschaftlichen Ruhm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338257
    m_Localized: 'Scammer: Jede Menge Kohle, Ansehen, Frauen ... Wie im Traum ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338258
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338259
    m_Localized: 'Scammer: Also gut, wenn diese ganze Geschichte vorbei ist, melde ich ein Patent zum Verkaufen von Luft an.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338260
    m_Localized: 'Scammer: Was Sie nicht sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338261
    m_Localized: 'Scammer: Äh ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338262
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338263
    m_Localized: 'Scammer: Moment mal, machen Sie sich etwa über mich lustig?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338264
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338265
    m_Localized: 'Scammer: Zur Hölle mit Ihnen. Ich denke mir hier Pläne aus, nur um mich von Ihnen veralbern zu lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338266
    m_Localized: 'Scammer: Zur Hölle mit Ihnen. Ich denke mir hier Geschäftsstrategien aus, nur um mich von Ihnen veralbern zu lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338267
    m_Localized: 'Scammer: Irgendwann bekomme ich den Darwin Award und werde steinreich.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338268
    m_Localized: 'Scammer: Dann werden Sie mich auf Knien um Verzeihung bitten ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338269
    m_Localized: Dafür, dass Sie meine Ideen als Schwachsinn abgetan haben.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338270
    m_Localized: 'Scammer: Scheiße, Freundchen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338271
    m_Localized: 'Scammer: Ist es wirklich so schwer, mir zuzuhören?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338272
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532288
    m_Localized: 'Scammer: Egal, scheiß drauf. Ohne Sie verdiene ich sowieso mehr Kohle.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532289
    m_Localized: 'Scammer: Scheiße, Freundchen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532290
    m_Localized: 'Scammer: Zur Hölle mit Ihnen. Ich denke mir hier Geschäftsstrategien aus, nur um mich von Ihnen veralbern zu lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532291
    m_Localized: 'Scammer: Irgendwann bekomme ich den Darwin Award und werde steinreich.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532292
    m_Localized: 'Scammer: Dann werden Sie mich auf Knien um Verzeihung bitten ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532293
    m_Localized: 'Neighbour: Verdammt ... Es stimmt also wirklich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532294
    m_Localized: 'Neighbour: Dann ergibt alles Sinn, was ich gesagt habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532295
    m_Localized: 'Neighbour: Gehen Sie tagsüber nicht nach draußen. Und lassen Sie andere Leute rein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532296
    m_Localized: Warum sollte ich Fremde in mein Haus lassen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532297
    m_Localized: Leute reinlassen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532298
    m_Localized: 'Neighbour: Ich weiß, dass Sie sich die Leute vom Leib halten wollen, aber es geht nicht anders.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532299
    m_Localized: 'Neighbour: Meine Cousine konnte nicht genau sagen, warum wir nicht allein bleiben dürfen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532300
    m_Localized: 'Neighbour: Aber falls jemand fragt, ob man allein ist, soll man sagen, dass noch jemand im Haus ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532301
    m_Localized: Andere Leute stören mich
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532302
    m_Localized: Was habe ich davon, Leute reinzulassen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532303
    m_Localized: 'Neighbour: Ja ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532304
    m_Localized: 'Neighbour: Ich weiß, dass Sie nicht der geselligste Typ sind. Aber Sie müssen sie reinlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532305
    m_Localized: 'Neighbour: Meine Cousine konnte nicht genau sagen, warum wir nicht allein bleiben dürfen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532306
    m_Localized: 'Neighbour: Aber falls jemand fragt, ob man allein ist, soll man sagen, dass noch jemand im Haus ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532307
    m_Localized: Andere Leute stören mich
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532308
    m_Localized: Was habe ich davon, Leute reinzulassen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532309
    m_Localized: 'Neighbour: Ich weiß, dass das für Sie nicht einfach ist, aber Sie haben keine andere Wahl. Sonst überleben wir das nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532310
    m_Localized: 'Neighbour: Vielleicht bringen sie irgendwelche Dinge mit oder haben Ihnen etwas Interessantes zu erzählen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532311
    m_Localized: 'Neighbour: Testen Sie sie unbedingt auf Anzeichen für Besucher. Bei dieser Hitze werden Sie tagsüber nicht viel Energie haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532312
    m_Localized: 'Neighbour: Überlegen Sie sich also gut, wen Sie testen wollen. Die Tests sind anstrengend. Sie müssen wirklich gründlich sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532313
    m_Localized: 'Neighbour: Aber keine Sorge wegen der Gespräche. Die kosten Sie KEINE Energie. Sprechen Sie also mit ihnen, so viel Sie wollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532314
    m_Localized: 'Neighbour: Und sehen Sie aus den Fenstern. Der Fernseher ist nützlich, aber dort erfahren Sie nicht, was um Sie herum passiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532315
    m_Localized: Und dann?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532316
    m_Localized: Was müssen wir tun?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532317
    m_Localized: 'Neighbour: Vielleicht bringen sie irgendwelche Dinge mit oder haben Ihnen etwas Interessantes zu erzählen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532318
    m_Localized: 'Neighbour: Testen Sie sie unbedingt auf Anzeichen für Besucher. Bei dieser Hitze werden Sie tagsüber nicht viel Energie haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532319
    m_Localized: 'Neighbour: Überlegen Sie sich also gut, wen Sie testen wollen. Die Tests sind anstrengend. Sie müssen wirklich gründlich sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532320
    m_Localized: 'Neighbour: Aber keine Sorge wegen der Gespräche. Die kosten Sie KEINE Energie. Sprechen Sie also mit ihnen, so viel Sie wollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532321
    m_Localized: 'Neighbour: Und sehen Sie aus den Fenstern. Der Fernseher ist nützlich, aber dort erfahren Sie nicht, was um Sie herum passiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532322
    m_Localized: Und dann?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532323
    m_Localized: Was müssen wir tun?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532324
    m_Localized: 'Neighbour: Ich fürchte, wir können nur versuchen zu überleben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532325
    m_Localized: 'Neighbour: Und hoffen, dass dieser Albtraum bald vorbei ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532326
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532327
    m_Localized: 'Neighbour: Ich glaube, die Regierung wird uns irgendwie helfen. Vielleicht bringen sie alle in einen Schutzbunker oder so.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532328
    m_Localized: 'Neighbour: Falls sie das tun, bleiben Sie bei meiner Familie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532329
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532330
    m_Localized: 'Neighbour: Oh, fast hätte ich es vergessen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532331
    m_Localized: 'Neighbour: Ich gehe morgen Abend wieder nach Hause. Ich gebe Ihnen meine Nummer, damit Sie mich anrufen können.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532332
    m_Localized: 'Neighbour: Wir haben den Telefonanschluss erst seit Kurzem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532333
    m_Localized: 'Neighbour: XXX-XXX-XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532334
    m_Localized: 'Neighbour: Wir bleiben über das Telefon in Kontakt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532335
    m_Localized: 'Neighbour: Gut, das war jetzt wirklich alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532336
    m_Localized: 'Neighbour: Ich habe Ihnen übrigens einen Kasten Bier mitgebracht. Mein Schwager arbeitet in einer Brauerei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532337
    m_Localized: 'Neighbour: Trinken Sie das Bier vor dem Schlafengehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532338
    m_Localized: 'Neighbour: Es macht Sie müde. Wenn Sie mit niemandem mehr sprechen wollen, trinken Sie ein Bier und entspannen Sie sich.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532339
    m_Localized: 'Daughter: Ich ... Ich w-will zu meiner M-Mama.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532340
    m_Localized: Erzähl mir, was passiert ist
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532341
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532342
    m_Localized: 'Daughter: Weiß ich nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532343
    m_Localized: 'Daughter: Sie sind reingekommen und haben geredet. Papa hat gesagt, dass es falsch ist, und sie ... sie haben gesagt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532344
    m_Localized: 'Daughter: PAPA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532345
    m_Localized: 'Daughter: PAPAAAAA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532346
    m_Localized: Ruh dich aus
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532347
    m_Localized: Wir reden morgen weiter, ja?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532348
    m_Localized: 'Daughter: (Das Mädchen ruft ununterbrochen nach seinem Vater und ein Ende der Hysterie ist nicht in Sicht.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532349
    m_Localized: 'Daughter: (Das Mädchen hört dir gar nicht zu und ist allein in seiner Trauer versunken.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532350
    m_Localized: 'Daughter: Ich ... Ich w-will zu meiner M-Mama.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532351
    m_Localized: Gefällt es dir hier?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532352
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532353
    m_Localized: 'Daughter: Geht so.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532354
    m_Localized: 'Daughter: Ich will lieber nach Hause ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532355
    m_Localized: 'Daughter: Wann darf ich nach Hause?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532356
    m_Localized: Später, euer Haus wird noch renoviert
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532357
    m_Localized: Erst mal nicht, euer Haus ist abgebrannt
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532358
    m_Localized: 'Daughter: Also holen sie mich bald ab?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532359
    m_Localized: 'Daughter: Und bringen mich zu einem neuen Haus?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532360
    m_Localized: 'Daughter: Oder zum selben?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532361
    m_Localized: 'Daughter: Machen sie mir ein neues Zimmer?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532362
    m_Localized: 'Daughter: Papa kommt mich doch abholen, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532363
    m_Localized: Du weißt doch, was passiert ist
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532364
    m_Localized: Du solltest fürs Erste hierbleiben
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532365
    m_Localized: 'Daughter: Aber Papa geht es gut?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532366
    m_Localized: 'Daughter: Was ist mit meinem Zimmer? Ist das auch abgebrannt?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532367
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532368
    m_Localized: 'Daughter: Mama kommt nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532369
    m_Localized: 'Daughter: Ist sonst noch jemand da?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532370
    m_Localized: Du weißt doch, was passiert ist
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532371
    m_Localized: Du solltest fürs Erste hierbleiben
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532372
    m_Localized: 'Daughter: Ich weiß nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532373
    m_Localized: 'Daughter: Ich bin mir nicht sicher.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532374
    m_Localized: 'Daughter: Sie haben Papa gehauen, aber dann ist er aufgestanden. Ich hab’s gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532375
    m_Localized: 'Daughter: Das heißt ... Das heißt, er kann das Feuer löschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532376
    m_Localized: 'Daughter: Oder mich besuchen kommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532377
    m_Localized: 'Daughter: Kommt er bald?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532378
    m_Localized: 'Daughter: Ohne Papa gehe ich nirgendwohin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532379
    m_Localized: 'Daughter: Er kommt doch zu mir, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532380
    m_Localized: 'Daughter: Ich hab gesehen, wie er aufgestanden und gegangen ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532381
    m_Localized: 'Daughter: Ich bin gerannt, aber ich hab ihn gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532382
    m_Localized: 'Daughter: Ich ... Ich w-will zu meiner M-Mama.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532383
    m_Localized: Du musst akzeptieren, was passiert ist
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532384
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532385
    m_Localized: 'Daughter: Was meinst du damit?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532386
    m_Localized: 'Daughter: Ich hab in deinem Zimmer einen Fernseher gesehen. Darf ich Zeichentrickfilme gucken?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532387
    m_Localized: Ich weiß nicht, was du gesehen hast, aber ich glaube, dein Vater ist tot
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532388
    m_Localized: Dein Vater kommt vielleicht nicht, ich weiß nicht, was mit ihm passiert ist
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532389
    m_Localized: 'Daughter: Du hast gar nichts gesehen!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532390
    m_Localized: 'Daughter: Ich war dabei! Er hat sich bewegt, als ich gerannt bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532391
    m_Localized: 'Daughter: Das heißt, dass er bald kommt!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532392
    m_Localized: Warum ist er noch nicht gekommen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532393
    m_Localized: Wie sah er aus, als du ihn zuletzt gesehen hast?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532394
    m_Localized: 'Daughter: Er kommt nicht? Warum sagst du so was?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532395
    m_Localized: Warum ist er noch nicht gekommen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532396
    m_Localized: Wie sah er aus, als du ihn zuletzt gesehen hast?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532397
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532398
    m_Localized: 'Daughter: Vielleicht hatte er noch was zu erledigen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532399
    m_Localized: 'Daughter: Er wollte noch die bösen Leute verhauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532400
    m_Localized: 'Daughter: Er ... Er ist bestimmt bald hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532401
    m_Localized: Tut mir leid, dein Vater war ein guter Mann, aber zu freundlich
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532402
    m_Localized: Wie du meinst, dein Vater kommt wahrscheinlich bald
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532403
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532404
    m_Localized: 'Daughter: Er hat gut ausgesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532405
    m_Localized: 'Daughter: Sie haben ihn gehauen ... also ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532406
    m_Localized: 'Daughter: Ich kann mich nicht erinnern.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532407
    m_Localized: Tut mir leid, dein Vater war ein guter Mann, aber zu freundlich
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532408
    m_Localized: Wie du meinst, dein Vater kommt wahrscheinlich bald
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532409
    m_Localized: 'Daughter: (Das Mädchen scheint durch dich hindurchzusehen. Du hast Angst, dich zu bewegen, also wartest du ab, was passiert.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532410
    m_Localized: 'Daughter: (Kurze Zeit später fängt sie an zu weinen. Es sieht so aus, als könntest du nichts tun.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532411
    m_Localized: 'Daughter: (Es wäre noch schlimmer, sie an eine Lüge glauben zu lassen. Sie muss die Situation so schnell wie möglich akzeptieren.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532412
    m_Localized: 'Daughter: Das habe ich mir gedacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532413
    m_Localized: 'Daughter: (Du bemerkst, dass das Mädchen in sich versunken ist und offenbar über irgendetwas nachdenkt.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532414
    m_Localized: 'Daughter: (Aber ist es das wert, ihre Kindheit zu zerstören? Kann sie diesen Schlag verkraften?)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532415
    m_Localized: 'Daughter: (Du beschließt, dass sie im Moment genug Probleme hat. Es gibt keinen Grund, das Kind zu beunruhigen.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532416
    m_Localized: 'NotTrue: Ach, ich werde langsam alt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532417
    m_Localized: Woher kommen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532418
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532419
    m_Localized: 'NotTrue: Ja. Was gibt es daran auszusetzen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532420
    m_Localized: 'NotTrue: Die Leute hören sich meine Geschichten an und dann hassen sie mich dafür.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532421
    m_Localized: 'NotTrue: Können Sie sich das vorstellen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532422
    m_Localized: 'NotTrue: Ich habe ein Haus. Eine Hütte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532423
    m_Localized: 'NotTrue: Es gefällt mir dort, aber ohne Gesellschaft gehe ich ein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532424
    m_Localized: 'NotTrue: Und wer will schon in meine Hütte kommen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532425
    m_Localized: 'NotTrue: Also zieh ich umher. Ich habe nichts zu verlieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532426
    m_Localized: 'NotTrue: Ach, ich werde langsam alt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532427
    m_Localized: Warum haben Sie keine Verwandten?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532428
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532429
    m_Localized: 'NotTrue: Ganz gewöhnliche. Überall, wo ich bin, sammle ich Geschichten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532430
    m_Localized: 'NotTrue: Und dann erzähle ich sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532431
    m_Localized: 'NotTrue: Ich bin schon alt und kann mir die Geschichten nicht gut merken. Ich erzähle sie später auf meine eigene Art.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532432
    m_Localized: 'NotTrue: Vielleicht hassen sie mich deswegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532433
    m_Localized: 'NotTrue: Wie heißt es so schön: „Die Trauer selbst ist leichter zu ertragen als die Erwartung von Trauer.“'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532434
    m_Localized: 'NotTrue: Aber ich bin nicht die Einzige, die Geschichten ausschmückt, verstehen Sie? Hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532435
    m_Localized: 'NotTrue: Alle kommen zu mir. Früher oder später.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532436
    m_Localized: 'NotTrue: Jeder braucht Geschichten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532437
    m_Localized: 'NotTrue: Ach, ich werde langsam alt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532438
    m_Localized: Warum ist Ihr Mann nicht bei Ihnen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532439
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532440
    m_Localized: 'NotTrue: Was soll ich Ihnen erzählen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532441
    m_Localized: 'NotTrue: Menschen sind ängstliche Wesen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532442
    m_Localized: 'NotTrue: Ich kannte einmal einen Mann, der sich von allen anderen fernhielt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532443
    m_Localized: 'NotTrue: Er wohnte in einem Hochhaus, schloss sich in seiner Wohnung ein und ging kaum jemals nach draußen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532444
    m_Localized: 'NotTrue: Er hatte Angst vor den Besuchern oder vor dem Tod.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532445
    m_Localized: 'NotTrue: Niemand kam ihn jemals besuchen. Er hätte sowieso niemanden hereingelassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532446
    m_Localized: 'NotTrue: Nun ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532447
    m_Localized: 'NotTrue: Ich hörte dieses Geräusch. BUMM.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532448
    m_Localized: 'NotTrue: Zuerst konnte ich mir keinen Reim darauf machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532449
    m_Localized: 'NotTrue: Dann sah ich aus dem Fenster. Er war gesprungen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532450
    m_Localized: 'NotTrue: Er konnte einfach nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532451
    m_Localized: 'NotTrue: Hat Ihnen die Geschichte gefallen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532452
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532453
    m_Localized: Ist das alles?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532454
    m_Localized: 'NotTrue: Wahrscheinlich mag mich deswegen niemand.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532455
    m_Localized: 'NotTrue: Aber das macht nichts. Irgendwann erzähle ich auch Ihre Geschichte so, wie ich sie in Erinnerung habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532456
    m_Localized: 'NotTrue: Ja. Der Mann war mausetot.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532457
    m_Localized: 'NotTrue: Entweder hatte er Angst vor einem qualvollen Tod durch die Sonne, oder es war irgendetwas anderes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532458
    m_Localized: 'NotTrue: Ich glaube, sein Herz hat die Einsamkeit nicht mehr ausgehalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532459
    m_Localized: 'NotTrue: Aber was soll man machen?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532460
    m_Localized: 'NotTrue: Ach, ich werde langsam alt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532461
    m_Localized: Wie war es, auf der Bank zu sitzen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532462
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532463
    m_Localized: 'NotTrue: Nichts lieber als das.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532464
    m_Localized: 'NotTrue: Als ich im Dorf wohnte, gab es dort diesen einen Mann.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532465
    m_Localized: 'NotTrue: Er liebte es, im Wald spazieren zu gehen. Ich weiß nicht, warum.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532466
    m_Localized: 'NotTrue: Eines Tages lief er durch den Wald und merkte, dass er sich verirrt hatte. Er konnte den Rückweg nicht mehr finden.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532467
    m_Localized: 'NotTrue: Er dachte nach und beschloss, immer geradeaus zu laufen, bis er irgendwo ankommen würde.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532468
    m_Localized: 'NotTrue: Er lief und lief, aber er fand einfach keinen Weg aus dem Wald.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532469
    m_Localized: 'NotTrue: Dann wurde ihm klar, dass er im Kreis lief.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532470
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532471
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532472
    m_Localized: Und dann?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532473
    m_Localized: Das ist albern
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532474
    m_Localized: 'NotTrue: Er wurde tot aufgefunden. Er hat es nie aus dem Wald geschafft.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532475
    m_Localized: 'NotTrue: Wir folgten seinen Fußspuren und stellten fest, dass er immer nur im Kreis gelaufen war.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532476
    m_Localized: 'NotTrue: Das eine Bein macht eben größere Schritte als das andere.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532477
    m_Localized: 'NotTrue: Ja, so war das.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532478
    m_Localized: 'NotTrue: Warum? Gefällt Ihnen die Geschichte nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532479
    m_Localized: 'NotTrue: Ich habe sie natürlich ein bisschen ausgeschmückt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532480
    m_Localized: 'NotTrue: Aber sie ist wirklich passiert. Und sie passiert immer wieder.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532481
    m_Localized: 'NotTrue: Die Leute verlaufen sich und finden keinen Ausweg.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532482
    m_Localized: 'Alkonost: Ich muss nur wieder zu Kräften kommen. Ich wünschte, jemand könnte mir dabei helfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532483
    m_Localized: Wie geht es deiner Schwester?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532484
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532485
    m_Localized: 'Alkonost: Ich muss ihr helfen. In vielerlei Hinsicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532486
    m_Localized: 'Alkonost: Gestern habe ich es geschafft, sie zu baden. Zu Hause kam sie nicht einmal in die Badewanne.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532487
    m_Localized: 'Alkonost: Bisher ist alles unverändert. Aber danke der Nachfrage.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532488
    m_Localized: 'Alkonost: Leute mit Depressionen sind wirklich ... kompliziert.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532489
    m_Localized: 'Alkonost: Ich habe Angst, dass wir jeden Moment wegrennen müssen und sie sich nicht dazu überwinden kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532490
    m_Localized: 'Alkonost: Oder dass sie nichts essen kann, weil sie keine Kraft mehr dazu hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532491
    m_Localized: 'Alkonost: Ich bin auch erschöpft. Ich ruhe mich ein wenig aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532492
    m_Localized: 'Alkonost: Ich muss nur wieder zu Kräften kommen. Ich wünschte, jemand könnte mir dabei helfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532493
    m_Localized: Was hast du jetzt vor?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532494
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532495
    m_Localized: 'Alkonost: Gute Frage.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532496
    m_Localized: 'Alkonost: Mein Mann sollte uns bald abholen. Ich hoffe, er findet einen sicheren Ort.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532497
    m_Localized: 'Alkonost: Irgendwo, wo wir den Angriff der Besucher und die Hitze der Sonne aussitzen können.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532498
    m_Localized: 'Alkonost: Er hat gesagt, dass es solche Orte gibt. Und dass die Sonne gar nicht explodieren kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532499
    m_Localized: 'Alkonost: Falls es wirklich passieren sollte, würden wir in weniger als 10 Minuten ausgelöscht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532500
    m_Localized: 'Alkonost: Ich glaube, er hat recht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532501
    m_Localized: 'Alkonost: Ich muss nur wieder zu Kräften kommen. Ich wünschte, jemand könnte mir dabei helfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532502
    m_Localized: Irgendwas Neues von deinem Mann?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532503
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532504
    m_Localized: 'Alkonost: Aus irgendeinem Grund meldet er sich nicht bei mir. Er ruft nicht an und kommt uns nicht abholen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532505
    m_Localized: 'Alkonost: Ihm wird doch nichts zugestoßen sein? Vielleicht hat er sich irgendwo Ärger eingehandelt?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532506
    m_Localized: 'Alkonost: Ich weiß nur, dass er uns nicht absichtlich im Stich lässt. Das ist völlig ausgeschlossen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532507
    m_Localized: 'Alkonost: Selbst, als er von meiner Schwester die Nase voll hatte, hat er mir trotzdem mit ihr geholfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532508
    m_Localized: 'Alkonost: Wahrscheinlich ... ist er schon unterwegs.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532509
    m_Localized: 'Alkonost: Und meiner Schwester geht es schon ein bisschen besser ... Er kommt ganz bestimmt. Und alles wird gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532510
    m_Localized: 'Alkonost: Ich muss nur wieder zu Kräften kommen. Ich wünschte, jemand könnte mir dabei helfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532511
    m_Localized: Du wirkst melancholisch
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532512
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532513
    m_Localized: 'Alkonost: Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532514
    m_Localized: 'Alkonost: Oh. Kann sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532515
    m_Localized: 'Alkonost: Ich muss über vieles nachdenken.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532516
    m_Localized: 'Alkonost: Wenn die Sonne nicht explodiert, warum lässt die Hitze dann nicht nach? Warum reden alle nur vom Weltuntergang?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532517
    m_Localized: 'Alkonost: Ich habe die Nachrichten gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532518
    m_Localized: 'Alkonost: Sie sagen es nicht direkt, aber anscheinend wird es tagsüber immer heißer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532519
    m_Localized: 'Alkonost: Das Klima verändert sich. Tiere sterben, weil sie sich nicht an das neue ... Wetter anpassen können.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532520
    m_Localized: 'Alkonost: Was wird mit uns passieren?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532521
    m_Localized: 'Alkonost: Ich muss nur wieder zu Kräften kommen. Ich wünschte, jemand könnte mir dabei helfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532522
    m_Localized: Wie geht es dir?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532523
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532524
    m_Localized: 'Alkonost: Letzte Nacht war ich draußen. Ich wollte meinen Mann finden.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532525
    m_Localized: 'Alkonost: Ich bin zu ein paar Orten gegangen, wo er vielleicht sein könnte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532526
    m_Localized: 'Alkonost: An einem davon habe ich ihn gefunden. Er hatte eine Tablette genommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532527
    m_Localized: 'Alkonost: Wir ... Wir haben welche gekauft. Für den Fall der Fälle.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532528
    m_Localized: 'Alkonost: Er hat eine genommen. Er hatte Angst. Er hat mich nicht mitgenommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532529
    m_Localized: 'Alkonost: Er hat sie genommen. Die Tablette. Und kein Wort über die Sonne.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532530
    m_Localized: 'Sirin: Das ist das Ende.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532531
    m_Localized: Wie geht es dir?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532532
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532533
    m_Localized: 'Sirin: Ich fühle mich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532534
    m_Localized: 'Sirin: Als wäre ich unter einer schweren Decke.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532535
    m_Localized: 'Sirin: Sie erdrückt meinen Körper.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532536
    m_Localized: 'Sirin: Ich ... will nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532537
    m_Localized: 'Sirin: Das ist das Ende.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532538
    m_Localized: Du wirkst heute besser gelaunt
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532539
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532540
    m_Localized: 'Sirin: Ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532541
    m_Localized: 'Sirin: Hast du von der Sonne gehört? Dass sie explodiert?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532542
    m_Localized: 'Sirin: Ich weiß erst seit heute davon.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532543
    m_Localized: 'Sirin: Heißt das, die Welt geht unter?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532544
    m_Localized: 'Sirin: Und keine Spur unserer Existenz bleibt zurück?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532545
    m_Localized: 'Sirin: Ein interessanter Gedanke.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532546
    m_Localized: 'Sirin: Das ist das Ende.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532547
    m_Localized: Wie geht es deiner Schwester?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532548
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532549
    m_Localized: 'Sirin: Sie hat Angst, alles zu verlieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532550
    m_Localized: 'Sirin: Ich glaube, wir haben gar nichts zu verlieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532551
    m_Localized: 'Sirin: Das Universum dehnt sich unaufhaltsam aus und wir sind nur kleine Staubkörner.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532552
    m_Localized: 'Sirin: Niemand braucht uns, weil es sonst gar niemanden gibt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532553
    m_Localized: 'Sirin: Wenn der Planet verschwindet, wird keiner um uns trauern. Und das ist auch in Ordnung so.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532554
    m_Localized: 'Sirin: Aber meiner Schwester macht das Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532555
    m_Localized: 'Sirin: Das ist das Ende.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532556
    m_Localized: Ist deine Schwester krank?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532557
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532558
    m_Localized: 'Sirin: Ja. Sie wollte ihren Mann suchen, um sich von ihren schlechten Gedanken abzulenken.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532559
    m_Localized: 'Sirin: Ich halte das für keine gute Idee. Aber sie kann nicht einfach nur rumsitzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532560
    m_Localized: 'Sirin: Wenn sie weiter nach ihm suchen will, muss ich auch gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532561
    m_Localized: 'Sirin: Ich will sie nicht verlieren, bevor wir alle sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532562
    m_Localized: 'Sirin: Das ist das Ende.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532563
    m_Localized: Wart ihr draußen?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532564
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532565
    m_Localized: 'Sirin: Ja. Sie hat die Leiche ihres Mannes gefunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532566
    m_Localized: 'Sirin: Er hat ihr erzählt, dass alles gut wird, und dann hat er sich aus Angst vor der Wahrheit umgebracht.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532567
    m_Localized: 'Sirin: Ich glaube, das hat sie ihre letzte Kraft gekostet.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726592
    m_Localized: 'Sirin: Jetzt muss ich mich um sie kümmern, bis wir alle sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726593
    m_Localized: 'Sirin: Dann gibt es endlich nichts mehr, wovor man Angst haben oder wofür man sich schämen müsste.'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166080
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166081
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166082
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166083
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166084
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166085
    m_Localized: 'Alkonost: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166086
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166087
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166088
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166089
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166090
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166091
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360384
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360385
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360386
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360387
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083328
    m_Localized: 'Firefighter: Verdammt ... *hust*'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083329
    m_Localized: 'Firefighter: Hey, Kumpel ... Falls es nicht zu viele Umstände macht ... könnten Sie sie anrufen? {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083330
    m_Localized: .
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083331
    m_Localized: 'Firefighter: Ich will gar nicht, dass sie mich abholen ... oder mich von ihnen verabschieden ... Sagen Sie ihnen einfach ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083332
    m_Localized: 'Firefighter: Sagen Sie ihnen, dass Papa nicht weggerannt ist. Er ist einfach nur ... geblieben, wo er gebraucht wurde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083333
    m_Localized: 'Firefighter: *hust, hust* Alles andere ist egal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083334
    m_Localized: 'Theorist: Ja, bitte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083335
    m_Localized: Was sind das für Papiere?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083336
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083337
    m_Localized: 'Theorist: Sie würden nicht glauben, was in diesen Akten steht. Manches davon ist wirklich ... faszinierend.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083338
    m_Localized: 'Theorist: Hier zum Beispiel. Eine besonders kuriose Theorie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083339
    m_Localized: 'Theorist: Sie besagt, dass es überhaupt keine Besucher gibt. Dahinter steckt nur ein Plan der Regierung gegen die Überbevölkerung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083340
    m_Localized: 'Theorist: Eine ziemlich fesselnde Lektüre ... Und interessanterweise ergibt sie auch noch Sinn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083341
    m_Localized: 'Theorist: Überbevölkerung ist nach wie vor ein Problem, ob es uns gefällt oder nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083342
    m_Localized: 'Theorist: Vielleicht ist das ihre Art, es „aus der Welt zu schaffen“.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083343
    m_Localized: 'Theorist: Ja, bitte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083344
    m_Localized: Gehen Sie immer noch Ihre Papiere durch?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083345
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083346
    m_Localized: 'Theorist: Genau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083347
    m_Localized: 'Theorist: Ich habe noch jede Menge davon, falls Sie Interesse haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083348
    m_Localized: 'Theorist: Hier, sehen Sie sich das hier an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083349
    m_Localized: 'Theorist: Stellen Sie sich vor: Die FEMA-Mitarbeiter *sind* die Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083350
    m_Localized: 'Theorist: Ihre Anzüge verhüllen ihre ganzen Körper. Man kann sie unmöglich testen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083351
    m_Localized: 'Theorist: Faszinierend. Besonders gefällt mir die Theorie, wofür FEMA angeblich steht: „Facility for Eradicating Mankind Altogether“.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083352
    m_Localized: 'Theorist: Oder war es etwas anderes ...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083353
    m_Localized: 'Theorist: Ja, bitte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083354
    m_Localized: Was haben Sie diesmal aufgedeckt?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083355
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083356
    m_Localized: 'Theorist: Besucher: Hautwandler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083357
    m_Localized: 'Theorist: Klingt wie aus einem Science-Fiction-Roman, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083358
    m_Localized: 'Theorist: Aber da steckt ein wahrer Kern drin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083359
    m_Localized: 'Theorist: In einem Bericht wird ein bleicher Mann erwähnt, der auf den Straßen gesichtet wurde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083360
    m_Localized: 'Theorist: Wobei ich hinzufügen muss ... dass der Autor einen offensichtlichen Fehler gemacht hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083361
    m_Localized: 'Theorist: Er schreibt von ZWEI bleichen, unheimlichen Gestalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083362
    m_Localized: 'Theorist: Eine war durchs Fenster zu sehen, die andere stand vor der Tür.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083363
    m_Localized: 'Theorist: Also wirklich. Ist es nicht offensichtlich, dass es sich um ein und dieselbe Gestalt handelt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083364
    m_Localized: "Theorist: Ich schätze, das Fenster hat die Sicht verzerrt. Dadurch erschien das Gesicht verändert.\nEin Wahrnehmungsfehler."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083365
    m_Localized: 'Theorist: Aber trotzdem unterhaltsam zu lesen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083366
    m_Localized: 'Theorist: Ja, bitte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083367
    m_Localized: Was, wenn es wahr ist?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083368
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083369
    m_Localized: 'Theorist: Was ist denn überhaupt Wahrheit? Ein fließendes Konzept, eine Frage der Perspektive.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083370
    m_Localized: 'Theorist: Was für den einen die Wahrheit ist, ist für den anderen eine Täuschung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083371
    m_Localized: 'Theorist: Was dem einen gut erscheint, ist für den anderen böse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083372
    m_Localized: 'Theorist: Die Menschheit hat schon immer darüber gestritten. Und heutzutage weiß sowieso niemand mehr, was richtig ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083373
    m_Localized: 'Theorist: Wenn Sie einen starken Glauben haben, so wie ich, wird er zu Ihrer Wahrheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083374
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083375
    m_Localized: 'Theorist: Hmm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083376
    m_Localized: 'Theorist: Faszinierender Artikel. Worüber haben wir noch gleich geredet? Ach ja, die Wahrheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083377
    m_Localized: 'Theorist: Passen Sie gut auf. Es gibt nur eine Wahrheit: die Besucher sind Gehirnparasiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083378
    m_Localized: 'Theorist: Benutzen Sie Ohrenstöpsel. Rund um die Uhr. Dann wird alles gut!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083379
    m_Localized: 'Theorist: Ich habe jedenfalls noch viel zu lesen. Lenken Sie mich bitte nicht ab. Ich muss mich konzentrieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083380
    m_Localized: 'Wifefema: Was gibt’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083381
    m_Localized: Sie haben beim Zoll gearbeitet?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083382
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083383
    m_Localized: 'Wifefema: Ja, hab ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083384
    m_Localized: 'Wifefema: Haben Sie schon mal andere auf Merkmale von Besuchern getestet?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083385
    m_Localized: 'Wifefema: Das Ganze ist doch total bescheuert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083386
    m_Localized: 'Wifefema: Wie kommt man überhaupt auf die Idee, diese Freaks „Besucher“ zu nennen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083387
    m_Localized: 'Wifefema: Als ob es keinen passenderen Namen gibt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083388
    m_Localized: 'Wifefema: Was gibt’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083389
    m_Localized: Warum hassen Sie die Besucher?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083390
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083391
    m_Localized: 'Wifefema: Was soll die dumme Frage?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083392
    m_Localized: 'Wifefema: Weil wegen denen alles vor die Hunde geht! Sehen Sie keine Nachrichten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083393
    m_Localized: 'Wifefema: Die Sonne explodiert und die Leute verrecken auf der Straße. Alles wegen denen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083394
    m_Localized: 'Wifefema: Ich schwöre bei Gott, ich würde jeden Einzelnen von ihnen umlegen, wenn ich könnte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083395
    m_Localized: 'Wifefema: Aber irgendwann erwische ich sie alle, wie damals an der Grenze. Sie werden schon sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083396
    m_Localized: 'Wifefema: Wenn die FEMA mir nur einen Job geben würde ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083397
    m_Localized: 'Wifefema: Was gibt’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083398
    m_Localized: Warum wollen Sie unbedingt bei der FEMA arbeiten?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083399
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083400
    m_Localized: 'Wifefema: Weil mir nicht alles scheißegal ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083401
    m_Localized: 'Wifefema: Irgendjemand muss diesen Besuchern das Handwerk legen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083402
    m_Localized: 'Wifefema: Ich hab sogar unseren Nachbarn verpfiffen. Und zwar zu Recht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083403
    m_Localized: 'Wifefema: Und was tun die? Stellen meinen Mann ein! Aber mich nicht!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083404
    m_Localized: 'Wifefema: Verstehen Sie mich nicht falsch: Ich bin wirklich stolz auf meinen Mann, aber ich bitte Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083405
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083406
    m_Localized: 'Wifefema: Ernsthaft? Das ist wie ein Schlag ins Gesicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083407
    m_Localized: 'Wifefema: Was gibt’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083408
    m_Localized: Warum haben Sie Ihren Nachbarn verraten?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083409
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083410
    m_Localized: 'Wifefema: Ich sag’s Ihnen, wie es ist: Er war ein Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083411
    m_Localized: 'Wifefema: Und er war mir verdammt unheimlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083412
    m_Localized: 'Wifefema: Ganz ehrlich, es fühlt sich richtig gut an, ihn verraten zu haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083413
    m_Localized: 'Wifefema: Das hat mich an die guten alten Zeiten beim Zoll erinnert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083414
    m_Localized: 'Wifefema: Und dann wurde mir klar, dass ich unbedingt zur FEMA muss!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083415
    m_Localized: 'Wifefema: Was gibt’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083416
    m_Localized: Sie sind nicht wegen Ihres Mannes, sondern wegen der FEMA hier, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083417
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083418
    m_Localized: 'Wifefema: Na und?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083419
    m_Localized: 'Wifefema: Ja, ich bin hier, um ordentlich Rabatz zu machen, bis jemand von den hohen Tieren zuhört.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083420
    m_Localized: 'Wifefema: Ich will gegen diese Absage vorgehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083421
    m_Localized: 'Wifefema: Das ist doch Mist! Ich erwische einen Besucher, tue meine verdammte Bürgerpflicht, und die geben IHM den Job?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083422
    m_Localized: 'Wifefema: Gott im Himmel, ich versteh das nicht. Was für ein Schwachsinn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083423
    m_Localized: 'Wifefema: Ich hasse diesen Mann. Aus tiefstem Herzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083424
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083425
    m_Localized: 'Wifefema: Hey, Sie können mir einen Gefallen tun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083426
    m_Localized: 'Wifefema: Rufen Sie sie an, ja? Nehmen Sie die interne Leitung, das ist eine spezielle Nummer: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083427
    m_Localized: 'Wifefema: Sagen Sie, dass Sie jemanden getroffen haben. Eine Frau mit Erfahrung und Mumm. Die ihnen sogar einen neuen Mitarbeiter verschafft hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083428
    m_Localized: 'Wifefema: Tragen Sie ruhig dick auf. Legen Sie ein gutes Wort für mich ein, dann lassen sie mich vielleicht endlich was tun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083429
    m_Localized: 'Wifefema: Was gibt’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083430
    m_Localized: Beim Zoll hatten Sie wenigstens ein bisschen Macht, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083431
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083432
    m_Localized: 'Wifefema: Ach, kommen Sie runter von Ihrem hohen Ross.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083433
    m_Localized: 'Wifefema: Ich hab Sie nicht um Ihre Meinung gebeten. Sie sind nicht besser als ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083434
    m_Localized: 'Wifefema: Sie wollen den Ton angeben, oder? Das ist Ihr Haus und die Leute kommen zu Ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083435
    m_Localized: 'Wifefema: Sie haben hier das Sagen und entscheiden, wer ein Besucher ist und wer nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083436
    m_Localized: 'Wifefema: Aber das ist nicht Ihr verdammter Job. Dafür ist die FEMA zuständig. Sie haben kein Recht, sich als Richter aufzuspielen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083437
    m_Localized: 'Wifefema: Warum halten Sie sich für besser als die FEMA? Die haben wenigstens die nötige Autorität.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083438
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083439
    m_Localized: 'Wifefema: Das dachte ich mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083440
    m_Localized: 'Raskolnikov: Ich ... Ich hoffe, dass ich das Töten lernen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083441
    m_Localized: Wollen Sie immer noch sehen, wie ich die Besucher töte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083442
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083443
    m_Localized: 'Raskolnikov: Ehrlich gesagt ... Ich habe meine Meinung geändert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083444
    m_Localized: 'Raskolnikov: Ja, ich hatte Angst. Ich weiß. E-Es tut mir leid. Aber mir ist klar geworden, dass ich noch nicht bereit bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083445
    m_Localized: 'Raskolnikov: Mir wird immer noch schlecht, wenn ich Leichen sehe. Es wird dauern, bis ich das überwinde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083446
    m_Localized: 'Raskolnikov: Aber ... Besucher ... Ich habe gehört, dass ihre Körper sich noch bewegen, wenn sie tot sind. Wie bei diesem Mann ... in der Gasse ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083447
    m_Localized: 'Raskolnikov: Verdammt, ich darf jetzt nicht daran denken. Ich bin noch nicht so weit ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083448
    m_Localized: 'Raskolnikov: Ich ... Ich hoffe, dass ich das Töten lernen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083449
    m_Localized: Was ist in der Gasse passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083450
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083451
    m_Localized: 'Raskolnikov: Es ... fällt mir schwer, darüber zu reden. Aber ich werd’s versuchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083452
    m_Localized: 'Raskolnikov: Ich dachte, in den Gassen wäre es sicherer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083453
    m_Localized: 'Raskolnikov: Aber als ich um die Ecke ging, war es, als wäre ich auf einem Friedhof gelandet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083454
    m_Localized: 'Raskolnikov: Dutzende Leichen lagen einfach am Boden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083455
    m_Localized: 'Raskolnikov: Manche haben sich noch bewegt. Als ob sie noch nicht richtig tot waren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083456
    m_Localized: 'Raskolnikov: Und am Ende der Gasse war ein Mann mit einer Pistole, und er ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083457
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083458
    m_Localized: 'Raskolnikov: Nein ... Das reicht. Ich will nicht mehr daran denken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083459
    m_Localized: 'Raskolnikov: Ich ... Ich hoffe, dass ich das Töten lernen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083460
    m_Localized: Wer war der Mann am Ende der Gasse?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083461
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083462
    m_Localized: 'Raskolnikov: Das war ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083463
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083464
    m_Localized: 'Raskolnikov: Ein Mann in einem Mantel, der mit Fingern und Zähnen bedeckt war ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083465
    m_Localized: 'Raskolnikov: Neben ihm war ein junger Kerl. Völlig hilflos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083466
    m_Localized: 'Raskolnikov: Der Mann im Mantel schrie ihn an, mit vorgehaltener Waffe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083467
    m_Localized: 'Raskolnikov: Er wollte seine Zähne sehen. Und der Junge bettelte um Gnade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083468
    m_Localized: 'Raskolnikov: Ich versteckte mich hinter einer Mülltonne ... und dann ... Aus irgendeinem Grund sah ich mich selbst anstelle des Jungen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083469
    m_Localized: 'Raskolnikov: Er schluchzte, winselte und flehte um sein Leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083470
    m_Localized: 'Raskolnikov: Und dann ... peng. Sein Körper fiel einfach um, wie all die anderen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083471
    m_Localized: 'Raskolnikov: Da wurde mir klar ... dass es nur noch zwei Arten von Menschen gibt. Raubtiere und Beutetiere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083472
    m_Localized: 'Raskolnikov: Ich ... Ich hoffe, dass ich das Töten lernen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083473
    m_Localized: Zum Überleben muss man kein blutrünstiger Killer werden
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083474
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083475
    m_Localized: 'Raskolnikov: Warum sagen Sie das? Das stimmt nicht!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083476
    m_Localized: 'Raskolnikov: Sie leben noch, weil Sie Ihre Zähne gezeigt haben. Sie sind ein Raubtier! Deshalb wagt es niemand, Sie anzurühren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083477
    m_Localized: 'Raskolnikov: Wenn die Leute sich vor einem fürchten, ist man sicher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083478
    m_Localized: 'Raskolnikov: Ich will kein Beutetier sein. Ich will nicht weinend sterben wie ein Feigling.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277632
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277633
    m_Localized: 'Raskolnikov: Deshalb muss ich das Töten lernen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277634
    m_Localized: 'Nun: Vater unser im Himmel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277635
    m_Localized: Wie finden Sie das Haus?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277636
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277637
    m_Localized: 'Nun: Armselig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277638
    m_Localized: 'Nun: Die Wände sind krumm. Und die Raumaufteilung ergibt keinerlei Sinn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277639
    m_Localized: 'Nun: Haben Sie mich absichtlich in das kläglichste Zimmer gesteckt, das Sie finden konnten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277640
    m_Localized: 'Nun: Die Möbel sind alt und brüchig. Wurmzerfressen, ausgeleiert und wahrscheinlich voller Motten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277641
    m_Localized: 'Nun: Hätten Sie nicht ein Kreuz in einem ordentlichen Zimmer aufhängen können?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277642
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277643
    m_Localized: 'Nun: Ach, vergessen Sie’s.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277644
    m_Localized: 'Nun: Vater unser im Himmel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277645
    m_Localized: Wenn es Ihnen hier nicht gefällt, warum gehen Sie nicht?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277646
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277647
    m_Localized: 'Nun: Denken Sie, ich bin freiwillig an diesem gottverlassenen Ort? Wenn das Kloster standgehalten hätte, wäre ich in seinen heiligen Mauern geblieben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277648
    m_Localized: 'Nun: Glauben Sie, mir würde irgendetwas an dieser Bruchbude gefallen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277649
    m_Localized: 'Nun: Wenn ich eine Wahl gehabt hätte, wäre ich niemals hergekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277650
    m_Localized: 'Nun: Hier stinkt es nach Mord und Totschlag, Gott bewahre. Und ihnen gefällt es wahrscheinlich auch noch, sich darin zu suhlen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277651
    m_Localized: 'Nun: Sie töten jeden, den Sie für einen Dämon halten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277652
    m_Localized: 'Nun: Vielleicht sind Sie selbst einer! Bald wachsen Ihnen Hörner aus dem Kopf!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277653
    m_Localized: 'Nun: Aber ich habe keine Angst. Der Himmlische Vater wacht über die Seinen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277654
    m_Localized: 'Nun: Vater unser im Himmel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277655
    m_Localized: Warum sind Sie nicht in Ihrem Kloster geblieben?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277656
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277657
    m_Localized: 'Nun: Erstens gehört das Kloster nicht mir. Es ist das Haus des allmächtigen Herrn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277658
    m_Localized: 'Nun: Zweitens sind diese schändlichen Frevler schuld.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277659
    m_Localized: 'Nun: Sie haben die heilige Stätte entweiht. Möge Feuer vom Himmel auf sie herabregnen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277660
    m_Localized: 'Nun: Sie kamen hereingestürmt und trieben uns alle hinaus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277661
    m_Localized: 'Nun: Sie führten sich auf, als würde der Ort ihnen gehören. Barbaren, allesamt!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277662
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277663
    m_Localized: 'Nun: Wir führten ein frommes Leben. Wir beteten, fasteten und verrichteten die Arbeit des Herrn. Und diese Tiere?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277664
    m_Localized: 'Nun: Saufen heiliges Wasser wie billigen Wein. Ersticken sollen sie daran.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277665
    m_Localized: 'Nun: In der Hölle sollen sie schmoren!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277666
    m_Localized: 'Nun: Vater unser im Himmel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277667
    m_Localized: Was wollten diese „Frevler“?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277668
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277669
    m_Localized: 'Nun: Sie kamen als Horde, schmutzig und laut. Sie krächzten wie Dämonen und fluchten wie gottlose Primitivlinge!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277670
    m_Localized: 'Nun: Und warum? Weil ich sie nicht reinlassen wollte! Ich sagte ihnen, dass mir kein Ungetaufter über die Türschwelle kommt!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277671
    m_Localized: 'Nun: Sie wurden wütend, oh ja ... Sie schlugen gegen die Türen und versuchten, sie aus den Angeln zu reißen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277672
    m_Localized: 'Nun: Dann kamen sie reingestürmt und warfen mich raus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277673
    m_Localized: Sie haben Bedürftige abgewiesen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277674
    m_Localized: Ich hätte Sie vielleicht auch rausgeworfen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277675
    m_Localized: 'Nun: Eine heilige Stätte ist keine Zuflucht für die Gottlosen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277676
    m_Localized: 'Nun: Selbst wenn sie Schutz vor der Sonne oder vor diesen sogenannten Besuchern gesucht haben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277677
    m_Localized: 'Nun: Selbst wenn es Feuer vom Himmel regnet, das Haus Gottes ist kein Ort für solche Wüstlinge.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277678
    m_Localized: 'Nun: Der Herr lässt nur den Gläubigen seine Gnade zukommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277679
    m_Localized: 'Nun: Und wenn sie auf den Straßen verbrennen, dann soll es so sein. Dann war es ihr gerechtes Urteil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277680
    m_Localized: Sie sind erbärmlich, aber ich verurteile Sie nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277681
    m_Localized: Verschwinden Sie lieber, bevor ich Sie erschieße
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277682
    m_Localized: 'Nun: Sie unverschämter Bengel!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277683
    m_Localized: 'Nun: Haben Sie den Verstand verloren?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277684
    m_Localized: 'Nun: Ich bin eine Dienerin Gottes! Ich wurde von gottlosem Abschaum aus Seinem Haus gejagt ... Und Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277685
    m_Localized: 'Nun: Wollen Sie mich verhöhnen? Wollen Sie sagen, ich hätte es nicht anders verdient?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277686
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277687
    m_Localized: 'Nun: Sie sind kein Mensch. Sie sind eine Schlange!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277688
    m_Localized: 'Nun: FREVLER! SIE SIND NUR EINER DIESER FREVLER!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277689
    m_Localized: 'Nun: Ich hatte gehofft, Sie würden mich verstehen. Aber Sie sind keinen Deut besser als der Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277690
    m_Localized: 'Nun: Wir sind bloße Diener! DIENER DES HERRN!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277691
    m_Localized: 'Nun: Wir können nur Seinen Willen akzeptieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277692
    m_Localized: 'Nun: Seine Wege sind unergründlich. Wir werden Seinen allmächtigen Plan nie begreifen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277693
    m_Localized: Sie sind erbärmlich, aber ich verurteile Sie nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277694
    m_Localized: Verschwinden Sie lieber, bevor ich Sie erschieße
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277695
    m_Localized: 'Nun: Oh, jetzt sind Sie also plötzlich der Held?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277696
    m_Localized: 'Nun: Ich lege keinen Wert auf Ihr verkommenes Haus. Ich werde keine Sekunde länger hier verbringen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277697
    m_Localized: 'Nun: Möge der Zorn Gottes auf Sie niedergehen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277698
    m_Localized: 'Nun: Ich hatte sowieso nicht vor, hierzubleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277699
    m_Localized: 'Nun: Seit ich dieses Haus betreten habe, wusste ich, dass es hier keinen Gott gibt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277700
    m_Localized: 'Nun: Vielleicht ist es Seine Stimme, die mir sagt, dass ich von hier verschwinden soll.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277701
    m_Localized: 'Nun: Möge der Zorn Gottes auf Sie niedergehen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277702
    m_Localized: 'Fugitive: Diese verdammte Wunde ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277703
    m_Localized: Warum war die FEMA hinter Ihnen her?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277704
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277705
    m_Localized: 'Fugitive: Ich bin mir nicht sicher, aber ich habe einen Verdacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277706
    m_Localized: 'Fugitive: Erst dachte ich, es wäre nur eine routinemäßige Durchsuchung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277707
    m_Localized: 'Fugitive: Aber ich wette, dieses Miststück von nebenan hat mich angeschwärzt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277708
    m_Localized: 'Fugitive: Wir konnten uns nicht ausstehen. Sie hat die Gelegenheit genutzt, mir eins reinzuwürgen. Hat behauptet, ich sei ein „Besucher“.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277709
    m_Localized: 'Fugitive: Wahrscheinlich ist sie jetzt auch noch stolz auf sich, diese Schlampe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277710
    m_Localized: 'Fugitive: Diese verdammte Wunde ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277711
    m_Localized: Wie verheilt die Wunde?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277712
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277713
    m_Localized: 'Fugitive: Es wird langsam besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277714
    m_Localized: 'Fugitive: Wie gesagt, es war ein glatter Durchschuss.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277715
    m_Localized: 'Fugitive: Die Leute sollten sich nicht gegenseitig an die Gurgel gehen. Und dieser Typ? Er drückt einfach ab.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277716
    m_Localized: 'Fugitive: Wenn das so weitergeht, sind wir bald alle tot. Wenn man über der Erde keine Ruhe findet, dann eben unter der Erde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277717
    m_Localized: 'Fugitive: Aber nein ... Man muss unbedingt die Hölle durchleben und andere mit runterziehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277718
    m_Localized: 'Fugitive: Sie hätten diesen Irren mit der Waffe sehen sollen. Verdammter Bastard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277719
    m_Localized: Ein Irrer? Ich dachte, die FEMA-Leute hätten auf Sie geschossen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277720
    m_Localized: Von welchem Irren reden Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277721
    m_Localized: 'Fugitive: Ja, ja, es war die FEMA, er ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277722
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277723
    m_Localized: Sagen Sie mir die Wahrheit
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277724
    m_Localized: Sie sind ein miserabler Lügner
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277725
    m_Localized: 'Fugitive: Ich meine ... Ich spreche von einem FEMA-Typen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277726
    m_Localized: 'Fugitive: Er sah richtig bedrohlich aus, als er ... vor mir stand.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277727
    m_Localized: 'Fugitive: Ich meine ... als er mir ... in den Rücken schoss.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277728
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277729
    m_Localized: Sagen Sie mir die Wahrheit
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277730
    m_Localized: Sie sind ein miserabler Lügner
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277731
    m_Localized: 'Fugitive: Schon gut, schon gut ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277732
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277733
    m_Localized: 'Fugitive: Die Wahrheit ist ... Ich hab’s aus der Quarantänezone geschafft, ja ... Aber da hat niemand geschossen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277734
    m_Localized: 'Fugitive: Ein Arzt hat mir geholfen. Er hat die Papiere gefälscht und mich rausgeholt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277735
    m_Localized: 'Fugitive: Ich kann nicht zurück nach Hause. Sie ist noch da. Die Nachbarin, die mich verpfiffen hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277736
    m_Localized: 'Fugitive: Also habe ich einen Ort gesucht, wo ich untertauchen kann. Und dann bin ich diesem Kerl begegnet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277737
    m_Localized: 'Fugitive: Ich wollte nur fragen, wo ich die Nacht verbringen kann. Und dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277738
    m_Localized: 'Fugitive: Dann sah ich eine Schrotflinte auf seinem Rücken, und eine Halskette aus Zähnen und Fingernägeln. Die Gasse hinter ihm war voller Leichen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277739
    m_Localized: 'Fugitive: Da wusste ich, dass er ein gottverdammter Irrer war.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277740
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277741
    m_Localized: 'Fugitive: Die Schmerzen kommen zurück. Kann ich mich kurz hinlegen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277742
    m_Localized: 'Fugitive: Verdammt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277743
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277744
    m_Localized: 'Fugitive: Hören Sie zu, ich erkläre Ihnen alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277745
    m_Localized: 'Fugitive: Die Wahrheit ist ... Ich hab’s aus der Quarantänezone geschafft, ja ... Aber da hat niemand geschossen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277746
    m_Localized: 'Fugitive: Ein Arzt hat mir geholfen. Er hat die Papiere gefälscht und mich rausgeholt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277747
    m_Localized: 'Fugitive: Ich kann nicht zurück nach Hause. Sie ist noch da. Die Nachbarin, die mich verpfiffen hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277748
    m_Localized: 'Fugitive: Also habe ich einen Ort gesucht, wo ich untertauchen kann. Und dann bin ich diesem Kerl begegnet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277749
    m_Localized: 'Fugitive: Ich wollte nur fragen, wo ich die Nacht verbringen kann. Und dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277750
    m_Localized: 'Fugitive: Dann sah ich ein Sturmgewehr auf seinem Rücken, und eine Halskette aus Zähnen und Fingernägeln. Die Gasse hinter ihm war voller Leichen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277751
    m_Localized: 'Fugitive: Da wusste ich, dass er ein gottverdammter Irrer war.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277752
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277753
    m_Localized: 'Fugitive: Die Schmerzen kommen zurück. Kann ich mich kurz hinlegen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277754
    m_Localized: 'Fugitive: Diese verdammte Wunde ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277755
    m_Localized: Was war mit dem Irren mit dem Sturmgewehr?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277756
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277757
    m_Localized: 'Fugitive: Dieser mit Zähnen und Fingern bedeckte Wahnsinnige.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277758
    m_Localized: 'Fugitive: Er sah Zweifel in meinem Gesicht und richtete die Waffe auf mich. Ich konnte sie packen und es kam zu einem Handgemenge.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277759
    m_Localized: 'Fugitive: Wir kämpften um die Waffe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277760
    m_Localized: 'Fugitive: Er drückte ab. Im nächsten Moment schlug ich ihm gegen den Schädel und er war bewusstlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277761
    m_Localized: 'Fugitive: Ich rannte, so weit ich konnte. Dann spürte ich den Schmerz in meinem Bauch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277762
    m_Localized: 'Fugitive: Ich sah nach unten, überall war Blut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277763
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277764
    m_Localized: 'Fugitive: Ich wollte nicht sagen, dass er auf mich geschossen hat, weil Sie mich dann nicht reingelassen hätten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277765
    m_Localized: 'Fugitive: In Zeiten wie diesen will jeder nur seine eigene Haut retten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277766
    m_Localized: 'Fugitive: Seien Sie ehrlich ... Wenn Sie gewusst hätten, dass mir ein bewaffneter Psycho auf den Fersen ist, hätten Sie mich wirklich reingelassen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277767
    m_Localized: 'Fugitive: Ich habe eine Zuflucht gebraucht. Ich will nicht so enden wie die armen Schweine in dieser Gasse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277768
    m_Localized: 'Fugitive: Also ja ... Ich habe gelogen. Hoffentlich können Sie mir verzeihen. Nehmen Sie es mir nicht übel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277769
    m_Localized: Schon gut, Sie können bleiben
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277770
    m_Localized: Ich kann Ihnen nicht trauen, verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277771
    m_Localized: 'Fugitive: Danke für Ihr Verständnis. Das weiß ich zu schätzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277772
    m_Localized: 'Fugitive: Hoffen wir, dass dieser Irre nicht hier auftaucht. Zum Glück sind Sie auch bewaffnet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277773
    m_Localized: 'Fugitive: Vielleicht hat ihn schon jemand umgelegt. Vielleicht sogar dieser bleiche, dürre Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277774
    m_Localized: 'Fugitive: Tja ... Ich hatte wohl recht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277775
    m_Localized: 'Fugitive: Sehen Sie? Ich habe aus gutem Grund gelogen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277776
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277777
    m_Localized: 'Fugitive: Tschüss, Arschloch!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277778
    m_Localized: 'Bestson: Oh nein ... Wo sind sie nur hin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277779
    m_Localized: Wie geht es dir?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277780
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277781
    m_Localized: 'Bestson: Ich weiß nicht ... Ich will einfach nur meine Eltern zurück.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277782
    m_Localized: 'Bestson: Sie haben sich mein ganzes Leben lang um mich gekümmert, und jetzt ... weiß ich nicht mal, was mit ihnen passiert ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277783
    m_Localized: 'Bestson: Hoffentlich geht es ihnen gut. Ich kann mir kein Leben ohne sie vorstellen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277784
    m_Localized: 'Bestson: Oh nein ... Wo sind sie nur hin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277785
    m_Localized: Hast du noch andere Verwandte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277786
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277787
    m_Localized: 'Bestson: So gut wie keine. Wobei ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277788
    m_Localized: 'Bestson: Ich habe vor Kurzem erfahren, dass ich eine ältere Schwester habe ... aus der ersten Ehe meines Vaters. Aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277789
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277790
    m_Localized: 'Bestson: Verdammt, meine Oma!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277791
    m_Localized: 'Bestson: Oh Gott, ich glaube, mir ist gerade eingefallen, wo meine Eltern hingegangen sein könnten ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277792
    m_Localized: 'Bestson: Was, wenn Oma sich als Besucherin entpuppt und sie getötet hat? Was, wenn die FEMA meine Eltern mitgenommen hat?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277793
    m_Localized: 'Bestson: Warum? Warum sind sie nicht geblieben? Warum haben sie mich nicht mitgenommen? WARUM ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277794
    m_Localized: 'Bestson: ALLEIN BIN ICH AUFGESCHMISSEN. WARUM HABEN SIE MICH IM STICH GELASSEN?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277795
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277796
    m_Localized: 'Bestson: Oh nein ... Wo sind sie nur hin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277797
    m_Localized: Hast du dich beruhigt? Was ist mit deiner Schwester?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277798
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277799
    m_Localized: 'Bestson: Na ja, ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277800
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277801
    m_Localized: 'Bestson: Kurz bevor sie weggegangen sind, haben wir einen Brief bekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277802
    m_Localized: 'Bestson: Mein Vater hat ihn mir gebracht, weil ich nie die Post lese. Er hat gesagt, ich soll ihn lesen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277803
    m_Localized: 'Bestson: Er war von meiner „Schwester“.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277804
    m_Localized: 'Bestson: Sie wollte mich treffen. Aber ... Ich wusste nicht, was ich davon halten soll.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277805
    m_Localized: 'Bestson: Ehrlich gesagt hielt ich es zuerst für einen Scherz. Aber da mein Vater mir den Brief gegeben hat, konnte das gar nicht sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277806
    m_Localized: 'Bestson: Er erzählte mir, dass ich nicht sein erstes Kind war. Dass ich die ganze Zeit eine Schwester hatte ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277807
    m_Localized: 'Bestson: Eine Halbschwester. Wir haben nur denselben Vater.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277808
    m_Localized: 'Bestson: Das zu hören ... fühlte sich komisch an. Ich wusste nicht, wie ich damit umgehen sollte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277809
    m_Localized: 'Bestson: Ich meine, sie ist zwar meine „Schwester“, aber ich kenne sie überhaupt nicht ... Das ist doch seltsam ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277810
    m_Localized: 'Bestson: Ich ... Ich glaube, ich würde gerne mit ihr sprechen. Aber ich habe zu viel Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277811
    m_Localized: 'Bestson: Vielleicht kannst du sie für mich anrufen? Hier ist die Nummer:{0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277812
    m_Localized: 'Bestson: Sag ihr einfach nur ... dass es mich gibt. Und dass ich nicht weiß, was ich machen soll.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277813
    m_Localized: 'Bestson: Oh nein ... Wo sind sie nur hin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277814
    m_Localized: Warum willst du nicht zu deiner Schwester?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277815
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277816
    m_Localized: 'Bestson: Ich kenne sie doch gar nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277817
    m_Localized: 'Bestson: Als meine Eltern mir die Wahrheit erzählt haben, hatte ich das Gefühl, dass sie mich die ganze Zeit belogen hatten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277818
    m_Localized: 'Bestson: Ich war stinksauer und ging auf mein Zimmer. Ich wollte nur noch meine Ruhe haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277819
    m_Localized: 'Bestson: Und dann am nächsten Tag ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277820
    m_Localized: 'Bestson: Dann ist das passiert, was ich dir erzählt habe. Der Fernseher, die Panik, und dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277821
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277822
    m_Localized: 'Bestson: Sie haben mich tatsächlich zurückgelassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277823
    m_Localized: 'Bestson: Gott, ich schwöre, ich würde alles geben, um meine Mutter und meinen Vater noch einmal zu sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277824
    m_Localized: 'Bestson: Gott, warum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277825
    m_Localized: Geh zu deiner Schwester, sie wird dich nicht abweisen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277826
    m_Localized: Bist du sicher, dass deine Eltern tot sind?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277827
    m_Localized: 'Bestson: Meinst du wirklich?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277828
    m_Localized: 'Bestson: Aber ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277829
    m_Localized: 'Bestson: Ich war ohne meine Eltern noch nie so weit weg von zu Hause.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277830
    m_Localized: 'Bestson: Sie wohnt ziemlich weit von hier. Ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277831
    m_Localized: 'Bestson: Ich habe Angst. Ich glaube nicht, dass ich das schaffe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277832
    m_Localized: Es fahren immer noch Taxis
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277833
    m_Localized: Sie müssen irgendwas tun
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277834
    m_Localized: 'Bestson: Hmm ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277835
    m_Localized: 'Bestson: Sie sind nicht zurückgekommen, um mich zu holen, also ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277836
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277837
    m_Localized: 'Bestson: Ich weiß nicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277838
    m_Localized: Versuche, deine Oma zu finden
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277839
    m_Localized: Suche in den Quarantänezonen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277840
    m_Localized: 'Bestson: Hey, das ist ... gar keine so schlechte Idee. Glaube ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277841
    m_Localized: 'Bestson: Wobei ich gehört habe, dass Taxis inzwischen richtig teuer sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277842
    m_Localized: 'Bestson: Aber ich habe den Notgroschen meiner Eltern genommen. Vielleicht reicht es für die Fahrt zu meiner Schwester.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277843
    m_Localized: 'Bestson: Danke, dass du mir den Kopf gewaschen hast. Mach’s gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277844
    m_Localized: 'Bestson: Vielleicht hast du recht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277845
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277846
    m_Localized: 'Bestson: Vielleicht habe ich mich wirklich zu lange auf meine Eltern verlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277847
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277848
    m_Localized: 'Bestson: Danke, dass du mir den Kopf gewaschen hast.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277849
    m_Localized: 'Bestson: Ich versuche, ein Taxi zu kriegen. Ich habe den Notgroschen meiner Eltern dabei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277850
    m_Localized: 'Bestson: Hoffentlich schaffe ich das. Mach’s gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277851
    m_Localized: 'Bestson: Vielleicht ... Vielleicht hast du recht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277852
    m_Localized: 'Bestson: Vielleicht hatten sie eine Autopanne?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277853
    m_Localized: 'Bestson: Ja, mein Vater hat gesagt, dass das Auto repariert werden muss.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277854
    m_Localized: 'Bestson: Aber meine Oma weigert sich, ein Telefon anzuschaffen. Vielleicht konnten sie mich deshalb nicht anrufen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277855
    m_Localized: 'Bestson: Vielleicht ... Vielleicht finde ich sie ja wirklich dort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277856
    m_Localized: 'Bestson: Danke, dass du mir den Kopf gewaschen hast. Ich sollte gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277857
    m_Localized: 'Bestson: Hmm ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277858
    m_Localized: 'Bestson: Vielleicht sind sie ja wirklich dort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277859
    m_Localized: 'Bestson: Ich muss es wohl einfach versuchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277860
    m_Localized: 'Bestson: Danke, dass du mir den Kopf gewaschen hast. Ich sollte gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277861
    m_Localized: 'Buddy: Was gibt’s, Kumpel?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277862
    m_Localized: Wie geht’s?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277863
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277864
    m_Localized: 'Buddy: Mir geht’s blendend, Kumpel!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277865
    m_Localized: 'Buddy: Ich hab ’nen Blick in deinen Kühlschrank geworfen. Mann, wenn ich gewusst hätte, dass du SO VIEL Bier hast ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277866
    m_Localized: 'Buddy: Wo hast du das aufgetrieben? Hast du ’nen Braumeister als Onkel oder so?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277867
    m_Localized: 'Buddy: Ach, was soll’s! Behalt deine Geheimnisse ruhig für dich!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277868
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277869
    m_Localized: 'Buddy: Verdammt, wenn dieser ganze Mist nicht wäre, würden wir ein paar kühle Blonde trinken und Fußball gucken. Ich würde dir sogar ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277870
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277871
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277872
    m_Localized: Alles in Ordnung?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277873
    m_Localized: Hat es dir die Sprache verschlagen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277874
    m_Localized: 'Buddy: Hä? Was?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277875
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277876
    m_Localized: 'Buddy: Egal. Vergiss es.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277877
    m_Localized: 'Buddy: Nein, ich hab nur ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277878
    m_Localized: 'Buddy: Hmm ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277879
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277880
    m_Localized: 'Buddy: Ich denk nur nach, das ist alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277881
    m_Localized: 'Buddy: Was gibt’s, Kumpel?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277882
    m_Localized: Du wirkst niedergeschlagen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277883
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277884
    m_Localized: 'Buddy: Ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277885
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277886
    m_Localized: 'Buddy: Ich will nicht darüber reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277887
    m_Localized: Worüber?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277888
    m_Localized: Was meinst du?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277889
    m_Localized: 'Buddy: Egal. Du würdest es eh nicht verstehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277890
    m_Localized: Ich muss es wissen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277891
    m_Localized: Na gut, ich werde dich nicht zwingen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277892
    m_Localized: 'Buddy: Ich will wirklich nicht darüber reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277893
    m_Localized: Ich muss es wissen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277894
    m_Localized: Na gut, ich werde dich nicht zwingen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471936
    m_Localized: 'Buddy: Dräng mich nicht so! Ich weiß sowieso schon nicht, wo mir der Kopf steht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471937
    m_Localized: 'Buddy: Lass mich einfach in Ruhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471938
    m_Localized: 'Buddy: Danke. Mir geht’s nicht besonders gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471939
    m_Localized: 'Buddy: Was gibt’s, Kumpel?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471940
    m_Localized: Was ist mit dir los?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471941
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471942
    m_Localized: 'Buddy: Das geht dich nichts an, Kumpel! Misch dich nicht ein!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471943
    m_Localized: Sag mir einfach, was los ist
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471944
    m_Localized: Wenn du nicht redest, machst du es nur schlimmer
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471945
    m_Localized: 'Buddy: Ich kann nicht ... Du würdest mich danach mit anderen Augen sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471946
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471947
    m_Localized: 'Buddy: Andererseits ... kann ich’s auch nicht für mich behalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471948
    m_Localized: 'Buddy: Ich hatte eine Hündin. Sie ist seit ein paar Tagen tot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471949
    m_Localized: Na und?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471950
    m_Localized: Und weiter?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471951
    m_Localized: 'Buddy: Was ist, willst du mich umlegen, Kumpel?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471952
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471953
    m_Localized: 'Buddy: Na gut. Du willst die Wahrheit hören?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471954
    m_Localized: 'Buddy: Ich hatte eine Hündin. Sie ist seit ein paar Tagen tot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471955
    m_Localized: Na und?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471956
    m_Localized: Und weiter?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471957
    m_Localized: 'Buddy: Sie war alt und krank, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471958
    m_Localized: 'Buddy: Sie ist nicht einfach nur ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471959
    m_Localized: 'Buddy: Ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471960
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471961
    m_Localized: 'Buddy: Ich hab sie getötet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471962
    m_Localized: Was hast du!?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471963
    m_Localized: Du krankes Schwein!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471964
    m_Localized: 'Buddy: Ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471965
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471966
    m_Localized: 'Buddy: Ich hab sie getötet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471967
    m_Localized: Was hast du!?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471968
    m_Localized: Du krankes Schwein!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471969
    m_Localized: 'Buddy: Ich weiß, wie sich das anhört. Aber lass mich ausreden, Kumpel. Sie ... Sie hat gelitten. Ich konnte es nicht mehr mitansehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471970
    m_Localized: 'Buddy: Jeden Tag hab ich das Leid in ihren Augen gesehen. Nachts hat sie gewimmert und gejault vor lauter Schmerzen in den Beinen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471971
    m_Localized: 'Buddy: DIESES VERFLUCHTE TAXI! Wenn der Fahrer nicht gerast wäre wie ein Irrer, würde sie vielleicht noch leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471972
    m_Localized: 'Buddy: Verdammt, ich würde alles tun, um es ihm heimzuzahlen. Aber er ist geflohen und ich hab das Nummernschild nicht gesehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471973
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471974
    m_Localized: 'Buddy: Du weißt nicht, wie es ist, ein Haustier zu verlieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471975
    m_Localized: 'Buddy: Wie heißt es so schön: Für uns sind sie nur ein Kapitel, aber für sie sind wir die ganze Geschichte. Und wir lernen mehr von ihnen als von jedem Menschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471976
    m_Localized: Na gut, du kannst bleiben
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471977
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471978
    m_Localized: 'Buddy: Ja, ich weiß ... Ich bin ein Scheißkerl. Ich kann mir selbst nicht verzeihen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471979
    m_Localized: 'Buddy: Sie ... Sie hat gelitten. Ich konnte es einfach nicht mehr mitansehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471980
    m_Localized: 'Buddy: Es wurde jeden Tag schlimmer. Nachts war es am schlimmsten ... Sie hat gewinselt und gejault ... und die Tränen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471981
    m_Localized: 'Buddy: Hast du schon mal einen Hund weinen sehen? Ihre Augen haben mich angefleht, es zu beenden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471982
    m_Localized: 'Buddy: Ich wollte das nicht! Das schwöre ich! Meine Hand hätte niemals ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471983
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471984
    m_Localized: 'Buddy: VERFLUCHTES TAXI!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471985
    m_Localized: 'Buddy: Der Bastard hat meinen Hund überfahren! Und dann fährt er einfach weiter, als ob nichts gewesen wäre!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471986
    m_Localized: 'Buddy: Als wäre sie ein Stein auf der Straße gewesen und kein Lebewesen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471987
    m_Localized: 'Buddy: Verdammt, ich würde alles tun, um es ihm heimzuzahlen. Aber er ist geflohen und ich hab das Nummernschild nicht gesehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471988
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471989
    m_Localized: 'Buddy: Du weißt nicht, wie es ist, ein Haustier zu verlieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471990
    m_Localized: 'Buddy: Wie heißt es so schön: Für uns sind sie nur ein Kapitel, aber für sie sind wir die ganze Geschichte. Und wir lernen mehr von ihnen als von jedem Menschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471991
    m_Localized: Na gut, du kannst bleiben
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471992
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471993
    m_Localized: 'Buddy: Danke, Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471994
    m_Localized: 'Buddy: Ich bin froh, dass du das verstehst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471995
    m_Localized: 'Buddy: Du hast recht, Kumpel. Vielleicht ist es so am besten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471996
    m_Localized: 'Buddy: Ich denke jeden verdammten Tag daran ... Ob es richtig war, ihr Leid zu beenden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471997
    m_Localized: 'Buddy: Ich werde es wohl nie erfahren ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471998
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472176
    m_Localized: 'Blind: So dunkel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472177
    m_Localized: Was haben Sie gesehen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666240
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666241
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666242
    m_Localized: 'Blind: Das wollen Sie gar nicht wissen. Glauben Sie mir. Es ist besser so.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666243
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666244
    m_Localized: 'Blind: Ich dachte, wenn ich aufhöre zu sehen, würde ich das Bild von diesem ... Ding aus dem Kopf kriegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666245
    m_Localized: 'Blind: Aber es hat sich in mein Hirn eingebrannt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666246
    m_Localized: 'Blind: Ich träume immer noch. Es ist immer da. Es kommt mich oft besuchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666247
    m_Localized: 'Blind: So dunkel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666248
    m_Localized: Ist es ohne Ihre Augen besser?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666249
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666250
    m_Localized: 'Blind: Schwer zu sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666251
    m_Localized: 'Blind: Ich weiß, dass ich nie wieder sehen werde. Wenn mich irgendwas umbringt, weiß ich nicht, was es war.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666252
    m_Localized: 'Blind: Aber es ist schon seltsam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666253
    m_Localized: 'Blind: Ich weiß nicht, wie Ihr Haus aussieht. Ich finde mich nur schwer zurecht. Ohne Medikamente hätte ich Schmerzen in den Augenhöhlen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666254
    m_Localized: 'Blind: Aber ich komme schon zurecht. Wenigstens muss ich nie wieder diesen Horror sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666255
    m_Localized: 'Blind: Trotzdem ... Das, was ich gesehen habe ... hat sich mir eingebrannt. Ich werde es nie mehr los.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666256
    m_Localized: 'Blind: So dunkel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666257
    m_Localized: Sie sehen schlimm aus
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666258
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666259
    m_Localized: 'Blind: Vielleicht, weil ich keinen Kamm habe? Ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666260
    m_Localized: 'Blind: Ich hatte letzte Nacht einen Traum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666261
    m_Localized: 'Blind: Ich lief auf den Straßenbahnschienen nach Hause. Um mich herum waren Häuser und Bäume.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666262
    m_Localized: 'Blind: Ich hörte die Straßenbahn und wich zur Seite aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666263
    m_Localized: 'Blind: Ich drehte mich um – und sah, wie ein Mann von irgendetwas gepackt wurde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666264
    m_Localized: 'Blind: Es bewegte sich so schnell, dass ich es nicht klar erkennen konnte. Aber ich wusste, was es war.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666265
    m_Localized: 'Blind: Ich rannte der Straßenbahn hinterher, aber ich kam ihr nicht näher. Ich würde sie nie einholen. Nie die Wahrheit erfahren, die an der Endstation wartet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666266
    m_Localized: 'Blind: Dann wachte ich auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666267
    m_Localized: 'Blind: So dunkel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666268
    m_Localized: Alles in Ordnung?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666269
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666270
    m_Localized: 'Blind: Ich habe wieder geträumt. Es war wieder da.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666271
    m_Localized: 'Blind: Ich lief auf einer Straße. Nachts. Flackernde Straßenlaternen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666272
    m_Localized: 'Blind: Ich drehte mich um und sah, wie es auf mich zu rannte. Ganz langsam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666273
    m_Localized: 'Blind: Diesmal sah ich seine Bewegungen deutlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666274
    m_Localized: 'Blind: Ich wollte wegrennen, aber es kam immer näher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666275
    m_Localized: 'Blind: Ich erreichte mein Haus, aber bekam das Tor nicht auf. Musste über den Zaun klettern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666276
    m_Localized: 'Blind: Ich griff in meine Tasche. Die Schlüssel glitten mir durch die Finger.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666277
    m_Localized: 'Blind: Also rannte ich ums Haus. Noch ein Zaun. Wieder klettern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666278
    m_Localized: 'Blind: Ich hielt inne. Kein Geräusch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666279
    m_Localized: 'Blind: Ich sah nach oben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666280
    m_Localized: 'Blind: Und da war es. Griff über den Zaun nach mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666281
    m_Localized: 'Blind: Vielleicht sind es nur die Schmerzmittel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666282
    m_Localized: 'Blind: So dunkel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666283
    m_Localized: Irgendwelche Träume letzte Nacht?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666284
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666285
    m_Localized: 'Blind: Ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666286
    m_Localized: 'Blind: Ich will nicht darüber sprechen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666287
    m_Localized: 'Blind: Ich verstehe es jetzt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666288
    m_Localized: 'Blind: Wir werden sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666289
    m_Localized: 'Blind: Es wird uns in Stücke reißen. Wach oder im Schlaf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666290
    m_Localized: 'Blind: Die Sonne wird uns verbrennen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666291
    m_Localized: 'Blind: Nichts ist mehr wichtig. Es ist vorbei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666292
    m_Localized: 'Blind: Ich ... Lassen Sie mich allein. Bitte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666293
    m_Localized: 'Dude: Yo, Alter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666294
    m_Localized: Was hast du vor der Katastrophe gemacht?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666295
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666296
    m_Localized: 'Dude: Mann, ich hab gechillt. Filme gucken, mit Kumpels abhängen und so.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666297
    m_Localized: 'Dude: Aber jetzt? Keine Filme und kein Abhängen mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666298
    m_Localized: 'Dude: In der Glotze kommt immer nur derselbe Panikkram und Werbung. Meine Kumpels gehen nicht mal ans Telefon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666299
    m_Localized: 'Dude: Irgendein Großkotz hat gesagt: „Jetzt ist keine Zeit für Spaß, wir sind mitten in der Krise ...“'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666300
    m_Localized: 'Dude: Mann, scheiß auf den Typen. Ich entscheide selbst, wann Zeit für Spaß ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666301
    m_Localized: 'Dude: Yo, Alter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666302
    m_Localized: Was hast du beruflich gemacht?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666303
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666304
    m_Localized: 'Dude: Arbeit? Pfffft.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666305
    m_Localized: 'Dude: Alter, Arbeit ist nur was für Loser. Ich hab gelebt, Mann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666306
    m_Localized: 'Dude: Ich hab mal ’nen Film gesehen. Der Hauptdarsteller hätte glatt ich sein können.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666307
    m_Localized: 'Dude: Findest du, Fabrikarbeiter sehen glücklich aus? Nein, verdammt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666308
    m_Localized: 'Dude: Ich hab Partys geschmissen, neue Leute getroffen ... Darum geht’s im Leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666309
    m_Localized: 'Dude: Okay, okay ... Ich war mal Lagerleiter. Bei ’nem Lieferbetrieb. Dank meiner alten Kumpels.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666310
    m_Localized: Du liegst also deinen Eltern auf der Tasche?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666311
    m_Localized: Du bist also nur ein Faulpelz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666312
    m_Localized: 'Dude: Warum soll ich arbeiten, Alter? Ich hab meine Nische gefunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666313
    m_Localized: 'Dude: Warum sollte ich nicht ausnutzen, was ich hab?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666314
    m_Localized: 'Dude: Du zum Beispiel hast ’ne Knarre. Willst du die nur an die Wand hängen oder auch benutzen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666315
    m_Localized: 'Dude: Siehst du? Ich bin kein Dummkopf. Ich weiß mir nur zu helfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666316
    m_Localized: 'Dude: Yo, chill mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666317
    m_Localized: 'Dude: Wenn du neidisch bist, sag’s einfach, Alter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666318
    m_Localized: 'Dude: Ich weiß schon, nicht jeder knackt den Jackpot. So ist das Leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666319
    m_Localized: 'Dude: Yo, Alter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666320
    m_Localized: Stimmt etwas nicht?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666321
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666322
    m_Localized: 'Dude: Alter ... Wo sind deine Filme? Du hast keine einzige Videokassette.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666323
    m_Localized: 'Dude: Glotzt du überhaupt irgendwas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666324
    m_Localized: 'Dude: Ich sterb hier noch vor Langeweile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666325
    m_Localized: Jetzt ist nicht die Zeit für Filme
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666326
    m_Localized: Ich habe keine
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666327
    m_Localized: 'Dude: Mann, ich dachte, hier wär richtig was los.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666328
    m_Localized: 'Dude: Aber die Leute hier? Total schräg. Und nix zum Glotzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666329
    m_Localized: 'Dude: Keine Zeitschriften, keine Filme ... nur Bücher ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666330
    m_Localized: 'Dude: Wer zum Teufel liest Bücher, Alter? So ein Steinzeitkram! Nur Wörter und endlose Beschreibungen. Zum Einpennen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666331
    m_Localized: Das hier ist kein Kino
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666332
    m_Localized: Bist du zum Feiern oder zum Überleben hier?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666333
    m_Localized: 'Dude: Was!?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666334
    m_Localized: 'Dude: Alter, dein Ernst?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666335
    m_Localized: 'Dude: Du hast ’ne Glotze in deinem Zimmer, aber keinen einzigen verdammten Film!?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666336
    m_Localized: 'Dude: Alter, was für ’ne lahme Party. Ich dachte, du wärst cool.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666337
    m_Localized: Das hier ist kein Kino
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666338
    m_Localized: Bist du zum Feiern oder zum Überleben hier?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666339
    m_Localized: 'Dude: Mann, komm schon ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666340
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666341
    m_Localized: 'Dude: Du bist die größte Spaßbremse, die ich je gesehen hab.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666342
    m_Localized: Wenn du überleben willst, reiß dich zusammen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666343
    m_Localized: Wenn es dir hier nicht gefällt, kannst du gehen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666344
    m_Localized: 'Dude: Mann, komm schon ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666345
    m_Localized: 'Dude: Meine Glotze ist im Eimer, Mann. Ich dachte, du rettest mich vor dem Tod durch Langeweile, aber nein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666346
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666347
    m_Localized: 'Dude: Du bist die größte Spaßbremse, die ich je gesehen hab.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666348
    m_Localized: Reiß dich zusammen, wenn du überleben willst
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666349
    m_Localized: Wenn es dir hier nicht gefällt, kannst du gehen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666350
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666351
    m_Localized: 'Dude: Schon gut, Alter. Hier ist’s stinklangweilig, aber immer noch besser als auf der Straße.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666352
    m_Localized: 'Dude: Lass mich einfach nur ein bisschen fernsehen, Mann. Nur ein bisschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666353
    m_Localized: 'Dude: Ich wusste es! Du bist so ’ne Spaßbremse!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666354
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666355
    m_Localized: 'Dude: Ich verzieh mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666356
    m_Localized: 'Teacher: Die armen Kinder ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666357
    m_Localized: Alles in Ordnung?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666358
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666359
    m_Localized: 'Teacher: Ja, ich glaube schon ... Ich weiß nicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666360
    m_Localized: 'Teacher: Ich ... Ich verstehe nicht, wie Erwachsene sich von ihren Emotionen zu so etwas verleiten lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666361
    m_Localized: 'Teacher: Haben sie wirklich solche Angst, dass sie sogar ein Kind töten würden?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666362
    m_Localized: Die Leute tun heutzutage noch Schlimmeres
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666363
    m_Localized: Wenn Chaos ausbricht, stirbt die Vernunft zuerst
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666364
    m_Localized: 'Teacher: Was könnte schlimmer sein, als ein Kind zu töten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666365
    m_Localized: 'Teacher: Es war nicht nur eine Person ... sondern ein regelrechter Mob, wie bei einer Hexenjagd ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666366
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666367
    m_Localized: 'Teacher: Vielleicht zeigen wir in schwierigen Zeiten unser wahres Gesicht. Vielleicht sind die wahren Monster wir und nicht die aus dem Untergrund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666368
    m_Localized: 'Teacher: Aber verstehen die Leute denn nicht, dass das Töten von Kindern ... Ich finde keine Worte dafür ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666369
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666370
    m_Localized: 'Teacher: Vielleicht zeigen wir in schwierigen Zeiten unser wahres Gesicht. Vielleicht sind die wahren Monster wir und nicht die aus dem Untergrund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666371
    m_Localized: 'Teacher: Die armen Kinder ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666372
    m_Localized: Wie lange waren Sie Kindergärtnerin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666373
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666374
    m_Localized: 'Teacher: Für ungefähr drei Monate vor der Katastrophe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666375
    m_Localized: 'Teacher: Aber ... ich habe den Beruf nicht geliebt. Die Kinder waren für mich nur laut und anstrengend.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666376
    m_Localized: 'Teacher: Die Katastrophe hat das geändert. Sie hat mir die Augen geöffnet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666377
    m_Localized: 'Teacher: Wissen Sie, diese Kinder hätten Rockstars, Politiker oder Eltern werden können.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666378
    m_Localized: 'Teacher: Aber jetzt werden sie niemals Gitarre spielen, zur Schule gehen oder erwachsen werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666379
    m_Localized: 'Teacher: Sie werden für immer ... eine Armee von Träumern bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666380
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666381
    m_Localized: 'Teacher: Ich weiß noch, wie eines der Kinder hereingerannt kam. Es weinte und sagte, seine Eltern hätten Angst vor ihm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666382
    m_Localized: 'Teacher: Sie dachten, er wäre ein Besucher und ... warfen ihn aus dem Haus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666383
    m_Localized: 'Teacher: Er wusste nicht, wohin er gehen sollte, also kam er zu mir ... in den Kindergarten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666384
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666385
    m_Localized: 'Teacher: (Die Frau kann ihre Tränen nicht zurückhalten)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666386
    m_Localized: 'Teacher: Entschuldigung ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666387
    m_Localized: 'Teacher: Die armen Kinder ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666388
    m_Localized: Tut mir leid, ich wollte Sie gestern nicht kränken
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666389
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666390
    m_Localized: 'Teacher: Schon gut. Es ... geht mir schon wieder besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666391
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666392
    m_Localized: 'Teacher: Wegen diesem Jungen ... Durch ihn wurde mir klar, wie verletzlich Kinder sind. Vor allem, wenn die Welt aus den Fugen gerät.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666393
    m_Localized: 'Teacher: Ich fing an, so viele „Verstoßene“ und einsame Seelen aufzunehmen, wie ich konnte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666394
    m_Localized: 'Teacher: Ich hörte mir ihre Geschichten an ... Es war unerträglich, wie manche Eltern sie ohne zu zögern im Stich gelassen hatten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666395
    m_Localized: 'Teacher: Als wäre die Katastrophe nur ein Vorwand, um ein Kind zu verstoßen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666396
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666397
    m_Localized: 'Teacher: Vielleicht ... wollten sie sowieso nie Kinder haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666398
    m_Localized: 'Teacher: Die armen Kinder ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666399
    m_Localized: Hatten Sie eigene Kinder?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666400
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666401
    m_Localized: 'Teacher: Nein, ich ... Meine Mutter sagte immer, ich solle heiraten und Kinder kriegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666402
    m_Localized: 'Teacher: Aber ich war noch nicht so weit. Ich wollte mich bewusst dafür entscheiden, wenn die richtige Zeit gekommen ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666403
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666404
    m_Localized: 'Teacher: Die ganzen Geschichten der verlassenen Kinder brachten mich zum Nachdenken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666405
    m_Localized: 'Teacher: Wenn ich auf meine Mutter gehört hätte, wäre ich vielleicht auch so geworden wie ihre Eltern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666406
    m_Localized: 'Teacher: Deshalb wollte ich jedem Kind helfen, das zurückgelassen wurde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666407
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666408
    m_Localized: 'Teacher: Wissen Sie, was am schlimmsten ist? Einer der Brandstifter war ein Elternteil von einem der Kinder, die ich aufgenommen hatte ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666409
    m_Localized: 'Teacher: (Wieder kann die Frau ihre Tränen nicht zurückhalten)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666410
    m_Localized: 'Teacher: Entschuldigung ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666411
    m_Localized: 'Teacher: Ich ... Ich wollte ihnen wirklich ein gutes Leben ermöglichen. Ich habe mich um sie gekümmert. Es hätte nicht so enden dürfen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666412
    m_Localized: 'Teacher: Es tut mir so leid ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666413
    m_Localized: Ihr Tod ist nicht Ihre Schuld
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666414
    m_Localized: Herzliches Beileid
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666415
    m_Localized: 'Teacher: Vielleicht haben Sie recht. Aber ... ich fühle mich innerlich so leer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666416
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666417
    m_Localized: 'Teacher: Wissen Sie, welchen Gedanken ich einfach nicht loswerde?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666418
    m_Localized: 'Teacher: Was, wenn ihre Eltern sie nie geliebt haben?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666419
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666420
    m_Localized: 'Teacher: Ich hoffe nur ... dass ich ihnen das Gefühl geben konnte, zumindest ein bisschen geliebt zu werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666421
    m_Localized: 'Teacher: Danke ... aber es bricht mir immer noch das Herz. Ich glaube nicht, dass ich je darüber hinwegkomme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666422
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666423
    m_Localized: 'Teacher: Wissen Sie, welchen Gedanken ich einfach nicht loswerde?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666424
    m_Localized: 'Teacher: Was, wenn ihre Eltern sie nie geliebt haben?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666425
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666426
    m_Localized: 'Teacher: Ich hoffe nur ... dass ich ihnen das Gefühl geben konnte, zumindest ein bisschen geliebt zu werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860544
    m_Localized: 'Ballerina: Das Kätzchen ist hier. Was will man mehr?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860545
    m_Localized: Warum sind Sie hier?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860546
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860547
    m_Localized: 'Ballerina: Was für eine dumme Frage.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860548
    m_Localized: 'Ballerina: Sie haben die Tür aufgemacht. Fragen Sie sich, warum. Wofür bin ich gut?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860549
    m_Localized: 'Ballerina: Mir ist alles gleich, ein Ort ist wie der andere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860550
    m_Localized: 'Ballerina: „Geh dorthin“, hat er gesagt, also bin ich hingegangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860551
    m_Localized: 'Ballerina: Ich will nichts von Ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860552
    m_Localized: 'Ballerina: Sorgen Sie nur dafür, dass ich es gemütlich habe. Alles andere ist egal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860553
    m_Localized: 'Ballerina: Das Kätzchen ist hier. Was will man mehr?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860554
    m_Localized: Sind Sie ein Mensch?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860555
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860556
    m_Localized: 'Ballerina: Sie etwa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860557
    m_Localized: 'Ballerina: Ist überhaupt noch irgendwas in Ihnen übrig?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860558
    m_Localized: 'Ballerina: Warum sollte ich schlechter sein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860559
    m_Localized: 'Ballerina: Das Kätzchen ist hier. Was will man mehr?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860560
    m_Localized: Wer hat Sie hergeschickt?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860561
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860562
    m_Localized: 'Ballerina: Sie haben bereits getan, was Sie tun mussten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860563
    m_Localized: 'Ballerina: Warum lassen Sie es nicht einfach gut sein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860564
    m_Localized: 'Ballerina: Ein ... Bekannter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860565
    m_Localized: 'Ballerina: Aber er hat nicht gesagt, was danach passiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860566
    m_Localized: 'Ballerina: Das Kätzchen ist hier. Was will man mehr?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860567
    m_Localized: Wie lange wollen Sie hierbleiben?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860568
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860569
    m_Localized: 'Ballerina: Bis sie mich holen kommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860570
    m_Localized: 'Ballerina: Was soll ich denn sonst machen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860571
    m_Localized: 'Ballerina: Ich weiß nicht. Er hat mir was gesagt und jetzt warte ich, bis er mir mehr sagt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860572
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860573
    m_Localized: 'Ballerina: Und wer sagt Ihnen, was Sie tun sollen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860574
    m_Localized: 'Ballerina: Auf wen warten Sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860575
    m_Localized: 'Ballerina: Das Kätzchen ist hier. Was will man mehr?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860576
    m_Localized: Warum haben Sie mich nicht umgebracht?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860577
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860578
    m_Localized: 'Ballerina: Sie sind ziemlich dumm, wissen Sie das?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860579
    m_Localized: 'Ballerina: Jeden Tag das Gleiche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860580
    m_Localized: 'Ballerina: Wie gesagt, er hat es nicht gesagt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860581
    m_Localized: 'Ballerina: Ich warte. Warum warten Sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860582
    m_Localized: 'Mother: Hier drinnen ist es stickig ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860583
    m_Localized: Alles in Ordnung? Wie geht es deinem Sohn?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860584
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860585
    m_Localized: 'Mother: Ja, ja ... Er ist ... Er ist müde, genau wie ich. Und er fühlt sich bei Fremden unwohl, also bleibt er eng bei mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860586
    m_Localized: 'Mother: Solche Situationen sind für Kinder nicht leicht. Auch wenn sie sich nicht beschweren, steht es ihnen ins Gesicht geschrieben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860587
    m_Localized: 'Mother: Manchmal denke ich, es ist meine Schuld, weil ich sie in die ganze Sache hineingezogen habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860588
    m_Localized: 'Mother: Aber jetzt ist es zu spät, irgendwas zu ändern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860589
    m_Localized: 'Couple: Liebling, was ziehst du für ein langes Gesicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860590
    m_Localized: Warum waren Sie draußen auf der Straße?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860591
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860592
    m_Localized: 'Couple: Oh, wir wollten nur die Mutter meiner lieben Frau besuchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860593
    m_Localized: 'Couple: Wir haben rechtzeitig gemerkt, dass wir es allein nicht schaffen würden, und dann haben wir Ihr Haus gefunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860594
    m_Localized: 'Couple: Danke noch mal, dass wir bleiben dürfen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860595
    m_Localized: 'Couple: Liebling, was ziehst du für ein langes Gesicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860596
    m_Localized: Wie weit ist es?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860597
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860598
    m_Localized: 'Couple: Mein Liebling kennt sich hier nicht sonderlich gut aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860599
    m_Localized: 'Couple: Wenn uns niemand hilft, dann vielleicht zwei Tage?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860600
    m_Localized: 'Couple: Bis wir den richtigen Weg finden, werden wir uns erst ein paarmal verirren. Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860601
    m_Localized: 'Couple: Aber wenn uns jemand fahren würde? Das wäre perfekt. Höchstens ein paar Stunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860602
    m_Localized: Warum wollen Sie gerade jetzt ihre Mutter besuchen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860603
    m_Localized: Der Zeitpunkt ist nicht gerade ideal
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860604
    m_Localized: 'Couple: Ihr könnte alles Mögliche zugestoßen sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860605
    m_Localized: 'Couple: Das Telefon ihrer Mutter ist tot. Wir können sie seit Tagen nicht erreichen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860606
    m_Localized: 'Couple: Wir müssen sichergehen, dass sie wohlauf ist. Vielleicht braucht sie Hilfe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860607
    m_Localized: 'Couple: Und die Nächte sind jetzt kürzer. Es ist gefährlich, draußen rumzulaufen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860608
    m_Localized: 'Couple: Aber das wird schon. Bald sehen wir deine Mutter wieder, oder, Liebling?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860609
    m_Localized: 'Couple: Ich erinnere mich nicht an den Weg und meine Frau wählt sowieso immer die falsche Richtung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860610
    m_Localized: 'Couple: Aber was soll’s? Wichtig ist, dass man vorankommt, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860611
    m_Localized: 'Couple: Vielleicht sind wir ja in einer Woche da! Hahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860612
    m_Localized: 'Couple: Liebling, was ziehst du für ein langes Gesicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860613
    m_Localized: Ich dachte, Sie würden heute losgehen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860614
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860615
    m_Localized: 'Couple: Tja, meine Frau, das kleine Dummerchen, hat drei Stunden gebraucht, um sich fertig zu machen. Dann war es zu spät zum Losgehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860616
    m_Localized: 'Couple: Also gehen wir ein anderes Mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860617
    m_Localized: 'Couple: Nächstes Mal beeilen wir uns. Tut uns leid.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860618
    m_Localized: 'Couple: Ich sorge dafür, dass diese lahme Ente uns nicht mehr aufhält.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860619
    m_Localized: 'Couple: Wir machen Ihnen doch keine Umstände oder? Tut uns wirklich leid!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860620
    m_Localized: 'Couple: Liebling, was ziehst du für ein langes Gesicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860621
    m_Localized: Ist alles in Ordnung, gnädige Frau?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860622
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860623
    m_Localized: 'Couple: Es geht ihr gut. Warum fragen Sie sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860624
    m_Localized: 'Couple: Ich bin hier Ihr Ansprechpartner.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860625
    m_Localized: 'Couple: Sie ist nur ein bisschen durch den Wind. Kein Grund zur Sorge.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860626
    m_Localized: Ich will es von ihr hören
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860627
    m_Localized: Und wie geht es Ihnen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860628
    m_Localized: 'Couple: Sie ist müde. Lassen Sie sie bitte in Ruhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860629
    m_Localized: 'Couple: Ehrlich gesagt glaube ich, dass ihre Mutter ihr inzwischen egal ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860630
    m_Localized: 'Couple: Aber keine Sorge. Irgendwann wird die kleine Schnecke sich in Bewegung setzen und dann besuchen wir ihre Mutter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860631
    m_Localized: 'Couple: Wenn sie dann noch lebt, haha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860632
    m_Localized: 'Couple: Komm schon, Liebling, mach dich endlich fertig. Wie lang soll ich noch warten? Scheiße!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860633
    m_Localized: 'Couple: Ach, im Grunde ist alles gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860634
    m_Localized: 'Couple: Meine Frau scheint sich überhaupt nicht um ihre eigene Mutter zu scheren, haha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860635
    m_Localized: 'Couple: Vielleicht muss ich dir einen kleinen Schubser geben?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860636
    m_Localized: 'Couple: Tut mir leid, dass Sie das mitanhören müssen. Aber ihre Behäbigkeit macht mich noch wahnsinnig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860637
    m_Localized: 'Couple: Setz dich hin und mach dich fertig, ich hab keine Lust mehr zu warten! Verdammte Scheiße!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860638
    m_Localized: 'Couple: Liebling, was ziehst du für ein langes Gesicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860639
    m_Localized: Ihre Frau will nicht weg. Was ist los?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860640
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860641
    m_Localized: 'Couple: Sie geht mir auf den Sack, verstehen Sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860642
    m_Localized: 'Couple: Ständig weint sie rum und macht mir Vorwürfe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860643
    m_Localized: 'Couple: Warum kann sie nicht einfach die Klappe halten und tun, was ich sage?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860644
    m_Localized: 'Couple: Tut mir leid, dass wir so lange geblieben sind. Heute ist der letzte Tag. Wir verschwinden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860645
    m_Localized: 'Couple: Hast du gehört? Pack deine verdammten Sachen. Wenn wir heute Nacht noch hier sind, werfe ich dich aus dem Fenster.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860646
    m_Localized: Ist wirklich alles in Ordnung, gnädige Frau?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860647
    m_Localized: Was wird hier gespielt?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860648
    m_Localized: 'Couple: Halten Sie sich da raus. Ich hab’s Ihnen schon mal gesagt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860649
    m_Localized: 'Couple: Das geht Sie überhaupt nichts an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860650
    m_Localized: 'Couple: Wir kriegen das schon hin, gehen Sie mir nicht auf die Nerven.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860651
    m_Localized: Ich will jetzt die verdammte Wahrheit hören (Waffe rausholen)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860652
    m_Localized: Verschwinden Sie jetzt oder nicht?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860653
    m_Localized: 'Couple: Hören Sie, es ist alles in Ordnung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860654
    m_Localized: 'Couple: Meiner Frau ist einfach nur langweilig, darum zickt sie so rum. Das kotzt mich langsam an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860655
    m_Localized: 'Couple: Was wollen Sie von mir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860656
    m_Localized: Ich will jetzt die verdammte Wahrheit hören (Waffe rausholen)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860657
    m_Localized: Verschwinden Sie jetzt oder nicht?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860658
    m_Localized: 'Couple: Immer mit der Ruhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860659
    m_Localized: 'Couple: Ich habe eine Waffe in der Hand. Wenn Sie irgendwas versuchen, erschieße ich diese Schlampe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860660
    m_Localized: 'Couple: Ich habe nichts zu verlieren. Sie etwa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860661
    m_Localized: Sie werden sowieso sterben
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860662
    m_Localized: Noch haben Sie die Chance, zu verschwinden
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860663
    m_Localized: 'Couple: Ja, ja, wir fallen Ihnen nicht länger zur Last.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860664
    m_Localized: 'Couple: Wir gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054848
    m_Localized: 'Couple: Hast du gehört? Das ist unsere letzte Nacht hier. Mach dich fertig und hör auf, Zeit zu verplempern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054849
    m_Localized: 'Couple: Was habe ich schon zu verlieren? Töten Sie mich doch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054850
    m_Localized: 'Couple: Dann hat wenigstens das Leiden ein Ende. Und diese Schlampe stirbt mit mir. Das reicht mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054851
    m_Localized: Ich schieße
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054852
    m_Localized: Legen Sie die Waffe weg, dann tue ich es auch
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054853
    m_Localized: 'Couple: Warum? Ich muss mit ihr weggehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054854
    m_Localized: 'Couple: Ohne sie gehe ich nicht. Also nehmen Sie die Waffe runter. Wir gehen heute Nacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054855
    m_Localized: 'Couple: Niemand wird verletzt, wenn Sie keine Faxen machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054856
    m_Localized: Ich schieße
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054857
    m_Localized: Legen Sie die Waffe weg, dann tue ich es auch
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054858
    m_Localized: 'Couple: Sie wollen wirklich eine Frau erschießen? Ist Ihnen alles egal?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054859
    m_Localized: 'Couple: Wenn Sie mich erschießen, treffen Sie auch sie. Dann haben Sie ihr Blut an den Händen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054860
    m_Localized: 'Couple: Ich ... Ich bin hier nicht der Böse! Sie sind der Killer!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054861
    m_Localized: Schießen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054862
    m_Localized: Warnen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054863
    m_Localized: 'Couple: Ich muss gehen. Sonst werden wir beide sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054864
    m_Localized: 'Couple: Es gibt keine andere Möglichkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054865
    m_Localized: 'Couple: Wenn diese Schlampe nicht gezittert hätte wie verdammtes Espenlaub und einfach mitgekommen wäre ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054866
    m_Localized: 'Couple: Das ist alles ihre Schuld. Hast du gehört? Du hast alles kaputt gemacht!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054867
    m_Localized: Schießen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054868
    m_Localized: Warnen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054869
    m_Localized: 'Couple: Sie ... Sie nehmen die Waffe runter?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054870
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054871
    m_Localized: 'Couple: Moment mal, wollen Sie immer noch schießen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054872
    m_Localized: 'Couple: WARTEN SIE – NEIN!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054873
    m_Localized: 'Couple: Okay! Okay. Wir gehen. Ganz ruhig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054874
    m_Localized: 'Couple: Na? Kommst du diesmal endlich mit? Du Schlampe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054875
    m_Localized: 'Couple: (Plötzlich reißt sich die Frau los und der Mann schießt auf sie)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054876
    m_Localized: 'Couple: (Sie reagieren sofort und schießen dem Mann in den Kopf)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054877
    m_Localized: 'Couple: (Sie scheinen beide tot zu sein. Wenigstens ist es vorbei)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054878
    m_Localized: 'Couple: (Ein merkwürdiges Paar)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054879
    m_Localized: 'Couple: Also gut, wir gehen. Jetzt. Wir schnappen uns nur eine Decke, dann verschwinden wir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054880
    m_Localized: 'Couple: Sie sehen uns nie wieder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054881
    m_Localized: 'Couple: Warten Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054882
    m_Localized: 'Couple: WAS MACHEN SIE DA?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054883
    m_Localized: 'Couple: (Sie schießen auf den Mann und treffen auch die Frau)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054884
    m_Localized: 'Couple: (Beide sacken blutend zusammen)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054885
    m_Localized: 'Couple: (Die Frau gluckst noch kurz, aber Sie können ihr nicht helfen)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054886
    m_Localized: 'Couple: (Beide sind tot)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054887
    m_Localized: 'Couple: Verstehen Sie das nicht? Das ist die einzige Möglichkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054888
    m_Localized: 'Couple: Wir gehen, basta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054889
    m_Localized: 'Couple: Hey! Nimm die Decke. Jetzt. Los, gehen wir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054890
    m_Localized: 'Couple: (Sie sehen zu, wie die beiden sich in die Decke wickeln und rausgehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054891
    m_Localized: 'Couple: Sie laufen eine Weile und brechen dann plötzlich zusammen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054892
    m_Localized: 'Couple: Aus der Decke steigt Rauch auf. Sie drehen sich weg)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054937
    m_Localized: 'Luka: Alles wird gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054938
    m_Localized: Bist du immer noch gut gelaunt?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054939
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054940
    m_Localized: 'Luka: Vielleicht nicht gut gelaunt ... aber auch nicht verzweifelt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054941
    m_Localized: 'Luka: Wir sind immer noch Menschen. Wir stehen das durch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054942
    m_Localized: 'Luka: Wir dürfen das Ganze nicht schlimmer machen, als es sowieso schon ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054943
    m_Localized: 'Luka: Und ich glaube, wenn alles vorbei ist ... können wir uns vergeben, was wir einander angetan haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054944
    m_Localized: 'Luka: Solange es Mitgefühl gibt, ist die Menschheit nicht verloren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054945
    m_Localized: 'Luka: Verstehst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054946
    m_Localized: 'Luka: Alles wird gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054947
    m_Localized: Warst du schon immer so?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054948
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054949
    m_Localized: 'Luka: Nein. Nicht immer. Früher war ich wütend. Auf andere Menschen, auf die Welt, auf mich selbst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054950
    m_Localized: 'Luka: Ich konnte wegen Kleinigkeiten ausrasten und Türen zuschlagen, bis der Rahmen bricht. Aber irgendwann wurde mir klar, dass die Wut nur alles kaputt macht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054951
    m_Localized: 'Luka: Zuerst einen selbst. Dann alles um einen herum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054952
    m_Localized: 'Luka: Einmal ... habe ich jemanden angebrüllt, der nur helfen wollte. Und jetzt ... ist er ... ist sie weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054953
    m_Localized: 'Luka: In dem Moment ist etwas in mir zerbrochen. Ich wusste, dass ich mich ändern musste, sonst würde ich alles zerstören, was ich anfasse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054954
    m_Localized: 'Luka: Also habe ich gelernt, loszulassen. Zu atmen. Frieden zu schließen. So bin ich hier gelandet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054955
    m_Localized: 'Luka: Alles wird gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054956
    m_Localized: Was hast du verloren?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054957
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054958
    m_Localized: 'Luka: Meine Familie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054959
    m_Localized: 'Luka: Unser Haus ist abgebrannt, als ich nur kurz draußen war, um Wasser zu holen. Als ich zurückkam, gab es nur noch Rauch und Asche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054960
    m_Localized: 'Luka: Ich konnte es lange nicht akzeptieren. Ich habe mich gefragt, warum ich nicht da war. Warum ich sie nicht retten konnte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054961
    m_Localized: 'Luka: Aber vielleicht spielt das gar keine Rolle. Vielleicht geht es nicht darum, die Vergangenheit zu ändern. Vielleicht geht es um die Zukunft.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054962
    m_Localized: 'Luka: In gewisser Weise sind sie immer noch bei mir. Die Erinnerung an sie gibt mir Kraft. Deshalb versuche ich, anderen zu helfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054963
    m_Localized: 'Luka: Ich weiß, wie sich Verlust anfühlt. Und was es bedeutet, einen Sinn zu finden, nachdem alles in die Brüche geht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054964
    m_Localized: 'Luka: Alles wird gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054965
    m_Localized: Und du hast es geschafft, mit deinem Verlust zu leben?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054966
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054967
    m_Localized: 'Luka: Ja, ich habe es durchgestanden. Aber es war nicht einfach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054968
    m_Localized: 'Luka: Ich habe mir lange Zeit Vorwürfe gemacht. Ich dachte, wenn ich ein paar Minuten früher zurückgekommen wäre, könnte alles anders sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054969
    m_Localized: 'Luka: Aber Trauer nährt sich aus Schuld. Und Leben ... braucht Vergebung. Ich musste loslassen, um mich nicht selbst zu verlieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054970
    m_Localized: 'Luka: Vergebung. Das ist es, was mich gerettet hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054971
    m_Localized: 'Luka: Ich habe mir selbst vergeben, dass ich die Vergangenheit nicht ändern konnte. Sogar dem Schicksal, so grausam es auch war. Die Wut hat mich nur runtergezogen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054972
    m_Localized: 'Luka: Alles wird gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054973
    m_Localized: Was macht dich so zuversichtlich?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054974
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054975
    m_Localized: 'Luka: Ich glaube, dass Menschen sich bessern können. Selbst in Notlagen wie dieser gibt es immer eine Chance, etwas zu ändern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054976
    m_Localized: 'Luka: Ich glaube nicht an Wunder oder Vorsehung. Ich glaube an die Menschen. Daran, dass wir uns gegenseitig beistehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054977
    m_Localized: 'Luka: Jemand hilft einem anderen auf, lächelt an einem schlechten Tag oder teilt sein letztes Stück Brot. Es geht um die kleinen Dinge des Lebens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054978
    m_Localized: 'Luka: Immer, wenn jemand die Welt ein kleines bisschen besser macht, weiß ich, dass nicht alles umsonst war.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054979
    m_Localized: 'Luka: Alles wird gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054980
    m_Localized: Willst du dein Zuhause und deine Familie zurück?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054981
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054982
    m_Localized: 'Luka: Wenn ich sie wiedersehen könnte ... mit ihnen reden, sie in den Arm nehmen ... Natürlich würde ich das gerne tun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054983
    m_Localized: 'Luka: Aber die Zeit zurückdrehen? Ich weiß nicht. Verlust gehört zum Leben. Er ist furchtbar schmerzhaft, aber er prägt uns.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054984
    m_Localized: 'Luka: Klar, ich würde nahezu alles dafür geben, nur einen einzigen Tag mit ihnen verbringen zu können.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054985
    m_Localized: 'Luka: Aber wenn ich dafür aufgeben müsste, was ich gelernt habe? Zu vergeben und weiterzumachen? Nein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054986
    m_Localized: "Luka: Unsere Zeit ist begrenzt. Wir sollten mit dem zufrieden sein, was wir haben, und uns nicht nach vergangenen Dingen sehnen.\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249152
    m_Localized: 'Hunter: Seien Sie auf der Hut. Jeder von uns könnte ein Besucher sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249153
    m_Localized: Sie sind ein Jäger, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249154
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249155
    m_Localized: 'Hunter: Eher ein Förster.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249156
    m_Localized: 'Hunter: Ich hab draußen im Wald gelebt. Kein Fernseher, nur ein Radio. So hab ich erfahren, was passiert ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249157
    m_Localized: 'Hunter: Dann hab ich beschlossen, niemanden reinzulassen. Meine Hütte ist meine Festung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249158
    m_Localized: 'Hunter: Was, wenn einer davon ein Besucher ist? Schmiert mir Honig ums Maul und schlitzt mir dann im Schlaf die Kehle auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249159
    m_Localized: Warum sind Sie dann hier?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249160
    m_Localized: Allein ist man nicht sicher
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249161
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249162
    m_Localized: 'Hunter: Ich will mich nicht von diesem bleichen Bastard erwischen lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249163
    m_Localized: 'Hunter: Wegen ihm hab ich meine Hütte verlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249164
    m_Localized: 'Hunter: Ich seh es in Ihren Augen – Sie haben ihn auch gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249165
    m_Localized: Wie haben Sie da draußen allein überlebt?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249166
    m_Localized: Haben Sie den bleichen Besucher auch gesehen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249167
    m_Localized: 'Hunter: Denken Sie, das wüsste ich nicht, Sie Genie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249168
    m_Localized: 'Hunter: Ansonsten wäre ich jetzt Madenfutter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249169
    m_Localized: 'Hunter: Ich hielt es immer für dumm, Fremde reinzulassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249170
    m_Localized: 'Hunter: Dachte, allein wäre ich sicherer. Dann ist dieser Irre aufgetaucht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249171
    m_Localized: 'Hunter: So ein Monstrum hab ich vorher noch nie gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249172
    m_Localized: Wie haben Sie da draußen allein überlebt?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249173
    m_Localized: Haben Sie den bleichen Besucher auch gesehen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249174
    m_Localized: 'Hunter: Ach ... Das ist eine lange Geschichte. Ich bin heute nicht in der Stimmung dafür.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249175
    m_Localized: 'Hunter: Bringen Sie mir morgen ein Bier. Dann erzähl ich Ihnen alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249176
    m_Localized: 'Hunter: Ich bin also nicht der Einzige.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249177
    m_Localized: 'Hunter: Ja ... Ich kann es sehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249178
    m_Localized: 'Hunter: Ach, Frischling ... Wenn Sie wüssten, was ich durchgemacht hab ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249179
    m_Localized: 'Hunter: Ich rede. Aber nicht heute.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249180
    m_Localized: 'Hunter: Bringen Sie mir morgen ein Bier, dann erfahren Sie alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249181
    m_Localized: 'Hunter: Seien Sie auf der Hut. Jeder von uns könnte ein Besucher sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249182
    m_Localized: Also, erzählen Sie Ihre Geschichte.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249183
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249184
    m_Localized: 'Hunter: Haben Sie das Bier dabei?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249185
    m_Localized: 'Ja (Bier geben) '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249186
    m_Localized: 'Hunter: Was, kein Bier?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249187
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249188
    m_Localized: Nein (Bier nicht geben)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249189
    m_Localized: 'Hunter: Das sollte genügen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249190
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249191
    m_Localized: 'Hunter: Wie gesagt, ich hatte mich allein in meiner Hütte verschanzt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249192
    m_Localized: 'Hunter: Dann taucht irgendwann dieser Kerl auf. Völlig außer Atem und verzweifelt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249193
    m_Localized: 'Hunter: Schlägt gegen die Tür und fleht mich an, ihn reinzulassen. Aber irgendwie hatte ich ein komisches Gefühl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249194
    m_Localized: 'Hunter: Er war kreidebleich, als hätte er den Tod gesehen. Keine Ahnung, wie er es so weit in den Wald geschafft hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249195
    m_Localized: 'Hunter: Wie ein Wanderer sah er nicht aus. Also hab ich ihm gesagt, er soll verschwinden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249196
    m_Localized: 'Hunter: Er wollte das Fenster einschlagen, aber ich hab geschrien, dass ich ein Gewehr hab. Dann ist er abgehauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249197
    m_Localized: 'Hunter: Ich dachte, ich sehe ihn nie wieder ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249198
    m_Localized: Vielleicht hätten Sie ihm helfen sollen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249199
    m_Localized: Sie hätten ihn reinlassen sollen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249200
    m_Localized: Sie „dachten“?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249201
    m_Localized: 'Hunter: Und mir das, was ihm auf den Fersen war, an den Hals holen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249202
    m_Localized: 'Hunter: Nein danke. Ich hab genug Probleme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249203
    m_Localized: Gut
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249204
    m_Localized: Sie sind nicht gerade gesprächig
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249205
    m_Localized: Viel haben Sie ja nicht gerade gesagt
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249206
    m_Localized: Lassen Sie mich raten. Sie packen aus, wenn Bier im Spiel ist?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249207
    m_Localized: 'Hunter: Spielen Sie nicht den Helden, Frischling. Ich wette, Sie haben auch schon Leute abgewiesen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249208
    m_Localized: 'Hunter: Sonst hätten Sie nicht so lange überlebt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249209
    m_Localized: 'Hunter: Aber die Geschichte heben wir uns für morgen auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249210
    m_Localized: Gut
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249211
    m_Localized: Sie sind nicht gerade gesprächig
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249212
    m_Localized: Viel haben Sie ja nicht gerade gesagt
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249213
    m_Localized: Lassen Sie mich raten. Sie packen aus, wenn Bier im Spiel ist?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249214
    m_Localized: 'Hunter: Ich war mir sicher, dass ich ihn nie wieder sehen würde. Aber später ... hat er mich gefunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249215
    m_Localized: 'Hunter: Aber diese Geschichte heben wir uns für ein anderes Mal auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249216
    m_Localized: Gut
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249217
    m_Localized: Sie sind nicht gerade gesprächig
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249218
    m_Localized: Viel haben Sie ja nicht gerade gesagt
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249219
    m_Localized: Lassen Sie mich raten. Sie packen aus, wenn Bier im Spiel ist?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249220
    m_Localized: 'Hunter: Bringen Sie mir morgen ein Bier, dann erzähle ich Ihnen den Rest der Geschichte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249221
    m_Localized: 'Hunter: Ich schwinge nicht gern große Reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249222
    m_Localized: 'Hunter: Sie können froh sein, dass ich überhaupt etwas sage.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249223
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249224
    m_Localized: 'Hunter: Bringen Sie mir morgen ein Bierchen, dann erzähle ich Ihnen den Rest. Abgemacht?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249225
    m_Localized: 'Hunter: Immer mit der Ruhe, Frischling. Ich habe ganz schön üble Sachen gesehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249226
    m_Localized: 'Hunter: Nichts, woran man sich nüchtern gern erinnert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249227
    m_Localized: 'Hunter: Bringen Sie mir das Bier, dann rede ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249228
    m_Localized: 'Hunter: Sie sind clever, das muss ich Ihnen lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249229
    m_Localized: 'Hunter: Ich rede nur, wenn es drauf ankommt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249230
    m_Localized: 'Hunter: Also bringen Sie mir morgen das Bier, dann verrate ich Ihnen das Ende.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249231
    m_Localized: 'Hunter: Tut mir leid, aber nüchtern werde ich kein Wort sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249232
    m_Localized: 'Hunter: Bringen Sie mir Bier, dann können wir reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249233
    m_Localized: 'Hunter: Seien Sie auf der Hut. Jeder von uns könnte ein Besucher sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249234
    m_Localized: Und wie ging es aus?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249235
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249236
    m_Localized: 'Hunter: Ich werde es Ihnen sagen. Nach einem Bier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249237
    m_Localized: 'Ja (Bier geben) '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249238
    m_Localized: 'Hunter: Wie, kein Bier?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249239
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249240
    m_Localized: Nein (Bier nicht geben)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249241
    m_Localized: 'Hunter: Schon besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249242
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249243
    m_Localized: 'Hunter: Also, der Kerl ist abgehauen und ich blieb in der Hütte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249244
    m_Localized: 'Hunter: Aber dann ging mir das Feuerholz aus. Musste neues besorgen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249245
    m_Localized: 'Hunter: Hab einen Armvoll gesammelt, kam zurück ... und das Gewehr war weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249246
    m_Localized: 'Hunter: Das hat mich aufgewühlt. Hab alles auf den Kopf gestellt, aber es war einfach weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249247
    m_Localized: 'Hunter: Dann ... sah ich ihn am Fenster. Den gleichen Typ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249248
    m_Localized: 'Hunter: Er hatte mein Gewehr ... aber er war irgendwie anders.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249249
    m_Localized: 'Hunter: Größer. Labberige Haut. Trug nichts außer einer Hose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249250
    m_Localized: 'Hunter: Er nahm die Waffe in beide Hände ... und zerbrach sie wie einen trockenen Zweig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249251
    m_Localized: 'Hunter: Dann stand er nur da. Starrte mich an. Als warte er darauf, dass ich blinzle ... damit er mir das Genick brechen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249252
    m_Localized: 'Hunter: Aber das tat er nicht. Er schaute einfach nur weiter. Wie bei einem irren Anstarrwettbewerb.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249253
    m_Localized: 'Hunter: Und dann, als der Morgen kam ... verschwand dieser große Freak einfach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249254
    m_Localized: 'Hunter: Da wurde mir eines klar: Ohne Waffe da draußen zu bleiben, wäre reiner Selbstmord.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249255
    m_Localized: 'Hunter: Also bin ich Richtung Stadt gerannt. Noch bevor die Sonne ganz aufgegangen war.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249256
    m_Localized: 'Hunter: Und jetzt bin ich hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249257
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249258
    m_Localized: 'Hunter: Vorausgesetzt, dass Sie dazu kommen, abzudrücken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249259
    m_Localized: 'Hunter: Wer weiß? Vielleicht helfen Kugeln ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249260
    m_Localized: Warum hat er Sie nicht getötet?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249261
    m_Localized: Glauben Sie, dass man ihn töten kann?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249262
    m_Localized: Er hat eine gesamte Truppe ausgelöscht.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249263
    m_Localized: 'Hunter: Keine Ahnung. Er hat ein stabiles Gewehr einfach so zerbrochen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249264
    m_Localized: 'Hunter: Hätte das gleiche auch mit mir machen können. Hat er aber nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249265
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249266
    m_Localized: 'Hunter: Vielleicht macht es ihm Spaß, mit uns zu spielen. Wie eine Katze mit einer Maus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249267
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249268
    m_Localized: 'Hunter: Wissen Sie, es gibt nicht vieles, vor dem ich Angst habe. Aber dieser große, bleiche Bastard?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249269
    m_Localized: 'Hunter: Der jagt mir eine Scheißangst ein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249270
    m_Localized: 'Hunter: Ich hoffe es.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249271
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249272
    m_Localized: 'Hunter: Wie heißt es so schön: „Wenn es blutet, kann man es töten.“'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249273
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249274
    m_Localized: 'Hunter: Wenn eine ganze Truppe ihn nicht ausschalten konnte, ... haben wir keine Chance.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249275
    m_Localized: 'Hunter: Wenn er will, nimmt er das hier auseinander wie ein Kartenhaus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249276
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249277
    m_Localized: 'Hunter: Wissen Sie, es gibt nicht vieles, vor dem ich Angst habe. Aber dieser große, bleiche Bastard?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249278
    m_Localized: 'Hunter: Der jagt mir eine Scheißangst ein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249279
    m_Localized: 'Hunter: Kein Bier, keine Geschichte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249280
    m_Localized: 'Hunter: Nüchtern erzähle ich gar nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249281
    m_Localized: 'Hunter: Wenn Sie also den Rest hören wollen ... bringen Sie mir ein Bier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443456
    m_Localized: 'Cold: Nur ein bisschen Wärme ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443457
    m_Localized: Lassen Sie die Jacke an?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443458
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443459
    m_Localized: 'Cold: Ja. Ein Gedanke treibt mich um.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443460
    m_Localized: 'Cold: Was passiert, wenn ich sie ausziehe? Mir ist nie warm, selbst wenn es heiß ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443461
    m_Localized: 'Cold: Wenn ich die Jacke ablege, werde ich dann erfrieren?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443462
    m_Localized: 'Cold: Oder schlimmer ... überleben und noch mehr frieren?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443463
    m_Localized: Schwitzen Sie nicht darunter?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443464
    m_Localized: Also duschen Sie nicht?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443465
    m_Localized: 'Cold: Nein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443466
    m_Localized: 'Cold: Der Körper schwitzt. Er versucht, sich abzukühlen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443467
    m_Localized: 'Cold: Ich glaube, mir kann gar nicht kälter werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443468
    m_Localized: 'Cold: Ich werde das ignorieren. Entschuldigung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443469
    m_Localized: 'Cold: Nur ein bisschen Wärme ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443470
    m_Localized: Haben Sie Ideen, wie Sie Ihre Temperatur in den Griff kriegen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443471
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443472
    m_Localized: 'Cold: Ich glaube nicht, dass ich daran etwas ändern kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443473
    m_Localized: 'Cold: Kochendes Wasser brennt. Das hilft nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443474
    m_Localized: 'Cold: Wissen Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443475
    m_Localized: 'Cold: Da fällt mir eine Metapher ein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443476
    m_Localized: 'Cold: Stellen Sie sich das Weltall vor. Unendlich und eiskalt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443477
    m_Localized: 'Cold: Galaxien existieren. Sterne verglühen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443478
    m_Localized: 'Cold: Und ich beobachte einfach nur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443479
    m_Localized: 'Cold: Ich bekomme nie die Wärme der Sonne zu spüren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443480
    m_Localized: 'Cold: Oder die Wärme einer Umarmung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443481
    m_Localized: 'Cold: Ich glaube, weder das Weltall noch die Gesellschaft brauchen mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443482
    m_Localized: 'Cold: Nur ein bisschen Wärme ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443483
    m_Localized: Als wir uns trafen, sagten Sie, Sie hätten etwas zu enthüllen. Was denn?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443484
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443485
    m_Localized: 'Cold: Hmm. Darüber möchte ich jetzt eigentlich nicht reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443486
    m_Localized: 'Cold: Mir liegt etwas auf dem Herzen. Schon seit langem. Vielleicht ist mir deshalb so ... kalt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443487
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443488
    m_Localized: 'Cold: Es ist nicht der Rede wert, aber die Sehnsucht frisst mich auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443489
    m_Localized: 'Cold: Ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443490
    m_Localized: 'Cold: Ich sage es Ihnen morgen. Dann bin ich bestimmt bereit dazu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443491
    m_Localized: 'Cold: Nur ein bisschen Wärme ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443492
    m_Localized: Also, was verbergen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443493
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443494
    m_Localized: 'Cold: Ja. Ich wollte ein Geheimnis lüften.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443495
    m_Localized: 'Cold: Ich glaube, ich bin bereit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443496
    m_Localized: 'Cold: Meistens geht es schief. Aber vielleicht ist es dieses Mal anders.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443497
    m_Localized: 'Cold: Unter den Kleidern liegt, so glaube ich, der Grund für die Kälte und Einsamkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443498
    m_Localized: 'Cold: Schauen Sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443499
    m_Localized: 'Cold: Nein ... Nicht schon wieder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443500
    m_Localized: Was haben Sie getan?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443501
    m_Localized: Sie sind aufgeschmissen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443502
    m_Localized: 'Cold: Das wollte ich nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443503
    m_Localized: 'Cold: Ich dachte, hier wäre es anders.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443504
    m_Localized: 'Cold: Das ist es nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443505
    m_Localized: 'Cold: Ich wollte das alles nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443506
    m_Localized: 'Cold: Das schwöre ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443507
    m_Localized: Schießen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443508
    m_Localized: Rauswerfen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443509
    m_Localized: 'Cold: Das ist schon einmal passiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443510
    m_Localized: 'Cold: Warum sollte es dieses Mal anders sein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443511
    m_Localized: 'Cold: Seien Sie nicht so grob.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443512
    m_Localized: 'Cold: Ich habe das nicht aus Boshaftigkeit getan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443513
    m_Localized: 'Cold: Das war nicht meine Absicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443514
    m_Localized: Schießen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443515
    m_Localized: Rauswerfen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443516
    m_Localized: 'Cold: Vielleicht ist es besser so.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443517
    m_Localized: 'Cold: Keine Kälte mehr. Keine Einsamkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443518
    m_Localized: 'Cold: Es ist nur ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443519
    m_Localized: 'Cold: Glauben Sie nicht, dass ich das geplant hätte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443520
    m_Localized: 'Cold: Jetzt gerade?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443521
    m_Localized: 'Cold: Eine Kugel wäre gnädiger. Leider bin ich nicht immun gegen Schmerzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443522
    m_Localized: 'Cold: Die Sonne wird länger brauchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443523
    m_Localized: 'Cold: Kann ich bleiben, bis es dunkel wird?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443524
    m_Localized: Gehen Sie jetzt
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443525
    m_Localized: Versuchen Sie ja keine krummen Dinger
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443526
    m_Localized: 'Cold: Verstanden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443527
    m_Localized: 'Cold: Es tut mir leid.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443528
    m_Localized: 'Cold: Vielleicht wird die Sonne mich wärmen. Ein letztes Mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443529
    m_Localized: 'Cold: Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443530
    m_Localized: 'Cold: Ich weiß, dass Sie mich hassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443531
    m_Localized: 'Cold: Aber dennoch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443532
    m_Localized: 'Cold: Es tut mir leid. Ich wollte das nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832064
    m_Localized: 'Daughter: Und ... ähm ... kannst du auch meine Freundin hierher einladen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832065
    m_Localized: 'Daughter: Wenn Erwachsene sie einladen, lassen sie sie gehen ... aber mich schimpfen sie immer nur aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832066
    m_Localized: 'Daughter: Ich glaube, das ist ihre Telefonnummer: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832067
    m_Localized: 'Greatmother: Oh, Herzchen ... Bitte lass niemanden rein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832068
    m_Localized: Warum hat die FEMA dich rausgeworfen, anstatt dich aufzunehmen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832069
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832070
    m_Localized: 'Greatmother: Wenn ich das mal wüsste, Herzchen. Diese Typen in Anzügen ... sind mir ein Rätsel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832071
    m_Localized: 'Greatmother: Marschieren immer rum und bellen Befehle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832072
    m_Localized: 'Greatmother: Für wen halten die sich eigentlich?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832073
    m_Localized: 'Greatmother: Ich wette, die wissen gar nix, sondern tun nur so aufgeblasen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832074
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832075
    m_Localized: 'Greatmother: Haben sie etwa auch an deine Tür geklopft?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832076
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832077
    m_Localized: Einer von ihnen lungert die ganze Zeit hier rum
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832078
    m_Localized: 'Greatmother: Diese Bastarde! Man sollte ihnen die Anzüge vom Leib reißen und sie mit einem Tritt in die Quarantänezone befördern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832079
    m_Localized: 'Greatmother: Dann wissen sie, wie es den echten Leuten geht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832080
    m_Localized: 'Greatmother: Übernehmen sie jetzt etwa auch Gebäude?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832081
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832082
    m_Localized: 'Greatmother: Die reinsten Wilden, das schwör ich dir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832083
    m_Localized: 'Greatmother: Einmal, von mir aus. Aber immer und immer wieder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832084
    m_Localized: 'Greatmother: Kein Schamgefühl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832085
    m_Localized: 'Greatmother: Oh, Herzchen ... Bitte lass niemanden rein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832086
    m_Localized: Haben sie ein Mitglied deiner Familie festgenommen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832087
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832088
    m_Localized: 'Greatmother: Oh, wie lange hat mich schon niemand mehr nach meiner Familie gefragt, Herzchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832089
    m_Localized: 'Greatmother: Meine Familie ist riesig. Ich habe jede Menge Kinder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832090
    m_Localized: 'Greatmother: So, so viele ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832091
    m_Localized: 'Greatmother: Wir haben kaum noch Platz in unserem Heim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832092
    m_Localized: 'Greatmother: Hinter diesen verschlossenen Türen versteckt sich eine arme kleine Seele vor diesen verdammten Verrückten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832093
    m_Localized: Du hast meine Frage nicht beantwortet
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832094
    m_Localized: Haben sie deine Familie mitgenommen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832095
    m_Localized: 'Greatmother: Oh ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832096
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832097
    m_Localized: 'Greatmother: Entschuldige, Herzchen, ich habe mich mitreißen lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832098
    m_Localized: 'Greatmother: Ja. Diese Bastarde im Anzug haben sie mir alle weggenommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832099
    m_Localized: 'Greatmother: Aber damit kommen sie nicht davon, oh nein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832100
    m_Localized: 'Greatmother: Haben sie dir auch jemanden genommen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832101
    m_Localized: Ich habe keine Familie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832102
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832103
    m_Localized: 'Greatmother: Oh ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832104
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832105
    m_Localized: 'Greatmother: Entschuldige, Herzchen, ich habe mich mitreißen lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832106
    m_Localized: 'Greatmother: Ja. Diese Bastarde im Anzug haben sie mir alle weggenommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832107
    m_Localized: 'Greatmother: Haben sie dir auch jemanden genommen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832108
    m_Localized: Ich habe keine Familie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832109
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832110
    m_Localized: 'Greatmother: Nein? Warum hast du dann so ein großes Haus?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832111
    m_Localized: 'Greatmother: Hattest du Mitbewohner oder so?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832112
    m_Localized: 'Greatmother: Ein großes Haus bedeutet eine große Familie, oder nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832113
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832114
    m_Localized: 'Greatmother: Na gut, ich werde dich nicht zwingen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832115
    m_Localized: 'Greatmother: Ich wünschte nur, ich könnte meine Lieben aus den Zonen zurückholen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832116
    m_Localized: 'Greatmother: Dich haben sie nicht angerührt, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832117
    m_Localized: 'Greatmother: Wo sind dann deine Leute?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832118
    m_Localized: 'Greatmother: So ein großer Ort wurde doch nicht für eine Person gebaut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832119
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832120
    m_Localized: 'Greatmother: Schon gut, ich bohre nicht weiter nach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832121
    m_Localized: 'Greatmother: Ich will nur, dass meine Lieben endlich aus dieser verdammten Zone kommen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832122
    m_Localized: 'Greatmother: Oh, Herzchen ... Bitte lass niemanden rein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832123
    m_Localized: Wie willst du deine Familie zurückbekommen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832124
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832125
    m_Localized: 'Greatmother: Ich werde ihnen nicht helfen, Herzchen. Sie kommen da schon allein raus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832126
    m_Localized: Wie meinst du das?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832127
    m_Localized: Allein?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832128
    m_Localized: 'Greatmother: Sie kriechen durch den Dreck zurück. Kommen aus dem Boden, nur eben auf der anderen Seite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832129
    m_Localized: 'Greatmother: Lächerliche Zäune und Drähte können sie nicht aufhalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832130
    m_Localized: 'Greatmother: Und wenn sie nicht von unten kommen können, werden sie diese Zone auseinandernehmen. Keiner bleibt zurück.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832131
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832132
    m_Localized: 'Greatmother: Da kommen sie schon. Ich kann sie hören.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832133
    m_Localized: Wovon zur Hölle redest du da?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832134
    m_Localized: Hast du den Verstand verloren?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832135
    m_Localized: Wie meinst du das?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832136
    m_Localized: (Sie töten)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832137
    m_Localized: 'Greatmother: Die Mauern werden fallen, wenn die Zeit gekommen ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832138
    m_Localized: 'Greatmother: Es wird Tod geben, so viel Tod ... Und er wird kommen und sich danach verzehren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832139
    m_Localized: 'Greatmother: Und diese Anzüge werden meine Leute in Ruhe lassen. Sie haben dann ganz andere Probleme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832140
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832141
    m_Localized: 'Greatmother: Da kommen sie schon. Ich kann sie hören.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832142
    m_Localized: Wovon zur Hölle redest du da?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832143
    m_Localized: Hast du den Verstand verloren?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832144
    m_Localized: Wie meinst du das?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832145
    m_Localized: (Sie töten)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832146
    m_Localized: 'Greatmother: Wir machen eure Gehege dem Erdboden gleich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832147
    m_Localized: 'Greatmother: Die Mauern werden bröckeln ... und Blut wird die Straßen rot färben ... von den aufgetürmten Leichen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832148
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832149
    m_Localized: 'Greatmother: Ich höre, wie sie gekrochen kommen. Sie sind fast da.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832150
    m_Localized: Was soll das heißen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832151
    m_Localized: Wer bist du?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832152
    m_Localized: Bist du eine Besucherin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832153
    m_Localized: (Sie töten)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832154
    m_Localized: 'Greatmother: Verbranntes Fleisch riecht so süß ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832155
    m_Localized: 'Greatmother: Die Anzüge kochen es so gut. Vielleicht etwas zu knusprig. Nur ein bisschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832156
    m_Localized: 'Greatmother: Du hast jede Menge Leichen, Herzchen. Mehr als genug für ein Festmahl. Meine Leute werden hier gut speisen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832157
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832158
    m_Localized: 'Greatmother: Ich höre, wie sie gekrochen kommen. Sie sind fast da.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832159
    m_Localized: Was soll das heißen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832160
    m_Localized: Wer bist du?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832161
    m_Localized: Bist du eine Besucherin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832162
    m_Localized: (Sie töten)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832163
    m_Localized: 'Greatmother: Dieses Haus ist ein guter Ort. Ein besonderer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832164
    m_Localized: 'Greatmother: Großes Haus, aber kaum Leute darin. Genug Platz für alle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832165
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832166
    m_Localized: 'Greatmother: Ich höre, wie sie gekrochen kommen. Sie sind fast da.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832167
    m_Localized: Was soll das heißen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832168
    m_Localized: Wer bist du?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832169
    m_Localized: Bist du eine Besucherin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832170
    m_Localized: (Sie töten)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832171
    m_Localized: 'Greatmother: Du wertloses Stück Scheiße ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832172
    m_Localized: 'Greatmother: Sie werden dich holen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832173
    m_Localized: 'Greatmother: Kinder, wir haben ein neues Nest gefunden. Endlich können wir uns ausruhen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832174
    m_Localized: 'Greatmother: Kommt hergekrochen, er braucht dieses Haus nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832175
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832176
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832177
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832178
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832179
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832180
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832181
    m_Localized: 'Greatmother: Mama will ihre Babys sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832182
    m_Localized: 'Greatmother: Kommt schon, dieses Haus ist genau richtig für uns.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832183
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832184
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832185
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832186
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832187
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832188
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832189
    m_Localized: 'Greatmother: Kriecht, Kinder. Ich bin hier. Ich habe ein neues Zuhause für uns.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832190
    m_Localized: 'Greatmother: So geräumig. So schön.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832191
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832192
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832193
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832194
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832195
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832196
    m_Localized: (SIE TÖTEN)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832197
    m_Localized: 'Greatmother: Nein. Gib uns dieses Haus. Du hasst es doch sowieso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832198
    m_Localized: 'Greatmother: Du willst es brennen sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026368
    m_Localized: GIB ES UNS!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026369
    m_Localized: 'Greatmother: Warum wehrst du dich? Ich weiß, was du willst ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026370
    m_Localized: 'Greatmother: Tod ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026371
    m_Localized: 'Wolfhound: Hast du was zu sagen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220672
    m_Localized: Warum betrachtest du Menschen als Tiere?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220673
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220674
    m_Localized: 'Wolfhound: Lass mich dich was fragen. Was sind wir denn?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220675
    m_Localized: 'Wolfhound: Wir töten, wir essen, was wir töten, und wir zucken dabei nicht mit der Wimper. Das nennt man Natur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220676
    m_Localized: 'Wolfhound: Aber die Gesellschaft hat uns an die Leine gelegt. Zu unserem Glück gehört das der Vergangenheit an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220677
    m_Localized: Wie meinst du das?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220678
    m_Localized: Bist du etwa glücklich darüber, wie es gekommen ist?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220679
    m_Localized: 'Wolfhound: Es ist ganz einfach. Die dummen Regeln der Gesellschaft sind passé. Jetzt ist alles klar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220680
    m_Localized: 'Wolfhound: Es gibt ein Rudel und einen Anführer. Wer das Überleben des Rudels bedroht, stirbt. Diesem Kodex folge ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220681
    m_Localized: 'Wolfhound: Aber das Schlimmste? Wölfe im Schafspelz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220682
    m_Localized: Du glaubst also, ein Rudel sei besser als eine Gesellschaft?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220683
    m_Localized: Schafe im Wolfspelz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220684
    m_Localized: 'Wolfhound: Ich bin nur froh, dass die Leute sich nicht mehr hinter Masken verstecken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220685
    m_Localized: 'Wolfhound: Aber diese Schafe ruinieren alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220686
    m_Localized: 'Wolfhound: Sie werfen sich Wolfspelze über und spielen allen was vor. Tun so, als hätten sie die Instinkte eines echten Mannes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220687
    m_Localized: 'Wolfhound: Feiglinge, die Löcher im Deck buddeln. Ich ziehe einen direkten Kampf diesem Katz-und-Maus-Spiel jederzeit vor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220688
    m_Localized: 'Wolfhound: Aber wenn man sich ein Rudel aufbaut, lernt man, die Unechten zu erkennen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220689
    m_Localized: Du glaubst also, ein Rudel sei besser als eine Gesellschaft?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220690
    m_Localized: Schafe im Wolfspelz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220691
    m_Localized: 'Wolfhound: Zweifelst du etwa daran?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220692
    m_Localized: 'Wolfhound: In der Gesellschaft hättest du diese Schafe nie erkannt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220693
    m_Localized: 'Wolfhound: Zu viel Gerede, zu viele Regeln. Man verstrickt sich in Diskussionen, statt zu tun, was getan werden muss.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220694
    m_Localized: 'Wolfhound: Darum braucht es einen Anführer. Keine Fragen, keine Abstimmungen. Sein Wort ist Gesetz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220695
    m_Localized: 'Wolfhound: Ein Anführer MUSS Stärke zeigen. Nur so kann das Rudel überleben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220696
    m_Localized: 'Wolfhound: Ja, ich rede von diesem feigen Abschaum, den du „Besucher“ nennst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220697
    m_Localized: 'Wolfhound: Sie verstecken sich im Untergrund wie Ratten und warten darauf, dass wir schwach werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220698
    m_Localized: 'Wolfhound: Jetzt machen sie sich die menschliche Moral zunutze. Setzen auf unser Mitleid, damit wir sie schwerer töten können.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220699
    m_Localized: 'Wolfhound: Darum müssen wir die Reißzähne zeigen. Sie daran erinnern, dass wir Tiere sind. Sonst verdrängen sie uns.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220700
    m_Localized: 'Wolfhound: Hast du was zu sagen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220701
    m_Localized: Warum starrst du meine Waffe an?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220702
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220703
    m_Localized: 'Wolfhound: Ich sehe einen Anführer in dir. Du bringst alle auf Kurs und hast bewiesen, dass du die Zügel in der Hand hältst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220704
    m_Localized: 'Wolfhound: Schicke Hütte hast du da. Hier kommen oft Leute vorbei. Großes Haus. Aber deine Mitbewohner ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220705
    m_Localized: Was soll mit ihnen sein?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220706
    m_Localized: Denkst du, es sind Besucher unter ihnen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220707
    m_Localized: 'Wolfhound: Du hast Schwächlinge versammelt. Weiche Typen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220708
    m_Localized: 'Wolfhound: Sag mal, was willst du denn mit den Alten, den Kindern und den Kranken?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220709
    m_Localized: 'Wolfhound: Ein Rudel braucht starke Mitglieder. Nur so kann es überleben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220710
    m_Localized: Und was sollte ich deiner Meinung nach tun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220711
    m_Localized: Soll ich sie rauswerfen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220712
    m_Localized: 'Wolfhound: Es geht nicht um Schafe im Wolfspelz. Es sind die schwachen Wölfe, die mir Sorgen bereiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220713
    m_Localized: 'Wolfhound: Dein Rudel hat keinen harten Kern. Die Leute kommen und gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220714
    m_Localized: 'Wolfhound: Wähle die Stärksten. Und bleib bei ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220715
    m_Localized: Und was sollte ich deiner Meinung nach tun?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220716
    m_Localized: Soll ich sie rauswerfen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220717
    m_Localized: 'Wolfhound: Du musst die Schwachen loswerden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220718
    m_Localized: 'Wolfhound: Töte sie. Vor aller Augen. Setze ein Statement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220719
    m_Localized: 'Wolfhound: So festigst du deine Position. So zeigst du, wer der Alpha ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220720
    m_Localized: 'Wolfhound: Und die, die nicht mit der Wimpern zucken, wenn die Schwachen sterben ... das sind die echten Wölfe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220721
    m_Localized: 'Wolfhound: Sie bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220722
    m_Localized: Ich bin kein Mörder
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220723
    m_Localized: Ich töte nur Besucher
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220724
    m_Localized: 'Wolfhound: Wenn du sie in Ruhe lässt, bröckelt deine Autorität. Sie werden dich für schwach halten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220725
    m_Localized: 'Wolfhound: Gnade ist nichts anderes als Schwäche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220726
    m_Localized: 'Wolfhound: Du musst rücksichtslos sein. Besucher? Erschießen. Schwache, Kranke, Alte? Erschießen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220727
    m_Localized: 'Wolfhound: So bringst du sie dazu, dich zu fürchten. So führst du.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220728
    m_Localized: Ich bin kein Mörder
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220729
    m_Localized: Ich töte nur Besucher
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220730
    m_Localized: 'Wolfhound: Mach mir nichts vor! Ich sehe es doch in deinen Augen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220731
    m_Localized: 'Wolfhound: Du hast getötet. Wasch deine Hände nicht in Unschuld.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220732
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220733
    m_Localized: 'Wolfhound: Ich war der Chef auf der Straße.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220734
    m_Localized: 'Wolfhound: Die Leute hatten Angst vor mir. Respekt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220735
    m_Localized: 'Wolfhound: Hast du dich je gefragt, wie lange es dauert, um deine Seele zu beflecken?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220736
    m_Localized: 'Wolfhound: Ich habe mir Zeit gelassen. Habe die Verdorbenheit genährt. Verstehst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220737
    m_Localized: 'Wolfhound: Eines Tages weigerte sich dieser eine Taxifahrer, mich mitzunehmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220738
    m_Localized: 'Wolfhound: Hätte ich ihm das durchgehen lassen, wäre mein Ruf dahin gewesen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220739
    m_Localized: 'Wolfhound: Also habe ich ihm jeden einzelnen Knochen gebrochen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220740
    m_Localized: 'Wolfhound: Aber sein Sohn hat die Lektion gelernt. Und die Leute haben mich weiter respektiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220741
    m_Localized: 'Wolfhound: Du wärst besser dran, wenn du aufhören würdest, die Schwachen zu verhätscheln.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220742
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220743
    m_Localized: 'Wolfhound: Ich war der Chef auf der Straße.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220744
    m_Localized: 'Wolfhound: Die Leute hatten Angst vor mir. Respekt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220745
    m_Localized: 'Wolfhound: Hast du dich je gefragt, wie lange es dauert, um deine Seele zu beflecken?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220746
    m_Localized: 'Wolfhound: Ich habe mir Zeit gelassen. Habe die Verdorbenheit genährt. Verstehst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220747
    m_Localized: 'Wolfhound: Eines Tages weigerte sich dieser eine Taxifahrer, mich mitzunehmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220748
    m_Localized: 'Wolfhound: Hätte ich ihm das durchgehen lassen, wäre mein Ruf dahin gewesen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220749
    m_Localized: 'Wolfhound: Also habe ich ihm jeden einzelnen Knochen gebrochen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220750
    m_Localized: 'Wolfhound: Aber sein Sohn hat die Lektion gelernt. Und die Leute haben mich weiter respektiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220751
    m_Localized: 'Wolfhound: Hast du was zu sagen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220752
    m_Localized: Du redest doch immer von Rudeln. Warum hast du kein eigenes?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220753
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220754
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220755
    m_Localized: 'Wolfhound: Warum hast du dir deins gesucht?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220756
    m_Localized: Damit dieser große bleiche Besucher mich nicht abmurkst
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220757
    m_Localized: Ich versuche, den Leuten zu helfen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220758
    m_Localized: Ich bin einfach nicht gern allein
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220759
    m_Localized: Weil diese Leute einen Anführer brauchen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220760
    m_Localized: Ich hab zuerst gefragt
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220761
    m_Localized: 'Wolfhound: Also hast du sie versammelt, um deine eigene Haut zu retten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220762
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220763
    m_Localized: 'Wolfhound: Das klingt nicht nach einem Alpha. Das klingt nach einem verängstigten kleinen Köter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220764
    m_Localized: 'Wolfhound: Dieses Rudel braucht jemanden, der stark ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220765
    m_Localized: 'Wolfhound: Schätze, ich muss deinen Platz einnehmen. Du bist als Anführer nicht geeignet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220766
    m_Localized: 'Wolfhound: Ein ehrbares Ziel. Wenn auch ein bisschen albern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220767
    m_Localized: 'Wolfhound: Du kannst nicht alle retten. Früher oder später musst du jemanden wegschicken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220768
    m_Localized: 'Wolfhound: Aber du klingst wie ein Alpha. Das hinterfrage ich nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220769
    m_Localized: 'Wolfhound: Das ist alles? Du hast Angst, allein zu sein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220770
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220771
    m_Localized: 'Wolfhound: Sowas würde ein Alpha nie sagen. Das sind die Worte eines Feiglings.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220772
    m_Localized: 'Wolfhound: Na, das klingt doch nach einem echten Mann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220773
    m_Localized: 'Wolfhound: Dann werde ich deinen Thron nicht anfechten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220774
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220775
    m_Localized: 'Wolfhound: Das werde ich nicht beantworten. Je weniger du weißt, desto besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220776
    m_Localized: 'Wolfhound: Ich habe dir schon mehr gesagt, als ich sollte. Jetzt bist du dran.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220777
    m_Localized: 'Wolfhound: Wenn du nicht zum Anführer taugst, werde ich deinen Platz selbst einnehmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220778
    m_Localized: Fahr zur Hölle!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220779
    m_Localized: Warum glaubst du, dass du besser bist als ich?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220780
    m_Localized: (Waffe ziehen)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220781
    m_Localized: Verschwinde, bevor ich dir eine Kugel verpasse
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220782
    m_Localized: 'Wolfhound: KLAPPE, WELPE. Du bist jetzt ein Niemand für mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220783
    m_Localized: 'Wolfhound: Wenn du nicht weißt, warum du führst, warum hast du dann den Job angenommen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220784
    m_Localized: 'Wolfhound: Du solltest abhauen. Sonst mach ich dich kalt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220785
    m_Localized: 'Wolfhound: Ich weiß, was ein Rudel ist. Ich lebe nach dem Kodex.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220786
    m_Localized: 'Wolfhound: Wer so schwach ist, ist kein Alpha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220787
    m_Localized: 'Wolfhound: Du solltest abhauen. Sonst mach ich dich kalt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220788
    m_Localized: 'Wolfhound: So läuft das.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220789
    m_Localized: 'Wolfhound: Du weißt schon, dass ich eine Waffe habe, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220790
    m_Localized: 'Wolfhound: Nimm deine lieber runter. Ziehen wir einen klaren Schlussstrich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220791
    m_Localized: (Ihn erschießen)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220792
    m_Localized: (Waffe ablegen)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220793
    m_Localized: 'Wolfhound: Stirb, du Hur...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220794
    m_Localized: 'Wolfhound: Du Bastard! Du hast echt auf mich geschossen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220795
    m_Localized: 'Wolfhound: Braver Junge'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220796
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220797
    m_Localized: 'Wolfhound: Aber du hättest es zu Ende bringen sollen'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220798
    m_Localized: 'Wolfhound: (Er nutzt die Chance und zieht seine Waffe)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220799
    m_Localized: 'Wolfhound: (Er zielt auf Sie)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220800
    m_Localized: 'Wolfhound: (Zum Glück können Sie sich die Schrotflinte schnappen und abdrücken)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220893
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220894
    m_Localized: Sie haben also die Fäden abgeschnitten?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220895
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220896
    m_Localized: 'Foreigner: Gdv lvw hlq Doewudxp!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220897
    m_Localized: 'Foreigner: Vlh kdyhq PHLQHQ PXQG CXJQDHKW! Qxu, zhil vlh plfk qlfkw yhuvwhkhq.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220898
    m_Localized: Ich kann Sie nicht verstehen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220899
    m_Localized: Verstehen Sie, was ich sage?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220900
    m_Localized: 'Foreigner: Lfk yhuvwhkh Vla qlfkw. Zdv vroohq zlu wxq?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220901
    m_Localized: 'Foreigner: Lujhqghlqh Vsudfkh huilqghq?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220902
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220903
    m_Localized: Wie soll ich nur mit Ihnen kommunizieren?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220904
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220905
    m_Localized: 'Foreigner: Lfk ndqq Lkuh Zruwh zlhghukrohq xqg Vlh nöqqhq gdudxi uhdjlhuhq.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220906
    m_Localized: 'Foreigner: Ylhoohlfkw zhlß lfk gdqq zhqljvwhqv, zdv lfk vdjh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220907
    m_Localized: 'Foreigner: Wie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220908
    m_Localized: Was, wie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220909
    m_Localized: Versuchen Sie, mich etwas zu fragen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220910
    m_Localized: 'Foreigner: Lfk yhuvwhkh lpphu qrfk qlfkw. Dehu Vlh kdehq hwzdv jhiudjw.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220911
    m_Localized: 'Foreigner: Ylhoohlfkw zdu hv hlq Iudjhzruw.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220912
    m_Localized: 'Foreigner: Lfk yhuvwhkh lpphu qrfk qlfkw. Dehu Vlh kdehq hwzdv jhiudjw.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220913
    m_Localized: 'Foreigner: Ylhoohlfkw zdu hv hlq Iudjhzruw.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220914
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220915
    m_Localized: Hey, wie geht es Ihnen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220916
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414976
    m_Localized: 'Foreigner: (Sie klopfen ihm auf die Schulter und zeigen auf die Wunden in der Nähe seines Mundes)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414977
    m_Localized: Alles in Ordnung?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414978
    m_Localized: Tut es weh?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414979
    m_Localized: 'Foreigner: Nöqqhq Vlh gdv zlhghukrohq?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414980
    m_Localized: 'Foreigner: Ghhh-uut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414981
    m_Localized: 'Foreigner: Ghhh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414982
    m_Localized: 'Foreigner: Ghuudt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414983
    m_Localized: 'Foreigner: Hv lvw vfkzhu, dehu ylhoohlfkw kloiw hv.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414984
    m_Localized: 'Foreigner: Lfk iudjh plfk, re lq phlqhp Odqg gdvvhoeh sdvvlhuw.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414985
    m_Localized: 'Foreigner: Zdv iüu hlq Doewudxp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414986
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414987
    m_Localized: Wie wollen Sie nach Hause kommen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414988
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414989
    m_Localized: 'Foreigner: (Sie bilden mit Ihren Handflächen eine Dachform über Ihrem Kopf)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414990
    m_Localized: 'Foreigner: Qdfk Kdxvh? Iudjhq Vlh qdfk phlqhp cxkdxvh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414991
    m_Localized: 'Foreigner: Lfk zroowh hlqhq Iuhxqg ehvxfkhq xqg gdqq lvw gdv klhu sdvvlhuw.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414992
    m_Localized: 'Foreigner: Glh Vlwxdwlrq lvw ehvfklvvhq, pdq ndqq hv qlfkw dqghuv vdjhq.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414993
    m_Localized: Wie soll ich Sie nach Hause schicken? Mit dem Flugzeug?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414994
    m_Localized: Haben Sie die Schiffstickets schon überprüft?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414995
    m_Localized: 'Foreigner: (Sie machen mit der Hand eine schwungvolle Bewegung nach unten)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414996
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414997
    m_Localized: 'Foreigner: Hlq Ioxjchxj? Jodxehq Vlh, glh iolhjhq qrfk?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414998
    m_Localized: 'Foreigner: Lfk vroowh hv lujhqgzr khudxvilqghq.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414999
    m_Localized: 'Foreigner: Ylhoohlfkw jlew hv qrfk hlqhq Dxvzhj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415000
    m_Localized: 'Foreigner: (Sie bewegen Ihre Hand wie ein Schiff auf den Wellen)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415001
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415002
    m_Localized: 'Foreigner: Dxi hlqhp Vfklii vhjhoq?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415003
    m_Localized: 'Foreigner: Idkuhq glh qrfk? Lfk pxvv plfk hunxqgljhq, gdqnh!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415004
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415005
    m_Localized: Warum tun Sie so überheblich?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415006
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415007
    m_Localized: 'Foreigner: (Sie lächeln und zeigen mit dem Finger auf das Lächeln, dann auf ihn)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415008
    m_Localized: 'Foreigner: Rk, gdv kdehq Vlh jhphlqw.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415009
    m_Localized: 'Foreigner: Vlh kdehq plu jhvdjw, gdvv qrfk cüjh idkuhq! Nöqqhq Vlh gdv jodxehq?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415010
    m_Localized: 'Foreigner: (Er fährt mit einer Hand an seinem anderen Arm entlang)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415011
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415012
    m_Localized: Gibt es jemanden, der Sie nach Hause fahren kann?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415013
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415014
    m_Localized: 'Foreigner: Lfk yhuvwhkh qlfkw, phlq Iuhxqg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415015
    m_Localized: 'Foreigner: Prujhq jhkh lfk qdfk Kdxvh! Rghu cxplqghvw cxp Edkqkri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415016
    m_Localized: 'Foreigner: Khxwh Dehqg jhkh lfk. Wvfküvv!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415017
    m_Localized: 'Foreigner: Thschuss!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415018
    m_Localized: Meinen Sie den Zug?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415019
    m_Localized: Sind Sie auf dem Weg irgendwohin?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415020
    m_Localized: 'Foreigner: Gdv kdeh lfk qlfkw yhuvwdqghq, wxw plu ohlg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415021
    m_Localized: 'Foreigner: Dehu prujhq jhkh lfk cxp Edkqkri xqg vhkh vhoevw qdfk.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415022
    m_Localized: 'Foreigner: Ylhoohlfkw nrpph lfk qdfk doo ghp hqgolfk qdfk Kdxvh ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415023
    m_Localized: 'Foreigner: Fhhielgluck!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415024
    m_Localized: 'Edgar: Was für eine angenehme Stille ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415025
    m_Localized: Wie geht es Ihrem Arm?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415026
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415027
    m_Localized: 'Edgar: Ich habe schon seit einer Weile kein Gefühl mehr darin, auch wenn der Schmerz und die Kälte noch da sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415028
    m_Localized: 'Edgar: Aber das ist zu erwarten. Ich möchte den schönsten Moment hinauszögern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415029
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415030
    m_Localized: 'Edgar: Es gab mal ein Mädchen, das ich sehr verehrte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415031
    m_Localized: 'Edgar: Ich genoss unsere gemeinsame Zeit. Wir saßen schweigend da, und doch verstand ich sie ohne Worte. Da wurde es mir klar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415032
    m_Localized: 'Edgar: Ich mache mir selbst etwas vor. Ich habe sie nie wirklich gekannt. Vielleicht wollte ich es nur glauben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415033
    m_Localized: 'Edgar: Dennoch hoffe ich, dass ich sie eines Tages verstehen werde. Aufrichtig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415034
    m_Localized: 'Edgar: Was für eine angenehme Stille ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415035
    m_Localized: Erzählen Sie mir von diesem Mädchen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415036
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415037
    m_Localized: 'Edgar: In ihren Augen spiegelte sich das kalte Schimmern des Mondes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415038
    m_Localized: 'Edgar: Sie war das genaue Gegenteil der Katastrophe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415039
    m_Localized: 'Edgar: An ihrer Seite hatte ich das Gefühl, dass da was Geheimnisvolles in der Luft lag.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415040
    m_Localized: 'Edgar: Und ich verzehre mich danach, ihre Geheimnisse zu lüften.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415041
    m_Localized: 'Edgar: Jetzt ist sie mein Monument.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415042
    m_Localized: 'Edgar: Mein Leuchtfeuer, das mir den Weg weist, wenn ich davon abkomme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415043
    m_Localized: 'Edgar: Was für eine angenehme Stille ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415044
    m_Localized: Wie haben Sie sie kennengelernt?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415045
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415046
    m_Localized: 'Edgar: Es kam der Moment, in dem ich wusste, was mich erwartete. Die Sepsis würde mich bald holen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415047
    m_Localized: 'Edgar: Der Gedanke jagte mir Angst ein. Meine Zeit geht zu Ende. Nicht irgendwann, sondern in wenigen Monaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415048
    m_Localized: 'Edgar: Und dann, als die Besucher aus der Erde hervorkrochen ... fand ich sie in einem der Häuser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415049
    m_Localized: 'Edgar: Ein Mädchen, gehüllt in weißes Leinen, mit einem Gesicht von eindringlicher Schönheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415050
    m_Localized: 'Edgar: In dieser grausamen Welt, in der jeder für sich kämpft, scherte sich niemand um eine solche Schönheit. Außer mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415051
    m_Localized: 'Edgar: Kennen Sie dieses Sprichwort? „Zu kostbar, um es abzulehnen. Zu schrecklich, um es anzunehmen.“'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415052
    m_Localized: 'Edgar: Und doch ... wiegte ich ihren zerbrechlichen Körper und trug sie nach Hause.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415053
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415054
    m_Localized: 'Edgar: Wenn das Ende kommt, kann ich sagen, dass ich alles, was ich jemals getan habe, aus Liebe getan habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415055
    m_Localized: 'Edgar: Was für eine angenehme Stille ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415056
    m_Localized: Wo ist dieses Mädchen jetzt?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415057
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415058
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415059
    m_Localized: 'Edgar: Ich habe so lange versucht, ihre Schönheit zu erfassen. Die Macht ihrer Stille.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415060
    m_Localized: 'Edgar: Aber dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415061
    m_Localized: 'Edgar: ... stürmten gesichtslose Männer in gelben Anzügen in den Raum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415062
    m_Localized: 'Edgar: Sie packten sie und zerrten sie weg. Ich schätze, wir wissen beide, warum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415063
    m_Localized: 'Edgar: So eine Schande ... Ich habe sie nie verstanden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415064
    m_Localized: 'Edgar: Und so bin ich wieder allein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415065
    m_Localized: 'Edgar: Alle schreien laut, sie wollten die Welt retten, können sich aber nicht einigen, wie. Dabei ist die Antwort einfach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415066
    m_Localized: 'Edgar: Sie liegt in der Stille. In der Schönheit. Wenn man sie nur ... wahrnehmen könnte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415067
    m_Localized: 'Edgar: Sie hat versucht, es mir beizubringen. Doch ich fand nur Gelassenheit. Eine Vision der Anmut inmitten des Schreckens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415068
    m_Localized: 'Edgar: Zumindest ... bin ich jetzt bereit, ihr zu folgen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415128
    m_Localized: 'Provocateur: In was für einer Welt wir doch leben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415129
    m_Localized: Wie bitte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415130
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415131
    m_Localized: 'Provocateur: Es scheint, als hätten wir den Mietvertrag noch nicht endgültig geklärt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415132
    m_Localized: Und wie soll ich das genau machen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415133
    m_Localized: Ist das wirklich das Einzige, was Sie im Moment interessiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415134
    m_Localized: 'Provocateur: Sagen Sie mir nicht, dass Sie die Unterlagen nicht zur Hand haben?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415135
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415136
    m_Localized: 'Provocateur: Dann ... schlage ich vor, Sie suchen einen Notar auf und holen sie dort ab. Ganz ehrlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415137
    m_Localized: Machen Sie Witze? Wo soll ich denn jetzt einen Notar finden?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415138
    m_Localized: Warum machen Sie das nicht selbst?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415139
    m_Localized: 'Provocateur: Bei allem Respekt, ich würde es schätzen, wenn Sie mich richtig ansprechen würden. „Gnädiger Herr“ wäre angemessen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415140
    m_Localized: 'Provocateur: Was für ein Trottel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415141
    m_Localized: Wie Sie meinen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415142
    m_Localized: Gehen Sie mir nicht auf die Nerven
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415143
    m_Localized: 'Provocateur: Sie wissen doch, wie man eine Karte benutzt, oder? Das ist nicht gerade kompliziert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415144
    m_Localized: 'Provocateur: Und ich bestehe darauf, dass Sie mich respektvoll ansprechen. Verwenden Sie „gnädiger Herr“.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415145
    m_Localized: Wie Sie meinen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415146
    m_Localized: Gehen Sie mir nicht auf die Nerven
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415147
    m_Localized: 'Provocateur: Und warum genau sollte ich hier die Besorgungen machen? Und übrigens, sprechen Sie mich bitte mit „gnädiger Herr“ an!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415148
    m_Localized: 'Provocateur: Ich bin ein angesehener Bürger, kein Laufbursche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415149
    m_Localized: Wie Sie meinen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415150
    m_Localized: Gehen Sie mir nicht auf die Nerven
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415151
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415152
    m_Localized: 'Provocateur: Sie machen das absichtlich, nicht wahr? Sie könnten wenigstens so tun, als wären Sie kooperativ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415153
    m_Localized: 'Provocateur: Achten Sie auf Ihren Tonfall. Artikel 21 der Verfassung garantiert meine Menschenwürde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415154
    m_Localized: 'Provocateur: Ich empfehle Ihnen daher dringend, mir etwas Respekt entgegenzubringen, bevor es ... unangenehm wird.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415155
    m_Localized: 'Provocateur: In was für einer Welt wir doch leben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415156
    m_Localized: Jetzt lassen Sie es doch mal gut sein
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415157
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415158
    m_Localized: 'Provocateur: Ich warte immer noch darauf, dass Sie den Mietvertrag ausfertigen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415159
    m_Localized: Ich habe nichts, womit ich ihn ausfertigen könnte
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415160
    m_Localized: Das ist doch wohl ein Scherz
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415161
    m_Localized: 'Provocateur: Hm. Bedauerlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415162
    m_Localized: 'Provocateur: Ich fürchte, das könnte einen Verstoß gegen Artikel 131 darstellen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415163
    m_Localized: Sie treiben mich echt zur Weißglut
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415164
    m_Localized: Sind Sie es nicht leid, ständig Gesetze zu zitieren?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415165
    m_Localized: 'Provocateur: Zu Ihrer Information: Laut Artikel 131 ist der Vertrag bindend. Ich bin ein verantwortungsbewusster und gesetzestreuer Bürger.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415166
    m_Localized: Sie treiben mich echt zur Weißglut
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415167
    m_Localized: Sind Sie es nicht leid, ständig Gesetze zu zitieren?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415168
    m_Localized: 'Provocateur: Ah, da haben wir sie ja, die Beleidigungen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415169
    m_Localized: 'Provocateur: Das fällt übrigens unter Verwaltungsgesetz 5.61.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415170
    m_Localized: 'Provocateur: Machen Sie nur weiter. Das wird sich alles rächen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415171
    m_Localized: 'Provocateur: Und nein, ich bin es nicht leid, mich auf das Gesetz und die Verfassung zu berufen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415172
    m_Localized: 'Provocateur: Ich kenne meine Rechte! Nur weil Sie unwissend sind, bedeutet das nicht, dass niemand sonst Anspruch darauf hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415173
    m_Localized: 'Provocateur: Und noch einmal! Ich habe Ihnen gesagt, Sie sollen mich angemessen ansprechen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415174
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415175
    m_Localized: 'Provocateur: Sie lernen es wirklich nie, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415176
    m_Localized: 'Provocateur: In was für einer Welt wir doch leben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415177
    m_Localized: Wie bitte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415178
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415179
    m_Localized: 'Provocateur: Mir ist aufgefallen, dass Sie eine Schusswaffe haben. Darf ich mal Ihren Waffenschein sehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415180
    m_Localized: Das geht Sie nichts an
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415181
    m_Localized: Was haben Sie nur gegen mich?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415182
    m_Localized: 'Provocateur: Ah, ich verstehe. Sie zeigen mir keinen Waffenschein, also haben Sie keinen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415183
    m_Localized: 'Provocateur: Glauben Sie, nur weil Sie eine Waffe haben, stehen Sie über dem Gesetz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415184
    m_Localized: 'Provocateur: Dass Sie jeden verhören können, ohne selbst befragt zu werden?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415185
    m_Localized: 'Provocateur: Da irren Sie sich gewaltig!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415186
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415187
    m_Localized: 'Provocateur: Wie heißt es so schön: Es gibt immer einen, der größer ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415188
    m_Localized: Das reicht. Ich habe schon genug um die Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415189
    m_Localized: Würden Sie bitte mit dem Unsinn aufhören?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415190
    m_Localized: 'Provocateur: Ich versuche nur herauszufinden, wer Sie wirklich sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415191
    m_Localized: 'Provocateur: Sie werden defensiv ... Ich habe einen wunden Punkt getroffen. Kein Schein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415192
    m_Localized: 'Provocateur: Sie glauben, die Regeln gelten nicht für Sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415193
    m_Localized: 'Provocateur: Sie glauben, Sie können Gefahren erschnüffeln, aber niemand darf Sie hinterfragen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415194
    m_Localized: 'Provocateur: Da irren Sie sich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415195
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415196
    m_Localized: 'Provocateur: Wie heißt es so schön: Es gibt immer einen, der größer ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415197
    m_Localized: Das reicht. Ich habe schon genug um die Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415198
    m_Localized: Würden Sie bitte mit dem Unsinn aufhören?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415199
    m_Localized: 'Provocateur: Oh, Sie haben es schwer, Sie Armer. Niemand hinterfragt Sie oder wagt zu prüfen, ob Sie ein Besucher sind. Das muss schrecklich sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415200
    m_Localized: 'Provocateur: Und wer genau hat Ihnen das Recht gegeben, zu entscheiden, wer lebt und wer stirbt? Woher nehmen Sie die Autorität?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415201
    m_Localized: 'Provocateur: Wir anderen sitzen herum und beten, dass wir nicht die Nächsten auf Ihrer Liste sind. Und jetzt wollen Sie Mitleid? Von mir? Also bitte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415202
    m_Localized: 'Provocateur: Oh, entschuldigen Sie meine Ausdrucksweise. Aber sind es nicht Sie, der alle mit seinen Tests behelligt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415203
    m_Localized: 'Provocateur: Sie schnüffeln herum und behandeln jeden wie einen potenziellen Mörder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415204
    m_Localized: 'Provocateur: Aber klar, zeigen wir ja nicht mit dem Finger auf den wahren Mörder. Denn vielleicht ... gibt es gar keine Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415205
    m_Localized: 'Provocateur: Und was sind Sie? Ein Wahnsinniger ... der seine Position und das Chaos ausnutzt, um den eigenen Blutdurst zu stillen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415206
    m_Localized: 'Provocateur: Und die Menschen? Sie hören die Panik im Radio und eilen zu Ihnen wie die Lämmer zur Schlachtbank.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415207
    m_Localized: 'Provocateur: Sagen Sie mir: Wie viele von denen, die ganz am Anfang hereingekommen sind, haben es tatsächlich lebend herausgeschafft?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415208
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415209
    m_Localized: 'Provocateur: Das dachte ich mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415210
    m_Localized: 'Provocateur: In was für einer Welt wir doch leben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415211
    m_Localized: Gnädiger Herr? Sie sind noch da?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415212
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415213
    m_Localized: 'Provocateur: Bemerkenswert ... Sie haben mich mit Respekt angesprochen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415214
    m_Localized: 'Provocateur: Schade, dass es ein wenig zu spät kommt. Ich werde das bald melden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415215
    m_Localized: Was melden?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415216
    m_Localized: Wem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415217
    m_Localized: 'Provocateur: Sie können mich nicht länger täuschen. Ich weiß genau, wer Sie sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415218
    m_Localized: 'Provocateur: Das ist nicht Ihr Heim. Sie haben den Besitzer ermordet und geben sich für ihn aus. Und ich werde die FEMA kontaktieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415219
    m_Localized: 'Provocateur: Genau, sie werden Sie holen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415220
    m_Localized: Unsinn
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415221
    m_Localized: Höchste Zeit, Sie endgültig zum Schweigen zu bringen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415222
    m_Localized: 'Provocateur: Die „Federal Emergency Management Agency“, kurz „FEMA“.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415223
    m_Localized: 'Provocateur: Zuerst habe ich mir nichts weiter dabei gedacht, dass Sie nicht einmal einen einfachen Vertrag ausfertigen konnten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415224
    m_Localized: 'Provocateur: Aber je länger ich mit Ihnen gesprochen habe, desto klarer wurde es mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415225
    m_Localized: 'Provocateur: Jetzt passt alles zusammen. Dies ist nicht Ihr Zuhause. Sie sind ein Betrüger.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415226
    m_Localized: 'Provocateur: Sie sind ein BESUCHER!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415227
    m_Localized: 'Provocateur: Packen Sie Ihre Sachen. Sie werden Sie holen. Noch heute Nacht!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415228
    m_Localized: Unsinn
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415229
    m_Localized: Höchste Zeit, Sie endgültig zum Schweigen zu bringen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415230
    m_Localized: 'Provocateur: Oh, ich werde das melden. Sie werden kommen. Warten Sie nur ab.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415231
    m_Localized: Wie auch immer. Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415232
    m_Localized: Sie sind tot (Waffe ziehen)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415233
    m_Localized: 'Provocateur: Versuchen Sie doch, mich zum Schweigen zu bringen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415234
    m_Localized: 'Provocateur: Moment, was?! Sind Sie verrückt?! Das ist eine Straftat!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415235
    m_Localized: 'Provocateur: Nein, nein, nein. Damit kommen Sie nicht durch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609280
    m_Localized: 'Provocateur: Ich bleibe hier, bis die FEMA kommt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609281
    m_Localized: 'Provocateur: Ich werde ihnen alles erzählen, was Sie getan haben und wie gefährlich Sie sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609282
    m_Localized: 'Provocateur: Moment, was?! Sind Sie verrückt?! Das ist eine Straftat!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609283
    m_Localized: 'Provocateur: Wagen Sie es ja nicht!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609284
    m_Localized: Sie gehen besser, bevor ich schieße
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609285
    m_Localized: Ich werde schießen, wenn Sie nicht gehen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609286
    m_Localized: Sie lassen mir keine Wahl
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609287
    m_Localized: (Ihn erschießen)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609288
    m_Localized: 'Provocateur: Ich werde nicht zulassen, dass Sie der FEMA entkommen. Nicht über meine Leiche!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609289
    m_Localized: 'Provocateur: Sie werden Sie früher oder später kriegen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609290
    m_Localized: 'Provocateur: Sie auch nicht!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609291
    m_Localized: 'Provocateur: SIE SIND EIN BESUCHER! EIN MÖRDER! SIE SIND KEIN MENSCH!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609292
    m_Localized: 'Provocateur: NEIN, TUN SIE DAS NICHT!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609293
    m_Localized: 'Provocateur: AAAAARGH!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609294
    m_Localized: 'Marauder: Mann ... ein bisschen ordentliche Beute wäre wirklich toll.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609295
    m_Localized: Wie läuft Ihre Karriere als Plünderer?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609296
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609297
    m_Localized: 'Marauder: Hm, ja. Ich dachte, hier wäre alles tot, also hab ich versucht, mich reinzuschleichen ... aber hier wohnen Leute.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609298
    m_Localized: 'Marauder: Ich klaue nichts von Lebenden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609299
    m_Localized: 'Marauder: Ich meine ... Was soll ein Toter schon mit einem Mantel anfangen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609300
    m_Localized: 'Marauder: Er ist nicht mehr. Das Zeug liegt da nur rum. Aber mir könnte es das Leben retten. Oder jemandem, der mir wichtig ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609301
    m_Localized: 'Marauder: Oder wollen Sie behaupten, dass Sie nichts von einer Leiche nehmen würden, um eine geliebte Person zu retten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609302
    m_Localized: 'Marauder: Vielleicht sollten wir aufhören, die Toten wie einen Schrein zu behandeln. Nur so ein Gedanke.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609303
    m_Localized: 'Marauder: Mann ... ein bisschen ordentliche Beute wäre wirklich toll.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609304
    m_Localized: Warum sind Sie zum Plünderer geworden?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609305
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609306
    m_Localized: 'Marauder: Was sollte ich denn machen? Ich wollte niemandem wehtun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609307
    m_Localized: 'Marauder: Also habe ich den dezenten Weg gewählt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609308
    m_Localized: 'Marauder: Die Toten wehren sich nicht, wissen Sie? Ihre Sachen sind einfach ... übrig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609309
    m_Localized: 'Marauder: Ich will niemandem wehtun. Ich versuche nur, am Leben zu bleiben. Und vielleicht helfe ich dabei ein paar anderen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609310
    m_Localized: 'Marauder: Mann ... ein bisschen ordentliche Beute wäre wirklich toll.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609311
    m_Localized: Was haben Sie beim Plündern so gefunden?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609312
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609313
    m_Localized: 'Marauder: Mann, ich habe zu viel gesehen, um alles aufzuzählen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609314
    m_Localized: 'Marauder: Mal überlegen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609315
    m_Localized: 'Marauder: Da war diese verlassene Bibliothek. Staubige Bücher standen noch in den Regalen, als würde sie gleich jemand abholen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609316
    m_Localized: 'Marauder: Ich bin in eine Ausstellung von Nachwuchskünstlern geraten. Die Bilder hingen noch an den Wänden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609317
    m_Localized: 'Marauder: Und dann ... habe ich einmal einen Sonnenuntergang gesehen. Einen besonderen. Sah aus, als wäre er an den Himmel gemalt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609318
    m_Localized: 'Marauder: Heutzutage riskiert niemand mehr, herumzustehen und den Himmel anzuschauen. Aber damals ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609319
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609320
    m_Localized: 'Marauder: Ich vermisse, wie es früher war. Ich bin immer früh aufgestanden. Ruhige Straßen. Tiefe Nebelschwaden. Feuchtes Gras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609321
    m_Localized: 'Marauder: Und die Sonne ... Mann, sie ging so hell auf, als wollte sie dir einen schönen Tag versprechen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609322
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609323
    m_Localized: 'Marauder: Und jetzt? Die Sonne ist unser Feind. Wie konnte das nur passieren?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609324
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609325
    m_Localized: 'Marauder: Ich wünschte, jemand hätte Antworten auf all diesen Mist. Das würde es vielleicht leichter machen zu atmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609326
    m_Localized: 'Marauder: Mann ... ein bisschen ordentliche Beute wäre wirklich toll.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609327
    m_Localized: Sind Sie mit dem Plündern fertig?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609328
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609329
    m_Localized: 'Marauder: Ich bin noch dabei. Aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609330
    m_Localized: 'Marauder: Einmal ... ja, einmal hat es mich echt mitgenommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609331
    m_Localized: 'Marauder: Ich habe dieses Haus gefunden. Leer. Eine Leiche auf dem Boden, das Übliche. Keine Gefahr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609332
    m_Localized: 'Marauder: Der Typ hatte Löcher im ganzen Rücken. Lag auf etwas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609333
    m_Localized: 'Marauder: Ich dachte mir, vielleicht hat er versucht, was zu verstecken. Ich ging näher ran, habe ihn umgedreht und ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609334
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609335
    m_Localized: 'Marauder: Hören Sie, ich erzähl es Ihnen später, okay? Ich bin noch nicht bereit, das noch mal zu durchleben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609336
    m_Localized: 'Marauder: Mann ... ein bisschen ordentliche Beute wäre wirklich toll.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609337
    m_Localized: Was war unter der Leiche?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609338
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609339
    m_Localized: 'Marauder: In Ordnung ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609340
    m_Localized: 'Marauder: Ich hab ihn umgedreht, und da war sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609341
    m_Localized: 'Marauder: Ein kleines Mädchen. Tot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609342
    m_Localized: 'Marauder: Bei Erwachsenen ... da rechnet man irgendwie damit. Aber ein Kind? Das ist was ganz anderes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609343
    m_Localized: 'Marauder: Wenn ich tote Kinder sehe, bekomme ich einen Kloß im Hals.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609344
    m_Localized: 'Marauder: Sie umklammerte so eine kleine Plüschkatze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609345
    m_Localized: 'Marauder: Völlig blutverschmiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609346
    m_Localized: 'Marauder: Das Gesicht des Mädchens hatte diesen Ausdruck ... als hätte sie gewusst, dass der Tod kommt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609347
    m_Localized: 'Marauder: Einen Moment lang hätte ich schwören können, dass sie mich ängstlich anschaut, als wollte ich ihr Spielzeug wegnehmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609348
    m_Localized: 'Marauder: Selbst im Tod ließ die Grausamkeit der Menschen sie nicht in Frieden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609349
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609350
    m_Localized: 'Marauder: Das hat mich mehr getroffen, als ich zugeben möchte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609351
    m_Localized: 'Marauder: An diesem Tag wollte ich aufhören, wollte die Toten in Ruhe lassen. Aber dafür ist es jetzt zu spät.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609352
    m_Localized: 'Marauder: Ich kann nur weitermachen. Weiter plündern. Das ist der einzige Weg, wie ich überleben kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609353
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609354
    m_Localized: 'Marauder: Die Leute sagen, man kann seinem Schicksal nicht entrinnen. Ich glaube, das stimmt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609355
    m_Localized: 'GraveDigger: Ich wünschte, die Besucher würden einfach wieder unter die Erde zurückkehren ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609356
    m_Localized: Warum sind Sie Totengräber geworden?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609357
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609358
    m_Localized: 'GraveDigger: Was? Ach, das? Keine Ahnung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609359
    m_Localized: 'GraveDigger: Ein Friedhof ist ... wie eine Art Bibliothek. Nur dass die Bücher nicht zum Lesen da sind. Sie liegen nur da. Still.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609360
    m_Localized: 'GraveDigger: Früher kannte ich jedes Grab. Wer wo liegt, wie ihre Hände verdreht waren, welche Kleidung sie trugen, ihre Namen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609361
    m_Localized: 'GraveDigger: Dann grabe ich eines Tages ein neues Loch, ganz normal, nichts Ungewöhnliches. Ich bin tief genug, und dann – bam. Leer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609362
    m_Localized: 'GraveDigger: Leer, sage ich Ihnen! Aber in den Unterlagen steht, dass da jemand liegt. Eine Leiche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609363
    m_Localized: 'GraveDigger: Ein Mann, ganz sicher tot. Er hatte einen Schnurrbart. Ich erinnere mich. Aber puff – weg. Wie der Morgentau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609364
    m_Localized: 'GraveDigger: Also ... wenn ein Toter verschwindet ... ist das wie noch einmal zu sterben?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609365
    m_Localized: 'GraveDigger: Ich wünschte, die Besucher würden einfach wieder unter die Erde zurückkehren ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609366
    m_Localized: Was haben Sie gemacht, als Sie das leere Grab gefunden haben?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609367
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609368
    m_Localized: 'GraveDigger: Ich hab mich hingesetzt. Am Rand. Hab reingeschaut – nichts. Aber dann ... steht jemand in der Ferne und beobachtet mich. Wie bei einer Beerdigung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609369
    m_Localized: 'GraveDigger: Keine Augen. Aber Zähne, die höllisch weiß waren. Sie leuchteten. Er lächelte. Stand einfach nur da.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609370
    m_Localized: 'GraveDigger: Ich habe mir fast in die Hose gemacht, das können Sie mir glauben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609371
    m_Localized: 'GraveDigger: Ich rannte los. Schnell. Das kann ich gut. Er hat mich aber nicht verfolgt. Er ist einfach ... verschwunden. Wie Rauch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609372
    m_Localized: 'GraveDigger: Verdammt seltsame Geschichte ... Da hat das ganze Chaos mit den Besuchern angefangen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609373
    m_Localized: 'GraveDigger: Ich wünschte, die Besucher würden einfach wieder unter die Erde zurückkehren ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609374
    m_Localized: Was bringt es, zu graben, wenn niemand die Toten begräbt?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609375
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609376
    m_Localized: 'GraveDigger: Ich grabe nicht mehr. Ich ... schaue nur. Aber nach diesem Chaos fing ich an, in frischen Gräbern herumzustochern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609377
    m_Localized: 'GraveDigger: Ganz vorsichtig. Nichts Unlauteres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609378
    m_Localized: 'GraveDigger: Dachte, vielleicht wurde einer dieser Freaks ja versehentlich begraben. Die Schaufel hatte ich immer schön im Anschlag.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609379
    m_Localized: 'GraveDigger: Aber nein ... Die Knochen waren alle da, wo sie hingehörten. Die Leichen blieben, wo sie waren. Nichts kroch heraus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609380
    m_Localized: 'GraveDigger: Aber wenn es nicht die Begrabenen sind, die zurückkommen, sind die Besucher vielleicht Leute, die begraben werden sollten ... aber nicht wurden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609381
    m_Localized: 'GraveDigger: Ich wünschte, die Besucher würden einfach wieder unter die Erde zurückkehren ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609382
    m_Localized: Sie haben doch keine neuen Gräber ausgehoben, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609383
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609384
    m_Localized: 'GraveDigger: Ich?! Auf keinen Fall! Ich bin ja nicht dumm. Sehen Sie ... Ich habe mein ganzes Leben mit Toten verbracht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609385
    m_Localized: 'GraveDigger: Früher hat mich der Tod nicht gestört. Man stirbt, man wird begraben. Das war’s. Und jetzt? Wer soll mich denn begraben?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609386
    m_Localized: 'GraveDigger: Und selbst wenn, woher weiß ich, dass ich drinbleibe? Ich habe ein Grab gesehen, das ich selbst gefüllt habe ... leer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609387
    m_Localized: 'GraveDigger: Aber ich habe ihn selbst begraben!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609388
    m_Localized: 'GraveDigger: Jetzt denke ich ... vielleicht wird mein Grab auch leer sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609389
    m_Localized: 'GraveDigger: Vielleicht ... vielleicht bin ich schon ein Besucher ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609390
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609391
    m_Localized: 'GraveDigger: Ach ... vergessen Sie es, Mann. Ich rede nur Unsinn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609392
    m_Localized: 'GraveDigger: Ich wünschte, die Besucher würden einfach wieder unter die Erde zurückkehren ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609393
    m_Localized: Woher kommen diese Besucher Ihrer Meinung nach?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609394
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609395
    m_Localized: 'GraveDigger: Haben Sie je bemerkt, dass sie verdächtig vertraut aussehen? Nicht nur ihre Gesichter, sondern auch ihre Erinnerungen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609396
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609397
    m_Localized: 'GraveDigger: Ich habe da eine Theorie. Sind Sie sicher, dass Sie sie hören möchten? Na gut, dann sperren Sie die Lauscher auf ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609398
    m_Localized: 'GraveDigger: Vielleicht sind die Besucher ... nicht die Toten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609399
    m_Localized: 'GraveDigger: Vielleicht sind sie Gedanken. Die, die man nicht begraben hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609400
    m_Localized: 'GraveDigger: Ängste, Bedauern, vergessene Freunde, verdrängte Gefühle. Sie sammeln sich an ... und wenn es in der Erde zu still wird, kriechen sie raus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609401
    m_Localized: 'GraveDigger: Sie suchen nicht nach Fleisch. Sie suchen nach Aufmerksamkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609402
    m_Localized: 'GraveDigger: Und je mehr Angst du hast ... desto näher kommen sie dir. Weil du dich an sie erinnerst. Und alles, woran man sich erinnert ... will leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609476
    m_Localized: 'Intruder: Ob Besucher wohl träumen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609477
    m_Localized: Konnten Sie ein bisschen schlafen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609478
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609479
    m_Localized: 'Intruder: Hm? Nein, ich habe nicht wirklich versucht zu schlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609480
    m_Localized: 'Intruder: Ich hoffe nur, dass hier noch jemand träumt, das ist alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609481
    m_Localized: 'Intruder: Aber ... bisher hat noch niemand von seinen Träumen erzählt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609482
    m_Localized: 'Intruder: Vielleicht wirke ich nicht vertrauenswürdig genug.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609483
    m_Localized: 'Intruder: Vielleicht öffnen sie sich später.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609484
    m_Localized: 'Intruder: Ob Besucher wohl träumen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609485
    m_Localized: Warum sind Sie so besessen von Träumen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609486
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609487
    m_Localized: 'Intruder: Wer sagt denn, dass ich besessen bin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609488
    m_Localized: 'Intruder: Was für eine seltsame Schlussfolgerung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609489
    m_Localized: 'Intruder: Fragen Sie sich denn gar nicht, was Ihr Unterbewusstsein Ihnen sagen will?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609490
    m_Localized: 'Intruder: Was Sie in Ihrem Kopf verstecken? Wir alle verstecken Dinge vor uns selbst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609491
    m_Localized: 'Intruder: Sie zum Beispiel. Meiden Sie andere Menschen, weil Sie verletzt wurden?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609492
    m_Localized: 'Intruder: Das macht es für mich interessant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609493
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609494
    m_Localized: 'Intruder: Wissen Sie was? Ich erzähle Ihnen meinen letzten Traum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609495
    m_Localized: 'Intruder: Ich werde von einem riesigen schwarzen Zug verfolgt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609496
    m_Localized: 'Intruder: Meine Beine sind wie angewurzelt. Ich schreie und wache auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609497
    m_Localized: 'Intruder: Ich stehe auf den Gleisen ... und gleichzeitig fahre ich den Zug. Ich rase direkt auf mich zu und kann nicht anhalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609498
    m_Localized: 'Intruder: Ob Besucher wohl träumen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609499
    m_Localized: Was ist mit Ihnen? Was verstecken Sie in Ihren Träumen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609500
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609501
    m_Localized: 'Intruder: Ich?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609502
    m_Localized: 'Intruder: Ich habe seit Tagen nicht geschlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609503
    m_Localized: 'Intruder: Aber gut, ich erzähle Ihnen etwas. Es wird Ihnen ohnehin niemand glauben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609504
    m_Localized: 'Intruder: Ich kann die Träume anderer Menschen SEHEN. Es ist faszinierend.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609505
    m_Localized: 'Intruder: Ich habe keine Ahnung, wie das funktioniert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609506
    m_Localized: 'Intruder: Aber seit das alles angefangen hat, sind die Träume ... verstummt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609507
    m_Localized: 'Intruder: Als würden alle den Atem anhalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609508
    m_Localized: 'Intruder: Und ich kann auch nicht mehr schlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609509
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609510
    m_Localized: 'Intruder: Und jetzt versuchen Sie doch mal herauszufinden, ob ich die Wahrheit sage oder Sie nur auf den Arm nehme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609511
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609512
    m_Localized: Wer sind Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609513
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609514
    m_Localized: 'Cultist1: Verlorene Seelen. Genau wie alle anderen Menschen auf dieser elenden Erde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609515
    m_Localized: 'Cultist1: Wir sehnen uns nach Frieden und Ruhe. Und wir wissen, wie wir das erreichen können ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609516
    m_Localized: 'Cultist1: Der Tod ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609517
    m_Localized: 'Cultist1: Warum wird er gefürchtet? Weil er unbekannt ist? Oder weil die Religion uns eingebläut hat, dass er eine Strafe ist?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609518
    m_Localized: 'Cultist1: Seit Jahrtausenden suchen wir nach dem Sinn des Lebens. Dabei ist die Antwort so einfach ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609519
    m_Localized: 'Cultist1: Der Tod ist unser Zweck. Und wir sind seine Anhänger.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609520
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609521
    m_Localized: Warum verehren Sie den Tod?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609522
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609523
    m_Localized: 'Cultist1: Weil der Tod die Verkörperung der Barmherzigkeit ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609524
    m_Localized: 'Cultist1: Wir alle fürchten ihn, aber sind unsere Ängste gerechtfertigt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609525
    m_Localized: 'Cultist1: Denken Sie darüber nach. Unsere Welt ist nichts als ein Fegefeuer, das uns quält. Aber warum?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609526
    m_Localized: 'Cultist1: So viel Angst, Schmerz und Leid ... Haben wir denn keinen Frieden verdient?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609527
    m_Localized: 'Cultist1: Der Tod ist ein Paradies, das wir nicht begreifen können.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609528
    m_Localized: 'Cultist1: Religionen versuchen, das Bild vom Himmel für die Menschen zu vereinfachen. Aber ist das Leben jemals einfach?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609529
    m_Localized: 'Cultist1: Das Gleiche gilt für den Tod. Man kann ihn nicht verstehen, bevor man ihn nicht selbst erlebt hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609530
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609531
    m_Localized: Warum haben Sie mein Haus ausgewählt?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609532
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609533
    m_Localized: 'Cultist1: Ihr Haus ist wie kein anderes mit dem Tod verbunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609534
    m_Localized: 'Cultist1: Zuerst habe ich nicht verstanden, warum unser Mentor diesen Ort ausgewählt hat. Aber jetzt ist es mir klar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609535
    m_Localized: 'Cultist1: Diese Wände tragen Spuren des Todes. Sie sind unsichtbar, aber spürbar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609536
    m_Localized: 'Cultist1: Der nackte Beton riecht nach vergossenem Blut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609537
    m_Localized: 'Cultist1: Wir verlangen nicht, dass Sie absichtlich töten, wie Sie vielleicht denken. Sie nehmen bereits ohne Aufforderung Leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609538
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609539
    m_Localized: 'Cultist1: Ich glaube, Ihre Verbindung zum Tod ist stärker als die von uns allen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609540
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609541
    m_Localized: Was sind das für Lagerfeuer, die Sie draußen aufbauen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609542
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609543
    m_Localized: 'Cultist1: Die Zeit ist gekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609544
    m_Localized: 'Cultist1: Die Engel aus der Unterwelt werden unsere Asche als Opfergabe nehmen und uns den Weg in das Reich des Todes eröffnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609545
    m_Localized: 'Cultist1: So verdienen wir uns seine Gunst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609546
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609547
    m_Localized: Sie wirken verängstigt. Haben Sie Angst?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609548
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609549
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609550
    m_Localized: 'Cultist2: Sie sind sehr aufmerksam, Hausherr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609551
    m_Localized: 'Cultist2: Im Gegensatz zu meinen Glaubensbrüdern ... kämpfe ich immer noch mit meiner Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609552
    m_Localized: 'Cultist2: Zweifel quälen mich. Was liegt jenseits des Lebens? Wie fühlt es sich an?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609553
    m_Localized: 'Cultist2: Unser Mentor sagt, dass es weder Himmel noch Hölle ist. Es ist etwas anderes. Aber ich kann es mir nicht vorstellen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609554
    m_Localized: 'Cultist2: Wenn selbst er den Tod nicht vollständig versteht, werden wir ihn dann jemals wirklich begreifen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609555
    m_Localized: 'Cultist2: Was, wenn es nicht ausreicht, ihn zu erleben? Was, wenn er völlig jenseits unseres Verständnisses liegt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609556
    m_Localized: 'Cultist2: Aber ich wage es nicht, den Willen unseres Mentors in Frage zu stellen. In seinen Augen sehe ich Gewissheit und Wissen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609557
    m_Localized: 'Cultist2: Er fordert uns auf, den Glauben und die Entschlossenheit anzunehmen. Bereit zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609558
    m_Localized: 'Cultist2: Nur dann können wir die Flüsse der Toten und die Berge aus Knochen überqueren. Und ihn erreichen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609559
    m_Localized: 'Cultist2: Den Tod.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609560
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609561
    m_Localized: Warum verehren Sie den Tod?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609562
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609563
    m_Localized: 'Cultist2: Bitte, gütiger Hausherr, sprechen Sie mit Respekt vom Tod.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609564
    m_Localized: 'Cultist2: Er verachtet Lästerer, die ihn ungerecht nennen, und bestraft sie mit aller Härte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609565
    m_Localized: 'Cultist2: Er erfüllt mich mit Furcht, aber unser Mentor sagt, der Tod sei vielleicht der gütigste aller Götter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803584
    m_Localized: 'Cultist2: Er bringt keine Hungersnöte, keine Seuchen, keinen Krieg. Er gewährt nur ... Ruhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803585
    m_Localized: 'Cultist2: Und wir müssen ihn finden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803586
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803587
    m_Localized: Warum sind Sie so begierig, den Tod zu finden?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803588
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803589
    m_Localized: 'Cultist2: Dieser Weg ist nicht unsere Entscheidung. Er ist der Wille des Todes selbst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803590
    m_Localized: 'Cultist2: Er hat uns gerufen. Er will uns in seinem Reich empfangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803591
    m_Localized: 'Cultist2: Unser Mentor sagt, dass deshalb die Sonne jetzt so heiß brennt, um uns von der Erdoberfläche zu vertreiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803592
    m_Localized: 'Cultist2: Der Tod bietet Stille, Frieden und Einheit. In seinem Reich werden wir wieder vereint sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803593
    m_Localized: 'Cultist2: Wir trauern vergeblich um die Toten und vergessen, dass wir sie eines Tages wiedersehen werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803594
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803595
    m_Localized: Was haben Sie vor?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803596
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803597
    m_Localized: 'Cultist2: Die Zeit ist gekommen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803598
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803599
    m_Localized: 'Cultist2: Ich habe Angst ... Mein ganzer Körper zittert ... Aber ich muss mich dem Glauben und der Entschlossenheit hingeben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803600
    m_Localized: 'Cultist2: Unser Mentor glaubt an mich. Ich darf niemanden enttäuschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803601
    m_Localized: 'Cultist2: Aber die Angst ... die Angst nagt immer noch an mir ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803602
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803603
    m_Localized: 'Cultist2: Lassen Sie uns gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803604
    m_Localized: 'Cultist2: Lassen Sie uns gehen. Lassen Sie uns gehen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803605
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803606
    m_Localized: Wie lange werden Sie hierbleiben?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803607
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803608
    m_Localized: 'Cultist3: Keine Sorge, Hausherr. Wir werden Ihnen keine Umstände bereiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803609
    m_Localized: 'Cultist3: Wir wissen Ihre Gastfreundschaft zu schätzen und möchten Sie nicht verärgern. Sie haben bereits so viel für uns getan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803610
    m_Localized: 'Cultist3: Wir werden in diesem Zimmer bleiben und in Stille beten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803611
    m_Localized: 'Cultist3: Wir brauchen etwas Ruhe. Unser Weg wird lang und beschwerlich sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803612
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803613
    m_Localized: Wohin sind Sie unterwegs?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803614
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803615
    m_Localized: 'Cultist3: In das Land der Fremden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803616
    m_Localized: 'Cultist3: Das menschliche Leben ist nicht ewig. Wir sind nur Besucher auf dieser Erde. Wir sind gekommen, und wir werden gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803617
    m_Localized: 'Cultist3: Die Fremden müssen dieses Land einnehmen und sich hier niederlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803618
    m_Localized: 'Cultist3: Ihre Ankunft ist kein Zufall. Sie sind demselben Ruf gefolgt, der uns fortzieht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803619
    m_Localized: 'Cultist3: Der Tod hat sie gerufen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803620
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803621
    m_Localized: Was lässt Sie glauben, dass der Tod die Besucher gerufen hat?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803622
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803623
    m_Localized: 'Cultist3: Weil der Tod keinen Unterschied macht – zwischen Mensch, Tier, Fremdem ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803624
    m_Localized: 'Cultist3: Der Tod ist für alle da, und alle sind vor ihm gleich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803625
    m_Localized: 'Cultist3: Er hat auf den richtigen Moment gewartet, und jetzt ist er fast da.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803626
    m_Localized: 'Cultist3: Wir müssen uns auf das Ritual vorbereiten ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803627
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803628
    m_Localized: Was für ein Ritual planen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803629
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803630
    m_Localized: 'Cultist3: Die Zeit ist gekommen, um hinüberzugehen und unsere Heimat zu verlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803631
    m_Localized: 'Cultist3: Wir müssen zum Tod gehen, in das Reich des ewigen Friedens und der Ruhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803632
    m_Localized: 'Cultist3: Es ist Zeit, weiterzuziehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803633
    m_Localized: 'FatalDame: Na, Süßer? Hast du etwas auf dem Herzen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803634
    m_Localized: Wie gefällt es dir hier?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803635
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803636
    m_Localized: 'FatalDame: Gemütlich. Besser als erwartet ... wenn man die aktuelle Lage bedenkt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803637
    m_Localized: 'FatalDame: Danke, dass du mich aufgenommen hast. Ich dachte schon, ich würde vor Tagesanbruch auf der Straße landen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803638
    m_Localized: 'FatalDame: Und du? Wie fühlst du dich?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803639
    m_Localized: Ängstlich
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803640
    m_Localized: Ganz okay. Wir müssen überleben
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803641
    m_Localized: 'FatalDame: Das verstehe ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803642
    m_Localized: 'FatalDame: Heutzutage ... erscheint es sinnlos, Pläne für mehr als die nächsten vier Monate zu schmieden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803643
    m_Localized: 'FatalDame: Man weiß nie, was einen zuerst erwischt – die Sonne, Verrückte oder die Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803644
    m_Localized: 'FatalDame: Aber die Menschheit, ganz zu schweigen von der Erde, hat schon andere Katastrophen überstanden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803645
    m_Localized: 'FatalDame: Ich glaube, wir werden etwas hinterlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803646
    m_Localized: 'FatalDame: Jemand wird Spuren von uns finden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803647
    m_Localized: 'FatalDame: Es wird alles gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803648
    m_Localized: 'FatalDame: Diese Einstellung gefällt mir. Steht dir gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803649
    m_Localized: 'FatalDame: Aber friss nicht alles in dich hinein. Emotionen haben die unangenehme Eigenschaft, sich genau dann zu entladen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803650
    m_Localized: 'FatalDame: ... wenn man es am wenigsten brauchen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803651
    m_Localized: 'FatalDame: Schäm dich nicht, darüber zu reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803652
    m_Localized: 'FatalDame: Wenn nicht mit mir, dann mit jemand anderem. Egal mit wem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803653
    m_Localized: 'FatalDame: Versprich es mir, ja?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803654
    m_Localized: 'FatalDame: Na, Süßer? Hast du etwas auf dem Herzen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803655
    m_Localized: Ich habe letzte Nacht etwas Seltsames gesehen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803656
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803657
    m_Localized: 'FatalDame: Hmm? Was meinst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803658
    m_Localized: Dein Bauch ist gewachsen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803659
    m_Localized: Ich dachte nur, ich hätte etwas gesehen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803660
    m_Localized: 'FatalDame: Du meinst ... als wäre ich schwanger?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803661
    m_Localized: 'FatalDame: Schon gut. Ich bin froh, dass du deine Gefühle in Worte gefasst hast.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803662
    m_Localized: 'FatalDame: Ich glaube, du fühlst dich so, weil du Angst hast, Verantwortung für andere übernehmen zu müssen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803663
    m_Localized: 'FatalDame: Verständlich. Wenn jeder Sonnenaufgang der letzte sein könnte, ist es schwer genug, sich um sich selbst zu kümmern, geschweige denn um andere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803664
    m_Localized: 'FatalDame: Du weißt nicht einmal, ob du den Morgen noch erleben wirst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803665
    m_Localized: Ja ... das macht mir Angst
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803666
    m_Localized: Nein, ich glaube, das ist es nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803667
    m_Localized: 'FatalDame: Aber etwas beschäftigt dich, nicht wahr?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803668
    m_Localized: 'FatalDame: Keine Sorge. Die Angst zehrt an uns allen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803669
    m_Localized: 'FatalDame: Ich habe dich beobachtet. Wie du nachts aufgestanden bist. Deine Runden gedreht hast.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803670
    m_Localized: 'FatalDame: Das ist nicht ohne. Für jemanden, der so verschlossen ist, kümmerst du dich sehr um die, die du an dich heranlässt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803671
    m_Localized: 'FatalDame: Es ist ... interessant. Du bist ein wandelnder Widerspruch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803672
    m_Localized: 'FatalDame: Oder vielleicht ist es nur die Schlaflosigkeit. Angst ist ein mieser Bettgenosse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803673
    m_Localized: Ja ... das macht mir Angst
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803674
    m_Localized: Nein, ich glaube, das ist es nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803675
    m_Localized: 'FatalDame: Es erfordert Mut, das laut auszusprechen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803676
    m_Localized: 'FatalDame: Aber was können wir schon gegen Angst tun, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803677
    m_Localized: 'FatalDame: Kannst du mit dem Gedanken leben, dass alles endet? Wir alle müssen sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803678
    m_Localized: 'FatalDame: Was zählt, ist, wo du deine Erlösung findest. Gibt es sie überhaupt noch?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803679
    m_Localized: 'FatalDame: Okay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803680
    m_Localized: 'FatalDame: Jedenfalls ... mache ich mir Sorgen um dich. Hör auf dich selbst, okay?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803681
    m_Localized: 'FatalDame: Ich möchte, dass du dich sicher fühlst. Wir leben schließlich unter einem Dach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803682
    m_Localized: "FatalDame: Aber wenn du die Nerven verlierst, sind wir verloren ...\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803683
    m_Localized: 'FatalDame: Oh, das war fast schon ein Wortspiel. *kicher*'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803684
    m_Localized: 'FatalDame: Hat dir das gefallen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803685
    m_Localized: 'FatalDame: Na, Süßer? Hast du etwas auf dem Herzen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803686
    m_Localized: Ich habe gestern gesehen, dass du schwanger bist. Erkläre das
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803687
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803688
    m_Localized: 'FatalDame: Du machst mir langsam ein bisschen Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803689
    m_Localized: 'FatalDame: Bist du sicher, dass du letzte Nacht WIRKLICH etwas gesehen hast?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803690
    m_Localized: 'FatalDame: Warum hast du mich nicht geweckt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803691
    m_Localized: 'FatalDame: Ist es wieder die Angst, die aus dir spricht? Der Tod ... oder die Last, für jemanden zu sorgen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803692
    m_Localized: 'FatalDame: Ist es wegen mir? Oder verfolgt dich jemand anderes in deinen Gedanken?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803693
    m_Localized: Höre auf, mich zu verwirren
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803694
    m_Localized: Ich ... Ich bin mir sicher, dass ich etwas gesehen habe
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803695
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803696
    m_Localized: 'FatalDame: Du hast neulich deinen Vater erwähnt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803697
    m_Localized: 'FatalDame: Seitdem haben wir nicht mehr über ihn gesprochen. Ich weiß nicht viel über ihn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803698
    m_Localized: 'FatalDame: Aber jetzt ... habe ich das Gefühl, dass du genau wie er bist. Du bist sein Ebenbild.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803699
    m_Localized: 'FatalDame: Macht dir das Angst?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803700
    m_Localized: 'FatalDame: Dass du in seinem Schatten stehst?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803701
    m_Localized: 'FatalDame: Er ist für dich gestorben. Warum also die Geister der Vergangenheit wieder ausgraben?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803702
    m_Localized: 'FatalDame: Du wirst ihn auf der anderen Seite nicht wiedersehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803703
    m_Localized: 'FatalDame: Ich glaube nicht, dass ihr beide an denselben Ort kommt. Mach dir keine Sorgen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803704
    m_Localized: 'FatalDame: Hör auf, alle Antworten auf einmal finden zu wollen. Straßen werden Stein für Stein gebaut, Süßer. Verstehst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803705
    m_Localized: 'FatalDame: Und bitte ... sprich nie wieder so mit mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803706
    m_Localized: 'FatalDame: Es tut weh, zu sehen, was mit dir passiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803707
    m_Localized: 'FatalDame: Aber du solltest keine Angst vor dem Tod haben. Oder vor Verantwortung. Oder vor Nähe. Oder vor irgendetwas anderem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803708
    m_Localized: 'FatalDame: Das gehört alles zum Leben dazu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803709
    m_Localized: 'FatalDame: Hör auf, alle Antworten auf einmal finden zu wollen. Straßen werden Stein für Stein gebaut, Süßer. Verstehst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803710
    m_Localized: 'FatalDame: Und vielleicht hilft es dir, daran zu denken, dass wir nicht vollständig verschwinden, wenn der Vorhang fällt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803711
    m_Localized: 'FatalDame: Früher habe ich an Himmel und Hölle geglaubt. Aber heute? Heute bin ich mir da nicht mehr so sicher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803712
    m_Localized: 'FatalDame: Vielleicht ist es etwas ganz anderes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803713
    m_Localized: 'FatalDame: Was meinst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803714
    m_Localized: 'FatalDame: Na, Süßer? Hast du etwas auf dem Herzen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803715
    m_Localized: Du bist schwanger. Ich finde bald jemanden, ganz sicher
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803716
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803717
    m_Localized: 'FatalDame: Oh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803718
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803719
    m_Localized: 'FatalDame: Die Verzweiflung hat dich gepackt, nicht wahr?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803720
    m_Localized: 'FatalDame: Alles, woran du geglaubt hast, bricht zusammen ... und du kannst nur hilflos zusehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803721
    m_Localized: 'FatalDame: Liegt es daran, dass du nicht dorthin gehen willst, wo wir hingehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803722
    m_Localized: 'FatalDame: Oder daran, dass du nicht mehr in diese Welt gehörst? Oder in irgendeine Welt, welche auch immer das sein mag?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803723
    m_Localized: Das meine ich nicht. Du bist schwanger
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803724
    m_Localized: Hast du selbst gar keine Angst?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803725
    m_Localized: 'FatalDame: Süßer ... Ich kann doch nicht so schnell ein Kind bekommen. Ich habe noch nicht einmal einen Babybauch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803726
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803727
    m_Localized: 'FatalDame: Kann ich dich was fragen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803728
    m_Localized: 'FatalDame: Wenn dieses Kind wirklich da ist ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803729
    m_Localized: 'FatalDame: Und wenn es, wie du sagst, bald kommt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803730
    m_Localized: 'FatalDame: Was wirst du tun? Wirst du versuchen, es zu finden?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803731
    m_Localized: Es sollte nicht existieren
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803732
    m_Localized: Ich habe mich noch nicht entschieden
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803733
    m_Localized: 'FatalDame: Hm. Gute Frage.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803734
    m_Localized: 'FatalDame: Sterben ist sicher beängstigend.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803735
    m_Localized: 'FatalDame: Vor allem, weil ich nicht weiß, was danach kommt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803736
    m_Localized: 'FatalDame: Himmel, Wiedergeburt, etwas ganz anderes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803737
    m_Localized: 'FatalDame: Niemand ist je zurückgekehrt, um davon zu berichten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803738
    m_Localized: 'FatalDame: Aber was deine Vision angeht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803739
    m_Localized: 'FatalDame: Wenn dieses Kind wirklich da ist ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803740
    m_Localized: 'FatalDame: Und wenn es, wie du sagst, bald kommt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803741
    m_Localized: 'FatalDame: Was wirst du tun? Wirst du versuchen, es zu finden?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803742
    m_Localized: Es sollte nicht existieren
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803743
    m_Localized: Ich habe mich noch nicht entschieden
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803744
    m_Localized: 'FatalDame: Manchmal will unser Instinkt bewahren, was uns vertraut ist ... auch wenn es uns nicht mehr nützlich ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803745
    m_Localized: 'FatalDame: Vielleicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803746
    m_Localized: 'FatalDame: Vielleicht ist es an der Zeit, deine Augen für etwas Neues zu öffnen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803747
    m_Localized: 'FatalDame: Oder bereitet dir das Unbekannte so große Angst?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803748
    m_Localized: Ich werde dieses Kind finden
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803749
    m_Localized: Es kommt. Ich weiß es
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803750
    m_Localized: 'FatalDame: Du solltest keine Angst haben, Dinge loszulassen. Vor allem, wenn sie dir nicht mehr nützlich sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803751
    m_Localized: 'FatalDame: Manchmal klammern wir uns an etwas, nur weil es uns vertraut ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803752
    m_Localized: 'FatalDame: Und ja, mit Gewohnheiten zu brechen tut weh ... aber wer weiß, wohin es führen könnte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803753
    m_Localized: Ich werde dieses Kind finden
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803754
    m_Localized: Es kommt. Ich weiß es
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803755
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803756
    m_Localized: 'FatalDame: Wenn du meinst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803757
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803758
    m_Localized: 'FatalDame: Sag mir, was du gefunden hast ... wenn die Zeit gekommen ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713862
    m_Localized: 'NotTrue: Ich bin ein Stadtmensch, mein Lieber. Ich hatte eine kleine Wohnung in der Stadt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713863
    m_Localized: 'NotTrue: Kein Haus auf dem Land, keine Verwandten, keine Enkelkinder ... Ach ja ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713864
    m_Localized: 'NotTrue: Also saß ich meistens auf der Bank vor der Tür. Da war einiges los und man bekam alle möglichen Dinge mit.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713865
    m_Localized: 'NotTrue: Aber als der ganze Ärger losging, half das auch nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713866
    m_Localized: 'NotTrue: Wie soll man das Leben spüren, wenn der Tod allgegenwärtig ist? Die Leute fallen um wie die Fliegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713867
    m_Localized: 'NotTrue: Man kommt ins Treppenhaus und immer liegt dort jemand, bedeckt mit einem weißen Tuch.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713868
    m_Localized: 'NotTrue: Himmel, man wünscht sich ja fast den Tod, anstatt so ein Trauerspiel mitansehen zu müssen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713869
    m_Localized: 'NotTrue: Also habe ich einen Ort gesucht, wo es noch Menschen gibt, wo Geschichten erzählt werden und das Leben zu spüren ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713870
    m_Localized: 'NotTrue: Und das Schicksal hat mich direkt vor Ihre Haustür geführt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713871
    m_Localized: 'NotTrue: Ich bin keine Kirchengängerin, aber in Zeiten wie diesen ... fühlt es sich an, als hätte der Herr persönlich meine Schritte geführt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713872
    m_Localized: 'NotTrue: Aber alle haben mich vergessen, mein Lieber.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713873
    m_Localized: 'NotTrue: Falls überhaupt noch irgendjemand am Leben ist, kommt er mich jedenfalls nicht besuchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713874
    m_Localized: 'NotTrue: Und damit bin ich wahrlich nicht allein. Viele vergessen ihre eigenen Verwandten ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713875
    m_Localized: 'NotTrue: Jeder denkt nur an sich selbst. Keine Menschenseele ruft an und fragt, wie ich zurechtkomme.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713876
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713877
    m_Localized: 'NotTrue: Einmal saß ich mit meiner Nachbarin auf dieser Bank und sie prahlte mit ihrem Enkel.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713878
    m_Localized: 'NotTrue: Sie sagte: „Was für ein guter Junge! Erinnert sich an seine Eltern und besucht mich. Nicht wie die anderen.“'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713879
    m_Localized: 'NotTrue: Und er war tatsächlich ein guter Junge. Grüßte mich immer freundlich und fragte, wie es mir geht.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713880
    m_Localized: 'NotTrue: Ich war sogar ein wenig neidisch ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713881
    m_Localized: 'NotTrue: Dann kam der Tod, um sie zu holen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713882
    m_Localized: 'NotTrue: Und der Junge ... Er wurde ruppig und griesgrämig.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713883
    m_Localized: 'NotTrue: Letztendlich war seine Freundlichkeit nur gespielt, damit er die Wohnung erben konnte ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713884
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713885
    m_Localized: 'NotTrue: Was glauben Sie, warum die Menschen sich schamlos ins Gesicht lügen, vor allem innerhalb der eigenen Familie?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713886
    m_Localized: 'NotTrue: Man heiratet, zeugt Kinder, und dann ... Es ist unglaublich, sie lieben einen überhaupt nicht!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713887
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713888
    m_Localized: 'NotTrue: Ach, ich kann von Glück sagen, dass ich keinen Mann mehr habe. Er war ein komischer alter Kauz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713889
    m_Localized: 'NotTrue: Aber jetzt ist auch er tot, mein Lieber.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713890
    m_Localized: 'NotTrue: Hat mein Leben ruiniert, dieser alte Mistkerl.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713891
    m_Localized: 'NotTrue: Ich habe ihn nur auf Druck meiner Eltern geheiratet.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713892
    m_Localized: 'NotTrue: „Heirate ihn, Tochter“, sagten sie. Also haben wir geheiratet.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713893
    m_Localized: 'NotTrue: Am Anfang war alles wunderbar. Aber sobald der Hochzeitsrummel vorbei war, kam sein verdorbenes Wesen zum Vorschein.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713894
    m_Localized: 'NotTrue: Zuerst war ihm mein Essen nie gut genug. Dann sagte er Sachen wie „Lass mich in Ruhe, siehst du nicht, dass ich esse?“'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713895
    m_Localized: 'NotTrue: Und später verschwand er stundenlang mit seinen Kumpels zum Trinken.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713896
    m_Localized: 'NotTrue: Kam betrunken nach Hause und fantasierte sich Geschichten über Dominospiele in der Garage zusammen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713897
    m_Localized: 'NotTrue: Und wenn ich fragte, ob er getrunken hatte, beschimpfte er mich aufs Übelste, der elende Kauz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713898
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713899
    m_Localized: 'NotTrue: Dann holte der Tod auch ihn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713900
    m_Localized: 'NotTrue: Zuerst war ich erleichtert. Aber bald schlich sich eine Leere ein.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713901
    m_Localized: 'NotTrue: Der Fernseher half für eine Weile, aber inzwischen gibt es dort nur noch Unsinn ... nichts als Lügen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713902
    m_Localized: 'NotTrue: Also ging ich raus und setzte mich auf die Bank.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713903
    m_Localized: 'NotTrue: Ach ja ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713904
    m_Localized: 'NotTrue: Ich fühlte mich ein wenig besser, wenn ich mir die Welt ansah. Lachende Kinder, frisch verliebte Paare, vorbeitrottende Hunde ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713905
    m_Localized: 'NotTrue: Aber dann fing all dieser Ärger an ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713906
    m_Localized: 'NotTrue: Und nach und nach verschanzten sich alle in ihren Wohnungen. Niemand saß mehr abends draußen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713907
    m_Localized: 'NotTrue: Aus dem Fenster zu schauen war auch nicht besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713908
    m_Localized: 'NotTrue: Wo früher Kinder gespielt hatten, waren Leichensäcke. Wilde Hunde streiften durch die Straßen und Nachbarn sahen sich an wie Fremde.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713909
    m_Localized: 'NotTrue: Das Leben schien zum Stillstand gekommen zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713910
    m_Localized: 'NotTrue: Und jetzt kann man nicht mal mehr Wahrheit und Lügen unterscheiden ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713911
    m_Localized: 'NotTrue: Ich wünschte, die Leute würden einfach aufhören zu lügen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173076770816
    m_Localized: 'Fatman: Wir haben schon geredet. Ich bin müde.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173093548032
    m_Localized: 'Fatman: Verschieben wir das auf morgen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233280
    m_Localized: 'BigLebowski: Was ist? Glaubst du, ich will dir was klauen oder so? Pfft, also bitte.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233281
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233282
    m_Localized: 'BigLebowski: Ernsthaft? Was soll das werden, ein Verhör? Lass gut sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233283
    m_Localized: 'BigLebowski: Wenn du mir blöd kommst, werd ich kratzen und beißen. Ich lass mir nichts gefallen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233284
    m_Localized: 'BigLebowski: Mein Vater ist ein Dreckskerl, aber wenigstens hat er mir beigebracht, wie man kämpft.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233285
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233286
    m_Localized: 'BigLebowski: Das reicht. Fass mich nicht an.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233287
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233288
    m_Localized: 'BigLebowski: Wenn das so ist, dann ... ach, von mir aus. Mach deine komischen Tests, aber sprich mich nicht an.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233289
    m_Localized: 'BigLebowski: Aber das Training mit ihm war die eine Sache. Die ich übrigens gehasst habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233290
    m_Localized: 'BigLebowski: Das andere war, wenn er ausgerastet ist und mich verprügelt hat. Und meine Mutter? Ihr war’s egal. Hat nicht mal hingeguckt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233291
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233292
    m_Localized: 'BigLebowski: Ich will auf keinen Fall so enden wie meine Eltern.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233293
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233294
    m_Localized: 'BigLebowski: Warum haben sie mich überhaupt gezeugt, wenn sie mich so behandeln? Ich begreif’s nicht. Ist das Leben wirklich so?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233295
    m_Localized: 'BigLebowski: Und jetzt auch noch die Sonne und die Besucher? Na toll. Alles wird immer schlimmer.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233296
    m_Localized: 'BigLebowski: Kann vielleicht auch irgendwann mal was Gutes passieren?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233297
    m_Localized: 'BigLebowski: Ach, was weiß ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713912
    m_Localized: 'Doctor: Tut mir leid, aber ich kann heute nicht mehr reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713913
    m_Localized: 'Doctor: Dann beschloss ich, die Organisation zu verlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713914
    m_Localized: 'Doctor: Warum fragen Sie? Wollen Sie herausfinden, warum ich der FEMA nicht vertraue?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713915
    m_Localized: 'Doctor: Fangen wir hiermit an ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713916
    m_Localized: 'Doctor: Glauben Sie, dass die Besucher eine Art Virus sind?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713917
    m_Localized: Ich glaube nicht, dass sie existieren
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713918
    m_Localized: Nein, aber ich weiß nicht, was sie wirklich sind
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713919
    m_Localized: Ja, das tue ich
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713920
    m_Localized: 'Doctor: Wenn Sie nicht an sie glauben, verstehe ich nicht, warum Sie diese Tests durchführen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713921
    m_Localized: 'Doctor: Sie sollten nicht versuchen, mich zu täuschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713922
    m_Localized: 'Doctor: Also ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713923
    m_Localized: 'Doctor: Verstehe. Leider weiß ich auch nicht, was die Besucher wirklich sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713924
    m_Localized: 'Doctor: Aber eines kann ich Ihnen mit Sicherheit sagen: Sie sind kein Virus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713925
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713926
    m_Localized: 'Doctor: Nun, ich fürchte, ich muss Sie enttäuschen. Das ist höchstwahrscheinlich nicht der Fall.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713927
    m_Localized: 'Doctor: Haben Sie jemals erlebt, wie ein scheinbar völlig normaler Mensch sich plötzlich verändert? Wie er hinter Ihrem Rücken zum Besucher wird?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713928
    m_Localized: 'Doctor: Haben Sie nicht. Weil es keinen einzigen solchen Fall gibt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713929
    m_Localized: 'Doctor: Sie müssen verstehen, dass die FEMA die Situation nicht unter Kontrolle hat. Sie tut nur so.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713930
    m_Localized: 'Doctor: Sie schließt die Krankenhäuser, schickt alle in Quarantänezonen ... Aber zu welchem Zweck?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713931
    m_Localized: 'Doctor: Ist den Leuten damit geholfen? Wurde jemals irgendjemand geheilt?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713932
    m_Localized: 'Doctor: Die FEMA hat die Leute nur zusammengepfercht, weggesperrt und dann sich selbst überlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713933
    m_Localized: Warum haben Sie dann für die FEMA gearbeitet?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713934
    m_Localized: Genug von diesem Unsinn, verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713935
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713936
    m_Localized: 'Doctor: Ich konnte nicht einfach zusehen, wie einer nach dem anderen umgebracht wird.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713937
    m_Localized: 'Doctor: Deshalb ging ich zur FEMA, um diesen armen Seelen zu helfen, aus den Quarantänezonen zu entkommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713938
    m_Localized: 'Doctor: Ich untersuchte sie und stellte meine Diagnosen. Und ich fälschte Dokumente, damit sie frei sein konnten.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713939
    m_Localized: Ihretwegen könnten Besucher entkommen sein
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713940
    m_Localized: Welcher Vorfall?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713941
    m_Localized: Und jetzt werden Sie auch von hier fliehen müssen
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713942
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713943
    m_Localized: 'Doctor: Schade, dass Sie mir nicht zuhören wollen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713944
    m_Localized: 'Doctor: Dann werde ich keinen Platz in Ihrem Haus beanspruchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713945
    m_Localized: 'Doctor: Auf Wiedersehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713946
    m_Localized: 'Doctor: Und was wäre Ihre bevorzugte Lösung? Sie dort sterben lassen?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713947
    m_Localized: 'Doctor: Ich habe den Eid des Hippokrates geschworen. Ich werde alles dafür tun, um das Leben und die Gesundheit zu schützen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713948
    m_Localized: 'Doctor: Aber am Ende ... musste ich nach einem Vorfall selbst aus einer Quarantänezone fliehen. Leider.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713949
    m_Localized: 'Doctor: Es passierte in der Zone, in der ich stationiert war.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713950
    m_Localized: 'Doctor: Was!?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713951
    m_Localized: 'Doctor: Sie meinen, ich hätte ihnen nicht helfen sollen? Und jetzt wollen Sie mich dafür rauswerfen?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713952
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713953
    m_Localized: 'Doctor: Kaum zu fassen, aber Sie sind vielleicht schlimmer als die FEMA. Die tut wenigstens so, als würde sie den Leuten helfen. Aber Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713954
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713955
    m_Localized: 'Doctor: Für mich ist hier kein Platz mehr. Mir graut vor dem Gedanken, wie es den anderen in Ihrer Obhut ergehen wird.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713956
    m_Localized: 'Doctor: Leben Sie wohl.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713957
    m_Localized: Und wenn er ein Mensch war?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713958
    m_Localized: Sie hatten keine Wahl
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713959
    m_Localized: 'TaxiDriver: Oh ... Sag das nicht, Mann.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713960
    m_Localized: 'TaxiDriver: Ich fühle mich sowieso schon schlecht wegen dem, was passiert ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713961
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713962
    m_Localized: 'TaxiDriver: Tja ... Du hast recht. Es gab keine andere Möglichkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713963
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713964
    m_Localized: 'TaxiDriver: Mann, ich vermisse die Zeiten, als man einfach hinterm Steuer sitzen konnte und sich keinen Kopf machen musste.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713965
    m_Localized: 'TaxiDriver: Aber jetzt, mit diesen Besuchern ... Man muss verdammt aufpassen, dass der nächste Fahrgast einem keine Kugel in den Kopf jagt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713966
    m_Localized: 'TaxiDriver: Äh ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713967
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713968
    m_Localized: 'TaxiDriver: Ich will nicht am Straßenrand enden, mit niemandem, der sich um mich schert ... so wie mein Vater.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713969
    m_Localized: 'TaxiDriver: Ich hoffe nur, dass mein Glück noch nicht aufgebraucht ist ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713970
    m_Localized: Was hattest du für ein Auto?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713971
    m_Localized: Was hat dein Auto so besonders gemacht?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713972
    m_Localized: 'TaxiDriver: Oh Mann, das war der schönste Oldtimer von allen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713973
    m_Localized: 'TaxiDriver: Leuchtend gelbe Lackierung, glänzende Chromräder, elegante Kurven ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713974
    m_Localized: 'TaxiDriver: Aber jetzt ist es weg ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713975
    m_Localized: 'TaxiDriver: Verdammte FEMA ... Dieses Auto war mein Ein und Alles! Bastarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713976
    m_Localized: 'TaxiDriver: Das Auto hat meinem Vater gehört. Er war auch Taxifahrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713977
    m_Localized: 'TaxiDriver: Als ich klein war, bin ich nachts gerne mit ihm mitgefahren. Ich konnte hinten gut einschlafen, also hat er mich mitgenommen. Aber dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713978
    m_Localized: 'TaxiDriver: Man könnte sagen, sein Glück war aufgebraucht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713979
    m_Localized: 'TaxiDriver: Normalerweise rede ich nicht darüber, aber ... ich glaube, ich kann dir vertrauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713980
    m_Localized: 'TaxiDriver: Eines Tages musste meine Mutter auf eine Dienstreise, also hat mein Vater mich mitgenommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713981
    m_Localized: 'TaxiDriver: Und dann kam ein Fahrgast, den ich nie vergessen werde.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713982
    m_Localized: 'TaxiDriver: Eleganter Anzug, Glatze und ein Grinsen wie ein wildes Tier ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713983
    m_Localized: 'TaxiDriver: Jeder in der Stadt wusste, wer er war. Selbst ich als kleiner Junge. So jemanden durfte man nicht abweisen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713984
    m_Localized: 'TaxiDriver: Aber mein Vater war ein Ehrenmann. Und seine Entscheidung ... ist auf uns alle zurückgefallen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713985
    m_Localized: 'TaxiDriver: Der Mann im Anzug hat dafür gesorgt, dass wir dafür bezahlen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713986
    m_Localized: 'TaxiDriver: Wir haben unser Zuhause verloren. Danach konnten wir nie lange an einem Ort bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713987
    m_Localized: 'TaxiDriver: Und da wir kaum Geld hatten, hat mein Vater sein Taxi behalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713988
    m_Localized: 'TaxiDriver: Als hochverschuldeter alter Mann hat er sich dann gewünscht, er hätte es nicht behalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713989
    m_Localized: 'TaxiDriver: Er hat gesagt, es ist verflucht und bringt uns allen nur Unglück.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713990
    m_Localized: 'TaxiDriver: Aber er hat es nie begriffen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713991
    m_Localized: 'TaxiDriver: Es war nicht das Auto. Es war sein Stolz, der uns alles gekostet hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713992
    m_Localized: 'TaxiDriver: Aber auch wenn ich wegen seiner Entscheidungen schon früh arbeiten musste, um die Familie zu ernähren ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713993
    m_Localized: 'TaxiDriver: Ich liebe ihn trotzdem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713994
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713995
    m_Localized: 'TaxiDriver: Ich vermisse meinen Vater ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713996
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713997
    m_Localized: 'TaxiDriver: Ich verlange nicht viel, aber ... Wenn es nicht zu viele Umstände macht, könntest du ihn vielleicht, äh, anrufen?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713998
    m_Localized: 'TaxiDriver: Hier ist seine Nummer: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713999
    m_Localized: 'TaxiDriver: Sag ihm einfach, dass es mir gutgeht. Ich würd’s ja selbst machen, aber ... ich kann im Moment nicht riskieren, dass mich jemand findet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415106
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491072
    m_Localized: Warum hast du verheimlicht, dass du bei der FEMA warst?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491073
    m_Localized: Und warum das Versteckspiel?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491074
    m_Localized: 'FormerFema: Verstehst du es wirklich nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491075
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491076
    m_Localized: 'FormerFema: Was ist das für eine Frage!?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491077
    m_Localized: 'FormerFema: Wenn die Leute rausfinden, dass ich bei der FEMA war ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491078
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491079
    m_Localized: 'FormerFema: Hör zu, ich bin nicht mehr bei der FEMA. Sagen wir einfach ... ich hab gekündigt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491080
    m_Localized: 'FormerFema: Hör zu, ich bin nicht mehr bei der FEMA. Sagen wir einfach ... ich hab gekündigt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491081
    m_Localized: 'FormerFema: Ja, ich musste bestimmte Dinge tun.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491082
    m_Localized: 'FormerFema: Leute mitnehmen, sie in Quarantänezonen schicken ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491083
    m_Localized: 'FormerFema: Aber das war nun mal mein Job! Ich hab nur Befehle befolgt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491084
    m_Localized: 'FormerFema: Du brauchst mich gar nicht nach den Leuten zu fragen, die wir mitgenommen haben. Das ist Sache der hohen Tiere.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491085
    m_Localized: 'FormerFema: Und mich einen Mörder oder dergleichen zu nennen ... Das ist einfach nur lächerlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491086
    m_Localized: 'FormerFema: Wie würdest du es nennen, wenn ein Mörder einen anderen umlegt?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491087
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491088
    m_Localized: 'FormerFema: Einmal hab ich einen Typen mit Merkmalen von Besuchern mitgenommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491089
    m_Localized: 'FormerFema: In der Quarantänezone hat sich sein Zustand verschlechtert und er ist gestorben. So was passiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491090
    m_Localized: 'FormerFema: Dann kam seine Frau. Wollte wissen, wann wir ihn rauslassen. Wir haben ihr gesagt, dass es nichts mehr zum Rauslassen gibt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491091
    m_Localized: 'FormerFema: Sie war geschockt. Fing an zu schreien, nannte uns Mörder und wollte, dass wir die Leiche rausgeben.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491092
    m_Localized: 'FormerFema: Wir haben ihr gesagt, dass das gegen das Protokoll verstößt. Hat sie nicht beeindruckt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491093
    m_Localized: 'FormerFema: Sie schlug direkt vor dem Tor ihr Lager auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491094
    m_Localized: 'FormerFema: Wir haben ihr die Leiche gegeben. Dann wurden alle gefeuert, die gegen das Protokoll verstoßen haben. Unter anderem ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491095
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491096
    m_Localized: 'FormerFema: Sie musste ja unbedingt diese verdammte Leiche haben. Diese Irre hat mich meinen Job gekostet.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491097
    m_Localized: 'FormerFema: Und jetzt kann ich nirgendwo mehr hin ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491098
    m_Localized: 'FormerFema: Und anstatt ihn zu beerdigen, schleppt sie die Leiche mit sich rum.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491099
    m_Localized: 'FormerFema: Dafür hat es sich wirklich gelohnt, uns alle zu feuern, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491100
    m_Localized: Ihr FEMA-Leute seid richtige Schweine
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491101
    m_Localized: Pech gehabt
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491102
    m_Localized: 'FormerFema: Wie bitte!?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491103
    m_Localized: 'FormerFema: Ich mache meinen Job, erfülle meine Pflicht, werde wegen irgendeiner Verrückten gefeuert ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491104
    m_Localized: 'FormerFema: Und du bezeichnest uns als Schweine!?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491105
    m_Localized: 'FormerFema: Weißt du was, scheiß auf dein Haus. Ich verzieh mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491106
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491107
    m_Localized: 'FormerFema: Haben denn alle den Verstand verloren?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491108
    m_Localized: 'FormerFema: Nein, nein, genau das ist passiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491109
    m_Localized: 'FormerFema: Seit die Sonne verrückt spielt und die Infektionen angefangen haben, drehen alle durch.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491110
    m_Localized: 'FormerFema: War diese verdammte Leiche wirklich unsere Jobs wert? Was meinst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491111
    m_Localized: Gut, dass sie ihren Mann noch mal sehen konnte
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491112
    m_Localized: Ihr hättet ihr die Leiche nicht geben sollen
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491113
    m_Localized: 'FormerFema: Du meinst, es ist gut, dass wir gefeuert wurden?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491114
    m_Localized: 'FormerFema: Ihr Zivilisten begreift wirklich gar nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491115
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491116
    m_Localized: 'FormerFema: Ich hätte sie einfach erschießen sollen, so wie ihren Mann.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491117
    m_Localized: Was hast du gerade gesagt?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491118
    m_Localized: (Waffe ziehen)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491119
    m_Localized: 'FormerFema: Warum guckst du mich so an?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491120
    m_Localized: 'FormerFema: Das Protokoll besagt, wenn ein kontaminierter Zivilist in schlechter Verfassung ist ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491121
    m_Localized: 'FormerFema: Dann schaffen wir das Problem auf der Stelle aus der Welt, damit kein Besucher in Quarantäne landet.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491122
    m_Localized: (Ihn in Ruhe lassen)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491123
    m_Localized: (Waffe ziehen)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491124
    m_Localized: 'FormerFema: Danke für dein Verständnis.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491125
    m_Localized: 'FormerFema: Ich bin kein Mörder, ich hab nur Befehle befolgt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491126
    m_Localized: 'FormerFema: Hey, was zur Hölle machst du da?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491127
    m_Localized: 'FormerFema: Beruhige dich, er war ein Besucher! Und in schlechter Verfassung noch dazu! Wir konnten ihn nicht einfach laufen lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491128
    m_Localized: 'FormerFema: Nicht schießen, ich hab nur Befehle befolgt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491129
    m_Localized: 'FormerFema: Das sehe ich genauso. Wir hätten das Protokoll befolgen sollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491130
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491131
    m_Localized: 'FormerFema: Na gut, ich will dich nicht weiter behelligen. Danke fürs Reinlassen, obwohl ich bei der FEMA war.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491132
    m_Localized: 'FormerFema: Ich merke mir deine Kooperation für den Fall, dass ich meinen Job jemals zurückbekomme.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713856
    m_Localized: 'Neighbour: Das ist alles von mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713857
    m_Localized: 'Neighbour: Oh, fast hätte ich es vergessen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713858
    m_Localized: 'Neighbour: Ich gehe morgen wieder nach Hause. Schreiben Sie sich meine Nummer auf, sie haben gerade einen Anschluss eingerichtet.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713859
    m_Localized: 'Neighbour:  {0}. Wir bleiben über das Telefon in Kontakt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713860
    m_Localized: 'Neighbour: Gut, das war’s jetzt aber wirklich.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713861
    m_Localized: 'Neighbour: Trinken Sie ein Bier und legen Sie sich schlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491133
    m_Localized: 'Cat: Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491134
    m_Localized: (Die Katze streicheln)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491135
    m_Localized: (Die Katze aufheben)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491136
    m_Localized: Der Katze Dosennahrung geben (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491137
    m_Localized: 'Cat: (Sie strecken die Hand aus und streicheln die Katze)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491138
    m_Localized: 'Cat: (Schwer zu sagen, ob es ihr gefällt)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491139
    m_Localized: 'Cat: Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491140
    m_Localized: (Die Katze streicheln)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491141
    m_Localized: (Die Katze aufheben)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491142
    m_Localized: Der Katze Dosennahrung geben (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491143
    m_Localized: 'Cat: (Sie beschließen, die Katze zu streicheln)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491144
    m_Localized: 'Cat: (Es scheint ihr zu gefallen)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491145
    m_Localized: 'Cat: (Sie ist nicht so widerspenstig, wie Sie dachten)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491146
    m_Localized: 'Cat: (Sie scheint sich an Sie zu gewöhnen)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491147
    m_Localized: 'Cat: Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491148
    m_Localized: (Die Katze streicheln)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491149
    m_Localized: (Die Katze aufheben)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491150
    m_Localized: Der Katze Dosennahrung geben (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491151
    m_Localized: 'Cat: (Die Katze genießt es, so oft gestreichelt zu werden)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491152
    m_Localized: 'Cat: (Es fühlt sich an, als würde sie sich gegen Ihre Hand lehnen)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491153
    m_Localized: 'Cat: (Wie soll man bei so einem süßen Tierchen nein sagen?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491154
    m_Localized: 'Cat: Miau! MIAU! Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491155
    m_Localized: 'Cat: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491156
    m_Localized: 'Cat: (Ihr kleines Gesicht ist schwer zu lesen, aber sie ist bestimmt glücklich)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491157
    m_Localized: 'Cat: (Sie haben das seltsame Gefühl, dass Sie heute gut schlafen können)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491158
    m_Localized: 'Cat: (Als hätte Ihr flauschiger Freund Ihnen zum Dank eines seiner Leben geschenkt)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491159
    m_Localized: 'Cat: (Wer weiß ... Vielleicht kommt der Tod heute Nacht bei Ihnen vorbei)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547465932800
    m_Localized: 'Teacher: Die armen Kleinen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292928
    m_Localized: Stimmt etwas nicht?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292929
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292930
    m_Localized: 'Teacher: Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292931
    m_Localized: 'Teacher: Ich ... Ich dachte mir gerade ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292932
    m_Localized: 'Teacher: Wenn wir nicht aussterben, sondern überleben ... Was erwartet uns dann?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292933
    m_Localized: 'Teacher: Was für eine Zukunft steht uns bevor?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292934
    m_Localized: Haben Sie Angst, in der neuen Welt keinen Platz zu finden?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292935
    m_Localized: Ein weiches Herz überlebt nicht lange. Suchen Sie jemanden, an den Sie sich halten können
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292936
    m_Localized: 'Teacher: Ein weiches Herz ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292937
    m_Localized: 'Teacher: Ich kann kein Leben voller Gewalt führen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292938
    m_Localized: 'Teacher: Ich weiß nicht, wo ich in dieser – wie haben Sie es genannt? – „neuen Welt“ reinpasse.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292939
    m_Localized: Sie wollen sich also lieber hinlegen und sterben?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292940
    m_Localized: Und was schlagen Sie vor?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292941
    m_Localized: Es gab schon immer dunkle Zeiten, das ist nichts Neues
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292942
    m_Localized: 'Teacher: Ich will das nicht. Selbst wenn mich jemand beschützt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292943
    m_Localized: 'Teacher: Das Töten wird nicht aufhören. Die Gewalt wird nicht verschwinden.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292944
    m_Localized: Sie wollen sich also lieber hinlegen und sterben?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292945
    m_Localized: Und was schlagen Sie vor?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292946
    m_Localized: Es gab schon immer dunkle Zeiten, das ist nichts Neues
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292947
    m_Localized: 'Teacher: Ich fühle mich so verloren.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292948
    m_Localized: 'Teacher: Müssen wir wirklich inmitten von Mördern leben?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292949
    m_Localized: 'Teacher: Und die Kinder lernen dann von diesen Mördern?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292950
    m_Localized: Jetzt ist nicht die Zeit, um Trübsal zu blasen
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292951
    m_Localized: REISSEN SIE SICH ZUSAMMEN!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292952
    m_Localized: 'Teacher: Ich weiß nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292953
    m_Localized: 'Teacher: Ich habe nichts anzubieten.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292954
    m_Localized: 'Teacher: Ich will einfach nur ... dass das aufhört.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292955
    m_Localized: 'Teacher: Ich ... Ich kann das nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292956
    m_Localized: 'Teacher: Ja, das stimmt. Aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292957
    m_Localized: 'Teacher: Wie sollen wir jetzt leben?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292958
    m_Localized: 'Teacher: Die Leute sind verrückt geworden und töten jeden, der ... anders zu sein scheint.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292959
    m_Localized: 'Teacher: Ganz egal, wer ihnen im Weg steht.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292960
    m_Localized: Jetzt ist nicht die Zeit, um Trübsal zu blasen
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292961
    m_Localized: REISSEN SIE SICH ZUSAMMEN!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292962
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292963
    m_Localized: 'Teacher: Warum nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292964
    m_Localized: 'Teacher: Ihnen hilft Herzlosigkeit vielleicht. Aber ich kann das nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292965
    m_Localized: 'Teacher: Wenn Sie nur sehen könnten, was ich gesehen habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292966
    m_Localized: 'Teacher: Es ... hat sich für immer in meine Augen eingebrannt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292967
    m_Localized: 'Teacher: Feuer. Schreie. Wütende und entsetzte Gesichter. Zerstörte Häuser.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292968
    m_Localized: 'Teacher: Ich kann nicht so sein wie Sie. Ich bin nicht so stark.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292969
    m_Localized: 'Teacher: Für mich ... gibt es nur eine Möglichkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292970
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292971
    m_Localized: 'Teacher: (Die Frau zuckt zusammen und sieht Sie ängstlich an)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292972
    m_Localized: 'Teacher: (In ihrer Verwirrung konnte sie die Albträume vergessen, aber nur kurz)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292973
    m_Localized: 'Teacher: (Sie legt die Hände vors Gesicht und weint leise)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292974
    m_Localized: 'Teacher: (Sie wissen nicht, was Sie tun sollen. Niemand hat es Ihnen beigebracht)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292975
    m_Localized: 'Teacher: (Sie legen vorsichtig eine Hand auf ihre Schulter und bleiben eine Weile so stehen)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292976
    m_Localized: 'Teacher: (Es ist wahrscheinlich besser, sie in Ruhe zu lassen)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487232
    m_Localized: 'Mother: Hey, weißt du was? Vielleicht solltest du ihn anrufen. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487233
    m_Localized: 'Mother: Sag ihm die Meinung.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487234
    m_Localized: 'Mother: Es sind schließlich auch seine Kinder. Er sollte helfen, sie zu suchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487235
    m_Localized: 'Anger: Falls es ein Signal gibt, rufen Sie an, ja? {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487236
    m_Localized: 'Anger: Sagen Sie ihr, dass ich mich an alles erinnere ... und dass ich mir immer noch die Kehle aufschlitzen will.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487237
    m_Localized: 'Anger: Sie können sie auch einfach anschreien. Für mich. Ich weiß nicht ... Vielleicht macht das alles ein bisschen einfacher.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487238
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875840
    m_Localized: 'FortuneTeller: Und manche ... Tja, manche brauchen Hilfe aus dem Jenseits.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875841
    m_Localized: 'FortuneTeller: Es gibt Menschen ... Experten ... die wissen, wie man die Dunkelheit vertreibt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875842
    m_Localized: 'FortuneTeller: Wenn du willst, kann ich dir einen Kontakt geben. Könnte hilfreich sein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875843
    m_Localized: 'FortuneTeller: Ich schreibe dir die Nummer auf: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875844
    m_Localized: 'FortuneTeller: Sag auf jeden Fall, dass du auf meine Empfehlung anrufst. Nicht vergessen!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547533041664
    m_Localized: 'Alkonost: Könntest du ihn anrufen, wenn es nicht zu viele Umstände macht? {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235968
    m_Localized: 'Foreigner: (Er gibt Ihnen einen Zettel mit einer Telefonnummer: {0})'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235969
    m_Localized: 'Foreigner: (Es könnte die Nummer einer ausländischen Botschaft sein)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818880
    m_Localized: 'Jacob: Mann, würde ich jetzt gerne einen trinken.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818881
    m_Localized: Was haben Sie damit gemeint, unsterblich zu sein?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818882
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818883
    m_Localized: 'Jacob: Na ja ... Sie könnten sich selbst in den Kopf schießen und es überprüfen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818884
    m_Localized: 'Jacob: Aber das würde ich an Ihrer Stelle lieber lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818885
    m_Localized: 'Jacob: Nein, natürlich sind wir nicht unsterblich, so wie Sie es sich vorstellen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818886
    m_Localized: 'Jacob: Nach dem Tod werden wir wiedergeboren und leben weiter unser Leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818887
    m_Localized: 'Jacob: Ich weiß, wie das klingt, aber wenn Sie gesehen hätten, was ich gesehen habe ... würden Sie es verstehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818888
    m_Localized: 'Jacob: Vielleicht waren die Besucher früher Menschen und wurden dann wiedergeboren.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818889
    m_Localized: 'Jacob: Ich bin mir nicht sicher. Ich weiß nicht, wie das Ganze funktioniert ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818890
    m_Localized: 'Jacob: Aber ich bin mir sicher, dass die Natur jede Menge Geheimnisse hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818891
    m_Localized: 'Jacob: Und ich werde meine Tochter finden.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818892
    m_Localized: 'Jacob: Ich weiß nicht, in welchem Leben ... aber ich werde sie finden.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818893
    m_Localized: 'Jacob: Weil wir niemals sterben werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818894
    m_Localized: 'Jacob: Mann, würde ich jetzt gerne einen trinken.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818895
    m_Localized: Warum sucht die FEMA nach Ihnen?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818896
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818897
    m_Localized: 'Jacob: Ich war im Zentrum dieser ganzen Scheiße.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818898
    m_Localized: 'Jacob: Dort, wo diese Dinger rausgekrochen sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818899
    m_Localized: 'Jacob: Erinnern Sie sich an diese albernen Legenden über Dämonen in den Vororten?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818900
    m_Localized: 'Jacob: Egal, inzwischen erinnert sich niemand mehr daran.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818901
    m_Localized: 'Jacob: Wie sich herausgestellt hat, waren es gar keine Legenden. Die FEMA wusste es die ganze Zeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818902
    m_Localized: 'Jacob: Sie behauptete, dass es hier nichts Ungewöhnliches gibt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818903
    m_Localized: 'Jacob: Und jetzt werden alle von der Sonne verbrannt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818904
    m_Localized: 'Jacob: Während Monster aus dem Untergrund die letzten Überlebenden umbringen!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818905
    m_Localized: 'Jacob: Die FEMA hat gemerkt, dass sie großen Mist gebaut hat ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818906
    m_Localized: 'Jacob: Und jetzt vertuscht sie ihre Inkompetenz.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818907
    m_Localized: 'Jacob: Ich war einfach nur zur falschen Zeit am falschen Ort.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818908
    m_Localized: 'Jacob: Mann, würde ich jetzt gerne einen trinken.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818909
    m_Localized: Wie haben Sie überlebt?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818910
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818911
    m_Localized: 'Jacob: Ich bin unsterblich. Schon vergessen?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818912
    m_Localized: 'Jacob: Ich weiß nicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818913
    m_Localized: 'Jacob: Das frage ich mich auch.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818914
    m_Localized: 'Jacob: Vielleicht hatte ich Glück. Oder irgendeine höhere Macht beschützt mich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818915
    m_Localized: 'Jacob: Gott, oder woran auch immer Sie glauben.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818916
    m_Localized: 'Jacob: Vielleicht bin ich auch schon tot, und das hier ist mein neues Leben. Ich weiß es nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818917
    m_Localized: 'Jacob: Gute Frage.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818918
    m_Localized: 'Jacob: Schade, dass ich keine Waffe habe. Ich würde Sie dasselbe fragen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818919
    m_Localized: 'Jacob: Und schade, dass Sie nur Bier haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818920
    m_Localized: 'Jacob: Wenn ich eine Destille hätte, würde ich einen feinen Schnaps brennen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818921
    m_Localized: 'Jacob: Mann, würde ich jetzt gerne einen trinken.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818922
    m_Localized: Was wissen Sie noch?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818923
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818924
    m_Localized: 'Jacob: Ich kenne die ganze Struktur der FEMA in- und auswendig.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818925
    m_Localized: 'Jacob: Wer welchen Vorgesetzten hat, wer welche Aufgaben hat und wer wen übers Ohr haut.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818926
    m_Localized: 'Jacob: Und diese Schweine wussten alles über die Besucher. Sie wussten, wie gefährlich sie sind ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818927
    m_Localized: 'Jacob: Und sie haben sie trotzdem in die Stadt gelassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818928
    m_Localized: 'Jacob: Weil alle auf die Sicherheit gepfiffen haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818929
    m_Localized: 'Jacob: Sie haben lieber Regierungsgeld gewaschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818930
    m_Localized: 'Jacob: Jeder, der von ihrem Versagen wusste, wurde zum Schweigen gebracht.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818931
    m_Localized: 'Jacob: Die Organisation wollte nicht, dass jemand Bescheid weiß.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818932
    m_Localized: 'Jacob: Und das war sogar noch vor den Quarantänezonen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818933
    m_Localized: 'Jacob: Ich bin gerade noch entkommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818934
    m_Localized: 'Jacob: Wollen Sie streng geheime Informationen? Hier, bitte ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818935
    m_Localized: 'Jacob: Die FEMA ist an allem schuld.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818936
    m_Localized: 'Jacob: Alles, was sie im Fernsehen sagen, ist völliger Quatsch.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818937
    m_Localized: 'Jacob: Wenn es irgendwas gibt, was noch schlimmer ist als die Besucher ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818938
    m_Localized: 'Jacob: Dann die FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818939
    m_Localized: 'Jacob: Mann, würde ich jetzt gerne einen trinken.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818940
    m_Localized: Woher sind die Besucher gekommen?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818941
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818942
    m_Localized: 'Jacob: Aus den Vororten.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818943
    m_Localized: 'Jacob: Ja, ich weiß, dass die Quarantänezonen weit weg von hier sind ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818944
    m_Localized: 'Jacob: Aber ich bin mir sicher.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818945
    m_Localized: 'Jacob: Ich bin nicht abergläubisch, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818946
    m_Localized: 'Jacob: Es sind dieselben Dämonen, von denen die Leute vor zwei Jahren gesprochen haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818947
    m_Localized: 'Jacob: Ich weiß nicht, wie sie in die Stadt gekommen sind ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818948
    m_Localized: 'Jacob: Aber ich weiß, wer sie reingelassen hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818949
    m_Localized: 'Jacob: Die FEMA ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818950
    m_Localized: 'Jacob: Die Besucher sind keine Außerirdischen, wie viele denken.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818951
    m_Localized: 'Jacob: Sie sind Geschöpfe wie Sie und ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818952
    m_Localized: 'Jacob: Sie wurden hier geboren!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818953
    m_Localized: 'Jacob: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818954
    m_Localized: 'Jacob: Ich kann nicht länger hierbleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818955
    m_Localized: 'Jacob: Ich muss meine Tochter finden.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818956
    m_Localized: 'Jacob: Danke ... Unsterblicher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471999
    m_Localized: 'Fatman: Ah ... kaltes Wasser. So gefällt mir das.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472000
    m_Localized: Fühlst du dich besser?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472001
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472002
    m_Localized: 'Fatman: Ja, ja, mir geht’s besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472003
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472004
    m_Localized: 'Fatman: Obwohl ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472005
    m_Localized: 'Fatman: Ich bekomme langsam Hunger. Hast du was zu knabbern?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472006
    m_Localized: Du kannst Bier haben (eine Dose Bier geben)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472007
    m_Localized: 'Fatman: Was, kein Bier?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472008
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472009
    m_Localized: 'Fatman: Verarsch mich nicht. Ich hab gesehen, dass dein Kühlschrank voll damit war. Hast du das etwa alles schon weggetrunken?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472010
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472011
    m_Localized: 'Fatman: Ooh, so gefällt mir das!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472012
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472013
    m_Localized: 'Fatman: Mmm, lecker. Das mag ich am liebsten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472014
    m_Localized: 'Fatman: Hier ist etwas Bargeld für dich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472015
    m_Localized: 'Fatman: (Sie bekommen eine Handvoll zerknüllter Scheine, die in diesen Zeiten nutzlos sind)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472016
    m_Localized: Äh ... danke
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472017
    m_Localized: Dein Geld interessiert mich nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472018
    m_Localized: 'Fatman: Na, wer sagt’s denn!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472019
    m_Localized: 'Fatman: Du gibst mir, was ich will, und ich entlohne dich dafür wie einen Fabrikchef.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472020
    m_Localized: 'Fatman: Bei Leuten, die mir helfen, bin ich nicht knauserig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472021
    m_Localized: 'Fatman: Ach, übrigens – hier, nimm das.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472022
    m_Localized: 'Fatman: (Sie bekommen ein Kombucha-Glas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472023
    m_Localized: 'Fatman: Keine Ahnung, wer diesen Mist trinkt, aber nimm es. Könnte nützlich sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472024
    m_Localized: 'Fatman: Was meinst du damit, dass es dich nicht interessiert? Glaubst du, du bist was Besonderes oder so?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472025
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472026
    m_Localized: 'Fatman: Jeder braucht Geld! Die ganze verdammte Welt dreht sich darum. Braucht kein Geld, pff ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472027
    m_Localized: 'Fatman: Hier, nimm das!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472028
    m_Localized: 'Fatman: (Sie bekommen ein Kombucha-Glas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472029
    m_Localized: 'Fatman: Keine Ahnung, wer diesen Mist trinkt, aber nimm es. Könnte nützlich sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472030
    m_Localized: 'Fatman: Was meinst du mit „Nein“? Hältst du dich für unkäuflich? Alles ist käuflich! Liebe, Dinge, Menschen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472031
    m_Localized: 'Fatman: Geld regiert die Welt, Junge! Und ich? Ich bin eine große Nummer! Ein Minister!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472032
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472033
    m_Localized: 'Fatman: Na gut, vergiss es. Wenn du mir nicht helfen willst, dann leck mich doch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472034
    m_Localized: 'Fatman: Ah ... kaltes Wasser. So gefällt mir das.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472035
    m_Localized: Was brauchst du diesmal?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472036
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472037
    m_Localized: 'Fatman: Oh, gut, dass du fragst! Ich könnte eine Zigarette gebrauchen. Hast du eine übrig?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472038
    m_Localized: 'Ja, greif zu (Zigaretten geben) '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472039
    m_Localized: 'Fatman: Was, keine Zigaretten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472040
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472041
    m_Localized: 'Fatman: Na gut, vergiss es.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472042
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472043
    m_Localized: 'Fatman: So gefällt mir das!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472044
    m_Localized: 'Fatman: Früher habe ich natürlich Zigarren geraucht ... aber die findet man heute kaum noch. Als ich noch im Stadtrat war ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472045
    m_Localized: 'Fatman: Ja ... da war alles anders. Jetzt herrschen Mord und Chaos. Ein absoluter Albtraum!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472046
    m_Localized: 'Fatman: Wann schreitet die FEMA endlich ein und sorgt für Ordnung? Sie wurde doch nicht umsonst gegründet, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472047
    m_Localized: 'Fatman: Als ich noch im Parlament war, gab es diesen Mist noch nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472048
    m_Localized: 'Fatman: Aber vielleicht brauchen sie einfach Zeit. Irgendwann wird sich alles von selbst regeln. Wir müssen nur abwarten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472049
    m_Localized: Du warst im Parlament?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472050
    m_Localized: Warst du an der Gründung der FEMA beteiligt?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472051
    m_Localized: 'Fatman: Ja, das habe ich dir doch gerade gesagt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472052
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472053
    m_Localized: 'Fatman: Ach ja, hier ist deine Belohnung!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472054
    m_Localized: 'Fatman: (Sie bekommen eine Handvoll zerknüllter, wertloser Geldscheine und eine seltsame Postkarte mit einem FEMA-Stempel)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472055
    m_Localized: 'Fatman: Wie kommst du denn auf die Idee?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472056
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472057
    m_Localized: 'Fatman: Ach ja, hier ist deine Belohnung!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472058
    m_Localized: 'Fatman: (Sie bekommen eine Handvoll zerknüllter, wertloser Geldscheine und eine seltsame Postkarte mit einem FEMA-Stempel)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472059
    m_Localized: 'Fatman: Was soll das heißen, „Nein“? Weißt du überhaupt, wer ich bin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472060
    m_Localized: 'Fatman: Ich war Minister! Die Regierung ist ein kompliziertes System, und sie braucht Leute wie mich, um sie zu leiten!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472061
    m_Localized: 'Fatman: Ich bin die Stimme des Volkes! Ohne mich würden Leute wie du gar nicht gehört werden. Ich mache das Leben besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472062
    m_Localized: 'Fatman: In normalen Zeiten würdest du es nicht mal wagen, mir zu widersprechen! Man würde dich sofort abführen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472063
    m_Localized: 'Fatman: Die Welt bricht zusammen ... Der Ministerstatus ist wertlos. Alle denken, wir drehen in unseren Ämtern nur Däumchen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472064
    m_Localized: 'Fatman: Hehe. Mal sehen, was du sagst, wenn die Hölle losbricht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472065
    m_Localized: 'Fatman: Ah ... kaltes Wasser. So gefällt mir das.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472066
    m_Localized: Brauchst du wieder was?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472067
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472068
    m_Localized: 'Fatman: Du bist ein schlauer Junge!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472069
    m_Localized: 'Fatman: Ich will ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472070
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472071
    m_Localized: 'Fatman: Ich will einen Energydrink! Ich habe seit Ewigkeiten nichts Frisches und Belebendes mehr getrunken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472072
    m_Localized: 'Na gut, hier (Energydrink geben) '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472073
    m_Localized: 'Fatman: Hast du keinen EnerJeka?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472074
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472075
    m_Localized: 'Fatman: Na gut, vergiss es.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472080
    m_Localized: Da hast du Pech
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472081
    m_Localized: 'Fatman: Oooh, ja-ja-ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472082
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472084
    m_Localized: Erzähl mir von der FEMA. Wer sind die?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472085
    m_Localized: Was plant die FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472101
    m_Localized: 'Fatman: Was, der ist zuckerfrei? Das ist doch Mist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472104
    m_Localized: 'Fatman: Du hättest mir lieber eine Limo bringen sollen statt diesem Müll ... Warte, was hast du gerade gefragt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472105
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472106
    m_Localized: 'Fatman: Bist du verrückt geworden? Ich sag dir überhaupt nichts. Das ist geheim!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472107
    m_Localized: 'Fatman: Ich hab eine Erklärung unterschrieben, klar? Geheimhaltung. Du bist nicht befugt, das zu erfahren, nichts für ungut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472108
    m_Localized: 'Fatman: Hier, trink stattdessen einen Kaffee und hör auf, solche Fragen zu stellen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472109
    m_Localized: 'Fatman: (Sie bekommen eine Dose Kaffee)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472110
    m_Localized: 'Fatman: Und auch noch EnerJeka. Wer weiß, was für einen Müll die da reintun ... Moment, was hast du gerade gefragt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472111
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472112
    m_Localized: 'Fatman: Bist du verrückt geworden? Ich sag dir überhaupt nichts. Das ist geheim!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472113
    m_Localized: 'Fatman: Ich hab eine Erklärung unterschrieben, klar? Geheimhaltung. Du bist nicht befugt, das zu erfahren, nichts für ungut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472114
    m_Localized: 'Fatman: Hier, trink stattdessen einen Kaffee und hör auf, solche Fragen zu stellen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472115
    m_Localized: 'Fatman: (Sie bekommen eine Dose Kaffee)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472116
    m_Localized: 'Fatman: Was zum Teufel meinst du damit? Wie soll ich mit leerem Magen arbeiten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472117
    m_Localized: 'Fatman: Ich rackere mich hier ab, um das Leben aller besser zu machen! Ich setze mich für die Leute ein!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472118
    m_Localized: 'Fatman: Aber ihr kritisiert immer nur ... Alle halten sich für so schlau. Warum seid ihr dann nicht in der Regierung, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472119
    m_Localized: 'Fatman: Genau. Große Schnauze und nichts dahinter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472120
    m_Localized: 'Fatman: Ah ... kaltes Wasser. So gefällt mir das.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472121
    m_Localized: Was? Brauchst du wieder was?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472122
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472123
    m_Localized: 'Fatman: Genau, Junge. Ich will deine Schrotflinte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472124
    m_Localized: Was?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472125
    m_Localized: Jetzt hast du ganz den Verstand verloren
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472126
    m_Localized: 'Fatman: Ja, ich brauche sie zu meinem Schutz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472127
    m_Localized: 'Fatman: Keine Sorge, ich habe früher gejagt. Ich weiß, wie man damit umgeht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472128
    m_Localized: Die kriegst du nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472129
    m_Localized: Fahr zur Hölle
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472130
    m_Localized: 'Fatman: Pass auf, was du sagst, Junge. Hast du vergessen, mit wem du redest?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472131
    m_Localized: 'Fatman: Wenn ich will, kann ich dich im Handumdrehen hinter Gitter bringen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472132
    m_Localized: Die kriegst du nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472133
    m_Localized: Fahr zur Hölle
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472134
    m_Localized: 'Fatman: Was hast du gerade gesagt? Habe ich das richtig gehört?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472135
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472136
    m_Localized: 'Fatman: Das war’s. Jetzt bist du dran!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472137
    m_Localized: 'Fatman: Pack deine Sachen, denn du bist schon so gut wie im Knast.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472138
    m_Localized: Für mich bist du nur ein weiterer Besucher
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472139
    m_Localized: Minister hin oder her, für mich bist du ein Niemand
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472140
    m_Localized: 'Fatman: Hast du den Verstand verloren, dass du so mit der Stimme des Volkes sprichst?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472141
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472142
    m_Localized: 'Fatman: Du bist am Arsch, Kumpel. Mach dich bereit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472143
    m_Localized: 'Fatman: Es war ein großer Fehler, mich wütend zu machen! Stadträte sind mächtige Leute, falls du das noch nicht wusstest!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472144
    m_Localized: 'Fatman: Keine Sorge ... Du wirst dich schon bald fügen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472145
    m_Localized: Für mich bist du nur ein weiterer Besucher
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472146
    m_Localized: Minister hin oder her, für mich bist du ein Niemand
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472147
    m_Localized: 'Fatman: Wie war das?! Du ... pass lieber auf, was du sagst!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472148
    m_Localized: 'Fatman: Ich mache keine Witze. Ich meine es todernst. Du wirst wirklich hinter Gittern landen, du wirst schon sehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472149
    m_Localized: 'Fatman: Wie war das?! Du ... pass lieber auf, was du sagst!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472150
    m_Localized: 'Fatman: Ich mache keine Witze. Ich meine es todernst. Du wirst wirklich hinter Gittern landen, du wirst schon sehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472151
    m_Localized: 'Fatman: Ah ... kaltes Wasser. So gefällt mir das.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472152
    m_Localized: Warum bin ich dann noch nicht im Knast?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472153
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472154
    m_Localized: 'Fatman: Machst du dich über mich lustig? Ich ... ich mache hier keine Witze! Du wirst wirklich dort landen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472155
    m_Localized: Titel waren vielleicht mal wichtig, aber jetzt bist du ein Niemand
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472156
    m_Localized: Geld bedeutet nichts mehr. Raffst du das nicht?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472157
    m_Localized: 'Fatman: Das ... das stimmt nicht! Ich bin immer noch im Parlament!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472158
    m_Localized: 'Fatman: Sie haben mich nur ... beurlaubt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472159
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472160
    m_Localized: 'Fatman: Wem mache ich hier was vor ... Das Leben wird nie wieder so sein wie früher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472161
    m_Localized: 'Fatman: Als ich noch im Amt war, hat das ganze Land für uns Minister gearbeitet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472162
    m_Localized: 'Fatman: Man hat mich gefürchtet. Respektiert. Autos haben Platz gemacht, die Massen haben mir geschmeichelt. Und jetzt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472163
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472164
    m_Localized: 'Fatman: Toll. Jetzt habe ich vor lauter Stress Magenschmerzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472165
    m_Localized: 'Fatman: Bist du jetzt zufrieden? Geh einfach. Ich hab genug ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472166
    m_Localized: 'Fatman: D-Das stimmt nicht! Ich hab noch jede Menge Geld!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472167
    m_Localized: 'Fatman: Dir ist das vielleicht egal, aber ... aber allen anderen nicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472168
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472169
    m_Localized: 'Fatman: Wem mache ich hier was vor ... Das Leben wird nie wieder so sein wie früher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472170
    m_Localized: 'Fatman: Kein Luxus mehr, keine Limousinen, keine Frauen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472171
    m_Localized: 'Fatman: Mit Geld war früher alles so viel einfacher. Wenn du Kohle hattest, warst du jemand!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472172
    m_Localized: 'Fatman: Wenn es nicht den Zusammenbruch gegeben hätte ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472173
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472174
    m_Localized: 'Fatman: Toll. Jetzt habe ich vor lauter Stress Magenschmerzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472175
    m_Localized: 'Fatman: Bist du jetzt zufrieden? Geh einfach. Ich hab genug ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054893
    m_Localized: 'BigLebowski: Gott, ich hab das alles satt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054894
    m_Localized: Warum ziehst du ganz allein umher?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054895
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054896
    m_Localized: 'BigLebowski: Tja ... zu Hause war es mir zu eng. Viel zu laut. Null Komfort. Ich wollte raus. Ich wollte die Welt sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054897
    m_Localized: 'BigLebowski: Also schnappte ich mir einen Rucksack, ein paar Limos, Snacks und dieses alte Freundschaftsarmband aus der Schule.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054898
    m_Localized: 'BigLebowski: Und ich ging. Meine Eltern haben es wahrscheinlich nicht mal gemerkt. Nicht, dass es mich interessiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054899
    m_Localized: 'BigLebowski: Seitdem treibe ich mich einfach so herum und schlafe, wo ich kann. Und ehrlich gesagt? Bisher war es okay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054900
    m_Localized: 'BigLebowski: Zumindest sitzt mir niemand im Nacken und ich bin mein eigener Chef.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054903
    m_Localized: 'BigLebowski: Gott, ich hab das alles satt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054904
    m_Localized: Und wie hast du überlebt?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054905
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054906
    m_Localized: 'BigLebowski: Irgendwie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054907
    m_Localized: 'BigLebowski: Ich schlich mich in Treppenhäuser, Schuppen oder schlief auf dem nackten Boden. Ich versteckte mich vor der Hitze, wo ich konnte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054908
    m_Localized: 'BigLebowski: Ich aß, was ich kriegen konnte. Etwas Grünzeug oder einen Schokoriegel, den ich aus einem Laden geklaut hatte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054909
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054910
    m_Localized: 'BigLebowski: Was soll dieser Blick? Ich hab geklaut, na und? Wie soll ich sonst überleben? In meinem Alter stellt mich keiner ein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054911
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054912
    m_Localized: 'BigLebowski: Gott, ich hab das alles satt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054913
    m_Localized: Wie lange willst du noch so leben?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054914
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054915
    m_Localized: 'BigLebowski: Was kümmert dich das? Ich finde schon eine Lösung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054916
    m_Localized: 'BigLebowski: Oder kannst du nicht ertragen, dass ich hierbleibe? Hab ich dich beklaut? Die Toilette verstopft? Warum verhörst du mich so?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054917
    m_Localized: 'BigLebowski: Verstehe ... vielleicht bist du einer von diesen Widerlingen'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054918
    m_Localized: 'BigLebowski: Da war mal so ein Typ, der mich aufgenommen hat. Er hat nett mit mir geredet und mir einen Platz zum Schlafen gegeben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054919
    m_Localized: 'BigLebowski: Wir haben ewig über Anime, Filme und so gequatscht. Ich dachte, ich hätte endlich einen anständigen Typen gefunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054920
    m_Localized: 'BigLebowski: Dann hat er versucht, mich anzufassen. Verdammter Widerling.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054921
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054922
    m_Localized: 'BigLebowski: Gott, ich hab das alles satt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054923
    m_Localized: Und was ist mit dem Typen passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054924
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054925
    m_Localized: 'BigLebowski: Warum fragst du? Überlegst du, wie du mit mir fertig wirst, wenn ich mich wehre? Hast du gecheckt, dass ich von ihm weg bin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054926
    m_Localized: 'BigLebowski: Und glaub nicht, dass ich es nicht verstehe. Du fragst nicht aus Freundlichkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054927
    m_Localized: 'BigLebowski: Du willst einfach keinen Ärger unter deinem Dach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054928
    m_Localized: 'BigLebowski: Aber ich bin kein Ärger. Ich stehle nicht, ich schlage keine Fenster ein, also hör auf, mich so zu behandeln!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054929
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054930
    m_Localized: 'BigLebowski: Und überhaupt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054931
    m_Localized: 'BigLebowski: Ich bin nur hier, weil du mich brauchst, oder? Damit dieser halbnackte Besucher dich nicht mitnimmt. Ja, ich hab auch die Nachrichten gehört.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054932
    m_Localized: 'BigLebowski: Gott, ich hab das alles satt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054933
    m_Localized: Warum hat dein Vater dir das Kämpfen beigebracht?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054934
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054935
    m_Localized: 'BigLebowski: Damit ich die Widerlinge verprügeln kann. Oder damit er es an mir auslassen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054936
    m_Localized: 'BigLebowski: Er hat mich trainiert, seit ich ungefähr drei war. Sparring, Schläge einstecken, blabla. Das einzige Problem? Anstelle eines Boxsacks war es mein Gesicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220801
    m_Localized: 'Doctor: Ich bin ganz Ohr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220802
    m_Localized: Was ist mit den Krankenhäusern geschehen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220803
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220804
    m_Localized: 'Doctor: Oh, es war ein Albtraum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220805
    m_Localized: 'Doctor: Sobald alles begann, strömten die Leute in die Krankenhäuser. Alle wollten unbedingt wissen, ob sie ein Besucher sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220806
    m_Localized: 'Doctor: Wir versuchten zu erklären, dass wir nicht wirklich wussten, wie man das testet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220807
    m_Localized: 'Doctor: Aber sie hörten nicht zu. Sie drängelten und schubsten, sodass es unmöglich wurde, die echten Kranken zu behandeln.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220808
    m_Localized: 'Doctor: Dann tauchte die FEMA auf. Sie entschied, dass die Menschenmassen angesichts der Ausbreitung eine Gefahr darstellten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220809
    m_Localized: 'Doctor: Also wurden alle in Quarantänezonen geschickt, und die Krankenhäuser ... wurden einfach geschlossen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220810
    m_Localized: Die FEMA hat Sie also arbeitslos gemacht?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220811
    m_Localized: Die FEMA hat das Falsche getan?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220812
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220813
    m_Localized: 'Doctor: Offen gestanden ... nachdem die Krankenhäuser geschlossen wurden, habe ich in den Quarantänezonen der FEMA gearbeitet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220814
    m_Localized: Warum sind Sie dorthin gegangen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220815
    m_Localized: Sie sind also auch nur ein FEMA-Bastard
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220816
    m_Localized: 'Doctor: Und finden Sie es richtig, einfach alle so zusammenzutreiben?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220817
    m_Localized: 'Doctor: Finden Sie diese „Anzeichen“ nicht absurd, die nichts weiter als gewöhnliche menschliche Eigenschaften sind?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220818
    m_Localized: 'Doctor: Das ist alles Unsinn! Weiße Zähne sollen bedeuten, dass jemand ein Besucher ist? Ich bitte Sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220819
    m_Localized: 'Doctor: Ich sage Ihnen, sie verheimlichen uns etwas ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220820
    m_Localized: 'Doctor: Offen gestanden ... nachdem die Krankenhäuser geschlossen wurden, habe ich in den Quarantänezonen der FEMA gearbeitet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220821
    m_Localized: 'Doctor: Ich hatte gehofft, etwas über die Besucher und ihre Anzeichen zu erfahren. Aber ... daraus wurde nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220822
    m_Localized: Warum sind Sie dorthin gegangen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220823
    m_Localized: Sie sind also auch nur ein FEMA-Bastard
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220824
    m_Localized: 'Doctor: Ich ... Ich wollte weiterhin Menschen helfen. Das ist meine Berufung. Ich konnte ihr nicht einfach den Rücken kehren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220825
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220826
    m_Localized: 'Doctor: Vielleicht ... Nein. Verzeihen Sie mir, ich bin noch nicht bereit, darüber zu sprechen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220827
    m_Localized: 'Doctor: Sie können mich doch nicht einfach als Bastard bezeichnen. Sie kennen nicht die ganze Geschichte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220828
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220829
    m_Localized: 'Doctor: Vielleicht ... Nein. Verzeihen Sie mir, ich bin noch nicht bereit, darüber zu sprechen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220830
    m_Localized: 'Doctor: Ich bin ganz Ohr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220831
    m_Localized: Also, was wollten Sie mir sagen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220832
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220833
    m_Localized: 'Doctor: Darf ich fragen, was Sie von der FEMA halten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220834
    m_Localized: Ich finde, die FEMA leistet gute Arbeit
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220835
    m_Localized: Ich traue der FEMA nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220836
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220837
    m_Localized: 'Doctor: Schade. Ich sehe das ganz anders.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220838
    m_Localized: 'Doctor: Ich habe eine Weile da gearbeitet, aber trauen werde ich ihr nicht. Vor allem nicht nach dem, was ich dort gesehen habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220839
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220840
    m_Localized: 'Doctor: Aus eigener Erfahrung weiß ich, dass die Ärzte in dieser Organisation völlig im Dunkeln gelassen werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220841
    m_Localized: 'Doctor: Trauen Sie wirklich einer Organisation, die nicht erklären kann, woher diese Anzeichen kommen und was sie bedeuten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220842
    m_Localized: 'Doctor: Wie können Sie nach all dem der FEMA noch trauen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220843
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220844
    m_Localized: 'Doctor: Ich muss zugeben, dass ich Sie für klüger gehalten habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220845
    m_Localized: 'Doctor: Gut. Ich auch nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220846
    m_Localized: 'Doctor: Ich verstehe die Motive der FEMA auch nicht ganz. Selbst nachdem ich eine Weile mit ihr zusammengearbeitet habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220847
    m_Localized: 'Doctor: Aber was auch immer sie antreibt, ich will den Menschen auf meine eigene Weise helfen, entgegen ihren Regeln.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220848
    m_Localized: 'Doctor: Das Problem war die Transparenz. Es gab keine. Überhaupt keine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220849
    m_Localized: 'Doctor: Uns wurde nie mitgeteilt, woher diese „Anzeichen“ kamen oder was sie bedeuten sollten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220850
    m_Localized: 'Doctor: Man gab uns lediglich eine Liste mit Richtlinien, wen wir als Besucher bezeichnen und wen wir durchlassen sollten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220851
    m_Localized: 'Doctor: Danach fühlte ich mich nicht mehr wie ein Arzt. Eher wie ein Grenzwächter, der Papiere abstempelt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220852
    m_Localized: 'Doctor: Also begann ich, Berichte zu fälschen. Ich half Menschen bei der Flucht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220853
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220854
    m_Localized: 'Doctor: Sie haben sicher noch Fragen. Aber wenn es Ihnen nichts ausmacht, lassen Sie uns den Rest auf morgen verschieben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220855
    m_Localized: 'Doctor: Ich bin ganz Ohr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220856
    m_Localized: Warum sind Sie nicht in einer Quarantänezone?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220857
    m_Localized: Ich muss Sie testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220858
    m_Localized: 'Doctor: Da war ... dieser eine Vorfall ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220859
    m_Localized: 'Doctor: Die Sonne ging gerade auf. Ich war auf dem Weg nach Hause, als mich einer der FEMA-Beamten ansprach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220860
    m_Localized: 'Doctor: In diesem Moment begann mein Herz zu rasen, meine Knie gaben fast nach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220861
    m_Localized: 'Doctor: Er befahl mir, mich umzudrehen. Ich war bereit, in diesem Moment zu sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220862
    m_Localized: 'Doctor: Er richtete sein Gewehr auf meine Beine und befahl mir, mich nicht zu bewegen. Er starrte mich an und dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220863
    m_Localized: 'Doctor: Forderte er mich auf, die Zunge herauszustrecken, um zu prüfen, ob ich ein Besucher sei. Ich tat es, aus Angst, er könnte mich sonst erschießen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220864
    m_Localized: 'Doctor: Dann ... lachte er. Er sagte, ich wäre ein schlechter Arzt, wenn ich nicht wüsste, dass die Zunge kein Anzeichen für Besucher sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220865
    m_Localized: 'Doctor: Ich hatte noch nie so viel Angst um mein Leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220866
    m_Localized: 'Doctor: In diesem Moment dachte ich nicht mehr daran, jemandem das Leben zu retten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220867
    m_Localized: 'Doctor: Ich bin einfach weggerannt. Wie ein Feigling.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220868
    m_Localized: 'Doctor: Die Scham darüber ... ist unerträglich. Die Scham vor denen, die dort zurückgelassen wurden. Vor mir selbst. Vor allen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220869
    m_Localized: Ich verurteile Sie nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220870
    m_Localized: Aber Sie können immer noch Menschen helfen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220871
    m_Localized: Sie sind ein erbärmlicher Feigling. Verlassen Sie mein Haus
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220872
    m_Localized: 'Doctor: Vielen Dank für Ihr Verständnis. Das ... das tröstet mich ein wenig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220873
    m_Localized: 'Doctor: Ich muss ständig daran denken, wie viele Leben ich hätte retten können, wenn ich bis zum Ende dort geblieben wäre ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220874
    m_Localized: 'Doctor: Ich fürchte, das kann ich nicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220875
    m_Localized: 'Doctor: Ich habe alle meine Instrumente in der Quarantänezone zurückgelassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220876
    m_Localized: 'Doctor: Also ... bin ich jetzt völlig nutzlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220877
    m_Localized: 'Doctor: Ich weiß, dass Sie auf eine Behandlung gehofft haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220878
    m_Localized: 'Doctor: Aber was kann ein alter Mann wie ich mit bloßen Händen schon ausrichten? Fast nichts ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220879
    m_Localized: 'Doctor: Es tut mir leid, wenn ich Sie enttäuscht habe. Ich fürchte, ich bin machtlos gegen die Bedrohung durch die Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220880
    m_Localized: Keine Sorge, Sie können trotzdem bleiben
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220881
    m_Localized: Dann wissen Sie ja, wo die Tür ist
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220882
    m_Localized: 'Doctor: Sie haben wohl recht. Ich sollte gehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220883
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220884
    m_Localized: 'Doctor: Auf Wiedersehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220885
    m_Localized: 'Doctor: Vielen Dank für Ihr Verständnis. Das ... das tröstet mich ein wenig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220886
    m_Localized: 'Doctor: Ich vermute, dass die FEMA die falschen Berichte früher oder später entdeckt hätte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220887
    m_Localized: 'Doctor: Trotzdem werde ich den Gedanken nicht los, dass ich mein Leben hätte opfern und mehr Menschen retten können ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220888
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220889
    m_Localized: 'Doctor: Ich befürchte, dass mich diese Schuld für den Rest meines Lebens verfolgen wird.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220890
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220891
    m_Localized: 'Doctor: Ich denke, Sie haben recht. Hier ist kein Platz für einen alten Mann wie mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220892
    m_Localized: 'Doctor: Auf Wiedersehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415069
    m_Localized: 'TaxiDriver: Sei nicht so schüchtern, Mann. Frag ruhig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415070
    m_Localized: Denkst du immer noch, dass die FEMA hinter dir her ist?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415071
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415072
    m_Localized: 'TaxiDriver: Ich hoffe nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415073
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415074
    m_Localized: 'TaxiDriver: Ja, es war dumm, zur FEMA zu gehen. Ich hätte wissen müssen, dass sie versuchen würden, mich auch zu schnappen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415075
    m_Localized: 'TaxiDriver: Ich dachte, sie würden nur den Fahrgast mitnehmen und mich in Ruhe lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415076
    m_Localized: 'TaxiDriver: Stattdessen haben sie mein Auto mitgenommen und mich fast erschossen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415077
    m_Localized: 'TaxiDriver: Aber überleg mal, was hätte ich sonst tun sollen? Der Typ war ein Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415078
    m_Localized: 'TaxiDriver: Sei nicht so schüchtern, Mann. Frag ruhig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415079
    m_Localized: Wie lange fährst du schon Taxi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415080
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415081
    m_Localized: 'TaxiDriver: Ja, ich mache das schon eine Weile. Momentan arbeite ich für keine Firma, ich bin mein eigener Chef.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415082
    m_Localized: 'TaxiDriver: Die FEMA lässt Zivilisten nicht gerade frei herumlaufen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415083
    m_Localized: 'TaxiDriver: Aber dieses Chaos wird irgendwann vorbei sein, oder? Und Geld ... Geld ist immer gut zu haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415084
    m_Localized: 'TaxiDriver: Die Leute zahlen echt gut für riskante Fahrten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415085
    m_Localized: 'TaxiDriver: Und nachts zu fahren weckt irgendwie Erinnerungen an meine Kindheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415086
    m_Localized: 'TaxiDriver: Weißt du, ich bin wegen meinem Vater Taxifahrer geworden. Ich wollte in seine Fußstapfen treten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415087
    m_Localized: 'TaxiDriver: Sei nicht so schüchtern, Mann. Frag ruhig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415088
    m_Localized: Du wirkst heute ziemlich niedergeschlagen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415089
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415090
    m_Localized: 'TaxiDriver: Ja, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415091
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415092
    m_Localized: 'TaxiDriver: Ich komme einfach nicht darüber hinweg, dass mein Auto weg ist, weißt du ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415096
    m_Localized: 'TaxiDriver: Sei nicht so schüchtern, Mann. Frag ruhig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415097
    m_Localized: Was ist mit deinem Vater passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415098
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609403
    m_Localized: 'FormerFema: Hoffentlich habe ich mich nicht zu sehr der Sonne ausgesetzt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609404
    m_Localized: Bist du sicher, dass du nicht bei der FEMA bist?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609405
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609406
    m_Localized: 'FormerFema: Nein, ich gehöre wirklich nicht zu denen. Ich habe dir doch gesagt, dass ich früher Kühlschränke repariert habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609407
    m_Localized: 'FormerFema: Ich habe die Uniform im Auto gefunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609408
    m_Localized: Vorhin hast du gesagt, du hättest sie einer Leiche abgenommen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609409
    m_Localized: Du lügst mich doch nicht an, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609410
    m_Localized: 'FormerFema: Naja ... naja, ja, klar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609411
    m_Localized: 'FormerFema: Ich habe sie in einem Auto gefunden, an einem Toten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609412
    m_Localized: 'FormerFema: Und ich dachte, sie würde mich vor Besuchern schützen. Die FEMA-Leute tragen sie doch auch aus einem bestimmten Grund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609413
    m_Localized: 'FormerFema: Ich lüge nicht. Ich bin nur durch den Stress durcheinander, ist doch ganz normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609414
    m_Localized: 'FormerFema: Glaub mir, wenn du gesehen hättest, was ich gesehen habe, würdest du mich verstehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609415
    m_Localized: 'FormerFema: Auf dem Weg hierher bin ich vor Schreck fast gestorben, weil die Leichen auf dem Boden immer weiter zuckten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609416
    m_Localized: 'FormerFema: Hoffentlich habe ich mich nicht zu sehr der Sonne ausgesetzt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609417
    m_Localized: Hältst du es nicht für eine schlechte Idee, einen FEMA-Anzug zu tragen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609418
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609419
    m_Localized: 'FormerFema: Was? Hm ... nein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609420
    m_Localized: 'FormerFema: Ich meine, klar, manche Leute mögen die FEMA nicht, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609421
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609422
    m_Localized: 'FormerFema: Oh, du meinst, ich könnte Ärger mit der FEMA bekommen, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609423
    m_Localized: 'FormerFema: Hör mal, ich ... ich denke, wenn ich einfach alles erkläre, werden sie mir glauben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609424
    m_Localized: 'FormerFema: Man muss sie nicht verteufeln. Es ist ja nicht so, als wären sie eine Geheimgesellschaft.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609425
    m_Localized: 'FormerFema: Hoffentlich habe ich mich nicht zu sehr der Sonne ausgesetzt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609426
    m_Localized: Zeig mal, was du in deinen Taschen hast
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609427
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609428
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609429
    m_Localized: 'FormerFema: Hey, warum willst du mich durchsuchen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609430
    m_Localized: Ich suche deinen FEMA-Ausweis
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609431
    m_Localized: Hast du etwa was zu verbergen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609432
    m_Localized: 'FormerFema: Was? Welchen Ausweis?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609433
    m_Localized: 'FormerFema: Ich schwöre, ich habe nichts ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609434
    m_Localized: Mach es uns einfach und leere deine Taschen aus
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609435
    m_Localized: (Waffe ziehen)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609436
    m_Localized: 'FormerFema: Wer? Ich?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609437
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609438
    m_Localized: 'FormerFema: Nein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609439
    m_Localized: Mach es uns einfach und leere deine Taschen aus
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609440
    m_Localized: (Waffe ziehen)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609441
    m_Localized: 'FormerFema: Okay, okay. Kein Grund, so grob zu werden ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609442
    m_Localized: 'FormerFema: Hier. Zufrieden?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609443
    m_Localized: 'FormerFema: Na gut, du hast mich erwischt. Ich bin tatsächlich bei der FEMA ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609444
    m_Localized: 'FormerFema: Aber bitte sag es den anderen nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609445
    m_Localized: 'FormerFema: Oh, verdammt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609446
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609447
    m_Localized: 'FormerFema: Hier. Aber nicht schießen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609448
    m_Localized: 'FormerFema: Ja ... Ich bin tatsächlich bei der FEMA ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609449
    m_Localized: 'FormerFema: Aber es ist besser, wenn das niemand erfährt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609450
    m_Localized: 'FormerFema: Hoffentlich habe ich mich nicht zu sehr der Sonne ausgesetzt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609451
    m_Localized: Warum hast du verheimlicht, dass du bei der FEMA warst?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609452
    m_Localized: Ich muss dich testen
    m_Metadata:
      m_Items: []
  - m_Id: 53577620711792640
    m_Localized: 'Player: (Sieht so aus, als wäre das Gespräch beendet)'
    m_Metadata:
      m_Items: []
