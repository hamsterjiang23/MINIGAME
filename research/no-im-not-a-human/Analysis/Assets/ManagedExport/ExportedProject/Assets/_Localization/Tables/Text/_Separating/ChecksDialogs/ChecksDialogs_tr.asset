%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_tr
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: 9ca4ee10b5b962b4993a5133922046c2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377515769856
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: Al, bak... (öksürür)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: 'Firefighter: İki yanık kütük, beşer yanık dal... Tırnaklarım temiz ama. Enteresan değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: Peki.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: 'Firefighter: Gördün mü? (öksürür) Yanan kömür gibi kıpkırmızı. Hepsi dumandan işte birader.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: 'Firefighter: Emin misin? Pek hoşuna gitmeyebilir...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: 'Firefighter: Derim o kadar kuru ki ağaç kabuğu gibi çatlıyor. Zorunlu kalmadıkça kolumu kaldırmıyorum. Çok canım yanıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: 'Firefighter: Peki, öyle olsun. Anca yanmış bir ceset görürsün. Bu işler böyle...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: Ee, nasıl çıktım? (öksürür)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: 'Firefighter: Test edecek pek bir şey yok. Kıkırdağına kadar yandı.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: 'Firefighter: Yakında sağır olurum muhtemelen. Belki daha iyi olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: 'Firefighter: Vuracaksan vur birader. Dişlerimi hedef alma da. Zaten çürüdü çürüyecek hepsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: 'Firefighter: Aman, neyse. Artık hiçbir şeyden korkmam. İşini kolaylaştıracaksa vur gitsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: İyi düşündün. Merhamet etmiş olacaksın şu noktada...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: 'Firefighter: Bu eller neler gördü, farkında mısın sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: 'Firefighter: Bu fotoğraf yüzünden öleceksem (öksürür) öyle olsun. Zaten şu saatten sonra yaşamak istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: 'Firefighter: Her şey eninde sonunda kül olur. Sırada ben varım herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: 'Firefighter: Çocuklarımı (öksürür) bir türlü dişlerini fırçalamaya ikna edemezdim. Şimdi onları ikna edecek biri de kalmadı...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: 'Firefighter: Ben eskiden (öksürür) bu ellerle hayat kurtarırdım. Şimdi fincan bile tutamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: Demek ömrümün bedeli buymuş...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: Demek burada ölecekmişim...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: 'Firefighter: Hiç orman yangını gördün mü? (öksürür) Öylece yıkılıveriyor. Elinden hiçbir şey gelmediğini hemen anlıyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: 'Firefighter: Bazen geceleri uyanıyorum, derim paramparça. Ne yapsam acım dinmiyor. (öksürür) Alevler neyim varsa aldı götürdü.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: 'Firefighter: Sadece hatıralar kaldı. Bedenlerimizin de yanıp gitmesi an meselesi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: 'Firefighter: Etrafın yanıp tutuşurken bu sessizliği, bu huzuru yâd edersin. Ruhunda boşluk kalır.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: 'Wheelchair: Hadi bakalım, en zor soruları sor. Yüz almazsam şerefsizim!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: Al bakalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: Hiç böyle diş gördün mü? Ağzımda hazine saklıyorum sanki!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: 'Wheelchair: Diş bile değil, hepsi altın! Yani, hepsi değil de bi'' ara hepsi olur herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: 'Wheelchair: Ön dişlerinle bira açmak çok kolay, bunu biliyor muydun?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: Açacağa ne gerek var!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: 'Wheelchair: Hâlâ elim olduğu için minnettarım açıkçası.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: 'Wheelchair: Olmasaydı yarışamazdım!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: Bir saniye.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: Parmaklarım yok!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: 'Wheelchair: Dün bir tanesi eksikti sadece. Diğerleri nereye kayboldu?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: 'Wheelchair: Neyse, kökü bende. Biraz bekleyeceğiz sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: Parmağım yok...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: 'Wheelchair: Çok sıkıntı değil ama olsa daha iyi olurdu yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: 'Wheelchair: TIRNAĞIM BİRAZ UZADI AMA, GÖRÜYOR MUSUN?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: 'Wheelchair: Demek ki bacaklarım da geri uzayacak! Biraz beklememiz gerekecek sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: 'Wheelchair: Nereye bakayım? Sana mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: 'Wheelchair: Seğirdiğine bakma, alışkanlık.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: 'Wheelchair: Gerçek yarışlara katıldığım günlerde bile gözlerim asla yerinde durmazdı.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: 'Wheelchair: Herhâlde hız bağımlısıyım desene!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: Ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: 'Wheelchair: İyi, peki... HAHAHA, tamam ya! Çok iyiymiş bu!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: İşte şimdi mizahın dibine vurdun be dostum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: 'Wheelchair: Birbirimizin koltuk altına bakar hâle geldik. Manyaklığa bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: 'Wheelchair: Dünyayı cehennem ateşi sarmış. Sanırsın evren tüm gücüyle bizi yok etmeye çalışıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: O da yetmezmiş gibi Ziyaretçiler soyumuzu sopumuzu kurutma peşinde.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: 'Wheelchair: Sen gelmiş diyorsun ki "Koltuk altını göster!"'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: HAHAHAHA!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: Fotoğrafımı mı çekmek istiyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: 'Wheelchair: Pek hoşuma gitmiyor ama peki, öyle olsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: Off, galiba gözüm kapalı çıktı.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: 'Wheelchair: HAHAHAHA! Emriniz olur patron!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: Demek sen de o yayını dinledin...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: 'Wheelchair: Harikaydı, değil mi? Hı?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: Dinlemedin mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: Yok artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: 'Wheelchair: Peki, tamam. Biralarını içmeyeceğim artık. Bu kadar da büyütmeye gerek yok!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: Böyle ota boka sinirlenen, hemen küplere binenlere ne olur bilir misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: Başka şeylere de bindirirler. Sonra benim gibi tekerlekli sandalyeye oturturlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: 'Wheelchair: Madem bu kadar sinirleneceksin, buyur benimkine otur. Hem alışmış olursun.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: Niye ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: Bu benim işime yaramaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: 'Wheelchair: Muhtemelen senin de işine yaramaz. Ee, ne iş?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: 'Wheelchair: Çıplak gözümle mermiyi takip edemem ama kaçmaya çalışabilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: 'Wheelchair: Millet niye kıllarını alıyor, hiç anlamıyorum. Kıl, bedenin doğal zırhıdır.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: 'Wheelchair: Bu kızarıklığı görüyor musun? Orada parmak uzatıyorum. Yedek olsun diye.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: 'Wheelchair: Dur dur, daha çok güleceğiz. Yolumuz uzun!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: 'Wheelchair: Nerede yanlış yaptık biz?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: 'Wheelchair: Bu fotoğraflar kimin umurunda ki? Hayat bu tarz şeyler için çok kısa kanka!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: 'Wheelchair: Yani, demek istediğim...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: Dinle bak. Bırak gideyim, olur mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: 'Wheelchair: Hepimiz eninde sonunda layığımızı buluyoruz demek.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: 'Wheelchair: Takdiriilahiden kaçış yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: Beni asla canlı yakalayamazsın, asla! AAAAAAAAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: 'Wheelchair: Et keseleri olarak bu biyolojimizin bir parçası, öyle değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: 'Wheelchair: Bir gün birlikte kahkaha atıyoruz, başka bir gün birbirimizin kafasına sıkıyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: Son yolculuğuma hazırlanmam gerek.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: Artık tek arabam, ellerim...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: Debriyajım da yok!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: 'Wheelchair: Açıkçası bir gün bunları da kaybedeceğimi düşününce çok korkuyorum. O zaman ne halt yiyeceğim?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: 'Wheelchair: Hiçbir yere gidememe düşüncesi beni çok korkutuyor. Sonsuza dek aynı yerde kalmak...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: Ölüm bile beni bu kadar korkutmuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: 'Wheelchair: Ne yaparsan yap bir gün geliyor, artık ona yetişemiyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: 'Wheelchair: Yaşlandıkça zamanın daha hızlı aktığını fark ettin mi hiç?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: 'Wheelchair: Çocukken sonsuza dek yaşayacakmışız gibiydi. Her şey çok basitti. Ne sorumluluğumuz vardı ne de vereceğimiz bir karar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: 'Wheelchair: Şimdi ne kadar acele edersek edelim bir türlü yetişemiyoruz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: 'Wheelchair: Niyeyse birden bütün gülme arzumu yitirdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: Yok bu saçma sapan testler, yok yangınlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: 'Wheelchair: Herkes dünyayı kurtarmak istiyor ama bir tür hemfikir olamıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: 'Wheelchair: Ne anlamı var ki? Aslında biraz sakin olup salsak her şey geçecek sanki.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: Bak...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: Bu gezegende daha fazla vaktimiz kaldığını mı düşünüyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: 'Wheelchair: Yolun sonuna geldik. Yakında hepimiz ineceğiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: Son durağa yaklaştık! Pencereden görülüyor hatta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: Peki sen buna hazır mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: 'Wheelchair: Düşünüyordum da... kızmayacağına söz ver önce.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: 'Wheelchair: Sen bu belirtilere güvenemiyorsan ben ne yapacağım?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: 'Wheelchair: Kim bilir? Belki hepsi Ziyaretçi belirtisidir, belki hiçbiri değildir!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: 'Wheelchair: Hepimiz insanız sonuçta, hata yaparız.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: 'Wheelchair: Fakat bazen hataların sonucu büyüktür.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: 'Wheelchair: Şimdi sen bu belirtiye güveneceksen ben öncekilere nasıl güveneceğim?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: 'Wheelchair: Belki diğerleri de kolpadır.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: 'Wheelchair: Hepimiz insanız. Hepimiz hata yaparız.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: 'Wheelchair: Fakat bazen hataların sonucu büyük olabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: 'Wheelchair: Mesela sen... yanlışlıkla o tetiği bir çeksen... BUM. Bedelini başkası öder.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: 'Wheelchair: Verdiğin karara gerçekten güveniyorsan... öz güvenine imrendim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: 'Mother: İyi, buyur. Beni test et. Benim saklayacak bir şeyim yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: Buyur, bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: 'Mother: Dişlerime zaten çok bakmazdım. Vaktim pek olmazdı. Pişman oldum şimdi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: Buyur, bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: 'Mother: El değil, kürek bildiğin. Her şey evlatlarım için...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: Bak bakalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: 'Mother: Altı nasıl şişik, görüyor musun? Gözüne uyku girmeyince böyle oluyor işte...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: Bak bakalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: 'Mother: Oturabilir miyim peki? Olmaz mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: 'Mother: Bir süredir temizlemiyorum. Tıkandıysa hiç şaşırmam.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: 'Mother: Çocukların bağırmalarını dinlemekten sağır oldum zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: 'Mother: Dişlerimi fırçalarken diş etlerim kanamaya başladı. Geçen haftadan beri böyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: 'Mother: Hâlâ sapsarılar bir de. Çoluk çocuk yüzünden sigara tiryakisi olduk.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: 'Mother: Bu deterjanlar falan bana kızarıklık yapıyor. Hiç doktora gitme fırsatım da olmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: 'Mother: Ben bu ellerle ne yemekler yapardım, bir bilsen! Tabii, senin ellerin hemen silahına gidiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: 'Mother: Hah. Beni bombayla patlatsan bile kalıntılarım dinlenemez muhtemelen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: 'Mother: Kötü kokuyorum diye vuracak mısın beni? Saçmalık...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: 'Mother: Hadi ama. O kadar kötü mü çıktım yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: 'Mother: Sırf kulaklarım yüzümden beni vuracaksan kafayı yemişsin. Neyimi beğenmedin ki? İyi, bundan sonra şapka takarım!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: Sonunda huzur bulacağım... Artık kimse başımın etini yiyemeyecek...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: Çok üzücü çok...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: 'Mother: Benim çocuklardan birinin dişleri kusursuzdur ama bir kere bile güldüğünü görmedim. Herhâlde sıkıntı, diş değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: 'Mother: Bu ellerle çocuklarıma sarıldım, ev işlerini hallettim, kocamı sevdim. Kimse de değerimi bilmedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: 'Anger: Ciddi misin sen? Hay... İyi hadi, çabuk hallet.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: 'Anger: Sikimde değil. Al bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: 'Anger: Sarıysa sarı, n''apayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: 'Anger: Beyaz işte, ne olmuş? Hiç hijyenden de mi anlamıyorsun sikik?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: 'Anger: Madem dişlerimin anası ağlayacak, bari bir tanesi altın olsun istedim. Filmlerdeki o elemanlar gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: İyi, peki.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: 'Anger: Hoşuna gidecekler mi bak bakalım!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: 'Anger: Hah. Ninem hep bu ellerle ağaç kesmemi söylerdi. Yaptığım işe yakışmadığını söylerdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: 'Anger: Etrafta ağaç göremiyorum. Sinirimi bir şekilde atmam lazım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: 'Anger: İyi, çok meraklıysan bak madem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: 'Anger: Çok mu beğendin maviş gözlerimi? Hatunları sırf gözümle düşürürdüm zamanında!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: Çok da sikimde.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: Kıllarımı alıyorum, evet.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: 'Anger: Çok rahatsız oluyorum almayınca. Kolumun altında çalıyla geziyorum gibi geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: Ne oldu lan?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: 'Anger: Ne bakıyorsun öyle? Ne gördün?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: Hay sikeyim...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: 'Anger: Ne bön bön bakıyorsun? Bir eksik mi var?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: 'Anger: Kafayı mı yedin lan mal? Dişlerimi gösterdim sadece!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: 'Anger: Sen o tetiği çekene kadar ben ağzını yüzünü dağıtırım, gör bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: 'Anger: Mal mısın lan sen? Ne oldu, kıskandın mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: 'Anger: Ha bire kaşınıyor. Benimle bir derdi var sanırsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: 'Anger: Bazen kanayana kadar kaşıyorum ama iyi geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: 'Anger: Ha siktir lan oradan! Sen kafayı yemişsin!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: 'Anger: Siktiğimin fotoğrafı yüzünden mi beni vuracaksın?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: 'Anger: O emaneti oyuncak gibi sağa sola sallama.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: 'Anger: Kim bilir, belki sırf kulaklarımı beğenmedin diye beni yanlışlıkla vurursun.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: 'Anger: Sende kafa mafa kalmamış lan, duydun mu beni? İyi, öyle olsun. Vur ulan!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: 'Anger: Piç kurusu seni. Yüreksizsin sen, yüreksiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: Siktir ol git lan.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: 'Anger: Nenemin de altın dişi vardı. Küçüklükten beri benim de olsun isterdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: 'Anger: Ağzını açtığında güneş gibi parlardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: 'Anger: Eskisi çürüyünce onu takmışlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: 'Anger: Vakti gelince bana da takarlar diye sevinmiştim zamanında.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: 'Anger: Vakti geldi. Fakat kimse bana bir şey takmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: 'Anger: Şimdi ağzımın parladığı da yok. Sidik gibi sapsarı, kokuyor bir de.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: 'Anger: Bu elleri gördün mü, bu elleri? Ha kirli ha kanlı. Sonuçta benim ellerim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: 'Anger: Bazen o kadar kaşınıyor ki derimi soyasım geliyor. Ne bileyim, bir duvara vurasım... İkisi aynı anda bile olabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: 'Anger: Kimseye zarar vermek istemiyorum ama elimden gelmiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: 'Anger: Bu tırnakları gördün mü, bu tırnakları? Ha kirli ha kanlı. Sonuçta benim tırnaklarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: 'Anger: Bazen o kadar kaşınıyor ki derimi soyasım geliyor. Ne bileyim, bir duvara vurasım... İkisi aynı anda bile olabilir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: 'Anger: Başkası olsaydım kendimden korkardım açıkçası ama pek sikimde de değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: 'Anger: Ninem bana "meleğim" derdi hep küçükken. Gözlerimden dolayı... "Melek"miş... İnanılır gibi değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: 'Anger: Şimdi burada durup o ruhsuz gözlerime bakıyorum ve düşünüyorum... Nerem melek lan benim?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: 'Anger: Şimdi beni görse büyük hayal kırıklığına uğrardı...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: 'Anger: Aslında usturalar epey keskin oluyor, işimi görürler ama... o kadar kolay değil işte...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: 'Anger: Kolumu kesiverdim. Şimdi tıraş olurken sanki kıllarımı değil de kendimden bir parça kesiyormuş gibi hissediyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: 'Anger: Yine de kesiyorum ama işte. Nefret ediyorum çünkü kıllarımdan.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: 'Anger: Ninemin fotoğrafı bile yok bende. Hiç sevmezdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: 'Anger: "Fotoğrafını çektirdiğin zaman ruhun sonsuza dek o fotoğrafta hapsolur," derdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: 'Anger: Katıla katıla gülerdim buna. "Sen de iyice abarttın nine," derdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: 'Anger: "Ben öldüğümde fotoğrafıma bakıp ''Acaba cennette mi?'' diye düşüneceksin," derdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: 'Anger: Sikerler. Ne fotoğrafım kaldı ne ninem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: 'Anger: Bazen kulak memem çok kötü kaşınıyor, ben de iyice çekiştiriyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: 'Anger: Kaygıdan yaptığımı sanıyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: 'Anger: Sonra fark ettim ki koparmak istiyormuşum. Bana engel oluyormuş gibi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: 'Anger: Tabii, kendimi parçalayacak kadar kafayı yemedim herhâlde. Değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: DEĞİL Mİ LAN?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: 'FortuneTeller: Enerjinin bana karşı koyacağını tahmin etmiştim tatlım. Yine de buyur, testlerini yap. Ben senin ciğerini bilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: Bak bakalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: 'FortuneTeller: İçimizdeki kozmos gözümüzden yansır, dişimizden değil. Kendi kaderini mi görmek istiyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: 'FortuneTeller: İçimizdeki kozmos gözümüzden yansır, dişimizden değil. Burada ne bulmayı umuyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: Buyur, bak bakalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: 'FortuneTeller: Fakat dikkatli ol, düş kapanı yaparken kendimi yaraladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: 'FortuneTeller: Gözlerim mi? Kahverengi işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: 'FortuneTeller: Kızıllıklara bakmazsan yani. Onlar Ay''ın suçu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: 'FortuneTeller: Ah ah, evren önüme neler çıkarıyor neler... Buyur, bak bakalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: 'FortuneTeller: Bu şartlar altında insan kendine bakamıyor maalesef...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: 'FortuneTeller: Dikkat et, auram seni kör edebilir!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: 'FortuneTeller: Ee, nasıl?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: 'FortuneTeller: Bak bakalım ama dikkatli ol. Benim kulaklarım her şeyi duyar. Senin düşüncelerini bile.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: 'FortuneTeller: Ee? Bir cevap bulabildin mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: 'FortuneTeller: Dişlerim yüzünden mi beni vuracaksın? Bunun benden olmadığını hissetmişsindir elbet... Mars ve Venüs kavga ediyor olmalı!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: 'FortuneTeller: Ciddi olamazsın. Elimde kıymık var diye mi beni vuracaksın? Bir de çok değer verdiğim o kapanlardan olmalarına rağmen!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: 'FortuneTeller: Delirdin mi sen? Ay seni kandırıyor, bunun farkında mısın? Onun hareketlerini takip etmek kolay iş değil!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: 'FortuneTeller: Delirdin mi sen? Ay seni kandırıyor, bunun farkında mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: 'FortuneTeller: Bu astroloji değil, bu bildiğin vahşilik! Silahı indirirsen sana daha fazla sır anlatırım! Hem de ücretsiz!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: 'FortuneTeller: Dur ama! Buna hazır olmaman benim suçum değil ki tatlım!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: 'FortuneTeller: O şeyi indirir misin? Kulağıma bakarak ne anlayacaksın ki? Bilge sözleri dinlemek için kulaklara ihtiyacı var herkesin!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: 'FortuneTeller: Beni öldürürsen seni...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: ...ebedî ishalle lanetlerim!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: 'FortuneTeller: Bir keresinde karşıma dişleri kusursuz olan bir adam çıkmıştı.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: 'FortuneTeller: Dedim ki "İyisin, hoşsun ama ruhun çürümüş!" Önemli olana odaklanmaya çalış. Demek istediğimi anladın, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: 'FortuneTeller: Bir ayin sonrası, sabaha kadar kıymıkları çıkarmaya uğraşmıştım. Çok canım yansa da her biri evrenden bana bir dersti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: 'FortuneTeller: Gözler, başka bir dünyaya açılan geçitlerdir. Bir adam görmüştüm, gözleri alev alevdi. Aşktan olduğunu sanıyordu ama o, Mars''tı.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: 'FortuneTeller: Bir keresinde üç hafta inzivaya çekilmiştim. Tek düşündüğüm, rüyalarımdı...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: 'FortuneTeller: Düşünceler, zuhurdur. Rüyalar bu şekilde gerçek olur. Tek yapmam gereken, doğru kararı vermekti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: Niyeyse tam olarak şu an bu aklıma geldi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: 'FortuneTeller: Bir keresinde fotoğrafımı çektirdim ve yıldızlar bana mesaj gönderiyor sandım ama meğerse flaştanmış.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: 'FortuneTeller: Bir keresinde bir ses duydum, evren âdeta benimle konuşmaya çalışıyordu... ama sanırım bunun da ötesinde bir şeydi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: 'FortuneTeller: Bir keresinde bir ses duydum, evren âdeta benimle konuşmaya çalışıyordu... Meğerse esintiymiş. Yine de hoştu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: Neyime bakacaksın ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: 'Anxiety: N... Ne? Dişlerime bakıp mı karar vereceksin? P... Peki...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: Dişlerimi daha yeni yaptırdım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: Gerçi, açıkçası...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: 'Anxiety: Dişçiye gittiğimi hiç hatırlamıyorum. Acaba gitmedim mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: 'Anxiety: O kadar gerginim ki dün ne yediğimi unuttum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: 'Anxiety: T... Tırnaklarıma mı bakacaksın? Garip...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: 'Anxiety: Peki, bak...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: 'Anxiety: Ne oldu? Toprak mı var? Yok artık...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: 'Anxiety: Toprağı kazdığımı... hiç hatırlamıyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: Bunlar nasıl tırnağımın altına kaçtı ya?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: Gözlerime mi bakacaksın?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: Ölmekten korkuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: (Kızın fotoğrafını çekiyorsun.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: Niye ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: Beni vurup kurtulman daha kolay olmaz mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: 'Anxiety: Ben insan mıyım? İnsan mıyım ben? Bana insansın de, lütfen! Yalvarırım!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: 'Anxiety: Hahaha! Zaten silahı çekecektiysen niye sordun ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: İnsanları aşağılamaktan zevk mi alıyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: Neyi test edeceksin?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: Dişlerimi mi görmek istiyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: 'Esenin: İyi, bak bakalım. Hüzün ve sigara kokusunu iyice içine çek.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: Sapsarı, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: Hadi, şu testlerini de al git.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: Ziyaretçi falan değilim ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: Nereden geldi ki bunlar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: 'Esenin: Tırnağın altında toprak nasıl bir belirti?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: Ellerini yıkarlarsa ne bok yiyeceğiz?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: 'Esenin: Bahçıvanlar otomatik olarak Ziyaretçi mi sayılıyor yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: Saçmalık.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: Tırnaklarıma bak madem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: 'Esenin: Ee? Ziyaretçi miymişim?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: Ben de öyle düşünmüştüm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: Millet iyice kafayı yemeye başladı.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: 'Esenin: Ya uykusuzsam? Ya ağladıysam?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: 'Esenin: Hiçbir şeyin anlamı kalmadı artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: 'Esenin: Ya Ziyaretçi olduğumu gösteren bir belirti bulursan? Ya birkaç tane bulursan?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: 'Esenin: Bu gece Ziyaretçi olacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: 'Esenin: Güzel günleri yâd edip ağlayacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: 'Esenin: Yok belirti testi, yok sarılı adamlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: Artık...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: ...bıktım usandım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: 'Esenin: Sen de sonumuzun çok kötü olacağını düşünüyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: 'Esenin: Sözde her şey kontrol altında ama kan gövdeyi götürüyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: Çek şu fotoğrafını.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: (Adamın fotoğrafını çekiyorsun.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: 'Esenin: (Sakin sakin oturuyor. Kareye tam sığmasa da bir sıkıntı yok gibi.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: 'Esenin: Gelecekte olacaklardan çok korkuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: 'Esenin: Mal mısın lan sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: FEMA iyice beynini yıkadı herhâlde!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: 'Esenin: Yoksa zom mu oldun? Sağlam mallar bitti sanmıştım...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: 'Esenin: Madem sordun, buyur göstereyim!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: İstediğini elde ettin mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: İyice içine çekseydin!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: 'Esenin: Neyse, sağ olasın. En azından götümü test etmeye kalkışmadın!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: Acele et bari.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: Ne?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: 'Widow: Yani... Peki.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: Bitti mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: Biraz dinlenebilir miyim artık?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: 'Widow: Ellerime mi? Bir saniye...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: 'Widow: Kurtarmayı reddettikleri kocamı taşımaktan paramparça oldular.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: 'Widow: Beni bir salar mısın artık?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: 'Widow: Madem bu kadar vurmak istiyorsun beni, vur gitsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: Takatim kalmadı zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: 'Widow: Ne arıyorsun ki? Kızarıklık mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: İlla bakacaksan...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: 'Widow: Yani herhangi bir duygu emaresi gösterirsem Ziyaretçi mi oluyorum?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: Dürüst olabilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: Tabii. Vur gitsin, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: 'Widow: Artık ağlamak bile suç herhâlde! Gülmek zaten imkânsız.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: Delirdin mi sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: 'Widow: Yalvarırım cevap ver, SEN KAFAYI MI YEDİN?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: 'Widow: O şerefsizler sana uçurumdan aşağı atla deseler atlayacak mısın?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: 'Widow: Sen... Kafanı... Söyleyecek bir şey bulamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: 'Widow: Ee? Silahını da çek bari.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: Hay...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: 'Widow: Sık gitsin. FEMA ruhumu öldürdü zaten. Kalanını da sen öldür.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: Neyi test edeceksin?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: Kafayı mı yedin lan sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: 'Scammer: Göt herif...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: 'Scammer: Ne yapıyorsun oğlum sen? Herhangi bir adamım ben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: 'Scammer: Normal tırnak lan, görmüyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: Neyi test edeceksin?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: 'Daughter: Dişlerimi mi? Dişlerimi mi görmek istiyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: 'Daughter: Niye ki? Daha hepsi çıkmadı ama. Babam dedi ki...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: Artık ağlamayacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: İşte dişlerim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: Bu ne demek oluyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: Bir şey mi oldu?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: Ben kendi tırnaklarımı kesmeyi öğrendim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: Çok iyi kesemiyorum ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: Bak. Bak!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: Çok güzel, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: 'Daughter: Hepsini kendim kestim. Kendi başıma yaptım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: 'Daughter: Ben gidiyorum. Yalnız olmak istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: Gözlerime mi bakacaksın?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: 'Daughter: Düşündüklerimi görebilecek misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: 'Daughter: Öyleyse iyice düşünürüm, merak etme.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: 'Daughter: B... Ben i... içecek i... istiyorummm...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: Peki... Ne yapacağım tam olarak?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: 'Daughter: (Küçük kıza bakıyorsun ve abarttığını fark ediyorsun.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: Beni mi merak ettin?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: 'Daughter: Yorgunum. Şimdi oyun oynamaya gidebilir miyim?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: Fotoğraf mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: Benim çok fotoğrafım yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: Sonra bana gösterir misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: (Küçük kızın fotoğrafını çekiyorsun.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: (Fotoğraf biraz bulanık duruyor.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: 'Daughter: (Sen daha fotoğrafı çekemeden koşup yanına gelmiş.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: Hım...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: ...Teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: 'Daughter: Beğenmedim. Bir daha çekilmek istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: 'NotTrue: İyi madem evladım, bak bakalım. Daha önce görmediğin bir şey göremezsin zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: Dişlerime mi bakacaksın?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NotTrue: Aaaaaahhh ahhh...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: 'NotTrue: Bu dişler var ya bu dişler... Eskiden hiç sevmezdim. Hepsini koparmak isterdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: 'NotTrue: Baksana parmaklarıma. Sayı sayamıyorum, bir şeyi tutamıyorum, bir şeyi ölçemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: 'NotTrue: Bir şekilde yetiniyoruz işte, ne yapalım?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: 'NotTrue: Emin misin evladım?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: 'NotTrue: Gözler, pencere gibidir; evin ışığı nasıl pencereden dışarı sızıyorsa insanların hakikati de gözünden sızar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: 'NotTrue: Benimkiler tozlandı gitti... Camları çatladı... Perdelerini güveler yedi bitirdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: 'NotTrue: Sen en iyisi hiç bakma delikanlı. Görecek bir şey yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: 'NotTrue: Ohoo! Yaşlı kadına denir mi bu? Hiç utanmıyorsun bir de!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: 'NotTrue: Neyse, ne yapayım? Bu güzelim evin sahibi sensin sonuçta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: Ee delikanlı?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: 'NotTrue: Çek çekmesine de ihtiyar kadının teki için niye film harcıyorsun ki? Belli ki az kalmış... ama ısrar ediyorsan benden günah gitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: Nasıl çıktım evladım?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: 'NotTrue: Peh, amma tuhaf bir istek evladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: 'NotTrue: Normal kulak işte. Hâlâ duyabiliyorum ama bazen solup gidiyorum gibi geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: 'NotTrue: Sadece güneş ışığında görülür hâle gelir gibiyim, ki o dahi muamma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: 'NotTrue: Şimdi sen o şeyi niye bana doğrulttun ki evladım?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: 'NotTrue: Zaten yaşlıyım, böyle yaparsan kalpten giderim ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: 'NotTrue: Beni korkuttuğunu mu sanıyorsun evladım? Bu pörsümüş elleri kaybetmekten ne korkayım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: 'NotTrue: Boşluğu onca defa tutmaya çalıştım, artık parmaklarım da tutunacak bir şey kalmadığını biliyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: Demek ömrümün bedeli buymuş...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: 'NotTrue: Bana inanmıyor musun? Kontrol etmek mi istiyorsun? İyi madem, bak bakalım...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: 'NotTrue: Eskiden ben de insanların gözüne bakardım. O günler aklıma geldi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: 'NotTrue: Yaşlılık böyle bir şey işte evladım. Şu yaşa kadar gelen herkese böyle bir armağan verirler, bilmiyor muydun?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: 'NotTrue: Mantar acı hissetmez. Senden yemek istemez. Öylece var olur. Yaşamak için yaşar. Pehehe, tıpkı benim gibi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: 'NotTrue: Aman... Bu yüzden mi tepen attı yoksa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: 'NotTrue: O da ne evladım? Kulağımdan ne anladın ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: 'NotTrue: Peh... Bana fark eylemez. Niye eylesin ki evladım? Zaten bir süredir ölmeyi bekliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: İşte...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: 'NotTrue: Bir hekime parasını verip hemen hallettirecektim de hepsini birden aynı anda yapamadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: 'NotTrue: Yani giderdim, birer ikişer çekerdi ama... hepsini halledemedi işte. Hekimlerin vakti kalmadı artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: 'NotTrue: Böylece kaldım işte delikanlı. Ağzım da yarım kalmış oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: 'NotTrue: El dediğin tutulur. O zevki ben uzun yıllardır yaşamıyorum evladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: 'NotTrue: Ellerimi mi uzatayım? Sen uzanamıyor musun delikanlı?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: 'NotTrue: Gir bakalım, altı parmaklı yalanların kulübesine... Bak bakalım, daracık parmaklıklı kafese...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: 'NotTrue: Bu kaderden kaçabileceğini mi sanıyorsun? Genç yaşta ölürsen anca. Sakın öyle bir işe kalkışayım deme ama ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: 'NotTrue: Yakışıklı bir delikanlısın, yazık olur!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: 'NotTrue: Bizim zamanımızda sadece zenginlerin böyle oyuncakları vardı. Şimdi belediye dağıtıyor herhâlde!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: 'NotTrue: Neyse, daha fazla söylenmeyeyim... Boş yere güzel insanların kafasını şişiriyorum. Peh!'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733828
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733829
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733830
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733831
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733832
    m_Localized: 'Mother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733836
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733837
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733838
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733839
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733840
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752330928128
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752335122433
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752335122434
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752335122435
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341250
    m_Localized: 'Theorist: Pekâlâ ama haberin olsun, beni test ederek öğrenmek istemediğin şeyler de öğrenebilirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341251
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341252
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341253
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341254
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341255
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341256
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341257
    m_Localized: 'Theorist: Buyur.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341258
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341259
    m_Localized: 'Theorist: Kalem kemirmek gibi bir kötü alışkanlığım var maalesef.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341260
    m_Localized: 'Theorist: Dişlerimi çatlatıyor, kanatıyor... Evet, farkındayım ama alışkanlık işte...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341261
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341262
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341263
    m_Localized: 'Theorist: Peki.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341264
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341265
    m_Localized: 'Theorist: Mürekkebi görüyor musun? Tırnaklarımı, derimi, gözeneklerimi lekeledi ama irfanın bedeli bu işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341266
    m_Localized: 'Theorist: Mürekkebi görüyor musun? Tırnaklarımı, derimi, gözeneklerimi lekeledi. Öğrendiğim bilgilerin izleri... Bedeli ağır oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341267
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341268
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341269
    m_Localized: 'Theorist: Gözlerim... Tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341270
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341271
    m_Localized: 'Theorist: Maviler. İyi, demek ki daha beni değiştirmemişler.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341272
    m_Localized: 'Theorist: Bilginin peşine düşersen gözlerini dört açman lazım. Bir an önce hepsini sindir ki gerçeği değiştiremesinler.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341273
    m_Localized: 'Theorist: Ben dünyayı olduğu gibi görüyorum. Ne bir filtre var ne bir sis. Peki ya sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341274
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341275
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341276
    m_Localized: 'Theorist: Koltuk altı mı? Enteresan.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341277
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341278
    m_Localized: 'Theorist: Bu kılları görüyor musun? Doğal koruma. Buharlaşmayı yavaşlatarak elektrolitleri vücudunda tutuyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341279
    m_Localized: 'Theorist: Kıllarını alanlar terlemenin onları kontrol etmesine izin veriyor ve savunmasız kalıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341280
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341281
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341282
    m_Localized: 'Theorist: Fotoğraf mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341283
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341284
    m_Localized: 'Theorist: Fotoğraflara güven olmaz. Değiştirilebilirler, manipüle edilebilirler, silinebilirler. Ancak bu an... Bu ana kimse dokunamaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341285
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341286
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341287
    m_Localized: 'Theorist: Kulağım mı? Anladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341288
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341289
    m_Localized: 'Theorist: Demek sen de tek hakiki yayını izledin, öyle değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341290
    m_Localized: 'Theorist: Belirti mi arıyorsun? Sıkıntı değil, korumam var.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341291
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341292
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341293
    m_Localized: 'Theorist: Hadi, vur. "Katkı maddelerine" dikkat et ama, yiyecekleri kullanarak sizi kontrol ediyorlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341294
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341295
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341296
    m_Localized: 'Theorist: Gerçeği arayanlardan mı korkuyorsun? O zaman korktuğun kişi ben değilim... Sensin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341297
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341298
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341299
    m_Localized: 'Theorist: Silahların da aslında bir kontrol aracı olduğunu fark etmişsindir herhâlde?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341300
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341301
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341302
    m_Localized: 'Theorist: Ellerimi mi kaldırayım? Acaba ellerini havaya kaldırmak neden her kültürde teslim olma anlamına geliyor? Buna kim karar verdi ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341303
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341304
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341305
    m_Localized: 'Theorist: Bu fotoğrafı silmek mi istiyorsun? Yoksa içindeki insanı mı? Bunu yapmaya seni kim teşvik ediyor, bir düşün.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341306
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341307
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341308
    m_Localized: 'Theorist: Beni vurup silahın yankısını dinleyerek çok şey öğrenebilirsin, evet ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341309
    m_Localized: 'Theorist: Bir Ziyaretçi''yi nişan alman daha mantıklı olabilir. Onların titreşimi farklı oluyor!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341310
    m_Localized: 'Theorist: Beni susturmak mı istiyorsun? Sence bu, işini kolaylaştıracak mı? Sessizlik de bizi kontrol etmek için kullandıkları bir araç.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341311
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341312
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341313
    m_Localized: 'Theorist: Bazı ülkelerde diş dolgusuna mikroskobik anten takıyorlar, bunu biliyor muydun? Araştırmanı öneririm.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341314
    m_Localized: 'Theorist: Mikroskobun altında çatlaklarda iz çıkıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341315
    m_Localized: 'Theorist: Ziyaretçi izi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341316
    m_Localized: 'Theorist: Bir keresinde biri bana "Gerçeği elinde tutanın elinden almaya çalışırlar," demişti. Yine de bırakmayacağım! Sonuna kadar tutacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341317
    m_Localized: 'Theorist: Yeterince uzun süre bakarsan gerçek de sana bakmaya başlar. Gözlerimde bunu görebiliyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341318
    m_Localized: 'Theorist: İnsanlar kötü kokmaktan korkuyor ama bu gayet doğal bir şey. Yapay kokuları da bizi kontrol etmek için kullanıyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341319
    m_Localized: 'Theorist: Dikkatimizi dağıtıyorlar. Gerçeği gizliyorlar. Her şey gerçeklik gibi kokmalı.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341320
    m_Localized: 'Theorist: Fotoğraflar, çapa gibidir. Bizi gerçekliğe bağlar; bizim burada, gerçek olduğumuzu kanıtlar. Bu yüzden çok tehlikeliler.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341321
    m_Localized: 'Theorist: Bizi ses kullanarak programlıyorlar. Frekanslar, infradalgalar... Hepsi zihni etkiliyor. Bu gürültüye aldırış etmemeliyiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341322
    m_Localized: 'Theorist: Ben gitsem bile...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341323
    m_Localized: 'Theorist: ...gerçek kalacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341399
    m_Localized: 'Raskolnikov: Ha, tabii. Beni test etmen lazım, anlıyorum. Hatta b-bence bu kadar temkinli olman güzel...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341400
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341401
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341402
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341403
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341404
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341405
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341406
    m_Localized: 'Raskolnikov: Dişim mi? Ha, tamam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341407
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341408
    m_Localized: 'Raskolnikov: Off... Yanlış anlama, ben "onlardan" biri değilim. Ne kadar iyi göründüğümü pek de umursamıyorum, ondan hani...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341409
    m_Localized: 'Raskolnikov: Off... Yanlış anlama, narsist falan değilim ben. Dış görünüşüme önem veriyorum, o kadar...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341410
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341411
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341412
    m_Localized: 'Raskolnikov: Ha... Yani, aynen. Ne gerekiyorsa onu yap. Buyur, bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341413
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341414
    m_Localized: 'Raskolnikov: Evet, pek de hoş değiller... Eskiden saklamaya çalışırdım ama artık bir manası kalmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341415
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341416
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341417
    m_Localized: 'Raskolnikov: Ellerimi hiç kirletecek vaktim bile olmadı, ondan böyle... Durmadan kaçıyorum veya saklanıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341418
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341419
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341420
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341421
    m_Localized: 'Raskolnikov: Korkmak yok ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341422
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341423
    m_Localized: 'Raskolnikov: Ağlamıyordum asla! Gözüme uyku girmedi, ondan...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341424
    m_Localized: 'Raskolnikov: Gözlerim normalde tir tir titrerdi ama artık yorulduğum için sabit duruyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341425
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341426
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341427
    m_Localized: 'Raskolnikov: Off... Buna gerek var mı gerçekten?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341428
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341429
    m_Localized: 'Raskolnikov: Gördün mü? Normal, değil mi? Çok terlemem zaten ben. Herhâlde korkak olduğum için bedenim kokusunu gizliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341430
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341431
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341432
    m_Localized: 'Raskolnikov: Niye fotoğrafımı istiyorsun ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341433
    m_Localized: 'Raskolnikov: Reddetme hakkım yok mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341434
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341435
    m_Localized: 'Raskolnikov: D... Dur ya, hemen ne silah çekiyorsun? Tamam, tamam, çek fotoğrafımı! Off...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341436
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341437
    m_Localized: 'Raskolnikov: Güzel çek ama, tamam mı? Rezil durmayayım en azından.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341438
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341439
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341440
    m_Localized: 'Raskolnikov: Ş-şey... Peki ama neden kulaklarım? Umarım korkunç bir şey falan beklemiyorsundur.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341441
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341442
    m_Localized: 'Raskolnikov: H-her şeyi duyuyorum... Duymamam gerekenleri bile.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341443
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341444
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341445
    m_Localized: 'Raskolnikov: Hoooff, aman... Bunu beklemiyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341446
    m_Localized: 'Raskolnikov: Belki de haklısındır... Bazen direkt vurmak gerekiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341447
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341448
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341449
    m_Localized: 'Raskolnikov: Bu eller t... tehlikeli mi sence? Bence zavallılar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341450
    m_Localized: 'Raskolnikov: Vur gitsin ya. Sık kafama. Zaten elimle tutacağım bir şey kalmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341451
    m_Localized: 'Raskolnikov: D... Dur! Ben...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341452
    m_Localized: 'Raskolnikov: ...Kusura bakma. Bu eller hiçbir işe yaramıyor zaten. Belki de bunu hak ediyorumdur...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341453
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341454
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341455
    m_Localized: 'Raskolnikov: Artık gözüme hiç uyku girmiyor. Belli oluyor, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341456
    m_Localized: 'Raskolnikov: Belki... bu konuda bana yardımcı olabilirsin?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341457
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341458
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341459
    m_Localized: 'Raskolnikov: Tehlikeli biri olmayabilirim...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341460
    m_Localized: 'Raskolnikov: ...ama herkes yüzüne silah doğrulttuğunda bu kadar sakin kalamaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341461
    m_Localized: 'Raskolnikov: Bir gün kocaman, kaba birine denk gelirsin. O gün sonun olur herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341462
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341463
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341464
    m_Localized: 'Raskolnikov: Of ya... O fotoğraftan bir şey anladıysan...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341465
    m_Localized: 'Raskolnikov: Tetiği ç... çek gitsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341466
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341467
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341468
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341469
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341470
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341471
    m_Localized: 'Raskolnikov: Okuldayken dişçilerden çok korkardım. Bildiğin titrerdim, terlerdim falan.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341472
    m_Localized: 'Raskolnikov: Sonra bir gün lavuğun teki beni yumruklayıp dişimi düşürdü. Ne yaptığımı tahmin et.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341473
    m_Localized: 'Raskolnikov: Hiçbir şey.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341474
    m_Localized: 'Raskolnikov: Hiçbir şey yapmadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341475
    m_Localized: 'Raskolnikov: Kendimi savunamadım. Tenezzül bile etmedim. Çok korkmuştum...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341476
    m_Localized: 'Raskolnikov: Madem güçlü olamıyorum, bari kusursuz olayım dedim. Anlatabildim mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341477
    m_Localized: 'Raskolnikov: Temiz dişler benim kalkanım gibi bir şey oldu. Onları hayatım pahasına korudum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341478
    m_Localized: 'Raskolnikov: Biliyorum, saçma. Keşke başka bir ders alsaydım...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341479
    m_Localized: 'Raskolnikov: Ne zaman donup kalsam veya bir fırsat kaçırsam... duvarlara vururdum. Sert vururdum hem de. Ellerim kanayana kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341480
    m_Localized: 'Raskolnikov: Sanki acı çekerek zayıflığımı düzeltebilecekmişim gibi... Kendimi cezalandırarak güçleneceğimi sanıyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341481
    m_Localized: 'Raskolnikov: Ancak elde ettiğim tek şey, tırnaklarımın altında toprak ve korkunç bir iltihap oldu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341482
    m_Localized: 'Raskolnikov: Ki bu adil yani. Benim de onlardan bir farkım yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341483
    m_Localized: 'Raskolnikov: Eskiden yumruğumu öyle bir sıkardım ki ellerim bembeyaz kesilirdi. Sinirimi kontrol edebilsem korkumdan kurtulurum sanırdım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341484
    m_Localized: 'Raskolnikov: Artık saklıyorum. Biri titrediğimi fark eder diye.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341485
    m_Localized: 'Raskolnikov: Ara sokaktaki o adamı gördüğümde... bana aynı şu an senin baktığın gibi bakmıştı. Ruhumu görüyordu sanki.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341486
    m_Localized: 'Raskolnikov: O an düşündüm ki... benim bakışlarım da böyle olsaydı belki okulda beni rahat bırakırlardı.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341487
    m_Localized: 'Raskolnikov: Belki kendimi savunabilirdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341488
    m_Localized: 'Raskolnikov: Of ya... Kusura bakma, şey...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341489
    m_Localized: 'Raskolnikov: Muhtemelen bunu dinlemek istemiyordun.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341490
    m_Localized: 'Raskolnikov: Hep sıradan biri olmanın hayalini kurardım. Kimsenin fark etmeyeceği biri. Kokmayan, dikkat çekmeyen...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341491
    m_Localized: 'Raskolnikov: Fakat şimdi anladım. Görünmez olanlar ilk kurbanlar oluyor. Bu yüzden... Bu yüzden başka biri olmak istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341492
    m_Localized: 'Raskolnikov: Off... Yüzünün bir yerde kaydedildiğini bilmek çok tuhaf. Ne? Aura mı? Kim olduğum oradan anlaşılıyor mu yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341493
    m_Localized: 'Raskolnikov: Söyle bana, hâlâ iyileşecek f... fırsatım var mı? Çoktan Ziyaretçi olmuş muyum? Yoksa sonsuza dek zayıf mı kalacağım?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341494
    m_Localized: 'Raskolnikov: Bir keresinde bir adam bana hepimizin "nainsan" olduğunu söylemişti. O günden beridir düşünüyorum. Belki de haklıydı?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341495
    m_Localized: 'Raskolnikov: Belki insan veya Ziyaretçi değilimdir. Belki... yarım kalan bir şeyimdir. Ya bana bunu düzeltmek için fırsat ver ya da işimi bitir.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341496
    m_Localized: 'Raskolnikov: Belli ki ben daima...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341497
    m_Localized: 'Raskolnikov: ...kurban olacağım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341498
    m_Localized: 'Nun: Beni yalnızca Tanrı sınamıyor belli ki...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341499
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341500
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341501
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341502
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341503
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341505
    m_Localized: 'Nun: Elzemse öyle olsun...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341506
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341507
    m_Localized: 'Nun: Korkma.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341509
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341511
    m_Localized: 'Nun: Acele et.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341512
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341514
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341516
    m_Localized: 'Nun: Buyur o zaman. Hadi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341517
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341520
    m_Localized: 'Nun: Bu gözlerin ne günahlara tanıklık ettiğini bir bilsen evlat!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341521
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341523
    m_Localized: 'Nun: Tövbe! Sen kafayı mı sıyırdın iyice?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341524
    m_Localized: 'Nun: İhtiyar, hasta bir kadına kollarını kaldırtıp... senin gibi birine kendini göstermesini istiyorsun! Düşüncesi bile iğrenç!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341525
    m_Localized: 'Nun: Bunu kesinlikle kabul edemem!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341526
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341527
    m_Localized: 'Nun: Sapık mısın nesin!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341528
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341529
    m_Localized: 'Nun: Belli ki beni rahat bırakmayacaksın.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341530
    m_Localized: 'Nun: Madem öyle... Tanrı öyle buyurduysa öyle olsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341531
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341532
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341534
    m_Localized: 'Nun: Fotoğraf mı? Peh! Böyle saçmalıklara ayıracak vaktim yok benim!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341535
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341536
    m_Localized: 'Nun: Fotoğrafların bize gerçeği gösterdiğini mi sanıyorsun sen? Ya sabır... Manastırımda beslediğim kuşlar senden daha zeki!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341537
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341539
    m_Localized: 'Nun: Kulaklarıma mı bakmak istiyorsun? Bu ne cüret!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341540
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341541
    m_Localized: 'Nun: Beni mezbahadaki dana mı sandın sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341542
    m_Localized: 'Nun: Hiç ahlak kalmamış hiç.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341543
    m_Localized: 'Nun: Gelmiş ihtiyar kadının yüreğine indiriyorsun şurada. Hiç mi utanmıyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341544
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341545
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341547
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341550
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341553
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341557
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341561
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341579
    m_Localized: 'Fugitive: Buyur, saklayacak bir şeyim yok benim. Kör talihim dışında yani, heh!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535552
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535553
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535554
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535555
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535556
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535557
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535558
    m_Localized: 'Fugitive: Bak bakalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535559
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535560
    m_Localized: 'Fugitive: Evet, şahane bir gülümseme değil. O şerefsizler insanları değil de dişlerimizi temizleseydi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535561
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535562
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535563
    m_Localized: 'Fugitive: Buyur. Epey hırpalandılar, orası kesin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535628
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535629
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535630
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535631
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535632
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535633
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535634
    m_Localized: 'Bestson: Ha... O kadar kötü mü gerçekten? Şey, peki...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535635
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535636
    m_Localized: 'Bestson: Annemler hep... genetiğin iyi derdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535638
    m_Localized: 'Bestson: Dişlerime pek iyi bakmadım hiç. Küçüklüğümden beri annem bana yatmadan önce dişlerimi fırçalamam gerektiğini hatırlatır.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535639
    m_Localized: 'Bestson: Şimdi unutup duruyorum. Bazen yatağa girip gözlerimi kapatıyorum ve geri dönmelerini bekliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535640
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535641
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535642
    m_Localized: 'Bestson: Ha, şey... Peki...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535643
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535644
    m_Localized: 'Bestson: Ellerim normal. Yani, sanırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535645
    m_Localized: 'Bestson: Ellerimin neye benzemesi gerektiğini hiç düşünmedim galiba.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535646
    m_Localized: 'Bestson: Normal el işte yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535649
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535650
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535651
    m_Localized: 'Bestson: Ne? Niye ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535652
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535653
    m_Localized: 'Bestson: Yeşil işte. Normal, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535655
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535656
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535657
    m_Localized: 'Bestson: Ha, şey... Peki...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535658
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535659
    m_Localized: 'Bestson: Hiç kıllarımı almadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535660
    m_Localized: 'Bestson: Annemler hiç demedi, benim de aklıma gelmedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535661
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535662
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535663
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535665
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535666
    m_Localized: 'Bestson: Garip bir fotoğraf. Özel kamerayla falan mı çektin ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535667
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535668
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535669
    m_Localized: 'Bestson: Ha? Şey, peki...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535670
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535671
    m_Localized: 'Bestson: Neye baktığını bilmiyorum ama...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535672
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535673
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535674
    m_Localized: 'Bestson: Hadi ama ya!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535677
    m_Localized: 'Bestson: Bu bir belirti falan değil, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535678
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535679
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535680
    m_Localized: 'Bestson: Hadi ama ya! Normal el işte!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535681
    m_Localized: 'Bestson: Dur, bekle! İnsanım ben! Sadece... gerginim biraz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535682
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535683
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535684
    m_Localized: 'Bestson: Dur, bekle! Gergin olduğumdan böyle! O kadar!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535685
    m_Localized: 'Bestson: Dur, bekle! Uykusuz olduğumdan böyle! O kadar!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535686
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535687
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535688
    m_Localized: 'Bestson: Hadi ama... Ciddi değilsindir herhâlde?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535689
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535690
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535691
    m_Localized: 'Bestson: Lütfen bayım, yalvarırım...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535692
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535693
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535694
    m_Localized: 'Bestson: Bir saniye. Bu o kadar önemli miydi sahiden?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535695
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535696
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535697
    m_Localized: 'Bestson: Annem tüm kalsiyumunu ondan çaldığımı söylerdi. Beni emzirirken hani.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535698
    m_Localized: 'Bestson: Benim yüzümden onun dişleri zayıflamış, benimkiler de... güzel olmuş işte! Diş etlerim hariç yani...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535699
    m_Localized: 'Bestson: Annemler burada olsaydı belki her şey farklı olurdu...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535700
    m_Localized: 'Bestson: Bana bunları hatırlatırlardı, kendime bakmamı söylerlerdi. Böyle salmazdım kendimi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535701
    m_Localized: 'Bestson: Fakat gittiler işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535702
    m_Localized: 'Bestson: Ben de kaldım böyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535703
    m_Localized: 'Bestson: Bazen ellerime bakıyorum da... Annem parmaklarımın onunkilere benzediğini söylerdi. Uzun, kibar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535735
    m_Localized: 'Bestson: Kusura bakma anne...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535736
    m_Localized: 'Buddy: Beni mi? Olur kanka. Benim saklayacak bir şeyim yok. Gerek de yok zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535737
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535738
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535739
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535740
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535741
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535742
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535743
    m_Localized: 'Buddy: Buyur, bak...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535745
    m_Localized: 'Buddy: Gördün mü? Yarısı kusursuz, tertemiz, bembeyaz. Kalanı da...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535746
    m_Localized: 'Buddy: Diğerleri kadar dayanıklı değil diyelim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535747
    m_Localized: 'Buddy: Hayat böyledir işte kanka. Pek nazik davranmaz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535748
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535749
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535750
    m_Localized: 'Buddy: Bak bakalım...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535751
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535752
    m_Localized: 'Buddy: Kocaman, değil mi? Tam hamur yoğurmalık ya da ev inşa etmelik...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535753
    m_Localized: 'Buddy: Ben ise şişe açıp sağı solu dağıtmak için kullanıyorum. Hayat işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535754
    m_Localized: 'Buddy: Ben ise şişe açmak için kullanıyorum. Hayat işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535755
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535756
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535757
    m_Localized: 'Buddy: Olur, bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535758
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535759
    m_Localized: 'Buddy: Düz, kahverengi. Dünyanın yarısıyla aynı. Bir gizemi yok maalesef.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535760
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535761
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535762
    m_Localized: 'Buddy: Emin misin kanka ya? İyi, peki, madem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535763
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535764
    m_Localized: 'Buddy: Görecek bir şey yok. Kalın, kıllı, galiba mantar var bir de. Herhâlde köpekle yatarken kaptım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535765
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535766
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535767
    m_Localized: 'Buddy: Ha. Peki, lazımsa çek.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535768
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535769
    m_Localized: 'Buddy: Çok fotoğraf çektirmiyorum açıkçası. Pek fırsat olmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535770
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535771
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535772
    m_Localized: 'Buddy: Buyur... Bildiğin kulak işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535773
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535774
    m_Localized: 'Buddy: Gayet normal, değil mi? İstersen dokunabilirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535775
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535776
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535777
    m_Localized: 'Buddy: Dişim yüzünden mi bu? Yanlış anlama da kanka, birinin kafasına sıkmak için çok saçma bir sebep bu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535778
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535779
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535780
    m_Localized: 'Buddy: Ölümden sonra bir şey olduğunu düşünmek isterdim. Bir gün köpeğimi tekrar göreceğimi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535781
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535782
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535783
    m_Localized: 'Buddy: Hop dedik... Sevdiğin birinin ölmesi kolay şey değil be kanka. İki gözyaşı dökelim biz de yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535784
    m_Localized: 'Buddy: Bu yüzden vurmazsın be insanı. Sırf insaflı diye...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535785
    m_Localized: 'Buddy: Gözlerimi hedef almasan olur mu? Benim için be kanka?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535786
    m_Localized: 'Buddy: Son anlarımda güzel bir şey görürüm belki.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535787
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535788
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535789
    m_Localized: 'Buddy: Mantar için doktora giderdim aslında da ne önemi kaldı ki? Hem de şu saatten sonra...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535791
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535792
    m_Localized: 'Buddy: En azından bana da bir göstereydin be. O kadar da kötü olamaz herhâlde?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535793
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535794
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535795
    m_Localized: 'Buddy: Dalga mı geçiyorsun kanka?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535796
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535797
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535798
    m_Localized: 'Buddy: Bir keresinde bir dişçi bana "Bu dişlerle reklama bile çıkarsın," demişti.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535799
    m_Localized: 'Buddy: Sonra... o gece dişlerimi döktüler! Sırf gülümsedim diye. Çok komik, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535800
    m_Localized: 'Buddy: Kavgaya bile bulaşmadım. Yanlış anda güldüm, o kadar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535801
    m_Localized: 'Buddy: Bu ellerle eskiden... köpeğime sarılırdım. O hâlâ yaşıyorken. Yumuşacık tüylerini okşardım...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535802
    m_Localized: 'Buddy: Onu çok özlüyorum be kanka. Tahmin bile edemezsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535803
    m_Localized: 'Buddy: Bir gün ninem "Bana öyle baktığında sanki benimle şimdiden vedalaşıyorsun gibi geliyor," demişti.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535804
    m_Localized: 'Buddy: O zaman anlamamıştım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535805
    m_Localized: 'Buddy: Şimdi... haklı olduğunu idrak ettim. Fakat bunu ona söyleyemiyorum artık.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535806
    m_Localized: 'Buddy: O son gece... yanında durmuştum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535807
    m_Localized: 'Buddy: Belki onu sıcak tutarım, onu rahatlatırım diye düşünmüştüm. Herhâlde o da bana hatıra bıraktı.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535808
    m_Localized: 'Buddy: Komik, değil mi? Gideli çok oldu ama onu hâlâ yanımda taşıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535809
    m_Localized: 'Buddy: Eskiden köpeğimin bir sürü fotoğrafını çekerdim. Doyamazdım ona. Onu herkese göstermek isterdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535810
    m_Localized: 'Buddy: Kendimi hiç çekmezdim ama. Özellikle o yıllıklar var ya, millet birdenbire modele dönüşüyor falan... Hiç benlik değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535811
    m_Localized: 'Buddy: Bir keresinde evin yakınlarında havai fişek patlatmışlardı. Köpeğim tir tir titriyordu... Bana yaklaşmaya çalışıyordu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535812
    m_Localized: 'Buddy: Onu sıkıca tuttum, sakinleştirmeye çalıştım. Zavallı şey...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535813
    m_Localized: 'Buddy: Sonra "Keşke biri de beni böyle tutsa," diye düşündüm. "Ben de korksaydım yalnız olmadığımı bilmek isterdim."'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535814
    m_Localized: 'Buddy: Demek böyle...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535815
    m_Localized: 'Buddy: Öyle mi kanka?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535816
    m_Localized: 'Fatman: Ciddi misin sen? Beni mi? Meclis üyesini mi? İyi madem, bak bakalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535817
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535823
    m_Localized: 'Fatman: Ee, sonra? Bir de domalayım istersen? Bir bakanın vaktini bunlarla boşa harcıyorsun ya, ben de bir şey demiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535824
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535825
    m_Localized: 'Fatman: Belli ki bu işin peşini bırakmayacaksın.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535826
    m_Localized: 'Fatman: Cık cık... Peki, bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535827
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535828
    m_Localized: 'Fatman: Ee? Manzarayı beğendin mi? Sigara içmek sadece sinirlerini yatıştırmaz, karakterini de ortaya koyar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535994
    m_Localized: 'Dude: Sorun değil be kanka. Bak gitsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536001
    m_Localized: 'Dude: Baaaak!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536002
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536011
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536017
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536024
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536033
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536038
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536084
    m_Localized: 'Dude: Of be kanka ya, ben seni kıyak adam sanmıştım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536085
    m_Localized: 'Dude: Kanka be...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729856
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729857
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729858
    m_Localized: 'Wheelchair: Hee. Ne? He?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729859
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729860
    m_Localized: 'Wheelchair: Sen bu belirtilere güvenemiyorsan ben ne yapacağım?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729861
    m_Localized: 'Wheelchair: Kim bilir? Belki hepsi Ziyaretçi belirtisidir, belki hiçbiri değildir!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729862
    m_Localized: 'Wheelchair: Hepimiz insanız sonuçta, hata yaparız.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729863
    m_Localized: 'Wheelchair: Fakat bazen hataların korkunç sonuçları olur.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729864
    m_Localized: 'Ballerina: Sen beni test edecek? Hah, evet. Sen, bir şeyi anlayacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729871
    m_Localized: 'Ballerina: Diş?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729872
    m_Localized: 'Ballerina: Sen vicdanın bıraktığını çiğniyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729873
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729874
    m_Localized: 'Ballerina: Hepsini ye. Lezzetli vicdanı ısır çiğne.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729875
    m_Localized: 'Ballerina: ...Vicdan ne demek?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729878
    m_Localized: 'Ballerina: Ee?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729879
    m_Localized: 'Ballerina: Ben dans ediyor. Sen niye durdurup dansçı ellere bakıyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729880
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729881
    m_Localized: 'Ballerina: Kedicik...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729882
    m_Localized: 'Ballerina: Kedicik canlı diye ısrar ediyor. Şanslı kedicik.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729883
    m_Localized: 'Ballerina: Kedicik tam kafa ağrısı... ve el.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729886
    m_Localized: 'Ballerina: Şimdi ilgi çekici kısım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729887
    m_Localized: 'Ballerina: Benim gözlerde yazı var. Sen görüyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729888
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729889
    m_Localized: 'Ballerina: Trajedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729890
    m_Localized: 'Ballerina: Sen yalnız yaşıyor, evet?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729891
    m_Localized: 'Ballerina: Ee? Nasıl his?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729894
    m_Localized: 'Ballerina: HAHAHAHA! İyi bak. Kokla. Başka ne?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729895
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729896
    m_Localized: 'Ballerina: Sen sevdi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729899
    m_Localized: 'Ballerina: O ne? Ben bilmiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729900
    m_Localized: 'Ballerina: Deneme vakti.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729901
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729902
    m_Localized: 'Ballerina: MMMMMMM...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729903
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729904
    m_Localized: 'Ballerina: Bunu bana kimse söylemedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729905
    m_Localized: 'Ballerina: Güzel dansın sonucu mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729906
    m_Localized: 'Ballerina: Beni korkutur.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729909
    m_Localized: 'Ballerina: Haaa... İyiye işaret.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729910
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729911
    m_Localized: 'Ballerina: Ee? Söyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729912
    m_Localized: 'Ballerina: Kim iyi, kim kötü?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729915
    m_Localized: 'Ballerina: HAHAHA! Ateş et!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729918
    m_Localized: 'Ballerina: Sen kırmızı kan istiyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729919
    m_Localized: 'Ballerina: Ben de.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729920
    m_Localized: 'Ballerina: Zavallı bana daha yok. Henüz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729923
    m_Localized: 'Ballerina: Sen kırmızı kan sevmiyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729924
    m_Localized: 'Ballerina: Sen her gün, her saat çok döküyor ama yine sevmiyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729925
    m_Localized: 'Ballerina: Evet, hayır?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729928
    m_Localized: 'Ballerina: Ne? Sen zaten fırsatı kaçırdı. İkinci koklama yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729929
    m_Localized: 'Ballerina: Benim suç değil.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729930
    m_Localized: 'Ballerina: Sadece koca salak bunu yapar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729933
    m_Localized: 'Ballerina: Dans mı zamanı?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729934
    m_Localized: 'Ballerina: Sen istedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729937
    m_Localized: 'Ballerina: Sen nasıl karar veriyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729938
    m_Localized: 'Ballerina: Kulaktan?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729941
    m_Localized: 'Ballerina: Sen fikir mi değiştirdi? Başka belirti mi bakıyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729942
    m_Localized: 'Ballerina: Doymadı mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729943
    m_Localized: 'Ballerina: Yukarı, aşağı, yukarı, aşağı... Sen bu niye yapıyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729944
    m_Localized: 'Ballerina: Karar veremiyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729945
    m_Localized: 'Ballerina: HAHAHAHAHA! Buradan salak görünüyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729946
    m_Localized: 'Ballerina: Biz kırmızı kana susadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729947
    m_Localized: 'Ballerina: SEN Ziyaretçi değilsin, sen emin?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729948
    m_Localized: 'Ballerina: Sen ölüme açık yol istiyor. Bizim gibi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729949
    m_Localized: 'Ballerina: Sen KOCA salak!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729950
    m_Localized: 'Ballerina: Dans seni sinir ediyor? Sinir dans.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729952
    m_Localized: 'Ballerina: Sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729953
    m_Localized: 'Ballerina: Sen bunun sonunu biliyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729954
    m_Localized: 'Ballerina: Koca palyaço, yıkık evde tüm gün gülüyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729955
    m_Localized: 'Ballerina: Tesadüf.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729956
    m_Localized: 'Ballerina: Kulak. Hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729957
    m_Localized: 'Ballerina: Kulakçıklar. Kulak, kulak, kulakçık, kulaklar. Kulakçıklar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729958
    m_Localized: 'Ballerina: Bunu O istiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729959
    m_Localized: 'Ballerina: Koca salağı destekleyeceğini ben hiç düşünmezdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729960
    m_Localized: 'Ballerina: Hiç düşünmedi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729963
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729964
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729965
    m_Localized: 'Anger: O pompalıyı sağda solda sallama öyle!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729966
    m_Localized: 'Anger: Sırf KULAĞIM yüzünden kafama sıkarsan kafayı yerim amına koyayım!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729967
    m_Localized: 'Couple: Ha... Tabii, tabii. Lütfen karıcığımı rahatsız etme ama, zaten çok yorgun.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729975
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729976
    m_Localized: 'Couple: Hayat zor artık, sen de biliyorsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729977
    m_Localized: 'Couple: Dişlerim kusursuz olmayabilir ama ne yapayım? Zaten öğrenciyken de bu yüzden zorbalığa uğradım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729978
    m_Localized: 'Couple: Peki şimdi o zorbalar nerede?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729979
    m_Localized: 'Couple: Bir ara sokakta yerde yatıyorlardır, tıpkı kendileri gibi canavarlardan ölümüne dayak yemişlerdir.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729983
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729984
    m_Localized: 'Couple: Açıkçası böyle zamanlarda insanın kendine bakmaması çok garip geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729985
    m_Localized: 'Couple: Hastalanırsam güzelime kim bakacak? Kimse.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729990
    m_Localized: 'Couple: Hadi karşılıklı o zaman!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729991
    m_Localized: 'Couple: Kusura bakma, biraz gerginim de... Gerçi niye olmayayım? Test edilmek korkunç bir şey, saklayacak hiçbir şeyin yoksa bile.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729992
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729993
    m_Localized: 'Couple: Peki, tamam. Çok gerginim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729994
    m_Localized: 'Couple: Hem beni hem de balımı tehlikeye atıyorsan ben ne yapayım?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729997
    m_Localized: 'Couple: Hop hop hop. Sadece benimkileri görebilirsin birader!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729998
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729999
    m_Localized: 'Couple: Kadınlardan kıllarını almalarını bekleniyor. Biz niye almayalım ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730000
    m_Localized: 'Couple: Hem şu sıcak havalarda insanı serin tutar!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730001
    m_Localized: 'Couple: İki erkek şurada konuşuyoruz bak, anlamışsındır ne demek istediğimi!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730002
    m_Localized: 'Couple: Kıllarını kadınlar alsın, ben niye alıyorum?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730003
    m_Localized: 'Couple: Benim görevim, onu canavarlarla dolu bir dünyada korumak.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730006
    m_Localized: 'Couple: Bir saniye, bu nasıl bir test şimdi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730007
    m_Localized: 'Couple: Fotoğraf çekmek yok. Ne benim ne de karımın fotoğrafını çekemezsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730008
    m_Localized: 'Couple: Gerçi reddedersek... bizden şüphelenmen normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730009
    m_Localized: 'Couple: Dur, bir düşüneyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730010
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730011
    m_Localized: 'Couple: İyi o zaman, çek fotoğrafını. Sonra bende kalacak ama.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730012
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730013
    m_Localized: 'Couple: Ver bana!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730016
    m_Localized: 'Couple: Bunun Ziyaretçi olmakla ne ilgisi var, anlayamadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730017
    m_Localized: 'Couple: Neyse, saklayacak bir şeyim yok. Buyur.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730018
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730019
    m_Localized: 'Couple: Ee? Ne gördün?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730020
    m_Localized: 'Couple: Sen insanın kulağından Ziyaretçi olup olmadığını anlayan duydun mu hiç tatlım? Senin de dilini kedi yuttu herhâlde!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730021
    m_Localized: 'Couple: Ha, öyle mi? Hım... Peki, tamam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730022
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730023
    m_Localized: 'Couple: Enteresan... Ee, sonuç?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730026
    m_Localized: 'Couple: Lütfen, güzel karım ben olmadan yapamaz. Silahı indir.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730029
    m_Localized: 'Couple: Ee?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730030
    m_Localized: 'Couple: Bu, işime yaramayacak ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730031
    m_Localized: 'Couple: Senin de işine yaramayacak. Silah ne alaka yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730032
    m_Localized: 'Couple: Senin de işine yaramayacak güzel kardeşim. Silah ne alaka yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730035
    m_Localized: 'Couple: Hata yapıyorsun. Kadını test edemedin diye hemen silahına sarılmak ne demek?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730036
    m_Localized: 'Couple: Sana yemin ediyorum insan o. Değil mi güzelim?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730037
    m_Localized: 'Couple: Zaten gitmeye hazırız, çantalarımızı topladık. Karım savsaklıyor diye Ziyaretçi olmuyoruz herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730040
    m_Localized: 'Couple: O canavarların tarafını tutacağını hiç düşünmezdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730041
    m_Localized: 'Couple: Sırf kılımız yüzünden vuracak mısın bizi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730048
    m_Localized: 'Couple: Tırnaklar sıkıntı, tamam. Orasını anladık. Ziyaretçiler yerin dibinden geliyor sonuçta.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730049
    m_Localized: 'Couple: Gözler, tamam. Koltuk altı, belki. Kulak ne alaka?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730050
    m_Localized: 'Couple: Gözler, tamam. Koltuk altı, belki. Kulak ne alaka? Beyne yakın diye mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730170
    m_Localized: 'Luka: İşine yarayacaksa buyur.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730171
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730172
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730173
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730174
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730175
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730176
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730177
    m_Localized: 'Luka: Buyur, bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730178
    m_Localized: 'Luka: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730179
    m_Localized: 'Luka: Acaba insanın dişi, kişiliğini yansıtır mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730180
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730181
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730182
    m_Localized: 'Luka: Buyur.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730183
    m_Localized: 'Luka: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730184
    m_Localized: 'Luka: Evet, ikisi de benim... Onca şey kaybettim ama bunlar duruyor hâlâ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730185
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730186
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730187
    m_Localized: 'Luka: Tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730188
    m_Localized: 'Luka: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730189
    m_Localized: 'Luka: Gözler her şeyi hatırlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730190
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730191
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730192
    m_Localized: 'Luka: Bunun belirti olduğunu bilmiyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730193
    m_Localized: 'Luka: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730194
    m_Localized: 'Luka: Gayet sıradan, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730195
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730196
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730197
    m_Localized: 'Luka: Pekâlâ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730198
    m_Localized: 'Luka: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924161
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924162
    m_Localized: 'FortuneTeller: Bir keresinde kulaklarım çınlamıştı, evren bana fısıldıyor gibiydi... fakat bunun daha da büyük bir şey olduğuna inanıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924306
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924307
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924308
    m_Localized: 'Anxiety: Ziyaretçi o... olduğum ortaya çıkarsa... insanları öldürmeye mi başlayacağım?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924309
    m_Localized: 'Anxiety: Tehlikeli biri mi olacağım? Yoksa... hep mi tehlikeliydim?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924310
    m_Localized: 'Anxiety: Belki... insan öldürmeye ç... çoktan başlamışımdır?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924311
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924312
    m_Localized: 'Anxiety: Hahaha, düşünebiliyor musun? Demek... bu doğru.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924313
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924314
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924315
    m_Localized: 'Anxiety: Niye bu kadar belirti var ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924316
    m_Localized: 'Anxiety: NEDEN TÜM BELİRTİLERİ GÖSTERİYORUM BEN? HAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924317
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924318
    m_Localized: 'Anxiety: BU NE ANLAMA GELİYOR, HİÇ BİLMİYORUM!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924319
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924320
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924333
    m_Localized: 'Anxiety: Neyi bekliyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924334
    m_Localized: 'Anxiety: Vur gitsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924335
    m_Localized: 'Anxiety: E.. En azından her gün titremem artık. Bu sefer benden neden nefret edeceğini de hiç bilmem...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924340
    m_Localized: 'Esenin: Yok belirti testi, yok sarılı adamlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924341
    m_Localized: 'Esenin: Artık...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924342
    m_Localized: 'Esenin: ...bıktım usandım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924343
    m_Localized: 'Esenin: Sen de sonumuzun çok kötü olacağını düşünüyor musun?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924344
    m_Localized: 'Esenin: Sözde her şey kontrol altında ama kan gövdeyi götürüyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924345
    m_Localized: 'Esenin: Çek şu fotoğrafını.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924346
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924347
    m_Localized: 'Esenin: Gelecekte olacaklardan çok korkuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924348
    m_Localized: 'Esenin: Neye baktığını biliyor musun da sen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924349
    m_Localized: 'Esenin: Neyi kontrol edeceğini?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924350
    m_Localized: 'Esenin: Senin böyle zorlandığını görünce ne kadar sıçtığımızı anladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924351
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924352
    m_Localized: 'Esenin: Yarın bir gün çocuğun tekini kesip biçmeni söylerler, gıkını bile çıkarmazsın.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924353
    m_Localized: 'Esenin: Hay sikeyim... Ne ettim de bu kâbusta mahkûm kaldım ben?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924354
    m_Localized: 'Cold: N... Neye bakmak istiyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924361
    m_Localized: 'Cold: Ha, d... dişime mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924362
    m_Localized: 'Cold: Peki... B... Bak.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924363
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924364
    m_Localized: 'Cold: Bazen dudaklarımı kanatana kadar ı... ısırıyorum... Kanımın sıcaklığını h... hissedeyim diye...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924365
    m_Localized: 'Cold: Hâlâ y... yaşadığımı hatırlamak için...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924368
    m_Localized: 'Cold: T... Tırnağım mı? Olur, göstereyim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924369
    m_Localized: 'Cold: Hım... Hepsini k... koparmışım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924370
    m_Localized: 'Cold: Yine de b... bakabilirsin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924371
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924372
    m_Localized: 'Cold: Sence tırnaklarım Z... Ziyaretçi tırnağına b... benziyor mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924375
    m_Localized: 'Cold: Artık gözler ruhun değil, c... cehennemin aynası.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924377
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924378
    m_Localized: 'Cold: Göz bebeklerim mi d... dar?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924379
    m_Localized: 'Cold: Herhâlde soğuktan h... her yerim gerilmiş...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924380
    m_Localized: 'Cold: Bari güneş b... beni yakmasaydı...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924381
    m_Localized: 'Cold: En azından derim y... yanarken ısınırdım...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924384
    m_Localized: 'Cold: Hım...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924385
    m_Localized: 'Cold: Biraz i... izin verir misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924386
    m_Localized: 'Cold: D... Dur...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924387
    m_Localized: 'Cold: Şimdi. Bak. Ç... Çabuk.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924388
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924389
    m_Localized: 'Cold: Evet. Bu hiç hoş değildi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924390
    m_Localized: 'Cold: Sana saygımdan... h... her şeyi gösterdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924393
    m_Localized: 'Cold: Bu fotoğraf neyi k... kanıtlıyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924394
    m_Localized: 'Cold: Sana da g... garip gelmiyor mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924395
    m_Localized: 'Cold: Gerçi... B... Bana kalmıyor, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924396
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924397
    m_Localized: 'Cold: B... Bir şey mi gördün?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924398
    m_Localized: 'Cold: G... Göster bana.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924401
    m_Localized: 'Cold: Bedenlerimiz z... zaten delikten ibaret.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924402
    m_Localized: 'Cold: Herhâlde bu yüzden i... insanlar bu kadar kolay kayboluyor? Gözünü ç... çevirdiğin an yutulup yok oluyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924403
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924407
    m_Localized: 'Cold: Belki yakında h... hatırlamama gerek kalmaz...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924415
    m_Localized: 'Cold: Sen katil misin? Gözlerim k... kırmızı değil ki.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924416
    m_Localized: 'Cold: Sana engel olmayayım. Beklemek ö... ölmekten beter.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924419
    m_Localized: 'Cold: Mantar mı v... var? Herhâlde mont çok t... terletiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924420
    m_Localized: 'Cold: Bedenim bir şeye karşı k... koyuyor... ama niye ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924423
    m_Localized: 'Cold: Fotoğraf b... bende kalsa olur mu? Hiç fotoğrafımı ç... çeken olmamıştı.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924424
    m_Localized: 'Cold: Güzel bir h... hismiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924427
    m_Localized: 'Cold: Hiçliğin içinde n... ne görüyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924428
    m_Localized: 'Cold: Sana kendini hatırlatıyor mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924431
    m_Localized: 'Cold: Bana g... güvendiğin için teşekkür ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924432
    m_Localized: 'Cold: Umarım bir şekilde s... sana yardım edebilirim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924433
    m_Localized: 'Cold: Beni hırpalayan bir şey v... var ama ne olduğunu henüz s... söyleyemem...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924434
    m_Localized: 'Cold: Böyle yaşamaktan b... bıktım aslında.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924435
    m_Localized: 'Cold: Fakat sen beni ö... öldürmemeyi seçtin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924436
    m_Localized: 'Cold: B... Bu sırada başka bir yerde başka birini k... kendi evinde vurdular.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924437
    m_Localized: 'Cold: Sence n... neden?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924438
    m_Localized: 'Cold: Gözlerimin feri s... söneli çok oluyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924439
    m_Localized: 'Cold: Geriye sadece sonsuz bir y... yalnızlık kaldı.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924440
    m_Localized: 'Cold: Kimseyle yakınlaşamıyorum. Sonu hep acı... v... ve ıstırap oluyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924441
    m_Localized: 'Cold: Huzuru özledim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924445
    m_Localized: 'Cold: Söyle bana, ne yapılması g... gerektiğini anlamaları için kaç belirti gerekiyor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924446
    m_Localized: 'Cold: Niye insanlar ö... ölmek zorunda?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924447
    m_Localized: 'Cold: Yoksa hiç mi d... değillerdi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924448
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924449
    m_Localized: 'Cold: Bazen çok ş... şahsi sorular sorabiliyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924450
    m_Localized: 'Cold: Rahatsız olursan g... görmezden gel.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924453
    m_Localized: 'Cold: Aslında...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924454
    m_Localized: 'Cold: Sanırım neden bu kadar ü... üşüdüğümü sonunda anladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924493
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118466
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118586
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118587
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118588
    m_Localized: 'NotTrue: O filmi bana mı harcayacaksın? Bir yaşıma daha girdim!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118589
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118590
    m_Localized: 'NotTrue: Ee evladım?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118591
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118592
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118593
    m_Localized: 'NotTrue: Aman, sen neler diyorsun öyle?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118594
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118595
    m_Localized: 'NotTrue: Benim kulaklarım çok hassastır evladım ama bazen solup gidiyorum gibi geliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118596
    m_Localized: 'NotTrue: Sadece en parlak ışığın altında görülür hâle gelir gibiyim, ki o dahi muamma.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118597
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118598
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118599
    m_Localized: 'NotTrue: Aman aman, ihtiyar bir kadını mı vuracaksın gerçekten?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118600
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118601
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118602
    m_Localized: 'NotTrue: Bu ne şimdi evladım? İki ihtiyar kulaktan ne anladın sen şimdi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118603
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118604
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118605
    m_Localized: 'NotTrue: Bizim zamanımızda sadece zenginlerde olurdu böyle şeyler. Şimdi her delikanlıda var!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118606
    m_Localized: 'NotTrue: Peh! Sana söyleyeceğim bir şey yok artık delikanlı. Boş yere güzelim insanları endişelendiriyorsun...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312866
    m_Localized: 'Foreigner: Анламадым, не истийорсун бенден?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312874
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312875
    m_Localized: 'Foreigner: Ее, шимди?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312878
    m_Localized: 'Foreigner: Елим ми? Пеки.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312879
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312880
    m_Localized: 'Foreigner: Нийе бунунла уграшыйорсун ки? ÖLDĞRM ZİVK alyn?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312883
    m_Localized: 'Foreigner: Гoзyм мy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312884
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312889
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312894
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312916
    m_Localized: 'Foreigner: Haha...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312930
    m_Localized: 'Edgar: Benliğim bir mazi oldu gitti.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312931
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312932
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312933
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312934
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312935
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312936
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312937
    m_Localized: 'Edgar: Ağzındaki incilerin nasıl parladığı hâlâ dün gibi aklımda... Gülüşüyle nasıl ışık saçtığı...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312938
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312939
    m_Localized: 'Edgar: Benimkiler ise yere düşen bahar yaprakları gibi, ekim yağmurunda malç oluvermiş...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312940
    m_Localized: 'Edgar: İşte... sevdanın bedeli.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312941
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312942
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312943
    m_Localized: 'Edgar: Elleri ne kadar da yumuşacıktı... Tuttuğumda eriyip gidecekler gibi gelirdi. Sanki bir hayalet gibiydi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312944
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312945
    m_Localized: 'Edgar: Sağ elim artık bana ait değil. Her geçen gün daha da çürüyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312946
    m_Localized: 'Edgar: Ancak sol elim yine de dayanıyor. Tırnaklarımı görüyor musun? Hepsi tertemiz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312947
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312948
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312949
    m_Localized: 'Edgar: Gözlerini hatırladığımda bile içim bir hoş oluyor... Pardon, sen benimkileri görmek istemiştin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312950
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312951
    m_Localized: 'Edgar: Birilerinin ardından gözyaşı dökenlerin dünyayı daha karanlık gördüğünü söylerler fakat ben, uzun süredir ağlamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312952
    m_Localized: 'Edgar: Artık onun çehresini aramıyorum. Alınacak en zor ders, kabullenmenin kaçınılmaz olduğudur.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312953
    m_Localized: 'Edgar: Ancak alışkanlıktan olsa gerek, hâlen formunun peşindeyim. Gözümün kenarından gördüğüm her gölge, bana onun silüetini andırıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312954
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312955
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312956
    m_Localized: 'Edgar: Tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312957
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312958
    m_Localized: 'Edgar: Beden, durgunluktan nefret eder. Tek bir yerde durmaktan... İlk başta kendimi ona saklıyordum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312959
    m_Localized: 'Edgar: Ancak bu, hiçbir işe yaramadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312960
    m_Localized: 'Edgar: Beden, durgunluktan nefret eder. Tek bir yerde durmaktan... Ancak benim bir seçeneğim yoktu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312961
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312962
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312963
    m_Localized: 'Edgar: Pekâlâ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312964
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312965
    m_Localized: 'Edgar: Nasıl görünüyorum?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312966
    m_Localized: 'Edgar: Daha doğrusu... Sen beni nasıl görüyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312967
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312968
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312969
    m_Localized: 'Edgar: Olan, kalır.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312970
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312971
    m_Localized: 'Edgar: Değişmeyen sayılı şeyden biri.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312972
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312973
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312974
    m_Localized: 'Edgar: Beni korkuyla doldurmak mı istiyorsun? Maalesef ki dostum, bu beden yalnızca kof bir kabuk. Her geçen gün daha da parçalanıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312975
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312976
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312977
    m_Localized: 'Edgar: Dürüst olmam gerekiyor ki gecenin kollarına kendi rızamla düşeceğimi zannetmiştim...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312978
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312979
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312980
    m_Localized: 'Edgar: Bırak bu yolda yalnız yürüyeyim. Mermin boşa gitmesin...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312981
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312982
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312983
    m_Localized: 'Edgar: Birinin yanında yeterince uzun vakit yatarsan... özü sana da geçer. Onun varlığı bedenime, ruhuma işledi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312984
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312985
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312986
    m_Localized: 'Edgar: Etkileyici...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312987
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312988
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312989
    m_Localized: 'Edgar: Peki öyleyse...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312990
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312991
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312992
    m_Localized: 'Edgar: Beni her öptüğünde sanki son defa öpeceğinden korkar gibiydi. Şimdi sebebini idrak edebiliyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312993
    m_Localized: 'Edgar: Elimi muhafaza etmek için bunca vakit uğraştım...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312994
    m_Localized: 'Edgar: Tek bir parçam bile temiz kalsa bu, bana hatırlatmaya yeter diye düşündüm ama şimdi... hiçbir anlamı kalmadı.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312995
    m_Localized: 'Edgar: Böylesi daha iyi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312996
    m_Localized: 'Edgar: Ne zaman gözlerine baksam o sütten akında cennetin yansımasını görür gibi olurdum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312997
    m_Localized: 'Edgar: Şimdi ise hiçlik görüyorum... Beni derinliklerine çeken iki kara delik. Yalnızca boş yankıların duyulduğu iki çukur...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312998
    m_Localized: 'Edgar: Yabancı sözler, yabancı sesler... Ölüler, onun yerine konuşuyorlar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312999
    m_Localized: 'Edgar: Garip... Yaşayanlar, ölülerin yanında uzun süre dururlarsa onların bir parçasını alırlar, derler.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313000
    m_Localized: 'Edgar: Ya tam tersiyse?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313001
    m_Localized: 'Edgar: Fotoğraflar görünümleri muhafaza eder, ruhu değil. Ressam olsaydım onu tuvalimde ölümsüzleştirirdim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313002
    m_Localized: 'Edgar: Ancak ben, yalnızca bir kara sevdalıyım... Ben de bir gün ölüp gidene dek yalnızca hatıralarımda yaşıyor olacak.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313003
    m_Localized: 'Edgar: Kulağıma fısıldamayı çok severdi... gerçi ne dediğini hiçbir zaman anlamazdım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313004
    m_Localized: 'Edgar: Güzel şeyler söylediğine inanmak istiyordum sanırım... Zira zaten ölmüş, gitmişti...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313005
    m_Localized: 'Edgar: Sana geliyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313006
    m_Localized: 'Edgar: Sevgilim...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313007
    m_Localized: 'TaxiDriver: Şimdi birader, beni yanlış anlama da... Hani hayır demiyorum ama... Aman, neyse. Kendin gör.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313008
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313009
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313010
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313011
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313012
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313013
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313014
    m_Localized: 'TaxiDriver: Diş dediğin dişe benzer işte. Herkesinki aynı.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313015
    m_Localized: 'TaxiDriver: Ben dişlerime hep iyi bakmışımdır. Çocukken misvakla temizlerdim hatta.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313016
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313017
    m_Localized: 'TaxiDriver: Annem babam, "İnsanlar seni gülümsemene göre yargılar," derdi. İlk izlenim falan.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313018
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313019
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313020
    m_Localized: 'TaxiDriver: Peki. Çok narin değillerdir ama ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313021
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313022
    m_Localized: 'TaxiDriver: Normal el işte birader. Sigara içmeyeydim gerginlikten parmaklarımı koparırdım şimdiye.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313023
    m_Localized: 'TaxiDriver: Normal el işte birader. Tırnaklarım temiz değil, biliyorum. Trafikteyken direksiyonla oynamaktan.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313024
    m_Localized: 'TaxiDriver: Yoksa iyice maganda olurum, müşteri bulamam sonra!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313025
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313026
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313027
    m_Localized: 'TaxiDriver: Gözlerim hep yorgun. Bir türlü de uyku tutmuyor ama.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313028
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313029
    m_Localized: 'TaxiDriver: Hep dikkatli olmaya alıştığımdan. Arkamda kim var, kim bana bakıyor, kim sessiz kalıyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313030
    m_Localized: 'TaxiDriver: Mesleki deformasyon. Kurtulmak zor. Bu yüzden uykusuzluk çekiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313031
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313032
    m_Localized: 'TaxiDriver: Arabama el koyduklarından beri geceleri gözüme uyku girmiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313033
    m_Localized: 'TaxiDriver: Mesleki deformasyon. Arkamda kim var, kim bana bakıyor, kim sessiz kalıyor, hep bakıyorum. Kurtulmak zor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313034
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313035
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313036
    m_Localized: 'TaxiDriver: Normal koltuk altı işte.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313037
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313038
    m_Localized: 'TaxiDriver: Çok uzun süre araba kullanırsam omzum ağrıyor bir, o kadar. Bazen kollarımı bile kaldıramıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313039
    m_Localized: 'TaxiDriver: Alıştım artık, ne yapalım. Zaten şu saatten sonra...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313040
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313041
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313042
    m_Localized: 'TaxiDriver: Buyur, hazırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313043
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313044
    m_Localized: 'TaxiDriver: Ee, nasıl? Sıradan bir adam, değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313045
    m_Localized: 'TaxiDriver: Eskiden babamla benim takside fotoğraflarımız vardı. Şimdi anca polisler fotoğrafımı çekiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313046
    m_Localized: 'TaxiDriver: Bir de sen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313047
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313048
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313049
    m_Localized: 'TaxiDriver: Kulaklarım mı? Herkesinkiyle aynı işte, bir fark yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313050
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313051
    m_Localized: 'TaxiDriver: Epey kullanırım ama kulaklarımı. Yolcular konuşmayı seviyor, ben de araya girmeyi sevmiyorum. Dinleyip kafamdan not alıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313052
    m_Localized: 'TaxiDriver: Bazen de duymamam gereken şeyleri duyuyorum ama.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313053
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313054
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313055
    m_Localized: 'TaxiDriver: Sakin ol birader, deli değilim ben! O andan beridir aklıma takılan bir şey var sadece, o kadar...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313056
    m_Localized: 'TaxiDriver: Dişlerim bana birini hatırlatıyordu da. Kötü birini.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313057
    m_Localized: 'TaxiDriver: Babamla denk gelmişlerdi bi'' ara...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313058
    m_Localized: 'TaxiDriver: O günden beridir sigara içiyorum. Dişlerim ne hâlde görüyorsun zaten...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313059
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313060
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313061
    m_Localized: 'TaxiDriver: Hah... Dalga mı geçiyorsun? Taksi kullanmak her yiğidin harcı değildir. Ne demek istediğimi anladın herhâlde.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313062
    m_Localized: 'TaxiDriver: Kimi direksiyonu tokatlar, kimi bağırıp çağırır, kimi kavga eder. Herkes bir şekilde o stresi çıkarır. Şakayı bırak yani.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313063
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313064
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313065
    m_Localized: 'TaxiDriver: Hadi oradan moruk. Ben de salak değilim. Beni Ziyaretçi zannettiğini anladım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313066
    m_Localized: 'TaxiDriver: Yanlışın var ama, duydun mu? Masum bir adamı mı vuracaksın şurada?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313067
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313068
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313069
    m_Localized: 'TaxiDriver: İstediğin buysa yapma demiyorum. Zaten hiç sırtımı kollayan biri olmadı...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313070
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313071
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313072
    m_Localized: 'TaxiDriver: Bak, o kameradan gördüklerine göre bir karar verdiysen zaten...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313073
    m_Localized: 'TaxiDriver: Öyleyse yapacak bir şey yok. Ben ne desem boştur.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313074
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313075
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313076
    m_Localized: 'TaxiDriver: Bak, seni dinleyecek birini arıyorsan ben dinlerim. Alıştım zaten. Benim anlatacağım bir şey kalmadı...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313077
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313078
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313079
    m_Localized: 'TaxiDriver: Madem dişlerini mahvediyor, niye hâlâ sigara içiyorsun diye düşünüyorsun. Yanlış mıyım?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507072
    m_Localized: 'TaxiDriver: Niye dişlerimi beyazlattığımı düşünüyorsun. Yanlış mıyım?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507073
    m_Localized: 'TaxiDriver: Herhâlde başkasına benzemek için. Ziyaretçiler gibi değil ama. Anladın işte sen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507074
    m_Localized: 'TaxiDriver: Neyse, bir keresinde taksiye bizim mahalleden bir abi binmişti. Herkes adını bilirdi. Velet hâlimle ben bile bilirdim adamı.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507075
    m_Localized: 'TaxiDriver: İlk bakışta normal birine benziyordu. Fosur fosur tüttürüyordu ama.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507076
    m_Localized: 'TaxiDriver: İlk bakışta normal birine benziyordu. Dişleri bembeyazdı ama.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507077
    m_Localized: 'TaxiDriver: Babam o gün bir hata etti, bedelini de ağır ödedik. Sonra sıçan gibi yaşamaya başladık. Ne evimiz vardı ne de paramız.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507078
    m_Localized: 'TaxiDriver: Ellerimin güçlü olması gerek sanırdım hep. Arabamı sürmek için, hayatıma yön vermek için... Şu saatten sonra hiçbir önemi yok ama.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507079
    m_Localized: 'TaxiDriver: Ben hep etrafı kolaçan ederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507080
    m_Localized: 'TaxiDriver: Hem yolcu ararım hem de gerçekten kim olduğuna bakarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507081
    m_Localized: 'TaxiDriver: Bu seni rahatsız ettiyse kusura bakma. Artık taksim de yok, milleti böyle laflarla korkutmamam lazım...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507082
    m_Localized: 'TaxiDriver: Bazen düşünüyorum da... Tutunacağım birisi olsaydı belki gidip taksici olmazdım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507083
    m_Localized: 'TaxiDriver: O herifi arabama almazdım. Her şeyimi kaybetmezdim...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507084
    m_Localized: 'TaxiDriver: Demek bende bir insanlık gördün...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507085
    m_Localized: 'TaxiDriver: Kusursuz değilim ama elimden geleni yapıyorum. Yeminle.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507086
    m_Localized: 'TaxiDriver: En korkunç olan yolcular, arkada sessiz sessiz oturanlar oluyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507087
    m_Localized: 'TaxiDriver: İnsan kendi düşüncelerini duymaya başlıyor. Radyodan daha sesli oluyor. Bir türlü susmuyor, seni rahat bırakmıyorlar...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507088
    m_Localized: 'TaxiDriver: Küllerimi dışarı sal gitsin. Bir kalıntım olsun istemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507089
    m_Localized: 'TaxiDriver: En azından bu topraklarda...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507407
    m_Localized: 'Intruder: Hım... Bakalım gece ne değişmiş.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507408
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507409
    m_Localized: Ellerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507410
    m_Localized: Gözlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507411
    m_Localized: Koltuk altına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507412
    m_Localized: Fotoğrafını çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507413
    m_Localized: Kulaklarına bak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507414
    m_Localized: 'Intruder: Tabii, birazdan göstereceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507415
    m_Localized: 'Intruder: O kadar yorgunum ki bazı şeyleri unutuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507416
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507417
    m_Localized: 'Intruder: Küçük şeylere bu kadar odaklanmamalıyız bence. En azından biraz da olsa rahatlarız.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507418
    m_Localized: 'Intruder: Hafızam kötü olabilir ama dişlerimi fırçalamayı asla unutmam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507419
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507420
    m_Localized: 'Intruder: İnsanın kendine bakması önemlidir. En azından biraz da olsa içini rahatlatır.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507421
    m_Localized: 'Intruder: Acaba insanın rüyalarından Ziyaretçi olup olmadığı anlaşılıyor mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507422
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507423
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507424
    m_Localized: 'Intruder: Bu eller, karşıma çıkan tüm engelleri aşmaya hazırdır.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507425
    m_Localized: 'Intruder: Belki de rüyalarıma bu şekilde ulaşacağım...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507426
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507427
    m_Localized: 'Intruder: Neyle savaştığımı bile bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507428
    m_Localized: 'Intruder: Rüya görmem gerekiyor, öyle değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507429
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507430
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507431
    m_Localized: 'Intruder: Uykusuzluk insanın gözünü karartıyormuş, öyle duydum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507432
    m_Localized: 'Intruder: Acaba bu doğru mu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507433
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507434
    m_Localized: 'Intruder: Hım... Eskiden daha beyazdı gözlerim. Şimdi iyice kızardılar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507435
    m_Localized: 'Intruder: Fark ettin mi bilmiyorum ama... epey uzun süredir uyumuyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507436
    m_Localized: 'Intruder: Peki gözlerim niye kırmızı değil? Garip...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507437
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507438
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507439
    m_Localized: 'Intruder: Niyeyse koltuk altım acıyor, tahriş olmuş gibi. Garip...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507440
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507441
    m_Localized: 'Intruder: Ee? Kötü mü?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507442
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507443
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507444
    m_Localized: 'Intruder: Nasıl çıkacak, merak ediyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507445
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507446
    m_Localized: 'Intruder: Ha, normal fotoğraf değil yani. Aura gibi bir şey var.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507447
    m_Localized: 'Intruder: Biraz... boş duruyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507448
    m_Localized: 'Intruder: Bu kamera bozuk olmasın?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507449
    m_Localized: 'Intruder: Yani... Auralar gerçek mi ki? Kendi gözlerinle gördün mü hiç?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507450
    m_Localized: 'Intruder: Rüyalar gerçek. Yani gerçeklerdi en azından. Auraları bilemiyorum...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507451
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507452
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507453
    m_Localized: 'Intruder: Ha? Bunu hiç duymamıştım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507454
    m_Localized: 'Intruder: İyi madem, hadi deneyelim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507455
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507456
    m_Localized: 'Intruder: Ee, sonuç nedir?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507457
    m_Localized: 'Intruder: Neye bakacağını biliyor musun peki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507458
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507459
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507460
    m_Localized: 'Intruder: O kadar uzun süredir uyumuyorum ki bu yaşadıklarımız gerçek mi yoksa rüya mı anlayamıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507461
    m_Localized: 'Intruder: Rüya olduğu ortaya çıkarsa hiç şaşırmam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507462
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507463
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507464
    m_Localized: 'Intruder: Hım... Enteresan. Peki, insanlar hâlâ rüya görseydi acaba başkasının rüyasına izinsiz girebilir miydim?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507465
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507466
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507467
    m_Localized: 'Intruder: Uyuyacak bir yer arıyorum sadece.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507468
    m_Localized: 'Intruder: Uykulu hissediyorum ama gözlerim giderek daha da açılıyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507469
    m_Localized: 'Intruder: Bir saniye... Ziyaretçi belirtisi gösterdiğimi mi düşünüyorsun? Televizyonda anlattıkları belirtilerden?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507470
    m_Localized: 'Intruder: Neden şüphelendin peki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507471
    m_Localized: 'Intruder: Anlamadım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507472
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507473
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507474
    m_Localized: 'Intruder: Hım... Gerçekten mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507475
    m_Localized: 'Intruder: Uykusuzluktan cildim kurudu. Senin de böyle değil mi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507476
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507477
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507478
    m_Localized: 'Intruder: Beni vurmadan önce senden bir şey isteyeceğim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507479
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507480
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507481
    m_Localized: 'Intruder: Bedenimin tamamını yok eder misin?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507482
    m_Localized: 'Intruder: Uyansam bile geri dönememek istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507483
    m_Localized: 'Intruder: Bedenim beni tekrar ele geçiremesin istiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507484
    m_Localized: 'Intruder: Öbür tarafta vakit geçirmek istiyorum. Az da olsa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507485
    m_Localized: 'Intruder: Bedenim olmadan da bir şekilde hallederim.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507486
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507487
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507488
    m_Localized: 'Intruder: Hım... Ziyaretçilerin dişlerinin kirli olması daha mantıklı olmaz mıydı?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507489
    m_Localized: 'Intruder: Yerin altından geliyorlarsa ağızlarında da toprak vardır muhtemelen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507490
    m_Localized: 'Intruder: Sence neden tırnaklarım kirli?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507491
    m_Localized: 'Intruder: Zorla rüya görmeye çalışıyorum da ondan.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507492
    m_Localized: 'Intruder: Bunu başarabilirsem kendime zarar vermeyi bırakırım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507493
    m_Localized: 'Intruder: Acının bir anlamı kalmaz zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507494
    m_Localized: 'Intruder: Hım... Göz niye kararır ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507495
    m_Localized: 'Intruder: Çok yoruldukları için kurumazlar mı? Aslında buğulanması daha mantıklı olurdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507496
    m_Localized: 'Intruder: Hım... Gözlerim niye kızarmamış ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507497
    m_Localized: 'Intruder: Çok yoruldukları için kurumazlar mı?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507498
    m_Localized: 'Intruder: Çok uzun süredir uyumuyorum. Bu işte bir iş var sanki...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507499
    m_Localized: 'Intruder: Kimsenin böyle değil mi? Garip.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507500
    m_Localized: 'Intruder: Uzun süre uyumadığın zaman bir serinlik geliyor. Bir süre sonra da... bir kuruluk hissi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507501
    m_Localized: 'Intruder: Zaman içinde ateşin yükseliyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507502
    m_Localized: 'Intruder: Giderek kötüleşiyor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507503
    m_Localized: 'Intruder: Bu belirtiyi nereden duydun ki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507504
    m_Localized: 'Intruder: Ha, televizyondan mı? Garip...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507505
    m_Localized: 'Intruder: Yani... Bilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507506
    m_Localized: 'Intruder: Her şeyi anladım da aura ne alaka yani?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507507
    m_Localized: 'Intruder: İnsanları doğaüstü şeylerle iyice kafayı bozdu, korkmaya başlıyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507508
    m_Localized: 'Intruder: Daha doğal şeyleri bile tam çözemedik.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507509
    m_Localized: 'Intruder: Enteresan bir habermiş. Uyku ve gerçeklik arasındaki eşikte...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507510
    m_Localized: 'Intruder: Gerçekten gördüğüne emin misin peki?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507511
    m_Localized: 'Intruder: Belki de rüyaydı?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507512
    m_Localized: 'Intruder: Gerçi öyleyse de seni anlıyorum. Garip...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507513
    m_Localized: 'Intruder: Sırf sana söylenilen bir şey yüzünden başkasını öldürmeye karar verebilmen çok komik.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507514
    m_Localized: 'Intruder: Daha doğrusu korkunç.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507515
    m_Localized: 'Intruder: Deliren bir dünya... Bitti bütün rüya... Ölen bir ben...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507516
    m_Localized: 'Intruder: Veyahut uyuyup giden...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507517
    m_Localized: 'Cultist1: Ölüm, bize tüm soğukluğuyla sarılıp içimizi ısıtacaktır.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507524
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507529
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507534
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507535
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507536
    m_Localized: 'Cultist1: Hazırlanmaktan bıktım.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507539
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507540
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507541
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507544
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507545
    m_Localized: 'Cultist1: Kararın buysa öyle olsun.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507546
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507547
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507550
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507551
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507552
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507555
    m_Localized: 'Cultist1: Henüz vakit gelmedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507558
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507561
    m_Localized: 'Cultist1: Ne istediğine dikkat et.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507564
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507567
    m_Localized: 'Cultist1: Bunun hiçbir manası yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507570
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507573
    m_Localized: 'Cultist1: Söyle bana... Niye bu testlerle kendini yoruyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507574
    m_Localized: 'Cultist1: Vakit geldiğinde yola çıkmaya hazır ol yeter.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507575
    m_Localized: 'Cultist1: Sen neyi bekliyorsun, bilemiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507576
    m_Localized: 'Cultist1: Söyleyeceğim başka bir şey yok.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507577
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507578
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507579
    m_Localized: 'Cultist1: Uzun süredir ölümsüzleştirilmiyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507580
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507581
    m_Localized: 'Cultist1: Yaptıklarının hesabını vereceksin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507582
    m_Localized: 'Cultist1: Büyük bir hata yaptın.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507590
    m_Localized: 'Cultist2: Ee, tabii.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507592
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507593
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507596
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507597
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507602
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507606
    m_Localized: 'Cultist2: ...'
    m_Metadata:
