  - m_Id: 41582931049701403
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701408
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701412
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701413
    m_Localized: 'Cultist3: Akılsızca bir hareket kardeşim. Hem de çok akılsızca.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701414
    m_Localized: 'Cultist3: Derini kül edecekler, Ölüm sana bakmayacak bile.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701415
    m_Localized: 'FatalDame: İçine bir his mi doğdu bebeğim? İnsan olmadığımdan mı korkuyorsun?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701416
    m_Localized: Dişlerine bak
    m_Metadata:
      m_Items: []
  - m_Id: 21377490604032
    m_Localized: 'Firefighter: Et gitsin birader. (öksürür) Benim saklayacak bir şeyim yok. Neyim varsa yandı zaten.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: Bak bakalım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: 'Firefighter: Yalnız (öksürür) dikkat et. Duman solumaktan dişlerim iyice çürüdü.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
