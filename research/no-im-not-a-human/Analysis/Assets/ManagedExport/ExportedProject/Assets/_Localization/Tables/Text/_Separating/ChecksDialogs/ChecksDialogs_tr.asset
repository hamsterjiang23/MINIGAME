  - m_Id: 21377519964312
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964314
    m_Localized: 'Mother: Deodorantım biteli epey oluyor. Rahatsız olmazsın umarım.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964315
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964316
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964318
    m_Localized: 'Mother: Hım... Her zamanki gibi yorgun ve paspal duruyorum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964319
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964320
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964323
    m_Localized: Kendi hâline bırak
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964324
    m_Localized: Silah çek
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964327
    m_Localized: Ateş et
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964328
    m_Localized: Konuşma hakkı ver
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964331
    m_Localized: Ateş et
    m_Metadata:
