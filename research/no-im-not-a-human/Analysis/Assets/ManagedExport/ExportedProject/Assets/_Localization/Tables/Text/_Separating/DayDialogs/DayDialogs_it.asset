%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DayDialogs_it
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: 48f2181e494cb864ca5ca7074da486ff, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22080585977856
    m_Localized: 'Firefighter: Si muore di caldo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560768
    m_Localized: Come ti senti?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560769
    m_Localized: Voglio sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560770
    m_Localized: 'Firefighter: Sembra persino peggio di quanto pensassi. *coff* Dannazione...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560771
    m_Localized: 'Firefighter: Non credo di poter resistere più di una settimana.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560772
    m_Localized: 'Firefighter: Il dolore si è placato un minimo quando mi hai lasciato entrare, comunque. Grazie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560773
    m_Localized: 'Firefighter: Solo che... ora non faccio altro che starmene qui seduto mentre gli altri sono fuori a morire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560774
    m_Localized: 'Firefighter: Forse dovevo restare con loro. Non che abbia molto da perdere. Sono già al capolinea, ormai...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560775
    m_Localized: 'Firefighter: Si muore di caldo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560776
    m_Localized: Perché non sei tornato a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560777
    m_Localized: Voglio sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560778
    m_Localized: 'Firefighter: Ho dei figli che mi aspettano... E non... *coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560779
    m_Localized: 'Firefighter: Non voglio far loro paura.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560780
    m_Localized: 'Firefighter: Non *coff* voglio che mi ricordino così.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560781
    m_Localized: 'Firefighter: Meglio che credano che sia morto nella foresta, mentre... *coff coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560782
    m_Localized: 'Firefighter: Mentre spegnevo un incendio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560783
    m_Localized: 'Firefighter: *coff* Che mi ricordino per la mia pazienza e il mio lavoro coscienzioso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560784
    m_Localized: 'Firefighter: Si muore di caldo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560785
    m_Localized: Dov'è la tua uniforme?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560786
    m_Localized: Voglio sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560787
    m_Localized: 'Firefighter: L''hanno presa i capi. *coff* Non c''è abbastanza equipaggiamento per tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560788
    m_Localized: 'Firefighter: Sempre più colleghi *coff* muoiono sul lavoro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560789
    m_Localized: 'Firefighter: Non facciamo in tempo a estrarre i corpi dalle fiamme. Tutto *coff* viene divorato dal fuoco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560790
    m_Localized: 'Firefighter: Ma i capi... Loro si preoccupano di una *coff* cazzo di uniforme...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560791
    m_Localized: 'Firefighter: Forgiano decreti come fossero ferri da cavallo. Nemmeno uno a favore del popolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560792
    m_Localized: 'Firefighter: Si muore di caldo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560793
    m_Localized: Da dove ha avuto origine l'incendio nella foresta?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560794
    m_Localized: Voglio sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560795
    m_Localized: 'Firefighter: Gli alberi sono molto secchi, di recente. Prendono *coff* fuoco facilmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560796
    m_Localized: 'Firefighter: Gli incendi sono solo una *coff* delle sventure che ci hanno colpito, come quei Visitatori emersi dal sottosuolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560797
    m_Localized: 'Firefighter: Ma il destino ne ha in serbo altre...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560798
    m_Localized: 'Firefighter: Forse siamo già spacciati, possiamo solo sperare in una dolce morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560799
    m_Localized: 'Firefighter: Sai... *coff* Avevo pensato di portarla a casa come regalo. Ma voglio darla a te.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560800
    m_Localized: 'Firefighter: È una collana. Non sembra granché, lo ammetto, però...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560801
    m_Localized: 'Firefighter: È fatta con le api morte che un tempo tramutavano il miele in sole.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560802
    m_Localized: 'Firefighter: Si muore di caldo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560803
    m_Localized: Hai un aspetto orribile.
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560804
    m_Localized: Voglio sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560805
    m_Localized: 'Firefighter: Credo... Credo sia giunta la mia ora... *coff coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560806
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560807
    m_Localized: 'Firefighter: Perché non sono rimasto? Avrei potuto salvarne un paio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560808
    m_Localized: 'Firefighter: Avrei potuto stringere i denti... lavorare fino a crollare. Così non avrebbero dovuto mandare quegli agnelli al macello.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560809
    m_Localized: 'Firefighter: CAPI *coff* DEL CAZZO! *coff coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560810
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560811
    m_Localized: 'Firefighter: Che... tristezza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560812
    m_Localized: 'Firefighter: Mi concedi un''ultima sigaretta?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560813
    m_Localized: Porgine una (offrigli una sigaretta).
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560814
    m_Localized: 'Firefighter: Non è che avresti una sigaretta, per caso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560815
    m_Localized: No, mi spiace (rifiutagli la sigaretta).
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560816
    m_Localized: 'Firefighter: L''ultimo chiodo sulla bara, come si dice. *coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560817
    m_Localized: 'Firefighter: (L''uomo estrae un accendino da una tasca, accende la sigaretta e inizia a fumare)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560818
    m_Localized: 'Firefighter: (Fa un lungo tiro, si appoggia con la schiena al muro, e dopo una breve pausa, riprende)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560819
    m_Localized: 'Firefighter: Se solo potessi tornare dai ragazzi. Potremmo fumare, chiacchierare di...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560820
    m_Localized: 'Firefighter: *coff coff* *coff coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560821
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560822
    m_Localized: 'Firefighter: Non fumi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560823
    m_Localized: 'Firefighter: Lo so, lo so. "Un pompiere che fuma?". *coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560824
    m_Localized: 'Firefighter: Che differenza vuoi che faccia, ormai?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560825
    m_Localized: 'Firefighter: Volevo solo *coff* rilassarmi un attimo prima di morire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560826
    m_Localized: 'Firefighter: (L''uomo si appoggia con la schiena al muro, fissando il soffitto mentre parla)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560827
    m_Localized: 'Firefighter: Come ho fatto a ritrovarmi pompiere? Mia madre voleva che lavorassi in fabbrica.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560828
    m_Localized: 'Firefighter: Non è giusto che un pompiere svanisca come il fum...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560829
    m_Localized: 'Firefighter: *coff coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560830
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560831
    m_Localized: 'Wheelchair: Muovermi libero, magari potessi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560832
    m_Localized: Cosa stai guardando?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560833
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560834
    m_Localized: 'Wheelchair: C''è questo mio amico, sai... Ci conosciamo da quando eravamo bambini.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560835
    m_Localized: 'Wheelchair: Ha avuto un incidente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560836
    m_Localized: 'Wheelchair: L''avevano assunto per scavare qualcosa in montagna.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560837
    m_Localized: 'Wheelchair: Non conosco i dettagli. E non me ne frega niente, onestamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755072
    m_Localized: 'Wheelchair: Ma poi si è stirato la schiena! È rimasto immobile per giorni!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755073
    m_Localized: 'Wheelchair: Si era spaccato le ossa su quelle montagne...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755074
    m_Localized: 'Wheelchair: E i gabbiani hanno scambiato... la sua schiena... Ehm...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755075
    m_Localized: 'Wheelchair: Ok, il suo culo. HANNO SCAMBIATO IL SUO CULO PER UN NIDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755076
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755077
    m_Localized: 'Wheelchair: AH AH AH AH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755078
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755079
    m_Localized: 'Wheelchair: Scusami tanto, sono le voci che ho nella testa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755080
    m_Localized: 'Wheelchair: Mi hanno raccontato una barzelletta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755081
    m_Localized: 'Wheelchair: Muovermi libero, magari potessi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755082
    m_Localized: Ehm... Va tutto bene?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755083
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755084
    m_Localized: 'Wheelchair: Sì, sto solo aspettando che mi ricrescano le gambe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755085
    m_Localized: 'Wheelchair: Guarda, la destra ha già iniziato.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755086
    m_Localized: 'Wheelchair: Quindi mi tratterrò qui ancora un po''.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755087
    m_Localized: Mi riferivo alle voci nella testa.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755088
    m_Localized: Ok...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755089
    m_Localized: 'Wheelchair: Perché non ridi? Andiamo, faceva morire!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755090
    m_Localized: 'Wheelchair: Pensavo che l''avresti capita subito.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755091
    m_Localized: 'Wheelchair: Forse non ti è arrivata...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755092
    m_Localized: 'Wheelchair: Mi hai chiesto come sto?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755093
    m_Localized: 'Wheelchair: Grazie, sei molto gentile!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755094
    m_Localized: 'Wheelchair: Nessuno mi chiede mai come sto, o come mi è andata la giornata.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755095
    m_Localized: 'Wheelchair: È perché ho ruote degne di un bolide da corsa al posto delle mie vecchie e noiose gambe? È tutta invidia?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755096
    m_Localized: 'Wheelchair: Nessuno risponde onestamente. È quello il problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755097
    m_Localized: 'Wheelchair: Cominciano ad accampare scuse, dicono di aver solo sbirciato involontariamente. Bla bla bla...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755098
    m_Localized: 'Wheelchair: Non sopporto nemmeno quando mi fissano in silenzio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755099
    m_Localized: 'Wheelchair: Ignorare la mia disabilità è stupido. Voglio dire, è evidente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755100
    m_Localized: 'Wheelchair: Insomma, dobbiamo ritrovare il senso delle sfumature.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755101
    m_Localized: 'Wheelchair: Ma quella è merce rarissima, di questi tempi. Ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755102
    m_Localized: 'Wheelchair: Hai mai provato a immaginare cosa si prova ad andare a spasso su quattro ruote?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755103
    m_Localized: 'Wheelchair: Cazzo, mi sono espresso male...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755104
    m_Localized: 'Wheelchair: Senza le gambe, intendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755105
    m_Localized: 'Wheelchair: ESATTO. Non riusciresti nemmeno a uscire di casa!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755106
    m_Localized: 'Wheelchair: Come faresti con le scale? E per attraversare la strada?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755107
    m_Localized: 'Wheelchair: Dai, quei cazzo di marciapiedi hanno più gobbe di una mandria di cammelli!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755108
    m_Localized: 'Wheelchair: A casa tua non ci sono scale o gradini, quindi posso muovermi facilmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755109
    m_Localized: 'Wheelchair: Ma sai, c''è ancora una cosa di cui sento la mancanza...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755110
    m_Localized: 'Wheelchair: Una collina!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755111
    m_Localized: 'Wheelchair: Immagina! Gare di discesa in carrozzina! Fino a schiantarsi. Ah! Ma pazienza...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755112
    m_Localized: 'Wheelchair: Accidenti, non mi capacito che tu non mi abbia ancora fornito i mezzi per vivere il brivido della velocità a casa tua.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755113
    m_Localized: 'Wheelchair: Oh, giusto, mi avevi chiesto come stavo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755114
    m_Localized: 'Wheelchair: Non male. Grazie per l''interessamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755115
    m_Localized: 'Wheelchair: Muovermi libero, magari potessi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755116
    m_Localized: Hai preso un'insolazione?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755117
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755118
    m_Localized: 'Wheelchair: Questo cosa c''entra, scusa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755119
    m_Localized: 'Wheelchair: Non ho i capelli bruciati e non mi sono ancora caduti. Direi che sto bene!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755120
    m_Localized: 'Wheelchair: Non posso correre in carrozzina senza le gambe. Vedi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755121
    m_Localized: 'Wheelchair: Come farei a rallentare a velocità sfrenata? O a stringere le curve?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755122
    m_Localized: 'Wheelchair: Ma non mi aspetto che tu capisca, non sei costretto su una carrozzina.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755123
    m_Localized: Ci credi sul serio?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755124
    m_Localized: Pensi sul serio che ti ricresceranno le gambe?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755125
    m_Localized: 'Wheelchair: Certo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755126
    m_Localized: 'Wheelchair: Sai come si dice.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755127
    m_Localized: 'Wheelchair: La gamba destra fa passi più lunghi. Per questo giriamo tutti in tondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755128
    m_Localized: 'Wheelchair: Guarda, le mie gambe lo dimostrano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755129
    m_Localized: 'Wheelchair: Fa lo stesso. Non c''è via di uscita.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755130
    m_Localized: 'Wheelchair: Finisce un giorno e ne comincia un altro. Ma quando il sole sorge, è davvero cambiato qualcosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755131
    m_Localized: 'Wheelchair: No, cazzo. È solo un altro giro su questa giostra di merda!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755132
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755133
    m_Localized: 'Wheelchair: Quindi, se ci pensi, sei davvero diverso da me?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755134
    m_Localized: 'Wheelchair: Stiamo entrambi girando in tondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755135
    m_Localized: 'Wheelchair: Guarda, il mondo in cui viviamo è pieno di meraviglie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755136
    m_Localized: 'Wheelchair: Certo, finora ne abbiamo viste solo di orribili. MA...!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755137
    m_Localized: 'Wheelchair: Gli orrori non dureranno in eterno. Cederanno il posto a una magnifica gioia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755138
    m_Localized: 'Wheelchair: Dio ha già perdonato un mucchio di peccatori. Magari ha in serbo un futuro migliore anche per noi, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755139
    m_Localized: 'Wheelchair: Muovermi libero, magari potessi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755140
    m_Localized: Come hai perso le gambe?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755141
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755142
    m_Localized: 'Wheelchair: Ricordi l''amico sulla montagna di cui ti avevo parlato? Quello con il culo a forma di nido? AH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755143
    m_Localized: 'Wheelchair: Beh... Un giorno ha deciso di scavare una trincea nel suo cortile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755144
    m_Localized: 'Wheelchair: Si era convinto che sotto casa sua corresse un tunnel pieno di carne.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755145
    m_Localized: 'Wheelchair: Allora ha ordinato una grossa trivella.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755146
    m_Localized: 'Wheelchair: E si è messo a scavare...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755147
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755148
    m_Localized: 'Wheelchair: Accidenti...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755149
    m_Localized: 'Wheelchair: Non l''ho più visto da allora.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755150
    m_Localized: 'Wheelchair: Muovermi libero, magari potessi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755151
    m_Localized: Sì, ma cosa è successo alle tue gambe?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755152
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755153
    m_Localized: 'Wheelchair: Fanculo le mie gambe! Non vuoi sapere anche tu se i suoi scavi hanno avuto successo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755154
    m_Localized: Ok, lasciamo stare.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755155
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755156
    m_Localized: 'Wheelchair: Uhm... Sì, esatto! Mi sono scordato di lui e sono andato a prendermi una birra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755157
    m_Localized: 'Wheelchair: Ma sono inciampato sui binari e un tram mi ha tranciato via le gambe!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755158
    m_Localized: 'Wheelchair: Aspetta...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755159
    m_Localized: 'Wheelchair: No, non è andata così.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755160
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755161
    m_Localized: 'Wheelchair: Perché non parli? Non ti interessa scoprire come ho perso le gambe?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755162
    m_Localized: 'Wheelchair: Beh, tanto non te lo dico. Perché annoiarti con i dettagli?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755163
    m_Localized: 'Mother: Qui dentro non si respira...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755164
    m_Localized: Non avevi una bambina con te?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755165
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755166
    m_Localized: 'Mother: Eh? È qui in giro. Sarà andata a bighellonare da qualche parte...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755167
    m_Localized: 'Mother: Devo scoprire dove sono finiti gli altri miei figli...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755168
    m_Localized: 'Mother: Hai un telefono? Potrei chiamare il padre. Così mi eviterei di rivedere quel suo brutto muso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755169
    m_Localized: 'Mother: Qui dentro non si respira...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755170
    m_Localized: Hai chiamato tuo marito?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755171
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755172
    m_Localized: 'Mother: Perché dovrei? Accamperebbe le solite scuse. Non ha mai mosso un dito, pensavo a tutto io: ai figli, alla casa, alle bollette.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755173
    m_Localized: 'Mother: A volte penso che ci limitavamo a sopportarci. Ma non mi ha mai lasciata, per qualche motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755174
    m_Localized: 'Mother: Forse gli conveniva così. O forse temeva che lo avrei sgozzato se ci avesse provato.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755175
    m_Localized: 'Mother: Dio, sono stanca...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755176
    m_Localized: 'Mother: Qui dentro non si respira...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755177
    m_Localized: Non dovresti andare da tuo marito?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755178
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755179
    m_Localized: 'Mother: Riesco a stento ad alzarmi dal letto! Mi fa male tutto, sono esausta. Inizio a credere di essere viva solo per ripicca.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755180
    m_Localized: 'Mother: Era tutto sulle mie spalle. I figli, mio marito, l''intera casa. Ma a volte certi suoi gesti rendevano le cose quasi tollerabili.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755181
    m_Localized: 'Mother: Possiamo riparlarne? Ho bisogno di riposo, mi sento sull''orlo di uno svenimento.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755182
    m_Localized: 'Mother: Qui dentro non si respira...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755183
    m_Localized: Di quali gesti parlavi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755184
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755185
    m_Localized: 'Mother: Ricordo quella volta...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755186
    m_Localized: 'Mother: Portava a spasso questa tizia in auto. Sapevo cosa c''era sotto. In principio non ho detto niente, ma poi non ce l''ho fatta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755187
    m_Localized: 'Mother: L''ho assillato talmente tanto... che ha cambiato lavoro per non poterla più vedere. Forse mi amava sul serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755188
    m_Localized: 'Mother: O forse mi sono immaginata tutto... Sia come sia, devo riposare. Ne riparliamo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755189
    m_Localized: 'Mother: Qui dentro non si respira...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755190
    m_Localized: Non sei preoccupata per i tuoi figli?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755191
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755192
    m_Localized: 'Mother: Uhm... Forse meno di quanto dovrei. Alla prima gravidanza... non avevo idea di cosa stessi facendo. È stato un disastro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755193
    m_Localized: 'Mother: La seconda volta, ero convinta di aver capito tutto. Ma è finita allo stesso modo. E così alla terza, e alla quarta...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755194
    m_Localized: 'Mother: I dottori mi avevano detto che non potevo avere figli. Quando è nato il secondo, l''ho chiamato Ottava meraviglia del mondo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755195
    m_Localized: 'Mother: Ma poi... le cose sono peggiorate. È stato orribile...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755196
    m_Localized: 'Mother: Devo... Devo andare a dormire...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755197
    m_Localized: 'Mother: Qui dentro non si respira...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755198
    m_Localized: Cosa è stato orribile?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755199
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755200
    m_Localized: 'Mother: Non è facile parlarne, per me. Li amo, ma... a volte perdo le staffe. Allora urlo... e arrivo ad alzare le mani.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755201
    m_Localized: 'Mother: So che è orribile, e me ne pento. Sul serio... Ma sai... Ora, per la prima volta, mi sembra tutto più facile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755202
    m_Localized: 'Mother: Senza averli intorno, sento di poter respirare... Odio ammetterlo, ma sono finalmente... felice.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755203
    m_Localized: 'Anger: Che cazzo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755204
    m_Localized: Beh? Ti sei calmato?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755205
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755206
    m_Localized: 'Anger: Sì, mi passa in fretta. Ma al primo fastidio che mi sfiora la mente mi saltano di nuovo i nervi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755207
    m_Localized: 'Anger: Un tempo ero più tranquillo. Offendermi o infastidirmi era difficile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755208
    m_Localized: 'Anger: Ora basta la minima scintilla per farmi esplodere.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755209
    m_Localized: 'Anger: E perché dovrei calmarmi, poi? Magari è proprio la rabbia a non farmi impazzire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755210
    m_Localized: 'Anger: Almeno non mi metto a venerare il "sole onnipotente" come quella manica di coglioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755211
    m_Localized: 'Anger: Pensano che il sole ci salverà? Ma non diciamo cazzate! Ci sta uccidendo, porca puttana!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755212
    m_Localized: 'Anger: Per come la vedo io, siamo tutti sull''orlo del baratro, merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755213
    m_Localized: 'Anger: Ma secondo te lo capiscono, quegli imbecilli? Sì, col cazzo! Ok... Sto bene, sono calmo. Mi è passata.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755214
    m_Localized: 'Anger: Grazie di avermi ascoltato.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755215
    m_Localized: 'Anger: Che cazzo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755216
    m_Localized: Da dove viene tutta questa rabbia?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755217
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755218
    m_Localized: 'Anger: Eh, non te lo so dire nemmeno io.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755219
    m_Localized: 'Anger: Tutto mi dà sui nervi, ormai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755220
    m_Localized: 'Anger: Specialmente i cultisti, quei fottuti stronzi contaballe. A loro interessa solo infinocchiare più polli possibile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755221
    m_Localized: 'Anger: E la gente si beve le loro bufale come porci che grufolano nel trogolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755222
    m_Localized: 'Anger: Ho visto poveracci disposti a togliere il pane dalla bocca dei figli per pagare il tributo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755223
    m_Localized: 'Anger: E tutto questo per compiacere un merdoso salvatore che viene da chi cazzo sa dove.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755224
    m_Localized: 'Anger: Bastardi squilibrati. Fanno il lavaggio del cervello alle persone normali con le loro sciocchezze... Come a mia...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755225
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755226
    m_Localized: 'Anger: Mi sono calmato, comunque. Ora mi sento meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755227
    m_Localized: 'Anger: Che cazzo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755228
    m_Localized: I cultisti ti hanno portato via qualcuno?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755229
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755230
    m_Localized: 'Anger: No, è quello il punto. È andata da loro di sua iniziativa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755231
    m_Localized: 'Anger: Mia moglie, intendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755232
    m_Localized: 'Anger: Era sempre stata una persona religiosa, anche prima di questo schifo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755233
    m_Localized: 'Anger: A me non importava, perché l''amavo. Non aveva mai creato tensioni tra di noi, in fondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755234
    m_Localized: 'Anger: Ma quando la merda ci ha sommersi, ha trovato una nuova fede e un nuovo salvatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755235
    m_Localized: 'Anger: L''insensata retorica dei cultisti le è sembrata plausibile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755236
    m_Localized: 'Anger: Giorno dopo giorno, c''è finita sempre più dentro, ha perso la testa. Ha iniziato a credere a quelle stronzate senza senso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755237
    m_Localized: 'Anger: Quando mi sono reso conto di cosa avessi fatto, lei già non c''era. L''avevo spaventata. Era troppo tardi per rimediare.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755238
    m_Localized: 'Anger: Che cazzo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755239
    m_Localized: Cosa è successo tra te e tua moglie?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755240
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755241
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755242
    m_Localized: 'Anger: Un giorno, mia moglie mi ha detto che voleva unirsi alla setta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755243
    m_Localized: 'Anger: Io... non riuscivo a crederci. La donna che amavo... era diventata una persona completamente diversa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755244
    m_Localized: 'Anger: Come se la nostra vita insieme non avesse più alcun valore... Ero furioso, più di quanto lo fossi mai stato.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755245
    m_Localized: 'Anger: Ho iniziato a dubitare del suo amore... Cercava solo un''occasione per liberarsi di me, cazzo. Mi dava il voltastomaco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755246
    m_Localized: 'Anger: È stato come se le mie mani avessero vita propria. Si sono chiuse a pugno, e ciò che è seguito... non potrò mai perdonarmelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755247
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755248
    m_Localized: 'Anger: L''ho colpita...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755249
    m_Localized: 'Anger: Non c''è più nulla da fare, ormai. Lei è con la setta e io...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755250
    m_Localized: 'Anger: Io resterò a tormentarmi in eterno...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755251
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755252
    m_Localized: 'Anger: CAZZO, MI FACCIO SCHIFO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755253
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755254
    m_Localized: 'Anger: Sono io che dovrei soffrire, non chi mi circonda. Me lo merito.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755255
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755256
    m_Localized: 'Anger: Lasciami. Voglio stare da solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755257
    m_Localized: 'FortuneTeller: Eh? Vuoi una lettura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755258
    m_Localized: Come fai a sapere tante cose di me?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755259
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755260
    m_Localized: 'FortuneTeller: Ah! Che domanda sciocca... Non sono io a saperle, sono un mero ricettacolo. Mi faccio portavoce delle stelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755261
    m_Localized: 'FortuneTeller: La Luna e Venere sono in congiunzione nella Sesta Casa. Te lo leggo sul volto. Non serve che parli.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755262
    m_Localized: 'FortuneTeller: Conoscevo un altro come te. Ascoltava sempre, ma non parlava mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755263
    m_Localized: 'FortuneTeller: Sai come si dice: quando Giove è nell''Ottava Casa, il silenzio è d''oro. Simboleggia una porta chiusa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755264
    m_Localized: 'FortuneTeller: Eh? Vuoi una lettura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755265
    m_Localized: Cosa è successo a quell'uomo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755266
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755267
    m_Localized: 'FortuneTeller: Gli ho detto: "Le tue azioni non contano, conta solo il colore della tua aura mentre le compi". Ma non ci ha creduto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755268
    m_Localized: 'FortuneTeller: Così ha sprecato la sua vita.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755269
    m_Localized: 'FortuneTeller: Un giorno ho chiuso gli occhi e ho visualizzato la realizzazione dei miei sogni.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755270
    m_Localized: 'FortuneTeller: Ho proiettato tutta la mia energia cosmica in quell''immagine.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755271
    m_Localized: 'FortuneTeller: Se non si apre il cuore all''energia dell''universo, a cosa serve vivere in un corpo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755272
    m_Localized: 'FortuneTeller: Potresti riuscirci anche tu. Chiudi gli occhi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755273
    m_Localized: 'FortuneTeller: Immagina che i tuoi sogni più sfrenati si siano avverati...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755274
    m_Localized: 'FortuneTeller: Concentrati sulla visione...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755275
    m_Localized: 'FortuneTeller: Sai perché soffri? Non hai ancora compreso che la sofferenza è la forma più pura di gioia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755276
    m_Localized: 'FortuneTeller: Dimmi, allora... Sei pronto a compiere il passo successivo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755277
    m_Localized: 'FortuneTeller: Eh? Vuoi una lettura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755278
    m_Localized: Quale sarebbe il "passo successivo"?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755279
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755280
    m_Localized: 'FortuneTeller: Scegliere te stesso. Lo senti? È il putrido tanfo dei tuoi sogni ormai morti. È il momento di resuscitarli.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755281
    m_Localized: 'FortuneTeller: Nel mio momento più buio, senza luce né scopo, la mia mentore mi disse: "Non stai ascoltando il tuo oceano".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755282
    m_Localized: 'FortuneTeller: Sul momento scoppiai a ridere, ma poi chiusi gli occhi e lo sentii. Come se ci fosse sempre stato. E puoi sentirlo anche tu!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755283
    m_Localized: 'FortuneTeller: Ma prima è necessario rispondere a una domanda precisa: sei pronto a diventare tutt''uno con te stesso?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755284
    m_Localized: 'FortuneTeller: Eh? Vuoi una lettura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755285
    m_Localized: Chi era la tua mentore?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755286
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755287
    m_Localized: 'FortuneTeller: Una donna eccezionale. Il mio faro nella tempesta. La luce che mi ha insegnato a riconoscere l''essenza delle cose.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755288
    m_Localized: 'FortuneTeller: Non dimenticherò mai le sue parole: "Le persone muoiono perché non imparano a respirare la propria luce interiore".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755289
    m_Localized: 'FortuneTeller: Mi aprì gli occhi. Fu allora che compresi di poter assistere gli altri nel loro percorso personale.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755290
    m_Localized: 'FortuneTeller: Tuttavia, beh... lei aveva paura di spingersi oltre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755291
    m_Localized: 'FortuneTeller: Non riusciva a immaginarsi al centro delle cose. Eppure, quello è il luogo più importante in cui trovarsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755292
    m_Localized: 'FortuneTeller: Se non sei al centro del tuo universo, chi altri può esserlo? Lo capisci, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755293
    m_Localized: 'FortuneTeller: Eh? Vuoi una lettura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755294
    m_Localized: Come hai aiutato te stessa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755295
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755296
    m_Localized: 'FortuneTeller: Ogni errore che commettiamo non è che un codice da decifrare all''interno del nostro universo interiore.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755297
    m_Localized: 'FortuneTeller: Ho intrapreso un viaggio lungo e tortuoso. Ho guardato avanti e indietro. Osserva come questa casa ha reagito alla mia presenza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755298
    m_Localized: 'FortuneTeller: Luminosa, spaziosa, in armonia con la mia energia. Non c''è bisogno che tu combatta contro la tua stessa casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755299
    m_Localized: 'FortuneTeller: Ha già assorbito la tua paura, non vedi? Accettalo, o le pareti piangeranno. Ma le lacrime saranno le tue.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755300
    m_Localized: 'FortuneTeller: Eh? Vuoi una lettura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755301
    m_Localized: Cosa vuoi da me?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755302
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755303
    m_Localized: 'FortuneTeller: Oh, cielo, pensi che voglia qualcosa da te?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755304
    m_Localized: 'FortuneTeller: Potresti scoprire dov''è celata la tua strada, se solo vedessi danzare la tua ombra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755305
    m_Localized: 'FortuneTeller: Devi solo affermare la tua gioia. Senti anche tu che tutto sta cambiando, vero? Respirare è più facile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755306
    m_Localized: 'FortuneTeller: È la mia energia che reagisce al tuo spazio. Non cercare significati reconditi. Abbandona l''illusione, abbraccia il caos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755307
    m_Localized: 'FortuneTeller: Ti sto solo chiedendo di unirti a me. Diventa lo spazio. Ripeti: "Non sono un ospite, sono l''autore di questo santuario".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755308
    m_Localized: 'FortuneTeller: Eh? Vuoi una lettura?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755309
    m_Localized: E se non volessi essere autore di niente?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755310
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755311
    m_Localized: 'FortuneTeller: Queste pareti bramano di cingerti, eppure le vincoli con le catene della tua autorità.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755312
    m_Localized: 'FortuneTeller: Il silenzio che hai dentro è la voce del mondo che soffochi con la tua paura.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755313
    m_Localized: 'FortuneTeller: La tua energia è congelata come il miele d''inverno. Devi scioglierla con il respiro. Gli specchi non mentono.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755314
    m_Localized: 'FortuneTeller: Se non vedi altro che te stesso, non vedi nulla. Ti basta ruotare la tua energia di tre gradi in senso orario.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755315
    m_Localized: 'FortuneTeller: Solo così riuscirai finalmente a trovare la gioia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755316
    m_Localized: 'Fanatic: Ti ascolto, umano. Parla!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755317
    m_Localized: Sei membro di qualche religione?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755318
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755319
    m_Localized: 'Fanatic: SÌ, UMANO! Ma la mia fede non ha nulla a che spartire con le patetiche religioni che conosci.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755320
    m_Localized: 'Fanatic: Io venero IL SOLE STESSO! PERCHÉ CI AMA E CI PROTEGGE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755321
    m_Localized: 'Fanatic: Ma le pecore e gli inetti lo considerano una minaccia. Temono che ci "incenerisca tutti".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755322
    m_Localized: 'Fanatic: STRONZATE! La sua ira funesta colpisce soltanto i semi del MALE e gli ERETICI! Sono costoro i veri peccatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755323
    m_Localized: 'Fanatic: Coloro che dissentono devono sperare di non trovarsi mai esposti ai suoi roventi raggi salvifici!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755324
    m_Localized: 'Fanatic: Anelano le fiamme, eppure si stupiscono quando ne vengono arsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755325
    m_Localized: Semi del male?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755326
    m_Localized: Eretici?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755327
    m_Localized: 'Fanatic: Non lo sai? Non hai ancora incontrato GLI ALIENI?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755328
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755329
    m_Localized: 'Fanatic: Molto bene, umano che brancoli al buio. Dischiuderò i tuoi occhi alla VERITÀ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755330
    m_Localized: 'Fanatic: I VISITATORI SONO I SEMI DEL MALE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755331
    m_Localized: 'Fanatic: DISCENDONO DA ALIENI giunti sulla Terra quando il Sole era ancora giovane e l''erba più verde!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755332
    m_Localized: 'Fanatic: LURIDI VASSALLI che hanno vissuto sulla Terra per SECOLI, accoppiandosi incestuosamente!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755333
    m_Localized: 'Fanatic: E ora sono riemersi dagli abissi per reclamare come propria LA NOSTRA TERRA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755334
    m_Localized: 'Fanatic: Ma il SOLE ha scelto di proteggerci, perché questo è il NOSTRO SUOLO SACRO.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755335
    m_Localized: 'Fanatic: Il Sole non HA PIETÀ per gli empi! Perché credi che si siano nascosti sottoterra per tutto questo tempo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755336
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755337
    m_Localized: 'Fanatic: Accidenti... Perché ti sei sbronzato, quella notte?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755338
    m_Localized: 'Fanatic: Non avresti dovuto affogare i dispiaceri nel bicchiere. L''ira funesta del sacro Sole...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755339
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755340
    m_Localized: 'Fanatic: O SACRO SOLE, perdona i suoi peccati, egli non sa quello che fa!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755341
    m_Localized: 'Fanatic: Accoglilo nel tuo amorevole abbraccio. E con lui anche l''anima del ficus, il cui terriccio è destinato all''eterna siccità...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755342
    m_Localized: 'Fanatic: Amen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755343
    m_Localized: 'Fanatic: Hai sentito bene, umano!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755344
    m_Localized: 'Fanatic: La FEMA non è che un branco di ERETICI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755345
    m_Localized: 'Fanatic: Interferiscono con questioni che trascendono il nostro controllo... il controllo della GENTE NORMALE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949376
    m_Localized: 'Fanatic: Ficcano il naso dove non dovrebbero.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949377
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949378
    m_Localized: 'Fanatic: Che il Sole incenerisca gli stronzi servi del buio che hanno spinto mia madre in quella pozzanghera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949379
    m_Localized: 'Fanatic: Ti ascolto, umano. Parla!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949380
    m_Localized: Beh, il sole ha bruciato un mucchio di persone.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949381
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949382
    m_Localized: 'Fanatic: Hai ragione. Ma erano semi del male, umano!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949383
    m_Localized: 'Fanatic: Il sacro Sole ha deciso di punirli TUTTI per i peccati di MILLENNI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949384
    m_Localized: 'Fanatic: E I VISITATORI, QUEGLI EMPI INVASATI D''OMBRA hanno preso a protendersi verso il SOLE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949385
    m_Localized: 'Fanatic: Ma il SOLE non gli appartiene! No! Rifugge le grinfie di quei luridi abitanti del sottosuolo... Appartiene a noi UMANI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949386
    m_Localized: 'Fanatic: IL SOLE È NOSTRO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949387
    m_Localized: 'Fanatic: HA BENEDETTO L''UMANITÀ, E SEMPRE SIA LODATO, CAZZO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949388
    m_Localized: Quante altre persone dovranno bruciare prima che il sole sia soddisfatto?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949389
    m_Localized: Stai dicendo che la fine del mondo è il giudizio divino del sole?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949390
    m_Localized: 'Fanatic: Molte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949391
    m_Localized: 'Fanatic: E credimi, amico mio, LA FINE È ANCORA LONTANA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949392
    m_Localized: 'Fanatic: QUESTO È SOLO L''INIZIO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949393
    m_Localized: 'Fanatic: Il peso delle nostre ceneri sulla BILANCIA DEL PECCATO non ha ancora compensato le FORZE DELL''UNIVERSO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949394
    m_Localized: 'Fanatic: ALTRI DOVRANNO ARDERE nelle fiamme purificatrici del SOLE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949395
    m_Localized: 'Fanatic: Ma sappi questo, amico: i martiri non periranno invano!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949396
    m_Localized: 'Fanatic: Un giorno comprenderemo il vero piano del Sole...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949397
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949398
    m_Localized: 'Fanatic: Dannazione... A volte, di notte, mi sento come se mia moglie mi avesse lasciato di nuovo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949399
    m_Localized: 'Fanatic: Era una donna tanto pia...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949400
    m_Localized: 'Fanatic: Ma anche una grandissima stronza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949401
    m_Localized: 'Fanatic: La fine di chi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949402
    m_Localized: 'Fanatic: Nostra?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949403
    m_Localized: 'Fanatic: Ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949404
    m_Localized: 'Fanatic: Non farmi ridere. IL SOLE È NOSTRO ALLEATO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949405
    m_Localized: 'Fanatic: È il nostro salvatore, non lo vedi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949406
    m_Localized: 'Fanatic: Vuole rispedire i Visitatori sottoterra...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949407
    m_Localized: 'Fanatic: Sta punendo quegli empi miserabili per tutti i peccati accumulati dall''umanità...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949408
    m_Localized: 'Fanatic: Svela gli eretici nascosti dietro maschere ingannevoli, coperti di stracci che puzzano di piscio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949409
    m_Localized: 'Fanatic: Dovremmo essere grati al Sole, invece di piagnucolare come poppanti per la "fine del mondo".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949410
    m_Localized: 'Fanatic: È LA FINE SOLTANTO PER I NEMICI DEL SOLE ONNIPOTENTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949411
    m_Localized: 'Fanatic: MORTE AGLI ABITANTI DEL SOTTOSUOLO! MORTE AGLI ERETICI SPORCHI DI MERDA! MORTE AI SEMI DEL MALE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949412
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949413
    m_Localized: 'Fanatic: Cavolo, cosa non darei per delle patatine fritte...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949414
    m_Localized: 'Fanatic: Ti ascolto, umano. Parla!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949415
    m_Localized: Pensi che quanto sta accadendo segua un disegno divino?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949416
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949417
    m_Localized: 'Fanatic: Dimmi, umano... Perché perdo tempo a spiegarti le cose, imboccandoti ogni minimo dettaglio...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949418
    m_Localized: 'Fanatic: Se poi vieni A RIPETERMI LE STESSE CAZZO DI DOMANDE?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949419
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949420
    m_Localized: 'Fanatic: Forse mi sono sbagliato con te. Sei troppo schiavo del buio... Non riesci a discernere il cuore degli accadimenti...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949421
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949422
    m_Localized: 'Fanatic: Cazzo, ucciderei per una birretta...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949423
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949424
    m_Localized: 'Fanatic: Hai forse un''offerta alcolica per me, umano?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949425
    m_Localized: Certo, prendi (offrigli una birra).
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949426
    m_Localized: 'Fanatic: Non ne hai? Mi hai preso per un idiota, umano?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949427
    m_Localized: 'Fanatic: Ho guardato dentro al tuo frigo CON I MIEI OCCHI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949428
    m_Localized: 'Fanatic: Andiamo, umano. Vorresti scolarti tutte quelle birre senza condividere nemmeno una misera lattina?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949429
    m_Localized: No (rifiutagli la birra).
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949430
    m_Localized: 'Fanatic: Ah, sia ringraziato il Sole...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949431
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949432
    m_Localized: 'Fanatic: Uhm, è roba buona. Lager scura, la mia preferita.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949433
    m_Localized: 'Fanatic: Mi riporta a quando andavo al bar con gli amici.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949434
    m_Localized: 'Fanatic: Belle chiacchierate, pinte gelate, spuntini e salse...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949435
    m_Localized: 'Fanatic: E il viso torvo di quel tizio macilento che ci fissava sempre con disapprovazione...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949436
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949437
    m_Localized: 'Fanatic: Beh, non c''è motivo di arrabbiarsi. Sarai anche stupido, umano, ma almeno sei gentile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949438
    m_Localized: 'Fanatic: Voglio donarti un piccolo pegno di gratitudine. Ecco, prendi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949439
    m_Localized: 'Fanatic: Che il sacro Sole abbia pietà della tua anima!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949440
    m_Localized: 'Fanatic: ABIETTO DEMONIO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949441
    m_Localized: 'Fanatic: CHE TU POSSA BRUCIARE ALL''INFERNO, FIGLIO DI PUTTANA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949442
    m_Localized: 'Fanatic: Che ingratitudine! Ti ho introdotto ai sacri precetti, al senso ultimo dei recenti accadimenti, e tu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949443
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949444
    m_Localized: 'Fanatic: Tu sei uno SCIOCCO, umano! E anche MALVAGIO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949445
    m_Localized: 'Fanatic: Fottiti. Marcisci pure in questa stamberga, non mi importa! Me ne vado in un posto migliore.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949446
    m_Localized: 'Fanatic: Vedrai. Scommetto che al bar mi accoglieranno a braccia aperte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949447
    m_Localized: 'Fanatic: Buon proseguimento di vita, cretino.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949448
    m_Localized: 'Anxiety: Eh, eh eh... Spero che tutto si risolva presto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949449
    m_Localized: Come hai perso la casa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949450
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949451
    m_Localized: 'Anxiety: Ah, lo ricordo come se fosse ieri...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949452
    m_Localized: 'Anxiety: Ero appena stata licenziata. Volevo solo andarmene a casa, infilarmi a letto e piangere a dirotto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949453
    m_Localized: 'Anxiety: Ma fuori dalla porta c''erano degli stivali. Ho pensato che la mia coinquilina avesse invitato degli amici...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949454
    m_Localized: 'Anxiety: Allora sono andata in camera sua per capire meglio. Ma avvicinandomi ho iniziato a sentire uno strano rumore.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949455
    m_Localized: 'Anxiety: Mi sono spaventata, credo. Ma poi, ehm, ho provato a dare una sbirciatina, zitta zitta, per capire cosa stesse accadendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949456
    m_Localized: 'Anxiety: Sono a stento riuscita a intravedere la mia inquilina sul letto, immobile, quando all''improvviso...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949457
    m_Localized: 'Anxiety: Un tizio sudicio mi ha afferrata da dietro e mi ha detto: "Non puoi entrare lì dentro. Lei... non sta bene".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949458
    m_Localized: 'Anxiety: "Accomodati in cucina". Poi mi ha trascinata via e mi ha fatta sedere al tavolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949459
    m_Localized: 'Anxiety: Volevo fuggire, ma ero paralizzata dalla paura... E poi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949460
    m_Localized: 'Anxiety: Io... Lui...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949461
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949462
    m_Localized: 'Anxiety: Devo stendermi. Ho... Ho... lo stomaco sottosopra. Uff...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949463
    m_Localized: 'Anxiety: Eh, eh eh... Spero che tutto si risolva presto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949464
    m_Localized: Cosa è successo dopo, a casa tua?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949465
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949466
    m_Localized: 'Anxiety: Uff...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949467
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949468
    m_Localized: 'Anxiety: Dopo che quel tale mi ha fatto sedere in cucina, un altro tizio enorme è emerso da dietro l''angolo e ha bloccato l''uscita.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949469
    m_Localized: 'Anxiety: E ha cominciato a discutere animatamente con l''uomo che mi aveva afferrata.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949470
    m_Localized: 'Anxiety: Si comportavano come se... come se io nemmeno esistessi. E poi... hanno iniziato a toccarmi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949471
    m_Localized: 'Anxiety: Prima le braccia, poi le spalle...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949472
    m_Localized: 'Anxiety: E intorno a me sentivo applausi e risate, che sembravano provenire dalla mia stanza...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949473
    m_Localized: 'Anxiety: Come se lì dentro ci fosse un''intera folla di uomini. Ah ah ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949474
    m_Localized: 'Anxiety: Mi... mancava il fiato. Il cuore era sul punto di esplodermi in petto...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949475
    m_Localized: 'Anxiety: Avrei voluto urlare, ma... la mia voce annegava in un mare di panico. Non riuscivo a emettere il minimo suono.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949476
    m_Localized: 'Anxiety: E quindi sono rimasta lì, paralizzata, impotente... come un cervo abbagliato dai fari.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949477
    m_Localized: 'Anxiety: Poi il tizio grosso è andato al frigo per prendere qualcosa, e ho capito che dovevo approfittarne! Eh eh!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949478
    m_Localized: 'Anxiety: Sono scattata verso la porta. La paura mi rendeva forte. E ho corso, ho corso... senza mai guardarmi indietro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949479
    m_Localized: 'Anxiety: Beh, almeno finché non mi hanno ceduto le gambe e sono crollata...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949480
    m_Localized: Perché il sole non ti ha ustionata?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949481
    m_Localized: Cosa è successo poi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949482
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949483
    m_Localized: 'Anxiety: Non ricordo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949484
    m_Localized: 'Anxiety: Devo aver passato l''intera notte riversa al suolo, e poi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949485
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949486
    m_Localized: 'Anxiety: Strano... Avrei giurato di ricordare tutti gli avvenimenti di quella giornata...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949487
    m_Localized: 'Anxiety: Aspetta, non penserai che...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949488
    m_Localized: 'Anxiety: Che io...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949489
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949490
    m_Localized: 'Anxiety: Che io sia un Visitatore?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949491
    m_Localized: 'Anxiety: N‑No, non è possibile! Ricordo... l''intera mia vita. L''infanzia, mia madre e mio padre. No!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949492
    m_Localized: 'Anxiety: Non sono un Visitatore, vero? Vero? Dimmi che non lo sono!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949493
    m_Localized: Non lo so.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949494
    m_Localized: Non sei un Visitatore.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949495
    m_Localized: Sembri un Visitatore.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949496
    m_Localized: 'Anxiety: Ero distesa a terra, e poi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949497
    m_Localized: 'Anxiety: Poi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949498
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949499
    m_Localized: 'Anxiety: Avrei giurato di ricordare tutti gli avvenimenti di quella giornata...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949500
    m_Localized: 'Anxiety: Aspetta, non penserai che...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949501
    m_Localized: 'Anxiety: Che io...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949502
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949503
    m_Localized: 'Anxiety: Che io sia un Visitatore?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949504
    m_Localized: 'Anxiety: N‑No, non è possibile! Ricordo... l''intera mia vita. L''infanzia, mia madre e mio padre. No!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949505
    m_Localized: 'Anxiety: Non sono un Visitatore, vero? Vero? Dimmi che non lo sono!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949506
    m_Localized: Non lo so.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949507
    m_Localized: Non sei un Visitatore.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949508
    m_Localized: Sembri un Visitatore.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949509
    m_Localized: 'Anxiety: CHE RAZZA DI RISPOSTA SAREBBE? Ah ah. Oddio, oddio, oddio, ODDIO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949510
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949511
    m_Localized: 'Anxiety: Devo... stendermi. Ho... Ho... di nuovo lo stomaco in subbuglio. Uff...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949512
    m_Localized: 'Anxiety: Grazie, ora mi sento meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949513
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949514
    m_Localized: 'Anxiety: Uff, devo stendermi. Ho di nuovo lo stomaco in subbuglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949515
    m_Localized: 'Anxiety: CHE RAZZA DI RISPOSTA SAREBBE? Ah ah! Ora ho ancora più paura!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949516
    m_Localized: 'Anxiety: NON VOGLIO MORIRE! NON VOGLIO NON VOGLIO NON VOGLIO NON VOGLIO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949517
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949518
    m_Localized: 'Anxiety: Tanto moriremo tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949519
    m_Localized: 'Anxiety: Eh, eh eh... Spero che tutto si risolva presto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949520
    m_Localized: Stai bene?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949521
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949522
    m_Localized: 'Anxiety: NON AVVICINARTI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949523
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949524
    m_Localized: 'Anxiety: Scusa... Ho pensato che volessi uccidermi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949525
    m_Localized: Cosa te l'ha fatto pensare?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949526
    m_Localized: Se avessi voluto ucciderti, saresti morta da un pezzo.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949527
    m_Localized: 'Anxiety: Io...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949528
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949529
    m_Localized: 'Anxiety: Io non so chi sia un Visitatore e chi no... E se...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949530
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949531
    m_Localized: 'Anxiety: Se tu fossi un Visitatore?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949532
    m_Localized: 'Anxiety: Mi uccideresti? Mi scuoieresti viva? Mi strapperesti la pelle?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949533
    m_Localized: 'Anxiety: NO, TI PREGO! UCCIDIMI VELOCEMENTE, SENZA DOLORE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949534
    m_Localized: 'Anxiety: NON VOGLIO MORIRE IN AGONIA! TI PREGO! AH AH AH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949535
    m_Localized: Rilassati, non sono un Visitatore.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949536
    m_Localized: Non ho intenzione di ucciderti.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949537
    m_Localized: 'Anxiety: S‑Scusa, sono un f‑fascio di nervi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949538
    m_Localized: 'Anxiety: Non so più di chi fidarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949539
    m_Localized: 'Anxiety: E se...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949540
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949541
    m_Localized: 'Anxiety: Se tu fossi un Visitatore?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949542
    m_Localized: 'Anxiety: Mi uccideresti? Mi scuoieresti viva? Mi strapperesti la pelle?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949543
    m_Localized: 'Anxiety: NO, TI PREGO! UCCIDIMI VELOCEMENTE, SENZA DOLORE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949544
    m_Localized: 'Anxiety: NON VOGLIO MORIRE IN AGONIA! TI PREGO! AH AH AH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949545
    m_Localized: Rilassati, non sono un Visitatore.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949546
    m_Localized: Non ho intenzione di ucciderti.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949547
    m_Localized: 'Anxiety: CHI ME LO ASSICURA? N‑Non ho nemmeno controllato i tuoi denti o i tuoi occhi... Ah ah ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949548
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949549
    m_Localized: 'Anxiety: Moriremo tutti... Resta solo da capire se ci penserà prima il sole o i Visitatori...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949550
    m_Localized: 'Anxiety: Non c''è speranza. La morte verrà a prenderci, qualsiasi cosa facciamo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949551
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949552
    m_Localized: 'Anxiety: Voglio restare da sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949553
    m_Localized: 'Anxiety: CHI ME LO ASSICURA? N‑Non ho nemmeno controllato i tuoi denti o i tuoi occhi... Ah ah ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949554
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949555
    m_Localized: 'Anxiety: Moriremo tutti... Resta solo da capire se ci penserà prima il sole o i Visitatori...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949556
    m_Localized: 'Anxiety: Non c''è speranza. La morte verrà a prenderci, qualsiasi cosa facciamo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949557
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949558
    m_Localized: 'Anxiety: Voglio restare da sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949559
    m_Localized: 'Anxiety: Eh, eh eh... Spero che tutto si risolva presto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949560
    m_Localized: Cosa c'è che non va?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949561
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949562
    m_Localized: 'Anxiety: I VISITATORI! STANNO ARRIVANDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949563
    m_Localized: 'Anxiety: N‑Non la senti? LA MORTE CI CHIAMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949564
    m_Localized: 'Anxiety: VISITATORI, UMANI... CHE DIFFERENZA C''È?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949565
    m_Localized: 'Anxiety: DA MORTI SAREMO TUTTI UGUALI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949566
    m_Localized: 'Anxiety: Perché tormentarci nell''attesa? CHE VENGANO PURE! AH AH AH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949567
    m_Localized: 'Anxiety: VOGLIONO SOLO IL NOSTRO BENE! ACCOGLIAMO I VISITATORI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949568
    m_Localized: Hai una brutta cera.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949569
    m_Localized: Sei impazzita?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949570
    m_Localized: 'Anxiety: NO! HO VISTO LA LUCE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949571
    m_Localized: 'Anxiety: SONO UN VISITATORE! AH AH AH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949572
    m_Localized: 'Anxiety: SIAMO TUTT''UNO CON GLI UMANI. RIFLESSI! SPECCHI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949573
    m_Localized: 'Anxiety: UGUALI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949574
    m_Localized: 'Anxiety: E INSIEME ACCOGLIEREMO LA MORTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949575
    m_Localized: Ti rendi conto che sembri matta?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949576
    m_Localized: Non mi lasci altra scelta.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949577
    m_Localized: 'Anxiety: NON SONO MATTA... HO VISTO LA LUCE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949578
    m_Localized: 'Anxiety: SONO UN VISITATORE! AH AH AH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949579
    m_Localized: 'Anxiety: SIAMO TUTT''UNO CON GLI UMANI. RIFLESSI! SPECCHI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949580
    m_Localized: 'Anxiety: UGUALI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949581
    m_Localized: 'Anxiety: E INSIEME ACCOGLIEREMO LA MORTE! CHE CI PRENDERÀ TUTTI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949582
    m_Localized: Ti rendi conto che sembri matta?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949583
    m_Localized: Non mi lasci altra scelta.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949584
    m_Localized: 'Anxiety: N‑No, non hai capito niente!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949585
    m_Localized: 'Anxiety: La fine è vicina! IL SOLE ANNUNCIA L''ULTIMO ATTO.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949586
    m_Localized: 'Anxiety: Ci incontreremo presto. Molto presto...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949587
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949588
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949589
    m_Localized: 'Anxiety: Spara! SPARA! Cosa stai aspettando?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949590
    m_Localized: 'Anxiety: MI UCCIDERAI SENZA UN BRICIOLO DI RIMORSO?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949591
    m_Localized: 'Anxiety: Non mi importa! Ah ah ah! FA'' CIÒ CHE DEVI, UMANO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949592
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949593
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949594
    m_Localized: 'Esenin: Sì? Volevi qualcosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949595
    m_Localized: Perché ti hanno cacciato dal pub?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949596
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949597
    m_Localized: 'Esenin: È colpa della catena di sventure che ha fatto ammattire tutti quanti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949598
    m_Localized: 'Esenin: Il sole sull''orlo di un''esplosione, l''arrivo dei Visitatori, la crisi economica e via discorrendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949599
    m_Localized: 'Esenin: È andato tutto in malora. Qualcuno cede allo stress, altri si tuffano nell''alcol.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949600
    m_Localized: 'Esenin: Ma io? Beh, è stata la rabbia a farmi ammattire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949601
    m_Localized: 'Esenin: Ho perso la testa, sono salito sul bancone e ho urlato: "Piantatela di incolpare tutto tranne voi stessi!".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949602
    m_Localized: 'Esenin: Piangessero pure. Le lacrime non rovinano la birra, anzi. Quel gusto salato ci sta proprio bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949603
    m_Localized: 'Esenin: Ma sono parole al vento, chi me lo fa fare?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949604
    m_Localized: 'Esenin: Sì? Volevi qualcosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949605
    m_Localized: Le cose vanno meglio qui?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949606
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949607
    m_Localized: 'Esenin: Ho smesso di importunare il prossimo. Non ne vale la pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949608
    m_Localized: 'Esenin: Quando sento qualcosa alla TV o ascolto per caso una conversazione, mi si accende una scintilla nella testa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949609
    m_Localized: 'Esenin: Mi trattengo, però... Troppa fatica e nessuna gratificazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949610
    m_Localized: 'Esenin: No, ho smesso. I miei nervi sono al punto di rottura.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949611
    m_Localized: 'Esenin: La vita era già uno strazio prima di tutto questo, e ora...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949612
    m_Localized: 'Esenin: Un giorno penzolerò dal lampadario, incombendo su tutto il mondo battezzato.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949613
    m_Localized: 'Esenin: Sì? Volevi qualcosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949614
    m_Localized: Tutto bene?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949615
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949616
    m_Localized: 'Esenin: Eh? Perché lo chiedi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949617
    m_Localized: Hai un certo odore addosso.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949618
    m_Localized: Hai la febbre?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949619
    m_Localized: 'Esenin: Beh... Ho bevuto qualche birra delle tue.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949620
    m_Localized: 'Esenin: Non mi sentivo benissimo, e ho deciso di riprendermi con una birretta fresca. Non c''è niente di male.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949621
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949622
    m_Localized: 'Esenin: È un enorme macello del cazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949623
    m_Localized: 'Esenin: Dicono che stanno studiando la situazione, che la soluzione è vicina... Stronzate. Non cambierà niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949624
    m_Localized: 'Esenin: Sai, buon uomo... Credo che a breve moriremo tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949625
    m_Localized: 'Esenin: Se non ci ucciderà il sole, ci penseranno i Visitatori. E se avremo la meglio, ci seppelliremo con le nostre stesse mani.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949626
    m_Localized: 'Esenin: Quando viene risolto un problema, si crea un vuoto. Allora creiamo un nuovo cazzo di problema per colmarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949627
    m_Localized: 'Esenin: Come per un morboso e irrefrenabile impulso collettivo a cagarci addosso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949628
    m_Localized: 'Esenin: Merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949629
    m_Localized: 'Esenin: Lasciami. Non mi sento bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949630
    m_Localized: 'Esenin: Non ce l''ho io la febbre. Ce l''ha l''intero cazzo di pianeta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949631
    m_Localized: 'Esenin: Dovunque guardi, c''è qualcuno che muore. I ghiacciai si sciolgono, le foreste bruciano. Il mondo è in fiamme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949632
    m_Localized: 'Esenin: Il pianeta vuole scrollarsi di dosso l''umanità, come pulci gonfie di sangue.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949633
    m_Localized: 'Esenin: Prima o poi accadrà, sai... E non sperare che sia indolore.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949634
    m_Localized: 'Esenin: Arghhh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949635
    m_Localized: 'Esenin: Sparisci. Per favore. Non mi sento bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949636
    m_Localized: 'Esenin: Sì? Volevi qualcosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949637
    m_Localized: Ti senti meglio?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949638
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949639
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949640
    m_Localized: 'Esenin: Buon uomo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949641
    m_Localized: 'Esenin: Prima o poi moriremo tutti. È una verità ineluttabile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949642
    m_Localized: 'Esenin: Cosa pensi che ci accadrà, dopo la morte?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949643
    m_Localized: La fede ci condurrà in un magnifico aldilà.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949644
    m_Localized: Niente.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949645
    m_Localized: Non so, magari finiremo a galleggiare nello spazio.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949646
    m_Localized: 'Esenin: Potrebbe avere senso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949647
    m_Localized: 'Esenin: Ma non mi fa sentire meglio, nemmeno per sogno. E sai perché?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949648
    m_Localized: 'Esenin: In punto di morte, il mio cervello si protenderà verso quell''ideale. Mi mostrerà immagini paradisiache, di un luogo migliore.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949649
    m_Localized: 'Esenin: E quando la forza di aggrapparmi a quel fragile sogno mi abbandonerà, cosa accadrà?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949650
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949651
    m_Localized: 'Esenin: No. Non mi fa sentire affatto meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949652
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949653
    m_Localized: 'Esenin: Speravo proprio che rispondessi così.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949654
    m_Localized: 'Esenin: Potresti avere ragione, ovviamente. Ma è così deprimente...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949655
    m_Localized: 'Esenin: Pensare che non ci sia nulla dopo la fine, dopo tutto... questo. Nient''altro che tenebre...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949656
    m_Localized: 'Esenin: D''improvviso, non ho più voglia di parlare.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143680
    m_Localized: 'Esenin: Se ci pensi sul serio...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143681
    m_Localized: 'Esenin: Ha senso credere che siamo soli nell''universo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143682
    m_Localized: 'Esenin: Non esistono altre forme di vita. Solo il gelido vuoto dello spazio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143683
    m_Localized: 'Esenin: Se così non fosse, avremmo captato qualche forma di messaggio o di segnale, giusto? Non lo so...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143684
    m_Localized: 'Esenin: Un cupo nulla di tenebre eterne... Finire così equivarrebbe a svanire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337984
    m_Localized: 'Esenin: Voglio... stare da solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337985
    m_Localized: 'Esenin: Sì? Volevi qualcosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337986
    m_Localized: Stai... bene?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337987
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337988
    m_Localized: 'Esenin: Almeno il soffitto del pub era bello alto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337989
    m_Localized: 'Esenin: Ti ci potevi impiccare, senza problemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337990
    m_Localized: 'Esenin: Qui si sta troppo stretti. L''intero pianeta è troppo soffocante per me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337991
    m_Localized: 'Esenin: Buon uomo, io anelo soltanto la fine.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337992
    m_Localized: 'Esenin: Siamo in un mare di merda. Ormai ho paura di tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337993
    m_Localized: 'Esenin: Non ne posso più.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337994
    m_Localized: 'Esenin: Perché diamine sono venuto qui?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337995
    m_Localized: 'Widow: Ho bisogno di riposo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337996
    m_Localized: Ti serve qualcosa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337997
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337998
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337999
    m_Localized: 'Widow: Vorrei che lui fosse vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338000
    m_Localized: 'Widow: Tutto qui...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338001
    m_Localized: 'Widow: Non mi serve altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338002
    m_Localized: Posso portarti dell'acqua?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338003
    m_Localized: Gradiresti del cibo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338004
    m_Localized: 'Widow: Io mi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338005
    m_Localized: 'Widow: Metterò seduta accanto al rubinetto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338006
    m_Localized: 'Widow: Posso bere da lì, se serve.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338007
    m_Localized: Ti lascio in pace, allora.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338008
    m_Localized: Posso farti compagnia?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338009
    m_Localized: 'Widow: Non ho fame.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338010
    m_Localized: 'Widow: Ho solo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338011
    m_Localized: 'Widow: Ho solo bisogno di sedermi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338012
    m_Localized: Ti lascio in pace, allora.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338013
    m_Localized: Posso farti compagnia?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338014
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338015
    m_Localized: 'Widow: Perché sei morto?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338016
    m_Localized: 'Widow: Mi avevi promesso che tutto si sarebbe sistemato.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338017
    m_Localized: 'Widow: Dicevi che le cose sarebbero andate meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338018
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338019
    m_Localized: 'Widow: E poi sei morto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338020
    m_Localized: 'Widow: E ora sono rimasta sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338021
    m_Localized: 'Widow: Perché mi hai abbandonata?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338022
    m_Localized: 'Widow: Vorrei solo riaverlo con me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338023
    m_Localized: 'Widow: E tu non puoi riportarlo in vita.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338024
    m_Localized: 'Widow: Non posso nemmeno...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338025
    m_Localized: 'Widow: Seppellirlo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338026
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338027
    m_Localized: 'Widow: Non posso nemmeno seppellirlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338028
    m_Localized: 'Widow: Cosa posso mai fare?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338029
    m_Localized: 'Widow: Ho bisogno di riposo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338030
    m_Localized: Come è morto?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338031
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338032
    m_Localized: 'Widow: Lui... Non ce la faccio...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338033
    m_Localized: 'Widow: È troppo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338034
    m_Localized: 'Widow: Ho finito le lacrime.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338035
    m_Localized: 'Widow: Le ho versate tutte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338036
    m_Localized: 'Widow: Ma è sbagliato... È tutto sbagliato...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338037
    m_Localized: 'Widow: Non riesco a smettere di piangere.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338038
    m_Localized: Merita una degna sepoltura.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338039
    m_Localized: Tuo marito è morto, devi accettarlo.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338040
    m_Localized: 'Widow: No...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338041
    m_Localized: 'Widow: No, no, no, no, NO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338042
    m_Localized: 'Widow: Non sono pronta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338043
    m_Localized: 'Widow: Me lo hanno appena restituito.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338044
    m_Localized: 'Widow: E pretendi che mi separi già da lui?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338045
    m_Localized: 'Widow: Non posso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338046
    m_Localized: 'Widow: Non lo abbandonerò al gelido abbraccio della terra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338047
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338048
    m_Localized: 'Widow: No.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338049
    m_Localized: 'Widow: Ti sbagli, non è vero.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338050
    m_Localized: 'Widow: Può ancora sentirmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338051
    m_Localized: 'Widow: Io...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338052
    m_Localized: 'Widow: Io preferisco credere che possa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338053
    m_Localized: 'Widow: Ho bisogno di riposo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338054
    m_Localized: Cosa ricordi di lui?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338055
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338056
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338057
    m_Localized: 'Widow: Ricordo un giorno, a casa di amici.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338058
    m_Localized: 'Widow: Quando eravamo molto più giovani.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338059
    m_Localized: 'Widow: Ce ne stavamo lì, a bere. Lui era un tipo ombroso, non parlava molto nemmeno in quelle occasioni di ritrovo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338060
    m_Localized: 'Widow: E beh, quel giorno avevamo bevuto molto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338061
    m_Localized: 'Widow: Se ne stava in silenzio, come sempre, ma all''improvviso mi fa:'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338062
    m_Localized: 'Widow: "Dammi una chitarra, voglio cantare qualcosa".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338063
    m_Localized: 'Widow: E si è messo a suonare, magnificamente. È stato bellissimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338064
    m_Localized: 'Widow: Poi i nostri amici hanno cominciato a chiedergli altre canzoni. Lui è rimasto immobile per qualche istante, e poi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338065
    m_Localized: 'Widow: Ha detto di doversene andare e si è alzato di scatto, urtando un bicchiere. E per provare a prenderlo ha fatto cadere la chitarra...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338066
    m_Localized: 'Widow: In seguito ho scoperto che aveva imparato quell''unica canzone per fare colpo su di me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338067
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338068
    m_Localized: 'Widow: Ho ancora una nostra foto di quella sera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338069
    m_Localized: 'Widow: Ha visto tempi migliori, proprio come noi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338070
    m_Localized: 'Widow: Ora non puoi più suonarmi niente. Mi hai cantato la tua ultima canzone.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338071
    m_Localized: 'Widow: Ho bisogno di riposo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338072
    m_Localized: Cosa gli è successo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338073
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338074
    m_Localized: 'Widow: È morto, cazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338075
    m_Localized: Giusto. Sono stato indelicato.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338076
    m_Localized: Non l'ho ucciso io.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338077
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338078
    m_Localized: 'Widow: Perdonami, è che...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338079
    m_Localized: 'Widow: Scoppio a piangere ogni notte. Le lacrime non si fermano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338080
    m_Localized: 'Widow: Vorrei che i responsabili dell''accaduto... bruciassero vivi al sole. Non chiedo altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338081
    m_Localized: Quindi, come è successo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338082
    m_Localized: Non insisterò con le domande.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338083
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338084
    m_Localized: 'Widow: Lo so, hai ragione.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338085
    m_Localized: 'Widow: Sono stata scortese. Ma per me parlarne è molto difficile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338086
    m_Localized: 'Widow: Spero che quei bastardi la paghino.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338087
    m_Localized: 'Widow: Spero che qualcuno li faccia a pezzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338088
    m_Localized: Quindi, come è successo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338089
    m_Localized: Non insisterò con le domande.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338090
    m_Localized: 'Widow: Mio marito non si sentiva bene, ma all''ospedale lo hanno respinto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338091
    m_Localized: 'Widow: Consigliandoci di andare al nuovo centro della FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338092
    m_Localized: 'Widow: E loro l''hanno messo in quarantena. Gli hanno tolto il telefono, dicendo che lo avrebbero dimesso dopo tre settimane.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338093
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338094
    m_Localized: 'Widow: Ci sono tornata prima del tempo, per vedere come stava.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338095
    m_Localized: 'Widow: E quei bastardi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338096
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338097
    m_Localized: 'Widow: Scusami, dammi un minuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338098
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338099
    m_Localized: 'Widow: Mi hanno detto: "È morto".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338100
    m_Localized: 'Widow: Tutto qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338101
    m_Localized: 'Widow: Non mi lasciavano nemmeno vedere il corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338102
    m_Localized: 'Widow: Mi impedivano di riportarlo a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338103
    m_Localized: 'Widow: Ma quelle scimmie non sono nemmeno capaci di allacciarsi le scarpe. Mi è bastato indossare un camice e introdurmi nell''obitorio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338104
    m_Localized: 'Widow: E lui...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338105
    m_Localized: 'Widow: Lui era davvero lì.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338106
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338107
    m_Localized: 'Widow: Lo hanno ucciso, sono degli assassini. E io resto qui, a urlare al mondo che non ho più pietà per nessuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338108
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338109
    m_Localized: 'Widow: Vorrei restare da sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338110
    m_Localized: 'Widow: Sì. Per favore...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338111
    m_Localized: 'Widow: Non credo di poter resistere senza di lui...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338112
    m_Localized: 'Widow: Ho bisogno di riposo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338113
    m_Localized: Qualcosa non va?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338114
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338115
    m_Localized: 'Widow: Stanotte me ne andrò.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338116
    m_Localized: 'Widow: Ti avevo detto che non mi sarei trattenuta a lungo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338117
    m_Localized: 'Widow: Mi serviva solo un posto per recuperare le forze.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338118
    m_Localized: Cosa farai adesso?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338119
    m_Localized: Andrai a stare dalla tua famiglia?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338120
    m_Localized: 'Widow: Non voglio pensarci.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338121
    m_Localized: 'Widow: Credo... che me ne tornerò a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338122
    m_Localized: 'Widow: Cercherò quella vecchia chitarra...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338123
    m_Localized: 'Widow: E poi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338124
    m_Localized: Potresti restare qui.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338125
    m_Localized: Buona fortuna.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338126
    m_Localized: 'Widow: Non abbiamo nessuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338127
    m_Localized: 'Widow: Ce ne torniamo a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338128
    m_Localized: 'Widow: Non ci resta altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338129
    m_Localized: Potresti restare qui.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338130
    m_Localized: Buona fortuna.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338131
    m_Localized: 'Widow: Perché?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338132
    m_Localized: 'Widow: Non mi renderebbe la vita più facile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338133
    m_Localized: 'Widow: Non te la prendere, ma di te non mi importa nulla.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338134
    m_Localized: 'Widow: Voglio solo tornare a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338135
    m_Localized: 'Widow: È il luogo a cui appartengo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338136
    m_Localized: 'Widow: Grazie...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338137
    m_Localized: 'Widow: Non parli molto, ma... sei un eccellente ascoltatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338138
    m_Localized: 'Widow: Ti auguro di trovare quello che cerchi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338139
    m_Localized: 'Scammer: Eh eh. Che c''è?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338140
    m_Localized: Cosa facevi prima del Cataclisma?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338141
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338142
    m_Localized: 'Scammer: Oooh, grazie per la domanda, fra!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338143
    m_Localized: 'Scammer: Hai mai sentito parlare di...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338144
    m_Localized: 'Scammer: Scommesse sportive? Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338145
    m_Localized: Cosa sei, un truffatore?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338146
    m_Localized: Certo che sì.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338147
    m_Localized: 'Scammer: Andiamo, non chiamarmi così! Sono un fottuto analista, bello!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338148
    m_Localized: 'Scammer: Se sapessi quanti soldi sono passati per queste mani, inizieresti a sbavare.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338149
    m_Localized: 'Scammer: Sono un professionista. Gli affari prima di tutto, cazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338150
    m_Localized: 'Scammer: La gente mi portava i risparmi e guadagnava cinque... no, DIECI volte tanto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338151
    m_Localized: Quanto hai guadagnato?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338152
    m_Localized: E lo chiami lavoro?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338153
    m_Localized: 'Scammer: È così che campavo, fra!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338154
    m_Localized: 'Scammer: Le scommesse pulite sono per gli idioti e gli stronzi. Sincero, bello.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338155
    m_Localized: 'Scammer: C''è sempre un modo per fregare gli allibratori.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338156
    m_Localized: 'Scammer: Fai la tua bella scommessa, e ti metti comodo ad aspettare che il grano arrivi da paparino!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338157
    m_Localized: 'Scammer: Non hai soldi? No problem. Prendili in prestito da qualche altro idiota!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338158
    m_Localized: Quanto hai guadagnato?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338159
    m_Localized: E lo chiami lavoro?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338160
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338161
    m_Localized: 'Scammer: Come te lo spiego...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338162
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338163
    m_Localized: 'Scammer: Ho accumulato trenta... cazzo di... milioni...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338164
    m_Localized: 'Scammer: Di debiti, certo, ma i debiti non mi fanno paura!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338165
    m_Localized: 'Scammer: E figurati quanto me ne può fottere adesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338166
    m_Localized: 'Scammer: Io fisso il pericolo dritto negli occhi, fra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338167
    m_Localized: 'Scammer: Mi prendi per il culo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338168
    m_Localized: 'Scammer: Certo che è un lavoro!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338169
    m_Localized: 'Scammer: Avevo persino un ufficio. Degno di un re, cazzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338170
    m_Localized: 'Scammer: Divano di pelle, ciccio. E un quaderno, con gli allibratori, le cifre dovute, i profitti, tutte le scartoffie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338171
    m_Localized: 'Scammer: Eh eh. Che c''è?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338172
    m_Localized: Sicuro di non avere qualche esattore alle calcagna?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338173
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338174
    m_Localized: 'Scammer: Esattore? Cosa cazzo significa "esattore"?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338175
    m_Localized: 'Scammer: Senti, i "debiti" sono stati annullati, cazzo. Ci ha pensato il sole!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338176
    m_Localized: 'Scammer: Le banche non possono farci niente. E sarà così per sempre!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338177
    m_Localized: 'Scammer: Quindi, sono libero come un dannato uccellino. Ma chi si ferma è perduto, gente!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338178
    m_Localized: 'Scammer: Le scommesse sono storia. Devo inventarmi qualcosa di nuovo, di migliore.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338179
    m_Localized: Sembra che gli effetti del sole siano stati un colpo di fortuna per te.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338180
    m_Localized: Sei serio? Ti stai già inventando qualche altro raggiro?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338181
    m_Localized: 'Scammer: E daaai. Perché mi dici così?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338182
    m_Localized: 'Scammer: Avevo un metodo infallibile! Raddoppio o niente, ogni volta! Una passeggiata!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338183
    m_Localized: 'Scammer: Ma ora devo ricominciare da capo. Giuro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338184
    m_Localized: 'Scammer: Comunque, ho trovato un nuovo sistema per fare soldi. Ti interessa? Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338185
    m_Localized: Sentiamo.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338186
    m_Localized: Non mi interessa.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338187
    m_Localized: 'Scammer: Mi è venuto in mente un modo CLAMOROSO per arricchirci. Vuoi sentirlo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338188
    m_Localized: Sentiamo.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338189
    m_Localized: Non mi interessa.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338190
    m_Localized: 'Scammer: Allora, ormai è la FEMA che comanda, giusto?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338191
    m_Localized: 'Scammer: Dobbiamo, insomma... leccare qualche culo. Mi segui?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338192
    m_Localized: 'Scammer: L''idea è questa: se gli consegnassimo qualche poveraccio potrebbero portarci in uno dei loro bunker, al sicuro!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338193
    m_Localized: 'Scammer: Mi segui?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338194
    m_Localized: Vuoi consegnare altre persone alla FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338195
    m_Localized: Pensi che la FEMA ti salverebbe?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338196
    m_Localized: 'Scammer: Esatto. Perché no, cazzo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338197
    m_Localized: 'Scammer: Tira fuori le palle.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338198
    m_Localized: 'Scammer: A mali estremi, estremi rimedi, fra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338199
    m_Localized: 'Scammer: Le zone di quarantena sono per le pecore. Non ne viene niente di buono da quei posti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338200
    m_Localized: 'Scammer: Quindi dobbiamo farci amica la FEMA. Baciare qualche chiappa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338201
    m_Localized: 'Scammer: Non dobbiamo mica limonarceli, ci basta consegnargli un po'' di gente... Farli contenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338202
    m_Localized: 'Scammer: Sì... Sì... Potremmo chiamare il numero d''emergenza e sparare qualche cazzata sui segni o che ne so! Così capirebbero che siamo a posto, fra!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338203
    m_Localized: 'Scammer: Loro sono i buoni. Giuro! Giuro!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338204
    m_Localized: Forse hai ragione.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338205
    m_Localized: Racconti solo cazzate.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338206
    m_Localized: Se ti piacciono tanto, vattene affanculo lontano da casa mia.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338207
    m_Localized: 'Scammer: Accidenti, fra. Il vento del cambiamento non verrà a succhiartelo spontaneamente...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338208
    m_Localized: 'Scammer: Comunque, dobbiamo scoprire chi comanda e fare il suo gioco. È la strategia vincente, fra. Mi segui?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338209
    m_Localized: 'Scammer: Quindi dobbiamo farci amica la FEMA. Baciare qualche chiappa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338210
    m_Localized: 'Scammer: Non dobbiamo mica limonarceli, ci basta consegnargli un po'' di gente... Farli contenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338211
    m_Localized: 'Scammer: Sì... Sì... Potremmo chiamare il numero d''emergenza e sparare qualche cazzata sui segni o che ne so! Così capirebbero che siamo a posto, fra!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338212
    m_Localized: 'Scammer: Loro sono i buoni. Giuro! Giuro!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338213
    m_Localized: Forse hai ragione.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338214
    m_Localized: Racconti solo cazzate.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338215
    m_Localized: Se ti piacciono tanto, vattene affanculo lontano da casa mia.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338216
    m_Localized: 'Scammer: Certo che ho ragione.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338217
    m_Localized: 'Scammer: Ho il sesto senso per gli affari, fra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338218
    m_Localized: 'Scammer: Fidati, a fare come dico io non si sbaglia mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338219
    m_Localized: 'Scammer: Ma fottiti. Sei tu che non capisci un cazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338220
    m_Localized: 'Scammer: La gente mi pagava per avere consigli finanziari. Io te li sto dando GRATIS, come un regalo, e tu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338221
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338222
    m_Localized: 'Scammer: Fanculo, tu e la tua testa di cazzo, cagasotto... Mi hai rotto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338223
    m_Localized: 'Scammer: Che c''è, vuoi cacciarmi via, stronzo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338224
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338225
    m_Localized: 'Scammer: Andiamo, ti consideravo un fratello...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338226
    m_Localized: 'Scammer: Volevo persino coinvolgerti nei miei affari. E invece...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338227
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338228
    m_Localized: 'Scammer: Vattene all''inferno. Tanti saluti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338229
    m_Localized: 'Scammer: Merda, ma sei serio? Quell''idea spaccava culi, proprio. Ma fai come ti pare, stronzo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338230
    m_Localized: 'Scammer: Beh, se cambi idea, fammi sapere. Va bene...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338231
    m_Localized: 'Scammer: Eh eh. Che c''è?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338232
    m_Localized: Hai in mente qualcosa, o sbaglio?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338233
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338234
    m_Localized: 'Scammer: Ascolta, mi è venuta un''idea per un altro colpaccio. Roba grossa, giuro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338235
    m_Localized: 'Scammer: Allora, fondamentalmente...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338236
    m_Localized: 'Scammer: Il sole ci sta arrostendo come una sauna infernale, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338237
    m_Localized: 'Scammer: E questo vuol dire che lo strato di ozono è fottuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338238
    m_Localized: 'Scammer: Però, seguimi... L''ossigeno viene creato dalla luce del sole che attraversa l''ozono...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338239
    m_Localized: 'Scammer: Hai capito dove voglio andare a parare, fra?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338240
    m_Localized: 'Scammer: VENDIAMO L''ARIA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338241
    m_Localized: 'Scammer: Possiamo farci soldi a PALATE, merda!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338242
    m_Localized: Piano grandioso, sei un dannato genio.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338243
    m_Localized: Porca miseria, è l'idea più idiota che abbia mai sentito in vita mia.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338244
    m_Localized: 'Scammer: Fraaa! Sei serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338245
    m_Localized: Sì, certo. Dovresti fare lo scienziato.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338246
    m_Localized: No.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338247
    m_Localized: 'Scammer: Cavolo, beh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338248
    m_Localized: 'Scammer: Grazie, fra! Lo sapevo che eri sveglio! Hai capito che ho i neuroni che mi arrivano fino alle palle!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338249
    m_Localized: 'Scammer: Di questo passo vincerò un Darwin Award!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338250
    m_Localized: Sai... cos'è un Darwin Award, vero?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338251
    m_Localized: Oh, ce l'hai già in tasca.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338252
    m_Localized: 'Scammer: Ehm... Premiano le migliori cazzate scientifiche e altra roba da nerd, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338253
    m_Localized: 'Scammer: Perché?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338254
    m_Localized: Così, chiedevo.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338255
    m_Localized: I Darwin Award vanno alle persone che muoiono in modo stupido.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338256
    m_Localized: 'Scammer: Ah ah! Sento già il profumo della gloria. Re della scienza! Inchinatevi, stronzi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338257
    m_Localized: 'Scammer: Soldi a palate, fama a palate, donne a palate... Andiamo, cazzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338258
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338259
    m_Localized: 'Scammer: D''accordo, è deciso. Finita questa storia, brevetterò la tecnologia per vendere l''aria.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338260
    m_Localized: 'Scammer: Sapevo che avresti capito, fra! Sì!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338261
    m_Localized: 'Scammer: Oh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338262
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338263
    m_Localized: 'Scammer: Aspetta, mi stai prendendo in giro?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338264
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338265
    m_Localized: 'Scammer: Fanculo. Io ho trovato la cazzo di gallina dalle uova d''ORO, e tu mi sfotti?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338266
    m_Localized: 'Scammer: Fanculo. Io ho trovato il modo per fare i milioni, e tu mi sfotti?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338267
    m_Localized: 'Scammer: Mi prenderò quel Darwin Award e diventerò miliardario, stronzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338268
    m_Localized: 'Scammer: Allora verrai a baciarmi i piedi e a chiedermi scusa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338269
    m_Localized: Prendi le tue idee di merda e vattene affanculo altrove.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338270
    m_Localized: 'Scammer: Merda, fra...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338271
    m_Localized: 'Scammer: È così difficile starmi a sentire, cazzo? Ho toccato un nervo scoperto?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338272
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532288
    m_Localized: 'Scammer: Pazienza. Vaffanculo, stronzo. Tanto farò più soldi da solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532289
    m_Localized: 'Scammer: Merda, fra...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532290
    m_Localized: 'Scammer: Fanculo. Io ho trovato la cazzo di gallina dalle uova d''ORO, e tu mi sfotti?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532291
    m_Localized: 'Scammer: Mi prenderò quel Darwin Award e diventerò miliardario, stronzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532292
    m_Localized: 'Scammer: Allora verrai a baciarmi i piedi e a chiedermi scusa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532293
    m_Localized: 'Neighbour: Diamine... Allora è tutto vero...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532294
    m_Localized: 'Neighbour: Beh, ciò che ti ho detto ha senso.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532295
    m_Localized: 'Neighbour: Non uscire di giorno. E ricorda di far entrare altra gente in casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532296
    m_Localized: Perché dovrei accogliere degli sconosciuti?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532297
    m_Localized: Far entrare gente?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532298
    m_Localized: 'Neighbour: So che preferiresti startene da solo, ma è necessario.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532299
    m_Localized: 'Neighbour: Mia cugina non ha ben chiaro il perché, ma non possiamo rintanarci da soli...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532300
    m_Localized: 'Neighbour: Stando a lei, se qualcuno viene a chiederti se sei da solo devi rispondere di no, che c''è qualcun altro in casa con te.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532301
    m_Localized: Odio avere a che fare con le persone.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532302
    m_Localized: Perché non posso starmene da solo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532303
    m_Localized: 'Neighbour: Lo capisco...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532304
    m_Localized: 'Neighbour: So che preferiresti fare a meno della compagnia. Ma qualcuno devi lasciarlo entrare.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532305
    m_Localized: 'Neighbour: Mia cugina non ha ben chiaro il perché, ma non possiamo rintanarci da soli...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532306
    m_Localized: 'Neighbour: Stando a lei, se qualcuno viene a chiederti se sei da solo devi rispondere di no, che c''è qualcun altro in casa con te.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532307
    m_Localized: Odio avere a che fare con le persone.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532308
    m_Localized: Perché non posso starmene da solo?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532309
    m_Localized: 'Neighbour: Lo so, non sarà facile, ma non hai altra scelta. Potrebbe essere l''unico modo per restare vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532310
    m_Localized: 'Neighbour: E chi lo sa, i tuoi ospiti potrebbero portarti oggetti utili o informazioni interessanti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532311
    m_Localized: 'Neighbour: Ma ricorda di sottoporli ai test per scoprire se sono Visitatori. Di giorno non avrai molte energie, con questo caldo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532312
    m_Localized: 'Neighbour: Quindi, scegli bene chi vuoi controllare. Dovrai esaminare il soggetto molto accuratamente. È un lavoro estenuante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532313
    m_Localized: 'Neighbour: Puoi conversare liberamente, però. Parlare non consuma energia, non farti alcun problema a chiacchierare.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532314
    m_Localized: 'Neighbour: E assicurati di guardare dalla finestra. Va bene la TV, ma i nostri occhi sono la migliore fonte di informazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532315
    m_Localized: E poi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532316
    m_Localized: Cosa dobbiamo fare?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532317
    m_Localized: 'Neighbour: Le persone che accogli potrebbero portarti oggetti utili o informazioni interessanti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532318
    m_Localized: 'Neighbour: Ma ricorda di sottoporli ai test per scoprire se sono Visitatori. Di giorno non avrai molte energie, con questo caldo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532319
    m_Localized: 'Neighbour: Quindi, scegli bene chi vuoi controllare. Dovrai esaminare il soggetto molto accuratamente. È un lavoro estenuante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532320
    m_Localized: 'Neighbour: Puoi conversare liberamente, però. Parlare non consuma energia, non farti alcun problema a chiacchierare.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532321
    m_Localized: 'Neighbour: E assicurati di guardare dalla finestra. Va bene la TV, ma i nostri occhi sono la migliore fonte di informazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532322
    m_Localized: E poi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532323
    m_Localized: Cosa dobbiamo fare?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532324
    m_Localized: 'Neighbour: Al momento possiamo solo sforzarci di sopravvivere, temo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532325
    m_Localized: 'Neighbour: E sperare che l''incubo passi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532326
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532327
    m_Localized: 'Neighbour: Sono sicuro che il governo ci aiuterà, in qualche modo. Magari portandoci tutti al sicuro, non so.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532328
    m_Localized: 'Neighbour: Se dovesse accadere, restiamo uniti. Tu, io e la mia famiglia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532329
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532330
    m_Localized: 'Neighbour: Oh, quasi dimenticavo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532331
    m_Localized: 'Neighbour: Domani notte me ne torno a casa mia. Questo è il mio numero, puoi chiamarmi quando vuoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532332
    m_Localized: 'Neighbour: Ci hanno installato la linea da poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532333
    m_Localized: 'Neighbour: XXX‑XXX‑XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532334
    m_Localized: 'Neighbour: Teniamoci in contatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532335
    m_Localized: 'Neighbour: Ok, credo di non avere altro da dirti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532336
    m_Localized: 'Neighbour: Ti ho portato una cassa di birre, comunque. Mio cognato lavora in un birrificio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532337
    m_Localized: 'Neighbour: Bevine una, prima di andare a letto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532338
    m_Localized: 'Neighbour: Ti concilierà il sonno. Quando pensi di aver chiacchierato abbastanza per la giornata, bevi una birra e rilassati.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532339
    m_Localized: 'Daughter: V‑Voglio la mia m‑mamma.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532340
    m_Localized: Raccontami cosa è successo.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532341
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532342
    m_Localized: 'Daughter: Non lo sooo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532343
    m_Localized: 'Daughter: Sono venuti e si sono messi a parlare, e papà gli ha detto che si sbagliavano. E loro hanno detto... Hanno detto...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532344
    m_Localized: 'Daughter: Papà!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532345
    m_Localized: 'Daughter: PAAAPÀ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532346
    m_Localized: Ok... Per ora cerca di riposare.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532347
    m_Localized: Ne riparliamo domani, va bene?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532348
    m_Localized: 'Daughter: (La ragazzina continua a chiamare suo padre, è in piena crisi isterica)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532349
    m_Localized: 'Daughter: (La ragazzina non ti ascolta nemmeno, è sconvolta dal dolore)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532350
    m_Localized: 'Daughter: V‑Voglio la mia m‑mamma.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532351
    m_Localized: Come stai? Ti piace stare qui?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532352
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532353
    m_Localized: 'Daughter: Uhm... Non è male.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532354
    m_Localized: 'Daughter: Ma vorrei essere a casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532355
    m_Localized: 'Daughter: Quando potrò andare a casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532356
    m_Localized: Tra qualche giorno, forse. La stanno rinnovando.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532357
    m_Localized: Non sperarci. La tua casa è bruciata.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532358
    m_Localized: 'Daughter: Ok... Quindi verranno presto a prendermi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532359
    m_Localized: 'Daughter: Per portarmi in una casa nuova?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532360
    m_Localized: 'Daughter: O mi riporteranno in quella vecchia?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532361
    m_Localized: 'Daughter: Avrò una stanza tutta nuova?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532362
    m_Localized: 'Daughter: Papà verrà a prendermi, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532363
    m_Localized: Hai visto cosa è successo, no?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532364
    m_Localized: Per ora è meglio se resti qui.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532365
    m_Localized: 'Daughter: Ma papà sta bene, non è vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532366
    m_Localized: 'Daughter: E la mia stanza? È bruciata anche quella?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532367
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532368
    m_Localized: 'Daughter: Mamma non viene?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532369
    m_Localized: 'Daughter: Non è rimasto nessuno?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532370
    m_Localized: Hai visto cosa è successo, no?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532371
    m_Localized: Per ora è meglio se resti qui.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532372
    m_Localized: 'Daughter: I‑Io... non saprei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532373
    m_Localized: 'Daughter: Cioè, non sono sicura.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532374
    m_Localized: 'Daughter: Hanno colpito papà, ma poi lui si è alzato. L''ho visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532375
    m_Localized: 'Daughter: E questo significa che... che forse ha spento il fuoco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532376
    m_Localized: 'Daughter: E che potrebbe venire a cercarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532377
    m_Localized: 'Daughter: Verrà presto?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532378
    m_Localized: 'Daughter: Non vado da nessuna parte senza papà.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532379
    m_Localized: 'Daughter: Sta venendo a prendermi, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532380
    m_Localized: 'Daughter: L''ho visto alzarsi e uscire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532381
    m_Localized: 'Daughter: Stavo scappando, ma l''ho visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532382
    m_Localized: 'Daughter: V‑Voglio la mia m‑mamma.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532383
    m_Localized: Devi fartene una ragione.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532384
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532385
    m_Localized: 'Daughter: Che vuoi dire?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532386
    m_Localized: 'Daughter: In camera tua c''è una TV. Posso guardare i cartoni?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532387
    m_Localized: Non so cosa hai visto, ma credo che tuo padre sia morto.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532388
    m_Localized: Non è detto che tuo padre venga a cercarti. Non so cosa gli è successo.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532389
    m_Localized: 'Daughter: Tu non hai visto niente!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532390
    m_Localized: 'Daughter: Io ero lì! Si stava muovendo quando sono scappata.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532391
    m_Localized: 'Daughter: Quindi verrà presto a cercarmi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532392
    m_Localized: Allora perché non è ancora venuto?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532393
    m_Localized: Che aspetto aveva, l'ultima volta che l'hai visto?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532394
    m_Localized: 'Daughter: Non verrà, secondo te? M‑Ma perché dici così?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532395
    m_Localized: Allora perché non è ancora venuto?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532396
    m_Localized: Che aspetto aveva, l'ultima volta che l'hai visto?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532397
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532398
    m_Localized: 'Daughter: Uhm... Forse aveva altro da fare prima?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532399
    m_Localized: 'Daughter: Scommetto che è andato a picchiare quei cattivi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532400
    m_Localized: 'Daughter: Sarà... Sarà qui da un momento all''altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532401
    m_Localized: Mi dispiace per tuo padre, era un brav'uomo. Troppo, per questo mondo.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532402
    m_Localized: Certo, sarà già in cammino.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532403
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532404
    m_Localized: 'Daughter: Era tanto buono.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532405
    m_Localized: 'Daughter: Lo hanno colpito... e poi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532406
    m_Localized: 'Daughter: Non ricordo...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532407
    m_Localized: Mi dispiace per tuo padre, era un brav'uomo. Troppo, per questo mondo.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532408
    m_Localized: Certo, sarà già in cammino.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532409
    m_Localized: 'Daughter: (La ragazzina ti fissa intensamente: hai paura a muoverti, quindi ti limiti ad aspettare che accada qualcosa)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532410
    m_Localized: 'Daughter: (Dopo qualche istante, riprende a piangere, ma non sembra che tu possa aiutarla)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532411
    m_Localized: 'Daughter: (Illuderla sarebbe peggio, deve imparare ad accettare la realtà il prima possibile)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532412
    m_Localized: 'Daughter: Proprio come pensavo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532413
    m_Localized: 'Daughter: (La ragazzina sembra avere la testa altrove, sta chiaramente pensando a qualcosa)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532414
    m_Localized: 'Daughter: (Ma è proprio necessario rovinarle la vita? Saprebbe reggere il colpo?)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532415
    m_Localized: 'Daughter: (Decidi che la poverina ha già troppi pensieri, non è il caso di peggiorare ulteriormente le cose)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532416
    m_Localized: 'NotTrue: Povera me, sto invecchiando...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532417
    m_Localized: Da dove vieni?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532418
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532419
    m_Localized: 'NotTrue: Beh, sì, giovanotto... Cosa c''è di male?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532420
    m_Localized: 'NotTrue: I giovani bramano le mie storie, poi mi odiano quando gliele racconto! Bah!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532421
    m_Localized: 'NotTrue: Riesci a immaginare cosa si prova, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532422
    m_Localized: 'NotTrue: Ho una casa. Una vecchia capanna tutta per me.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532423
    m_Localized: 'NotTrue: Mi piace viverci, come no, ma mi sento morire se nessuno viene a trovarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532424
    m_Localized: 'NotTrue: E chi vuoi che venga a visitare una vecchia capanna?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532425
    m_Localized: 'NotTrue: Quindi me ne vado a zonzo, giovanotto. Non ho più niente da perdere.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713862
    m_Localized: 'NotTrue: Sono nata in città, giovanotto. Avevo la mia piccola capanna, in un condominio.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713863
    m_Localized: 'NotTrue: Niente casetta in campagna, niente marito decrepito né nipotini a cui pensare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713864
    m_Localized: 'NotTrue: Allora mi mettevo seduta su una panchina. Per respirare qualche refolo di vita, sai... Oh, quante storie ho sentito.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713865
    m_Localized: 'NotTrue: Ma quando è iniziata questa sciagura, beh, mi è passata la voglia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713866
    m_Localized: 'NotTrue: Bah! Che vita vuoi respirare, quando intorno a te cadono tutti come mosche, diamine?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713867
    m_Localized: 'NotTrue: Ti affacci sul pianerottolo, e c''è sempre qualche poveraccio steso a terra, sotto un lenzuolo bianco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713868
    m_Localized: 'NotTrue: Santo cielo, viene quasi voglia di andarsene all''altro mondo, è troppo dolore da sopportare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713869
    m_Localized: 'NotTrue: Allora ho tolto le tende! Sono andata a cercarmi un posticino che avesse ancora storie da raccontare, e vita da respirare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713870
    m_Localized: 'NotTrue: E guarda te, il destino mi ha condotta alla tua porta, giovanotto!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713871
    m_Localized: 'NotTrue: Ora, io non vado in chiesa, ma con i tempi che corrono... sento che è stato il cielo a guidarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532426
    m_Localized: 'NotTrue: Povera me, sto invecchiando...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532427
    m_Localized: Non hai parenti?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532428
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532429
    m_Localized: 'NotTrue: Oh, del tipo più comune. Racconto le storie di coloro che ho conosciuto nei miei lunghi anni di vita.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532430
    m_Localized: 'NotTrue: Le racconto a chi mi presta orecchio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532431
    m_Localized: 'NotTrue: Ma ora sono anziana, la memoria tende a tradirmi. A volte... modifico qualche dettaglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532432
    m_Localized: 'NotTrue: Sarà per questo che mi odiano tutti, giovanotto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532433
    m_Localized: 'NotTrue: Ascolta queste sagge parole... "La fronte s''aggrotta a un dolore funesto, su tralicci di incubi ci involiamo".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532434
    m_Localized: 'NotTrue: Ma non sono l''unica a sognare orrori più spaventosi del normale, non è vero? Eh eh eh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532435
    m_Localized: 'NotTrue: Tutti vengono da me. Prima o poi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532436
    m_Localized: 'NotTrue: Tutti abbiamo bisogno di storie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713872
    m_Localized: 'NotTrue: Nessuno si ricorda di me, giovanotto...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713873
    m_Localized: 'NotTrue: Chiunque sia sopravvissuto non verrà certo a trovarmi, povera me.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713874
    m_Localized: 'NotTrue: I giovani d''oggi sono tutti così. Talmente presi dalle lore vite che si dimenticano delle nonne.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713875
    m_Localized: 'NotTrue: Sempre a pensare a questo o a quello. E nessuno chiama per sapere come stai. Bah!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713876
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713877
    m_Localized: 'NotTrue: Una volta, mentre ero seduta su quella panchina, una vicina si è messa a sbandierare le virtù di suo nipote.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713878
    m_Localized: 'NotTrue: Diceva: "È un bravo ragazzo! Pensa sempre a sua nonna!".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713879
    m_Localized: 'NotTrue: E beh, non contava mica balle, giovanotto! Ragazzo educatissimo, salutava sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713880
    m_Localized: 'NotTrue: Persino io ho provato un briciolo di invidia...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713881
    m_Localized: 'NotTrue: Poi lei è morta...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713882
    m_Localized: 'NotTrue: E quel ragazzo si è tolto la maschera.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713883
    m_Localized: 'NotTrue: Gli interessava solo l''appartamento della buonanima, comprato con falsi sorrisi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713884
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713885
    m_Localized: 'NotTrue: Perché le persone continuano a mentirsi a vicenda? Guardi negli occhi dei tuoi cari, e ci vedi riflessa la falsità.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713886
    m_Localized: 'NotTrue: Si sposano, fanno figli, e poi... Tutto d''un tratto, non ti vogliono più bene!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713887
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713888
    m_Localized: 'NotTrue: Meno male che mio marito è morto e sepolto. Era un vecchiaccio perfido. Bah!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532437
    m_Localized: 'NotTrue: Povera me, sto invecchiando...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532438
    m_Localized: Cosa è successo a tuo marito?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532439
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532440
    m_Localized: 'NotTrue: Quale storia vorresti ascoltare, giovanotto?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532441
    m_Localized: 'NotTrue: L''uomo è una creatura timorosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532442
    m_Localized: 'NotTrue: Una volta ho conosciuto un tale che si era isolato dal resto del mondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532443
    m_Localized: 'NotTrue: Viveva rintanato all''ultimo piano di un palazzo... e a stento si avventurava fuori.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532444
    m_Localized: 'NotTrue: Forse aveva paura dei Visitatori. O magari della morte stessa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532445
    m_Localized: 'NotTrue: Nessuno si azzardava ad andare a trovarlo. Tanto non avrebbe nemmeno risposto alla porta...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532446
    m_Localized: 'NotTrue: Finché un giorno...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532447
    m_Localized: 'NotTrue: Ho sentito uno strano rumore. Molliccio, come vetro in un barattolo di marmellata di fragole...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532448
    m_Localized: 'NotTrue: Mi sono detta: "Cielo, cosa è stato?".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532449
    m_Localized: 'NotTrue: E quando mi sono affacciata alla finestra, ho visto quell''uomo. Al piano terra, per così dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532450
    m_Localized: 'NotTrue: Si era buttato...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532451
    m_Localized: 'NotTrue: Ti è piaciuta la storia, giovanotto?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532452
    m_Localized: Per niente.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532453
    m_Localized: Tutto qui?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532454
    m_Localized: 'NotTrue: Bah! Sarà per questo che non piaccio a nessuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532455
    m_Localized: 'NotTrue: Ma sappi che... un giorno racconterò anche la tua storia, così come la ricordo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532456
    m_Localized: 'NotTrue: Sì, giovanotto. Da uomo a poltiglia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532457
    m_Localized: 'NotTrue: Forse temeva l''agonia di chi subisce l''ira del sole. O forse no...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532458
    m_Localized: 'NotTrue: Cosa ne penso io? Bah! Per me il suo cuore non ha retto alla solitudine.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532459
    m_Localized: 'NotTrue: Ma cosa possiamo farci, giovanotto?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713889
    m_Localized: 'NotTrue: Oh, ha steso le gambe da un pezzo, giovanotto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713890
    m_Localized: 'NotTrue: Mi ha rovinato la vita, quel vecchio rottame!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713891
    m_Localized: 'NotTrue: Erano stati i miei a insistere per il matrimonio.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713892
    m_Localized: 'NotTrue: "Sposalo, cara, è un brav''uomo", mi dicevano. E allora... ho accettato.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713893
    m_Localized: 'NotTrue: Bada bene, in principio lo è stato! Buono come il pane! Ma passata la festa, è emerso tutto il marciume.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713894
    m_Localized: 'NotTrue: Mi affannavo in cucina tutto il giorno, e qual era il ringraziamento? "Non rompere, sto mangiando".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713895
    m_Localized: 'NotTrue: Poi ha preso a sparire per lunghe ore. Andava a ubriacarsi! Bah!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713896
    m_Localized: 'NotTrue: E quando tornava a casa, ciucco perso, si inventava mille storie. "Stavo giocando a domino in garage".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713897
    m_Localized: 'NotTrue: Oh, ma se solo provavo a chiedergli spiegazioni urlava fino a far tremare i muri, quel vecchio balordo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713898
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713899
    m_Localized: 'NotTrue: Poi è morto...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713900
    m_Localized: 'NotTrue: In principio, mi sono sentita leggera come una piuma! Ma poi il senso di vuoto si è insinuato in me.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713901
    m_Localized: 'NotTrue: La televisione mi è stata d''aiuto, all''inizio, ma ormai è un minestrone di sciocchezze!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713902
    m_Localized: 'NotTrue: Allora ho preso a sedermi su quella panchina. A guardare il mondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532460
    m_Localized: 'NotTrue: Povera me, sto invecchiando...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532461
    m_Localized: Beh, come è andata sulla panchina?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532462
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532463
    m_Localized: 'NotTrue: Ok, giovanotto... Senti questa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532464
    m_Localized: 'NotTrue: C''era questo tale, nel mio villaggio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532465
    m_Localized: 'NotTrue: Amava fare lunghe passeggiate nel bosco. Nessuno sapeva perché, ma intanto lui passeggiava.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532466
    m_Localized: 'NotTrue: Un giorno, durante una delle sue sortite, si è accorto di essersi perso. Non trovava più la via di casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532467
    m_Localized: 'NotTrue: Allora si è fermato a riflettere. "Se continuo a camminare", si è detto, "prima o poi dovrò arrivare da qualche parte".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532468
    m_Localized: 'NotTrue: Ma cammina e cammina, per quanto si impegnasse, non riusciva a uscire dal bosco.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532469
    m_Localized: 'NotTrue: Finché non si è accorto di aver girato in tondo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532470
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532471
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532472
    m_Localized: E poi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532473
    m_Localized: È una storia stupida.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532474
    m_Localized: 'NotTrue: Lo hanno trovato morto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532475
    m_Localized: 'NotTrue: Non è mai uscito dal bosco. Le sue impronte tracciavano un circolo vizioso di sventura.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532476
    m_Localized: 'NotTrue: Sai come si dice, giovanotto. Una gamba è sempre più lunga dell''altra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532477
    m_Localized: 'NotTrue: E ora è lì che marcisce.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532478
    m_Localized: 'NotTrue: Bah! La storia non ti è piaciuta?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532479
    m_Localized: 'NotTrue: Beh, forse ho... aggiunto qualche dettaglio per abbellirla...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532480
    m_Localized: 'NotTrue: Ma è successo davvero. E potrebbe accadere a chiunque!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532481
    m_Localized: 'NotTrue: La gente passeggia e si perde di continuo. Come ritrovano la strada di casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713903
    m_Localized: 'NotTrue: Oh, giovanotto...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713904
    m_Localized: 'NotTrue: Osservare il mondo mi faceva sentire meglio. Le risate dei bambini, le coppiette innamorate, i cani al passeggio...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713905
    m_Localized: 'NotTrue: Ma poi è arrivata quest''altra scocciatura... Bah!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713906
    m_Localized: 'NotTrue: La gente ha iniziato a chiudersi in casa. E questa nonna seduta in panchina è rimasta sola, abbandonata dalla vita.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713907
    m_Localized: 'NotTrue: Non che lo spettacolo fosse migliore, dalla finestra...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713908
    m_Localized: 'NotTrue: Niente più saluti festosi, né risate di bambini. Solo cani randagi e vicini che si guardano con sospetto, come fossero sconosciuti.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713909
    m_Localized: 'NotTrue: La vita, giovanotto, s''era fatta immota.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713910
    m_Localized: 'NotTrue: E ora... Bah! Non si riesce più a distinguere le panzane dalla verità!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713911
    m_Localized: 'NotTrue: Oh, vorrei tanto che la smettessero di mentire, giovanotto...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532482
    m_Localized: 'Alkonost: Ah, qualcuno mi doni le forze, devo rimettermi in sesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532483
    m_Localized: Come sta tua sorella?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532484
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532485
    m_Localized: 'Alkonost: Devo aiutarla. In un mucchio di cose.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532486
    m_Localized: 'Alkonost: Ieri sono riuscita a farle il bagno. A casa si rifiutava persino di entrare nella vasca.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532487
    m_Localized: 'Alkonost: È ancora in quello stato. Ma grazie per la domanda.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532488
    m_Localized: 'Alkonost: La depressione può... complicare le cose.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532489
    m_Localized: 'Alkonost: Se ci ritrovassimo a dover fuggire, temo che non proverebbe nemmeno ad alzarsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532490
    m_Localized: 'Alkonost: Ho anche paura che muoia di fame, perché non si sforza più nemmeno di masticare o inghiottire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532491
    m_Localized: 'Alkonost: Sono stanca anch''io. Andrò a riposare...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532492
    m_Localized: 'Alkonost: Ah, qualcuno mi doni le forze, devo rimettermi in sesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532493
    m_Localized: Cosa hai intenzione di fare adesso?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532494
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532495
    m_Localized: 'Alkonost: Ottima domanda.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532496
    m_Localized: 'Alkonost: Mio marito dovrebbe raggiungerci presto. Spero che abbia trovato un posto sicuro dove stare.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532497
    m_Localized: 'Alkonost: Lì potremo attendere che gli assalti dei Visitatori e il calore del sole si esauriscano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532498
    m_Localized: 'Alkonost: Dice che posti del genere esistono. E anche che il sole non sta per esplodere.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532499
    m_Localized: 'Alkonost: Perché altrimenti verremmo spazzati via in meno di dieci minuti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532500
    m_Localized: 'Alkonost: Credo che abbia ragione.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532501
    m_Localized: 'Alkonost: Ah, qualcuno mi doni le forze, devo rimettermi in sesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532502
    m_Localized: Novità da tuo marito?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532503
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532504
    m_Localized: 'Alkonost: Non l''ho sentito... Per qualche motivo non mi ha chiamata, né si è fatto vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532505
    m_Localized: 'Alkonost: Gli sarà successo qualcosa? Si è cacciato in qualche guaio?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532506
    m_Localized: 'Alkonost: Non ci ha abbandonate, di questo sono certa. È impossibile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532507
    m_Localized: 'Alkonost: Non ne poteva più di mia sorella, eppure mi ha sempre aiutata a prendermi cura di lei.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532508
    m_Localized: 'Alkonost: Sarà... Sarà qui presto, lo so.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532509
    m_Localized: 'Alkonost: E mia sorella sta un po'' meglio, quindi... Verrà di certo. E quando sarà qui, tutto si aggiusterà.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532510
    m_Localized: 'Alkonost: Ah, qualcuno mi doni le forze, devo rimettermi in sesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532511
    m_Localized: Sembri triste.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532512
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532513
    m_Localized: 'Alkonost: Sì?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532514
    m_Localized: 'Alkonost: Oh. Non mi stupisce, onestamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532515
    m_Localized: 'Alkonost: Ho tanti pensieri per la testa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532516
    m_Localized: 'Alkonost: Se il sole non sta per esplodere, perché il caldo non ci dà tregua? Perché dicono tutti che il mondo sta per finire?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532517
    m_Localized: 'Alkonost: L''ho sentito al telegiornale.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532518
    m_Localized: 'Alkonost: Non l''hanno detto apertamente, ma sembra che le temperature continueranno a salire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532519
    m_Localized: 'Alkonost: Il clima sta cambiando, e gli animali muoiono perché non riescono ad adattarsi alle nuove... condizioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532520
    m_Localized: 'Alkonost: Cosa ne sarà di noi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532521
    m_Localized: 'Alkonost: Ah, qualcuno mi doni le forze, devo rimettermi in sesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532522
    m_Localized: Come ti senti?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532523
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532524
    m_Localized: 'Alkonost: Ieri notte sono uscita per cercare mio marito.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532525
    m_Localized: 'Alkonost: Mi erano venuti in mente un paio di posti promettenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532526
    m_Localized: 'Alkonost: E l''ho trovato... Aveva preso una delle pillole.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532527
    m_Localized: 'Alkonost: Dovevamo... prenderle insieme. Se fosse finita male.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532528
    m_Localized: 'Alkonost: Ma l''ha fatto da solo. Era troppo spaventato. Non ha aspettato che mi unissi a lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532529
    m_Localized: 'Alkonost: Proprio così. Ha inghiottito la pillola prima che il sole inghiottisse lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532530
    m_Localized: 'Sirin: È la fine, ormai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532531
    m_Localized: Come ti senti?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532532
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532533
    m_Localized: 'Sirin: Mi sento...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532534
    m_Localized: 'Sirin: Come se il mio intero corpo fosse avvinto da un manto di catene. È un peso intollerabile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532535
    m_Localized: 'Sirin: E mi sta abbattendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532536
    m_Localized: 'Sirin: Voglio... liberarmene.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532537
    m_Localized: 'Sirin: È la fine, ormai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532538
    m_Localized: Sei sempre l'anima della festa, vedo.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532539
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532540
    m_Localized: 'Sirin: Sì. Certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532541
    m_Localized: 'Sirin: Hai saputo del sole? Che sta esplodendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532542
    m_Localized: 'Sirin: Io l''ho scoperto stanotte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532543
    m_Localized: 'Sirin: La fine è vicina, quindi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532544
    m_Localized: 'Sirin: Non sopravvivrà nemmeno una flebile traccia della nostra esistenza?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532545
    m_Localized: 'Sirin: Se ci pensi, è interessante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532546
    m_Localized: 'Sirin: È la fine, ormai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532547
    m_Localized: Come sta tua sorella?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532548
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532549
    m_Localized: 'Sirin: Ha paura di perdere tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532550
    m_Localized: 'Sirin: Ma io credo che non abbia nulla da perdere.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532551
    m_Localized: 'Sirin: Non siamo che granelli di polvere in un universo in perenne espansione.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532552
    m_Localized: 'Sirin: Nessuno ha bisogno di noi. Siamo soli.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532553
    m_Localized: 'Sirin: Se il nostro pianeta sparisse, nessuno piangerebbe per noi. Perché non resterebbe più nulla.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532554
    m_Localized: 'Sirin: Ma mia sorella è terrorizzata da questa prospettiva.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532555
    m_Localized: 'Sirin: È la fine, ormai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532556
    m_Localized: Tua sorella sta male?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532557
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532558
    m_Localized: 'Sirin: Sì, vuole uscire a cercare il marito per distrarsi da tutti gli orrori che ci circondano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532559
    m_Localized: 'Sirin: Io ho un pessimo presentimento, ma lei non sopporta l''idea di starsene a poltrire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532560
    m_Localized: 'Sirin: E se insiste a volerlo cercare, mi toccherà accompagnarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532561
    m_Localized: 'Sirin: Non voglio perderla prima che sia tutto finito.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532562
    m_Localized: 'Sirin: È la fine, ormai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532563
    m_Localized: Quindi, siete uscite?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532564
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532565
    m_Localized: 'Sirin: Sì. Ha trovato il corpo di suo marito.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532566
    m_Localized: 'Sirin: "Tutto si aggiusterà", le ripeteva, poi ha scelto la scappatoia più facile, il codardo. Non ha voluto attendere la vera fine.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532567
    m_Localized: 'Sirin: Credo abbia perso le ultime forze che le restavano.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726592
    m_Localized: 'Sirin: Ora dovrò occuparmi di lei finché la morte non verrà a prenderci.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726593
    m_Localized: 'Sirin: E compiutosi quell''ultimo istante, non ci saranno più ansie, paure, timori o rimorsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166080
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166081
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166082
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166083
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166084
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166085
    m_Localized: 'Alkonost: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166086
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166087
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166088
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166089
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166090
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166091
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360384
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360385
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360386
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360387
    m_Localized: Lascia in pace
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083328
    m_Localized: 'Firefighter: Accidenti... *coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083329
    m_Localized: 'Firefighter: Ehi, amico... Se non è troppo disturbo... Potresti chiamare questo numero: {0}...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083330
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083331
    m_Localized: 'Firefighter: Non voglio che vengano a prendermi. Non chiedo un ultimo addio... *coff* Voglio solo che sappiano...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083332
    m_Localized: 'Firefighter: Che papà non è scappato. Che è rimasto... ad aiutare chi aveva bisogno di lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083333
    m_Localized: 'Firefighter: *coff coff* È l''unica cosa che conta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083334
    m_Localized: 'Theorist: Hai qualcosa da dirmi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083335
    m_Localized: Cosa sono quei fogli?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083336
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083337
    m_Localized: 'Theorist: Tu non hai idea di cosa c''è in questi documenti. Giuro, alcuni dettagli sono proprio affascinanti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083338
    m_Localized: 'Theorist: Guarda qui, per esempio. È una teoria a dir poco stramba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083339
    m_Localized: 'Theorist: Afferma che i Visitatori non sono reali... bensì parte di un piano governativo segreto per ridurre la popolazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083340
    m_Localized: 'Theorist: Lettura stimolante! E se ci pensi... nemmeno troppo campata in aria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083341
    m_Localized: 'Theorist: Riflettiamoci... La sovrappopolazione è un problema noto, no? È una verità innegabile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083342
    m_Localized: 'Theorist: Supponiamo che questa sia la soluzione trovata dal governo per "gestirla"... Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083343
    m_Localized: 'Theorist: Hai qualcosa da dirmi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083344
    m_Localized: Stai ancora studiando quei documenti?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083345
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083346
    m_Localized: 'Theorist: Esattamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083347
    m_Localized: 'Theorist: E ne ho ancora parecchi da spulciare, nel caso fossi interessato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083348
    m_Localized: 'Theorist: Ecco, guarda qua, per dire...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083349
    m_Localized: 'Theorist: C''è scritto che FEMA e Visitatori sono la stessa cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083350
    m_Localized: 'Theorist: E poiché vanno in giro coperti da quelle tute, non c''è modo di sottoporli ai test. Plausibile, non trovi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083351
    m_Localized: 'Theorist: Affascinante... In particolare il paragrafo in cui viene spiegato che FEMA starebbe per "Fondazione per l''Epurazione Massiccia Accelerata".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083352
    m_Localized: 'Theorist: O forse... ricordo male?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083353
    m_Localized: 'Theorist: Hai qualcosa da dirmi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083354
    m_Localized: Allora, cosa hai scoperto stavolta?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083355
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083356
    m_Localized: 'Theorist: Visitatori. Mutaforma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083357
    m_Localized: 'Theorist: Sembrano usciti da un romanzo di fantascienza, ne convieni?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083358
    m_Localized: 'Theorist: Eppure è tutto vero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083359
    m_Localized: 'Theorist: Ascolta qui... Uno dei rapporti menziona una figura pallida che si aggira per le strade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083360
    m_Localized: 'Theorist: Anche se, va sottolineato... l''autore ha commesso un palese errore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083361
    m_Localized: 'Theorist: Afferma che esistono DUE figure pallide e minacciose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083362
    m_Localized: 'Theorist: Una è visibile dalla finestra, l''altra si presenta alla porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083363
    m_Localized: 'Theorist: Sciocchezze! Non è ovvio che siano la stessa entità?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083364
    m_Localized: 'Theorist: Scommetto che la finestra ha distorto la visuale dell''autore... Un errore di percezione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083365
    m_Localized: 'Theorist: Ciò detto... È affascinante, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083366
    m_Localized: 'Theorist: Hai qualcosa da dirmi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083367
    m_Localized: E se fosse vero?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083368
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083369
    m_Localized: 'Theorist: Cos''è la verità, dopotutto? Un concetto mutevole, plasmato dalla prospettiva.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083370
    m_Localized: 'Theorist: La verità di uno è l''illusione di un altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083371
    m_Localized: 'Theorist: Ciò che a noi appare buono, per altri è il male assoluto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083372
    m_Localized: 'Theorist: L''umanità disquisisce di virtù e peccati da tempo immemore. E ora ogni senso comune della moralità è andato a farsi benedire!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083373
    m_Localized: 'Theorist: Se la tua fede è forte quanto la mia, si tramuta in verità.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083374
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083375
    m_Localized: 'Theorist: Uhm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083376
    m_Localized: 'Theorist: È un articolo molto stimolante... Beh, di cosa stavamo parlando? Ah, sì, della verità.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083377
    m_Localized: 'Theorist: Se è la verità che vuoi conoscere, ascolta bene. I Visitatori sono... parassiti cerebrali.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083378
    m_Localized: 'Theorist: Mettiti i tappi nelle orecchie. SEMPRE! Non concedergli la minima opportunità!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083379
    m_Localized: 'Theorist: Ho altro da leggere, comunque... Ti dispiace? Devo concentrarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083380
    m_Localized: 'Wifefema: Cosa vuoi adesso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083381
    m_Localized: Hai detto che lavoravi alla dogana?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083382
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083383
    m_Localized: 'Wifefema: Ci lavoravo eccome.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083384
    m_Localized: 'Wifefema: A tal proposito, stai verificando che i tuoi ospiti non mostrino i segni dei Visitatori, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083385
    m_Localized: 'Wifefema: Non per ribadire l''ovvio, sia chiaro, ma... sai com''è.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083386
    m_Localized: 'Wifefema: Chi ha avuto la splendida idea di chiamarli "Visitatori", comunque?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083387
    m_Localized: 'Wifefema: "Mostri" sarebbe bastato...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083388
    m_Localized: 'Wifefema: Cosa vuoi adesso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083389
    m_Localized: Perché odi i Visitatori?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083390
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083391
    m_Localized: 'Wifefema: Che diamine di domanda sarebbe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083392
    m_Localized: 'Wifefema: Perché è colpa loro se tutto sta andando in malora! Non lo guardi il telegiornale?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083393
    m_Localized: 'Wifefema: Il sole sta per esplodere. La gente muore per strada. Ed è solo colpa loro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083394
    m_Localized: 'Wifefema: Giuro su Dio, se potessi li ammazzerei tutti con le mie mani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083395
    m_Localized: 'Wifefema: Avrei solo bisogno di tempo. Li scoverei uno per uno come facevo al confine. State a guardare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083396
    m_Localized: 'Wifefema: La FEMA ha commesso un grosso errore a non volermi con loro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083397
    m_Localized: 'Wifefema: Cosa vuoi adesso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083398
    m_Localized: Perché ci tieni tanto a lavorare per la FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083399
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083400
    m_Localized: 'Wifefema: Perché mi importa, ecco perché.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083401
    m_Localized: 'Wifefema: So che i Visitatori possono essere fermati. Devono essere fermati, diamine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083402
    m_Localized: 'Wifefema: Sto già facendo la mia parte... L''altro giorno ho denunciato il nostro vicino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083403
    m_Localized: 'Wifefema: E loro, in tutta risposta, hanno assunto mio marito! Roba da matti!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083404
    m_Localized: 'Wifefema: Non fraintendermi, sono fiera di lui. Però, insomma...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083405
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083406
    m_Localized: 'Wifefema: Onestamente, mi è sembrato un affronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083407
    m_Localized: 'Wifefema: Cosa vuoi adesso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083408
    m_Localized: Perché hai denunciato il tuo vicino?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083409
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083410
    m_Localized: 'Wifefema: Hai le orecchie imbottite di cerume? Te l''ho spiegato, era un Visitatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083411
    m_Localized: 'Wifefema: E mi metteva a disagio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083412
    m_Localized: 'Wifefema: Denunciarlo mi ha fatto sentire bene, inoltre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083413
    m_Localized: 'Wifefema: Come ai vecchi tempi, quando difendevo i confini della nazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083414
    m_Localized: 'Wifefema: È stato allora che ho capito... che dovevo unirmi alla FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083415
    m_Localized: 'Wifefema: Cosa vuoi adesso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083416
    m_Localized: Non sei qui per tuo marito, ma per la FEMA. Non è vero?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083417
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083418
    m_Localized: 'Wifefema: Sì, e quindi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083419
    m_Localized: 'Wifefema: Sono venuta a fare baccano finché qualcuno ai piani alti non si degnerà di ascoltarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083420
    m_Localized: 'Wifefema: Voglio oppormi al loro rifiuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083421
    m_Localized: 'Wifefema: Ho acciuffato io il Visitatore. Ho svolto il mio dovere civico. E loro assumono LUI? Non fatemi ridere!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083422
    m_Localized: 'Wifefema: Signore nei cieli, non ha il minimo senso. È un''idiozia!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083423
    m_Localized: 'Wifefema: Io lo odio. Lo odio con tutta l''anima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083424
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083425
    m_Localized: 'Wifefema: Ehi, avrei un piccolo favore da chiederti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083426
    m_Localized: 'Wifefema: Li chiameresti? Usa la linea interna, c''è un numero speciale: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083427
    m_Localized: 'Wifefema: Digli che hai conosciuto una che ne sa: una donna esperta e grintosa. Puoi anche menzionare mio marito, se vuoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083428
    m_Localized: 'Wifefema: L''importante è che le spari grosse. Così dovranno per forza coinvolgermi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083429
    m_Localized: 'Wifefema: Cosa vuoi adesso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083430
    m_Localized: Stavi meglio alla dogana, eh? Almeno avevi un minimo di potere...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083431
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083432
    m_Localized: 'Wifefema: Oh, non fare troppo lo splendido, signorino!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083433
    m_Localized: 'Wifefema: Non ricordo di aver chiesto la tua opinione, quindi scendi dal piedistallo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083434
    m_Localized: 'Wifefema: Ti senti un grande a comandare, eh? La gente viene qui, a casa tua...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083435
    m_Localized: 'Wifefema: E la scelta finale spetta a te: decidi tu chi è un Visitatore e chi no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083436
    m_Localized: 'Wifefema: Ma non è il tuo lavoro. È il lavoro della FEMA. Tu stai solo giocando a fare il giudice, la giuria e il boia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083437
    m_Localized: 'Wifefema: Almeno la FEMA dispone dell''autorità necessaria. Pensi sul serio di essere migliore di loro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083438
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083439
    m_Localized: 'Wifefema: Esatto, proprio come pensavo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083440
    m_Localized: 'Raskolnikov: Oh, diamine... Devo imparare assolutamente a uccidere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083441
    m_Localized: Vuoi ancora assistere all'uccisione di un Visitatore?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083442
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083443
    m_Localized: 'Raskolnikov: Sinceramente... No. H‑Ho cambiato idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083444
    m_Localized: 'Raskolnikov: È da codardi, l‑lo so. Mi dispiace! Ma mi sono accorto... di non essere pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083445
    m_Localized: 'Raskolnikov: La vista di un cadavere mi dà ancora la nausea... M‑Mi servirà del tempo per abituarmici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083446
    m_Localized: 'Raskolnikov: E poi, riguardo ai Visitatori... Ho sentito che i loro cadaveri continuano a muoversi. Dopo la morte, intendo. Come quel tizio nel vicolo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083447
    m_Localized: 'Raskolnikov: Ghhh, al solo pensiero mi viene il voltastomaco. Non sono pronto, nemmeno lontanamente. Scusami...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083448
    m_Localized: 'Raskolnikov: Oh, diamine... Devo imparare assolutamente a uccidere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083449
    m_Localized: Cosa è successo nel vicolo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083450
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083451
    m_Localized: 'Raskolnikov: Oh... P‑Parlarne non è facile, m‑ma... ci proverò.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083452
    m_Localized: 'Raskolnikov: Allora... Pensavo che i vicoli fossero più sicuri, mi segui?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083453
    m_Localized: 'Raskolnikov: Ma quando ho girato l''angolo, è stato come entrare in un cimitero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083454
    m_Localized: 'Raskolnikov: C''erano... corpi ovunque. C‑Cadaveri!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083455
    m_Localized: 'Raskolnikov: E qualcuno si muoveva ancora! Come se non fossero... morti del tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083456
    m_Localized: 'Raskolnikov: E poi, in fondo al vicolo... c''era questo tizio armato, e lui...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083457
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083458
    m_Localized: 'Raskolnikov: No... Basta. Non v‑voglio pensarci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083459
    m_Localized: 'Raskolnikov: Oh, diamine... Devo imparare assolutamente a uccidere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083460
    m_Localized: Parlami dell'uomo nel vicolo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083461
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083462
    m_Localized: 'Raskolnikov: Allora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083463
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083464
    m_Localized: 'Raskolnikov: Indossava una specie di mantello, coperto di... collane, fatte di dita e denti, e poi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083465
    m_Localized: 'Raskolnikov: Accanto a lui c''era un ragazzino dall''aria disperata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083466
    m_Localized: 'Raskolnikov: E l''uomo con il mantello gli urlava contro mentre gli puntava l''arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083467
    m_Localized: 'Raskolnikov: Gli gridava di mostrargli i denti... mentre il poverino implorava pietà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083468
    m_Localized: 'Raskolnikov: Io mi ero nascosto dietro un cassonetto, e diamine... Non ho potuto fare a meno di immaginarmi nei suoi panni...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083469
    m_Localized: 'Raskolnikov: Il ragazzino piangeva. A dirotto, dico, supplicandolo di risparmiarlo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083470
    m_Localized: 'Raskolnikov: E poi... BANG! È caduto a terra, in mezzo agli altri cadaveri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083471
    m_Localized: 'Raskolnikov: È stato allora che ho capito... Ormai al mondo esistono due tipi di persone: i predatori e le prede.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083472
    m_Localized: 'Raskolnikov: Oh, diamine... Devo imparare assolutamente a uccidere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083473
    m_Localized: Non devi diventare per forza un assassino spietato, per sopravvivere.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083474
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083475
    m_Localized: 'Raskolnikov: S‑Sei matto? Certo che sì!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083476
    m_Localized: 'Raskolnikov: Tu sei ancora vivo perché hai tirato fuori gli artigli come un predatore! È p‑per questo che nessuno osa sfiorarti!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083477
    m_Localized: 'Raskolnikov: Finché il prossimo ha paura di te, sei al sicuro, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083478
    m_Localized: 'Raskolnikov: Non voglio essere una preda. Non voglio morire piangendo come un codardo. Io... Io...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277632
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277633
    m_Localized: 'Raskolnikov: È per questo che devo imparare a uccidere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277634
    m_Localized: 'Nun: Padre nostro che sei nei cieli...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277635
    m_Localized: Beh, cosa te ne pare della casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277636
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277637
    m_Localized: 'Nun: È squallida, figliolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277638
    m_Localized: 'Nun: Le pareti sono storte, e la disposizione delle camere non ha senso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277639
    m_Localized: 'Nun: Dimmi, l''hai fatto apposta ad assegnarmi la stanzetta più miserabile che avevi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277640
    m_Localized: 'Nun: I mobili sono vecchi e fatiscenti... E se li staranno divorando le altre tue ospiti: le tarme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277641
    m_Localized: 'Nun: Non potevi almeno scegliere un luogo più dignitoso dove appendere la croce?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277642
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277643
    m_Localized: 'Nun: Perché mi metti alla prova, Signore?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277644
    m_Localized: 'Nun: Padre nostro che sei nei cieli...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277645
    m_Localized: Se odi tanto stare qui, perché non te ne vai?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277646
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277647
    m_Localized: 'Nun: Pensi che abbia scelto io di entrare in questa topaia? Se il monastero fosse ancora in piedi, non avrei certo lasciato la mia sacra dimora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277648
    m_Localized: 'Nun: Cosa vuoi che mi importi di questo cumulo di macerie marcescenti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277649
    m_Localized: 'Nun: No, se avessi avuto scelta, non sarei mai venuta qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277650
    m_Localized: 'Nun: A te piace crogiolarti nella violenza. Qui dentro c''è puzza di morte, il Signore mi è testimone!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277651
    m_Localized: 'Nun: Abbatti con furia vendicativa chiunque ritieni un demone.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277652
    m_Localized: 'Nun: E chi mi dice che non lo sia anche tu? Potrebbero spuntarti le corna da un momento all''altro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277653
    m_Localized: 'Nun: Ma posso tollerare queste trasgressioni. Il Padre celeste ha cura del suo gregge.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277654
    m_Localized: 'Nun: Padre nostro che sei nei cieli...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277655
    m_Localized: Perché hai lasciato il tuo monastero?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277656
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277657
    m_Localized: 'Nun: Innanzitutto, il monastero non è mio. È la casa del Signore onnipotente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277658
    m_Localized: 'Nun: In secondo luogo, è stata colpa di quei blasfemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277659
    m_Localized: 'Nun: Hanno deturpato i Suoi luoghi sacri. Che l''ira divina li purifichi con le fiamme!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277660
    m_Localized: 'Nun: Hanno invaso la nostra dimora e hanno trascinato via il mio gregge... e me con loro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277661
    m_Localized: 'Nun: Hanno preso possesso di ciò che non gli appartiene... Branco di barbari e profanatori!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277662
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277663
    m_Localized: 'Nun: Vivevamo nell''ordine e nella sacralità. Pregavamo e digiunavamo secondo i Suoi precetti. E quelle bestie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277664
    m_Localized: 'Nun: Staranno bevendo l''acqua santa come se fosse vino di bassa lega. Sacrilegio!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277665
    m_Localized: 'Nun: Spero che gli vada di traverso, amen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277666
    m_Localized: 'Nun: Padre nostro che sei nei cieli...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277667
    m_Localized: Cosa volevano quei "blasfemi"?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277668
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277669
    m_Localized: 'Nun: Sono venuti in massa, spavaldi nel loro lerciume. Gridando e imprecando come selvaggi senza Dio!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277670
    m_Localized: 'Nun: E perché? Perché mi ero rifiutata di farli entrare! Ero stata chiara: chi non è battezzato non può varcare questa soglia!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277671
    m_Localized: 'Nun: Dio santo, se si sono infuriati. Oh, sì... Hanno picchiato sulle porte, minacciando di sfondarle!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277672
    m_Localized: 'Nun: E quando sono riusciti a entrare, mi hanno sbattuta fuori!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277673
    m_Localized: Hai rifiutato il tuo aiuto ai bisognosi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277674
    m_Localized: Avrei potuto sbatterti fuori anch'io.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277675
    m_Localized: 'Nun: Un monastero non è tenuto a offrire asilo a chi rifugge la luce di Dio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277676
    m_Localized: 'Nun: Che cercassero riparo dal sole o protezione dai cosiddetti Visitatori, non ha alcuna importanza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277677
    m_Localized: 'Nun: Anche se i cieli stessi prorompessero in una pioggia di fuoco, nella dimora del Signore non c''è spazio per simili abomini!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277678
    m_Localized: 'Nun: La misericordia del Signore è appannaggio dei fedeli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277679
    m_Localized: 'Nun: Se bruceranno vivi in mezzo a una strada, sarà stato per volontà di Dio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277680
    m_Localized: Sei spregevole, ma non sta a me giudicare.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277681
    m_Localized: Va' via, prima che spedisca anche te all'inferno.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277682
    m_Localized: 'Nun: Miserabile insolente!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277683
    m_Localized: 'Nun: Hai perso il senno?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277684
    m_Localized: 'Nun: Sono una suora di nostro Signore onnipotente! Vermi infedeli mi hanno cacciata di casa. E tu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277685
    m_Localized: 'Nun: Tu osi dileggiarmi? Insinui che me lo sono meritato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277686
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277687
    m_Localized: 'Nun: Non sei un uomo. Sei una serpe!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277688
    m_Localized: 'Nun: BLASFEMO! SEI SOLO UN BLASFEMO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277689
    m_Localized: 'Nun: Speravo che avresti capito, ma non sei migliore degli altri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277690
    m_Localized: 'Nun: Siamo al Suo servizio! AL SERVIZIO DEL SIGNORE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277691
    m_Localized: 'Nun: Possiamo solo accettare la Sua volontà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277692
    m_Localized: 'Nun: Le vie del Signore sono imperscrutabili! Non sta a noi dubitare del disegno divino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277693
    m_Localized: Sei spregevole, ma non sta a me giudicare.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277694
    m_Localized: Va' via, prima che spedisca anche te all'inferno.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277695
    m_Localized: 'Nun: Oh, quindi ora ti dai arie da salvatore?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277696
    m_Localized: 'Nun: Tieniti la tua lurida casa. Non resterò un altro minuto in questa stamberga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277697
    m_Localized: 'Nun: Addio, figliolo. Che l''ira di Dio ricada su di te!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277698
    m_Localized: 'Nun: Non avevo alcuna intenzione di restare, comunque.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277699
    m_Localized: 'Nun: Dal momento in cui ho messo piede in questa casa ho capito che qui non c''è posto per Dio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277700
    m_Localized: 'Nun: Forse sta guidando i miei passi anche adesso, conducendomi altrove.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277701
    m_Localized: 'Nun: Addio, figliolo. Che l''ira di Dio ricada su di te!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277702
    m_Localized: 'Fugitive: Dannata ferita...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277703
    m_Localized: Perché ti cercava la FEMA, comunque?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277704
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277705
    m_Localized: 'Fugitive: Non ne sono sicuro, ma una mezza idea ce l''ho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277706
    m_Localized: 'Fugitive: Pensavo fosse uno dei soliti rastrellamenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277707
    m_Localized: 'Fugitive: Ma ci scommetto le chiappe che è stata la stronza della porta accanto a denunciarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277708
    m_Localized: 'Fugitive: Ci detestavamo a vicenda. Allora ha colto l''occasione al volo, additandomi come "Visitatore".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277709
    m_Localized: 'Fugitive: Deve sentirsi taaanto soddisfatta di sé, quella troia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277710
    m_Localized: 'Fugitive: Dannata ferita...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277711
    m_Localized: Come ti senti?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277712
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277713
    m_Localized: 'Fugitive: Sto bene, davvero. Va meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277714
    m_Localized: 'Fugitive: Te l''ho detto, il proiettile non ha colpito organi vitali.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277715
    m_Localized: 'Fugitive: Dovremmo piantarla di sbranarci come belve. Ma chi doveva incontrare un pazzoide dal grilletto facile? Io, ovviamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277716
    m_Localized: 'Fugitive: Presto finiremo a dormire tutti sotto terra, visto che sopra non facciamo altro che tormentarci a vicenda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277717
    m_Localized: 'Fugitive: Al diavolo... Vivi e lascia morire, dico io.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277718
    m_Localized: 'Fugitive: Avresti dovuto vederlo, il matto che mi ha sparato. Faceva paura, il bastardo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277719
    m_Localized: Matto? Non è stato un membro della FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277720
    m_Localized: Di quale matto stai parlando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277721
    m_Localized: 'Fugitive: S‑Sì, esatto, era uno di quei porci della FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277722
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277723
    m_Localized: Dimmi la verità.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277724
    m_Localized: Piantala, sei un pessimo bugiardo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277725
    m_Localized: 'Fugitive: Beh, sì... Sto parlando di uno di quei porci della FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277726
    m_Localized: 'Fugitive: Aveva un''aria minacciosa... quando eravamo faccia a faccia...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277727
    m_Localized: 'Fugitive: Cioè... Ehm... Quando mi ha sparato alle spalle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277728
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277729
    m_Localized: Dimmi la verità.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277730
    m_Localized: Piantala, sei un pessimo bugiardo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277731
    m_Localized: 'Fugitive: Va bene, va bene...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277732
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277733
    m_Localized: 'Fugitive: È vero che sono scappato dalla zona di quarantena... Ma non c''è stata nessuna sparatoria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277734
    m_Localized: 'Fugitive: Mi ha aiutato un medico. Ha falsificato i documenti per farmi dimettere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277735
    m_Localized: 'Fugitive: Ma non potevo certo tornarmene a casa. Quella stronza della vicina mi avrebbe denunciato di nuovo, a cuor leggero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277736
    m_Localized: 'Fugitive: Allora mi sono messo a cercare un rifugio. Così ho incontrato quel pazzoide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277737
    m_Localized: 'Fugitive: Volevo solo chiedergli se conosceva un posto dove passare la notte, ma poi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277738
    m_Localized: 'Fugitive: L''ho guardato meglio... Il fucile sulla schiena, la collana di denti e dita, il vicolo ingombro di cadaveri...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277739
    m_Localized: 'Fugitive: Sì... In quel momento ho capito di avere davanti un pazzo furioso... Argh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277740
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277741
    m_Localized: 'Fugitive: Scusa, la ferita si è risvegliata. Ti dispiace se vado a stendermi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277742
    m_Localized: 'Fugitive: Merda...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277743
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277744
    m_Localized: 'Fugitive: Ascolta, ti spiegherò tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277745
    m_Localized: 'Fugitive: È vero che sono scappato dalla zona di quarantena... Ma non c''è stata nessuna sparatoria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277746
    m_Localized: 'Fugitive: Mi ha aiutato un medico. Ha falsificato i documenti per farmi dimettere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277747
    m_Localized: 'Fugitive: Ma non potevo certo tornarmene a casa. Quella stronza della vicina mi avrebbe denunciato di nuovo, a cuor leggero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277748
    m_Localized: 'Fugitive: Allora mi sono messo a cercare un rifugio. Così ho incontrato quel pazzoide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277749
    m_Localized: 'Fugitive: Volevo solo chiedergli se conosceva un posto dove passare la notte, ma poi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277750
    m_Localized: 'Fugitive: L''ho guardato meglio... Il fucile sulla schiena, la collana di denti e dita, il vicolo ingombro di cadaveri...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277751
    m_Localized: 'Fugitive: Sì... In quel momento ho capito di avere davanti un pazzo furioso... Argh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277752
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277753
    m_Localized: 'Fugitive: Scusa, la ferita si è risvegliata. Ti dispiace se vado a stendermi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277754
    m_Localized: 'Fugitive: Dannata ferita...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277755
    m_Localized: Parlami del matto con il fucile d'assalto.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277756
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277757
    m_Localized: 'Fugitive: Giusto, lo svitato addobbato di denti e dita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277758
    m_Localized: 'Fugitive: Quando ha visto che esitavo, mi ha puntato il fucile, ma sono riuscito ad afferrarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277759
    m_Localized: 'Fugitive: Abbiamo lottato per un minuto, contendendoci l''arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277760
    m_Localized: 'Fugitive: Poi mi ha sparato. Un istante dopo l''ho colpito con una testata così forte da spedirlo al tappeto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277761
    m_Localized: 'Fugitive: Mi sono messo a correre, senza guardarmi indietro. Poi mi è esploso il dolore nelle viscere... Argh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277762
    m_Localized: 'Fugitive: E quando ho abbassato lo sguardo, c''era sangue ovunque.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277763
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277764
    m_Localized: 'Fugitive: Non ti ho detto che mi aveva sparato perché temevo che mi avresti sbattuto la porta in faccia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277765
    m_Localized: 'Fugitive: Di questi tempi, ognuno deve pensare a sé stesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277766
    m_Localized: 'Fugitive: Sii onesto. Mi avresti lasciato entrare se avessi saputo che avevo uno psicopatico armato alle calcagna?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277767
    m_Localized: 'Fugitive: Mi serviva un rifugio. Non volevo morire come quei poveracci nel vicolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277768
    m_Localized: 'Fugitive: E allora sì, cazzo, ho mentito. Mi auguro che tu possa capire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277769
    m_Localized: D'accordo, puoi restare.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277770
    m_Localized: Non posso fidarmi di te. Devi andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277771
    m_Localized: 'Fugitive: Grazie. Significa molto per me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277772
    m_Localized: 'Fugitive: È un bene che anche tu sia armato, ovviamente. Ma speriamo che quel matto non si faccia vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277773
    m_Localized: 'Fugitive: Con un pizzico di fortuna, l''avrà già sistemato qualcun altro. Quel Visitatore pallido, magari?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277774
    m_Localized: 'Fugitive: Ecco... Avevo ragione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277775
    m_Localized: 'Fugitive: Ora capisci perché ho mentito?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277776
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277777
    m_Localized: 'Fugitive: Stammi bene, stronzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277778
    m_Localized: 'Bestson: Oh, no... Che fine hanno fatto...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277779
    m_Localized: Come va?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277780
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277781
    m_Localized: 'Bestson: Non lo so... Vorrei solo che i miei ritornassero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277782
    m_Localized: 'Bestson: Si sono presi cura di me per tutta la vita, e ora... non so cosa gli sia successo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277783
    m_Localized: 'Bestson: Accidenti, spero stiano bene. Non riesco a immaginare di vivere senza di loro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277784
    m_Localized: 'Bestson: Oh, no... Che fine hanno fatto...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277785
    m_Localized: Non hai altri parenti?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277786
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277787
    m_Localized: 'Bestson: Non direi. Oh, in effetti...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277788
    m_Localized: 'Bestson: Di recente, ho scoperto di avere una sorella maggiore. Dal primo matrimonio di mio padre, però...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277789
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277790
    m_Localized: 'Bestson: Oh, merda, la nonna!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277791
    m_Localized: 'Bestson: Forse ho capito dove sono andati i miei genitori...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277792
    m_Localized: 'Bestson: E se la nonna fosse un Visitatore e li avesse uccisi? O s‑se la FEMA li avesse portati via?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277793
    m_Localized: 'Bestson: Perché? Perché non sono rimasti? Perché non mi hanno portato via con loro...? Perché?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277794
    m_Localized: 'Bestson: COME FACCIO DA SOLO? PERCHÉ MI HANNO ABBANDONATO?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277795
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277796
    m_Localized: 'Bestson: Oh, no... Che fine hanno fatto...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277797
    m_Localized: Ti sei calmato? Te la senti di parlare di tua sorella?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277798
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277799
    m_Localized: 'Bestson: Beh, vedi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277800
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277801
    m_Localized: 'Bestson: Poco prima che se ne andassero, è arrivata una lettera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277802
    m_Localized: 'Bestson: Me l''ha portata papà, perché io non controllo mai la posta. Mi ha detto di leggerla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277803
    m_Localized: 'Bestson: Veniva da mia "sorella".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277804
    m_Localized: 'Bestson: Diceva che voleva incontrarmi, ma... io non sapevo come reagire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277805
    m_Localized: 'Bestson: In principio ho pensato a uno scherzo. Ma me l''aveva portata papà, per cui doveva essere vero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277806
    m_Localized: 'Bestson: Mi ha rivelato che non ero stato il suo primo figlio... Avevo sempre avuto una sorella...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277807
    m_Localized: 'Bestson: Non proprio una sorella, certo. Una sorellastra. Abbiamo solo il padre in comune.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277808
    m_Localized: 'Bestson: Non so... Mi ha fatto uno strano effetto. Non sapevo come prendere la notizia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277809
    m_Localized: 'Bestson: Cioè, in teoria è mia "sorella", ma anche una perfetta sconosciuta. È strano...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277810
    m_Localized: 'Bestson: Credo... che mi farebbe piacere conoscerla, ma ho anche paura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277811
    m_Localized: 'Bestson: Non è che potresti chiamarla al posto mio? Il numero è {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277812
    m_Localized: 'Bestson: Dille solo... che esisto. Che non so cosa fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277813
    m_Localized: 'Bestson: Oh, no... Che fine hanno fatto...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277814
    m_Localized: Perché non vai a incontrare tua sorella?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277815
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277816
    m_Localized: 'Bestson: Non la conosco affatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277817
    m_Localized: 'Bestson: Quando i miei mi hanno rivelato la verità, ho sentito di aver vissuto un inganno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277818
    m_Localized: 'Bestson: Mi sono infuriato e sono corso in camera mia. Volevo che mi lasciassero in pace.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277819
    m_Localized: 'Bestson: Ma il giorno dopo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277820
    m_Localized: 'Bestson: È accaduto quello che sai. La TV, il panico, e poi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277821
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277822
    m_Localized: 'Bestson: Mi hanno abbandonato sul serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277823
    m_Localized: 'Bestson: Dio, giuro che rinuncerei a tutto per rivedere mamma e papà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277824
    m_Localized: 'Bestson: Perché... Perché...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277825
    m_Localized: Vai da tua sorella, lei non ti volterà le spalle.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277826
    m_Localized: Sei sicuro che i tuoi genitori siano morti?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277827
    m_Localized: 'Bestson: Tu dici? Ne sei certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277828
    m_Localized: 'Bestson: Però...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277829
    m_Localized: 'Bestson: Non ho mai viaggiato tanto senza i miei genitori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277830
    m_Localized: 'Bestson: Lei vive molto lontano da qui... E io...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277831
    m_Localized: 'Bestson: Ho paura. Non credo di potercela fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277832
    m_Localized: Prendi un taxi. Sono ancora in servizio.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277833
    m_Localized: Devi fare qualcosa.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277834
    m_Localized: 'Bestson: Beh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277835
    m_Localized: 'Bestson: Non sono tornati a cercarmi, quindi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277836
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277837
    m_Localized: 'Bestson: Non so...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277838
    m_Localized: Prova a cercare tua nonna.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277839
    m_Localized: Controlla le zone di quarantena.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277840
    m_Localized: 'Bestson: Ehi, non è una cattiva idea. Credo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277841
    m_Localized: 'Bestson: Anche se ho sentito dire che i taxi sono diventati molto costosi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277842
    m_Localized: 'Bestson: Ma ho preso i soldi dei miei... Magari bastano a pagarmi la corsa fino a casa di mia sorella?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277843
    m_Localized: 'Bestson: Ehi, grazie per avermi fatto rinsavire. Ci vediamo, forse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277844
    m_Localized: 'Bestson: Forse hai ragione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277845
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277846
    m_Localized: 'Bestson: Ho sempre fatto troppo affidamento sui miei genitori, temo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277847
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277848
    m_Localized: 'Bestson: Ehi, grazie per avermi fatto rinsavire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277849
    m_Localized: 'Bestson: Andrò a cercarmi un taxi. Ho con me i soldi dei miei, spero che bastino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277850
    m_Localized: 'Bestson: O la va, o la spacca... Ci vediamo, forse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277851
    m_Localized: 'Bestson: Forse hai ragione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277852
    m_Localized: 'Bestson: E se fossero rimasti in panne con l''auto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277853
    m_Localized: 'Bestson: Sì, sarà andata così. Papà voleva portarla dal meccanico da un pezzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277854
    m_Localized: 'Bestson: E la nonna non ha mai voluto il telefono a casa. È per questo che non riescono a contattarmi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277855
    m_Localized: 'Bestson: Sai... forse dovrei andare a cercarli lì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277856
    m_Localized: 'Bestson: Ehi, grazie per avermi fatto rinsavire. Ora devo andare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277857
    m_Localized: 'Bestson: Beh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277858
    m_Localized: 'Bestson: Forse sono lì, in effetti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277859
    m_Localized: 'Bestson: Vale la pena provarci, almeno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277860
    m_Localized: 'Bestson: Ehi, grazie per avermi fatto rinsavire. Ora devo andare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277861
    m_Localized: 'Buddy: Ehi, amico. A cosa stai pensando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277862
    m_Localized: Come va?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277863
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277864
    m_Localized: 'Buddy: Alla grande, amico!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277865
    m_Localized: 'Buddy: Ho dato una sbirciatina in frigorifero, comunque. Se avessi saputo che avevi tutta quella birra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277866
    m_Localized: 'Buddy: Come te la sei procurata? Hai uno zio che lavora in un birrificio, per caso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277867
    m_Localized: 'Buddy: Bah, non importa. Tieniti i tuoi segreti!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277868
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277869
    m_Localized: 'Buddy: Che disastro, eh? In un mondo diverso, potremmo starcene a guardare la partita scolandoci una birra. E ti avrei fatto conoscere...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277870
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277871
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277872
    m_Localized: Ehi, tutto bene?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277873
    m_Localized: Perché ti sei bloccato?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277874
    m_Localized: 'Buddy: Eh? Come?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277875
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277876
    m_Localized: 'Buddy: Oh, non ci pensare. È tutto a posto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277877
    m_Localized: 'Buddy: No, stavo solo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277878
    m_Localized: 'Buddy: Uhm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277879
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277880
    m_Localized: 'Buddy: Mi è venuta in mente una cosa, tutto qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277881
    m_Localized: 'Buddy: Ehi, amico. A cosa stai pensando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277882
    m_Localized: Oggi sembri giù di morale.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277883
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277884
    m_Localized: 'Buddy: Ecco...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277885
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277886
    m_Localized: 'Buddy: Lasciamo perdere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277887
    m_Localized: Lasciamo perdere cosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277888
    m_Localized: Di cosa stai parlando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277889
    m_Localized: 'Buddy: Non importa. Non capiresti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277890
    m_Localized: Credo di doverlo sapere.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277891
    m_Localized: Ok, non insisto.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277892
    m_Localized: 'Buddy: Senti, non ho voglia di parlarne, d''accordo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277893
    m_Localized: Credo di doverlo sapere.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277894
    m_Localized: Ok, non insisto.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471936
    m_Localized: 'Buddy: Non insistere, ho detto! È già abbastanza difficile così.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471937
    m_Localized: 'Buddy: Lasciami in pace...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471938
    m_Localized: 'Buddy: Salute, amico! Non mi sento troppo bene, tutto qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471939
    m_Localized: 'Buddy: Ehi, amico. A cosa stai pensando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471940
    m_Localized: Che ti prende?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471941
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471942
    m_Localized: 'Buddy: Non sono affari tuoi, amico. Lascia perdere!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471943
    m_Localized: Dimmi cosa sta succedendo, avanti.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471944
    m_Localized: Devi parlarne, altrimenti peggiorerai le cose.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471945
    m_Localized: 'Buddy: Non posso... Non mi guarderesti più in faccia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471946
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471947
    m_Localized: 'Buddy: D''altro canto, tenermi tutto dentro mi sta logorando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471948
    m_Localized: 'Buddy: Avevo una cagnolina. È... morta... qualche giorno fa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471949
    m_Localized: E allora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471950
    m_Localized: E...?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471951
    m_Localized: 'Buddy: Perché, hai deciso di farmi fuori, amico?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471952
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471953
    m_Localized: 'Buddy: D''accordo. Vuoi sapere la verità?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471954
    m_Localized: 'Buddy: Avevo una cagnolina. È... morta... qualche giorno fa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471955
    m_Localized: E allora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471956
    m_Localized: E...?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471957
    m_Localized: 'Buddy: Non è solo questo. Era anziana, e malata... Ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471958
    m_Localized: 'Buddy: Non è che...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471959
    m_Localized: 'Buddy: Cioè...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471960
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471961
    m_Localized: 'Buddy: L''ho uccisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471962
    m_Localized: Cosa hai fatto?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471963
    m_Localized: Tu sei malato!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471964
    m_Localized: 'Buddy: Cioè...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471965
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471966
    m_Localized: 'Buddy: L''ho uccisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471967
    m_Localized: Cosa hai fatto?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471968
    m_Localized: Tu sei malato!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471969
    m_Localized: 'Buddy: So come sembra, ma lasciami spiegare... Lei... stava soffrendo. Non ce la facevo più a guardarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471970
    m_Localized: 'Buddy: Giorno dopo giorno, leggevo il tormento nei suoi occhi. Di notte la sentivo mugolare, piangere per il dolore alle zampe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471971
    m_Localized: 'Buddy: E tutto per colpa di QUEL CAZZO DI TASSISTA. Se non avesse guidato come uno stronzo, forse sarebbe ancora viva.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471972
    m_Localized: 'Buddy: Darei qualsiasi cosa per poterlo strozzare, ma è scappato. Non ho fatto in tempo a segnarmi il numero di targa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471973
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471974
    m_Localized: 'Buddy: Tu non sai cosa significa perdere un animale. Ci fanno compagnia per così poco tempo, eppure ci insegnano più di qualsiasi persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471975
    m_Localized: 'Buddy: Sai come si dice: per noi sono solo uno dei tanti capitoli della vita, ma per loro noi siamo l''intera storia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471976
    m_Localized: Va bene, puoi restare.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471977
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471978
    m_Localized: 'Buddy: Sì, lo so... Sono un bastardo. Non riesco a perdonarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471979
    m_Localized: 'Buddy: Lei... Lei soffriva tanto. Non ce la facevo più a vederla così.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471980
    m_Localized: 'Buddy: Peggiorava di giorno in giorno. Di notte era tremendo... Mugolava e gemeva. E le lacrime...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471981
    m_Localized: 'Buddy: Hai mai visto un cane piangere? Mi implorava con gli occhi di farla smettere di soffrire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471982
    m_Localized: 'Buddy: Non volevo! Giuro che non volevo! Le mie mani non riuscivano nemmeno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471983
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471984
    m_Localized: 'Buddy: QUEL FOTTUTO TASSISTA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471985
    m_Localized: 'Buddy: Quel bastardo ha investito la mia piccolina. Poi è scappato come se niente fosse!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471986
    m_Localized: 'Buddy: Come se avesse preso una buca, mica travolto un essere vivente!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471987
    m_Localized: 'Buddy: Dannazione, darei qualsiasi cosa per poterlo strozzare, ma è scappato. Non ho fatto in tempo a segnarmi il numero di targa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471988
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471989
    m_Localized: 'Buddy: Tu non sai cosa significa perdere un animale. Ci fanno compagnia per così poco tempo, eppure ci insegnano più di qualsiasi persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471990
    m_Localized: 'Buddy: Sai come si dice: per noi sono solo uno dei tanti capitoli della vita, ma per loro noi siamo l''intera storia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471991
    m_Localized: Va bene, puoi restare.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471992
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471993
    m_Localized: 'Buddy: Grazie, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471994
    m_Localized: 'Buddy: Mi fa piacere che tu abbia capito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471995
    m_Localized: 'Buddy: Hai ragione, amico. Forse è meglio così.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471996
    m_Localized: 'Buddy: Non faccio che pensarci, tutti i giorni... Ho fatto la cosa giusta, ponendo fine al suo dolore?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471997
    m_Localized: 'Buddy: Immagino che non lo saprò mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471998
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471999
    m_Localized: 'Fatman: Aaah, acqua fresca. Così va meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472000
    m_Localized: Ti senti meglio?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472001
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472002
    m_Localized: 'Fatman: Sì, sì, sì. Molto meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472003
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472004
    m_Localized: 'Fatman: Anche se...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472005
    m_Localized: 'Fatman: Sai, comincio ad avvertire un certo languorino. Hai almeno qualcosa per bagnarsi la gola?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472006
    m_Localized: Certo (offrigli una birra).
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472007
    m_Localized: 'Fatman: Niente birra? Non può essere...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472008
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472009
    m_Localized: 'Fatman: Ho visto che ne avevi pieno il frigo, giuro! Te le sei scolate già tutte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472010
    m_Localized: No.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472011
    m_Localized: 'Fatman: Splendido! Niente batte una birretta fresca!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472012
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472013
    m_Localized: 'Fatman: Aaah... La mia preferita...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472014
    m_Localized: 'Fatman: Ecco, comprati qualcosa di bello.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472015
    m_Localized: 'Fatman: (Hai ricevuto una manciata di banconote accartocciate, ormai prive di valore)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472016
    m_Localized: Beh... Grazie.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472017
    m_Localized: Non me ne faccio niente dei tuoi soldi.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472018
    m_Localized: 'Fatman: Così va meglio! Ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472019
    m_Localized: 'Fatman: Come si dice, ehm... Una mano lava l''altra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472020
    m_Localized: 'Fatman: Ne ho ancora una bella riserva... Per i miei amici, ovviamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472021
    m_Localized: 'Fatman: Oh, tieni anche... questo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472022
    m_Localized: 'Fatman: (Hai ricevuto un barattolo di kombucha)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472023
    m_Localized: 'Fatman: La gente civile non beve certe schifezze, ma uno come te, ehm, potrebbe farci qualcosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472024
    m_Localized: 'Fatman: Tsk! Maleducato! Pensi di essere superiore al sistema, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472025
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472026
    m_Localized: 'Fatman: Tutti hanno bisogno di soldi! Fanno girare il mondo intero, altroché!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472027
    m_Localized: 'Fatman: Va bene. Prendi questo, allora!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472028
    m_Localized: 'Fatman: (Hai ricevuto un barattolo di kombucha)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472029
    m_Localized: 'Fatman: La gente civile non beve certe schifezze, ma uno come te, ehm, potrebbe farci qualcosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472030
    m_Localized: 'Fatman: Come sarebbe a dire "no"? Tsk! Ti ritieni incorruttibile? Tutto ha un prezzo! L''amore, le cose, le persone...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472031
    m_Localized: 'Fatman: Sono i soldi a far girare il mondo, bello! E io! Beh, io sono un ministro! Ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472032
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472033
    m_Localized: 'Fatman: Va bene, fai come ti pare! Ma te ne pentirai, ricordatelo bene!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472034
    m_Localized: 'Fatman: Aaah, acqua fresca. Così va meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472035
    m_Localized: Cosa ti serve stavolta?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472036
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472037
    m_Localized: 'Fatman: Oh, ti ringrazio per la domanda! Ho voglia di fumare, mi passeresti una sigaretta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472038
    m_Localized: Va bene (offrigli le sigarette).
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472039
    m_Localized: 'Fatman: Cosa, niente sigarette?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472040
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472041
    m_Localized: 'Fatman: E sia! Mi tocca soffrire, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472042
    m_Localized: No.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472043
    m_Localized: 'Fatman: Ora si ragiona!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472044
    m_Localized: 'Fatman: Sarei più tipo da sigari, ovviamente... Ma ti sfido a trovarne qualcuno oggi. Ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472045
    m_Localized: 'Fatman: Quando ero nel consiglio, le cose andavano, ehm, diversamente. Ora siamo circondati da morte e caos... È un vero incubo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472046
    m_Localized: 'Fatman: Quando si deciderà la FEMA a sistemare questo macello, eh? Non l''abbiamo istituita per starsene a oziare!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472047
    m_Localized: 'Fatman: Tsk! Quando ero al governo io certe schifezze non succedevano, credimi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472048
    m_Localized: 'Fatman: Ma forse hanno solo bisogno di tempo. Sì, sì, sì... Tutto si aggiusterà, prima o poi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472049
    m_Localized: Eri al governo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472050
    m_Localized: Hai contribuito a fondare la FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472051
    m_Localized: 'Fatman: Beh, sì, te l''ho appena detto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472052
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472053
    m_Localized: 'Fatman: Oh, giusto... Ecco il tuo, ehm, incentivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472054
    m_Localized: 'Fatman: (Hai ricevuto una manciata di banconote accartocciate senza valore e una strana cartolina con il timbro della FEMA)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472055
    m_Localized: 'Fatman: Come ti è venuto in mente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472056
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472057
    m_Localized: 'Fatman: Oh, giusto... Ecco il tuo, ehm, incentivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472058
    m_Localized: 'Fatman: (Hai ricevuto una manciata di banconote accartocciate senza valore e una strana cartolina con il timbro della FEMA)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472059
    m_Localized: 'Fatman: Come sarebbe a dire "no"? Lo sai chi sono io?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472060
    m_Localized: 'Fatman: Ero un ministro! Un ministro, hai capito? Il governo è una macchina complessa, e ha bisogno della mia guida!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472061
    m_Localized: 'Fatman: Sono il portavoce del popolo! Senza di me, la gente comune come te resterebbe inascoltata. No, no, no! Io miglioro la vita al prossimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472062
    m_Localized: 'Fatman: In tempi normali, non oseresti nemmeno rispondermi con quel tono! Verresti arrestato in un istante!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472063
    m_Localized: 'Fatman: Tsk! Nessuno porta più rispetto a noi ministri. Pensi che ce ne stavamo in ufficio a girarci i pollici, non è vero...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472064
    m_Localized: 'Fatman: Beh, vedremo chi riderà quando si scatenerà il caos più totale e verrete a cercarmi strisciando. Ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472065
    m_Localized: 'Fatman: Aaah, acqua fresca. Così va meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472066
    m_Localized: Cos'altro ti serve adesso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472067
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472068
    m_Localized: 'Fatman: Sei sveglio, ragazzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472069
    m_Localized: 'Fatman: Voglio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472070
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472071
    m_Localized: 'Fatman: Sì! Voglio una bevanda energetica! Mi serve una, ehm, spintarella!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472072
    m_Localized: D'accordo, tieni (offrigli una bevanda energetica).
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472073
    m_Localized: 'Fatman: Tsk! Niente EnerJeka?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472074
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472075
    m_Localized: 'Fatman: E sia! Mi tocca soffrire, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472080
    m_Localized: Che sfortuna.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472081
    m_Localized: 'Fatman: Oh oh! Sì, sì, sì!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472082
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472084
    m_Localized: Parlami della FEMA. Chi sono?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472085
    m_Localized: Cosa ha in mente la FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472101
    m_Localized: 'Fatman: Tsk! Senza zucchero? Non farmela nemmeno vedere!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472104
    m_Localized: 'Fatman: Tanto vale bere l''acido delle batterie! Avrebbe un sapore migliore, probabilmente... Ehm, come hai detto, scusa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472105
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472106
    m_Localized: 'Fatman: Ti sei ammattito, per caso? Sono informazioni confidenziali!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472107
    m_Localized: 'Fatman: Ho firmato dei documenti, lo capisci? Accordi di riservatezza. No, no, no! Non sei autorizzato a saperlo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472108
    m_Localized: 'Fatman: Ecco, prendi questo caffè, piuttosto. E piantala con le domande. Fai il bravo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472109
    m_Localized: 'Fatman: (Hai ricevuto una lattina di caffè)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472110
    m_Localized: 'Fatman: EnerJeka, addirittura? Dio solo sa che schifo ci mettono dentro... Aspetta, cosa volevi sapere?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472111
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472112
    m_Localized: 'Fatman: Ti sei ammattito, per caso? Non ti dirò un bel niente, sono informazioni confidenziali!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472113
    m_Localized: 'Fatman: Ho firmato dei documenti, lo capisci? Accordi di riservatezza. Non sei autorizzato, senza offesa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472114
    m_Localized: 'Fatman: Ecco, prendi questo caffè, piuttosto. E piantala con le domande. Fai il bravo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472115
    m_Localized: 'Fatman: (Hai ricevuto una lattina di caffè)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472116
    m_Localized: 'Fatman: Chiedo scusa? Secondo te dovrei lavorare, ehm, a stomaco vuoto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472117
    m_Localized: 'Fatman: Sono qui per migliorare la vita al prossimo! Sono un amico del popolo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472118
    m_Localized: 'Fatman: Ma voi altri non fate altro che criticare! Se pensi di essere così intelligente, perché non sei al governo, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472119
    m_Localized: 'Fatman: Esattamente... Tutte chiacchere e niente fatti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472120
    m_Localized: 'Fatman: Aaah, acqua fresca. Così va meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472121
    m_Localized: Cosa c'è? Hai bisogno di altro?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472122
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472123
    m_Localized: 'Fatman: Non ti sfugge niente. Voglio il tuo fucile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472124
    m_Localized: Cosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472125
    m_Localized: Ti sei bevuto il cervello.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472126
    m_Localized: 'Fatman: Sì, sì, sì! Dammelo. Mi serve per difendermi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472127
    m_Localized: 'Fatman: Un tempo andavo a caccia, so come si usa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472128
    m_Localized: Scordatelo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472129
    m_Localized: Vai all'inferno!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472130
    m_Localized: 'Fatman: Pesa le parole, ragazzo. Hai dimenticato chi hai davanti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472131
    m_Localized: 'Fatman: Se volessi, potrei farti sbattere in galera in un batter d''occhi! Ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472132
    m_Localized: Scordatelo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472133
    m_Localized: Vai all'inferno!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472134
    m_Localized: 'Fatman: C‑Cosa hai detto? Come... Io sono un MINISTRO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472135
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472136
    m_Localized: 'Fatman: Basta! Questa è l''ultima goccia!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472137
    m_Localized: 'Fatman: Inizia a fare i bagagli, stai per finire al fresco. Ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472138
    m_Localized: Per me non sei meglio di un Visitatore.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472139
    m_Localized: Non m'importa se sei un ministro. Per me non sei nessuno.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472140
    m_Localized: 'Fatman: Pesa bene le parole, ragazzo! Non ci si rivolge così alla voce del popolo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472141
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472142
    m_Localized: 'Fatman: Sei finito, credimi. FINITO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472143
    m_Localized: 'Fatman: Oh, farmi arrabbiare è stato un grave errore! I ministri sono persone potenti, sappilo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472144
    m_Localized: 'Fatman: Ti farò rimettere in riga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472145
    m_Localized: Per me non sei meglio di un Visitatore.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472146
    m_Localized: Non m'importa se sei un ministro. Per me non sei nessuno.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472147
    m_Localized: 'Fatman: Come osi...? Brutto MISERABILE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472148
    m_Localized: 'Fatman: Finirai dietro le sbarre! Già! Aspetta e vedrai! Ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472149
    m_Localized: 'Fatman: Come osi...? Brutto MISERABILE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472150
    m_Localized: 'Fatman: Finirai dietro le sbarre! Già! Aspetta e vedrai! Ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472151
    m_Localized: 'Fatman: Aaah, acqua fresca. Così va meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472152
    m_Localized: Com'è che non ti sto parlando da una cella?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472153
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472154
    m_Localized: 'Fatman: Oh, fai lo spiritoso? Presto cambierai atteggiamento, non ti preoccupare!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472155
    m_Localized: Magari i titoli valevano qualcosa, in passato. Ma ora non sei nessuno.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472156
    m_Localized: I soldi non hanno più alcun valore. Non ci arrivi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472157
    m_Localized: 'Fatman: Che insolente! Io... sono ancora al governo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472158
    m_Localized: 'Fatman: Mi hanno sospeso l''incarico... Ma solo temporaneamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472159
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472160
    m_Localized: 'Fatman: Aaah, ma chi voglio ingannare... La vita non tornerà più quella di un tempo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472161
    m_Localized: 'Fatman: Quando ero in carica, l''intero paese pendeva dalle labbra di noi ministri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472162
    m_Localized: 'Fatman: La gente mi temeva, mi rispettava. Le auto si facevano da parte, le folle accorrevano a compiacermi, a lusingarmi. E ora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472163
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472164
    m_Localized: 'Fatman: Magnifico. Ora ho lo stomaco sottosopra per lo stress.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472165
    m_Localized: 'Fatman: Sei soddisfatto? Vattene, ne ho avuto abbastanza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472166
    m_Localized: 'Fatman: N‑Non è vero! Sono ancora pieno di soldi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472167
    m_Localized: 'Fatman: Magari a te non interessano, ma al resto del mondo sì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472168
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472169
    m_Localized: 'Fatman: Aaah, ma chi voglio ingannare... La vita non tornerà più quella di un tempo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472170
    m_Localized: 'Fatman: Niente più sfarzo, limousine, donne...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472171
    m_Localized: 'Fatman: Era tutto così facile. Se eri ricco... contavi qualcosa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472172
    m_Localized: 'Fatman: Non fosse stato per il crollo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472173
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472174
    m_Localized: 'Fatman: Magnifico. Ora ho lo stomaco sottosopra per lo stress.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472175
    m_Localized: 'Fatman: Sei soddisfatto? Vattene, ne ho avuto abbastanza.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173076770816
    m_Localized: 'Fatman: Sono stanco, lasciami in pace.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173093548032
    m_Localized: 'Fatman: Rimandiamo a domani. Sciò!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472176
    m_Localized: 'Blind: È così buio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472177
    m_Localized: Dimmi, cosa hai visto?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666240
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666241
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666242
    m_Localized: 'Blind: Non vuoi saperlo, credimi. Ritieniti fortunato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666243
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666244
    m_Localized: 'Blind: Ho pensato che se avessi smesso di vedere mi sarei liberato di quella... creatura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666245
    m_Localized: 'Blind: Ma ormai si è scavata un posto dentro di me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666246
    m_Localized: 'Blind: Sogno spesso. E la vedo sempre, viene a farmi visita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666247
    m_Localized: 'Blind: È così buio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666248
    m_Localized: Quindi, ti trovi meglio senza occhi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666249
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666250
    m_Localized: 'Blind: Difficile dirlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666251
    m_Localized: 'Blind: So che non vedrò più quella creatura. Se anche qualcosa dovesse uccidermi, non saprò che aspetto ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666252
    m_Localized: 'Blind: È strano...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666253
    m_Localized: 'Blind: Non so come è fatta casa tua. Orientarmi è complicato. E senza le medicine mi farebbero male le orbite...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666254
    m_Localized: 'Blind: Ma almeno non dovrò più assistere a un tale orrore. Mi ci abituerò.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666255
    m_Localized: 'Blind: Eppure, il ricordo di ciò che ho visto è impresso a fuoco dentro di me. Mi accompagnerà fino alla morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666256
    m_Localized: 'Blind: È così buio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666257
    m_Localized: Non hai un bell'aspetto.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666258
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666259
    m_Localized: 'Blind: Dici che dovrei pettinarmi? Ah ah...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666260
    m_Localized: 'Blind: Stanotte ho fatto un sogno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666261
    m_Localized: 'Blind: Camminavo lungo i binari del tram, diretto a casa. C''erano palazzi, alberi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666262
    m_Localized: 'Blind: Ho sentito arrivare il tram, e mi sono fatto da parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666263
    m_Localized: 'Blind: Poi mi sono voltato, e ho visto qualcosa ghermire una persona per strada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666264
    m_Localized: 'Blind: Era difficile distinguerne i contorni, per quanto era veloce. Ma io sapevo... sapevo cos''era.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666265
    m_Localized: 'Blind: Ho rincorso il tram, ma invano. Non lo raggiungerò mai. E nemmeno la verità che attende al capolinea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666266
    m_Localized: 'Blind: A quel punto, mi sono svegliato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666267
    m_Localized: 'Blind: È così buio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666268
    m_Localized: Stai bene?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666269
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666270
    m_Localized: 'Blind: Un altro sogno. E QUELLA COSA è tornata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666271
    m_Localized: 'Blind: Camminavo per strada, di notte. D''un tratto, la luce dei lampioni ha tremolato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666272
    m_Localized: 'Blind: E quando mi sono voltato, l''ho vista avvicinarsi. Lentamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666273
    m_Localized: 'Blind: Stavolta ho potuto osservarne chiaramente le movenze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666274
    m_Localized: 'Blind: Ho provato a correre, ma non riuscivo a distanziarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666275
    m_Localized: 'Blind: Sono arrivato a casa, ma il cancello all''ingresso era chiuso. L''ho scavalcato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666276
    m_Localized: 'Blind: Ho frugato nelle tasche. Le chiavi mi scivolavano continuamente di mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666277
    m_Localized: 'Blind: Sono corso intorno alla casa. Un''altra recinzione. L''ho scavalcata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666278
    m_Localized: 'Blind: Poi mi sono fermato. Silenzio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666279
    m_Localized: 'Blind: Ho sollevato lo sguardo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666280
    m_Localized: 'Blind: Ed era lì. Si protendeva verso di me oltre la recinzione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666281
    m_Localized: 'Blind: Pensi sia colpa degli antidolorifici?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666282
    m_Localized: 'Blind: È così buio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666283
    m_Localized: Hai fatto altri sogni?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666284
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666285
    m_Localized: 'Blind: Sì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666286
    m_Localized: 'Blind: Ma non ho voglia di parlarne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666287
    m_Localized: 'Blind: Ora ho capito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666288
    m_Localized: 'Blind: Moriremo tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666289
    m_Localized: 'Blind: QUELLA COSA ci farà a pezzi. Da svegli o nel sonno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666290
    m_Localized: 'Blind: Bruceremo tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666291
    m_Localized: 'Blind: Nulla ha più importanza, ormai. È finita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666292
    m_Localized: 'Blind: Lasciami... stare, per favore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666293
    m_Localized: 'Dude: Come butta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666294
    m_Localized: Cosa facevi prima del Cataclisma?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666295
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666296
    m_Localized: 'Dude: Beh, fra, me la prendevo comoda. Cioè... Guardavo qualche film. Stavo con i miei amici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666297
    m_Localized: 'Dude: Ma ora? Niente più film. Niente più amici. Che barba, amico...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666298
    m_Localized: 'Dude: In TV c''è sempre la stessa solfa: panico, pubblicità, panico, pubblicità... E gli amici nemmeno rispondono più al telefono.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666299
    m_Localized: 'Dude: Ho sentito un pezzo grosso che diceva: "Non è il momento di pensare allo svago, siamo in piena crisi...".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666300
    m_Localized: 'Dude: Ma che palle... Il divertimento non finisce mai se ci credi davvero! E andiamo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666301
    m_Localized: 'Dude: Come butta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666302
    m_Localized: Beh, cosa facevi di lavoro?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666303
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666304
    m_Localized: 'Dude: Lavoro? Pfff!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666305
    m_Localized: 'Dude: Solo i gonzi lavorano, amico. Io ero troppo impegnato a VIVERE, mi capisci?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666306
    m_Localized: 'Dude: Ho visto un film, una volta. Il protagonista? Era identico a me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666307
    m_Localized: 'Dude: Dimmi, gli operai in fabbrica ti sembrano felici? Nemmeno per sogno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666308
    m_Localized: 'Dude: Io organizzavo feste, amico. Incontravo bella gente. La vera vita è questa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666309
    m_Localized: 'Dude: Cioè... Un tempo gestivo un magazzino. Per una ditta di spedizioni. Avevano organizzato tutto i miei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666310
    m_Localized: Ti fai mantenere dai tuoi genitori?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666311
    m_Localized: Sei un fannullone, quindi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666312
    m_Localized: 'Dude: Perché sbattersi, amico, se è già tutto sistemato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666313
    m_Localized: 'Dude: Non approfittarne sarebbe stato stupido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666314
    m_Localized: 'Dude: Per dire, tu hai quel grosso fucile, giusto? Non lo lasci appeso al muro, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666315
    m_Localized: 'Dude: Non se ne parla proprio. Io seguo la corrente, proprio come te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666316
    m_Localized: 'Dude: Yo, datti una calmata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666317
    m_Localized: 'Dude: Se sei invidioso dillo apertamente, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666318
    m_Localized: 'Dude: Lo capisco. Non tutti nascono privilegiati. È così che va il mondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666319
    m_Localized: 'Dude: Come butta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666320
    m_Localized: Qualcosa non va?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666321
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666322
    m_Localized: 'Dude: Amico, non ce l''hai qualche film? Non ho visto nemmeno una cassetta qua dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666323
    m_Localized: 'Dude: Non guardi mai niente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666324
    m_Localized: 'Dude: Sto morendo di noia, amico, daaai!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666325
    m_Localized: Non c'è tempo per i film.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666326
    m_Localized: Non ne ho.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666327
    m_Localized: 'Dude: Che strazio, pensavo di essermi trovato un posticino a modo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666328
    m_Localized: 'Dude: Voglio essere sincero. Quell''altra gente? Un branco di matti. E non c''è niente per distrarsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666329
    m_Localized: 'Dude: Niente riviste, niente film... Solo libri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666330
    m_Localized: 'Dude: Chi vuoi che si metta a leggere, amico? È roba giurassica! Una bella sfilza di paroloni, e quindi? Due scatoleee!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666331
    m_Localized: Qui non siamo al cinema.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666332
    m_Localized: Sei qui per divertirti o per restare vivo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666333
    m_Localized: 'Dude: Ehi, amico... Mi prendi in giro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666334
    m_Localized: 'Dude: Pazzesco... Fai sul serio!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666335
    m_Localized: 'Dude: Cioè, hai la TV in camera, amico, e neanche un film?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666336
    m_Localized: 'Dude: Questa festa fa schifo. Pensavo fossi un tipo a posto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666337
    m_Localized: Qui non siamo al cinema.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666338
    m_Localized: Sei qui per divertirti o per restare vivo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666339
    m_Localized: 'Dude: Eddai, amico...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666340
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666341
    m_Localized: 'Dude: Cioè, sei proprio una rottura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666342
    m_Localized: Se vuoi sopravvivere, devi calmarti.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666343
    m_Localized: Se non ti sta bene, vattene.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666344
    m_Localized: 'Dude: Su, amico...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666345
    m_Localized: 'Dude: La TV a casa mia si è fritta. Contavo su di te per non morire di noia, ma nooo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666346
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666347
    m_Localized: 'Dude: Cioè, sei proprio una rottura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666348
    m_Localized: Se vuoi sopravvivere, devi calmarti.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666349
    m_Localized: Se non ti sta bene, vattene.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666350
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666351
    m_Localized: 'Dude: Dai amico, rilassati. Questo posto è deprimente, ma sempre meglio della strada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666352
    m_Localized: 'Dude: Almeno lasciami guardare la TV. Andiamo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666353
    m_Localized: 'Dude: Ah, lo sapevo. Sei proprio preso male, fratello!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666354
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666355
    m_Localized: 'Dude: Io me ne vado. Pace!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666356
    m_Localized: 'Teacher: Quei poveri bambini...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666357
    m_Localized: Stai bene?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666358
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666359
    m_Localized: 'Teacher: Io... credo di sì. Non lo so...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666360
    m_Localized: 'Teacher: Non capisco... Com''è possibile che persone adulte e razionali possano aver compiuto simili atrocità?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666361
    m_Localized: 'Teacher: Erano così terrorizzate da arrivare a uccidere un bambino?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666362
    m_Localized: La gente oggi fa cose peggiori.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666363
    m_Localized: Nel caos, pochi mantengono la mente lucida.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666364
    m_Localized: 'Teacher: Cosa c''è di peggio che uccidere un bambino indifeso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666365
    m_Localized: 'Teacher: Non era solo una persona, era una folla. Una vera e propria caccia alle streghe...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666366
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666367
    m_Localized: 'Teacher: Le avversità rivelano la nostra natura. Forse i veri mostri siamo noi, non quelli che strisciano nel sottosuolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666368
    m_Localized: 'Teacher: Possibile che la gente non si renda conto che uccidere bambini è... disumano, non ci sono altre parole...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666369
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666370
    m_Localized: 'Teacher: Le avversità rivelano la nostra natura. Forse i veri mostri siamo noi, non quelli che strisciano nel sottosuolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666371
    m_Localized: 'Teacher: Quei poveri bambini...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666372
    m_Localized: Da quanto tempo insegni?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666373
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666374
    m_Localized: 'Teacher: Circa tre mesi... prima del Cataclisma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666375
    m_Localized: 'Teacher: Ero tutt''altro che un''insegnante modello. Non amavo quel lavoro, e i bambini erano chiassosi e stancanti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666376
    m_Localized: 'Teacher: Il Cataclisma ha cambiato tutto. Mi ha aperto gli occhi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666377
    m_Localized: 'Teacher: Sai, uno qualunque di quei bambini avrebbe potuto diventare una rockstar, un politico o un genitore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666378
    m_Localized: 'Teacher: Ma ormai non potranno più suonare una chitarra, andare a scuola, crescere...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666379
    m_Localized: 'Teacher: Rimarranno per sempre... dei sognatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666380
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666381
    m_Localized: 'Teacher: Ricordo il giorno in cui un bambino arrivò in lacrime. Disse che i suoi genitori avevano paura di lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666382
    m_Localized: 'Teacher: Pensavano fosse un Visitatore, e così... lo scacciarono.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666383
    m_Localized: 'Teacher: Non aveva nessun altro posto dove andare, così venne da me... all''asilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666384
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666385
    m_Localized: 'Teacher: (La donna non riesce più a trattenersi e scoppia a piangere)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666386
    m_Localized: 'Teacher: Scusami...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666387
    m_Localized: 'Teacher: Quei poveri bambini...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666388
    m_Localized: Mi dispiace per ieri, non volevo contrariarti.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666389
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666390
    m_Localized: 'Teacher: Non preoccuparti. Io... sto meglio. Mi sento più calma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666391
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666392
    m_Localized: 'Teacher: Quel piccino... mi fece capire quanto siano fragili i bambini. Soprattutto in momenti tragici come questo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666393
    m_Localized: 'Teacher: Iniziai ad accogliere ogni trovatello che incontravo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666394
    m_Localized: 'Teacher: Le loro storie erano... strazianti. I genitori li scacciavano senza un briciolo di esitazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666395
    m_Localized: 'Teacher: Come se il Cataclisma giustificasse l''abbandono di un bambino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666396
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666397
    m_Localized: 'Teacher: Forse... non hanno mai voluto davvero dei figli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666398
    m_Localized: 'Teacher: Quei poveri bambini...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666399
    m_Localized: Avevi dei figli?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666400
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666401
    m_Localized: 'Teacher: No, io... Mia madre non faceva che ripetermi di sistemarmi e formare una famiglia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666402
    m_Localized: 'Teacher: Ma non ero pronta. Volevo essere io a decidere quando sarebbe stato il momento giusto, capisci?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666403
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666404
    m_Localized: 'Teacher: Tuttavia, ascoltare tutte quelle storie di bambini abbandonati... mi fece sorgere un dubbio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666405
    m_Localized: 'Teacher: Se avessi seguito i consigli di mia madre... sarei diventata come quei genitori?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666406
    m_Localized: 'Teacher: Per questo decisi di aiutare ogni bambino che era stato lasciato solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666407
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666408
    m_Localized: 'Teacher: E sai qual è la parte più tragica? Tra gli incendiari, c''era il genitore di un bambino che avevo accolto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666409
    m_Localized: 'Teacher: (Ancora una volta, la donna cede alle lacrime)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666410
    m_Localized: 'Teacher: Scusami...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666411
    m_Localized: 'Teacher: Io... ho provato a offrire loro una vita migliore. Ci tenevo. Non doveva finire così...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666412
    m_Localized: 'Teacher: Mi dispiace tanto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666413
    m_Localized: La loro morte non è stata colpa tua.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666414
    m_Localized: Mi dispiace molto per te.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666415
    m_Localized: 'Teacher: Forse hai ragione, ma... dentro di me resta solo il vuoto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666416
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666417
    m_Localized: 'Teacher: C''è un pensiero che continua ad assillarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666418
    m_Localized: 'Teacher: E se quei genitori non avessero mai provato nulla per loro? Se non li avessero mai amati?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666419
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666420
    m_Localized: 'Teacher: Io... spero di avergli donato almeno un briciolo di amore...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666421
    m_Localized: 'Teacher: Grazie... ma ho il cuore a pezzi. Sinceramente, non credo che riuscirò mai a riprendermi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666422
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666423
    m_Localized: 'Teacher: C''è un pensiero che continua ad assillarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666424
    m_Localized: 'Teacher: E se quei genitori non avessero mai provato nulla per loro? Se non li avessero mai amati?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666425
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666426
    m_Localized: 'Teacher: Io... spero di avergli donato almeno un briciolo di amore...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860544
    m_Localized: 'Ballerina: Gatto è qui. Che altro vuoi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860545
    m_Localized: Perché sei qui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860546
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860547
    m_Localized: 'Ballerina: Domanda stupida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860548
    m_Localized: 'Ballerina: Tu hai aperto porta. Chiedi perché. Perché io qui?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860549
    m_Localized: 'Ballerina: Per me uguale. Posto è posto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860550
    m_Localized: 'Ballerina: Detto di venire qui, ora sono qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860551
    m_Localized: 'Ballerina: Non voglio niente. Neanche te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860552
    m_Localized: 'Ballerina: Conta solo che posto è comodo per gatto. Il resto? Non importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860553
    m_Localized: 'Ballerina: Gatto è qui. Che altro vuoi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860554
    m_Localized: Sei un essere umano?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860555
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860556
    m_Localized: 'Ballerina: E tu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860557
    m_Localized: 'Ballerina: Cosa rimasto di te?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860558
    m_Localized: 'Ballerina: Cosa rende me peggio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860559
    m_Localized: 'Ballerina: Gatto è qui. Che altro vuoi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860560
    m_Localized: Chi ti ha mandata qui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860561
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860562
    m_Localized: 'Ballerina: Hai fatto come dovevi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860563
    m_Localized: 'Ballerina: Perché ti interessa il resto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860564
    m_Localized: 'Ballerina: Va bene. Mi ha mandata... qualcuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860565
    m_Localized: 'Ballerina: Ma non ha detto cosa fare dopo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860566
    m_Localized: 'Ballerina: Gatto è qui. Che altro vuoi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860567
    m_Localized: Quanto tempo pensi di restare?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860568
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860569
    m_Localized: 'Ballerina: Finché non vengono a prendere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860570
    m_Localized: 'Ballerina: Che altro devo fare? Uhm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860571
    m_Localized: 'Ballerina: Non so. Dicono cose, aspetto che dicono altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860572
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860573
    m_Localized: 'Ballerina: E chi dice a te cosa fare?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860574
    m_Localized: 'Ballerina: Chi aspetti tu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860575
    m_Localized: 'Ballerina: Gatto è qui. Che altro vuoi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860576
    m_Localized: Perché non mi hai ucciso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860577
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860578
    m_Localized: 'Ballerina: Sei sciocco, sai?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860579
    m_Localized: 'Ballerina: Ogni giorno, ripeti sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860580
    m_Localized: 'Ballerina: Ti ho detto. Non hanno spiegato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860581
    m_Localized: 'Ballerina: Aspetto. Perché tu aspetti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860582
    m_Localized: 'Mother: Qui dentro si soffoca...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860583
    m_Localized: Tutto bene? Come sta la bambina?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860584
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860585
    m_Localized: 'Mother: Eh? Oh, è... stanca, come me. È timida con chi non conosce, quindi mi sta sempre appiccicata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860586
    m_Localized: 'Mother: I bambini faticano a gestire certe cose. Non si lamentano, ma glielo leggi in faccia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860587
    m_Localized: 'Mother: A volte penso sia solo colpa mia. Non avrei dovuto trascinarli in questa situazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860588
    m_Localized: 'Mother: Ma ormai è inutile pensarci, il danno è fatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860589
    m_Localized: 'Couple: Su, piccola, non tenere il muso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860590
    m_Localized: Cosa ci facevate in strada?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860591
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860592
    m_Localized: 'Couple: Oh, stavamo andando a trovare la madre della mia adorata mogliettina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860593
    m_Localized: 'Couple: Ci siamo resi conto che non ce l''avremmo fatta da soli e, beh, siamo capitati qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860594
    m_Localized: 'Couple: A proposito, grazie di cuore per l''ospitalità!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860595
    m_Localized: 'Couple: Su, piccola, non tenere il muso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860596
    m_Localized: Quanto dovete andare lontano?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860597
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860598
    m_Localized: 'Couple: La mia dolce metà non ha un gran senso dell''orientamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860599
    m_Localized: 'Couple: Se non riusciamo a trovare aiuto, probabilmente ci impiegheremo almeno due giorni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860600
    m_Localized: 'Couple: Sempre che non ci si perda di nuovo cercando la via. Ah ah! Giusto, tesoro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860601
    m_Localized: 'Couple: Ma se qualcuno ci desse un passaggio, sarebbe fantastico. Ci vorrebbero un paio d''ore al massimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860602
    m_Localized: Perché tutta questa fretta di fare visita a sua madre?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860603
    m_Localized: Non è che mi stai dando orari a caso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860604
    m_Localized: 'Couple: Beh, chi può dire se sta bene, con tutto quello che sta succedendo nel mondo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860605
    m_Localized: 'Couple: Ha anche il telefono spento. Non riusciamo a contattarla da giorni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860606
    m_Localized: 'Couple: E se avesse bisogno di aiuto? Dobbiamo assicurarci che stia bene!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860607
    m_Localized: 'Couple: Ormai le notti durano poco. Andare in giro lì fuori può essere spaventoso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860608
    m_Localized: 'Couple: Ma non importa. Vedremo tua madre molto presto, tesoro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860609
    m_Localized: 'Couple: Non ricordo la strada, e mia moglie è così distratta quando si tratta di direzioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860610
    m_Localized: 'Couple: Ma non fa niente. L''unica cosa che conta è continuare a muoversi, giusto, tesoro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860611
    m_Localized: 'Couple: Chi lo sa, magari ci arriveremo tra una settimana! Ah ah ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860612
    m_Localized: 'Couple: Su, piccola, non tenere il muso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860613
    m_Localized: Pensavo che sareste andati via.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860614
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860615
    m_Localized: 'Couple: L''idea era quella, ma la mia mogliettina ci ha messo tre ore a prepararsi. Non è il caso di muoverci adesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860616
    m_Localized: 'Couple: Partiremo più tardi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860617
    m_Localized: 'Couple: Ci dispiace. La prossima volta saremo più rapidi, promesso!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860618
    m_Localized: 'Couple: Farò in modo che la qui presente lumachina non ci rallenti di nuovo. Ah ah ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860619
    m_Localized: 'Couple: Non vorremmo essere d''impiccio. Se lo fossimo, ce lo diresti, giusto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860620
    m_Localized: 'Couple: Su, piccola, non tenere il muso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860621
    m_Localized: Signora, sta bene?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860622
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860623
    m_Localized: 'Couple: Sta benissimo. Perché lo chiedi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860624
    m_Localized: 'Couple: Non ha altro da aggiungere. Ho già detto tutto io.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860625
    m_Localized: 'Couple: È solo affaticata, tutto qui. Niente di cui preoccuparsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860626
    m_Localized: L'ho chiesto a lei.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860627
    m_Localized: E tu come stai?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860628
    m_Localized: 'Couple: Sì, e io ti ho detto che è stanca. Non insistere, per favore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860629
    m_Localized: 'Couple: Troverò il modo di farla muovere, vedrai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860630
    m_Localized: 'Couple: Credo che a questo punto non le interessi più di sua madre... ma ci andremo comunque!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860631
    m_Localized: 'Couple: Sempre che la vecchia sia ancora viva, s''intende! Ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860632
    m_Localized: 'Couple: Andiamo, tesoro, sbrigati. Per quanto ancora mi farai aspettare? Merda!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860633
    m_Localized: 'Couple: Eh, va tutto bene. Più o meno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860634
    m_Localized: 'Couple: Inizio a pensare che alla mia signora non importi più nulla della madre, ah ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860635
    m_Localized: 'Couple: Forse dovrei ricordarle che brutta fine rischia di fare, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860636
    m_Localized: 'Couple: Scusami per lo sfogo. Mi sta esasperando, se la prende con troppa calma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860637
    m_Localized: 'Couple: Piazza il culo sulla sedia e preparati! Non ne posso più di aspettarti, cazzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860638
    m_Localized: 'Couple: Su, piccola, non tenere il muso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860639
    m_Localized: Tua moglie non vuole partire. Che sta succedendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860640
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860641
    m_Localized: 'Couple: Mi sta facendo incazzare, ecco che sta succedendo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860642
    m_Localized: 'Couple: Sempre a frignare e puntare il dito contro di me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860643
    m_Localized: 'Couple: Ci vuole tanto a chiudere la bocca e obbedire? Perché deve sempre complicarmi la vita?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860644
    m_Localized: 'Couple: Scusa se ci siamo trattenuti troppo. Oggi è l''ultimo giorno, poi ce ne andremo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860645
    m_Localized: 'Couple: Hai capito? Fa'' i bagagli. Se al tramonto siamo ancora qui, ti butto fuori dalla finestra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860646
    m_Localized: Signora, è sicura di star bene?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860647
    m_Localized: Vorrei capire qual è il problema.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860648
    m_Localized: 'Couple: Non immischiarti. Te l''ho già detto una volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860649
    m_Localized: 'Couple: Smettila di ficcare il naso dove non ti compete.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860650
    m_Localized: 'Couple: Sono affari nostri, perciò stanne fuori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860651
    m_Localized: Basta con le cazzate, dimmi la verità!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860652
    m_Localized: Come ti pare. Ve ne andate o no?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860653
    m_Localized: 'Couple: Calma, amico. Ti ho detto che è tutto a posto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860654
    m_Localized: 'Couple: Mia moglie si annoia, quindi fa i capricci. A volte mi fa arrabbiare, tutto qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860655
    m_Localized: 'Couple: Che diavolo vuoi da me?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860656
    m_Localized: Basta con le cazzate, dimmi la verità!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860657
    m_Localized: Come ti pare. Ve ne andate o no?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860658
    m_Localized: 'Couple: Stai calmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860659
    m_Localized: 'Couple: Anch''io sono armato. Fai un solo passo e ammazzo questa stronza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860660
    m_Localized: 'Couple: Io non ho più nulla da perdere. E tu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860661
    m_Localized: Morirai in ogni caso.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860662
    m_Localized: Puoi ancora uscirne vivo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860663
    m_Localized: 'Couple: Tranquillo, non c''è bisogno di agitarsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860664
    m_Localized: 'Couple: Ce ne andiamo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054848
    m_Localized: 'Couple: Hai sentito? È l''ultima notte, quindi smettila di rompere e preparati.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054849
    m_Localized: 'Couple: Tanto che mi cambia? Mi ammazzi, e quindi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054850
    m_Localized: 'Couple: Almeno smetto di soffrire, e lei crepa con me. Ci farai soltanto un favore...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054851
    m_Localized: Adesso sparo!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054852
    m_Localized: Calmati. Abbassa l'arma e io farò lo stesso.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054853
    m_Localized: 'Couple: Perché? Devo andarmene via con lei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054854
    m_Localized: 'Couple: O partiamo insieme o niente. Metti via il fucile e toglieremo il disturbo stasera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054855
    m_Localized: 'Couple: Non deve per forza finire male.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054856
    m_Localized: Adesso sparo!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054857
    m_Localized: Calmati. Abbassa l'arma e io farò lo stesso.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054858
    m_Localized: 'Couple: Uccideresti una donna innocente? Non te ne frega niente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054859
    m_Localized: 'Couple: Sai bene che se mi spari colpirai anche lei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054860
    m_Localized: 'Couple: Sarà colpa tua! Ce l''avrai sulla coscienza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054861
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054862
    m_Localized: Avverti
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054863
    m_Localized: 'Couple: O vado via, o ci lasciamo la pelle entrambi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054864
    m_Localized: 'Couple: Non hai altra scelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054865
    m_Localized: 'Couple: Se quella cagna mi avesse seguito, invece di mettersi a tremare come una foglia...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054866
    m_Localized: 'Couple: È colpa tua! Mi hai sentito, stupida troia? Hai rovinato tutto!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054867
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054868
    m_Localized: Avverti
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054869
    m_Localized: 'Couple: Tu... stai mettendo giù il fucile?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054870
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054871
    m_Localized: 'Couple: Aspetta, no! Vuoi spararmi lo stesso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054872
    m_Localized: 'Couple: NO! FERMO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054873
    m_Localized: 'Couple: C‑Ce ne andiamo, ok? Cerchiamo di restare calmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054874
    m_Localized: 'Couple: Va bene? E tu vedi di muoverti, questa volta!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054875
    m_Localized: 'Couple: (La donna si divincola all''improvviso, l''uomo le spara)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054876
    m_Localized: 'Couple: (Reagisci all''istante e colpisci l''uomo alla testa)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054877
    m_Localized: 'Couple: (Sono morti, almeno è finita)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054878
    m_Localized: 'Couple: (Che coppia di pazzi...)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054879
    m_Localized: 'Couple: D''accordo, ce ne andiamo. Lascia solo che prendiamo qualcosa per coprirci e saremo fuori di qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054880
    m_Localized: 'Couple: Non ci vedrai mai più.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054881
    m_Localized: 'Couple: Aspetta...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054882
    m_Localized: 'Couple: C‑CHE STAI FACENDO?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054883
    m_Localized: 'Couple: (Fai fuoco, colpendo sia lui che la donna)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054884
    m_Localized: 'Couple: (Entrambi si accasciano a terra, sanguinanti)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054885
    m_Localized: 'Couple: (Lei emette un rantolo, ma ormai non c''è più niente da fare)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054886
    m_Localized: 'Couple: (Sono morti)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054887
    m_Localized: 'Couple: Non capisci? È l''unico modo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054888
    m_Localized: 'Couple: Ce ne andiamo. Fine della storia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054889
    m_Localized: 'Couple: Muoviti! Prendi una coperta e usciamo di qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054890
    m_Localized: 'Couple: (Li osservi mentre si coprono ed escono fuori)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054891
    m_Localized: 'Couple: (Procedono per un tratto, poi crollano di colpo)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054892
    m_Localized: 'Couple: (Distogli lo sguardo, mentre dalla coperta inizia a levarsi del fumo)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054893
    m_Localized: 'BigLebowski: Uff... Sono stanca di questo schifo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054894
    m_Localized: Perché eri lì fuori da sola?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054895
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054896
    m_Localized: 'BigLebowski: Beh, a casa mia si stava stretti. Un casino infernale, nessuna comodità. Io avevo voglia di viaggiare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054897
    m_Localized: 'BigLebowski: Così ho preso uno zaino, due bibite, delle barrette e questo vecchio braccialetto che ho fatto a scuola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054898
    m_Localized: 'BigLebowski: E me ne sono andata. I miei neanche l''avranno notato, credo. Non che m''importi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054899
    m_Localized: 'BigLebowski: Da allora vago in giro, dormo dove capita. E sai una cosa? Non è male.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054900
    m_Localized: 'BigLebowski: Almeno nessuno mi fiata sul collo. Sono io che comando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054903
    m_Localized: 'BigLebowski: Uff... Sono stanca di questo schifo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054904
    m_Localized: Come hai fatto a sopravvivere?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054905
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054906
    m_Localized: 'BigLebowski: In un modo o nell''altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054907
    m_Localized: 'BigLebowski: Mi rifugiavo nei sottoscala, nei capanni o dormivo sotto un albero. Mi proteggevo dal sole dove potevo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054908
    m_Localized: 'BigLebowski: Mangiavo quello che trovavo. Erbe selvatiche o qualche barretta fregata in un negozio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054909
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054910
    m_Localized: 'BigLebowski: Che hai da fissarmi? Sì, ho rubato. Come avrei dovuto sopravvivere? Non è che si trovi facilmente lavoro, lì fuori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054911
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233280
    m_Localized: 'BigLebowski: Agh, ancora? Credi che ruberei qualcosa a te? Ma fammi il piacere...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233281
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233282
    m_Localized: 'BigLebowski: Perché mi stai facendo il terzo grado? Piantala, dico sul serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054912
    m_Localized: 'BigLebowski: Uff... Sono stanca di questo schifo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054913
    m_Localized: Per quanto pensi di andare avanti così?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054914
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054915
    m_Localized: 'BigLebowski: E a te che importa? Me la caverò, come sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054916
    m_Localized: 'BigLebowski: Senti, ti do tanto fastidio? Ti ho rubato qualcosa? Ti ho intasato il cesso? Perché mi stai addosso, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054917
    m_Localized: 'BigLebowski: Non è che sei... un pervertito?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054918
    m_Localized: 'BigLebowski: Ne ho incontrato un altro come te, una volta. Molto gentile, mi aveva offerto un posto dove stare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054919
    m_Localized: 'BigLebowski: Guardavamo anime, film, roba così. Pensavo di aver finalmente trovato una persona decente. E invece...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054920
    m_Localized: 'BigLebowski: Provò a mettermi le mani addosso. Maniaco schifoso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054921
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233283
    m_Localized: 'BigLebowski: Non ci provare, o ti spacco la testa. Non permetterò a nessuno di approfittarsi di me.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233284
    m_Localized: 'BigLebowski: Mio padre era un vero bastardo, ma almeno mi ha insegnato a combattere.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233285
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233286
    m_Localized: 'BigLebowski: Già, stammi alla larga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054922
    m_Localized: 'BigLebowski: Uff... Sono stanca di questo schifo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054923
    m_Localized: Cos'è successo a quell'uomo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054924
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054925
    m_Localized: 'BigLebowski: Perché vuoi saperlo, vecchio? Vuoi capire come fregarmi se reagisco, eh? Non ci sperare!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054926
    m_Localized: 'BigLebowski: Non sono stupida. Non me lo stai chiedendo per gentilezza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054927
    m_Localized: 'BigLebowski: Vuoi solo evitare grane a casa tua, giusto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054928
    m_Localized: 'BigLebowski: Beh, io non porto guai. Non voglio derubarti o spaccarti le finestre, quindi dacci un taglio! Diamine...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054929
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054930
    m_Localized: 'BigLebowski: E comunque...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054931
    m_Localized: 'BigLebowski: Sono qui solo perché ti servo, no? Così quel tipo mezzo nudo non verrà a prenderti. Già, l''ho saputo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233287
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233288
    m_Localized: 'BigLebowski: E va bene, al diavolo! Fai i tuoi stupidi esperimenti, basta che mi lasci in pace.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054932
    m_Localized: 'BigLebowski: Uff... Sono stanca di questo schifo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054933
    m_Localized: Perché tuo padre ti ha insegnato a combattere?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054934
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054935
    m_Localized: 'BigLebowski: Per difendermi dai depravati... o perché potesse sfogare la sua rabbia di merda su di me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054936
    m_Localized: 'BigLebowski: Colpisci, incassa, bla bla bla... Peccato che al posto del sacco usasse la mia faccia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233289
    m_Localized: 'BigLebowski: Per lui, quello era il modo giusto di addestrarmi. Ma io lo odiavo, ok?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233290
    m_Localized: 'BigLebowski: Certe volte sbroccava e mi pestava a sangue. E mia madre? Non muoveva un dito. Faceva finta di niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233291
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233292
    m_Localized: 'BigLebowski: Bah! L''unica cosa che so è che non finirò come loro.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233293
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233294
    m_Localized: 'BigLebowski: Perché mettermi al mondo se dovevano trattarmi così, eh? Se la vita è solo questa merda, non ne vale la pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233295
    m_Localized: 'BigLebowski: E come se non fosse già tutto un disastro, ora ci si mettono pure il sole e i Visitatori!'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233296
    m_Localized: 'BigLebowski: Succederà mai qualcosa di bello?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233297
    m_Localized: 'BigLebowski: Ne dubito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054937
    m_Localized: 'Luka: Andrà tutto bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054938
    m_Localized: Sei ancora di buon umore?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054939
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054940
    m_Localized: 'Luka: Non proprio... ma non mi lascio abbattere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054941
    m_Localized: 'Luka: Restiamo umani. Dobbiamo tenere duro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054942
    m_Localized: 'Luka: Non rendiamo la situazione peggiore di quella che è.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054943
    m_Localized: 'Luka: E quando tutto sarà finito... potremo finalmente perdonarci a vicenda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054944
    m_Localized: 'Luka: Finché c''è compassione, c''è umanità. È la nostra forza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054945
    m_Localized: 'Luka: Lo pensi anche tu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054946
    m_Localized: 'Luka: Andrà tutto bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054947
    m_Localized: Sei sempre stato così?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054948
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054949
    m_Localized: 'Luka: Beh, no... non sempre. Una volta ero pieno di rabbia. Verso tutti, ma soprattutto verso me stesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054950
    m_Localized: 'Luka: Perdevo le staffe per ogni sciocchezza. Ma un giorno ho capito che quel livore non porta a nulla di buono.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054951
    m_Localized: 'Luka: Prima ti logora dall''interno, poi divora tutto ciò che ti circonda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054952
    m_Localized: 'Luka: Una volta... ho aggredito qualcuno che voleva solo aiutarmi. Ora lui... lei... non c''è più.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054953
    m_Localized: 'Luka: Quell''evento mi ha svegliato. Sapevo che dovevo cambiare, o avrei fatto terra bruciata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054954
    m_Localized: 'Luka: Quindi ho scelto di fare pace con il mondo. E questa è stata la mia salvezza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054955
    m_Localized: 'Luka: Andrà tutto bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054956
    m_Localized: Che cosa hai perso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054957
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054958
    m_Localized: 'Luka: La mia famiglia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054959
    m_Localized: 'Luka: È bastato un attimo. Ero andato a prendere dell''acqua e, quando sono tornato, la mia casa era ridotta in cenere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054960
    m_Localized: 'Luka: Non mi davo pace. Perché non ero lì? Perché non ho fatto nulla per salvarli? Queste domande mi tormentavano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054961
    m_Localized: 'Luka: Alla fine, ho capito che non avrei mai potuto cambiare il passato, ma solo imparare a conviverci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054962
    m_Localized: 'Luka: La mia famiglia è sempre con me. Il loro ricordo mi dà forza, ed è per questo che cerco di aiutare gli altri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054963
    m_Localized: 'Luka: So cosa vuol dire perdere tutto... E che significa ritrovare uno scopo dopo che il mondo ti crolla addosso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054964
    m_Localized: 'Luka: Andrà tutto bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054965
    m_Localized: Riesci a vivere nonostante quella tragedia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054966
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054967
    m_Localized: 'Luka: Sì, ce l''ho fatta, ma non è stato facile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054968
    m_Localized: 'Luka: Vivevo di rimpianti. Continuavo a pensare che se fossi tornato qualche minuto prima, sarebbero ancora vivi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054969
    m_Localized: 'Luka: Il dolore ti mangia vivo se continui a colpevolizzarti. Se non fossi riuscito a perdonarmi, oggi non sarei qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054970
    m_Localized: 'Luka: È così che sono sopravvissuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054971
    m_Localized: 'Luka: Ho perdonato prima me stesso, poi ho smesso di odiare il destino. Tutta quella rabbia mi avrebbe annientato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054972
    m_Localized: 'Luka: Andrà tutto bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054973
    m_Localized: E ora cosa ti spinge ad andare avanti?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054974
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054975
    m_Localized: 'Luka: Sono convinto che le persone possano migliorare. Persino in questo caos, esiste sempre un modo per redimersi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054976
    m_Localized: 'Luka: Non credo nei miracoli. Credo nell''umanità, nella capacità che abbiamo di sostenerci a vicenda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054977
    m_Localized: 'Luka: Aiutarsi, sorridere nei momenti bui, condividere l''ultimo pezzo di pane... La vita è in queste piccole cose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054978
    m_Localized: 'Luka: Ogni volta che qualcuno compie un gesto di bontà, so che la mia sofferenza non è stata inutile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054979
    m_Localized: 'Luka: Andrà tutto bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054980
    m_Localized: Vorresti riavere la tua vita passata, la tua famiglia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054981
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054982
    m_Localized: 'Luka: Rivederli, parlare con loro, stringerli un''ultima volta... Beh, certo che lo vorrei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054983
    m_Localized: 'Luka: Ma il passato è il passato. La perdita fa parte della vita. È terribile, fa male, ma ci rende ciò che siamo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054984
    m_Localized: 'Luka: Non fraintendermi. Darei qualsiasi cosa anche solo per un altro giorno insieme a loro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054985
    m_Localized: 'Luka: Ma se per questo dovessi rinunciare a ciò che ho imparato... a perdonare e andare avanti... allora no, non lo farei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054986
    m_Localized: 'Luka: Il tempo stringe. Piuttosto che disperarci per le perdite, facciamo tesoro di quello che ci resta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249152
    m_Localized: 'Hunter: Stai all''erta. Ognuno di noi potrebbe essere un Visitatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249153
    m_Localized: Sei un cacciatore, giusto?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249154
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249155
    m_Localized: 'Hunter: Più che altro, una guardia forestale.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249156
    m_Localized: 'Hunter: Vivevo isolato nei boschi. Niente TV, solo la radio. È così che ho saputo cosa stava succedendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249157
    m_Localized: 'Hunter: Decisi che non avrei accolto nessuno, nossignore. La mia casa è la mia fortezza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249158
    m_Localized: 'Hunter: E se fosse arrivato un Visitatore? Mi avrebbe raggirato, per poi sgozzarmi nel sonno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249159
    m_Localized: Allora perché sei qui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249160
    m_Localized: Non è sicuro stare da soli.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249161
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249162
    m_Localized: 'Hunter: Manco morto mi farò prendere da quel dannato spilungone.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249163
    m_Localized: 'Hunter: È colpa sua se ho lasciato la mia capanna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249164
    m_Localized: 'Hunter: Sì, te lo leggo negli occhi. L''hai visto anche tu, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249165
    m_Localized: Come sei sopravvissuto lì fuori da solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249166
    m_Localized: Hai visto anche tu quel Visitatore alto e pallido?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249167
    m_Localized: 'Hunter: Beh, alla fine ho capito come funziona, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249168
    m_Localized: 'Hunter: Altrimenti, a quest''ora sarei già cibo per vermi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249169
    m_Localized: 'Hunter: Una volta pensavo fosse da idioti far entrare degli estranei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249170
    m_Localized: 'Hunter: Credevo di essere più sicuro da solo... Poi è spuntato quel parassita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249171
    m_Localized: 'Hunter: Mai visto un mostro del genere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249172
    m_Localized: Come sei sopravvissuto lì fuori da solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249173
    m_Localized: Hai visto anche tu quel Visitatore alto e pallido?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249174
    m_Localized: 'Hunter: È una lunga storia, ragazzo, e oggi non ho proprio voglia di raccontarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249175
    m_Localized: 'Hunter: Domani portami una birra e ti dirò tutto, parola mia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249176
    m_Localized: 'Hunter: Quindi non sono l''unico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249177
    m_Localized: 'Hunter: Già... L''ho visto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249178
    m_Localized: 'Hunter: Se sapessi quello che ho passato, ragazzo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249179
    m_Localized: 'Hunter: Ne parlerò... ma non stasera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249180
    m_Localized: 'Hunter: Domani portami una birra e ti dirò tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249181
    m_Localized: 'Hunter: Stai all''erta. Ognuno di noi potrebbe essere un Visitatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249182
    m_Localized: Allora, che ti è successo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249183
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249184
    m_Localized: 'Hunter: Hai la mia birra?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249185
    m_Localized: Sì (dagli la birra).
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249186
    m_Localized: 'Hunter: Che? Niente birra?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249187
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249188
    m_Localized: No (non dargli la birra).
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249189
    m_Localized: 'Hunter: Grazie, ragazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249190
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249191
    m_Localized: 'Hunter: Come dicevo, ero barricato nella mia capanna, pensando ai fatti miei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249192
    m_Localized: 'Hunter: Poi un giorno si presenta questo tizio, in preda al panico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249193
    m_Localized: 'Hunter: Sbatte contro la porta, mi implora di farlo entrare, ma capisco subito che non c''è da fidarsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249194
    m_Localized: 'Hunter: È pallido e scosso, come se avesse visto la morte in faccia. Chissà come aveva fatto ad arrivare fino a me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249195
    m_Localized: 'Hunter: Non mi ricorda nessun escursionista che conosco, quindi gli dico di alzare i tacchi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249196
    m_Localized: 'Hunter: Allora lui prova a sfondare una finestra, ma quando si accorge che sono armato, scappa via.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249197
    m_Localized: 'Hunter: Pensavo che non l''avrei più rivisto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249198
    m_Localized: Forse avresti dovuto aiutarlo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249199
    m_Localized: Dovevi farlo entrare.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249200
    m_Localized: E poi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249201
    m_Localized: 'Hunter: Per far entrare anche ciò che lo stava inseguendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249202
    m_Localized: 'Hunter: Nossignore. Avevo già abbastanza problemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249203
    m_Localized: Va bene.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249204
    m_Localized: Non sei uno che parla molto, vero?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249205
    m_Localized: Non hai detto granché.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249206
    m_Localized: Fammi indovinare. Ti sciogli solo con della birra?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249207
    m_Localized: 'Hunter: Non fare l''eroe con me, ragazzo. Scommetto che anche tu hai chiuso la porta in faccia a qualcuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249208
    m_Localized: 'Hunter: Altrimenti, dubito che saresti ancora vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249209
    m_Localized: 'Hunter: Già, ma di questo parleremo domani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249210
    m_Localized: Va bene.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249211
    m_Localized: Non sei uno che parla molto, vero?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249212
    m_Localized: Non hai detto granché.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249213
    m_Localized: Fammi indovinare. Ti sciogli solo con della birra?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249214
    m_Localized: 'Hunter: Ero convinto di essermelo tolto dai piedi per sempre. Invece... è tornato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249215
    m_Localized: 'Hunter: Ma di questa storia parlerò un''altra volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249216
    m_Localized: Va bene.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249217
    m_Localized: Non sei uno che parla molto, vero?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249218
    m_Localized: Non hai detto granché.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249219
    m_Localized: Fammi indovinare. Ti sciogli solo con della birra?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249220
    m_Localized: 'Hunter: Portami della birra domani... e ti racconterò come va a finire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249221
    m_Localized: 'Hunter: Le chiacchiere non fanno per me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249222
    m_Localized: 'Hunter: Ritieniti fortunato che ti abbia detto qualcosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249223
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249224
    m_Localized: 'Hunter: Domani portami una birra e ti dirò il resto. D''accordo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249225
    m_Localized: 'Hunter: Porta pazienza, ragazzo. Questi occhi ne hanno viste di cose...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249226
    m_Localized: 'Hunter: E non è roba che mi va di ricordare da sobrio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249227
    m_Localized: 'Hunter: Portami la birra e parlerò.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249228
    m_Localized: 'Hunter: Sei sveglio, ragazzo. Te lo concedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249229
    m_Localized: 'Hunter: Non apro bocca se non ne vale la pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249230
    m_Localized: 'Hunter: Domani portami una birra e ti dirò come va a finire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249231
    m_Localized: 'Hunter: Scusa, figliolo... ma da sobrio non dico una parola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249232
    m_Localized: 'Hunter: Portami la birra e parleremo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249233
    m_Localized: 'Hunter: Stai all''erta. Ognuno di noi potrebbe essere un Visitatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249234
    m_Localized: Quindi, la storia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249235
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249236
    m_Localized: 'Hunter: Ti dirò tutto... ma prima dammi una birra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249237
    m_Localized: Certo (dagli la birra).
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249238
    m_Localized: 'Hunter: Che? Niente birra?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249239
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249240
    m_Localized: No (non dargli la birra).
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249241
    m_Localized: 'Hunter: Te ne sono grato, ragazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249242
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249243
    m_Localized: 'Hunter: Insomma, c''era questo tipo, no? Se n''è andato e io sono rimasto nella capanna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249244
    m_Localized: 'Hunter: Ma poi ho finito la legna. Sono dovuto uscire a raccoglierla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249245
    m_Localized: 'Hunter: Ho fatto scorta, sono tornato... e il mio fucile era sparito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249246
    m_Localized: 'Hunter: Ero sconvolto. Ho messo sottosopra tutta la dannata baracca, ma non ho trovato niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249247
    m_Localized: 'Hunter: È stato allora che l''ho visto fuori dalla finestra. Lo stesso tizio di prima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249248
    m_Localized: 'Hunter: Aveva il mio fucile... ma era cambiato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249249
    m_Localized: 'Hunter: Più alto, con la pelle flaccida. Completamente nudo, a parte un paio di pantaloni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249250
    m_Localized: 'Hunter: Ha afferrato il fucile con entrambe le mani... e l''ha spezzato come fosse un ramoscello.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249251
    m_Localized: 'Hunter: Poi è rimasto immobile, a guardarmi. Credevo stesse aspettando l''occasione giusta per spezzarmi il collo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249252
    m_Localized: 'Hunter: Invece, ha continuato a fissarmi... come se fossimo finiti in una specie di perversa gara di sguardi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249253
    m_Localized: 'Hunter: Alla fine è arrivata l''alba... e quel parassita è sparito nel nulla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249254
    m_Localized: 'Hunter: In quel momento, ho capito. Restare lì da solo, senza il fucile? Era un biglietto di sola andata per l''inferno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249255
    m_Localized: 'Hunter: Quindi ho levato le tende. Ero già lontano prima ancora che il sole finisse di sorgere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249256
    m_Localized: 'Hunter: Ed è così che sono finito qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249257
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249258
    m_Localized: 'Hunter: Mi auguro solo che tu faccia in tempo a sparare, figliolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249259
    m_Localized: 'Hunter: Chi lo sa, magari i proiettili funzionano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249260
    m_Localized: Perché non ti ha ucciso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249261
    m_Localized: Credi che si possa uccidere?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249262
    m_Localized: Ha sterminato un'intera squadra.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249263
    m_Localized: 'Hunter: Non lo so. Ha spezzato il mio fucile senza alcuno sforzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249264
    m_Localized: 'Hunter: Avrebbe potuto fare lo stesso a me... ma mi ha lasciato stare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249265
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249266
    m_Localized: 'Hunter: Magari si diverte a giocare con noi. Come un gatto col topo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249267
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249268
    m_Localized: 'Hunter: Non sono uno che si spaventa facilmente, ma quel bastardo pallido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249269
    m_Localized: 'Hunter: Mi terrorizza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249270
    m_Localized: 'Hunter: Vorrei tanto crederci, ragazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249271
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249272
    m_Localized: 'Hunter: Sai come si dice... "Se sanguina, si può uccidere".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249273
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249274
    m_Localized: 'Hunter: Merda... Se un''intera squadra non è riuscita a buttarlo giù, non abbiamo la minima speranza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249275
    m_Localized: 'Hunter: Se ne ha voglia, potrebbe sventrare questo posto come se fosse di burro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249276
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249277
    m_Localized: 'Hunter: Non sono uno che si spaventa facilmente, ma quel bastardo pallido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249278
    m_Localized: 'Hunter: Mi terrorizza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249279
    m_Localized: 'Hunter: Niente birra, niente storia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249280
    m_Localized: 'Hunter: Da sobrio non dico una parola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249281
    m_Localized: 'Hunter: Quindi, se vuoi sentire cos''ho da raccontare... portami da bere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443456
    m_Localized: 'Cold: Se solo ci fosse un po'' di c‑calore...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443457
    m_Localized: Ti tieni addosso la giacca?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443458
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443459
    m_Localized: 'Cold: S‑Sì. C''è un pensiero che mi spaventa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443460
    m_Localized: 'Cold: Che succede se me la t‑t‑tolgo? Non riesco a scaldarmi, nemmeno davanti al f‑fuoco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443461
    m_Localized: 'Cold: Se mi tolgo la giacca, m‑morirò per il f‑freddo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443462
    m_Localized: 'Cold: O peggio... potrei sopravvivere a sentire ancora più f‑f‑freddo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443463
    m_Localized: Ma non ti fa sudare?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443464
    m_Localized: Quindi non ti fai mai la doccia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443465
    m_Localized: 'Cold: N‑No.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443466
    m_Localized: 'Cold: Il corpo suda per r‑rinfrescarsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443467
    m_Localized: 'Cold: Ma non credo di poter diventare più f‑f‑freddo di così.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443468
    m_Localized: 'Cold: N‑Non voglio rispondere a questa domanda. S‑Scusa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443469
    m_Localized: 'Cold: Se solo ci fosse un po'' di c‑calore...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443470
    m_Localized: Hai qualche idea su come scaldarti?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443471
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443472
    m_Localized: 'Cold: Uhm... N‑Non credo di poterci fare molto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443473
    m_Localized: 'Cold: L''acqua calda non mi s‑scalda per niente, mi s‑scotta e basta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443474
    m_Localized: 'Cold: Sai...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443475
    m_Localized: 'Cold: Mi è venuta in mente una m‑m‑metafora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443476
    m_Localized: 'Cold: Immagina lo spazio profondo. Vasto e g‑g‑gelido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443477
    m_Localized: 'Cold: Nascono galassie. Le stelle c‑collassano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443478
    m_Localized: 'Cold: E io mi limito a osservare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443479
    m_Localized: 'Cold: Non sentirò mai più il tepore del s‑s‑sole.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443480
    m_Localized: 'Cold: O il c‑calore di un abbraccio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443481
    m_Localized: 'Cold: Sia lo s‑spazio, sia la società mi rifiutano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443482
    m_Localized: 'Cold: Se solo ci fosse un po'' di c‑calore...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443483
    m_Localized: Quando sei arrivato, volevi rivelarmi qualcosa. Di che si tratta?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443484
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443485
    m_Localized: 'Cold: Uhm... N‑Non so se mi va di parlarne in questo momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443486
    m_Localized: 'Cold: Ho un p‑pensiero in mente. Da tanto tempo. Forse è il motivo per cui sento così... f‑f‑freddo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443487
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443488
    m_Localized: 'Cold: Non vorrei parlarne, ma temo che se non lo faccio, finirà per consumarmi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443489
    m_Localized: 'Cold: Io...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443490
    m_Localized: 'Cold: Te lo d‑dirò d‑domani. Allora s‑sarò pronto, credo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443491
    m_Localized: 'Cold: Se solo ci fosse un po'' di c‑calore...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443492
    m_Localized: Allora, che stai nascondendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443493
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443494
    m_Localized: 'Cold: Sì. C''era un s‑segreto che volevo svelarti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443495
    m_Localized: 'Cold: Credo sia arrivato il momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443496
    m_Localized: 'Cold: Di solito finisce m‑male, ma forse n‑non questa volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443497
    m_Localized: 'Cold: Sotto i miei abiti si nasconde il m‑motivo per cui sono così s‑solo e gelato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443498
    m_Localized: 'Cold: Guarda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443499
    m_Localized: 'Cold: No... N‑Non di nuovo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443500
    m_Localized: Che hai fatto?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443501
    m_Localized: Ora sei fregato!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443502
    m_Localized: 'Cold: Io n‑non volevo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443503
    m_Localized: 'Cold: Speravo fosse d‑d‑diverso, in questo posto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443504
    m_Localized: 'Cold: Ma non lo è m‑mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443505
    m_Localized: 'Cold: N‑Non volevo questo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443506
    m_Localized: 'Cold: Io... t‑te lo giuro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443507
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443508
    m_Localized: Mandalo via
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443509
    m_Localized: 'Cold: È c‑come l''altra volta...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443510
    m_Localized: 'Cold: Perché mi sono illuso che stavolta s‑s‑sarebbe stato diverso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443511
    m_Localized: 'Cold: L‑Lascia che ti spieghi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443512
    m_Localized: 'Cold: Non l''ho fatto per m‑m‑malizia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443513
    m_Localized: 'Cold: N‑Non era questo il mio scopo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443514
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443515
    m_Localized: Mandalo via
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443516
    m_Localized: 'Cold: Forse... è meglio c‑c‑così.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443517
    m_Localized: 'Cold: Niente più f‑f‑freddo. E solitudine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443518
    m_Localized: 'Cold: Io...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443519
    m_Localized: 'Cold: N‑Non pensare che l''abbia fatto apposta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443520
    m_Localized: 'Cold: Adesso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443521
    m_Localized: 'Cold: Una p‑pallottola sarebbe una grazia. Purtroppo, s‑s‑sento ancora il dolore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443522
    m_Localized: 'Cold: Il s‑sole ci metterebbe di p‑più.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443523
    m_Localized: 'Cold: Posso restare almeno fino al t‑tramonto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443524
    m_Localized: Vattene subito.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443525
    m_Localized: Ok, ma non fare scherzi.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443526
    m_Localized: 'Cold: Ho capito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443527
    m_Localized: 'Cold: S‑Scusa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443528
    m_Localized: 'Cold: Forse il sole mi s‑scalderà. Un''ultima v‑v‑volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443529
    m_Localized: 'Cold: G‑Grazie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443530
    m_Localized: 'Cold: S‑So che mi odi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443531
    m_Localized: 'Cold: E‑Eppure...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443532
    m_Localized: 'Cold: Mi d‑d‑dispiace. Non volevo che finisse così.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832064
    m_Localized: 'Daughter: E poi... ecco... forse potresti invitare la mia amica?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832065
    m_Localized: 'Daughter: Quando sono i grandi a chiamare, lei può andare. Ma se lo faccio io, finisco nei guai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832066
    m_Localized: 'Daughter: Questo è il suo numero di telefono: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832067
    m_Localized: 'Greatmother: Oh, tesoro... Per favore, non far entrare nessuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832068
    m_Localized: Perché la FEMA ti ha sfrattata? Non ti hanno spiegato niente?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832069
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832070
    m_Localized: 'Greatmother: E cosa ne so, gioia? Quei tizi in tuta... non si capisce mai cosa gli passi per la testa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832071
    m_Localized: 'Greatmother: Sempre a camminare impettiti e a urlare ordini...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832072
    m_Localized: 'Greatmother: Ma chi si credono di essere?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832073
    m_Localized: 'Greatmother: Pensano di poterci comandare? Non sanno niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832074
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832075
    m_Localized: 'Greatmother: Per caso hanno bussato anche da te?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832076
    m_Localized: Sì.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832077
    m_Localized: Uno di loro è sempre qui intorno.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832078
    m_Localized: 'Greatmother: Che bastardi! Gli strapperei quelle tute e li rispedirei a calci da dove sono venuti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832079
    m_Localized: 'Greatmother: Così imparano come ci si comporta con la gente perbene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832080
    m_Localized: 'Greatmother: Ora si mettono anche a occupare gli edifici?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832081
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832082
    m_Localized: 'Greatmother: Gli manca l''educazione, ecco cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832083
    m_Localized: 'Greatmother: Una volta ci può stare. Ma farlo di continuo...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832084
    m_Localized: 'Greatmother: Sono senza vergogna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832085
    m_Localized: 'Greatmother: Oh, tesoro... Per favore, non far entrare nessuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832086
    m_Localized: Hanno portato via qualcuno della tua famiglia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832087
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832088
    m_Localized: 'Greatmother: Oh, è da un pezzo che nessuno mi chiede più della mia cucciolata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832089
    m_Localized: 'Greatmother: Mi chiamano "Mamma chioccia". Ne ho messi al mondo un bel mucchio, di quei discoli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832090
    m_Localized: 'Greatmother: Il cielo li benedica...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832091
    m_Localized: 'Greatmother: A casa ci stavamo a malapena!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832092
    m_Localized: 'Greatmother: Per colpa di quegli idioti, i poverini dovevano passare le giornate barricati al chiuso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832093
    m_Localized: Non mi hai risposto.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832094
    m_Localized: Quindi, si sono presi la tua famiglia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832095
    m_Localized: 'Greatmother: Oh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832096
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832097
    m_Localized: 'Greatmother: Scusami, tesoro, mi sono persa nei miei pensieri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832098
    m_Localized: 'Greatmother: Quei parassiti in tuta si sono presi fino all''ultimo dei miei figli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832099
    m_Localized: 'Greatmother: Ma non la passeranno liscia, nossignore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832100
    m_Localized: 'Greatmother: Hanno portato via qualcuno anche a te?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832101
    m_Localized: Non ho nessuno.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832102
    m_Localized: No.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832103
    m_Localized: 'Greatmother: Oh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832104
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832105
    m_Localized: 'Greatmother: Scusami, tesoro, mi sono persa nei miei pensieri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832106
    m_Localized: 'Greatmother: Quei parassiti in tuta si sono presi fino all''ultimo dei miei figli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832107
    m_Localized: 'Greatmother: Hanno portato via qualcuno anche a te?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832108
    m_Localized: Non ho nessuno.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832109
    m_Localized: No.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832110
    m_Localized: 'Greatmother: No? Allora che ci fai con una casa così enorme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832111
    m_Localized: 'Greatmother: Vivere qui tutto solo, tesoro... Non è giusto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832112
    m_Localized: 'Greatmother: Una casa del genere è più adatta a una famiglia, non trovi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832113
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832114
    m_Localized: 'Greatmother: Va bene, non voglio curiosare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832115
    m_Localized: 'Greatmother: Spero solo di riprendermi i miei piccoli da quelle dannate zone di quarantena...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832116
    m_Localized: 'Greatmother: A te non hanno fatto nulla, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832117
    m_Localized: 'Greatmother: Allora dove sono finiti i tuoi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832118
    m_Localized: 'Greatmother: Una casa così grande non è fatta per una persona sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832119
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832120
    m_Localized: 'Greatmother: Va bene, non voglio curiosare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832121
    m_Localized: 'Greatmother: Voglio solo i miei piccoli fuori da quelle zone di quarantena...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832122
    m_Localized: 'Greatmother: Oh, tesoro... Per favore, non far entrare nessuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832123
    m_Localized: Pensi di andare a riprenderti la tua famiglia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832124
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832125
    m_Localized: 'Greatmother: Non ci penso nemmeno! Ce la faranno da soli a uscire di lì, tesoro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832126
    m_Localized: Che vuoi dire?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832127
    m_Localized: Da soli?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832128
    m_Localized: 'Greatmother: Potrebbero strisciare sottoterra, per poi sbucare dall''altra parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832129
    m_Localized: 'Greatmother: Non basteranno recinzioni e filo spinato a bloccarli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832130
    m_Localized: 'Greatmother: E se non dovessero riuscirci così, allora faranno a pezzi quel postaccio. Il cielo li benedica.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832131
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832132
    m_Localized: 'Greatmother: Stanno arrivando. Mamma chioccia lo sa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832133
    m_Localized: Ma che diavolo stai dicendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832134
    m_Localized: Sei impazzita?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832135
    m_Localized: In che senso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832136
    m_Localized: (Uccidila)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832137
    m_Localized: 'Greatmother: Anche queste mura crolleranno, quando arriverà l''ora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832138
    m_Localized: 'Greatmother: Ci saranno montagne di cadaveri. E allora, tesoro... arriverà lui, per godersi il banchetto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832139
    m_Localized: 'Greatmother: Quei tipi in tuta non si cureranno più dei miei piccoli. Avranno altre gatte da pelare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832140
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832141
    m_Localized: 'Greatmother: Stanno arrivando. Mamma chioccia lo sa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832142
    m_Localized: Ma che diavolo stai dicendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832143
    m_Localized: Sei impazzita?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832144
    m_Localized: In che senso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832145
    m_Localized: (Uccidila)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832146
    m_Localized: 'Greatmother: Schiacceremo questi formicai che avete tirato su...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832147
    m_Localized: 'Greatmother: Le mura crolleranno... le strade si tingeranno di rosso... costruiremo tumuli con le vostre carcasse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832148
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832149
    m_Localized: 'Greatmother: Li sento strisciare. Sono quasi qui...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832150
    m_Localized: Che significa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832151
    m_Localized: Chi sei?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832152
    m_Localized: Sei un Visitatore?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832153
    m_Localized: (Uccidila)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832154
    m_Localized: 'Greatmother: La carne bruciata ha un profumo delizioso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832155
    m_Localized: 'Greatmother: Quei tizi in tuta cuociono che è un piacere. Forse troppo croccanti, ma saporiti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832156
    m_Localized: 'Greatmother: E qui c''è gente, tesoro. Tanti corpi. I miei bambini mangeranno bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832157
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832158
    m_Localized: 'Greatmother: Li sento strisciare. Sono quasi qui...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832159
    m_Localized: Che significa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832160
    m_Localized: Chi sei?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832161
    m_Localized: Sei un Visitatore?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832162
    m_Localized: (Uccidila)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832163
    m_Localized: 'Greatmother: Questo posto... è perfetto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832164
    m_Localized: 'Greatmother: Una casa grande, quasi vuota. Tanto spazio... per tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832165
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832166
    m_Localized: 'Greatmother: Li sento strisciare. Sono quasi qui...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832167
    m_Localized: Che significa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832168
    m_Localized: Chi sei?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832169
    m_Localized: Sei un Visitatore?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832170
    m_Localized: (Uccidila)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832171
    m_Localized: 'Greatmother: Bastardo! Lurido verme!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832172
    m_Localized: 'Greatmother: Verranno a prendervi tutti quanti...!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832173
    m_Localized: 'Greatmother: Piccoli miei, mamma ha trovato un nuovo nido...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832174
    m_Localized: 'Greatmother: Venite. A lui questa casa non servirà più.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832175
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832176
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832177
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832178
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832179
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832180
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832181
    m_Localized: 'Greatmother: Mamma chioccia vuole vedere i suoi piccoli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832182
    m_Localized: 'Greatmother: Venite, questa casa ci accoglierà tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832183
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832184
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832185
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832186
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832187
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832188
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832189
    m_Localized: 'Greatmother: Strisciate, miei piccoli. La mamma è qui! Vi ha trovato una nuova casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832190
    m_Localized: 'Greatmother: Così spaziosa. Così bella. Così vuota.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832191
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832192
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832193
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832194
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832195
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832196
    m_Localized: (UCCIDILA)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832197
    m_Localized: 'Greatmother: Bastardo! Dammi la casa! Tanto tu la odi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832198
    m_Localized: 'Greatmother: Vuoi solo che bruci!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026368
    m_Localized: 'Greatmother: DALLA A MAMMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026369
    m_Localized: 'Greatmother: Povero caro... Io so cosa cerchi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026370
    m_Localized: 'Greatmother: La morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026371
    m_Localized: 'Wolfhound: C''è qualche problema?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220672
    m_Localized: Perché consideri le persone come animali?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220673
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220674
    m_Localized: 'Wolfhound: Senti, dimmi una cosa... Cosa siamo noi, davvero?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220675
    m_Localized: 'Wolfhound: Uccidiamo. Mangiamo animali morti, senza rimorsi. È così che siamo fatti, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220676
    m_Localized: 'Wolfhound: Ma la società ci ha messo un guinzaglio, capisci? Per fortuna, quei giorni sono finiti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220677
    m_Localized: Che vuoi dire?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220678
    m_Localized: Sei felice di come sono andate le cose?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220679
    m_Localized: 'Wolfhound: È semplice. Gli istinti naturali hanno preso il posto di quelle regole inutili e senza senso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220680
    m_Localized: 'Wolfhound: C''è un branco e un alfa. Se minacci il branco, muori. Questa è la morale che approvo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220681
    m_Localized: 'Wolfhound: Sai qual è la cosa peggiore? Una pecora travestita da lupo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220682
    m_Localized: Pensi che un branco funzioni meglio della società?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220683
    m_Localized: Vuoi dire un lupo travestito da pecora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220684
    m_Localized: 'Wolfhound: Compare, sono solo felice che ormai quasi tutti abbiano smesso di nascondersi dietro una maschera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220685
    m_Localized: 'Wolfhound: Ma le pecore... le pecore rovinano sempre tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220686
    m_Localized: 'Wolfhound: Giocano a fare i lupi, ma è tutta una finzione. Non hanno gli attributi di un vero uomo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220687
    m_Localized: 'Wolfhound: Si nascondono come vermi, giocano al gatto con il topo, invece di battersi faccia a faccia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220688
    m_Localized: 'Wolfhound: Ma se hai un branco alle spalle, questi buffoni li riconosci subito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220689
    m_Localized: Pensi che un branco funzioni meglio della società?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220690
    m_Localized: Vuoi dire un lupo travestito da pecora?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220691
    m_Localized: 'Wolfhound: E tu no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220692
    m_Localized: 'Wolfhound: Nella società "normale", una di quelle pecore non l''avresti mai riconosciuta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220693
    m_Localized: 'Wolfhound: Troppe chiacchiere, troppe regole. Ti perdevi in mille stronzate invece di fare quello che andava fatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220694
    m_Localized: 'Wolfhound: Per questo serve l''alfa. Niente domande o votazioni, lui ordina e tu esegui, senza fiatare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220695
    m_Localized: 'Wolfhound: Un alfa non può mostrare debolezze. Solo così il branco sopravvive. È semplice.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220696
    m_Localized: 'Wolfhound: No, parlo di quei codardi che voi chiamate Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220697
    m_Localized: 'Wolfhound: Se ne stavano sottoterra come ratti, aspettando che ci rammollissimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220698
    m_Localized: 'Wolfhound: Ora spuntano fuori e approfittano della nostra "morale" per pararsi il culo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220699
    m_Localized: 'Wolfhound: Dobbiamo mostrare le zanne. Se non capiscono che comandiamo noi, ci faranno la pelle uno dopo l''altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220700
    m_Localized: 'Wolfhound: C''è qualche problema?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220701
    m_Localized: Perché continui a guardare il mio fucile?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220702
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220703
    m_Localized: 'Wolfhound: In te vedo un alfa, boss. Tu tieni tutti in riga, hai dimostrato chi comanda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220704
    m_Localized: 'Wolfhound: Bel posto che hai, davvero. Spazioso... Passa parecchia gente, eh? Ma certi elementi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220705
    m_Localized: Cos'hanno che non va?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220706
    m_Localized: Pensi che qualcuno di loro sia un Visitatore?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220707
    m_Localized: 'Wolfhound: Ti sei circondato di schiappe. Smidollati.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220708
    m_Localized: 'Wolfhound: Spiegami, che te ne fai di vecchi, ragazzini o moribondi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220709
    m_Localized: 'Wolfhound: Solo i forti formano un vero branco. È l''unico modo per restare vivi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220710
    m_Localized: Cosa vorresti che facessi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220711
    m_Localized: Dovrei sbatterli fuori?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220712
    m_Localized: 'Wolfhound: Il problema qui non sono le pecore che si fingono lupi, boss. Ma che i lupi non valgono un cazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220713
    m_Localized: 'Wolfhound: Il tuo branco è indisciplinato. C''è un viavai di gente che fa come gli pare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220714
    m_Localized: 'Wolfhound: Scegli i più forti e punta su di loro. Il resto è soltanto zavorra. È semplice.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220715
    m_Localized: Cosa vorresti che facessi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220716
    m_Localized: Dovrei sbatterli fuori?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220717
    m_Localized: 'Wolfhound: È ora di tagliare i rami secchi, dolcezza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220718
    m_Localized: 'Wolfhound: Ammazzali. In pubblico. Manda un messaggio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220719
    m_Localized: 'Wolfhound: Serve il pugno di ferro. Solo così capiranno chi comanda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220720
    m_Localized: 'Wolfhound: Quelli che non battono ciglio mentre gli scarti schiattano... Ecco i lupi che vuoi nel tuo branco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220721
    m_Localized: 'Wolfhound: E possono restare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220722
    m_Localized: Non sono un assassino.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220723
    m_Localized: Uccido solo i Visitatori.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220724
    m_Localized: 'Wolfhound: Se non fai qualcosa, la tua autorità crollerà, boss. Penseranno che sei un vigliacco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220725
    m_Localized: 'Wolfhound: La pietà è solo debolezza travestita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220726
    m_Localized: 'Wolfhound: Devi essere spietato. Un Visitatore? Bam! Un debole? Bam! Un vecchio? Bam!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220727
    m_Localized: 'Wolfhound: È così che incuti paura. Fagli capire chi ha il potere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220728
    m_Localized: Non sono un assassino.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220729
    m_Localized: Uccido solo i Visitatori.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220730
    m_Localized: 'Wolfhound: Chi vuoi fregare, dolcezza? Ti si legge negli occhi cosa pensi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220731
    m_Localized: 'Wolfhound: Sei un assassino. A sangue freddo. Non far finta di avere le mani pulite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220732
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220733
    m_Localized: 'Wolfhound: Queste strade erano roba mia, una volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220734
    m_Localized: 'Wolfhound: La gente aveva paura di me. Mi rispettava.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220735
    m_Localized: 'Wolfhound: Ti sei mai chiesto quanto ci mette un''anima a imputridire?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220736
    m_Localized: 'Wolfhound: Io sono marcio da un pezzo, ormai... Pus e tutto il resto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220737
    m_Localized: 'Wolfhound: Una volta, un tassista non ha voluto farmi salire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220738
    m_Localized: 'Wolfhound: Se avessi lasciato correre, avrei fatto la figura del fesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220739
    m_Localized: 'Wolfhound: Così, gli ho spezzato tutte le ossa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220740
    m_Localized: 'Wolfhound: Ma suo figlio ha imparato la lezione. E la gente ha continuato a portarmi rispetto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220741
    m_Localized: 'Wolfhound: Stammi a sentire. Faresti molta più strada se smettessi di fare da balia a questi rammolliti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220742
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220743
    m_Localized: 'Wolfhound: Le strade erano roba mia, una volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220744
    m_Localized: 'Wolfhound: La gente aveva paura di me. Mi rispettava.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220745
    m_Localized: 'Wolfhound: Ti sei mai chiesto quanto ci mette un''anima a imputridire?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220746
    m_Localized: 'Wolfhound: Io sono marcio da un pezzo, ormai... Pus e tutto il resto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220747
    m_Localized: 'Wolfhound: Una volta, un tassista non ha voluto farmi salire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220748
    m_Localized: 'Wolfhound: Se avessi lasciato correre, avrei fatto la figura del fesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220749
    m_Localized: 'Wolfhound: Così, gli ho spezzato tutte le ossa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220750
    m_Localized: 'Wolfhound: Ma suo figlio ha imparato la lezione. E la gente ha continuato a portarmi rispetto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220751
    m_Localized: 'Wolfhound: C''è qualche problema?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220752
    m_Localized: Continui a parlare di branchi... Perché non ne hai uno tuo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220753
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220754
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220755
    m_Localized: 'Wolfhound: E tu? Perché ne hai uno?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220756
    m_Localized: Così quel Visitatore alto e pallido non può uccidermi.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220757
    m_Localized: Sto cercando di aiutare la gente.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220758
    m_Localized: Preferisco stare in compagnia.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220759
    m_Localized: Perché questa gente ha bisogno di un capo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220760
    m_Localized: Te l'ho chiesto prima io.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220761
    m_Localized: 'Wolfhound: Quindi li hai radunati qui solo per salvarti le chiappe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220762
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220763
    m_Localized: 'Wolfhound: Altro che alfa... Parli come un moccioso cagasotto qualsiasi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220764
    m_Localized: 'Wolfhound: A questo branco serve qualcuno forte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220765
    m_Localized: 'Wolfhound: Mi sa che dovrò prendere il tuo posto. Non sei in grado di guidare un bel niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220766
    m_Localized: 'Wolfhound: Nobile, non c''è che dire. Anche se stupido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220767
    m_Localized: 'Wolfhound: Non puoi salvare tutti. Prima o poi dovrai sbattere la porta in faccia a qualcuno. È semplice.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220768
    m_Localized: 'Wolfhound: Però parli come un vero alfa, uno con le palle. Non posso negarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220769
    m_Localized: 'Wolfhound: Tutto qui? Non hai il fegato di stare da solo, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220770
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220771
    m_Localized: 'Wolfhound: Queste non sono parole da alfa. Sei solo un''altra pecora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220772
    m_Localized: 'Wolfhound: Bene, così parla un vero uomo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220773
    m_Localized: 'Wolfhound: Sarei un idiota a contraddirti, non ti pare, boss?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220774
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220775
    m_Localized: 'Wolfhound: Non ti dico niente. Meno ne sai, meglio è.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220776
    m_Localized: 'Wolfhound: Ho parlato anche troppo. Adesso tocca a te sputare il rospo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220777
    m_Localized: 'Wolfhound: Se non sei capace di guidare il branco, lo farò io, cazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220778
    m_Localized: Vaffanculo!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220779
    m_Localized: Pensi di essere meglio di me, eh?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220780
    m_Localized: (Impugni il fucile)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220781
    m_Localized: Sparisci, o ti faccio saltare il cervello.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220782
    m_Localized: 'Wolfhound: A cuccia, cagnolino. Per me non vali più niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220783
    m_Localized: 'Wolfhound: Se non sai comandare, perché fai il capobranco? Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220784
    m_Localized: 'Wolfhound: Vattene, o ti faccio fuori con le mie mani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220785
    m_Localized: 'Wolfhound: Io so cos''è un branco. Vivo secondo il codice.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220786
    m_Localized: 'Wolfhound: Un mollaccione come te non può essere un alfa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220787
    m_Localized: 'Wolfhound: Vattene, o ti faccio fuori con le mie mani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220788
    m_Localized: 'Wolfhound: Ah, quindi le cose stanno così?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220789
    m_Localized: 'Wolfhound: Lo sai che il ferro ce l''ho anch''io, vero? Coglione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220790
    m_Localized: 'Wolfhound: Mettilo giù, compare. Chiudiamola qui, ok?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220791
    m_Localized: (Spara)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220792
    m_Localized: (Abbassa il fucile)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220793
    m_Localized: 'Wolfhound: Crepa, pezzo di...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220794
    m_Localized: 'Wolfhound: Ma pensa... Il cucciolo mi ha sparato sul serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220795
    m_Localized: 'Wolfhound: Così si fa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220796
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220797
    m_Localized: 'Wolfhound: Ma avresti dovuto finire il lavoro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220798
    m_Localized: 'Wolfhound: (Approfitta della tua distrazione ed estrae la pistola)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220799
    m_Localized: 'Wolfhound: (La punta su di te)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220800
    m_Localized: 'Wolfhound: (Per fortuna, riesci ad afferrare il fucile e sparare)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220801
    m_Localized: 'Doctor: Ti ascolto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220802
    m_Localized: Cos'è successo agli ospedali?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220803
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220804
    m_Localized: 'Doctor: Oh... È stato terribile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220805
    m_Localized: 'Doctor: Quando la situazione peggiorò, la gente assalì gli ospedali, ansiosa di scoprire se fossero dei Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220806
    m_Localized: 'Doctor: Noi continuavamo a spiegare che, in realtà, non sapevamo come verificarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220807
    m_Localized: 'Doctor: Ma nessuno ci dava retta. Si accalcavano, si spintonavano... rendendo impossibile curare i veri malati.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220808
    m_Localized: 'Doctor: Poi arrivò la FEMA. Loro... decisero che la folla rappresentava un rischio per il contenimento dell''epidemia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220809
    m_Localized: 'Doctor: Così portarono tutti i pazienti nelle zone di quarantena, e gli ospedali... beh, semplicemente chiusero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220810
    m_Localized: Quindi la FEMA ti ha tolto il lavoro?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220811
    m_Localized: Credo che la FEMA abbia fatto bene.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220812
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220813
    m_Localized: 'Doctor: In realtà... dopo la chiusura degli ospedali, mi sono occupato del triage presso una delle zone di quarantena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220814
    m_Localized: Perché lo hai fatto?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220815
    m_Localized: Ah, sei solo un altro di quei bastardi.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220816
    m_Localized: 'Doctor: Quindi secondo te è stato giusto rastrellare tutta quella gente come bestiame?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220817
    m_Localized: 'Doctor: Non trovi assurdi questi cosiddetti "segni"? Sono soltanto normali caratteristiche umane!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220818
    m_Localized: 'Doctor: Quante sciocchezze! I denti bianchi ti renderebbero un Visitatore? Non esiste alcun fondamento logico!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220819
    m_Localized: 'Doctor: Credo che ci stiano nascondendo qualcosa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220820
    m_Localized: 'Doctor: In realtà... dopo la chiusura degli ospedali, mi sono occupato del triage presso una delle zone di quarantena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220821
    m_Localized: 'Doctor: Speravo di scoprire qualcosa sui Visitatori e sui loro segni. Purtroppo, non ho ottenuto alcun risultato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220822
    m_Localized: Perché lo hai fatto?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220823
    m_Localized: Ah, sei solo un altro di quei bastardi.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220824
    m_Localized: 'Doctor: Io... volevo continuare ad aiutare le persone. È la mia vocazione. Non potevo abbandonarle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220825
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220826
    m_Localized: 'Doctor: Forse... No. Scusa, ma non sono ancora pronto a parlarne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220827
    m_Localized: 'Doctor: Non conosci l''intera storia, e le tue parole mi hanno ferito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220828
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220829
    m_Localized: 'Doctor: Forse... No. Scusa, ma non sono ancora pronto a parlarne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220830
    m_Localized: 'Doctor: Ti ascolto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220831
    m_Localized: Allora, di cosa volevi parlarmi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220832
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220833
    m_Localized: 'Doctor: Cosa ne pensi della FEMA?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220834
    m_Localized: Credo che la FEMA stia facendo un buon lavoro.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220835
    m_Localized: Non mi fido di loro.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220836
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220837
    m_Localized: 'Doctor: Peccato. Io la penso diversamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220838
    m_Localized: 'Doctor: Ho lavorato con loro per un periodo. E dopo quello che ho visto... non ho alcun motivo di fidarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220839
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220840
    m_Localized: 'Doctor: Parlo per esperienza. In quell''organizzazione, i medici non sanno mai nulla di ciò che accade realmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220841
    m_Localized: 'Doctor: Come puoi credere a gente incapace persino di spiegare l''origine di questi "segni" e il loro significato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220842
    m_Localized: 'Doctor: Dopo tutto quel che è successo... riesci ancora a fidarti della FEMA?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220843
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220844
    m_Localized: 'Doctor: Lo confesso, avevo un''opinione migliore di te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220845
    m_Localized: 'Doctor: Bene. Neanch''io.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220846
    m_Localized: 'Doctor: In verità, anche a me sfuggono le loro reali motivazioni. Persino dopo averci collaborato per diverso tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220847
    m_Localized: 'Doctor: Ma qualunque cosa li spinga, ho scelto di stare dalla parte della gente. Alle mie regole, non alle loro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220848
    m_Localized: 'Doctor: Il problema era la chiarezza. E quella mancava totalmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220849
    m_Localized: 'Doctor: Non ci è mai stata rivelata l''origine di questi "segni", né il loro significato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220850
    m_Localized: 'Doctor: Ci hanno solo consegnato una lista di direttive. Ci dicevano chi identificare come Visitatore e chi lasciar andare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220851
    m_Localized: 'Doctor: Da quel momento, ho smesso di sentirmi un dottore. Ero una guardia di confine che timbrava documenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220852
    m_Localized: 'Doctor: Allora ho iniziato a falsificare i rapporti. Aiutavo le persone a fuggire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220853
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220854
    m_Localized: 'Doctor: Immagino che avrai altre domande, ma se non ti dispiace, lasciamo il resto a domani.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713912
    m_Localized: 'Doctor: Scusa, ma per oggi non sono pronto a dire altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713913
    m_Localized: 'Doctor: Quindi ho deciso di lasciare l''organizzazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220855
    m_Localized: 'Doctor: Ti ascolto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220856
    m_Localized: Perché non sei rimasto nelle zone di quarantena?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220857
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220858
    m_Localized: 'Doctor: Ci fu... un incidente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220859
    m_Localized: 'Doctor: Era quasi l''alba. Stavo tornando a casa, quando mi sentii chiamare da un agente della FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220860
    m_Localized: 'Doctor: Il cuore mi martellava nel petto, e per poco non caddi in ginocchio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220861
    m_Localized: 'Doctor: Mi urlò di voltarmi verso di lui... e io pensai di essere spacciato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220862
    m_Localized: 'Doctor: Puntò il fucile alle mie gambe e mi disse di non muovermi. Continuò a fissarmi, e poi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220863
    m_Localized: 'Doctor: Mi ordinò di mostrargli la lingua, per vedere se fossi un Visitatore. Ero terrorizzato, e ubbidii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220864
    m_Localized: 'Doctor: E lui... scoppiò a ridere. Mi disse che ero un povero idiota, se credevo sul serio che la lingua fosse un segno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220865
    m_Localized: 'Doctor: Non ho mai avuto tanta paura in vita mia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220866
    m_Localized: 'Doctor: In quel momento, volevo soltanto uscirne vivo. Non mi interessava salvare nessun altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220867
    m_Localized: 'Doctor: Scappai. Come un codardo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220868
    m_Localized: 'Doctor: È una vergogna insostenibile. Come posso guardarmi allo specchio, sapendo di aver abbandonato quei poveretti...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220869
    m_Localized: Non ti biasimo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220870
    m_Localized: Puoi ancora aiutare le persone.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220871
    m_Localized: Sei patetico, vattene da casa mia.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220872
    m_Localized: 'Doctor: Grazie per la comprensione. È come se mi fossi tolto un peso dal petto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220873
    m_Localized: 'Doctor: Continuo a chiedermi quante altre vite avrei potuto salvare, se avessi avuto il coraggio di restare...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220874
    m_Localized: 'Doctor: Temo di no...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220875
    m_Localized: 'Doctor: Ho lasciato i miei strumenti nella zona di quarantena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220876
    m_Localized: 'Doctor: Ormai sono inutile...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220877
    m_Localized: 'Doctor: So che speravi in una cura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220878
    m_Localized: 'Doctor: Ma cosa può fare un vecchio come me, rimasto a mani vuote?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220879
    m_Localized: 'Doctor: Mi dispiace se ti ho deluso, figliolo. Temo di essere impotente contro la minaccia dei Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220880
    m_Localized: Non preoccuparti, puoi restare comunque.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220881
    m_Localized: Allora quella è la porta, tanti saluti.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220882
    m_Localized: 'Doctor: Io... suppongo tu abbia ragione. Sarà meglio che vada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220883
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220884
    m_Localized: 'Doctor: Addio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220885
    m_Localized: 'Doctor: Grazie per la comprensione. È come se mi fossi tolto un peso dal petto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220886
    m_Localized: 'Doctor: Immagino che la FEMA avrebbe scoperto i falsi rapporti, prima o poi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220887
    m_Localized: 'Doctor: Eppure, non riesco a non pensare a quante altre persone avrei potuto salvare, se fossi stato più coraggioso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220888
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220889
    m_Localized: 'Doctor: Temo che mi porterò questo rimorso nella tomba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220890
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220891
    m_Localized: 'Doctor: Hai ragione. Non c''è spazio per un vecchio come me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220892
    m_Localized: 'Doctor: Addio.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713914
    m_Localized: 'Doctor: Perché me lo chiedi? Vuoi sapere perché non mi fido della FEMA?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713915
    m_Localized: 'Doctor: Partiamo da una premessa...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713916
    m_Localized: 'Doctor: Credi che i Visitatori siano una specie di virus?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713917
    m_Localized: Non credo che esistano.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713918
    m_Localized: No, ma non so cosa siano.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713919
    m_Localized: Sì.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713920
    m_Localized: 'Doctor: In questo caso, non capisco perché ti ostini con tutti questi test.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713921
    m_Localized: 'Doctor: Perché cerchi d''ingannarmi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713922
    m_Localized: 'Doctor: Quindi...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713923
    m_Localized: 'Doctor: Capisco. Purtroppo, nemmeno io ho idea di cosa siano realmente i Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713924
    m_Localized: 'Doctor: Ma posso affermare con certezza che non abbiamo a che fare con un virus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713925
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713926
    m_Localized: 'Doctor: Beh, spiacente di deluderti, ma molto probabilmente non è così.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713927
    m_Localized: 'Doctor: Hai mai visto qualcuno apparentemente sano mutare all''improvviso? Diventare un Visitatore davanti ai tuoi occhi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713928
    m_Localized: 'Doctor: Esatto. Un caso del genere non si è mai verificato.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713929
    m_Localized: 'Doctor: Devi capire una cosa: la FEMA non ha il controllo della situazione. La loro è solo propaganda.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713930
    m_Localized: 'Doctor: Hanno chiuso gli ospedali e mandato tutti in quarantena... ma a che scopo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713931
    m_Localized: 'Doctor: Aiutano le persone, secondo te? Qualcuno è mai guarito?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713932
    m_Localized: 'Doctor: La FEMA le ha semplicemente ammassate e segregate. Ora può fare ciò che vuole, senza interferenze.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713933
    m_Localized: Allora perché hai lavorato per la FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713934
    m_Localized: Basta con queste sciocchezze, vattene.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713935
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713936
    m_Localized: 'Doctor: Non potevo restare a guardare mentre uccidevano tutti, uno a uno.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713937
    m_Localized: 'Doctor: Per questo sono entrato nella FEMA. Volevo aiutare quella povera gente a fuggire dalla quarantena.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713938
    m_Localized: 'Doctor: Ho fatto esami e diagnosi, poi ho falsificato i referti affinché potessero uscire.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713939
    m_Localized: Potresti aver liberato dei Visitatori.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713940
    m_Localized: Che incidente?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713941
    m_Localized: E ora dovrai andartene anche da qui.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713942
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713943
    m_Localized: 'Doctor: È un peccato che tu non voglia ascoltare la mia versione dei fatti...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713944
    m_Localized: 'Doctor: In tal caso, non ti ruberò altro tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713945
    m_Localized: 'Doctor: Addio.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713946
    m_Localized: 'Doctor: Che alternative avevo? Lasciarli lì a morire?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713947
    m_Localized: 'Doctor: Ho pronunciato il giuramento di Ippocrate. Fare tutto il possibile per proteggere la vita e la salute.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713948
    m_Localized: 'Doctor: Eppure, alla fine... sono dovuto fuggire anch''io dalla quarantena.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713949
    m_Localized: 'Doctor: C''è stato un incidente nella zona in cui prestavo servizio.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713950
    m_Localized: 'Doctor: Ma cosa...?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713951
    m_Localized: 'Doctor: Pensi che non avrei dovuto aiutarli? E per questo ora mi stai cacciando?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713952
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713953
    m_Localized: 'Doctor: Non credevo l''avrei mai detto, ma tu sei peggio della FEMA. Loro almeno fingono di aiutare...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713954
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713955
    m_Localized: 'Doctor: Non ho più motivo di restare. Temo sinceramente per la sorte di chiunque si affidi a te.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713956
    m_Localized: 'Doctor: Addio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220893
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220894
    m_Localized: Ti sei tolto i punti dalla bocca?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220895
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220896
    m_Localized: 'Foreigner: Jfvhgl è fm rmxfyl!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220897
    m_Localized: 'Foreigner: Nr szmml XFXRGL OZ YLXXZ! Hlol kvixsé mlm nr xzkrhxlml.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220898
    m_Localized: Non ti capisco.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220899
    m_Localized: Capisci quello che sto dicendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220900
    m_Localized: 'Foreigner: Mlm gr xzkrhxl. Xlhz klhhrznl uziv?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220901
    m_Localized: 'Foreigner: Rmevmgziv fm jfzoxsv grkl wr ormtfzttrl xlnfmv?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220902
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220903
    m_Localized: Come facciamo a comunicare?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220904
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220905
    m_Localized: 'Foreigner: Klhhl irkvgviv ov gfv kzilov, v gf kflr hkrvtziov z tvhgr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220906
    m_Localized: 'Foreigner: Ulihv xlhì irfhxriò z xzkrimv ro hvmhl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220907
    m_Localized: 'Foreigner: Come?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220908
    m_Localized: In che senso "come"?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220909
    m_Localized: Stai cercando di chiedere qualcosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220910
    m_Localized: 'Foreigner: Xlmgrmfl z mlm xzkriv, nz xivwl xsv gf zyyrz xsrvhgl jfzoxlhz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220911
    m_Localized: 'Foreigner: Ulihv viz fmz wlnzmwz...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220912
    m_Localized: 'Foreigner: Xlmgrmfl z mlm xzkriv, nz xivwl xsv gf zyyrz xsrvhgl jfzoxlhz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220913
    m_Localized: 'Foreigner: Ulihv viz fmz wlnzmwz...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220914
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220915
    m_Localized: Ehi, come ti senti?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220916
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414976
    m_Localized: 'Foreigner: (Gli tocchi la spalla, poi indichi le ferite vicino alla sua bocca)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414977
    m_Localized: Stai bene?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414978
    m_Localized: Fa male?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414979
    m_Localized: 'Foreigner: Klgivhgr irkvgviol?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414980
    m_Localized: 'Foreigner: Bhhh‑nhh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414981
    m_Localized: 'Foreigner: Bhhhe...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414982
    m_Localized: 'Foreigner: Bhhhene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414983
    m_Localized: 'Foreigner: Ylxxz? Ulihv irfhxriò z fhzioz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414984
    m_Localized: 'Foreigner: Xsrhhà hv zmxsv ro nrl kzvhv è rm jfvhgv xlmwrarlmr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414985
    m_Localized: 'Foreigner: È kzaavhxl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414986
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414987
    m_Localized: Come pensi di tornare a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414988
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414989
    m_Localized: 'Foreigner: (Unisci i palmi delle mani sopra la testa, imitando la forma di un tetto)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414990
    m_Localized: 'Foreigner: Xzhz? Nr hgzr xsrvwvmwl wvooz nrz xzhz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414991
    m_Localized: 'Foreigner: Vil evmfgl z gileziv fm znrxl, jfzmwl è hxlkkrzgl ro urmrnlmwl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414992
    m_Localized: 'Foreigner: Hrznl mvooz nviwz, mlm x''è zogil nlwl kvi wriol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414993
    m_Localized: Come faccio a rimandarti a casa? In aereo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414994
    m_Localized: Hai controllato se ci sono biglietti per le navi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414995
    m_Localized: 'Foreigner: (Allarghi entrambe le braccia per imitare le ali di un aereo)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414996
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414997
    m_Localized: 'Foreigner: Fm zvivl? Kvmhr xsv elorml zmxliz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414998
    m_Localized: 'Foreigner: Wleivr xvixziv wr hxlkiriol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414999
    m_Localized: 'Foreigner: Ulihv x''è zmxliz fm nlwl kvi glimziv z xzhz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415000
    m_Localized: 'Foreigner: (Muovi la mano a mimare una barca che dondola sulle onde)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415001
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415002
    m_Localized: 'Foreigner: Rmgvmwr... kzigriv xlm fmz mzev?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415003
    m_Localized: 'Foreigner: Hzokzml zmxliz? Wleiò xlmgilooziv, tizarv!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415004
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415005
    m_Localized: Perché sembri così felice?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415006
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415007
    m_Localized: 'Foreigner: (Sorridi e indichi il tuo sorriso con il dito, poi indichi lui)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415008
    m_Localized: 'Foreigner: Zs, sl xzkrgl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415009
    m_Localized: 'Foreigner: Sl hzkfgl xsv r givmr xrixlozml zmxliz! Mlm è fmz mlgrarz nvizertorlhz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415010
    m_Localized: 'Foreigner: (Fa scorrere una mano lungo l''altro braccio)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415011
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415012
    m_Localized: Qualcuno può darti un passaggio a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415013
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415014
    m_Localized: 'Foreigner: Mlm gr xzkrhxl, znrxl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415015
    m_Localized: 'Foreigner: Wlnzmr gliml z xzhz! L zonvml izttrfmtviò oz hgzarlmv.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415016
    m_Localized: 'Foreigner: Kzigriò hgzmlggv! Xrzl!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415017
    m_Localized: 'Foreigner: Chiaho!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415018
    m_Localized: Intendi il treno?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415019
    m_Localized: Stai andando da qualche parte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415020
    m_Localized: 'Foreigner: Nr wrhkrzxv, mlm sl xzkrgl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415021
    m_Localized: 'Foreigner: Nz wlnzmr zmwiò rm hgzarlmv v ol hxlkiriò wr kvihlmz!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415022
    m_Localized: 'Foreigner: Ulihv irfhxriò urmzonvmgv z glimziv z xzhz...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415023
    m_Localized: 'Foreigner: Bhuna fhrtna!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415024
    m_Localized: 'Edgar: Un sonetto silenzioso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415025
    m_Localized: Come sta la tua mano?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415026
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415027
    m_Localized: 'Edgar: Il tepore della vita sta svanendo. Resta solo un vacuo tormento, un brivido spettrale.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415028
    m_Localized: 'Edgar: Ma ciò, ahimè, era da attendersi. Desidero solo rimandare il momento supremo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415029
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415030
    m_Localized: 'Edgar: C''era una fanciulla che un tempo adoravo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415031
    m_Localized: 'Edgar: Sedevamo muti, anime affini. C''intendevamo senza parlare. Poi, d''un tratto, compresi tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415032
    m_Localized: 'Edgar: Mentivo a me stesso. Lei era solo un''estranea, un riflesso dei miei desideri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415033
    m_Localized: 'Edgar: Eppure sogno che un giorno sapremo amarci oltre ogni limite umano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415034
    m_Localized: 'Edgar: Un sonetto silenzioso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415035
    m_Localized: Parlami di quella ragazza.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415036
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415037
    m_Localized: 'Edgar: Nei suoi occhi brillava eterna la gelida, pallida luce lunare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415038
    m_Localized: 'Edgar: Rappresentava l''esatto opposto del Cataclisma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415039
    m_Localized: 'Edgar: Restandole accanto, avvertivo sempre una sorta di... confusione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415040
    m_Localized: 'Edgar: Ma bramavo di svelare ogni suo segreto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415041
    m_Localized: 'Edgar: Ora lei è il mio simulacro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415042
    m_Localized: 'Edgar: Il mio faro, per guidarmi quando me ne andrò.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415043
    m_Localized: 'Edgar: Un sonetto silenzioso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415044
    m_Localized: Come l'hai incontrata?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415045
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415046
    m_Localized: 'Edgar: Un giorno compresi il mio destino. La sepsi, spietata e inarrestabile, mi avrebbe presto reclamato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415047
    m_Localized: 'Edgar: Una paura glaciale mi travolse... Sarei svanito non tra anni, ma nel giro di pochi mesi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415048
    m_Localized: 'Edgar: E quando i Visitatori strisciarono fuori dalla terra, feci un incontro in una casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415049
    m_Localized: 'Edgar: Una ragazza avvolta di lino bianco, il viso d''una bellezza che toglieva il respiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415050
    m_Localized: 'Edgar: In un mondo così crudele, dove regnava l''egoismo, solo a me interessava quello splendido fiore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415051
    m_Localized: 'Edgar: Hai mai sentito la frase "Troppo bizzarro per vivere, troppo raro per morire"?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415052
    m_Localized: 'Edgar: Ella era così. Sollevai la sua esile figura e la condussi nel mio rifugio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415053
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415054
    m_Localized: 'Edgar: Quando giungerà la fine, potrò dire che ogni mia azione è stata compiuta con amore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415055
    m_Localized: 'Edgar: Un sonetto silenzioso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415056
    m_Localized: Dov'è ora quella ragazza?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415057
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415058
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415059
    m_Localized: 'Edgar: Trascorsi molto tempo nel tentativo di comprendere la sua bellezza. E la forza del suo silenzio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415060
    m_Localized: 'Edgar: Finché...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415061
    m_Localized: 'Edgar: Uomini senza volto, ammantati di giallo, irruppero nella nostra solitudine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415062
    m_Localized: 'Edgar: La ghermirono e la trascinarono via. Suppongo che sappiamo entrambi per quale motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415063
    m_Localized: 'Edgar: È un vero peccato... Non sono mai riuscito a capirla fino in fondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415064
    m_Localized: 'Edgar: Cercarla ora è come voler afferrare un miraggio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415065
    m_Localized: 'Edgar: Gli uomini invocano la salvezza del mondo, ma non sanno come ottenerla. Tuttavia, la risposta è semplice.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415066
    m_Localized: 'Edgar: Risiede nel silenzio. Nella bellezza. Se solo riuscissimo... a capire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415067
    m_Localized: 'Edgar: Lei provò a insegnarmelo, ma imparai solo la quiete. Un barlume di grazia nel mezzo dell''orrore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415068
    m_Localized: 'Edgar: Se non altro... ora sono pronto a seguirla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415069
    m_Localized: 'TaxiDriver: Non farti problemi, amico. Spara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415070
    m_Localized: Pensi ancora che la FEMA ti stia dando la caccia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415071
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415072
    m_Localized: 'TaxiDriver: Ehi, spero proprio di no!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415073
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415074
    m_Localized: 'TaxiDriver: Già, ho toppato alla grande andando da loro. Avrei dovuto capire che volevano incastrare anche me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415075
    m_Localized: 'TaxiDriver: Credevo volessero solo il cliente e che mi avrebbero lasciato stare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415076
    m_Localized: 'TaxiDriver: Invece si sono presi l''auto e quasi mi ammazzavano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415077
    m_Localized: 'TaxiDriver: Ma insomma, cos''altro avrei dovuto fare? Quel tipo era un Visitatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713957
    m_Localized: E se fosse stato umano?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713958
    m_Localized: Non avevi scelta.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713959
    m_Localized: 'TaxiDriver: Ehi, non dirlo nemmeno.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713960
    m_Localized: 'TaxiDriver: Senti, non è che sia orgoglioso di com''è andata, ok?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713961
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713962
    m_Localized: 'TaxiDriver: Beh, a conti fatti, hai ragione. Non c''erano altre opzioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713963
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713964
    m_Localized: 'TaxiDriver: Quanto mi mancano i giorni in cui ti sedevi al volante e non dovevi preoccuparti di nulla...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713965
    m_Localized: 'TaxiDriver: Ora, con questi Visitatori... Diamine, magari il prossimo cliente potrebbe piazzarmi una palla in fronte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713966
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415078
    m_Localized: 'TaxiDriver: Non farti problemi, amico. Spara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415079
    m_Localized: Da quanto tempo guidi il taxi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415080
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415081
    m_Localized: 'TaxiDriver: Beh, sono in ballo da un pezzo. Al giorno d''oggi non lavoro per nessuno, sto per conto mio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415082
    m_Localized: 'TaxiDriver: Non è che la FEMA lasci girare i civili in libertà...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415083
    m_Localized: 'TaxiDriver: Ma questo casino finirà prima o poi, no? E i soldi... Beh, quelli servono sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415084
    m_Localized: 'TaxiDriver: La gente sa che viaggiare è rischioso, quindi paga bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415085
    m_Localized: 'TaxiDriver: E guidare di notte mi fa tornare in mente quand''ero un ragazzino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415086
    m_Localized: 'TaxiDriver: Sono diventato un tassista per via di mio padre. Volevo seguire la sua stessa strada, diciamo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713967
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713968
    m_Localized: 'TaxiDriver: Ma non voglio finire come lui, senza un soldo e solo come un cane...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713969
    m_Localized: 'TaxiDriver: Spero solo che la fortuna non mi volti le spalle...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415087
    m_Localized: 'TaxiDriver: Non farti problemi, amico. Spara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415088
    m_Localized: Oggi sembri piuttosto triste.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415089
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415090
    m_Localized: 'TaxiDriver: Mah... È solo che...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415091
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415092
    m_Localized: 'TaxiDriver: Non mi va giù che la mia auto sia sparita, capisci?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713970
    m_Localized: Che auto avevi?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713971
    m_Localized: Cosa aveva di speciale?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713972
    m_Localized: 'TaxiDriver: Oh, era un modello classico, un gioiellino da collezione...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713973
    m_Localized: 'TaxiDriver: Tutta gialla, cerchi cromati, curve eleganti...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713974
    m_Localized: 'TaxiDriver: Ma ormai è andata...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713975
    m_Localized: 'TaxiDriver: Dannati bastardi della FEMA... Quell''auto era la mia vita!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713976
    m_Localized: 'TaxiDriver: Era di papà. Anche lui faceva il tassista.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713977
    m_Localized: 'TaxiDriver: Quando ero piccolo, riuscivo a dormire bene solo su un sedile, così lui di notte mi portava con sé. Poi, però...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713978
    m_Localized: 'TaxiDriver: Diciamo che gli andò male...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415096
    m_Localized: 'TaxiDriver: Non farti problemi, amico. Spara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415097
    m_Localized: Cos'è accaduto a tuo padre?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415098
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713979
    m_Localized: 'TaxiDriver: Non amo parlarne, ma... beh, mi sembri uno di cui ci si può fidare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713980
    m_Localized: 'TaxiDriver: Un giorno mia madre era partita per lavoro, così papà mi portò con lui sul taxi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713981
    m_Localized: 'TaxiDriver: Quella volta, caricammo un cliente che non dimenticherò mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713982
    m_Localized: 'TaxiDriver: Elegante, calvo e con un sorriso che sembrava quello del diavolo in persona...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713983
    m_Localized: 'TaxiDriver: In città lo conoscevano tutti, persino un moccioso come me. Rifiutargli una corsa... non sarebbe stato saggio.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713984
    m_Localized: 'TaxiDriver: Ma il mio vecchio era un uomo d''onore. E la sua decisione... fu la nostra rovina.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713985
    m_Localized: 'TaxiDriver: Quel diavolo in ghingheri non ce la fece passare liscia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713986
    m_Localized: 'TaxiDriver: Perdemmo la casa e non riuscimmo più a trovare una sistemazione stabile.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713987
    m_Localized: 'TaxiDriver: E visto che eravamo quasi sul lastrico, mio padre decise di tenersi l''auto per continuare a lavorare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713988
    m_Localized: 'TaxiDriver: Ma più avanti, quando si ritrovò sepolto dai debiti, iniziò a pentirsene amaramente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713989
    m_Localized: 'TaxiDriver: Diceva che era maledetta. Che ci aveva marchiati con la sfortuna.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713990
    m_Localized: 'TaxiDriver: Ma non l''ha mai capito.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713991
    m_Localized: 'TaxiDriver: Fu il suo orgoglio a costarci tutto, non l''auto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713992
    m_Localized: 'TaxiDriver: Per colpa sua ho dovuto spaccarmi la schiena fin da piccolo per mettere il pane in tavola. E sai una cosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713993
    m_Localized: 'TaxiDriver: Gli voglio ancora bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713994
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713995
    m_Localized: 'TaxiDriver: Mi manchi, papà...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713996
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713997
    m_Localized: 'TaxiDriver: Ascolta... Se non ti scoccia, potresti provare a... beh, a chiamarlo tu?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713998
    m_Localized: 'TaxiDriver: Questo è il suo numero: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713999
    m_Localized: 'TaxiDriver: Digli solo che sto bene. Lo farei io, ma... ora come ora preferisco non dare nell''occhio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415106
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415128
    m_Localized: 'Provocateur: Che razza di mondo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415129
    m_Localized: Che succede?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415130
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415131
    m_Localized: 'Provocateur: Non è evidente? Non abbiamo ancora stipulato un regolare contratto di affitto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415132
    m_Localized: E cosa dovrei fare?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415133
    m_Localized: Ti sembra importante, in questo momento?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415134
    m_Localized: 'Provocateur: Uhm, mi stai dicendo che non disponi neppure dei documenti richiesti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415135
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415136
    m_Localized: 'Provocateur: Allora ti suggerisco di trovare un notaio e recuperarli, d''accordo? Tsk, che sciatteria...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415137
    m_Localized: Mi prendi in giro? E dove lo trovo un notaio?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415138
    m_Localized: Perché non te ne occupi tu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415139
    m_Localized: 'Provocateur: Gradirei inoltre che usassi un tono più appropriato con il sottoscritto. "Signore" andrà bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415140
    m_Localized: 'Provocateur: Non c''è più educazione al giorno d''oggi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415141
    m_Localized: Come vuoi.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415142
    m_Localized: Ma vaffanculo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415143
    m_Localized: 'Provocateur: Saprai usare una mappa, voglio sperare. Non è complicato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415144
    m_Localized: 'Provocateur: E ripeto, pretendo di essere chiamato "signore" e con il dovuto rispetto, intesi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415145
    m_Localized: Come vuoi.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415146
    m_Localized: Ma vaffanculo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415147
    m_Localized: 'Provocateur: Perché mai, di grazia, dovrei farti da fattorino? E chiamami "signore" quando ti rivolgi a me!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415148
    m_Localized: 'Provocateur: Sono un rispettabile cittadino, non un garzone ai tuoi ordini.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415149
    m_Localized: Come vuoi.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415150
    m_Localized: Ma vaffanculo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415151
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415152
    m_Localized: 'Provocateur: Lo stai facendo apposta, vero? Potresti almeno fingere di voler collaborare? Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415153
    m_Localized: 'Provocateur: Bada a come parli. Secondo l''articolo 21 della Costituzione, la dignità della persona è tutelata dallo Stato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415154
    m_Localized: 'Provocateur: Ti consiglio di iniziare a comportarti come si conviene, prima che la situazione diventi... sgradevole.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415155
    m_Localized: 'Provocateur: Che razza di mondo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415156
    m_Localized: Non potresti lasciar perdere?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415157
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415158
    m_Localized: 'Provocateur: Assolutamente no. Sei legalmente obbligato a stipulare un contratto d''affitto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415159
    m_Localized: Non ho i documenti per concludere l'accordo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415160
    m_Localized: Non puoi dire sul serio...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415161
    m_Localized: 'Provocateur: Uhm... Non va affatto bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415162
    m_Localized: 'Provocateur: Temo che ciò costituisca una violazione dell''articolo 131.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415163
    m_Localized: Cominci seriamente a farmi incazzare.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415164
    m_Localized: Ma non ti stanchi mai di citare leggi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415165
    m_Localized: 'Provocateur: Per tua informazione, il contratto è obbligatorio in base all''articolo 131. Faccio solo il mio dovere di cittadino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415166
    m_Localized: Cominci seriamente a farmi incazzare.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415167
    m_Localized: Ma non ti stanchi mai di citare leggi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415168
    m_Localized: 'Provocateur: Ma bene, ora inizi anche con gli insulti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415169
    m_Localized: 'Provocateur: Che, per inciso, rientrano nel codice amministrativo, articolo 5.61.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415170
    m_Localized: 'Provocateur: Quindi prego, continua pure. Tanto prima o poi sconterai ogni singola ingiuria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415171
    m_Localized: 'Provocateur: E no, non sono affatto stanco di fare riferimento alla legge... o alla Costituzione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415172
    m_Localized: 'Provocateur: Conosco i miei diritti! Solo perché TU hai scelto l''ignoranza, non significa che gli altri debbano fare lo stesso!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415173
    m_Localized: 'Provocateur: E quante volte dovrò ancora ripetere che sei tenuto a rivolgerti a me in maniera appropriata?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415174
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415175
    m_Localized: 'Provocateur: Tsk, santo cielo, non impari mai?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415176
    m_Localized: 'Provocateur: Che razza di mondo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415177
    m_Localized: Che succede?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415178
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415179
    m_Localized: 'Provocateur: Mi è parso di notare un''arma da fuoco. Ti dispiacerebbe mostrarmi la licenza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415180
    m_Localized: Non sono affari tuoi.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415181
    m_Localized: Che problemi hai con me?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415182
    m_Localized: 'Provocateur: Ah, capisco... Non ce l''hai, vero? D''altronde, è l''unica conclusione logica, data la tua reazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415183
    m_Localized: 'Provocateur: Credi che avere un''arma ti autorizzi a dettare legge?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415184
    m_Localized: 'Provocateur: Pensi di poter interrogare tutti, mentre tu ti consideri al di sopra di ogni sospetto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415185
    m_Localized: 'Provocateur: Beh, ti sbagli di grosso!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415186
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415187
    m_Localized: 'Provocateur: Ma sai come si dice, no? C''è sempre un pesce più grosso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415188
    m_Localized: Piantala! Non rendermi la vita ancora più difficile.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415189
    m_Localized: Vuoi farla finita con queste stronzate?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415190
    m_Localized: 'Provocateur: Sto solo cercando di capire con chi ho a che fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415191
    m_Localized: 'Provocateur: Ti sei messo sulla difensiva... Quindi ho colto nel segno. Niente licenza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415192
    m_Localized: 'Provocateur: Le leggi valgono per tutti, tranne che per te?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415193
    m_Localized: 'Provocateur: Credi di poter interrogare chiunque, ma guai se qualcuno prova a metterti in discussione!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415194
    m_Localized: 'Provocateur: Beh, ti stai sbagliando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415195
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415196
    m_Localized: 'Provocateur: Ma sai come si dice, no? C''è sempre un pesce più grosso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415197
    m_Localized: Piantala! Non rendermi la vita ancora più difficile.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415198
    m_Localized: Vuoi farla finita con queste stronzate?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415199
    m_Localized: 'Provocateur: Oh, poverino. Nessuno osa contraddirti o verificare se sei un Visitatore. Chissà che fatica vivere così...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415200
    m_Localized: 'Provocateur: Chi ti ha dato il diritto di decidere chi vive e chi muore, eh? Da dove origina la tua autorità?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415201
    m_Localized: 'Provocateur: Passiamo il tempo a sperare che tu non ci uccida! E dovrei dispiacermi per te? Non essere ridicolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415202
    m_Localized: 'Provocateur: Volendo usare il tuo linguaggio... Non sei tu che ogni giorno ci propini "stronzate" con quei test?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415203
    m_Localized: 'Provocateur: Frughi nelle nostre vite e ci tratti come potenziali killer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415204
    m_Localized: 'Provocateur: Ma il vero assassino continua a farla franca. Perché in fondo i Visitatori potrebbero non esistere affatto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415205
    m_Localized: 'Provocateur: E in tal caso, sai cosa saresti tu? Uno psicopatico che sfrutta il caos per soddisfare la propria brama di sangue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415206
    m_Localized: 'Provocateur: Approfitti del terrore della gente, che ascolta gli allarmi alla radio e poi corre qui per cercare rifugio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415207
    m_Localized: 'Provocateur: Dimmi, quanti di quelli che sono con te dall''inizio di questa storia sono ancora vivi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415208
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415209
    m_Localized: 'Provocateur: Già, come sospettavo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415210
    m_Localized: 'Provocateur: Che razza di mondo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415211
    m_Localized: Signore? È ancora qui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415212
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415213
    m_Localized: 'Provocateur: Finalmente! Mi hai parlato come si deve.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415214
    m_Localized: 'Provocateur: Peccato che sia troppo tardi. Ho intenzione di sporgere denuncia molto presto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415215
    m_Localized: Denunciare cosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415216
    m_Localized: A chi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415217
    m_Localized: 'Provocateur: Non mi incanti più. So esattamente chi sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415218
    m_Localized: 'Provocateur: Questa non è casa tua. Hai ucciso il proprietario per rubargli l''identità! Contatterò la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415219
    m_Localized: 'Provocateur: Sì, hai sentito bene. Stanno venendo per te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415220
    m_Localized: Cazzate.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415221
    m_Localized: È ora di chiuderti la bocca una volta per tutte.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415222
    m_Localized: 'Provocateur: L''agenzia federale per la gestione delle emergenze. FEMA, in breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415223
    m_Localized: 'Provocateur: All''inizio, ho cercato di non dare peso alla tua incapacità di stipulare un banale contratto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415224
    m_Localized: 'Provocateur: Ma più ti stavo ad ascoltare, più il quadro si faceva chiaro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415225
    m_Localized: 'Provocateur: E ormai non ho più dubbi. Questa non è casa tua, sei solo un impostore!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415226
    m_Localized: 'Provocateur: Un VISITATORE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415227
    m_Localized: 'Provocateur: Quindi preparati, stasera verranno a prenderti!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415228
    m_Localized: Cazzate.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415229
    m_Localized: È ora di chiuderti la bocca una volta per tutte.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415230
    m_Localized: 'Provocateur: Oh, ti denuncerò, stanne certo. Dirò tutto... e non avrai scampo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415231
    m_Localized: Sì, come no. Togliti dai piedi.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415232
    m_Localized: Sei morto (prendi il fucile).
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415233
    m_Localized: 'Provocateur: Credi di riuscire a zittirmi? Provaci!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415234
    m_Localized: 'Provocateur: Fermo! Ma che fai? Sei impazzito? Finirai in prigione per questo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415235
    m_Localized: 'Provocateur: No, no, no! Non credere di passarla liscia!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609280
    m_Localized: 'Provocateur: Non mi muoverò da qui finché non arriverà la FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609281
    m_Localized: 'Provocateur: Racconterò loro tutte le tue malefatte e che razza di criminale sei!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609282
    m_Localized: 'Provocateur: Fermo! Ma che fai? Sei impazzito? Finirai in prigione per questo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609283
    m_Localized: 'Provocateur: Non OSARE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609284
    m_Localized: Vattene o ti sparo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609285
    m_Localized: Se non sparisci all'istante, ti ammazzo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609286
    m_Localized: Non mi lasci altra scelta.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609287
    m_Localized: (Spara)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609288
    m_Localized: 'Provocateur: Non permetterò che tu sfugga alla FEMA. Dovrai passare sul mio corpo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609289
    m_Localized: 'Provocateur: Ti prenderanno, stanne certo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609290
    m_Localized: 'Provocateur: E neanche tu a me!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609291
    m_Localized: 'Provocateur: Sei un VISITATORE! UN ASSASSINO! UN MOSTRO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609292
    m_Localized: 'Provocateur: NO! STAI COMMETTENDO UN REATO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609293
    m_Localized: 'Provocateur: AAAAAARGH!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609294
    m_Localized: 'Marauder: Un bel bottino... Non mi serve altro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609295
    m_Localized: Come procede il saccheggio?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609296
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609297
    m_Localized: 'Marauder: Ehi, pensavo che questo posto fosse abbandonato, per questo mi sono intrufolato. Non sapevo ci vivesse qualcuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609298
    m_Localized: 'Marauder: Non rubo ai vivi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609299
    m_Localized: 'Marauder: Ha senso, no? Pensaci, che se ne fa un morto di un cappotto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609300
    m_Localized: 'Marauder: Lui è andato, non usa più quella roba. A me invece potrebbe salvare la vita. O quella dei miei cari.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609301
    m_Localized: 'Marauder: Non dirmi che lasceresti morire qualcuno che ami per non derubare un cadavere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609302
    m_Localized: 'Marauder: Sarebbe ora di finirla con questo finto rispetto per i morti. Almeno, io la penso così.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609303
    m_Localized: 'Marauder: Un bel bottino... Non mi serve altro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609304
    m_Localized: Perché sei diventato un saccheggiatore?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609305
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609306
    m_Localized: 'Marauder: E che altro avrei dovuto fare? Iniziare ad ammazzare povera gente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609307
    m_Localized: 'Marauder: No, ho scelto un approccio pacifico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609308
    m_Localized: 'Marauder: I morti non reagiscono. I loro averi sono semplicemente... risorse a disposizione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609309
    m_Localized: 'Marauder: Non voglio far del male a nessuno, cerco solo di sopravvivere. E quando posso, aiutare gli altri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609310
    m_Localized: 'Marauder: Un bel bottino... Non mi serve altro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609311
    m_Localized: Cos'hai trovato mentre frugavi in giro?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609312
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609313
    m_Localized: 'Marauder: Ah, quante ne ho viste, amico. Non hai idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609314
    m_Localized: 'Marauder: Per esempio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609315
    m_Localized: 'Marauder: Una volta ho trovato una biblioteca abbandonata, piena di libri impolverati che ormai non leggerà più nessuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609316
    m_Localized: 'Marauder: Ah, poi ho visitato la mostra di un artista esordiente. I suoi dipinti erano ancora appesi alle pareti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609317
    m_Localized: 'Marauder: E un''altra volta ho visto un tramonto da mozzare il fiato. Sembrava dipinto direttamente nel cielo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609318
    m_Localized: 'Marauder: Oggi nessuno sarebbe così stupido da mettersi a guardare il cielo. Ma all''epoca...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609319
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609320
    m_Localized: 'Marauder: Mi mancano quei tempi. Svegliarsi all''alba tra le strade deserte, con la nebbiolina e l''erba ancora umida...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609321
    m_Localized: 'Marauder: E il sole... come splendeva. Come se ti stesse promettendo che sarebbe andato tutto bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609322
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609323
    m_Localized: 'Marauder: Oggi, invece, è diventato nostro nemico. Come è potuto accadere?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609324
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609325
    m_Localized: 'Marauder: Quanto vorrei che qualcuno me lo spiegasse. Renderebbe questo schifo più sopportabile, magari...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609326
    m_Localized: 'Marauder: Un bel bottino... Non mi serve altro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609327
    m_Localized: Hai smesso di saccheggiare?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609328
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609329
    m_Localized: 'Marauder: No, lo faccio ancora. Però...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609330
    m_Localized: 'Marauder: C''è stata quella volta... che mi ha fatto riflettere parecchio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609331
    m_Localized: 'Marauder: Mi trovavo in una casa deserta. Il cadavere di un tizio era steso a terra, niente che non avessi già visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609332
    m_Localized: 'Marauder: La sua schiena era crivellata di colpi... ed era sdraiato su qualcosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609333
    m_Localized: 'Marauder: Forse aveva provato a nascondere i suoi averi. Così mi avvicino e lo sposto di lato...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609334
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609335
    m_Localized: 'Marauder: Sai cosa? Te lo dirò un''altra volta. Non sono ancora pronto a rivivere quella scena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609336
    m_Localized: 'Marauder: Un bel bottino... Non mi serve altro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609337
    m_Localized: Che c'era sotto il cadavere?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609338
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609339
    m_Localized: 'Marauder: Beh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609340
    m_Localized: 'Marauder: Volto quel tizio, e la vedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609341
    m_Localized: 'Marauder: Una bambina. Morta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609342
    m_Localized: 'Marauder: Sai, un conto sono gli adulti. Ma un bambino... è diverso. Non riesci a fartene una ragione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609343
    m_Localized: 'Marauder: Vedere bambini morti... mi gela il sangue. Ogni volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609344
    m_Localized: 'Marauder: Teneva stretto qualcosa al petto. Un gattino di pezza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609345
    m_Localized: 'Marauder: C''era così tanto sangue...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609346
    m_Localized: 'Marauder: La sua espressione... era quella di chi sa che ormai non c''è più scampo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609347
    m_Localized: 'Marauder: E per un attimo, giuro, mi è sembrata spaventata che le portassi via il giocattolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609348
    m_Localized: 'Marauder: Come se la crudeltà degli uomini non volesse darle tregua, neanche da morta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609349
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609350
    m_Localized: 'Marauder: Sono rimasto sconvolto. Molto più di quanto immaginassi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609351
    m_Localized: 'Marauder: Quel giorno avrei voluto smettere, lasciare i morti in pace... ma sapevo che era troppo tardi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609352
    m_Localized: 'Marauder: Non posso far altro che continuare a rovistare. È l''unico modo che conosco per sopravvivere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609353
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609354
    m_Localized: 'Marauder: Dicono che dal destino non si può fuggire. A quanto pare, è vero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609355
    m_Localized: 'GraveDigger: Vorrei che quei Visitatori tornassero sottoterra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609356
    m_Localized: Perché hai deciso di fare il becchino?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609357
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609358
    m_Localized: 'GraveDigger: Eh? Questo lavoro, dici? Mah, non so...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609359
    m_Localized: 'GraveDigger: Il cimitero è come... una biblioteca, solo che i suoi libri non si possono leggere. Giacciono silenziosi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609360
    m_Localized: 'GraveDigger: Un tempo conoscevo ogni tomba. Chi la occupava, la posizione delle mani, gli abiti, i nomi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609361
    m_Localized: 'GraveDigger: Poi un giorno stavo scavando una fossa, hai presente? Come al solito. La profondità era quella giusta, ma... era vuota.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609362
    m_Localized: 'GraveDigger: Vuota, capisci? Eppure sulle carte c''era scritto che avrei dovuto trovarci un corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609363
    m_Localized: 'GraveDigger: Un tizio, morto stecchito. Con i baffi. Invece era sparito come la rugiada al mattino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609364
    m_Localized: 'GraveDigger: Se un morto sparisce, non è come morire di nuovo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609365
    m_Localized: 'GraveDigger: Vorrei che quei Visitatori tornassero sottoterra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609366
    m_Localized: Cosa hai fatto quando hai trovato la tomba vuota?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609367
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609368
    m_Localized: 'GraveDigger: Mi sono seduto sul bordo e ho guardato di nuovo. Niente. Poi, in lontananza, ho notato... qualcuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609369
    m_Localized: 'GraveDigger: Non aveva gli occhi, ma i suoi denti erano così bianchi che brillavano. Se ne stava lì, immobile. E sorrideva.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609370
    m_Localized: 'GraveDigger: Quasi me la facevo addosso, dico sul serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609371
    m_Localized: 'GraveDigger: Sono scappato via. Quando serve, sono un fulmine! Ma non mi ha seguito. PUF! È svanito come fumo nell''aria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609372
    m_Localized: 'GraveDigger: Roba da brividi... È stato allora che è iniziata questa storiaccia dei Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609373
    m_Localized: 'GraveDigger: Vorrei che quei Visitatori tornassero sottoterra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609374
    m_Localized: Perché continui a scavare, se ormai nessuno seppellisce più i morti?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609375
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609376
    m_Localized: 'GraveDigger: In realtà, più che scavare, osservo. Dopo quel fatto, ho iniziato a controllare le fosse nuove.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609377
    m_Localized: 'GraveDigger: Con molta attenzione, eh! Occhi aperti!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609378
    m_Localized: 'GraveDigger: Magari avevano interrato uno di quei mostri per sbaglio, quindi ero pronto a colpire con il badile al primo movimento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609379
    m_Localized: 'GraveDigger: Invece no. Ossa al loro posto, cadaveri immobili... Nulla che provasse a strisciare fuori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609380
    m_Localized: 'GraveDigger: Allora ho pensato... forse i Visitatori non tornano dalla morte. Forse non sono mai stati sepolti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609381
    m_Localized: 'GraveDigger: Vorrei che quei Visitatori tornassero sottoterra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609382
    m_Localized: Continui a scoperchiare le tombe nuove?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609383
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609384
    m_Localized: 'GraveDigger: Io? Nemmeno per sogno! Non sono scemo. Senti... ho passato tutta la vita in mezzo ai morti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609385
    m_Localized: 'GraveDigger: Una volta era semplice. Morivi e ti seppellivano, fine. Oggi, invece... chi è rimasto a scavarti la fossa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609386
    m_Localized: 'GraveDigger: E pure se ti interrano, come sai che ci rimani? Ho visto una tomba che sono sicuro di aver riempito... ed era vuota.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609387
    m_Localized: 'GraveDigger: Eppure ci ho sepolto un corpo con queste mani!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609388
    m_Localized: 'GraveDigger: E ora penso... che anche la mia tomba potrebbe restare vacante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609389
    m_Localized: 'GraveDigger: Forse... sono già uno di quei Visitatori...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609390
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609391
    m_Localized: 'GraveDigger: Eh, non farci caso... Sono solo un mucchio di fesserie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609392
    m_Localized: 'GraveDigger: Vorrei che quei Visitatori tornassero sottoterra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609393
    m_Localized: Secondo te da dove vengono questi Visitatori?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609394
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609395
    m_Localized: 'GraveDigger: Hai mai notato come sembrino familiari? Non come in una foto... ma come il ricordo che tu hai di una persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609396
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609397
    m_Localized: 'GraveDigger: Ho una teoria. Sei sicuro di volerla sentire? E va bene...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609398
    m_Localized: 'GraveDigger: Forse i Visitatori... non sono i morti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609399
    m_Localized: 'GraveDigger: Sono solo pensieri rimasti insepolti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609400
    m_Localized: 'GraveDigger: Segreti e colpe che ci portiamo dentro. Si accumulano... e quando c''è troppo silenzio, iniziano ad apparire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609401
    m_Localized: 'GraveDigger: Non cercano carne, ma attenzione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609402
    m_Localized: 'GraveDigger: Più ti spaventi, più si avvicinano. Perché li ricordi. E tutto ciò che viene ricordato... ha fame di vita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609403
    m_Localized: 'FormerFema: Spero di non aver preso troppo sole...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609404
    m_Localized: Sei sicuro di non essere della FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609405
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609406
    m_Localized: 'FormerFema: Non sto con loro, davvero. Te l''ho detto, riparavo frigoriferi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609407
    m_Localized: 'FormerFema: Ho trovato l''uniforme in un''auto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609408
    m_Localized: Prima hai detto di averla presa da un cadavere.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609409
    m_Localized: Non mi stai mentendo, vero?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609410
    m_Localized: 'FormerFema: Ah, ehm... giusto!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609411
    m_Localized: 'FormerFema: L''ho trovata in un''auto... addosso a un tizio morto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609412
    m_Localized: 'FormerFema: Pensavo mi avrebbe protetto dai Visitatori. Voglio dire, quelli della FEMA la portano per un motivo, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609413
    m_Localized: 'FormerFema: Non dico bugie. È che mi sono confuso... Sai, lo stress. Può capitare, non credi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609414
    m_Localized: 'FormerFema: Devi credermi. Se avessi visto quello che ho visto io... lo capiresti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609415
    m_Localized: 'FormerFema: Per esempio, mentre venivo qui ho visto dei cadaveri che continuavano a contorcersi! Ho rischiato un infarto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609416
    m_Localized: 'FormerFema: Spero di non aver preso troppo sole...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609417
    m_Localized: Non credi che indossare una tuta della FEMA sia pericoloso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609418
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609419
    m_Localized: 'FormerFema: Cosa? Beh, no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609420
    m_Localized: 'FormerFema: Certo, a qualcuno la FEMA non va a genio, ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609421
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609422
    m_Localized: 'FormerFema: Ah, pensi che potrei finire nei guai se fingo di essere uno di loro, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609423
    m_Localized: 'FormerFema: Senti, io... credo che se gli spiegassi tutto, mi crederebbero. Capirebbero perché l''ho fatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609424
    m_Localized: 'FormerFema: Su, non c''è alcun motivo di temerli! Non sono una società segreta o che ne so...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609425
    m_Localized: 'FormerFema: Spero di non aver preso troppo sole...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609426
    m_Localized: Fammi vedere cos'hai in tasca.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609427
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609428
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609429
    m_Localized: 'FormerFema: Ehi! P‑Perché vuoi perquisirmi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609430
    m_Localized: Cerco il tuo tesserino della FEMA.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609431
    m_Localized: Perché no? Nascondi qualcosa, per caso?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609432
    m_Localized: 'FormerFema: Cosa? Che tesserino?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609433
    m_Localized: 'FormerFema: Non ho niente, lo giuro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609434
    m_Localized: Devo chiedertelo con le cattive? Svuota le tasche.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609435
    m_Localized: (Impugni il fucile)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609436
    m_Localized: 'FormerFema: Chi? Io?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609437
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609438
    m_Localized: 'FormerFema: No.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609439
    m_Localized: Devo chiedertelo con le cattive? Svuota le tasche.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609440
    m_Localized: (Impugni il fucile)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609441
    m_Localized: 'FormerFema: Va bene, calma. Non c''è bisogno di minacciare...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609442
    m_Localized: 'FormerFema: Ecco... Soddisfatto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609443
    m_Localized: 'FormerFema: Ok, mi hai beccato. Faccio parte della FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609444
    m_Localized: 'FormerFema: Ma ti prego, non dirlo agli altri!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609445
    m_Localized: 'FormerFema: Oh, merda...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609446
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609447
    m_Localized: 'FormerFema: Ecco... Non sparare, ok?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609448
    m_Localized: 'FormerFema: È vero. Lavoro per la FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609449
    m_Localized: 'FormerFema: Ma è meglio che questa cosa resti tra noi...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491072
    m_Localized: Perché hai nascosto di essere della FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491073
    m_Localized: A che serviva questa messinscena?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491074
    m_Localized: 'FormerFema: Non ci arrivi da solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491075
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491076
    m_Localized: 'FormerFema: Cioè, me lo stai chiedendo sul serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491077
    m_Localized: 'FormerFema: Se si venisse a sapere che lavoravo per la FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491078
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491079
    m_Localized: 'FormerFema: Senti, ho chiuso con la FEMA. Diciamo che... li ho mollati.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491080
    m_Localized: 'FormerFema: Senti, ho chiuso con la FEMA. Diciamo che... li ho mollati.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491081
    m_Localized: 'FormerFema: Già, ho fatto cose di cui... non vado fiero.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491082
    m_Localized: 'FormerFema: Rastrellare la gente, spedirla nelle zone di quarantena...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491083
    m_Localized: 'FormerFema: Ma era il mio lavoro, capisci? Stavo solo eseguendo gli ordini.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491084
    m_Localized: 'FormerFema: È inutile che mi accusi per ciò che è successo. Decidevano tutto ai piani alti, io ero solo una pedina.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491085
    m_Localized: 'FormerFema: E chiamarmi assassino, o come ti pare... è semplicemente ingiusto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491086
    m_Localized: 'FormerFema: Pensi davvero che io sia un mostro? Ho salvato vite mandando dei killer in quarantena!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609450
    m_Localized: 'FormerFema: Spero di non aver preso troppo sole...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609451
    m_Localized: Perché hai nascosto di essere della FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609452
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491087
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491088
    m_Localized: 'FormerFema: Una volta prelevai un tizio che mostrava i segni dei Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491089
    m_Localized: 'FormerFema: Per farla breve, mentre era nella zona di quarantena, peggiorò e morì. Capita.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491090
    m_Localized: 'FormerFema: Sua moglie venne a chiederci quando l''avremmo rilasciato. Le rispondemmo che non c''era più nessuno da far uscire.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491091
    m_Localized: 'FormerFema: Era fuori di sé. Iniziò a urlare che eravamo degli assassini e che dovevamo ridarle il corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491092
    m_Localized: 'FormerFema: Le dicemmo che era vietato dal protocollo, ma lei non si arrese.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491093
    m_Localized: 'FormerFema: Iniziò a dormire per terra, proprio fuori dal cancello.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491094
    m_Localized: 'FormerFema: Alla fine, le restituimmo il corpo. E per questo ci licenziarono in tronco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491095
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491096
    m_Localized: 'FormerFema: Voleva quel dannato cadavere a tutti i costi. Quella pazza psicotica mi è costata il posto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491097
    m_Localized: 'FormerFema: Ora non ho più dove andare...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491098
    m_Localized: 'FormerFema: E senti questa: invece di seppellire suo marito, se lo trascina dietro ovunque vada!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491099
    m_Localized: 'FormerFema: Valeva la pena di perdere il lavoro per quella pazza, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491100
    m_Localized: Voi della FEMA siete dei veri bastardi.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491101
    m_Localized: Che sfortuna.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491102
    m_Localized: 'FormerFema: Che cosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491103
    m_Localized: 'FormerFema: Stavo facendo il mio dovere, ma mi sbattono fuori per colpa di una svitata...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491104
    m_Localized: 'FormerFema: E sarei io il bastardo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491105
    m_Localized: 'FormerFema: Sai che ti dico? Vaffanculo. Io me ne vado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491106
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491107
    m_Localized: 'FormerFema: Cristo, è rimasto qualcuno sano di mente?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491108
    m_Localized: 'FormerFema: Già, è andata proprio così.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491109
    m_Localized: 'FormerFema: Tra il sole rovente e gli infetti, la gente ha perso completamente la testa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491110
    m_Localized: 'FormerFema: Quel dannato pezzo di carne valeva davvero il nostro lavoro?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491111
    m_Localized: Almeno è tornata insieme a suo marito.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491112
    m_Localized: Non avreste dovuto consegnarle il cadavere.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491113
    m_Localized: 'FormerFema: Quindi secondo te è giusto che abbiamo perso il posto?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491114
    m_Localized: 'FormerFema: Voi civili non capite un accidente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491115
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491116
    m_Localized: 'FormerFema: Dovevamo spararle, come abbiamo fatto con il marito.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491117
    m_Localized: Che hai detto?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491118
    m_Localized: (Impugni il fucile)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491119
    m_Localized: 'FormerFema: Perché mi guardi così?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491120
    m_Localized: 'FormerFema: Da regolamento, se un civile infetto è in gravi condizioni...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491121
    m_Localized: 'FormerFema: Bisogna eliminarlo subito, per evitare si tramuti in un Visitatore e semini il panico nella zona di quarantena.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491122
    m_Localized: Lascialo andare
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491123
    m_Localized: (Impugni il fucile)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491124
    m_Localized: 'FormerFema: Grazie per aver capito.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491125
    m_Localized: 'FormerFema: Non sono un assassino, stavo solo eseguendo gli ordini.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491126
    m_Localized: 'FormerFema: Ehi, che diavolo stai facendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491127
    m_Localized: 'FormerFema: Calmati, era un Visitatore! Ed era messo male! Non potevamo certo lasciarlo andare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491128
    m_Localized: 'FormerFema: Non sparare! Facevo solo il mio lavoro!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491129
    m_Localized: 'FormerFema: Già, lo penso anch''io. Avremmo dovuto seguire il regolamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491130
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491131
    m_Localized: 'FormerFema: Va bene, non ti annoierò con il resto. Grazie per avermi fatto entrare, anche se sai che ero nella FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491132
    m_Localized: 'FormerFema: Se riavrò il mio lavoro, farò presente che hai cooperato con un agente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609476
    m_Localized: 'Intruder: I Visitatori... sognano?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609477
    m_Localized: Sei riuscito a dormire?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609478
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609479
    m_Localized: 'Intruder: Uhm? Non ci ho nemmeno provato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609480
    m_Localized: 'Intruder: Spero solo che ci sia ancora qualcuno in grado di sognare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609481
    m_Localized: 'Intruder: Ma... nessuno ha ancora voluto raccontarmi i suoi sogni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609482
    m_Localized: 'Intruder: Forse non ispiro molta fiducia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609483
    m_Localized: 'Intruder: Magari col tempo inizieranno a fidarsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609484
    m_Localized: 'Intruder: I Visitatori... sognano?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609485
    m_Localized: Perché sei ossessionato dai sogni?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609486
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609487
    m_Localized: 'Intruder: Chi ti dice che io sia ossessionato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609488
    m_Localized: 'Intruder: Un''illazione piuttosto audace, non trovi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609489
    m_Localized: 'Intruder: Non sei curioso di sapere ciò che il nostro subconscio prova a comunicarci?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609490
    m_Localized: 'Intruder: Cosa si nasconde nelle nostre menti? Tutti custodiamo memorie che non vogliamo affrontare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609491
    m_Localized: 'Intruder: Tu, per esempio. Ti tieni alla larga dalle persone perché qualcuno ti ha ferito?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609492
    m_Localized: 'Intruder: Vedi? Per questo lo trovo appassionante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609493
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609494
    m_Localized: 'Intruder: Voglio raccontarti l''ultimo sogno che ho fatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609495
    m_Localized: 'Intruder: Ero inseguito da un gigantesco treno nero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609496
    m_Localized: 'Intruder: Le mie gambe non si muovevano, erano bloccate. Ho urlato e mi sono svegliato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609497
    m_Localized: 'Intruder: Ma quel treno ero io a guidarlo. Stavo per investire me stesso, incapace di fermarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609498
    m_Localized: 'Intruder: I Visitatori... sognano?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609499
    m_Localized: E tu? Cosa nascondi nei tuoi sogni?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609500
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609501
    m_Localized: 'Intruder: Io?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609502
    m_Localized: 'Intruder: Non dormo da giorni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609503
    m_Localized: 'Intruder: Ma va bene, ti svelerò un piccolo segreto. Tanto non ci crederebbe nessuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609504
    m_Localized: 'Intruder: Io posso VEDERE i sogni degli altri. È... a dir poco affascinante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609505
    m_Localized: 'Intruder: Non so perché ho questo dono.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609506
    m_Localized: 'Intruder: Ma da quando è iniziata questa storia... non percepisco più nulla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609507
    m_Localized: 'Intruder: È come se l''intero mondo tenesse il fiato sospeso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609508
    m_Localized: 'Intruder: E non riesco nemmeno più a dormire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609509
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609510
    m_Localized: 'Intruder: Ora rifletti... Sto dicendo la verità, o voglio solo prenderti in giro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609511
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609512
    m_Localized: Chi siete?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609513
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609514
    m_Localized: 'Cultist1: Anime smarrite. Come la moltitudine infinita che vaga su questo mondo devastato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609515
    m_Localized: 'Cultist1: Bramiamo la pace... L''eterno riposo. E abbiamo trovato la via che conduce a Lei...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609516
    m_Localized: 'Cultist1: La Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609517
    m_Localized: 'Cultist1: Perché la temiamo? È l''ignoto a spaventarci, o la paura del castigo che le religioni ci hanno inflitto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609518
    m_Localized: 'Cultist1: Abbiamo cercato il senso della vita per millenni. Tuttavia, la risposta era davanti ai nostri occhi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609519
    m_Localized: 'Cultist1: Il nostro scopo è la Morte. E noi siamo i Suoi seguaci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609520
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609521
    m_Localized: Perché veneri la morte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609522
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609523
    m_Localized: 'Cultist1: Perché la Morte non è altro che misericordia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609524
    m_Localized: 'Cultist1: Tutti la temiamo... ma siamo certi che ce ne sia motivo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609525
    m_Localized: 'Cultist1: In fondo, il nostro mondo è solo un purgatorio che ci infligge sofferenza. Ma perché?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609526
    m_Localized: 'Cultist1: Dopo tanto dolore... non abbiamo forse diritto alla pace?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609527
    m_Localized: 'Cultist1: La Morte è un paradiso che sfugge alla nostra comprensione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609528
    m_Localized: 'Cultist1: Le religioni offrono una visione parziale dell''aldilà per consolare le masse. Ma la vita è davvero così semplice?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609529
    m_Localized: 'Cultist1: Vale lo stesso per la Morte. Non puoi sperare di comprenderla finché non avrai sentito il Suo tocco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609530
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609531
    m_Localized: Perché avete scelto proprio casa mia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609532
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609533
    m_Localized: 'Cultist1: La tua dimora è legata alla Morte come nessun''altra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609534
    m_Localized: 'Cultist1: Dapprima dubitavo della scelta del maestro riguardo a questo luogo. Ma ora, tutto è chiaro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609535
    m_Localized: 'Cultist1: La Morte aleggia tra queste mura. Intangibile, eppure così soffocante da opprimere l''anima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609536
    m_Localized: 'Cultist1: Il cemento spoglio emana l''olezzo del sangue versato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609537
    m_Localized: 'Cultist1: Non siamo venuti per chiederti di commettere omicidi. Se il sangue scorre, è per tua volontà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609538
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609539
    m_Localized: 'Cultist1: Sono convinto che il tuo vincolo con la Morte sia più profondo del nostro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609540
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609541
    m_Localized: A che servono quei roghi che state preparando fuori?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609542
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609543
    m_Localized: 'Cultist1: La nostra ora sta arrivando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609544
    m_Localized: 'Cultist1: Gli angeli dell''abisso riceveranno le nostre ceneri come tributo per accedere al dominio della Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609545
    m_Localized: 'Cultist1: Solo così otterremo la sua grazia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609546
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609547
    m_Localized: Sembri turbato. Hai paura?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609548
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609549
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609550
    m_Localized: 'Cultist2: Hai visto bene, padrone di casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609551
    m_Localized: 'Cultist2: A differenza dei miei confratelli... sto vacillando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609552
    m_Localized: 'Cultist2: Sono dilaniato dai dubbi. Cosa c''è oltre la vita? Cosa si prova?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609553
    m_Localized: 'Cultist2: Il maestro dice che non ci attende né il paradiso né l''inferno, ma qualcosa di diverso. Io lo trovo... inconcepibile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609554
    m_Localized: 'Cultist2: Se persino lui non comprende appieno la Morte, come potremo mai riuscirci noi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609555
    m_Localized: 'Cultist2: E se raggiungerla non fosse abbastanza? Se la sua natura fosse inafferrabile per la mente umana?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609556
    m_Localized: 'Cultist2: Ma non ho il coraggio di contestare il maestro. Nei suoi occhi brilla la comprensione, mentre io brancolo nel buio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609557
    m_Localized: 'Cultist2: Lui ci esorta a rafforzare la nostra fede e determinazione. Per essere pronti a ciò che accadrà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609558
    m_Localized: 'Cultist2: Soltanto così varcheremo i fiumi di cadaveri e le montagne d''ossa per arrivare a Lei...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609559
    m_Localized: 'Cultist2: La Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609560
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609561
    m_Localized: Perché veneri la morte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609562
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609563
    m_Localized: 'Cultist2: Per favore, gentile padrone di casa, rivolgiti alla Morte con il dovuto rispetto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609564
    m_Localized: 'Cultist2: Lei non tollera i sacrileghi che la definiscono ingiusta, e li punisce con i tormenti più crudeli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609565
    m_Localized: 'Cultist2: La sua indole mi terrorizza, sebbene il maestro insegni che è la più benevola tra le divinità.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803584
    m_Localized: 'Cultist2: Non è Lei a portare fame, piaghe o conflitti. Lei si limita a donare... il riposo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803585
    m_Localized: 'Cultist2: E noi dobbiamo incontrarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803586
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803587
    m_Localized: Perché siete così ansiosi di incontrare la morte?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803588
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803589
    m_Localized: 'Cultist2: Questo viaggio non è una nostra scelta. È il Suo volere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803590
    m_Localized: 'Cultist2: È stata Lei a chiamarci. Esige che raggiungiamo il Suo regno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803591
    m_Localized: 'Cultist2: Per il maestro è questo il motivo per cui il sole è implacabile: vuole scacciarci dalla terra dei vivi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803592
    m_Localized: 'Cultist2: La Morte dona silenzio, pace e unità. Nel Suo regno torneremo a essere una cosa sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803593
    m_Localized: 'Cultist2: Piangiamo i morti invano, dimenticando che un giorno li incontreremo di nuovo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803594
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803595
    m_Localized: Cosa pensi di fare?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803596
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803597
    m_Localized: 'Cultist2: Il momento è arrivato...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803598
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803599
    m_Localized: 'Cultist2: Ho p‑paura... Il mio corpo non smette di tremare, ma devo avere fede e mostrare risolutezza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803600
    m_Localized: 'Cultist2: Il maestro crede in me. Non posso deluderlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803601
    m_Localized: 'Cultist2: Anche se il terrore... mi attanaglia le viscere...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803602
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803603
    m_Localized: 'Cultist2: Liberaci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803604
    m_Localized: 'Cultist2: Liberaci. LIBERACI!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803605
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803606
    m_Localized: Per quanto tempo pensate di restare?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803607
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803608
    m_Localized: 'Cultist3: Non temere, padrone di casa. Non recheremo alcun disturbo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803609
    m_Localized: 'Cultist3: Ti siamo grati per l''ospitalità e non vogliamo irritarti. Hai già fatto molto per noi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803610
    m_Localized: 'Cultist3: Resteremo in questa stanza a pregare in silenzio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803611
    m_Localized: 'Cultist3: Dobbiamo riposare. Il viaggio che ci attende è lungo e impervio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803612
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803613
    m_Localized: Dove state andando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803614
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803615
    m_Localized: 'Cultist3: Nel reame degli Estranei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803616
    m_Localized: 'Cultist3: La vita umana non è eterna, siamo solo ospiti su questo mondo. Come vi siamo giunti, così lo lasceremo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803617
    m_Localized: 'Cultist3: Gli Estranei prenderanno il nostro posto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803618
    m_Localized: 'Cultist3: Non sono giunti per caso. Sono stati evocati dalla stessa voce che spinge noi lontano...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803619
    m_Localized: 'Cultist3: È stata la Morte a convocarli qui...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803620
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803621
    m_Localized: Perché credi sia stata la morte a evocare i Visitatori?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803622
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803623
    m_Localized: 'Cultist3: La Morte non fa distinzioni. Uomini, bestie, Estranei...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803624
    m_Localized: 'Cultist3: Per Lei non esistono differenze. Siamo tutti uguali al Suo cospetto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803625
    m_Localized: 'Cultist3: Ha atteso a lungo, ma il momento fatidico è ormai alle porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803626
    m_Localized: 'Cultist3: Dobbiamo prepararci per il rituale...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803627
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803628
    m_Localized: Di che rituale stai parlando?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803629
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803630
    m_Localized: 'Cultist3: Dobbiamo trapassare. Raggiungere la nostra nuova dimora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803631
    m_Localized: 'Cultist3: Andremo verso la Morte, in un regno di pace e serenità eterna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803632
    m_Localized: 'Cultist3: Ci lasceremo il vecchio mondo alle spalle...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803633
    m_Localized: 'FatalDame: Ehi, tesoro... Che ti passa per la testa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803634
    m_Localized: Ti piace stare qui?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803635
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803636
    m_Localized: 'FatalDame: È accogliente. Più di quanto mi aspettassi... date le circostanze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803637
    m_Localized: 'FatalDame: Grazie per avermi accolta. Temevo di ritrovarmi sulla strada prima dell''alba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803638
    m_Localized: 'FatalDame: E tu? Come ti senti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803639
    m_Localized: Inquieto.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803640
    m_Localized: Sto bene. Conta solo sopravvivere.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803641
    m_Localized: 'FatalDame: Capisco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803642
    m_Localized: 'FatalDame: Di questi tempi... pensare al futuro è una perdita di tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803643
    m_Localized: 'FatalDame: Tra il sole, i pazzi e i Visitatori, ogni giorno in più è un miracolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803644
    m_Localized: 'FatalDame: Ma l''umanità ha già superato innumerevoli catastrofi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803645
    m_Localized: 'FatalDame: Quando saremo spariti, sono certa che lasceremo tracce del nostro passaggio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803646
    m_Localized: 'FatalDame: Qualcuno troverà ciò che resta di noi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803647
    m_Localized: 'FatalDame: Andrà tutto bene, tesoro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803648
    m_Localized: 'FatalDame: Mi piace il tuo atteggiamento. Ti dona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803649
    m_Localized: 'FatalDame: Ma non tenerti tutto dentro, ok? Le emozioni hanno un brutto vizio: prima o poi traboccano...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803650
    m_Localized: 'FatalDame: Proprio quando meno te lo aspetti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803651
    m_Localized: 'FatalDame: Se hai bisogno di sfogarti, sai dove trovarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803652
    m_Localized: 'FatalDame: E se non vuoi me, cerca qualcun altro. Chiunque sia rimasto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803653
    m_Localized: 'FatalDame: Me lo prometti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803654
    m_Localized: 'FatalDame: Ehi, tesoro... Che ti passa per la testa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803655
    m_Localized: Ieri notte ho visto qualcosa di strano.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803656
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803657
    m_Localized: 'FatalDame: Sì? Cioè?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803658
    m_Localized: Avevi il pancione.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803659
    m_Localized: Niente... Sarà stata solo un'impressione.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803660
    m_Localized: 'FatalDame: In che senso? Che sembravo... incinta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803661
    m_Localized: 'FatalDame: Ah ah, non preoccuparti, tesoro. Hai fatto bene a parlarmi onestamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803662
    m_Localized: 'FatalDame: Magari sei solo affaticato. In questo momento, molte persone dipendono da te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803663
    m_Localized: 'FatalDame: Ti capisco. Se ogni giorno può essere l''ultimo, è già difficile badare a sé stessi, figuriamoci agli altri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803664
    m_Localized: 'FatalDame: Non sai nemmeno se sarai ancora vivo, domani.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803665
    m_Localized: Già... Mi fa paura.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803666
    m_Localized: No, non è questo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803667
    m_Localized: 'FatalDame: Quindi c''è qualcosa che ti preoccupa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803668
    m_Localized: 'FatalDame: Va tutto bene, tesoro. Sei solo molto stanco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803669
    m_Localized: 'FatalDame: Ti osservo, sai? Ti alzi nel cuore della notte per i tuoi giri d''ispezione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803670
    m_Localized: 'FatalDame: Sei un tipo solitario, eppure ti prendi cura delle persone che lasci entrare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803671
    m_Localized: 'FatalDame: È... intrigante. Sei una specie di contraddizione vivente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803672
    m_Localized: 'FatalDame: O forse è solo l''insonnia. La paura è una pessima compagna di letto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803673
    m_Localized: Già... Mi fa paura.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803674
    m_Localized: No, non è questo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803675
    m_Localized: 'FatalDame: Coraggioso da parte tua dirlo ad alta voce.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803676
    m_Localized: 'FatalDame: Ma come possiamo affrontare i nostri timori?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803677
    m_Localized: 'FatalDame: Riesci a convivere con l''idea... che la vita abbia un termine? Che moriremo tutti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803678
    m_Localized: 'FatalDame: Dove troverai la tua salvezza? Ammesso che ne esista ancora una, in questo mondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803679
    m_Localized: 'FatalDame: D''accordo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803680
    m_Localized: 'FatalDame: Comunque sia, sono preoccupata per te, tesoro. Cerca di ascoltare le tue emozioni ogni tanto, intesi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803681
    m_Localized: 'FatalDame: Voglio che tu ti senta al sicuro. Dopotutto, viviamo sotto lo stesso tetto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803682
    m_Localized: 'FatalDame: In fondo, questa casa è come una nave in burrasca, e tu sei al timone.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803683
    m_Localized: 'FatalDame: Se cedi, finiremo tutti in fondo al mare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803684
    m_Localized: 'FatalDame: Spero di aver reso l''idea, tesoro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803685
    m_Localized: 'FatalDame: Ehi, tesoro... Che ti passa per la testa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803686
    m_Localized: So che ieri sera eri incinta. Che sta succedendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803687
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803688
    m_Localized: 'FatalDame: Mi stai spaventando...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803689
    m_Localized: 'FatalDame: Ne sei sicuro? Di aver visto qualcosa, intendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803690
    m_Localized: 'FatalDame: Perché non mi hai svegliata?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803691
    m_Localized: 'FatalDame: È la paura di morire a farti parlare? O il peso di dover proteggere tutta questa gente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803692
    m_Localized: 'FatalDame: Magari è colpa mia? O c''è qualcun altro che ti ossessiona?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803693
    m_Localized: Non prendermi in giro.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803694
    m_Localized: Io... sono sicuro di quel che ho visto.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803695
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803696
    m_Localized: 'FatalDame: L''altro giorno hai parlato di tuo padre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803697
    m_Localized: 'FatalDame: Non abbiamo più toccato l''argomento, quindi non ne so molto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803698
    m_Localized: 'FatalDame: Ma ora... ho la sensazione che tu ti stia comportando esattamente come lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803699
    m_Localized: 'FatalDame: È questo che ti spaventa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803700
    m_Localized: 'FatalDame: Diventare una sua imitazione?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803701
    m_Localized: 'FatalDame: Lui per te non esiste più, giusto? Perché allora ti ostini a risvegliare un fantasma?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803702
    m_Localized: 'FatalDame: Non lo ritroverai all''altro mondo, credimi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803703
    m_Localized: 'FatalDame: Dubito che finirete nello stesso posto, quindi sta'' tranquillo, tesoro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803704
    m_Localized: 'FatalDame: Non pretendere di avere subito tutte le risposte. Un sentiero si costruisce una pietra alla volta. Chiaro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803705
    m_Localized: 'FatalDame: E per favore... non parlarmi più in questo modo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803706
    m_Localized: 'FatalDame: Mi si spezza il cuore a vederti così.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803707
    m_Localized: 'FatalDame: Non devi aver paura della morte, delle responsabilità, dell''intimità... o qualunque altra cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803708
    m_Localized: 'FatalDame: È la vita, tesoro. Tutto qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803709
    m_Localized: 'FatalDame: Non pretendere di avere subito tutte le risposte. Un sentiero si costruisce una pietra alla volta. Chiaro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803710
    m_Localized: 'FatalDame: Magari potrebbe darti conforto l''idea che non svaniamo del tutto quando arriva la nostra ora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803711
    m_Localized: 'FatalDame: Una volta credevo nel paradiso e nell''inferno, ma ora? Non ne sono più così sicura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803712
    m_Localized: 'FatalDame: Magari ci attende qualcosa di completamente diverso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803713
    m_Localized: 'FatalDame: Tu che ne pensi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803714
    m_Localized: 'FatalDame: Ehi, tesoro... Che ti passa per la testa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803715
    m_Localized: Sei incinta e stai per partorire, vero?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803716
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803717
    m_Localized: 'FatalDame: Oh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803718
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803719
    m_Localized: 'FatalDame: Sei consumato dalla disperazione, vedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803720
    m_Localized: 'FatalDame: Ogni tua certezza sta crollando... e non hai la forza di accettarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803721
    m_Localized: 'FatalDame: Forse è perché hai troppa paura di scoprire quale sarà il nostro destino?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803722
    m_Localized: 'FatalDame: O magari pensi che non ci sia più posto per te in questo mondo. Né in altri, qualunque essi siano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803723
    m_Localized: Basta con questi giochetti! Sei incinta, ammettilo.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803724
    m_Localized: Tu non hai paura?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803725
    m_Localized: 'FatalDame: Tesoro... come ti viene in mente? Guarda, non ho nemmeno il pancione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803726
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803727
    m_Localized: 'FatalDame: Lascia che ti chieda una cosa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803728
    m_Localized: 'FatalDame: Se questo bambino fosse reale...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803729
    m_Localized: 'FatalDame: E, come dici tu, stesse per nascere...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803730
    m_Localized: 'FatalDame: Come reagiresti? Lo cercheresti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803731
    m_Localized: Non dovrebbe esistere.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803732
    m_Localized: Non ho ancora deciso.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803733
    m_Localized: 'FatalDame: Uhm... Bella domanda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803734
    m_Localized: 'FatalDame: Ho paura di morire, ovviamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803735
    m_Localized: 'FatalDame: Soprattutto perché non so cosa mi aspetti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803736
    m_Localized: 'FatalDame: Il paradiso, la reincarnazione... o chissà che altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803737
    m_Localized: 'FatalDame: Nessuno è mai tornato indietro per raccontarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803738
    m_Localized: 'FatalDame: Ma tornando a quella tua... visione...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803739
    m_Localized: 'FatalDame: Se questo bambino fosse reale...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803740
    m_Localized: 'FatalDame: E, come dici tu, stesse per nascere...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803741
    m_Localized: 'FatalDame: Come reagiresti? Lo cercheresti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803742
    m_Localized: Non dovrebbe esistere.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803743
    m_Localized: Non ho ancora deciso.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803744
    m_Localized: 'FatalDame: A volte, l''istinto vuole preservare ciò che ci è familiare... anche quando ormai è inutile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803745
    m_Localized: 'FatalDame: Forse...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803746
    m_Localized: 'FatalDame: Forse dovresti aprirti a qualcosa di nuovo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803747
    m_Localized: 'FatalDame: O l''ignoto ti spaventa così tanto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803748
    m_Localized: Troverò quel bambino.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803749
    m_Localized: Sta arrivando, ne sono sicuro.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803750
    m_Localized: 'FatalDame: Non dovresti temere di lasciar andare il passato. Specialmente quando non ti serve più a nulla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803751
    m_Localized: 'FatalDame: Spesso restiamo attaccati alle cose solo per abitudine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803752
    m_Localized: 'FatalDame: È vero, cambiare costa fatica... ma chissà dove potrebbe portarti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803753
    m_Localized: Troverò quel bambino.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803754
    m_Localized: Sta arrivando, ne sono sicuro.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803755
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803756
    m_Localized: 'FatalDame: Se lo dici tu, tesoro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803757
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803758
    m_Localized: 'FatalDame: Fammi sapere cosa scoprirai... quando sarà il momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713856
    m_Localized: 'Neighbour: Bene, ho finito.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713857
    m_Localized: 'Neighbour: Oh, giusto, quasi dimenticavo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713858
    m_Localized: 'Neighbour: Domani sera torno a casa. Segnati il mio numero, hanno appena attivato la linea.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713859
    m_Localized: 'Neighbour: {0}. Teniamoci in contatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713860
    m_Localized: 'Neighbour: Beh, con questo è tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713861
    m_Localized: 'Neighbour: Fatti una birra e vai a dormire.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491133
    m_Localized: 'Cat: Miao!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491134
    m_Localized: Accarezza il gatto
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491135
    m_Localized: Prendi il gatto
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491136
    m_Localized: Dai del cibo in scatola al gatto
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491137
    m_Localized: 'Cat: (Allunghi la mano e accarezzi il gatto)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491138
    m_Localized: 'Cat: (Difficile dire se gli piaccia o no)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491139
    m_Localized: 'Cat: Miao!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491140
    m_Localized: Accarezza il gatto
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491141
    m_Localized: Prendi il gatto
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491142
    m_Localized: Dai del cibo in scatola al gatto
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491143
    m_Localized: 'Cat: (Provi ad accarezzare il gatto)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491144
    m_Localized: 'Cat: (Sembra che gli piaccia molto)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491145
    m_Localized: 'Cat: (È più amichevole di quanto pensavi)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491146
    m_Localized: 'Cat: (Forse sta iniziando ad abituarsi alla tua presenza)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491147
    m_Localized: 'Cat: Miao!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491148
    m_Localized: Accarezza il gatto
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491149
    m_Localized: Prendi il gatto
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491150
    m_Localized: Dai del cibo in scatola al gatto
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491151
    m_Localized: 'Cat: (Il gatto adora ricevere tante carezze)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491152
    m_Localized: 'Cat: (Hai l''impressione che cerchi le tue attenzioni)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491153
    m_Localized: 'Cat: (Come puoi dire di no a un musetto così carino?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491154
    m_Localized: 'Cat: Miao! MIAO! Miao!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491155
    m_Localized: 'Cat: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491156
    m_Localized: 'Cat: (La sua espressione è indecifrabile, ma senti che è felice)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491157
    m_Localized: 'Cat: (Hai la strana sensazione che stanotte riuscirai a dormire in pace)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491158
    m_Localized: 'Cat: (È come se il gatto ti avesse donato una delle sue vite per ringraziarti)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491159
    m_Localized: 'Cat: (Chissà... magari per stanotte la morte risparmierà la tua casa)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547465932800
    m_Localized: 'Teacher: Quei poveri bambini...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292928
    m_Localized: Qualcosa non va?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292929
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292930
    m_Localized: 'Teacher: Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292931
    m_Localized: 'Teacher: Io... ecco, stavo riflettendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292932
    m_Localized: 'Teacher: Se riuscissimo a sopravvivere a questa tragedia, invece di estinguerci... cosa ne sarà di noi?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292933
    m_Localized: 'Teacher: Quale futuro ci aspetta?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292934
    m_Localized: Temi che in questo nuovo mondo non ci sia posto per te?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292935
    m_Localized: Un cuore gentile ha vita breve di questi tempi. Cerca di non restare da sola.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292936
    m_Localized: 'Teacher: Un cuore gentile...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292937
    m_Localized: 'Teacher: Detesto la violenza... e non potrei mai usarla. Non ne sarei mai capace.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292938
    m_Localized: 'Teacher: E non so che fine farò in questo... "nuovo mondo", come lo hai chiamato.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292939
    m_Localized: E quindi? Ti lascerai morire, senza fare nulla?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292940
    m_Localized: Che alternative hai?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292941
    m_Localized: Non è la prima volta che l'umanità attraversa tempi difficili.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292942
    m_Localized: 'Teacher: Non voglio vivere così. Anche se ci fosse qualcuno a proteggermi...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292943
    m_Localized: 'Teacher: I massacri non avranno fine. La violenza non scomparirà.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292944
    m_Localized: E quindi? Ti lascerai morire, senza fare nulla?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292945
    m_Localized: Che alternative hai?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292946
    m_Localized: Non è la prima volta che l'umanità attraversa tempi difficili.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292947
    m_Localized: 'Teacher: Mi sento... perduta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292948
    m_Localized: 'Teacher: Possibile che ormai non esista altro che la violenza e chi la commette?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292949
    m_Localized: 'Teacher: I nostri figli cresceranno seguendo l''esempio di ladri e assassini?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292950
    m_Localized: Non c'è tempo per piangersi addosso.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292951
    m_Localized: DEVI REAGIRE!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292952
    m_Localized: 'Teacher: Io... non lo so.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292953
    m_Localized: 'Teacher: Non ho più nulla da offrire.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292954
    m_Localized: 'Teacher: Vorrei solo... che finisse tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292955
    m_Localized: 'Teacher: Non posso più andare avanti così...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292956
    m_Localized: 'Teacher: Hai ragione. Però...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292957
    m_Localized: 'Teacher: Come si può vivere in questo modo?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292958
    m_Localized: 'Teacher: La gente ha perso il senno. Chiunque sembri vagamente "diverso", viene ucciso senza pietà.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292959
    m_Localized: 'Teacher: E nessuno può o vuole impedirlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292960
    m_Localized: Non c'è tempo per piangersi addosso.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292961
    m_Localized: DEVI REAGIRE!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292962
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292963
    m_Localized: 'Teacher: Perché no?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292964
    m_Localized: 'Teacher: Rifugiati pure nel cinismo per sopportare questo orrore. Io non ci riesco.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292965
    m_Localized: 'Teacher: Se solo avessi visto quello che ho visto io...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292966
    m_Localized: 'Teacher: Quei momenti... sono impressi nella mia memoria, per sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292967
    m_Localized: 'Teacher: Fiamme, urla, volti rabbiosi o terrorizzati, intere famiglie e abitazioni... tutto distrutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292968
    m_Localized: 'Teacher: Non posso essere come te. Non ho la tua forza.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292969
    m_Localized: 'Teacher: Per quelli come me... esiste solo una via d''uscita.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292970
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292971
    m_Localized: 'Teacher: (La donna trasalisce e ti fissa spaventata)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292972
    m_Localized: 'Teacher: (Lo smarrimento l''aveva aiutata a dimenticare quell''incubo, anche se solo per un momento)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292973
    m_Localized: 'Teacher: (Si nasconde il viso tra le mani e inizia a singhiozzare)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292974
    m_Localized: 'Teacher: (Non sai cosa fare, nessuno ti ha insegnato come comportarti in queste situazioni)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292975
    m_Localized: 'Teacher: (Le poggi una mano sulla spalla e resti immobile, in silenzio, al suo fianco)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292976
    m_Localized: 'Teacher: (Forse la cosa migliore è lasciare che si sfoghi)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487232
    m_Localized: 'Mother: Senti, perché non provi a chiamarlo? Segnati il numero: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487233
    m_Localized: 'Mother: E digliene quattro da parte mia.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487234
    m_Localized: 'Mother: In fin dei conti, sono anche figli suoi. Ha il dovere di aiutarmi a cercarli.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487235
    m_Localized: 'Anger: Se riesci a prendere la linea, chiamala per me. Il numero è {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487236
    m_Localized: 'Anger: Dille che... mi dispiace. E che ho ancora voglia di strapparmi la gola.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487237
    m_Localized: 'Anger: O magari sgridala e basta, non lo so... Forse così sarà più semplice.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487238
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875840
    m_Localized: 'FortuneTeller: C''è chi necessita di un aiuto dall''aldilà.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875841
    m_Localized: 'FortuneTeller: Esistono persone... esperti... che sanno come scacciare le tenebre.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875842
    m_Localized: 'FortuneTeller: Se lo desideri, posso metterti in contatto con loro. Credo che ne avrai bisogno.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875843
    m_Localized: 'FortuneTeller: Chiama questo numero: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875844
    m_Localized: 'FortuneTeller: Ah, e ricorda di fare il mio nome!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547533041664
    m_Localized: 'Alkonost: Saresti così gentile da chiamarlo? Questo è il suo numero: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235968
    m_Localized: 'Foreigner: (Ti porge un foglietto con un numero di telefono: {0})'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235969
    m_Localized: 'Foreigner: (Forse è il contatto dell''ambasciata)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818880
    m_Localized: 'Jacob: Cosa non darei per un bicchierino...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818881
    m_Localized: Quando parlavi di immortalità, cosa intendevi?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818882
    m_Localized: Voglio sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818883
    m_Localized: 'Jacob: Beh... se ci tieni a scoprirlo, puoi sempre spararti un colpo in testa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818884
    m_Localized: 'Jacob: Ma fossi in te, ci penserei due volte.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818885
    m_Localized: 'Jacob: Non fraintendermi, non parlavo dell''immortalità nel senso letterale del termine.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818886
    m_Localized: 'Jacob: Dopo la morte rinasciamo, viviamo e moriamo ancora. È un ciclo che si ripete all''infinito.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818887
    m_Localized: 'Jacob: Sembra assurdo, lo so. Ma se avessi vissuto le mie stesse esperienze, non avresti dubbi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818888
    m_Localized: 'Jacob: Forse i Visitatori un tempo erano umani, rinati poi in quella forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818889
    m_Localized: 'Jacob: Almeno credo... Non so come funzioni questa roba di preciso...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818890
    m_Localized: 'Jacob: Ci sono fin troppe cose che ancora non conosciamo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818891
    m_Localized: 'Jacob: Ma prima o poi troverò mia figlia.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818892
    m_Localized: 'Jacob: Non so se accadrà in questa vita o nella prossima... ma ci riuscirò.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818893
    m_Localized: 'Jacob: Perché noi non moriamo mai definitivamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818894
    m_Localized: 'Jacob: Cosa non darei per un bicchierino...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818895
    m_Localized: Perché la FEMA ti sta cercando?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818896
    m_Localized: Voglio sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818897
    m_Localized: 'Jacob: Mi trovavo proprio al centro di questo disastro, quando è iniziato.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818898
    m_Localized: 'Jacob: Nella zona da cui quelle creature sono sbucate fuori.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818899
    m_Localized: 'Jacob: Ricordi quelle stupide storie sui demoni che infestavano la periferia della città?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818900
    m_Localized: 'Jacob: Ormai nessuno bada più a chiacchiere del genere.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818901
    m_Localized: 'Jacob: Solo che alla fine non erano solo voci. E la FEMA lo sapeva, fin dall''inizio.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818902
    m_Localized: 'Jacob: Giuravano che il soprannaturale non c''entrasse affatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818903
    m_Localized: 'Jacob: Ora però il sole ci sta bruciando vivi...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818904
    m_Localized: 'Jacob: Mentre quei mostri del sottosuolo stanno divorando i sopravvissuti!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818905
    m_Localized: 'Jacob: In poche parole, la FEMA ha capito di aver fatto un errore colossale...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818906
    m_Localized: 'Jacob: E ora sta facendo i salti mortali per coprire la sua incompetenza.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818907
    m_Localized: 'Jacob: Mi sono solo trovato nel posto sbagliato al momento sbagliato.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818908
    m_Localized: 'Jacob: Cosa non darei per un bicchierino...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818909
    m_Localized: Come sei sopravvissuto?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818910
    m_Localized: Voglio sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818911
    m_Localized: 'Jacob: L''hai scordato? Sono immortale.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818912
    m_Localized: 'Jacob: Non lo so...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818913
    m_Localized: 'Jacob: Continuo a chiedermelo ogni giorno.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818914
    m_Localized: 'Jacob: Sono stato fortunato. O forse è intervenuto un potere superiore...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818915
    m_Localized: 'Jacob: Dio, o qualunque altra cosa sia.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818916
    m_Localized: 'Jacob: Oppure sono già morto e mi sono reincarnato in questo corpo. Chi può dirlo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818917
    m_Localized: 'Jacob: Ottima domanda.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818918
    m_Localized: 'Jacob: Se fossi io ad avere il fucile, ti chiederei lo stesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818919
    m_Localized: 'Jacob: Ed è un peccato che tu abbia solo della birra.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818920
    m_Localized: 'Jacob: Se avessi quel che serve per distillare, ti farei assaggiare qualcosa di speciale.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818921
    m_Localized: 'Jacob: Cosa non darei per un bicchierino...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818922
    m_Localized: Che altro sai?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818923
    m_Localized: Voglio sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818924
    m_Localized: 'Jacob: Conosco perfettamente l''intera struttura della FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818925
    m_Localized: 'Jacob: Chi comanda, chi ubbidisce, chi trama nell''ombra. Ogni dettaglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818926
    m_Localized: 'Jacob: Quei dannati bastardi sapevano tutto dei Visitatori. Quanto fossero pericolosi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818927
    m_Localized: 'Jacob: E nonostante questo, li hanno lasciati entrare in città.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818928
    m_Localized: 'Jacob: Perché a nessuno di loro fregava un cazzo della nostra sicurezza.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818929
    m_Localized: 'Jacob: Stavano solo riciclando i soldi sporchi del governo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818930
    m_Localized: 'Jacob: Tutti i testimoni della loro incompetenza dovevano morire.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818931
    m_Localized: 'Jacob: Non potevano permettere che la verità trapelasse.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818932
    m_Localized: 'Jacob: E il loro piano era in moto già prima delle zone di quarantena.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818933
    m_Localized: 'Jacob: Me la sono cavata per un pelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818934
    m_Localized: 'Jacob: Volevi conoscere il loro segreto? Beh, eccolo qua...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818935
    m_Localized: 'Jacob: È tutta colpa della FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818936
    m_Localized: 'Jacob: In TV raccontano solo un mucchio di balle.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818937
    m_Localized: 'Jacob: L''unica cosa peggiore dei Visitatori...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818938
    m_Localized: 'Jacob: È proprio la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818939
    m_Localized: 'Jacob: Cosa non darei per un bicchierino...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818940
    m_Localized: Da dove vengono i Visitatori?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818941
    m_Localized: Voglio sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818942
    m_Localized: 'Jacob: Dalla periferia della città.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818943
    m_Localized: 'Jacob: Sì, lo so che è distante dalle zone di quarantena...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818944
    m_Localized: 'Jacob: Eppure è così.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818945
    m_Localized: 'Jacob: Non ho mai creduto al soprannaturale, ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818946
    m_Localized: 'Jacob: Sono gli stessi demoni di cui parlava la gente due anni fa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818947
    m_Localized: 'Jacob: Non so come abbiano fatto a entrare in città...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818948
    m_Localized: 'Jacob: Ma posso dirti chi ha permesso che accadesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818949
    m_Localized: 'Jacob: La FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818950
    m_Localized: 'Jacob: Molti pensano che i Visitatori siano alieni, ma si sbagliano.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818951
    m_Localized: 'Jacob: Sono creature di carne e ossa, come me e te.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818952
    m_Localized: 'Jacob: E sono nate su questo pianeta, esattamente come noi!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818953
    m_Localized: 'Jacob: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818954
    m_Localized: 'Jacob: Non posso trattenermi ancora per molto.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818955
    m_Localized: 'Jacob: Devo trovare mia figlia.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818956
    m_Localized: 'Jacob: Grazie... immortale.'
    m_Metadata:
      m_Items: []
  - m_Id: 53577620711792640
    m_Localized: 'Player: (Non credo abbia altro da dire)'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071808
    m_Localized: Consegna un mandato FEMA
