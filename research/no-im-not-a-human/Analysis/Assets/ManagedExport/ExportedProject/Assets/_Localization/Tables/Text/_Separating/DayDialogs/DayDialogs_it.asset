  - m_Id: 55784900568014861
    m_Localized: 'Wolfhound: Certo, come no...'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792075
    m_Localized: 'Player: Che cos''è?'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792076
    m_Localized: 'Player: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792077
    m_Localized: 'Player: Va bene, lo prendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792078
    m_Localized: 'Player: Cosa? Vuoi restituirlo?'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792079
    m_Localized: 'Player: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792080
    m_Localized: 'Player: Adesso verranno per me...'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539790462976
    m_Localized: Bella domanda.
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434496
    m_Localized: Non sto aspettando.
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434497
    m_Localized: 'Ballerina: Mia domanda? Bella? Perché?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434498
    m_Localized: 'Ballerina: Rispondi a domanda. Non ignorare.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434499
    m_Localized: 'Ballerina: Come lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434500
    m_Localized: Te l'ho detto, non aspetto niente.
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434501
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434502
    m_Localized: 'Ballerina: Sì.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434503
    m_Localized: 'Ballerina: E che fai? Stai seduto, chiuso tra queste pareti.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434504
    m_Localized: 'Ballerina: Lunga, lunga attesa. Per gente? Per risposta?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434505
    m_Localized: Te l'ho detto, non aspetto niente.
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434506
    m_Localized: Estrai il fucile
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434507
    m_Localized: 'Ballerina: Come dici tu. Anche io, stessa cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434508
    m_Localized: 'Ballerina: Oh, io già detto. Io aspetto.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434509
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434510
    m_Localized: 'Ballerina: Comunque, io so questo. Lei arriva.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434511
    m_Localized: 'Ballerina: AH AH AH AH AH AH!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434512
    m_Localized: 'Ballerina: AMO BALLARE. Ti faccio vedere? Spara e guarda!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434513
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434514
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434515
    m_Localized: 'Ballerina: Ta‑dah!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434516
    m_Localized: 'Ballerina: Tu provi ancora?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434517
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434518
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434519
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434520
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434521
    m_Localized: 'Ballerina: La‑la‑laaa!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434522
    m_Localized: 'Ballerina: Non riesci? Io così vicina!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434523
    m_Localized: 'Ballerina: Tu spari con occhi chiusi? O non sei capace?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434524
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434525
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434526
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434527
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434528
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434529
    m_Localized: Spara
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434530
    m_Localized: 'Ballerina: Tra‑la‑la‑la‑la!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434531
    m_Localized: 'Ballerina: Basta, sono stanca.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434532
    m_Localized: 'Ballerina: Faccio da me. Più veloce.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683264
    m_Localized: 'Foreigner: Xlh''è...?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683265
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683266
    m_Localized: 'Foreigner: Kvixsé ml... Tizarv.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683267
    m_Localized: 'Unstable: Ecco, ci siamo. Sono esausto...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683268
    m_Localized: Beh, dicevi di avere cose da raccontare?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683269
    m_Localized: 'Unstable: Ah, giusto... Possiamo scambiarci qualche storia. Ti va di condividerne una per primo?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683270
    m_Localized: Non con te.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683271
    m_Localized: Vieni al dunque.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683272
    m_Localized: 'Unstable: Certo, certo. Nessuno ti obbliga.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683273
    m_Localized: 'Unstable: Allora... Ero in questo bar... O forse non era un bar, ma un posto diverso...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683274
    m_Localized: 'Unstable: Accidenti, come diamine si chiamava...?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683275
    m_Localized: E...?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683276
    m_Localized: 'Unstable: Giusto, giusto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683277
    m_Localized: 'Unstable: Dunque... Me ne stavo lì a farmi gli affari miei, sorseggiando la mia amata EnerJeka.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683278
    m_Localized: 'Unstable: Accidenti, se mi piace. Non hai idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683279
    m_Localized: 'Unstable: È una roba... sconvolgente.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683280
    m_Localized: 'Unstable: Il retrogusto ti resta in bocca per tutta la giornata! Peccato che non si trovi ovunque...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683281
    m_Localized: E quindi...?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683282
    m_Localized: 'Unstable: Oh, vero... Dov''ero rimasto...?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683283
    m_Localized: 'Unstable: Me ne stavo seduto, dicevo, in quel bar mezzo vuoto. Con la musica a palla nelle orecchie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683284
    m_Localized: 'Unstable: D''un tratto, qualcuno si mette a urlare. Così forte che lo sento persino con le cuffie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683285
    m_Localized: 'Unstable: Proprio durante un pezzo da paura. Non amo che mi si distolga dalla musica, sai.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683286
    m_Localized: 'Unstable: Hai presente, no? Quando sei così immerso nel suono che il mondo quasi scompare...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683287
    m_Localized: Che cazzo...?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683288
    m_Localized: 'Unstable: Va bene, va bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683289
    m_Localized: 'Unstable: Mi sono strappato le cuffie e ho visto questo spilungone che urlava in faccia a un povero diavolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683290
    m_Localized: 'Unstable: Vai a sapere quale fosse la questione, ma riusciva a stento a spiccicare due parole di senso compiuto. Era ubriaco marcio.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683291
    m_Localized: 'Unstable: Poi quella pertica lancia un urlo e molla un ceffone all''altro tizio. Che crolla come un sacco di patate.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683292
    m_Localized: 'Unstable: Ma lo stangone non è ancora soddisfatto. Sale sul bancone, barcollando come un budino, con la testa che sfiora il soffitto...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683293
    m_Localized: 'Unstable: E si mette a strepitare: "Siete feccia, tutti quanti!".'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683294
    m_Localized: 'Unstable: Ho capito che la faccenda stava per degenerare.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683295
    m_Localized: 'Unstable: E visto che non mi andava di restare coinvolto, me la sono filata.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683296
    m_Localized: Poi cosa è successo?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683297
    m_Localized: 'Unstable: Niente. È diventato tutto così... strano.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683298
    m_Localized: 'Unstable: Ovunque io vada, prima o poi qualcuno decide di piantare grane.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683299
    m_Localized: 'Unstable: Basta che mi fermi più di due giorni nello stesso posto. Puntuale.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683300
    m_Localized: 'Unstable: Scontro. Morte. Bara. Tomba. Di solito l''ordine è questo...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683301
    m_Localized: 'Unstable: Spero che qui vada diversamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683302
    m_Localized: 'Unstable: Ecco, ci siamo. Sono esausto...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683303
    m_Localized: Qual è il verdetto, allora? Qui ti senti al sicuro?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683304
    m_Localized: 'Unstable: Difficile dirlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683305
    m_Localized: 'Unstable: Tu emani quest''aura di... tranquillità domestica?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683306
    m_Localized: 'Unstable: Sarà perché questa è casa tua, immagino. Ah ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683307
    m_Localized: 'Unstable: Sembra che tu voglia creare una sorta di rifugio sicuro.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683308
    m_Localized: 'Unstable: Non fai entrare chiunque, e tutto il resto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683309
    m_Localized: 'Unstable: Ma l''hai notato anche tu, no? C''è qualcosa di strano.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683310
    m_Localized: 'Unstable: Beh, certo, il mondo intero è impazzito. Ma qui... Qui...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683311
    m_Localized: 'Unstable: Non lo so, non sono nemmeno sicuro di quello che voglio dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683312
    m_Localized: 'Unstable: Bah, pazienza. Beviti un''EnerJeka e non pensarci più.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683313
    m_Localized: 'Unstable: Non c''è problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683314
    m_Localized: Quando hai intenzione di andartene?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683315
    m_Localized: Sei ancora in fuga da qualcosa?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683316
    m_Localized: 'Unstable: Presto, credo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683317
    m_Localized: 'Unstable: Non mi piace restare a lungo nello stesso posto. L''avrai notato.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683318
    m_Localized: 'Unstable: E se non l''hai notato... Beh, l''ho ripetuto almeno un paio di volte, ah ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683319
    m_Localized: 'Unstable: Speravo che a casa tua avrei potuto svagarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683320
    m_Localized: 'Unstable: Ma qui tutto sa di morte, non trovi? Non capisco, però...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683321
    m_Localized: 'Unstable: Ho visto abbastanza. Mi basta.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683322
    m_Localized: 'Unstable: Non fuggo, mi sposto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683323
    m_Localized: 'Unstable: Non mi servono altri problemi, ne ho già a sufficienza.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683324
    m_Localized: 'Unstable: Se resti fermo troppo a lungo, prima o poi qualcuno ti prenderà a pugni, ti sparerà o proverà a rinchiuderti.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683325
    m_Localized: 'Unstable: E chi lo sa dove conduce quella strada...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683326
    m_Localized: 'Unstable: Certo, più me ne vado in giro e più è probabile che incontri qualche vero pazzoide.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683327
    m_Localized: 'Unstable: Ma insomma, è comunque meglio di fidarsi e ritrovarsi con un coltello nella schiena.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683328
    m_Localized: 'Unstable: Ecco, ci siamo. Sono esausto...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683329
    m_Localized: Beh? Tutto pronto?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683330
    m_Localized: 'Unstable: Eh? Oh... Oh, sì. Me ne andrò stanotte.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683331
    m_Localized: 'Unstable: Quindi... Stammi bene!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683332
    m_Localized: Non puoi fuggire da tutti gli orrori del mondo.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683333
    m_Localized: Buona fortuna. Ti auguro di sfuggire ai pazzoidi.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683334
    m_Localized: 'Unstable: Sì, lo so. Ma ehi, non si sa mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683335
    m_Localized: 'Unstable: Pensi che fermarsi in un posto faccia molta differenza?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683336
    m_Localized: Beh... In bocca al lupo.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683337
    m_Localized: Se torni non ti lascerò entrare, lo sai?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683338
    m_Localized: 'Unstable: Non sei sarcastico, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683339
    m_Localized: 'Unstable: Grazie, comunque. Qui ho potuto riposarmi. Ho energia per almeno un paio di giorni.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683340
    m_Localized: 'Unstable: L''EnerJeka fa miracoli, credimi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683341
    m_Localized: 'Unstable: E se invece era una battuta... preferisco fare qualcosa, qualsiasi cosa, piuttosto che aspettare che mi si cuocia il cervello.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683342
    m_Localized: 'Unstable: Cosa avrei da perdere, poi? Ho mollato tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683343
    m_Localized: 'Unstable: Tanto vale cercare qualcosa di nuovo. Invece di gettare la spugna e attendere che cali il sipario.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683344
    m_Localized: 'Unstable: Non voglio... che accada.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683345
    m_Localized: Beh... In bocca al lupo.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683346
    m_Localized: Se torni non ti lascerò entrare, lo sai?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683347
    m_Localized: 'Unstable: Grazie. Anche a te.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683348
    m_Localized: 'Unstable: Magari ci rivedremo. Potrei avere persino una o due storie nuove da raccontare.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683349
    m_Localized: 'Unstable: E magari in quel frangente lo farò, perché ora come ora non ci penso nemmeno. Con quella faccia mogia che ti ritrovi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683350
    m_Localized: 'Unstable: Beh, tanto non importa. Non ho intenzione di tornare.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683351
    m_Localized: 'Unstable: È inutile. Tornare sui propri passi è inutile. Trovi solo terra bruciata e ossa carbonizzate.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683352
    m_Localized: 'Unstable: Senza offesa, ma l''ho visto con i miei occhi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683353
    m_Localized: 'Unstable: È più facile lasciarsi tutto alle spalle. Quindi... è meglio se non ci rivediamo mai più.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683354
    m_Localized: 'Unstable: Ecco, ci siamo. Sono esausto...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683355
    m_Localized: Non dovevi andartene?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683356
    m_Localized: 'Unstable: Sì, ma volevo prima avvisarti!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683357
    m_Localized: 'Unstable: L''altra notte ho avvertito qualcosa di inquietante fuori dalla finestra. Volevo dirtelo, ma non me la sono sentita di svegliarti.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683358
    m_Localized: 'Unstable: Sii prudente, intesi? La morte ti sta cercando, non c''è dubbio.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683359
    m_Localized: 'Unstable: Non so nemmeno come spiegartelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683360
    m_Localized: 'Unstable: Ho questa costante sensazione di formicolio, sarà per tutta quella caffeina.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683361
    m_Localized: 'Unstable: Ma non è questo il punto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683362
    m_Localized: 'Unstable: Mi sono sentito in dovere di avvisarti, ok? Prima che accadesse qualcosa di brutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683363
    m_Localized: 'Unstable: Forse dovresti riflettere anche tu sull''opportunità di andartene.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683364
    m_Localized: 'Unstable: Non guardarmi così... Ho capito, sto dicendo sciocchezze. Non importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683365
    m_Localized: 'Unstable: Ritieniti avvisato, comunque. Tutto qui, stavolta sul serio. Non voglio che tu finisca bruciato come gli altri.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683366
    m_Localized: 'Rocker: Accidenti, quanto mi manca la mia chitarra...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683367
    m_Localized: Cosa stai fantasticando?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460480
    m_Localized: 'Rocker: Eh? Stavo facendo la conta di chi resta della vecchia band.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460481
    m_Localized: 'Rocker: All''epoca, dopo ogni funerale attaccavamo gli strumenti e ci mettevamo a suonare. Meglio che marcire a letto o ubriacarsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460482
    m_Localized: 'Rocker: Una volta mi sono esercitato sullo stesso riff per tre notti di fila, fino a farmi sanguinare le dita.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460483
    m_Localized: 'Rocker: Solo io e la mia chitarra. Così che il mio cervello non avesse tempo di ricordare la faccia del poveraccio che aveva tirato le cuoia.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460484
    m_Localized: 'Rocker: Ora è sempre la stessa merda, ogni santo giorno. I Visitatori, il sole che brucia... Un altro giro all''inferno, alla salute!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460485
    m_Localized: 'Rocker: Accidenti, quanto mi manca la mia chitarra...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460486
    m_Localized: È dura? Stare senza chitarra?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460487
    m_Localized: 'Rocker: Altroché...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460488
    m_Localized: 'Rocker: Ricordo le prove in cucina. L''amplificatore sullo sgabello, e il volume a metà per evitare che i vicini chiamassero gli sbirri.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460489
    m_Localized: 'Rocker: E dopo ogni pezzo qualcuno aggiungeva "in memoria di Tizio o Caio". Tutto qui... Niente lacrime, niente stronzate.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460490
    m_Localized: 'Rocker: Meglio spaccare una vecchia chitarra che sbattere la testa al muro. Almeno la prima puoi sostituirla.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460491
    m_Localized: 'Rocker: All''epoca, ero convinto che i nostri concertini da salotto fossero l''inizio di una vera carriera.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460492
    m_Localized: 'Rocker: Ma questa città ci ha inghiottiti e sputati prima ancora di iniziare.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460493
    m_Localized: 'Rocker: C''era sempre qualche bastardo che moriva di overdose o schiantandosi con l''auto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460494
    m_Localized: 'Rocker: Che vita di merda...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460495
    m_Localized: 'Rocker: Stanotte uscirò. Voglio andare in un posto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460496
    m_Localized: 'Rocker: Accidenti, quanto mi manca la mia chitarra...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460497
    m_Localized: Allora? Ieri notte sei uscito?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460498
    m_Localized: 'Rocker: Sì, sono andato nel vecchio covo in cui facevamo le prove. Muffa sui muri, fili scoperti, è una discarica.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460499
    m_Localized: 'Rocker: Ho acceso il metronomo, ho ascoltato per qualche secondo e... niente. Solo il vuoto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460500
    m_Localized: 'Rocker: A cosa serve continuare a sognare...?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460501
    m_Localized: 'Rocker: Il rock and roll non morirà mai? Ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460502
    m_Localized: 'Rocker: Se anche il sole non avesse deciso di friggerci, sarebbe sbucata qualche altra fregatura.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460503
    m_Localized: 'Rocker: Quando ero piccolo, pensavo che il peggio fosse passato. Che da lì fosse tutta discesa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460504
    m_Localized: 'Rocker: La recessione, la guerra... Sembrava che potessimo finalmente iniziare a vivere.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460505
    m_Localized: 'Rocker: Quanto cazzo mi sbagliavo...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460506
    m_Localized: 'Rocker: Accidenti, quanto mi manca la mia chitarra...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460507
    m_Localized: A cosa stai pensando?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460508
    m_Localized: 'Rocker: L''ho capito oggi. Tutte le mie storie erano riempitivi e poco più. Non ho mai avuto il mio momento di gloria. E forse non l''avrò mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460509
    m_Localized: 'Rocker: Non so nemmeno perché ti ho mentito.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460510
    m_Localized: 'Rocker: Forse volevo fingere di avercela fatta, almeno per una volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460511
    m_Localized: 'Rocker: Ho detto di essere stato all''inferno e di esserne uscito più forte. Stronzate. Mi sono nascosto sotto le coperte come un bambino.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460512
    m_Localized: 'Rocker: La paura della morte... ha spezzato qualcosa dentro di me. Ho ucciso il vecchio me stesso per diventare altro... Ma sono solo patetico.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460513
    m_Localized: 'Rocker: Di questo passo, mi attende la stessa fine degli altri. La pancia gonfia di pillole, o un bagno caldo e un rasoio.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460514
    m_Localized: 'Rocker: Non sono un Visitatore. Solo un idiota fallito che sta per cedere.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460515
    m_Localized: 'Rocker: Se hai intenzione di sparare...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460516
    m_Localized: 'Rocker: Ah, vaffanculo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460517
    m_Localized: 'Rocker: Non me ne importa più niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460518
    m_Localized: 'Experienced: Tutto in ordine, compare?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460519
    m_Localized: Se sei stato in carcere, dove sono i tuoi tatuaggi?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460520
    m_Localized: 'Experienced: Solo perché non ho il corpo scarabocchiato non vuol dire che non sono stato al fresco.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460521
    m_Localized: 'Experienced: Non si giudica un libro dalla copertina. Semplice.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460522
    m_Localized: 'Experienced: Certo, ne ho passati tanti di guai. Ma non ho mai ucciso nessuno...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460523
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460524
    m_Localized: 'Experienced: Non fraintendermi, amico, ma devo chiedertelo. Com''è che comandi tu, qua dentro?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460525
    m_Localized: Che ti importa?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460526
    m_Localized: Pensa agli affari tuoi.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460527
    m_Localized: 'Experienced: Ho l''impressione che tu faccia entrare proprio tutti. Vagabondi, svitati...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460528
    m_Localized: 'Experienced: È un pessimo approccio. Io ne ho viste tante, so come funziona.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460529
    m_Localized: 'Experienced: Attiri solo guai, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460530
    m_Localized: 'Experienced: Immagina... Fai entrare in casa un vecchio a caso, e questo decide di schiattare sul tuo divano.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460531
    m_Localized: 'Experienced: Cosa succede poi? Finisce che te l''accollano, ti incolpano della sua morte. Capisci?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460532
    m_Localized: 'Experienced: E mettiamo che sia una donna. Qualcuno la mette incinta. Che fai?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460533
    m_Localized: 'Experienced: Ti prendi cura tu del marmocchio? Sarebbe un bel macello, no? Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460534
    m_Localized: 'Experienced: Morale della favola, amico... Solo uomini veri. Io e te ce la sappiamo cavare.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460535
    m_Localized: Mi stai suggerendo di rifiutare l'ingresso ad anziani, donne e bambini?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460536
    m_Localized: Dovrei fidarmi di un ex galeotto?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460537
    m_Localized: 'Experienced: Chiaro e tondo, amico. Io me ne tirerei fuori.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460538
    m_Localized: 'Experienced: Non volevo farti arrabbiare. La casa è tua, decidi tu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460539
    m_Localized: 'Experienced: C''è un''unica cosa che non mi torna...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460540
    m_Localized: 'Experienced: Perché la gente va ancora in giro vestita?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460541
    m_Localized: 'Experienced: Tu sei sveglio, amico. Non serve più.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460542
    m_Localized: Hai una bella faccia tosta, sai?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460543
    m_Localized: Quando sei diventato un esperto? Il giorno che sei uscito di galera?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460544
    m_Localized: 'Experienced: Senti, ti consiglio solo di non far entrare chicchessia. O te ne pentirai.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460545
    m_Localized: Hai una bella faccia tosta, sai?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460546
    m_Localized: Quando sei diventato un esperto? Il giorno che sei uscito di galera?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460547
    m_Localized: 'Experienced: Pensi di essere divertente, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460548
    m_Localized: 'Experienced: Chiaro e tondo, amico. Io me ne tirerei fuori. Non te lo ripeterò una seconda volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460549
    m_Localized: 'Experienced: C''è un''unica cosa che non mi torna...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460550
    m_Localized: 'Experienced: Perché la gente va ancora in giro vestita con questo caldo?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460551
    m_Localized: 'Experienced: Tutto in ordine, compare?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460552
    m_Localized: Non senti freddo conciato così?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460553
    m_Localized: 'Experienced: Così come?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460554
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460555
    m_Localized: 'Experienced: Mi prendi in giro?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460556
    m_Localized: 'Experienced: Il sole ci cuoce come bistecche. In strada ci sono più resti carbonizzati che su un barbecue.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460557
    m_Localized: 'Experienced: E tu? Tu te ne vai in giro in maglione. Chi è il vero idiota, amico?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460558
    m_Localized: Questi vestiti sono parte di me.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460559
    m_Localized: Sto bene così.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460560
    m_Localized: 'Experienced: Parte di te, dici...?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460561
    m_Localized: 'Experienced: Come preferisci, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460562
    m_Localized: 'Experienced: In strada fa più caldo che all''inferno e voi vi pavoneggiate nei vostri vestiti della festa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460563
    m_Localized: 'Experienced: È da stupidi. Hai il sudore che ti scorre tra le chiappe, ma non sia mai che ti vedano il culo!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460564
    m_Localized: 'Experienced: O magari... Se qualcuno è coperto di panni eppure non suda, forse non è proprio normale...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460565
    m_Localized: Stai insinuando che sono un Visitatore?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460566
    m_Localized: Dove vuoi andare a parare?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460567
    m_Localized: 'Experienced: Mi prendi per i fondelli, amico? Io sto qua a cuocermi con le chiappe al vento, e tu sei bello sereno in maglione?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460568
    m_Localized: 'Experienced: Non ci arrivo. Hai il sudore che ti scorre tra le chiappe, ma non sia mai che ti vedano il culo!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460569
    m_Localized: 'Experienced: Pensa alla spiaggia... Costumi da bagno, bikini, tutto normale.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460570
    m_Localized: 'Experienced: Stessa afa, ma meno divertimento!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460571
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460572
    m_Localized: 'Experienced: O magari... Se qualcuno è coperto di panni eppure non suda, forse non è proprio normale...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460573
    m_Localized: Stai insinuando che sono un Visitatore?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460574
    m_Localized: Dove vuoi andare a parare?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460575
    m_Localized: 'Experienced: Rilassati, amico. Non ti sto minacciando.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460576
    m_Localized: 'Experienced: Sembri a posto. Ti piace sudare? Accomodati.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460577
    m_Localized: 'Experienced: Io parlo di quegli altri pagliacci. È come mettersi il cappotto in spiaggia.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460578
    m_Localized: E quindi, dovrei spogliarmi?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460579
    m_Localized: Teoria favolosa. Da dove l'hai tirata fuori?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460580
    m_Localized: 'Experienced: Senti, per come la vedo io ci sono solo due ragioni per continuare a indossare i vestiti. Essere dei veri idioti, o non essere umani.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460581
    m_Localized: 'Experienced: Quei mostri sono cibo per i vermi! Per questo non soffrono il caldo. Lo capisci?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460582
    m_Localized: E quindi, dovrei spogliarmi?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460583
    m_Localized: Teoria favolosa. Da dove l'hai tirata fuori?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460584
    m_Localized: 'Experienced: Senti, amico. Non intendevo questo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460585
    m_Localized: 'Experienced: Ti piace sudare? Accomodati.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460586
    m_Localized: 'Experienced: Dico solo che... è strano. Bisogna essere dei veri idioti, oppure...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460587
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460588
    m_Localized: 'Experienced: Dico sul serio! Andarsene in giro coperti da capo a piedi con i tempi che corrono è una follia.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460589
    m_Localized: 'Experienced: Chi è tanto stupido da vestirsi con questo caldo? È questo che intendo. Bisogna essere dei veri idioti, oppure...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460590
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460591
    m_Localized: 'Experienced: Ah, al diavolo. Sono stufo di parlarne.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460592
    m_Localized: 'Experienced: Tutto in ordine, compare?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460593
    m_Localized: Beh, cosa volevi dirmi la volta scorsa?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460594
    m_Localized: 'Experienced: Senti, amico, posso spiegartelo come a un bambino delle elementari. Ma ti interessa sul serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460595
    m_Localized: Sì.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460596
    m_Localized: No.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460597
    m_Localized: 'Experienced: D''accordo, allora. Stammi a sentire.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460598
    m_Localized: 'Experienced: Te la faccio breve. Qui intorno ci sono solo mele marce.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460599
    m_Localized: Cosa te lo fa pensare?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460600
    m_Localized: Hai sempre pensato al prossimo in questi termini?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460601
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460602
    m_Localized: 'Experienced: Ma che cazzo...?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460603
    m_Localized: 'Experienced: Perché diavolo me l''hai chiesto, allora?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460604
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460605
    m_Localized: 'Experienced: Sembra che tutti, lì fuori, abbiano perso la brocca. Solo chi resta al chiuso mantiene il senno.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460606
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460607
    m_Localized: 'Experienced: Sai che ti dico, amico? Chiuderò il becco, prima di dare di matto anch''io.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460608
    m_Localized: 'Experienced: Senti, pensi che me ne andrei in giro in slippino aderente se non mi sentissi bruciare?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460609
    m_Localized: 'Experienced: Mi fa uscire dai gangheri che tutti se ne vadano a spasso conciati come se non sentissero caldo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460610
    m_Localized: 'Experienced: Tu sei stato all''aperto più di me, ma è come se vivessi in un bunker.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460611
    m_Localized: 'Experienced: Ce l''hai almeno un''idea di come identificare quei mostri?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460612
    m_Localized: Sì, conosco i segni. Li ho visti alla TV.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460613
    m_Localized: Nessuno lo sa con certezza.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460614
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460615
    m_Localized: 'Experienced: Starai scherzando...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460616
    m_Localized: 'Experienced: Te l''ho spiegato! Quelli che indossano i vestiti sono Visitatori!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460617
    m_Localized: 'Experienced: Ce l''hai almeno un''idea di come identificare quei mostri?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460618
    m_Localized: Sì, conosco i segni. Li ho visti alla TV.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460619
    m_Localized: Nessuno lo sa con certezza.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460620
    m_Localized: 'Experienced: Voglio proprio sperarlo, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460621
    m_Localized: 'Experienced: Sarebbe un peccato se quei segni si rivelassero cazzate. Finiresti dritto al fresco.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460622
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460623
    m_Localized: 'Experienced: E quindi? Scegliamo a caso, allora?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460624
    m_Localized: 'Experienced: Diamine, se non c''è altro modo, cosa possiamo fare? Così sia.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460625
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460626
    m_Localized: 'Experienced: Onestamente, visto come stanno le cose... non c''è più una persona normale...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460627
    m_Localized: 'Experienced: Mi sentivo più al sicuro in carcere.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460628
    m_Localized: 'Experienced: Tutto in ordine, compare?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460629
    m_Localized: Se ti sentivi più al sicuro in carcere, perché sei uscito?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460630
    m_Localized: 'Experienced: Te l''ho spiegato, amico. Ho scontato la pena. Terza condanna, tra l''altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460631
    m_Localized: 'Experienced: La prima risale a quando ero ragazzino.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460632
    m_Localized: 'Experienced: Quando sono uscito, ho provato a rigare dritto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460633
    m_Localized: 'Experienced: E l''ho fatto, amico. Mi sono sposato, ho avuto un figlio. Addio, vecchia vita.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460634
    m_Localized: 'Experienced: Poi è arrivata la recessione. Per sfamare la famiglia ho dovuto spalare la merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460635
    m_Localized: 'Experienced: E in men che non si dica sono tornato ai miei vecchi intrallazzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460636
    m_Localized: 'Experienced: A quel punto, una seconda condanna era questione di tempo. La terza volta è stata per scelta. Qui fuori non c''è più nulla per me.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460637
    m_Localized: 'Experienced: Mia moglie mi ha lasciato, mio figlio ha paura di me e nessuno assumerebbe un ex detenuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460638
    m_Localized: 'Experienced: E quindi, sì... Metà della mia vita è andata in malora.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460639
    m_Localized: Cosa ti impedisce di tornare dentro?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460640
    m_Localized: Mi dispiace.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460641
    m_Localized: 'Experienced: Niente, amico. Non ho ancora trovato un buon motivo per farlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460642
    m_Localized: 'Experienced: Ogni cosa a suo tempo. Ogni cosa a suo tempo...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460643
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460644
    m_Localized: 'Experienced: Non mi serve la tua compassione. Chi è causa del suo mal...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460645
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460646
    m_Localized: 'Experienced: Il mondo è cambiato, mentre ero al fresco.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460647
    m_Localized: 'Experienced: Ormai sono vecchio. Non conosco i nuovi trucchi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460648
    m_Localized: 'Experienced: Somiglio al letto della mia cella. Era di legno massiccio all''epoca, e lo è ancora adesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460649
    m_Localized: 'Experienced: Sono fatto così, e non credo di poter cambiare.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460650
    m_Localized: 'Experienced: Adattarsi è difficile, di questi tempi. Nessuno si fida più di nessuno. Stanno tutti con il coltello tra i denti.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460651
    m_Localized: 'Experienced: Io sono abituato a parlare chiaro.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460652
    m_Localized: 'Experienced: Che tu ci creda o no, in carcere la gente è onesta. Ognuno mostra il suo vero volto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460653
    m_Localized: 'Experienced: Qui fuori? Non si capisce nemmeno chi sia una persona vera e chi un mostro. È tutto incasinato.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460654
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460655
    m_Localized: 'Experienced: Non sono un filosofo, ma... è così difficile restare umani? In carcere ci si riesce, in qualche modo...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460656
    m_Localized: 'Experienced: Evidentemente, qui fuori ci sono più anime corrotte di quanto non credessi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460657
    m_Localized: 'Jacket: Accidenti... È un vero macello.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460658
    m_Localized: Vivevi in dormitorio, non è vero?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460659
    m_Localized: 'Jacket: Sì. Non l''avevo detto, ma non sono di queste parti. Ci sono venuto per studiare, prima che tutto andasse in malora...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460660
    m_Localized: 'Jacket: In principio ci hanno rinchiusi nei dormitori, temendo che il virus si diffondesse. Poi... hanno chiamato le tute gialle.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460661
    m_Localized: 'Jacket: Io ero già in allarme, e quando ho saputo che portavano gli infetti nelle zone di quarantena...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460662
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460663
    m_Localized: 'Jacket: Non potevo restare ad aspettare che venissero a prendermi. Quindi, mi sono calato dalla finestra e ho cominciato a correre.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460664
    m_Localized: 'Jacket: Ho preso la giacca e sono scappato. Non sapevo dove andare, però. Ecco come sono arrivato alla tua porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460665
    m_Localized: Solo la giacca?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460666
    m_Localized: Cos'altro hai preso?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460667
    m_Localized: 'Jacket: Sì. È la mia preferita.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460668
    m_Localized: 'Jacket: Beh, ho preso i documenti e poco altro. Ma onestamente, la giacca è l''unica cosa che conta.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460669
    m_Localized: 'Jacket: Non fraintendermi, non è di marca né particolarmente costosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460670
    m_Localized: 'Jacket: Ma è una delle poche cose che mi restano di mio fratello.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460671
    m_Localized: 'Jacket: Accidenti... È un vero macello.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460672
    m_Localized: Cosa è successo a tuo fratello?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460673
    m_Localized: 'Jacket: Per farla breve, l''ha portato via la FEMA. Da allora non l''ho più rivisto.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460674
    m_Localized: 'Jacket: Era un marinaio.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460675
    m_Localized: 'Jacket: E questa giacca... me l''aveva portata in regalo dall''estero, di ritorno da uno dei suoi viaggi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460676
    m_Localized: 'Jacket: Mi aspettavo al massimo qualche bazzecola, come una penna o una calamita da frigorifero...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460677
    m_Localized: 'Jacket: Invece aveva speso bei soldi per prendermi una giacca! Ero felicissimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460678
    m_Localized: 'Jacket: Ci vedevamo di rado, onestamente. Quella sua premura mi aveva fatto emozionare.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460679
    m_Localized: 'Jacket: Lo ammetto, sono finito in più di un guaio per via di questa giacca. Non se ne trovano di simili, da queste parti.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460680
    m_Localized: 'Jacket: Non è raro che provino a rubarmela...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460681
    m_Localized: 'Jacket: Ma io non ci rinuncerei per nulla al mondo. Non è una semplice giacca, è un ricordo di mio fratello.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460682
    m_Localized: 'Jacket: Spero solo che stia bene...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460683
    m_Localized: 'Jacket: Accidenti... È un vero macello.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460684
    m_Localized: Hai mai pensato di cercare tuo fratello nella zona di quarantena?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460685
    m_Localized: 'Jacket: Non è così semplice.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460686
    m_Localized: 'Jacket: Non l''hanno portato nella zona di quarantena. La FEMA lo ha preso con sé.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460687
    m_Localized: Cioè...
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460688
    m_Localized: Merda.
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460689
    m_Localized: 'Jacket: Già. Ora è uno di loro.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460690
    m_Localized: 'Jacket: Non gli hanno lasciato molta scelta. Si sono presentati alla sua porta e gli hanno detto "Vai bene".'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460691
    m_Localized: 'Jacket: Non si sarebbe mai unito a loro volontariamente. Mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460692
    m_Localized: 'Jacket: È per questo che non posso farmi trovare.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460693
    m_Localized: 'Jacket: Non è perché ho paura dei Visitatori. Chi non ne ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460694
    m_Localized: 'Jacket: Ma se molti tremano al pensiero di scoprire che chi hanno davanti non è umano... Io nutro un altro timore.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460695
    m_Localized: 'Jacket: E se la persona venuta a prendermi si rivelasse mio fratello?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460696
    m_Localized: 'Jacket: Come reagirebbe? Infrangerebbe le regole e mi lascerebbe andare? E cosa gli accadrebbe in quel caso?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460697
    m_Localized: 'Jacket: O invece si limiterebbe a obbedire, conducendomi alla zona di quarantena con gli altri?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460698
    m_Localized: 'Jacket: E se gli ordinassero di spararmi...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460699
    m_Localized: 'Jacket: Proverei sollievo, sapendo di morire per mano sua? O sarebbe ancora peggio?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460700
    m_Localized: 'Jacket: Non mi piace nessuna delle alternative.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460701
    m_Localized: 'Jacket: La mia mente è invasa da mille turbamenti. Ma uno soltanto mi terrorizza sul serio...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460702
    m_Localized: 'Jacket: Se un giorno dovessero catturarmi... Potrei non riconoscere nemmeno mio fratello, dietro la maschera.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725184
    m_Localized: 'Tough: Niente è mai facile. Niente di niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725185
    m_Localized: Ne hai passate tante, eh?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725186
    m_Localized: 'Tough: Scommetto che chi faceva la bella vita è morto, ormai.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725187
    m_Localized: 'Tough: Quando i soldi hanno perso ogni potere, i più deboli non ce l''hanno fatta.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725188
    m_Localized: 'Tough: Chi è privo di spina dorsale diventa facilmente una vittima... di stupratori, opportunisti o qualche svitato.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725189
    m_Localized: 'Tough: L''hai notato anche tu, no? Le persone si stanno trasformando in bestie. Ma noi no.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725190
    m_Localized: 'Tough: Noi non ci abbassiamo al loro livello. Possiamo reagire, e aiutare gli altri a sopravvivere.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725191
    m_Localized: 'Tough: Noi vogliamo vivere.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725192
    m_Localized: 'Tough: La feccia, i codardi, i rinunciatari... sarà il mondo stesso a scartarli.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725193
    m_Localized: 'Tough: Sì, è una visione estrema. Ma è così che stanno le cose. Non possiamo farci niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725194
    m_Localized: 'Tough: Possiamo soltanto sforzarci di conservare ciò che resta della nostra umanità. Spero che questo posto ci aiuti.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725195
    m_Localized: 'Tough: Niente è mai facile. Niente di niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725196
    m_Localized: Non ne sono tanto sicuro.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725197
    m_Localized: 'Tough: Non possiamo limitarci a dire "Tutto si aggiusterà". Beh, possiamo, ma non servirebbe a niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725198
    m_Localized: 'Tough: Non c''è spazio per le banalità. O sei pronto all''inferno... o non lo sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725199
    m_Localized: Non capisco perché dovrei essere io a confortare il prossimo.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725200
    m_Localized: Non ti piacerebbe sentirtelo dire, almeno una volta?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725201
    m_Localized: 'Tough: È quello che dico anch''io.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725202
    m_Localized: 'Tough: Certe persone devi tenerle per mano, devi pulirgli il culo, servirle e riverirle.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725203
    m_Localized: 'Tough: E poi, quando viene il momento di agire, soccombono.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725204
    m_Localized: 'Tough: Crollano come un castello di carte, trascinando gli altri nel baratro.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725205
    m_Localized: 'Tough: "Tutto si aggiusterà" non risolve il problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725206
    m_Localized: 'Tough: Ci sono già passata, e mi è bastato.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725207
    m_Localized: 'Tough: Non c''è più spazio per la debolezza.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725208
    m_Localized: 'Tough: Forse sono troppo severa. Il ricordo è ancora fresco.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725209
    m_Localized: 'Tough: Riparliamone un''altra volta, d''accordo?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725210
    m_Localized: 'Tough: Cosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725211
    m_Localized: 'Tough: E a che scopo?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725212
    m_Localized: 'Tough: Le belle parole non servono a niente. Possono resuscitare i morti? Spingere uno stupratore a tagliarsi le palle?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725213
    m_Localized: 'Tough: Io ho un coltello, ma non indoro la pillola.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725214
    m_Localized: 'Tough: Dobbiamo adattarci al nuovo mondo, o moriremo. Tutto il resto sono sciocchezze.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725215
    m_Localized: 'Tough: Non volevo assalirti. Ma non uscirtene più con certe domande idiote.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725216
    m_Localized: 'Tough: Niente è mai facile. Niente di niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725217
    m_Localized: Allora... cosa hai lì?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725218
    m_Localized: 'Tough: Voglio essere schietta con te.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725219
    m_Localized: 'Tough: Ho visto come fissi quella scatola nel ripostiglio. Come resti immobile accanto alla finestra.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725220
    m_Localized: 'Tough: Ieri ho dato una sbirciatina. Questa casa è la tua trappola.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725221
    m_Localized: 'Tough: Non combatti per sopravvivere. Hai solo paura di morire.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725222
    m_Localized: 'Tough: Dico bene?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725223
    m_Localized: No.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725224
    m_Localized: Ma sparisci.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725225
    m_Localized: 'Tough: Stronzate.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725226
    m_Localized: 'Tough: Ho visto come ti sei irrigidito.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725227
    m_Localized: 'Tough: L''unica cosa che ti frena dal farla finita è la paura.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725228
    m_Localized: 'Tough: Pensavo che fossi sopravvissuto all''inferno, che tutta la merda che hai dovuto ingoiare ti avesse forgiato.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725229
    m_Localized: 'Tough: Invece... sei solo un''altra anima spaurita che è riuscita miracolosamente a schivare il peggio.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725230
    m_Localized: 'Tough: Sono... delusa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725231
    m_Localized: 'Tough: Non voglio più parlarti.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725232
    m_Localized: 'Tough: Mi ricordi uno scolaretto innocente, circondato dai bulli.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725233
    m_Localized: 'Tough: Mi stai dando ragione. Sei solo un debole che è riuscito a procurarsi un fucile.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725234
    m_Localized: 'Tough: Tutto qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725235
    m_Localized: 'Tough: Pensavo che fossi sopravvissuto all''inferno, che tutta la merda che hai dovuto ingoiare ti avesse forgiato.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725236
    m_Localized: 'Tough: Invece... sei solo un''altra anima spaurita che è riuscita miracolosamente a schivare il peggio.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725237
    m_Localized: 'Tough: Sono... delusa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725238
    m_Localized: 'Tough: Non voglio più parlarti.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725239
    m_Localized: 'Tough: Niente è mai facile. Niente di niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725240
    m_Localized: Sei andata a ficcare il naso da qualche altra parte?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725241
    m_Localized: 'Tough: L''ho fatto perché sono disposta a tutto per sopravvivere.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725242
    m_Localized: 'Tough: Dovevo capire con chi ho a che fare. A cosa dovrei stare attenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725243
    m_Localized: 'Tough: Questo posto è intriso di ricordi. Una famiglia morta.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725244
    m_Localized: 'Tough: Mi ha fatto comprendere... che non riesci ad abbandonare il passato.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725245
    m_Localized: 'Tough: Ma non sono affari miei.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725246
    m_Localized: 'Tough: È che...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725247
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725248
    m_Localized: 'Tough: Un tempo ero più tenera. Più giovane. Poi un giorno ho incontrato un tizio.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725249
    m_Localized: 'Tough: Mi ha detto che dovevamo passare da casa sua, per portare non so cosa a sua madre. Io non volevo andarci.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725250
    m_Localized: 'Tough: Sono rimasta fuori ad aspettare, ma dopo un po'' mi ha urlato dalla finestra di entrare.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725251
    m_Localized: 'Tough: L''ho fatto. Non c''era nessuna madre. Solo lui e il suo amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725252
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725253
    m_Localized: 'Tough: Beh, quando il mondo è precipitato nel caos, li ho trovati.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725254
    m_Localized: 'Tough: Non mi ha fatto stare meglio. Niente affatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725255
    m_Localized: 'Tough: Per molto tempo mi sono sentita sporca. Uno sporco che non potevo lavare via... Poi il mondo è finito.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725256
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725257
    m_Localized: 'Tough: Bastardi del genere non meritano pietà. E nemmeno i deboli. Sono loro complici.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725258
    m_Localized: 'Tough: Non mi impiccerò più delle tue cose. Ma penso che ci siamo capiti.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725259
    m_Localized: 'Bald: 1, 2, 3, 4... E se bruciassi tutto? Ah ah, scherzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725260
    m_Localized: Cosa è successo con i tuoi amici?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725261
    m_Localized: 'Bald: Ah ah! Ci siamo conosciuti a scuola di teatro.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725262
    m_Localized: 'Bald: Io ho una laurea in produzione teatrale. E lasciamelo dire, amico mio, non la consiglierei a nessuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725263
    m_Localized: 'Bald: Ma nemmeno il teatro in generale, onestamente. Dall''esterno può sembrare un ambiente di classe, ma ormai è una causa persa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725264
    m_Localized: 'Bald: Per carità, se ti ci dedichi "nel nome dell''arte" e accetti la prospettiva di essere perennemente al verde, accomodati.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725265
    m_Localized: 'Bald: Certo, esistono compagnie prestigiose che si esibiscono in teatri famosi, ma sono un''eccezione.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725266
    m_Localized: 'Bald: Tutto il resto è roba a basso costo. E la gente preferisce andare al cinema. È più economico, più coinvolgente e più comodo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725267
    m_Localized: 'Bald: Sì, è una lunga sfilza di delusioni, amico mio.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725268
    m_Localized: 'Bald: 1, 2, 3, 4... E se bruciassi tutto? Ah ah, scherzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725269
    m_Localized: Ok, il teatro fa schifo, ma cosa mi dici dei tuoi amici?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725270
    m_Localized: 'Bald: Oh, giusto, ho lasciato la storia a metà. Scusa, tendo a divagare. È difficile concentrarsi su una cosa sola. Allora...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725271
    m_Localized: 'Bald: I miei amici erano tutti attori, produttori, ingegneri del suono, tecnici delle luci. Venivamo dallo stesso ambiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725272
    m_Localized: 'Bald: Ci davamo alla pazza gioia. Io affittavo interi palchi per i miei compleanni... e accorrevano in centinaia!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725273
    m_Localized: 'Bald: Era uno sballo! Immagina cento persone che vengono a festeggiarti! Ah, erano bei tempi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725274
    m_Localized: 'Bald: Ma l''ambiente del teatro è terribilmente ostile. Tutti cercano di fregarsi a vicenda. I soldi scarseggiano e lo stress non perdona.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725275
    m_Localized: 'Bald: Quelle feste non sono durate a lungo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725276
    m_Localized: 'Bald: Allora mi sono accorto che la maggior parte degli invitati ai miei compleanni non erano veri amici... Erano giusto... di passaggio.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725277
    m_Localized: 'Bald: Mi sfruttavano quando gli faceva comodo, o sparlavano di me alle mie spalle.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725278
    m_Localized: 'Bald: Ma ehi, non fraintendermi! Mi sono seduto e ho stilato una lista, gli altri li ho mandati al diavolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725279
    m_Localized: 'Bald: 1, 2, 3, 4... E se bruciassi tutto? Ah ah, scherzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725280
    m_Localized: E dove sono gli amici di quella lista?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725281
    m_Localized: 'Bald: Quando è iniziato il disastro degli esattori, sono andato in cerca di aiuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725282
    m_Localized: 'Bald: Ma proprio allora il sole ha iniziato a friggere il prossimo e sono spuntati i Visitatori. E la situazione è precipitata.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725283
    m_Localized: 'Bald: Così ho fatto il giro degli amici.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725284
    m_Localized: 'Bald: Uno è morto bruciato. Era sbronzo marcio e l''alba lo ha sorpreso mentre dormiva in un parco giochi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725285
    m_Localized: 'Bald: Un altro è stato ucciso. L''hanno scambiato per un Visitatore, ti rendi conto?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725286
    m_Localized: 'Bald: È assurdo! Quei cosiddetti "segni" sono solo stronzate! Hanno ammazzato i miei amici senza motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725287
    m_Localized: 'Bald: Questa storia mi manda in bestia... e non ho idea di come potermi sfogare, cazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725288
    m_Localized: 'Bald: La collera e l''impotenza ti pietrificano. Finisci per odiare chiunque ti stia vicino. E te stesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725289
    m_Localized: 'Bald: Fanculo... Porci schifosi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725290
    m_Localized: 'Bald: 1, 2, 3, 4... E se bruciassi tutto? Ah ah, scherzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725291
    m_Localized: Che è successo con gli esattori?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725292
    m_Localized: 'Bald: Vivevo con mia madre e mia nonna.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725293
    m_Localized: 'Bald: Mio padre ci aveva piantati. Attore anche lui, ubriacone e infedele. Un classico teatrale, no? Mamma era una costumista.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725294
    m_Localized: 'Bald: Mi ha sempre protetto, ma crescendo ho scoperto la verità: stavamo affogando in un mare di debiti.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725295
    m_Localized: 'Bald: Lei non riusciva a trovare lavoro. I grandi teatri erano fuori questione, mentre i piccoli pagavano poco o niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725296
    m_Localized: 'Bald: Così, per non farci morire di fame, finì per chiedere un prestito a una qualche società privata.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725297
    m_Localized: 'Bald: Ovviamente, non riuscì a restituire il denaro, quindi iniziarono a presentarsi gli esattori.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725298
    m_Localized: 'Bald: Ricordo che avevamo una regola ferrea: mai aprire la porta agli sconosciuti.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725299
    m_Localized: 'Bald: E se tornando a casa vedevamo dei tizi appostati? Dovevamo continuare a camminare, per ore.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725300
    m_Localized: 'Bald: Che cazzo di situazione...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725301
    m_Localized: 'Bald: Poi è scoppiato questo macello e la gente si è incattivita. Per non parlare di quei dannati strozzini.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725302
    m_Localized: 'Bald: Una volta, tornando a casa, trovai la porta sfondata. Tutto distrutto... Mamma e nonna con gli arti spezzati.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725303
    m_Localized: 'Bald: Merda... Un vero incubo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725304
    m_Localized: 'Bald: A quel punto apparvero due tizi enormi...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725305
    m_Localized: 'Bald: E io scappai. Ovviamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725306
    m_Localized: 'Bald: Ero terrorizzato.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725307
    m_Localized: 'Bald: Cazzo, mi faccio schifo! Per non averle protette. Per essere fuggito come un codardo. Per non essere più tornato.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725308
    m_Localized: 'Bald: Ma avevo troppa paura.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725309
    m_Localized: 'Bald: Così tanta da pensare solo a me stesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725310
    m_Localized: 'Bald: È tutto così orribile, cazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725311
    m_Localized: 'Nervous: Non voglio tornare lì, ih ih...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725312
    m_Localized: Sei... un tipo strano.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725313
    m_Localized: 'Nervous: Ah, sì? E a te che te ne frega? Eh? Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725314
    m_Localized: 'Nervous: Mi stai addosso pure tu? Eh? Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725315
    m_Localized: 'Nervous: Non mi piace, sai? Non dopo essere stato in quella... gabbia di matti.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725316
    m_Localized: 'Nervous: I miei vecchi mi hanno chiuso in un covo di svitati, pensa te... Ih ih!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725317
    m_Localized: 'Nervous: Già, dicevano che stavo p... perseguitando qualcuno. E allora?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725318
    m_Localized: 'Nervous: Non ho fatto niente di male, ih ih...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725319
    m_Localized: 'Nervous: Ma per i miei ero suooonato... Magari lo pensano ancora.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725320
    m_Localized: 'Nervous: Cioè, mi hanno rinchiuso per dieci anni. Nemmeno fossi uno psicopatico o che ne so, ih ih!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725321
    m_Localized: 'Nervous: Tutto per... quella volta...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725322
    m_Localized: 'Nervous: Ah, lascia stare. Devo chiamare l''hotel. Drin drin drin!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725323
    m_Localized: 'Nervous: Non voglio tornare lì, ih ih...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725324
    m_Localized: A cosa ti riferivi prima?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725325
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725326
    m_Localized: 'Nervous: A scuola ce l''avevano con me. Non mi mollavano mai, dispetti ogni giorno. Botte, tante botte...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725327
    m_Localized: 'Nervous: Ovvio che sono andato fuori di testa. Non sono un pupazzo, un sacco di carne da picchiare finché non urla...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725328
    m_Localized: 'Nervous: Ho reagito, sono caduti... e basta. Ho sentito che uno era all''os... pedale. Morto.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725329
    m_Localized: 'Nervous: Non volevo ucciderlo, eh! Ma insomma... i miei hanno sistemato tutto, in qualche modo. Ih ih...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725330
    m_Localized: 'Nervous: Eppure, continuano a bisbigliare il mio nome... Li senti anche tu? Sssh...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725331
    m_Localized: 'Nervous: Così mi hanno sbattuto con gli svalvolati. E sono finito punto e a capo!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725332
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725333
    m_Localized: 'Nervous: Quella volta... mi è piaciuto... Il po...tere... La ven...detta...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725334
    m_Localized: 'Nervous: Che delizia, quel dolore alle nocche. Che sapore, quel rosso sulle labbra, sulla lingua... Mmm...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725335
    m_Localized: 'Nervous: Mi hanno cacciato. Ma io mi ero solo difeso, ih ih.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725336
    m_Localized: 'Nervous: Non voglio tornare lì, ih ih...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725337
    m_Localized: Il manicomio non ti è servito a niente.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725338
    m_Localized: 'Nervous: No‑no... Neanche un pochettino, ih ih.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725339
    m_Localized: 'Nervous: Quando le pillole ti riducono a un vegetale... non ti resta che bollire!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725340
    m_Localized: 'Nervous: Non sono guarito. Non è cambiato niente. Dieci anni e sono ancora io! Ta‑dah!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725341
    m_Localized: 'Nervous: E tutto per quel peccatuccio, quando...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725342
    m_Localized: 'Nervous: Ih ih ih ih ih ih...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725343
    m_Localized: 'Nervous: Uff, a te non capita mai di sbagliare?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725344
    m_Localized: 'Nervous: Oh, signor perfettino, perché mi fissi così?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725345
    m_Localized: 'Nervous: Vuoi picchiarmi? Dai! Cosa aspetti?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725346
    m_Localized: 'Nervous: Spaccami la faccia, spezzami le dita! Fammi sentire di nuovo quel brivido, forza! SÌ!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725347
    m_Localized: 'Nervous: Che c''è? Non mi picchi? Non ne hai voglia?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725348
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725349
    m_Localized: 'Nervous: Ih ih... Allora resterò qui ad aspettare.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725350
    m_Localized: 'Nervous: In effetti... qui si sta più tranquilli che all''hotel.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725351
    m_Localized: 'Nervous: Grazie per avermi fatto entrare. Ih ih...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725352
    m_Localized: 'Nervous: Almeno qui siamo tutti pazzi...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725353
    m_Localized: 'Leper: Sì? Che c''è?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725354
    m_Localized: È difficile vivere con il tuo aspetto?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725355
    m_Localized: 'Leper: Insomma. Ci avevo fatto l''abitudine.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725356
    m_Localized: 'Leper: Quando andavo a scuola... ero "il lebbroso". Nessuno si avvicinava, avevano paura che li infettassi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725357
    m_Localized: 'Leper: Speravo che crescendo avrebbero smesso, e così è stato... più o meno. Certo, mi fissavano ancora, ma pazienza.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725358
    m_Localized: 'Leper: I veri guai sono arrivati con il Cataclisma. Tutti quei vecchi pregiudizi sono tornati a galla.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725359
    m_Localized: 'Leper: Solo che adesso è peggio, perché rischio di restarci secco.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725360
    m_Localized: 'Leper: Dato che, con questa pelle, mi scambiano per un Visitatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725361
    m_Localized: 'Leper: Che ci vuoi fare? Di questi tempi, la gente fa più schifo del solito.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725362
    m_Localized: 'Leper: Sì? Che c''è?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725363
    m_Localized: Ti considerano un Visitatore per via della tua pelle?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725364
    m_Localized: 'Leper: Certo. Ti sembra strano?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725365
    m_Localized: 'Leper: Hanno scatenato una caccia alle streghe in piena regola.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725366
    m_Localized: 'Leper: Chi non sembra "normale" è una preda. E la FEMA è giudice, giuria e boia.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725367
    m_Localized: 'Leper: Inizio a pensare che siano loro i veri responsabili di tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725368
    m_Localized: 'Leper: E se i Visitatori fossero solo una loro invenzione? Tu che ne pensi?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725369
    m_Localized: Potresti aver ragione.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725370
    m_Localized: Credo che i Visitatori siano reali.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725371
    m_Localized: 'Leper: Già, proprio così. Visitatori un cazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725372
    m_Localized: 'Leper: Sembra più la trama di un brutto film.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725373
    m_Localized: 'Leper: Magari vogliono solo rovesciare il governo. La paura genera potere, giusto?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725374
    m_Localized: 'Leper: Ecco perché rinchiudono i loro oppositori in quelle "zone di quarantena".'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725375
    m_Localized: 'Leper: Mascherano le epurazioni con la scusa che stanno combattendo i Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725376
    m_Localized: 'Leper: Comunque, Visitatori o no, preferirei non finire nel mirino della FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725377
    m_Localized: 'Leper: Temo che se mi catturassero, passerei un brutto quarto d''ora.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725378
    m_Localized: 'Leper: Sul serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725379
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725380
    m_Localized: 'Leper: Anche se fosse così, non trovi che la FEMA si stia comportando in modo strano?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725381
    m_Localized: 'Leper: Dicono che i Visitatori siano un virus, allora perché non spiegano mai come avviene il contagio?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725382
    m_Localized: 'Leper: Se volessero davvero fermarli, non sarebbe questa la prima informazione da rivelare?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919488
    m_Localized: 'Leper: Non lo so... Magari stanno cercando un qualche tipo di cura.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919489
    m_Localized: 'Leper: Ma ho un brutto presentimento... Se dovessi finire in quarantena, per me sarebbe la fine.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919490
    m_Localized: 'Leper: Sì? Che c''è?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919491
    m_Localized: Perché pensi che la FEMA ti farà del male?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919492
    m_Localized: 'Leper: Perché ai loro occhi non sono un uomo, ma solo una dannata patologia.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919493
    m_Localized: 'Leper: È come se avessi un bersaglio sulla schiena. Finirei dritto sotto i ferri per i loro... esperimenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919494
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919495
    m_Localized: 'Leper: Solo per questa fottuta pelle...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919496
    m_Localized: Finché rimani qui, non hai nulla da temere.
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919497
    m_Localized: Non credi di esagerare?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919498
    m_Localized: 'Leper: Dici? Probabilmente perché non sono ancora venuti a bussare alla tua porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919499
    m_Localized: 'Leper: Credi che passerei inosservato con questa faccia?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919500
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919501
    m_Localized: 'Leper: Ah, sì? Hai mai sentito parlare dell''incendio all''asilo?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919502
    m_Localized: 'Leper: Quello dove dei genitori hanno bruciato vivi i propri figli?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919503
    m_Localized: 'Leper: Ancora non l''hai capito? Siamo tornati al Medioevo! La follia dilaga come una cancrena e la FEMA ci sguazza dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919504
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919505
    m_Localized: 'Leper: Vorrei solo che la gente smettesse di giudicare gli altri in base all''aspetto...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919506
    m_Localized: 'Leper: Ma il fatto è che se anche passassero millenni, l''umanità continuerà ad appiccicare etichette agli altri.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919507
    m_Localized: 'Leper: Perché così è più facile decidere chi può esistere... e chi è di troppo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919508
    m_Localized: 'Leper: È a causa di questa meschinità che le persone come me continuano a soffrire.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919509
    m_Localized: 'Leper: È tutto così... triste, se ci pensi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891008
    m_Localized: 'Fairytaller: Ti serve qualcosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891009
    m_Localized: Sembri perso nei tuoi pensieri.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891010
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891011
    m_Localized: Consegna un mandato FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891012
    m_Localized: 'Fairytaller: Ricordavo una storia di quando ero bambino. Alcuni ciuffolotti vivevano in una foresta incantata...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891013
    m_Localized: 'Fairytaller: Poi arrivò un drago... e bruciò tutto. I nidi, gli uccelli... ogni cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891014
    m_Localized: 'Fairytaller: Se ci pensi, erano creature simili. Volavano e vivevano nello stesso cielo, condividendo i doni della foresta.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891015
    m_Localized: 'Fairytaller: Ma il potere aveva corrotto la mente del drago. Bruciò persino ciò che forse, un tempo, aveva amato.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891016
    m_Localized: 'Fairytaller: Mio padre raccontava sempre che c''è un drago addormentato in ognuno di noi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891017
    m_Localized: 'Fairytaller: Io e mia sorella ci ridevamo su. "I draghi sono enormi", dicevamo, "mentre le persone sono così piccole".'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891018
    m_Localized: 'Fairytaller: Poi sono cresciuto e ho capito cosa intendesse. Peccato che lui non lo saprà mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891019
    m_Localized: 'Fairytaller: Ogni tanto mi domando... saprò abbattere il mio drago, o finirò divorato dalla tentazione?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891020
    m_Localized: 'Fairytaller: Ti serve qualcosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891021
    m_Localized: Stai pensando ancora alle tue favole?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891022
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891023
    m_Localized: Consegna un mandato FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891024
    m_Localized: 'Fairytaller: Sì, mi è tornata in mente la fiaba della Città di ghiaccio, con le sue mura imponenti e le torri gelate.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891025
    m_Localized: 'Fairytaller: I suoi abitanti avevano sempre vissuto nella diffidenza reciproca. Sembrava che nulla sarebbe mai cambiato.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891026
    m_Localized: 'Fairytaller: Finché giunse un soffiatore di vetro che, poco a poco, iniziò a trasformare quel luogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891027
    m_Localized: 'Fairytaller: Ogni giorno, illuminava le strade con le sue lanterne e non perdeva mai l''occasione di essere gentile.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891028
    m_Localized: 'Fairytaller: All''inizio la gente lo derideva, ma con il passare del tempo il gelo nei loro cuori iniziò a sciogliersi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891029
    m_Localized: 'Fairytaller: Non si cambia il mondo in una notte. La vera svolta deve iniziare da dentro di noi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891030
    m_Localized: 'Fairytaller: Tieni accesa la tua lanterna, anche se il mondo intero è immerso nelle tenebre.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891031
    m_Localized: 'Fairytaller: Mia madre sosteneva che la morale era semplice: se aspetti il cambiamento, morirai nell''attesa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891032
    m_Localized: 'Fairytaller: Siamo noi a mantenere in vita questo mondo. Se smettiamo di lottare, allora abbiamo già perso.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891033
    m_Localized: 'Fairytaller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891034
    m_Localized: 'Fairytaller: Cerco di essere gentile, di restare umano, nonostante il dolore. Spero che possa servire da esempio per gli altri.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891035
    m_Localized: 'Fairytaller: Ti serve qualcosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891036
    m_Localized: Che favola hai per me oggi?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891037
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891038
    m_Localized: Consegna un mandato FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891039
    m_Localized: 'Fairytaller: Ho ancora molte storie da raccontare... Di morti che risorgono e di sopravvissuti che resistono...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891040
    m_Localized: 'Fairytaller: Di un demone dalle sembianze umane che bussa a ogni porta... e continua a porre domande fino all''alba.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891041
    m_Localized: 'Fairytaller: Da quando l''ira del sole cremisi ha colpito l''umanità, avvelenando i campi e prosciugando i fiumi...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891042
    m_Localized: 'Fairytaller: Ma un''anima eroica, o un pugno di audaci, troverà infine il modo per salvare il mondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891043
    m_Localized: 'Fairytaller: Il bene vince sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891044
    m_Localized: 'Fairytaller: Voglio credere che ne usciremo. Che verrà un giorno, un istante in cui quest''incubo svanirà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891045
    m_Localized: 'Fairytaller: Rivedremo le nostre famiglie, e potremo tornare a vivere come più ci aggrada...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891046
    m_Localized: 'Fairytaller: Scusa, mi sono lasciato trasportare. Credo di aver bisogno di restare solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891047
    m_Localized: 'FunnyGuy: Potremmo vivere così spensierati!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891048
    m_Localized: Cosa ti fa credere che dimenticheranno il tuo prestito?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891049
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891050
    m_Localized: Consegna un mandato FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891051
    m_Localized: 'FunnyGuy: Stai dicendo sul serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891052
    m_Localized: 'FunnyGuy: Amico, è la fine del mondo! Ti pare che esistano ancora banche o l''economia?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891053
    m_Localized: 'FunnyGuy: A nessuno frega più nulla. E ho le prove!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891054
    m_Localized: 'FunnyGuy: Di solito, quando saltavo una rata, arrivavano avvisi, lettere, minacce e tutto il carrozzone.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891055
    m_Localized: 'FunnyGuy: Adesso, invece? Nulla, silenzio assoluto. Un paradiso!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891056
    m_Localized: 'FunnyGuy: Cosa se ne fanno di un elenco di debitori rintracciabili solo dopo il tramonto?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891057
    m_Localized: 'FunnyGuy: Certo, ormai nessuno ti concede più un prestito. Ci ho già provato!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891058
    m_Localized: 'FunnyGuy: Ma sai cosa? Essere liberi dalla schiavitù del denaro è già di per sé una vittoria!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891059
    m_Localized: Non ne sarei troppo sicuro, fossi in te.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891060
    m_Localized: Allora, vogliamo festeggiare o no?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891061
    m_Localized: 'FunnyGuy: Oh, andiamo!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891062
    m_Localized: 'FunnyGuy: Perché dovrei preoccuparmi? Ormai non gli interesso più, saranno tutti rintanati in qualche bunker.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891063
    m_Localized: 'FunnyGuy: Chi vuoi che si scomodi per venire a cercare un bifolco come me?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891064
    m_Localized: Allora perché non te torni a casa tua?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891065
    m_Localized: Quindi sei venuto qui solo per darti delle arie?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891066
    m_Localized: 'FunnyGuy: Ovvio!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891067
    m_Localized: 'FunnyGuy: Sono al settimo cielo e mi andava di fare due chiacchiere!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891068
    m_Localized: Allora perché non te torni a casa tua?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891069
    m_Localized: Quindi sei venuto qui solo per darti delle arie?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891070
    m_Localized: 'FunnyGuy: Beh...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891071
    m_Localized: 'FunnyGuy: La stavo affittando. Lo è ancora, tecnicamente, ma ormai i soldi non valgono nulla.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891072
    m_Localized: 'FunnyGuy: Ti basta andare in giro, rompere una finestra e prendere ciò che vuoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862528
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862529
    m_Localized: 'FunnyGuy: Ehi, che c''è? Vuoi farmi la morale?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862530
    m_Localized: Non hai risposto alla mia domanda.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862531
    m_Localized: In effetti, non me ne frega niente.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862532
    m_Localized: 'FunnyGuy: Dai, amico, non c''è bisogno di innervosirti. Non ho detto nulla di male.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862533
    m_Localized: 'FunnyGuy: Potevi scherzarci su senza diventare acido, santo cielo...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862534
    m_Localized: 'FunnyGuy: Mi hai smontato, proprio sul più bello.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862535
    m_Localized: Non hai risposto alla mia domanda.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862536
    m_Localized: In effetti, non me ne frega niente.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862537
    m_Localized: 'FunnyGuy: Sì, sì...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862538
    m_Localized: 'FunnyGuy: Senti...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862539
    m_Localized: 'FunnyGuy: Non sto cercando di fare il vago. È solo che... ho paura, ok? Non voglio tornarci.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862540
    m_Localized: 'FunnyGuy: L''avevo affittata a una coppia. Grazie a loro riuscivo a stare dietro alle rate del mutuo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862541
    m_Localized: 'FunnyGuy: E, beh... non so se siano più... degli esseri umani.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862542
    m_Localized: 'FunnyGuy: I vicini mi hanno fatto una testa così. Parlano di urla, forti rumori e gente che va e viene.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862543
    m_Localized: 'FunnyGuy: Certo, i miei vicini sono dei vecchi pettegoli e ansiosi che amano farmi saltare i nervi, ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862544
    m_Localized: 'FunnyGuy: Se stessero dicendo la verità?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862545
    m_Localized: 'FunnyGuy: Aspetta, lasciami finire.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862546
    m_Localized: 'FunnyGuy: Ho bisogno di dirlo a qualcuno. Questa situazione mi sta mandando fuori di testa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862547
    m_Localized: 'FunnyGuy: Ho comprato casa e ora ho troppa paura per andarci a vivere.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862548
    m_Localized: 'FunnyGuy: L''ho affittata a una famiglia e usavo quei soldi per pagare le rate del mutuo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862549
    m_Localized: 'FunnyGuy: Ma ora... merda, persino l''idea di suonare al campanello mi terrorizza...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862550
    m_Localized: 'FunnyGuy: I vicini dicono che stanno succedendo cose strane. E non li vedono mai uscire.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862551
    m_Localized: 'FunnyGuy: Ok, magari il mutuo non è più un problema... ma col cazzo che vado lì a dargli lo sfratto!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862552
    m_Localized: 'FunnyGuy: Potremmo vivere così spensierati!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862553
    m_Localized: Novità sui tuoi inquilini?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862554
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862555
    m_Localized: Consegna un mandato FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862556
    m_Localized: 'FunnyGuy: Eh? Oh, loro? Ho altro per la testa, al momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862557
    m_Localized: 'FunnyGuy: Ho chiamato i miei vicini stasera, spero non ti dispiaccia.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862558
    m_Localized: 'FunnyGuy: Hanno detto che sono passati quelli della banca. Chiedevano dei miei versamenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862559
    m_Localized: 'FunnyGuy: Meno male che non abito più lì. Però...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862560
    m_Localized: 'FunnyGuy: Quei bastardi continuano a cercarmi anche con il sole che sta per esplodere?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862561
    m_Localized: 'FunnyGuy: Roba da matti, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862562
    m_Localized: 'FunnyGuy: Quelli sarebbero capaci di resuscitare i loro debitori, pur di farsi pagare.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862563
    m_Localized: 'FunnyGuy: Ma dico io, non hanno di meglio da fare che rincorrere la gente? Dovrebbero pensare a salvarsi la pelle!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862564
    m_Localized: 'FunnyGuy: Brutti stronzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862565
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862566
    m_Localized: 'FunnyGuy: Beh, per ora credo che mi accamperò qui. E dopo... boh, potrei andare a stare dai miei.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862567
    m_Localized: 'FunnyGuy: Più siamo, meglio è, giusto?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862568
    m_Localized: 'FunnyGuy: Comunque è incredibile, cazzo... Va tutto in malora e quei merdosi pensano ancora a riempirsi le tasche?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862569
    m_Localized: 'FunnyGuy: Che Dio li maledica...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862570
    m_Localized: 'FunnyGuy: Potremmo vivere così spensierati!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862571
    m_Localized: Stai tornando al tuo appartamento?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862572
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862573
    m_Localized: Consegna un mandato FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862574
    m_Localized: 'FunnyGuy: È un gran casino. Un dannato disastro...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862575
    m_Localized: 'FunnyGuy: Scusa, ho usato di nuovo il tuo telefono. Dovevo sentire la banca.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862576
    m_Localized: 'FunnyGuy: Mi hanno congelato i conti. Tutti i miei risparmi, spariti!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862577
    m_Localized: 'FunnyGuy: Non posso più ritirare un centesimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862578
    m_Localized: 'FunnyGuy: Colpa del debito, dicono, ma è una balla. Gli sarebbe bastato trattenere la rata mensile del mutuo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862579
    m_Localized: 'FunnyGuy: Che bisogno c''era di bloccarmi tutto, me lo spieghi?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862580
    m_Localized: 'FunnyGuy: Scommetto che l''hanno fatto per finanziare i "progetti" della FEMA. Personale, esperimenti e roba simile.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862581
    m_Localized: 'FunnyGuy: Beh, che si fottano. Hanno finito di dissanguarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862582
    m_Localized: 'FunnyGuy: Se non ti dispiace, vorrei rimanere qui. Mi sentirei un verme a tornare dai miei adesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862583
    m_Localized: 'FunnyGuy: E il mio appartamento ormai sarà diventato un covo di Visitatori o un laboratorio della FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862584
    m_Localized: 'Alt: Ogni giorno è più dura...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862585
    m_Localized: Hai fatto un bel discorso fuori dalla porta.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862586
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862587
    m_Localized: Consegna un mandato FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862588
    m_Localized: 'Alt: Ah, l''hai notato.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862589
    m_Localized: 'Alt: Deformazione professionale, immagino. Parlo a vanvera, soprattutto quando ho i nervi a fior di pelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862590
    m_Localized: 'Alt: Sento sempre il bisogno di risolvere tutto, di far quadrare i conti. Di indorare più possibile la pillola.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862591
    m_Localized: 'Alt: Io... ero una conduttrice radiofonica.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862592
    m_Localized: Ma davvero?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862593
    m_Localized: Non l'avrei mai detto.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862594
    m_Localized: 'Alt: Cioè?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862595
    m_Localized: 'Alt: Poco importa se mi credi. Il punto è che restare lì era fuori discussione.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862596
    m_Localized: 'Alt: Ormai è un manicomio. In onda ci sono solo sciacalli che cercano di rifilarti robaccia. A peso d''oro, tra l''altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862597
    m_Localized: 'Alt: "Un unguento prodigioso per i vostri mali!". "Mettete un bicchiere d''acqua vicino alla radio, assorbirà le radiazioni!".'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862598
    m_Localized: 'Alt: E non ha fatto altro che peggiorare.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862599
    m_Localized: 'Alt: Non sopportavo più di farne parte. Avevo raggiunto il limite.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862600
    m_Localized: 'Alt: Ah, per non parlare dei notiziari! Continuavo a chiedermi come diavolo facessimo a essere ancora vivi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862601
    m_Localized: 'Alt: Perché, come te li immaginavi quelli che lavorano in radio? Un mucchio di professori in giacca e cravatta?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862602
    m_Localized: 'Alt: Hai la testa piena di luoghi comuni. Problema tuo, non mio.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862603
    m_Localized: 'Alt: Sai, sognavo di parlare con visitatori interessanti... Gli ospiti in studio, dico, non quelli che circolano ora.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862604
    m_Localized: 'Alt: Invece sfornavo solo necrologi. A un certo punto, resistere alla tentazione di farla finita era diventata un''impresa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862605
    m_Localized: 'Alt: Poi c''erano quegli imbecilli che vendevano fumo, disposti a tutto pur di prendersi il microfono.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862606
    m_Localized: 'Alt: La radio era diventata un circo, e io guidavo l''auto dei pagliacci.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862607
    m_Localized: 'Alt: Ogni giorno è più dura...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862608
    m_Localized: Quindi ti sei stancata e hai tagliato la corda?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862609
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862610
    m_Localized: Consegna un mandato FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862611
    m_Localized: 'Alt: Beh... Per farla breve, è andata così.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862612
    m_Localized: 'Alt: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862613
    m_Localized: 'Alt: Vuoi sapere cosa mi ha fatto crollare? L''ennesima diretta con un pazzo scatenato.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862614
    m_Localized: 'Alt: Ci avevano detto che un "esperto" sarebbe intervenuto dal vivo a parlarci dei Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862615
    m_Localized: 'Alt: Giurava di poterli sconfiggere... con un barattolo pieno di fuffa costosissima che neanche ricordo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862616
    m_Localized: 'Alt: Aveva persino pagato in anticipo per la diretta.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862617
    m_Localized: 'Alt: Ho passato una settimana a spulciare tra le sue malefatte. Volevo smascherarlo e farlo a pezzi davanti a tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862618
    m_Localized: 'Alt: Sarebbe stata una trasmissione epocale...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862619
    m_Localized: 'Alt: Ma non se ne fece nulla. E sai perché?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862620
    m_Localized: 'Alt: Scappò dopo che qualcuno gli aveva sottratto tutti i documenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862621
    m_Localized: 'Alt: Una montagna di dati, cazzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862622
    m_Localized: 'Alt: Ma si può essere così idioti?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862623
    m_Localized: 'Alt: Il mio piano andò a farsi benedire. Le mie ricerche? Inutili. Si è dileguato e non l''abbiamo più sentito.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862624
    m_Localized: 'Alt: Bastardo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862625
    m_Localized: 'Alt: Ogni giorno è più dura...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862626
    m_Localized: Quindi hai chiuso con il giornalismo?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862627
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862628
    m_Localized: Consegna un mandato FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862629
    m_Localized: 'Alt: Ormai il mio unico obiettivo era sopravvivere.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862630
    m_Localized: 'Alt: Passavo di nascosto da un ufficio all''altro, soprattutto quando iniziarono le tempeste solari.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862631
    m_Localized: 'Alt: Ma ormai era evidente, il mondo stava colando a picco.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862632
    m_Localized: 'Alt: I rapporti giornalieri della polizia erano la nostra fonte principale per i notiziari.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862633
    m_Localized: 'Alt: A un certo punto, quei rapporti iniziarono a tardare.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862634
    m_Localized: 'Alt: Notai anche un cambio di stile. Se leggi la stessa roba ogni giorno, ti accorgi subito di ogni minima variazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862635
    m_Localized: 'Alt: Sembravano... inventati.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862636
    m_Localized: 'Alt: Fu allora che decisi di andarmene. Dovevo stare lontana dalle città.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862637
    m_Localized: 'Alt: Pensai fosse meglio vivere isolata. Volevo rifugiarmi nei boschi, ma di questi tempi non è una buona idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862638
    m_Localized: 'Alt: Vivere è diventato... così faticoso.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862639
    m_Localized: 'Tourist: Se solo potessi andarmene da questo posto...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862640
    m_Localized: Dove stavi cercando di andare?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862641
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862642
    m_Localized: Consegna un mandato FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862643
    m_Localized: 'Tourist: A che serve parlarne? Tanto non tornerò mai più a casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862644
    m_Localized: 'Tourist: Al diavolo il sole! E al diavolo questi maledetti Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862645
    m_Localized: 'Tourist: Sta succedendo solo qui? O è così dappertutto?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862646
    m_Localized: 'Tourist: Era da tanto che pianificavo questo viaggio...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862647
    m_Localized: 'Tourist: Ho messo i soldi da parte, ho implorato per avere le ferie...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862648
    m_Localized: 'Tourist: E per cosa? La mia vacanza è finita prima ancora di cominciare.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862649
    m_Localized: 'Tourist: Se solo potessi andarmene da questo posto...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862650
    m_Localized: Perché non sei partito prima?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862651
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862652
    m_Localized: Consegna un mandato FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862653
    m_Localized: 'Tourist: Te l''ho detto, ho avuto un mucchio di imprevisti. Un problema dietro l''altro...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862654
    m_Localized: 'Tourist: Oltretutto, credevo che questo fosse il momento ideale per partire.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862655
    m_Localized: 'Tourist: Volevo solo godermi il sole sulla pelle...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862656
    m_Localized: 'Tourist: Se avessi saputo come sarebbe finita, avrei visitato il mondo finché era possibile.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862657
    m_Localized: 'Tourist: Ormai mi restano solo le foto. Tutti quei paesi... perduti per sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862658
    m_Localized: 'Tourist: Se solo potessi andarmene da questo posto...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862659
    m_Localized: Considerati fortunato, almeno non finirai bruciato vivo.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862660
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862661
    m_Localized: Consegna un mandato FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862662
    m_Localized: 'Tourist: Fortunato? Mi stai prendendo in giro?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862663
    m_Localized: 'Tourist: Desideravo viaggiare da sempre, e ora non so neppure se rimarrà qualcosa da vedere.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862664
    m_Localized: 'Tourist: E questa la chiami fortuna? Da quale punto di vista?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862665
    m_Localized: Ciò che conta è che sei ancora vivo!
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862666
    m_Localized: Ehi, è solo un viaggio.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862667
    m_Localized: 'Tourist: Già, sono vivo, e quindi? Sai cosa ci aspetta?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862668
    m_Localized: 'Tourist: Il sole esploderà e sarà la fine di tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862669
    m_Localized: 'Tourist: Morirò così, senza aver visto nulla del mondo...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862670
    m_Localized: È questa la tua scusa per commiserarti? Piantala di fare la vittima!
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862671
    m_Localized: Hai finito di frignare? Mi stai dando sui nervi.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862672
    m_Localized: 'Tourist: Non era solo un viaggio. Era il mio sogno.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862673
    m_Localized: 'Tourist: Desideravo vedere il mondo da tutta la vita, e ora cosa mi resta?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862674
    m_Localized: 'Tourist: È finita. Non accadrà mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862675
    m_Localized: 'Tourist: Sarei dovuto partire prima. Ormai siamo tutti spacciati.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862676
    m_Localized: È questa la tua scusa per commiserarti? Piantala di fare la vittima!
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862677
    m_Localized: Hai finito di frignare? Mi stai dando sui nervi.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862678
    m_Localized: 'Tourist: Ma io... Io...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862679
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862680
    m_Localized: 'Tourist: Non riesco a farne a meno. Scusami...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862681
    m_Localized: 'Tourist: Mi sono reso conto che avrei potuto partire prima. In realtà, nulla me lo avrebbe impedito.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862682
    m_Localized: 'Tourist: Ma continuavo a rimandare, raccontandomi che c''era tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862683
    m_Localized: 'Tourist: E adesso... è troppo tardi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862684
    m_Localized: 'Tourist: Il mondo sta per finire e c''era ancora così tanto che volevo vedere... e fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862685
    m_Localized: 'Tourist: Dovrò farmene una ragione, in un modo o nell''altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862686
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862687
    m_Localized: 'Tourist: Vaffanculo!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862688
    m_Localized: 'Tourist: Non ho neanche il diritto di rimpiangere ciò che ho perso?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862689
    m_Localized: 'Tourist: Guardati intorno, non possiamo più tornare indietro! È finita, e lo sai anche tu!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862690
    m_Localized: 'Tourist: Lo vedo nei tuoi occhi, tu l''hai già accettato. Ma io non... non voglio morire!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862691
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862692
    m_Localized: 'Tourist: Scommetto che non sei mai uscito da qui. Per te questo schifo è la normalità, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862693
    m_Localized: Non tirare troppo la corda.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862694
    m_Localized: Che ne dici se ti sbatto fuori e resto a guardare mentre il sole ti arrostisce?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862695
    m_Localized: 'Tourist: Ma cosa...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862696
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862697
    m_Localized: 'Tourist: Ora mi stai spaventando... D''accordo, me ne vado.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862698
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862699
    m_Localized: 'Tourist: Dico solo che forse tu puoi accettarlo, ma non è detto che ci riescano anche gli altri.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862700
    m_Localized: 'Tourist: Io sono tormentato dal pensiero di cosa mi accadrà. È più forte di me.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862701
    m_Localized: 'Tourist: Ho sprecato ogni singola occasione... perché avevo troppa paura di vivere il presente.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862702
    m_Localized: Aggrappati ai ricordi, ti daranno forza.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862703
    m_Localized: Devi smetterla di crogiolarti nei rimpianti.
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862704
    m_Localized: 'Tourist: Forse hai ragione...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862705
    m_Localized: 'Tourist: È difficile non rimuginare su come sarebbe andata se avessi agito diversamente...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862706
    m_Localized: 'Tourist: Ma sì, è così. Non posso più tornare sui miei passi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862707
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862708
    m_Localized: 'Tourist: Grazie per avermi ascoltato.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862709
    m_Localized: 'Tourist: Non so se tu sia un tipo da {0}, ma... prendi. È un regalo.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602560
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602561
    m_Localized: 'Dude: Ehi, amico! Mi sono appena ricordato di avere ancora una tootsie roll speciale.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602562
    m_Localized: 'Dude: Ragazzi, sarà una figata pazzesca!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602563
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602564
    m_Localized: 'Dude: Scusa, amico...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602565
    m_Localized: 'Dude: Mi sono scordato di farla girare...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602566
    m_Localized: 'Dude: Pace e amore, fratello... Tieni, è una paglia normale...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602567
    m_Localized: 'Dude: Credo che mi rilasserò un po''... Oh, sì...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602568
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602569
    m_Localized: 'Wheelchair: Diamine, ho bisogno di sgranchirmi...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602570
    m_Localized: 'Wheelchair: Aspetta.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602571
    m_Localized: 'Wheelchair: Uff, ora va meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602572
    m_Localized: Ma che diavolo...?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602573
    m_Localized: 'Wheelchair: Calmati, amico, ho solo una gamba addormentata. Perché quella faccia?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602574
    m_Localized: A che serviva tutta questa recita?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602575
    m_Localized: Perché diavolo sei su quella sedia a rotelle?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602576
    m_Localized: 'Wheelchair: Non ho mai mentito... È solo che così le gambe stanno al caldo.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602577
    m_Localized: 'Wheelchair: E poi... mi diverto troppo ad andarmene in giro così.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602578
    m_Localized: Tu sei matto da legare.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602579
    m_Localized: Va' subito via di qui, ORA!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602580
    m_Localized: 'Wheelchair: Ehi, sai che puoi fare delle derapate da paura con quest''affare?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602581
    m_Localized: 'Wheelchair: Non dirmi che non ci hai mai provato.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602582
    m_Localized: Tu sei matto da legare.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602583
    m_Localized: Va' subito via di qui, ORA!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602584
    m_Localized: 'Wheelchair: Se lo dici tu...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602585
    m_Localized: 'Wheelchair: Almeno io me la sto spassando!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602586
    m_Localized: 'Wheelchair: Che cazzo ti prende?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602587
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602588
    m_Localized: 'Wheelchair: Ok, me ne vado. Ma la sedia viene con me.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602589
    m_Localized: '>>'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602590
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602591
    m_Localized: 'Esenin: Ho trovato dei libri di poesia.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602592
    m_Localized: 'Esenin: Vuoi che te ne legga una, buon uomo?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602593
    m_Localized: Certo.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602594
    m_Localized: No, grazie.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602595
    m_Localized: 'Esenin: Finita. Che ne pensi?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602596
    m_Localized: È meravigliosa.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602597
    m_Localized: Sono solo parole.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602598
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602599
    m_Localized: 'Esenin: Sai, a dire il vero ora mi sento meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602600
    m_Localized: 'Esenin: Grazie per avermi ascoltato, buon uomo.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602601
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602602
    m_Localized: 'Esenin: Se per te è così... va bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602603
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602604
    m_Localized: 'FortuneTeller: Penso di conoscere un metodo che potrebbe riequilibrare la tua energia.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602605
    m_Localized: 'FortuneTeller: Non devi far altro che...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602606
    m_Localized: 'FortuneTeller: ESEGUIRE LE ONDULAZIONI DEL CAPRICORNO!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602607
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602608
    m_Localized: 'FortuneTeller: Allora? Come ti senti? Avverti la gioia che fluisce nei tuoi chakra?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602609
    m_Localized: Dovrei?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602610
    m_Localized: Ma che diavolo...?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602611
    m_Localized: 'FortuneTeller: Eh? Non ha funzionato?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602612
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602613
    m_Localized: 'FortuneTeller: Che strano... Ne ero certa...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602614
    m_Localized: 'FortuneTeller: Beh, non abbatterti. Afferma la tua gioia ogni giorno e ti sentirai meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602615
    m_Localized: 'FortuneTeller: Anzi... perché non iniziamo subito?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602616
    m_Localized: 'FortuneTeller: Ripeti dopo di me: io sono una persona felice!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602617
    m_Localized: Io sono una persona felice!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602618
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602619
    m_Localized: Che stronzata.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602620
    m_Localized: 'FortuneTeller: Molto bene, continua!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602621
    m_Localized: Io sono una persona felice!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602622
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602623
    m_Localized: Che stronzata.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602624
    m_Localized: 'FortuneTeller: Non ci stai neanche provando!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602625
    m_Localized: 'FortuneTeller: Un momento... Come ho fatto a non accorgermene...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602626
    m_Localized: 'FortuneTeller: Lo vedo dalla tua aura... Tu non cerchi la gioia! Sei del tutto privo di volontà.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602627
    m_Localized: 'FortuneTeller: E senza il desiderio, ogni azione è vana. L''universo non può rispondere alla vacuità.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602628
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602629
    m_Localized: 'FortuneTeller: Mi spiace, ma temo di non poterti aiutare. Nemmeno le affermazioni possono scuoterti.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602630
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602631
    m_Localized: Che stai facendo?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602632
    m_Localized: 'Intruder: Cerco i tuoi sogni.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602633
    m_Localized: 'Intruder: Desidero un momento di pace. Anche solo per un istante.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602634
    m_Localized: 'Intruder: Dove li hai nascosti? Dimmelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602635
    m_Localized: Stammi lontano o ti stendo.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602636
    m_Localized: Non ho nessun sogno da darti.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602637
    m_Localized: Levati dai piedi.
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602638
    m_Localized: 'Intruder: Tu non capisci... io ne ho BISOGNO.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602639
    m_Localized: 'Intruder: Ma l''avevo già capito guardandoti... Non ne hai neanche uno.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602640
    m_Localized: 'Intruder: Puoi stare tranquillo.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602641
    m_Localized: 'Intruder: Ora rifletti... Sto dicendo la verità, o voglio solo farti abbassare la guardia?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602642
    m_Localized: 'Intruder: Tuttavia, ho trovato un incubo ricorrente...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796864
    m_Localized: 'Intruder: Strisci lungo un corridoio... come un''immonda lumaca.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796865
    m_Localized: 'Intruder: Ti guardi intorno attraverso occhi che non sono i tuoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796866
    m_Localized: 'Intruder: Ti dirò solo questo: è uno sguardo affamato di cadaveri. Li brama nei luoghi intrisi di morte...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796867
    m_Localized: 'Intruder: Forse un giorno capirai...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796868
    m_Localized: 'Intruder: Tuttavia, ho trovato un incubo ricorrente...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796869
    m_Localized: 'Intruder: Ti trascini in un cunicolo invaso dai funghi.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796870
    m_Localized: 'Intruder: Ce ne sono un''infinità, e crescono senza sosta.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796871
    m_Localized: 'Intruder: Strano. Cosa spinge la tua mente a partorire una visione simile?'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821952
    m_Localized: 'Esenin: Quando la sera è stesa contro il cielo,'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821953
    m_Localized: 'Esenin: Come un paziente anestetizzato sul tavolo,'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821954
    m_Localized: 'Esenin: Andiamo, per certe strade semideserte,'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821955
    m_Localized: 'Esenin: Come rifugi borbottanti.'
    m_Metadata:
      m_Items: []
  - m_Id: 92376539113529344
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175582101823488
    m_Localized: Devo sottoporti a un test.
    m_Metadata:
      m_Items: []
  - m_Id: 74175582101823489
    m_Localized: Consegna un mandato FEMA
    m_Metadata:
      m_Items: []
