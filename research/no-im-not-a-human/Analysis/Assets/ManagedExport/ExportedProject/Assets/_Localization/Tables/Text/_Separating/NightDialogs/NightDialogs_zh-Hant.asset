%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_zh-Hant
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: zh-Hant
  m_SharedData: {fileID: 11400000, guid: e2adf5c0928e69a42a85516c84d58249, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: 嘿。*咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: 能讓我進去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: 你怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: 'Firefighter: 我是*咳嗽*一名消防員。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: 'Firefighter: 我們今天撲滅森林火災的時候被太陽給曬了個正著。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: 'Firefighter: 雖然濃煙讓我們逃過了一劫、免於被活生生地烤熟，不過*咳嗽*還是非常的駭人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: 'Firefighter: 樹木……*咳嗽*就像火柴一樣燒了起來。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: 我從未見過如此景象。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: 'Firefighter: 森林裡到處都是持續悶燒的動物屍體。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: 為何不去醫院？
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: 接下來，你有什麼打算？
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: 'Firefighter: 撲滅森林火災的時候，我們*咳嗽*被午後的太陽給曬了個正著。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: 整支小隊只有我一人離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: 'Firefighter: 其餘的兄弟……*咳嗽*高層不允許他們走。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: 現在，他們只能持續執行自己的任務、永不停歇。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: 為何不去醫院？
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: 接下來，你有什麼打算？
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: 'Firefighter: 醫院？現在已經沒有所謂的什麼醫院了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: 'Firefighter: 偽人出現之後，醫院就徹底失去了意義。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: 'Firefighter: 要是就連提供治療的人都已經無法再信任了的話，還談什麼接受治療。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: 沒有人*咳嗽*願意向我伸出援手。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: 'Firefighter: 還不如繼續救火、與大家一起犧牲。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: 不管怎樣，我也沒幾天可活了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: 'Firefighter: 我想……繼續撲滅森林火災。真希望自己當時死在了那裡，而不是讓小隊的兄弟們遭受現在這樣的命運。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: 'Firefighter: 不過，他們倒是非常堅決地告訴我，*咳嗽*不能再讓我幹下去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: 'Firefighter: 我已經無法回家了，公共交通已經癱瘓。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: 只能仰賴人類的善意。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: 謝謝。*咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: 'Firefighter: 我想，我應該不會打擾你太久。*咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: 'Firefighter: 起碼，我不會曝屍荒野了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: 該死。*咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: 我不想曝屍荒野。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: 'Firefighter: 希望*咳嗽*火勢不會蔓延至城裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: 嘿！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: 'WheelChair: 好久不見。最近過得怎麼樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: 我們認識嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: 'Wheelchair: 拜託……你不記得我了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: 我們可是……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: 'Wheelchair: 不對，你的聲音怎麼變成這樣了……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: 這裡什麼時候換了主人？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: 這棟房子一直都是我們家的
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: 我想，你找錯地方了
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: 噢，你並不是……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: 你並不是我的好友。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: 你在這裡住多久了？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: 這棟房子一直都是我們家的
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: 我想，你找錯地方了
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: 哎呀，拜託。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: 'Wheelchair: 我這輩子都沒有犯下過任何錯誤！我的記性特別好，就跟鋼製捕獸夾一樣堅固——而且，還是用來捕捉大象的那種！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: 'Wheelchair: 我的好友絕對是住在……好吧，之前是住在這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: 'Wheelchair: 不管怎樣，我也是千里迢迢地來到了這裡。能讓我進去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: 這不可能，我怎麼會……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: 不……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: 該死……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: 看來我的確找錯地方了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: 'Wheelchair: 不管怎樣，我也是千里迢迢地來到了這裡。能讓我進去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: 就是這樣！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: 沒想到，看起來還挺寬敞的嘛！不如，來比賽吧？三、二、一——出發！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: 'Wheelchair: 離開？搞什麼鬼？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: 'Wheelchair: 我就他媽的該離開？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: 'Wheelchair: 見了鬼了，我要走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: 'Mother: 好了！不要再亂動了，給我乖乖站直。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: 'Mother: 你好，請幫幫我。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: 怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: 請問，有何貴幹？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: 'Mother: 我累壞了，想要睡上一覺。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: 我有五個孩子，不過……現在只剩下這個了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: 'Mother: 我的丈夫消失了。不清楚他究竟是死了、拋棄我們了，還是怎樣了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: 'Mother: 現在，我只想躺下來好好地睡上個幾天。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: 其他的孩子都去哪裡了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: 其他的孩子都已經死了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: 'Mother: 讓我進去睡一覺吧，我已經筋疲力盡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: 'Mother: 我有五個孩子，然而……現在只剩下這個了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: 'Mother: 我不知道該去何處尋找他們。現在，我只想好好地睡上一覺。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: 其他的孩子都去哪裡了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: 其他的孩子都已經死了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: 'Mother: 我不知道，或許是被他們的父親給帶走了。我想要前往他家，不過……目前已經快要撐不住了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: 'Mother: 沒錯，我們的確整天都在吵架。只是，這也不足為奇。如果表現得像個混蛋，又怎可能跟別人一起生活？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: 'Mother: 沒錯，絕無可能。目前，要緊的是找到我的孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: 不要這麼說。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: 'Mother: 沒錯——要照顧好一群上躥下跳的孩子絕非易事，不過……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: 'Mother: 我相信他們都平安無事，說不定是在我媽媽家。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: 'Mother: 每當他們對我感到厭煩，都會躲到那裡去。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: 'Mother: 又或者是他們的父親來找我要錢的時候。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: 'Mother: 能讓我進去嗎？這樣一來，我就能好好地休息一下、然後接著上路尋找孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: 終於能好好休息一下了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: 'Mother: 快，進去吧——挑個地方安頓下來。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: 我們明天就會離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: 'Mother: 好吧。既然如此，只能試著去我媽媽家了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: 我不確定自己能否平安抵達……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: 不——我一定要平安抵達。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: 你好。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: 'Anger: 我現在心情非常不好，因此先跟你說句抱歉。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: 'Anger: 這附近的人都是混球，希望你不是其中之一。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: 這是在說誰？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: 我想，你應該不是那些怪物的一員吧？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: 還能是誰。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: 'Anger: 就是那些被信仰或者其他什麼東西給束縛住的混球。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: 'Anger: 當所信仰的神明死去後，他們的人性便蕩然無存。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: 一群畜牲。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: 'Anger: 就好像應付那些該死的偽人還不夠我們喝一壺一樣……甚至就連這種傢伙也冒出來了。媽的！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: 為何如此激動？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: 那麼，你跟他們有有何不同？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: 問得好。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: 'Anger: 想必你也已經注意到了，對吧？目前存在著……兩類截然不同的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: 'Anger: 一類是他媽的施虐狂，遠比偽人要更加糟糕。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: 'Anger: 這些傢伙簡直無法無天——拿槍指著他人的腦袋、毫不猶豫地扣下扳機，四處橫行、以此為樂！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: 'Anger: 一類是該死的軟骨頭。受到他人的肆意踐踏之後，這些傢伙反而還會涕泗橫流、衷心感謝對方饒過自己一命。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: 這兩類人都令我無比反感。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: 為何如此激動？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: 那麼，你跟他們有有何不同？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: 'Anger: 我並非在針對你。只是……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: 'Anger: 不光太陽引發了災變、還引來了這什麼偽人，就好像人性已經隨著上帝一同滅亡了一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: 'Anger: 我對此感到無比憤怒……我只是想過普通的生活，僅此而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: 'Anger: 我以創作音樂為生，而現在根本就再也沒有人會關心這些東西了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: 我只能試著讓自己跟這兩類人劃清界限，不讓自己成為其中一方。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: 我也想要相信自己與其他人有所不同。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: 'Anger: 一想到自己有可能會變成一個瘋子，就把我給嚇得要死。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: 'Anger: 又或者是被他們馴化。總之都爛透了就對了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: 不過……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: 想當然爾，前者要更為糟糕。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: 'Anger: 失去了一切想要抵抗的想法，只是呆呆地等著被揍得屁滾尿流、滿地找牙，或者諸如此類的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: 'Anger: 如果你親身經歷過我的所見、所聞，就能理解我心中這股洶湧的怒意。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: 'Anger: 放心，我不會打擾到其他人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: 當然，也不會去動手打他們。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: 'Anger: 我會把怒氣藏在心中，不會給大家造成困擾。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: 'Anger: 該死，你跟其他的那些懦夫根本就沒有任何不同。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: 'Anger: 當他們把你給抓住、往你臉上重重地來上一下時，可千萬不要哭爹喊娘。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: 媽的！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: 我能感受到能量於此停滯不前。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: 大事不妙了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: 'FortuneTeller: 太陽、獅子座，還有第五宮——我明白了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: 'FortuneTeller: 我想，你一定是個既堅定、又果決的人——沒錯吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: 蛤？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: 我什麼都不需要
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: 看來相比動嘴，你更喜歡動手。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: 極為典型的獅子座——我沒說錯吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: 'FortuneTeller: 這裡積累了大量的負面能量。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: 我暫時還無法看透原因。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: 'FortuneTeller: 一切都被忽視了，看來我最好先進行一些積極的心理暗示。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: 為什麼要跟我說這些亂七八糟的破事？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: 好吧，然後呢……？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: 我沒有別的意思。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: 'FortuneTeller: 只是想幫你梳理清楚因果，明白了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: 'FortuneTeller: 業障輪迴，如同魚兒圍繞彼此打轉。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: 'FortuneTeller: 善有善報、惡有惡報，理解了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: 為什麼要跟我說這些亂七八糟的破事？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: 好吧，然後呢……？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: 'FortuneTeller: 我理解這一切對你來說壓力很大，畢竟你是上升摩羯座。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: 'FortuneTeller: 嗯……看來你的內心同時承載著複數星座，還真是個複雜的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: 'FortuneTeller: 我們可以透過積極的心理暗示來觸及內心深處的宇宙——這，你應該能理解吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: 'FortuneTeller: 如此一來，一切的問題都將迎刃而解。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: 'FortuneTeller: 於你的家族之中，存在獄卒及其轉世之人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: 'FortuneTeller: 給他們一些空間吧。現在這樣，只不過是在重複前世的經歷。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: 'FortuneTeller: 要去諒解他們，並在內心坦然接受這點。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: 'FortuneTeller: 如此一來，就能掙脫永世循環的束縛。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: 明白了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: 'FortuneTeller: 好極。話說回來，這裡還真的是個不錯的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: 我能感受到一股充滿生機的能量流經這棟房子。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: 'FortuneTeller: 怎麼，你就沒想過要提升一下自己？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: 難道，你就不想成為一個更好的人？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: 真是可悲。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: 'FortuneTeller: 我要對你下蠱，讓你上吐下瀉、從此苦不堪言。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: 晚安。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: 'Gasmask: 我隸屬於FEMA，正在拜訪這片鄰里。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: 就你一個人？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: 我為什麼要相信你？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: 當然不是。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: 'Gasmask: 我們將整支大隊分成了數個小組，進而增加效率。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: 不會耽擱你太長的時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: 為何穿著防護衣？我們也要這樣嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: 好吧，你們要怎樣來幫我們？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: 我可以給你看我的證件。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: 'Gasmask: 此外，偽人也基本上——或者說，根本就——不會成群結隊地行動。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: 為何穿著防護衣？我們也要這樣嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: 好吧，你們要怎樣來幫我們？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: 'Gasmask: 並不。只是，如果你認為有必要的話也可以自行購買一套。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: 'Gasmask: 我們正在研究太陽對環境造成的影響。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: 'Gasmask: 需要頻繁地頂著陽光四處活動，因此得確保萬無一失。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: 然後呢？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: 那麼，你們有什麼行動計劃嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: 'Gasmask: 首先，我們需要收集資料並提交給領導層。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: 然後，他們會以此制定回應程序。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: 'Gasmask: 現在，只需保持冷靜即可。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: 然後呢？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: 那麼，你們有什麼行動計劃嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: 我需要帶走一人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: 'Gasmask: 我們會進行一系列的檢查來確保其沒有任何問題、來確定這片區域適宜居住。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: 'Gasmask: 當然，也會核實對方是否偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: 我需要收拾行李嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: 我只要耐心等待最新消息就可以了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: 'Gasmask: 這是自然，我們並非無頭蒼蠅。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: 我們需要從你這裡帶走一人回實驗室。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: 'Gasmask: 然後對其進行檢查。確保一切正常之後，就會把對方送回來。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: 我需要收拾行李嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: 我只要耐心等待最新消息就可以了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: 這是你的房子嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: 'Gasmask: 既然如此，便沒必要——跟其他人待在這裡吧。如果需要疏散，我們會通知你。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: 我們只會帶走一人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: 祝你晚安。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: 'Gasmask: 沒錯。收集到所需的全部資訊後，我們將會提供相應的指引。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: 現在，沒有必要擔心。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: 'Gasmask: 我們只需要帶走一人，然後會盡快將其送回。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: 還請保重。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: 'Prophet: 哎呀，又見面了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: 'Prophet: 上次的情況與現在有所不同。不過，看來我們都順利地活了下來……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: 'Prophet: 嗯，真是奇怪——我不知道該如何解釋。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: 'Prophet: 就讓我們以……行動來開啟這次對話吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: 'Prophet: 能透過這本書幫忙占卜一下嗎？我該翻到哪一頁呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: 翻到開頭的部分
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: 翻到中間的部分
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: 翻到結尾的部分
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: 'Prophet: 「死者將不顧風險、與我們講述。然則，無人理會其言。」'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: 天啊……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: 嗯……一樣與之相關。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: 雖然，現在已經不足為奇了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: 這是什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: 難道你真的相信這些？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: 不知，你究竟為何物？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: 'Prophet: 「我？我就是我。你？你則是家。」'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: 'Prophet: 沒錯，一齣悲劇。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: 'Prophet: 這就是我們所要面對的嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: 非常有可能。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: 這是什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: 難道你真的相信這些？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: 'Prophet: 「這已經是很久以前的事情了。也許，一切都只不過是鏡花水月。也許，你、我，還有魚兒……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: 'Prophet: ……都只存在於某個早已逝如朝露之人的記憶當中。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: 'Prophet: 也許，人人都是假的。只是外面正在下雨，僅此而已。」'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: 嗯……或者，很快就會變成這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: 'Prophet: 不知，你覺得如何？我們是早就活在了他人的空想之中、還是已經快要成為他人的遐思邇想？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: 真是一段耐人尋味的話。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: 這是什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: 難道你真的相信這些？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: 'Prophet: 我需要思考一下。對此，你有何看法？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: 總而言之，這次登門是為了告訴你一些事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: 一些在不久後的將來就會發生的事情……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: 還請做好準備。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: 'Prophet: 雖然這聽起來的確非常的可疑，不過你得讓帶著貓咪的人進去。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: 'Prophet: 我確信這會對你有所幫助。至於具體如何，暫時還不能說。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: 'Prophet: 當然，你可自行決定如何處理這則資訊。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: 'Prophet: 現在，我需要思考一下你在這次占卜中所做出的選擇背後蘊含的意義。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: 也不盡然。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: 'Prophet: 最好將其視為建議。如此一來，就不會忘記去做某些事情、去留意某些事物。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: 正當我細細咀嚼時，某件事情突然浮現。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: 'Prophet: 不久之後，一個帶著貓咪的人回來拜訪。而你，一定要讓對方進去。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: 至於原因為何，暫時還不能說。不過，這樣會讓事情變得輕鬆一些。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: 'Prophet: 現在，我需要思考一下你從書中所選出的這段話背後語言的意義。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: 你好，人類。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: 'Fanatic: 我們真的是太走運了！能親眼目睹自身的慾望所招致的懲罰。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: 'Fanatic: 太陽正履行自己的職責，淨化地球上的一切汙穢。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: 我們將會迎來一個不含任何雜質的嶄新世界！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: 'Fanatic: 見證這一祝福吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: 蛤？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: 我被你嚇到了
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: 你還有疑問嗎，人類？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: 'Fanatic: 聽好——我來給你簡單說明一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: 'Fanatic: 太陽並非毫無緣由地灼燒我們，而是為了淨化、消除我們的罪惡！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: 'Fanatic: 人類把這個世界搞得烏煙瘴氣，惹怒了太陽！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: 'Fanatic: 一切都是我們咎由自取！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: 'Fanatic: 這是一份恩賜。滌蕩了罪惡之後，我們便能依照常理而活。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: 也就是說……我們都得死？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: 而你又會如何？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: 你瘋了吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: 'Fanatic: 聽好——我來給你簡單說明一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: 'Fanatic: 太陽並非毫無緣由地灼燒我們，而是為了淨化、消除我們的罪惡！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: 'Fanatic: 人類把這個世界搞得烏煙瘴氣，惹怒了太陽！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: 'Fanatic: 一切都是我們咎由自取！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: 'Fanatic: 這是一份恩賜。滌蕩了罪惡之後，我們便能依照常理而活。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: 也就是說……我們都得死？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: 而你又會如何？
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: 正好相反！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: 'Fanatic: 罪惡終將消逝，太陽或許也會隨之而去。然而，我們能活下來。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: 'Fanatic: 不會再有人死於非命，不會再有偷雞摸狗之事，不會再有貪得無厭的雜種以不合理的價格來逼迫我購買自己想要的東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: 'Fanatic: 能想像這是一幅什麼光景嗎？知道這一切都意味著什麼嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: 我？這可不僅僅只攸關我一人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: 'Fanatic: 只要得到了太陽的相助，我們就能從此安居樂業。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: 'Fanatic: 只要得到了太陽的幫忙，我們就能渡過這一難關——難道你不明白嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: 'Fanatic: 不，你心知肚明——你還活著就是最好的證明！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: 非常好，人類！關於這件事情，之後我會再詳細地跟你說明清楚！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: 'Fanatic: 對了，我都忘記問了——你這裡有啤酒嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: 'Fanatic: 我費盡口舌，而你竟還裝作對太陽一無所知？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: 'Fanatic: 去你的吧，白癡！我救別人去！聽到了嗎？別——人——！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: 'Fanatic: 再、你、媽、的、見！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: 你好！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: 'Anxiety: 對不起，這麼晚還來打擾你……沒辦法，白天實在是太熱了。電視裡說最好不要頂著陽光出來。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: 能不能讓我在裡面待一待？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: 你是怎麼到這裡來的？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: 嗯，我以前住得離城裡很近。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: 'Anxiety: 想當然爾，那裡的柏油馬路已經燙得要命了。嘿、嘿嘿。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: 'Anxiety: 我之前是個收銀員——沒錯，現在已經不是了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: 'Anxiety: 我，嗯……被解僱了。我在工作上就從來沒走過運……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: 接下來，你有什麼打算？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: 照你看來，之後會發生什麼事情？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: 'Anxiety: 我也不是說想要到這裡來。嗯……雖然柏油馬路已被熱化，不過這還不是最糟糕的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: 說出來你肯定會笑我。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: 'Anxiety: 偽人闖進了我的房子，然後……把我給掃地出門了。難以置信，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: 'Anxiety: 於是，我現在在找能躲太陽的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: 接下來，你有什麼打算？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: 照你看來，之後會發生什麼事情？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: 'Anxiety: 嗯……想辦法活下去吧。雖然不管是四處遊蕩的偽人、還是這熱得不像話的太陽都把我給嚇得夠嗆。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: 'Anxiety: 我真的不想死。嘿嘿，哎呀。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: 難道你就一點也不害怕嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: 'Anxiety: 求求你告訴我這一切很快就會過去。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: 我不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: 'Anxiety: 我能活下去嗎？誰會向我伸出援手？到底要到什麼時候才找到願意幫助我的人？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: 'Anxiety: 我不知道之後會發生什麼事情，甚至連猜都猜不出來。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: 'Anxiety: 難道你就不對此感到害怕？我反正是嚇壞了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: 'Anxiety: 謝了，哈哈！真的，萬分感激！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: 'Anxiety: 謝天謝地，我還能再活一陣子。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: 'Anxiety: 哈哈，呼——好吧，這也在情理之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: 'Anxiety: 無論如何，還是謝謝你願意聽我訴說。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: 'Anxiety: 好吧，看來我該走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: 'Anxiety: 就此別過？嗯、呃，就此別過。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: 能不能讓我進去？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: 我原本是在酒吧裡避難，不過……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: 我被趕出來了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: 'Esenin: 為什麼？嗯，這麼說吧——不是每個人都受得了我這脾氣。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: 'Esenin: 不要擔心，我不會傷害任何人。只是……日子總有過得不順心的時候，就是這麼回事。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: 'Esenin: 如何？能不能讓我進去？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: 你不是偽人吧？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: 你不會惹事吧？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: 難道你覺得我是個怪物？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: 'Esenin: 我可以明確地告訴你——當然不是。話說回來，劈頭蓋臉就這樣問也太荒唐了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: 'Esenin: 看來這裡也和其他的地方沒什麼兩樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: 為何會被趕出來？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: 為何覺得在我這裡就會有所不同？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: 惹事？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: 'Esenin: 我並不喜歡訴諸暴力、就更別提取人性命了，天性如此。不過，我也不會讓任何人傷害自己就是了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: 'Esenin: 我喜歡大口地吃、盡情地喝。要是心情好的話，還喜歡跟人聊天。這樣屬於「惹事」嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: 為何會被趕出來？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: 為何覺得在我這裡就會有所不同？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: 'Esenin: 我本想說幾句不太好聽的話，思量再三、還是罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: 'Esenin: 這麼說吧——雖然不清楚究竟是誰，不過……那裡有人非常討厭我。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: 'Esenin: 一想到這個，就覺得被趕出來或許是件好事。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: 'Esenin: 不然說不定會被生吞活剝，而且沒有任何人會注意到。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: 'Esenin: 我現在該怎麼辦？難道只能眼巴巴地等到太陽升起、把我活活地給烤死？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: 不，想都別想。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: 'Esenin: 只要我還剩一口氣，都不會放棄尋找尚能進行溝通的人。如果你不讓我進去，大不了我就到其他的地方去碰碰運氣。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: 'Esenin: 前提是這個世界還存在運氣這種東西、還有頭腦清醒的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: 'Esenin: 謝謝。如今這個世道，人與人之間的信任可謂千金難求。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: 'Esenin: 因此，非常感激你願意相信我。也許……不，沒什麼——我無法給出任何承諾。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: 'Esenin: 好吧，我能理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: 'Esenin: 雖能理解，卻不代表我可以心平氣和地接受。看來，你跟這裡的其他懦夫根本就沒什麼兩樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: 'Esenin: 祝你睡個好覺，還有就是——去你媽的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: 我能進去歇歇腳嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: 你是從哪裡來的？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: 你接著要去哪裡？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: 'Widow: 我不記得了，也並不重要。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: 'Widow: 我累壞了。再不休息就得倒在窗戶下了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: 請問，你的同伴是生病了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: 請問，你的好友是否需要幫助？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: 'Widow: 我……我只想找個地方倒頭就睡，再不起來。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: 至於這個地方是哪裡，我並不在意。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: 請問，你的同伴是生病了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: 請問，你的好友是否需要幫助？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: 這是我丈夫。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: 他已經過世了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: 'Widow: 我沒辦法好好安葬他，而且……現在撒手也已經沒有意義。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: 'Widow: 已經不再需要了。真正需要的時候，根本就沒人幫他。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: 現在，他已經死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: 'Widow: 如果真的有人在乎……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: 'Widow: 說不定他就能活下來。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: 我應該不會待太久。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: 'Widow: 只要休息一下就行。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: 你……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: 嘿！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: 'Scammer: 看到都發生什麼事了嗎？真是瘋了！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: 這裡是否還好？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: 不知，有何貴幹？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: 到底發生什麼事了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: 'Scammer: 沒什麼，只是好奇問問罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: 'Scammer: 不過，我這倒是有個能讓你輕鬆撈錢的法子。想聽聽嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: 'Scammer: 鑒於現在人人都害怕如此猛烈的陽光，幾乎不費吹灰之力就能賺到盆滿缽滿。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: 'Scammer: 一群明明只要行動起來就好、卻不知道在擔心什麼的孬種！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: 為何要來找我？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: 洗耳恭聽
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: 'Scammer: 新機遇來臨了，兄弟——前途無量！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: 'Scammer: 現在，每個人都像無頭蒼蠅一樣到處亂竄。然而，他們其實完全可以遵循內心的想法行動。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: 'Scammer: 大家需要開心一點——這，就是我的意思！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: 為何要來找我？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: 洗耳恭聽
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: 真是開門見山——我喜歡！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: 'Scammer: 大家都覺得你在這裡不安好心、總是惹是生非。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: 'Scammer: 要我說，不如乾脆順驢下坡——舉行一場令人永生難忘的派對、一場嗨翻全場的末日狂歡！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: 想要活下去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: 'Scammer: 既然如此，就趁著還有機會的時候抓緊時間制定計劃吧——讓太陽見鬼去！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: 'Scammer: 趕快行動起來，懂我的意思吧？好啦，如何？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: 'Scammer: 這就對了，兄弟！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: 終於讓我遇到了個算是有點頭腦的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: 'Scammer: 我看出來了——你是個徹頭徹尾的白癡。沒有一開始就意識到，的確是我的問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: 'Scammer: 我找你的鄰居去，看看對方懂不懂得欣賞我的聰明才智。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: 掰啦，白癡。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: 'Neighbour: 嘿，鄰居。好久不見。最近過得怎麼樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: 一如既往
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: 還好
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: 'Neighbour: 之所以會登門拜訪，是有原因的——我有點擔心你。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: 大事不妙了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: 'Neighbour: 我的表親來電話了，說電視上滿是太陽出問題了的新聞。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: 'Neighbour: 而且，還有什麼東西從地下爬了出來。不知出於何種原因，政府將其稱為偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: 'Neighbour: 真是讓人毛骨悚然，希望事實並非如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: 太陽怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: 偽人？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: 'Neighbour: 之所以會登門拜訪，是有原因的——我有點擔心你。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: 大事不妙了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: 'Neighbour: 我的表親來電話了，說電視上滿是太陽出問題了的新聞。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060952
    m_Localized: 'Neighbour: 而且，還有一些傢伙從地下爬了出來。不知出於何種原因，政府將其稱為偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060953
    m_Localized: 'Neighbour: 聽著讓人毛骨悚然。希望事實並非如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060954
    m_Localized: 太陽怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060955
    m_Localized: 偽人？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060956
    m_Localized: 'Neighbour: 不是要爆炸了、就是有什麼東西要在上面爆炸了吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060957
    m_Localized: 'Neighbour: 我也不清楚詳情，只知道出問題了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060958
    m_Localized: 'Neighbour: 這是有史以來最熱的一個夏天——想必你也已經注意到了，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060959
    m_Localized: 'Neighbour: 我想，我們需要做好最壞的打算。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060960
    m_Localized: 'Neighbour: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060961
    m_Localized: 'Neighbour: 我表親說獨自一人待在家裡非常危險。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060962
    m_Localized: 'Neighbour: 因此我就過來了，好確保你不會死於非命。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060963
    m_Localized: 好吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060964
    m_Localized: 我能照顧好自己
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060965
    m_Localized: 這樣的話，你的妻子和女兒該怎麼辦？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060966
    m_Localized: 'Neighbour: 沒錯，政府就是這麼稱呼這些從地下爬出來的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060967
    m_Localized: 'Neighbour: 天知道為什麼會起這樣的一個名字。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060968
    m_Localized: 'Neighbour: 說不定，是因為它們跟人類有所區別？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060969
    m_Localized: 'Neighbour: 又或者，是因為它們會試圖闖進我們的房子、將人類取而代之？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060970
    m_Localized: 'Neighbour: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060971
    m_Localized: 'Neighbour: 我表親說獨自一人待在家裡非常危險。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060972
    m_Localized: 'Neighbour: 因此我就過來了，好確保你不會死於非命。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060973
    m_Localized: 好吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060974
    m_Localized: 我能照顧好自己
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060975
    m_Localized: 這樣的話，你的妻子和女兒該怎麼辦？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060976
    m_Localized: 'Neighbour: 好啦，其餘的事情就等到早上再聊吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060977
    m_Localized: 'Neighbour: 我會在廚房等你。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060978
    m_Localized: 'Neighbour: 早上見。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060979
    m_Localized: 'Neighbour: 對此，我深信不疑。不過，我認為現在獨自一人待在家裡遠比你想像中的要更加危險。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060980
    m_Localized: 'Neighbour: 就讓我待在這裡過夜吧，如何？只是為了以防萬一。而且，這也能令我感覺好些。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060981
    m_Localized: 'Neighbour: 不必擔心我的妻女。前些天剛好有個好友前來造訪——他會幫忙照顧我的家人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060982
    m_Localized: 'Neighbour: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060983
    m_Localized: 'Neighbour: 好啦，其餘的事情就等到早上再聊吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060984
    m_Localized: 'Neighbour: 我會在廚房等你。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060985
    m_Localized: 'Neighbour: 早上見。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060986
    m_Localized: 'Neighbour: 不必擔心。前些天剛好有個好友前來造訪——他會幫忙照顧我的家人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060987
    m_Localized: 'Neighbour: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060988
    m_Localized: 'Neighbour: 好啦，其餘的事情就等到早上再聊吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060989
    m_Localized: 'Neighbour: 我會在廚房等你。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060990
    m_Localized: 'Neighbour: 早上見。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060991
    m_Localized: 'Daughter: 嗨！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060992
    m_Localized: 'Daughter: 我爸爸是在這裡嗎？幫我叫他一下好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060993
    m_Localized: 'Daughter: 白天還好，現在就有點害怕了。大家都是趁著夜幕降臨之後才蜂擁而出……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060994
    m_Localized: 你爸爸叫什麼名字？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060995
    m_Localized: 跟我說說你爸爸的事
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060996
    m_Localized: 'Daughter: 難道你忘記他叫什麼了？噢，我知道了——這是在檢查我到底是不是偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060997
    m_Localized: 'Daughter: 真是聰明！我也要去有意識地檢查一下其他人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060998
    m_Localized: 來的路上沒出什麼事吧？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060999
    m_Localized: 你害怕偽人嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061000
    m_Localized: 'Daughter: 嗯，我可了解他了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061001
    m_Localized: 'Daughter: 爸爸出門前喜歡喝一點啤酒，嘿嘿！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061002
    m_Localized: 'Daughter: 還會給我留午餐、晚餐，和果汁。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061003
    m_Localized: 'Daughter: 今天，我偷偷嘗了嘗他平時喝的啤酒。呸，難喝得要命！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061004
    m_Localized: 'Daughter: 都有果汁了，為什麼還要喝這種東西？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061005
    m_Localized: 'Daughter: 噢，還請千萬不要把這件事情告訴他。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061006
    m_Localized: 來的路上沒出什麼事吧？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061007
    m_Localized: 你害怕偽人嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061008
    m_Localized: 'Daughter: 這個世界簡直亂了套。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061009
    m_Localized: 'Daughter: 現在，大家白天都呆坐在家裡、不然就是悶頭大睡。直到晚上才會出來活動。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061010
    m_Localized: 'Daughter: 我還是害怕黑暗，不過……好像也沒有什麼值得擔心的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061011
    m_Localized: 'Daughter: 還是說，我這個想法其實大錯特錯？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061012
    m_Localized: 我這就去叫你爸爸過來。祝你好運！
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061013
    m_Localized: 希望你過得愉快！
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061014
    m_Localized: 'Daughter: 我不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061015
    m_Localized: 'Daughter: 大家都很害怕偽人，所以我也害怕它們。不過，我還沒親眼見過呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061016
    m_Localized: 'Daughter: 它們是不是都很嚇人？而且，還會狠狠地攻擊我們？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061017
    m_Localized: 'Daughter: 這樣的話……如果我同學揍我了，是不是說明他也是偽人？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061018
    m_Localized: 'Daughter: 爸爸說過要小心點，因此我特別地謹慎！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061019
    m_Localized: 'Daughter: 我是躡手躡腳地來到這裡的，沒有被任何人看見。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061020
    m_Localized: 我這就去叫你爸爸過來。祝你好運！
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061021
    m_Localized: 希望你過得愉快！
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061022
    m_Localized: 'Daughter: 謝謝，你也是！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061023
    m_Localized: 'Daughter: 快點。現在都已經這麼晚了，我一個人待在這裡實在是很害怕。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061024
    m_Localized: 'Daughter: 回去之後，就能跟爸爸一起玩他專門為我設計的一種遊戲。首先，需要擲骰子！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061025
    m_Localized: 'Daughter: 接著，透過諸如扶椅、長椅這樣的東西來進行移動。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061026
    m_Localized: 'Daughter: 然後，開拓出一條道路來。總之，回頭我再玩給你看。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061027
    m_Localized: 'Daughter: 再見！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061028
    m_Localized: 'Daughter: 你、你好。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061029
    m_Localized: 'Daughter: 讓、讓我進去吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061030
    m_Localized: 為何如此驚慌？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061031
    m_Localized: 怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061032
    m_Localized: 'Daughter: 我不、不知道該、該怎麼辦。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061033
    m_Localized: 'Daughter: 有、有、有人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061034
    m_Localized: 'Daughter: 呃、呃……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061035
    m_Localized: 'Daughter: 殺、殺、殺了我、我的爸爸……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061036
    m_Localized: 'Daughter: 我、我、我……我、我的……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061037
    m_Localized: 'Daughter: 爸、爸爸。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061038
    m_Localized: 到底是誰下的手？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061039
    m_Localized: 為什麼要這樣做？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061040
    m_Localized: 'Daughter: 呃、呃……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061041
    m_Localized: 'Daughter: 我、我的爸、爸爸……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061042
    m_Localized: 'Daughter: 它、它們殺、殺了……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061043
    m_Localized: 'Daughter: 殺了我、我的爸、爸爸。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061044
    m_Localized: 到底是誰下的手？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061045
    m_Localized: 為什麼要這樣做？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061046
    m_Localized: 'Daughter: 偽、偽人進、進到了我家，跟我們坐、坐在了一、一起。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061047
    m_Localized: 'Daughter: 爸爸跟他們說、說、說了些什、什麼，然、然後就被它們給殺死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061048
    m_Localized: 'Daughter: 他……我們……*啜泣*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061049
    m_Localized: 'Daughter: 現在，我、我家燒、燒、燒起來了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061050
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061051
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061052
    m_Localized: 'Daughter: 我不、不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061053
    m_Localized: 'Daughter: 本來它們跟我爸爸只、只是坐、坐在廚房裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061054
    m_Localized: 'Daughter: 之後不知道做、做、做了什麼，接、接著就放、放火燒了我家。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061055
    m_Localized: 'Daughter: 我拚命逃、逃跑，而它們則不停地嗤、嗤笑。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061056
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061057
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061058
    m_Localized: 'Daughter: 你、你會幫、幫我嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061059
    m_Localized: 'Daughter: 我好害、害、害怕。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061060
    m_Localized: 'Daughter: 我、我、我該去哪、哪裡？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061061
    m_Localized: 'Daughter: 嗚哇——'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061062
    m_Localized: 'Daughter: 嗚哇——'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061063
    m_Localized: 'Daughter: 我好、好害怕、怕——'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061064
    m_Localized: 'SuperFake: 嗨！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061065
    m_Localized: 不知，有何貴幹？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061066
    m_Localized: 我不會讓你進來的
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061067
    m_Localized: 'SuperFake: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061068
    m_Localized: 'SuperFake: 還真是一棟寬敞的房子。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061069
    m_Localized: 'SuperFake: 我很喜歡。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061070
    m_Localized: 我什麼都不需要
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061071
    m_Localized: 我手上有槍
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061072
    m_Localized: 'SuperFake: 不知，這扇門是否堅固、耐用？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061073
    m_Localized: 'SuperFake: 恐怕，你並不了解。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061074
    m_Localized: 'SuperFake: 這點，你心知肚明。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061075
    m_Localized: 我什麼都不需要
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061076
    m_Localized: 我手上有槍
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061077
    m_Localized: 'SuperFake: 好了、好了，我知道啦。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061078
    m_Localized: 'SuperFake: 那麼……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061079
    m_Localized: 'SuperFake: 告訴我，這裡就你一個人嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061080
    m_Localized: 我並非獨自一人
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061081
    m_Localized: 我的確獨自一人
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061082
    m_Localized: 'SuperFake: 好樣的！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061083
    m_Localized: 'SuperFake: 這就是所謂的「兔子急了敢咬人」，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061084
    m_Localized: 'SuperFake: 不過……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061085
    m_Localized: 'SuperFake: 告訴我，這裡就你一個人嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061086
    m_Localized: 我並非獨自一人
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061087
    m_Localized: 我的確獨自一人
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061088
    m_Localized: 'SuperFake: 看來，你今天運氣不錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061089
    m_Localized: 'SuperFake: 我能聽到裡面有人竊竊私語。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061090
    m_Localized: 'SuperFake: 不過——之後將會如何，誰又說得準呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061091
    m_Localized: 'SuperFake: 哈哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061092
    m_Localized: 'SuperFake: 我知道你獨自一人。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061093
    m_Localized: 'SuperFake: 我只是想看看你會不會撒謊。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061094
    m_Localized: 'SuperFake: 我這就把門給打開。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061095
    m_Localized: 'NotTrue: 哎呀，寶貝！這一路走來真的是把我累了個半死。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061096
    m_Localized: 'NotTrue: 我能進去歇歇腳嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061097
    m_Localized: 請問，你是直接到這裡來的嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061098
    m_Localized: 你走了很久嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061099
    m_Localized: 'NotTrue: 非也。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061100
    m_Localized: 'NotTrue: 生活自然會將你所需要的人帶進你的生命之中，我們並不會與他人擦肩而過。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061101
    m_Localized: 'NotTrue: 既然我最終抵達了此處，就意味著是我的雙腿還有雙眼指引我來到了這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255104
    m_Localized: 'NotTrue: 我想，這就是所謂的命中註定吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255105
    m_Localized: 不好意思，我沒聽懂。請問，你有什麼需要嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255106
    m_Localized: 既然如此，你大可繼續走下去——為何要在我這裡停下？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255107
    m_Localized: 'NotTrue: 我也不清楚自己到底走了多久。歸根到底，「久」又究竟意味著什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255108
    m_Localized: 'NotTrue: 就比如你。雖然你一直待在自己的家裡，不過肯定也免不了要在其中走來走去。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255109
    m_Localized: 'NotTrue: 既然如此，你不也走了很久嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255110
    m_Localized: 'NotTrue: 不過，這麼說好了——我走過的橋，遠比你走過的路還要更長。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255111
    m_Localized: 'NotTrue: 就是這樣，寶貝。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255112
    m_Localized: 不好意思，我沒聽懂。請問，你有什麼需要嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255113
    m_Localized: 既然如此，你大可繼續走下去——為何要在我這裡停下？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255114
    m_Localized: 'NotTrue: 大家又有什麼需要呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255115
    m_Localized: 'NotTrue: 聽他人說說自己的故事，彼此分享一些閒談笑料。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255116
    m_Localized: 'NotTrue: 然後躺下，滿懷幸福地閉上雙眼。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255117
    m_Localized: 'NotTrue: 正常地呼吸。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255118
    m_Localized: 'NotTrue: 至於我，則什麼都不需要。我只是厭倦了一個人生活罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255119
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255120
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255121
    m_Localized: 'NotTrue: 看來你沒有認真聽我講話，孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255122
    m_Localized: 'NotTrue: 我走累了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255123
    m_Localized: 'NotTrue: 起碼，我能在這裡喘口氣、聊聊天。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255124
    m_Localized: 'NotTrue: 對於像我這樣的老太婆來說，已經足以消遣了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255125
    m_Localized: 'NotTrue: 跟我分享一些故事，然後我也會跟你說說自己過往的經歷。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255126
    m_Localized: 'NotTrue: 與此同時，我還能稍微閉目養神一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255127
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255128
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255129
    m_Localized: 'NotTrue: 謝謝，寶貝！'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255130
    m_Localized: 'NotTrue: 看來，我應該不會對你感到厭倦。起碼，我可以看看這裡到底發生了什麼事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255131
    m_Localized: 'NotTrue: 無論我走到何處，都不被大家接納。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255132
    m_Localized: 'NotTrue: 雖說我的翅膀已經被折斷，然而卻還是可以引吭高歌。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255133
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255134
    m_Localized: 'NotTrue: 雖然他們嘴上說著絕不，不過到頭來還是會不情不願地向我尋求幫助。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255135
    m_Localized: 'NotTrue: 我也並不記仇，會平等地向每一個人伸出援手。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255136
    m_Localized: 'NotTrue: 而即便是你，也會有需要向他人尋求幫助的一天。到時，你又會去找誰呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255137
    m_Localized: 'Twins: 你好。哎呀，先挨著我吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255138
    m_Localized: 'Twins: 你這裡……有沒有地方可以讓我們待一下呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255139
    m_Localized: 請問，你的同伴是生病了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255140
    m_Localized: 請問，你們兩個都生病了嗎？抑或，只是其中一位而已呢？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255141
    m_Localized: 'Twins: 她是我的姊妹，患有重度抑鬱。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255142
    m_Localized: 'Twins: 既沒辦法走路、也沒辦法自己洗澡，甚至有時連起床都成問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255143
    m_Localized: 'Twins: 不過，沒關係——總有一天會好起來的。對吧，姊妹？'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255144
    m_Localized: 'Twins: 她現在不是很想說話，不過……總會打起精神來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255145
    m_Localized: 接下來，你們有什麼打算？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255146
    m_Localized: 這樣背著她走來走去，不累嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255147
    m_Localized: 'Twins: 我們都患有不同程度的抑鬱。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255148
    m_Localized: 'Twins: 早在太陽引發這次災變之前，我們就知道事態會如何發展。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255149
    m_Localized: 'Twins: 不知，你是否有持續關注新聞？一切的一切都在指向現在的這個結果。不過，我並不認為太陽真的會爆炸就是了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255150
    m_Localized: 接下來，你們有什麼打算？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255151
    m_Localized: 這樣背著她走來走去，不累嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255152
    m_Localized: 'Twins: 我得找個讓她能感到稍微自在一些的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255153
    m_Localized: 'Twins: 然後開啟屬於我們自己的嶄新篇章。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255154
    m_Localized: 'Twins: 大家都說，再也沒有什麼生活、只有生存了……'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255155
    m_Localized: 'Twins: 而我，並不這麼認為。非要說的話，也該觸底反彈、越來越好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255156
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255157
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255158
    m_Localized: 'Twins: 注意你的言辭。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255159
    m_Localized: 'Twins: 沒錯，這樣的確很累。不過，我絕對不會棄她於不顧——要是……這就是你的弦外之音的話。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255160
    m_Localized: 'Twins: 我們一起離開了父母的房子，如今只剩下彼此相依為命了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255161
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255162
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255163
    m_Localized: 'Twins: 謝謝！還請幫忙一起帶她進去。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255164
    m_Localized: 'Twins: 父母的去世似乎令她變得比以往要更為脆弱，不過這種狀態其實已經維持很長一段時間了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255165
    m_Localized: 'Twins: 或許，她能在這裡稍微振作起來。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255166
    m_Localized: 'Twins: 哎呀。好吧，姊妹——看來我們要找找看有沒有其他的地方可以讓我們進去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255167
    m_Localized: 'Twins: 好啦，走吧——幫幫忙。'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255168
    m_Localized: 'Twins: 天啊，這一切何時才會結束……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714688
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714689
    m_Localized: 'Firefighter: 我這裡有一份文件，是出發前往救火之前收到的。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714690
    m_Localized: 'Firefighter: 要大家去FEMA隔離區。只是，要是每個去了的人都只有死路一條的話，誰還會去……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714691
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714692
    m_Localized: 'Firefighter: 來，收下吧……反正我也用不上它。要嘛丟掉，要嘛拿來做別的用途——由你決定。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714693
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714694
    m_Localized: 'Firefighter: 我身上有一份*咳嗽*文件。算是挺重要的。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714695
    m_Localized: 'Firefighter: 如果你願意收留我，讓我平靜地度過最後的日子——我可以把它給你……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714696
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714697
    m_Localized: 不了，你還是留著吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714698
    m_Localized: 'Wheelchair: 搞什麼鬼？'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714699
    m_Localized: 'Wheelchair: 看在你是個體面人的份上……這樣好了——也許，一罐EnerJeka可以改變你的想法？'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714700
    m_Localized: 'Wheelchair: 一路推著這個輪椅到這裡來，實在是把我給累了個半死！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714701
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714702
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714703
    m_Localized: 'Wheelchair: 謝謝你允許我進去，朋友！來——收下這罐EnerJeka吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908992
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908993
    m_Localized: 'Anger: 該死……該死……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908994
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908995
    m_Localized: 'Anger: 聽我說，我他媽真想……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908996
    m_Localized: 'Anger: 要不，這樣好了——我給你一罐EnerJeka，你讓我進去怎麼樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908997
    m_Localized: 'Anger: 我能活下來，你有飲料喝……這樣大家他媽的都開心。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908998
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908999
    m_Localized: 滾蛋
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909000
    m_Localized: 'Anger: 別擔心我……我只是……該死……總之……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909001
    m_Localized: 'Anger: 收下這罐EnerJeka吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909002
    m_Localized: 'Anger: 我得冷靜下來，因此——媽的，不會去喝這東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909003
    m_Localized: 'Anger: 看來，{0}已經在這裡了。看得出來——顯然，大家都在小聲說話、費盡心思不讓彼此難過。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909004
    m_Localized: 'Anger: 然而，我實在沒有辦法跟這個傢伙共處一室。要嘛是他，要嘛是我——其中一個必須得走。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909005
    m_Localized: 'Anger: 我無法與什麼事情都憋在自己心裡的傢伙住在一起。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909006
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909007
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909008
    m_Localized: 'Anger: 你的耐心還真是不得了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909009
    m_Localized: 'Anger: 要是出什麼事了的話，就指望你站出來主持大局了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909010
    m_Localized: 'Anger: 我會試著……你也知道，冷靜下來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909011
    m_Localized: 'Anger: 好極——真他媽棒到家了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909012
    m_Localized: 'Anger: 看來……跟那些已經待在這裡的傢伙套近乎會令你更好受一些，是吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909013
    m_Localized: 'Anger: 去你的吧！該死的馬屁精，下地獄吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909014
    m_Localized: 'Fanatic: 這是神聖太陽親自給的慷慨獎賞。你值得擁有這個，老兄。收下這罐EnerJeka吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909015
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909016
    m_Localized: 'Fanatic: 你到底有多蠢？'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909017
    m_Localized: 'Fanatic: 你不該趕我走，我可是正義人士！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909018
    m_Localized: 'Fanatic: 因為讓我進去，你將得到神聖太陽親自給的慷慨獎賞。重新考慮一下，兄弟！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909019
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909020
    m_Localized: 滾蛋
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297600
    m_Localized: 'Super: 沒人知道最後一個訪客到達時發生了什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297601
    m_Localized: 'Super: 這棟房子已經很長時間沒有人居住了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297602
    m_Localized: 'Super: 在你恐怖地消失之後，每個人對這棟廢棄的房子都退避三舍。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297603
    m_Localized: 'NotTrue: 哎呀，寶貝……瞧瞧這是誰，{0}？'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297604
    m_Localized: 'NotTrue: 前一刻還鬧哄哄的、一片混亂，下一刻就只剩暗處的竊竊私語。這個樣子，實在是令我這個老太婆感到害怕。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297605
    m_Localized: 'NotTrue: 你也知道——我之所以會獨自上路，當然是有原因的。我不喜歡待在充斥著叫喊聲、擠滿了其他人的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297606
    m_Localized: 'NotTrue: 要是你更喜歡這些傢伙的話，也沒問題。我會好好地待在房子外頭，直到這一切都平靜下來。唉……寶貝，我向來不習慣面對這些風風雨雨。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297607
    m_Localized: 'NotTrue: 我這副老骨頭實在是受不了囉，怕是一下子就會化為塵埃、灰飛煙滅。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297608
    m_Localized: 我會把對方掃地出門的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297609
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297610
    m_Localized: 'NotTrue: 我是說，如果是這樣的話，我會試試。但如果又聞到麻煩或謊言的味道，我就離開。我太老了，禁不起這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297611
    m_Localized: 'NotTrue: 嗯，你知道，我覺得我不屬於這裡。所以……我會收拾我的故事，然後離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297612
    m_Localized: 'NotTrue: 不過要保持警惕。有時真相是安靜的，但卻也是致命的。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297613
    m_Localized: 'Twins: 請……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297614
    m_Localized: 'Twins: 請讓我們進去，只是一天也好。我們帶著一些你應該會感興趣的東西……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297615
    m_Localized: 'Twins: 我們會給你相應的報酬……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297616
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297617
    m_Localized: 滾蛋
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297618
    m_Localized: 'Twins: 非常感謝！'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297619
    m_Localized: 'Twins: 來——收下這罐EnerJeka吧。這是我們僅剩的東西了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297620
    m_Localized: 'Twins: 好了……能幫忙把我的姊妹給扶進去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297621
    m_Localized: 'Twins: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297622
    m_Localized: 'Twins: 這……恐怕不好，{0}在這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297623
    m_Localized: 'Twins: 空氣比預期中還要更加沉重，就好像是被對方支配了一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297624
    m_Localized: 'Twins: 我的姊妹無法應付這種環境——她會……縮回自己的殼裡，就彷彿根本不存在一般。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297625
    m_Localized: 'Twins: 而且，我……也感到有點吃力。甚至開始覺得呼吸困難。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297626
    m_Localized: 'Twins: 抱歉。不過——我想，我們還是先等……對方冷靜下來再說吧。或許，會有什麼轉機也說不定。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297627
    m_Localized: 我會把對方掃地出門的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297628
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297629
    m_Localized: 'Twins: 謝謝。當心——確保你的手放在她的背後……就像這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297630
    m_Localized: 'Twins: 我覺得，父母的死亡……在她心中造成了某種創傷。不過，她正盡己所能、努力撐著。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297631
    m_Localized: 'Twins: 我們出來已經有一段時間了，希望她至少在這裡能感覺好點。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297632
    m_Localized: 'Twins: ……知道了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297633
    m_Localized: 'Twins: 姊妹——再撐一會，好嗎？來，我們會找到可以歇腳的地方的。我答應你。來，靠著我吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297634
    m_Localized: 'Twins: 三不五時，這一切……令人感到難以忍受。哪怕只是一扇緊閉的門。不過，即便如此——我們還是得繼續前進。走吧……我來扶你。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158001
    m_Localized: 'Tourist: 好吧……真是遺憾。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158000
    m_Localized: 'Tourist: 非常感謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157995
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157998
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157999
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157997
    m_Localized: 'Tourist: 你收留了{0}……我想，我們應該沒有辦法好好相處。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157996
    m_Localized: 'Tourist: 抱歉，先生。我恐怕沒有辦法進來。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157994
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157993
    m_Localized: 'Alt: 現在，能讓我進去了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157992
    m_Localized: 'Alt: 好吧……不知，你是否需要{0}？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157991
    m_Localized: 'Alt: 我習慣了——我也已經看出你在玩什麼把戲了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157990
    m_Localized: 'Alt: 真是討厭——好處總讓混蛋佔了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157989
    m_Localized: 'Alt: 距離日出還有點時間，我還可以去找其他人。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157988
    m_Localized: 'Alt: 好吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157987
    m_Localized: 'Alt: 謝謝。雖然不太抱希望，但——真的非常感激。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157986
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157985
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157984
    m_Localized: 'Alt: 總之，我們是不可能共處一室的。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157983
    m_Localized: 'Alt: 說來話長，而且……現在也不方便展開細講。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157982
    m_Localized: 'Alt: 哎呀，你收留了{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157981
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157980
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157979
    m_Localized: 'FunnyGuy: 能再重新考慮一下嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157978
    m_Localized: 'FunnyGuy: 好，找到了——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157977
    m_Localized: 'FunnyGuy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157976
    m_Localized: 'FunnyGuy: 來，拿著這……我帶了什麼來著？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157975
    m_Localized: 'FunnyGuy: 好吧，這是我最後一次上這種當了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157974
    m_Localized: 'FunnyGuy: 兄弟，你讓我想起了那些死板的銀行。唉……媽的。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157973
    m_Localized: 'FunnyGuy: 我這就走。距離日出還有一段時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157972
    m_Localized: 'FunnyGuy: 嘖……好吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157971
    m_Localized: 'FunnyGuy: 來一起為債務的徹底消失而乾杯吧，怎樣？哈哈哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157970
    m_Localized: 'FunnyGuy: 就是這樣！'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157969
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157968
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157967
    m_Localized: 'FunnyGuy: 我這輩子遇到的倒楣事已經夠多了。起碼……不要讓這裡也變成那樣，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157966
    m_Localized: 'FunnyGuy: 看到了嗎？{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157965
    m_Localized: 'FunnyGuy: 拜託……你收留了一個會把氣氛給搞砸的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157964
    m_Localized: 'Fairytaller: 好的，我明白了。保重。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157963
    m_Localized: 'Fairytaller: 不過——非常感謝你的信任！'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157962
    m_Localized: 'Fairytaller: 什麼？謝謝！其實，你根本沒必要這樣大費周章的……我大可試著去找找看有沒有別的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157961
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157960
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157959
    m_Localized: 'Fairytaller: 然而……我恐怕沒有辦法跟{0}共處一室。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157958
    m_Localized: 'Fairytaller: 我知道我已經耽誤了你相當長的一段時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157957
    m_Localized: 'Fairytaller: 而且，說實在的——我覺得當時錯不在我。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157956
    m_Localized: 'Fairytaller: 非常感謝！只是……之前，我在咖啡廳兼職時、跟某人有過一點摩擦。而這個人，就在這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157955
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157954
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157953
    m_Localized: 'Leper: 好吧。要是……我能給你提供點什麼東西的話，又該怎樣。譬如，{0}——好了，這下……能讓我進去了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157952
    m_Localized: 'Leper: 罷了。無論如何，你說了算——我先走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769382
    m_Localized: 'Leper: 你真的認為……那些拿別人的外貌開玩笑的傢伙，有資格待在這裡？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769381
    m_Localized: 'Leper: 謝謝。我真的再也不想忍受這種事情了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769380
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769379
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769378
    m_Localized: 'Leper: 你收留了{0}——從前，就是這些傢伙一天到晚因為我的長相而欺負我。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769377
    m_Localized: 'Leper: 抱歉，但……我恐怕沒有辦法進來。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769376
    m_Localized: 'Nervous: 要是圍繞在你身邊的傢伙都是一群混蛋的話，你也很有可能不是什麼好東西！嘻嘻！'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769375
    m_Localized: 'Nervous: 也許——不跟你在一起，反而是件好事。沒錯……'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769374
    m_Localized: 'Nervous: 真假？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769373
    m_Localized: 'Nervous: 沒有必要自找麻煩。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769372
    m_Localized: 'Nervous: 雖然聽起來不是很可靠，不過……很好！嘻嘻！'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769371
    m_Localized: 'Nervous: 很好……'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769370
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769369
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769368
    m_Localized: 'Nervous: 我很清楚……'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769367
    m_Localized: 'Nervous: 他是個徹頭徹尾的瘋子。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769366
    m_Localized: 'Nervous: 我知道上個月發生了什麼事——真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769365
    m_Localized: 'Nervous: 哎呀……你收留了{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769364
    m_Localized: 'Bald: 好好保重。希望你能撐過這團亂局。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769363
    m_Localized: 'Bald: 好吧，朋友。我能理解。千萬不要因此而感到有負擔。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769362
    m_Localized: 'Bald: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769361
    m_Localized: 'Bald: 該死。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769360
    m_Localized: 'Bald: 將人掃地出門……一定非常尷尬，我能理解。只是，人生就是這樣——我們沒有辦法每時每刻都當個好人。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769359
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769358
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769357
    m_Localized: 'Bald: 沒錯，就是{0}。或許，我們應該……將其趕走？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769356
    m_Localized: 'Bald: 兄弟，我給誰都能處得來——真的。然而，這個傢伙……我實在是沒轍。全身上下都散發出危險的氣息。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769355
    m_Localized: 'Tough: 真是……令人失望。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769354
    m_Localized: 'Tough: 沒想到，竟然是個孬種。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769353
    m_Localized: 'Tough: 搞什麼鬼？我還以為你是個有骨氣的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769352
    m_Localized: 'Tough: 看來，對方也沒有什麼反抗的力氣——畢竟，你輕而易舉地就將其掃地出門了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769351
    m_Localized: 'Tough: 嗯……沒想到，你真的把這個傢伙給趕出去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769350
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769349
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769348
    m_Localized: 'Tough: 要嘛將這個傢伙轟走，要嘛……我自己去找別的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769347
    m_Localized: 'Tough: 你收留了……{0}？'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769346
    m_Localized: 'Jacket: 好吧，我得趕緊走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769345
    m_Localized: 'Jacket: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769344
    m_Localized: 'Jacket: 該死……再這樣下去，我會被FEMA找到的。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722946
    m_Localized: 'Tourist: 我就不該到這裡來……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722945
    m_Localized: 'Tourist: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722944
    m_Localized: 'Tourist: 該死……我到底該去哪裡？附近的房子我都已經挨家挨戶地問過了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722943
    m_Localized: 'Tourist: 非常感謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722942
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722941
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722940
    m_Localized: 'Tourist: 拜託，讓我在這裡待一陣子吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722939
    m_Localized: 'Tourist: 現在，我已經沒有地方可去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722938
    m_Localized: 'Tourist: 我之前曾經住過一陣子的飯店。然而……錢花光了，只得離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722937
    m_Localized: 'Tourist: 沒有……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722936
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722935
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722934
    m_Localized: 'Tourist: 只是，現在說什麼都遲了。而且，我也住不起飯店。拜託，讓我在這裡待一陣子吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722933
    m_Localized: 'Tourist: 唉……我也知道。相信我——如果我知道太陽會變成現在這樣，是絕對不可能會到這裡來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722932
    m_Localized: 你真的沒有地方可去了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722931
    m_Localized: 你……來得還「真是時候」
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722930
    m_Localized: 'Tourist: 我只是路過而已——真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722929
    m_Localized: 'Tourist: 然而，政府卻關閉了邊境……我就被困在這裡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722928
    m_Localized: 'Tourist: 我本來想前往首都，計劃進行一趟旅程……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722927
    m_Localized: 你真的沒有地方可去了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722926
    m_Localized: 你……來得還「真是時候」
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722925
    m_Localized: 'Tourist: 機場已經被關閉了，火車也沒有在運行。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722924
    m_Localized: 'Tourist: 出問題了。我沒有辦法離開這座城市。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722923
    m_Localized: 你是怎麼到這裡來的？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722922
    m_Localized: 怎麼了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722921
    m_Localized: 'Tourist: 你好——能幫幫我嗎？我並不是本地人。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722920
    m_Localized: 'Alt: 好吧，我得走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722919
    m_Localized: 'Alt: 附近應該還有其他房子。或許，會有房主願意忽略我的面容、表現得更像是一個正派的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722918
    m_Localized: 'Alt: 唉……這一週簡直糟透了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722917
    m_Localized: 'Alt: 我已經筋疲力盡，明天再繼續聊吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722916
    m_Localized: 'Alt: 很好。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722915
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722914
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722913
    m_Localized: 'Alt: 最糟糕的是——每當聽到一則報導，你都會意識到得把災情乘以五……不對，甚至得乘以十，你所得到的才會是真相。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722912
    m_Localized: 'Alt: 整天盯著電視並不會讓事情變得好過一些。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722911
    m_Localized: 'Alt: 雖然不太確定你這裡還有沒有電，但——如果沒有，反而更好。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722910
    m_Localized: 'Alt: 首先……夜幕降臨之後，這裡的空氣會變得比較涼快。其次，也沒有人會一天二十四小時都緊盯著新聞看。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722909
    m_Localized: 'Alt: 我就省去繁文縟節，直接跟你說重點了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722908
    m_Localized: 'Alt: 沒錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722907
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722906
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722905
    m_Localized: 'Alt: 我不想待在「原爆點」。我不想被捲進其中。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722904
    m_Localized: 'Alt: 我覺得……很快就會爆發嚴重的混亂。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722903
    m_Localized: 'Alt: 現在的這個情況……拖得越久，就會越糟。空氣每況愈下、犯罪事件飆升，住在公寓裡的人整天都在疑神疑鬼——被逼瘋只是時間問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722902
    m_Localized: 'Alt: 而且，我有一種預感：城市很快將不再安全。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722901
    m_Localized: 'Alt: 我只是不喜歡繁文縟節而已，這樣反而能更好地直切主題。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722900
    m_Localized: 'Alt: 你為什麼會覺得我在躲避什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722899
    m_Localized: 你覺得這裡會好一些？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722898
    m_Localized: 你在躲避什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722897
    m_Localized: 'Alt: 我的面容說明不了什麼問題。我從來沒想過要傷害任何人。與此同時，我也希望你不是那種會以貌取人的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722896
    m_Localized: 'Alt: 我並沒有做見不得光的事情。如果你是想要對我進行批判，麻煩就此打住。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722895
    m_Localized: 'Alt: 真沒禮貌。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722894
    m_Localized: 你覺得這裡會好一些？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722893
    m_Localized: 你在躲避什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722892
    m_Localized: 'Alt: 要對付四處遊蕩的瘋子和偽人就已經讓人焦頭爛額了，現在……甚至連太陽都要來跟我們作對。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722891
    m_Localized: 'Alt: 遭殃的不僅僅是城裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722890
    m_Localized: 'Alt: 我只是……聽說城郊一帶正在發生什麼糟糕的事情而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722889
    m_Localized: 'Alt: 不、不，我並不是說這裡看起來像是已經廢棄了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722888
    m_Localized: 你還真是大膽
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722887
    m_Localized: 怎麼，裡面看起來像是沒有人的樣子嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722886
    m_Localized: 'Alt: 哎呀……原來有人。能讓我進去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722885
    m_Localized: 'FunnyGuy: 好吧，我會想出辦法的——距離日出還有點時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722884
    m_Localized: 'FunnyGuy: 媽的。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722883
    m_Localized: 'FunnyGuy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722882
    m_Localized: 'FunnyGuy: 無論如何都不行嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722881
    m_Localized: 'FunnyGuy: 你應該無法想像吧——今天對我來說有多麼的重要！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722880
    m_Localized: 'FunnyGuy: 就是這樣！來喝上幾杯，慶祝一下吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722879
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722878
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722877
    m_Localized: 'FunnyGuy: 好了，到底能不能讓我進去呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722876
    m_Localized: 'FunnyGuy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722875
    m_Localized: 'FunnyGuy: 如果能有一棟像這樣的房子，我肯定可以過上自己心目中的理想生活。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722874
    m_Localized: 'FunnyGuy: 罷了，無所謂啦。畢竟，欠債的又不是自己——對吧？而且，還有一個這麼不錯的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722873
    m_Localized: 'FunnyGuy: 我能說什麼呢？顯然，你並沒有替我感到高興。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722872
    m_Localized: 看來，你不太愛說話
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722871
    m_Localized: 'FunnyGuy: 我並不喜歡這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722870
    m_Localized: 'FunnyGuy: 好吧，我聽出了諷刺的意味。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722869
    m_Localized: 看來，你不太愛說話
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722868
    m_Localized: 'FunnyGuy: 無意冒犯。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722867
    m_Localized: 'FunnyGuy: 然而……我不太想在公開場合談論這個話題。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722866
    m_Localized: 'FunnyGuy: 只能說，問得好。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722865
    m_Localized: 好吧——既然省下了一大筆錢，你打算要怎麼去花呢？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722864
    m_Localized: 好吧……那麼，你來這裡做什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722863
    m_Localized: 'FunnyGuy: 真是令人神清氣爽！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722862
    m_Localized: 'FunnyGuy: 整個世界都變得亂七八糟——根本就沒有人會再鳥銀行或者貸款這檔事了啦！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722861
    m_Localized: 'FunnyGuy: 我已經解脫了！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722860
    m_Localized: 'FunnyGuy: 然而，現在！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722859
    m_Localized: 'FunnyGuy: 從那之後，一切都在走下坡路。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722858
    m_Localized: 'FunnyGuy: 哎呀，事情是這樣的——我之前欠了一屁股債。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722857
    m_Localized: 好吧——既然省下了一大筆錢，你打算要怎麼去花呢？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722856
    m_Localized: 好吧……那麼，你來這裡做什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722855
    m_Localized: 'FunnyGuy: 就好像壓在心上的石頭突然不見了一樣。你根本無法想像這是一種什麼樣的感覺。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722854
    m_Localized: 'FunnyGuy: 朋友……不對，兄弟——我的房貸已經不再是個問題了！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722853
    m_Localized: 'FunnyGuy: 哎呦，不要這樣！你只是暫時還沒搞懂而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722852
    m_Localized: 你為什麼這麼興奮？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722851
    m_Localized: 你是瘋了還是怎樣？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722850
    m_Localized: 'FunnyGuy: 真是一個不錯的夜晚。你說是吧？瞧瞧——洋溢在空中的滿滿魔力！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722849
    m_Localized: 'FunnyGuy: 嘿、嘿、嘿，你好！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722848
    m_Localized: 'Fairytaller: 好吧，我知道了。保重。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722847
    m_Localized: 'Fairytaller: 能得知世上依然存在好人、而不是只會出現在故事裡，真好。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722846
    m_Localized: 'Fairytaller: 非常感謝——大恩大德，沒齒難忘！'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722845
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722844
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722843
    m_Localized: 'Fairytaller: 我從來沒有想過成年人的生活會如此艱難……而且，我已經沒有地方可去了……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722842
    m_Localized: 'Fairytaller: 我一定會報答你的。而且，我現在就能幫上忙——只要是我能做到的，都一定會盡量完成。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722841
    m_Localized: 'Fairytaller: 我知道自己沒有什麼可以給你，但……拜託，請你重新考慮一下吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722840
    m_Localized: 'Fairytaller: 我明白了……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722839
    m_Localized: 趕緊離開吧——我這裡不需要吃白食的傢伙
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722838
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722837
    m_Localized: 'Fairytaller: 雖然我應該無法成為受人傳頌的救世主，但——不管是在哪個故事裡，正義都會取得最終的勝利。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722836
    m_Localized: 'Fairytaller: 要是能有一名英雄挺身而出、擊退邪魔，令一切都恢復原樣的話，就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722835
    m_Localized: 'Fairytaller: 人們感到恐懼、紛紛躲藏起來，不再相信彼此……'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722834
    m_Localized: 'Fairytaller: 一切……感覺就像我們從小聽到大的童話一樣，就是那種邪惡席捲了整個世界的故事。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722833
    m_Localized: 'Fairytaller: 但——我覺得，我還是從前的那個我。起碼，我完全沒有任何想要傷害他人的念頭。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722832
    m_Localized: 'Fairytaller: 或許，我具備其中的一些特徵。只是……唉，我也不知道。最近，不管是什麼事情、都變得特別詭異。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722831
    m_Localized: 'Fairytaller: 其實，我根本就搞不懂偽人到底是什麼、也不清楚彼此之間有著什麼樣的不同。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722830
    m_Localized: 趕緊離開吧——我這裡不需要吃白食的傢伙
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722829
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722828
    m_Localized: 'Fairytaller: 我會盡己所能地幫你的忙，直至能重新站穩腳跟為止。而且，我可以保證——總有一天，我會償還你的這份恩情。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722827
    m_Localized: 'Fairytaller: 我不想成為任何人的負擔。然而……當處境變得艱難時，也只能想方設法活下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722826
    m_Localized: 'Fairytaller: 然後，很快就讓自己的半手足住了進去。我並不是說要怪他，只是……希望你可以理解我的處境。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722825
    m_Localized: 'Fairytaller: 因此，災變開始時、他就以沒有工作為由把我給趕了出去。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722824
    m_Localized: 'Fairytaller: 打從最開始，我的房東就不太願意將自己的房子租給一個沒有穩定收入的應屆畢業生。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722823
    m_Localized: 'Fairytaller: ……就像小時候一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722822
    m_Localized: 'Fairytaller: 當時局變得艱難時，人們總會希望自己能暫時擺脫一切……變得無憂無慮，哪怕只有一瞬也好。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722821
    m_Localized: 'Fairytaller: 唉……那些在夜店找到工作的人就走運囉。畢竟，現在的這個情況、看起來的確對他們有利。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722820
    m_Localized: 'Fairytaller: 然而，自從這一切發生後、就沒有客人上門了，我們也因此被裁掉。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722819
    m_Localized: 'Fairytaller: 我剛剛從大學畢業，但……我的專業不太好找工作。於是，我就去一間小咖啡廳兼了幾個班次。'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722818
    m_Localized: 我怎麼知道你是不是偽人？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722817
    m_Localized: 你為什麼會到這個地方來？
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722816
    m_Localized: 'Fairytaller: 晚安。不知，你這裡是否還能再容納一人？我不會有太多的要求。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039811
    m_Localized: 'Leper: 好吧，隨你的便——我這就走。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039810
    m_Localized: 'Leper: 謝謝你……願意讓我進去，也沒有因為我長這副樣子而大驚小怪。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039809
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039808
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039807
    m_Localized: 'Leper: 好了……到底能不能讓我進去呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039806
    m_Localized: 'Leper: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039805
    m_Localized: 'Leper: 因為，我知道自己是什麼——我絕對不是它們的一員。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039804
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039803
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039802
    m_Localized: 'Leper: 好了……到底能不能讓我進去呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039801
    m_Localized: 'Leper: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039800
    m_Localized: 'Leper: 隨便你吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039799
    m_Localized: 你為什麼能如此確定？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039798
    m_Localized: 就讓我們拭目以待吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039797
    m_Localized: 'Leper: 我很確定地說，我並不是偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039796
    m_Localized: 'Leper: 「不然，我想怎樣」？你這是什麼意思？拜託——你以為我是自願長成這個樣子的嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039795
    m_Localized: 你為什麼能如此確定？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039794
    m_Localized: 就讓我們拭目以待吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039793
    m_Localized: 'Leper: 我能理解，但——我真的不是偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039792
    m_Localized: 不然，你想怎樣？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039791
    m_Localized: 如今這個世道，人人都無比偏執、充滿妄想
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039790
    m_Localized: 'Leper: 我天生就是這個樣子，根本就沒有辦法改變。然而……不知為何，大家都因此覺得我是偽人。太荒謬了。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039789
    m_Localized: 'Leper: 問題就出在這。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039788
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039787
    m_Localized: 不然，你想怎樣？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039786
    m_Localized: 如今這個世道，人人都無比偏執、充滿妄想
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039785
    m_Localized: 'Leper: 大家都覺得我得了什麼會傳染的怪病……甚至，把我當成偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039784
    m_Localized: 'Leper: 只是一生下來皮膚就不太好，僅此而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039783
    m_Localized: 'Leper: 不、不，完全沒有必要。問題就出在這——我根本沒有什麼毛病。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039782
    m_Localized: 你的皮膚怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039781
    m_Localized: 我該感到擔心嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039780
    m_Localized: 'Leper: 你好。呃，希望我的樣子沒有嚇到你……能讓我進去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039779
    m_Localized: 'Nervous: 嘻嘻。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039778
    m_Localized: 'Nervous: 你不會有好下場……記住我這句話吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039777
    m_Localized: 'Nervous: 你跟那些穿著實驗服、喜歡折磨人的混蛋……根本就沒什麼兩樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039776
    m_Localized: 'Nervous: 一個神神叨叨、思緒錯亂的怪人——我沒說錯吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039775
    m_Localized: 'Nervous: 看來……你也認為我是瘋子，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039774
    m_Localized: 'Nervous: 找到了一個能讓我躲過這些爛事的地方……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039773
    m_Localized: 'Nervous: 終於！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039772
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039771
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039770
    m_Localized: 'Nervous: 此外，我偶爾會聽到附近傳來槍響。我想……你應該挺重視安全的，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039769
    m_Localized: 'Nervous: 現在，我會試著……和新認識的人打好關係！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039768
    m_Localized: 'Nervous: 其中的一個傢伙因此得到了……報應。不過，我已經變得更加小心、更為謹慎了。嘻嘻！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039767
    m_Localized: 'Nervous: 每個人都在針對我——每、個、人……自從學生時代起，就是這個樣子了。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039766
    m_Localized: 'Nervous: 朋友？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039765
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039764
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039763
    m_Localized: 'Nervous: 我寧可回到飯店裡去。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039762
    m_Localized: 'Nervous: 因此……我可不想自討沒趣！嘻嘻！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039761
    m_Localized: 'Nervous: 雖說……他們的確曾經向我伸出過援手，然而現在卻無情地將我拒之門外！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039760
    m_Localized: 'Nervous: 對他們來說，我就是一個……意外。一不小心，就有了我——大概就是這樣的感覺。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039759
    m_Localized: 你沒有朋友嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039758
    m_Localized: 為何不去投靠自己的親戚？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039757
    m_Localized: 'Nervous: 之後……再跟你細說好了。嘻嘻。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039756
    m_Localized: 'Nervous: 飯店的房間小得要命，會讓我想起一些……不怎麼好的回憶。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039755
    m_Localized: 'Nervous: 你的這棟房子特別的大，足以容納各式各樣的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039754
    m_Localized: 'Nervous: 沒錯，這裡很棒、這裡更好。嘻嘻。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039753
    m_Localized: 你沒有朋友嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039752
    m_Localized: 為何不去投靠自己的親戚？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039751
    m_Localized: 'Nervous: FEMA來過，但……卻突然消失不見、沒了蹤跡。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039750
    m_Localized: 'Nervous: 雖然沒有什麼證據，不過……我認為她是個偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039749
    m_Localized: 'Nervous: 她把我嚇得夠嗆。嘻嘻。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039748
    m_Localized: 'Nervous: 那裡有個穿著黃色雨衣的女孩。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039747
    m_Localized: 'Nervous: 我不喜歡那個地方。我想要……換一個地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039746
    m_Localized: 你覺得這裡更好？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039745
    m_Localized: 為什麼呢？你不能直接回去嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039744
    m_Localized: 'Nervous: 我很……害怕，不想回去。我能在這裡待一段時間嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039712
    m_Localized: 'Tough: 你該不會是在測試我？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039711
    m_Localized: 'Tough: 改天，我們好好地聊聊吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039710
    m_Localized: 'Tough: 你知道嗎？即使我們的生活正在一點、一滴地分崩離析，能來到這個地方、成為其中的一員，我依然感到無比榮幸。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039709
    m_Localized: 'Tough: 太棒了！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039708
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039707
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039706
    m_Localized: 'Tough: 天上不會掉下餡餅——人生本該逆勢而為。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039705
    m_Localized: 'Tough: 要想活著，只能奮鬥。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039704
    m_Localized: 'Tough: 我只是在想——要是我們坐以待斃、任由事態發展下去，人類就完了。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039703
    m_Localized: 'Tough: 哎呀……如果給你造成了不好的印象，我很抱歉。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039702
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039701
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039700
    m_Localized: 'Tough: 人類曾經歷更為嚴峻的考驗。現在，又有什麼理由要放棄呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039699
    m_Localized: 'Tough: 不過……我絕非走投無路。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039698
    m_Localized: 'Tough: 哦，我懂了——你是想知道我為什麼會來這裡，對吧？哈……誰知道呢。也許我就是個瘋子吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039697
    m_Localized: 'Tough: 蛤？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039696
    m_Localized: 你聽起來就像是個瘋子
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039695
    m_Localized: 你也是走投無路的人嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039694
    m_Localized: 'Tough: 無論要付出什麼代價，我們都一定能活下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039693
    m_Localized: 'Tough: 對於這樣的地方，我沒有辦法視而不見。我想……你，還有我——我們的想法是一致的。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039692
    m_Localized: 'Tough: 說是——你不會任由偽人奪走本就屬於你的東西……生命。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039691
    m_Localized: 'Tough: 說是——要在這裡活下去，並不是什麼簡單的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039690
    m_Localized: 你聽起來就像是個瘋子
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039689
    m_Localized: 你也是走投無路的人嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039688
    m_Localized: 'Tough: 然而，你跟他們完全不同。你絕不會束手就擒。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039687
    m_Localized: 'Tough: 稍微大膽一點的，會選擇自我了斷——把槍頂在自己頭上，扣下扳機。至於其他的傢伙，則是一天、一天地慢慢腐朽下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039686
    m_Localized: 'Tough: 絕大多數的人都已經放棄了。他們太過軟弱，根本就沒有辦法存活。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039685
    m_Localized: 'Tough: 不、不，我並沒有在說笑。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039684
    m_Localized: 呃……他們到底是怎麼說我這裡的啊？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039683
    m_Localized: 謝謝？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039682
    m_Localized: 'Tough: 不過，我倒是挺敬重你的。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039681
    m_Localized: 'Tough: 會到這裡來的，要嘛是走投無路的人……要嘛是腦袋有洞的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039680
    m_Localized: 'Tough: 絕大多數的人都會躲著你的這棟房子。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346842873856
    m_Localized: 'Tough: 我聽說過你的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417961
    m_Localized: 'Jacket: 我剛好帶著{0}——來，拿去吧。雖然不是什麼貴重的東西，但……希望能派上用場。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417960
    m_Localized: 'Jacket: 非常感謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417959
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417958
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417957
    m_Localized: 'Jacket: 哎呀。抱歉，但……你收留了{0}。我實在是沒有辦法相信這類人……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417956
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417955
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417954
    m_Localized: 'Jacket: 不知道你有沒有需要，但——我剛好帶著{0}。能再重新考慮一下嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417953
    m_Localized: 'Jacket: 我不想碰上巡邏人員。更糟的是……我有可能會遇到偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417952
    m_Localized: 'Jacket: 不、不。拜託……讓我進去。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417951
    m_Localized: 'Jacket: 我剛好帶著{0}——來，拿去吧。雖然不是什麼貴重的東西，但……希望能派上用場。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417950
    m_Localized: 'Jacket: 非常感謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417949
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417948
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417947
    m_Localized: 'Jacket: 我真的不想被關進那裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417946
    m_Localized: 'Jacket: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417945
    m_Localized: 'Jacket: 我聽說遭到感染的人會被送往隔離區……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417944
    m_Localized: 'Jacket: 某天，他們突然出現、說要對大家進行檢查。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417943
    m_Localized: 'Jacket: FEMA……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417942
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417941
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417940
    m_Localized: 'Jacket: 我真的不想被關進隔離區裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417939
    m_Localized: 'Jacket: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417938
    m_Localized: 'Jacket: 他們開始把人聚集起來……而我……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417937
    m_Localized: 'Jacket: FEMA……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417936
    m_Localized: 你的宿舍怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417935
    m_Localized: 為什麼呢？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417934
    m_Localized: 'Jacket: 我之前住在大學的宿舍裡，但……已經待不下去了，只能離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417933
    m_Localized: 'Jacket: 對的。拜託……要是可以的話，就讓我進去吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417932
    m_Localized: 你的宿舍怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417931
    m_Localized: 為什麼呢？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417930
    m_Localized: 'Jacket: 至於宿舍……已經待不下去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417929
    m_Localized: 'Jacket: 我需要一個落腳的地方。我現在已經無處可去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417928
    m_Localized: 你在尋求庇護嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417927
    m_Localized: 你有什麼需要嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417926
    m_Localized: 'Jacket: 你好。拜託——能讓我進去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417925
    m_Localized: 'Experienced: 聰明。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417924
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417923
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417922
    m_Localized: 'Experienced: 沒錯，就是{0}。我很了解這種類型的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417921
    m_Localized: 'Experienced: 聽著，兄弟——你收留了一個麻煩人物。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417920
    m_Localized: 'Experienced: 再見，混帳。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417919
    m_Localized: 'Experienced: 好吧，你這個人也太無趣了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417918
    m_Localized: 'Experienced: 聰明。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417917
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417916
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417915
    m_Localized: 'Experienced: 總之，廢話也說夠了——你到底要不要讓我在這裡借住？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417914
    m_Localized: 'Experienced: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417913
    m_Localized: 'Experienced: 不光身無分文，而且……老伴甚至還跟某個混帳東西遠走高飛了。我連個能遮風、擋雨的地方都沒有。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417912
    m_Localized: 'Experienced: 刑期一滿，立即放人。沒得商量。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417911
    m_Localized: 'Experienced: 我倒是想，但——你以為他們會允許嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417910
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417909
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417908
    m_Localized: 'Experienced: 總之，廢話也說夠了——你到底要不要讓我在這裡借住？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417907
    m_Localized: 'Experienced: 比較偏遠，不會有什麼小混混到處打探。挺不錯的。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417906
    m_Localized: 'Experienced: 然後，我發現了這個地方——既乾淨、又安靜，而且還不為人所知。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417905
    m_Localized: 'Experienced: 不光身無分文，而且……老伴甚至還跟某個混帳東西遠走高飛了。我連個能遮風、擋雨的地方都沒有。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417904
    m_Localized: 'Experienced: 我無家可歸。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417903
    m_Localized: 為何不待在監獄裡？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417902
    m_Localized: 那麼——你跑到我這裡來，到底想要做什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417901
    m_Localized: 'Experienced: 看來，我又得回到街頭上了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417900
    m_Localized: 'Experienced: 現在？媽的，整個世界都已經瘋掉了。而且，太陽還毒得快要把我的蛋蛋給烤熟了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417899
    m_Localized: 'Experienced: 本來還想再待一陣子的……結果，他們把我給趕跑了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417898
    m_Localized: 'Experienced: 我蹲過幾次苦窯。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417897
    m_Localized: 為何不待在監獄裡？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417896
    m_Localized: 那麼——你跑到我這裡來，到底想要做什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417895
    m_Localized: 'Experienced: 而我？拜託，吃過的鹽比你吃過的飯還多。出獄後，我立即就把自己脫了個精光。現在，呼吸都變得更加順暢了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417894
    m_Localized: 'Experienced: 一個個的都把自己裹得嚴嚴實實，好像是在下雪還是怎樣。一群笨蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417893
    m_Localized: 'Experienced: 理由再明顯不過了——現在，外面熱得跟地獄一樣。我才想問呢……你們為什麼連這點都感受不到？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417892
    m_Localized: 你他媽是從哪裡來的？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417891
    m_Localized: 你怎麼只穿一條內褲就在外面走來走去？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417890
    m_Localized: 'Experienced: 能讓我進去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417889
    m_Localized: 'Rocker: 總有人會收留我。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417888
    m_Localized: 'Rocker: 去你媽的。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417887
    m_Localized: 'Rocker: 不過，唉……沒有吉他的話，感覺就是不一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417886
    m_Localized: 'Rocker: 好了，繼續搖滾吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417885
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417884
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417883
    m_Localized: 'Rocker: 沒錯——我指的就是{0}。將這個傢伙給趕走吧，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417882
    m_Localized: 'Rocker: 不、不，我是絕對不會與這種爛貨為伍的。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417881
    m_Localized: 'Rocker: 我會試著去其中一個好友的家裡借住。希望剩下的那幾個還好好地活著……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417880
    m_Localized: 'Rocker: 我能理解，兄弟。千萬不要因此而感到有負擔。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417879
    m_Localized: 'Rocker: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417878
    m_Localized: 'Rocker: ……不過，都聽你的——你的房子，你來做主！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417877
    m_Localized: 'Rocker: 謝了，兄弟。我偶爾會放音樂，希望你不要介意。要是能搞到一把吉他的話，我甚至能彈點東西給你聽。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417876
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417875
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417874
    m_Localized: 'Rocker: 而且，說實話——如果我是個偽人，早就已經破門而入、或是從窗戶溜進去了，但……我就只是站在這裡，僅此而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417873
    m_Localized: 'Rocker: 他們甚至把我的吉他給砸壞了。媽的，一群混帳。現在所發生的一切，正把人給逼成野獸。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417872
    m_Localized: 'Rocker: 本來，通宵彈奏就已經很累了。結果，一群怪咖還恰巧就在這個時候闖進了我們的地盤、看到什麼就拿什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417871
    m_Localized: 'Rocker: 因為我的確已經很久沒有閤上過眼睛了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417870
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417869
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417868
    m_Localized: 'Rocker: 聽說他們在附近發現了一個偽人。因此，正對這一帶進行全面檢查。我是沒什麼意見啦……只要沒人突然失控、把事情變得一團糟，就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417867
    m_Localized: 'Rocker: 沒有什麼可疑的物品啦。只有一台迷你音箱和幾瓶飲用水而已。要是你會彈吉他的話，我可以讓你使用這台音箱。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417866
    m_Localized: 你看起來……怎麼像是整整一週都沒睡過覺一樣？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417865
    m_Localized: 你都帶著些什麼東西？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417864
    m_Localized: 'Rocker: 現在的狀況……簡直一團糟。就像是在一間完全沒有安保措施的破舊酒吧接待頂級名流一樣！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417863
    m_Localized: 'Rocker: 對了——吃白食的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417862
    m_Localized: 'Rocker: 只要讓我在這裡待上個幾晚就好。放心，我不會賴著不走的。我並不是那種……呃，那個詞怎麼說來著？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417861
    m_Localized: 'Rocker: 兄弟——開個門吧，好嗎？太陽毒得就像直射而來的聚光燈一樣。再這樣下去，我的眼睛遲早會瞎掉。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417860
    m_Localized: 'Unstable: 好像還蠻有意思的。也許，我會試著加入其中、一探究竟。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417859
    m_Localized: 'Unstable: 然後，將他們投進火中！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417858
    m_Localized: 'Unstable: 聽說附近有個傢伙正在把人給聚集到一起、對他們進行洗腦。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417857
    m_Localized: 'Unstable: 好吧，我會去看看其他地方都發生了些什麼事。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417856
    m_Localized: 'Unstable: 千遍一律……無聊透頂。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417855
    m_Localized: 'Unstable: 好了，再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417854
    m_Localized: 'Unstable: 我很好奇——他究竟能靠這種扯到不行的把戲撈到多少好處？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417853
    m_Localized: 'Unstable: 聽說附近有個傢伙正在售賣空氣。笑死人了！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417852
    m_Localized: 'Unstable: 好吧，我會去其他的地方碰碰運氣。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417851
    m_Localized: 'Unstable: 好啦——作為補償，我會與你分享各式各樣的事情！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417850
    m_Localized: 'Unstable: 抱歉。我只是覺得這樣應該會超級好笑。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417849
    m_Localized: 'Unstable: 哈哈，其實——我根本就不知道那個傢伙到底是什麼人。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417848
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417847
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417846
    m_Localized: 'Unstable: 把事情搞得一團糟。唉……還是將這個傢伙給趕走比較好。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417845
    m_Localized: 'Unstable: 我不喜歡在那種人面前講自己的故事。他們會將聽到的一切都扭曲成別的東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417844
    m_Localized: 'Unstable: 哇哦……你收留了{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417843
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417842
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417841
    m_Localized: 'Unstable: 有了，{0}——你需要嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417840
    m_Localized: 'Unstable: 或者……很快就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417839
    m_Localized: 'Unstable: 要不要來一罐EnerJeka？此外，我還有一些其他的東西！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417838
    m_Localized: 'Unstable: 真是掃興。等等——我剛好帶著各式各樣的物資。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417837
    m_Localized: 'Unstable: 我也會把自己這一路上的所見、所聞與你分享。之後再好好地聊聊吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417836
    m_Localized: 'Unstable: 好了，能告訴我附近都發生了什麼事嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417835
    m_Localized: 'Unstable: 哎呀——太棒了！'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417834
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417833
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417832
    m_Localized: 'Unstable: 總之，我已經站累了。要是能讓我進去的話，我可以跟你說說自己這一路上的所見、所聞。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417831
    m_Localized: 'Unstable: 說實話，並不是什麼聰明的策略。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417830
    m_Localized: 'Unstable: 具體而言，就是處於驚慌失措的狀態。要嘛是無論如何都不願意開門，要嘛是看到什麼都會扣下扳機。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417829
    m_Localized: 'Unstable: 雖說是看過一些比較有意思的反應，然而……絕大多數的時候，都只是在重複同樣的事情而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417828
    m_Localized: 'Unstable: 我早就說過了——我只不過在觀察人們會怎樣求生罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417827
    m_Localized: 'Unstable: 你根本就沒有在聽我講話。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417826
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417825
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417824
    m_Localized: 'Unstable: 能讓我進去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417823
    m_Localized: 'Unstable: 不過，你的這棟房子好像還蠻有趣的。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417822
    m_Localized: 'Unstable: 直至找到我要找的東西為止……不管那到底是什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417821
    m_Localized: 'Unstable: 然後？我會再度出發，繼續前行。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417820
    m_Localized: 你是在逃避著什麼人物嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417819
    m_Localized: 然後，又該怎樣？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417818
    m_Localized: 'Unstable: 我們應該交流一下求生技巧。嘿嘿。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417817
    m_Localized: 'Unstable: 然而——我也一樣！看來，我們都摸索出了各自的生存之道。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417816
    m_Localized: 'Unstable: 也是。此時、此刻，你的確是活著。而且，還能跟我聊上幾句。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417815
    m_Localized: 'Unstable: 而你，則選擇待在這裡。你是認為……正因如此，自己才能安然無恙？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417814
    m_Localized: 你是在逃避著什麼東西嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417813
    m_Localized: 然後，又該怎樣？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417812
    m_Localized: 'Unstable: 我並不想落得這樣的結局。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417811
    m_Localized: 'Unstable: 無人問津。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417810
    m_Localized: 'Unstable: 只會獨自死去。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417809
    m_Localized: 'Unstable: 要是踡縮在自己公寓裡的話，就永遠也不可能會有所發現。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417808
    m_Localized: 'Unstable: 誰知道呢……也許，人類最後的希望就藏在你家裡的某個地方呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417807
    m_Localized: 'Unstable: 你應該能理解吧——走得越遠，找到解決辦法的機會就越大。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417806
    m_Localized: 'Unstable: 你這是什麼意思？'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417805
    m_Localized: 不管你在哪裡，麻煩都會找上門來
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417804
    m_Localized: 你不打算逃到安全的地方去嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417803
    m_Localized: 'Unstable: 我都在夜間行動，會趕在太陽把我烤成黑炭之前躲進屋裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417802
    m_Localized: 'Unstable: 而且，數量非常充足——能讓我喝上好一段時間。千萬別問我藏在了哪裡，我是絕對不會告訴你的。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417801
    m_Localized: 'Unstable: 我有值得信賴的EnerJeka。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417800
    m_Localized: 不管你在哪裡，麻煩都會找上門來
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417799
    m_Localized: 你不打算逃到安全的地方去嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417798
    m_Localized: 'Unstable: 我會不斷前行，直至力竭倒下、或是偽人把我給生吞活剝為止。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417797
    m_Localized: 'Unstable: 一場風暴正在醞釀。而我……有點好奇大家到底會怎麼面對。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417796
    m_Localized: 'Unstable: 某個遙遠的地方之類的吧。我沒有辦法在同一處久待。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417795
    m_Localized: 我這裡可沒有什麼充電器
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417794
    m_Localized: 你這麼興奮，是要去哪裡？
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417793
    m_Localized: 'Unstable: 我現在超級亢奮的！不過，EnerJeka好像沒有以前那麼有效了……我得充一下電。'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417792
    m_Localized: 'Unstable: 哎呀——有人在，太好了！'
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264643
    m_Localized: （收取訂單）
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264642
    m_Localized: （收取訂單）
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264641
    m_Localized: （收取訂單）
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264640
    m_Localized: （收取訂單）
    m_Metadata:
      m_Items: []
  - m_Id: 61235008206004224
    m_Localized: 跳過序幕
    m_Metadata:
      m_Items: []
  - m_Id: 58250202329374720
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 58250202325180416
    m_Localized: 'TV: 如果無法將有可能會是偽人的對象立即轉移至隔離區，只要開具強制到案通知即可。'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306408796160
    m_Localized: 'MushroomEater: 看來，節慶還是會如期而至……'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306387824640
    m_Localized: 'MushroomEater: 哎呦，我親愛的朋友……這可不好……'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692481
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692480
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177088
    m_Localized: 'CultistPriest: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205570
    m_Localized: 'Gasmask: 好了，再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205569
    m_Localized: 'Gasmask: 一定很辛苦吧——不僅是你，還有我們。要是這個街區就連半個人都沒有的話，我們到底該怎麼進行檢查？'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205568
    m_Localized: 'Gasmask: 就你一個人？'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336336011264
    m_Localized: 'Gasmask: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283083
    m_Localized: 'MushroomEater: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283082
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283081
    m_Localized: 'MushroomEater: 唉……好吧。也許，我只是在浪費時間而已……'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283080
    m_Localized: 'MushroomEater: 你好，我親愛的朋友。你是不是……忘了我交代你的事情？難道，你沒看到《笑容之書》中的提示嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311553
    m_Localized: 'Fanatic: {0}——只要能讓我進去，你就能獲得這份由偉大太陽親自給予的豐厚獎賞。如何，改變主意了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311552
    m_Localized: 'Fanatic: 這，是由偉大太陽親自給予的豐厚獎賞！收下吧——都是你應得的，兄弟！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656006
    m_Localized: 'Jacob: 你我……還會再次相遇。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656005
    m_Localized: 'Jacob: 然而，我是不會死的。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656004
    m_Localized: 'Jacob: 將人置於死亡邊緣，既不公正、也不道德。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656003
    m_Localized: 'Jacob: 你得知道：'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656002
    m_Localized: 'Jacob: 也許，你我……都是不朽之人。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656001
    m_Localized: 'Jacob: 像你這樣的人，一定可以在這場噩夢之中存活下來。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656000
    m_Localized: 'Jacob: 現在，已經沒有幾個人願意認真聽別人說話了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655999
    m_Localized: 'Jacob: 謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655998
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655997
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655996
    m_Localized: 'Jacob: 譬如……我知道偽人究竟是從哪裡來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655995
    m_Localized: 'Jacob: 而且，我會將一切如實告知。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655994
    m_Localized: 'Jacob: 我向你保證——只要等到FEMA離開了，我就會繼續上路、尋找女兒。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655993
    m_Localized: 'Jacob: 政府可不想讓大眾知道這些事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655992
    m_Localized: 'Jacob: 我知道了一些……不該知道的東西。因此，FEMA正在追捕我……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655991
    m_Localized: 'Jacob: 我需要找個地方住上幾天。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655990
    m_Localized: 'Jacob: 先等一下！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655989
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655988
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655987
    m_Localized: 'Jacob: 譬如……我知道偽人究竟是從哪裡來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655986
    m_Localized: 'Jacob: 而且，我會將一切如實告知。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655985
    m_Localized: 'Jacob: 然後，我就會繼續上路、尋找女兒。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655984
    m_Localized: 'Jacob: 能讓我在這裡借住幾天嗎？只要待到FEMA離開了就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655983
    m_Localized: 'Jacob: 要真是這樣的話，他們應該不會動她一根手指頭。畢竟，他們要找的人是我。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655982
    m_Localized: 'Jacob: 我的女兒說不定是被那群混蛋抓到了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655981
    m_Localized: 'Jacob: 其實……我知道了一些不該知道的事情。因此，正在被追捕。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655980
    m_Localized: 'Jacob: 離這裡很遠。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655979
    m_Localized: 'Jacob: 某個FEMA找不到我們的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655978
    m_Localized: 她並不在這裡——再見
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655977
    m_Localized: 你們要去哪裡？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655976
    m_Localized: 'Jacob: 一旦找到了她，我們就會立即離開這座城市。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655975
    m_Localized: 'Jacob: 我不知道她去了哪裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655974
    m_Localized: 'Jacob: 自從這一系列的爛事開始之後，我就一直在打聽她的下落。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655973
    m_Localized: 'Jacob: 注意你的遣詞——她是我的女兒。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655972
    m_Localized: 她並不在這裡——再見
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655971
    m_Localized: 你們要去哪裡？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655970
    m_Localized: 'Jacob: 不光沒有留下字條，甚至找不到任何一點的痕跡……我的女兒憑空消失了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655969
    m_Localized: 'Jacob: 醒來之後，發現家裡空無一人。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655968
    m_Localized: 'Jacob: 突然，一股異常的熱浪襲來——我昏了過去……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655967
    m_Localized: 'Jacob: 我們本正準備離城……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655966
    m_Localized: 'Jacob: 自從這一系列得爛事開始之後，她就下落不明了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655965
    m_Localized: 'Jacob: 她是我的女兒。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655964
    m_Localized: 妓院在另一條街上
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655963
    m_Localized: 我們這裡沒有這樣的人
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655962
    m_Localized: 'Jacob: 請問……這裡有沒有一個披著斗篷、紫色頭髮的女孩？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655961
    m_Localized: 'Jacob: 你好。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655960
    m_Localized: 'StaticBoy: 錯誤的房子。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655959
    m_Localized: 'StaticBoy: 抱歉。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655958
    m_Localized: 'StaticBoy: 錯誤的味道。錯誤的聲音。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655957
    m_Localized: 'StaticBoy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655956
    m_Localized: 'StaticBoy: 錯誤的房子。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655955
    m_Localized: 'StaticBoy: 抱歉。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655954
    m_Localized: 'StaticBoy: 錯誤的味道。錯誤的聲音。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655953
    m_Localized: 'StaticBoy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655952
    m_Localized: 需要我幫忙找你的家嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655951
    m_Localized: 你在找什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655950
    m_Localized: 'StaticBoy: 歸根到底，大家……真的需要父母嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655949
    m_Localized: 'StaticBoy: 我根本就沒有父母。我從來都沒有父母。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655948
    m_Localized: 'StaticBoy: 我的父母？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655947
    m_Localized: 'StaticBoy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655946
    m_Localized: 需要我幫忙找你的家嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655945
    m_Localized: 你在找什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655944
    m_Localized: 'StaticBoy: 我聽到了腳步踩在地板上發出的吱呀聲。也就是說——有人正在等待。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655943
    m_Localized: 'StaticBoy: 我本來需要廚房的燈光。然而，這裡……卻有著不同的迴響。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655942
    m_Localized: 'StaticBoy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655941
    m_Localized: 'StaticBoy: 於黑暗中，每扇門看起來都一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655940
    m_Localized: 你的父母呢？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655939
    m_Localized: 你走丟了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655938
    m_Localized: 'StaticBoy: 他應該睡的……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655937
    m_Localized: 'StaticBoy: 他還沒睡嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655936
    m_Localized: 'StaticBoy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267400
    m_Localized: 'CultistPriest: 看顧好我的教徒。記住——要是其中一人死了的話……你的房子就會被燒成平地。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267399
    m_Localized: 'CultistPriest: 之後再見——晚點，我會來查看他們的狀況。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267398
    m_Localized: 'CultistPriest: 難道，你認為自己有得選？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267397
    m_Localized: 'CultistPriest: 之後再見——晚點，我會回來查看他們的狀況。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267396
    m_Localized: 'CultistPriest: 雖然不會在這裡打擾太長時間，不過……還是請你看護好我的教徒。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267395
    m_Localized: 'CultistPriest: 謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267394
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267393
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267392
    m_Localized: 'CultistPriest: 這些傢伙……會阻礙我們達成目標。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267391
    m_Localized: 'CultistPriest: {0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267390
    m_Localized: 'CultistPriest: {0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267389
    m_Localized: 'CultistPriest: 非常好。不過，你得先轟走一些住客：'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267388
    m_Localized: 'Courier: 祝你晚安……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267387
    m_Localized: 'Courier: 你訂購的商品已經送達——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267386
    m_Localized: （收取訂單）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267385
    m_Localized: 'Courier: 好了，收下你的訂單吧。我得走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267384
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267383
    m_Localized: 'Courier: 我已經受夠了，只希望這一切能趕緊結束……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267382
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267381
    m_Localized: 'Courier: 全都糟糕透頂……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267380
    m_Localized: 'Courier: 每天早上都要進行永遠做不完的常規檢查，而且還要被FEMA的工作人員拿槍給指著……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267379
    m_Localized: 'Courier: 每天晚上都會看到無數張疲憊、陰沉、痛苦的臉龐……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267378
    m_Localized: 'Courier: 還記得嗎？我之前說過，當配送員能幫忙將自己的注意力轉移開來。現在……好像已經不太奏效了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267377
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267376
    m_Localized: 'Courier: *嘆氣*'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267375
    m_Localized: （收取訂單）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267374
    m_Localized: 'Courier: 趕緊收下你的訂單吧，我得走了——免得也被你一槍給打死。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267373
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267372
    m_Localized: 'Courier: 哦，我懂了……你是想說，我的朋友被殺了是件好事？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267371
    m_Localized: 對此，我很遺憾
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267370
    m_Localized: 要知道……也沒有其他的辦法了
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267368
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267367
    m_Localized: 'Courier: 你訂購的商品已經送達——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267366
    m_Localized: （收取訂單）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267365
    m_Localized: 'Courier: 罷了，趕緊收下你的訂單吧。我得走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267364
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267363
    m_Localized: 'Courier: 媽的……真是謝謝你如此耿直的建議，實在是太有幫助了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267362
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267361
    m_Localized: （收取訂單）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267360
    m_Localized: 'Courier: 好了……來，收下你的訂單吧。我得走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267359
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267358
    m_Localized: 'Courier: 再這樣下去，哪天他們保不准會說就連陰毛也是偽人的特徵。到時，這個世界可就真的要完蛋了……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267357
    m_Localized: 'Courier: 我本以為一切已經不可能變得更糟了，結果……日子卻是一天過得比一天瘋狂。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267356
    m_Localized: 'Courier: 到處都是偽人，還有不斷公佈的各項特徵……更別提那該死的太陽。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267355
    m_Localized: 'Courier: 「好起來」？面對這種浩劫，你倒是跟我說說看、究竟要怎麼「好起來」？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267354
    m_Localized: 趕緊振作起來，好好地活下去——不要像個魯蛇一樣嘀嘀咕咕地抱怨個不停
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267353
    m_Localized: 沒有必要擔心，一切都會好起來的
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267352
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267350
    m_Localized: 'Courier: 你訂購的商品已經送達——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267349
    m_Localized: （收取訂單）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267348
    m_Localized: 'Courier: 好了。來，收下你的訂單吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267347
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267346
    m_Localized: 'Courier: 而且——要是沒人願意僱我的話，讀書又有什麼意義？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267345
    m_Localized: 'Courier: 無所謂了。當個配送員也沒什麼不好的。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267344
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267343
    m_Localized: 'Courier: 哼……你這裡住著一大票人呢，當然可以站著說話不腰疼。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267342
    m_Localized: 真是太糟糕了
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267341
    m_Localized: 獨自一人也沒有那麼糟糕啦
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267340
    m_Localized: 'Courier: 此外，我的家人也不在這邊——我並不是本地人，只是來上學的而已。因此，現在只有我一個……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267339
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267338
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267336
    m_Localized: 'Courier: 你訂購的商品已經送達——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267335
    m_Localized: （收取訂單）
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267334
    m_Localized: 'Courier: 抱歉，我扯遠了。來，收下你的訂單吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267333
    m_Localized: 'Courier: 現在，大家訂購的東西都是一些……我直接給你舉個例子好了——20升的飲用水。天啊，要是我們能有危險津貼、或是搬運重物的小費之類的話，就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267332
    m_Localized: 'Courier: 唉，這個該死的太陽……害得我們全都得上夜班。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267331
    m_Localized: 'Courier: 如今——配送業務報酬豐厚。雖然……不管從哪個角度看，風險都非常高就對了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267330
    m_Localized: 'Courier: 畢竟——不管是否大難臨頭，也還是得吃午餐嘛！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267329
    m_Localized: 'Courier: 沒想到大家竟然都沒有為有可能會到來的末日進行準備、囤些東西什麼的。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073033
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073032
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073031
    m_Localized: 'GraveDigger: {0}——這東西可以嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073030
    m_Localized: 'GraveDigger: 你想要什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073029
    m_Localized: 'GraveDigger: 哎呀，真是氣死人了！既然如此……我能不能用什麼東西來賄賂你呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073028
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073027
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073026
    m_Localized: 'Marauder: 哎呀，找到了——{0}！來，拿去吧。只要讓我在這裡待到早上就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073025
    m_Localized: 'Marauder: 我看看——一把匕首，肯定得有……一卷繃帶，早晚會需要用上……還有一個舊的瓶子，不過已經空了——幫助不大……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073024
    m_Localized: 'Marauder: 哎呀，不、不要著急著想要把我給趕走呀……先讓我找找包裡有沒有什麼能派上用場的東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878746
    m_Localized: 'Wolfhound: 如今，誰拳頭大、誰就有理。如果無法順應時勢，就只能被潮流淹沒。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878745
    m_Localized: 'Wolfhound: 聰明。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878744
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878743
    m_Localized: 我會處理好的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878742
    m_Localized: 'Wolfhound: 踢她出去吧……否則，這棟房子怕是要易主囉。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878741
    m_Localized: 'Wolfhound: 你收留了{0}？我一眼就能看出來——她是一隻披著羊皮的狼。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878740
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878739
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878738
    m_Localized: 'Twins: 對了——{0}。來，拿去吧。說不定能派上用場。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878737
    m_Localized: 'Twins: 我的姊妹……她現在真的很不好過。我們剛好帶著一些東西……哎呀，是什麼來著？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878736
    m_Localized: 'Twins: 嗯……我知道了。你並不了解我們，覺得我們可能會把你捲進什麼麻煩之中。我可以保證——我們並不是這樣的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878735
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878734
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878733
    m_Localized: 'Twins: 因為，他們令我想起了我們的……父母。現在的這個環境……對她的病情來說，並不是很好。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878732
    m_Localized: 'Twins: 我很擔心……有他們在，我的姊妹只會感到痛苦。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878731
    m_Localized: 'Twins: 看來，你已經收留了{0}、還有{1}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878730
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878729
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878728
    m_Localized: 我沒有自信能跟他好好相處。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878727
    m_Localized: 你知道嗎？在遇到我的丈夫之前，我……唉，這麼說好了——他令我想起了很多我並不願意去想起的人。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878726
    m_Localized: 我……恐怕實在是沒有辦法與這種傢伙待在同一個屋簷下。
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878725
    m_Localized: 你收留了{0}……
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878724
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878723
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878722
    m_Localized: 'Twins: 然而，現在——她最需要的是安寧……絕非他人的評頭論足。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878721
    m_Localized: 'Twins: 我能感覺得到，他們的……這麼說吧——說話方式，會影響到我的姊妹。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878720
    m_Localized: 'Twins: 哎呀，你收留了{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684421
    m_Localized: 'Greatmother: 就是這樣！早就跟你說過了——像這種傢伙，只會帶來接連不斷的麻煩。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684420
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684419
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684418
    m_Localized: 'Greatmother: 快點把他趕出去，將地方讓給我吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684417
    m_Localized: 'Greatmother: 唉，這麼說好了——這個傢伙，只會害你一事無成。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684416
    m_Localized: 'Greatmother: 哎呀……看看這是誰？真沒想到，竟然能在這裡碰上{0}！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490118
    m_Localized: 'Widow: 謝謝……我不會待太久的——只要休息一下、稍微喘口氣，僅此而已……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490117
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490116
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490115
    m_Localized: 'Widow: 我沒有辦法跟他這種人待在同一個屋簷下。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490114
    m_Localized: 'Widow: 不行。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490113
    m_Localized: 'Widow: 你收留了{0}？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490112
    m_Localized: 'Widow: 謝謝你願意向我伸出援手。不過……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446750101504
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907213
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907212
    m_Localized: 'Luka: 如何，感興趣嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907211
    m_Localized: 'Luka: 譬如，{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907210
    m_Localized: 'Luka: 好吧！不過……或許，我剛好帶著一些你需要的東西也說不定。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907209
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907208
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907207
    m_Localized: 'Couple: 如何？能否向我們伸出援手呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907206
    m_Localized: 'Couple: {0}——不知，是否合你心意？只要我的愛人能夠得到片刻的休憩，我可以心甘情願地放棄自己的一切。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907205
    m_Localized: 'Couple: 我們剛好帶著一些東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907204
    m_Localized: 'Couple: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907203
    m_Localized: 'Couple: 說到這個……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907202
    m_Localized: 'Couple: 我非常、非常地愛她。就算全身上下只剩一件襯衫了，我也會毫不猶豫地脫下來給她。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907201
    m_Localized: 'Couple: 我的妻子並不是一個意志十分堅強的人，很容易就會疲憊不堪。而我……則願意為她做任何事情，你應該能理解吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907200
    m_Localized: 'Couple: 希望你不要介意我像現在這樣死纏爛打，只是……試著站在我們的角度想一想，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712914
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712913
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712912
    m_Localized: 'Wheelchair: 瞧瞧，我的雙腳就是最好的證明——什麼都沒有，對吧？哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712911
    m_Localized: 'Wheelchair: 一定管用！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712910
    m_Localized: 'Wheelchair: 哎呀，不願意讓我進去？沒關係，很好處理！來，拿著這{0}吧。只要在門前揮一揮，嘭的一下——別人就看不見你啦！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712909
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712908
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712907
    m_Localized: 'Dude: 瞧瞧——{0}！就像在遊戲裡面一樣，對吧？需要先建立一點聯繫才行。我懂，老兄——我懂！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712906
    m_Localized: 'Dude: 好吧，這樣如何……我剛好帶著一些東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712905
    m_Localized: 'Dude: 拜託，老兄……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712904
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712903
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712902
    m_Localized: 'Blind: 我想，應該是{0}。你拿去吧。我起碼需要一天的時間來好好緩緩、休息一下。只是……看起來好像不太可能了……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712901
    m_Localized: 'Blind: 我……我帶著一些東西。稍等一下——'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712900
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712899
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712898
    m_Localized: 'Fatman: 如何，應該還不錯吧？我們……能就此達成協議了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712897
    m_Localized: 'Fatman: 來，拿好——這{0}送你，聊表本人心意！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712896
    m_Localized: 'Fatman: 好吧、好吧……我已經看穿你在玩什麼鬼把戲了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518610
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518609
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518608
    m_Localized: 'Bestson: 我……還帶著一些口香糖。只剩下幾塊了，不過——也可以都給你……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518607
    m_Localized: 'Bestson: 難道，你是想要我給你些什麼東西？這樣的話……{0}行嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518606
    m_Localized: 'Bestson: 我……我不知道該怎麼辦……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518605
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518604
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518603
    m_Localized: 'Fugitive: 拜託……不然，我會死在這裡的！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518602
    m_Localized: 'Fugitive: 我可以把自己身上的東西給你，兄弟——來，{0}行嗎？我在路上發現的。只有這些，沒別的了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518601
    m_Localized: 'Fugitive: 該死……現在——要嘛，我會在你的門前因為失血過多而暈倒、甚至死掉……要嘛，你就讓我進去休息一下、幫忙處理一下傷口。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518600
    m_Localized: 'Wifefema: 去你的吧。我找你的鄰居去——再也不見，白癡。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518599
    m_Localized: 'Wifefema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518598
    m_Localized: 'Wifefema: 你他媽有病吧——我拿真心交你，你卻當我放屁？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518597
    m_Localized: 'Wifefema: 開什麼玩笑？拜託，我的丈夫可是FEMA的工作人員！'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518596
    m_Localized: 我不收受賄賂
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518595
    m_Localized: 好吧——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518594
    m_Localized: 'Wifefema: 確認各種文件，還會帶上緝毒犬……而且，說不定每天早上都會來。孰好孰壞，自己掂量。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518593
    m_Localized: 'Wifefema: 要是不願意的話……只要我的一句話，我的丈夫就會跟其他穿著黃色衣服的傢伙一起到這裡給你進行一次突襲檢查。'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518592
    m_Localized: 'Wifefema: 不妨打開天窗說亮話好了——我把{0}給你，你讓我進去。如何？'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446720741376
    m_Localized: 'Wifefema: 聽著，我的嗅覺非常靈敏——能準確地辨別誰是人類、誰是偽人。其他人可做不到。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863213
    m_Localized: 希望，能因此睡個好覺。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863212
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863211
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863210
    m_Localized: 我曾在夢中見過這個傢伙……這就已經很能說明問題了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863209
    m_Localized: 我想，這裡擠不下兩個人。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863208
    m_Localized: 謝謝，不過……看來，已經有人把位置給佔了。喏——{0}。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863207
    m_Localized: 'FormerFema: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863206
    m_Localized: 'FormerFema: 我也不知道自己為什麼還要繼續穿著。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863205
    m_Localized: 'FormerFema: 看來，這身制服的確挺嚇人的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863204
    m_Localized: 'FormerFema: 好吧，我能理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863203
    m_Localized: 'FormerFema: 沒想到你真的會允許我進去。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863202
    m_Localized: 'FormerFema: 真假？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863201
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863200
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863199
    m_Localized: 'FormerFema: 不知，能否把對方給趕出去？我可以保證——自己一定會老老實實、不給別人添麻煩。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863198
    m_Localized: 'FormerFema: 你也知道，我一整天都穿著這件制服……真的很想把它脫下來、洗一洗身上的汙垢，還有……別人留下的血跡。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863197
    m_Localized: 'FormerFema: 哎、哎呀……看來，浴室已經被{0}佔了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863196
    m_Localized: 'FormerFema: 等等。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863195
    m_Localized: 'FormerFema: 嗯？哎呀——謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863194
    m_Localized: 'GraveDigger: 謝謝，兄弟！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863193
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863192
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863191
    m_Localized: 'GraveDigger: 我很想進去，真的……不過——唉，你懂的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863190
    m_Localized: 'GraveDigger: 該死，你收留了{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863189
    m_Localized: 罷了……總得試試。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863188
    m_Localized: 該死，還以為終於能好好地休息一下了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863187
    m_Localized: 嗯嗯，這就對了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863186
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863185
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863184
    m_Localized: 被誰佔了？喏——{0}。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863183
    m_Localized: 哎呀……瞧瞧，舒服的地方已經被佔了。
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863182
    m_Localized: 'Provocateur: 至於具體的租賃條款……我們就稍後再詳細地討論吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863181
    m_Localized: 'Provocateur: 謝謝，屋主。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863180
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863179
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863178
    m_Localized: 'Provocateur: 你應該清楚憲法第28條、第48條，以及第7.3條的相關規定——對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863177
    m_Localized: 'Provocateur: 你知道嗎？此人是個目無法紀之徒。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863176
    m_Localized: 'Provocateur: 哎呀……看來，你收留了{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863175
    m_Localized: 'TaxiDriver: 雖然能理解你為什麼會做出這樣的決定，不過——哎喲，還是非常難受……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863174
    m_Localized: 'TaxiDriver: 對了，有空的話就過來一趟吧——我們好好聊聊。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863173
    m_Localized: 'TaxiDriver: 呼……謝謝，兄弟。真是幫大忙了！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863172
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863171
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863170
    m_Localized: 'TaxiDriver: 總之，你來選吧——到底是要留下他、還是要留下我。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863169
    m_Localized: 'TaxiDriver: 看到這個傢伙，就想起了某個企圖把我害得家破、人亡的混蛋……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863168
    m_Localized: 'TaxiDriver: 好吧……不要誤會，你已經收留了{0}——對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668885
    m_Localized: 'Edgar: 一切塵埃落定之後，把我的屍體留下吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668884
    m_Localized: 'Edgar: 雖然不太清楚你對美的理解是否與我一致，不過……告訴我吧——你應該不會把屍體棄於門外，對嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668883
    m_Localized: 'Edgar: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668882
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668881
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668880
    m_Localized: 'Edgar: 而我，則是為了聆聽末日的寂靜之聲。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668879
    m_Localized: 'Edgar: 雖然，我的確想要進來……不過，你已經收留了{0}。看來，對方依舊沉浸於對未來的憧憬之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668878
    m_Localized: 'Foreigner: （他點了點頭、走進了屋裡）'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668877
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668876
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668875
    m_Localized: 'Foreigner: （看起來，他好像並不喜歡{0}。他指了指那人，然後指了指自己——接著又指了指對方）'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668874
    m_Localized: 'Foreigner: 嗚嗚嗚——唔唔唔……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668873
    m_Localized: 'Doctor: 要是走運的話，應該可以在附近找到住處……如果有需要，隨時來找我。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668872
    m_Localized: 'Doctor: 我能理解。如今這個世道，疑心難免。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668871
    m_Localized: 'Doctor: 謝謝。希望，我能幫上一點忙。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668870
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668869
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668868
    m_Localized: 'Doctor: 最好還是讓他去找真正能幫得上自己的人吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668867
    m_Localized: 'Doctor: 我沒有辦法為他提供恰充足的護理。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668866
    m_Localized: 'Doctor: 哎呀……看來，你收留了{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474578
    m_Localized: 'NotTrue: 我先在這裡休息一下、再慢慢趕路。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474577
    m_Localized: 'NotTrue: 寶貝——能幫我這沒用的老太婆拿一張凳子來嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474576
    m_Localized: 'NotTrue: 天啊！真是幫了我這把老骨頭大忙！只是，害得你把對方給趕出去了、實在是令我有些過意不去……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474575
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474574
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474573
    m_Localized: 'NotTrue: 既然你已經收留了其他的人，我想……我還是在門口稍微坐坐、喘一口氣，然後繼續上路好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474572
    m_Localized: 'NotTrue: 要跟這種傢伙打交道，一定很不簡單——對吧，寶貝？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474571
    m_Localized: 'NotTrue: 天啊！看來，{0}已經坐在了椅子上。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474570
    m_Localized: 'Daughter: 不要……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474569
    m_Localized: 'Daughter: 我、我好害、害怕……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474568
    m_Localized: 'Daughter: 我、我根本就不、不認識其、其他人……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474567
    m_Localized: 'Daughter: 離、離開？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474566
    m_Localized: 'Daughter: 爸爸——！爸爸——！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474565
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474564
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474563
    m_Localized: 'Daughter: 我要爸爸……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474562
    m_Localized: 'Daughter: 我……我一定要坐在那裡！好不好嘛、好不好嘛、好不好嘛！爸爸經常會坐在那裡……他就是這樣告訴我的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474561
    m_Localized: 'Daughter: {0}已經在那裡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474560
    m_Localized: 'Daughter: 我……不、不要——我沒有地方可以待！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280298
    m_Localized: 'Scammer: 愛怎樣就怎樣好了。我會去找其他蠢貨——反正，這附近多得是。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280297
    m_Localized: 'Scammer: 媽的，無膽匪類……我打從最開始就知道了，自己肯定與你相處不來。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280296
    m_Localized: 'Scammer: 讚喔！對了，有空的話就過來一趟吧——我想跟你分享一些事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280295
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280294
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280293
    m_Localized: 'Scammer: 趕走他吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280292
    m_Localized: 'Scammer: 哎喲，你收留了{0}。要知道……這種廢物——既沒有辦法榨出錢財，也沒有辦法挖出故事。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280291
    m_Localized: 'Cold: 沒錯——前往某處……遠離人群……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280290
    m_Localized: 'Cold: 好吧，我這就走。也許……太陽能賜予我些許溫暖。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280289
    m_Localized: 'Cold: 我能理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280288
    m_Localized: 'Cold: 謝謝。相信我，這樣會更加安全。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280287
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280286
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280285
    m_Localized: 'Cold: 我……我很害怕與別人待在同一個房間裡面。總是……會有不太愉快的事情發生——無一例外。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280284
    m_Localized: 'Cold: 謝謝……哎呀，不好。既然{0}在這裡，我是不會進去的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280283
    m_Localized: 'Esenin: 媽的。看來，你也是個滴酒不沾的怪胎。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280282
    m_Localized: 'Esenin: 好吧。起碼，這次事情能如我所願。來帶路吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280281
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280280
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280279
    m_Localized: 'Esenin: 最先被轟出酒吧的，就是這種傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280278
    m_Localized: 'Esenin: 將{0}趕走再說吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280277
    m_Localized: 'Anxiety: 好吧，哈哈……我這就走。唉，也沒差了——不管怎樣，太陽都會把我們給通通燒死……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280276
    m_Localized: 'Anxiety: 謝謝。我會老老實實的。只是——不要把門關上，好嗎？哈哈，為了以防萬一……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280275
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280274
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280273
    m_Localized: 'Anxiety: 又或者是……趕他出去？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280272
    m_Localized: 'Anxiety: 你能不能……檢查一下？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280271
    m_Localized: 'Anxiety: 我……我實在沒有辦法跟他待在一起。萬一對方是個偽人，該怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280270
    m_Localized: 'Anxiety: 你、你收留了……{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280269
    m_Localized: 'Hunter: 明智之舉。起碼，我知道自己在做什麼——要是那個……東西出現了的話，我會幫你。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280268
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280267
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280266
    m_Localized: 'Hunter: 我能聞到對方散發出非常濃厚的血腥味。完全搞不懂你為什麼會放這種傢伙進來……難不成，你喜歡玩命？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280265
    m_Localized: 'Hunter: 你收留了{0}，孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280264
    m_Localized: 'Fanatic: 我會去拯救其他人，而你——就爛在這裡吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280263
    m_Localized: 'Fanatic: 將光明……不對，將啟明拒之門外是一項非常、非常嚴重的罪孽！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280262
    m_Localized: 'Fanatic: 去你的吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280261
    m_Localized: 'Fanatic: 我會在這裡坐一陣子……嗚呼！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280260
    m_Localized: 'Fanatic: 好極、好極！接受偉大太陽的祝福吧——願它護佑著你！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280259
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280258
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280257
    m_Localized: 'Fanatic: 他的陰影……不對，光是這個異端之徒的存在、就會令正義之光熄滅！我們得把他給轟出去！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280256
    m_Localized: 'Fanatic: 人類！太陽告誡過我——如果{0}躲在裡面，就千萬不要進去。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085958
    m_Localized: 'FortuneTeller: 我能感受到一股純粹的能量流經這棟房子。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085957
    m_Localized: 'FortuneTeller: 太好了。說實話，你這裡有著得天獨厚、極其罕見的玄奧資源。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085956
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085955
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085954
    m_Localized: 'FortuneTeller: 一定要把這個傢伙給轟出去，否則災星連珠、大禍必至。對此，你也心知肚明——是吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085953
    m_Localized: 'FortuneTeller: {0}……你應該不陌生吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085952
    m_Localized: 'FortuneTeller: 不好……我能感覺到一股濃重、壓抑的氣場——一個足以將我們盡數毀滅、荼毒整棟房子的陰影！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891698
    m_Localized: 'Luka: 一定要照顧好自己，知道了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891697
    m_Localized: 'Luka: 然後……目之所及的一切事物都將無比迅速地變得異常黑暗。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891696
    m_Localized: 'Luka: 如果過分地糾結其中，它就會將你蠶食殆盡。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891695
    m_Localized: 'Luka: 千萬不要把自己困於悲傷之內。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891694
    m_Localized: 'Luka: 也許，到時……盤踞在腦海之中的念頭，就不會只有死亡一種了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891693
    m_Localized: 'Luka: 希望你可以回憶起快樂是一種怎樣的情緒。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891692
    m_Localized: 'Luka: 謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891691
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891690
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891689
    m_Localized: 'Luka: 不過，如果可以騰出一些空間……我會非常感激。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891688
    m_Localized: 'Luka: 雖然，我並不想趕走任何人——誰知道呢？或許，對方比我要更加需要一個容身之所也說不定。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891687
    m_Localized: 'Luka: 我是很想進去啦……只是，{0}已經在這裡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891686
    m_Localized: 'Couple: 好啦，走吧——我也已經很累了！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891685
    m_Localized: 'Couple: 看來，我們只好繼續尋找了。對吧，寶貝？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891684
    m_Localized: 'Couple: 好吧。抱歉，打擾你了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891683
    m_Localized: 'Couple: 真是怕生……沒關係，很快就能好好休息一下了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891682
    m_Localized: 'Couple: 不要再傻傻地站在這裡啦，好嗎？快點動起來吧——人家已經邀請我們進去啦。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891681
    m_Localized: 'Couple: 哎呀，謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891680
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891679
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891678
    m_Localized: 'Couple: 我的妻子不太喜歡他們，沒想到……會在這裡遇到一個。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891677
    m_Localized: 'Couple: 我並不是故意找碴，只是……我們實在沒有辦法跟{0}待在一起。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891676
    m_Localized: 'Couple: 等等，那人是誰？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891675
    m_Localized: 'Couple: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891674
    m_Localized: 'Couple: 哎呀，真是大恩不言謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891673
    m_Localized: 'Anger: 去你媽的！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891672
    m_Localized: 'Anger: 愛聽他們胡說八道？隨你的便好了——出什麼事了可別怪我沒提醒你。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891671
    m_Localized: 'Anger: 媽的，你跟其他懦夫根本就沒什麼兩樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891670
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891669
    m_Localized: 'Anger: 我會獨自一人慢慢消化，不會給其他住客添麻煩。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891668
    m_Localized: 'Anger: 也不會把這裡給搞得天翻地覆。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891667
    m_Localized: 'Anger: 放心，我不會把自己的怒意發洩到別人身上的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891666
    m_Localized: 'Anger: 不行……我沒有辦法和這種怪胎待在同一個屋簷下，我會受不了的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891665
    m_Localized: 'Anger: 媽的，你收留了{0}？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891664
    m_Localized: 'Mother: 不對、不對——一定來得及，一定能趕到。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891662
    m_Localized: 'Mother: 好吧。不知道還來不來得及趕到丈夫的家裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891661
    m_Localized: 'Mother: 不要呆呆地站在這裡啦，快點進去吧——不要讓這位先生在這裡乾等。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891660
    m_Localized: 'Mother: 好極。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891659
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891658
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891657
    m_Localized: 'Mother: 怎麼說呢……不知，能不能把這個傢伙給趕出去、好讓孩子能睡上一個安穩的覺？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891656
    m_Localized: 'Mother: 嗯……你收留了{0}。我的寶貝早就已經被嚇得不輕了……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891655
    m_Localized: 'Ballerina: 毛茸茸的。看到了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891654
    m_Localized: 'Ballerina: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891653
    m_Localized: 'Ballerina: 不要誤會，我在跟貓咪說話。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891652
    m_Localized: 'Ballerina: 來吧，小可愛——你肯定能讓我開心開心，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891651
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891650
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891649
    m_Localized: 'Ballerina: 嗯……對方明明告訴過我，這些傢伙不應該會出現在這裡——快點，將對方給轟走吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891648
    m_Localized: 'Ballerina: 你收留了{0}？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697379
    m_Localized: 'Teacher: 謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697378
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697377
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697376
    m_Localized: 'Teacher: 抱歉……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697375
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697374
    m_Localized: 'Teacher: 會令我想起……把孩子們……給……給……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697373
    m_Localized: 'Teacher: 我實在沒有辦法跟這種傢伙共處一室。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697372
    m_Localized: 'Teacher: 抱歉，看來……你收留了{0}？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697371
    m_Localized: 'Dude: 照顧好自己……還有家人吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697370
    m_Localized: 'Dude: 沒關係，老兄——我理解。千萬不要因此而感到有負擔。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697369
    m_Localized: 'Dude: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697368
    m_Localized: 'Dude: 拜託……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697367
    m_Localized: 'Dude: 就是這樣！讚啦！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697366
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697365
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697364
    m_Localized: 'Dude: 將他給轟出去吧，老兄！不然，會把氣氛搞垮的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697363
    m_Localized: 'Dude: 哎呦，這個傢伙掃興得很。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697362
    m_Localized: 'Dude: 不對，等等……為何{0}會在這裡？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697361
    m_Localized: 'Dude: 讚啦，老兄！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697360
    m_Localized: 'Blind: 否則，它就會來找你。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697359
    m_Localized: 'Blind: 無論如何，千萬不要在晚上靠近被燒焦的屍體。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697358
    m_Localized: 'Blind: 我會就此離開……不過，希望可以再聽我說一句——'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697357
    m_Localized: 'Blind: 謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697356
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697355
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697354
    m_Localized: 'Blind: 看來，我最好還是找找有沒有其他的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697353
    m_Localized: 'Blind: 抱歉，我也說不出所以然。只是……絕對不是什麼錯覺。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697352
    m_Localized: 'Blind: 我能感到{0}在這裡。對方……有點問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697351
    m_Localized: 'Fatman: 現在，我又該去哪裡？完了——一切都完了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697350
    m_Localized: 'Fatman: 我沒聽錯吧？拜託，兄弟……你知道我不太舒服——而且，我還是一名議員欸！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697349
    m_Localized: 'Fatman: 一切都結束之後……我會給你報酬的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697348
    m_Localized: 'Fatman: 非常好，你做出了正確的選擇。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697347
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697346
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697345
    m_Localized: 'Fatman: 我寧可幫你搞個什麼東西……好讓你，咳咳……怎麼說呢，解決這個問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697344
    m_Localized: 'Fatman: 該死，你收留了……{0}。快點把這個傢伙給轟走！我可不想為了爭奪一個浴缸而搞得雞飛狗跳！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503073
    m_Localized: 'Buddy: 謝謝，兄弟！真是救了我一命！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503072
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503071
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503070
    m_Localized: 'Buddy: 雖然我是個樂於分享的人，不過這裡實在是有點擠了……幫幫忙吧，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503069
    m_Localized: 'Buddy: 哎喲，兄弟——看來，有人已經把位置給佔了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503068
    m_Localized: 'Bestson: 好吧……這樣也是無可厚非。我會回家——萬一他們回來了……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503067
    m_Localized: 'Bestson: 不過……也許，現在還是先待在你這裡會比較好。更加安全。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503066
    m_Localized: 'Bestson: 萬一我的父母回來之後找不到我了，該怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503065
    m_Localized: 'Bestson: 謝謝！只是……我還是有點擔心。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503064
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503063
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503062
    m_Localized: 'Bestson: 我曾經在公園裡被一個看起來跟他沒什麼兩樣的傢伙襲擊過——此後，我再也沒有去過那裡！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503061
    m_Localized: 'Bestson: 我留意到長椅上已經躺了{0}。我很……怎麼說呢，害怕這種傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503060
    m_Localized: 'Fugitive: 晚你媽的安，混蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503059
    m_Localized: 'Fugitive: 愛把自己鎖在房子裡的話，就隨你的便好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503058
    m_Localized: 'Fugitive: 怎麼，害怕FEMA會到這裡來找我？去你的吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503057
    m_Localized: 'Fugitive: 真假？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503056
    m_Localized: 'Fugitive: 希望你的這些鄰居不是什麼窮兇極惡的傢伙……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503055
    m_Localized: 'Fugitive: 你救了我的命，兄弟！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503054
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503053
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503052
    m_Localized: 'Fugitive: 我可以非常、非常確定地告訴你——這種傢伙隨時都有可能會在背後給你來上一刀。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503051
    m_Localized: 'Fugitive: 平時基本上悶不吭聲，只會忙活自己的事情。然而，一旦到了需要保命的時候、就會毫不猶豫地拋棄你。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503050
    m_Localized: 'Fugitive: 不行……聽好，兄弟。{0}——我之前曾經遇到過這類人。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503049
    m_Localized: 'Nun: 當你死後，面對全知的主——祂會記得你所犯下這項罪孽。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503048
    m_Localized: 'Nun: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503047
    m_Localized: 'Nun: 記住——要是我之後不幸曝屍荒野了的話，毫無疑問會是你的錯、是你一手促成。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503046
    m_Localized: 'Nun: 真是一個無可救藥的白癡！救贖已經擺在眼前，而你……卻拒絕了。簡直可恥！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503045
    m_Localized: 'Nun: 上帝保佑……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503044
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503043
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503042
    m_Localized: 'Nun: 驅逐它們——如此一來，你將得到祝福！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503041
    m_Localized: 'Nun: 即便花上一輩子的時間，也無法洗盡這些毫無信仰的傢伙背負的種種罪孽！聽好……你不該跟惡魔有所來往！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503040
    m_Localized: 'Nun: 容我確認一下……這{0}是怎麼回事？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114466
    m_Localized: 'Raskolnikov: 我只是……希望有朝一日能學會該如何去殺人，從而保護自己。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114465
    m_Localized: 'Raskolnikov: 想必，對方於你而言十分重要——不好意思，浪費了你的時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114464
    m_Localized: 'Raskolnikov: 抱歉，我並非有意為難。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114463
    m_Localized: 'Raskolnikov: 能否示範一下看看——該如何去殺死偽人？我想要直視自己內心的恐懼。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114462
    m_Localized: 'Raskolnikov: 然後……要是不會太過分的話……完成對我的檢查之後……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114461
    m_Localized: 'Raskolnikov: 謝謝，朋友。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114460
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114459
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114458
    m_Localized: 'Raskolnikov: 我……實在是沒有辦法跟這樣的人一起生活。我已經試過了，結果……不是很好。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114457
    m_Localized: 'Raskolnikov: 抱歉，我並非有意冒犯……只是，{0}已經在這裡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114456
    m_Localized: 'Wifefema: 去你的吧。我找你的鄰居去——再也不見，白癡。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114455
    m_Localized: 'Wifefema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114454
    m_Localized: 'Wifefema: 你他媽有病吧——我拿真心交你，你卻當我放屁？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114453
    m_Localized: 'Wifefema: 開什麼玩笑？拜託，我的丈夫可是FEMA的工作人員！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114452
    m_Localized: 'Wifefema: 只會吃白食的傢伙……趕緊給我滾出去啦！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114451
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114450
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114449
    m_Localized: 'Wifefema: 趁現在還來得及，趕緊把他給轟走！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114448
    m_Localized: 'Wifefema: 我很了解這類人，你不該收留他的——這種傢伙會帶來無窮無盡的麻煩。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114447
    m_Localized: 'Wifefema: 怎麼會有{0}？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114446
    m_Localized: 'Wifefema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114445
    m_Localized: 'Theorist: 再見——我敢肯定，你活不久！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114444
    m_Localized: 'Theorist: 只有思想狹隘到極點的人，才會如此輕易地背棄真相！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114443
    m_Localized: 'Theorist: 你……你……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114442
    m_Localized: 'Theorist: 「趕緊離開吧」？這是什麼意思？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114441
    m_Localized: 'Theorist: 只要與我談過，你眼中的世界必將天翻地覆！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114440
    m_Localized: 'Theorist: 正確的選擇！相信我吧，你不會後悔的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114439
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114438
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114437
    m_Localized: 'Theorist: 將其趕跑——然後，我便會接收你的邀請！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114436
    m_Localized: 'Theorist: 只要有這個傢伙在，我就絕對不會透露任何東西！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114435
    m_Localized: 'Theorist: 這個……這個……{0}！'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114434
    m_Localized: 'Theorist: 不行——想也別想。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114433
    m_Localized: 'Theorist: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114432
    m_Localized: 'Theorist: 等等……這是？'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077071142912
    m_Localized: 'Theorist: 好極！'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633035
    m_Localized: 'BigLebowski: 真不該在你這裡浪費時間……'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633034
    m_Localized: 'BigLebowski: 嘖……隨你便吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371394
    m_Localized: 'Vigilante: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371393
    m_Localized: 'Vigilante: 給我看看你的雙手。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891663
    m_Localized: 'Mother: 恐怕，已經太遲了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200658
    m_Localized: 'FatalDame: 還有……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200657
    m_Localized: 'FatalDame: 我也有著同樣的感受。如果你想要一吐為快……我很樂意跟你聊一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200647
    m_Localized: 'FatalDame: 放心，我不會強迫你開口。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200646
    m_Localized: 'FatalDame: 要是願意說出來的話，搞不好會比較痛快哦？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200645
    m_Localized: 我幾乎無法跟他人建立良好的關係——現在，也一樣
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200644
    m_Localized: 我曾經希望自己的父親能早點死去——怎樣，行了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200643
    m_Localized: 我拒絕
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200642
    m_Localized: 'FatalDame: 告訴我吧。我只不過是個恰巧來到你家門前的陌生人罷了，也許……我們之後根本就不會再有機會遇到彼此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200641
    m_Localized: 'FatalDame: 難不成，你的童年過得非常艱難、現在發生的一切讓自己想起了當年的痛苦？真是可憐……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200640
    m_Localized: 'FatalDame: 難不成，你親近的人被偽人殺了、如今只好封閉自己的心扉？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200639
    m_Localized: 'FatalDame: 出什麼事了嗎？難不成，你的妻子最近離你而去了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200638
    m_Localized: 'FatalDame: 哇哦，真是斬釘截鐵呢！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200637
    m_Localized: 我幾乎無法跟他人建立良好的關係——現在，也一樣
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200636
    m_Localized: 我曾經希望自己的父親能早點死去——怎樣，行了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200635
    m_Localized: 我拒絕
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200634
    m_Localized: 'FatalDame: 你好像有點不太愛說話呢。能跟我講講自己的事情嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200633
    m_Localized: 'FatalDame: 最近，大家都說我不太一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200632
    m_Localized: 'FatalDame: 你喜歡嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200631
    m_Localized: 'FatalDame: 你注意到了？謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200630
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200629
    m_Localized: 你看起來……不太一樣
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200628
    m_Localized: 'FatalDame: 我也真是夠笨，何必多此一問。畢竟，你在這裡住得好好的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200627
    m_Localized: 'FatalDame: 適應了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200626
    m_Localized: 'FatalDame: 新的生活，過得怎樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200624
    m_Localized: 'Vigilante: 真假？我根本就不在乎你的照片拍成怎樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200623
    m_Localized: 'Vigilante: 看著沒有問題。你猜怎麼樣？被我收拾掉的傢伙裡面，超過半數也是「看著沒有問題」。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200622
    m_Localized: 'Vigilante: 又是照片？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200621
    m_Localized: 'Vigilante: 滾一邊去——我可不會聞你的腋窩。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200620
    m_Localized: 'Vigilante: 我可不想知道你的腋窩長了什麼亂七八糟的東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200619
    m_Localized: 'Vigilante: 媽的，開什麼玩笑？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200617
    m_Localized: 'Vigilante: 這次，姑且……就放你一馬吧。我沒空管這些爛事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200616
    m_Localized: 'Vigilante: 沒有問題。不過，這並不意味著你就安全了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200615
    m_Localized: 'Vigilante: 把眼睛給睜大一點。該死，不要再廢話連篇了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200614
    m_Localized: 'Vigilante: 沒空慢慢檢查了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200613
    m_Localized: 'Vigilante: 哼……乾淨又怎樣、髒了又怎樣，都無所謂了。偽人能完美地融入我們之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200612
    m_Localized: 'Vigilante: 快點。怎麼？不要逼我來硬的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200611
    m_Localized: 'Vigilante: 好了，沒有必要再在你這裡浪費時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200610
    m_Localized: 'Vigilante: 不要得意。一旦玩脫，你就完了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200609
    m_Localized: 'Vigilante: 好吧，看著沒有問題。不過——非要說的話，有問題會更好一點。畢竟，直接一槍把你給嘣了會更省事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200608
    m_Localized: 'Vigilante: 把嘴巴給張大一點。該死，我可不是什麼牙醫。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200607
    m_Localized: （給對方看自己的耳朵）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200606
    m_Localized: （給對方看自己的照片）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200605
    m_Localized: （給對方看自己的腋窩）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200604
    m_Localized: （給對方看自己的眼睛）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200603
    m_Localized: （給對方看自己的雙手）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200602
    m_Localized: （給對方看自己的牙齒）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200601
    m_Localized: 'Vigilante: 好啦，沒有必要再聊下去了——快點，給我看看你是否具備偽人的特徵。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200600
    m_Localized: 'Vigilante: 結果，他們哈哈大笑、說……我應該到總部去應聘。去他媽的吧。這群傢伙除了把人帶走之外、還會什麼？偽人依舊在肆虐這我們的土地。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200599
    m_Localized: 'Vigilante: 然後，FEMA來了、說要進行清掃。我告訴他們——這一帶早就已被經清理乾淨了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200598
    m_Localized: 'Vigilante: 我把她給殺了。接著，也把他給殺了。剩餘的幾個孩子倒是不知怎地躲過了一劫、跟鄰居一起逃了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200597
    m_Localized: 'Vigilante: 你猜怎麼樣？偽人爬上屋頂的時候，這個混蛋竟然把門打開、放她走了。於是，我便替他完成了自己做不到的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200596
    m_Localized: 'Vigilante: 隨著時間的流逝，他的妻子……開始表現出了偽人的特徵。然而，他卻只是苦苦哀求——「不要、也不准去碰我的妻子」！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200595
    m_Localized: 'Vigilante: 我曾經遇到過這樣的一個家庭——住在鎮邊、把一切出入口都給封死了，父親還死命地在抵住大門。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200594
    m_Localized: 'Vigilante: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200593
    m_Localized: 'Vigilante: 現在？愛怎樣就怎樣吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200592
    m_Localized: 'Vigilante: 沒有任何意義，純粹浪費時間。如果……我的兄弟能有點骨氣，說不定還有一線生機。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200591
    m_Localized: （給對方看自己的耳朵）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200590
    m_Localized: （給對方看自己的照片）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200589
    m_Localized: （給對方看自己的腋窩）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200588
    m_Localized: （給對方看自己的眼睛）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200587
    m_Localized: （給對方看自己的雙手）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200586
    m_Localized: （給對方看自己的牙齒）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200585
    m_Localized: 'Vigilante: 好啦，故事已經講完了——快點，給我看看你是否具備偽人的特徵。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200584
    m_Localized: 'Vigilante: 雖然被嚇得六神無主，不過卻還活得好好的。對此，我十分敬重。跟我的兄弟可以說是天差地別。媽的……要是他能早點死掉的話，興許他的家人可以得救。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200583
    m_Localized: 'Vigilante: 本以為這一家子已經全都完蛋了，結果……過了幾天，他們竟然找到我了。你知道第一個走出森林的人是誰嗎？他的女兒——而且，手裡還握著一把霰彈槍。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200582
    m_Localized: 'Vigilante: 反而是看準機會，帶著家人逃走、進了森林。我把那些怪胎都給收拾掉之後，等了一段時間也沒見他們回來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200581
    m_Localized: 'Vigilante: 不久之前，我曾經遇到過這樣的一個家庭——父親長得非常高大、魁梧，即使被好幾個偽人堵著窗戶、大吼大叫，也沒有驚慌失措。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200580
    m_Localized: 'Vigilante: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200579
    m_Localized: 'Vigilante: 一切的一切，都是他這種懦夫惹出來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200578
    m_Localized: 'Vigilante: 就像個孬種一樣，踡縮起來、瑟瑟發抖。現在好了——妻子已經死於非命、女兒不知道在哪裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200577
    m_Localized: 'Vigilante: 沒什麼事。我早就說過……要拿出氣概，保護好家人。結果，他做了什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200538
    m_Localized: 'Vigilante: 至於妻子……去她的吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200537
    m_Localized: 'Vigilante: 他還有個女兒，年紀很小。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200536
    m_Localized: 'Vigilante: 既然來都已經來了，乾脆打聽一下好了……你認不認識一個穿著藍色牛仔夾克的健壯男子？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200535
    m_Localized: 'Vigilante: 偽人專挑心軟的傢伙下手。因此，人們會於自己的家中喪命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200534
    m_Localized: 'Vigilante: 能怎麼辦？直接進行制裁。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200533
    m_Localized: 你找的人已經死了，只有女兒活了下來
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200532
    m_Localized: 他的房子被燒毀了——之後，就再也沒有見過這個人了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200531
    m_Localized: 'Vigilante: 至於妻子……去她的吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200530
    m_Localized: 'Vigilante: 他還有個女兒，年紀很小。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200529
    m_Localized: 'Vigilante: 既然來都已經來了，乾脆打聽一下好了……你認不認識一個穿著藍色牛仔夾克的健壯男子？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200528
    m_Localized: 'Vigilante: 只要具備其中的一項特徵，就足夠了——我不會有絲毫的遲疑。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200527
    m_Localized: 'Vigilante: 電視上、廣播上說了什麼，就是什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200526
    m_Localized: 'Vigilante: 跟你沒什麼兩樣，我想。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200525
    m_Localized: 萬一對方只具備其中的一、兩項特徵，該怎麼辦？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200524
    m_Localized: 你是怎麼辨別偽人的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200523
    m_Localized: 'Vigilante: 難道，FEMA放棄了這座小鎮？又或者說，只是這一街區而已？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200522
    m_Localized: 'Vigilante: 不過，我倒是順便檢查了幾棟房子——這裡竟然到處都是偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200521
    m_Localized: 'Vigilante: 本想揪出某個傢伙，結果……一無所獲。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200520
    m_Localized: 'Vigilante: 我又來了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200519
    m_Localized: 'Vigilante: 你是個有趣的人……之後，我還會再來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200518
    m_Localized: 'Vigilante: 我還得去看看某個傢伙的情況。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200517
    m_Localized: 'Vigilante: 你為什麼會認為他們是個威脅？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200516
    m_Localized: 'Vigilante: 他們自有一套辨別偽人的方法。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200515
    m_Localized: 'Vigilante: FEMA的目的非常明確。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200514
    m_Localized: 'Vigilante: 去休息吧……之後再聊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200513
    m_Localized: 'Vigilante: 耳聽為虛，眼見為憑——我會親自一探究竟。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200512
    m_Localized: 'Vigilante: 然而，我並不信任你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006469
    m_Localized: 'Vigilante: 也就是說，你也在試圖維持住僅剩的秩序。非常不錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006468
    m_Localized: 'Vigilante: 你引起了我的注意。好了，我還會回來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006467
    m_Localized: 'Vigilante: 嗯……你的確見過，我看得出來。你的語氣並不像是在道聽途說。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006466
    m_Localized: 'Vigilante: 真是有趣。你有親眼見到過這個傢伙嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006465
    m_Localized: 'Vigilante: 也就是說……沒有任何防護裝備？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006464
    m_Localized: 'Vigilante: 只有一個？而且半裸？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006463
    m_Localized: FEMA正不斷地把人一個接著一個地帶走……並不清楚之後是否還會將他們給送回來
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006462
    m_Localized: 偽人不停出現、沒完沒了，還好——我有一把槍
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006461
    m_Localized: 某個半裸的偽人殲滅了整隊巡邏的士兵
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006460
    m_Localized: 'Vigilante: 這裡發生了什麼事？我該去留意什麼人？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006459
    m_Localized: 'Vigilante: 現在，輪到我提問了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006458
    m_Localized: 'Vigilante: 先打住吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006457
    m_Localized: 你要像這樣「清掃」到什麼時候？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006456
    m_Localized: 你為什麼會來這裡？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006455
    m_Localized: 'Vigilante: 如果遇到了某個能給我留下深刻印象的傢伙……就會拿走其他東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006454
    m_Localized: 'Vigilante: 通常來說，我只會從獵殺對象嘴裡拔走一顆牙齒……這樣最為省事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006453
    m_Localized: 'Vigilante: 這東西……可以說是個紀念品吧——提醒自己清掃過多少小鎮、多少房子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006452
    m_Localized: 'Vigilante: 真是有趣的說法，我以後就這麼講。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006451
    m_Localized: 'Vigilante: 驅趕裝置？我知道了——你是在說這條項鏈。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006450
    m_Localized: 你要像這樣「清掃」到什麼時候？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006449
    m_Localized: 你為什麼會來這裡？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006448
    m_Localized: 'Vigilante: 凡是為這些兇狠、惡毒的偽人感到難過的傢伙，說不定也同樣是個偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006447
    m_Localized: 'Vigilante: 不過，要數最為有效的方法……就是把它們通通都給關在房子裡，然後一把火給燒個精光。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006446
    m_Localized: 'Vigilante: 雖說赤手空拳也可以清理汙穢，然而——要是拿上這個東西的話，就能做得更加乾淨俐落。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006445
    m_Localized: 'Vigilante: 的確，這可以算是掃帚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006444
    m_Localized: 'Vigilante: 不錯，我喜歡這個說法。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006443
    m_Localized: 這是什麼？某種……偽人驅趕裝置？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006442
    m_Localized: 既然如此……你手上拿著的這把就是掃帚囉？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006441
    m_Localized: 'Vigilante: 因此……我不會躲在房子裡，而是選擇主動出擊——向它們降下鐵錘、維護僅剩的秩序。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006440
    m_Localized: 'Vigilante: 毫無正義可言。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006439
    m_Localized: 'Vigilante: 結果？幾天之後，這些從地底下面冒出來的不速之客把整棟房子裡的人都給開膛破肚、逃之夭夭了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006438
    m_Localized: 'Vigilante: 某些傢伙會對偽人施予同情，認為它們——怎麼說……還能復原。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006437
    m_Localized: 'Vigilante: 拜託，這可不是什麼激動人心的冒險。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006436
    m_Localized: 這是什麼？某種……偽人驅趕裝置？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006435
    m_Localized: 既然如此……你手上拿著的這把就是掃帚囉？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006434
    m_Localized: 'Vigilante: 其餘的事？與你無關。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006433
    m_Localized: 'Vigilante: 我自己居住的區域，已經都清理乾淨了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006432
    m_Localized: 'Vigilante: 我是來這裡……進行清掃的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006431
    m_Localized: 你為什麼不找棟房子、待在裡面？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006430
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006429
    m_Localized: 'Vigilante: 除非……你是個偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006428
    m_Localized: 'Vigilante: 不錯，這樣能大大增加你活下去的機率。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006427
    m_Localized: 'Vigilante: 竟然選擇與來客保持距離。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006426
    m_Localized: 'Miner: 回去繼續過著現在的生活，就好像什麼事情都沒有發生過一樣？拜託，鼓起勇氣來、到下面去吧。我們一起把謎底揭開，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006425
    m_Localized: 'Miner: 萬一下面藏了能改變一切的東西，該怎麼辦？不光會把真相如實告知，還能令你成為一名英雄。難道，你打算就這樣一走了之嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006424
    m_Localized: 'Miner: 永遠都不會知道？開什麼玩笑……這並不是什麼隨處可見的洞穴。裡面藏有玄機，你也感覺到了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006423
    m_Localized: 'Miner: 好了，還在等什麼呢？你就是為此而來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006422
    m_Localized: 'Miner: 你也不想因為沒有採取某項行動，而使自己在後悔之中度過餘生吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006421
    m_Localized: 'Miner: 去吧，鼓起勇氣——我會罩你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006420
    m_Localized: 'Miner: 最重要的是，你很想知道下面都藏了什麼，對吧？我看得出來，你不是懦夫。拜託，這都第三趟下到這裡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006419
    m_Localized: 'Miner: 我只要單手就能輕而易舉地把你給提上來。然而，如果我下去了……誰能幹這重活？非常符合邏輯，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006418
    m_Localized: 'Miner: 如果我下去了，要找誰把你拉上來呢？無意冒犯，兄弟——你瘦得就跟皮包骨沒什麼兩樣。你下去、我把風，不是要更加合理嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006417
    m_Localized: 萬一我們永遠都不會知道下面究竟藏著什麼東西，該怎麼辦？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006416
    m_Localized: 你為什麼不親自下去、看看究竟是什麼情況？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006415
    m_Localized: 'Miner: 你也能感覺到的，對吧？這個洞穴正在吸引你前來……就像是在呼喚著你一樣。你一定感覺到了，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006414
    m_Localized: 'Miner: 那個傢伙？怎麼說呢，總得有人行動起來——對吧？總不能在這裡坐一輩子。機不可失，時不再來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006413
    m_Localized: 萬一我們永遠都不會知道下面究竟藏著什麼東西，該怎麼辦？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006412
    m_Localized: 你為什麼不親自下去、看看究竟是什麼情況？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006411
    m_Localized: 'Miner: 話說回來……既然等著也是等著，不如——來搞清楚這個地方究竟有什麼名堂，怎樣？難道，你不想知道嗎？拜託，你一定非常好奇吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006410
    m_Localized: 'Miner: 他？肯定還活著啦。看到了嗎？繩子還是繃得很緊。也就是說，他還在下面孜孜不倦地工作來著。如果有什麼不對勁，我們肯定會知道的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006409
    m_Localized: 你這個獨自深入內部的朋友——還是沒有任何消息嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006408
    m_Localized: 你這個順著繩子下去的朋友——還活著嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006407
    m_Localized: 只是，這個洞穴……說實話，你有多少次是受到了它的吸引而下到這裡來的？感覺它會把你給拉住，對吧？大方承認就好。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006406
    m_Localized: 也有可能是我在這裡坐得實在太久、都開始看見幻覺了。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006405
    m_Localized: 'Miner: 哎呀，你來了啊。還以為你要打退堂鼓了。不過，現在的情況有點不太對——不僅光線變得十分詭譎，繩子的分量也和平時不同。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006404
    m_Localized: 'Miner: 看你這幅弱不禁風的模樣，拉你上來應該是小事一樁。不如，這樣好了——你到下面去看看情況，我……繼續在這裡把風。怎樣？不妨考慮一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006403
    m_Localized: 'Miner: 只要下去裡面一趟，興許就能搞清楚了。雖然我是很想親自揭開這些秘密，不過……總得有人確保繩子有固定住，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006402
    m_Localized: 'Miner: 萬一，我們能在下面找到尋求已久的答案呢？當然，也許只是其中的一部分而是。不過……它們為什麼會出現、它們想要得到什麼——想想看吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006401
    m_Localized: 'Miner: 譬如，偽人？我就說嘛！這些隧道應該就是出自它們的手筆。至於這個洞穴……說不定，是某種門扉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006400
    m_Localized: 'Miner: 來吧——跟我一起搞清楚，怎樣？你下去，我會在上面做好準備、隨時拉人上來！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006399
    m_Localized: 'Miner: 也不是說害怕，只是……它會吸引你過去。要是我能再靠近點、再看一眼的話……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006398
    m_Localized: 'Miner: 不過……站在旁邊的時候，偶爾……會有一種奇怪的感覺。就好像是某種東西在呼喚著我。你也可以試試看——只要……集中精神，仔細傾聽就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006397
    m_Localized: 'Miner: 之前大家都在的時候試過靠近。然而，下面……就像是一片虛無——真正的虛無。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006396
    m_Localized: 'Miner: 也並非不樂意。只是，瞧瞧——一旦手滑、沒有抓好繩子，怕是就得交代在下面了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006395
    m_Localized: 'Miner: 親自下去探查？怎麼說呢，倒是沒有。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006394
    m_Localized: 你不覺得自己的朋友有可能會在下面遇到什麼危險嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006393
    m_Localized: 你有親自下去探查過這個洞穴嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006392
    m_Localized: 'Miner: 看到了嗎？繃得可緊。也就是說，他正在下面埋頭苦幹來著。如果有什麼不對勁，我們肯定能察覺到。你在回去的路上，說不定會先碰上他們兩個呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006391
    m_Localized: 'Miner: 還有一人正纏著這根繩子、小心翼翼地進行著探索呢——要是準備好回來了、或者情況出現變故，就會拉一拉、通知我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006390
    m_Localized: 'Miner: 我的朋友？哎呀，完全沒有必要擔心。其中一人……雖然獨自深入了洞穴的內部，不過一定很快就會回來。畢竟，這個傢伙尋找出路特別有一套。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006389
    m_Localized: 你不覺得自己的朋友有可能會在下面遇到什麼危險嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006388
    m_Localized: 你有親自下去探查過這個洞穴嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006387
    m_Localized: 'Miner: 建議你先在上面吃點東西再下來，不然就會變得跟我一樣——被困在一個洞穴旁邊、餓得發慌，手邊卻只有一盞燈籠。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006386
    m_Localized: 'Miner: 我對時間的感知已經全亂套了。既沒有任何光線、也沒有什麼鐘錶，天知道待了多久。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006385
    m_Localized: 'Miner: 蛤？大聲一點！噢，我已經在這裡坐了大概有……兩到三天的樣子吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006384
    m_Localized: 你的朋友還沒回來？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006383
    m_Localized: 你在這裡待多久了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006382
    m_Localized: 'Miner: 哎呀，又回來了？快聽聽看——現在，洞裡的嗡鳴是不是要比之前安靜一些了？又或者說，我其實已經聾了？到底怎樣？快說說看。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006338
    m_Localized: 'MushroomEater: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006337
    m_Localized: 'MushroomEater: 祝你萬事如意、百毒不侵、喜樂隨心，以及——笑口常開，親愛的孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006336
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006335
    m_Localized: 'MushroomEater: 看來，希望已經破滅。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006334
    m_Localized: 'MushroomEater: 好吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006333
    m_Localized: 我還沒有準備好
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006332
    m_Localized: 我隨時都能出發
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006331
    m_Localized: 'MushroomEater: 好了，親愛的孩子。我再問你一遍——準備我與我一起前往蘑菇之地了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006330
    m_Localized: 'MushroomEater: 我也不知道到底會在蘑菇之地遇到什麼東西、碰上什麼事情……能夠斷言的是，那裡危機四伏！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006329
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006328
    m_Localized: 'MushroomEater: 我們將飛越數段扭曲的時間，不斷舞動——藉此令蘑菇之地俯首、屈膝。也許，就連我們也不例外……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006327
    m_Localized: 'MushroomEater: 我沒有辦法獨自一人阻止節慶的發生——我需要你的幫助。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006326
    m_Localized: 'MushroomEater: 哎喲，親愛的孩子……這可不好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006325
    m_Localized: 'MushroomEater: 否則，通往蘑菇之地的大門就要關閉了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006324
    m_Localized: 'MushroomEater: 天啊！要趕不上了——快，趕緊動起來！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006323
    m_Localized: 'MushroomEater: 現在已經是午夜了？！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006322
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006321
    m_Localized: 'MushroomEater: 等等——讓我看看你的手錶。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006320
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006319
    m_Localized: 'MushroomEater: 快點收拾一下自己的行李……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006318
    m_Localized: 'MushroomEater: 非常不錯！要的就是這種精神，孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006317
    m_Localized: 我還沒有準備好
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006316
    m_Localized: 我隨時都能出發
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006315
    m_Localized: 'MushroomEater: 準備好與我一起前往蘑菇之地了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006314
    m_Localized: 'MushroomEater: 人類永遠都不應該踏足此地——永遠。然而，想要阻止節慶、只好這樣做了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006313
    m_Localized: 'MushroomEater: 要是不趕緊行動起來的話，一切都會因此而化為烏有。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006312
    m_Localized: 'MushroomEater: 雖然不會在那裡看到節慶……不過，其他的東西……還有菌絲體……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006311
    m_Localized: 'MushroomEater: 聽好——這絕對不是什麼沐浴著陽光、懸掛著彩虹的童話國度！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006310
    m_Localized: 'MushroomEater: 雖然以我們的語言說出來的話、也許顯得比較歡快，不過……在蘑菇的語言裡，就完全不是這麼一回事了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006309
    m_Localized: 'MushroomEater: 親愛的孩子——千萬不要被這個名字給騙了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006279
    m_Localized: 'MushroomEater: 真正具備思考能力的——是菌絲體。遺憾的是，雖然我能讀懂它們的想法……它們卻聽不懂我們的語言……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006278
    m_Localized: 'MushroomEater: 它們只不過是菌絲體的一部分罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006277
    m_Localized: 'MushroomEater: 雖說這應該是最直截了當的方法，然而我沒有辦法與蘑菇進行對話。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006276
    m_Localized: 'MushroomEater: 親愛的孩子……我們還會再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006275
    m_Localized: 'MushroomEater: 記住——眼見不一定為實。對於蘑菇，更是如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006274
    m_Localized: 'MushroomEater: 我們得確保蘑菇不再長大、節慶不會開始。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006273
    m_Localized: 'MushroomEater: 時機成熟之後，我會再到這來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006272
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006271
    m_Localized: 'MushroomEater: 而這，就是我們做的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006270
    m_Localized: 'MushroomEater: 不過，《笑容之書》向我們展示了一種這樣的方法……一種能將它們的根莖穩定下來、不再瘋長的方法。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006269
    m_Localized: 'MushroomEater: 我們並非菌絲體的一部分，因此——沒有辦法與蘑菇進行直接對話。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006268
    m_Localized: 'MushroomEater: 我們舉行了一場古老的儀式，親愛的孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006267
    m_Localized: 你就不能直接去跟蘑菇溝通、讓它們停止籌備這一節慶嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006266
    m_Localized: 我們做的這些事情到底要如何阻止這件事情的發生？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006265
    m_Localized: 'MushroomEater: 現在，只能等待……並且祈求蘑菇能就此停下增長的勢頭。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006264
    m_Localized: 'MushroomEater: 哎呀，親愛的孩子……我也希望事情可以如此簡單。然而——我們並不清楚自己所做的一切是否真的能起作用。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006263
    m_Localized: 你就不能直接去跟蘑菇溝通、讓它們停止籌備這一節慶嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006262
    m_Localized: 我們做的這些事情到底要如何阻止這一節慶的發生？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006261
    m_Localized: 'MushroomEater: 最近，蘑菇實在是生長得過於迅猛了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006260
    m_Localized: 'MushroomEater: 它們幾乎無所不知。不過，現在——它們也已經岌岌可危……就跟我們沒什麼兩樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006259
    m_Localized: 'MushroomEater: 菌絲體跟我說的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006258
    m_Localized: 你似乎沒什麼信心
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006257
    m_Localized: 你是怎麼知道的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006256
    m_Localized: 'MushroomEater: 希望這樣就能阻止蘑菇節發生……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006255
    m_Localized: 'MushroomEater: 又見面了，孩子——你已經按照要求完成了《笑容之書》上面寫著的所有事項。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006254
    m_Localized: 'MushroomEater: 唉……好吧，也許我只是在浪費時間而已……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006253
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006252
    m_Localized: 'MushroomEater: 不願收下——為什麼呢？只不過是幾張內頁罷了……而且，我早就已經背得滾瓜爛熟了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006251
    m_Localized: 'MushroomEater: 祝你萬事如意、百毒不侵、喜樂隨心，以及——笑口常開，親愛的孩子！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006250
    m_Localized: 'MushroomEater: 等你完成了上面寫著的所有事項之後，我會再來見你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006249
    m_Localized: 'MushroomEater: 現在……我得走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006248
    m_Localized: 'MushroomEater: 好極——記得抽空看看。千萬不要忘了，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006247
    m_Localized: 我心領了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006246
    m_Localized: 好吧，我會收下這幾張《笑容之書》的內頁
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006245
    m_Localized: 'MushroomEater: 我把幾張《笑容之書》的內頁給撕了下來。來，收下吧——它們會指引你接下來該去做什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006244
    m_Localized: 'MushroomEater: 絕對不能讓這種事情發生！一定要加以阻止……你我應該聯合起來，孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006243
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006242
    m_Localized: 'MushroomEater: 而且，這朵巨大的蘑菇並不孤單——因為，節慶將會隨之而來、為人所知！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006241
    m_Localized: 'MushroomEater: 其影將吞噬太陽……沒有任何一處地方能夠倖免於難。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006240
    m_Localized: 'MushroomEater: 一朵巨大的蘑菇會拔地而起……其孢子將不斷擴散、遍佈四方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006239
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006238
    m_Localized: 'MushroomEater: 就來看看，《笑容之書》裡是怎麼說的好了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006237
    m_Localized: 'MushroomEater: 哎呀……親愛的孩子……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006236
    m_Localized: 我心領了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006235
    m_Localized: 好吧，我會收下這幾張《笑容之書》的內頁
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006234
    m_Localized: 'MushroomEater: 因此，我把最重要的幾張內頁給撕了下來。好了……來，拿去吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006233
    m_Localized: 'MushroomEater: 只是，恐怕已經來不及將其完全讀透了。畢竟，這是一本大部頭著作……而且，時間並非我們的朋友！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006232
    m_Localized: 'MushroomEater: 沒錯，一本非常特殊的書籍——於此世上、絕無僅有，會指引你該去做什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006231
    m_Localized: 蘑菇節？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006230
    m_Localized: 《笑容之書》？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006229
    m_Localized: 'MushroomEater: 我帶著一件對此有所幫助的東西——《笑容之書》。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006228
    m_Localized: 'MushroomEater: 放心，遲早會明白的。不過，記住——不管需要付出怎麼樣的代價，都必須阻止這件事情發生。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006227
    m_Localized: 蘑菇節？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006226
    m_Localized: 《笑容之書》？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006225
    m_Localized: 'MushroomEater: 據說，蘑菇節已經迫在眉睫……而這，親愛的孩子——並不是什麼好事！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006224
    m_Localized: 'MushroomEater: 我靠著鑽研《笑容之書》、學會了該如何去傾聽它們的話語。而菌絲體之前說的事情……令我非常困擾。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006223
    m_Localized: 'MushroomEater: 蘑菇之間正是透過它們進行的交流。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006222
    m_Localized: 'MushroomEater: 沒錯——對於一般人來說，想要理解它們在說什麼幾乎不太可能。畢竟，菌絲體會以一種獨特的方式來表達自己。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006221
    m_Localized: 我不是很明白你到底在說什麼
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006220
    m_Localized: 菌絲體？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006219
    m_Localized: 'MushroomEater: 因此，聽好……我們得立即行動起來，時間已經所剩無幾了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006218
    m_Localized: 'MushroomEater: 雖然它們的表達方式頗為複雜，不過我已經學會了該如何去解讀這些信號。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006217
    m_Localized: 'MushroomEater: 我當然認識你——菌絲體早就已經跟我說過了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006216
    m_Localized: 我不是很明白你到底在說什麼
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006215
    m_Localized: 菌絲體？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006214
    m_Localized: 'MushroomEater: 因此，還請仔細聽好、記好我說的每一句話。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006213
    m_Localized: 'MushroomEater: 蘑菇節即將到來！然而，時間正在一點、一滴地從我們的指縫之間溜走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006212
    m_Localized: 'MushroomEater: 哎呀，現在不是說這個的時候——是這樣的，菌絲體跟我說了一些令人感到頭痛的事情……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006211
    m_Localized: 'MushroomEater: 嘿嘿，我只不過是個對蘑菇略知一二的糟老頭子罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006210
    m_Localized: 你認識我？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006209
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006208
    m_Localized: 'MushroomEater: 你好，親愛的孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812165
    m_Localized: 'CultistPriest: 需要做的事情都已經完成了。我們這就離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812164
    m_Localized: 'CultistPriest: 無論如何，還是要謝謝你伸出援手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812163
    m_Localized: 'CultistPriest: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812162
    m_Localized: 'CultistPriest: 又或者是——你根本就並不想要獲得安寧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812161
    m_Localized: 'CultistPriest: 他們真的有打擾到你嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812160
    m_Localized: 'CultistPriest: 我會把他們帶走。無論如何，還是要謝謝你伸出援手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812159
    m_Localized: 'CultistPriest: 好吧……你的確也已經為我們盡心、盡力了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812158
    m_Localized: 這裡不是什麼托兒所
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812157
    m_Localized: 不要再來煩我了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812156
    m_Localized: 'CultistPriest: 因此，我們沒有其他選擇、只好繼續呼喚著它。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812155
    m_Localized: 'CultistPriest: 然而，死亡……它能幫我們逃避最壞的命運——遁入虛空。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812154
    m_Localized: 'CultistPriest: 重生？聽起來就像是要面臨無窮無盡的折磨、而期間只有短暫的喘息之機一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812153
    m_Localized: 'CultistPriest: 來世？只不過是由虛假宗教宣揚的一種空洞觀念罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812152
    m_Localized: 'CultistPriest: 永遠消失？不得不說，太過嚇人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812151
    m_Localized: 'CultistPriest: 重要的是——我們早已遍體鱗傷、疲憊不堪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812150
    m_Localized: 'CultistPriest: 即使無法完全理解自己想要召喚的存在本質究竟為何，也並沒有關係。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812149
    m_Localized: 'CultistPriest: 我能感覺到……距離它降臨的日子，已經不遠了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812148
    m_Localized: 這裡不是什麼托兒所
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812147
    m_Localized: 不要再來煩我了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812146
    m_Localized: 'CultistPriest: 為什麼呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812145
    m_Localized: 你口中不斷提及的這個所謂「死亡」，到底是怎麼回事？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812144
    m_Localized: 把這群怪胎也一起帶走吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812143
    m_Localized: 'CultistPriest: 晚安。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812142
    m_Localized: 'CultistPriest: 如果死亡選擇了你，我會幫它去看清楚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812141
    m_Localized: 'CultistPriest: 對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812140
    m_Localized: 'CultistPriest: 他們死了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812139
    m_Localized: 你口中不斷提及的這個所謂「死亡」，到底是怎麼回事？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812138
    m_Localized: 把這群怪胎也一起帶走吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812137
    m_Localized: 'CultistPriest: 既然如此，我便不再踟躕、再次前行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812136
    m_Localized: 'CultistPriest: 好極、好極，就是這樣。它依舊注視著我們。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812135
    m_Localized: 滾一邊去，我忙著呢
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812134
    m_Localized: 你的教徒好得很
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812133
    m_Localized: 'CultistPriest: 不過，你對此毫無感覺——對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812132
    m_Localized: 'CultistPriest: 看來，世界將會就此終結……並非轟動收場，而是愴然逝去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812131
    m_Localized: 'CultistPriest: 死亡已經不再對我言語。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812130
    m_Localized: 'CultistPriest: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812129
    m_Localized: 'CultistPriest: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812128
    m_Localized: 'CultistPriest: 你……你剝奪了我們達成夙願的機會。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812127
    m_Localized: 'CultistPriest: 他們死了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812126
    m_Localized: 'CultistPriest: 等等……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812125
    m_Localized: 'CultistPriest: 雖然我尚未理清這到底意味著什麼，不過……聽起來非常誘人，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812124
    m_Localized: 'CultistPriest: 說不定，它會為你提供一處藏身之所、令你躲避一切危險——甚至，就連「死亡」這一概念也不例外。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812123
    m_Localized: 'CultistPriest: 不久前，死亡向我降下了神諭……它希望能在一切塵埃落定後與你見上一面。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812122
    m_Localized: 'CultistPriest: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812121
    m_Localized: 'CultistPriest: 相信你也開始感到厭倦了——對這喧囂的世界、對這沉重的日子、對這難解的困惑。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812120
    m_Localized: 'CultistPriest: 非常感謝你的幫助。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812119
    m_Localized: 我沒空去管他們——自己手邊需要處理的事情早就已經堆積如山了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812118
    m_Localized: 知道啦、知道啦，他們還是活得好好的
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812117
    m_Localized: 'CultistPriest: 讓我們直奔主題吧——我的教徒狀況如何？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812116
    m_Localized: 'CultistPriest: 之後再見——晚點，我會回來查看他們的狀況。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812115
    m_Localized: 'CultistPriest: 放心，不會打擾太長時間的。不過，還是請你看顧好他們。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812114
    m_Localized: 'CultistPriest: 謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812113
    m_Localized: 'CultistPriest: 放心，不會打擾太長時間的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812112
    m_Localized: 'CultistPriest: 因此，不妨讓他們待在這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812111
    m_Localized: 'CultistPriest: 到時，你又該何去何從？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812110
    m_Localized: 'CultistPriest: 即便你能僥倖活命，這棟房子也難逃被燒成平地的命運。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812109
    m_Localized: 'CultistPriest: 即使殺了我們，也會有其他的教徒趁你就寢之時將這裡淋滿汽油、然後劃亮一根火柴……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812108
    m_Localized: 'CultistPriest: 難道，你認為我們這一教團就只有寥寥數人？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812107
    m_Localized: 我並不喜歡被人威脅，不過……話都已經說到這個份上了，我就幫你們一把吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812106
    m_Localized: 既然如此，我只好先下手為強、把你們通通射死了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812105
    m_Localized: 'CultistPriest: 對此，我很抱歉。然而，除此之外、別無他法。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812104
    m_Localized: 'CultistPriest: 因此，沒錯——要是一切無法如願的話，我們就只好燒毀你的這棟房子了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812103
    m_Localized: 'CultistPriest: 然而……如果失去了超過一個，便岌岌可危了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812102
    m_Localized: 'CultistPriest: 看顧好我的教徒。記住——要是其中一人死了的話……你的房子就會被燒成平地。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812101
    m_Localized: 'CultistPriest: 你也同樣渴望獲得安寧，不是嗎？希望能活在一個彼此之間不會成為負累的世界，我沒說錯吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812100
    m_Localized: 'CultistPriest: 正是如此。通往崇高使命的道路……絕非坦途。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812099
    m_Localized: 我並不喜歡被人威脅，不過……話都已經說到這個份上了，我就幫你們一把吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812098
    m_Localized: 既然如此，我只好先下手為強、把你們通通射死了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812097
    m_Localized: 'CultistPriest: 還請見諒，不過——為了完成我們肩負的神聖使命，這是唯一的出路。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812096
    m_Localized: 'CultistPriest: 到時，就只好燒毀你的這棟房子了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812095
    m_Localized: 'CultistPriest: 然而……如果失去了超過一人，我們所冀求的一切便會付之東流。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812094
    m_Localized: 'CultistPriest: 看顧好我的教徒。記住——要是其中一人死了的話……你的房子就會被燒成平地。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812093
    m_Localized: 'CultistPriest: 或許，下面的這番話能讓你提起興趣——'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812092
    m_Localized: 聽起來……這項任務似乎難如登天
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812091
    m_Localized: 我對此興趣缺缺
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812090
    m_Localized: 'CultistPriest: 他們會為逝者舉行儀式。你只要保證他們的安全就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812089
    m_Localized: 'CultistPriest: 不過，我的教徒會。死亡被這個地方深深地吸引住了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812088
    m_Localized: 'CultistPriest: 我不會進去……我的使命是去盡可能地傳播能帶來安寧的信仰。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812087
    m_Localized: 聽起來……這項任務似乎難如登天
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812086
    m_Localized: 我對此興趣缺缺
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812085
    m_Localized: 'CultistPriest: 一定要確保他們能夠存活下來，直至完成各自肩負的任務為止。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812084
    m_Localized: 'CultistPriest: 總而言之——希望你可以讓我的教徒待在這裡，並予以保護。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812083
    m_Localized: 'CultistPriest: 我很好奇……這裡到底發生過什麼事？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812082
    m_Localized: 'CultistPriest: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812081
    m_Localized: 'CultistPriest: 死亡的氣息——非常地濃厚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812080
    m_Localized: 'CultistPriest: 而你的這棟房子——正是完美的地點。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812079
    m_Localized: 'CultistPriest: 我們需要舉行殯葬儀式……不過，將會採用全新的方式。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812078
    m_Localized: 你是想要進來還是怎樣？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812077
    m_Localized: 你到底想怎樣？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812076
    m_Localized: 'CultistPriest: 死亡早就近在咫尺——我們只不過是在幫它跨過最後一道門檻罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812075
    m_Localized: 'CultistPriest: 死亡給予我們救贖，其餘一切、均為謊言。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812074
    m_Localized: 'CultistPriest: 這是我的裹屍布。這樣一來，當我們死去的時候、就不必尋找苫單遮蓋遺體了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812073
    m_Localized: 'CultistPriest: 也許是吧，我不在乎。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812072
    m_Localized: 你是想要進來還是怎樣？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812071
    m_Localized: 你到底想怎樣？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812070
    m_Localized: 'CultistPriest: 如果想要獲得救贖，只能透過這種途徑——再也沒有其他辦法。一切……已經不可能回到之前的樣子了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812069
    m_Localized: 'CultistPriest: 我們只不過是在幫它達成這一目標罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812068
    m_Localized: 'CultistPriest: 死亡已經降臨——它想撫慰人類……令我們擺脫恐慌、痛苦，以及喧囂。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812067
    m_Localized: 'CultistPriest: 我們是全新信仰的先驅者——更是神聖教義的傳道者。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812066
    m_Localized: 你看起來像是某個邪教的怪胎
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812065
    m_Localized: 你到底是什麼人？為什麼穿成這樣？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812064
    m_Localized: 'CultistPriest: 死亡對你青睞有加。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812063
    m_Localized: 'CultistPriest: 既有被太陽給曬成焦炭的人、也有被拖出來處以私刑的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812062
    m_Localized: 'CultistPriest: 死亡無處不在。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812061
    m_Localized: 'CultistPriest: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812060
    m_Localized: 'CultistPriest: 的確如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812059
    m_Localized: 你看起來像是某個邪教的怪胎
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812058
    m_Localized: 你到底是什麼人？為什麼穿成這樣？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812057
    m_Localized: 'CultistPriest: 我不清楚究竟有多少人死在了這裡，不過……我能強烈地感受到它的存在。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812056
    m_Localized: 'CultistPriest: 死亡看上了你的房子——它……對這個地方青睞有加。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812055
    m_Localized: 'CultistPriest: 死亡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812054
    m_Localized: 這是我的房子
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812053
    m_Localized: 你到底感受到了什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812052
    m_Localized: 'CultistPriest: 我能感受到。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812051
    m_Localized: 'CultistPriest: 沒錯——這棟房子符合要求。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812050
    m_Localized: 'Courier: 來，拿去吧——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812041
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812040
    m_Localized: 'Courier: 你評評理——一個隨處可見的配送員到底有什麼威脅？媽的，那個混蛋為什麼非得要殺了他？到底圖個什麼東西？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812039
    m_Localized: 'Courier: 現在這個世道，就連一個正常點的人都沒有。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812038
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812037
    m_Localized: 'Courier: 他一如既往地在執行自己的工作，給客戶配送商品——結果，卻被那個房主……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812036
    m_Localized: 'Courier: 我的朋友被殺了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812035
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812034
    m_Localized: 你怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812033
    m_Localized: 'Courier: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812030
    m_Localized: 'Courier: 你訂購的商品已經送達……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812029
    m_Localized: 'Courier: 祝你晚安……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812027
    m_Localized: 'Courier: 唉……萬一我的眼睛也因為睡眠不足而變成這樣，該怎麼辦？難道，他們也會把我關進隔離區裡面去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812026
    m_Localized: 'Courier: 然後？就沒有然後了——他立即就被抓走了。現在，就沒人知道他之後怎麼樣了。還有就是，還會不會放他回來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812025
    m_Localized: 'Courier: 本來只是一次再普通不過的晨檢而已，結果……他們發現這位同事的眼睛有點不太對勁——佈滿血絲，紅腫不堪。媽的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812024
    m_Localized: 'Courier: 我的同事被FEMA的工作人員給帶走了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812023
    m_Localized: 你看起來好像有點失落
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812021
    m_Localized: 'Courier: 你好……你訂購的商品已經送達。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812020
    m_Localized: 'Courier: 祝你晚安。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812019
    m_Localized: 'Courier: 要是有工作的話，起碼還能把自己的注意力給轉移開來、不用去整天掛念著現在的這堆爛攤子……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812018
    m_Localized: 'Courier: 唉……不然，我又能做什麼呢？跟絕大多數的人一樣，坐在家裡、慢慢腐爛？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812017
    m_Localized: 'Courier: 哎呀，不好意思。你問的是，我為什麼會選擇成為一名配送員——對嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812016
    m_Localized: 'Courier: 因為通過了篩選、檢查了所有特徵之後，他們認定我是個人類。然後……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812015
    m_Localized: 你是怎麼成為一名配送員的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812013
    m_Localized: 'Courier: 你好。我是安憩速遞的配送員。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812012
    m_Localized: 'Courier: 抱歉，還是不太習慣、沒能完全改口。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812011
    m_Localized: 'Courier: 祝你度過愉快的一天——哎呀，不對……是一晚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812005
    m_Localized: 真沒想到——現在，配送業務竟然還在正常運作
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812003
    m_Localized: 'Courier: 你好。我是安憩速遞的配送員。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812002
    m_Localized: 'Intruder: 無法做夢的話……也太過難熬了，對誰來說都是這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812001
    m_Localized: 'Intruder: 我希望會。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812000
    m_Localized: 'Intruder: 你覺得大家會再次開始做夢嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811999
    m_Localized: 'Intruder: 不過，如果這裡還有人會做夢、也可以說是大事一件了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811998
    m_Localized: 'Intruder: 謝謝。我會試著在這裡睡上一覺——雖說……應該還是沒有辦法入眠就對了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811997
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811996
    m_Localized: 好吧——你要……進來嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811995
    m_Localized: 'Intruder: 或許，睡著了之後……也能看到什麼景象呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811994
    m_Localized: 'Intruder: 畢竟，我已經有整整六天沒睡過覺了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811993
    m_Localized: 'Intruder: 我也說不清楚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811992
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811991
    m_Localized: 好吧——你要……進來嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811990
    m_Localized: 'Intruder: 我想……說不定是因為現在已經沒有這種餘裕了。失去了休息的時間，失去了自省的機會。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811989
    m_Localized: 'Intruder: 現在？碎了一地，無處可尋。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811988
    m_Localized: 'Intruder: 大家會在其中釋放壓力——尋找答案、尋求慰藉……令自己平靜下來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811987
    m_Localized: 'Intruder: 夢……非常的脆弱。說來也是奇怪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811986
    m_Localized: 你自己呢？會做夢嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811985
    m_Localized: 為何關心這個？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811984
    m_Localized: 'Intruder: 難道……是因為太陽的關係？又或者說，是出於其他的理由？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811983
    m_Localized: 'Intruder: 現在，幾乎已經沒人會做夢了——即便是在發燒的時候……也不例外。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811982
    m_Localized: 'Intruder: 就是這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811981
    m_Localized: 你自己呢？會做夢嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811980
    m_Localized: 為何關心這個？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811979
    m_Localized: 'Intruder: 你覺得原因出在哪裡？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811978
    m_Localized: 'Intruder: 現在，幾乎已經沒人會做夢了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811977
    m_Localized: 'Intruder: 你知道嗎？我意識到……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811976
    m_Localized: 'Intruder: 做夢——應該不是什麼陌生的概念吧？你睡覺的時候……有見到過什麼景象嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811975
    m_Localized: 不會
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811974
    m_Localized: 蛤？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811973
    m_Localized: 'Intruder: 你會做夢嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811972
    m_Localized: 'FormerFema: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811971
    m_Localized: 'FormerFema: 我也不知道自己為什麼還要繼續穿著。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811970
    m_Localized: 'FormerFema: 看來，這身制服的確挺嚇人的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811969
    m_Localized: 'FormerFema: ……抱歉，腦子一時當機、說錯話了。好吧，我能理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811968
    m_Localized: 'FormerFema: 哎呀？哦、哦，謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811967
    m_Localized: 'FormerFema: 沒想到你真的會允許我進去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811966
    m_Localized: 'FormerFema: 不知，有沒有哪裡可以讓我坐下來、歇一歇？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811965
    m_Localized: 'FormerFema: 哎呀？哦、哦，謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811964
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811963
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811962
    m_Localized: 'FormerFema: 哦，別誤會——我說的是程式設計啦，就是寫程式碼這種。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811961
    m_Localized: 'FormerFema: 我的任務、職責，跟本來說好的完全不一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811960
    m_Localized: 'FormerFema: 然而，卻迎來了失望。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811959
    m_Localized: 'FormerFema: 我曾經有過一份工作，認為生活會一帆風順。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811958
    m_Localized: 'FormerFema: 問得好。現在，我感到……非常的迷茫。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811957
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811956
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811955
    m_Localized: 'FormerFema: 我實在是受不了了，就跑路了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811954
    m_Localized: 'FormerFema: 人手不足，產能低下——因此，任務越積越多。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811953
    m_Localized: 'FormerFema: 而且……早就已經辭職了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811952
    m_Localized: 'FormerFema: 專門製造、維修冰箱。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811951
    m_Localized: 'FormerFema: 我只不過是個隨處可見的工廠工人罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811950
    m_Localized: 那……你打算怎樣？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811949
    m_Localized: 那……你到底是什麼人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811948
    m_Localized: 'FormerFema: 天知道他們究竟遭遇了些什麼事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811947
    m_Localized: 'FormerFema: 而且，這些被帶走的人——從來都沒能回來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811946
    m_Localized: 'FormerFema: 因為……不管出於什麼目的也好，他們都從很多人的身邊帶走了對自己來說非常、非常重要的人，譬如親朋、好友。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811945
    m_Localized: 'FormerFema: 就我看來，大家都討厭這些傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811944
    m_Localized: 'FormerFema: 哦，我懂了……你把我當成FEMA的工作人員了，是嗎？我想，應該是這件制服令你先入為主了吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811943
    m_Localized: 'FormerFema: 我沒明白你的意思。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811942
    m_Localized: 'FormerFema: 嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811941
    m_Localized: 那……你打算怎樣？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811940
    m_Localized: 那……你到底是什麼人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811939
    m_Localized: 'FormerFema: 也許，太陽會留下輻射——即使到了夜晚，都不會消散？大概是出於諸如此類的原因吧。我也根本不想深究。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811938
    m_Localized: 'FormerFema: 心想……這樣應該會比較安全。畢竟，他們之所以會穿著這套東西、應該也是有著某種理由的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811937
    m_Localized: 'FormerFema: 你誤會啦，這是從一具屍體上扒下來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811936
    m_Localized: 'FormerFema: 我知道了——因為這件制服的關係，你把我當作FEMA的工作人員了……對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811935
    m_Localized: 'FormerFema: 帶走？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811934
    m_Localized: 怎麼，你們這次是要來把我給帶走了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811933
    m_Localized: 先把之前被你們帶走的住客給送回來再說
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811932
    m_Localized: 'FormerFema: 不知，你能……讓我進去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811931
    m_Localized: 'FormerFema: 我聽到了一些動靜……你已經來到門後了，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811930
    m_Localized: 'FormerFema: 你好——請問，有人在嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811929
    m_Localized: 'GraveDigger: 此後，再也沒人見過這個傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811928
    m_Localized: 'GraveDigger: 我曾經聽說過……不知道出於什麼原因，某人離開了自己的房子。結果，回來之後——嘣的一聲……然後？已經沒有什麼然後了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811927
    m_Localized: 'GraveDigger: 之後，偽人便會前來敲門……甚至，有可能更糟——它們早已潛伏在內。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811926
    m_Localized: 'GraveDigger: 回到家裡，迎接自己的只有空蕩的房間和冰冷的牆壁。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811925
    m_Localized: 'GraveDigger: 累死累活地挖了一整天……不對，一輩子的墓穴——到頭來，究竟是為了什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811924
    m_Localized: 'GraveDigger: 哎喲……兄弟……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811923
    m_Localized: 'GraveDigger: 只是——趕緊把門給關上，好嗎？我擔心那些偽人會追上來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811922
    m_Localized: 'GraveDigger: 謝謝！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811921
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811920
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811919
    m_Localized: 'GraveDigger: 總而言之——我不做了。愛怎樣就怎樣吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811918
    m_Localized: 'GraveDigger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811917
    m_Localized: 'GraveDigger: 要是麻煩也能像我們看顧著它們一樣、看顧著我們，就好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811916
    m_Localized: 'GraveDigger: 太陽會將屍體焚毀，至於夜晚……實在太短，根本就來不及處理。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811915
    m_Localized: 'GraveDigger: 再也沒人會把死者送來……大家就連死亡都不在乎，就更不要說體面送終了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811914
    m_Localized: 'GraveDigger: 現在，這項工作根本一文不值。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811913
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811912
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811911
    m_Localized: 'GraveDigger: 我頭也不回、連滾帶爬地逃離了現場。我不敢回家，心想……要是能和其他人待在一起的話，應該會比較安全。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811910
    m_Localized: 'GraveDigger: 竟然是個快要破土而出的偽人！而命令我向下挖的傢伙，卻不知怎地、大笑了起來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811909
    m_Localized: 'GraveDigger: 我還以為是塊石頭來著，結果——冒出來了一顆腦袋！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811908
    m_Localized: 'GraveDigger: 我不斷地挖、死命地挖……然後，嘣的一聲——鏟子突然碰到了什麼東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811907
    m_Localized: 'GraveDigger: 發出這個指示的傢伙就在一旁看著。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811906
    m_Localized: 'GraveDigger: 媽的，我當時正辛辛苦苦地在挖掘墓穴。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811905
    m_Localized: 你就這樣丟下了自己的工作？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811904
    m_Localized: 你在外面遇到什麼事情了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617825
    m_Localized: 'GraveDigger: 栽在哪裡、爛在哪裡，太陽自會把屍體給燒成灰燼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617824
    m_Localized: 'GraveDigger: 最近，大家正接連不斷地死掉。然而，再也沒人會埋葬逝者了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617823
    m_Localized: 'GraveDigger: 你不知道我在挖掘之前那個坑洞的時候都看到了一些什麼……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617822
    m_Localized: 'GraveDigger: 抱歉。不過，之所以會這麼慌張、是有原因的……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617821
    m_Localized: 你就這樣丟下了自己的工作？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617820
    m_Localized: 你在外面遇到什麼事情了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617819
    m_Localized: 'GraveDigger: 墓穴早成擺設——如今這個世道，栽在哪裡、爛在哪裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617818
    m_Localized: 'GraveDigger: 你知道嗎？我曾是一名掘墓人……然而現在，這一職業早已失去意義。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617817
    m_Localized: 'GraveDigger: 我自己也已經很久沒有閤上過眼睛了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617816
    m_Localized: 'GraveDigger: 消消氣吧，好嗎？我也不是存心要鬧醒你的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617815
    m_Localized: 要砸就砸自己的腦袋去！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617814
    m_Localized: 不要再砸門了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617813
    m_Localized: 'GraveDigger: 能讓我進去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617812
    m_Localized: 'GraveDigger: 你好？裡面還有人嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617811
    m_Localized: 'Marauder: 好吧……看來，我也得走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617810
    m_Localized: 'Marauder: 哎呀，你已經走了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617809
    m_Localized: 'Marauder: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617808
    m_Localized: 'Marauder: 我只是路過而已，不會在這裡久待。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617807
    m_Localized: 'Marauder: 不知，附近是否有什麼已經沒有人住的地方？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617806
    m_Localized: 'Marauder: 沒問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617805
    m_Localized: 'Marauder: 絕對不會令你感到無聊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617804
    m_Localized: 'Marauder: 對了，三不五時就來找我聊聊吧——我會說說自己一路上遇到的事情。能講的可不止一星半點。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617803
    m_Localized: 'Marauder: 終於可以像個正常人一樣休息一下了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617802
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617801
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617800
    m_Localized: 'Marauder: 總而言之……既然你是這棟房子的主人，能不能——讓我待在這裡過夜？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617799
    m_Localized: 'Marauder: 不過，某次倒是碰上了一些……事情。說來話長了，晚點再講吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617798
    m_Localized: 'Marauder: 聽好——我雖不是什麼正人君子，卻也有著自己的底線。我從來都不會去搶活人的東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617797
    m_Localized: 'Marauder: 等等，你該不會認為我是什麼十惡不赦的罪犯吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617796
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617795
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617794
    m_Localized: 'Marauder: 我可以跟你說說自己在拾荒的過程中碰上的一些事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617793
    m_Localized: 'Marauder: 我真不是故意的。不過，既然你人都已經在這裡了……不如，就讓我在這裡待上一段時間——怎樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617792
    m_Localized: 'Marauder: 不過，還是沒有辦法下定決心……沒錯——我本以為這裡空無一人，正打算要搜刮一番來著。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617791
    m_Localized: 'Marauder: 也曾經有過想要金盆洗手的想法。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617790
    m_Localized: 'Marauder: 把能拿上的東西全都拿上——賣掉一些、留下一些。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617789
    m_Localized: 'Marauder: 嗯……好吧，也沒有什麼說謊的必要。我會專門去搜刮一些已經廢棄了的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617788
    m_Localized: 你以盜竊為生？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617787
    m_Localized: 你一個人是怎麼活下來的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617786
    m_Localized: 'Marauder: 心中的不安正在一點、一滴地滋長。要是像這樣繼續下去的話，精神遲早崩潰。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617785
    m_Localized: 'Marauder: 然而……我已經對此感到厭煩、不想再對著空氣自言自語了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617784
    m_Localized: 'Marauder: 起初，我認為這樣會比較安全。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617783
    m_Localized: 'Marauder: 自從不知道打什麼地方冒出來的偽人開始到處荼毒生靈之後……我就一直在靠自己過活了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617782
    m_Localized: 'Marauder: 總不能是個壞主意吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617781
    m_Localized: 你以盜竊為生？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617780
    m_Localized: 你一個人是怎麼活下來的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617779
    m_Localized: 'Marauder: 雖說如此……也還是找不到一個願意接納我的地方。於是，就只好獨來獨往了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617778
    m_Localized: 'Marauder: 然而，我親眼看到過其他人的所作所為——我根本就與「窮兇極惡」這四個字不沾邊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617777
    m_Localized: 'Marauder: 永遠低人一等。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617776
    m_Localized: 'Marauder: 誰又想與一個偷雞摸狗的傢伙為伍呢？於大家眼裡，我就是渣滓。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617775
    m_Localized: 你為什麼會認為這是個好主意？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617774
    m_Localized: 你為什麼會孤身一人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617773
    m_Localized: 'Marauder: 聽著，是這樣的……不知，你介不介意我在這裡待上一段時間？我已經很久沒……怎麼說呢，跟人來往了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617772
    m_Localized: 'Marauder: 不過……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617771
    m_Localized: 'Marauder: 你好。我本以為這棟房子已經荒廢了——我這就走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617770
    m_Localized: 'Marauder: 不對，等等……竟然有人住在這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617769
    m_Localized: 'Provocateur: 祝你度過美好的一天……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617768
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617767
    m_Localized: 'Provocateur: 相信我，這對你而言絕非好事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617766
    m_Localized: 'Provocateur: 注意你的語氣。我感到自己的生命安全受到了威脅，因此——此舉違反了憲法第119條的規定。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617765
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617764
    m_Localized: 'Provocateur: 「趕緊離開吧」？難道，你在恐嚇我？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617763
    m_Localized: 'Provocateur: 至於具體的租賃條款……我們就稍後再詳細地討論吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617762
    m_Localized: 'Provocateur: 謝謝，屋主。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617761
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617760
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617759
    m_Localized: 'Provocateur: 要嘛就讓我交付租金，要嘛就別讓我住進去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617758
    m_Localized: 'Provocateur: 既不恰當、也不合法……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617757
    m_Localized: 'Provocateur: 抱歉。要是不付租金的話，我實在無法心安理得地住在這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617756
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617755
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617754
    m_Localized: 'Provocateur: 好吧。之後再正式處理也行——到時，我們需要簽訂一份具有法律效力的完整契約。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617753
    m_Localized: 'Provocateur: 難以置信……竟然會有屋主對金錢不屑一顧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617752
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617751
    m_Localized: 'Provocateur: 你是想賣我人情還是怎樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617750
    m_Localized: 我並不會向他人收取租金
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617749
    m_Localized: 隨你高興就好
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617748
    m_Localized: 'Provocateur: 不好意思，我實在無法容忍自己佔用了寶貴的空間卻不去支付應該承擔的費用。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617747
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617746
    m_Localized: 'Provocateur: 「我只不過是讓大家進來待著罷了」？難道，你是志工什麼的？專門為無家可歸的人們提供住所，諸如此類？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617745
    m_Localized: 我並不會向他人收取租金
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617744
    m_Localized: 隨你高興就好
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617743
    m_Localized: 'Provocateur: 不過……還是想事先跟你確認清楚——請問，這裡每晚的租金是多少呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617742
    m_Localized: 'Provocateur: 好吧，無妨。相關細節晚點再敲定就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617741
    m_Localized: 'Provocateur: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617740
    m_Localized: 'Provocateur: 還真是個……模稜兩可的回答。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617739
    m_Localized: 我只不過是讓大家進來待著罷了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617738
    m_Localized: 也可以這麼說吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617737
    m_Localized: 'Provocateur: 日安，屋主。請問——這裡是否有房出租？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617736
    m_Localized: 'TaxiDriver: 你根本就沒比那群FEMA的混蛋好到哪裡去——希望你爛在這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617735
    m_Localized: 'TaxiDriver: 該死……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617734
    m_Localized: 'TaxiDriver: 沒錯，我承認——我的確慌了神。不過，也不能只因這樣、就把我給拒之門外吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617733
    m_Localized: 'TaxiDriver: 拜託，兄弟……不要這樣對我！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617732
    m_Localized: 'TaxiDriver: 只要稍微移開視線，他們就會立即向你撲來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617731
    m_Localized: 'TaxiDriver: 記住——千萬不要相信那些穿著黃色衣服的混蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617730
    m_Localized: 'TaxiDriver: 呼……謝了，兄弟。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617729
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617728
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617727
    m_Localized: 'TaxiDriver: 因此，我頭也不回地跑了。現在，就連家也回不去了——我敢打賭那群衣冠禽獸早就已經在那裡守株待兔了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617726
    m_Localized: 'TaxiDriver: 你知道嗎？他們不僅要把我送過去的人給關起來，還想對我如法炮製。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617725
    m_Localized: 'TaxiDriver: 於是，我沒有猶豫、立即把車子開到了FEMA的地盤。現在想來，真是大錯特錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617724
    m_Localized: 'TaxiDriver: 我不經意地瞄了一眼後視鏡，結果發現……這個傢伙的牙齒白得不行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617723
    m_Localized: 'TaxiDriver: 他……不對——它，是個偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617722
    m_Localized: 'TaxiDriver: 希望你不要因此覺得我是個疑神疑鬼、過度猜疑的傢伙。總之，我很確定……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617721
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617720
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617719
    m_Localized: 'TaxiDriver: 因此，我掏出了藏在大衣裡面的瓶子、往其中一個的頭上狠狠地砸了上去。之後，便逃之夭夭了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617718
    m_Localized: 'TaxiDriver: 我立即就後悔了。你猜怎樣樣？當他們粗暴地把我給拽出車子時，我馬上就意識到——這群混蛋也想找我的麻煩。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617717
    m_Localized: 'TaxiDriver: 起初，他們還誇我，說——「做得漂亮，你給我們押了個偽人過來。」然後，下一刻……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617716
    m_Localized: 'TaxiDriver: 於是，我就偷偷地把車子開到了FEMA的地盤。抵達之後，工作人員二話不說、立即就把這個傢伙給關起來了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617715
    m_Localized: 'TaxiDriver: 當時，我正載著一名乘客。結果，突然之間留意到對方的牙齒白得可怕。就是，非常完美、無瑕的那種。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617714
    m_Localized: 'TaxiDriver: 被那群FEMA的混蛋給扣走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617713
    m_Localized: 你的乘客怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617712
    m_Localized: 你的車子怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617711
    m_Localized: 'TaxiDriver: 不要誤會。倒不是說我是個白癡，只是錯信了他人而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617710
    m_Localized: 'TaxiDriver: 都是因為自己犯傻，才會導致這種結果。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617709
    m_Localized: 'TaxiDriver: 唉……我之前有過一台車子。現在？它已經，這麼說吧——離我而去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617708
    m_Localized: 你的乘客怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617707
    m_Localized: 你的車子怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617706
    m_Localized: 'TaxiDriver: 然而，最後……我不光沒能逮住這個傢伙，甚至還把自己的車子給賠進去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617705
    m_Localized: 'TaxiDriver: 我被騙了——對方根本不是人類。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617704
    m_Localized: 'TaxiDriver: 當時，我正載著一名乘客。結果……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617703
    m_Localized: 'TaxiDriver: 哎呀……該從哪裡說起好呢？如你所見，我是個計程車司機。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617702
    m_Localized: 我能幫上忙嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617701
    m_Localized: 發生了什麼事？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617700
    m_Localized: 'TaxiDriver: 聽著，我現在的處境糟糕透頂。不知……你介不介意讓我暫時在這裡避避風頭？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617699
    m_Localized: 'TaxiDriver: 你好，兄弟。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617698
    m_Localized: 'Edgar: 我會尋找其他住處。只是……到時，還請不要將我的屍體拋於街上。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617697
    m_Localized: 'Edgar: 我會靜靜等候死亡的到來，待它將我溫柔地擁進懷中。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617696
    m_Localized: 'Edgar: 既然如此……不知，你是否介意我待在附近？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617695
    m_Localized: 'Edgar: 一切塵埃落定之後，把我的屍體留下吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617694
    m_Localized: 'Edgar: 雖然不太清楚你對美的理解是否與我一致，不過……告訴我吧——你應該不會把屍體棄於門外，對嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617693
    m_Localized: 'Edgar: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617692
    m_Localized: 'Edgar: 真的——這裡比我待過的其他地方都要更加安靜。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617691
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617690
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617689
    m_Localized: 'Edgar: 當世界迎來無可避免的終結時，我希望能與其輕柔地融為一體。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617688
    m_Localized: 'Edgar: 我正是為此前來拜訪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617687
    m_Localized: 'Edgar: 我……並不需要這種仁慈。我總感覺……只要在這裡，就能做好面對必然之事的準備。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617686
    m_Localized: 'Edgar: 你認為這樣能舒緩敗血症？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617685
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617684
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617683
    m_Localized: 'Edgar: 現在，我來到了這裡、站在了你面前……孑然一身。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617682
    m_Localized: 'Edgar: 直至有人不請自來……至於，之後發生了什麼事情……我想，你應該可以想像得到。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617681
    m_Localized: 'Edgar: 每天，她都……不斷地蛻變著。而這過程令人屏息。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617680
    m_Localized: 'Edgar: 我曾經與自己深愛過的一個女孩共同生活。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617679
    m_Localized: 'Edgar: 你會對此感到疑惑也是無可厚非。不過，現在……這麼說吧——'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617678
    m_Localized: 是不是……把這條手臂給切除掉會比較好？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617677
    m_Localized: 你是怎麼染上壞疽的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617676
    m_Localized: 'Edgar: 我與城市的沸反盈天、張皇失措格格不入——人人都在逆流而行、妄圖截天改道。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617675
    m_Localized: 'Edgar: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617674
    m_Localized: 'Edgar: 我這樣的人生……如果將其比作美酒，最好是能一口氣吞下、沒有必要去細細品味。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617673
    m_Localized: 'Edgar: 每天，我都不知道自己究竟是否還能活著迎來破曉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617672
    m_Localized: 'Edgar: 當然——無論怎樣，我還是會抖個不停。畢竟……問題出在這條已經腐爛了的手臂上。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617671
    m_Localized: 'Edgar: 你知道嗎？大街已經不再涼快，就連晚上也不例外。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617670
    m_Localized: 'Edgar: 即便是在炎熱的城市之中，我依舊會不由自主地顫抖。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617669
    m_Localized: 'Edgar: 如此寂靜……萬籟俱空。時間彷彿於此凝滯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617668
    m_Localized: 是不是……把這條手臂給切除掉會比較好？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617667
    m_Localized: 你是怎麼染上壞疽的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617666
    m_Localized: 'Edgar: 我想要在這裡走完最後一程。靜靜地、好好地感受每個瞬間。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617665
    m_Localized: 'Edgar: 人人都想抓住一線生機、拚了命地求生。然而，如果是在這裡……大家反而可以心平氣和地接受自己的命運、迎來自己的終局。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617664
    m_Localized: 'Edgar: 城市的喧囂如同汗水一般黏附於我——無比癡狂、亂作一團。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617663
    m_Localized: 'Edgar: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617662
    m_Localized: 'Edgar: 我這樣的人生……要是將其比作美酒的話，最好能一口氣吞下、沒有必要細細品味。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617661
    m_Localized: 'Edgar: 每天，我都不知道自己究竟是否還能活著迎來破曉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617660
    m_Localized: 'Edgar: 我感到非常的不舒服——並不僅僅是因為壞疽。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617659
    m_Localized: 這個地方……到底漂亮在哪裡？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617658
    m_Localized: 為何不待在自己家裡？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617657
    m_Localized: 'Edgar: 希望你可以允許我在此處待上幾天。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617656
    m_Localized: 'Edgar: 比起充斥著尖叫、嘶吼的城市要更加的安靜。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617655
    m_Localized: 'Edgar: 你好——真是一個漂亮的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617654
    m_Localized: 'Foreigner: （一會之後，他轉過身去、就此離開了）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617653
    m_Localized: 'Foreigner: （你的吼叫嚇到了他）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617652
    m_Localized: 'Foreigner: 快點離開啦！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617651
    m_Localized: 'Foreigner: （他依舊站在原地、一動不動，不停地嘟囔著些什麼）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617650
    m_Localized: 'Foreigner: （他點了點頭、走進了屋裡）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617649
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617648
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617647
    m_Localized: 'Foreigner: （雖然無法確定，不過……他的臉頰似乎滿是淚痕）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617646
    m_Localized: 'Foreigner: （他站在原地、一動不動，雙眼死死地盯著貓眼）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617645
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617644
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617643
    m_Localized: 'Foreigner: （雖然無法確定，不過……他的臉頰似乎滿是淚痕）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617642
    m_Localized: 'Foreigner: （他嘟囔著什麼、揮舞起了雙臂）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617641
    m_Localized: 我到底該拿你怎麼辦呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617640
    m_Localized: 你把自己的嘴巴給縫住了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617639
    m_Localized: 'Foreigner: （他再次嘟囔了起來——然而，你根本無法聽清他在說著些什麼）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617638
    m_Localized: 'Foreigner: （他皺起眉頭、顯得很痛苦）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617637
    m_Localized: 我到底該拿你怎麼辦呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617636
    m_Localized: 你把自己的嘴巴給縫住了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617635
    m_Localized: 'Foreigner: （他似乎無法回答）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617634
    m_Localized: 'Foreigner: （對方看向你、揚起了眉毛）'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617633
    m_Localized: 蛤？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617632
    m_Localized: 你怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617631
    m_Localized: 'Foreigner: 嗯嗯嗯嗯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617630
    m_Localized: 'Foreigner: 嗯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617629
    m_Localized: 'Doctor: 要是走運的話，應該可以在附近找到住處……如果有需要，隨時來找我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617628
    m_Localized: 'Doctor: 我能理解。如今這個世道，疑心難免。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617627
    m_Localized: 'Doctor: 謝謝。希望，我能幫上一點忙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617626
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617625
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617624
    m_Localized: 'Doctor: 如果你能讓我進去，我可以跟你講講都發生了些什麼事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617623
    m_Localized: 'Doctor: 說來話長。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617622
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617621
    m_Localized: 'Doctor: 之前，在市中心的附近有一家醫院——只是……'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668865
    m_Localized: 'Doctor: 如果你能讓我進去，我可以跟你講講醫院都發生了些什麼事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668864
    m_Localized: 'Doctor: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617620
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617619
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617618
    m_Localized: 'Doctor: 然而，現在……根本就沒有所謂的醫院了。於是，我只好四處漂泊、盡己所能地為有需要的人提供幫助。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617617
    m_Localized: 'Doctor: 我們的病房一直以來都經費短缺，因此……我常常需要接手一些病情超出我專業領域的病人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617616
    m_Localized: 'Doctor: 我是個外科醫師——曾經幫無數的患者動過手術。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617614
    m_Localized: 你是從哪裡來的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617613
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617612
    m_Localized: 'Doctor: 結果發現，門鎖上了。於是，決定在動手把它撬開之前、還是先敲一敲，確定一下有沒有人比較妥當。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617611
    m_Localized: 'Doctor: 四周一片寂靜……說實話，我本以為這棟房子已經荒廢了、沒人居住。心想——要不看看裡面是什麼情況好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617610
    m_Localized: 'Doctor: 安全……以及，要是走運的話——能消除無聊的事物。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617609
    m_Localized: 'Doctor: 沒錯，我的確是在找什麼東西。只是，跟其他人所追求的也沒什麼兩樣就對了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617608
    m_Localized: 'Doctor: 哎呀……為何會冷不防地冒出這樣一個問題？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617607
    m_Localized: 你是從哪裡來的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617606
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617605
    m_Localized: 'Doctor: 甚至乎是，會有人因為無法承受的悲痛而嚎啕。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617604
    m_Localized: 'Doctor: 又或者是，會有人在痛苦地尖叫。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617603
    m_Localized: 'Doctor: 一般來說，會有喝得醉醺醺的傢伙在大吼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617602
    m_Localized: 'Doctor: 只不過是覺得稀奇罷了。畢竟，這麼大的一棟房子、到了晚上卻如此安靜——這種情況並不常見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617601
    m_Localized: 'Doctor: 蛤？哎呀……沒有，當然不是。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617600
    m_Localized: 你是在找什麼東西嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423454
    m_Localized: 你……是在監視這棟房子嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423453
    m_Localized: 'Doctor: 晚安——請問，能讓我進去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423452
    m_Localized: 'Doctor: 夜幕降臨之後，這裡實在是太過安靜了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423451
    m_Localized: 'Doctor: 噢，我還以為沒人在家。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423450
    m_Localized: 'Wolfhound: 等著瞧吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423449
    m_Localized: 'Wolfhound: 我知道你在玩什麼把戲了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423448
    m_Localized: 'Wolfhound: 如今，誰拳頭大、誰就有理。如果無法順應時勢，就只能被潮流淹沒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423447
    m_Localized: 'Wolfhound: 聰明。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423446
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423445
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423444
    m_Localized: 'Wolfhound: 重點在於，我並沒有要在這裡惹是生非的意思。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423443
    m_Localized: 'Wolfhound: 無知是福——我不會過問你所選擇的生活方式，因此……也希望你不要窺探我的生存之道。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423442
    m_Localized: 'Wolfhound: 你……還挺自以為是的嘛。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423441
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423440
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423439
    m_Localized: 'Wolfhound: 至於這裡？出乎我意料的是，依然存在著秩序。真是罕見……非常好奇你究竟是怎麼做到這點的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423438
    m_Localized: 'Wolfhound: 只是，相同的亂像也在別處上演、俯拾皆是。恐懼遮蔽人們的雙眼，令他們無法看清真相。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423437
    m_Localized: 'Wolfhound: 我從來都不會在同一個地方待上太長的時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423436
    m_Localized: 你為什麼能一直活到現在？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423435
    m_Localized: 你都去過一些什麼地方？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423434
    m_Localized: 'Wolfhound: 敢不認同，就再也見不到第二天的太陽。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423433
    m_Localized: 'Wolfhound: 全新的秩序已然建立——強大就是真理。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423432
    m_Localized: 'Wolfhound: 要是一味否認的話，絕對會被生吞活剝、就連骨頭也不剩下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423431
    m_Localized: 'Wolfhound: 我們都是動物。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423430
    m_Localized: 你為什麼能一直活到現在？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423429
    m_Localized: 你都去過一些什麼地方？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423428
    m_Localized: 'Wolfhound: 現在？勝者為王、敗者為寇，就是這麼簡單。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423427
    m_Localized: 'Wolfhound: 一切的規矩、道德，全都灰飛煙滅了——根本就不再管用。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423426
    m_Localized: 'Wolfhound: 你有拜訪過其他人嗎？你有踏出過這地方嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423425
    m_Localized: 你也是其中一隻野獸嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423424
    m_Localized: 你在說什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423423
    m_Localized: 'Wolfhound: 終於……去除了所有的偽裝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423422
    m_Localized: 'Wolfhound: 社會已經蕩然無存，野獸盡數傾巢而出。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423421
    m_Localized: 'Wolfhound: 如今，整個世界都亂套了——對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423420
    m_Localized: 'Wolfhound: 你好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423419
    m_Localized: 'SuperFake: 為什麼還反抗呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423418
    m_Localized: 'SuperFake: 我很清楚，一切很快就會結束。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423417
    m_Localized: 'SuperFake: 你在執著於什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423416
    m_Localized: 'SuperFake: 為什麼要這樣呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423415
    m_Localized: 'SuperFake: 一直都在逃避、從來沒有停歇——不光躲著我的族人，還躲著背後的真相。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423414
    m_Localized: 'SuperFake: 正因如此，我才會來到這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423413
    m_Localized: 'SuperFake: 還是沒有辦法親自來處理這些問題，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423412
    m_Localized: 'SuperFake: 沒錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423411
    m_Localized: 'SuperFake: 你害怕嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423410
    m_Localized: 'SuperFake: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423409
    m_Localized: 'SuperFake: 看來，你已經做好了準備。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423408
    m_Localized: 我除掉了幾個人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423407
    m_Localized: 我除掉了一切無關緊要的人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423406
    m_Localized: 我只讓對的人進來
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423405
    m_Localized: 這裡還有大量的……非人之人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423404
    m_Localized: 我並沒有讓任何人進來
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423403
    m_Localized: 這裡還有很多其他人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423402
    m_Localized: 'SuperFake: 告訴我吧，這裡除了你之外、還有沒有其他人？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423401
    m_Localized: 'SuperFake: 不過，我還是對其他事情更感興趣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423400
    m_Localized: 'SuperFake: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423399
    m_Localized: 'SuperFake: 你還會有所感覺嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423398
    m_Localized: 'SuperFake: 只是……就此消失？永不存在？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423397
    m_Localized: 'SuperFake: 你會死去——然後，將有什麼等待著你呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423396
    m_Localized: 'SuperFake: 看來，你更關注接下來會發生什麼事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423395
    m_Localized: 'SuperFake: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423394
    m_Localized: 'SuperFake: 你會不會經常感到疑惑——自己到底為什麼還活著？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423393
    m_Localized: 'SuperFake: 未知的事物實在把你嚇得夠嗆，嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423392
    m_Localized: 我除掉了幾個人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423391
    m_Localized: 我除掉了一切無關緊要的人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423390
    m_Localized: 我只讓對的人進來
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423389
    m_Localized: 這裡還有大量的……非人之人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423388
    m_Localized: 我並沒有讓任何人進來
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423387
    m_Localized: 這裡還有很多其他人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423386
    m_Localized: 'SuperFake: 告訴我吧，這裡就只有你一人嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423385
    m_Localized: 'SuperFake: 你有讓其他人進去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423384
    m_Localized: 'SuperFake: 不過，現在……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423383
    m_Localized: 'SuperFake: 你會消失。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423382
    m_Localized: 'SuperFake: 不是今天，就是明天。不是明天，就是後天。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423381
    m_Localized: 'SuperFake: 你會死去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423380
    m_Localized: 'SuperFake: 無所謂了，反正結果都一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423379
    m_Localized: 'SuperFake: 是為了改變什麼東西嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423378
    m_Localized: 'SuperFake: 之所以會派我來這裡，一定有著相應的理由……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423377
    m_Localized: 'SuperFake: 你有沒有想過——自己是被選中的人？哈哈哈。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423376
    m_Localized: 'SuperFake: 真假？早不問、晚不問，現在問？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423375
    m_Localized: 為何不直接把門破開、一了百了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423374
    m_Localized: 你為什麼會來這裡？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423373
    m_Localized: 'SuperFake: 放心，我們會幫你的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423372
    m_Localized: 'SuperFake: *你*竟然沒有任何感覺——真是有趣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423371
    m_Localized: 'SuperFake: 無可奉告。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423370
    m_Localized: 為何不直接把門破開、一了百了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423369
    m_Localized: 你為什麼會來這裡？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423368
    m_Localized: 'SuperFake: 早就已經悄然降臨在你的背後。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423367
    m_Localized: 'SuperFake: 不過，你能感受到嗎？死亡正在一點、一滴地逼近。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423366
    m_Localized: 'SuperFake: 僅此而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423365
    m_Localized: 'SuperFake: 我只不過是在向你如實轉告我所得知的事情罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423364
    m_Localized: 結束？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423363
    m_Localized: 這是什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423362
    m_Localized: 'SuperFake: 如果不是由我們來終結，就得由你來畫下句號了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423361
    m_Localized: 'SuperFake: 一切已經快要結束。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423360
    m_Localized: 'SuperFake: 我被告知這是最後一次與你交談了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423359
    m_Localized: 'SuperFake: 我們就……之後再見吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423358
    m_Localized: 'SuperFake: 好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423357
    m_Localized: 'SuperFake: 我只不過是在聽命行事罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423356
    m_Localized: 'SuperFake: 在我之上，還有別人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423355
    m_Localized: 'SuperFake: 你該不會認為是我策劃了這一切吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423354
    m_Localized: 'SuperFake: 變化對你而言並非最為糟糕的東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423353
    m_Localized: 'SuperFake: 現在，即使是我的族人也已經相當罕見了——就更別提被你關在這棟房子裡的、你的族人了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423352
    m_Localized: 'SuperFake: 哎呀、哎呀。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423351
    m_Localized: 'SuperFake: 跟我來吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423350
    m_Localized: 'SuperFake: 好了，新規則奇巧了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423349
    m_Localized: 'SuperFake: 嗯……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423348
    m_Localized: 這裡還有其他的人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423347
    m_Localized: 這裡就只有我一人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423346
    m_Localized: 'SuperFake: 告訴我吧，這裡就只有你一人嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423345
    m_Localized: 'SuperFake: 不過，在此之前——先試試我們的新規則吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423344
    m_Localized: 'SuperFake: 沒問題！我本就打算要走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423343
    m_Localized: 這裡還有其他的人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423342
    m_Localized: 這裡就只有我一人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423341
    m_Localized: 'SuperFake: 告訴我吧，這裡就只有你一人嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423340
    m_Localized: 'SuperFake: 不過，首先……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423339
    m_Localized: 'SuperFake: 來試試吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423338
    m_Localized: 'SuperFake: 非常簡單。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423337
    m_Localized: 你能晚點再來嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423336
    m_Localized: 我不明白
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423335
    m_Localized: 'SuperFake: 就打開門、讓我進去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423334
    m_Localized: 'SuperFake: 如果你的房子裡起碼有著兩個我的族人……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423333
    m_Localized: 'SuperFake: 來解決一下這個問題吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423332
    m_Localized: 'SuperFake: 就好像，你根本就不在乎自己一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423331
    m_Localized: 'SuperFake: 超然、冷漠，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423330
    m_Localized: 你能晚點再來嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423329
    m_Localized: 我不明白
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423328
    m_Localized: 'SuperFake: 因為——現在，屍體已是狗狗的東西了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423327
    m_Localized: 'SuperFake: 就打開門、讓我進去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423326
    m_Localized: 'SuperFake: 如果你的房子裡起碼有著兩個我的族人……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423325
    m_Localized: 'SuperFake: 來試試新的規則好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423324
    m_Localized: 'SuperFake: 看來，你需要幫助。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423323
    m_Localized: 'SuperFake: 一定很難吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423322
    m_Localized: 我並不在乎
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423321
    m_Localized: 我感受不到
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423320
    m_Localized: 'SuperFake: 奇怪的事情不斷地在你的身邊發生。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423319
    m_Localized: 'SuperFake: 你很清楚我指的是誰，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423318
    m_Localized: 'SuperFake: 只因一個字。僅僅一個字，卻意義非凡！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423317
    m_Localized: 'SuperFake: 至於某個特定的人……其已不再為之赴死。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423316
    m_Localized: 'SuperFake: 我也正在向你逼近。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423315
    m_Localized: 'SuperFake: 變化正在向你逼近。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423314
    m_Localized: 'SuperFake: 如何——感受到了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423313
    m_Localized: 'SuperFake: 再次見面的時候，事情應該會……變得更加有趣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423312
    m_Localized: 'SuperFake: 你已經跟不上節奏了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423311
    m_Localized: 'SuperFake: 生活已經發生了變化。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423310
    m_Localized: 'SuperFake: 你自己也很清楚，不是嗎？一切都已經沒有可能回到之前的樣子了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423309
    m_Localized: 'SuperFake: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423308
    m_Localized: 'SuperFake: 現在，這個世界已經是狗狗的東西了。只有它們會存活下來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423307
    m_Localized: 'SuperFake: 為什麼要這樣做呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423306
    m_Localized: 'SuperFake: 還是在拚命縫補自己的人生。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423305
    m_Localized: 'SuperFake: 就讓我來打開大門，給你留下點什麼吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423304
    m_Localized: 'SuperFake: 不喜歡與其他人來往，對嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423303
    m_Localized: 'SuperFake: 只有你一人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423302
    m_Localized: 這裡還有其他的人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423301
    m_Localized: 這裡就只有我一人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423300
    m_Localized: 'SuperFake: 告訴我吧，這裡就只有你一人嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423299
    m_Localized: 'SuperFake: 聽好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423298
    m_Localized: 'SuperFake: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423297
    m_Localized: 'SuperFake: 你能阻止的，除了心跳、再無他物。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423296
    m_Localized: 'SuperFake: 你能阻止洪水、火災，以及衰落嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229051
    m_Localized: 'SuperFake: 你能阻止死亡嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229050
    m_Localized: 'SuperFake: 你又能做什麼呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229049
    m_Localized: 這裡還有其他的人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229048
    m_Localized: 這裡就只有我一人
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229047
    m_Localized: 'SuperFake: 告訴我吧，這裡就只有你一人嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229046
    m_Localized: 'SuperFake: 聽好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229045
    m_Localized: 'SuperFake: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229044
    m_Localized: 'SuperFake: 對於死亡一事，你又能做什麼呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229043
    m_Localized: 'SuperFake: 對於太空災禍，你又能做什麼呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229042
    m_Localized: 'SuperFake: 對於自然災害，你又能做什麼呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229041
    m_Localized: 'SuperFake: 我再清楚不過了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229040
    m_Localized: 我正在盡己所能
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229039
    m_Localized: 我什麼都做不到
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229038
    m_Localized: 'SuperFake: 又或者說，你想自行處理一切？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229037
    m_Localized: 'SuperFake: 一種福分——你說對嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229036
    m_Localized: 'SuperFake: 命運早已註定。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229035
    m_Localized: 'SuperFake: 思考只是徒勞。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229034
    m_Localized: 我正在盡己所能
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229033
    m_Localized: 我什麼都做不到
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229032
    m_Localized: 'SuperFake: 又或者說，我們該親自來處理這些問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229031
    m_Localized: 'SuperFake: 也許，他們能給大家帶來秩序。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229030
    m_Localized: 'SuperFake: 一波未平，一波又起——對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229029
    m_Localized: 'SuperFake: 如今，世道艱難。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229028
    m_Localized: 我不知道該作何感受
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229027
    m_Localized: 照我看來，他只不過是想要做好自己的分內工作罷了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229026
    m_Localized: 'SuperFake: 對於這些穿著制服的傢伙，你怎麼看？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229025
    m_Localized: 'SuperFake: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229024
    m_Localized: 'SuperFake: 你還是躲在這棟房子裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229023
    m_Localized: 'Greatmother: 我會把自己的家人帶來這裡——我會確保你不會孤獨死去。哈哈哈哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229022
    m_Localized: 'Greatmother: 哈哈哈哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229021
    m_Localized: 'Greatmother: 最好——千萬不要給任何人開門。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229020
    m_Localized: 'Greatmother: 好吧，只是……千萬別給穿著制服的傢伙開門，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229019
    m_Localized: 'Greatmother: 不然，他們會把我們都給拖走、關進不知道什麼地方裡去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229018
    m_Localized: 'Greatmother: 謝謝。千萬別給穿著黃色衣服的傢伙開門，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229017
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229016
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229015
    m_Localized: 'Greatmother: 於是……現在，活下去成為了唯一的目的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229014
    m_Localized: 'Greatmother: 大概抓走了超過半數的人。至於剩下的居民——他們甚至都沒有怎麼去管，也沒來追。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229013
    m_Localized: 'Greatmother: 一些居民不願意離開，穿著黃色衣服的傢伙就硬是把他們給拖走了……就好像是在隨便挑人一樣，毫無章法可言。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229012
    m_Localized: 'Greatmother: 拜託，整棟建築的人都被趕了出去、無一例外！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229011
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229010
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229009
    m_Localized: 'Greatmother: 至於剩下的人，他們就放走了——好像什麼都沒有發生過一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229008
    m_Localized: 'Greatmother: 一些穿著黃色衣服的傢伙衝了進來，把大家都給趕了出去。而且，還抓走了其中的好些居民回去進行研究。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229007
    m_Localized: 'Greatmother: 說是我們住的地方遭遇了猛烈的太陽風暴襲擊還是什麼東西來著。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229006
    m_Localized: 你們人數很多嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229005
    m_Localized: 你們為什麼會遭到驅逐？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229004
    m_Localized: 'Greatmother: 之後，我就一直在四處奔波、想找個能住的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229003
    m_Localized: 'Greatmother: 整個街區都被淨空了，該死……誰都不知道該往哪去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229002
    m_Localized: 'Greatmother: 我沒有在找人。只是需要一個落腳的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229001
    m_Localized: 你們人數很多嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229000
    m_Localized: 你們為什麼會遭到驅逐？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228999
    m_Localized: 'Greatmother: 只好各奔東西。於是，我來到了這裡碰碰運氣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228998
    m_Localized: 'Greatmother: 沒有住的地方，只有死路一條。誰也不知道自己該去哪裡、該做什麼……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228997
    m_Localized: 'Greatmother: 沒曾想，來了幾個穿著黃色衣服的傢伙、把大家通通都轟了出去——而且，也沒有把我們給帶到其他地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228996
    m_Localized: 'Greatmother: 我和我的家人之前就住在離這裡幾個街區的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228995
    m_Localized: 你是在找人嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228994
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228993
    m_Localized: 'Greatmother: 有人在嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228992
    m_Localized: 'Greatmother: 你好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034796
    m_Localized: 'Cold: 好吧。看來，你並不願意浪費子、子彈。再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034795
    m_Localized: 'Cold: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034794
    m_Localized: 'Cold: 不、不知，是否可以給我來上一槍？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034793
    m_Localized: 'Cold: 我留意到你的手、手上沾滿了火、火藥的汙漬。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034792
    m_Localized: 'Cold: 好吧，再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034791
    m_Localized: 'Cold: 我能理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034790
    m_Localized: 'Cold: 雖然天花板有、有點低，不過也沒關係。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034789
    m_Localized: 'Cold: 謝、謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034788
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034787
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034786
    m_Localized: 'Cold: 我會離開，不會乞求。不、不會打擾到你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034785
    m_Localized: 'Cold: 你沒有必要讓我進去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034784
    m_Localized: 'Cold: 不了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034783
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034782
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034781
    m_Localized: 'Cold: 萬一情況變得更加糟、糟糕，該怎麼辦？萬一我還是無法因此而死、獲得解脫，該怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034780
    m_Localized: 'Cold: 我害怕脫、脫下衣服。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034779
    m_Localized: 'Cold: 其他人都熱、熱得不行，站在太陽底下甚至會被活活烤死。而我將自己層層包裹，卻還是會感到非常寒、寒冷。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034778
    m_Localized: 'Cold: 我總是感到非常寒、寒冷。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034777
    m_Localized: 把夾克給脫下吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034776
    m_Localized: 你不熱嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034775
    m_Localized: 'Cold: 也就是說……已經尋找非、非常長的一段時間了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034774
    m_Localized: 'Cold: 我從未擁有安、安寧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034773
    m_Localized: 'Cold: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034772
    m_Localized: 把夾克給脫下吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034771
    m_Localized: 你不熱嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034770
    m_Localized: 'Cold: 還是晚點再說吧。我……不是很確定是否該現、現在提出。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034769
    m_Localized: 'Cold: 我並不、不是。不過，我有一個請求。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034768
    m_Localized: 'Cold: 我是誰其實一點也不重、重要——你懷疑我會不會是個偽人，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034767
    m_Localized: 你尋找多久了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034766
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034765
    m_Localized: 'Cold: 不知，我能否在此獲得一、一絲安寧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034764
    m_Localized: 'Cold: 雖然我可以忍、忍受酷熱，不過……還是需要尋找一個安靜的地方好好休息。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034763
    m_Localized: 'Cold: 你好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034762
    m_Localized: 'Hunter: 我對天發誓——一定不會放過任何一個偽人。你就走著瞧好了，孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034761
    m_Localized: 'Hunter: 要是住下來了的話，保不準會在今晚割斷我的喉嚨。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034760
    m_Localized: 'Hunter: 也好——說不定，你就是個偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034759
    m_Localized: 'Hunter: 我們將聯手把它們給消滅掉，絕對不會讓這些傢伙靠近。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034758
    m_Localized: 'Hunter: 我看得出來——你跟其他孬種不一樣，非常有骨氣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034757
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034756
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034755
    m_Localized: 'Hunter: 它們早就已經沒有任何人性可言，孩子……只剩一副虛假的皮囊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034754
    m_Localized: 'Hunter: 我不停地逃跑、它們不斷開槍——一群把胡鬧當作樂趣的怪胎。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034753
    m_Localized: 'Hunter: 這些傢伙竟然等到我在睡過去後把它給順走了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034752
    m_Localized: 'Hunter: 我之前帶著一把來福槍——不過，卻差點因此而喪命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034751
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034750
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034749
    m_Localized: 'Hunter: 千萬不能對它們心慈手軟，就是這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034748
    m_Localized: 'Hunter: 你今天放走了他們，他們明天就會回來割斷你的喉嚨——懂我的意思嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034747
    m_Localized: 'Hunter: 總不能只把他們給趕跑就算了吧？你看起來也沒有笨到這種程度啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034746
    m_Localized: 'Hunter: 難道，你並不是這樣做的？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034745
    m_Localized: 既然如此，你的武器又在哪裡呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034744
    m_Localized: 你想要獵殺偽人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034743
    m_Localized: 'Hunter: 我可以非常、非常確定地告訴你——它們一定在策劃某種糟糕透頂的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034742
    m_Localized: 'Hunter: 自從太陽出現問題之後，被叫作偽人的傢伙就從地下爬了出來、四處遊蕩。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034741
    m_Localized: 'Hunter: 哪裡，鎮上？我只是來歇一歇腳的而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034740
    m_Localized: 既然如此，你的武器又在哪裡呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034739
    m_Localized: 你想要獵殺偽人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034738
    m_Localized: 'Hunter: 一定要把這些傢伙給消滅乾淨、一個不留。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034737
    m_Localized: 'Hunter: 把自己偽裝成我們的樣子……將整個世界變成人間煉獄。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034736
    m_Localized: 'Hunter: 它們肆虐著一戶又一戶的家庭——不光將人殺死，甚至惡毒地肢解成塊、令其變得支離破碎。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034735
    m_Localized: 'Hunter: 你有看到過偽人的所作所為嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034734
    m_Localized: 到這裡來是要找什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034733
    m_Localized: 為何四處旅行？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034732
    m_Localized: 'Hunter: 不過，我已經沒有辦法再像以前一樣到處亂跑了。真是歲月不饒人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034731
    m_Localized: 'Hunter: 我並不是本地人——一直以來，都不習慣在同一個地方待太久。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034730
    m_Localized: 'Hunter: 你好。這裡的情況如何？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034729
    m_Localized: 'Prophet: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034728
    m_Localized: 'Prophet: 抱歉。我想，離開的時候到了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034727
    m_Localized: 'Prophet: 我已經沒有力氣繼續讀下去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034726
    m_Localized: 'Prophet: 「我們的青春如同焚毀魯昂的烈焰一般尖嘯、嘶吼。」'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034725
    m_Localized: 'Prophet: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034724
    m_Localized: 'Prophet: 非常感謝你願意向我伸出援手，然而——並沒有任何的好轉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034723
    m_Localized: 'Prophet: 真是遺憾。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034722
    m_Localized: 'Prophet: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034721
    m_Localized: 'Prophet: 「某人於兩界之間高歌。火焰——伴我同行。」'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034720
    m_Localized: 'Prophet: 我要走了，再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034719
    m_Localized: 'Prophet: 我想起一些事情了——謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034718
    m_Localized: 'Prophet: 哎呀……原來如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034717
    m_Localized: 'Prophet: 「我們的火車早就已經不再前行，而位於其下的軌道卻依舊轟鳴。」'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034716
    m_Localized: 第10頁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034715
    m_Localized: 第200頁的中間部分。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034714
    m_Localized: 直接翻到最後的部分。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034713
    m_Localized: 'Prophet: 我很害怕。也許，這樣能有所紓解。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034712
    m_Localized: 'Prophet: 還記得嗎？之前，你曾經透過這本書替我算了一下命——現在，能再幫我一次嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034711
    m_Localized: 'Prophet: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034710
    m_Localized: 'Prophet: 會是給你的訊息嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034709
    m_Localized: 'Prophet: 同時，我還想起了這樣的一句話——「跳下去吧」。難道，有著什麼意義？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034708
    m_Localized: 'Prophet: 之前是知道的……關於這點，我倒也還記得。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034707
    m_Localized: 'Prophet: 真是個奇怪的問題。我現在已經完全搞不懂這一切了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034706
    m_Localized: 第10頁？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034705
    m_Localized: 第200頁的中間部分。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034704
    m_Localized: 直接翻到最後的部分。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034703
    m_Localized: 'Prophet: 也許，會有所幫助。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034702
    m_Localized: 'Prophet: 能再幫我算個命嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034701
    m_Localized: 'Prophet: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034700
    m_Localized: 'Prophet: 我已經迷失了自己。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034699
    m_Localized: 'Prophet: 我不知道這到底是給我……抑或是給你的訊息。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034698
    m_Localized: 'Prophet: 只剩下一個不斷浮現在腦海之中的念頭——跳下去吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034697
    m_Localized: 'Prophet: 我……我現在甚至記不起任何的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034696
    m_Localized: 你要死了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034695
    m_Localized: 你在說誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034694
    m_Localized: 'Prophet: 既然如此，當初又為何要這樣做呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034693
    m_Localized: 'Prophet: 然而，現在——她卻要把一切都給收回去嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034692
    m_Localized: 'Prophet: 她令我繼續活著。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034691
    m_Localized: 你要死了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034690
    m_Localized: 你在說誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034689
    m_Localized: 'Prophet: 不要再玩弄我了——不要再靠近我了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034688
    m_Localized: 'Prophet: 我終於意識到了……早就應該這樣了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840573
    m_Localized: 'Prophet: 思緒已經……歸於平靜。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840572
    m_Localized: 'Prophet: 太遲了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840571
    m_Localized: 你看起來……非常糟糕
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840570
    m_Localized: 千萬不要死在門廊上面
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840569
    m_Localized: 'Prophet: 難道……她離我而去了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840568
    m_Localized: 'Prophet: 我的視力正在一點、一滴地衰退，現在已經幾乎什麼都看不見了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840567
    m_Localized: 'Prophet: 我已經忘了你的相貌。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840566
    m_Localized: 'Prophet: 我得靜下心來、獨自思考一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840565
    m_Localized: 'Prophet: 找到這件被埋著的東西之後……千萬不要跳下去——現在，對你來說並沒有什麼幫助。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840564
    m_Localized: 'Prophet: 而你……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840563
    m_Localized: 'Prophet: 一定要這樣做。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840562
    m_Localized: 'Prophet: 我……我記得應該要這樣做。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840561
    m_Localized: 'Prophet: 我需要好好地休息一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840560
    m_Localized: 'Prophet: 找到這件東西後……千萬不要跳下去——現在，還不是時候。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840559
    m_Localized: 'Prophet: 不過……我又想起了一件事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840558
    m_Localized: 'Prophet: 抱歉，我現在沒有辦法清晰地進行思考。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840557
    m_Localized: 你確定嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840556
    m_Localized: 我為什麼會需要那件東西？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840555
    m_Localized: 'Prophet: 你得找到它。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840554
    m_Localized: 'Prophet: 去挖一挖吧，有件東西被埋在了那裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840553
    m_Localized: 'Prophet: 我想起接下來會發生什麼事情了——地下室。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840552
    m_Localized: 'Prophet: 然而，現在……卻好像蒙上了一層烏雲。我看到你迷失於森林之中、被無數的野獸包圍著。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840551
    m_Localized: 'Prophet: 不過，一定存在某種原因——我記得非常地清楚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840550
    m_Localized: 'Prophet: 抱歉……我知道自己說的話聽起來非常奇怪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840549
    m_Localized: 你確定嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840548
    m_Localized: 我為什麼會需要那件東西？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840547
    m_Localized: 'Prophet: 不過，我看不到這件東西究竟是什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840546
    m_Localized: 'Prophet: 去挖一挖吧——有件東西被埋在了那裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840545
    m_Localized: 'Prophet: 你這裡有一間地下室，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840544
    m_Localized: 'Prophet: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840543
    m_Localized: 'Prophet: 來到這裡之前，一切還很清晰。然而，現在……就好像是被濃霧所籠罩著一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840542
    m_Localized: 'Prophet: 一不小心就自言自語了起來——如果嚇到你了，先說一聲抱歉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840541
    m_Localized: 我開始有點後悔相信你了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840540
    m_Localized: 我完全不明白你在說什麼
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840539
    m_Localized: 'Prophet: 然而，現在……似乎出了什麼差錯。或許，跟那個總是帶著蘑菇的傢伙脫不了關係……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840538
    m_Localized: 'Prophet: 只要能恰當地提出請求，祂就會助我們一臂之力。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840537
    m_Localized: 'Prophet: 無需畏懼——畢竟，我們所知尚淺。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840536
    m_Localized: 'Prophet: 你知道嗎？我們之上，有著一個更為強大的存在。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840535
    m_Localized: 'Prophet: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840534
    m_Localized: 'Prophet: 並非如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840533
    m_Localized: 我開始有點後悔相信你了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840532
    m_Localized: 我完全不明白你在說什麼
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840531
    m_Localized: 'Prophet: 新綠的枝椏將會自灰燼之中破土而出、直衝雲霄。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840530
    m_Localized: 'Prophet: 最開始的時候也曾經試過出現一次這樣的情況。一切都會好起來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840529
    m_Localized: 'Prophet: 不過，應該與你、或是她無關……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840528
    m_Localized: 'Prophet: 我感覺自己變得有點虛弱——看得也不如之前那麼遠了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840527
    m_Localized: 'Prophet: 我早就已經得到了幫助。只是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840526
    m_Localized: 你在自言自語嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840525
    m_Localized: 嘿——你需要幫助嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840524
    m_Localized: 'Prophet: 難道，是因為破滅而導致的？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840523
    m_Localized: 'Prophet: 奇怪——這種感覺變得更加詭譎了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840522
    m_Localized: 'Prophet: 你已經在門後了，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840521
    m_Localized: 'Prophet: 希望能在幾天後再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840520
    m_Localized: 'Prophet: 現在，這種感覺已經沒有那麼強烈。看來，我們無疑走在了正確的路上。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840519
    m_Localized: 'Prophet: 我記得第一次來到這裡的時候，總能感到一股……說不上來的怪異感。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840518
    m_Localized: 'Prophet: 希望你可以在接下來的兩天內不對任何人進行檢查。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840517
    m_Localized: 'Prophet: 你可以將我接下來說的話當成請求、而非要求，不過……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840516
    m_Localized: 'Prophet: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840515
    m_Localized: 'Prophet: 我不能再透露其他資訊了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840514
    m_Localized: 'Prophet: 希望能在幾天後再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840513
    m_Localized: 'Prophet: 也許，能為你帶來些許平靜。起碼，能幫你繼續向前邁進。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840512
    m_Localized: 'Prophet: 我就會繼續引導你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840511
    m_Localized: 'Prophet: 聽好，是任何人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840510
    m_Localized: 'Prophet: 不過……要是你能在接下來的兩天內不對任何人進行檢查。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840509
    m_Localized: 'Prophet: 我不能再透露其他資訊了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840508
    m_Localized: 不久之後到底會發生什麼事情？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840507
    m_Localized: 既然如此……我又該拿它怎麼辦呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840506
    m_Localized: 'Prophet: 不知道廣播會不會報導出來……聽一下吧，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840505
    m_Localized: 'Prophet: 而你，無法阻止。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840504
    m_Localized: 'Prophet: 不過，我很清楚……不久之後會發生一些糟糕的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840503
    m_Localized: 'Prophet: 正是由於這一存在，我能看得更遠一些。當然——即便如此，我也沒有辦法看破一切。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840502
    m_Localized: 'Prophet: 因為，此舉能令你更加接近……某個非常強大的存在。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840501
    m_Localized: 不久之後到底會發生什麼事情？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840500
    m_Localized: 既然如此……我又該拿它怎麼辦呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840499
    m_Localized: 'Prophet: 不知道廣播會不會報導出來……聽一下吧，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840498
    m_Localized: 'Prophet: 起因並不在你，不過——卻還是會影響到你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840497
    m_Localized: 'Prophet: 我也知道不久之後會發生一些可怕的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840496
    m_Localized: 'Prophet: 雖說沒有辦法通曉一切，然而……關於你——我很清楚要是你繼續沿著這條路走下去的話，將有何後果。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840495
    m_Localized: 'Prophet: 我被賜予了一項……天賦，看得比他人要遠一點。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840494
    m_Localized: 你為什麼會要求我去收留帶著貓咪的人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840493
    m_Localized: 你怎麼會知道這隻貓咪的事情？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840492
    m_Localized: 'Prophet: 至於把它帶到這裡來的女性……要如何處置她，就悉隨尊便了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840491
    m_Localized: 'Prophet: 太好了——貓咪在你這裡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840490
    m_Localized: 'Gasmask: 我們就會離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840489
    m_Localized: 'Gasmask: 只要交出兩人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840488
    m_Localized: 'Gasmask: 你就只能一個人留在這裡等死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840487
    m_Localized: 'Gasmask: 將裡面的人給全部抓走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840486
    m_Localized: 'Gasmask: 如果我們把門破開。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840485
    m_Localized: 'Gasmask: 真是白費口舌。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840484
    m_Localized: 'Gasmask: 好了，保重。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840483
    m_Localized: 'Gasmask: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840482
    m_Localized: 'Gasmask: 我也一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840481
    m_Localized: 我再也不會讓你們帶走任何的住客了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840480
    m_Localized: 希望不會發展成這樣的結局
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840479
    m_Localized: 'Gasmask: 看來，也得給你一點顏色瞧瞧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840478
    m_Localized: 'Gasmask: 之前也曾經試過有人拒絕配合，而我們已經將他們收拾服貼了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840477
    m_Localized: 'Gasmask: 要嘛我們直接把門給破開、將裡面的人給全部抓走，要嘛你立即交出其中的兩名住客——自己選吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840476
    m_Localized: 'Gasmask: 我也懶得跟你繼續爭辯下去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840475
    m_Localized: 'Gasmask: 我已經不知道該說些什麼好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840474
    m_Localized: 'Gasmask: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840473
    m_Localized: 我再也不會讓你們帶走任何的住客了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840472
    m_Localized: 希望不會發展成這樣的結局
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840471
    m_Localized: 'Gasmask: 然後，要嘛就是我們成功找到對抗偽人的方法、要嘛……就是我們再也沒有辦法活著見面了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840470
    m_Localized: 'Gasmask: 我們不會把所有的住客給通通帶走——只要兩人就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840469
    m_Localized: 'Gasmask: 只要兩人就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840468
    m_Localized: 媽的——如果這也不行、那也不行，要你們來有什麼用？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840467
    m_Localized: 要怎樣才能阻止這場橫禍？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840466
    m_Localized: 'Gasmask: 如果找不到辦法挽救這一切，就會被他人主宰我們的命運。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840465
    m_Localized: 'Gasmask: 我們接受的是根本就不可能完成得了的任務。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840464
    m_Localized: 'Gasmask: 政府準備要把整座城市都給炸毀——他們已經無法遏止情況惡化下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840463
    m_Localized: 'Gasmask: 沒錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840462
    m_Localized: 媽的——如果這也不行、那也不行，要你們來有什麼用？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840461
    m_Localized: 要怎樣才能阻止這場橫禍？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840460
    m_Localized: 'Gasmask: 想耍花招？好啊——看我們把整棟房子裡面的人一個不落地全部帶走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840459
    m_Localized: 'Gasmask: 整個世界都正處於危難關頭，已經再也沒有時間可以浪費。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840458
    m_Localized: 'Gasmask: 不要再廢話了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840457
    m_Localized: 迎來橫禍？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840456
    m_Localized: 我、被、帶、走、的、住、客、怎、麼、還、沒、給、送、回、來？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840455
    m_Localized: 'Gasmask: 否則，將會迎來橫禍。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840454
    m_Localized: 'Gasmask: 我們還是需要再次從你這裡帶走數名住客。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840453
    m_Localized: 'Gasmask: 我們很快會把被帶走的住客給送回此處——非常感謝你的配合。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840452
    m_Localized: 'Gasmask: 快、點、把、人、交、給、我、們。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840451
    m_Localized: 'Gasmask: 我們非常在乎這座城市。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840450
    m_Localized: 'Gasmask: 要是反抗的話，將會發生更多的爆炸事件。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840449
    m_Localized: 'Gasmask: 這——就是固執己見、妨害公務的下場。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840448
    m_Localized: 'Gasmask: 看到我背後的這幅光景了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840447
    m_Localized: 'Gasmask: 好吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840446
    m_Localized: 'Gasmask: ……媽的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840445
    m_Localized: 'Gasmask: 我們一定會把偽人通通給消滅乾淨。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840444
    m_Localized: 'Gasmask: 我們一定會把被帶走的人給送回來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840443
    m_Localized: 'Gasmask: 非常感謝你的理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840442
    m_Localized: 'Gasmask: 一定能幫上忙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840441
    m_Localized: 我已經受夠了——找其他人去吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840440
    m_Localized: 好吧，要是能幫上忙的話……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840439
    m_Localized: 'Gasmask: 然後，狀況很快就會穩定下來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840438
    m_Localized: 'Gasmask: 誰都可以。快點把人交給我們——就是現在。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840437
    m_Localized: 'Gasmask: 這次，我們需要帶走兩人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840436
    m_Localized: 'Gasmask: 沒錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840435
    m_Localized: 我已經受夠了——找其他人去吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840434
    m_Localized: 好吧，要是能幫上忙的話……
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840433
    m_Localized: 'Gasmask: 如此一來，就能加快研究的進度……這已經最好的辦法了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840432
    m_Localized: 'Gasmask: 具體來說——兩人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840431
    m_Localized: 'Gasmask: 我們需要帶走數名住客。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840430
    m_Localized: 我還得讓你再帶走幾個住客嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840429
    m_Localized: 好吧。現在，該怎麼辦？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840428
    m_Localized: 'Gasmask: 事情已經在掌控之中了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840427
    m_Localized: 'Gasmask: 就讓我們專心執行自己的工作吧，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840426
    m_Localized: 'Gasmask: 要是能輕而易舉地把它們通通給消滅乾淨的話，就根本沒有成立FEMA的必要了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840425
    m_Localized: 我還得讓你再帶走幾個住客嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840424
    m_Localized: 好吧。現在，該怎麼辦？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840423
    m_Localized: 'Gasmask: 只要好好配合，興許——就能早點結束。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840422
    m_Localized: 'Gasmask: 至於何時，並不好說……我們還需要更多的人手來控制住現在的這一局面。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840421
    m_Localized: 'Gasmask: 我們還在進行研究。勸你管好自己的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840420
    m_Localized: 你們究竟什麼時候才能把偽人給趕出我們的家園？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840419
    m_Localized: 這種情況究竟要持續到什麼時候？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840418
    m_Localized: 'Gasmask: 你知道嗎？我的家……就在那裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840417
    m_Localized: 'Gasmask: 睜大你的眼睛看看這一切都帶來了怎樣的後果——我們不得不夷平遭到偽人盤踞其中的整個熱區。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840416
    m_Localized: 'Gasmask: 每個人都想要妨礙我們。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840415
    m_Localized: 'Gasmask: 輪不到你提要求。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840414
    m_Localized: 你們究竟什麼時候才能把偽人給趕出我們的家園？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840413
    m_Localized: 這種情況究竟要持續到什麼時候？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840412
    m_Localized: 'Gasmask: 只會因此引起更多的暴力事件。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840411
    m_Localized: 'Gasmask: 窩藏偽人沒有任何好處——只會令他們不斷地增殖。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840410
    m_Localized: 'Gasmask: 要是拒絕的話，將會發生更多的爆炸事件。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840409
    m_Localized: 'Gasmask: 惡果。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840408
    m_Localized: 先把之前被你們帶走的住客給送回來再說！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840407
    m_Localized: 城裡到底出什麼事了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840406
    m_Localized: 'Gasmask: 越快越好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840405
    m_Localized: 'Gasmask: 我們需要再次從你這裡帶走數名住客。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840404
    m_Localized: 'Gasmask: 你好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840403
    m_Localized: 'Gasmask: 無論如何，我們都會進行檢查——早點配合、早點完事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840402
    m_Localized: 'Gasmask: 你沒得選。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840401
    m_Localized: 'Gasmask: 你誤會了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840400
    m_Localized: 'Gasmask: 檢查完畢之後，我們將告訴你接下來該怎麼做。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840399
    m_Localized: 'Gasmask: 放心。雖說程序相對比較繁瑣，然而也會留出休息時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840398
    m_Localized: 我對你們所謂的檢查不感興趣
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840397
    m_Localized: 要是除此以外別無他法的話——好吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840396
    m_Localized: 'Gasmask: 為了更加深入地研究太陽造成的影響，我們需要再次從你這裡帶走數名住客。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840395
    m_Localized: 'Gasmask: 目前尚無任何定論。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840394
    m_Localized: 我對你們所謂的檢查不感興趣
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840393
    m_Localized: 要是除此以外別無他法的話——好吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840392
    m_Localized: 'Gasmask: 之後，我們就會將他們從隔離區送回此處。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840391
    m_Localized: 'Gasmask: 被帶走的人在經過篩選之後都必須進行強制隔離。因此，你的住客需要暫時與我們待在一起、由我們進行看護。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840390
    m_Localized: 'Gasmask: 嗯……原來如此——看來，我們的工作人員之前已經拜訪過你這裡了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840389
    m_Localized: 'Gasmask: 「給送回來」？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840388
    m_Localized: 之前的檢查，結果怎樣了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840387
    m_Localized: 你們究竟要到什麼時候才會把上次被帶走的住客給送回來？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840386
    m_Localized: 'Gasmask: 放心，不會花費你太長的時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840385
    m_Localized: 'Gasmask: 我們隸屬於FEMA，正在對住在這裡的市民進行常規檢查。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840384
    m_Localized: 'Gasmask: 晚安。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646208
    m_Localized: 'Luka: 一定要照顧好自己，知道了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646207
    m_Localized: 'Luka: 然後……目之所及的一切事物都將無比迅速地變得異常黑暗。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646206
    m_Localized: 'Luka: 如果過分地糾結其中，它就會將你蠶食殆盡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646205
    m_Localized: 'Luka: 千萬不要把自己困於悲傷之內。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646204
    m_Localized: 'Luka: 也許，到時……盤踞在腦海之中的念頭，就不會只有死亡一種了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646203
    m_Localized: 'Luka: 希望你可以回憶起快樂是一種怎樣的情緒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646202
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646201
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646200
    m_Localized: 'Luka: 能理解嗎？最近，生活變得越來越苦了——實在是過於苦了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646199
    m_Localized: 'Luka: 令他們想起往昔的日子——當時，我們目標並非生存下去、而是要創造出……美好的事物。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646198
    m_Localized: 'Luka: 然而，如果可以三不五時地提醒一下他們過去是如此的開心……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646197
    m_Localized: 'Luka: 怎麼能說是撒謊呢？大家都出於各種原因深陷在痛苦之中，我能理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646196
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646195
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646194
    m_Localized: 'Luka: 越是這種時候，越不能讓絕望將我們給整個吞沒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646193
    m_Localized: 'Luka: 試著回憶起它曾為你帶來的快樂吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646192
    m_Localized: 'Luka: 災變開始之前，你最喜歡的東西是什麼呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646191
    m_Localized: 'Luka: 可多了。不過……我不會告訴你、你應該去為什麼感到開心。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646190
    m_Localized: 換句話說，你要對大家撒謊？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646189
    m_Localized: 現在，到底還有什麼是值得我們去感到開心的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646188
    m_Localized: 'Luka: 絕望令我們忽視了尚存於世的美好事物。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646187
    m_Localized: 'Luka: 恐懼讓大家忘記了快樂究竟是一種怎樣的情緒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646186
    m_Localized: 'Luka: 的確……我也已經很久沒見到過有人能笑出來了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646185
    m_Localized: 'Luka: 我知道了——你是想問我為什麼這種時候還能笑出來，對嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039743
    m_Localized: 'Nervous: 我住在希望飯店，不過——我決定出來走走。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039742
    m_Localized: 'Nervous: 抱歉，我稍微有點……緊張。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039741
    m_Localized: 'Nervous: 你好。嘻嘻。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039740
    m_Localized: 'Bald: 好好保重。希望你能撐過這團亂局。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039739
    m_Localized: 'Bald: 好吧，朋友。我能理解。千萬不要因此而感到有負擔。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039738
    m_Localized: 'Bald: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039737
    m_Localized: 'Bald: 之後記得來找我，好嗎？我有一些特別誇張的故事可以跟你分享，保證能把你給嚇得六神無主。哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039736
    m_Localized: 'Bald: 該死，朋友——你救了我一命。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039735
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039734
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039733
    m_Localized: 'Bald: 總之，我不會把你捲進任何的麻煩。我會把一切都告訴你——就……讓我進去吧，朋友。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039732
    m_Localized: 'Bald: 她為了保護我，從來都沒有跟我說過任何事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039731
    m_Localized: 'Bald: 而是我媽。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039730
    m_Localized: 'Bald: 不、不，他們要找的不是我。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039729
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039728
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039727
    m_Localized: 'Bald: 況且——太陽變成這樣後，一切都天翻地覆。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039726
    m_Localized: 'Bald: 然而，現在……我，怎麼說呢……完全聯絡不上他們。大家都有一堆爛事要處理。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039725
    m_Localized: 'Bald: 一群特有義氣的傢伙。不管是幫忙、還是玩樂，甚至是單純地上街閒逛——無論何時，隨叫隨到。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039724
    m_Localized: 'Bald: 都是戲劇行業的人。我們以前一起喝酒、一起瞎混，也會互相支持。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039723
    m_Localized: 也就是說，現在有一群氣炸了的人在找你麻煩？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039722
    m_Localized: 你的這群朋友，都是些什麼人？
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039721
    m_Localized: 'Bald: 我之前是跟我媽還有阿嬤住在一起，但是——不久之前，被債主給趕出了家門。一切都糟糕透頂……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039720
    m_Localized: 'Bald: 我本以為自己有一大堆朋友，想說……我們會一起熬過這段艱苦的日子。結果……現在，就只剩下我一個了。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039719
    m_Localized: 'Bald: 能讓我在這裡待上幾天嗎？其他人要嘛不在家裡、要嘛被趕了出去，不然……就是不知道出什麼事情了。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039718
    m_Localized: 'Bald: 你好，朋友！'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039717
    m_Localized: 'Tough: ……混蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039716
    m_Localized: 'Tough: 真是一個……'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039715
    m_Localized: 'Tough: 好吧——本來也沒指望會有別的結果。'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039714
    m_Localized: 'Tough: 並不是嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039713
    m_Localized: 'Tough: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303878
    m_Localized: 這裡還有其他的人
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303877
    m_Localized: 這裡就只有我一人
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303876
    m_Localized: 'SuperFake: 告訴我吧，這裡就只有你一人嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303875
    m_Localized: 'SuperFake: 好吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303874
    m_Localized: 'SuperFake: 到底還有什麼值得你去留戀的呢？你早就已經孤身一人、舉目無親。'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303873
    m_Localized: 'SuperFake: 為何如此緊張——為何要像這樣頑固地抓住生命，誓不鬆手？'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303872
    m_Localized: 'SuperFake: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371408
    m_Localized: 'Vigilante: 盡情享受剩下的一切吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371407
    m_Localized: 'Vigilante: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371406
    m_Localized: 'Vigilante: 你不會再看到我了——我已經處理好這邊的事情了。'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371405
    m_Localized: 'Vigilante: 我搞定了。'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371404
    m_Localized: 'Vigilante: 去你媽的——想要矇混過關，是吧？根本就沒有與耳朵相關的特徵！'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371403
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371402
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371401
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371400
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371399
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371398
    m_Localized: 'Vigilante: 去你媽的——想要矇混過關，是吧？根本就沒有與耳朵相關的特徵！'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371397
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371396
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371395
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371392
    m_Localized: 'Vigilante: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177095
    m_Localized: 'CultistPriest: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177094
    m_Localized: 'CultistPriest: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177093
    m_Localized: 'CultistPriest: 好吧，我們不會強迫你改變自己的選擇。死亡會索回它應得的一切——只不過是時間的問題罷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177092
    m_Localized: 我早就已經想要獲得安寧了……我會跟你一起走的
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177091
    m_Localized: 要是你已經活膩了的話，請自便——不要帶我一起去
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177090
    m_Localized: 'CultistPriest: 來參加我們的儀式吧，為自己尋得安寧——如何？一同踏上這趟嚮往死亡的神聖征程。'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177089
    m_Localized: 'CultistPriest: 作為回報，我可以賜予你救贖……'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633033
    m_Localized: 'BigLebowski: 讚哦！'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633032
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633031
    m_Localized: 我會把對方給踢出去的——進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633030
    m_Localized: 'BigLebowski: 哎呀，一不小心押韻了。'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633029
    m_Localized: 'BigLebowski: 如果要住下來，自然得按照我的規矩來。'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633028
    m_Localized: 'BigLebowski: 呃……還是算了。涼爽的地方早就被{0}佔了。'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633027
    m_Localized: 'BigLebowski: 給我去死……'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633026
    m_Localized: 'BigLebowski: 你跟我爸爸一樣，都是爛人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200674
    m_Localized: 'FatalDame: 好吧……他可不這麼認為。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200673
    m_Localized: 'FatalDame: 難道，你覺得末日降臨之後反而還比較輕鬆？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200672
    m_Localized: 'FatalDame: 我早就料到了你會這樣回答。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200671
    m_Localized: 'FatalDame: 也許，我們可以將自己的注意力轉移開來、專注於某種……更好的事物，不再執著於無窮無盡的偏執和自憐。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200670
    m_Localized: 'FatalDame: 來一起逃避這些恐怖吧——就你，和我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200669
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200668
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200667
    m_Localized: 'FatalDame: 也許，我們可以試著建立某種……只屬於彼此的特殊聯繫？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200666
    m_Localized: 'FatalDame: 我可以幫你解決這一問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200665
    m_Localized: 'FatalDame: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200664
    m_Localized: 'FatalDame: 畢竟，跟他人建立良好的關係本來就不是什麼簡單的事情。受此所困的並不止你一個。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200663
    m_Localized: 'FatalDame: 我能理解。真正願意傾聽、而非總是插嘴說自己的遭遇要更加糟糕的人根本就沒幾個。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200662
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200661
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200660
    m_Localized: 'FatalDame: 現在這個世道，人人都需要一些慰藉、一點關懷……一絲溫存。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200659
    m_Localized: 'FatalDame: 如果你能讓我進去，你我就能共同分擔這份痛苦——一起癒合。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200656
    m_Localized: 'FatalDame: 想要放下憤怒，並不簡單。想要寬恕他人，更是難上加難。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200655
    m_Localized: 'FatalDame: 童年受到了來自父親的欺壓？太糟糕了。還好一切都已經過去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200654
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200653
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200652
    m_Localized: 'FatalDame: 只要讓我進去，你……就能體驗到全然不同的感受。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200651
    m_Localized: 'FatalDame: 然而，即使是最為孤絕的靈魂……也需要一些——特殊的關懷。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200650
    m_Localized: 'FatalDame: 如今，人人都執著於世界是否將會邁向末日一事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200649
    m_Localized: 'FatalDame: 不如，這樣好了——我可以給你一些……其他人給不了的東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200648
    m_Localized: 'FatalDame: 嗯……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200576
    m_Localized: 你想找出她的下落？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200575
    m_Localized: 你還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200574
    m_Localized: 'Vigilante: 如果我的兄弟沒有像個窩囊廢一樣，興許還能保護好自己的妻子、女兒。現在？天知道這個小兔崽子到底跑哪裡去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200573
    m_Localized: 'Vigilante: 我回來了。真不知道自己究竟在瞎忙活些什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200572
    m_Localized: 'Vigilante: 我沒有時間可以繼續浪費在你這裡了，手邊還有更加重要的事情需要去處理。我還會再來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200571
    m_Localized: 'Vigilante: 敢再拿耳朵糊弄我，就直接把你給嘣了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200570
    m_Localized: 'Vigilante: 要不是因為我的兄弟……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200569
    m_Localized: 'Vigilante: 耳朵？你他媽把我當白癡嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200568
    m_Localized: 'Vigilante: 其實，我根本就不在乎你的照片長什麼樣子。我還有更加重要的事情需要去處理。你撿回一條小命了。我還會回來，到時再好好地把你給裡裡外外地檢查一遍。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200567
    m_Localized: 'Vigilante: 哼……的確，看著沒有問題。不過，我已經親手埋葬了一堆「看著沒有問題」的傢伙了——不會這麼簡單就相信你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200566
    m_Localized: 'Vigilante: 照片？靈光？好吧，就來看看你有沒有什麼「問題」好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200565
    m_Localized: 'Vigilante: 沒有能對上的特徵。哼，算你走運。好了，趕緊把你的腋窩給拿開。我還有更加重要的事情需要去處理。我還會回來的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200564
    m_Localized: 'Vigilante: 看著沒有問題。然而，屁用沒有。這些怪胎能偽裝到就連我也看不出來的程度。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200563
    m_Localized: 'Vigilante: 哼……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200562
    m_Localized: 'Vigilante: 至於現在，我還有更加重要的事情需要去處理。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200561
    m_Localized: 'Vigilante: 好把，你逃過一劫了。不過……如果下次再發現有什麼不對勁的地方，我就不再廢話、直接開槍了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200560
    m_Localized: 'Vigilante: 萬一這些「沒有問題」的傢伙出了問題，只要一個晚上就能把所有人都殺光——絕對不能有任何的麻痺大意。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200559
    m_Localized: 'Vigilante: 哼……沒有任何跡象，嗯？太好了，真是他媽的太好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200558
    m_Localized: 'Vigilante: 再睜大一點。拜託，把手也用上。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200557
    m_Localized: 'Vigilante: 沒空慢慢檢查你的雙手了，下次我再細看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200556
    m_Localized: 'Vigilante: 給我聽好——看著沒有問題的傢伙，通常會最先變成偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200555
    m_Localized: 'Vigilante: 沒有問題……媽的，當然沒有問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200554
    m_Localized: 'Vigilante: 該死，我沒有時間可以繼續浪費在你這裡了——還得去追查一些事情來著。之後再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200553
    m_Localized: 'Vigilante: 好吧，就繼續苟延殘喘下去好了。不過……如果下次再發現有什麼不對勁的地方，我就不會再跟你廢話了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200552
    m_Localized: 'Vigilante: 哼……沒有問題。真是可惜。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200551
    m_Localized: 'Vigilante: 再張大一點。快點，別尿褲子了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200550
    m_Localized: （給對方看自己的耳朵）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200549
    m_Localized: （給對方看自己的照片）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200548
    m_Localized: （給對方看自己的腋窩）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200547
    m_Localized: （給對方看自己的眼睛）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200546
    m_Localized: （給對方看自己的雙手）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200545
    m_Localized: （給對方看自己的牙齒）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200544
    m_Localized: 'Vigilante: 你有一把槍又怎樣？老子根本就不在乎。大不了廝殺一場、同歸於盡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200543
    m_Localized: 'Vigilante: 快點，給我看看你是否具備偽人的特徵——什麼都行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200542
    m_Localized: 'Vigilante: 嗯……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200541
    m_Localized: 'Vigilante: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200540
    m_Localized: 你找的人已經死了，只有女兒活了下來
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200539
    m_Localized: 他的房子被燒毀了——之後，就再也沒有見過這個人了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006381
    m_Localized: 'Miner: 要是你真有這個打算的話，我再跟你說說具體是怎麼一回事好了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006380
    m_Localized: 'Miner: 我們已經試過了，差點就因此引發坍方、把大家給活埋了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006379
    m_Localized: 'Miner: 聽著……如果你計劃下到這裡生活，最好不要去靠近這個洞穴。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006378
    m_Localized: 'Miner: 我的一個朋友說自己好像聽見裡面傳來了什麼聲音——心想也許值得探查一番。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006377
    m_Localized: 'Miner: 只是一個洞穴而已。不過……它的附近經常會發生一些非常奇怪的事情就對了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006376
    m_Localized: 'Miner: 沒有、沒有，也不是什麼特別有趣的事情——真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006375
    m_Localized: 'Miner: 蛤？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006374
    m_Localized: 'Miner: 我們已經試過了，差點就因此引發坍方、把大家給活埋了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006373
    m_Localized: 'Miner: 聽著……如果你計劃下到這裡生活，最好不要去靠近這個洞穴。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006372
    m_Localized: 'Miner: 我的一個朋友決定下去一探究竟，我則留在這裡——為了在需要的時候給他搭一把手。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006371
    m_Localized: 'Miner: 動物靠近之後會立即噤聲、羅盤靠近之後會瘋狂亂轉……即便用上手電筒，也無法照亮內部。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006370
    m_Localized: 'Miner: 附近總是會有一些動靜，一直傳來某股極輕的嗡鳴、持續不斷。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006369
    m_Localized: 'Miner: 一個洞穴。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006368
    m_Localized: 難道，你抓到偽人了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006367
    m_Localized: 怎麼，找到什麼有趣的東西了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006366
    m_Localized: 'Miner: 先不說這個了。其實，比起隧道、我們還發現了某個更加詭異的東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006365
    m_Localized: 'Miner: 只是直到現在也沒有見到過一個，因此也無法斷言就對了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006364
    m_Localized: 'Miner: 我們覺得偽人應該就是透過這些隧道神出鬼沒地四處活動的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006363
    m_Localized: 'Miner: 雖然並不知道究竟是什麼傢伙、又是出於什麼原因挖出來的，不過——倒是有一些猜測。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006362
    m_Localized: 'Miner: 你猜怎麼樣？我們剛一開始往下面挖，就發現了整個隧道系統！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006361
    m_Localized: 'Miner: 還用說嗎？當然是在找地方躲避現在這熱得要命的鬼天氣了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006360
    m_Localized: 難道，你抓到偽人了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006359
    m_Localized: 怎麼，找到什麼有趣的東西了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006358
    m_Localized: 'Miner: 不過，也不重要了。因為，我們還發現了其他的東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006357
    m_Localized: 'Miner: 這些隧道深得很，兄弟——根本就看不到底。完全搞不懂會通往何處。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006356
    m_Localized: 'Miner: 之前不止這些，最近塌了幾條。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006355
    m_Localized: 'Miner: 剛一開始——瞧瞧，就發現了整個地下網路！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006354
    m_Localized: 'Miner: 我和幾個朋友商量了一下，想說不如挖出幾條隧道、躲避現在這酷熱的天氣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006353
    m_Localized: 你是在找什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006352
    m_Localized: 你為什麼會在下面？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006351
    m_Localized: 'Miner: 我的耳朵被塵土給堵了個嚴嚴實實——聽你說話感覺就像是隔了一層枕頭，真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006350
    m_Localized: 'Miner: 被困？沒有、沒有——我們發現了某樣東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006349
    m_Localized: 'Miner: 蛤？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006348
    m_Localized: 你是在找什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006347
    m_Localized: 你為什麼會在下面？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006346
    m_Localized: 'Miner: 好吧，希望不會突然塌下來、砸到我們的腦袋上面。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006345
    m_Localized: 'Miner: 欸……我們在你的房子底下？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006344
    m_Localized: 'Miner: 我現在裹滿了塵土、煙灰，完全聽不見你在說什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006343
    m_Localized: 'Miner: 蛤？大聲一點！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006342
    m_Localized: 你被困在底下了嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006341
    m_Localized: 你在我的房子底下幹什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006340
    m_Localized: 'Miner: ……看來，並不是什麼幻覺。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006339
    m_Localized: 'Miner: 嗯？等等——誰來了嗎？我好像聽見了一些聲響。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006308
    m_Localized: 我還沒有準備好
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006307
    m_Localized: 我隨時都能出發
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006306
    m_Localized: 'MushroomEater: 準備好與我一起前往蘑菇之地了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006305
    m_Localized: 'MushroomEater: 不管要付出何種代價，都得阻止節慶的發生！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006304
    m_Localized: 'MushroomEater: 雖然，說實話……如果能繼續保持「無人問津」的狀態，是最好的——不過，我們已經沒有其他的選擇。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006303
    m_Localized: 'MushroomEater: 大錯特錯，親愛的孩子！這是一個毛骨悚然的地方，至今尚未有人能踏足其中。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006302
    m_Localized: 聽起來……好像也沒有很嚇人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006301
    m_Localized: 蘑菇之地？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006300
    m_Localized: 'MushroomEater: 雖然我也不想出此下策，不過……看來，我們得去一趟蘑菇之地了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006299
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006298
    m_Localized: 'MushroomEater: 也就是說，菌絲體已經深陷困境！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006297
    m_Localized: 'MushroomEater: 節慶沒有絲毫要停下來的趨勢，意味著蘑菇已經開始爆殖、失控。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006296
    m_Localized: 聽起來……好像也沒有很嚇人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006295
    m_Localized: 蘑菇之地？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006294
    m_Localized: 'MushroomEater: 雖然我也不想出此下策，不過……看來，我們得去一趟蘑菇之地了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006293
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006292
    m_Localized: 'MushroomEater: 然而最近……脈絡積累的惡意已經遠遠超出它們所能承受的範圍，致使其失去控制、野蠻蔓生。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006291
    m_Localized: 'MushroomEater: 通常來說，蘑菇會試著排出這些毒素——就跟我們人體的肝臟一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006290
    m_Localized: 'MushroomEater: 一旦脈絡積累過量的惡意，一切的運轉就會受到阻礙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006289
    m_Localized: 'MushroomEater: 菌絲體的內部出了非常嚴重的問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006288
    m_Localized: 為何節慶還會發生？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006287
    m_Localized: 為何沒有起到作用？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006286
    m_Localized: 'MushroomEater: 菌絲體全都亂成了一團——之前舉行的儀式……並沒有起到作用……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006285
    m_Localized: 'MushroomEater: 看來，節慶還是會如期而至……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006284
    m_Localized: 'MushroomEater: 親愛的孩子……我們還會再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006283
    m_Localized: 'MushroomEater: 記住——眼見不一定為實。對於蘑菇，更是如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006282
    m_Localized: 'MushroomEater: 我們得確保蘑菇不再長大、節慶不會開始。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006281
    m_Localized: 'MushroomEater: 時機成熟之後，我會再到這來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006280
    m_Localized: 'MushroomEater: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646184
    m_Localized: 'Luka: 怎麼了嗎？沒問題吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646183
    m_Localized: 換句話說，你要對大家撒謊？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646182
    m_Localized: 現在，到底還有什麼是值得我們去感到開心的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646181
    m_Localized: 'Luka: 如果我們能鍥而不捨地對自己說——「一切都會好起來的」，說不定一切就真的會一點、一滴地好起來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646180
    m_Localized: 'Luka: 譬如，我們的下一代、美術，又或者是……生命的樂趣本身。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646179
    m_Localized: 'Luka: 沒錯，現在的日子的確是過得非常地艱難——不過，還是有一些東西值得我們為之奮鬥。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646178
    m_Localized: 'Luka: 外頭四處瀰漫的憤怒已經足夠多了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646177
    m_Localized: 你的臉是怎麼回事？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646176
    m_Localized: 你為什麼這麼地有精神？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646175
    m_Localized: 'Luka: 能讓我待在這裡過夜嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646174
    m_Localized: 'Luka: 我聽到了一些動靜——你已經來到門後啦，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646173
    m_Localized: 'BigLebowski: 去你媽的吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646172
    m_Localized: 'BigLebowski: 看來，你也是一個噁心至極的混蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646171
    m_Localized: 'BigLebowski: 哼……無所謂。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646170
    m_Localized: 'BigLebowski: 只是……唉，沒事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646169
    m_Localized: 'BigLebowski: 哎呀，你這裡甚至還鋪了地毯。酷哦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646168
    m_Localized: 'BigLebowski: 哇哦……太好了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646167
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646166
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633025
    m_Localized: 'BigLebowski: 你真的忍心把一個孩子丟在這裡自生自滅——頂著能把人給活活燒死的太陽、能把人給開腸破肚的偽人？'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633024
    m_Localized: 'BigLebowski: 不管怎樣……我都已經來到這裡了。我真的需要一個安全的地方待著。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646165
    m_Localized: 'BigLebowski: 我的媽媽特別、特別地喜愛日光浴。因此……是的，也很有可能已經被曬成焦炭了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646164
    m_Localized: 'BigLebowski: 或許，都已經變成偽人了也說不定。哼……要真落得了這個下場的話，也挺適合他們的就是了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646163
    m_Localized: 'BigLebowski: 天知道他們在哪裡。家吧，大概。不然，還能在什麼地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646162
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646161
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646160
    m_Localized: 'BigLebowski: 如果你也是這樣的變態……事先聲明——要是敢對我動手動腳的話，就別怪我一拳把你揍得眼冒金星！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646159
    m_Localized: 'BigLebowski: 雖說，偶爾會遇到一些混蛋就對了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646158
    m_Localized: 'BigLebowski: 只是，我身無分文。因此……要嘛就是跟人談好條件、住進房子，要嘛就是偷偷溜進沒人佔用的地下室裡面，過上一晚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646157
    m_Localized: 'BigLebowski: 我在……四處旅行，應該可以這麼說吧。想要親眼看看這個世界，想要抵達不同的地方。或許，還能找到一個新的家也說不定。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646156
    m_Localized: 你的父母呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646155
    m_Localized: 你為什麼要躲在地下室裡面？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646152
    m_Localized: 'BigLebowski: 附近沒有什麼諸如地下室之類的，比較合適的藏身之處。於是，我就來敲你這裡的門了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646151
    m_Localized: 'BigLebowski: 雖然有點唐突，不過……能不能讓我在這裡借住？還是說，你要把我一直晾在這裡？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646150
    m_Localized: 你的父母呢？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646149
    m_Localized: 你為什麼要躲在地下室裡面？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646146
    m_Localized: 'BigLebowski: 我已經不想躲在地下室裡面了——再這樣下去的話，我怕是會忘掉該怎麼去跟人說話。不過，你應該不會關心這個吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646145
    m_Localized: 'BigLebowski: 沒有。我只是……在找地方落腳。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646144
    m_Localized: 沒錯
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646143
    m_Localized: 你是在找人嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646142
    m_Localized: 'BigLebowski: 請問，這位先生……這棟房子是你的地盤，呃……不對，我是說——你的家嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646141
    m_Localized: 'BigLebowski: 喲……呃，我是說……你好——要是這樣聽起來要更好一些的話。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646140
    m_Localized: 'Couple: 好啦，走吧——我也已經很累了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646139
    m_Localized: 'Couple: 看來，我們只好繼續尋找了。對吧，寶貝？'
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582080
    m_Localized: （收取訂單）
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582081
    m_Localized: （收取訂單）
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776384
    m_Localized: （收取訂單）
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776385
    m_Localized: （收取訂單）
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646136
    m_Localized: 'Couple: 不要再傻傻地站在這裡啦，好嗎？快點動起來吧——人家已經邀請我們進去啦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646135
    m_Localized: 'Couple: 哎呀，謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646138
    m_Localized: 'Couple: 好吧。抱歉，打擾你了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646137
    m_Localized: 'Couple: 真是怕生……沒關係的，寶貝——你很快就能好好休息一下、恢復正常了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646134
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646133
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646132
    m_Localized: 'Couple: 哎呀，不好意思……我並非有意窺探你的隱私。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646131
    m_Localized: 'Couple: 要不是有妻子在一起陪著，我根本就不可能堅持下來。你呢——你又是怎樣扛過來的？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646130
    m_Localized: 'Couple: 全都堆在了一起……實在是令人煎熬。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646129
    m_Localized: 'Couple: 你應該也可以理解吧？四處潛伏的偽人、難以忍受的高溫，以及遭到解僱的無奈……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646128
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646127
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646126
    m_Localized: 'Couple: 哎呀，還請見諒……我不該像這樣咄咄逼人的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646125
    m_Localized: 'Couple: 對吧，寶貝？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646124
    m_Localized: 'Couple: 不過，也許改天她就有聊天的力氣了。當然，前提是我們之後又見面了的話。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646123
    m_Localized: 'Couple: 不好意思——她真的太累了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646122
    m_Localized: 'Couple: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646121
    m_Localized: 'Couple: 當然可以！說句話吧，寶貝？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646120
    m_Localized: 你到底是對什麼感到厭倦？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646119
    m_Localized: 你的妻子不能自己說話嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646118
    m_Localized: 'Couple: 當然，前提是不會打擾你的話。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646117
    m_Localized: 'Couple: 我的妻子已經筋疲力盡了。現在，她只想好好休息一下。我們真的不能在這裡待一陣子嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646116
    m_Localized: 'Couple: 要是這樣的話……我想，也只能離開這裡、去找其他地方了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646115
    m_Localized: 你到底是對什麼感到厭倦？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646114
    m_Localized: 你的妻子不能自己說話嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646113
    m_Localized: 'Couple: 不僅非常寬敞、位置偏僻，而且也沒有愛管閒事的鄰居……應該不怎麼會遇到一些怪胎。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646112
    m_Localized: 'Couple: 我也不知道具體該怎麼去解釋就對了，哈哈。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646111
    m_Localized: 'Couple: 說實話，這裡看起來比我見到過的任何一棟房子都要更加安全。對吧，寶貝？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646110
    m_Localized: 萬一……你們自己就是麻煩，該怎麼辦？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646109
    m_Localized: 你認為我的房子是一個安全的地方？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646108
    m_Localized: 'Couple: 不知，能否讓我們在這裡待一段時間呢？當然，前提是不會給你造成任何的麻煩。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646107
    m_Localized: 'Couple: 哎呀，你好！我和妻子正在尋找一個安全的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646106
    m_Localized: 'Couple: ……對，就是這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646105
    m_Localized: 'Ballerina: 就把它當成——我送你的禮物吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646104
    m_Localized: 'Ballerina: 你會在房子的下面找到這隻貓咪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646103
    m_Localized: 'Ballerina: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646102
    m_Localized: 'Ballerina: 來吧，貓咪——你肯定能讓我忙上一陣子，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646101
    m_Localized: 'Ballerina: 不要拘謹。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646100
    m_Localized: 見鬼去好了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646099
    m_Localized: ……進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646098
    m_Localized: 'Ballerina: 再好好想想吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646097
    m_Localized: 'Ballerina: 你有看到這隻貓咪吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646096
    m_Localized: 'Ballerina: 對了——千萬不要虐待這隻貓咪。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646095
    m_Localized: 'Ballerina: 我都已經快要被凍成冰棒了，年輕人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646094
    m_Localized: 'Ballerina: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646093
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646092
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646091
    m_Localized: 'Ballerina: 到底要不要開門讓我進去？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646090
    m_Localized: 'Ballerina: 我通過檢查了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646089
    m_Localized: 'Ballerina: 難道，這樣都還不夠嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646088
    m_Localized: 'Ballerina: 我有兩條手臂、兩條腿，以及一個腦袋。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646087
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646086
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646085
    m_Localized: 'Ballerina: 怎樣，你決定好了嗎？現在，到底要怎麼做？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646084
    m_Localized: 'Ballerina: 畢竟，我是一名芭蕾舞伶。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646083
    m_Localized: 'Ballerina: 說不定真的會哦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646082
    m_Localized: 'Ballerina: 想要看我跳舞嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646081
    m_Localized: 'Ballerina: 這又怎麼了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646080
    m_Localized: 證實自己是個人類
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451995
    m_Localized: 我認為你並非人類
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451994
    m_Localized: 'Ballerina: 聽起來還真詭異。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451993
    m_Localized: 'Ballerina: 現在到底是怎樣？你記起他了——然後呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451992
    m_Localized: 'Ballerina: 好吧……怎樣都行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451991
    m_Localized: 證實自己是個人類
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451990
    m_Localized: 我認為你並非人類
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451989
    m_Localized: 'Ballerina: 嘿嘿。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451988
    m_Localized: 'Ballerina: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451987
    m_Localized: 'Ballerina: 不知道，重要嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451986
    m_Localized: 你令我想到了……某人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451985
    m_Localized: 某人派你來的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451984
    m_Localized: 'Ballerina: 這裡沒有那麼的熱。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451983
    m_Localized: 'Ballerina: 望見了你的房子，於是便走了過來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451982
    m_Localized: 'Ballerina: 看到那邊的城市了嗎？我之前就是住在那裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451981
    m_Localized: 你令我想到了……某人。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451980
    m_Localized: 某人派你來的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451979
    m_Localized: 'Ballerina: 之前曾是一名芭蕾舞伶——看得出來嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451978
    m_Localized: 'Ballerina: 我會跳舞。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451977
    m_Localized: 你是怎麼找到我的房子的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451976
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451975
    m_Localized: 'Ballerina: 某人要我來這裡，於是我就來這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451974
    m_Localized: 'Ballerina: 到底要不要開門讓我進去？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451973
    m_Localized: 'Ballerina: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451972
    m_Localized: 'Ballerina: 一箱啤酒、一件衣服、一根火腿——誰知道呢，什麼都行。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451971
    m_Localized: 你是怎麼找到我的房子的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451970
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451969
    m_Localized: 'Ballerina: 這又怎麼了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451968
    m_Localized: 'Ballerina: 還真是喜歡提問——沒錯，我認識他。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451967
    m_Localized: 'Ballerina: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451966
    m_Localized: 你想從我這裡得到什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451965
    m_Localized: 不知，你是否認識……一個禿頭的傢伙？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451964
    m_Localized: 'Ballerina: 開門讓我進去？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451963
    m_Localized: 'Ballerina: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451962
    m_Localized: 'Ballerina: 嗨。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451961
    m_Localized: 'Teacher: 如果遇到了流離失所的孩子……還請一定要收留、照顧好他們，好嗎？再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451960
    m_Localized: 'Teacher: 我不會責怪你做出這樣的決定。不過……希望你可以答應一件事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451959
    m_Localized: 'Teacher: 我很清楚——無論如何，他們也已經沒有辦法再次回到我的身邊了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451958
    m_Localized: 'Teacher: 謝謝你願意聽我傾訴……謝謝你願意讓我進去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451957
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451956
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451955
    m_Localized: 'Teacher: 這群傢伙不光把整座設施都燒成了平地，而且……甚至逼迫我眼睜睜地看著這一切的發生。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451954
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451953
    m_Localized: 'Teacher: 他們究竟做錯了什麼事情，為何竟會落得這樣的結局？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451952
    m_Localized: 'Teacher: 我們到底變成了什麼東西，甚至不惜對孩子降下私刑？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451951
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451950
    m_Localized: 'Teacher: 他們發現我一直在給具備偽人特徵的孩子提供庇護。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451949
    m_Localized: 'Teacher: 因為……因為一群惡毒的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451948
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451947
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451946
    m_Localized: 'Teacher: 直到現在，孩子們既驚恐、又無助的眼神依舊清晰地烙在我的心底……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451945
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451944
    m_Localized: 'Teacher: 不僅如此，他們甚至還逼迫我眼睜睜地看著他們鎖上大門、封死窗戶……然後點燃整座設施。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451943
    m_Localized: 'Teacher: 一群害怕孩子們有可能會是偽人的傢伙，痛下毒手……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451942
    m_Localized: 'Teacher: 他們全都……死在了烈焰之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451941
    m_Localized: 'Teacher: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451940
    m_Localized: 'Teacher: 他們……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451939
    m_Localized: 發生什麼事了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451938
    m_Localized: 孩子們怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451937
    m_Localized: 'Teacher: 然而，現在……他們都已經不在了——大火吞噬了所有人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451936
    m_Localized: 'Teacher: 還有看到孩子開始出現一點偽人的特徵之後立即不假思索地將他們掃地出門的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451935
    m_Localized: 'Teacher: 其中有被FEMA抓走的、有遭遇到了不測的，甚至……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451934
    m_Localized: 'Teacher: 出於各種原因，他們都失去了自己的父母。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451933
    m_Localized: 'Teacher: 當整個世界開始一點一滴地分崩離析時，我收留了因此變得孑然一身的孩子們。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451932
    m_Localized: 'Teacher: 我曾經是……幼稚園裡的一名教師。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451931
    m_Localized: 發生什麼事了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451930
    m_Localized: 孩子們怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451929
    m_Localized: 'Teacher: 然而……我還是失敗了——我終究沒能拯救他們。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451928
    m_Localized: 'Teacher: 我已盡己所能地給予他們需要的關懷、給予他們渴望的疼愛……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451927
    m_Localized: 'Teacher: 我們一起待在已經不再營運的幼稚園裡面，共同生活。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451926
    m_Localized: 'Teacher: 我盡量收留了每個被人們稱為「汙穢」、害怕可能會是偽人的孩子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451925
    m_Localized: 'Teacher: 我……我只是想要給予遭到拋棄的孩子們一點希望而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451924
    m_Localized: 你是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451923
    m_Localized: 怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451922
    m_Localized: 'Teacher: 我感到非常難受。我能……跟你聊聊嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451921
    m_Localized: 'Teacher: 不好意思，打擾你了。請問……你有空嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451920
    m_Localized: 'Dude: 照顧好自己……還有家人吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451919
    m_Localized: 'Dude: 沒關係，老兄——我理解。千萬不要因此而感到有負擔。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451918
    m_Localized: 'Dude: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451917
    m_Localized: 'Dude: 拜託……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451916
    m_Localized: 'Dude: 總有一天——說什麼也要把這一切都給拍成一齣電影！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451915
    m_Localized: 'Dude: 哎呀……這大概是我這幾天遇到過最棒的一件事情了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451914
    m_Localized: 'Dude: 喲，老兄——非常感謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451913
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451912
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451911
    m_Localized: 'Dude: 我總是希望自己有朝一日可以生活在某齣電影之中……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451910
    m_Localized: 'Dude: 遠比書本要更加有趣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451909
    m_Localized: 'Dude: 承載著情感——充滿戲劇性、也不乏背叛！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451908
    m_Localized: 'Dude: 然而，電影……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451907
    m_Localized: 'Dude: 新聞播出之後，悲劇就上演了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451906
    m_Localized: 'Dude: 大家都在互相攻擊、詆毀對方，到處都遍佈著消極、悲觀的情緒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451905
    m_Localized: 'Dude: 也不能這麼說，老兄。我很清楚——現在，整個世界都亂成一團。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451904
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451903
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451902
    m_Localized: 'Dude: 好啦，現在不是滔滔不絕的時候。怎樣，老兄——讓我進去，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451901
    m_Localized: 'Dude: 我記得自己的麻吉剛好看過這樣的一本小說——哈哈，要是這樣的話、也太超現實了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451900
    m_Localized: 'Dude: 想像一下，如果我們成功征服了太空、開始向異星住客送出信件……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451899
    m_Localized: 'Dude: 譬如，他們能在某件科技產品還沒聞世的時候準確地將其寫進自己的作品之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451898
    m_Localized: 'Dude: 你有沒有聽說過科幻作家能預測未來？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451897
    m_Localized: 'Dude: 我並不是在胡言亂語，老兄——我知道自己在說什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451896
    m_Localized: 你對現在發生的一切完全沒有任何概念嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451895
    m_Localized: 你到底在說什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451894
    m_Localized: 'Dude: 當然，還得有食物——大量的食物，老兄。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451893
    m_Localized: 'Dude: 對了，你這裡有沒有霰彈槍、或者是手榴彈什麼的？我們需要準備一些火力，要不然鐵定活不下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451892
    m_Localized: 'Dude: 畢竟，根據種類的不同、需要採取的手段也會有著天壤之別。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451891
    m_Localized: 'Dude: 還有——到底是病毒導致的變異、還是死而復生？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451890
    m_Localized: 'Dude: 說吧——到底是蹣跚殭屍、還是疾走殭屍？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451889
    m_Localized: 'Dude: 我看過無數齣關於這些傢伙的電影，基本上已經稱得上是個生存專家了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451888
    m_Localized: 'Dude: 放心，老兄。全都交給我就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451887
    m_Localized: 'Dude: 殭屍！哈哈——我就知道！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451886
    m_Localized: 你對現在發生的一切完全沒有任何概念嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451885
    m_Localized: 你到底在說什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451884
    m_Localized: 'Dude: 對了、對了，這一隊伍最好是能由四人組成——畢竟，這樣全員生還的機率最大。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451883
    m_Localized: 'Dude: 就比如說……「火箭緊急升空，阻止世界末日」！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451882
    m_Localized: 'Dude: 我們接下來只要把一群屌到不行的太空人給送往太陽就行了，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451881
    m_Localized: 'Dude: 我看過這齣電影，老兄！沒錯——我還記得裡面有個禿頭的傢伙！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451880
    m_Localized: 'Dude: 不是吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451879
    m_Localized: 某種看似人類的生命從地底下爬了出來
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451878
    m_Localized: 太陽正在爆發——白天的時候甚至能把人給活生生地烤成焦炭
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451877
    m_Localized: 'Dude: 只管說實話就好——我都錯過了什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451876
    m_Localized: 'Dude: 你有看到外面這副光景嗎？該死……能不能告訴我一下，現在都是什麼情況？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451875
    m_Localized: 'Dude: 喲，老兄——過得怎樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451874
    m_Localized: 'Blind: 否則，它就會來找你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451873
    m_Localized: 'Blind: 無論如何，千萬不要在晚上靠近被燒焦的屍體。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451872
    m_Localized: 'Blind: 好吧，我會就此離開……不過，希望可以再聽我說一句——'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451871
    m_Localized: 'Blind: 該死……失去了雙眼之後，會不會更難入睡？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451870
    m_Localized: 'Blind: 謝謝……終於可以休息一下了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451869
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451868
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451867
    m_Localized: 'Blind: 這個……東西——根本就不應該存在於世上。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451866
    m_Localized: 'Blind: 更加巨大、更加深沉。它……它難以言喻。它循著燃燒的氣味前行、沿路收割我們所種下的惡果。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451865
    m_Localized: 'Blind: 不對……不對，遠比這要更加絕望。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451864
    m_Localized: 'Blind: 你真的認為我會因為某個通體蒼白的傢伙挖出自己的雙眼？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451863
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451862
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451861
    m_Localized: 'Blind: 天啊……即使是自己這輩子最為痛恨的人，我都不願看到對方落得此等下場。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451860
    m_Localized: 'Blind: 就在我的眼前……細嚼慢嚥地品嘗著滿地如同焦炭一般的屍體！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451859
    m_Localized: 'Blind: 起初，它……正心無旁騖地吞食著自己眼前的血肉，根本就沒有注意到我……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451858
    m_Localized: 'Blind: 我錯就錯在闖進了自己根本就不該前往的地方……而且——偏偏還是在最為糟糕的時機……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451857
    m_Localized: 'Blind: 於它而言，人類的悲慟只不過是場能令自己大快朵頤的盛宴罷了——不斷地啃噬著我們的恐懼、我們的痛苦……以及，我們的心智！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451856
    m_Localized: 'Blind: 你……相信我，還是不要知道為好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451855
    m_Localized: 你是說……那個通體蒼白的傢伙？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451854
    m_Localized: 你看到什麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451853
    m_Localized: 'Blind: 心想——只要把它們都給挖出來，興許就能把目睹到的駭人光景盡數抹去。現在，我的眼裡只剩下無邊、無際的黑暗。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451852
    m_Localized: 'Blind: 為了維持住最後一絲的理解，我別無他法、只好犧牲掉自己的雙眼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451851
    m_Localized: 'Blind: 其實……是我親手把自己搞成這樣的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451850
    m_Localized: 你是說……那個通體蒼白的傢伙？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451849
    m_Localized: 你看到什麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451848
    m_Localized: 'Blind: 相信我……如果你看到了它，也肯定會這樣做。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451847
    m_Localized: 'Blind: 根本無法以任何話語詮釋這股……不斷地撕扯著我靈魂的亙古之懼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451846
    m_Localized: 'Blind: 這一畫面……揮之不去。深深地烙印在了黑暗之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451845
    m_Localized: 'Blind: 我看到了某種不可名狀的東西。我不敢去言說……畢竟，心智崩潰時滋生的產物、又有誰能描述得出來呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451844
    m_Localized: 到底是誰對你做了這樣的事情？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451843
    m_Localized: 你的眼睛怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451842
    m_Localized: 'Blind: 終於……找到一個可以避難的地方了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451841
    m_Localized: 'Fatman: 現在，我又該去哪裡？完了——一切都完了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451840
    m_Localized: 'Fatman: 難以置信——你應該能看出來，我感覺很不舒服！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451839
    m_Localized: 'Fatman: 等一切都結束之後，我會把事情都……咳咳，這麼說吧——安排得妥妥當當。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451838
    m_Localized: 'Fatman: 明智的選擇，孩子——你一定不會後悔的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451837
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451836
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451835
    m_Localized: 'Fatman: 只要能讓我進去，我可以向你保證……等一切都結束之後，你會得到應得的報酬——而且，我能保證一定非常豐厚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451834
    m_Localized: 'Fatman: 像你這樣的一個無名小卒，拒絕一個有頭有臉的人物可不是什麼明智之舉。要知道，我可是個議員——之前負責掌控這個地方大大小小的各種事務。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451833
    m_Localized: 'Fatman: 光是來到這裡，就已經花了我很長的時間、費了我很大的工夫。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451832
    m_Localized: 'Fatman: 拜託，孩子……我已經受不了了，趕緊讓我進去吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451831
    m_Localized: 'Fatman: 我是認真的。我感覺很不舒服，現在就需要冷水。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451830
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451829
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451828
    m_Localized: 'Fatman: 不然，我就會昏倒在大街上。然後……在你的門前，被活活烤成一團黑炭！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451827
    m_Localized: 'Fatman: 罷了，聽著——快點把門給打開，我得好好洗個澡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451826
    m_Localized: 'Fatman: 說到這個——你這裡……應該不會剛好也有冰淇淋吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451825
    m_Localized: 'Fatman: 好極、好極，終於是給我找到了。還以為要被融成一灘肉泥，就這樣爛在大街上了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451824
    m_Localized: 你要我的浴室來做什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451823
    m_Localized: 有的
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451822
    m_Localized: 'Fatman: 我只是想洗個冷水澡。你應該……不介意我借用一下浴室吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451821
    m_Localized: 'Fatman: 現在的這個天氣……比我去過的任何熱帶渡假聖地都還要更熱。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451820
    m_Localized: 'Fatman: 我感覺自己的皮膚都快要燒起來、融化掉了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451819
    m_Localized: 'Fatman: 一點也不好。媽的……你倒是瞧瞧——'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451818
    m_Localized: 你要我的浴室來做什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451817
    m_Localized: 有的
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451816
    m_Localized: 'Fatman: 幾乎令我窒息。你，呃……你這裡有浴室嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451815
    m_Localized: 'Fatman: 好啦……的確，是要涼快那麼一點。不過……空氣還是非常沉悶。就像……呃，怎麼說呢——'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451814
    m_Localized: 'Fatman: 沒差，還是跟烤爐一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451813
    m_Localized: 你還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451812
    m_Localized: 現在……已經是三更半夜了
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451811
    m_Localized: 'Fatman: 該死——真是熱得要命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451810
    m_Localized: 'Buddy: 好吧，我不會死纏爛打的——我這就走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451809
    m_Localized: 'Buddy: 該死，兄弟……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451808
    m_Localized: 'Buddy: 要不是你，我就得獨自一人、流落街頭了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451807
    m_Localized: 'Buddy: 謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451806
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451805
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451804
    m_Localized: 'Buddy: 好啦，先把玩笑放一邊——能讓我進去嗎，兄弟？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451803
    m_Localized: 'Buddy: 至於酒味……要是不喝上兩口給自己壯膽的話，真的難以鼓起勇氣直視這個世界。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451802
    m_Localized: 'Buddy: 嘿嘿，放輕鬆點——我只不過是又在逗你罷了。千萬不要往心裡去，好嗎？如今這個世道，能笑出來已經很不錯啦。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451801
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451800
    m_Localized: 'Buddy: 既美味、又健康——如果執行得當，甚至可以減肥。只要看一眼我這完美無暇的身材，就能略知一二！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451799
    m_Localized: 'Buddy: 我今天早上剛好吃了一頓豐厚的早餐，完美地踐行了好友所提出的飲食計劃——白天喝啤酒，晚上喝紅酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451798
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451797
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451796
    m_Localized: 'Buddy: 好啦……能讓我進去嗎，兄弟？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451795
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451794
    m_Localized: 'Buddy: 如果冒犯到你了，還請見諒——我只是想維持住自己的心智而已。你應該可以理解吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451793
    m_Localized: 'Buddy: 只要能笑出來，兄弟……就能讓你在一切都滑向地獄之時保持住最後一絲的理智。要不是這樣的話，我早就撐不下去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451792
    m_Localized: 'Buddy: 雖然，我不是個十足的「人畜無害的模範市民」。不過，拜託——現在，這個世界正分崩離析，稍微開個玩笑、增添幾分樂趣，又怎麼了嘛？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451791
    m_Localized: 我好像在你的身上聞到了酒味。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451790
    m_Localized: 怎麼，難道你還是個搞笑藝人不成？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451789
    m_Localized: 'Buddy: 沒什麼，忘了吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451788
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451787
    m_Localized: 'Buddy: 我不會因為別人的牙齒、眼睛，或是電視上說的其他什麼東西就去傷害他們。我甚至沒有辦法——'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451786
    m_Localized: 'Buddy: 稍微有上一、兩個奇怪的特徵其實再正常不過了，並不代表對方就是個偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451785
    m_Localized: 'Buddy: 拜託，我就是鬧鬧你而已啦——不要這麼食古不化嘛。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451784
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451783
    m_Localized: 'Buddy: 雖然面對有著一口完美牙齒、漂亮眼睛的傢伙時、說不定會直接揍上去，不過……也純粹是出於嫉妒罷了，沒有任何私人恩怨。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451782
    m_Localized: 'Buddy: 放心，我這個人風度翩翩、心胸寬廣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451781
    m_Localized: 我好像在你的身上聞到了酒味。
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451780
    m_Localized: 怎麼，難道你還是個搞笑藝人不成？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451779
    m_Localized: 'Buddy: 也就是說——如果你想找人去酒吧裡喝個幾輪，叫上我準沒錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451778
    m_Localized: 'Buddy: 我根本就沒有什麼岳母，我甚至都還沒有結婚呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451777
    m_Localized: 'Buddy: 哈哈，被我騙到了吧？我在開玩笑呢，兄弟。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451776
    m_Localized: 'Buddy: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257716
    m_Localized: 'Buddy: 只不過是被自己的岳母給攆走了罷了，因為我把一個FEMA的傢伙給趕出了房子——她害怕對方會上門討要說法。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257715
    m_Localized: 'Buddy: 其實也不是什麼大事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257714
    m_Localized: 我又怎麼知道你到底是不是「人畜無害的模範市民」？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257713
    m_Localized: 你怎麼了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257712
    m_Localized: 'Buddy: 你好，兄弟。放我這個人畜無害的模範市民進去待上個幾天吧，如何？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257711
    m_Localized: 'Bestson: 再見了，陌生人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257710
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257709
    m_Localized: 'Bestson: 沒錯……沒錯，一定會的。希望如此……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257708
    m_Localized: 'Bestson: 我會回家——萬一他們回來了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257707
    m_Localized: 'Bestson: 好吧。出於安全考量，也是無可厚非。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257706
    m_Localized: 'Bestson: 不過……也許，現在還是先待在你這裡會比較好。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257705
    m_Localized: 'Bestson: 萬一他們回來之後找不到我了，該怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257704
    m_Localized: 'Bestson: 我不太確定這是不是個好主意。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257703
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257702
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257701
    m_Localized: 'Bestson: 我該如何是好？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257700
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257699
    m_Localized: 'Bestson: 真是……一場噩夢……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257698
    m_Localized: 'Bestson: 天啊……萬一他們被太陽給活生生烤成焦炭了，該怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257697
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257696
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257695
    m_Localized: 'Bestson: 我該如何是好？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257694
    m_Localized: 'Bestson: 我甚至都已經不知道該去思考一些什麼了。或許，你也無法相信我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257693
    m_Localized: 'Bestson: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257692
    m_Localized: 'Bestson: 該死。為什麼他們要離開？為什麼不帶我一起走呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257691
    m_Localized: 'Bestson: 天啊……萬一他們不幸遭到這些偽人的毒手了，該怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257690
    m_Localized: 太陽正在不斷爆發，會將我們活活烤死
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257689
    m_Localized: 偽人從地下爬了出來，現在誰也無法相信誰
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257688
    m_Localized: 'Bestson: 只好找人問問了，說不定對方願意告訴我呢？抱著這個想法，我來到了這裡。還請幫忙解答我的疑問——好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257687
    m_Localized: 'Bestson: 直播結束的幾個小時之後，他們就風風火火地離開了……再也沒有回來。現在，我更害怕打開電視了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257686
    m_Localized: 'Bestson: 我不想感受到壓力，因此沒有打開電視。然而，他們卻一去不復返……我直到現在都不知道究竟怎麼了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257685
    m_Localized: 'Bestson: 某天，他們聽說發生了可怕的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257684
    m_Localized: 'Bestson: 不過，爸爸和媽媽倒是經常在看就對了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257683
    m_Localized: 'Bestson: 我記得曾經在什麼地方讀到過來著——只要遠離新聞，就能活得更久。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257682
    m_Localized: 'Bestson: 新聞總是在報導一些不好的事情，令我無比焦慮。因此，沒錯——我已經有很長一段時間都沒有看電視了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257681
    m_Localized: 太陽正在不斷爆發，會將我們活活烤死
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257680
    m_Localized: 偽人從地下爬了出來，現在誰也無法相信誰
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257679
    m_Localized: 'Bestson: 我想知道真相——他們到底為什麼要離開？因此，拜託……告訴我吧，究竟出什麼事了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257678
    m_Localized: 'Bestson: 結果……現在已經過去了整整一週，他們也都還是沒有回來。不管我再怎麼等待，依舊……杳無音訊。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257677
    m_Localized: 'Bestson: 某天我醒來之後，發現他們非常緊張、慌得不行——說自己得立即離開。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257676
    m_Localized: 'Bestson: 我真的不知道。我……不太願意去看新聞，因為會感到心慌。不過，我的父母倒是有去關心……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257675
    m_Localized: 你沒有看電視嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257674
    m_Localized: 等等，你真的不知道現在發生了什麼事？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257673
    m_Localized: 'Bestson: 永不停歇的打鬥、源源不絕的槍聲……我完全搞不明白……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257672
    m_Localized: 'Bestson: 天氣突然變得特別炎熱，我幾乎都快喘不過氣了。而且，大家……也與過去大相徑庭。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257671
    m_Localized: 'Bestson: 不知，你能否告訴我現在發生了什麼事？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257670
    m_Localized: 'Fugitive: 晚你媽的安，混蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257669
    m_Localized: 'Fugitive: 隨你便了。就繼續躲在你的洞裡，把別人都拒之門外吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257668
    m_Localized: 'Fugitive: 也對，早就該料到。你跟其他人沒什麼兩樣——都是膽小的鼠輩。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257667
    m_Localized: 'Fugitive: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257666
    m_Localized: 'Fugitive: 媽的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257665
    m_Localized: 'Fugitive: 還好，與住在隔壁的傢伙不同、你是個好人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257664
    m_Localized: 'Fugitive: 謝謝，真的——我欠你一個人情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257663
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257662
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257661
    m_Localized: 'Fugitive: 由於看到了不該看到的東西……而且也知道了太多事情——可想而知，他們肯定會來找我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257660
    m_Localized: 'Fugitive: 於是，我付諸了行動。即便因此吃了一發子彈，我也認了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257659
    m_Localized: 'Fugitive: 目睹到這一切之後，我立即就意識到了——如果不趕緊逃走，恐怕是十死無生。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257658
    m_Localized: 'Fugitive: FEMA正在對我們做出某種傷天害理的事情。你仔細想想——是不是從來都沒見到過被抓進去的傢伙有誰回來？就是這個原因。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257657
    m_Localized: 'Fugitive: 我聽見裡面傳來了一陣若有似無的尖叫聲……接著，他們拖出來一個黑色的袋子。之後，就再也沒人見到過這個傢伙。你懂了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257656
    m_Localized: 'Fugitive: 我親眼看到了——媽的，他們把一個可憐的傢伙拖進了帳篷裡面。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257655
    m_Localized: 'Fugitive: 這可不是什麼危言聳聽！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257654
    m_Localized: 'Fugitive: 你有沒有聽說過FEMA正在進行各種亂七八糟的檢查、想要藉此找出偽人？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257653
    m_Localized: 'Fugitive: 沒錯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257652
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257651
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257650
    m_Localized: 'Fugitive: 我掉到了柵欄外面，一頭扎進了水坑裡。重新站穩腳跟之後，便頭也不回地逃了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257649
    m_Localized: 'Fugitive: 我只不過是運氣差了一點罷了……其中一個傢伙突然轉過頭來、看到了我，接著便毫不留情地向我開槍。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257648
    m_Localized: 'Fugitive: 裡頭每時每刻都忙得不可開交。看得出來……他們八成是在籌備什麼大事。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257647
    m_Localized: 'Fugitive: 想逃出去？只要看準時機爬過柵欄就好——甚至都犯不上制定什麼計劃。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257646
    m_Localized: 'Fugitive: 而且，他們的保全就是一個天大的笑話。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257645
    m_Localized: 'Fugitive: 基本上就是這樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257644
    m_Localized: 'Fugitive: 每天早上，他們都會像趕牲口一樣把人硬塞進大得不像樣的海運貨櫃之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257643
    m_Localized: 'Fugitive: 想像一塊被柵欄圍起的空地，內部零星地散落著幾頂帳篷。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257642
    m_Localized: 也就是說，FEMA正在追捕你？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257641
    m_Localized: 跟我說說，FEMA的隔離區裡面都長什麼樣子吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257640
    m_Localized: 'Fugitive: 我立即讓他們跟滾遠點——於是，他們便將我當成罪犯一樣給拷住了。不過，之後我找到機會、逃了出來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257639
    m_Localized: 'Fugitive: 接著，只見這些傢伙在平板電腦上好像鬼畫符一樣寫了些什麼、隨後便不由分說地讓我跟他們走。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257638
    m_Localized: 'Fugitive: 當時……剛一開門，就被他們拿某個儀器從頭到尾給掃描了一遍。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257637
    m_Localized: 'Fugitive: 好吧，我剛逃出一個——他們在某次檢查的時候把我給抓了進去。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257636
    m_Localized: 也就是說，FEMA正在追捕你？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257635
    m_Localized: 跟我說說，FEMA的隔離區裡面都長什麼樣子吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257634
    m_Localized: 'Fugitive: 雖說沒有被打成蜂窩……然而，遭的罪卻有過之而無不及……真是疼死我了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257633
    m_Localized: 'Fugitive: 媽的，還好直接穿體而出了。不過——該死……血流個不停、根本止不住。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257632
    m_Localized: 'Fugitive: 雖然他們的槍法實在爛得不行，不過其中的一顆子彈……還是擊中了我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257631
    m_Localized: 'Fugitive: 我爬上柵欄、想要逃走時……不小心被FEMA的豬玀給發現了……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257630
    m_Localized: 到底出什麼事了？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257629
    m_Localized: 到底是誰下的手？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257628
    m_Localized: 'Fugitive: 我中槍了——恐怕已經撐不下去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257627
    m_Localized: 'Fugitive: 救命……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257626
    m_Localized: 'Nun: 當你抵達天堂的大門……全知的主會因為你所犯下這項罪孽，對你降下審判。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257625
    m_Localized: 'Nun: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257624
    m_Localized: 'Nun: 記住——要是我之後不幸曝屍荒野了的話，毫無疑問會是你的錯、是你一手促成。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257623
    m_Localized: 'Nun: 竟然將一個可憐的老婦拒之門外。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257622
    m_Localized: 'Nun: 好吧，看來你已經做出了決定。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257621
    m_Localized: 'Nun: 非常感謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257620
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257619
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257618
    m_Localized: 'Nun: 好吧——放心，我會盡己所能、在接下來的這段時間內將這些汙言穢語通通都給驅逐出這個地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257617
    m_Localized: 'Nun: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257616
    m_Localized: 'Nun: 我只不過是提了幾個關於這棟房子的簡單問題罷了，而你——竟因此破口大罵？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257615
    m_Localized: 'Nun: 難道，你就不怕上帝降下天罰？！難道，你就不會感到一絲羞恥？！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257614
    m_Localized: 'Nun: 不要用這種粗鄙的語言跟我說話，無禮至極、對神不敬的野蠻之徒！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257613
    m_Localized: 'Nun: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257612
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257611
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257610
    m_Localized: 'Nun: 難道，這樣的要求也太高了？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257609
    m_Localized: 'Nun: 我只不過想要看看這棟房子是否適合居住罷了——我對骯髒之物深惡痛絕。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257608
    m_Localized: 'Nun: 哎呀，非常感謝你專門提醒我這點！要不是你，我根本就沒有辦法看出來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257607
    m_Localized: 你他媽瘋了吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257606
    m_Localized: 這裡不是旅社！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257605
    m_Localized: 'Nun: 我跟它們不對付——天父創造的這些最為汙穢的生物，會令我的皮膚變紅、起疹，苦不堪言。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257604
    m_Localized: 'Nun: 其次……你們這裡有沒有臭蟲、老鼠？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257603
    m_Localized: 'Nun: 如果住了這種傢伙會引起各式各樣問題的傢伙，你最好直接說清楚。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257602
    m_Localized: 'Nun: 首先——我無法忍受酗酒之人和吸毒之人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257601
    m_Localized: 'Nun: 你這裡會收留需要幫助的人，不是嗎？不過，我得事先確認幾件事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257600
    m_Localized: 'Nun: 我想要一個房間。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257599
    m_Localized: 你他媽瘋了吧？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257598
    m_Localized: 這裡不是旅社！
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257597
    m_Localized: 'Nun: 這棟房子應該有聖像吧？此外，為了進行祈禱、冥想……我需要絕對的安靜。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257596
    m_Localized: 'Nun: 既然都已經說到這了……就讓我向你確認一下具體的情況吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257595
    m_Localized: 'Nun: 非常適合我避風頭，孩子——要是可以的話，我想待在這裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257594
    m_Localized: 'Nun: 天啊……難道不是非常的顯而易見嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257593
    m_Localized: 你到底想要做什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257592
    m_Localized: 非常適合你做什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257591
    m_Localized: 'Nun: 不錯，孩子——看來，應該非常適合我。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257590
    m_Localized: 'Nun: 這棟簡陋的居所是這裡最遠、最偏僻的一間。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257589
    m_Localized: 'Raskolnikov: 不好意思，浪費了你的時間。我只是……希望有朝一日能學會該如何去殺人，從而保護自己。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257588
    m_Localized: 'Raskolnikov: 我可以對天發誓，我並非危險人物。只是……最近神經繃得太緊了而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257587
    m_Localized: 'Raskolnikov: 恐怕是我說的話實在太過離譜，令你誤以為我是個瘋子——或者是其他更為惡質傢伙了吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257586
    m_Localized: 'Raskolnikov: 你不願意讓我進去？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257585
    m_Localized: 'Raskolnikov: 能否示範一下看看——該如何去殺死偽人？我想要直視自己內心的恐懼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257584
    m_Localized: 'Raskolnikov: 然後……要是不會太過分的話……完成對我的檢查之後……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257583
    m_Localized: 'Raskolnikov: 謝謝，朋友。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257582
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257581
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257580
    m_Localized: 'Raskolnikov: 還可以教教我……該如何去殺人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257579
    m_Localized: 'Raskolnikov: 與此同時——也許……要是你願意的話……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257578
    m_Localized: 'Raskolnikov: 因此，我希望可以找到一個……有能耐來保護我的人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257577
    m_Localized: 'Raskolnikov: 而我？就是一個懦夫，完全無法自保。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257576
    m_Localized: 'Raskolnikov: 如今這個世道，只要露出一個不當的眼神、說不定就會被人請吃子彈。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257575
    m_Localized: 'Raskolnikov: 我想要提防的是偽人、以及獵殺偽人的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257574
    m_Localized: 'Raskolnikov: 不對、不對——等等。我說的並不是那個拿著來福槍的瘋子。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257573
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257572
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257571
    m_Localized: 'Raskolnikov: 因此，我需要一個知曉現在這個世界到底是如何運作的人來保護自己。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257570
    m_Localized: 'Raskolnikov: 我很擔心如果不知道該如何去反抗、等待著我的會是什麼下場。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257569
    m_Localized: 'Raskolnikov: 之前一切都還正常的時候，我連一隻蒼蠅都不忍傷害。然而，如今……像我這樣軟弱的人是活不下去的。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257568
    m_Localized: 'Raskolnikov: 我並非有意表現得像個瘋子一樣。只是……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257567
    m_Localized: 'Raskolnikov: 蛤？等等……難道，我說的話——聽起來有點瘋狂？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257566
    m_Localized: 你想要躲避的這個傢伙，到底是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257565
    m_Localized: 為何如此執著於殺人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257564
    m_Localized: 'Raskolnikov: 到時……活在恐懼之中的便不再是我、而是他人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257563
    m_Localized: 'Raskolnikov: 不管怎樣——總有一天，我也得學會該如何去殺人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257562
    m_Localized: 'Raskolnikov: 幸虧他沒有發現我當時也在場。否則，說不定會直接把我的脖子扭斷。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257561
    m_Localized: 'Raskolnikov: 只是……我不久之前碰上了一個攜帶武器的瘋子、親眼看到他在審問某人——一直在追問對方到底是否偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257560
    m_Localized: 'Raskolnikov: 千萬不要誤會——我並沒有想煽動你去殺死誰。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257559
    m_Localized: 'Raskolnikov: 太好了！這樣的話，萬一偽人出現、你也能將它們給消滅掉。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257558
    m_Localized: 你想要躲避的傢伙，到底是誰？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257557
    m_Localized: 為何如此執著於殺人？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257556
    m_Localized: 'Raskolnikov: 我猜——如果到了緊要關頭，即使手無寸鐵、你也可以把人殺死。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257555
    m_Localized: 'Raskolnikov: 不過，你的話裡帶刺。我想……一旦出了什麼事，你應該可以毫不猶豫地扣下扳機。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257554
    m_Localized: 'Raskolnikov: 畢竟，於末世譴責他人的殺戮行為……又跟在賽道上給選手開超速罰單有什麼區別？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257553
    m_Localized: 'Raskolnikov: 只是……如今正直危險時期——這點你也非常清楚，對吧？我想知道你能否進行自保、能否消滅威脅。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257552
    m_Localized: 'Raskolnikov: 哎呀……不好意思，我並非有意冒犯。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257551
    m_Localized: 我有一把槍
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257550
    m_Localized: 你問這個幹什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257549
    m_Localized: 'Raskolnikov: 請問，你有攜帶武器嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257548
    m_Localized: 'Raskolnikov: 你好，朋友。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257547
    m_Localized: 'Wifefema: 去你的吧。我找你的鄰居去——再也不見，白癡。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257546
    m_Localized: 'Wifefema: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257545
    m_Localized: 'Wifefema: 你他媽有病吧——我拿真心交你，你卻當我放屁？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257544
    m_Localized: 'Wifefema: 開什麼玩笑？拜託，我的丈夫可是FEMA的工作人員！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257543
    m_Localized: 'Wifefema: 你認為我是個偽人？！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257542
    m_Localized: 'Wifefema: 等等……搞什麼鬼？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257541
    m_Localized: 'Wifefema: 只要把偽人通通都給殺光，我們就能重回正常的生活。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257540
    m_Localized: 'Wifefema: 就是這樣！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257539
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257538
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257537
    m_Localized: 'Wifefema: 「女性無法勝任FEMA的工作」？放屁！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257536
    m_Localized: 'Wifefema: 我之前在邊境工作——誰心裡有鬼，我一眼就能看出來。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257535
    m_Localized: 'Wifefema: 一點也不公平。怎麼，難道因為我是女性、就比不上自己的丈夫？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257534
    m_Localized: 'Wifefema: 重要的是——他現在已經隸屬於FEMA了。而且……要是他們願意招收女性的話，我說不定也能成為其中的一員。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257533
    m_Localized: 'Wifefema: 我可不會告訴你。知道了又能怎樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257532
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257531
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257530
    m_Localized: 'Wifefema: 曾經親手逮到過好些藏了各種亂七八糟違禁品的渣滓。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257529
    m_Localized: 'Wifefema: 你知道嗎？我之前在海關工作，負責監管想要進出邊境的人員。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257528
    m_Localized: 'Wifefema: 太可惜了。要是能與丈夫強強聯手的話，我們能讓偽人全都無所遁形。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257527
    m_Localized: 'Wifefema: 我倒希望自己是。然而，非常遺憾——他們不錄用女性。早料到了。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257526
    m_Localized: 你的丈夫此前是做什麼工作的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257525
    m_Localized: 你也是FEMA的工作人員嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257524
    m_Localized: 'Wifefema: 該死的司機——趁機獅子大開口，根本就是敲竹槓。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257523
    m_Localized: 'Wifefema: 想說要不給他來個驚喜好了，於是便花錢叫了一輛計程車。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257522
    m_Localized: 'Wifefema: 聽說FEMA僱了他的時候，我開心得簡直都快要瘋了！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257521
    m_Localized: 'Wifefema: 我可以非常自豪地告訴你——他在FEMA工作！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257520
    m_Localized: 你的丈夫此前是做什麼工作的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257519
    m_Localized: 你也是FEMA的工作人員嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257518
    m_Localized: 'Wifefema: 等到我在FEMA工作的丈夫抓到他的時候……一定會把這個傢伙給揍得滿地找牙，哼。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257517
    m_Localized: 'Wifefema: 不過，我很確定——那個司機的牙齒潔白得就像瓷器一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257516
    m_Localized: 'Wifefema: 而且還被坑了一大筆錢。現在這個世道，就連這種最為基礎的公共交通服務都貴得要命。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257515
    m_Localized: 'Wifefema: 還能怎麼來？坐計程車唄。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257514
    m_Localized: 你的丈夫是做什麼工作的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257513
    m_Localized: 你是怎麼到這裡來的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257512
    m_Localized: 'Wifefema: 結果，他工作的地點並沒有能讓我住下的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257511
    m_Localized: 'Wifefema: 本想突然造訪、嚇他一跳。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257510
    m_Localized: 'Wifefema: 我來是為了探望自己的丈夫——他被指派到了這裡執行任務。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257509
    m_Localized: 'Wifefema: 你好。我可以在這裡借住幾天嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257508
    m_Localized: 'Theorist: 好吧。我這麼信任你……而你卻摧毀了我對人性的最後一絲希望。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257507
    m_Localized: 'Theorist: 人們有權得知真相！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257506
    m_Localized: 'Theorist: 你不能這樣！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257505
    m_Localized: 'Theorist: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257504
    m_Localized: 'Theorist: 忘掉過時的謊言吧，我已經掌握了真相！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257503
    m_Localized: 'Theorist: 我就知道自己可以信任你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257502
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257501
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257500
    m_Localized: 'Theorist: 於是，我昂首挺胸地離開了……順便拿走了一些珍貴的檔案。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257499
    m_Localized: 'Theorist: 要是大家能戴上耳塞的話……這些寄生蟲就爬不進大腦。只要這樣，就能拯救成千上萬條性命！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257498
    m_Localized: 'Theorist: 不過其他的傢伙實在太過愚蠢，無法理解這項成果的價值所在。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257497
    m_Localized: 'Theorist: 我得出的結論是——真正的威脅並非偽人，而是潛伏於其體內的……大腦寄生蟲。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257496
    m_Localized: 'Theorist: 我之前在一所研究機構工作，結果……卻因為有了重大發現而被解僱。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257495
    m_Localized: 'Theorist: 只是，你得發誓——絕對不能向其他人透露。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257494
    m_Localized: 'Theorist: 好吧……既然選擇了相信你，我會知無不言。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257493
    m_Localized: 趕緊離開吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257492
    m_Localized: 進來吧
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257491
    m_Localized: 'Theorist: ……馬鈴薯口味的洋芋片背後的真相。你說說看——這合理嗎？！它們根本就是科學上的敗筆、災難！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257490
    m_Localized: 'Theorist: 思想控制——透過速食來實現。沒錯，千真萬確。最後，還有……'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257489
    m_Localized: 'Theorist: 選舉舞弊——證實了登月一事純粹子虛烏有。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257488
    m_Localized: 'Theorist: 哎呀，做好準備。我馬上就會讓你大開眼界。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257487
    m_Localized: 你是在哪裡拿到這些東西的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257486
    m_Localized: 你在說什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257485
    m_Localized: 'Theorist: 也就表示……我可以與你分享一些非比尋常的情報。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257484
    m_Localized: 'Theorist: 既然斬釘截鐵地否定了，也就表示你說的是實話。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257483
    m_Localized: 'Theorist: 根據規定，如果被他人問及所屬單位、FEMA的工作人員不能有所隱瞞。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257482
    m_Localized: 'Theorist: 太好了——換言之，我可以信任你。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257481
    m_Localized: 你是在哪裡拿到這些東西的？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257480
    m_Localized: 什麼樣的資訊？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257479
    m_Localized: 'Theorist: 其中包括巨量的資料——我打算將其公之於眾。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257478
    m_Localized: 'Theorist: 我帶著一些非常敏感的文件。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257477
    m_Localized: 'Theorist: 我需要一個安全的地方來繼續自己的研究。'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257476
    m_Localized: 'Theorist: 當然是信任你不會洩漏重要的資訊！'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257475
    m_Localized: 我並不隸屬於FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257474
    m_Localized: 具體來說，是要信任我做什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257473
    m_Localized: 'Theorist: 你應該……並不隸屬於FEMA，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257472
    m_Localized: 'Theorist: 你好。請問……我能信任你嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861319
    m_Localized: 'Firefighter: 來，收下吧……反正我也用不上它。要嘛丟掉，要嘛拿來做別的用途——由你決定。'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861318
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861317
    m_Localized: 'Firefighter: 要大家去FEMA隔離區。只是，要是每個去了的人都只有死路一條的話，誰還會去……'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861316
    m_Localized: 'Firefighter: 我這裡有一份文件，是出發前往救火之前收到的。'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861315
    m_Localized: 'Firefighter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861314
    m_Localized: 'Firefighter: 起碼，我不會曝屍荒野了。'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861313
    m_Localized: 'Firefighter: 我想，我應該不會打擾你太久。*咳嗽*'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861312
    m_Localized: 'Firefighter: 謝謝。*咳嗽*'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
