%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: TestDialogs_en
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 14fe5035ef9c9434b954918f4d36043a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 49614147584
    m_Localized: 'Chmo: My eyes have an unbearable itch lately.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119104
    m_Localized: 'Chmo: Do you think it''s from the sun? Or...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119105
    m_Localized: 'Chmo: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119106
    m_Localized: 'Chmo: Fuck.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119107
    m_Localized: 'Chmo: It''s just an infection.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119108
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119109
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119110
    m_Localized: 'Chmo: Listen, I''ve got an idea...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119111
    m_Localized: 'Chmo: You got that gun... why not just take their money?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119112
    m_Localized: 'Chmo: Imagine how much we''ll make, bitch!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119113
    m_Localized: 'Chmo: What? Just think about it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119114
    m_Localized: 'Chmo: Bitch, suck my d...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119115
    m_Localized: 'Chmo: АААААААА.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119116
    m_Localized: 'Chmo: Come on, I''m fine.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119117
    m_Localized: 'Chmo: My nails are fine, look.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119118
    m_Localized: 'Chmo: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119119
    m_Localized: 'Chmo: No, you don''t think so.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119120
    m_Localized: 'Chmo: I washed, I just didn''t have time to rinse my hands today.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119121
    m_Localized: 'Chmo: Usually, my nails are clean, bitch.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119122
    m_Localized: 'Chmo: Good for you. You''ll never have enough bags if you just whack everyone.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119123
    m_Localized: 'Chmo: By the way, what happens to the bodies afterwards?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119124
    m_Localized: 'Chmo: Bitch, you put them out on the street? Or what?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119125
    m_Localized: 'Chmo: You kill a guy just for having dirty nails?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119126
    m_Localized: 'Chmo: Come on. I never thought I’d die over something so stupid.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119127
    m_Localized: 'Chmo: You want to take a picture with me? Let’s do it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119128
    m_Localized: 'Chmo: Only thing, I''m really sensitive to the light. I might flinch.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119129
    m_Localized: 'Chmo: (You''re taking a picture of the person you''re talking to)'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119130
    m_Localized: 'Chmo: (You think the picture is okay, but the face...)'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119131
    m_Localized: 'Chmo: (It looked very smudged)'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119132
    m_Localized: 'Chmo: That’s what I''m talking about, bitch.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119133
    m_Localized: 'Chmo: Gonna take another shot?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119134
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119135
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119136
    m_Localized: 'Chmo: What''s the catch, bitch? Take these suckers for a ride, not me.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119137
    m_Localized: 'Chmo: Let them keep in shape.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119138
    m_Localized: 'Chmo: Don''t let them grow complacent. Remind them it''s your kindness that keeps them safe.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119139
    m_Localized: 'Chmo: Wait!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119140
    m_Localized: 'Chmo: Fuck you and your house, I''m leaving.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119141
    m_Localized: 'Chmo: I''m gonna go bake in the sun, and it’s gonna be on you, bitch.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119142
    m_Localized: 'Chmo: I can show you some teeth, bitch.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119143
    m_Localized: 'Chmo: My brother-in-law got his teeth done.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119144
    m_Localized: 'Chmo: Lost all his fucking teeth on the bad end of a brawl HAHAHAHAHA.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119145
    m_Localized: 'Chmo: Oh, I gotta show you. Uh-huh.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119146
    m_Localized: 'Chmo: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119147
    m_Localized: 'Chmo: Good, huh?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119148
    m_Localized: 'Chmo: What are you doing?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119149
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119150
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119151
    m_Localized: 'Chmo: I get it, of course, all this stress with the Visitors and stuff.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119152
    m_Localized: 'Chmo: But you''re doing it all for us.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119153
    m_Localized: 'Chmo: Anyway, I hold no grudges. Won’t tell you any bullshit.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119154
    m_Localized: 'Chmo: You fuckung kidding me?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119155
    m_Localized: 'Chmo: What the...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119156
    m_Localized: 'Sosed: Hi! I got an update from a friend in the city. The news should be reporting it soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119157
    m_Localized: 'Sosed: People from the cities are already coming to out to the smaller neighborhoods. People... have changed a lot.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119158
    m_Localized: 'Sosed: If they come to your place, you let them in. We can''t become heartless in these dark times. Just... be careful, okay?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119159
    m_Localized: 'Sosed: I''ve heard some people got killed...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119160
    m_Localized: 'Sosed: More and more of those stories nowadays...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119161
    m_Localized: 'Sosed: Some say these creatures look like humans..'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119162
    m_Localized: 'Sosed: The authorities should be letting us know the signs to look out for.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119163
    m_Localized: 'Sosed: If you stay here alone...there''s no telling what evil might find you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119164
    m_Localized: What's going on out there?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119165
    m_Localized: Is it safe outside?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119166
    m_Localized: 'Sosed: It''s safe to look out the windows at night.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119167
    m_Localized: 'Sosed: Stay vigilant. You should know what''s lurking around your house.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119168
    m_Localized: 'Sosed: Don''t look out during the day. It''ll burn your eyes.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119169
    m_Localized: Is it better not to leave the house now?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119170
    m_Localized: Wait, what do we do now?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119171
    m_Localized: 'Sosed: Let''s summarize.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119172
    m_Localized: 'Sosed: There''s gonna be people coming to your door at night. You decide who to let in.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119173
    m_Localized: 'Sosed: Keep an eye on your guests. We''ll learn what to look for as the days go on.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119174
    m_Localized: 'Sosed: Look out the windows at night to keep watch.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119175
    m_Localized: 'Sosed: And keep your head down. It''s dangerous everywhere now.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119176
    m_Localized: 'Sosed: I''ll sleep here tonight.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119177
    m_Localized: 'Sosed: Come and see me in the afternoon and we''ll talk.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119178
    m_Localized: 'Sosed: Let me preface this, just in case.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119179
    m_Localized: 'Sosed: During the day, you can talk to your house guests about all sorts of things.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119180
    m_Localized: 'Sosed: While talking with them, you check for signs they aren''t human.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119181
    m_Localized: 'Sosed: Then, you can decide what to do...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119182
    m_Localized: 'Sosed: If you don''t want to talk with anyone else, but still have spare time, drink beer in the kitchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119183
    m_Localized: 'Sosed: There''s one in the fridge I brought you to chill. It''ll make you sleepy.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119184
    m_Localized: 'Sosed: And wait for help. If they call an evacuation, stay close to my family.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119185
    m_Localized: 'Sosed: Now have a beer and get some rest. You look tired.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119186
    m_Localized: 'Sosed: By the way, I''ve heard that at night someone walks around asking if you''re home alone.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119187
    m_Localized: 'Sosed: If you open the door, don''t say that you''re alone.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119188
    m_Localized: 'Sosed: Did you see the newscast? It''s a nightmare....'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119189
    m_Localized: 'Sosed: In this heat, every word is going to sap energy.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119190
    m_Localized: 'Sosed: So think hard about who you want to talk to.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119191
    m_Localized: 'Sosed: And one more thing: checking people for symptoms will take time.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119192
    m_Localized: 'Sosed: So be careful how you spend your day.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119193
    m_Localized: 'Sosed: If you decide you''ve talked to everyone and you don''t want to sleep, have a beer.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119194
    m_Localized: 'Sosed: Go to the kitchen, have a cold one from the fridge.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119195
    m_Localized: 'Sosed: It''ll use up all your energy, and you''ll want to sleep right away.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119196
    m_Localized: So I'm just supposed to sit around and... survive?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119197
    m_Localized: That's kind of weird. Don't you think?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119198
    m_Localized: 'TV: You watch graceful ballerinas gliding across the stage, performing beautiful pirouettes.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119199
    m_Localized: 'TV: Classical dance brings back warm childhood memories and makes you think of beautiful things.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119200
    m_Localized: 'TV: Good morning, dear viewers!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119201
    m_Localized: 'TV: It''s the morning weather forecast.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119202
    m_Localized: 'TV: The sun keeps shining on our cozy little town.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119203
    m_Localized: 'TV: The duration of this heat has already broken a Guinness record, and it seems that the good weather isn''t going anywhere.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119204
    m_Localized: 'TV: Scientists are closely monitoring solar activity and predict its intensification.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119205
    m_Localized: 'TV: But they assure us there''s no need to worry.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119206
    m_Localized: 'TV: So, grab your sunglasses, take your best swimsuits, and don''t forget your hats!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119207
    m_Localized: 'TV: And most importantly, make sure you don''t get sunstroke.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119208
    m_Localized: 'TV: Lately, there''s been reports of strange behavior in the town. Is there a such thing as too much fun in the sun?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119209
    m_Localized: 'Doch: Hi!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119210
    m_Localized: 'Doch: Is my dad here? Can you call him?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119211
    m_Localized: 'Doch: It wasn''t scary during the day, but now it is — a lot of people went out at night...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119212
    m_Localized: What's your father name?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119213
    m_Localized: Tell me something about your dad.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119214
    m_Localized: 'Doch: Did you forget his name? Oh, you''re checking to see if I''m a Visitor.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119215
    m_Localized: 'Doch: You''re smart! I''ll start checking people now too.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119216
    m_Localized: Did you get here safely?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119217
    m_Localized: Are you afraid of Visitors?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119218
    m_Localized: 'Doch: Hm, I can tell you a lot.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119219
    m_Localized: 'Doch: Before he goes out, he likes to have a little beer, hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119220
    m_Localized: 'Doch: He leaves me lunch, dinner, and juice.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119221
    m_Localized: 'Doch: Today I tried the beer he drinks. Ugh, it was awful!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119222
    m_Localized: 'Doch: Why drink that when there''s juice?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119223
    m_Localized: 'Doch: Oh, please don''t tell him.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119224
    m_Localized: Did you get here safely?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119225
    m_Localized: Are you afraid of Visitors?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119226
    m_Localized: 'Doch: You know, it''s like everything has turned upside down.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119227
    m_Localized: 'Doch: People now stay indoors or sleep during the day. At night — they go out and do things.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119228
    m_Localized: 'Doch: I''m still not used to the dark, but it seems like there''s nothing to fear.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119229
    m_Localized: 'Doch: Or is there?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119230
    m_Localized: I'm calling your dad for you. Good luck!
    m_Metadata:
      m_Items: []
  - m_Id: 49635119231
    m_Localized: Have a good time!
    m_Metadata:
      m_Items: []
  - m_Id: 49635119232
    m_Localized: 'Doch: I don''t know.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119233
    m_Localized: 'Doch: Everyone is scared of them. I''m scared of them too. I haven''t seen one of them yet, I don''t think...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119234
    m_Localized: 'Doch: Are they scary? Do they attack people?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119235
    m_Localized: 'Doch: If my friend from school hit me — is he a Visitor too?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119236
    m_Localized: 'Doch: Daddy said to be careful, so I''m very careful!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119237
    m_Localized: 'Doch: I came here very quietly, no one saw me.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119238
    m_Localized: I'm calling dad for you. Good luck!
    m_Metadata:
      m_Items: []
  - m_Id: 49635119239
    m_Localized: Have a good time!
    m_Metadata:
      m_Items: []
  - m_Id: 49635119240
    m_Localized: 'Doch: Thanks, good luck to you too!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119241
    m_Localized: 'Doch: We''ll go now. I''m scared to be outside alone at night.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119242
    m_Localized: 'Doch: We''re going to play a game at home. We roll a dice...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119243
    m_Localized: 'Doch: And then walk on furnutre, like a chair or a couch.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119244
    m_Localized: 'Doch: And then you have to build a road between them! Anyway, I''ll show you later.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119245
    m_Localized: 'Doch: Goodbye!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119246
    m_Localized: 'Esenin: Can I come in?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119247
    m_Localized: 'Esenin: I was hiding in the pub, but...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119248
    m_Localized: 'Esenin: I got 86''ed.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119249
    m_Localized: 'Esenin: Why? Hmm. Not everyone can handle my temper.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119250
    m_Localized: 'Esenin: But I don''t mean to offend anyone, don''t get me wrong. It''s just... sometimes life gets sickening. You know how it is.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119251
    m_Localized: 'Esenin: What do you think? Will you let me in?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119252
    m_Localized: You're not a Visitor, are you?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119253
    m_Localized: Are you sure there won't be any trouble with you?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119254
    m_Localized: 'Esenin: You think I''m one of those monsters?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119255
    m_Localized: 'Esenin: No, I''m no Visitor. But asking everyone to their face about it is just crazy.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119256
    m_Localized: 'Esenin: Anyway, I guess this is how htings are now.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119257
    m_Localized: Why did they kick you out of your last shelter?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119258
    m_Localized: Why do you think it will be different here?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119259
    m_Localized: 'Esenin: What do you mean by troubles?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119260
    m_Localized: 'Esenin: I don''t have the stomach for violence. But I won''t let anyone hurt me...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119261
    m_Localized: 'Esenin: What I like is eating, drinking, and having a good time. Is that a problem?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119262
    m_Localized: Why did they kick you out of your last shelter?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119263
    m_Localized: Why do you think it will be different here?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119264
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119265
    m_Localized: 'Esenin: I was thinking of something rude, but I''ll keep it to myself.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119266
    m_Localized: 'Esenin: I told ya, people just can''t handle me sometimes. There''s nothing wrong with that.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119267
    m_Localized: 'Esenin: When I think about it, maybe it was for the best that they kicked me out.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119268
    m_Localized: 'Esenin: Maybe it''s safer this way.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119269
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119270
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119271
    m_Localized: 'Esenin: So what, am I supposed to die under the sun now?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119272
    m_Localized: 'Esenin: No, that''s not for me.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119273
    m_Localized: 'Esenin: I''ll keep looking for someone to talk to take me in. Surely someone must have a kinder heart than you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119274
    m_Localized: 'Esenin: And if not... well then what''s the point of sticking around, anyways?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119275
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119276
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119277
    m_Localized: 'Esenin: Hmm. I understand.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119278
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119279
    m_Localized: 'Esenin: I understand. You''re just as much of a coward as everyone else.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119280
    m_Localized: 'Esenin: Sleep well tonight. And fuck you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119281
    m_Localized: 'Esenin: Thanks. Trust is becoming expensive nowadays.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119282
    m_Localized: 'Esenin: I appreciate your faith in me. Maybe I can live up to it...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119283
    m_Localized: 'Trevoga: Hello!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119284
    m_Localized: 'Trevoga: Sorry for distubing you so late; it''s just too hot during the day. The TV said it''s better not to go out in the sun.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119285
    m_Localized: 'Trevoga: You got a corner for me in there?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119286
    m_Localized: Who are you?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119287
    m_Localized: How did you get here?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119288
    m_Localized: 'Trevoga: Mmmm, I used to live closer to Downtown.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119289
    m_Localized: 'Trevoga: The asphalt get''s pretty hot out there, haha. Ugh.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119290
    m_Localized: 'Trevoga: I used to work as a cashier. Not anymore, though.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119291
    m_Localized: 'Trevoga: I got fired, just can''t seem to catch a break...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119292
    m_Localized: What are you gonna do now?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119293
    m_Localized: What do you think will happen in the future?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119294
    m_Localized: 'Trevoga: I didn''t really intend to come. Sure, the asphalt is melting, but it could be worse.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119295
    m_Localized: 'Trevoga: It will make you laugh.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119296
    m_Localized: 'Trevoga: Visitors took over my house. Can you believe it? They kicked me out of my own house!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119297
    m_Localized: 'Trevoga: Now I''m wandering around, looking for somewhere to hide from the sun.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119298
    m_Localized: What are you gonna do now?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119299
    m_Localized: What do you think will happen in the future?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119300
    m_Localized: 'Trevoga: Mmmm. I''ll try to survive somehow. It scares me, of course, with these Visitors around and the sun blazing like hell.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119301
    m_Localized: 'Trevoga: I really want to live. Heheh. Oh-oh-oh.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119302
    m_Localized: 'Trevoga: Aren''t you scared?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119303
    m_Localized: 'Trevoga: Please, tell me it''s gonna be alright soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119304
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119305
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119306
    m_Localized: 'Trevoga: I don''t know.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119307
    m_Localized: 'Trevoga: Will I survive? Who will help me? How long will I have to search for help?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119308
    m_Localized: 'Trevoga: I don’t know what will happen next. I can''t even guess.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119309
    m_Localized: 'Trevoga: Aren’t you scared by this? I am — very much so.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119310
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119311
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119312
    m_Localized: 'Trevoga: Huh, oh, yeah.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119313
    m_Localized: 'Trevoga: Anyway, thanks for listening to me.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119314
    m_Localized: 'Trevoga: M, okay, I guess I''ll move on then.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119315
    m_Localized: 'Trevoga: Bye? Yeah, uh, bye...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119316
    m_Localized: 'Trevoga: Thank you! Oh, thank you, really!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119317
    m_Localized: 'Trevoga: Oh God, you''ve saved me!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119318
    m_Localized: 'Window: It''s dead quiet outside.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119319
    m_Localized: 'Window: Nobody''s there.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119320
    m_Localized: 'Window: Even the alcoholics decided not to litter our streets today.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119321
    m_Localized: 'Window: Are they afraid of someone?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119322
    m_Localized: 'Window: You see several teenagers spending time in a field outside the window.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119323
    m_Localized: 'Window: They are sitting around chatting excitedly, not paying attention to you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119324
    m_Localized: 'Window: In the distance is the neighbor''s house. The neighbor is visiting you now.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119325
    m_Localized: 'Window: The lights are on in the windows and the family seems to be waiting for him to leave you back home for dinner.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119326
    m_Localized: 'Esenin: We''re both goin off the same information here.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119327
    m_Localized: 'Esenin: Visitors can be identified by perfectly white teeth...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119328
    m_Localized: 'Esenin: This is fucking bullshit! They just want us to kill each other.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119329
    m_Localized: 'Esenin: But... why?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119330
    m_Localized: 'Esenin: The sun is exploding. There is real hell on earth.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119331
    m_Localized: 'Esenin: No metaphor. No salvation.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119332
    m_Localized: 'Esenin: No one trusts anyone. People are literally being burned alive by the sun. Who wouldn''t sell their own mothers for shelter?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119333
    m_Localized: 'Esenin: I want to believe in people, but it''s hard.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119334
    m_Localized: 'Esenin: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119335
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49635119336
    m_Localized: Did you see the news? Show me your teeth.
    m_Metadata:
      m_Items: []
  - m_Id: 49635119337
    m_Localized: 'Esenin: Yeah? Did you want something?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119338
    m_Localized: How do you recognize a Visitor?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119339
    m_Localized: What do you know about the cataclysm?
    m_Metadata:
      m_Items: []
  - m_Id: 49635119340
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49635119341
    m_Localized: 'TV: Heat outside? No problem...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119342
    m_Localized: 'TV: When you have EnerJeka in hand!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119343
    m_Localized: 'TV: This refreshing energy drink quenches thirst even in the most brutal heat!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119344
    m_Localized: 'TV: This unique blend of lime and mint gives extraordinary energy!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119345
    m_Localized: 'TV: EnerJeka. Look for it in nearby stores.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119346
    m_Localized: 'TV: Dynamic energy drink advertisement, subtly satisfying your thirst.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119347
    m_Localized: 'TV: We interrupt our morning show for an urgent message...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119348
    m_Localized: 'TV: Today at 6:28 AM, there was a powerful solar energy eruption.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119349
    m_Localized: 'TV: This flare was larger than scientists predicted.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119350
    m_Localized: 'TV: The air temperature has reached a critical level.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119351
    m_Localized: 'TV: Authorities have declared a state of emergency.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119352
    m_Localized: 'TV: We urge all citizens to avoid going outside during daylight hours.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119353
    m_Localized: 'TV: Now, on to the news...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119354
    m_Localized: 'TV: Aliens? People emerging from underground?'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119355
    m_Localized: 'TV: No, this isn''t a sci-fi story or a tabloid headline!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119356
    m_Localized: 'TV: Eyewitnesses report contact with ''Visitors'' around the city..'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119357
    m_Localized: 'TV: One witness encountered a middle-aged man...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119358
    m_Localized: 'TV: Who had perfectly white teeth.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119359
    m_Localized: 'TV: It turns out, he was one of these ''Visitors''.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119360
    m_Localized: 'TV: Similar incidents with ''Visitors'' sporting perfect teeth have been observed.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119361
    m_Localized: 'TV: So, if you want to stay safe – check their teeth.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119362
    m_Localized: 'TV: Please stay alert and calm.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119363
    m_Localized: 'TV: Now, let''s move on to other news...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119364
    m_Localized: 'Trevoga: I wish I knew how.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119365
    m_Localized: 'Trevoga: I''m so scared... anyone could be a Visitor...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119366
    m_Localized: 'Trevoga: The only thing I heard on the radio was that their teeth are perfect, but...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119367
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119368
    m_Localized: 'Trevoga: Do regular people not have good teeth? Heheh. Heh heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119369
    m_Localized: 'Trevoga: Ahhhh, oh-oh-oh-oh.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119370
    m_Localized: 'Trevoga: I don''t even know what to say.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119371
    m_Localized: 'Trevoga: I decided to look out the window, and...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119372
    m_Localized: 'Trevoga: I wish I hadn''t looked out there.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119373
    m_Localized: 'Trevoga: Just the blackened bodies of some kids.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119374
    m_Localized: 'Trevoga: What a horrible way to die...'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119375
    m_Localized: 'Trevoga: Just take myself out quick and painless.'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119376
    m_Localized: 'Trevoga: Better than being cooked on the streets!'
    m_Metadata:
      m_Items: []
  - m_Id: 49635119377
    m_Localized: 'Trevoga: It''s only going to get worse, I know it! WE''RE ALL GONNA DIE!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313408
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313409
    m_Localized: 'Trevoga: I''m sorry.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313410
    m_Localized: 'Trevoga: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313411
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49639313412
    m_Localized: Did you see the news? Show your teth.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313413
    m_Localized: 'Trevoga: Uh-uh. Hopefully this will all be over soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313414
    m_Localized: How do you recognize a Visitor?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313415
    m_Localized: What do you know about the cataclysm?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313416
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49639313417
    m_Localized: 'Fan: Hey HUMAN.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313418
    m_Localized: 'Fan: How fortunate we are! We''ve witnessed firsthand the consequences of mankind''s folly.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313419
    m_Localized: 'Fan: The earth will be cleansed, the sun will do its work.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313420
    m_Localized: 'Fan: And we will go to a new clean world!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313421
    m_Localized: 'Fan: That''s the FUCKING GOOD NEWS.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313422
    m_Localized: What?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313423
    m_Localized: You're scaring me.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313424
    m_Localized: 'Fan: What are you doing, HUMAN?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313425
    m_Localized: 'Fan: Listen to me, I''ll give you a brief rundown.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313426
    m_Localized: 'Fan: The sun burns and BURNS us for redemption! It bakes the sins out!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313427
    m_Localized: 'Fan: We''ve lived gluttonous lives, and now the SUN is angry!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313428
    m_Localized: 'Fan: GIVES HIS GLORIOUS HEAT TO US!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313429
    m_Localized: 'Fan: And what a wonderful gift. Without sin, we''ll live our lives properly.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313430
    m_Localized: You mean we all have to die?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313431
    m_Localized: What's gonna happen to you then?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313432
    m_Localized: 'Fan: Are you out of your mind?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313433
    m_Localized: 'Fan: Listen to me, I''ll give you a brief rundown.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313434
    m_Localized: 'Fan: The sun burns and BURNS us for a reason! It bakes sins out of us!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313435
    m_Localized: 'Fan: We''ve all lived sinful lives, and now the SUN is angry!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313436
    m_Localized: 'Fan: GIVES HIS GLORIOUS HEAT TO US!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313437
    m_Localized: 'Fan: And what a wonderful gift. Without sin, we''ll live our lives properly.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313438
    m_Localized: You mean we all have to die?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313439
    m_Localized: What's gonna happen to you then?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313440
    m_Localized: 'Fan: Nah!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313441
    m_Localized: 'Fan: Sins will fade away, the sun may die. BUT WE WILL LIVE.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313442
    m_Localized: 'Fan: There will be no more deaths, no more stealing, no more greedy bastards who try to cheat me.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313443
    m_Localized: 'Fan: Can you imagine such a thing? Do you realize what this is all about?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313444
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313445
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313446
    m_Localized: 'Fan: What''s it got to do with me?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313447
    m_Localized: 'Fan: We''re all going to LIVE WELL right after the sun helps.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313448
    m_Localized: 'Fan: The sun will just help us get rid of all this stuff, you know? No?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313449
    m_Localized: 'Fan: You understand everything, that''s why you''re alive!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313450
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313451
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313452
    m_Localized: 'Fan: Did you pretend you didn''t know anything about the sun?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313453
    m_Localized: 'Fan: Well fuck you then, I''ll SAVE SOMEONE ELSE!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313454
    m_Localized: 'Fan: All right, bye-bye, bye-bye!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313455
    m_Localized: 'Fan: I can tell you a lot more about all this!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313456
    m_Localized: 'Fan: Do you have any beer, I forgot to ask?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313457
    m_Localized: 'Holod: Hello.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313458
    m_Localized: 'Holod: Oh, I''m not really all that afraid of the heat. But I''m still looking for a quiet place to rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313459
    m_Localized: 'Holod: Can I find peace at your place?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313460
    m_Localized: Who are you?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313461
    m_Localized: How long have you been looking for a place?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313462
    m_Localized: 'Holod: It doesn''t matter anymore. You''re asking if I''m a Visitor, aren''t you?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313463
    m_Localized: 'Holod: No, I''m not a Visitor. But there is something I would ask of you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313464
    m_Localized: 'Holod: But that''s for later.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313465
    m_Localized: You don't mind the heat?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313466
    m_Localized: Take off your jacket.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313467
    m_Localized: 'Holod: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313468
    m_Localized: 'Holod: I''ve never known peace.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313469
    m_Localized: 'Holod: So... yeah, for a long time.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313470
    m_Localized: Are you okay with the heat?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313471
    m_Localized: Take off your jacket.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313472
    m_Localized: 'Holod: I always feel cold.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313473
    m_Localized: 'Holod: While people are burning up, I wrap myself in jackets and still feel cold.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313474
    m_Localized: 'Holod: I''m scared to take off my clothes.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313475
    m_Localized: 'Holod: What if it only brings more suffering? And what if it doesn''t kill me?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313476
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313477
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313478
    m_Localized: 'Holod: No.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313479
    m_Localized: 'Holod: It''s okay if you don''t let me in.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313480
    m_Localized: 'Holod: I''ll just keep moving. I''m not gonna beg or bother you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313481
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313482
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313483
    m_Localized: 'Holod: I get it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313484
    m_Localized: 'Holod: Okay, bye.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313485
    m_Localized: 'Holod: I see you got a lot of gunpowder residue on your hands.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313486
    m_Localized: 'Holod: Can you shoot me?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313487
    m_Localized: 'Holod: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313488
    m_Localized: 'Holod: Yeah. You need the bullets for yourself. Bye.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313489
    m_Localized: 'Holod: Thank you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313490
    m_Localized: 'Holod: The ceiling is a little low here. But I''ll be fine.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313491
    m_Localized: 'Prorok: It happened once before and it will happen again later.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313492
    m_Localized: 'Prorok: Too bad we are the witnesses.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313493
    m_Localized: 'Prorok: Maybe we are participants too.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313494
    m_Localized: Who are you?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313495
    m_Localized: Do you need anything?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313496
    m_Localized: 'Prorok: Just a person.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313497
    m_Localized: 'Prorok: I''m not looking for anything, I''m not forcing anyone to do anything.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313498
    m_Localized: 'Prorok: I came out of the shadows, I''ll stay in the shadows.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313499
    m_Localized: What are you talking about?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313500
    m_Localized: You're... weird.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313501
    m_Localized: 'Prorok: No, thanks.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313502
    m_Localized: 'Prorok: Everything I need is already here.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313503
    m_Localized: 'Prorok: And what I don''t have, you can''t help me with.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313504
    m_Localized: 'Prorok: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313505
    m_Localized: 'Prorok: Will you read my fortune? Choose where I should open the book and read a line.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313506
    m_Localized: What are you talking about?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313507
    m_Localized: You're... weird.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313508
    m_Localized: 'Prorok: That''s how you look at it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313509
    m_Localized: 'Prorok: What do my words mean to you?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313510
    m_Localized: 'Prorok: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313511
    m_Localized: 'Prorok: Will you read my fortune from a book?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313512
    m_Localized: Open at the beginning. Top paragraph.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313513
    m_Localized: Open near the middle. Last paragraph.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313514
    m_Localized: 'Prorok: It''s even safer that way. For me, mostly, but still.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313515
    m_Localized: 'Prorok: It''s easier to preserve something from floods, fires, and time.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313516
    m_Localized: 'Prorok: Not every seed becomes a tree, eh.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313517
    m_Localized: 'Prorok: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313518
    m_Localized: 'Prorok: Will you read my fortune? Choose where I should open the book and read a line.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313519
    m_Localized: Open at the beginning. Top paragraph.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313520
    m_Localized: Open near the middle. Last paragraph.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313521
    m_Localized: 'Prorok: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313522
    m_Localized: 'Prorok: "The dead will come and tell. And he will not be believed."'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313523
    m_Localized: 'Prorok: What does that mean?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313524
    m_Localized: 'Prorok: I need to think now. Maybe I''ll see you later.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313525
    m_Localized: 'Window: On the path stands a man as pale as death itself.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313526
    m_Localized: 'Window: There are strange folds in his skin.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313527
    m_Localized: 'Window: This skin seems to be too big for him.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313528
    m_Localized: 'Window: You can''t see his eyes from here, but you can feel him drilling into you with his gaze.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313529
    m_Localized: 'Window: You feel fear and pray to God that the Visitor will avoid your house.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313530
    m_Localized: 'Window: There are bodies of teenagers on the ground.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313531
    m_Localized: 'Window: Someone killed them.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313532
    m_Localized: 'Window: It seems to be recent, because the blood hasn''t dried yet.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313533
    m_Localized: 'Window: The sight gives you goosebumps.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313534
    m_Localized: 'Window: Outside the window stands a neighbor and his daughter.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313535
    m_Localized: 'Window: They play happily together, forgetting the horror that is happening.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313536
    m_Localized: 'Window: Just for a moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313537
    m_Localized: 'Window: Watching this makes you remember your childhood and gives you a warm feeling of nostalgia.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313538
    m_Localized: 'Esenin: This is something humanity has never faced before.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313539
    m_Localized: 'Esenin: They just slap a label on something they don''t understand.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313540
    m_Localized: 'Esenin: As if this has never happened before.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313541
    m_Localized: 'Esenin: People are fundamentally flawed, what can you do.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313542
    m_Localized: 'Esenin: Thousands? Hundreds of thousands? Millions?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313543
    m_Localized: 'Esenin: Honestly, I have absolutely no idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313544
    m_Localized: 'Esenin: And no one will tell you, so you don''t piss your pants in fear.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313545
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313546
    m_Localized: 'Esenin: No matter what number you come up with, triple it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313547
    m_Localized: 'Esenin: That''s probably closer to the actual number of victims.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313548
    m_Localized: 'Esenin: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313549
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49639313550
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49639313551
    m_Localized: 'Esenin: Yeah? Did you want something?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313552
    m_Localized: Who are the Visitors?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313553
    m_Localized: How many victims are there?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313554
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49639313555
    m_Localized: 'Fan: I don''t think, I KNOW THE PLAIN TRUTH!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313556
    m_Localized: 'Fan: You ask me, who are the VISITORS?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313557
    m_Localized: 'Fan: So here, I''ll answer you...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313558
    m_Localized: 'Fan: They are, my hearty friend, VISITORS FROM OTHER PLANETS!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313559
    m_Localized: 'Fan: They are the descendants of aliens who came to Earth when the sun was younger and the grass was greener!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313560
    m_Localized: 'Fan: They planted them in the soil like sprouts of evil, and they have been growing for EIGHT YEARS!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313561
    m_Localized: 'Fan: And now they have crawled out and want to take OUR EARTH!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313562
    m_Localized: 'Fan: But the Sun has decided to protect us, for the sun is ANATHEMA to Visitors!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313563
    m_Localized: 'Fan: Otherwise why have they been hiding underground all this time?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313564
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313565
    m_Localized: 'Fan: Fuck, I wish I had a cold beer...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313566
    m_Localized: 'Fan: A LOT!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313567
    m_Localized: 'Fan: And believe me, my friend, this is FAR FROM OVER.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313568
    m_Localized: 'Fan: THIS IS JUST THE BEGINNING!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313569
    m_Localized: 'Fan: The scale has not yet balanced with the Universal Powers!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313570
    m_Localized: 'Fan: It takes MORE to be BURNED in the righteous flames of the SUN!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313571
    m_Localized: 'Fan: But know, my friend, these sacrifices will not be in vain!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313572
    m_Localized: 'Fan: Someday, we will all understand the true intentions of the sun-faced one...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313573
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313574
    m_Localized: 'Fan: Fuck, sometimes at night I really miss my wife...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313575
    m_Localized: 'Fan: She was a saintly woman...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313576
    m_Localized: 'Fan: But a real piece of work.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313577
    m_Localized: 'Fan: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313578
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49639313579
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49639313580
    m_Localized: 'Fan: I listen to your words human! SPEAK!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313581
    m_Localized: How do you recognize a Visitor?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313582
    m_Localized: What do you know about the cataclysm?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313583
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49639313584
    m_Localized: 'Holod: Mutated humans who have absorbed the anger of thousands of years.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313585
    m_Localized: 'Holod: They are our reflection.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313586
    m_Localized: 'Holod: Our antipodes, whom we would never want to see or know.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313587
    m_Localized: 'Holod: But they are there, and now we have to put up with them.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313588
    m_Localized: 'Holod: Enough to make you think about the end of the world.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313589
    m_Localized: 'Holod: I''m not happy about it, but I''m not sad about it either.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313590
    m_Localized: 'Holod: I don''t care what happens next.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313591
    m_Localized: 'Holod: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313592
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49639313593
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49639313594
    m_Localized: 'Holod: I wish I could be warm...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313595
    m_Localized: How do you recognize a Visitor?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313596
    m_Localized: What do you know about the cataclysm?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313597
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49639313598
    m_Localized: 'TV: In difficult times...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313599
    m_Localized: 'TV: When the hour of despair is near...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313600
    m_Localized: 'TV: And trust is hard to come by...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313601
    m_Localized: 'TV: There are those you can rely on!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313602
    m_Localized: 'TV: The Federal Emergency Management Agency (FEMA).'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313603
    m_Localized: 'TV: Hotline 04-5-1. You can trust us!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313604
    m_Localized: 'TV: Good morning, dear viewers! This is the morning news.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313605
    m_Localized: 'TV: Solar activity remains abnormal...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313606
    m_Localized: 'TV: ...and experts predict that it will continue to intensify.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313607
    m_Localized: 'TV: There are continuing reports from eyewitnesses about encounters with ''Visitors''.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313608
    m_Localized: 'TV: In response to this situation, authorities urgently ramped up FEMA operations.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313609
    m_Localized: 'TV: The Federal Emergency Management Agency, aka FEMA, are here to help.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313610
    m_Localized: 'TV: FEMA stuff members wear yellow hazmat suit.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313611
    m_Localized: 'TV: The recently established FEMA special committee have discovered a new indicator of ''Visitors''.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313612
    m_Localized: 'TV: The experts believe that besides teeth, ''Visitors'' can be identified by dirt under their nails.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313613
    m_Localized: 'TV: FEMA workers discovered this new symtpom during a routine inspection.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313614
    m_Localized: 'TV: Employees encountered what claimed to be a local nurse.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313615
    m_Localized: 'TV: But this supposedly clean healthcare providor couldn''t explain why she had so much dirt under her nails.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313616
    m_Localized: 'TV: Given that ''Visitors'' emerge from the ground, she was taken for testing, her status was confirmed.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313617
    m_Localized: 'TV: If you notice anyone resembling a ''Visitor'', promptly contact FEMA members or call the hotline at 04-5-1.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313618
    m_Localized: 'TV: Please stay alert and calm and avoid leaving your home during daylight hours.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313619
    m_Localized: 'TV: Now, let''s move on to other news...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313620
    m_Localized: 'Trevoga: Visitors?!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313621
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313622
    m_Localized: 'Trevoga: They''re terrifying, monstrous creatures that mimic humans!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313623
    m_Localized: 'Trevoga: Or maybe they skin people and wear it like a suit.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313624
    m_Localized: 'Trevoga: And all this just to get close to us...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313625
    m_Localized: 'Trevoga: God, I hope I never see what they truly look like!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313626
    m_Localized: 'Trevoga: Victims?!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313627
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313628
    m_Localized: 'Trevoga: THEY BURNED! ALL OF THEM BURNED!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313629
    m_Localized: 'Trevoga: TURNED TO ASH, EVERY SINGLE ONE!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313630
    m_Localized: 'Trevoga: ''CAUSE THEY STAYED OUT IN THE SUN!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313631
    m_Localized: 'Trevoga: GOD, WHAT DO WE DO NOW?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313632
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313633
    m_Localized: 'Trevoga: We''re all going to die...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313634
    m_Localized: 'Trevoga: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313635
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49639313636
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49639313637
    m_Localized: 'Trevoga: Uh-uh. Hopefully this will all be over soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313638
    m_Localized: How do you recognize a Visitor?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313639
    m_Localized: What do you know about the cataclysm?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313640
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49639313641
    m_Localized: 'Chmo: Oh, hey.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313642
    m_Localized: 'Chmo: You see what''s going on out there? Fucking hell.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313643
    m_Localized: 'Chmo: How''s it going here?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313644
    m_Localized: What do you need?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313645
    m_Localized: What's going on?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313646
    m_Localized: 'Chmo: Just curious, that''s all.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313647
    m_Localized: 'Chmo: Actually, I''ve got a little scheme, you could easily make some money.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313648
    m_Localized: 'Chmo: With the sun feeling so good, you can make money without even trying.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313649
    m_Localized: 'Chmo: With all the losers running around scared, you just need to hustle, bitch!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313650
    m_Localized: Why did you come to me?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313651
    m_Localized: What are you offering?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313652
    m_Localized: 'Chmo: New opportunities, can''t you fucking see?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313653
    m_Localized: 'Chmo: Everybody''s whining, panicing, fussing. But not you buddy.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313654
    m_Localized: 'Chmo: We should be chillin''. Having a good time, you know?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313655
    m_Localized: Why did you come to me?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313656
    m_Localized: What are you offering?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313657
    m_Localized: 'Chmo: You''re already in business!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313658
    m_Localized: 'Chmo: You''re gathering people. You''re doing something here. You''re making things happen.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313659
    m_Localized: 'Chmo: We''ll turn this into a celebration of life!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313660
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313661
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313662
    m_Localized: 'Chmo: Survive, what else is there?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313663
    m_Localized: 'Chmo: We gotta make plans while we can, to hell with the sun.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313664
    m_Localized: 'Chmo: Keep moving, you know? Let''s go, shall we?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313665
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313666
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49639313667
    m_Localized: 'Chmo: You''re an idiot. But whatever, I don''t give a shit about you, bitch.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313668
    m_Localized: 'Chmo: Fine, I''ll go to your neighbors then.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313669
    m_Localized: 'Chmo: Alright, see you later.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313670
    m_Localized: 'Chmo: Oh-oh-oh, now we''re talking.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313671
    m_Localized: 'Chmo: Finally, someone with some sense, bitch!'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313672
    m_Localized: 'Doctor: Oh, I thought no one was home.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313673
    m_Localized: 'Doctor: It''s so quiet at night.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313674
    m_Localized: 'Doctor: Hi! Can I come in?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313675
    m_Localized: Have you been watching the house?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313676
    m_Localized: Are you looking for something?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313677
    m_Localized: 'Doctor: What? Ahahahaha, no, of course not.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313678
    m_Localized: 'Doctor: It’s rare for a house full of people to be so quiet at night.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313679
    m_Localized: 'Doctor: Someone gets drunk and makes a ruckus.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313680
    m_Localized: 'Doctor: Someone stubs their toe and shouts.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313681
    m_Localized: 'Doctor: Someone screams with unbearable sorrow.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313682
    m_Localized: Who are you?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313683
    m_Localized: Where did you come from?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313684
    m_Localized: 'Doctor: Why would you think that?'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313685
    m_Localized: 'Doctor: No, I''m actually looking for something, but the same thing everyone else is.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313686
    m_Localized: 'Doctor: Safety and a way to kill time.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313687
    m_Localized: 'Doctor: And you guys are so quiet at night, I honestly didn’t think anyone slept here.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313688
    m_Localized: 'Doctor: So I thought I’d check if it’s okay to come in, but it was locked. I was about to knock before I tried breaking the door down.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313689
    m_Localized: Who are you?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313690
    m_Localized: Where did you come from?
    m_Metadata:
      m_Items: []
  - m_Id: 49639313691
    m_Localized: 'Doctor: I’m a doctor. The hospitals are overrun. I highly advise against going there.'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313692
    m_Localized: 'Doctor: My specialty is cardiac surgery, but...'
    m_Metadata:
      m_Items: []
  - m_Id: 49639313693
    m_Localized: 'Doctor: ...there wasn’t enough funding at our hospital. So I’ve had to wear many hats.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507712
    m_Localized: 'Doctor: Now I just go around helping whoever I can.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507713
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507714
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507715
    m_Localized: 'Doctor: There was a hospital in the center of town.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507716
    m_Localized: 'Doctor: We were flooded with patients. We just couldn''t handle them all.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507717
    m_Localized: 'Doctor: Some were Visitors...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507718
    m_Localized: 'Doctor: The situation spiraled so out of control that the entire hospital was shut down. It’s pure chaos in there now.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507719
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507720
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507721
    m_Localized: 'Doctor: I know it’s not a good time to trust strangers.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507722
    m_Localized: 'Doctor: If you’re lucky, I’ll be around when you need me, so feel free to reach out.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507723
    m_Localized: 'Doctor: I hope I can help someone.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507724
    m_Localized: 'Super: Hi!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507725
    m_Localized: 'Super: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507726
    m_Localized: Who are you?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507727
    m_Localized: Why are you here?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507728
    m_Localized: 'Super: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507729
    m_Localized: 'Super: How''s it goin'' here?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507730
    m_Localized: 'Super: Is everything okay?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507731
    m_Localized: Why are you ignoring my question?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507732
    m_Localized: Wait, what do you want?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507733
    m_Localized: 'Super: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507734
    m_Localized: 'Super: How''s it goin'' here?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507735
    m_Localized: 'Super: Is everything okay?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507736
    m_Localized: Why are you ignoring my question?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507737
    m_Localized: Wait, what do you want?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507738
    m_Localized: 'Super: Listen-a-a-ay. Are you alone in the house?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507739
    m_Localized: 'Super: Just curious. You''re like an old fortune teller, you know?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507740
    m_Localized: 'Super: Promising salvation to some, driving some away.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507741
    m_Localized: I have other people taking shelter here.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507742
    m_Localized: I'm alone.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507743
    m_Localized: 'Super: You''re lucky tonight.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507744
    m_Localized: 'Super: I can hear someone whispering in your rooms.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507745
    m_Localized: 'Super: But who knows what will happen tomorrow...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507746
    m_Localized: 'Super: Hahahahahaha.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507747
    m_Localized: 'Super: How come?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507748
    m_Localized: 'Super: It''s hard to be alone, what''s wrong with you?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507749
    m_Localized: 'Super: Come with me, young man.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507750
    m_Localized: 'Window: There is a group of armed soldiers outside the window.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507751
    m_Localized: 'Window: Apparently they are a small unit sent here from the city to provide security for the FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507752
    m_Localized: 'Window: You can only hear bits and pieces of phrases about a pale man with a bare torso.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507753
    m_Localized: 'Window: Maybe they want to track down that smiling man?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507754
    m_Localized: 'Window: You feel relieved that there are people ready to deal with the Visitors.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507755
    m_Localized: 'Window: The burned bodies of teenagers.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507756
    m_Localized: 'Window: They seem to have been lying here all day.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507757
    m_Localized: 'Window: Two emergency workers are standing next to the bodies and writing something down.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507758
    m_Localized: 'Window: It''s good that the authorities are removing the bodies.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507759
    m_Localized: 'Window: Rotting bodies are a vector for disease... no reason to make things worse.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507760
    m_Localized: 'Window: There is a small group of FEMA staff standing outside a neighbor''s house.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507761
    m_Localized: 'Window: I wonder what they are talking about?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507762
    m_Localized: 'Window: Maybe they''re taking soil samples?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507763
    m_Localized: 'Window: Or are they looking for a place to set up base?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507764
    m_Localized: 'Window: It makes you feel a little better to think that someone is trying to make sense of this nightmare.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507765
    m_Localized: 'Zhena: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507766
    m_Localized: 'Zhena: Can I rest at your place?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507767
    m_Localized: Where did you come from?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507768
    m_Localized: Where are you heading next?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507769
    m_Localized: 'Zhena: I don''t remember anymore. I don''t care.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507770
    m_Localized: 'Zhena: I''m very tired. If I don''t get some rest, I''ll collapse right here.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507771
    m_Localized: Is your partner sick?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507772
    m_Localized: Does your friend need help?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507773
    m_Localized: 'Zhena: I... I just want to fall down somewhere and never get up again.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507774
    m_Localized: 'Zhena: I don''t care where I end up.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507775
    m_Localized: Is your partner sick?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507776
    m_Localized: Does your friend need help?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507777
    m_Localized: 'Zhena: That''s my husband.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507778
    m_Localized: 'Zhena: He died.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507779
    m_Localized: 'Zhena: I can''t bury him properly now. It''s pointless to let him go.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507780
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507781
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507782
    m_Localized: 'Zhena: Not anymore. When he needed it, no one helped.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507783
    m_Localized: 'Zhena: Now he''s dead.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507784
    m_Localized: 'Zhena: He might be alive if...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507785
    m_Localized: 'Zhena: Anyone gave a shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507786
    m_Localized: Come on in.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507787
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507788
    m_Localized: 'Zhena: …'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507789
    m_Localized: 'Zhena: You…'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507790
    m_Localized: 'Zhena: I don''t think I''ll stay long.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507791
    m_Localized: 'Zhena: I just need a break.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507792
    m_Localized: 'Chmo: I know fucking nothing.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507793
    m_Localized: 'Chmo: I thought you knew.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507794
    m_Localized: 'Chmo: Yeah, maybe we shouldn''t give a fuck.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507795
    m_Localized: 'Chmo: What difference does it make if you can make money off of it?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507796
    m_Localized: 'Chmo: Fuck, that''s fucking awesome, no shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507797
    m_Localized: 'Chmo: Like, I''m really glad you let me in, you''re fucking awesome.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507798
    m_Localized: 'Chmo: Not like every other motherfucker in this house.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507799
    m_Localized: 'Chmo: You should have fucking told them to fuck off on the doorstep.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507800
    m_Localized: 'Chmo: I think it''s better to turn them in to FEMA and be done with it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507801
    m_Localized: 'Chmo: They''re just hogging space and food, anyways.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507802
    m_Localized: 'Chmo: But you''re the boss anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507803
    m_Localized: 'Chmo: And, as they say, the boss is the boss.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507804
    m_Localized: 'Chmo: Heh-heh-heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507805
    m_Localized: 'Chmo: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507806
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643507807
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643507808
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643507809
    m_Localized: 'Chmo: He-he. What''s up, bitch?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507810
    m_Localized: What's causing the cataclysm?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507811
    m_Localized: Do we need to stick together?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507812
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643507813
    m_Localized: 'Doctor: A really good question.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507814
    m_Localized: 'Doctor: I look at everything from a scientific point of view.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507815
    m_Localized: 'Doctor: But unfortunately we have no way of knowing what''s really going on.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507816
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507817
    m_Localized: 'Doctor: It would be interesting to know who the Visitors really are.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507818
    m_Localized: 'Doctor: If we live to see it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507819
    m_Localized: 'Doctor: I think so, but you can''t be too careful.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507820
    m_Localized: 'Doctor: Remembering what happened in the hospital, I''d hate to see it happen again.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507821
    m_Localized: 'Doctor: Man is a reasonable creature, but a crowd...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507822
    m_Localized: 'Doctor: A crowd is a stupid beast.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507823
    m_Localized: 'Doctor: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507824
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643507825
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643507826
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643507827
    m_Localized: 'Doctor: M-m?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507828
    m_Localized: What's causing the cataclysm?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507829
    m_Localized: Do we need to stick together?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507830
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643507831
    m_Localized: 'Esenin: I don''t have a clue.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507832
    m_Localized: 'Esenin: Although...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507833
    m_Localized: 'Esenin: I think the sun bursts have something to do with the Visitors.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507834
    m_Localized: 'Esenin: It''s no coincidence that they crawled out of the ground as soon as the cataclysm began.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507835
    m_Localized: 'Esenin: What if the guests want to replace us?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507836
    m_Localized: 'Esenin: And the burning sun is just a way to get rid of us?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507837
    m_Localized: 'Esenin: But on the whole, it doesn''t matter anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507838
    m_Localized: 'Esenin: Depends on your point of view.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507839
    m_Localized: 'Esenin: It''s hard to do it alone. You can''t survive without a group now.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507840
    m_Localized: 'Esenin: But on the other hand, because of the Visitors, it''s hard to trust people.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507841
    m_Localized: 'Esenin: How can you build a group if anyone can be a monster?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507842
    m_Localized: 'Esenin: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507843
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643507844
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643507845
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643507846
    m_Localized: 'Esenin: Yeah? Did you want something?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507847
    m_Localized: What's causing the cataclysm?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507848
    m_Localized: Do we need to stick together?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507849
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643507850
    m_Localized: 'Fan: The Sun has decided to punish us ALL for the sins that humans have been committing for THOUSANDS of years!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507851
    m_Localized: 'Fan: And the Visitors, THOSE FUCKING FUCKERS, began to reach out to the SUN!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507852
    m_Localized: 'Fan: But the Sun is not for them, the migrants of the underground, but for us, the PEOPLE!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507853
    m_Localized: 'Fan: It''s OURS!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507854
    m_Localized: 'Fan: OUR SAVIOR AND GLORIOUS PROTECTOR!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507855
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507856
    m_Localized: 'Fan: Fuck, my buddy Serega burned to death in the street because he was drunk and fell asleep outside...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507857
    m_Localized: 'Fan: Rest his soul, HOLY SUN, and accept him with open arms.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507858
    m_Localized: 'Fan: And, perhaps, the soul of his ficus, which he will no longer be able to water...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507859
    m_Localized: 'Fan: Amen.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507860
    m_Localized: 'Fan: The flock must stick together.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507861
    m_Localized: 'Fan: Otherwise how will the RIGHTEOUS ONE instruct everyone on the RIGHT path?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507862
    m_Localized: 'Fan: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507863
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643507864
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643507865
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643507866
    m_Localized: 'Fan: I''m listening to you, human! SPEAK!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507867
    m_Localized: What's causing the cataclysm?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507868
    m_Localized: Do we need to stick together?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507869
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643507870
    m_Localized: 'Holod: Because of people.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507871
    m_Localized: 'Holod: We are the only thing to blame for what''s going on.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507872
    m_Localized: 'Holod: I have nothing more to add.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507873
    m_Localized: 'Holod: I think we shouldn''t.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507874
    m_Localized: 'Holod: I have been hurt so much by people who follow the herd...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507875
    m_Localized: 'Holod: Who blindly see those who are different and then flatly reject, persecute, and humiliate them.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507876
    m_Localized: 'Holod: Is this place really so safe for me?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507877
    m_Localized: 'Holod: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507878
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643507879
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643507880
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643507881
    m_Localized: 'Holod: I wish I could get warm...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507882
    m_Localized: What's causing the cataclysm?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507883
    m_Localized: Do we need to stick together?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507884
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643507885
    m_Localized: 'TV: Attention! Emergency alert!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507886
    m_Localized: 'TV: Due to intense solar heat, wildfires have engulfed much of the country''s wooded and grassland areas.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507887
    m_Localized: 'TV: The extent of the fires is still hard to determine.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507888
    m_Localized: 'TV: However, it''s already apparent that humanity has never faced wildfires of this magnitude.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507889
    m_Localized: 'TV: All available fire crews have been deployed to the affected areas, but many firefighters have been pulled from duty due to encounters with "Visitors."'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507890
    m_Localized: 'TV: Now, let''s move on to other news...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507891
    m_Localized: 'TV: Good morning, dear viewers! This is the morning news.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507892
    m_Localized: 'TV: The valiant FEMA staff members have organized quarantine zones.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507893
    m_Localized: 'TV: Anyone showing signs of ''Visitors'' is directed to report to the closest FEMA zone.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507894
    m_Localized: 'TV: While some people express concerns that the identity of ''Visitors'' remains unknown...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507895
    m_Localized: 'TV: FEMA assures that they are merely sick people in need of assistance.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507896
    m_Localized: 'TV: Additionally, FEMA has identified a new indicator of ''Visitors'' — intensely irritated blood-red eyes.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507897
    m_Localized: 'TV: This information was discovered through experiments with detained ''Visitors''.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507898
    m_Localized: 'TV: According to FEMA experts, the irritation is caused by exposure to bright sunlight.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507899
    m_Localized: 'TV: Please stay alert and calm and avoid leaving your home during daylight hours.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507900
    m_Localized: 'TV: Now, let''s move on to other news...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507901
    m_Localized: 'Trevoga: Why?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507902
    m_Localized: 'Trevoga: I... I don''t know...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507903
    m_Localized: 'Trevoga: I really don''t know!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507904
    m_Localized: 'Trevoga: I DON''T KNOW!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507905
    m_Localized: 'Trevoga: GOD WHY ARE YOU DOING THIS TO US!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507906
    m_Localized: 'Trevoga: WHY ARE WE SUFFERING ALL THIS PAIN?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507907
    m_Localized: 'Trevoga: HAVE MERCY ON US, DESTROY THE SUN!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507908
    m_Localized: 'Trevoga: LEAVE THE DARKNESS AND THE COLD, PLEASE!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507909
    m_Localized: 'Trevoga: I CAN''T TAKE IT ANYMORE!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507910
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507911
    m_Localized: 'Trevoga: T-together?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507912
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507913
    m_Localized: 'Trevoga: Yeah.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507914
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507915
    m_Localized: 'Trevoga: Yes!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507916
    m_Localized: 'Trevoga: WE ALL SHOULD PRAY!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507917
    m_Localized: 'Trevoga: THIS WILL HELP, HE MUST HEAR US!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507918
    m_Localized: 'Trevoga: THE MORE MOUTHS — THE LOUDER THE PRAYER.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507919
    m_Localized: 'Trevoga: LORD HEAR US, WE WILL ALL PRAY TO YOU.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507920
    m_Localized: 'Trevoga: MAY THE SUN BURN OUT BEFORE WE DO.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507921
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507922
    m_Localized: 'Trevoga: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507923
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643507924
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643507925
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643507926
    m_Localized: 'Trevoga: O-o-oh. I hope it will be over soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507927
    m_Localized: What's causing the cataclysm?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507928
    m_Localized: Do we need to stick together?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507929
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643507930
    m_Localized: 'Zhena: I don''t care why the cataclysm is happening.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507931
    m_Localized: 'Zhena: I''m so tired of it all...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507932
    m_Localized: 'Zhena: Of this goddamn sun.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507933
    m_Localized: 'Zhena: Of these fucking Visitors.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507934
    m_Localized: 'Zhena: When will this endless hell finally end?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507935
    m_Localized: 'Zhena: May it burn us all to the ground!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507936
    m_Localized: 'Zhena: II wish it would all end already... I don''t care how anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507937
    m_Localized: 'Zhena: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507938
    m_Localized: 'Zhena: I don''t know, I''m sorry.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507939
    m_Localized: 'Zhena: It''s hard for me to think right now.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507940
    m_Localized: 'Zhena: I just want to take a little rest, that''s all...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507941
    m_Localized: 'Zhena: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507942
    m_Localized: 'Zhena: Let me rest, please, I''m really tired.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507943
    m_Localized: 'Zhena: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507944
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643507945
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643507946
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643507947
    m_Localized: 'Zhena: I need to get some rest...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507948
    m_Localized: What's causing the cataclysm?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507949
    m_Localized: Do we need to stick together?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507950
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643507951
    m_Localized: 'Doch: H-hello.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507952
    m_Localized: 'Doch: Let me in.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507953
    m_Localized: Are you hysterical?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507954
    m_Localized: Did something happen?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507955
    m_Localized: 'Doch: I-don''t-know-what-to-do.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507956
    m_Localized: 'Doch: People-ee-ee-ee-ee.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507957
    m_Localized: 'Doch: A-a-a-a-a-a-a-a-a-a-a-a-a.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507958
    m_Localized: 'Doch: Kill-lee-lee-da...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507959
    m_Localized: 'Doch: A-a-a-a-a-a-a-a-a-a-a-a-a.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507960
    m_Localized: 'Doch: Da-dad.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507961
    m_Localized: Who did this? Drink some water.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507962
    m_Localized: Why did they do that? Drink some water.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507963
    m_Localized: 'Doch: Ah-ah-ah-ah-ah-ah-ah-ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507964
    m_Localized: 'Doch: My-my- dad-dy....'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507965
    m_Localized: 'Doch: Ah-ah-ah-ah-ah-ah-ah-ah-ah-ah-ah-ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507966
    m_Localized: 'Doch: Killed my d-d-dad.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507967
    m_Localized: Who did this? Drink some water.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507968
    m_Localized: Why did they do that? Drink some water.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507969
    m_Localized: 'Doch: We had vi-Visitors. They s-sat in our room.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507970
    m_Localized: 'Doch: Daddy was t-t-talking to them about something. And then they killed him.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507971
    m_Localized: 'Doch: Aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaah.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507972
    m_Localized: 'Doch: Our house is n-n-now on f-f-fire.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507973
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507974
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507975
    m_Localized: 'Doch: I don''t-I don''t know.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507976
    m_Localized: 'Doch: They were quietly sit-t-t-ting with daddy in the kitchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507977
    m_Localized: 'Doch: And then they d-d-d-did something, and then they s-s-s-set the house on fire.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507978
    m_Localized: 'Doch: While I was r-r-running, they were just laughing.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507979
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507980
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49643507981
    m_Localized: 'Doch: Where am I gonna go-o-ooooo?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507982
    m_Localized: 'Doch: Aaaaaaaaaaaaaaah.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507983
    m_Localized: 'Doch: AAAAAAAAAAAAAAAAAAAAAAAA!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507984
    m_Localized: 'Doch: I''M SO SCA-A-ARE-E-E-ED!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507985
    m_Localized: 'Doch: C-c-c-can you h-help me?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507986
    m_Localized: 'Doch: I''m scared-d-d.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507987
    m_Localized: 'Himoza: Good night.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507988
    m_Localized: 'Himoza: I''m from the FEMA crew, we''re here to help you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507989
    m_Localized: You came alone?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507990
    m_Localized: How can I trust you?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507991
    m_Localized: 'Himoza: No, of course not.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507992
    m_Localized: 'Himoza: Our crew is going door-to-door in the neighborhood. We''re splitting up to get the job done faster.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507993
    m_Localized: 'Himoza: I won''t be staying long.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507994
    m_Localized: Why are you wearing a hazmat suit? Is there some kind of contamination?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507995
    m_Localized: How will you help us?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507996
    m_Localized: 'Himoza: You must have seen the news. We were there.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507997
    m_Localized: 'Himoza: I can also show you my ID.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643507998
    m_Localized: Why are you wearing a hazmat suit? Is there some kind of contamination?
    m_Metadata:
      m_Items: []
  - m_Id: 49643507999
    m_Localized: How will you help us?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508000
    m_Localized: 'Himoza: There''s no reason to be afraid. The suit is in case we catch the sunrise.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508001
    m_Localized: 'Himoza: Civilians don''t need it now, just stay home.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508002
    m_Localized: 'Himoza: We''ll take care of you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508003
    m_Localized: What's next?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508004
    m_Localized: Do you have an action plan?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508005
    m_Localized: 'Himoza: First we have to investigate the surrounding area.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508006
    m_Localized: 'Himoza: Based on the results, management will formulate our next steps.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508007
    m_Localized: 'Himoza: You just need to wait a little.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508008
    m_Localized: What's next?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508009
    m_Localized: Do you have an action plan?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508010
    m_Localized: 'Himoza: I will take one of your guests for examination. I''ll have them back soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508011
    m_Localized: 'Himoza: That should tell us if you all have been exposed to solar radiation.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508012
    m_Localized: 'Himoza: It doesn''t matter who you pick, it can be anyone.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508013
    m_Localized: What's next?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508014
    m_Localized: Do I have to pack too?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508015
    m_Localized: 'Himoza: Of course. It''s not like we can act spontaneously.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508016
    m_Localized: 'Himoza: We''ll take one of your guests with us for examination.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508017
    m_Localized: 'Himoza: Since solar radiation contamination spreads, we only need to check one of you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508018
    m_Localized: 'Himoza: Based on that, we''ll decide if you all need help.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508019
    m_Localized: 'Himoza: It doesn''t matter who you pick, it can be anyone.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508020
    m_Localized: What's next?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508021
    m_Localized: Do I have to pack too?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508022
    m_Localized: 'Himoza: Wait.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508023
    m_Localized: 'Himoza: Either we will evacuate you all, or we''ll bring your guest back to shelter here.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508024
    m_Localized: 'Himoza: We will issue instructions either way.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508025
    m_Localized: 'Himoza: Don''t worry, I''ll keep them safe.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508026
    m_Localized: 'Himoza: Goodbye.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508027
    m_Localized: 'Himoza: No, as the owner of the house, you stay here for now.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508028
    m_Localized: 'Himoza: We''ll take your guest away for testing, then report the situation to our superiors.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508029
    m_Localized: 'Himoza: We''ll issue instructions shortly after.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508030
    m_Localized: 'Himoza: Don''t worry, I''ll keep them safe.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508031
    m_Localized: 'Himoza: Goodbye.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508032
    m_Localized: 'Mama: Hey!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508033
    m_Localized: 'Mama: Anybody home?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508034
    m_Localized: Who are you?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508035
    m_Localized: Looking for someone?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508036
    m_Localized: 'Mama: I used to live a couple of blocks away.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508037
    m_Localized: 'Mama: We were evicted from our homes by those bastards in the yellow suits.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508038
    m_Localized: 'Mama: The told us we had to evacuate, but didn''t even tell us how! Where should we go? What should we do?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508039
    m_Localized: 'Mama: While everyone''s figuring out where to go, I''m here trying to save myself.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508040
    m_Localized: Why did they kick you out?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508041
    m_Localized: How many of you left?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508042
    m_Localized: 'Mama: I''m not looking for anyone. I just need a place to hide.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508043
    m_Localized: 'Mama: The whole neighborhood has been kicked out, and no one knows where to go.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508044
    m_Localized: 'Mama: Now I''m just doing my best to make it to another sunrise.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508045
    m_Localized: Why did they kick you out?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508046
    m_Localized: How many of you left?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508047
    m_Localized: 'Mama: They said there was a big solar flare or something over our neighborhood.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508048
    m_Localized: 'Mama: Then the yellow suits kicked us out. They grabbed some people, said they were taking them for tests.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508049
    m_Localized: 'Mama: Everyone else was just... left to figure it out.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508050
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508051
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508052
    m_Localized: 'Mama: I''m telling you, the whole house!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508053
    m_Localized: 'Mama: Some people resisted. It didn''t matter. There were just too many of them...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508054
    m_Localized: 'Mama: I''d reckon they nabbed about half of us. They didn''t chase the rest of us too much.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508055
    m_Localized: 'Mama: Well, now I have to survive somehow.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508056
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508057
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508058
    m_Localized: 'Mama: Well, don''t open the door to those yellow ones anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508059
    m_Localized: 'Mama: Not that you seem to open the door for anyone anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508060
    m_Localized: 'Mama: HAHAHAHAHAHAHAHAHA.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508061
    m_Localized: 'Mama: I''ll bring my people back with me and help keep you safe, ahahahahahahaha.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508062
    m_Localized: 'Mama: Yeah, thanks. Don''t open the door to those yellow ones, okay?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508063
    m_Localized: 'Mama: They''re taking us somewhere...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508064
    m_Localized: 'Ohota: Hey, how''s it going around here?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508065
    m_Localized: 'Ohota: I''m not from around here. Not really from anywhere. I don''t like staying in one place too long.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508066
    m_Localized: 'Ohota: Can''t roam around as much anymore, though. I''m getting too old for that.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508067
    m_Localized: Why do you travel?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508068
    m_Localized: What are you looking for here?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508069
    m_Localized: 'Ohota: Yeah, those very ones. Have you seen what the Visitors do to people?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508070
    m_Localized: 'Ohota: Families torn apart in their homes. Tortured. Massacred. Every room a slaughterhouse.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508071
    m_Localized: 'Ohota: They pretend to be one of us. Then those demons unleash hell.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508072
    m_Localized: 'Ohota: We need to wipe out the Visitors.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508073
    m_Localized: Do you want to kill the Visitors?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508074
    m_Localized: Where's your weapon against the Visitors?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508075
    m_Localized: 'Ohota: In town? I just want to rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508076
    m_Localized: 'Ohota: After this damned sunburst, the Visitors started popping up more, crawling everywhere.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508077
    m_Localized: 'Ohota: I''m telling you: we need to snuff them out. They''re have dark designs.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508078
    m_Localized: Do you want to kill the Visitors?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508079
    m_Localized: Where's your weapon against the Visitors?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508080
    m_Localized: 'Ohota: Aren’t you doing the same thing?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508081
    m_Localized: 'Ohota: Or do you just tell ''em to ''shoo''? You''re not stupid, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508082
    m_Localized: 'Ohota: You kick them out, but tomorrow they''ll tear you apart and won’t even remember your name, get it?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508083
    m_Localized: 'Ohota: You gotta be careful with ''em, that’s the thing.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508084
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508085
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508086
    m_Localized: 'Ohota: I had a gun. I almost got myself killed.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508087
    m_Localized: 'Ohota: They waited till I was asleep in the tent and took it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508088
    m_Localized: 'Ohota: I was running, they were shooting. That''s the kind of fun they have.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508089
    m_Localized: 'Ohota: There''s nothing human but a shell.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508090
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508091
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508092
    m_Localized: 'Ohota: And good. Maybe you''re a Visitor yourself.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508093
    m_Localized: 'Ohota: You could have slit my throat in the night.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508094
    m_Localized: 'Ohota: You know, I’ll give these Visitors a run for their money. You''ll be amazed.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508095
    m_Localized: 'Ohota: I knew you weren’t a pushover. A real man.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508096
    m_Localized: 'Ohota: We''ll take the fight to these Visitors. They won''t won''t dream to fuck with us.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508097
    m_Localized: 'Volk: Hello.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508098
    m_Localized: 'Volk: What a mess. Did you see that?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508099
    m_Localized: 'Volk: What kind of society is this? The beasts around here are revealed.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508100
    m_Localized: 'Volk: Finally, nobody''s pretending.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508101
    m_Localized: What do you mean?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508102
    m_Localized: Are you one of the beasts?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508103
    m_Localized: 'Volk: Haven''t you been to other houses? Have you even stepped outside?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508104
    m_Localized: 'Volk: All those polite parts of society aren''t worth shit anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508105
    m_Localized: 'Volk: Might makes right now. If you can outfight others, you can establish order.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508106
    m_Localized: Where have you been staying? Move around a lot?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508107
    m_Localized: How have you survived all this time?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508108
    m_Localized: 'Volk: We''re all the same beast.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508109
    m_Localized: 'Volk: If you deny it too long, you''ll be eaten alive. No bones left.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508110
    m_Localized: 'Volk: The new order is: the strongest is right.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508111
    m_Localized: 'Volk: Whoever thinks otherwise will be dead tomorrow.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508112
    m_Localized: Where have you been staying? Move around a lot?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508113
    m_Localized: How have you survived all this time?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508114
    m_Localized: 'Volk: I haven''t stayed anywhere a long time.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508115
    m_Localized: 'Volk: Everywhere I go, I see chaos. Fear blinds people to so many things.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508116
    m_Localized: 'Volk: You still have some order here. That''s interesting, I''d like to see you keep it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508117
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508118
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508119
    m_Localized: 'Volk: Careful. Curiosity killed the cat, afterall.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508120
    m_Localized: 'Volk: I don''t ask you how you live, you don''t ask me how I live.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508121
    m_Localized: 'Volk: The main thing is that I won''t be a problem for you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508122
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508123
    m_Localized: You better leave.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508124
    m_Localized: 'Volk: Ahhhh. So that''s how it is.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508125
    m_Localized: 'Volk: Wait for some news.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508126
    m_Localized: 'Volk: An intelligent decision.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508127
    m_Localized: 'Volk: Force now rules your life. Accept it or get out of the way.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508128
    m_Localized: 'Window: The entire squad of soldiers who were here yesterday are dead.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508129
    m_Localized: 'Window: The bodies are strewn all over the street. One is missing a head.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508130
    m_Localized: 'Window: Did that pale, smiling stranger kill them all?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508131
    m_Localized: 'Window: You are horrified by this picture of carnage, and you feel in danger.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508132
    m_Localized: 'Window: A pale creepy man stands in the road and smiles.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508133
    m_Localized: 'Window: He has someone''s severed head in his hand, wearing a helmet.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508134
    m_Localized: 'Window: It''s a soldier''s head with a grimace of horror frozen on his face.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508135
    m_Localized: 'Window: You are very uncomfortable with what you see.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508136
    m_Localized: 'Window: A neighbor''s house, which was recently painted white, burned to the ground and is now completely black.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508137
    m_Localized: 'Window: The fire seems to have died down recently.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508138
    m_Localized: 'Window: Did someone set it on fire on purpose?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508139
    m_Localized: 'Window: What happened to the neighbor''s family?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508140
    m_Localized: 'Window: Did anyone survive?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508141
    m_Localized: 'Window: Why did they burn the house down?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508142
    m_Localized: 'Window: Your head is filled with anxious thoughts and a feeling of incomprehensible helplessness.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508143
    m_Localized: 'Chmo: They rule, what''s the question?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508144
    m_Localized: 'Chmo: I think the FEMA guys are doing the right thing.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508145
    m_Localized: 'Chmo: Taking out the motherfuckers that deserve to die.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508146
    m_Localized: 'Chmo: The other day I saw through the window they took my neighbor.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508147
    m_Localized: 'Chmo: They did the right thing I reckon, that fucker borrowed a lot of money from me and never paid it back.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508148
    m_Localized: 'Chmo: Fuck, I wish I could join FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508149
    m_Localized: 'Chmo: Pf-f-f-f-ha-ha-ha-ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508150
    m_Localized: 'Chmo: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508151
    m_Localized: 'Chmo: Wait, you don''t mean cum?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508152
    m_Localized: 'Chmo: Oh, you mean the fuckery going on.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508153
    m_Localized: 'Chmo: Well...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508154
    m_Localized: 'Chmo: Fuck knows why?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508155
    m_Localized: 'Chmo: Well, yeah, the sun''s hot, it''s blazing, but all bad things come to an end sooner or later.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508156
    m_Localized: 'Chmo: So I think the sun''s gonna run out soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508157
    m_Localized: 'Chmo: And without it, it won''t be hot outside anymore, and we can live peacefully as before.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508158
    m_Localized: 'Chmo: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508159
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643508160
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643508161
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643508162
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 49643508163
    m_Localized: 'Chmo: He-he. What''s up, bitch?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508164
    m_Localized: What do you think about FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508165
    m_Localized: Is the end near?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508166
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643508167
    m_Localized: 'Doch: I do-don''t know-ow-ow who that is.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508168
    m_Localized: 'Doch: Mommy...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508169
    m_Localized: 'Doch: Thi-this wouldn''t have happened if it weren''t for those ev-evil people.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508170
    m_Localized: 'Doch: Ah-ah-ah-ah-ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508171
    m_Localized: 'Doch: Th-the end?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508172
    m_Localized: 'Doch: I... I don''t wa-want to die!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508173
    m_Localized: 'Doch: Ah-ah-ah-ah-ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508174
    m_Localized: 'Doch: Mo-mommy-ah-ah-ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508175
    m_Localized: 'Doch: Ah-ah-ah-ah-ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508176
    m_Localized: 'Doch: I want to be with you, mom-ah-ah-ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508177
    m_Localized: 'Doch: Ah-ah-ah-ah-ha-ah-ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508178
    m_Localized: 'Doch: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508179
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643508180
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643508181
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643508182
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 49643508183
    m_Localized: 'Doch: I... I want my mam-ma.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508184
    m_Localized: What do you think about FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508185
    m_Localized: Is the end near?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508186
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643508187
    m_Localized: 'Doctor: I have a more positive than negative view of them.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508188
    m_Localized: 'Doctor: It''s good that there’s an organization trying to manage the situation.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508189
    m_Localized: 'Doctor: Even though not everyone agrees with FEMA’s methods.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508190
    m_Localized: 'Doctor: I''d like to think not.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508191
    m_Localized: 'Doctor: Humanity has faced numerous disasters, always teetering on the edge.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508192
    m_Localized: 'Doctor: And each time, people have summoned the strength to keep fighting.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508193
    m_Localized: 'Doctor: Even when all hope seemed lost and the end appeared imminent.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508194
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508195
    m_Localized: 'Doctor: I''d like to believe that this time, too, humanity will overcome the calamity that has struck us.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508196
    m_Localized: 'Doctor: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508197
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643508198
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643508199
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643508200
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 49643508201
    m_Localized: 'Doctor: M-m?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508202
    m_Localized: What do you think about FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508203
    m_Localized: Is the end near?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508204
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643508205
    m_Localized: 'Esenin: You mean the fuckers in yellow?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508206
    m_Localized: 'Esenin: They are inhuman beasts with no will of their own.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508207
    m_Localized: 'Esenin: They hide in yellow cocoons with masks and think they''re in charge.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508208
    m_Localized: 'Esenin: They take everyone who even slightly shows signs of being a Visitor.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508209
    m_Localized: 'Esenin: I wouldn''t piss on one if they were on fire.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508210
    m_Localized: 'Esenin: What is the point of this question?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508211
    m_Localized: 'Esenin: Do you want me to comfort you?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508212
    m_Localized: 'Esenin: Nah, take a sober look at the situation.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508213
    m_Localized: 'Esenin: If not the end, then its a fucking cataclysm at least.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508214
    m_Localized: 'Esenin: Is there anything we can do?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508215
    m_Localized: 'Esenin: I think we should have done something earlier. But now it''s over.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508216
    m_Localized: 'Esenin: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508217
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643508218
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643508219
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643508220
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 49643508221
    m_Localized: 'Esenin: Yeah? Did you want something?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508222
    m_Localized: What do you think about FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508223
    m_Localized: Is the end near?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508224
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643508225
    m_Localized: 'Fan: FEMA are the damned heretic!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508226
    m_Localized: 'Fan: They interfere in processes that WE, THE PEOPLE, have no control over!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508227
    m_Localized: 'Fan: They stick their noses where they don''t belong.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508228
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508229
    m_Localized: 'Fan: Those fuckers who threw my mother into a puddle.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508230
    m_Localized: 'Fan: The end for whom?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508231
    m_Localized: 'Fan: For us?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508232
    m_Localized: 'Fan: Ha-ha-ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508233
    m_Localized: 'Fan: Don''t make me laugh, the SUN IS ON OUR SIDE!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508234
    m_Localized: 'Fan: It''s helping us, can''t you see that?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508235
    m_Localized: 'Fan: It smokes out the Visitors who try to come up from the ground.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508236
    m_Localized: 'Fan: We should thank it, not start trumpeting the end of the world.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508237
    m_Localized: 'Fan: THIS IS THE END FOR THEM, THE FUCKING VISITORS!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508238
    m_Localized: 'Fan: DESTROY THE IMMIGRANTS OF THE UNDERGROUND!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508239
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508240
    m_Localized: 'Fan: Fuck, it''s been a long time since I''ve had fried potatoes...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508241
    m_Localized: 'Fan: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508242
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643508243
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643508244
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643508245
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 49643508246
    m_Localized: 'Fan: I''m listening to you, human! SPEAK!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508247
    m_Localized: What do you think about FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508248
    m_Localized: Is the end near?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508249
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643508250
    m_Localized: 'Holod: I don''t trust them.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508251
    m_Localized: 'Holod: They have so much power over people''s lives.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508252
    m_Localized: 'Holod: They can take anyone they see as a Visitor.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508253
    m_Localized: 'Holod: They''ll take me too, sooner or later.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508254
    m_Localized: 'Holod: All in good time.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508255
    m_Localized: 'Holod: Closer than ever.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508256
    m_Localized: 'Holod: The last page in our story is almost turned.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508257
    m_Localized: 'Holod: I suppose I should be scared that the end is near...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508258
    m_Localized: 'Holod: But it''s foreign to me, and I''m not afraid of death.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508259
    m_Localized: 'Holod: But if it does decide to do the reaping, at least let it not delay it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508260
    m_Localized: 'Holod: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508261
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643508262
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643508263
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643508264
    m_Localized: Holod
    m_Metadata:
      m_Items: []
  - m_Id: 49643508265
    m_Localized: 'Holod: I just can''t get warm...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508266
    m_Localized: What do you think about FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508267
    m_Localized: Is the end near?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508268
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643508269
    m_Localized: 'Mama: What can we do about it?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508270
    m_Localized: 'Mama: It''s not our problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508271
    m_Localized: 'Mama: They kill, and that''s the end of it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508272
    m_Localized: 'Mama: You just have to be careful about who you let in.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508273
    m_Localized: 'Mama: You might accidentally let in a Visitor.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508274
    m_Localized: 'Mama: What''s the difference?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508275
    m_Localized: 'Mama: As long as no one''s bothering us — that''s good enough.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508276
    m_Localized: 'Mama: Do you really care about the rest?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508277
    m_Localized: 'Mama: Let the Visitors pass by. And those in yellow too. Don''t let them in.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508278
    m_Localized: 'Mama: Being alive is good enough. And as for being human — who cares?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508279
    m_Localized: 'Mama: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508280
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643508281
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643508282
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643508283
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 49643508284
    m_Localized: 'Mama: Oh, son, please don''t let anyone in.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508285
    m_Localized: What do you think about killing?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508286
    m_Localized: Do we still have much humanity left?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508287
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643508288
    m_Localized: 'Ohota: FEMA — they''re nice fellas.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508289
    m_Localized: 'Ohota: They do the same thing I do — track Visitors.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508290
    m_Localized: 'Ohota: But I think it''s a waste of time to be gentle with ''em and put ''em in quarantine zones.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508291
    m_Localized: 'Ohota: They''re only making it worse, because they can band together.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508292
    m_Localized: 'Ohota: Better to wipe ''em out one by one.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508293
    m_Localized: 'Ohota: A good Visitor is a dead Visitor.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508294
    m_Localized: 'Ohota: I believe the end will come if we don''t stop the Visitors.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508295
    m_Localized: 'Ohota: These damned beasts want to deceive us and sneak in behind our backs.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508296
    m_Localized: 'Ohota: Slaughter us one by one, under cover of the night, while we sleep.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508297
    m_Localized: 'Ohota: They will get to you. Sooner or later.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508298
    m_Localized: 'Ohota: But that won''t happen if you kill the Visitor before he kills you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508299
    m_Localized: 'Ohota: You can''t be on the defensive. You have to be on the hunt. Find him first.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508300
    m_Localized: 'Ohota: You''ve already let so many people in. One must be a Visitor.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508301
    m_Localized: 'Ohota: But all is not lost!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508302
    m_Localized: 'Ohota: Start looking for ''em right now, and maybe you''ll take ''em by surprise.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508303
    m_Localized: 'Ohota: And most importantly, don''t hesitate!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508304
    m_Localized: 'Ohota: Track ''em down, finish ''em off!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508305
    m_Localized: 'Ohota: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508306
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643508307
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643508308
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643508309
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 49643508310
    m_Localized: 'Ohota: Keep your eyes open. The Visitor could be any one of us.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508311
    m_Localized: What do you think about FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508312
    m_Localized: Is the end near?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508313
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643508314
    m_Localized: 'TV: Attention! Emergency alert!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508315
    m_Localized: 'TV: In light of recent events, compassionate individuals have stepped up to provide humanitarian aid.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508316
    m_Localized: 'TV: Volunteers are distributing food and offering shelter to those in need.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508317
    m_Localized: 'TV: They assert that their activities are completely independent of FEMA and are solely focused on helping others.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508319
    m_Localized: 'TV: Stay tuned for updates.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508320
    m_Localized: 'TV: Good morning, dear viewers! This is the morning news.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508321
    m_Localized: 'TV: FEMA continues to identify new signs of ''Visitors''.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508322
    m_Localized: 'TV: According to their data, attempts to photograph ''Visitors'' result in severe blurring in the photos.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508323
    m_Localized: 'TV: This effect can only be observed with film cameras.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508324
    m_Localized: 'TV: Unfortunately, the reasons for this phenomenon have not been determined yet.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508325
    m_Localized: 'TV: However, FEMA urges citizens to use this new information to identify ''Visitors''.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508326
    m_Localized: 'TV: Please stay alert and calm and avoid leaving your home during daylight hours.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508327
    m_Localized: 'TV: Now, let''s move on to other news...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508328
    m_Localized: 'Trevoga: FEMA?! WHERE?!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508329
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508330
    m_Localized: 'Trevoga: Are they not here?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508331
    m_Localized: 'Trevoga: Please don''t say the name, or they will come.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508332
    m_Localized: 'Trevoga: I shudder at the mention of them.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508333
    m_Localized: 'Trevoga: I''m wildly afraid that one day they''ll come for me and take me away.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508334
    m_Localized: 'Trevoga: But I don''t want... I don''t want to be taken to a quarantine zone.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508335
    m_Localized: 'Trevoga: No one ever came back from there.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508336
    m_Localized: 'Trevoga: It''s scary to imagine what the people in the yellow suits do to those taken away.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508337
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508338
    m_Localized: 'Trevoga: The END?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508339
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508340
    m_Localized: 'Trevoga: THE END?!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508341
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508342
    m_Localized: 'Trevoga: NO, IT CAN''T BE!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508343
    m_Localized: 'Trevoga: ONLY NOT THE END!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508344
    m_Localized: 'Trevoga: WE WILL ALL DIE IN SUFFERING AND AGONY!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508345
    m_Localized: 'Trevoga: LORD SAVE US ALL!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508346
    m_Localized: 'Trevoga: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508347
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643508348
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643508349
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643508350
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 49643508351
    m_Localized: 'Trevoga: O-o-oh. I hope it will be over soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508352
    m_Localized: What do you think about FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508353
    m_Localized: Is the end near?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508354
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643508355
    m_Localized: 'Volk: They are bloodthirsty hunters, determined to herd us like cattle.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508356
    m_Localized: 'Volk: Don''t be fooled by their appearance — they are wolves in sheep''s clothing.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508357
    m_Localized: 'Volk: At first, they just sniff around with questions, pretending to fill out their damn reports.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508358
    m_Localized: 'Volk: But the moment they smell the right kind of meat, they''ll bite.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508359
    m_Localized: 'Volk: And people, like lambs to the slaughter, obediently follow.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508360
    m_Localized: 'Volk: Don''t trust these vicious wolves.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508361
    m_Localized: 'Volk: The end will come when every human being becomes an enemy of each other.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508362
    m_Localized: 'Volk: We are not far from this.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508363
    m_Localized: 'Volk: That''s why we need to stay in the pack. A pack is a good thing.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508364
    m_Localized: 'Volk: But keep your eyes open.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508365
    m_Localized: 'Volk: Any pack will fall apart without a strong leader.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508366
    m_Localized: 'Volk: A leader must be willing to make any sacrifice for his pack, including killing.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508367
    m_Localized: 'Volk: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508368
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643508369
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643508370
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643508371
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 49643508372
    m_Localized: 'Volk: Do you have a question for me?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508373
    m_Localized: What do you think about FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508374
    m_Localized: Is the end near?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508375
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643508376
    m_Localized: 'Zhena: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508377
    m_Localized: 'Zhena: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508378
    m_Localized: 'Zhena: If it weren''t for FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508379
    m_Localized: 'Zhena: My husband... He would still be alive...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508380
    m_Localized: 'Zhena: I don''t think about anything anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508381
    m_Localized: 'Zhena: That''s a pointless question.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508382
    m_Localized: 'Zhena: Everyone already knows. Yes, it''s the end.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508383
    m_Localized: 'Zhena: And nothing can be changed, nothing can be fixed.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508384
    m_Localized: 'Zhena: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508385
    m_Localized: 'Zhena: Damn the fucking sun.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508386
    m_Localized: 'Zhena: And damn these fucking Visitors.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508387
    m_Localized: 'Zhena: What do you want to check?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508388
    m_Localized: Teeth
    m_Metadata:
      m_Items: []
  - m_Id: 49643508389
    m_Localized: Hands
    m_Metadata:
      m_Items: []
  - m_Id: 49643508390
    m_Localized: Eyes
    m_Metadata:
      m_Items: []
  - m_Id: 49643508391
    m_Localized: Photo
    m_Metadata:
      m_Items: []
  - m_Id: 49643508392
    m_Localized: 'Zhena: I need to get some rest...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508393
    m_Localized: What do you think about FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508394
    m_Localized: Is the end near?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508395
    m_Localized: I need to check on you
    m_Metadata:
      m_Items: []
  - m_Id: 49643508396
    m_Localized: 'Himoza: Good evening.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508397
    m_Localized: 'Himoza: We''re with the FEMA team. We need to do a survey of your neighborhood.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508398
    m_Localized: The man you took isn't enough?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508399
    m_Localized: What about the last survey?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508400
    m_Localized: 'Himoza: Last one?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508401
    m_Localized: 'Himoza: Oh, that. The examination procedure is quite exhausting, right now your man is in rehabilitation.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508402
    m_Localized: 'Himoza: After he rests, we''ll bring him back right away.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508403
    m_Localized: Do you want to take someone else?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508404
    m_Localized: Why was one not enough?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508405
    m_Localized: 'Himoza: The results are too mixed.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508406
    m_Localized: 'Himoza: The sample was too small.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508407
    m_Localized: Do you want to take someone else?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508408
    m_Localized: Why was one not enough?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508409
    m_Localized: 'Himoza: Yes. I''m afraid one person was not enough to understand the situation.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508410
    m_Localized: 'Himoza: We''ll need one more person from your house.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508411
    m_Localized: 'Himoza: Anyone will do. Thank you for your cooperation.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508412
    m_Localized: All right. If there's no other way.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508413
    m_Localized: No, I'm not interested in those examinations.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508414
    m_Localized: 'Himoza: The sample is too small.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508415
    m_Localized: 'Himoza: The boss first said to take one at a time. But now we can see that we need more.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508416
    m_Localized: 'Himoza: So we''re collecting another round.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508417
    m_Localized: All right. If there's no other way.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508418
    m_Localized: No, I'm not interested in those examinations.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508419
    m_Localized: 'Himoza: Yeah, there''s no other way.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508420
    m_Localized: 'Himoza: It''s all for your own safety.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508421
    m_Localized: 'Himoza: You don''t get it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508422
    m_Localized: 'Himoza: We didn''t give you a choice. We''re just doing our job.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508423
    m_Localized: 'Himoza: You can''t say no.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508424
    m_Localized: 'Himoza: We''ll do what we need to do and leave.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508425
    m_Localized: 'Prorok: It''s a miracle we''ve lived to see this day.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508426
    m_Localized: 'Prorok: But what comes next is a terrible secret.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508427
    m_Localized: You're back.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508428
    m_Localized: How have you survived all this time?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508429
    m_Localized: 'Prorok: It''s not for long.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508430
    m_Localized: 'Prorok: I just walk around and observe what''s happening, how the world is changing.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508431
    m_Localized: 'Prorok: And I don''t yet feel that the glaciers are going to melt anytime soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508432
    m_Localized: 'Prorok: Looks like we''re in for birds raining from the sky.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508433
    m_Localized: What does that mean?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508434
    m_Localized: Do you think things will get worse?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508435
    m_Localized: 'Prorok: That''s not the problem you should be worrying about. But thanks.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508436
    m_Localized: 'Prorok: And I don''t yet feel that the glaciers are going to melt anytime soon.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508437
    m_Localized: 'Prorok: Looks like we''re in for birds raining from the sky.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508438
    m_Localized: What does that mean?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508439
    m_Localized: Do you think things will get worse?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508440
    m_Localized: 'Prorok: You tell me.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508441
    m_Localized: 'Prorok: Is this supposed to be the end?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508442
    m_Localized: 'Prorok: Or are we yet to smell more gunpowder?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508443
    m_Localized: 'Prorok: I can''t see beyond my own nose anymore. Probably nothing to wait for.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508444
    m_Localized: What should we do?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508445
    m_Localized: What about other people?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508446
    m_Localized: 'Prorok: Is there any point in thinking?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508447
    m_Localized: 'Prorok: I don''t think we should bother our heads with it now.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508448
    m_Localized: 'Prorok: Whether you keep talking or hide people, it''s all the same.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508449
    m_Localized: 'Prorok: I have no thoughts on what to do.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508450
    m_Localized: What should we do?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508451
    m_Localized: What about other people?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508452
    m_Localized: 'Prorok: I don''t know. I''ll just keep watching. That''s all I can do.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508453
    m_Localized: 'Prorok: What will you do?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508454
    m_Localized: 'Prorok: Why do you need this knowledge?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508455
    m_Localized: 'Prorok: No matter how much we''ve looked at others, we''ve got nothing but caricatures.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508456
    m_Localized: 'Super: We meet again.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508457
    m_Localized: 'Super: What do you think of that one in the suit?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508458
    m_Localized: He's doing his job.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508459
    m_Localized: I don't know how to feel about him.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508460
    m_Localized: 'Super: All right.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508461
    m_Localized: 'Super: These are the times, aren''t they? You''ve got to be careful. Is that okay?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508462
    m_Localized: I'm kind of busy, so can you come back later?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508463
    m_Localized: Can you leave?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508464
    m_Localized: 'Super: What''s not to know?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508465
    m_Localized: 'Super: Okay, anyway I don''t care.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508466
    m_Localized: I'm kind of busy, so can you come back later?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508467
    m_Localized: Can you leave?
    m_Metadata:
      m_Items: []
  - m_Id: 49643508468
    m_Localized: 'Super: I understand, of course.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508469
    m_Localized: 'Super: I''ll come back later.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508470
    m_Localized: 'Super: Just...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508471
    m_Localized: 'Super: Say, are you alone in the house?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508472
    m_Localized: I have other people taking shelter here.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508473
    m_Localized: I'm alone.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508474
    m_Localized: 'Super: Yeah, sure. I didn''t realize you don''t like talking to me.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508475
    m_Localized: 'Super: Just first...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508476
    m_Localized: 'Super: Are you alone in the house right now?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508477
    m_Localized: I have other people taking shelter here.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508478
    m_Localized: I'm alone.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508479
    m_Localized: 'Super: That''s it?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508480
    m_Localized: 'Super: You''re all alone, the sun has burned everyone you knew.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508481
    m_Localized: 'Super: You''ve either got nobody at home or my boys.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508482
    m_Localized: 'Super: How did this happen? Did you turn out to be the most vicious beast?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508483
    m_Localized: 'Super: Well...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508484
    m_Localized: 'Super: Come here, you''re gonna get what you deserve.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508485
    m_Localized: 'Super: Getting ready? Do you know what you''re getting ready for?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508486
    m_Localized: 'Super: It''s the last days. Didn''t they tell you?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508487
    m_Localized: 'Super: Dogs rule the world. And only dogs will be here.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508488
    m_Localized: 'Super: Have a good stay.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508489
    m_Localized: 'Window: There is a dead man hanging suspended from a lamppost with a sign around his neck.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508490
    m_Localized: 'Window: It says, “Visitors are not welcome.”'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508491
    m_Localized: 'Window: Looks like the poor guy was mistaken for a Visitor and killed in a lynching.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508492
    m_Localized: 'Window: The thought of violence engulfing a once peaceful and quiet town breaks your heart and makes you long for quieter times.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508493
    m_Localized: 'Window: You see a stake with a helmeted skull on it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508494
    m_Localized: 'Window: There''s some black burnt skin left on the skull, and the teeth look like someone pulled them out.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508495
    m_Localized: 'Window: The head has been here all day.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508496
    m_Localized: 'Window: The whole grim display looks like a threat, surely left by that smiling pale Visitor.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508497
    m_Localized: 'Window: You''re looking at your neighbor''s house.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508498
    m_Localized: 'Window: Only a ghostly silhouette remains.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508499
    m_Localized: 'Window: You''re devastated by what you''ve seen.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508500
    m_Localized: 'Window: It seems to disturb you even more to realize that it''s not the evil Visitors who are to blame, but people with paranoia.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508501
    m_Localized: 'Window: It brings you anxiety.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508502
    m_Localized: 'Ending: It is no longer safe to live on the surface of the earth.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508503
    m_Localized: 'Ending: You board up all the windows and barricade the doors.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508504
    m_Localized: 'Ending: After conferring with your tenants, you decide not to go out into the outside world anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508505
    m_Localized: 'Ending: You pray helplessly that someday this will all be over.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508506
    m_Localized: 'Ending: If this nightmare ever ends.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508507
    m_Localized: 'Ending: But hope is still alive.... At least for now...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508508
    m_Localized: 'Ending: It is no longer safe to live on the surface of the earth.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508509
    m_Localized: 'Ending: You board up all the windows and barricade the doors.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508510
    m_Localized: 'Ending: After conferring with your tenants, you decide not to go out into the outside world anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508511
    m_Localized: 'Ending: You pray helplessly that someday this will all be over.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508512
    m_Localized: 'Ending: If this nightmare ever ends.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508513
    m_Localized: 'Ending: At the very least, you have peace of mind knowing that there are only humans under your roof.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508514
    m_Localized: 'Ending: It is no longer safe to live on the surface of the earth.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508515
    m_Localized: 'Ending: You board up all the windows and barricade the doors.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508516
    m_Localized: 'Ending: After conferring with your tenants, you decide not to go out into the outside world anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508517
    m_Localized: 'Ending: You pray helplessly that someday this will all be over.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508518
    m_Localized: 'Ending: If this nightmare ever ends.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508519
    m_Localized: 'Ending: Or it''s just a relatively oprimistic dream you''re having'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508520
    m_Localized: 'Ending: In fact, your body was mutilated by Visitors.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508521
    m_Localized: 'Ending: Who, given the opportunity to experience emotions, would only be glad to receive such a gift.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508522
    m_Localized: 'Ending: Just one day short of.....'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508523
    m_Localized: 'Ending: It is no longer safe to live on the surface of the earth.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508524
    m_Localized: 'Ending: You board up all the windows and barricade the doors.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508525
    m_Localized: 'Ending: After conferring with your tenants, you decide not to go out into the outside world anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508526
    m_Localized: 'Ending: You pray helplessly that someday this will all be over.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508527
    m_Localized: 'Ending: If this nightmare ever ends.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508528
    m_Localized: 'Ending: But hope is still alive.... At least for now...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508529
    m_Localized: 'Ending: Fortunately, you have a keen eye for guests.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508530
    m_Localized: 'Ending: Not one of them crossed the threshold of your refuge.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508531
    m_Localized: 'Ending: At least a drop of honey in the barrel of tar of the current events.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508532
    m_Localized: 'Ending: It is no longer safe to live on the surface of the earth.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508533
    m_Localized: 'Ending: You board up all the windows and barricade the doors.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508534
    m_Localized: 'Ending: After conferring with your tenants, you decide not to go out into the outside world anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508535
    m_Localized: 'Ending: However, they started looking at you strangely.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508536
    m_Localized: 'Ending: You live too fast, trying to get through this nightmare as quickly as possible.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508537
    m_Localized: 'Ending: Is it worth it to constantly rush, abstracting yourself from the horror of the outside world?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508538
    m_Localized: 'Ending: Perhaps.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508539
    m_Localized: 'Ending: The main thing is not to forget to live, to find the beauty in life and to enjoy it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508540
    m_Localized: 'Ending: You''ve done a lot for those you let in.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508541
    m_Localized: 'Ending: But too much blood has been spilled.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508542
    m_Localized: 'Ending: You are too dangerous to stay in this house, you must leave.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508543
    m_Localized: 'Ending: You are being driven out of your own home by people fearing for their safety.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508544
    m_Localized: 'Ending: You didn''t last a day, burned in the streets by the scorching sun.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508545
    m_Localized: 'Ending: No one will know what happened when the last guest arrived.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508546
    m_Localized: 'Ending: The house is left unoccupied for a long time.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508547
    m_Localized: 'Ending: After your terrible disappearance, everyone avoids the abandoned house. '
    m_Metadata:
      m_Items: []
  - m_Id: 49643508548
    m_Localized: 'Doch: Can you look inside my eye?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508549
    m_Localized: 'Doch: Will you see everything I''m thinking there?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508550
    m_Localized: 'Doch: I''ll be careful what I think then, don''t worry.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508551
    m_Localized: 'Doch: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508552
    m_Localized: 'Doch: Why did you look like that?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508553
    m_Localized: 'Doch: You saw ooh-ooh-ooh there...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508554
    m_Localized: 'Doch: You... waaaah.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508555
    m_Localized: 'Doch: I-I-I-I wanna dri-ink.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508556
    m_Localized: 'Doch: And I know how to cut my own nails already.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508557
    m_Localized: 'Doch: I''m not very good at it yet, I...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508558
    m_Localized: 'Doch: Look.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508559
    m_Localized: 'Doch: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508560
    m_Localized: 'Doch: Look at those nails.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508561
    m_Localized: 'Doch: I cut them myself. I did it. I did it!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508562
    m_Localized: 'Doch: I''m going to go sit alone.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508567
    m_Localized: 'Doch: Photo?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508568
    m_Localized: 'Doch: I''m not really into photo... photougafy... photography!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508569
    m_Localized: 'Doch: Will you show me a photo later?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508570
    m_Localized: 'Doch: (You''re taking a picture of a girl)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508571
    m_Localized: 'Doch: (The photo came out a little blurry)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508572
    m_Localized: 'Doch: (The girl ran up to you without waiting for the end of the photo shoot)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508573
    m_Localized: 'Doch: Mmmm.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508574
    m_Localized: 'Doch: Thank you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508575
    m_Localized: 'Doch: I didn''t like it. Don''t ask me to take any more pictures.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508576
    m_Localized: 'Doch: Teeth? Show you my teeth?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508577
    m_Localized: 'Doch: Why? My teeth are still baby teeth. Daddy said...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508578
    m_Localized: 'Doch: I won''t cry anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508579
    m_Localized: 'Doch: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508580
    m_Localized: 'Doch: This is what I have.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508581
    m_Localized: 'Doch: What does that mean?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508582
    m_Localized: 'Doch: It''s all right, isn''t it?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508583
    m_Localized: 'Doctor: Huh, yeah, I’ll show you my eyes.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508584
    m_Localized: 'Doctor: Not sure if you’ve noticed, but I have polycoria.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508585
    m_Localized: 'Doctor: That’s what it means.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508586
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508587
    m_Localized: 'Doctor: My vision is actually worse because of it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508588
    m_Localized: 'Doctor: You’d think having two pupils in one eye would be handy!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508589
    m_Localized: 'Doctor: But... alas.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508590
    m_Localized: 'Doctor: Yes, I''ve operated on so many people with these hands...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508591
    m_Localized: 'Doctor: I could tell you so many stories, but maybe another time.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508592
    m_Localized: 'Doctor: Now, please look.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508593
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508594
    m_Localized: 'Doctor: I try to keep these arms toned so I don’t slack off.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508595
    m_Localized: 'Doctor: Who knows what tomorrow might bring?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508596
    m_Localized: 'Doctor: Okay, no problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508597
    m_Localized: 'Doctor: I understand that we need to check all the symptoms.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508598
    m_Localized: 'Doctor: (You''re taking pictures of the doctor)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508599
    m_Localized: 'Doctor: (Nothing out of the ordinary)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508600
    m_Localized: 'Doctor: I''ve been told I have an unusual appearance.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508601
    m_Localized: 'Doctor: What do you think?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508602
    m_Localized: 'Doctor: Thank you, my teeth are fine.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508603
    m_Localized: 'Doctor: Ah, it''s the Visitor signs you''re asking about.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508604
    m_Localized: 'Doctor: Sure, look.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508605
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508606
    m_Localized: 'Doctor: Perfect, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508607
    m_Localized: 'Doctor: I had a friend of mine fix them free.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508608
    m_Localized: 'Doctor: A trade for an operation many years ago.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508609
    m_Localized: 'Doctor: I wonder how he is now?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508610
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508611
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508612
    m_Localized: 'Doctor: If you want, we can fix your teeth too.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508613
    m_Localized: 'Doctor: For cheap, of course, since you helped me out.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508614
    m_Localized: 'Doctor: Once all this sun madness is over, that is.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508615
    m_Localized: 'Doctor: Wait, what?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508616
    m_Localized: 'Doctor: You''re making a mistake, I heal people!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508617
    m_Localized: 'Doctor: And you''re about to kill a man...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508618
    m_Localized: 'Esenin: Every day gets more surreal.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508619
    m_Localized: 'Esenin: What if I didn’t sleep well? Or if I cried?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508620
    m_Localized: 'Esenin: I can’t make sense of how this all works anymore.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508621
    m_Localized: 'Esenin: What do you do if one sign checks out? Or several?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508622
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508623
    m_Localized: 'Esenin: Now I’m going to be a ''Visitor'' tonight.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508624
    m_Localized: 'Esenin: I’ll go and cry, I’ll reminisce about the peaceful times.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508625
    m_Localized: 'Esenin: Where did they even come from?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508626
    m_Localized: 'Esenin: Dirt under the fingernails? Is that supposed to be a sign?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508627
    m_Localized: 'Esenin: They can just wash their hands! That’s all it takes!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508628
    m_Localized: 'Esenin: So what, every gardener is a Visitor now?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508629
    m_Localized: 'Esenin: That’s ridiculous.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508630
    m_Localized: 'Esenin: Look at the nails.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508631
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508632
    m_Localized: 'Esenin: Well, am I a Visitor?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508633
    m_Localized: 'Esenin: Of course not.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508634
    m_Localized: 'Esenin: All these tests. Men in yellow jumpsuits outside...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508635
    m_Localized: 'Esenin: All of this... somehow.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508636
    m_Localized: 'Esenin: It''s so fucked up.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508637
    m_Localized: 'Esenin: Don’t you get the feeling that we''re headed towards some kind of terrifying hell?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508638
    m_Localized: 'Esenin: Everything is allegedly in order but everywhere we look... madness...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508639
    m_Localized: 'Esenin: Well, take a picture, come on.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508640
    m_Localized: 'Esenin: (You''re taking a picture of the person you''re talking to)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508641
    m_Localized: 'Esenin: (He''s sitting quietly, he doesn''t fit in the frame, but you don''t see anything unusual)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508642
    m_Localized: 'Esenin: I''m just scared of what will happen next.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508643
    m_Localized: 'Esenin: Do you want to see my teeth?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508644
    m_Localized: 'Esenin: Well, look at them. They still have the taste of unhappiness and smoke on them.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508645
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508646
    m_Localized: 'Esenin: Yellowish, huh?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508647
    m_Localized: 'Esenin: Well, don''t fuck with me with your tests.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508648
    m_Localized: 'Esenin: I''m not a Visitor.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508649
    m_Localized: 'Fan: LOOK INTO MY DARK EYES!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508650
    m_Localized: 'Fan: I absorb all the blessings of light with them, transforming energy from them.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508651
    m_Localized: 'Fan: I get all my strength from my EYES!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508652
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508653
    m_Localized: 'Fan: DID YOU SEE THE TRUE POWER OF THE SUN IN MY EYES?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508654
    m_Localized: 'Fan: If not, you''re just blind. Try looking at the sun for a longer time AS I do.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508655
    m_Localized: 'Fan: No taboo, my friend!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508656
    m_Localized: 'Fan: Watch my nails as long as you like.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508657
    m_Localized: 'Fan: I''ve trained myself to get useful sunlight with them.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508658
    m_Localized: 'Fan: And open beers.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508659
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508660
    m_Localized: 'Fan: Did you, uh, just want to check it out?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508661
    m_Localized: 'Fan: I thought... uh, you''re just an evil man!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508662
    m_Localized: 'Fan: Take a picture?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508663
    m_Localized: 'Fan: Hm-hm-hm-hm-hm.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508664
    m_Localized: 'Fan: Did someone tell you that I said hello to the SOLAR LEADER himself?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508665
    m_Localized: 'Fan: Yes, I taught him how to look at the sun, but I''ll tell you that sometime later.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508666
    m_Localized: 'Fan: Come on, TAKE A PICTURE OF ME!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508667
    m_Localized: 'Fan: (You''re taking a picture of a sloppy man)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508668
    m_Localized: 'Fan: (Just like in life, in the picture he is ungroomed and dirty)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508669
    m_Localized: 'Fan: (You don''t notice any distortion)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508670
    m_Localized: 'Fan: What a great job you did!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508671
    m_Localized: 'Fan: Come to me, I''ll tell you about my life.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508672
    m_Localized: 'Fan: And you will give me some money for it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508673
    m_Localized: 'Fan: THIS IS FOR SAVING THE SUN''S ENERGY!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508674
    m_Localized: 'Fan: Show you my teeth?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508675
    m_Localized: 'Fan: AND I''VE STOOD UP FOR MY TRUTHS WITH THEM!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508676
    m_Localized: 'Fan: I''ve defended all my truths.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508677
    m_Localized: 'Fan: See for yourself what I''m really doing here.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508678
    m_Localized: 'Fan: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508679
    m_Localized: 'Fan: I save my teeth with beer, it''s good for calcium.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508680
    m_Localized: 'Fan: Without it, you''d have lost your teeth long ago.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508681
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508682
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508683
    m_Localized: 'Fan: Understandable, of course.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508684
    m_Localized: 'Fan: There''s so much going on right now, but we live on.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508685
    m_Localized: 'Fan: We live on.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508686
    m_Localized: 'Fan: Are you sitting in the shade too long?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508687
    m_Localized: 'Fan: Lay down and rest, my friend.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508688
    m_Localized: 'Holod: Now the eyes are a window to hell, not the soul.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508689
    m_Localized: 'Holod: My soul burned out long ago. That’s probably why I feel so cold.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508690
    m_Localized: 'Holod: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508691
    m_Localized: 'Holod: Pupils constricted?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508692
    m_Localized: 'Holod: I guess that’s because I’m cold.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508693
    m_Localized: 'Holod: Too bad the sun scorches me like the others.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508694
    m_Localized: 'Holod: I’d like to at least feel its warmth.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508695
    m_Localized: 'Holod: Nails? I’ll show you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508696
    m_Localized: 'Holod: Hmm. Looks like I chipped them all or something.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508697
    m_Localized: 'Holod: But take a look anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508698
    m_Localized: 'Holod: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508699
    m_Localized: 'Holod: Do you think my fingernails fit the sign of a Visitor?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508700
    m_Localized: 'Holod: Got it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508701
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508702
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508703
    m_Localized: 'Holod: You know, I''m so tired of living.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508704
    m_Localized: 'Holod: But you decided not to kill me.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508705
    m_Localized: 'Holod: Meanwhile, in the other houses, someone must have killed someone, I guess.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508706
    m_Localized: 'Holod: Why is it like that? Ever wonder?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508707
    m_Localized: 'Holod: You know what?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508708
    m_Localized: 'Holod: I think I''ve figured out why I always feel so cold.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508709
    m_Localized: 'Holod: How can anything be detected by a photo?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508710
    m_Localized: 'Holod: Don’t you find that odd?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508711
    m_Localized: 'Holod: But it''s not really up to me. Sure, go ahead and take a picture.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508712
    m_Localized: 'Holod: (You''re taking a picture of the person you''re talking to)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508713
    m_Localized: 'Holod: (The photo shows the body and clothing indistinctly, as if a large shiver went through the person during the photo shoot)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508714
    m_Localized: 'Holod: Sorry, I flinched during the flash.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508715
    m_Localized: 'Holod: Can we try that again?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508716
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508717
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508718
    m_Localized: 'Holod: What do you think, how many more signs will they come up with before they realize what needs to be done in the first place?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508719
    m_Localized: 'Holod: Why is it absolutely necessary to kill someone?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508720
    m_Localized: 'Holod: Or was it not necessary after all?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508721
    m_Localized: 'Holod: I have nothing to lose.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508722
    m_Localized: 'Holod: Although, wait, I want to show you...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508723
    m_Localized: 'Holod: Mm, teeth?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508724
    m_Localized: 'Holod: If it helps in any way, sure, look.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508725
    m_Localized: 'Holod: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508726
    m_Localized: 'Holod: What do we do now?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508727
    m_Localized: 'Holod: I got it now.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508728
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508729
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508730
    m_Localized: 'Holod: Thank you for your trust.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508731
    m_Localized: 'Holod: I hope I can be of service.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508732
    m_Localized: 'Holod: There''s something eating me up, but I can''t put it into words yet. Sorry.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508733
    m_Localized: 'Holod: Are you gonna shoot, though?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508734
    m_Localized: 'Holod: Wait, before you do that, I''ll show you...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508735
    m_Localized: 'Attention: You smell rot and death. Someone was murdered last night.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508736
    m_Localized: 'Attention: It sounds like there are "Visitors" in the house.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508737
    m_Localized: 'Attention: Better be on the lookout and check people more carefully for signs of "Visitors".'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508738
    m_Localized: 'Mama: I always have burst blood vessels in my eyes.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508739
    m_Localized: 'Mama: I don''t know how you''re going to determine if I''m a Visitor.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508740
    m_Localized: 'Mama: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508741
    m_Localized: 'Mama: What are you gonna do?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508742
    m_Localized: 'Mama: Well...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508743
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508744
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508745
    m_Localized: 'Mama: Of course, how could that be a sign?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508746
    m_Localized: 'Mama: It would be terrible to make a mistake and accidentally kill someone.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508747
    m_Localized: 'Mama: How many times have you been wrong? Do you take responsibility for such killings?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508748
    m_Localized: 'Mama: Well, shoot me in the eyes.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508749
    m_Localized: 'Mama: It won’t help you, tomorrow they will come knocking on your windows!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508750
    m_Localized: 'Mama: Or the sun will finally burn your eyes out!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508751
    m_Localized: 'Mama: That''s where we''re gonna have a problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508752
    m_Localized: 'Mama: Old age, son.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508753
    m_Localized: 'Mama: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508754
    m_Localized: 'Mama: I don''t remember what this disease is called, but my nails are coming off now.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508755
    m_Localized: 'Mama: It''s painful and unpleasant.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508756
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508757
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508758
    m_Localized: 'Mama: What''s the point of shooting a sick person?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508759
    m_Localized: 'Mama: You could certainly put me out of my misery.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508760
    m_Localized: 'Mama: But I''d still suffer for a while, hahaha.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508761
    m_Localized: 'Mama: Go ahead, shoot.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508762
    m_Localized: 'Mama: After me, they''ll come and finish you and your whole crew.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508763
    m_Localized: 'Mama: You''ve doomed everyone to death, hahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508764
    m_Localized: 'Mama: It’s been a long time since I was last photographed.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508765
    m_Localized: 'Mama: Go ahead, why not?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508766
    m_Localized: 'Mama: (You''re taking a picture of the person you''re talking to)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508767
    m_Localized: 'Mama: (You purposely hold still and wait for the moment)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508768
    m_Localized: 'Mama: (When the photo shows up, you can see that it''s blurry. Completely)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508769
    m_Localized: 'Mama: Why can''t you see me well?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508770
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508771
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508772
    m_Localized: 'Mama: Can I keep it to myself?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508773
    m_Localized: 'Mama: I don’t even have any photos left.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508774
    m_Localized: 'Mama: Try it, they’ll smear you too.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508775
    m_Localized: 'Mama: Just like I''m smeared in the photo, HAHAHAHA.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508776
    m_Localized: 'Mama: Hahahahaha, what teeth, son?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508777
    m_Localized: 'Mama: Well, look what isn''t there.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508778
    m_Localized: 'Mama: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508779
    m_Localized: 'Mama: So what?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508780
    m_Localized: 'Mama: Did I pass your test?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508781
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508782
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508783
    m_Localized: 'Mama: You be careful with that stuff.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508784
    m_Localized: 'Mama: Waving that around is gonna make people feel awfully nervous.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508785
    m_Localized: 'Mama: You don''t always have that gun in your hand, do you?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508786
    m_Localized: 'Mama: And fuck you!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508787
    m_Localized: 'Mama: THEY''RE ALL GONNA BITE YOU AS SOON AS YOU SLEEP.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508788
    m_Localized: 'Ohota: You know, I once had color in my eyes.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508789
    m_Localized: 'Ohota: But this life leaves you with nothing but gray.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508790
    m_Localized: 'Ohota: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508791
    m_Localized: 'Ohota: But I''ll get them all. I''ll tear them apart with my hands.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508792
    m_Localized: 'Ohota: Then we''ll live in peace again.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508793
    m_Localized: 'Ohota: Okay, let''s do it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508794
    m_Localized: 'Ohota: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508795
    m_Localized: 'Ohota: Of course my hands will be dirty, I go out at night to dig up these devils.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508796
    m_Localized: 'Ohota: It''s even easier to kill them that way!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508797
    m_Localized: 'Ohota: I suggest you do the same.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508798
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508799
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508800
    m_Localized: 'Ohota: You bet!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508801
    m_Localized: 'Ohota: Are you gonna go strangle the Visitors tonight, too?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508802
    m_Localized: 'Ohota: Let''s go hunt them down.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508803
    m_Localized: 'Ohota: If you''re going to throw me out, put me close to these.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508804
    m_Localized: 'Ohota: I''m scared.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508805
    m_Localized: 'Ohota: I don''t really like taking pictures.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508806
    m_Localized: 'Ohota: The flash reminds me of a thunderstorm, it makes me panic.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508807
    m_Localized: 'Ohota: No, you didn''t get it, I''m not taking pictures.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508808
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508809
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508810
    m_Localized: 'Ohota: Thanks for understanding.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508811
    m_Localized: 'Ohota: You know, I don''t like that stuff. The pictures, the sudden flashes, the sounds.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508812
    m_Localized: 'Ohota: Brrrrrrr.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508813
    m_Localized: 'Ohota: I''m not interested.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508814
    m_Localized: 'Ohota: No, wait!'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508815
    m_Localized: 'Ohota: Ay, fuck it, I''m running.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508816
    m_Localized: 'Ohota: Teeth? All right, let me show you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508817
    m_Localized: 'Ohota: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508818
    m_Localized: 'Ohota: Wait, now what?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508819
    m_Localized: 'Ohota: God damn.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508820
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508821
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508822
    m_Localized: 'Ohota: I know, stress and all.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508823
    m_Localized: 'Ohota: But it''s the Visitors we''re supposed to be killing, not each other.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508824
    m_Localized: 'Ohota: It''s about time you came to your senses.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508825
    m_Localized: 'Ohota: Holy shit.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508826
    m_Localized: 'Ohota: That''s the irony — my gun taken from me, to die at the barrel of yours.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508827
    m_Localized: 'Trevoga: Do you want to check my eyes?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508828
    m_Localized: 'Trevoga: I''m guessing what the result will be.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508829
    m_Localized: 'Trevoga: What would happen if I matched this sign?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508830
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508831
    m_Localized: 'Trevoga: You bet. Could it be otherwise.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508832
    m_Localized: 'Trevoga: Are you gonna kill me? Too bad I''ll never know what happens to us all.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508833
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508834
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508835
    m_Localized: 'Trevoga: Am I really a Visitor? What do you think?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508836
    m_Localized: 'Trevoga: Why wouldn''t I know that?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508837
    m_Localized: 'Trevoga: Maybe we just convince ourselves we are monsters. To become monsters.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508838
    m_Localized: 'Trevoga: It''s scary to die.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508839
    m_Localized: 'Trevoga: Wait, can I get a blindfold first?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508840
    m_Localized: 'Trevoga: Or stand a little longer, at least.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508841
    m_Localized: 'Trevoga: Show you fingernails? An interesting symptom, for sure...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508842
    m_Localized: 'Trevoga: Yeah, let''s see.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508843
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508844
    m_Localized: 'Trevoga: What''s on them? It can''t be dirt.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508845
    m_Localized: 'Trevoga: I-I-I don''t even remember digging...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508846
    m_Localized: 'Trevoga: Maybe someone got me dirty?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508847
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508848
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508849
    m_Localized: 'Trevoga: How did I get this dirt?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508850
    m_Localized: 'Trevoga: It''s not like I haven''t showered in days. Yes?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508851
    m_Localized: 'Trevoga: That''s... weird.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508852
    m_Localized: 'Trevoga: Is this the end of my life?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508853
    m_Localized: 'Trevoga: What a... shame.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508854
    m_Localized: 'Trevoga: You changed your mind, didn''t you?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508855
    m_Localized: 'Trevoga: If it turns out I''m a Visitor, will I start killing people?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508856
    m_Localized: 'Trevoga: Will I become dangerous? Or have I always been?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508857
    m_Localized: 'Trevoga: Maybe I do kill people?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508858
    m_Localized: 'Trevoga: (You''re taking a picture of the person you''re talking to)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508859
    m_Localized: 'Trevoga: (When the photo shows up, you see a blurred body and a clear background)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508860
    m_Localized: 'Trevoga: (It was as if at the moment of the photo, the person jerked violently)'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508861
    m_Localized: 'Trevoga: Hahaha, can you believe it?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508862
    m_Localized: 'Trevoga: What''s gonna happen now?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508863
    m_Localized: 'Trevoga: Can I live? Or is it better to kill me? What are you gonna do?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508864
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508865
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49643508866
    m_Localized: 'Trevoga: Why?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508867
    m_Localized: 'Trevoga: Wouldn''t it be easier to shoot me already?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508868
    m_Localized: 'Trevoga: I want to leave, but I''m too scared.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508869
    m_Localized: 'Trevoga: Maybe...'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508870
    m_Localized: 'Trevoga: I don''t know.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508871
    m_Localized: 'Trevoga: What if you shoot me and I actually become something even more horrible?'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508872
    m_Localized: 'Trevoga: Maybe I should run away.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508873
    m_Localized: 'Trevoga: But I don''t know, what if I''m still a human being.'
    m_Metadata:
      m_Items: []
  - m_Id: 49643508874
    m_Localized: 'Trevoga: What should I do?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284928
    m_Localized: 'Trevoga: Huh, are you going to make decisions based on teeth? Uh-oh.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284929
    m_Localized: 'Trevoga: I''ve had my teeth fixed recently.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284930
    m_Localized: 'Trevoga: Although, to be honest...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284931
    m_Localized: 'Trevoga: I can''t remember when I''ve been to the dentist. Have I even been to one?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284932
    m_Localized: 'Trevoga: God, I can''t even remember what I ate yesterday.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284933
    m_Localized: 'Trevoga: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284934
    m_Localized: 'Trevoga: Does that... Do I fit the description?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284935
    m_Localized: 'Trevoga: That can''t be...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284936
    m_Localized: 'Trevoga: I can''t be a Visitor. Yes?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284937
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49660284938
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49660284939
    m_Localized: 'Trevoga: No, it''s just a coincidence, right? How can I be a Visitor?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284940
    m_Localized: 'Trevoga: It can''t be...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284941
    m_Localized: 'Trevoga: It can''t be, can it?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284942
    m_Localized: 'Trevoga: I remember my life, nothing in it ...nothing like that.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284943
    m_Localized: 'Trevoga: Thank you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284944
    m_Localized: 'Trevoga: No, please don''t!'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284945
    m_Localized: 'Trevoga: So I''m a Visitor? How? HOW? Don''t do this!'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284946
    m_Localized: 'Volk: Are you looking for a stranger in me?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284947
    m_Localized: 'Volk: Aren''t you afraid to see your reflection in my eyes?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284948
    m_Localized: 'Volk: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284949
    m_Localized: 'Volk: I''m impressed.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284950
    m_Localized: 'Volk: Not everyone can stand my gaze.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284951
    m_Localized: 'Volk: Want to hear about my hands?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284952
    m_Localized: 'Volk: Yeah, I''ve had to kill recently.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284953
    m_Localized: 'Volk: They tried to kill me. I''m not just going to stand by and wait to be killed.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284954
    m_Localized: 'Volk: Some people freeze in danger, others run.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284955
    m_Localized: 'Volk: I''m the type who fights back.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284956
    m_Localized: 'Volk: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284957
    m_Localized: 'Volk: So, what now? You gonna shoot me?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284958
    m_Localized: 'Volk: Really?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284959
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49660284960
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49660284961
    m_Localized: 'Volk: I could be faster than you.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284962
    m_Localized: 'Volk: And then I''ll have the gun.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284963
    m_Localized: 'Volk: BITCH!'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284964
    m_Localized: 'Volk: I''M TAKING YOU WITH ME.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284965
    m_Localized: 'Volk: I don''t like having my picture taken.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284966
    m_Localized: 'Volk: If those pictures don''t end up in the trash later, I''ll have to take action.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284967
    m_Localized: 'Volk: Do you understand that?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284968
    m_Localized: 'Volk: (You''re taking a picture of the person you''re talking to)'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284969
    m_Localized: 'Volk: (You wave the photo around to make it show up faster)'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284970
    m_Localized: 'Volk: (You notice that the picture seems fine, but it''s being snatched out of your hands)'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284971
    m_Localized: 'Volk: Give it to me. I''ll throw them out myself.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284972
    m_Localized: 'Volk: Watch it.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284973
    m_Localized: 'Volk: If you come at me, I''ll bite your throat out.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284974
    m_Localized: 'Volk: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284975
    m_Localized: 'Volk: I take care of my teeth.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284976
    m_Localized: 'Volk: And those that are missing...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284977
    m_Localized: 'Volk: Well, let those bastards clench them tighter in the grave.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284978
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49660284979
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49660284980
    m_Localized: 'Volk: Don''t point that gun at me again.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284981
    m_Localized: 'Volk: I know when and how much you sleep.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284982
    m_Localized: 'Volk: And if I do, I''ll eat you alive, kid.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284983
    m_Localized: 'Volk: Don''t make a mistake.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284984
    m_Localized: 'Volk: I''ve been out of one of these before.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284985
    m_Localized: 'Volk: Well, let''s see who''s faster.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284986
    m_Localized: 'Volk: HHAAAAA!'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284987
    m_Localized: 'Zhena: What do you want to check? Redness in the eyes?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284988
    m_Localized: 'Zhena: Go ahead, try.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284989
    m_Localized: 'Zhena: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284990
    m_Localized: 'Zhena: If I show emotion, does that make me a Visitor?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284991
    m_Localized: 'Zhena: Can a person in this new world still cry? Apparently, laughing is already forbidden.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284992
    m_Localized: Shoot.
    m_Metadata:
      m_Items: []
  - m_Id: 49660284993
    m_Localized: Hear out.
    m_Metadata:
      m_Items: []
  - m_Id: 49660284994
    m_Localized: 'Zhena: Can we be frank now?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284995
    m_Localized: 'Zhena: No joy allowed, no crying allowed.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284996
    m_Localized: 'Zhena: Sometimes, speaking isn''t allowed either.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284997
    m_Localized: 'Zhena: We can only sit and cover our faces with our hands.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284998
    m_Localized: 'Zhena: Is it really going to end this easily?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660284999
    m_Localized: 'Zhena: No more pain?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285000
    m_Localized: 'Zhena: But I never held you back, my...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285001
    m_Localized: 'Zhena: Hands... wait a second.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285002
    m_Localized: 'Zhena: My hands are tired from carrying the one they refused to save.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285003
    m_Localized: 'Zhena: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285004
    m_Localized: 'Zhena: Must I?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285005
    m_Localized: 'Zhena: If you want to shoot, just shoot.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285006
    m_Localized: 'Zhena: I don''t have the strength anymore...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285007
    m_Localized: 'Zhena: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285008
    m_Localized: 'Zhena: No, I''m sorry, I''m just really exhausted.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285009
    m_Localized: 'Zhena: Don’t you think this is a mockery?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285010
    m_Localized: 'Zhena: No one helped save my husband, but now...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285011
    m_Localized: 'Zhena: YOU WANT TO DISRESPECT HIM IN DEATH?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285012
    m_Localized: 'Zhena: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285013
    m_Localized: 'Zhena: I''m at a loss for words.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285014
    m_Localized: 'Zhena: Do whatever you want and don''t touch me.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285015
    m_Localized: 'Zhena: (You take a picture of the person you''re talking to)'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285016
    m_Localized: 'Zhena: (You don''t see anything out of the ordinary)'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285017
    m_Localized: 'Zhena: (The dead man was in the frame, it makes you think)'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285018
    m_Localized: 'Zhena: Now just go away.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285019
    m_Localized: 'Zhena: What?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285020
    m_Localized: 'Zhena: ...okay.'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285021
    m_Localized: 'Zhena: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285022
    m_Localized: 'Zhena: That''s it?'
    m_Metadata:
      m_Items: []
  - m_Id: 49660285023
    m_Localized: 'Zhena: Can I have some quiet time here alone?'
    m_Metadata:
      m_Items: []
  - m_Id: 19268172649320448
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 19268172649320449
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 19268172649320450
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 19268172649320451
    m_Localized:
    m_Metadata:
      m_Items: []
  - m_Id: 21730154233188359
    m_Localized: Let in, Ledy!
    m_Metadata:
      m_Items: []
  - m_Id: 21730154233188360
    m_Localized: C'mon, shmara!
    m_Metadata:
      m_Items: []
  - m_Id: 28176949561774080
    m_Localized: Shot
    m_Metadata:
      m_Items: []
  - m_Id: 28176949582745600
    m_Localized: Hear out
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
