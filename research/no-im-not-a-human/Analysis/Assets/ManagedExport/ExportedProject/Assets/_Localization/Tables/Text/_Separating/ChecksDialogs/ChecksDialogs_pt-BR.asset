%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_pt-BR
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 9ca4ee10b5b962b4993a5133922046c2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377490604032
    m_Localized: 'Firefighter: *cof* Claro, cara. Não tenho nada a esconder. Tudo virou cinza há muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769856
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: Orelhas
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: Dê uma olhada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: 'Firefighter: Não *cof* julgue muito. A fumaça não é lá a melhor dentista.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: Aqui, olhe... *cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: 'Firefighter: Como dois tocos queimados. Mas as unhas estão limpas. Irônico, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: Sem problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: 'Firefighter: Viu? *tosse* Vermelhos como brasas. É da fumaça, parceiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: 'Firefighter: Tem certeza? Não vai ser uma cena bonita.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: 'Firefighter: Tudo queimado... Minha pele está rachada como casca de árvore seca. Não levanto os braços se não for necessário. Dói.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: 'Firefighter: É, claro. Vai dar de cara com mais um cadáver carbonizado da floresta. É sempre assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: Você curte isso? *cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: 'Firefighter: É simples. Estão queimadas até a cartilagem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: 'Firefighter: Minha audição vai sumir logo. Talvez seja até melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: 'Firefighter: Atira logo, cara. Só não mira nos dentes. Eles já estão nos últimos dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: 'Firefighter: Olha, não tenho medo de nada. Pode atirar se isso te faz se sentir melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: Talvez assim fique até mais fácil...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: 'Firefighter: Você faz ideia do que essas mãos já passaram?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: 'Firefighter: Se essa foto é uma sentença, então *tosse* que acabe logo. Já não tenho mais por que ficar aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: 'Firefighter: Tudo queima... Acho que chegou a minha vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: 'Firefighter: Sabe, *tosse* nunca consegui fazer meus filhos escovarem os dentes todo dia. E... agora não tem mais ninguém pra lembrá-los.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: 'Firefighter: Eu costumava *tosse* salvar vidas com essas mãos. Agora mal consigo segurar uma caneca.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: Então é isso...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: Bem, chegou a minha hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: 'Firefighter: Quando a floresta está em chamas *cof*... você só assiste virar cinzas. E sabe que não pode fazer nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: 'Firefighter: Às vezes acordo à noite com a sensação de que minha pele está se rasgando de verdade. Nada ajuda. O fogo levou tudo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: 'Firefighter: Só a memória escapa do fogo. O corpo é só uma questão de tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: 'Firefighter: Quando o fogo estiver rugindo à sua volta, vai entender o valor deste silêncio. Seus ouvidos podem estar bem, mas e a sua alma?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: 'Wheelchair: Certo. Pode me testar. Vou passar por todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964176
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964177
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964178
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964179
    m_Localized: Orelhas
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: Aqui, olha.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: Esses dentes são um verdadeiro tesouro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: 'Wheelchair: Não são dentes, são ouro! Não todos, claro, mas vai ter mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: 'Wheelchair: Se você soubesse como é fácil abrir uma latinha com os dentes da frente...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: Pro inferno com abridores de lata!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: 'Wheelchair: Pelo menos ainda tenho mãos. Já é motivo pra agradecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: 'Wheelchair: Sem elas, nem dar uma corrida eu conseguiria.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: Espera aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: Meus dedos sumiram!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: 'Wheelchair: Ontem faltava só um. Pra onde foram os outros?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: 'Wheelchair: Ah, vão crescer de novo. Só demora um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: Meu dedo se foi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: 'Wheelchair: É uma bobagem, mas incomoda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: 'Wheelchair: MAS MINHA UNHA JÁ ESTÁ CRESCENDO, TÁ VENDO?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: 'Wheelchair: O que quer dizer que minhas pernas também vão voltar. Só mais tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: 'Wheelchair: Pra onde olho? Direto pra você?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: 'Wheelchair: Viu esse tique? É mania.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: 'Wheelchair: Desde os tempos em que eu ainda podia acelerar um motor, não enxergava mais... bem, nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: 'Wheelchair: Acho que ainda não tô pronto pra tirar o pé do acelerador.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: Ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: 'Wheelchair: Vai lá. HAHAHAHA, tá bom, tá bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: Esse é o auge da comédia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: 'Wheelchair: Você me pede pra mostrar as axilas, e eu mostro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: 'Wheelchair: O inferno tá pegando fogo lá fora, o universo quer apagar o planeta...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: Os Visitantes querem nos eliminar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: 'Wheelchair: E você: “Mostra as axilas aí!”'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: HAHAHAHA.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: Deixe ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: Uma foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: 'Wheelchair: Não é muito a minha praia, mas tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: Droga, eu pisquei.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: 'Wheelchair: HAHAHAHA! Okaaay!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: Você também recebeu aquela transmissão, certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: 'Wheelchair: Sim, sim. Hm? Certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: Espera, você não está brincando?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: Isso é... escroto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: 'Wheelchair: Ei, eu não vou pegar mais cerveja sua. Não leve para o lado pessoal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: Você sabe o que fazemos com quem fica irritadinho?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: A gente passa com os carrinhos por cima.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: 'Wheelchair: Se for ficar bravo, então me leva pra dar uma volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: Por quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: Isso não vai me ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: 'Wheelchair: E nem você, provavelmente. Então, por que a arma?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: 'Wheelchair: Provavelmente eu não vou conseguir ver a bala. Mas posso tentar desviar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: 'Wheelchair: Nunca entendi por que as pessoas se depilam. O pelo é uma defesa natural do corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: 'Wheelchair: Tá vendo aquela vermelhidão? Tô crescendo dedos ali. Sobressalentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: 'Wheelchair: Ah, a comédia de verdade nem começou ainda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: 'Wheelchair: Onde foi que a gente errou nesta vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: 'Wheelchair: Por que a foto? Você conhece o ditado: "Respirar fundo não adia a morte"?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: 'Wheelchair: Tinha algo que eu queria dizer...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: Posso simplesmente ir embora?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: 'Wheelchair: Bem, acho que a gente mereceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: 'Wheelchair: Mais cedo ou mais tarde, Deus vai te derrubar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: Eu nunca vou embora em silêncio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: 'Wheelchair: É tudo essa nossa biologia de saco de carne, entendeu?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: 'Wheelchair: Por que a gente ria de tudo isso antes, mas agora quer explodir a cabeça um do outro?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: Preciso me preparar para morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: Minhas mãos são meu único motor agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: E estou sem embreagem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: 'Wheelchair: Sendo sincero, a ideia de perder elas também me apavora. E aí?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: 'Wheelchair: Eu odiaria ficar sem nenhum jeito de me mover. Preso pra sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: Nem a morte me assusta tanto assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: 'Wheelchair: De qualquer jeito que você olhe, não dá mais pra alcançar o tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: 'Wheelchair: Já reparou que o tempo acelera com a idade?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: 'Wheelchair: Quando éramos crianças, não tínhamos pressa de viver. Tudo era simples. Sem responsabilidades ou decisões difíceis.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: 'Wheelchair: Mas agora, por mais que corramos, parece que nunca vamos alcançar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: 'Wheelchair: Sabe, de repente eu não estou mais achando graça.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: Seus testes ridículos, apagando incêndios.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: 'Wheelchair: Todo mundo quer salvar o mundo, mas ninguém concorda em como fazer isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: 'Wheelchair: E será que tem mesmo um sentido? Talvez só devêssemos relaxar e parar de nos preocupar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: Olha...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: Você não acha que nosso passeio acabou?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: 'Wheelchair: É o fim da linha. Vamos partir em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: Dá pra ver o ponto final pela janela.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: Você está pronto pra isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: 'Wheelchair: Foi o que pensei. Não fique chateado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: 'Wheelchair: Se... Se você não confia nesse sinal, como posso confiar neles?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: 'Wheelchair: Talvez todos eles apontem pros Visitantes com a mesma precisão.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: 'Wheelchair: As pessoas erram, sabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: 'Wheelchair: Mas esses erros podem ter consequências terríveis.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: 'Wheelchair: Se... Se você confia neste sinal, como posso confiar nos anteriores?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: 'Wheelchair: Talvez os outros também sejam uma porcaria.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: 'Wheelchair: Somos humanos, claro. A gente erra, é só isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: 'Wheelchair: Mas esses erros podem ter consequências terríveis.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: 'Wheelchair: Você... Um movimento errado já basta pra tudo dar errado e acabar com a vida de alguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: 'Wheelchair: Se você tem tanta certeza da sua escolha... eu invejo essa confiança.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: 'Mother: Vai em frente, me testa. Não tenho nada a esconder.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: Orelhas
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: Por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: 'Mother: Sabe, eu nunca liguei muito pra eles. Não tinha tempo. Mas agora... Agora me arrependo disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964303
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964304
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: Aqui, olhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: 'Mother: São pás, não palmas. Tudo pelas crianças.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964307
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964308
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: Olhe, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: 'Mother: Tá vendo essas bolsas enormes? É por falta de sono...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964311
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964312
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: Olhe, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964314
    m_Localized: 'Mother: Fiquei sem desodorante faz tempo. Não me julgue.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964315
    m_Localized: Deixe ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964316
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: 'Mother: Posso sentar? Não?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964318
    m_Localized: 'Mother: Desgrenhada e irritadiça, como sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964319
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964320
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: 'Mother: Eu não limpo há muito tempo. Deve estar tudo entupido agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: 'Mother: Já estou meio surda com os gritos das crianças.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964323
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964324
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: 'Mother: Minhas gengivas estão sangrando quando escovo os dentes há uma semana.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: 'Mother: E eu ainda tenho dentes amarelos. Mas como eu poderia não fumar com crianças assim?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964327
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964328
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: 'Mother: Tenho uma irritação por causa de produtos de limpeza. Nunca tive tempo de ir ao médico.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: 'Mother: Essas mãos fariam uma sopa pra você, se você viver tempo o suficiente! E você vai pegar sua arma...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964331
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964332
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: 'Mother: Mesmo que você puxe uma granada, isso não vai me dar uma boa noite de sono.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964334
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964335
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: 'Mother: O quê, decidiu atirar em mim por causa do cheiro? Que piada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964337
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964338
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: 'Mother: O quê, tá me julgando pela minha foto? Que piada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964340
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964341
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: 'Mother: Você tá mesmo doente se quer atirar em mim por causa das minhas orelhas. Não gostou? Eu coloco um lenço!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964343
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964344
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: Finalmente, ninguém vai me encher mais o saco...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: Que horrível...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: 'Mother: Sabe, um dos meus filhos tem dentes perfeitos. E nunca sorriu. Talvez não seja sobre os dentes, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: 'Mother: Mãos... Usei pra abraçar meus filhos, fazer faxina, acariciar meu marido. E sabe do quê? Ninguém nunca deu valor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964349
    m_Localized: 'Mother: Quando seu filho fica doente, você passa dias sem dormir. Depois se acostuma e só vive dentro do pesadelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964350
    m_Localized: 'Mother: Uma vez, eu estava tão cansada que fiquei uma semana sem tomar banho. As crianças nem notaram.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964351
    m_Localized: 'Mother: Sabe, uma vez achei uma foto onde todas as crianças estavam sorrindo. Fiquei olhando a noite toda até dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964352
    m_Localized: 'Mother: Às vezes, queria ser surda. Mas quando os filhos dormem, vem um silêncio abençoado... É por isso que a gente vive.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: 'Anger: Sério? Porra... Tá, beleza, mas não demora!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: Orelhas
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: 'Anger: Eu não dou a mínima. Olha aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: 'Anger: Amarelos? Ah, que se fodam.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: 'Anger: Brancos? Ah, que grande surpresa! Isso é higiene básica, seu palerma!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: 'Anger: Eu pensava que, se meus dentes fossem assim, eu devia pelo menos ter um de ouro. Igual aos durões dos filmes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: Claro, tanto faz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: 'Anger: Uau, são realmente enormes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: 'Anger: Ah, a vovó dizia que com mãos grandes como as minhas eu devia estar cortando lenha, e não fazendo o que quer que eu estivesse fazendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: 'Anger: Mas, aqui não tem nada pra cortar, e eu tenho que dar um jeito de liberar minha raiva.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: 'Anger: É problema seu, mas eu não me importo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: 'Anger: O quê, gostou da cor? São azuis. Sempre foram. Nunca precisei de mais nada pra atrair mulher.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: Eu não dou a mínima pra isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: Sim, eu me depilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: 'Anger: Eu não suporto pelos nas axilas. Parece que um arbusto maldito resolveu crescer ali.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: Vai em frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: 'Anger: Que foi? Porra, tá me encarando por quê? O que você viu?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: Porra...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: 'Anger: Tá me encarando por quê? Tá faltando alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: 'Anger: Você tá louco? Acabei de mostrar meus dentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: 'Anger: Você acha que eu não consigo esmurrar sua garganta com essas mãos antes de você puxar esse gatilho?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: 'Anger: O que caralhos você tá sugerindo? Tá com inveja ou o quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: 'Anger: Coça o tempo todo, como se quisesse me provocar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: 'Anger: Quando eu coço até sangrar, melhora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: 'Anger: Eu não acredito em você. Você é completamente louco!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: 'Anger: Quer atirar em mim por conta de uma foto besta?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: 'Anger: Cuidado com esse bastão da morte aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: 'Anger: Você pode acabar me matando por causa das minhas orelhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: 'Anger: Você é completamente pirado. Vai, então, covarde!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: 'Anger: Você é um imbecil sem coração do caralho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: Vai se foder.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: 'Anger: Minha avó tinha um dente de ouro. Eu ainda era novo quando percebi que queria um igual.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: 'Anger: Brilhava como se o sol estivesse preso na boca dela.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: 'Anger: Ela disse que colocaram quando o antigo apodreceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: 'Anger: Eu pensei, "Puta merda! Eles vão fazer o mesmo por mim quando a hora chegar."'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: 'Anger: E aí, a hora chegou. Só que ninguém me deu nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: 'Anger: Minha boca não umedece mais. Ela só fica seca, estática, fedendo e com cor de mijo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: 'Anger: Você vê essas mãos? Sujeira, sangue, o que você quiser. Mas não é de outra pessoa. É meu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: 'Anger: Minhas mãos às vezes coçam tanto, que quero arrancar toda a minha pele. Ou socar uma parede. Ou ambos ao mesmo tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: 'Anger: Eu não posso me conter. Mas eu não quero machucar ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: 'Anger: Tá vendo essas unhas? Sujeira, sangue, o que você quiser. Mas não é de outra pessoa. É meu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: 'Anger: Minhas mãos às vezes coçam tanto, que quero arrancar toda a minha pele. Ou socar uma parede. Ou ambos ao mesmo tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: 'Anger: Aposto que se eu fosse uma outra pessoa, ficaria preocupado com o que faço comigo mesmo. Mas eu não dou a mínima.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: 'Anger: Minha avó sempre me chamou de "bebê anjo" por causa da cor dos meus olhos. Pois é. Porra de "anjo".'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: 'Anger: Agora estou aqui olhando para essas janelas para a alma e pensando: "Que porra de parte de mim é um anjo?"'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: 'Anger: Eu posso ver o jeito que ela me olharia. Decepcionada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: 'Anger: Você sabe, um barbeador é afiado o suficiente pra fazer... coisas. Se fosse tão fácil assim...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: 'Anger: Eu só acabei cortando meu braço. Agora, toda vez que me depilo parece que a lâmina não tá tirando o meu pelo, mas um pedaço de carne da minha pele.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: 'Anger: Enfim, eu me depilo. Por que, porra, cara, eu odeio um matagal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: 'Anger: Eu nem tenho uma foto da minha avó. Ela não gostava dessas coisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: 'Anger: Ela dizia que quando você tira uma foto, sua alma fica presa nela e não consegue sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: 'Anger: Eu ri pra caramba disso, aí falei pra ela: "Ô, vó! Isso não faz sentido."'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: 'Anger: E ela disse: "Quando eu partir, você vai olhar para a minha fotografia e perguntar se eu consegui alcançar o paraíso."'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: 'Anger: Ah, que se foda tudo. Eu não tenho foto e nem minha avó.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: 'Anger: Às vezes me pego puxando os lóbulos das orelhas, mas só quando já estão vermelhos de tanto arder.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: 'Anger: Eu achava que isso era algum tique de ansiedade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: 'Anger: Depois percebi que só queria arrancar essa parte de mim, como se estivesse no caminho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: 'Anger: Mas eu não sou louco o bastante pra me mutilar, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: NÉ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: 'FortuneTeller: Oh, querido, eu sabia que sua energia resistiria. Mas vamos fazer seus testes. Eu ainda enxergo você por dentro, de qualquer maneira.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: Orelhas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: Tudo bem, dê uma olhada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: 'FortuneTeller: Os olhos são reflexo do nosso cosmos interior, não os dentes. Quer ver seu destino neles?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: 'FortuneTeller: Os olhos são reflexo do nosso cosmos interior, não os dentes. Está olhando para eles por quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: Bem, vá em frente e olhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: 'FortuneTeller: Mas cuidado — ainda não tirei as farpas que peguei de um apanhador de sonhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: 'FortuneTeller: Ah, meus olhos? São castanhos, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: 'FortuneTeller: Bem, se você não contar as manchas vermelhas. A culpa é da lua.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: 'FortuneTeller: Ah... As coisas que o universo coloca no meu caminho... Tudo bem, dê uma olhada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: 'FortuneTeller: É difícil cuidar de si mesmo nessas condições, sabe...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: 'FortuneTeller: Cuidado. Minha aura pode ser ofuscante!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: 'FortuneTeller: Então? O que você achou?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: 'FortuneTeller: Pode olhar, mas cuidado, porque eles ouvem tudo — até seus pensamentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: 'FortuneTeller: Então? Encontrou alguma resposta?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: 'FortuneTeller: Você quer atirar em mim por causa dos meus dentes? Entende que não sou eu, né? É porque Marte tá azedo com Vênus.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: 'FortuneTeller: Sério? Vai me atirar por causa de umas farpas na mão? É o preço de trabalhar com apanhadores de sonhos!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: 'FortuneTeller: Você tá louco?! Sabe que é só a lua pregando peças, né? Não é tão fácil seguir o movimento dela!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: 'FortuneTeller: Você tá louco?! Sabe que é só a lua pregando peças, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: 'FortuneTeller: Isso não é astrologia, é selvageria! Por que não abaixa essa arma e eu te conto mais segredos? De graça!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: 'FortuneTeller: Ei! A culpa não é minha se você não estava pronto, querido!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: 'FortuneTeller: Pode largar isso aí? O que acha que vai descobrir olhando para orelhas? É com elas que se ouvem os sábios!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: 'FortuneTeller: Se você me matar, vai estar condenado a...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: Diarréia eterna!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: 'FortuneTeller: Você sabe, um homem com dentes perfeitos veio até mim uma vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: 'FortuneTeller: Eu disse: "Está tudo certo, mas sua alma está podre!" Pensa bem no que importa. Você entende, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: 'FortuneTeller: Uma vez passei a noite inteira tirando farpas depois de um ritual. Doía, mas cada uma era uma lição do universo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: 'FortuneTeller: Os olhos são portais para outro mundo. Vi um homem — os olhos dele brilhavam como arandelas. Ele disse que era amor, mas era Marte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: 'FortuneTeller: Sabe, uma vez passei três semanas vivendo de forma ascética e pensando só nos meus sonhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: 'FortuneTeller: Pensamentos são matéria, e é assim que me aproximo dos meus desejos. Só preciso fazer o pedido certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: Meu estado atual provavelmente se compara àquele.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: 'FortuneTeller: Tirei uma foto minha uma vez e pensei: "É um sinal das estrelas!" Depois percebi que era só a luz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: 'FortuneTeller: Uma vez ouvi um som nos meus ouvidos, como se o universo tentasse falar comigo. Mas acho que era algo mais forte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: 'FortuneTeller: Uma vez ouvi um som como se o universo tentasse falar comigo. No fim era só uma corrente de ar. Ainda assim, gostei.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158522
    m_Localized: 'Fanatic: O que você deseja verificar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158523
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158524
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158525
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158526
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158527
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158528
    m_Localized: Orelhas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158529
    m_Localized: 'Fanatic: Quer que eu te mostre meus dentes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158530
    m_Localized: 'Fanatic: MEUS DENTES DEFENDERAM A VERDADE!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158531
    m_Localized: 'Fanatic: E caíram por isso...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158532
    m_Localized: 'Fanatic: Você consegue enxergar isso por conta própria.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158533
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158534
    m_Localized: 'Fanatic: Eu mantenho meus dentes bonitos com uma solução de cerveja. Protege bem o cálcio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158535
    m_Localized: 'Fanatic: Se isso, eu já teria perdido os dentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158536
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158537
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158538
    m_Localized: 'Fanatic: Compreensível, é claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158539
    m_Localized: 'Fanatic: Tem tanta coisa acontecendo agora, e ainda assim, sobrevivemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158540
    m_Localized: 'Fanatic: Seguimos vivendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158541
    m_Localized: 'Fanatic: O quê, ficou tempo demais nas sombras?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158542
    m_Localized: 'Fanatic: Hora de descansar, meu amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158543
    m_Localized: 'Fanatic: Sem restrições, meu amigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158544
    m_Localized: 'Fanatic: Olhe para minhas unhas o quanto quiser.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158545
    m_Localized: 'Fanatic: Eu me treinei para absorver apenas os benefícios da luz solar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158546
    m_Localized: 'Fanatic: E para abrir umas cervejas, é claro!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158547
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158548
    m_Localized: 'Fanatic: Você só queria verificar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158549
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158550
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158551
    m_Localized: 'Fanatic: OLHE NOS MEUS OLHOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158552
    m_Localized: 'Fanatic: Eles estão cheios de raiva e fúria.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158553
    m_Localized: 'Fanatic: OLHE NOS MEUS OLHOS ESCUROS!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158554
    m_Localized: 'Fanatic: Eu os uso para absorver todos os benefícios da luz, trrrrransformando em energia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158555
    m_Localized: 'Fanatic: Recebo toda minha energia pelos OLHOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158556
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158557
    m_Localized: 'Fanatic: VOCÊ VIU O PODER JUSTO DO SOL EM MEUS OLHOS?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158558
    m_Localized: 'Fanatic: Se não, você está cego. Tente olhar para o sol por mais tempo, COMO EU.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158559
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158560
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158561
    m_Localized: 'Fanatic: Uma foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158562
    m_Localized: 'Fanatic: Hm... Hm-hm-hm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158563
    m_Localized: 'Fanatic: Alguém já lhe disse que eu cumprimentei o próprio LÍDER SOLAR?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158564
    m_Localized: 'Fanatic: Sim, eu o ensinei a olhar para o sol, mas conto isso depois.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158565
    m_Localized: 'Fanatic: Vá em frente. TIRA UMA FOTO!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158566
    m_Localized: 'Fanatic: (Você tira uma foto do homem desleixado.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158567
    m_Localized: 'Fanatic: (Como na vida, a foto o mostra despenteado e imundo.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158568
    m_Localized: 'Fanatic: (Você não percebe nenhuma distorção.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158569
    m_Localized: 'Fanatic: COMO TUDO ACABOU MARAVILHOSAMENTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158570
    m_Localized: 'Fanatic: Venha me ver e eu lhe conto tudo sobre minha vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158571
    m_Localized: 'Fanatic: E você vai me pagar um pouco por isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158572
    m_Localized: 'Fanatic: VOU GASTAR COM A ECONOMIA DE ENERGIA DO SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158573
    m_Localized: 'Fanatic: Tente atirar! A verdade vai me proteger!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158574
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158575
    m_Localized: 'Fanatic: Você vai guardar sua arma?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158576
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158577
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158578
    m_Localized: 'Fanatic: Bem, é muuuuuito difícil sem uma cerveja na mão.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158579
    m_Localized: 'Fanatic: Muuuuuuito difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158580
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158581
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158582
    m_Localized: 'Fanatic: Humano, por que está fazendo isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158583
    m_Localized: 'Fanatic: VOCÊS ENLOUQUECERAM, NÃO ILUMINADOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158584
    m_Localized: 'Fanatic: Eles não só falam pelas costas como também atiram em você...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158585
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158586
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158587
    m_Localized: 'Fanatic: Bem, isso é demais!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158588
    m_Localized: 'Fanatic: Isso não vai nos ajudar com nossa vitalidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158589
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158590
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158591
    m_Localized: 'Fanatic: Espera, você não gosta das minhas mãos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158592
    m_Localized: 'Fanatic: POR QUÊ NÃO?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158593
    m_Localized: 'Fanatic: Você é um pão-duro, ignorante, e eu quero cerveja.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158594
    m_Localized: 'Fanatic: As pessoas dizem: "Não enfie os olhos onde não foi chamado."'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158595
    m_Localized: 'Fanatic: Então, o que devo fazer? Desviar o olhar para sempre?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158596
    m_Localized: 'Fanatic: Ah, espera, espera aí...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158597
    m_Localized: 'Fanatic: Era "nariz", na verdade...?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158598
    m_Localized: 'Fanatic: Um segundo, segura aí...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158599
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158600
    m_Localized: 'Fanatic: Eu não dou a mínima.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158601
    m_Localized: 'Fanatic: É, isso mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158602
    m_Localized: 'Fanatic: Você não atiraria no Sol!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158603
    m_Localized: 'Fanatic: Mas não se preocupe comigo. Não me ofendi com tais atitudes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158604
    m_Localized: 'Fanatic: Contanto que você tenha uma reserva generosa de néctar gelado!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158605
    m_Localized: 'Fanatic: Ah, um brincalhão, é?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158606
    m_Localized: 'Fanatic: Bom, pode dar uma cheirada aí, se é isso o que você curte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158607
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158608
    m_Localized: 'Fanatic: Este é o resultado do autocuidado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158609
    m_Localized: 'Fanatic: Ah, um brincalhão, é?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158610
    m_Localized: 'Fanatic: Bom, pode dar uma cheirada aí, se é isso o que você curte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158611
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158612
    m_Localized: 'Fanatic: Este é o resultado do trabalho do Sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158613
    m_Localized: 'Fanatic: Liberamos umidade revigorante para continuar vivendo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158614
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158615
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: O que você deseja verificar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: Orelhas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: 'Anxiety: Hah, o quê — você vai tomar uma decisão com base nos meus dentes? Eita.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: Acabei de consertar meus dentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: Embora, para ser honesta...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: 'Anxiety: Nem lembro de ter ido ao dentista. Será que fui mesmo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: 'Anxiety: Deus, estou tão apavorada que nem lembro se comi ontem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158629
    m_Localized: 'Anxiety: Então... Eu me encaixo na descrição?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158632
    m_Localized: 'Anxiety: Sou um visitante? Como? COMO?! Não pode ser!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158633
    m_Localized: 'Anxiety: Oh meu Deus, fui expulsa de casa, demitida do trabalho e agora vou enlouquecer dentro da minha própria cabeça...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: 'Anxiety: Você quer olhar para minhas unhas? Isso é um sinal estranho...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: 'Anxiety: Mas tudo bem. Dê uma olhada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: 'Anxiety: O que tem nelas? De jeito nenhum é sujeira.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: 'Anxiety: Eu... Eu nem me lembro de ter feito buracos na terra.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: Como essa porcaria veio parar aqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158644
    m_Localized: 'Anxiety: Eu não conseguiria ficar andando por aí suja por alguns dias, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158645
    m_Localized: 'Anxiety: Que... estranho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158648
    m_Localized: 'Anxiety: Imagine só! Não lembro de onde veio essa sujeira. Eu estava aqui, na sua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158649
    m_Localized: 'Anxiety: Será que... será que alguém colocou sujeira de propósito debaixo das minhas unhas? Quem faria isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: Você quer verificar meus olhos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158651
    m_Localized: 'Anxiety: Acho que já sei o resultado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158652
    m_Localized: 'Anxiety: O que acontece se eu tiver esse sinal?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158654
    m_Localized: 'Anxiety: É, bem. Não poderia ser diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158657
    m_Localized: 'Anxiety: Eu sou mesmo uma visitante? O que você acha?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158658
    m_Localized: 'Anxiety: E por que eu não sei disso? Talvez seja assim que a gente se transforma neles.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158659
    m_Localized: 'Anxiety: Talvez baste pensar que você é diferente dos outros pra virar o pior tipo de pessoa na sociedade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: Tenho medo de morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158663
    m_Localized: 'Anxiety: Espera, posso pegar algum curativo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158664
    m_Localized: 'Anxiety: Ou pelo menos ficar de pé mais um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158665
    m_Localized: 'Anxiety: Se eu for mesmo uma visitante, vou começar a matar pessoas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158666
    m_Localized: 'Anxiety: Vou me tornar perigosa? Ou sempre fui?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158667
    m_Localized: 'Anxiety: Talvez eu já tenha matado pessoas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: (Você tira uma foto dela.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158669
    m_Localized: 'Anxiety: (Quando a imagem se revela, você vê um corpo borrado e um fundo nítido.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158670
    m_Localized: 'Anxiety: (É como se ela tivesse se encolhido no momento da foto.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158671
    m_Localized: 'Anxiety: Hahaha, dá pra imaginar? Eu só me encolhi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158672
    m_Localized: 'Anxiety: O que acontece agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158673
    m_Localized: 'Anxiety: Você pode me deixar viver? Ou seria melhor me matar? O que vai fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: Por quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: Não seria mais fácil atirar em mim de uma vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158678
    m_Localized: 'Anxiety: Eu quero ir embora, mas estou com muito medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158679
    m_Localized: 'Anxiety: Talvez...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158680
    m_Localized: 'Anxiety: Eu não sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158681
    m_Localized: 'Anxiety: Se você atirar em mim, vou virar algo ainda pior?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158682
    m_Localized: 'Anxiety: Talvez eu devesse fugir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158683
    m_Localized: 'Anxiety: Mas eu nem sei se ainda sou humana.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158684
    m_Localized: 'Anxiety: O que eu devo fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158685
    m_Localized: 'Anxiety: Assim como aqueles Visitantes lá em casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158686
    m_Localized: 'Anxiety: Desculpa, foi horrível... eu vou mostrar pra você.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158687
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: 'Anxiety: Eu sou humana? Sim? Me diz que eu sou humana, por favor!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: Sacar a sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: 'Anxiety: Por que você pediu para verificar se já ia sacar uma arma de qualquer jeito?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: Você gosta de humilhar pessoas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158695
    m_Localized: 'Anxiety: Que pesadelo. Você não se sente seguro em lugar nenhum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158696
    m_Localized: 'Anxiety: Os Visitantes podem invadir a sua casa. Um maluco pode te matar por acreditar que tem algo de errado com você.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158697
    m_Localized: 'Anxiety: Dá muito medo! ALGUÉM BEM QUE PODIA DIZER QUE VAI FICAR TUDO BEM!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158698
    m_Localized: 'Anxiety: Como assim virei Visitante só por conta daquele sinal?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158699
    m_Localized: 'Anxiety: Já não tive tanta sorte com meu corpo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158700
    m_Localized: 'Anxiety: Todo deformado. Eu sei o motivo de todos me olharem com medo no trabalho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158701
    m_Localized: 'Anxiety: Eu voltei ao hiospital semana passada por conta das minhas costas... eu acho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158702
    m_Localized: 'Anxiety: Será... que eu também fui ao dentista?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158703
    m_Localized: 'Anxiety: Quanto será que eu gastei?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: O que você quer verificar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: Orelhas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: Você quer que eu mostre meus dentes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: 'Esenin: Tá, dá uma olhada. Ainda tá com o cheiro de tristeza e nicotina.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: Bem amarelinhos, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: Então cai fora com suas verificações.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: Eu não sou um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: Afinal, de onde é que eles vieram?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: 'Esenin: Unhas cheia de sujeira são um sinal?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: Eles podiam só lavar as mãos!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: 'Esenin: Então você tá dizendo que um jardineiro se transforma automaticamente em um Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: Que papo torto do cacete.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: Verifica minhas unhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: 'Esenin: E aí? Sou um Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: Acho que não.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: Cada dia consegue ser mais ridículo que o outro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: 'Esenin: E se eu não tivesse dormido? Ou se eu estivesse chorando?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: 'Esenin: Eu não entendo mais como isso funciona.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: 'Esenin: E o que você vai fazer se um sinal confirmar? Ou se vários sinais confirmarem?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: 'Esenin: Eu vou me tornar um Visitante hoje a noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: 'Esenin: Me farei chorar lembrando de tempos mais tranquilos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: 'Esenin: Todas essas verificações por sinais, homens em trajes amarelos...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: É tudo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: Uma bagunça fodida.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: 'Esenin: Você não tem a sensação de que tudo tá indo para algum tipo de inferno aterrorizante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: 'Esenin: Tá tudo supostamente sob controle, mas o caos está ao nosso redor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: Vai, tira a porra da foto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: (Você tira uma foto dele.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: 'Esenin: (Ele está sentado, calmo e não está totalmente enquadrado na foto, mas você não nota nada de anormal.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: 'Esenin: Só tô com medo do que vai acontecer a seguir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: 'Esenin: É sério mesmo? Você é um imbecil?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: A FEMA comeu teus miolos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: 'Esenin: Tá chapando? Achei que as drogas fortes já tinham acabado'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: 'Esenin: Bom, já que você tá perguntando, eu vou te mostrar!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: Você conseguiu o que queria?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: Cheirou até abrir um buraco no teu nariz?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: 'Esenin: Valeu por não ter enterrado o nariz na minha bunda!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: Só seja rápido com isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158751
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158752
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158753
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158754
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158755
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352768
    m_Localized: Orelhas
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: Quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: 'Widow: Hã... tá bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: Acabou?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: Posso ter um pouco de paz e sossego?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352774
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352775
    m_Localized: Sacar a sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: 'Widow: Mãos... aguardem um instante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: 'Widow: Minhas mãos estão cansadas de carregar aquele que eles recusaram salvar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: 'Widow: Você pode parar de me pedir para fazer essa merda idiota?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: 'Widow: Se você quer tanto atirar em mim, só vai em frente, enfia o dedo no gatilho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: Eu não tenho mais forças...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352782
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352783
    m_Localized: Sacar a sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: 'Widow: O que você tá procurando? Alguma vermelhidão?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: Vai em frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: 'Widow: Se eu demonstrar alguma emoção isso significa que eu sou um Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352788
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352789
    m_Localized: Sacar a sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: Podemos ser ser sinceros agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352791
    m_Localized: 'Widow: Você não pode ser feliz, você não pode chorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352792
    m_Localized: 'Widow: Nem sempre pode falar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352793
    m_Localized: 'Widow: O que resta? Sentar com o rosto nas suas mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352794
    m_Localized: 'Widow: Isso vai mesmo acabar de uma maneira tão fácil?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352795
    m_Localized: 'Widow: Sem mais sofrimento?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352796
    m_Localized: 'Widow: Mas eu não salvei você, meu...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352797
    m_Localized: 'Widow: Isso não te soa nem um pouco humilhante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352798
    m_Localized: 'Widow: Ninguém ajudou a salvar meu marido, e agora...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352799
    m_Localized: 'Widow: VOCÊ QUER COMEMORAR A MORTE DELE?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352801
    m_Localized: 'Widow: Eu não tenho palavras.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352802
    m_Localized: 'Widow: Faça o que quiser e me deixa em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352803
    m_Localized: 'Widow: (Você tira uma foto dela.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352804
    m_Localized: 'Widow: (Você não vê nada de incomum.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352805
    m_Localized: 'Widow: (O homem morto aparece no quadro, o que te obriga a refletir sobre a vida.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352806
    m_Localized: 'Widow: Só vai embora daqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352807
    m_Localized: 'Widow: Ele gostava dos meus dentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352808
    m_Localized: 'Widow: Mas eu queria colocar aparelho dentário.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352809
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352810
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: Claro, por que não atira logo em mim?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352812
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352813
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: 'Widow: As pessoas ainda choram nesse novo mundo? Elas com certeza não conseguem mais rir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352815
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352816
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: Você tá louco?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: 'Widow: Me diz, por favor: VOCÊ TÁ LOUCO?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: 'Widow: Se aqueles demônios mandassem você dançar descalço em uma frigideira, você seria o primeiro a tirar os sapatos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: 'Widow: Você... porra... eu não tenho palavras.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: 'Widow: E aí? Já pode sacar a sua arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352823
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352824
    m_Localized: Sacar a sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: Caralho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: 'Widow: Só aperta o gatilho. A FEMA assassinou minha alma. Você pode terminar o serviço com o meu corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352827
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352828
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352829
    m_Localized: 'Widow: Eu não penso mais sobre o aparelho dentário.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352830
    m_Localized: 'Widow: Até você pedir pra ver meus dentes, eu nem lembrava mais da existência dessa ideia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352832
    m_Localized: 'Widow: Ai, deus... eu só tô exausta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352833
    m_Localized: 'Widow: Eu desconto em todo mundo ao meu redor. Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352834
    m_Localized: 'Widow: Não é culpa de ninguém. Só de uns escrotos em específico.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352835
    m_Localized: 'Widow: Eu não entendo. E eu não quero entender.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352836
    m_Localized: 'Widow: Humilhar alguém que acabou de perder...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352837
    m_Localized: 'Widow: Só um instante...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352838
    m_Localized: 'Widow: Uuf. Você sacou a arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352839
    m_Localized: 'Widow: E acabou não me matando.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352840
    m_Localized: 'Widow: O que foi que aconteceu? Insegurança? Não precisava demonstrar dessa forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: O que é que você quer verificar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352842
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352843
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352844
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352845
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352846
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352847
    m_Localized: Orelhas
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352848
    m_Localized: 'Scammer: Os dentes eu consigo fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352849
    m_Localized: 'Scammer: Meu mano era um dentista.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352850
    m_Localized: 'Scammer: E adivinha só? Eles arrancaram TODOS os dentes dele! HAHAHAHAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352851
    m_Localized: 'Scammer: Ah, você só quer vê-los. Belê.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352853
    m_Localized: 'Scammer: Tudo tranquilo, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352854
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352855
    m_Localized: Sacar a sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352856
    m_Localized: 'Scammer: Aê, que porra é essa? Foi uma história perfeitamente normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352857
    m_Localized: 'Scammer: Mas enfiar uma bala na minha testa por conta dos meus dentes? Não saquei essa, não.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352858
    m_Localized: 'Scammer: Por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352859
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352860
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: Tá pirado?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: 'Scammer: Cara, chupa a minha pi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: 'Scammer: Mas que caralhos? Eu sou só um cara normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: 'Scammer: Eu não faço bizarrice nenhuma com as unhas, cara, olha só, tá vendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352866
    m_Localized: 'Scammer: Não me leva a mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352867
    m_Localized: 'Scammer: Eu lavo elas. Eu acabei de pegar uma moeda do chão.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352868
    m_Localized: 'Scammer: Elas estão limpas. Eu vou lavar as mãos hoje, cara. Me dá essa chance.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352869
    m_Localized: 'Scammer: Eu lavo elas, mano. Eu só ainda não tive tempo de fazer isso hoje.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352870
    m_Localized: 'Scammer: Estão limpas. A maioria.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352871
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352872
    m_Localized: Sacar a sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352873
    m_Localized: 'Scammer: Vai mandar um cara pra vala por conta de uma unha suja?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352874
    m_Localized: 'Scammer: Beleza. Eu só achei que não ia morrer de um jeito tão idiota assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352875
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352876
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352877
    m_Localized: 'Scammer: Me parece uma forma estranha de identificar esses monstrengos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352878
    m_Localized: 'Scammer: Você consegue dizer quem é otário e pau no cu pelas mãos. O que os Visitantes tem a ver com isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352879
    m_Localized: 'Scammer: Você teria que acordar às 9 da manhã e trabalhar por pelo menos 4 horas. Que merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352880
    m_Localized: 'Scammer: Meus olhos estão coçando muito ultimanente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352881
    m_Localized: 'Scammer: Você acha que é por conta do sol? Ou o quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352883
    m_Localized: 'Scammer: Merda, mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352884
    m_Localized: 'Scammer: Isso é algum tipo de doença.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352885
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352886
    m_Localized: Sacar a sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352887
    m_Localized: 'Scammer: Se liga, tive uma ideia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352888
    m_Localized: 'Scammer: Vamos pegar o dinheiro das outras pessoas para não termos que disparar no rosto delas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352889
    m_Localized: 'Scammer: Quê? Você precisa pensar sobre isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352890
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352891
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352892
    m_Localized: 'Scammer: Beleza, eu entendo se você não gosta da correria. Mas eu realmente tô com algum tipo de doença no olho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352893
    m_Localized: 'Scammer: Se você tivesse ao menos um colírio...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352894
    m_Localized: 'Scammer: Eu ainda assim não compraria. Tenho meus motivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352895
    m_Localized: 'Scammer: Quer tirar uma fotografia? Vá em frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352896
    m_Localized: 'Scammer: Eu tenho fotossensibilidade. Pode ser que eu pisque os olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352897
    m_Localized: 'Scammer: (Você tira uma foto dele.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352898
    m_Localized: 'Scammer: (A foto parece normal, mas o rosto...)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352899
    m_Localized: 'Scammer: (Saiu todo borrado.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352900
    m_Localized: 'Scammer: Te disse.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352901
    m_Localized: 'Scammer: Quer tirar mais uma?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352902
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352903
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352904
    m_Localized: 'Scammer: Não vai querer me enrolar, não, mano. Esquenta logo esses bichos aí!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352905
    m_Localized: 'Scammer: Mantenha eles em forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352906
    m_Localized: 'Scammer: Caso contrário eles vão relaxar e esquecer em qual casa estão e não vão pagar nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352907
    m_Localized: 'Scammer: Espera!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352908
    m_Localized: 'Scammer: Vai se foder você e a sua casa. Tô caindo fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352909
    m_Localized: 'Scammer: Vou lá ficar de cara pro sol. Vou deixar isso bater na sua consciência.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352910
    m_Localized: 'Scammer: Mas que cacete.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352911
    m_Localized: 'Scammer: Você escolheu a coisa errada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352912
    m_Localized: 'Scammer: Você é quem manda aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352913
    m_Localized: 'Scammer: E aí, qual é o veredito? Tudo certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352914
    m_Localized: Deixar ele em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352915
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352916
    m_Localized: 'Scammer: Calma, peraí! Tá, merda, teve uma vez que eu tentei me depilar e continuei fazendo isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352917
    m_Localized: 'Scammer: Só não conta pra ninguém. Você não é fofoqueiro, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352918
    m_Localized: 'Scammer: Calma, peraí! Isso é tipo pedir para ver minha cueca.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352919
    m_Localized: 'Scammer: Você sabe que um homem civilizado não pode ter as axilas queimadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352920
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352921
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352922
    m_Localized: 'Scammer: Eu sabia que tu era firmeza. Você não atacaria pessoas normais. Hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352923
    m_Localized: 'Scammer: Por que a gente não vai botar uma pressão naqueles babacas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352924
    m_Localized: 'Scammer: Não? De boa. Té mais tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352925
    m_Localized: 'Scammer: Eu sei que você tá começando a se estressar por conta dessa merda toda com os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352926
    m_Localized: 'Scammer: E você tá fazendo isso tudo por nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352927
    m_Localized: 'Scammer: Enfim, sem ressentimentos, de verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: O que é que você quer verificar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: Orelhas
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: 'Daughter: Meus dentes? Você quer que eu te mostre meus dentes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: 'Daughter: Por quê? Ainda tenho alguns dentes de leite. Papai dizia...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: Eu não vou mais chorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: Bem, aqui estão.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: O que isso significa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: Tá tudo certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: Eu já sei cortar as unhas sozinha.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: Ainda não sou boa nisso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: Olha.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: Muito bom, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: 'Daughter: Eu mesmo cortei. Foi euzinha. Eu mesma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: 'Daughter: Estou indo. Quero ficar só.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: Você pode olhar dentro dos meus olhos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: 'Daughter: Você verá o que eu estou pensando?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: 'Daughter: Nesse caso, vou pensar com muito cuidado, não se preocupe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352953
    m_Localized: 'Daughter: Que cara é essa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352954
    m_Localized: 'Daughter: Você v-v-viu...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547072
    m_Localized: 'Daughter: Você.... Aaaaaaaaah.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: 'Daughter: Eu q-q-quero uma bebida.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: O que eu preciso fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: 'Daughter: (Você olha para ela e se dá conta que isso é um exagero.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: Você só quer saber como eu estou?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: 'Daughter: Estou cansada. Posso ficar só?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: Uma foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: Eu não tirei muitas fotos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: Você vai me mostrar depois?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: (Você tira uma foto dela.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: (A imagem sai um pouco embaçada.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: 'Daughter: (Ela correu até você sem esperar a foto terminar de capturar.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: Huuum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: Obrigada...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: 'Daughter: Eu não gosto disso. Não me peça por mais fotos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: 'NotTrue: Hehe. Bem, pode prosseguir com a verificação, docinho. Você não vai ver nada que já não tenha visto antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: Orelhas
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: Meus dentes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NotTrue: Aaaaaah.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: 'NotTrue: Sabe, esses dentes... Ah, eu odiava tanto eles. Eu só pensava em arrancar todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: 'NotTrue: Veja meus dedos, eles não conseguem contar, empilhar ou medir direito.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: 'NotTrue: Eles te dão só o suficiente. Só o suficiente para você não ficar sem nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: 'NotTrue: Ah, querido... você tem certeza que quer isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: 'NotTrue: Os olhos são as janelas da alma. Como a luz é para as casas e a verdade para as pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: 'NotTrue: Mas os meus estão empoeirados... os vidro está rachado... as mariposas já comeram as cortinas séculos atrás...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: 'NotTrue: Não olhe, querido. Não há nada lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: 'NotTrue: Hein? Vai fazer uma idosa levantar as pelancas? Você não tem vergonha? Eu mal consigo me levantar!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: 'NotTrue: Bom, o que você pode fazer? Quem manda é o dono.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: Então?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: 'NotTrue: Quê? Pra que você vai desperdiçar o filme da câmera comigo? O rolo tá claramente acabando... Você insiste? Bem, fico feliz com isso!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: Então, o que você achou, querida?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: Sacar a sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: 'NotTrue: Haha! Que ideia, querida.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: 'NotTrue: Eles são completamente normais. Eu escuto como sempre. Mas, você sabe... Às vezes eu sinto que já não estou mais aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: 'NotTrue: É como se eu só aparecesse pra quem olha de longe, lá por cima, e olhe lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: 'NotTrue: Ei, tá apontando isso pra mim por quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: 'NotTrue: Não tem nada pior que uma idosa banguela.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: 'NotTrue: Acha que eu tô com medo? Que estou apegada a eles?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: 'NotTrue: Foram tantas tentativas de segurar o vento que até meus dedos sabem que nada permanece nas minhas mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: Então, é assim...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: 'NotTrue: Você não acredita em mim? Quer verificar? Bem aqui, dê uma olhada...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: 'NotTrue: Eu costumava também olhar as pessoas nos olhos. Isso me lembra daqueles dias...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: 'NotTrue: Então, querido, é como um carimbo da velhice. Todo mundo que vive recebe um presente como esse. Você não sabia?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: 'NotTrue: O fungo não sente dor. Não pede para comer. Ele só existe. Ele existe para viver. Como eu, hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: 'NotTrue: Que foi? Vai surtar por isso também?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: 'NotTrue: O que é isso, querida? Você consegue concluir alguma coisa só pelas minhas orelhas?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: 'NotTrue: Tá. Tô nem aí. Por mim, tudo bem. O que importa para mim, querido? Eu já queria me encontrar com deus faz um bom tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: É só que...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: 'NotTrue: Eu paguei um médico para tirar todos, mas ele não conseguiu fazer o serviço de uma vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: 'NotTrue: Eu ia lá ver ele e tirava um ou dois de uma vez... Não conseguia remover todos. Os médicos não tem tempo para isso agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: 'NotTrue: E assim, querido, eu vivo com esse serviço inacabado em minha boca.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: 'NotTrue: As mãos são para quem as segura. Eu parei de fazer isso faz muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: 'NotTrue: Estender as mãos? Por quê? Você mesmo pode estendê-las.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: 'NotTrue: Se joga nas asas do vento e vem descendo o rio... Para a minha cabana, querido. Pode entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: 'NotTrue: Você acha que pode escapar desse destino? Bem, só se você morresse jovem. Mas é melhor você se cuidar!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: 'NotTrue: Você é tão bonito! Seria um pecado expurgar tanta beleza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: 'NotTrue: Nos meus tempos só os ricos tinham dispositivos assim. Mas agora, bem, qualquer homem que esteja apto pode os usar!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: 'NotTrue: Não tenho nada para te dizer. Você tá sendo um idiota. Enchendo o saco de gente do bem, sem motivo nenhum...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547160
    m_Localized: 'Alkonost: Só não enche o saco da minha irmã.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547161
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547162
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547163
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547164
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547165
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547166
    m_Localized: Orelhas
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547167
    m_Localized: 'Alkonost: Nossa família sempre teve dentes fortes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547168
    m_Localized: 'Alkonost: Quando eu era adolescente, eu tentei abrir uma cerveja com o dente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547169
    m_Localized: 'Alkonost: Não deu bom. Mas me ensinou a cuidar dos meus dentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547170
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547171
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547172
    m_Localized: 'Alkonost: Minha irmã não tem a mínima condição de se cuidar. É por isso que minhas mãos estão sempre cheias.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547173
    m_Localized: 'Alkonost: E as mãos? Como é que ficam? Quando elas são responsáveis por duas vidas ao mesmo tempo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547174
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547175
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547176
    m_Localized: 'Alkonost: É, minha irmã chora muito, mas nossos olhos ainda se parecem muito. Só que o olhar dela é mais calmo, mais quieto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547177
    m_Localized: 'Alkonost: Isso me preocupa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547178
    m_Localized: 'Alkonost: É, minha irmã chora muito, mas nossos olhos ainda se parecem muito. Eles não são vermelhos, foi isso o que eu quis dizer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547179
    m_Localized: 'Alkonost: Talvez ela já tenha chorado tudo o que podia chorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547180
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547181
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547182
    m_Localized: 'Alkonost: Vou te mostrar. Mas, por favor, não incomoda a minha irmã, tá? Ela tá super cansada disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547183
    m_Localized: 'Alkonost: Eu normalmente me depilo. Tento me cuidar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547184
    m_Localized: 'Alkonost: Mesmo nesses tempos de pura insanidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547185
    m_Localized: 'Alkonost: Eu normalmente cuido de mim, mas eu não trouxe uma gilete.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547186
    m_Localized: 'Alkonost: De qualquer forma, não tenho tempo pra esse tipo de coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547187
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547188
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547189
    m_Localized: 'Alkonost: Minha irmã e eu ná passamos por muita coisa nessa vida. Guarda essa arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547190
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547191
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547192
    m_Localized: 'Alkonost: Eu comecei a fumar há pouco tempo. Por conta de gente como você.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547193
    m_Localized: 'Alkonost: Você acha que é o único que passa por perrengues?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547194
    m_Localized: 'Alkonost: Acha que pode apontar essa arma aí para qualquer pessoa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547195
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547196
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547197
    m_Localized: 'Alkonost: Qual é o objetivo? Meu olhar parece muito rápido ou vazio para você?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547198
    m_Localized: 'Alkonost: Qual é objetivo? Meu olhar parece muito vazio para você?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547199
    m_Localized: 'Alkonost: Você acha que está diferente de alguma maneira?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547200
    m_Localized: 'Alkonost: Você deve se acalmar e não tomar decisões baseadas em emoções. Eu digo isso para a minha irmã o tempo todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547201
    m_Localized: 'Alkonost: É vergonhoso eu ter que te dizer isso também.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547202
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547203
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547204
    m_Localized: 'Alkonost: Espera. O noticiário mostrou mesmo que as axilas DESSE JEITO são um sinal de Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547205
    m_Localized: 'Alkonost: Pense um pouco mais. Não faça nenhuma estupidez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547206
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547207
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547208
    m_Localized: 'Alkonost: Então é assim que a minha história vai acabar?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547209
    m_Localized: 'Alkonost: Agridoce, sem o doce...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547210
    m_Localized: 'Alkonost: A vida sempre testou nossas forças. Tudo sempre foi muito difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547211
    m_Localized: 'Alkonost: A minha irmã não aguentou. Ela desistiu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547212
    m_Localized: 'Alkonost: Agora eu entendo. Você acabou em uma situação delicada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547213
    m_Localized: 'Alkonost: Mas se você deixar o pânico se instaurar, isso te faz diferente de alguma forma dos Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547214
    m_Localized: 'Alkonost: O que acontecerá se você continuar isolada dos outros?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547215
    m_Localized: 'Alkonost: Você sabe, eu tô farta disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547216
    m_Localized: 'Alkonost: Eu quero tanto respirar aliviada e não sentir medo constantemente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547217
    m_Localized: 'Alkonost: Mas é tudo a mesma merda, e parece que não há nem uma luz no fim do túnel.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547218
    m_Localized: 'Alkonost: Falando sério, eu tô com muito medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547219
    m_Localized: 'Alkonost: O que acontece agora? Os Visitantes vão desaparecer ou a gentre vai ter que dividir nossas cidades com eles para sempre?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547220
    m_Localized: 'Sirin: Faz logo isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547221
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547222
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547223
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547224
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547225
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547226
    m_Localized: Orelhas
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547227
    m_Localized: 'Sirin: Dê uma olhada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547228
    m_Localized: 'Sirin: Você vai arrancá-los?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547229
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547230
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547231
    m_Localized: 'Sirin: A minha irmã me ajuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547232
    m_Localized: 'Sirin: Mas é inútil, sem sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547233
    m_Localized: 'Sirin: Ela deveria ter...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547234
    m_Localized: 'Sirin: Ela deveria ter me deixado morrer naquela vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547235
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547236
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547237
    m_Localized: 'Sirin: Eu e minha irmã temos olhos parecidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547238
    m_Localized: 'Sirin: Mas os delas são tão vazios.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547239
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547240
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547241
    m_Localized: 'Sirin: Minha irmã raspa minhas axilas. Ela cuida de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547242
    m_Localized: 'Sirin: Acho que não foi em vão.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547243
    m_Localized: Deixar ela em paz
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547244
    m_Localized: Pegar sua arma
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547245
    m_Localized: 'Sirin: Tudo de bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547246
    m_Localized: 'Sirin: Leve minha alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547247
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547248
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547249
    m_Localized: 'Sirin: Não há necessidade para isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547250
    m_Localized: 'Sirin: De qualquer forma, a morte já está próxima.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547251
    m_Localized: 'Sirin: Você pode deixar comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547252
    m_Localized: 'Sirin: Me passa a arma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547253
    m_Localized: 'Sirin: Eu vou fazer isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547254
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547255
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547256
    m_Localized: 'Sirin: O vazio não irá embora quando eu fechar meus olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547257
    m_Localized: 'Sirin: Só será transferido para você.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547258
    m_Localized: 'Sirin: Você gosta disso?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547259
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547260
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547261
    m_Localized: 'Sirin: Então?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547262
    m_Localized: 'Sirin: Você vai apertar o botão vermelho?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547263
    m_Localized: Atirar nela
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547264
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547265
    m_Localized: 'Sirin: Tá faltando coragem?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547266
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547267
    m_Localized: 'Sirin: De qualquer forma, você vai morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547268
    m_Localized: 'Sirin: Uma lástima.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547269
    m_Localized: 'Sirin: Talvez na próxima vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547270
    m_Localized: 'Sirin: Uma lástima.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547271
    m_Localized: 'Sirin: Eu não tenho os sinais.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547272
    m_Localized: 'Sirin: Talvez na próxima vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547273
    m_Localized: 'Sirin: E se estivermos só esperando um buraco negro engolir todos nós?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547274
    m_Localized: 'Sirin: Estaremos sendo sugados para o horizonte de eventos durante um longo tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547275
    m_Localized: 'Sirin: E nós nunca veremos a nossa própria morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547276
    m_Localized: 'Sirin: Agonia eterna e a antecipação da morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547277
    m_Localized: 'Sirin: Não importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547278
    m_Localized: 'Sirin: Esperarei a minha hora, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547279
    m_Localized: 'Sirin: Minha música...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547280
    m_Localized: 'Sirin: Mas foi feita para você!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547281
    m_Localized: 'Sirin: Teve um final feliz!'
    m_Metadata:
      m_Items: []
