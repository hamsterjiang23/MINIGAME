  - m_Id: 41582931045507536
    m_Localized: 'Cultist1: Estou cansado dos preparativos.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507537
    m_Localized: Deixar quieto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507538
