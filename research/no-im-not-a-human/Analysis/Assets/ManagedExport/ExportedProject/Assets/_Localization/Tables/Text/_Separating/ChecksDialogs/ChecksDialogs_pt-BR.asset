  - m_Id: 41582931045507551
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507552
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507553
    m_Localized: Deixar quieto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507554
    m_Localized: Sacar a arma
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507555
    m_Localized: 'Cultist1: Ainda não está na hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507556
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507557
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507558
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507559
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507560
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507561
    m_Localized: 'Cultist1: Tenha cuidado com o que você deseja.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507562
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507563
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507564
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507565
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507566
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507567
    m_Localized: 'Cultist1: Isso não tem mérito algum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507568
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507569
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507570
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507571
    m_Localized: Atirar
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507572
    m_Localized: Ouvir
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507573
    m_Localized: 'Cultist1: Me diga... Você se importa tanto com esses testes por que?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507574
    m_Localized: 'Cultist1: Só esteja preparado para partir quando a hora chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507575
    m_Localized: 'Cultist1: Não tenho conhecimento sobre as suas expectativas, ou o que você espera.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507576
    m_Localized: 'Cultist1: Eu não tenho mais nada para dizer.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507577
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507578
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507579
    m_Localized: 'Cultist1: Faz muito tempo desde a última vez em que eternizaram a minha imagem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507580
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507581
    m_Localized: 'Cultist1: Você irá responder por suas ações.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507582
    m_Localized: 'Cultist1: Você cometeu um grande erro.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507583
    m_Localized: 'Cultist2: Não há necessidade em ter medo. Todos nós iremos para um reino melhor, nós seremos salvos.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507584
    m_Localized: Dentes
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507585
    m_Localized: Mãos
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507586
    m_Localized: Olhos
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507587
    m_Localized: Axilas
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507588
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507589
    m_Localized: Orelhas
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507590
    m_Localized: 'Cultist2: É claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507591
    m_Localized: 'Cultist2: Tortos... e talvez um pouco maiores do que o normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507592
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
