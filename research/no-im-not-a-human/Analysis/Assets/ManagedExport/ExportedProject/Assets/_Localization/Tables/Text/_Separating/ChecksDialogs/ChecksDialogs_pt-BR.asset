    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507597
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507598
    m_Localized: 'Cultist2: Todos nós compartilhamos o sofrimento de adversidades.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507599
    m_Localized: Deixar quieto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507600
    m_Localized: Sacar a arma
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507601
    m_Localized: 'Cultist2: O sono repousa além do nosso alcance.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507602
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507603
    m_Localized: 'Cultist2: Eles dizem que isso apressa a chegada inevitável da Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507604
    m_Localized: Deixar quieto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507605
    m_Localized: Sacar a arma
