  - m_Id: 41582931045507541
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507542
    m_Localized: Deixar quieto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507543
    m_Localized: Sacar a arma
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507544
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507545
    m_Localized: 'Cultist1: Se é esse o seu decreto.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507546
    m_Localized: 'Cultist1: ...'
