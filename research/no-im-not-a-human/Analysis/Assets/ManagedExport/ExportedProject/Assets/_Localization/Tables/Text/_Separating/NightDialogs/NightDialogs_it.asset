%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_it
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: e2adf5c0928e69a42a85516c84d58249, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: Ehi! *coff coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: Posso entrare, amico?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: Chi sei?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: Che ti è successo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: 'Firefighter: Sono un *coff coff* pompiere.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: 'Firefighter: Sono rimasto sotto il sole mentre cercavamo di spegnere gli incendi nel bosco.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: 'Firefighter: Il fumo denso ci ha impedito di bruciare vivi, ma *coff coff* è stato comunque orribile.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: 'Firefighter: Gli alberi... *coff coff* sono avvampati come fiammiferi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: Non avevo mai visto nulla del genere.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: 'Firefighter: La foresta era disseminata di carcasse di animali carbonizzate.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: Perché non sei andato in ospedale?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: E ora cosa farai?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: 'Firefighter: Sono rimasto sotto al sole di mezzogiorno *coff coff* mentre spegnevo gli incendi nel bosco.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: Sono l''unico rimasto della mia squadra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: 'Firefighter: Gli altri... *coff coff* Il capo non ha voluto lasciarli andare via.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: Ora il loro turno durerà per sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: Perché non sei andato in ospedale?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: E ora cosa farai?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: 'Firefighter: In ospedale? Non ci sono più gli ospedali, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: 'Firefighter: L''arrivo dei Visitatori li ha resi completamente inutili.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: 'Firefighter: È difficile accettare delle cure quando non puoi fidarti di chi le somministra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: È troppo tardi per me ormai.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: 'Firefighter: Avrei fatto meglio a spegnere quegli incendi e restare lì a morire, con i miei compagni.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: Tanto non mi resta comunque molto da vivere.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: 'Firefighter: Dovevo continuare a spegnere quegli incendi. Vorrei essere morto lì al posto degli altri.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: 'Firefighter: Ma mi avevano fatto intendere chiaramente *coff coff* che avevo fatto abbastanza.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: 'Firefighter: Ora non posso più tornare a casa. I mezzi pubblici hanno smesso di funzionare.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: L''unica cosa che mi resta è confidare nella solidarietà umana.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: Grazie, amico. *coff coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: 'Firefighter: Non credo che ti starò tra i piedi ancora per molto. *coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: 'Firefighter: Ma almeno non morirò per strada, solo come un cane.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: Merda, amico... *coff coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: Non voglio morire per strada solo come un cane...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: 'Firefighter: Spero che *coff coff* gli incendi non raggiungano le città.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: Ehiii, che mi dici?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: 'Wheelchair: Da quanto non ci si vede, eh? Come va la vita?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: Ci conosciamo...?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: Chi sei?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: 'Wheelchair: Ma dai... Davvero non ti ricordi di me?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: Eravamo...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: 'Wheelchair: Aspetta, la tua voce è diversa da come me la ricordavo...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: Da quant''è che vivi qui?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: Questa casa appartiene alla mia famiglia da sempre.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: Credo tu abbia sbagliato indirizzo...
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: Ah, ma tu non sei...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: Non sei il mio amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: Da quant''è che vivi qui?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: Questa casa appartiene alla mia famiglia da sempre.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: Credo tu abbia sbagliato indirizzo...
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: Nah, impossibile.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: 'Wheelchair: Non ho mai commesso un errore in vita mia! Ho una memoria di ferro, persino migliore degli elefanti!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: 'Wheelchair: Sono sicuro che il mio amico vive... beh, viveva qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: 'Wheelchair: Senti, ho fatto parecchia strada per arrivare fin qua. Che ne dici di farmi entrare, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: Impossibile, non posso aver...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: No...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: Dannazione...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: Mi sa tanto che ho sbagliato per davvero.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: 'Wheelchair: Senti, ho fatto parecchia strada per arrivare fin qua. Che ne dici di farmi entrare, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: Oh oh! Ora ci capiamo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: Sembra proprio una casetta bella spaziosa! Ti va di fare a gara? Tra 3... 2... 1... VIA!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: 'Wheelchair: Andarmene? Che cazzo vuol dire "andarmene"?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: 'Wheelchair: Ti aspetti davvero che me ne vada?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: 'Wheelchair: Ohhh, sai che ti dico? Me ne vado eccome, brutto stronzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: 'Mother: Basta! Sta'' ferma e smettila di agitarti.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: 'Mother: Ciao. Potresti aiutarci, per favore?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: Cos'è successo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: Cosa posso fare per voi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: 'Mother: Sono esausta. Mi servirebbe solo un posto dove dormire.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: Avevo cinque figli. Lei è l''unica rimasta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: 'Mother: Anche mio marito è scomparso. Non so se è morto o se ci ha abbandonato, ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: 'Mother: Ora vorrei solo sdraiarmi e riposare un po''.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: Dove sono finiti i tuoi figli?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: I tuoi figli sono morti?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: 'Mother: Vorrei che ci facessi entrare. Ho bisogno di dormire, sono sfinita...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: 'Mother: Avevo cinque figli. Lei è l''unica rimasta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: 'Mother: Non so nemmeno da dove cominciare per cercarli. Vorrei solo dormire un po''...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: Dove sono finiti i tuoi figli?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: I tuoi figli sono morti?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: 'Mother: Non lo so. Chissà, forse li ha presi il padre. Andrei a casa sua, se solo ne avessi le forze.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: 'Mother: È vero, litigavamo spesso, ma non è facile andare d''accordo con qualcuno che si comporta da stronzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: 'Mother: Ma tutto questo non ha più importanza... L''unica cosa che conta è trovare i miei figli.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: Entrate.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: Dovreste andarvene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: Non dirlo neanche per scherzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: 'Mother: È dura stare appresso a un branco di marmocchi, ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: 'Mother: Sono sicura che non gli sia successo nulla. Saranno andati a casa di mia madre...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: 'Mother: Scappano sempre da lei quando si stufano di me.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: 'Mother: O quando loro padre viene a chiedere soldi... per l''ennesima volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: 'Mother: Allora, ci fai entrare? Voglio solo riposare e andare a cercare i miei figli.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: Entrate.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: Dovreste andarvene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: Finalmente un attimo di pace.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: 'Mother: Forza, sbrigati. Trovati un posto dove stare.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: Domani ce ne andiamo, promesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: 'Mother: E va bene, vorrà dire che cercherò di raggiungere casa di mia madre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: Sempre se ce la faccio...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: No, devo farcela. Devo...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: Ciao, cittadino.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: 'Anger: Sono di pessimo umore, quindi mi scuso in anticipo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: 'Anger: È pieno di imbecilli là fuori. Spero che tu non sia uno di loro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: Di chi parli?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: Non sarai una di quelle... cose, vero?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: Di tutti, in realtà.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: 'Anger: Di quei bastardi che confidavano nella fede o in altre stronzate simili per evitare di uccidersi a vicenda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: 'Anger: Morti i loro dèi, non è rimasto nulla di umano in loro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: Sono delle dannate bestie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: 'Anger: Come se questa faccenda dei Visitatori non bastasse... ora dobbiamo preoccuparci anche di loro. Cazzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: Perché sei così arrabbiato?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: Cosa ti renderebbe diverso dagli altri?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: Ottima domanda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: 'Anger: Avrai notato che si sono formate due... fazioni, giusto?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: 'Anger: Una è composta da sadici di merda, peggio di qualunque Visitatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: 'Anger: Fanno come cazzo gli pare. Ti punterebbero una pistola alla testa solo per vederti stramazzare a terra!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: 'Anger: Gli altri sono degli stupidi cagnolini. Calpestali e ti ringrazieranno per aver mostrato loro pietà.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: E mi fanno incazzare tutti quanti a morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: Perché sei così arrabbiato?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: Cosa ti renderebbe diverso dagli altri?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: 'Anger: Senza offesa, ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: 'Anger: Prima il sole, ora quei maledetti Visitatori... Sembra che l''umanità sia con un piede nella fossa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: 'Anger: E sono furioso... Volevo solo condurre una vita normale, cazzo! Capisci?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: 'Anger: Componevo musica. Chi sentirà più quella merda, ormai?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: Ora voglio solo evitare di schierarmi con una delle due parti.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: Voglio credere di esserlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: 'Anger: Il solo pensiero di diventare come uno di quei pazzoidi mi terrorizza.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: 'Anger: O una vittima senza spina dorsale... Ma se ne andassero tutti a fanculo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: Anche se, pensandoci bene...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: Quelli che fanno le vittime, probabilmente, sono i peggiori.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: 'Anger: Se ne stanno lì, impalati, a contare i secondi prima che qualcuno rompa loro i denti o chissà cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: 'Anger: Fidati, se avessi visto quello che ho visto io capiresti perché mi incazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: 'Anger: Tranquillo, non ti sarò di disturbo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: E no, non picchierò nessuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: 'Anger: Rivolgo la mia rabbia contro me stesso, per evitare che qualcuno si faccia male.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: 'Anger: Cazzo, sei fottuto di testa, proprio come tutti quei codardi piagnucoloni.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: 'Anger: Te ne starai lì a incassare mentre ti spaccano la faccia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: Porca puttana maledetta!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: Percepisco un''energia stagnante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: Qui dentro sta succedendo qualcosa di molto spiacevole.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: 'FortuneTeller: Il Sole e il Leone sono nella Quinta Casa. Riesco a vederlo chiaramente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: 'FortuneTeller: Sei un tipo piuttosto assertivo, o sbaglio?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: Eh?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: Grazie, ma non mi serve nulla.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: Vedo che preferisci agire piuttosto che parlare.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: Tipico del Leone, non è vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: 'FortuneTeller: Qui dentro hai accumulato una gran quantità di energia negativa. Sì, confermo, è davvero spiacevole...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: Ma non so ancora spiegarti né come né perché.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: 'FortuneTeller: Sembra tutto così trascurato... Forse dovrei iniziare anch''io a essere più assertiva.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: Grazie per avermi confuso ancora di più.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: Ok, ma quindi...?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: Non volevo invadere la tua privacy, caro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: 'FortuneTeller: Vorrei solo aiutarti a comprendere la relazione causa‑effetto dietro alla sofferenza all''interno di queste mura.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: 'FortuneTeller: Un sessantanove karmico, come due banchi di pesci che nuotano in cerchi contrapposti.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: 'FortuneTeller: Una mano lava l''altra, hai presente?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: Grazie per avermi confuso ancora di più.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: Ok, ma quindi...?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: 'FortuneTeller: Capisco che tutto questo possa sembrare stressante per un ascendente Capricorno come te.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: 'FortuneTeller: Non è facile destreggiarsi tra così tante costellazioni. Sei un tipo complesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: 'FortuneTeller: È grazie all''assertività che possiamo raggiungere gli abissi del nostro cosmo interiore. Capisci cosa intendo, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: 'FortuneTeller: Solo allora tutto acquisterà un senso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: 'FortuneTeller: Tra le tue precedenti incarnazioni ci sono state delle guardie carcerarie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: 'FortuneTeller: Concedi loro spazio. Stai solo replicando le esperienze delle tue vite passate.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: 'FortuneTeller: Devi perdonarle e accettare che dimorino dentro di te.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: 'FortuneTeller: Solo allora potrai spezzare le catene di questo ciclo infinito.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: Capisci cosa intendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: 'FortuneTeller: Ah, che splendida notizia. Tra l''altro, ti trovi in una posizione eccellente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: C''è una potente corrente di energia positiva che scorre attraverso la tua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: 'FortuneTeller: Quindi, mi stai dicendo che non sei interessato a lavorare su te stesso?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: A diventare una versione migliore di te?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: Una vera tragedia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: 'FortuneTeller: Mi assicurerò di provocarti un attacco di diarrea esplosivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: Buonasera.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: 'Gasmask: Sono della FEMA. Stiamo effettuando visite a domicilio per controllare come stanno i residenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: È da solo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: Chi mi dice che posso fidarmi di lei?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: No, ovviamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: 'Gasmask: Ci siamo divisi in squadre per coprire un''area più ampia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: Non le ruberò molto tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: Perché indossa una tuta protettiva? Dobbiamo procurarcela anche noi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: È venuto ad aiutarci?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: Posso mostrarle il mio tesserino, se questo la tranquillizza.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: 'Gasmask: Ma i Visitatori raramente si muovono in gruppo, se non addirittura mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: Perché indossa una tuta protettiva? Dobbiamo procurarcela anche noi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: È venuto ad aiutarci?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: 'Gasmask: Può farlo, se la fa sentire meglio, ma non è necessario.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: 'Gasmask: Stiamo ancora studiando l''effetto del sole sull''ambiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: 'Gasmask: E dobbiamo tutelarci, considerato che passiamo molto tempo all''aperto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: Quindi, come posso aiutarla?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: La FEMA ha un piano d'emergenza?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: 'Gasmask: Al momento, ci stiamo occupando di raccogliere dati da inviare al quartier generale.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: Una volta fatto, sarà possibile elaborare una strategia d''intervento adeguata.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: 'Gasmask: Nel frattempo, le chiediamo di mantenere la calma.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: Quindi, come posso aiutarla?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: La FEMA ha un piano d'emergenza?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: Preleverò una persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: 'Gasmask: Eseguiremo dei test per assicurarci che stia bene e determinare se può vivere in zona in tutta sicurezza.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: 'Gasmask: E verificheremo anche se è un essere umano, ovviamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: Devo fare i bagagli?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: Quindi, dovrò solo rimanere qui ad aspettare?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: 'Gasmask: Certamente. Ma non possiamo mettere in atto alcun piano senza prima raccogliere dati a sufficienza.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: Per questo preleverò uno dei residenti di questa casa e lo scorterò ai nostri laboratori.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: 'Gasmask: Eseguiremo alcuni test per assicurarci che sia tutto in ordine, poi lo rimanderemo indietro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: Devo fare i bagagli?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: Quindi, dovrò solo rimanere qui ad aspettare?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: Lei è il padrone di casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: 'Gasmask: In tal caso, può rimanere. Verrà avvisato nel caso diventi necessaria un''evacuazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: Preleveremo uno dei suoi ospiti, poi ce ne andremo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: Buonanotte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: 'Gasmask: Sì. Una volta ottenute maggiori informazioni, forniremo istruzioni a tutti i cittadini.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: Al momento, non ha alcun motivo di preoccuparsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: 'Gasmask: Preleveremo uno dei suoi ospiti e le faremo avere notizie al più presto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: Sia prudente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: 'Prophet: Quindi, ci incontriamo di nuovo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: 'Prophet: La situazione è leggermente cambiata dall''ultima volta, eppure eccoci qui...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: 'Prophet: Uhm, mi rendo conto che possa sembrare bizzarro e non so bene come spiegarlo, ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: 'Prophet: Mi piacerebbe iniziare questa conversazione... con una piccola divinazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: 'Prophet: Predici il mio futuro scegliendo una pagina di questo libro: in che punto dovrei aprirlo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: Verso l'inizio.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: Al centro.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: Verso la fine.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: 'Prophet: "Presto i morti parleranno, ma nessuno darà loro ascolto."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: Santo cielo...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: È terribilmente calzante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: Anche se, vista la situazione, non dovrebbe affatto sorprendere.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: Che significa?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: Ci credi sul serio?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: Chi sei?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: 'Prophet: "Dici a me? Io sono io. E tu? Tu eri casa."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: 'Prophet: Uhm, una storia davvero tragica.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: 'Prophet: È questo che ci attende?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: Beh, tutto è possibile.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: Che significa?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: Ci credi sul serio?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: 'Prophet: "È stato molto tempo fa. Forse era solo un sogno. Magari tu, io e il pesce...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: 'Prophet: ... esistiamo solo nella memoria di qualcuno che ha smesso di esserci da tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: 'Prophet: Forse nessuno di noi esiste davvero, e fuori sta solo piovendo."'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: Uhm, sembra proprio che questo mondo svanirà molto, molto presto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: 'Prophet: E tu, che ne pensi? Abitiamo il sogno di qualcun altro? O siamo noi i sognatori?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: Un quesito interessante, non credi?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: Che significa?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: Ci credi sul serio?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: 'Prophet: Dovrò rifletterci attentamente. Hai qualche suggerimento da darmi?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: Comunque, sono qui solo per comunicarti un messaggio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: Gli eventi inizieranno presto a concretizzarsi...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: Dovrai farti trovare pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: 'Prophet: Ti sembrerà strano ciò che sto per dire, ma... devi far entrare il gatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: 'Prophet: Non so spiegarti come, ma so per certo che ti sarà d''aiuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: 'Prophet: Puoi decidere liberamente cosa fare di questa informazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: 'Prophet: Per quanto mi riguarda, mi ritirerò a riflettere sui significati profondi della tua divinazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: In parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: 'Prophet: Va interpretato come una sorta di consiglio. Un avviso a non dimenticare o un modo per richiamare l''attenzione.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: Riflettendo sul suo significato più profondo, un messaggio ha illuminato la mia mente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: 'Prophet: Quando gli occhi del gatto incroceranno i tuoi, assicurati di mostrargli l''interno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: Non so ancora spiegarti perché, ma questo dovrebbe renderti tutto più semplice.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: 'Prophet: Per ora, mi ritirerò per riflettere a lungo sulla pagina del libro che hai scelto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: Ehilà, umano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: 'Fanatic: Che fortuna poter assistere con i nostri occhi al giudizio finale!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: 'Fanatic: La Terra verrà purificata dal PECCATO. Il Sole sta compiendo la sua opera sacra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: Siamo sulla strada verso un mondo nuovo e puro!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: 'Fanatic: OSSERVA QUEI FOTTUTISSIMI RAGGI BENEDETTI!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: Eh?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: Mi stai spaventando, amico.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: Sei ancora confuso, UMANO?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: 'Fanatic: Guarda, te lo spiegherò in parole più semplici.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: 'Fanatic: Il Sole non CI ARROSTISCE VIVI senza un motivo! Ci sta purificando dai nostri peccati!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: 'Fanatic: La nostra cupidigia e avidità hanno inquinato questo mondo e hanno fatto INCAZZARE IL SOLE!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: 'Fanatic: QUESTO È IL GIORNO DEL NOSTRO GIUDIZIO!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: 'Fanatic: Ed è una benedizione. Tutti i peccati spariranno e vivremo come ceneri sotto il suo sguardo virtuoso!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: Quindi... dobbiamo morire?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: E tu? Che fine farai?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: Hai PAURA? Ti sta dando di volta il cervello?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: 'Fanatic: Guarda, te lo spiegherò in parole più semplici.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: 'Fanatic: Il Sole non CI ARROSTISCE VIVI senza un motivo! Ci sta purificando dai nostri peccati!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: 'Fanatic: La nostra cupidigia e avidità hanno inquinato questo mondo e hanno fatto INCAZZARE IL SOLE!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: 'Fanatic: QUESTO È IL GIORNO DEL NOSTRO GIUDIZIO!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: 'Fanatic: Ed è una benedizione. Tutti i peccati spariranno e vivremo come ceneri sotto il suo sguardo virtuoso!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: Quindi... dobbiamo morire?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: E tu? Che fine farai?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: Al contrario!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: 'Fanatic: I nostri peccati saranno purificati, persino il Sole stesso potrebbe cessare di esistere. MA NOI VIVREMO.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: 'Fanatic: Non ci saranno più morti, né furti, né avidi STRONZI che si rifiutano di vendermi ciò che voglio a un prezzo equo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: 'Fanatic: Riesci a immaginarlo? Ora capisci perché sta succedendo tutto questo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: E io cosa c''entro?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: 'Fanatic: Vivremo tutti nella BEATITUDINE non appena il Sole avrà completato la sua opera salvifica!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: 'Fanatic: I suoi raggi sacri ci aiuteranno a sfuggire a questo tormento, non capisci?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: 'Fanatic: Fidati, lo vedrai... È per questo che sei ancora vivo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: MOLTO BENE, UMANO! Così potremo discuterne in modo più approfondito!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: 'Fanatic: Oh, ma prima che mi dimentichi: hai della birra, per caso?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: 'Fanatic: Stavi solo fingendo di non sapere nulla del Sole?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: 'Fanatic: Beh, sai che ti dico? Vaffanculo! ANDRÒ A SALVARE QUALCUN ALTRO!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: 'Fanatic: Ciao ciao, testa di cazzo! ADDIO!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: C‑Ciao!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: 'Anxiety: Scusa se ti disturbo a quest''ora, ma... oggi faceva così caldo e alla TV dicono di non uscire di giorno, quindi...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: Non è che avresti, ehm... un posticino libero per me?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: Chi sei?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: Come sei arrivata qui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: Ehm, vivevo appena fuori città.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: 'Anxiety: L''asfalto laggiù si sta riscaldando parecchio, come puoi immaginare, eh eh eh...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: 'Anxiety: Facevo la commessa in un negozio, ma ora non più.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: 'Anxiety: Mi hanno, ehm... licenziato. Ho avuto sempre sfortuna con il lavoro...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: Che farai, ora?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: Cosa pensi che succederà?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: 'Anxiety: Non l''ho fatto apposta... Sì, l''asfalto si starà anche sciogliendo sotto i nostri piedi, ma potrebbe andare peggio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: È solo che, beh... Ora ti verrà da ridere, lo so, eh eh...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: 'Anxiety: Sono venuti dei Visitatori da me. Eh... Riesci a crederci?! Mi hanno cacciato dalla mia stessa casa!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: 'Anxiety: Quindi, ora sto solo cercando un posto dove ripararmi dal sole.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: Che farai, ora?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: Cosa pensi che succederà?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: 'Anxiety: Uhm... Cercherò di sopravvivere in qualche modo? È inquietante qui fuori, con i Visitatori ovunque e il sole che brucia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: 'Anxiety: Ma mi piacerebbe davvero continuare a vivere, eh eh eh... Aghhh...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: Tu non hai paura?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: 'Anxiety: Dimmi che presto sarà tutto finito, ti prego...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: I‑Io... non lo so.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: 'Anxiety: Riuscirò a sopravvivere? Chi mi aiuterà? Quanto tempo mi resta prima che sia troppo tardi?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: 'Anxiety: Non ho idea di cosa succederà... Non riesco proprio a immaginarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: 'Anxiety: Tutto questo non ti spaventa? I‑Io sono terrorizzata.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: 'Anxiety: Grazie... Ah ah! Grazie mille... davvero!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: 'Anxiety: Potrò vivere ancora un po'', grazie al cielo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: 'Anxiety: Ah ah, uhm... Ok, capisco...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: 'Anxiety: Grazie per avermi almeno ascoltato.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: 'Anxiety: Ehm, ok... Allora vado, eh.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: 'Anxiety: Quindi... ciao? Sì, ehm, ciao...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: Posso entrare?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: Mi ero rifugiato in un pub lungo la strada, ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: Mi hanno cacciato. Così, come se nulla fosse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: 'Esenin: Perché? Tsk, immagino che non tutti mi trovassero particolarmente... gradevole.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: 'Esenin: Ma non voglio fare del male a nessuno, credimi. È solo che... la vita a volte fa schifo, capisci?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: 'Esenin: Allora, che dici, buon uomo? Posso entrare?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: Non è che sei un Visitatore, vero?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: Sicuro che non combinerai guai?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: Ti sembro uno di quei mostri?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: 'Esenin: No, non sono un Visitatore. E comunque, nessuno lo ammetterebbe mai in modo così diretto ed esplicito.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: 'Esenin: Mi sa tanto che le cose qui non saranno molto diverse dal pub...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: Perché ti hanno cacciato dal pub?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: Cosa ti fa credere che qui sarà diverso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: Dipende dalla tua definizione di guai.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: 'Esenin: Gli omicidi e la violenza mi disgustano nel profondo. Ma non tollero nemmeno le malefatte altrui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: 'Esenin: Mi piace bere e mangiare. Mi piace chiacchierare quando sono dell''umore giusto. Questi sono "guai" per te?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: Perché ti hanno cacciato dal pub?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: Cosa ti fa credere che qui sarà diverso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: 'Esenin: Mi sono dovuto trattenere dal fare un commento spiacevole.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: 'Esenin: Te l''ho detto: qualcuno lì dentro non mi sopportava, Dio solo sa chi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: 'Esenin: Ora che ci penso, forse è un bene che mi abbiano cacciato.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: 'Esenin: Avrebbero potuto mangiarmi vivo e nessuno lo avrebbe mai saputo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: 'Esenin: E che alternative ho? Stare fuori ad aspettare che il sole mi incenerisca?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: Sinceramente, preferirei evitarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: 'Esenin: Fintanto che sono vivo, cercherò qualcuno con cui chiacchierare. Se non lo troverò qui, andrò altrove.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: 'Esenin: E se la buona sorte mi assiste, magari mi capiterà qualcuno che non sia un perfetto idiota.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: 'Esenin: Grazie. La fiducia nelle persone è rara di questi tempi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: 'Esenin: Ma apprezzo che tu abbia deciso di riporla in me. Forse potrei persino... No, non è il caso di fare promesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: 'Esenin: Uhm, capisco...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: 'Esenin: Comprendo le tue ragioni, ma mi fanno comunque incazzare. Sei un codardo, come tutti gli altri.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: 'Esenin: Sogni d''oro, buon uomo. E vaffanculo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: Posso entrare per riposare un po''? Mi basterà qualche minuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: Da dove vieni?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: Dove stai cercando di andare?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: 'Widow: Non ricordo. Non che abbia molta importanza, ormai...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: 'Widow: Sono a pezzi. Se non mi riposo, potrei svenire qui davanti alla porta di casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: Il tuo amico sta male?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: Il tuo amico ha bisogno d'aiuto?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: 'Widow: Io... probabilmente crollerò da qualche parte per non rialzarmi mai più.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: Dove, è indifferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: Il tuo amico sta male?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: Il tuo amico ha bisogno d'aiuto?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: È mio marito.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: Ed è morto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: 'Widow: Non posso dargli una degna sepoltura, ma non posso neanche abbandonarlo per strada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: 'Widow: Non più, ormai. Quando gli serviva, nessuno ha mosso un dito.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: E ora è morto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: 'Widow: Ce l''avrebbe fatta, se solo se...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: 'Widow: Qualcuno se ne fosse fregato.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: Non mi tratterrò a lungo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: 'Widow: Ho solo bisogno di riposare.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: Tu...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: Yoooooo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: 'Scammer: Hai visto che cazzo sta succedendo? È pazzesco!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: Come te la passi lì dentro, fra?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: Cosa posso fare per te?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: Cosa sta succedendo, esattamente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: 'Scammer: Niente, in realtà. Ero solo curioso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: 'Scammer: Ma ehi, conosco un modo fantastico per farti guadagnare soldi facili. Vuoi sapere quale?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: 'Scammer: Con tutta questa gente preoccupata per il sole, puoi fare un bel gruzzoletto senza muovere un dito.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: 'Scammer: Tutti questi idioti se la fanno sotto, quando invece dovrebbero tirare fuori le palle!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: Perché sei qui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: D'accordo, sentiamo.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: 'Scammer: Sono qui per mostrarti nuovi orizzonti, fra. Immagina la prospettiva!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: 'Scammer: Tutti corrono di qua e di là come delle femminucce, invece di fare ciò che è più naturale.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: 'Scammer: Alla gente serve solo un briciolo di felicità, ecco che intendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: Perché sei qui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: D'accordo, sentiamo.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: Dritto al punto, eh? Mi piace!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: 'Scammer: La gente pensa che tu stia tramando qualcosa qui dentro, a far entrare tutte queste persone in casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: 'Scammer: Perciò, tanto vale organizzare la festa più grandiosa di sempre, no? È la cazzo di fine del mondo, fra!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: Morire non fa parte del piano, fra!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: 'Scammer: Devi darti da fare finché ne hai l''opportunità. Fanculo il sole!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: 'Scammer: È ora di svegliarsi e rimboccarsi le maniche! Mi segui?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: 'Scammer: Cazzo, sì! Proprio quello che intendevo, amico mio!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: Finalmente, qualcuno con del sale in zucca.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: 'Scammer: Ah, capisco... Quindi, sei solo un maledetto idiota. Non me n''ero accorto, colpa mia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: 'Scammer: Andrò dal tuo vicino a vedere se è più ricettivo al mio genio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: Ci vediamo all''inferno, testa di cazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: 'Neighbour: Ciao, vicino. Da quanto non ci si vede. Come va?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: Come al solito.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: Tutto bene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: 'Neighbour: Senti, senza che ci giriamo intorno: sono venuto qui per un motivo. Il fatto è che... sono preoccupato.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: Ho la sensazione che stia per succedere qualcosa di molto grave.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: 'Neighbour: Ho appena sentito mia cugina. Dice che al telegiornale parlano di qualcosa di strano che sta succedendo al sole.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: 'Neighbour: Dice anche che sta salendo della gente dal sottosuolo. Li definiscono "Visitatori", per chissà quale motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: 'Neighbour: Che storia, eh? Spero tanto siano tutte fandonie...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: Che sta succedendo al sole?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: Visitatori?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: 'Neighbour: Senti, senza che ci giriamo intorno: sono venuto qui per un motivo. Il fatto è che... sono preoccupato.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: Ho la sensazione che stia per succedere qualcosa di molto grave.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: 'Neighbour: Ho appena sentito mia cugina. Dice che al telegiornale parlano di qualcosa di strano che sta succedendo al sole.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060952
    m_Localized: 'Neighbour: Dice anche che sta salendo della gente dal sottosuolo. Li definiscono "Visitatori", per chissà quale motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060953
    m_Localized: 'Neighbour: Che storia, eh? Spero tanto siano tutte fandonie...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060954
    m_Localized: Che sta succedendo al sole?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060955
    m_Localized: Visitatori?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060956
    m_Localized: 'Neighbour: Parlano di esplosioni, ma non ho ancora capito se si tratta del sole stesso o di qualcosa sulla sua superficie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060957
    m_Localized: 'Neighbour: So solo che qualcosa non va.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060958
    m_Localized: 'Neighbour: Hai notato anche tu che questa è stata l''estate più calda di sempre, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060959
    m_Localized: 'Neighbour: Temo che dovremo prepararci al peggio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060960
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060961
    m_Localized: 'Neighbour: Mia cugina dice che è pericoloso rimanere da soli in casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060962
    m_Localized: 'Neighbour: Perciò, sono venuto ad assicurarmi che non ti fosse successo nulla di grave...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060963
    m_Localized: D'accordo.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060964
    m_Localized: So badare a me stesso.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060965
    m_Localized: Come stanno tua moglie e tua figlia?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060966
    m_Localized: 'Neighbour: Sì, è così che chiamano la gente che viene dal sottosuolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060967
    m_Localized: 'Neighbour: Dio solo sa perché.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060968
    m_Localized: 'Neighbour: Suppongo si riferiscano al fatto che sono dei visitatori della Terra. O della superficie, perlomeno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060969
    m_Localized: 'Neighbour: O forse li chiamano così perché se ne vanno in giro, cercando di infilarsi in casa della gente?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060970
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060971
    m_Localized: 'Neighbour: Mia cugina dice che è pericoloso rimanere da soli in casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060972
    m_Localized: 'Neighbour: Perciò, sono venuto ad assicurarmi che non ti fosse successo nulla di grave...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060973
    m_Localized: D'accordo.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060974
    m_Localized: So badare a me stesso.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060975
    m_Localized: Come stanno tua moglie e tua figlia?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060976
    m_Localized: 'Neighbour: Ti va se continuiamo questa conversazione di giorno?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060977
    m_Localized: 'Neighbour: Ti aspetto in cucina domattina.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060978
    m_Localized: 'Neighbour: Buonanotte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060979
    m_Localized: 'Neighbour: Non ne dubito, ma non so se hai capito quanto sia pericoloso stare da soli in questo momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060980
    m_Localized: 'Neighbour: Che dici se mi trattengo per una notte? Così, giusto per essere sicuri. Mi tranquillizzerebbe...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060981
    m_Localized: 'Neighbour: Non preoccuparti per la mia famiglia. L''ho lasciata nelle mani di un caro amico, baderà lui a loro mentre sono qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060982
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060983
    m_Localized: 'Neighbour: Ti va se continuiamo questa conversazione di giorno?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060984
    m_Localized: 'Neighbour: Ti aspetto in cucina domattina.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060985
    m_Localized: 'Neighbour: Buonanotte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060986
    m_Localized: 'Neighbour: Non preoccuparti per la mia famiglia. L''ho lasciata nelle mani di un caro amico, baderà lui a loro mentre sono qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060987
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060988
    m_Localized: 'Neighbour: Ti va se continuiamo questa conversazione di giorno?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060989
    m_Localized: 'Neighbour: Ti aspetto in cucina domattina.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060990
    m_Localized: 'Neighbour: Buonanotte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060991
    m_Localized: 'Daughter: Ciao!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060992
    m_Localized: 'Daughter: Papà è qui? Me lo chiami, per favore?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060993
    m_Localized: 'Daughter: Andava tutto bene, ma adesso ho paura. Stasera ci sono un sacco di persone strane qua fuori...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060994
    m_Localized: Come si chiama tuo padre?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060995
    m_Localized: Raccontami qualcosa di tuo padre.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060996
    m_Localized: 'Daughter: Hai dimenticato il suo nome? Ah, no, aspetta... Stai solo cercando di capire se sono un Visitatore, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060997
    m_Localized: 'Daughter: Astuto! Anche io inizierò a fare domande per capirlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060998
    m_Localized: Come sei arrivata fin qui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060999
    m_Localized: Hai paura dei Visitatori?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061000
    m_Localized: 'Daughter: Oh, potrei dirti tantissime cose su di lui. Dopotutto, è il mio papà.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061001
    m_Localized: 'Daughter: Per esempio, so che gli piace bere un pochino di birra prima di uscire, eh eh!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061002
    m_Localized: 'Daughter: In quei casi, mi lascia sempre molte cose buone da mangiare per pranzo e cena. Persino il succo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061003
    m_Localized: 'Daughter: Ma oggi ho voluto provare la birra e... Bleah! Era disgustosa!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061004
    m_Localized: 'Daughter: Chi mai vorrebbe bere quella roba quando c''è il succo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061005
    m_Localized: 'Daughter: O‑Oh, non dirgli che l''ho assaggiata, ti prego!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061006
    m_Localized: Come sei arrivata fin qui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061007
    m_Localized: Hai paura dei Visitatori?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061008
    m_Localized: 'Daughter: Boh, sembra che il mondo sia tutto al contrario.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061009
    m_Localized: 'Daughter: Le persone dormono di giorno, poi escono di notte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061010
    m_Localized: 'Daughter: Ho ancora paura del buio, ma forse non c''è nulla da temere.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061011
    m_Localized: 'Daughter: O sbaglio...?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061012
    m_Localized: Vado a chiamare tuo padre. Buona fortuna!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061013
    m_Localized: Buonanotte!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061014
    m_Localized: 'Daughter: I‑Io... non saprei.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061015
    m_Localized: 'Daughter: La gente ha paura di loro, quindi forse dovrei averne anch''io. Non ne ho mai visto uno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061016
    m_Localized: 'Daughter: Sono cattivi? Ti fanno del male?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061017
    m_Localized: 'Daughter: Se è così, allora uno dei miei compagni di scuola è un Visitatore. Mi prende sempre a pugni.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061018
    m_Localized: 'Daughter: Papà ha detto che dovevo stare attenta, quindi sono stata suuuper attenta!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061019
    m_Localized: 'Daughter: Ho fatto piano pianooo. Non mi ha visto nessuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061020
    m_Localized: Vado a chiamare tuo padre. Buona fortuna!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061021
    m_Localized: Buonanotte!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061022
    m_Localized: 'Daughter: Grazie, anche a te!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061023
    m_Localized: 'Daughter: Voglio andare a casa... Fa tanta paura qui fuori...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061024
    m_Localized: 'Daughter: Faremo un nuovo gioco che ha inventato papà. In pratica, devi tirare un dado!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061025
    m_Localized: 'Daughter: Dopodiché, sposti delle cose in giro, tipo la poltrona o il divano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061026
    m_Localized: 'Daughter: Per vincere, devi formare un grosso mucchio davanti alla porta. Un giorno ti mostro come si gioca!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061027
    m_Localized: 'Daughter: Ciao!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061028
    m_Localized: 'Daughter: C‑Ciao.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061029
    m_Localized: 'Daughter: P‑Posso entrare?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061030
    m_Localized: Va tutto bene?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061031
    m_Localized: Cos'è successo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061032
    m_Localized: 'Daughter: I‑Io... non s‑so cosa f‑fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061033
    m_Localized: 'Daughter: Delle p‑persone...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061034
    m_Localized: 'Daughter: E‑Ehm...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061035
    m_Localized: 'Daughter: H‑Hanno ucciso i‑il...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061036
    m_Localized: 'Daughter: I‑Il... m‑mio...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061037
    m_Localized: 'Daughter: P‑Papà.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061038
    m_Localized: Chi è stato?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061039
    m_Localized: Perché l'hanno ucciso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061040
    m_Localized: 'Daughter: E‑Ehm...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061041
    m_Localized: 'Daughter: I‑Il... mio p‑pa...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061042
    m_Localized: 'Daughter: H‑Hanno u‑ucc...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061043
    m_Localized: 'Daughter: Hanno u‑ucciso il m‑mio papà.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061044
    m_Localized: Chi è stato?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061045
    m_Localized: Perché l'hanno ucciso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061046
    m_Localized: 'Daughter: Dei V‑Visitatori... Sono venuti a c‑casa. Erano s‑seduti con n‑noi...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061047
    m_Localized: 'Daughter: Papà stava p‑parlando con loro di q‑qualcosa, e poi lo h‑hanno... Lo hanno u‑ucciso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061048
    m_Localized: 'Daughter: Lui... *sniff* La nostra... *sob*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061049
    m_Localized: 'Daughter: La nostra c‑casa è in f‑fiamme...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061050
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061051
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061052
    m_Localized: 'Daughter: N‑Non lo so.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061053
    m_Localized: 'Daughter: Erano s‑seduti con p‑papà in c‑cucina.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061054
    m_Localized: 'Daughter: E poi h‑hanno... f‑fatto qualcosa, e d‑dato fuoco a c‑casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061055
    m_Localized: 'Daughter: M‑Mentre scappavo, li ho s‑sentiti r‑ridere...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061056
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061057
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061058
    m_Localized: 'Daughter: M‑Mi a‑aiuterai?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061059
    m_Localized: 'Daughter: Ho tanta p‑paura.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061060
    m_Localized: 'Daughter: M‑Ma... dove posso a‑andare?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061061
    m_Localized: 'Daughter: H‑Ho... tanta p‑paura!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061062
    m_Localized: 'Daughter: Aaaaaah!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061063
    m_Localized: 'Daughter: AAAAAAAAAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061064
    m_Localized: 'SuperFake: Ma salve.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061065
    m_Localized: Cosa vuoi?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061066
    m_Localized: Scordati di entrare.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061067
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061068
    m_Localized: 'SuperFake: Hai una casetta davvero spaziosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061069
    m_Localized: 'SuperFake: Mi piace.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061070
    m_Localized: Non mi serve nulla da te.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061071
    m_Localized: Ho un fucile in casa.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061072
    m_Localized: 'SuperFake: Com''è la tua bella porticina? Molto robusta?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061073
    m_Localized: 'SuperFake: Non si può mai sapere chi potrebbe bussare.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061074
    m_Localized: 'SuperFake: Dico bene?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061075
    m_Localized: Non mi serve nulla da te.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061076
    m_Localized: Ho un fucile in casa.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061077
    m_Localized: 'SuperFake: Oh, sì, lo so.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061078
    m_Localized: 'SuperFake: Ma quindiii...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061079
    m_Localized: 'SuperFake: Sei da solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061080
    m_Localized: No, non sono da solo.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061081
    m_Localized: Sì, sono da solo.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061082
    m_Localized: 'SuperFake: Che meraviglia!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061083
    m_Localized: 'SuperFake: Ci voleva la disperazione per rendere coraggiosi i codardi, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061084
    m_Localized: 'SuperFake: Ma quindiii...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061085
    m_Localized: 'SuperFake: Sei da solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061086
    m_Localized: No, non sono da solo.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061087
    m_Localized: Sì, sono da solo.
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061088
    m_Localized: 'SuperFake: Ah, è il tuo giorno fortunato.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061089
    m_Localized: 'SuperFake: Sento qualcuno bisbigliare all''interno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061090
    m_Localized: 'SuperFake: Ma chi può mai sapere se sarà così anche tra qualche giorno?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061091
    m_Localized: 'SuperFake: Ah ah ah ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061092
    m_Localized: 'SuperFake: So che sei da solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061093
    m_Localized: 'SuperFake: Volevo solo vedere se avresti mentito o meno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061094
    m_Localized: 'SuperFake: Mi metterò a mio agio, se non ti dispiace.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061095
    m_Localized: 'NotTrue: Ciao, giovanotto. Camminare fin qui mi ha davvero sfinito, te lo assicuro!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061096
    m_Localized: 'NotTrue: Posso entrare a riposare qualche minuto le mie povere gambe?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061097
    m_Localized: Sei venuta apposta fin qui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061098
    m_Localized: Hai camminato a lungo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061099
    m_Localized: 'NotTrue: No, no, no... Non era certo mia intenzione venire qui apposta, non essere sciocco.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061100
    m_Localized: 'NotTrue: Eppure, si può dire che sia stato il destino a farci incontrare. Nulla accade per caso, giovanotto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061101
    m_Localized: 'NotTrue: Come non è certo per caso che i piedi mi abbiano condotto qui. C''è un motivo se il mio sguardo si è soffermato su questa casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255104
    m_Localized: 'NotTrue: Come se fosse stato previsto da sempre, diciamo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255105
    m_Localized: Non capisco, ti serve qualcosa?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255106
    m_Localized: Potevi continuare a camminare. Perché fermarti qui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255107
    m_Localized: 'NotTrue: Ah! Cosa intendi per "camminare a lungo"?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255108
    m_Localized: 'NotTrue: Tu, per esempio! Sei dentro casa, eppure quanti passi avrai fatto?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255109
    m_Localized: 'NotTrue: Tu hai camminato a lungo? Io dico proprio di sì.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255110
    m_Localized: 'NotTrue: Ma io l''ho fatto per decenni, per più di tutti i tuoi pasti sommati insieme.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255111
    m_Localized: 'NotTrue: Ecco la differenza tra me e te, giovanotto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255112
    m_Localized: Non capisco, ti serve qualcosa?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255113
    m_Localized: Potevi continuare a camminare. Perché fermarti qui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255114
    m_Localized: 'NotTrue: Ah! Di cosa hanno bisogno tutti, giovanotto?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255115
    m_Localized: 'NotTrue: Ma di un tetto sopra la testa, per fare due chiacchiere in compagnia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255116
    m_Localized: 'NotTrue: Di sdraiarmi e chiudere gli occhi in tutta tranquillità.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255117
    m_Localized: 'NotTrue: E di aria da respirare, suppongo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255118
    m_Localized: 'NotTrue: Non chiedo molto. Semplicemente, è noioso vivere tutti soli soletti.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255119
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255120
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255121
    m_Localized: 'NotTrue: Ah! Hai dei tappi nelle orecchie, per caso?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255122
    m_Localized: 'NotTrue: Sono stanca di camminare.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255123
    m_Localized: 'NotTrue: Qui potrei riprendere fiato e magari fare due chiacchiere in tranquillità.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255124
    m_Localized: 'NotTrue: È quanto basta a una vecchia signora come me.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255125
    m_Localized: 'NotTrue: Tu mi racconti qualcosa e io farò altrettanto. Uno scambio equo, non ti pare?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255126
    m_Localized: 'NotTrue: E nel frattempo, magari, potrò far riposare queste vecchie ossa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255127
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255128
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255129
    m_Localized: 'NotTrue: Grazie, giovanotto!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255130
    m_Localized: 'NotTrue: Sento già che sarai un bravo padrone di casa. E forse, finalmente, capirò anche cosa sta succedendo da queste parti.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255131
    m_Localized: 'NotTrue: Bah! Mi respingono ovunque vada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255132
    m_Localized: 'NotTrue: Anche se le mie ali sono tarpate, apro comunque la gola per cantare.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255133
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255134
    m_Localized: 'NotTrue: Ma alla fine, vengono tutti da me... Anche se affermano che non lo faranno mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255135
    m_Localized: 'NotTrue: Beh, non serbo rancore. Aiuto chiunque me lo chieda, incondizionatamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255136
    m_Localized: 'NotTrue: Anche tu avrai bisogno d''aiuto, prima o poi, giovanotto. E allora, a chi ti rivolgerai?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255137
    m_Localized: 'Twins: Ecco, appoggiati un attimo a me. Ehi, ciao.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255138
    m_Localized: 'Twins: Non è che... avresti un posticino per noi?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255139
    m_Localized: La tua amica sta male?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255140
    m_Localized: Non vi sentite bene?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255141
    m_Localized: 'Twins: È mia sorella. È depressa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255142
    m_Localized: 'Twins: Non riesce a camminare o a lavarsi da sola. A volte, persino alzarsi dal letto è un''impresa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255143
    m_Localized: 'Twins: Ma va tutto bene, prima o poi si riprenderà. Vero, sorellina?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255144
    m_Localized: 'Twins: Non è in vena di chiacchiere in questo momento, ma a volte trova la forza di interagire.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255145
    m_Localized: Cosa farete, ora?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255146
    m_Localized: Non sei stanca di trascinarla in giro?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255147
    m_Localized: 'Twins: Tutti, chi più chi meno, soffriamo di depressione, prima o poi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255148
    m_Localized: 'Twins: Sapevamo come sarebbe andata a finire, ancor prima di questa storia del sole.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255149
    m_Localized: 'Twins: Hai seguito le notizie, no? Era destino. Ma non credo che il sole esploderà per davvero.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255150
    m_Localized: Cosa farete, ora?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255151
    m_Localized: Non sei stanca di trascinarla in giro?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255152
    m_Localized: 'Twins: Devo trovare un posto dove mia sorella possa sentirsi più a suo agio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255153
    m_Localized: 'Twins: Poi inizieremo una nuova vita.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255154
    m_Localized: 'Twins: Dicono che non c''è più speranza...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255155
    m_Localized: 'Twins: Ma non sono d''accordo. Quando tocchi il fondo, non puoi far altro che risalire.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255156
    m_Localized: Entrate.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255157
    m_Localized: Dovreste andarvene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255158
    m_Localized: 'Twins: Non dirlo neanche per scherzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255159
    m_Localized: 'Twins: Sarà anche estenuante, ma non potrei mai abbandonarla, se è questo che intendi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255160
    m_Localized: 'Twins: Abbiamo lasciato casa dei nostri genitori insieme. Ora, non ci resta altro che noi stesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255161
    m_Localized: Entrate.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255162
    m_Localized: Dovreste andarvene.
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255163
    m_Localized: 'Twins: Grazie! Aiutami a portarla dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255164
    m_Localized: 'Twins: Temo che la morte dei nostri genitori abbia peggiorato le sue condizioni, ma ormai è così da tanto tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255165
    m_Localized: 'Twins: Chissà, forse si riprenderà un pochino mentre siamo qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255166
    m_Localized: 'Twins: Oh... Beh, sorella, dovremo tentare la fortuna altrove.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255167
    m_Localized: 'Twins: Su, forza. Dammi una mano, sorellina.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255168
    m_Localized: 'Twins: Oddio, quando finirà tutto questo...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714688
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714689
    m_Localized: 'Firefighter: Al lavoro, ci hanno dato questo foglietto di carta prima di andare a spegnere gli incendi.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714690
    m_Localized: 'Firefighter: È un mandato di comparizione della FEMA. Ma perché rinchiudersi in quarantena se chi lo fa finisce morto stecchito?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714691
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714692
    m_Localized: 'Firefighter: Tieni, a me non serve comunque. Puoi buttarlo o farci quel che ti pare.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714693
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714694
    m_Localized: 'Firefighter: Ho con me un *coff coff* foglietto di carta. Dovrebbe trattarsi di un documento importante.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714695
    m_Localized: 'Firefighter: Te lo darò, se mi farai entrare. Lasciami vivere in pace i miei ultimi giorni di vita...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714696
    m_Localized: Ok, entra.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714697
    m_Localized: Grazie, ma puoi tenerlo.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714698
    m_Localized: 'Wheelchair: Ma che cazzo di problemi hai?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714699
    m_Localized: 'Wheelchair: Senti, si vede che sei un brav''uomo. Forse un''EnerJeka potrebbe farti cambiare idea?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714700
    m_Localized: 'Wheelchair: Spingermi fin qui mi ha sfinito, cazzo! Questo sì che è stato un workout con i fiocchi.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714701
    m_Localized: Ok, entra.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714702
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714703
    m_Localized: 'Wheelchair: Hai vinto un''EnerJeka! Grazie per avermi fatto entrare, amigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908992
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908993
    m_Localized: 'Anger: Cazzo... Cazzo, cazzo, cazzooo...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908994
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908995
    m_Localized: 'Anger: E va bene, senti...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908996
    m_Localized: 'Anger: Che ne dici di un''EnerJeka? Se te la do, mi farai entrare?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908997
    m_Localized: 'Anger: Io sopravvivrò e tu ti scolerai una bella bibita ghiacciata. E così vissero tutti schifosamente felici e contenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908998
    m_Localized: Ok, entra.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908999
    m_Localized: Smettila di insistere.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909000
    m_Localized: 'Anger: Non preoccuparti per me, sono solo... Cazzo... Comunque, prendila...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909001
    m_Localized: 'Anger: L''EnerJeka, dico.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909002
    m_Localized: 'Anger: Io farò meglio a calmarmi, invece di bere questa merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909003
    m_Localized: 'Anger: Vedo che hai {0} qui con te. È ovvio, tutti parlano sottovoce e si fanno in quattro per non ferirne i sentimenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909004
    m_Localized: 'Anger: Ma io non sopporto l''idea di condividerci gli spazi. Devi scegliere chi tra noi resterà in casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909005
    m_Localized: 'Anger: Odio vivere con persone che si tengono tutto dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909006
    m_Localized: Entra, ci penso io.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909007
    m_Localized: Meglio se vai via, allora.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909008
    m_Localized: 'Anger: Hai la pazienza di un cazzo di santo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909009
    m_Localized: 'Anger: Conto su di te, allora.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909010
    m_Localized: 'Anger: E io cercherò di, beh... stare tranquillo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909011
    m_Localized: 'Anger: Oh, fantastico. Che notizia maledettamente fantastica.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909012
    m_Localized: 'Anger: Immagino che ti senta più al sicuro con gli stronzi che hai già in casa, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909013
    m_Localized: 'Anger: Non me ne frega un cazzo di te, leccaculo di merda. PUOI MARCIRE ALL''INFERNO!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909014
    m_Localized: 'Fanatic: Ecco una generosa ricompensa dal Santo Sole IN PERSONA: la tua EnerJeka personale! Te la meriti, UMANO!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909015
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909016
    m_Localized: 'Fanatic: Sei un perfetto idiota?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909017
    m_Localized: 'Fanatic: Stai scacciando un UOMO GIUSTO e RETTO!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909018
    m_Localized: 'Fanatic: Se mi farai entrare, riceverai una generosa ricompensa dal SANTO SOLE stesso. Ripensaci e sarai benedetto!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909019
    m_Localized: Ok, entra.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909020
    m_Localized: Smettila di insistere.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297600
    m_Localized: 'Super: Nessuno sa cosa sia successo dopo l''arrivo dell''ultimo Visitatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297601
    m_Localized: 'Super: Il posto è rimasto disabitato per parecchio tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297602
    m_Localized: 'Super: Dopo la tua misteriosa scomparsa, la casa è stata abbandonata ed evitata come la peste.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297603
    m_Localized: 'NotTrue: Ciao, giovanotto... Chi c''è in casa? È {0}, per caso?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297604
    m_Localized: 'NotTrue: Un attimo prima c''è un gran trambusto, poi un sussurro nell''ombra. Posti del genere non sono adatti a un''anziana signora.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297605
    m_Localized: 'NotTrue: Giro da sola per un motivo, sai? Le stanze piene di urla o traboccanti di volti non fanno per me.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297606
    m_Localized: 'NotTrue: Ma non ti chiederò di cacciare qualcuno. Resterò qui, in attesa che i venti si plachino. Non sono tipo da tempeste, giovanotto.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297607
    m_Localized: 'NotTrue: Queste vecchie ossa non reggerebbero... Mi ridurrei in polvere.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297608
    m_Localized: Entra, ci penso io.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297609
    m_Localized: Meglio se vai via, allora.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297610
    m_Localized: 'NotTrue: Se ne sei proprio sicuro... Ma se sento l''arrivo di una tempesta, me ne vado. Sono troppa vecchia per certe cose.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297611
    m_Localized: 'NotTrue: Bah! Non mi sentivo comunque a mio agio qui... Riporrò le mie storie in valigia e me ne andrò.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297612
    m_Localized: 'NotTrue: Ma tieni le orecchie aperte, giovanotto... Le verità più letali sono spesso quelle sussurrate più piano.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297613
    m_Localized: 'Twins: Ti prego...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297614
    m_Localized: 'Twins: Facci entrare, anche solo per un giorno. Abbiamo qualcosa che potrebbe interessarti...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297615
    m_Localized: 'Twins: Fidati, ne varrà la pena...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297616
    m_Localized: Ok, entrate.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297617
    m_Localized: Smettila di insistere.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297618
    m_Localized: 'Twins: Grazie mille!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297619
    m_Localized: 'Twins: Ecco, prendi questa EnerJeka. È tutto ciò che abbiamo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297620
    m_Localized: 'Twins: Ora, potresti aiutarmi a portare mia sorella dentro?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297621
    m_Localized: 'Twins: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297622
    m_Localized: 'Twins: Forse non è una buona idea, visto che {0} è qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297623
    m_Localized: 'Twins: Questo rende l''aria... più pesante. È come se potessi sentire il rumore di quei pensieri.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297624
    m_Localized: 'Twins: Mia sorella non lo sopporterebbe. Si chiuderebbe a riccio e diventerebbe quasi un fantasma di sé stessa.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297625
    m_Localized: 'Twins: Anch''io faccio fatica ad affrontare questo genere di cose. Mi tolgono il respiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297626
    m_Localized: 'Twins: Mi spiace, ma penso che aspetteremo finché la situazione lì dentro... non si calmerà. Magari chi di dovere toglierà il disturbo...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297627
    m_Localized: Entrate, ci penso io.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297628
    m_Localized: Meglio se andate via, allora.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297629
    m_Localized: 'Twins: Grazie. Attento, assicurati di sostenerla con una mano sulla schiena... Ecco, così.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297630
    m_Localized: 'Twins: Penso che la morte dei nostri genitori... l''abbia spezzata dentro. Ma sta resistendo come meglio può.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297631
    m_Localized: 'Twins: È da parecchio che vaghiamo da queste parti. Speravo che almeno qui dentro potesse sentirsi meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297632
    m_Localized: 'Twins: Capisco...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297633
    m_Localized: 'Twins: Resisti ancora un po'', sorellina. Troveremo presto un posto dove riposare, te lo prometto. Vieni, appoggiati a me.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297634
    m_Localized: 'Twins: A volte, le cose possono sembrare... opprimenti. Anche una banale porta chiusa. Ma dobbiamo andare avanti...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861312
    m_Localized: 'Firefighter: Grazie, amico. *coff coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861313
    m_Localized: 'Firefighter: Non credo che ti starò tra i piedi ancora per molto. *coff coff*'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861314
    m_Localized: 'Firefighter: Ma almeno non morirò per strada, solo come un cane.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861315
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861316
    m_Localized: 'Firefighter: Al lavoro, ci hanno dato questo foglietto di carta prima di andare a spegnere gli incendi.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861317
    m_Localized: 'Firefighter: È un mandato di comparizione della FEMA. Ma perché rinchiudersi in quarantena se chi lo fa finisce morto stecchito?'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861318
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861319
    m_Localized: 'Firefighter: Tieni, a me non serve comunque. Puoi buttarlo o farci quel che ti pare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257472
    m_Localized: 'Theorist: Salve. Dimmi... posso fidarmi di te?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257473
    m_Localized: 'Theorist: Non sei della FEMA, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257474
    m_Localized: Fidarti di me per cosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257475
    m_Localized: No, non sono della FEMA.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257476
    m_Localized: 'Theorist: Per condividere informazioni importanti, ovviamente!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257477
    m_Localized: 'Theorist: Mi serve un posto sicuro dove nascondermi e continuare le mie ricerche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257478
    m_Localized: 'Theorist: Ho con me dei documenti contenenti informazioni estremamente riservate.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257479
    m_Localized: 'Theorist: Parliamo di kilotoni di segreti di Stato, che intendo rendere pubblici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257480
    m_Localized: Che tipo di segreti?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257481
    m_Localized: Dove hai rimediato queste informazioni?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257482
    m_Localized: 'Theorist: Oh, bene. Questo significa che posso fidarmi di te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257483
    m_Localized: 'Theorist: Vedi, il protocollo della FEMA prevede che gli agenti dichiarino la loro affiliazione quando viene loro richiesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257484
    m_Localized: 'Theorist: Quindi, se affermi che non sei con loro, allora dev''essere la verità, dico bene?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257485
    m_Localized: 'Theorist: Questo significa anche... che posso condividere con te delle informazioni importanti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257486
    m_Localized: Di che informazioni parli?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257487
    m_Localized: Dove hai rimediato queste informazioni?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257488
    m_Localized: 'Theorist: Preparati, amico mio. Stai per aprire gli occhi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257489
    m_Localized: 'Theorist: Manipolazioni elettorali. Le prove che lo sbarco sulla Luna era falso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257490
    m_Localized: 'Theorist: Il controllo mentale da parte del governo attraverso i fast food. Sì, proprio così. E infine...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257491
    m_Localized: 'Theorist: La verità su quelle patatine al gusto di "patate". Ma che significa?! Sono un abominio della scienza!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257492
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257493
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257494
    m_Localized: 'Theorist: D''accordo, te lo rivelerò. Credo di potermi fidare di te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257495
    m_Localized: 'Theorist: Ma devi giurarmi che non ne parlerai mai con anima viva, intesi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257496
    m_Localized: 'Theorist: Lavoravo in un istituto di ricerca. Mi hanno licenziato a causa delle mie scoperte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257497
    m_Localized: 'Theorist: Ho affermato che la vera minaccia non sono i Visitatori, ma ciò che hanno dentro: dei parassiti cerebrali.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257498
    m_Localized: 'Theorist: Ma quegli sciocchi si sono rifiutati di riconoscere la verità delle mie parole.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257499
    m_Localized: 'Theorist: Tappi per le orecchie, ecco cosa avrebbe bloccato i parassiti. Migliaia di persone potevano essere salvate!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257500
    m_Localized: 'Theorist: Perciò, ho lasciato l''istituto a testa alta... portandomi dietro alcuni preziosi archivi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257501
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257502
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257503
    m_Localized: 'Theorist: Sapevo di potermi fidare di te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257504
    m_Localized: 'Theorist: Ho visto la verità, credimi! Dimentica tutte le bugie che ti hanno raccontato!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257505
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257506
    m_Localized: 'Theorist: Stai commettendo un errore!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257507
    m_Localized: 'Theorist: La gente merita di sapere la verità!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257508
    m_Localized: 'Theorist: E sia. Mi sono fidato di te... e tu hai distrutto la mia fede nell''umanità.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257509
    m_Localized: 'Wifefema: Ciao, ti spiace se mi trattengo qui per un po''?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257510
    m_Localized: 'Wifefema: Sono venuta in città per vedere mio marito, si è trasferito per lavoro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257511
    m_Localized: 'Wifefema: Ho pensato di fargli una sorpresa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257512
    m_Localized: 'Wifefema: Ma, a quanto pare, non c''è alcun posto dove posso stare mentre lui lavora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257513
    m_Localized: Come sei arrivata qui?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257514
    m_Localized: Che lavoro fa tuo marito?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257515
    m_Localized: 'Wifefema: Come? Ma con un taxi, ovviamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257516
    m_Localized: 'Wifefema: Ho dovuto sborsare una fortuna, questi affari costano un occhio della testa al giorno d''oggi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257517
    m_Localized: 'Wifefema: Ma giuro sulla mia vita: i denti di quel tassista erano bianchi come porcellana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257518
    m_Localized: 'Wifefema: Quando il mio maritino della FEMA gli metterà le sue grandi e possenti mani addosso... glieli caccerà giù per la gola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257519
    m_Localized: Anche tu sei della FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257520
    m_Localized: Che lavoro faceva prima tuo marito?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257521
    m_Localized: 'Wifefema: Ah, te lo dirò forte e chiaro: lavora per la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257522
    m_Localized: 'Wifefema: Quando ho saputo della sua assunzione, diamine, quasi non potevo crederci!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257523
    m_Localized: 'Wifefema: Volevo fargli una sorpresa e ho preso un taxi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257524
    m_Localized: 'Wifefema: Se non fosse che quel maledetto autista mi ha svuotato le tasche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257525
    m_Localized: Anche tu lavori per la FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257526
    m_Localized: Che lavoro faceva prima tuo marito?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257527
    m_Localized: 'Wifefema: Sarebbe un sogno, ma non accettano donne. Figuriamoci...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257528
    m_Localized: 'Wifefema: Che peccato, sarei stata un asso a fiutare i Visitatori al fianco del mio maritino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257529
    m_Localized: 'Wifefema: Lavoravo alla dogana, sai? Proteggevo i nostri confini.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257530
    m_Localized: 'Wifefema: Non sai i delinquenti che ho beccato con ogni genere di merda addosso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257531
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257532
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257533
    m_Localized: 'Wifefema: Come se te lo dicessi. Perché vorresti saperlo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257534
    m_Localized: 'Wifefema: E poi, che importanza ha? Ora è nella FEMA. E potrei farne parte anch''io, se non vivessero nell''età della pietra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257535
    m_Localized: 'Wifefema: Non è giusto. Davvero credono che non sarei brava quanto mio marito solo perché sono una donna?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257536
    m_Localized: 'Wifefema: Lavoravo alla frontiera, dannazione. Ho fiuto per i tipi loschi, io!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257537
    m_Localized: 'Wifefema: Il divieto di assumere donne nella FEMA è una vera stronzata!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257538
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257539
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257540
    m_Localized: 'Wifefema: Così si ragiona!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257541
    m_Localized: 'Wifefema: Una volta fatti fuori quei mostri, potremo tornare a vivere come si deve, come persone perbene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257542
    m_Localized: 'Wifefema: Ma... che diavolo...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257543
    m_Localized: 'Wifefema: Oh, signore mio... Non dirmi che mi hai preso per un Visitatore?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257544
    m_Localized: 'Wifefema: Stai dicendo sul serio?! Mio marito lavora alla FEMA, per l''amor del cielo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257545
    m_Localized: 'Wifefema: Ma che cazzo di problema hai? Ti ho raccontato i fatti miei e tu mi metti alla porta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257546
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257547
    m_Localized: 'Wifefema: Sai che ti dico? Vaffanculo. Chiederò ospitalità a uno dei tuoi vicini.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257548
    m_Localized: 'Raskolnikov: Ciao, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257549
    m_Localized: 'Raskolnikov: Senti, per caso, ehm... sei armato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257550
    m_Localized: Perché vuoi saperlo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257551
    m_Localized: Sì, ho un fucile.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257552
    m_Localized: 'Raskolnikov: Oh, chiedo scusa... Non era mia intenzione essere scortese.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257553
    m_Localized: 'Raskolnikov: È solo che... di questi tempi, sarebbe bene imparare a cavarsela da soli. E‑Eliminare ogni potenziale minaccia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257554
    m_Localized: 'Raskolnikov: Chi ti giudicherebbe per aver ucciso durante l''apocalisse? S‑Sarebbe come fare multe su una pista da corsa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257555
    m_Localized: 'Raskolnikov: M‑Ma... riconosco la determinazione nella tua voce. Tu sapresti, ehm... premere il grilletto, in caso di necessità.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257556
    m_Localized: 'Raskolnikov: Scommetto che riusciresti persino a strangolare qualcuno con le tue stesse mani, se fossi costretto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257557
    m_Localized: Perché sei fissato con questa storia dell'uccidere?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257558
    m_Localized: Da chi stai cercando di proteggerti, esattamente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257559
    m_Localized: 'Raskolnikov: O‑Oh, allora potresti eliminare qualunque Visitatore che bussi alla tua porta!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257560
    m_Localized: 'Raskolnikov: Oh, diamine... Non fraintendermi, non sto cercando di aizzarti contro qualcuno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257561
    m_Localized: 'Raskolnikov: È solo che... ho visto un folle armato che interrogava un tizio, cercando di capire se fosse un Visitatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257562
    m_Localized: 'Raskolnikov: Meno male che non si è accorto di me. Avrebbe potuto spezzarmi il collo su due piedi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257563
    m_Localized: 'Raskolnikov: Un giorno... anch''io imparerò a uccidere...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257564
    m_Localized: 'Raskolnikov: Allora non sarò più io a vivere nella paura... ma gli altri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257565
    m_Localized: Perché sei fissato con questa storia dell'uccidere?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257566
    m_Localized: Da chi stai cercando di proteggerti, esattamente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257567
    m_Localized: 'Raskolnikov: Oh, diamine... Ti sembra che stia... esagerando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257568
    m_Localized: 'Raskolnikov: Non voglio passare per pazzo, è solo che...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257569
    m_Localized: 'Raskolnikov: Prima non avrei fatto del male a una mosca, ma ora... le persone gentili come me non durano a lungo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257570
    m_Localized: 'Raskolnikov: H‑Ho paura di cosa accadrà se non imparo a difendermi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257571
    m_Localized: 'Raskolnikov: Per questo ho bisogno di, ehm, prendere esempio da qualcuno che ne capisce.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257572
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257573
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257574
    m_Localized: 'Raskolnikov: No, no... Non c''è una persona in particolare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257575
    m_Localized: 'Raskolnikov: Voglio proteggermi dai Visitatori. E dalle persone che danno loro la caccia...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257576
    m_Localized: 'Raskolnikov: Al giorno d''oggi basta uno sguardo sbagliato per finire con una pallottola in testa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257577
    m_Localized: 'Raskolnikov: E io? Sono solo un codardo! Incapace di difendermi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257578
    m_Localized: 'Raskolnikov: Ecco perché spero di trovare qualcuno che possa, ehm... proteggermi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257579
    m_Localized: 'Raskolnikov: Ma anche, magari... Sì, insomma, se tu fossi disposto, beh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257580
    m_Localized: 'Raskolnikov: Potresti insegnarmi... a uccidere...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257581
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257582
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257583
    m_Localized: 'Raskolnikov: Grazie, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257584
    m_Localized: 'Raskolnikov: E se non è chiedere troppo, ehm... dopo avermi testato, ovviamente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257585
    m_Localized: 'Raskolnikov: P‑Potresti mostrarmi come si fa? A uccidere un Visitatore, intendo. Voglio guardare la morte negli occhi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257586
    m_Localized: 'Raskolnikov: Oh, diamine... Davvero non vuoi farmi entrare?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257587
    m_Localized: 'Raskolnikov: Suppongo che ti sarò sembrato un pazzoide o chissà cosa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257588
    m_Localized: 'Raskolnikov: Ma ti giuro che non è così! Sono solo un po''... nervoso, ultimamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257589
    m_Localized: 'Raskolnikov: Scusa se ti ho fatto perdere tempo. Spero solo di imparare a uccidere, un giorno. Per... difendermi da solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257590
    m_Localized: 'Nun: Vedo che la tua umile dimora è la più remota di tutte, figliolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257591
    m_Localized: 'Nun: Credo che sarà perfetta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257592
    m_Localized: Perfetta per cosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257593
    m_Localized: Cosa posso fare per te?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257594
    m_Localized: 'Nun: Oh, Signore, abbi pietà... Eppure parlo in modo comprensibile, o sbaglio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257595
    m_Localized: 'Nun: Per nascondermi, figliolo. Desidero rimanere qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257596
    m_Localized: 'Nun: E visto che abbiamo toccato l''argomento... permettimi di chiedere: che servizi offre la struttura?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257597
    m_Localized: 'Nun: Immagino siano presenti icone sacre, dico bene? Avrei anche bisogno di silenzio assoluto per pregare e meditare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257598
    m_Localized: Questo non è mica un albergo!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257599
    m_Localized: Tu devi avere qualche rotella fuori posto.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257600
    m_Localized: 'Nun: Necessito di una stanza nella tua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257601
    m_Localized: 'Nun: Dopotutto, tu accogli i bisognosi, o sbaglio? Ma prima devo accertarmi di un paio di questioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257602
    m_Localized: 'Nun: Innanzitutto, non ho alcuna pazienza nei confronti di ubriaconi o tossicodipendenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257603
    m_Localized: 'Nun: Se in casa ci sono dei miserabili manigoldi di questa risma, è meglio che tu me lo dica subito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257604
    m_Localized: 'Nun: In secondo luogo, hai un''infestazione di cimici dei letti? Ci sono topi nelle pareti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257605
    m_Localized: 'Nun: Non sopporto i parassiti. Le creature più ripugnanti del Signore sono dannose per la mia pelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257606
    m_Localized: Questo non è mica un albergo!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257607
    m_Localized: Tu devi avere qualche rotella fuori posto.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257608
    m_Localized: 'Nun: Oh, meno male che me lo hai detto! Non ci sarei mai arrivata da sola, altrimenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257609
    m_Localized: 'Nun: Sto solo cercando di capire se la tua baracca è degna della mia umile persona. Non sopporto la feccia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257610
    m_Localized: 'Nun: È chiedere troppo, figliolo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257611
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257612
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257613
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257614
    m_Localized: 'Nun: Non usare questo tono con me, razza di barbaro senza fede!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257615
    m_Localized: 'Nun: Non hai paura del Signore? Non provi alcuna vergogna?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257616
    m_Localized: 'Nun: Ti faccio delle semplici domande sulla tua casa e tu mi insulti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257617
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257618
    m_Localized: 'Nun: Beh, sappi che farò del mio meglio per raddrizzare l''attitudine volgare di questo posto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257619
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257620
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257621
    m_Localized: 'Nun: Che il Signore sia con te, figliolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257622
    m_Localized: 'Nun: Allora è così che stanno le cose, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257623
    m_Localized: 'Nun: Volteresti le spalle a una povera anziana bisognosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257624
    m_Localized: 'Nun: La mia morte peserà sulla tua anima, figliolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257625
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257626
    m_Localized: 'Nun: Il Signore ti giudicherà davanti alle porte del Paradiso. Ricordati delle mie parole.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257627
    m_Localized: 'Fugitive: A‑Aiutami...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257628
    m_Localized: 'Fugitive: Mi hanno sparato. Non resisterò a lungo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257629
    m_Localized: Chi è stato?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257630
    m_Localized: Cos'è successo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257631
    m_Localized: 'Fugitive: Quei luridi porci della FEMA... Stavo scavalcando la recinzione per cercare di scappare...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257632
    m_Localized: 'Fugitive: Quei bastardi... sono dei veri coglioni. Mi hanno lisciato tutti... ma un proiettile mi ha beccato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257633
    m_Localized: 'Fugitive: È entrato e uscito, grazie al cielo, ma cazzo... Sto sanguinando come un maiale squartato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257634
    m_Localized: 'Fugitive: Almeno le mie viscere sono ancora al loro posto... anche se non si direbbe, eh eh. Agh, ridere fa un male cane...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257635
    m_Localized: Parlami delle zone di quarantena della FEMA.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257636
    m_Localized: Quindi sei ricercato dalla FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257637
    m_Localized: 'Fugitive: La FEMA si è presentata a casa mia durante un''ispezione e mi hanno prelevato direttamente dall''uscio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257638
    m_Localized: 'Fugitive: Hanno iniziato a scrutarmi nell''istante stesso in cui ho aperto la porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257639
    m_Localized: 'Fugitive: Un attimo dopo, stavano scarabocchiando qualcosa sulle loro cartelline e hanno detto che dovevo seguirli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257640
    m_Localized: 'Fugitive: Li ho mandati a fanculo... così mi hanno ammanettato come un delinquente qualsiasi. Alla fine sono riuscito a scappare, però.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257641
    m_Localized: Parlami delle zone di quarantena della FEMA.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257642
    m_Localized: Quindi sei ricercato dalla FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257643
    m_Localized: 'Fugitive: Immagina un parcheggio deserto, recintato, con un paio di tendoni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257644
    m_Localized: 'Fugitive: Poi riempi lo spazio vuoto con enormi container in cui ogni mattina stipano le persone come bestiame.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257645
    m_Localized: 'Fugitive: Ecco la tua zona di quarantena della FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257646
    m_Localized: 'Fugitive: E la loro sicurezza è una dannata barzelletta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257647
    m_Localized: 'Fugitive: Non mi è servito neanche un piano. Ho solo aspettato il momento giusto per scavalcare la recinzione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257648
    m_Localized: 'Fugitive: Sono sempre tutti super occupati. Sembra proprio che si stiano preparando per qualcosa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257649
    m_Localized: 'Fugitive: Comunque, forse il momento non era proprio quello giusto. Uno di quei maiali si è girato e mi ha visto, poi ha iniziato a sparare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257650
    m_Localized: 'Fugitive: Sono caduto dalla recinzione, dritto in una pozzanghera, poi sono fuggito di corsa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257651
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257652
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257653
    m_Localized: 'Fugitive: Oh, puoi scommetterci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257654
    m_Localized: 'Fugitive: Hai sentito che la FEMA sta conducendo dei test per individuare i Visitatori?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257655
    m_Localized: 'Fugitive: Non si tratta di semplici voci di corridoio!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257656
    m_Localized: 'Fugitive: Io l''ho VISTO. Portano un povero bastardo qualsiasi in un tendone...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257657
    m_Localized: 'Fugitive: Poi si sentono delle urla soffocate e, un attimo dopo, trascinano fuori un sacco nero, mentre il tizio non esce più. Mi segui?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257658
    m_Localized: 'Fugitive: Stanno facendo qualcosa alle persone, ecco perché nessuno esce vivo dalle zone di quarantena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257659
    m_Localized: 'Fugitive: Quando ho visto quella merda, ho capito che dovevo andarmene subito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257660
    m_Localized: 'Fugitive: Per questo sono scappato, anche se mi sono beccato una pallottola scavalcando quel maledetto recinto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257661
    m_Localized: 'Fugitive: E ora sono un testimone... So troppe cose. Mi daranno la caccia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257662
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257663
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257664
    m_Localized: 'Fugitive: Grazie, davvero. Ti devo un favore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257665
    m_Localized: 'Fugitive: Sono felice di constatare che non sei come i tuoi vicini.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257666
    m_Localized: 'Fugitive: CAZZO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257667
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257668
    m_Localized: 'Fugitive: Ma certo, avrei dovuto immaginarlo. Sei proprio come gli altri... Un branco di ratti spaventati!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257669
    m_Localized: 'Fugitive: Che vi nascondete nei vostri buchi, chiudendo fuori tutti gli altri!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257670
    m_Localized: 'Fugitive: Ah, fa'' come ti pare. Passa una bella serata, stronzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257671
    m_Localized: 'Bestson: Puoi dirmi cosa sta succedendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257672
    m_Localized: 'Bestson: Fa così caldo che riesco a malapena a respirare. E le persone si comportano in modo... strano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257673
    m_Localized: 'Bestson: Si sparano e litigano fra loro... Non capisco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257674
    m_Localized: Aspetta, davvero non sai cosa sta succedendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257675
    m_Localized: Non guardi la TV?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257676
    m_Localized: 'Bestson: No. I telegiornali mi spaventano, quindi cerco di evitarli. Ma i miei genitori li guardano...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257677
    m_Localized: 'Bestson: Una mattina mi sono svegliato e loro stavano dando di matto. Hanno detto che dovevano partire immediatamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257678
    m_Localized: 'Bestson: È successo una settimana fa... e non sono ancora tornati. Ho aspettato, ma sembra siano semplicemente... spariti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257679
    m_Localized: 'Bestson: Ho bisogno di sapere la verità. Dove sono andati? Per favore... dimmi cosa sta succedendo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257680
    m_Localized: I Visitatori strisciano dal sottosuolo, non puoi fidarti di nessuno.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257681
    m_Localized: Il sole sta esplodendo e bruciando vive le persone.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257682
    m_Localized: 'Bestson: Al telegiornale si parla sempre e solo di catastrofi. Mi rende triste o mi spaventa, quindi ho smesso di guardarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257683
    m_Localized: 'Bestson: Ho letto da qualche parte che le persone che non guardano o leggono le notizie vivono più a lungo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257684
    m_Localized: 'Bestson: Ma mamma e papà le seguono sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257685
    m_Localized: 'Bestson: Di recente, credo che abbiano sentito qualcosa di veramente brutto al telegiornale...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257686
    m_Localized: 'Bestson: Ho tenuto la TV spenta, per non stressarmi, e quindi non ho idea di cosa stia succedendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257687
    m_Localized: 'Bestson: Sono partiti in fretta e furia un paio d''ore dopo la diretta... e non sono più tornati. Ora ho troppa paura per accendere la TV.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257688
    m_Localized: 'Bestson: Ho pensato che magari qualcun altro avrebbe potuto darmi delle spiegazioni, quindi... potresti farlo tu? Per favore?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257689
    m_Localized: I Visitatori strisciano dal sottosuolo, non puoi fidarti di nessuno.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257690
    m_Localized: Il sole sta esplodendo e bruciando vive le persone.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257691
    m_Localized: 'Bestson: Oddio... e se quei "Visitatori" mi avessero trovato e ucciso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257692
    m_Localized: 'Bestson: Accidenti, ma perché se ne sono andati? Perché non mi hanno portato via con loro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257693
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257694
    m_Localized: 'Bestson: Non so più cosa pensare... Magari non crederai neanche alla mia storia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257695
    m_Localized: 'Bestson: E ora, che cosa farò?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257696
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257697
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257698
    m_Localized: 'Bestson: Oddio, e se il sole... li avesse bruciati vivi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257699
    m_Localized: 'Bestson: Tutto questo è un incubo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257700
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257701
    m_Localized: 'Bestson: E ora, che cosa farò?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257702
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257703
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257704
    m_Localized: 'Bestson: Non so se sia una buona idea.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257705
    m_Localized: 'Bestson: E se tornassero a casa e io non ci fossi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257706
    m_Localized: 'Bestson: Ma... probabilmente hai ragione. Forse sarebbe meglio se restassi qui con te, per ora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257707
    m_Localized: 'Bestson: Sì, probabilmente è la cosa migliore da fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257708
    m_Localized: 'Bestson: Andrò a casa, nel caso dovessero tornare...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257709
    m_Localized: 'Bestson: Sì, torneranno presto, ne sono sicuro. Credo. Lo spero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257710
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257711
    m_Localized: 'Bestson: Addio, sconosciuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257712
    m_Localized: 'Buddy: Ciao, amico. C''è spazio per un tipo a posto come me?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257713
    m_Localized: Che ti è successo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257714
    m_Localized: Come faccio a sapere che sei un tipo a posto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257715
    m_Localized: 'Buddy: Ah, niente di che.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257716
    m_Localized: 'Buddy: Sono stato cacciato da mia suocera perché ho buttato fuori di casa un tizio della FEMA. Ora vive con il terrore di ritorsioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451776
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451777
    m_Localized: 'Buddy: Ah, te l''ho fatta, vero? Ti stavo solo prendendo in giro, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451778
    m_Localized: 'Buddy: Non ho una suocera, non sono neppure sposato!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451779
    m_Localized: 'Buddy: Il che significa che sono libero per un drink, se mai avessi voglia di fare un salto a un pub.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451780
    m_Localized: Sembri piuttosto allegro.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451781
    m_Localized: Sembri su di giri. Hai bevuto, per caso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451782
    m_Localized: 'Buddy: Credimi, ho il cuore più grande di qualsiasi persona tu possa mai incontrare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451783
    m_Localized: 'Buddy: Certo, potrei prendere a pugni gente dai denti perfetti e gli occhi graziosi... ma solo perché li invidio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451784
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451785
    m_Localized: 'Buddy: Dai, ti sto solo prendendo in giro! Rilassati.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451786
    m_Localized: 'Buddy: Uno o due atteggiamenti eccentrici non fanno di te un Visitatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451787
    m_Localized: 'Buddy: Non farei mai del male a qualcuno per via dei loro denti, dei loro occhi o di qualsiasi altra cosa dicano in TV. Non potrei neanche...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451788
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451789
    m_Localized: 'Buddy: Lasciamo perdere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451790
    m_Localized: Sembri piuttosto allegro.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451791
    m_Localized: Sembri su di giri. Hai bevuto, per caso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451792
    m_Localized: 'Buddy: Non sono il tipo da barzellette, ma... ehi, che c''è di male nell''essere un po'' allegri mentre il mondo cade a pezzi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451793
    m_Localized: 'Buddy: Ridere aiuta la sanità mentale, amico, soprattutto quando intorno a te c''è l''inferno. Senza, sarei andato fuori di testa da un pezzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451794
    m_Localized: 'Buddy: Mi spiace se la mia allegria ti mette a disagio. Sto solo cercando di non perdere le staffe, mi segui?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451795
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451796
    m_Localized: 'Buddy: Quindi, ehm... mi fai entrare, amico?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451797
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451798
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451799
    m_Localized: 'Buddy: Stamattina ho fatto una colazione da re. Mi attengo a un rigido piano alimentare: birra a colazione, vino a cena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451800
    m_Localized: 'Buddy: Gustoso, salutare e, se fatto nel modo giusto, è anche un ottimo modo per stare in forma. Guarda che fisico!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451801
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451802
    m_Localized: 'Buddy: Eh eh, rilassati, ti sto di nuovo prendendo in giro. Non avertene a male. Di questi tempi, non ci rimane altro che ridere!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451803
    m_Localized: 'Buddy: E perché non affogare la nostra infelicità nell''alcol? Affrontare tutto questo da sobri è troppo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451804
    m_Localized: 'Buddy: Ma scherzi a parte... Mi fai entrare, amico?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451805
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451806
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451807
    m_Localized: 'Buddy: Grazie mille.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451808
    m_Localized: 'Buddy: Sarei tutto solo soletto, altrimenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451809
    m_Localized: 'Buddy: Dannazione, amico...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451810
    m_Localized: 'Buddy: E va bene, non ti disturberò più. Me ne vado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451811
    m_Localized: 'Fatman: Dannazione... Fa un caldo infernale qui fuori. Un caldo infernale.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451812
    m_Localized: Ma è notte fonda.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451813
    m_Localized: Stai bene?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451814
    m_Localized: 'Fatman: Bah, sembra comunque di essere dentro un forno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451815
    m_Localized: 'Fatman: Forse fa più freschino rispetto al giorno, ma l''aria è densa come... come...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451816
    m_Localized: 'Fatman: Non riesco a respirare... Non è che, ehm, avresti un bagno?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451817
    m_Localized: Sì, certo che ce l'ho.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451818
    m_Localized: A che ti serve un bagno?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451819
    m_Localized: 'Fatman: No, assolutamente no! Non sto affatto bene. Guardami!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451820
    m_Localized: 'Fatman: Sento la pelle che mi si scioglie. Che si scioglie, ti dico!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451821
    m_Localized: 'Fatman: Oddio... è più caldo di qualsiasi resort tropicale in cui abbia mai soggiornato. Ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451822
    m_Localized: 'Fatman: Ho solo bisogno di una doccia fredda. Non è che, ehm, avresti un bagno?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451823
    m_Localized: Sì, certo che ce l'ho.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451824
    m_Localized: A che ti serve un bagno?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451825
    m_Localized: 'Fatman: Splendido! Un altro secondo e temo che mi sarei sciolto in una pozzanghera!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451826
    m_Localized: 'Fatman: A proposito... Non è che per caso hai del gelato, vero? Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451827
    m_Localized: 'Fatman: Senti, ragazzo, apri la porta. Ho bisogno di un bagno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451828
    m_Localized: 'Fatman: Sono a un passo dallo svenire e arrostire vivo sulla tua dannata porta di casa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451829
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451830
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451831
    m_Localized: 'Fatman: Dico sul serio, ragazzo! Io... non mi sento bene. Ho bisogno di acqua fredda, subito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451832
    m_Localized: 'Fatman: Mi sono trascinato fin qui, e per cosa? Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451833
    m_Localized: 'Fatman: Un ragazzaccio insolente che respinge un uomo influente come me. Ero io a dirigere questo circo! Ero un ministro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451834
    m_Localized: 'Fatman: Pensaci... Posso, ehm, assicurarti che ne varrà la pena...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451835
    m_Localized: 'Fatman: Lasciami entrare e quando tutto questo sarà finito, farò in modo che tu venga, ehm... ricompensato. E bene, aggiungerei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451836
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451837
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451838
    m_Localized: 'Fatman: Magnifico. Non te ne pentirai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451839
    m_Localized: 'Fatman: Una volta che tutto questo casino sarà finito, mi assicurerò che tu sia, ehm, sistemato in modo adeguato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451840
    m_Localized: 'Fatman: Ma è ridicolo! Non vedi quanto sto male qui fuori?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451841
    m_Localized: 'Fatman: Dove diavolo dovrei andare, eh? Sono... Sono spacciato!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451842
    m_Localized: 'Blind: Finalmente... un riparo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451843
    m_Localized: Cos'è successo ai tuoi occhi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451844
    m_Localized: Chi ti ha ridotto così?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451845
    m_Localized: 'Blind: Ho visto qualcosa di inenarrabile. Non oserò descriverlo... Perché soffermarsi su ciò che la mente genera quando si spezza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451846
    m_Localized: 'Blind: È sempre davanti a me, impresso a fuoco nell''oscurità.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451847
    m_Localized: 'Blind: Non ci sono parole per descrivere quell''antico terrore che mi ha lacerato l''anima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451848
    m_Localized: 'Blind: Fidati... Se l''avessi visto, avresti fatto altrettanto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451849
    m_Localized: Che cosa hai visto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451850
    m_Localized: Intendi l'uomo pallido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451851
    m_Localized: 'Blind: Sono... stato io stesso a farlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451852
    m_Localized: 'Blind: Ho dovuto sacrificare i miei occhi per non perdere la ragione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451853
    m_Localized: 'Blind: Pensavo che avrei cancellato quell''immagine mostruosa strappandoli via. Ora non vedo altro che un vuoto infinito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451854
    m_Localized: Che cosa hai visto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451855
    m_Localized: Intendi l'uomo pallido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451856
    m_Localized: 'Blind: Credimi, è meglio che tu non lo sappia...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451857
    m_Localized: 'Blind: Per QUELLA COSA, il nostro dolore è una festa! Un banchetto di sofferenza! Si ingozza di paura, dolore... delle nostre menti!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451858
    m_Localized: 'Blind: Il mio unico errore è stato quello di trovarmi al posto sbagliato nel momento sbagliato...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451859
    m_Localized: 'Blind: All''inizio, QUELLA COSA non mi aveva neanche notato. Era troppo occupata a divorare carne carbonizzata...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451860
    m_Localized: 'Blind: Consumando lentamente quei corpi anneriti... DAVANTI AI MIEI OCCHI!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451861
    m_Localized: 'Blind: Oddio, uno spettacolo simile... non lo augurerei al mio peggior nemico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451862
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451863
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451864
    m_Localized: 'Blind: Credi che basti un uomo pallido a farmi strappare gli occhi dalle orbite?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451865
    m_Localized: 'Blind: No... Oh, no. C''è qualcosa di molto peggio là fuori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451866
    m_Localized: 'Blind: Più grande, più forte... Innominabile. Segue l''odore della carne bruciata e raccoglie ciò che abbiamo seminato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451867
    m_Localized: 'Blind: QUELLA COSA non sarebbe mai dovuta esistere... NON DOVREBBE ESISTERE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451868
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451869
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451870
    m_Localized: 'Blind: Grazie... Forse ora potrò finalmente riposare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451871
    m_Localized: 'Blind: Dannazione... Sarà difficile dormire senza poter chiudere gli occhi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451872
    m_Localized: 'Blind: Va bene, me ne vado. Ma ti do un consiglio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451873
    m_Localized: 'Blind: Per l''amor del cielo, NON avvicinarti ai corpi carbonizzati dopo il tramonto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451874
    m_Localized: 'Blind: O ti troverà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451875
    m_Localized: 'Dude: Yo! Come butta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451876
    m_Localized: 'Dude: Ehi, amico, hai visto come sta andando tutto a rotoli? Che diavolo sta succedendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451877
    m_Localized: 'Dude: Dimmi la verità, amico: che mi sono perso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451878
    m_Localized: Il sole sta esplodendo e brucia vive le persone di giorno.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451879
    m_Localized: Creature simili a umani strisciano fuori dal sottosuolo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451880
    m_Localized: 'Dude: Ma dai, non ci credo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451881
    m_Localized: 'Dude: Fra, hai presente quel film? Quello con il tizio pelato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451882
    m_Localized: 'Dude: Dobbiamo solo inviare una squadra di astronauti cazzuti sul Sole, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451883
    m_Localized: 'Dude: Boom! Il razzo è stato lanciato, la missione per impedire la fine del mondo è partita! Fantastico, amico!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451884
    m_Localized: 'Dude: Oh‑oh, e la squadra deve essere composta da quattro persone. È il numero d''oro della sopravvivenza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451885
    m_Localized: Ma di che diavolo parli?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451886
    m_Localized: Sul serio non sai cosa sta succedendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451887
    m_Localized: 'Dude: Zombi?! LO SAPEVO, AMICO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451888
    m_Localized: 'Dude: Fra, puoi contare su di me per qualunque cosa ci aspetti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451889
    m_Localized: 'Dude: Ho visto così tanti film sull''argomento che, amico, sono praticamente un guru della sopravvivenza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451890
    m_Localized: 'Dude: Devi solo dirmi che tipo di zombi sono: i classici che si muovono lenti o quelli più veloci e agguerriti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451891
    m_Localized: 'Dude: E si tratta di un virus cerebrale blaerghhahaghrh o sono solo degli strambi non morti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451892
    m_Localized: 'Dude: Fidati, amico, la risposta a queste domande cambia COMPLETAMENTE la strategia d''azione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451893
    m_Localized: 'Dude: Inoltre, hai un fucile o delle granate? Avremo bisogno di un sacco di potenza di fuoco se vogliamo farcela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451894
    m_Localized: 'Dude: E cibo, amico. Un saaacco di cibo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451895
    m_Localized: Ma di che diavolo parli?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451896
    m_Localized: Sul serio non sai cosa sta succedendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451897
    m_Localized: 'Dude: Amicooo! So ESATTAMENTE di cosa parlo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451898
    m_Localized: 'Dude: Sai che gli scrittori di fantascienza sanno prevedere il futuro, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451899
    m_Localized: 'Dude: È come se avessero una mente cosmica e riuscissero a immaginare follie tecnologiche ancora prima che accadano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451900
    m_Localized: 'Dude: Immagina se andassimo nello spazio e iniziassimo a inviare lettere agli alieni... Wooow!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451901
    m_Localized: 'Dude: È pazzesco, amico! Uno che conosco ha letto una rivista dove è successo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451902
    m_Localized: 'Dude: Ok, ok, mi calmo, tranquillo... Allora, mi fai entrare?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451903
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451904
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451905
    m_Localized: 'Dude: Ehi, amico, qui fuori è un casino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451906
    m_Localized: 'Dude: La gente spara cazzate sugli altri, e rovina l''atmosfera con tutto questo pessimismo e questa negatività...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451907
    m_Localized: 'Dude: E la merda che dicono al telegiornale? È ovvio che l''aria sia pesante, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451908
    m_Localized: 'Dude: Ma i film, fra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451909
    m_Localized: 'Dude: Hanno TUTTO... Dramma, tradimenti, intrighi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451910
    m_Localized: 'Dude: Sono molto più divertenti dei libri, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451911
    m_Localized: 'Dude: Ho sempre sperato di finire in un film, un giorno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451912
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451913
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451914
    m_Localized: 'Dude: Grande!!! Grazie mille, amico!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451915
    m_Localized: 'Dude: Cacchio, questa potrebbe essere la cosa più fantastica che mi sia mai capitata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451916
    m_Localized: 'Dude: Prima o poi dovrebbero proprio farci un film!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451917
    m_Localized: 'Dude: Uff, che seccatura...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451918
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451919
    m_Localized: 'Dude: Va bene, fra, capisco... Nessun rancore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451920
    m_Localized: 'Dude: Abbi cura di te, amico mio... e dei tuoi coinquilini.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451921
    m_Localized: 'Teacher: Mi spiace disturbarti, ma... hai un momento?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451922
    m_Localized: 'Teacher: Mi sento uno schifo. Possiamo parlare?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451923
    m_Localized: Cos'è successo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451924
    m_Localized: Chi sei?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451925
    m_Localized: 'Teacher: Io... volevo solo dare un minimo di speranza a dei bambini abbandonati.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451926
    m_Localized: 'Teacher: Ho accolto quelli che consideravano "infetti", quelli che temevano potessero essere dei Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451927
    m_Localized: 'Teacher: Vivevamo insieme nel vecchio edificio dell''asilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451928
    m_Localized: 'Teacher: Avevano solo bisogno di qualcuno che si occupasse di loro, che li amasse. Ho fatto del mio meglio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451929
    m_Localized: 'Teacher: Ma non è stato abbastanza... Non ho potuto salvarli dall''incendio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451930
    m_Localized: Cos'è successo ai bambini?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451931
    m_Localized: Com'è scoppiato l'incendio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451932
    m_Localized: 'Teacher: Ero un''insegnante dell''asilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451933
    m_Localized: 'Teacher: Quando il mondo ha iniziato a collassare, ho preso con me i piccoli rimasti soli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451934
    m_Localized: 'Teacher: Avevano perso i genitori per motivi diversi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451935
    m_Localized: 'Teacher: Alcuni erano stati presi dalla FEMA, altri uccisi, e altri...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451936
    m_Localized: 'Teacher: Sono stati abbandonati nell''attimo stesso in cui hanno mostrato segni riconducibili ai Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451937
    m_Localized: 'Teacher: Ma ora... sono tutti morti. Non è sopravvissuto nessuno all''incendio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451938
    m_Localized: Cos'è successo ai bambini?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451939
    m_Localized: Com'è scoppiato l'incendio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451940
    m_Localized: 'Teacher: Loro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451941
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451942
    m_Localized: 'Teacher: Sono morti... tra le fiamme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451943
    m_Localized: 'Teacher: Sono stati gli altri cittadini ad appiccarlo. Erano terrorizzati all''idea che i bambini potessero essere davvero dei Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451944
    m_Localized: 'Teacher: Mi hanno costretto a guardare... Prima hanno chiuso le porte a chiave, inchiodato le finestre... poi hanno dato fuoco all''edificio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451945
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451946
    m_Localized: 'Teacher: Riesco ancora a vedere i loro occhietti terrorizzati che mi fissano...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451947
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451948
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451949
    m_Localized: 'Teacher: Sono stati... gli altri cittadini.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451950
    m_Localized: 'Teacher: Hanno scoperto che stavo dando rifugio a dei bambini che mostravano segni riconducibili ai Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451951
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451952
    m_Localized: 'Teacher: Cosa siamo diventati? Una folla senza cuore che giudica bambini indifesi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451953
    m_Localized: 'Teacher: Cosa hanno fatto per meritarsi un simile destino?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451954
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451955
    m_Localized: 'Teacher: Sono bruciati vivi, tutti. E mi hanno costretto a guardare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451956
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451957
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451958
    m_Localized: 'Teacher: So che non posso fare nulla per riportarli indietro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451959
    m_Localized: 'Teacher: Ma grazie per... avermi ascoltato. E per avermi accolto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451960
    m_Localized: 'Teacher: Non ti biasimo, ma ti prego... promettimi una cosa prima che me ne vada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451961
    m_Localized: 'Teacher: Se mai dovessi incontrare un bambino solo e bisognoso d''aiuto... ti prego, prenditi cura di lui. Addio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451962
    m_Localized: 'Ballerina: Ciao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451963
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451964
    m_Localized: 'Ballerina: Apri o no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451965
    m_Localized: Conosci l'uomo pelato, per caso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451966
    m_Localized: Ti serve qualcosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451967
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451968
    m_Localized: 'Ballerina: Troppe domande. Sì, lo conosco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451969
    m_Localized: 'Ballerina: A cosa serve saperlo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451970
    m_Localized: Chi sei?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451971
    m_Localized: Perché hai bussato alla mia porta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451972
    m_Localized: 'Ballerina: Cassa di birra. Cassettiera. Prosciutto. Non so, va bene tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451973
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451974
    m_Localized: 'Ballerina: Apri sì oppure no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451975
    m_Localized: 'Ballerina: Mi hanno detto venire qui, quindi eccomi qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451976
    m_Localized: Chi sei?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451977
    m_Localized: Perché hai bussato alla mia porta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451978
    m_Localized: 'Ballerina: Io ballo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451979
    m_Localized: 'Ballerina: Balletti. Si vede?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451980
    m_Localized: Qualcuno ti ha mandato qui?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451981
    m_Localized: Mi ricordi... qualcuno.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451982
    m_Localized: 'Ballerina: Vedi la città? Vivevo lì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451983
    m_Localized: 'Ballerina: Ho visto casa tua. Camminato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451984
    m_Localized: 'Ballerina: Non fa caldo qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451985
    m_Localized: Qualcuno ti ha mandato qui?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451986
    m_Localized: Mi ricordi... qualcuno.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451987
    m_Localized: 'Ballerina: Che importa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451988
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451989
    m_Localized: 'Ballerina: Bah.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451990
    m_Localized: Non credo tu sia umana.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451991
    m_Localized: Dimostrami che sei umana.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451992
    m_Localized: 'Ballerina: Davvero? Ok...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451993
    m_Localized: 'Ballerina: E quindi? Basta così?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451994
    m_Localized: 'Ballerina: Cosa strana da dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451995
    m_Localized: Non credo tu sia umana.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646080
    m_Localized: Dimostrami che sei umana.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646081
    m_Localized: 'Ballerina: E quindi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646082
    m_Localized: 'Ballerina: Vuoi vedermi ballare?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646083
    m_Localized: 'Ballerina: Magari potrei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646084
    m_Localized: 'Ballerina: Io sono una ball‑erina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646085
    m_Localized: 'Ballerina: Allora? Tu decidi. Che facciamo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646086
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646087
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646088
    m_Localized: 'Ballerina: Due braccia, due gambe, una testa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646089
    m_Localized: 'Ballerina: Non abbastanza per te?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646090
    m_Localized: 'Ballerina: Ho superato test?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646091
    m_Localized: 'Ballerina: Apri sì oppure no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646092
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646093
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646094
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646095
    m_Localized: 'Ballerina: Povera ballerina, congelata per freddo... Che tristezza...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646096
    m_Localized: 'Ballerina: Non torturare gattino. Gattino odia freddo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646097
    m_Localized: 'Ballerina: Guarda gattino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646098
    m_Localized: 'Ballerina: Pensaci bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646099
    m_Localized: E va bene, entra...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646100
    m_Localized: Sparisci.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646101
    m_Localized: 'Ballerina: Metterò comoda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646102
    m_Localized: 'Ballerina: Dai, gattino. Ora di scorrazzare!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646103
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646104
    m_Localized: 'Ballerina: Troverai gattino sotto casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646105
    m_Localized: 'Ballerina: Piccolo regalo. Da parte mia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646106
    m_Localized: 'Couple: ... Ecco, così va molto meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646107
    m_Localized: 'Couple: Oh, ciao! Io e la mia adorabile mogliettina stiamo cercando un posto sicuro dove ripararci!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646108
    m_Localized: 'Couple: Ti dispiacerebbe se ci fermassimo qui per qualche tempo? Solo se non è un problema, s''intende.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646109
    m_Localized: La mia casa vi sembra un posto sicuro?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646110
    m_Localized: E chi mi dice che non porterete guai?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646111
    m_Localized: 'Couple: Sinceramente, casa tua sembra la più sicura tra tutte quelle che abbiamo visto finora. Vero, tesoro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646112
    m_Localized: 'Couple: Non so bene come spiegarlo, eh eh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646113
    m_Localized: 'Couple: Una casa grande, leggermente fuori mano, senza vicini ficcanaso... e con meno possibilità che si presenti qualche pazzo alla porta, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646114
    m_Localized: Perché tua moglie non dice una parola?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646115
    m_Localized: Sembrate stanchi, che succede?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646116
    m_Localized: 'Couple: Beh... potremmo andare a cercare riparo da qualche altra parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646117
    m_Localized: 'Couple: Ma la mia signora è esausta. Ha bisogno di riposare. Possiamo restare qui per un po''?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646118
    m_Localized: 'Couple: Se non è chiedere troppo, ovviamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646119
    m_Localized: Perché tua moglie non dice una parola?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646120
    m_Localized: Sembrate stanchi, che succede?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646121
    m_Localized: 'Couple: Che domande! Tesoro, perché non gli rispondi tu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646122
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646123
    m_Localized: 'Couple: È solo molto stanca, mi spiace.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646124
    m_Localized: 'Couple: Ma magari possiamo fare due chiacchiere tutti insieme un altro giorno. Se mai ci rivedremo, ovviamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646125
    m_Localized: 'Couple: Vero, tesoro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646126
    m_Localized: 'Couple: Oh, perdonami. Dovrei smetterla di insistere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646127
    m_Localized: Entrate.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646128
    m_Localized: Dovreste andarvene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646129
    m_Localized: 'Couple: Beh, non lo siamo tutti, ultimamente? Tra i Visitatori, il caldo, la perdita del lavoro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646130
    m_Localized: 'Couple: Non ha fatto che piovere sul bagnato... È stata dura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646131
    m_Localized: 'Couple: Devo ringraziare mia moglie. Senza di lei, non sarei riuscito a superare tutto questo. A te, invece, cosa dà la forza di andare avanti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646132
    m_Localized: 'Couple: Oh, scusa, non avrei dovuto chiedertelo. Non sono affari miei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646133
    m_Localized: Entrate.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646134
    m_Localized: Dovreste andarvene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646135
    m_Localized: 'Couple: Oh, grazie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646136
    m_Localized: 'Couple: Perché te ne stai lì impalata? Su, tesoro, questo signore gentile ci ha invitato a entrare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646137
    m_Localized: 'Couple: È solo un po'' timida. Va tutto bene, tesoro, ti faremo riposare e presto tornerà tutto alla normalità.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646138
    m_Localized: 'Couple: Ho capito. Chiedo scusa per il disturbo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646139
    m_Localized: 'Couple: Dovremo solo continuare a cercare, vero, tesoro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646140
    m_Localized: 'Couple: Forza, muovi quelle dannate gambe. Anch''io sono stanco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646141
    m_Localized: 'BigLebowski: Ehi! Ehm... o forse è meglio ciao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646142
    m_Localized: 'BigLebowski: Abiti qui? Cioè, questa è casa tua?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646143
    m_Localized: Stai cercando qualcuno?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646144
    m_Localized: Sì, è casa mia.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646145
    m_Localized: 'BigLebowski: Nah, ho solo bisogno di... un posto per riposarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646146
    m_Localized: 'BigLebowski: Sono stufa di nascondermi nei seminterrati. Di questo passo, presto dimenticherò come si parla. Non che ti importi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646149
    m_Localized: Che ci fai nascosta nei seminterrati?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646150
    m_Localized: Dove sono i tuoi genitori?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646151
    m_Localized: 'BigLebowski: Senti, maaa... posso entrare? O mi lascerai qui fuori?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646152
    m_Localized: 'BigLebowski: Non sono riuscita a trovare un seminterrato decente dove nascondermi, quindi eccomi qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646155
    m_Localized: Che ci fai nascosta nei seminterrati?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646156
    m_Localized: Dove sono i tuoi genitori?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646157
    m_Localized: 'BigLebowski: Sto... viaggiando, per modo di dire. Voglio vedere il mondo, posti diversi. Magari troverò una nuova casa da qualche parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646158
    m_Localized: 'BigLebowski: Ma sono al verde, quindi o trovo un accordo per una stanza o mi intrufolo nei seminterrati. Pazienza, è la vita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646159
    m_Localized: 'BigLebowski: A volte capita anche di imbattersi in qualche idiota, uff...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646160
    m_Localized: 'BigLebowski: Quindi prova a fare qualcosa di losco e ti spacco la faccia!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646161
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646162
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646163
    m_Localized: 'BigLebowski: Che diavolo ne so! Probabilmente saranno a casa, dove altro potrebbero essere?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646164
    m_Localized: 'BigLebowski: O forse si sono trasformati in Visitatori. Gli starebbe proprio bene, ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646165
    m_Localized: 'BigLebowski: Mia madre ama abbronzarsi, quindi, chissà... Anche questa potrebbe essere un''alternativa divertente.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633024
    m_Localized: 'BigLebowski: Ma chi se ne frega. Ora sono qui, no? E mi farebbe comodo un tetto sopra la testa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633025
    m_Localized: 'BigLebowski: Vuoi davvero lasciare una ragazzina qui fuori? Sotto il sole cocente? Con i Visitatori in giro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646166
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646167
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646168
    m_Localized: 'BigLebowski: Non ci credo! Wooow...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646169
    m_Localized: 'BigLebowski: Per caso hai anche la moquette? Che figata!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646170
    m_Localized: 'BigLebowski: Ma, ma... Bah, come ti pare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646171
    m_Localized: 'BigLebowski: Chi se ne frega.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646172
    m_Localized: 'BigLebowski: Tanto, scommetto che sei uno di quei brutti ceffi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646173
    m_Localized: 'BigLebowski: Vaffanculo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646174
    m_Localized: 'Luka: Ehilà! Tu, dall''altra parte della porta! Ho sentito i tuoi passi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646175
    m_Localized: 'Luka: Ti spiace se mi trattengo per la notte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646176
    m_Localized: Mi sembri di buonumore o sbaglio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646177
    m_Localized: Perché quella faccia?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646178
    m_Localized: 'Luka: C''è già abbastanza rabbia nel mondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646179
    m_Localized: 'Luka: Sì, è un momento difficile, ma c''è ancora tanto per cui vale la pena lottare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646180
    m_Localized: 'Luka: La prossima generazione, l''arte... La gioia di vivere, fine a sé stessa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646181
    m_Localized: 'Luka: Se continuiamo a ripeterci che andrà tutto bene, allora magari la situazione migliorerà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646182
    m_Localized: Cosa c'è da essere felici?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646183
    m_Localized: Perciò, preferisci mentire alle persone?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646184
    m_Localized: 'Luka: Che ha che non va la mia faccia? A me sembra a posto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646185
    m_Localized: 'Luka: Ah, intendi perché sto sorridendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646186
    m_Localized: 'Luka: Sì, beh... anch''io è parecchio che non vedo facce sorridenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646187
    m_Localized: 'Luka: La paura ha fatto dimenticare alle persone cosa significhi provare gioia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646188
    m_Localized: 'Luka: La disperazione ci rende ciechi di fronte a quel poco di buono che ancora rimane a questo mondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646189
    m_Localized: Cosa c'è da essere felici?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646190
    m_Localized: Perciò, preferisci mentire alle persone?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646191
    m_Localized: 'Luka: Ci sono tanti motivi per esserlo, ma non posso certo dirti io quali.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646192
    m_Localized: 'Luka: Cosa ti piaceva fare prima di tutto questo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646193
    m_Localized: 'Luka: Prova a ricordare ciò che ti rendeva felice.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646194
    m_Localized: 'Luka: Non possiamo crogiolarci nella disperazione, ora più che mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646195
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646196
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646197
    m_Localized: 'Luka: Perché mentire? Le persone stanno affogando nel proprio dolore, lo capisco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646198
    m_Localized: 'Luka: Ma a volte, se ricordi loro cosa li rendeva felici un tempo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646199
    m_Localized: 'Luka: Quando il loro obiettivo non era solo sopravvivere, ma creare qualcosa di... bello.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646200
    m_Localized: 'Luka: Capisci cosa intendo? Ultimamente, la vita è diventata troppo amara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646201
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646202
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646203
    m_Localized: 'Luka: Spero che ti ricorderai com''era essere felici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646204
    m_Localized: 'Luka: Forse, allora... la morte non sarà il tuo unico pensiero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646205
    m_Localized: 'Luka: Non seppellirti nel tuo dolore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646206
    m_Localized: 'Luka: Se rimugini troppo, finirà per divorarti vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646207
    m_Localized: 'Luka: E a quel punto, beh... le cose possono prendere velocemente una brutta piega.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646208
    m_Localized: 'Luka: Abbi cura di te, ok?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840384
    m_Localized: 'Gasmask: Buonasera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840385
    m_Localized: 'Gasmask: Faccio parte della FEMA. Stiamo effettuando un''ispezione di routine nel quartiere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840386
    m_Localized: 'Gasmask: Non si preoccupi, non ci vorrà molto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840387
    m_Localized: Quando riporterete la persona che avete prelevato?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840388
    m_Localized: Com'è andata l'ultima ispezione?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840389
    m_Localized: 'Gasmask: Riportare?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840390
    m_Localized: 'Gasmask: Ah, quindi una delle nostre squadre è già stata qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840391
    m_Localized: 'Gasmask: Dopo i controlli, è previsto un periodo di quarantena obbligatorio. Rimarrà con noi per qualche tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840392
    m_Localized: 'Gasmask: Finita la quarantena, sarà libera di tornare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840393
    m_Localized: D'accordo, se non c'è altro modo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840394
    m_Localized: Non mi interessano queste ispezioni.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840395
    m_Localized: 'Gasmask: I risultati sono stati inconcludenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840396
    m_Localized: 'Gasmask: Per studiare più approfonditamente gli effetti del sole, dovremo prelevare un altro residente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840397
    m_Localized: D'accordo, se non c'è altro modo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840398
    m_Localized: Non mi interessano queste ispezioni.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840399
    m_Localized: 'Gasmask: Non si preoccupi. Le procedure sono impegnative, ma concediamo a tutti il tempo necessario per recuperare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840400
    m_Localized: 'Gasmask: Una volta completati i test, le daremo ulteriori istruzioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840401
    m_Localized: 'Gasmask: Temo che ci sia stato un malinteso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840402
    m_Localized: 'Gasmask: Non le stiamo dando una scelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840403
    m_Localized: 'Gasmask: Le ispezioni procederanno, che lei lo voglia o meno. Prima collabora, prima sarà tutto finito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840404
    m_Localized: 'Gasmask: Salve.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840405
    m_Localized: 'Gasmask: Abbiamo bisogno di altri soggetti da sottoporre ai test.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840406
    m_Localized: 'Gasmask: Prima li otteniamo, meglio è.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840407
    m_Localized: Cosa sta succedendo in città?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840408
    m_Localized: Prima riportate chi avete preso!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840409
    m_Localized: 'Gasmask: Ripercussioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840410
    m_Localized: 'Gasmask: Resista e si formeranno ancora più focolai da debellare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840411
    m_Localized: 'Gasmask: Dare rifugio ai Visitatori non fa altro che permettere loro di moltiplicarsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840412
    m_Localized: 'Gasmask: E questo porterà solo a ulteriore violenza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840413
    m_Localized: Quanto ancora durerà tutto questo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840414
    m_Localized: Quando ci libereremo dei Visitatori?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840415
    m_Localized: 'Gasmask: Non è nella posizione di fare richieste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840416
    m_Localized: 'Gasmask: La gente non ha fatto altro che cercare di intralciarci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840417
    m_Localized: 'Gasmask: E guardi dove ci ha portato tutto questo. Abbiamo dovuto sterminare un''intera colonia di Visitatori, di recente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840418
    m_Localized: 'Gasmask: Un posto che un tempo... era la mia città natale.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840419
    m_Localized: Quanto ancora durerà tutto questo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840420
    m_Localized: Quando ci libereremo dei Visitatori?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840421
    m_Localized: 'Gasmask: Stiamo ancora studiando l''origine di questi eventi. Le consiglio di non immischiarsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840422
    m_Localized: 'Gasmask: Difficile dire quando tutto tornerà alla normalità. Servono ulteriori test per tenere la situazione sotto controllo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840423
    m_Localized: 'Gasmask: Cooperi e tutto questo finirà ancor prima che se ne accorga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840424
    m_Localized: Quindi, adesso che si fa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840425
    m_Localized: Devo lasciarvi prelevare un altro ospite?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840426
    m_Localized: 'Gasmask: Se avessi una risposta semplice da darle, non ci sarebbe bisogno della FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840427
    m_Localized: 'Gasmask: Ci lasci fare il nostro lavoro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840428
    m_Localized: 'Gasmask: Abbiamo tutto sotto controllo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840429
    m_Localized: Quindi, adesso che si fa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840430
    m_Localized: Devo lasciarvi prelevare un altro ospite?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840431
    m_Localized: 'Gasmask: Ci servono persone.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840432
    m_Localized: 'Gasmask: Due, per la precisione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840433
    m_Localized: 'Gasmask: Accelererà il processo. È per il bene di tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840434
    m_Localized: E va bene, se sarà d'aiuto...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840435
    m_Localized: No, ho già fatto la mia parte.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840436
    m_Localized: 'Gasmask: Sì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840437
    m_Localized: 'Gasmask: Ma questa volta ce ne servono due.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840438
    m_Localized: 'Gasmask: Non importa chi. Ci consegni due residenti, subito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840439
    m_Localized: 'Gasmask: Presto tornerà tutto alla normalità.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840440
    m_Localized: E va bene, se sarà d'aiuto...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840441
    m_Localized: No, ho già fatto la mia parte.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840442
    m_Localized: 'Gasmask: Ricordi, aiutare noi significa aiutare tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840443
    m_Localized: 'Gasmask: La ringrazio per la comprensione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840444
    m_Localized: 'Gasmask: Riporteremo queste persone al più presto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840445
    m_Localized: 'Gasmask: E ci occuperemo dei Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840446
    m_Localized: 'Gasmask: Ma porca miseria...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840447
    m_Localized: 'Gasmask: Lei non si rende conto della situazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840448
    m_Localized: 'Gasmask: Le piace il panorama alle mie spalle?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840449
    m_Localized: 'Gasmask: È quello che succede quando stronzi testardi come lei ci mettono i bastoni tra le ruote.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840450
    m_Localized: 'Gasmask: Resista e non ci sarà fine al peggio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840451
    m_Localized: 'Gasmask: Noi abbiamo a cuore questa città.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840452
    m_Localized: 'Gasmask: Ci consegni due persone. Subito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840453
    m_Localized: 'Gasmask: Le rivedrà presto. E grazie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840454
    m_Localized: 'Gasmask: Ci servono altre persone.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840455
    m_Localized: 'Gasmask: È l''unico modo per impedire una catastrofe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840456
    m_Localized: Dove sono le persone che avete preso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840457
    m_Localized: Che catastrofe?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840458
    m_Localized: 'Gasmask: BASTA CON LE STRONZATE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840459
    m_Localized: 'Gasmask: IL MONDO STA PER FINIRE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840460
    m_Localized: 'Gasmask: Continui a giocare e porteremo via tutti gli occupanti di questa casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840461
    m_Localized: Cosa ci vorrà per sistemare la situazione?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840462
    m_Localized: A che diavolo serve la sua organizzazione se tutto ciò che fa non funziona?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840463
    m_Localized: 'Gasmask: Una dalla portata disastrosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840464
    m_Localized: 'Gasmask: Le autorità hanno difficoltà a contenere l''epidemia. Sono pronte a far saltare in aria l''intera città.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840465
    m_Localized: 'Gasmask: Gli ordini che ci impartiscono sono impossibili da rispettare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840466
    m_Localized: 'Gasmask: Se non troviamo un modo per sopravvivere, sarà qualcun altro a decidere per noi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840467
    m_Localized: Cosa ci vorrà per sistemare la situazione?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840468
    m_Localized: A che diavolo serve la sua organizzazione se tutto ciò che fa non funziona?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840469
    m_Localized: 'Gasmask: Altre due persone.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840470
    m_Localized: 'Gasmask: Non vogliamo prendere tutti. Ce ne servono solo due.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840471
    m_Localized: 'Gasmask: Dopodiché, o troveremo un modo per sradicare i Visitatori, o non ci rivedremo mai più.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840472
    m_Localized: Bene, speravo tanto di non rivederla.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840473
    m_Localized: Non le consegnerò nessun altro.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840474
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840475
    m_Localized: 'Gasmask: Ho esaurito la pazienza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840476
    m_Localized: 'Gasmask: Non mi interessa discutere con lei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840477
    m_Localized: 'Gasmask: O ci consegna subito due persone, o sfondiamo la porta e ripuliamo questo maledetto covo di topi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840478
    m_Localized: 'Gasmask: Lei non è il primo che tenta di fare resistenza. Ci siamo già occupati degli altri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840479
    m_Localized: 'Gasmask: Ci occuperemo anche di lei, se necessario.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840480
    m_Localized: Bene, speravo tanto di non rivederla.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840481
    m_Localized: Non le consegnerò nessun altro.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840482
    m_Localized: 'Gasmask: Il sentimento è reciproco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840483
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840484
    m_Localized: 'Gasmask: È tutto. Le auguro una buonanotte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840485
    m_Localized: 'Gasmask: È come parlare con un dannato muro... Ascolti bene, ecco cosa succederà se non collabora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840486
    m_Localized: 'Gasmask: Sfonderemo la porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840487
    m_Localized: 'Gasmask: Prenderemo tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840488
    m_Localized: 'Gasmask: E la lasceremo qui a morire da solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840489
    m_Localized: 'Gasmask: Perciò, prenderemo due persone. ORA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840490
    m_Localized: 'Gasmask: Poi ce ne andremo per la nostra strada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840491
    m_Localized: 'Prophet: Eccellente, il gatto è con te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840492
    m_Localized: 'Prophet: Cosa fare con chi te l''ha portato... sarà una scelta che spetterà a te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840493
    m_Localized: Come sapevi del gatto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840494
    m_Localized: Perché mi hai chiesto di far entrare qualcuno con un gatto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840495
    m_Localized: 'Prophet: Vedo più lontano di molti. È un dono.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840496
    m_Localized: 'Prophet: Non vedo tutto, ma tu... So cosa ti aspetta lungo il cammino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840497
    m_Localized: 'Prophet: Si preannuncia qualcosa di terribile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840498
    m_Localized: 'Prophet: Non sei la causa, ma ne subirai comunque le conseguenze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840499
    m_Localized: 'Prophet: Forse ne parleranno alla radio. L''ascolterai?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840500
    m_Localized: Cosa dovrei farmene di questa informazione?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840501
    m_Localized: Cosa succederà?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840502
    m_Localized: 'Prophet: Una potente entità è in attesa del gatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840503
    m_Localized: 'Prophet: È grazie a essa che il mio sguardo arriva lontano, ma nemmeno io posso vedere tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840504
    m_Localized: 'Prophet: Un aspetto, tuttavia, è chiaro: si preannuncia qualcosa di terribile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840505
    m_Localized: 'Prophet: Non puoi impedirlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840506
    m_Localized: 'Prophet: Forse ne parleranno alla radio. L''ascolterai?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840507
    m_Localized: Cosa dovrei farmene di questa informazione?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840508
    m_Localized: Cosa succederà?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840509
    m_Localized: 'Prophet: Nulla, ho già detto troppo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840510
    m_Localized: 'Prophet: Ma nei prossimi due giorni... i test presagiscono sventura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840511
    m_Localized: 'Prophet: Sospendi i tuoi controlli fino al terzo sorgere del sole.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840512
    m_Localized: 'Prophet: Se lo farai, potrò continuare a guidarti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840513
    m_Localized: 'Prophet: Forse ti porterà pace, o almeno ti aiuterà ad andare avanti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840514
    m_Localized: 'Prophet: Spero di vederti presto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840515
    m_Localized: 'Prophet: Non posso aggiungere altro, ho già detto troppo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840516
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840517
    m_Localized: 'Prophet: Consideralo un consiglio, se vuoi, ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840518
    m_Localized: 'Prophet: Nei prossimi due giorni... i test presagiscono sventura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840519
    m_Localized: 'Prophet: Quando sono arrivato qui per la prima volta, ho provato una sensazione... strana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840520
    m_Localized: 'Prophet: Ora si è attenuata, penso che siamo sulla strada giusta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840521
    m_Localized: 'Prophet: Spero di rivederti presto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840522
    m_Localized: 'Prophet: Sei lì, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840523
    m_Localized: 'Prophet: La sensazione è peggiorata, strano...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840524
    m_Localized: 'Prophet: È per via di tutta questa distruzione?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840525
    m_Localized: Ti serve aiuto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840526
    m_Localized: Stai parlando da solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840527
    m_Localized: 'Prophet: Ho già tutto l''aiuto di cui ho bisogno, solo che...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840528
    m_Localized: 'Prophet: Mi sento debole. La mia vista non arriva più lontano come prima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840529
    m_Localized: 'Prophet: Dubito che sia tu, o lei...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840530
    m_Localized: 'Prophet: È già successo una volta, all''inizio. Andrà tutto bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840531
    m_Localized: 'Prophet: Nuovi steli germoglieranno dalla cenere e si protenderanno verso il cielo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840532
    m_Localized: Non capisco mai niente di ciò che dici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840533
    m_Localized: Comincio a pentirmi di essermi fidato di te.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840534
    m_Localized: 'Prophet: No, direi proprio di no.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840535
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840536
    m_Localized: 'Prophet: Sai, esiste un''entità più potente di tutti noi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840537
    m_Localized: 'Prophet: Ma non devi temerla. Semplicemente, non ne siamo consapevoli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840538
    m_Localized: 'Prophet: Verrà in tuo aiuto se glielo chiedi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840539
    m_Localized: 'Prophet: Ma ora... c''è qualcosa che non va. Potrebbe essere... l''uomo fungo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840540
    m_Localized: Non capisco mai niente di ciò che dici.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840541
    m_Localized: Comincio a pentirmi di essermi fidato di te.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840542
    m_Localized: 'Prophet: Santo cielo... Non era mia intenzione spaventarti. Sto solo pensando ad alta voce.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840543
    m_Localized: 'Prophet: Prima di venire da te, mi sembrava tutto così chiaro. Ora... è come se si fosse formata una nebbia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840544
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840545
    m_Localized: 'Prophet: Hai un seminterrato, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840546
    m_Localized: 'Prophet: C''è qualcosa lì, sotto il terreno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840547
    m_Localized: 'Prophet: Anche se non riesco a capire bene cosa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840548
    m_Localized: E a cosa dovrebbe servirmi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840549
    m_Localized: Sei sicuro ci sia davvero qualcosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840550
    m_Localized: 'Prophet: So che può sembrare bizzarro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840551
    m_Localized: 'Prophet: Ma c''è una ragione dietro al nostro incontro. Lo ricordo chiaramente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840552
    m_Localized: 'Prophet: Eppure... la mia vista si è offuscata. Ti vedo perso in una foresta oscura, circondato da bestie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840553
    m_Localized: 'Prophet: Io... vedo cosa succederà. Il seminterrato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840554
    m_Localized: 'Prophet: C''è qualcosa lì, sotterrato nel terreno...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840555
    m_Localized: 'Prophet: Sei destinato a trovarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840556
    m_Localized: E a cosa dovrebbe servirmi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840557
    m_Localized: Sei sicuro ci sia davvero qualcosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840558
    m_Localized: 'Prophet: Santo cielo... Non riesco a pensare lucidamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840559
    m_Localized: 'Prophet: Tuttavia, nel terreno... vedo qualcos''altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840560
    m_Localized: 'Prophet: Non saltare. Non ancora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840561
    m_Localized: 'Prophet: Devo riposare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840562
    m_Localized: 'Prophet: Io... ricordo... che era la cosa giusta da fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840563
    m_Localized: 'Prophet: Andava fatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840564
    m_Localized: 'Prophet: E tu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840565
    m_Localized: 'Prophet: Ricorda, saltare non ti aiuterà. Non ancora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840566
    m_Localized: 'Prophet: Ho bisogno di stare da solo con i miei pensieri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840567
    m_Localized: 'Prophet: Avevo dimenticato il tuo volto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840568
    m_Localized: 'Prophet: La mia vista si sta affievolendo. Ormai vedo a malapena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840569
    m_Localized: 'Prophet: Che mi abbia abbandonato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840570
    m_Localized: Basta che tu non muoia sul mio portico.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840571
    m_Localized: Non hai una bella cera...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840572
    m_Localized: 'Prophet: È troppo tardi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840573
    m_Localized: 'Prophet: Le visioni... sono sparite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034688
    m_Localized: 'Prophet: So cosa sta succedendo... Qualcosa che era nell''aria da tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034689
    m_Localized: 'Prophet: Oddio, devo... Lasciami in pace.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034690
    m_Localized: Di chi parli?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034691
    m_Localized: Stai morendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034692
    m_Localized: 'Prophet: È stata lei a farmi andare avanti per tutto questo tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034693
    m_Localized: 'Prophet: E adesso? Ha intenzione di riprendersi ogni cosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034694
    m_Localized: 'Prophet: Qual era il senso di tutto questo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034695
    m_Localized: Di chi parli?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034696
    m_Localized: Stai morendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034697
    m_Localized: 'Prophet: Io... non me lo ricordo nemmeno più.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034698
    m_Localized: 'Prophet: C''è una parola che continua a risuonarmi nella testa... Salta. Salta. Salta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034699
    m_Localized: 'Prophet: Non so se questo messaggio sia destinato a me... o a te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034700
    m_Localized: 'Prophet: Sono perso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034701
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034702
    m_Localized: 'Prophet: Mi prediresti di nuovo il futuro, per favore?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034703
    m_Localized: 'Prophet: Forse mi sarà d''aiuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034704
    m_Localized: Apri verso la fine.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034705
    m_Localized: Guarda a metà della pagina duecento.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034706
    m_Localized: Guarda la decima pagina.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034707
    m_Localized: 'Prophet: Che domanda bizzarra... Non capisco più nulla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034708
    m_Localized: 'Prophet: Ma una volta capivo... credo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034709
    m_Localized: 'Prophet: Ricordo solo una parola: salta. Che significa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034710
    m_Localized: 'Prophet: È un messaggio destinato a te?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034711
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034712
    m_Localized: 'Prophet: Ricordi quando ti ho chiesto di usare questo libro per predire il mio futuro? Lo rifaresti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034713
    m_Localized: 'Prophet: Ho paura. Forse mi sarà d''aiuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034714
    m_Localized: Apri verso la fine.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034715
    m_Localized: Guarda a metà della pagina duecento.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034716
    m_Localized: Guarda la decima pagina.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034717
    m_Localized: 'Prophet: "Viaggiamo da tempo su un treno che non porta da nessuna parte, ma la strada continua a scorrere sotto le sue ruote."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034718
    m_Localized: 'Prophet: ... Ora capisco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034719
    m_Localized: 'Prophet: Oh... Ho appena rammentato una cosa... Grazie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034720
    m_Localized: 'Prophet: Ora devo andare. Arrivederci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034721
    m_Localized: 'Prophet: "Un canto tra due mondi: fuoco, cammina con me."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034722
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034723
    m_Localized: 'Prophet: Un vero peccato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034724
    m_Localized: 'Prophet: Grazie, ma non è servito a nulla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034725
    m_Localized: 'Prophet: Arrivederci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034726
    m_Localized: 'Prophet: "I nostri giovani gridavano come le pire di Roano..."'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034727
    m_Localized: 'Prophet: Non ho la forza di continuare a leggere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034728
    m_Localized: 'Prophet: Credo che me ne andrò...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034729
    m_Localized: 'Prophet: Arrivederci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034730
    m_Localized: 'Hunter: Ehi, ragazzo. Come te la passi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034731
    m_Localized: 'Hunter: Non sono di queste parti. Non è mia consuetudine trattenermi a lungo nello stesso posto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034732
    m_Localized: 'Hunter: Ma non posso più vagabondare come un tempo. Colpa dell''età, figliolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034733
    m_Localized: Perché girare in un momento simile?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034734
    m_Localized: Cosa speri di trovare qui?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034735
    m_Localized: 'Hunter: Hai visto di cosa sono capaci quei Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034736
    m_Localized: 'Hunter: Casa dopo casa, gente morta, fatta a pezzi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034737
    m_Localized: 'Hunter: Fingono di essere uno di noi... poi si intrufolano nelle nostre dimore e si scatena l''inferno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034738
    m_Localized: 'Hunter: I parassiti vanno sterminati. Tutti quanti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034739
    m_Localized: Stai dando la caccia ai Visitatori?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034740
    m_Localized: E dov'è la tua arma?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034741
    m_Localized: 'Hunter: Qui in città? Avevo solo bisogno di un posto dove riposare le ossa, ragazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034742
    m_Localized: 'Hunter: Da quando è iniziata questa maledetta faccenda del sole, brulicano fuori dai loro nascondigli come insetti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034743
    m_Localized: 'Hunter: Ascoltami bene, figliolo: hanno in mente qualcosa e devono essere fermati.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034744
    m_Localized: Stai dando la caccia ai Visitatori?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034745
    m_Localized: E dov'è la tua arma?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034746
    m_Localized: 'Hunter: Tu non stai facendo lo stesso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034747
    m_Localized: 'Hunter: Non sei uno stupido, ragazzo, ma non mi limiterò a scacciarli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034748
    m_Localized: 'Hunter: Lasciane andare uno e tornerà presto a sgozzarti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034749
    m_Localized: 'Hunter: Non c''è una seconda possibilità con quei subdoli parassiti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034750
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034751
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034752
    m_Localized: 'Hunter: Avevo un fucile. Mi ha quasi fatto ammazzare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034753
    m_Localized: 'Hunter: Hanno aspettato che mi addormentassi. L''hanno rubato mentre dormivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034754
    m_Localized: 'Hunter: Sono scappato a gambe levate e figurati se non mi hanno sparato. È come si divertono quei dannati parassiti...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034755
    m_Localized: 'Hunter: Non c''è nulla di umano in loro, tranne la pelle che indossano, ragazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034756
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034757
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034758
    m_Localized: 'Hunter: Sapevo che non eri un rammollito. Hai carattere, ragazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034759
    m_Localized: 'Hunter: E noi li spazzeremo via. Nessun parassita si avvicinerà a meno di un chilometro da questo posto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034760
    m_Localized: 'Hunter: Diamine, forse è meglio così. Potresti essere uno di loro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034761
    m_Localized: 'Hunter: Potresti tagliarmi la gola prima che faccia giorno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034762
    m_Localized: 'Hunter: Giuro che non risparmierò alcun parassita. Aspetta e vedrai, ragazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034763
    m_Localized: 'Cold: C‑Ciao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034764
    m_Localized: 'Cold: Il caldo non mi tange. S‑Sto solo cercando un posto tranquillo dove riposarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034765
    m_Localized: 'Cold: Credi che p‑potrei trovare un po'' di pace in casa tua?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034766
    m_Localized: Chi sei?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034767
    m_Localized: È da molto che cerchi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034768
    m_Localized: 'Cold: Non ha più importanza, o‑ormai. Ti stai chiedendo se sono un Visitatore?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034769
    m_Localized: 'Cold: N‑Non lo sono, ma ho una richiesta da farti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034770
    m_Localized: 'Cold: La rimanderò a più tardi. Non sono ancora sicuro di p‑potermi fidare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034771
    m_Localized: Il caldo non ti dà fastidio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034772
    m_Localized: Togliti la giacca.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034773
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034774
    m_Localized: 'Cold: Non ho mai trovato pace.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034775
    m_Localized: 'Cold: Perciò... sì, è da molto tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034776
    m_Localized: Il caldo non ti dà fastidio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034777
    m_Localized: Togliti la giacca.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034778
    m_Localized: 'Cold: Ho sempre f‑freddo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034779
    m_Localized: 'Cold: Gli altri b‑bruciano sotto il sole. Io mi avvolgo in strati di vestiti eppure mi sembra sempre di essere sul punto di c‑congelare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034780
    m_Localized: 'Cold: Non oso t‑togliermene neanche uno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034781
    m_Localized: 'Cold: E se poi mi sentissi peggio? E non ci fosse la m‑morte a porre fine alle sofferenze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034782
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034783
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034784
    m_Localized: 'Cold: No.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034785
    m_Localized: 'Cold: Non devi lasciarmi entrare per forza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034786
    m_Localized: 'Cold: Me ne vado, non ti supplicherò. N‑Non ti darò più fastidio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034787
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034788
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034789
    m_Localized: 'Cold: G‑Grazie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034790
    m_Localized: 'Cold: Il soffitto è un po'' basso, ma andrà bene lo stesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034791
    m_Localized: 'Cold: Capisco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034792
    m_Localized: 'Cold: Addio, allora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034793
    m_Localized: 'Cold: Vedo che le tue mani s‑sono macchiate di polvere da s‑sparo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034794
    m_Localized: 'Cold: M‑Mi spareresti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034795
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034796
    m_Localized: 'Cold: Immagino che non vorrai s‑sprecare proiettili. Addio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228992
    m_Localized: 'Greatmother: Ehilà!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228993
    m_Localized: 'Greatmother: C''è qualcuno in casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228994
    m_Localized: Chi sei?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228995
    m_Localized: Stai cercando qualcuno?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228996
    m_Localized: 'Greatmother: Vivevo a un paio di isolati da qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228997
    m_Localized: 'Greatmother: Poi quei tizi gialli ci hanno cacciato tutti dall''edificio, ma senza offrirci un''alternativa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228998
    m_Localized: 'Greatmother: Nessun riparo, nessun aiuto... Dove dovevamo andare? Cosa dovevamo fare?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228999
    m_Localized: 'Greatmother: La gente è scappata in tutte le direzioni. Sono venuta qui nella speranza di sopravvivere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229000
    m_Localized: Perché vi hanno sfrattato?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229001
    m_Localized: Eravate in molti?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229002
    m_Localized: 'Greatmother: Non cerco nessuno. La mamma ha solo bisogno di un posto dove riposare, tesoro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229003
    m_Localized: 'Greatmother: Il mio edificio è stato completamente sgomberato, nessuno sa dove siano finiti tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229004
    m_Localized: 'Greatmother: È da allora che giro, alla ricerca di un posto dove rifugiarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229005
    m_Localized: Perché vi hanno sfrattato?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229006
    m_Localized: Eravate in molti?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229007
    m_Localized: 'Greatmother: Hanno detto che il nostro edificio era stato investito da una potente eruzione solare o qualcosa del genere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229008
    m_Localized: 'Greatmother: I tizi in giallo sono piombati dentro e hanno gettato fuori la gente a calci. Qualcuno lo hanno anche preso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229009
    m_Localized: 'Greatmother: Gli altri sono stati cacciati via come se nulla fosse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229010
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229011
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229012
    m_Localized: 'Greatmother: Era un intero dannato edificio!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229013
    m_Localized: 'Greatmother: Qualcuno ha cercato di resistere, ma i gialli li hanno trascinati via. Sembrava stessero prendendo gente a caso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229014
    m_Localized: 'Greatmother: Hanno sequestrato un intero gruppo, poveri loro. Non hanno neppure inseguito il resto di noi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229015
    m_Localized: 'Greatmother: Ora la mamma sta solo cercando di sopravvivere, tesoro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229016
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229017
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229018
    m_Localized: 'Greatmother: Oh, che tu sia benedetto. Ma non aprire a nessuno di quei gialletti che bussano alla porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229019
    m_Localized: 'Greatmother: Se lo farai, ci trascineranno chissà dove.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229020
    m_Localized: 'Greatmother: E va bene, fa'' solo attenzione a... non aprire la porta a quei tizi gialli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229021
    m_Localized: 'Greatmother: Anzi, forse... non dovresti aprirla affatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229022
    m_Localized: 'Greatmother: AH AH AH AH!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229023
    m_Localized: 'Greatmother: Porterò qui la mia prole. Mamma chioccia farà in modo che tu non muoia da solo... AH AH AH AH!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229024
    m_Localized: 'SuperFake: Sei ancora rintanato qui dentro, vedo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229025
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229026
    m_Localized: 'SuperFake: Cosa ne pensi di quei tipi? Quelli in tuta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229027
    m_Localized: Stanno solo facendo il loro lavoro.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229028
    m_Localized: Non so bene cosa pensare di loro.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229029
    m_Localized: 'SuperFake: Sono tempi difficili, ultimamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229030
    m_Localized: 'SuperFake: Piove sempre sul bagnato, dico bene?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229031
    m_Localized: 'SuperFake: Forse le tute ripristineranno l''ordine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229032
    m_Localized: 'SuperFake: O magari siamo noi a dover prendere in mano la situazione?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229033
    m_Localized: Non posso fare nulla.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229034
    m_Localized: Faccio già quel che posso.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229035
    m_Localized: 'SuperFake: Perché affannarsi a pensare, in effetti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229036
    m_Localized: 'SuperFake: È già stato tutto deciso per noi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229037
    m_Localized: 'SuperFake: Una benedizione, non credi anche tu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229038
    m_Localized: 'SuperFake: O vorresti sistemare tutto da solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229039
    m_Localized: Non posso fare nulla.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229040
    m_Localized: Faccio già quel che posso.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229041
    m_Localized: 'SuperFake: Oh, lo so bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229042
    m_Localized: 'SuperFake: Cosa può fare una singola persona di fronte a una catastrofe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229043
    m_Localized: 'SuperFake: A una Calamità cosmica?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229044
    m_Localized: 'SuperFake: Alla morte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229045
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229046
    m_Localized: 'SuperFake: Ma seeenti...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229047
    m_Localized: 'SuperFake: Sei da solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229048
    m_Localized: Sì, sono da solo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229049
    m_Localized: No, non sono da solo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229050
    m_Localized: 'SuperFake: E cosa faresti, esattamente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229051
    m_Localized: 'SuperFake: Puoi scongiurare la morte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423296
    m_Localized: 'SuperFake: Fermare le inondazioni, gli incendi, il degrado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423297
    m_Localized: 'SuperFake: L''unica cosa che puoi fermare è il battito cardiaco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423298
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423299
    m_Localized: 'SuperFake: Ma seeenti...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423300
    m_Localized: 'SuperFake: Sei da solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423301
    m_Localized: Sì, sono da solo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423302
    m_Localized: No, non sono da solo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423303
    m_Localized: 'SuperFake: Quindi, alla fine, ti sei ritrovato tutto solo soletto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423304
    m_Localized: 'SuperFake: Non ti è andata bene con nessuno, eh? Che peccato...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423305
    m_Localized: 'SuperFake: Vorrà dire che ti farò una visitina veloooce, giusto il tempo di darti un piccolo regalo d''addio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423306
    m_Localized: 'SuperFake: Ancora che lottate per sopravvivere in questo nuovo mondo, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423307
    m_Localized: 'SuperFake: Perché?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423308
    m_Localized: 'SuperFake: Sono i cani a governare il mondo, ora. E solo i cani sopravvivono qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423309
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423310
    m_Localized: 'SuperFake: Capisci cosa intendo, vero? Nulla tornerà più come prima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423311
    m_Localized: 'SuperFake: La vita è cambiata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423312
    m_Localized: 'SuperFake: Stai perdendo il ritmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423313
    m_Localized: 'SuperFake: La prossima volta che ci incontreremo, le cose potrebbero farsi... interessanti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423314
    m_Localized: 'SuperFake: Lo seeenti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423315
    m_Localized: 'SuperFake: Il cambiamento ti perseguita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423316
    m_Localized: 'SuperFake: Proprio come me...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423317
    m_Localized: 'SuperFake: E ora qualcuno della tua specie è immortale.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423318
    m_Localized: 'SuperFake: Tutto a causa di una parola, una singola parola... Ma che parola!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423319
    m_Localized: 'SuperFake: Hai presente a chi mi riferisco, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423320
    m_Localized: 'SuperFake: Che strane cose accadono intorno a te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423321
    m_Localized: Non sento nulla.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423322
    m_Localized: Non mi importa.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423323
    m_Localized: 'SuperFake: Dev''essere dura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423324
    m_Localized: 'SuperFake: Sembra proprio che tu abbia bisogno d''aiuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423325
    m_Localized: 'SuperFake: Perché non proviamo qualcosa di nuovo? Una specie di scommessa, se così vogliamo definirla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423326
    m_Localized: 'SuperFake: Se ci sono almeno DUE di noi in casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423327
    m_Localized: 'SuperFake: Mi aprirai la porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423328
    m_Localized: 'SuperFake: Perché ora i cani risiedono nei loro corpi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423329
    m_Localized: Non capisco.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423330
    m_Localized: Potresti tornare più tardi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423331
    m_Localized: 'SuperFake: Ti senti così distaccato...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423332
    m_Localized: 'SuperFake: Che non ti importa più di nulla?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423333
    m_Localized: 'SuperFake: Risolviamo il problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423334
    m_Localized: 'SuperFake: Se ci sono almeno DUE di noi in casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423335
    m_Localized: 'SuperFake: Mi aprirai la porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423336
    m_Localized: Non capisco.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423337
    m_Localized: Potresti tornare più tardi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423338
    m_Localized: 'SuperFake: È facile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423339
    m_Localized: 'SuperFake: Proviamo, ti va?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423340
    m_Localized: 'SuperFake: Ma prima...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423341
    m_Localized: 'SuperFake: Sei da solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423342
    m_Localized: Sì, sono da solo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423343
    m_Localized: No, non sono da solo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423344
    m_Localized: 'SuperFake: Che peccato... Me ne vado, per ora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423345
    m_Localized: 'SuperFake: Ma prima, proviamo quella scommessa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423346
    m_Localized: 'SuperFake: Sei da solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423347
    m_Localized: Sì, sono da solo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423348
    m_Localized: No, non sono da solo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423349
    m_Localized: 'SuperFake: Uhm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423350
    m_Localized: 'SuperFake: Sì... La nostra scommessa sta dando i frutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423351
    m_Localized: 'SuperFake: Vieni con me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423352
    m_Localized: 'SuperFake: Bene, bene...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423353
    m_Localized: 'SuperFake: Anche noi siamo una vista rara, ormai. Per non parlare della tua specie, rinchiusa tra quattro mura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423354
    m_Localized: 'SuperFake: Il cambiamento non è la cosa peggiore che ti possa capitare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423355
    m_Localized: 'SuperFake: Non crederai mica che sia a capo del branco, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423356
    m_Localized: 'SuperFake: Ci sono cose molto più grandi là fuori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423357
    m_Localized: 'SuperFake: Io eseguo semplicemente gli ordini.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423358
    m_Localized: 'SuperFake: Molto bene...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423359
    m_Localized: 'SuperFake: Alla prossima, allora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423360
    m_Localized: 'SuperFake: Mi hanno detto che questa sarebbe stata la nostra ultima chiacchierata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423361
    m_Localized: 'SuperFake: Tutto sta volgendo al termine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423362
    m_Localized: 'SuperFake: Per mano nostra o per la vostra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423363
    m_Localized: Che vuoi dire?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423364
    m_Localized: Cosa sta volgendo al termine?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423365
    m_Localized: 'SuperFake: Ti sto solo riferendo ciò che mi è stato detto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423366
    m_Localized: 'SuperFake: Tutto qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423367
    m_Localized: 'SuperFake: Riesci a sentirla? La morte che si avvicina sempre di più?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423368
    m_Localized: 'SuperFake: Ti sta già col fiato sul collo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423369
    m_Localized: Perché continui a venire qui?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423370
    m_Localized: Perché non sfondare semplicemente la porta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423371
    m_Localized: 'SuperFake: Non posso dirlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423372
    m_Localized: 'SuperFake: È buffo come tu non ti renda conto di nulla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423373
    m_Localized: 'SuperFake: Non preoccuparti, possiamo aiutarti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423374
    m_Localized: Perché continui a venire qui?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423375
    m_Localized: Perché non sfondare semplicemente la porta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423376
    m_Localized: 'SuperFake: Te lo chiedi solo adesso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423377
    m_Localized: 'SuperFake: Hai mai considerato la possibilità... di essere stato scelto? Ah ah ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423378
    m_Localized: 'SuperFake: Mi hanno mandato per una ragione...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423379
    m_Localized: 'SuperFake: Per cambiare qualcosa, magari?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423380
    m_Localized: 'SuperFake: Ma l''esito sarà sempre lo stesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423381
    m_Localized: 'SuperFake: Tu morirai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423382
    m_Localized: 'SuperFake: Se non oggi, domani. Se non domani, più avanti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423383
    m_Localized: 'SuperFake: Sparirai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423384
    m_Localized: 'SuperFake: Ma per ora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423385
    m_Localized: 'SuperFake: Hai lasciato entrare qualcuno di noi in casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423386
    m_Localized: 'SuperFake: Sei da solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423387
    m_Localized: Ci sono parecchie persone qui dentro.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423388
    m_Localized: Non ho lasciato entrare nessuno.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423389
    m_Localized: Ci sono parecchie... non‑persone qui dentro.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423390
    m_Localized: Lascio entrare solo quelli giusti.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423391
    m_Localized: Mi sono liberato di chiunque non fosse uno di noi.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423392
    m_Localized: Mi sono liberato di qualcuno diverso da noi.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423393
    m_Localized: 'SuperFake: L''ignoto ti spaventa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423394
    m_Localized: 'SuperFake: Ti chiedi spesso perché sei ancora vivo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423395
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423396
    m_Localized: 'SuperFake: Sembra che tu sia più preoccupato per ciò che verrà dopo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423397
    m_Localized: 'SuperFake: Quindi, morirai. E poi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423398
    m_Localized: 'SuperFake: Scomparirai... e basta? Per sempre?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423399
    m_Localized: 'SuperFake: Proverai qualcosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423400
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423401
    m_Localized: 'SuperFake: Ma a me interessa di più un altro aspetto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423402
    m_Localized: 'SuperFake: Hai lasciato entrare qualcuno di noi in casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423403
    m_Localized: Ci sono parecchie persone qui dentro.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423404
    m_Localized: Non ho lasciato entrare nessuno.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423405
    m_Localized: Ci sono parecchie... non‑persone qui dentro.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423406
    m_Localized: Lascio entrare solo quelli giusti.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423407
    m_Localized: Mi sono liberato di chiunque non fosse uno di noi.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423408
    m_Localized: Mi sono liberato di qualcuno diverso da noi.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423409
    m_Localized: 'SuperFake: Quindi, sei pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423410
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423411
    m_Localized: 'SuperFake: Hai paura?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423412
    m_Localized: 'SuperFake: Sì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423413
    m_Localized: 'SuperFake: Non riesci ancora a prendere in mano la situazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423414
    m_Localized: 'SuperFake: Ecco perché sono qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423415
    m_Localized: 'SuperFake: Scappare, non fai altro che scappare. Da quelli come me, dalla verità.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423416
    m_Localized: 'SuperFake: Perché?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423417
    m_Localized: 'SuperFake: A cosa ti stai aggrappando così disperatamente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423418
    m_Localized: 'SuperFake: Presto sarà tutto FINITO.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423419
    m_Localized: 'SuperFake: Quindi, perché resistere?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423420
    m_Localized: 'Wolfhound: Ehi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423421
    m_Localized: 'Wolfhound: Il mondo sta andando in pezzi, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423422
    m_Localized: 'Wolfhound: Non esiste più alcuna società. Le bestie sono uscite a giocare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423423
    m_Localized: 'Wolfhound: Finalmente... non c''è più bisogno di trattenersi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423424
    m_Localized: Di che parli?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423425
    m_Localized: E tu saresti una di queste "bestie"?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423426
    m_Localized: 'Wolfhound: Sei stato in qualcuna di queste altre case? Hai camminato per le strade?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423427
    m_Localized: 'Wolfhound: Tutte le vostre regole e la vostra morale sono andate in fumo, dolcezza. Non significano più niente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423428
    m_Localized: 'Wolfhound: Ora è tutto più semplice. Sgozza i bastardi e il gioco è fatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423429
    m_Localized: In quante altre case sei stato?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423430
    m_Localized: Come hai fatto a sopravvivere così a lungo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423431
    m_Localized: 'Wolfhound: Siamo tutti animali, amico mio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423432
    m_Localized: 'Wolfhound: Continua a negarlo e ti divoreranno vivo. Non lasceranno nemmeno le ossa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423433
    m_Localized: 'Wolfhound: Questo è il nuovo ordine mondiale. È la forza che comanda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423434
    m_Localized: 'Wolfhound: Chiunque dica il contrario sarà morto entro il mattino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423435
    m_Localized: In quante altre case sei stato?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423436
    m_Localized: Come hai fatto a sopravvivere così a lungo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423437
    m_Localized: 'Wolfhound: Non mi sono mai trattenuto a lungo in nessuna di esse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423438
    m_Localized: 'Wolfhound: Ovunque è la stessa storia: la paura impedisce alle persone di vedere il quadro generale.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423439
    m_Localized: 'Wolfhound: Mentre tu? Tu hai ancora tutto in ordine qui. È una cosa rara, dolcezza. Sono curioso di scoprire come fai a mantenerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423440
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423441
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423442
    m_Localized: 'Wolfhound: Ah, ma guarda che gran faccia tosta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423443
    m_Localized: 'Wolfhound: Occhio non vede, cuore non duole. Io non ti ho mica chiesto come hai fatto a sopravvivere finora, dico bene?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423444
    m_Localized: 'Wolfhound: Il punto è che non sono qui per creare problemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423445
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423446
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423447
    m_Localized: 'Wolfhound: Bravo ragazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423448
    m_Localized: 'Wolfhound: Ora conta solo il potere, dolcezza. Puoi adeguarti o lasciarti travolgere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423449
    m_Localized: 'Wolfhound: Ahhh... È così, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423450
    m_Localized: 'Wolfhound: Ci rivedremo di nuovo, dolcezza. Contaci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423451
    m_Localized: 'Doctor: Oh, credevo non ci fosse nessuno in casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423452
    m_Localized: 'Doctor: Di notte è così tranquillo qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423453
    m_Localized: 'Doctor: Buonasera! Posso entrare?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423454
    m_Localized: Stavi sorvegliando la casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617600
    m_Localized: Stai cercando qualcosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617601
    m_Localized: 'Doctor: Cosa? Ma no, non essere sciocco!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617602
    m_Localized: 'Doctor: Trovo semplicemente inusuale che una casa piena di gente rimanga così silenziosa di notte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617603
    m_Localized: 'Doctor: In genere si sentono gli strepiti degli ubriachi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617604
    m_Localized: 'Doctor: O i pianti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617605
    m_Localized: 'Doctor: O le urla...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617606
    m_Localized: Chi sei?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617607
    m_Localized: Da dove vieni?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617608
    m_Localized: 'Doctor: Perché me lo chiedi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617609
    m_Localized: 'Doctor: Beh, sto semplicemente cercando quello che cercano tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617610
    m_Localized: 'Doctor: Sicurezza. E forse, se sarò fortunato, qualche conversazione per combattere la noia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617611
    m_Localized: 'Doctor: E dato che questo posto era così tranquillo, pensavo non ci vivesse nessuno. Così mi sono detto: "Diamo un''occhiata".'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617612
    m_Localized: 'Doctor: Ma la porta era chiusa e ho deciso che sarebbe stato più educato bussare prima di sfondarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617613
    m_Localized: Chi sei?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617614
    m_Localized: Da dove vieni?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617616
    m_Localized: 'Doctor: Sono un chirurgo. Un tempo operavo i malati.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617617
    m_Localized: 'Doctor: Il nostro reparto non aveva fondi, quindi mi ritrovavo spesso a occuparmi di pazienti con patologie fuori dalla mia specializzazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617618
    m_Localized: 'Doctor: E ora... gli ospedali non esistono più. Quindi vago senza meta e aiuto dove posso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617619
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617620
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668864
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668865
    m_Localized: 'Doctor: Se mi lasci entrare, posso spiegarti cos''è successo agli ospedali.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617621
    m_Localized: 'Doctor: C''era un ospedale in centro, ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617622
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617623
    m_Localized: 'Doctor: Beh, è una lunga storia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617624
    m_Localized: 'Doctor: Se sarai così gentile da farmi entrare, te la racconterò.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617625
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617626
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617627
    m_Localized: 'Doctor: Grazie, spero che potrò essere d''aiuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617628
    m_Localized: 'Doctor: Capisco, non è facile fidarsi in questo momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617629
    m_Localized: 'Doctor: Sarò nei paraggi, quindi non esitare a chiedere aiuto in caso di bisogno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617630
    m_Localized: 'Foreigner: Mmmf...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617631
    m_Localized: 'Foreigner: Mmmmmmmmmf?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617632
    m_Localized: Va tutto bene?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617633
    m_Localized: Cosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617634
    m_Localized: 'Foreigner: (L''uomo ti guarda, inarcando le sopracciglia)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617635
    m_Localized: 'Foreigner: (Sembra impossibilitato a rispondere)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617636
    m_Localized: Qualcuno ti ha cucito la bocca?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617637
    m_Localized: Cosa posso fare per te?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617638
    m_Localized: 'Foreigner: (Inarca il sopracciglio con sguardo angosciato)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617639
    m_Localized: 'Foreigner: (Mugugna di nuovo, ma non capisci nulla di quello che cerca di dire)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617640
    m_Localized: Qualcuno ti ha cucito la bocca?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617641
    m_Localized: Cosa posso fare per te?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617642
    m_Localized: 'Foreigner: (Mugugna qualcosa, agitando le braccia)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617643
    m_Localized: 'Foreigner: (Non ne sei sicuro, ma le sue guance sembrano bagnate di lacrime)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617644
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617645
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617646
    m_Localized: 'Foreigner: (Se ne sta lì impalato, a fissarti attraverso lo spioncino)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617647
    m_Localized: 'Foreigner: (Non ne sei sicuro, ma le sue guance sembrano bagnate di lacrime)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617648
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617649
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617650
    m_Localized: 'Foreigner: (Annuisce ed entra)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617651
    m_Localized: 'Foreigner: (Rimane immobile a mugugnare)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617652
    m_Localized: Vattene!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617653
    m_Localized: 'Foreigner: (Il tuo grido lo spaventa)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617654
    m_Localized: 'Foreigner: (Rimane fermo un attimo, poi si volta e se ne va)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617655
    m_Localized: 'Edgar: Ciao, complimenti per la bella casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617656
    m_Localized: 'Edgar: Qui fuori è molto più tranquillo. In città, è tutto così frenetico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617657
    m_Localized: 'Edgar: Speravo di poterti chiedere un favore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617658
    m_Localized: Perché non sei rimasto a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617659
    m_Localized: Cosa c'è di così bello qui?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617660
    m_Localized: 'Edgar: Non mi sento affatto bene, e non mi riferisco solo alla cancrena al braccio, purtroppo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617661
    m_Localized: 'Edgar: Ogni mattina mi sveglio e mi chiedo se vivrò abbastanza per vedere il giorno dopo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617662
    m_Localized: 'Edgar: Una storia come la mia è meglio mandarla giù tutta d''un fiato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617663
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617664
    m_Localized: 'Edgar: Il baccano della città mi si appiccica addosso come sudore. La frenesia, la confusione...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617665
    m_Localized: 'Edgar: La gente si aggrappa disperatamente a ogni possibilità di sopravvivenza, ma qui fuori... sembra di aver fatto pace con ciò che sta arrivando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617666
    m_Localized: 'Edgar: Vorrei morire qui. Lentamente, in silenzio, assaporando gli ultimi istanti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617667
    m_Localized: Come ha fatto ad andarti in cancrena il braccio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617668
    m_Localized: Dovremmo tagliarti il braccio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617669
    m_Localized: 'Edgar: Il silenzio, il vuoto... È così tranquillo qui fuori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617670
    m_Localized: 'Edgar: Rabbrividisco, anche se sono intrappolato nel calore frenetico della città.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617671
    m_Localized: 'Edgar: Una trappola febbrile. Le strade non si rinfrescano più con il calare della notte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617672
    m_Localized: 'Edgar: In ogni caso, mi ritroverei comunque a tremare, ahimè. È la cancrena al braccio, purtroppo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617673
    m_Localized: 'Edgar: Ogni mattina mi sveglio e mi chiedo se vivrò abbastanza per vedere il giorno dopo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617674
    m_Localized: 'Edgar: Una storia come la mia è meglio mandarla giù tutta d''un fiato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617675
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617676
    m_Localized: 'Edgar: Il panico non fa per me. Dove la vita lotta controcorrente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617677
    m_Localized: Come ha fatto ad andarti in cancrena il braccio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617678
    m_Localized: Dovremmo tagliarti il braccio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617679
    m_Localized: 'Edgar: Una domanda legittima. Per ora, posso solo dirti questo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617680
    m_Localized: 'Edgar: Un tempo vivevo con una ragazza che adoravo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617681
    m_Localized: 'Edgar: Lei cambiava... ogni giorno, a poco a poco. Ed era bellissimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617682
    m_Localized: 'Edgar: Finché non sono arrivati gli altri e, beh... suppongo che tu possa immaginare il resto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617683
    m_Localized: 'Edgar: E ora sono qui, di fronte a te. Da solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617684
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617685
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617686
    m_Localized: 'Edgar: Pensi che basterebbe questo per risolvere il problema?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617687
    m_Localized: 'Edgar: No, non mi serve tanta accortezza. In qualche modo... sento che in questo posto sarà più facile accettare l''inevitabile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617688
    m_Localized: 'Edgar: Per questo sono venuto qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617689
    m_Localized: 'Edgar: È da qui che entrerò e mi fonderò con quel luogo finale e inconoscibile, per andarmene con delicatezza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617690
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617691
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617692
    m_Localized: 'Edgar: Questo è il posto più tranquillo in cui sia mai stato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617693
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617694
    m_Localized: 'Edgar: Non so ancora se vedi la bellezza come la vedo io, ma dimmi... I corpi, li getterai via durante la grande notte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617695
    m_Localized: 'Edgar: Tieni il mio, quando arriverà la mia ora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617696
    m_Localized: 'Edgar: Ti dispiace se rimango nei paraggi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617697
    m_Localized: 'Edgar: Attenderò che la morte mi accolga nel suo morbido abbraccio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617698
    m_Localized: 'Edgar: Troverò un po'' d''ombra sotto cui rifugiarmi, ma ti prego... Non gettare via il mio corpo, quando arriverà la mia ora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617699
    m_Localized: 'TaxiDriver: Ehi, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617700
    m_Localized: 'TaxiDriver: Senti, sono nella merda fino al collo. Ti dispiace se... mi rifugio qui per un po''?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617701
    m_Localized: Cos'è successo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617702
    m_Localized: Di cosa hai bisogno?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617703
    m_Localized: 'TaxiDriver: Da dove comincio? Sì, giusto: sono un tassista.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617704
    m_Localized: 'TaxiDriver: E stavo portando un passeggero, quando...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617705
    m_Localized: 'TaxiDriver: Beh, sai come vanno certe cose... È venuto fuori che non era chi diceva di essere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617706
    m_Localized: 'TaxiDriver: E ora, non è qui. E neppure la mia auto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617707
    m_Localized: Cos'è successo alla tua auto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617708
    m_Localized: Cos'è successo al passeggero?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617709
    m_Localized: 'TaxiDriver: Beh, inutile girarci intorno: ho perso il taxi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617710
    m_Localized: 'TaxiDriver: Per colpa della mia stupidità.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617711
    m_Localized: 'TaxiDriver: Non che io sia stupido, eh. È solo che trasportavo un passeggero, e... mi sono fidato della persona sbagliata, mi spiego?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617712
    m_Localized: Cosa è successo alla tua auto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617713
    m_Localized: Cosa è successo al passeggero?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617714
    m_Localized: 'TaxiDriver: Quei maledetti idioti della FEMA me l''hanno sequestrata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617715
    m_Localized: 'TaxiDriver: Mentre trasportavo quel passeggero, a un certo punto ho notato che i suoi denti erano bianchi, troppo bianchi... Mi segui?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617716
    m_Localized: 'TaxiDriver: Così, l''ho condotto di nascosto alla FEMA e sembrava non avessero alcuna intenzione di lasciarlo andare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617717
    m_Localized: 'TaxiDriver: All''inizio mi hanno lodato, dicendo cose tipo: "Ottimo lavoro, cittadino. Aiutaci ad aiutarti!" e bla bla bla... Ma poi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617718
    m_Localized: 'TaxiDriver: Quei cretini mi hanno trascinato via dall''auto per arrestarmi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617719
    m_Localized: 'TaxiDriver: Così ho colpito uno di loro con una bottiglia che tenevo nel giacchetto e sono scappato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617720
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617721
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617722
    m_Localized: 'TaxiDriver: Non sono un tipo paranoico o altro, ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617723
    m_Localized: 'TaxiDriver: Era un Visitatore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617724
    m_Localized: 'TaxiDriver: Ho dato un''occhiata allo specchietto retrovisore e ho visto che aveva quei denti bianchissimi, hai presente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617725
    m_Localized: 'TaxiDriver: L''ho condotto subito alla FEMA senza pensarci due volte, ma... si è rivelato un grooosso errore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617726
    m_Localized: 'TaxiDriver: Volevano trascinare dentro anche me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617727
    m_Localized: 'TaxiDriver: Così, sono scappato. E ora non posso neanche tornare a casa, capisci? Scommetto che quei bastardi mi stanno già aspettando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617728
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617729
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617730
    m_Localized: 'TaxiDriver: Uff... Grazie, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617731
    m_Localized: 'TaxiDriver: Mi raccomando, non fidarti mai di quegli stronzi in giallo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617732
    m_Localized: 'TaxiDriver: Basta un attimo di distrazione per finire fregato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617733
    m_Localized: 'TaxiDriver: Dai, amico... Non farmi questo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617734
    m_Localized: 'TaxiDriver: Sì, mi sono fatto prendere dal panico, è vero, ma... non è un buon motivo per mettermi alla porta!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617735
    m_Localized: 'TaxiDriver: Dannazione...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617736
    m_Localized: 'TaxiDriver: Sei peggio di quei bastardi della FEMA. Ti auguro di marcire all''inferno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617737
    m_Localized: 'Provocateur: Buongiorno, gentile padrone di casa. Affitti delle stanze, per caso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617738
    m_Localized: Più o meno.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617739
    m_Localized: Lascio solo entrare della gente.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617740
    m_Localized: 'Provocateur: Uhm... Una risposta piuttosto vaga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617741
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617742
    m_Localized: 'Provocateur: Beh, suppongo che potremo sempre finalizzare l''accordo in un secondo momento. Con la data retroattiva corretta, ovviamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617743
    m_Localized: 'Provocateur: Ma in previsione di un contratto formale... Quanto chiedi per una notte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617744
    m_Localized: Paga quello che vuoi, se ritieni di doverlo fare.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617745
    m_Localized: Non mi servono i tuoi soldi.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617746
    m_Localized: 'Provocateur: Chiedo scusa? Hai detto che "lasci entrare della gente"? Sei una specie di volontario? Gestisci un rifugio per senzatetto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617747
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617748
    m_Localized: 'Provocateur: Mi dispiace, ma mi rifiuto di occupare dello spazio prezioso senza pagare la mia giusta quota.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617749
    m_Localized: Paga quello che vuoi, se ritieni di doverlo fare.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617750
    m_Localized: Non mi servono i tuoi soldi.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617751
    m_Localized: 'Provocateur: Chiedo scusa? Credi di farmi un favore?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617752
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617753
    m_Localized: 'Provocateur: Incredibile... Pensare che un membro di una rispettabile agenzia immobiliare possa snobbare dei soldi facili...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617754
    m_Localized: 'Provocateur: D''accordo, ne riparleremo davanti a un contratto legale in piena regola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617755
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617756
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617757
    m_Localized: 'Provocateur: Mi dispiace, ma non posso, in tutta coscienza, vivere sotto il tuo tetto senza pagare il dovuto affitto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617758
    m_Localized: 'Provocateur: È scorretto e, peggio ancora, è illegale...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617759
    m_Localized: 'Provocateur: O pago la mia parte, oppure non metto piede in casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617760
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617761
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617762
    m_Localized: 'Provocateur: Grazie, padrone di casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617763
    m_Localized: 'Provocateur: Discuteremo dei termini del contratto di locazione più tardi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617764
    m_Localized: 'Provocateur: Chiedo scusa? Hai appena detto che dovrei andarmene? È una minaccia, per caso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617765
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617766
    m_Localized: 'Provocateur: Forse dovresti riconsiderare il tuo tono, perché potrei interpretarla come una minaccia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617767
    m_Localized: 'Provocateur: Che, per inciso, violerebbe l''articolo 119 della Costituzione. E credimi, non ci faresti una bella figura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617768
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617769
    m_Localized: 'Provocateur: Ti auguro una buona continuazione...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617770
    m_Localized: 'Marauder: Oh, merda... Ma allora ci vive qualcuno qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617771
    m_Localized: 'Marauder: Chiedo scusa, pensavo che la casa fosse vuota. Me ne vado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617772
    m_Localized: 'Marauder: Anche se...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617773
    m_Localized: 'Marauder: Ascolta, ehm... Ti dispiacerebbe se resto qui per un po''? È parecchio che non frequento, sai... gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617774
    m_Localized: Perché sei da solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617775
    m_Localized: Pensi sia una buona idea?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617776
    m_Localized: 'Marauder: E chi vorrebbe mai stare con uno come me? La gente mi considera feccia della società.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617777
    m_Localized: 'Marauder: Come se fossi peggiore di loro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617778
    m_Localized: 'Marauder: Invece, non lo sono affatto. Ho visto di cosa sono capaci le persone...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617779
    m_Localized: 'Marauder: Tsk... Non sono mai riuscito a integrarmi e, quindi, eccomi qui: da solo a marcire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617780
    m_Localized: Come hai fatto a sopravvivere tutto da solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617781
    m_Localized: Rubi alla gente per sopravvivere?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617782
    m_Localized: 'Marauder: E perché non dovrebbe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617783
    m_Localized: 'Marauder: Sono solo da quando quei Visitatori sono strisciati fuori da chissà dove...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617784
    m_Localized: 'Marauder: All''inizio, pensavo che fosse l''opzione più sicura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617785
    m_Localized: 'Marauder: Ma vuoi sapere la verità, amico? Ne ho abbastanza. Sono stanco di parlare con le ombre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617786
    m_Localized: 'Marauder: Questa situazione inizia a pesarmi. Sento che sto per impazzire...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617787
    m_Localized: Come hai fatto a sopravvivere tutto da solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617788
    m_Localized: Rubi alla gente per sopravvivere?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617789
    m_Localized: 'Marauder: Beh, inutile mentire: rubo nelle case abbandonate, negli appartamenti vuoti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617790
    m_Localized: 'Marauder: Prendo quello che posso. Vendo qualcosa, il resto lo tengo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617791
    m_Localized: 'Marauder: C''è stato un momento in cui stavo quasi per smettere di farlo... Quasi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617792
    m_Localized: 'Marauder: Ma sì, insomma... Stavo per introdurmi in casa tua, pensavo fosse vuota.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617793
    m_Localized: 'Marauder: Senza offesa, ma visto che ci vivi ancora... pensi che potrei restare per un po''?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617794
    m_Localized: 'Marauder: Ho un sacco di storie da raccontarti. Ne ho viste di cose qua fuori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617795
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617796
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617797
    m_Localized: 'Marauder: Ma per chi mi hai preso? Per una specie di delinquente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617798
    m_Localized: 'Marauder: Senti, non sarò un santo, ma ci sono dei limiti che non intendo superare. Non alzo le mani sui miei simili.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617799
    m_Localized: 'Marauder: Beh, c''è stata una volta in cui non ho avuto scelta, ma... è una storia lunga. Te la racconterò più tardi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617800
    m_Localized: 'Marauder: Comunque, visto che vivi qui... non è che potresti ospitarmi per la notte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617801
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617802
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617803
    m_Localized: 'Marauder: Evviva! Per una buona volta, dormirò in una casa normale come una persona normale.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617804
    m_Localized: 'Marauder: Mi farebbe piacere fare due chiacchiere, se ti va. Ho una miriade di storie da raccontare. Vedrai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617805
    m_Localized: 'Marauder: E non ce n''è neanche una noiosa, te lo assicuro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617806
    m_Localized: 'Marauder: D''accordo, non c''è problema.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617807
    m_Localized: 'Marauder: Senti... Per caso sai se c''è una casa vuota qui nei paraggi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617808
    m_Localized: 'Marauder: Non mi trattengo molto, sono solo di passaggio. Promesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617809
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617810
    m_Localized: 'Marauder: Ehm, te ne sei già andato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617811
    m_Localized: 'Marauder: E va bene. Me ne vado anch''io, allora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617812
    m_Localized: 'GraveDigger: Salveee? C''è qualcuno lì dentro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617813
    m_Localized: 'GraveDigger: Ti dispiacerebbe farmi entrare?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617814
    m_Localized: Non c'è bisogno di prendere a pugni la porta.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617815
    m_Localized: Perché non ti prendi a pugni da solo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617816
    m_Localized: 'GraveDigger: Ehi, senza rancore. Non volevo mica svegliarti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617817
    m_Localized: 'GraveDigger: Neanch''io ho chiuso occhio, ultimamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617818
    m_Localized: 'GraveDigger: Facevo il becchino, sai? Non che ora abbia più molto senso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617819
    m_Localized: 'GraveDigger: Le tombe non servono più a nulla. La gente stramazza a terra e marcisce lì, dove si trova.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617820
    m_Localized: Hai visto qualcosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617821
    m_Localized: Ti sei licenziato?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617822
    m_Localized: 'GraveDigger: Scusa, non era mia intenzione picchiare alla porta, è solo che...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617823
    m_Localized: 'GraveDigger: Non crederesti mai a quello che ho visto mentre scavavo l''ultima buca...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617824
    m_Localized: 'GraveDigger: Ultimamente, la gente stramazza a terra come mosche, ma non c''è nessuno che li seppellisca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617825
    m_Localized: 'GraveDigger: Li lasciano semplicemente lì, dove cadono. Sarà il sole a cremarli tutti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811904
    m_Localized: Hai visto qualcosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811905
    m_Localized: Ti sei licenziato?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811906
    m_Localized: 'GraveDigger: Sì, cazzo se ho visto qualcosa. Stavo scavando una fossa, una che mi era stata commissionata...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811907
    m_Localized: 'GraveDigger: Il cliente era lì, con me, a guardarmi lavorare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811908
    m_Localized: 'GraveDigger: Stavo scavando e scavando, e poi... BAM! La pala ha colpito qualcosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811909
    m_Localized: 'GraveDigger: Pensavo fosse una roccia, ma no: è spuntata una mano dal terreno!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811910
    m_Localized: 'GraveDigger: Era un Visitatore che strisciava fuori dal sottosuolo! E quel tizio che era con me? Si è semplicemente messo a ridere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811911
    m_Localized: 'GraveDigger: Sono scappato a gambe levate. Non ho osato tornare a casa. Ho pensato fosse più sicuro stare in mezzo alla folla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811912
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811913
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811914
    m_Localized: 'GraveDigger: Quel lavoro non ha più senso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811915
    m_Localized: 'GraveDigger: Nessuno porta più cadaveri da seppellire. La gente ha smesso di dare un addio dignitoso ai propri cari.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811916
    m_Localized: 'GraveDigger: Ci penserà comunque il sole a cremare i corpi. E le notti... sono troppo brevi per occuparsi delle salme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811917
    m_Localized: 'GraveDigger: Se solo i guai ci nutrissero come noi nutriamo loro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811918
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811919
    m_Localized: 'GraveDigger: Comunque, sì, mi sono licenziato. Al diavolo tutto. Ho chiuso con quel lavoro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811920
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811921
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811922
    m_Localized: 'GraveDigger: G‑Grazie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811923
    m_Localized: 'GraveDigger: Sbrigati ad aprire la porta, però. Ho paura di ritrovarmi un Visitatore alle spalle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811924
    m_Localized: 'GraveDigger: Ma pensa te...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811925
    m_Localized: 'GraveDigger: Ti spezzi la schiena a scavare tutto il giorno, ogni giorno, per tutta la tua dannata vita... e per cosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811926
    m_Localized: 'GraveDigger: Vai a casa ed è vuota.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811927
    m_Localized: 'GraveDigger: Poi arrivano i Visitatori a bussare, o peggio... sono già dentro che ti stanno aspettando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811928
    m_Localized: 'GraveDigger: Ne ho sentito di storie... Di gente che torna a casa e BOOM! Il gioco è fatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811929
    m_Localized: 'GraveDigger: Scaverò la buca più profonda che c''è e non ne uscirò mai più.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811930
    m_Localized: 'FormerFema: Ehilà? C''è qualcuno?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811931
    m_Localized: 'FormerFema: Ho sentito dei passi... Sei dietro la porta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811932
    m_Localized: 'FormerFema: Puoi... aprire, per favore?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811933
    m_Localized: Prima riportate chi avete preso.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811934
    m_Localized: Siete venuti a prelevare me, questa volta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811935
    m_Localized: 'FormerFema: Prelevare?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811936
    m_Localized: 'FormerFema: Oh... Devi avermi scambiato per un agente della FEMA. È per via della tuta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811937
    m_Localized: 'FormerFema: No, l''ho appena tolta a un cadavere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811938
    m_Localized: 'FormerFema: Ho pensato che mi avrebbe fatto comodo qui fuori. Ci sarà un motivo se le indossano, non credi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811939
    m_Localized: 'FormerFema: Forse il sole rilascia radiazioni anche di notte? Non voglio nemmeno saperlo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811940
    m_Localized: Chi sei, allora?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811941
    m_Localized: Quindi, qual è il tuo piano?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811942
    m_Localized: 'FormerFema: Eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811943
    m_Localized: 'FormerFema: Temo di non capire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811944
    m_Localized: 'FormerFema: Ah! No, non sono della FEMA. È per via dell''uniforme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811945
    m_Localized: 'FormerFema: Li odiano tutti, da quanto mi è sembrato di capire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811946
    m_Localized: 'FormerFema: Per... qualunque cosa stiano facendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811947
    m_Localized: 'FormerFema: La gente viene portata via e... non torna più.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811948
    m_Localized: 'FormerFema: Chissà cosa sta davvero succedendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811949
    m_Localized: Chi sei, allora?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811950
    m_Localized: Quindi, qual è il tuo piano?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811951
    m_Localized: 'FormerFema: Solo un normale operaio di fabbrica.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811952
    m_Localized: 'FormerFema: Costruivo frigoriferi. Li riparavo, anche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811953
    m_Localized: 'FormerFema: Ma ora non lo faccio più.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811954
    m_Localized: 'FormerFema: Il lavoro continuava ad accumularsi. Non c''era abbastanza personale, non riuscivamo a stare al passo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811955
    m_Localized: 'FormerFema: Ho avuto un esaurimento e, alla fine, mi sono licenziato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811956
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811957
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811958
    m_Localized: 'FormerFema: Ottima domanda. In questo momento, mi sento solo... perso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811959
    m_Localized: 'FormerFema: Avevo un lavoro, pensavo che tutto sarebbe andato per il meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811960
    m_Localized: 'FormerFema: Poi, è arrivata la delusione...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811961
    m_Localized: 'FormerFema: Alla fine, non ho fatto nulla di ciò che mi avevano promesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811962
    m_Localized: 'FormerFema: Parlo di programmazione, ovviamente. Dello scrivere codice.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811963
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811964
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811965
    m_Localized: 'FormerFema: Eh? Oh, grazie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811966
    m_Localized: 'FormerFema: C''è un posto dove posso sedermi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811967
    m_Localized: 'FormerFema: Non credevo che mi avresti lasciato entrare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811968
    m_Localized: 'FormerFema: Eh? Oh, grazie tante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811969
    m_Localized: 'FormerFema: No, aspetta, mi è uscita male. D''accordo, ho capito...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811970
    m_Localized: 'FormerFema: Suppongo che la tuta metta in soggezione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811971
    m_Localized: 'FormerFema: Non so nemmeno perché la indosso ancora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811972
    m_Localized: 'FormerFema: Addio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811973
    m_Localized: 'Intruder: Ti capita mai di sognare?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811974
    m_Localized: Cosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811975
    m_Localized: Non proprio, a dire il vero.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811976
    m_Localized: 'Intruder: Sì, sognare. Hai presente cos''è un sogno, vero? Quelle cose che vedi quando dormi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811977
    m_Localized: 'Intruder: Sai cosa ho capito?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811978
    m_Localized: 'Intruder: Che la gente non sogna quasi più.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811979
    m_Localized: 'Intruder: Quale sarà il motivo, secondo te?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811980
    m_Localized: Perché ti interessa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811981
    m_Localized: E tu, sogni?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811982
    m_Localized: 'Intruder: Ecco, appunto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811983
    m_Localized: 'Intruder: Sei come tutti gli altri. Persino quando hanno la febbre, non sognano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811984
    m_Localized: 'Intruder: Mi chiedo... sarà colpa del sole? O di qualcos''altro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811985
    m_Localized: Perché ti interessa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811986
    m_Localized: E tu, sogni?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811987
    m_Localized: 'Intruder: I sogni sono... delle cose strane e delicate.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811988
    m_Localized: 'Intruder: Sono il luogo in cui cerchiamo risposte, troviamo conforto... o, semplicemente, speriamo di trovare un attimo di calma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811989
    m_Localized: 'Intruder: Ma ora? Si stanno sgretolando, stanno cambiando forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811990
    m_Localized: 'Intruder: Forse perché hanno perso il loro spazio sacro. Quel tempo che avevamo per riposare, per riflettere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811991
    m_Localized: Entra, se vuoi.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811992
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811993
    m_Localized: 'Intruder: Difficile dirlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811994
    m_Localized: 'Intruder: Sono sei giorni che non chiudo occhio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811995
    m_Localized: 'Intruder: Forse, se lo facessi, riuscirei a sognare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811996
    m_Localized: Entra, se vuoi.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811997
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811998
    m_Localized: 'Intruder: Grazie. Proverò a dormire, anche se temo che il sonno non vorrà saperne di arrivare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811999
    m_Localized: 'Intruder: Ma se ci fosse qualcuno in casa che sogna, mi andrebbe comunque bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812000
    m_Localized: 'Intruder: Credi che la gente riprenderà a sognare?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812001
    m_Localized: 'Intruder: Io ci spero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812002
    m_Localized: 'Intruder: È dura vivere senza sogni. Per chiunque.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812003
    m_Localized: 'Courier: Ciao, consegna da ForRest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812005
    m_Localized: Pensavo che le consegne fossero state interrotte.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812011
    m_Localized: 'Courier: E buona giornat... Ehm, volevo dire, notte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812012
    m_Localized: 'Courier: Non mi ci sono ancora abituato...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812013
    m_Localized: 'Courier: Ciao, consegna da ForRest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812015
    m_Localized: Come sei finito a fare il fattorino?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812016
    m_Localized: 'Courier: Mi è bastato superare i test. Hanno controllato tutti i segni, hanno deciso che sono umano e...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812017
    m_Localized: 'Courier: Oh, intendevi come sono finito a fare consegne nel pieno di un''apocalisse?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812018
    m_Localized: 'Courier: Beh, cos''altro avrei dovuto fare? Rimanere seduto a casa a fare la muffa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812019
    m_Localized: 'Courier: Almeno così mi distraggo e riesco a non pensare a tutto questo casino...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812020
    m_Localized: 'Courier: Buonanotte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812021
    m_Localized: 'Courier: Ciao... Ho una consegna da fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812023
    m_Localized: Mi sembri giù di morale.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812024
    m_Localized: 'Courier: Il mio collega è stato preso dalla FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812025
    m_Localized: 'Courier: Il solito controllo mattutino. Hanno notato gli occhi rossi e... Maledizione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812026
    m_Localized: 'Courier: L''hanno portato via e questo è quanto. Ora non so neanche cosa gli sia successo, o se lo lasceranno mai andare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812027
    m_Localized: 'Courier: E se anche i miei occhi si arrossassero per il sonno? Finirei anch''io in una delle loro dannate zone di quarantena?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812029
    m_Localized: 'Courier: Buonanotte...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812030
    m_Localized: 'Courier: Consegna in arrivo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812033
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812034
    m_Localized: Che ti è successo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812035
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812036
    m_Localized: 'Courier: Hanno ucciso un mio amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812037
    m_Localized: 'Courier: È andato a effettuare una consegna e il proprietario della casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812038
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812039
    m_Localized: 'Courier: La gente è uscita di senno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812040
    m_Localized: 'Courier: Che male gli aveva fatto a quello stronzo un semplice fattorino? Perché ucciderlo? Per quale cazzo di motivo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812041
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812050
    m_Localized: 'Courier: Ecco, prendi... {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812051
    m_Localized: 'CultistPriest: Oh, sì! Questa casa è perfetta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812052
    m_Localized: 'CultistPriest: Lo sento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812053
    m_Localized: E cosa sentiresti, di preciso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812054
    m_Localized: Sì, ed è casa mia.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812055
    m_Localized: 'CultistPriest: Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812056
    m_Localized: 'CultistPriest: La Morte ha sviluppato un certo interesse per la tua casa. Sembra piacerle molto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812057
    m_Localized: 'CultistPriest: Non so in quanti siano morti qui, ma... la Sua presenza è forte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812058
    m_Localized: Ma chi sei tu? E perché sei vestito così?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812059
    m_Localized: Sembri una specie di fanatico cultista.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812060
    m_Localized: 'CultistPriest: Esattamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812061
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812062
    m_Localized: 'CultistPriest: La Morte è ovunque.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812063
    m_Localized: 'CultistPriest: C''è chi è stato bruciato, chi è stato trascinato fuori e giustiziato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812064
    m_Localized: 'CultistPriest: La Morte ti ha preso in simpatia, sì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812065
    m_Localized: Ma chi sei tu? E perché sei vestito così?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812066
    m_Localized: Sembri una specie di fanatico cultista.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812067
    m_Localized: 'CultistPriest: Siamo i messaggeri di una nuova fede, gli oratori di una dottrina sacra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812068
    m_Localized: 'CultistPriest: La Morte è giunta. Il Suo unico desiderio è quello di lenire l''umanità e di liberarci dal caos, dall''amarezza e dal tumulto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812069
    m_Localized: 'CultistPriest: Noi la stiamo semplicemente aiutando ad avvicinarsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812070
    m_Localized: 'CultistPriest: È l''unica strada per la salvezza. Non c''è modo di tornare indietro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812071
    m_Localized: Quindi, che cosa vuoi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812072
    m_Localized: Vuoi entrare o cosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812073
    m_Localized: 'CultistPriest: Forse lo sono. È così grave?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812074
    m_Localized: 'CultistPriest: Questo è il mio sudario. Servirà quando morirò. In questo modo, non sarà necessario cercare un telo per avvolgere i nostri defunti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812075
    m_Localized: 'CultistPriest: Noi non crediamo nella salvezza, a meno che non provenga dalla Morte stessa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812076
    m_Localized: 'CultistPriest: È già molto vicina. La stiamo semplicemente aiutando ad attraversare la soglia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812077
    m_Localized: Quindi, che cosa vuoi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812078
    m_Localized: Vuoi entrare o cosa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812079
    m_Localized: 'CultistPriest: Dobbiamo celebrare i riti funebri. In modi nuovi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812080
    m_Localized: 'CultistPriest: La tua casa è perfetta, sì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812081
    m_Localized: 'CultistPriest: L''influenza della Morte è forte in questo luogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812082
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812083
    m_Localized: 'CultistPriest: Ma cosa sta succedendo qui, comunque?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812084
    m_Localized: 'CultistPriest: Ad ogni modo, lascia che i miei fratelli entrino. Proteggili.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812085
    m_Localized: 'CultistPriest: Devono sopravvivere quanto basta per portare a termine i loro compiti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812086
    m_Localized: Non sono proprio entusiasta all'idea.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812087
    m_Localized: Sembra un compito arduo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812088
    m_Localized: 'CultistPriest: Non ho bisogno di entrare. La mia missione è solo quella di diffondere la sacra verità che porta la pace eterna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812089
    m_Localized: 'CultistPriest: Ma i miei fratelli necessitano di un riparo. La Morte è attirata da questo luogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812090
    m_Localized: 'CultistPriest: Celebreranno i riti per i defunti. Tu devi solo tenerli al sicuro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812091
    m_Localized: Non sono proprio entusiasta all'idea.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812092
    m_Localized: Sembra un compito arduo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812093
    m_Localized: 'CultistPriest: Forse finirai per bruciare, dopotutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812094
    m_Localized: 'CultistPriest: Veglia sulla mia gente e ricorda: se uno di loro muore... la tua casa sarà ridotta in cenere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812095
    m_Localized: 'CultistPriest: Se ne muore più di uno, sarà stato tutto inutile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812096
    m_Localized: 'CultistPriest: Se ciò dovesse accadere, daremo fuoco alle tue mura fino a bruciarne le fondamenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812097
    m_Localized: 'CultistPriest: Perdonami, ma non c''è altro modo per compiere la nostra missione divina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812098
    m_Localized: Allora vi sparerò, a tutti.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812099
    m_Localized: Non amo essere minacciato. Ma d'accordo, vi aiuterò.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812100
    m_Localized: 'CultistPriest: È un compito arduo. La strada verso uno scopo più elevato non è mai facile da percorrere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812101
    m_Localized: 'CultistPriest: Non desideri la pace? Un mondo in cui nessuno sia un fardello per gli altri?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812102
    m_Localized: 'CultistPriest: Veglia sulla mia gente e ricorda: se uno di loro muore... la tua casa sarà ridotta in cenere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812103
    m_Localized: 'CultistPriest: Se ne muore più di uno, il nostro obiettivo diverrà irrealizzabile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812104
    m_Localized: 'CultistPriest: Purtroppo, se il nostro piano fallirà qui, le tue mura ne pagheranno il prezzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812105
    m_Localized: 'CultistPriest: Ahimè... Non c''è altro modo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812106
    m_Localized: Allora vi sparerò, a tutti.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812107
    m_Localized: Non amo essere minacciato. Ma d'accordo, vi aiuterò.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812108
    m_Localized: 'CultistPriest: Pensi che siamo solo noi poche anime a portare avanti la fiaccola della fede?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812109
    m_Localized: 'CultistPriest: Altri arriveranno. Mentre dormirai, cospargeranno le pareti di benzina e accenderanno un fiammifero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812110
    m_Localized: 'CultistPriest: Anche se sopravvivrai all''incendio, la tua casa sarà distrutta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812111
    m_Localized: 'CultistPriest: E dove scapperai, allora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812112
    m_Localized: 'CultistPriest: Perciò, forse... ti conviene farli rimanere, sì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812113
    m_Localized: 'CultistPriest: Dubito che servirà loro molto tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812114
    m_Localized: 'CultistPriest: Grazie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812115
    m_Localized: 'CultistPriest: Non avranno bisogno di molto tempo, ma comunque... veglia su di loro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812116
    m_Localized: 'CultistPriest: A presto. Tornerò per controllare la situazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812117
    m_Localized: 'CultistPriest: Non perdiamoci in chiacchiere: come sta il mio gregge?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812118
    m_Localized: Sono vivi.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812119
    m_Localized: Non me ne frega niente. Ho altro a cui pensare.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812120
    m_Localized: 'CultistPriest: Grazie per tutto quello che hai fatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812121
    m_Localized: 'CultistPriest: Sono sicuro che anche tu sarai stanco. Di tutto questo rumore, di questi tempi opprimenti, della confusione...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812122
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812123
    m_Localized: 'CultistPriest: La Morte mi ha parlato, di recente. Spera di incontrarti quando sarà il momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812124
    m_Localized: 'CultistPriest: Potrebbe persino offrirti un posto dove nasconderti. Da tutto, anche dalla fine stessa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812125
    m_Localized: 'CultistPriest: Non sono ancora sicuro di cosa significhi, ma... sembra un''offerta allettante, non credi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812126
    m_Localized: 'CultistPriest: Aspetta...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812127
    m_Localized: 'CultistPriest: Sono... morti?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812128
    m_Localized: 'CultistPriest: Tu... ci hai privato della nostra unica possibilità.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812129
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812130
    m_Localized: 'CultistPriest: Addio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812131
    m_Localized: 'CultistPriest: La Morte ha smesso di parlarmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812132
    m_Localized: 'CultistPriest: Quindi è così che finisce il mondo. Non con uno schianto... ma con un lamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812133
    m_Localized: 'CultistPriest: Ma per te va tutto bene, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812134
    m_Localized: Il tuo gregge sta bene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812135
    m_Localized: Vattene. Ho da fare.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812136
    m_Localized: 'CultistPriest: Sì... Tutto secondo i piani. Il Suo sguardo è rivolto ancora su di noi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812137
    m_Localized: 'CultistPriest: Non posso attardarmi oltre. Sarà meglio che vada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812138
    m_Localized: Porta i tuoi fanatici via con te.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812139
    m_Localized: Allora, cosa puoi dirmi di questa tua Morte?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812140
    m_Localized: 'CultistPriest: Hanno lasciato questo regno mortale...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812141
    m_Localized: 'CultistPriest: Ora si spiega tutto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812142
    m_Localized: 'CultistPriest: Sai, visto che la Morte ti ha scelto, la aiuterò volentieri a guardarti più da vicino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812143
    m_Localized: 'CultistPriest: Buonanotte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812144
    m_Localized: Porta i tuoi fanatici via con te.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812145
    m_Localized: Allora, cosa puoi dirmi di questa tua Morte?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812146
    m_Localized: 'CultistPriest: Perché?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812147
    m_Localized: Lasciami in pace.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812148
    m_Localized: Questo non è un asilo nido.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812149
    m_Localized: 'CultistPriest: Il giorno del Suo arrivo è vicino... Lo sento, sì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812150
    m_Localized: 'CultistPriest: Non importa se non comprendiamo appieno ciò che stiamo evocando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812151
    m_Localized: 'CultistPriest: L''unica cosa che conta è che siamo tutti stanchi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812152
    m_Localized: 'CultistPriest: Eppure, il pensiero del nulla eterno ci terrorizza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812153
    m_Localized: 'CultistPriest: Il concetto di aldilà non è altro che un sogno effimero promesso da false religioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812154
    m_Localized: 'CultistPriest: Il ciclo della rinascita? Poco più che un tormento senza fine con brevi pause intermedie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812155
    m_Localized: 'CultistPriest: Ma la Morte stessa... potrebbe risparmiarci il destino più terribile di tutti: il vuoto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812156
    m_Localized: 'CultistPriest: Non abbiamo altra scelta che continuare a invocarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812157
    m_Localized: Lasciami in pace.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812158
    m_Localized: Questo non è un asilo nido.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812159
    m_Localized: 'CultistPriest: Molto bene... Hai fatto abbastanza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812160
    m_Localized: 'CultistPriest: Li porterò via con me. E hai comunque la mia gratitudine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812161
    m_Localized: 'CultistPriest: Ti davano davvero tanto fastidio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812162
    m_Localized: 'CultistPriest: O forse non è la pace ciò che desideri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812163
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812164
    m_Localized: 'CultistPriest: Hai comunque la mia gratitudine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812165
    m_Localized: 'CultistPriest: Ciò che andava fatto è stato fatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006208
    m_Localized: 'MushroomEater: Ma salve, caro ragazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006209
    m_Localized: Chi sei?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006210
    m_Localized: Ci conosciamo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006211
    m_Localized: 'MushroomEater: Oh oh oh! Sono solo un vecchio brontolone che se ne intende di funghi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006212
    m_Localized: 'MushroomEater: Ma non badare a me. Il micelio mi ha detto qualcosa di molto preoccupante. Oh, sì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006213
    m_Localized: 'MushroomEater: Il Festival dei Funghi è alle porte! E il tempo, mio caro ragazzo, ci sta scivolando via tra le dita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006214
    m_Localized: 'MushroomEater: Quindi, ti prego, ascolta attentamente le mie parole.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006215
    m_Localized: Il micelio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006216
    m_Localized: Non ti seguo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006217
    m_Localized: 'MushroomEater: Oh oh! Io so benissimo chi sei! Me l''ha detto il micelio!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006218
    m_Localized: 'MushroomEater: Il suo modo di parlare è complicato da capire, ma ho imparato a dare un senso ai segnali che invia. Oh, sì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006219
    m_Localized: 'MushroomEater: Quindi, ascoltami attentamente, caro ragazzo. Abbiamo molto lavoro da fare e poco tempo a disposizione!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006220
    m_Localized: Il micelio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006221
    m_Localized: Non ti seguo.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006222
    m_Localized: 'MushroomEater: Sì, capisco che è un concetto difficile per la gente comune. Hanno un modo di parlare tutto loro, molto strano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006223
    m_Localized: 'MushroomEater: Il micelio è il mezzo con il quale i funghi comunicano tra loro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006224
    m_Localized: 'MushroomEater: Ho imparato ad ascoltarli studiando il Libro dei Sorrisi. Ma quello che mi hanno detto l''ultima volta... Beh, non è molto positivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006225
    m_Localized: 'MushroomEater: Hanno parlato dell''imminente Festival dei Funghi, e questo, mio caro ragazzo, non va affatto bene. No, no, no!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006226
    m_Localized: Il Libro dei Sorrisi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006227
    m_Localized: Il Festival dei Funghi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006228
    m_Localized: 'MushroomEater: Ah ah! Beh, presto tutto avrà senso. Oh, e ricorda: dobbiamo fermare il Festival dei Funghi... a tutti i costi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006229
    m_Localized: 'MushroomEater: Ora, guarda qui... Ho qualcosa che ci aiuterà: il Libro dei Sorrisi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006230
    m_Localized: Il Libro dei Sorrisi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006231
    m_Localized: Il Festival dei Funghi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006232
    m_Localized: 'MushroomEater: È un libro speciale... Il più speciale al mondo, in effetti. Ti spiegherà cosa bisogna fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006233
    m_Localized: 'MushroomEater: Ma temo non ci sia tempo per leggerlo tutto. È voluminoso... e le lancette corrono!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006234
    m_Localized: 'MushroomEater: Quindi ho strappato solo le pagine più importanti. Tieni, ragazzo mio... Prendile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006235
    m_Localized: E va bene, prenderò le pagine di questo Libro dei Sorrisi.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006236
    m_Localized: Puoi tenerle.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006237
    m_Localized: 'MushroomEater: Oh oh, mio caro ragazzo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006238
    m_Localized: 'MushroomEater: Per questo, dovremo consultare il Libro dei Sorrisi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006239
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006240
    m_Localized: 'MushroomEater: Un grande fungo sorgerà... e le sue spore in lungo e in largo spargerà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006241
    m_Localized: 'MushroomEater: La sua ombra si espanderà, il sole inghiottirà... e nessun luogo allo spettacolo rifuggirà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006242
    m_Localized: 'MushroomEater: Ma questo fungo non crescerà da solo, perché un festival è un gran dono!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006243
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006244
    m_Localized: 'MushroomEater: Accidenti, non possiamo permettere che ciò accada. Dobbiamo impedirlo... Insieme, ragazzo mio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006245
    m_Localized: 'MushroomEater: Ho strappato alcune pagine dal Libro dei Sorrisi. Prendile, ti prego. Ti indicheranno cosa fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006246
    m_Localized: E va bene, prenderò le pagine di questo Libro dei Sorrisi.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006247
    m_Localized: Puoi tenerle.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006248
    m_Localized: 'MushroomEater: Bravo, ragazzo. Leggile non appena hai un momento libero, intesi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006249
    m_Localized: 'MushroomEater: Ora devo andare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006250
    m_Localized: 'MushroomEater: Ma tornerò quando avrai sistemato tutto! Quindi... datti una mossa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006251
    m_Localized: 'MushroomEater: Ti auguro una buona nottata, molti sorrisi, e tanta salute e gioia, mio caro ragazzo. Ciao ciao!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006252
    m_Localized: 'MushroomEater: Ma... perché? È solo una piccola parte del libro, e in più lo conosco a memoria...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006253
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006254
    m_Localized: 'MushroomEater: Mah, forse sto solo sprecando del tempo prezioso con voi giovani...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006255
    m_Localized: 'MushroomEater: Ben ritrovato, ragazzo mio! Sono felice di constatare che hai fatto tutto ciò che il Libro dei Sorrisi ti ha chiesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006256
    m_Localized: 'MushroomEater: Spero proprio sia sufficiente per fermare il Festival...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006257
    m_Localized: Come fai a saperlo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006258
    m_Localized: Non mi sembri molto convinto.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006259
    m_Localized: 'MushroomEater: Me l''ha detto il micelio, ovviamente!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006260
    m_Localized: 'MushroomEater: Sa tantissime cose, ma ora anche lui è in pericolo... proprio come tutti noi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006261
    m_Localized: 'MushroomEater: I funghi stanno crescendo troppo velocemente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006262
    m_Localized: In che modo le nostre azioni avrebbero fermato il Festival?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006263
    m_Localized: Non puoi semplicemente chiedere ai funghi di non iniziare il Festival?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006264
    m_Localized: 'MushroomEater: Oh, mio caro ragazzo... Se solo fosse così semplice. Ancora non sappiamo quanto siano state utili le nostre azioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006265
    m_Localized: 'MushroomEater: Ora non possiamo far altro che aspettare e sperare che siano state sufficienti per impedire la crescita dei funghi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006266
    m_Localized: In che modo le nostre azioni avrebbero fermato il Festival?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006267
    m_Localized: Non puoi semplicemente chiedere ai funghi di non iniziare il Festival?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006268
    m_Localized: 'MushroomEater: Abbiamo celebrato un antico rituale, mio caro ragazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006269
    m_Localized: 'MushroomEater: Non possiamo parlare direttamente ai funghi, no, no, no! Non facciamo parte del micelio!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006270
    m_Localized: 'MushroomEater: Ma il Libro dei Sorrisi ci ha mostrato un modo per calmare le loro radici e la loro crescita frenetica.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006271
    m_Localized: 'MushroomEater: Che, per inciso, è proprio ciò che abbiamo fatto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006272
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006273
    m_Localized: 'MushroomEater: Tornerò quando sarà il momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006274
    m_Localized: 'MushroomEater: Ci assicureremo che i funghi non crescano e impediremo che il Festival abbia inizio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006275
    m_Localized: 'MushroomEater: Ricorda solo che i funghi non sono sempre ciò che sembrano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006276
    m_Localized: 'MushroomEater: Questo non è un addio, mio caro ragazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006277
    m_Localized: 'MushroomEater: Sarebbe un''idea fantastica... se non fosse che non posso comunicare direttamente con i funghi. No, no, no...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006278
    m_Localized: 'MushroomEater: Sono solo una parte della rete fungina, ahimè!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006279
    m_Localized: 'MushroomEater: Il micelio è il vero cervello. Peccato che io possa solo ascoltarlo... Non capisce la nostra lingua.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006280
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006281
    m_Localized: 'MushroomEater: Tornerò quando sarà il momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006282
    m_Localized: 'MushroomEater: Ci assicureremo che i funghi non crescano e impediremo che il Festival abbia inizio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006283
    m_Localized: 'MushroomEater: Ricorda solo che i funghi non sono sempre ciò che sembrano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006284
    m_Localized: 'MushroomEater: Questo non è un addio, mio caro ragazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006285
    m_Localized: 'MushroomEater: Sembra che il Festival si terrà comunque, dopotutto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006286
    m_Localized: 'MushroomEater: C''è così tanta agitazione nel micelio che il rituale... beh, semplicemente, non ha funzionato...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006287
    m_Localized: Perché non ha funzionato?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006288
    m_Localized: Cosa succederà se il Festival si terrà?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006289
    m_Localized: 'MushroomEater: Qualcosa è andato storto all''interno del micelio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006290
    m_Localized: 'MushroomEater: Quando si accumula troppo astio nei suoi filamenti, beh... intasa qualunque cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006291
    m_Localized: 'MushroomEater: I funghi sono come un fegato che cerca di purificare il corpo dal veleno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006292
    m_Localized: 'MushroomEater: Ma si è accumulato così tanto astio che il fungo è finito per crescere oltre ogni limite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006293
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006294
    m_Localized: 'MushroomEater: Non volevo farlo, ma... temo che dovremo recarci nel Paese dei Funghi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006295
    m_Localized: Il Paese dei Funghi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006296
    m_Localized: Beh, non sembra così male...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006297
    m_Localized: 'MushroomEater: Beh, il Festival farebbe crescere i funghi in modo incontrollato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006298
    m_Localized: 'MushroomEater: Il che significa che il micelio si ritroverebbe in guai seri!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006299
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006300
    m_Localized: 'MushroomEater: Non volevo farlo, ma... temo che dovremo recarci nel Paese dei Funghi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006301
    m_Localized: Il Paese dei Funghi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006302
    m_Localized: Beh, non sembra così male...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006303
    m_Localized: 'MushroomEater: Oh, non immagini quanto ti sbagli, caro ragazzo! È un luogo spaventoso dove nessun uomo ha mai messo piede.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006304
    m_Localized: 'MushroomEater: E credimi, sarebbe meglio così, se non fosse che... non abbiamo altra scelta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006305
    m_Localized: 'MushroomEater: Dobbiamo fermare il Festival, costi quel che costi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006306
    m_Localized: 'MushroomEater: Sei pronto a venire con me nel Paese dei Funghi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006307
    m_Localized: Sì.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006308
    m_Localized: No.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006309
    m_Localized: 'MushroomEater: Non lasciarti ingannare dal nome, caro ragazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006310
    m_Localized: 'MushroomEater: Nella nostra lingua può sembrare quasi ridente... ma nel linguaggio dei funghi significa tutt''altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006311
    m_Localized: 'MushroomEater: Non è una terra di sole e di arcobaleni. No, no, no!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006312
    m_Localized: 'MushroomEater: Non vedremo il Festival, laggiù, ma gli altri... Il micelio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006313
    m_Localized: 'MushroomEater: Se non agiamo subito, potremmo perdere tutto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006314
    m_Localized: 'MushroomEater: Nessun uomo dovrebbe mai metterci piede. Mai e poi mai. Ma dobbiamo farlo se vogliamo fermare il Festival.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006315
    m_Localized: 'MushroomEater: Sei pronto a venire con me nel Paese dei Funghi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006316
    m_Localized: Sì.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006317
    m_Localized: No.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006318
    m_Localized: 'MushroomEater: Oh oh! Questo è lo spirito giusto, ragazzo mio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006319
    m_Localized: 'MushroomEater: Raccogli le tue cose e...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006320
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006321
    m_Localized: 'MushroomEater: Aspetta un attimo, maledizione. Fammi vedere il tuo orologio!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006322
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006323
    m_Localized: 'MushroomEater: MEZZANOTTE?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006324
    m_Localized: 'MushroomEater: Oh, santi numi! Siamo in ritardo! Vieni, sbrigati!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006325
    m_Localized: 'MushroomEater: Prima che il cancello del Paese dei Funghi si chiuda!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006326
    m_Localized: 'MushroomEater: Oh, mio caro ragazzo... Non va affatto bene...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006327
    m_Localized: 'MushroomEater: Temo di non poterlo fare da solo. Ho bisogno del tuo aiuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006328
    m_Localized: 'MushroomEater: Stiamo attraversando tempi difficili, ragazzo mio. Balliamo mentre il Paese dei Funghi collassa. E forse accadrà anche a noi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006329
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006330
    m_Localized: 'MushroomEater: Non so cosa ci attende nel Paese dei Funghi, ma di una cosa possiamo essere certi... Sarà pericoloso!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006331
    m_Localized: 'MushroomEater: Quindi, te lo chiederò di nuovo, caro ragazzo: verrai con me?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006332
    m_Localized: Sì.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006333
    m_Localized: No.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006334
    m_Localized: 'MushroomEater: Capisco...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006335
    m_Localized: 'MushroomEater: Temo che ogni speranza sia perduta, in tal caso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006336
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006337
    m_Localized: 'MushroomEater: Ti auguro una buona nottata, molti sorrisi, e tanta salute e gioia, mio caro ragazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006338
    m_Localized: 'MushroomEater: Ciao ciao!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006339
    m_Localized: 'Miner: Eh? CHI VA LÀ? Ero sicuro di aver sentito qualcosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006340
    m_Localized: 'Miner: Beh, non proprio sicuro, in effetti...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006341
    m_Localized: Cosa ci fai sotto casa mia?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006342
    m_Localized: Sei bloccato qui sotto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006343
    m_Localized: 'Miner: COSA? Parla più forte!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006344
    m_Localized: 'Miner: Ho le orecchie intasate di polvere e fuliggine, NON SENTO UN ACCIDENTE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006345
    m_Localized: 'Miner: Siamo sotto casa tua?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006346
    m_Localized: 'Miner: Beh, speriamo non ci crolli in testa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006347
    m_Localized: Come sei finito qui sotto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006348
    m_Localized: Cosa stai cercando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006349
    m_Localized: 'Miner: EH?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006350
    m_Localized: 'Miner: Bloccato? No! Abbiamo trovato qualcosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006351
    m_Localized: 'Miner: Ho le orecchie così sporche che mi sembra tu stia parlando attraverso un cuscino. Lo giuro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006352
    m_Localized: Come sei finito qui sotto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006353
    m_Localized: Cosa stai cercando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006354
    m_Localized: 'Miner: Io e i ragazzi abbiamo pensato di scavare dei tunnel per ripararci dal caldo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006355
    m_Localized: 'Miner: Ci eravamo appena messi al lavoro quando, sorpresa... abbiamo trovato un''INTERA RETE SOTTERRANEA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006356
    m_Localized: 'Miner: Sembra vastissima, ma ci sono stati alcuni crolli, di recente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006357
    m_Localized: 'Miner: Questi tunnel sono profondi. MOLTO PROFONDI. Non abbiamo idea di dove portino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006358
    m_Localized: 'Miner: Ma non è questo il punto. Abbiamo trovato QUALCOS''ALTRO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006359
    m_Localized: Di che si tratta? Qualcosa di interessante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006360
    m_Localized: Avete trovato un Visitatore?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006361
    m_Localized: 'Miner: UN RIFUGIO, CAZZO! Da questo caldo infernale!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006362
    m_Localized: 'Miner: Avevamo appena iniziato a scavare e indovina cosa abbiamo trovato? Un intero SISTEMA DI TUNNEL SOTTERRANEI!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006363
    m_Localized: 'Miner: Non sappiamo chi li abbia scavati o perché, ma di sicuro abbiamo qualche sospetto!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006364
    m_Localized: 'Miner: Pensiamo che i Visitatori li usino per spostarsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006365
    m_Localized: 'Miner: Anche se non possiamo ancora dirlo con certezza...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006366
    m_Localized: 'Miner: Ma ascolta, questi tunnel non sono la parte più strana della storia... C''è qualcos''altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006367
    m_Localized: Di che si tratta? Qualcosa di interessante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006368
    m_Localized: Avete trovato un Visitatore?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006369
    m_Localized: 'Miner: C''È UNA BUCA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006370
    m_Localized: 'Miner: E sta succedendo qualcosa vicino... Si sente un ronzio leggero che NON SMETTE MAI.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006371
    m_Localized: 'Miner: Gli animali si zittiscono, le bussole impazziscono e le torce non riescono a penetrare l''oscurità.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006372
    m_Localized: 'Miner: Uno dei nostri è entrato, mentre io sono rimasto qui, nel caso avesse bisogno d''aiuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006373
    m_Localized: 'Miner: Ascolta, se stai pensando di scendere... STA'' LONTANO DALLA BUCA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006374
    m_Localized: 'Miner: Abbiamo provato a scavarci vicino e ci è quasi crollato tutto addosso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006375
    m_Localized: 'Miner: COSA?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006376
    m_Localized: 'Miner: Beh, non so quanto si possa definire interessante, in realtà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006377
    m_Localized: 'Miner: È solo una buca, ma intorno stanno accadendo cose strane.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006378
    m_Localized: 'Miner: Uno dei ragazzi ne ha sentito parlare e ha detto che forse valeva la pena dare un''occhiata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006379
    m_Localized: 'Miner: Ascolta, se stai pensando di scendere... STA'' LONTANO DALLA BUCA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006380
    m_Localized: 'Miner: Abbiamo provato a scavarci vicino e ci è quasi crollato tutto addosso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006381
    m_Localized: 'Miner: Ti dirò di più quando scenderai anche tu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006382
    m_Localized: 'Miner: Di nuovo qui? EH? COSA? Stai parlando più piano o sono io che sto diventando sordo a causa di quel ronzio? ALLORA? SPUTA IL ROSPO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006383
    m_Localized: Da quanto sei quaggiù?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006384
    m_Localized: I tuoi amici non sono ancora tornati?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006385
    m_Localized: 'Miner: COSA? PARLA PIÙ FORTE! Sono seduto qui da... due, forse tre giorni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006386
    m_Localized: 'Miner: Il tempo scorre in modo strano quaggiù. Niente luce, niente orologi... Non sono certo di quante ore siano passate.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006387
    m_Localized: 'Miner: Faresti meglio a mangiare qualcosa o finirai come me: affamato, con solo una lanterna a farti compagnia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006388
    m_Localized: Hai guardato cosa c'è nella buca?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006389
    m_Localized: Non sei preoccupato per i tuoi amici là sotto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006390
    m_Localized: 'Miner: EH? I MIEI AMICI? Nah, stanno bene. Uno si è addentrato nelle profondità, ma tornerà. Sa come fiutare una via d''uscita, quello lì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006391
    m_Localized: 'Miner: L''altro è sulla fune. Darà uno strattone quando sarà pronto, o se qualcosa va storto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006392
    m_Localized: 'Miner: La corda è ancora tesa, vedi? Significa che è ancora lì sotto. Se qualcosa andasse storto, lo sapremmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006393
    m_Localized: Hai guardato cosa c'è nella buca?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006394
    m_Localized: Non sei preoccupato per i tuoi amici là sotto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006395
    m_Localized: 'Miner: SE HO GUARDATO? Più o meno... Non proprio, a dire il vero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006396
    m_Localized: 'Miner: Mi piacerebbe, ma basta un solo movimento sbagliato con quella corda ed È FINITA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006397
    m_Localized: 'Miner: Mi sono avvicinato quando i ragazzi erano ancora quassù. Ma là sotto... è come scrutare nell''abisso. Il vero nulla.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006398
    m_Localized: 'Miner: A volte, però, quando ti avvicini... sembra che qualcosa ti chiami. Prova... e ascolta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006399
    m_Localized: 'Miner: Non che abbia paura, eh. Solo che... ti attira. Se solo potessi dare un''altra occhiata... Poco più da vicino...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006400
    m_Localized: 'Miner: Dobbiamo restare uniti, ok? Qualcuno deve essere pronto a tirare su l''altro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006401
    m_Localized: 'Miner: VISITATORI? È quello che abbiamo sempre detto! Pensiamo che questi tunnel siano loro e che quella buca possa essere una specie di... porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006402
    m_Localized: 'Miner: E se le risposte fossero lì sotto? Magari non tutte, ma... Perché sono venuti qui, cosa vogliono...? PENSACI!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006403
    m_Localized: 'Miner: Una volta scesi, forse riusciremo finalmente a capirlo. Ci andrei io, ma... qualcuno deve pur tenere ferma la fune, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006404
    m_Localized: 'Miner: Non sembri portato per i lavori pesanti, ma io non avrei problemi a tirarti su. Che ne dici di scendere a vedere, mentre io... sto di guardia?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006405
    m_Localized: 'Miner: OH, SEI TU. Pensavo ti fossi tirato indietro. C''è qualcosa che non va, però. La luce è strana e la corda sembra pesante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006406
    m_Localized: 'Miner: O forse sono rimasto seduto qui troppo a lungo e la mia immaginazione sta prendendo il sopravvento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006407
    m_Localized: 'Miner: Ma quella buca... Sii onesto, quante volte ti sei sentito attratto? Ti attira, vero? Ammettilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006408
    m_Localized: Credi che il tuo amico sia ancora vivo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006409
    m_Localized: Il tuo amico è ancora disperso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006410
    m_Localized: 'Miner: Oh, ma certo che lo è! La corda è ancora tesa, vedi? Significa che è lì sotto, al lavoro. Se qualcosa fosse andato storto, lo saprei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006411
    m_Localized: 'Miner: Ma ehi, abbiamo tempo da perdere mentre aspettiamo, per capire come funziona questo posto. Ammettilo, sei curioso, non è vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006412
    m_Localized: Perché non scendi anche tu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006413
    m_Localized: E se non scoprissimo mai cosa c'è là sotto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006414
    m_Localized: 'Miner: Il mio amico? Senti, qualcuno deve fare la prima mossa. Non posso stare qui seduto per sempre. Ora o mai più.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006415
    m_Localized: 'Miner: Lo senti anche tu, vero? Quell''attrazione... Come se quella buca ti stesse chiamando. Lo senti, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006416
    m_Localized: Perché non scendi anche tu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006417
    m_Localized: E se non scoprissimo mai cosa c'è là sotto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006418
    m_Localized: 'Miner: E chi mi tirerebbe su poi, eh? Senza offesa, ma ho visto topi più muscolosi di te. Vai giù tu, io resto qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006419
    m_Localized: 'Miner: Potrei sollevarti con un braccio solo, ma se vado io, chi mi tira su? Si tratta di semplice logica.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006420
    m_Localized: 'Miner: Vuoi sapere cosa c''è là sotto, vero? Non sei un codardo, lo vedo. Sei venuto qui già tre volte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006421
    m_Localized: 'Miner: VAI, FORZA. Mostra un briciolo di coraggio. Se scendi, TI COPRO LE SPALLE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006422
    m_Localized: 'Miner: Vuoi davvero passare il resto della tua vita a chiederti "e se..." solo perché ora ti sei tirato indietro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006423
    m_Localized: 'Miner: ALLORA? Che aspetti? È per questo che siamo qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006424
    m_Localized: 'Miner: In che senso "non lo scoprissimo mai"? STAI SCHERZANDO, SPERO. Non è solo una buca. So che lo senti anche tu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006425
    m_Localized: 'Miner: E se là sotto ci fosse qualcosa in grado di cambiare tutto? Che risponde a tutte le domande, che ti rende un eroe nazionale...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006426
    m_Localized: 'Miner: Te ne andresti e basta? Torneresti alla tua vita come se nulla fosse? DAI, SCENDI. Cerchiamo di scoprire di che si tratta, insieme!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006427
    m_Localized: 'Vigilante: Mantieni le distanze, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006428
    m_Localized: 'Vigilante: Bene, questo aumenta le tue probabilità di sopravvivenza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006429
    m_Localized: 'Vigilante: Sempre che tu non sia un Visitatore...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006430
    m_Localized: Chi sei?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006431
    m_Localized: Che ci fai in giro a quest'ora?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006432
    m_Localized: 'Vigilante: Qualcuno che è qui per ripulire la feccia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006433
    m_Localized: 'Vigilante: Che mantiene pulito il quartiere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006434
    m_Localized: 'Vigilante: Non ti serve sapere altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006435
    m_Localized: Non mi sembra una scopa quella che tieni in mano.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006436
    m_Localized: E ti sei agghindato a prova di Visitatore?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006437
    m_Localized: 'Vigilante: Questo non è un maledetto gioco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006438
    m_Localized: 'Vigilante: Alcuni provano compassione per i Visitatori, pensano che possano, non so... cambiare in meglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006439
    m_Localized: 'Vigilante: Poi passano un paio di giorni e massacrano tutti gli occupanti della casa, dopodiché scappano e ricominciano da capo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006440
    m_Localized: 'Vigilante: Non c''è giustizia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006441
    m_Localized: 'Vigilante: Ma io non mi nascondo. Porto ordine. SONO IO LA GIUSTIZIA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006442
    m_Localized: Non mi sembra una scopa quella che tieni in mano.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006443
    m_Localized: E ti sei agghindato a prova di Visitatore?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006444
    m_Localized: 'Vigilante: Beh, in un certo senso lo è.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006445
    m_Localized: 'Vigilante: Ma sì, consideriamola pure una scopa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006446
    m_Localized: 'Vigilante: Potrei spazzare via la feccia a mani nude, ma così è più facile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006447
    m_Localized: 'Vigilante: Il modo più efficace, però, sai qual è? Rinchiudere i Visitatori in una casa e darle fuoco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006448
    m_Localized: 'Vigilante: E chiunque provi compassione per loro... forse è un Visitatore anche lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006449
    m_Localized: Quindi, perché sei qui?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006450
    m_Localized: Per quanto pensi di ripulire "la feccia"?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006451
    m_Localized: 'Vigilante: "A prova di Visitatore"? Oh, ti riferisci a questo gingillo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006452
    m_Localized: 'Vigilante: Non male come definizione. Dovrei iniziare a usarla anch''io.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006453
    m_Localized: 'Vigilante: È un promemoria per ricordare a me stesso quante case e quante città ho ripulito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006454
    m_Localized: 'Vigilante: Estraggo un dente da ogni Visitatore. Sono i trofei più facili da prendere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006455
    m_Localized: 'Vigilante: Ma se qualcuno mi colpisce particolarmente... magari prendo anche qualcos''altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006456
    m_Localized: Quindi, perché sei qui?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006457
    m_Localized: Per quanto pensi di ripulire "la feccia"?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006458
    m_Localized: 'Vigilante: Un attimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006459
    m_Localized: 'Vigilante: Hai già fatto le tue domande. Ora tocca a me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006460
    m_Localized: 'Vigilante: C''è qualcosa di particolare da segnalare in questo quartiere? Qualche pericolo a cui dovrei prestare attenzione?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006461
    m_Localized: Un Visitatore seminudo ha massacrato un'intera pattuglia.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006462
    m_Localized: Continuano ad arrivare Visitatori, ma ho un fucile in casa.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006463
    m_Localized: La FEMA sta portando via le persone e non si sa se torneranno.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006464
    m_Localized: 'Vigilante: Solo uno? Ed è seminudo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006465
    m_Localized: 'Vigilante: Quindi, non indossa alcun tipo di protezione?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006466
    m_Localized: 'Vigilante: Interessante... L''hai visto per davvero?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006467
    m_Localized: 'Vigilante: Ma sì, ti credo. Non hai l''aria di qualcuno che ha l''abitudine di diffondere pettegolezzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006468
    m_Localized: 'Vigilante: Hai suscitato il mio interesse. Tornerò presto a trovarti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006469
    m_Localized: 'Vigilante: Quindi anche tu stai cercando di mantenere l''ordine, eh? Bene...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200512
    m_Localized: 'Vigilante: Ma non mi fido di te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200513
    m_Localized: 'Vigilante: Devo farlo a modo mio e non ho alcuna intenzione di mollare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200514
    m_Localized: 'Vigilante: Riposa, ora. Ne riparleremo più avanti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200515
    m_Localized: 'Vigilante: Sanno quel che fanno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200516
    m_Localized: 'Vigilante: Hanno i loro metodi per individuare i Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200517
    m_Localized: 'Vigilante: Ma il fatto che tu abbia tirato fuori l''argomento è molto sospetto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200518
    m_Localized: 'Vigilante: Devo verificare una cosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200519
    m_Localized: 'Vigilante: Tornerò presto... Hai suscitato il mio interesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200520
    m_Localized: 'Vigilante: Sono tornato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200521
    m_Localized: 'Vigilante: Dovevo cercare una persona ma non l''ho trovata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200522
    m_Localized: 'Vigilante: Tuttavia, ho controllato alcune case e... questo posto pullula di Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200523
    m_Localized: 'Vigilante: Che la FEMA abbia abbandonato la città? O solo questo isolato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200524
    m_Localized: Come riconosci un Visitatore?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200525
    m_Localized: E se un Visitatore mostra solo uno o due segni?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200526
    m_Localized: 'Vigilante: Nello stesso modo con cui lo fai tu, immagino.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200527
    m_Localized: 'Vigilante: La TV e la radio lo hanno spiegato nel dettaglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200528
    m_Localized: 'Vigilante: Mi basta un solo segno per farli fuori. Non esito nemmeno un secondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200529
    m_Localized: 'Vigilante: E visto che sono qui... Dimmi, hai visto un tipo tarchiato che indossa un giacchetto di jeans blu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200530
    m_Localized: 'Vigilante: Ha una bambina. Non so quanti anni abbia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200531
    m_Localized: 'Vigilante: Sua moglie... Beh, fanculo la moglie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200532
    m_Localized: La sua casa è andata a fuoco. Non lo vedo da allora.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200533
    m_Localized: È morto. Solo la bambina è sopravvissuta.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200534
    m_Localized: 'Vigilante: Allora si somministra giustizia, il più rapidamente possibile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200535
    m_Localized: 'Vigilante: I Visitatori approfittano della debolezza dei cuori più teneri. È così che le persone vengono uccise nelle loro stesse case.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200536
    m_Localized: 'Vigilante: E visto che sono qui... Dimmi, hai visto un tipo tarchiato che indossa un giacchetto di jeans blu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200537
    m_Localized: 'Vigilante: Ha una bambina. Non so quanti anni abbia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200538
    m_Localized: 'Vigilante: Sua moglie... Beh, fanculo la moglie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200539
    m_Localized: La sua casa è andata a fuoco. Non lo vedo da allora.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200540
    m_Localized: È morto. Solo la bambina è sopravvissuta.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200541
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200542
    m_Localized: 'Vigilante: Uhm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200543
    m_Localized: 'Vigilante: Dimostrami che non sei uno di loro. Qualunque parte del corpo andrà bene.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200544
    m_Localized: 'Vigilante: Hai un fucile? Come se mi importasse. Vorrà dire che ci ammazzeremo in uno scontro a fuoco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200545
    m_Localized: (Mostra i denti)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200546
    m_Localized: (Mostra le mani)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200547
    m_Localized: (Mostra gli occhi)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200548
    m_Localized: (Mostra le ascelle)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200549
    m_Localized: (Mostra una foto)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200550
    m_Localized: (Mostra le orecchie)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200551
    m_Localized: 'Vigilante: Apri di più la porta. Avanti, non fartela addosso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200552
    m_Localized: 'Vigilante: Uhm... nulla di anomalo. Peccato, davvero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200553
    m_Localized: 'Vigilante: E va bene. Puoi vivere... per ora. Ma al minimo segno, ti pianto una pallottola in mezzo agli occhi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200554
    m_Localized: 'Vigilante: Merda, non ho tempo per queste stronzate. Ho faccende più importanti di cui occuparmi. Alla prossima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200555
    m_Localized: 'Vigilante: Niente di anomalo... Ma certo, figuriamoci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200556
    m_Localized: 'Vigilante: Lascia che ti dica una cosa: i tizi che sembrano normali? Sono sempre i primi a cambiare.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200557
    m_Localized: 'Vigilante: Ma ora non ho tempo per queste stronzate. Ti controllerò meglio la prossima volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200558
    m_Localized: 'Vigilante: Forza, usa quelle maledette ditine. SPALANCALI.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200559
    m_Localized: 'Vigilante: Ah, non mostri alcun segno, eh? Fantastico... Proprio fantastico, cazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200560
    m_Localized: 'Vigilante: Ti rendi conto di cosa è capace un solo Visitatore "normale" in una singola notte? Basta un errore e sono tutti morti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200561
    m_Localized: 'Vigilante: Sei a posto... per ora. Ma al minimo segno, ti pianto una pallottola in mezzo agli occhi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200562
    m_Localized: 'Vigilante: Non ora, però. Ho faccende più importanti di cui occuparmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200563
    m_Localized: 'Vigilante: Uff...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200564
    m_Localized: 'Vigilante: Nulla di anomalo, ma questo non significa un cazzo. Questi pazzi riescono sempre a trovare un modo per farmela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200565
    m_Localized: 'Vigilante: Ritieniti fortunato e toglimi le ascelle dalla faccia. Ho faccende più importanti di cui occuparmi. Tornerò.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200566
    m_Localized: 'Vigilante: Una foto? Vuoi mostrarmi la tua aura? Va bene, vediamo quanto sei "pulito".'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200567
    m_Localized: 'Vigilante: Uhm, sembri a posto. Ma ne ho seppelliti troppi che sembravano altrettanto puliti da non cascarci così facilmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200568
    m_Localized: 'Vigilante: La verità? Non me ne frega niente di quella foto. Ho questioni più urgenti. Per ora, puoi vivere. Ti controllerò meglio la prossima volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200569
    m_Localized: 'Vigilante: Le orecchie? Mi prendi per un idiota, cazzo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200570
    m_Localized: 'Vigilante: Se non fosse stato per mio fratello...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200571
    m_Localized: 'Vigilante: Prova a ripetere questa stronzata delle orecchie e ti stendo sul posto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200572
    m_Localized: 'Vigilante: Fanculo, ho faccende più importanti di cui occuparmi. Tornerò presto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200573
    m_Localized: 'Vigilante: Sono tornato, anche se non ho ancora capito bene perché.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200574
    m_Localized: 'Vigilante: Se mio fratello non fosse stato un codardo, avrebbe potuto proteggere sua moglie e sua figlia. Ora chissà dov''è quella mocciosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200575
    m_Localized: Come te la passi?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200576
    m_Localized: Vorresti trovarla?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200577
    m_Localized: 'Vigilante: Come sempre. Avevo anche detto a mio fratello di fare l''uomo, di prendersi cura della sua famiglia. E lui?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200578
    m_Localized: 'Vigilante: Si è tirato indietro come una femminuccia. Ora la sua famiglia sarà sepolta o fatta a pezzi, cazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200579
    m_Localized: 'Vigilante: Come pensi che il mondo sia finito in questo casino? È per colpa di codardi come lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200580
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200581
    m_Localized: 'Vigilante: Ho visto una famiglia, tempo fa. Il padre era un duro. Ha mantenuto la calma, anche con i Visitatori che urlavano alle finestre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200582
    m_Localized: 'Vigilante: Ha fatto uscire la famiglia dalla porta sul retro e sono fuggiti nel bosco. Ho ucciso quei mostri, ma loro non sono più tornati.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200583
    m_Localized: 'Vigilante: Pensavo fossero morti, ma giorni dopo mi hanno trovato. La prima a uscire dagli alberi? Sua figlia, fucile in pugno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200584
    m_Localized: 'Vigilante: Con gli occhi spiritati, ma viva. È questo ciò che rispetto, non mio fratello. Fosse morto, la sua famiglia avrebbe potuto farcela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200585
    m_Localized: 'Vigilante: Comunque, basta chiacchiere. Facciamo un controllo, dimostrami che non sei uno di loro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200586
    m_Localized: (Mostra i denti)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200587
    m_Localized: (Mostra le mani)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200588
    m_Localized: (Mostra gli occhi)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200589
    m_Localized: (Mostra le ascelle)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200590
    m_Localized: (Mostra una foto)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200591
    m_Localized: (Mostra le orecchie)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200592
    m_Localized: 'Vigilante: Inutile cercare, è una perdita di tempo. Se mio fratello avesse avuto la spina dorsale, avrebbe avuto una possibilità.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200593
    m_Localized: 'Vigilante: Ma ora? Non me ne frega più niente. Ho chiuso con questa storia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200594
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200595
    m_Localized: 'Vigilante: C''era questa famiglia alla periferia della città. Barricati in casa, con il padre che difendeva la porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200596
    m_Localized: 'Vigilante: Ma la moglie... mostrava dei segni. Continuava a pregarmi di non farle del male, di lasciarla in pace...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200597
    m_Localized: 'Vigilante: Quando i Visitatori sono saliti sul tetto, l''idiota ha aperto la porta per farla fuggire. Così ho fatto quello che sarebbe spettato a lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200598
    m_Localized: 'Vigilante: Prima ho ucciso lei, poi lui. I bambini sono riusciti a scappare con i vicini, in qualche modo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200599
    m_Localized: 'Vigilante: Quando è arrivata la FEMA, parlando di "pulizia", ho detto loro di non preoccuparsi, che era già stata fatta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200600
    m_Localized: 'Vigilante: Hanno riso tutti, dicendo che avrei dovuto arruolarmi. Col cazzo! Sanno solo trascinare via la gente, ma i Visitatori sono ancora qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200601
    m_Localized: 'Vigilante: Comunque, basta chiacchiere. Facciamo un controllo, dimostrami che non sei uno di loro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200602
    m_Localized: (Mostra i denti)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200603
    m_Localized: (Mostra le mani)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200604
    m_Localized: (Mostra gli occhi)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200605
    m_Localized: (Mostra le ascelle)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200606
    m_Localized: (Mostra una foto)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200607
    m_Localized: (Mostra le orecchie)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200608
    m_Localized: 'Vigilante: Apri quella dannata bocca. Spalancala. Non sono il tuo cazzo di dentista.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200609
    m_Localized: 'Vigilante: Ok, sembra tutto a posto. Ma sinceramente? Sarebbe stato meglio se non lo fosse stato. Meno problemi futuri per entrambi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200610
    m_Localized: 'Vigilante: Ma non montarti la testa. Un solo errore e sei finito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200611
    m_Localized: 'Vigilante: Basta chiacchiere. Sto perdendo solo tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200612
    m_Localized: 'Vigilante: Che aspetti? Sbrigati. Non mordo mica, a meno che non sia costretto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200613
    m_Localized: 'Vigilante: Uhm... Sporche o pulite, per me non fa differenza. I Visitatori riescono comunque a mimetizzarsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200614
    m_Localized: 'Vigilante: Non ho tempo per queste stronzate, ora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200615
    m_Localized: 'Vigilante: Spalanca quegli occhi e smettila con i giochetti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200616
    m_Localized: 'Vigilante: Ok, sembrano a posto. Ma non significa che puoi sentirti al sicuro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200617
    m_Localized: 'Vigilante: Sei libero di andare... per ora. Non ho tempo per queste stronzate.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200619
    m_Localized: 'Vigilante: Mi prendi per il culo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200620
    m_Localized: 'Vigilante: Se lì sotto sta crescendo qualcosa, preferisco non saperlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200621
    m_Localized: 'Vigilante: Vaffanculo. Non ti annuserò le ascelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200622
    m_Localized: 'Vigilante: Ancora con queste stronzate?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200623
    m_Localized: 'Vigilante: Sembra a posto, ma lo stesso si poteva dire di almeno la metà dei traditori che ho seppellito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200624
    m_Localized: 'Vigilante: Sinceramente? Non me ne frega un cazzo della tua dannata foto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200626
    m_Localized: 'FatalDame: Come va la tua nuova vita, tesoro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200627
    m_Localized: 'FatalDame: Ti sei già abituato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200628
    m_Localized: 'FatalDame: Che domanda sciocca... In fondo, vivi qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200629
    m_Localized: Sembri... diversa.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200630
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200631
    m_Localized: 'FatalDame: L''hai notato, eh? Grazie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200632
    m_Localized: 'FatalDame: Ti piace ciò che vedi, tesoro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200633
    m_Localized: 'FatalDame: La gente non fa che commentare il mio aspetto fisico, persino più di prima.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200634
    m_Localized: 'FatalDame: Non sei un tipo loquace, vero? Raccontami qualcosa di te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200635
    m_Localized: Preferirei di no.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200636
    m_Localized: Un tempo pregavo che mio padre morisse. Ti basta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200637
    m_Localized: Non sono mai stato granché con la gente e questo non cambierà ora.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200638
    m_Localized: 'FatalDame: Oh, così mi ferisci!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200639
    m_Localized: 'FatalDame: Qualcosa ti ha turbato? Tua moglie ti ha appena lasciato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200640
    m_Localized: 'FatalDame: Forse i Visitatori hanno ucciso qualcuno che ti era caro, facendoti chiudere a riccio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200641
    m_Localized: 'FatalDame: O si tratta della tua infanzia? Sarà stato un periodaccio, scommetto. I ricordi sono tornati a galla? Poverino...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200642
    m_Localized: 'FatalDame: Raccontami di te, tesoro. Sono solo una sconosciuta alla tua porta. Potremmo non rivederci mai più.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200643
    m_Localized: Preferirei di no.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200644
    m_Localized: Un tempo pregavo che mio padre morisse. Ti basta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200645
    m_Localized: Non sono mai stato granché con la gente e questo non cambierà ora.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200646
    m_Localized: 'FatalDame: Magari aprirti ti aiuterà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200647
    m_Localized: 'FatalDame: Ma non mi metterò certo a tirarti fuori le parole di bocca con una pinza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200648
    m_Localized: 'FatalDame: Uhm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200649
    m_Localized: 'FatalDame: Posso offrirti qualcosa che molti non potrebbero...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200650
    m_Localized: 'FatalDame: Sono tutti ossessionati dalla fine del mondo, ormai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200651
    m_Localized: 'FatalDame: Ma anche le anime più solitarie necessitano di... un certo tipo di attenzioni, ogni tanto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200652
    m_Localized: 'FatalDame: Fammi entrare e te le darò... Ti farò provare qualcosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200653
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200654
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200655
    m_Localized: 'FatalDame: Avevi un padre violento? È terribile. Sono felice che sia ormai acqua passata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200656
    m_Localized: 'FatalDame: Liberarsi dalla rabbia è difficile. Perdonare lo è ancora di più.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200657
    m_Localized: 'FatalDame: Ti capisco meglio di quanto credi, tesoro. Potremmo parlarne... se ti va.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200658
    m_Localized: 'FatalDame: E inoltre...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200659
    m_Localized: 'FatalDame: Se mi farai entrare, potremmo persino affrontare il dolore... e guarire, insieme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200660
    m_Localized: 'FatalDame: Tutti abbiamo bisogno di un minimo di sollievo, di questi tempi. Di qualche attenzione... Di affetto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200661
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200662
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200663
    m_Localized: 'FatalDame: Capisco. Non sono in molti a saper ascoltare senza fare confronti con i loro tristi aneddoti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200664
    m_Localized: 'FatalDame: Relazionarsi con gli altri è difficile. Non sei l''unico in difficoltà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200665
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200666
    m_Localized: 'FatalDame: Potrei aiutarti, se vuoi, tesoro. Potresti fare pratica con me.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200667
    m_Localized: 'FatalDame: Magari potremmo provare a relazionarci... insieme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200668
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200669
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200670
    m_Localized: 'FatalDame: Scappiamo insieme dagli orrori di questo mondo... Solamente io e te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200671
    m_Localized: 'FatalDame: Sono sicura che potremmo occupare il nostro tempo con... qualcosa di meglio della paranoia e l''autocommiserazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200672
    m_Localized: 'FatalDame: Non mi aspettavo nulla di diverso da te.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200673
    m_Localized: 'FatalDame: Credi che affrontare la fine del mondo da solo renda le cose più facili?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200674
    m_Localized: 'FatalDame: Beh... lui la pensa diversamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633026
    m_Localized: 'BigLebowski: Sei proprio come mio padre.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633027
    m_Localized: 'BigLebowski: Fanculo, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633028
    m_Localized: 'BigLebowski: Agh, lascia perdere. Hai già {0} nel punto che tiene insieme la casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633029
    m_Localized: 'BigLebowski: Se devo rimanere, sono io a giudicare.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633030
    m_Localized: 'BigLebowski: Ho anche fatto la rima. Più o meno.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633031
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633032
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633033
    m_Localized: 'BigLebowski: Ottimo!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633034
    m_Localized: 'BigLebowski: Tsk... Come ti pare.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633035
    m_Localized: 'BigLebowski: Colpa mia che ho perso tempo con te...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077071142912
    m_Localized: 'Theorist: Splendido!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114432
    m_Localized: 'Theorist: Ma... aspetta un secondo. Chi è là?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114433
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114434
    m_Localized: 'Theorist: Oh, no, no... Assolutamente no.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114435
    m_Localized: 'Theorist: Hai in casa... {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114436
    m_Localized: 'Theorist: Non rivelerò nulla con certa gente nei paraggi!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114437
    m_Localized: 'Theorist: In tal caso, non posso accettare il tuo invito a entrare!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114438
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114439
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114440
    m_Localized: 'Theorist: Hai fatto la scelta giusta! Credimi, non te ne pentirai.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114441
    m_Localized: 'Theorist: Vedrai, dopo che avremo parlato, il mondo non ti sembrerà più lo stesso!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114442
    m_Localized: 'Theorist: In che senso "dovrei andarmene"?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114443
    m_Localized: 'Theorist: Tu... Tu...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114444
    m_Localized: 'Theorist: Solo una mente ottusa volterebbe le spalle alla verità con tale semplicità!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114445
    m_Localized: 'Theorist: Addio! In ogni caso, dubito che durerai a lungo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114446
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114447
    m_Localized: 'Wifefema: Ma che diavolo... Tieni {0} dentro casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114448
    m_Localized: 'Wifefema: Conosco bene gente del genere. Non dovresti farla entrare, tesoro. Porta solo guai.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114449
    m_Localized: 'Wifefema: Ti conviene prendere provvedimenti, prima che sia troppo tardi!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114450
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114451
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114452
    m_Localized: 'Wifefema: Bravo, non c''è posto in questa casa per gli scrocconi!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114453
    m_Localized: 'Wifefema: Stai dicendo sul serio?! Mio marito lavora alla FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114454
    m_Localized: 'Wifefema: Che cazzo di problemi hai? Ti racconto tutto e tu mi tratti di merda?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114455
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114456
    m_Localized: 'Wifefema: Sai che ti dico? Vaffanculo. Andrò a parlare con i tuoi vicini. Ciao ciao, stronzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114457
    m_Localized: 'Raskolnikov: Oh, diamine... Non vorrei sembrare scortese, ma vedo che ospiti {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114458
    m_Localized: 'Raskolnikov: Io... non posso vivere con gente del genere. Ci ho provato, ma... non funziona.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114459
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114460
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114461
    m_Localized: 'Raskolnikov: Grazie, amico.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114462
    m_Localized: 'Raskolnikov: E se non è chiedere troppo, ehm... dopo avermi testato, ovviamente...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114463
    m_Localized: 'Raskolnikov: Potresti mostrarmi come si fa? A uccidere un Visitatore, intendo. V‑Voglio guardare la morte negli occhi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114464
    m_Localized: 'Raskolnikov: Oh, diamine... Non volevo metterti in difficoltà.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114465
    m_Localized: 'Raskolnikov: Non devi cacciare qualcuno che ritieni importante. Non avrei dovuto neanche chiedertelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114466
    m_Localized: 'Raskolnikov: Spero solo che... un giorno imparerò a difendermi... A uccidere.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503040
    m_Localized: 'Nun: Ospiti dei miscredenti in casa, non è vero? Tipo {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503041
    m_Localized: 'Nun: Non basta una vita intera per espiare certi peccati! Non dovresti dare retta al diavolo e frequentare gente del genere!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503042
    m_Localized: 'Nun: Purificati dal male e sarai benedetto, figliolo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503043
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503044
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503045
    m_Localized: 'Nun: Che il cielo sia lodato...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503046
    m_Localized: 'Nun: Signore, abbi pietà...! Ti viene offerta una preziosa occasione di salvezza e tu la rifiuti. Vergogna!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503047
    m_Localized: 'Nun: La mia morte graverà sulla tua anima. Ricorda le mie parole.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503048
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503049
    m_Localized: 'Nun: Quando ti presenterai davanti al Signore, lui ricorderà le tue azioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503050
    m_Localized: 'Fugitive: Non posso... Senti, amico, ho già incontrato persone come {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503051
    m_Localized: 'Fugitive: Se ne stanno tranquille a farsi gli affari propri... finché non ti spingono sotto un autobus senza battere ciglio.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503052
    m_Localized: 'Fugitive: Gente del genere aspetta solo il momento giusto per tradirti.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503053
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503054
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503055
    m_Localized: 'Fugitive: Mi hai salvato la vita, cazzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503056
    m_Localized: 'Fugitive: Spero che i tuoi vicini non siano dei maledetti delinquenti...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503057
    m_Localized: 'Fugitive: Mi prendi per il culo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503058
    m_Localized: 'Fugitive: Che c''è, hai paura che la FEMA venga a cercarmi? Sei solo una femminuccia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503059
    m_Localized: 'Fugitive: E va bene, nasconditi dietro la tua stupida porticina. Vediamo se ti proteggerà.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503060
    m_Localized: 'Fugitive: Passa una bella serata, stronzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503061
    m_Localized: 'Bestson: Vedo che il tuo divano è già occupato. Le persone come {0}... mi spaventano.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503062
    m_Localized: 'Bestson: Una volta, al parco, sono stato aggredito da qualcuno del genere. Da allora non ci ho più messo piede!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503063
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503064
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503065
    m_Localized: 'Bestson: Grazie! Se solo riuscissi a... smettere di preoccuparmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503066
    m_Localized: 'Bestson: E se i miei genitori tornassero a casa e io non ci fossi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503067
    m_Localized: 'Bestson: Ma... forse sarebbe meglio se restassi qui con te, per ora. Sembra l''opzione più sicura.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503068
    m_Localized: 'Bestson: Sì, forse è la cosa migliore da fare. Andrò a casa, nel caso dovessero tornare...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503069
    m_Localized: 'Buddy: Oh oh, amico... Sembra che qualcuno sia arrivato prima di me.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503070
    m_Localized: 'Buddy: Sono favorevole alla condivisione, ma questo posto mi sembra affollato... Ti dispiacerebbe farmi un pochino di spazio?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503071
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503072
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503073
    m_Localized: 'Buddy: Grazie, amico! Sei il mio angelo custode!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697344
    m_Localized: 'Fatman: Tsk, ospiti {0} in casa tua...? No, no, no! Non ho intenzione di litigare per una stupida vasca da bagno!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697345
    m_Localized: 'Fatman: Preferirei se, ecco... ti occupassi della questione in altro modo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697346
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697347
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697348
    m_Localized: 'Fatman: Molto bene, hai fatto la scelta giusta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697349
    m_Localized: 'Fatman: Verrai ricompensato... non appena tutto questo sarà finito.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697350
    m_Localized: 'Fatman: Chiedo scusa? Sono in pessime condizioni e oltretutto sono anche un ministro!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697351
    m_Localized: 'Fatman: Dove diavolo dovrei andare, eh? Sono spacciato... Sì, sono spacciato, cazzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697352
    m_Localized: 'Blind: Sento che ospiti {0}... Ne percepisco l''aura negativa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697353
    m_Localized: 'Blind: Mi spiace, ma... non saprei in che altro modo spiegarlo. È così e basta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697354
    m_Localized: 'Blind: Sarà meglio che trovi un altro posto dove andare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697355
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697356
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697357
    m_Localized: 'Blind: Grazie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697358
    m_Localized: 'Blind: Me ne andrò, ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697359
    m_Localized: 'Blind: Per il tuo bene, non avvicinarti ai corpi carbonizzati di notte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697360
    m_Localized: 'Blind: O QUELLA COSA ti troverà.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697361
    m_Localized: 'Dude: Yooo... Ehi, aspetta un attimo...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697362
    m_Localized: 'Dude: Ospiti {0} in casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697363
    m_Localized: 'Dude: No, non ci siamo, amico. L''atmosfera così è totalmente rovinata.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697364
    m_Localized: 'Dude: Che seccatura... Devi liberartene, amico!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697365
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697366
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697367
    m_Localized: 'Dude: Bravo, amicooo! Sapevo che avresti capito!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697368
    m_Localized: 'Dude: Ma, ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697369
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697370
    m_Localized: 'Dude: Va bene, fra, capisco. Nessun rancore.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697371
    m_Localized: 'Dude: Abbi cura di te, amico mio... e dei tuoi coinquilini.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697372
    m_Localized: 'Teacher: Scusa, ma... hai fatto entrare {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697373
    m_Localized: 'Teacher: Io... non posso condividere lo stesso tetto con gente del genere.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697374
    m_Localized: 'Teacher: Mi ricorda quelle persone che... che... I bambini...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697375
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697376
    m_Localized: 'Teacher: Mi dispiace...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697377
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697378
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697379
    m_Localized: 'Teacher: Grazie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891648
    m_Localized: 'Ballerina: Tu... hai {0} in casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891649
    m_Localized: 'Ballerina: Uhm... È sbagliato. Libera casa, riporta ordine.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891650
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891651
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891652
    m_Localized: 'Ballerina: Andiamo, gattino. Ora si scorrazza, sì?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891653
    m_Localized: 'Ballerina: Vedi, batuffolo di pelo? Non te, brutto idiota.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891654
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891655
    m_Localized: 'Ballerina: Vedi, batuffolo di pelo? Scelte sbagliate.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891656
    m_Localized: 'Mother: Uhm, hai accolto {0}. La mia bambina è già abbastanza spaventata così...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891657
    m_Localized: 'Mother: Magari potresti, ecco... farci spazio? In modo che la bambina possa dormire tranquilla, per una buona volta?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891658
    m_Localized: Entrate, vi libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891659
    m_Localized: Dovreste andarvene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891660
    m_Localized: 'Mother: Finalmente...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891661
    m_Localized: 'Mother: Forza, non rimanere qui impalata. Entra, il signore non aspetterà per sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891662
    m_Localized: 'Mother: E va bene. Forza, piccola... Vediamo se riusciamo ad arrivare a casa di quello stupido del papà.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891663
    m_Localized: 'Mother: Potrebbe essere già troppo tardi...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891664
    m_Localized: 'Mother: No... No. Possiamo ancora farcela...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891665
    m_Localized: 'Anger: Tieni gente del cazzo come {0} in casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891666
    m_Localized: 'Anger: No, no, non posso condividere lo stesso tetto... Impazzirei.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891667
    m_Localized: 'Anger: Non preoccuparti, non me la prenderò con nessun altro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891668
    m_Localized: 'Anger: E non farò a pezzi la casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891669
    m_Localized: 'Anger: Rivolgo questi pugni solo contro me stesso. Nessuno si farà male.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891670
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891671
    m_Localized: 'Anger: Fanculo, sei patetico come il resto di quei codardi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891672
    m_Localized: 'Anger: Te ne starai lì a subire le loro stronzate fino a morirne soffocato.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891673
    m_Localized: 'Anger: Cazzo... CAZZO!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891674
    m_Localized: 'Couple: Oh, come potremo mai ringraziarti?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891675
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891676
    m_Localized: 'Couple: Ma chi hai fatto entrare in casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891677
    m_Localized: 'Couple: Senti, non è mia intenzione creare problemi, ma... non possiamo stare qui con {0} intorno.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891678
    m_Localized: 'Couple: Mia moglie non ama molto quel genere di persone. Non pensavo di trovare gente così giovane qui...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891679
    m_Localized: Entrate, vi libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891680
    m_Localized: Dovreste andarvene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891681
    m_Localized: 'Couple: Oh, grazie, grazie!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891682
    m_Localized: 'Couple: Perché te ne stai lì impalata, tesoro? Su, questo signore gentile ci ha invitati a entrare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891683
    m_Localized: 'Couple: Sei sempre così timida! Non preoccuparti, presto potrai riposare come si deve, tesoro!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891684
    m_Localized: 'Couple: Ho capito. Chiedo scusa per il disturbo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891685
    m_Localized: 'Couple: Continueremo a cercare. Vero, tesoro?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891686
    m_Localized: 'Couple: Forza, muovi quelle dannate gambe. Anch''io sono stanco!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891687
    m_Localized: 'Luka: Mi piacerebbe molto entrare, ma in casa hai già {0}...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891688
    m_Localized: 'Luka: Senti, mi dispiacerebbe mandare via qualcuno e capisco che di questi tempi abbiamo tutti bisogno di un riparo, ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891689
    m_Localized: 'Luka: Apprezzerei molto se potessi liberare spazio per me...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891690
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891691
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891692
    m_Localized: 'Luka: Grazie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891693
    m_Localized: 'Luka: Spero che ti ricorderai com''era essere felici.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891694
    m_Localized: 'Luka: Forse, allora... la morte non sarà il tuo unico pensiero.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891695
    m_Localized: 'Luka: Non seppellirti nel tuo dolore.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891696
    m_Localized: 'Luka: Se rimugini troppo, finirà per divorarti vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891697
    m_Localized: 'Luka: E a quel punto, beh... le cose possono prendere velocemente una brutta piega.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891698
    m_Localized: 'Luka: Abbi cura di te, ok?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085952
    m_Localized: 'FortuneTeller: Oh... Riesco a sentirla... Un''aura densa e opprimente. Un''ombra... così forte da avvelenare l''intera casa! Sventura!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085953
    m_Localized: 'FortuneTeller: Vedo... {0}. Ti dice qualcosa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085954
    m_Localized: 'FortuneTeller: Se non ti liberi di quell''influenza negativa, le stelle si allineeranno in modo disastroso. Capisci?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085955
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085956
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085957
    m_Localized: 'FortuneTeller: Magnifico... A dirla tutta, possiedi un raro spazio metafisico nel tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085958
    m_Localized: 'FortuneTeller: C''è una potente corrente di energia positiva che scorre attraverso la tua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280256
    m_Localized: 'Fanatic: Umano! Non posso entrare nello stesso luogo che ospita {0}. È IL SOLE A DECRETARLO!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280257
    m_Localized: 'Fanatic: Un''ombra del genere non fa che oscurare la luce della giustizia! Fuori! Fuori...!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280258
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280259
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280260
    m_Localized: 'Fanatic: BEN FATTO, UMANO! La benedizione dei raggi sacri risplenderà nei tuoi OCCHI.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280261
    m_Localized: 'Fanatic: Ora, dov''è il frigo...?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280262
    m_Localized: 'Fanatic: Allora vaffanculo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280263
    m_Localized: 'Fanatic: Solo i MALVAGI ABITANTI DEL SOTTOSUOLO tengono chiuse le porte alla luce... Anzi, all''ILLUMINAZIONE!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280264
    m_Localized: 'Fanatic: Condividerò i raggi splendenti della mia conoscenza con qualcun altro! Addio, stronzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280265
    m_Localized: 'Hunter: Uhm... Hai già {0} in casa, ragazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280266
    m_Localized: 'Hunter: Non capisco perché hai fatto entrare delle mani sporche di sangue. Sento l''odore da qui. Ami il rischio, per caso?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280267
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280268
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280269
    m_Localized: 'Hunter: Ottima decisione, ragazzo. So cosa sto facendo. Posso aiutarti se quella... cosa dovesse presentarsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280270
    m_Localized: 'Anxiety: H‑Hai già... {0}... in casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280271
    m_Localized: 'Anxiety: Non posso rischiare di ritrovarmi insieme a dei possibili Visitatori...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280272
    m_Localized: 'Anxiety: Potresti verificare i segni, o...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280273
    m_Localized: 'Anxiety: Liberare, ehm... la casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280274
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280275
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280276
    m_Localized: 'Anxiety: Grazie. Me ne starò seduta in silenzio da una parte. Non chiudere la porta, però, ok? Eh eh... Così, per scrupolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280277
    m_Localized: 'Anxiety: Ok, ah ah... Va bene, me ne vado. Il sole ci ucciderà comunque... Moriremo tutti...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280278
    m_Localized: 'Esenin: Parleremo quando avrai liberato la casa. Intendo {0}...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280279
    m_Localized: 'Esenin: Gente del genere è stata cacciata dal locale ben prima di me.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280280
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280281
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280282
    m_Localized: 'Esenin: Beh, almeno oggi qualcosa è andato per il verso giusto. Fammi strada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280283
    m_Localized: 'Esenin: Ah, sì? Beh, vaffanculo. Scommetto che sei quel tipo di uomo che ordina acqua al pub.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280284
    m_Localized: 'Cold: G‑Grazie, ma... non entrerò in casa finché ospiterai {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280285
    m_Localized: 'Cold: H‑Ho... paura a condividere la stanza con altre persone. Succede sempre qualcosa di spiacevole. Sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280286
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280287
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280288
    m_Localized: 'Cold: G‑Grazie. Credimi, è meglio così.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280289
    m_Localized: 'Cold: C‑Capisco. Me ne vado, allora...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280290
    m_Localized: 'Cold: D‑Da qualche parte... lontano da tutti...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280291
    m_Localized: 'Cold: F‑Forse il sole mi s‑scalderà un''ultima volta...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280292
    m_Localized: 'Scammer: Sarò sincero con te, ok? Non posso condividere la casa con gente inutile come {0}, fra.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280293
    m_Localized: 'Scammer: Libera spazio e siamo a posto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280294
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280295
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280296
    m_Localized: 'Scammer: Fantastico! Passa da me quando hai un attimo, ok? Ho delle storie incredibili da raccontarti.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280297
    m_Localized: 'Scammer: Fanculo, sapevo che non saremmo andati d''accordo. Non frequento le femminucce.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280298
    m_Localized: 'Scammer: Chi se ne frega. Ci sono un sacco di idioti in giro. Pace, figlio di puttana!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474560
    m_Localized: 'Daughter: I‑Io... v‑vedo che non c''è posto per me.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474561
    m_Localized: 'Daughter: Hai con te {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474562
    m_Localized: 'Daughter: Ma... voglio sedermi io lì! Per favore! È lì che... si metteva sempre papà...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474563
    m_Localized: 'Daughter: Voglio il mio papinooo...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474564
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474565
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474566
    m_Localized: 'Daughter: PAPÀ! PAPINOOO!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474567
    m_Localized: 'Daughter: ANDARMENE DOVE?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474568
    m_Localized: 'Daughter: I‑Io... n‑non conosco n‑nessun altro...!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474569
    m_Localized: 'Daughter: H‑Ho... t‑tanta PAURAAA...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474570
    m_Localized: 'Daughter: AAAAAAAAAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474571
    m_Localized: 'NotTrue: Oh, santo cielo! Sembra che la mia sedia sia occupata, c''è {0}...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474572
    m_Localized: 'NotTrue: Con mele marce del genere, la situazione si complicherà in un batter d''occhi, giovanotto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474573
    m_Localized: 'NotTrue: Mi riposerò un attimo, riprenderò fiato, poi me ne andrò per la mia strada, se non ti dispiace.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474574
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474575
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474576
    m_Localized: 'NotTrue: Oh, grazie mille, giovanotto! Peccato solo che tu abbia dovuto cacciare via qualcuno per una vecchia come me...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474577
    m_Localized: 'NotTrue: Beh, potresti essere così gentile da rimediare uno sgabello per questa vecchia signora?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474578
    m_Localized: 'NotTrue: Riposerò le mie stanche ossa, poi me ne andrò per la mia strada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668866
    m_Localized: 'Doctor: Uhm, vedo che ospiti {0}...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668867
    m_Localized: 'Doctor: Io non posso fornire cure adeguate.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668868
    m_Localized: 'Doctor: Sarebbe meglio se trovasse qualcuno in grado di dare una mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668869
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668870
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668871
    m_Localized: 'Doctor: Grazie, spero che potrò essere d''aiuto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668872
    m_Localized: 'Doctor: Capisco... Non è facile fidarsi, in questo momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668873
    m_Localized: 'Doctor: Sarò nei paraggi, quindi non esitare a chiedere in caso di bisogno.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668874
    m_Localized: 'Foreigner: Mmmngh... Pffft!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668875
    m_Localized: 'Foreigner: (Indica {0}, poi sé stesso, poi fa un segno di disapprovazione)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668876
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668877
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668878
    m_Localized: 'Foreigner: (Annuisce ed entra)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668879
    m_Localized: 'Edgar: Entrerei... se non avessi già {0} in casa. Non sopporto chi si aggrappa disperatamente al pensiero di un domani.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668880
    m_Localized: 'Edgar: Sono venuto per ascoltare la silenziosa foschia del crepuscolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668881
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668882
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668883
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668884
    m_Localized: 'Edgar: Non so ancora se vedi la bellezza come la vedo io, ma dimmi... tu non getti via i corpi, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668885
    m_Localized: 'Edgar: Tieni il mio, quando arriverà la mia ora.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863168
    m_Localized: 'TaxiDriver: Senti, non fraintendermi, ma... hai {0} in casa, vero?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863169
    m_Localized: 'TaxiDriver: Certe presenze mi ricordano quelle persone che davano la caccia alla mia famiglia e...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863170
    m_Localized: 'TaxiDriver: Mi spiace, ma dovrai scegliere chi far restare.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863171
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863172
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863173
    m_Localized: 'TaxiDriver: Uff, grazie, amico. Mi stai salvando la vita, lo sai?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863174
    m_Localized: 'TaxiDriver: Ehm, vieni a fare due chiacchiere quando hai tempo, d''accordo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863175
    m_Localized: 'TaxiDriver: Capisco le tue ragioni, ma accidenti se è dura...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863176
    m_Localized: 'Provocateur: Uhm, vedo che hai già degli inquilini in casa, tipo {0}...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863177
    m_Localized: 'Provocateur: Sei consapevole che è contro la legge ospitare chi per primo la trasgredisce?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863178
    m_Localized: 'Provocateur: Gli articoli 28, 48 e 7.3 della Costituzione non significano nulla per te?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863179
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863180
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863181
    m_Localized: 'Provocateur: È la scelta più sensata, dammi retta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863182
    m_Localized: 'Provocateur: Discuteremo dei termini del contratto di locazione più tardi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863183
    m_Localized: 'Marauder: Oh, ma guarda... Quel posticino accogliente è già occupato.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863184
    m_Localized: 'Marauder: Vedi {0}, proprio lì?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863185
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863186
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863187
    m_Localized: 'Marauder: Ora ci capiamo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863188
    m_Localized: 'Marauder: Dannazione, pensavo di poter tirare un sospiro di sollievo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863189
    m_Localized: 'Marauder: Eh, valeva la pena tentare...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863190
    m_Localized: 'GraveDigger: Ah, vedo che hai già {0} qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863191
    m_Localized: 'GraveDigger: Sarei entrato, davvero, ma... beh... hai capito, no?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863192
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863193
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863194
    m_Localized: 'GraveDigger: Ah, grazie!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863195
    m_Localized: 'FormerFema: Eh? Oh, grazie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863196
    m_Localized: 'FormerFema: Uhm, aspetta un attimo...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863197
    m_Localized: 'FormerFema: O‑Oh... Vedo che il bagno è occupato, c''è {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863198
    m_Localized: 'FormerFema: Senti, sono giorni che indosso questa dannata tuta. Voglio solo togliermela, lavarmi via lo sporco e... il sangue.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863199
    m_Localized: 'FormerFema: Se mi liberi il bagno, giuro che me ne starò buono e tranquillo. Non darò fastidio a nessuno.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863200
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863201
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863202
    m_Localized: 'FormerFema: Dici sul serio?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863203
    m_Localized: 'FormerFema: Non credevo che mi avresti lasciato entrare davvero.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863204
    m_Localized: 'FormerFema: D''accordo, capisco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863205
    m_Localized: 'FormerFema: Suppongo che la tuta metta in soggezione.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863206
    m_Localized: 'FormerFema: Non so neanche perché ancora la indosso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863207
    m_Localized: 'FormerFema: Addio.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863208
    m_Localized: 'Intruder:  Entrerei volentieri...se qualcuno non avesse già occupato il mio posto. Guarda, {0} è proprio lì. '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863209
    m_Localized: 'Intruder: Questa casa non è abbastanza grande per tutti e due.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863210
    m_Localized: 'Intruder: Incontrare gente del genere in sogno mi è bastato, credimi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863211
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863212
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863213
    m_Localized: 'Intruder: Spero solo di poter finalmente dormire...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446720741376
    m_Localized: 'Wifefema: Ascolta, ho un fiuto incredibile per la gente losca e i Visitatori. Nessuno li individua facilmente come me.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518592
    m_Localized: 'Wifefema: Facciamo uno scambio... {0} a te, libero accesso per me. Ci stai?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518593
    m_Localized: 'Wifefema: Non ti interessa? Una parola di mio marito e domattina piomberanno qui dei tizi in giallo per un controllo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518594
    m_Localized: 'Wifefema: Mandati di quarantena, cani... e torneranno ogni giorno. Se vuoi evitarlo, ti basterà farmi entrare.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518595
    m_Localized: D'accordo, entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518596
    m_Localized: Non intendo farmi corrompere.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518597
    m_Localized: 'Wifefema: Hai voglia di restarci secco? Mio marito lavora alla FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518598
    m_Localized: 'Wifefema: Ma che problemi hai? Io metto a nudo la mia anima e tu la calpesti così?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518599
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518600
    m_Localized: 'Wifefema: Sai che ti dico? Vaffanculo. Chiederò ospitalità a uno dei tuoi vicini. Alla prossima, testa di cazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518601
    m_Localized: 'Fugitive: Senti, se non mi fai entrare e non mi aiuti a medicarmi morirò dissanguato davanti alla tua porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518602
    m_Localized: 'Fugitive: Dai, amico... Sono pronto a darti qualunque cosa. Uhm... Quest''imperdibile {0}? Che ne dici? Non ho altro con me.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518603
    m_Localized: 'Fugitive: Ti prego... Morirò se non mi lasci entrare!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518604
    m_Localized: D'accordo, entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518605
    m_Localized: Non intendo farmi corrompere.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518606
    m_Localized: 'Bestson: Io... non so cosa fare.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518607
    m_Localized: 'Bestson: Forse vorresti qualcosa in cambio? Sei tipo da... {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518608
    m_Localized: 'Bestson: Ho anche delle... gomme da masticare. Non sono molte, ma se vuoi sono tue.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518609
    m_Localized: D'accordo, entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518610
    m_Localized: Non intendo farmi corrompere.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712896
    m_Localized: 'Fatman: E va bene... So perfettamente come funzionano questi giochetti.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712897
    m_Localized: 'Fatman: Guarda, un pensierino da parte mia... Quest''eccellente {0}! Che ne dici?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712898
    m_Localized: 'Fatman: Che ne pensi? Può rendere l''offerta più allettante?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712899
    m_Localized: D'accordo, entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712900
    m_Localized: Non intendo farmi corrompere.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712901
    m_Localized: 'Blind: A‑Aspetta, ti prego... Ho qualcosa per te...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712902
    m_Localized: 'Blind: Quest''imperdibile {0}. Puoi rinunciarci? Mi basterebbe un giorno per riprendermi. Anche se inizio a dubitare di riuscirci...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712903
    m_Localized: D'accordo, entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712904
    m_Localized: Non intendo farmi corrompere.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712905
    m_Localized: 'Dude: Andiamo, fra...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712906
    m_Localized: 'Dude: D''accordo, senti qui... Ho una cosetta che potrebbe interessarti.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712907
    m_Localized: 'Dude: Parola d''ordine... {0}! Proprio come nei videogiochi, no? Bisogna accumulare punti amicizia in qualche modo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712908
    m_Localized: D'accordo, entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712909
    m_Localized: Non intendo farmi corrompere.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712910
    m_Localized: 'Wheelchair: Non vuoi farmi entrare? D''accordo, ho un''idea... Prendi quest''utile {0}. Ci colpisci la porta e BAM! Sei invisibile.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712911
    m_Localized: 'Wheelchair: Garantito al 100%!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712912
    m_Localized: 'Wheelchair: Le mie gambe ne sono la prova, vedi? Le ho fatte sparire! Ah ah!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712913
    m_Localized: D'accordo, entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712914
    m_Localized: Non intendo farmi corrompere.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907200
    m_Localized: 'Couple: Ti prego, amico... Mi dispiace insistere, ma cerca di metterti nei miei panni.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907201
    m_Localized: 'Couple: Mia moglie è molto debole, ultimamente. Si stanca facilmente, e io... farei qualsiasi cosa per lei, capisci?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907202
    m_Localized: 'Couple: La amo così tanto... Ti darei la camicia che indosso se questo potesse garantire la sua sicurezza.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907203
    m_Localized: 'Couple: A proposito...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907204
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907205
    m_Localized: 'Couple: Avrei qualcosa da darti, in effetti... Non è proprio la mia camicia, ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907206
    m_Localized: 'Couple: Che ne dici di quest''eccezionale {0}? Sono disposto a consegnarti tutto ciò che mi resta se questo significa far riposare la mia amata.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907207
    m_Localized: 'Couple: Allora, ci aiuterai?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907208
    m_Localized: E va bene, entrate.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907209
    m_Localized: Non intendo farmi corrompere.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907210
    m_Localized: 'Luka: Va bene! Ma forse... c''è qualcosa che potrei offrirti. Cosa desideri?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907211
    m_Localized: 'Luka: Quest''utile {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907212
    m_Localized: 'Luka: Potrebbe interessarti?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907213
    m_Localized: D'accordo, entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446750101504
    m_Localized: Non intendo farmi corrompere.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490112
    m_Localized: 'Widow: Grazie per l''aiuto. Anche se...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490113
    m_Localized: 'Widow: C''è {0} in casa, o sbaglio...?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490114
    m_Localized: 'Widow: No.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490115
    m_Localized: 'Widow: Non condividerò queste quattro mura con persone del genere.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490116
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490117
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490118
    m_Localized: 'Widow: Grazie, non mi tratterrò a lungo... Ho solo bisogno di un momento per riprendere fiato...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684416
    m_Localized: 'Greatmother: Bene, bene... Ma guarda chi c''è: {0}, non è vero? Ma pensa!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684417
    m_Localized: 'Greatmother: Certa gente non è buona a nulla.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684418
    m_Localized: 'Greatmother: Devi liberarmi spazio, tesoro. Mi ci siedo io lì!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684419
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684420
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684421
    m_Localized: 'Greatmother: Il Signore ti benedica! Altrimenti, non sai in che guai ti saresti cacciato.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878720
    m_Localized: 'Twins: Temo che tu stia già ospitando {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878721
    m_Localized: 'Twins: Ma certi modi di parlare... hanno un effetto negativo su mia sorella.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878722
    m_Localized: 'Twins: E questa è proprio l''ultima cosa di cui ha bisogno. Le serve pace, non giudizi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878723
    m_Localized: Entrate, vi libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878724
    m_Localized: Dovreste andarvene.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878725
    m_Localized: 'Twins: Ospiti {0} in casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878726
    m_Localized: 'Twins: Condividere lo stesso tetto con certa gente è troppo per me...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878727
    m_Localized: 'Twins: Sai, prima di incontrare mio marito, io... Beh, diciamo solo che mi ricorda una persona che conoscevo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878728
    m_Localized: 'Twins: Dubito che andremmo d''accordo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878729
    m_Localized: Entrate, vi libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878730
    m_Localized: Dovreste andarvene.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878731
    m_Localized: 'Twins: Vedo che ospiti in casa sia {0}, sia {1}...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878732
    m_Localized: 'Twins: Una faccenda preoccupante... Mia sorella soffrirebbe molto la loro presenza.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878733
    m_Localized: 'Twins: Mi ricordano molto i nostri... genitori. E non è certo l''ambiente migliore per lei, date le sue condizioni.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878734
    m_Localized: Entrate, vi libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878735
    m_Localized: Dovreste andarvene.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878736
    m_Localized: 'Twins: Uhm... Capisco, non ci conosci. Potresti pensare che causeremo solo problemi. Ma ti prometto che non sarà così.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878737
    m_Localized: 'Twins: La mia sorellina... sta passando un periodaccio. Ma abbiamo con noi... Hai presente?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878738
    m_Localized: 'Twins: Sì, quest''utile {0}! Tieni, prendi. Potrebbe servirti.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878739
    m_Localized: E va bene, entrate.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878740
    m_Localized: Non intendo farmi corrompere.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878741
    m_Localized: 'Wolfhound: Hai {0} ad appestarti casa, vero? Quelli come loro li riconosco a un chilometro di distanza. Lupi travestiti da agnelli.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878742
    m_Localized: 'Wolfhound: Ti conviene fare pulizia se intendi mantenere un minimo di decoro in questo posto, dolcezza.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878743
    m_Localized: Entra, ci penso io.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878744
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878745
    m_Localized: 'Wolfhound: Una scelta molto oculata.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878746
    m_Localized: 'Wolfhound: Ora conta solo il potere, dolcezza. Puoi adeguarti o lasciarti travolgere.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073024
    m_Localized: 'Marauder: Ehi, amico, non cacciarmi via, ti prego... Fammi vedere prima cosa ho nella borsa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073025
    m_Localized: 'Marauder: Un coltello, mi servirà... Bende, certo... Uhm, una vecchia fiaschetta. Vuota, però. Non mi sarà molto utile...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073026
    m_Localized: 'Marauder: Ah, ecco qui! L''immancabile {0}! Tieni, prendi... Mi serve solo un posto dove passare la notte.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073027
    m_Localized: D'accordo, entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073028
    m_Localized: Non intendo farmi corrompere.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073029
    m_Localized: 'GraveDigger: Oh, per l''amor del cielo! Forse posso darti qualcosa in cambio?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073030
    m_Localized: 'GraveDigger: Cosa vorresti per farmi entrare?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073031
    m_Localized: 'GraveDigger: Quest''interessante {0}? Che ne dici?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073032
    m_Localized: D'accordo, entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073033
    m_Localized: Non intendo farmi corrompere.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267329
    m_Localized: 'Courier: Sai, credevo che la gente avrebbe fatto scorta prima della fine del mondo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267330
    m_Localized: 'Courier: Apocalisse o meno, le persone devono pur mangiare!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267331
    m_Localized: 'Courier: Il settore delle consegne potrebbe risultare redditizio in questo momento, se i rischi non fossero enormi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267332
    m_Localized: 'Courier: Ma questo maledetto sole... Ci hanno spostato tutti al turno di notte pur di evitarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267333
    m_Localized: 'Courier: Ora la gente ordina 20 litri d''acqua alla volta. Vorrei che ci pagassero l''indennità per il trasporto di carichi pesanti...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267334
    m_Localized: 'Courier: Sì, scusa, ero un attimo sovrappensiero. Pronto ad accettare questa consegna?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267335
    m_Localized: (Accetti la consegna)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267336
    m_Localized: 'Courier: {0} in consegna... Effettuata!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267338
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267339
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267340
    m_Localized: 'Courier: Oltretutto, la mia famiglia è lontana. Non sono di qui, ero venuto per studiare all''università. Sono completamente solo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267341
    m_Localized: Stare soli non è male.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267342
    m_Localized: Mi dispiace molto.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267343
    m_Localized: 'Courier: Facile dirlo per te, che ospiti altra gente in casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267344
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267345
    m_Localized: 'Courier: Comunque, lavorare come fattorino non mi dispiace.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267346
    m_Localized: 'Courier: E poi, che senso ha studiare se tanto nessuno mi assumerà mai?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267347
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267348
    m_Localized: 'Courier: D''accordo, ho un ordine da consegnarti. Pronto a riceverlo?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267349
    m_Localized: (Accetti la consegna)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267350
    m_Localized: 'Courier: {0} in consegna... Effettuata!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267352
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267353
    m_Localized: Non preoccuparti, andrà tutto bene.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267354
    m_Localized: Stringi i denti e smettila di piagnucolare.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267355
    m_Localized: 'Courier: Cosa può "andare bene" nel pieno di un cataclisma?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267356
    m_Localized: 'Courier: Tra i Visitatori, i segni e quel maledetto sole...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267357
    m_Localized: 'Courier: Pensavo non potesse andare peggio. E invece, ogni giorno ce n''è una nuova.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267358
    m_Localized: 'Courier: Tra poco annunceranno che i peli pubici sono un segno distintivo dei Visitatori e il mondo andrà fuori di testa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267359
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267360
    m_Localized: 'Courier: Ok, mi sono trattenuto fin troppo. Prendi il tuo ordine, devo andare.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267361
    m_Localized: (Accetti la consegna)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267362
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267363
    m_Localized: 'Courier: Beh, grazie mille per il discorso incoraggiante. Sei una fonte inesauribile di perle di vita.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267364
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267365
    m_Localized: 'Courier: Sai cosa? Prendi la tua dannata consegna, me ne vado.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267366
    m_Localized: (Accetti la consegna)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267367
    m_Localized: 'Courier: {0} in consegna... Effettuata!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267368
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267370
    m_Localized: Non c'è altra soluzione.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267371
    m_Localized: Mi dispiace.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267372
    m_Localized: 'Courier: Ah, capisco... Stai dicendo che è un bene che il mio amico sia stato ucciso?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267373
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267374
    m_Localized: 'Courier: Prendi il tuo ordine e lasciami andare via, prima che ti venga in mente di spararmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267375
    m_Localized: (Accetti la consegna)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267376
    m_Localized: 'Courier: Sigh...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267377
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267378
    m_Localized: 'Courier: Ricordi quando ti dicevo che fare il fattorino mi aiutava a distrarmi? Sembra che non funzioni più.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267379
    m_Localized: 'Courier: Non faccio che vedere facce stanche, cupe, amareggiate...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267380
    m_Localized: 'Courier: Senza contare quegli interminabili controlli mattutini della FEMA che ci punta le pistole contro...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267381
    m_Localized: 'Courier: Che casino...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267382
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267383
    m_Localized: 'Courier: Sono stanco di questo schifo. Vorrei solo che finisse...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267384
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267385
    m_Localized: 'Courier: D''accordo, prendi il tuo ordine. Me ne vado.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267386
    m_Localized: (Accetti la consegna)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267387
    m_Localized: 'Courier: {0} in consegna... Effettuata!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267388
    m_Localized: 'Courier: Buonanotte...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267389
    m_Localized: 'CultistPriest: Tutto esattamente come dovrebbe essere. Tuttavia, devo chiederti di liberarti di alcuni... ospiti indesiderati.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267390
    m_Localized: 'CultistPriest: Come {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267391
    m_Localized: 'CultistPriest: E {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267392
    m_Localized: 'CultistPriest: Persone del genere ostacolano il nostro scopo, e questo non può essere tollerato.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267393
    m_Localized: Va bene, vi libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267394
    m_Localized: Dovreste andarvene.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267395
    m_Localized: 'CultistPriest: Grazie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267396
    m_Localized: 'CultistPriest: Non avranno bisogno di molto tempo, ma comunque... veglia su di loro.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267397
    m_Localized: 'CultistPriest: A presto. Tornerò per controllare la situazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267398
    m_Localized: 'CultistPriest: Credi davvero di avere una scelta?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267399
    m_Localized: 'CultistPriest: A presto. Tornerò per controllare la situazione.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267400
    m_Localized: 'CultistPriest: Veglia sulla mia gente e ricorda: se uno di loro muore... la tua casa sarà ridotta in cenere.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655936
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655937
    m_Localized: 'StaticBoy: È sveglio?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655938
    m_Localized: 'StaticBoy: Non dovrebbe...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655939
    m_Localized: Ti sei perso?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655940
    m_Localized: Dove sono i tuoi genitori?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655941
    m_Localized: 'StaticBoy: Le porte sembrano tutte uguali al buio.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655942
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655943
    m_Localized: 'StaticBoy: Avevo bisogno della luce della cucina, ma... qui risuona un''eco diversa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655944
    m_Localized: 'StaticBoy: Ho sentito il pavimento scricchiolare. Significa che qualcuno sta aspettando.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655945
    m_Localized: Cosa stai cercando?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655946
    m_Localized: Ti serve aiuto a ritrovare casa?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655947
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655948
    m_Localized: 'StaticBoy: I miei genitori?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655949
    m_Localized: 'StaticBoy: Non ho dei genitori. Non ne ho mai avuti.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655950
    m_Localized: 'StaticBoy: Sono qualcosa di cui abbiamo bisogno?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655951
    m_Localized: Cosa stai cercando?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655952
    m_Localized: Ti serve aiuto a ritrovare casa?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655953
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655954
    m_Localized: 'StaticBoy: L''odore è sbagliato. La voce è sbagliata.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655955
    m_Localized: 'StaticBoy: Mi dispiace.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655956
    m_Localized: 'StaticBoy: La casa è sbagliata.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655957
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655958
    m_Localized: 'StaticBoy: L''odore è sbagliato. La voce è sbagliata.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655959
    m_Localized: 'StaticBoy: Mi dispiace.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655960
    m_Localized: 'StaticBoy: La casa è sbagliata.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655961
    m_Localized: 'Jacob: Ciao.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655962
    m_Localized: 'Jacob: Per caso è passata di qui una ragazza dai capelli viola con indosso un poncho?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655963
    m_Localized: Qui non c'è nessuno che corrisponda alla descrizione.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655964
    m_Localized: Se stai cercando il bordello, è più avanti lungo la strada.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655965
    m_Localized: 'Jacob: È... mia figlia.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655966
    m_Localized: 'Jacob: Non la trovo da quand''è cominciato questo casino.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655967
    m_Localized: 'Jacob: Dovevamo lasciare questo posto...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655968
    m_Localized: 'Jacob: Ma poi sono svenuto a causa di quell''ondata di caldo anomala...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655969
    m_Localized: 'Jacob: E mi sono risvegliato in casa da solo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655970
    m_Localized: 'Jacob: Non ha lasciato alcun biglietto, né una traccia. È come se fosse... semplicemente svanita.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655971
    m_Localized: Dove volete andare?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655972
    m_Localized: Non è qui, ciao.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655973
    m_Localized: 'Jacob: Non ti conviene parlare così di mia figlia.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655974
    m_Localized: 'Jacob: La cerco da quando è iniziato questo casino.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655975
    m_Localized: 'Jacob: Non ho idea di dove si sia cacciata.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655976
    m_Localized: 'Jacob: Non appena la trovo, ce ne andiamo da questo posto.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655977
    m_Localized: Dove volete andare?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655978
    m_Localized: Non è qui, ciao.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655979
    m_Localized: 'Jacob: Ovunque la FEMA non possa trovarci.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655980
    m_Localized: 'Jacob: L''importante è che sia lontano da qui, in sostanza.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655981
    m_Localized: 'Jacob: Vedi, mi stanno cercando perché so troppo su di loro.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655982
    m_Localized: 'Jacob: Potrebbero essere stati quei bastardi a prendere mia figlia... O forse no.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655983
    m_Localized: 'Jacob: Ma se sono stati loro, non le torceranno un capello. È me che vogliono.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655984
    m_Localized: 'Jacob: Fammi stare qui per un paio di giorni, almeno finché la FEMA non abbandonerà l''area.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655985
    m_Localized: 'Jacob: A quel punto, me ne andrò per cercare mia figlia.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655986
    m_Localized: 'Jacob: Nel frattempo, ti dirò tutto, se vuoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655987
    m_Localized: 'Jacob: So esattamente da dove vengono i Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655988
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655989
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655990
    m_Localized: 'Jacob: Ehi, aspetta!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655991
    m_Localized: 'Jacob: Ho bisogno di un riparo per qualche giorno.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655992
    m_Localized: 'Jacob: La FEMA mi sta cercando perché so troppe cose...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655993
    m_Localized: 'Jacob: Cose che il governo non vuole che si sappiano.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655994
    m_Localized: 'Jacob: Ti giuro che, non appena la FEMA abbandonerà l''area, me ne andrò per cercare mia figlia.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655995
    m_Localized: 'Jacob: Nel frattempo, ti dirò tutto, se vuoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655996
    m_Localized: 'Jacob: So esattamente da dove vengono i Visitatori.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655997
    m_Localized: Entra.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655998
    m_Localized: Dovresti andartene.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655999
    m_Localized: 'Jacob: Grazie...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656000
    m_Localized: 'Jacob: Non sono rimasti in molti ad ascoltare ancora gli altri...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656001
    m_Localized: 'Jacob: Sono le persone come te quelle che riusciranno a superare questo incubo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656002
    m_Localized: 'Jacob: Perché io e te... siamo immortali.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656003
    m_Localized: 'Jacob: Ti spiego una cosa che faresti meglio a imparare presto...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656004
    m_Localized: 'Jacob: Abbandonare le persone alle porte della morte è sbagliato.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656005
    m_Localized: 'Jacob: Ma io non morirò. Mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656006
    m_Localized: 'Jacob: E noi due... ci rincontreremo.'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311552
    m_Localized: 'Fanatic: Tieni, una generosa ricompensa dal SANTO SOLE in persona! Te la meriti, UMANO!'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311553
    m_Localized: 'Fanatic: Fammi entrare e ti concederò quest''incredibile {0} direttamente dal SANTO SOLE stesso!'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283080
    m_Localized: 'MushroomEater: Salve, ragazzo mio. Ti eri dimenticato di me, eh? Non hai notato gli indizi nascosti nel Libro dei Sorrisi?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283081
    m_Localized: 'MushroomEater: Mah... Sto solo sprecando del tempo prezioso con voi giovani...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283082
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283083
    m_Localized: 'MushroomEater: I ragazzi di oggi...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336336011264
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205568
    m_Localized: 'Gasmask: Dunque, è da solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205569
    m_Localized: 'Gasmask: Dev''essere dura per lei. Per noi lo è di certo. Come possiamo controllare un quartiere se non ci vive più nessuno?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205570
    m_Localized: 'Gasmask: Va bene, allora... Arrivederci.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177088
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177089
    m_Localized: 'CultistPriest: Come segno di gratitudine, potrei offrirti la salvezza...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177090
    m_Localized: 'CultistPriest: Unisciti al nostro rito e troverai la pace. Vieni, fratello, stringi la nostra mano mentre marciamo verso la Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177091
    m_Localized: Se desiderate tanto la morte, prego. Io resto qui.
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177092
    m_Localized: Da tempo desideravo trovare la pace... Mi unirò a voi.
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177093
    m_Localized: 'CultistPriest: Molto bene. Se questa è la tua scelta, così sia. La Morte reclamerà ciò che le spetta.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177094
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177095
    m_Localized: 'CultistPriest: Addio.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371392
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371393
    m_Localized: 'Vigilante: Mostrami le mani.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371394
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371395
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371396
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371397
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371398
    m_Localized: 'Vigilante: Le orecchie? E che me ne faccio delle orecchie?! Non vanno bene per individuare i Visitatori, cazzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371399
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371400
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371401
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371402
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371403
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371404
    m_Localized: 'Vigilante: Le orecchie? E che me ne faccio delle orecchie?! Non vanno bene per individuare i Visitatori, cazzo!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371405
    m_Localized: 'Vigilante: Il mio compito qui è finito.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371406
    m_Localized: 'Vigilante: Non mi rivedrai più.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371407
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371408
    m_Localized: 'Vigilante: Goditi ciò che resta.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303872
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303873
    m_Localized: 'SuperFake: Mi sembri mooolto... teso. Perché aggrapparsi alla vita in questo modo?'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303874
    m_Localized: 'SuperFake: Cosa resta che conta davvero? Non c''è più nessuno, ormai...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303875
    m_Localized: 'SuperFake: Ma quindiii...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303876
    m_Localized: 'SuperFake: Sei da solo?'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303877
    m_Localized: Sì, sono da solo.
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303878
    m_Localized: No, non sono da solo.
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692480
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692481
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306387824640
    m_Localized: 'MushroomEater: Oh, mio caro ragazzo... Non va affatto bene...'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306408796160
    m_Localized: 'MushroomEater: Sembra che il Festival si terrà comunque, dopotutto...'
    m_Metadata:
      m_Items: []
  - m_Id: 58250202325180416
    m_Localized: 'TV: Nel caso non sia possibile trasferire un sospetto Visitatore in una zona di quarantena, rilasciategli un mandato di comparizione obbligatoria.'
    m_Metadata:
      m_Items: []
  - m_Id: 58250202329374720
    m_Localized: Entra, ti libero il posto.
    m_Metadata:
      m_Items: []
  - m_Id: 61235008206004224
    m_Localized: Salta intro
    m_Metadata:
      m_Items: []
