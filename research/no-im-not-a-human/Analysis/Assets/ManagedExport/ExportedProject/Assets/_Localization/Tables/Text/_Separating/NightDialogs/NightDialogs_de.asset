%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_de
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: e2adf5c0928e69a42a85516c84d58249, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: Hallo. *hust, hust*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: Können Sie mich reinlassen?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: Wer sind Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: Was ist mit Ihnen passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: 'Firefighter: Ich bin *hust* Feuerwehrmann.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: 'Firefighter: Die Sonne hat mich erwischt, als wir heute Waldbrände gelöscht haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: 'Firefighter: Durch den dichten Rauch wird man zwar nicht lebendig verbrannt, aber *hust* es ist trotzdem gruselig.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: 'Firefighter: Die Bäume ... *hust, hust* Sie sind in Flammen aufgegangen wie Streichhölzer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: So was habe ich vorher noch nie gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: 'Firefighter: Der ganze Wald war voller verkohlter Tierkadaver.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: Warum sind Sie nicht im Krankenhaus?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: Was haben Sie jetzt vor?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: 'Firefighter: Die Nachmittagssonne hat mich erwischt, als wir *hust, hust* Waldbrände gelöscht haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: Ich bin der Einzige, der von meiner Truppe noch übrig ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: 'Firefighter: Die anderen ... *hust* Der Chef hat sie nicht gehen lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: Jetzt sind sie bis in alle Ewigkeit im Dienst.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: Warum sind Sie nicht im Krankenhaus?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: Was haben Sie jetzt vor?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: 'Firefighter: Im Krankenhaus? Es gibt keine Krankenhäuser mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: 'Firefighter: Seit die Besucher gekommen sind, haben sich Krankenhäuser erübrigt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: 'Firefighter: Wer will sich schon behandeln lassen, wenn man niemandem mehr trauen kann?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: Niemand wird mir helfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: 'Firefighter: Ich sollte lieber mit meinen Kameraden beim Löschen von Waldbränden sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: Viel Zeit bleibt mir sowieso nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: 'Firefighter: Am liebsten würde ich weiter Waldbrände löschen. Ich wünschte, ich wäre dort gestorben und nicht die anderen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: 'Firefighter: Aber sie haben mir *hust, hust* klar und deutlich gesagt, dass ich dort nichts mehr zu suchen habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: 'Firefighter: Ich kann nicht nach Hause. Die öffentlichen Verkehrsmittel fahren nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: Ich bin auf menschliche Nächstenliebe angewiesen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: Danke. *hust*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: 'Firefighter: Ich glaube nicht, dass ich Ihnen allzu lange zur Last fallen werde. *hust*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: 'Firefighter: Wenigstens muss ich nicht auf dem nassen Boden sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: Verdammt. *hust*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: Ich will nicht auf dem nassen Boden sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: 'Firefighter: Ich hoffe, dass die Feuer *hust, hust* nicht auf die Städte übergreifen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: Hey, wie läuft’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: 'WheelChair: Lange nicht gesehen. Was gibt’s Neues?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: Kennen wir uns?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: Wer sind Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: 'Wheelchair: Ach, komm schon ... Sag bloß, du erinnerst dich nicht an mich?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: Wir waren ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: 'Wheelchair: Moment mal, deine Stimme ist ganz anders ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: Wann hat das Haus den Besitzer gewechselt?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: Das Haus gehört schon immer meiner Familie
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: Sie haben sich in der Adresse geirrt
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: Oh, dann bist du gar nicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: Sie sind gar nicht mein Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: Wie lange wohnen Sie schon hier?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: Das Haus gehört schon immer meiner Familie
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: Sie haben sich in der Adresse geirrt
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: Aber nicht doch.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: 'Wheelchair: Ich mache nie Fehler! Und meine Erinnerung lässt mich nie im Stich.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: 'Wheelchair: Ich weiß, dass mein Kumpel hier wohnt ... oder zumindest hier gewohnt hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: 'Wheelchair: Hey, ich habe einen langen Weg hinter mir. Können Sie mich bitte reinlassen?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: Das kann nicht sein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: Nein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: Verdammt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: Ich habe mich wohl wirklich geirrt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: 'Wheelchair: Hey, ich habe einen langen Weg hinter mir. Können Sie mich bitte reinlassen?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: Das wollte ich hören!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: Wollen wir in Ihrem Haus ein Rennen fahren?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: 'Wheelchair: Verschwinden? Was zur Hölle?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: 'Wheelchair: Sie schicken mich einfach weg?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: 'Wheelchair: Dann rolle ich mal los, Sie Wahnsinniger.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: 'Mother: Es reicht! Hör endlich auf zu zappeln!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: 'Mother: Hallo. Bitte hilf mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: Was ist passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: Was willst du von mir?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: 'Mother: Ich bin erschöpft. Ich will einfach nur schlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: Ich habe fünf Kinder. Das hier ist das einzige, das noch übrig ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: 'Mother: Mein Mann ist verschwunden. Ich weiß nicht, ob er tot ist oder ob er uns verlassen hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: 'Mother: Ich will mich einfach nur hinlegen und ein paar Tage schlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: Wo sind deine anderen Kinder?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: Sind deine Kinder tot?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: 'Mother: Lass mich drinnen schlafen. Ich bin so müde.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: 'Mother: Ich hatte fünf Kinder. Das hier ist das letzte von ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: 'Mother: Ich weiß nicht, wo ich nach ihnen suchen soll. Ich will einfach nur schlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: Wo sind deine anderen Kinder?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: Sind deine Kinder tot?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: 'Mother: Ich weiß es nicht. Vielleicht hat ihr Vater sie geholt. Ich will zu seinem Haus, aber ich kann einfach nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: 'Mother: Wir haben viel gestritten, aber wen wundert’s? Wie soll man mit jemandem zusammenleben, der sich wie ein Arsch verhält?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: 'Mother: Das Wichtigste ist, meine Kinder zu finden.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: Mal nicht den Teufel an die Wand.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: 'Mother: Es ist nicht einfach, auf so eine Rasselbande aufzupassen, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: 'Mother: Ihnen ist bestimmt nichts zugestoßen. Wahrscheinlich sind sie bei meiner Mutter.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: 'Mother: Dorthin flüchten sie immer, wenn sie die Nase voll von mir haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: 'Mother: Oder wenn ihr Vater kommt, um mich wieder um Geld anzubetteln.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: 'Mother: Lässt du mich rein? Dann kann ich mich ausruhen und nach meinen Kindern suchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: Endlich kann ich schlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: 'Mother: Na los, geh schon. Such dir ein schönes Plätzchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: Morgen machen wir uns wieder auf den Weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: 'Mother: Wie du meinst. Dann versuche ich, zum Haus meiner Mutter zu kommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: Vielleicht schaffe ich es nicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: Nein, ich muss es schaffen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: Hallo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: 'Anger: Ich habe schlechte Laune, also entschuldige ich mich schon mal vorsorglich.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: 'Anger: Es gibt einfach zu viele Idioten. Ich hoffe, Sie sind nicht genauso wie die.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: Von wem reden Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: Sie gehören doch nicht zu diesen Monstern, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: Von allen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: 'Anger: Die Idioten, die nur von ihrem Glauben oder irgendeinem anderen Quatsch gezügelt wurden.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: 'Anger: Und als ihr Gott für sie gestorben ist, war es vorbei mit ihrer Menschlichkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: Verdammte Tiere.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: 'Anger: Als ob der Mist mit den Besuchern noch nicht reichen würde ... Die haben wir auch noch am Hals.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: Warum sind Sie so wütend?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: Was unterscheidet Sie von denen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: Gute Frage.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: 'Anger: Ihnen ist bestimmt schon aufgefallen, dass es zwei verschiedene ... Lager gibt, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: 'Anger: Die einen sind die verdammten Sadisten. Schlimmer als jeder Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: 'Anger: Sie machen, was sie wollen: Sie halten dir eine Knarre an den Kopf und drücken ab, und wieder beißt jemand ins Gras.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: 'Anger: Die anderen lassen sich einfach alles gefallen und sind einem dann noch dankbar, dass man sie nicht umgebracht hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: Beide Arten von Leuten regen mich fürchterlich auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: Warum sind Sie so wütend?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: Was unterscheidet Sie von denen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: 'Anger: Nehmen Sie’s nicht persönlich, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: 'Anger: Nach diesem Mist mit der Sonne und den Besuchern fühlt es sich an, als wäre die Menschheit zusammen mit Gott gestorben.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: 'Anger: Und ich bin sauer ... Ich wollte einfach nur ein ganz normales Leben führen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: 'Anger: Ich habe Musik komponiert. Die braucht jetzt keiner mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: Ich versuche einfach nur, zu keinem der beiden Lager zu gehören.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: Ich würde gerne glauben, dass ich anders bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: 'Anger: Es macht mir eine Heidenangst, wenn ich mir vorstelle, zu einem Geisteskranken zu werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: 'Anger: Oder zu einem Opfer. Beide Seiten sind scheiße.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: Wobei ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: Opfer sind am allerschlimmsten.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: 'Anger: Sie sitzen einfach nur rum und warten darauf, dass ihnen jemand die Fresse einschlägt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: 'Anger: Wenn Sie wüssten, was ich gesehen habe, würden Sie meine Wut verstehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: 'Anger: Keine Sorge, ich werde niemanden stören.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: Oder gar verprügeln.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: 'Anger: Ich richte meine Wut gegen mich selbst, damit niemand leiden muss.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: 'Anger: Scheiße, Sie sind ja genauso verkorkst wie die ganzen anderen Feiglinge.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: 'Anger: Dann mal viel Spaß dabei, sich den Schädel einschlagen zu lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: Verdammt noch mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: Ich spüre hier einen stockenden Energiefluss.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: Das verheißt nichts Gutes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: 'FortuneTeller: Die Sonne, der Löwe, das fünfte Haus. Ich verstehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: 'FortuneTeller: Du hast eine durchsetzungsstarke Persönlichkeit, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: Was?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: Ich brauche nichts
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: Du handelst offenbar lieber, als zu reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: Typisch Löwe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: 'FortuneTeller: Und du hast hier jede Menge unangenehmer, dunkler Energie angesammelt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: Noch weiß ich nicht, warum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: 'FortuneTeller: Alles ist so verwahrlost. Ich sollte mit den Mantras beginnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: Was zur Hölle willst du von mir?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: Und weiter?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: Ich will dir nichts aufschwatzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: 'FortuneTeller: Ich kann dir helfen, das Verhältnis von Ursache und Wirkung zu verstehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: 'FortuneTeller: Karma 6-9, wie zwei Fische, die einen Kreis bilden.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: 'FortuneTeller: Eine Hand wäscht die andere, verstehst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: Was zur Hölle willst du von mir?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: Und weiter?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: 'FortuneTeller: Ich weiß, dass du dich gestresst fühlst – dein Aszendent ist schließlich Steinbock.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: 'FortuneTeller: In dir wirken mehrere Sternbilder gleichzeitig. Du hast eine komplexe Persönlichkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: 'FortuneTeller: Mithilfe von Mantras können wir in die Tiefen deines Kosmos vordringen. Verstehst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: 'FortuneTeller: Dann wird sich alles wieder einrenken.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: 'FortuneTeller: In deiner Familie gab es Gefängniswärter und Reinkarnationen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: 'FortuneTeller: Gib ihnen Raum. Du wiederholst lediglich die Erfahrungen deiner vorherigen Leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: 'FortuneTeller: Du musst ihnen vergeben und ihre Gegenwart in dir selbst akzeptieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: 'FortuneTeller: Dann kannst du den endlosen Kreislauf durchbrechen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: Verstehst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: 'FortuneTeller: Sehr gut. Du bist hier in einer ausgezeichneten Lage.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: Dein Haus wird von einem Energiefluss durchströmt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: 'FortuneTeller: Du hast also kein Interesse daran, an dir zu arbeiten?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: Eine bessere Version deiner selbst zu werden?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: Was für ein Jammer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: 'FortuneTeller: Ich werde ein paar Mantras sprechen, damit du Durchfall bekommst.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: Guten Abend.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: 'Gasmask: Ich bin von der FEMA. Wir sehen uns in Ihrer Nachbarschaft um.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: Sind Sie allein?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: Warum sollte ich Ihnen trauen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: Natürlich nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: 'Gasmask: Unsere Abteilung wurde in kleine Gruppen aufgeteilt, um ein größeres Gebiet abzudecken.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: Das Gespräch dürfte Sie nicht viel Zeit kosten.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: Brauchen wir auch Schutzanzüge?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: Wie wollen Sie uns helfen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: Ich kann Ihnen meinen Ausweis zeigen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: 'Gasmask: Außerdem sind Besucher nur äußerst selten in Gruppen unterwegs. Wenn überhaupt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: Brauchen wir auch Schutzanzüge?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: Wie wollen Sie uns helfen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: 'Gasmask: Nein. Aber Sie können sich einen kaufen, wenn Sie es für nötig halten.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: 'Gasmask: Wir untersuchen die Auswirkungen der Sonne auf die Umwelt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: 'Gasmask: Da wir viel Zeit in der Sonne verbringen, müssen wir vorsichtig sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: Und weiter?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: Haben Sie einen Aktionsplan?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: 'Gasmask: Unsere wichtigste Aufgabe ist es, Daten zu sammeln und an die Behördenleitung zu übermitteln.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: Dort werden dann entsprechende Maßnahmen entwickelt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: 'Gasmask: Fürs Erste müssen Sie einfach nur die Ruhe bewahren.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: Und weiter?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: Haben Sie einen Aktionsplan?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: Ich nehme eine Person mit.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: 'Gasmask: Wir führen Tests durch, um sicherzustellen, dass es den Leuten gut geht und die Gegend sicher bewohnbar ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: 'Gasmask: Und wir prüfen natürlich, ob sie Menschen sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: Muss ich meine Sachen packen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: Soll ich einfach abwarten, was passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: 'Gasmask: Natürlich. Wir können schließlich nicht alles spontan entscheiden.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: Wir bringen eine Person aus Ihrem Haus in unser Labor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: 'Gasmask: Wir machen nur ein paar Tests, um zu sehen, ob alles in Ordnung ist. Dann bringen wir die Person wieder zurück.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: Muss ich meine Sachen packen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: Soll ich einfach abwarten, was passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: Ist das Ihr Haus?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: 'Gasmask: Dann nicht. Bleiben Sie bei den anderen Bewohnern. Falls wir Sie evakuieren müssen, sagen wir Ihnen Bescheid.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: Wir nehmen nur eine Person mit und gehen wieder.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: Gute Nacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: 'Gasmask: Ja. Sobald wir alle Informationen haben, geben wir entsprechende Anweisungen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: Im Moment besteht kein Grund zur Sorge.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: 'Gasmask: Wir nehmen nur eine Person mit und bringen Sie so schnell wie möglich wieder zurück.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: Passen Sie auf sich auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: 'Prophet: So trifft man sich wieder.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: 'Prophet: Beim letzten Mal war alles noch anders. Aber wir leben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: 'Prophet: Hm. Seltsam – ich weiß nicht, wie ich es erklären soll.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: 'Prophet: Ich möchte unser Gespräch mit einer ... Handlung beginnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: 'Prophet: Kannst du mir meine Zukunft aus einem Buch vorhersagen? Auf welcher Seite soll ich es aufschlagen?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: Irgendwo am Anfang
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: Irgendwo in der Mitte
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: Irgendwo am Ende
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: 'Prophet: „Die Toten werden zu sprechen wagen, doch niemand wird ihre Worte hören.“'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: Meine Güte ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: Das hat nichts an Relevanz verloren.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: Auch wenn es inzwischen keine Überraschung mehr ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: Was bedeutet das?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: Glauben Sie das wirklich?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: Was bist du?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: 'Prophet: Ich? Ich bin ich? Du? Du warst zu Hause.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: 'Prophet: Hm. Ja. Eine tragische Geschichte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: 'Prophet: Ist es das, was uns erwartet?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: Gut möglich.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: Was bedeutet das?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: Glauben Sie das wirklich?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: 'Prophet: „Es ist so lange her. Vielleicht war es ein Traum. Du, ich und der Fisch ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: 'Prophet: ... Vielleicht existieren wir nur in der Erinnerung einer Person, die es schon lange nicht mehr gibt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: 'Prophet: Vielleicht existiert niemand wirklich und es regnet einfach nur.“'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: Hm. Oder vielleicht wird es bald so sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: 'Prophet: Was meinen Sie? Sind wir bereits ein Traum oder werden wir erst dazu?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: Das ist eine interessante Zeile.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: Was bedeutet das?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: Glauben Sie das wirklich?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: 'Prophet: Ich muss nachdenken. Haben Sie irgendwelche Gedanken dazu?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: Wie auch immer, ich bin gekommen, um Ihnen etwas zu sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: In Kürze werden sich gewisse Dinge ereignen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: Sie sollten lieber vorbereitet sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: 'Prophet: Ich weiß, es klingt seltsam, aber Sie müssen die Person mit Katze hereinlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: 'Prophet: Ich bin mir sicher, dass es Ihnen helfen wird. Ich weiß nur noch nicht, inwiefern.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: 'Prophet: Aber Sie können mit dieser Information natürlich machen, was Sie wollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: 'Prophet: Ich werde fürs Erste über die Bedeutung Ihrer Weissagung nachdenken.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: Nicht uneingeschränkt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: 'Prophet: Es sollte besser als Hinweis verstanden werden. Damit man nicht etwas Wichtiges vergisst, oder damit man vorsichtig ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: Als ich darüber nachgedacht habe, kam ich zu einer Erkenntnis.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: 'Prophet: Schon bald wird eine Person mit einer Katze kommen. Es ist wichtig, dass Sie sie hereinlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: Ich kann noch nicht sagen, warum. Aber alles wird dadurch einfacher werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: 'Prophet: Ich werde jetzt über Ihre Auswahl aus dem Buch nachdenken.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: Seien Sie gegrüßt, Mensch.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: 'Fanatic: Wir können uns glücklich schätzen! Wir sehen mit eigenen Augen, wie die menschliche Gier bestraft wird.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: 'Fanatic: Die Erde wird geläutert. Die Sonne leistet ganze Arbeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: Und wir sind auf dem Weg zu einer unbefleckten neuen Welt!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: 'Fanatic: WAS FÜR EIN SEGEN, VERDAMMT NOCH MAL!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: Wie bitte?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: Sie machen mir Angst
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: Was haben Sie erwartet, MENSCH?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: 'Fanatic: Hören Sie zu, ich erkläre es Ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: 'Fanatic: Die Sonne verbrennt und GRILLT uns nicht ohne Grund! Das ist nichts anderes als die Läuterung unserer Sünden!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: 'Fanatic: Wir haben alles ins Chaos gestürzt und DIE SONNE MÄCHTIG SAUER GEMACHT!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: 'Fanatic: UND JETZT GIBT SIE UNS, WAS WIR VERDIENEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: 'Fanatic: Das ist ein Segen. Alle Sünden gehen in Flammen auf und wir leben endlich so, wie wir sollten.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: Wir müssen also sterben?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: Was wird aus Ihnen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: Haben Sie den Verstand verloren?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: 'Fanatic: Hören Sie zu, ich erkläre es Ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: 'Fanatic: Die Sonne verbrennt und GRILLT uns nicht ohne Grund! Das ist nichts anderes als die Läuterung unserer Sünden!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: 'Fanatic: Wir haben alles ins Chaos gestürzt und DIE SONNE MÄCHTIG SAUER GEMACHT!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: 'Fanatic: UND JETZT GIBT SIE UNS, WAS WIR VERDIENEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: 'Fanatic: Das ist ein Segen. Alle Sünden gehen in Flammen auf und wir leben endlich so, wie wir sollten.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: Wir müssen also sterben?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: Was wird aus Ihnen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: Ganz im Gegenteil!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: 'Fanatic: Unsere Sünden werden verschwinden. Vielleicht wird sogar die Sonne selbst verschwinden. ABER WIR WERDEN LEBEN.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: 'Fanatic: Es wird keinen Tod mehr geben, keinen Diebstahl und keine profitgeilen Säcke, die keine fairen Preise machen können.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: 'Fanatic: Können Sie sich das vorstellen? Begreifen Sie, was das bedeutet?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: Was hat das mit mir zu tun?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: 'Fanatic: Wir alle werden GLÜCKLICH LEBEN, sobald die Sonne es zulässt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: 'Fanatic: Die Sonne hilft uns, allem zu entfliehen, verstehen Sie das nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: 'Fanatic: Und ob sie es verstehen – deshalb sind Sie am Leben!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: Ich werde Ihnen alles noch viel genauer erklären!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: 'Fanatic: Oh, fast hätte ich es vergessen: Haben Sie Bier?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: 'Fanatic: Wollen sie so tun, als wüssten Sie nichts über die Sonne?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: 'Fanatic: Fahren Sie doch zur Hölle! DANN RETTE ICH EBEN JEMAND ANDEREN!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: 'Fanatic: TSCHÜ-HÜSS!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: Hallo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: 'Anxiety: Ich weiß, es ist schon spät ... Heute war es so heiß und im Fernsehen hieß es, man soll nicht raus in die Sonne gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: Hast du vielleicht noch Platz für mich?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: Wer bist du?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: Wie bist du hergekommen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: Äh, ich habe in der Nähe der Stadt gewohnt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: 'Anxiety: Der Asphalt dort heizt sich natürlich ordentlich auf, hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: 'Anxiety: Ich habe als Kassiererin gearbeitet. Früher. Jetzt nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: 'Anxiety: Sie, äh, haben mich gefeuert. Ich habe einfach kein Glück mit der Arbeit ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: Was hast du jetzt vor?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: Was glaubst du, was passieren wird?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: 'Anxiety: Ich wollte eigentlich nicht herkommen. Der Asphalt schmilzt schon unter unseren Füßen, aber noch geht es.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: Du wirst lachen, hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: 'Anxiety: Besucher sind zu mir nach Hause gekommen. Hehe ... Stell dir vor! Sie haben mich aus meinem eigenen Haus gejagt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: 'Anxiety: Jetzt suche ich einen Ort, an dem ich mich vor der Sonne verstecken kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: Was hast du jetzt vor?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: Was glaubst du, was passieren wird?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: 'Anxiety: Hmmmm. Irgendwie überleben. Aber diese ganzen Besucher überall und die sengende Sonne machen mir natürlich Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: 'Anxiety: Ich würde wirklich gerne überleben. Hehe. Uff.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: Hast du gar keine Angst?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: 'Anxiety: Bitte sag mir, dass bald alles vorbei ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: Ich weiß es nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: 'Anxiety: Werde ich überleben? Wer hilft mir? Wie lange habe ich noch Zeit, Hilfe zu suchen?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: 'Anxiety: Keine Ahnung, was passieren wird. Nicht mal, wenn ich raten müsste.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: 'Anxiety: Macht dir das keine Angst? Mich macht es völlig fertig.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: 'Anxiety: Danke. Haha! Danke, wirklich!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: 'Anxiety: Ich kann noch ein bisschen länger leben, Gott sei Dank.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: 'Anxiety: Haha, puuuh. Na gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: 'Anxiety: Danke jedenfalls, dass du mir zugehört hast.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: 'Anxiety: Äh, dann gehe ich mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: 'Anxiety: Tschüss? Ja, äh, tschüss.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: Kann ich reinkommen?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: Ich habe in der Bar Schutz gesucht, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: Die haben mich einfach rausgeschmissen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: 'Esenin: Warum? Tja, nicht jeder kommt mit meinem Temperament klar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: 'Esenin: Aber ich tue niemandem was, keine Sorge. Manchmal ist das Leben einfach nur beschissen. Du weißt schon.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: 'Esenin: Also, kann ich reinkommen?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: Sie sind doch kein Besucher, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: Sind Sie sicher, dass Sie keinen Ärger machen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: Denken Sie, ich bin eins von diesen Monstern?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: 'Esenin: Nein. Ich bin kein Besucher. Überall muss man sich diese dämlichen Fragen anhören.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: 'Esenin: Das wird hier wohl nicht anders sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: Warum wurden Sie rausgeschmissen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: Warum sollte es hier anders sein?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: Was heißt für Sie „Ärger“?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: 'Esenin: Mord und Prügeleien habe ich nicht im Angebot. Aber ich lasse mir nichts gefallen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: 'Esenin: Ich esse und trinke gerne. Ich rede gerne, wenn ich gut drauf bin. Ist das für Sie „Ärger“?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: Warum wurden Sie rausgeschmissen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: Warum sollte es hier anders sein?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: 'Esenin: Ich wollte gerade was Unhöfliches sagen, aber ich hab’s mir anders überlegt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: 'Esenin: Die Leute dort mögen mich einfach nicht. Weiß der Teufel, warum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: 'Esenin: Vielleicht war es gar nicht so schlecht, dass sie mich rausgeworfen haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: 'Esenin: Sie hätten mich auch bei lebendigem Leib auffressen können, ohne dass es jemand bemerkt hätte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: 'Esenin: Was soll ich denn jetzt machen? Mich von der Sonne verbrennen lassen?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: Ich glaube nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: 'Esenin: Solange ich noch lebe, suche ich jemanden zum Reden. Wenn Sie mich nicht reinlassen, versuche ich mein Glück woanders.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: 'Esenin: Wenn es auf dieser Welt überhaupt noch so was wie Glück gibt. Und Leute, die keine Arschlöcher sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: Sie sollten lieber verschwinden
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: 'Esenin: Danke. Die Leute vertrauen einander kaum noch.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: 'Esenin: Deswegen weiß ich Ihr Vertrauen zu schätzen. Vielleicht ... Nun, ich kann nichts versprechen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: 'Esenin: Hm. Ich verstehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: 'Esenin: Ich verstehe Sie, aber ich bin wütend. Sie sind genauso feige wie alle anderen in der Gegend.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: 'Esenin: Schlafen Sie gut. Und fahren Sie zur Hölle.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: Kann ich reinkommen und mich ausruhen?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: Wo kommen Sie her?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: Und wo wollen Sie hin?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: 'Widow: Ich kann mich nicht mehr erinnern. Das spielt auch keine Rolle.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: 'Widow: Ich bin so müde. Wenn ich mich nicht bald ausruhen kann, breche ich einfach unter den Fenstern zusammen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: Ist Ihr Begleiter krank?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: Braucht Ihr Freund Hilfe?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: 'Widow: Ich ... Ich will mich einfach nur irgendwo hinlegen und nie mehr aufstehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: Es spielt keine Rolle, wohin es mich verschlägt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: Ist Ihr Begleiter krank?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: Braucht Ihr Freund Hilfe?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: Das ist mein Mann.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: Er ist tot.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: 'Widow: Ich kann ihn nicht anständig begraben und will ihn nicht einfach zurücklassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: 'Widow: Dafür ist es jetzt zu spät. Als er Hilfe gebraucht hätte, hat niemand geholfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: Jetzt ist er tot.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: 'Widow: Vielleicht würde er noch leben, wenn ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: 'Widow: Wenn irgendjemand sich gekümmert hätte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: Ich bleibe bestimmt nicht lange.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: 'Widow: Ich muss mich nur ausruhen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: Hey!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: 'Scammer: Haben Sie gesehen, was hier los ist? Vollkommen irre.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: Wie geht’s Ihnen?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: Was wollen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: Was genau ist hier los?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: 'Scammer: Nichts, ich bin nur neugierig.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: 'Scammer: Aber ich habe eine Idee, wie Sie leichtes Geld verdienen können.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: 'Scammer: Bei diesem Sonnenschein muss man kaum einen Finger rühren, um abzukassieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: 'Scammer: Die ganzen Trottel machen sich alle ins Hemd, dabei ist gerade jetzt Handeln angesagt!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: Was wollen Sie hier?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: Was schlagen Sie vor?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: 'Scammer: Neue Chancen. Haben Sie gar nichts begriffen?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: 'Scammer: Alle rennen durch die Gegend wie kopflose Hühner, anstatt einfach ihrem Herzen zu folgen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: 'Scammer: Ich will nur, dass die Leute glücklich sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: Was wollen Sie hier?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: Was schlagen Sie vor?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: Steigen Sie sofort ins Geschäft ein!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: 'Scammer: Alle denken, dass Sie hier irgendwas am Köcheln haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: 'Scammer: Wir könnten hier die Party unseres Lebens feiern!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: Sie wollen überleben?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: 'Scammer: Sie müssen Pläne machen, solange Sie noch die Gelegenheit haben. Scheißen Sie auf die Sonne.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: 'Scammer: Worauf warten Sie? Legen wir los! Na, was sagen Sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: 'Scammer: Ja, Kumpel, so gefällt mir das!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: Endlich mal jemand mit Verstand.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: 'Scammer: Sie sind offensichtlich ein Dummkopf. Aber wie Sie wollen. Fahren Sie zur Hölle.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: 'Scammer: Dann gehe ich eben zu Ihren Nachbarn.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: Tschüss.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: 'Neighbour: Hallo, Nachbar. Lange nicht gesehen. Wie geht’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: So wie immer
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: Gut
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: 'Neighbour: Ich bin hier, weil ich mir Sorgen um Sie mache.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: Irgendwas Schlimmes braut sich zusammen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: 'Neighbour: Meine Cousine hat mich angerufen. In den Nachrichten heißt es, dass mit der Sonne irgendwas nicht stimmt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: 'Neighbour: Und dass Leute aus dem Untergrund auftauchen. Sogenannte „Besucher“.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: 'Neighbour: Ganz schön unheimlich, oder? Hoffentlich ist das nur leeres Geschwätz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: Was ist mit der Sonne los?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: Besucher?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: 'Neighbour: Ich bin hier, weil ich mir Sorgen um Sie mache.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: Irgendwas Schlimmes braut sich zusammen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: 'Neighbour: Meine Cousine hat mich angerufen. In den Nachrichten heißt es, dass mit der Sonne irgendwas nicht stimmt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060952
    m_Localized: 'Neighbour: Und dass Leute aus dem Untergrund auftauchen. Sogenannte „Besucher“.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060953
    m_Localized: 'Neighbour: Ganz schön unheimlich, oder? Hoffentlich ist das nur leeres Geschwätz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060954
    m_Localized: Was ist mit der Sonne los?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060955
    m_Localized: Besucher?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060956
    m_Localized: 'Neighbour: Entweder steht sie kurz vor der Explosion oder es gibt eine Explosion auf ihr ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060957
    m_Localized: 'Neighbour: Ich weiß nur, dass irgendwas nicht stimmt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060958
    m_Localized: 'Neighbour: Sie haben bestimmt mitbekommen, dass dieser Sommer der heißeste aller Zeiten war, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060959
    m_Localized: 'Neighbour: Ich glaube, wir müssen uns auf das Schlimmste gefasst machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060960
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060961
    m_Localized: 'Neighbour: Meine Cousine hat gesagt, dass es gefährlich ist, allein zu Hause zu bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060962
    m_Localized: 'Neighbour: Also bin ich zu Ihnen gekommen, damit Sie nicht getötet werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060963
    m_Localized: Verstehe
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060964
    m_Localized: Ich kann auf mich selbst aufpassen
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060965
    m_Localized: Wie geht es Ihrer Frau und Ihrer Tochter?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060966
    m_Localized: 'Neighbour: Ja. So nennen sie die Leute aus dem Untergrund.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060967
    m_Localized: 'Neighbour: Weiß der Teufel, warum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060968
    m_Localized: 'Neighbour: Wahrscheinlich, weil sie nur zu Besuch auf der Erde sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060969
    m_Localized: 'Neighbour: Oder weil sie versuchen, in fremde Häuser zu gelangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060970
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060971
    m_Localized: 'Neighbour: Meine Cousine hat gesagt, dass es gefährlich ist, allein zu Hause zu bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060972
    m_Localized: 'Neighbour: Also bin ich zu Ihnen gekommen, damit Sie nicht getötet werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060973
    m_Localized: Verstehe
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060974
    m_Localized: Ich kann auf mich selbst aufpassen
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060975
    m_Localized: Wie geht es Ihrer Frau und Ihrer Tochter?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060976
    m_Localized: 'Neighbour: Na gut, reden wir morgen früh weiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060977
    m_Localized: 'Neighbour: Ich warte in der Küche auf Sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060978
    m_Localized: 'Neighbour: Bis morgen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060979
    m_Localized: 'Neighbour: Ich weiß. Aber ich glaube, im Moment ist es allein gefährlicher, als Sie denken.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060980
    m_Localized: 'Neighbour: Wie wär’s, wenn ich heute Nacht bei Ihnen bleibe? Nur für alle Fälle. Dann wäre ich ein bisschen beruhigter.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060981
    m_Localized: 'Neighbour: Keine Sorge wegen meiner Frau und meiner Tochter. Ein guter Freund ist vor Kurzem gekommen, er kümmert sich um sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060982
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060983
    m_Localized: 'Neighbour: Na gut, reden wir morgen früh weiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060984
    m_Localized: 'Neighbour: Ich warte in der Küche auf Sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060985
    m_Localized: 'Neighbour: Bis morgen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060986
    m_Localized: 'Neighbour: Keine Sorge. Ein guter Freund ist vor Kurzem gekommen, er kümmert sich um sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060987
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060988
    m_Localized: 'Neighbour: Na gut, reden wir morgen früh weiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060989
    m_Localized: 'Neighbour: Ich warte in der Küche auf Sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060990
    m_Localized: 'Neighbour: Bis morgen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060991
    m_Localized: 'Daughter: Hallo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060992
    m_Localized: 'Daughter: Ist mein Papa hier? Kannst du ihn holen?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060993
    m_Localized: 'Daughter: Vorhin war noch alles gut, aber jetzt hab ich Angst. Nachts sind so viele Leute unterwegs ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060994
    m_Localized: Wie heißt dein Vater?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060995
    m_Localized: Erzähl mir von deinem Vater
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060996
    m_Localized: 'Daughter: Hast du seinen Namen vergessen? Oh, du willst wahrscheinlich nur testen, ob ich eine Besucherin bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060997
    m_Localized: 'Daughter: Ganz schön clever! Ab jetzt mach ich das bei anderen Leuten auch so.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060998
    m_Localized: Bist du sicher hergekommen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060999
    m_Localized: Hast du Angst vor Besuchern?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061000
    m_Localized: 'Daughter: Hm, da gibt es viel zu erzählen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061001
    m_Localized: 'Daughter: Bevor er aus dem Haus geht, trinkt er gerne Bier, hehe!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061002
    m_Localized: 'Daughter: Er lässt mir immer Mittagessen und Abendessen da. Und Saft.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061003
    m_Localized: 'Daughter: Heute hab ich sein Bier probiert. Igitt! Das war richtig eklig!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061004
    m_Localized: 'Daughter: Warum trinkt er so was, wenn es auch Saft gibt?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061005
    m_Localized: 'Daughter: Sag es ihm aber bitte nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061006
    m_Localized: Bist du sicher hergekommen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061007
    m_Localized: Hast du Angst vor Besuchern?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061008
    m_Localized: 'Daughter: Alles ist irgendwie auf den Kopf gestellt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061009
    m_Localized: 'Daughter: Tagsüber sind die Leute zu Hause und schlafen, und nachts laufen sie draußen rum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061010
    m_Localized: 'Daughter: Ich hab immer noch Angst im Dunkeln, aber hier scheint nichts zu sein, wovor ich mich fürchten muss.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061011
    m_Localized: 'Daughter: Oder doch?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061012
    m_Localized: Ich hole deinen Vater. Viel Glück!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061013
    m_Localized: Mach’s gut!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061014
    m_Localized: 'Daughter: Ich weiß nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061015
    m_Localized: 'Daughter: Alle haben Angst vor ihnen, also hab ich auch Angst. Ich hab aber noch nie einen davon gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061016
    m_Localized: 'Daughter: Sind sie gruselig? Hauen sie einen ganz doll?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061017
    m_Localized: 'Daughter: Wenn mein Schulfreund mich haut, ist er dann auch ein Besucher?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061018
    m_Localized: 'Daughter: Papa hat gesagt, ich soll aufpassen. Und das mach ich auch!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061019
    m_Localized: 'Daughter: Ich hab mich gaaanz leise hergeschlichen. Keiner hat mich gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061020
    m_Localized: Ich hole deinen Vater. Viel Glück!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061021
    m_Localized: Schönen Tag noch!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061022
    m_Localized: 'Daughter: Danke, dir auch!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061023
    m_Localized: 'Daughter: Beeil dich. Ich habe Angst, wenn ich nachts alleine bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061024
    m_Localized: 'Daughter: Wir spielen ein Spiel, das er für mich erfunden hat. Da muss man würfeln!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061025
    m_Localized: 'Daughter: Und dann bewegt man sich mit dem Sessel oder mit der Couch.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061026
    m_Localized: 'Daughter: Man muss eine Straße bauen. Ich zeig’s dir später.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061027
    m_Localized: 'Daughter: Tschüss!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061028
    m_Localized: 'Daughter: H-Hallo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061029
    m_Localized: 'Daughter: L-Lass mich rein.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061030
    m_Localized: Hast du Angst?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061031
    m_Localized: Was ist passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061032
    m_Localized: 'Daughter: Ich w-weiß nicht, w-was ich m-machen soll.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061033
    m_Localized: 'Daughter: L-L-Leute.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061034
    m_Localized: 'Daughter: Ä-Äh ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061035
    m_Localized: 'Daughter: Haben m-meinen Papa g-g-getötet ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061036
    m_Localized: 'Daughter: M-M-Mein ... M-Mein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061037
    m_Localized: 'Daughter: P-Papa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061038
    m_Localized: Wer genau?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061039
    m_Localized: Warum haben sie das getan?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061040
    m_Localized: 'Daughter: Ä-Äh ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061041
    m_Localized: 'Daughter: M-M-Mein P-Papa ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061042
    m_Localized: 'Daughter: S-Sie haben ihn g-g-g...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061043
    m_Localized: 'Daughter: Sie haben m-meinen P-Papa getötet.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061044
    m_Localized: Wer genau?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061045
    m_Localized: Warum haben sie das getan?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061046
    m_Localized: 'Daughter: B-B-Besucher sind z-zum Haus gekommen. Sie haben s-sich bei uns h-hingesetzt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061047
    m_Localized: 'Daughter: Papa hat mit ihnen über i-irgendwas g-geredet. Und d-dann haben sie ihn getötet.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061048
    m_Localized: 'Daughter: Er ... Unser ... *schluchz*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061049
    m_Localized: 'Daughter: Unser Haus b-b-brennt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061050
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061051
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061052
    m_Localized: 'Daughter: Ich w-weiß nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061053
    m_Localized: 'Daughter: Sie waren mit Papa in der K-Küche gesessen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061054
    m_Localized: 'Daughter: Und dann h-haben sie irgendwas g-gemacht, und d-dann haben sie das Haus a-angezündet.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061055
    m_Localized: 'Daughter: Als ich w-weggerannt bin, h-haben sie nur gelacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061056
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061057
    m_Localized: Du solltest lieber verschwinden
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061058
    m_Localized: 'Daughter: Du h-hilfst m-mir?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061059
    m_Localized: 'Daughter: Ich h-habe Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061060
    m_Localized: 'Daughter: Wo s-soll ich hin?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061061
    m_Localized: 'Daughter: Waaaaaaaaah.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061062
    m_Localized: 'Daughter: WAAAAAAAAH.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061063
    m_Localized: 'Daughter: ICH H-HABE S-SOLCHE ANGST!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061064
    m_Localized: 'SuperFake: Hallo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061065
    m_Localized: Was wollen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061066
    m_Localized: Ich lasse Sie nicht rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061067
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061068
    m_Localized: 'SuperFake: Geräumiges Haus.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061069
    m_Localized: 'SuperFake: Gefällt mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061070
    m_Localized: Ich brauche nichts
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061071
    m_Localized: Ich habe eine Waffe
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061072
    m_Localized: 'SuperFake: Ist Ihre Tür auch schön stabil?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061073
    m_Localized: 'SuperFake: Man kann nie wissen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061074
    m_Localized: 'SuperFake: Sie verstehen schon.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061075
    m_Localized: Ich brauche nichts
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061076
    m_Localized: Ich habe eine Waffe
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061077
    m_Localized: 'SuperFake: Ja, ja, ich weiß.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061078
    m_Localized: 'SuperFake: Also ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061079
    m_Localized: 'SuperFake: Sind Sie allein zu Hause?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061080
    m_Localized: Nein, ich bin nicht allein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061081
    m_Localized: Ja, ich bin allein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061082
    m_Localized: 'SuperFake: Ausgezeichnet!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061083
    m_Localized: 'SuperFake: Verzweiflung macht den Feigling mutig, nicht wahr?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061084
    m_Localized: 'SuperFake: Aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061085
    m_Localized: 'SuperFake: Sind Sie allein zu Hause?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061086
    m_Localized: Nein, ich bin nicht allein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061087
    m_Localized: Ja, ich bin allein
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061088
    m_Localized: 'SuperFake: Heute ist Ihr Glückstag.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061089
    m_Localized: 'SuperFake: Ich höre drinnen jemanden flüstern.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061090
    m_Localized: 'SuperFake: Aber wer weiß schon, was in ein paar Tagen passiert?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061091
    m_Localized: 'SuperFake: Hahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061092
    m_Localized: 'SuperFake: Ich weiß, dass Sie allein sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061093
    m_Localized: 'SuperFake: Ich wollte nur sehen, ob Sie lügen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061094
    m_Localized: 'SuperFake: Ich mache die Tür auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061095
    m_Localized: 'NotTrue: Hallo, Schätzchen! Der Weg hierher hat mir alles abverlangt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061096
    m_Localized: 'NotTrue: Darf ich mich bei Ihnen ausruhen?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061097
    m_Localized: Sind Sie absichtlich hergekommen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061098
    m_Localized: Sind Sie lange gelaufen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061099
    m_Localized: 'NotTrue: Nein, natürlich nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061100
    m_Localized: 'NotTrue: Das Leben führt die Leute dorthin, wo es sie braucht. Wir begegnen niemandem zufällig.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061101
    m_Localized: 'NotTrue: Meine Füße und meine Augen haben mich hierhergeführt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255104
    m_Localized: 'NotTrue: Genau so, wie es sein sollte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255105
    m_Localized: Ich kann Ihnen nicht folgen. Brauchen Sie irgendwas?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255106
    m_Localized: Warum sind Sie nicht weitergelaufen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255107
    m_Localized: 'NotTrue: Ich kann gar nicht sagen, wie lange. Was heißt überhaupt „lange“?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255108
    m_Localized: 'NotTrue: Sehen Sie sich an. Sie sind zu Hause und laufen trotzdem herum.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255109
    m_Localized: 'NotTrue: Sind Sie lange gelaufen? Ganz bestimmt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255110
    m_Localized: 'NotTrue: Aber ich habe mehr Jahrzehnte mit Laufen verbracht, als Sie mit warmen Mahlzeiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255111
    m_Localized: 'NotTrue: So ist das nun mal, Schätzchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255112
    m_Localized: Ich kann Ihnen nicht folgen. Brauchen Sie irgendwas?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255113
    m_Localized: Warum sind Sie nicht weitergelaufen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255114
    m_Localized: 'NotTrue: Was braucht man schon im Leben?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255115
    m_Localized: 'NotTrue: Mir reicht es, ein paar Geschichten zu hören und selbst welche zu erzählen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255116
    m_Localized: 'NotTrue: Danach will ich mich hinlegen und glücklich die Augen zumachen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255117
    m_Localized: 'NotTrue: Und tief durchatmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255118
    m_Localized: 'NotTrue: Mehr brauche ich nicht. Aber allein wird es mir langweilig.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255119
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255120
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255121
    m_Localized: 'NotTrue: Sie hören mir überhaupt nicht zu, Schätzchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255122
    m_Localized: 'NotTrue: Ich bin müde vom vielen Laufen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255123
    m_Localized: 'NotTrue: Hier könnte ich mich wenigstens ausruhen und ein bisschen reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255124
    m_Localized: 'NotTrue: Das ist genug Unterhaltung für eine alte Frau wie mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255125
    m_Localized: 'NotTrue: Wir können uns gegenseitig etwas erzählen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255126
    m_Localized: 'NotTrue: Und dann kann ich eine Weile die Augen zumachen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255127
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255128
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255129
    m_Localized: 'NotTrue: Danke, Schätzchen!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255130
    m_Localized: 'NotTrue: Bei Ihnen wird mir bestimmt nicht langweilig. Hier bekomme ich wenigstens mit, was in der Gegend los ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255131
    m_Localized: 'NotTrue: Überall werde ich abgewiesen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255132
    m_Localized: 'NotTrue: Meine Flügel sind gestutzt, doch ich öffne den Schnabel, um zu singen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255133
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255134
    m_Localized: 'NotTrue: Aber die Leute wenden sich trotzdem widerwillig an mich, auch wenn sie das Gegenteil sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255135
    m_Localized: 'NotTrue: Nun ja, ich bin nicht nachtragend. Ich helfe jedem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255136
    m_Localized: 'NotTrue: Auch Sie werden Hilfe brauchen. An wen werden Sie sich wenden?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255137
    m_Localized: 'Twins: Hallo. Oh, lehn dich kurz an mir an.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255138
    m_Localized: 'Twins: Ist es in Ordnung, dass wir hier sind?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255139
    m_Localized: Ist deine Begleiterin krank?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255140
    m_Localized: Seid ihr beide krank? Oder nur eine von euch?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255141
    m_Localized: 'Twins: Das ist meine Schwester. Sie hat Depressionen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255142
    m_Localized: 'Twins: Sie kann nicht allein laufen oder baden. Manchmal ist sie kaum aus dem Bett zu bekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255143
    m_Localized: 'Twins: Aber irgendwann wird alles besser. Stimmt’s, Schwesterherz?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255144
    m_Localized: 'Twins: Sie ist gerade nicht in der Stimmung zu reden, aber manchmal findet sie die Kraft dazu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255145
    m_Localized: Was hast du jetzt vor?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255146
    m_Localized: Hast du es nicht satt, sie herumzutragen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255147
    m_Localized: 'Twins: Wir sind doch alle mehr oder weniger depressiv.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255148
    m_Localized: 'Twins: Schon vor der ganzen Geschichte mit der Sonne war klar, wohin die Reise geht.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255149
    m_Localized: 'Twins: Hast du die Nachrichten verfolgt? Es war alles absehbar. Aber ich glaube nicht, dass die Sonne explodiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255150
    m_Localized: Was hast du jetzt vor?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255151
    m_Localized: Hast du es nicht satt, sie herumzutragen?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255152
    m_Localized: 'Twins: Ich muss einen Ort finden, an dem meine Schwester sich ein bisschen wohler fühlt.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255153
    m_Localized: 'Twins: Und dann fangen wir ein neues Leben an.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255154
    m_Localized: 'Twins: Glaubst du, unser Leben ist vorbei?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255155
    m_Localized: 'Twins: Ich nicht. Es wird bestimmt wieder leichter.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255156
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255157
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255158
    m_Localized: 'Twins: Sag so was bitte nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255159
    m_Localized: 'Twins: Ja, es kann anstrengend sein, aber ich kann sie doch nicht einfach im Stich lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255160
    m_Localized: 'Twins: Wir haben zusammen unser Elternhaus verlassen. Jetzt haben wir nur noch uns.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255161
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255162
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255163
    m_Localized: 'Twins: Danke. Hilf mir, sie reinzutragen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255164
    m_Localized: 'Twins: Der Tod unserer Eltern hat sie noch schwächer gemacht, aber sie ist schon lange so.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255165
    m_Localized: 'Twins: Vielleicht kommt sie hier ein bisschen darüber hinweg.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255166
    m_Localized: 'Twins: Oh nein. Du hast es gehört, Schwesterherz. Wir müssen unser Glück woanders probieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255167
    m_Localized: 'Twins: Komm, wir gehen. Hilf mir ein bisschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255168
    m_Localized: 'Twins: Bei Gott, wenn das hier vorbei ist ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714688
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714689
    m_Localized: 'Firefighter: Vor unserem Löscheinsatz haben sie uns diesen Zettel gegeben.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714690
    m_Localized: 'Firefighter: Sie wollten, dass wir in die FEMA-Quarantänezonen gehen. Aber wer geht schon dorthin, wenn dort jeder stirbt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714691
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714692
    m_Localized: 'Firefighter: Hier, ich brauche es sowieso nicht. Schmeißen Sie es weg oder machen Sie damit, was Sie wollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714693
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714694
    m_Localized: 'Firefighter: Ich habe einen *hust, hust* Zettel dabei. Er ist ziemlich wichtig.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714695
    m_Localized: 'Firefighter: Sie können ihn haben, wenn Sie mich reinlassen, damit ich meine letzten Tage in Frieden verbringen kann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714696
    m_Localized: Na gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714697
    m_Localized: Nein, behalten Sie ihn
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714698
    m_Localized: 'Wheelchair: Was zur Hölle?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714699
    m_Localized: 'Wheelchair: Sie scheinen ein normaler Kerl zu sein. Vielleicht kann ein EnerJeka Ihre Meinung ändern?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714700
    m_Localized: 'Wheelchair: Ich bin ganz erschöpft vom Weg hierher! Das war ein hartes Stück Arbeit!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714701
    m_Localized: Na gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714702
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714703
    m_Localized: 'Wheelchair: Hey, nehmen Sie einen EnerJeka! Danke fürs Reinlassen!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908992
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908993
    m_Localized: 'Anger: Verdammt ... Verdammte Scheiße ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908994
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908995
    m_Localized: 'Anger: Ich würde ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908996
    m_Localized: 'Anger: Na, wie wär’s: Ich gebe Ihnen einen EnerJeka und Sie lassen mich rein?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908997
    m_Localized: 'Anger: So kommt jeder auf seine Kosten.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908998
    m_Localized: Na gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908999
    m_Localized: Hauen Sie ab
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909000
    m_Localized: 'Anger: Machen Sie sich um mich keine Sorgen ... Ich bin sowieso nur ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909001
    m_Localized: 'Anger: Nehmen Sie den EnerJeka.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909002
    m_Localized: 'Anger: Ich brauche diesen Müll nicht. Es wäre besser, wenn ich mich verdammt noch mal beruhige.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909003
    m_Localized: 'Anger: Wie ich sehe, ist {0} schon hier. Ich habe es sofort bemerkt: Alle halten den Atem an und verbeugen sich, damit sie bloß nicht angerührt werden. Das geht mir gegen den Strich.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909004
    m_Localized: 'Anger: Ich hasse es, auch nur in ihrer Nähe zu sein. Entweder dieses verdammte Ding oder ich. Anders geht es nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909005
    m_Localized: 'Anger: Ich kann nicht mit Leuten zusammenleben, die sich dauernd auf die Zunge beißen.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909006
    m_Localized: Schon gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909007
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909008
    m_Localized: 'Anger: Na gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909009
    m_Localized: 'Anger: Danke, dass Sie ein Machtwort sprechen, wenn es drauf ankommt.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909010
    m_Localized: 'Anger: Ich versuche ... Ach, Sie wissen schon.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909011
    m_Localized: 'Anger: Aha.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909012
    m_Localized: 'Anger: Sie hängen wohl lieber mit den Leuten aus der Gegend ab?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909013
    m_Localized: 'Anger: Sie sind mir scheißegal. Fahren Sie zur Hölle!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909014
    m_Localized: 'Fanatic: Hier ist eine großzügige Belohnung von der Heiligen Sonne HÖCHSTPERSÖNLICH: Sie haben es verdient, Mann. Nehmen Sie den EnerJeka!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909015
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909016
    m_Localized: 'Fanatic: Wie dumm kann man sein?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909017
    m_Localized: 'Fanatic: Sie jagen einen RECHTSCHAFFENEN MANN davon!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909018
    m_Localized: 'Fanatic: Wenn Sie mich reinlassen, bekommen Sie eine großzügige Belohnung von der HEILIGEN SONNE höchstpersönlich. Denken Sie darüber nach, guter Mann!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909019
    m_Localized: Na gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909020
    m_Localized: Hauen Sie ab
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297600
    m_Localized: 'Super: Niemand weiß, was passiert ist, als der letzte Besucher gekommen ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297601
    m_Localized: 'Super: Das Haus steht schon seit einer Weile leer.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297602
    m_Localized: 'Super: Seit Ihrem Verschwinden meiden alle das verlassene Haus.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297603
    m_Localized: 'NotTrue: Hey, alter Freund ... Was haben Sie da, {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297604
    m_Localized: 'NotTrue: Ständig poltert es irgendwo oder jemand flüstert in den Schatten ... Solche Orte machen mir Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297605
    m_Localized: 'NotTrue: Ich wandere nicht aus Spaß allein herum, wissen Sie? Zu viel Geschrei oder zu viele Gesichter halte ich nicht aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297606
    m_Localized: 'NotTrue: Wenn Sie besser mit ihnen zurechtkommen, nur zu. Ich warte auf der Veranda, bis sich die Lage beruhigt hat. Nehmen Sie es mir nicht übel, aber bei so einem Sturm gehe ich nicht raus.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297607
    m_Localized: 'NotTrue: Ich halte das einfach nicht aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297608
    m_Localized: Schon gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297609
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297610
    m_Localized: 'NotTrue: Wenn das so ist, probiere ich es. Aber wenn es wieder nach Sturm oder gespiegelten Lügen riecht, gehe ich. Ich bin zu alt für so was.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297611
    m_Localized: 'NotTrue: Wissen Sie, ich fühle mich hier nicht wohl. Also gehe ich mit meinen Geschichten woandershin.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297612
    m_Localized: 'NotTrue: Aber halten Sie die Augen offen. Manchmal ist die Wahrheit leise, aber tödlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297613
    m_Localized: 'Twins: Bitte ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297614
    m_Localized: 'Twins: Bitte lass uns rein, wenigstens für einen Tag. Wir haben etwas ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297615
    m_Localized: 'Twins: Wir revanchieren uns ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297616
    m_Localized: Na gut, kommt rein
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297617
    m_Localized: Haut ab
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297618
    m_Localized: 'Twins: Danke!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297619
    m_Localized: 'Twins: Hier, nimm einen EnerJeka. Das ist alles, was wir haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297620
    m_Localized: 'Twins: Und jetzt hilf mir, meine Schwester reinzubringen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297621
    m_Localized: 'Twins: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297622
    m_Localized: 'Twins: Wahrscheinlich nicht, {0} ist hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297623
    m_Localized: 'Twins: Die Luft fühlt sich schwerer an als sonst. Als ob die Gedanken eines anderen lauter sind als meine.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297624
    m_Localized: 'Twins: Sie kann damit nicht umgehen. Sie fängt einfach an zu schrumpfen. Als würde sie aufhören zu existieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297625
    m_Localized: 'Twins: Ich ... Ich kriege auch kaum Luft.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297626
    m_Localized: 'Twins: Tut mir leid. Wir warten, bis ... sich alles beruhigt hat. Vielleicht geht es ja einfach vorbei.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297627
    m_Localized: Schon gut, kommt rein
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297628
    m_Localized: Verschwindet
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297629
    m_Localized: 'Twins: Danke. Vorsichtig, du musst ihren Rücken mit einer Hand stützen ... Genau so.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297630
    m_Localized: 'Twins: Ich glaube, der Tod unserer Eltern hat etwas in ihr kaputt gemacht. Aber sie gibt ihr Bestes.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297631
    m_Localized: 'Twins: Wir sind schon eine ganze Weile draußen. Ich hatte gehofft, dass es ihr hier wenigstens ein bisschen besser gehen würde.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297632
    m_Localized: 'Twins: ... Verstanden.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297633
    m_Localized: 'Twins: Halte noch ein bisschen durch, Schwester. Wir schaffen das schon. Hier, stütz dich an mir ab.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297634
    m_Localized: 'Twins: Manchmal ist alles einfach ... zu viel. Sogar eine einfache Tür. Aber wir müssen weitermachen. Komm schon, einen Fuß vor den anderen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158001
    m_Localized: 'Tourist: Tja ... Zu schade.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158000
    m_Localized: 'Tourist: Vielen herzlichen Dank.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157995
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157998
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157999
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157997
    m_Localized: 'Tourist: Hier ist {0}. Ich glaube nicht, dass wir miteinander auskommen werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157996
    m_Localized: 'Tourist: Entschuldigen Sie, aber ich fürchte, ich kann noch nicht reinkommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157994
    m_Localized: Na gut, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157993
    m_Localized: 'Alt: Na, sind wir uns einig?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157992
    m_Localized: 'Alt: Okay. Hier, {0}. Reicht das?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157991
    m_Localized: 'Alt: Ich bin’s gewohnt. Und ich weiß, worauf du hinauswillst.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157990
    m_Localized: 'Alt: Zu dumm, dass Arschlöcher immer das Glück gepachtet haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157989
    m_Localized: 'Alt: Noch ist Zeit. Ich finde eine andere Lösung.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157988
    m_Localized: 'Alt: Tja.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157987
    m_Localized: 'Alt: Danke. Das hatte ich nicht erwartet, aber gehofft.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157986
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157985
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157984
    m_Localized: 'Alt: Aber wir werden auf keinen Fall zusammen unter einem Dach wohnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157983
    m_Localized: 'Alt: Das ist eine lange Geschichte und ich will dich nicht damit behelligen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157982
    m_Localized: 'Alt: Sieh mal einer an, {0} ist auch hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157981
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157980
    m_Localized: Na gut, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157979
    m_Localized: 'FunnyGuy: Wäre die Sache damit geklärt?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157978
    m_Localized: 'FunnyGuy: Oh, sieh mal, was ich gefunden habe – {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157977
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157976
    m_Localized: 'FunnyGuy: Hier, ich geb dir was ... Was hab ich denn hier?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157975
    m_Localized: 'FunnyGuy: Na gut. Das ist das letzte Mal, dass ich darauf reinfalle.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157974
    m_Localized: 'FunnyGuy: Mann, du erinnerst mich an diese gottverdammten Banken. Scheiße.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157973
    m_Localized: 'FunnyGuy: Alles klar, ich hau dann mal ab. Bis Sonnenaufgang hab ich noch Zeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157972
    m_Localized: 'FunnyGuy: Ich versteh schon.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157971
    m_Localized: 'FunnyGuy: Stoßen wir jetzt auf das Ende der Schulden an? Hahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157970
    m_Localized: 'FunnyGuy: Na, wer sagt’s denn!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157969
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157968
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157967
    m_Localized: 'FunnyGuy: Ich hatte schon genug Pech in meinem Leben. Können wir wenigstens diesen Ort sauber halten?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157966
    m_Localized: 'FunnyGuy: Da drüben, {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157965
    m_Localized: 'FunnyGuy: Oh nein. Du hast hier jemanden, der mir den ganzen Spaß verdirbt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157964
    m_Localized: 'Fairytaller: Verstehe. Na dann, machen Sie’s gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157963
    m_Localized: 'Fairytaller: Aber ich weiß Ihr Vertrauen natürlich zu schätzen!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157962
    m_Localized: 'Fairytaller: Was?! Danke! Das wäre doch nicht nötig gewesen ... Ich hätte mir auch einen anderen Ort suchen können.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157961
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157960
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157959
    m_Localized: 'Fairytaller: Aber ich fürchte, ich werde mich nicht wohlfühlen, wenn {0} auch hier ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157958
    m_Localized: 'Fairytaller: Ich weiß, ich habe schon viel von Ihrer Zeit in Anspruch genommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157957
    m_Localized: 'Fairytaller: Und ehrlich gesagt glaube ich nicht, dass es meine Schuld war.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157956
    m_Localized: 'Fairytaller: Danke! Aber ... hier scheint jemand zu sein, mit dem ich im Café ein Problem hatte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157955
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157954
    m_Localized: Na gut, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157953
    m_Localized: 'Leper: Hm ... Was, wenn ich dir was gebe? Hier, {0}. Lässt du mich dann rein?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157952
    m_Localized: 'Leper: Na ja, deine Entscheidung. Dann gehe ich eben.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769382
    m_Localized: 'Leper: Hast du in deinem Haus wirklich Platz für Leute, die andere für ihr Aussehen verspotten?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769381
    m_Localized: 'Leper: Danke. Ich will mir das wirklich nicht noch einmal antun.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769380
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769379
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769378
    m_Localized: 'Leper: Hier ist {0}. Diese Person hat mich früher wegen meines Aussehens drangsaliert.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769377
    m_Localized: 'Leper: Tut mir leid, aber ich glaube nicht, dass ich reinkommen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769376
    m_Localized: 'Nervous: Wer sich mit Arschlöchern umgibt, hat wahrscheinlich Dreck am Stecken. Hihi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769375
    m_Localized: 'Nervous: Vielleicht sollte ich lieber nicht bei dir bleiben. Ja ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769374
    m_Localized: 'Nervous: Ernsthaft?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769373
    m_Localized: 'Nervous: Man sollte sich nicht in verrrrrückten Kram einmischen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769372
    m_Localized: 'Nervous: Unangenehm. Aber was soll’s! Hihi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769371
    m_Localized: 'Nervous: Sehr gut ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769370
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769369
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769368
    m_Localized: 'Nervous: Ich weiß, wovon ich spreche ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769367
    m_Localized: 'Nervous: Er ist verrrrrückt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769366
    m_Localized: 'Nervous: Ich weiß, was vor einem Monat passiert ist. Ich weiß es nur zu gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769365
    m_Localized: 'Nervous: Oh ... In deinem Haus ist {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769364
    m_Localized: 'Bald: Pass auf dich auf, ja? Ich hoffe, du überstehst diese ganze Scheiße.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769363
    m_Localized: 'Bald: Ich versteh schon. Nichts für ungut.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769362
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769361
    m_Localized: 'Bald: Mist.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769360
    m_Localized: 'Bald: Ich weiß, es ist unangenehm, jemanden rauszuschmeißen. Aber so ist das Leben. Man kann nicht immer nur nett sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769359
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769358
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769357
    m_Localized: 'Bald: Ja, {0} ist gemeint. Vielleicht sollten wir ... die Person vor die Tür setzen?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769356
    m_Localized: 'Bald: Ich komme ja echt mit so ziemlich jedem aus. Aber das hier wird schwierig. Ein Warnsignal nach dem anderen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769355
    m_Localized: 'Tough: Was für eine Enttäuschung.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769354
    m_Localized: 'Tough: Sag bloß, du hast nicht den Mumm dazu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769353
    m_Localized: 'Tough: Was zur Hölle? Von dir hätte ich mehr Rückgrat erwartet.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769352
    m_Localized: 'Tough: Sieht aus, als wärst du nicht auf allzu viel Gegenwehr gestoßen. Da fehlt es wohl jemandem an Kampfgeist.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769351
    m_Localized: 'Tough: Hm. Ich hätte nicht gedacht, dass du das wirklich machst.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769350
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769349
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769348
    m_Localized: 'Tough: Entweder du wirfst die Person raus oder ich suche mir was anderes.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769347
    m_Localized: 'Tough: Wer ist denn {0} da?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769346
    m_Localized: 'Jacket: Ich sollte lieber gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769345
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769344
    m_Localized: 'Jacket: Verdammt ... Die FEMA wird mich finden.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722946
    m_Localized: 'Tourist: Ich wünschte, ich wäre nie hergekommen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722945
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722944
    m_Localized: 'Tourist: Verdammt ... Wo soll ich nur hin? Ich habe es schon bei jedem anderen Haus versucht.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722943
    m_Localized: 'Tourist: Vielen Dank.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722942
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722941
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722940
    m_Localized: 'Tourist: Bitte, lassen Sie mich übernachten.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722939
    m_Localized: 'Tourist: Und jetzt weiß ich nicht, wohin.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722938
    m_Localized: 'Tourist: Ich war eine Weile im Hotel, aber dann ging mir das Geld aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722937
    m_Localized: 'Tourist: Nein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722936
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722935
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722934
    m_Localized: 'Tourist: Aber jetzt bin ich hier und kann mir kein Hotel leisten. Bitte, lassen Sie mich übernachten.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722933
    m_Localized: 'Tourist: Ja, ich weiß. Glauben Sie mir, wenn ich gewusst hätte, was mit der Sonne passiert, wäre ich nie gekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722932
    m_Localized: Sie können wirklich nirgendwohin?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722931
    m_Localized: Toller Zeitpunkt für eine Reise
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722930
    m_Localized: 'Tourist: Ich bin eigentlich nur auf der Durchreise.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722929
    m_Localized: 'Tourist: Aber dann haben sie die Grenzen geschlossen ... und jetzt sitze ich hier fest.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722928
    m_Localized: 'Tourist: Ich war auf dem Weg in die Hauptstadt und wollte abreisen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722927
    m_Localized: Sie können wirklich nirgendwohin?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722926
    m_Localized: Toller Zeitpunkt für eine Reise
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722925
    m_Localized: 'Tourist: Der Flughafen ist geschlossen, die Züge auch.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722924
    m_Localized: 'Tourist: Es gab irgendeinen Fehler. Ich komme nicht aus der Stadt raus.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722923
    m_Localized: Wie sind Sie hier gelandet?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722922
    m_Localized: Was ist das Problem?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722921
    m_Localized: 'Tourist: Hallo. Können Sie mir helfen? Ich bin nicht von hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722920
    m_Localized: 'Alt: Also, ich muss dann weiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722919
    m_Localized: 'Alt: Es gibt noch ein paar andere Häuser. Vielleicht sieht ja jemand über mein Gesicht hinweg und benimmt sich wie ein anständiger Mensch.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722918
    m_Localized: 'Alt: Das war eine brutale Woche.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722917
    m_Localized: 'Alt: Reden wir morgen. Heute bin ich zu erschöpft.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722916
    m_Localized: 'Alt: Perfekt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722915
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722914
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722913
    m_Localized: 'Alt: Am schlimmsten ist, wenn man einen Bericht hört und einem klar wird, dass in Wirklichkeit alles noch viel schrecklicher ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722912
    m_Localized: 'Alt: Das Fernsehen hat noch nie jemandem geholfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722911
    m_Localized: 'Alt: Ich weiß nicht, ob du Strom hast, aber falls nicht – umso besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722910
    m_Localized: 'Alt: Hier kühlt nachts die Luft ab. Und niemand glotzt rund um die Uhr die Nachrichten.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722909
    m_Localized: 'Alt: Ich spare mir die Förmlichkeiten und komme gleich zum Punkt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722908
    m_Localized: 'Alt: Klar.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722907
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722906
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722905
    m_Localized: 'Alt: Und ich will nicht an vorderster Front sein, wenn es losgeht.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722904
    m_Localized: 'Alt: Ich glaube, uns steht eine gewaltige Katastrophe bevor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722903
    m_Localized: 'Alt: Je länger die Sache andauert, desto schlimmer wird es. Keine Luft, mehr Kriminalität, in den Wohnblöcken macht sich Paranoia breit.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722902
    m_Localized: 'Alt: Außerdem hab ich das Gefühl, dass die Städte nicht mehr lange sicher sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722901
    m_Localized: 'Alt: Ich mag einfach nur keine Förmlichkeiten. So kommt man schneller zur Sache.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722900
    m_Localized: 'Alt: Wie kommst du darauf, dass ich vor irgendwas weglaufe?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722899
    m_Localized: Glaubst du, hier ist es besser?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722898
    m_Localized: Wovor läufst du weg?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722897
    m_Localized: 'Alt: Mein Aussehen hat nichts zu bedeuten. Ich will niemandem was Böses. Und ich hoffe, du bist niemand, der andere verurteilt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722896
    m_Localized: 'Alt: Ich habe nichts Falsches getan. Und diesen voreingenommenen Blick kannst du dir sparen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722895
    m_Localized: 'Alt: Warum so unhöflich?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722894
    m_Localized: Glaubst du, hier ist es besser?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722893
    m_Localized: Wovor läufst du weg?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722892
    m_Localized: 'Alt: Als ob die ganzen Wahnsinnigen und Besucher nicht schon genug wären, will uns jetzt auch noch die Sonne an den Kragen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722891
    m_Localized: 'Alt: Und zwar nicht nur in unserer Stadt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722890
    m_Localized: 'Alt: Aber ich hab gehört, dass am Stadtrand richtig üble Sachen abgehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722889
    m_Localized: 'Alt: Nein, ich meinte nicht, dass dein Haus verlassen aussieht.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722888
    m_Localized: Ganz schön dreist
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722887
    m_Localized: Sieht das Haus etwa leer aus?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722886
    m_Localized: 'Alt: Oh, hier wohnt also jemand. Kann ich reinkommen?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722885
    m_Localized: 'FunnyGuy: Na ja, mir wird schon was einfallen. Bis Sonnenaufgang ist ja noch Zeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722884
    m_Localized: 'FunnyGuy: Scheiße.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722883
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722882
    m_Localized: 'FunnyGuy: Keine Chance?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722881
    m_Localized: 'FunnyGuy: Du hast ja keine Ahnung, was für ein großer Tag das für mich ist!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722880
    m_Localized: 'FunnyGuy: Das wollte ich hören! Komm, wir machen zur Feier des Tages ein paar Dosen auf!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722879
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722878
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722877
    m_Localized: 'FunnyGuy: Also, lässt du mich jetzt rein?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722876
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722875
    m_Localized: 'FunnyGuy: Von so einem Haus kann ich nur träumen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722874
    m_Localized: 'FunnyGuy: Egal. Ist ja nicht dein Kredit, oder? Du hast hier schließlich ’ne nette Bude.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722873
    m_Localized: 'FunnyGuy: Was soll ich sagen? Du freust dich offensichtlich nicht für mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722872
    m_Localized: Du bist nicht sehr gesprächig
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722871
    m_Localized: 'FunnyGuy: Darauf steh ich nicht so, ehrlich gesagt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722870
    m_Localized: 'FunnyGuy: Das klang jetzt aber ziemlich sarkastisch.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722869
    m_Localized: Du bist nicht sehr gesprächig
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722868
    m_Localized: 'FunnyGuy: Nichts für ungut.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722867
    m_Localized: 'FunnyGuy: Aber ich würde nur ungern hier draußen darüber reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722866
    m_Localized: 'FunnyGuy: Verdammt, das ist ’ne gute Frage.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722865
    m_Localized: Was hast du mit dem gesparten Geld vor?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722864
    m_Localized: Was machst du hier draußen?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722863
    m_Localized: 'FunnyGuy: Ein fantastisches Gefühl!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722862
    m_Localized: 'FunnyGuy: Bei all dem Chaos schert sich doch kein Schwein mehr um Banken oder Kredite!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722861
    m_Localized: 'FunnyGuy: Jetzt schulde ich niemandem mehr irgendwas!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722860
    m_Localized: 'FunnyGuy: Aber JETZT ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722859
    m_Localized: 'FunnyGuy: Alles ging den Bach runter.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722858
    m_Localized: 'FunnyGuy: Tja, vor Kurzem steckte ich noch bis zum Hals in Schulden.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722857
    m_Localized: Was hast du mit dem gesparten Geld vor?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722856
    m_Localized: Was machst du hier draußen?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722855
    m_Localized: 'FunnyGuy: Endlich kann ich frei durchatmen. Du hast ja keine Ahnung.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722854
    m_Localized: 'FunnyGuy: Kumpel ... Nein, Bruder! Meine Hypothek ist kein Problem mehr!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722853
    m_Localized: 'FunnyGuy: Ach komm, sei nicht so! Du kapierst es nur noch nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722852
    m_Localized: Warum so fröhlich?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722851
    m_Localized: Bist du übergeschnappt?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722850
    m_Localized: 'FunnyGuy: Was für eine Nacht, oder? Fühlst du das? Pure Magie!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722849
    m_Localized: 'FunnyGuy: Hey, hey, hey, was geht ab?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722848
    m_Localized: 'Fairytaller: Ich verstehe. Passen Sie auf sich auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722847
    m_Localized: 'Fairytaller: Gut zu wissen, dass es noch freundliche Menschen gibt – und nicht nur in Geschichten.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722846
    m_Localized: 'Fairytaller: Vielen, vielen Dank! Das werde ich Ihnen nicht vergessen!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722845
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722844
    m_Localized: Na gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722843
    m_Localized: 'Fairytaller: Ich hätte nie gedacht, dass das Erwachsenwerden so schwer ist ... und ich kann sonst nirgendwo hin ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722842
    m_Localized: 'Fairytaller: Ich werde es Ihnen irgendwann zurückzahlen. Und ich kann auch jetzt schon helfen, so gut ich kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722841
    m_Localized: 'Fairytaller: Ich weiß, ich habe nicht viel zu bieten ... aber überlegen Sie es sich bitte noch mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722840
    m_Localized: 'Fairytaller: Verstehe ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722839
    m_Localized: Ich brauche hier keine Schmarotzer
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722838
    m_Localized: Na gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722837
    m_Localized: 'Fairytaller: Ich bezweifle, dass ich uns retten kann. Aber in jeder Geschichte siegt am Ende das Gute.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722836
    m_Localized: 'Fairytaller: Wenn doch nur ein Held auftauchen würde, um das Böse zu besiegen, damit alles wieder so werden kann wie früher.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722835
    m_Localized: 'Fairytaller: Die Leute bekommen Angst, verstecken sich, vertrauen einander nicht mehr ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722834
    m_Localized: 'Fairytaller: Alles wirkt wie in den Märchen, mit denen wir aufgewachsen sind. In denen sich das Böse auf der ganzen Welt ausbreitet.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722833
    m_Localized: 'Fairytaller: Aber ich glaube, ich bin immer noch so, wie ich immer war. Zumindest verspüre ich keinen Drang, jemandem etwas anzutun.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722832
    m_Localized: 'Fairytaller: Vielleicht habe ich sogar ein paar ihrer Merkmale. Ich weiß es nicht. In letzter Zeit ist alles so seltsam.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722831
    m_Localized: 'Fairytaller: Ehrlich gesagt bin ich mir immer noch nicht sicher, wer diese Besucher genau sind oder was sie von uns unterscheidet.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722830
    m_Localized: Ich brauche hier keine Schmarotzer
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722829
    m_Localized: Na gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722828
    m_Localized: 'Fairytaller: Ich versuche nützlich zu sein, bis ich wieder auf den Beinen bin. Und ich verspreche, mich eines Tages zu revanchieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722827
    m_Localized: 'Fairytaller: Ich hasse es, anderen zur Last zu fallen. Aber wenn es hart auf hart kommt, muss man sehen, wie man überlebt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722826
    m_Localized: 'Fairytaller: Kurz danach sind seine Halbgeschwister eingezogen. Ich werfe es ihm nicht vor, aber ich hoffe, Sie können mich auch verstehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722825
    m_Localized: 'Fairytaller: Als dann diese ganze Misere losging, hat er mich rausgeworfen – angeblich wegen meiner Arbeitslosigkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722824
    m_Localized: 'Fairytaller: Mein Vermieter wollte von Anfang an nicht an einen Hochschulabsolventen ohne festes Einkommen vermieten.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722823
    m_Localized: 'Fairytaller: ... Sie sehnen sich nach ihrer sorgenfreien Kindheit zurück.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722822
    m_Localized: 'Fairytaller: In schwierigen Zeiten wollen die Menschen einfach nur alles ausblenden und für einen Moment alle Probleme vergessen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722821
    m_Localized: 'Fairytaller: Für diejenigen, die in Nachtclubs untergekommen sind, scheint es besser gelaufen zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722820
    m_Localized: 'Fairytaller: Aber nach allem, was passiert ist, kamen keine Gäste mehr und wir wurden alle entlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722819
    m_Localized: 'Fairytaller: Ich konnte nach meinem Studium keinen Job in meinem Bereich finden, also habe ich in einem kleinen Café angeheuert.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722818
    m_Localized: Woher weiß ich, dass Sie kein Besucher sind?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722817
    m_Localized: Was führt Sie hierher?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722816
    m_Localized: 'Fairytaller: Guten Abend. Hätten Sie vielleicht noch Platz für mich? Ich brauche wirklich nicht viel.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039811
    m_Localized: 'Leper: Wie du willst. Dann gehe ich eben wieder.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039810
    m_Localized: 'Leper: Danke. Dafür, dass du mich reinlässt – und dass du mich nicht wegen meines Aussehens verurteilst.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039809
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039808
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039807
    m_Localized: 'Leper: Also, lässt du mich jetzt rein oder nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039806
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039805
    m_Localized: 'Leper: Ich weiß, was ich bin. Und ich bin keiner von denen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039804
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039803
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039802
    m_Localized: 'Leper: Also, lässt du mich jetzt rein oder nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039801
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039800
    m_Localized: 'Leper: Wie du meinst.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039799
    m_Localized: Was macht dich da so sicher?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039798
    m_Localized: Das werden wir noch sehen
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039797
    m_Localized: 'Leper: Ich schwöre dir, ich bin kein Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039796
    m_Localized: 'Leper: Was ich erwartet habe? Was willst du damit sagen? Glaubst du, ich habe mir mein Aussehen ausgesucht?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039795
    m_Localized: Was macht dich da so sicher?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039794
    m_Localized: Das werden wir noch sehen
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039793
    m_Localized: 'Leper: Ich kann die Leute ja verstehen, aber ich bin kein Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039792
    m_Localized: Was hast du erwartet?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039791
    m_Localized: Heutzutage sind alle paranoid
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039790
    m_Localized: 'Leper: Das ist angeboren. Ich kann nichts dagegen tun. Aber die Leute halten mich für einen Besucher. Das ist doch verrückt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039789
    m_Localized: 'Leper: Genau das meine ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039788
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039787
    m_Localized: Was hast du erwartet?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039786
    m_Localized: Heutzutage sind alle paranoid
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039785
    m_Localized: 'Leper: Überall werde ich behandelt, als wäre ich ansteckend ... oder gar ein Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039784
    m_Localized: 'Leper: Ich habe nur eine angeborene Hautkrankheit. Das ist alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039783
    m_Localized: 'Leper: Nein! Das ist es ja. Ich bin völlig harmlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039782
    m_Localized: Was ist mit deiner Haut passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039781
    m_Localized: Sollte ich mir Sorgen machen?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039780
    m_Localized: 'Leper: Hallo. Äh, hoffentlich sehe ich nicht zu übel aus, um reingelassen zu werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039779
    m_Localized: 'Nervous: Hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039778
    m_Localized: 'Nervous: Du wirst schon sehen, was du davon hast ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039777
    m_Localized: 'Nervous: Du bist auch nicht besser als diese Folterknechte in ihren Laborkitteln.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039776
    m_Localized: 'Nervous: Ein bisschen durchgeknallt? Knalli-knalli? Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039775
    m_Localized: 'Nervous: Du .. hältst mich also auch für verrrrrückt?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039774
    m_Localized: 'Nervous: Ein Ort, an dem ich das ganze Elend aussitzen kann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039773
    m_Localized: 'Nervous: Endlich!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039772
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039771
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039770
    m_Localized: 'Nervous: Außerdem habe ich in der Nähe Schüsse gehört. Aber du legst bestimmt größeren Wert auf Sicherheit, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039769
    m_Localized: 'Nervous: Jetzt versuche ich ... bei neuen Leuten gut anzukommen!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039768
    m_Localized: 'Nervous: Einer von ihnen hat bekommen, was er verdient hat, aber heutzutage bin ich vorsichtiger. Hihi!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039767
    m_Localized: 'Nervous: Alle haben es auf mich abgesehen. Jeder einzelne dieser Idioten ... schon seit der Schulzeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039766
    m_Localized: 'Nervous: Was für Freunde?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039765
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039764
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039763
    m_Localized: 'Nervous: Lieber würde ich zurück ins Hotel gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039762
    m_Localized: 'Nervous: Also ... habe ich da nicht wirklich Lust drauf! Hihi!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039761
    m_Localized: 'Nervous: Früher haben sie mir mal geholfen, aber inzwischen bin ich ihnen scheißegal!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039760
    m_Localized: 'Nervous: Ich war eine Art ... Unfall. Schwupps, da bin ich!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039759
    m_Localized: Hast du keine Freunde?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039758
    m_Localized: Warum gehst du nicht zu deinen Verwandten?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039757
    m_Localized: 'Nervous: Das erzähle ich dir alles ... später. Hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039756
    m_Localized: 'Nervous: Hotelzimmer sind winzig klein. Das erinnert mich an ... schlechte Zeiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039755
    m_Localized: 'Nervous: Dein Haus ist groß genug für alle möglichen Leute.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039754
    m_Localized: 'Nervous: Dort ist es so lala. Hier ist es besser. Hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039753
    m_Localized: Hast du keine Freunde?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039752
    m_Localized: Warum gehst du nicht zu deinen Verwandten?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039751
    m_Localized: 'Nervous: Die FEMA kam und dann war sie weg ... einfach weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039750
    m_Localized: 'Nervous: Ich kann es nicht beweisen, nein, nein, nein ... Aber ich glaube, sie ist eine Besucherin.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039749
    m_Localized: 'Nervous: Sie macht mir Angst, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039748
    m_Localized: 'Nervous: Dort ist ein Mädchen mit einem gelben Regenmantel.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039747
    m_Localized: 'Nervous: Ich mag es da nicht. Ich suche mir lieber ... einen anderen Ort.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039746
    m_Localized: Glaubst du, hier ist es besser?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039745
    m_Localized: Warum kannst du nicht einfach zurückgehen?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039744
    m_Localized: 'Nervous: Ich habe Angst zurückzugehen, darf ich hierbleiben?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039712
    m_Localized: 'Tough: Ist das ein Test?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039711
    m_Localized: 'Tough: Lass uns bei Gelegenheit ein wenig plaudern.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039710
    m_Localized: 'Tough: Es ist mir eine Ehre, hier zu sein – jetzt, wo unser Leben aus den Fugen gerät.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039709
    m_Localized: 'Tough: Wunderbar!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039708
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039707
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039706
    m_Localized: 'Tough: Im Leben geht es darum, sich allen Widrigkeiten zu widersetzen. Man bekommt nichts geschenkt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039705
    m_Localized: 'Tough: Wir überleben nur, wenn wir kämpfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039704
    m_Localized: 'Tough: Ich bin nur der Meinung, wenn wir rumsitzen und alles geschehen lassen, ist es mit der Menschheit vorbei.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039703
    m_Localized: 'Tough: Oh. Tut mir leid, wenn ich einen falschen Eindruck erweckt habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039702
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039701
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039700
    m_Localized: 'Tough: Die Menschheit hat schon Schlimmeres überstanden. Warum sollten wir jetzt aufgeben?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039699
    m_Localized: 'Tough: Verzweifelt bin ich jedenfalls nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039698
    m_Localized: 'Tough: Oh, du willst wissen, warum ich hier bin? Ha. Wer weiß? Vielleicht bin ich verrückt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039697
    m_Localized: 'Tough: Was?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039696
    m_Localized: Du klingst wie eine Psychopathin
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039695
    m_Localized: Bist du auch verzweifelt?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039694
    m_Localized: 'Tough: Wir werden überleben. Koste es, was es wolle.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039693
    m_Localized: 'Tough: An so einem Ort kann ich nicht einfach vorbeigehen. Ich glaube, wir beide sind auf einer Wellenlänge.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039692
    m_Localized: 'Tough: Dass du dir von den Besuchern nicht das Einzige nehmen lässt, was dir rechtmäßig gehört – dein Leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039691
    m_Localized: 'Tough: Dass es nicht leicht ist, hier zu überleben.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039690
    m_Localized: Du klingst wie eine Psychopathin
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039689
    m_Localized: Bist du auch verzweifelt?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039688
    m_Localized: 'Tough: Aber du bist keiner von denen. Du gibst nicht kampflos auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039687
    m_Localized: 'Tough: Die Mutigeren jagen sich eine Kugel in den Kopf. Die anderen rotten langsam vor sich hin.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039686
    m_Localized: 'Tough: Die meisten haben aufgegeben. Sie sind zu schwach, um weiterzuleben.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039685
    m_Localized: 'Tough: Nein, im Ernst.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039684
    m_Localized: Was genau sagen die Leute über mein Haus?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039683
    m_Localized: Äh ... Danke?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039682
    m_Localized: 'Tough: Aber du hast meinen Respekt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039681
    m_Localized: 'Tough: Wer hierherkommt, ist entweder verzweifelt ... oder einfach nur dumm.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039680
    m_Localized: 'Tough: Die meisten Leute machen einen großen Bogen um dein Haus.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346842873856
    m_Localized: 'Tough: Ich habe von dir gehört.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417961
    m_Localized: 'Jacket: Hier, {0}. Es ist nicht viel, aber ich hoffe, es hilft.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417960
    m_Localized: 'Jacket: Vielen Dank.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417959
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417958
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417957
    m_Localized: 'Jacket: Oh ... Tut mir leid, aber hier ist {0}. Solchen Leuten traue ich nicht über den Weg ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417956
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417955
    m_Localized: Na gut, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417954
    m_Localized: 'Jacket: Hier, {0}. Vielleicht ändert das deine Meinung?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417953
    m_Localized: 'Jacket: Ich will keiner Patrouille über den Weg laufen. Und erst recht keinen Besuchern.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417952
    m_Localized: 'Jacket: Nein, bitte ... Lass mich rein.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417951
    m_Localized: 'Jacket: Hier, {0}. Es ist nicht viel, aber ich hoffe, es hilft.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417950
    m_Localized: 'Jacket: Vielen Dank.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417949
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417948
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417947
    m_Localized: 'Jacket: Ich will da nicht hin.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417946
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417945
    m_Localized: 'Jacket: Aber ich habe gehört, dass sie die Infizierten in Quarantänezonen bringen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417944
    m_Localized: 'Jacket: Eines Tages tauchten sie auf und meinten, sie müssten jeden untersuchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417943
    m_Localized: 'Jacket: FEMA ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417942
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417941
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417940
    m_Localized: 'Jacket: Ich will auf keinen Fall in einer Quarantänezone landen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417939
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417938
    m_Localized: 'Jacket: Sie haben angefangen, die Leute zusammenzutreiben ... Und ich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417937
    m_Localized: 'Jacket: FEMA ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417936
    m_Localized: Was ist mit deinem Wohnheim passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417935
    m_Localized: Warum?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417934
    m_Localized: 'Jacket: Ich habe im Studentenwohnheim gewohnt, aber ich musste weg von dort ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417933
    m_Localized: 'Jacket: Ja. Lass mich bitte rein.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417932
    m_Localized: Was ist mit deinem Wohnheim passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417931
    m_Localized: Warum?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417930
    m_Localized: 'Jacket: Ins Wohnheim kann ich nicht mehr ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417929
    m_Localized: 'Jacket: Ja, eine Unterkunft. Ich kann sonst nirgendwo hin.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417928
    m_Localized: Suchst du einen Unterschlupf?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417927
    m_Localized: Brauchst du etwas?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417926
    m_Localized: 'Jacket: Hallo. Kannst du mich bitte reinlassen?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417925
    m_Localized: 'Experienced: Kluge Entscheidung, Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417924
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417923
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417922
    m_Localized: 'Experienced: Du weißt schon, {0}. Solche Typen kenne ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417921
    m_Localized: 'Experienced: Hör zu, Kumpel. Du hast da einen echt üblen Mistkerl bei dir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417920
    m_Localized: 'Experienced: Adios, du Pfeife.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417919
    m_Localized: 'Experienced: Na, du bist mir aber ein Spaßvogel.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417918
    m_Localized: 'Experienced: Kluge Entscheidung, Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417917
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417916
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417915
    m_Localized: 'Experienced: Aber genug gelabert. Lässt du mich jetzt übernachten, oder was?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417914
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417913
    m_Localized: 'Experienced: Ich bin pleite, meine Alte ist mit irgendeinem anderen Clown durchgebrannt und ich hab kein Dach über dem Kopf.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417912
    m_Localized: 'Experienced: Wenn die Zeit abgesessen ist, heißt es Abmarsch.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417911
    m_Localized: 'Experienced: Ich wär am liebsten geblieben. Aber glaubst du, mich hat irgendjemand gefragt?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417910
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417909
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417908
    m_Localized: 'Experienced: Aber genug gelabert. Lässt du mich jetzt hier übernachten, Kumpel?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417907
    m_Localized: 'Experienced: Mitten in der Pampa, wo nicht irgendwelche Penner rumschnüffeln. Gefällt mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417906
    m_Localized: 'Experienced: Und dann seh ich diese Bude – sauber, ruhig, schön abgelegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417905
    m_Localized: 'Experienced: Ich bin pleite, meine Alte ist mit irgendeinem anderen Clown durchgebrannt und ich hab kein Dach über dem Kopf.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417904
    m_Localized: 'Experienced: Ich kann nirgendwohin, Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417903
    m_Localized: Warum bist du nicht im Knast geblieben?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417902
    m_Localized: Und was willst du bei mir?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417901
    m_Localized: 'Experienced: Tja, jetzt bin ich wohl wieder auf der Straße.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417900
    m_Localized: 'Experienced: Und jetzt? Die ganze verdammte Welt spielt verrückt. Die Sonne knallt runter, als wollte sie mir die Eier frittieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417899
    m_Localized: 'Experienced: Ich wäre sogar länger geblieben, aber sie haben mich rausgeschmissen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417898
    m_Localized: 'Experienced: Ich hab schon ein paar Mal gesessen, Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417897
    m_Localized: Warum bist du nicht im Knast geblieben?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417896
    m_Localized: Und was willst du bei mir?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417895
    m_Localized: 'Experienced: Ich hab viel gesehen. Sobald ich aus dem Bau war, hab ich diesen ganzen Schrott abgerissen. Jetzt kann ich wieder durchatmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417894
    m_Localized: 'Experienced: Alle laufen rum, als würde es schneien oder so. Was für Clowns.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417893
    m_Localized: 'Experienced: Ist das nicht offensichtlich? Hier draußen ist es so heiß wie im Arsch des Teufels. Keine Ahnung, warum das niemand kapiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417892
    m_Localized: Wo zum Teufel kommst du her?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417891
    m_Localized: Warum läufst du in Unterwäsche rum?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417890
    m_Localized: 'Experienced: Lässt du mich rein, Kumpel?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417889
    m_Localized: 'Rocker: Wenn du mich nicht reinlässt, dann eben jemand anders.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417888
    m_Localized: 'Rocker: Scheiß drauf.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417887
    m_Localized: 'Rocker: Aber ohne Gitarre ist es einfach nicht dasselbe.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417886
    m_Localized: 'Rocker: Alles klar, wir rocken weiter!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417885
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417884
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417883
    m_Localized: 'Rocker: Ja genau, {0} – solche Leute gehören rausgeschmissen!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417882
    m_Localized: 'Rocker: Nee, so einem Arschloch will ich nicht zu nahe kommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417881
    m_Localized: 'Rocker: Ich versuch, bei einem meiner Freunde unterzukommen. Hoffentlich haben die noch nicht alle den Löffel abgegeben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417880
    m_Localized: 'Rocker: Verstanden, Bruder. Nichts für ungut.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417879
    m_Localized: 'Rocker: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417878
    m_Localized: 'Rocker: ... Oder auch nicht! Deine Entscheidung, Mann!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417877
    m_Localized: 'Rocker: Danke, Mann. Ich dreh ab und zu ein bisschen Mucke auf, ja? Wenn ich ’ne Gitarre auftreiben kann, spiel ich dir was vor.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417876
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417875
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417874
    m_Localized: 'Rocker: Und mal ehrlich, wenn ich ein Besucher wäre, würde ich die Tür eintreten oder durch ein Fenster klettern. Aber ich stehe einfach nur hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417873
    m_Localized: 'Rocker: Diese Wichser haben sogar meine Gitarre geschrottet. Der ganze Scheiß hier macht die Leute zu Tieren, Mann.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417872
    m_Localized: 'Rocker: Ich hatte bis zum Morgengrauen einen Gig, dann sind ein paar Spinner aufgetaucht und haben angefangen, unser Zeug zu klauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417871
    m_Localized: 'Rocker: Weil ich’s bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417870
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417869
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417868
    m_Localized: 'Rocker: In der Nähe haben sie wohl einen Besucher gefunden. Deshalb kontrollieren sie jetzt jeden. Von mir aus – solange keiner durchdreht.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417867
    m_Localized: 'Rocker: Nichts Besonderes. Nur ’nen Mini-Verstärker und ’n paar Flaschen Wasser. Du kannst den Verstärker benutzen, falls du spielen kannst.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417866
    m_Localized: Warum siehst du so übermüdet aus?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417865
    m_Localized: Was hast du dabei?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417864
    m_Localized: 'Rocker: Die Kacke ist gerade echt am Dampfen – als würde man einen A-Promi ohne Security in einer Spelunke auftreten lassen!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417863
    m_Localized: 'Rocker: Ach ja, Schmarotzer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417862
    m_Localized: 'Rocker: Lass mich hier für ein paar Nächte pennen. Ich will auch nicht ewig bleiben. Ich bin kein ... äh ... Wie heißt das noch mal?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417861
    m_Localized: 'Rocker: Hey, Mann, mach auf. Die Sonne knallt runter wie ein Scheinwerfer. Wenn das so weitergeht, bin ich bald blind.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417860
    m_Localized: 'Unstable: Vielleicht versuche ich mal, mich anzuschließen. Klingt interessant.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417859
    m_Localized: 'Unstable: Und dann wirft er sie ins Feuer!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417858
    m_Localized: 'Unstable: Es gibt Geschichten über irgendeinen Spinner, der Leute um sich schart und ihnen eine Gehirnwäsche verpasst.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417857
    m_Localized: 'Unstable: Na, dann schau ich mal, was woanders so los ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417856
    m_Localized: 'Unstable: Langweilig. Immer dasselbe ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417855
    m_Localized: 'Unstable: Na gut, man sieht sich.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417854
    m_Localized: 'Unstable: Würde mich echt mal interessieren, wie viel er mit dem Scheiß verdient hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417853
    m_Localized: 'Unstable: Ich hab von einem Typen gehört, der Luft verkauft. Ist das nicht der Knaller?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417852
    m_Localized: 'Unstable: Kein Problem, ich schau einfach woanders vorbei.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417851
    m_Localized: 'Unstable: Na ja, egal. Dafür erzähl ich dir jetzt allen möglichen Kram!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417850
    m_Localized: 'Unstable: Tut mir leid, ich dachte, das wär total witzig.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417849
    m_Localized: 'Unstable: Hahaha, ich weiß nicht mal, wer das war.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417848
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417847
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417846
    m_Localized: 'Unstable: Die machen nichts als Ärger. Nee, so wird das nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417845
    m_Localized: 'Unstable: Ich rede nicht gern, wenn solche Leute in der Nähe sind. Die drehen einem die Worte im Mund um.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417844
    m_Localized: 'Unstable: Oh, da drinnen ist ja {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417843
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417842
    m_Localized: Na gut, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417841
    m_Localized: 'Unstable: Hier, {0}. Na, Interesse?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417840
    m_Localized: 'Unstable: Oder ... warte mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417839
    m_Localized: 'Unstable: Bock auf ’nen EnerJeka? Das ist aber nicht alles, was ich hab!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417838
    m_Localized: 'Unstable: Mist. Warte, ich hab allen möglichen Kram dabei.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417837
    m_Localized: 'Unstable: Und ich kann dir meine eigenen Geschichten erzählen. Wir unterhalten uns einfach ein bisschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417836
    m_Localized: 'Unstable: Also, du erzählst mir, was hier so los ist, abgemacht?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417835
    m_Localized: 'Unstable: Oh, cool!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417834
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417833
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417832
    m_Localized: 'Unstable: Ich hab’s jedenfalls langsam satt, vor deiner Tür zu stehen. Wenn du mich reinlässt, erzähl ich dir, was ich gesehen hab.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417831
    m_Localized: 'Unstable: Nicht gerade die klügste Strategie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417830
    m_Localized: 'Unstable: Die Leute geraten in Panik, machen entweder gar nicht erst auf oder schießen auf alles, was sich bewegt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417829
    m_Localized: 'Unstable: Ich hab ein paar interessante Orte gesehen, aber es ist immer wieder dasselbe.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417828
    m_Localized: 'Unstable: Ich hab’s dir doch schon gesagt. Ich beobachte nur, wie die Leute überleben.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417827
    m_Localized: 'Unstable: Du hörst mir nicht zu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417826
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417825
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417824
    m_Localized: 'Unstable: Lässt du mich rein?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417823
    m_Localized: 'Unstable: Aber deine Bude hier scheint mir interessant zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417822
    m_Localized: 'Unstable: Ich laufe, bis ich finde, was ich suche ... was auch immer das sein mag.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417821
    m_Localized: 'Unstable: Dann laufe ich weiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417820
    m_Localized: Läufst du vor jemandem davon?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417819
    m_Localized: Und was dann?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417818
    m_Localized: 'Unstable: Wir sollten Überlebenstipps austauschen, hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417817
    m_Localized: 'Unstable: Aber ich bin auch noch nicht tot! Wir scheinen also beide irgendwas kapiert zu haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417816
    m_Localized: 'Unstable: Na ja, immerhin lebst du noch. Und redest mit mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417815
    m_Localized: 'Unstable: Und du sitzt hier fest. Glaubst du, dass du hier sicher bist?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417814
    m_Localized: Läufst du vor irgendetwas davon?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417813
    m_Localized: Und was dann?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417812
    m_Localized: 'Unstable: Aber nicht mit mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417811
    m_Localized: 'Unstable: Allein.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417810
    m_Localized: 'Unstable: Ich wär einfach gestorben.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417809
    m_Localized: 'Unstable: Wäre ich in meiner Wohnung geblieben, hätte ich’s nie rausgefunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417808
    m_Localized: 'Unstable: Wer weiß, vielleicht ist die letzte Hoffnung der Menschheit ja irgendwo in deinem Haus gebunkert?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417807
    m_Localized: 'Unstable: Je weiter ich komme, desto größer die Chance, eine Lösung zu finden. Kapierst du das nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417806
    m_Localized: 'Unstable: Was soll das heißen?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417805
    m_Localized: Man kann Problemen nicht davonlaufen
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417804
    m_Localized: Willst du dich nicht in Sicherheit bringen?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417803
    m_Localized: 'Unstable: Ich bin nachts unterwegs. Bevor die Sonne mich brutzelt, bin ich wieder drinnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417802
    m_Localized: 'Unstable: Mein Vorrat reicht für ’ne ganze Weile. Frag bloß nicht, wo ich ihn verstecke.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417801
    m_Localized: 'Unstable: Ich hab meinen treuen EnerJeka dabei.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417800
    m_Localized: Man kann Problemen nicht davonlaufen
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417799
    m_Localized: Willst du dich nicht in Sicherheit bringen?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417798
    m_Localized: 'Unstable: Ich ziehe weiter, bis ich verbrenne. Oder bis die Besucher mich auffressen. Was auch immer zuerst passiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417797
    m_Localized: 'Unstable: Ein Sturm zieht auf. Und ich bin irgendwie neugierig, wie die Leute damit klarkommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417796
    m_Localized: 'Unstable: Irgendwohin, weit weg. Ich kann nicht an einem Ort bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417795
    m_Localized: Ich habe hier kein Ladegerät
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417794
    m_Localized: Wohin des Weges so aufgedreht?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417793
    m_Localized: 'Unstable: Ich bin gerade total aufgedreht. Aber EnerJeka knallt nicht mehr so wie früher. Ich könnte ’ne Aufladung vertragen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417792
    m_Localized: 'Unstable: Oh, hey! Da ist ja jemand. Cool!'
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264643
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264642
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264641
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264640
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 61235008206004224
    m_Localized: Intro überspringen
    m_Metadata:
      m_Items: []
  - m_Id: 58250202329374720
    m_Localized: Ich werfe sie raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 58250202325180416
    m_Localized: 'TV: Falls Sie einen Besucher nicht sofort an eine Quarantänezone übergeben können, geben Sie ihm eine Einladung der FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306408796160
    m_Localized: 'MushroomEater: Es sieht aus, als würde das Festival trotz allem stattfinden ...'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306387824640
    m_Localized: 'MushroomEater: Oh, mein lieber Freund ... Das ist gar nicht gut ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692481
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692480
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177088
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205570
    m_Localized: 'Gasmask: In Ordnung. Auf Wiedersehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205569
    m_Localized: 'Gasmask: Das muss schwer sein. Für Sie. Für uns. Wie sollen wir einen Bezirk kontrollieren, in dem sich niemand aufhält?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205568
    m_Localized: 'Gasmask: Sind Sie allein?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336336011264
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283083
    m_Localized: 'MushroomEater: Leb wohl.'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283082
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283081
    m_Localized: 'MushroomEater: Ah ... Vielleicht verschwende ich nur meine Zeit ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283080
    m_Localized: 'MushroomEater: Hallo, mein Junge. Hast du vergessen, worum ich dich gebeten habe? Hast du die Hinweise im Lächelleitfaden nicht gesehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311553
    m_Localized: 'Fanatic: {0}. Lassen Sie mich rein, und Sie bekommen diese großzügige Belohnung der GROSSEN SONNE persönlich. Na, schon anders überlegt?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311552
    m_Localized: 'Fanatic: Hier ist eine großzügige Belohnung von der GROSSEN SONNE persönlich! Sie haben es verdient!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656006
    m_Localized: 'Jacob: Und Sie und ich ... Wir werden uns wiedersehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656005
    m_Localized: 'Jacob: Aber ich werde nicht sterben. Niemals.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656004
    m_Localized: 'Jacob: Es ist falsch, andere dem Tod zu überlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656003
    m_Localized: 'Jacob: Sie müssen eines lernen:'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656002
    m_Localized: 'Jacob: Denn Sie und ich ... Wir sind unsterblich.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656001
    m_Localized: 'Jacob: Es sind Leute wie Sie, die diesen Albtraum überleben werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656000
    m_Localized: 'Jacob: Es gibt nicht mehr viele Leute, die einem zuhören.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655999
    m_Localized: 'Jacob: Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655998
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655997
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655996
    m_Localized: 'Jacob: Ich weiß genau, woher die Besucher gekommen sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655995
    m_Localized: 'Jacob: Und ich erzähle Ihnen alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655994
    m_Localized: 'Jacob: Ich schwöre Ihnen, sobald die FEMA weg ist, suche ich weiter nach meiner Tochter.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655993
    m_Localized: 'Jacob: Die Regierung will nicht, dass noch mehr Leute davon erfahren.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655992
    m_Localized: 'Jacob: Die FEMA sucht mich, weil ich zu viel weiß ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655991
    m_Localized: 'Jacob: Ich brauche für ein paar Tage einen Unterschlupf.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655990
    m_Localized: 'Jacob: Warten Sie!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655989
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655988
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655987
    m_Localized: 'Jacob: Ich weiß genau, woher die Besucher gekommen sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655986
    m_Localized: 'Jacob: Und ich erzähle Ihnen alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655985
    m_Localized: 'Jacob: Dann suche ich weiter nach meiner Tochter.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655984
    m_Localized: 'Jacob: Lassen Sie mich eine Weile hierbleiben, bis die FEMA aus der Gegend verschwindet.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655983
    m_Localized: 'Jacob: Falls sie sie haben, werden sie ihr nichts tun. Sie haben es auf mich abgesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655982
    m_Localized: 'Jacob: Vielleicht haben diese Bastarde meine Tochter mitgenommen, vielleicht auch nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655981
    m_Localized: 'Jacob: Ich werde gesucht, weil ich zu viel über sie weiß.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655980
    m_Localized: 'Jacob: Weit weg von hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655979
    m_Localized: 'Jacob: Irgendwohin, wo die FEMA uns nicht findet.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655978
    m_Localized: Sie ist nicht hier. Tschüss
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655977
    m_Localized: Wohin wollen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655976
    m_Localized: 'Jacob: Sobald ich sie finde, verschwinden wir aus dieser Stadt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655975
    m_Localized: 'Jacob: Ich habe keine Ahnung, wo sie steckt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655974
    m_Localized: 'Jacob: Ich suche nach ihr, seit dieser ganze Mist angefangen hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655973
    m_Localized: 'Jacob: Reden Sie nicht so über meine Tochter.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655972
    m_Localized: Sie ist nicht hier. Tschüss
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655971
    m_Localized: Wohin wollen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655970
    m_Localized: 'Jacob: Keine Nachricht, keine Spur. Meine Tochter ist einfach verschwunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655969
    m_Localized: 'Jacob: Als ich wieder zu mir kam, war niemand zu Hause.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655968
    m_Localized: 'Jacob: Dann kam diese abnormale Hitzewelle und ich wurde ohnmächtig ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655967
    m_Localized: 'Jacob: Wir wollten die Stadt verlassen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655966
    m_Localized: 'Jacob: Ich kann sie nicht finden, seit dieser ganze Mist angefangen hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655965
    m_Localized: 'Jacob: Sie ist meine Tochter.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655964
    m_Localized: Das Bordell ist in einer anderen Straße
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655963
    m_Localized: So jemanden haben wir hier nicht
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655962
    m_Localized: 'Jacob: War ein lilahaariges Mädchen mit einem Poncho hier?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655961
    m_Localized: 'Jacob: Hey.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655960
    m_Localized: 'StaticBoy: Ich habe mich im Haus geirrt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655959
    m_Localized: 'StaticBoy: Tut mir leid.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655958
    m_Localized: 'StaticBoy: Falscher Geruch. Falsche Stimme.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655957
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655956
    m_Localized: 'StaticBoy: Ich habe mich im Haus geirrt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655955
    m_Localized: 'StaticBoy: Tut mir leid.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655954
    m_Localized: 'StaticBoy: Falscher Geruch. Falsche Stimme.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655953
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655952
    m_Localized: Findest du nicht nach Hause?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655951
    m_Localized: Wonach suchst du?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655950
    m_Localized: 'StaticBoy: Braucht man denn wirklich welche?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655949
    m_Localized: 'StaticBoy: Ich habe keine. Ich hatte noch nie welche.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655948
    m_Localized: 'StaticBoy: Eltern?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655947
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655946
    m_Localized: Findest du nicht nach Hause?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655945
    m_Localized: Wonach suchst du?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655944
    m_Localized: 'StaticBoy: Ich habe ein Schrittgeräusch gehört. Das heißt, dass jemand wartet.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655943
    m_Localized: 'StaticBoy: Ich habe das Küchenlicht gebraucht, aber hier ... gibt es ein eigenartiges Echo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655942
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655941
    m_Localized: 'StaticBoy: Nachts sehen alle Türen gleich aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655940
    m_Localized: Wo sind deine Eltern?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655939
    m_Localized: Hast du dich verlaufen?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655938
    m_Localized: 'StaticBoy: Komisch ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655937
    m_Localized: 'StaticBoy: Er schläft nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655936
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267400
    m_Localized: 'CultistPriest: Behalten Sie meine Leute im Auge. Und denken Sie dran: Wenn einer von ihnen stirbt ... bleibt von Ihrem Haus nichts übrig.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267399
    m_Localized: 'CultistPriest: Bis später. Ich komme, um nach ihnen zu sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267398
    m_Localized: 'CultistPriest: Glauben Sie, Sie hätten eine Wahl?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267397
    m_Localized: 'CultistPriest: Bis später. Ich komme, um nach ihnen zu sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267396
    m_Localized: 'CultistPriest: Sie brauchen nicht lange. Aber behalten Sie meine Leute im Auge.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267395
    m_Localized: 'CultistPriest: Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267394
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267393
    m_Localized: Ich werfe sie raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267392
    m_Localized: 'CultistPriest: Sie stehen unserem Ziel im Weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267391
    m_Localized: 'CultistPriest: Und dann {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267390
    m_Localized: 'CultistPriest: Einmal wäre da {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267389
    m_Localized: 'CultistPriest: Gut. Aber zuerst müssen Sie ein paar Leute loswerden.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267388
    m_Localized: 'Courier: Gute Nacht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267387
    m_Localized: 'Courier: Hier ist Ihre Lieferung: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267386
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267385
    m_Localized: 'Courier: Na gut, nehmen Sie die Lieferung. Ich bin weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267384
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267383
    m_Localized: 'Courier: Ich habe das alles so satt. Ich will nur noch, dass es vorbei ist ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267382
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267381
    m_Localized: 'Courier: Dieses ganze Chaos ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267380
    m_Localized: 'Courier: Jeden Morgen diese endlosen Tests, bei denen die FEMA-Leute uns ihre Waffen unter die Nase halten ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267379
    m_Localized: 'Courier: Ich sehe nur noch erschöpfte, grimmige und verbitterte Gesichter ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267378
    m_Localized: 'Courier: Falls ich jemals gesagt habe, dass dieser Lieferjob mich ablenkt ... Das funktioniert nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267377
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267376
    m_Localized: 'Courier: *seufz*'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267375
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267374
    m_Localized: 'Courier: Nehmen Sie einfach diese Lieferung, dann verschwinde ich, bevor Sie mich auch noch erschießen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267373
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267372
    m_Localized: 'Courier: Verstehe ... Sie sagen also, es ist gut, dass mein Freund getötet wurde?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267371
    m_Localized: Tut mir leid
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267370
    m_Localized: Es gibt keine andere Möglichkeit
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267368
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267367
    m_Localized: 'Courier: Hier ist Ihre Lieferung: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267366
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267365
    m_Localized: 'Courier: Wissen Sie was? Nehmen Sie einfach Ihre Lieferung, ich verzieh mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267364
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267363
    m_Localized: 'Courier: Danke auch für das tolle Gespräch. Sie sind wirklich eine große Hilfe.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267362
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267361
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267360
    m_Localized: 'Courier: Egal, ich muss weiter. Nehmen Sie Ihre Lieferung, ich bin weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267359
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267358
    m_Localized: 'Courier: Demnächst sagen sie, dass man Besucher an ihren Schamhaaren erkennt. Die Welt geht total vor die Hunde ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267357
    m_Localized: 'Courier: Ich dachte, es könnte nicht mehr schlimmer werden. Aber es wird jeden Tag verrückter.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267356
    m_Localized: 'Courier: Die ganzen Besucher, die Merkmale und die verdammte Sonne ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267355
    m_Localized: 'Courier: „Das wird schon“? Was soll denn nach dieser Katastrophe noch werden?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267354
    m_Localized: Sei ein Mann und hör auf zu jammern
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267353
    m_Localized: Keine Sorge, das wird schon
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267352
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267350
    m_Localized: 'Courier: Hier ist Ihre Lieferung: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267349
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267348
    m_Localized: 'Courier: Ich habe eine Lieferung für Sie. Nehmen Sie sie an?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267347
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267346
    m_Localized: 'Courier: Wofür soll ich auch studieren, wenn mich sowieso keiner einstellt?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267345
    m_Localized: 'Courier: Aber egal. Dieser Lieferjob ist gar nicht so übel.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267344
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267343
    m_Localized: 'Courier: Sie haben leicht reden. Sie haben ja genug Gesellschaft zu Hause.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267342
    m_Localized: Schade
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267341
    m_Localized: Allein zu sein ist gar nicht so schlecht
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267340
    m_Localized: 'Courier: Meine Familie ist übrigens nicht hier. Ich bin nur zum Studieren in die Gegend gekommen. Also bin ich ganz allein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267339
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267338
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267336
    m_Localized: 'Courier: Hier ist Ihre Lieferung: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267335
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267334
    m_Localized: 'Courier: Aber ich schweife ab. Nehmen Sie die Lieferung an?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267333
    m_Localized: 'Courier: Und jetzt bestellen die Leute 20 Liter Wasser. Eine Gefahrenzulage wäre nicht schlecht. Oder Trinkgeld, wenn man schwere Sachen schleppt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267332
    m_Localized: 'Courier: Aber diese verdammte Sonne ... Wegen ihr müssen wir Nachtschichten machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267331
    m_Localized: 'Courier: Und mit Lieferungen kann man heutzutage gut verdienen. Das Risiko ist hoch, wie man es dreht und wendet.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267330
    m_Localized: 'Courier: Apokalypse oder nicht, das Mittagessen kommt immer pünktlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267329
    m_Localized: 'Courier: Ich dachte nicht, dass Leute darauf verzichten würden, sich für den Weltuntergang einzudecken.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073033
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073032
    m_Localized: Na gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073031
    m_Localized: 'GraveDigger: {0}? Ist das genug?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073030
    m_Localized: 'GraveDigger: Was kann ich Ihnen geben?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073029
    m_Localized: 'GraveDigger: Verflucht noch mal! Kann ich Sie nicht irgendwie bestechen?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073028
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073027
    m_Localized: Na gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073026
    m_Localized: 'Marauder: Ah! Ich hab’s! {0}. Können Sie haben, wenn Sie mich übernachten lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073025
    m_Localized: 'Marauder: Ein Messer, das brauche ich selbst ... Pflaster auch ... Hmm, eine alte Flasche, aber leider leer ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073024
    m_Localized: 'Marauder: Hey, schicken Sie mich nicht weg ... Lassen Sie mich erst die Tasche durchsuchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878746
    m_Localized: 'Wolfhound: Stärke ist jetzt das Maß aller Dinge. Entweder spielst du mit, oder du hast Pech gehabt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878745
    m_Localized: 'Wolfhound: Kluge Entscheidung.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878744
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878743
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878742
    m_Localized: 'Wolfhound: Wirf sie raus, wenn du noch länger was von deinem Haus haben willst.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878741
    m_Localized: 'Wolfhound: Wohnt {0} etwa hier? Ich sehe sofort, dass sie ein Wolf im Schafspelz ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878740
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878739
    m_Localized: Na gut, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878738
    m_Localized: 'Twins: {0}. Hier, für dich. Könnte noch nützlich sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878737
    m_Localized: 'Twins: Wir haben was dabei. Was war es noch gleich?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878736
    m_Localized: 'Twins: Hmm ... Ich weiß, du kennst uns nicht. Aber wir machen keinen Ärger. Meine kleine Schwester macht eine schwere Zeit durch.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878735
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878734
    m_Localized: Ich werfe sie raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878733
    m_Localized: 'Twins: Sie erinnern mich an unsere Eltern ... Und das kann sie in ihrem Zustand überhaupt nicht gebrauchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878732
    m_Localized: 'Twins: Ich fürchte, meine Schwester wird nur leiden, solange sie hier sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878731
    m_Localized: 'Twins: Wie ich sehe, sind schon andere Leute in diesem Haus, {0} und {1}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878730
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878729
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878728
    m_Localized: Ich glaube nicht, dass wir miteinander auskommen werden.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878727
    m_Localized: Bevor ich meinen Mann kennengelernt habe, war ich ... Na ja, dieser Typ erinnert mich an jemanden.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878726
    m_Localized: Es wird schwer für mich, mit diesem Mann unter einem Dach zu wohnen ...
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878725
    m_Localized: Hier ist schon {0} ...
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878724
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878723
    m_Localized: Ich werfe die Person raus, komm
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878722
    m_Localized: 'Twins: Und das ist das Letzte, was sie jetzt braucht. Sie braucht Ruhe ... und Fürsorge.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878721
    m_Localized: 'Twins: Ich kann die Vorurteile gegenüber meiner kleinen Schwester schon spüren.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878720
    m_Localized: 'Twins: Ich fürchte, hier ist schon {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684421
    m_Localized: 'Greatmother: Hehe, na bitte! Ansonsten hätte es nur Ärger gegeben.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684420
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684419
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684418
    m_Localized: 'Greatmother: Werfen wir ihn raus, damit ich seinen Platz einnehmen kann!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684417
    m_Localized: 'Greatmother: Dem kann man nicht über den Weg trauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684416
    m_Localized: 'Greatmother: Sieh an, sieh an ... Da sitzt ja {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490118
    m_Localized: 'Widow: Danke ... Ich bleibe nicht lange ... Ich muss mich nur kurz ausruhen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490117
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490116
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490115
    m_Localized: 'Widow: Mit so jemandem kann ich nicht im selben Haus bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490114
    m_Localized: 'Widow: Nein.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490113
    m_Localized: 'Widow: Ist {0} hier?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490112
    m_Localized: 'Widow: Danke für Ihre Hilfe. Aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446750101504
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907213
    m_Localized: Na gut, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907212
    m_Localized: 'Luka: Na, Interesse?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907211
    m_Localized: 'Luka: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907210
    m_Localized: 'Luka: Ich würde dir gerne helfen. Vielleicht gibt es etwas, das du willst?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907209
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907208
    m_Localized: Na gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907207
    m_Localized: 'Couple: Also, was sagen Sie? Helfen Sie uns?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907206
    m_Localized: 'Couple: {0}? Ich würde Ihnen alles geben, was ich noch habe, wenn mein Schatz dafür einen Moment der Ruhe bekommt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907205
    m_Localized: 'Couple: Wir haben etwas dabei.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907204
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907203
    m_Localized: 'Couple: Da fällt mir ein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907202
    m_Localized: 'Couple: Ich liebe sie so sehr. Ich würde mein letztes Hemd für sie geben.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907201
    m_Localized: 'Couple: Meine Frau ist nicht besonders stark. Sie wird schnell müde. Und ich ... Ich würde alles für sie tun, verstehen Sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907200
    m_Localized: 'Couple: Verzeihen Sie meine Hartnäckigkeit, aber versetzen Sie sich doch mal in unsere Lage.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712914
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712913
    m_Localized: Na gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712912
    m_Localized: 'Wheelchair: Sehen Sie, meine Beine sind der lebende Beweis! Oder sehen Sie sie etwa irgendwo? Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712911
    m_Localized: 'Wheelchair: Das klappt garantiert!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712910
    m_Localized: 'Wheelchair: Sie lassen mich nicht rein? Das haben wir gleich! Man nehme {0} und fuchtele damit am Eingang rum – schon ist man unsichtbar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712909
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712908
    m_Localized: Na gut, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712907
    m_Localized: 'Dude: Oh! {0}! Das ist wie in so ’nem Spiel, Mann. Wo man Bindungen aufbauen muss. Ich hab’s verstanden, Alter!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712906
    m_Localized: 'Dude: Also gut, zieh dir das hier rein. Ich hab was dabei.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712905
    m_Localized: 'Dude: Komm schon, Alter ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712904
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712903
    m_Localized: Na gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712902
    m_Localized: 'Blind: Ich glaube, es ist {0}. Sie können es haben. Ich brauche wenigstens einen Tag, um durchzuatmen. Aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712901
    m_Localized: 'Blind: Ich ... Ich habe etwas dabei. Warten Sie bitte ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712900
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712899
    m_Localized: Na gut, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712898
    m_Localized: 'Fatman: Hehe. Na, was sagst du? Kommen wir ins Geschäft?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712897
    m_Localized: 'Fatman: Hier ist eine KLEINE AUFMERKSAMKEIT ... von mir. {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712896
    m_Localized: 'Fatman: Na gut, Kumpel. Ich weiß, was dich überzeugen wird.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518610
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518609
    m_Localized: Na gut, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518608
    m_Localized: 'Bestson: Ich ... hab auch Kaugummis. Nicht mehr viele, aber ich kann sie dir geben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518607
    m_Localized: 'Bestson: Vielleicht willst du was von mir haben? Vielleicht {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518606
    m_Localized: 'Bestson: Ich ... Ich weiß gar nicht, was ich machen soll ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518605
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518604
    m_Localized: Na gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518603
    m_Localized: 'Fugitive: Bitte ... Sonst sterbe ich hier draußen!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518602
    m_Localized: 'Fugitive: Ich gebe Ihnen alles, was Sie wollen, Mann. Hier, wie wär’s mit {0}? Hab ich unterwegs gefunden. Was anderes hab ich nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518601
    m_Localized: 'Fugitive: Entweder ich verblute hier verdammt noch mal vor Ihrer Tür ... oder Sie lassen mich rein und helfen mir, die Wunde zu versorgen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518600
    m_Localized: 'Wifefema: Wissen Sie was? Fahren Sie zur Hölle. Ich gehe zu Ihren Nachbarn. Tschüss, Vollidiot.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518599
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518598
    m_Localized: 'Wifefema: Was ist Ihr verdammtes Problem? Ich schütte Ihnen mein Herz aus und Sie pfeifen einfach drauf?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518597
    m_Localized: 'Wifefema: Ist das Ihr Ernst? Mein Mann arbeitet bei der FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518596
    m_Localized: Ich lasse mich nicht bestechen
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518595
    m_Localized: Na gut, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518594
    m_Localized: 'Wifefema: Überlegen Sie sich, was besser für Sie ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518593
    m_Localized: 'Wifefema: Sie weigern sich? Ein Wort zu meinem Mann und morgen kommen Leute in gelben Anzügen zur Kontrolle. Vielleicht sogar jeden Morgen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518592
    m_Localized: 'Wifefema: Machen wir es ganz einfach: Ich gebe Ihnen {0} und Sie lassen mich rein, hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446720741376
    m_Localized: 'Wifefema: Hören Sie, ich habe ein feines Näschen. Ich kann Menschen und Besucher aufspüren wie kein anderer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863213
    m_Localized: Ich hoffe nur, dass ich wenigstens hier endlich ein bisschen schlafen kann.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863212
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863211
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863210
    m_Localized: Ich habe diese Person in meinen Träumen gesehen. Und glauben Sie mir, das hat mir gereicht.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863209
    m_Localized: Hier ist einfach kein Platz für uns beide.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863208
    m_Localized: 'Danke, aber ... mein Platz scheint schon besetzt zu sein. Sehen Sie, {0} ... '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863207
    m_Localized: 'FormerFema: Tschüss.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863206
    m_Localized: 'FormerFema: Ich weiß gar nicht, warum ich ihn überhaupt noch habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863205
    m_Localized: 'FormerFema: Dieser Anzug ist wohl ganz schön unheimlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863204
    m_Localized: 'FormerFema: Schon verstanden.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863203
    m_Localized: 'FormerFema: Ich dachte nicht, dass du mich wirklich reinlassen würdest.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863202
    m_Localized: 'FormerFema: Wirklich?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863201
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863200
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863199
    m_Localized: 'FormerFema: Wenn du diese Person vor die Tür setzt, verspreche ich dir, dass ich mich ruhig verhalte und niemanden störe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863198
    m_Localized: 'FormerFema: Weißt du, ich stecke den ganzen Tag in diesem verdammten Anzug ... Ich will ihn einfach nur ausziehen und das Blut abwaschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863197
    m_Localized: 'FormerFema: Oh ... Wie ich sehe, ist im Badezimmer schon {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863196
    m_Localized: 'FormerFema: Ich meine, Moment mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863195
    m_Localized: 'FormerFema: Was? Ah, danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863194
    m_Localized: 'GraveDigger: Ah, danke!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863193
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863192
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863191
    m_Localized: 'GraveDigger: Ich würde ja reinkommen, aber ... na ja, Sie wissen schon.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863190
    m_Localized: 'GraveDigger: Verdammt, hier ist ja schon {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863189
    m_Localized: Äh ... Nun, einen Versuch war es wert.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863188
    m_Localized: Verflixt. Ich dachte, ich könnte endlich einmal durchatmen.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863187
    m_Localized: Hehe. Das wollte ich hören.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863186
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863185
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863184
    m_Localized: Und von wem? Sehen Sie nur. Da ist {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863183
    m_Localized: Sieh mal einer an. Das gemütliche kleine Plätzchen ist bereits besetzt.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863182
    m_Localized: 'Provocateur: Die Einzelheiten des Mietvertrags besprechen wir später.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863181
    m_Localized: 'Provocateur: Danke, Hausherr.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863180
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863179
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863178
    m_Localized: 'Provocateur: Haben Sie schon einmal von Artikel 28, 48 und 7.3 der Verfassung gehört?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863177
    m_Localized: 'Provocateur: Ist Ihnen bewusst, dass diese Person skrupellos gegen das Gesetz verstößt?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863176
    m_Localized: 'Provocateur: Hm ... Wie ich sehe, wohnt hier schon {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863175
    m_Localized: 'TaxiDriver: Ich kann dich ja irgendwie verstehen, aber das ist schon hart.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863174
    m_Localized: 'TaxiDriver: Komm doch mal bei mir vorbei, dann können wir reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863173
    m_Localized: 'TaxiDriver: Puh, danke, Mann. Du hast mir einen großen Gefallen getan!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863172
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863171
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863170
    m_Localized: 'TaxiDriver: Jedenfalls musst du dich entscheiden – er oder ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863169
    m_Localized: 'TaxiDriver: Der Kerl erinnert mich an einen von diesen Leuten, die es auf meine Familie abgesehen hatten, und ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863168
    m_Localized: 'TaxiDriver: Versteh mich nicht falsch, aber in deinem Haus ist doch {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668885
    m_Localized: 'Edgar: Heben Sie meine auf, wenn es so weit ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668884
    m_Localized: 'Edgar: Ich weiß nicht, ob Sie Schönheit auf die gleiche Weise empfinden wie ich. Aber ... Sie entsorgen die Leichen doch nicht, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668883
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668882
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668881
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668880
    m_Localized: 'Edgar: Aber ich wollte nur die Stille des jüngsten Tages hören.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668879
    m_Localized: 'Edgar: Ich würde ja reinkommen ... aber da ist schon {0}. Diese Person klammert sich immer noch an die Zukunft.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668878
    m_Localized: 'Foreigner: (Er nickt und kommt herein)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668877
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668876
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668875
    m_Localized: 'Foreigner: (Sieht aus, als könnte er {0} nicht leiden. Er zeigt auf ihn, dann auf sich selbst und dann wieder auf den Mann.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668874
    m_Localized: 'Foreigner: Pffyyv. Ffffffpt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668873
    m_Localized: 'Doctor: Wenn ich Glück habe, bleibe ich irgendwo in der Nähe. Sie können mich jederzeit um Hilfe bitten.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668872
    m_Localized: 'Doctor: Ich verstehe. Momentan ist es nicht gerade einfach, jemandem zu vertrauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668871
    m_Localized: 'Doctor: Danke. Ich hoffe, dass ich jemandem helfen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668870
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668869
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668868
    m_Localized: 'Doctor: Er sollte lieber woanders nach jemandem suchen, der ihm helfen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668867
    m_Localized: 'Doctor: Ich kann ihn nicht angemessen behandeln.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668866
    m_Localized: 'Doctor: Hmm, wie ich sehe, haben Sie hier {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474578
    m_Localized: 'NotTrue: Ich gönne meinen alten Knochen hier ein wenig Ruhe, dann mache ich mich wieder auf den Weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474577
    m_Localized: 'NotTrue: Ach, mein Lieber. Würden Sie mir jetzt eine Sitzgelegenheit anbieten?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474576
    m_Localized: 'NotTrue: Ich danke Ihnen! Sie haben einer alten Frau die Knochen gerettet! Schade, dass Sie meinetwegen jemanden vertreiben mussten ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474575
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474574
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474573
    m_Localized: 'NotTrue: Ich werde mich wohl draußen hinsetzen, tief durchatmen und dann weiterziehen, wenn Sie solche Gesellschaft haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474572
    m_Localized: 'NotTrue: Mit solchen Leuten wird es nicht gerade einfach.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474571
    m_Localized: 'NotTrue: Um Himmels willen! Dort sitzt {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474570
    m_Localized: 'Daughter: Oh nein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474569
    m_Localized: 'Daughter: Ich hab solche Angst ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474568
    m_Localized: 'Daughter: Ich kenne doch sonst niemanden ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474567
    m_Localized: 'Daughter: WOHIN SOLL ICH VERSCHWINDEN?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474566
    m_Localized: 'Daughter: PAPAAAA! PAPAAAAAA!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474565
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474564
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474563
    m_Localized: 'Daughter: Ich will Papa sehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474562
    m_Localized: 'Daughter: Aber ich ... Ich will doch nur auf dem Platz sitzen! Ich will, ich will! Da hat Papa immer gesessen ... Das hat er mir erzählt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474561
    m_Localized: 'Daughter: Hier ist {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474560
    m_Localized: 'Daughter: Ich ... Ich kann nicht ... Für mich ist kein Platz!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280298
    m_Localized: 'Scammer: Egal. Ich finde schon irgendwelche anderen dummen Verlierer. Von denen gibt’s jede Menge.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280297
    m_Localized: 'Scammer: Verdammt, was sind Sie nur für ein Feigling. Scheiß drauf, ich wusste sofort, dass wir nicht miteinander auskommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280296
    m_Localized: 'Scammer: Gut. Hey, kommen Sie vorbei, wenn Sie kurz Zeit haben. Ich will Ihnen was verraten.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280295
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280294
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280293
    m_Localized: 'Scammer: Schmeißen Sie ihn raus, dann kommen wir ins Geschäft.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280292
    m_Localized: 'Scammer: Hey, hier ist ja schon {0}. So wird weder Geld noch irgendeine gute Geschichte rausspringen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280291
    m_Localized: 'Cold: Ja ... irgendwo da draußen ... weit weg von allen anderen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280290
    m_Localized: 'Cold: Na gut, ich gehe. Vielleicht schafft die Sonne es noch, mich zu wärmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280289
    m_Localized: 'Cold: Ich verstehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280288
    m_Localized: 'Cold: Danke. Glauben Sie mir, so ist es sicherer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280287
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280286
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280285
    m_Localized: 'Cold: Ich ... Ich habe Angst davor, mit anderen im selben Raum zu sein. Manchmal ... passieren schlimme Dinge. So war es bisher immer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280284
    m_Localized: 'Cold: Danke. Oh. Hier ist schon jemand. Ich komme nicht rein, solange {0} hier ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280283
    m_Localized: 'Esenin: Na, dann fahren Sie doch zur Hölle. Ich wette, Sie sind einer von diesen irren Abstinenzlern.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280282
    m_Localized: 'Esenin: Endlich läuft es mal gut für mich. Zeigen Sie mir den Weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280281
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280280
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280279
    m_Localized: 'Esenin: Solche Leute sind in einer Bar die Ersten, die rausfliegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280278
    m_Localized: 'Esenin: Erst muss {0} hier verschwinden, dann reden wir weiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280277
    m_Localized: 'Anxiety: Okay, haha ... Na gut, ich gehe. Die Sonne wird uns sowieso alle töten. Wir werden alle sterben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280276
    m_Localized: 'Anxiety: Danke. Ich bleibe ruhig sitzen. Aber mach nicht die Tür zu, ja? Haha. Nur für alle Fälle ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280275
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280274
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280273
    m_Localized: 'Anxiety: Könntest du ihn vielleicht bitten, zu gehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280272
    m_Localized: 'Anxiety: Kannst du ihn bitte testen oder ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280271
    m_Localized: 'Anxiety: Ich ... Ich kann nicht bleiben, wenn er da ist. Was, wenn er ein Besucher ist?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280270
    m_Localized: 'Anxiety: D-da ist schon ... {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280269
    m_Localized: 'Hunter: Gute Entscheidung. Ich weiß wenigstens, was ich tue. Ich kann Ihnen helfen, wenn dieser ... Jemand auftaucht.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280268
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280267
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280266
    m_Localized: 'Hunter: Ich rieche, dass hier jemand Blut an den Händen hat. Warum haben Sie so jemanden reingelassen? Leben Sie gerne gefährlich?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280265
    m_Localized: 'Hunter: Sie haben schon {0} in Ihrem Haus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280264
    m_Localized: 'Fanatic: Ich werde jemand anderem helfen. Und Sie können hier vergammeln!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280263
    m_Localized: 'Fanatic: Es ist eine Sünde, die Tür vor dem Licht zu verschließen ... Nein, vor der ERLEUCHTUNG!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280262
    m_Localized: 'Fanatic: Dann fahren Sie zur Hölle!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280261
    m_Localized: 'Fanatic: Ich bleibe einfach eine Weile hier sitzen ... Wupps!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280260
    m_Localized: 'Fanatic: Oh, wunderbar! Nehmen Sie den Segen der Großen Sonne entgegen, die über Sie wachen möge!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280259
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280258
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280257
    m_Localized: 'Fanatic: Sein Schatten ... Nein, der Ketzer selbst erstickt das Licht der Gerechtigkeit! Wir müssen ihn verbannen!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280256
    m_Localized: 'Fanatic: Mensch! Die SONNE befiehlt mir, mich fernzuhalten, solange sich drinnen {0} versteckt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085958
    m_Localized: 'FortuneTeller: Dein Haus wird von reiner Energie durchströmt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085957
    m_Localized: 'FortuneTeller: Gut. Du bist hier im Besitz einer seltenen metaphysischen Ressource.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085956
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085955
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085954
    m_Localized: 'FortuneTeller: Wir müssen ihn loswerden, sonst werden sich die Sterne auf eine Katastrophe ausrichten. Das verstehst du doch, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085953
    m_Localized: 'FortuneTeller: Es ist {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085952
    m_Localized: 'FortuneTeller: Oh ... Ich spüre es ... Was für eine erdrückende Aura. Ein Schatten ... stark genug, um uns alle zu verdammen, das ganze Haus zu vergiften!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891698
    m_Localized: 'Luka: Pass auf dich auf, ja?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891697
    m_Localized: 'Luka: Und dann kann es ziemlich schnell stockfinster werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891696
    m_Localized: 'Luka: Wenn du dich zu sehr darauf konzentrierst, frisst sie dich bei lebendigem Leib auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891695
    m_Localized: 'Luka: Vergrabe dich nicht in deiner Trauer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891694
    m_Localized: 'Luka: Vielleicht kannst du dann auch über andere Dinge nachdenken als nur über den Tod.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891693
    m_Localized: 'Luka: Ich hoffe, du erinnerst dich noch, wie es war, Freude zu empfinden.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891692
    m_Localized: 'Luka: Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891691
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891690
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891689
    m_Localized: 'Luka: Aber es wäre nett, wenn du ein bisschen Platz für mich schaffen könntest.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891688
    m_Localized: 'Luka: Ich will niemanden vertreiben. Wer weiß, vielleicht brauchen andere dringender ein Dach über dem Kopf als ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891687
    m_Localized: 'Luka: Ich würde ja gerne reinkommen, aber da scheint schon {0} zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891686
    m_Localized: 'Couple: Na los, setz dich in Bewegung. Ich bin auch müde.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891685
    m_Localized: 'Couple: Wir suchen weiter, nicht wahr, mein Sonnenschein?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891684
    m_Localized: 'Couple: Verstehe. Entschuldigen Sie die Störung.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891683
    m_Localized: 'Couple: Nicht so schüchtern. Gleich kannst du dich ausruhen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891682
    m_Localized: 'Couple: Warum stehst du da noch rum? Na los, wir sind eingeladen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891681
    m_Localized: 'Couple: Oh, danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891680
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891679
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891678
    m_Localized: 'Couple: Meine Frau mag Kinder nicht besonders. Ich dachte nicht, dass hier so junge Leute sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891677
    m_Localized: 'Couple: Ich will wirklich keine Umstände machen, aber ... wir können nicht mit {0} zusammenwohnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891676
    m_Localized: 'Couple: Und wer ist das?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891675
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891674
    m_Localized: 'Couple: Oh, danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891673
    m_Localized: 'Anger: Verdammte Scheiße.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891672
    m_Localized: 'Anger: Lassen Sie sich hier weiter deren Mist reindrücken und ersticken Sie daran.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891671
    m_Localized: 'Anger: Verdammt, Sie sind genauso erbärmlich wie die anderen Feiglinge.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891670
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891669
    m_Localized: 'Anger: Ich lasse meine Wut an mir selbst aus. Niemand wird verletzt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891668
    m_Localized: 'Anger: Oder das Haus in Stücke schlagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891667
    m_Localized: 'Anger: Keine Sorge, auf andere werde ich nicht losgehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891666
    m_Localized: 'Anger: Nein, mit so jemandem bleibe ich nicht unter einem Dach. Da würde ich nur ausrasten.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891665
    m_Localized: 'Anger: Was macht {0} hier?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891664
    m_Localized: 'Mother: Nein, nein. Ich kann es noch schaffen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891662
    m_Localized: 'Mother: Na gut. Dann versuche ich jetzt, ob ich es zu meinem Mann schaffe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891661
    m_Localized: 'Mother: Komm, steh nicht einfach nur rum. Geh rein, der Herr wartet nicht ewig.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891660
    m_Localized: 'Mother: Perfekt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891659
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891658
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891657
    m_Localized: 'Mother: Vielleicht könntest du ... ich weiß nicht ... diese Person rauswerfen, damit das Kind endlich mal in Ruhe schlafen kann?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891656
    m_Localized: 'Mother: Hm. Hier ist {0}. Mein Baby hat sowieso schon genug Angst ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891655
    m_Localized: 'Ballerina: Sehen Sie das Fellknäuel?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891654
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891653
    m_Localized: 'Ballerina: Ich habe nicht mit Ihnen geredet, sondern mit der Katze.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891652
    m_Localized: 'Ballerina: Komm schon, Kätzchen. Du hältst mich jetzt bei Laune, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891651
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891650
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891649
    m_Localized: 'Ballerina: Hmmm, mir wurde gesagt, dass das nicht so sein sollte. Raus damit.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891648
    m_Localized: 'Ballerina: Da ist {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697379
    m_Localized: 'Teacher: Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697378
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697377
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697376
    m_Localized: 'Teacher: Tut mir leid ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697375
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697374
    m_Localized: 'Teacher: Er erinnert mich an ... die Leute, die ... die Kinder ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697373
    m_Localized: 'Teacher: Ich kann nicht mit so jemandem unter einem Dach leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697372
    m_Localized: 'Teacher: Tut mir leid, aber ... da ist {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697371
    m_Localized: 'Dude: Pass auf dich auf ... und auf deine Familie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697370
    m_Localized: 'Dude: Schon gut, Alter. Ich versteh schon.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697369
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697368
    m_Localized: 'Dude: Maaaann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697367
    m_Localized: 'Dude: Das wollte ich hören! Du Ehrenmann!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697366
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697365
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697364
    m_Localized: 'Dude: Mann, wir müssen ihn rausschmeißen! Er macht die Stimmung kaputt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697363
    m_Localized: 'Dude: Verdammt, der Typ ruiniert den ganzen Vibe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697362
    m_Localized: 'Dude: Moment mal ... Wer ist {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697361
    m_Localized: 'Dude: Ooooh, Alter, viel Liebe!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697360
    m_Localized: 'Blind: Sonst kommt es Sie holen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697359
    m_Localized: 'Blind: Bei allem, was heilig ist ... Gehen Sie nachts bloß nicht in die Nähe der verbrannten Leichen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697358
    m_Localized: 'Blind: Ich gehe, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697357
    m_Localized: 'Blind: Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697356
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697355
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697354
    m_Localized: 'Blind: Ich suche mir lieber einen anderen Ort.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697353
    m_Localized: 'Blind: Tut mir leid, ich kann es nicht erklären. Ich weiß nur, dass es nicht an etwas anderem liegt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697352
    m_Localized: 'Blind: Ich spüre, dass {0} hier ist. Mit dieser Person stimmt irgendwas nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697351
    m_Localized: 'Fatman: Wo soll ich denn hin? Ich bin aufgeschmissen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697350
    m_Localized: 'Fatman: Mann ... Du weißt doch, dass es mir nicht gutgeht.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697349
    m_Localized: 'Fatman: Ich werde mich revanchieren ... wenn das alles vorbei ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697348
    m_Localized: 'Fatman: Du hast die richtige Entscheidung getroffen, Mann.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697347
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697346
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697345
    m_Localized: 'Fatman: Ich würde dir ja gern ’nen Gefallen tun, wenn du deine Waffe benutzt!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697344
    m_Localized: 'Fatman: Scheiße, da ist {0} in Ihrem Haus. Ich hab keine Lust, mit so jemandem um eine Badewanne zu kämpfen!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503073
    m_Localized: 'Buddy: Danke, Kumpel! Du bist ein echter Lebensretter!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503072
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503071
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503070
    m_Localized: 'Buddy: Ich hab ja nichts gegen Teilen, aber dafür ist diese Hundehütte ein bisschen zu klein, oder? Kannst du mir nicht einen Gefallen tun?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503069
    m_Localized: 'Buddy: Oha, Kumpel, da scheint aber schon jemand in deinem Haus zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503068
    m_Localized: 'Bestson: Ja ... Du hast wahrscheinlich recht. Ich gehe nach Hause, vielleicht sind sie ja schon zurück ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503067
    m_Localized: 'Bestson: Aber ... vielleicht sollte ich erst einmal hierbleiben. Das ist vielleicht sicherer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503066
    m_Localized: 'Bestson: Was, wenn meine Eltern nach Hause kommen und ich nicht da bin?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503065
    m_Localized: 'Bestson: Danke! Ich ... kann trotzdem nicht aufhören, mir Sorgen zu machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503064
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503063
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503062
    m_Localized: 'Bestson: Einmal hat mich jemand wie er im Park angegriffen. Seitdem lass ich mich dort nicht mehr blicken!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503061
    m_Localized: 'Bestson: Wie ich sehe, sitzt {0} bei Ihnen auf der Couch. Solche Männer ... ich meine ... Die machen mir Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503060
    m_Localized: 'Fugitive: Gute Nacht, Arschloch.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503059
    m_Localized: 'Fugitive: Na gut. Verkriechen Sie sich ruhig hinter Ihrer Tür.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503058
    m_Localized: 'Fugitive: Haben Sie Schiss, dass die FEMA nach mir sucht? Was zur Hölle?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503057
    m_Localized: 'Fugitive: Ist das ihr verdammter Ernst?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503056
    m_Localized: 'Fugitive: Hoffentlich sind Ihre Nachbarn keine Vollidioten ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503055
    m_Localized: 'Fugitive: Sie haben mir das Leben gerettet, Mann!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503054
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503053
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503052
    m_Localized: 'Fugitive: Ich sag’s Ihnen, solchen Typen kann man nicht über den Weg trauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503051
    m_Localized: 'Fugitive: Sitzt still und unauffällig rum. Bis es Zeit ist, seinen eigenen Arsch zu retten. Dann liefert er Sie skrupellos ans Messer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503050
    m_Localized: 'Fugitive: Ich kann nicht ... Hören Sie, ich kenne solche Leute. Leute wie {0} hier in Ihrem Haus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503049
    m_Localized: 'Nun: Der Herr wird sich daran erinnern. Er sieht alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503048
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503047
    m_Localized: 'Nun: Mein Tod wird schwer auf Ihrer Seele lasten, das verspreche ich Ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503046
    m_Localized: 'Nun: Sie Narr! Sie hatten die Chance auf Erlösung ... und haben sie schändlich weggeworfen!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503045
    m_Localized: 'Nun: Herr, erbarme dich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503044
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503043
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503042
    m_Localized: 'Nun: Verbannen Sie die Dämonen, dann werden Sie gesegnet!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503041
    m_Localized: 'Nun: Ein ganzes Leben wird nicht reichen, um die Sünden dieser Person reinzuwaschen! Mit solcher Gesellschaft sollten Sie Gott fürchten!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503040
    m_Localized: 'Nun: Und wer ist {0}, wenn ich fragen darf?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114466
    m_Localized: 'Raskolnikov: Ich hoffe nur ... dass ich irgendwann das Töten lerne. Damit ich mich wehren kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114465
    m_Localized: 'Raskolnikov: Diese Person muss Ihnen sehr wichtig sein. Tut mir leid, dass ich Ihre Zeit verschwendet habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114464
    m_Localized: 'Raskolnikov: Entschuldigung. Ich wollte Sie nicht so unter Druck setzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114463
    m_Localized: 'Raskolnikov: Könnten Sie mir zeigen, wie es geht? Wie man einen Besucher tötet. Ich will der Angst ins Auge blicken.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114462
    m_Localized: 'Raskolnikov: Und ... wenn es nicht zu viel verlangt ist ... nachdem Sie mich getestet haben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114461
    m_Localized: 'Raskolnikov: Danke, mein Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114460
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114459
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114458
    m_Localized: 'Raskolnikov: Mit solchen Leuten kann ich nicht zusammenleben. Ich hab’s versucht, aber es funktioniert nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114457
    m_Localized: 'Raskolnikov: Tut mir leid. Ich will nicht unhöflich sein, aber {0} ist schon hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114456
    m_Localized: 'Wifefema: Wissen Sie was? Fahren Sie zur Hölle. Ich gehe zu Ihren Nachbarn. Tschüss, Vollidiot.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114455
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114454
    m_Localized: 'Wifefema: Was ist Ihr verdammtes Problem? Ich schütte Ihnen mein Herz aus und Sie pfeifen einfach drauf?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114453
    m_Localized: 'Wifefema: Ist das Ihr Ernst? Mein Mann arbeitet bei der FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114452
    m_Localized: "Wifefema: Diese verdammten Schmarotzer ...\n"
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114451
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114450
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114449
    m_Localized: 'Wifefema: Setzen Sie ihn vor die Tür, bevor es zu spät ist!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114448
    m_Localized: 'Wifefema: Ich kenne solche Typen. Sie hätten ihn niemals reinlassen dürfen. Er macht Ihnen nur Ärger.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114447
    m_Localized: 'Wifefema: Wer zur Hölle ist {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114446
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114445
    m_Localized: 'Theorist: Leben Sie wohl! Ich bezweifle, dass Sie lange durchhalten!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114444
    m_Localized: 'Theorist: Nur ignorante Kleingeister verschließen derart die Augen vor der Wahrheit!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114443
    m_Localized: 'Theorist: Sie ... Sie sind ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114442
    m_Localized: 'Theorist: Ich soll verschwinden?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114441
    m_Localized: 'Theorist: Nach unserer Unterhaltung werden Sie die Welt mit anderen Augen betrachten!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114440
    m_Localized: 'Theorist: Sie haben die richtige Entscheidung getroffen! Glauben Sie mir, Sie werden es nicht bereuen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114439
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114438
    m_Localized: Ich werfe die Person raus, kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114437
    m_Localized: 'Theorist: Wenn Sie dafür sorgen, dass er verschwindet, nehme ich Ihre Einladung an!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114436
    m_Localized: 'Theorist: Auf keinen Fall verrate ich Ihnen irgendwas, solange er in der Nähe ist!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114435
    m_Localized: 'Theorist: Da ist ... {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114434
    m_Localized: 'Theorist: Oh nein. Vergessen Sie’s.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114433
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114432
    m_Localized: 'Theorist: Obwohl ... Warten Sie mal. Wer ist das?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077071142912
    m_Localized: 'Theorist: Wunderbar!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633035
    m_Localized: 'BigLebowski: Ich hätte nicht meine Zeit mit dir verschwenden sollen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633034
    m_Localized: 'BigLebowski: Pfft ... Was soll’s.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371394
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371393
    m_Localized: 'Vigilante: Zeig mir deine Hände.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891663
    m_Localized: 'Mother: Vielleicht ist es schon zu spät ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200658
    m_Localized: 'FatalDame: Und ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200657
    m_Localized: 'FatalDame: Ich habe mich genauso gefühlt. Wenn du darüber reden willst ... können wir das tun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200647
    m_Localized: 'FatalDame: Aber ich werde dich nicht dazu zwingen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200646
    m_Localized: 'FatalDame: Vielleicht hilft es, darüber zu reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200645
    m_Localized: Ich kann nicht gut mit Leuten. Na und?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200644
    m_Localized: Ich habe immer gehofft, dass mein Vater stirbt. Reicht das?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200643
    m_Localized: Ich will nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200642
    m_Localized: 'FatalDame: Erzähl’s mir. Ich bin nur eine Fremde an deiner Tür. Vielleicht sehen wir uns danach nie wieder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200641
    m_Localized: 'FatalDame: Oder war es deine Kindheit? Du hast eine schwere Zeit durchgemacht, und diese ganze Sache hier wühlt alte Erinnerungen auf?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200640
    m_Localized: 'FatalDame: Haben die Besucher jemanden getötet, der dir wichtig war? Und jetzt verschließt du dich vor anderen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200639
    m_Localized: 'FatalDame: Was ist passiert? Hat deine Frau dich vor Kurzem verlassen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200638
    m_Localized: 'FatalDame: Donnerwetter. Das war deutlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200637
    m_Localized: Ich kann nicht gut mit Leuten. Na und?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200636
    m_Localized: Ich habe immer gehofft, dass mein Vater stirbt. Reicht das?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200635
    m_Localized: Ich will nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200634
    m_Localized: 'FatalDame: Du bist nicht sehr gesprächig. Erzähl mir von dir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200633
    m_Localized: 'FatalDame: Das sagen in letzter Zeit viele Leute. Mehr als sonst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200632
    m_Localized: 'FatalDame: Gefällt es dir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200631
    m_Localized: 'FatalDame: Du hast es also bemerkt. Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200630
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200629
    m_Localized: Du siehst ... ungewöhnlich aus.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200628
    m_Localized: 'FatalDame: Wie dumm von mir, das zu fragen. Du wohnst ja schließlich hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200627
    m_Localized: 'FatalDame: Hast du dich schon daran gewöhnt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200626
    m_Localized: 'FatalDame: Wie ist das neue Leben für dich?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200624
    m_Localized: 'Vigilante: Ernsthaft? Dein Foto interessiert mich herzlich wenig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200623
    m_Localized: 'Vigilante: Sieht gut aus. Genau wie bei jeder zweiten falschen Schlange, die ich umgelegt hab.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200622
    m_Localized: 'Vigilante: Dieser Unsinn schon wieder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200621
    m_Localized: 'Vigilante: Verzieh dich. Ich schnüffle nicht an deinen Achselhöhlen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200620
    m_Localized: 'Vigilante: Wenn da irgendwas wächst, will ich es lieber nicht wissen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200619
    m_Localized: 'Vigilante: Willst du mich verarschen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200617
    m_Localized: Du bist frei ... vorerst. Ich habe keine Zeit für diesen Blödsinn.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200616
    m_Localized: 'Vigilante: Gut. Aber das heißt nicht, dass du sicher bist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200615
    m_Localized: 'Vigilante: Mach die Augen weiter auf. Schluss mit den Mätzchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200614
    m_Localized: Dafür habe ich jetzt keine Zeit.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200613
    m_Localized: 'Vigilante: Hmpf ... Dreckig oder sauber, was heißt das schon? Besucher tarnen sich sowieso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200612
    m_Localized: 'Vigilante: Na los, her damit. Ich beiße nur, wenn es unbedingt sein muss.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200611
    m_Localized: 'Vigilante: Genug geredet. Ich verschwende hier nur meine Zeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200610
    m_Localized: 'Vigilante: Nur nicht übermütig werden. Ein Fehler und du bist erledigt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200609
    m_Localized: 'Vigilante: Gut, sieht sauber aus. Aber ehrlich gesagt wär’s einfacher, wennֹ’s anders wäre. Dann gäb’s später weniger Ärger.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200608
    m_Localized: 'Vigilante: Mach deinen verdammten Mund auf. Ich bin nicht dein Zahnarzt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200607
    m_Localized: (Ohren zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200606
    m_Localized: (Foto zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200605
    m_Localized: (Achselhöhlen zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200604
    m_Localized: (Augen zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200603
    m_Localized: (Hände zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200602
    m_Localized: (Zähne zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200601
    m_Localized: 'Vigilante: Egal, genug geredet. Zeig mir die Merkmale.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200600
    m_Localized: 'Vigilante: Sie haben gelacht und gesagt, dass ich mich bewerben soll. Scheiß drauf. Die verschleppen nur Leute und die Besucher sind immer noch da.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200599
    m_Localized: 'Vigilante: Dann kam die FEMA und wollte saubermachen. Ich hab ihnen gesagt, dass das schon erledigt ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200598
    m_Localized: 'Vigilante: Erst hab ich sie getötet. Dann ihn. Die Kinder sind irgendwie mit den Nachbarn entkommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200597
    m_Localized: "Vigilante: Als die Besucher auf das Dach gestiegen sind, hat der Bastard die Tür geöffnet. Hat sie laufen lassen. Also hab ich getan, was er nicht konnte.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200596
    m_Localized: 'Vigilante: Aber die Frau ... Sie hatte Merkmale. Und er hat andauernd gefleht: „Sie ist meine Frau. Finger weg von ihr!“'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200595
    m_Localized: 'Vigilante: Da war diese Familie am Stadtrand. Haben sich verbarrikadiert, der Vater hat die Tür zugehalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200594
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200593
    m_Localized: 'Vigilante: Aber jetzt ist es auch schon egal. Ich hab damit abgeschlossen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200592
    m_Localized: 'Vigilante: Die Sucherei bringt nichts. Reine Zeitverschwendung. Wenn mein Bruder ein Rückgrat gehabt hätte, hätte es vielleicht noch eine Chance gegeben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200591
    m_Localized: (Ohren zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200590
    m_Localized: (Foto zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200589
    m_Localized: (Achselhöhlen zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200588
    m_Localized: (Augen zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200587
    m_Localized: (Hände zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200586
    m_Localized: (Zähne zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200585
    m_Localized: 'Vigilante: Egal, genug Geschichten erzählt. Zeig mir die Merkmale.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200584
    m_Localized: 'Vigilante: Wilde Augen, aber sie hat überlebt. Davor hab ich Respekt. Mein Bruder dagegen ... Wenn er früher gestorben wäre, hätte seine Familie es vielleicht geschafft.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200583
    m_Localized: 'Vigilante: Ich dachte, das war’s für sie. Aber ein paar Tage später standen sie vor mir. Vorneweg seine Tochter, mit Schrotflinte in der Hand.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200582
    m_Localized: 'Vigilante: Hat seine Familie durch die Hintertür in den Wald gebracht. Die Missgeburten hab ich erledigt, aber sie sind nie zurückgekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200581
    m_Localized: 'Vigilante: Neulich hab ich eine Familie gesehen. Stämmiger Vater. Hat sich zusammengerissen, als die Besucher an den Fenstern geschrien haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200580
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200579
    m_Localized: 'Vigilante: Diese ganze Misere haben wir Feiglingen wie ihm zu verdanken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200578
    m_Localized: 'Vigilante: Zieht den Schwanz ein. Jetzt ist seine Familie entweder tot oder weiß der Teufel wo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200577
    m_Localized: 'Vigilante: So wie immer. Ich hab meinem Bruder gesagt: Sei ein Mann, beschütze deine Familie. Und was macht er?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200538
    m_Localized: 'Vigilante: Seine Frau ... Egal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200537
    m_Localized: 'Vigilante: Er hat ein Kind. Ein kleines Mädchen. Keine Ahnung, wie alt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200536
    m_Localized: 'Vigilante: Wenn ich schon mal hier bin ... Kennst du einen stämmigen Typen mit einer blauen Jeansjacke?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200535
    m_Localized: 'Vigilante: Besucher nutzen die Schwäche der Gutmütigen aus. So kommen Leute in ihren eigenen Häusern zu Tode.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200534
    m_Localized: 'Vigilante: Die Zeit der Gerechtigkeit ist gekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200533
    m_Localized: Nur das Mädchen hat überlebt. Der Mann ist tot
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200532
    m_Localized: Sein Haus ist abgebrannt. Seitdem habe ich ihn nicht gesehen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200531
    m_Localized: 'Vigilante: Seine Frau ... Egal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200530
    m_Localized: 'Vigilante: Er hat ein Kind. Ein kleines Mädchen. Keine Ahnung, wie alt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200529
    m_Localized: 'Vigilante: Wenn ich schon mal hier bin ... Kennst du einen stämmigen Typen mit einer blauen Jeansjacke?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200528
    m_Localized: 'Vigilante: Ein Merkmal reicht, um sie kalt zu machen. Ich warte nicht auf ein zweites.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200527
    m_Localized: 'Vigilante: Im Fernsehen und im Radio sagen sie, wie’s geht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200526
    m_Localized: 'Vigilante: Genauso wie du, schätze ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200525
    m_Localized: Was, wenn sie nur ein oder zwei Merkmale haben?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200524
    m_Localized: Woran erkennst du einen Besucher?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200523
    m_Localized: 'Vigilante: Hat die FEMA die Stadt aufgegeben? Oder nur diese Gegend?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200522
    m_Localized: 'Vigilante: Aber ich hab mir ein paar Häuser angesehen. Hier wimmelt es vor Besuchern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200521
    m_Localized: 'Vigilante: Ich habe jemanden gesucht. Kein Glück.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200520
    m_Localized: 'Vigilante: Ich bin wieder da.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200519
    m_Localized: 'Vigilante: Ich komme später wieder ... Du bist ein interessanter Kerl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200518
    m_Localized: 'Vigilante: Es gibt jemanden, nach dem ich sehen muss.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200517
    m_Localized: 'Vigilante: Warum sollte man sie als Bedrohung betrachten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200516
    m_Localized: 'Vigilante: Sie haben ihre Methoden, Merkmale von Besuchern zu erkennen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200515
    m_Localized: 'Vigilante: Die wissen schon, was sie tun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200514
    m_Localized: 'Vigilante: Ruh dich aus. Wir reden später weiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200513
    m_Localized: 'Vigilante: Ich muss es mit eigenen Augen sehen. Und das werde ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200512
    m_Localized: 'Vigilante: Aber ich traue dir nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006469
    m_Localized: 'Vigilante: Du versuchst also auch, für Ordnung zu sorgen. Gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006468
    m_Localized: 'Vigilante: Du hast mein Interesse geweckt. Ich bin bald zurück.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006467
    m_Localized: 'Vigilante: Ja, das hast du wohl. Du klingst nicht wie jemand, der nur Gerüchte nachplappert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006466
    m_Localized: 'Vigilante: Interessant. Hast du ihn gesehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006465
    m_Localized: 'Vigilante: Also ohne Rüstung?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006464
    m_Localized: 'Vigilante: Allein? Halbnackt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006463
    m_Localized: Die FEMA holt Leute ab. Keine Ahnung, ob sie zurückkommen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006462
    m_Localized: Es kommen ständig Besucher, aber ich habe eine Waffe
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006461
    m_Localized: Ein halbnackter Besucher hat die ganze Patrouille ausgelöscht
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006460
    m_Localized: 'Vigilante: Was ist hier los? Wen soll ich im Auge behalten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006459
    m_Localized: 'Vigilante: Du hast genug Fragen gestellt. Jetzt bin ich dran.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006458
    m_Localized: 'Vigilante: Schluss jetzt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006457
    m_Localized: Wie lange willst du noch „saubermachen“?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006456
    m_Localized: Warum bist du hier?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006455
    m_Localized: 'Vigilante: Wenn einer mächtig Eindruck hinterlässt ... nehme ich vielleicht was anderes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006454
    m_Localized: 'Vigilante: Normalerweise ziehe ich jedem Besucher einen Zahn. Das ist am leichtesten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006453
    m_Localized: 'Vigilante: Das ist eine Erinnerung daran, wie viele Häuser und wie viele Städte ich gesäubert habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006452
    m_Localized: 'Vigilante: Hehe. Guter Spruch. Den merk ich mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006451
    m_Localized: 'Vigilante: Schutzausrüstung? Oh, du meinst die Halskette.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006450
    m_Localized: Wie lange willst du noch „saubermachen“?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006449
    m_Localized: Warum bist du hier?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006448
    m_Localized: 'Vigilante: Und jeder, der Mitleid mit den Besuchern hat ... ist vielleicht selbst einer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006447
    m_Localized: 'Vigilante: Am effektivsten ist es, die Dinger in einem Haus einzusperren und es abzufackeln.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006446
    m_Localized: 'Vigilante: Ich könnte auch mit bloßen Händen saubermachen. Aber hiermit geht es besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006445
    m_Localized: 'Vigilante: Ja. Das ist ein Besen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006444
    m_Localized: 'Vigilante: Hehe. Das gefällt mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006443
    m_Localized: Ist das Schutzausrüstung gegen Besucher?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006442
    m_Localized: Und das in deiner Hand ist wahrscheinlich ein Besen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006441
    m_Localized: 'Vigilante: Ich verstecke mich nicht drinnen. Ich bin die Gerechtigkeit. Ich sorge für Ordnung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006440
    m_Localized: 'Vigilante: Keine Gerechtigkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006439
    m_Localized: 'Vigilante: Und ein paar Tage später schlachten die Besucher alle im Haus ab und verschwinden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006438
    m_Localized: 'Vigilante: Manche bemitleiden die Besucher. Sie denken, dass sie irgendwie genesen könnten oder so.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006437
    m_Localized: 'Vigilante: Das hier ist kein verdammtes Abenteuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006436
    m_Localized: Ist das Schutzausrüstung gegen Besucher?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006435
    m_Localized: Und das in deiner Hand ist wahrscheinlich ein Besen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006434
    m_Localized: 'Vigilante: Der Rest? Geht dich nichts an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006433
    m_Localized: 'Vigilante: In meinem Sektor ist alles erledigt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006432
    m_Localized: 'Vigilante: Ich bin hier, um sauberzumachen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006431
    m_Localized: Warum bist du nicht drinnen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006430
    m_Localized: Wer bist du?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006429
    m_Localized: 'Vigilante: Es sei denn, du bist ein Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006428
    m_Localized: 'Vigilante: Gut. Das erhöht deine Chancen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006427
    m_Localized: 'Vigilante: Du gehst auf Abstand, was?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006426
    m_Localized: 'Miner: In Ihren Alltag zurückkehren, als wäre nichts gewesen? Na los, gehen Sie runter. Wir finden es raus. Zusammen. Na?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006425
    m_Localized: 'Miner: Was, wenn da unten was ist, das alles verändert? Die Wahrheit ans Licht bringt? Sie zum Helden macht? Wollen Sie einfach weglaufen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006424
    m_Localized: 'Miner: Wollen Sie nicht die Wahrheit rausfinden? Im Ernst? Sie wissen, dass das nicht nur ein Loch ist. Sie spüren es.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006423
    m_Localized: 'Miner: Also? Worauf warten Sie? Genau dafür sind wir hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006422
    m_Localized: 'Miner: Sie sind nicht der Typ, der sich für den Rest seines Lebens fragt, was gewesen wäre, wenn er nicht gekniffen hätte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006421
    m_Localized: 'Miner: Na los. Nehmen Sie Ihren Mut zusammen. Sie gehen runter, ich passe auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006420
    m_Localized: 'Miner: Und Sie wollen doch auch wissen, was da unten ist, oder? Sie sind kein Feigling, das steht fest. Sie waren schon dreimal hier unten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006419
    m_Localized: 'Miner: Ich ziehe Sie mit einem Arm wieder hoch. Aber wenn ich gehe, wer soll dann das Ziehen übernehmen? Simple Logik.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006418
    m_Localized: 'Miner: Und wer soll mich hochziehen? Sie Spargeltarzan? Nichts für ungut, aber Sie gehen, ich bleibe hier. Klingt vernünftiger, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006417
    m_Localized: Und wenn wir nie rausfinden, was da unten ist?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006416
    m_Localized: Warum gehen Sie nicht selbst runter?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006415
    m_Localized: 'Miner: Sie spüren es auch, oder? Diese Anziehung ... Als ob das Loch nach Ihnen ruft. Sie spüren es, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006414
    m_Localized: 'Miner: Welcher andere? Hören Sie, irgendjemand muss was tun. Man kann nicht immer nur rumsitzen. Jetzt oder nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006413
    m_Localized: Und wenn wir nie rausfinden, was da unten ist?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006412
    m_Localized: Warum gehen Sie nicht selbst runter?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006411
    m_Localized: 'Miner: Aber solange wir warten, haben wir Zeit, uns hier umzusehen. Wollen Sie nicht mehr erfahren? Geben Sie’s zu, Sie sind neugierig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006410
    m_Localized: 'Miner: Der? Ja, natürlich lebt er noch. Das Seil ist straff, sehen Sie? Das heißt, er arbeitet. Wenn was nicht stimmen würde, wüssten wir Bescheid.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006409
    m_Localized: Der andere ist immer noch verschwunden?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006408
    m_Localized: Glauben Sie, Ihr Freund lebt noch?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006407
    m_Localized: Aber dieses Loch ... Seien Sie ehrlich, wie oft haben Sie schon seine Anziehung gespürt? Geben Sie’s ruhig zu.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006406
    m_Localized: Oder vielleicht habe ich nur Wahnvorstellungen, weil ich schon zu lange hier sitze.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006405
    m_Localized: 'Miner: Oh, Sie sind’s. Ich dachte schon, Sie wollen kneifen. Irgendwas stimmt nicht. Das Licht ist komisch. Und das Seil fühlt sich schwerer an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006404
    m_Localized: 'Miner: Sie sind nicht der Kräftigste, aber ich könnte Sie problemlos hochziehen. Also wie wär’s: Sie sehen nach, ich passe auf. Abgemacht? Denken Sie darüber nach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006403
    m_Localized: 'Miner: Ein Ausflug nach unten, dann wissen wir vielleicht Bescheid. Ich würde ja selbst gehen, aber ... irgendjemand muss das Seil halten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006402
    m_Localized: 'Miner: Was, wenn die Antworten dort unten sind? Natürlich nicht alle. Aber darauf, warum sie gekommen sind. Was sie wollen. Stellen Sie sich das vor!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006401
    m_Localized: 'Miner: Was? Besucher? Ja, verdammt noch mal! Wir glauben, dass das ihre Tunnel sind. Und dieses Loch? Vielleicht irgendein ... Portal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006400
    m_Localized: 'Miner: Aber niemals allein, verstanden? Jemand muss bereit sein, Sie wieder hochzuziehen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006399
    m_Localized: 'Miner: Nicht, dass ich Angst hätte, aber ... es zieht einen an. Wenn ich nur noch einen Blick darauf werfen könnte ... nur ein bisschen näher ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006398
    m_Localized: 'Miner: Aber manchmal ... spürt man es, wenn man daneben steht. Als ob man gerufen wird. Probieren Sie’s aus. Hören Sie einfach hin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006397
    m_Localized: 'Miner: Ich war nah dran, als die Jungs noch hier waren. Aber da unten ... starrt man nur ins Nichts. Völlige Leere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006396
    m_Localized: 'Miner: Ich würde ja gern, aber ein falsches Ziehen an diesem Seil und es ist aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006395
    m_Localized: 'Miner: Angesehen? Ein bisschen. Aber nicht wirklich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006394
    m_Localized: Ihrem Freund da unten wird doch nichts passiert sein?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006393
    m_Localized: Haben Sie sich das Loch selbst angesehen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006392
    m_Localized: 'Miner: Sehen Sie? Das Seil ist straff. Er arbeitet also noch unten. Wenn nicht, wüssten wir Bescheid. Vielleicht treffen Sie sie zuerst, wenn Sie wieder hochgehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006391
    m_Localized: 'Miner: Der andere hängt am Seil. Er wird daran ziehen, wenn er bereit ist oder wenn was schiefgeht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006390
    m_Localized: 'Miner: Was? Meine Kumpels? Nein, alles gut. Einer ist tief reingegangen, aber der kommt wieder. Er findet immer einen Ausgang.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006389
    m_Localized: Ihrem Freund da unten wird doch nichts passiert sein?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006388
    m_Localized: Haben Sie sich das Loch selbst angesehen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006387
    m_Localized: 'Miner: Sie sollten da oben lieber was essen, sonst enden Sie noch wie ich. Dann hungern Sie in einem Loch mit nichts als einer Laterne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006386
    m_Localized: 'Miner: Hier unten läuft die Zeit anders. Kein Licht, keine Uhren. Was weiß ich?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006385
    m_Localized: 'Miner: Was? Sprechen Sie lauter! Ich sitze hier seit ... zwei Tagen, vielleicht auch drei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006384
    m_Localized: Sind Ihre Freunde noch nicht zurück?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006383
    m_Localized: Wie lange sind Sie schon hier?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006382
    m_Localized: 'Miner: Was? Wieder zurück? Jetzt ist es ruhiger, oder? Oder werde ich langsam taub von diesem Brummen? Na los, spucken Sie’s aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006338
    m_Localized: 'MushroomEater: Auf Wiedersehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006337
    m_Localized: 'MushroomEater: Ich wünsche dir einen guten Tag, Gesundheit und viele Gründe zum Lächeln, mein lieber Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006336
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006335
    m_Localized: 'MushroomEater: Ich fürchte, alle Hoffnung ist verloren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006334
    m_Localized: 'MushroomEater: Nun denn ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006333
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006332
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006331
    m_Localized: 'MushroomEater: Ich frage dich also noch einmal, mein lieber Freund: Kommst du mit mir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006330
    m_Localized: 'MushroomEater: Ich weiß nicht, was uns im Land der Pilze erwartet ... aber dort lauern zweifellos Gefahren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006329
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006328
    m_Localized: 'MushroomEater: Wir beide fliegen durch stürmische Zeiten, die das Land der Pilze in die Knie gezwungen haben. Vielleicht stoßen auch wir auf sein Schicksal an, mein lieber Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006327
    m_Localized: 'MushroomEater: Ich fürchte, ich kann das nicht allein tun. Ich brauche deine Hilfe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006326
    m_Localized: 'MushroomEater: Oh, mein lieber Freund ... Das ist gar nicht gut ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006325
    m_Localized: 'MushroomEater: Bevor sich das Tor zum Land der Pilze schließt!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006324
    m_Localized: 'MushroomEater: Oh nein! Wir sind spät dran! Los, Beeilung!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006323
    m_Localized: 'MushroomEater: MITTERNACHT?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006322
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006321
    m_Localized: 'MushroomEater: Warte. Lass mich kurz deine Uhr sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006320
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006319
    m_Localized: 'MushroomEater: Pack deine Sachen und ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006318
    m_Localized: 'MushroomEater: Gut. Das wollte ich hören, mein lieber Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006317
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006316
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006315
    m_Localized: 'MushroomEater: Bist du bereit, mit mir ins Land der Pilze aufzubrechen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006314
    m_Localized: 'MushroomEater: Kein Mensch sollte jemals einen Fuß dort hineinsetzen. Aber wir müssen es tun, wenn wir das Festival verhindern wollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006313
    m_Localized: 'MushroomEater: Wenn wir nicht handeln, könnte alles verloren sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006312
    m_Localized: 'MushroomEater: Wir werden das Festival dort nicht erleben ... aber die anderen ... das Myzel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006311
    m_Localized: 'MushroomEater: Das ist kein Land, in dem eitel Sonnenschein herrscht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006310
    m_Localized: 'MushroomEater: In unserer Sprache mag er lustig klingen ... Aber in der Sprache der Pilze hat er eine ganz andere Bedeutung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006309
    m_Localized: 'MushroomEater: Lass dich vom Namen nicht täuschen, mein lieber Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006279
    m_Localized: 'MushroomEater: Das Myzel ist der denkende Teil. Schade, dass ich ihm nur zuhören kann ... Es versteht unsere Sprache nicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006278
    m_Localized: 'MushroomEater: Sie sind nur ein Teil des Myzels.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006277
    m_Localized: 'MushroomEater: Eine gute Idee. Aber leider kann ich nicht mit den Pilzen sprechen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006276
    m_Localized: 'MushroomEater: Das ist kein endgültiger Abschied, mein lieber Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006275
    m_Localized: 'MushroomEater: Und vergiss nicht: Pilze sind nicht immer das, was sie zu sein scheinen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006274
    m_Localized: 'MushroomEater: Wir sorgen dafür, dass die Pilze klein bleiben und das Festival nicht beginnen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006273
    m_Localized: 'MushroomEater: Ich komme wieder, wenn die Zeit gekommen ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006272
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006271
    m_Localized: 'MushroomEater: Und genau das haben wir getan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006270
    m_Localized: 'MushroomEater: Aber das Buch des Lächelns hat uns einen Weg gezeigt ... Eine Möglichkeit, ihre Wurzeln und ihr rasantes Wachstum zu beruhigen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006269
    m_Localized: 'MushroomEater: Wir können nicht direkt mit den Pilzen sprechen, da wir nicht Teil des Myzels sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006268
    m_Localized: 'MushroomEater: Wir haben ein altes Ritual durchgeführt, mein lieber Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006267
    m_Localized: Kannst du die Pilze nicht bitten, das Festival abzusagen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006266
    m_Localized: Wie genau verhindern unsere Taten das Festival?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006265
    m_Localized: 'MushroomEater: Wir können nur abwarten ... und hoffen, dass es genug war, um die Pilze am Wachsen zu hindern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006264
    m_Localized: 'MushroomEater: Oh, mein lieber Freund ... Wenn es nur so einfach wäre. Wir wissen noch nicht, ob unsere Taten wirklich geholfen haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006263
    m_Localized: Kannst du die Pilze nicht bitten, das Festival abzusagen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006262
    m_Localized: Wie genau verhindern unsere Taten das Festival?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006261
    m_Localized: 'MushroomEater: Die Pilze wachsen zu schnell.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006260
    m_Localized: 'MushroomEater: Es weiß viele Dinge. Aber auch das Myzel ist in Gefahr ... genau wie wir alle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006259
    m_Localized: 'MushroomEater: Das Myzel hat es mir erzählt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006258
    m_Localized: Du klingst nicht sehr überzeugt
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006257
    m_Localized: Woher weißt du das?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006256
    m_Localized: 'MushroomEater: Hoffentlich war es genug, um das Festival zu verhindern ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006255
    m_Localized: 'MushroomEater: Da bist du ja wieder, mein lieber Freund. Du hast alles getan, worum das Buch des Lächelns dich gebeten hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006254
    m_Localized: 'MushroomEater: Ah ... Vielleicht verschwende ich nur meine Zeit ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006253
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006252
    m_Localized: 'MushroomEater: Aber warum? Die Seiten sind nur ein kleiner Teil des Buches ... und ich kenne sie in- und auswendig ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006251
    m_Localized: 'MushroomEater: Ich wünsche dir einen guten Tag, Gesundheit und viele Gründe zum Lächeln, mein lieber Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006250
    m_Localized: 'MushroomEater: Ich komme wieder, sobald du alles erledigt hast, was die Seiten verlangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006249
    m_Localized: 'MushroomEater: Nun denn ... Ich muss los.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006248
    m_Localized: 'MushroomEater: Gut. Wirf einen Blick darauf, sobald du eine ruhige Minute hast.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006247
    m_Localized: Behalte sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006246
    m_Localized: Na gut, ich nehme die Seiten aus dem Buch des Lächelns
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006245
    m_Localized: 'MushroomEater: Ich habe ein paar Seiten aus dem Buch des Lächelns gerissen. Bitte, nimm sie. Sie verraten dir, was zu tun ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006244
    m_Localized: 'MushroomEater: Das dürfen wir nicht zulassen. Wir müssen es verhindern ... Mit vereinten Kräften, mein lieber Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006243
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006242
    m_Localized: 'MushroomEater: Und dieser Pilz wird nicht allein sein. Denn das Festival steht vor der Tür.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006241
    m_Localized: 'MushroomEater: Sein Schatten wird die Sonne verschlucken ... und kein einziger Ort wird verschont bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006240
    m_Localized: 'MushroomEater: Ein riesiger Pilz wird sich erheben ... und seine Sporen überall verteilen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006239
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006238
    m_Localized: 'MushroomEater: Ich kann dir nur sagen, was im Buch des Lächelns über das Festival steht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006237
    m_Localized: 'MushroomEater: Ah ... Mein lieber Freund ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006236
    m_Localized: Behalte sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006235
    m_Localized: Na gut, ich nehme die Seiten aus dem Buch des Lächelns
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006234
    m_Localized: 'MushroomEater: Also habe ich nur die wichtigsten Seiten herausgerissen. Hier ... nimm sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006233
    m_Localized: 'MushroomEater: Aber ich fürchte, wir haben keine Zeit, es durchzulesen. Es ist ein sehr dickes Buch ... und die Zeit läuft uns davon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006232
    m_Localized: 'MushroomEater: Es ist ein außergewöhnliches Buch, das außergewöhnlichste der Welt. Es verrät einem, was zu tun ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006231
    m_Localized: Pilzfestival?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006230
    m_Localized: Buch des Lächelns?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006229
    m_Localized: 'MushroomEater: Ich habe etwas dabei, das uns helfen wird. Das Buch des Lächelns.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006228
    m_Localized: 'MushroomEater: Keine Sorge, bald ergibt alles einen Sinn. Wichtig ist jetzt, dass wir das Festival um jeden Preis verhindern müssen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006227
    m_Localized: Pilzfestival?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006226
    m_Localized: Buch des Lächelns?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006225
    m_Localized: 'MushroomEater: Es ging darum, dass das Pilzfestival vor der Tür steht ... Und das, mein lieber Freund, sind keine guten Nachrichten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006224
    m_Localized: 'MushroomEater: Mit dem Buch des Lächelns habe ich gelernt, es zu verstehen. Und was das Myzel mir zuletzt erzählt hat ... ist höchst beunruhigend.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006223
    m_Localized: 'MushroomEater: Durch das Myzel unterhalten sich die Pilze miteinander.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006222
    m_Localized: 'MushroomEater: Ja, ja. Aber für normale Leute ist es schwer zu verstehen. Es kommuniziert auf ganz eigentümliche Weise.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006221
    m_Localized: Ich kann dir nicht folgen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006220
    m_Localized: Myzel?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006219
    m_Localized: 'MushroomEater: Also hör gut zu. Wir haben jede Menge zu tun, aber nicht mehr viel Zeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006218
    m_Localized: 'MushroomEater: Seine Art zu kommunizieren hat ihre Tücken, aber ich habe gelernt, es zu verstehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006217
    m_Localized: 'MushroomEater: Natürlich kenne ich dich. Das Myzel hat mir von dir erzählt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006216
    m_Localized: Ich kann dir nicht folgen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006215
    m_Localized: Myzel?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006214
    m_Localized: 'MushroomEater: Also hör mir bitte zu und verwahre meine Worte an einem sicheren Ort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006213
    m_Localized: 'MushroomEater: Das Pilzfestival steht vor der Tür und die Zeit läuft uns davon, mein lieber Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006212
    m_Localized: 'MushroomEater: Aber das ist jetzt nicht so wichtig. Das Myzel hat mir etwas sehr Beunruhigendes erzählt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006211
    m_Localized: 'MushroomEater: Hehe, ich bin nur ein alter Mann, der sich ganz gut mit Pilzen auskennt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006210
    m_Localized: Kennen wir uns?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006209
    m_Localized: Wer sind Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006208
    m_Localized: 'MushroomEater: Hallo, mein lieber Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812165
    m_Localized: 'CultistPriest: Wir gehen. Was getan werden musste, ist getan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812164
    m_Localized: 'CultistPriest: Wie dem auch sei, danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812163
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812162
    m_Localized: 'CultistPriest: Oder liegt es daran, dass Sie gar keinen Frieden wollen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812161
    m_Localized: 'CultistPriest: Haben sie Ihnen große Umstände bereitet?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812160
    m_Localized: 'CultistPriest: Ich nehme sie mit. Wie auch immer, danke für Ihre Hilfe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812159
    m_Localized: 'CultistPriest: Nun gut ... Sie haben genug getan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812158
    m_Localized: Das hier ist keine Kinderkrippe
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812157
    m_Localized: Lassen Sie mich in Ruhe
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812156
    m_Localized: 'CultistPriest: Wir haben keine andere Wahl, als nach ihm zu rufen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812155
    m_Localized: 'CultistPriest: Aber der Tod selbst ... Vielleicht erspart er uns das Schlimmste ... die Leere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812154
    m_Localized: 'CultistPriest: Wiedergeburt klingt nach endlosen Qualen mit kurzen Pausen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812153
    m_Localized: 'CultistPriest: Das Jenseits ist nur ein Konzept, das von Religionen versprochen wird.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812152
    m_Localized: 'CultistPriest: Der Gedanke, für immer zu verschwinden, ist furchterregend.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812151
    m_Localized: 'CultistPriest: Wichtig ist ... dass wir alle müde sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812150
    m_Localized: 'CultistPriest: Es ist in Ordnung, wenn wir nicht genau verstehen, was wir heraufbeschwören.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812149
    m_Localized: 'CultistPriest: Ich glaube, seine Ankunft steht kurz bevor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812148
    m_Localized: Das hier ist keine Kinderkrippe
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812147
    m_Localized: Lassen Sie mich in Ruhe
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812146
    m_Localized: 'CultistPriest: Warum?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812145
    m_Localized: Warum sind Sie so besessen vom Tod?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812144
    m_Localized: Nehmen Sie Ihre Spinner mit
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812143
    m_Localized: 'CultistPriest: Gute Nacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812142
    m_Localized: 'CultistPriest: Wenn der Tod Sie auserkoren hat, werde ich ihm helfend zur Seite stehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812141
    m_Localized: 'CultistPriest: Deshalb ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812140
    m_Localized: 'CultistPriest: Sie haben es nicht geschafft ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812139
    m_Localized: Warum sind Sie so besessen vom Tod?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812138
    m_Localized: Nehmen Sie Ihre Spinner mit
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812137
    m_Localized: 'CultistPriest: Dann werde ich Sie nicht länger aufhalten. Ich ziehe weiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812136
    m_Localized: 'CultistPriest: Gut. So soll es sein. Der Tod hat uns immer noch im Blick.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812135
    m_Localized: Verschwinden Sie, ich habe zu tun
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812134
    m_Localized: Ihre Leute sind wohlauf
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812133
    m_Localized: 'CultistPriest: Es geht Ihnen doch gut, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812132
    m_Localized: 'CultistPriest: So geht die Welt also zu Ende. Nicht mit einem Knall ... sondern mit einem Schluchzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812131
    m_Localized: 'CultistPriest: Der Tod spricht nicht mehr zu mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812130
    m_Localized: 'CultistPriest: Auf Wiedersehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812129
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812128
    m_Localized: 'CultistPriest: Sie ... Sie haben uns die einzige Chance genommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812127
    m_Localized: 'CultistPriest: Sind sie tot?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812126
    m_Localized: 'CultistPriest: Warten Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812125
    m_Localized: 'CultistPriest: Ich weiß noch nicht, was das bedeutet ... aber klingt das nicht verlockend?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812124
    m_Localized: 'CultistPriest: Vielleicht bietet er Ihnen einen Ort, an dem Sie sich verstecken können. Vor allem. Sogar vor dem Tod selbst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812123
    m_Localized: 'CultistPriest: Der Tod hat kürzlich zu mir gesprochen. Er würde Sie gerne treffen, wenn die Zeit gekommen ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812122
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812121
    m_Localized: 'CultistPriest: Sie sind bestimmt auch erschöpft. Von all diesem Lärm. Diesen schweren Zeiten. Dieser Verwirrung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812120
    m_Localized: 'CultistPriest: Danke für Ihre Hilfe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812119
    m_Localized: Ist mir egal, ich habe meine eigenen Probleme
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812118
    m_Localized: Ja, ja, sie leben noch
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812117
    m_Localized: 'CultistPriest: Verlieren wir keine Zeit. Wie geht es meinen Leuten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812116
    m_Localized: 'CultistPriest: Bis später. Ich komme wieder, um nach ihnen zu sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812115
    m_Localized: 'CultistPriest: Sie werden nicht lange brauchen. Aber passen Sie bitte auf sie auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812114
    m_Localized: 'CultistPriest: Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812113
    m_Localized: 'CultistPriest: Es wird vermutlich nicht lange dauern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812112
    m_Localized: 'CultistPriest: Also, lassen Sie sie hierbleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812111
    m_Localized: 'CultistPriest: Wohin werden Sie fliehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812110
    m_Localized: 'CultistPriest: Selbst wenn Sie überleben – Ihr Haus wird es nicht mehr geben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812109
    m_Localized: 'CultistPriest: Weitere werden kommen. Wenn Sie schlafen, werden sie Ihr Haus mit Benzin übergießen und ein Streichholz anzünden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812108
    m_Localized: 'CultistPriest: Glauben Sie, es wären nur wir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812107
    m_Localized: Ich mag keine Drohungen, aber ich helfe
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812106
    m_Localized: Dann erschieße ich Sie alle
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812105
    m_Localized: 'CultistPriest: Es tut mir leid, aber das ist die einzige Möglichkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812104
    m_Localized: 'CultistPriest: Also ja. Wenn unsere Sache scheitert, werden wir Ihr Haus niederbrennen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812103
    m_Localized: 'CultistPriest: Aber wenn es mehr werden ... sind wir in Gefahr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812102
    m_Localized: 'CultistPriest: Behalten Sie meine Leute im Auge. Und denken Sie dran: Wenn einer von ihnen stirbt ... bleibt von Ihrem Haus nichts übrig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812101
    m_Localized: 'CultistPriest: Sehnen Sie sich nicht auch nach Frieden? Nach einer Welt, in der niemand dem anderen zur Last fällt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812100
    m_Localized: 'CultistPriest: Das stimmt. Der Weg zu einem höheren Sinn ist niemals einfach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812099
    m_Localized: Ich mag keine Drohungen, aber ich helfe
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812098
    m_Localized: Dann erschieße ich Sie alle
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812097
    m_Localized: 'CultistPriest: Verzeihen Sie mir. Aber das ist der einzige Weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812096
    m_Localized: 'CultistPriest: Und dann werden wir Ihr Haus niederbrennen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812095
    m_Localized: 'CultistPriest: Aber wenn es mehr sind, werden wir scheitern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812094
    m_Localized: 'CultistPriest: Behalten Sie meine Leute im Auge. Und denken Sie dran: Wenn einer von ihnen stirbt ... bleibt von Ihrem Haus nichts übrig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812093
    m_Localized: 'CultistPriest: Vielleicht werden Sie am Ende verbrennen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812092
    m_Localized: Das ist ziemlich viel verlangt
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812091
    m_Localized: Ich bin nicht gerade begeistert
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812090
    m_Localized: 'CultistPriest: Sie werden Rituale für die Verstorbenen durchführen. Sie müssen ihnen nur Schutz geben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812089
    m_Localized: 'CultistPriest: Aber meine Leute werden kommen. Der Tod wird von diesem Ort angezogen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812088
    m_Localized: 'CultistPriest: Ich werde nicht reinkommen. Unsere Mission besteht darin, den friedensstiftenden Glauben zu verbreiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812087
    m_Localized: Das ist ziemlich viel verlangt
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812086
    m_Localized: Ich bin nicht gerade begeistert
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812085
    m_Localized: 'CultistPriest: Sie müssen überleben, bis ihre Aufgaben erledigt sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812084
    m_Localized: 'CultistPriest: Bitte, lassen Sie meine Leute hierbleiben. Geben Sie ihnen Schutz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812083
    m_Localized: 'CultistPriest: Was ist hier los?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812082
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812081
    m_Localized: 'CultistPriest: Der Einfluss des Todes ist hier besonders stark.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812080
    m_Localized: 'CultistPriest: Ihr Haus ist perfekt dafür.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812079
    m_Localized: 'CultistPriest: Wir müssen die Begräbnisrituale durchführen. Auf neue Art.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812078
    m_Localized: Wollen Sie reinkommen, oder was?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812077
    m_Localized: Was wollen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812076
    m_Localized: 'CultistPriest: Er ist bereits nah. Wir helfen ihm lediglich über die Türschwelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812075
    m_Localized: 'CultistPriest: Wir glauben nicht an die Erlösung. Es sei denn, sie kommt vom Tod selbst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812074
    m_Localized: 'CultistPriest: Das ist mein Leichenhemd. Wenn wir sterben, muss niemand nach Kleidung suchen, um die Toten zu verhüllen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812073
    m_Localized: 'CultistPriest: Vielleicht. Ich hätte nichts dagegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812072
    m_Localized: Wollen Sie reinkommen, oder was?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812071
    m_Localized: Was wollen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812070
    m_Localized: 'CultistPriest: Das ist die einzige Möglichkeit, Frieden zu finden. In Zeiten wie diesen ... gibt es kein Zurück in die Vergangenheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812069
    m_Localized: 'CultistPriest: Wir helfen ihm lediglich, sich zu nähern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812068
    m_Localized: 'CultistPriest: Der Tod ist gekommen. Er will der Menschheit Frieden geben, uns von Angst, Verbitterung und Lärm befreien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812067
    m_Localized: 'CultistPriest: Wir bringen neuen Glauben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812066
    m_Localized: Sie sehen aus wie irgendein Sektenheini
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812065
    m_Localized: Warum sind Sie so gekleidet?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812064
    m_Localized: 'CultistPriest: Der Tod hat Gefallen an Ihnen gefunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812063
    m_Localized: 'CultistPriest: Manche wurden verbrannt. Andere wurden verschleppt und hingerichtet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812062
    m_Localized: 'CultistPriest: Der Tod ist überall.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812061
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812060
    m_Localized: 'CultistPriest: Sie haben recht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812059
    m_Localized: Sie sehen aus wie irgendein Sektenheini
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812058
    m_Localized: Warum sind Sie so gekleidet?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812057
    m_Localized: 'CultistPriest: Ich weiß nicht, wie viele hier gestorben sind ... aber die Präsenz des Todes ist stark.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812056
    m_Localized: 'CultistPriest: Der Tod mag Ihr Haus. Er ist ganz verrückt danach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812055
    m_Localized: 'CultistPriest: Den Tod.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812054
    m_Localized: Dieses Haus gehört mir
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812053
    m_Localized: Was genau spüren Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812052
    m_Localized: 'CultistPriest: Das spüre ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812051
    m_Localized: 'CultistPriest: Ja. Ihr Haus ist perfekt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812050
    m_Localized: 'Courier: Hier. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812041
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812040
    m_Localized: 'Courier: Warum zur Hölle denkt dieses Arschloch, dass ein normaler Lieferant gefährlich ist? Warum bringt er ihn gleich um? Was soll das?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812039
    m_Localized: 'Courier: Die Leute sind vollkommen verrückt geworden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812038
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812037
    m_Localized: 'Courier: Er wollte eine Lieferung zustellen, und der Hausbesitzer ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812036
    m_Localized: 'Courier: Mein Freund wurde umgebracht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812035
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812034
    m_Localized: Was ist mit Ihnen passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812033
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812030
    m_Localized: 'Courier: Lieferung ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812029
    m_Localized: 'Courier: Gute Nacht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812027
    m_Localized: 'Courier: Und was, wenn ich auch rote Augen bekomme, weil ich nicht schlafen kann? Lande ich dann auch in der Quarantänezone?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812026
    m_Localized: 'Courier: Und das war’s. Sie haben ihn mitgenommen. Und ich weiß nicht mal, was mit ihm passiert ist. Oder ob sie ihn jemals wieder freilassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812025
    m_Localized: 'Courier: Morgenkontrolle, so wie immer. Sie haben seine Augen bemerkt. Rote Augen, verdammt noch mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812024
    m_Localized: 'Courier: Die FEMA hat meinen Kollegen mitgenommen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812023
    m_Localized: Sie sehen niedergeschlagen aus
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812021
    m_Localized: 'Courier: Hallo ... Hier ist der Lieferservice.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812020
    m_Localized: 'Courier: Gute Nacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812019
    m_Localized: 'Courier: Die Arbeit lenkt mich wenigstens von diesem ganzen Mist ab ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812018
    m_Localized: 'Courier: Na ja, was soll ich denn sonst machen? Zu Hause vergammeln wie die meisten anderen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812017
    m_Localized: 'Courier: Oh, Sie meinen, warum ich das hier mache?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812016
    m_Localized: 'Courier: Ich habe alle Tests bestanden. Sie haben mich auf alle Merkmale überprüft und entschieden, dass ich ein Mensch bin ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812015
    m_Localized: Wie sind Sie zum Lieferservice gekommen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812013
    m_Localized: 'Courier: Hallo, hier ist der Lieferservice „For Rest“.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812012
    m_Localized: 'Courier: Tut mir leid, ich habe mich immer noch nicht daran gewöhnt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812011
    m_Localized: 'Courier: Guten Tag – äh, ich meine gute Nacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812005
    m_Localized: Ich dachte nicht, dass es noch Lieferungen gibt
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812003
    m_Localized: 'Courier: Hallo, hier ist der Lieferservice „For Rest“.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812002
    m_Localized: 'Intruder: Ohne Träume ist es schwer. Für jeden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812001
    m_Localized: 'Intruder: Ich hoffe es.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812000
    m_Localized: 'Intruder: Glauben Sie, dass die Leute jemals wieder anfangen zu träumen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811999
    m_Localized: 'Intruder: Aber wenn irgendjemand anders in diesem Haus träumt, ist das auch schon was.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811998
    m_Localized: 'Intruder: Danke. Ich werde versuchen, hier zu schlafen. Auch wenn es wahrscheinlich nicht klappen wird.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811997
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811996
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811995
    m_Localized: 'Intruder: Vielleicht würde ich etwas träumen, wenn ich schlafen würde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811994
    m_Localized: 'Intruder: Ich habe seit sechs Tagen nicht geschlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811993
    m_Localized: 'Intruder: Schwer zu sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811992
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811991
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811990
    m_Localized: 'Intruder: Wahrscheinlich, weil sie diesen Rückzugsort verloren haben. Diese Ruhezeit. Zum Reflektieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811989
    m_Localized: 'Intruder: Aber jetzt? Sie gehen kaputt. Drehen durch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811988
    m_Localized: 'Intruder: Im Traum lassen die Leute los. Sie suchen nach Antworten, nach Trost ... und kommen zur Ruhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811987
    m_Localized: 'Intruder: Träume sind ... flüchtig. Eine seltsame Sache.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811986
    m_Localized: Und Sie? Träumen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811985
    m_Localized: Warum interessiert Sie das?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811984
    m_Localized: 'Intruder: Ich frage mich ... ob es an der Sonne liegt? Oder woran sonst?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811983
    m_Localized: 'Intruder: Wie bei den meisten Leuten. Nicht einmal Fieberträume. Gar nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811982
    m_Localized: 'Intruder: Das dachte ich mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811981
    m_Localized: Und Sie? Träumen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811980
    m_Localized: Warum interessiert Sie das?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811979
    m_Localized: 'Intruder: Was glauben Sie, woran das liegt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811978
    m_Localized: 'Intruder: Die Leute träumen kaum noch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811977
    m_Localized: 'Intruder: Wissen Sie, was mir aufgefallen ist?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811976
    m_Localized: 'Intruder: Sie wissen doch wohl, was Träume sind. Wenn Sie schlafen ... sehen Sie dann irgendwas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811975
    m_Localized: Nicht wirklich
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811974
    m_Localized: Was?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811973
    m_Localized: 'Intruder: Träumen Sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811972
    m_Localized: 'FormerFema: Tschüss.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811971
    m_Localized: 'FormerFema: Ich weiß gar nicht, warum ich ihn überhaupt noch habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811970
    m_Localized: 'FormerFema: Dieser Anzug ist wohl ganz schön unheimlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811969
    m_Localized: 'FormerFema: ... Moment, das kam falsch rüber. Ja, ich versteh schon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811968
    m_Localized: 'FormerFema: Was? Oh, danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811967
    m_Localized: 'FormerFema: Ich dachte nicht, dass du mich wirklich reinlassen würdest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811966
    m_Localized: 'FormerFema: Kann ich mich irgendwo hinsetzen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811965
    m_Localized: 'FormerFema: Was? Oh, danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811964
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811963
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811962
    m_Localized: 'FormerFema: Ich spreche übrigens vom Programmieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811961
    m_Localized: 'FormerFema: Am Ende habe ich nichts von dem getan, was sie versprochen haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811960
    m_Localized: 'FormerFema: Dann kam die große Enttäuschung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811959
    m_Localized: 'FormerFema: Ich hatte einen Job. Ich dachte, alles wäre gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811958
    m_Localized: 'FormerFema: Gute Frage. Im Moment fühle ich mich einfach nur ... verloren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811957
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811956
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811955
    m_Localized: 'FormerFema: Ich war mit den Kräften am Ende und habe gekündigt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811954
    m_Localized: 'FormerFema: Es sind nicht genügend Leute übrig. Wir kamen mit der Arbeit nicht mehr hinterher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811953
    m_Localized: 'FormerFema: Und ... ich arbeite nicht mehr dort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811952
    m_Localized: 'FormerFema: Ich habe Kühlschränke gebaut. Und repariert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811951
    m_Localized: 'FormerFema: Nur ein ganz normaler Fabrikarbeiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811950
    m_Localized: Was hast du vor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811949
    m_Localized: Und wer bist du?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811948
    m_Localized: 'FormerFema: Wer weiß, was dort wirklich gespielt wird?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811947
    m_Localized: 'FormerFema: Und sie kommen nie zurück.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811946
    m_Localized: 'FormerFema: Wegen ... der Dinge, die sie tun. Leute werden verschleppt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811945
    m_Localized: 'FormerFema: Soweit ich weiß, wird die FEMA von allen gehasst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811944
    m_Localized: 'FormerFema: Oh! Nein, ich bin nicht bei der FEMA. Hat dich die Uniform auf die Idee gebracht?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811943
    m_Localized: 'FormerFema: Ich verstehe nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811942
    m_Localized: 'FormerFema: Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811941
    m_Localized: Was hast du vor?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811940
    m_Localized: Und wer bist du?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811939
    m_Localized: 'FormerFema: Vielleicht hinterlässt die Sonne nachts irgendeine Strahlung oder so. Ich will es gar nicht wissen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811938
    m_Localized: 'FormerFema: Ich dachte, der würde mich schützen. Diese Typen tragen die Anzüge ja nicht ohne Grund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811937
    m_Localized: 'FormerFema: Nein, den habe ich mir von einer Leiche geschnappt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811936
    m_Localized: 'FormerFema: Oh ... Du dachtest, ich bin von der FEMA, weil ich diesen Anzug trage?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811935
    m_Localized: 'FormerFema: Welche Leute?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811934
    m_Localized: Hast du es diesmal auf mich abgesehen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811933
    m_Localized: Bring zuerst die Leute zurück
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811932
    m_Localized: 'FormerFema: Kannst du sie ... aufmachen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811931
    m_Localized: 'FormerFema: Ich habe Schritte gehört ... Das heißt, du bist zur Tür gekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811930
    m_Localized: 'FormerFema: Hallo? Ist jemand zu Hause?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811929
    m_Localized: 'GraveDigger: Ich verlasse das Haus nie wieder. Zumindest nicht jetzt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811928
    m_Localized: 'GraveDigger: Ich hab Geschichten gehört ... Jemand verlässt das Haus, kommt zurück – und zack, das war’s.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811927
    m_Localized: 'GraveDigger: Dann klopfen die Besucher an ... oder noch schlimmer – sie sind schon drinnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811926
    m_Localized: 'GraveDigger: Man kommt nach Hause und niemand ist da.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811925
    m_Localized: 'GraveDigger: Da schuftet man sich sein Leben lang den Rücken krumm – und wofür das alles?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811924
    m_Localized: 'GraveDigger: Hehe ... Kumpel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811923
    m_Localized: 'GraveDigger: Aber beeilen Sie sich mit der Tür, ja? Ich hab Angst, dass die Besucher mir auf den Fersen sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811922
    m_Localized: 'GraveDigger: Danke, Mann!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811921
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811920
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811919
    m_Localized: 'GraveDigger: Wie dem auch sei – ich bin raus. Zur Hölle damit. Mir reicht’s.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811918
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811917
    m_Localized: 'GraveDigger: Wenn das Unglück doch nur so über uns wachen würde wie wir über das Unglück.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811916
    m_Localized: 'GraveDigger: Die Sonne verbrennt die Leichen sowieso ... und die Nächte sind zu kurz, um sich um die Toten zu kümmern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811915
    m_Localized: 'GraveDigger: Niemand bringt mehr Leichen. Die Leute scheren sich nicht mehr um den Tod, geschweige denn um anständige Beerdigungen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811914
    m_Localized: 'GraveDigger: Der Job ist keinen Pfifferling wert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811913
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811912
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811911
    m_Localized: 'GraveDigger: Ich rannte wie der Teufel. Konnte mich nicht mal umdrehen. Nach Hause hab ich mich nicht getraut. Unter Menschen ist es sicherer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811910
    m_Localized: 'GraveDigger: Ein Besucher! Er kam aus dem Boden gekrochen! Und dieser Kerl? Hat einfach nur gelacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811909
    m_Localized: 'GraveDigger: Ich dachte, es wäre ein Stein, aber nein – auf einmal kam eine Hand aus der Erde!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811908
    m_Localized: 'GraveDigger: Ich grabe und grabe ... und plötzlich stößt die Schaufel auf irgendwas Hartes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811907
    m_Localized: 'GraveDigger: Er steht rum und sieht mir bei der Arbeit zu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811906
    m_Localized: 'GraveDigger: Verdammt. Ich habe ein Grab ausgehoben – irgendein Kerl hat eins bestellt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811905
    m_Localized: Haben Sie den Job an den Nagel gehängt?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811904
    m_Localized: Haben Sie was Interessantes gesehen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617825
    m_Localized: 'GraveDigger: Sie lassen sie einfach in der Gegend rumliegen. Die Sonne tut dann ihr Übriges.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617824
    m_Localized: 'GraveDigger: Die Leute fallen in letzter Zeit um wie die Fliegen, aber niemand begräbt sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617823
    m_Localized: 'GraveDigger: Sie haben nicht gesehen, was ich beim Ausheben des letzten Grabs gesehen habe ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617822
    m_Localized: 'GraveDigger: Entschuldigen Sie das Hämmern. Aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617821
    m_Localized: Haben Sie den Job an den Nagel gehängt?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617820
    m_Localized: Haben Sie was Interessantes gesehen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617819
    m_Localized: 'GraveDigger: Gräber haben keinerlei Bedeutung mehr. Die Leute bleiben da liegen, wo sie umfallen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617818
    m_Localized: 'GraveDigger: Ich war ein Totengräber, wissen Sie? Aber was spielt das jetzt noch für eine Rolle?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617817
    m_Localized: 'GraveDigger: Ich hab selber keine Sekunde geschlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617816
    m_Localized: 'GraveDigger: Hey, nichts für ungut. Ich wollte Sie nicht aufwecken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617815
    m_Localized: Hämmern Sie sich lieber selbst gegen den Kopf!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617814
    m_Localized: Hämmern Sie nicht gegen die Tür
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617813
    m_Localized: 'GraveDigger: Wollen Sie mich reinlassen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617812
    m_Localized: 'GraveDigger: Lebt da noch irgendjemand? Hallo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617811
    m_Localized: 'Marauder: Na gut. Dann gehe ich jetzt auch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617810
    m_Localized: 'Marauder: Oh? Sind Sie schon weg?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617809
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617808
    m_Localized: 'Marauder: Ich bin nur auf der Durchreise. Bin bald wieder weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617807
    m_Localized: 'Marauder: Sie kennen nicht zufällig irgendwelche verlassenen Orte in der Nähe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617806
    m_Localized: 'Marauder: Kein Problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617805
    m_Localized: 'Marauder: Ich werde Sie nicht langweilen, versprochen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617804
    m_Localized: 'Marauder: Sprechen Sie mich mal an. Ich erzähle Ihnen Geschichten. Davon habe ich jede Menge auf Lager.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617803
    m_Localized: 'Marauder: Na, wer sagt’s denn? Endlich kann ich mal schlafen wie ein normaler Mensch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617802
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617801
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617800
    m_Localized: 'Marauder: Wie auch immer ... Wenn Sie hier wohnen, könnte ich vielleicht hier übernachten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617799
    m_Localized: 'Marauder: Aber ... es gab da dieses eine Mal. Längere Geschichte. Ich erzähle sie Ihnen später.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617798
    m_Localized: 'Marauder: Ich bin zwar kein Heiliger, aber es gibt gewisse Grenzen, die ich nicht überschreite. Ich rühre keine Lebenden an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617797
    m_Localized: 'Marauder: Halten Sie mich etwa für irgendeinen Kriminellen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617796
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617795
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617794
    m_Localized: 'Marauder: Ich habe Geschichten. Von Dingen, die ich da draußen gesehen habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617793
    m_Localized: 'Marauder: Nichts für ungut, ja? Aber wenn Sie hier wohnen ... kann ich vielleicht bei Ihnen bleiben?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617792
    m_Localized: 'Marauder: Aber ja ... Ich wollte ihr Haus plündern. Ich dachte, es sei leer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617791
    m_Localized: 'Marauder: Ich war an einem Punkt, an dem ich fast damit aufgehört hätte. Aber nur fast.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617790
    m_Localized: 'Marauder: Ich schnappe mir, was ich kann. Manches verkaufe ich, manches behalte ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617789
    m_Localized: 'Marauder: Hm. Warum soll ich lügen? Ich plündere verlassene Orte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617788
    m_Localized: Bestehlen Sie andere?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617787
    m_Localized: Wie haben Sie allein überlebt?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617786
    m_Localized: 'Marauder: Das alles geht mir langsam an die Nieren. Es fühlt sich an, als würde ich verrückt werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617785
    m_Localized: 'Marauder: Aber wenn ich ehrlich bin, habe ich genug davon. Ich bin es leid, mit Schatten zu reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617784
    m_Localized: 'Marauder: Zuerst dachte ich, es sei sicherer so.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617783
    m_Localized: 'Marauder: Seit die Besucher aus ihren Löchern gekrochen sind, war ich auf mich allein gestellt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617782
    m_Localized: 'Marauder: Warum nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617781
    m_Localized: Bestehlen Sie andere?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617780
    m_Localized: Wie haben Sie allein überlebt?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617779
    m_Localized: 'Marauder: Aber ja ... Ich konnte mich in keine Gruppe einfügen ... also bin ich ganz allein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617778
    m_Localized: 'Marauder: Das Ding ist nur: Ich habe gesehen, wozu Menschen fähig sind. Ich bin weit davon entfernt, der Schlimmste zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617777
    m_Localized: 'Marauder: Als wäre ich schlimmer als all die anderen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617776
    m_Localized: 'Marauder: Weil sich niemand mit mir abgeben will. Die Leute halten mich für Abschaum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617775
    m_Localized: Warum halten Sie das für eine gute Idee?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617774
    m_Localized: Warum sind Sie allein?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617773
    m_Localized: 'Marauder: Hören Sie, äh ... Kann ich eine Weile hierbleiben? Ich war lange nicht mehr, na ja ... unter Leuten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617772
    m_Localized: 'Marauder: Obwohl ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617771
    m_Localized: 'Marauder: Hey. Ich dachte, hier sei tote Hose. Bin schon wieder weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617770
    m_Localized: 'Marauder: Moment mal ... Hier wohnt ja doch jemand.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617769
    m_Localized: 'Provocateur: Einen schönen Tag noch ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617768
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617767
    m_Localized: 'Provocateur: Und glauben Sie mir, das würde für Sie kein gutes Ende nehmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617766
    m_Localized: 'Provocateur: Sie sollten Ihren Umgangston überdenken. Sonst könnte ich das als Drohung gegen mein Leben gemäß Artikel 119 der Verfassung interpretieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617765
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617764
    m_Localized: 'Provocateur: Verzeihung? Haben Sie eben gesagt, ich solle verschwinden? War das eine Drohung?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617763
    m_Localized: 'Provocateur: Die Einzelheiten des Mietvertrags besprechen wir später.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617762
    m_Localized: 'Provocateur: Danke, Hausherr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617761
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617760
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617759
    m_Localized: 'Provocateur: Entweder ich zahle, oder ich setze keinen Fuß in Ihr Haus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617758
    m_Localized: 'Provocateur: Das ist nicht richtig. Das ist gegen das Gesetz ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617757
    m_Localized: 'Provocateur: Tut mir leid, aber ich kann nicht guten Gewissens hier wohnen, ohne Miete zu bezahlen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617756
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617755
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617754
    m_Localized: 'Provocateur: Nun gut. Wir regeln die Formalitäten später – einen rechtlich einwandfreien Vertrag.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617753
    m_Localized: 'Provocateur: Unglaublich ... Ein Hausherr, der mein Geld verschmäht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617752
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617751
    m_Localized: 'Provocateur: Wollen Sie mir einen Gefallen tun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617750
    m_Localized: Ich brauche Ihr Geld nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617749
    m_Localized: Bezahlen Sie ruhig, wenn Sie wollen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617748
    m_Localized: 'Provocateur: Tut mir leid, aber ich weigere mich, wertvollen Wohnraum zu beanspruchen, ohne angemessen dafür zu bezahlen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617747
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617746
    m_Localized: 'Provocateur: Wie, Sie lassen die Leute einfach rein? Haben Sie eine Art Ehrenamt? Betreiben Sie hier eine Obdachlosenunterkunft?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617745
    m_Localized: Ich brauche Ihr Geld nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617744
    m_Localized: Bezahlen Sie ruhig, wenn Sie wollen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617743
    m_Localized: 'Provocateur: Wobei ... Nur, um sicherzugehen: Wie viel verlangen Sie pro Nacht?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617742
    m_Localized: 'Provocateur: Na schön. Ich schätze, die Formalitäten können wir auch später klären.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617741
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617740
    m_Localized: 'Provocateur: Das ist ... eine sehr vage Antwort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617739
    m_Localized: Ich lasse die Leute einfach rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617738
    m_Localized: So ungefähr
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617737
    m_Localized: 'Provocateur: Guten Tag, Hausherr. Bieten Sie dieses Haus zur Miete an?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617736
    m_Localized: 'TaxiDriver: Du bist auch nicht besser als diese FEMA-Mistkerle. Ich hoffe, du verreckst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617735
    m_Localized: 'TaxiDriver: Verdammt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617734
    m_Localized: 'TaxiDriver: Ja, ich bin in Panik geraten, aber das ist noch lange kein Grund, mich auszusperren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617733
    m_Localized: 'TaxiDriver: Hey, komm schon, Mann, tu mir das nicht an!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617732
    m_Localized: 'TaxiDriver: Wenn man nicht aufpasst, schnappen sie einen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617731
    m_Localized: 'TaxiDriver: Nicht vergessen: Diesen Mistkerlen in Gelb kann man nicht trauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617730
    m_Localized: 'TaxiDriver: Puh, danke, Mann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617729
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617728
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617727
    m_Localized: 'TaxiDriver: Also bin ich abgehauen. Jetzt kann ich nicht mal mehr nach Hause. Diese hinterhältigen Mistkerle warten bestimmt schon auf mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617726
    m_Localized: 'TaxiDriver: Sie wollten mich zusammen mit dem anderen Typen wegsperren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617725
    m_Localized: 'TaxiDriver: Ich hab ihn sofort zur FEMA gebracht. Ein Riesenfehler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617724
    m_Localized: 'TaxiDriver: Ich hab einen Blick in den Rückspiegel geworfen und diese schneeweißen Zähne gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617723
    m_Localized: 'TaxiDriver: Er war ein Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617722
    m_Localized: 'TaxiDriver: Ich bin wirklich nicht paranoid oder so, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617721
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617720
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617719
    m_Localized: 'TaxiDriver: Also hab ich einem davon eine Flasche über den Schädel gezogen, die ich im Mantel hatte. Und dann bin ich weggerannt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617718
    m_Localized: 'TaxiDriver: Ich hab’s ziemlich schnell bereut. Als sie mich vom Auto weggezerrt haben, wusste ich, dass die Bastarde mir auch an den Kragen wollten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617717
    m_Localized: 'TaxiDriver: Zuerst haben sie mich gelobt, von wegen „Gute Arbeit, Sie haben uns einen Besucher gebracht“. Aber dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617716
    m_Localized: 'TaxiDriver: Also hab ich ihn zur FEMA gebracht. Die haben ihn sofort weggesperrt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617715
    m_Localized: 'TaxiDriver: Ich hab diesen Fahrgast rumkutschiert, aber dann ist mir aufgefallen, dass seine Zähne zu weiß waren. Zu perfekt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617714
    m_Localized: 'TaxiDriver: Diese verdammten Mistkerle von der FEMA haben meine Karre geklaut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617713
    m_Localized: Was ist mit deinem Fahrgast passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617712
    m_Localized: Was ist mit deinem Auto passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617711
    m_Localized: 'TaxiDriver: Nicht, dass ich strunzdumm wäre. Ich hab nur dem Falschen vertraut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617710
    m_Localized: 'TaxiDriver: Ich hab’s aus eigener Dummheit verloren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617709
    m_Localized: 'TaxiDriver: Ich hatte ein Auto, ja ... aber jetzt nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617708
    m_Localized: Was ist mit deinem Fahrgast passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617707
    m_Localized: Was ist mit deinem Auto passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617706
    m_Localized: 'TaxiDriver: Und jetzt ist er weg ... und mein Auto auch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617705
    m_Localized: 'TaxiDriver: Er war nicht der, für den er sich ausgegeben hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617704
    m_Localized: 'TaxiDriver: Ich hatte diesen Fahrgast, und dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617703
    m_Localized: 'TaxiDriver: Ich weiß gar nicht, wo ich anfangen soll. Ich bin Taxifahrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617702
    m_Localized: Wobei brauchst du Hilfe?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617701
    m_Localized: Was ist passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617700
    m_Localized: 'TaxiDriver: Hör zu, ich stecke gerade bis zum Hals in der Scheiße. Kann ich hier eine Weile untertauchen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617699
    m_Localized: 'TaxiDriver: Hey, Mann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617698
    m_Localized: 'Edgar: Ich suche mir irgendwo ein schattiges Plätzchen. Aber bitte ... werfen Sie meine Leiche nicht achtlos weg, wenn es so weit ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617697
    m_Localized: 'Edgar: Ich werde auf die sanfte Umarmung des Todes warten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617696
    m_Localized: 'Edgar: Macht es Ihnen etwas aus, wenn ich in der Nähe bleibe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617695
    m_Localized: 'Edgar: Heben Sie meine auf, wenn es so weit ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617694
    m_Localized: 'Edgar: Ich weiß nicht, ob Sie Schönheit auf die gleiche Weise empfinden wie ich. Aber ... Sie entsorgen die Leichen doch nicht, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617693
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617692
    m_Localized: 'Edgar: Dies ist tatsächlich der stillste Ort, an dem ich jemals war.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617691
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617690
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617689
    m_Localized: 'Edgar: Ich möchte in der letzten Schönheit der Welt aufgehen. Ganz sanft.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617688
    m_Localized: 'Edgar: Deshalb bin ich gekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617687
    m_Localized: 'Edgar: Ich möchte das nicht. Irgendwie habe ich das Gefühl ... die Leute hier sind bereit für das Unausweichliche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617686
    m_Localized: 'Edgar: Meinen Sie, das hilft gegen die Blutvergiftung?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617685
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617684
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617683
    m_Localized: 'Edgar: Und nun stehe ich hier. Vor Ihnen. Ganz allein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617682
    m_Localized: 'Edgar: Dann kamen die Besucher. Und ... ich denke, den Rest der Geschichte kennen Sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617681
    m_Localized: 'Edgar: Sie veränderte sich ... jeden Tag. Und es war wunderschön.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617680
    m_Localized: 'Edgar: Früher lebte ich mit einer Frau zusammen, die ich liebte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617679
    m_Localized: 'Edgar: Das ist eine berechtigte Frage. Lassen Sie es mich so sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617678
    m_Localized: Sollen wir den Arm amputieren?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617677
    m_Localized: Wie haben Sie Wundbrand bekommen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617676
    m_Localized: 'Edgar: Ich fühle mich in der Panik der Stadt nicht wohl. Dort bewegen sich alle gegen den Strom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617675
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617674
    m_Localized: 'Edgar: Eine Geschichte wie meine erzählt man am besten in einem Rutsch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617673
    m_Localized: 'Edgar: Jeden Tag frage ich mich, ob ich den nächsten noch erlebe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617672
    m_Localized: 'Edgar: Natürlich würde ich sowieso zittern. Wegen der Fäulnis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617671
    m_Localized: 'Edgar: Wussten Sie das? Die Straßen kühlen gar nicht mehr ab, nicht mal in der Nacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617670
    m_Localized: 'Edgar: Ich zittere, sogar in der Hitze der Stadt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617669
    m_Localized: 'Edgar: Die Stille ... Die Leere. Es ist so friedlich hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617668
    m_Localized: Sollen wir den Arm amputieren?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617667
    m_Localized: Wie haben Sie Wundbrand bekommen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617666
    m_Localized: 'Edgar: Hier würde ich gerne sterben. Still und leise. Um den Moment zu genießen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617665
    m_Localized: 'Edgar: Jeder versucht zu überleben. Aber hier ... hat man seinen Frieden gemacht mit dem, was kommt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617664
    m_Localized: 'Edgar: Der Lärm der Stadt klebt an mir wie Schweiß. Die ganze Aufregung, das Durcheinander.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617663
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617662
    m_Localized: 'Edgar: Eine Geschichte wie meine erzählt man am besten in einem Rutsch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617661
    m_Localized: 'Edgar: Jeden Tag frage ich mich, ob ich den nächsten noch erlebe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617660
    m_Localized: 'Edgar: Ich fühle mich schlecht. Und das liegt nicht nur am Wundbrand.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617659
    m_Localized: Was finden Sie hier so schön?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617658
    m_Localized: Warum sind Sie nicht zu Hause geblieben?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617657
    m_Localized: 'Edgar: Ich dachte, ich könnte vielleicht hierbleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617656
    m_Localized: 'Edgar: Ruhiger als in der Stadt. Dort schreit einen förmlich alles an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617655
    m_Localized: 'Edgar: Hallo. Schön haben Sie’s hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617654
    m_Localized: 'Foreigner: (Nach einem kurzen Moment dreht er sich um und geht davon)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617653
    m_Localized: 'Foreigner: (Ihr Schrei erschreckt ihn)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617652
    m_Localized: 'Foreigner: Los, verschwinden Sie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617651
    m_Localized: 'Foreigner: (Er steht herum und nuschelt)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617650
    m_Localized: 'Foreigner: (Er nickt und kommt herein)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617649
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617648
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617647
    m_Localized: 'Foreigner: (Seine Wangen sehen aus, als seien sie nass vor Tränen)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617646
    m_Localized: 'Foreigner: (Er steht einfach nur da und starrt durch das Guckloch)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617645
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617644
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617643
    m_Localized: 'Foreigner: (Seine Wangen sehen aus, als seien sie nass vor Tränen)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617642
    m_Localized: 'Foreigner: (Er nuschelt etwas und schwenkt die Arme)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617641
    m_Localized: Und was soll ich jetzt mit Ihnen machen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617640
    m_Localized: Hat man Ihnen den Mund zugenäht?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617639
    m_Localized: 'Foreigner: (Er nuschelt wieder, aber Sie verstehen kein Wort)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617638
    m_Localized: 'Foreigner: (Seine Augenbrauen ziehen sich vor Verzweiflung zusammen)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617637
    m_Localized: Und was soll ich jetzt mit Ihnen machen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617636
    m_Localized: Hat man Ihnen den Mund zugenäht?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617635
    m_Localized: 'Foreigner: (Er ist offenbar nicht in der Lage zu antworten)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617634
    m_Localized: 'Foreigner: (Die Person sieht Sie mit hochgezogenen Augenbrauen an)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617633
    m_Localized: Was?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617632
    m_Localized: Was ist mit Ihnen los?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617631
    m_Localized: 'Foreigner: Mmmmmmmmpf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617630
    m_Localized: 'Foreigner: Mmmpf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617629
    m_Localized: 'Doctor: Wenn ich Glück habe, bleibe ich irgendwo in der Nähe. Sie können mich jederzeit um Hilfe bitten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617628
    m_Localized: 'Doctor: Ich verstehe. Momentan ist es nicht gerade einfach, jemandem zu vertrauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617627
    m_Localized: 'Doctor: Danke. Ich hoffe, dass ich jemandem helfen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617626
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617625
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617624
    m_Localized: 'Doctor: Wenn Sie mich reinlassen, kann ich Ihnen erzählen, was mit den Krankenhäusern passiert ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617623
    m_Localized: 'Doctor: Das ist eine lange Geschichte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617622
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617621
    m_Localized: 'Doctor: In der Innenstadt gab es ein Krankenhaus. Aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668865
    m_Localized: 'Doctor: Wenn Sie mich reinlassen, kann ich Ihnen erzählen, was mit den Krankenhäusern passiert ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668864
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617620
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617619
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617618
    m_Localized: 'Doctor: Und jetzt ... gibt es keine Krankenhäuser mehr. Also ziehe ich umher und helfe, wo ich kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617617
    m_Localized: 'Doctor: Unser Krankenhaus war immer knapp bei Kasse, deshalb musste ich vieles tun, was über meine eigentlichen Aufgaben hinausging.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617616
    m_Localized: 'Doctor: Früher habe ich Operationen durchgeführt. Ich bin Chirurg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617614
    m_Localized: Wo kommen Sie her?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617613
    m_Localized: Wer sind Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617612
    m_Localized: 'Doctor: Also dachte ich, ich sehe mal nach. Aber die Tür war abgeschlossen. Ich zog es vor, zu klopfen, anstatt die Tür einzutreten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617611
    m_Localized: 'Doctor: Und da es so still war, hatte ich nicht damit gerechnet, dass hier jemand wohnt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617610
    m_Localized: 'Doctor: Sicherheit ... und etwas, das die Langeweile vertreibt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617609
    m_Localized: 'Doctor: Nun, ich suche tatsächlich etwas. Dasselbe wie jeder andere auch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617608
    m_Localized: 'Doctor: Warum fragen Sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617607
    m_Localized: Wo kommen Sie her?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617606
    m_Localized: Wer sind Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617605
    m_Localized: 'Doctor: Oder jemand weint vor lauter Kummer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617604
    m_Localized: 'Doctor: Oder jemand schreit vor Schmerzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617603
    m_Localized: 'Doctor: Normalerweise brüllt irgendein Betrunkener herum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617602
    m_Localized: 'Doctor: Es ist selten, dass ein bewohntes Haus nachts so still ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617601
    m_Localized: 'Doctor: Was? Haha, nein, natürlich nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617600
    m_Localized: Suchen Sie etwas Bestimmtes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423454
    m_Localized: Haben Sie das Haus beobachtet?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423453
    m_Localized: 'Doctor: Guten Abend! Darf ich reinkommen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423452
    m_Localized: 'Doctor: Hier ist es so still.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423451
    m_Localized: 'Doctor: Oh, ich dachte, es wäre niemand zu Hause.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423450
    m_Localized: 'Wolfhound: Du wirst noch von mir hören.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423449
    m_Localized: 'Wolfhound: Aaah ... Ich verstehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423448
    m_Localized: 'Wolfhound: Stärke ist jetzt das Maß aller Dinge. Entweder spielst du mit, oder du hast Pech gehabt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423447
    m_Localized: 'Wolfhound: Kluge Entscheidung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423446
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423445
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423444
    m_Localized: 'Wolfhound: Die Sache ist: Ich bin nicht hier, um Ärger zu machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423443
    m_Localized: 'Wolfhound: Ich frage nicht nach, wie du leben willst, also frag mich auch nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423442
    m_Localized: 'Wolfhound: Was man nicht weiß, kann einen nicht verletzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423441
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423440
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423439
    m_Localized: 'Wolfhound: Und du? Bei dir herrscht immer noch Ordnung. Das ist selten. Ich bin neugierig, wie du das schaffst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423438
    m_Localized: 'Wolfhound: Aber ich habe überall dasselbe Chaos gesehen. Die Angst macht die Menschen blind für die Realität.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423437
    m_Localized: 'Wolfhound: Ich bin nie lange geblieben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423436
    m_Localized: Wie hast du so lange überlebt?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423435
    m_Localized: Wie viele Orte hast du durchquert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423434
    m_Localized: 'Wolfhound: Wer das anders sieht, ist bis zum nächsten Morgen tot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423433
    m_Localized: 'Wolfhound: Das ist die neue Ordnung: Der Stärkere schafft an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423432
    m_Localized: 'Wolfhound: Leugne es ruhig, dann fressen sie dich bei lebendigem Leib. Nicht mal Knochen lassen sie übrig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423431
    m_Localized: 'Wolfhound: Wir sind alle Tiere.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423430
    m_Localized: Wie hast du so lange überlebt?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423429
    m_Localized: Wie viele Orte hast du durchquert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423428
    m_Localized: 'Wolfhound: Jetzt ist es ganz einfach. Wenn du jemandem die Kehle aufschlitzen kannst, gewinnst du.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423427
    m_Localized: 'Wolfhound: All deine Regeln und Moralvorstellungen sind Geschichte. Sie funktionieren nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423426
    m_Localized: 'Wolfhound: Warst du mal in anderen Häusern? Auf den Straßen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423425
    m_Localized: Bist du eine dieser Bestien?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423424
    m_Localized: Wovon redest du?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423423
    m_Localized: 'Wolfhound: Endlich ... Kein Theater mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423422
    m_Localized: 'Wolfhound: Das ist keine Gesellschaft mehr. Die Bestien haben übernommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423421
    m_Localized: 'Wolfhound: Die Welt ist vor die Hunde gegangen, was?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423420
    m_Localized: 'Wolfhound: Hey.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423419
    m_Localized: 'SuperFake: Warum also wehren Sie sich?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423418
    m_Localized: 'SuperFake: Ich WEISS, dass alles bald entschieden ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423417
    m_Localized: 'SuperFake: Woran hängen Sie so sehr?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423416
    m_Localized: 'SuperFake: Warum?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423415
    m_Localized: 'SuperFake: Wegrennen, immer nur wegrennen. Vor meinen Leuten, vor der Wahrheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423414
    m_Localized: 'SuperFake: Deshalb bin ich hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423413
    m_Localized: 'SuperFake: Sie können die Dinge immer noch nicht selbst in die Hand nehmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423412
    m_Localized: 'SuperFake: Jaaaa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423411
    m_Localized: 'SuperFake: Haben Sie Angst?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423410
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423409
    m_Localized: 'SuperFake: Sie sind also bereit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423408
    m_Localized: Ich habe ein paar rausgeworfen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423407
    m_Localized: Ich habe alle Überzähligen rausgeworfen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423406
    m_Localized: Ich lasse nur die richtigen Leute rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423405
    m_Localized: Es sind viele hier, die keine Menschen sind
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423404
    m_Localized: Ich habe niemanden reingelassen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423403
    m_Localized: Es sind viele Leute hier
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423402
    m_Localized: 'SuperFake: Sind welche von meinen Leuten in Ihrem Haus?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423401
    m_Localized: 'SuperFake: Aber mich interessiert etwas anderes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423400
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423399
    m_Localized: 'SuperFake: Werden Sie irgendwas spüren?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423398
    m_Localized: 'SuperFake: Einfach nur ... weg? Für immer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423397
    m_Localized: 'SuperFake: Sie sterben. Und dann?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423396
    m_Localized: 'SuperFake: Sie scheinen mehr darüber nachzudenken, was danach kommt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423395
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423394
    m_Localized: 'SuperFake: Fragen Sie sich oft, warum Sie noch leben?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423393
    m_Localized: 'SuperFake: Haben Sie Angst vor dem Unbekannten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423392
    m_Localized: Ich habe ein paar rausgeworfen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423391
    m_Localized: Ich habe alle Überzähligen rausgeworfen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423390
    m_Localized: Ich lasse nur die richtigen Leute rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423389
    m_Localized: Es sind viele hier, die keine Menschen sind
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423388
    m_Localized: Ich habe niemanden reingelassen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423387
    m_Localized: Es sind viele Leute hier
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423386
    m_Localized: 'SuperFake: Sind Sie allein zu Hause?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423385
    m_Localized: 'SuperFake: Lassen Sie meine Leute rein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423384
    m_Localized: 'SuperFake: Vorerst allerdings ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423383
    m_Localized: 'SuperFake: Aber Sie werden verschwinden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423382
    m_Localized: 'SuperFake: Wenn nicht heute, dann morgen. Wenn nicht morgen, dann später.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423381
    m_Localized: 'SuperFake: Sie werden sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423380
    m_Localized: 'SuperFake: Aber das Ergebnis ist dasselbe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423379
    m_Localized: 'SuperFake: Um etwas zu ändern?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423378
    m_Localized: 'SuperFake: Sie haben einen Grund, mich zu Ihnen zu schicken ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423377
    m_Localized: 'SuperFake: Haben Sie schon mal daran gedacht, auserwählt zu sein? Hahaha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423376
    m_Localized: 'SuperFake: Das fragen Sie erst jetzt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423375
    m_Localized: Warum treten Sie nicht die Tür ein?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423374
    m_Localized: Warum kommen Sie her?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423373
    m_Localized: 'SuperFake: Keine Sorge, wir werden helfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423372
    m_Localized: 'SuperFake: Komisch, dass *Sie* überhaupt nichts spüren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423371
    m_Localized: 'SuperFake: Das kann ich nicht sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423370
    m_Localized: Warum treten Sie nicht die Tür ein?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423369
    m_Localized: Warum kommen Sie her?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423368
    m_Localized: 'SuperFake: Sie haben schon seinen Atem im Nacken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423367
    m_Localized: 'SuperFake: Aber spüren Sie ihn? Den Tod, der immer näher kommt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423366
    m_Localized: 'SuperFake: Das ist alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423365
    m_Localized: 'SuperFake: Ich sage Ihnen nur, was mir erzählt wurde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423364
    m_Localized: Was für ein Ende?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423363
    m_Localized: Was meinen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423362
    m_Localized: 'SuperFake: Wenn nicht mit unserer Hilfe, dann bringen Sie es selbst zu Ende.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423361
    m_Localized: 'SuperFake: Diese ganze Sache nähert sich dem Ende.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423360
    m_Localized: 'SuperFake: Mir wurde gesagt, dass das unser letztes Gespräch sein würde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423359
    m_Localized: 'SuperFake: Bis zum nächsten Mal?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423358
    m_Localized: 'SuperFake: Also dann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423357
    m_Localized: 'SuperFake: Ich führe nur Befehle aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423356
    m_Localized: 'SuperFake: Es gibt höhere Mächte als mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423355
    m_Localized: 'SuperFake: Sie glauben nicht, dass ich hier das Sagen habe, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423354
    m_Localized: 'SuperFake: Veränderung ist nicht das Schlimmste, was Sie erwartet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423353
    m_Localized: 'SuperFake: Sogar meine Leute sind inzwischen selten. Geschweige denn Leute wie Sie, die sich in ihren Häusern verschanzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423352
    m_Localized: 'SuperFake: Gut, gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423351
    m_Localized: 'SuperFake: Kommen Sie mit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423350
    m_Localized: 'SuperFake: Na also. Die Regel hat funktioniert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423349
    m_Localized: 'SuperFake: Hmm ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423348
    m_Localized: Ich bin nicht allein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423347
    m_Localized: Ich bin allein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423346
    m_Localized: 'SuperFake: Sind Sie allein zu Hause?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423345
    m_Localized: 'SuperFake: Aber vorher müssen wir noch unsere neue Regel testen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423344
    m_Localized: 'SuperFake: Natürlich! Ich gehe schon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423343
    m_Localized: Ich bin nicht allein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423342
    m_Localized: Ich bin allein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423341
    m_Localized: 'SuperFake: Sind Sie allein zu Hause?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423340
    m_Localized: 'SuperFake: Aber zuerst ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423339
    m_Localized: 'SuperFake: Probieren wir es aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423338
    m_Localized: 'SuperFake: Ganz einfach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423337
    m_Localized: Können Sie später wiederkommen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423336
    m_Localized: Ich verstehe nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423335
    m_Localized: 'SuperFake: Dann machen Sie mir die Tür auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423334
    m_Localized: 'SuperFake: Wenn mindestens zwei von meinen Leuten in Ihrem Haus sind ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423333
    m_Localized: 'SuperFake: Bringen wir das in Ordnung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423332
    m_Localized: 'SuperFake: Als ob Sie sich selbst völlig egal sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423331
    m_Localized: 'SuperFake: Sie sind ziemlich distanziert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423330
    m_Localized: Können Sie später wiederkommen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423329
    m_Localized: Ich verstehe nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423328
    m_Localized: 'SuperFake: Denn die Leichen gehören jetzt den Hunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423327
    m_Localized: 'SuperFake: Dann machen Sie mir die Tür auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423326
    m_Localized: 'SuperFake: Wenn mindestens zwei von meinen Leuten in Ihrem Haus sind ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423325
    m_Localized: 'SuperFake: Probieren wir neue Regeln aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423324
    m_Localized: 'SuperFake: Klingt, als bräuchten Sie Hilfe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423323
    m_Localized: 'SuperFake: Das muss schwer für Sie sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423322
    m_Localized: Ist mir egal
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423321
    m_Localized: Ich spüre es nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423320
    m_Localized: 'SuperFake: Um Sie herum passieren seltsame Dinge.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423319
    m_Localized: 'SuperFake: Sie wissen, wen ich meine, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423318
    m_Localized: 'SuperFake: Alles nur wegen einem Wort. Einem einzigen Wort. Aber was für einem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423317
    m_Localized: 'SuperFake: Und eine gewisse Person ... Für sie wurde das Sterben beendet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423316
    m_Localized: 'SuperFake: So wie ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423315
    m_Localized: 'SuperFake: Die Veränderung verfolgt Sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423314
    m_Localized: 'SuperFake: Spüren Sie das?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423313
    m_Localized: 'SuperFake: Unser nächstes Treffen wird ... interessanter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423312
    m_Localized: 'SuperFake: Sie geraten aus dem Rhythmus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423311
    m_Localized: 'SuperFake: Das Leben hat sich verändert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423310
    m_Localized: 'SuperFake: Sie verstehen doch, oder? Es wird nie mehr so, wie es mal war.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423309
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423308
    m_Localized: 'SuperFake: Die Welt gehört jetzt den Hunden. Nur sie bleiben übrig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423307
    m_Localized: 'SuperFake: Warum?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423306
    m_Localized: 'SuperFake: Ich versuche immer noch, Ihr Leben auf die Reihe zu kriegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423305
    m_Localized: 'SuperFake: Ich öffne einfach die Tür und lass Ihnen eine Kleinigkeit da.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423304
    m_Localized: 'SuperFake: Hat wohl mit niemandem geklappt, was?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423303
    m_Localized: 'SuperFake: Sie sind also allein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423302
    m_Localized: Ich bin nicht allein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423301
    m_Localized: Ich bin allein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423300
    m_Localized: 'SuperFake: Sind Sie allein zu Hause?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423299
    m_Localized: 'SuperFake: Hören Sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423298
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423297
    m_Localized: 'SuperFake: Sie können höchstens einen Herzschlag stoppen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423296
    m_Localized: 'SuperFake: Überflutungen, Brände und Verwesung stoppen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229051
    m_Localized: 'SuperFake: Können Sie den Tod aufhalten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229050
    m_Localized: 'SuperFake: Und was können Sie ausrichten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229049
    m_Localized: Ich bin nicht allein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229048
    m_Localized: Ich bin allein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229047
    m_Localized: 'SuperFake: Sind Sie allein zu Hause?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229046
    m_Localized: 'SuperFake: Hören Sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229045
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229044
    m_Localized: 'SuperFake: Gegen den Tod?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229043
    m_Localized: 'SuperFake: Gegen eine kosmische Katastrophe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229042
    m_Localized: 'SuperFake: Aber was soll man gegen Naturkatastrophen machen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229041
    m_Localized: 'SuperFake: Das kenne ich gut!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229040
    m_Localized: Ich tue, was ich kann
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229039
    m_Localized: Ich kann nichts tun
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229038
    m_Localized: 'SuperFake: Oder wollen Sie alles selbst in Ordnung bringen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229037
    m_Localized: 'SuperFake: Ein Segen, finden Sie nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229036
    m_Localized: 'SuperFake: Es ist schon alles für uns entschieden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229035
    m_Localized: 'SuperFake: Machen Sie sich keine Gedanken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229034
    m_Localized: Ich tue, was ich kann
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229033
    m_Localized: Ich kann nichts tun
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229032
    m_Localized: 'SuperFake: Oder vielleicht müssen wir die Dinge selbst in die Hand nehmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229031
    m_Localized: 'SuperFake: Vielleicht sorgen die ja für Ordnung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229030
    m_Localized: 'SuperFake: Eins nach dem anderen, nicht wahr?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229029
    m_Localized: 'SuperFake: Die Zeiten sind hart.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229028
    m_Localized: Ich weiß nicht, was ich von ihm halten soll
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229027
    m_Localized: Er macht seine Arbeit
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229026
    m_Localized: 'SuperFake: Was halten Sie von dem da? Im Anzug?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229025
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229024
    m_Localized: 'SuperFake: Sie verschanzen sich immer noch in diesem Haus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229023
    m_Localized: 'Greatmother: Ich bringe meine Leute her. Wir helfen dir zu überleben, hahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229022
    m_Localized: 'Greatmother: HAHAHAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229021
    m_Localized: 'Greatmother: Am besten machst du sie überhaupt nicht mehr auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229020
    m_Localized: 'Greatmother: Mach bloß nicht den gelben Anzügen die Tür auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229019
    m_Localized: 'Greatmother: Bevor du gucken kannst, schleppen sie uns beide irgendwohin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229018
    m_Localized: 'Greatmother: Hehe, danke. Mach den gelben Anzügen ja nicht die Tür auf, ja?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229017
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229016
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229015
    m_Localized: 'Greatmother: Jetzt geht’s also nur noch ums Überleben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229014
    m_Localized: 'Greatmother: Ungefähr die Hälfte haben sie mitgenommen. Die anderen haben sie gar nicht interessiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229013
    m_Localized: 'Greatmother: Manche wollten nicht von allein gehen und die Anzüge haben sie rausgezogen, völlig willkürlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229012
    m_Localized: 'Greatmother: Ich sag’s dir, es war das ganze verdammte Gebäude!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229011
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229010
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229009
    m_Localized: 'Greatmother: Andere haben sie gehen lassen, als wär nichts gewesen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229008
    m_Localized: 'Greatmother: Gelbe Anzüge sind reingerannt und haben alle rausgeschmissen. Manche haben sie zur Untersuchung mitgenommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229007
    m_Localized: 'Greatmother: Angeblich hat unser Gebäude einen Sonnenschock erlitten oder so was.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229006
    m_Localized: Waren viele von euch betroffen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229005
    m_Localized: Warum haben sie euch rausgeworfen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229004
    m_Localized: 'Greatmother: Seitdem renne ich rum und suche eine Bleibe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229003
    m_Localized: 'Greatmother: Der ganze verdammte Block wurde geräumt und niemand wusste, wohin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229002
    m_Localized: 'Greatmother: Ich suche niemanden. Ich brauch nur eine Bleibe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229001
    m_Localized: Waren viele von euch betroffen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229000
    m_Localized: Warum haben sie euch rausgeworfen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228999
    m_Localized: 'Greatmother: Die Leute haben sich in alle Richtungen verstreut. Ich bin hergekommen, um zu überleben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228998
    m_Localized: 'Greatmother: Kein Schutz, keine Hilfe. Wo sollten wir denn hin? Was sollten wir denn machen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228997
    m_Localized: 'Greatmother: Diese Typen in gelben Anzügen haben uns aus dem Gebäude geworfen und uns selbst überlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228996
    m_Localized: 'Greatmother: Ich habe früher ein paar Blocks weiter gewohnt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228995
    m_Localized: Suchst du jemanden?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228994
    m_Localized: Wer bist du?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228993
    m_Localized: 'Greatmother: Ist jemand zu Hause?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228992
    m_Localized: 'Greatmother: Hallöööchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034796
    m_Localized: 'Cold: Schon klar. Sie brauchen die Kugeln selbst. Tschüss.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034795
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034794
    m_Localized: 'Cold: Könnten Sie mich erschießen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034793
    m_Localized: 'Cold: Sie haben viele Schießpulverspuren an den Händen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034792
    m_Localized: 'Cold: Auf Wiedersehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034791
    m_Localized: 'Cold: Ich verstehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034790
    m_Localized: 'Cold: Die Decke ist ein bisschen niedrig. Aber das macht nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034789
    m_Localized: 'Cold: Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034788
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034787
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034786
    m_Localized: 'Cold: Ich gehe. Ich werde nicht betteln oder nerven.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034785
    m_Localized: 'Cold: Sie müssen mich nicht reinlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034784
    m_Localized: 'Cold: Nein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034783
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034782
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034781
    m_Localized: 'Cold: Was, wenn es schlimmer wird. Und ich immer noch nicht daran sterben kann?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034780
    m_Localized: 'Cold: Ich habe Angst, mich auszuziehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034779
    m_Localized: 'Cold: Andere gehen in der Sonne ein. Ich packe mich dick ein und mir ist immer noch kalt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034778
    m_Localized: 'Cold: Mir ist immer kalt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034777
    m_Localized: Ziehen Sie die Jacke aus
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034776
    m_Localized: Die Hitze macht Ihnen nichts aus?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034775
    m_Localized: 'Cold: Schon lange.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034774
    m_Localized: 'Cold: Das hatte ich noch nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034773
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034772
    m_Localized: Ziehen Sie die Jacke aus
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034771
    m_Localized: Die Hitze macht Ihnen nichts aus?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034770
    m_Localized: 'Cold: Später. Ich bin mir noch nicht sicher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034769
    m_Localized: 'Cold: Bin ich nicht. Aber ich habe eine Bitte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034768
    m_Localized: 'Cold: Das spielt keine Rolle mehr. Fragen Sie sich, ob ich ein Besucher bin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034767
    m_Localized: Wie lange sind Sie schon auf der Suche?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034766
    m_Localized: Wer sind Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034765
    m_Localized: 'Cold: Kann ich hier Frieden finden?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034764
    m_Localized: 'Cold: Die Hitze macht mir nichts aus. Aber ich suche trotzdem nach einem ruhigen Ort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034763
    m_Localized: 'Cold: Hallo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034762
    m_Localized: 'Hunter: Aber ich schwöre, dass ich denen das Leben zur Hölle mache. Sie werden schon sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034761
    m_Localized: 'Hunter: Bis zum Morgengrauen hätten Sie mir die Kehle aufgeschlitzt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034760
    m_Localized: 'Hunter: Gut so. Vielleicht sind Sie ja selbst einer von denen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034759
    m_Localized: 'Hunter: Wir löschen sie alle aus. Keiner wird uns auf die Pelle rücken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034758
    m_Localized: 'Hunter: Ich wusste, dass Sie kein Weichei sind. Sie haben Rückgrat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034757
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034756
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034755
    m_Localized: 'Hunter: Nichts an ihnen ist menschlich, bis auf ihre Haut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034754
    m_Localized: 'Hunter: Ich bin gerannt. Und sie haben geschossen. Das ist ihre Vorstellung von Spaß.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034753
    m_Localized: 'Hunter: Sie haben gewartet, bis ich im Zelt eingeschlafen bin. Dann haben sie es einfach genommen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034752
    m_Localized: 'Hunter: Ich hatte ein Gewehr. Das wär mir fast zum Verhängnis geworden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034751
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034750
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034749
    m_Localized: 'Hunter: Bei denen muss man vorsichtig sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034748
    m_Localized: 'Hunter: Man lässt einen laufen und am nächsten Tag schlitzt er einem die Kehle auf. Verstehen Sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034747
    m_Localized: 'Hunter: Oder wollen Sie sie nur verscheuchen? Sie wirken auf mich nicht wie ein Idiot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034746
    m_Localized: 'Hunter: Tun Sie nicht dasselbe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034745
    m_Localized: Und wo ist Ihre Waffe?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034744
    m_Localized: Sie wollen die Besucher jagen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034743
    m_Localized: 'Hunter: Ich sag’s Ihnen, die führen was im Schilde. Und sie müssen ausgerottet werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034742
    m_Localized: 'Hunter: Seit dieser verdammten Sache mit der Sonne kriechen immer mehr von ihnen hervor und schleichen rum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034741
    m_Localized: 'Hunter: Wo, in der Stadt? Ich bin nur hergekommen, um mich auszuruhen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034740
    m_Localized: Und wo ist Ihre Waffe?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034739
    m_Localized: Sie wollen die Besucher jagen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034738
    m_Localized: 'Hunter: Sie gehören ausgerottet. Jeder Einzelne von ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034737
    m_Localized: 'Hunter: Sie geben sich als unsere Mitmenschen aus ... und dann bricht die Hölle los.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034736
    m_Localized: 'Hunter: In jedem Haus gibt es irgendwelche Toten oder Verstümmelten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034735
    m_Localized: 'Hunter: Haben Sie gesehen, was die Besucher anrichten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034734
    m_Localized: Wonach suchen Sie hier?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034733
    m_Localized: Warum sind Sie unterwegs?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034732
    m_Localized: 'Hunter: Aber ich kann nicht mehr herumwandern wie früher. Das Alter macht sich langsam bemerkbar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034731
    m_Localized: 'Hunter: Ich bin nicht von hier. Ich bin niemand, der lange an einem Ort bleibt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034730
    m_Localized: 'Hunter: Hallo. Wie stehen die Dinge in dieser Gegend?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034729
    m_Localized: 'Prophet: Auf Wiedersehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034728
    m_Localized: 'Prophet: Tut mir leid. Ich glaube, ich gehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034727
    m_Localized: 'Prophet: Ich habe nicht die Kraft, um weiterzulesen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034726
    m_Localized: 'Prophet: „Unsere Jugend schrie wie Rouen in Flammen.“'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034725
    m_Localized: 'Prophet: Auf Wiedersehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034724
    m_Localized: 'Prophet: Danke. Aber es hat nicht geholfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034723
    m_Localized: 'Prophet: Was für ein Jammer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034722
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034721
    m_Localized: 'Prophet: „Jemand singt zwischen zwei Welten. Feuer, komm mit mir.“'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034720
    m_Localized: 'Prophet: Ich gehe jetzt. Auf Wiedersehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034719
    m_Localized: 'Prophet: Ich habe mich an etwas erinnert. Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034718
    m_Localized: 'Prophet: Ah. Das ist es also.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034717
    m_Localized: 'Prophet: „Unser Zug fährt nirgendwo mehr hin. Aber unter ihm brüllen die Schienen weiter.“'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034716
    m_Localized: Seite Zehn?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034715
    m_Localized: Die Mitte von Seite Zweihundert.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034714
    m_Localized: Irgendwo am Ende.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034713
    m_Localized: 'Prophet: Ich habe Angst. Vielleicht können Sie mir helfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034712
    m_Localized: 'Prophet: Wissen Sie noch, als Sie meine Zukunft aus dem Buch vorhergesagt haben? Wollen Sie es noch mal machen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034711
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034710
    m_Localized: 'Prophet: Ist es eine Botschaft für Sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034709
    m_Localized: 'Prophet: Und ich erinnere mich an das Wort „Spring“. Hat das etwas zu bedeuten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034708
    m_Localized: 'Prophet: Aber früher war das anders. Das weiß ich noch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034707
    m_Localized: 'Prophet: Seltsame Frage. Ich verstehe gar nichts mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034706
    m_Localized: Seite Zehn?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034705
    m_Localized: Die Mitte von Seite Zweihundert.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034704
    m_Localized: Irgendwo am Ende.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034703
    m_Localized: 'Prophet: Vielleicht hilft es ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034702
    m_Localized: 'Prophet: Können Sie mir noch einmal die Zukunft voraussagen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034701
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034700
    m_Localized: 'Prophet: Ich weiß selbst nicht mehr weiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034699
    m_Localized: 'Prophet: Ich weiß nicht, ob es eine Botschaft für mich ... oder für Sie ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034698
    m_Localized: 'Prophet: Nur ein Gedanke wiederholt sich: „Spring.“'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034697
    m_Localized: 'Prophet: Ich ... Ich weiß es nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034696
    m_Localized: Sterben Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034695
    m_Localized: Von wem sprechen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034694
    m_Localized: 'Prophet: Warum hast du dann überhaupt damit angefangen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034693
    m_Localized: 'Prophet: Und jetzt? Nimmt sie sich einfach alles zurück?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034692
    m_Localized: 'Prophet: Sie hat mir Kraft gegeben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034691
    m_Localized: Sterben Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034690
    m_Localized: Von wem sprechen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034689
    m_Localized: 'Prophet: Spielen Sie keine Spielchen mit mir. Lassen Sie mich einfach in Ruhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034688
    m_Localized: 'Prophet: Ich erkenne jetzt ... dass es längst überfällig ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840573
    m_Localized: 'Prophet: Die Gedanken ... sind verstummt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840572
    m_Localized: 'Prophet: Für diesen Wunsch ist es zu spät.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840571
    m_Localized: Sie sehen ... schlimm aus
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840570
    m_Localized: Sterben Sie nur nicht auf der Veranda
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840569
    m_Localized: 'Prophet: Hat sie mich verlassen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840568
    m_Localized: 'Prophet: Meine Sicht schwindet. Ich kann kaum noch irgendetwas erkennen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840567
    m_Localized: 'Prophet: Ich habe Ihr Gesicht vergessen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840566
    m_Localized: 'Prophet: Ich möchte mit meinen Gedanken allein sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840565
    m_Localized: 'Prophet: Wenn Sie finden, was dort unten ist ... springen Sie nicht. Das wird Ihnen jetzt nicht weiterhelfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840564
    m_Localized: 'Prophet: Und Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840563
    m_Localized: 'Prophet: Es musste getan werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840562
    m_Localized: 'Prophet: Ich ... Ich erinnere mich ... Es war richtig so.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840561
    m_Localized: 'Prophet: Ich sollte mich ausruhen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840560
    m_Localized: 'Prophet: Wenn Sie es finden ... springen Sie nicht. Noch nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840559
    m_Localized: 'Prophet: Aber ... an eines erinnere ich mich noch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840558
    m_Localized: 'Prophet: Entschuldigen Sie. Ich kann nicht klar denken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840557
    m_Localized: Sind Sie sicher?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840556
    m_Localized: Warum sollte ich es brauchen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840555
    m_Localized: 'Prophet: Sie sind dazu bestimmt, es zu finden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840554
    m_Localized: 'Prophet: Sie müssen graben. Irgendetwas liegt dort vergraben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840553
    m_Localized: 'Prophet: Mir ist eingefallen, was als Nächstes kommt. Der Keller.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840552
    m_Localized: 'Prophet: Jetzt ... ist alles verschwommen. Ich sehe Sie, verirrt in einem dunklen Wald. Umgeben von wilden Tieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840551
    m_Localized: 'Prophet: Aber ich wusste, dass es einen Grund gibt. Ich habe mich deutlich erinnert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840550
    m_Localized: 'Prophet: Tut mir leid. Ich weiß, dass das sonderbar klingt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840549
    m_Localized: Sind Sie sicher?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840548
    m_Localized: Warum sollte ich es brauchen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840547
    m_Localized: 'Prophet: Ich kann nicht sehen, was dort unter der Erde liegt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840546
    m_Localized: 'Prophet: Versuchen Sie, darunter zu graben. Irgendetwas ist dort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840545
    m_Localized: 'Prophet: Der Keller. Sie haben doch einen, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840544
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840543
    m_Localized: 'Prophet: Bevor ich zu Ihnen kam, fühlte sich alles so klar an. Jetzt ... liegt alles im Nebel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840542
    m_Localized: 'Prophet: Ja. Entschuldigen Sie, falls ich Ihnen Angst gemacht habe. Ich habe nur laut nachgedacht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840541
    m_Localized: Langsam bereue ich, dass ich Ihnen vertraut habe
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840540
    m_Localized: Ich verstehe kein Wort
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840539
    m_Localized: 'Prophet: Aber jetzt ... ist etwas schiefgelaufen. Vielleicht war es dieser Mann mit den Pilzen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840538
    m_Localized: 'Prophet: Wenn man die richtigen Worte findet, kommt sie einem zu Hilfe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840537
    m_Localized: 'Prophet: Aber fürchten Sie sich nicht davor. Wir wissen einfach nicht genug.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840536
    m_Localized: 'Prophet: Wissen Sie, es gibt eine Entität, die stärker ist als wir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840535
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840534
    m_Localized: 'Prophet: Nein, keinesfalls.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840533
    m_Localized: Langsam bereue ich, dass ich Ihnen vertraut habe
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840532
    m_Localized: Ich verstehe kein Wort
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840531
    m_Localized: 'Prophet: Neue Halme werden durch die Asche brechen und sich nach dem Himmel strecken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840530
    m_Localized: 'Prophet: Das ist ganz am Anfang schon einmal passiert. Es wird alles wieder gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840529
    m_Localized: 'Prophet: Wahrscheinlich liegt es nicht an ihnen. Oder an ihr ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840528
    m_Localized: 'Prophet: Ich fühle mich schwächer. Meine Sicht reicht nicht mehr so weit wie vorher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840527
    m_Localized: 'Prophet: Mir wird bereits geholfen. Aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840526
    m_Localized: Führen Sie Selbstgespräche?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840525
    m_Localized: Hey. Brauchen Sie Hilfe?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840524
    m_Localized: 'Prophet: Liegt es an der Zerstörung?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840523
    m_Localized: 'Prophet: Ich fühle mich schlechter. Merkwürdig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840522
    m_Localized: 'Prophet: Sie sind da, nicht wahr? An der Tür?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840521
    m_Localized: 'Prophet: Ich hoffe, wir sehen uns in ein paar Tagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840520
    m_Localized: 'Prophet: Dieses Gefühl ist jetzt schwächer. Ich glaube, wir sind auf dem richtigen Weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840519
    m_Localized: 'Prophet: Bei meiner Ankunft hier hatte ich ein ... merkwürdiges Gefühl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840518
    m_Localized: 'Prophet: Es wäre am besten, wenn Sie niemanden testen würden. Zwei Tage lang.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840517
    m_Localized: 'Prophet: Sie können es als Bitte verstehen, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840516
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840515
    m_Localized: 'Prophet: Mehr kann ich nicht sagen. Ich habe schon zu viel gesagt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840514
    m_Localized: 'Prophet: Ich hoffe, wir sehen uns in ein paar Tagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840513
    m_Localized: 'Prophet: Vielleicht wird es Ihnen Frieden bringen. Oder Ihnen zumindest helfen, durchzuhalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840512
    m_Localized: 'Prophet: Wenn Sie zustimmen, werde ich Ihnen weiterhin Führung geben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840511
    m_Localized: 'Prophet: Überhaupt niemanden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840510
    m_Localized: 'Prophet: Aber ... Sie sollten zwei Tage lang niemanden testen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840509
    m_Localized: 'Prophet: Nichts. Ich habe schon zu viel gesagt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840508
    m_Localized: Was wird passieren?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840507
    m_Localized: Und was soll ich damit anfangen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840506
    m_Localized: 'Prophet: Ich frage mich, ob sie es im Radio erwähnen werden. Werden Sie zuhören?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840505
    m_Localized: 'Prophet: Sie werden es nicht aufhalten können.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840504
    m_Localized: 'Prophet: Aber ich sehe deutlich, dass etwas Schlimmes naht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840503
    m_Localized: 'Prophet: Dank dieser Entität kann ich mehr sehen als andere. Aber selbst ich sehe nicht alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840502
    m_Localized: 'Prophet: Es wird Sie ... einer mächtigen Entität näherbringen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840501
    m_Localized: Was wird passieren?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840500
    m_Localized: Und ... was soll ich damit anfangen?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267328
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840499
    m_Localized: 'Prophet: Ich frage mich, ob sie es im Radio erwähnen werden. Werden Sie zuhören?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840498
    m_Localized: 'Prophet: Sie sind nicht der Auslöser, aber es wird Sie trotzdem betreffen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840497
    m_Localized: 'Prophet: Und ich weiß, dass etwas Schreckliches bevorsteht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840496
    m_Localized: 'Prophet: Ich weiß nicht alles. Aber was Sie angeht ... Ich weiß, was passiert, wenn Sie dem Weg folgen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840495
    m_Localized: 'Prophet: Ich sehe mehr als die meisten anderen. Das ist meine Gabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840494
    m_Localized: Warum haben Sie gesagt, ich soll jemanden mit einer Katze reinlassen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840493
    m_Localized: Woher wissen Sie von der Katze?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840492
    m_Localized: 'Prophet: Was Sie mit der Person machen, die sie mitgebracht hat, ist Ihre Entscheidung.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267337
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840491
    m_Localized: 'Prophet: Perfekt. Die Katze ist bei Ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840490
    m_Localized: 'Gasmask: Und wir verschwinden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840489
    m_Localized: 'Gasmask: Wir NEHMEN JETZT ZWEI LEUTE MIT.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840488
    m_Localized: 'Gasmask: Sie können hierbleiben und sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840487
    m_Localized: 'Gasmask: Wir nehmen alle mit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840486
    m_Localized: 'Gasmask: Wir treten die Tür ein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840485
    m_Localized: 'Gasmask: Als würde man gegen eine Wand reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840484
    m_Localized: 'Gasmask: Also, passen Sie auf sich auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840483
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840482
    m_Localized: 'Gasmask: Dito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840481
    m_Localized: Ich gebe Ihnen niemanden mehr
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840480
    m_Localized: Hoffentlich nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840479
    m_Localized: 'Gasmask: Sie werden es auch bereuen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267351
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840478
    m_Localized: 'Gasmask: Sie sind nicht der Erste, der Widerstand leistet. Die anderen haben es bereut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840477
    m_Localized: 'Gasmask: Entweder Sie geben uns jetzt zwei Leute oder wir verschaffen uns Zutritt und räumen die ganze verdammte Hütte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840476
    m_Localized: 'Gasmask: Ich diskutiere nicht mit Ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840475
    m_Localized: 'Gasmask: Ich weiß nicht, was ich noch sagen soll.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840474
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840473
    m_Localized: Ich gebe Ihnen niemanden mehr
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840472
    m_Localized: Hoffentlich nicht
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840471
    m_Localized: 'Gasmask: Und dann finden wir entweder eine Möglichkeit, die Besucher zu bekämpfen, oder wir sehen uns nie wieder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840470
    m_Localized: 'Gasmask: Wir nehmen nicht alle mit. Nur zwei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840469
    m_Localized: 'Gasmask: Noch zwei Leute.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840468
    m_Localized: Wozu seid ihr überhaupt gut, wenn nichts funktioniert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840467
    m_Localized: Was muss getan werden, um das in Ordnung zu bringen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840466
    m_Localized: 'Gasmask: Wenn wir keine Möglichkeit finden, wie wir überleben, entscheidet jemand anders für uns.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840465
    m_Localized: 'Gasmask: Die Anweisungen, die sie uns geben, sind unmöglich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840464
    m_Localized: 'Gasmask: Die Behörden sind bereit, die ganze Stadt hochzujagen. Sie bringen es nicht unter Kontrolle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840463
    m_Localized: 'Gasmask: Es ist eine verdammte Katastrophe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840462
    m_Localized: Wozu seid ihr überhaupt gut, wenn nichts funktioniert?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267369
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840461
    m_Localized: Was muss getan werden, um das in Ordnung zu bringen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840460
    m_Localized: 'Gasmask: Wenn Sie hier Spielchen spielen, nehmen wir alle in diesem Haus mit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840459
    m_Localized: 'Gasmask: DIE WELT STEHT AM ABGRUND.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840458
    m_Localized: 'Gasmask: SCHLUSS MIT DEM UNSINN.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840457
    m_Localized: Was für eine Katastrophe?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840456
    m_Localized: Wo sind meine Leute, verdammt noch mal?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840455
    m_Localized: 'Gasmask: Ansonsten gibt es eine Katastrophe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840454
    m_Localized: 'Gasmask: Wir brauchen mehr Leute.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840453
    m_Localized: 'Gasmask: Sie bekommen Sie bald wieder zurück. Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840452
    m_Localized: 'Gasmask: Geben Sie uns einfach die Leute.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840451
    m_Localized: 'Gasmask: Uns liegt diese Stadt am Herzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840450
    m_Localized: 'Gasmask: Wenn Sie sich weigern, gibt es weitere Explosionen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840449
    m_Localized: 'Gasmask: Das passiert, wenn sture Arschlöcher unsere Arbeit behindern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840448
    m_Localized: 'Gasmask: Gefällt Ihnen der Anblick hinter mir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840447
    m_Localized: 'Gasmask: Na gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840446
    m_Localized: 'Gasmask: ... Verdammte Scheiße.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840445
    m_Localized: 'Gasmask: Und wir kümmern uns um die Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840444
    m_Localized: 'Gasmask: Wir nehmen zwei mit, aber wir bringen sie wieder zurück.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840443
    m_Localized: 'Gasmask: Danke für Ihr Verständnis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840442
    m_Localized: 'Gasmask: Ja, es hilft.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840441
    m_Localized: Nein, mir reicht’s
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840440
    m_Localized: Na schön, wenn es hilft ...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840439
    m_Localized: 'Gasmask: Die Lage wird sich bald stabilisieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840438
    m_Localized: 'Gasmask: Egal wen. Geben Sie uns einfach irgendwelche. Und zwar sofort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840437
    m_Localized: 'Gasmask: Aber diesmal nehmen wir zwei mit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840436
    m_Localized: 'Gasmask: Ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840435
    m_Localized: Nein, mir reicht’s
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840434
    m_Localized: Na schön, wenn es hilft ...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840433
    m_Localized: 'Gasmask: Das wird die Sache beschleunigen. Es ist nur zu Ihrem Besten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840432
    m_Localized: 'Gasmask: Zwei, um genau zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840431
    m_Localized: 'Gasmask: Wir brauchen Leute.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840430
    m_Localized: Muss ich Ihnen wieder jemanden aushändigen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840429
    m_Localized: Und was jetzt?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840428
    m_Localized: 'Gasmask: Wir haben alles im Griff.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840427
    m_Localized: 'Gasmask: Lassen Sie uns einfach unsere Arbeit machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840426
    m_Localized: 'Gasmask: Wenn es so einfach wäre, bräuchte man keine FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840425
    m_Localized: Muss ich Ihnen wieder jemanden aushändigen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840424
    m_Localized: Und was jetzt?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840423
    m_Localized: 'Gasmask: Kooperieren Sie einfach, dann ist es vielleicht schneller vorbei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840422
    m_Localized: 'Gasmask: Schwer zu sagen. Wir brauchen mehr Leute, um alles unter Kontrolle zu halten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840421
    m_Localized: 'Gasmask: Unsere Untersuchungen laufen noch. Mischen Sie sich nicht ein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840420
    m_Localized: Wann lösen Sie das Problem mit den Besuchern?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840419
    m_Localized: Wie lange geht das noch so weiter?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840418
    m_Localized: 'Gasmask: Und das ... war einmal mein Zuhause.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840417
    m_Localized: 'Gasmask: Und Sie sehen ja, wo das hinführt. Wir mussten einen Besucher-Hotspot räumen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840416
    m_Localized: 'Gasmask: Das steht Ihnen nicht zu. Jeder versucht, unsere Arbeit zu behindern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840415
    m_Localized: 'Gasmask: Stellen Sie keine Forderungen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840414
    m_Localized: Wann lösen Sie das Problem mit den Besuchern?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840413
    m_Localized: Wie lange geht das noch so weiter?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840412
    m_Localized: 'Gasmask: Und das führt zu noch mehr Gewalt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840411
    m_Localized: 'Gasmask: Wenn man Besucher versteckt, werden es nur noch mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840410
    m_Localized: 'Gasmask: Wenn Sie sich weigern, gibt es weitere Explosionen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840409
    m_Localized: 'Gasmask: Konsequenzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840408
    m_Localized: Bringen Sie erst die anderen zurück!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840407
    m_Localized: Was ist in der Stadt los?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840406
    m_Localized: 'Gasmask: Je früher, desto besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840405
    m_Localized: 'Gasmask: Wir brauchen mehr Leute von Ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840404
    m_Localized: 'Gasmask: Hallo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840403
    m_Localized: 'Gasmask: Alles wird ablaufen wie vorgesehen. Je schneller Sie kooperieren, desto schneller ist es vorbei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840402
    m_Localized: 'Gasmask: Sie haben keine Wahl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840401
    m_Localized: 'Gasmask: Sie verstehen nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840400
    m_Localized: 'Gasmask: Sobald die Tests abgeschlossen sind, sagen wir Ihnen, wie es weitergeht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840399
    m_Localized: 'Gasmask: Keine Sorge. Die Prozedur ist anstrengend, aber wir geben den Leuten Zeit zum Ausruhen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840398
    m_Localized: Ich habe kein Interesse an diesen Tests
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840397
    m_Localized: Na gut, wenn’s sein muss
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840396
    m_Localized: 'Gasmask: Um die Auswirkungen der Sonne besser zu verstehen, brauchen wir noch jemanden aus Ihrem Haushalt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840395
    m_Localized: 'Gasmask: Die Ergebnisse sind noch nicht aussagekräftig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840394
    m_Localized: Ich habe kein Interesse an diesen Tests
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840393
    m_Localized: Na gut, wenn’s sein muss
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840392
    m_Localized: 'Gasmask: Danach wird er aus der Quarantänezone zurückgeschickt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840391
    m_Localized: 'Gasmask: Nach den Tests muss eine Quarantäne erfolgen. Der Betroffene bleibt für eine Weile bei uns.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840390
    m_Localized: 'Gasmask: Ah. Unser Team war also schon hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840389
    m_Localized: 'Gasmask: Zurückbringen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840388
    m_Localized: Was ist mit der letzten Kontrolle?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840387
    m_Localized: Wann bringen Sie einen von uns zurück?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840386
    m_Localized: 'Gasmask: Keine Sorge, es wird nicht lange dauern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840385
    m_Localized: 'Gasmask: Wir sind von der FEMA. Routinekontrolle in Ihrer Nachbarschaft.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840384
    m_Localized: 'Gasmask: Guten Abend.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646208
    m_Localized: 'Luka: Pass auf dich auf, ja?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646207
    m_Localized: 'Luka: Und dann kann es ziemlich schnell stockfinster werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646206
    m_Localized: 'Luka: Wenn du dich zu sehr darauf konzentrierst, frisst sie dich bei lebendigem Leib auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646205
    m_Localized: 'Luka: Vergrabe dich nicht in deiner Trauer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646204
    m_Localized: 'Luka: Vielleicht kannst du dann auch über andere Dinge nachdenken als nur über den Tod.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646203
    m_Localized: 'Luka: Ich hoffe, du erinnerst dich noch, wie es war, Freude zu empfinden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646202
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646201
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646200
    m_Localized: 'Luka: Verstehst du, was ich meine? Das Leben ist in letzter Zeit bitter geworden. Zu bitter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646199
    m_Localized: 'Luka: Als ihr Ziel nicht das Überleben war, sondern etwas ... Gutes zu tun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646198
    m_Localized: 'Luka: Aber wenn man sie ab und zu daran erinnert, dass sie früher mal glücklich waren ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646197
    m_Localized: 'Luka: Warum lügen? Die Leute sind in ihrem eigenen Leid gefangen, das verstehe ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646196
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646195
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646194
    m_Localized: 'Luka: Gerade jetzt dürfen wir uns nicht von der Dunkelheit verschlucken lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646193
    m_Localized: 'Luka: Versuch dich zu erinnern, was dir Freude gemacht hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646192
    m_Localized: 'Luka: Was hast du vor dieser ganzen Sache geliebt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646191
    m_Localized: 'Luka: Es gibt mehr als genug Gründe. Aber ich kann dir nicht vorschreiben, worüber du dich freuen sollst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646190
    m_Localized: Bist du bereit, andere anzulügen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646189
    m_Localized: Worüber soll man sich denn freuen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646188
    m_Localized: 'Luka: Die Verzweiflung macht uns blind für die wenigen guten Dinge, die uns noch bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646187
    m_Localized: 'Luka: Vor lauter Angst haben die Leute vergessen, wie sich Freude anfühlt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646186
    m_Localized: 'Luka: Ja ... Ich habe auch lange niemanden lächeln gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646185
    m_Localized: 'Luka: Oh, du meinst das Lächeln?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039743
    m_Localized: 'Nervous: Ich wohne im „Hope Hotel“, aber ich wollte einen kleinen Spaziergang machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039742
    m_Localized: 'Nervous: Entschuldigung, ich bin etwas ... nervös.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039741
    m_Localized: 'Nervous: Hallo. Hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039740
    m_Localized: 'Bald: Pass auf dich auf, ja? Ich hoffe, du überstehst diese ganze Scheiße.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039739
    m_Localized: 'Bald: Ich versteh schon. Nichts für ungut.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039738
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039737
    m_Localized: 'Bald: Komm später zu mir, ja? Ich hab ein paar wilde Geschichten auf Lager. Die werden dich umhauen, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039736
    m_Localized: 'Bald: Du bist mein Lebensretter.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039735
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039734
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039733
    m_Localized: 'Bald: Ich will dir nicht zur Last fallen. Ich erzähl dir alles, aber ... lass mich einfach nur rein, mein Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039732
    m_Localized: 'Bald: Sie wollte mich nur beschützen und hat mir nie was erzählt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039731
    m_Localized: 'Bald: Aber hinter meiner Mutter.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039730
    m_Localized: 'Bald: Nein, hinter mir sind sie nicht her.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039729
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039728
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039727
    m_Localized: 'Bald: Und diese verdammte Sonne macht alles immer schlimmer.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039726
    m_Localized: 'Bald: Aber jetzt ... Na ja, ich kann keinen von ihnen erreichen. Jeder hat seine eigenen Probleme.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039725
    m_Localized: 'Bald: Das waren gute Jungs, immer bereit zu helfen, ein Bier auszugeben oder einfach nur abzuhängen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039724
    m_Localized: 'Bald: Alles Theaterleute. Wir haben zusammen gesoffen, Scheiße gebaut und aufeinander aufgepasst.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039723
    m_Localized: Ein Haufen wütender Leute ist hinter dir her?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039722
    m_Localized: Was sind das für Freunde?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039721
    m_Localized: 'Bald: Ich hab bei meiner Mutter und meiner Oma gewohnt, aber wir sind rausgeflogen. Schuldeneintreiber. Was für ein Schlamassel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039720
    m_Localized: 'Bald: Ich dachte, ich hätte jede Menge Freunde und wir würden das zusammen durchstehen ... aber Pustekuchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039719
    m_Localized: 'Bald: Stört’s dich, wenn ich hier für eine Weile unterkomme? Alle anderen sind entweder nicht zu Hause, wurden rausgeworfen oder sonst was.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039718
    m_Localized: 'Bald: Hallo, mein Freund!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039717
    m_Localized: 'Tough: ... Arschloch.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039716
    m_Localized: 'Tough: Was für ein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039715
    m_Localized: 'Tough: Hm, ich habe nichts anderes erwartet.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039714
    m_Localized: 'Tough: Nein?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039713
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303878
    m_Localized: Ich bin nicht allein
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303877
    m_Localized: Ich bin allein
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303876
    m_Localized: 'SuperFake: Bist du allein zu Hause?'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303875
    m_Localized: 'SuperFake: Na gut ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303874
    m_Localized: 'SuperFake: Und was bleibt dir noch, das wichtig wäre? Du bist jetzt ganz allein. Keine Familie.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303873
    m_Localized: 'SuperFake: Warum so angespannt? Klammerst dich so ans Leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303872
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371408
    m_Localized: 'Vigilante: Genieße das, was noch übrig ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371407
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371406
    m_Localized: 'Vigilante: Du wirst mich nicht wiedersehen. Ich habe getan, wozu ich gekommen bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371405
    m_Localized: 'Vigilante: Ich bin hier fertig.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371404
    m_Localized: 'Vigilante: Ohren? Was zur Hölle meinst du mit Ohren?! Das ist kein Anzeichen für Besucher!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371403
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371402
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371401
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371400
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371399
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371398
    m_Localized: 'Vigilante: Ohren? Was zur Hölle meinst du mit Ohren?! Das ist kein Anzeichen für Besucher!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371397
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371396
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371395
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371392
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177095
    m_Localized: 'CultistPriest: Leben Sie wohl.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177094
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177093
    m_Localized: 'CultistPriest: Nun gut. Es ist Ihre Entscheidung. Der Tod wird früher oder später seinen Tribut fordern.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177092
    m_Localized: Ich sehne mich schon lange nach Frieden ... Ich komme mit Ihnen
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177091
    m_Localized: Wenn Sie so wild darauf sind zu sterben, dann nur zu. Ich bleibe hier
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177090
    m_Localized: 'CultistPriest: Finden Sie Frieden mit unserem Ritual. Was sagen Sie dazu? Begleiten Sie uns auf dem heiligen Marsch in den Tod?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177089
    m_Localized: 'CultistPriest: Als Zeichen meiner Dankbarkeit könnte ich Ihnen Erlösung anbieten ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633033
    m_Localized: 'BigLebowski: Cool!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633032
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633031
    m_Localized: Ich werfe die Person raus, komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633030
    m_Localized: 'BigLebowski: Hey, das reimt sich. Cool.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633029
    m_Localized: 'BigLebowski: Ich bleibe nur auf meine eigene Tour.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633028
    m_Localized: 'BigLebowski: Ach, egal. Den besten Platz hat sowieso schon {0} belegt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633027
    m_Localized: 'BigLebowski: Verdammt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633026
    m_Localized: 'BigLebowski: Genau wie mein Vater.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200674
    m_Localized: 'FatalDame: Nun ... Er sieht das anders.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200673
    m_Localized: 'FatalDame: Glaubst du, es wird einfacher, wenn das Ende kommt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200672
    m_Localized: 'FatalDame: Ich habe keine andere Antwort erwartet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200671
    m_Localized: 'FatalDame: Vielleicht finden wir eine Ablenkung, die besser ist als Paranoia und endloses Selbstmitleid.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200670
    m_Localized: 'FatalDame: Versuchen wir, diesem ganzen Horror zu entfliehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200669
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200668
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200667
    m_Localized: 'FatalDame: Vielleicht können wir versuchen ... eine besondere Bindung zueinander aufzubauen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200666
    m_Localized: 'FatalDame: Ich könnte dir dabei helfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200665
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200664
    m_Localized: 'FatalDame: Es ist schwer, eine Bindung zu anderen Leuten aufzubauen. Du bist nicht der Einzige, der damit Probleme hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200663
    m_Localized: 'FatalDame: Das verstehe ich. Nur wenige Leute können zuhören, ohne gleich so was zu sagen wie: „Aber ich hatte es noch schlimmer ...“'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200662
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200661
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200660
    m_Localized: 'FatalDame: Wir alle brauchen Trost in diesen Zeiten. Ein bisschen Zuwendung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200659
    m_Localized: 'FatalDame: Wenn du mich reinlässt, können wir uns vielleicht gemeinsam unserem Schmerz stellen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200656
    m_Localized: 'FatalDame: Es ist schwer, seine Wut loszulassen. Verzeihen ist noch schwerer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200655
    m_Localized: 'FatalDame: Gewalt in der Kindheit? Wie furchtbar. Gut, dass du das hinter dir hast.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200654
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200653
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200652
    m_Localized: 'FatalDame: Lass mich rein, wenn du mal was Besonderes spüren willst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200651
    m_Localized: 'FatalDame: Aber selbst die einsamste Seele braucht ... besondere Zuwendung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200650
    m_Localized: 'FatalDame: In letzter Zeit sind alle vom Weltuntergang besessen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200649
    m_Localized: 'FatalDame: Ich kann dir etwas anbieten, was die meisten nicht tun würden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200648
    m_Localized: 'FatalDame: Hm ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200576
    m_Localized: Willst du sie finden?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200575
    m_Localized: Wie läuft’s bei dir?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200574
    m_Localized: 'Vigilante: Wenn mein Bruder nicht so feige gewesen wäre, hätte er seine Frau und sein Kind vielleicht schützen können. Jetzt weiß niemand, wo die kleine Göre ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200573
    m_Localized: 'Vigilante: Ich bin wieder da. Ich weiß gar nicht, warum ich mir die Mühe gemacht hab.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200572
    m_Localized: 'Vigilante: Dafür hab ich keine Zeit. Ich muss mich um wichtigere Dinge kümmern. Bis zum nächsten Mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200571
    m_Localized: 'Vigilante: Wenn du noch mal diesen Ohrenquatsch versuchst, leg ich dich auf der Stelle um.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200570
    m_Localized: 'Vigilante: Wenn mein Bruder nicht wäre ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200569
    m_Localized: 'Vigilante: Ohren? Hältst du mich für einen verdammten Idioten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200568
    m_Localized: 'Vigilante: Ernsthaft? Dein verdammtes Foto interessiert mich nicht. Ich hab Wichtigeres zu tun. Fürs Erste bleibst du am Leben, später gibt es einen richtigen Test.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200567
    m_Localized: 'Vigilante: Hmpf ... Sieht sauber aus. Aber ich hab schon zu viele „Saubere“ begraben, um überzeugt zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200566
    m_Localized: 'Vigilante: Ein Foto? Wegen der Aura, was? Mal sehen, wie „sauber“ du bist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200565
    m_Localized: 'Vigilante: Unverdächtig. Du Glückspilz. Und jetzt nimm deine Achselhöhlen aus meinem Gesicht, ich hab wichtigere Probleme. Bis zum nächsten Mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200564
    m_Localized: 'Vigilante: Sieht in Ordnung aus. Aber das hat nichts zu sagen. Diese Missgeburten können sich so gut tarnen, dass ich es nicht erkennen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200563
    m_Localized: 'Vigilante: Hmpf ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200562
    m_Localized: 'Vigilante: Nicht jetzt. Ich muss mich um wichtigere Dinge kümmern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200561
    m_Localized: 'Vigilante: Fürs Erste bist du fein raus. Aber wenn ich das nächste Mal was Verdächtiges sehe, schieße ich sofort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200560
    m_Localized: 'Vigilante: Ist dir klar, was einer von diesen „Normalos“ in einer einzigen Nacht anrichten kann? Ein Fehler und alle sind tot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200559
    m_Localized: 'Vigilante: Hehe ... Nichts Ungewöhnliches, was? Toll. Einfach großartig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200558
    m_Localized: 'Vigilante: Na los, mach deine verdammten Hände auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200557
    m_Localized: 'Vigilante: Ich hab jetzt keine Zeit für deine Hände. Nächstes Mal nehme ich dich gründlich unter die Lupe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200556
    m_Localized: 'Vigilante: Hier ist ein kleiner Tipp: Diejenigen, die normal aussehen, sind immer die ersten, die sich verändern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200555
    m_Localized: 'Vigilante: Sauber ... Ja, natürlich sind sie sauber, verdammt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200554
    m_Localized: 'Vigilante: Scheiße, ich hab keine Zeit dafür. Ich muss was überprüfen. Bis später.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200553
    m_Localized: 'Vigilante: Na gut. Ich lasse dich am Leben. Aber wenn ich das nächste Mal was Verdächtiges sehe, wird nicht lange gefackelt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200552
    m_Localized: 'Vigilante: Hmpf ... Sauber. Schade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200551
    m_Localized: 'Vigilante: Weiter aufmachen. Na los, mach dir nicht in die Hose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200550
    m_Localized: (Ohren zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200549
    m_Localized: (Foto zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200548
    m_Localized: (Achselhöhlen zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200547
    m_Localized: (Augen zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200546
    m_Localized: (Hände zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200545
    m_Localized: (Zähne zeigen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200544
    m_Localized: 'Vigilante: Du hast eine Waffe? Ist mir scheißegal. Dann knallen wir uns eben gegenseitig ab.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200543
    m_Localized: 'Vigilante: Zeig mir ein Merkmal. Irgendeins.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200542
    m_Localized: 'Vigilante: Mmm ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200541
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200540
    m_Localized: Nur das Mädchen hat überlebt. Der Mann ist tot
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200539
    m_Localized: Sein Haus ist abgebrannt. Seitdem habe ich ihn nicht gesehen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006381
    m_Localized: 'Miner: Ich erzähle Ihnen mehr, sobald Sie hier sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006380
    m_Localized: 'Miner: Wir haben es versucht, und fast wäre uns der ganze Bumms hier auf den Kopf gefallen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006379
    m_Localized: 'Miner: Hören Sie, falls Sie mit dem Gedanken spielen, hier runterzukommen ... Halten Sie sich von diesem Loch fern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006378
    m_Localized: 'Miner: Einer der Jungs hat was darüber gehört – er meinte, es könnte sich lohnen, genauer nachzusehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006377
    m_Localized: 'Miner: Nur eine Grube, aber in der Nähe davon gehen seltsame Dinge vor sich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006376
    m_Localized: 'Miner: Nö, nichts allzu Interessantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006375
    m_Localized: 'Miner: Was?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006374
    m_Localized: 'Miner: Wir haben es versucht, und fast wäre uns der ganze Bumms hier auf den Kopf gefallen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006373
    m_Localized: 'Miner: Hören Sie, falls Sie mit dem Gedanken spielen, hier runterzukommen ... Halten Sie sich von diesem Loch fern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006372
    m_Localized: 'Miner: Einer von unseren Jungs ist reingegangen. Ich bin oben geblieben, für den Fall, dass er Hilfe braucht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006371
    m_Localized: 'Miner: Tiere werden still. Kompasse spielen verrückt. Taschenlampen dringen nicht durch die Dunkelheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006370
    m_Localized: 'Miner: Und in der Nähe geht irgendwas vor sich. Ein ruhiges Brummen, das nie aufhört.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006369
    m_Localized: 'Miner: Da ist ein Loch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006368
    m_Localized: Haben Sie einen Besucher gefunden?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006367
    m_Localized: Haben Sie was Interessantes gefunden?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006366
    m_Localized: 'Miner: Aber die Tunnel sind nicht das Verrückteste. Es gibt noch was anderes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006365
    m_Localized: 'Miner: Wir haben aber noch keine gesehen, also sind wir uns nicht sicher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006364
    m_Localized: 'Miner: Wir glauben, dass die Besucher sich darin fortbewegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006363
    m_Localized: 'Miner: Keine Ahnung, wer es gegraben hat, oder warum. Wir haben natürlich unsere Theorien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006362
    m_Localized: 'Miner: Wir fangen an zu graben, und was finden wir? Ein ganzes TUNNELSYSTEM!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006361
    m_Localized: 'Miner: Schutz, verdammt noch mal! Vor der gottverdammten Hitze!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006360
    m_Localized: Haben Sie einen Besucher gefunden?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006359
    m_Localized: Haben Sie was Interessantes gefunden?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006358
    m_Localized: 'Miner: Aber vergessen Sie das, wir haben nämlich was anderes gefunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006357
    m_Localized: 'Miner: Diese Tunnel führen tief in die Erde, Kumpel. Richtig tief. Keine Ahnung, wo sie enden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006356
    m_Localized: 'Miner: Früher gab es noch mehr Tunnel, ein paar sind vor Kurzem eingestürzt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006355
    m_Localized: 'Miner: Wir haben gerade erst angefangen – und schon haben wir ein ganzes unterirdisches Tunnelsystem gefunden!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006354
    m_Localized: 'Miner: Ich und die Jungs dachten, wir graben ein paar Tunnel, um uns vor der Hitze zu verstecken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006353
    m_Localized: Wonach suchen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006352
    m_Localized: Warum sind Sie dort?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006351
    m_Localized: 'Miner: Meine Ohren sind so voller Staub, dass ich Sie wie durch ein Kopfkissen höre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006350
    m_Localized: 'Miner: Feststecken? Nö. Wir haben was gefunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006349
    m_Localized: 'Miner: Was?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006348
    m_Localized: Wonach suchen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006347
    m_Localized: Warum sind Sie dort?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006346
    m_Localized: 'Miner: Dann hoffen wir mal, dass es uns nicht auf den Kopf fällt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006345
    m_Localized: 'Miner: Wir sind unter Ihrem Haus?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006344
    m_Localized: 'Miner: Ich bin mit Staub und Ruß bedeckt und verstehe kein Wort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006343
    m_Localized: 'Miner: Was? Sprechen Sie lauter!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006342
    m_Localized: Stecken Sie da unten fest?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006341
    m_Localized: Was machen Sie unter meinem Haus?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006340
    m_Localized: 'Miner: ... Dachte ich zumindest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006339
    m_Localized: 'Miner: Was? Wer ist da? Da war doch gerade ein Geräusch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006308
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006307
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006306
    m_Localized: 'MushroomEater: Bist du bereit, mit mir ins Land der Pilze aufzubrechen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006305
    m_Localized: 'MushroomEater: Wir müssen das Festival um jeden Preis verhindern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006304
    m_Localized: 'MushroomEater: Und um die Wahrheit zu sagen ... ist es auch besser so. Aber wir haben keine Wahl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006303
    m_Localized: 'MushroomEater: Ein unheimlicher Ort, den noch nie jemand betreten hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006302
    m_Localized: Das klingt nicht besonders furchterregend
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006301
    m_Localized: Land der Pilze?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006300
    m_Localized: 'MushroomEater: Ich wollte es eigentlich vermeiden, aber ... ich glaube, wir müssen ins Land der Pilze gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006299
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006298
    m_Localized: 'MushroomEater: Das heißt, das Myzel ist in großen Schwierigkeiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006297
    m_Localized: 'MushroomEater: Das Festival bedeutet, dass das Wachstum der Pilze außer Kontrolle gerät.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006296
    m_Localized: Das klingt nicht besonders furchterregend
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006295
    m_Localized: Land der Pilze?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006294
    m_Localized: 'MushroomEater: Ich wollte es eigentlich vermeiden, aber ... ich glaube, wir müssen ins Land der Pilze gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006293
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006292
    m_Localized: 'MushroomEater: Aber in letzter Zeit hat sich so viel Bösartigkeit angesammelt, dass das Wachstum der Pilze keine Grenzen kennt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006291
    m_Localized: 'MushroomEater: Die Pilze sind wie eine Leber, die versucht, dieses ganze Gift abzubauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006290
    m_Localized: 'MushroomEater: Wenn sich zu viel Bösartigkeit in seinen Fäden ansammelt, verstopft sie alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006289
    m_Localized: 'MushroomEater: Irgendetwas stimmt mit dem Myzel nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006288
    m_Localized: Warum findet das Festival statt?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006287
    m_Localized: Warum hat es nicht funktioniert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006286
    m_Localized: 'MushroomEater: Im Myzel herrscht ein derartiges Durcheinander ... Das Ritual hat nicht funktioniert ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006285
    m_Localized: 'MushroomEater: Es sieht aus, als würde das Festival trotz allem stattfinden ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006284
    m_Localized: 'MushroomEater: Das ist kein endgültiger Abschied, mein lieber Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006283
    m_Localized: 'MushroomEater: Und vergiss nicht: Pilze sind nicht immer das, was sie zu sein scheinen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006282
    m_Localized: 'MushroomEater: Wir sorgen dafür, dass die Pilze klein bleiben und das Festival nicht beginnen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006281
    m_Localized: 'MushroomEater: Ich komme wieder, wenn die Zeit gekommen ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006280
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646184
    m_Localized: 'Luka: Was stimmt damit nicht? Scheint mir ganz normal zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646183
    m_Localized: Bist du bereit, andere anzulügen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646182
    m_Localized: Worüber soll man sich denn freuen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646181
    m_Localized: 'Luka: Wenn wir uns sagen, dass alles gut wird, ist es vielleicht ein bisschen einfacher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646180
    m_Localized: 'Luka: Die nächste Generation. Kunst. Das Leben selbst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646179
    m_Localized: 'Luka: Ja, die Zeiten sind hart. Aber es gibt noch so vieles, für das es sich zu kämpfen lohnt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646178
    m_Localized: 'Luka: Es gibt schon genug Ärger auf der Welt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646177
    m_Localized: Was ist mit deinem Gesicht?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646176
    m_Localized: Warum hast du so gute Laune?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646175
    m_Localized: 'Luka: Kann ich hier übernachten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646174
    m_Localized: 'Luka: Du bist schon an der Tür? Ich habe Schritte gehört.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646173
    m_Localized: 'BigLebowski: Fühlt sich nicht gerade sicher an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646172
    m_Localized: 'BigLebowski: Von dir gehen sowieso keine guten Vibes aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646171
    m_Localized: 'BigLebowski: Na gut. Dann scheiß auf dich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646170
    m_Localized: 'BigLebowski: Obwohl ... Ach, egal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646169
    m_Localized: 'BigLebowski: Oh, du hast sogar einen Teppich. Cool.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646168
    m_Localized: 'BigLebowski: Im Ernst? Boah ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646167
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646166
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633025
    m_Localized: 'BigLebowski: Willst du wirklich ein Kind draußen lassen? Unter der brennenden Sonne? Mit den Besuchern?'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633024
    m_Localized: 'BigLebowski: Ich könnte ein Dach über dem Kopf gebrauchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646165
    m_Localized: 'BigLebowski: Meine Mutter liegt auch gerne in der Sonne. Also ja ... Das wäre auch eine interessante Möglichkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646164
    m_Localized: 'BigLebowski: Oder vielleicht sind sie jetzt Besucher. Würde irgendwie zu ihnen passen. Ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646163
    m_Localized: 'BigLebowski: Keine Ahnung. Zu Hause wahrscheinlich. Wo sollten sie sonst sein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646162
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646161
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646160
    m_Localized: 'BigLebowski: Falls du auch zu denen gehörst, pass bloß auf! Wenn du irgendwas probierst, hau ich dir eine rein!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646159
    m_Localized: 'BigLebowski: Aber manchmal begegnet man dabei richtigen Arschlöchern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646158
    m_Localized: 'BigLebowski: Aber ich bin pleite. Also muss ich entweder mit anderen ins Geschäft kommen oder mich in freie Keller schleichen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646157
    m_Localized: 'BigLebowski: Das Leben zwingt mich dazu. Ich bin ... auf einer Reise. Ich will die Welt sehen. Und vielleicht irgendwo ein neues Zuhause finden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646156
    m_Localized: Wo sind deine Eltern?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646155
    m_Localized: Warum versteckst du dich in Kellern?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646152
    m_Localized: 'BigLebowski: Ich bin todmüde, aber ich hab keinen Keller und auch kein anderes gutes Versteck gefunden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646151
    m_Localized: 'BigLebowski: Ich weiß, das klingt komisch, aber ... kannst du mich reinlassen, damit ich den nächsten Tag überstehe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646150
    m_Localized: Wo sind deine Eltern?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646149
    m_Localized: Warum versteckst du dich in Kellern?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646146
    m_Localized: 'BigLebowski: Ich hab’s satt, mich in Kellern zu verstecken. Ich weiß kaum noch, wie man mit anderen Leuten redet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646145
    m_Localized: 'BigLebowski: Nein, ich ... muss nur irgendwo unterkommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646144
    m_Localized: Ja, es gehört mir
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646143
    m_Localized: Suchst du jemanden?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646142
    m_Localized: 'BigLebowski: Wohnst du hier? Ich meine ... ist das dein Haus?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646141
    m_Localized: 'BigLebowski: Hallo. Oder, äh ... Hi, falls dir das lieber ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646140
    m_Localized: 'Couple: Na los, setz dich in Bewegung. Ich bin auch müde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646139
    m_Localized: 'Couple: Wir suchen weiter, nicht wahr, mein Sonnenschein?'
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582080
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582081
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776384
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776385
    m_Localized: (Lieferung annehmen)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646136
    m_Localized: 'Couple: Warum stehst du da noch rum? Na los, wir sind eingeladen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646135
    m_Localized: 'Couple: Oh, danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646138
    m_Localized: 'Couple: Verstehe. Entschuldigen Sie die Störung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646137
    m_Localized: 'Couple: Nicht so schüchtern. Gleich kannst du dich ausruhen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646134
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646133
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646132
    m_Localized: 'Couple: Oh, tut mir leid. Das geht mich nichts an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646131
    m_Localized: 'Couple: Danke wegen meiner Frau. Ohne sie hätte ich das alles nicht durchgestanden. Und wie halten Sie sich über Wasser?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646130
    m_Localized: 'Couple: Es kommt einfach alles zusammen ... Das sind harte Zeiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646129
    m_Localized: 'Couple: Ich meine, Sie verstehen das doch, oder? Die Besucher, die Hitze, die Kündigung ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646128
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646127
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646126
    m_Localized: 'Couple: Ach, entschuldige. Ich sollte dich nicht so unter Druck setzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646125
    m_Localized: 'Couple: Nicht wahr, Liebling?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646124
    m_Localized: 'Couple: Aber vielleicht können wir ein andermal reden. Falls wir uns jemals wieder sehen, versteht sich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646123
    m_Localized: 'Couple: Sie ist einfach nur müde. Tut mir leid.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646122
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646121
    m_Localized: 'Couple: Natürlich! Liebling, sag doch was!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646120
    m_Localized: Wovon müssen Sie sich überhaupt ausruhen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646119
    m_Localized: Kann Ihre Frau auch sprechen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646118
    m_Localized: 'Couple: Nur, falls es Ihnen nichts ausmacht, meine ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646117
    m_Localized: 'Couple: Meine Frau ist erschöpft. Sie braucht einfach nur ein bisschen Ruhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646116
    m_Localized: 'Couple: Tja ... Ich schätze, wir suchen woanders weiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646115
    m_Localized: Wovon müssen Sie sich überhaupt ausruhen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646114
    m_Localized: Kann Ihre Frau auch sprechen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646113
    m_Localized: 'Couple: Großes Haus, ein bisschen abgelegen, keine neugierigen Nachbarn ... Geringeres Risiko, dass irgendein Durchgeknallter auftaucht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646112
    m_Localized: 'Couple: Ich weiß nicht, wie ich es erklären soll, haha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646111
    m_Localized: 'Couple: Ganz ehrlich: Ihr Haus sieht sicherer aus als jedes andere, das wir gesehen haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646110
    m_Localized: Und wenn Sie mir Ärger machen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646109
    m_Localized: Sieht mein Haus für Sie nach einem sicheren Ort aus?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646108
    m_Localized: 'Couple: Würde es Ihnen etwas ausmachen, wenn wir eine Weile hierbleiben? Natürlich nur, wenn es keine Umstände macht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646107
    m_Localized: 'Couple: Oh, hallo! Meine Frau und ich suchen nach einem sicheren Ort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646106
    m_Localized: 'Couple: ... Schon besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646105
    m_Localized: 'Ballerina: Kleines Geschenk. Von mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646104
    m_Localized: 'Ballerina: Die Katze finden Sie unter dem Haus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646103
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646102
    m_Localized: 'Ballerina: Komm schon, Kätzchen. Du willst mich jetzt auf Trab halten, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646101
    m_Localized: 'Ballerina: Fühl dich wie zu Hause.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646100
    m_Localized: Fahren Sie zur Hölle
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646099
    m_Localized: ... Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646098
    m_Localized: 'Ballerina: Denken Sie noch mal nach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646097
    m_Localized: 'Ballerina: Sehen Sie die Katze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646096
    m_Localized: 'Ballerina: Und quälen Sie nicht die Katze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646095
    m_Localized: 'Ballerina: Da draußen erfriert bald eine Dame, junger Mann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646094
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646093
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646092
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646091
    m_Localized: 'Ballerina: Machen Sie auf oder nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646090
    m_Localized: 'Ballerina: Habe ich den Test bestanden?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646089
    m_Localized: 'Ballerina: Reicht das nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646088
    m_Localized: 'Ballerina: Ich habe zwei Arme, zwei Beine und einen Kopf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646087
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646086
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646085
    m_Localized: 'Ballerina: Na? Entscheiden Sie sich. Was machen wir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646084
    m_Localized: 'Ballerina: Ich bin Ballett-erina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646083
    m_Localized: 'Ballerina: Vielleicht mache ich das.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646082
    m_Localized: 'Ballerina: Wollen Sie mich tanzen sehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646081
    m_Localized: 'Ballerina: Na und?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646080
    m_Localized: Beweisen Sie, dass Sie ein Mensch sind
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451995
    m_Localized: Ich glaube nicht, dass Sie ein Mensch sind
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451994
    m_Localized: 'Ballerina: Das klingt komisch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451993
    m_Localized: 'Ballerina: Und jetzt? Haben Sie sich an ihn erinnert? Oder was?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451992
    m_Localized: 'Ballerina: In Ordnung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451991
    m_Localized: Beweisen Sie, dass Sie ein Mensch sind
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451990
    m_Localized: Ich glaube nicht, dass Sie ein Mensch sind
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451989
    m_Localized: 'Ballerina: Hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451988
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451987
    m_Localized: 'Ballerina: Keine Ahnung. Warum ist das wichtig?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451986
    m_Localized: Sie erinnern mich an ... jemanden.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451985
    m_Localized: Hat Sie jemand hergeschickt?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451984
    m_Localized: 'Ballerina: Hier ist es nicht heiß.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451983
    m_Localized: 'Ballerina: Ich habe Ihr Haus gesehen und bin gekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451982
    m_Localized: 'Ballerina: Sehen Sie die Stadt? Da habe ich gewohnt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451981
    m_Localized: Sie erinnern mich an ... jemanden.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451980
    m_Localized: Hat Sie jemand hergeschickt?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451979
    m_Localized: 'Ballerina: Ich habe Ballett gemacht. Sieht man mir das an?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451978
    m_Localized: 'Ballerina: Ich tanze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451977
    m_Localized: Wie haben Sie mein Haus gefunden?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451976
    m_Localized: Wer sind Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451975
    m_Localized: 'Ballerina: Er hat gesagt, ich soll herkommen, also bin ich gekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451974
    m_Localized: 'Ballerina: Machen Sie auf, ja oder nein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451973
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451972
    m_Localized: 'Ballerina: Einen Kasten Bier. Eine Schublade. Eine Schinkenkeule. Keine Ahnung. Geben Sie mir, was Sie wollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451971
    m_Localized: Wie haben Sie mein Haus gefunden?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451970
    m_Localized: Wer sind Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451969
    m_Localized: 'Ballerina: Inwiefern hilft Ihnen das?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451968
    m_Localized: 'Ballerina: Zu viele Fragen. Ja, ich kenne ihn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451967
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451966
    m_Localized: Was wollen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451965
    m_Localized: Kennen Sie ... den bleichen Mann?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451964
    m_Localized: 'Ballerina: Machen Sie auf oder nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451963
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451962
    m_Localized: 'Ballerina: Hallo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451961
    m_Localized: 'Teacher: Falls Sie jemals Kindern begegnen sollten ... kümmern Sie sich bitte um sie. Leben Sie wohl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451960
    m_Localized: 'Teacher: Ich mache Ihnen keinen Vorwurf. Aber bitte ... versprechen Sie mir etwas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451959
    m_Localized: 'Teacher: Ich weiß, dass ich sie nicht zurückbringen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451958
    m_Localized: 'Teacher: Danke ... fürs Zuhören. Und fürs Reinlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451957
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451956
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451955
    m_Localized: 'Teacher: Sie haben alles niedergebrannt. Und ließen mich dabei zusehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451954
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451953
    m_Localized: 'Teacher: Womit haben sie das verdient?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451952
    m_Localized: 'Teacher: Was ist nur aus uns geworden? Ein Mob, der über hilflose Kinder urteilt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451951
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451950
    m_Localized: 'Teacher: Sie fanden heraus, dass ich Kinder aufgenommen hatte, die Merkmale von Besuchern hatten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451949
    m_Localized: 'Teacher: Es ist alles die Schuld ... dieser Leute.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451948
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451947
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451946
    m_Localized: 'Teacher: Ich spüre immer noch, wie ihre kleinen, verängstigten Augen mich ansehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451945
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451944
    m_Localized: 'Teacher: Ich musste zusehen ... als sie die Türen verschlossen, die Fenster vernagelten ... und das Gebäude in Brand steckten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451943
    m_Localized: 'Teacher: Die Leute sind schuld. Sie hatten Angst, dass die Kinder Besucher sein könnten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451942
    m_Localized: 'Teacher: Sie sind alle ... in den Flammen umgekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451941
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451940
    m_Localized: 'Teacher: Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451939
    m_Localized: Wie kam es zu dem Feuer?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451938
    m_Localized: Was ist mit den Kindern passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451937
    m_Localized: 'Teacher: Aber jetzt ... sind sie alle weg. Nicht ein einziges Kind hat das Feuer überlebt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451936
    m_Localized: 'Teacher: Manche verließen ihre eigenen Kinder in dem Moment, als sie ein Merkmal von Besuchern an ihnen fanden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451935
    m_Localized: 'Teacher: Manche wurde von der FEMA abgeholt. Manche wurden umgebracht. Manche ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451934
    m_Localized: 'Teacher: Sie hatten aus verschiedensten Gründen ihre Eltern verloren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451933
    m_Localized: 'Teacher: Ich ... Als die Welt auseinanderzufallen begann, nahm ich diejenigen auf, die zurückgelassen wurden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451932
    m_Localized: 'Teacher: Ich war Erzieherin ... im Kindergarten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451931
    m_Localized: Wie kam es zu dem Feuer?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451930
    m_Localized: Was ist mit den Kindern passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451929
    m_Localized: 'Teacher: Aber ... ich konnte sie nicht retten. Ich habe versagt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451928
    m_Localized: 'Teacher: Sie brauchten einfach jemanden, der sich um sie kümmert. Jemanden, der sie liebt. Ich habe mein Bestes gegeben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451927
    m_Localized: 'Teacher: Wir blieben im alten Kindergartengebäude.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451926
    m_Localized: 'Teacher: Ich nahm jedes Kind auf, das sie als „verdorben“ bezeichneten und von dem sie dachten, es könnte ein Besucher sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451925
    m_Localized: 'Teacher: Ich ... Ich wollte nur verstoßenen Kindern ein bisschen Hoffnung geben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451924
    m_Localized: Wer sind Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451923
    m_Localized: Was ist passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451922
    m_Localized: 'Teacher: Kann ich ... mit Ihnen sprechen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451921
    m_Localized: 'Teacher: Tut mir leid, Sie zu stören ... Aber ich fühle mich so furchtbar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451920
    m_Localized: 'Dude: Pass auf dich auf ... und auf deine Familie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451919
    m_Localized: 'Dude: Schon gut, Alter. Ich versteh schon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451918
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451917
    m_Localized: 'Dude: Maaaann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451916
    m_Localized: 'Dude: Irgendwann müssen wir ’nen Film darüber drehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451915
    m_Localized: 'Dude: Mann, das ist vielleicht das Beste, was mir in letzter Zeit passiert ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451914
    m_Localized: 'Dude: Yo, Alter, danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451913
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451912
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451911
    m_Localized: 'Dude: Ich wollte schon immer mal in ’nem Film mitspielen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451910
    m_Localized: 'Dude: Viel interessanter als Bücher, Alter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451909
    m_Localized: 'Dude: Da geht’s zur Sache. Drama. Intrigen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451908
    m_Localized: 'Dude: Aber Filme, Mann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451907
    m_Localized: 'Dude: Und nach den Nachrichten herrscht Weltuntergangsstimmung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451906
    m_Localized: 'Dude: Die Leute erzählen Mist übereinander, es geht nur um Unheil und Verderben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451905
    m_Localized: 'Dude: Nein, Mann, da draußen herrscht das reinste Chaos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451904
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451903
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451902
    m_Localized: 'Dude: Na gut, ich will dir nicht auf die Nerven gehen. Aber komm schon, Alter, lass mich rein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451901
    m_Localized: 'Dude: Haha, das wär’s. Mein Kumpel hat ein Buch darüber gelesen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451900
    m_Localized: 'Dude: Stell dir vor, wir erobern das Universum und schicken Briefe an Aliens ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451899
    m_Localized: 'Dude: Die schreiben über dieses ganze technische Zeug, bevor es überhaupt erfunden ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451898
    m_Localized: 'Dude: Schon mal davon gehört, dass Science-Fiction-Autoren schon immer die Zukunft vorausgesehen haben?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451897
    m_Localized: 'Dude: Alter, das ist kein Quatsch. Ich weiß, wovon ich rede.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451896
    m_Localized: Hast du irgendeine Ahnung, was da draußen passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451895
    m_Localized: Was zur Hölle redest du da?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451894
    m_Localized: 'Dude: Und Nahrung, Mann. Jede Menge Nahrung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451893
    m_Localized: 'Dude: Also, hast du ’ne Schrotflinte oder so was? Wir brauchen Feuerkraft.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451892
    m_Localized: 'Dude: Das ist wichtig für den Überlebensplan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451891
    m_Localized: 'Dude: Sind sie mit einem Virus infiziert oder untot?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451890
    m_Localized: 'Dude: Sind es schnelle oder langsame Zombies?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451889
    m_Localized: 'Dude: Ich hab so viele Filme darüber gesehen, ich bin sozusagen ein Überlebensguru.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451888
    m_Localized: 'Dude: Alter, du kannst dich auf mich verlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451887
    m_Localized: 'Dude: ZOMBIES! HA! ICH WUSSTE ES!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451886
    m_Localized: Hast du irgendeine Ahnung, was da draußen passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451885
    m_Localized: Was zur Hölle redest du da?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451884
    m_Localized: 'Dude: Oh, und das Team muss aus vier Leuten bestehen. Das ist die goldene Überlebenszahl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451883
    m_Localized: 'Dude: Und dann bumm! Und der Feuerball ist Geschichte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451882
    m_Localized: 'Dude: Wir schicken ein krasses Astronautenteam zur Sonne, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451881
    m_Localized: 'Dude: Alter, ich hab diesen Film gesehen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451880
    m_Localized: 'Dude: Verarsch mich nicht!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451879
    m_Localized: Menschenähnliche Kreaturen sind aus dem Boden gekrochen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451878
    m_Localized: Die Sonne spielt verrückt und verbrennt tagsüber die Leute
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451877
    m_Localized: 'Dude: Sag schon, Mann, was hab ich verpasst?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451876
    m_Localized: 'Dude: Verdammt, was zur Hölle ist hier draußen los?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451875
    m_Localized: 'Dude: Yo, Alter, was läuft?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451874
    m_Localized: 'Blind: Sonst kommt es Sie holen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451873
    m_Localized: 'Blind: Bei allem, was heilig ist ... Gehen Sie nachts bloß nicht in die Nähe der verbrannten Leichen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451872
    m_Localized: 'Blind: Ich gehe, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451871
    m_Localized: 'Blind: Verdammt ... Es ist nicht leicht ohne Augen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451870
    m_Localized: 'Blind: Danke ... Endlich kann ich ein wenig zur Ruhe kommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451869
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451868
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451867
    m_Localized: 'Blind: Dieses Ding hätte niemals existieren dürfen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451866
    m_Localized: 'Blind: Größer. Stärker. Man ... Man kann es nicht benennen. Es folgt dem verbrannten Geruch und erntet, was wir gesät haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451865
    m_Localized: 'Blind: Oh nein ... nein, nein. Es gibt etwas viel Schlimmeres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451864
    m_Localized: 'Blind: Glauben Sie wirklich, ich hätte mir wegen irgendeines bleichen Mannes die Augen ausgerissen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451863
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451862
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451861
    m_Localized: 'Blind: Gott ... Diesen Anblick wünsche ich nicht einmal meinem schlimmsten Feind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451860
    m_Localized: 'Blind: Ganz langsam hat es diese verkohlten Leichen in sich hineingestopft ... DIREKT VOR MEINEN AUGEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451859
    m_Localized: 'Blind: Es ... Es hat mich zuerst gar nicht bemerkt. Es war zu sehr damit beschäftigt, Fleisch zu verschlingen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451858
    m_Localized: 'Blind: Ich war einfach nur zur falschen Zeit am falschen Ort ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451857
    m_Localized: 'Blind: Es ernährt sich von unserem Leid! Ein Buffet der Trauer! Es labt sich an Angst, Schmerz ... und unserem Verstand!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451856
    m_Localized: 'Blind: Das wollen Sie gar nicht wissen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451855
    m_Localized: Sie meinen den bleichen Mann?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451854
    m_Localized: Was haben Sie gesehen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451853
    m_Localized: 'Blind: Ich dachte, wenn ich sie rausreiße, könnte ich dieses schreckliche Bild loswerden. Jetzt sehe ich nur noch endlose Dunkelheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451852
    m_Localized: 'Blind: Ich musste meine Augen opfern, um nicht den Verstand zu verlieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451851
    m_Localized: 'Blind: Ich ... habe es mir selbst angetan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451850
    m_Localized: Sie meinen den bleichen Mann?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451849
    m_Localized: Was haben Sie gesehen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451848
    m_Localized: 'Blind: Glauben Sie mir ... Wenn Sie es gesehen hätten, hätten Sie dasselbe getan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451847
    m_Localized: 'Blind: Es gibt keine Worte für den Schrecken, der meine Seele zerrissen hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451846
    m_Localized: 'Blind: Das Bild ... Ich sehe es vor mir. Eingebrannt in die Dunkelheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451845
    m_Localized: 'Blind: Ich habe Schlimmes gesehen. Ich wage es nicht zu beschreiben ... Wer will schon über seinen gebrochenen Geist sinnieren?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451844
    m_Localized: Wer hat Ihnen das angetan?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451843
    m_Localized: Was ist mit Ihren Augen passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451842
    m_Localized: 'Blind: Endlich ... eine Art Unterschlupf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451841
    m_Localized: 'Fatman: Wo soll ich denn hin? Ich bin aufgeschmissen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451840
    m_Localized: 'Fatman: Komm schon, Kumpel ... Du siehst doch, dass es mir nicht gut geht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451839
    m_Localized: 'Fatman: Ich revanchiere mich, wenn das ganze Durcheinander vorbei ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451838
    m_Localized: 'Fatman: Du wirst es nicht bereuen, Kumpel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451837
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451836
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451835
    m_Localized: 'Fatman: Lass mich rein, dann schwimmst du im Geld, wenn das Ganze hier vorbei ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451834
    m_Localized: 'Fatman: Einen wichtigen Mann wie mich schickt man nicht weg. Ich hatte hier früher das Sagen, ich war Minister.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451833
    m_Localized: 'Fatman: Ich hab ewig gebraucht, mich hierher zu schleppen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451832
    m_Localized: 'Fatman: Komm schon, Kumpel ... Lass mich rein, ich kann nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451831
    m_Localized: 'Fatman: Ich meine es ernst. Mir geht’s nicht gut. Ich brauche sofort kaltes Wasser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451830
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451829
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451828
    m_Localized: 'Fatman: Sonst falle ich um, und später verbrennt mich die Sonne bei lebendigem Leib.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451827
    m_Localized: 'Fatman: Mach einfach die Tür auf. Ich brauche dringend eine Dusche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451826
    m_Localized: 'Fatman: ... Jetzt muss ich an Eiscreme denken. Verdammt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451825
    m_Localized: 'Fatman: Perfekt, das lob ich mir. Ich dachte schon, ich würde hier draußen eingehen, Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451824
    m_Localized: Was willst du in meinem Badezimmer?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451823
    m_Localized: Ja, habe ich
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451822
    m_Localized: 'Fatman: Ich brauche eine kleine Abkühlung. Kann ich deine Dusche benutzen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451821
    m_Localized: 'Fatman: Es ist heißer als in jedem Fünf-Sterne-Resort, in dem ich jemals war.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451820
    m_Localized: 'Fatman: Meine Haut fühlt sich an, als würde sie brennen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451819
    m_Localized: 'Fatman: Nein, nichts ist in Ordnung. Sieh mich doch an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451818
    m_Localized: Was willst du in meinem Badezimmer?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451817
    m_Localized: Ja, habe ich
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451816
    m_Localized: 'Fatman: Ich kann kaum atmen. Hast du, äh ... ein Badezimmer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451815
    m_Localized: 'Fatman: Klar, nachts ist es ein wenig kühler ... aber es ist immer noch stickig.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451814
    m_Localized: 'Fatman: Egal, fühlt sich trotzdem an wie in einem Backofen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451813
    m_Localized: Alles in Ordnung?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451812
    m_Localized: Es ist mitten in der Nacht
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451811
    m_Localized: 'Fatman: Hey ... Verdammt ... Es ist glühend heiß hier draußen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451810
    m_Localized: 'Buddy: Na gut, ich geh dir nicht weiter auf die Nerven. Bin schon weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451809
    m_Localized: 'Buddy: Verdammt, Kumpel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451808
    m_Localized: 'Buddy: Ansonsten wäre ich ganz allein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451807
    m_Localized: 'Buddy: Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451806
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451805
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451804
    m_Localized: 'Buddy: Aber Spaß beiseite. Lässt du mich rein, Kumpel?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451803
    m_Localized: 'Buddy: Was ist gegen einen kleinen Schluck einzuwenden? Der Welt nüchtern beim Untergehen zuzusehen, wäre doch zu viel verlangt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451802
    m_Localized: 'Buddy: Hehe, entspann dich, ich mach doch nur Spaß. Nimm’s mir nicht übel. Das ist alles, was uns im Moment übrigbleibt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451801
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451800
    m_Localized: 'Buddy: Lecker und gesund. Funktioniert wie eine Diät, wenn man’s richtig macht. Sieh dir diesen Prachtkörper an.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451799
    m_Localized: 'Buddy: Heute hatte ich ein exquisites Frühstück. Ich halte mich an den Ernährungsplan meines Kumpels: morgens Bier, abends Wein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451798
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451797
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451796
    m_Localized: 'Buddy: Also ... lässt du mich rein, Kumpel?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451795
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451794
    m_Localized: 'Buddy: Nimm mir meine Scherze nicht übel. Ich versuche nur, nicht durchzudrehen. Ich hoffe, du verstehst mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451793
    m_Localized: 'Buddy: Aber Humor, Kumpel ... Der hält dich bei Verstand, wenn alles andere vor die Hunde geht. Ohne Humor wäre ich längst tot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451792
    m_Localized: 'Buddy: Warum auch nicht? Überall, wo man hinschaut, gerät die Welt aus den Fugen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451791
    m_Localized: Du wirkst angetrunken.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451790
    m_Localized: Was bist du, ein Komiker?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451789
    m_Localized: 'Buddy: Vergiss es.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451788
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451787
    m_Localized: 'Buddy: Ich würde nie jemandem wegen seiner Zähne oder Augen wehtun. Oder was sie sonst noch im Fernsehen sagen. Ich könnte nicht mal ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451786
    m_Localized: 'Buddy: Eine komische Eigenschaft macht einen nicht gleich zum Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451785
    m_Localized: 'Buddy: Komm schon, ich mach doch nur Spaß. Mach dich mal locker.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451784
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451783
    m_Localized: 'Buddy: Na gut, manchmal verprügle ich Leute mit perfekten Zähnen und schönen Augen ... Aber nur, weil ich sie beneide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451782
    m_Localized: 'Buddy: Glaub mir, ich hab ein großes Herz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451781
    m_Localized: Du wirkst angetrunken.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451780
    m_Localized: Was bist du, ein Komiker?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451779
    m_Localized: 'Buddy: Das heißt, ich bin jederzeit dabei, falls du was trinken gehen willst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451778
    m_Localized: 'Buddy: Ich hab gar keine Schwiegermutter. Ich bin nicht mal verheiratet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451777
    m_Localized: 'Buddy: Hehe, war nur ein Scherz, Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451776
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257716
    m_Localized: 'Buddy: Meine Schwiegermutter hat mich rausgeworfen, weil ich einen FEMA-Typen vor die Tür gesetzt hab. Jetzt hat sie Angst, dass sie wiederkommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257715
    m_Localized: 'Buddy: Ach, nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257714
    m_Localized: Woher weiß ich, dass du ein „rechtschaffener“ Mann bist?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257713
    m_Localized: Was ist dir passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257712
    m_Localized: 'Buddy: Hey, Kumpel. Du lässt doch einen rechtschaffenen Mann rein, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257711
    m_Localized: 'Bestson: Tschüss, Fremder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257710
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257709
    m_Localized: 'Bestson: Ja ... Ja, sie kommen zurück. Ganz bestimmt. Hoffe ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257708
    m_Localized: 'Bestson: Ich gehe zurück nach Hause. Nur für den Fall, dass sie zurückkommen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257707
    m_Localized: 'Bestson: Ja. Das ist wahrscheinlich sicherer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257706
    m_Localized: 'Bestson: Aber ... vielleicht sollte ich erst einmal hierbleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257705
    m_Localized: 'Bestson: Was, wenn sie zurückkommen und ich nicht da bin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257704
    m_Localized: 'Bestson: Ich weiß nicht, ob das eine gute Idee ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257703
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257702
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257701
    m_Localized: 'Bestson: Was soll ich nur tun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257700
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257699
    m_Localized: 'Bestson: Das ist ... Das ist ein Albtraum ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257698
    m_Localized: 'Bestson: Oh Gott ... Was, wenn sie verbrannt sind? Wenn die Sonne sie verbrannt hat?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257697
    m_Localized: Verschwinde
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257696
    m_Localized: Komm rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257695
    m_Localized: 'Bestson: Was soll ich nur tun?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257694
    m_Localized: 'Bestson: Ich weiß gar nicht mehr, was ich denken soll. Vielleicht vertraust du mir auch nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257693
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257692
    m_Localized: 'Bestson: Warum sind sie nur weggegangen? Warum haben sie mich nicht mitgenommen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257691
    m_Localized: 'Bestson: Oh Gott. Was, wenn diese Besucher sie getötet haben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257690
    m_Localized: Die Sonne explodiert und verbrennt Menschen bei lebendigem Leib
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257689
    m_Localized: Besucher sind aus dem Untergrund gekrochen, man kann niemandem trauen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257688
    m_Localized: 'Bestson: Ich dachte, wenn ich mit jemandem spreche, kann er mir vielleicht sagen, was passiert ist. Kannst du das tun? Bitte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257687
    m_Localized: 'Bestson: Kurz nach der Sendung sind sie gegangen ... und nie wiedergekommen. Jetzt habe ich noch mehr Angst, den Fernseher einzuschalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257686
    m_Localized: 'Bestson: Ich habe den Fernseher nicht eingeschaltet. Aber sie sind nicht zurückgekommen und ich weiß immer noch nicht, was los ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257685
    m_Localized: 'Bestson: Eines Tages haben sie gehört, dass etwas Schlimmes passiert ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257684
    m_Localized: 'Bestson: Aber Mama und Papa haben sie immer angeschaut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257683
    m_Localized: 'Bestson: Und ich habe irgendwo gelesen, dass man länger lebt, wenn man die Nachrichten meidet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257682
    m_Localized: 'Bestson: In den Nachrichten sagen sie nie irgendwas Gutes. Das zieht mich nur runter, also habe ich aufgehört zu schauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257681
    m_Localized: Die Sonne explodiert und verbrennt Menschen bei lebendigem Leib
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257680
    m_Localized: Besucher sind aus dem Untergrund gekrochen, man kann niemandem trauen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257679
    m_Localized: 'Bestson: Ich muss die Wahrheit wissen. Wo sind sie hin? Sagst du mir, was los ist?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257678
    m_Localized: 'Bestson: Aber ... das ist schon eine Woche her. Sie sind immer noch nicht zurück. Ich habe die ganze Zeit gewartet, aber sie sind einfach ... weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257677
    m_Localized: 'Bestson: Eines Morgens bin ich aufgewacht und sie sind total durchgedreht. Sie haben gesagt, dass sie sofort wegmüssen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257676
    m_Localized: 'Bestson: Nein. Die Nachrichten machen mir Angst. Ich ... versuche, nichts davon mitzukriegen. Aber meine Eltern ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257675
    m_Localized: Schaust du kein Fernsehen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257674
    m_Localized: Moment mal, du weißt wirklich nicht, was los ist?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257673
    m_Localized: 'Bestson: Sie schießen und kämpfen ... Ich verstehe das nicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257672
    m_Localized: 'Bestson: Es ist so heiß, dass ich kaum atmen kann, und die Leute sind ... anders als sonst.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257671
    m_Localized: 'Bestson: Kannst du mir sagen, was los ist?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257670
    m_Localized: 'Fugitive: Gute Nacht, Arschloch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257669
    m_Localized: 'Fugitive: Verstecken sich in ihren Löchern und sperren alle anderen aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257668
    m_Localized: 'Fugitive: Natürlich. Ich hätte es wissen müssen. Sie sind genau wie die anderen. Ängstliche kleine Ratten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257667
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257666
    m_Localized: 'Fugitive: SCHEISSE.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257665
    m_Localized: 'Fugitive: Gut zu wissen, dass Sie nicht wie Ihre Nachbarn sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257664
    m_Localized: 'Fugitive: Danke. Wirklich. Sie haben was gut bei mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257663
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257662
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257661
    m_Localized: 'Fugitive: Jetzt bin ich ein Zeuge ... Ich weiß zu viel. Sie werden mir auf den Fersen bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257660
    m_Localized: 'Fugitive: Deshalb bin ich geflohen, auch wenn ich an diesem verdammten Zaun eine Kugel einstecken musste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257659
    m_Localized: 'Fugitive: Als ich das gesehen hab, wusste ich, dass ich schleunigst verschwinden musste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257658
    m_Localized: 'Fugitive: So gehen sie dort mit Menschen um. Deshalb schafft es da niemand raus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257657
    m_Localized: 'Fugitive: Ich hab gedämpfte Schreie gehört ... und dann haben sie einen schwarzen Sack rausgeschleppt. Das war’s für den Kerl, verstehen Sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257656
    m_Localized: 'Fugitive: Ich hab’s gesehen, verdammt. Sie haben einen armen Kerl in ein Zelt gezerrt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257655
    m_Localized: 'Fugitive: Dieser ganze Mist ist nicht nur ein Gerücht!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257654
    m_Localized: 'Fugitive: Haben Sie gehört, dass die FEMA Tests macht, um Besucher zu finden?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257653
    m_Localized: 'Fugitive: Das können Sie laut sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257652
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257651
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257650
    m_Localized: 'Fugitive: Ich bin vom Zaun in eine Pfütze gefallen und losgerannt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257649
    m_Localized: 'Fugitive: Aber ich hatte leider Pech. Eins von den Schweinen hat sich umgedreht, mich gesehen und losgeballert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257648
    m_Localized: 'Fugitive: Die sind dort ziemlich beschäftigt. Man merkt, dass sie sich auf irgendwas vorbereiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257647
    m_Localized: 'Fugitive: Ich brauchte nicht mal ’nen Plan. Ich musste nur auf den richtigen Moment warten und über den Zaun klettern.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257646
    m_Localized: 'Fugitive: Und ihre Sicherheitsvorkehrungen sind ein gottverdammter Witz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257645
    m_Localized: 'Fugitive: Das ist eine FEMA-Quarantänezone.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257644
    m_Localized: 'Fugitive: Ein riesiger Frachtcontainer, in den sie jeden Morgen Menschen wie Vieh reintreiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257643
    m_Localized: 'Fugitive: Stellen Sie sich einen leeren Parkplatz vor, eingezäunt und hier und da ein paar Zelte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257642
    m_Localized: Die FEMA ist also hinter Ihnen her?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257641
    m_Localized: Erzählen Sie mir von den FEMA-Quarantänezonen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257640
    m_Localized: 'Fugitive: Ich hab ihnen gesagt, dass sie zur Hölle fahren sollen. Also haben sie mir Handschellen angelegt. Aber ich bin entkommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257639
    m_Localized: 'Fugitive: Dann haben sie irgendeinen Schwachsinn in ihre Tablets getippt und gesagt, dass ich mitkommen soll.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257638
    m_Localized: 'Fugitive: Ich hab die Tür aufgemacht und sie haben mich sofort durchleuchtet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257637
    m_Localized: 'Fugitive: Ich bin aus einer ihrer Zonen ausgebrochen. Sie haben bei einer Kontrolle an meine Tür geklopft und mich geschnappt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257636
    m_Localized: Die FEMA ist also hinter Ihnen her?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257635
    m_Localized: Erzählen Sie mir von den FEMA-Quarantänezonen
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257634
    m_Localized: "Fugitive: Wenigstens quillen mir nicht die Gedärme raus ... Nicht, dass da noch viel drin wäre.\n Hehe ... Ah ... Scheiße, tut das weh."
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257633
    m_Localized: "Fugitive: Glatter Durchschuss, immerhin.\n Aber Scheiße, ich blute wie ein abgestochenes Schwein."
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257632
    m_Localized: 'Fugitive: Miese Schützen, diese Arschlöcher. Aber eine Kugel ... ja, eine hat mich erwischt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257631
    m_Localized: 'Fugitive: Die verdammten FEMA-Schweine ... Ich bin über den Zaun geklettert und geflohen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257630
    m_Localized: Was ist passiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257629
    m_Localized: Wer war das?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257628
    m_Localized: 'Fugitive: Ich wurde angeschossen. Ich halte nicht mehr lange durch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257627
    m_Localized: 'Fugitive: Helfen Sie mir ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257626
    m_Localized: 'Nun: Der Herr wird sich daran erinnern. Er sieht alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257625
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257624
    m_Localized: 'Nun: Mein Tod wird schwer auf Ihrer Seele lasten, das verspreche ich Ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257623
    m_Localized: 'Nun: Sie weisen eine arme alte Frau ab.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257622
    m_Localized: 'Nun: So ist das also.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257621
    m_Localized: 'Nun: Ich danke Ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257620
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257619
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257618
    m_Localized: 'Nun: Ich versichere Ihnen, dass ich alles tun werde, um solch vulgäre Sprache von diesem Ort zu verbannen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257617
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257616
    m_Localized: 'Nun: Ich stelle eine einfache Frage zu Ihrem Haus und Sie beleidigen mich?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257615
    m_Localized: 'Nun: Haben Sie keine Furcht vor Gott?! Schämen Sie sich gar nicht?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257614
    m_Localized: 'Nun: Sie ungehobelter, gottloser Wilder!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257613
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257612
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257611
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257610
    m_Localized: 'Nun: Ist das zu viel verlangt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257609
    m_Localized: 'Nun: Ich will nur herausfinden, ob Ihr Haus bewohnbar ist. Ich habe eine Abneigung gegen Schmutz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257608
    m_Localized: 'Nun: Oh, ich danke Ihnen! Ohne Sie wäre ich nie darauf gekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257607
    m_Localized: Sind Sie verrückt?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257606
    m_Localized: Das hier ist kein Hotel!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257605
    m_Localized: 'Nun: Das könnte ich nicht ertragen. Davon bekomme ich Ausschlag.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257604
    m_Localized: 'Nun: Zweitens: Haben Sie Bettwanzen? Ratten?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257603
    m_Localized: 'Nun: Falls sich solche Leute bei Ihnen aufhalten, sagen Sie es mir bitte gleich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257602
    m_Localized: 'Nun: Erstens: Ich dulde keine Trinker oder sonstige Drogensüchtige.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257601
    m_Localized: 'Nun: Sie nehmen doch Leute auf, nicht wahr? Ich muss nur vorher ein paar Dinge abklären.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257600
    m_Localized: 'Nun: Ich brauche ein Zimmer in Ihrem Haus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257599
    m_Localized: Haben Sie Ihren verdammten Verstand verloren?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257598
    m_Localized: Das hier ist kein Hotel!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257597
    m_Localized: 'Nun: Sie haben doch sicher heilige Ikonen? Und ... ich brauche absolute Stille. Für Gebete und innere Einkehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257596
    m_Localized: 'Nun: Und wenn wir schon dabei sind ... Lassen Sie mich eine Frage stellen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257595
    m_Localized: 'Nun: Zum Bleiben, mein Lieber, zum Bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257594
    m_Localized: 'Nun: Herr, erbarme dich. Habe ich mich nicht deutlich ausgedrückt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257593
    m_Localized: Was brauchen Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257592
    m_Localized: Genau richtig wofür?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257591
    m_Localized: 'Nun: Ich glaube, das ist genau richtig für mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257590
    m_Localized: 'Nun: Ihr kleines Haus ist das abgelegenste von allen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257589
    m_Localized: Tut mir leid, dass ich Ihre Zeit verschwendet habe. Ich hoffe nur ... dass ich irgendwann das Töten lerne. Damit ich mich wehren kann.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257588
    m_Localized: Ich schwöre, ich bin nicht verrückt. Ich bin einfach nur ... mit den Nerven am Ende.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257587
    m_Localized: 'Raskolnikov: Wahrscheinlich habe ich geklungen wie ein Verrückter. Oder noch schlimmer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257586
    m_Localized: 'Raskolnikov: Sie wollen mich nicht reinlassen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257585
    m_Localized: 'Raskolnikov: Könnten Sie mir zeigen, wie es geht? Wie man einen Besucher tötet. Ich will der Angst ins Auge blicken.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257584
    m_Localized: 'Raskolnikov: Und ... wenn es nicht zu viel verlangt ist ... nachdem Sie mich getestet haben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257583
    m_Localized: 'Raskolnikov: Danke, mein Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257582
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257581
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257580
    m_Localized: 'Raskolnikov: Sie könnten mir beibringen ... wie man tötet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257579
    m_Localized: 'Raskolnikov: Aber vielleicht ... Ich meine, wenn Sie wollen ... Also ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257578
    m_Localized: 'Raskolnikov: Deshalb will ich jemanden finden ... der mich beschützen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257577
    m_Localized: 'Raskolnikov: Und ich? Ich bin nur ein Feigling. Ich kann mich nicht verteidigen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257576
    m_Localized: 'Raskolnikov: Heutzutage reicht schon ein falscher Blick, damit jemand abdrückt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257575
    m_Localized: 'Raskolnikov: Mir geht es um Schutz vor den Besuchern. Und vor denen, die es auf sie abgesehen haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257574
    m_Localized: 'Raskolnikov: Nein, nein – warten Sie. Ich meine nicht den Irren mit dem Gewehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257573
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257572
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257571
    m_Localized: 'Raskolnikov: Darum brauche ich jemanden, der versteht, wie diese Welt funktioniert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257570
    m_Localized: 'Raskolnikov: Ich habe Angst davor, was passiert, wenn ich nicht lerne, mich zu wehren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257569
    m_Localized: 'Raskolnikov: Als alles noch normal war, konnte ich keiner Fliege was zuleide tun. Aber jetzt ... Weicheier wie ich überleben nicht lange.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257568
    m_Localized: 'Raskolnikov: Ich wollte nicht rüberkommen wie ein Verrückter. Es ist nur ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257567
    m_Localized: 'Raskolnikov: Was? Warten Sie ... Hört sich das für Sie ... komisch an?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257566
    m_Localized: Vor wem wollen Sie sich schützen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257565
    m_Localized: Warum sind Sie so aufs Töten fixiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257564
    m_Localized: 'Raskolnikov: Und dann ... muss ich nicht mehr in Angst leben. Sondern die anderen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257563
    m_Localized: 'Raskolnikov: Egal. Irgendwann lerne ich auch noch das Töten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257562
    m_Localized: 'Raskolnikov: Ein Glück, dass er mich nicht gesehen hat. Wahrscheinlich hätte er mir sofort den Hals umgedreht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257561
    m_Localized: 'Raskolnikov: Die Sache ist ... Ich bin vor Kurzem einem bewaffneten Irren begegnet. Er hat einen Mann verhört ... ihn gefragt, ob er ein Besucher ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257560
    m_Localized: 'Raskolnikov: Verstehen Sie mich nicht falsch, ich will Sie nicht gegen irgendjemanden ausspielen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257559
    m_Localized: 'Raskolnikov: Perfekt! Dann können Sie jeden Besucher erledigen, der hier auftaucht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257558
    m_Localized: Vor wem wollen Sie sich schützen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257557
    m_Localized: Warum sind Sie so aufs Töten fixiert?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257556
    m_Localized: 'Raskolnikov: Ich wette, Sie könnten mit bloßen Händen jemanden umbringen, wenn es hart auf hart kommt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257555
    m_Localized: 'Raskolnikov: Aber Sie haben den richtigen Ton in der Stimme. Ich glaube, Sie kommen mit der Situation zurecht.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257554
    m_Localized: 'Raskolnikov: Jemanden zu verurteilen, weil er mitten in der Apokalypse tötet ... Das wäre, als würde man auf einer Rennstrecke Strafzettel verteilen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257553
    m_Localized: 'Raskolnikov: Aber wir leben in gefährlichen Zeiten. Da muss man sich behaupten können. Sich gegen Bedrohungen zur Wehr setzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257552
    m_Localized: 'Raskolnikov: Ah ... Tut mir leid. Ich wollte nicht unhöflich sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257551
    m_Localized: Ja, ich habe eine Waffe
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257550
    m_Localized: Warum wollen Sie das wissen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257549
    m_Localized: 'Raskolnikov: Sagen Sie, sind Sie bewaffnet?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257548
    m_Localized: 'Raskolnikov: Hallo, mein Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257547
    m_Localized: 'Wifefema: Wissen Sie was? Fahren Sie zur Hölle. Ich gehe zu Ihren Nachbarn. Tschüss, Vollidiot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257546
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257545
    m_Localized: 'Wifefema: Was ist Ihr verdammtes Problem? Ich bin ehrlich zu Ihnen und Sie behandeln mich wie den letzten Dreck?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257544
    m_Localized: 'Wifefema: Ist das Ihr Ernst? Mein Mann ist bei der FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257543
    m_Localized: 'Wifefema: Halten Sie mich für eine Besucherin?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257542
    m_Localized: 'Wifefema: Moment mal ... Was zur Hölle?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257541
    m_Localized: 'Wifefema: Sobald wir diese Besucher getötet haben, können wir wieder ein normales Leben führen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257540
    m_Localized: 'Wifefema: Na, wer sagt’s denn!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257539
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257538
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257537
    m_Localized: 'Wifefema: Von wegen „FEMA ist nichts für Frauen“.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257536
    m_Localized: 'Wifefema: Ich hab an der Grenze gearbeitet. Ich hab ein Näschen für zwielichtige Gestalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257535
    m_Localized: 'Wifefema: Ich sag’s Ihnen, das ist nicht fair. Bin ich etwa schlechter als mein Mann?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257534
    m_Localized: 'Wifefema: Was spielt das für eine Rolle? Jetzt ist er bei der FEMA. Und ich könnte auch dort sein, wenn sie Frauen nehmen würden.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257533
    m_Localized: 'Wifefema: Hehe, als ob ich Ihnen das sagen würde. Warum wollen Sie das wissen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257532
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257531
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257530
    m_Localized: 'Wifefema: Da ist mir jede Menge Gesocks ins Netz gegangen, das jeden erdenklichen Mist reinschmuggeln wollte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257529
    m_Localized: 'Wifefema: Ich war beim Zoll, wissen Sie? Grenzkontrollen und so.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257528
    m_Localized: 'Wifefema: Selbst schuld. Ich wäre richtig gut darin, zusammen mit meinem Mann Besucher aufzuspüren.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257527
    m_Localized: 'Wifefema: Hehe, schön wär’s. Aber nein, anscheinend nehmen sie keine Frauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257526
    m_Localized: Was hat Ihr Mann vorher gemacht?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257525
    m_Localized: Sind Sie auch bei der FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257524
    m_Localized: 'Wifefema: Der verdammte Taxifahrer hat mich ausgenommen wie eine Weihnachtsgans.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257523
    m_Localized: 'Wifefema: Ich wollte ihn überraschen, also hab ich Geld für ein Taxi zusammengekratzt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257522
    m_Localized: 'Wifefema: Als ich gehört hab, dass er bei der FEMA genommen wurde, wäre ich fast ausgerastet!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257521
    m_Localized: 'Wifefema: Oh, das sage ich Ihnen voller Stolz: Er arbeitet bei der FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257520
    m_Localized: Was hat Ihr Mann vorher gemacht?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257519
    m_Localized: Sind Sie auch bei der FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257518
    m_Localized: 'Wifefema: Mein Mann ist bei der FEMA. Wenn er ihn zu fassen bekommt ... bleibt ihm sein Porzellanlächeln buchstäblich im Hals stecken. Hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257517
    m_Localized: 'Wifefema: Aber ich schwöre bei Gott, die Zähne des Taxifahrers waren weiß wie Porzellan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257516
    m_Localized: 'Wifefema: Ich musste ein kleines Vermögen berappen. So was kostet einen heutzutage das letzte Hemd.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257515
    m_Localized: 'Wifefema: Wie? Na, mit einem Taxi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257514
    m_Localized: Was macht Ihr Mann beruflich?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257513
    m_Localized: Wie sind Sie hergekommen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257512
    m_Localized: 'Wifefema: Aber dann hat sich rausgestellt, dass sein Arbeitgeber mich nirgendwo unterbringen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257511
    m_Localized: 'Wifefema: Ich dachte mir, ich überrasche ihn mit einem Besuch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257510
    m_Localized: 'Wifefema: Ich bin wegen meinem Mann hier. Er musste wegen seiner neuen Arbeitsstelle umziehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257509
    m_Localized: 'Wifefema: Hallöchen! Kann ich hier für ’ne Weile unterkommen?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257508
    m_Localized: 'Theorist: Auf Wiedersehen. Ich habe Ihnen vertraut ... und Sie haben meinen Glauben an die Menschheit erschüttert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257507
    m_Localized: 'Theorist: Die Leute verdienen es, die Wahrheit zu erfahren!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257506
    m_Localized: 'Theorist: Sie machen einen Fehler!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257505
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257504
    m_Localized: 'Theorist: Glauben Sie mir, ich habe die Wahrheit gesehen! Vergessen Sie all die Lügen!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257503
    m_Localized: 'Theorist: Ich wusste, dass ich Ihnen vertrauen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257502
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257501
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257500
    m_Localized: 'Theorist: Also bin ich erhobenen Hauptes gegangen. Mit wertvollen Daten in der Hand.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257499
    m_Localized: 'Theorist: Wenn die Leute Ohrenstöpsel benutzt hätten ... wären keine Parasiten eingedrungen und Tausende hätten gerettet werden können.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257498
    m_Localized: 'Theorist: Aber diese Trottel wollten den Wert meiner Befunde nicht erkennen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257497
    m_Localized: 'Theorist: Ich habe behauptet, dass die wirkliche Bedrohung nicht die Besucher sind, sondern das, was in ihnen steckt. Gehirnparasiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257496
    m_Localized: 'Theorist: Ich habe früher bei einem Forschungsinstitut gearbeitet. Sie haben mich wegen meiner Entdeckungen gefeuert.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257495
    m_Localized: 'Theorist: Aber Sie müssen schwören, dass Sie niemandem davon erzählen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257494
    m_Localized: 'Theorist: Gut, ich habe beschlossen, Ihnen zu vertrauen. Also packe ich aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257493
    m_Localized: Verschwinden Sie
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257492
    m_Localized: Kommen Sie rein
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257491
    m_Localized: 'Theorist: Warum Kartoffelchips eine wissenschaftliche Bankrotterklärung und zugleich eine geschmacklose Katastrophe sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257490
    m_Localized: 'Theorist: Gedankenkontrolle. Durch Fast Food. Ja, wirklich. Und zu guter Letzt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257489
    m_Localized: 'Theorist: Wahlbetrug. Beweise, dass die Mondlandung nie stattgefunden hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257488
    m_Localized: 'Theorist: Machen Sie sich bereit, mein Freund. Ich werde Ihnen die Augen öffnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257487
    m_Localized: Wo haben Sie das alles her?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257486
    m_Localized: Wovon reden Sie?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257485
    m_Localized: 'Theorist: Und das bedeutet ... dass ich Ihnen etwas Wichtiges anvertrauen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257484
    m_Localized: 'Theorist: Wenn Sie es verneinen, müssen Sie also die Wahrheit sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257483
    m_Localized: 'Theorist: FEMA-Agenten sind nämlich verpflichtet, Ihren Auftraggeber auf Nachfrage offenzulegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257482
    m_Localized: 'Theorist: Ah. Gut. Das heißt, ich kann Ihnen vertrauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257481
    m_Localized: Wo haben Sie das alles her?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257480
    m_Localized: Was sind das für Informationen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257479
    m_Localized: 'Theorist: Wir sprechen hier von Unmengen von Daten, die ich öffentlich machen will.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257478
    m_Localized: 'Theorist: Ich habe streng vertrauliche Unterlagen dabei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257477
    m_Localized: 'Theorist: Ich brauche einen sicheren Ort, an dem ich meine Forschung fortsetzen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257476
    m_Localized: 'Theorist: Mit wichtigen Informationen natürlich!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257475
    m_Localized: Nein, ich bin nicht bei der FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257474
    m_Localized: Inwiefern vertrauen?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257473
    m_Localized: 'Theorist: Sie sind doch nicht ... bei der FEMA, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257472
    m_Localized: 'Theorist: Hallo. Sagen Sie ... Kann ich Ihnen vertrauen?'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861319
    m_Localized: 'Firefighter: Hier, ich brauche es sowieso nicht. Schmeißen Sie es weg oder machen Sie damit, was Sie wollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861318
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861317
    m_Localized: 'Firefighter: Sie wollten, dass wir in die FEMA-Quarantänezonen gehen. Aber wer geht schon dorthin, wenn dort jeder stirbt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861316
    m_Localized: 'Firefighter: Vor unserem Löscheinsatz haben sie uns diesen Zettel gegeben.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861315
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861314
    m_Localized: 'Firefighter: Wenigstens muss ich nicht auf dem nassen Boden sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861313
    m_Localized: 'Firefighter: Ich glaube nicht, dass ich Ihnen allzu lange zur Last fallen werde. *hust*'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861312
    m_Localized: 'Firefighter: Danke. *hust*'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
