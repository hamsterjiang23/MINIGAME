%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DayDialogs_vi
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 48f2181e494cb864ca5ca7074da486ff, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22080585977856
    m_Localized: 'Firefighter: Nóng vãi chưởng...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560768
    m_Localized: Anh thấy trong người sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560769
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560770
    m_Localized: 'Firefighter: Anh không ngờ lại thảm đến mức này. *khụ* Mẹ cha nó chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560771
    m_Localized: 'Firefighter: Chắc anh không sống nổi hết tuần này đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560772
    m_Localized: 'Firefighter: Mà chú cho anh vào là anh cũng thấy an ủi phần nào rồi. Cảm ơn nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560773
    m_Localized: 'Firefighter: Nhưng... giờ anh lại chôn chân ở đây trong khi các anh em ngoài kia đang chết dần.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560774
    m_Localized: 'Firefighter: Lẽ ra anh phải ở lại với bọn nó. Anh có còn gì để mất đâu. Đằng nào anh cũng sắp xuống lỗ rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560775
    m_Localized: 'Firefighter: Nóng vãi chưởng...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560776
    m_Localized: Sao anh không về nhà đi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560777
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560778
    m_Localized: 'Firefighter: Thì tại mấy đứa con anh đang ở nhà... *khụ*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560779
    m_Localized: 'Firefighter: Nên anh không muốn làm tụi nó sợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560780
    m_Localized: 'Firefighter: Tâm hồn nó *khụ* còn trẻ thơ, không nên nhớ về bố nó trong bộ dạng thế này.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560781
    m_Localized: 'Firefighter: Thà cứ để tụi nhỏ nghĩ anh chết trong rừng đi, chết trong lúc... *khụ khụ*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560782
    m_Localized: 'Firefighter: Làm nhiệm vụ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560783
    m_Localized: 'Firefighter: *khụ* Để trong ký ức tụi nó, anh sẽ mãi là người bố nỗ lực, tận tâm suốt bao năm làm lính cứu hỏa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560784
    m_Localized: 'Firefighter: Nóng vãi chưởng...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560785
    m_Localized: Đồng phục của anh đâu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560786
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560787
    m_Localized: 'Firefighter: Lũ sếp nó vơ hết rồi. *khụ* Mấy anh em giờ chẳng còn đủ đồ bảo hộ nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560788
    m_Localized: 'Firefighter: Đồng nghiệp *khụ* thì đang chết dần ngoài kia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560789
    m_Localized: 'Firefighter: Thậm chí bọn anh còn chẳng kịp nhặt xác đồng đội về. Ngọn lửa *khụ* thiêu tất cả thành tro rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560790
    m_Localized: 'Firefighter: Nhưng lũ sếp... Chúng nó chỉ quan tâm đến *khụ* dăm ba cái đồng phục...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560791
    m_Localized: 'Firefighter: Chả biết ngoài kia có gì mà cứ ra hết lệnh này đến giấy nọ. Toàn bánh vẽ chứ có cái mẹ gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560792
    m_Localized: 'Firefighter: Nóng vãi chưởng...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560793
    m_Localized: Cháy rừng do đâu mà ra thế anh?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560794
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560795
    m_Localized: 'Firefighter: Đợt này khu rừng gần như chết khô rồi. Nên là *khụ* dễ bắt lửa lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560796
    m_Localized: 'Firefighter: Chẳng hiểu bọn anh *khụ* dính phải cái dớp gì mà hết chuyện Dị Khách chui từ dưới đất lên, rồi đến vụ cháy rừng này nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560797
    m_Localized: 'Firefighter: Thế mà số mệnh vẫn chưa chịu buông tha...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560798
    m_Localized: 'Firefighter: Bọn anh bị cày cho nát thây ra rồi, chỉ ước được ra đi thanh thản.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560799
    m_Localized: 'Firefighter: Anh bảo chút... *khụ* Cái này anh định đem về nhà làm quà. Nhưng giờ anh tặng chú đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560800
    m_Localized: 'Firefighter: Vòng cổ ấy mà. Cũng không có gì đặc biệt đâu, nhưng...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560801
    m_Localized: 'Firefighter: Anh làm nó từ xác ong đấy. Lúc còn sống chắc chúng nó làm mật yêu đời lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560802
    m_Localized: 'Firefighter: Nóng vãi chưởng...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560803
    m_Localized: Trông anh thảm quá vậy
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560804
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560805
    m_Localized: 'Firefighter: Chú ơi... Chắc anh sắp... *khụ khụ*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560806
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560807
    m_Localized: 'Firefighter: Đúng ra anh phải ở lại. Có khi còn cứu thêm được vài người.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560808
    m_Localized: 'Firefighter: Anh lẽ ra phải ráng thêm... có làm đến kiệt sức cũng được. Như vậy thì mấy thằng sếp đã không đẩy các anh em vào chỗ chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560809
    m_Localized: 'Firefighter: ĐỊT MẸ *KHỤ* MẤY THẰNG SẾP! *KHỤ KHỤ*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560810
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560811
    m_Localized: 'Firefighter: Xót xa quá chú ạ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560812
    m_Localized: 'Firefighter: Chú cho anh xin một hơi cuối đời được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560813
    m_Localized: (Lấy điếu thuốc đưa cho anh ta)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560814
    m_Localized: 'Firefighter: Chú có điếu thuốc nào ở đấy không?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560815
    m_Localized: Không có anh ạ (không đưa thuốc lá)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560816
    m_Localized: 'Firefighter: Như con thiêu thân sa vào mồi lửa. *khụ*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560817
    m_Localized: 'Firefighter: (Anh lính lấy từ trong túi ra một chiếc bật lửa, châm thuốc và bắt đầu hút)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560818
    m_Localized: 'Firefighter: (Ảnh rít một hơi thuốc dài rồi ngả lưng vào tường. Một lúc sau, anh ta lại cất tiếng)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560819
    m_Localized: 'Firefighter: Bây giờ anh chỉ muốn được đoàn tụ với các anh em. Lại được hút thuốc, hàn huyên tâm s–'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560820
    m_Localized: 'Firefighter: *KHỤ KHỤ* *KHỤ KHỤ*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560821
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560822
    m_Localized: 'Firefighter: Chú không hút thuốc à?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560823
    m_Localized: 'Firefighter: Anh biết chú định nói gì rồi. "Lính cứu hỏa mà lại hút thuốc hả?" *khụ*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560824
    m_Localized: 'Firefighter: Quan trọng gì nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560825
    m_Localized: 'Firefighter: Trước khi chết thì làm tí *khụ* cho nó khoan khoái thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560826
    m_Localized: 'Firefighter: (Anh ta tựa lưng vào tường, mắt ngước nhìn lên trần rồi nói tiếp)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560827
    m_Localized: 'Firefighter: Chả hiểu sao anh lại đi làm cái nghề này nữa? Mẹ anh trước kia cứ khuyên đi làm nhà máy cho ổn định.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560828
    m_Localized: 'Firefighter: Chứ làm lính cứu hỏa mà để mà chết ngạt trong khói th–'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560829
    m_Localized: 'Firefighter: *KHỤ KHỤ* *KHỤ KHỤ*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560830
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560831
    m_Localized: "WheelChair: Lang thang phiêu bạt,\nước mình lạc trôi..."
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560832
    m_Localized: Ông đang tìm ai thế?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560833
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560834
    m_Localized: 'WheelChair: Tui có thằng bạn. Chơi từ hồi còn nối khố.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560835
    m_Localized: 'WheelChair: Cái xong nó bị tai nạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560836
    m_Localized: 'WheelChair: Người ta thuê nó đào cái gì trên núi á.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560837
    m_Localized: 'WheelChair: Hổng biết nó đào cái gì trên trển, mà nói thiệt tui cũng đéo quan tâm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755072
    m_Localized: 'WheelChair: Mà nó làm ăn kiểu gì xong gãy mẹ cái lưng luôn! Nằm bẹp dí mấy ngày!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755073
    m_Localized: 'WheelChair: Nó còng lưng còng cổ cày cuốc trên núi riết...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755074
    m_Localized: 'WheelChair: Thành ra mấy con hải âu mới tưởng cái... cái lưng nó... là... Ờ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755075
    m_Localized: 'WheelChair: Thôi nói huỵch toẹt ra luôn nha, hổng phải lưng mà là đít. MẤY CON CHIM BU VÔ ĐÍT NÓ LÀM TỔ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755076
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755077
    m_Localized: 'WheelChair: HÁ HÁ HÁ HÁ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755078
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755079
    m_Localized: 'WheelChair: À xin lỗi, mấy tiếng nói trong đầu tui nó bị xàm á. Hổng có gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755080
    m_Localized: 'WheelChair: Tụi nó kể tui nghe chuyện hài vui xỉu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755081
    m_Localized: "WheelChair: Lang thang phiêu bạt,\nước mình lạc trôi..."
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755082
    m_Localized: Ê... Ông có sao không đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755083
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755084
    m_Localized: 'WheelChair: Ừa ổn mà. Tui đang chờ mấy cái chân mọc lại thui.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755085
    m_Localized: 'WheelChair: Chân phải bắt đầu rục rịch rồi đó, coi nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755086
    m_Localized: 'WheelChair: Nên chắc tui cứ ở lại đây thêm xíu nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755087
    m_Localized: Ý tôi là... mấy giọng nói trong đầu ông ấy
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755088
    m_Localized: À vậy hả...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755089
    m_Localized: 'WheelChair: Kìa tui giỡn chơi thui mà! Sao ông hông cười?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755090
    m_Localized: 'WheelChair: Tưởng ông phải hiểu ý tui liền chớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755091
    m_Localized: 'WheelChair: Chắc tui giỡn hơi xàm...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755092
    m_Localized: 'WheelChair: Ủa chời, ông mới hỏi thăm tui đó hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755093
    m_Localized: 'WheelChair: Cám ơn nhe, ông dễ thương quá à!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755094
    m_Localized: 'WheelChair: Đó giờ có ai thèm mở miệng thăm hỏi tui một tiếng đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755095
    m_Localized: 'WheelChair: Chắc tại tui được ngồi xe lăn xịn xò phóng ào ào, còn tụi nó có mỗi con căng hải thui hay sao? Này là bịnh GHEN ĂN TỨC Ở phớ hơm?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755096
    m_Localized: 'WheelChair: Tui hỏi dị xong, hổng đứa nào dám trả lời thiệt tình hết. Vậy mới ghét chớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755097
    m_Localized: 'WheelChair: Tụi nó cứ bày đặt lý do lý trấu, kêu là chỉ dòm xíu thôi chớ hổng có ý gì. Này nọ lọ chai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755098
    m_Localized: 'WheelChair: Mà những lúc tụi nó cứ nhìn chằm chằm hổng nói hổng rằng, tui cũng thấy khó chịu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755099
    m_Localized: 'WheelChair: Nhưng cứ cố tình hổng đả động gì tới thì nó lại xàm lắm. Cái chân tật chình ình đây mà, sao mà lờ đi cho được.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755100
    m_Localized: 'WheelChair: Nói chung là đứng trước người khuyết tật, phải biết tế nhị một xíu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755101
    m_Localized: 'WheelChair: Mà thời buổi giờ, người ta chỉ có tế nhau chứ tế nhị cái mốc xì á! HỜ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755102
    m_Localized: 'WheelChair: Ê hỏi cái, có bao giờ ông tưởng tượng mình mà sống như loài rắn thì đi đứng kiểu gì hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755103
    m_Localized: 'WheelChair: Đậu, ý tui hông phải nói tâm địa độc ác gì...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755104
    m_Localized: 'WheelChair: ...Ý là sống mà hổng có chân á. Tại rắn thì... ờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755105
    m_Localized: 'WheelChair: Tui nói vậy ông hiểu hơm? Tới lúc đó thì lết ra khỏi nhà còn khó nữa là!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755106
    m_Localized: 'WheelChair: Vậy làm sao mà leo lầu? Rồi băng qua đường kiểu gì đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755107
    m_Localized: 'WheelChair: Ta nói, mấy cái lề đường đó gập ghềnh xiêu vẹo chết mẹ! Còn trắc trở hơn đường vô tim cờ-rớt nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755108
    m_Localized: 'WheelChair: Cũng hên là nhà ông hông có cầu thang, nên tui lăn qua lăn lại dễ dàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755109
    m_Localized: 'WheelChair: Nhưng mà tui thấy bị thiếu thiếu cái này... Ước gì ở đây có...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755110
    m_Localized: 'WheelChair: ...MỘT NGỌN ĐỒI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755111
    m_Localized: 'WheelChair: Má tưởng tượng thôi đã thấy phê đét rồi! Tha hồ đua xe lăn trên dốc! Đâm sấp mặt lờ vô tường luôn. HÁ HÁ! Mà thôi kệ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755112
    m_Localized: 'WheelChair: Trời má, thiệt tình, sao ông hổng thèm lắp thêm cái gì trong nhà cho tui thỏa cái máu ghiền đua xe lăn dị.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755113
    m_Localized: 'WheelChair: Ủa, xí quên, ông đang hỏi thăm tui mà ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755114
    m_Localized: 'WheelChair: Cũng cũng á. Cám ơn nhiều nhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755115
    m_Localized: "WheelChair: Lang thang phiêu bạt,\nước mình lạc trôi..."
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755116
    m_Localized: Ông có bị sốc nhiệt hay gì không vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755117
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755118
    m_Localized: 'WheelChair: Ủa mắc gì ông hỏi dị?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755119
    m_Localized: 'WheelChair: Tóc tui vẫn mượt như Sunsilk, chưa cháy cũng chưa rụng. Chứng tỏ còn ngon chán!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755120
    m_Localized: 'WheelChair: Bị cụt chân thì sao tui đua bằng xe lăn được. Ông thấy hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755121
    m_Localized: 'WheelChair: Đang lao như bay thì giảm tốc kiểu gì? Hay gặp khúc cua phải quẹo gấp thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755122
    m_Localized: 'WheelChair: Mà thôi, ông có xài xe lăn đâu mà hiểu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755123
    m_Localized: Ông tin chuyện đó thật hả?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755124
    m_Localized: Ông nghĩ cái chân ông sẽ mọc lại thật à?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755125
    m_Localized: 'WheelChair: Chớ sao!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755126
    m_Localized: 'WheelChair: Nè nhá, ông bà ta có câu:'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755127
    m_Localized: 'WheelChair: "Chân phải thì sải bước dài". Tại chân ai cũng lệch dị nên càng đi càng lòng vòng về chỗ cũ á.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755128
    m_Localized: 'WheelChair: Đó, chân tui là ví dụ trực quan sinh động luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755129
    m_Localized: 'WheelChair: Đời nó cứ như một vòng luẩn quẩn dị á. Hoài hoài hổng thoát ra được.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755130
    m_Localized: 'WheelChair: Hết một ngày, lại sang ngày mới. Nhưng khi mặt trời ló dạng ở đằng đông, liệu có gì thay đổi hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755131
    m_Localized: 'WheelChair: Chắc chắn là đéo rồi. Quanh đi quẩn lại cũng có nhiêu đó thôi. Xoay mòng mòng như chong chóng dị á!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755132
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755133
    m_Localized: 'WheelChair: Ê, nghĩ thử coi. Tính ra tui với ông cũng đâu khác nhau là mấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755134
    m_Localized: 'WheelChair: Cả hai đều kẹt dí trong cái vòng lặp quẩn quanh của cuộc đời.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755135
    m_Localized: 'WheelChair: Ông để ý đi, thế giới ngoài kia có biết bao điều kỳ diệu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755136
    m_Localized: 'WheelChair: Ờ thì tụi mình mới toàn gặp mấy thứ tai họa quỷ ma gì đâu. NHƯNG MÀ Á!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755137
    m_Localized: 'WheelChair: Sẽ có ngày những thảm kịch này chấm dứt. Rồi niềm vui rạng ngời sẽ tới thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755138
    m_Localized: 'WheelChair: Chúa đã tha thứ cho nhiều kẻ lầm lỡ rồi mà. Chắc ổng cũng đang chuẩn bị ngày mai tươi sáng cho tụi mình đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755139
    m_Localized: "WheelChair: Lang thang phiêu bạt,\nước mình lạc trôi..."
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755140
    m_Localized: Ông làm sao mà bị mất chân vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755141
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755142
    m_Localized: 'WheelChair: Nhớ thằng bạn trên núi tui kể ông hông? Cái thằng mà bị chim làm tổ trên đít á. HÁ HÁ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755143
    m_Localized: 'WheelChair: Thiệt ra... lúc đó nó tính đào hầm trong sân.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755144
    m_Localized: 'WheelChair: Nó khùng khùng hay sao á, kêu là dưới nhà nó chắc phải có nguyên một cái đường hầm chất đầy thịt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755145
    m_Localized: 'WheelChair: Xong nó chạy đi mua cái mũi khoan bự chà bá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755146
    m_Localized: 'WheelChair: Rồi nó cứ dị mà đào...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755147
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755148
    m_Localized: 'WheelChair: Chời đụ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755149
    m_Localized: 'WheelChair: Chắc đó là lần cuối tui gặp nó luôn á.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755150
    m_Localized: "WheelChair: Lang thang phiêu bạt,\nước mình lạc trôi..."
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755151
    m_Localized: Còn chuyện chân ông thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755152
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755153
    m_Localized: 'WheelChair: Chân cẳng gì kệ cha nó! Tui chỉ muốn biết thằng bạn tui rút cục có đào được tới đích hay hông thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755154
    m_Localized: Thôi khỏi, bỏ đi
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755155
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755156
    m_Localized: 'WheelChair: Ờ... Đúng rồi! Khi đó tui quên béng luôn vụ của nó, ra ngoài làm hớp bia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755157
    m_Localized: 'WheelChair: Xong đi đứng loạng quạng kiểu gì mà vấp phải đường ray, trượt té rồi bị xe lửa cán què chân luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755158
    m_Localized: 'WheelChair: Ủa mà khoan...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755159
    m_Localized: 'WheelChair: Đâu, có phải dị đâu ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755160
    m_Localized: 'WheelChair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755161
    m_Localized: 'WheelChair: Ủa sao ông im luôn rồi dị? Tưởng muốn biết sao tui cụt chân dữ lắm mà?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755162
    m_Localized: 'WheelChair: Thôi tui hông kể nữa đâu. Tự nhiên bắt ông nghe ba cái chuyện xàm xí đó làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755163
    m_Localized: 'Mother: Trong nhà bí thực sự...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755164
    m_Localized: Ủa, con chị đâu mất rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755165
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755166
    m_Localized: 'Mother: Hả? Nó còn đây mà. Chắc chỉ lòng vòng trong nhà thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755167
    m_Localized: 'Mother: Hổng biết mấy đứa kia giờ đang ở đâu nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755168
    m_Localized: 'Mother: Nhà em có điện thoại hông? Để chị gọi cho ba nó. Đỡ phải nhìn cái bản mặt xấu chó của chả.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755169
    m_Localized: 'Mother: Trong nhà bí thực sự...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755170
    m_Localized: Chị có gọi cho chồng chị chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755171
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755172
    m_Localized: 'Mother: Sao phải gọi? Kiểu gì thằng chả cũng lại lý do lý trấu. Ở nhà nó có động tay gì đâu. Từ vụ tiền nong, nhà cửa tới con cái, toàn chị lo chứ ai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755173
    m_Localized: 'Mother: Nhiều lúc chị thấy hai vợ chồng ráng chịu đựng nhau thôi chứ vui vẻ gì đâu. Chả hiểu sao thằng đó chưa bỏ chị mà đi nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755174
    m_Localized: 'Mother: Hổng lẽ nó thấy chị dễ dãi quá, hay sợ chị thọc cho lủng bụng nên mới hông dám?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755175
    m_Localized: 'Mother: Mệt ơi là mệt...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755176
    m_Localized: 'Mother: Trong nhà bí thực sự...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755177
    m_Localized: Thế chị đi gặp chồng chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755178
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755179
    m_Localized: 'Mother: Cái thân còn chả lết nổi khỏi giường thì đi đâu được hả em? Toàn đau nhức với mệt mỏi. Chị sống được tới giờ phút này vì cay thôi đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755180
    m_Localized: 'Mother: Hết chồng con rồi tới nhà cửa, chuyện gì cũng một tay chị lo. Nhưng lâu lâu thằng chả có để ý, quan tâm nên chị cũng nhẹ gánh đi được một xíu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755181
    m_Localized: 'Mother: Bữa sau mình nói tiếp được hông? Cho chị nghỉ xíu, sắp xỉu tới nơi rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755182
    m_Localized: 'Mother: Trong nhà bí thực sự...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755183
    m_Localized: Biết để ý, quan tâm là làm gì cơ chị?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755184
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755185
    m_Localized: 'Mother: Nhớ có cái lần...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755186
    m_Localized: 'Mother: Nó chở con đàn bà này đi chơi. Chị biết hết. Ban đầu chị nhẫn nhịn vậy thôi, nhưng cứ để yên hoài thì đâu có được.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755187
    m_Localized: 'Mother: Thế là chị cứ cằn nhằn bên tai chả riết... Xong chả cũng bỏ, kiếm việc khác để hông gặp con kia nữa... Chắc chả cũng thương chị thiệt tình đó ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755188
    m_Localized: 'Mother: Hoặc cái này là do chị tự suy diễn thôi... Kệ đi, nghỉ xíu đã. Lát rồi mình nói chuyện sau.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755189
    m_Localized: 'Mother: Trong nhà bí thực sự...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755190
    m_Localized: Mất con vậy mà chị không thấy lo à?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755191
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755192
    m_Localized: 'Mother: Hừm... Lo thì cũng lo nhưng hổng nhiều như người ta. Hồi mới đẻ đứa đầu... chị còn lóng ngóng lơ ngơ lắm. Đụng đâu là bể đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755193
    m_Localized: 'Mother: Qua đứa thứ hai cứ tưởng mình có kinh nghiệm rồi chớ. Nhưng mà rốt cuộc vẫn vậy. Rồi tới đứa thứ ba, thứ tư...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755194
    m_Localized: 'Mother: Bác sĩ từng nói chị hổng có con được. Bởi vậy hồi sinh được đứa thứ hai, chị mới nói nó là Kỳ Quan Thứ Tám Của Thế Giới luôn á!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755195
    m_Localized: 'Mother: Nhưng rồi... tình hình càng ngày càng khó khăn. Khổ lắm em ơi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755196
    m_Localized: 'Mother: Cho... Cho chị chợp mắt xíu nghen...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755197
    m_Localized: 'Mother: Trong nhà bí thực sự...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755198
    m_Localized: Chị bảo khổ chuyện gì cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755199
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755200
    m_Localized: 'Mother: Chuyện khó nói lắm. Chị thương con chị, nhưng mà... nhiều lúc chị cũng giận quá mất khôn. Cứ hay la rầy, có khi còn đánh tụi nó nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755201
    m_Localized: 'Mother: Chị cũng biết làm vậy là sai lắm chứ. Chị hối hận vô cùng... Nhưng bây giờ... Lần đầu tiên trong đời, chị mới thấy cuộc đời dễ thở.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755202
    m_Localized: 'Mother: Không có tụi nó ở đây, chị như trút được cả gánh nặng... Nói nghe hơi ác, nhưng mà cuối cùng chị cũng thấy được... hạnh phúc.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755203
    m_Localized: 'Anger: Cái địt con mẹ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755204
    m_Localized: Sao rồi? Bớt cáu chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755205
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755206
    m_Localized: 'Anger: Ừ, bớt bớt rồi. Cứ hễ nghĩ tới mấy chuyện bực mình là tôi lại muốn phát điên phát khùng lên.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755207
    m_Localized: 'Anger: Hồi trước tôi có vậy đâu, hiền lắm ấy chứ. Người ta chọc tức đến mấy tôi vẫn tỉnh bơ đó thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755208
    m_Localized: 'Anger: Mà giờ có mỗi chuyện bé tí ti cũng đủ làm tôi nổi cơn tam bành.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755209
    m_Localized: 'Anger: Sao phải bình tĩnh làm gì? Ai biết được, có khi phải cáu giận thì cái đầu tôi mới tỉnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755210
    m_Localized: 'Anger: Ít ra tôi chưa mụ mị đến độ tôn sùng mặt trời lên làm thánh, như mấy con lợn tà giáo ất ơ ngu học.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755211
    m_Localized: 'Anger: Bọn nó tưởng mặt trời sẽ cứu rỗi nhân loại? Ngáo hết phần chó! Nó hủy diệt MẸ loài người luôn thì có!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755212
    m_Localized: 'Anger: Mà giờ đằng buồi nào mình chả đi bán muối hết cả lũ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755213
    m_Localized: 'Anger: Nhưng địt mẹ cái lũ óc lợn đấy có hiểu đâu! Ngu ĐÉO thể tả nổi! Đây đây... tôi ổn, tôi bình tĩnh lại rồi đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755214
    m_Localized: 'Anger: Cảm ơn cậu đã nghe tôi xả nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755215
    m_Localized: 'Anger: Cái địt con mẹ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755216
    m_Localized: Sao lúc nào anh cũng giận điên lên thế?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755217
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755218
    m_Localized: 'Anger: Tiên sư nhà nó, đến tôi còn chả biết.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755219
    m_Localized: 'Anger: Giờ cái đéo gì cũng làm tôi phát cáu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755220
    m_Localized: 'Anger: Nhất là bè lũ tà giáo, mẹ cái bọn súc vật, miệng lưỡi không xương. Chúng nó chỉ rình để lừa càng nhiều người càng tốt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755221
    m_Localized: 'Anger: Bị lừa như thế mà vẫn có người tin sái cả cổ, lao vào như lũ lợn cắm đầu vào máng cám.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755222
    m_Localized: 'Anger: Bọn ngu này con đẻ thì đéo nuôi, lại đem cúng hết tiền nuôi lũ tà giáo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755223
    m_Localized: 'Anger: Tất cả chỉ để cung phụng thần linh cứu độ cứu thế đéo hiểu từ đâu chui ra nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755224
    m_Localized: 'Anger: Địt mẹ bọn lồn tà giáo. Mồm mép xảo quyệt tẩy não con người ta, gạt hết kẻ này đến kẻ nọ... rồi lừa cả...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755225
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755226
    m_Localized: 'Anger: Thôi, tôi cũng bớt bực rồi. Xả nãy giờ xong thấy sảng khoái hơn nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755227
    m_Localized: 'Anger: Cái địt con mẹ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755228
    m_Localized: Bọn tà giáo đã lôi kéo người thân của anh à?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755229
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755230
    m_Localized: 'Anger: Không, địt mẹ thế mới đau chứ. Là cổ tự nguyện đi theo chúng nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755231
    m_Localized: 'Anger: Vợ của tôi ý...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755232
    m_Localized: 'Anger: Trước giờ cô ấy vốn là người rất sùng đạo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755233
    m_Localized: 'Anger: Tôi yêu vợ, nên tôi chấp nhận điều đó. Chuyện cô ấy theo đạo chưa bao giờ chia cắt hai vợ chồng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755234
    m_Localized: 'Anger: Nhưng mà đang yên đang lành, tự dưng vợ tôi lại có niềm tin vào đấng cứu thế mới.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755235
    m_Localized: 'Anger: Chết dở một cái, bọn tà giáo lảm nhảm cái đéo gì là vợ tôi cũng răm rắp nghe theo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755236
    m_Localized: 'Anger: Càng ngày cổ càng lún sâu, lú mẹ cái đầu luôn. Hôm nào cũng nghe lũ chó đó tuyên truyền mấy thứ mê tín máu lồn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755237
    m_Localized: 'Anger: ...Lúc tôi nhận ra sai lầm của mình thì đã muộn rồi. Tôi dọa khiếp quá nên vợ bỏ nhà đi luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755238
    m_Localized: 'Anger: Cái địt con mẹ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755239
    m_Localized: Giữa anh và vợ đã có chuyện gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755240
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755241
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755242
    m_Localized: 'Anger: Một hôm nọ, vợ bảo với tôi là cô ấy muốn gia nhập bọn tà giáo đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755243
    m_Localized: 'Anger: Tôi... Tôi không thể tin nổi. Tình yêu của đời tôi... giờ đây đã biến thành người xa lạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755244
    m_Localized: 'Anger: Cổ sẵn sàng vứt bỏ tất cả những gì cùng tôi vun đắp, như cỏ rác. Tôi tức lắm, cả đời chưa từng điên máu đến như vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755245
    m_Localized: 'Anger: Tôi bắt đầu nghĩ quẩn, hay là cổ có yêu mình đéo đâu, mà chỉ mượn cớ để cuốn gói ra khỏi nhà. Càng nghĩ càng thấy buồn nôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755246
    m_Localized: 'Anger: Cứ như là tay tôi nó tự hành động vậy. Tự cuộn thành nắm đấm rồi làm chuyện tày trời... Suốt đời này tôi cũng chẳng thể tha thứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755247
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755248
    m_Localized: 'Anger: Tôi đã đánh vợ tôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755249
    m_Localized: 'Anger: Giờ tôi có muốn chuộc lỗi cũng quá muộn. Cô ấy đã theo lũ tà giáo, còn tôi thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755250
    m_Localized: 'Anger: Làm sao mà tôi chấp nhận được cơ chứ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755251
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755252
    m_Localized: 'Anger: ĐỊT MẸ NHÀ TÔI LUÔN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755253
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755254
    m_Localized: 'Anger: Tôi hành hạ bản thân như này còn tốt hơn là đi hành hạ người khác. Đáng đời mày, thằng đốn mạt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755255
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755256
    m_Localized: 'Anger: Cậu đi đi. Để cho tôi một mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755257
    m_Localized: 'FortuneTeller: Làm một quẻ không em?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755258
    m_Localized: Sao chị biết nhiều về tôi quá vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755259
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755260
    m_Localized: 'FortuneTeller: Ô! Em nói gì buồn cười thế. Chị chẳng biết gì đâu, chị chỉ là cái loa phường, truyền lại thông tin của các vì sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755261
    m_Localized: 'FortuneTeller: Mặt Trăng và Kim Tinh của em đang trùng tụ ở Nhà 6. Cái này nhìn mặt em là biết ngay, khỏi cần nói.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755262
    m_Localized: 'FortuneTeller: Chị từng quen một người giống như em. Anh ấy toàn lắng nghe mà chẳng bao giờ chia sẻ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755263
    m_Localized: 'FortuneTeller: Người ta thường bảo: Sao Thổ mà ở Nhà 8 thì nên giữ mồm giữ miệng. Đó là dấu hiệu của kẻ hay ôm chuyện trong lòng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755264
    m_Localized: 'FortuneTeller: Làm một quẻ không em?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755265
    m_Localized: Ông đó ra sao rồi vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755266
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755267
    m_Localized: 'FortuneTeller: Chị bảo hắn: "Anh làm gì không quan trọng, quan trọng là màu sắc trường năng lượng của anh vào thời điểm đó". Vậy mà hắn có tin đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755268
    m_Localized: 'FortuneTeller: Rồi đời hắn cứ thế mà trôi tuồn tuột đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755269
    m_Localized: 'FortuneTeller: Một ngày nọ, chị nhắm mắt rồi mường tượng viễn cảnh giấc mơ của chị thành sự thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755270
    m_Localized: 'FortuneTeller: Chị dốc hết năng lượng vũ trụ của mình vào hình ảnh đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755271
    m_Localized: 'FortuneTeller: Nếu không mở lòng đón nhận nguồn năng lượng ấy, thì ta còn sống trong cái cơ thể này làm gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755272
    m_Localized: 'FortuneTeller: Em cũng làm theo thử đi. Nào, nhắm mắt lại...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755273
    m_Localized: 'FortuneTeller: Tưởng tượng mọi mộng tưởng hoang đường nhất của mình biến thành hiện thực...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755274
    m_Localized: 'FortuneTeller: Tập trung vào viễn cảnh đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755275
    m_Localized: 'FortuneTeller: Em biết tại sao mình đau khổ không? Ấy là vì em chưa hiểu được, khổ đau chính là hình hài thuần khiết nhất của niềm vui.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755276
    m_Localized: 'FortuneTeller: Vậy nói chị nghe thử... em sẵn sàng thực hiện bước tiếp theo chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755277
    m_Localized: 'FortuneTeller: Làm một quẻ không em?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755278
    m_Localized: '"Bước tiếp theo" là gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755279
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755280
    m_Localized: 'FortuneTeller: Là lấy mình làm ưu tiên. Em ngửi thấy gì không? Mùi thối rữa từ những giấc mơ đã chết từ lâu của em đấy. Đã đến lúc đem chúng về cõi sống.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755281
    m_Localized: 'FortuneTeller: Khi chị kiệt quệ nhất, chẳng tìm thấy tia sáng hay ý nghĩa đời mình, cụ giáo chị bảo: "Con phải lắng nghe đại dương sâu thẳm trong con".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755282
    m_Localized: 'FortuneTeller: Ban đầu chị thấy vớ vẩn lắm, nhưng rồi sau đó chị nhắm mắt lại và nghe thử. Cứ như là nó luôn ở đó vậy. Em cũng nghe được đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755283
    m_Localized: 'FortuneTeller: Nhưng đầu tiên, em phải tự trả lời câu hỏi: Mình đã sẵn sàng hoà làm một với bản thân chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755284
    m_Localized: 'FortuneTeller: Làm một quẻ không em?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755285
    m_Localized: Cụ giáo chị là ai?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755286
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755287
    m_Localized: 'FortuneTeller: Một người phụ nữ tuyệt vời. Bà là ngọn hải đăng trong dông bão, soi đường chỉ lối để chị nhìn thấy căn nguyên mọi vấn đề.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755288
    m_Localized: 'FortuneTeller: Chị không bao giờ được quên lời dạy của bà: "Nhân loại chỉ chết đi vì họ chưa học được cách đón nhận ánh sáng nội tâm của mình".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755289
    m_Localized: 'FortuneTeller: Bà khai quang điểm nhãn cho chị, rồi đột nhiên chị thấy mình có thể dẫn dắt mọi người bước đi trên con đường riêng của họ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755290
    m_Localized: 'FortuneTeller: Nhưng bà chỉ dừng lại ở đó. Không dám tiến xa hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755291
    m_Localized: 'FortuneTeller: Bà không bao giờ xem mình là trung tâm của vạn vật, dù đó mới là điểm quan trọng nhất ta cần đạt đến.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755292
    m_Localized: 'FortuneTeller: Nếu ta không phải tâm điểm trong chính vũ trụ của mình, thì còn ai nữa? Em hiểu ý chị mà nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755293
    m_Localized: 'FortuneTeller: Làm một quẻ không em?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755294
    m_Localized: "Làm sao chị vực dậy\nbản thân được?"
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755295
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755296
    m_Localized: 'FortuneTeller: Mọi lỗi lầm chúng ta mắc phải đều là câu đố của thế giới nội tâm, đang chờ được giải mã.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755297
    m_Localized: 'FortuneTeller: Chị đã kinh qua một quãng đường dài mỏi mệt, luôn nhìn trước ngó sau. Cứ trông cách cái nhà này phản ứng với sự hiện diện của chị mà xem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755298
    m_Localized: 'FortuneTeller: Sáng sủa, rộng rãi, hòa hợp với năng lượng của chị. Đó, em không cần phải tìm cách chống lại tổ ấm của mình làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755299
    m_Localized: 'FortuneTeller: Nó đã hấp thụ nỗi sợ của em rồi, thấy không? Chấp nhận đi, không thì các bức tường sẽ than khóc. Sau cùng, chỉ có mình em rơi lệ mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755300
    m_Localized: 'FortuneTeller: Làm một quẻ không em?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755301
    m_Localized: Chị muốn gì ở tôi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755302
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755303
    m_Localized: 'FortuneTeller: Ơi là trời, em nghĩ chị muốn gì ở em à?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755304
    m_Localized: 'FortuneTeller: Em chỉ có thể tìm thấy con đường ẩn khi biết cảm nhận vẻ đẹp từ bóng tối của riêng mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755305
    m_Localized: 'FortuneTeller: Chỉ cần niệm vài câu khẳng định tích cực. Em cảm nhận được là mọi thứ đang thay đổi, đúng không? Không khí dễ thở hơn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755306
    m_Localized: 'FortuneTeller: Năng lượng của chị phản ứng với không gian của em đấy. Đừng truy cầu ý nghĩa sâu xa. Hãy buông bỏ vọng tưởng, đón chào hỗn loạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755307
    m_Localized: 'FortuneTeller: Nào, thực hành cùng chị đi. Hòa mình vào không gian. Hãy niệm: "Mình không phải là khách dừng chân, mà là chủ nhân của thánh địa này".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755308
    m_Localized: 'FortuneTeller: Làm một quẻ không em?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755309
    m_Localized: Nếu tôi chẳng muốn thành chủ nhân gì hết thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755310
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755311
    m_Localized: 'FortuneTeller: Bức tường này muốn ôm lấy em từ lâu, nhưng em lại trói buộc nó bằng xiềng xích uy quyền.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755312
    m_Localized: 'FortuneTeller: Sự câm lặng sâu thẳm trong em là tiếng lòng của thế giới mà em đã bóp nghẹt bằng chính nỗi sợ của mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755313
    m_Localized: 'FortuneTeller: Năng lượng của em đang đông cứng, tựa mật ngọt mùa đông. Em phải rã nó ra bằng hơi thở. Những tấm gương luôn phản chiếu sự thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755314
    m_Localized: 'FortuneTeller: Nếu em chỉ soi thấy bóng mình, thì xem như em chẳng thấy gì. Giờ em chỉ cần dịch chuyển năng lượng sang phải 3 độ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755315
    m_Localized: 'FortuneTeller: Và rồi cuối cùng, em sẽ tìm được niềm vui sống.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949449
    m_Localized: Vậy rồi làm sao mà cô bị mất nhà?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949450
    m_Localized: Tôi cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949451
    m_Localized: 'Anxiety: Ôiii... Chuyện này em nhớ rõ như mới đây vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949452
    m_Localized: 'Anxiety: Hôm đó em vừa bị đuổi việc. Chỉ muốn về nhà, leo lên giường, rồi nằm khóc hết nước mắt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949453
    m_Localized: 'Anxiety: Ngờ đâu, vừa về tới thì em thấy cả đống bốt để trước cửa. Cứ tưởng nhỏ cùng phòng rủ bạn qua chơi hay gì các thứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949454
    m_Localized: 'Anxiety: Thế là em bèn qua phòng nhỏ xem sao. Nhưng rồi lúc tới gần, em chợt nghe thấy tiếng gì lạ lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949455
    m_Localized: 'Anxiety: Làm em hoảng cả hồn. Thế rồi em, ừm, quyết định len lén nhìn thử một tí, để xem đang có chuyện gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949459
    m_Localized: 'Anxiety: Em muốn bỏ chạy lắm, nhưng sợ quá người cứ đờ ra... S-Sau đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949460
    m_Localized: 'Anxiety: Em... Hắn...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949461
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949462
    m_Localized: 'Anxiety: Em phải nằm nghỉ tí đã. Em... Em... Bụng dạ em cứ nhộn nhộn như muốn lộn ngược luôn rồi... Hự...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949464
    m_Localized: Rồi quay lại chuyện nhà cô, tiếp theo sao nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949465
    m_Localized: Tôi cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949466
    m_Localized: 'Anxiety: Ựa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949467
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949481
    m_Localized: Rồi chuyện gì xảy ra nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949482
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949483
    m_Localized: 'Anxiety: Em cũng không nhớ nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949484
    m_Localized: 'Anxiety: Chắc là em nằm ngất xỉu trên đường cả đêm, rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949485
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949487
    m_Localized: 'Anxiety: Từ từ, đừng nói là em...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949488
    m_Localized: 'Anxiety: Em...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949489
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949490
    m_Localized: 'Anxiety: Lẽ nào em lại là Dị Khách?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949491
    m_Localized: 'Anxiety: Đ-Đâu, làm sao mà vậy được!? Em... Em nhớ hết cuộc đời mình mà. Em có tuổi thơ, có cả bố cả mẹ. Không thể nào!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949492
    m_Localized: 'Anxiety: Sao em là Dị Khách được chứ nhỉ? Đúng không anh?! Anh nói đi, nói em không phải Dị Khách đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949493
    m_Localized: Tôi cũng chẳng biết nữa
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949494
    m_Localized: Cô không phải Dị Khách đâu
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949495
    m_Localized: Trông cô có vẻ giống Dị Khách lắm
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949496
    m_Localized: 'Anxiety: Lúc đó em nằm bất tỉnh dưới đất, rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949497
    m_Localized: 'Anxiety: Rồi sau đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949498
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949500
    m_Localized: 'Anxiety: Từ từ, đừng nói là em...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949501
    m_Localized: 'Anxiety: Em...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949502
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949503
    m_Localized: 'Anxiety: Lẽ nào em lại là Dị Khách?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949504
    m_Localized: 'Anxiety: Đ-Đâu, làm sao mà vậy được!? Em nhớ hết cuộc đời mình mà. Em có tuổi thơ, có cả bố cả mẹ. Không thể nào!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949505
    m_Localized: 'Anxiety: Sao em là Dị Khách được chứ nhỉ? Đúng không anh?! Anh nói đi, nói em không phải Dị Khách đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949506
    m_Localized: Tôi cũng chẳng biết nữa
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949507
    m_Localized: Cô không phải Dị Khách đâu
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949508
    m_Localized: Trông cô có vẻ giống Dị Khách lắm
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949509
    m_Localized: 'Anxiety: SAO ANH LẠI NÓI VẬY CHỨ?! Há há! Trời ơi, trời ơi, trời ơi trời, TRỜI ƠI LÀ TRỜI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949510
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949511
    m_Localized: 'Anxiety: Em... Em phải nằm nghỉ chút đây. Lại đau dạ dày nữa rồi, ựa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949512
    m_Localized: 'Anxiety: Cảm ơn anh, nghe xong em thấy đỡ hẳn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949513
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949514
    m_Localized: 'Anxiety: Ựa, phải nằm nghỉ chút đã. Lại đau dạ dày nữa rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949515
    m_Localized: 'Anxiety: SAO ANH LẠI NÓI VẬY CHỨ?! Há há! Nghe xong em còn hoảng hơn nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949516
    m_Localized: 'Anxiety: KHÔNG MUỐN CHẾT ĐÂU! KHÔNG MUỐN KHÔNG MUỐN KHÔNG MUỐN KHÔNG MUỐN KHÔNG MUỐN ĐÂU!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949517
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949518
    m_Localized: 'Anxiety: Thôi, ai rồi chẳng đến lúc chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949520
    m_Localized: Cô có sao không vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949521
    m_Localized: Tôi cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949522
    m_Localized: 'Anxiety: ĐỪNG CÓ LẠI GẦN TÔI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949523
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949524
    m_Localized: 'Anxiety: Xin lỗi, em... em tưởng anh định xử em luôn rồi chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949525
    m_Localized: Sao cô lại nghĩ như thế?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949526
    m_Localized: Tôi mà muốn xử cô thật thì đã xử từ lâu rồi
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949527
    m_Localized: 'Anxiety: Em...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949528
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949529
    m_Localized: 'Anxiety: Giờ em chả biết ai người ai Dị Khách nữa... Rồi ngộ nhỡ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949530
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949531
    m_Localized: 'Anxiety: Nhỡ đâu ANH cũng là Dị Khách thì sao?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949535
    m_Localized: Bình tĩnh đi, tôi có phải Dị Khách đâu
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949536
    m_Localized: Tôi không giết cô đâu mà lo
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949537
    m_Localized: 'Anxiety: X-Xin lỗi, tại em đang, h-hoảng hết thần hồn...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949538
    m_Localized: 'Anxiety: Giờ em chả biết phải tin ai nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949539
    m_Localized: 'Anxiety: Rồi ngộ nhỡ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949540
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949541
    m_Localized: 'Anxiety: Nhỡ đâu anh cũng là Dị Khách thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949545
    m_Localized: Bình tĩnh đi, tôi có phải Dị Khách đâu
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949546
    m_Localized: Tôi không giết cô đâu mà lo
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949547
    m_Localized: 'Anxiety: SAO MÀ BIẾT CHẮC ĐƯỢC?! Đ-Đã kiểm tra răng mắt của anh bao giờ đâu... Ha ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949548
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949549
    m_Localized: 'Anxiety: Sắp đi đời hết cả lũ rồi... Không phải Dị Khách thì cũng là mặt trời thiêu chết thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949551
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949552
    m_Localized: 'Anxiety: Xin anh hãy để em một mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949553
    m_Localized: 'Anxiety: SAO MÀ BIẾT CHẮC ĐƯỢC?! Đ-Đã kiểm tra răng mắt của anh bao giờ đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949554
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949555
    m_Localized: 'Anxiety: Sắp đi đời hết cả lũ rồi... Không phải Dị Khách thì cũng là mặt trời thiêu chết thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949557
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949558
    m_Localized: 'Anxiety: Xin anh hãy để em một mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949560
    m_Localized: Cô bị làm sao vậy hả?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949561
    m_Localized: Tôi cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949564
    m_Localized: 'Anxiety: DỊ KHÁCH HAY CON NGƯỜI... CÓ KHÁC GÌ ĐÂU?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949565
    m_Localized: 'Anxiety: NẰM XANH CỎ RỒI THÌ AI MÀ CHẢ NHƯ NHAU!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949569
    m_Localized: Cô mất trí luôn rồi hả?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949576
    m_Localized: Cô đã ra nông nỗi này thì đành vậy
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949583
    m_Localized: Cô đã ra nông nỗi này thì đành vậy
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949584
    m_Localized: 'Anxiety: K-Không, mi chả hiểu cái thá gì hết!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949587
    m_Localized: Tha mạng
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949588
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949589
    m_Localized: 'Anxiety: Bắn đi! BẮN ĐI CHỨ! Còn chần chừ gì nữa?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949590
    m_Localized: 'Anxiety: ĐỂ XEM MI CÓ GAN GIẾT TA MÀ CHẲNG CHÚT ĂN NĂN KHÔNG NÀO?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949591
    m_Localized: 'Anxiety: MUỐN LÀM GÌ THÌ LÀM ĐI, CON NGƯỜI Ạ! Ta cóc quan tâm! Há há há!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949592
    m_Localized: Tha mạng
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949593
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949594
    m_Localized: 'Esenin: Sao đấy? Chú cần gì à?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949595
    m_Localized: Lý do gì người ta đuổi anh khỏi quán bar vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949596
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949597
    m_Localized: 'Esenin: Hừm. Tại thảm họa cứ nối đuôi nhau mà ập tới, thành ra ai nấy cũng mất trí hết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949598
    m_Localized: 'Esenin: Hết mặt trời đe dọa nổ tung bất cứ lúc nào, rồi tới bọn Dị Khách xâm lấn, kinh tế thì khủng hoảng, vân vân và mây mây.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949599
    m_Localized: 'Esenin: Làm con người ta không khùng cũng điên. Người thì gục ngã trước áp lực. Kẻ lại chìm vào men say để giải sầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949600
    m_Localized: 'Esenin: Nhưng còn tôi ấy hả? Tôi thì phẫn quá hóa rồ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949601
    m_Localized: 'Esenin: Tức mình, tôi trèo lên quầy bar rồi quát tháo: "Cái mẹ gì cũng đổ thừa hoàn cảnh, còn thân mình đây sao không đổ đi này!"'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949602
    m_Localized: 'Esenin: Muốn khóc thì khóc to lên. Bia đẫm nước mắt cũng không phai vị đâu. Mạch nha với hoa bia uống mặn càng ngon đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949603
    m_Localized: 'Esenin: Chậc, dù sao cũng đâu ai biết thưởng thức.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949604
    m_Localized: 'Esenin: Sao đấy? Chú cần gì à?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949605
    m_Localized: Anh thấy ở đây có tốt hơn không?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949606
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949607
    m_Localized: 'Esenin: Giờ tôi chẳng buồn quấy rầy ai nữa. Thấy cũng chả đáng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949608
    m_Localized: 'Esenin: Nhưng mỗi khi nghe tiếng người nói chuyện hay tiếng TV, cứ như có công tắc bật lên trong đầu tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949609
    m_Localized: 'Esenin: ...Rồi tôi tự kiềm chế lại. Có được gì đâu mà phải mất công.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949610
    m_Localized: 'Esenin: Dẹp, mệt mỏi lắm rồi. Dây thần kinh tôi bị hành hạ tra tấn nhiêu đó là quá đủ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949611
    m_Localized: 'Esenin: Đời trước giờ chưa đủ khổ sao mà còn...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949612
    m_Localized: 'Esenin: Rồi sẽ có ngày tôi treo mình tự vẫn lên chiếc đèn chùm, lặng nhìn thế gian gột rửa mọi tội lỗi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949613
    m_Localized: 'Esenin: Sao đấy? Chú cần gì à?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949614
    m_Localized: Vẫn ổn chứ anh?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949615
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949616
    m_Localized: 'Esenin: Hửm? Sao tự nhiên chú hỏi vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949617
    m_Localized: Tôi ngửi thấy anh có mùi gì là lạ
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949618
    m_Localized: Anh đang bị sốt à?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949619
    m_Localized: 'Esenin: À... Nãy tôi có nốc vài lon bia của chú.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949620
    m_Localized: 'Esenin: Thấy trong người không khỏe nên làm tí bia lạnh thay thuốc ấy mà. Có gì sai đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949621
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949622
    m_Localized: 'Esenin: Khốn thật chứ... Tình cảnh sao mà bi đát vãi lồn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949623
    m_Localized: 'Esenin: Ai cũng nói là đang tìm hiểu tình hình, ứng phó vấn đề... bốc phét thì giỏi. Rồi đâu vẫn hoàn đấy thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949624
    m_Localized: 'Esenin: Tôi nói thật chú nghe, anh bạn hiền, nhìn là biết sắp chết hết cả lũ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949625
    m_Localized: 'Esenin: Không đi đời dưới ánh mặt trời thì cũng thí mạng cho bọn Dị Khách. Mà có diệt được nó đi nữa thì cũng tự đào mồ chôn sống mình thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949626
    m_Localized: 'Esenin: Giải quyết xong một mối họa thì lại thấy thiếu thiếu gì đó. Thế là ta tự bày ra họa mới để mà lấp đầy khoảng trống.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949627
    m_Localized: 'Esenin: Con người là vậy đấy, cứ thích đái vào chân mình, như một căn bệnh nan y hết thuốc chữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949628
    m_Localized: 'Esenin: Mẹ nó chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949629
    m_Localized: 'Esenin: Thôi chú đi chỗ khác đi. Tôi mắc nôn lắm rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949630
    m_Localized: 'Esenin: Chả phải tôi đâu. Mà chính cái Quả Đất chết tiệt này mới là thứ đang sốt sùng sục đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949631
    m_Localized: 'Esenin: Nhìn đi đâu cũng thấy người chết như rạ. Băng thì tan, rừng thì cháy. Cả thế giới đang chìm trong biển lửa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949632
    m_Localized: 'Esenin: Hành tinh này muốn rũ bỏ đám nhân loại lúc nhúc trên nó như lũ chấy rận ký sinh lắm rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949633
    m_Localized: 'Esenin: Rồi cũng tới ngày nó rũ được thôi chú ạ. Và đừng hòng có chuyện chúng ta ra đi thanh thản.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949634
    m_Localized: 'Esenin: Ựaaaaaa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949635
    m_Localized: 'Esenin: Chú đi cho khuất mắt giùm được không. Tôi đang mệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949636
    m_Localized: 'Esenin: Sao đấy? Chú cần gì à?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949637
    m_Localized: Anh thấy đỡ hơn chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949638
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949639
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949640
    m_Localized: 'Esenin: Anh bạn hiền à...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949641
    m_Localized: 'Esenin: Ai rồi cũng phải tới lúc xuống mồ thôi. Số phận không thể tránh khỏi rồi mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949642
    m_Localized: 'Esenin: Chú nghĩ sau khi chết thì mình đi về đâu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949643
    m_Localized: Chỉ cần có lòng tin, thần linh sẽ đưa ta về chốn an lạc
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949644
    m_Localized: Hư vô
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949645
    m_Localized: Không biết nữa, chắc là trôi nổi trong không gian vô định
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949646
    m_Localized: 'Esenin: Nghe cũng đáng mong chờ đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949647
    m_Localized: 'Esenin: Nhưng tôi chẳng thấy được an ủi tí nào. Biết tại sao không?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949648
    m_Localized: 'Esenin: Vì ở phút lâm chung, tâm trí tôi sẽ hướng về tia sáng đó. Nó cho tôi thấy ảo ảnh thiên đường, một nơi tốt đẹp hơn nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949649
    m_Localized: 'Esenin: Rồi khi tôi không còn chút hơi tàn để níu lấy giấc mộng mong manh ấy... thì sẽ ra sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949650
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949651
    m_Localized: 'Esenin: Không. Thực sự chẳng thấy khá hơn tẹo nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949652
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949653
    m_Localized: 'Esenin: Tôi đã thầm mong chú sẽ nói câu gì khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949654
    m_Localized: 'Esenin: Ừ, có khi đúng là thế thật. Nhưng nghe sao mà buồn thảm quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949655
    m_Localized: 'Esenin: Sau tất cả, sao bao nhiêu thương đau, chẳng còn gì chờ đợi ta ở phút cuối. Chỉ có bóng tối mịt mù...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949656
    m_Localized: 'Esenin: Tự nhiên mất hứng nói chuyện luôn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143680
    m_Localized: 'Esenin: Chú thử nghĩ mà xem...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143681
    m_Localized: 'Esenin: Có lẽ chúng ta hoàn toàn đơn độc trong vũ trụ bao la này.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143682
    m_Localized: 'Esenin: Rõ ràng đâu có dấu hiệu sự sống nào khác. Toàn là không gian lạnh lẽo, vắng lặng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143683
    m_Localized: 'Esenin: Bởi nếu có thì ta đã nhận được tín hiệu hay thông điệp gì rồi chứ? Chẳng biết nữa chú à...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143684
    m_Localized: 'Esenin: Một khoảng không trống trải, bóng tối bao trùm vô cùng tận... Tới đó cũng chẳng khác gì tan biến thành hư vô.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337984
    m_Localized: 'Esenin: Tôi... Thôi tôi muốn ở yên một mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337985
    m_Localized: 'Esenin: Sao đấy? Chú cần gì à?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337986
    m_Localized: Anh... có ổn không?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337987
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337988
    m_Localized: 'Esenin: Ít ra ở quán bar người ta còn có cái trần cao.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337989
    m_Localized: 'Esenin: Thắt dây treo cổ từ đó thì dễ biết mấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337990
    m_Localized: 'Esenin: Ở đây tôi thấy chật chội quá. Sống trên đời này tôi thấy sao mà ngột ngạt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337991
    m_Localized: 'Esenin: Anh bạn hiền à, tôi chỉ muốn mọi chuyện chấm dứt cho xong.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337992
    m_Localized: 'Esenin: Thế giới đảo điên vãi lồn. Cái gì cũng làm tôi sợ điếng người.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337993
    m_Localized: 'Esenin: Tôi thực sự chịu hết nổi rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337994
    m_Localized: 'Esenin: Chẳng biết mình tới đây làm cái gì nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337995
    m_Localized: 'Widow: Mệt quá rồi, phải nghỉ xíu thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337998
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337999
    m_Localized: 'Widow: Ảnh sống.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338000
    m_Localized: 'Widow: Tôi cần ảnh sống...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338001
    m_Localized: 'Widow: Chỉ có vậy thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338004
    m_Localized: 'Widow: Chắc tôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338005
    m_Localized: 'Widow: ...ngồi kế vòi nước là được.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338006
    m_Localized: 'Widow: Có gì uống mấy ngụm ở đó luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338009
    m_Localized: 'Widow: Tôi chả thấy đói.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338010
    m_Localized: 'Widow: Tôi chỉ muốn...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338011
    m_Localized: 'Widow: ...ngồi nghỉ xíu thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338014
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338015
    m_Localized: 'Widow: Sao anh lại phải chết kia chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338016
    m_Localized: 'Widow: Anh đã hứa với em là mọi chuyện sẽ qua mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338017
    m_Localized: 'Widow: Rồi anh còn nói là sau cơn mưa, trời lại sáng nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338018
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338019
    m_Localized: 'Widow: Nhưng anh đi rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338020
    m_Localized: 'Widow: Để lại mình em bơ vơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338021
    m_Localized: 'Widow: Sao anh lại nỡ bỏ em một mình?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338022
    m_Localized: 'Widow: Tôi chỉ muốn có ảnh bên cạnh mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338025
    m_Localized: 'Widow: Chôn cất...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338026
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338029
    m_Localized: 'Widow: Mệt quá rồi, phải nghỉ xíu thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338040
    m_Localized: 'Widow: Không...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338041
    m_Localized: 'Widow: Không, không, KHÔNG ĐƯỢC!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338042
    m_Localized: 'Widow: Tôi chưa sẵn sàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338043
    m_Localized: 'Widow: Tới bây giờ tụi nó mới chịu trả chồng cho tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338044
    m_Localized: 'Widow: Mà cậu lại nói tôi phải rời xa ảnh hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338045
    m_Localized: 'Widow: Không được.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338046
    m_Localized: 'Widow: Có chết tôi cũng không bỏ mặc ảnh trơ trọi dưới nền đất lạnh lẽo kia đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338047
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338048
    m_Localized: 'Widow: Không.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338049
    m_Localized: 'Widow: Cậu sai rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338050
    m_Localized: 'Widow: Ảnh còn nghe được tiếng tôi mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338051
    m_Localized: 'Widow: Tôi vẫn...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338052
    m_Localized: 'Widow: Vẫn muốn tin... là ảnh còn nghe được.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338053
    m_Localized: 'Widow: Mệt quá rồi, phải nghỉ xíu thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338056
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338067
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338071
    m_Localized: 'Widow: Mệt quá rồi, phải nghỉ xíu thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338077
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338083
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338093
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338096
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338098
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338106
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338108
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338112
    m_Localized: 'Widow: Mệt quá rồi, phải nghỉ xíu thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532293
    m_Localized: 'Neighbour: Trời đất... Hóa ra là tin chuẩn hết à...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532294
    m_Localized: 'Neighbour: Tính ra mấy cái bác nói đều hợp lý hết ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532295
    m_Localized: 'Neighbour: Sáng con đừng có ra đường. Còn tối thì nhớ cho người khác vào nhà nha con.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532296
    m_Localized: Sao tự dưng con cho người lạ vào nhà làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532297
    m_Localized: Cho người ta vào nhà ấy ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532298
    m_Localized: 'Neighbour: Ừ, bác biết con muốn giữ khoảng cách với người khác. Nhưng bắt buộc phải làm thôi con.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532299
    m_Localized: 'Neighbour: Người bà con của bác không chắc là mình có nên cố thủ trong nhà hay hông...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532300
    m_Localized: 'Neighbour: Nhưng người ta dặn là nếu có ai hỏi con có ở nhà một mình hông, thì nhớ nói là trong nhà có người rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532301
    m_Localized: Con ghét giao thiệp với người khác lắm
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532302
    m_Localized: Sao nhà phải có nhiều người làm gì ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532303
    m_Localized: 'Neighbour: Ừ bác hiểu mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532304
    m_Localized: 'Neighbour: Bác cũng biết là con hổng ưa gì vụ tiếp khách lắm. Nhưng phải cho họ vào nhà mới được.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532305
    m_Localized: 'Neighbour: Bà con của bác không chắc là mình có nên cố thủ trong nhà hay không...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532306
    m_Localized: 'Neighbour: Nhưng người ta dặn là nếu có ai hỏi con có ở nhà một mình hông, thì nhớ nói là trong nhà có người rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532307
    m_Localized: Con ghét giao thiệp với người khác lắm
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532308
    m_Localized: Sao nhà phải có nhiều người làm gì ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532309
    m_Localized: 'Neighbour: Bác cũng hiểu là khó cho con lắm, nhưng ráng chịu thôi con. Phải vậy mình mới sống sót được.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532310
    m_Localized: 'Neighbour: Với lại, biết đâu người ta còn mang đồ hữu ích, hay chia sẻ cho con mấy thông tin giá trị thì sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532311
    m_Localized: 'Neighbour: Nhớ kiểm tra dấu hiệu của Dị Khách nữa nha. Sáng nóng hầm hầm như vầy thì con cũng hổng có mấy năng lượng đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532312
    m_Localized: 'Neighbour: Nên con phải chọn đúng người để kiểm cho thiệt kỹ. Soi từng ngóc ngách luôn. Làm mấy cái này tốn công tốn sức dữ lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532313
    m_Localized: 'Neighbour: Nhưng mà nói chuyện thì thoải mái nha con. HỔNG có tốn năng lượng đâu, nên cứ tám thả cửa hén.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532314
    m_Localized: 'Neighbour: Với đừng quên thường xuyên kiểm tra cửa sổ. Nghe thời sự cũng tốt đó, nhưng mà trăm nghe không bằng một thấy đâu con.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532315
    m_Localized: Rồi sao nữa ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532316
    m_Localized: Thế mình phải làm gì hả bác?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532317
    m_Localized: 'Neighbour: Mấy người con cho vào nhà có khi mang đồ hữu ích, hay chia sẻ thông tin giá trị á.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532318
    m_Localized: 'Neighbour: Con nhớ kiểm tra dấu hiệu của Dị Khách nữa nha. Sáng nóng hầm hầm như vầy thì con cũng hổng có mấy năng lượng đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532319
    m_Localized: 'Neighbour: Nên con phải chọn đúng người để kiểm cho thiệt kỹ. Soi từng ngóc ngách luôn. Làm mấy cái này tốn công tốn sức dữ lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532320
    m_Localized: 'Neighbour: Nhưng mà nói chuyện thì thoải mái nha con. HỔNG có tốn năng lượng đâu, nên cứ tám thả cửa hén.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532321
    m_Localized: 'Neighbour: Với đừng quên thường xuyên kiểm tra cửa sổ. Nghe thời sự cũng tốt đó, nhưng mà trăm nghe không bằng một thấy đâu con.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532322
    m_Localized: Rồi sao nữa ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532323
    m_Localized: Thế mình phải làm gì hả bác?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532324
    m_Localized: 'Neighbour: Bây giờ chỉ còn cách ráng mà sống sót thôi con. Được ngày nào hay ngày nấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532325
    m_Localized: 'Neighbour: Rồi cầu cho cơn ác mộng này sớm kết thúc.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532326
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532327
    m_Localized: 'Neighbour: Chắc kiểu gì nhà nước cũng tìm cách hỗ trợ mình thôi. Biết đâu người ta sẽ dắt mình vào hầm trú ẩn hay gì đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532328
    m_Localized: 'Neighbour: Tới lúc đó thì con cứ ở cạnh gia đình bác, nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532329
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532330
    m_Localized: 'Neighbour: Ấy, xém tí thì quên.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532331
    m_Localized: 'Neighbour: Tối mai bác phải về rồi. Nên con cầm số của bác đi ha, cần gì cứ gọi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532332
    m_Localized: 'Neighbour: Hôm trước người ta mới lắp đặt đường dây điện thoại xong.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532333
    m_Localized: 'Neighbour: XXX-XXX-XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532334
    m_Localized: 'Neighbour: Nhớ giữ liên lạc thường xuyên nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532335
    m_Localized: 'Neighbour: Rồi, đại khái nhiêu đó thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532336
    m_Localized: 'Neighbour: À mà bác có đem cho con két bia nè. Anh em bạn rể bác làm bên nhà máy bia đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532337
    m_Localized: 'Neighbour: Nhớ làm một lon trước khi lên giường nằm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532338
    m_Localized: 'Neighbour: Uống xong là buồn ngủ liền. Hôm nào chán hổng muốn nói chuyện nữa, con cứ quất lon bia lạnh rồi lăn ra nghỉ là được.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532339
    m_Localized: 'Daughter: Con... Con m-muốn m-mẹ con.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532340
    m_Localized: Kể cho chú nghe từ đầu đi con
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532341
    m_Localized: Chú cần kiểm tra con
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532342
    m_Localized: 'Daughter: Con hổng biết nữaaaaaa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532343
    m_Localized: 'Daughter: Tụi đó vô nhà rồi nói chuyện, xong ba kêu mấy người sai rồi, rồi mấy người đó nói... nói...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532344
    m_Localized: 'Daughter: BA ƠI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532345
    m_Localized: 'Daughter: BAAA ƠIII!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532346
    m_Localized: Thôi... Giờ con cứ nghỉ ngơi đi đã
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532347
    m_Localized: Để có gì mai hai chú con mình nói tiếp, nhé?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532348
    m_Localized: 'Daughter: (Con bé nức nở gọi ba không ngừng. Chẳng biết khi nào mới bình tĩnh nổi nữa)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532349
    m_Localized: 'Daughter: (Giờ bé chẳng buồn nghe bạn nói nữa. Chỉ biết chìm đắm trong nỗi đau cùng cực)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532350
    m_Localized: 'Daughter: Con... Con m-muốn m-mẹ con.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532351
    m_Localized: Sao rồi con? Con thấy ở đây có ổn không?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532352
    m_Localized: Chú cần kiểm tra con
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532353
    m_Localized: 'Daughter: Ừm... Ở đây cũng được được.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532354
    m_Localized: 'Daughter: Nhưng mà con muốn về nhà chú ơi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532355
    m_Localized: 'Daughter: Chừng nào con mới được về hả chú?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532356
    m_Localized: Chắc phải đợi chút nữa đó... Vì nhà con đang sửa rồi
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532357
    m_Localized: Sắp tới thì không được đâu. Nhà con cháy rụi rồi
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532358
    m_Localized: 'Daughter: Dạ... Vậy thì ba mẹ sẽ qua rước con mà ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532359
    m_Localized: 'Daughter: Rồi ba mẹ sẽ dắt con qua nhà mới ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532360
    m_Localized: 'Daughter: Hay là dắt con về nhà cũ ở ta?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532361
    m_Localized: 'Daughter: Hổng biết ba mẹ có xây phòng mới cho con hông nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532362
    m_Localized: 'Daughter: Ba vẫn sẽ qua đón con mà ha chú?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532363
    m_Localized: Con à... Con thấy hết rồi đấy...
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532364
    m_Localized: Giờ tạm thời con cứ ở lại nhà chú đã
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532365
    m_Localized: 'Daughter: Dạ, nhưng mà ba đâu có sao đâu ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532366
    m_Localized: 'Daughter: Hổng biết phòng con giờ nó sao rồi? Cũng bị cháy đen thui luôn hả ta?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532367
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532368
    m_Localized: 'Daughter: Mẹ con hông qua hả chú?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532369
    m_Localized: 'Daughter: Bộ hổng còn ai nữa sao chú?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532370
    m_Localized: Con à... Con thấy hết rồi đấy...
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532371
    m_Localized: Giờ tạm thời con cứ ở lại nhà chú đã
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532372
    m_Localized: 'Daughter: Con... Con hổng biết nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532373
    m_Localized: 'Daughter: Kiểu ý là, con hổng có chắc lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532374
    m_Localized: 'Daughter: Tụi nó đánh ba, nhưng rồi ba ngồi dậy mà. Con thấy đàng hoàng mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532375
    m_Localized: 'Daughter: Mà vậy tức là... tức là có khi ba dập được lửa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532376
    m_Localized: 'Daughter: Hay đang đi kiếm con đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532377
    m_Localized: 'Daughter: Ba sắp tới chưa chú?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532378
    m_Localized: 'Daughter: Hông có ba thì con hổng đi đâu đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532379
    m_Localized: 'Daughter: Ba sẽ qua rước con mà ha chú?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532380
    m_Localized: 'Daughter: Con thấy ba đứng dậy rồi đi mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532381
    m_Localized: 'Daughter: Lúc đó con đang chạy đi, nhưng con có thấy ba rõ ràng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532382
    m_Localized: 'Daughter: Con... Con m-muốn m-mẹ con.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532383
    m_Localized: Con phải chấp nhận sự thật đi
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532384
    m_Localized: Chú cần kiểm tra con
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532385
    m_Localized: 'Daughter: Ủa chú nói dị là sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532386
    m_Localized: 'Daughter: Con thấy trong phòng chú có TV á. Cho con coi ké hoạt hình với nha?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532387
    m_Localized: Chú không biết con đã thấy gì. Nhưng có lẽ ba con chết rồi
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532388
    m_Localized: Chắc ba không qua đón con đâu. Chú chẳng biết ba con sao rồi nữa
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532389
    m_Localized: 'Daughter: Chú có thấy gì đâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532390
    m_Localized: 'Daughter: Con thấy, con ở đó mà! Lúc chạy đi con thấy ba cử động đàng hoàng mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532391
    m_Localized: 'Daughter: Tức là kiểu gì ba cũng qua đón con liền à!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532392
    m_Localized: Vậy sao giờ ba còn chưa qua đón con nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532393
    m_Localized: Lần cuối con thấy ba thì ba con trông như nào?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532394
    m_Localized: 'Daughter: Ý là ba hổng qua đón con được nữa hả? S-Sao chú lại nói dị?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532395
    m_Localized: Vậy sao giờ ba còn chưa qua đón con nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532396
    m_Localized: Lần cuối con thấy ba thì ba con trông như nào?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532397
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532398
    m_Localized: 'Daughter: Ừm... Chắc tại ba có công chuyện gì thôi á.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532399
    m_Localized: 'Daughter: Có khi giờ ba đang đánh tụi xấu xa kia tơi bời luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532400
    m_Localized: 'Daughter: Ba... Chắc ba sắp qua đây rồi đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532401
    m_Localized: Chú rất tiếc chuyện ba con. Bác ấy quá đỗi nhân hậu. Thế giới này không xứng có được bác
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532402
    m_Localized: Ừ, chuẩn, cá với con là ba đang trên đường tới rồi đó
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532403
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532404
    m_Localized: 'Daughter: Ba tốt lắm lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532405
    m_Localized: 'Daughter: Tụi nó đánh ba... rồi ba...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532406
    m_Localized: 'Daughter: Con hổng nhớ nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532407
    m_Localized: Chú rất tiếc chuyện ba con. Bác ấy quá đỗi nhân hậu. Thế giới này không xứng có được bác
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532408
    m_Localized: Ừ, chuẩn, cá với con là ba đang trên đường tới rồi đó
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532409
    m_Localized: 'Daughter: (Cô bé nhìn bạn mà ánh mắt như xa vạn dặm. Bạn chẳng dám nhúc nhích, chỉ chờ xem có gì xảy ra không)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532411
    m_Localized: 'Daughter: (Nhưng còn hơn là để nó tin vào điều không tưởng. Nó nên học cách chấp nhận sự thật càng sớm càng tốt)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532412
    m_Localized: 'Daughter: Con cũng nghĩ dị á.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532413
    m_Localized: 'Daughter: (Bạn thấy đầu óc cô bé để đi đâu ấy. Rõ ràng là đang nghĩ ngợi chuyện khác rồi)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532414
    m_Localized: 'Daughter: (Chuyện này có đáng để hủy hoại đời con bé không? Chắc gì nó đã chịu được tin dữ này?)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532415
    m_Localized: 'Daughter: (Thôi, bạn quyết rằng bé nó đã đủ chuyện phải lo rồi. Không cần khiến nó khổ thêm nữa)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532416
    m_Localized: 'NotTrue: Ôi, ngoại già lọm khọm lắm rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532417
    m_Localized: Bà quê ở đâu vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532418
    m_Localized: Cháu cần kiểm tra bà
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532419
    m_Localized: 'NotTrue: Ừ, đúng... nhưng như thế có sao đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532420
    m_Localized: 'NotTrue: Con nít con nôi, cứ đòi ngoại kể chuyện, nghe chán chê thì lại quay ra ghét ngoại. Giời ạ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532421
    m_Localized: 'NotTrue: Hừ, cháu nghĩ mà xem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532422
    m_Localized: 'NotTrue: Ngoại có một tổ ấm. Một căn chòi nhỏ nhoi, dung dị, cũ kỹ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532423
    m_Localized: 'NotTrue: Ngoại thích ở đó lắm. Nhưng chẳng có ai ghé thăm thì ngoại héo rụm, úa tàn mất thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532424
    m_Localized: 'NotTrue: Mà ai đời lại ghé vào một căn chòi cũ nát thế chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532425
    m_Localized: 'NotTrue: Nên ngoại mới đi lang thang hết chỗ này đến chỗ kia. Có còn gì để mà mất đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713862
    m_Localized: 'NotTrue: Ngoại là dân thành thị chính gốc, cháu ơi. Sống trong một túp lều tranh trên tầng cao.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713863
    m_Localized: 'NotTrue: Chẳng có mái nhà bé xinh ở thôn làng, chẳng có lão chồng già cáu kỉnh, hay lũ cháu chắt lóc chóc loi choi nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713864
    m_Localized: 'NotTrue: Nên ngày nào ngoại cũng ra ngồi hóng mát trên băng ghế. Cũng còn cảm nhận được hơi người... Tiện thể nghe ngóng bao nhiêu là chuyện hay.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713865
    m_Localized: 'NotTrue: Nhưng mà từ lúc mớ bòng bong này ập đến, ngoại chán chẳng buồn muốn nhấc chân ra ngoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713866
    m_Localized: 'NotTrue: Giời ạ! Hàng xóm xung quanh rụng hết như lá mùa thu, thì lấy đâu ra sinh khí nữa chứ!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713867
    m_Localized: 'NotTrue: Cứ bước lên cầu thang là lại thấy vài xác người khốn khổ, phủ kín khăn trắng ở trên đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713868
    m_Localized: 'NotTrue: Lạy giời! Chẳng thà mình chết đi cho rồi, để khỏi phải ngày qua ngày chứng kiến cảnh buồn đau.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713869
    m_Localized: 'NotTrue: ...Nên là ngoại cuốn gói ra đi! Lang thang tìm nơi chốn mới mà nghe kể chuyện, mà cảm nhận hơi ấm con người.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713870
    m_Localized: 'NotTrue: Trời xui đất khiến thế nào mà lại đến ngay trước cửa nhà cháu! Diệu kỳ chưa hả cháu giai!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713871
    m_Localized: 'NotTrue: Ngoại chẳng có theo đạo... nhưng những lúc thế này, cảm giác như thể chính thần linh đã dẫn lối ngoại đến được đây vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532426
    m_Localized: 'NotTrue: Ôi, ngoại già lọm khọm lắm rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532427
    m_Localized: Bà có họ hàng người thân không?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532428
    m_Localized: Cháu cần kiểm tra bà
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532429
    m_Localized: 'NotTrue: Ôi, toàn những người bình thường cả. Ngoại vẫn kể chuyện về người thân quen suốt bao năm nay.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532430
    m_Localized: 'NotTrue: Gặp ai dỏng tai là ngoại kể.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532431
    m_Localized: 'NotTrue: Nhưng ngoại già cả rồi... Lắm lúc lú lẫn. Thỉnh thoảng ngoại kể chuyện... có hơi xào nấu, biến tấu một chút.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532432
    m_Localized: 'NotTrue: Bảo sao ai cũng đâm chán ghét ngoại.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532433
    m_Localized: 'NotTrue: Cháu ngoan, nghe ngoại bảo này... Trán người vì sầu khổ mà nứt toạc như bia mộ. Ta gieo mình vào rào lưới kết từ những giấc mơ hãi hùng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532434
    m_Localized: 'NotTrue: Nhưng đâu chỉ có ngoại mới mơ khiếp đảm như vậy nhỉ? Hẹ hẹ hẹ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532435
    m_Localized: 'NotTrue: Ai rồi cũng tìm tới ngoại thôi, không sớm thì muộn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532436
    m_Localized: 'NotTrue: Ai rồi cũng cần nghe kể chuyện.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713872
    m_Localized: 'NotTrue: Ai ai cũng quên ngoại mất rồi, cháu ạ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713873
    m_Localized: 'NotTrue: Dù cho có còn sống, họ cũng chẳng buồn ghé thăm bà lão gần đất xa giời này đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713874
    m_Localized: 'NotTrue: Bọn măng non thời nay đứa nào cũng vậy. Mãi đắm chìm trong dòng đời ngược xuôi, đến quên cả bản thân mình...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713875
    m_Localized: 'NotTrue: Hết bận nọ rồi lo kia, chẳng ma nào thèm hỏi thăm xem ngoại còn sống hay đã thăng rồi. Giời ạ!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713876
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713877
    m_Localized: 'NotTrue: Có lần ngoại ngồi trên băng ghế, nghe bà hàng xóm kể chuyện cháu mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713878
    m_Localized: 'NotTrue: Bảo là "Cháu nhà tôi ngoan như cún! Lúc nào cũng nhớ đến bà!"'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713879
    m_Localized: 'NotTrue: Hóa ra bà ấy không điêu! Thằng cu lễ phép thật, lúc nào cũng khoanh tay chào hỏi đàng hoàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713880
    m_Localized: 'NotTrue: Làm ngoại cũng phải ghen tị chút đỉnh...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713881
    m_Localized: 'NotTrue: ...Xong bà ấy lìa đời.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713882
    m_Localized: 'NotTrue: Rồi con cún ngoan hiện nguyên hình sói dữ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713883
    m_Localized: 'NotTrue: Nó muốn cuỗm lấy căn hộ của bà, nên mới giả bộ nói cười dạ vâng.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713884
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713885
    m_Localized: 'NotTrue: Cùng là người với nhau, sao lại gạt nhau trắng trợn thế nhỉ? Soi vào đáy mắt người thân yêu, chẳng thấy chân thật, chỉ thuần dối gian.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713886
    m_Localized: 'NotTrue: Cưới xin đi, đẻ con đẻ cái đi... rồi cuối cùng chúng nó hắt hủi mình thế đấy! Phúc ba đời chưa!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713887
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713888
    m_Localized: 'NotTrue: May mà lão chồng ngoại chết phứt từ lâu rồi. Đúng là lão già quỷ quái, giời đánh thật!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532437
    m_Localized: 'NotTrue: Ôi, ngoại già lọm khọm lắm rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532438
    m_Localized: Chồng bà bị sao ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532439
    m_Localized: Cháu cần kiểm tra bà
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532440
    m_Localized: 'NotTrue: Cháu muốn nghe chuyện gì nữa nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532441
    m_Localized: 'NotTrue: Đàn ông là giống loài đáng sợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532442
    m_Localized: 'NotTrue: Ngày xưa ngoại có quen một kẻ tự cô lập mình khỏi thiên hạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532443
    m_Localized: 'NotTrue: Lão trốn trong một căn hộ cao tầng, chẳng bao giờ ló mặt ra ngoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532444
    m_Localized: 'NotTrue: Chắc là lão sợ bọn Dị Khách. Hoặc là sợ chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532445
    m_Localized: 'NotTrue: Chẳng một ai tới thăm hắn. Mà có tới thì lão cũng đâu mở cửa cho vào...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532446
    m_Localized: 'NotTrue: Cho đến một ngày...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532447
    m_Localized: 'NotTrue: Ngoại nghe tiếng lạ lắm. Như thể tiếng thủy tinh lẫn vào lọ mứt dâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532448
    m_Localized: 'NotTrue: Ngoại mới nghĩ, "Ôi, có chuyện gì không biết!"'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532449
    m_Localized: 'NotTrue: Nhìn ra cửa sổ, ngoại thấy hắn đang ở tầng dưới cùng của tòa tháp.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532450
    m_Localized: 'NotTrue: ...Lão nhảy xuống cháu ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532451
    m_Localized: 'NotTrue: Cháu nghe chuyện vừa rồi có thấy hay không?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532452
    m_Localized: Không ạ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532453
    m_Localized: Có vậy thôi à?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532454
    m_Localized: 'NotTrue: Hừ! Bảo sao chẳng ai thèm ưa ngoại.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532455
    m_Localized: 'NotTrue: Cháu nhớ này... Sau này ngoại cũng sẽ kể lại chuyện của cháu theo trí nhớ của ngoại thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532456
    m_Localized: 'NotTrue: Đúng rồi cháu à. Gã đàn ông trong chốc lát hóa thành một vũng nước.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532457
    m_Localized: 'NotTrue: Có lẽ hắn sợ nỗi đau đến từ cơn thịnh nộ của mặt trời... Hoặc cũng chẳng phải.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532458
    m_Localized: 'NotTrue: Còn ngoại à? Hừ! Chắc là chẳng qua không chịu nổi nỗi cô đơn nữa chứ gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532459
    m_Localized: 'NotTrue: Nhưng biết sao được hả cháu ơi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713889
    m_Localized: 'NotTrue: Ôi giời. Lão đi đời nhà ma lâu rồi cháu à.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713890
    m_Localized: 'NotTrue: Làm hỏng cả đời con gái người ta. Đúng là cái thằng mục rữa thối tha!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713891
    m_Localized: 'NotTrue: Ngoại bị ông thầy, bà bu thúc cưới lão.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713892
    m_Localized: 'NotTrue: Kêu là "Lấy nó đi con, nó tốt lắm". Ừ thế là ngoại cưới.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713893
    m_Localized: 'NotTrue: Lúc đầu thì cũng tốt thật! Cũng ngon lành cành đào gớm! Nhưng cưới hỏi xong xuôi mới lòi ra mặt chuột.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713894
    m_Localized: 'NotTrue: Ngoại cặm cụi nấu nướng bên bếp cả buổi, mà chẳng thấy lão mở mồm cảm ơn bao giờ. Đã thế còn "Cằn nhằn cái gì! Không thấy tao đang ăn à?" '
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713895
    m_Localized: 'NotTrue: Một lúc sau lão lại đi mất hút cả tiếng đồng hồ. Rượu chè cho nát cái thân ra! Giời đánh!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713896
    m_Localized: 'NotTrue: Về đến nhà thì say bí tỉ, mồm mép lảm nhảm ba cái gì mà đánh đô-mi-nô trong hầm xe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713897
    m_Localized: 'NotTrue: Thế mà ngoại mới hỏi chuyện có tí là lão đã quát tháo um sùm. Mẹ sư lão già chết giẫm.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713898
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713899
    m_Localized: 'NotTrue: ...Xong lão đứt bóng.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713900
    m_Localized: 'NotTrue: Lúc đầu ngoại thấy đời nhẹ tựa lông hồng, như chim sổ lồng! ...Nhưng rồi tỉnh cơn mơ, ngoại mới nghe lòng mình trống trải làm sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713901
    m_Localized: 'NotTrue: Xem vô tuyến cũng đỡ buồn được một lúc, cơ mà đâu lại hoàn đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713902
    m_Localized: 'NotTrue: Thế là ngoại lại ra ngồi trên băng ghế. Thui thủi lặng ngắm đời trôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532460
    m_Localized: 'NotTrue: Ôi, ngoại già lọm khọm lắm rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532461
    m_Localized: Ngồi ghế rồi bà thấy sao nữa ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532462
    m_Localized: Cháu cần kiểm tra bà
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532463
    m_Localized: 'NotTrue: Để ngoại kể cháu chuyện này.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532464
    m_Localized: 'NotTrue: Ngày xửa ngày xưa, hồi ngoại còn trẻ như măng mới mọc, ngoại có quen một gã trong làng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532465
    m_Localized: 'NotTrue: Lão mê đi dạo trong rừng lắm. Chẳng hiểu để làm gì, mà hễ rảnh là lão lọ mọ chui vào đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532466
    m_Localized: 'NotTrue: Rồi một hôm, lão đang đi thì tự nhiên bị lạc, không còn nhớ đường về.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532467
    m_Localized: 'NotTrue: Lão đứng lại hít thở một hồi cho tỉnh táo, rồi tự nhủ cứ đi tiếp thì kiểu gì cũng có đường ra thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532468
    m_Localized: 'NotTrue: Thế là lão đi mãi, đi hoài, đi muốn gãy chân. Nhưng không tài nào bước ra khỏi cánh rừng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532469
    m_Localized: 'NotTrue: Lúc đấy lão mới phát hiện ra, từ đầu đến giờ mình toàn đi lòng vòng tại chỗ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532470
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532471
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532472
    m_Localized: Rồi sao nữa ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532473
    m_Localized: Nghe vớ vẩn vậy
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532474
    m_Localized: 'NotTrue: ...Người ta tìm thấy lão nằm chết queo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532475
    m_Localized: 'NotTrue: Lão không tìm được đường ra khỏi rừng. Người ta mò ra dấu chân lão đi lòng vòng luẩn quẩn đến khi kiệt sức.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532476
    m_Localized: 'NotTrue: Các cụ bảo rồi mà cháu. Chân người bên ngắn bên dài, thế nên càng đi lại càng vòng về chỗ cũ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532477
    m_Localized: 'NotTrue: Giờ lão ta mục rữa trong rừng rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532478
    m_Localized: 'NotTrue: Hừ! Cháu không thích chuyện ngoại kể à?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532479
    m_Localized: 'NotTrue: Ừ thì... ngoại có thêm mắm dặm muối, kể cho bon mồm...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532480
    m_Localized: 'NotTrue: Nhưng chuyện xảy ra thật đấy cháu. Ai cũng có nguy cơ gặp phải tình cảnh tương tự thôi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532481
    m_Localized: 'NotTrue: Chuyện đi lạc xảy ra như cơm bữa mà. Chẳng hiểu họ tìm đường về kiểu gì luôn đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713903
    m_Localized: 'NotTrue: Ôi, cháu ngoan ơi...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713904
    m_Localized: 'NotTrue: Ngồi ghế ngắm nhìn thiên hạ cũng là cái thú cháu ạ. Trẻ con cười đùa, giai gái nắm tay nhau, chó chạy lon ton theo chủ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713905
    m_Localized: 'NotTrue: Nhưng rồi ai mượn cái thiên tai này ập đến... Giời ạ!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713906
    m_Localized: 'NotTrue: Ai nấy đóng cửa cài then, ở hết trong nhà. Mỗi cái thân già này vẫn ngồi trên ghế, nhưng chẳng có ma nào đi qua nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713907
    m_Localized: 'NotTrue: Ngồi nhà ngắm qua cửa sổ cũng chả khá hơn là bao.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713908
    m_Localized: 'NotTrue: Chẳng còn tiếng cười, chẳng ai vẫy tay nữa. Chỉ còn lác đác mấy con chó hoang, vài tên hàng xóm liếc nhau lạnh nhạt như người dưng nước lã.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713909
    m_Localized: 'NotTrue: Sự sống như chấm dứt, chôn chân tại chỗ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713910
    m_Localized: 'NotTrue: Quỷ tha ma bắt... Giờ thì chẳng biết tôn hành giả, giả hành tôn thế nào nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713911
    m_Localized: 'NotTrue: Ngoại chỉ mong sao người ta đừng lường gạt nhau nữa, cháu à...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532482
    m_Localized: 'Alkonost: Chị cần nghỉ ngơi để lại sức. Ước gì có ai truyền cho chị tí năng lượng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532483
    m_Localized: Em chị sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532484
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532485
    m_Localized: 'Alkonost: Chị phải giúp nó sinh hoạt đủ thứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532486
    m_Localized: 'Alkonost: May mà hôm qua chị tắm cho nó được. Ở nhà nó còn không chịu vào bồn cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532487
    m_Localized: 'Alkonost: Nó vẫn vậy thôi. Cảm ơn chú đã hỏi thăm nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532488
    m_Localized: 'Alkonost: Trầm cảm có thể khiến mọi thứ trở nên vô cùng... phức tạp.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532489
    m_Localized: 'Alkonost: Chị lo là nếu chẳng may có biến, phải gói ghém chạy đi thì có khi nó còn chả đứng dậy nổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532490
    m_Localized: 'Alkonost: Hoặc là nó chẳng ăn được gì, vì không có sức mà nhai, mà nuốt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532491
    m_Localized: 'Alkonost: Chị cũng mệt quá rồi. Chắc phải nghỉ một chút đây...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532492
    m_Localized: 'Alkonost: Chị cần nghỉ ngơi để lại sức. Ước gì có ai truyền cho chị tí năng lượng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532501
    m_Localized: 'Alkonost: Chị cần nghỉ ngơi để lại sức. Ước gì có ai truyền cho chị tí năng lượng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532510
    m_Localized: 'Alkonost: Chị cần nghỉ ngơi để lại sức. Ước gì có ai truyền cho chị tí năng lượng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532521
    m_Localized: 'Alkonost: Chị cần nghỉ ngơi để lại sức. Ước gì có ai truyền cho chị tí năng lượng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083334
    m_Localized: 'Theorist: Chú có gì muốn chia sẻ à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083335
    m_Localized: Anh đang cầm giấy tờ gì thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083336
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083337
    m_Localized: 'Theorist: Tài liệu này tiết lộ nhiều thứ kinh hoàng, chấn động lắm. Không đùa đâu, nghe là bừng tỉnh, là rùng mình đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083338
    m_Localized: 'Theorist: Ví dụ như giả thuyết này chẳng hạn. Thú vị cực kỳ luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083339
    m_Localized: 'Theorist: Giả thuyết cho rằng Dị Khách không có thật. Mà chỉ là chiêu trò để chính phủ kiểm soát dân số thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083340
    m_Localized: 'Theorist: Đọc cuốn lắm chú ạ! Mà cũng hợp lý phết ấy chứ đùa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083341
    m_Localized: 'Theorist: Nghĩ mà xem, tình trạng quá tải dân số đã và đang là vấn đề nhức nhối của xã hội. Cái này không phải bàn cãi rồi, chuẩn chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083342
    m_Localized: 'Theorist: Giả sử chính quyền đã chọn "xử lý" vấn đề bằng cách... đấy. Hiểu ý tôi không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083343
    m_Localized: 'Theorist: Chú có gì muốn chia sẻ à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083344
    m_Localized: Anh vẫn nghiền ngẫm đống giấy tờ đó à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083345
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083346
    m_Localized: 'Theorist: Đúng rồi đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083347
    m_Localized: 'Theorist: Nhiều lắm đấy, chú muốn đọc không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083348
    m_Localized: 'Theorist: Đây, như cái này chẳng hạn...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083349
    m_Localized: 'Theorist: Giả thuyết này thì cho rằng bọn Phòng Chống Thảm Họa CHÍNH LÀ Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083350
    m_Localized: 'Theorist: Chúng nó mặc đồ bảo hộ che hết cả người nên cũng chẳng kiểm tra được. Nghe hợp lý chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083351
    m_Localized: 'Theorist: Thú vị đấy... bọn này viết tắt là PCTH. Mà nó còn có nghĩa là... Phân Chia Thiên Hạ! Ối giồi, chúng nó định chia cấp bậc để dễ trị đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083352
    m_Localized: 'Theorist: Hay là biết đâu... còn ẩn chứa ý nghĩa gì khác...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083353
    m_Localized: 'Theorist: Chú có gì muốn chia sẻ à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083354
    m_Localized: Lần này có phát hiện gì mới chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083355
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083356
    m_Localized: 'Theorist: Chuẩn bị nổ não này: Dị Khách. Quái vật Skinwalker.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083357
    m_Localized: 'Theorist: Nghe cứ như tiểu thuyết khoa học viễn tưởng ấy nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083358
    m_Localized: 'Theorist: Nhưng mà ai biết được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083359
    m_Localized: 'Theorist: Đây, chú nghe nhé. Tin này đề cập đến chuyện phát hiện một gã da tái nhợt lang thang khắp đường phố.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083360
    m_Localized: 'Theorist: Mà... tôi thấy người viết tin này mắc một lỗi khá là vớ vẩn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083361
    m_Localized: 'Theorist: Họ cho rằng có đến HAI kẻ dị hợm, da tái nhợt xuất hiện ở ngoài đường.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083362
    m_Localized: 'Theorist: Một kẻ thì đứng ngoài cửa sổ, còn một kẻ thì đứng trước cửa ra vào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083363
    m_Localized: 'Theorist: Tầm xàm bá láp! Rõ ràng bọn này là một mà!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083364
    m_Localized: 'Theorist: Dám chắc là do cái cửa sổ đã làm biến dạng tầm nhìn của tác giả viết tin. Dẫn đến phát sinh ảo ảnh thị giác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083365
    m_Localized: 'Theorist: Mà dù sao... vẫn đáng suy ngẫm đấy, chú nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083366
    m_Localized: 'Theorist: Chú có gì muốn chia sẻ à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083367
    m_Localized: Lỡ tin đó là thật thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083368
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083369
    m_Localized: 'Theorist: Bản chất sự thật là gì? Một khái niệm mơ hồ và chủ quan, hoàn toàn dựa vào góc nhìn của mỗi cá nhân.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083370
    m_Localized: 'Theorist: Sự thật trong mắt kẻ này lại là ảo tưởng đối với kẻ khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083371
    m_Localized: 'Theorist: Cùng một sự việc mà có người cho là thiện, có kẻ bảo là ác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083372
    m_Localized: 'Theorist: Từ thuở khai thiên lập địa, con người đã tranh cãi thế nào mới là phẩm hạnh. Giờ đây, tiêu chuẩn đạo đức của xã hội lại càng loạn lên hết cả!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083373
    m_Localized: 'Theorist: Chú càng tin tưởng điều gì, điều ấy càng trở thành sự thật trong mắt chú. Tôi cũng vậy thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083374
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083375
    m_Localized: 'Theorist: Hừm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083376
    m_Localized: 'Theorist: Quả là bài viết thú vị... Ủa mà mình đang bàn về cái gì ấy nhỉ? À ừ, sự thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083377
    m_Localized: 'Theorist: Chú chỉ cần ghi nhớ một điều, một sự thật duy nhất: Lũ Dị Khách... chính là ký sinh ăn não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083378
    m_Localized: 'Theorist: Nhớ phải đeo nút bịt tai. ĐEO CẢ NGÀY! Phòng thủ hớ hênh là chúng nó xâm nhập đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083379
    m_Localized: 'Theorist: Cơ mà giờ tôi còn phải đọc nữa. Nên là phiền chú ra chỗ khác để tôi còn tập trung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083440
    m_Localized: 'Raskolnikov: U là trời... Ước chi em biết giết người.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083441
    m_Localized: Vẫn muốn nhìn tôi giết Dị Khách à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083442
    m_Localized: Tôi cần kiểm tra cậu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083443
    m_Localized: 'Raskolnikov: À thôi... E-Em nghĩ lại rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083444
    m_Localized: 'Raskolnikov: Tự nhiên thấy rén quá. E-Em xin lỗi nha, nói rứa thôi chớ em... chưa dám làm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083445
    m_Localized: 'Raskolnikov: Mỗi lần nhìn xác chết là em bị m-mắc mửa... Gớm lắm trời ơi... Phải, phải cố mà khắc phục mới được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083446
    m_Localized: 'Raskolnikov: Nhưng mà kiểu, lũ Dị Khách ý... Em nghe nói là cơ thể tụi nó vẫn cử động tiếp được... s-sau khi chết á. Như cái ông trong hẻm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083447
    m_Localized: 'Raskolnikov: Hừừừ, má ơi, mới nghĩ tới thôi mà muốn lộn ruột rồi. Em chưa dám mô, chưa sẵn sàng mô. Xin lỗi anh...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083448
    m_Localized: 'Raskolnikov: U là trời... Ước chi em biết giết người.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083449
    m_Localized: Cậu bảo ông trong hẻm là sao? Có chuyện gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083450
    m_Localized: Tôi cần kiểm tra cậu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083451
    m_Localized: 'Raskolnikov: Biết nói răng chừ... K-Khó lắm anh ơi, nhưng em sẽ ráng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083452
    m_Localized: 'Raskolnikov: Kiểu, lúc đó em cứ nghĩ là đi trong hẻm sẽ an toàn hơn á.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083453
    m_Localized: 'Raskolnikov: Ai dè mô mới đánh quẹo một cái, tưởng mình đi lạc vô cái nghĩa địa lúc mô hổng hay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083454
    m_Localized: 'Raskolnikov: Em thấy người ta... nằm chất đống. X-Xác người la liệt từa lưa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083455
    m_Localized: 'Raskolnikov: Mà để ý thấy, trong đó... có mấy cái xác còn nhúc nhích nữa! Như kiểu... nó chưa chết hẳn á anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083456
    m_Localized: 'Raskolnikov: Xong ở cuối con hẻm, tự nhiên lòi ra một ông cầm súng, rồi ổng...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083457
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083458
    m_Localized: 'Raskolnikov: Thôi... Thôi. E-Em hông muốn nhớ lại nữa mô.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083459
    m_Localized: 'Raskolnikov: U là trời... Ước chi em biết giết người.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083460
    m_Localized: Cậu kể chi tiết hơn về cái gã trong hẻm đi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083461
    m_Localized: Tôi cần kiểm tra cậu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083462
    m_Localized: 'Raskolnikov: Ổng á...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083463
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083464
    m_Localized: 'Raskolnikov: Ổng bận áo choàng đen, đeo một cái vòng xâu toàn ngón tay với răng người...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083465
    m_Localized: 'Raskolnikov: Xong có đứa con nít trước mặt ổng, nhìn yếu ớt bất lực vô cùng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083466
    m_Localized: 'Raskolnikov: Cái ổng chĩa súng vô đầu đứa nhóc, chửi bới om sòm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083467
    m_Localized: 'Raskolnikov: Ổng hét vô mặt nó, đòi cho xem răng... Tội nghiệp thằng nhỏ, nó chỉ mếu máo cầu xin tha mạng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083468
    m_Localized: 'Raskolnikov: Lúc đó em trốn sau thùng rác... U là trời luôn, đầu em cứ tưởng tượng mình mà là thằng nhóc nớ thì sao...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083469
    m_Localized: 'Raskolnikov: Nó khóc bù lu bù loa, cầu xin ổng rủ lòng thương xót mà bỏ qua cho...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083470
    m_Localized: 'Raskolnikov: Cái rồi... ĐÙNG MỘT PHÁT! Thằng nhỏ lăn ra chết ngắc, chịu chung số phận với đám người xấu số kia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083471
    m_Localized: 'Raskolnikov: Lúc bấy giờ, em mới sực tỉnh ngộ... Trên đời này chừ chỉ còn tồn tại hai kiểu người: thợ săn với con mồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083472
    m_Localized: 'Raskolnikov: U là trời... Ước chi em biết giết người.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083473
    m_Localized: Muốn sống, cậu đâu cần phải trở thành kẻ giết người máu lạnh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083474
    m_Localized: Tôi cần kiểm tra cậu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083475
    m_Localized: 'Raskolnikov: U là trời! Anh nói cái chi mà ngộ rứa? Phải rứa chứ anh!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083476
    m_Localized: 'Raskolnikov: Anh nhìn lại mình coi, còn sống tới chừ là nhờ anh hung dữ, nhe nanh như thú săn mồi mà! A-Ai mà dám lộn xộn với anh nữa chớ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083477
    m_Localized: 'Raskolnikov: Chỉ cần khiến người đời run sợ, là anh sẽ sống sót an toàn!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083478
    m_Localized: 'Raskolnikov: Em h-hông muốn làm con mồi mô. Hổng muốn chết tức tưởi như mấy thằng hèn. E-Em...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277632
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277633
    m_Localized: 'Raskolnikov: Bởi rứa nên em mới phải học cách giết người.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277634
    m_Localized: 'Nun: Lạy Cha chúng con ở trên trời...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277635
    m_Localized: Bà thấy ở đây thế nào?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277636
    m_Localized: Tôi cần kiểm tra bà
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277637
    m_Localized: 'Nun: Quá kinh khủng, con ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277638
    m_Localized: 'Nun: Tường nhà thì mục nát, thiết kế thì rối mắt chẳng ra thể thống gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277639
    m_Localized: "Nun: Thú thật đi, con cố ý xếp cho ta căn phòng tan hoang bẩn thỉu nhất \nxó nhà đúng không?"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277640
    m_Localized: "Nun: Bàn ghế thì vừa cũ kỹ, vừa xập xệ... Có khi đám mối mọt đã ăn gọn ăn sạch từ trong ra ngoài rồi \nkhông chừng."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277641
    m_Localized: 'Nun: Đến điều cơ bản nhất như treo thánh giá cho thẳng thớm mà con cũng không làm được hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277642
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277643
    m_Localized: "Nun: Lạy Cha, sao Ngài lại thử thách \nlòng con thế này..."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277644
    m_Localized: 'Nun: Lạy Cha chúng con ở trên trời...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277645
    m_Localized: Bà ghét ở đây tới vậy thì sao không cuốn gói đi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277646
    m_Localized: Tôi cần kiểm tra bà
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277647
    m_Localized: 'Nun: Ngươi thực sự nghĩ ta muốn bước chân vào cái chốn ô uế này à? Tu viện linh thiêng mà không có chuyện thì tội gì ta phải đi chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277648
    m_Localized: "Nun: Ai mà thèm để tâm đến cái bãi rác \ntồi tàn này."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277649
    m_Localized: 'Nun: Hừ, nếu có quyền được lựa chọn thì đời nào ta chịu bước chân vào xó xỉnh đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277650
    m_Localized: 'Nun: Căn nhà này sặc mùi chết chóc, mà có khi chính ngươi cũng lấy làm tận hưởng! Lạy Chúa tôi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277651
    m_Localized: 'Nun: Ngươi chìm đắm trong cơn khát máu, sẵn sàng ra tay với bất kỳ ai mình cho là quỷ dữ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277652
    m_Localized: 'Nun: Mà biết đâu chính ngươi cũng là đồng loại của chúng! Chỉ chờ mọc mỗi cặp sừng, nhe nanh tà ác!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277653
    m_Localized: 'Nun: Dẫu vậy, ta sẽ không chùn chân trước khổ nạn này. Bởi Đức Chúa Cha luôn dõi theo săn sóc bầy chiên của Ngài.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277654
    m_Localized: 'Nun: Lạy Cha chúng con ở trên trời...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277655
    m_Localized: Sao bà không ở lại tu viện của bà đi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277656
    m_Localized: Tôi cần kiểm tra bà
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277657
    m_Localized: 'Nun: Thứ nhất, tu viện không phải là của ta. Mà đó là nơi Thiên Chúa ngự trị.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277658
    m_Localized: "Nun: Thứ hai, chính lũ báng bổ đã \nchiếm lấy nơi ấy."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277659
    m_Localized: 'Nun: Chúng cả gan làm nhơ nhuốc cả chốn linh thiêng của Người. Cầu cho lửa trời giáng xuống thiêu rụi tội lỗi của lũ đê hèn đó!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277660
    m_Localized: 'Nun: Bọn báng bổ kéo đến bịt kín lối đi, rồi đuổi cổ bầy chiên của Đức Chúa. Trong đó có ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277661
    m_Localized: 'Nun: Chúng mặc sức chiếm đoạt, cướp bóc như thể mình là bá chủ nơi này. Quả đúng là phường man di, dị giáo, phạm thánh bẩn thỉu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277662
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277663
    m_Localized: 'Nun: Chúng ta sống nề nếp thánh thiện, cầu nguyện theo điều Ngài dạy, ăn chay đúng luật Ngài truyền. Còn bọn thú vật đó thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277664
    m_Localized: 'Nun: Ắt hẳn là bây giờ chúng đang tu nước thánh như thể nốc rượu rẻ tiền. Quân báng bổ xấc xược!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277665
    m_Localized: 'Nun: Cầu cho chúng chết sặc. Amen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277666
    m_Localized: 'Nun: Lạy Cha chúng con ở trên trời...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277667
    m_Localized: Rồi đám người "báng bổ" đó muốn gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277668
    m_Localized: Tôi cần kiểm tra bà
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277669
    m_Localized: 'Nun: Chúng kéo đến từng bầy, một lũ nhơ bẩn, hỗn hào. Rồi thi nhau gào thét, nguyền rủa chẳng khác gì đám vô thần mọi rợ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277670
    m_Localized: "Nun: Vì cái gì? Chỉ vì ta cấm cửa bọn chúng! Ta đã nói rõ: Kẻ nào chưa rửa tội thì không được phép đặt chân vào \nđất thánh!"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277671
    m_Localized: 'Nun: Lạy Chúa, chúng đã nổi cơn thịnh nộ. Phải rồi… chúng đập cửa rần rần, dọa sẽ giật tung từng cánh cửa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277672
    m_Localized: 'Nun: Để rồi đến khi tràn vào, chúng lại thản nhiên tống khứ ta đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277673
    m_Localized: Tức là bà đã xua đi những người cần giúp đỡ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277674
    m_Localized: Tôi cũng có thể đuổi bà đi đấy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277675
    m_Localized: "Nun: Không một chốn linh thiêng nào chịu dung chứa những kẻ khước từ \nánh sáng của Đức Chúa."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277676
    m_Localized: 'Nun: Cho dù chúng muốn tìm chỗ râm mát, hay nơi trú ẩn khỏi bè lũ Dị Khách kia, thì ta cũng mặc kệ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277677
    m_Localized: 'Nun: Kể cả khi lửa trời giáng xuống từ trên cao, mái nhà của Ngài cũng không có chỗ chứa chấp đám tởm lợm đó!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277678
    m_Localized: "Nun: Ngài chỉ ban hồng ân cho những \nđứa con thành tâm tin tưởng."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277679
    m_Localized: 'Nun: Dẫu chúng có chết cháy ngoài đường, ấy vẫn chỉ đơn thuần là hình phạt mà Thiên Chúa giáng xuống đầu chúng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277680
    m_Localized: Tôi không muốn phán xét, nhưng bà cũng chả tốt đẹp gì đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277681
    m_Localized: Cút mau, không là tôi cho bà xuống địa ngục đấy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277682
    m_Localized: 'Nun: Đồ xấc láo mạo phạm!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277683
    m_Localized: 'Nun: Ngươi điên rồi hả?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277684
    m_Localized: 'Nun: Ta là kẻ phụng sự Đấng Tối Cao! Vì xui rủi nên mới bị lũ sâu bọ vô thần tống ra khỏi mái nhà của Ngài. Vậy mà ngươi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277685
    m_Localized: 'Nun: Ngươi lại dám chế giễu ta ư? Dám nói rằng ta đáng bị như thế?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277686
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277687
    m_Localized: 'Nun: Ngươi thực chẳng phải con người. Mà là đồ rắn độc!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277688
    m_Localized: 'Nun: QUÂN BÁNG BỔ! RỐT CUỘC NGƯƠI CHỈ LÀ KẺ BÁNG BỔ NHƯ CHÚNG NÓ MÀ THÔI!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277689
    m_Localized: 'Nun: Vậy mà ta cứ tưởng nhà ngươi sẽ hiểu cho ta. Hóa ra ngươi cũng chẳng hơn gì bọn chúng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277690
    m_Localized: 'Nun: Chúng ta chỉ là những kẻ hầu người hạ! LÀ TÔI TỚ CHO ĐỨC CHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277691
    m_Localized: 'Nun: Chúng ta chẳng thể làm gì khác ngoài việc tuân phục ý muốn của Ngài.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277692
    m_Localized: 'Nun: Thánh ý của Đức Chúa rất cao siêu, khó lường! Kẻ hèn mọn như chúng ta muôn đời cũng không sao hiểu thấu được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277693
    m_Localized: Tôi không muốn phán xét, nhưng bà cũng chả tốt đẹp gì đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277694
    m_Localized: Cút mau, không là tôi cho bà xuống địa ngục đấy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277695
    m_Localized: 'Nun: Ô, giờ ngươi lại đi đóng vai đấng cứu độ đấy à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277696
    m_Localized: 'Nun: Cứ việc giữ lấy cái xó bẩn thỉu của ngươi. Ta chẳng thể chịu nổi ở đây thêm một giây nào nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277697
    m_Localized: "Nun: Vĩnh biệt. Cầu Chúa giáng cơn \nthịnh nộ xuống đầu ngươi!"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277698
    m_Localized: 'Nun: Hừ, từ đầu ta cũng chẳng định ở lâu rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277699
    m_Localized: 'Nun: Ngay từ lúc đặt chân vào đây, ta đã biết căn nhà này hoàn toàn không có bóng dáng của Đức Chúa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277700
    m_Localized: 'Nun: Hẳn đó là tín hiệu Ngài truyền đến ta, nhắc nhở rằng ta phải đi thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277701
    m_Localized: "Nun: Vĩnh biệt. Cầu Chúa giáng cơn \nthịnh nộ xuống đầu ngươi!"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277702
    m_Localized: 'Fugitive: Đau thấu trời xanh luôn...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277703
    m_Localized: Tại sao bọn áo vàng lại đến khám nhà anh vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277704
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277705
    m_Localized: 'Fugitive: Chả biết nữa, nhưng tôi đoán thế này. '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277706
    m_Localized: 'Fugitive: Lúc họ gõ cửa, tôi cứ tưởng họ chỉ đi tuần tra như bình thường thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277707
    m_Localized: 'Fugitive: Nhưng tôi cá mười ăn mười, chính con mụ nhà kế bên đã chỉ điểm tôi chứ không ai khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277708
    m_Localized: 'Fugitive: Tôi với mụ thù nhau lắm. Chắc mụ thừa cơ đi báo cán bộ tôi là "Dị khách" để nó bế tôi đi luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277709
    m_Localized: 'Fugitive: Mụ già đấy chắc giờ đang vênh vênh váo váo lắm, đúng con chó giẻ rách.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277710
    m_Localized: 'Fugitive: Đau thấu trời xanh luôn...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277711
    m_Localized: Anh thấy sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277712
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277713
    m_Localized: 'Fugitive: Đỡ hơn nhiều rồi cậu. Thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277714
    m_Localized: 'Fugitive: Đạn bắn xuyên người mà, không đến nỗi nào đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277715
    m_Localized: 'Fugitive: Cùng là con người với nhau mà hãm hại nhau kiểu đó đấy. Cũng tại số tôi đỏ, gặp trúng cái lão điên ngứa tay bóp cò nữa chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277716
    m_Localized: 'Fugitive: Kiểu gì cũng chui xuống mồ cả lũ, có ai chịu để ai sống yên đâu mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277717
    m_Localized: 'Fugitive: Có cái lồn nhé. Mạng ai người nấy giữ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277718
    m_Localized: 'Fugitive: Vãi chưởng, cậu mà gặp phải cái lão tâm thần thèm bắn người đấy xem. Mẹ nó tởm thì thôi chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277719
    m_Localized: Lão tâm thần nào? Tưởng người bên Thảm Họa bắn anh chứ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277720
    m_Localized: Anh đang nói ai vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277721
    m_Localized: 'Fugitive: Ừ-Ừ nhỉ, ý tôi là bọn chó Thảm Hại đấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277722
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277723
    m_Localized: Nói thật đi, đừng giấu nữa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277724
    m_Localized: Thôi cái trò này đi nhé. Anh chém gió dở lắm
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277725
    m_Localized: 'Fugitive: Ờ thì... Mấy thằng chó áo vàng ấy mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277726
    m_Localized: 'Fugitive: Thằng đấy đứng trước mặt tôi mà kinh dị vãi luôn...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277727
    m_Localized: 'Fugitive: À ờm ý là... Lúc nó... đứng sau tôi ấy... bắn vào lưng tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277728
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277729
    m_Localized: Nói thật đi, đừng giấu nữa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277730
    m_Localized: Thôi cái trò này đi nhé. Anh chém gió dở lắm
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277731
    m_Localized: 'Fugitive: Rồi rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277732
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277733
    m_Localized: 'Fugitive: Chuyện trốn khỏi khu cách ly là tôi nói thật... nhưng chúng nó không nã đạn về phía tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277734
    m_Localized: 'Fugitive: Có ông bác sĩ trong đó làm giả giấy tờ, giúp tôi thoát ra ngoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277735
    m_Localized: 'Fugitive: Nhưng tôi đâu thể về nhà được. Con đĩ chó hàng xóm lại tố giác tôi nữa thì sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277736
    m_Localized: 'Fugitive: Thế nên tôi mới lang thang ở ngoài, tìm chỗ trú ẩn. Đúng lúc đó thì tôi va phải lão tâm thần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277737
    m_Localized: 'Fugitive: Tôi chỉ định bụng hỏi lão có biết chỗ nào để trú tạm qua đêm không, thì đột nhiên...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277738
    m_Localized: 'Fugitive: Tôi nhìn rõ hơn... Lão ta giắt súng trên lưng, đeo chiếc vòng cổ toàn răng và ngón tay người, phía sau là cả đống xác chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277739
    m_Localized: 'Fugitive: Ừ... Lúc đó tôi mới nhận ra là mình đụng trúng thằng tâm thần mẹ rồi. Vãi cả chưởng luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277740
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277741
    m_Localized: 'Fugitive: Chậc, vết thương của tôi lại giở chứng rồi. Cho tôi nằm nghỉ tí nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277742
    m_Localized: 'Fugitive: Cái đệt...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277743
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277744
    m_Localized: 'Fugitive: Rồi từ từ bình tĩnh, để tôi giải thích.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277745
    m_Localized: 'Fugitive: Chuyện trốn khỏi khu cách ly là tôi nói thật... nhưng chúng nó không nã đạn về phía tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277746
    m_Localized: 'Fugitive: Có ông bác sĩ trong đó làm giả giấy tờ, giúp tôi thoát ra ngoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277747
    m_Localized: 'Fugitive: Nhưng tôi đâu thể về nhà được. Con đĩ chó hàng xóm lại tố giác tôi nữa thì sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277748
    m_Localized: 'Fugitive: Thế nên tôi mới lang thang ở ngoài, tìm chỗ trú ẩn. Đúng lúc đó thì tôi va phải lão tâm thần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277749
    m_Localized: 'Fugitive: Tôi chỉ định bụng hỏi lão có biết chỗ nào để trú tạm qua đêm không, thì đột nhiên...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277750
    m_Localized: 'Fugitive: Tôi nhìn rõ hơn... Lão ta giắt súng trên lưng, đeo chiếc vòng cổ toàn răng và ngón tay người, phía sau là cả đống xác chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277751
    m_Localized: 'Fugitive: Ừ... Lúc đó tôi mới nhận ra là mình đụng trúng thằng tâm thần mẹ rồi. Vãi cả chưởng luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277752
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277753
    m_Localized: 'Fugitive: Chậc, vết thương của tôi lại giở chứng rồi. Cho tôi nằm nghỉ tí nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277754
    m_Localized: 'Fugitive: Đau thấu trời xanh luôn...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277755
    m_Localized: Anh kể chi tiết hơn về lão tâm thần vác súng kia đi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277756
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277757
    m_Localized: 'Fugitive: À, cái lão dị hợm đeo vòng toàn răng và ngón tay đấy đúng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277758
    m_Localized: 'Fugitive: Chắc lão thấy mặt tôi lộ vẻ nghi ngại, thế là rút súng chĩa vào người tôi luôn. May sao tôi chộp lấy được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277759
    m_Localized: 'Fugitive: Hai bên cứ thế giằng co một lúc, cố mà giành giật khẩu súng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277760
    m_Localized: 'Fugitive: Xong lão bóp cò một phát. Tôi nhảy bổ vào cụng đầu lão cái bốp, thế là lão bất con mẹ nó tỉnh luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277761
    m_Localized: 'Fugitive: Sau đó tôi vắt chân lên cổ mà chạy. Chạy được một lúc thì bụng chợt nhói lên. Ựa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277762
    m_Localized: 'Fugitive: Tôi nhìn xuống thì thấy máu bê bết hết cả người rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277763
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277764
    m_Localized: 'Fugitive: Tôi giấu cậu chuyện lão bắn tôi, vì nghĩ rằng nếu thú thật thì cậu chẳng chịu cho tôi vào nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277765
    m_Localized: 'Fugitive: Thời buổi này thân ai nấy lo, sống chết mặc bay mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277766
    m_Localized: 'Fugitive: Cậu nói thật đi. Nếu biết tôi bị lão điên cầm súng dí theo thì cậu còn cho tôi ở nhờ không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277767
    m_Localized: 'Fugitive: Tôi cần chỗ trú, cậu hiểu không? Chả muốn phải chết bờ chết bụi như mấy đứa thảm vãi lồn trong xó xỉnh đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277768
    m_Localized: 'Fugitive: Nên tôi mới xạo chó đấy. Mong cậu thông cảm hộ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277769
    m_Localized: Được rồi, anh cứ ở lại
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277770
    m_Localized: "Sao mà tôi tin anh được.\nCút đi"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277771
    m_Localized: 'Fugitive: Cảm ơn cậu nhiều nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277772
    m_Localized: 'Fugitive: Cũng may là cậu có vũ khí phòng thân, còn đỡ. Vái trời lão điên đó không mò tới tận đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277773
    m_Localized: 'Fugitive: Mong là có ai xử lý lão hộ. Khéo cái thằng Dị Khách da nhợt kia xơi tái lão rồi cũng nên.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277774
    m_Localized: 'Fugitive: Hừ... Đấy nói có sai đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277775
    m_Localized: 'Fugitive: Giờ mày hiểu tại sao tao phải nói dối chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277776
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277777
    m_Localized: 'Fugitive: Sống cho sướng cái thân mày nhé, thằng khốn nạn!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277778
    m_Localized: 'Bestson: Trời ơi là trời... Đi đâu mất tiêu rồi...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277779
    m_Localized: Cậu sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277780
    m_Localized: Anh cần kiểm tra cậu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277781
    m_Localized: 'Bestson: Em cũng hổng biết nữa... Em chỉ muốn ba mẹ em mau mau về thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277782
    m_Localized: 'Bestson: Cả đời này ba mẹ toàn chăm lo cho em, mà bây giờ thì... em còn hỏng biết họ ra sao nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277783
    m_Localized: 'Bestson: Trời ơi, cầu mong là họ hông có bị sao hết. Chứ em không tưởng tượng nổi cái cảnh sống thiếu ba mẹ luôn á...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277784
    m_Localized: 'Bestson: Trời ơi là trời... Đi đâu mất tiêu rồi...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277785
    m_Localized: Cậu còn người thân nào khác không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277786
    m_Localized: Anh cần kiểm tra cậu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277787
    m_Localized: 'Bestson: Dạ, cũng hổng có ai. À, nhưng mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277788
    m_Localized: 'Bestson: Dạo gần đây em mới biết vụ mình có một người chị gái. Là con của vợ đầu của ba ý, nhưng mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277789
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277790
    m_Localized: 'Bestson: Á đúng rồi, bà mình!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277791
    m_Localized: 'Bestson: Hình như em vừa nghĩ ra ba mẹ đi đâu rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277792
    m_Localized: 'Bestson: Lỡ thật ra bà là Dị Khách rồi giết ba mẹ mất tiêu thì sao? H-Hoặc là bên Thảm Họa bắt họ đi rồi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277793
    m_Localized: 'Bestson: Ủa mắc gì lại đi? Sao hông ở nhà vậy trời? Có đi thì sao hông dẫn mình theo...? TẠI SAO CHỚ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277794
    m_Localized: 'Bestson: BA MẸ BỎ CON MỘT MÌNH THÌ CON SỐNG SAO NỔI! SAO HAI NGƯỜI NỠ BỎ EM MÀ ĐI VẬY HẢ ANH!?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277795
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277796
    m_Localized: 'Bestson: Trời ơi là trời... Đi đâu mất tiêu rồi...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277797
    m_Localized: Bình tĩnh lại chưa? Giờ kể anh nghe về chị cậu được chứ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277798
    m_Localized: Anh cần kiểm tra cậu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277799
    m_Localized: 'Bestson: Dạ ừm thì, chuyện là như này...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277800
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277801
    m_Localized: 'Bestson: Trước lúc ba mẹ đi một xíu, em có nhận được lá thư.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277802
    m_Localized: 'Bestson: Thư là ba cầm đưa cho em, tại em có kiểm tra thư từ bao giờ đâu. Rồi ba kêu em đọc đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277803
    m_Localized: 'Bestson: Thì cái thư đó là do "Chị" gửi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277804
    m_Localized: 'Bestson: Chị ý viết là muốn gặp em này nọ, nhưng mà... em hổng biết phải nghĩ sao nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277805
    m_Localized: 'Bestson: Mới đầu em còn tưởng bày trò giỡn chơi cơ. Nhưng chính tay ba đưa thư cho em mà, nên chắc tín rồi đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277806
    m_Localized: 'Bestson: Rồi ba nói thật ra em hông phải con đầu lòng đâu, mà đó giờ em còn có một người chị...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277807
    m_Localized: 'Bestson: Cũng hông phải ruột thịt trăm phần trăm. Kiểu một nửa thôi. Tại tụi em cùng cha khác mẹ á.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277808
    m_Localized: 'Bestson: Nói chứ vụ này làm em thấy kỳ kỳ, khó xử lắm. Hổng biết nên làm sao luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277809
    m_Localized: 'Bestson: Kiểu, thì người ta là "chị" của em đó, nhưng cũng có khác gì người dưng đâu. Nó lạ lắm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277810
    m_Localized: 'Bestson: Em... Thật ra em cũng muốn gặp chị ý á, nhưng mà sợ quá hổng có dám.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277811
    m_Localized: 'Bestson: Hay anh gọi chị ý giùm em với nha? Số của chỉ là {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277812
    m_Localized: 'Bestson: Anh cứ... nhắn cho chỉ biết là chỉ có đứa em này đây. Nói là giờ em hông biết phải làm gì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277813
    m_Localized: 'Bestson: Trời ơi là trời... Đi đâu mất tiêu rồi...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277814
    m_Localized: Sao cậu không muốn đi gặp chị mình vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277815
    m_Localized: Anh cần kiểm tra cậu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277816
    m_Localized: 'Bestson: Thì em có quen biết gì người ta đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277821
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277822
    m_Localized: 'Bestson: Vậy là ba mẹ bỏ em mà đi thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277823
    m_Localized: 'Bestson: Trời ơi, em thề luôn, chỉ cần được gặp lại ba mẹ thì chuyện gì em cũng làm hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277824
    m_Localized: 'Bestson: Tại sao... Tại sao vậy trời...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277825
    m_Localized: Đi gặp chị cậu xem. Chị ấy sẽ không quay lưng lại với cậu đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277826
    m_Localized: Sao cậu dám chắc là ba mẹ cậu chết rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277827
    m_Localized: 'Bestson: Thật sao? Anh nghĩ vậy thật hả anh?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277828
    m_Localized: 'Bestson: Nhưng mà em...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277829
    m_Localized: 'Bestson: Đó giờ em chưa từng đi xa tới vậy một mình. Toàn đi chung với ba mẹ thôi à.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277830
    m_Localized: 'Bestson: Kiểu, chỗ chị ý nằm cách đây xa lắm. Nên em...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277831
    m_Localized: 'Bestson: Em sợ lắm. Nhắm em làm hổng nổi đâu anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277832
    m_Localized: Vậy bắt taxi xem. Giờ taxi vẫn còn chạy đó
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277833
    m_Localized: Cậu phải làm gì đi chứ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277834
    m_Localized: 'Bestson: Dạ, thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277835
    m_Localized: 'Bestson: Tại ba mẹ có thèm quay lại đón em đâu, nên là...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277836
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277837
    m_Localized: 'Bestson: Hổng biết sao nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277838
    m_Localized: Sao không thử đi tìm bà cậu xem
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277839
    m_Localized: Hay qua khu cách ly kiểm tra đi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277840
    m_Localized: 'Bestson: Ê nha, ý đó... thật ra ô kê phết. Cũng cũng...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277841
    m_Localized: 'Bestson: Nhưng mà, em nghe nói taxi giờ mắc dữ lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277842
    m_Localized: 'Bestson: Nói chứ em có đem theo tiền của ba mẹ nè. Chắc cũng đủ tiền xe qua nhà chị em ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277844
    m_Localized: 'Bestson: Dạ... anh nói cũng phải.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277845
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277846
    m_Localized: 'Bestson: Nghĩ lại thì lâu nay em cũng quá dựa dẫm vào ba mẹ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277847
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277848
    m_Localized: 'Bestson: Cám ơn anh đã giúp em thông suốt nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277849
    m_Localized: 'Bestson: Để em cố tìm taxi thử xem. Em có đem theo tiền của ba mẹ rồi, hy vọng là đủ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277853
    m_Localized: 'Bestson: Ừ chuẩn, chắc vậy thật rồi đó. Có lần ba nói cái xe muốn đem ra tiệm sửa tới nơi rồi mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277854
    m_Localized: 'Bestson: Với bà còn hông chịu mua điện thoại nữa. Biết đâu do vậy nên cả nhà mới không gọi được?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277855
    m_Localized: 'Bestson: Biết đâu... em lại gặp được cả nhà ở đó thì sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277856
    m_Localized: 'Bestson: Cám ơn anh đã giúp em thông suốt nha. Giờ em phải đi rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277857
    m_Localized: 'Bestson: Hừm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277858
    m_Localized: 'Bestson: Cũng có khả năng họ ở đó thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277859
    m_Localized: 'Bestson: Chắc phải qua tìm thử mới biết được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277860
    m_Localized: 'Bestson: Cám ơn anh đã giúp em thông suốt nha. Giờ em phải đi rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277861
    m_Localized: 'Buddy: Ui, chào anh bạn. Đang suy nghĩ gì đó?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277862
    m_Localized: Anh thấy sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277863
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277864
    m_Localized: 'Buddy: Giờ tui đang khỏe như trâu dị á!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277865
    m_Localized: 'Buddy: Nãy tui mới ngó vô tủ lạnh nhà anh coi xíu. Chà chà, tui mà biết trước anh có CẢ ĐỐNG BIA như vầy thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277866
    m_Localized: 'Buddy: Bộ anh bạn quen ai làm ở nhà máy bia hay gì hả? Đào đâu ra được cả mỏ cồn dị?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277867
    m_Localized: 'Buddy: Xì, anh hổng thích nói thì thôi. Thích thì cứ giữ làm của riêng đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277868
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277869
    m_Localized: 'Buddy: Bi đát quá anh hen? Phải chi thế giới không tan hoang như vầy, mình đã tha hồ nhâm nhi bia lạnh, rồi coi mấy trận đỉnh cao. Có khi còn được gặp–'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277870
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277871
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277872
    m_Localized: Ê, anh ổn không đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277873
    m_Localized: Sao tự dưng đứng hình vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277874
    m_Localized: 'Buddy: Hở? Sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277875
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277876
    m_Localized: 'Buddy: À kệ đi, hổng có gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277877
    m_Localized: 'Buddy: Tại tui kiểu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277878
    m_Localized: 'Buddy: Hừm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277879
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277880
    m_Localized: 'Buddy: Tui đang nghĩ ngợi linh tinh thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277881
    m_Localized: 'Buddy: Ui, chào anh bạn. Đang suy nghĩ gì đó?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277882
    m_Localized: Nay trông anh buồn vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277883
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277884
    m_Localized: 'Buddy: Tui...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277885
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277886
    m_Localized: 'Buddy: Thôi đừng nhắc tới thì hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277887
    m_Localized: Nhắc gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277888
    m_Localized: Anh đang nói chuyện gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277889
    m_Localized: 'Buddy: Thôi bỏ đi ha. Có nói anh bạn cũng hông hiểu đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277890
    m_Localized: Có vẻ quan trọng, nói tôi biết xem
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277891
    m_Localized: Anh bảo vậy thì thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277892
    m_Localized: 'Buddy: Tui đã kêu là hông muốn nói rồi, được chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277893
    m_Localized: Có vẻ quan trọng, nói tôi biết xem
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277894
    m_Localized: Anh bảo vậy thì thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471936
    m_Localized: 'Buddy: Đừng có dí tui nữa trời! Tui mợt mỏi lắm rồi đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471937
    m_Localized: 'Buddy: Để tui yên đi... được hông.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471938
    m_Localized: 'Buddy: Ừa, cám ơn anh đã hiểu ha. Nay tui thấy khó chịu trong người thôi, hông có gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471939
    m_Localized: 'Buddy: Ui, chào anh bạn. Đang suy nghĩ gì đó?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471940
    m_Localized: Rốt cuộc anh bị sao vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471941
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471942
    m_Localized: 'Buddy: Anh bạn à, đừng có xía mũi vô chiện của tui nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471943
    m_Localized: Nói thẳng ra xem nào
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471944
    m_Localized: Cứ nói đi. Không là có chuyện đấy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471945
    m_Localized: 'Buddy: Thôi hông được đâu... Nói ra anh lại quánh giá tui thì chớt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471946
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471947
    m_Localized: 'Buddy: Nhưng cứ ôm khư khư trong lòng thì cũng chỉ càng lao tâm khổ tứ mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471948
    m_Localized: 'Buddy: Chiện là... tui có nuôi một con chó. Nó... mới chớt... được mấy bữa nay rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471949
    m_Localized: Rồi sao nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471950
    m_Localized: Thì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471951
    m_Localized: 'Buddy: Ủa gì? Tính thủ tiêu tui luôn hả anh bạn?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471952
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471953
    m_Localized: 'Buddy: Thôi được rồi, anh muốn biết sự thật chớ gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471954
    m_Localized: 'Buddy: Chiện là... tui có nuôi một con chó. Nó... mới chớt... được mấy bữa nay rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471955
    m_Localized: Rồi sao nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471956
    m_Localized: Thì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471957
    m_Localized: 'Buddy: Không chỉ vậy thôi đâu. Nó cũng già nua... ốm yếu rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471958
    m_Localized: 'Buddy: Nhưng mà hông phải...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471959
    m_Localized: 'Buddy: Tui...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471960
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471961
    m_Localized: 'Buddy: Chính tui... đã giết nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471962
    m_Localized: Cái gì?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471963
    m_Localized: Đồ bệnh hoạn!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471964
    m_Localized: 'Buddy: Tui...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471965
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471966
    m_Localized: 'Buddy: Chính tui... đã giết nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471967
    m_Localized: Cái gì?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471968
    m_Localized: Đồ bệnh hoạn!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471969
    m_Localized: 'Buddy: Từ từ, bình tĩnh đã anh, nghe tui giải thích cái. Cục vàng của tui... nó bị đau, quằn quại lắm. Tui dòm mà chịu hổng nổi anh ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471970
    m_Localized: 'Buddy: Ngày nào tui cũng thấy rõ nỗi đau giày vò trong mắt nó. Đêm hôm nó cứ kêu rên ư ử vì cái chân què.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471971
    m_Localized: 'Buddy: TẤT CẢ LÀ TẠI CÁI XE MỨT DẠI ĐÓ! Đụ mẹ thằng tài xế mà có miếng nhân tính nào, thì có khi chó nhà tui nó còn sống sờ sờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471972
    m_Localized: 'Buddy: Tui chỉ muốn bẻ cổ vặt lông cái thằng mắc dịch đó, nhưng nó phóng ga chạy mất mẹ rồi. Tui còn chưa kịp để ý biển số xe...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471973
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471974
    m_Localized: 'Buddy: Anh làm sao hiểu được cảm giác mất chó cưng nó đau tới mức nào. Ừ thì tuổi thọ nó ngắn, nhưng nó cho mình nhiều bài học vô giá hơn loài người.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471975
    m_Localized: 'Buddy: Người ta vẫn hay nói đó: thú cưng chỉ là chương ngắn trong cuộc sống của mình, nhưng mình lại là cả câu chiện đời nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471976
    m_Localized: Được rồi, anh cứ ở lại
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471977
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471978
    m_Localized: 'Buddy: Ừa tui biết... Tui biết mình khốn nạn lắm. Sao tui dám tha thứ cho bản thân được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471979
    m_Localized: 'Buddy: Tại tui thấy nó... đau đớn quá, quằn quại quá. Tui dòm mà chịu hổng nổi anh ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471980
    m_Localized: 'Buddy: Càng ngày sức khỏe của nó càng tệ đi. Cứ đêm hôm là nó lại kêu rên ư ử, ứa hết nước mắt...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471981
    m_Localized: 'Buddy: Anh bạn thấy cảnh chó khóc bao giờ chưa? Mắt của nó dòm tội thắt ruột gan, cứ như đang cầu xin tui kết thúc nỗi đau đó dị.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471982
    m_Localized: 'Buddy: Kỳ thực tui cũng có muốn dị đâu! Tui thề có trời đất chứng giám! Tay tui làm sao mà nỡ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471983
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471984
    m_Localized: 'Buddy: MẸ CÁI THẰNG CHÓ TẮC-XI!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471985
    m_Localized: 'Buddy: Nó lái mắt nhắm mắt mở kiểu gì mà cán qua cục vàng của tui. Xong thì lủi đi ngang xương dị đó, như đéo có chiện gì xảy ra!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471986
    m_Localized: 'Buddy: Đụ má nó làm như mới lái qua ổ gà, chớ đéo phải đâm trúng con cưng nhà người ta!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471987
    m_Localized: 'Buddy: Tui chỉ muốn bẻ cổ vặt lông cái thằng mắc dịch đó, nhưng nó phóng ga chạy mất mẹ rồi. Tui còn chưa kịp để ý biển số xe...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471988
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471989
    m_Localized: 'Buddy: Anh làm sao hiểu được cảm giác mất chó cưng nó đau tới mức nào. Ừ thì tuổi thọ nó ngắn, nhưng nó cho mình nhiều bài học vô giá hơn loài người.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471990
    m_Localized: 'Buddy: Người ta vẫn hay nói đó: thú cưng chỉ là một chương ngắn trong cuộc sống của mình, nhưng mình lại là cả câu chiện đời nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471991
    m_Localized: Được rồi, anh cứ ở lại
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471992
    m_Localized: Thôi anh đi chỗ khác giùm
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471993
    m_Localized: 'Buddy: Cám ơn nha, bạn hiền.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471994
    m_Localized: 'Buddy: Cũng may là anh chịu hiểu cho tui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471995
    m_Localized: 'Buddy: Ừa, anh bạn nói có lý. Tui nên đi cho nó lành.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471996
    m_Localized: 'Buddy: Ngày nào tui cũng trăn trở chiện đó... Rút cục mình làm dị có đúng hông? Để nó hông phải chịu khổ nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471997
    m_Localized: 'Buddy: Chắc tới chớt tui cũng hổng biết được...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471998
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471999
    m_Localized: 'Fatman: Hààà... nước lạnh đây rồi. Thế chứ lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472000
    m_Localized: Ông thấy đỡ hơn chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472001
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472002
    m_Localized: 'Fatman: Ừ, ừ, đỡ. Đỡ nhiều rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472003
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472004
    m_Localized: 'Fatman: Chẹp...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472005
    m_Localized: 'Fatman: Mà anh đang thấy hơi hơi đói bụng rồi đấy. Nhà chú có mồi gì nhắm không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472006
    m_Localized: Đây (Đưa ông ta một lon bia)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472007
    m_Localized: 'Fatman: Không có bia à? Chú cứ đùa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472008
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472009
    m_Localized: 'Fatman: Nãy anh mới thấy trong tủ lạnh chú đầy bia mà! Nốc hết rồi hay sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472010
    m_Localized: Không
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472011
    m_Localized: 'Fatman: Tuyệt vời! Uống lạnh mới là sảng khoái!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472012
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472013
    m_Localized: 'Fatman: Khàààààà... Đúng tủ anh rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472014
    m_Localized: 'Fatman: Đây, anh cho chú mấy đồng này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472015
    m_Localized: 'Fatman: (Gã dúi vào tay bạn vài tờ tiền nhàu nát. Giờ cũng chẳng còn giá trị gì)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472016
    m_Localized: Ờm... Cảm ơn ông
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472017
    m_Localized: Tôi cần tiền của ông làm đéo gì
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472018
    m_Localized: 'Fatman: Hà hà! Phải thế chứ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472019
    m_Localized: 'Fatman: Có qua có lại mà, chú tung thì anh hứng, chú nâng anh thì anh, hè hèm, đỡ thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472020
    m_Localized: 'Fatman: Cứ yên trí là anh còn nữa... Bạn bè gần xa là anh cho hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472021
    m_Localized: 'Fatman: À với cả... anh có cái này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472022
    m_Localized: 'Fatman: (Gã cho bạn một bình trà kombucha)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472023
    m_Localized: 'Fatman: Chắc chỉ có dân mọi rợ mới uống cái này, cơ mà e hèm, biết đâu chú lại cần dùng đến.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472024
    m_Localized: 'Fatman: Ui giời! Căng thế! Tưởng anh hết thời nên chú được đằng chân lên đằng đầu hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472025
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472026
    m_Localized: 'Fatman: Có tiền mua tiên cũng được! Làm gì có ai không cần tiền!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472027
    m_Localized: 'Fatman: Thế thôi, lấy cái này đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472028
    m_Localized: 'Fatman: (Gã cho bạn một bình trà kombucha)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472029
    m_Localized: 'Fatman: Chắc chỉ có dân mọi rợ mới uống cái này, cơ mà e hèm, biết đâu chú lại cần dùng đến.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472030
    m_Localized: 'Fatman: Sao lại không? Xời! Tưởng chú cao sang quá, không mua chuộc được chứ gì? Cái gì cũng có giá của nó cả! Dù là con người, đồ vật, hay tình cảm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472031
    m_Localized: 'Fatman: Có tiền là có hết, chú bé ạ! Nhìn anh xem, anh làm bộ trưởng luôn mà! Khà khà!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472032
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472033
    m_Localized: 'Fatman: Thế thôi! Kệ cha mày! Sau này có hối thì đừng quay về liếm chân ông nhá!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472034
    m_Localized: 'Fatman: Hààà... nước lạnh đây rồi. Thế chứ lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472035
    m_Localized: Ông có cần gì nữa không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472036
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472037
    m_Localized: 'Fatman: Ô hô, anh đợi chú mãi! Đang thèm rít thuốc quá. Chú đưa anh một điếu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472038
    m_Localized: ...Đây (Đưa thuốc lá)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472039
    m_Localized: 'Fatman: Sao, không có thuốc à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472040
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472041
    m_Localized: 'Fatman: Ờ, thế thôi! Cứ để mặc ông đây chịu khổ đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472042
    m_Localized: Không
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472043
    m_Localized: 'Fatman: Phải thế chứ lị!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472044
    m_Localized: 'Fatman: Lúc trước anh phải hút xì gà mới phê cơ... nhưng mà bây giờ thì đào đâu ra được nữa. Hờ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472045
    m_Localized: 'Fatman: Hồi anh còn làm ủy ban, à hèm, nó khác bọt hẳn. Giờ nhìn đâu cũng thấy giết chóc, loạn lạc... Chẳng khác gì địa ngục trần gian!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472046
    m_Localized: 'Fatman: Bọn Phòng Chống Thảm Họa chả thấy đi phòng chống bao giờ nhỉ? Tưởng chúng nó đẻ ra chỉ biết đứng múa may quay cuồng thôi ấy chứ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472047
    m_Localized: 'Fatman: Chẹp! Hồi anh mày còn ngồi ghế, làm gì có mấy chuyện bê bối này. Nhưng xưa rồi Diễm ơi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472048
    m_Localized: 'Fatman: Mà chắc là chúng nó cần thêm thời gian thôi. Rồi, rồi... cái gì cũng sẽ đâu vào đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472049
    m_Localized: Ông từng làm ủy ban á?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472050
    m_Localized: Ông hỗ trợ thành lập Phòng Chống Thảm Họa à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472051
    m_Localized: 'Fatman: Thì đúng rồi, anh vừa nói với chú thây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472052
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472053
    m_Localized: 'Fatman: À, đây... Cho chú vài đồng, e hèm, coi như hoa hồng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472054
    m_Localized: 'Fatman: (Gã dúi vào tay bạn mấy tờ tiền nhàu nát, vô giá trị, và một tấm bưu thiếp đóng dấu PCTH)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472055
    m_Localized: 'Fatman: Ai bảo chú thế hử?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472056
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472057
    m_Localized: 'Fatman: À, đây... Cho chú vài đồng, e hèm, coi như hoa hồng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472058
    m_Localized: 'Fatman: (Gã dúi vào tay bạn mấy tờ tiền nhàu nát, vô giá trị, và một tấm bưu thiếp đóng dấu PCTH)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472059
    m_Localized: 'Fatman: Không gì mà không?! Có biết bố mày là ai không hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472060
    m_Localized: 'Fatman: Ông đây làm bộ trưởng đấy! Tai to mặt lớn đấy! Thiếu ông cầm cương là bộ máy chính quyền đi đứt chứ còn gì nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472061
    m_Localized: 'Fatman: Ông chính là đại diện của nhân dân! Không có ông, còn lâu dân đen thấp cổ bé họng bọn mày mới có tiếng nói. Đừng có mơ! Nhờ công ông hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472062
    m_Localized: 'Fatman: Bình thường mày mà dám bật ông như thế là xác định! Người ta lôi cổ mày đi ngay tức khắc đấy chứ đùa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472063
    m_Localized: 'Fatman: Chậc! Lên hẳn chức bộ trưởng mà giờ chẳng ai coi ra gì. Chúng mày tưởng bọn ông chỉ có ngồi văn phòng gõ phím thôi chắc...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472064
    m_Localized: 'Fatman: Chống mắt lên mà xem, trời sập xuống một cái là chúng mày lại quay ra bám váy bọn ông ngay! Hờ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472065
    m_Localized: 'Fatman: Hààà... nước lạnh đây rồi. Thế chứ lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472066
    m_Localized: Ông có cần gì nữa không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472067
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472068
    m_Localized: 'Fatman: Chú bé này tinh đấy! Được!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472069
    m_Localized: 'Fatman: Anh đang thèm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472070
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472071
    m_Localized: 'Fatman: À rồi! Cho anh lon nước tăng lực! Làm tí cho nó, e hèm, lại sức nhể!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472072
    m_Localized: Rồi, đây (Đưa lon nước tăng lực)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472073
    m_Localized: 'Fatman: Chậc! Enerjeka mà cũng chả có?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472074
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472075
    m_Localized: 'Fatman: Ờ, thế thôi! Cứ để mặc ông đây chịu khổ đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472080
    m_Localized: Chịu thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472081
    m_Localized: 'Fatman: Ô hô! Ngon, ngon, quá ngon!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472082
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472101
    m_Localized: 'Fatman: Ui giồi! Cái này không đường à? Uống nhạt cả mồm!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472104
    m_Localized: 'Fatman: Thà uống nước cống cho xong! Có khi còn... Hả, chú vừa bảo gì cơ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472105
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472106
    m_Localized: 'Fatman: Chú mày hâm à? Thông tin mật của người ta, kể thế nào mà kể?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472107
    m_Localized: 'Fatman: Anh mày ký giấy thỏa thuận rồi, không tiết lộ được đâu. Không là không nhá! Chú mày tuổi gì mà đòi biết!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472108
    m_Localized: 'Fatman: Này, làm tí cà phê đi, hỏi han ít thôi. Đấy, có phải hơn không.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472109
    m_Localized: 'Fatman: (Gã đưa bạn lon cà phê)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472110
    m_Localized: 'Fatman: Lại Enerjeka à? Úi xời! Ai biết bọn nó tẩm hóa chất gì trong đấy... Từ từ, mày mới hỏi anh cái gì đấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472111
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472112
    m_Localized: 'Fatman: Chú mày hâm à? Thông tin mật của người ta, anh đem kể cho chú sao được?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472113
    m_Localized: 'Fatman: Anh mày ký giấy thỏa thuận rồi, không tiết lộ được đâu. Không là không nhá! Chú mày tuổi gì mà đòi biết!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472114
    m_Localized: 'Fatman: Này, làm tí cà phê đi, hỏi han ít thôi. Đấy, có phải hơn không.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472115
    m_Localized: 'Fatman: (Gã đưa bạn lon cà phê)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472116
    m_Localized: 'Fatman: Ô hay! Có thực mới vực được đạo chứ. Bụng rỗng thế này thì anh, e hèm, làm việc kiểu gì hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472117
    m_Localized: "Fatman: Anh đây vì nhân dân quên mình!\nVì nhân dân hy sinh!"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472118
    m_Localized: 'Fatman: Nhưng nhân dân thì chê đến cạn tình! ...Mày tưởng mày ngon lắm hả? Giỏi thì vào mà làm, xem được đến đâu. Sao hửm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472119
    m_Localized: 'Fatman: ...Đấy biết ngay. Chỉ thích góp ý mà chả ưa góp mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472120
    m_Localized: 'Fatman: Hààà... nước lạnh đây rồi. Thế chứ lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472121
    m_Localized: Sao? Ông cần gì nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472122
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472123
    m_Localized: 'Fatman: Chú mày tinh đấy. Cho anh khẩu súng đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472124
    m_Localized: Sao cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472125
    m_Localized: Ông điên mẹ nó rồi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472126
    m_Localized: 'Fatman: Đúng, đúng, đúng rồi. Đưa anh nào. Để anh còn bảo vệ bản thân nữa chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472127
    m_Localized: 'Fatman: Ngày xưa anh đi săn suốt thôi. Có gì đâu mà không biết dùng súng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472128
    m_Localized: Còn khuya nhé
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472129
    m_Localized: Chết mẹ ông đi!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472130
    m_Localized: 'Fatman: Cẩn thận cái mồm. Mày biết bố mày là ai không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472131
    m_Localized: 'Fatman: Ông đây búng tay một phát là chú mày được vé ngồi nhà giam nhé. Hờ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472132
    m_Localized: Còn khuya nhé
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472134
    m_Localized: 'Fatman: M-Mày bảo gì cơ? Tao... Tao là BỘ TRƯỞNG đấy nhé!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472135
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472136
    m_Localized: 'Fatman: Mày chết! Mày TÀN ĐỜI rồi con ạ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472137
    m_Localized: 'Fatman: Lo mà khăn gói đi, mày sắp sửa ở tù mục xương rồi. KHÀ KHÀ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472138
    m_Localized: Trong mắt thằng này, ông cũng chỉ là Dị Khách giẻ rách mà thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472139
    m_Localized: Ai hỏi mà bộ trưởng trả lời. Ông chả là cái thá gì
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472140
    m_Localized: 'Fatman: Mày cẩn thận cái mồm! Tao là đại diện cho tiếng nói của nhân dân đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472141
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472142
    m_Localized: 'Fatman: Mày tới số rồi. TỚI SỐ RỒI CON Ạ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472143
    m_Localized: 'Fatman: Ô hô! Mày dám đắc tội với ông cơ à. Bộ trưởng nắm bao nhiêu chức quyền, có biết không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472144
    m_Localized: 'Fatman: ...Rồi mày sẽ phải ngoan ngoãn vâng lời thôi, con ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472145
    m_Localized: Trong mắt thằng này, ông cũng chỉ là Dị Khách giẻ rách mà thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472146
    m_Localized: Ai hỏi mà bộ trưởng trả lời. Ông chả là cái thá gì
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472147
    m_Localized: 'Fatman: Á à, mày... mày... QUÂN XẤC LÁO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472148
    m_Localized: 'Fatman: Chuẩn bị vào nhà đá đi con! Sắp rồi đấy! Cứ chờ mà xem! HỜ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472149
    m_Localized: 'Fatman: Á à, mày... mày... QUÂN XẤC LÁO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472151
    m_Localized: 'Fatman: Hààà... nước lạnh đây rồi. Thế chứ lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472152
    m_Localized: Đâu? Nhà đá đâu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472153
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472154
    m_Localized: 'Fatman: Á à, mày thích kháy đểu ông phải không? Cười người hôm trước, hôm sau người cười đấy con ạ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472155
    m_Localized: Cái danh cái chức giờ chỉ là hão thôi. Ông chả là cái đinh gì nữa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472156
    m_Localized: Tiền tài của cải giờ cũng bằng không. Ông chưa thông nữa à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472157
    m_Localized: 'Fatman: Láo toét! Tao... là người làm nhà nước đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472158
    m_Localized: 'Fatman: Chỉ là... e hèm... họ cho tao nghỉ phép dài hạn thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472159
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472160
    m_Localized: 'Fatman: Hờờờ... Đùa ai vậy chứ... Cuộc đời vĩnh viễn có quay về như xưa nữa đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472161
    m_Localized: 'Fatman: Hồi anh còn đi làm, bộ trưởng đã đứng thì cả nước phải quỳ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472162
    m_Localized: 'Fatman: Ai ai gặp anh cũng phải khép nép cúi đầu. Ra đường xe phải dạt, người phải xin, xun xoe xu nịnh liên tục. Còn giờ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472163
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472164
    m_Localized: 'Fatman: Đấy. Căng thẳng cái là bụng anh lại đau quặn đây này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472165
    m_Localized: 'Fatman: Vừa lòng chú mày chưa? Thôi đi đi. Anh chịu hết nổi rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472166
    m_Localized: 'Fatman: V-Vớ vẩn! Anh còn bao nhiêu là tiền!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472167
    m_Localized: 'Fatman: Mày không quan tâm thì thôi, nhưng... nhưng trên đời ai chả cần tiền...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472168
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472170
    m_Localized: 'Fatman: Không tiền, không tình, không nhà, không xe...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472171
    m_Localized: 'Fatman: Trước đây quy luật cuộc sống đơn giản lắm. Cứ có tiền là mình có quyền!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472172
    m_Localized: 'Fatman: Phải chăng thảm họa đừng ập tới thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472173
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173076770816
    m_Localized: 'Fatman: Thôi anh mệt lắm rồi. Để anh yên.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173093548032
    m_Localized: 'Fatman: Xùy. Có gì mai nói chuyện tiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666293
    m_Localized: 'Dude: Có gì hot hông, bro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666301
    m_Localized: 'Dude: Có gì hot hông, bro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666319
    m_Localized: 'Dude: Có gì hot hông, bro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666340
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666346
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666350
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666354
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666355
    m_Localized: 'Dude: Thôi tui sủi đây, thân ái không hẹn gặp lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860544
    m_Localized: 'Ballerina: Có bé mèo đây. Muốn gì nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860545
    m_Localized: Sao cô lại đến đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860546
    m_Localized: Tôi cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860547
    m_Localized: 'Ballerina: Hỏi đần vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860548
    m_Localized: 'Ballerina: Cậu mở cửa mà. Tự hỏi mình đi. Hỏi tôi làm gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860549
    m_Localized: 'Ballerina: Tôi thấy đâu cũng vậy. Như nhau hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860550
    m_Localized: 'Ballerina: Bảo đến đây, thì đến.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860551
    m_Localized: 'Ballerina: Tôi chẳng muốn gì. Không cần cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860552
    m_Localized: 'Ballerina: Chỉ cần chỗ tốt cho mèo. Còn lại, ai quan tâm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860553
    m_Localized: 'Ballerina: Có bé mèo đây. Muốn gì nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860554
    m_Localized: Cô có phải người không thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860555
    m_Localized: Tôi cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860556
    m_Localized: 'Ballerina: Còn cậu sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860557
    m_Localized: 'Ballerina: Trong cậu còn gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860558
    m_Localized: 'Ballerina: Tôi tệ hơn chỗ nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860559
    m_Localized: 'Ballerina: Có bé mèo đây. Muốn gì nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860560
    m_Localized: Ai sai cô tới đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860561
    m_Localized: Tôi cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860562
    m_Localized: 'Ballerina: Cậu làm cái cần làm rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860563
    m_Localized: 'Ballerina: Biết thêm làm gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860564
    m_Localized: 'Ballerina: Ừ. Có người... sai tôi tới.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860565
    m_Localized: 'Ballerina: Nhưng không nói gì thêm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860566
    m_Localized: 'Ballerina: Có bé mèo đây. Muốn gì nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860567
    m_Localized: Cô định ở đây tới bao giờ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860568
    m_Localized: Tôi cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860569
    m_Localized: 'Ballerina: Tới khi họ đến tìm tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860570
    m_Localized: 'Ballerina: Biết làm gì khác? Hở?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860571
    m_Localized: 'Ballerina: Không biết. Họ bảo tôi, giờ tôi đợi bảo thêm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860572
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860573
    m_Localized: 'Ballerina: Còn cậu có ai bảo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860574
    m_Localized: 'Ballerina: Cậu đang chờ ai?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860575
    m_Localized: 'Ballerina: Có bé mèo đây. Muốn gì nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860576
    m_Localized: Sao cô chưa giết tôi nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860577
    m_Localized: Tôi cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860578
    m_Localized: 'Ballerina: Cậu biết cậu ngu tí không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860579
    m_Localized: 'Ballerina: Mỗi ngày, cứ vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860580
    m_Localized: 'Ballerina: Nói cậu rồi. Họ có bảo đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860581
    m_Localized: 'Ballerina: Tôi chờ. Còn cậu sao chờ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860582
    m_Localized: 'Mother: Trong nhà bí thực sự...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860585
    m_Localized: 'Mother: Hở? À, thằng nhỏ... cũng mệt như chị thôi. Con chị nhát người lạ lắm, nên nó bám mẹ còn hơn bình thường.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860586
    m_Localized: 'Mother: Con nít mà em, gặp mấy chuyện này thì khó lắm. Nó giả bộ im im hổng nói gì thôi, chứ dòm mặt là biết liền.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860587
    m_Localized: 'Mother: Nhiều lúc chị cảm giác... tại chị mà tụi nhỏ mới phải chịu cực chịu khổ như vầy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860588
    m_Localized: 'Mother: Nhưng giờ thì thay đổi được gì nữa chớ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860589
    m_Localized: 'Couple: Kìa em yêu, đừng dỗi anh mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860590
    m_Localized: Sao hai vợ chồng lại ra ngoài đường thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860592
    m_Localized: 'Couple: À, chúng tôi đang trên đường qua thăm nhà mẹ vợ yêu của tôi ấy mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860593
    m_Localized: 'Couple: Giữa chừng thì mới thấy không đi nổi nữa, may thế nào đi ngang qua nhà chú.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860594
    m_Localized: 'Couple: Cảm ơn chú đã cho vợ chồng tôi trú nhờ nha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860595
    m_Localized: 'Couple: Kìa em yêu, đừng dỗi anh mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860596
    m_Localized: Anh chị còn phải đi bao xa nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860598
    m_Localized: 'Couple: Bà xã nhà tôi tìm đường hơi kém tí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860599
    m_Localized: 'Couple: Nếu không có ai giúp thì chắc mất tầm hai ngày nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860600
    m_Localized: 'Couple: Còn chưa tính mấy lần bọn tôi mò đường rồi đi lạc đâu. Hà hà! Phải không vợ yêu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860601
    m_Localized: 'Couple: Nếu có ai cho chúng tôi đi nhờ thì tốt quá. Như thế cùng lắm chỉ mất có vài tiếng thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860602
    m_Localized: Sao hai người phải vội vàng thăm mẹ vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860603
    m_Localized: Nghe chẳng hợp lý gì cả
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860604
    m_Localized: 'Couple: Kìa chú, tình hình bây giờ đang rối ren thế, ngộ nhỡ mẹ cô ấy có mệnh hệ gì thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860605
    m_Localized: 'Couple: Mà điện thoại bà ấy còn tắt nữa. Vợ chồng tôi mấy ngày rồi không liên lạc được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860606
    m_Localized: 'Couple: Nhỡ bà ấy cần giúp gì thì sao? Phải đi thăm xem thế nào rồi chứ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860607
    m_Localized: 'Couple: Đang ngày dài đêm ngắn thế này, đi ngoài đường sợ chết khiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860608
    m_Localized: 'Couple: Mà thôi không sao đâu. Vợ chồng mình sắp được gặp mẹ rồi, cục cưng của anh cứ yên tâm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860609
    m_Localized: 'Couple: Tôi cũng không nhớ đường đi, mà vợ tôi chỉ đường lại hơi ngẫn ngẫn tí. Ngốc xít thế cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860612
    m_Localized: 'Couple: Kìa em yêu, đừng dỗi anh mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860613
    m_Localized: Tưởng đêm nay hai anh chị đi luôn chứ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860615
    m_Localized: 'Couple: Định vậy nhưng mà, cô vợ ngốc nghếch đáng yêu của tôi chuẩn bị gì mà mất ba tiếng lận. Giờ muốn đi cũng muộn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860616
    m_Localized: 'Couple: Đành để hôm sau đi vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860617
    m_Localized: 'Couple: Xin lỗi chú nha. Hứa hôm sau chúng tôi sẽ thu xếp nhanh gọn lẹ hơn!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860618
    m_Localized: 'Couple: Đúng cô công chúa lề mề, phải dạy dỗ bảo ban lại mới được. Hề hề hề!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860619
    m_Localized: 'Couple: Hay là chúng tôi làm đang khó chú quá à? Có gì chú cứ nói thẳng nha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860620
    m_Localized: 'Couple: Kìa em yêu, đừng dỗi anh mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860621
    m_Localized: Chị ơi, chị có sao không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860623
    m_Localized: 'Couple: Sao trăng gì, vợ tôi chả sao hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860624
    m_Localized: 'Couple: Tôi nói hộ hết rồi thì vợ tôi cần gì phải mở miệng nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860625
    m_Localized: 'Couple: Với lại em ấy chỉ đang hơi bồn chồn lo lắng thôi. Chú không cần lo thừa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860626
    m_Localized: Tôi đang hỏi chị ấy mà
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860628
    m_Localized: 'Couple: Ừ, thì tôi bảo là người ta đang mệt rồi. Chú đừng ép nữa mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860632
    m_Localized: 'Couple: Ơ kìa, gái ơi, nhanh cái chân lên. Ô hay! Định lề mề đến bao giờ nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860633
    m_Localized: 'Couple: À, không có vấn đề gì đâu, chú yên tâm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860638
    m_Localized: 'Couple: Kìa em yêu, đừng dỗi anh mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860639
    m_Localized: Vợ anh không muốn đi kìa. Sao thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860641
    m_Localized: 'Couple: Sao gì? Nó đang làm tôi bực vãi cả mình chứ sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860642
    m_Localized: 'Couple: Suốt ngày lải nhải đổ lỗi cho tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860643
    m_Localized: 'Couple: Có mỗi cái việc ngậm mồm lại, bảo gì thì làm nấy. Thế mà cũng không làm được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860644
    m_Localized: 'Couple: Xin lỗi chú nhá, vợ chồng tôi ở lại hơi lâu rồi. Chúng tôi đang dọn đồ, thề hôm nay là ngày cuối.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860645
    m_Localized: 'Couple: Nghe rõ chửa? Nhanh dọn đồ đi. Đêm nay mà còn ở lại đây thì tao cho mày một trận văng ra ngoài cửa sổ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860646
    m_Localized: Chị ơi, chị có ổn thật không vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860648
    m_Localized: 'Couple: Mày đừng có can thiệp. Tao đã nói rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860649
    m_Localized: 'Couple: Chuyện không liên quan đến mày thì đừng có chõ mõm vào làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860650
    m_Localized: 'Couple: Bọn tao tự giải quyết với nhau, còn mày cút ra chỗ khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860651
    m_Localized: Ông xàm lồn đủ rồi đấy. Nói thật đi. NHANH!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860652
    m_Localized: Sao cũng được. Thế hai người có đi hay không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860653
    m_Localized: 'Couple: Kìa, chú bình tĩnh. Có chuyện gì đâu mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860654
    m_Localized: 'Couple: Con vợ nhà tôi đang... chán nên nó mới giở chứng thôi. Chẳng qua lâu lâu cứ thế, làm tôi bực hết cả mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860655
    m_Localized: 'Couple: Chú còn muốn gì nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860656
    m_Localized: Ông xàm lồn đủ rồi đấy. Nói thật đi. NHANH
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860657
    m_Localized: Sao cũng được. Thế hai người có đi hay không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860658
    m_Localized: 'Couple: Nào, cứ bình tĩnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860659
    m_Localized: 'Couple: Tao có súng đây này. Mày giở trò gì là tao bắn vỡ sọ con đĩ này đấy nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860660
    m_Localized: 'Couple: Tao không còn gì để mất đâu. Nhưng mày thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860661
    m_Localized: Kiểu gì ông chả chết
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860663
    m_Localized: 'Couple: Ờ ờ, cứ kệ bọn tôi, không cần chú phải lo đâu, anh chủ bô giai ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860664
    m_Localized: 'Couple: Bọn tôi đi luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054848
    m_Localized: 'Couple: Mày nghe chưa con kia? Tối nay là đi rồi. Đừng có lằng nhằng, chuẩn bị ngay đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054849
    m_Localized: 'Couple: Tao còn gì để mất đâu? Mày giết tao thì được cái gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054850
    m_Localized: 'Couple: Chết là xong, hết đời, hết khổ. Con khốn này xuống địa ngục cùng tao luôn. Quá hời.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054851
    m_Localized: Tao bắn đấy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054852
    m_Localized: Bình tĩnh nào. Ông bỏ súng xuống đi, tôi cũng bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054853
    m_Localized: 'Couple: Sao tao phải làm thế? Tao đang cần đi cùng con đĩ này cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054854
    m_Localized: 'Couple: Nó không chịu thì tao cũng chả đi. Mày bỏ súng xuống thì bọn tao sẽ đi khuất mắt mày trong tối nay luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054855
    m_Localized: 'Couple: Không cần phải đổ máu làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054863
    m_Localized: 'Couple: Tao phải rời khỏi đây. Không thì hai đứa bọn tao cùng chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054864
    m_Localized: 'Couple: Không còn lựa chọn nào khác đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054865
    m_Localized: 'Couple: Phải mà ngay từ đầu con điếm này đừng có run run rẩy rẩy, khẩn trương cuốn gói cút mẹ luôn rồi thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054866
    m_Localized: 'Couple: Tại mày cả đấy. Nghe chưa hả con đĩ ngu lồn này? Bung bét hết lên rồi, vừa lòng mày chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054867
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054868
    m_Localized: Cảnh cáo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054869
    m_Localized: 'Couple: Mày... Mày bỏ súng xuống thật à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054870
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054871
    m_Localized: 'Couple: Ơ ơ này, mày vẫn định bắn tao á?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054872
    m_Localized: 'Couple: KHOAN! ĐỪNG MÀ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054875
    m_Localized: 'Couple: (Người phụ nữ vùng dậy thoát khỏi tay gã. Ngay lập tức, gã bắn chết chị ấy)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054876
    m_Localized: 'Couple: (Bạn phản ứng trong tích tắc, bắn lủng đầu gã)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054877
    m_Localized: 'Couple: (Vậy là hai người đều mất mạng... Ít nhất thì mọi chuyện cũng đã kết thúc)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054878
    m_Localized: 'Couple: ("Vợ chồng" nhà này đúng là điên thật...)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054937
    m_Localized: 'Luka: Sau cơn mưa, nhất định trời sẽ sáng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054938
    m_Localized: Anh vẫn phơi phới được à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054939
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054940
    m_Localized: 'Luka: Cũng chẳng phơi phới gì... nhưng may là tớ không bị suy sụp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054941
    m_Localized: 'Luka: Chúng ta vẫn là người trần mắt thịt thôi. Vẫn luôn kiên cường sống tiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054945
    m_Localized: 'Luka: Tớ nói gì cậu có hiểu không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054946
    m_Localized: 'Luka: Sau cơn mưa, nhất định trời sẽ sáng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054948
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054949
    m_Localized: 'Luka: Thật ra thì... không phải đâu. Ngày trước, tớ mang trong mình rất nhiều nỗi uất hận. Hận mình, hận người, hận cả thế gian.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054950
    m_Localized: 'Luka: Có lần tớ giận quá, đập cửa mạnh tới mức gãy cả bản lề. Nhưng rồi một ngày kia, tớ nhận ra rằng cảm xúc nóng giận chỉ biết hủy hoại mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054951
    m_Localized: 'Luka: Ban đầu nó ăn mòn tâm trí, linh hồn mình, rồi sau đó nghiền nát hết mọi thứ xung quanh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054952
    m_Localized: 'Luka: Có lần... tớ trót nổi quạu với một người có thành ý giúp đỡ mình. Giờ người ấy... đi mất rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054953
    m_Localized: 'Luka: Khoảnh khắc đó, tớ sực choàng tỉnh. Tớ nhận ra rằng mình phải thay đổi thôi, không thì sớm muộn gì cũng phá hoại tất cả.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054954
    m_Localized: 'Luka: Từ đó, tớ học cách buông bỏ, hít thở thật sâu, giữ tâm hồn an yên. Nhờ vậy mà tớ sống được tới bây giờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054955
    m_Localized: 'Luka: Sau cơn mưa, nhất định trời sẽ sáng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054956
    m_Localized: Anh đã mất đi những gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054957
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054958
    m_Localized: 'Luka: Gia đình của tớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054959
    m_Localized: 'Luka: Lúc đó tớ chỉ ra ngoài một chút để lấy nước thôi. Vậy mà khi trở về, căn nhà đã cháy rụi. Chẳng còn gì ngoài khói bụi và tàn tro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054960
    m_Localized: 'Luka: Tớ cứ dằn vặt mãi. Tại sao mình lại ra ngoài ngay lúc đó? Tại sao mình không thể cứu họ? Phải mất một thời gian, tớ mới dám đối diện với sự thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054961
    m_Localized: 'Luka: Nhưng chuyện đã rồi thì đâu thể cứu vãn. Điều quan trọng không phải là thay đổi quá khứ, mà là học cách chấp nhận và sống tiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054962
    m_Localized: 'Luka: Những người đã khuất vẫn luôn bên tớ. Khi nhớ về họ, tớ lại được tiếp thêm sức mạnh để dấn bước. Vì vậy tớ luôn nỗ lực giúp đỡ mọi người.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054963
    m_Localized: 'Luka: Tớ đã nếm trải nỗi đau tột cùng... khi mất hết tất cả. Vậy nên tớ rất hiểu cảm giác đó, hiểu phải làm sao để tìm lại mục đích sống khi thế giới của mình sụp đổ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054964
    m_Localized: 'Luka: Sau cơn mưa, nhất định trời sẽ sáng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054965
    m_Localized: Mất cả gia đình rồi mà anh vẫn còn nghị lực để sống tiếp ư?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054966
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054967
    m_Localized: 'Luka: Ừ cậu. Tớ đã vượt qua nỗi đau, dù chẳng dễ dàng chút nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054968
    m_Localized: 'Luka: Suốt một thời gian dài, tớ luôn ăn năn, giày vò bản thân. Giá mà mình quay về sớm hơn vài phút thì có khi chuyện đã khác rồi…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054969
    m_Localized: 'Luka: Nhưng rồi tớ thấy mình cần buông bỏ, để không đánh mất bản thân. Mặc cảm tội lỗi chỉ làm nỗi đau thêm xé lòng mà thôi. Phải tha thứ thì mới sống tiếp được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054970
    m_Localized: 'Luka: Và chính bài học đó đã cứu vớt tớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054971
    m_Localized: 'Luka: Tớ tha thứ cho bản thân dù không thể thay đổi quá khứ, thậm chí tha thứ cho số phận nghiệt ngã. Vì tớ không muốn để cơn giận kiểm soát mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054972
    m_Localized: 'Luka: Sau cơn mưa, nhất định trời sẽ sáng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054973
    m_Localized: Động lực nào thúc đẩy anh sống tiếp?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054974
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054975
    m_Localized: 'Luka: Tớ tin con người ta có thể trở nên lương thiện hơn. Dù ở giữa thảm họa tăm tối, vẫn sẽ có tia sáng cuối con đường.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054976
    m_Localized: 'Luka: Tớ chẳng tin vào phép màu hay thần thánh gì cả. Nhưng tớ tin ở con người. Tin vào sức mạnh đoàn kết, nâng đỡ nhau của chúng ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054982
    m_Localized: 'Luka: Dĩ nhiên là có chứ! Ôi, nếu được đoàn tụ với họ, tớ sẽ nhào đến ôm hôn, thủ thỉ đủ điều với từng người một...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443456
    m_Localized: 'Cold: Giá mà có chút h-hơi ấm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443457
    m_Localized: Anh vẫn mặc áo khoác à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443458
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443459
    m_Localized: 'Cold: Ừ, t-tôi bị sợ chuyện này ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443460
    m_Localized: 'Cold: Tôi mà c-c-cởi áo khoác ra thì thế nào đây? Có n-nắng như thiêu người tôi cũng không ấm lên được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443461
    m_Localized: 'Cold: Cởi áo xong, có khi nào tôi sẽ ch-chết vì l-lạnh luôn không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443462
    m_Localized: 'Cold: Hay khủng khiếp hơn, không những chẳng chết mà còn thấy l-l-lạnh thêm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443463
    m_Localized: Mặc như này mà anh không toát mồ hôi sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443464
    m_Localized: Thế anh không tắm rửa gì à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443465
    m_Localized: 'Cold: Tôi kh-không.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443466
    m_Localized: 'Cold: Cơ thể toát mồ hôi là để h-hạ nhiệt mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443467
    m_Localized: 'Cold: ...Mà người tôi chắc h-h-hạ hết cỡ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443468
    m_Localized: 'Cold: Tôi kh-không trả lời câu đấy đâu. X-Xin lỗi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443469
    m_Localized: 'Cold: Giá mà có chút h-hơi ấm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443470
    m_Localized: Thân nhiệt như thế thì anh tính thế nào đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443471
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443472
    m_Localized: 'Cold: Hừừ... Ch-Chắc tôi cũng chẳng làm được gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443473
    m_Localized: 'Cold: Tắm nước nóng chỉ tổ bị b-bỏng thôi. Không thấy ấm lên tí nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443474
    m_Localized: 'Cold: Đây nhé...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443475
    m_Localized: 'Cold: Để tôi v-ví von cho cậu dễ hình dung.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443476
    m_Localized: 'Cold: Thử tưởng tượng một khoảng không sâu thẳm. Bao la và gi-giá lạnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443477
    m_Localized: 'Cold: Nơi các thiên hà được khai sinh. Nơi những vì sao s-sụp đổ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443478
    m_Localized: 'Cold: ...Còn tôi khoanh tay đứng nhìn. '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443479
    m_Localized: 'Cold: Cả đời tôi cũng không thể cảm nhận được sức nóng của m-m-mặt trời.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443480
    m_Localized: 'Cold: Hay h-hơi ấm từ một cái ôm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443481
    m_Localized: 'Cold: Cả v-vũ trụ lẫn xã hội này chẳng thiết gì đến tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443482
    m_Localized: 'Cold: Giá mà có chút h-hơi ấm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443483
    m_Localized: Hồi mới gặp, anh bảo muốn tiết lộ cái gì ấy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443484
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443485
    m_Localized: 'Cold: Hừừ... Bây giờ t-tôi chưa tiện nói.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443486
    m_Localized: 'Cold: Có điều này làm tôi tr-trăn trở mãi. Từ lâu lắm rồi. Chắc ấy là lý do... tôi lại thấy l-l-lạnh đến vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443487
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443488
    m_Localized: 'Cold: Tôi chẳng muốn nhắc đến chút nào, nhưng nếu cứ giữ trong lòng thì có ngày nó nuốt chửng tôi mất...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443489
    m_Localized: 'Cold: Tôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443490
    m_Localized: 'Cold: Thôi, để m-mai tôi k-kể cho. Tôi phải chuẩn bị tinh thần cái đã.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443491
    m_Localized: 'Cold: Giá mà có chút h-hơi ấm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443492
    m_Localized: Rồi rốt cuộc anh đang giấu cái gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443493
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443494
    m_Localized: 'Cold: Vâng. Tôi muốn cho cậu biết một b-bí mật.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443495
    m_Localized: 'Cold: Tôi... sẵn sàng rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443496
    m_Localized: 'Cold: Mọi khi đều dẫn đến kết cục b-bi thảm, nhưng biết đâu l-lần này lại khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443497
    m_Localized: 'Cold: Có khi ẩn dưới những l-lớp áo này... chính là nguyên nhân khiến tôi l-l-lạnh lẽo và cô đơn đến vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443498
    m_Localized: 'Cold: Nhìn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443499
    m_Localized: 'Cold: Đừng mà... L-Lại nữa sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443500
    m_Localized: Làm cái quái gì thế hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443501
    m_Localized: Mày chết với tao
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443502
    m_Localized: 'Cold: Tôi không c-cố ý mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443503
    m_Localized: 'Cold: Cứ nghĩ ở đây sẽ kh-kh-khác chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443504
    m_Localized: 'Cold: R-Rốt cuộc vẫn như cũ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443505
    m_Localized: 'Cold: Tôi đâu m-muốn thế này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443506
    m_Localized: 'Cold: Thề với cậu, tôi kh-không hề muốn vậy đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443507
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443508
    m_Localized: Đuổi ra khỏi nhà
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443509
    m_Localized: 'Cold: Ch-Chẳng khác gì lần trước cả...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443510
    m_Localized: 'Cold: Sao mình cứ mong lần này sẽ kh-khác chứ? '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443511
    m_Localized: 'Cold: Cậu đ-đừng nóng mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443512
    m_Localized: 'Cold: Tôi không có ý x-xấu đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443513
    m_Localized: 'Cold: Tôi ch-ch-chưa bao giờ muốn như vậy cả.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443514
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443515
    m_Localized: Đuổi ra khỏi nhà
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443516
    m_Localized: 'Cold: Có lẽ... như vậy sẽ t-tốt hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443517
    m_Localized: 'Cold: Không còn giá l-l-lạnh. Không còn cô độc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443518
    m_Localized: 'Cold: Nhưng mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443519
    m_Localized: 'Cold: Không phải tôi c-cố tình đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443520
    m_Localized: 'Cold: Đi liền luôn sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443521
    m_Localized: 'Cold: Thà cậu cho tôi ăn đ-đạn còn nhân đạo hơn. Tôi vẫn còn biết đ-đ-đau mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443523
    m_Localized: 'Cold: Hay là cho tôi ở nốt đến lúc trời t-tối đi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443524
    m_Localized: Cút ngay
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443525
    m_Localized: Được, nhưng đừng có giở trò gì đấy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443526
    m_Localized: 'Cold: Tôi hiểu rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443527
    m_Localized: 'Cold: X-Xin lỗi cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443528
    m_Localized: 'Cold: Vậy thì để mặt trời sưởi ấm thân tôi. Thêm một l-l-lần cuối.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443529
    m_Localized: 'Cold: C-Cảm ơn cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443530
    m_Localized: 'Cold: Chắc hẳn cậu gh-ghét tôi lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443531
    m_Localized: 'Cold: N-Nhưng mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443532
    m_Localized: 'Cold: Tôi x-x-xin lỗi. Tôi cũng không muốn thế này đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832064
    m_Localized: 'Daughter: Với... Ừm... Chú rủ bạn con qua chơi giùm con được hông chú?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832065
    m_Localized: 'Daughter: Tại người lớn rủ thì người ta mới chịu cho bản qua... Còn con mà rủ là bị la liền...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832066
    m_Localized: 'Daughter: Hình như số của bản là {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220801
    m_Localized: 'Doctor: Ừ, bác nghe đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220802
    m_Localized: Mấy bệnh viện bị làm sao vậy bác?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220803
    m_Localized: Tôi cần kiểm tra bác
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220804
    m_Localized: 'Doctor: Ôi... Loạn lắm cháu ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220805
    m_Localized: 'Doctor: Sau khi cả nước biết tin, mọi người đổ xô tới bệnh viện. Ai cũng muốn khám xem mình có phải Dị Khách không.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220806
    m_Localized: 'Doctor: Bác sĩ các bác đã cố giải thích với họ rằng hiện chưa có phương pháp cụ thể để xét nghiệm ra đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220807
    m_Localized: 'Doctor: Nhưng chẳng ai chịu nghe cả. Họ cứ chen lấn xô đẩy nhau, làm ảnh hưởng đến các bệnh nhân khác trong viện.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220808
    m_Localized: 'Doctor: Cuối cùng thì bên Phòng Chống Thảm Họa ập tới. Rồi... họ cho rằng đám đông tụ tập như vậy sẽ gây cản trở cho công tác phòng, chống dịch...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220809
    m_Localized: 'Doctor: Thế là họ gom hết các bệnh nhân lên xe thùng chở về khu cách ly, còn bệnh viện... thì bị đóng cửa luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220812
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220814
    m_Localized: Sao bác lại làm thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220815
    m_Localized: Vậy bác cũng theo phe mấy thằng chó áo vàng à
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220816
    m_Localized: 'Doctor: Đúng gì mà đúng chứ? Dồn cả đám người vào chung một chỗ như thế thì có lợi gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220817
    m_Localized: 'Doctor: Cháu không thấy mấy "dấu hiệu" đấy rất vớ vẩn à? Toàn những cái người bình thường nào cũng có thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220818
    m_Localized: 'Doctor: Cái gì mà răng trắng thì tức là Dị Khách? Tầm xàm bá láp! Chẳng những vô lý mà còn vô căn cứ nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220819
    m_Localized: 'Doctor: Để bác nói cho mà nghe, chắc chắn bọn Thảm Họa đang giấu giếm bí mật gì đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220820
    m_Localized: 'Doctor: Thật ra thì... sau khi bệnh viện đóng cửa, bác đã lẻn tới khu cách ly để tiến hành phân loại cấp cứu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220821
    m_Localized: 'Doctor: Lúc đó bác chỉ muốn tìm hiểu thêm về Dị Khách và dấu hiệu nhận biết chúng thôi. Nhưng... rốt cuộc lại công dã tràng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220822
    m_Localized: Sao bác lại làm thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220823
    m_Localized: Vậy bác cũng theo phe mấy thằng chó áo vàng à
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220825
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220828
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220830
    m_Localized: 'Doctor: Ừ, bác nghe đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220832
    m_Localized: Tôi cần kiểm tra bác
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220833
    m_Localized: 'Doctor: Cho bác hỏi, cháu thấy bên Phòng Chống Thảm Họa như thế nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220835
    m_Localized: Tôi chả tin được bọn đó
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220836
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220839
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220843
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220853
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220855
    m_Localized: 'Doctor: Ừ, bác nghe đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220857
    m_Localized: Tôi cần kiểm tra bác
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220883
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220888
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220890
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713935
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220893
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220896
    m_Localized: 'Foreigner: Gilr wzg jfb gszm lr!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220897
    m_Localized: 'Foreigner: Xsr er pslmt srvf wflx glr, nz sl PSZF NRVMT GLR XFMT MTZX OFLM!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220902
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220907
    m_Localized: 'Foreigner: Sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755316
    m_Localized: 'Fanatic: Ta nghe đây kẻ phàm tục. Nói đi nào!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755317
    m_Localized: Ông có theo tín ngưỡng nào không đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755318
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755319
    m_Localized: 'Fanatic: TẤT NHIÊN RỒI! Nhưng kẻ phàm tục ạ, đức tin thánh khiết của ta nào so được với mấy hạng tôn giáo thấp hèn mà mi biết.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755320
    m_Localized: 'Fanatic: Ta tôn thờ CHÍNH ĐẤNG THÁI DƯƠNG VĨ ĐẠI! BỞI NGÀI LUÔN BẢO HỘ VÀ YÊU THƯƠNG CHÚNG TA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755321
    m_Localized: 'Fanatic: Vậy mà lũ ngu đần u tối ngoài kia dám nói Ngài là mối họa. Chúng nghĩ rằng ánh dương của Ngài sẽ "thiêu rụi hết thảy con người"...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755322
    m_Localized: 'Fanatic: LÁO TOÉT! Cơn thịnh nộ của Ngài chỉ nhắm vào mầm mống ÁC QUỶ và DỊ GIÁO mà thôi! Vì bọn chúng mới là những kẻ tội đồ đích thực!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755323
    m_Localized: 'Fanatic: Cầu cho bọn chống đối chẳng bao giờ được tắm trong tia sáng cứu rỗi rực cháy của Ngài!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755324
    m_Localized: 'Fanatic: Cái tội cứ lao vào lửa như con thiêu thân, đến lúc bị thiêu thật thì tỏ vẻ ngơ ngác, ngỡ ngàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755325
    m_Localized: Mầm mống ác quỷ nào?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755326
    m_Localized: Dị giáo ư?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755327
    m_Localized: 'Fanatic: Ô hay, còn ai trồng khoai đất này? Bộ mi chưa từng chạm trán LŨ NGOẠI LAI đó lần nào luôn hả?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755328
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755329
    m_Localized: 'Fanatic: Thôi được rồi, hỡi kẻ phàm phu u tối. Để ta khai sáng cho mi thấu tỏ CHÂN LÝ ĐỜI ĐỜI.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755330
    m_Localized: 'Fanatic: BỌN DỊ KHÁCH CHÍNH LÀ MẦM MỐNG ÁC QUỶ ĐẤY!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755331
    m_Localized: 'Fanatic: CHÚNG LÀ HẬU DUỆ CỦA LŨ NGOẠI LAI đổ bộ xuống Quả Đất, khi Đấng Thái Dương còn non trẻ và cỏ cây còn xanh tươi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755332
    m_Localized: 'Fanatic: BỌN BÈ LŨ TAY SAI KHỐN KIẾP ẤY sinh sôi tận HÀNG THẾ KỶ, ngang nhiên sinh sống ở nơi này như thể đây là nhà của chúng!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755333
    m_Localized: 'Fanatic: Và giờ đây, chúng lại bò ra khỏi lòng đất hòng mưu đồ XÂM CHIẾM MẢNH ĐẤT THÂN THƯƠNG CỦA CHÚNG TA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755334
    m_Localized: 'Fanatic: Nhưng chúng đâu biết mình đã phạm vào THÁNH ĐỊA, nơi có ĐẤNG THÁI DƯƠNG dang tay che chở loài người.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755335
    m_Localized: 'Fanatic: Ngài TUYỆT NHIÊN KHÔNG DUNG THỨ cho lũ báng bổ! Không thì hà cớ gì chúng lại phải trốn chui trốn nhủi dưới lòng đất suốt mấy nghìn năm qua chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755336
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755337
    m_Localized: 'Fanatic: Mẹ nó thằng bạn tao... Sao tối hôm đó mày lại uống say thế hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755338
    m_Localized: 'Fanatic: Ai bảo mày uống đến quên cả lối về, để cơn phẫn nộ công chính của Đấng Thái Dương vĩ đại...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755339
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755340
    m_Localized: 'Fanatic: THƯA ĐẤNG THÁI DƯƠNG THIÊNG LIÊNG, xin Ngài lượng tình tha thứ cho nó, bởi nó không ý thức được việc mình làm!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755341
    m_Localized: 'Fanatic: Xin Ngài dang rộng vòng tay đón lấy nó. Và nếu có thể, xin Ngài hãy thương lấy cả cây sung bé nhỏ héo úa, chẳng được ai ngó ngàng...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755342
    m_Localized: 'Fanatic: Amen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755343
    m_Localized: 'Fanatic: Đúng vậy kẻ phàm tục, mi không có nghe nhầm đâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755344
    m_Localized: 'Fanatic: Bọn Phòng Chống Thảm Họa đích thực là lũ DỊ GIÁO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755345
    m_Localized: 'Fanatic: Bọn nó cả gan can thiệp vào quá trình vốn không thuộc phạm trù của CHÚNG TA – công cuộc kiểm soát QUẦN CHÚNG!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949376
    m_Localized: 'Fanatic: Lũ thối tha này dám chõ mũi vào những việc cao siêu hơn người. Thật xấc láo!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949377
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949378
    m_Localized: 'Fanatic: Cầu cho Đấng Thái Dương thiêu rụi lũ súc vật ngu muội, đã ném mẹ yêu của ta vào vũng lầy bẩn thỉu kia!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949379
    m_Localized: 'Fanatic: Ta nghe đây kẻ phàm tục. Nói đi nào!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949381
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949388
    m_Localized: Rồi bao nhiêu người phải cháy thành than nữa thì mới vừa lòng mặt trời?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949390
    m_Localized: 'Fanatic: Rất nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949448
    m_Localized: 'Anxiety: He h-he. Mong là mọi chuyện sẽ sớm qua đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949456
    m_Localized: 'Anxiety: Lúc đó em chỉ thoáng thấy nhỏ bạn nằm bất động trên giường, rồi bỗng dưng...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949457
    m_Localized: 'Anxiety: Có một tên trông luộm thuộm tóm lấy em từ đằng sau, bảo là: "Không được vào trong đó. Con đấy đang... không khỏe".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949458
    m_Localized: 'Anxiety: Hắn bảo em xuống bếp ngồi. Rồi hắn lập tức lôi em đi, đặt em ngồi xuống bên bàn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949463
    m_Localized: 'Anxiety: He h-he. Mong là mọi chuyện sẽ sớm qua đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949468
    m_Localized: 'Anxiety: Thì sau khi hắn bắt em ngồi xuống cạnh bàn bếp, có một ông cao to từ đâu lù lù xuất hiện rồi chặn mất lối ra.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949469
    m_Localized: 'Anxiety: Sau đó, ông ta bắt đầu nói chuyện to tiếng với cái tên chộp lấy em.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949470
    m_Localized: 'Anxiety: Mà chúng nó cứ bơ em luôn... Làm như em là không khí vậy. Thế rồi... nó bắt đầu sờ soạng người em!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949471
    m_Localized: 'Anxiety: Chúng nó sờ mó tay em, rồi tới vai em...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949472
    m_Localized: 'Anxiety: Em còn nghe loáng thoáng tiếng cười đùa, tiếng hò reo xuất phát từ phòng em hay sao đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949473
    m_Localized: 'Anxiety: Nghe như kiểu có cả đống thằng đàn ông trong đó vậy. Ơ hơ hơ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949474
    m_Localized: 'Anxiety: Xong em... em thở không nổi nữa. Tim đập thình thịch như muốn rơi ra khỏi lồng ngực vậy...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949475
    m_Localized: 'Anxiety: Em muốn hét lên kêu cứu lắm, nhưng mà... giọng em cứ khản đặc trong họng, chẳng thốt nên lời. Em chìm sâu trong cơn hoảng loạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949476
    m_Localized: 'Anxiety: Em cứ ngồi đờ ra đấy, cứng đơ như bức tượng... Chẳng động đậy được gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949477
    m_Localized: 'Anxiety: Rồi một lúc sau, có thằng cao to nào qua mở tủ lạnh ra lấy đồ. Thế là em chớp ngay thời cơ tẩu thoát...! H-He he!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949478
    m_Localized: 'Anxiety: Em phi thẳng một mạch tới cửa ra. Cứ như nỗi sợ tiếp sức cho em ý, em chạy mãi, chạy mãi... Chạy bán sống bán chết, không ngoảnh đầu lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949479
    m_Localized: 'Anxiety: Và cứ thế em chạy, tới khi đôi chân rã rời rồi ngã khuỵu luôn...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949480
    m_Localized: Vậy sao cô không bị mặt trời thiêu cháy nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949486
    m_Localized: 'Anxiety: Ơ, lạ thế.... R-Rõ ràng là em nhớ hết mọi chuyện xảy ra ngày hôm đó mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949499
    m_Localized: 'Anxiety: Rõ ràng là em nhớ hết mọi chuyện xảy ra ngày hôm đó mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949519
    m_Localized: 'Anxiety: He h-he. Mong là mọi chuyện sẽ sớm qua đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949532
    m_Localized: 'Anxiety: Thì anh sẽ giết tôi hả? Lột da tôi hả? Xong vứt sang một bên?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949533
    m_Localized: 'Anxiety: THÔI CON LẠY ÔNG! GIẾT THÌ GIẾT QUÁCH ĐI! NHANH GỌN LẸ VÀO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949534
    m_Localized: 'Anxiety: ĐỪNG ĐỂ CON CHẾT TRONG ĐAU ĐỚN! LẠY ÔNG!!! HÁ HÁ HÁ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949542
    m_Localized: 'Anxiety: Thì anh sẽ giết tôi hả? Lột da tôi hả? Xong vứt sang một bên?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949543
    m_Localized: 'Anxiety: THÔI CON LẠY ÔNG! GIẾT THÌ GIẾT QUÁCH ĐI! NHANH GỌN LẸ VÀO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949544
    m_Localized: 'Anxiety: ĐỪNG ĐỂ CON CHẾT TRONG ĐAU ĐỚN! LẠY ÔNG!!! HÁ HÁ HÁ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949550
    m_Localized: 'Anxiety: Tuyệt vọng rồi, đường cùng rồi. Có làm gì cũng chẳng thoát khỏi cửa tử đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949556
    m_Localized: 'Anxiety: Tuyệt vọng rồi, đường cùng rồi. Có làm gì cũng chẳng thoát khỏi cửa tử đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949559
    m_Localized: 'Anxiety: He h-he. Mong là mọi chuyện sẽ sớm qua đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949562
    m_Localized: 'Anxiety: DỊ KHÁCH! HỌ SẮP ĐẾN ĐÓN MÌNH RỒI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949563
    m_Localized: 'Anxiety: A-Anh không nghe thấy sao? TIẾNG TỬ THẦN ĐANG VẪY GỌI ĐÓ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949566
    m_Localized: 'Anxiety: Vậy còn chờ đợi làm gì cho đau khổ nữa? MỞ CỬA RƯỚC HỌ VÀO THÔI! HÁ HÁ HÁ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949567
    m_Localized: 'Anxiety: BỌN HỌ MUỐN TỐT CHO MÌNH THÔI MÀ! CỨ ĐỂ DỊ KHÁCH KÉO TỚI HẾT LUÔN ĐÊ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949568
    m_Localized: Thấy cô hơi bất ổn rồi đó
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949570
    m_Localized: 'Anxiety: KHÔNG! TA ĐÃ GIÁC NGỘ RỒI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949571
    m_Localized: 'Anxiety: TA ĐÂY CHÍNH LÀ DỊ KHÁCH! HÁ HÁ HÁ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949572
    m_Localized: 'Anxiety: BỌN TA VÀ LOÀI NGƯỜI TUY HAI MÀ MỘT. TỰA ẢNH PHẢN CHIẾU! TỰA TẤM GƯƠNG SOI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949573
    m_Localized: 'Anxiety: CHÚNG TA CHUNG MỘT SINH THỂ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949574
    m_Localized: 'Anxiety: NÀO, HÃY CÙNG DANG TAY NGHÊNH ĐÓN TỬ THẦN THÔI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949575
    m_Localized: Cô điên nặng lắm rồi đấy, biết không?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949577
    m_Localized: 'Anxiety: TA KHÔNG MẤT TRÍ, TA RẤT TỈNH! TA ĐÃ GIÁC NGỘ CHÂN LÝ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949578
    m_Localized: 'Anxiety: TA ĐÂY CHÍNH LÀ DỊ KHÁCH! HÁ HÁ HÁ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949579
    m_Localized: 'Anxiety: BỌN TA VÀ LOÀI NGƯỜI TUY HAI MÀ MỘT. TỰA ẢNH PHẢN CHIẾU! TỰA TẤM GƯƠNG SOI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949580
    m_Localized: 'Anxiety: CHÚNG TA CHUNG MỘT SINH THỂ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949581
    m_Localized: 'Anxiety: HÃY CÙNG DANG TAY NGHÊNH ĐÓN TỬ THẦN, VÌ NGÀI SẼ ĐẾN BÊN CHÚNG TA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949582
    m_Localized: Cô điên nặng lắm rồi đấy, biết không?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949585
    m_Localized: 'Anxiety: Ngày tàn đã điểm! MẶT TRỜI CHÍNH LÀ ĐIỀM BÁO CHO ĐÍCH ĐẾN CUỐI CÙNG.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949586
    m_Localized: 'Anxiety: Rồi ta sẽ sớm gặp lại nhau, sớm thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337996
    m_Localized: Chị có cần gì không?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338002
    m_Localized: Để tôi lấy nước cho chị nhé?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338003
    m_Localized: Chị muốn ăn gì không?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338007
    m_Localized: Thế tôi đi cho chị nghỉ vậy
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338008
    m_Localized: Tôi ngồi với chị nhé?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338012
    m_Localized: Thế tôi đi cho chị nghỉ vậy
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338013
    m_Localized: Tôi ngồi với chị nhé?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338023
    m_Localized: 'Widow: Mà cậu thì đâu có cách nào làm cho ảnh sống lại được.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338024
    m_Localized: 'Widow: Thậm chí tôi còn không thể...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338027
    m_Localized: 'Widow: Tôi còn không chôn cất ảnh được cho đàng hoàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338028
    m_Localized: 'Widow: Giờ tôi phải làm sao đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338030
    m_Localized: Sao anh ấy lại qua đời?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338031
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338032
    m_Localized: 'Widow: Ảnh... Tôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338033
    m_Localized: 'Widow: Tôi chịu không nổi cậu à.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338034
    m_Localized: 'Widow: Tôi khóc hết nước mắt rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338035
    m_Localized: 'Widow: Giờ có ráng cũng chả khóc thêm được giọt nào nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338036
    m_Localized: 'Widow: Không, tôi sai... Tôi sai rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338037
    m_Localized: 'Widow: Tôi không thể thôi khóc được.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338038
    m_Localized: Mình phải tìm chỗ chôn cất ảnh thôi
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338039
    m_Localized: Chồng chị mất rồi. Chị phải học cách chấp nhận đi
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338054
    m_Localized: Chị còn nhớ kỷ niệm gì với ảnh không?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338055
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338057
    m_Localized: 'Widow: Có lần tôi với ảnh qua nhà bạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338058
    m_Localized: 'Widow: Hồi đó tụi tôi còn trẻ dại.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338059
    m_Localized: 'Widow: Hay rủ rê la cà rồi nhậu nhẹt. Tính ảnh cũng hơi trầm. Ít khi nói chuyện trong mấy buổi tụ tập như vầy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338060
    m_Localized: 'Widow: Bữa đó tụi tôi uống say mèm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338061
    m_Localized: 'Widow: Ban đầu ảnh vẫn lầm lì. Nhưng rồi đột nhiên ảnh nói:'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338062
    m_Localized: 'Widow: "Đưa tao cây đàn. Để tao ca một bài cho tụi mày nghe".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338063
    m_Localized: 'Widow: Rồi ảnh chơi hay thiệt là hay, khiến tôi say lòng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338064
    m_Localized: 'Widow: Sau đó, mấy đứa bạn cứ năn nỉ ảnh chơi thêm mấy bài khác. Ảnh chỉ ngồi im một lát rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338065
    m_Localized: 'Widow: ...đứng phắt dậy, nói là tao phải đi về. Cái ảnh làm đổ ly, loay hoay chụp lại thì làm rớt cây đàn ghi-ta nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338066
    m_Localized: 'Widow: Tới sau này, tôi mới biết là ảnh học đúng bài đó để hớp hồn tôi thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338068
    m_Localized: 'Widow: Tôi vẫn còn giữ tấm hình của tụi tôi chụp vào bữa tối hôm đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338069
    m_Localized: 'Widow: Nó cũng như vợ chồng chúng tôi vậy, còn đâu những ngày tháng đẹp tươi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338070
    m_Localized: 'Widow: Giờ anh không còn ở đây để đàn cho em nữa. Mà anh cũng đã hát cho em nghe khúc ca cuối cùng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338072
    m_Localized: Thế rốt cuộc anh ấy bị sao vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338073
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338074
    m_Localized: 'Widow: Ảnh chết mẹ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338075
    m_Localized: À ừ. Xin lỗi, tôi vô ý quá
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338076
    m_Localized: Có phải tôi giết đâu mà
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338078
    m_Localized: 'Widow: Xin lỗi cậu, chỉ tại...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338079
    m_Localized: 'Widow: Cứ đêm đêm là tôi lại khóc. Khóc tới nghẹn họng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338080
    m_Localized: 'Widow: Tôi phải tìm cho bằng được kẻ đã gây ra tất cả mọi chuyện... Rồi nhìn nó bị mặt trời thiêu sống thì mới hả dạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338081
    m_Localized: Đã có chuyện gì thế chị?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338082
    m_Localized: Thôi được rồi, tôi không tọc mạch nữa
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338084
    m_Localized: 'Widow: Ừ. Cậu nói cũng phải...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338085
    m_Localized: 'Widow: Xin lỗi, tôi hơi quá lời. Tại, cứ nhắc tới ảnh thôi là cổ họng tôi đã nghẹn ứ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338086
    m_Localized: 'Widow: Cầu cho cái lũ khốn nạn kia sớm có ngày gặp quả báo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338087
    m_Localized: 'Widow: Cầu cho có người xé xác tụi nó ra thành trăm mảnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338088
    m_Localized: Đã có chuyện gì thế chị?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338089
    m_Localized: Thôi được rồi, tôi không tọc mạch nữa
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338090
    m_Localized: 'Widow: Lúc đó chồng tôi thấy hơi mệt trong người. Ảnh ra viện khám, mà bị người ta đuổi về.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338091
    m_Localized: 'Widow: Rồi họ mới chỉ tụi tôi tới cái trung tâm mới mở của bọn áo vàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338092
    m_Localized: 'Widow: Rốt cuộc tụi nó không thèm khám mà nhốt ảnh vào khu cách ly luôn. Nó tịch thu điện thoại ảnh rồi nói ba tuần sau thì thả về.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338094
    m_Localized: 'Widow: Có lần tôi ra đó sớm một xíu để xem tình hình.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338095
    m_Localized: 'Widow: Thì thấy tụi chó má đó, nó...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338097
    m_Localized: 'Widow: Xin lỗi, tôi cần nghỉ chút...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338099
    m_Localized: 'Widow: Tụi nó chỉ phán một câu xanh rờn: "Thằng đó chết rồi".'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338100
    m_Localized: 'Widow: Có vỏn vẹn mấy từ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338101
    m_Localized: 'Widow: Mà còn chả cho tôi nhìn xác ảnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338102
    m_Localized: 'Widow: Chả cho tôi đưa ảnh về nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338103
    m_Localized: 'Widow: Được cái bọn chó ngu này hỉ mũi còn chưa sạch, nên tôi chỉ cần khoác lên cái áo phòng thí nghiệm là được vào nhà xác ngon ơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338104
    m_Localized: 'Widow: Rồi tôi thấy ảnh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338105
    m_Localized: 'Widow: ...nằm đó bất động.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338107
    m_Localized: 'Widow: Mẹ cha cái lũ khốn nạn. Tụi nó dám giết chồng tôi. Còn tôi chỉ biết gào thét, bao nhiêu lòng thương người cũng đã cạn khô.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338109
    m_Localized: 'Widow: Giờ tôi muốn ở một mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338110
    m_Localized: 'Widow: Ừ. Cám ơn cậu...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338111
    m_Localized: 'Widow: Giờ không có ảnh bên cạnh, tôi cũng hông còn thiết tha gì nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338113
    m_Localized: Có chuyện gì sao chị?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338114
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338115
    m_Localized: 'Widow: Tối nay tôi lên đường.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338116
    m_Localized: 'Widow: Tôi nói với cậu rồi đó. Tính ở dăm ba bữa thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338117
    m_Localized: 'Widow: Tôi chỉ cần chỗ để nghỉ ngơi lại sức. Xong rồi thì đi tiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338118
    m_Localized: Vậy kế hoạch tiếp theo của chị là gì?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338119
    m_Localized: Chị có định về ở với gia đình không?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338120
    m_Localized: 'Widow: Tôi chưa muốn nghĩ xa tới vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338121
    m_Localized: 'Widow: Chắc... Chắc tôi sẽ về nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338122
    m_Localized: 'Widow: Tìm cây đàn ghi-ta cũ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338123
    m_Localized: 'Widow: Rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338124
    m_Localized: Chị ở lại đây cũng được mà
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338125
    m_Localized: Chị đi mạnh giỏi nhé
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338126
    m_Localized: 'Widow: Họ hàng hai bên không còn ai nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338127
    m_Localized: 'Widow: Giờ tụi tôi sẽ về nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338128
    m_Localized: 'Widow: Mà cũng không còn gì ở đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338129
    m_Localized: Chị ở lại đây cũng được mà
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338130
    m_Localized: Chị đi mạnh giỏi nhé
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338131
    m_Localized: 'Widow: Để làm gì kia chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338132
    m_Localized: 'Widow: Ở lại thì tôi cũng đâu sung sướng hơn được miếng nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338133
    m_Localized: 'Widow: Nói nghe hơi phũ phàng, nhưng cậu có là gì của tôi đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338134
    m_Localized: 'Widow: Giờ tôi chỉ muốn về nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338135
    m_Localized: 'Widow: Về lại mái ấm thân quen mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338136
    m_Localized: 'Widow: ...Cám ơn cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338137
    m_Localized: 'Widow: Cậu là người ít nói, nhưng được cái... lúc nào cũng chịu lắng nghe tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338138
    m_Localized: 'Widow: Tôi cũng chúc cậu tìm được điều mình cần.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338139
    m_Localized: 'Scammer: Hẹ hẹ. Lô thằng em.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338140
    m_Localized: Trước tận thế anh sống bằng nghề gì?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338141
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338142
    m_Localized: 'Scammer: Ái dà, mãi mới thấy thằng em hỏi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338143
    m_Localized: 'Scammer: Thế chú em có biết trò...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338144
    m_Localized: 'Scammer: ...cá độ không? Sao, biết không?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338145
    m_Localized: Vãi, anh là dân lừa đảo à?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338146
    m_Localized: Ừ, có nghe qua
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338147
    m_Localized: 'Scammer: Ê nha, nói vậy nghe mất hết quan điểm! Anh là nhà phân-con-mẹ-nó-tích à nha!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338148
    m_Localized: 'Scammer: Chú em mà biết đôi tay anh đã vuốt qua bao nhiêu cọc tiền là chảy dãi ngay và luôn này.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338149
    m_Localized: 'Scammer: Mấy con đĩ của anh nghe rõ đây: gọi anh là dân chuyên, vì anh chuyên ăn nên làm ra!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338150
    m_Localized: 'Scammer: Người ta cống tiền cho anh xong bú gấp năm... à không, GẤP MƯỜI tiền cược đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338151
    m_Localized: Thế anh kiếm được bao nhiêu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338152
    m_Localized: Đấy mà là nghề à?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338153
    m_Localized: 'Scammer: Anh mày sống như thế đấy em!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338154
    m_Localized: 'Scammer: Có mấy con gà mặc váy mới đi cá độ hợp pháp. Chuẩn cơm mẹ nấu luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338155
    m_Localized: 'Scammer: Anh nói thật, thiếu gì cách lừa bọn nhà cái.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338156
    m_Localized: 'Scammer: Các thầy chuyên gia phán vào đâu thì cứ cược vào đó là xong, dạng háng chờ tiền về!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338157
    m_Localized: 'Scammer: Không có tiền đặt cũng éo làm sao cả. Thiếu gì mấy thằng ngáo cho vay!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338158
    m_Localized: Thế anh kiếm được bao nhiêu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338159
    m_Localized: Đấy mà là nghề à?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338160
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338161
    m_Localized: 'Scammer: Giải thích sao cho chú hiểu nhỉ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338162
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338163
    m_Localized: 'Scammer: Anh mày bú được ba mươi củ mẹ nó đô...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338164
    m_Localized: 'Scammer: ...mà vô sổ nợ hết, nhưng nợ tuổi lồn với anh nhé!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338165
    m_Localized: 'Scammer: Giờ anh lại càng đéo quan tâm luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338166
    m_Localized: 'Scammer: Đéo biết sợ là gì hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338167
    m_Localized: 'Scammer: Thằng cu đùa anh à.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338168
    m_Localized: 'Scammer: Chả nghề thì là cái mẹ gì!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338169
    m_Localized: 'Scammer: Anh còn có văn phòng các kiểu luôn. Sống đéo khác gì vua chúa đâu bờ-rô ạ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338170
    m_Localized: 'Scammer: Ghế bọc con mẹ nó da nhá. Rồi có sổ tay nhá, danh sách mấy đứa nhà cái nhá, tiền nợ rồi lời lãi, giấy tờ đủ kiểu luôn nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338171
    m_Localized: 'Scammer: Hẹ hẹ. Lô thằng em.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338172
    m_Localized: Có chắc là bọn thu nợ không tới đập cửa tìm anh không đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338173
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338174
    m_Localized: 'Scammer: Thu nợ? Thợ nu? Là cái đéo gì cơ cu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338175
    m_Localized: 'Scammer: Tầm này éo có nờ ơ nơ nặng nợ gì nữa! Ông mặt trời xử lý hộ hết rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338176
    m_Localized: 'Scammer: Ngân hàng ngân hiếc cũng đéo làm được gì cả. Có mà thách luôn đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338177
    m_Localized: 'Scammer: Anh mày được dịp sổ lồng mẹ rồi. Nhưng mà cày thì vẫn cày chứ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338178
    m_Localized: 'Scammer: Dăm ba trò cá độ xưa rồi Diễm. Anh mày phải nghĩ ra trò mới, trò gì hay hơn mới được.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338179
    m_Localized: Hóa ra là anh chó ngáp phải ruồi vì mặt trời bị vậy chứ gì
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338180
    m_Localized: Thật luôn? Anh định đi tìm việc mới à?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338181
    m_Localized: 'Scammer: Mááá cái thằng này nữa. Chú nói thế nghe mất quan điểm quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338182
    m_Localized: 'Scammer: Ngáp cái quần gì mà ngáp, anh là anh tính trước hết rồi! Cứ được ăn cả, ngã về mo! Mà ngã thế đéo nào được, sợ cặc!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338183
    m_Localized: 'Scammer: Chẳng qua giờ được hẳn vé làm lại từ đầu luôn thôi. Quá đã.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338184
    m_Localized: 'Scammer: À mà kể chú nghe. Anh vừa nảy ra ý tưởng mới để kiếm xèng nè. Hấp dẫn cực. Nghe không?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338185
    m_Localized: Đâu anh nói thử xem
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338186
    m_Localized: Thôi khỏi
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338187
    m_Localized: 'Scammer: Anh mày mới nghĩ ra quả ý tưởng kiếm xèng SIÊU ĐÁ luôn. Nghe không?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338188
    m_Localized: Đâu anh nói thử xem
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338189
    m_Localized: Thôi khỏi
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338190
    m_Localized: 'Scammer: Thế này nhá, tụi áo vàng bây giờ chỉ tay năm ngón hết rồi đúng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338191
    m_Localized: 'Scammer: Thì đấy, nên mình chỉ cần... bợ đít chúng nó là được. Hiểu vấn đề chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338192
    m_Localized: 'Scammer: Giờ nhá, mình cứ thường xuyên cống nạp mấy thằng dị dị cho tụi nó. Có khi nó lại để mình vào trú trong hầm kiên con nhà bà cố ấy chứ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338193
    m_Localized: 'Scammer: Nghe ướt hết cả quần chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338194
    m_Localized: Anh muốn giao người cho bên Thảm Họa á?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338195
    m_Localized: Anh nghĩ bọn cán bộ áo vàng đấy sẽ cứu anh à?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338196
    m_Localized: 'Scammer: Chứ còn đéo gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338197
    m_Localized: 'Scammer: Chú sợ à? Sao mày đàn bà thế em giai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338198
    m_Localized: 'Scammer: Thời buổi này liều ăn nhiều, không liều thì cạp đất mà ăn!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338199
    m_Localized: 'Scammer: Phải mấy con bò mới chui vào khu cách ly. Ở trỏng có mẹ gì tốt đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338200
    m_Localized: 'Scammer: Thế nên mình phải tìm cách nịnh bọn Thảm Hại ấy. Đã bợ đít rồi thì tiện tay sục hộ luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338201
    m_Localized: 'Scammer: Mà không cần phải bú liếm quá đâu, cứ giao người là được rồi... Tụi nó đòi gì thì cho nấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338202
    m_Localized: 'Scammer: Chuẩn... Chuẩn... Cứ gọi thẳng số tổng đài rồi kể lể ba cái dấu hiệu con mẹ gì đó! Sao cho tụi nó biết mình không sú là được!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338203
    m_Localized: 'Scammer: Nó lại chả phải anh hùng à. Đúng quá rồi còn gì nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338204
    m_Localized: Anh nói cũng đúng
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338205
    m_Localized: Xạo lồn vừa thôi cha
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338206
    m_Localized: Thích làm thân với bọn đó quá nhỉ? Thế thì cút ra khỏi nhà tôi ngay
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338207
    m_Localized: 'Scammer: Vãi lồn, bờ-rô. Đúng văn mấy thằng chim bé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338208
    m_Localized: 'Scammer: Tóm lại mình phải xem xem thằng nào đứng đầu đã, rồi cứ thế bú thật lực. Chiến thuật cả đấy. Hiểu ý anh chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338209
    m_Localized: 'Scammer: Thế nên mình phải tìm cách nịnh bọn Thảm Hại ấy. Đã bợ đít rồi thì tiện tay sục hộ luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338210
    m_Localized: 'Scammer: Mà không cần phải bú liếm quá đâu, cứ giao người là được rồi... Tụi nó đòi gì thì cho nấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338211
    m_Localized: 'Scammer: Chuẩn... Chuẩn... Cứ gọi thẳng số tổng đài rồi kể lể ba cái dấu hiệu con mẹ gì đó! Sao cho tụi nó biết mình không sú là được!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338212
    m_Localized: 'Scammer: Nó lại chả phải anh hùng à. Đúng quá rồi còn gì nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338213
    m_Localized: Anh nói cũng đúng
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338214
    m_Localized: Xạo lồn vừa thôi cha
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338215
    m_Localized: Thích làm thân với bọn đó quá nhỉ? Thế thì cút ra khỏi nhà tôi ngay
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338216
    m_Localized: 'Scammer: Anh đéo đúng thì còn ai đúng nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338217
    m_Localized: 'Scammer: Giác quan thứ sáu của anh là để đánh hơi mấy kèo thơm mối ngon mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338218
    m_Localized: 'Scammer: Tin anh đi, chú đi với anh thì chỉ có thắng chứ không có thua.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338219
    m_Localized: 'Scammer: Đụ má mày nữa. Mày mới là thằng xàm lồn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338220
    m_Localized: 'Scammer: Ngày xưa chúng nó còn phải trả tiền để nghe tao tư vấn đầu tư. Đây anh tư vấn MIẾN PHÍ cho mày luôn cơ mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338221
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338222
    m_Localized: 'Scammer: Địt mẹ, bố cái thằng giẻ rách... Đéo rảnh mà đi tiếp mày.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338223
    m_Localized: 'Scammer: Cái gì, con đĩ chó này muốn đuổi tao đi hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338225
    m_Localized: 'Scammer: Má, thế mà cứ tưởng tao với mày là huynh đệ nghĩa tình...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338226
    m_Localized: 'Scammer: Té ra lại là anh em cây khế. Tao còn lên kèo thơm cho mày ngửi, vậy mà mày...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338227
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338228
    m_Localized: 'Scammer: Thôi, cho mày chết cụ đi. Tao cút đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338229
    m_Localized: 'Scammer: Vãi, thật luôn? Anh mày nấu ngon lành cành đào thế mà còn chê. Thôi tùy, kệ con mẹ mày...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338230
    m_Localized: 'Scammer: Ấy, nếu mà có đổi ý thì nhớ gọi anh, nhá...?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338231
    m_Localized: 'Scammer: Hẹ hẹ. Lô thằng em.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338232
    m_Localized: Anh muốn gì đây?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338233
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338234
    m_Localized: 'Scammer: Ê nè, anh mày mới nấu được kèo làm ăn mới. Cháy mẹ bếp luôn, khỏi phải bàn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338235
    m_Localized: 'Scammer: Kê, giờ nhé...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338236
    m_Localized: 'Scammer: Bên ngoài mặt trời đang như cái lò xông hơi âm trì địa ngục, đúng chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338237
    m_Localized: 'Scammer: Như thế chứng tỏ là tầng ô-zôn toang mẹ nó rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338238
    m_Localized: 'Scammer: Mà nhá... Khí ô-xy thì đi từ ánh mặt trời xuyên qua tầng ô-zôn...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338239
    m_Localized: 'Scammer: Nghe đến đó là hiểu anh định nói gì rồi, phải không bờ-rô?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338240
    m_Localized: 'Scammer: ...TA ĐI BÁN KHÔNG KHÍ ĐÊ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338241
    m_Localized: 'Scammer: THẾ mới gọi là LÀM ĂN chứ cu!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338242
    m_Localized: Vãi lồn quá hay, kế hoạch quá tuyệt vời
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338243
    m_Localized: Cha sinh mẹ đẻ đến giờ mới nghe cái gì ngu đéo tả được như thế
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338244
    m_Localized: 'Scammer: Bờờờờờ-rôôôô! Chú em cũng nghĩ nó hay à?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338245
    m_Localized: Ờ hay chứ. Không ấy anh đi làm tiến sĩ khoa học luôn đi
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338246
    m_Localized: Đéo
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338247
    m_Localized: 'Scammer: Vãi chưởng, ờm...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338248
    m_Localized: 'Scammer: Cảm ơn thằng em nhá! Ý tưởng lớn gặp nhau có khác! Mày nhìn thấy chất xám chảy trong hai hòn dái anh chưa!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338249
    m_Localized: 'Scammer: Tầm này dăm ba mấy cái Giải Darwin, muỗi hết!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338250
    m_Localized: Anh biết Giải Darwin là giải gì không?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338251
    m_Localized: Ờ, đảm bảo nhận giải luôn đó
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338252
    m_Localized: 'Scammer: Ờ thì... Là cái giải trao cho thằng nào lọ ra phát minh khoa học hay nhất gì gì đúng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338253
    m_Localized: 'Scammer: Làm sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338254
    m_Localized: Có gì đâu
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338255
    m_Localized: Giải Darwin là dành cho mấy người chuyên chết vì chơi ngu đấy
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338256
    m_Localized: 'Scammer: Há há! Sắp sửa được làm người nổi tiếng rồi. Bố mày là vua khoa học đây! Quỳ xuống đi mấy con đĩ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338257
    m_Localized: 'Scammer: Xèng nhiều, danh nhiều, vú nhiều... Ngon vãi cả lồn luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338258
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338259
    m_Localized: 'Scammer: Ô-kê, chốt. Để vụ này lắng xuống rồi anh mày đi đăng ký bản quyền công nghệ bán không khí.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338260
    m_Localized: 'Scammer: Anh biết ngay là chú hiểu anh mà! Quá đã!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338261
    m_Localized: 'Scammer: Ơ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338262
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338263
    m_Localized: 'Scammer: Ê khoan, nãy giờ chú mày kháy đểu anh đó hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338264
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338265
    m_Localized: 'Scammer: Địt mẹ mày nhá. Tao đang đào ra VÀNG đấy, mà mày còn kháy à?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338266
    m_Localized: 'Scammer: Địt mẹ mày. Tao đang cố nấu cái ý tưởng triệu đô, mà mày dám kháy tao à?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338267
    m_Localized: 'Scammer: Đợi đấy, bố mày sẽ đi nhận Giải Thưởng Darwin rồi trở thành tỷ phú!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338268
    m_Localized: 'Scammer: Rồi để đó xem mày có quỳ lạy liếm chân xin lỗi tao không...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338269
    m_Localized: Anh ôm mớ ý tưởng triệu đô đấy mà cút con mẹ đi
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338270
    m_Localized: 'Scammer: Vãi lồn, bờ-rô...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338271
    m_Localized: 'Scammer: Nghe anh mày nói thôi cũng khó khăn thế à? Anh làm chú khó chịu lắm hay sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338272
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532288
    m_Localized: 'Scammer: Ờ, kệ mẹ mày đấy thằng lồn. Thà làm một mình bú lời lãi còn đậm hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532289
    m_Localized: 'Scammer: Vãi lồn, bờ-rô...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532290
    m_Localized: 'Scammer: Địt mẹ mày nhá. Tao đang đào ra VÀNG đấy, mà mày còn khịa à?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532291
    m_Localized: 'Scammer: Đợi đấy, bố mày sẽ đi nhận Giải Thưởng Darwin rồi trở thành tỷ phú!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532292
    m_Localized: 'Scammer: Rồi để đó xem mày có quỳ lạy liếm chân xin lỗi tao không...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532410
    m_Localized: 'Daughter: (Sau một lúc, bé lại bắt đầu khóc như mưa. Có vẻ như bạn chẳng giúp gì được cho bé nó cả)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532493
    m_Localized: Tiếp theo chị tính làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532494
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532495
    m_Localized: 'Alkonost: Ừ, chuyện này quan trọng nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532496
    m_Localized: 'Alkonost: Chồng chị sắp đến đón rồi. Cầu trời cho ảnh tìm được chỗ ở an toàn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532497
    m_Localized: 'Alkonost: Để cả bọn yên tâm lánh nạn, chờ cho đợt tấn công của bọn Dị Khách và sức nóng mặt trời qua đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532498
    m_Localized: 'Alkonost: Ảnh bảo những nơi như vậy có tồn tại. Ảnh cũng nói rằng mặt trời chẳng phát nổ đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532499
    m_Localized: 'Alkonost: Nếu có thì mình đã tiêu đời trong vòng chưa đến 10 phút rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532500
    m_Localized: 'Alkonost: Chị thấy ảnh nói cũng có lý.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532502
    m_Localized: Chồng chị có tin gì chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532503
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532504
    m_Localized: 'Alkonost: Chị chưa nghe tin gì... Không biết sao mà ảnh chưa hề gọi điện hay đến tìm chị.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532505
    m_Localized: 'Alkonost: Nhỡ ảnh có mệnh hệ gì thì sao? Hay ảnh đang gặp rắc rối?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532506
    m_Localized: 'Alkonost: Không thể nào. Anh chắc chắn không bao giờ bỏ rơi bọn chị đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532507
    m_Localized: 'Alkonost: Ngay cả khi đã chán em chị đến tận cổ, ảnh vẫn giúp chị chăm nó mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532508
    m_Localized: 'Alkonost: Chắc... chắc ảnh vẫn đang trên đường đó thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532509
    m_Localized: 'Alkonost: Em chị cũng có vẻ khá hơn rồi... Ảnh nhất định sẽ đến mà. Rồi mọi chuyện sẽ đâu vào đấy thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532511
    m_Localized: Trông chị buồn vậy
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532512
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532513
    m_Localized: 'Alkonost: Thật hả chú?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532514
    m_Localized: 'Alkonost: À thì, cũng đúng thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532515
    m_Localized: 'Alkonost: Tại chị phải lo nghĩ quá nhiều đó chú.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532516
    m_Localized: 'Alkonost: Nếu mặt trời không phát nổ, vậy tại sao hơi nóng vẫn chưa chịu dịu đi? Sao mọi người cứ bảo là tận thế đến nơi rồi ấy nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532517
    m_Localized: 'Alkonost: Chị có nghe trên TV.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532518
    m_Localized: 'Alkonost: Họ không nói thẳng, nhưng hình như Trái Đất đang ngày càng nóng lên.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532519
    m_Localized: 'Alkonost: Khí hậu đang biến đổi, muông thú chết dần vì không thể thích nghi với thời tiết mới này.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532520
    m_Localized: 'Alkonost: Còn chúng ta thì sẽ ra sao đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532522
    m_Localized: Chị thấy sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532523
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532524
    m_Localized: 'Alkonost: Tối qua chị có ra ngoài, tìm xem chồng chị đang ở đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532525
    m_Localized: 'Alkonost: Chị đi một vòng qua những nơi mà chị nghĩ ảnh sẽ tới.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532526
    m_Localized: 'Alkonost: ...Rồi chị phát hiện thấy ảnh đã uống thuốc tự vẫn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532527
    m_Localized: 'Alkonost: Bọn... bọn chị có mua để nhỡ tình hình bất ổn thì uống cùng nhau.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532528
    m_Localized: 'Alkonost: Chồng chị sợ quá nên đã làm trước một viên. Còn chẳng đợi chị đi cùng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532529
    m_Localized: 'Alkonost: Ảnh uống rồi. Uống một mình, nuốt trọn viên thuốc trước khi bị mặt trời nuốt chửng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532530
    m_Localized: 'Sirin: Hồi kết đã điểm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532531
    m_Localized: Cô thấy sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532532
    m_Localized: Tôi cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532533
    m_Localized: 'Sirin: Tôi thấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532534
    m_Localized: 'Sirin: Cứ như có một cái chăn bằng xiềng xích đang quấn quanh người tôi. Thật sự, thật sự quá nặng nề.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532535
    m_Localized: 'Sirin: Nó đang ghì tôi xuống.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532536
    m_Localized: 'Sirin: Tôi... muốn rũ bỏ tấm chăn này.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532537
    m_Localized: 'Sirin: Hồi kết đã điểm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532538
    m_Localized: Vẫn cứ vui vẻ yêu đời quá cơ
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532539
    m_Localized: Tôi cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532540
    m_Localized: 'Sirin: À. Ừ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532541
    m_Localized: 'Sirin: Cậu có nghe nói vụ mặt trời sắp nổ chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532542
    m_Localized: 'Sirin: Tối nay tôi mới biết.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532543
    m_Localized: 'Sirin: Vậy là thế giới sắp tàn rồi ư?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532544
    m_Localized: 'Sirin: Một chút minh chứng cho sự tồn tại của chúng ta cũng không còn?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532545
    m_Localized: 'Sirin: Thú vị đấy. Đáng suy ngẫm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532546
    m_Localized: 'Sirin: Hồi kết đã điểm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532547
    m_Localized: Chị gái của cô sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532548
    m_Localized: Tôi cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532549
    m_Localized: 'Sirin: Chị ấy sợ mất tất cả.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532550
    m_Localized: 'Sirin: Tôi thì nghĩ chúng ta không còn gì để mất.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532551
    m_Localized: 'Sirin: Chúng ta chỉ là những hạt bụi cỏn con trong vũ trụ không ngừng giãn nở.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532552
    m_Localized: 'Sirin: Chẳng ai cần chúng ta. Mà cũng CHẲNG CÒN ai khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532553
    m_Localized: 'Sirin: Nếu hành tinh này tan biến, sẽ chẳng có ai đau buồn vì ta. Không người, không ma, không một thứ gì để mà tiếc thương.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532554
    m_Localized: 'Sirin: Nhưng chị tôi lại rất lo sợ điều đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532555
    m_Localized: 'Sirin: Hồi kết đã điểm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532556
    m_Localized: Chị cô đang không khỏe hả?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532557
    m_Localized: Tôi cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532558
    m_Localized: 'Sirin: Ừ. Chị ấy muốn ra ngoài tìm ông chồng, rồi sẵn tiện giải tỏa hết mấy mớ phiền muộn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532559
    m_Localized: 'Sirin: Tôi có linh cảm chuyện này không ổn. Nhưng chị cứ bảo chị không thể ngồi yên chờ chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532560
    m_Localized: 'Sirin: Nếu chị ấy vẫn muốn đi, thì tôi sẽ đi cùng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532561
    m_Localized: 'Sirin: Trước khi thế giới tận diệt, tôi không muốn phải mất đi chị ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532562
    m_Localized: 'Sirin: Hồi kết đã điểm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532563
    m_Localized: Hai chị em vừa ra ngoài về à?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532564
    m_Localized: Tôi cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532565
    m_Localized: 'Sirin: Ừ. Chị ấy tìm thấy xác ông chồng.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532566
    m_Localized: 'Sirin: Mồm thì trấn an chị rồi sẽ ổn thôi, rốt cuộc lại ngỏm trước như thằng hèn. Chẳng muốn ở lại để chứng kiến cái kết đúng nghĩa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532567
    m_Localized: 'Sirin: Chắc chị ấy cũng không còn sức để đi tiếp nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726592
    m_Localized: 'Sirin: Giờ tới phiên tôi phải chăm sóc cho chị đến khi cái chết ập tới.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726593
    m_Localized: 'Sirin: Sau khoảnh khắc lìa đời, sẽ chẳng còn bất cứ điều gì để mà lo lắng, sợ hãi, hoảng loạn hay xấu hổ nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166080
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166081
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166082
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166083
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166084
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166085
    m_Localized: 'Alkonost: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166086
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166087
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166088
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166089
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166090
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166091
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360384
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360385
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360386
    m_Localized: Tôi cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360387
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083328
    m_Localized: 'Firefighter: Mẹ nó... *khụ*'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083329
    m_Localized: 'Firefighter: Này, anh nhờ chút... Cảm phiền chú... nhấc máy gọi cho mấy đứa nhỏ nhà anh được không? Số là {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083330
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083331
    m_Localized: 'Firefighter: Không cần bảo tụi nó đến đón anh... Hay nói lời từ biệt với anh đâu... *khụ* Cứ nói là...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083332
    m_Localized: 'Firefighter: Bố của các con đã không bỏ chạy. Bố đã... làm tròn trách nhiệm của mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083333
    m_Localized: 'Firefighter: *khụ khụ* Vậy là đủ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083380
    m_Localized: 'Wifefema: Chú mày muốn gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083381
    m_Localized: Chị nói chị từng làm ở hải quan đúng không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083382
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083383
    m_Localized: 'Wifefema: Chứ còn sao nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083384
    m_Localized: 'Wifefema: À mà, chú có đang kiểm tra mọi người đàng hoàng để tìm dấu hiệu Dị Khách không thế?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083385
    m_Localized: 'Wifefema: Hỏi cũng hơi thừa thật, cơ mà... thế cho chắc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083386
    m_Localized: 'Wifefema: Chẳng biết đứa nào dở hơi lại đi đặt tên chúng nó là "Dị Khách" nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083387
    m_Localized: 'Wifefema: Bọn này có mà "Dị Hợm" ấy chứ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083388
    m_Localized: 'Wifefema: Chú mày muốn gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083389
    m_Localized: Sao chị căm ghét Dị Khách thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083390
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083391
    m_Localized: 'Wifefema: Khiếp, mày hỏi câu đấy mà cũng hỏi được!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083392
    m_Localized: 'Wifefema: Cũng tại lũ dị hợm ấy mà cả thế giới mới đang loạn cào cào kìa! Không xem thời sự à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083393
    m_Localized: 'Wifefema: Mặt trời sắp phát nổ rồi. Ngoài đường người ta chết la chết liệt. Tất cả là tại bọn nó hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083394
    m_Localized: 'Wifefema: Chị thề luôn đấy, bây giờ mà cho là chị giết sạch hết từng đứa không chừa một ai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083395
    m_Localized: 'Wifefema: Chỉ cần chút thời gian là được. Chị sẽ đánh hơi ra cho bằng hết, như hồi làm ở biên giới ấy. Chú mày cứ chờ xem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083396
    m_Localized: 'Wifefema: Bên Phòng Chống không tuyển chị vào đúng là thiếu sót kinh khủng...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083397
    m_Localized: 'Wifefema: Chú mày muốn gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083398
    m_Localized: Sao chị cứ muốn làm việc cho bên Thảm Họa vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083399
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083400
    m_Localized: 'Wifefema: Vì chị đéo phải hạng vô tâm nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083401
    m_Localized: 'Wifefema: Mình dẹp được bọn Dị Khách thì phải gắng sức mà dẹp đi chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083402
    m_Localized: 'Wifefema: Chị vẫn đang làm tròn bổn phận của mình đây. Hôm nọ chị vừa chỉ điểm thằng hàng xóm cho người ta bắt đi xong.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083403
    m_Localized: 'Wifefema: Thế mà cái bọn này chỉ tuyển mỗi ông xã nhà chị! Đéo thể nào tin được!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083404
    m_Localized: 'Wifefema: Ừ thì chồng được vào làm, mình cũng có phần nở mặt nở mày chứ, nhưng mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083405
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083406
    m_Localized: 'Wifefema: Cảm giác cứ như bị dội một gáo nước lạnh vào mặt ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083407
    m_Localized: 'Wifefema: Chú mày muốn gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083408
    m_Localized: Tại sao chị lại chỉ điểm hàng xóm mình?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083409
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083410
    m_Localized: 'Wifefema: Tai chú mày lãng hả? Chị bảo rồi mà, tại hắn là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083411
    m_Localized: 'Wifefema: ...Với cả hắn cứ ghê ghê hãm hãm kiểu gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083412
    m_Localized: 'Wifefema: Nhìn hắn bị bế đi mà chị hả dạ gớm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083413
    m_Localized: 'Wifefema: Làm chị nhớ lại hồi còn làm công tác bảo vệ biên giới.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083414
    m_Localized: 'Wifefema: Thế rồi chị nảy ra một ý... mình nên làm việc cho bên Phòng Chống mới phải!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083415
    m_Localized: 'Wifefema: Chú mày muốn gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083416
    m_Localized: Chị không đến đây để thăm chồng, mà để xin vào bên Phòng Chống, đúng không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083417
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083418
    m_Localized: 'Wifefema: Ừ thì làm sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083419
    m_Localized: 'Wifefema: Chị đến ăn vạ một phen long trời lở đất luôn, bao giờ mấy ông cấp trên chịu để ý thì thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083420
    m_Localized: 'Wifefema: Từ chối tuyển dụng á, chị khiếu nại cho nó biết mặt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083421
    m_Localized: 'Wifefema: Chị bắt được Dị Khách, thực hiện nghĩa vụ công dân đàng hoàng. Thế mà lại quay ra tuyển lão nhà chị! Mẹ, cay thì thôi luôn nhé!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083422
    m_Localized: 'Wifefema: Giời ơi là giời, vô lý thế chứ lại! Không tài nào hiểu nổi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083423
    m_Localized: 'Wifefema: Chị hận nó quá. Hận lão đến tận xương tận tủy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083424
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083425
    m_Localized: 'Wifefema: Này, chú mày cho chị nhờ tí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083426
    m_Localized: 'Wifefema: Mày gọi cho người ta hộ chị cái. Gọi đường dây nội bộ ấy, số đây: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083427
    m_Localized: 'Wifefema: Bảo là mày vừa gặp được nhân tố siêu phàm, một người phụ nữ vừa can đảm, vừa dày dặn kinh nghiệm. Nhắc cả ông xã nhà chị nữa cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083428
    m_Localized: 'Wifefema: Làm gì thì làm, nhớ phải bốc phét, nâng bi thật mạnh vào. Có thế chúng nó mới chịu để ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083429
    m_Localized: 'Wifefema: Chú mày muốn gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083430
    m_Localized: Chị làm ở hải quan đỡ hơn nhỉ? Ít ra ở đấy chị còn có tí quyền
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083431
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083432
    m_Localized: 'Wifefema: Gớm nữa, khỏi phải múa rìu qua mắt thợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083433
    m_Localized: 'Wifefema: Chị chưa hỏi ý kiến mày thì thôi, đừng có mà tinh tướng lên mặt. Trứng mà đòi khôn hơn vịt à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083434
    m_Localized: 'Wifefema: Chú mày là chủ ở đây, sướng quá còn gì nữa? Cứ ngồi không một chỗ thôi, thiên hạ thi nhau rồng rắn lên mây tìm đến nhà mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083435
    m_Localized: 'Wifefema: Mình lại được quyền quyết định xem ai là Dị Khách, ai là người thường nữa chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083436
    m_Localized: 'Wifefema: Nhưng đấy có phải việc của mày đâu, việc của bên Phòng Chống mà. Ai phong mày làm bá kiến chốn này, nắm quyền sinh sát trong tay hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083437
    m_Localized: 'Wifefema: Ít nhất bên Phòng Chống người ta còn có thẩm quyền. Mày nghĩ mày khôn hơn họ chắc?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083438
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083439
    m_Localized: 'Wifefema: Hừ, biết ngay mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277817
    m_Localized: 'Bestson: Lúc ba mẹ nói hết mọi chuyện, em có cảm giác như họ đã lừa dối em cả đời á.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277818
    m_Localized: 'Bestson: Nên là em nổi điên lên luôn, phi vào phòng rồi đóng cửa cái rầm. Chỉ muốn ba mẹ để yên một mình thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277819
    m_Localized: 'Bestson: Cái rồi ngày hôm sau...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277820
    m_Localized: 'Bestson: Y như em kể anh rồi đó. Vụ TV, với hoảng loạn các thứ, rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277843
    m_Localized: 'Bestson: Cám ơn anh đã giúp em thông suốt nha. Có duyên thì mình gặp sau ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277850
    m_Localized: 'Bestson: Phải thử mới biết được... Có duyên thì mình gặp lại ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277851
    m_Localized: 'Bestson: Ừ ha, anh nói nghe cũng có lý...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277852
    m_Localized: 'Bestson: Lỡ xe ba mẹ bị hư thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472084
    m_Localized: Ông kể cho tôi về bên Phòng Chống đi. Họ là ai vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472085
    m_Localized: Bọn áo vàng đang âm mưu gì thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472133
    m_Localized: Chết mẹ ông đi!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472150
    m_Localized: 'Fatman: Chuẩn bị vào nhà đá đi con! Sắp rồi đấy! Cứ chờ mà xem! HỜ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472169
    m_Localized: 'Fatman: Hờờờ... Đùa ai vậy chứ... Cuộc đời vĩnh viễn có quay về như xưa nữa đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472174
    m_Localized: 'Fatman: Đấy. Căng thẳng cái là bụng anh lại đau quặn đây này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472175
    m_Localized: 'Fatman: Vừa lòng chú mày chưa? Thôi đi đi. Anh chịu hết nổi rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472176
    m_Localized: 'Blind: Tối đen như mực...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472177
    m_Localized: Anh thấy gì, kể tôi nghe với?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666240
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666241
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666242
    m_Localized: 'Blind: Tin tôi đi, cậu đừng nên biết thì hơn. Biết rồi cậu sẽ không còn yên giấc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666243
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666244
    m_Localized: 'Blind: Những tưởng khi chẳng còn đôi mắt, thì cái... thứ ấy sẽ không đi theo ám ảnh tôi nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666245
    m_Localized: 'Blind: ...Nhưng bóng hình của NÓ đã hằn sâu vào tâm trí tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666246
    m_Localized: 'Blind: Hiện hình trong chiêm bao. Thường trực mãi ở đó. NÓ ghé thăm tôi mỗi ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666247
    m_Localized: 'Blind: Tối đen như mực...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666248
    m_Localized: Mất mắt rồi thì có đỡ hơn chút nào không anh?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666249
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666250
    m_Localized: 'Blind: Cũng không biết nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666251
    m_Localized: 'Blind: Tôi biết mình sẽ không bao giờ phải nhìn thấy thứ đó lần nữa. Giờ mà có con gì giết tôi thì tôi cũng chẳng hay được nó là gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666252
    m_Localized: 'Blind: ...Kỳ lạ lắm cậu ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666253
    m_Localized: 'Blind: Tôi không rõ nhà cậu trông thế nào, nên là khó dò đường lắm. May mà có thuốc, chứ không hốc mắt tôi lại nhói đau...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666254
    m_Localized: 'Blind: Thôi thì ít ra tôi không phải tận mắt chứng kiến nỗi khiếp đảm đó thêm lần nào nữa. Rồi sẽ quen dần thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666255
    m_Localized: 'Blind: Nhưng tiếc rằng cảnh tượng ấy... đã khắc sâu vào cốt tủy tôi rồi. Nó sẽ ám ảnh tôi đến hết đời, hết kiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666256
    m_Localized: 'Blind: Tối đen như mực...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666257
    m_Localized: Trông anh thảm quá vậy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666258
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666259
    m_Localized: 'Blind: Ha ha, chắc tôi phải chải tóc lại một tí...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666260
    m_Localized: 'Blind: Đêm qua tôi nằm mơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666261
    m_Localized: 'Blind: Trong mơ, tôi thấy mình đang rảo bước dọc đường ray để về nhà. Xung quanh là những mái nhà. Những hàng cây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666262
    m_Localized: 'Blind: Nghe tiếng tàu ù ù chạy đến, tôi liền nép qua một phía.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666263
    m_Localized: 'Blind: Tôi quay đầu lại... rồi bắt gặp thứ gì đó vồ lấy một ông đang bước trên đường.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666264
    m_Localized: 'Blind: Nó di chuyển quá nhanh, tôi không kịp nhìn rõ. Nhưng tôi biết... tôi biết nó là gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666265
    m_Localized: 'Blind: Tôi bèn đuổi theo tàu nhưng không thể lại gần, cũng không tài nào đến kịp. Chẳng bao giờ có thể chạm tới sự thật ẩn giấu nơi cuối con đường.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666266
    m_Localized: 'Blind: Rồi tôi choàng tỉnh giấc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666267
    m_Localized: 'Blind: Tối đen như mực...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666268
    m_Localized: Ổn không vậy anh?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666269
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666270
    m_Localized: 'Blind: Đêm qua tôi lại mơ. Tôi thấy NÓ xuất hiện.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666271
    m_Localized: 'Blind: Tôi bước đi trên phố. Giữa đêm khuya. Ánh đèn đường chập chờn, nhấp nháy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666272
    m_Localized: 'Blind: Rồi tôi quay qua, chợt thấy NÓ đang chậm rãi tiến đến gần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666273
    m_Localized: 'Blind: Lần này, tôi có thể nhận rõ cách NÓ di chuyển.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666274
    m_Localized: 'Blind: Tôi cố chạy đi, nhưng NÓ dần đuổi kịp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666275
    m_Localized: 'Blind: Chạy đến nhà rồi nhưng không thể mở khóa cổng, nên tôi tìm cách leo rào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666276
    m_Localized: 'Blind: Tôi cuống cuồng lục túi. Mấy chiếc chìa khóa rơi ra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666277
    m_Localized: 'Blind: Thế là tôi chạy vòng quanh nhà. Lại một cái hàng rào nữa. Tôi gồng mình leo tiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666278
    m_Localized: 'Blind: Rồi tôi dừng lại. Bốn bề im phăng phắc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666279
    m_Localized: 'Blind: Tôi ngước lên.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666280
    m_Localized: 'Blind: NÓ đây rồi. Nhoài mình qua hàng rào để túm lấy tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666281
    m_Localized: 'Blind: Cậu nghĩ có phải do thuốc giảm đau không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666282
    m_Localized: 'Blind: Tối đen như mực...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666283
    m_Localized: Tối qua anh có mơ thấy gì không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666284
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666285
    m_Localized: 'Blind: Có.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666286
    m_Localized: 'Blind: Nhưng tôi chẳng buồn kể nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666287
    m_Localized: 'Blind: Giờ tôi hiểu rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666288
    m_Localized: 'Blind: Chúng ta sẽ chết hết thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666289
    m_Localized: 'Blind: Dù ta có mơ hay tỉnh, cũng đều bị NÓ xé toạc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666290
    m_Localized: 'Blind: Tất tần tật sẽ cháy thành tro bụi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666291
    m_Localized: 'Blind: Hết thật rồi. Chẳng còn nghĩa lý gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666292
    m_Localized: 'Blind: Tôi... Làm ơn để tôi một mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666294
    m_Localized: Trước tận thế ông làm gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666295
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666296
    m_Localized: 'Dude: Ngồi nhà chill với mấy thằng cốt, coi phim các kiểu con đà điểu. Nét-phích mà hông có phịch ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666297
    m_Localized: 'Dude: Giờ thì còn phim đâu mà coi. Cũng chả có cốt nào rủ đi chơi nữa. Chán như con gián luôn bạn à.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666298
    m_Localized: 'Dude: Mở TV thì hết sáng tận thế, chiều tận thế, tới tối cũng tận thế. Mà nó cứ chèn quảng cáo trắng trợn. Mấy thằng cốt còn chả thèm nghe máy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666299
    m_Localized: 'Dude: Tui nghe cha già tai to mặt lớn nào phát biểu: "Bây giờ là thời kỳ khủng hoảng. Không còn thời gian để chơi bời nữa..."'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666300
    m_Localized: 'Dude: Thôi đi cha, cha thì biết cái quần què gì. Tuổi trẻ là phải chơi hết sức, vui hết mình chớ! YOLO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666302
    m_Localized: Thế ông làm nghề gì để kiếm sống?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666303
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666304
    m_Localized: 'Dude: "Nghề" á? Úi thọc lét đi cho tui cười!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666305
    m_Localized: 'Dude: Đi làm thì lấy đâu ra thời gian để chơi? Tui đách phải nô lệ tư bản. Sống như tui mới là sống hết mình, hiểu hông bro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666306
    m_Localized: 'Dude: Bữa tui coi phim á, thấy có thằng nhân vật chính kiểu, rất tui luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666307
    m_Localized: 'Dude: Chứ ông thấy mấy khứa công nhân đó, có khi nào vui hông? Nhìn mặt cứ như đưa đám ý, sao mà vui nổi bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666308
    m_Localized: 'Dude: Tui thì mở tiệc quẩy banh nóc nhà, kết bè kết bạn tứ phương. Vậy mới là bảnh, là sống chớ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666309
    m_Localized: 'Dude: Ờ thì kiểu... tui làm quản lý kho, vận chuyển hàng hóa này nọ lọ chai. Được người quen giới thiệu á.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666310
    m_Localized: À là ông ăn bám bố mẹ chứ gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666311
    m_Localized: Lười biếng ăn không ngồi rồi quá nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666312
    m_Localized: 'Dude: Cày cuốc làm chi cho mệt hả bro? Tui tính hết rồi, chả phải lo gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666313
    m_Localized: 'Dude: Nhà có sẵn của thì tội gì mà hông xài. Để phí mới là ngu đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666314
    m_Localized: 'Dude: Như bro thôi á, có quả súng to chà bá lửa kìa. Cũng đâu phải để trưng cho đẹp, đúng hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666315
    m_Localized: 'Dude: Làm gì có. Phải lấy ra xài chớ. Tui cũng như ông, đời đẩy đi đâu thì tui theo đó thôi, con vợ à.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666316
    m_Localized: 'Dude: Uầy, chill xíu đi bro, pressing dữ vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666317
    m_Localized: 'Dude: Ông ganh tị thì cứ nói một câu, gì đâu mà phải ngại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666318
    m_Localized: 'Dude: Tui hiểu, tui thông cảm, đâu phải ai sinh ra cũng ở vạch đích. Cuộc sống mà bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666320
    m_Localized: Ông sao vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666321
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666322
    m_Localized: 'Dude: Con vợ ơi là con vợ... Bộ nhà ông hổng có nổi cuộn băng à? Thèm coi phim quá mà có cái nịt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666323
    m_Localized: 'Dude: Đừng nói là ông không coi phim luôn ấy nhá?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666324
    m_Localized: 'Dude: Trời ơi tui chánnnnnn tới tận cổ luôn rồi nè brooooo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666325
    m_Localized: Giờ này mà xem phim gì nữa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666326
    m_Localized: Tôi không có phim đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666327
    m_Localized: 'Dude: Uầy, nản vờ lờ. Cứ tưởng chỗ này cháy lắm chớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666328
    m_Localized: 'Dude: Nói thiệt hông giỡn nha. Mấy khứa ở đây cứ... kỳ cục kẹo kiểu gì ý. Mà cũng chả có phim gì coi luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666329
    m_Localized: 'Dude: Trong nhà không báo cũng không phim... Được mỗi vài cuốn sách.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666330
    m_Localized: 'Dude: Quê vậy bro, thời này ai còn đọc sách nữa? Phải người tối cổ đâu hả trời. Toàn chữ với chữ, cầm lên là muốn khò khò.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666331
    m_Localized: Nhà tôi chứ có phải cái rạp chiếu phim đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666332
    m_Localized: Ông tới đây để quẩy hay để sinh tồn?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666333
    m_Localized: 'Dude: Má thiệt luôn hả bro! Giỡn hoài!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666334
    m_Localized: 'Dude: Con vợ... thực sự hông nói giỡn?? ĐÙ MÁ quỷ thần ơi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666335
    m_Localized: 'Dude: Nhà lắp cái TV bự tổ chảng mà lại chả có băng đĩa phim hay gì luôn?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666336
    m_Localized: 'Dude: Tiệc gì mà chánnnnnn chết luôn. Cứ tưởng con vợ phải ngầu lắm cơ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666337
    m_Localized: Nhà tôi chứ có phải cái rạp chiếu phim đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666338
    m_Localized: Ông tới đây để quẩy hay để sinh tồn?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666339
    m_Localized: 'Dude: Ông ơiiiiiiiiiiiiii...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666341
    m_Localized: 'Dude: Đang vui mà bạn cứ phá mood dễ sợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666342
    m_Localized: Ông muốn sống thọ thì phải bình tĩnh lại đi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666343
    m_Localized: Không thích thì mời ra ngoài
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666344
    m_Localized: 'Dude: Thôi mà bạn hiền ơi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666345
    m_Localized: 'Dude: Má cái TV nhà tui nó bể tùm lum rồi bro. Cứ trông qua nhà ông coi ké cho đỡ buồn, ai dè đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666347
    m_Localized: 'Dude: Đang vui mà bạn cứ phá mood dễ sợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666348
    m_Localized: Ông muốn sống thọ thì phải bình tĩnh lại đi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666349
    m_Localized: Không thích thì mời ra ngoài
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666351
    m_Localized: 'Dude: Chill đi bro ơi. Chỗ này chán toàn tập luôn, nhưng thôi còn đỡ hơn là ăn bờ ở bụi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666352
    m_Localized: 'Dude: Hay cho tui... coi ké TV xíu thôi cho đỡ buồn, đi mà nhaaaa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666353
    m_Localized: 'Dude: Má thề, tui chán ông lắm rồi đó bro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666356
    m_Localized: 'Teacher: Tội nghiệp tụi nhỏ quá đi mất...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666357
    m_Localized: Cô thấy đỡ hơn chưa ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666358
    m_Localized: Em cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666359
    m_Localized: 'Teacher: Cô không biết nữa... Chắc cũng tàm tạm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666360
    m_Localized: 'Teacher: Cô... không hiểu vì sao những người trưởng thành, đáng ra phải biết suy nghĩ, lại để cảm xúc xui khiến mà châm mồi đốt lửa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666361
    m_Localized: 'Teacher: Người ta hoảng loạn tới mức nỡ lòng đi giết hại một đứa trẻ sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666362
    m_Localized: Giờ người ta còn làm nhiều chuyện tàn ác hơn cô ạ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666363
    m_Localized: Khi lâm vào khủng hoảng, con người mất đi lý trí đầu tiên
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666364
    m_Localized: 'Teacher: Còn gì tàn nhẫn hơn là cướp đi sinh mạng của một đứa nhỏ không thể tự vệ bản thân nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666365
    m_Localized: 'Teacher: Không chỉ một người... mà là nguyên một đám đông. Đúng là lũ côn đồ khát máu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666366
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666367
    m_Localized: 'Teacher: Qua gian lao mới thấu được lòng người. Có lẽ chúng ta mới chính là quái vật, chứ không phải những kẻ bò lên từ lòng đất.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666368
    m_Localized: 'Teacher: Nhưng mà đi giết trẻ con á? Ôi trời ơi... Hành động ấy, nó... Cô còn không biết dùng từ gì để tả xiết...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666369
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666370
    m_Localized: 'Teacher: Qua gian lao mới thấu được lòng người. Có lẽ chúng ta mới chính là quái vật, chứ không phải những kẻ bò lên từ lòng đất.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666371
    m_Localized: 'Teacher: Tội nghiệp tụi nhỏ quá đi mất...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666372
    m_Localized: Cô làm giáo viên được bao lâu rồi ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666373
    m_Localized: Em cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666374
    m_Localized: 'Teacher: Tầm ba tháng... trước khi thảm họa xảy ra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666375
    m_Localized: 'Teacher: Mà cô cũng chẳng giỏi giang hay gương mẫu gì đâu. Ban đầu cô còn không yêu nghề, chỉ thấy mấy đứa nhỏ ồn như cái chợ, làm cô đau hết cả đầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666376
    m_Localized: 'Teacher: Nhưng khi thảm họa nổ ra, cô bắt đầu nhìn đời bằng con mắt khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666377
    m_Localized: 'Teacher: Em biết không, biết bao con đường đang rộng mở trước mắt tụi nhỏ. Lẽ ra tụi nó đã có thể trở thành nghệ sĩ, chính trị gia, hay làm cha làm mẹ nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666378
    m_Localized: 'Teacher: Vậy mà giờ đây... mất hết rồi. Tụi nó sẽ không bao giờ được chơi đàn guitar. Được cắp sách đến trường. Hay mỗi ngày một khôn lớn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666379
    m_Localized: 'Teacher: Tụi nhỏ sẽ mãi chỉ là... những đứa trẻ mộng mơ mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666380
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666381
    m_Localized: 'Teacher: Cô còn nhớ một hôm nọ, có một đứa nhỏ chạy đến tìm cô, khóc nức nở rồi nói cha mẹ ở nhà đang sợ nó dữ lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666382
    m_Localized: 'Teacher: Họ nghi thằng nhỏ là Dị Khách, nên quyết định... đuổi nó ra khỏi nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666383
    m_Localized: 'Teacher: Nó chẳng còn biết đi về đâu, nên đã tìm tới cô... tới trường mầm non chỗ cô làm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666384
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666385
    m_Localized: 'Teacher: (Cô giáo không kìm được nước mắt, bắt đầu bật khóc)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666386
    m_Localized: 'Teacher: Xin lỗi em nhé...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666387
    m_Localized: 'Teacher: Tội nghiệp tụi nhỏ quá đi mất...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666388
    m_Localized: Em xin lỗi chuyện hôm qua. Em lỡ làm cô buồn
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666389
    m_Localized: Em cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666390
    m_Localized: 'Teacher: Không sao. Giờ cô... đỡ rồi. Cô thấy khá hơn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666391
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666392
    m_Localized: 'Teacher: Quay lại chuyện cậu bé đó... Sau khi nó tìm đến cô, cô chợt nhận ra rằng con nít thật sự quá nhỏ nhoi và yếu đuối. Nhất là khi cả thế giới sụp đổ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666393
    m_Localized: 'Teacher: Thế là cô mới bắt đầu cưu mang hết mọi đứa trẻ côi cút mà cô tìm được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666394
    m_Localized: 'Teacher: Cô lắng nghe câu chuyện của từng đứa... Nghe tụi nhỏ kể mình bị các bậc phụ huynh vứt bỏ không chút do dự, cô đau lòng lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666395
    m_Localized: 'Teacher: Mấy người này cứ đổ thừa hoàn cảnh, làm như xảy ra thảm họa thì có cớ để bỏ mặc chính con mình vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666396
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666397
    m_Localized: 'Teacher: Có lẽ... ngay từ đầu họ đã chẳng muốn có con rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666398
    m_Localized: 'Teacher: Tội nghiệp tụi nhỏ quá đi mất...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666399
    m_Localized: Cô có con cái gì không ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666400
    m_Localized: Em cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666401
    m_Localized: 'Teacher: Cô... chưa em ạ. Mẹ cô lúc nào cũng thúc cô cưới chồng để yên bề gia thất.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666402
    m_Localized: 'Teacher: Nhưng cô vẫn thấy mình chưa sẵn sàng. Cô không muốn vội vàng hấp tấp, mà phải suy nghĩ thấu đáo rồi mới đưa ra quyết định, em hiểu không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666403
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666404
    m_Localized: 'Teacher: Nghe mấy đứa nhỏ cù bất cù bơ chia sẻ cảnh ngộ của mình... Mà cô sực nghĩ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666405
    m_Localized: 'Teacher: Nếu cô cứ nhắm mắt làm theo lời mẹ, liệu có thành ra giống như phụ huynh của tụi nó không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666406
    m_Localized: 'Teacher: Bởi vậy cô mới quyết định: phải cưu mang hết những đứa trẻ bị xã hội ruồng bỏ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666407
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666408
    m_Localized: 'Teacher: Mà buồn nhất là gì em biết không? Một trong những kẻ phóng hỏa là phụ huynh của một đứa nhỏ mà cô đã nhận vào trường...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666409
    m_Localized: 'Teacher: (Cô giáo lại xúc động nghẹn ngào, nước mắt ứa ra)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666410
    m_Localized: 'Teacher: Xin lỗi em nhé...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666411
    m_Localized: 'Teacher: Cô... thật sự rất cố gắng để mấy đứa trẻ được sống vui, sống khỏe. Cô thương sắp nhỏ dữ lắm em à. Cuộc đời tụi nó sao mà kết thúc bi ai quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666412
    m_Localized: 'Teacher: Lỗi tại cô hết...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666413
    m_Localized: Chuyện bọn nhỏ không phải lỗi của cô đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666414
    m_Localized: Em xin chia buồn với cô
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666415
    m_Localized: 'Teacher: Em nói cũng có lý, nhưng... cô vẫn thấy lòng đau như cắt, như có một khoảng trống lớn trong tim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666416
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666417
    m_Localized: 'Teacher: Em biết không, có một suy nghĩ cứ đeo bám cô suốt đêm ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666418
    m_Localized: 'Teacher: Có khi nào đám phụ huynh chưa bao giờ thương yêu gì tụi nó? Thậm chí không dành chút tình cảm nào luôn?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666419
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666420
    m_Localized: 'Teacher: Cô chỉ... mong là mình đã có thể sưởi ấm cho tụi nhỏ bằng chút tình thương...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666421
    m_Localized: 'Teacher: Cảm ơn em... nhưng cô vẫn đau như đứt từng khúc ruột. Chắc cả đời cũng không nguôi ngoai nổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666422
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666423
    m_Localized: 'Teacher: Em biết không, có một suy nghĩ cứ đeo bám cô suốt đêm ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666424
    m_Localized: 'Teacher: Có khi nào đám phụ huynh chưa bao giờ thương yêu gì tụi nó? Thậm chí không dành chút tình cảm nào luôn?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666425
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666426
    m_Localized: 'Teacher: Cô chỉ... mong là mình đã có thể sưởi ấm cho tụi nhỏ bằng chút tình thương...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860583
    m_Localized: Chị ổn không? Đứa nhỏ sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860584
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860591
    m_Localized: Tôi cần kiểm tra hai người
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860597
    m_Localized: Tôi cần kiểm tra hai người
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860610
    m_Localized: 'Couple: Thôi không sao cả. Chỉ cần mình không bỏ cuộc, cứ đi tiếp là sẽ tới thôi mà, nhỉ em yêu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860611
    m_Localized: 'Couple: Biết đâu đấy, có khi một tuần nữa là tới nơi rồi! Hà hà hà!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860614
    m_Localized: Tôi cần kiểm tra hai người
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860622
    m_Localized: Tôi cần kiểm tra hai người
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860627
    m_Localized: Thế còn anh thì sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860629
    m_Localized: 'Couple: Bọn tôi sẽ sắp xếp rời đi sớm thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860630
    m_Localized: 'Couple: Có khi tầm này vợ tôi cũng chẳng buồn nghĩ đến mẹ mình nữa rồi… Nhưng tôi vẫn phải đưa cô ấy đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860631
    m_Localized: 'Couple: Cũng mong là bà già đấy chưa nghẻo. Hà hà!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860634
    m_Localized: 'Couple: Hình như bà xã tôi cũng đếch thèm quan tâm đến mẹ mình nữa rồi. Hà hà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860635
    m_Localized: 'Couple: Hay là tôi phải nhắc cho cô ấy nhớ là bà già có khi đang gặp nguy hiểm? NHỈ EM?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860636
    m_Localized: 'Couple: Xin lỗi vì to tiếng trước mặt chú nha. Tại vợ tôi cứ chần chừ mãi ấy, tôi cũng muốn phát điên luôn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860637
    m_Localized: 'Couple: Cái con này, ngồi xuống chuẩn bị đồ nhanh lên coi! Lề mề vãi lồn! Mẹ nhà mày!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860640
    m_Localized: Tôi cần kiểm tra hai người
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860647
    m_Localized: Gì mà căng lên thế này?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860662
    m_Localized: Ông biến đi là được
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054856
    m_Localized: Tao bắn đấy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054857
    m_Localized: Bình tĩnh nào. Ông bỏ súng xuống đi, tôi cũng bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054858
    m_Localized: 'Couple: Mày định giết cả phụ nữ vô tội luôn? Vô tâm đến thế cơ à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054859
    m_Localized: 'Couple: Mày bắn tao thì nó cũng dính đạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054860
    m_Localized: 'Couple: Chả phải tại tao đâu! Chính mày đòi giết, nó mà chết là tội của mày.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054861
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054862
    m_Localized: Cảnh cáo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054873
    m_Localized: 'Couple: B-Bình tĩnh! Đừng có bắn, bọn tôi đi ngay mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054874
    m_Localized: 'Couple: Đi nhé? Mày đi với tao nhé con đĩ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054879
    m_Localized: 'Couple: Được rồi, bọn tôi đi ngay đây. Chú cho xin cái gì để che người cái đã, nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054880
    m_Localized: 'Couple: Bọn tôi sẽ biến khuất mắt chú luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054881
    m_Localized: 'Couple: Khoan…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054882
    m_Localized: 'Couple: C-CHÚ LÀM GÌ ĐẤY?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054883
    m_Localized: 'Couple: (Bạn nổ súng bắn gã, viên đạn trúng luôn cả người cô vợ)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054884
    m_Localized: 'Couple: (Cả hai cùng gục xuống, máu chảy lênh láng)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054885
    m_Localized: 'Couple: (Người phụ nữ gắng gượng, rên rỉ một lúc, nhưng bạn không thể làm gì hơn)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054886
    m_Localized: 'Couple: (Cuối cùng, cả hai đều đã chết)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054887
    m_Localized: 'Couple: Mày không hiểu à? Chỉ còn cách này thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054888
    m_Localized: 'Couple: Bọn tao đi. Chấm hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054890
    m_Localized: 'Couple: (Bạn thấy hai người họ trùm kín người lại rồi bước ra ngoài)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054891
    m_Localized: 'Couple: (Họ đi được một lúc thì bỗng dưng gục xuống)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054892
    m_Localized: 'Couple: (Tấm mền bắt đầu bốc khói. Bạn lẳng lặng quay mặt đi)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054893
    m_Localized: 'BigLebowski: Hừ, sắp chịu hết nổi rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054894
    m_Localized: Sao cháu tới đây có một mình vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054895
    m_Localized: Chú cần kiểm tra cháu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054896
    m_Localized: 'BigLebowski: Thì... nhà chật, lại còn ồn vãi. Ai mà chịu nổi. Tôi chỉ muốn ra ngoài thôi. Xem thế giới nó như nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054897
    m_Localized: 'BigLebowski: Thích thì nhích thôi, đeo balo, nhét thêm vài lon soda, đồ ăn vặt, cả cái vòng tay tình bạn tôi làm hồi còn đi học nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054898
    m_Localized: 'BigLebowski: ...Rồi lên đường luôn. Hai ông bà già còn chẳng phát hiện. Tôi cũng kệ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054899
    m_Localized: 'BigLebowski: Từ đó đến giờ cứ lang thang, ở ké được chỗ nào thì ké. Tính ra sống cũng ổn phết đấy chứ, không đến nỗi nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054900
    m_Localized: 'BigLebowski: Chẳng có ai đi sau càm ràm nữa, tôi cứ thế tự quyết thân mình thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054903
    m_Localized: 'BigLebowski: Hừ, sắp chịu hết nổi rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054904
    m_Localized: Rồi cháu lấy gì mà sống được?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054905
    m_Localized: Chú cần kiểm tra cháu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054906
    m_Localized: 'BigLebowski: Thì cứ tìm cách thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054907
    m_Localized: 'BigLebowski: Trốn vào gầm cầu thang này, kho chứa đồ này, không thì ngủ dưới cây này. Có mái che để tránh nắng là được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054908
    m_Localized: 'BigLebowski: Kiếm được gì thì ăn cái đó. Nhổ rau dại ngoài đường, hoặc là chôm kẹo trong tiệm mà ăn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054909
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054910
    m_Localized: 'BigLebowski: Nhìn gì? Ờ, tôi ăn trộm đấy. Ghê gớm chưa. Chứ muốn tôi sống sao? Có ai chịu thuê tôi làm việc đâu. Nên tôi mặc kệ hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054911
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233280
    m_Localized: 'BigLebowski: Hừ, làm sao nữa? Tưởng tôi định trộm gì trong nhà chú hả? Xin kiếu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233281
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233282
    m_Localized: 'BigLebowski: Gì nữa? Muốn tra khảo con nhà người ta hay gì? Dẹp hộ đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054912
    m_Localized: 'BigLebowski: Hừ, sắp chịu hết nổi rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054913
    m_Localized: Rồi cháu định sống vậy đến bao giờ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054914
    m_Localized: Chú cần kiểm tra cháu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054915
    m_Localized: 'BigLebowski: Hừ, chú quan tâm làm gì? Tôi tự xoay xở được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054916
    m_Localized: 'BigLebowski: Sao? Thấy cho tôi ở nhờ khó khăn lắm hả? Bộ tôi trộm cái gì của chú hả? Hay là làm tắc bồn cầu nhà chú? Sao cứ dí mãi vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054917
    m_Localized: 'BigLebowski: À... Ra chú là dê xồm chứ gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054918
    m_Localized: 'BigLebowski: Trước gặp một thằng y chang. Nói ngon nói ngọt, cho tôi chỗ ở.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054919
    m_Localized: 'BigLebowski: Rồi còn xem chung anime, phim truyện các kiểu nữa chứ. Cứ tưởng tìm được người tử tế rồi cơ. Nhưng méooooo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054920
    m_Localized: 'BigLebowski: ...Nó lăm le sờ soạng người tôi. Mọe cái thằng dâm tặc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054921
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233283
    m_Localized: 'BigLebowski: Chú mà giở trò là tôi không để yên đâu. Đừng hòng làm hại được bà đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233284
    m_Localized: 'BigLebowski: Ông già nhà tôi tuy hãm cành cạch, cơ mà ít ra lão vẫn dạy cho tôi vài đường quyền phòng thân.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233285
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233286
    m_Localized: 'BigLebowski: Đúng rồi, xích ra đê.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054922
    m_Localized: 'BigLebowski: Hừ, sắp chịu hết nổi rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054923
    m_Localized: Xong chuyện gì xảy ra với cái tên kia rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054924
    m_Localized: Chú cần kiểm tra cháu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054925
    m_Localized: 'BigLebowski: Hỏi làm gì? Định tìm cách trấn áp tôi nếu tôi đánh trả hả? Hả? Hả? ...Kệ xác chú.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054926
    m_Localized: 'BigLebowski: Tôi đâu có bị ngu. Chú hỏi han cũng có phải vì tử tế gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054927
    m_Localized: 'BigLebowski: Chú chỉ không muốn chứa tai họa trong nhà thôi chứ gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054928
    m_Localized: 'BigLebowski: May cho chú là tôi không phải tai họa đấy. Chẳng ăn cắp, phá cửa nhà chú gì hết. Nên chú bớt bớt giùm!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054929
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054930
    m_Localized: 'BigLebowski: Với cả...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054931
    m_Localized: 'BigLebowski: Chú cần nên tôi mới ở lại đó thôi? Để cho cái thằng cởi trần kia không bắt chú còn gì nữa? Ừ, tôi biết hết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233287
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233288
    m_Localized: 'BigLebowski: Đã thế thì... đấy, kiểm gì thì kiểm đi! Ựa, tởm chết. Đừng có mở miệng nói chuyện là được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054932
    m_Localized: 'BigLebowski: Hừ, sắp chịu hết nổi rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054933
    m_Localized: Sao bố cháu dạy cháu đánh nhau vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054934
    m_Localized: Chú cần kiểm tra cháu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054935
    m_Localized: 'BigLebowski: Để đấm vỡ mồm bọn dâm tặc chứ sao... Hoặc là để tôi làm bao cát cho lão trút giận.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054936
    m_Localized: 'BigLebowski: Cách ra đòn này, cách đỡ đòn này, vân vân mây mây. Lão chỉ tôi hết. Chẳng qua lão không đấm bao cát mà đấm vào mặt tôi luôn thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233289
    m_Localized: 'BigLebowski: Ừ thì đôi lúc cũng bắt tôi luyện tử tế thật, nhưng mà tôi ghét lắm luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233290
    m_Localized: 'BigLebowski: Bình thường ổng cứ nổi cơn lôi đình rồi đấm tôi ra bã. Còn bà bô tôi á hả? Bà ý đéo quan tâm luôn. Đã vậy còn chả thèm nhìn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233291
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233292
    m_Localized: 'BigLebowski: Èo, tôi chẳng muốn lớn lên thành loại người như hai ông bà ý đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233293
    m_Localized: 'BigLebowski: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233294
    m_Localized: 'BigLebowski: Đẻ tôi ra xong rồi ngược đãi kiểu đấy thì đẻ làm quái gì. Không hiểu luôn ý. Bộ sống trên đời là phải như này à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233295
    m_Localized: 'BigLebowski: Xong rồi giờ phải đối phó với mặt trời, lại thêm cả bọn Dị Khách nữa? Vui gớm, làm như đời chưa đủ cứt đái hay sao ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233296
    m_Localized: 'BigLebowski: Đời có bao giờ tốt đẹp được tí nào không vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233297
    m_Localized: 'BigLebowski: Có cái nịt ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054942
    m_Localized: 'Luka: Cơn bão này cũng đã hủy diệt lắm rồi, mình đâu thể làm nó tệ hơn được nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054943
    m_Localized: 'Luka: Rồi khi dông tố đi qua... tớ tin rằng chúng ta có thể học cách tha thứ cho nhau bất kể mọi lỗi lầm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054944
    m_Localized: "Luka: Nơi nào có lòng trắc ẩn,\nnơi đó có tình người."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054947
    m_Localized: Lúc nào anh cũng lạc quan thế này à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054977
    m_Localized: 'Luka: Lá lành đùm lá rách. Mỉm cười giữa chông gai. Thương người như thể thương thân. Đó mới là lẽ sống.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054978
    m_Localized: 'Luka: Mỗi khi có ai góp mình để giúp thế giới trở nên tốt đẹp hơn, dù cho cỏn con đến mấy, tớ tin hành động đó vẫn có ý nghĩa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054979
    m_Localized: 'Luka: Sau cơn mưa, nhất định trời sẽ sáng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054980
    m_Localized: Anh có ước được hồi sinh tất cả không? Căn nhà với gia đình mình ấy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054981
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054983
    m_Localized: 'Luka: Nhưng hồi sinh mọi thứ thì... chưa chắc. Mất mát là một phần của cuộc sống mà. Dẫu có đau đớn, nó vẫn nhào nặn nên con người chúng ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054984
    m_Localized: 'Luka: Nói vậy không phải là tớ không muốn đâu. Tớ sẵn sàng đánh đổi tất cả chỉ để có thêm một ngày ở bên họ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054985
    m_Localized: 'Luka: Nhưng nếu phải từ bỏ những gì mình đã trải qua, từ bỏ bài học về sự tha thứ, chấp nhận và bước tiếp... thì câu trả lời là không.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054986
    m_Localized: 'Luka: Đời người ngắn ngủi lắm. Thay vì cứ mãi luyến tiếc những điều đã mất, chi bằng mình hãy trân trọng những gì đang có đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249152
    m_Localized: 'Hunter: Cảnh giác vào. Chưa biết ai là Dị Khách đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249153
    m_Localized: Bác là thợ săn phải không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249154
    m_Localized: Tôi cần kiểm tra bác
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249155
    m_Localized: 'Hunter: Kiểm lâm thì đúng hơn nhé cu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249156
    m_Localized: 'Hunter: Hồi xưa bác ở tít trong rừng. Làm gì cóa TV, chỉ cóa đài thôi. Lúc nghe phát thanh bác mới biết tin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249157
    m_Localized: 'Hunter: Thế là bác không choa bố con thằng nào bén mảng vào khu của bác hết. Nhà mình là thành trì cuối cùng giồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249158
    m_Localized: 'Hunter: Nhỡ cho vào xong phát hiện nóa là Dị Khách thì sao? Nghe nóa dỗ ngon dỗ ngọt choa lắm, đến lúc mình ngủ lại rình rình rạch cổ thì bỏa miẹ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249159
    m_Localized: Thế sao bác lại ra đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249160
    m_Localized: Ở một mình không an toàn đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249161
    m_Localized: Hunter:...
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249162
    m_Localized: 'Hunter: Còn lâu bác mới để cái thằng chóa cao ngồng ấy tóm được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249163
    m_Localized: 'Hunter: Tại nóa nên bác mới phải bỏa nhà lại mà đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249164
    m_Localized: 'Hunter: Ờ, bác nhìn mắt mày là biết. Mày cũng gặp nóa giồi phải không, con giai?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249165
    m_Localized: Sao bác sống sót một mình ngoài kia được hay vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249166
    m_Localized: Bác cũng nhìn thấy tên Dị Khách cao lêu nghêu, da tái nhợt ấy à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249167
    m_Localized: 'Hunter: Ờ thì bác phải xoay xở chứ sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249168
    m_Localized: 'Hunter: Không là thành mồi ngon cho bọn sâu bọa xơi tái từ tám hoánh nào giồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249169
    m_Localized: 'Hunter: Trước kia, bác cứ đinh ninh chỉ cóa mấy thằng ngu mới choa người lạ vào nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249170
    m_Localized: 'Hunter: Cứ tưởng ở một mình là an toàn nhất... Choa tới khi thằng sâu bọa đấy xuất hiện.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249171
    m_Localized: 'Hunter: Bố tổ, từng này tuổi giồi mà chưa gặp thằng nào quái gở như nóa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249172
    m_Localized: Sao bác sống sót một mình ngoài kia được hay vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249173
    m_Localized: Bác cũng nhìn thấy tên Dị Khách cao lêu nghêu, da tái nhợt ấy à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249174
    m_Localized: 'Hunter: Chuyện dài lắm con giai. Nay bác không cóa hứng kể đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249175
    m_Localized: 'Hunter: Mai mày mang lon bia choa bác. Bác sẽ thuật lại choa mày hết đầu đuôi sự việc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249176
    m_Localized: 'Hunter: Hóa ra không phải mỗi mình bác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249177
    m_Localized: 'Hunter: Ờ... bác thấy nóa mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249178
    m_Localized: 'Hunter: Mày không biết bác đã phải trải qua những gì đâu con ạ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249179
    m_Localized: 'Hunter: Để bác kể mày nghe sau. ...Tối nay thì thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249180
    m_Localized: 'Hunter: Mai mày mang choa bác lon bia, bác thuật lại hết choa mà biết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249181
    m_Localized: 'Hunter: Cảnh giác vào. Chưa biết ai là Dị Khách đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249182
    m_Localized: Thế chuyện là như nào hả bác?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249183
    m_Localized: Tôi cần kiểm tra bác
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249184
    m_Localized: 'Hunter: Mày cóa mang bia không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249185
    m_Localized: Có ạ (đưa lon bia)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249186
    m_Localized: 'Hunter: Cái giề, không cóa bia hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249187
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249188
    m_Localized: Không ạ (không đưa lon bia)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249189
    m_Localized: 'Hunter: Được đấy con giai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249190
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249191
    m_Localized: 'Hunter: Thì như bác bảo đấy, lúc trước bác cứ cố thủ một mình trong nhà gỗ thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249192
    m_Localized: 'Hunter: Xong tự dưng có thằng mòa đến, nom khổ sở lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249193
    m_Localized: 'Hunter: Nóa quay ra đập cửa ầm ầm, cầu xin bác choa vào tá túc. Nhưng bác mày đã lú đâu con. Còn tỉnh lắm nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249194
    m_Localized: 'Hunter: Mặt mũi nóa xanh xao, người thì run như cầy sấy, trông như vừa chết đi sống lại. Chả hiểu đi đứng kiểu gì mà lạc được tít vào trong rừng thế này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249195
    m_Localized: 'Hunter: Trông cũng chả giống cái bọn hay đi leo núi quanh đấy, nên bác bảo nóa cút luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249196
    m_Localized: 'Hunter: Bố tổ thằng này còn định đập vỡ cửa sổ, mà bác dọa "Tao cóa súng nhá" phát là nóa chạy mất dép.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249197
    m_Localized: 'Hunter: Cứ tưởng thế là xong, không gặp lại nóa nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249198
    m_Localized: Biết đâu người ta cần giúp thật thì sao bác?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249199
    m_Localized: Lẽ ra bác nên cho người ta vào
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249200
    m_Localized: Sau đó sao nữa ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249201
    m_Localized: 'Hunter: Mày hâm à, nóa đang bị thứ gì đuổi mà. Chả nhẽ đi mời vào nhà để chết chùm à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249202
    m_Localized: 'Hunter: Còn khuya nhá. Một mình tao đủ khổ giồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249203
    m_Localized: Vậy thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249204
    m_Localized: Bác cũng kiệm lời nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249205
    m_Localized: Bác đã kể được gì mấy đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249206
    m_Localized: Ý là phải có miếng bia thì mới mở đầu câu chuyện chứ gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249207
    m_Localized: 'Hunter: Thôi thôi, đừng cóa ra vẻ anh hùng nghĩa hiệp. Mày chả đuổi bao người khác đi giồi còn gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249208
    m_Localized: 'Hunter: Không thì làm gì cóa chuyện mày còn sống đến bây giờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249209
    m_Localized: 'Hunter: Mà thôi, để mai kể tiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249210
    m_Localized: Vậy thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249211
    m_Localized: Bác cũng kiệm lời nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249212
    m_Localized: Bác đã kể được gì mấy đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249213
    m_Localized: Ý là phải có miếng bia thì mới mở đầu câu chuyện chứ gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249214
    m_Localized: 'Hunter: Bác cứ đinh ninh là sẽ chả bao giờ đụng mặt nóa nữa. Thế mà hôm sau... nóa lại tìm ra bác mới ghê.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249215
    m_Localized: 'Hunter: Nhưng thôi, hôm khác kể tiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249216
    m_Localized: Vậy thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249217
    m_Localized: Bác cũng kiệm lời nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249218
    m_Localized: Bác đã kể được gì mấy đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249219
    m_Localized: Ý là phải có miếng bia thì mới mở đầu câu chuyện chứ gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249220
    m_Localized: 'Hunter: Ngày mai mày cứ đem bia đến đây... Bác kể nốt choa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249221
    m_Localized: 'Hunter: Bác đây không thích noái nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249222
    m_Localized: 'Hunter: Mày được nghe bác mở mồm ra kể là phước lắm giồi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249223
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249224
    m_Localized: 'Hunter: Ngày mai mày cứ đem bia đến đây, bác kể nốt choa. Chốt thế nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249225
    m_Localized: 'Hunter: Thằng này, mày cứ vội làm gì. Bác chứng kiến bao sự long giời lở đất giồi con ạ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249226
    m_Localized: 'Hunter: Phải cóa tí cồn vào choa tăng máu liều thì mới thuật lại được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249227
    m_Localized: 'Hunter: Mang bia ra đây, giồi bác kể.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249228
    m_Localized: 'Hunter: Mày cũng tinh ý đấy con giai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249229
    m_Localized: 'Hunter: Bác đây không thích noái chuyện xoàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249230
    m_Localized: 'Hunter: Mai mày mang bia đến đi, bác kể nốt choa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249231
    m_Localized: 'Hunter: Xin lỗi cu nhá... không làm tí men thì không kể được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249232
    m_Localized: 'Hunter: Cứ mang bia đến, giồi muốn sao thì muốn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249233
    m_Localized: 'Hunter: Cảnh giác vào. Chưa biết ai là Dị Khách đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249234
    m_Localized: Bác kể nốt đi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249235
    m_Localized: Tôi cần kiểm tra bác
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249236
    m_Localized: 'Hunter: Giồi thì kể, mày cứ mang bia ra đã.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249237
    m_Localized: Đây ạ (đưa lon bia)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249238
    m_Localized: 'Hunter: Cái gì, không có bia hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249239
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249240
    m_Localized: Không ạ (không đưa lon bia)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249241
    m_Localized: 'Hunter: Cảm ơn thằng cu nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249242
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249243
    m_Localized: 'Hunter: Sau thì thằng đóa ba chân bốn cẳng chạy mất, còn bác ở lại trong căn nhà gỗ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249244
    m_Localized: 'Hunter: Nhưng lúc sau bác hết sạch củi lửa, thế là phải chạy ra ngoài kiếm thêm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249245
    m_Localized: 'Hunter: Nhặt củi xong, vừa về đến nhà thì... phát hiện khẩu súng săn của bác đã không cánh mà bay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249246
    m_Localized: 'Hunter: Bác đứng hết cả tim. Lật tung cả căn nhà lên mà chả tìm thấy nóa đâu. Mẹ sư.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249247
    m_Localized: 'Hunter: Xong bác nhìn ra ngoài cửa sổ, thì bắt gặp thằng ôn hôm trước.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249248
    m_Localized: 'Hunter: Súng của bác đang nằm trong tay nóa... Cơ mà trông nóa khác lắm mày ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249249
    m_Localized: 'Hunter: Dáng người cao hơn. Da chảy xệ. Tồng ngồng như trẻ sơ sinh, trên người mặc đúng cái quần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249250
    m_Localized: 'Hunter: Nóa cầm súng bằng hai tay... rồi bẻ gãy làm đôi như bẻ cành cây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249251
    m_Localized: 'Hunter: Giồi nóa cứ đứng đấy, nhìn bác chằm chằm. Như thể chỉ chờ bác chớp mắt một cái... là lao vào bẻ cổ ngay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249252
    m_Localized: 'Hunter: Nhưng không phải. Nó cứ đứng nhìn thôi... như kiểu thi xem ai chớp mắt trước ấy. Ghê bỏa mịe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249253
    m_Localized: 'Hunter: Thế giồi... giời hửng sáng, con sâu bọa đấy cũng mất dạng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249254
    m_Localized: 'Hunter: Bác nghĩ chứ, giờ ở một mình trong rừng mà không cóa súng phòng thân, thì khác quái gì tự sát.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249255
    m_Localized: 'Hunter: Thế là bác lập tức cao chạy xa bay. Trước khi giời sáng hẳn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249256
    m_Localized: 'Hunter: Nên bác mới ra đến tận đây đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249257
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249258
    m_Localized: 'Hunter: Chỉ mong đến lúc ấy mày còn bóp cò được, con ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249259
    m_Localized: 'Hunter: Biết đâu súng đạn lại bắn chết được chúng nóa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249260
    m_Localized: Sao nó không giết bác luôn nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249261
    m_Localized: Bác nghĩ là có cách giết được nó à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249262
    m_Localized: Nó đã quét sạch cả một tiểu đội đấy bác
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249263
    m_Localized: 'Hunter: Hoải bác bác biết hoải ai. Nóa bẻ đôi khẩu súng dễ như ăn kẹo vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249264
    m_Localized: 'Hunter: Nóa thừa sức bẻ gãy người bác luôn... thế mà nóa không làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249265
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249266
    m_Localized: 'Hunter: Hay là nóa thích vờn mình như mèo vờn chuột?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249267
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249268
    m_Localized: 'Hunter: Bác noái cho mày biết, trên đời này bác hiếm khi sợ cái gì. Nhưng riêng thằng cao kều, da tái nhợt ấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249269
    m_Localized: 'Hunter: Nóa làm bác hãi chết khiếp, con giai ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249270
    m_Localized: 'Hunter: Bác muốn tin như vậy lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249271
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249272
    m_Localized: 'Hunter: Mày nghe người ta hay bảo giồi đấy... "Đổ máu được, chứng tỏ giết được".'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249273
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249274
    m_Localized: 'Hunter: Mịa... Cả một tiểu đội còn đéo hạ được nóa... thì mình tuổi gì mà chơi lại thằng này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249275
    m_Localized: 'Hunter: Sức như nóa, chỉ cần chớp mắt là quậy tanh bành cả cái nhà này lên giồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249276
    m_Localized: 'Hunter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249277
    m_Localized: 'Hunter: Bác noái cho mày biết, trên đời này bác hiếm khi sợ cái gì. Nhưng riêng thằng cao kều, da tái nhợt ấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249278
    m_Localized: 'Hunter: Nóa làm bác hãi chết khiếp, con giai ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249279
    m_Localized: 'Hunter: Không bia bọt thì khoải chuyện trò gì hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249280
    m_Localized: 'Hunter: Phải cóa cồn vào mới noái được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249281
    m_Localized: 'Hunter: Mày mà muốn nghe kể nốt... thì mang cho bác lon bia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443522
    m_Localized: 'Cold: Đứng dưới m-mặt trời thì lâu chết lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832067
    m_Localized: 'Greatmother: Con ơi mạ nói con nè... Cẩn thận chớ để người lạ vô nghe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832068
    m_Localized: Sao bọn Thảm Họa lại đuổi bà đi? Chúng nó chẳng chịu nói năng gì hết ư?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832069
    m_Localized: Tôi cần kiểm tra bà
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832070
    m_Localized: 'Greatmother: Tau biết tau chết liền. Có trời mới hay tụi áo vàng nớ đang có âm mưu chi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832071
    m_Localized: 'Greatmother: Lúc mô cũng đi đi lại lại, dọa nạt chỉ tay năm ngón đủ thứ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832072
    m_Localized: 'Greatmother: Mả cha nhà hắn... tưởng mình là ai chớ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832073
    m_Localized: 'Greatmother: Toàn ếch ngồi đáy giếng, thùng rỗng kêu to, chỉ biết đứng hất cằm mà chỉ trỏ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832074
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832075
    m_Localized: 'Greatmother: Ủa mà, tụi nớ cũng có qua nhà mi hè?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832076
    m_Localized: Ừ, có qua rồi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832077
    m_Localized: Có một tên cứ lảng vảng quanh đây suốt
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832078
    m_Localized: 'Greatmother: Cô cha mi lên! Mạ phải lột quách cấy áo vàng chóe của tụi nớ ra, rồi tống cổ vô trại cách ly luôn cho biết mặt!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832079
    m_Localized: 'Greatmother: Để tụi hắn nếm mùi đau khổ, có rứa mới hiểu được cấy cảnh lầm than của bà con mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832080
    m_Localized: 'Greatmother: Chu choa, chừ hắn còn đi quét cả nhà riêng nữa à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832081
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832082
    m_Localized: 'Greatmother: Mẹ cha tụi ni lộng hành dữ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832083
    m_Localized: 'Greatmother: Kiểm tra một lần là đủ rồi. Rứa mà cứ phải hành xác con người ta mãi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832084
    m_Localized: 'Greatmother: Đúng là dai như đỉa đói.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832085
    m_Localized: 'Greatmother: Con ơi mạ nói con nè... Cẩn thận chớ để người lạ vô nghe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832086
    m_Localized: Chúng nó có bắt người thân của bà đi không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832087
    m_Localized: Tôi cần kiểm tra bà
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832088
    m_Localized: 'Greatmother: Ui chao ơi, lâu lắm rồi mới có đứa hỏi thăm con cái nhà tau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832089
    m_Localized: 'Greatmother: Dân tình gọi tau là Gấu Mạ Vĩ Đại, tại tau đẻ ra một bầy đông nghịt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832090
    m_Localized: 'Greatmother: Phước ba đời tụi nhỏ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832091
    m_Localized: 'Greatmother: Bởi rứa cấy nhà tau chật như nêm! Thở không nổi nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832092
    m_Localized: 'Greatmother: Thương tụi nhỏ lắm mi ơi. Phải tự khóa cửa, nhốt mình trong nhà để trốn tụi áo vàng mắc dịch nớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832093
    m_Localized: Bà đang hơi lạc đề ấy. Chưa trả lời câu hỏi của tôi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832094
    m_Localized: Vậy là bọn nó có bắt gia đình bà đi nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832095
    m_Localized: 'Greatmother: Ui chao ơi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832096
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832097
    m_Localized: 'Greatmother: Tau lỡ miệng, nói tràng giang đại hải luôn. Thông cảm nhá con trai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832098
    m_Localized: 'Greatmother: ...Ừa, cấy tụi sâu mọt mặc áo vàng bắt hết con tau đi rồi. Không chừa lại đứa mô luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832099
    m_Localized: 'Greatmother: Tụi vô đạo bất lương nớ có chạy đằng trời. Gấu Mạ nhất quyết không tha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832100
    m_Localized: 'Greatmother: Còn mi thì răng? Có bị hắn bắt bớ người thân đi không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832101
    m_Localized: Tôi chẳng có người thân nào hết
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832102
    m_Localized: Không
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832103
    m_Localized: 'Greatmother: Ui chao ơi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832104
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832105
    m_Localized: 'Greatmother: Tau lỡ miệng, nói tràng giang đại hải luôn. Thông cảm nhá con trai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832106
    m_Localized: 'Greatmother: ...Ừa, cấy tụi sâu mọt mặc áo vàng bắt hết con tau đi rồi. Không chừa lại đứa mô luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832107
    m_Localized: 'Greatmother: Còn mi thì răng? Có bị hắn bắt bớ người thân đi không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832108
    m_Localized: Tôi chẳng có người thân nào hết
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832109
    m_Localized: Không
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832110
    m_Localized: 'Greatmother: Không à? Rứa răng nhà mi rộng thênh thang dễ sợ rứa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832111
    m_Localized: 'Greatmother: Mi sống một mình như ri... Mạ thấy không ổn con ơi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832112
    m_Localized: 'Greatmother: Nhà càng to thì càng đông người mới xôm chớ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832113
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832114
    m_Localized: 'Greatmother: Thôi, tau không tọc mạch chi nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832115
    m_Localized: 'Greatmother: Chừ tau chỉ muốn rước tụi nhỏ ra khỏi khu cách ly, đem về nhà thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832116
    m_Localized: 'Greatmother: Tụi nớ chưa đụng chạm chi tới mi hé?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832117
    m_Localized: 'Greatmother: Rứa người nhà mi ở chỗ mô?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832118
    m_Localized: 'Greatmother: Nhà rộng thênh thang như ri thì phải có đông người ở chớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832119
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832120
    m_Localized: 'Greatmother: Thôi, tau không tọc mạch chi nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832121
    m_Localized: 'Greatmother: Chừ tau chỉ muốn rước tụi nhỏ ra khỏi khu cách ly, đem về nhà thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832122
    m_Localized: 'Greatmother: Con ơi mạ nói con nè... Cẩn thận chớ để người lạ vô nghe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832123
    m_Localized: Bà định giải cứu mấy đứa con kiểu gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832124
    m_Localized: Tôi cần kiểm tra bà
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832125
    m_Localized: 'Greatmother: Cha ơi, chả cần tới tay tau mô! Mấy đứa của Gấu Mạ tự biết cách trốn ra ngoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832126
    m_Localized: Sao cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832127
    m_Localized: Tụi nó tự trốn ra được á?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832128
    m_Localized: 'Greatmother: Thiệt! Tụi hắn đào giỏi lắm, chui từ dưới đất lên cấy một.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832129
    m_Localized: 'Greatmother: Ba cấy hàng rào dây kẽm chỉ là chuyện muỗi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832130
    m_Localized: 'Greatmother: Cầu phước ba đời tụi nhỏ. Mà hắn cũng lanh lẹ nữa, không chui được từ dưới đất lên thì san bằng nguyên khu cách ly luôn. Dễ ẹc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832131
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832132
    m_Localized: 'Greatmother: Gấu Mạ Vĩ Đại biết hết. Tụi nớ gần tới thấu đây rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832133
    m_Localized: Bà lảm nhảm cái đéo gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832134
    m_Localized: Bà bị điên à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832135
    m_Localized: Ý bà là sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832136
    m_Localized: (Giết mụ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832137
    m_Localized: 'Greatmother: Khi thời khắc đã điểm, mấy bức tường quanh mi tự khắc sụp đổ tan tành.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832138
    m_Localized: 'Greatmother: Chi rồi tụi bây cũng chết sạch. Chết không chừa một ai... Rồi HẮN sẽ tới, mang theo bụng đói cồn cào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832139
    m_Localized: 'Greatmother: Tới lúc nớ, tụi áo vàng chả còn để ý chi đám con tau mô. Còn mối họa khác ghê gớm hơn vạn lần...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832140
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832141
    m_Localized: 'Greatmother: Gấu Mạ Vĩ Đại biết hết. Tụi nớ gần tới thấu đây rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832142
    m_Localized: Bà lảm nhảm cái đéo gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832143
    m_Localized: Bà bị điên à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832144
    m_Localized: Ý bà là sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832145
    m_Localized: (Giết mụ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832146
    m_Localized: 'Greatmother: Cứ chờ đó. Bọn tau sẽ đạp đổ thành trì của tụi bây...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832147
    m_Localized: 'Greatmother: Nghiền nát hết mấy bức tường kiên cố nhất... Máu chảy thành sông, nhuộm đỏ phố phường... Thây chất thành núi, bộn bề bốn phương...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832148
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832149
    m_Localized: 'Greatmother: Tau nghe thấy tiếng tụi nhỏ trườn bò. Gần lắm rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832150
    m_Localized: Tức là sao hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832151
    m_Localized: Rốt cuộc bà là ai?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832152
    m_Localized: Bà là Dị Khách à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832153
    m_Localized: (Giết mụ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832154
    m_Localized: 'Greatmother: Thịt cháy lên, mùi thơm phưng phức...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832155
    m_Localized: 'Greatmother: Tụi áo vàng mà đem hầm cũng ngon lành lắm nghe. Hơi giòn hơi dai xíu, nhưng không răng mô.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832156
    m_Localized: 'Greatmother: Nhà mi như cấy bãi tha ma luôn con nạ. Càng nhiều xác, đám con tau ăn càng no nê.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832157
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832158
    m_Localized: 'Greatmother: Tau nghe thấy tiếng tụi nhỏ trườn bò. Gần lắm rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832159
    m_Localized: Tức là sao hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832160
    m_Localized: Rốt cuộc bà là ai?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832161
    m_Localized: Bà là Dị Khách à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832162
    m_Localized: (Giết mụ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832163
    m_Localized: 'Greatmother: Tau là tau chấm chỗ ni mười trên mười.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832164
    m_Localized: 'Greatmother: Vừa rộng rãi, vừa thoáng mát, lại còn vắng hoe. Đủ chỗ chứa hết... mấy con của Gấu Mạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832165
    m_Localized: 'Greatmother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832166
    m_Localized: 'Greatmother: Tau nghe thấy tiếng tụi nhỏ trườn bò. Gần lắm rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832167
    m_Localized: Tức là sao hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832168
    m_Localized: Rốt cuộc bà là ai?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832169
    m_Localized: Bà là Dị Khách à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832170
    m_Localized: (Giết mụ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832171
    m_Localized: 'Greatmother: Cô cha mi lên! Khốn nạn vô hậu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832172
    m_Localized: 'Greatmother: Cứ chờ đó, tụi hắn sẽ nuốt hết lũ tụi bây...!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832173
    m_Localized: 'Greatmother: Mấy cục cưng ơi, Gấu Mạ tìm ra tổ ấm mới cho rồi nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832174
    m_Localized: 'Greatmother: Theo mạ, bò hết vô đây. Từ giờ trở đi hắn chả cần cấy nhà ni nữa mô, mấy đứa nạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832175
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832176
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832177
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832178
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832179
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832180
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832181
    m_Localized: 'Greatmother: Gấu Mạ nhớ con, muốn gặp mấy đứa dễ sợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832182
    m_Localized: 'Greatmother: Qua với mạ đi, nhà ni đảm bảo tụi con sẽ thích.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832183
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832184
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832185
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832186
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832187
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832188
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832189
    m_Localized: 'Greatmother: Mạ ở đây nè! Bò vô đi mấy đứa. Mạ tìm được nhà mới cho tụi con rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832190
    m_Localized: 'Greatmother: Đã rộng rãi, khang trang, lại còn vắng hoe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832191
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832192
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832193
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832194
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832195
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832196
    m_Localized: (GIẾT MỤ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832197
    m_Localized: 'Greatmother: MẢ CHA NHÀ MI! Đưa cấy nhà cho tau! Tụi bây có quý hắn mô mà!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832198
    m_Localized: 'Greatmother: Còn muốn đốt trụi hết thì giữ làm chi nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026368
    m_Localized: 'Greatmother: BÂY ĐƯA LIỀN CHO MẠ MAU!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026369
    m_Localized: 'Greatmother: Mẹ, phước ba đời nhà mi... Chừ tau biết mi muốn chi rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026370
    m_Localized: 'Greatmother: ...Muốn chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026371
    m_Localized: 'Wolfhound: Có công chuyện gì đấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220672
    m_Localized: Sao ông lại xem con người ta là con thú?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220673
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220674
    m_Localized: 'Wolfhound: Để tao hỏi mày thử một câu. Mày biết bản chất con người nà gì không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220675
    m_Localized: 'Wolfhound: Nà giết. Giết xong rồi ăn. Mà chả hề trăn trở, trằn trọc. Nẽ thường đó chú mày ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220676
    m_Localized: 'Wolfhound: Nhưng cái xã hội này á? Nó nại tìm cách gô cổ, xích tròng mày. May phước nàm sao, nó chả còn xích ai được nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220677
    m_Localized: Ông nói thế là ý gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220678
    m_Localized: Ông thấy chuyện đó vui lắm sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220679
    m_Localized: 'Wolfhound: Dễ hiểu mà cu. Một hệ thống phi ný nay đã nhường chỗ cho quy nuật thuần túy. Thế giới trở về nguyên trạng vốn có.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220680
    m_Localized: 'Wolfhound: Người người tụ tập thành bầy, có con đầu đàn thống nĩnh. Mày nhờn với bầy thì mày chết. Tao nà tao thích chơi nuật rừng thế đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220681
    m_Localized: 'Wolfhound: Mà cái noại khốn nạn nhất trong tất cả, chính nà cừu non đội nốt sói già.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220682
    m_Localized: Ông cho rằng sống bầy đàn thì tốt hơn xã hội ư?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220683
    m_Localized: Ông nói nhầm à? Sói già đội lốt cừu non chứ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220684
    m_Localized: 'Wolfhound: Vui gì nổi chú mày ơi. Ờ thì tao cũng mừng vì người ta sống thật với bản chất, không còn giả nhân giả nghĩa nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220685
    m_Localized: 'Wolfhound: Nhưng mà tổ sư nó bọn cừu. Chúng nó phá tan hoang cả mày ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220686
    m_Localized: 'Wolfhound: Nó khoác nên mình bộ da sói rồi giả nàm sói thật. Bày đặt ra vẻ con người tử tế.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220687
    m_Localized: 'Wolfhound: Bố tổ nó cứ rình mò dưới đất. Suốt ngày chơi trò mèo vờn chuột. Mày ngon mày nộ mặt ra đây mà đánh tay đôi với bố!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220688
    m_Localized: 'Wolfhound: Nhưng tao chỉ mánh cho, mày quây được cái bầy hẳn hoi đi. Niếc mắt thôi nà biết con nào nạc noài ngay ấy mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220689
    m_Localized: Ông cho rằng sống bầy đàn thì tốt hơn xã hội ư?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220690
    m_Localized: Ông nói nhầm à? Sói già đội lốt cừu non chứ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220691
    m_Localized: 'Wolfhound: Chứ mày không công nhận à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220692
    m_Localized: 'Wolfhound: Xã hội mà "bình thường" á, còn khướt mày mới soi ra được bọn cừu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220693
    m_Localized: 'Wolfhound: Suốt ngày buôn dưa nê bán dưa chuột, vẽ hết nuật này tới nuật khác. Chúng nó chỉ giỏi bàn ra bàn nùi, chứ có nàm nên trò trống gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220694
    m_Localized: 'Wolfhound: Bởi thế tao mới bẩu, có con đầu đàn nà có trật tự. Hỏi đáp trưng cầu quái gì cho mất thì giờ. Hắn bẩu sao thì cứ y vậy mà triển.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220695
    m_Localized: 'Wolfhound: Đã nà đầu đàn thì cấm được yếu hèn. Khi đấy cả bầy mới sống nâu được. Đơn giản thế còn giề.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220696
    m_Localized: 'Wolfhound: Không Diễm ơi, tao đang bẩu cái bọn hèn hạ mà chúng mày quen gọi nà Dị Khách đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220697
    m_Localized: 'Wolfhound: Nũ cô hồn này sống chui rút như chuột nhắt dưới nòng đất, chỉ chờ cho ta nơ nà chủ quan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220698
    m_Localized: 'Wolfhound: Rồi chúng nó trồi nên, đánh vào cái nòng người của ta. Để ta phải thương, phải xót, không còn dám giết bỏ nó nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220699
    m_Localized: 'Wolfhound: Bởi thế chúng ta phải nhe nanh khè nại nó. Nhắc cho nó nhớ ai mới nà vua đất này, không nó nại hất cẳng như chơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220700
    m_Localized: 'Wolfhound: Có công chuyện gì đấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220701
    m_Localized: Sao ông nhìn chằm chằm khẩu súng của tôi vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220702
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220703
    m_Localized: 'Wolfhound: Tao thấy tướng tá mày được, có căn có cơ đấy. Ra dáng đầu đàn thực thụ, đe cả đám sợ một phép. Mày giữ được thế nà giỏi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220704
    m_Localized: 'Wolfhound: Mày có cái hang ổ ngon nành nhể. Rộng rãi, thoáng mát. Người ra kẻ vào niên tục. Mỗi tội mấy phần tử mày cho vào, nó...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220705
    m_Localized: Họ thì làm sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220706
    m_Localized: Ông nghĩ có Dị Khách trà trộn vào à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220707
    m_Localized: 'Wolfhound: Trông nó tong teo, èo uột quá mày ạ. Rặt một nũ trói gà không chặt, ra gió tí nà nằm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220708
    m_Localized: 'Wolfhound: Giờ nhá, mày bẩu xem: thời buổi này thì cần quái gì người già, trẻ ranh, hay kẻ ốm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220709
    m_Localized: 'Wolfhound: Muốn thành bầy thì cả đàn phải khỏe, giống phải tốt. Thế mới sinh tồn được chứ nị.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220710
    m_Localized: Thế giờ ông muốn tôi làm gì đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220711
    m_Localized: Vậy là tôi phải tống cổ họ đi sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220712
    m_Localized: 'Wolfhound: Cái tao no ở đây chả phải nũ cừu đội nốt sói đâu, anh chủ à. Mà tao gai nhất bọn sói thật yếu bỏ mịa cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220713
    m_Localized: 'Wolfhound: Bầy của mày nhát cáy, chả nàm ăn được giề. Chúng nó muốn đi nà đi muốn ở nà ở, ra vào quá tùy tiện.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220714
    m_Localized: 'Wolfhound: Chọn ra vài con mạnh nhất rồi giữ cho kỹ, nũ còn nại thì vứt quách đi cho đỡ tạ. Chuyện chỉ có thế.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220715
    m_Localized: Thế giờ ông muốn tôi làm gì đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220716
    m_Localized: Vậy là tôi phải tống cổ họ đi sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220717
    m_Localized: 'Wolfhound: Con nào yếu thì thẳng tay khai trừ, không cần nòng vòng Diễm ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220718
    m_Localized: 'Wolfhound: Mày cứ giết nó. Công khai nuôn. Xử mạnh để còn nàm gương.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220719
    m_Localized: 'Wolfhound: Mày đã cầm cương thì phải siết cho chặt. Cho nó biết ai nà thủ nĩnh, nắm quyền sinh sát trong tay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220720
    m_Localized: 'Wolfhound: Con nào mà bình thản khi con yếu ngã xuống... Đấy mới đích thị nà con sói đáng giữ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220721
    m_Localized: 'Wolfhound: Nó thì ở nại được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220722
    m_Localized: Tôi không phải hạng sát nhân
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220723
    m_Localized: Tôi chỉ giết Dị Khách thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220724
    m_Localized: 'Wolfhound: Mày cứ để nó được nước nàm càng thì mất hết cái uy. Nó bẩu mày như hổ hóa mèo con, anh chủ ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220725
    m_Localized: 'Wolfhound: Nhân từ độ nượng chỉ nà cái mã che đậy sự yếu mềm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220726
    m_Localized: 'Wolfhound: Mày phải tàn bạo dứt khoát cho tao. Dị Khách? Bằng. Yếu nhớt? Bằng. Già khú? Bằng mẹ nó nuôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220727
    m_Localized: 'Wolfhound: Có vậy nó mới biết sợ. Thế mới nà phong thái của kẻ đầu đàn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220728
    m_Localized: Tôi không phải hạng sát nhân
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220729
    m_Localized: Tôi chỉ giết Dị Khách thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220730
    m_Localized: 'Wolfhound: Ôi dào, mày định nừa ai hả Diễm ơi? Không qua mắt được tao đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220731
    m_Localized: 'Wolfhound: Mày cũng giết người thôi cu. Đã thế còn máu nạnh. Đừng nàm bộ nàm tịch như thể tay mày chưa từng nhúng chàm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220732
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220733
    m_Localized: 'Wolfhound: Mày biết không, một thời tao cai quản cả xóm này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220734
    m_Localized: 'Wolfhound: Ai ai cũng khiếp sợ tao. Kính nể tao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220735
    m_Localized: 'Wolfhound: Có bao giờ mày thắc mắc ninh hồn con người mất bao nâu để mục nát không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220736
    m_Localized: 'Wolfhound: Riêng tao thì mục suốt bấy nâu rồi, còn mưng mủ nữa nà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220737
    m_Localized: 'Wolfhound: Hồi trước, có thằng tài xế taxi nó chê tao, không chịu chở tao đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220738
    m_Localized: 'Wolfhound: Tao mà nhắm mắt cho qua thì còn mặt mũi gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220739
    m_Localized: 'Wolfhound: Thế nà tao bẻ từng khúc xương trong người nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220740
    m_Localized: 'Wolfhound: Từ đó con của nó cũng được bài học nhớ đời. Và người người vẫn nể mặt tao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220741
    m_Localized: 'Wolfhound: Để tao bẩu mày nhá. Mày bỏ cái thói chăm bẵm bọn èo ọt yếu ớt đi. Đảm bẩu khá nên ngay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220742
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220743
    m_Localized: 'Wolfhound: Mày biết không, một thời tao cai quản cả xóm này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220744
    m_Localized: 'Wolfhound: Ai ai cũng khiếp sợ tao. Kính nể tao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220745
    m_Localized: 'Wolfhound: Có bao giờ mày thắc mắc ninh hồn con người mất bao nâu để mục nát không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220746
    m_Localized: 'Wolfhound: Riêng tao thì mục suốt bấy nâu rồi, còn mưng mủ nữa nà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220747
    m_Localized: 'Wolfhound: Hồi trước, có thằng tài xế taxi nó chê tao, không chịu chở tao đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220748
    m_Localized: 'Wolfhound: Tao mà nhắm mắt cho qua thì còn mặt mũi gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220749
    m_Localized: 'Wolfhound: Thế nà tao bẻ từng khúc xương trong người nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220750
    m_Localized: 'Wolfhound: Từ đó con của nó cũng được bài học nhớ đời. Và người người vẫn nể mặt tao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220751
    m_Localized: 'Wolfhound: Có công chuyện gì đấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220752
    m_Localized: Ông cứ nói chuyện bầy đàn mãi. Thế bầy của ông đâu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220753
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220754
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220755
    m_Localized: 'Wolfhound: Còn mày sao nại có bầy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220756
    m_Localized: Để thằng Dị Khách cao lêu nghêu, da tái nhợt kia không giết tôi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220757
    m_Localized: Vì tôi muốn giúp đỡ người khác
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220758
    m_Localized: Tôi thích sống có người xung quanh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220759
    m_Localized: Vì họ cần có một người lãnh đạo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220760
    m_Localized: Tôi hỏi ông trước mà
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220761
    m_Localized: 'Wolfhound: Ôi dào tưởng sao. Hóa ra mày tụ tập cả bọn chỉ để cứu cái thân mình à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220762
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220763
    m_Localized: 'Wolfhound: Mày chả ra dáng con đầu đàn gì sất. Cứ như đứa tong teo, còi cọc nhất đàn thì đúng hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220764
    m_Localized: 'Wolfhound: Bầy này của mày cần một con mạnh mẽ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220765
    m_Localized: 'Wolfhound: Xem ra tao phải soán ngôi mày rồi. Hèn như mày thì dẫn dắt được ai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220766
    m_Localized: 'Wolfhound: Nghe cao thượng đấy. Có điều hơi đần thối.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220767
    m_Localized: 'Wolfhound: Mày đâu thể nào cưu mang tất cả. Rồi cũng tới núc phải từ chối người ta thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220768
    m_Localized: 'Wolfhound: Nhưng tao công nhận mày được. Có chất đầu đàn hẳn hoi, rất men nì. Nên tao cũng chả thách thức nàm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220769
    m_Localized: 'Wolfhound: Giề, có vậy thôi hả? Mày nhát cáy đến độ không dám ở một mình?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220770
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220771
    m_Localized: 'Wolfhound: Chả có dáng dấp con đầu đàn gì sất. Mày cũng chỉ nà một con cừu quèn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220772
    m_Localized: 'Wolfhound: Chuẩn, hay. Phải men nì nắm mới phát biểu được câu này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220773
    m_Localized: 'Wolfhound: Tao chả dại gì mà nghi ngờ mày nữa, anh chủ nhể.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220774
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220775
    m_Localized: 'Wolfhound: Tao miễn bình nuận. Mày biết càng ít càng hay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220776
    m_Localized: 'Wolfhound: Tao nói nhiêu đó nà quá nhiều rồi. Giờ đến nượt mày trả nời tao.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220777
    m_Localized: 'Wolfhound: Mày không dẫn dắt được bầy, thì xê ra để thằng bố mày.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220778
    m_Localized: Địt mẹ ông!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220779
    m_Localized: Ông tưởng ông hơn ai hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220780
    m_Localized: (Rút súng ra)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220781
    m_Localized: Cút ngay trước khi tôi bắn lủng đầu ông
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220782
    m_Localized: 'Wolfhound: NGẬM MÕM NẠI, CÚN CON. Mày chết với tao rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220783
    m_Localized: 'Wolfhound: Đã đéo biết dẫn đầu thì còn nhận trọng trách nàm gì, hả Diễm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220784
    m_Localized: 'Wolfhound: Khôn hồn thì bước ra ngoài, không tao cho mày vào quán cầy tơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220785
    m_Localized: 'Wolfhound: Tao biết bầy đàn nà như thế nào. Quy tắc sống của tao đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220786
    m_Localized: 'Wolfhound: Yếu mềm như mày thì thống nĩnh đéo gì nổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220787
    m_Localized: 'Wolfhound: Khôn hồn thì bước ra ngoài, không tao cho mày vào quán cầy tơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220788
    m_Localized: 'Wolfhound: Mày thích chơi nuôn chứ giề?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220789
    m_Localized: 'Wolfhound: Tưởng tao không có hàng nóng hả? Ngu như bò.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220790
    m_Localized: 'Wolfhound: Mày khôn thì mày bỏ con hàng xuống. Thế nà mọi chuyện êm xuôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220791
    m_Localized: (Bóp cò)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220792
    m_Localized: (Bỏ súng xuống)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220793
    m_Localized: 'Wolfhound: Mịa mày, chết đi con–'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220794
    m_Localized: 'Wolfhound: Giỏi nắm cún con ạ... Mày dám nã tao thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220795
    m_Localized: 'Wolfhound: ...Ngoan nắm cún con.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220796
    m_Localized: 'Wolfhound: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220797
    m_Localized: 'Wolfhound: Nhưng mày cụp đuôi nà mày nhầm to rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220798
    m_Localized: 'Wolfhound: (Gã ta thừa cơ rút súng)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220799
    m_Localized: 'Wolfhound: (Gã nhắm thẳng vào bạn)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220800
    m_Localized: 'Wolfhound: (May sao, bạn vớ được khẩu súng trước và bóp cò)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220810
    m_Localized: Vậy là bọn áo vàng đấy cho bác nghỉ hưu sớm luôn à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220811
    m_Localized: Mấy ông cán bộ Phòng Chống làm vậy cũng đúng thôi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220813
    m_Localized: 'Doctor: Thật ra thì... sau khi bệnh viện đóng cửa, bác đã lẻn tới khu cách ly để tiến hành phân loại cấp cứu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220824
    m_Localized: 'Doctor: Bác... Bác chỉ muốn giúp người tiếp thôi cháu à. Đó là sứ mệnh của người thầy thuốc mà. Sao bác nỡ bỏ mặc họ được chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220826
    m_Localized: 'Doctor: Hay là... mà thôi. Cháu thông cảm nhé. Giờ bác chưa chuẩn bị tâm lý để chia sẻ chuyện đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220827
    m_Localized: 'Doctor: Cháu nói vậy làm bác tổn thương đấy. Còn chưa rõ đầu đuôi câu chuyện ra sao mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220829
    m_Localized: 'Doctor: Hay là... mà thôi. Cháu thông cảm nhé. Giờ bác chưa chuẩn bị tâm lý để chia sẻ chuyện đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220831
    m_Localized: Thế câu chuyện bác muốn kể là gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220834
    m_Localized: Tôi thấy họ cũng đang làm tròn trách nhiệm
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220837
    m_Localized: 'Doctor: Thế à? Tiếc nhỉ. Bác thì chẳng thấy vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220838
    m_Localized: 'Doctor: Bác từng làm việc với đám đó một thời gian, nhưng vẫn không sao tin tưởng được bọn nó. Nhất là sau những gì bác đã mắt thấy tai nghe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220840
    m_Localized: 'Doctor: Suốt quá trình làm, bác chỉ thấy cánh bác sĩ ở đó cũng mù tịt tin tức, chẳng rõ mình đang làm gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220841
    m_Localized: 'Doctor: Bọn cán bộ Thảm Họa còn chẳng giải thích được mấy dấu hiệu kia là từ đâu ra. Tổ chức gì mà khả nghi chưa từng thấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220842
    m_Localized: 'Doctor: Đã ngần ấy chuyện xảy ra rồi... thì làm sao cháu vẫn tin tưởng đám áo vàng đó cho được?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220844
    m_Localized: 'Doctor: Thế mà bác cứ tưởng cháu sáng suốt hơn cơ. Thôi, coi như bác nhìn nhầm người.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220845
    m_Localized: 'Doctor: Ừ, bác cũng y như cháu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220846
    m_Localized: 'Doctor: Nói thật chứ, dù đã làm việc với đám đó được một thời gian rồi, bác vẫn không rõ động cơ của bọn nó là gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220847
    m_Localized: 'Doctor: Nhưng bất luận chuyện gì đi nữa, bác vẫn chọn giúp người theo cách riêng của mình, dù có phải làm trái lệnh họ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220848
    m_Localized: 'Doctor: Vấn đề là sự thiếu minh bạch. Bọn đó làm việc mờ mờ ám ám lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220849
    m_Localized: 'Doctor: Chúng nó chẳng hề giải thích cho mấy bác cái mớ "dấu hiệu" ấy từ đâu ra, cụ thể nghĩa là gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220850
    m_Localized: 'Doctor: Nó chỉ ném cho bác một xấp quy tắc hướng dẫn. Rồi bảo phân loại ra ai là Dị Khách, ai là người.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220851
    m_Localized: 'Doctor: Từ đó trở đi, bác thấy mình chẳng còn là bác sĩ nữa. Mà giống nhân viên hải quan chuyên đóng dấu giấy tờ hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220852
    m_Localized: 'Doctor: Thế là bác bắt đầu giúp người ta trốn đi. Bằng cách làm giả báo cáo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220854
    m_Localized: 'Doctor: Bác biết cháu còn nhiều thắc mắc lắm. Nhưng để sáng mai hẵng nói tiếp nhé, phiền cháu thông cảm.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713912
    m_Localized: 'Doctor: Xin lỗi cháu, hôm nay bác không còn tâm trạng để nói thêm gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713913
    m_Localized: 'Doctor: Vậy nên bác quyết định rời bỏ tổ chức.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220856
    m_Localized: Vậy sao bác lại rời khỏi khu cách ly?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220858
    m_Localized: 'Doctor: Có một... sự tình này...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220859
    m_Localized: 'Doctor: Hôm đó, vào lúc sáng sớm, bác đang chuẩn bị về nhà thì bị một sĩ quan bên Thảm Họa gọi lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220860
    m_Localized: 'Doctor: Lúc ấy tim bác đập loạn xạ lên, hai đầu gối run run như sắp ngã quỵ tới nơi rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220861
    m_Localized: 'Doctor: Hắn quát bác quay người lại. ...Khoảnh khắc đó bác cầu nguyện xong xuôi, sẵn sàng chầu trời luôn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220862
    m_Localized: 'Doctor: Hắn chĩa súng vào chân bác và ra hiệu đứng yên. Hắn cứ quan sát một lúc, rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220863
    m_Localized: 'Doctor: ...lệnh cho bác thè lưỡi ra, để kiểm tra xem có phải Dị Khách không. Bác cứ run rẩy làm theo, không thôi hắn bắn bác mất.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220864
    m_Localized: 'Doctor: Rồi... hắn cười vào mặt bác. Bảo bác là bác sĩ mà dốt đặc, vì lưỡi đâu phải dấu hiệu cần kiểm tra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220865
    m_Localized: 'Doctor: ...Cả đời bác chưa từng được một phen kinh hồn bạt vía đến vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220866
    m_Localized: 'Doctor: Lúc đó bác chẳng thiết nghĩ đến việc cứu ai, cứu cái gì nữa hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220867
    m_Localized: 'Doctor: Bác quay đầu bỏ chạy như một thằng hèn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220868
    m_Localized: 'Doctor: Cảm giác nhục nhã đó đeo bám bác mãi. Khi nhớ lại mình đã bỏ mặc bao nhiêu sinh mạng đáng thương... bác chẳng dám soi mình trong gương nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220869
    m_Localized: Tôi không trách gì bác đâu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220870
    m_Localized: Nhưng bác vẫn có thể giúp người mà
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220871
    m_Localized: Chả được cái thá gì. Thôi bác cút luôn đi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220872
    m_Localized: 'Doctor: Cảm ơn cháu đã hiểu cho bác. Bác thấy... nhẹ nhõm hơn phần nào rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220873
    m_Localized: 'Doctor: Bác cứ day dứt giày vò chuyện đó mãi. Giá như bác kiên trì đến phút cuối, có khi đã cứu được biết bao nhiêu mạng người rồi cũng nên...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220874
    m_Localized: 'Doctor: Cũng muốn lắm chứ, nhưng không có cách nào...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220875
    m_Localized: 'Doctor: Bác lỡ để hết dụng cụ ở khu cách ly mất rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220876
    m_Localized: 'Doctor: ...Nên là bác đành lực bất tòng tâm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220877
    m_Localized: 'Doctor: Bác biết là cháu đang mong chờ bác chữa khỏi căn bệnh này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220878
    m_Localized: 'Doctor: Nhưng một lão già tay không dao kéo như bác thì làm được gì đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220879
    m_Localized: 'Doctor: Xin lỗi vì đã phụ lòng cháu. Bác cũng đành bất lực bó tay trước thảm họa Dị Khách mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220880
    m_Localized: Không sao đâu, bác cứ ở lại đây đi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220881
    m_Localized: Cửa không khóa. Không tiễn
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220882
    m_Localized: 'Doctor: Bác... Ừ thôi, cháu nói đúng. Bác nên đi thì hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220884
    m_Localized: 'Doctor: Tạm biệt cháu nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220885
    m_Localized: 'Doctor: Cảm ơn cháu đã hiểu cho bác. Bác thấy... nhẹ nhõm hơn phần nào rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220886
    m_Localized: 'Doctor: Dù bác có ở lại đó thì sớm muộn gì, bọn Thảm Họa cũng phát hiện ra chuyện bác báo cáo sai lệch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220887
    m_Localized: 'Doctor: Biết là thế, nhưng tâm can bác cứ day dứt mãi... Giá mà bác can đảm hơn thì đã cứu thêm được biết bao nhiêu người rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220889
    m_Localized: 'Doctor: Có lẽ gánh nặng tội lỗi này sẽ đeo bám mãi cho đến khi bác nhắm mắt xuôi tay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220891
    m_Localized: 'Doctor: Ừ, cháu nói phải. Làm gì có chỗ nào chứa chấp lão già đốn mạt này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220892
    m_Localized: 'Doctor: Tạm biệt cháu nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713914
    m_Localized: 'Doctor: Cháu hỏi làm gì thế? Muốn biết lý do bác không tin tưởng bên Phòng Chống Thảm Họa à?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713915
    m_Localized: 'Doctor: Bây giờ cứ giả sử nhé...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713916
    m_Localized: 'Doctor: Cháu có tin Dị Khách là một chủng virus không?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713917
    m_Localized: Tôi nghĩ bọn nó chả có thật đâu
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713918
    m_Localized: Không. Nhưng chúng nó là gì thì tôi cũng không rõ
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713919
    m_Localized: Có, tôi thấy hợp lý
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713920
    m_Localized: 'Doctor: Cháu đã nghĩ vậy rồi thì sao còn phải cất công kiểm tra làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713921
    m_Localized: 'Doctor: Đừng giấu nữa, nói thật cho bác biết đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713922
    m_Localized: 'Doctor: Nào...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713923
    m_Localized: 'Doctor: Ừ, bác hiểu mà. Bản thân bác cũng không biết được bản chất của Dị Khách là gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713924
    m_Localized: 'Doctor: Nhưng bác dám chắc một điều, chúng không phải là virus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713925
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713926
    m_Localized: 'Doctor: Chà, rất tiếc phải nói cho cháu biết. Chín mươi chín phần trăm là không phải đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713927
    m_Localized: 'Doctor: Cháu đã bao giờ tận mắt chứng kiến người đang khỏe mạnh bình thường, trong chốc lát lại bỗng dưng biến thành Dị Khách chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713928
    m_Localized: 'Doctor: Đúng rồi đấy. Từ trước đến nay chưa từng ghi nhận trường hợp nào như vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713929
    m_Localized: 'Doctor: Thực sự thì bên Thảm Họa cũng chẳng biết phải làm gì đâu cháu. Họ chỉ ra vẻ như vẫn kiểm soát được tình hình thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713930
    m_Localized: 'Doctor: Bọn nó đóng cửa bệnh viện, dồn hết mọi người vào khu cách ly... Để làm cái gì cơ chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713931
    m_Localized: 'Doctor: Có thật là đang giúp người không? Đã có ai được chữa khỏi chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713932
    m_Localized: 'Doctor: Cái bọn ấy chỉ biết lùa người như lùa gia súc, nhốt hết vào một góc. Thế là xong, coi như rảnh nợ, giờ chúng nó thích làm cái gì thì làm.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713933
    m_Localized: Biết vậy sao bác còn làm cho bên đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713934
    m_Localized: Xàm thế đủ rồi. Cút ngay
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713936
    m_Localized: 'Doctor: Bác đâu thể chỉ trơ mắt đứng nhìn người ta bị hại chết được.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713937
    m_Localized: 'Doctor: Cho nên bác mới bắt tay với chúng nó, để tìm cách giúp người bị đưa vào khu cách ly trốn ra ngoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713938
    m_Localized: 'Doctor: Bác tận tay khám cho họ, đưa ra chẩn đoán. Sau đó làm giả báo cáo để họ được trả tự do.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713939
    m_Localized: Hay nhỉ, rồi lỡ có Dị Khách lọt ra ngoài luôn thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713940
    m_Localized: Đã có chuyện gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713941
    m_Localized: Cái nhà này cũng không chứa được bác đâu
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713942
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713943
    m_Localized: 'Doctor: Cháu chẳng buồn nghe chuyện từ phía bác à... Thôi thì đành vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713944
    m_Localized: 'Doctor: Bác cũng không làm phiền cháu nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713945
    m_Localized: 'Doctor: Tạm biệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713946
    m_Localized: 'Doctor: Chứ mày muốn bác phải làm sao đây? Cứ để họ ở lại đó sống chết mặc bay à?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713947
    m_Localized: 'Doctor: Bác đã gối đầu lòng những điều y đức của thầy thuốc rồi. Thì phải dốc hết tâm huyết, khả năng mà cứu chữa người ta chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713948
    m_Localized: 'Doctor: Ấy vậy mà... Bác lại một mình bỏ trốn khỏi khu cách ly. Hỡi ôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713949
    m_Localized: 'Doctor: Trong khu vực bác phụ trách đã xảy ra sự cố.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713950
    m_Localized: 'Doctor: Cái gì cơ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713951
    m_Localized: 'Doctor: Mày nghĩ bác giúp người là sai ấy hả? Nên giờ mày đòi đuổi bác đi chứ gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713952
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713953
    m_Localized: 'Doctor: Không tin được lại có ngày bác gặp phải quân khốn nạn hơn lũ Thảm Hại kia nữa. Ít ra chúng nó còn giả bộ giúp người. Còn mày thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713954
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713955
    m_Localized: 'Doctor: Thôi, bác có ở đây cũng chẳng để làm gì nữa. Chỉ tội những người phải chung sống với mày. Ai biết được mày sẽ đối xử với họ thế nào chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713956
    m_Localized: 'Doctor: Vĩnh biệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220894
    m_Localized: Ồ, anh cắt được chỉ khâu trên miệng rồi à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220895
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220898
    m_Localized: Tôi chả hiểu anh đang nói gì cả
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220899
    m_Localized: Tôi nói gì anh có nghe ra được không ấy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220900
    m_Localized: 'Foreigner: Glr xszmt srvf zms mlr tr svg. Trl nrms kszr ozn hzl wzb?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220901
    m_Localized: 'Foreigner: Gf gzl iz nlg mtlm mtf xsfmt z?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220903
    m_Localized: Thế giờ hai bên giao tiếp kiểu gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220904
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220905
    m_Localized: 'Foreigner: Szb oz glr gsf ozk ozr olr zms mlr, ilr zms wzk giz msv.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220906
    m_Localized: 'Foreigner: Rg iz msf ezb glr xlm srvf nrms wzmt mlr tr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220908
    m_Localized: Sao trăng cái gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220909
    m_Localized: Anh đang muốn hỏi tôi gì hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220910
    m_Localized: 'Foreigner: Xsrf, ezm xsfz srvf wflx. Msfmt srms msf zms nlr slr glr tr wl msr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220911
    m_Localized: 'Foreigner: Xszx ezb, mtsv trlmt xzf slr nz...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220912
    m_Localized: 'Foreigner: Xsrf, ezm xsfz srvf wflx. Msfmt srms msf zms nlr slr glr tr wl msr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220913
    m_Localized: 'Foreigner: Xszx ezb, mtsv trlmt xzf slr nz...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220914
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220915
    m_Localized: Sao rồi, anh thấy đỡ hơn chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220916
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414976
    m_Localized: 'Foreigner: (Bạn vỗ vai anh ta rồi chỉ vào vết thương quanh miệng)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414977
    m_Localized: Ổn không đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414978
    m_Localized: Có đau lắm không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414979
    m_Localized: 'Foreigner: Zms mlr ozr xzf wl wflx pslmt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414980
    m_Localized: 'Foreigner: Ồồồ...ổn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414981
    m_Localized: 'Foreigner: Ồồồổ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414982
    m_Localized: 'Foreigner: Ồồổn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414983
    m_Localized: 'Foreigner: Nrvmt glr z? F gsr... xszx xfmt wl wl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414984
    m_Localized: 'Foreigner: Pslmt yrvg l mflx glr xl yr ef mzb pslmt mfz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414985
    m_Localized: 'Foreigner: Wfmt oz zn zms gszg hf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414986
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414987
    m_Localized: Thế anh định về nhà bằng cách nào?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414988
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414989
    m_Localized: 'Foreigner: (Bạn chắp hai bàn tay lại với nhau rồi giơ lên đầu, tạo thành hình mái nhà)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414990
    m_Localized: 'Foreigner: Msz sl? Zms wzmt slr ev jfv msz glr wfmt pslmt?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414991
    m_Localized: 'Foreigner: Glr glr wzb wv gszn yzm gslr, gsv nz ozr wfmt xsfbvm msf mzb.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414992
    m_Localized: 'Foreigner: Xszmt yrvg wrvm gz ozn hzl mtlzr xzf: glzmt ezr olm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414993
    m_Localized: Giờ tôi tiễn anh về thế nào đây? Hay ra sân bay nhé?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414994
    m_Localized: Anh có xem thử giá vé tàu thuyền chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414995
    m_Localized: 'Foreigner: (Bạn dang rộng hai cánh tay, làm cử chỉ như đập cánh)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414996
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414997
    m_Localized: 'Foreigner: Nzb yzb sz? Yzb trl szmt szmt pslmt xl xlm slzg wlmt pslmt wz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414998
    m_Localized: 'Foreigner: Xszx kszr wr wl slr nlr wflx.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414999
    m_Localized: 'Foreigner: Yrvg wzf glr ezm xlm xzxs wv ev mflx.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415000
    m_Localized: 'Foreigner: (Bạn nhấp nhô bàn tay tựa như con thuyền đang lướt trên mặt sóng)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415001
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415002
    m_Localized: 'Foreigner: Z prvf... wlmt yfln iz pslr zb sz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415003
    m_Localized: 'Foreigner: Trl nz gzf gsfbvm ezm xlm xszb z? Kszr mtsrvm xff nlr wflx, xzn lm msz!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415004
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415005
    m_Localized: Sao nhìn mặt anh hớn hở thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415006
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415007
    m_Localized: 'Foreigner: (Bạn nhoẻn miệng cười, lấy tay chỉ vào nụ cười đó, rồi chỉ về phía anh ta)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415008
    m_Localized: 'Foreigner: Z, zms nflm yrvg hzl glr efr ezb z?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415009
    m_Localized: 'Foreigner: Mtflr gz nlr tlr mlr elr glr oz gzf slz xlm xszb wl! Grm mlr pslmt gilr?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415010
    m_Localized: 'Foreigner: (Anh ta di chuyển một tay song song với tay kia)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415011
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415012
    m_Localized: Có ai chở anh về nhà không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415013
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415014
    m_Localized: 'Foreigner: Glr ezm pslmt srvf b zms, yzm glr z.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415015
    m_Localized: 'Foreigner: Mtzb nzr glr hv ovm wflmt ev jfv sflmt! Slzx rg iz oz glr gizn gzf slz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415016
    m_Localized: 'Foreigner: Glr mzb glr wr ilr. Gzn yrvg msz!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415017
    m_Localized: 'Foreigner: Bébai!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415018
    m_Localized: Ý anh là đi bằng tàu hỏa sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415019
    m_Localized: Anh sắp đi đâu à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415020
    m_Localized: 'Foreigner: Crm olr, glr pslmt srvf zms mlr tr xz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415021
    m_Localized: 'Foreigner: Msfmt mtzb nzr glr hv wrxs gszm glr tz gzf cvn gsf!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415022
    m_Localized: 'Foreigner: Nlmt hzl xflr xfmt xfmt wflx ev ozr nzr msz gszm gsflmt...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415023
    m_Localized: 'Foreigner: TRÚTMAIMÁNN!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415024
    m_Localized: 'Edgar: Một áng thơ tình thinh lặng...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415025
    m_Localized: Tay cậu sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415026
    m_Localized: Tôi cần kiểm tra cậu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415027
    m_Localized: 'Edgar: Mạch vẫn còn, nhưng trơ lì mọi cảm giác. Chẳng một hơi ấm, chỉ còn sót lại cơn đau dai dẳng và nỗi buốt lạnh thấu xương.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415028
    m_Localized: 'Edgar: Nhưng chẳng hề gì – âu chỉ là lẽ tự nhiên mà thôi. Bởi mình vẫn mong ước trì hoãn khoảnh khắc mĩ lệ nhất trần đời.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415029
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415030
    m_Localized: 'Edgar: Mình từng mến thương một cô gái.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415031
    m_Localized: 'Edgar: Mình trân quý những tháng ngày bên nhau. Chỉ ngồi lặng im, nhưng mình vẫn hiểu thấu trái tim nàng. Thế rồi mình đột ngột bừng tỉnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415032
    m_Localized: 'Edgar: Chẳng qua do mình tự huyễn hoặc thôi. Mình chẳng biết gì về nàng ấy. Có lẽ mình chỉ hy vọng hão huyền rằng mình hiểu nàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415033
    m_Localized: 'Edgar: Nhưng mình vẫn mơ về một ngày, khi nàng và mình yêu nhau tha thiết: bằng một tình yêu vượt xa hơn cả chữ tình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415034
    m_Localized: 'Edgar: Một áng thơ tình thinh lặng...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415035
    m_Localized: Kể cho tôi nghe về "nàng ấy" xem nào
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415036
    m_Localized: Tôi cần kiểm tra cậu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415037
    m_Localized: 'Edgar: Đôi mắt nàng luôn tỏa bừng ánh trăng nhàn nhạt, lạnh giá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415038
    m_Localized: 'Edgar: Nàng là phản đề của Tấn Thảm Kịch quanh ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415039
    m_Localized: 'Edgar: Cậu biết không, vẻ đẹp càng trác tuyệt thì càng đậm chất dị thường.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415040
    m_Localized: 'Edgar: Và mình hằng khao khát được vén mở bí mật của nàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415041
    m_Localized: 'Edgar: Giờ đây, nàng là bức tượng đài mình thờ phụng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415042
    m_Localized: 'Edgar: Là ánh đèn chỉ lối khi mình về chốn thiên thai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415043
    m_Localized: 'Edgar: Một áng thơ tình thinh lặng...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415044
    m_Localized: Hai người gặp nhau thế nào vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415045
    m_Localized: Tôi cần kiểm tra cậu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415046
    m_Localized: 'Edgar: Điều mình chờ đợi bấy lâu đã đến: cơn nhiễm trùng huyết lạnh lẽo vô tình sắp xâm chiếm lấy thân thể.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415047
    m_Localized: 'Edgar: Một nỗi sợ tựa băng giá dâng trào – không phải vài mươi năm, mà mình sẽ tan biến chỉ trong mấy đêm rằm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415048
    m_Localized: 'Edgar: Và rồi, khi lũ Dị Khách trồi lên từ đất mẹ... Mình tìm thấy nàng, giữa những bức tường bị bỏ bê.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415049
    m_Localized: 'Edgar: Một người con gái trong làn áo lanh mong manh, gương mặt phản chiếu nét đẹp đầy ám ảnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415050
    m_Localized: 'Edgar: Nơi trần gian tàn khốc này, nhân loại chỉ lo lấy thân họ. Mỗi mình là để ý nét duyên thầm của nàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415051
    m_Localized: 'Edgar: Cậu đã bao giờ nghe câu: "sống không được vì quá khác thường, chết không xong vì quá hiếm lạ" chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415052
    m_Localized: 'Edgar: Những lời ấy quả không sai. Ấy vậy nhưng... mình vẫn ôm lấy thân hình mỏng manh ấy, đưa nàng về nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415053
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415054
    m_Localized: 'Edgar: Để khi thần chết gõ cửa, mình vẫn có thể ngẩng cao đầu mà nói: tất thảy mọi điều, mình làm là vì yêu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415055
    m_Localized: 'Edgar: Một áng thơ tình thinh lặng...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415056
    m_Localized: Người ấy giờ đang ở đâu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415057
    m_Localized: Tôi cần kiểm tra cậu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415058
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415059
    m_Localized: 'Edgar: Mình đã thề sẽ dành cả đời hòng bắt trọn vẻ đẹp, cảm nhận sức mạnh đáng sợ và lớn lao từ sự thinh lặng của nàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415060
    m_Localized: 'Edgar: Cho đến khi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415061
    m_Localized: 'Edgar: Những kẻ vô diện áo vàng bất chợt xông vào, phá tan bầu không khí tĩnh mịch.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415062
    m_Localized: 'Edgar: Họ cướp nàng đi, kéo lê về nơi xa vắng. Chắc cậu cũng hiểu nguyên do rồi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415063
    m_Localized: 'Edgar: Đáng tiếc... Mình còn chưa kịp hiểu nàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415064
    m_Localized: 'Edgar: Giờ mình chỉ có thể chạm đến nàng khi chìm sâu trong miền ký ức...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415065
    m_Localized: 'Edgar: Nhân loại hô hào giải cứu thế giới, nhưng lại chẳng thể đồng lòng nhất trí cách thực hiện. Câu trả lời rất đơn giản.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415066
    m_Localized: 'Edgar: Ấy là sự thinh lặng. Là cái đẹp. Giá như có ai đó... chiêm nghiệm được điều này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415067
    m_Localized: 'Edgar: Nàng đã cố chỉ dạy, nhưng mình chỉ học được mỗi sự bình an. Một nét duyên dáng giữa muôn điều khiếp đảm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415068
    m_Localized: 'Edgar: Chí ít thì giờ đây... mình đã sẵn sàng theo bước nàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415069
    m_Localized: 'TaxiDriver: Chú muốn hỏi chi thì hỏi đi. Đừng có ngại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415070
    m_Localized: Anh nghĩ bên Thảm Họa còn truy đuổi anh không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415071
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415072
    m_Localized: 'TaxiDriver: Nói thiệt chứ, chỉ trông nó buông tha tui cho rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415073
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415074
    m_Localized: 'TaxiDriver: Ờ, công nhận tui dại thiệt, tự nhiên lết xác qua chỗ tụi Thảm Hại mần chi hông biết. Đáng lẽ phải biết kiểu chi nó cũng muốn hốt mình luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415075
    m_Localized: 'TaxiDriver: Cứ đinh ninh là tụi đó chỉ bắt ông khách thôi, rồi để tui yên.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415076
    m_Localized: 'TaxiDriver: Ai dè nó cướp luôn xe, còn mém đục một lỗ giữa sọ tui. Mất cả chì lẫn chài.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415077
    m_Localized: 'TaxiDriver: Mà giờ nghĩ lại, lúc đó tui biết mần chi khác nữa? Thằng cha kia là Dị Khách mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713957
    m_Localized: Rồi lỡ hóa ra ông ấy là người thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713958
    m_Localized: Thôi, anh cũng đâu còn cách nào khác
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713959
    m_Localized: 'TaxiDriver: Ê nha, chú đừng có quở dị nghen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713960
    m_Localized: 'TaxiDriver: Chuyện như vậy, tui cũng có vui vẻ chi đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713961
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713962
    m_Localized: 'TaxiDriver: Ừa... chú nói chuẩn, công nhận luôn. Đâu còn cách nào khác đâu ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713963
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713964
    m_Localized: 'TaxiDriver: Hầy, tui nhớ tha thiết cái thời đẹp tươi, chỉ cần ngồi sau vô lăng, quên hết sự đời.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713965
    m_Localized: 'TaxiDriver: Giờ đâu đâu cũng gặp Dị Khách... Má, léng phéng có ngày khách trên xe nó nã mình một phát, tiễn về nơi chín suối luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713966
    m_Localized: 'TaxiDriver: Hây dà...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415078
    m_Localized: 'TaxiDriver: Chú muốn hỏi chi thì hỏi đi. Đừng có ngại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415079
    m_Localized: Anh làm tài xế taxi được lâu chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415080
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415081
    m_Localized: 'TaxiDriver: Cũng lâu rồi đó chú. Kiểu, công ty trách nhiệm hữu hạn một mình tui, tự lập tự chủ, hổng mần thuê cho ai hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415082
    m_Localized: 'TaxiDriver: Mà tụi Thảm Hại giờ nó cấm đường gắt như chó, có cho dân mình tự do đi lại đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415083
    m_Localized: 'TaxiDriver: Nhưng thảm họa rồi cũng dứt thôi mà ha? Có tiền hổng bao giờ là thừa hết. Bởi vậy nên... cứ phải cày thôi chú ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415084
    m_Localized: 'TaxiDriver: Bây giờ ít tài xế chịu chở, đi lại nguy hiểm quá mà. Được vậy khách mới trả ngon chú ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415085
    m_Localized: 'TaxiDriver: Với lại, lái xe buổi tối cũng hay mần tui nhớ lại hồi con nít.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415086
    m_Localized: 'TaxiDriver: Kể nghe chớ, tại tía tui mà tui mới đi mần nghề lái xe nè. Muốn theo bước chân ổng. Chắc chú cũng hiểu mà ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713967
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713968
    m_Localized: 'TaxiDriver: Mà tui chả muốn đi vào vết xe đổ của tía đâu. Nằm vất vưởng bên vệ đường, hổng ai quan tâm ngó ngàng...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713969
    m_Localized: 'TaxiDriver: Chỉ trông số kiếp tui vẫn chưa tận...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415087
    m_Localized: 'TaxiDriver: Chú muốn hỏi chi thì hỏi đi. Đừng có ngại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415088
    m_Localized: 'Hôm nay nhìn anh buồn thiu vậy '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415089
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415090
    m_Localized: 'TaxiDriver: Ầy, biết sao hông, tại...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415091
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415092
    m_Localized: 'TaxiDriver: Kiểu, tới giờ tui vẫn còn đau vụ mất em xế hộp...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713970
    m_Localized: Xe anh là loại gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713971
    m_Localized: Xe anh có gì đặc biệt mà quý thế?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713972
    m_Localized: 'TaxiDriver: Mèn đét ơi, nó là con xe cổ điển đẹp nhứt trần đời luôn á...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713973
    m_Localized: 'TaxiDriver: Thân vàng sáng rực, mâm xe mạ crôm bóng loáng, đường cong mượt mà như lụa...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713974
    m_Localized: 'TaxiDriver: Nhưng giờ nàng ấy còn đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713975
    m_Localized: 'TaxiDriver: Đụ má mấy thằng Thảm Hại... Con xe đó là báu vật của đời tui mà! Mẹ nó ác như chó.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713976
    m_Localized: 'TaxiDriver: Xe của tía tui để lại đó. Hồi xưa ổng cũng mần lái taxi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713977
    m_Localized: 'TaxiDriver: Nhớ cái thời còn nhỏ, đêm đêm tui khoái ngồi xe của tía lắm. Toàn căn giờ ngủ gục ở ghế sau, để tía cứ vậy chở tui đi ro ro. Nhưng rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713978
    m_Localized: 'TaxiDriver: Cái số tía tui, nó tận...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415096
    m_Localized: 'TaxiDriver: Chú muốn hỏi chi thì hỏi đi. Đừng có ngại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415097
    m_Localized: Rồi cha anh bị sao vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415098
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713979
    m_Localized: 'TaxiDriver: Thiệt tình tui chả muốn nhắc lại đâu, nhưng mà... Ừ thôi, chắc là tui cũng tin anh được.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713980
    m_Localized: 'TaxiDriver: Chuyện là có hôm má tui đi công tác, nên tía chở tui đi taxi chung.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713981
    m_Localized: 'TaxiDriver: Bữa đó, tụi tui rước trúng một ông khách này. Cả đời tui cũng hông quên được chả.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713982
    m_Localized: 'TaxiDriver: Cái đầu trọc lóc, áo quần bảnh bao, cười gian như quỷ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713983
    m_Localized: 'TaxiDriver: Nguyên cái thị trấn, chưa có ai là chưa nghe danh chả. Thò lò mũi xanh như tui còn biết nữa. Chả mà đã hỏi thì ai dám từ chối.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713984
    m_Localized: 'TaxiDriver: Khổ cái tía tui lại là người quá quân tử. Chỉ vì một quyết định của ổng... mà tai họa giáng xuống cả nhà tui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713985
    m_Localized: 'TaxiDriver: Con ác quỷ mặc com lê đó... đã bắt gia đình tui phải trả giá đắt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713986
    m_Localized: 'TaxiDriver: Cha con tui mất nhà mất cửa. Phải đi lang thang phiêu bạt, hổng ở đâu được lâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713987
    m_Localized: 'TaxiDriver: Tụi tui cũng nghèo xác xơ, chả có mấy nhiêu đồng bạc, nên tía tui vẫn giữ con taxi ổng lái đó giờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713988
    m_Localized: 'TaxiDriver: Nhưng mà về sau nợ nần chồng chất, đâm ra ổng chỉ ước mình đã bán quách cái xe từ sớm cho rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713989
    m_Localized: 'TaxiDriver: Ổng kêu xe đó là lời nguyền ám quẻ, mang xui xẻo tới cho cái nhà này.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713990
    m_Localized: 'TaxiDriver: Nhưng mà tía đời nào hiểu được.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713991
    m_Localized: 'TaxiDriver: Chính lòng tự trọng của ổng mới là thứ làm cả nhà mất hết tất cả, chớ cái xe thì có tội tình gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713992
    m_Localized: 'TaxiDriver: Rồi tai bay vạ gió, đời cha ăn mặn, đời con khát nước... Thành thử ra tui mới phải đi làm sớm để phụ nuôi gia đình. Mà chú biết sao hông...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713993
    m_Localized: 'TaxiDriver: Thiệt tình tui vẫn còn thương tía lắm...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713994
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713995
    m_Localized: 'TaxiDriver: Nhớ tía lắm, tía ơi...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713996
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713997
    m_Localized: 'TaxiDriver: Hổng muốn đòi hỏi gì nhiều đâu, nhưng mà... Nếu tiện thì, chú có thể nào, ờm, điện cho tía tui được hông á?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713998
    m_Localized: 'TaxiDriver: Số của ổng là: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713999
    m_Localized: 'TaxiDriver: Cứ nói ổng là tui hổng có sao. Tự lo được hết, bị cái là... giờ tui hổng để lộ vị trí mình được ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415106
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415128
    m_Localized: 'Provocateur: Thế giới đảo điên thật…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415129
    m_Localized: Gì nữa đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415130
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415131
    m_Localized: 'Provocateur: Anh còn phải hỏi nữa à? Chúng ta nên hoàn thành hợp đồng thuê nhà chính thức đi chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415132
    m_Localized: Thế tôi làm hợp đồng kiểu gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415133
    m_Localized: Bộ cái đó quan trọng lắm à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415134
    m_Localized: 'Provocateur: Sao? Anh không sở hữu bất kỳ hồ sơ giấy tờ nào cần thiết ư?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415135
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415136
    m_Localized: 'Provocateur: Thế thì anh phải tìm đến cơ quan nhà nước để làm thủ tục xin cấp lại đi chứ. Chậc chậc, thật tình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415137
    m_Localized: Đùa hả? Bây giờ tìm đâu ra nhà nước còn cấp giấy tờ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415138
    m_Localized: Sao không tự đi mà lấy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415139
    m_Localized: 'Provocateur: Này nhé, mong anh xưng hô một cách đúng mực, thể hiện sự tôn trọng với đối phương.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415140
    m_Localized: 'Provocateur: Dân tình thời nay đúng là vô phép quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415141
    m_Localized: Thôi được rồi, kệ anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415142
    m_Localized: Biến mẹ ông đi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415143
    m_Localized: 'Provocateur: Anh hoàn toàn có thể sử dụng bản đồ để tìm mà. Có gì khó đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415144
    m_Localized: 'Provocateur: Và một lần nữa, tôi yêu cầu anh nói năng tử tế, xưng hô đúng mực vào. Anh phải biết tôn trọng người khác chứ hửm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415145
    m_Localized: Thôi được rồi, kệ anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415146
    m_Localized: Biến mẹ ông đi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415147
    m_Localized: 'Provocateur: Sao tôi phải làm mấy việc vặt vãnh này? Mà anh toàn nói trống không vậy, phải xưng tôi gọi anh đàng hoàng như người có văn hóa chứ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415148
    m_Localized: 'Provocateur: Tôi đây là một công dân gương mẫu, chứ nào phải chân sai vặt cho anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415149
    m_Localized: Thôi được rồi, kệ anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415150
    m_Localized: Biến mẹ ông đi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415151
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415152
    m_Localized: 'Provocateur: Anh cố tình đúng không? Làm bộ hợp tác chút thôi thì có chết ai đâu hửm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415153
    m_Localized: 'Provocateur: Ê nha, cẩn thận lời nói của anh đấy. Điều 21 của Hiến pháp đã nêu rõ: Tội xúc phạm danh dự, nhân phẩm của người khác có thể bị phạt tù.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415154
    m_Localized: 'Provocateur: Đề nghị anh nên biết tôn trọng đối phương một chút, không thì đừng trách tại sao pháp luật lại nặng tay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415155
    m_Localized: 'Provocateur: Thế giới đảo điên thật…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415156
    m_Localized: Rồi thôi nhắc lại vụ này được chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415157
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415158
    m_Localized: 'Provocateur: Không được. Theo luật pháp, anh có nghĩa vụ phải hoàn tất hợp đồng thuê nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415159
    m_Localized: Tôi có giấy tờ gì đâu mà hoàn với chả tất
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415160
    m_Localized: Má, đùa nhau đấy hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415161
    m_Localized: 'Provocateur: Chà, thế là không được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415162
    m_Localized: 'Provocateur: Việc anh không có giấy tờ có thể coi là đã vi phạm Điều 131.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415163
    m_Localized: Tôi nóng máu rồi đấy nhé
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415164
    m_Localized: Hở tí là trích luật, mãi mà chưa chán à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415165
    m_Localized: 'Provocateur: Tôi chỉ đang thực hiện đúng nghĩa vụ của một công dân mẫu mực thôi. Căn cứ Điều 131, chúng ta bắt buộc phải lập hợp đồng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415166
    m_Localized: Tôi cáu lắm rồi đấy nhé
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415167
    m_Localized: Hở tí là trích luật, mãi mà chưa chán à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415168
    m_Localized: 'Provocateur: Ồ, không sai một li, tới phần lăng mạ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415169
    m_Localized: 'Provocateur: Giờ thì anh đã vi phạm Điều 5.61 của Bộ luật hành chính.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415170
    m_Localized: 'Provocateur: Cứ chửi bới tôi thoải mái. Rồi anh sẽ rơi vào thế bất lợi trước tòa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415171
    m_Localized: 'Provocateur: Không, tôi vẫn sẽ tiếp tục trích dẫn cả Bộ luật lẫn Hiến pháp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415172
    m_Localized: 'Provocateur: Tôi ý thức rõ các quyền của mình! Việc ANH thiếu hiểu biết về luật pháp, không có nghĩa là người khác phải từ bỏ quyền lợi chính đáng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415173
    m_Localized: 'Provocateur: Nhân tiện tôi nhắc anh luôn, xưng hô cho đàng hoàng vào. Tôn trọng đối phương chút đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415174
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415175
    m_Localized: 'Provocateur: Chậc chậc. Bao giờ anh mới chịu hiểu đây hửm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415176
    m_Localized: 'Provocateur: Thế giới đảo điên thật…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415177
    m_Localized: Gì nữa đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415178
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415179
    m_Localized: 'Provocateur: Tôi để ý thấy anh đang tàng trữ vũ khí trong nhà. Yêu cầu anh xuất trình giấy phép sử dụng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415180
    m_Localized: Đếch phải việc của anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415181
    m_Localized: Bộ anh có thù oán gì với tôi hả?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415182
    m_Localized: 'Provocateur: Ồ, vậy là anh không có giấy phép chứ gì? Phản ứng cực đoan như thế thì chắc chắn là không rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415183
    m_Localized: 'Provocateur: Anh tưởng cứ có súng thì được quyền cho mình là luật, thích làm gì thì làm hửm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415184
    m_Localized: 'Provocateur: Rằng anh có quyền tra hỏi bất cứ ai, nhưng không ai được phép chất vấn anh sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415185
    m_Localized: 'Provocateur: Xin thưa: Anh nhầm to rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415186
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415187
    m_Localized: 'Provocateur: Nhưng anh biết không, người đời có câu: Quả quýt dày có móng tay nhọn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415188
    m_Localized: Thôi đi nhé. Tôi đã lắm thứ phải lo rồi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415189
    m_Localized: Dẹp mẹ cái trò xàm lồn này được chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415190
    m_Localized: 'Provocateur: Không hề có tư thù ở đây. Tôi chỉ muốn nắm rõ thông tin về đối tượng đang chung sống với mình thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415191
    m_Localized: 'Provocateur: Quan sát phản ứng của anh... thì rõ là trúng tim đen rồi. Tôi kết luận luôn: Chắc chắn anh không có giấy phép.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415192
    m_Localized: 'Provocateur: Anh tưởng pháp luật chừa mình ra hửm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415193
    m_Localized: 'Provocateur: Anh cứ cho là mình được truy tìm thủ phạm, còn người khác thì không có quyền soi xét anh ư?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415194
    m_Localized: 'Provocateur: Rất tiếc... anh nhầm to rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415195
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415196
    m_Localized: 'Provocateur: Nhưng anh biết không, người đời có câu: Quả quýt dày có móng tay nhọn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415197
    m_Localized: Thôi đi nhé. Tôi đã lắm thứ phải lo rồi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415198
    m_Localized: Dẹp mẹ cái trò xàm lồn này được chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415199
    m_Localized: 'Provocateur: Ôi trồ ôi, tội chưa kìa. Không ai dám tra hỏi anh, không ai kiểm tra xem anh có phải Dị Khách không. Cuộc sống chắc là khó khăn lắm nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415200
    m_Localized: 'Provocateur: Thế ai cho anh vào vai người phán xử, tự mình quyết xem ai sống ai chết hửm? Anh lấy đâu ra thẩm quyền đấy hửm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415201
    m_Localized: 'Provocateur: Chúng tôi phải nơm nớp lo sợ cầu cho anh không xử mình, còn anh thì lại mong chờ sự cảm thông? Đùa nhau à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415202
    m_Localized: 'Provocateur: Xin lỗi nhé, nhưng mà theo cách nói thô thiển của anh, chẳng phải chính anh mới là người đang bày trò kiểm tra "xàm lồn" này đấy sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415203
    m_Localized: 'Provocateur: Anh đi tọc mạch đủ thứ, đối xử với người khác như thể họ sắp giết người tới nơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415204
    m_Localized: 'Provocateur: Còn kẻ sát nhân thực sự ở đây thì đâu ai dám hó hé gì. Tôi nói có thể nhé... Ý kiến cá nhân thôi... Thật ra chẳng có Dị Khách gì sất.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415205
    m_Localized: 'Provocateur: Vậy tức là sao nhỉ? Có khi nào anh chỉ là một tên điên lạm chức quyền, lợi dụng thời thế loạn lạc mà thỏa mãn thú vui khát máu không đấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415206
    m_Localized: 'Provocateur: Còn các cư dân tạm trú ở đây nghe tin trên báo đài mới đâm hoảng loạn, kéo nhau chạy đến nhà anh như ruồi bâu vào phân chó vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415207
    m_Localized: 'Provocateur: Nào, anh khai thật đi, trong số những đối tượng đến đây từ khi bắt đầu thảm hoạ, được mấy người là còn sống vậy hửm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415208
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415209
    m_Localized: 'Provocateur: Hừ, biết ngay mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415210
    m_Localized: 'Provocateur: Thế giới đảo điên thật…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415211
    m_Localized: Xin cho hỏi, anh vẫn chưa đi à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415212
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415213
    m_Localized: 'Provocateur: Ồ, thật đáng khen... Cuối cùng anh cũng chịu nói năng đúng mực, thưa gửi đàng hoàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415214
    m_Localized: 'Provocateur: Tiếc là đã quá muộn màng rồi. Tôi buộc phải báo cáo anh thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415215
    m_Localized: Báo cáo gì cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415216
    m_Localized: Báo cáo cho ai cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415217
    m_Localized: 'Provocateur: Anh không lừa tôi được nữa đâu, tôi biết hết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415218
    m_Localized: 'Provocateur: Đây có phải nhà anh đâu. Không hề! Người chủ thật đã bị anh giết hại, còn anh chỉ mạo danh họ thôi. Tôi sẽ báo cho Phòng Chống Thảm Họa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415219
    m_Localized: 'Provocateur: Cứ chờ đấy, họ sẽ đến đây bắt anh đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415220
    m_Localized: Mày xàm chó à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415221
    m_Localized: Thế để tao bịt họng cho mày đéo nói được nữa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415222
    m_Localized: 'Provocateur: Cơ quan Phòng, chống thảm họa Liên bang, gọi nôm na là Phòng Chống Thảm Họa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415223
    m_Localized: 'Provocateur: Chuyện hợp đồng cỏn con kia thì tôi còn nhắm mắt cho qua được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415224
    m_Localized: 'Provocateur: Nhưng càng nói chuyện với anh, tôi càng thấy rõ bản chất sự thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415225
    m_Localized: 'Provocateur: Mọi chuyện đã sáng tỏ. Đây không phải là nhà anh. Anh chỉ đang mạo danh chủ nhà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415226
    m_Localized: 'Provocateur: Anh chính là DỊ KHÁCH!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415227
    m_Localized: 'Provocateur: Chuẩn bị tinh thần đi. Cán bộ sắp đến mời anh về khu cách ly rồi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415228
    m_Localized: Mày xàm chó à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415229
    m_Localized: Thế để tao bịt họng cho mày đéo nói được nữa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415230
    m_Localized: 'Provocateur: Anh lộng hành quá rồi. Tôi phải BÁO CÁO hết. Cán bộ sẽ tới BẮT ANH đi. Cứ chờ mà xem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415231
    m_Localized: Kệ cha mày. Cút!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415232
    m_Localized: Mày tàn đời rồi con (Rút súng ra)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415233
    m_Localized: 'Provocateur: Anh tưởng uy hiếp như vậy là tôi sẽ im à? Còn lâu nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415234
    m_Localized: 'Provocateur: Ê nha... Đừng nói là?! Anh điên rồi hả? Thế là vi phạm hình sự đó!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415235
    m_Localized: 'Provocateur: Th-Th-Thôi ngay đi nhé, vậy là sai lắm đấy! Anh không thoát tội được đâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609280
    m_Localized: 'Provocateur: Tôi nhất quyết ở đây tới khi nào cán bộ Phòng Chống đến.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609281
    m_Localized: 'Provocateur: Tôi sẽ trình báo tất cả những gì anh đã làm, cho họ thấy anh là tội phạm nguy hiểm thế nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609282
    m_Localized: 'Provocateur: Ê nha... Đừng nói là?! Anh điên rồi hả? Thế là vi phạm hình sự đó!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609283
    m_Localized: 'Provocateur: Anh làm gì mà DÁM!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609284
    m_Localized: Cút ngay trước khi tao bắn
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609285
    m_Localized: Mày không ra khỏi đây là tao bắn
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609286
    m_Localized: Chính mày buộc tao phải bắn
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609287
    m_Localized: (Bắn)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609288
    m_Localized: 'Provocateur: Anh đừng hòng thoát được bên Phòng Chống! Muốn trốn thì bước qua xác tôi đã!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609289
    m_Localized: 'Provocateur: Rồi họ sẽ trừng trị anh thích đáng!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609290
    m_Localized: 'Provocateur: Chính anh cũng đẩy tôi vào bước đường cùng mà!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609291
    m_Localized: 'Provocateur: ANH KHÔNG PHẢI NGƯỜI! MÀ LÀ KẺ SÁT NHÂN! LÀ QUÂN DỊ KHÁCH!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609292
    m_Localized: 'Provocateur: KHÔNG ĐƯỢC! LÀM THẾ LÀ PHẠM LUẬT!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609293
    m_Localized: 'Provocateur: ÁÁÁÁÁÁ!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609294
    m_Localized: 'Marauder: Chỉ cần hốt được mẻ lớn... Là quá ngon rầu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609295
    m_Localized: Sao? Có mò được gì trong nhà tôi chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609296
    m_Localized: Tôi cần kiểm tra bác
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609297
    m_Localized: 'Marauder: Thâu mà cậu. Tại tui tưởng chỗ này bỏ hoang nên mới tính mò vô thâu... Ai biết có người ở trỏng đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609298
    m_Localized: 'Marauder: Tui chỉ đi chôm đồ của người thiên cổ thâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609299
    m_Localized: 'Marauder: Cậu nghĩ coi, cha đó chết rầu thì cần ba cái áo khoác này chi nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609300
    m_Localized: 'Marauder: Chủ thì xanh cỏ. Đồ thì nằm lăn lóc đó. Còn tui sống nhăn răng nè. Chi bằng lấy cái đó cứu được mạng tui, rầu cứu người thân tui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609301
    m_Localized: 'Marauder: Tới khi người cậu yêu quý lâm nguy, thì cậu cũng sẵn sàng thó đồ xác chết để cứu họ thâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609302
    m_Localized: 'Marauder: Chết rầu thì về với cát bụi. Xác người có gì đâu mà quý với chả thiêng. Tôn thờ nó làm cái quỷ gì, xàm lém.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609303
    m_Localized: 'Marauder: Chỉ cần hốt được mẻ lớn... Là quá ngon rầu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609304
    m_Localized: Đời đưa đẩy như nào mà bác lại đi làm nghề này?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609305
    m_Localized: Tôi cần kiểm tra bác
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609306
    m_Localized: 'Marauder: Chứ giờ còn biết làm sao nữa cậu ơi? Tui đâu có muốn đụng chạm gì tới ai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609307
    m_Localized: 'Marauder: Nên tui mới chọn cái nghề thầm lặng này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609308
    m_Localized: 'Marauder: Đồ của người chết khác gì đồ vô chủ. Cái xác có biết chống cự đâu mà. Coi như tui nhặt được của rơi, tạm thời bỏ túi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609309
    m_Localized: 'Marauder: Tui lăn lộn ngoài kia để kiếm sống thâu, nào muốn làm hại ai bao giờ. Thậm chí có giúp được ai, tui cũng giúp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609310
    m_Localized: 'Marauder: Chỉ cần hốt được mẻ lớn... Là quá ngon rầu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609311
    m_Localized: Lúc đi nhặt đồ thì bác tìm được những món gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609312
    m_Localized: Tôi cần kiểm tra bác
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609313
    m_Localized: 'Marauder: Trời quơi, đếm hổng hết luôn cậu ơi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609314
    m_Localized: 'Marauder: Để tui nhớ coi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609315
    m_Localized: 'Marauder: Có một hôm, tui đi vô cái thư viện bỏ hoang. Toàn sách dính bụi chất đống ở đó, làm như có ai còn tới mướn đọc dẫy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609316
    m_Localized: "Marauder: Rồi một bữa khác, tui đi ngang cái phòng triển lãm của mấy đứa họa sĩ mới vô nghề. Tranh còn treo đầy \nở trỏng luôn á."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609317
    m_Localized: 'Marauder: Có lần... tui còn thấy được cảnh hoàng hôn nữa đó. Mà nó đặc biệt lắm nhe, giống như được tô vẽ trên nền trời luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609318
    m_Localized: 'Marauder: Trời quơi... Thời buổi bây giờ, ai mà dám dòm lên trời nữa. Chả bù cho...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609319
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609320
    m_Localized: 'Marauder: Tự nhiên tui nhớ ngày xưa quá cậu ơi. Hồi đó tui dậy sớm thiệt sớm, thấy ngoài đường còn vắng tanh. Mây mù bao phủ, sương đọng trên lá non.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609321
    m_Localized: 'Marauder: Rồi khi bình minh ló dạng... Trời quơi ta nói chớ, sáng rực cả một góc trời. Dòm như thấy được cả ngày đẹp tươi trước mắt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609322
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609323
    m_Localized: 'Marauder: Từ khi nào... vầng dương chói lọi lại trở thành kẻ thù của mình dẫy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609324
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609325
    m_Localized: 'Marauder: Phải chi có ai biết được lời giải, thì mọi chuyện đã hông tuyệt vọng tới như vầy...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609326
    m_Localized: 'Marauder: Chỉ cần hốt được mẻ lớn... Là quá ngon rầu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609327
    m_Localized: Bác đã bỏ nghề nhặt đồ chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609328
    m_Localized: Tôi cần kiểm tra bác
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609329
    m_Localized: 'Marauder: Chưa, tui vẫn đang làm. Nhưng mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609330
    m_Localized: 'Marauder: Hổng biết sao... tui chợt nhớ lại một lần làm tui rợn hết sống lưng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609331
    m_Localized: 'Marauder: Bữa đó cũng như mọi ngày thâu. Tui đi vô cái nhà. Có cái xác nằm đó. Hổng có gì nguy hiểm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609332
    m_Localized: 'Marauder: Xác thằng cha này lưng đầy lỗ, đang nằm cấn cấn lên cái gì đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609333
    m_Localized: 'Marauder: Tui bèn nghĩ bụng "có khi chả đang giấu đồ thì ngủm". Dẫy là tui tới gần, lật chả lại...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609334
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609335
    m_Localized: 'Marauder: Mà thâu, để hầu sau tui kể tiếp. Chuyện ghê quá, tui còn chưa dám nhớ lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609336
    m_Localized: 'Marauder: Chỉ cần hốt được mẻ lớn... Là quá ngon rầu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609337
    m_Localized: Bên dưới cái xác đó là gì vậy bác?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609338
    m_Localized: Tôi cần kiểm tra bác
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609339
    m_Localized: 'Marauder: Được rầu, tui kể cho...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609340
    m_Localized: 'Marauder: Lúc lật cái xác lên, tui thấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609341
    m_Localized: 'Marauder: Một bé gái... đã chết rầu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609342
    m_Localized: 'Marauder: Người lớn chết thì tui thấy hoài, quen rầu. Nhưng còn con nít thì... khác biệt lắm cậu ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609343
    m_Localized: 'Marauder: Mỗi lần thấy xác tụi nhỏ là cổ họng tui ứ nghẹn một cục.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609344
    m_Localized: 'Marauder: Bé gái đó... vẫn còn ôm con mèo bông trên tay.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609345
    m_Localized: "Marauder: Trời quơi, máu chảy lênh láng \nkhắp sàn..."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609346
    m_Localized: "Marauder: Còn khuôn mặt của bé nó nữa... Dòm như kiểu... nhỏ đã biết là mình \ntới số rầu."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609347
    m_Localized: 'Marauder: Tự nhiên, tui cũng chợt rùng mình... Tưởng như con bé nó sợ tui lấy mất đồ chơi của nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609348
    m_Localized: 'Marauder: Cứ như là tới lúc chết rầu, nhỏ cũng hông thoát khỏi sự tàn ác của người đời.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609349
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609350
    m_Localized: 'Marauder: Cảnh tượng đó ám ảnh tui. Còn đeo bám tui tới tận bây giờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609351
    m_Localized: 'Marauder: Cứ nghĩ tới là tui muốn bỏ nghề, cho người chết được ra đi thanh thản... Nhưng đã quá muộn rầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609352
    m_Localized: 'Marauder: Sau bao nhiêu năm hành nghề, đâu phải muốn bỏ là bỏ. Nó thành cái máu ăn sâu vô người. Chỉ có cách đó tui mới tồn tại được...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609353
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609354
    m_Localized: 'Marauder: Người ta hay nói sống ở đời, chạy trời cũng hông thoát được số phận. Giờ nghĩ lại thấy sao mà đúng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609355
    m_Localized: 'GraveDigger: Phải chi tụi Dị Khách chui hết dìa đất mẹ đi, cho đời nó đẹp...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609356
    m_Localized: Cơ duyên nào mà anh lại đi đào huyệt mộ thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609357
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609358
    m_Localized: 'GraveDigger: Hở? Ý là tại sao tui mần nghề này á hả? Nói thiệt chớ, tui cũng hổng biết luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609359
    m_Localized: 'GraveDigger: Tui quan niệm mấy cái nghĩa trang... cũng giống như tàng thư á. Mỗi tội mấy cuốn sách nằm im re dứ đất, hổng bao giờ mở ra coi được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609360
    m_Localized: 'GraveDigger: Hồi đó tui thuộc làu làu khu này luôn á. Ai chết, nằm huyệt nào, mặc đồ gì, tư thế ra sao, vân vân mây mây, tui nhớ sạch bách.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609361
    m_Localized: 'GraveDigger: Rồi một ngày nọ, tui đào thêm cái huyệt mới. Rất chi là bình thường thôi, tới khi tui đào trúng chỗ hài cốt. Má nó TRỐNG TRƠN CẬU ƠI!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609362
    m_Localized: 'GraveDigger: Theo giấy báo ghi thì chỗ này phải có ai nằm, vậy mà tui hổng thấy gì trong mộ hết trơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609363
    m_Localized: 'GraveDigger: Tui còn nhớ sơ sơ mặt ổng để ria mép, chết rõ ràng luôn. Nhưng ổng biến đi đâu mất tiêu ngừ ơi! Dứ đó chỉ có mấy con giun.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609364
    m_Localized: 'GraveDigger: Cái tui chợt nghĩ: Ngừ chết mà mất tích thì có coi như là chết lần hai hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609365
    m_Localized: 'GraveDigger: Phải chi tụi Dị Khách chui hết dìa đất mẹ đi, cho đời nó đẹp...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609366
    m_Localized: Lúc phát hiện trong mộ trống trơn, anh đã làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609367
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609368
    m_Localized: 'GraveDigger: Thì lúc đó tui ngồi ngay kế bên, trơ mắt mà dòm. Xong tui ngước lên thì thấy, xa xa có ai đang đứng lù lù.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609369
    m_Localized: 'GraveDigger: Lẳng lặng. Dòm tui chằm chặp. Như đưa đám. Mắt đâu hổng thấy. Nụ cười rợn gáy. Răng trắng như ma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609370
    m_Localized: 'GraveDigger: Quỷ thần ơi ta nói, mần tui sợ muốn són ra quần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609371
    m_Localized: 'GraveDigger: Ba mươi sáu kế, chạy là thượng sách. Hên là thằng chả hổng rượt theo, nhưng tui quay lại... thì biến mất tiêu. Không cánh mà bay luôn trời.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609372
    m_Localized: 'GraveDigger: Má nó điên dữ thần… Từ dạo đó là đám Dị Khách cũng bắt đầu xuất hiện.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609373
    m_Localized: 'GraveDigger: Phải chi tụi Dị Khách chui hết dìa đất mẹ đi, cho đời nó đẹp...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609374
    m_Localized: Giờ không ai cần chôn người chết nữa, anh còn đào huyệt làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609375
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609376
    m_Localized: 'GraveDigger: Có đào mấy nữa đâu cậu ơi. Tui chỉ để ý... ngó chừng vậy thôi. Mà sau cái hôm đó, tui bắt đầu đi loanh quanh chọc chọc mấy mộ mới chôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609377
    m_Localized: 'GraveDigger: Mà tui mần cẩn thận lắm luôn, thề. Hổng có giở trò gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609378
    m_Localized: 'GraveDigger: Mới đầu tui nghĩ, biết đâu có đứa quái thai nào bị chôn lộn. Tui cầm xẻng thiệt chắc, như cầm kiếm trên tay. Thấy cái gì ngọ nguậy là phang liền.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609379
    m_Localized: 'GraveDigger: Xong đào lên thì... xương cốt vẫn còn, xác chết cũng hông nhúc nhích. Hổng có cái gì chui lên hết trọi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609380
    m_Localized: 'GraveDigger: Tui mới trầm ngâm kiểu... Có khi tụi Dị Khách hổng phải xác chết sống lại, mà là một đám đáng ra phải chôn từ lâu rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609381
    m_Localized: 'GraveDigger: Phải chi tụi Dị Khách chui hết dìa đất mẹ đi, cho đời nó đẹp...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609382
    m_Localized: Dạo này anh không đào thêm huyệt mới nữa đó chứ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609383
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609384
    m_Localized: "GraveDigger: Trời ơi nghĩ sao! Ngu gì đào nữa. Nói cho cậu biết, từ lúc cha sinh mẹ đẻ \ntới giờ là tui đã quen mùi xác rồi."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609385
    m_Localized: 'GraveDigger: Chết chóc hay gì tui cũng hông sợ. Ai đứt bóng thì đem chôn, xong. Nhưng còn bi giờ... lỡ mà mình ngủm, thì lấy ai chôn mình đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609386
    m_Localized: 'GraveDigger: Dù có ngừ chôn giùm đi nữa, chắc gì cái xác chịu nằm yên dứ đất? Nói đâu xa, cái huyệt tui dám chắc đã lấp rồi... rút cục hổng có ma nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609387
    m_Localized: "GraveDigger: Mà má nó, chính tay tui chôn ổng \nchớ đâu!"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609388
    m_Localized: 'GraveDigger: Ai biết được... có khi sau này mộ tui cũng trống trơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609389
    m_Localized: 'GraveDigger: Hay là... Hay là tui đã biến thành Dị Khách lúc nào hổng hay...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609390
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609391
    m_Localized: "GraveDigger: Thôi... cậu đừng lo. Tại tui sợ quá \nđó mà."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609392
    m_Localized: 'GraveDigger: Phải chi tụi Dị Khách chui hết dìa đất mẹ đi, cho đời nó đẹp...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609393
    m_Localized: Theo anh thì đám Dị Khách từ đâu mà tới?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609394
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609395
    m_Localized: 'GraveDigger: Có bao giờ cậu thấy tụi nó quen dữ thần hông? Dòm hổng ra ngừ... mà giống như ký ức về một ngừ thì đúng hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609396
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609397
    m_Localized: 'GraveDigger: Tui là tui nghĩ như vầy. Cậu nghe thử coi hợp lý hông nghen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609398
    m_Localized: "GraveDigger: Có khi tụi Dị Khách... thiệt ra \nhổng phải người chết..."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609399
    m_Localized: 'GraveDigger: Mà là ý nghĩ, suy tư, là những thứ mà ta không thể chôn vùi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609400
    m_Localized: 'GraveDigger: Ví như nỗi sợ, niềm tiếc nuối, những cảm xúc không thể buông bỏ. Nó cứ tích tụ dần dần, tới khi dứ đất im quá thì bắt đầu trồi dậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609401
    m_Localized: 'GraveDigger: Tụi nó hông kiếm xác thịt, mà muốn săn tìm sự chú ý của mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609402
    m_Localized: 'GraveDigger: Mình càng sợ nó, nó càng xáp tới gần. Tại mình còn nhớ, còn lưu giữ nó trong ký ức. Mà cái gì được khắc ghi... thì tự khắc sẽ muốn đội mồ sống dậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609403
    m_Localized: 'FormerFema: Cầu mong là tôi chưa tiếp xúc với mặt trời quá lâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609404
    m_Localized: Có thật là anh không phải cán bộ Thảm Họa không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609405
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609406
    m_Localized: 'FormerFema: Tôi nói rồi còn gì, tôi chỉ là công nhân sửa tủ lạnh thôi. Chả dính dáng gì tới đám đó hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609407
    m_Localized: 'FormerFema: ...Chẳng qua tôi tình cờ tìm thấy bộ đồ này trong một cái xe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609408
    m_Localized: Mới hôm trước anh bảo là lấy từ cái xác mà?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609409
    m_Localized: Anh có bịa chuyện không đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609410
    m_Localized: 'FormerFema: À ờ... đúng, đúng rồi đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609411
    m_Localized: 'FormerFema: Tôi lấy từ cái xác... trong một cái xe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609412
    m_Localized: 'FormerFema: Tại nghĩ là bận cái này vào thì đám Dị Khách nó hông làm gì được mình thôi. Chắc cũng vì vậy nên tụi Phòng Chống mới bận suốt ngày đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609413
    m_Localized: 'FormerFema: Gì, ai xạo với anh. Tại... đang căng thẳng quá nên tôi lộn xíu thôi mà. Có gì lạ đâu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609414
    m_Localized: 'FormerFema: Anh mà trải qua những điều tôi thấy thì cũng hiểu thôi... Thề luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609415
    m_Localized: 'FormerFema: Trên đường tới đây, tôi bắt gặp cả đống xác người, mà có mấy cái còn giựt giựt nữa chứ. Sợ muốn chết luôn...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609416
    m_Localized: 'FormerFema: Cầu mong là tôi chưa tiếp xúc với mặt trời quá lâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609417
    m_Localized: Mặc đồ của bọn áo vàng thế mà anh không sợ à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609418
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609419
    m_Localized: 'FormerFema: Hở? Thì... bình thường mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609420
    m_Localized: 'FormerFema: Ờ thì đúng là có mấy người hông thích bên Phòng Chống Thảm Họa thiệt...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609421
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609422
    m_Localized: 'FormerFema: À, ý là anh hỏi tôi hông sợ bị bắt vì tội mạo danh hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609423
    m_Localized: 'FormerFema: Ờm, thực ra thì... chắc là không sao đâu, tôi chỉ cần giải thích rõ ràng thôi mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609424
    m_Localized: 'FormerFema: Anh đâu cần nghĩ xấu cho mấy người đó vậy chứ. Họ có phải hội kín mờ mờ ám ám gì đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609425
    m_Localized: 'FormerFema: Cầu mong là tôi chưa tiếp xúc với mặt trời quá lâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609426
    m_Localized: Lột túi ra cho tôi xem nào
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609427
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609428
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609429
    m_Localized: 'FormerFema: Ê! A-Anh khám người tôi làm gì vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609430
    m_Localized: Để xem anh có thẻ nhân viên Thảm Họa không
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609431
    m_Localized: Sao thế? Có tật giật mình à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609432
    m_Localized: 'FormerFema: T-Thẻ nhân viên nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609433
    m_Localized: 'FormerFema: Không có gì trong đó đâu mà! Tôi nói thiệt...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609434
    m_Localized: Rượu mời không uống, muốn uống rượu phạt hả... Có gì trong túi lôi hết ra mau
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609435
    m_Localized: (Rút súng ra)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609436
    m_Localized: 'FormerFema: Hả gì? Tôi á?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609437
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609438
    m_Localized: 'FormerFema: Đừng mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609439
    m_Localized: Rượu mời không uống, muốn uống rượu phạt hả... Có gì trong túi lôi hết ra mau
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609440
    m_Localized: (Rút súng ra)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609441
    m_Localized: 'FormerFema: Thôi được rồi. Đừng hăm dọa tôi nữa mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609442
    m_Localized: 'FormerFema: Đó, hài lòng chưa hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609443
    m_Localized: 'FormerFema: Ờ rồi, tôi nhận. Tôi đúng là người của bên Phòng Chống đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609444
    m_Localized: 'FormerFema: Xin anh... đừng nói cho ai biết nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609445
    m_Localized: 'FormerFema: Trời má…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609446
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609447
    m_Localized: 'FormerFema: Đây. Làm ơn... đừng bắn tôi mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609448
    m_Localized: 'FormerFema: Đúng là tôi có làm ở bên đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609449
    m_Localized: 'FormerFema: Nhưng anh đừng nói cho ai khác biết nha... Vậy cho nó lành.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491072
    m_Localized: Tại sao anh lại che giấu danh tính?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491073
    m_Localized: Việc gì anh phải diễn kịch như này?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491074
    m_Localized: 'FormerFema: Anh hông hiểu thiệt hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491075
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491076
    m_Localized: 'FormerFema: Còn phải hỏi nữa hả cha?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491077
    m_Localized: 'FormerFema: Người ta mà biết tôi từng làm ở bên Phòng Chống thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491078
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491079
    m_Localized: 'FormerFema: Dù sao tôi cũng không còn làm cho bên đó nữa. Cứ coi như là... tôi nghỉ việc rồi đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491080
    m_Localized: 'FormerFema: Dù sao tôi cũng không còn làm cho bên đó nữa. Cứ coi như là... tôi nghỉ việc rồi đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491081
    m_Localized: 'FormerFema: Tôi đã phải làm nhiều chuyện... tồi tệ, khó coi lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491082
    m_Localized: 'FormerFema: Vây bắt người... xong rồi đưa họ đến khu cách ly...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491083
    m_Localized: 'FormerFema: Nhưng mà chẳng qua tôi làm vì công việc thôi! Cấp trên nói sao thì tôi nghe vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491084
    m_Localized: 'FormerFema: Muốn tìm người thân thì đi mà hỏi tụi chóp bu. Nhân viên quèn lương ba cọc ba đồng như tôi sao mà biết được.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491085
    m_Localized: 'FormerFema: Đã vậy tôi còn bị chửi là đồ sát nhân, cầm thú này kia nữa... Công bằng ở đâu?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491086
    m_Localized: 'FormerFema: Nếu đưa đám Dị Khách đi cách ly là cứu người, thì có gọi tôi là sát nhân được hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609450
    m_Localized: 'FormerFema: Cầu mong là tôi chưa tiếp xúc với mặt trời quá lâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609451
    m_Localized: Tại sao anh không muốn cho người ta biết?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609452
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491087
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491088
    m_Localized: 'FormerFema: Có một thằng cha bị nghi là Dị Khách, tôi đưa chả đi cách ly.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491089
    m_Localized: 'FormerFema: Ngắn gọn là, tình trạng chả chuyển biến xấu, rồi qua đời luôn. Chuyện thường ấy mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491090
    m_Localized: 'FormerFema: Rồi vợ chả tới thăm, hỏi chừng nào chả được thả. Chúng tôi mới báo tin cho bà chị đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491091
    m_Localized: 'FormerFema: Bả sốc quá, la hét om sòm, chửi tụi tôi là đồ sát nhân, rồi nằng nặc đòi đưa thi thể của chồng về.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491092
    m_Localized: 'FormerFema: Tụi tôi mới bảo vậy là sai quy tắc rồi, không có được. Nhưng bả có chịu đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491093
    m_Localized: 'FormerFema: Xong bả ngồi lì cắm cọc ở đó luôn, ngay trước cổng Cơ quan.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491094
    m_Localized: 'FormerFema: Cuối cùng tụi tôi nhượng bộ, giao lại thi thể chồng cho bả. Kết quả là sau vụ đó, cả đám bị sa thải hết vì vi phạm quy định.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491095
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491096
    m_Localized: 'FormerFema: Con mẹ khùng điên đó cứ nhất quyết phải đòi lấy thi thể về cho bằng được. Tại bả quậy tưng bừng mà tôi mới mất việc.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491097
    m_Localized: 'FormerFema: Giờ còn chẳng biết đi đâu nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491098
    m_Localized: 'FormerFema: Đã vậy, bả còn lôi cái xác đi lang thang ngoài đường chứ đách có chôn luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491099
    m_Localized: 'FormerFema: Uổng công cả đám thất nghiệp vì bả.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491100
    m_Localized: Lũ áo vàng mấy người đúng là khốn nạn mạt kiếp
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491101
    m_Localized: Đen thôi, đỏ quên đi
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491102
    m_Localized: 'FormerFema: Cái gì?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491103
    m_Localized: 'FormerFema: Mắc gì đi chửi tôi?! Trong khi tôi chăm chỉ thi hành nhiệm vụ, xong bị đuổi vì một bà dẩm lồn...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491104
    m_Localized: 'FormerFema: Vậy mà anh lại chửi tụi tôi là đồ khốn nạn?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491105
    m_Localized: 'FormerFema: Thôi đụ mẹ anh luôn nhá. Tôi biến đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491106
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491107
    m_Localized: 'FormerFema: Quỷ thần ơi, thiên hạ mất trí hết rồi hay sao vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491108
    m_Localized: 'FormerFema: Đen đỏ gì ở đây. Tôi nói thiệt chứ phải giỡn đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491109
    m_Localized: 'FormerFema: Từ lúc mặt trời nóng lên rồi thêm đám Dị Khách này, đầu óc ai cũng mát mát hết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491110
    m_Localized: 'FormerFema: Rồi cái xác xàm chó đó có đáng đổi lấy công việc của tụi tôi không?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491111
    m_Localized: Cũng mừng là chị đấy được đoàn tụ với chồng
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491112
    m_Localized: Lẽ ra anh không nên trả lại cái xác
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491113
    m_Localized: 'FormerFema: Mừng gì mà mừng? Tụi tôi bị mất việc thì vui cái nỗi gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491114
    m_Localized: 'FormerFema: Đám dân mấy người đúng là đách hiểu gì hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491115
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491116
    m_Localized: 'FormerFema: Biết vậy nã một phát vào đầu con mẹ đó như thằng chồng nó cho rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491117
    m_Localized: Anh mới nói gì cơ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491118
    m_Localized: (Rút súng ra)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491119
    m_Localized: 'FormerFema: Có gì mà bất ngờ vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491120
    m_Localized: 'FormerFema: Theo quy định, trong trường hợp người bị cách ly có chuyển biến xấu...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491121
    m_Localized: 'FormerFema: ...Thì chúng tôi được quyền xử lý ngay lập tức, để đảm bảo không có Dị Khách trong khu vực cách ly mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491122
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491123
    m_Localized: (Rút súng ra)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491124
    m_Localized: 'FormerFema: Cám ơn anh đã hiểu cho.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491125
    m_Localized: 'FormerFema: Tôi đâu phải sát nhân, lệnh đưa xuống sao thì tôi y vậy mà làm thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491126
    m_Localized: 'FormerFema: Ê ê, anh làm cái trò gì đó?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491127
    m_Localized: 'FormerFema: Bình tĩnh coi, cha đó là Dị Khách mà! Còn chả ra người ra ngợm gì nữa. Làm sao tụi tôi thả thằng chả đi được.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491128
    m_Localized: 'FormerFema: Đừng bắn! Tôi chỉ nghe lệnh cấp trên thôi mà!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491129
    m_Localized: 'FormerFema: Ờ anh nói chí phải. Đáng ra nên làm theo quy định mới đúng.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491130
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491131
    m_Localized: 'FormerFema: Thôi, tôi hông nói nhiều làm phiền anh nữa. Cám ơn anh đã cho tôi trú nhờ, dù biết tôi là người của bên Phòng Chống.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491132
    m_Localized: 'FormerFema: Nếu được quay lại làm việc, tôi chắc chắn sẽ ghi nhận sự hợp tác của anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609476
    m_Localized: 'Intruder: Chẳng biết Dị Khách có mơ không nhỉ...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609477
    m_Localized: Anh có ngủ được chút nào chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609478
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609479
    m_Localized: 'Intruder: Hả? À, tôi cũng có cố ngủ lắm đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609480
    m_Localized: 'Intruder: Chỉ mong sao trong nhà này có người còn nằm mơ thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609481
    m_Localized: 'Intruder: Cơ mà... chưa thấy ai chịu chia sẻ giấc mơ với tôi hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609482
    m_Localized: 'Intruder: Hay tại tôi nhìn không đáng tin?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609483
    m_Localized: 'Intruder: Hy vọng sau này họ sẽ chịu mở lòng hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609484
    m_Localized: 'Intruder: Chẳng biết Dị Khách có mơ không nhỉ...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609485
    m_Localized: Mơ thì có gì mà anh cứ chấp niệm với nó thế?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609486
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609487
    m_Localized: 'Intruder: Ai bảo tôi có chấp niệm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609488
    m_Localized: 'Intruder: Anh suy luận kiểu gì kỳ khôi thế.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609489
    m_Localized: 'Intruder: Bộ anh không tò mò muốn biết tiềm thức của mình đang truyền tải thông điệp gì à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609490
    m_Localized: 'Intruder: Điều gì đang ẩn giấu trong trí óc của ta? Ai ai cũng có những bí mật mà chính họ chẳng hề hay biết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609491
    m_Localized: 'Intruder: Ví như anh chẳng hạn. Anh tránh tiếp xúc với người khác vì từng bị ai đó làm tổn thương nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609492
    m_Localized: 'Intruder: Chính vì vậy nên tôi mới thấy chuyện này lý thú.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609493
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609494
    m_Localized: 'Intruder: Hay là như này. Để tôi kể cho anh nghe về lần cuối tôi nằm mơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609495
    m_Localized: 'Intruder: Trong mơ, tôi thấy một đoàn tàu đen ngòm, lớn thật lớn đang dí theo mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609496
    m_Localized: 'Intruder: Chân tôi thì bị vùi chặt xuống đất. Tôi chợt hét toáng lên rồi choàng tỉnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609497
    m_Localized: 'Intruder: Nhưng lạ thật, chính tôi cũng là người lái tàu. Cứ thế mà đâm thẳng vào bản thân, không sao dừng lại được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609498
    m_Localized: 'Intruder: Chẳng biết Dị Khách có mơ không nhỉ...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609499
    m_Localized: Thế còn anh? Anh giấu gì trong giấc mơ của mình đó?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609500
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609501
    m_Localized: 'Intruder: Tôi ấy à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609502
    m_Localized: 'Intruder: Đã bao ngày rồi tôi có hề chợp mắt đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609503
    m_Localized: 'Intruder: Nhưng kệ đi, để tôi bật mí cho anh một bí mật. Đằng nào cũng chẳng ai thèm tin đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609504
    m_Localized: 'Intruder: Tôi có thể QUAN SÁT giấc mơ của người khác. Cũng... vi diệu lắm anh ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609505
    m_Localized: 'Intruder: Chẳng biết làm kiểu gì mà được nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609506
    m_Localized: 'Intruder: Nhưng từ hồi thảm họa bùng phát, những giấc mơ... tự dưng im lìm hẳn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609507
    m_Localized: 'Intruder: Như thể ai cũng đang nín thở vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609508
    m_Localized: 'Intruder: Còn tôi thì mất ngủ luôn tới giờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609509
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609510
    m_Localized: 'Intruder: Liệu... tôi đang nói thật? Hay cố tình nói nhảm làm anh rối trí đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609511
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609512
    m_Localized: Anh là ai vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609513
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609514
    m_Localized: 'Cultist1: Một linh hồn lạc lối. Như bao kẻ khác tồn tại nơi trần thế mục rữa này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609515
    m_Localized: 'Cultist1: Chúng tôi cầu khát sự tĩnh lặng... sự an nghỉ vĩnh hằng. Và rồi chúng tôi tìm được con đường đến bên Ngài...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609516
    m_Localized: 'Cultist1: ...Đức Mẹ Tử Thần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609517
    m_Localized: 'Cultist1: Cớ sao mọi người lại run sợ Ngài nhỉ? Có phải vì họ hãi sợ điều mình chưa thấu? Hay vì giáo điều xuyên tạc Tử Thần đã hằn sâu vào tận linh hồn?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609518
    m_Localized: 'Cultist1: Suốt hàng thiên niên kỷ, chúng ta làm mọi cách để vén màn bí mật, lần tìm ý nghĩa cuộc sống. Vậy mà hỡi ôi! Câu trả lời lại quá đỗi giản đơn...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609519
    m_Localized: 'Cultist1: Phụng thờ Tử Thần là lẽ sống của chúng tôi. Và chúng tôi là con chiên ngoan đạo của Ngài.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609520
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609521
    m_Localized: "Sao anh lại đi tôn thờ \ncái chết?"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609522
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609523
    m_Localized: "Cultist1: Vì Tử Thần chính là hiện thân \ncủa từ bi."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609524
    m_Localized: 'Cultist1: Ngài khiến muôn người hãi sợ, nhưng liệu xúc cảm này có chính đáng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609525
    m_Localized: 'Cultist1: Anh thử nghĩ xem... Thế giới này chẳng phải chốn thiên đường, mà là lò luyện ngục nhục hình chúng ta. Có một câu hỏi luôn cháy âm ỉ: Vì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609526
    m_Localized: 'Cultist1: Vì sao ta phải hứng chịu biết bao nỗi đớn đau, lo sợ, thống khổ... Chẳng lẽ con người không đáng được hưởng chút bình yên?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609527
    m_Localized: 'Cultist1: Sự chết chính là cõi thiên đường mà chúng ta không tài nào hiểu thấu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609528
    m_Localized: 'Cultist1: Tôn giáo tìm cách tô vẽ hình ảnh Thiên Đàng để xoa dịu khổ đau của nhân loại. Nhưng liệu đời có bao giờ đơn giản như thế?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609529
    m_Localized: 'Cultist1: Cũng giống như Tử Thần vậy. Anh chỉ có thể thấu hiểu tấm lòng Ngài khi đã cảm nhận hơi ấm từ chính vòng tay Ngài.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609530
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609531
    m_Localized: Rồi sao mấy người lại chọn nhà tôi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609532
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609533
    m_Localized: 'Cultist1: Vì nhà anh gắn kết sâu đậm với Tử Thần hơn bất kỳ nơi nào khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609534
    m_Localized: 'Cultist1: Lúc đầu tôi cũng không hiểu tại sao thầy của chúng tôi lại chọn nơi này. Nhưng giờ thì tôi đã tỏ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609535
    m_Localized: 'Cultist1: Dư vị của sự chết vương khắp bốn bề, vô hình mà ngột ngạt, như muốn bóp nghẹt cả tâm hồn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609536
    m_Localized: 'Cultist1: Những mảng bê tông trần trụi thì ám đầy mùi tanh của máu tươi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609537
    m_Localized: 'Cultist1: Nói thế chứ đừng nghĩ bọn tôi buộc anh phải giết người. Tự tay anh bóp cò, không cần chúng tôi thúc ép.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609538
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609539
    m_Localized: 'Cultist1: Tôi tin là mối liên hệ giữa anh và Tử Thần còn khắng khít hơn của chúng tôi với Ngài nữa đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609540
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609541
    m_Localized: Mấy người đốt lửa trại ở bên ngoài làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609542
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609543
    m_Localized: 'Cultist1: Thời khắc định mệnh đã đến.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609544
    m_Localized: 'Cultist1: Các thiên thần từ lòng đất sâu thẳm sẽ nhận lấy tro tàn của chúng tôi làm lễ vật, rồi mở lối để chúng tôi tiến vào lãnh địa Tử Thần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609545
    m_Localized: 'Cultist1: Đó là cách chúng tôi được Ngài ban ân sủng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609546
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609547
    m_Localized: Trông anh run hết cả người. Anh sợ à?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609548
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609549
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609550
    m_Localized: 'Cultist2: Đôi mắt anh cũng khá tinh tường đấy, Anh Chủ Nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609551
    m_Localized: "Cultist2: Chẳng giống như những người anh em tín hữu... Tôi vẫn còn rất nhiều \nnỗi sợ chưa thể vượt qua."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609552
    m_Localized: 'Cultist2: Cảm giác nghi ngại giằng xé tôi: Thế giới bên kia ẩn chứa điều gì? Đến nơi rồi cảm giác sẽ ra sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609553
    m_Localized: 'Cultist2: Thầy răn dạy chúng tôi rằng nơi đó không phải Thiên Đường hay Địa Ngục, mà là một cõi riêng. Nhưng tôi vẫn còn mông lung lắm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609554
    m_Localized: 'Cultist2: Chính thầy cũng không hoàn toàn hiểu rõ về Tử Thần, thì sao mà chúng tôi có thể thấu tỏ Ngài?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609555
    m_Localized: 'Cultist2: Biết đâu gặp Ngài thôi vẫn chưa đủ? Lỡ đâu Ngài thật sự nằm ngoài tầm hiểu biết của chúng ta...?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609556
    m_Localized: 'Cultist2: Tôi nào dám nghi ngờ ý nguyện của thầy. Vì mỗi khi soi vào mắt thầy, tôi lại thấy ở đó đong đầy lòng tự tin và sự thấu suốt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609557
    m_Localized: 'Cultist2: Thầy bảo chúng tôi phải mở lòng tin tưởng và giữ vững quyết tâm. Phải luôn sẵn sàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609558
    m_Localized: 'Cultist2: Vì khi đó, chúng tôi mới có thể băng qua những dòng sông chết chóc, vượt bao ngọn núi ngàn xương để đến bên Ngài...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609559
    m_Localized: 'Cultist2: ...Đức Mẹ Tử Thần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609560
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609561
    m_Localized: Sao anh lại đi tôn thờ cái chết?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609562
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609563
    m_Localized: 'Cultist2: Nào, chủ nhà đáng kính, tôi mong anh không có ý khinh mạn Tử Thần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609564
    m_Localized: 'Cultist2: Vì Ngài vốn căm ghét những kẻ báng bổ, dám cho Ngài là bất công. Và rồi Ngài sẽ giáng đòn trừng phạt tàn bạo nhất lên đầu chúng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609565
    m_Localized: 'Cultist2: Bản chất của Tử Thần làm tôi khiếp sợ, nhưng thầy vẫn luôn dạy rằng Ngài chính là vị thần nhân hậu nhất.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803584
    m_Localized: 'Cultist2: Ngài không gieo rắc nạn đói, bệnh tật hay chiến tranh. Ngài chỉ đơn thuần ban cho chúng ta... sự an nghỉ đời đời.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803585
    m_Localized: 'Cultist2: Và chúng ta cần phải diện kiến Ngài.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803586
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803587
    m_Localized: Sao anh cứ phải đâm đầu tìm đến cái chết vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803588
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803589
    m_Localized: 'Cultist2: Hành trình này không phải do chúng tôi tự quyết. Mà đây là ý muốn của Tử Thần.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803590
    m_Localized: 'Cultist2: Ngài kêu gọi, mong chờ hết thảy chúng tôi đến với lãnh địa của Ngài.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803591
    m_Localized: 'Cultist2: Thầy của chúng tôi nói lý do mặt trời cháy rực như thế, một phần là để tống tiễn chúng ta ra khỏi mặt đất này.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803592
    m_Localized: 'Cultist2: Tử Thần mang đến sự tĩnh lặng, bình yên, hợp nhất. Và miền đất hứa của Ngài sẽ là nơi chúng ta đoàn tụ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803593
    m_Localized: "Cultist2: Chúng ta khóc than vô ích cho những người đã ra đi, mà quên mất rồi một ngày nào đó ta sẽ có dịp hội ngộ \nvới họ."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803594
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803595
    m_Localized: Thế anh định làm gì đây?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803596
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803597
    m_Localized: 'Cultist2: Thời khắc đã đến...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803598
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803599
    m_Localized: 'Cultist2: T-Tôi sợ lắm. Người tôi cứ run rẩy không ngừng... Nhưng tôi phải cứng rắn lên, phải giữ vững đức tin của mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803600
    m_Localized: 'Cultist2: Thầy đã đặt niềm tin nơi tôi. Tôi không thể nào phụ lòng thầy được.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803601
    m_Localized: 'Cultist2: Nhưng nỗi sợ... Nỗi sợ vẫn còn gặm nhấm tâm trí tôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803602
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803603
    m_Localized: 'Cultist2: Thả chúng tôi ra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803604
    m_Localized: 'Cultist2: Thả chúng tôi ra. THẢ RA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803605
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803606
    m_Localized: "Mấy người định ở lại tới \nkhi nào?"
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803607
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803608
    m_Localized: 'Cultist3: Chớ lo quá, Anh Chủ Nhà thân mến. Chúng tôi sẽ không làm phiền anh đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803609
    m_Localized: 'Cultist3: Chúng tôi biết ơn lòng hiếu khách của anh và không có ý làm anh tức giận. Anh cũng đã giúp đỡ bọn tôi rất nhiều rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803610
    m_Localized: 'Cultist3: Ba người bọn tôi sẽ ở yên trong phòng này, và im lặng cầu nguyện.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803611
    m_Localized: "Cultist3: Chúng tôi cần ngơi nghỉ. Vì hành trình trước mắt vẫn còn dài và lắm \nchông gai."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803612
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803613
    m_Localized: Mấy anh muốn đi đến đâu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803614
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803615
    m_Localized: 'Cultist3: Đến vùng đất của Dân Ngoại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803616
    m_Localized: 'Cultist3: Đời người không tồn tại vĩnh cửu. Chúng ta chỉ là khách trọ trên thế gian này. Ta đến, rồi đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803617
    m_Localized: 'Cultist3: Sau đó, các Dân Ngoại phải chiếm lấy nơi này. Cư ngụ tại đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803618
    m_Localized: 'Cultist3: Sự xuất hiện của họ nào phải ngẫu nhiên. Họ được triệu hồi đến đây, bằng chính tiếng gọi đã xua chúng ta đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803619
    m_Localized: 'Cultist3: Đích thân Tử Thần đã gọi họ đến...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803620
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803621
    m_Localized: Sao anh lại nghĩ Dị Khách là do tử thần triệu hồi tới?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803622
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803623
    m_Localized: "Cultist3: Vì Tử Thần không phân biệt ai cả – bất kể con người, quái vật, hay \nDân Ngoại..."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803624
    m_Localized: 'Cultist3: Trong mắt Tử Thần, chúng sinh bình đẳng. Và ai ai cũng được Ngài đối xử như nhau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803625
    m_Localized: 'Cultist3: Ngài đã chờ đợi thời khắc chín muồi. Giờ đây, giây phút ấy đang cận kề chúng ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803626
    m_Localized: "Cultist3: Chúng tôi phải chuẩn bị cử hành \nnghi lễ..."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803627
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803628
    m_Localized: Thế các anh tính thực hiện nghi lễ gì?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803629
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803630
    m_Localized: 'Cultist3: Đã đến lúc chúng tôi sang cõi bên kia, về lại mái nhà êm ấm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803631
    m_Localized: 'Cultist3: Chúng tôi phải đến gặp Tử Thần, nơi miền đất của sự an yên và thanh bình vĩnh cửu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803632
    m_Localized: 'Cultist3: Đến giờ phải đi rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803633
    m_Localized: 'FatalDame: Sao đó cưng? Đang nghĩ ngợi chuyện gì à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803634
    m_Localized: Chị ở đây có thích không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803635
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803636
    m_Localized: 'FatalDame: Chị thấy cũng ấm cúng. Vậy là tốt hơn so với kỳ vọng rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803637
    m_Localized: 'FatalDame: Cảm ơn bé cưng đã cho chị ở nhờ nhé. Cứ ngỡ chị phải ăn bờ ngủ bụi trước lúc trời sáng rồi chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803638
    m_Localized: 'FatalDame: Còn cưng thì sao? Cưng thấy như nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803639
    m_Localized: Thấy trong lòng cứ lo lo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803640
    m_Localized: Vẫn ổn. Sống được là hay rồi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803641
    m_Localized: 'FatalDame: Ừ, chị hiểu mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803642
    m_Localized: 'FatalDame: Thời buổi này sống nay chết mai... có tính xa cũng chẳng để làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803643
    m_Localized: 'FatalDame: Ai mà biết được cái chết sẽ ập đến từ đâu. Mặt trời, bọn Dị Khách, hay mấy kẻ khùng khùng điên điên?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803644
    m_Localized: 'FatalDame: Nhưng dù gì nhân loại chúng ta cũng đã sống sót qua bao nhiêu là thảm họa rồi mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803645
    m_Localized: 'FatalDame: Ngay cả khi con người tuyệt diệt, ta vẫn sẽ để lại di sản dài lâu thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803646
    m_Localized: 'FatalDame: Rồi sẽ có kẻ khác tìm thấy tàn tích của chúng ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803647
    m_Localized: 'FatalDame: Nên mọi chuyện sẽ ổn thôi, cưng à.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803648
    m_Localized: 'FatalDame: Chị thích tinh thần của cưng đấy. Khá là hợp với cưng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803649
    m_Localized: 'FatalDame: Nhưng đừng để cái gì cũng giữ kín trong lòng nhé. Khéo có ngày lại tức nước vỡ bờ, cảm xúc là vậy đấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803650
    m_Localized: 'FatalDame: Mà lại ngay lúc không cần nhất mới chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803651
    m_Localized: 'FatalDame: Thi thoảng cứ thủ thỉ tâm sự với chị nhé. Đừng ngại.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803652
    m_Localized: 'FatalDame: Không phải chị thì ai khác cũng được. Miễn là em chịu kiếm người để trò chuyện.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803653
    m_Localized: 'FatalDame: Ít nhất hãy hứa với chị điều này. Được không cưng?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803654
    m_Localized: 'FatalDame: Sao đó cưng? Đang nghĩ ngợi chuyện gì à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803655
    m_Localized: Đêm qua tôi để ý có điều này khác lạ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803656
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803657
    m_Localized: 'FatalDame: Thế à? Cái gì lạ thế hở cưng?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803658
    m_Localized: Bụng của chị ấy. Trông to hơn thì phải
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803659
    m_Localized: Thôi không có gì... Chắc do tôi quáng gà
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803660
    m_Localized: 'FatalDame: Ý cưng là... như kiểu chị đang có bầu ấy hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803661
    m_Localized: 'FatalDame: Ơ hơ, không sao đâu mà cưng. Cưng chịu thẳng thắn thật tình với chị vậy là chị vui rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803662
    m_Localized: 'FatalDame: Chắc vì cưng đang stress, chịu nhiều áp lực quá. Còn phải trông nom biết bao nhiêu người nữa cơ mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803663
    m_Localized: 'FatalDame: Chị hiểu lắm bé cưng à. Đang trong giai đoạn không biết sống chết lúc nào, lo cho thân mình thôi đã khó, huống chi là người khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803664
    m_Localized: 'FatalDame: Ai biết được lúc bình minh ló rạng, mình có còn tồn tại trên cõi đời này không.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803665
    m_Localized: Ừ... Tôi sợ lắm
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803666
    m_Localized: Ý tôi không phải vậy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803667
    m_Localized: 'FatalDame: Vậy là cưng đang lo chuyện gì đó à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803668
    m_Localized: 'FatalDame: Không sao đâu cưng à. Nỗi sợ thường làm ta kiệt quệ, ai cũng vậy hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803669
    m_Localized: 'FatalDame: Chị để ý cưng rồi. Khuya nào cưng cũng thức dậy để đi một vòng kiểm tra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803670
    m_Localized: 'FatalDame: Ngoài mặt thì e dè kín đáo vậy thôi, chứ trong lòng cưng quan tâm đến những người sống chung với mình lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803671
    m_Localized: 'FatalDame: Cũng... thú vị thật. Con người cưng là cả một nghịch lý.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803672
    m_Localized: 'FatalDame: Mà cũng có thể do cưng mất ngủ thôi. Nỗi sợ dễ làm ta thao thức đêm ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803673
    m_Localized: Ừ... Tôi sợ lắm
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803674
    m_Localized: Ý tôi không phải vậy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803675
    m_Localized: 'FatalDame: Cưng phải can đảm lắm mới dám thừa nhận như vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803676
    m_Localized: 'FatalDame: Nhưng biết làm gì cho nguôi nỗi sợ đây, cưng nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803677
    m_Localized: 'FatalDame: Liệu cưng có thể chấp nhận sự thật rằng... cuộc đời này là hữu hạn? Ai rồi cũng đến lúc phải ra đi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803678
    m_Localized: 'FatalDame: Quan trọng là tìm đâu ra được ánh sáng cứu rỗi cho mình. Liệu nó có còn tồn tại nữa hay không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803679
    m_Localized: 'FatalDame: À, vậy thì thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803680
    m_Localized: 'FatalDame: Mà nói gì thì nói... chị vẫn lo cho cưng lắm đó. Nhớ chăm sóc cho bản thân mình nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803681
    m_Localized: 'FatalDame: Chị chỉ mong sao cưng cảm thấy an tâm. Vì chúng ta cùng chung sống dưới một mái nhà kia mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803682
    m_Localized: 'FatalDame: Nếu chẳng may cưng "chập mạch", thì cả cái nhà này cũng "tắt điện" theo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803683
    m_Localized: 'FatalDame: ...Chị nói chơi vậy thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803684
    m_Localized: 'FatalDame: Mà nghe cũng có chút hài đó chứ, cưng nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803685
    m_Localized: 'FatalDame: Sao đó cưng? Đang nghĩ ngợi chuyện gì à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803686
    m_Localized: Đêm qua tôi thấy chị mang bầu rõ ràng. Rốt cuộc là sao đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803687
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803688
    m_Localized: 'FatalDame: Nè, cưng đang làm chị hoảng đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803689
    m_Localized: 'FatalDame: Cưng có chắc đêm qua đã thấy vậy thật không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803690
    m_Localized: 'FatalDame: Thế sao cưng không gọi chị dậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803691
    m_Localized: 'FatalDame: Cưng sợ chết quá nên nói bừa à? Hay đang thấm thía trách nhiệm chăm nom người khác đè nặng trên vai?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803692
    m_Localized: 'FatalDame: Có phải do chị không nhỉ...? Hay có bóng hình ai khác đang ám ảnh tâm trí cưng?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803693
    m_Localized: Chị đừng có bày trò làm tôi rối trí
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803694
    m_Localized: Nhưng... rõ ràng tôi có thấy mà
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803695
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803696
    m_Localized: 'FatalDame: Hôm trước, cưng có nhắc đến cha mình với chị.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803697
    m_Localized: 'FatalDame: Sau đó cưng cũng không đả động gì nữa, nên chị không nắm rõ chi tiết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803698
    m_Localized: 'FatalDame: Nhưng bây giờ... không hiểu sao chị có cảm giác tính cưng giống cha lắm. Giống y như đúc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803699
    m_Localized: 'FatalDame: Cưng có sợ điều đó không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803700
    m_Localized: 'FatalDame: Sợ suốt đời phải lu mờ dưới cái bóng của ông ấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803701
    m_Localized: 'FatalDame: Cha đã chết trong tâm cưng rồi mà, không phải sao? Hà cớ gì cứ níu giữ một bóng hình đã khuất?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803702
    m_Localized: 'FatalDame: Ở thế giới bên kia, cưng cũng không phải gặp lại ông ấy đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803703
    m_Localized: 'FatalDame: Hai cha con vốn không cùng điểm đến, nên không cần lo lắng làm gì, cưng à.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803704
    m_Localized: 'FatalDame: Đừng gắng sức cùng lúc kiếm tìm mọi câu trả lời. Để xây đường thì ta phải đắp từng viên gạch một. Cưng hiểu ý chị chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803705
    m_Localized: 'FatalDame: Và cũng... đừng bao giờ nói chuyện với chị kiểu đó nữa nhé cưng.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803706
    m_Localized: 'FatalDame: Thấy cưng trong bộ dạng này, chị đau lòng lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803707
    m_Localized: 'FatalDame: Cưng không cần lo sợ cái chết, trách nhiệm, sự thân mật hay bất cứ điều gì khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803708
    m_Localized: 'FatalDame: Tất cả đều là một phần của cuộc sống mà, cưng ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803709
    m_Localized: 'FatalDame: Đừng gắng sức kiếm tìm mọi câu trả lời cùng lúc. Để xây đường thì ta phải đắp từng viên gạch một. Cưng hiểu ý chị chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803710
    m_Localized: 'FatalDame: Có thể khi chết đi, chúng ta cũng không tan biến hoàn toàn đâu. Cưng cứ thử nghĩ theo hướng đó đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803711
    m_Localized: 'FatalDame: Hồi xưa chị còn tin là có thiên đường và địa ngục. Nhưng giờ chị cũng chẳng biết nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803712
    m_Localized: 'FatalDame: Biết đâu thứ chờ đợi mình lại là một cõi gì đó khác hẳn.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803713
    m_Localized: 'FatalDame: Cưng nghĩ sao nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803714
    m_Localized: 'FatalDame: Sao đó cưng? Đang nghĩ ngợi chuyện gì à?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803715
    m_Localized: Chị đang mang thai và sắp sinh rồi, đúng không?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803716
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803717
    m_Localized: 'FatalDame: Ơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803718
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803719
    m_Localized: 'FatalDame: Nỗi tuyệt vọng đã chi phối cưng hoàn toàn rồi nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803720
    m_Localized: 'FatalDame: Mọi điều cưng tin tưởng đều đang sụp đổ trước mắt... mà cưng thì bất lực, không cam tâm chấp nhận.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803721
    m_Localized: 'FatalDame: Có phải vì cưng nhất quyết không muốn đi đến kết cục tất yếu đang chờ đợi chúng ta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803722
    m_Localized: 'FatalDame: Hay do cưng không còn là người của thế giới này nữa? Của thế giới nào nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803723
    m_Localized: Đừng đánh trống lảng. Chị đang có thai
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803724
    m_Localized: Chị không thấy sợ sao?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803725
    m_Localized: 'FatalDame: Cưng ơi cưng à... Sao mà có chuyện đó được? Cưng nhìn đi, bụng chị còn không to ra tí nào nữa là.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803726
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803727
    m_Localized: 'FatalDame: Chị hỏi cưng điều này có được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803728
    m_Localized: 'FatalDame: Giả sử đứa trẻ này là có thật...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803729
    m_Localized: 'FatalDame: Và cứ cho rằng nó sắp sửa chào đời, đúng như cưng nói đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803730
    m_Localized: 'FatalDame: Thì cưng tính làm gì đây? Cố tìm nó sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803731
    m_Localized: Nó đáng lẽ không nên tồn tại
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803732
    m_Localized: Tôi cũng chưa biết nữa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803733
    m_Localized: 'FatalDame: Hừm. Một câu hỏi thú vị.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803734
    m_Localized: 'FatalDame: Đương nhiên là chị sợ chết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803735
    m_Localized: 'FatalDame: Chủ yếu vì chị cũng không biết chắc điều gì chờ đợi sau đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803736
    m_Localized: 'FatalDame: Là thiên đường, đầu thai, hay thứ gì khác hẳn?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803737
    m_Localized: 'FatalDame: Chịu thôi, làm gì có ai đã sống sót quay về để kể cho chúng ta biết.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803738
    m_Localized: 'FatalDame: Nhưng điềm báo mà cưng thấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803739
    m_Localized: 'FatalDame: Giả sử đứa trẻ này là có thật...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803740
    m_Localized: 'FatalDame: Và cứ cho rằng nó sắp sửa chào đời, đúng như cưng nói đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803741
    m_Localized: 'FatalDame: Thì cưng tính làm gì đây? Cố tìm nó sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803742
    m_Localized: Nó đáng lẽ không nên tồn tại
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803743
    m_Localized: Tôi cũng chưa biết nữa
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803744
    m_Localized: 'FatalDame: Đôi khi bản năng mách bảo ta hãy lưu giữ những điều thân thuộc... dù nó không còn có ích gì cho ta nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803745
    m_Localized: 'FatalDame: Phải chăng...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803746
    m_Localized: 'FatalDame: Phải chăng đã đến lúc cưng mở lòng đón nhận những điều mới mẻ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803747
    m_Localized: 'FatalDame: Chẳng lẽ cưng lo sợ thứ ngoài tầm hiểu biết đến vậy sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803748
    m_Localized: Tôi sẽ đi tìm đứa trẻ đó
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803749
    m_Localized: Nó sắp chào đời rồi. Tôi biết chắc như vậy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803750
    m_Localized: 'FatalDame: Cưng đừng sợ, sẽ có lúc ta phải chấp nhận buông bỏ. Nhất là khi thứ đó không còn có ích gì cho ta nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803751
    m_Localized: 'FatalDame: Đôi khi chúng ta cố chấp níu giữ một thứ chỉ vì nó quá đỗi thân thuộc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803752
    m_Localized: 'FatalDame: Ừ đúng, từ bỏ thói quen chẳng dễ dàng chút nào... Nhưng phải thử mới biết kết quả ra sao chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803753
    m_Localized: Tôi sẽ đi tìm đứa trẻ đó
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803754
    m_Localized: Nó sắp chào đời rồi. Tôi biết chắc như vậy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803755
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803756
    m_Localized: 'FatalDame: Cưng đã nói vậy thì thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803757
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803758
    m_Localized: 'FatalDame: Khi thời khắc đó xảy đến... hãy cho chị biết cưng tìm thấy điều gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713856
    m_Localized: 'Neighbour: Ừ, có vậy thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713857
    m_Localized: 'Neighbour: Ấy, xém chút bác quên.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713858
    m_Localized: 'Neighbour: Tối mai bác phải về rồi. Con ghi lại số bác nha, người ta vừa mới lắp đặt xong đường dây điện thoại.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713859
    m_Localized: 'Neighbour: {0}. Rồi, có gì mình giữ liên lạc nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713860
    m_Localized: 'Neighbour: Giờ là xong hết thiệt rồi đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713861
    m_Localized: 'Neighbour: Làm lon bia rồi đi ngủ thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491133
    m_Localized: 'Cat: Méo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491134
    m_Localized: Nựng mèo
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491135
    m_Localized: Bế mèo
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491136
    m_Localized: Cho mèo ăn đồ hộp
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491137
    m_Localized: 'Cat: (Bạn chìa tay ra vuốt ve con mèo)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491138
    m_Localized: 'Cat: (Chẳng biết là nó có thích hay không nữa)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491139
    m_Localized: 'Cat: Méo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491140
    m_Localized: Nựng mèo
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491141
    m_Localized: Bế mèo
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491142
    m_Localized: Cho mèo ăn đồ hộp
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491143
    m_Localized: 'Cat: (Bạn vuốt ve con mèo)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491144
    m_Localized: 'Cat: (Trông nó có vẻ thích thú lắm)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491145
    m_Localized: 'Cat: (Xem chừng nó đã bớt quạu hơn trước)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491146
    m_Localized: 'Cat: (Chắc là mèo ta đang dần quen với bạn rồi)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491147
    m_Localized: 'Cat: Méo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491148
    m_Localized: Nựng mèo
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491149
    m_Localized: Bế mèo
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491150
    m_Localized: Cho mèo ăn đồ hộp
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491151
    m_Localized: 'Cat: (Được nựng thường xuyên thế này nó thích lắm)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491152
    m_Localized: 'Cat: (Có vẻ mèo ta còn dụi dụi vào tay bạn nữa)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491153
    m_Localized: 'Cat: (Nỡ nào lại đi từ chối bé yêu này được cơ chứ?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491154
    m_Localized: 'Cat: Meo! MÉO! Mèo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491155
    m_Localized: 'Cat: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491156
    m_Localized: 'Cat: (Nhìn mặt thì chẳng biết nó đang nghĩ gì, nhưng chắc là đang vui lắm)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491157
    m_Localized: 'Cat: (Bỗng dưng bạn có linh cảm rằng, tối nay mình sẽ ngủ yên giấc đây)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491158
    m_Localized: 'Cat: (Cứ như thể bạn thú bốn chân này vừa độ vài mạng cho bạn, thay lời cảm ơn vậy)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491159
    m_Localized: 'Cat: (Biết đâu được... Có khi đêm nay thần chết sẽ lướt qua nhà bạn đấy)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547465932800
    m_Localized: 'Teacher: Tội nghiệp tụi nhỏ quá đi mất...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292928
    m_Localized: Có chuyện gì hả cô?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292929
    m_Localized: Em cần kiểm tra cô
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292930
    m_Localized: 'Teacher: Hả? Sao em?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292931
    m_Localized: 'Teacher: À, cô... cô đang nghĩ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292932
    m_Localized: 'Teacher: Nếu như đây không phải là sự kiện đại tuyệt chủng, và nhân loại vẫn sống tiếp... thì chuyện gì sẽ xảy ra sau khi thảm họa chấm dứt?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292933
    m_Localized: 'Teacher: Liệu có còn tương lai nào cho chúng ta hay không?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292934
    m_Localized: Cô sợ mình không có chốn nương thân ở thế giới mới à?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292935
    m_Localized: Giờ mấy người nhân hậu toàn chết sớm. Cô nên sát cánh cùng ai đó cho an tâm
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292936
    m_Localized: 'Teacher: Người nhân hậu à...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292937
    m_Localized: 'Teacher: Cô không tài nào chịu nổi cảnh bạo lực... huống chi là đi bắn giết ai. Cô không dám xuống tay đâu em à.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292938
    m_Localized: 'Teacher: Chẳng biết cô sẽ sinh sống ra sao trong cái mà em gọi là... "thế giới mới" ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292939
    m_Localized: Vậy giờ cô muốn nằm yên chờ chết hay sao?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292940
    m_Localized: Cô nghĩ còn cách nào khác không?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292941
    m_Localized: Nhân loại đã trải qua nhiều thời kỳ tăm tối rồi... Có gì mới đâu cô
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292942
    m_Localized: 'Teacher: Kể cả khi có người trông chừng bảo vệ cô thì cô cũng không muốn...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292943
    m_Localized: 'Teacher: Con người vẫn sẽ tiếp tục chém giết. Vòng xoáy bạo lực không bao giờ chấm dứt đâu em.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292944
    m_Localized: Vậy giờ cô muốn nằm yên chờ chết hay sao?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292945
    m_Localized: Cô nghĩ còn cách nào khác không?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292946
    m_Localized: Nhân loại đã trải qua nhiều thời kỳ tăm tối rồi... Có gì mới đâu cô
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292947
    m_Localized: 'Teacher: Cô cảm thấy hoang mang quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292948
    m_Localized: 'Teacher: Từ giờ trở đi, chúng ta sẽ phải chung sống cùng những kẻ sát nhân thật sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292949
    m_Localized: 'Teacher: Rồi lũ sát nhân và đám tàn bạo sẽ là người nuôi dạy thế hệ mầm non mai sau hay sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292950
    m_Localized: Chẳng còn thời gian để mà than khóc đâu
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292951
    m_Localized: CÔ BÌNH TĨNH LẠI ĐI NÀO!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292952
    m_Localized: 'Teacher: Cô... không biết nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292953
    m_Localized: 'Teacher: Cô chẳng còn gì để đóng góp cho đời.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292954
    m_Localized: 'Teacher: Chỉ muốn cơn ác mộng này... chấm dứt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292955
    m_Localized: 'Teacher: Cô... Cô không thể sống tiếp nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292956
    m_Localized: 'Teacher: Ừ, em nói không sai. Nhưng...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292957
    m_Localized: 'Teacher: Từ giờ trở đi... chúng ta sẽ sống tiếp như thế nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292958
    m_Localized: 'Teacher: Nhân loại đảo điên quá rồi, sẵn sàng giết hại bất kỳ ai có vẻ khác biệt... dù chỉ một chút.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292959
    m_Localized: 'Teacher: Họ chẳng cần biết ai cản đường mình. Cứ thế mà giết không nương tay.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292960
    m_Localized: Chẳng còn thời gian để mà than khóc đâu
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292961
    m_Localized: CÔ BÌNH TĨNH LẠI ĐI NÀO!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292962
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292963
    m_Localized: 'Teacher: Sao lại không còn?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292964
    m_Localized: 'Teacher: Có thể em thì quen được với chuyện này bằng thái độ vô cảm, lãnh đạm. Nhưng còn cô thì không.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292965
    m_Localized: 'Teacher: Phải chi em nhìn thấy được những gì cô đã chứng kiến.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292966
    m_Localized: 'Teacher: Từng giây từng phút... đều vĩnh viễn hằn sâu vào đôi mắt cô.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292967
    m_Localized: 'Teacher: Ngọn lửa. Tiếng gào thét. Những gương mặt nhỏ bé đầy khiếp sợ. Nhà cửa, gia đình... tất cả đều cháy thành tro bụi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292968
    m_Localized: 'Teacher: Cô không đủ mạnh mẽ để trở thành người như em đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292969
    m_Localized: 'Teacher: Những kẻ như cô... chỉ còn có một cái kết duy nhất.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292970
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292971
    m_Localized: 'Teacher: (Cô giáo giật mình, run rẩy nhìn bạn)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292972
    m_Localized: 'Teacher: (Sự bối rối nhất thời giúp bà tạm quên đi cơn ác mộng, dù chỉ trong giây lát)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292973
    m_Localized: 'Teacher: (Bà ôm mặt khóc rưng rức)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292974
    m_Localized: 'Teacher: (Bạn ngây người ra một lúc. Đâu có ai chỉ cho bạn cách xử sự ra sao trong tình huống này)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292975
    m_Localized: 'Teacher: (Bạn nhẹ nhàng đặt tay lên vai bà, đứng kế bên và không nói gì)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292976
    m_Localized: 'Teacher: (Có lẽ lúc này, nên để bà ấy một mình thì hơn)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487232
    m_Localized: 'Mother: À hay là như vầy. Em gọi cho ổng đi. Số ổng là {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487233
    m_Localized: 'Mother: Xong rồi chửi ổng một trận cho chị nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487234
    m_Localized: 'Mother: Mấy đứa nhỏ cũng là con của ổng mà, ổng cũng phải phụ chị đi kiếm chớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487235
    m_Localized: 'Anger: Cậu nối máy được thì chịu khó gọi cho cô ấy nhé? Số cổ là {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487236
    m_Localized: 'Anger: Nhắn giúp tôi là... tôi xin lỗi... tôi vẫn day dứt giày vò, muốn xé nát cổ họng mình ra.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487237
    m_Localized: 'Anger: Không thì cậu quát vào mặt cổ cũng được... Chả biết, có khi thế lại dễ nói chuyện hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487238
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875840
    m_Localized: 'FortuneTeller: Một số người tìm đến thế giới tâm linh để được dẫn dắt...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875841
    m_Localized: "FortuneTeller: Có những vị... gọi là chuyên gia...\nbiết cách xua đuổi tà ma,\nthanh lọc bóng tối."
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875842
    m_Localized: 'FortuneTeller: Nếu em muốn, chị sẽ làm cầu nối cho em. Tâm chị mách bảo rằng có thể em sẽ cần...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875843
    m_Localized: 'FortuneTeller: Gọi cho họ ở số này nhé: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875844
    m_Localized: 'FortuneTeller: Nhớ bảo là chị giới thiệu đó nha...!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547533041664
    m_Localized: 'Alkonost: Nếu không phiền, chú gọi ảnh giúp chị được không? Số ảnh là {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235968
    m_Localized: 'Foreigner: (Anh ta đưa bạn tờ giấy ghi số điện thoại: {0})'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235969
    m_Localized: 'Foreigner: (Có lẽ là số để liên lạc với đại sứ quán)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818880
    m_Localized: 'Jacob: Thèm uống quá. Khát khô cổ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818881
    m_Localized: Anh bảo chúng ta "bất tử" tức là sao vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818882
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818883
    m_Localized: 'Jacob: Ừ thì... Muốn kiểm chứng thì cậu cứ tự bắn một phát vào đầu mình xem.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818884
    m_Localized: 'Jacob: Mà tôi khuyên cậu đừng nên làm thế. Không hay lắm đâu, ý kiến cá nhân thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818885
    m_Localized: 'Jacob: Tôi nói "bất tử" ở đây không có nghĩa là không chết được.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818886
    m_Localized: 'Jacob: Mà đúng ra là mỗi lần chết, ta sẽ đầu thai sống lại. Cứ như vậy, một vòng luân hồi sinh tử bất tận.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818887
    m_Localized: 'Jacob: Ừ nghe ảo ma thật, nhưng cậu thử chứng kiến những gì tôi đã thấy xem... Cậu sẽ hiểu ngay thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818888
    m_Localized: 'Jacob: Biết đâu bọn Dị Khách từng là người, rồi được tái sinh sau khi chết thì sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818889
    m_Localized: 'Jacob: Mà tôi cũng chẳng dám chắc. Có biết nguyên lý đầu đuôi như nào đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818890
    m_Localized: 'Jacob: Chắc hẳn là mẹ thiên nhiên còn che giấu nhiều bí mật động trời lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818891
    m_Localized: 'Jacob: Nhưng sẽ có ngày tôi tìm thấy con gái tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818892
    m_Localized: 'Jacob: Kiếp này không được... thì đợi kiếp sau. Tôi nhất quyết không bỏ cuộc.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818893
    m_Localized: 'Jacob: Bởi chúng ta đâu thể chết vĩnh viễn.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818894
    m_Localized: 'Jacob: Thèm uống quá. Khát khô cổ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818895
    m_Localized: Rồi bọn Thảm Họa đi tìm anh làm gì?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818896
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818897
    m_Localized: 'Jacob: Lúc bọn dị hợm lúc nhúc trồi lên thì tôi ở ngay chính giữa cái mớ hổ lốn đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818898
    m_Localized: 'Jacob: Nên là bao nhiêu nhơ bẩn tạp nham mình tôi hứng đủ mẹ luôn. Vãi cả đời.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818899
    m_Localized: 'Jacob: Cậu đã từng nghe mấy truyền thuyết kể về lũ quỷ ngoài rìa thị trấn chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818900
    m_Localized: 'Jacob: Mà thôi bỏ đi, giờ này còn ai nhớ mấy thứ đó chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818901
    m_Localized: 'Jacob: Hóa ra nó là thật chứ chẳng phải lời đồn. Mà bọn cán bộ Thảm Hại thì biết hết từ đầu rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818902
    m_Localized: 'Jacob: Thế mà dám bảo dân mình là chả có cái gì kỳ dị, siêu nhiên diễn ra đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818903
    m_Localized: 'Jacob: Nói hay như hát, giờ mặt trời thiêu người ta thành than luôn rồi kìa...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818904
    m_Localized: 'Jacob: Kẻ nào may mắn sống sót thì cũng bị bọn quái vật dưới lòng đất ngoi lên giết sạch!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818905
    m_Localized: 'Jacob: Đám áo vàng biết xừ là tại bọn nó mà chuyện bê bết hết...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818906
    m_Localized: 'Jacob: Nên giờ nó cố giấu nhẹm sự thật đi như mèo giấu cứt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818907
    m_Localized: 'Jacob: Còn tôi thì chẳng qua xui rủi, ở sai lúc sai chỗ nên bị cuốn vào thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818908
    m_Localized: 'Jacob: Thèm uống quá. Khát khô cổ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818909
    m_Localized: Sao anh thoát chết được hay vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818910
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818911
    m_Localized: 'Jacob: Cậu quên rồi à? Tôi bất tử còn gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818912
    m_Localized: 'Jacob: Mà tôi cũng chẳng biết đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818913
    m_Localized: 'Jacob: Bản thân tôi cũng thắc mắc mãi mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818914
    m_Localized: 'Jacob: Chắc do tôi may thôi. Hoặc có thần thánh phương nào phù hộ không biết chừng...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818915
    m_Localized: 'Jacob: Trời Phật Chúa Chiếc gì ấy, thích gọi sao thì gọi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818916
    m_Localized: 'Jacob: Mà biết đâu tôi đã chết rồi, xong được tái sinh thành hình dạng này thì sao. Cũng chẳng dám chắc được.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818917
    m_Localized: 'Jacob: Câu hỏi đáng suy ngẫm đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818918
    m_Localized: 'Jacob: Tiếc là tôi không cầm khẩu súng nào, chứ có thì cũng hỏi cậu câu y hệt rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818919
    m_Localized: 'Jacob: Mà xui nữa là nhà cậu chỉ còn mỗi bia nhạt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818920
    m_Localized: 'Jacob: Tôi mà có thùng là tôi ủ ngay một mẻ bia ngon tuyệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818921
    m_Localized: 'Jacob: Thèm uống quá. Khát khô cổ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818922
    m_Localized: Anh còn biết gì nữa không?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818923
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818924
    m_Localized: 'Jacob: Tôi biết cơ cấu tổ chức và hoạt động của bọn Thảm Họa, từ trong ra ngoài luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818925
    m_Localized: 'Jacob: Ai ra lệnh, ai nhận lệnh, nhiệm vụ là gì, thậm chí đôi nào đang phịch nhau... Tôi đều biết tất.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818926
    m_Localized: 'Jacob: Cái bọn khốn nạn đấy biết tuốt tuồn tuột về lũ Dị Khách, biết nó nguy hiểm đến nhường nào rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818927
    m_Localized: 'Jacob: Mà vẫn cho lũ đấy tràn vào thành phố.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818928
    m_Localized: 'Jacob: Bọn nó có quan tâm chó gì đến tính mạng người dân đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818929
    m_Localized: 'Jacob: Chỉ muốn rửa tiền nhà nước thôi. Sướng quá mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818930
    m_Localized: 'Jacob: Ai mà phát hiện sai phạm của bọn này là thành nạn nhân hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818931
    m_Localized: 'Jacob: Tổ chức nó kín như bưng, không muốn chuyện bị bại lộ ra ngoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818932
    m_Localized: 'Jacob: Thực trạng trước giờ đã vậy rồi. Không phải đợi xây xong khu cách ly mới có đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818933
    m_Localized: 'Jacob: Tôi cũng xém tí là bị nó bắt rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818934
    m_Localized: 'Jacob: Lại đây, tôi bật mí chút bí mật quân sự cho...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818935
    m_Localized: 'Jacob: Tất cả là do bọn Thảm Hại mà ra hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818936
    m_Localized: 'Jacob: Mấy thứ chúng nó nói trên TV hả? Xàm lồn hết đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818937
    m_Localized: 'Jacob: Giờ mà bảo có kẻ nào ác hơn lũ Dị Khách...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818938
    m_Localized: 'Jacob: Thì là bọn áo vàng đốn mạt đó chứ ai.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818939
    m_Localized: 'Jacob: Thèm uống quá. Khát khô cổ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818940
    m_Localized: Dị Khách từ đâu mà tới vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818941
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818942
    m_Localized: 'Jacob: Từ vùng ngoại ô, bên rìa thị trấn.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818943
    m_Localized: 'Jacob: Ừ thì tôi biết khu cách ly ở xa chỗ đấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818944
    m_Localized: 'Jacob: Nhưng tôi đảm bảo luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818945
    m_Localized: 'Jacob: Tôi cũng chẳng mê tín hay gì đâu, nhưng mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818946
    m_Localized: 'Jacob: Đó chính là lũ ác quỷ mà mọi người vẫn truyền tai nhau từ hai năm trước.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818947
    m_Localized: 'Jacob: Chẳng rõ lũ này vào thành phố kiểu gì...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818948
    m_Localized: 'Jacob: Nhưng tôi biết bọn tiếp tay cho chúng nó vào.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818949
    m_Localized: 'Jacob: Là bọn Thảm Hại chứ không ai khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818950
    m_Localized: 'Jacob: Lũ Dị Khách chẳng phải người ngoài hành tinh như nhiều người vẫn tưởng đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818951
    m_Localized: 'Jacob: Thực chất chúng cũng là sinh vật sống, như tôi với cậu mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818952
    m_Localized: 'Jacob: Thậm chí chúng đã hiện diện trên Quả Đất này từ lâu, không kém gì loài người cả!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818953
    m_Localized: 'Jacob: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818954
    m_Localized: 'Jacob: Tôi không thể nán lại thêm nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818955
    m_Localized: 'Jacob: Phải đi tìm con gái tôi thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818956
    m_Localized: 'Jacob: Cảm ơn cậu nhé... người bất tử.'
    m_Metadata:
      m_Items: []
  - m_Id: 53577620711792640
    m_Localized: 'Player: (Chẳng còn gì để nói nữa)'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900526071808
    m_Localized: Đưa giấy triệu tập của CQPCTHLB
    m_Metadata:
