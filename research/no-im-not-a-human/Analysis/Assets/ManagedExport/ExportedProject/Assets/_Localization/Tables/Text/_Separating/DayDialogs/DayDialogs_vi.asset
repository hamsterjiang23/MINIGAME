    m_Metadata:
      m_Items: []
  - m_Id: 55784900568014861
    m_Localized: 'Wolfhound: Thích thì tao chiều...'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792076
    m_Localized: 'Player: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792078
    m_Localized: 'Player: Sao? Chú đưa lại hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792079
    m_Localized: 'Player: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792080
    m_Localized: 'Player: Vậy là anh sắp đi một suất cách ly rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539790462976
    m_Localized: Hỏi hay đấy
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434496
    m_Localized: Tôi có chờ đâu
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434497
    m_Localized: 'Ballerina: Tôi hỏi? Cậu thích? Lý do?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434498
    m_Localized: 'Ballerina: Trả lời đi. Cứ tránh câu hỏi.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434499
    m_Localized: 'Ballerina: Như ông đó vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434500
    m_Localized: Tôi. Không. Có. Đợi. Chờ. Gì. Hết
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434501
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434502
    m_Localized: 'Ballerina: Ờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434503
    m_Localized: 'Ballerina: Thế cậu làm gì? Ngồi đây, sau đống bức tường.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434504
    m_Localized: 'Ballerina: Đợi lâu, thật lâu. Đợi người? Đợi trả lời?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434505
    m_Localized: Tôi. Không. Có. Đợi. Chờ. Gì. Hết
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434506
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434507
    m_Localized: 'Ballerina: Nói sao cũng được. Mà tôi cũng vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434508
    m_Localized: 'Ballerina: À, tôi nói rồi mà. Tôi đang chờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434509
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434510
    m_Localized: 'Ballerina: Dù sao. Bà ta sẽ đến. Tôi biết mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434511
    m_Localized: 'Ballerina: À HÁ HÁ HÁ HÁ HÁ!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434512
    m_Localized: 'Ballerina: TÔI THÍCH MÚA. Cho xem nhé? Cứ bắn mà nhìn!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434513
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434514
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434515
    m_Localized: 'Ballerina: Tèn ten!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434516
    m_Localized: 'Ballerina: Thử thêm phát xem?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434517
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434518
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434519
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434520
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434521
    m_Localized: 'Ballerina: Là lá la!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434522
    m_Localized: 'Ballerina: Gần thế này. Vẫn không bắn vào...!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434523
    m_Localized: 'Ballerina: Nhắm mắt bắn à? Hay cậu quá ngu?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434524
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434525
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434526
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434527
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434528
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434529
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434530
    m_Localized: 'Ballerina: La lả là la!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434531
    m_Localized: 'Ballerina: Thôi mệt rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434532
    m_Localized: 'Ballerina: Chết. Cho nhanh.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683264
    m_Localized: 'Foreigner: Xzr tr wzb?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683265
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683266
    m_Localized: 'Foreigner: Zms wfz gsr glr mszm...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602560
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602561
    m_Localized: 'Dude: Á đùùùùù bro ơi, tự nhiên nhớ ra mình còn một điếu to bự hếttttt nước chấm trong túi.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602562
    m_Localized: 'Dude: Ngon lành cành đào. Đến giờ phê tới đỉnh nóc, kịch trần, bay phấp phới luôn, ẤU DỀ!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602563
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602564
    m_Localized: 'Dude: Uầy, chin nhỗi bro nhá...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602565
    m_Localized: 'Dude: Rít xong quên hông nhả cho ông...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602566
    m_Localized: 'Dude: Thôi con vợ lấy điếu thường nha... Dui dẻ hông quạu...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602567
    m_Localized: 'Dude: Tui phải đi bay một xíu đây... Nó phêêêêê...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602568
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602569
    m_Localized: 'Wheelchair: Má ơi bứt rứt quá, phải giãn gân giãn cốt xíu mới được...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602570
    m_Localized: 'Wheelchair: Chờ tí nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602571
    m_Localized: 'Wheelchair: Đó, đỡ hơn nhiều rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602572
    m_Localized: Cái đéo gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602573
    m_Localized: 'Wheelchair: Bình tĩnh ông ơi, chân tui nó bị tê thôi à. Có gì đâu mà om sòm dữ dị?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602574
    m_Localized: Địt mẹ mày giả què à? Để làm cái chó gì?!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602575
    m_Localized: Chân cẳng có bị sao đâu mà phải ngồi xe lăn?!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602576
    m_Localized: 'Wheelchair: Tui có nói tui bị tật bao giờ đâu chời... Làm dị để giữ ấm chân mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602577
    m_Localized: 'Wheelchair: Ê mà... Lăn cái xe vòng vòng như vầy cũng vui lắm á.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602578
    m_Localized: Bố thằng hâm
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602579
    m_Localized: Cút con mẹ mày ra khỏi đây. MAU!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602580
    m_Localized: 'Wheelchair: Chời ơi tui nói ông nghe nhá, lái cái này đi lạng lách mượt ro ro luôn! Đã lắm bồ tèo!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602581
    m_Localized: 'Wheelchair: Chưa thử lần nào hả? Xời, ông hông chơi, ông hổng hiểu đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602582
    m_Localized: Bố thằng hâm
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602583
    m_Localized: Cút con mẹ mày ra khỏi đây. MAU!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602584
    m_Localized: 'Wheelchair: Ờ, kệ ông.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602585
    m_Localized: 'Wheelchair: Mình tui thấy sướng là đủ rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602586
    m_Localized: 'Wheelchair: Cái đéo gì dị cha nội?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602587
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602588
    m_Localized: 'Wheelchair: Thui được rồi, cút thì cút. Nhưng mà tui xách theo cái xe lăn luôn đó nhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602589
    m_Localized: '>>'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602590
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602591
    m_Localized: 'Esenin: Có mấy cuốn tuyển tập thơ, tôi tình cờ tìm thấy này.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602592
    m_Localized: 'Esenin: Tôi đọc cho chú nghe vài khổ nhé, anh bạn hiền?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602593
    m_Localized: Được chứ
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602594
    m_Localized: Thôi anh ạ
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602595
    m_Localized: 'Esenin: Hết rồi. Sao, chú thấy sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602596
    m_Localized: Cảm động quá
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602597
    m_Localized: Mấy câu từ sáo rỗng thôi mà
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602598
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602599
    m_Localized: 'Esenin: Chú ơi, tôi thấy lòng mình nhẹ bớt rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602600
    m_Localized: 'Esenin: Cảm ơn chú đã lắng nghe và chia sẻ với tôi, anh bạn hiền.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602601
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602602
    m_Localized: 'Esenin: Rồi, chú nói vậy thì thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602603
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602604
    m_Localized: 'FortuneTeller: À đây, chị biết làm sao để cải thiện năng lượng của em rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602605
    m_Localized: 'FortuneTeller: Em chỉ cần...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602606
    m_Localized: 'FortuneTeller: DẬP DÌU LẮC LƯ NHƯ BỌN MA KẾT!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602607
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602608
    m_Localized: 'FortuneTeller: Sao rồi? Có hiệu quả không? Cảm nhận được niềm vui tuôn chảy qua mấy luân xa chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602609
    m_Localized: Có thấy gì đâu?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602610
    m_Localized: Cái gì vậy bà nội?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602611
    m_Localized: 'FortuneTeller: Ủa, không được hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602612
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602613
    m_Localized: 'FortuneTeller: Ơ lạ thế. Phải được chứ nhỉ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602614
    m_Localized: 'FortuneTeller: Nào, đừng vội chán nản mà bỏ cuộc. Cứ kiên trì lặp lại vài câu khẳng định tích cực mỗi ngày, ắt sẽ có kết quả.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602615
    m_Localized: 'FortuneTeller: À, hay bây giờ làm luôn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602616
    m_Localized: "FortuneTeller: Đọc to lên theo chị:\nTôi là người hạnh phúc!"
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602617
    m_Localized: Tôi là người hạnh phúc!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602618
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602619
    m_Localized: Vớ va vớ vẩn
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602620
    m_Localized: 'FortuneTeller: Được đó! Cứ tiếp tục đi nào!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602621
    m_Localized: Tôi là người hạnh phúc!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602622
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602623
    m_Localized: Vớ va vớ vẩn
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602624
    m_Localized: 'FortuneTeller: Cố một tí thôi mà cũng không được hả em!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602625
    m_Localized: 'FortuneTeller: Từ từ... Sao chị lại bỏ sót chi tiết này được nhỉ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602626
    m_Localized: 'FortuneTeller: Chị cảm nhận qua trường năng lượng của em... là em chẳng muốn truy cầu hạnh phúc gì. Tâm hồn em rỗng tuếch.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602627
    m_Localized: 'FortuneTeller: Không mong cầu thì sao mà có kết quả? Vũ trụ chẳng cho không, biếu không bao giờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602628
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602629
    m_Localized: 'FortuneTeller: Chị bó tay với em rồi. Khẳng định tích cực cũng chẳng ăn thua gì. Chị rất tiếc.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602630
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602631
    m_Localized: Đang làm trò gì đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602632
    m_Localized: 'Intruder: Đang tìm những giấc mơ của anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602633
    m_Localized: 'Intruder: Tôi chỉ muốn nếm trải... chút bình yên mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602634
    m_Localized: 'Intruder: Anh giấu mấy cái đó ở đâu vậy? Nói tôi biết với.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602635
    m_Localized: Cho mày ba giây để lùi lại
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602636
    m_Localized: Đây chả có mơ mộng gì sất
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602637
    m_Localized: Tránh xa tao ra, mau
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602638
    m_Localized: 'Intruder: Anh phải hiểu cho tôi. Tôi CẦN giấc mơ lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602639
    m_Localized: 'Intruder: Nói chứ tôi nhìn thấy trong đôi mắt anh rồi... Chẳng có nổi một cơn mơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602640
    m_Localized: 'Intruder: Nên là anh hạ hỏa đi. Tôi không tìm nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602641
    m_Localized: 'Intruder: Liệu lúc này... tôi có đang nói thật không? Hay chỉ muốn làm anh chủ quan nhỉ...?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602642
    m_Localized: 'Intruder: Mà tôi có tìm thấy một cơn ác mộng kinh hoàng lắm...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796864
    m_Localized: 'Intruder: Trong mơ, anh trườn bò qua dãy hành lang... như một con sên bẩn thỉu.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796865
    m_Localized: 'Intruder: Đã vậy, anh còn chẳng biết mình đang nhìn qua đôi mắt của ai.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796866
    m_Localized: 'Intruder: Tôi nói nốt điều này thôi, đấy là ánh nhìn mải miết tìm kiếm thi thể. Cứ vậy mà dán chặt vào những vùng đất chết chóc...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796867
    m_Localized: 'Intruder: Biết đâu rồi sẽ có ngày anh thấy nó thì sao...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796868
    m_Localized: 'Intruder: Mà tôi có thấy một cơn ác mộng lạ lắm...'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796869
    m_Localized: 'Intruder: Trong đó, anh trườn bò qua một đường hầm mọc chi chít nấm.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796870
    m_Localized: 'Intruder: Nấm nhiều vô kể, mọc liên tục với tốc độ chóng mặt.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796871
    m_Localized: 'Intruder: Quái lạ thật. Sao trong tâm trí anh lại xuất hiện điềm báo như vậy nhỉ...'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821952
    m_Localized: "Esenin: Những khi đêm tối\ntrải ngang nền trời"
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821953
    m_Localized: "Esenin: Như người bệnh gây mê\ntrên bàn mổ;"
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821954
    m_Localized: 'Esenin: Ta đi qua từng con phố hiu quạnh,'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821955
    m_Localized: 'Esenin: Chốn lánh đời, tiếng thì thầm nhỏ to'
    m_Metadata:
      m_Items: []
  - m_Id: 92376539113529344
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949380
    m_Localized: Mặt trời thiêng của ông thiêu cháy hơi bị nhiều người rồi đấy
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949382
    m_Localized: 'Fanatic: Chính xác, kẻ phàm tục. Rặt một lũ mầm mống ác quỷ! Chúng nó bị thiêu là ĐÚNG!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949383
    m_Localized: 'Fanatic: Ý Ngài đã quyết: Phải giáng đòn trừng phạt xuống TỘI ÁC NGHÌN NĂM của chúng!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949384
    m_Localized: 'Fanatic: Chưa kể bọn Dị Khách, LŨ BÁNG BỔ LẨN KHUẤT TRONG BÓNG ĐÊM, giờ còn dám táo tợn ngửa tay hứng lấy hào quang của Ngài!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949385
    m_Localized: 'Fanatic: Nhưng ÁNH SÁNG CỦA NGÀI đâu phải để cho lũ sâu bọ nhơ bẩn đó! Không hề! Hồng ân ấy chỉ dành trọn cho chúng ta, những CON NGƯỜI xứng đáng!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949386
    m_Localized: 'Fanatic: NGÀI THUỘC VỀ CHÚNG TA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949387
    m_Localized: 'Fanatic: NGÀI LÀ PHƯỚC LÀNH BAN TẶNG CHO NHÂN LOẠI, ĐÉO PHẢI BÀN CÃI! ĐẤNG THÁI DƯƠNG VẠN TUẾ, VẠN VẠN TUẾ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949389
    m_Localized: Ý ông ngày tàn của thế giới là lúc thái dương trừ gian diệt bạo đó hả?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949391
    m_Localized: 'Fanatic: Tin ta đi, kẻ phàm tục, HỒI KẾT CÒN LÂU MỚI ĐẾN.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949392
    m_Localized: 'Fanatic: MỌI SỰ CHỈ MỚI BẮT ĐẦU MÀ THÔI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949393
    m_Localized: 'Fanatic: Chút tro tàn từ thân xác chúng ta vẫn chưa đủ để lấn át THẾ LỰC CỦA VŨ TRỤ đặt trên CÁN CÂN TỘI LỖI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949394
    m_Localized: 'Fanatic: Ta cần NHIỀU KẺ HIẾN THÂN HƠN NỮA cho ngọn lửa công chính của ĐẤNG THÁI DƯƠNG!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949395
    m_Localized: 'Fanatic: Nhưng bạn ta, hãy nhớ lấy điều này: máu của những bậc tử đạo sẽ không đổ xuống vô ích!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949396
    m_Localized: 'Fanatic: Rồi sẽ có ngày, tất cả chúng ta đều thấu hiểu được thánh ý đích thực của Ngài...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949397
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949398
    m_Localized: 'Fanatic: Mẹ kiếp... Lắm lúc giữa đêm, ta cứ có cảm giác như mụ vợ lại bỏ ta mà đi nữa vậy...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949399
    m_Localized: 'Fanatic: Ả ta thật thánh thiện...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949400
    m_Localized: 'Fanatic: ...Nhưng cũng là hạng đĩ chó kém hèn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949401
    m_Localized: 'Fanatic: Ngày tàn của ai cơ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949402
    m_Localized: 'Fanatic: Của chúng ta ấy hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949403
    m_Localized: 'Fanatic: HÀ HÀ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949404
    m_Localized: 'Fanatic: Nói nghe buồn cười. ĐẤNG THÁI DƯƠNG LUÔN ĐỨNG VỀ PHÍA CHÚNG TA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949405
    m_Localized: 'Fanatic: Ngài chính là vị cứu tinh, mi có hiểu không?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949406
    m_Localized: 'Fanatic: Ngài đang cố xua đuổi lũ Dị Khách về lại lòng đất...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949407
    m_Localized: 'Fanatic: Ngài giáng đòn trừng phạt xuống lũ báng bổ đáng khinh vì những tội lỗi chất chồng của nhân loại...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949408
    m_Localized: 'Fanatic: Ánh sáng của Ngài vạch trần lũ ngoại đạo, hiện nguyên hình mớ giẻ rách khai thối mà chúng đang nhục nhã che đi phía sau mặt nạ xảo trá!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949409
    m_Localized: 'Fanatic: Chúng ta phải phủ phục tạ ơn Đấng Thái Dương, chứ đéo có rên rỉ ỉ ôi như lũ nít ranh hôi sữa về "ngày tận thế"!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949410
    m_Localized: 'Fanatic: ĐÂY LÀ CÁI KẾT THÍCH ĐÁNG CHO BÈ LŨ ĐỐI ĐỊCH VỚI NGÀI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949411
    m_Localized: 'Fanatic: CHẾT CỤ MÀY ĐI, LŨ SÂU BỌ BÙN ĐẤT! CHẾT BỐ MÀY ĐI, LŨ DỊ GIÁO TỞM LỢM! CHẾT MẸ MÀY ĐI, LŨ MẦM MỐNG MA QUỶ!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949412
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949413
    m_Localized: 'Fanatic: Con mẹ nó, ước gì có khoai tây chiên ăn...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949414
    m_Localized: 'Fanatic: Ta nghe đây kẻ phàm tục. Nói đi nào!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949415
    m_Localized: Theo ông thì mấy thảm họa này có ẩn chứa ý nghĩa huyền nhiệm gì không?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949416
    m_Localized: Tôi cần kiểm tra ông
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949417
    m_Localized: 'Fanatic: Kẻ phàm tục, mi nói ta nghe... Tại sao ta phải phí công giải nghĩa tường tận, đánh vần cho mi từng lời từng ý...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949418
    m_Localized: 'Fanatic: Để rồi rốt cuộc mi ĐÉO THẨM THẤU ĐƯỢC CHỮ NÀO?! Giờ này còn đi hỏi câu NGU HỌC đó?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949419
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949420
    m_Localized: 'Fanatic: Có vẻ ta đã nhìn nhầm mi rồi. Ngu muội như mi thì Ngài cũng đéo soi sáng nổi... Mi chẳng thể nào thấu tỏ được đại sự của thế gian này...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949421
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949422
    m_Localized: 'Fanatic: Mẹ nó, ước gì có được một hớp bia lạnh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949423
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949424
    m_Localized: 'Fanatic: Này kẻ phàm tục, mi còn món lễ vật lên men nào không?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949425
    m_Localized: Đây, cầm lấy (đưa ông ta lon bia)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949426
    m_Localized: 'Fanatic: Mi dám nói không hả? Đồ phàm phu tục tử, mi tưởng ta NGU chắc?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949427
    m_Localized: 'Fanatic: CHÍNH MẮT TA đã nhìn thấu hết mọi thứ trong tủ lạnh nhà mi!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949428
    m_Localized: 'Fanatic: Đừng ích kỷ thế chứ. Mi định một mình nhâm nhi chỗ bia đó mà không chia sẻ cho người khác ư?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949429
    m_Localized: Không (khỏi đưa gì cả)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949430
    m_Localized: 'Fanatic: Ôi, tạ ơn Đấng Thái Dương...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949431
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949432
    m_Localized: 'Fanatic: Hààà, ngon đấy. Lại còn là bia đen, rất hợp khẩu vị ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949433
    m_Localized: 'Fanatic: Làm ta nhớ lại những lúc la cà nơi quán xá cùng đám bạn hữu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949434
    m_Localized: 'Fanatic: Bao cuộc hàn huyên bất tận, giữa đống ly bia mát lạnh, vài món nhấm nháp đưa cay...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949435
    m_Localized: 'Fanatic: Và cả cái bản mặt sưng sỉa của gã gầy tong teo cứ lườm nguýt bọn ta nữa chứ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949436
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949437
    m_Localized: 'Fanatic: Thôi, chẳng việc gì phải hậm hực. Kẻ phàm tục, mặc dù mi ngu muội, nhưng ít ra cũng còn biết điều đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949438
    m_Localized: 'Fanatic: Ta có món quà nho nhỏ thay lời cảm ơn. Nhận lấy đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949439
    m_Localized: 'Fanatic: Cầu xin Đấng Thái Dương rủ lòng thương xót linh hồn của mi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949440
    m_Localized: 'Fanatic: QUÂN BÁNG BỔ NGHIỆT SÚC!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949441
    m_Localized: 'Fanatic: TRÙ CHO MI CHẾT CHÁY TRONG NGỌN HỎA NGỤC, THẰNG CHÓ ĐẺ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949442
    m_Localized: 'Fanatic: Cái đồ vong ơn bội nghĩa, ăn cháo đá bát! Uổng công ta tận tình giảng giải cho mi về giới luật thiêng liêng, về công cuộc thần thánh...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949443
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949444
    m_Localized: 'Fanatic: Này kẻ phàm tục! Mi không chỉ NGU MUỘI, mà còn BẤT NHÂN!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949445
    m_Localized: 'Fanatic: Địt con mẹ nhà mi. Cứ việc chết rục trong cái xó rách này đi nhé! Để ta đi tìm chỗ khác ngon lành hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949446
    m_Localized: 'Fanatic: Mi cứ chờ đấy. Thế nào bọn ở quán bar cũng hân hoan đón ta trở lại cho xem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949447
    m_Localized: 'Fanatic: Cáo con mẹ nó từ nhá, thằng đần!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337997
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338224
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054889
    m_Localized: 'Couple: Con kia! Lấy cái mền rồi đi lẹ lên.'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792075
    m_Localized: 'Player: Cái gì đó?'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792077
    m_Localized: 'Player: (Họ miễn cưỡng cầm lấy)'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683267
    m_Localized: 'Unstable: Hết rồi, sạch trơn luôn. Không còn gì để ừng ực...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683268
    m_Localized: Rồi chuyện gì hay đâu, kể nghe xem nào
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683269
    m_Localized: 'Unstable: À kể chuyện hả... Hay là mình trao đổi qua lại đi. Bác có muốn mở bài, chia sẻ trước không?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683270
    m_Localized: Tôi chả muốn chia sẻ gì với cậu
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683271
    m_Localized: Vào đề đi, đừng lằng nhằng nữa
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683272
    m_Localized: 'Unstable: Rồi rồi. Xõa tí đi, ai ép gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683273
    m_Localized: 'Unstable: À thììì... Có lần tôi ở quán bar này. Ờm, phải bar không nhở? Hay chỗ khác ta? Uầy, chả nhớ nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683274
    m_Localized: 'Unstable: Cái đậuuuuu, chỗ đó gọi là quái gì ấy nhờ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683275
    m_Localized: ...Rồi sao?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683276
    m_Localized: 'Unstable: Đây đây, đừng nóng.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683277
    m_Localized: 'Unstable: Ờ thì đấy. Lúc đó tôi đang ngồi chơi xơi nước, cụ thể là em Enerjeka "êu vấu".'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683278
    m_Localized: 'Unstable: Ôi giồi ôi nó phê pha mà nó đê mê lắm bác ạ. Bác không chơi, bác không hiểu đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683279
    m_Localized: 'Unstable: Kiểu... hớp một hơi mà sốc tận óc luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683280
    m_Localized: 'Unstable: Sảng khoái hậu vị cả ngày dài! Mỗi tội nước này không có bán đầy đường thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683281
    m_Localized: ...Thì?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683282
    m_Localized: 'Unstable: À à ừ... Tới đâu rồi nhở...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683283
    m_Localized: 'Unstable: Là như này, tôi đang ngồi trên ghế ý, chỗ đó cũng vắng vắng thôi. Nhạc thì nổ ầm ầm bên tai.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683284
    m_Localized: 'Unstable: Rồi bỗng có tiếng ai hét toáng lên. Hét lớn tới nỗi tôi đeo tai nghe mà còn nghe lọt. '
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683285
    m_Localized: 'Unstable: Mà đúng ngay đoạn bốc ơi là bốc nữa chứ. Tôi là tôi méo ưa vụ đang phiêu nhạc mà bị ai làm phiền đâu nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683286
    m_Localized: 'Unstable: Bác hiểu ý tôi không... Kiểu mình đang say sưa hòa mình vào giai điệu, thế giới xung quanh dần phai mờ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683287
    m_Localized: Lảm nhảm đéo gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683288
    m_Localized: 'Unstable: Rồi rồi. Chờ tí, đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683289
    m_Localized: 'Unstable: Thế là tôi giật cái tai nghe ra, thấy có ông chú cao lêu nghêu đang quát vào tai thằng cu nào ý, trông tội vãi chưởng.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683290
    m_Localized: 'Unstable: Chả hiểu hai người cãi nhau ỏm tỏi vụ gì, mà gã nói năng lắp bắp chữ được chữ mất. Nhìn là biết say khướt khườn khượt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683291
    m_Localized: 'Unstable: Bất thình lình gã hươu cao cổ hét lên, rồi tát thẳng vào mặt thằng cu kia. Hắn ngã lăn quay ra đất luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683292
    m_Localized: 'Unstable: Mà chưa hết đâu. Gã Cao Văn Kều còn trèo lên cả quán bar, đầu muốn đụng tới trần nhà, đứng liêu xiêu như cây sậy trước gió.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683293
    m_Localized: 'Unstable: Gã quát cái gì mà: "Tụi mày đều là một lũ cặn bã!"'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683294
    m_Localized: 'Unstable: Nghe là biết sắp nổi cơn tam bành rồi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683295
    m_Localized: 'Unstable: Tôi đâu có điên mà ở lại cho dính chưởng. Nên là tôi đánh bài chuồn luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683296
    m_Localized: Rồi sao nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683297
    m_Localized: 'Unstable: Sao trăng gì đâu. Chẳng là tôi cảm giác mọi chuyện cứ... sai sai sao ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683298
    m_Localized: 'Unstable: Tôi đi tới đâu là ở đấy có người chọc vào ổ kiến lửa, quậy tưng bừng lên.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683299
    m_Localized: 'Unstable: Kiểu, giờ tôi mà ở đâu quá vài ngày thì y như rằng.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683300
    m_Localized: 'Unstable: Thể nào cũng có ẩu đả. Chết chóc. Quan tài. Mồ mả. Thường là theo đúng thứ tự ý luôn...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683301
    m_Localized: 'Unstable: Giờ chỉ mong ở đây sẽ khác thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683302
    m_Localized: 'Unstable: Hết rồi, sạch trơn luôn. Không còn gì để ừng ực...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683303
    m_Localized: Rồi cậu kết luận sao? Nhà này có cảm giác an toàn không?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683304
    m_Localized: 'Unstable: Khó nói lắm bác ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683305
    m_Localized: 'Unstable: Bác tỏa một cái khí chất kiểu... điềm đạm, ấm áp như ở nhà ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683306
    m_Localized: 'Unstable: Mà cũng có thể do đây đúng là nhà bác. Hờ hờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683307
    m_Localized: 'Unstable: Cảm giác như bác đang cố vun vén một tổ ấm dung dị mà bình yên, kiểu kiểu vậy á.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683308
    m_Localized: 'Unstable: Không phải ai muốn vào cũng được này kia.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683309
    m_Localized: 'Unstable: Cơ mà... bác cũng cảm nhận giống tôi đúng không? Có gì đó sai sai ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683310
    m_Localized: 'Unstable: Ờ thì cả thế giới đang loạn cào cào, có gì đúng đâu. Nhưng mà ở đây ý... nó kiểu...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683311
    m_Localized: 'Unstable: Uầy, cũng chả biết nữa. Tôi còn chẳng hiểu tôi muốn nói gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683312
    m_Localized: 'Unstable: Thôi kệ cha nó đi bác. Làm lon Enerjeka rồi quên mẹ sự đời.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683313
    m_Localized: 'Unstable: Khỏi phải nghĩ nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683314
    m_Localized: Rồi chừng nào cậu đi?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683315
    m_Localized: Cậu vẫn còn trốn chạy thứ gì à?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683316
    m_Localized: 'Unstable: Chắc là sớm thôi bác.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683317
    m_Localized: 'Unstable: Tôi không muốn nán lại một chỗ quá lâu. Chắc bác cũng biết rồi nhể.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683318
    m_Localized: 'Unstable: Còn nếu chưa biết thì... Ờm, bác có để ý không đấy, tôi nhắc đi nhắc lại mấy lần rồi mà. Ha ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683319
    m_Localized: 'Unstable: Tôi cứ nghĩ là chỗ bác sẽ có nhiều thứ vui vui.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683320
    m_Localized: 'Unstable: Mà vui đâu chả thấy, chỉ thấy toàn mùi chết chóc. Tôi cũng không hiểu sao lại vậy, nhưng...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683321
    m_Localized: 'Unstable: Thôi, nhiêu đó là đủ lắm rồi. Xin kiếu bác ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683322
    m_Localized: 'Unstable: Tôi có trốn chạy gì đâu, chỉ là bước tiếp mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683323
    m_Localized: 'Unstable: Tôi không muốn rước thêm rắc rối vào người. Đã trải qua quá nhiều kiếp nạn rồi bác.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683324
    m_Localized: 'Unstable: Cứ ở lì một chỗ mãi thì thể nào cũng có người muốn đấm mình, bắn mình, hoặc là giam nhốt luôn ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683325
    m_Localized: 'Unstable: Rồi ai biết kết cục nào đang chờ đợi mình...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683326
    m_Localized: 'Unstable: Ừ đúng, tôi càng đi thì càng có nguy cơ đụng phải mấy thằng cha dị hợm, mát dây.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683327
    m_Localized: 'Unstable: Nhưng thôi thà vậy còn hơn là đặt niềm tin vào ai đó, rồi bị chính họ đâm lén sau lưng.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683328
    m_Localized: 'Unstable: Hết rồi, sạch trơn luôn. Không còn gì để ừng ực...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683329
    m_Localized: Rồi, chuẩn bị xong hết chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683330
    m_Localized: 'Unstable: Hở? À à. Rồi bác. Tối nay tôi lên đường luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683331
    m_Localized: 'Unstable: Nên là... Tạm biệt bác nhá!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683332
    m_Localized: Không thể trốn chạy mãi những ác mộng trên đời đâu
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683333
    m_Localized: Chúc thượng lộ bình an. Mong cậu chạy nhanh hơn lũ điên ngoài kia
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683334
    m_Localized: 'Unstable: Ừ ừ. Tôi biết mà. Nhưng mà nè, biết đâu tôi làm được thì sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683335
    m_Localized: 'Unstable: Chứ bác nghĩ cứ ở yên một chỗ vậy thì khác lắm à?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683336
    m_Localized: Thôi thì... chúc may mắn
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683337
    m_Localized: Tôi không định cho cậu ở nhờ nữa đâu đấy
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683338
    m_Localized: 'Unstable: Bác nói thật tình à? Không kháy tôi đấy chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683339
    m_Localized: 'Unstable: Thôi dù sao cũng cảm ơn bác. Nhờ bác mà tôi được nghỉ ngơi thoải mái. Nạp đủ năng lượng để chạy cả mấy ngày là ít.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683340
    m_Localized: 'Unstable: Enerjeka cứ như là thần dược vậy, bác à.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683341
    m_Localized: 'Unstable: Còn nếu bác nói mỉa tôi thì... Thà rằng đứng dậy làm gì đó, gì cũng được, vẫn tốt hơn là ngồi một chỗ chờ cho não bị nướng thành bê thui.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683342
    m_Localized: 'Unstable: Tôi cũng chẳng còn gì để mất nữa. Để lại sau lưng hết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683343
    m_Localized: 'Unstable: Vậy thì sao không đi tìm điều gì mới mẻ. Còn hơn là ngả mũ chào thua, im lìm đợi hồi kết đến.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683344
    m_Localized: 'Unstable: Tôi... Tôi chẳng muốn như vậy tí nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683345
    m_Localized: Thôi thì... chúc may mắn
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683346
    m_Localized: Tôi không định cho cậu ở nhờ nữa đâu đấy
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683347
    m_Localized: 'Unstable: Cảm ơn bác nhé. Tôi cũng chúc bác may mắn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683348
    m_Localized: 'Unstable: Biết đâu có duyên hội ngộ thì sao. Khéo tôi còn gặp nạn thêm vài lần, vớ được thêm dăm ba câu chuyện hay.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683349
    m_Localized: 'Unstable: Nhiều khi lúc đó tôi mới có hứng kể cho bác nghe. Chứ giờ nhìn mặt bác rầu rĩ như đưa đám thế thì hứng mẹ gì nổi. '
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683350
    m_Localized: 'Unstable: Mà thôi, chả quan trọng. Đằng nào tôi cũng đâu muốn quay lại làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683351
    m_Localized: 'Unstable: Chẳng còn gì để mà vấn vương. Tôi có về cũng chỉ toàn tro tàn với tro cốt chờ đợi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683352
    m_Localized: 'Unstable: À tôi có ý chê nhà bác đâu nhé. Đang thuật lại mấy cảnh đã mắt thấy tai nghe thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683353
    m_Localized: 'Unstable: Vậy nên tôi thà dứt áo ra đi, bỏ hết lại phía sau. Từ giờ... mình đừng gặp nhau nữa thì hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683354
    m_Localized: 'Unstable: Hết rồi, sạch trơn luôn. Không còn gì để ừng ực...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683355
    m_Localized: Sao còn chưa đi nữa?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683356
    m_Localized: 'Unstable: Ờ tôi cũng định đi chứ, nhưng phải dặn dò bác trước đã!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683357
    m_Localized: 'Unstable: Tối qua tôi cảm nhận có gì rình mò ngoài cửa sổ ấy, rợn cả gáy. Định lay bác dậy rồi, nhưng thôi nghĩ lại cứ để bác ngủ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683358
    m_Localized: 'Unstable: Nghe lời tôi... cẩn thận nhé bác. Cái chết dí sát cửa nhà bác rồi đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683359
    m_Localized: 'Unstable: Tôi cũng không biết giải thích sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683360
    m_Localized: 'Unstable: Người tôi nó cứ giật giật bồn chồn kiểu gì ý, chắc do nạp hơi lắm caffeine.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683361
    m_Localized: 'Unstable: Nhưng chuyện đấy không quan trọng.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683362
    m_Localized: 'Unstable: Vấn đề là tôi phải báo trước cho bác dè chừng. Trước khi có chuyện không hay xảy đến.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683363
    m_Localized: 'Unstable: Bác cũng nên tính tới chuyện rời đi là vừa đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683364
    m_Localized: 'Unstable: ...Rồi rồi, không muốn thì thôi. Gì mà lườm tôi ghê thế. Tôi biết tôi nói vớ nói vẩn rồi. Cứ kệ đi cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683365
    m_Localized: 'Unstable: Thôi nhá, đừng trách tôi chưa báo trước. Xong là tôi đi thật. Chúc bác không thành thịt nướng như mấy người ngoài kia.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683366
    m_Localized: 'Rocker: Anh bạn à, tôi thấy nhớ cây đàn quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683367
    m_Localized: Đang mơ màng gì thế?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460480
    m_Localized: 'Rocker: Hả? Đang nhẩm xem mấy thằng anh em ngày xưa, giờ còn được đứa nào không ấy mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460481
    m_Localized: 'Rocker: Ngày trước á, cứ đám tang thằng nào xong là cả hội lại lôi đàn ra đánh. Thà thế còn hơn là cứ nằm bẹp một chỗ, hoặc nốc rượu vào cho hỏng người.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460482
    m_Localized: 'Rocker: Có lần tôi chơi đi chơi lại đúng một đoạn riff suốt ba đêm liền, đến mức đầu ngón tay túa cả máu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460483
    m_Localized: 'Rocker: Chỉ có tôi với cây đàn yêu dấu. Đầu bận phiêu theo nhạc thì sao nhớ nổi mặt cái thằng vừa chết nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460484
    m_Localized: 'Rocker: Giờ thì ngày quái nào cũng như cứt. Hết lũ Dị Khách lại đến quả nắng cháy da cháy thịt. Đời sướng thế là cùng! Hai, ba, dzô!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460485
    m_Localized: 'Rocker: Anh bạn à, tôi thấy nhớ cây đàn quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460486
    m_Localized: Không có đàn hẳn phải bứt rứt lắm nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460487
    m_Localized: 'Rocker: Chứ còn gì nữa bạn ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460488
    m_Localized: 'Rocker: Nhớ mấy lần chơi nhạc trong bếp quá. Âm ly đặt chông chênh trên ghế, anh em thì phải vặn nửa nấc, không là hàng xóm lại a lô cho cớm thì khổ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460489
    m_Localized: 'Rocker: Cứ hết mỗi bài là lại có thằng đề thêm một câu: "Tưởng nhớ thằng abc con xyz". Thế thôi, đếch có khóc lóc nỉ non gì cả.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460490
    m_Localized: 'Rocker: Đập đàn chứ đừng đập đầu vào tường. Vì đàn ít ra còn thay mới được.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460491
    m_Localized: 'Rocker: Hồi trước, tôi cứ mơ mộng rằng mấy buổi diễn "tại gia" của anh em rồi sẽ làm nên chuyện.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460492
    m_Localized: "Rocker: Nhưng đời đéo như mơ. Mới lên thành phố chưa làm được gì mà \ncả đám đã tan đàn xẻ nghé rồi."
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460493
    m_Localized: 'Rocker: Thằng thì sốc thuốc chết, đứa thì tai nạn giao thông.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460494
    m_Localized: 'Rocker: Đời như cái dái vậy...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460495
    m_Localized: 'Rocker: Mà đêm mai tôi sẽ ra ngoài một chuyến. Có chuyện tôi cần làm.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460496
    m_Localized: 'Rocker: Anh bạn à, tôi thấy nhớ cây đàn quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460497
    m_Localized: Thế nào? Đêm qua anh đi đâu à?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460498
    m_Localized: 'Rocker: Ừ. Tạt qua chỗ tập cũ của cả hội ý mà. Tường thì mốc xanh mốc đỏ, dây nhợ vất chỏng chơ, trông chả khác gì bãi rác.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460499
    m_Localized: 'Rocker: Tôi bật máy gõ nhịp lên nghe một lúc... thì chẳng còn tiếng đàn trống gì nữa. Chỉ có lặng thinh thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460500
    m_Localized: 'Rocker: Tầm này thì còn mơ với chả mộng cái nỗi gì...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460501
    m_Localized: 'Rocker: Rock n roll ne-vờ đai ấy hả? Hài vãi!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460502
    m_Localized: 'Rocker: Bạn tôi ơi, nghĩ mà xem. Tiết trời có không như cái lò lửa đi nữa, thế nào cũng có thứ oái oăm gì đó khác chặn đường mình sống thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460503
    m_Localized: 'Rocker: Hồi nhỏ, tôi cứ ngỡ là từ nay mình thoát khổ rồi. Đời ta cứ thế mà đi lên thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460504
    m_Localized: 'Rocker: Qua cơn suy thoái, ngừng tiếng bom đạn... Để rồi ta được sống đúng nghĩa cho ra sống.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460505
    m_Localized: 'Rocker: Mẹ kiếp, hóa ra tôi ngây thơ quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460506
    m_Localized: 'Rocker: Anh bạn à, tôi thấy nhớ cây đàn quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460507
    m_Localized: Mải nghĩ gì mà đăm chiêu thế?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460508
    m_Localized: 'Rocker: Chuyện đời tôi chẳng có gì ngoài việc làm nền và tô điểm cho kẻ khác. Chẳng bao giờ được sắm vai chính cả. Có lẽ kiếp này hết cơ hội rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460509
    m_Localized: 'Rocker: Chả hiểu sao tôi lại phải nói dối với bạn làm gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460510
    m_Localized: 'Rocker: Chắc là tôi chỉ muốn thử giả vờ mình đã thành công xem thế nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460511
    m_Localized: 'Rocker: Cứ mở mồm ra là lại cất bài ca về nghị lực vượt khó, toàn văn vở cả. Chứ thực tế tôi toàn trốn chui trốn lủi như con nít ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460512
    m_Localized: 'Rocker: Lúc bị bạn chĩa súng vào đầu, tôi mới sực nhận ra. Hóa ra trước giờ tôi chỉ gồng mình sống trái với con người thật... để rồi chẳng đi đến đâu hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460513
    m_Localized: 'Rocker: Cứ đà này thì tôi cũng y chang mấy thằng khác thôi. Nằm lạnh ngắt, bụng ứ đầy thuốc. Không thì nằm trong bồn tắm, lưỡi lam ngọt xớt kè kè bên tay.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460514
    m_Localized: 'Rocker: Tôi nào phải Dị Khách. Chỉ là một kẻ đã bị vắt kiệt tinh thần, sắp gục đến nơi rồi thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460515
    m_Localized: 'Rocker: Nếu anh bạn muốn bắn...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460516
    m_Localized: 'Rocker: Thôi dẹp mẹ nó đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460517
    m_Localized: 'Rocker: Tôi đéo quan tâm nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460518
    m_Localized: 'Experienced: Ổn hông mậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460519
    m_Localized: Ông đi tù mà không xăm mình hả?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460520
    m_Localized: 'Experienced: Ê cu, tao hông xăm trổ hổng có nghĩa là chưa từng xộ khám nghe mậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460521
    m_Localized: 'Experienced: Đừng có dòm mặt rồi bắt hình dong, ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460522
    m_Localized: 'Experienced: Đời tao lúc lên voi, lúc xuống chó... Nhưng tao chưa bao giờ đi giết người à nghen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460523
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460524
    m_Localized: 'Experienced: Tao hỏi câu này mày đừng hiểu lầm nhá, tại tao tò mò quá. Ở đây mày quản thúc kiểu gì vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460525
    m_Localized: Ý ông là sao?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460526
    m_Localized: Đếch phải việc của ông
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460527
    m_Localized: 'Experienced: Tao dòm là tao biết, nhà mày chứa chấp đủ các thể loại. Từ đám ăn không ngồi rồi tới tụi dị hợm biến thái...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460528
    m_Localized: 'Experienced: Vậy thì mần ăn gì được. Tao trải đời hơn mày, còn lạ chi cái cảnh này nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460529
    m_Localized: 'Experienced: Làm dị chỉ tổ rước họa vô thân.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460530
    m_Localized: 'Experienced: Giờ giả sử mày đi mời thèng già khú vô nhà, xong ổng lăn ra chết ngắc trên cái sô-pha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460531
    m_Localized: 'Experienced: Rồi lúc đó mày tính sao? Ổng ngủm củ tỏi thì ai chịu? Mày chịu chớ ai. Tụi nó sẽ đổ hết tội lên đầu mày, hiểu hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460532
    m_Localized: 'Experienced: Hay là giờ có con đàn bà vô nhà, rồi thèng ất ơ nào đó chịch nó dính bầu, thì mày tính sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460533
    m_Localized: 'Experienced: Hổng lẽ mày nuôi đứa con rơi con rớt của nó luôn? Nghe thôi là mệt thí mẹ rồi chứ ở.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460534
    m_Localized: 'Experienced: Chỗ anh em tao khuyên mày thiệt tình, mày lựa đàn ông sức dài vai rộng thôi. Như tao với mày đây nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460535
    m_Localized: Ông bảo tôi phải đuổi hết người già, phụ nữ, trẻ con đi hả?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460536
    m_Localized: Người có tiền án mà cũng bày đặt khuyên?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460537
    m_Localized: 'Experienced: Rồi rồi tao nghe, khỏi phải căng. Tao hổng xía vô chiện của mày nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460538
    m_Localized: 'Experienced: Giang sơn này là của mày, tao đâu có ý chọc giận cọp dữ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460539
    m_Localized: 'Experienced: Tao chỉ thấy ngứa mắt ở chỗ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460540
    m_Localized: 'Experienced: Sao ai ở đây cũng bận quần bận áo kín mít dị trời?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460541
    m_Localized: 'Experienced: Chuẩn đó mậy. Mày khôn đó, nói cái là hiểu liền. Cần đéo gì tụi nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460542
    m_Localized: Ông láo chó thế nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460543
    m_Localized: Ông ra tù phát là thành chuyên gia luôn hả? Ai mượn?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460544
    m_Localized: 'Experienced: Tao chỉ muốn nhắc mày thui, đừng có bạ ai cũng cho vô cái rẹt. Có ngày tụi nó ăn cháo đá bát, chơi mày một vố đau ráng chịu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460545
    m_Localized: Ông láo chó thế nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460546
    m_Localized: Ông ra tù phát là thành chuyên gia luôn hả? Ai mượn?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460547
    m_Localized: 'Experienced: Mày tưởng mày là cây hài hả cu?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460548
    m_Localized: 'Experienced: Rồi rồi tao nghe, khỏi phải căng. Tao hổng xía vô chuyện của mày nữa. Nói một lần là hiểu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460549
    m_Localized: 'Experienced: Tao chỉ thấy ngứa mắt ở chỗ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460550
    m_Localized: 'Experienced: Sao nóng dữ thần thiên địa dị mà ai ở đây cũng bận áo quần?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460551
    m_Localized: 'Experienced: Ổn hông mậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460552
    m_Localized: Mặc thế ông không lạnh à?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460553
    m_Localized: 'Experienced: Lạnh là lạnh cái gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460554
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460555
    m_Localized: 'Experienced: Mày đang cà khịa tao đó hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460556
    m_Localized: 'Experienced: Mé trời nóng cháy da cháy thịt luôn. Ngoài đường hổng khác gì cái tiệc nướng, chín xì xèo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460557
    m_Localized: 'Experienced: Dị mà mày còn đi bận áo len? Đéo hiểu ai mới là thèng ngu ở đây hờ?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460558
    m_Localized: Quần áo cũng như một phần của tôi vậy
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460559
    m_Localized: Thì có sao đâu
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460560
    m_Localized: 'Experienced: Một phần của mày luôn đó hả...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460561
    m_Localized: 'Experienced: Thôi mày nói sao cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460562
    m_Localized: 'Experienced: Ngoài đường đang nóng thí bụ nội tao, dị mà tụi bây vẫn bận đồ kín như bưng rồi cù nhây cho được.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460563
    m_Localized: 'Experienced: Ngu như mày quê tao đầy. Mồ hôi mồ kê chảy ròng qua khe đít mày, nhưng tao mà khoe cái bàn tọa ướt nhẹp thì bây lại chửi tao mất nết!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460564
    m_Localized: 'Experienced: Ờ mà nghĩ lại... Bận mấy lớp áo dị mà hông đổ mồ hôi có khi lại là quái thai thiệt sự...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460565
    m_Localized: Ý ông bảo tôi là Dị Khách à?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460566
    m_Localized: Ông nói bóng gió gì đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460567
    m_Localized: 'Experienced: Mày giỡn mặt tao hả cu? Tao thì trần như nhộng mà còn nóng muốn chảy mẹ mỡ, mày bận nguyên cái áo len tới cổ mà dám kêu "có sao đâu"?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460568
    m_Localized: 'Experienced: Đéo hiểu luôn. Mồ hôi mồ kê chảy ròng qua khe đít mày, nhưng tao mà khoe cái bàn tọa ướt nhẹp thì bây lại chửi tao mất nết!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460569
    m_Localized: 'Experienced: Mày ra biển coi tụi nó quất đồ gì? Đồ bơi áo tắm mát mẻ thí mẹ, có ai ý kiến ý cò gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460570
    m_Localized: 'Experienced: Nóng thì như nhau, mà nó vui còn tao thành bê thui!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460571
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460572
    m_Localized: 'Experienced: Ờ mà nghĩ lại... Bận mấy lớp áo dị mà hông đổ mồ hôi có khi lại là quái thai thực sự...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460573
    m_Localized: Ý ông bảo tôi là Dị Khách à?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460574
    m_Localized: Ông nói bóng gió gì đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460575
    m_Localized: 'Experienced: Bình tĩnh đi cu. Đã ai làm gì mày đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460576
    m_Localized: 'Experienced: Dòm mày cũng ổn đó. Thích tắm mồ hôi thì cứ thoải mái đi, ai cấm.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460577
    m_Localized: 'Experienced: Tao nói là nói tụi khùng điên ba trợn kia kìa. Ra biển mà cũng bày đặt bận áo choàng đồ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460578
    m_Localized: Chẳng lẽ giờ tôi phải cởi hết đồ ra?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460579
    m_Localized: Giả thuyết táo bạo đấy. Ông lấy đâu ra vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460580
    m_Localized: 'Experienced: Tao biểu mày nghe, giờ đứa nào mà bận đồ thì chỉ có hai lý do. Một là nó bị ngu hết thuốc chữa, hai là nó chả phải con người.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460581
    m_Localized: 'Experienced: Có khi nó chết từ đời tám hoánh rồi, còn mỗi cái thây thối rữa. Nên là mới hổng thấy nóng. Hiểu ý tao hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460582
    m_Localized: Chẳng lẽ giờ tôi phải cởi hết đồ ra?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460583
    m_Localized: Giả thuyết táo bạo đấy. Ông lấy đâu ra vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460584
    m_Localized: 'Experienced: Mày nói gì kỳ. Ý tao có phải dị đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460585
    m_Localized: 'Experienced: Thích tắm mồ hôi thì cứ thoải mái đi, ai cấm.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460586
    m_Localized: 'Experienced: Tại tao thấy nó kỳ cục ớn. Kiểu, chỉ có mấy đứa bị ngu bẩm sinh hoặc là...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460587
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460588
    m_Localized: 'Experienced: Tao nói nghiêm túc nha mậy! Giờ ra đường mà bận đồ như dị thì chỉ có tụi khùng khùng điên điên.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460589
    m_Localized: 'Experienced: Nóng thí mẹ mà cũng dám mần? Bởi tao mới nói, một là nó bị ngu hết thuốc chữa, hai là...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460590
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460591
    m_Localized: 'Experienced: Thôi dẹp mẹ đi. Hổng nói nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460592
    m_Localized: 'Experienced: Ổn hông mậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460593
    m_Localized: Lần trước ông định nói gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460594
    m_Localized: 'Experienced: Bi giờ nhá, tao đánh vần từng chữ cho mày nghe cũng được, nhưng mày có chịu nghe hông đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460595
    m_Localized: Có
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460596
    m_Localized: Không
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460597
    m_Localized: 'Experienced: Ô kê cu. Tao kể.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460598
    m_Localized: 'Experienced: Túm cái quần lại, cả đám tụi mày ở đây toàn là con sâu làm rầu nồi canh.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460599
    m_Localized: Sao ông lại nói vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460600
    m_Localized: Ông hay nghĩ người ta là sâu bọ như thế à?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460601
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460602
    m_Localized: 'Experienced: Đụ mé mày giỡn mặt tao hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460603
    m_Localized: 'Experienced: Đéo muốn nghe thì mắc gì hỏi? Mé thèng hâm.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460604
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460605
    m_Localized: 'Experienced: Tụi bây ở ngoài đây điên hết cả đám rồi. Chỉ có mấy đứa ở trong là còn tỉnh táo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460606
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460607
    m_Localized: 'Experienced: Thôi chấm dứt câu chiện ở đây. Nói tiếng nữa chắc tao cũng điên luôn với mày.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460608
    m_Localized: 'Experienced: Ê cu, mày nghĩ thử coi, tao mà hông nóng tới chảy mỡ thì mắc gì tao lại bận mỗi cái sịp lang thang ngoài đường?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460609
    m_Localized: 'Experienced: Tụi mày đứa nào đứa nấy ăn bận kín mít mà hổng thấy nóng hả? Đéo hiểu kiểu gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460610
    m_Localized: 'Experienced: Tính ra mày ở ngoài này lâu hơn tao chớ, mà sao tao thấy như đó giờ mày toàn sống trong hang trong hốc.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460611
    m_Localized: 'Experienced: Có khi mày còn hổng biết làm sao để phát hiện tụi quái thai dị hợm kia nữa. Đúng hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460612
    m_Localized: Biết chứ, tôi xem trên TV mà
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460613
    m_Localized: Có ai biết chắc được đâu
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460614
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460615
    m_Localized: 'Experienced: Ê ê, giỡn hoài mậy...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460616
    m_Localized: 'Experienced: Tao biểu mà mày hổng nghe! Cái tụi bận đồ kín mít mới là Dị Khách!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460617
    m_Localized: 'Experienced: Có khi mày còn hổng biết làm sao để phát hiện tụi quái thai dị hợm đó nữa. Đúng hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460618
    m_Localized: Biết chứ, tôi xem trên TV mà
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460619
    m_Localized: Có ai biết chắc được đâu
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460620
    m_Localized: 'Experienced: Biết là phải biết chắc cú nha cu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460621
    m_Localized: 'Experienced: Mày mà kiểm tầm bậy tầm bạ là chết cha con nhà người ta luôn. Tụi nó lôi cổ mày vô nhà đá đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460622
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460623
    m_Localized: 'Experienced: Vậy là giờ cứ kiểm đại dị đó hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460624
    m_Localized: 'Experienced: Mé nó chớ. Đành chịu thôi chứ biết sao giờ. Còn cách nào khác nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460625
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460626
    m_Localized: 'Experienced: Tao nói thiệt nghen. Giờ tao dòm ra cảnh đời mà thấy... người nó hổng còn là người nữa mày ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460627
    m_Localized: 'Experienced: Thà ở trong tù còn thấy an tâm hơn...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460628
    m_Localized: 'Experienced: Ổn hông mậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460629
    m_Localized: Ông thấy trong tù an toàn hơn thì sao không ở yên trong đó đi?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460630
    m_Localized: 'Experienced: Ủa tao nói rồi mà mày hổng nghe hả? Tao mãn hạn tù rồi cu. Lần thứ ba tao từng trải đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460631
    m_Localized: 'Experienced: Lần đầu tao vô tù là hồi còn nhỏ xíu, trẻ trâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460632
    m_Localized: 'Experienced: Ra tù xong là tao phấn đấu làm lại cuộc đời.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460633
    m_Localized: 'Experienced: Mà tao mần thiệt mày ạ. Tao lấy vợ, sanh được đứa con. Quên hết chuyện quá khứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460634
    m_Localized: 'Experienced: Cái rồi trời xui đất khiến, đang yên đang lành thì suy thoái kinh tế. Tao phải nai lưng ra mần để kiếm cơm cho vợ con.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460635
    m_Localized: 'Experienced: Loanh quanh một hồi rồi lại ngựa quen đường cũ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460636
    m_Localized: 'Experienced: Ăn ở như tao sớm muộn gì cũng vô tù lần hai. Lần ba thì tao tự nguyện tra tay vô còng. Tàn mẹ đời rồi, sống tự do làm đéo gì nữa cu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460637
    m_Localized: 'Experienced: Vợ tao bỏ theo thèng khác, con tao thì nó rén tao, công ăn việc làm cũng chả có. Ai lại đi mướn thèng có tiền án tiền sự.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460638
    m_Localized: 'Experienced: Dị là đó, đi tong một nửa cuộc đời tao.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460639
    m_Localized: Sao ông không tiếp tục làm lại cuộc đời?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460640
    m_Localized: Khổ thân ông
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460641
    m_Localized: 'Experienced: Mần được chớ. Mà tao chưa tìm được lý do đủ để vực dậy thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460642
    m_Localized: 'Experienced: Sông có khúc thì người có lúc. Cứ kiên nhẫn chờ đợi, rồi thời cũng tới mà thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460643
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460644
    m_Localized: 'Experienced: Thôi mày khỏi cần thương xót giùm tao. Tại tao hết, chính tao tự hại đời mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460645
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460646
    m_Localized: 'Experienced: Cả thế giới thay đổi khi tao còn ở trỏng.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460647
    m_Localized: 'Experienced: Tre già thì khó uốn, tao từng tuổi này còn học hỏi thích nghi được gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460648
    m_Localized: 'Experienced: Tao hổng khác gì cái giường xập xệ trong phòng giam. Trước sau như một, giường gỗ vẫn hoàn giường gỗ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460649
    m_Localized: 'Experienced: Coi bộ tao đã quá quen đường cũ, hông tìm được lối đi mới mày ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460650
    m_Localized: 'Experienced: Thời buổi này cũng khó mà hòa nhập, sống chung với nhau. Chả có ma nào thèm tin ma nào. Mới ngó một cái là tụi nó xiên luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460651
    m_Localized: 'Experienced: Tánh tao đã quen ăn ngay nói thẳng rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460652
    m_Localized: 'Experienced: Mà trong tù tụi nó được cái sống thiệt tình. Tin hay hông tùy mày.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460653
    m_Localized: 'Experienced: Còn mấy cái đứa ngoài này ghê gớm lắm. Chả biết ai người ai ma, ai chánh ai tà. Loạn như quỷ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460654
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460655
    m_Localized: 'Experienced: Tao hổng phải người nói đạo lý hay gì... Nhưng đụ mé, bộ mần người khó lắm hở? Tụi trong tù còn mần được nữa mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460656
    m_Localized: 'Experienced: Té ra ngoài kia nhiều đứa khốn nạn, chó má hơn tao tưởng.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460657
    m_Localized: 'Jacket: Má ơi… Tình hình bên ngoài loạn quá đi mất.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460658
    m_Localized: Lúc trước cậu ở ký túc xá nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460659
    m_Localized: 'Jacket: Đúng rồi anh. Thực ra em không phải dân ở đây. Em tới để học đại học thôi, mà giờ thế giới tan hoang hết cả rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460660
    m_Localized: 'Jacket: Ban đầu người ta bắt tụi em ở yên trong ký túc, vì sợ virus lây lan. Rồi sau đó… mấy ông cán bộ áo vàng xuất hiện.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460661
    m_Localized: 'Jacket: Lúc đó em bắt đầu toát mồ hôi rồi. Xong em nghe họ nói là sẽ bắt người bị nhiễm đi cách ly…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460662
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460663
    m_Localized: 'Jacket: Còn khuya em mới chịu ngồi yên một chỗ để người ta bắt. Thế là em chui ra khỏi cửa sổ rồi chạy luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460664
    m_Localized: 'Jacket: Em vớ được cái áo khoác này trước khi bỏ trốn. Cơ mà lại chẳng biết đi đâu, quanh quẩn một hồi mới mò tới đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460665
    m_Localized: Cậu chỉ đem theo mỗi cái áo thôi à?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460666
    m_Localized: Cậu còn cầm theo gì nữa không?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460667
    m_Localized: 'Jacket: Đúng rồi anh, áo em thích nhất đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460668
    m_Localized: 'Jacket: Em có cầm theo thẻ căn cước với vài món khác nữa, nhưng quý nhất vẫn là chiếc áo này.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460669
    m_Localized: 'Jacket: Mà không phải vì nó đắt tiền hay là hàng hiệu gì đâu anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460670
    m_Localized: 'Jacket: Đây là kỷ vật anh hai để lại cho em đó. Có mấy món như này thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460671
    m_Localized: 'Jacket: Má ơi… Tình hình bên ngoài loạn quá đi mất.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460672
    m_Localized: Anh của cậu có chuyện gì à?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460673
    m_Localized: 'Jacket: Chuyện dài lắm, mà tóm gọn lại thì ảnh bị bên Phòng Chống Thảm Họa bớ đi. Từ đó ảnh biệt tăm tung tích luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460674
    m_Localized: 'Jacket: Hồi trước ảnh làm thủy thủ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460675
    m_Localized: 'Jacket: Chiếc áo khoác này… là quà ảnh mang về từ nước ngoài, sau một chuyến đi biển đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460676
    m_Localized: 'Jacket: Em cứ tưởng ảnh chỉ đem về mấy món be bé thôi, như mấy cây bút bi ngộ nghĩnh, hay là nam châm gắn tủ lạnh…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460677
    m_Localized: 'Jacket: Đâu có ngờ là ảnh móc tiền túi ra mua nguyên cái áo này tặng em đâu! Em cảm động quá trời luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460678
    m_Localized: 'Jacket: Em với ảnh cũng ít khi được gặp nhau, nên là ảnh quan tâm, lo nghĩ tới em vậy làm em vui lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460679
    m_Localized: 'Jacket: Cơ mà món quà này cũng hơi bị phiền nha. Làm em dính vào bao nhiêu rắc rối. Tại vì áo không có bán ở đây mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460680
    m_Localized: 'Jacket: Thấy hàng hiếm lạ, nhiều người ngứa tay tìm cách chôm nó…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460681
    m_Localized: 'Jacket: Nhưng em giữ nó còn hơn giữ vàng, hổng ai lấy được. Đây đâu phải chỉ là cái áo bình thường, mà còn chất chứa kỷ niệm về anh hai nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460682
    m_Localized: 'Jacket: Cầu trời là ảnh vẫn bình an...'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460683
    m_Localized: 'Jacket: Má ơi… Tình hình bên ngoài loạn quá đi mất.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460684
    m_Localized: Biết đâu cậu đến khu cách ly lại tìm được anh trai thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460685
    m_Localized: 'Jacket: Không đơn giản vậy đâu anh ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460686
    m_Localized: 'Jacket: Bên Phòng Chống Thảm Họa không đưa ảnh tới khu cách ly. Mà họ cho ảnh nhập hội luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460687
    m_Localized: Ơ, vậy tức là...
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460688
    m_Localized: Cái đệt
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460689
    m_Localized: 'Jacket: Đúng rồi anh. Ảnh thành cán bộ ở bên đó luôn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460690
    m_Localized: 'Jacket: Mà còn chẳng phải do ảnh tự nguyện nữa. Mấy người đó đến tận nhà ảnh rồi phán: "Duyệt".'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460691
    m_Localized: 'Jacket: Tại bọn đó bắt ép, chứ đời nào ảnh muốn làm. Còn khuya.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460692
    m_Localized: 'Jacket: Nên là bằng mọi giá, em không thể để tụi nó bắt mình được.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460693
    m_Localized: 'Jacket: Không phải chỉ vì em sợ bọn Dị Khách đâu. Thực ra cái này ai mà chẳng sợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460694
    m_Localized: 'Jacket: Ừ thì em hiểu, không biết được kẻ trước mặt mình có phải người hay không cũng hãi lắm chứ... Nhưng chủ yếu em sợ cái khác kìa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460695
    m_Localized: 'Jacket: Lỡ đâu người bắt em đi rồi tống vào khu cách ly... lại chính là anh hai thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460696
    m_Localized: 'Jacket: Tới lúc đó ảnh tính sao đây? Liệu ảnh có phá lệ để thả em đi không? Mà nếu vậy thì người ta sẽ xử ảnh như nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460697
    m_Localized: 'Jacket: Hay là ảnh cứ nhất nhất làm theo mệnh lệnh, áp giải em vào khu cách ly một cách phũ phàng?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460698
    m_Localized: 'Jacket: Rồi lỡ họ ra lệnh cho ảnh bắn em thì sao…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460699
    m_Localized: 'Jacket: Liệu em có yên lòng hơn khi biết... người hành quyết chính là anh ruột mình? Hay cảm giác còn đau hơn gấp bội?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460700
    m_Localized: 'Jacket: Nghĩ kiểu gì cũng thấy oái oăm lắm anh ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460701
    m_Localized: 'Jacket: Tâm trí em đã bộn bề mối lo, rối như tơ vò rồi. Nhưng chỉ có một điều làm em thực sự lo sợ…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460702
    m_Localized: 'Jacket: Đó là nếu lỡ như em bị bắt… có khi em còn chẳng biết được người đeo mặt nạ đó có phải là anh mình hay không.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725184
    m_Localized: 'Tough: Cuộc đời nhiều sóng gió lắm. Chả bao giờ dễ dàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725185
    m_Localized: Chắc chị đã phải trải qua rất nhiều nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725186
    m_Localized: 'Tough: Còn mấy chiếu mới chưa trải có khi ngỏm hết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725187
    m_Localized: 'Tough: Cái tụi làm vua làm chúa ngồi trên đống tài sản ấy, đồng tiền hết giá trị là gãy liền cả đám chứ đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725188
    m_Localized: 'Tough: Sống ở đời mà nhu nhược quá thì chịu kiếp làm nạn nhân thôi. Để mấy đứa hiếp dâm, trục lợi, khùng điên nó hãm hại mày.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725189
    m_Localized: 'Tough: Mày cũng chứng kiến rồi nhở? Con người đang tha hóa thành súc vật. Nhưng chị em mình vẫn giữ được phần người.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725190
    m_Localized: 'Tough: Chúng ta không hạ mình, không sa lầy như tụi nó. Vẫn kiên quyết chống trả, đùm bọc lẫn nhau.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725191
    m_Localized: 'Tough: Chúng ta là những người khát khao được sống.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725192
    m_Localized: 'Tough: Còn những đứa cặn bã, hèn nhát, đầu hàng ấy hả? Kiểu gì cũng bị loại khỏi vòng đời thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725193
    m_Localized: 'Tough: Ờ, nghe có vẻ cực đoan đó, nhưng cuộc sống bây giờ là vậy mà. Không chịu cũng phải chịu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725194
    m_Localized: 'Tough: Giờ mình chỉ còn cách cố mà níu giữ chút tình người còn sót lại. Chị cũng trông là ở đây sẽ khá hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725195
    m_Localized: 'Tough: Cuộc đời nhiều sóng gió lắm. Chả bao giờ dễ dàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725196
    m_Localized: Nói vậy có hơi quá không nhỉ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725197
    m_Localized: 'Tough: Đâu thể cứ phang hoài một điệu "rồi sẽ ổn thôi". Nói thì dễ lắm, nhưng có thay đổi được gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725198
    m_Localized: 'Tough: Dăm ba câu từ sáo rỗng thì nghĩa lý chi. Mày chỉ có hai lựa chọn: một là sẵn sàng đương đầu với chông gai... hai là bỏ chạy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725199
    m_Localized: Sao tôi phải là người đi vỗ về, an ủi kẻ khác chứ?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725200
    m_Localized: Nhưng được nghe câu đó một lần cũng không tệ mà?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725201
    m_Localized: 'Tough: Thì bởi, đúng ý chị mày luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725202
    m_Localized: 'Tough: Có những đứa chả tự lực được cái gì. Mình phải một tay dìu dắt, một tay lau đít cho, làm đủ thứ trò cho tụi nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725203
    m_Localized: 'Tough: Rồi đến lúc phải đứng trên đôi chân mình thì nó lại té dập mặt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725204
    m_Localized: 'Tough: Bể xoang xoảng như ngôi nhà bằng thủy tinh. Một đứa gãy là cả đám sập theo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725205
    m_Localized: 'Tough: Đó, giờ mày niệm câu thần chú "rồi sẽ ổn cả thôi" thì có cứu nổi ai hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725206
    m_Localized: 'Tough: Chị chả muốn trải qua cảm giác đó lần nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725207
    m_Localized: 'Tough: Nơi đây không có chỗ cho kẻ yếu hèn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725208
    m_Localized: "Tough: Ờ, thì chị nói có hơi nặng lời. Tại vì \nký ức vẫn còn ám ảnh."
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725209
    m_Localized: 'Tough: Thôi để lần sau nói tiếp ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725210
    m_Localized: 'Tough: Hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725211
    m_Localized: 'Tough: Rồi để làm gì chớ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725212
    m_Localized: 'Tough: Nói không cũng chả được cái tích sự gì. Có lôi người chết sống lại được hông? Có đem thiến nổi mấy thằng hiếp dâm hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725213
    m_Localized: 'Tough: Người chị đem dao, chứ đéo có đem đường để bỏ vào thuốc nuốt cho trôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725214
    m_Localized: 'Tough: Con người phải học cách thích nghi với thế giới này, không thì chờ chết. Những thứ còn lại đều vô nghĩa hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725215
    m_Localized: 'Tough: Chị hông có ý xỉa xói mày đâu. Nhưng mà lần sau đừng đi hỏi mấy câu ngu học nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725216
    m_Localized: 'Tough: Cuộc đời nhiều sóng gió lắm. Chả bao giờ dễ dàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725217
    m_Localized: Ờm... Chị đang cầm gì thế?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725218
    m_Localized: 'Tough: Chị nói thẳng với mày luôn nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725219
    m_Localized: 'Tough: Chị để ý thấy mày hay nhìn chằm chằm vô cái hộp trong nhà kho kia. Thấy mày đứng như chết lặng trước cửa sổ phòng ngủ.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725220
    m_Localized: 'Tough: Tối qua chị có lén ngó thử. Mày đang bị cầm tù trong căn nhà này đấy, em ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725221
    m_Localized: 'Tough: Chú mày không đấu tranh để được sống, mà chỉ sợ sệt hông dám chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725222
    m_Localized: 'Tough: Chị nói có đúng chưa nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725223
    m_Localized: Đúng gì mà đúng
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725224
    m_Localized: Đéo phải việc của chị
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725225
    m_Localized: 'Tough: Xạo chó em ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725226
    m_Localized: "Tough: Chị thấy cơ thể mày cứng ngắc \ncứng đờ rồi."
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725227
    m_Localized: 'Tough: Chẳng qua mày sợ nên mới không dám nã một phát vô đầu thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725228
    m_Localized: 'Tough: Lúc đầu chị tưởng mày đã trải qua bao nhiêu biến cố cuộc đời, bị vùi dập đến chai sạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725229
    m_Localized: 'Tough: Vậy mà rốt cuộc mày cũng chỉ là một đứa nhát cáy, vì ăn may nên thoát nạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725230
    m_Localized: 'Tough: Chị... thực sự thất vọng về mày.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725231
    m_Localized: 'Tough: Thôi, chán rồi. Chả muốn nói chuyện gì với mày nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725232
    m_Localized: 'Tough: Mày làm chị nhớ tới cái đứa học sinh ngây thơ, bị lũ bắt nạt dồn vô chân tường.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725233
    m_Localized: 'Tough: Chị nói có sai đâu. Mày chỉ là thằng yếu đuối may mắn vớ được khẩu súng.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725234
    m_Localized: 'Tough: Có vậy mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725235
    m_Localized: 'Tough: Lúc đầu chị tưởng mày đã trải qua bao nhiêu biến cố cuộc đời, bị vùi dập đến chai sạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725236
    m_Localized: 'Tough: Vậy mà rốt cuộc mày cũng chỉ là một đứa nhát cáy, vì ăn may nên thoát nạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725237
    m_Localized: 'Tough: Chị... thực sự thất vọng về mày.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725238
    m_Localized: 'Tough: Thôi, chán rồi. Chả muốn nói chuyện gì với mày nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725239
    m_Localized: 'Tough: Cuộc đời nhiều sóng gió lắm. Chả bao giờ dễ dàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725240
    m_Localized: Chị còn lén lút thăm dò gì nữa không đấy?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725241
    m_Localized: 'Tough: Chị sẵn sàng làm tất cả vì hai chữ "sinh tồn".'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725242
    m_Localized: 'Tough: Chị phải biết trước là mình đang đối đầu với ai. Và phải đề phòng cái gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725243
    m_Localized: 'Tough: Căn nhà này chất đầy kỷ niệm. Bóng ma của những người thân đã khuất.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725244
    m_Localized: 'Tough: Làm chị dấy lên suy nghĩ... là mày vẫn chưa buông bỏ được quá khứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725245
    m_Localized: 'Tough: Mà thôi, cũng chả phải chuyện của chị.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725246
    m_Localized: 'Tough: Chỉ là...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725247
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725248
    m_Localized: 'Tough: Có một thời chị còn dịu dàng. Trẻ trung, non dại. Chị gặp một thằng con trai.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725249
    m_Localized: 'Tough: Nó kêu là có đồ gì cần đưa cho mẹ, nên hai đứa phải ghé qua nhà nó. Chị đâu có muốn vô trong.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725250
    m_Localized: 'Tough: Nên là chị đứng ngoài đợi, nhưng rồi một lát sau nó thò đầu ra cửa sổ gọi chị lên ơi ới.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725251
    m_Localized: 'Tough: Xong lúc chị lên, thì chả có bà mẹ nào hết. Chỉ có nó... với thằng bạn khốn nạn đang chờ sẵn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725252
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725253
    m_Localized: 'Tough: Rồi khi thảm họa ập đến, chị tìm ra lũ chó má đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725254
    m_Localized: 'Tough: Giải quyết xong... cũng chả thấy khá khẩm hơn là mấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725255
    m_Localized: 'Tough: Suốt một thời gian dài, chị phải sống với cảm giác bẩn thỉu trong người, không tài nào gột rửa được... Nhưng rồi thế gian sụp đổ.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725256
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725257
    m_Localized: 'Tough: Mấy đứa chó đẻ như nó không đáng nhận sự thương xót. Cả tụi yếu hèn cũng vậy, chỉ tổ dung túng cho bọn nó lộng hành.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725258
    m_Localized: 'Tough: Chị hông lục lọi đồ của mày nữa đâu. Nhưng mày hiểu ý chị rồi nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725259
    m_Localized: 'Bald: 1, 2, 3, 4… Hay thôi đốt trụi hết đi… Giỡn đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725260
    m_Localized: Mấy người bạn của anh sao rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725261
    m_Localized: 'Bald: À! Tụi tui học chung trường sân khấu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725262
    m_Localized: 'Bald: Tui chuyên ngành sản xuất. Mà nói thiệt, đừng dại dột giống tui mà đâm đầu vô cái ngành bạc bẽo này.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725263
    m_Localized: 'Bald: À không, đúng hơn là đừng dính dáng gì tới ba cái nghề sân khấu. Dòm hào nhoáng vậy thôi, chớ còn mấy ai thiệt sự coi trọng nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725264
    m_Localized: 'Bald: Nhưng mà nếu anh muốn "cống hiến cho nghệ thuật", chấp nhận cạp đất mà ăn suốt đời thì cứ việc.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725265
    m_Localized: 'Bald: Ừ thì đúng là có các đoàn bự bự biểu diễn ở vài ba rạp nổi tiếng, mà hiếm lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725266
    m_Localized: 'Bald: Còn lại thì mấy đoàn khác đều nghèo rớt mùng tơi. Giờ người ta chỉ khoái coi phim, tại nó rẻ bèo, dễ hiểu, bóng bẩy, nịnh mắt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725267
    m_Localized: 'Bald: Đó… Nói chung là vô làm thì chỉ có thất vọng thôi anh à.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725268
    m_Localized: 'Bald: 1, 2, 3, 4… Hay thôi đốt trụi hết đi… Giỡn đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725269
    m_Localized: Ừ, công nhận nghề anh bạc vãi. Còn bạn bè anh thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725270
    m_Localized: 'Bald: Ủa, quên mất vụ đó. Xin lỗi anh, tui hông tập trung được, đầu óc dễ phân tâm, thành ra hay lạc đề lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725271
    m_Localized: 'Bald: Đám bạn tui toàn dân trong nghề, từ diễn viên, sản xuất tới âm thanh, ánh sáng, tùm lum hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725272
    m_Localized: 'Bald: Từ hồi mới quen là tụi tui đã rủ nhau đi nhậu. Bữa sinh nhựt tui còn thuê nguyên một cái sân khấu nhỏ. Khách khứa đồ phải tới trăm người!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725273
    m_Localized: 'Bald: Dzui xỉu! Anh cứ tưởng tượng cảnh cả trăm người tới để mừng sinh nhựt mình đi! Chèn ơi, thời đó mới tươi đẹp làm sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725274
    m_Localized: 'Bald: Mà có điều giới sân khấu cũng khốn nạn bỏ bà. Ai cũng muốn đạp người khác xuống rồi đẩy mình lên. Đã hổng có tiền mà còn áp lực chết mẹ.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725275
    m_Localized: 'Bald: Dần dần, mấy bữa tiệc kiểu đó cũng không còn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725276
    m_Localized: 'Bald: Lúc đó, tui chợt nhận ra rằng mấy người tới dự sinh nhựt của mình hổng phải bạn… mà chỉ là... bè.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725277
    m_Localized: 'Bald: Tụi nó tranh thủ lợi dụng, nói xấu sau lưng tui.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725278
    m_Localized: 'Bald: Ê mà đừng tưởng tui hiền tui nhịn nghen! Tui ngồi lọc danh sách, liệt kê mấy đứa ăn cháo đá bát. Đá ra chuồng gà luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725279
    m_Localized: 'Bald: 1, 2, 3, 4… Hay thôi đốt trụi hết đi… Giỡn đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725280
    m_Localized: Thế mấy người bạn còn lại trong danh sách của anh đâu hết rồi?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725281
    m_Localized: 'Bald: Lúc bị đám đòi nợ dí thì tui có đi tìm người cứu giúp.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725282
    m_Localized: 'Bald: Mà lúc đó mặt trời bắt đầu nóng như rang, đã vậy còn thêm tụi Dị Khách nữa. Chuyện của tui đang TỆ, giờ thành NÁT luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725283
    m_Localized: 'Bald: Tui tới nhà từng đứa bạn…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725284
    m_Localized: 'Bald: Thì mới biết là một đứa chết trụi do nhậu xỉn, ngủ quên ngoài sân chơi tới sáng rồi bị mặt trời đốt cho thành tro.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725285
    m_Localized: 'Bald: Một thằng khác thì bị giết… tại người ta tưởng nó là Dị Khách! Tin được không chứ trời?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725286
    m_Localized: 'Bald: Loạn hết rồi! Bạn tui bị chết oan chỉ vì ba cái "dấu hiệu" xàm chó.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725287
    m_Localized: 'Bald: Đụ má, tui tức điên. Giờ vẫn còn đang chìm trong cảm xúc lẫn lộn, không biết làm gì cho nó nguôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725288
    m_Localized: 'Bald: Vừa tức vừa bất lực, tui cứ như bị đơ, cả người đóng băng vậy. Chỉ còn biết ghét bỏ hết mọi người xung quanh... với cả bản thân mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725289
    m_Localized: 'Bald: Mẹ nó… mấy thằng chó chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725290
    m_Localized: 'Bald: 1, 2, 3, 4… Hay thôi đốt trụi hết đi… Giỡn đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725291
    m_Localized: Thế còn lũ đòi nợ thì sao?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725292
    m_Localized: 'Bald: Tui ở chung với bà, với má.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725293
    m_Localized: 'Bald: Má tui làm phục trang. Còn ông già tui thì bỏ đi biệt. Ổng là diễn viên, đúng kiểu trung bình mấy thằng sân khấu: vừa bợm nhậu, vừa lăng nhăng.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725294
    m_Localized: 'Bald: Từ nhỏ má đã ráng che chở tui, tự mình gồng gánh đủ chuyện. Lớn lên rồi tui mới biết hồi đó cả nhà sống chật vật, khó khăn tới cỡ nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725295
    m_Localized: 'Bald: Hiếm có chỗ nào chịu thuê má. Đoàn lớn thì nằm mơ cũng không có cửa, còn gánh hát nhỏ thì việc ít mà lương bèo bọt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725296
    m_Localized: 'Bald: Vậy là má lâm vào cảnh nợ nần. Má không dám đi vay người quen, mà tìm một công ty nào đó, chỉ để cho cả nhà có miếng ăn qua ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725297
    m_Localized: 'Bald: Rồi thì dĩ nhiên là không trả được. Vậy là tụi đòi nợ mới bắt đầu mò tới tận nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725298
    m_Localized: 'Bald: Cả nhà tui có một quy tắc nghiêm ngặt: đừng bao giờ mở cửa nếu không hẹn ai trước.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725299
    m_Localized: 'Bald: Về tới nhà mà thấy một đám người lảng vảng, thì cứ đi dạo ở ngoài thêm vài tiếng đi rồi tính.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725300
    m_Localized: 'Bald: Kinh khủng lắm anh à.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725301
    m_Localized: 'Bald: Xong rồi lúc thảm họa ập tới thì ai cũng hóa thú dữ. Đám đòi nợ lại càng hung hãn hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725302
    m_Localized: 'Bald: Có bữa tui về nhà thấy cửa mở toang hoác, đồ đạc đổ nát. Còn má với bà… thì tay gãy, chân gãy, toàn thân tàn tạ. Mẹ nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725303
    m_Localized: 'Bald: Đụ má… đúng là ác mộng.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725304
    m_Localized: 'Bald: Rồi sau đó có hai thằng to xác xuất hiện…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725305
    m_Localized: 'Bald: Dĩ nhiên thấy tụi nó là tui chạy luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725306
    m_Localized: 'Bald: Sợ hồn vía lên mây.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725307
    m_Localized: 'Bald: Đụ má, sao mà tui hận bản thân mình quá. Không có gan bảo vệ cả nhà, mà chỉ biết bỏ chạy như thằng hèn. Đi một mạch luôn, hổng dám quay về.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725308
    m_Localized: 'Bald: Tại... tui sợ quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725309
    m_Localized: 'Bald: Sợ một cách nhỏ nhen, ích kỷ.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725310
    m_Localized: 'Bald: Tui đúng là… thằng tệ bạc, vô phương cứu chữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725311
    m_Localized: 'Nervous: Tớ không muốn quay lại đấy đâu, hí hí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725312
    m_Localized: Cậu có vẻ... không được bình thường lắm
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725313
    m_Localized: 'Nervous: Thì sao? Ảnh hưởng gì đến bát ăn đằng ấy? Hả? Hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725314
    m_Localized: 'Nervous: Đằng ấy cũng bám đuôi tớ hay sao? Hửm? Hửm?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725315
    m_Localized: 'Nervous: Nói cho mà biết, tớ không ưa cái kiểu ấy đâu nhé. Từ hồi ở trong nhà thương điên điên khùng khùng đã không ưa rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725316
    m_Localized: 'Nervous: Tớ bị bố mẹ tống vào trại mà, đằng ấy tưởng tượng mà xem. Hí hí!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725317
    m_Localized: 'Nervous: Ừ thì... họ bảo do tớ cứ thích đi rình rậ...p người khác. Nhưng thế thì có sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725318
    m_Localized: 'Nervous: Tớ đã làm gì sai đâu nào, hí hí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725319
    m_Localized: 'Nervous: Thế mà bố mẹ cứ khăng khăng là tớ bị điênnnnnn. Chắc bây giờ vẫn nghĩ thế đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725320
    m_Localized: 'Nervous: Họ nhốt tớ trong trại tâm thần tận mười năm mà. Cứ làm như tớ là sát nhân điên loạn gì không bằng ý, hí hí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725321
    m_Localized: 'Nervous: Mà tất cả cũng chỉ tại cái lần ấy thôi... cái lần mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725322
    m_Localized: 'Nervous: À, thôi kệ đi. Tớ phải gọi điện cho khách sạn cái đã. Reng reng reng!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725323
    m_Localized: 'Nervous: Tớ không muốn quay lại đấy đâu, hí hí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725324
    m_Localized: Hôm trước cậu đang kể dở chuyện gì ấy?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725325
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725326
    m_Localized: 'Nervous: Hồi đi học, tớ bị bắt nạt. Chẳng bao giờ chúng nó để tớ yên. Ngày nào cũng lôi ra làm trò tiêu khiển. Cứ chọc, chọc, ngoáy, ngoáy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725327
    m_Localized: 'Nervous: Xong tớ tức nước vỡ bờ chứ. Có phải cái bao cát tập đấm đâu. Cũng chẳng phải cái bị thịt, để chúng nó thích hành hạ thế nào thì hành...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725328
    m_Localized: 'Nervous: Thế là tớ đánh lại. Nó ngã cái rầm xuống... rồi không dậy nữa. Nghe đâu nó phải nằm v...iện. Rồi thăng luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725329
    m_Localized: 'Nervous: Tớ đâu cố ý giết người. Nhưng mà ái dồi ôi... bố mẹ tớ cũng lo lót êm xuôi cả rồi. Hí hí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725330
    m_Localized: 'Nervous: Thế mà chúng nó vẫn cứ xì xào to nhỏ về tớ... Đằng ấy có nghe thấy tiếng thì thầm không? Suỵtttt...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725331
    m_Localized: 'Nervous: Rồi họ cho tớ một vé vào nhà thương điên. Đấy, lại quay về cái lò gạch cũ!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725332
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725333
    m_Localized: 'Nervous: Cái lần đánh trả đó... Sướng thật ý... Có sức m... mạnh... Để bá... o th... ù...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725334
    m_Localized: 'Nervous: Nắm tay tớ ê ẩm, nhưng mà phê ác. Cái vị tanh tanh mằn mặn trên môi, tan vào trong lưỡi... Ứ ừ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725335
    m_Localized: 'Nervous: Sao tớ lại bị đuổi nhỉ? Tớ chỉ tự vệ thôi mà, hí hí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725336
    m_Localized: 'Nervous: Tớ không muốn quay lại đấy đâu, hí hí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725337
    m_Localized: Vào nhà thương điên mà chẳng thấy đỡ hơn chút nào nhỉ
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725338
    m_Localized: 'Nervous: Chẳng được tí tẹo tèo teo nào luôn ý, hí hí.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725339
    m_Localized: 'Nervous: Nốc một đống thuốc vào, ban đầu thì phê pha lắm... mà sau thì phê sắc phế cả người!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725340
    m_Localized: 'Nervous: Tớ chẳng khá lên tẹo nào. Chẳng thấy dễ sống hơn gì cả. Mười năm trôi qua, tớ cũng được thả ra ngoài. Tèn tén ten!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725341
    m_Localized: 'Nervous: Tất cả chỉ vì cái lần bé xíu xìu xiu ý thôi, lúc mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725342
    m_Localized: 'Nervous: Hí hí hí hí hí hí...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725343
    m_Localized: 'Nervous: Ô, làm như trên đời chẳng ai mắc sai lầm bao giờ ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725344
    m_Localized: 'Nervous: Nhìn cái mặt đằng ấy kìa... sắp sửa xét nét nọ kia rồiii đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725345
    m_Localized: 'Nervous: Muốn đánh tớ phớ hôn? Xin mờiii!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725346
    m_Localized: 'Nervous: Đấm cho nát nhừ mặt tớ đi! Vặn gãy từng đốt ngón tay đi! Á Á Á... ĐÚNG RỒI! Mạnh hơn nữa, bạo hơn nữa, làm tớ lên đỉnh đi! Sướnggg quááááá!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725347
    m_Localized: 'Nervous: Ơ? Đằng ấy không đánh tớ hả? Không thấy ngứa tay à?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725348
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725349
    m_Localized: 'Nervous: Hí hí... Thế thôi tớ cứ chờ ở đây vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725350
    m_Localized: 'Nervous: Thực ra... ở đây tớ lại thấy yên tâm hơn so với ở khách sạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725351
    m_Localized: 'Nervous: Cảm ơn đằng ấy đã cho tớ vào nhé. Hí hí...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725352
    m_Localized: 'Nervous: Ít ra thì bọn mình cũng được điên cùng nhau mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725353
    m_Localized: 'Leper: Ừ, sao thế?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725354
    m_Localized: Anh bị như này có khổ không?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725355
    m_Localized: 'Leper: Ờm, cũng không đến nỗi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725356
    m_Localized: 'Leper: Mỗi tội hồi đi học, tụi nó toàn gọi tôi là thằng hủi. Chả ai thèm chơi với tôi. Sợ bị lây bệnh hay sao đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725357
    m_Localized: 'Leper: Tôi cứ nghĩ là khi nào lớn lên, mọi chuyện sẽ khác thôi. Ừ thì cũng... đúng thật. Thi thoảng vẫn bị người ta nhìn, nhưng chuyện nhỏ thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725358
    m_Localized: 'Leper: Xong tự nhiên thảm họa xảy ra, thế là bao nhiêu định kiến lại trồi lên như cũ.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725359
    m_Localized: 'Leper: Thậm chí còn khổ hơn trước, vì giờ nó là vấn đề sống còn nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725360
    m_Localized: 'Leper: Chỉ tại da dẻ như này khiến tôi trông như Dị Khách vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725361
    m_Localized: 'Leper: Biết sao được giờ? Thời buổi khó khăn, con người ta mới bộc lộ mặt xấu nhất của mình ra mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725362
    m_Localized: 'Leper: Ừ, sao thế?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725363
    m_Localized: Chỉ vì da anh bị vậy mà họ quy chụp anh là Dị Khách à?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725364
    m_Localized: 'Leper: Đúng rồi. Chứ còn sao nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725365
    m_Localized: 'Leper: Giờ ở ngoài người ta đang truy lùng gắt lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725366
    m_Localized: 'Leper: Ai mà không như người "bình thường" thì bị bắt hết. Quyền sinh sát nằm trong tay bọn Phòng Chống Thảm Họa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725367
    m_Localized: 'Leper: Bởi vậy nên tôi mới nghĩ, biết đâu chính bọn nó là kẻ đứng sau tất cả?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725368
    m_Localized: 'Leper: Lỡ ba vụ Dị Khách này đều do tụi nó bịa ra thì sao? Cậu nghĩ thế nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725369
    m_Localized: Nghe cũng có lý
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725370
    m_Localized: Tôi nghĩ Dị Khách có thật mà
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725371
    m_Localized: 'Leper: Cậu cũng nghĩ vậy à, hay quá. Dị Khách cái củ cặc ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725372
    m_Localized: 'Leper: Làm như đang đóng phim hay gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725373
    m_Localized: 'Leper: Hay đây là cách họ lật đổ chính quyền nhỉ. Quyền lực nằm trong tay kẻ biết thao túng nỗi sợ mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725374
    m_Localized: 'Leper: Nên chắc cứ thấy ai phản đối là bọn nó tống hết vào "khu cách ly".'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725375
    m_Localized: 'Leper: Xong còn ra vẻ anh hùng, ta đây ra sức đẩy lùi Dị Khách nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725376
    m_Localized: 'Leper: Dù cho Dị Khách không có thật đi nữa, tôi cũng chẳng muốn rơi vào tay bọn Thảm Hại đó đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725377
    m_Localized: 'Leper: Cảm giác nếu mà tóm được, bọn nó sẽ lôi tôi ra hành hạ kinh khủng lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725378
    m_Localized: 'Leper: Cậu nghĩ vậy thật hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725379
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725380
    m_Localized: 'Leper: Cứ cho là đúng đi nữa, cậu không thấy bọn áo vàng đang hành xử rất kỳ lạ à?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725381
    m_Localized: 'Leper: Tụi nó bảo Dị Khách là do virus, nhưng virus lây lan như nào thì chẳng thèm giải thích luôn?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725382
    m_Localized: 'Leper: Muốn ngăn dịch bệnh thì trước tiên phải làm rõ điều này chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919488
    m_Localized: 'Leper: Hay bọn nó đang chế tạo "phương thuốc chữa trị" gì đó? Thôi chả biết nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919489
    m_Localized: 'Leper: Mà tôi cứ linh cảm rằng... nếu chẳng may bị bắt vào khu cách ly, chờ đón tôi chỉ có kết cục bi thảm.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919490
    m_Localized: 'Leper: Ừ, sao thế?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919491
    m_Localized: Tại sao anh nghĩ bên Phòng Chống Thảm Họa là người xấu?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919492
    m_Localized: 'Leper: Thì bọn nó có coi tôi ra người ra ngợm gì đâu. Chỉ nhìn tôi như con bệnh mà thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919493
    m_Localized: 'Leper: Bị như này càng dễ trở thành mục tiêu cho tụi nó săn lùng. Càng có khả năng tôi bị bọn chó đó bắt đi... để làm thí nghiệm.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919494
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919495
    m_Localized: 'Leper: Tất cả chỉ vì da dẻ tôi như này. Mẹ kiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919496
    m_Localized: Anh ở trong này rồi, không phải lo gì nữa
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919497
    m_Localized: Anh cứ lo bò trắng răng
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919498
    m_Localized: 'Leper: Thế hả? Hóa ra bọn nó chưa đến gõ cửa nhà cậu à?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919499
    m_Localized: 'Leper: Cậu nghĩ nó mà trông thấy tôi như này thì sẽ bỏ qua luôn chắc?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919500
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919501
    m_Localized: 'Leper: À vậy đó hả?! Thế cậu đã nghe vụ cháy trường mầm non chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919502
    m_Localized: 'Leper: Cái vụ mà cha mẹ tự tay thiêu sống con mình luôn ấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919503
    m_Localized: 'Leper: Cậu không biết đâu, xã hội bây giờ tiến hóa ngược vài trăm năm rồi. Dân tình thì lây hết bệnh điên cho nhau, còn bọn Thảm Hại đục nước béo cò.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919504
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919505
    m_Localized: 'Leper: Tôi chỉ ước sao người ta thôi trông mặt mà bắt hình dong đi. Suốt ngày nhìn ngoại hình mà phán xét.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919506
    m_Localized: 'Leper: Nhưng coi bộ xa vời quá. Giang sơn dễ đổi, bản tính khó dời. Nhân loại có tồn tại bao nhiêu đời kiếp vẫn cứ quen thói quy chụp, vơ đũa lẫn nhau.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919507
    m_Localized: 'Leper: Như thế dễ phân biệt đối xử hơn hẳn. Đứa nào được hòa nhập với cộng đồng, đứa nào lạc loài đáng bị tẩy chay.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919508
    m_Localized: 'Leper: Chính vì tư duy thiển cận và tàn nhẫn đó, những người như tôi mới phải gánh chịu hậu quả.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919509
    m_Localized: 'Leper: Nói chung là... buồn lắm cậu ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891008
    m_Localized: 'Fairytaller: Anh cần gì ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891009
    m_Localized: Nhìn cậu đăm chiêu vậy
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891010
    m_Localized: Anh cần kiểm tra cậu
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891011
    m_Localized: Đưa giấy triệu tập của CQPCTHLB
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891012
    m_Localized: 'Fairytaller: Em đang nhớ lại câu chuyện cổ tích được nghe hồi bé. Chuyện kể về những chú chim sẻ sống trong một khu rừng ma thuật...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891013
    m_Localized: 'Fairytaller: Một ngày nọ, có con rồng bay đến. Nó thiêu rụi hết những chú chim, tổ chim, rồi cả khu rừng... Tất cả mọi thứ cháy sạch.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891014
    m_Localized: 'Fairytaller: Xét cho cùng, rồng và chim là hai loài bình đẳng. Đều có cánh, đều bay lượn trên trời. Cả hai chung sống thuận hòa, hưởng quả ngọt từ khu rừng.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891015
    m_Localized: 'Fairytaller: Thế nhưng sức mạnh vô song của rồng đã làm mờ mắt nó, khiến nó khè lửa thiêu rụi tất cả, kể cả những thứ nó từng trân quý.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891016
    m_Localized: 'Fairytaller: Bố em thì quan niệm rằng, có một con rồng đang ngủ yên trong mỗi chúng ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891017
    m_Localized: 'Fairytaller: Lúc đấy, cả chị gái và em đều thấy buồn cười. Hai đứa sẽ khịt mũi: "Nhưng loài rồng thì to lớn, còn con người mình lại bé tí ti".'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891018
    m_Localized: 'Fairytaller: Mãi đến khi khôn lớn thì em mới hiểu ra. Chỉ tiếc là bố chẳng còn đây để thấy được điều đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891019
    m_Localized: 'Fairytaller: Từ đó đến nay, em vẫn luôn tự hỏi... Liệu mình có thể diệt trừ được con rồng trong tâm, hay sẽ bị nó nuốt chửng đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891020
    m_Localized: 'Fairytaller: Anh cần gì ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891021
    m_Localized: Lại đang suy nghĩ về truyện cổ tích à?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891022
    m_Localized: Anh cần kiểm tra cậu
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891023
    m_Localized: Đưa giấy triệu tập của CQPCTHLB
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891024
    m_Localized: 'Fairytaller: Vâng. Hôm nay em lại nhớ đến một truyện khác. Kể về Thành Phố Băng Giá, nơi có những bức tường cao vút và tòa tháp phủ đầy tuyết lạnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891025
    m_Localized: 'Fairytaller: Ở đó ai cũng nghi kỵ lẫn nhau, cứ sống như thế suốt hàng bao thế kỷ. Ngỡ đâu nơi đây sẽ mãi mãi chìm trong cái lạnh thấu tâm can...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891026
    m_Localized: 'Fairytaller: ...thì đến một ngày, có một nghệ nhân làm kính ghé vào thành phố. Kể từ dạo đấy, mọi thứ dần dần đổi thay.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891027
    m_Localized: 'Fairytaller: Ông ấy thắp sáng các con phố bằng những chiếc đèn do chính tay mình làm. Ông cũng không quên chào hỏi hàng xóm mỗi sớm mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891028
    m_Localized: 'Fairytaller: Ban đầu, người dân thành phố cứ cười vào mặt ông. Nhưng dần dần, trái tim băng giá của họ bắt đầu tan chảy trước hơi ấm đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891029
    m_Localized: 'Fairytaller: Từ ấy, em hiểu rằng mọi thứ không thể thay đổi chỉ trong một sớm một chiều. Sự thay đổi đích thực phải xuất phát từ trong tim chúng ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891030
    m_Localized: 'Fairytaller: Dù cho thế giới xung quanh có tối tăm mịt mù, hãy cứ thắp sáng ngọn đèn trong mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891031
    m_Localized: 'Fairytaller: Mẹ em lúc sinh thời thường hay đùa rằng, bài học chỉ đơn giản là: "Mòn mỏi chờ đợi thay đổi, chỉ khiến ta mang đợi chờ xuống mồ cùng".'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891032
    m_Localized: 'Fairytaller: Xét cho cùng, chính chúng ta là người quyết định sự tồn vong của thế giới. Nếu không chịu nỗ lực, thì ta đã thất bại ngay từ đầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891033
    m_Localized: 'Fairytaller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891034
    m_Localized: 'Fairytaller: Dù có chịu khổ đau, em vẫn chọn cách sống tử tế và trọn vẹn tình người. Hy vọng bất chấp tuyệt vọng rằng, mọi người rồi sẽ thấy được tia sáng.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891035
    m_Localized: 'Fairytaller: Anh cần gì ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891036
    m_Localized: Cậu còn câu chuyện nào không? Kể tiếp đi
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891037
    m_Localized: Anh cần kiểm tra cậu
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891038
    m_Localized: Đưa giấy triệu tập của CQPCTHLB
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891039
    m_Localized: 'Fairytaller: Em vẫn còn nhiều chứ... Như là chuyện về kẻ chết sống dậy, và cuộc đời của những người bị bỏ lại phía sau...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891040
    m_Localized: 'Fairytaller: Về một con ác quỷ đội lốt người, gõ cửa từng nhà và tra hỏi tới tận lúc bình minh...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891041
    m_Localized: 'Fairytaller: Về cơn thịnh nộ của vầng thái dương đỏ thẫm giáng xuống nhân loại, nguyền rủa mọi vụ mùa và hút cạn những dòng sông.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891042
    m_Localized: 'Fairytaller: Nhưng rồi sẽ có một linh hồn quả cảm, hay một nhóm người can trường, hoặc cả một quốc gia đứng lên cứu lấy thế giới.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891043
    m_Localized: 'Fairytaller: Cái thiện sẽ luôn chiến thắng gian tà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891044
    m_Localized: 'Fairytaller: Em muốn tin rằng tất cả những bi kịch này sẽ qua đi. Rồi đến một năm, hay một ngày, hoặc chỉ một khoảnh khắc, mọi chuyện sẽ kết thúc.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891045
    m_Localized: 'Fairytaller: Và cha mẹ của ta vẫn còn sống. Và tất cả mọi người được tự do làm điều mình thích. Và rồi…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891046
    m_Localized: 'Fairytaller: Ối, xin lỗi anh. Em nhỡ thao thao bất tuyệt rồi. Phiền anh để em yên một lúc được không ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891047
    m_Localized: 'FunnyGuy: Bây giờ tha hồ sống vô tư vô lo rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891048
    m_Localized: Bác có chắc là ngân hàng quên luôn khoản vay của bác không?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891049
    m_Localized: Tôi cần kiểm tra bác
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891050
    m_Localized: Đưa giấy triệu tập của CQPCTHLB
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891051
    m_Localized: 'FunnyGuy: Mày đùa bác đấy hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891052
    m_Localized: 'FunnyGuy: Ông cháu ơi, tận thế tới đít rồi! Ngân hàng ngân hiếc, kinh tế kinh tủng gì nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891053
    m_Localized: 'FunnyGuy: Chẳng có ma nào quan tâm đâu. Bác đã chứng kiến tận mắt rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891054
    m_Localized: 'FunnyGuy: Mỗi lần trễ hạn thanh toán là bác bị nó gửi cả đống thông báo, cảnh báo, đe dọa đủ các kiểu con đà điểu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891055
    m_Localized: 'FunnyGuy: Nhưng lần này thì không nhé... bọn nó im hơi lặng tiếng luôn. Tuyệt vời chưa?!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891056
    m_Localized: 'FunnyGuy: Con nợ thì buổi tối mới dám ra ngoài, thách chúng nó làm gì được.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891057
    m_Localized: 'FunnyGuy: Với cả giờ cũng chả ai thèm cho vay nữa đâu. Bác thử rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891058
    m_Localized: 'FunnyGuy: Mà thôi! Thoát khỏi xiềng xích nô lệ đồng tiền là đã thắng lớn rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891059
    m_Localized: Tôi mà là bác thì tôi chưa hết lo đâu
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891060
    m_Localized: Thế mình chuẩn bị mở tiệc được chưa nào?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891061
    m_Localized: 'FunnyGuy: Trời ơi, mày tha cho bác đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891062
    m_Localized: 'FunnyGuy: Lo làm gì cho mệt óc? Chúng nó chả thèm quan tâm cái mạng này nữa đâu. Chắc đang bận đào hầm trú ẩn các thứ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891063
    m_Localized: 'FunnyGuy: Việc gì phải tốn công lùng sục thằng nhà quê như bác?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891064
    m_Localized: Thế sao bác không thư thả ở nhà mình đi?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891065
    m_Localized: Thế bác vào đây chỉ để khoe thôi à?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891066
    m_Localized: 'FunnyGuy: Chơi luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891067
    m_Localized: 'FunnyGuy: Hôm nay bác vui lắm, chỉ muốn nói chuyện cả ngày thôi! Hà hà!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891068
    m_Localized: Thế sao bác không thư thả ở nhà mình đi?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891069
    m_Localized: Thế bác vào đây chỉ để khoe thôi à?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891070
    m_Localized: 'FunnyGuy: Ừ thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891071
    m_Localized: 'FunnyGuy: Lúc trước bác cho người khác ở thuê. Thật ra giờ họ vẫn đang ở, nhưng tiền bạc còn nghĩa lý gì nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891072
    m_Localized: 'FunnyGuy: Cứ đi lang thang đâu đó, phá cửa nhà này nhà nọ, vơ được gì thì vơ thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862528
    m_Localized: FunnyGuy:...
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862529
    m_Localized: 'FunnyGuy: Thì làm sao? Mày bĩu môi chê trách bác à?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862530
    m_Localized: "Sao bác không trả lời đi? \nLại đánh trống lảng thế?"
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862531
    m_Localized: À thôi kệ đi, tôi cũng chả quan tâm
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862532
    m_Localized: 'FunnyGuy: Ông cháu này, cứ phải đá xoáy bác thế. Bác có nói gì xấu đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862533
    m_Localized: 'FunnyGuy: Hầy, đùa gì mà ác ý quá, bác cũng biết tổn thương chứ bộ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862534
    m_Localized: 'FunnyGuy: Mày làm bác xụi lơ luôn. Hết vui nổi rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862535
    m_Localized: Sao bác không trả lời đi? Lại đánh trống lảng thế?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862536
    m_Localized: À thôi kệ đi, tôi cũng chả quan tâm
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862537
    m_Localized: 'FunnyGuy: Rồi, rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862538
    m_Localized: 'FunnyGuy: Nghe bác nói này...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862539
    m_Localized: 'FunnyGuy: Đâu phải bác đánh trống lảng gì. Chẳng qua... bác sợ, được chưa? Bác sợ quay lại đấy lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862540
    m_Localized: 'FunnyGuy: Bác cho một gia đình hai người thuê nhà, họ giúp bác đóng tiền trả góp cho ngân hàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862541
    m_Localized: 'FunnyGuy: Mà giờ thì... má... chả biết họ có còn là người không nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862542
    m_Localized: 'FunnyGuy: Hàng xóm ở đó gọi cho bác nhiều lần rồi. Bảo là có tiếng đập cửa, la hét suốt, với nhiều người ra vào lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862543
    m_Localized: 'FunnyGuy: Cơ mà hàng xóm bác toàn mấy ông bà già yếu bóng vía với lo xa. Rồ hết cả đầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862544
    m_Localized: 'FunnyGuy: Nhưng ai biết được, nhỡ họ nói đúng thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862545
    m_Localized: 'FunnyGuy: Từ từ, để bác kể nốt chuyện đã.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862546
    m_Localized: 'FunnyGuy: Bác phải kể ra mới yên lòng được. Mày nghe xem có tréo ngoe không nhé...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862547
    m_Localized: 'FunnyGuy: Mua nhà để ở, mà giờ sợ quá chẳng dám qua đấy sống.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862548
    m_Localized: 'FunnyGuy: Cho người ta thuê nhà, rồi lấy tiền thuê để trả nợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862549
    m_Localized: 'FunnyGuy: Thế mà giờ thì... Tổ sư nó nữa chứ... đến cái chuông cửa bác còn chả dám bấm.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862550
    m_Localized: 'FunnyGuy: Hàng xóm bác bảo chỗ đấy giờ nhiều chuyện lạ lắm. Người thuê kín cửa cài then, hầu như chẳng ra khỏi nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862551
    m_Localized: 'FunnyGuy: Ừ thì công nhận, giờ khỏi phải lo nợ ngân hàng nữa rồi. Cơ mà bác cũng chả dám về để đuổi mấy người đó đi đâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862552
    m_Localized: 'FunnyGuy: Bây giờ tha hồ sống vô tư vô lo rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862553
    m_Localized: Có tin tức gì về gia đình thuê nhà bác chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862554
    m_Localized: Tôi cần kiểm tra bác
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862555
    m_Localized: Đưa giấy triệu tập của CQPCTHLB
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862556
    m_Localized: 'FunnyGuy: Hả? Bọn đó á? Bỏ đi, bác còn chuyện khác phải lo đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862557
    m_Localized: 'FunnyGuy: Tối qua bác mạn phép mượn điện thoại nhà mày, gọi cho mấy người hàng xóm.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862558
    m_Localized: 'FunnyGuy: Họ nhắn là có nhân viên từ ngân hàng ghé qua, hỏi về vụ trả nợ của bác.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862559
    m_Localized: "FunnyGuy: May mà bác không sống ở đấy. \nCơ mà..."
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862560
    m_Localized: 'FunnyGuy: Đéo gì luôn ý, mặt trời sắp nổ tung đến nơi rồi mà mấy thằng chó đó vẫn còn đi đòi nợ à?!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862561
    m_Localized: 'FunnyGuy: Mày tin nổi không cơ chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862562
    m_Localized: 'FunnyGuy: Má thề, khéo con nợ chết mất xác rồi nó cũng đéo tha. Dứt khoát lập bàn cầu cơ gọi hồn về trả cho bằng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862563
    m_Localized: 'FunnyGuy: Sao chúng nó không lo cái thân nó trước đi? Cứ phải dí mình tới chết làm gì chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862564
    m_Localized: 'FunnyGuy: Đúng là cái lũ khốn nạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862565
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862566
    m_Localized: 'FunnyGuy: Thôi, cho bác tạm lánh nạn ở đây ít lâu nhé. Xong chắc bác sẽ qua ở nhờ nhà bà con.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862567
    m_Localized: 'FunnyGuy: Nhà càng đông càng vui chứ nhể?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862568
    m_Localized: 'FunnyGuy: Mà thật chứ, địt mẹ lũ súc vật. Tận thế tới ngập cổ rồi mà vẫn bám dai như đỉa! Mẹ kiếp!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862569
    m_Localized: 'FunnyGuy: ...Cứ chờ đấy, ông trời có mắt. Chúng mày đừng hòng thoát tội.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862570
    m_Localized: 'FunnyGuy: Lẽ ra bây giờ được sống vô tư vô lo rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862571
    m_Localized: Bác chuẩn bị về nhà sao?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862572
    m_Localized: Tôi cần kiểm tra bác
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862573
    m_Localized: Đưa giấy triệu tập của CQPCTHLB
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862574
    m_Localized: 'FunnyGuy: Giờ đang loạn lung tung beng hết cả lên.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862575
    m_Localized: 'FunnyGuy: Nãy bác có mượn điện thoại nhà mày lần nữa, xin lỗi nhá. Lần này lại là bên ngân hàng gọi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862576
    m_Localized: 'FunnyGuy: Hóa ra toàn bộ tài khoản của bác bị đóng băng sạch rồi! Bao nhiêu công sức tích cóp của bác cả đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862577
    m_Localized: "FunnyGuy: Giờ bác đúng nghĩa không xu \ndính túi."
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862578
    m_Localized: 'FunnyGuy: Chúng nó bảo là do bác nợ, rõ điêu. Nếu thế thì chỉ việc trừ tiền trả góp hàng tháng vào tài khoản là xong mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862579
    m_Localized: 'FunnyGuy: Tự dưng đi đóng băng tài khoản tao làm gì?! Vô lý hết sức.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862580
    m_Localized: 'FunnyGuy: Chắc chắn chúng nó làm thế để rót tiền cho dự án của bọn cán bộ Thảm Họa đấy. Trả lương cho nhân viên, chi phí làm thí nghiệm... các kiểu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862581
    m_Localized: 'FunnyGuy: Thôi... kệ cha bọn nó. Tao đéo trả nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862582
    m_Localized: 'FunnyGuy: Nếu được thì cho bác ở đây một thời gian. Giờ mà về thì còn mặt mũi nào gặp gia đình nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862583
    m_Localized: 'FunnyGuy: Khéo chỗ ở của bác giờ thành hang ổ Dị Khách... hoặc phòng thí nghiệm của bọn Thảm Họa luôn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862584
    m_Localized: 'Alt: ...Càng lúc càng quá sức chịu đựng.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862585
    m_Localized: Lúc đứng ở cửa thì chị nói nhiều nhỉ
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862586
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862587
    m_Localized: Đưa giấy triệu tập của CQPCTHLB
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862588
    m_Localized: 'Alt: À, cậu để ý rồi hả.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862589
    m_Localized: 'Alt: Chắc do bệnh nghề nghiệp đó mà. Tôi hay nói lắm, nhất là những lúc căng thẳng, bồn chồn.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862590
    m_Localized: 'Alt: Lúc nào tôi cũng nghĩ mình có trách nhiệm phải xoa dịu tình hình, làm mọi thứ êm đẹp và lọt tai nhất có thể.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862591
    m_Localized: 'Alt: ...Tôi từng là phát thanh viên radio đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862592
    m_Localized: Vãi
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862593
    m_Localized: Tôi không ngờ luôn đấy
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862594
    m_Localized: 'Alt: Làm sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862595
    m_Localized: 'Alt: Tin hay không thì tùy cậu. Mà tôi cũng chẳng làm nổi ở chỗ ấy nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862596
    m_Localized: 'Alt: Giờ nó y như cái rạp xiếc vậy. Ngày nào cũng có bọn lừa đảo chiếm sóng bán hàng. Toàn mấy món để chơi cho vui mà chém giá cắt cổ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862597
    m_Localized: 'Alt: Hết "Đau mỏi vai gáy, thoát vị đĩa đệm, dùng cao thần kỳ, xoa ngay là khỏi!", rồi lại "Sóng radio rất có hại, bà con đặt ly nước cạnh đài để hấp thụ sóng!"'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862598
    m_Localized: 'Alt: Chả ra cái thể thống cống rãnh gì. Càng ngày càng bát nháo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862599
    m_Localized: 'Alt: Tôi chịu, chẳng thể vùi mình vào cái nồi cám lợn đấy nữa. Chịu đựng như thế là quá đủ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862600
    m_Localized: 'Alt: Chưa kể đến tin tức thời sự. Càng đọc càng nghe mà tôi chỉ thấy hoang mang cho xã hội.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862601
    m_Localized: 'Alt: Thế cậu nghĩ phát thanh viên phải trông như nào? Mặc vest tươm tất rồi thêm cặp kính dày như đít chai hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862602
    m_Localized: 'Alt: Tư duy của cậu rập khuôn quá. Ừ thì cũng hiểu được, nhưng đó là do cậu tự bó buộc thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862603
    m_Localized: 'Alt: Hồi ấy, tôi cứ nghĩ mình sẽ được trò chuyện với những vị khách hay ho... khách mời lên chương trình ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862604
    m_Localized: 'Alt: Thế mà công việc của tôi chỉ toàn là soạn thảo mấy bản tin u ám, tang thương. Nhiều lúc chỉ muốn đốt quách đi cho rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862605
    m_Localized: 'Alt: Đã thế, có mấy thằng ngu còn bày trò đi bán "không khí" đóng gói nữa. Cứ đòi lên sóng cho bằng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862606
    m_Localized: 'Alt: Đài phát thanh giờ chẳng khác gì cái rạp xiếc trung ương. Còn tôi thì là con hề chào khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862607
    m_Localized: 'Alt: ...Càng lúc càng quá sức chịu đựng.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862608
    m_Localized: Thế chị phát chán xong bỏ nghề luôn à?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862609
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862610
    m_Localized: Đưa giấy triệu tập của CQPCTHLB
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862611
    m_Localized: 'Alt: Ừ... nói ngắn gọn thì là như thế.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862612
    m_Localized: 'Alt: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862613
    m_Localized: 'Alt: Cậu biết cái gì mới là giọt nước tràn ly không? Hôm ấy bọn tôi phải lên sóng với một thằng dở hơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862614
    m_Localized: 'Alt: Chúng tôi được bảo là sẽ có khách mời "chuyên gia" đến để bàn luận về Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862615
    m_Localized: 'Alt: Hắn bảo đã tìm ra phương thức đẩy lùi lũ đó... mà tôi chẳng nhớ nó là cái vẹo gì. Hình như là hũ thuốc bỏ mẹ gì mà hét giá trên trời.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862616
    m_Localized: 'Alt: Hắn còn đặt cọc trước để được tham gia cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862617
    m_Localized: 'Alt: Tôi mất cả tuần để điều tra lý lịch thằng này. Tôi moi ra mọi phi vụ mờ ám của hắn, xâu chuỗi lại, chờ lúc lên sóng sẽ phanh phui cho bàn dân thiên hạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862618
    m_Localized: 'Alt: Hôm ấy đáng ra đã là một buổi phát sóng để đời...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862619
    m_Localized: 'Alt: Nhưng đời có như mơ đâu. Cậu biết tại sao không?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862620
    m_Localized: 'Alt: Hắn hủy kèo vì có kẻ đã ăn cắp tài liệu của hắn.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862621
    m_Localized: 'Alt: Địt mẹ nó, cả nghìn tấn dữ liệu chứ có ít ỏi đâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862622
    m_Localized: 'Alt: Đứa ngu nào lại rảnh đến mức ấy cơ chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862623
    m_Localized: 'Alt: Bao nhiêu kế hoạch, công sức nghiên cứu của tôi đổ sông đổ biển hết. Rồi hắn bơ bọn tôi luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862624
    m_Localized: 'Alt: Mẹ thằng khốn nạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862625
    m_Localized: 'Alt: ...Càng lúc càng quá sức chịu đựng.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862626
    m_Localized: Vậy là chị cạch mặt nghề đưa tin luôn rồi sao?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862627
    m_Localized: Tôi cần kiểm tra chị
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862628
    m_Localized: Đưa giấy triệu tập của CQPCTHLB
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862629
    m_Localized: 'Alt: Giờ kế hoạch trước mắt của tôi chỉ có một: tìm cách mà sống sót.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862630
    m_Localized: 'Alt: Tôi đã luồn lách vào nhiều phòng ban khác nhau, đặc biệt là từ khi khi cơn bão mặt trời xuất hiện.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862631
    m_Localized: 'Alt: Nhưng kết cục đã rõ rồi. Mọi chuyện chỉ càng lúc càng tệ đi thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862632
    m_Localized: 'Alt: Ngày trước, cảnh sát còn gửi tin báo hằng ngày cho chúng tôi từ khắp thành phố. Bọn tôi lấy nguồn tin từ đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862633
    m_Localized: 'Alt: Xong về sau, họ cứ nộp trễ dần đều.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862634
    m_Localized: 'Alt: Tôi cũng để ý văn phong ngày một khác. Ngày nào cũng đọc như tôi thì sẽ thấy có sự khác biệt ngay.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862635
    m_Localized: 'Alt: Tự dưng mấy cái báo cáo ấy... cứ là lạ kiểu gì ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862636
    m_Localized: 'Alt: Nên tôi mới quyết định cuốn gói luôn, không sống gần thành phố nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862637
    m_Localized: 'Alt: Thà bám trụ ở vùng ven đâu đó còn hơn. Tôi còn tính vào rừng mà sống cơ, nhưng tình hình như này thì khó lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862638
    m_Localized: 'Alt: Sống trên đời... đúng là khó trăm đường.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862639
    m_Localized: 'Tourist: Ước gì có thể rời khỏi đây được.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862640
    m_Localized: Anh tính đi du lịch đâu vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862641
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862642
    m_Localized: Đưa giấy triệu tập của CQPCTHLB
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862643
    m_Localized: 'Tourist: Hỏi làm chi nữa? Đằng nào tôi cũng có được về nhà đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862644
    m_Localized: 'Tourist: Mẹ kiếp cái thằng mặt trời. Cả bọn Dị Khách trời đánh kia nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862645
    m_Localized: 'Tourist: Chỉ có ở đây mới bị thôi à? Hay chỗ nào cũng vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862646
    m_Localized: 'Tourist: Tôi đã cất công chuẩn bị cho chuyến đi này từ lâu rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862647
    m_Localized: 'Tourist: Tiết kiệm từng đồng một, rồi ráng xin được nghỉ phép...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862648
    m_Localized: 'Tourist: Thế mà gặp cảnh này đây. Kỳ nghỉ chưa kịp bắt đầu đã kết thúc luôn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862649
    m_Localized: 'Tourist: Ước gì có thể rời khỏi đây được.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862650
    m_Localized: Sao anh không tranh thủ đi từ sớm?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862651
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862652
    m_Localized: Đưa giấy triệu tập của CQPCTHLB
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862653
    m_Localized: 'Tourist: Tôi nói rồi, thế nào cũng có chuyện à. Không phải vỏ dưa thì cũng là vỏ dừa...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862654
    m_Localized: 'Tourist: Mà tôi cứ tưởng tầm này đi du lịch là vừa đẹp.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862655
    m_Localized: 'Tourist: Tại mãi tôi mới được đi tắm nắng mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862656
    m_Localized: 'Tourist: Nếu biết chuyện sẽ thành ra như vậy, tôi đã xách đồ đi du lịch sớm hơn rồi. Thăm thú đó đây khi còn có cơ hội.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862657
    m_Localized: 'Tourist: Giờ tôi chỉ còn biết nhìn ngắm thế giới qua vài tấm ảnh. Mấy nước kia giờ toang hết mẹ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862658
    m_Localized: 'Tourist: Ước gì có thể rời khỏi đây được.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862659
    m_Localized: Có khi anh may ấy chứ. Ít ra cũng không bị thiêu sống
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862660
    m_Localized: Tôi cần kiểm tra anh
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862661
    m_Localized: Đưa giấy triệu tập của CQPCTHLB
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862662
    m_Localized: 'Tourist: May á? Anh đang trêu tôi à?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862663
    m_Localized: 'Tourist: Cả đời tôi chỉ ước được đi ngắm thế giới, mà giờ chẳng biết có ngắm nổi cái gì không nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862664
    m_Localized: 'Tourist: Đấy mà là may hả? May cái quần què!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862665
    m_Localized: Bố khỉ, còn sống là may lắm rồi đấy
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862666
    m_Localized: Đi du lịch thôi mà làm thấy ghê
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862667
    m_Localized: 'Tourist: Ờ, còn sống đây, rồi sao nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862668
    m_Localized: 'Tourist: Mặt trời sắp sửa nổ tung cả đám rồi kìa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862669
    m_Localized: 'Tourist: Rồi tôi phải bỏ xác nơi đây, mà chẳng bao giờ được ngắm nhìn thế giới...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862670
    m_Localized: Anh lấy cớ đó để than thân trách phận à? Đừng tự thương hại nữa
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862671
    m_Localized: Nghe anh lè nhà lè nhè mãi phát chán rồi đấy
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862672
    m_Localized: 'Tourist: Không phải chỉ du lịch đâu. Mà là cả ước mơ của tôi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862673
    m_Localized: 'Tourist: Cả đời tôi chỉ khao khát được đi khám phá thế giới, thế mà giờ thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862674
    m_Localized: 'Tourist: Mất hết rồi. Còn cửa đâu mà đi nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862675
    m_Localized: 'Tourist: Đáng lẽ tôi nên xách ba lô đi sớm hơn. Giờ chỉ có nước ngồi chờ chết...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862676
    m_Localized: Anh lấy cớ đó để than thân trách phận à? Đừng tự thương hại nữa
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862677
    m_Localized: Nghe anh lè nhà lè nhè mãi phát chán rồi đấy
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862678
    m_Localized: 'Tourist: Nhưng mà tôi... tôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862679
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862680
    m_Localized: 'Tourist: Tôi cứ hối hận này kia mãi thôi, xin lỗi anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862681
    m_Localized: 'Tourist: Giờ tôi mới cay đắng nhận ra rằng... từ đó đến giờ, chẳng có gì cản tôi đi hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862682
    m_Localized: 'Tourist: Nhưng tôi cứ trì hoãn miết, tự nhủ là để sau đi cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862683
    m_Localized: 'Tourist: Giờ thì... muộn màng quá rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862684
    m_Localized: 'Tourist: Thế giới sắp tàn đến nơi... mà tôi thì vẫn muốn ngắm, muốn làm nhiều thứ lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862685
    m_Localized: 'Tourist: Chắc tôi phải học cách chấp nhận thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862686
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862687
    m_Localized: 'Tourist: Địt mẹ mày!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862688
    m_Localized: 'Tourist: Tao mất hết bao nhiêu thứ mà cũng không cho buồn hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862689
    m_Localized: 'Tourist: Mở to con mắt lên mà xem, mọi thứ không trở lại như xưa được nữa đâu. Hết thật rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862690
    m_Localized: 'Tourist: Tao nhìn mắt mày là hiểu, mày đã chấp nhận buông xuôi rồi. Nhưng tao thì chưa! Tao không muốn chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862691
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862692
    m_Localized: 'Tourist: Tôi đang nói cái gì thế này... Anh chắc còn chưa bao giờ bước chân ra khỏi nhà ấy chứ. Với anh thế này chả khác gì ngày thường.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862693
    m_Localized: Ông anh làm tôi nóng máu rồi đấy
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862694
    m_Localized: Để tao sút mày ra ngoài xem mặt trời có luộc chín con ngươi mày không nhé
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862695
    m_Localized: 'Tourist: Cái đồ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862696
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862697
    m_Localized: 'Tourist: Thôi chắc tôi đi đây. Anh làm tôi sợ rồi đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862698
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862699
    m_Localized: 'Tourist: Ý là anh đã sẵn sàng chấp nhận mọi thứ, cái gì đến thì sẽ đến. Nhưng đâu phải ai cũng như anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862700
    m_Localized: 'Tourist: Tôi cứ suy nghĩ về những chuyện sẽ xảy ra tiếp theo. Tuyệt vọng lắm anh à.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862701
    m_Localized: 'Tourist: Tôi trăn trở mãi về những cơ hội đã bỏ lỡ. Vì quá lo sợ mà chẳng sống trọn được phút giây hiện tại.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862702
    m_Localized: Thử nhớ lại những ngày tươi đẹp xem. Có khi sẽ yên lòng hơn đấy
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862703
    m_Localized: Anh đừng đắm chìm trong tiếc nuối nữa
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862704
    m_Localized: 'Tourist: Ừ, cũng có lý...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862705
    m_Localized: 'Tourist: Chỉ là... rất khó để thoát ra được cái vòng luẩn quẩn "giá như", "đáng lẽ mà", "biết thế"...'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862706
    m_Localized: 'Tourist: Nhưng thôi, anh nói cũng đúng. Có quay ngược thời gian được nữa đâu mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862707
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862708
    m_Localized: 'Tourist: Cảm ơn vì đã lắng nghe tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862709
    m_Localized: 'Tourist: Chẳng biết anh có cần không, nhưng thôi đây, cho anh {0} này.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175582101823488
    m_Localized: Tôi cần kiểm tra cậu
    m_Metadata:
      m_Items: []
