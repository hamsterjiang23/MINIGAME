%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DayDialogs_pl
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: 48f2181e494cb864ca5ca7074da486ff, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22080585977856
    m_Localized: 'Firefighter: Ależ gorąco, do cholery…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560768
    m_Localized: Jak się czujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560769
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560770
    m_Localized: 'Firefighter: Zdaje się, że jest gorzej, niż myślałem, *kaszle* cholera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560771
    m_Localized: 'Firefighter: Dłużej niż tydzień chyba nie przeżyję.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560772
    m_Localized: 'Firefighter: Jednak ból trochę zelżał, gdy zaprosiłeś mnie do środka. Dziękuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560773
    m_Localized: 'Firefighter: Ale… teraz siedzę tu, a reszta moich kumpli jest tam i dogorywa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560774
    m_Localized: 'Firefighter: Mogłem zostać z nimi, bo i tak nie mam nic do stracenia. Niedługo umrę…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560775
    m_Localized: 'Firefighter: Ależ gorąco, do cholery…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560776
    m_Localized: Dlaczego nie poszedłeś do domu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560777
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560778
    m_Localized: 'Firefighter: Dzieci mam w domu, wiesz, a ja… *kaszle*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560779
    m_Localized: 'Firefighter: Nie chcę, żeby się mnie bały.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560780
    m_Localized: 'Firefighter: Lepiej, żeby mnie *kaszle* takim nie zapamiętały.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560781
    m_Localized: 'Firefighter: Niech myślą, że zginąłem w lesie podczas… *kaszle przeciągle*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560782
    m_Localized: 'Firefighter: Podczas gaszenia pożarów.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560783
    m_Localized: 'Firefighter: *kaszle* Niech zapamiętają mnie dzięki mojej wytrwałości obrotnej żywicy i smole mozołu sumiennej.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560784
    m_Localized: 'Firefighter: Ależ gorąco, do cholery…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560785
    m_Localized: Gdzie masz swój strój strażaka?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560786
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560787
    m_Localized: 'Firefighter: Szefostwo zabrało. *kaszle* Już nie starczy dla wszystkich.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560788
    m_Localized: 'Firefighter: Wiele osób *kaszle* ginie na służbie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560789
    m_Localized: 'Firefighter: Nie mamy nawet czasu wyciągać poległych z płomieni. Ogień zawsze *kaszle* pochłonie wszystko.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560790
    m_Localized: 'Firefighter: Szefostwo jednak… bardziej przejmuje się *kaszle* pieprzonymi strojami…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560791
    m_Localized: 'Firefighter: Tworzą dekrety taśmowo jak w fabryce, ale żaden nie polepsza naszego losu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560792
    m_Localized: 'Firefighter: Ależ gorąco, do cholery…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560793
    m_Localized: Skąd się wzięły pożary lasów?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560794
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560795
    m_Localized: 'Firefighter: W lesie ostatnio panowała wyjątkowa susza. Więc *kaszle* łatwo o zaprószenie ognia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560796
    m_Localized: 'Firefighter: Pożary do tylko *kaszle* jedno z nieszczęść, podobnie jak ci Przybysze z podziemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560797
    m_Localized: 'Firefighter: Ale los ma jeszcze niejedno w zanadrzu…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560798
    m_Localized: 'Firefighter: Może jest już tak źle, że pozostaje tylko mieć nadzieję o spokojną śmierć.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560799
    m_Localized: 'Firefighter: Wiesz… *kaszle* miałem zamiar wziąć to do domu jako prezent, ale oddam go tobie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560800
    m_Localized: 'Firefighter: To naszyjnik. Wiem, nie jest zbyt ładny, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560801
    m_Localized: 'Firefighter: Zrobiono go z martwych pszczół, które w słońce przemieniły miód.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560802
    m_Localized: 'Firefighter: Ależ gorąco, do cholery…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560803
    m_Localized: Wyglądasz okropnie
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560804
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560805
    m_Localized: 'Firefighter: Chyba… chyba nadszedł mój czas… *kaszle przeciągle*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560806
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560807
    m_Localized: 'Firefighter: Dlaczego tu przyszedłem? Mógłbym pewnie uratować kilku kumpli.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560808
    m_Localized: 'Firefighter: Mogłem zagryźć zęby… i pracować do wycieńczenia. Wtedy nie wysłaliby ich jak owce na rzeź.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560809
    m_Localized: 'Firefighter: JEBAĆ *kaszle* SZEFOSTWO! *kaszle przeciągle*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560810
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560811
    m_Localized: 'Firefighter: Wszystko jest takie… posępne.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560812
    m_Localized: 'Firefighter: Poczęstujesz mnie ostatnim papierosem?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560813
    m_Localized: Wyjmij papieros (poczęstuj papierosem)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560814
    m_Localized: 'Firefighter: Masz poczęstować może papierosem?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560815
    m_Localized: Nie, przykro mi (nie częstuj papierosem)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560816
    m_Localized: 'Firefighter: Jak to mówią „ostatni gwóźdź do trumny” *kaszle*.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560817
    m_Localized: 'Firefighter: (Mężczyzna wyciąga z kieszeni zapalniczkę, zapala papierosa i zaczyna palić).'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560818
    m_Localized: 'Firefighter: (Zaciąga się głęboko i opiera się o ścianę. Po krótkiej chwili wraca do rozmowy).'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560819
    m_Localized: 'Firefighter: Jeśli tylko mógłbym wrócić do kumpli. Palić fajki, gadać o…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560820
    m_Localized: 'Firefighter: *kaszle ciężko i długo*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560821
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560822
    m_Localized: 'Firefighter: Ty nie palisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560823
    m_Localized: 'Firefighter: Wiem, wiem. „Strażak, a pali papierosy?” *kaszle*.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560824
    m_Localized: 'Firefighter: Teraz to i tak wszystko jedno.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560825
    m_Localized: 'Firefighter: Chciałem się tylko odrobinę zrelaksować, zanim wykituję.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560826
    m_Localized: 'Firefighter: (Mężczyzna znów opiera się o ścianę i patrząc się w sufit, kontynuuje).'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560827
    m_Localized: 'Firefighter: Dlaczego utknąłem w zawodzie strażaka? Matka chciała, żebym robił w fabryce.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560828
    m_Localized: 'Firefighter: Strażak nie powinien iść z dymem…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560829
    m_Localized: 'Firefighter: *kaszle ciężko*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560830
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560831
    m_Localized: 'WheelChair: Hasać i biegać chciałbym tak…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560832
    m_Localized: Kogo szukasz?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560833
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560834
    m_Localized: 'WheelChair: Mam takiego ziomka, wiesz? Znamy się od dziecka.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560835
    m_Localized: 'WheelChair: Miał wypadek.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560836
    m_Localized: 'WheelChair: Zatrudnili go w jakiejś kopalni w górach.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560837
    m_Localized: 'WheelChair: Nie wiem, o co mu tam chodziło, i po prawdzie mam to gdzieś.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755072
    m_Localized: 'WheelChair: I rozwalił tam sobie plecy! Długo nie mógł się w ogóle ruszać!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755073
    m_Localized: 'WheelChair: Tak się wygiął w tych górach, że…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755074
    m_Localized: 'WheelChair: Mewy mu z… eee… pleców… yyy…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755075
    m_Localized: 'WheelChair: Dobra, chodzi o jego dupę. ZROBIŁY MU Z DUPY GNIAZDO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755076
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755077
    m_Localized: 'WheelChair: HA, HA, HA, HA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755078
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755079
    m_Localized: 'WheelChair: Wybacz, to tylko głosy w mojej głowie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755080
    m_Localized: 'WheelChair: Opowiedziały mi właśnie niezły kawał.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755081
    m_Localized: 'WheelChair: Hasać i biegać chciałbym tak…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755082
    m_Localized: Yyy… wszystko w porządku?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755083
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755084
    m_Localized: 'WheelChair: Tak, czekam tylko, aż mi kulasy odrosną.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755085
    m_Localized: 'WheelChair: Zobacz, prawy już zaczyna.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755086
    m_Localized: 'WheelChair: Zostanę tu więc na chwilę dłużej.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755087
    m_Localized: Chodziło mi o głosy w twojej głowie
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755088
    m_Localized: Okej…
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755089
    m_Localized: 'WheelChair: Dlaczego się nie śmiejesz? Przecież to był żart!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755090
    m_Localized: 'WheelChair: Myślałem, że w mig załapiesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755091
    m_Localized: 'WheelChair: Pewnie był sucharem…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755092
    m_Localized: 'WheelChair: Zapytałeś się, co u mnie?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755093
    m_Localized: 'WheelChair: Dzięki, to bardzo miłe!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755094
    m_Localized: 'WheelChair: Nikt się mnie o to nie pyta ani o to, jak mi minął dzień.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755095
    m_Localized: 'WheelChair: Czy to dlatego, że mam tę wyścigówkę na sportowych felgach zamiast zwykłych, nudnych nóg? Czy mi zazdroszczą?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755096
    m_Localized: 'WheelChair: Nikt poważnie na to nie odpowiada. W tym problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755097
    m_Localized: 'WheelChair: Zaraz zaczynają się wymówki, że tylko zerknęli, i że nie chcieli. Bla, bla, bla…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755098
    m_Localized: 'WheelChair: Słabo jest też jednak, gdy się tylko gapią i nic nie mówią.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755099
    m_Localized: 'WheelChair: Ale ignorowanie mojej niepełnosprawności też jest głupie. Rzuca się w oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755100
    m_Localized: 'WheelChair: Chodzi mi o to, że potrzeba tu jakiejś subtelności.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755101
    m_Localized: 'WheelChair: Tylko nie wiem, gdzie ją teraz znajdziemy! HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755102
    m_Localized: 'WheelChair: Czy wyobrażałeś sobie kiedyś, jak byś chodził, gdybyś jeździł na wózku?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755103
    m_Localized: 'WheelChair: Kuźwa, nie o to mi chodziło…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755104
    m_Localized: 'WheelChair: …gdybyś nie miał nóg?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755105
    m_Localized: 'WheelChair: WŁAŚNIE. Nawet byś nie mógł wyjść z domu!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755106
    m_Localized: 'WheelChair: Albo jak byś pokonywał schody lub przechodził przez jezdnię?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755107
    m_Localized: 'WheelChair: Te zasrane krawężniki są bardziej krzywe niż wieża w Pizie!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755108
    m_Localized: 'WheelChair: Twój dom nie ma żadnych stopni ani schodów, więc łatwo mogę wjechać.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755109
    m_Localized: 'WheelChair: Jednej rzeczy mi tu jednak brakuje…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755110
    m_Localized: 'WheelChair: …PAGÓRKA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755111
    m_Localized: 'WheelChair: Pomyśl tylko! Wyścigi wózkami po wzniesieniu, odbijanie się od ścian i innych gratów. HAH! Szkoda…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755112
    m_Localized: 'WheelChair: Stary, nie wierzę, że nie zapewniłeś mi u siebie wyścigowych doznań.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755113
    m_Localized: 'WheelChair: Och, czekaj, pytałeś, co u mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755114
    m_Localized: 'WheelChair: Całkiem nieźle, dzięki.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755115
    m_Localized: 'WheelChair: Hasać i biegać chciałbym tak…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755116
    m_Localized: Czy dostałeś udaru słonecznego?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755117
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755118
    m_Localized: 'WheelChair: A co to ma do rzeczy?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755119
    m_Localized: 'WheelChair: Włosów nie mam skołtunionych ani mi nie powypadały, więc chyba nic mi nie jest!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755120
    m_Localized: 'WheelChair: Bez nóg nie mogę się ścigać na wózku, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755121
    m_Localized: 'WheelChair: Nie mógłbym hamować ani brać ostrych zakrętów.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755122
    m_Localized: 'WheelChair: Nie jeździsz na wózku, więc nie wiesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755123
    m_Localized: Czy naprawdę tak myślisz?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755124
    m_Localized: Czy naprawdę uważasz, że nogi ci odrosną?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755125
    m_Localized: 'WheelChair: Jasna sprawa!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755126
    m_Localized: 'WheelChair: Wiesz, co mówią.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755127
    m_Localized: 'WheelChair: Prawa noga robi dłuższe kroki, więc chodzimy w kółko.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755128
    m_Localized: 'WheelChair: Moje nogi są tego przykładem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755129
    m_Localized: 'WheelChair: Nie ma różnicy i nie ma od tego ucieczki.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755130
    m_Localized: 'WheelChair: Dzień się kończy i zaczyna następny. Ale gdy wzejdzie słońce, czy cokolwiek tak naprawdę się zmieni?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755131
    m_Localized: 'WheelChair: Właśnie, kurwa, nie. To tylko kolejna odsłona tego gównianego błędnego koła!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755132
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755133
    m_Localized: 'WheelChair: Jeśli się zastanowić, czy uważasz, że różnisz się czymś ode mnie?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755134
    m_Localized: 'WheelChair: Obaj kręcimy się w kółko.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755135
    m_Localized: 'WheelChair: Słuchaj, żyjemy w świecie pełnym cudów.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755136
    m_Localized: 'WheelChair: Jasne, na razie były same syfiaste. ALE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755137
    m_Localized: 'WheelChair: Strachy kiedyś się skończą. Ustąpią miejsca wspaniałej radości.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755138
    m_Localized: 'WheelChair: Bóg przebaczył już wielu grzesznikom. Może dla nas też ma coś lepszego?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755139
    m_Localized: 'WheelChair: Hasać i biegać chciałbym tak…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755140
    m_Localized: Jak straciłeś nogi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755141
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755142
    m_Localized: 'WheelChair: Pamiętasz gościa w górach, o którym mówiłem? Tego z gniazdem na dupie? HAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755143
    m_Localized: 'WheelChair: Postanowił wykopać rów na swoim podwórku.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755144
    m_Localized: 'WheelChair: Strzeliło mu coś do łba, że pod jego chatą idzie tunel pełen mięsa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755145
    m_Localized: 'WheelChair: Zamówił więc sobie wielką wiertnicę.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755146
    m_Localized: 'WheelChair: I zaczął kopać…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755147
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755148
    m_Localized: 'WheelChair: Kurde…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755149
    m_Localized: 'WheelChair: Wtedy chyba widziałem go ostatni raz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755150
    m_Localized: 'WheelChair: Hasać i biegać chciałbym tak…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755151
    m_Localized: A co z nogami?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755152
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755153
    m_Localized: 'WheelChair: Chuj z moimi nogami! Chciałbym wiedzieć, czy dokopał się tam, gdzie chciał.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755154
    m_Localized: Dobra, zapomnij
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755155
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755156
    m_Localized: 'WheelChair: Hmm… tak, już wiem! Zapomniałem o nim i poszedłem po piwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755157
    m_Localized: 'WheelChair: Potknąłem się na torach i tramwaj przejechał mi po nogach.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755158
    m_Localized: 'WheelChair: Czekaj…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755159
    m_Localized: 'WheelChair: Nie, tak nie było.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755160
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755161
    m_Localized: 'WheelChair: Czemu zamilkłeś? Nie obchodzi cię, jak straciłem nogi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755162
    m_Localized: 'WheelChair: To ci nie powiem. Po co męczyć cię szczegółami?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755163
    m_Localized: 'Mother: Ale tu duchota…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755164
    m_Localized: Nie była tu pani z dzieckiem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755165
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755166
    m_Localized: 'Mother: Hę? Gdzieś się tu kręci. Pewnie gdzieś polazł…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755167
    m_Localized: 'Mother: Muszę się zorientować, gdzie poszła reszta moich dzieci…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755168
    m_Localized: 'Mother: Czy ma pan telefon? Zatelefonowałabym do ich ojca. Wtedy nie musiałabym oglądać jego paskudnej gęby.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755169
    m_Localized: 'Mother: Ale tu duchota…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755170
    m_Localized: Czy zadzwoniła pani do męża?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755171
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755172
    m_Localized: 'Mother: Nie, po co? Tylko by sypał wymówkami. Nigdy palcem nie kiwnął. Wszystko było na mojej głowie: dzieci, dom, rachunki.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755173
    m_Localized: 'Mother: Czasem myślę, że tylko się tolerujemy. Jednak z jakiegoś powodu nigdy mnie nie zostawił.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755174
    m_Localized: 'Mother: Może tak mu było wygodnie. Albo bał się, że go wybebeszę, gdyby spróbował.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755175
    m_Localized: 'Mother: Boże, padam z nóg…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755176
    m_Localized: 'Mother: Ale tu duchota…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755177
    m_Localized: Widziała się pani z mężem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755178
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755179
    m_Localized: 'Mother: Ledwo wstaję z łóżka! Wszystko mnie boli i ledwo stoję. Przekonana jestem, że żyję tylko z uporu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755180
    m_Localized: 'Mother: Wszystkim sama musiałam się zajmować. Ogarniać dzieci, męża, cały dom. Czasem jednak robił coś, że było prawie znośnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755181
    m_Localized: 'Mother: Czy możemy pogadać później? Muszę odpocząć, zaraz chyba padnę z nóg.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755182
    m_Localized: 'Mother: Ale tu duchota…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755183
    m_Localized: Co takiego robił pani mąż?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755184
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755185
    m_Localized: 'Mother: Pamiętam, że…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755186
    m_Localized: 'Mother: Woził wszędzie taką babkę. Wiedziałam, o co chodziło i z początku to tolerowałam, ale nie mogłam siedzieć cicho.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755187
    m_Localized: 'Mother: Suszyłam mu wciąż o to głowę… Aż w końcu zmienił pracę, żeby się z nią więcej nie widywać. Może naprawdę mnie kochał?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755188
    m_Localized: 'Mother: A może tylko wymyślam… Tak czy siak, muszę klapnąć. Pogadamy później.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755189
    m_Localized: 'Mother: Ale tu duchota…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755190
    m_Localized: Nie martwi się pani o dzieci?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755191
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755192
    m_Localized: 'Mother: Yhym… Ale pewnie powinnam bardziej. Przy pierwszym… nie wiedziałam, co robię. Wszystko zepsułam.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755193
    m_Localized: 'Mother: Przy drugim już myślałam, że mam to ogarnięte, ale wyszło jak zwykle. Potem trzecie i czwarte…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755194
    m_Localized: 'Mother: Lekarze mówili, że nie zajdę w ciążę. Gdy przyszło drugie, nazwałam je Ósmym Cudem Świata!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755195
    m_Localized: 'Mother: Potem… wszystko zeszło na psy. Było okropnie…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755196
    m_Localized: 'Mother: Muszę… Muszę się położyć…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755197
    m_Localized: 'Mother: Ale tu duchota…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755198
    m_Localized: Co było okropne?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755199
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755200
    m_Localized: 'Mother: Ciężko mi o tym mówić. Kocham je, ale… Czasem puszczają mi nerwy. Krzyczę i nawet podnoszę na nie rękę.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755201
    m_Localized: 'Mother: Wiem, że tak nie można. Żałuję tego, naprawdę… ale wie pan… Teraz po raz pierwszy jest jakoś łatwiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755202
    m_Localized: 'Mother: Bez nich czuję, że mogę w końcu zaczerpnąć powietrza… Nie chcę tego mówić, ale w końcu czuję się… szczęśliwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755203
    m_Localized: 'Anger: Kurwa mać…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755204
    m_Localized: Czy już się pan uspokoił?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755205
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755206
    m_Localized: 'Anger: Tak, szybko mi przechodzi, ale jak tylko pomyślę o czymś, co mnie wkurza, znowu mnie trafia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755207
    m_Localized: 'Anger: Kiedyś byłem spokojniejszy, wie pan? Niełatwo było mnie obrazić albo rozdrażnić.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755208
    m_Localized: 'Anger: Teraz jednak wystarczy drobnostka i krew mnie zalewa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755209
    m_Localized: 'Anger: I po co właściwie mam być spokojny? Może mój gniew chroni mnie od szaleństwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755210
    m_Localized: 'Anger: Przynajmniej nie oddaję czci temu prze‑kurwa‑wielkiemu słońcu jak niektóre te głupie pojeby.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755211
    m_Localized: 'Anger: Oni wierzą, że słońce nas ocali? Nieźle ich tam, psiamać, pogrzało! Ono nas zabija, do chuja!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755212
    m_Localized: 'Anger: Po mojemu to piczy kłak nas dzieli od przepaści.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755213
    m_Localized: 'Anger: Ale czy te pojeby to pojmują? Oczy‑kurwa‑wiście, że nie! Okej… już mi lepiej, jestem spokojny. Skończyłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755214
    m_Localized: 'Anger: Dziękuję, że mnie pan wysłuchał.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755215
    m_Localized: 'Anger: Jebać to gówno…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755216
    m_Localized: Skąd u pana cała ta złość?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755217
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755218
    m_Localized: 'Anger: Do diabła, sam nie wiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755219
    m_Localized: 'Anger: Wszystko, co się dzieje, strasznie mnie wnerwia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755220
    m_Localized: 'Anger: A zwłaszcza ci sekciarze, kłamliwe skurwysyny. Wciąż tylko szukają, żeby ogłupić jak najwięcej osób.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755221
    m_Localized: 'Anger: A ludzie łykają ich brednie jak głodne pelikany.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755222
    m_Localized: 'Anger: Naiwniaki odebrałyby własnemu dziecku ostatni kawałek chleba, żeby opłacić jałmużnę.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755223
    m_Localized: 'Anger: Wszystko po to, by udobruchać ich gównianego zbawiciela z chuj wie skąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755224
    m_Localized: 'Anger: Szurnięte patałachy. Piorą mózgi swoimi dyrdymałami nawet normalnym ludziom… takim, jak moja…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755225
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755226
    m_Localized: 'Anger: Już się wziąłem w garść. Lepiej mi teraz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755227
    m_Localized: 'Anger: Ja pierdolę…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755228
    m_Localized: Czy sekciarze kogoś panu odebrali?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755229
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755230
    m_Localized: 'Anger: Nie, i o to chodzi. Sama do nich poszła.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755231
    m_Localized: 'Anger: Moja żona…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755232
    m_Localized: 'Anger: Była głęboko wierząca nawet przed tym całym bajzlem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755233
    m_Localized: 'Anger: Kochałem ją i pogodziłem się z tym. Nigdy to nam nie wadziło.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755234
    m_Localized: 'Anger: Ale kiedy zaczął się ten cały jebany cyrk, odnalazła nową wiarę w nowego zbawiciela.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755235
    m_Localized: 'Anger: Uwierzyła w te sekciarskie z dupy banialuki.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755236
    m_Localized: 'Anger: Każdego dnia zagłębiała się w to coraz bardziej i w końcu zupełnie jej odjebało. Całkowicie uwierzyła w najdziwniejsze farmazony.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755237
    m_Localized: 'Anger: Jak się zorientowałem, do czego dopuściłem, było już za późno… Wystraszyłem ją. Było zbyt późno, by cokolwiek zmienić.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755238
    m_Localized: 'Anger: Do kurwy nędzy…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755239
    m_Localized: Co zaszło między panem a pana żoną?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755240
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755241
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755242
    m_Localized: 'Anger: Jednego dnia żona powiedziała, że zamierza dołączyć do sekty.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755243
    m_Localized: 'Anger: Ja… nie mogłem w to uwierzyć. Ukochana kobieta… stała się mi nieznajoma.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755244
    m_Localized: 'Anger: Jakby wszystko, co było między nami, straciło dla niej znaczenie. Wpadłem w taką furię, jak nigdy wcześniej.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755245
    m_Localized: 'Anger: Zacząłem myśleć, że nigdy mnie nie kochała, że tylko szukała sposobu, aby ode mnie spierdolić. Aż słabo mi się robiło.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755246
    m_Localized: 'Anger: Straciłem kontrolę nad sobą. Pięści same się zacisnęły i zrobiłem coś, czego sobie nigdy nie wybaczę.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755247
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755248
    m_Localized: 'Anger: Uderzyłem ją…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755249
    m_Localized: 'Anger: Przegrałem. Jest teraz w sekcie, a ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755250
    m_Localized: 'Anger: Nigdy nie pogodzę się z tym, co zaszło…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755251
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755252
    m_Localized: 'Anger: JA PIERDOLĘ, KURWA, NIENAWIDZĘ SIĘ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755253
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755254
    m_Localized: 'Anger: Lepiej, żebym sam się kaleczył niż innych. Zasługuję na to.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755255
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755256
    m_Localized: 'Anger: Odejdź pan. Muszę pobyć sam.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755257
    m_Localized: 'FortuneTeller: Hm? Powróżyć panu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755258
    m_Localized: Skąd pani tyle o mnie wie?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755259
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755260
    m_Localized: 'FortuneTeller: Ha! Co za głupstwo… To nie ja to wiem, jestem tylko medium. Przemawiają przeze mnie gwiazdy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755261
    m_Localized: 'FortuneTeller: Księżyc i Wenus są w koniunkcji w Szóstej Sadybie. Ma pan to wypisane na twarzy. Widać od razu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755262
    m_Localized: 'FortuneTeller: Kiedyś znałam kogoś podobnego do pana. Dobry słuchacz, ale zawsze milczący.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755263
    m_Localized: 'FortuneTeller: Wie pan, jak to mówią: jeśli Jowisz jest w Ósmej Sadybie, lepiej siedzieć cicho. To oznaka zamkniętych drzwi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755264
    m_Localized: 'FortuneTeller: Hm? Powróżyć panu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755265
    m_Localized: Co się stało z tym człowiekiem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755266
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755267
    m_Localized: 'FortuneTeller: Powiedziałam mu „To bez znaczenia, co robisz. Liczy się jeno barwa twojej aury w tym czasie”. Nie był jednak przekonany.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755268
    m_Localized: 'FortuneTeller: I życie przeciekło mu przez palce.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755269
    m_Localized: 'FortuneTeller: Jednego dnia zamknęłam oczy i zwizualizowałam sobie spełnienie moich marzeń.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755270
    m_Localized: 'FortuneTeller: Wykorzystałam do tego całą moją kosmiczną energię.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755271
    m_Localized: 'FortuneTeller: Jeśli nie otworzy się serca na energię wszechświata, nie warto w ogóle żyć w swoim ciele.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755272
    m_Localized: 'FortuneTeller: Pan też tak może zrobić. Proszę zamknąć oczy…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755273
    m_Localized: 'FortuneTeller: …i wyobrazić sobie spełnienie najskrytszych marzeń…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755274
    m_Localized: 'FortuneTeller: Proszę skupić się na wizji…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755275
    m_Localized: 'FortuneTeller: Wie pan, czemu u pana tyle cierpienia? Wciąż nie pojmuje pan, że cierpienie jest najczystszą formą radości.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755276
    m_Localized: 'FortuneTeller: Więc proszę mi powiedzieć… Czy jest pan gotowy na następny krok?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755277
    m_Localized: 'FortuneTeller: Hm? Powróżyć panu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755278
    m_Localized: Czym jest „następny krok”?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755279
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755280
    m_Localized: 'FortuneTeller: Jest wyborem siebie. Czuje pan ten swąd? Tak okropnie cuchną od dawna martwe marzenia. Pora je ożywić.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755281
    m_Localized: 'FortuneTeller: Kiedy sięgnęłam dna, tracąc światło i chęci, moja mentorka powiedziała mi jedno: „Jesteś głucha na wołania twojego oceanu”.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755282
    m_Localized: 'FortuneTeller: Z początku ją wyśmiałam, ale wtedy zamknęłam oczy i usłyszałam. Jakby zawsze tam były. Pan też tak może!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755283
    m_Localized: 'FortuneTeller: Najpierw trzeba jednak pilnie odpowiedzieć na jedno pytanie. Czy jest pan gotów zjednoczyć się ze sobą?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755284
    m_Localized: 'FortuneTeller: Hm? Powróżyć panu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755285
    m_Localized: Kto był pani mentorką?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755286
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755287
    m_Localized: 'FortuneTeller: Wspaniała kobieta. Niczym latarnia morska podczas sztormu. Światło, dzięki któremu pojęłam istotę wszystkiego.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755288
    m_Localized: 'FortuneTeller: Nigdy nie zapomnę jej słów: „Ludzie jedynie umierają, bo nie potrafią zaczerpnąć swojego wewnętrznego blasku”.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755289
    m_Localized: 'FortuneTeller: Otworzyła mi oczy i nagle ujrzałam, że mogłabym prowadzić ludzi po ich niepowtarzalnych ścieżkach.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755290
    m_Localized: 'FortuneTeller: Ona jednak obawiała się pójść jeszcze dalej.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755291
    m_Localized: 'FortuneTeller: Nie widziała się w sercu rzeczy. A najważniejsze to tam właśnie być.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755292
    m_Localized: 'FortuneTeller: Jeśli nie jest się pępkiem własnego wszechświata, to kto nim jest? Rozumie pan, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755293
    m_Localized: 'FortuneTeller: Hm? Powróżyć panu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755294
    m_Localized: Jak sobie pani pomogła?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755295
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755296
    m_Localized: 'FortuneTeller: Każdy popełniany błąd to szyfr w naszym wewnętrznym wszechświecie, który trzeba złamać.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755297
    m_Localized: 'FortuneTeller: Podążałam długą, krętą drogą. Patrzyłam dookoła i wstecz. Proszę tylko spojrzeć, jak ten dom zareagował na moją obecność.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755298
    m_Localized: 'FortuneTeller: Jest jasny, pełen miejsca i w harmonii z moją energią. Nie musi pan próbować z nim walczyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755299
    m_Localized: 'FortuneTeller: Już wchłonął pana strach, nie widzi pan? Proszę to zaakceptować, albo ściany zwilżą się płaczem. Łzy będą jednak pańskie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755300
    m_Localized: 'FortuneTeller: Hm? Powróżyć panu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755301
    m_Localized: Czego pani ode mnie chce?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755302
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755303
    m_Localized: 'FortuneTeller: Jejku, uważa pan, że coś od pana chcę?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755304
    m_Localized: 'FortuneTeller: Wiedziałby pan, gdzie jest ukryta pańska ścieżka, gdyby tylko ujrzał pan taniec własnego cienia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755305
    m_Localized: 'FortuneTeller: Musi pan mantrować radosne afirmacje. Czuje pan, jak wszytko się zmienia, prawda? Łatwiej zaczerpnąć powietrza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755306
    m_Localized: 'FortuneTeller: Tak oddziałuje moja energia na pana przestrzeń. Proszę nie szukać głębszego znaczenia, ale porzucić iluzję i przyjąć chaos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755307
    m_Localized: 'FortuneTeller: Proszę do mnie dołączyć i stać się przestrzenią. Proszę powiedzieć „Nie jestem tu gościem. To ja stworzyłem to sanktuarium”.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755308
    m_Localized: 'FortuneTeller: Hm? Powróżyć panu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755309
    m_Localized: A jeśli nie chcę niczego tworzyć?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755310
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755311
    m_Localized: 'FortuneTeller: Te mury pragną pana przyjąć, ale związał je pan łańcuchami swojej władzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755312
    m_Localized: 'FortuneTeller: Cisza w panu to głos świata tłamszonego pana strachem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755313
    m_Localized: 'FortuneTeller: Pańska energia jest skuta niczym miód zimą. Musi pan ją odtajać oddechem. Lustra nigdy nie kłamią.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755314
    m_Localized: 'FortuneTeller: Jeśli odbija się w nich tylko pan, to nic pan nie widzi. A trzeba jedynie przesunąć swoją energię o trzy stopnie w prawo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755315
    m_Localized: 'FortuneTeller: I wtedy w końcu odnajdzie pan radość.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755316
    m_Localized: 'Fanatic: Słucham, człowiecze. Mówże!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755317
    m_Localized: Czy jesteś wyznawcą jakiejś wiary?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755318
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755319
    m_Localized: 'Fanatic: TAK, CZŁOWIECZE! Moja wiara jest jednak zupełnie inna od tych nędznych religii, które znasz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755320
    m_Localized: 'Fanatic: Ja wierzę wyłącznie w Przenajświętsze Słońce! GDYŻ CHRONI NAS ONO I MIŁUJE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755321
    m_Localized: 'Fanatic: Ale imbecyle i naiwniacy widzą w nim tylko zagrożenie. Myślą, że wszystkich nas spali…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755322
    m_Localized: 'Fanatic: GÓWNO PRAWDA! Jego prawowity gniew skierowany jest wyłącznie w nasiona zła i heretyków! To oni są pełni grzechu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755323
    m_Localized: 'Fanatic: Niech innowiercom poskąpione będą Jego ogniste promienie zbawienia!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755324
    m_Localized: 'Fanatic: Pragną płomieni i dziwota ich bierze, gdy się sparzą.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755325
    m_Localized: Nasiona zła?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755326
    m_Localized: Heretycy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755327
    m_Localized: 'Fanatic: Wciąż nie wiesz? Nie widziałeś jeszcze obcych z bliska?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755328
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755329
    m_Localized: 'Fanatic: Niechaj i tak będzie, nieopromieniony człowiecze. Otworzę twe oczy na prawdę.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755330
    m_Localized: 'Fanatic: PRZYBYSZE SĄ NASIONAMI ZŁA!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755331
    m_Localized: 'Fanatic: Są potomkami obcych, którzy wylądowali na Ziemi, gdy Słońce było jeszcze młode, a trawa zieleńsza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755332
    m_Localized: 'Fanatic: Przeklęte pasożyty, które zalęgły się na Ziemi i mnożyły się między sobą przez stulecia!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755333
    m_Localized: 'Fanatic: A teraz wypełzły z głębin i pragną przejąć nasze ziemie jako swoje!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755334
    m_Localized: 'Fanatic: Słońce jednak postanowiło nas chronić. BO TO JEST NASZA ŚWIĘTA ZIEMIA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755335
    m_Localized: 'Fanatic: Słońce jest bezlitosne dla bluźnierców! Dlaczegoż inaczej czailiby się cały czas pod ziemią?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755336
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755337
    m_Localized: 'Fanatic: Skaranie… Czemu musiałem się wczoraj wieczorem tak uchlać?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755338
    m_Localized: 'Fanatic: Nie trzeba było pić na umór. Prawowity gniew Przenajświętszego Słońca, on…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755339
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755340
    m_Localized: 'Fanatic: O PRZENAJŚWIĘTSZE SŁOŃCE! Odpuść mu grzechy, gdyż zbłądził!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755341
    m_Localized: 'Fanatic: Obejmij go swoim miłosierdziem. I może także duszę uschniętego fikusa, który po wieczność zostanie niepodlany…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755342
    m_Localized: 'Fanatic: Amen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755343
    m_Localized: 'Fanatic: Dobrześ słyszał, człowiecze!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755344
    m_Localized: 'Fanatic: FEMA to heretycy!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755345
    m_Localized: 'Fanatic: Wtrącają się w rzeczy, które są poza naszą kontrolą – kontrolą zwykłych ludzi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949376
    m_Localized: 'Fanatic: Wsadzają nos w nie swoje sprawy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949377
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949378
    m_Localized: 'Fanatic: Niechaj Słońce spopieli nieopromienionych patafianów, którzy wrzucili mi matkę do kałuży.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949379
    m_Localized: 'Fanatic: Słucham, człowiecze. Mówże!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949380
    m_Localized: Słońce jakoś jednak spopieliło bardzo wielu ludzi
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949381
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949382
    m_Localized: 'Fanatic: Masz rację. I każdy jeden z nich był nasionem zła, człowiecze!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949383
    m_Localized: 'Fanatic: Przenajświętsze Słońce zdecydowało ich wszystkich ukarać za grzechy z tysiąca lat!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949384
    m_Localized: 'Fanatic: A Przybysze, te bluźniercze chędożce cieni, zaczęły wyciągać łapska ku Słońcu!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949385
    m_Localized: 'Fanatic: Słońce jednak do nich nie należy! Nie! Biada tym brudnym, podziemnym kitrańcom… Ono należy do nas, ludzi!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949386
    m_Localized: 'Fanatic: ONO NALEŻY DO NAS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949387
    m_Localized: 'Fanatic: ONO BŁOGOSŁAWI LUDZKOŚCI I CHWAŁA MU JEBITNA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949388
    m_Localized: Ilu jeszcze ludzi musi spłonąć, by zaspokoić słońce?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949389
    m_Localized: Twierdzisz, że koniec świata to słoneczna sprawiedliwość?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949390
    m_Localized: 'Fanatic: Wielu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949391
    m_Localized: 'Fanatic: I wierz mi, przyjacielu, jeszcze wiele nas czeka!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949392
    m_Localized: 'Fanatic: TO DOPIERO POCZĄTEK!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949393
    m_Localized: 'Fanatic: Ciężar naszych popiołów na wadze grzechu jeszcze nie przechylił szali wobec sił wszechświata!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949394
    m_Localized: 'Fanatic: Więcej musi spłonąć w prawowitym ogniu Słońca!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949395
    m_Localized: 'Fanatic: Ale wiedz jedno, przyjacielu: męczennicy nie pomrą na próżno!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949396
    m_Localized: 'Fanatic: Kiedyś wszyscy zrozumiemy prawdziwe znaczenie tajemnic Słońca…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949397
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949398
    m_Localized: 'Fanatic: Do diabła… Czasem w nocy nachodzi mnie uczucie, jak gdyby żona znów mnie opuszczała…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949399
    m_Localized: 'Fanatic: Była taka z niej pobożnisia…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949400
    m_Localized: 'Fanatic: …ale też straszna suka.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949401
    m_Localized: 'Fanatic: Czyj koniec?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949402
    m_Localized: 'Fanatic: Nasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949403
    m_Localized: 'Fanatic: HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949404
    m_Localized: 'Fanatic: Nie rozśmieszaj mnie. SŁOŃCE TRZYMA Z NAMI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949405
    m_Localized: 'Fanatic: Jest naszym zbawicielem, nie widzisz tego?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949406
    m_Localized: 'Fanatic: Stara się przegonić Przybyszy znów pod ziemię…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949407
    m_Localized: 'Fanatic: Karze plugawych bluźnierców za nagromadzone grzechy ludzkie…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949408
    m_Localized: 'Fanatic: Ujawnia heretyków w tych ich obszczanych szmatach, chowających się haniebnie za zakłamanymi maskami.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949409
    m_Localized: 'Fanatic: Musimy nieść podziękowanie Słońcu, a nie beczeć jak niemowlaki o „końcu świata”.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949410
    m_Localized: 'Fanatic: TAKIŻ KONIEC BĘDZIE DLA WSZYSTKICH NIEPRZYJACIÓŁ WSZECHMOGĄCEGO SŁOŃCA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949411
    m_Localized: 'Fanatic: ŚMIERĆ PODZIEMNYM KITRAŃCOM! ŚMIERĆ OBSRANYM HERETYKOM! ŚMIERĆ NASIONOM ZŁA!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949412
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949413
    m_Localized: 'Fanatic: Kurde, wiele bym dał za trochę frytek…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949414
    m_Localized: 'Fanatic: Słucham, człowiecze. Mówże!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949415
    m_Localized: Czy uważasz, że to, co się dzieje, ma jakieś święte znaczenie?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949416
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949417
    m_Localized: 'Fanatic: Człowiecze, powiedz mi… Czy tłumaczyłem ci to wszystko łopatologicznie, każdy najdrobniejszy szczegół…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949418
    m_Localized: 'Fanatic: Tylko po to… ABYŚ ZNÓW PYTAŁ SIĘ DOKŁADNIE O TO, KURWA MAĆ, SAMO?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949419
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949420
    m_Localized: 'Fanatic: Chyba się co do ciebie myliłem. Zaprawdę jesteś nieopromieniony… Nie pojmujesz sedna naszych zmagań…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949421
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949422
    m_Localized: 'Fanatic: Ja pierdolę, zabiłbym za zimnego browca…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949423
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949424
    m_Localized: 'Fanatic: Czy masz może chmielową jałmużnę, człowiecze?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949425
    m_Localized: Jasne, trzymaj (daj mu piwo)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949426
    m_Localized: 'Fanatic: Nie masz piwa? Masz mnie za idiotę, człowiecze?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949427
    m_Localized: 'Fanatic: Widziałem, co masz w lodówce! NA WŁASNE OCZY!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949428
    m_Localized: 'Fanatic: Nie daj się prosić, człowiecze. Wypijesz sam to całe piwo i nie podzielisz się puszeczką z innymi?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949429
    m_Localized: Nie (nie dawaj mu piwa)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949430
    m_Localized: 'Fanatic: Ach, dziękujmy Słońcu…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949431
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949432
    m_Localized: 'Fanatic: Mmm, w deseczkę. Ciemny browiec, mój ulubiony.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949433
    m_Localized: 'Fanatic: Przypominają mi się posiadówki w knajpie ze znajomymi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949434
    m_Localized: 'Fanatic: Wciągające rozmowy, zimne browce, przekąski…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949435
    m_Localized: 'Fanatic: I przygnębiona facjata takiego chuderlaka, który zawsze wywalał na nas gały z niesmakiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949436
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949437
    m_Localized: 'Fanatic: Nie jest to powód do złości. Możeś głupi jak but, człowiecze, ale przynajmniej jesteś życzliwy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949438
    m_Localized: 'Fanatic: Niech no ci coś dam w podzięce. Weź to.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949439
    m_Localized: 'Fanatic: Niechaj Przenajświętsze Słońce ulituje się nad twoją duszą!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949440
    m_Localized: 'Fanatic: TY DZIADOWSKI ĆWOKU!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949441
    m_Localized: 'Fanatic: NIECH CIĘ PIEKŁO POCHŁONIE, PRZEKLĘTA KANALIO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949442
    m_Localized: 'Fanatic: Niewdzięcznik! Wytłumaczyłem ci święte prawa, znaczenie obecnych wydarzeń, a ty jednak…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949443
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949444
    m_Localized: 'Fanatic: Pozostajesz głupcem, człowiecze! I to podłym!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949445
    m_Localized: 'Fanatic: Chuj z tobą. Możesz zgnić w tej swojej budzie, mam to w dupie! Spadam w lepsze miejsce.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949446
    m_Localized: 'Fanatic: Zobaczysz. Założę się, że wpuszczą mnie nawet z powrotem do tego baru.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949447
    m_Localized: 'Fanatic: Krzyżyk na drogę, wsioku.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949448
    m_Localized: 'Anxiety: Heh, he, he. Oby się to wszystko wkrótce skończyło.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949449
    m_Localized: Jak straciłaś dom?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949450
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949451
    m_Localized: 'Anxiety: Ach… Pamiętam to, jakby to było wczoraj.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949452
    m_Localized: 'Anxiety: Dopiero mnie wywalili z roboty. Chciałam tylko wrócić do domu, wejść do wyra i rozpłakać się.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949453
    m_Localized: 'Anxiety: Ale jak doszłam pod drzwi, stało tam dużo par butów. Pomyślałam, że może współlokatorka ma gości, czy coś, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949454
    m_Localized: 'Anxiety: Poszłam do jej pokoju, sprawdzić co i jak, ale jak się zbliżyłam, usłyszałam dziwny dźwięk.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949455
    m_Localized: 'Anxiety: Wystraszyłam się, ale rzuciłam okiem ukradkiem, by zobaczyć, co się dzieje.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949456
    m_Localized: 'Anxiety: Zdążyłam jedynie pobieżnie zerknąć i widziałam, jak współlokatorka leży bez ruchu na łóżku, gdy nagle…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949457
    m_Localized: 'Anxiety: Jakiś brudas złapał mnie od tyłu i powiedział „Nie możesz tam wejść. Ona… nie czuje się najlepiej”.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949458
    m_Localized: 'Anxiety: „Chodź, usiądźmy w kuchni”. Wtedy szybko mnie odciągnął i posadził przy stole.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949459
    m_Localized: 'Anxiety: Chciałam wyjść, ale tak strasznie się bałam… I wówczas…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949460
    m_Localized: 'Anxiety: Ja… on…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949461
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949462
    m_Localized: 'Anxiety: Muszę się położyć. Ja… w żołądku mi się przewraca… ech…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949463
    m_Localized: 'Anxiety: Heh, he, he. Oby się to wszystko wkrótce skończyło.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949464
    m_Localized: Co się wydarzyło dalej w twoim domu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949465
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949466
    m_Localized: 'Anxiety: Ech…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949467
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949468
    m_Localized: 'Anxiety: Po tym, jak mnie ten facet posadził na krześle w kuchni, jakiś dryblas wyszedł zza winkla i stanął w wyjściu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949469
    m_Localized: 'Anxiety: Zaczął głośno rozmawiać z gościem, który mnie złapał wcześniej.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949470
    m_Localized: 'Anxiety: Zachowywali się… jak gdyby mnie tam w ogóle nie było! A potem… zaczęli mnie dotykać!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949471
    m_Localized: 'Anxiety: Najpierw po rękach, potem po ramionach…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949472
    m_Localized: 'Anxiety: A z głębi mieszkania, chyba z mojego pokoju, dochodziły wiwaty i śmiechy…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949473
    m_Localized: 'Anxiety: Brzmiało to tak, jakby był tam cały tłum mężczyzn! Ha, ha, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949474
    m_Localized: 'Anxiety: Nie… nie mogłam oddychać. Puls tak mi skoczył, że myślałam, że mi pęknie serce…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949475
    m_Localized: 'Anxiety: Chciałam krzyczeć, wzywać pomocy, ale… ze stresu i paniki mowę mi odjęło. Nie mogłam wydusić z siebie żadnego dźwięku.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949476
    m_Localized: 'Anxiety: Tylko tak siedziałam jak sparaliżowana… oszołomiona niczym potrącone dzikie zwierzę.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949477
    m_Localized: 'Anxiety: Wtedy ten wielkolud podszedł po coś do lodówki. To była moja szansa…! Heh, he!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949478
    m_Localized: 'Anxiety: Rzuciłam się do wyjścia, bo strach chyba dodał mi skrzydeł. Biegłam bez końca… Uciekałam i nie oglądałam się za siebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949479
    m_Localized: 'Anxiety: W końcu nogi mi wysiadły i upadłam…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949480
    m_Localized: Dlaczego nie jesteś poparzona od słońca?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949481
    m_Localized: Co się stało potem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949482
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949483
    m_Localized: 'Anxiety: Nie pamiętam…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949484
    m_Localized: 'Anxiety: Chyba przeleżałam tam całą noc, a później…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949485
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949486
    m_Localized: 'Anxiety: To dziwne… Ja… mogłabym przysiąc, że pamiętałam wszystko, co mi się tego dnia przytrafiło…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949487
    m_Localized: 'Anxiety: Czekaj, myślisz, że…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949488
    m_Localized: 'Anxiety: Ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949489
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949490
    m_Localized: 'Anxiety: Mogę być Przybyszką?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949491
    m_Localized: 'Anxiety: N‑nie, to nie może być prawda! Ja… pamiętam całe swoje życie. Dzieciństwo, rodziców. Nie!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949492
    m_Localized: 'Anxiety: Nie jestem Przybyszką, nie? Nie jestem! Powiedz mi, że nie jestem!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949493
    m_Localized: Nie wiem
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949494
    m_Localized: Nie jesteś Przybyszką
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949495
    m_Localized: Wydajesz się być Przybyszką
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949496
    m_Localized: 'Anxiety: Leżałam na ziemi, a potem…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949497
    m_Localized: 'Anxiety: Potem…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949498
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949499
    m_Localized: 'Anxiety: Mogłabym przysiąc, że pamiętałam wszystko, co mi się tego dnia przytrafiło…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949500
    m_Localized: 'Anxiety: Czekaj, myślisz, że…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949501
    m_Localized: 'Anxiety: Ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949502
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949503
    m_Localized: 'Anxiety: Mogę być Przybyszką?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949504
    m_Localized: 'Anxiety: N‑nie, to nie może być prawda! Pamiętam całe swoje życie. Dzieciństwo, rodziców. Nie!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949505
    m_Localized: 'Anxiety: Nie jestem Przybyszką, nie? Nie jestem! Powiedz mi, że nie jestem!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949506
    m_Localized: Nie wiem
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949507
    m_Localized: Nie jesteś Przybyszką
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949508
    m_Localized: Wydajesz się być Przybyszką
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949509
    m_Localized: 'Anxiety: DLACZEGO TAK MYŚLISZ?! Ha, ha! O Boże, o Boże, o Boże. O MÓJ BOŻE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949510
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949511
    m_Localized: 'Anxiety: Muszę… się położyć. Znowu w brzuchu mi się przewraca… ech…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949512
    m_Localized: 'Anxiety: Dzięki, od razu mi lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949513
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949514
    m_Localized: 'Anxiety: Ech, muszę się położyć. Znowu w brzuchu mi się przewraca.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949515
    m_Localized: 'Anxiety: DLACZEGO TAK MYŚLISZ?! Ha, ha! Teraz jeszcze bardziej się boję!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949516
    m_Localized: 'Anxiety: NIE CHCĘ UMIERAĆ! NIE CHCĘ, NIE CHCĘ, NIE CHCĘ!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949517
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949518
    m_Localized: 'Anxiety: Wygląda na to, że wszyscy umrzemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949519
    m_Localized: 'Anxiety: Heh, he, he. Oby się to wszystko wkrótce skończyło.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949520
    m_Localized: Czy z tobą wszystko okej?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949521
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949522
    m_Localized: 'Anxiety: NIE ZBLIŻAJ SIĘ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949523
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949524
    m_Localized: 'Anxiety: Przepraszam, ja… myślałam, że chcesz mnie zabić.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949525
    m_Localized: Dlaczego tak myślałaś?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949526
    m_Localized: Jeśli chciałbym cię zabić, już dawno bym to zrobił
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949527
    m_Localized: 'Anxiety: Ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949528
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949529
    m_Localized: 'Anxiety: Nie wiem, kto jest Przybyszem, a kto nie… co, jeśli…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949530
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949531
    m_Localized: 'Anxiety: Co, jeśli ty jesteś Przybyszem?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949532
    m_Localized: 'Anxiety: Zabijesz mnie? Obedrzesz żywcem ze skóry? Kawałek po kawałku?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949533
    m_Localized: 'Anxiety: PROSZĘ, NIE! ZABIJ MNIE SZYBKO I… BEZBOLEŚNIE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949534
    m_Localized: 'Anxiety: NIE CHCĘ UMIERAĆ W MĘCZARNIACH! BŁAGAM!!! HA, HA, HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949535
    m_Localized: Spokojnie, nie jestem Przybyszem
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949536
    m_Localized: Nie chcę cię zabić
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949537
    m_Localized: 'Anxiety: P‑przepraszam, j‑jestem kłębkiem nerwów…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949538
    m_Localized: 'Anxiety: Nie wiem, komu mogę zaufać.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949539
    m_Localized: 'Anxiety: A co, jeśli…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949540
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949541
    m_Localized: 'Anxiety: Jeśli ty jesteś Przybyszem?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949542
    m_Localized: 'Anxiety: Zabijesz mnie? Obedrzesz żywcem ze skóry? Kawałek po kawałku?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949543
    m_Localized: 'Anxiety: PROSZĘ, NIE! ZABIJ MNIE SZYBKO I… BEZBOLEŚNIE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949544
    m_Localized: 'Anxiety: NIE CHCĘ UMIERAĆ W MĘCZARNIACH! BŁAGAM!!! HA, HA, HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949545
    m_Localized: Spokojnie, nie jestem Przybyszem
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949546
    m_Localized: Nie chcę cię zabić
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949547
    m_Localized: 'Anxiety: JAK MOGĘ BYĆ PEWNA?! J‑ja… nie sprawdziłam ci zębów ani oczu… ha, ha, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949548
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949549
    m_Localized: 'Anxiety: Wszyscy zginiemy… To tylko kwestia czy wpierw zrobią to Przybysze, czy słońce…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949550
    m_Localized: 'Anxiety: Nie ma żadnej nadziei. Śmierć się zbliża i nie ma przed nią ucieczki…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949551
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949552
    m_Localized: 'Anxiety: Chcę pobyć sama.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949553
    m_Localized: 'Anxiety: JAK MOGĘ BYĆ PEWNA?! J‑ja… nie sprawdziłam ci zębów ani oczu…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949554
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949555
    m_Localized: 'Anxiety: Wszyscy zginiemy… To tylko kwestia czy wpierw zrobią to Przybysze, czy słońce…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949556
    m_Localized: 'Anxiety: Nie ma żadnej nadziei. Śmierć się zbliża i nie ma przed nią ucieczki…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949557
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949558
    m_Localized: 'Anxiety: Chcę pobyć sama.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949559
    m_Localized: 'Anxiety: Heh, he, he. Oby się to wszystko wkrótce skończyło.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949560
    m_Localized: Co jest z tobą nie tak?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949561
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949562
    m_Localized: 'Anxiety: PRZYBYSZE! IDĄ PO NAS!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949563
    m_Localized: 'Anxiety: S‑słyszysz? ŚMIERĆ NAS WZYWA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949564
    m_Localized: 'Anxiety: PRZYBYSZ, CZŁOWIEK… CO ZA RÓŻNICA?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949565
    m_Localized: 'Anxiety: MARTWI WSZYSCY JESTEŚMY TACY SAMI!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949566
    m_Localized: 'Anxiety: Po co męczyć się czekaniem? NIECH PRZYJDĄ! HA, HA, HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949567
    m_Localized: 'Anxiety: ONI CHCĄ DLA NAS JAK NAJLEPIEJ! NIECH PRZYJDĄ PRZYBYSZE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949568
    m_Localized: Chyba coś ci dolega
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949569
    m_Localized: Straciłaś rozum?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949570
    m_Localized: 'Anxiety: NIE! UJRZAŁAM ŚWIATŁO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949571
    m_Localized: 'Anxiety: JESTEM PRZYBYSZKĄ! HA, HA, HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949572
    m_Localized: 'Anxiety: MY I LUDZIE TO JEDNOŚĆ. ODBICIA! LUSTRA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949573
    m_Localized: 'Anxiety: JEDNO I TO SAMO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949574
    m_Localized: 'Anxiety: RAZEM PRZYWITAMY ŚMIERĆ!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949575
    m_Localized: Czy ty siebie słyszysz?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949576
    m_Localized: Nie pozostawiasz mi wyboru
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949577
    m_Localized: 'Anxiety: NIE ODBIŁO MI, JA WIDZIAŁAM ŚWIATŁO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949578
    m_Localized: 'Anxiety: JESTEM PRZYBYSZEM! HA, HA, HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949579
    m_Localized: 'Anxiety: MY I LUDZIE TO JEDNOŚĆ. ODBICIA! LUSTRA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949580
    m_Localized: 'Anxiety: JEDNO I TO SAMO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949581
    m_Localized: 'Anxiety: RAZEM PRZYWITAMY ŚMIERĆ! IDZIE PO NAS WSZYSTKICH!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949582
    m_Localized: Czy ty siebie słyszysz?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949583
    m_Localized: Nie pozostawiasz mi wyboru
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949584
    m_Localized: 'Anxiety: N‑nie, niczego nie rozumiesz!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949585
    m_Localized: 'Anxiety: Nadchodzi koniec! SŁOŃCE ZWIASTUJE RYCHŁE NADEJŚCIE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949586
    m_Localized: 'Anxiety: Wkrótce się spotkamy. Już niedługo…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949587
    m_Localized: Zostaw ją w spokoju
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949588
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949589
    m_Localized: 'Anxiety: Strzelaj! STRZELAJ! Na co czekasz?!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949590
    m_Localized: 'Anxiety: ZABIJESZ MNIE BEZ CIENIA ŻALU?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949591
    m_Localized: 'Anxiety: Wisi mi to! Ha, ha, ha! RÓB, CO MUSISZ, CZŁOWIEKU!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949592
    m_Localized: Zostaw ją w spokoju
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949593
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949594
    m_Localized: 'Esenin: No? Chciałeś czegoś?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949595
    m_Localized: Dlaczego wyrzucili cię z baru?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949596
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949597
    m_Localized: 'Esenin: Hm. Winię za to długi sznur katastrof, który wszystkim pomieszał w głowach.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949598
    m_Localized: 'Esenin: Słońce lada chwila pierdyknie, nadeszli Przybysze, gospodarka leży i kwiczy, i tak dalej.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949599
    m_Localized: 'Esenin: Wszystkim od tego odjebało. Niektórych zeżarł stres, inni zaglądają do kieliszków.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949600
    m_Localized: 'Esenin: Jeśli chodzi o mnie, to oszalałem z furii.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949601
    m_Localized: 'Esenin: Coś we mnie pękło, wszedłem na bar i wrzasnąłem „Ja pierdolę, przestańcie winić wszystko prócz siebie!”.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949602
    m_Localized: 'Esenin: Niech się mazgają. Łzy w piwnej piance nie rujnują trunku. Słód i chmiel smakują lepiej z odrobiną soli.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949603
    m_Localized: 'Esenin: Nikt tego nie docenia, więc po co się starać?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949604
    m_Localized: 'Esenin: No? Chciałeś czegoś?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949605
    m_Localized: Czy tutaj jest lepiej?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949606
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949607
    m_Localized: 'Esenin: Nikomu już nie zawracam głowy, nie warto.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949608
    m_Localized: 'Esenin: Ale kiedy słyszę gadaninę z telewizora lub przypadkiem usłyszę czyjeś rozmowy, nachodzi mnie ochota.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949609
    m_Localized: 'Esenin: Ale powstrzymuję się… Za dużo zachodu i bez satysfakcji.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949610
    m_Localized: 'Esenin: Nie, kończę z tym. Nerwy mam już napięte jak postronki.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949611
    m_Localized: 'Esenin: Życie wcześniej było wystarczająco przygnębiające, a teraz…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949612
    m_Localized: 'Esenin: Któregoś dnia powieszę się na żyrandolu i zadyndam nad całym bożym światem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949613
    m_Localized: 'Esenin: No? Chciałeś czegoś?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949614
    m_Localized: Czy wszystko w porządku?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949615
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949616
    m_Localized: 'Esenin: Hm? Czemu pytasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949617
    m_Localized: Pachniesz czymś
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949618
    m_Localized: Czy masz gorączkę?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949619
    m_Localized: 'Esenin: Cóż… Opiłem cię trochę z piwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949620
    m_Localized: 'Esenin: Nie czułem się najlepiej, więc postanowiłem wyleczyć się zimnym bronkiem. Nic w tym złego.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949621
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949622
    m_Localized: 'Esenin: Wszystko to jeden wielki chuj.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949623
    m_Localized: 'Esenin: Ludzie gadają, że sobie radzą, rozwiązują problemy, ale to wszystko bujda na resorach, kurde. Nic się nie zmienia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949624
    m_Localized: 'Esenin: Wiesz, mój drogi, wydaje mi się, że wszyscy niedługo wydamy ostatnie tchnienie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949625
    m_Localized: 'Esenin: Jeśli słońce nas nie wykończy, zrobią to Przybysze. A jeśli ich pokonamy, sami się nawzajem wykończymy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949626
    m_Localized: 'Esenin: Rozwiązany problem tworzy próżnię. Wtedy tworzymy nowy i własny, żeby ją, kurwa, wypełnić.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949627
    m_Localized: 'Esenin: Niczym niekończąca się, patologiczna fascynacja zbiorowym sraniem w gacie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949628
    m_Localized: 'Esenin: Ja pierdolę, kurwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949629
    m_Localized: 'Esenin: Idź precz, niedobrze mi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949630
    m_Localized: 'Esenin: To nie mnie doskwiera choroba, ale całej, jebanej, planecie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949631
    m_Localized: 'Esenin: Gdzie się nie spojrzeć, ktoś żegna się z tym światem. Lodowce topnieją, lasy idą z dymem. Świat płonie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949632
    m_Localized: 'Esenin: Planeta stara się nas strząsnąć, jakbyśmy byli napitymi krwią pchłami.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949633
    m_Localized: 'Esenin: I jednego dnia jej się to powiedzie, wiesz? I bez bólu się nie obędzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949634
    m_Localized: 'Esenin: Urghhh…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949635
    m_Localized: 'Esenin: Spierdalaj. Proszę. Nie czuje się dobrze.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949636
    m_Localized: 'Esenin: No? Chciałeś czegoś?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949637
    m_Localized: Czy czujesz się lepiej?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949638
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949639
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949640
    m_Localized: 'Esenin: Mój drogi…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949641
    m_Localized: 'Esenin: Wszyscy kiedyś pożegnamy się z życiem. Nie unikniemy tego.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949642
    m_Localized: 'Esenin: Jak myślisz, co się z nami dzieje po śmierci?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949643
    m_Localized: Unosimy się na skrzydłach wiary do raju
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949644
    m_Localized: Nic się nie dzieje
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949645
    m_Localized: Nie wiem, może dryfujemy w kosmosie
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949646
    m_Localized: 'Esenin: Coś w tym jest.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949647
    m_Localized: 'Esenin: Ale czuję się dzięki temu lepiej. Wiesz czemu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949648
    m_Localized: 'Esenin: Mój mózg uchwyci się tego marzenia, gdy będę umierał. Pokaże mi wizje jakiegoś raju, gdzie trawa jest zieleńsza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949649
    m_Localized: 'Esenin: A kiedy opuszczą mnie siły i odejdzie ta słodka myśl, co wtedy?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949650
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949651
    m_Localized: 'Esenin: Nie, wcale nie czuję się przez to lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949652
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949653
    m_Localized: 'Esenin: Miałem nadzieję, że powiesz coś innego.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949654
    m_Localized: 'Esenin: Być może masz rację. Ale brzmi to tak ponuro…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949655
    m_Localized: 'Esenin: Że nic nas nie czeka po drugiej stronie po tym… wszystkim. Nic, prócz ciemności…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949656
    m_Localized: 'Esenin: Nagle opuściła mnie chęć do rozmowy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143680
    m_Localized: 'Esenin: Jeśli się nad tym zastanowić…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143681
    m_Localized: 'Esenin: Musimy być zupełnie samotni we wszechświecie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143682
    m_Localized: 'Esenin: Wychodzi na to, że nie ma innego życia. Jest tylko zimna, pusta przestrzeń.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143683
    m_Localized: 'Esenin: Bo gdyby był ktoś inny, już dawno byśmy odebrali jakiś sygnał, nie? Sam nie wiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143684
    m_Localized: 'Esenin: Pustka nieskończonego mroku… Udać się tam, to jak zupełnie zniknąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337984
    m_Localized: 'Esenin: Chcę… pobyć sam.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337985
    m_Localized: 'Esenin: No? Chciałeś czegoś?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337986
    m_Localized: Czy… wszystko okej?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337987
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337988
    m_Localized: 'Esenin: Przynajmniej w barze mieli wysoki sufit.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337989
    m_Localized: 'Esenin: Z łatwością można by się z niego powiesić.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337990
    m_Localized: 'Esenin: Tu jest dla mnie za ciasno. Cały świat jest za ciasny.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337991
    m_Localized: 'Esenin: Mój drogi, chcę tylko, aby się to wszystko skończyło.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337992
    m_Localized: 'Esenin: W mordę, straszny to bajzel. Wszystko przejmuje mnie wykurwistym lękiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337993
    m_Localized: 'Esenin: Dłużej już tak nie mogę.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337994
    m_Localized: 'Esenin: Po co w ogóle tu przyszedłem?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337995
    m_Localized: 'Widow: Chciałabym trochę odsapnąć…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337996
    m_Localized: Czy czegoś potrzebujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337997
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337998
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337999
    m_Localized: 'Widow: Tak, aby on nie był martwy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338000
    m_Localized: 'Widow: To wszytko…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338001
    m_Localized: 'Widow: Nic mi więcej nie potrzeba.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338002
    m_Localized: Dać ci trochę wody?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338003
    m_Localized: Czy chcesz coś do jedzenia?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338004
    m_Localized: 'Widow: Ja tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338005
    m_Localized: 'Widow: Klapnę sobie tu przy kranie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338006
    m_Localized: 'Widow: Napiję się z niego, jak zajdzie potrzeba.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338007
    m_Localized: Zostawię cię wtedy
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338008
    m_Localized: Czy mogę się przysiąść?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338009
    m_Localized: 'Widow: Nie jestem głodna.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338010
    m_Localized: 'Widow: Ja tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338011
    m_Localized: 'Widow: Chcę posiedzieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338012
    m_Localized: Zostawię cię wtedy
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338013
    m_Localized: Czy mogę się przysiąść?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338014
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338015
    m_Localized: 'Widow: Dlaczego musiałeś pójść i umrzeć?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338016
    m_Localized: 'Widow: Obiecałeś mi, że będzie dobrze.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338017
    m_Localized: 'Widow: Mówiłeś, że wszystko się ułoży.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338018
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338019
    m_Localized: 'Widow: A potem wyzionąłeś ducha.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338020
    m_Localized: 'Widow: Zostałam sama.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338021
    m_Localized: 'Widow: Dlaczego mnie opuściłeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338022
    m_Localized: 'Widow: Chcę być tylko z nim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338023
    m_Localized: 'Widow: A ty mi go nie przywrócisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338024
    m_Localized: 'Widow: Nie mogę nawet…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338025
    m_Localized: 'Widow: Pochować…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338026
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338027
    m_Localized: 'Widow: Nie mogę go nawet pochować.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338028
    m_Localized: 'Widow: Co mam począć?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338029
    m_Localized: 'Widow: Chciałabym trochę odsapnąć…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338030
    m_Localized: Jak umarł?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338031
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338032
    m_Localized: 'Widow: On… Nie mogę…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338033
    m_Localized: 'Widow: To dla mnie zbyt wiele…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338034
    m_Localized: 'Widow: Wypłakałam wszystkie łzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338035
    m_Localized: 'Widow: Nie mam już czym płakać.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338036
    m_Localized: 'Widow: To wszystko nie tak… źle…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338037
    m_Localized: 'Widow: Nie potrafię przestać płakać.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338038
    m_Localized: Trzeba go pochować
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338039
    m_Localized: Twój mąż nie żyje, musisz się z tym pogodzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338040
    m_Localized: 'Widow: Nie…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338041
    m_Localized: 'Widow: Nie, nie, nie! NIE!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338042
    m_Localized: 'Widow: Nie jestem na to gotowa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338043
    m_Localized: 'Widow: Dopiero co mi go oddali.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338044
    m_Localized: 'Widow: A ty chcesz, żebyśmy się znowu rozstali?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338045
    m_Localized: 'Widow: Nie mogę.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338046
    m_Localized: 'Widow: Nie oddam go nieczułej ziemi w objęcia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338047
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338048
    m_Localized: 'Widow: Nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338049
    m_Localized: 'Widow: Mylisz się, nie jest tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338050
    m_Localized: 'Widow: On wciąż mnie słyszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338051
    m_Localized: 'Widow: Ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338052
    m_Localized: 'Widow: Wolę myśleć, że tak jet.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338053
    m_Localized: 'Widow: Chciałabym trochę odsapnąć…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338054
    m_Localized: Co o nim pamiętasz?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338055
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338056
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338057
    m_Localized: 'Widow: Odwiedziliśmy raz znajomych.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338058
    m_Localized: 'Widow: Byliśmy wtedy dużo młodsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338059
    m_Localized: 'Widow: Siedzieliśmy i piliśmy. Humor mu nie dopisywał. Rzadko się odzywał na takich schadzkach.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338060
    m_Localized: 'Widow: Tamtego dnia nieźle popiliśmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338061
    m_Localized: 'Widow: W jednej chwili zachowywał się jak zwykle, a nagle w następnej powiedział:'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338062
    m_Localized: 'Widow: „Dajcie gitarę. Zaśpiewam coś”.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338063
    m_Localized: 'Widow: I zagrał tak pięknie. Coś cudownego.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338064
    m_Localized: 'Widow: Znajomi zaczęli prosić, żeby zagrał dla nich kolejne piosenki. A on tylko siedział przez moment, a potem…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338065
    m_Localized: 'Widow: Wstał i powiedział, że musi iść. Przewrócił szklankę, próbował ją złapać, upuścił gitarę…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338066
    m_Localized: 'Widow: Dopiero później dowiedziałam się, że nauczył się ten jednej piosenki, aby mnie oczarować.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338067
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338068
    m_Localized: 'Widow: Wciąż mam zdjęcie z tamtego wieczoru.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338069
    m_Localized: 'Widow: Było w lepszym stanie, tak jak i my…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338070
    m_Localized: 'Widow: Teraz już mi nic nie zagrasz. Wydałeś ostatnie tchnienie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338071
    m_Localized: 'Widow: Chciałabym trochę odsapnąć…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338072
    m_Localized: Co się z nim stało?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338073
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338074
    m_Localized: 'Widow: Umarł, kurwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338075
    m_Localized: Racja, wybacz, że wspomniałem
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338076
    m_Localized: Ja go nie zabiłem
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338077
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338078
    m_Localized: 'Widow: Przepraszam, ja tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338079
    m_Localized: 'Widow: Co noc wypłakuję sobie oczy. Nie potrafię przestać.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338080
    m_Localized: 'Widow: Chcę, żeby ci ponoszący za to odpowiedzialność… Pragnę, aby słońce spaliło ich żywcem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338081
    m_Localized: Więc… co się stało?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338082
    m_Localized: Nie będę już o to pytał
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338083
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338084
    m_Localized: 'Widow: Wiem, masz rację.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338085
    m_Localized: 'Widow: To było niegrzeczne. Rozmawianie o nim jest dla mnie bardzo przykre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338086
    m_Localized: 'Widow: Oby tym draniom odpłaciło pięknym za nadobne.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338087
    m_Localized: 'Widow: Żeby pękli, skurwysyny.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338088
    m_Localized: Więc… co się stało?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338089
    m_Localized: Nie będę już o to pytał
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338090
    m_Localized: 'Widow: Mąż nie czuł się najlepiej. Poszedł do szpitala, ale go nie przyjęli.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338091
    m_Localized: 'Widow: Skierowali tylko do nowego ośrodka FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338092
    m_Localized: 'Widow: A tam zaledwie poddali go kwarantannie. Odebrali mu telefon i powiedzieli, że wypuszczą po trzech tygodniach.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338093
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338094
    m_Localized: 'Widow: Raz poszłam tam wcześnie, żeby go odwiedzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338095
    m_Localized: 'Widow: A te kanalie…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338096
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338097
    m_Localized: 'Widow: Przepraszam, daj mi moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338098
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338099
    m_Localized: 'Widow: Oznajmili tylko, że „on nie żyje”.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338100
    m_Localized: 'Widow: Nic więcej.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338101
    m_Localized: 'Widow: Nie pozwolili obejrzeć zwłok.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338102
    m_Localized: 'Widow: Nie mogłam zabrać go do domu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338103
    m_Localized: 'Widow: Ale te barany by nawet fujary w gaciach nie znalazły. Założyłam biały fartuch i weszłam do kostnicy jak do siebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338104
    m_Localized: 'Widow: A on…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338105
    m_Localized: 'Widow: Naprawdę tam leżał.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338106
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338107
    m_Localized: 'Widow: Zabili go. Mają jego krew na rękach. Zostało mi tylko wyć wniebogłosy, że nie mam już dla nikogo współczucia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338108
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338109
    m_Localized: 'Widow: Zostaw mnie samą.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338110
    m_Localized: 'Widow: Tak, proszę…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338111
    m_Localized: 'Widow: Bez niego chyba nie dam rady ciągnąć dalej…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338112
    m_Localized: 'Widow: Chciałabym trochę odsapnąć…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338113
    m_Localized: Czy coś się stało?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338114
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338115
    m_Localized: 'Widow: Odchodzę dziś wieczorem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338116
    m_Localized: 'Widow: Mówiłam, że nie zamierzam długo zostawać.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338117
    m_Localized: 'Widow: Potrzebowałam tylko tu trochę odpocząć.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338118
    m_Localized: Co teraz zamierzasz?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338119
    m_Localized: Zostaniesz u rodziny?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338120
    m_Localized: 'Widow: Nie chcę o tym myśleć.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338121
    m_Localized: 'Widow: Chyba… pójdę po prostu do domu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338122
    m_Localized: 'Widow: Znajdę tę starą gitarę…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338123
    m_Localized: 'Widow: A potem…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338124
    m_Localized: Możesz tu zostać
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338125
    m_Localized: Powodzenia
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338126
    m_Localized: 'Widow: Nikt nam już nie został.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338127
    m_Localized: 'Widow: Idziemy do domu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338128
    m_Localized: 'Widow: Nikogo więcej nie ma.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338129
    m_Localized: Możesz tu zostać
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338130
    m_Localized: Powodzenia
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338131
    m_Localized: 'Widow: Po co?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338132
    m_Localized: 'Widow: To mi nic nie ułatwi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338133
    m_Localized: 'Widow: Nie chcę być niegrzeczna, ale nie obchodzisz mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338134
    m_Localized: 'Widow: Chcę tylko pójść do domu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338135
    m_Localized: 'Widow: Być we własnych czterech ścianach.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338136
    m_Localized: 'Widow: Dziękuję…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338137
    m_Localized: 'Widow: Nie mówisz dużo, ale… jesteś dobrym słuchaczem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338138
    m_Localized: 'Widow: Obyś znalazł to, czego szukasz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338139
    m_Localized: 'Scammer: He, he. Siemaneczko.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338140
    m_Localized: Co robiłeś przed kataklizmem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338141
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338142
    m_Localized: 'Scammer: O, fajnie, że pytasz, gościu!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338143
    m_Localized: 'Scammer: Słyszałeś kiedyś o…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338144
    m_Localized: 'Scammer: …zakładach sportowych? Co?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338145
    m_Localized: Ktoś ty, jakiś naciągacz?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338146
    m_Localized: Pewnie, że tak
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338147
    m_Localized: 'Scammer: Daj na luz, nie nazywaj mnie tak! Jestem, kurwa, analitykiem, stary!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338148
    m_Localized: 'Scammer: Gdybyś skumał, ile kapuchy przeszło przez te palce, normalnie byś się zesrał, mordo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338149
    m_Localized: 'Scammer: Jestem zawodowcem. Jara mnie mój biznes, brachu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338150
    m_Localized: 'Scammer: Ludziska przynoszą szmal i zarabiają na tym pięć… nie, dziesięć razy tyle.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338151
    m_Localized: A ile ty zarobiłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338152
    m_Localized: I ty to nazywasz pracą?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338153
    m_Localized: 'Scammer: Tak zarabiam na życie, kolego!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338154
    m_Localized: 'Scammer: Legitne zakłady są dla frajerów i łochów, gościu! Nie ma lipy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338155
    m_Localized: 'Scammer: Są sposoby na wydymanie bukmacherów.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338156
    m_Localized: 'Scammer: Robisz zakład według mojej rady i tylko czekasz, aż spłynie kasiora!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338157
    m_Localized: 'Scammer: Nie masz hajsu, nie ma problemu. Pożycz od jakiegoś innego dekla!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338158
    m_Localized: A ile ty zarobiłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338159
    m_Localized: I ty to nazywasz pracą?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338160
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338161
    m_Localized: 'Scammer: Jakby to, ten teges…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338162
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338163
    m_Localized: 'Scammer: Wydusiłem z tego trzydzieści, kurwa, baniek…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338164
    m_Localized: 'Scammer: …długów, jasne, ale lachę na nie kładę!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338165
    m_Localized: 'Scammer: Mam je teraz głęboko w dupie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338166
    m_Localized: 'Scammer: Lubię żyć na krawędzi, chłopie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338167
    m_Localized: 'Scammer: Nie świruj pawiana.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338168
    m_Localized: 'Scammer: Pewnie, że to robota!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338169
    m_Localized: 'Scammer: Miałem nawet swoją kanciapkę i wszystko. Normalnie Francja elegancja!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338170
    m_Localized: 'Scammer: Skórzana, kurwa, kanapa i notesik, a w nim nazwiska bukmacherów, ile im wiszę, zysk netto i inne te papierowe bzdety.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338171
    m_Localized: 'Scammer: He, he. Siemaneczko.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338172
    m_Localized: Skąd wiesz, że nie dopadną cię windykatorzy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338173
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338174
    m_Localized: 'Scammer: Windykatorzy? Jacy, kurwa, windykatorzy?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338175
    m_Localized: 'Scammer: „Długi” poszły w chuj, koleżko. Słońce im dojebało!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338176
    m_Localized: 'Scammer: Banki leżą i kwiczą. Pewnie już tak zostanie!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338177
    m_Localized: 'Scammer: A to oznacza, że mogą mi skoczyć! Ale walutę trzeba wciąż ciułać!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338178
    m_Localized: 'Scammer: Zakłady też odwaliły kitę. Muszę obcykać coś nowego i lepszego.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338179
    m_Localized: Wygląda na to, że afera ze słońcem trafiła ci się jak ślepej kurze ziarno
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338180
    m_Localized: Poważnie? Wciąż będziesz jakimś naciągaczem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338181
    m_Localized: 'Scammer: Staaary, powaga? Nie sraj żarem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338182
    m_Localized: 'Scammer: Wszystko miałem wykoncypowane! Zawsze podwójna stawka albo nic! Bez trzymanki, chłopie!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338183
    m_Localized: 'Scammer: Teraz jednak mogę zacząć od nowa. Poważka.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338184
    m_Localized: 'Scammer: A tak przy okazji, wykminiłem nowy wałek. Wprowadzić cię? Co?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338185
    m_Localized: Dobra, dawaj
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338186
    m_Localized: Nie, dzięki
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338187
    m_Localized: 'Scammer: Od jakiegoś czasu mam nową zajawkę, jak zgarnąć srogą kasę. Ciekawy?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338188
    m_Localized: Dobra, dawaj
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338189
    m_Localized: Nie, dzięki
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338190
    m_Localized: 'Scammer: Wiadomo, że teraz wszystkim kręci FEMA, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338191
    m_Localized: 'Scammer: Musimy się im… jakoś podlizać. Czaisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338192
    m_Localized: 'Scammer: Na przykład będziemy kablować im na jakichś frajerów, a może nawet wpuszczą nas do swoich odpicowanych bunkrów.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338193
    m_Localized: 'Scammer: Kumasz bazę?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338194
    m_Localized: Chcesz im donosić na ludzi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338195
    m_Localized: Myślisz, że FEMA udzieli ci pomocy?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338196
    m_Localized: 'Scammer: Pewnie. Czemu, kurwa, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338197
    m_Localized: 'Scammer: Nie bądź pizda.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338198
    m_Localized: 'Scammer: Ciężkie czasy, ciężkie wałki, bracie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338199
    m_Localized: 'Scammer: Strefy kwarantanny są dla leszczy. Tam nie dzieje się nic dobrego.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338200
    m_Localized: 'Scammer: Musimy więc zwazelinować gości z FEMA. Trochę się im pomizdrzyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338201
    m_Localized: 'Scammer: Nie musimy włazić im bez mydła, ale podłożyć im jakichś ludzi… Dać im to, czego chcą.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338202
    m_Localized: 'Scammer: Możemy zadzwonić na infolinię i pogadać o objawach czy o dupie Maryni! Żeby wiedzieli, że jesteśmy prawilni, mordo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338203
    m_Localized: 'Scammer: Oni są spoko. Serio, serio!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338204
    m_Localized: Może masz rację
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338205
    m_Localized: Gadasz od rzeczy
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338206
    m_Localized: Jeśli tak bardzo chcesz im włazić w dupę, wypierdalaj stąd
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338207
    m_Localized: 'Scammer: Kurde, stary. Z duchem czasu to ty nie pobaraszkujesz…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338208
    m_Localized: 'Scammer: Tak czy owak, musimy ustalić, kto tam rządzi i się do niego uśmiechnąć. To nie do przegrania, kapujesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338209
    m_Localized: 'Scammer: Musimy więc zwazelinować gości z FEMA. Trochę się im pomizdrzyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338210
    m_Localized: 'Scammer: Nie musimy włazić im bez mydła, ale podłożyć im jakichś ludzi… Dać im to, czego chcą.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338211
    m_Localized: 'Scammer: Możemy zadzwonić na infolinię i pogadać o objawach czy o dupie Maryni! Żeby wiedzieli, że jesteśmy prawilni, mordo.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338212
    m_Localized: 'Scammer: Oni są spoko. Serio, serio!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338213
    m_Localized: Może masz rację
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338214
    m_Localized: Gadasz od rzeczy
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338215
    m_Localized: Jeśli tak bardzo chcesz im włazić w dupę, wypierdalaj stąd wtedy
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338216
    m_Localized: 'Scammer: No raczej, że mam rację.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338217
    m_Localized: 'Scammer: Wałki wyczuwam na kilometr, chłopie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338218
    m_Localized: 'Scammer: Możesz mi wierzyć, że ze mną nie zginiesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338219
    m_Localized: 'Scammer: Spierdalaj, gościu. Sam gadasz od rzeczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338220
    m_Localized: 'Scammer: Ludzie płacili mamonę za moje porady inwestycyjne. Tobie daje je za friko, ofiarowując w darze, a ty…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338221
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338222
    m_Localized: 'Scammer: Chuj ci w dupę i kamieni kupę, pało… Idź mi z tym.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338223
    m_Localized: 'Scammer: Co, wywalisz mnie na zbity pysk czy coś, chłopie?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338224
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338225
    m_Localized: 'Scammer: A ja myślałem, ze trzymamy sztamę…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338226
    m_Localized: 'Scammer: Nawet zaoferowałem ci udział w moim wałku. A ty tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338227
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338228
    m_Localized: 'Scammer: Idź do diabła. Spadam stąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338229
    m_Localized: 'Scammer: Kurde, poważnie? A już miałem wszystko z tym obcykane. Ale jak tam chcesz, gościu…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338230
    m_Localized: 'Scammer: Jeśli zmienisz zdanie, daj mi znać, czaisz…?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338231
    m_Localized: 'Scammer: He, he. Siemaneczko.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338232
    m_Localized: Czego chcesz?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338233
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338234
    m_Localized: 'Scammer: Obczaj, obmyśliłem nowy wałek. Jest git majonez, serio.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338235
    m_Localized: 'Scammer: Dobra, więc…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338236
    m_Localized: 'Scammer: Słońce pali nas jak na jakimś diabelskim grillu, no nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338237
    m_Localized: 'Scammer: To chyba oznacza, że warstwę ozonową chuj strzelił.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338238
    m_Localized: 'Scammer: Ale czaj to… tlen pochodzi od słońca przechodzącego przez ozon…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338239
    m_Localized: 'Scammer: Rozumiesz, do czego piję?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338240
    m_Localized: 'Scammer: SPRZEDAŻ POWIETRZA!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338241
    m_Localized: 'Scammer: To dopiero konkretny wałek, kolego!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338242
    m_Localized: Do licha, wspaniały plan, aż dech zapiera
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338243
    m_Localized: To najbardziej debilny pomysł, jaki, psiamać, w życiu słyszałem
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338244
    m_Localized: 'Scammer: Staaary! Tak myślisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338245
    m_Localized: Oczywiście, powinieneś iść na doktorat
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338246
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338247
    m_Localized: 'Scammer: Kurde, cóż…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338248
    m_Localized: 'Scammer: Dzięki, gościu! Wiedziałem, że jesteś łebski gość! Wszystkie te mózgowe soki aż mi po jajcach krążą!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338249
    m_Localized: 'Scammer: W tym tempie dostanę Nagrodę Darwina!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338250
    m_Localized: Czy wiesz w ogóle, czym jest Nagroda Darwina?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338251
    m_Localized: Na pewno ją dostaniesz
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338252
    m_Localized: 'Scammer: Eee… Oni je dają za te, no, jakby najlepsze naukowe pierdu‑pierdu czy inne kujoństwo, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338253
    m_Localized: 'Scammer: Dlaczego?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338254
    m_Localized: Bez powodu
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338255
    m_Localized: Nagrodę Darwina otrzymują ludzie, którzy zginęli w idiotyczny sposób
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338256
    m_Localized: 'Scammer: Ha, ha! Już czuję ten szacun. Król kujonów! Padajcie na kolana, nieuki!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338257
    m_Localized: 'Scammer: Gruba kasa, grube propsy, grube tyłeczki… Zajebiście, kurwa!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338258
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338259
    m_Localized: 'Scammer: Dobra, uzgodnione. Jak to wszystko przeminie, składam patent na technologię sprzedaży powietrza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338260
    m_Localized: 'Scammer: Wiedziałem, że mnie zrozumiesz, chłopie! W pytę!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338261
    m_Localized: 'Scammer: Och…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338262
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338263
    m_Localized: 'Scammer: Czekaj, brechtasz się ze mnie?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338264
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338265
    m_Localized: 'Scammer: Idź w chuj. Ja tu kręcę wałki życia, a ty masz ze mnie pompę?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338266
    m_Localized: 'Scammer: Goń się. Ja tu kręcę wałki za grube bańki, a ty masz ze mnie pompę?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338267
    m_Localized: 'Scammer: Zdobędę tę Nagrodę Darwina i będę zafajdanym miliarderem, chłopie!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338268
    m_Localized: 'Scammer: Wtedy będziesz mnie całował po rękach i błagał o przebaczenie…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338269
    m_Localized: Weź wypierdalaj z tymi twoimi pomysłami z dupy
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338270
    m_Localized: 'Scammer: Kurde, stary…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338271
    m_Localized: 'Scammer: Czy naprawdę tak ciężko jest mnie wysłuchać? Wkurzam cię, czy coś?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338272
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532288
    m_Localized: 'Scammer: Chuj z tym, pal wrotki. Sam i tak zarobię więcej.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532289
    m_Localized: 'Scammer: Kurde, stary…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532290
    m_Localized: 'Scammer: Idź w chuj. Ja tu kręcę wałki życia, a ty masz ze mnie pompę?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532291
    m_Localized: 'Scammer: Zdobędę tę Nagrodę Darwina i będę zafajdanym miliarderem, chłopie!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532292
    m_Localized: 'Scammer: Wtedy będziesz mnie całował po rękach i błagał o przebaczenie…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532293
    m_Localized: 'Neighbour: Szlag… Więc mimo wszystko to prawda…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532294
    m_Localized: 'Neighbour: W takim razie wszystko, co mówiłem, ma sens.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532295
    m_Localized: 'Neighbour: Nie wychodź z domu za dnia. Pamiętaj też, że musisz zapraszać ludzi do środka.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532296
    m_Localized: Dlaczego mam wpuszczać nieznajomych?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532297
    m_Localized: Zapraszać ludzi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532298
    m_Localized: 'Neighbour: Wiem, że wolisz trzymać się z dala od ludzi, ale musisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532299
    m_Localized: 'Neighbour: Moja kuzynka nie jest pewna, dlaczego nie możemy przeczekać tego w samotności…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532300
    m_Localized: 'Neighbour: Wspominała jednak, że jeśli ktoś się będzie pytał, czy jesteś sam w domu, zaprzecz i powiedz, że masz gości.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532301
    m_Localized: Nie cierpię zadawać się z ludźmi
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532302
    m_Localized: Dlaczego muszę mieć u siebie innych ludzi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532303
    m_Localized: 'Neighbour: Rozumiem doskonale…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532304
    m_Localized: 'Neighbour: Wiem, że nie przepadasz za gośćmi w domu. Musisz jednak ich wpuszczać.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532305
    m_Localized: 'Neighbour: Moja kuzynka nie jest pewna, dlaczego nie możemy przeczekać tego w samotności…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532306
    m_Localized: 'Neighbour: Wspominała jednak, że jeśli ktoś się będzie pytał, czy jesteś sam w domu, zaprzecz i powiedz, że masz gości.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532307
    m_Localized: Nie cierpię zadawać się z ludźmi
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532308
    m_Localized: Dlaczego muszę mieć u siebie innych ludzi?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532309
    m_Localized: 'Neighbour: Wiem. To nie będzie dla ciebie łatwe, ale nie masz wyboru. To być może jedyne, co utrzyma cię przy życiu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532310
    m_Localized: 'Neighbour: I kto wie, może goście przyniosą ze sobą coś przydatnego lub podzielą się ciekawą nowiną.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532311
    m_Localized: 'Neighbour: Pamiętaj, żeby sprawdzić ich, czy nie są Przybyszami. Za dnia nie będziesz mieć zbyt dużo energii przy tym upale.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532312
    m_Localized: 'Neighbour: Wybierz wtedy dokładnie, kogo chcesz sprawdzić. Będziesz musiał się uważnie przyjrzeć. To ciężkie i wyczerpujące zajęcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532313
    m_Localized: 'Neighbour: Nie obawiaj się jednak z nimi rozmawiać. To nie kosztuje energii, więc dyskutuj do woli.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532314
    m_Localized: 'Neighbour: Wyglądaj też przez okna. Telewizja daje radę, ale najlepiej jest zdobywać informacje własnymi oczami.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532315
    m_Localized: I potem co?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532316
    m_Localized: Co musimy robić?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532317
    m_Localized: 'Neighbour: Ludzie, których wpuścisz, mogą przynieść ze sobą coś przydatnego lub podzielić się ciekawą nowiną.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532318
    m_Localized: 'Neighbour: Nie zapomnij, żeby sprawdzić ich, czy nie są Przybyszami. Za dnia nie będziesz mieć zbyt dużo energii przy tym upale.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532319
    m_Localized: 'Neighbour: Wybierz wtedy dokładnie, kogo chcesz sprawdzić. Będziesz musiał się uważnie przyjrzeć. To ciężkie i wyczerpujące zajęcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532320
    m_Localized: 'Neighbour: Nie obawiaj się jednak z nimi rozmawiać. To nie kosztuje energii, więc dyskutuj do woli.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532321
    m_Localized: 'Neighbour: Wyglądaj też przez okna. Telewizja daje radę, ale najlepiej jest zdobywać informacje na własną rękę.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532322
    m_Localized: I potem co?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532323
    m_Localized: Co musimy robić?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532324
    m_Localized: 'Neighbour: Obawiam się, że możemy jedynie starać się przeżyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532325
    m_Localized: 'Neighbour: I mieć nadzieję, że ten koszmar się wkrótce skończy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532326
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532327
    m_Localized: 'Neighbour: Rząd na pewno nam jakoś pomoże. Może zaprowadzą wszystkich do jakiegoś bezpiecznego miejsca czy coś.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532328
    m_Localized: 'Neighbour: Jeśli tak będzie, trzymaj się mnie i mojej rodziny.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532329
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532330
    m_Localized: 'Neighbour: Och, niemal zapomniałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532331
    m_Localized: 'Neighbour: Jutro wieczorem wracam do domu. Tu masz mój numer telefonu. Dzwoń o każdej porze.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532332
    m_Localized: 'Neighbour: Niedawno nam pociągnęli linię.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532333
    m_Localized: 'Neighbour: XXX-XXX-XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532334
    m_Localized: 'Neighbour: Bądźmy w kontakcie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532335
    m_Localized: 'Neighbour: Dobra, to na pewno wszystko.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532336
    m_Localized: 'Neighbour: I tak przy okazji, przyniosłem ci zgrzewkę piwa. Szwagier pracuje w browarze.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532337
    m_Localized: 'Neighbour: Golnij jednego przed pójściem spać.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532338
    m_Localized: 'Neighbour: Od razu poczujesz się senny. Jeśli kiedykolwiek poczujesz, że masz dość rozmów na dany dzień, wypij piwo i odpocznij.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532339
    m_Localized: 'Daughter: Ja… chcę do m‑mamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532340
    m_Localized: Powiedz mi, co się stało
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532341
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532342
    m_Localized: 'Daughter: Nieee wieeem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532343
    m_Localized: 'Daughter: Przyszli i zaczęli rozmawiać, a tata powiedział, że nie mają racji, a potem oni mówili… mówili…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532344
    m_Localized: 'Daughter: TATO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532345
    m_Localized: 'Daughter: TAAATOOO!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532346
    m_Localized: Okej… odpocznij na razie.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532347
    m_Localized: Jutro pomówimy dalej, dobrze?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532348
    m_Localized: 'Daughter: (Dziewczynka bez przerwy woła tatę. Jej histeria zdaje się nie mieć końca).'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532349
    m_Localized: 'Daughter: (Nawet cię nie słyszy. Całkowicie pochłonęło ją zatroskanie).'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532350
    m_Localized: 'Daughter: Ja… chcę do m‑mamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532351
    m_Localized: Jak się czujesz? Podoba ci się tu?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532352
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532353
    m_Localized: 'Daughter: Uhm… Jest okej.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532354
    m_Localized: 'Daughter: Ale wolałabym być w domu…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532355
    m_Localized: 'Daughter: Kiedy mogę iść do domu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532356
    m_Localized: Może później… macie remont
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532357
    m_Localized: Być może nigdy. Wasz dom spłonął
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532358
    m_Localized: 'Daughter: Okej… więc niedługo po mnie przyjdą?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532359
    m_Localized: 'Daughter: I wezmą mnie do nowego domu?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532360
    m_Localized: 'Daughter: Czy pójdziemy do starego?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532361
    m_Localized: 'Daughter: Czy robią dla mnie nowy pokój?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532362
    m_Localized: 'Daughter: Tata po mnie przyjdzie, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532363
    m_Localized: No tak, widziałaś, co się stało…
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532364
    m_Localized: Powinnaś teraz zostać tutaj na jakiś czas
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532365
    m_Localized: 'Daughter: Ale mojemu tacie nic nie jest?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532366
    m_Localized: 'Daughter: I co z moim pokojem? Czy on też spłonął?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532367
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532368
    m_Localized: 'Daughter: Mama nie przyjdzie?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532369
    m_Localized: 'Daughter: Czy został ktoś jeszcze?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532370
    m_Localized: No tak, widziałaś, co się stało…
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532371
    m_Localized: Powinnaś teraz zostać tutaj na jakiś czas
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532372
    m_Localized: 'Daughter: Ja… nie wiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532373
    m_Localized: 'Daughter: To znaczy nie jestem pewna.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532374
    m_Localized: 'Daughter: Uderzyli tatę, ale podniósł się. Widziałam.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532375
    m_Localized: 'Daughter: To znaczy… To znaczy, że mógł ugasić ogień.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532376
    m_Localized: 'Daughter: Albo pójść mnie poszukać.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532377
    m_Localized: 'Daughter: Czy przyjdzie niedługo?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532378
    m_Localized: 'Daughter: Nigdzie nie idę bez taty.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532379
    m_Localized: 'Daughter: Przyjdzie po mnie, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532380
    m_Localized: 'Daughter: Widziałam, jak wstaje i idzie sobie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532381
    m_Localized: 'Daughter: Uciekałam wtedy, ale widziałam go.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532382
    m_Localized: 'Daughter: Ja… chcę do m‑mamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532383
    m_Localized: Musisz pogodzić się z tym, co się stało
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532384
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532385
    m_Localized: 'Daughter: Co ma pan na myśli?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532386
    m_Localized: 'Daughter: Widziałam u pana telewizor w pokoju. Czy mogę pooglądać bajki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532387
    m_Localized: Nie wiem, co widziałaś, ale wydaje mi się, że twój tata nie żyje
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532388
    m_Localized: Tata może po ciebie nie przyjść. Nie wiem, co się z nim mogło stać
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532389
    m_Localized: 'Daughter: Pan nic nie widział!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532390
    m_Localized: 'Daughter: Ja tam byłam! Widziałam, jak się rusza, gdy uciekałam.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532391
    m_Localized: 'Daughter: A to znaczy, że po mnie niedługo przyjdzie!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532392
    m_Localized: Dlaczego wtedy jeszcze nie przyszedł?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532393
    m_Localized: Jak wyglądał, gdy widziałaś go po raz ostatni?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532394
    m_Localized: 'Daughter: Mówi pan, że tata nie przyjdzie? D‑dlaczego pan tak mówi?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532395
    m_Localized: Dlaczego wtedy jeszcze nie przyszedł?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532396
    m_Localized: Jak wyglądał, gdy widziałaś go po raz ostatni?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532397
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532398
    m_Localized: 'Daughter: Uhm… Może miał coś najpierw do zrobienia?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532399
    m_Localized: 'Daughter: Na pewno poszedł pobić tamtych złych ludzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532400
    m_Localized: 'Daughter: On… powinien tu niedługo być.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532401
    m_Localized: Przykro mi z powodu twojego taty. Był dobrym człowiekiem. Zbyt uprzejmym jak na ten świat
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532402
    m_Localized: Dokładnie, jestem pewien, że już tu idzie
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532403
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532404
    m_Localized: 'Daughter: Wyglądał dobrze.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532405
    m_Localized: 'Daughter: Uderzyli go… więc tata…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532406
    m_Localized: 'Daughter: Nie pamiętam…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532407
    m_Localized: Przykro mi z powodu twojego taty. Był dobrym człowiekiem. Zbyt uprzejmym jak na ten świat
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532408
    m_Localized: Dokładnie, jestem pewien, że już tu idzie
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532409
    m_Localized: 'Daughter: (Dziewczynka zdaje się patrzeć w przestrzeń. Obawiasz się poruszyć, więc czekasz, aż coś się wydarzy).'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532410
    m_Localized: 'Daughter: (Po jakimś czasie zaczyna znowu płakać. Wygląda na to, że nie możesz jej pomóc).'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532411
    m_Localized: 'Daughter: (Gorzej by było, gdyby miała uwierzyć w kłamstwa. Musi się jak najszybciej nauczyć akceptować rzeczywistość).'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532412
    m_Localized: 'Daughter: Tak myślałam.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532413
    m_Localized: 'Daughter: (Zauważasz, że dziewczynka jest rozproszona. Najwyraźniej myśli o czymś innym).'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532414
    m_Localized: 'Daughter: (Czy warto rujnować jej życie? Czy wytrzyma takie wieści?).'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532415
    m_Localized: 'Daughter: (Decydujesz, że na tę chwilę przeszła już wystarczająco wiele. Nie ma powodów, by jeszcze bardziej pogarszać jej sytuację).'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532416
    m_Localized: 'NotTrue: Ojejku, ale jużem stara…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532417
    m_Localized: Skąd pani jest?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532418
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532419
    m_Localized: 'NotTrue: Tak, kochaniutki… Co w tym złego?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532420
    m_Localized: 'NotTrue: Młodzież prosi o moje gawędy, a potem mnie za nie ganią. Pfuj!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532421
    m_Localized: 'NotTrue: Czy wiesz, jak to jest, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532422
    m_Localized: 'NotTrue: Mam dom. Małą, starą chatkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532423
    m_Localized: 'NotTrue: Lubię tam przesiadywać, owszem, lecz uschnę, gdy nikt nie zawita.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532424
    m_Localized: 'NotTrue: I kto też by zaszedł do takiej małej, starej chatki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532425
    m_Localized: 'NotTrue: Przeto tułam się i włóczę, kochaniutki. Nie mam już nic do utracenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713862
    m_Localized: 'NotTrue: Byłam miastowa, kochaniutki. Miałam małe mieszkanie w bloku.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713863
    m_Localized: 'NotTrue: Żadną tam chałupę na wsi, bez zgrzybiałego, starego męża, bez żadnych wnuków.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713864
    m_Localized: 'NotTrue: Przeto na ławeczce większość dni przesiadywałam. Czułam się wtedy żywsza, wierz mi. I, ach, jakże wiele ciekawych rzeczy słyszałam.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713865
    m_Localized: 'NotTrue: Lecz wtedy zaczęły się te banialuki i, cóż, przestało mi się tam podobać.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713866
    m_Localized: 'NotTrue: Pfuj! Jakże można czuć się żywym, gdy wokół ludzie jak muchy mrzą!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713867
    m_Localized: 'NotTrue: Na klatce schodowej wciąż leżało jakieś biedaczysko okryte białym prześcieradłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713868
    m_Localized: 'NotTrue: Niebiosa, łatwiej samemu ze sobą skończyć, niż bez ustanku patrzeć na tę mękę!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713869
    m_Localized: 'NotTrue: Więc się wyniosłam! Podreptałam szukać innego zakątka, gdzie jeszcze można słuchać opowieści i czuć, że życie trwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713870
    m_Localized: 'NotTrue: A spójrzże, spójrzże, los mnie pod twoje progi przyprowadził, kochaniutki!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713871
    m_Localized: 'NotTrue: Do kościoła nie chadzam, lecz w takich czasach… zda się, iż same niebiosa mnie prowadziły.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532426
    m_Localized: 'NotTrue: Ojejku, ale jużem stara…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532427
    m_Localized: Czy ma pani jakichś krewnych?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532428
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532429
    m_Localized: 'NotTrue: Och, takie najzwyklejsze. Opowiadam o ludziach, których przez te lata poznałam.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532430
    m_Localized: 'NotTrue: Dzielę się nimi z każdym, kto raczy posłuchać.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532431
    m_Localized: 'NotTrue: Ale mam już swoje lata. Coraz trudniej mi wszystko w pamięci utrzymać. Czasem… zmieniam pewne szczegóły.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532432
    m_Localized: 'NotTrue: Pewnie dlatego teraz wszyscy mnie nie cierpią, kochaniutki.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532433
    m_Localized: 'NotTrue: Posłuchaj mądrości od starej babuni… Czoło pęka od grobowej boleści, w sieć strasznych snów wzlatujemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532434
    m_Localized: 'NotTrue: Lecz widzę, że nie tylko mnie nawiedzają sny straszliwsze, niż się zdaje, prawda? He, he, he.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532435
    m_Localized: 'NotTrue: Prędzej czy później wszyscy do mnie przychodzą.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532436
    m_Localized: 'NotTrue: Wszyscy potrzebują opowiastek.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713872
    m_Localized: 'NotTrue: Jużci nikt o mnie nie pomni, kochaniutki…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713873
    m_Localized: 'NotTrue: Jeśli jeszcze kto przy żywocie został, to i tak nie nawiedza biednej, starej babuni.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713874
    m_Localized: 'NotTrue: Ostatnimi czasy tako bywa z młodymi. Wielu ich tak pochłania żywot, iż o swoich zapominają…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713875
    m_Localized: 'NotTrue: Wszyscy wciąż zaaferowani tym albo owym. Nikt nie zadzwoni, nie spyta, jako mi się wiedzie. Pfuj!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713876
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713877
    m_Localized: 'NotTrue: Jednego razu siedziała żem na ławeczce, a sąsiadka moja pleść poczęła o swym wnuku.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713878
    m_Localized: 'NotTrue: Rzekła „Wnuczek mój toć aniołek! Zawsze o babce pamięta!”.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713879
    m_Localized: 'NotTrue: I cóż, nie zmyślała, kochaniutki. Zawsze „dzień dobry” rzekł, ułożony młodziak, jak się patrzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713880
    m_Localized: 'NotTrue: Czasem mi się i zazdrość do serca wkradła…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713881
    m_Localized: 'NotTrue: …a potem sąsiadka ta pomarła.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713882
    m_Localized: 'NotTrue: A ów cherubinek w łapserdaka się obrócił i to srogiego.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713883
    m_Localized: 'NotTrue: Jedynie pragnął kluczy do izby babcinej w zamian za liche uśmiechy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713884
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713885
    m_Localized: 'NotTrue: Myślisz czemu ludzie kłamią w żywe oczy, hm? Nieprawda odbita w ślepiach najbliższych.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713886
    m_Localized: 'NotTrue: Pobrać się, spłodzić dzieci, a potem… okazuje się, że wcale cię nie miłują!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713887
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713888
    m_Localized: 'NotTrue: Dobrze, że mój małżonek już w mogile leży. Podły to był zgred. Pfuj!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532437
    m_Localized: 'NotTrue: Ojejku, ale jużem stara…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532438
    m_Localized: Co się stało z pani mężem?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532439
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532440
    m_Localized: 'NotTrue: O czymże ci mam dziś opowiedzieć, kochaniutki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532441
    m_Localized: 'NotTrue: Człowiek to bojaźliwe zwierzę.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532442
    m_Localized: 'NotTrue: Kiedyś znałam takiego jegomościa, co od wszystkich się odciął.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532443
    m_Localized: 'NotTrue: Zaszył się w swojej izbie wysoko w bloku, tak… i rzadko wyścibiał z niej nosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532444
    m_Localized: 'NotTrue: Może obawiał się Przybyszy. Albo i samej śmierci.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532445
    m_Localized: 'NotTrue: Nikt go nie odwiedzał. I tak by pewnie nikogo nie wpuścił, wiesz…?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532446
    m_Localized: 'NotTrue: Aż pewnego dnia…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532447
    m_Localized: 'NotTrue: Usłyszałam ciche larum, jakoby krzywda się stała, niby gdy trafić na szkiełko w dżemie truskawkowym…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532448
    m_Localized: 'NotTrue: I pomyślałam sobie „O jejku, cóż to mogło być?”.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532449
    m_Localized: 'NotTrue: Wyjrzałam tedy przez okno, a onże tak nisko był, jak tylko być można.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532450
    m_Localized: 'NotTrue: …wyskoczył.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532451
    m_Localized: 'NotTrue: Podobała ci się ta powiastka, kochaniutki?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532452
    m_Localized: Wcale
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532453
    m_Localized: Czy to koniec?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532454
    m_Localized: 'NotTrue: Pfuj! Pewnie dlatego nikt się ku mnie nie garnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532455
    m_Localized: 'NotTrue: Pamiętaj jeno… Kiedyś opowiem także twoją historię, tak jak ją zapamiętam.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532456
    m_Localized: 'NotTrue: Tak, kochaniutki. Kiedyś pan, a teraz naleśnik.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532457
    m_Localized: 'NotTrue: Może się lękał męki, którą słońce w gniewie gotuje… a może i nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532458
    m_Localized: 'NotTrue: Ja? Pfuj! Zachodzę w głowę, iż serce mu z samotności pękło.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532459
    m_Localized: 'NotTrue: Ale nic po tym, kochaniutki.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713889
    m_Localized: 'NotTrue: Ach, onże już dawno odszedł, kochaniutki.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713890
    m_Localized: 'NotTrue: Zrujnował mi mój młody, kwitnący żywot, tak! Stary grzyb!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713891
    m_Localized: 'NotTrue: Stanęłam przed ołtarzem jeno dlatego, iż mi rodzice wiercili dziurę w brzuchu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713892
    m_Localized: 'NotTrue: „Wyjdźże zań, kochaniutka, bo poczciwy!” – mówili. Więc tak zrobiłam.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713893
    m_Localized: 'NotTrue: Zrazu byłże złotkiem, owszem! Ale gdy jeno ryż weselny opadł, rozbestwił się srodze.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713894
    m_Localized: 'NotTrue: Całe dnie przy garach tyrałam, a w nagrodę słyszałam: „Nie jęczże, nie widzisz, iż jem?”.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713895
    m_Localized: 'NotTrue: Potem na długie godziny znikał, upijając się jak świnia! Pfuj!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713896
    m_Localized: 'NotTrue: Wracał przepity, śmierdząc jak gorzelnia, prawiąc dyrdymały o graniu w domino w garażu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713897
    m_Localized: 'NotTrue: A jeśli śmiałabym pytać, wrzeszczałby jak opętany, podły gnojek!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713898
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713899
    m_Localized: 'NotTrue: …a potem pomarł.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713900
    m_Localized: 'NotTrue: Z początku czułam się lekko jak piórko, kochaniutki! Lecz rychło zawitała pustka.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713901
    m_Localized: 'NotTrue: Telewizorek nieco pomagał, lecz teraz to samo pierniczenie, jeno paplanina bez ładu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713902
    m_Localized: 'NotTrue: Zaczęłam tedy przesiadywać na ławeczce i patrzeć, jak świat mię mija.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532460
    m_Localized: 'NotTrue: Ojejku, ale jużem stara…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532461
    m_Localized: I jak mijało pani siedzenie na ławce?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532462
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532463
    m_Localized: 'NotTrue: Dobrze, kochaniutki… Ta jest specjalnie dla ciebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532464
    m_Localized: 'NotTrue: Dawien dawno znałam człowieka, co mieszkał w mej wsi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532465
    m_Localized: 'NotTrue: Uwielbiał przemierzać las wzdłuż i wszerz. Nikt nie wiedział dlaczego, ale tak wędrował.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532466
    m_Localized: 'NotTrue: Pewnego dnia szedł przez gaj i zgubił się, drogi powrotnej nie znalazł.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532467
    m_Localized: 'NotTrue: Przystanął na chwilę, by myśli zebrać, i pomyślał, że iść dalej musi, boć dokądś dojdzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532468
    m_Localized: 'NotTrue: Szedł tedy i szedł, a jeno błądził, bo końca boru nie widział.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532469
    m_Localized: 'NotTrue: Aż tu zrozumiał, że w kółko brnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532470
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532471
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532472
    m_Localized: I potem co?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532473
    m_Localized: To jakieś brednie
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532474
    m_Localized: 'NotTrue: …znaleźli go martwego.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532475
    m_Localized: 'NotTrue: Nie wyszedł już nigdy. Ślady jego zataczały kręgi, coraz bliższe smutnemu końcowi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532476
    m_Localized: 'NotTrue: Wiesz, co prawią, kochaniutki? Jedną nogą dłuższe kroki się stawia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532477
    m_Localized: 'NotTrue: A teraz robaki go jedzą.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532478
    m_Localized: 'NotTrue: Pfuj! Nie przypadła ci do gustu ta powiastka?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532479
    m_Localized: 'NotTrue: Może i… tu i ówdzie coś wyolbrzymiłam…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532480
    m_Localized: 'NotTrue: Lecz prawdziwe to zdarzenie. Każdemu by się tak mogło przytrafić.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532481
    m_Localized: 'NotTrue: Często ludzie wychodzą na spacery i drogi nie znajdują. A jakże wracają?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713903
    m_Localized: 'NotTrue: Och, kochaniutki…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713904
    m_Localized: 'NotTrue: Lżej mi się robiło, gdy patrzałam, jak świat płynie. Dzieci się śmiały, młode pary z miłowaniem w oczach, psy dreptały…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713905
    m_Localized: 'NotTrue: Wtedy jednak zaczął się cały ten pasztet… Pfuj!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713906
    m_Localized: 'NotTrue: Po kolei ludzie drzwi na klucz zamykali. Żywot znikł ze dworu, nikt nie przechodził już koło samotnej babuni na ławeczce.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713907
    m_Localized: 'NotTrue: Widok z okna też nie lepszy, nie…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713908
    m_Localized: 'NotTrue: Już bez śmiechów ni zawołań. Jeno psy zdziczałe i sąsiedzi, co się na siebie gapią jak na cudaki.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713909
    m_Localized: 'NotTrue: Życie, kochaniutki, zdało się stanąć w miejscu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713910
    m_Localized: 'NotTrue: A teraz… Pfuj! Nie sposób odróżnić dyrdymałów od prawdy!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713911
    m_Localized: 'NotTrue: Och, oby ludzie przestali w końcu łgać, kochaniutki…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532482
    m_Localized: 'Alkonost: Muszę tylko zebrać siły. Oby tylko ktoś mi ich trochę użyczył.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532483
    m_Localized: Jak się czuje pani siostra?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532484
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532485
    m_Localized: 'Alkonost: Muszę jej pomagać w wielu sprawach.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532486
    m_Localized: 'Alkonost: Wczoraj udało mi się ją wykąpać. W domu nie mogłam nawet zaciągnąć jej do wanny.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532487
    m_Localized: 'Alkonost: U niej na razie bez zmian. Ale dziękuję, że pan pyta.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532488
    m_Localized: 'Alkonost: Depresja… komplikuje wiele spraw.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532489
    m_Localized: 'Alkonost: Obawiam się, że gdyby coś się stało i musiałybyśmy brać nogi za pas, ona byłaby zbyt słaba, by chociaż wstać.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532490
    m_Localized: 'Alkonost: Albo nie będzie mogła niczego zjeść, bo nie znajdzie w sobie siły, by przeżuwać i przełykać.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532491
    m_Localized: 'Alkonost: Ja też jestem wyczerpana. Chyba trochę tu odetchnę…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532492
    m_Localized: 'Alkonost: Muszę tylko zebrać siły. Oby tylko ktoś mi ich trochę użyczył.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532493
    m_Localized: Co poczną panie dalej?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532494
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532495
    m_Localized: 'Alkonost: Dobre pytanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532496
    m_Localized: 'Alkonost: Wkrótce powinien po nas przyjść mój mąż. Mam nadzieję, że znajdzie nam jakiś bezpieczny nocleg.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532497
    m_Localized: 'Alkonost: Gdzieś, gdzie będziemy mogli przeczekać najścia Przybyszy i skwar słońca.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532498
    m_Localized: 'Alkonost: Mówił, że są takie miejsca. Wspominał też, że słońce wcale nie wybuchnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532499
    m_Localized: 'Alkonost: Ponoć gdyby miało, wszyscy byśmy zginęli w mniej niż 10 minut.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532500
    m_Localized: 'Alkonost: Chyba ma rację.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532501
    m_Localized: 'Alkonost: Muszę tylko zebrać siły. Oby tylko ktoś mi ich trochę użyczył.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532502
    m_Localized: Ma pani jakieś wieści od męża?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532503
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532504
    m_Localized: 'Alkonost: Jeszcze żadnych… Z jakiegoś powodu nie dzwonił ani nie przyszedł jeszcze po nas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532505
    m_Localized: 'Alkonost: Czy myśli pan, że coś mogło mu się stać? Albo może ma jakieś kłopoty?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532506
    m_Localized: 'Alkonost: Na pewno nas nie porzucił. To niemożliwe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532507
    m_Localized: 'Alkonost: Nawet gdy miał już moją siostrę powyżej uszu, wciąż pomagał mi się nią zajmować.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532508
    m_Localized: 'Alkonost: On… na pewno już tu zmierza.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532509
    m_Localized: 'Alkonost: I mojej siostrze chyba nieco się polepszyło, więc… na pewno niedługo tu będzie. Wszystko będzie dobrze, gdy przyjdzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532510
    m_Localized: 'Alkonost: Muszę tylko zebrać siły. Oby tylko ktoś mi ich trochę użyczył.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532511
    m_Localized: Wygląda pani na smutną
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532512
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532513
    m_Localized: 'Alkonost: Naprawdę?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532514
    m_Localized: 'Alkonost: Och. Nie powinno mnie to dziwić.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532515
    m_Localized: 'Alkonost: Mam sporo na głowie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532516
    m_Localized: 'Alkonost: Jeśli słońce nie wybuchnie, czemu wciąż jest taki gorąc? Czemu wszyscy mówią, że to koniec świata?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532517
    m_Localized: 'Alkonost: Słyszałam w wiadomościach.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532518
    m_Localized: 'Alkonost: Nie mówili tego wprost, ale zdaje się, że skwar za dnia robi się coraz większy.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532519
    m_Localized: 'Alkonost: Klimat się zmienia, a to znaczy, że giną zwierzęta, bo nie mogą dostosować się do nowej… pogody.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532520
    m_Localized: 'Alkonost: Co z nami będzie?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532521
    m_Localized: 'Alkonost: Muszę tylko zebrać siły. Oby tylko ktoś mi ich trochę użyczył.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532522
    m_Localized: Jak się pani trzyma?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532523
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532524
    m_Localized: 'Alkonost: Ostatniej nocy wyszłam poszukać męża.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532525
    m_Localized: 'Alkonost: Poszłam w miejsca, gdzie mógłby być.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532526
    m_Localized: 'Alkonost: I znalazłam go… Wziął pigułkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532527
    m_Localized: 'Alkonost: My… kupiliśmy te prochy, by zażyć je razem. W razie, gdyby wszystko pierdolnęło.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532528
    m_Localized: 'Alkonost: Wziął swoją. Strach go przerósł. Nawet na mnie nie poczekał, żebyśmy zrobili to razem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532529
    m_Localized: 'Alkonost: Zażył to. Sam połknął tabletkę, zanim połknęło go słońce.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532530
    m_Localized: 'Sirin: To koniec.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532531
    m_Localized: Jak się pani trzyma?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532532
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532533
    m_Localized: 'Sirin: Czuję, jakby…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532534
    m_Localized: 'Sirin: Miała na siebie zarzucony koc z ołowiu. Wszystko mi tak bardzo, bardzo ciąży.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532535
    m_Localized: 'Sirin: Przygniata mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532536
    m_Localized: 'Sirin: Chciałabym… go zrzucić.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532537
    m_Localized: 'Sirin: To koniec.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532538
    m_Localized: Pani jak zwykle cała w skowronkach
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532539
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532540
    m_Localized: 'Sirin: Tak, jasne.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532541
    m_Localized: 'Sirin: Słyszał pan o słońcu? Że wybuchnie?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532542
    m_Localized: 'Sirin: Dowiedziałam się dzisiaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532543
    m_Localized: 'Sirin: Więc to koniec?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532544
    m_Localized: 'Sirin: Nie pozostanie po nas nawet ślad?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532545
    m_Localized: 'Sirin: Ciekawy dylemat.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532546
    m_Localized: 'Sirin: To koniec.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532547
    m_Localized: Co u pani siostry?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532548
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532549
    m_Localized: 'Sirin: Przeraża ją utrata wszystkiego.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532550
    m_Localized: 'Sirin: Mnie się wydaje, że nie mamy nic do stracenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532551
    m_Localized: 'Sirin: Jesteśmy zaledwie drobinkami pyłu w nieskończenie powiększającym się wszechświecie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532552
    m_Localized: 'Sirin: Nikt nas nie potrzebuje. Nie ma nikogo innego.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532553
    m_Localized: 'Sirin: Jeśli nasza planeta przepadnie, nikt po nas nie zapłacze. Nie pozostanie nic ani nikt do opłakiwania.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532554
    m_Localized: 'Sirin: To przejmuje moją siostrę lękiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532555
    m_Localized: 'Sirin: To koniec.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532556
    m_Localized: Czy pani siostra jest chora?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532557
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532558
    m_Localized: 'Sirin: Tak. Chce wyjść szukać męża, by zapomnieć o wszystkich okropnościach, które się dzieją.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532559
    m_Localized: 'Sirin: Mnie się wydaje, że to zły pomysł, ale ona nie może usiedzieć bezczynnie w miejscu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532560
    m_Localized: 'Sirin: Jeśli chce iść go szukać, będę musiała pójść razem z nią.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532561
    m_Localized: 'Sirin: Nie chcę jej stracić, zanim nie nastanie kres.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532562
    m_Localized: 'Sirin: To koniec.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532563
    m_Localized: Czy panie obie wyszły?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532564
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532565
    m_Localized: 'Sirin: Tak. Znalazła zwłoki męża.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532566
    m_Localized: 'Sirin: Mówił jej, że wszystko będzie dobrze, a potem skończył ze sobą jak tchórz. Nie chciał oglądać prawdziwego końca.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532567
    m_Localized: 'Sirin: Chyba opuściły ją już wszystkie siły, by dalej ciągnąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726592
    m_Localized: 'Sirin: Teraz moja kolej się nią opiekować, dopóki nie nastanie nasz koniec.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726593
    m_Localized: 'Sirin: A po tym decydującym momencie nie będzie już żadnych zmartwień, strachu, lęku ani wstydu.'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166080
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166081
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166082
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166083
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166084
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166085
    m_Localized: 'Alkonost: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166086
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166087
    m_Localized: Zostaw ją w spokoju
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166088
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166089
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166090
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166091
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360384
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360385
    m_Localized: 'Sirin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360386
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360387
    m_Localized: Zostaw ją w spokoju
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083328
    m_Localized: 'Firefighter: Kurde… *kaszle*'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083329
    m_Localized: 'Firefighter: Hej, kolego… Jeśli to nie problem… Zadzwonisz do nich? …{0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083330
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083331
    m_Localized: 'Firefighter: Nie proszę, żeby po mnie przyjeżdżali… Ani nie chcę się pożegnać… *kaszle* Powiedz im tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083332
    m_Localized: 'Firefighter: Powiedz, że tatko nie nawiał. Został tylko… tam, gdzie był potrzebny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083333
    m_Localized: 'Firefighter: *kaszle ciężko* Nic więcej nie ma znaczenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083334
    m_Localized: 'Theorist: Ma pan jakieś wieści?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083335
    m_Localized: Co to za papiery?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083336
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083337
    m_Localized: 'Theorist: Nie uwierzyłby pan, co jest w tych dokumentach. Poważnie, niektóre z nich są, kurka wodna, fascynujące.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083338
    m_Localized: 'Theorist: Proszę zerknąć na ten. Ta teoria jest wyjątkowo frapująca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083339
    m_Localized: 'Theorist: Postawiono tu hipotezę, że Przybysze są fikcyjni i stanowią element tajnego, rządowego planu redukcji liczby ludności.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083340
    m_Localized: 'Theorist: Porywająca lektura! I, co dziwne, jeśli się nad tym dobrze zastanowić, ma to jakiś sens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083341
    m_Localized: 'Theorist: Niech pan pomyśli – przeludnienie to znany problem, nieprawdaż? Taka jest istota naszego społeczeństwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083342
    m_Localized: 'Theorist: Można przyjąć, że właśnie w ten sposób rząd chce się tym „zająć”… hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083343
    m_Localized: 'Theorist: Ma pan jakieś wieści?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083344
    m_Localized: Wciąż wertuje pan te papiery?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083345
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083346
    m_Localized: 'Theorist: Rozumie się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083347
    m_Localized: 'Theorist: I mam ich o wiele więcej, jeśli jest pan zainteresowany.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083348
    m_Localized: 'Theorist: Proszę spojrzeć choćby na ten…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083349
    m_Localized: 'Theorist: Tu ktoś twierdzi, że to FEMA są Przybyszami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083350
    m_Localized: 'Theorist: I przez te ich szczelne kombinezony ochronne nie można ich sprawdzić. Wydaje się wiarygodne, nieprawdaż?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083351
    m_Localized: 'Theorist: Intrygujące… Zwłaszcza jeśli wziąć pod uwagę sugerowane tutaj rozwinięcie skrótowca FEMA: Front Eksterminacyjnej Manipulacji Antyludzkiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083352
    m_Localized: 'Theorist: Albo… Może to było coś innego…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083353
    m_Localized: 'Theorist: Ma pan jakieś wieści?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083354
    m_Localized: Co pan odkrył tym razem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083355
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083356
    m_Localized: 'Theorist: Przybysze. Zmiennoskórzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083357
    m_Localized: 'Theorist: Brzmią, jakby byli żywcem wyjęci z noweli fantastycznonaukowej, nieprawdaż?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083358
    m_Localized: 'Theorist: Ale tak właśnie jest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083359
    m_Localized: 'Theorist: Proszę posłuchać. W jednym z raportów jest napisane, że widziano jakiegoś bladego faceta szwendającego się ulicami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083360
    m_Localized: 'Theorist: Chociaż… Trzeba zauważyć, że autor popełnił w nim zasadniczy błąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083361
    m_Localized: 'Theorist: Uważa, że wałęsają się dwie blade, złowieszcze istoty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083362
    m_Localized: 'Theorist: Jedną widzi się przez okna, a druga stoi pod drzwiami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083363
    m_Localized: 'Theorist: Tere‑fere! Czy to nie ewidentne, że to ta sama istota?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083364
    m_Localized: 'Theorist: Miarkuję, że widok przez okno wykrzywił percepcję autora – błąd postrzegania.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083365
    m_Localized: 'Theorist: Mimo tego… arcyciekawe, nieprawdaż?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083366
    m_Localized: 'Theorist: Ma pan jakieś wieści?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083367
    m_Localized: A jeśli to prawda?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083368
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083369
    m_Localized: 'Theorist: Czym w ogóle jest prawda? To płynny koncept zmieniający się zależnie od punktu widzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083370
    m_Localized: 'Theorist: Prawda dla jednego jest urojeniem dla drugiego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083371
    m_Localized: 'Theorist: Co jeden przyjmuje za dobro, inny przyjmie za podłość.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083372
    m_Localized: 'Theorist: Ludzkość od zarania dziejów sprzecza się o wartości. Teraz nasz kompas moralny goni w piętkę bardziej niż kiedykolwiek!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083373
    m_Localized: 'Theorist: Jeśli pana przekonania są tak niezbite jak moje, staną się pana prawdą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083374
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083375
    m_Localized: 'Theorist: Hmm…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083376
    m_Localized: 'Theorist: Intrygujący artykuł… O czym to mówiliśmy? A, tak. O prawdzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083377
    m_Localized: 'Theorist: Warto zapamiętać jedno: jest tylko jedna prawda… Przybysze to… pasożyty mózgu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083378
    m_Localized: 'Theorist: Musi pan włożyć zatyczki do uszu! I NOSIĆ JE BEZ PRZERWY! Nie dawać im najmniejszej szansy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083379
    m_Localized: 'Theorist: W każdym razie, czeka mnie lektura, więc… czy mogę pana prosić? Muszę się skupić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083380
    m_Localized: 'Wifefema: Czego teraz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083381
    m_Localized: Wspominała pani, że pracowała w służbie celnej?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083382
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083383
    m_Localized: 'Wifefema: A żeby pan wiedział, że tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083384
    m_Localized: 'Wifefema: Skoro już o tym mowa, sprawdza pan gości, czy nie są Przybyszami, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083385
    m_Localized: 'Wifefema: Nie chcę tego tłumaczyć jak krowie na rowie, ale… wie pan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083386
    m_Localized: 'Wifefema: Ciekawe co za trep nazwał ich „Przybyszami”?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083387
    m_Localized: 'Wifefema: „Dziwadła” byłoby o wiele lepsze…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083388
    m_Localized: 'Wifefema: Czego teraz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083389
    m_Localized: Dlaczego nienawidzi pani Przybyszy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083390
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083391
    m_Localized: 'Wifefema: Co to ma niby być za pytanie, do cholery?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083392
    m_Localized: 'Wifefema: To przez nich wszystko diabli wzięli! Nie ogląda pan wiadomości?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083393
    m_Localized: 'Wifefema: Słońce ma wybuchnąć. Ludzie giną na ulicach. To wszystko ich wina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083394
    m_Localized: 'Wifefema: Na Boga, zatłukłabym ich wszystkich, gdybym mogła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083395
    m_Localized: 'Wifefema: Potrzebuję tylko czasu. Wywęszę ich, jak to robiłam na granicy. Tylko niech pan patrzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083396
    m_Localized: 'Wifefema: FEMA popełnia poważny błąd, nie przyjmując mnie w ich szeregi…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083397
    m_Localized: 'Wifefema: Czego teraz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083398
    m_Localized: Dlaczego tak bardzo chce pani pracować dla FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083399
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083400
    m_Localized: 'Wifefema: Bo czuję obywatelski obowiązek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083401
    m_Localized: 'Wifefema: Przybyszy można i trzeba powstrzymać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083402
    m_Localized: 'Wifefema: Ja już spełniam swoją powinność. Wczoraj doniosłam na naszego sąsiada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083403
    m_Localized: 'Wifefema: A oni co zrobili? Zatrudnili mojego starego! Daje pan wiarę?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083404
    m_Localized: 'Wifefema: Proszę nie zrozumieć mnie źle, jestem z niego dumna, ale jak tak można…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083405
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083406
    m_Localized: 'Wifefema: Czuję się, jakby mi napluli w twarz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083407
    m_Localized: 'Wifefema: Czego teraz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083408
    m_Localized: Dlaczego pani podkablowała na sąsiada?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083409
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083410
    m_Localized: 'Wifefema: Uszu pan nie myje? Właśnie powiedziałam, że był Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083411
    m_Localized: 'Wifefema: I był jakiś taki podejrzany…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083412
    m_Localized: 'Wifefema: Poczułam ulgę, donosząc na niego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083413
    m_Localized: 'Wifefema: Jak za starych czasów, chroniąc kraj na granicy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083414
    m_Localized: 'Wifefema: Wtedy mnie to naszło… że powinnam służyć w FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083415
    m_Localized: 'Wifefema: Czego teraz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083416
    m_Localized: Nie przyszła pani tutaj po swojego męża. Jest tu pani w sprawie FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083417
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083418
    m_Localized: 'Wifefema: Tak, i co z tego?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083419
    m_Localized: 'Wifefema: Jestem tu, by zrobić taki rozgardiasz, aż ktoś z zarządu to dostrzeże.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083420
    m_Localized: 'Wifefema: Złożę odwołanie od odrzucenia mojej aplikacji.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083421
    m_Localized: 'Wifefema: Dorwałam Przybysza. Spełniłam obywatelski obowiązek, a pracę dostał on? Parszywa niedorzeczność!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083422
    m_Localized: 'Wifefema: Słodki Jezu, to nie ma żadnego pioruńskiego sensu. Kompletna głupota!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083423
    m_Localized: 'Wifefema: Nienawidzę go. Nie cierpię całym swoim jestestwem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083424
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083425
    m_Localized: 'Wifefema: Hej, mam małą prośbę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083426
    m_Localized: 'Wifefema: Zadzwoniłby pan do nich? Trzeba połączyć się z wewnętrzną linią, mają specjalny numer: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083427
    m_Localized: 'Wifefema: Powiedz im pan, że zna idealną kandydatkę: kobietę z doświadczeniem i pazurem. Może pan nawet wspomnieć o moim mężu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083428
    m_Localized: 'Wifefema: Cokolwiek pan powie, niech pan nie szczędzi pochwał. Może wtedy w końcu mnie zatrudnią.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083429
    m_Localized: 'Wifefema: Czego teraz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083430
    m_Localized: W służbie celnej było pewnie lepiej? Miała tam pani jakąś władzę
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083431
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083432
    m_Localized: 'Wifefema: Panie, nie próbuj mi tu ściemniać!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083433
    m_Localized: 'Wifefema: Nie pytałam się o twoją opinię, więc nie myśl sobie, żeś lepszy ode mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083434
    m_Localized: 'Wifefema: Pysznie jest rządzić, nie? Ludzie przychodzą do ciebie, pod twoje drzwi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083435
    m_Localized: 'Wifefema: Możesz decydować, kto jest Przybyszem, a kto nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083436
    m_Localized: 'Wifefema: Ale to nie twoja praca, bo to obowiązek funkcjonariuszy FEMA. Tobie się tylko wydaje, że stanowisz tu prawo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083437
    m_Localized: 'Wifefema: Przynajmniej FEMA ma uprawnienia do podejmowania takich decyzji. Myślisz, że jesteś od nich lepszy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083438
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083439
    m_Localized: 'Wifefema: Tak myślałam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083440
    m_Localized: 'Raskolnikov: Jejku… chciałbym nauczyć się zabijać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083441
    m_Localized: Wciąż chcesz popatrzeć, jak zabijam Przybysza?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083442
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083443
    m_Localized: 'Raskolnikov: Tak właściwie… to nie. J‑jednak nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083444
    m_Localized: 'Raskolnikov: Zląkłem się. W‑wiem. Przepraszam! Ja… jednak nie jestem jeszcze gotowy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083445
    m_Localized: 'Raskolnikov: Na widok zwłok wciąż robi mi się słabo, wiesz… J‑ja… potrzebuję chwili, by się z tego otrząsnąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083446
    m_Localized: 'Raskolnikov: Ale ci, no, Przybysze… Słyszałem, że ich ciała nie przestają się ruszać. Wiesz, po śmierci. Jak ten gość w uliczce…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083447
    m_Localized: 'Raskolnikov: Hrrrk, na samo wspomnienie zbiera mi się na wymioty. Na pewno bym nie podołał. Przepraszam…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083448
    m_Localized: 'Raskolnikov: Jejku… chciałbym nauczyć się zabijać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083449
    m_Localized: Co się stało w uliczce?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083450
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083451
    m_Localized: 'Raskolnikov: Och… Ciężko mi o tym mówić, ale s‑spróbuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083452
    m_Localized: 'Raskolnikov: Myślałem, że w uliczkach jest bezpieczniej, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083453
    m_Localized: 'Raskolnikov: Ale jak wyszedłem zza rogu, to jakbym nagle znalazł się na cmentarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083454
    m_Localized: 'Raskolnikov: Wszędzie… leżały ciała. M‑martwe!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083455
    m_Localized: 'Raskolnikov: Niektóre z nich wciąż wierzgały! Jakby… nie były do końca nieżywe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083456
    m_Localized: 'Raskolnikov: Wtem na końcu uliczki ukazał się facet z bronią, i…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083457
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083458
    m_Localized: 'Raskolnikov: Nie… już dość. N‑nie chcę pamiętać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083459
    m_Localized: 'Raskolnikov: Jejku… chciałbym nauczyć się zabijać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083460
    m_Localized: Powiedz mi więcej o mężczyźnie w uliczce
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083461
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083462
    m_Localized: 'Raskolnikov: On…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083463
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083464
    m_Localized: 'Raskolnikov: Był ubrany w coś jakby pelerynę pokrytą sznurami palców i zębów i…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083465
    m_Localized: 'Raskolnikov: Stało obok niego dziecko. Wyglądało na zupełnie bezradne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083466
    m_Localized: 'Raskolnikov: Facet wycelował w nie i krzyczał.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083467
    m_Localized: 'Raskolnikov: Wrzeszczał, żeby pokazało mu zęby… Biedne dziecię błagało tylko o litość.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083468
    m_Localized: 'Raskolnikov: Chowałem się za śmietnikiem… I, jejku, wyobraziłem się w jego sytuacji…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083469
    m_Localized: 'Raskolnikov: Beczało strasznie, nie mogło się opanować. Skamlało o darowanie życia, wiesz…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083470
    m_Localized: 'Raskolnikov: I nagle… BUM! Padło na ziemię. Padło jak reszta zwłok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083471
    m_Localized: 'Raskolnikov: Wtedy zdałem sobie sprawę… że zostały tylko dwa typy ludzi na świecie: drapieżniki i zwierzyna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083472
    m_Localized: 'Raskolnikov: Jejku… chciałbym nauczyć się zabijać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083473
    m_Localized: Przetrwanie nie zależy od stania się bezlitosnym mordercą
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083474
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083475
    m_Localized: 'Raskolnikov: S‑stuknięty jesteś? Oczywiście, że zależy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083476
    m_Localized: 'Raskolnikov: Żyjesz, bo obnażyłeś kły niczym drapieżnik! T‑to dlatego nikt ci nie podskakuje!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083477
    m_Localized: 'Raskolnikov: Dopóki ludzie się ciebie boją, nic ci nie grozi, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083478
    m_Localized: 'Raskolnikov: Nie chcę być zwierzyną ani umrzeć, skomląc jak jakiś tchórz. J‑ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277632
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277633
    m_Localized: 'Raskolnikov: Dlatego muszę nauczyć się zabijać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277634
    m_Localized: 'Nun: Ojcze nasz, któryś jest w niebie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277635
    m_Localized: Jak się pani podoba dom?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277636
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277637
    m_Localized: 'Nun: Jest lichy, moje dziecko.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277638
    m_Localized: 'Nun: Krzywe ściany, układ pozbawiony sensu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277639
    m_Localized: 'Nun: Niech mi pan powie, czy celowo przydzielił mi pan najnędzniejszy pokoik w tej sadybie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277640
    m_Localized: 'Nun: Meble sfatygowane i zmurszałe… Pewnie je nadgryzły mole, które też tam mieszkają.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277641
    m_Localized: 'Nun: Nawet krzyża nie mógł pan w lepszym pokoju powiesić, żeby było po bożemu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277642
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277643
    m_Localized: 'Nun: Boże, dlaczego wystawiasz mnie na próbę…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277644
    m_Localized: 'Nun: Ojcze nasz, któryś jest w niebie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277645
    m_Localized: Dlaczego pani sobie nie pójdzie, skoro tu się pani nie podoba?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277646
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277647
    m_Localized: 'Nun: Myśli pan, że celowo postawiłam stopę w tej przeklętej chałupie? Gdyby klasztor jeszcze stał, nie byłoby mnie tu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277648
    m_Localized: 'Nun: Nie dbam o pana przegniły stos gruzu i badziewia!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277649
    m_Localized: 'Nun: Gdybym mogła wybrać, nigdy bym nie wstąpiła w te progi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277650
    m_Localized: 'Nun: Trąci tu mordem i śmiercią. Bóg jeden wie, czy z pana nie jakiś koneser!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277651
    m_Localized: 'Nun: Zgniatasz pan sprawiedliwie w pył każdego, kto nosi znamiona diabła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277652
    m_Localized: 'Nun: A sam może nim pan być! Rogi i cała reszta tylko czekają, żeby urosnąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277653
    m_Localized: 'Nun: Zniosę te przewinienia. Ojciec Niebieski czuwa nad swoją trzodą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277654
    m_Localized: 'Nun: Ojcze nasz, któryś jest w niebie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277655
    m_Localized: Dlaczego nie została pani w swoim klasztorze?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277656
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277657
    m_Localized: 'Nun: Po pierwsze klasztor nie należy do mnie. Jest świątynią Pana Najwyższego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277658
    m_Localized: 'Nun: Po drugie to wszystko sprawka tych nikczemnych bluźnierców.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277659
    m_Localized: 'Nun: Zbezcześcili Jego świętą ziemię. Niechaj deszcz ogni niebieskich pokryje tych grzeszników!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277660
    m_Localized: 'Nun: Zjawili się nieproszeni, przepędzili siostry i mnie razem z nimi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277661
    m_Localized: 'Nun: Położyli łapska na wszystkim, czego chcieli, jakby do nich należało. Dzikusy, świętokradcy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277662
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277663
    m_Localized: 'Nun: Nasze życia były ułożone i święte. Niosłyśmy modły wedle Jego przykazania. Pościłyśmy wedle Jego instrukcji. A te bestie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277664
    m_Localized: 'Nun: Spijają pewnie wodę święconą jak jakiegoś jabola. Hańba!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277665
    m_Localized: 'Nun: Niechaj się nią udławią, amen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277666
    m_Localized: 'Nun: Ojcze nasz, któryś jest w niebie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277667
    m_Localized: Czego chcieli ci „bluźniercy”?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277668
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277669
    m_Localized: 'Nun: Napadli na nas całą brudną i rozwrzeszczaną bandą. Wyli i klęli jak bezbożne dzikusy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277670
    m_Localized: 'Nun: I dlaczego? Bo nie chciałam ich wpuścić! Słusznie im rzekłam: bez świadectwa chrztu żadna noga nie przestąpi tego progu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277671
    m_Localized: 'Nun: Dobry Boże, ale wpadli w szał. Och… walili w drzwi i grozili, że wyważą razem z zawiasami!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277672
    m_Localized: 'Nun: Gdy wdarli się do środka, wyrzucili mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277673
    m_Localized: Więc odmówiła pani pomocy potrzebującym?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277674
    m_Localized: Pewnie też bym panią wyrzucił
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277675
    m_Localized: 'Nun: Święte miejsce nie jest ostoją dla ludzi odrzucających Boże światło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277676
    m_Localized: 'Nun: Czy szukali schronienia przed słońcem, czy azylu przed Przybyszami, nie ma to znaczenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277677
    m_Localized: 'Nun: Nawet gdyby z niebios lał się ogień, dom Pański to nie przytułek dla takiego ohydztwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277678
    m_Localized: 'Nun: Bóg jest łaskawy tylko dla wierzących.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277679
    m_Localized: 'Nun: I jeśli znaleźli się na ulicy, takaż wola Pańska, żeby spłonęli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277680
    m_Localized: Jest pani wstrętna, ale to nie mnie panią osądzać
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277681
    m_Localized: Proszę wyjść, zanim ja także wyślę panią do diabła
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277682
    m_Localized: 'Nun: Ty bezczelny łajdaku!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277683
    m_Localized: 'Nun: Postradał pan rozum?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277684
    m_Localized: 'Nun: Jestem służebną Pana Wszechmogącego! Wypędzoną z Jego domu przez bezbożne robactwo. A ty…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277685
    m_Localized: 'Nun: Ma pan czelność wyśmiewać się ze mnie? Twierdzić, że zasługuję na swój los?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277686
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277687
    m_Localized: 'Nun: Żaden z pana człowiek. Prędzej nikczemny wąż!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277688
    m_Localized: 'Nun: BLUŹNIERCA! KOLEJNY BLUŹNIERCA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277689
    m_Localized: 'Nun: Miałam nadzieję, że pan zrozumie, ale widzę żeś pan nie lepszy od reszty hołoty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277690
    m_Localized: 'Nun: Jesteśmy sługami! SŁUGAMI PANA NAJWYŻSZEGO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277691
    m_Localized: 'Nun: Nic nam robić innego, jak przyjmować Jego wolę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277692
    m_Localized: 'Nun: Niezbadane są wyroki boskie. Nie do wyśledzenia drogi Jego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277693
    m_Localized: Jest pani wstrętna, ale to nie mnie panią osądzać
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277694
    m_Localized: Proszę wyjść, zanim ja także wyślę panią do diabła
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277695
    m_Localized: 'Nun: Och, więc teraz to pan jest zbawicielem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277696
    m_Localized: 'Nun: Zatrzymaj sobie tę nieczystą sadybę. Nie zostanę ani chwili dłużej w tej norze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277697
    m_Localized: 'Nun: Żegnam, moje dziecko. Niech cię spotka kara boska!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277698
    m_Localized: 'Nun: Nie miałam zamiaru się tu zatrzymywać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277699
    m_Localized: 'Nun: Aż poczułam w kościach, przekraczając próg, że w tym domu nie ma Boga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277700
    m_Localized: 'Nun: Może i przemawia do mnie właśnie w tej chwili, namawiając do wyjścia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277701
    m_Localized: 'Nun: Żegnam, moje dziecko. Niech cię spotka kara boska!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277702
    m_Localized: 'Fugitive: Ta cholerna rana…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277703
    m_Localized: Dlaczego FEMA cię ścigała?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277704
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277705
    m_Localized: 'Fugitive: Nie wiem na pewno, ale coś podejrzewam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277706
    m_Localized: 'Fugitive: Myślałem, że to był tylko rutynowy patrol.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277707
    m_Localized: 'Fugitive: Idę jednak o zakład, że to ta szmata drzwi dalej mnie podkablowała.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277708
    m_Localized: 'Fugitive: Jebitnie sobie z nią skakaliśmy do gardeł. Pewnie skorzystała z okazji i doniosła, że jestem kolejnym „Przybyszem”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277709
    m_Localized: 'Fugitive: Pewnie jest z siebie cała zadowolona, pieprzona ździra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277710
    m_Localized: 'Fugitive: Ta cholerna rana…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277711
    m_Localized: Jak się czujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277712
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277713
    m_Localized: 'Fugitive: Nie jest źle, już mi trochę lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277714
    m_Localized: 'Fugitive: Mówiłem, kula przeszła na wylot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277715
    m_Localized: 'Fugitive: Ludzie nie powinni się tak traktować. I że też musiałem trafić na psychola, którego aż świerzbiło, żeby sobie postrzelać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277716
    m_Localized: 'Fugitive: Wkrótce wszyscy będziemy wąchać kwiatki od spodu, bo pewne jak cholera, że nie pozwolimy sobie robić tego od góry.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277717
    m_Localized: 'Fugitive: Diabli by to wzięli. Lepiej żyć i pozwolić umrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277718
    m_Localized: 'Fugitive: Powinieneś widzieć tego strzelca‑popaprańca. Przerażający drań.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277719
    m_Localized: Popapraniec? Mówiłeś, że to ktoś z FEMA cię postrzelił
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277720
    m_Localized: O jakim popaprańcu mówisz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277721
    m_Localized: 'Fugitive: R‑racja, tak, to jeden z tych gestapowców z FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277722
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277723
    m_Localized: Powiedz mi prawdę
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277724
    m_Localized: Wystarczy. Kiepski z ciebie kłamca
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277725
    m_Localized: 'Fugitive: Znaczy się… mówiłem o jakimś gestapowcu z FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277726
    m_Localized: 'Fugitive: Był wtedy przerażający… gdy staliśmy twarzą w twarz…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277727
    m_Localized: 'Fugitive: To znaczy… eee… kiedy strzelił mi w plecy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277728
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277729
    m_Localized: Powiedz mi prawdę
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277730
    m_Localized: Wystarczy. Kiepski z ciebie kłamca
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277731
    m_Localized: 'Fugitive: Okej, okej…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277732
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277733
    m_Localized: 'Fugitive: Nie kłamałem o ucieczce ze strefy kwarantanny… ale nie było żadnej strzelaniny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277734
    m_Localized: 'Fugitive: Pomógł mi lekarz. Sfałszował dla mnie papiery i pomógł się stamtąd wydostać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277735
    m_Localized: 'Fugitive: Ale nie mogłem przecież wrócić do domu. Ta przeklęta sąsiadka zaraz by znowu na mnie doniosła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277736
    m_Localized: 'Fugitive: Szukałem więc jakieś kryjówki, z której mógłbym nie wychylać nosa. Wtedy wpadłem na tego szaleńca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277737
    m_Localized: 'Fugitive: Chciałem się go tylko zapytać, czy nie zna jakiejś miejscówki na noc, a potem…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277738
    m_Localized: 'Fugitive: Zobaczyłem… broń na plecach, naszyjnik z palców i zębów oraz uliczkę usłaną trupami za jego plecami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277739
    m_Localized: 'Fugitive: Tak… wtedy kapnąłem się, że to jakiś świr. Hngg…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277740
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277741
    m_Localized: 'Fugitive: Słuchaj, rana od kuli znów zaczyna mi doskwierać. Czy mogę się na chwilę położyć?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277742
    m_Localized: 'Fugitive: Cholera…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277743
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277744
    m_Localized: 'Fugitive: Słuchaj, wszystko ci wyjaśnię.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277745
    m_Localized: 'Fugitive: Nie kłamałem o ucieczce ze strefy kwarantanny… ale nie było żadnej strzelaniny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277746
    m_Localized: 'Fugitive: Pomógł mi lekarz. Sfałszował dla mnie papiery i pomógł się stamtąd wydostać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277747
    m_Localized: 'Fugitive: Ale nie mogłem przecież wrócić do domu. Ta przeklęta sąsiadka zaraz by znowu na mnie doniosła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277748
    m_Localized: 'Fugitive: Szukałem więc jakieś kryjówki, z której mógłbym nie wychylać nosa. Wtedy wpadłem na tego szaleńca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277749
    m_Localized: 'Fugitive: Chciałem się go tylko zapytać, czy nie zna jakiejś miejscówki na noc, a potem…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277750
    m_Localized: 'Fugitive: Zobaczyłem… karabinek na plecach, naszyjnik z palców i zębów oraz uliczkę usłaną trupami za jego plecami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277751
    m_Localized: 'Fugitive: Tak… wtedy kapnąłem się, że to jakiś świr. Hngg…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277752
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277753
    m_Localized: 'Fugitive: Słuchaj, rana znów zaczyna mi doskwierać. Czy mogę się na chwilę położyć?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277754
    m_Localized: 'Fugitive: Ta cholerna rana…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277755
    m_Localized: Opowiedz mi o świrze z karabinkiem
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277756
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277757
    m_Localized: 'Fugitive: Jasne, szurnięty psychol obwieszony zębami i palcami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277758
    m_Localized: 'Fugitive: Pewnie wyczytał niepewność z mojej twarzy i wyciągnął giwerę, ale ją złapałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277759
    m_Localized: 'Fugitive: Szarpaliśmy się chwilę, walcząc o broń.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277760
    m_Localized: 'Fugitive: Potem wystrzelił, a ja mu jebnąłem z główki tak, że padł nieprzytomny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277761
    m_Localized: 'Fugitive: Potem uciekłem najdalej, jak mogłem. Wtedy poczułem ból w brzuchu. Hngg…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277762
    m_Localized: 'Fugitive: Spojrzałem tam i cały byłem zalany krwią.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277763
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277764
    m_Localized: 'Fugitive: Nie chciałem się przyznać, że mnie postrzelił, bo pomyślałem, że byś mnie nie wpuścił.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277765
    m_Localized: 'Fugitive: Teraz każdy dba tylko o siebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277766
    m_Localized: 'Fugitive: Powiedz szczerze, czy pozwoliłbyś mi zostać, wiedząc, że ściga mnie jakiś psychopata z bronią?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277767
    m_Localized: 'Fugitive: Potrzebowałem schronienia. Nie chciałem zginąć jak reszta tych nieszczęsnych biedaków w uliczce.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277768
    m_Localized: 'Fugitive: Więc, kurwa, tak, okłamałem cię. Mam nadzieję, że nie masz mi tego za złe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277769
    m_Localized: Dobra, możesz zostać
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277770
    m_Localized: Nie mogę ci zaufać, odejdź
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277771
    m_Localized: 'Fugitive: Dzięki. To wiele dla mnie znaczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277772
    m_Localized: 'Fugitive: Dobrze, że masz swoją giwerę. Lepiej jednak, żeby ten popapraniec się tu nie zjawił.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277773
    m_Localized: 'Fugitive: Oby ktoś inny go udupił. Psiakrew, może ten blady Przybysz go dorwał?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277774
    m_Localized: 'Fugitive: Cóż… chyba miałem rację.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277775
    m_Localized: 'Fugitive: Teraz rozumiesz, dlaczego skłamałem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277776
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277777
    m_Localized: 'Fugitive: Miłego dnia, kutafonie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277778
    m_Localized: 'Bestson: Och, nie… Gdzie się oni podziali…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277779
    m_Localized: Jak leci?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277780
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277781
    m_Localized: 'Bestson: Nie wiem… chcę tylko, żeby moi rodzice wrócili.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277782
    m_Localized: 'Bestson: Całe życie się mną opiekowali, a teraz… nie wiem, co im się stało.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277783
    m_Localized: 'Bestson: Ojej, oby im nic nie było. Nie mógłbym bez nich żyć…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277784
    m_Localized: 'Bestson: Och, nie… Gdzie się oni podziali…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277785
    m_Localized: Czy masz jakichś innych krewnych?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277786
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277787
    m_Localized: 'Bestson: Nie bardzo. Och, chociaż…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277788
    m_Localized: 'Bestson: Ostatnio się dowiedziałem, że mam starszą siostrę? Z pierwszego małżeństwa taty, ale wciąż…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277789
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277790
    m_Localized: 'Bestson: Och, cholewka, babcia!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277791
    m_Localized: 'Bestson: Chyba wiem, dokąd pojechali moi rodzice…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277792
    m_Localized: 'Bestson: A co jeśli babcia była Przybyszem i ich zabiła? A‑albo FEMA ich zabrała?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277793
    m_Localized: 'Bestson: Dlaczego? Dlaczego nie zostali? Dlaczego ich zabrali…? DLACZEGO?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277794
    m_Localized: 'Bestson: SAM NIE DAM RADY PRZEŻYĆ! DLACZEGO MNIE ZOSTAWILI?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277795
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277796
    m_Localized: 'Bestson: Och, nie… Gdzie się oni podziali…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277797
    m_Localized: Uspokoiłeś się już na tyle, żeby opowiedzieć mi o siostrze?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277798
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277799
    m_Localized: 'Bestson: Wiesz…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277800
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277801
    m_Localized: 'Bestson: Na krótko przed odejściem przyszedł list.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277802
    m_Localized: 'Bestson: Tata mi go przyniósł, bo nigdy nie sprawdzam poczty. Miałem go przeczytać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277803
    m_Localized: 'Bestson: Był od „siostry”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277804
    m_Localized: 'Bestson: Pisała, że chce mnie poznać, ale nie wiedziałem, co mam o tym myśleć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277805
    m_Localized: 'Bestson: Myślałem, że to jakiś kawał, ale list dał mi tata, więc chyba nie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277806
    m_Localized: 'Bestson: Powiedział mi, że nie byłem jego pierwszym dzieckiem, że przez ten cały czas miałem siostrę…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277807
    m_Localized: 'Bestson: Nie całkiem prawdziwą siostrę, tylko przyrodnią. Mamy wspólnego tatę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277808
    m_Localized: 'Bestson: Nie wiem… dziwnie mi z tym było. Nie wiedziałem, co począć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277809
    m_Localized: 'Bestson: Miała niby być moją „siostrą”, ale zupełnie jej nie znam. To takie dziwne…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277810
    m_Localized: 'Bestson: Chciałbym… ją poznać, ale tak się boję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277811
    m_Localized: 'Bestson: Zadzwoniłbyś do niej za mnie? Jej numer to {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277812
    m_Localized: 'Bestson: Powiedz jej tylko… że istnieję i nie wiem, co mam robić…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277813
    m_Localized: 'Bestson: Och, nie… Gdzie się oni podziali…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277814
    m_Localized: Dlaczego nie chcesz odwiedzić siostry?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277815
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277816
    m_Localized: 'Bestson: Nawet jej nie znam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277817
    m_Localized: 'Bestson: Kiedy rodzice powiedzieli mi o tym, poczułem się, jakby od zawsze mnie okłamywali.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277818
    m_Localized: 'Bestson: Tak się zdenerwowałem, że pobiegłem do swojego pokoju. Chciałem, żeby zostawili mnie samego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277819
    m_Localized: 'Bestson: Następnego dnia jednak…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277820
    m_Localized: 'Bestson: Wydarzyło się to wszystko, o czym mówiłem. Relacje w telewizji, panika, i…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277821
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277822
    m_Localized: 'Bestson: Naprawdę mnie zostawili.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277823
    m_Localized: 'Bestson: Jezu, przyrzekam, że oddałbym wszystko, aby móc jeszcze raz zobaczyć rodziców.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277824
    m_Localized: 'Bestson: Dlaczego… dlaczego…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277825
    m_Localized: Idź do siostry. Na pewno cię przyjmie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277826
    m_Localized: Jesteś pewny, że rodzice nie żyją?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277827
    m_Localized: 'Bestson: Naprawdę? Tak myślisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277828
    m_Localized: 'Bestson: Ale ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277829
    m_Localized: 'Bestson: Nigdy nie oddalałem się tak daleko od domu bez rodziców.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277830
    m_Localized: 'Bestson: Ona mieszka daleko stąd, a ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277831
    m_Localized: 'Bestson: A ja się boję. Chyba nie mam odwagi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277832
    m_Localized: To wezwij taksówkę, wciąż jeżdżą
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277833
    m_Localized: Musisz coś zrobić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277834
    m_Localized: 'Bestson: Ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277835
    m_Localized: 'Bestson: Nie wrócili po mnie, więc…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277836
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277837
    m_Localized: 'Bestson: Nie wiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277838
    m_Localized: Spróbuj znaleźć babcię
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277839
    m_Localized: Sprawdź strefy kwarantanny
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277840
    m_Localized: 'Bestson: Hej, to… całkiem niezły pomysł. Tak jakby…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277841
    m_Localized: 'Bestson: Aczkolwiek słyszałem, że taksówkarze teraz strasznie zdzierają.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277842
    m_Localized: 'Bestson: Ale mam ze sobą wszystkie zaskórniaki rodziców. Może wystarczą na przejazd do siostry?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277843
    m_Localized: 'Bestson: Dziękuję za przemówienie mi do rozsądku. Do zobaczenia. Może.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277844
    m_Localized: 'Bestson: Może masz rację.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277845
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277846
    m_Localized: 'Bestson: Chyba naprawdę za długo polegałem na rodzicach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277847
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277848
    m_Localized: 'Bestson: Dziękuję za przemówienie mi do rozsądku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277849
    m_Localized: 'Bestson: Spróbuję znaleźć jakąś taksówkę. Mam ze sobą wszystkie zaskórniaki rodziców, więc może starczą na przejazd.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277850
    m_Localized: 'Bestson: Okej, komu w drogę… Do zobaczenia. Może.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277851
    m_Localized: 'Bestson: Pewnie masz rację…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277852
    m_Localized: 'Bestson: A co jeśli zepsuł im się samochód?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277853
    m_Localized: 'Bestson: Tak, to pewnie to. Tata wspominał, że musi go oddać do naprawy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277854
    m_Localized: 'Bestson: A babcia nie chce mieć telefonu. Może dlatego nie ma z nimi kontaktu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277855
    m_Localized: 'Bestson: Wiesz… może faktycznie ich tam zastanę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277856
    m_Localized: 'Bestson: Dziękuję za przemówienie mi do rozsądku. Muszę iść.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277857
    m_Localized: 'Bestson: Ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277858
    m_Localized: 'Bestson: Może naprawdę tam są.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277859
    m_Localized: 'Bestson: Muszę chociaż spróbować.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277860
    m_Localized: 'Bestson: Dziękuję za przemówienie mi do rozsądku. Muszę iść.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277861
    m_Localized: 'Buddy: Hej, koleżko. Co u ciebie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277862
    m_Localized: Jak leci?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277863
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277864
    m_Localized: 'Buddy: Wszystko dobrze, koleżko!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277865
    m_Localized: 'Buddy: Tak przy okazji, zajrzałem ci do lodówki. Kurczę, gdybym wiedział, że masz tyle piwa…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277866
    m_Localized: 'Buddy: Jak je zdobyłeś? Masz wujka w browarze czy coś?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277867
    m_Localized: 'Buddy: Ech, nieważne. Nie chcę wiedzieć!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277868
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277869
    m_Localized: 'Buddy: Ale bajzel, co? W innej sytuacji byśmy popijali zimne piwko i oglądali mecz. Poznałbyś nawet…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277870
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277871
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277872
    m_Localized: Hej, wszystko gra?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277873
    m_Localized: Czemu zaniemówiłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277874
    m_Localized: 'Buddy: Hm? Słucham?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277875
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277876
    m_Localized: 'Buddy: Zapomnij. To nic takiego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277877
    m_Localized: 'Buddy: Nie, ja tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277878
    m_Localized: 'Buddy: Hmm…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277879
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277880
    m_Localized: 'Buddy: Zamyśliłem się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277881
    m_Localized: 'Buddy: Hej, koleżko. Co u ciebie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277882
    m_Localized: Wyglądasz dziś na smutnego
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277883
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277884
    m_Localized: 'Buddy: Ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277885
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277886
    m_Localized: 'Buddy: Nie chcę o tym mówić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277887
    m_Localized: O czym?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277888
    m_Localized: Co ty mówisz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277889
    m_Localized: 'Buddy: Bez znaczenia. Nie zrozumiałbyś.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277890
    m_Localized: Wydaje mi się, że powinienem wiedzieć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277891
    m_Localized: Dobra, nie naciskam
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277892
    m_Localized: 'Buddy: Słuchaj, naprawdę nie chcę o tym mówić, okej?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277893
    m_Localized: Wydaje mi się, że powinienem wiedzieć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277894
    m_Localized: Dobra, nie naciskam
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471936
    m_Localized: 'Buddy: Powiedziałem, żebyś nie drążył! I bez tego ledwo trzymam się kupy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471937
    m_Localized: 'Buddy: Zostaw mnie w spokoju…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471938
    m_Localized: 'Buddy: Dzięki, koleżko. Po prostu nie czuję się najlepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471939
    m_Localized: 'Buddy: Hej, koleżko. Co u ciebie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471940
    m_Localized: Co ci jest?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471941
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471942
    m_Localized: 'Buddy: Nie twój interes, koleżko. Odwal się!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471943
    m_Localized: Powiedz mi, o co chodzi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471944
    m_Localized: Chcę, byś ze mną porozmawiał. Inaczej będzie gorzej
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471945
    m_Localized: 'Buddy: Nie mogę… zmienisz o mnie zdanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471946
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471947
    m_Localized: 'Buddy: Ale duszenie tego w sobie też mi nie pomaga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471948
    m_Localized: 'Buddy: Miałem psa. Ona… opuściła ten świat… kilka dni temu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471949
    m_Localized: To tyle?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471950
    m_Localized: I co dalej?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471951
    m_Localized: 'Buddy: Czemu? Chcesz wziąć mnie za stodołę, koleżko?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471952
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471953
    m_Localized: 'Buddy: Dobra. Chcesz poznać prawdę?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471954
    m_Localized: 'Buddy: Miałem psa. Ona… opuściła ten świat… kilka dni temu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471955
    m_Localized: To tyle?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471956
    m_Localized: I co dalej?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471957
    m_Localized: 'Buddy: To nie wszystko. Była już stara i chora… ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471958
    m_Localized: 'Buddy: To nie tak, że ona…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471959
    m_Localized: 'Buddy: Ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471960
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471961
    m_Localized: 'Buddy: Zabiłem ją.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471962
    m_Localized: Co zrobiłeś?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471963
    m_Localized: Na łeb ci padło!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471964
    m_Localized: 'Buddy: Ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471965
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471966
    m_Localized: 'Buddy: Zabiłem ją.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471967
    m_Localized: Co zrobiłeś?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471968
    m_Localized: Na łeb ci padło!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471969
    m_Localized: 'Buddy: Wiem, jak to brzmi, ale pozwól mi wyjaśnić. Ona… cierpiała. Było mi jej żal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471970
    m_Localized: 'Buddy: Dzień za dniem jej oczy były pełne udręki. Słyszałem, jak popiskuje w nocy z bólu w nogach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471971
    m_Localized: 'Buddy: WSZYSTKO PRZEZ TEGO JEBANEGO KIEROWCĘ! Gdyby ten taksiarz nie prowadził jak idiota, może wciąż by z nami była.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471972
    m_Localized: 'Buddy: Oddałbym wszystko, by ukręcić mu ten jego jebany kark, ale odjechał. Nie zdążyłem zobaczyć tablic…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471973
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471974
    m_Localized: 'Buddy: Nie wiesz, jak to jest, stracić zwierzę. Są z nami tylko przez chwilę, ale uczą więcej niż ktokolwiek inny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471975
    m_Localized: 'Buddy: Wiesz, jak mówią: „Dla nas są zaledwie fragmentem życia. My dla nich jesteśmy całym ich światem”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471976
    m_Localized: Dobra, możesz zostać
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471977
    m_Localized: Powinieneś sobie pójść
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471978
    m_Localized: 'Buddy: Tak, wiem… kawał ze mnie gnoja. Wciąż nie mogę sobie wybaczyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471979
    m_Localized: 'Buddy: Ona… cierpiała. Było mi jej żal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471980
    m_Localized: 'Buddy: Z każdym dniem było coraz gorzej. Noce były najcięższe… gdy popiskiwała i skomlała. Tyle łez…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471981
    m_Localized: 'Buddy: Widziałeś kiedyś, żeby pies płakał? Oczami błagała mnie, bym ukrócił jej cierpienia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471982
    m_Localized: 'Buddy: Nie chciałem tego zrobić! Przysięgam! Nigdy bym nie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471983
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471984
    m_Localized: 'Buddy: PIERDOLONY TAKSIARZ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471985
    m_Localized: 'Buddy: Potrącił mi ukochanego psa. I zaraz odjechał, jakby nigdy nic!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471986
    m_Localized: 'Buddy: Jakby przejechał przez koleinę, a nie przez żyjącą istotę!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471987
    m_Localized: 'Buddy: Szlag, oddałbym wszystko, by ukręcić mu kark, ale odjechał. Nie zdążyłem spisać tablic…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471988
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471989
    m_Localized: 'Buddy: Nie wiesz, jak to jest, stracić zwierzę. Są z nami tylko przez chwilę, ale uczą więcej niż ktokolwiek inny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471990
    m_Localized: 'Buddy: Wiesz, jak mówią: „Dla nas są zaledwie fragmentem życia. My dla nich jesteśmy całym ich światem”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471991
    m_Localized: Dobra, możesz zostać
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471992
    m_Localized: Powinieneś sobie pójść
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471993
    m_Localized: 'Buddy: Dzięki, koleżko.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471994
    m_Localized: 'Buddy: Cieszę się, że rozumiesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471995
    m_Localized: 'Buddy: Masz rację, koleżko. Może tak będzie lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471996
    m_Localized: 'Buddy: Myślę o tym nieustannie… Czy dobrze zrobiłem, skracając jej cierpienia?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471997
    m_Localized: 'Buddy: Pewnie nigdy się nie dowiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471998
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471999
    m_Localized: 'Fatman: Ach… zimna woda. Tego mi było trzeba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472000
    m_Localized: Czujesz się lepiej?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472001
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472002
    m_Localized: 'Fatman: Tak, tak, tak. Znacznie lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472003
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472004
    m_Localized: 'Fatman: Chociaż…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472005
    m_Localized: 'Fatman: Coś mnie trochę, ekhm, suszy. Masz coś, czym mógłbym przepłukać gardło?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472006
    m_Localized: W porządku (daj mu puszkę piwa)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472007
    m_Localized: 'Fatman: Nie masz piwa? Na pewno jakieś masz…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472008
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472009
    m_Localized: 'Fatman: W lodówce miałeś pełno, widziałem! Sam wszystko wypiłeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472010
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472011
    m_Localized: 'Fatman: Genialnie! Nie ma nic lepszego niż zimne piwko!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472012
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472013
    m_Localized: 'Fatman: Haaa… Moje ulubione…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472014
    m_Localized: 'Fatman: Masz, na waciki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472015
    m_Localized: 'Fatman: (Wręcza ci garść pogniecionych banknotów, bezwartościowych w tych czasach).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472016
    m_Localized: O rety… dzięki
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472017
    m_Localized: Gówno mnie obchodzą twoje pieniądze
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472018
    m_Localized: 'Fatman: I o to chodzi! Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472019
    m_Localized: 'Fatman: Ty zrobisz coś dla mnie, a ja, ekhm, zrobię coś dla ciebie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472020
    m_Localized: 'Fatman: Mam tego o wiele więcej… tylko dla przyjaciół, ma się wiedzieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472021
    m_Localized: 'Fatman: Och, i jeszcze… to.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472022
    m_Localized: 'Fatman: (Otrzymujesz słoik kombuchy).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472023
    m_Localized: 'Fatman: Żaden szanujący się człowiek nie pije tych pomyj, ale komuś takiemu jak, ekhm, ty, być może się przyda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472024
    m_Localized: 'Fatman: Phi! Jak opryskliwie! Myślisz, że jesteś ponad systemem, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472025
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472026
    m_Localized: 'Fatman: Wszyscy potrzebują pieniędzy! Cały świat się wokół nich kręci, powiadam ci!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472027
    m_Localized: 'Fatman: Dobrze, weź wtedy to!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472028
    m_Localized: 'Fatman: (Otrzymujesz słoik kombuchy).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472029
    m_Localized: 'Fatman: Żaden szanujący się człowiek nie pije tych pomyj, ale komuś takiemu jak, ekhm, ty, być może się przyda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472030
    m_Localized: 'Fatman: Co rozumiesz przez „nie”? Phi! Myślisz, że nie można cię kupić? Wszystko można kupić! Miłość, rzeczy, ludzi…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472031
    m_Localized: 'Fatman: Pieniądz kręci światem, chłopcze! A ja? Cóż, jestem ministrem! Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472032
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472033
    m_Localized: 'Fatman: Dobrze! Niech będzie po twojemu! Miarkuj tylko moje słowa: nosił wilk razy kilka, ponieśli i wilka!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472034
    m_Localized: 'Fatman: Ach… zimna woda. Tego mi było trzeba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472035
    m_Localized: Czego teraz potrzebujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472036
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472037
    m_Localized: 'Fatman: Oho, wspaniale, że pytasz! Zapaliłbym. Podaj mi papierosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472038
    m_Localized: W porządku… (podaj papierosy)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472039
    m_Localized: 'Fatman: Co, nie masz papierosów?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472040
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472041
    m_Localized: 'Fatman: Dobrze! Pomęczę się wtedy trochę, czyż nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472042
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472043
    m_Localized: 'Fatman: No i o to chodziło!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472044
    m_Localized: 'Fatman: Oczywiście wolałbym cygaro, ale konia z rzędem temu, kto je teraz zdobędzie. Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472045
    m_Localized: 'Fatman: Za moich czasów w rządzie wszystko było, ekhm, inaczej. Teraz tylko mord i chaos. Kompletny koszmar…!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472046
    m_Localized: 'Fatman: Kiedy FEMA ogarnie w końcu ten bajzel, hm? Nie powołano ich po to, żeby stali i ładnie wyglądali!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472047
    m_Localized: 'Fatman: Phi! Takie partactwo nie miało miejsca, kiedy ja byłem w administracji, powiadam tobie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472048
    m_Localized: 'Fatman: Może potrzebują więcej czasu. Tak, tak, tak… Wszystko w końcu się ułoży.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472049
    m_Localized: Byłeś w administracji?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472050
    m_Localized: Czy pomagałeś powołać FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472051
    m_Localized: 'Fatman: Tak, przecież właśnie to powiedziałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472052
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472053
    m_Localized: 'Fatman: Och, tak… Tu twoja, ekhm, zachęta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472054
    m_Localized: 'Fatman: (Otrzymujesz garść pomiętych, bezwartościowych banknotów i dziwną pocztówkę z pieczęcią FEMA).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472055
    m_Localized: 'Fatman: A skąd taki pomysł?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472056
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472057
    m_Localized: 'Fatman: Och, tak… Tu twoja, ekhm, zachęta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472058
    m_Localized: 'Fatman: (Otrzymujesz garść pomiętych, bezwartościowych banknotów i dziwną pocztówkę z pieczęcią FEMA).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472059
    m_Localized: 'Fatman: Co to znaczy „nie”?! Czy ty wiesz, kim jestem!?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472060
    m_Localized: 'Fatman: Byłem ministrem! Ministrem, powiadam tobie! Rząd to skomplikowana maszyna, która potrzebuje mnie u sterów!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472061
    m_Localized: 'Fatman: Jestem głosem ludu! Beze mnie malutcy ludzie, tacy jak ty, nie byliby usłyszani. Nie, nie! Ja podnoszę komfort życia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472062
    m_Localized: 'Fatman: Gdyby sytuacja była normalna, nie odważyłbyś mi się pyskować, chłopcze! W mig by cię zabrali!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472063
    m_Localized: 'Fatman: Phi! Nikogo już nie obchodzi status ministra. Myślisz, że w urzędzie tylko pierdzimy w stołki, co…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472064
    m_Localized: 'Fatman: Zobaczymy, kto się będzie śmiał, gdy wszystko pierdyknie i przypełzniecie z do nas powrotem, nie? Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472065
    m_Localized: 'Fatman: Ach… zimna woda. Tego mi było trzeba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472066
    m_Localized: Znowu czegoś potrzebujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472067
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472068
    m_Localized: 'Fatman: Bystry jesteś, chłopcze!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472069
    m_Localized: 'Fatman: Chcę…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472070
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472071
    m_Localized: 'Fatman: Tak! Chcę napoju energetycznego! Przyda mi się trochę, ekhm, orzeźwienia!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472072
    m_Localized: Dobra, trzymaj (podaj napój energetyczny)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472073
    m_Localized: 'Fatman: Phi! Nie masz EnerJeki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472074
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472075
    m_Localized: 'Fatman: Dobrze! Pomęczę się wtedy trochę, czyż nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472080
    m_Localized: A to pech, nie mam
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472081
    m_Localized: 'Fatman: Oho! Tak, tak, tak!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472082
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472084
    m_Localized: Powiedz mi o FEMA. Kim oni są?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472085
    m_Localized: Co planuje FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472101
    m_Localized: 'Fatman: Pfff! Bez cukru? Tfu, tfu, tfu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472104
    m_Localized: 'Fatman: Równie dobrze mógłbyś mnie uraczyć jakimś odrdzewiaczem! Pewnie lepiej by smakował… Czekaj, co powiedziałeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472105
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472106
    m_Localized: 'Fatman: Do licha, zwariowałeś? To tajne informacje!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472107
    m_Localized: 'Fatman: Podpisywałem papiery, rozumiesz? Zachowanie poufności. Nie, nie, nie! Nie możesz dostać tych danych!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472108
    m_Localized: 'Fatman: Proszę, weź zamiast tego trochę kawy i przestań drążyć. Grzeczny chłopak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472109
    m_Localized: 'Fatman: (Otrzymujesz puszkę kawy).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472110
    m_Localized: 'Fatman: O, EnerJeka? Ha! Bóg jeden wie, z jakich świństw oni to robią… czekaj, o co mnie właśnie zapytałeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472111
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472112
    m_Localized: 'Fatman: Do licha, zwariowałeś? Nic ci nie powiem. To tajne informacje!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472113
    m_Localized: 'Fatman: Podpisywałem papiery, rozumiesz? Zachowanie poufności. Bez urazy, ale nie możesz dostać tych danych.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472114
    m_Localized: 'Fatman: Proszę, weź zamiast tego trochę kawy i przestać zadawać pytania. Grzeczny chłopak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472115
    m_Localized: 'Fatman: (Otrzymujesz puszkę kawy).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472116
    m_Localized: 'Fatman: Wypraszam sobie! Jak mam niby, ekhm, pracować, kiedy mi burczy w brzuchu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472117
    m_Localized: 'Fatman: Staram się podnieść komfort życia ludzi! Wstawiam się za moimi wyborcami!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472118
    m_Localized: 'Fatman: Ale potraficie tylko krytykować, powiadam tobie! Myślisz, że jesteś taki cwany…? To dlaczego nie jesteś w rządzie, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472119
    m_Localized: 'Fatman: Dokładnie… Dużo gadania, zero konkretów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472120
    m_Localized: 'Fatman: Ach… zimna woda. Tego mi było trzeba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472121
    m_Localized: Słucham? Znowu czegoś potrzebujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472122
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472123
    m_Localized: 'Fatman: Niełatwo cię oszukać, chłopcze. Chcę twoją strzelbę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472124
    m_Localized: Że co?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472125
    m_Localized: Odbiło ci, do cholery?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472126
    m_Localized: 'Fatman: Tak, tak, tak. Oddaj ją. Potrzebna mi do ochrony.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472127
    m_Localized: 'Fatman: Byłem myśliwym. Wiem, jak z niej strzelać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472128
    m_Localized: Na pewno nie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472129
    m_Localized: Idź do diabła!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472130
    m_Localized: 'Fatman: Nie pyskuj mi tu, chłopcze. Zapomniałeś, do kogo mówisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472131
    m_Localized: 'Fatman: Wystarczy, że kiwnąłbym palcem, a wylądowałbyś w pierdlu! Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472132
    m_Localized: Na pewno nie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472133
    m_Localized: Idź do diabła!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472134
    m_Localized: 'Fatman: C‑co powiedziałeś? Ty mały… jestem ministrem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472135
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472136
    m_Localized: 'Fatman: Koniec tego! Koniec tego, powiadam tobie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472137
    m_Localized: 'Fatman: Pakuj manatki, bo zaraz zmienisz lokum na celę. HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472138
    m_Localized: Dla mnie jesteś tylko kolejnym Przybyszem
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472139
    m_Localized: Nie obchodzi mnie, żeś minister. Dla mnie jesteś nikim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472140
    m_Localized: 'Fatman: Zważaj na słowa, chłopcze! Nie mówi się tak do przedstawiciela ludu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472141
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472142
    m_Localized: 'Fatman: Jesteś skończony, powiadam tobie! SKOŃCZONY!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472143
    m_Localized: 'Fatman: Oho! Rozgniewanie mnie to wielki błąd! Ministrowie mają duże wpływy, powiadam tobie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472144
    m_Localized: 'Fatman: Już niedługo podwiniesz ogon…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472145
    m_Localized: Dla mnie jesteś nikim innym, jak kolejnym Przybyszem
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472146
    m_Localized: Nie obchodzi mnie, żeś minister. Dla mnie jesteś nikim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472147
    m_Localized: 'Fatman: Ty… ty… ŁAJDAKU!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472148
    m_Localized: 'Fatman: Skończysz za kratami! Zobaczysz! Tylko czekaj! HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472149
    m_Localized: 'Fatman: Ty… ty… ŁAJDAKU!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472150
    m_Localized: 'Fatman: Skończysz za kratami! Zobaczysz! Tylko czekaj! HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472151
    m_Localized: 'Fatman: Ach… zimna woda. Tego mi było trzeba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472152
    m_Localized: Czemuż więc nie mówię tego już zza krat?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472153
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472154
    m_Localized: 'Fatman: Och, droczysz się? Zobaczymy, kto będzie śmiał się ostatni!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472155
    m_Localized: Być może posady kiedyś coś znaczyły. Teraz jesteś nikim
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472156
    m_Localized: Pieniądze są teraz nic nie warte. Nie pojmujesz tego?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472157
    m_Localized: 'Fatman: Co za zuchwalstwo! Wciąż… wciąż jestem w rządzie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472158
    m_Localized: 'Fatman: Zostałem tylko… ekhm… wysłany na urlop…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472159
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472160
    m_Localized: 'Fatman: Hah… Kogo staram się nabrać… Dawne czasy nie wrócą…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472161
    m_Localized: 'Fatman: Kiedy byłem w ministerstwie, cały kraj tańczył, jak mu zagraliśmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472162
    m_Localized: 'Fatman: Ludzie się mnie bali i szanowali. Samochody zjeżdżały z drogi, wszyscy chcieli mnie udobruchać, przymilić się. A teraz…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472163
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472164
    m_Localized: 'Fatman: Pięknie. Teraz żołądek mi się przewraca ze stresu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472165
    m_Localized: 'Fatman: Zadowolony, hm? Idź sobie. Mam już dość…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472166
    m_Localized: 'Fatman: T‑to nieprawda! Wciąż mam pełno pieniędzy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472167
    m_Localized: 'Fatman: Dla ciebie mogą nie mieć wartości, ale… ale dla innych mają…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472168
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472169
    m_Localized: 'Fatman: Hah… Kogo staram się nabrać… Dawne czasy nie wrócą…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472170
    m_Localized: 'Fatman: Koniec z luksusami, limuzynami i panienkami…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472171
    m_Localized: 'Fatman: Wszystko było takie łatwe. Miało się kasę, było się kimś!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472172
    m_Localized: 'Fatman: Gdyby nie ten kataklizm…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472173
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472174
    m_Localized: 'Fatman: Pięknie. Teraz żołądek mi się przewraca ze stresu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472175
    m_Localized: 'Fatman: Zadowolony, hm? Idź sobie. Mam już dość…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173076770816
    m_Localized: 'Fatman: Jestem zmęczony. Zostaw mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173093548032
    m_Localized: 'Fatman: Jutro też jest cień. A kysz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472176
    m_Localized: 'Blind: Ciemność widzę…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472177
    m_Localized: Powiedz mi, co widziałeś?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666240
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666241
    m_Localized: 'Blind: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666242
    m_Localized: 'Blind: Uwierz mi, nie chcesz wiedzieć. Niewiedza jest miłosierdziem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666243
    m_Localized: 'Blind: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666244
    m_Localized: 'Blind: Myślałem, że jeśli mógłbym przestać widzieć, uwolniłbym się od tego… czegoś.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666245
    m_Localized: 'Blind: Niestety wryło mi się to w mózg…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666246
    m_Localized: 'Blind: Wciąż mogę śnić. A to nadal tam jest. Często to widzę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666247
    m_Localized: 'Blind: Ciemność widzę…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666248
    m_Localized: Czy bez oczu jest lepiej?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666249
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666250
    m_Localized: 'Blind: Ciężko stwierdzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666251
    m_Localized: 'Blind: Wiem, że już nigdy tego czegoś nie zobaczę. Nawet jeśli coś mnie zabije, nie będę wiedział, co.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666252
    m_Localized: 'Blind: To dziwne…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666253
    m_Localized: 'Blind: Nie wiem, jak wygląda twój dom. Trudno się po nim poruszać. Oczodoły by mnie bolały, gdyby nie leki…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666254
    m_Localized: 'Blind: Ale przynajmniej nie zobaczę już nigdy tego okropieństwa. Przyzwyczaję się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666255
    m_Localized: 'Blind: Jednak to, co zobaczyłem… Odcisnęło na mnie swój ślad. Będzie ze mną do końca świata.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666256
    m_Localized: 'Blind: Ciemność widzę…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666257
    m_Localized: Nie wyglądasz dobrze
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666258
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666259
    m_Localized: 'Blind: Może muszę się uczesać? Aha…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666260
    m_Localized: 'Blind: Miałem sen ostatniej nocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666261
    m_Localized: 'Blind: Szedłem torami tramwajowymi do siebie. Mijałem domy, drzewa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666262
    m_Localized: 'Blind: Usłyszałem tramwaj i zszedłem na bok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666263
    m_Localized: 'Blind: Odwróciłem się… i zobaczyłem, jak coś schwytało faceta na ulicy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666264
    m_Localized: 'Blind: Poruszało się tak szybko, że ledwo to widziałem. Wiedziałem jednak… wiedziałem, co to było.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666265
    m_Localized: 'Blind: Pobiegłem za tramwajem, ale nie doganiałem go. Nie dobiegnę do niego. Nie dosięgnę prawdy, która kryje się na zajezdni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666266
    m_Localized: 'Blind: Wtedy się obudziłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666267
    m_Localized: 'Blind: Ciemność widzę…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666268
    m_Localized: Wszystko w porządku?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666269
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666270
    m_Localized: 'Blind: Kolejny sen. To coś znów przylazło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666271
    m_Localized: 'Blind: Szedłem ulicą. Była noc. Latarnie uliczne migotały.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666272
    m_Localized: 'Blind: Odwróciłem się i zobaczyłem to coś idące w moją stronę. Powoli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666273
    m_Localized: 'Blind: Tym razem wyraźnie widziałem, jak to coś się porusza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666274
    m_Localized: 'Blind: Chciałem uciec, ale doganiało mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666275
    m_Localized: 'Blind: Dobiegłem do domu, ale nie mogłem otworzyć furtki. Przeskoczyłem płot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666276
    m_Localized: 'Blind: Niezdarnie szukałem kluczy w kieszeni, prześlizgiwały mi się przez palce.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666277
    m_Localized: 'Blind: Pobiegłem na tył domu. Przeskoczyłem kolejny płot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666278
    m_Localized: 'Blind: Zatrzymałem się. Cisza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666279
    m_Localized: 'Blind: Spojrzałem w górę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666280
    m_Localized: 'Blind: Było tam. Sięgało do mnie ponad płotem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666281
    m_Localized: 'Blind: Myślisz, że to te tabletki przeciwbólowe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666282
    m_Localized: 'Blind: Ciemność widzę…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666283
    m_Localized: Miałeś w nocy jakiś sen?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666284
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666285
    m_Localized: 'Blind: Tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666286
    m_Localized: 'Blind: Ale nie chcę o nim mówić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666287
    m_Localized: 'Blind: Teraz rozumiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666288
    m_Localized: 'Blind: Wszyscy zginiemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666289
    m_Localized: 'Blind: To coś nas rozszarpie. Na jawie lub we śnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666290
    m_Localized: 'Blind: Wszyscy spłoniemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666291
    m_Localized: 'Blind: Nic nie ma już znaczenia. To koniec.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666292
    m_Localized: 'Blind: Ja… zostaw mnie, proszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666293
    m_Localized: 'Dude: Siema, ziom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666294
    m_Localized: Czym się zajmowałeś przed katastrofą?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666295
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666296
    m_Localized: 'Dude: Och, ziom, tylko czilowałem. Oglądałem filmy, siedziałem z kumplami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666297
    m_Localized: 'Dude: A teraz? Ani filmów, ani spotkań. Jaki zjazd, ziom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666298
    m_Localized: 'Dude: W telewizji wciąż to samo: panika, reklamy, panika, reklamy. Moi kumple już nawet nie odbierają telefonów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666299
    m_Localized: 'Dude: Słyszałem, jak jakiś ważniak mówił „To nie czas na hulanki. Mamy kryzys…”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666300
    m_Localized: 'Dude: Stary, walić tego nudziarza. U nas imprezka non‑stop! Bum szakalaka!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666301
    m_Localized: 'Dude: Siema, ziom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666302
    m_Localized: Gdzie pracowałeś?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666303
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666304
    m_Localized: 'Dude: Praca? Pfff!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666305
    m_Localized: 'Dude: Tylko naiwniacy pracują, ziom. Ja zajmowałem się życiem, czaisz bazę?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666306
    m_Localized: 'Dude: Widziałem raz taki film, w którym główny bohater był dosłownie mną.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666307
    m_Localized: 'Dude: Przyznaj, czy robotnicy pracujący przy lince wydają się szczęśliwi? Jasne, że nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666308
    m_Localized: 'Dude: Organizowałem balety, stary. Poznawałem klawych ziomali. To było prawdziwe życie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666309
    m_Localized: 'Dude: To znaczy… Byłem raz menadżerem w magazynie przy wysyłkach. Rodzice mi załatwili, no nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666310
    m_Localized: Zatem żyjesz na garnuszku rodziców?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666311
    m_Localized: Krótko mówiąc, jesteś bumelantem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666312
    m_Localized: 'Dude: Po co się męczyć, ziom, kiedy mam wszystko ogarnięte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666313
    m_Localized: 'Dude: Strasznie głupio nie korzystać z tego, co już się ma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666314
    m_Localized: 'Dude: To znaczy… masz te wielką giwerę, no nie? Czy tylko będzie wisieć u ciebie na ścianie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666315
    m_Localized: 'Dude: Jasne, że nie. Płynę z nurtem, tak jak i ty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666316
    m_Localized: 'Dude: Elo, wycziluj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666317
    m_Localized: 'Dude: Jeśli czujesz zazdro, powiedz wprost, ziom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666318
    m_Localized: 'Dude: Kumam, nie każdy gra w życie na łatwym poziomie. Tak już jest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666319
    m_Localized: 'Dude: Siema, ziom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666320
    m_Localized: Czy coś się stało?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666321
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666322
    m_Localized: 'Dude: Ziom… gdzie trzymasz filmy? Nie widzę tu żadnych kaset.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666323
    m_Localized: 'Dude: Oglądasz cokolwiek?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666324
    m_Localized: 'Dude: To znaczy… umieram tu z nudów, staryyy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666325
    m_Localized: To nie czas na oglądanie filmów
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666326
    m_Localized: Nie mam żadnych
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666327
    m_Localized: 'Dude: A to lipa, a myślałem, że to miejsce jest legitne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666328
    m_Localized: 'Dude: Nie będę ściemniał, ludzie tutaj są zakręceni jak słoiki na zimę… I nie ma nic do oglądania.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666329
    m_Localized: 'Dude: Ani czasopism, ani filmów… tylko same książki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666330
    m_Localized: 'Dude: Ja pierniczę, kto w ogóle czyta książki, ziom? One są jak jakieś skamieliny! Same trudne słowa i bez obrazków. Nuuudaaa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666331
    m_Localized: Nie prowadzę tu kina
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666332
    m_Localized: Jesteś tu po to, by imprezować czy przeżyć?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666333
    m_Localized: 'Dude: Kurcze, stary… Powaga?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666334
    m_Localized: 'Dude: Nie, nooo. Ty naprawdę na poważnie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666335
    m_Localized: 'Dude: To znaczy… w twoim pokoju jest telewizor, ziom, ale nie masz żadnych filmów?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666336
    m_Localized: 'Dude: Ta domówka jest do bani. Myślałem, że jesteś wporzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666337
    m_Localized: Nie prowadzę tu kina
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666338
    m_Localized: Jesteś tu po to, by imprezować czy przeżyć?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666339
    m_Localized: 'Dude: Ziooom…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666340
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666341
    m_Localized: 'Dude: Ależ z ciebie sztywniak, stary…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666342
    m_Localized: Uspokój się, jeśli chcesz przeżyć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666343
    m_Localized: Jeśli ci się tu nie podoba, możesz wyjść
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666344
    m_Localized: 'Dude: No co ty, stary…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666345
    m_Localized: 'Dude: Telewizor u mnie jest sfajczony, ziom. Miałem nadzieję, że uratujesz mnie od śmierci z nudów, ale nieee…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666346
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666347
    m_Localized: 'Dude: Ależ z ciebie sztywniak, stary…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666348
    m_Localized: Uspokój się, jeśli chcesz przeżyć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666349
    m_Localized: Jeśli ci się tu nie podoba, możesz wyjść
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666350
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666351
    m_Localized: 'Dude: Ejże, wycziluj, ziom. To miejsce to żenua, ale lepsze niż ulica.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666352
    m_Localized: 'Dude: Tylko… daj mi chociaż trochę pooglądać telewizję, stary. No weeeź…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666353
    m_Localized: 'Dude: Wiedziałem. Jesteś totalnym nudziarzem, ziom!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666354
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666355
    m_Localized: 'Dude: Palę stąd wrotki. Luźno, stary.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666356
    m_Localized: 'Teacher: Te biedne dzieciaczki…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666357
    m_Localized: Wszystko w porządku?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666358
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666359
    m_Localized: 'Teacher: Tak, chyba tak… Sama nie wiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666360
    m_Localized: 'Teacher: Nie rozumiem… jak dorośli, rzekomo racjonalni ludzie, mogli pozwolić, by emocje skłoniły ich do takiej zbrodni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666361
    m_Localized: 'Teacher: Czy naprawdę byli tak przerażeni, że zabiliby dziecko?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666362
    m_Localized: Ludzie ostatnio robią gorsze rzeczy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666363
    m_Localized: W chaosie pierwszy ginie rozsądek
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666364
    m_Localized: 'Teacher: Co może być gorsze od zabicia bezbronnego dziecka?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666365
    m_Localized: 'Teacher: To nie była tylko jedna osoba… ale duży tłum. Cała ciżba szukająca winowajców…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666366
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666367
    m_Localized: 'Teacher: Ciężkie czasy pokazują, kim zaiste jesteśmy. Może to my jesteśmy potworami, a nie te stwory wypełzające z podziemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666368
    m_Localized: 'Teacher: Czy ludzie nie wiedzą, że zabijanie dzieci jest… Brakuje mi nawet słów…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666369
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666370
    m_Localized: 'Teacher: Ciężkie czasy pokazują, kim zaiste jesteśmy. Może to my jesteśmy potworami, a nie te stwory wypełzające z podziemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666371
    m_Localized: 'Teacher: Te biedne dzieciaczki…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666372
    m_Localized: Jak długo pani uczyła?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666373
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666374
    m_Localized: 'Teacher: Około trzy miesiące… przed kataklizmem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666375
    m_Localized: 'Teacher: Daleko mi było jednak do ideału. Nie lubiłam tej pracy. Wtedy dzieci były tylko rozwrzeszczane i wyczerpujące.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666376
    m_Localized: 'Teacher: Po kataklizmie zmieniłam zdanie. Otworzyło mi to oczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666377
    m_Localized: 'Teacher: Wie pan, każde z tych dzieci mogło zostać gwiazdą rocka, politykiem czy rodzicem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666378
    m_Localized: 'Teacher: Teraz już nie chwycą gitary. Nie pójdą do szkoły. Nie dorosną.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666379
    m_Localized: 'Teacher: Pozostaną na zawsze… gromadą marzycieli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666380
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666381
    m_Localized: 'Teacher: Pamiętam, jak jednego dnia podbiegł do mnie chłopiec, cały zapłakany, mówiąc, że rodzice się go boją.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666382
    m_Localized: 'Teacher: Mieli go za Przybysza i… wyrzucili go na ulicę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666383
    m_Localized: 'Teacher: Nie wiedział, dokąd ma pójść, więc przyszedł do mnie… do przedszkola.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666384
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666385
    m_Localized: 'Teacher: (Kobieta nie jest w stanie dłużej wstrzymywać łez i zaczyna płakać).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666386
    m_Localized: 'Teacher: Proszę mi wybaczyć…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666387
    m_Localized: 'Teacher: Te biedne dzieciaczki…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666388
    m_Localized: Przepraszam za wczoraj, nie chciałem pani denerwować
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666389
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666390
    m_Localized: 'Teacher: W porządku. Już… już jest dobrze. Czuję się lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666391
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666392
    m_Localized: 'Teacher: Wracając do tego chłopca… Później uzmysłowiłam sobie, jak bezbronne są dzieci. Zwłaszcza, gdy wszystko wokół się wali.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666393
    m_Localized: 'Teacher: Zaczęłam brać pod moje skrzydło każdą opuszczoną duszyczkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666394
    m_Localized: 'Teacher: Słuchałam ich opowieści… Nie do pojęcia jest, jak niektórzy z rodziców bez wahania się ich pozbyli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666395
    m_Localized: 'Teacher: Jakby kataklizm usprawiedliwiał porzucenie dziecka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666396
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666397
    m_Localized: 'Teacher: Być może… w ogóle nie chcieli mieć dzieci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666398
    m_Localized: 'Teacher: Te biedne dzieciaczki…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666399
    m_Localized: Czy ma pani swoje dzieci?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666400
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666401
    m_Localized: 'Teacher: Nie… ale moja matka często wywierała na mnie presję, żebym się ustatkowała i założyła rodzinę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666402
    m_Localized: 'Teacher: Nigdy jednak nie byłam na to gotowa. Chciałam, żeby to była świadoma decyzja podjęta w odpowiednim czasie, rozumie pan?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666403
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666404
    m_Localized: 'Teacher: Wysłuchiwanie historii tych opuszczonych dzieci… Skłoniło mnie do myślenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666405
    m_Localized: 'Teacher: Jeśli posłuchałabym matki, czy skończyłabym jak rodzice tych maluchów?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666406
    m_Localized: 'Teacher: Z tego powodu pomagam każdemu porzuconemu dziecku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666407
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666408
    m_Localized: 'Teacher: Wie pan, co jest najgorsze? Podpalaczem był jeden z rodziców dziecka, które przygarnęłam…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666409
    m_Localized: 'Teacher: (Kobieta znów nie jest w stanie powstrzymać napływających łez).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666410
    m_Localized: 'Teacher: Proszę mi wybaczyć…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666411
    m_Localized: 'Teacher: Starałam się zapewnić im godne życie, poważnie. Dbałam o nie. Nie powinno do tego dojść…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666412
    m_Localized: 'Teacher: Tak mi przykro…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666413
    m_Localized: Nie jest pani winna ich śmierci
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666414
    m_Localized: Przykro mi z tego powodu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666415
    m_Localized: 'Teacher: Może ma pan rację, ale… w środku czuję ogromną pustkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666416
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666417
    m_Localized: 'Teacher: Wie pan, nie mogę przestać o czymś myśleć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666418
    m_Localized: 'Teacher: Co, jeśli ich rodzice nigdy do nich nic nie czuli? Byli kompletnie obojętni?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666419
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666420
    m_Localized: 'Teacher: Starałam się… mam nadzieję, że obdarowałam je chociaż odrobiną miłości…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666421
    m_Localized: 'Teacher: Dziękuję… ale wciąż czuję się załamana. Nigdy się z tego nie otrząsnę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666422
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666423
    m_Localized: 'Teacher: Wie pan, nie mogę przestać o czymś myśleć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666424
    m_Localized: 'Teacher: Co, jeśli ich rodzice nigdy do nich nic nie czuli? Byli kompletnie obojętni?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666425
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666426
    m_Localized: 'Teacher: Starałam się… mam nadzieję, że obdarowałam je chociaż odrobiną miłości…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860544
    m_Localized: 'Ballerina: Kotek tu jest. Czego trzeba jeszcze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860545
    m_Localized: Po co tu przyszłaś?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860546
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860547
    m_Localized: 'Ballerina: Ale głupitaśne pytanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860548
    m_Localized: 'Ballerina: Otworzył drzwi. Sam się zapytaj, po co. Dlaczego jestem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860549
    m_Localized: 'Ballerina: Dla mnie mało ma różnicy. Miejsce to miejsce.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860550
    m_Localized: 'Ballerina: Mówił chodź tutaj, to jestem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860551
    m_Localized: 'Ballerina: Nic nie chcę niczego. Nie ciebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860552
    m_Localized: 'Ballerina: Tylko ważne, żeby kici miał wygoda. Reszta? Nie obchodzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860553
    m_Localized: 'Ballerina: Kotek tu jest. Czego trzeba jeszcze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860554
    m_Localized: Czy ty jesteś w ogóle człowiekiem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860555
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860556
    m_Localized: 'Ballerina: A ty?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860557
    m_Localized: 'Ballerina: Co w ciebie co zostało?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860558
    m_Localized: 'Ballerina: Co mi robi nader gorszą?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860559
    m_Localized: 'Ballerina: Kotek tu jest. Czego trzeba jeszcze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860560
    m_Localized: Kto cię przysłał?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860561
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860562
    m_Localized: 'Ballerina: Zrobiłeś, co być potrzeba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860563
    m_Localized: 'Ballerina: Po co wiedzieć o więcej?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860564
    m_Localized: 'Ballerina: Zgoda. Pewien… ktoś wysłać mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860565
    m_Localized: 'Ballerina: Nie powiedziano, co dalej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860566
    m_Localized: 'Ballerina: Kotek tu jest. Czego trzeba jeszcze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860567
    m_Localized: Jak długo zamierzasz tu zostać?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860568
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860569
    m_Localized: 'Ballerina: Aż po mnie przyjdą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860570
    m_Localized: 'Ballerina: Co więcej mniemam robić? Hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860571
    m_Localized: 'Ballerina: Wiem niezbyt. Rzekli coś, teraz czekam ja po więcej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860572
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860573
    m_Localized: 'Ballerina: Tobie kto rzecze, co robić?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860574
    m_Localized: 'Ballerina: Na co czeka?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860575
    m_Localized: 'Ballerina: Kotek tu jest. Czego trzeba jeszcze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860576
    m_Localized: Dlaczego mnie nie zabiłaś?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860577
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860578
    m_Localized: 'Ballerina: Jest ty mało głupi, wie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860579
    m_Localized: 'Ballerina: Każdy dzień, to samo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860580
    m_Localized: 'Ballerina: Powiedziała. Nie rzekli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860581
    m_Localized: 'Ballerina: Czekam. Czemu czekasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860582
    m_Localized: 'Mother: Ale duchota…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860583
    m_Localized: Wszystko w porządku? Jak dziecko?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860584
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860585
    m_Localized: 'Mother: Hm? Och, tak… Utyrany, jak ja. Nieśmiały przy nieznajomych, więc się mocno trzyma mamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860586
    m_Localized: 'Mother: Dzieciakom niełatwo w takich czasach. Może i nie narzekają, ale mają to wymalowane na gębach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860587
    m_Localized: 'Mother: Czasem czuję się winna za to, że je w to wciągnęłam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860588
    m_Localized: 'Mother: Teraz za późno, żeby coś zmienić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860589
    m_Localized: 'Couple: No, złotko, nie dąsaj się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860590
    m_Localized: Czemu byliście na zewnątrz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860591
    m_Localized: Chcę was sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860592
    m_Localized: 'Couple: Och, szliśmy odwiedzić mamę mojej kochanej żony.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860593
    m_Localized: 'Couple: W samą porę zorientowałem się, że sami nie damy rady i trafiliśmy tutaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860594
    m_Localized: 'Couple: Jeszcze raz dzięki, że nas wpuściłeś!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860595
    m_Localized: 'Couple: No, złotko, nie dąsaj się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860596
    m_Localized: Daleko jeszcze macie do przejścia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860597
    m_Localized: Chcę was sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860598
    m_Localized: 'Couple: Moje złotko nie orientuje się zbyt dobrze w terenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860599
    m_Localized: 'Couple: Jeśli nie znajdziemy pomocy, wtedy może dojdziemy za dwa dni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860600
    m_Localized: 'Couple: A to już wliczając, że kilka razy się zgubiliśmy, szukając drogi. Ha! Prawda, złotko?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860601
    m_Localized: 'Couple: Jeśli jednak ktoś by nas podwiózł, byłoby świetnie. Wtedy to góra kilka godzin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860602
    m_Localized: Czemu naszła was taka ochota, żeby teraz odwiedzić jej mamę?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860603
    m_Localized: Czas się coś tu nie zgadza
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860604
    m_Localized: 'Couple: Hej, kto wie, co u niej, gdy wszędzie panuje taki bałagan?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860605
    m_Localized: 'Couple: Ma wyłączony telefon. Od kilku dni nie mamy z nią kontaktu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860606
    m_Localized: 'Couple: A jeśli potrzebuje pomocy? Musimy się upewnić, że nic jej nie jest!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860607
    m_Localized: 'Couple: Noce są krótkie o tej porze roku. Strasznie jest wychodzić na zewnątrz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860608
    m_Localized: 'Couple: Ale to nic, już wkrótce zobaczymy się z mamą, złotko.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860609
    m_Localized: 'Couple: Tylko że ja nie bardzo wiem, jak tam dojść, a moja głupiutka żona często myli lewą stronę z prawą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860610
    m_Localized: 'Couple: Ale to w porządku. Najważniejsze, że idziemy do przodu, prawda, złotko?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860611
    m_Localized: 'Couple: Kto wie, może za tydzień dojdziemy! Ha, ha, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860612
    m_Localized: 'Couple: No, złotko, nie dąsaj się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860613
    m_Localized: Myślałem, że wieczorem idziecie dalej
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860614
    m_Localized: Chcę was sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860615
    m_Localized: 'Couple: Taki był zamiar, ale mojej głupiutkiej żonie zabrało trzy godziny, żeby się przygotować. Teraz jest za późno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860616
    m_Localized: 'Couple: Będziemy musieli wyjść kiedy indziej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860617
    m_Localized: 'Couple: Przepraszam za kłopot. Następnym razem się uwiniemy, nie martw się!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860618
    m_Localized: 'Couple: Upewnię się, żeby moja mucha w smole zagęściła ruchy. Ha, ha, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860619
    m_Localized: 'Couple: Chyba że się narzucamy? Powiedziałbyś nam, prawda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860620
    m_Localized: 'Couple: No, złotko, nie dąsaj się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860621
    m_Localized: Czy wszystko z panią w porządku?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860622
    m_Localized: Chcę was sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860623
    m_Localized: 'Couple: Nic jej nie jest, czemu pytasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860624
    m_Localized: 'Couple: Nie ma nic więcej do dodania niż to, co już powiedziałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860625
    m_Localized: 'Couple: A poza tym jest trochę roztrzęsiona. Nie ma powodów do obaw.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860626
    m_Localized: Mówiłem do niej
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860627
    m_Localized: Jak się pani czuje?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860628
    m_Localized: 'Couple: Ejże, a ja powiedziałem, że jest zmęczona. Nie bądź wścibski, proszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860629
    m_Localized: 'Couple: Kiedyś żona straci swój ogon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860630
    m_Localized: 'Couple: Szczerze to już pewnie przestała przejmować się mamą… ale dojdziemy tam!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860631
    m_Localized: 'Couple: To znaczy, jeśli ta stara rura wciąż żyje! Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860632
    m_Localized: 'Couple: No, króliczku, czas się zbierać. Ile jeszcze muszę na ciebie czekać, do cholery?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860633
    m_Localized: 'Couple: Ech, wszystko gra, tak mniej więcej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860634
    m_Localized: 'Couple: Zaczynam podejrzewać, że partnerka przestała przejmować się swoją matką. Ha, ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860635
    m_Localized: 'Couple: Może powinienem jej przypomnieć, w jakim może być niebezpieczeństwie, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860636
    m_Localized: 'Couple: Przykro mi, że musisz tego słuchać. Doprowadza mnie do szału z tym ociąganiem się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860637
    m_Localized: 'Couple: Siadaj na dupie i zaczynaj się zbierać! Mam, kurwa, po dziurki w nosie tego czekania, do cholery!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860638
    m_Localized: 'Couple: No, złotko, nie dąsaj się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860639
    m_Localized: Twoja żona nie chce nigdzie iść. O co tu chodzi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860640
    m_Localized: Chcę was sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860641
    m_Localized: 'Couple: Wkurwia mnie, o to chodzi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860642
    m_Localized: 'Couple: Zawsze tylko biadoli i mnie obwinia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860643
    m_Localized: 'Couple: Czy tak ciężko zawrzeć gębę i robić, co każę? Prościej chyba nie można!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860644
    m_Localized: 'Couple: Przepraszam, że nadużywamy gościny. To ostatni dzień i wynosimy się stąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860645
    m_Localized: 'Couple: Słyszysz mnie? Pakuj manele. Jeśli nie wyjdziemy przed nocą, przyrzekam, że wylecisz przez okno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860646
    m_Localized: Proszę pani, czy wszystko na pewno w porządku?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860647
    m_Localized: Co się tutaj dzieje?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860648
    m_Localized: 'Couple: Nie interesuj się. Już raz ci powiedziałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860649
    m_Localized: 'Couple: Nie wścibiaj nosa w nie swoje sprawy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860650
    m_Localized: 'Couple: Sami sobie to ogarniemy, odwal się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860651
    m_Localized: Mam dość twojej gadki. Mów prawdę. TERAZ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860652
    m_Localized: Wisi mi to. Wychodzicie czy nie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860653
    m_Localized: 'Couple: Ejże, spokojnie. Powiedziałem, że wszystko gra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860654
    m_Localized: 'Couple: Żona jest… znudzona, więc ma fochy. Wkurza mnie tym czasami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860655
    m_Localized: 'Couple: Czego ode mnie chcesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860656
    m_Localized: Mam dość twojej gadki. Mów prawdę. TERAZ
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860657
    m_Localized: Wisi mi to. Wychodzicie czy nie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860658
    m_Localized: 'Couple: Tylko spokojnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860659
    m_Localized: 'Couple: Też mam giwerę. Nie cwaniakuj, bo szmata dostanie kulkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860660
    m_Localized: 'Couple: Ja nie mam nic do stracenia, a ty?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860661
    m_Localized: I tak zginiesz
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860662
    m_Localized: Wciąż możesz odejść
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860663
    m_Localized: 'Couple: Jasne, jasne, spokojna głowa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860664
    m_Localized: 'Couple: Wychodzimy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054848
    m_Localized: 'Couple: Słyszałaś? To nasza ostatnia noc tutaj, więc koniec opierdalania, pakuj się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054849
    m_Localized: 'Couple: Bo co może się stać? Zabijesz mnie i co wtedy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054850
    m_Localized: 'Couple: Chociaż skończy się męka, a ta suka kipnie ze mną. Wszyscy zadowoleni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054851
    m_Localized: Będę strzelał
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054852
    m_Localized: Uspokój się. Odłóżmy broń
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054853
    m_Localized: 'Couple: Po co? Muszę odejść razem z nią.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054854
    m_Localized: 'Couple: Jeśli ona zostaje, ja też zostaję. Opuść broń a dziś wieczorem zwiniemy manatki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054855
    m_Localized: 'Couple: Nikomu nie musi stać się krzywda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054856
    m_Localized: Będę strzelał
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054857
    m_Localized: Uspokój się. Odłóżmy broń
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054858
    m_Localized: 'Couple: Zabijesz niewinną kobietę? Nie obchodzi cię to, poważnie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054859
    m_Localized: 'Couple: Wiesz, że jak do mnie strzelisz, ona też oberwie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054860
    m_Localized: 'Couple: To nie będzie moja wina! Jej krew będzie na twoich rękach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054861
    m_Localized: Strzel
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054862
    m_Localized: Ostrzeż
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054863
    m_Localized: 'Couple: Muszę odejść albo zginiemy oboje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054864
    m_Localized: 'Couple: Nie ma innego wyjścia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054865
    m_Localized: 'Couple: Jeśli ta ździra przestałaby się tylko trząść jak osika i poszła ze mną…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054866
    m_Localized: 'Couple: To twoja wina. Słyszysz mnie, głupia pizdo? Wszystko zepsułaś!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054867
    m_Localized: Strzel
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054868
    m_Localized: Ostrzeż
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054869
    m_Localized: 'Couple: Opuszczasz broń…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054870
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054871
    m_Localized: 'Couple: Czekaj, nie, wciąż chcesz mnie zastrzelić?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054872
    m_Localized: 'Couple: CZEKAJ! STÓJ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054873
    m_Localized: 'Couple: Pójdziemy sobie, dobrze? Bez nerwów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054874
    m_Localized: 'Couple: Prawda? Czy tym razem weźmiesz dupę w troki, szmato?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054875
    m_Localized: 'Couple: (Kobieta nagle uwalnia się. Mężczyzna strzela do niej).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054876
    m_Localized: 'Couple: (Reagujesz błyskawicznie i strzelasz facetowi w głowę).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054877
    m_Localized: 'Couple: (Wygląda na to, że oboje nie żyją… Przynajmniej to już koniec).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054878
    m_Localized: 'Couple: (Co za świrnięta para…).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054879
    m_Localized: 'Couple: Dobra, idziemy. Daj nam tylko wziąć jakieś okrycie i spadamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054880
    m_Localized: 'Couple: Więcej nas nie zobaczysz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054881
    m_Localized: 'Couple: Czekaj…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054882
    m_Localized: 'Couple: C‑CO TY ROBISZ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054883
    m_Localized: 'Couple: (Strzelasz do mężczyzny, ale trafiasz też kobietę).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054884
    m_Localized: 'Couple: (Oboje upadają na ziemię, krwawiąc).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054885
    m_Localized: 'Couple: (Kobieta krztusi się przez chwilę, ale nie możesz jej pomóc).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054886
    m_Localized: 'Couple: (Oboje nie żyją).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054887
    m_Localized: 'Couple: Nie rozumiesz? Inaczej nie będzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054888
    m_Localized: 'Couple: Idziemy. Koniec dyskusji.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054889
    m_Localized: 'Couple: Hej! Bierz koc, teraz. Chodź.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054890
    m_Localized: 'Couple: (Obserwujesz jak para okrywa się kocem i wychodzi).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054891
    m_Localized: 'Couple: (Idą przez chwilę, a potem nagle upadają).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054892
    m_Localized: 'Couple: (Z koca zaczyna unosić się dym. Odwracasz się).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054893
    m_Localized: 'BigLebowski: Ech, dość mam tego wszystkiego…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054894
    m_Localized: Dlaczego włóczysz się sama?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054895
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054896
    m_Localized: 'BigLebowski: W domu było za ciasno. Szalenie głośno. Żadnego komfortu. Miałam dość. Chciałam zwiedzić świat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054897
    m_Localized: 'BigLebowski: Wzięłam plecak, kilka napojów, parę batonów i tę starą bransoletkę przyjaźni, którą zrobiłam w szkole.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054898
    m_Localized: 'BigLebowski: I ruszyłam w drogę… Rodzice pewnie nawet nie zauważyli i nie obchodzi mnie to.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054899
    m_Localized: 'BigLebowski: Od tamtej pory tak się szwendam i śpię, gdzie popadnie. I serio? Na razie jest wporzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054900
    m_Localized: 'BigLebowski: Nikt mi nie zawraca głowy i nie rozkazuje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054903
    m_Localized: 'BigLebowski: Ech, dość mam tego wszystkiego…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054904
    m_Localized: Jak udało ci się przetrwać?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054905
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054906
    m_Localized: 'BigLebowski: Jakoś.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054907
    m_Localized: 'BigLebowski: Wkradałam się do klatek schodowych, kanciapek, kimałam pod drzewami. Chowałam się przed skwarem pod czymkolwiek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054908
    m_Localized: 'BigLebowski: Jadłam, co mogłam. Jakieś dzikie zielsko lub cukierki zwędzone ze sklepu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054909
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054910
    m_Localized: 'BigLebowski: Co się tak gapisz? Tak, kradłam. I co z tego? Jak niby miałam przeżyć? Nikt nie da mi pracy, więc wszystko jedno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054911
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233280
    m_Localized: 'BigLebowski: No nie, co znowu? Myślisz, że też cię okradnę? Pfff, daruj.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233281
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233282
    m_Localized: 'BigLebowski: Co? Czy to jakieś przesłuchanie? Serio, skończ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054912
    m_Localized: 'BigLebowski: Ech, dość mam tego wszystkiego…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054913
    m_Localized: Jak długo zamierzasz tak żyć?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054914
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054915
    m_Localized: 'BigLebowski: No nie. Co cię to obchodzi? Poradzę sobie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054916
    m_Localized: 'BigLebowski: Bo co, będę tu dla ciebie taaakim ciężarem? Oskubałam cię z czegoś? Zapchałam kibel? Czemu mnie dręczysz, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054917
    m_Localized: 'BigLebowski: Och… Jesteś jednym z tych dewiantów…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054918
    m_Localized: 'BigLebowski: Poznałam raz takiego. Mówił do mnie słodko, dał miejsce do spania.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054919
    m_Localized: 'BigLebowski: Oglądaliśmy anime, filmy i co tam jeszcze. Myślałam, że w końcu trafiłam na kogoś normalnego. Ale nieee…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054920
    m_Localized: 'BigLebowski: Potem chciał położyć na mnie łapy… Parszywy zboczeniec.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054921
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233283
    m_Localized: 'BigLebowski: Spróbuj czegoś takiego, a ci dokopię. Nie dam się skrzywdzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233284
    m_Localized: 'BigLebowski: Mój tata może i jest łajdakiem, ale przynajmniej pokazał mi, jak się bić.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233285
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233286
    m_Localized: 'BigLebowski: Tak jest. Nie zbliżaj się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054922
    m_Localized: 'BigLebowski: Ech, dość mam tego wszystkiego…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054923
    m_Localized: I co się stało z tym facetem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054924
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054925
    m_Localized: 'BigLebowski: Czemu chcesz wiedzieć, staruchu? Szukasz, jak mnie podejść, gdy będę się bronić, co? Mniejsza z tym…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054926
    m_Localized: 'BigLebowski: Nie jestem głupia, nie pytasz z dobroci serca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054927
    m_Localized: 'BigLebowski: Nie chcesz tylko kaszany pod swoim dachem, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054928
    m_Localized: 'BigLebowski: Ja ci tu jej nie narobię. Nie okradnę, nie powybijam okien… więc daj se siana, do licha!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054929
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054930
    m_Localized: 'BigLebowski: A tak w ogóle…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054931
    m_Localized: 'BigLebowski: Jestem tu tylko po to, bo mnie potrzebujesz, nie? Żeby nie dorwał cię ten półnagi gość? Tak, wiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233287
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233288
    m_Localized: 'BigLebowski: Jeśli tak ma być, wtedy… ech, mniejsza z tym! Zrób te swoje zboczone testy, ale nie mów do mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054932
    m_Localized: 'BigLebowski: Ech, dość mam tego wszystkiego…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054933
    m_Localized: Dlaczego tata nauczył cię walczyć?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054934
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054935
    m_Localized: 'BigLebowski: Abym mogła dać w skórę zboczeńcom. Albo żeby wyładowywał na mnie swoją cholerną złość…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054936
    m_Localized: 'BigLebowski: Wyprowadź cios, przyjmij cios, bla, bla, bla. Jedyny problem? Moja twarz była jego workiem treningowym.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233289
    m_Localized: 'BigLebowski: Czasami jednak trenowaliśmy normalnie. Czego, tak przy okazji, nie cierpiałam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233290
    m_Localized: 'BigLebowski: Innymi czasy mu odwalało i bił mnie na kwaśne jabłko. A mama? Gówno ją to obchodziło. Nawet nie patrzyła.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233291
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233292
    m_Localized: 'BigLebowski: Ech, nie chcę skończyć tak, jak oni.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233293
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233294
    m_Localized: 'BigLebowski: Po co mnie robili, skoro mnie tak traktowali, co? Nie kumam. Czy takie właśnie jest życie?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233295
    m_Localized: 'BigLebowski: A teraz jeszcze na dodatek to słońce i Przybysze. Rewelacja. Wszystko jest jeszcze bardziej do bani.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233296
    m_Localized: 'BigLebowski: Czy kiedyś wydarzy się coś dobrego?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233297
    m_Localized: 'BigLebowski: Wątpię.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054937
    m_Localized: 'Luka: Wszystko będzie w porządeczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054938
    m_Localized: Wciąż zadowolony?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054939
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054940
    m_Localized: 'Luka: Może i nie zadowolony… ale trzymam się jakoś kupy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054941
    m_Localized: 'Luka: Nadal jesteśmy ludźmi. Radzimy sobie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054942
    m_Localized: 'Luka: Nie pogarszamy sytuacji.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054943
    m_Localized: 'Luka: A kiedy to się skończy… Wybaczymy sobie wszystkie nasze złe uczynki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054944
    m_Localized: 'Luka: Póki jest współczucie, jest i człowieczeństwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054945
    m_Localized: 'Luka: Rozumiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054946
    m_Localized: 'Luka: Wszystko będzie w porządeczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054947
    m_Localized: Zawsze taki jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054948
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054949
    m_Localized: 'Luka: A wiesz… że nie? Nie zawsze. Zwykłem być podminowany. Na ludzi, na świat, na siebie samego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054950
    m_Localized: 'Luka: Wszystko mnie wkurzało, trzaskałem drzwiami tak, że pękały futryny. W końcu pojąłem, że złość tylko niszczy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054951
    m_Localized: 'Luka: Najpierw w środku. A potem wszystko dookoła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054952
    m_Localized: 'Luka: Jednego razu… Wybuchnąłem na kogoś, kto chciał mi pomóc. Teraz on… ona odeszła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054953
    m_Localized: 'Luka: Wtedy coś we mnie pękło. Wiedziałem, że muszę się zmienić, albo zniszczę wszystko, czego się tknę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054954
    m_Localized: 'Luka: Nauczyłem się odpuszczać. Oddychać. Pojednywać się. Tak osiągnąłem ten stan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054955
    m_Localized: 'Luka: Wszystko będzie w porządeczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054956
    m_Localized: Kogo utraciłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054957
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054958
    m_Localized: 'Luka: Rodzinę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054959
    m_Localized: 'Luka: Dom nam spłonął, gdy mnie nie było. Wyszedłem tylko na chwilę po wodę. Wróciłem, a tam zgliszcza i dym.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054960
    m_Localized: 'Luka: Długo nie mogłem się z tym pogodzić. Pytałem siebie: „czemu wtedy wyszedłem?”, „czemu ich nie uratowałem?”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054961
    m_Localized: 'Luka: Może nie o to chodziło. Może nie chodzi o ocalenie przeszłości, ale o niesienie jej ze sobą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054962
    m_Localized: 'Luka: W pewnym sensie są ze mną. Pamięć o nich daje mi siłę. Z tego powodu staram się pomagać ludziom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054963
    m_Localized: 'Luka: Wiem, jak to jest stracić… wszystko. I wiem też, jak to jest odnaleźć znaczenie w życiu po takim nieszczęściu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054964
    m_Localized: 'Luka: Wszystko będzie w porządeczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054965
    m_Localized: I dajesz radę tak żyć? Straciwszy rodzinę?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054966
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054967
    m_Localized: 'Luka: Tak, pogodziłem się z tym, ale było ciężko.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054968
    m_Localized: 'Luka: Obwiniałem się przez długi czas. Myślałem często, co by było, gdybym wrócił kilka minut prędzej, czy byłoby inaczej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054969
    m_Localized: 'Luka: Wina jest pożywką smutku. A w życiu… potrzebne jest przebaczenie. Pojąłem, że stracę zmysły, jeśli sobie nie daruję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054970
    m_Localized: 'Luka: To mnie uratowało.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054971
    m_Localized: 'Luka: Wybaczyłem sobie, że nie mogę zmienić przeszłości. Wybaczyłem nawet losowi, acz okrutnemu, bo złość mnie pogrążała.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054972
    m_Localized: 'Luka: Wszystko będzie w porządeczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054973
    m_Localized: Co cię teraz motywuje?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054974
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054975
    m_Localized: 'Luka: Wierzę, że ludzie mogą być lepsi. Nawet w tym bałaganie jest szansa, aby się z niego wyrwać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054976
    m_Localized: 'Luka: Nie wierzę w cuda ani opatrzność boską. Wierzę w ludzi i w to, jak się wzajemnie wspieramy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054977
    m_Localized: 'Luka: Ktoś wyciąga upadających ku górze. Uśmiecha się w zły dzień. Dzieli się ostatnim kawałkiem chleba. To istota życia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054978
    m_Localized: 'Luka: To te drobne gesty. I za każdym razem, gdy ktoś spełnia dobry uczynek, wiem, że nic z tego nie poszło na marne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054979
    m_Localized: 'Luka: Wszystko będzie w porządeczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054980
    m_Localized: Chciałbyś wszystko odzyskać? Dom i rodzinę?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054981
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054982
    m_Localized: 'Luka: Jeśli mógłbym ich ponownie zobaczyć… porozmawiać, przytulić. Pewnie, że tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054983
    m_Localized: 'Luka: Ale wszystko odzyskać? Nie jestem pewien. Utrata to część życia. Jest straszna i bolesna, ale kształtuje nas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054984
    m_Localized: 'Luka: Nie zrozum mnie źle, oddałbym prawie wszystko, by spędzić z nimi jeszcze jeden dzień.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054985
    m_Localized: 'Luka: Ale jeśli to również oznaczałoby stratę tej nauki – jak wybaczać i podążać dalej… wtedy bym tego nie chciał.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054986
    m_Localized: 'Luka: Czas jest cenny. Lepiej trzymać się tego, co mamy teraz, niż pogrążyć się w tym, co straciliśmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249152
    m_Localized: 'Hunter: Bądź czujny. Każdy z nas może być Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249153
    m_Localized: Jesteś myśliwym, tak?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249154
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249155
    m_Localized: 'Hunter: Bardziej strażnikiem leśnym, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249156
    m_Localized: 'Hunter: Żyłem głęboko w lesie. Bez telewizji, tylko radio. Dzięki niemu wiem, co się wyrabia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249157
    m_Localized: 'Hunter: Uznałem, że za nic nie dam nikomu przejść przez próg. Mój dom jest moją fortecą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249158
    m_Localized: 'Hunter: A co, jeśli ktoś okazałby się Przybyszem? Ukołysze mnie miłą gadką, a potem poderżnie gardło we śnie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249159
    m_Localized: Dlaczego tu zatem przyszedłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249160
    m_Localized: Przebywanie w pojedynkę jest niebezpieczne
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249161
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249162
    m_Localized: 'Hunter: Prędzej mnie dunder świśnie, niż pozwolę temu długiemu skurczybykowi położyć na mnie łapska.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249163
    m_Localized: 'Hunter: To przez niego porzuciłem moją chatkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249164
    m_Localized: 'Hunter: Widzę to w twoich oczach. Też go widziałeś, prawda, młody?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249165
    m_Localized: Jak przetrwałeś w pojedynkę?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249166
    m_Localized: Też widziałeś tego wysokiego, bladego Przybysza?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249167
    m_Localized: 'Hunter: Wyszedłem i podołałem jakoś, czyż nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249168
    m_Localized: 'Hunter: Inaczej by mnie już robale zeżarły.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249169
    m_Localized: 'Hunter: Wcześniej myślałem, że wpuszczanie nieznajomych do środka to głupota.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249170
    m_Localized: 'Hunter: Wydawało mi się, że samemu będę bezpieczniejszy… Wtedy pojawił się ten brzydal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249171
    m_Localized: 'Hunter: Nigdy nie widziałem takiej maszkary.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249172
    m_Localized: Jak przetrwałeś w pojedynkę?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249173
    m_Localized: Też widziałeś tego wysokiego, bladego Przybysza?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249174
    m_Localized: 'Hunter: To długa historia, młody. Nie jestem dziś w humorze, by ją opowiedzieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249175
    m_Localized: 'Hunter: Poczęstuj mnie jutro piwem. Opowiem ci wszystko.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249176
    m_Localized: 'Hunter: Więc to nie tylko ja go widziałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249177
    m_Localized: 'Hunter: A jakże… widziałem go…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249178
    m_Localized: 'Hunter: Gdybyś tylko wiedział, przez co musiałem przejść, młody…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249179
    m_Localized: 'Hunter: Pogadamy o tym. Ale nie dzisiaj…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249180
    m_Localized: 'Hunter: Poczęstuj mnie jutro piwem, a wszystko opowiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249181
    m_Localized: 'Hunter: Bądź czujny. Każdy z nas może być Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249182
    m_Localized: Jak tam z tą opowieścią?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249183
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249184
    m_Localized: 'Hunter: Masz dla mnie piwo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249185
    m_Localized: Tak (podaj mu piwo)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249186
    m_Localized: 'Hunter: Co, nie masz piwa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249187
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249188
    m_Localized: Nie (nie podawaj mu piwa)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249189
    m_Localized: 'Hunter: Może być, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249190
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249191
    m_Localized: 'Hunter: Jak mówiłem, zaszyłem się w mojej chatce, nie wpuszczałem nikogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249192
    m_Localized: 'Hunter: Wtem jednego dnia przychodzi jeden gość. Zdesperowany.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249193
    m_Localized: 'Hunter: Wali w drzwi i błaga, żebym go wpuścił. Mnie z kolei jeszcze tak nie odbiło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249194
    m_Localized: 'Hunter: Był blady i roztrzęsiony, jakby zobaczył samą śmierć. Nie wiem, jak zdołał zajść tak głęboko w las.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249195
    m_Localized: 'Hunter: Nie wyglądał też na żadnego trekkingowca, więc kazałem mu, żeby poszedł won.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249196
    m_Localized: 'Hunter: Próbował wybić okno, ale oznajmiłem, że mam karabin i wtedy łobuz wziął nogi za pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249197
    m_Localized: 'Hunter: Myślałem, że pewnie już go nigdy nie zobaczę…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249198
    m_Localized: Może mogłeś mu jednak pomóc?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249199
    m_Localized: Powinieneś był go wpuścić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249200
    m_Localized: I wtedy co, młody?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249201
    m_Localized: 'Hunter: I naprowadzić cokolwiek go ścigało pod moje drzwi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249202
    m_Localized: 'Hunter: Nie, panie. Miałem dość swoich zmartwień.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249203
    m_Localized: No dobra
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249204
    m_Localized: Milczek z ciebie, nie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249205
    m_Localized: Nie zdradziłeś zbyt dużo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249206
    m_Localized: Niech zgadnę. Język ci się rozwiąże przy piwie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249207
    m_Localized: 'Hunter: Nie myśl, że jesteś jakimś bohaterem, młody. Na pewno też kazałeś niektórym pocałować klamkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249208
    m_Localized: 'Hunter: Bo w jaki inny sposób byś przeżył tak długo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249209
    m_Localized: 'Hunter: Prawda, ale to historia na jutro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249210
    m_Localized: No dobra
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249211
    m_Localized: Milczek z ciebie, nie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249212
    m_Localized: Nie zdradziłeś zbyt dużo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249213
    m_Localized: Niech zgadnę. Język ci się rozwiąże przy piwie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249214
    m_Localized: 'Hunter: Byłem pewien, że przepadnie jak kamień w wodę, lecz… w końcu mnie odnalazł.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249215
    m_Localized: 'Hunter: To opowiem jednak kiedy indziej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249216
    m_Localized: No dobra
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249217
    m_Localized: Milczek z ciebie, nie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249218
    m_Localized: Nie zdradziłeś zbyt dużo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249219
    m_Localized: Niech zgadnę. Język ci się rozwiąże przy piwie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249220
    m_Localized: 'Hunter: Przynieś mi jutro piwo, młody, to dokończę historię.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249221
    m_Localized: 'Hunter: Nie lubię mleć jęzorem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249222
    m_Localized: 'Hunter: Masz szczęście, że w ogóle otwieram gębę, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249223
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249224
    m_Localized: 'Hunter: Podaj mi jutro piwo, a opowiem resztę. Stoi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249225
    m_Localized: 'Hunter: Cierpliwości, młody. Niejedno widziałem…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249226
    m_Localized: 'Hunter: I na trzeźwo nie chcę sobie tego przypominać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249227
    m_Localized: 'Hunter: Przynieś piwo, to pogadamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249228
    m_Localized: 'Hunter: Jesteś bystry, młody, trzeba ci to przyznać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249229
    m_Localized: 'Hunter: Odzywam się tylko, gdy mam coś ważnego do powiedzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249230
    m_Localized: 'Hunter: Przynieś mi jutro piwo, a dokończę historię.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249231
    m_Localized: 'Hunter: Przykro mi, młody… na trzeźwo nie będę gadał.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249232
    m_Localized: 'Hunter: Pogadamy, jak przyniesiesz piwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249233
    m_Localized: 'Hunter: Bądź czujny. Każdy z nas może być Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249234
    m_Localized: Jak to się skończyło?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249235
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249236
    m_Localized: 'Hunter: Powiem ci, ale najpierw daj mi piwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249237
    m_Localized: Jasne (daj mu piwo)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249238
    m_Localized: 'Hunter: Co, nie masz piwa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249239
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249240
    m_Localized: Nie (nie podawaj mu piwa)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249241
    m_Localized: 'Hunter: Dzięki, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249242
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249243
    m_Localized: 'Hunter: Więc ten gość uciekł, a ja zostałem w chatce.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249244
    m_Localized: 'Hunter: Skończyło mi się drewno do kominka i musiałem pójść po więcej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249245
    m_Localized: 'Hunter: Wziąłem trochę, wróciłem… a karabin zniknął.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249246
    m_Localized: 'Hunter: Wstrząsnęło to mną. Przewróciłem wszystko do góry nogami, ale nigdzie go nie było.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249247
    m_Localized: 'Hunter: Wtedy zobaczyłem tego łajdaka za oknem. Tego samego gościa, co wcześniej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249248
    m_Localized: 'Hunter: Wyglądał inaczej… ale miał mój karabin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249249
    m_Localized: 'Hunter: Był wyższy. Skóra na nim wisiała. Cały w stroju Adama, nie licząc spodni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249250
    m_Localized: 'Hunter: Wziął karabin w obie ręce… i złamał go jak zapałkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249251
    m_Localized: 'Hunter: Wtedy stał tam i gapił się. Jakby czekał, aż mrugnę… żeby złamać mi kark.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249252
    m_Localized: 'Hunter: Nie drgnął jednak. Wciąż tylko wytrzeszczał gały… jakby to były jakieś pokręcone zawody, kto pierwszy odwróci wzrok.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249253
    m_Localized: 'Hunter: Potem… nastał świt, a bydlak przepadł.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249254
    m_Localized: 'Hunter: Nagle zrozumiałem, że pozostawanie samemu bez broni to szybka droga do piekła, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249255
    m_Localized: 'Hunter: Zaraz wstałem i wyniosłem się, zanim słońce całkiem wzeszło.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249256
    m_Localized: 'Hunter: I tak trafiłem do ciebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249257
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249258
    m_Localized: 'Hunter: Obyś ty miał szansę pociągnąć za spust, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249259
    m_Localized: 'Hunter: Kto wie, może padną od kuli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249260
    m_Localized: Dlaczego cię nie zabił?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249261
    m_Localized: Myślisz, że można go jakoś zabić?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249262
    m_Localized: Wyciął w pień cały oddział
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249263
    m_Localized: 'Hunter: Nie wiem, młody. Przełamał mój karabin jak gałązkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249264
    m_Localized: 'Hunter: Z pewnością mnie mógł zrobić to samo w mgnieniu oka… ale tego nie zrobił.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249265
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249266
    m_Localized: 'Hunter: Może lubi tak się z nami bawić. Jak kot z myszą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249267
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249268
    m_Localized: 'Hunter: Wiesz, rzadko trzęsę przed czymś portkami. Ale ten blady skurczybyk…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249269
    m_Localized: 'Hunter: Boję się go, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249270
    m_Localized: 'Hunter: Chciałbym w to wierzyć, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249271
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249272
    m_Localized: 'Hunter: Wiesz, jak mówią: „jeśli leci jucha, przyjdzie i kostucha”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249273
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249274
    m_Localized: 'Hunter: Psiakrew… Jeśli rozniósł cały oddział… nie mamy najmniejszych szans.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249275
    m_Localized: 'Hunter: Jeśli tylko zechce, rozwali całe do miejsce w drobny mak.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249276
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249277
    m_Localized: 'Hunter: Wiesz, rzadko trzęsę przed czymś portkami. Ale ten blady skurczybyk…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249278
    m_Localized: 'Hunter: Boję się go, młody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249279
    m_Localized: 'Hunter: Nie ma piwa, nie ma historii.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249280
    m_Localized: 'Hunter: Nie będę gadał na trzeźwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249281
    m_Localized: 'Hunter: Młody, jeśli chcesz usłyszeć resztę… przynieś mi piwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443456
    m_Localized: 'Cold: Chciałbym poczuć trochę c‑ciepła…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443457
    m_Localized: Nie zdejmuje pan kurtki?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443458
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443459
    m_Localized: 'Cold: N‑nie, bo przeraża mnie jedna myśl.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443460
    m_Localized: 'Cold: Co się stanie, jeśli ją z‑z‑zdejmę? Nie mogę się rozgrzać nawet w c‑cieple.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443461
    m_Localized: 'Cold: Gdy zdejmę kurtkę, czy u‑umrę z z‑zimna?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443462
    m_Localized: 'Cold: Albo gorzej – pozostanę żywy, ale jeszcze bardziej z‑z‑zziębnięty?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443463
    m_Localized: Nie poci się pan przez to?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443464
    m_Localized: To wtedy się pan nie kąpie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443465
    m_Localized: 'Cold: N‑nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443466
    m_Localized: 'Cold: Pot s‑schładza ciało.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443467
    m_Localized: 'Cold: A mnie chyba nie może być z‑z‑zimniej…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443468
    m_Localized: 'Cold: Nie odpowiem na to pytanie. P‑przykro mi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443469
    m_Localized: 'Cold: Chciałbym poczuć trochę c‑ciepła…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443470
    m_Localized: Ma pan jakiś pomysł, żeby się rozgrzać?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443471
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443472
    m_Localized: 'Cold: Hmm… Nie wydaje mi się, żebym mógł coś z tym zrobić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443473
    m_Localized: 'Cold: Gorąca kąpiel tylko mnie parzy, a nie rozgrzewa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443474
    m_Localized: 'Cold: Wie pan…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443475
    m_Localized: 'Cold: Przyszła mi do głowy pewna metafora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443476
    m_Localized: 'Cold: Proszę sobie wyobrazić głębię kosmosu. Bezgraniczną i z‑zamarzniętą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443477
    m_Localized: 'Cold: Rodzą się galaktyki. Umierają g‑gwiazdy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443478
    m_Localized: 'Cold: A ja tylko obserwuję…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443479
    m_Localized: 'Cold: Nigdy nie poczuję spiekoty s‑s‑słońca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443480
    m_Localized: 'Cold: Ani c‑ciepła uścisku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443481
    m_Localized: 'Cold: Zdaje się, że ani kosmos, ani społeczność mnie nie potrzebują.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443482
    m_Localized: 'Cold: Chciałbym poczuć trochę c‑ciepła…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443483
    m_Localized: Gdy się poznaliśmy, wspominał pan, że chce się czymś podzielić. Co to było?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443484
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443485
    m_Localized: 'Cold: Hmm… Nie jestem pewien, czy chcę teraz o tym rozmawiać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443486
    m_Localized: 'Cold: Myślałem o czymś od dłuższego cz‑czasu. Może dlatego… tak mi z‑zimno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443487
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443488
    m_Localized: 'Cold: Z trudem o tym wspominam, ale jeśli tego nie powiem, to nie wyrobię…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443489
    m_Localized: 'Cold: Ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443490
    m_Localized: 'Cold: Powiem p‑panu jutro. Wtedy raczej będę gotów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443491
    m_Localized: 'Cold: Chciałbym poczuć trochę c‑ciepła…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443492
    m_Localized: Zatem, co pan ukrywa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443493
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443494
    m_Localized: 'Cold: Tak, właśnie miałem z‑zdradzić panu sekret.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443495
    m_Localized: 'Cold: Chyba jestem gotów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443496
    m_Localized: 'Cold: Zazwyczaj źle się to k‑kończy, ale może nie tym razem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443497
    m_Localized: 'Cold: Wierzę, że pod moim o‑okryciem znajduje się powód mojego z‑z‑zziębnięcia i samotności.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443498
    m_Localized: 'Cold: Proszę spojrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443499
    m_Localized: 'Cold: Nie… N‑nie znowu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443500
    m_Localized: Co pan zrobił?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443501
    m_Localized: Ma pan przerąbane
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443502
    m_Localized: 'Cold: N‑nie chciałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443503
    m_Localized: 'Cold: Zdawało mi się, że tu będzie i‑i‑inaczej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443504
    m_Localized: 'Cold: Ale n‑nigdy nie jest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443505
    m_Localized: 'Cold: Nie chciałem t‑tego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443506
    m_Localized: 'Cold: Przyrzekam, że n‑nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443507
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443508
    m_Localized: Wyrzuć go
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443509
    m_Localized: 'Cold: Z‑znowu tak, jak kiedyś…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443510
    m_Localized: 'Cold: Czemuż myślałem, że tym razem b‑będzie inaczej?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443511
    m_Localized: 'Cold: P‑proszę o rozwagę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443512
    m_Localized: 'Cold: Nie zrobiłem tego z‑złośliwie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443513
    m_Localized: 'Cold: Nigdy nie miałem t‑t‑takiego zamiaru.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443514
    m_Localized: Zastrzel go
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443515
    m_Localized: Wyrzuć go
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443516
    m_Localized: 'Cold: Może… tak będzie n‑najlepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443517
    m_Localized: 'Cold: Nigdy więcej z‑z‑zimna ani samotności.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443518
    m_Localized: 'Cold: Ja tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443519
    m_Localized: 'Cold: Nie zrobiłem tego c‑celowo, tak myślę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443520
    m_Localized: 'Cold: W tej sytuacji?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443521
    m_Localized: 'Cold: Zastrzelenie m‑mnie byłoby miłosierdziem. Niestety wciąż odczuwam b‑b‑ból.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443522
    m_Localized: 'Cold: W s‑słońcu będę się dłużej męczył.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443523
    m_Localized: 'Cold: Czy mogę chociaż zostać do z‑zmroku?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443524
    m_Localized: Precz, teraz
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443525
    m_Localized: No dobra, ale nie cwaniakuj
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443526
    m_Localized: 'Cold: Rozumiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443527
    m_Localized: 'Cold: W‑wybacz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443528
    m_Localized: 'Cold: Może słońce mnie ogrzeje. Ostatni r‑r‑raz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443529
    m_Localized: 'Cold: Dz‑dziękuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443530
    m_Localized: 'Cold: Wiem, że mnie pan nie cierpi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443531
    m_Localized: 'Cold: J‑jednak…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443532
    m_Localized: 'Cold: P‑przykro mi. Nie chciałem tego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832064
    m_Localized: 'Daughter: A czy… uhm… czy mógłby pan zaprosić moją koleżankę?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832065
    m_Localized: 'Daughter: Kiedy zapraszają ją dorośli, rodzice pozwalają jej przyjść… A jeśli ja, to mnie zbywają…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832066
    m_Localized: 'Daughter: To chyba jest jej numer telefonu: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832067
    m_Localized: 'Greatmother: Och, cukiereczku… Proszę, nie wpuszczaj ty nikogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832068
    m_Localized: Dlaczego FEMA wyrzuciła cię z domu bez słowa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832069
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832070
    m_Localized: 'Greatmother: Żebym to ja wiedziała, cukiereczku. Te skafandrzaki… trudno się na nich poznać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832071
    m_Localized: 'Greatmother: Tylko maszerują tak w kółko i wykrzykują rozkazy…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832072
    m_Localized: 'Greatmother: Za kogoż oni się mają, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832073
    m_Localized: 'Greatmother: Na pewno same głupie trepy, tylko udają jakichś ważniaków.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832074
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832075
    m_Localized: 'Greatmother: Do ciebie też przyleźli?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832076
    m_Localized: Tak
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832077
    m_Localized: Jeden z nich często się tu kręci
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832078
    m_Localized: 'Greatmother: Niech to gęś kopnie! Trzeba by ich wywlec z kombinezonów i rychło wpędzić do tych ich kojców!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832079
    m_Localized: 'Greatmother: Przekonaliby się tedy na własnej skórze, jak się sprawy mają u normalnych ludzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832080
    m_Localized: 'Greatmother: Zaczęli oni zajmować teraz całe budynki?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832081
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832082
    m_Localized: 'Greatmother: Matki ich wtenczas źle wychowały.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832083
    m_Localized: 'Greatmother: Jedno najście ja rozumiem, ale wciąż przyłazić jak natręty…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832084
    m_Localized: 'Greatmother: Wstydu oni nie mają.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832085
    m_Localized: 'Greatmother: Och, cukiereczku… Proszę, nie wpuszczaj ty nikogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832086
    m_Localized: Czy wzięli tobie kogoś z rodziny?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832087
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832088
    m_Localized: 'Greatmother: Olaboga, nikt mnie od wieków nie pytał o rodzinkę, cukiereczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832089
    m_Localized: 'Greatmother: Zwą mnie „Wielką Mamuśką”, bo tyle narobiłam dzieciaków.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832090
    m_Localized: 'Greatmother: Niech Bóg je błogosławi…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832091
    m_Localized: 'Greatmother: Ledwo się w chałupie mieścimy!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832092
    m_Localized: 'Greatmother: Szkraby jeno chowają się za zamkniętymi drzwiami przed tymi dziwadłami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832093
    m_Localized: Nie odpowiedziałaś na moje pytanie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832094
    m_Localized: Więc uprowadzili tobie kogoś bliskiego?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832095
    m_Localized: 'Greatmother: Och…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832096
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832097
    m_Localized: 'Greatmother: Tak ja się zaraz rozgadałam, że zgubiłam wątek, cukiereczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832098
    m_Localized: 'Greatmother: Te wieprze nieczyste w kombinezonach porwały mi wszystkie dzieci…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832099
    m_Localized: 'Greatmother: Ale na sucho im to nie ujdzie, broń Boże.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832100
    m_Localized: 'Greatmother: A tobie kogoś zabrali, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832101
    m_Localized: Nie mam żadnej rodziny
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832102
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832103
    m_Localized: 'Greatmother: Och…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832104
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832105
    m_Localized: 'Greatmother: Tak ja się rozgadałam, że zaraz straciłam wątek, cukiereczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832106
    m_Localized: 'Greatmother: Te wieprze nieczyste w kombinezonach porwały mi wszystkie dzieci…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832107
    m_Localized: 'Greatmother: A tobie kogoś zabrali, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832108
    m_Localized: Nie mam żadnej rodziny
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832109
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832110
    m_Localized: 'Greatmother: Nie? To po co ci taka niemożebna chata?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832111
    m_Localized: 'Greatmother: I żyjesz tu ty sam jak palec, cukiereczku… Tak nie może być…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832112
    m_Localized: 'Greatmother: Duża chałupa to i liczna rodzina musi być, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832113
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832114
    m_Localized: 'Greatmother: W porządeczku, nie będę ja się wtryniać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832115
    m_Localized: 'Greatmother: Chciałabym ja odzyskać moje dzieciaczki ze stref kwarantanny…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832116
    m_Localized: 'Greatmother: Nic ci nie zrobili?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832117
    m_Localized: 'Greatmother: Gdzie są tedy twoi bliscy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832118
    m_Localized: 'Greatmother: Przecież nie postawił ty takiej przepastnej chałupy tylko dla siebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832119
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832120
    m_Localized: 'Greatmother: W porządeczku, nie będę ja się wtryniać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832121
    m_Localized: 'Greatmother: Chcę ja tylko wydostać moje dzieciaczki ze stref kwarantanny…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832122
    m_Localized: 'Greatmother: Och, cukiereczku… Proszę, nie wpuszczaj ty nikogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832123
    m_Localized: W jaki sposób chcesz odzyskać rodzinę?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832124
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832125
    m_Localized: 'Greatmother: Wcale ja nie zamierzam! Same się wydostaną, cukiereczku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832126
    m_Localized: Co masz na myśli?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832127
    m_Localized: Same?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832128
    m_Localized: 'Greatmother: Mogą wypełznąć przez błoto… na drugą stronę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832129
    m_Localized: 'Greatmother: Ogrodzenia i druty to bułka z masłem dla moich maluchów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832130
    m_Localized: 'Greatmother: A jeśli dołem im nie pójdzie, rozpierniczą całą strefę w drzazgi. Moje kochaniutkie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832131
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832132
    m_Localized: 'Greatmother: Pewno już lezą. „Wielka Mamuśka” wie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832133
    m_Localized: O czym ty pleciesz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832134
    m_Localized: Upadłaś na głowę?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832135
    m_Localized: Możesz wyjaśnić?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832136
    m_Localized: (Zabij ją)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832137
    m_Localized: 'Greatmother: Wszystkie wasze mury runą, gdy przyjdzie czas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832138
    m_Localized: 'Greatmother: Przyjdzie śmierć, trup będzie ścielił się gęsto… I, miluśki… Wtedy przybędzie on, żądny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832139
    m_Localized: 'Greatmother: Wtedy te skafandrzaki przestaną się przejmować moją gromadką. Będą oni mieli ważniejszą sprawę na głowie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832140
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832141
    m_Localized: 'Greatmother: Pewno już lezą. „Wielka Mamuśka” wie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832142
    m_Localized: O czym ty pleciesz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832143
    m_Localized: Upadłaś na głowę?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832144
    m_Localized: Co masz na myśli?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832145
    m_Localized: (Zabij ją)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832146
    m_Localized: 'Greatmother: Rozniesiemy w pył te wasze nory…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832147
    m_Localized: 'Greatmother: Skruszą się ściany… ulice spłyną juchą… z waszych trupów ułożymy hałdy…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832148
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832149
    m_Localized: 'Greatmother: Słyszę ja, jak pełzną. Są tuż, tuż…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832150
    m_Localized: Co to znaczy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832151
    m_Localized: Kim jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832152
    m_Localized: Czy jesteś Przybyszką?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832153
    m_Localized: (Zabij ją)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832154
    m_Localized: 'Greatmother: Palone mięsiwo tak pysznie pachnie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832155
    m_Localized: 'Greatmother: Skafandrzaki smażą się niezgorzej. Są odrobinę chrupiący, prawda, ale całkiem nieźli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832156
    m_Localized: 'Greatmother: A ty masz tu inne ciałka, cukiereczku. I to niemało. Moja gromadka suto tu poucztuje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832157
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832158
    m_Localized: 'Greatmother: Słyszę ja, jak pełzną. Są tuż, tuż…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832159
    m_Localized: Co to znaczy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832160
    m_Localized: Kim jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832161
    m_Localized: Czy jesteś Przybyszką?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832162
    m_Localized: (Zabij ją)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832163
    m_Localized: 'Greatmother: To miejsce zdaje się mnie idealne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832164
    m_Localized: 'Greatmother: Duży dom, prawie żadnej żywej duszyczki. Od groma miejsca dla… wszystkich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832165
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832166
    m_Localized: 'Greatmother: Słyszę ja, jak pełzną. Są tuż, tuż…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832167
    m_Localized: Co to znaczy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832168
    m_Localized: Kim jesteś?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832169
    m_Localized: Czy jesteś Przybyszką?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832170
    m_Localized: (Zabij ją)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832171
    m_Localized: 'Greatmother: Kurka wodna! Ty knurze niedomyty!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832172
    m_Localized: 'Greatmother: Przylezą po was wszystkich…!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832173
    m_Localized: 'Greatmother: Gromadko, mamusia znalazła nam nowe gniazdko.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832174
    m_Localized: 'Greatmother: Przypełznijcie. Jemu ten dom już niepotrzebny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832175
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832176
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832177
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832178
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832179
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832180
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832181
    m_Localized: 'Greatmother: Wielka mamuśka chce zobaczyć swoje szkraby.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832182
    m_Localized: 'Greatmother: Chodźcie, ten dom zdaje się być w sam raz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832183
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832184
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832185
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832186
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832187
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832188
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832189
    m_Localized: 'Greatmother: Pełznijcie, moje dzieciątka. Mamusia tu jest! Znalazłam ja wam nowy dom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832190
    m_Localized: 'Greatmother: Taki obszerny. Taki odpowiedni. Taki pusty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832191
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832192
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832193
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832194
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832195
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832196
    m_Localized: (ZABIJ JĄ)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832197
    m_Localized: 'Greatmother: KURZA STOPA! Dajże mi to! Nienawidzicie tego!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832198
    m_Localized: 'Greatmother: Chcecie przecież, aby spłonęło!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026368
    m_Localized: 'Greatmother: DAJŻE TO MAMUŚCE!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026369
    m_Localized: 'Greatmother: No, biedulko… Wiem ja, czego ci trzeba…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026370
    m_Localized: 'Greatmother: …śmierci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026371
    m_Localized: 'Wolfhound: Masz jakiś problem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220672
    m_Localized: Dlaczego porównujesz ludzi do zwierząt?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220673
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220674
    m_Localized: 'Wolfhound: Niech no zadam ci pytanie. Czym naprawdę jesteśmy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220675
    m_Localized: 'Wolfhound: Zabijamy i pożeramy swoje ofiary. Snu to nam nie spędza z powiek. Tak już jest w przyrodzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220676
    m_Localized: 'Wolfhound: Ale społeczność, nie? Trzymała nas na smyczy. Na szczęście te dni są za nami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220677
    m_Localized: Co masz na myśli?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220678
    m_Localized: Pasuje ci obecny stan rzeczy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220679
    m_Localized: 'Wolfhound: To proste jak świński ogon. Apatyczną społeczność zastąpiły jasne i zrozumiałe reguły.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220680
    m_Localized: 'Wolfhound: Są watahy, które mają swoje osobniki alfa. Jeśli ktoś grozi watasze, jest likwidowany. Takie zasady szanuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220681
    m_Localized: 'Wolfhound: Najgorsze są jednak owce w wilczej skórze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220682
    m_Localized: Myślisz, że watahy są lepsze od społeczeństwa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220683
    m_Localized: Chciałeś może powiedzieć „wilki w owczej skórze”?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220684
    m_Localized: 'Wolfhound: Nie, brachu. Świetnie, że ludziska już zazwyczaj nie udają, kim są, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220685
    m_Localized: 'Wolfhound: Ale te owce… wszystko mącą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220686
    m_Localized: 'Wolfhound: Chowają się pod wilczą skórą i udają. Pozorują instynkty prawdziwych facetów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220687
    m_Localized: 'Wolfhound: Czają się przy ziemi i bawią w kotka i myszkę, zamiast stanąć do walki twarzą w twarz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220688
    m_Localized: 'Wolfhound: Ale jeśli masz własną watahę, nie? Wtedy wiesz, jak wyłuskiwać pozorantów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220689
    m_Localized: Myślisz, że watahy są lepsze od społeczeństwa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220690
    m_Localized: Chciałeś może powiedzieć „wilki w owczej skórze”?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220691
    m_Localized: 'Wolfhound: A ty nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220692
    m_Localized: 'Wolfhound: W „normalnej” społeczności nie ma bata, że poznasz się na tych owcach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220693
    m_Localized: 'Wolfhound: Za dużo bezsensownej gadki, za dużo reguł. Wszyscy uwikłani w dyskusję, a nie w czyny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220694
    m_Localized: 'Wolfhound: Dlatego alfy są konieczne. Żadnych pytań, żadnego głosowania. Alfa każe, a ty to, psiakrew, robisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220695
    m_Localized: 'Wolfhound: Alfa nie zdradza słabości. Inaczej wataha nie przetrwa. Proste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220696
    m_Localized: 'Wolfhound: Nie, mówię o tych cykorach, których zwiecie „Przybyszami”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220697
    m_Localized: 'Wolfhound: Zaszyli się pod ziemią jak szczury, czekając, aż będziemy łatwiejszym celem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220698
    m_Localized: 'Wolfhound: Potem wyleźli i maskują się ludzkim sumieniem. Żerują na współczuciu, by ciężej nam było ich wyrżnąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220699
    m_Localized: 'Wolfhound: Nie bez powodu szczerzymy kły. Potrzebują przypomnienia, że to my tu jesteśmy bestiami, inaczej nas wykończą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220700
    m_Localized: 'Wolfhound: Masz jakiś problem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220701
    m_Localized: Czemu gapisz się na moją broń?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220702
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220703
    m_Localized: 'Wolfhound: Widzę, żeś alfa, brachu. Trzymasz wszystkich w ryzach. Pokazujesz, że to ty tu rządzisz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220704
    m_Localized: 'Wolfhound: Ładną masz miejscówkę. Przestronna. Ludzie często przychodzą. Twoi goście jednak…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220705
    m_Localized: Co z nimi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220706
    m_Localized: Myślisz, że niektórzy są Przybyszami?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220707
    m_Localized: 'Wolfhound: Zebrałeś samych słabeuszy, nie? Mięczaków.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220708
    m_Localized: 'Wolfhound: Powiedz mi, na co komu starcy, młodzież lub chorzy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220709
    m_Localized: 'Wolfhound: Tylko silni tworzą watahę. Tędy droga, aby przeżyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220710
    m_Localized: Co mam wtedy zrobić?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220711
    m_Localized: Mam ich wyrzucić?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220712
    m_Localized: 'Wolfhound: Nie obawiam się tu owiec w wilczych skórach, brachu, jeno słabych wilków.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220713
    m_Localized: 'Wolfhound: Twoja wataha nie ma oparcia. Ludzie przychodzą i odchodzą, jak im się podoba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220714
    m_Localized: 'Wolfhound: Wybierz najsilniejszych i trzymaj się z nimi. Inaczej są tylko ciężarem. Proste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220715
    m_Localized: Co mam wtedy zrobić?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220716
    m_Localized: Mam ich wyrzucić?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220717
    m_Localized: 'Wolfhound: Czas wyplenić słabeuszy, miśku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220718
    m_Localized: 'Wolfhound: Pozabijaj ich. Na oczach wszystkich. Ku przestrodze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220719
    m_Localized: 'Wolfhound: Tak pochwycisz ich w garść i pokażesz, kto tu rządzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220720
    m_Localized: 'Wolfhound: Każdego, kto nawet nie mrugnie na ten widok… tych chcesz w swojej watasze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220721
    m_Localized: 'Wolfhound: Oni zostają.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220722
    m_Localized: Nie jestem mordercą
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220723
    m_Localized: Zabijam tylko Przybyszy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220724
    m_Localized: 'Wolfhound: Nie rób nic, a ucierpi twój autorytet, brachu. Wyzwą cię od słabych.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220725
    m_Localized: 'Wolfhound: Litość kryje słabość.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220726
    m_Localized: 'Wolfhound: Bądź bezlitosny. Przybysz? Bum! Słaby? Bum! Stary? Bum!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220727
    m_Localized: 'Wolfhound: Tak sprawisz, że będą przed tobą truchleć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220728
    m_Localized: Nie jestem mordercą
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220729
    m_Localized: Zabijam tylko Przybyszy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220730
    m_Localized: 'Wolfhound: Kogo starasz się oszukać, miśku? Widzę to w twoich oczach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220731
    m_Localized: 'Wolfhound: Jesteś kilerem. I to wyrachowanym. Nie udawaj, że masz czyste rączki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220732
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220733
    m_Localized: 'Wolfhound: Zwykłem być królem tych ulic.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220734
    m_Localized: 'Wolfhound: Ludzie drżeli przede mną i szanowali mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220735
    m_Localized: 'Wolfhound: Myślałeś kiedyś, jak szybko gnije dusza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220736
    m_Localized: 'Wolfhound: Ja jestem zepsuty od dawna – wrzody, kiła i mogiła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220737
    m_Localized: 'Wolfhound: Jednego razu taksiarz odmówił mi taryfy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220738
    m_Localized: 'Wolfhound: Jeśli bym mu odpuścił, ucierpiałaby moja reputacja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220739
    m_Localized: 'Wolfhound: Pogruchotałem mu więc wszystkie kości.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220740
    m_Localized: 'Wolfhound: Jego dzieciak jednak zapamiętał tę lekcję, a ludzie wciąż mnie szanowali.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220741
    m_Localized: 'Wolfhound: Coś ci powiem. Byłoby ci lepiej, gdybyś przestał matkować cherlakom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220742
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220743
    m_Localized: 'Wolfhound: Kiedyś byłem szefem tej dzielnicy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220744
    m_Localized: 'Wolfhound: Ludzie drżeli przede mną i szanowali mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220745
    m_Localized: 'Wolfhound: Myślałeś kiedyś, jak szybko gnije dusza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220746
    m_Localized: 'Wolfhound: Ja jestem zepsuty od dawna – wrzody, kiła i mogiła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220747
    m_Localized: 'Wolfhound: Jednego razu taksiarz odmówił mi taryfy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220748
    m_Localized: 'Wolfhound: Jeśli bym mu odpuścił, ucierpiałaby moja reputacja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220749
    m_Localized: 'Wolfhound: Pogruchotałem mu więc wszystkie kości.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220750
    m_Localized: 'Wolfhound: Jego dzieciak jednak zapamiętał tę lekcję, a ludzie wciąż mnie szanowali.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220751
    m_Localized: 'Wolfhound: Masz jakiś problem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220752
    m_Localized: Wciąż mówisz o watahach. Dlaczego nie masz swojej?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220753
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220754
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220755
    m_Localized: 'Wolfhound: A ty czemu masz swoją?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220756
    m_Localized: Żeby mnie nie capnął ten wysoki i blady Przybysz
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220757
    m_Localized: Staram się pomagać innym
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220758
    m_Localized: Lubię mieć towarzystwo
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220759
    m_Localized: Ci ludzie potrzebują przywódcy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220760
    m_Localized: Ja zapytałem pierwszy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220761
    m_Localized: 'Wolfhound: Zebrałeś ich tu wszystkich, żeby chronić swój tyłek?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220762
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220763
    m_Localized: 'Wolfhound: Nie brzmisz jak alfa, ale jak jakieś ostatnie chuchro z miotu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220764
    m_Localized: 'Wolfhound: Ta wataha potrzebuje kogoś silnego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220765
    m_Localized: 'Wolfhound: Zdaje się, że muszę zająć twoje miejsce. Żaden z ciebie lider.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220766
    m_Localized: 'Wolfhound: Szczytny cel. Trochę głupi, ale szczytny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220767
    m_Localized: 'Wolfhound: Nie uratujesz wszystkich. Prędzej czy później zaczniesz ich odsyłać. Proste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220768
    m_Localized: 'Wolfhound: Ale brzmisz jak prawdziwa alfa. Mocny zawodnik. Nie kwestionuję tego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220769
    m_Localized: 'Wolfhound: Tylko to? Nie masz jaj, by posiedzieć samemu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220770
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220771
    m_Localized: 'Wolfhound: Alfa nigdy by tak nie powiedziała. Jesteś kolejną owcą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220772
    m_Localized: 'Wolfhound: O, tako rzecze fest twardziel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220773
    m_Localized: 'Wolfhound: Tylko głupiec by to zakwestionował, brachu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220774
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220775
    m_Localized: 'Wolfhound: Nie odpowiem na to. Im mniej wiesz, tym lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220776
    m_Localized: 'Wolfhound: I tak już zdradziłem więcej, niż powinienem. Teraz twoja kolej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220777
    m_Localized: 'Wolfhound: Jeśli nie chcesz przewodzić tej watasze, ja, psiamać, będę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220778
    m_Localized: Chuj z tobą!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220779
    m_Localized: Myślisz, że jesteś większy kozak ode mnie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220780
    m_Localized: (Wyciągnij broń)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220781
    m_Localized: Pal wrotki, zanim oberwiesz
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220782
    m_Localized: 'Wolfhound: LUZUJ, SZCZENIAKU. Już dla mnie nie istniejesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220783
    m_Localized: 'Wolfhound: Jeśli taki wódz z ciebie, jak z koziej dupy trąbą, czemu się za to wziąłeś, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220784
    m_Localized: 'Wolfhound: Precz, albo sam cię wykończę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220785
    m_Localized: 'Wolfhound: Wiem, co to wataha. Żyję według reguł.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220786
    m_Localized: 'Wolfhound: Jeśliś taki miękki, żadna z ciebie alfa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220787
    m_Localized: 'Wolfhound: Precz, albo sam cię wykończę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220788
    m_Localized: 'Wolfhound: A więc to tak, co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220789
    m_Localized: 'Wolfhound: Też mam klamkę, leszczu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220790
    m_Localized: 'Wolfhound: Lepiej odłóż swoją. Zakończmy to bez bajzlu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220791
    m_Localized: (Zastrzel go)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220792
    m_Localized: (Odłóż broń)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220793
    m_Localized: 'Wolfhound: Giń, psie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220794
    m_Localized: 'Wolfhound: Cwane szczenię… naprawdę mi odpaliłeś.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220795
    m_Localized: 'Wolfhound: …dobry piesek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220796
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220797
    m_Localized: 'Wolfhound: Ale powinieneś mnie dobić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220798
    m_Localized: 'Wolfhound: (Korzysta z okazji i wyciąga broń).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220799
    m_Localized: 'Wolfhound: (Mierzy w ciebie).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220800
    m_Localized: 'Wolfhound: (Całe szczęście w porę łapiesz za broń i strzelasz).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220801
    m_Localized: 'Doctor: Słucham.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220802
    m_Localized: Co się stało ze szpitalami?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220803
    m_Localized: Chcę się panu przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220804
    m_Localized: 'Doctor: Och… To było okropne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220805
    m_Localized: 'Doctor: Kiedy sytuacja zaczęła się psuć, ludzie tłumem rzucili się do szpitali. Byli zdesperowani wiedzieć, czy są Przybyszami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220806
    m_Localized: 'Doctor: Staraliśmy się im wytłumaczyć, że nie wiemy, jak to sprawdzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220807
    m_Localized: 'Doctor: Nikt nas nie słuchał. Stali się natarczywi i uniemożliwiali opiekę nad normalnymi pacjentami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220808
    m_Localized: 'Doctor: Koniec końców zjawiła się FEMA. Uznali… że ciżba stanowi zagrożenie dla zahamowania epidemii…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220809
    m_Localized: 'Doctor: Zabrali więc wszystkich pacjentów do stref kwarantanny, a szpitale… zostały pozamykane.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220810
    m_Localized: Przez FEMA nie ma pan pracy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220811
    m_Localized: Zdaje się, że FEMA postąpiła słusznie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220812
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220813
    m_Localized: 'Doctor: Prawdę mówiąc… po zamknięciu szpitali zająłem się triażem w jednej ze stref kwarantanny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220814
    m_Localized: Dlaczego pan to zrobił?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220815
    m_Localized: Wtedy… jest pan kolejnym draniem z FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220816
    m_Localized: 'Doctor: Wydaje się panu, że należało tak wszystkich zebrać do kupy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220817
    m_Localized: 'Doctor: Czy te tak zwane „objawy” nie wydają się panu absurdalne? To tylko najzwyklejsze ludzkie cechy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220818
    m_Localized: 'Doctor: To kompletne brednie! Białe zęby znaczą, że ktoś jest Przybyszem? Nie ma na to dowodów!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220819
    m_Localized: 'Doctor: Mówię panu, oni coś przed nami ukrywają…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220820
    m_Localized: 'Doctor: Prawdę mówiąc… po zamknięciu szpitali zająłem się triażem w jednej ze stref kwarantanny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220821
    m_Localized: 'Doctor: Miałem nadzieję dowiedzieć się czegoś na temat Przybyszy i towarzyszącym objawom. Spełzło to na niczym.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220822
    m_Localized: Dlaczego pan to zrobił?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220823
    m_Localized: Wtedy… jest pan kolejnym draniem z FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220824
    m_Localized: 'Doctor: Chciałem… wciąż leczyć ludzi. Takie mam powołanie. Nie mogę zwyczajnie przestać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220825
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220826
    m_Localized: 'Doctor: Być może… Nie. Proszę mi wybaczyć, ale nie jestem gotów o tym mówić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220827
    m_Localized: 'Doctor: Nie zna pan całej historii, a pana słowa sprawiają mi przykrość.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220828
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220829
    m_Localized: 'Doctor: Być może… Nie. Proszę mi wybaczyć, ale nie jestem gotów o tym mówić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220830
    m_Localized: 'Doctor: Słucham.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220831
    m_Localized: Co chciał mi pan powiedzieć?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220832
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220833
    m_Localized: 'Doctor: Czy mogę zapytać, co pan myśli na temat FEMA?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220834
    m_Localized: FEMA robi dobrą robotę
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220835
    m_Localized: Nie są godni zaufania
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220836
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220837
    m_Localized: 'Doctor: Wielka szkoda. Uważam zupełnie inaczej.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220838
    m_Localized: 'Doctor: Pracowałem dla nich przez jakiś czas, ale nie mam powodów im ufać. Zwłaszcza po tym, co widziałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220839
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220840
    m_Localized: 'Doctor: Z własnego doświadczenia wiem, że lekarze w tej organizacji trzymani są w niepewności.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220841
    m_Localized: 'Doctor: Czy naprawdę ufa pan ugrupowaniu, które nie może wyjaśnić, skąd się biorą objawy ani co oznaczają?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220842
    m_Localized: 'Doctor: Po tym wszystkim… jak pan może im ufać?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220843
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220844
    m_Localized: 'Doctor: Muszę przyznać, że miałem o panu lepsze mniemanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220845
    m_Localized: 'Doctor: Dobrze, też jestem tego zdania.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220846
    m_Localized: 'Doctor: Szczerze, sam nie rozumiem ich motywacji nawet po pewnym czasie pracy dla nich.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220847
    m_Localized: 'Doctor: Cokolwiek jest ich celem, zdecydowałem się leczyć ludzi na własną rękę wbrew ich zaleceniom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220848
    m_Localized: 'Doctor: Problemem był przepływ informacji. Nie było żadnego. Zero.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220849
    m_Localized: 'Doctor: Nie powiedzieli nam, skąd się wzięły te „objawy” ani co mają oznaczać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220850
    m_Localized: 'Doctor: Dali nam tylko listę wytycznych, kogo orzekać Przybyszem, a kogo przepuszczać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220851
    m_Localized: 'Doctor: Po tym przestałem czuć się lekarzem, a zacząłem coś jakby strażnikiem granicznym przybijającym paszporty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220852
    m_Localized: 'Doctor: Począłem fałszować raporty i pomagać ludziom uciekać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220853
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220854
    m_Localized: 'Doctor: Na pewno ma pan pytania. Jeśli nie ma pan nic przeciwko, zachowajmy je na jutro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713912
    m_Localized: 'Doctor: Przepraszam, ale nie chcę już dziś więcej rozmawiać.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713913
    m_Localized: 'Doctor: Wtem zdecydowałem opuścić szeregi tej organizacji.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220855
    m_Localized: 'Doctor: Słucham.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220856
    m_Localized: Dlaczego nie jest pan nadal w strefie kwarantanny?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220857
    m_Localized: Chcę się panu przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220858
    m_Localized: 'Doctor: Był taki… incydent…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220859
    m_Localized: 'Doctor: Słońce wschodziło, a ja szedłem do domu, gdy zawołał mnie jeden z oficerów FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220860
    m_Localized: 'Doctor: Serce mi przyspieszyło i niemal ugięły się pode mną kolana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220861
    m_Localized: 'Doctor: Krzyknął, że mam się odwrócić. W tamtej chwili pojednałem się już z Bogiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220862
    m_Localized: 'Doctor: Wymierzył mi karabinem w nogi i kazał się nie ruszać. Gapił się, a potem…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220863
    m_Localized: 'Doctor: Rozkazał, abym wystawił język, żeby mógł sprawdzić, czy jestem Przybyszem. Usłuchałem, przerażony, że mnie zastrzeli…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220864
    m_Localized: 'Doctor: Wtem… roześmiał się. Rzekł, że straszny ze mnie konował, skoro nie wiem, że język nie jest objawem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220865
    m_Localized: 'Doctor: Nigdy w życiu tak się nie bałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220866
    m_Localized: 'Doctor: W tamtej chwili nie myślałem o ratowaniu kogokolwiek lub czegokolwiek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220867
    m_Localized: 'Doctor: Zwyczajnie uciekłem. Jak tchórz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220868
    m_Localized: 'Doctor: Taka hańba… jest nie do zniesienia. Jak mogę spojrzeć na siebie w lustrze, wiedząc, że zostawiłem tam tych biednych ludzi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220869
    m_Localized: Nie obwiniam pana
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220870
    m_Localized: Wciąż pan może pomagać
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220871
    m_Localized: Jest pan żałosny. Wynocha z mojego domu
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220872
    m_Localized: 'Doctor: Dziękuję za wyrozumiałość. Trochę… ciężaru spadło mi z serca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220873
    m_Localized: 'Doctor: Wciąż jednak myślę, ileż więcej osób mógłbym uratować, gdybym został do sromotnego końca…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220874
    m_Localized: 'Doctor: Obawiam się, że nie mogę…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220875
    m_Localized: 'Doctor: Zostawiłem wszystkie przyrządy w strefie kwarantanny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220876
    m_Localized: 'Doctor: Bez nich jestem bezużyteczny…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220877
    m_Localized: 'Doctor: Wiem, że miał pan nadzieję na badanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220878
    m_Localized: 'Doctor: Ale co taki starzec jak ja, może zrobić gołymi rękami?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220879
    m_Localized: 'Doctor: Proszę wybaczyć, że pana zawiodłem. Lękam się, że jestem nieprzydatny wobec zagrożenia ze strony Przybyszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220880
    m_Localized: Proszę się nie martwić, może pan i tak zostać
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220881
    m_Localized: Krzyżyk na drogę
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220882
    m_Localized: 'Doctor: Zdaje się… że ma pan rację. Powinienem sobie pójść…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220883
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220884
    m_Localized: 'Doctor: Do widzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220885
    m_Localized: 'Doctor: Dziękuję za wyrozumiałość. Trochę… ciężaru spadło mi z serca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220886
    m_Localized: 'Doctor: Podejrzewam, że FEMA prędzej czy później wykryłaby fałszerstwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220887
    m_Localized: 'Doctor: Nie mogę jednak wyzbyć się myśli, że uratowałbym więcej osób, gdyby nie zabrakło mi odwagi…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220888
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220889
    m_Localized: 'Doctor: Niepokoję się, że pójdę z tą winą do grobu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220890
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220891
    m_Localized: 'Doctor: Zdaje się, że ma pan rację. To nie miejsce dla takiego starca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220892
    m_Localized: 'Doctor: Do widzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713914
    m_Localized: 'Doctor: Dlaczego się pan pyta? Chce się pan dowiedzieć, dlaczego nie ufam FEMA?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713915
    m_Localized: 'Doctor: Zacznijmy od hipotezy…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713916
    m_Localized: 'Doctor: Czy wierzy pan, że Przybysze to jakiś rodzaj wirusa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713917
    m_Localized: Nie wierzę w istnienie Przybyszy
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713918
    m_Localized: Nie, ale nie wiem, czym dokładnie są
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713919
    m_Localized: Tak właśnie wierzę
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713920
    m_Localized: 'Doctor: Jeśli tak pan uważa, nie widzę sensu w tej całej lustracji.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713921
    m_Localized: 'Doctor: Proszę nie próbować mnie oszukiwać.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713922
    m_Localized: 'Doctor: Zatem…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713923
    m_Localized: 'Doctor: Rozumiem. Niestety sam też nie wiem, czym naprawdę są Przybysze.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713924
    m_Localized: 'Doctor: Ale jednego jestem pewien. Nie są żadnym wirusem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713925
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713926
    m_Localized: 'Doctor: Muszę pana rozczarować. Najprawdopodobniej tak nie jest.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713927
    m_Localized: 'Doctor: Widział pan kogoś, komu zdawało się nic nie być, a potem rychło następowała zmiana? Nagle zmieniał się w Przybysza?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713928
    m_Localized: 'Doctor: Dokładnie. Nie było ani jednego takiego przypadku.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713929
    m_Localized: 'Doctor: Musi pan zrozumieć. FEMA nie kontroluje sytuacji. Tylko udają.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713930
    m_Localized: 'Doctor: Zamykają szpitale i wysyłają wszystkich do stref kwarantanny… Z jakiego powodu?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713931
    m_Localized: 'Doctor: Czy pomagają tam ludziom? Czy ktoś wyszedł stamtąd ozdrowiony?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713932
    m_Localized: 'Doctor: FEMA tylko zebrała ludzi w jedno miejsce, zamknęła ich, a teraz mają wolną rękę.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713933
    m_Localized: Dlaczego wtedy pan dla nich pracował?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713934
    m_Localized: Wystarczy tych bzdur. Marsz za drzwi
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713935
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713936
    m_Localized: 'Doctor: Nie mogłem siedzieć z założonymi rękami i przyglądać się, jak giną ludzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713937
    m_Localized: 'Doctor: Z tego powodu dołączyłem do FEMA, aby pomagać tym biednym ludziom stamtąd uciec.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713938
    m_Localized: 'Doctor: Badałem ich, diagnozowałem. Fałszowałem dokumenty, żeby mogli iść wolno.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713939
    m_Localized: Mógł pan wypuszczać także Przybyszy
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713940
    m_Localized: Jaki incydent?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713941
    m_Localized: Wielka szkoda, że stąd też będzie pan musiał uciekać
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713942
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713943
    m_Localized: 'Doctor: Żałuję, że nie wysłuchał pan całej mojej historii…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713944
    m_Localized: 'Doctor: Nie będę tu panu wadził.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713945
    m_Localized: 'Doctor: Do widzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713946
    m_Localized: 'Doctor: A co by pan wolał? Zostawiać ich tam na śmierć?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713947
    m_Localized: 'Doctor: Złożyłem przysięgę Hipokratesa. Zrobię, co w mojej mocy, by chronić życie i zdrowie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713948
    m_Localized: 'Doctor: Jednakże… sam musiałem ratować się ucieczką ze strefy kwarantanny. Ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713949
    m_Localized: 'Doctor: W strefie, do której zostałem przydzielony, miał miejsce incydent.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713950
    m_Localized: 'Doctor: Co pan…?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713951
    m_Localized: 'Doctor: Uważa pan, że nie powinienem był im pomagać? I teraz mnie pan za to wyrzuca?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713952
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713953
    m_Localized: 'Doctor: Nie sądziłem, że to powiem, ale jest pan gorszy od FEMA. Oni przynajmniej udają, że pomagają, a pan…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713954
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713955
    m_Localized: 'Doctor: Nie ma tu już dla mnie miejsca. Przeraża mnie myśl, co się stanie z pana gośćmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713956
    m_Localized: 'Doctor: Żegnam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220893
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220894
    m_Localized: Pozbyłeś się szwów z ust?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220895
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220896
    m_Localized: 'Foreigner: Fł qżprg płhbńżi!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220897
    m_Localized: 'Foreigner: Bżhbcór ńr ęhfż! R fł fcópł wóżfvśł, zł ńnrv nrv iłbęńrvqź.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220898
    m_Localized: Nie rozumiem, co mówisz
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220899
    m_Localized: Czy rozumiesz to, co mówię?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220900
    m_Localized: 'Foreigner: Nrv iłbęńrvń yru. Ył b fcń biłzrńc?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220901
    m_Localized: 'Foreigner: Ńłav dcńcgórńc qżprg dhklónc qubcp?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220902
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220903
    m_Localized: Jak niby mamy się dogadać?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220904
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220905
    m_Localized: 'Foreigner: Zuwu kłdfżibżo kł fłzrv hołdż, ż fc zuwbrvhb nż nrv ivżśłdżo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220906
    m_Localized: 'Foreigner: Ńłav d fvn hkłhlz kibcnżqńnrvq zuwu drvwbrżo, ył ńldru.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220907
    m_Localized: 'Foreigner: Jak?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220908
    m_Localized: Co „jak?”
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220909
    m_Localized: Czy chcesz o coś zapytać?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220910
    m_Localized: 'Foreigner: Dyrźa nrv iłbęńrvń, żóv ysczż ł yłg hru bżkcfżovg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220911
    m_Localized: 'Foreigner: Ńłav bżwżovg kcfżnrv…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220912
    m_Localized: 'Foreigner: Dyrźa nrv iłbęńrvń, żóv ysczż ł yłg hru bżkcfżovg.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220913
    m_Localized: 'Foreigner: Ńłav bżwżovg kcfżnrv…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220914
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220915
    m_Localized: Hej, co u ciebie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220916
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414976
    m_Localized: 'Foreigner: (Poklepujesz go po ramieniu i wskazujesz na rany przy ustach).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414977
    m_Localized: Wszystko dobrze?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414978
    m_Localized: Czy to boli?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414979
    m_Localized: 'Foreigner: Ybc ńłavhb fł kłdflibcx?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414980
    m_Localized: 'Foreigner: Dhhh‑brz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414981
    m_Localized: 'Foreigner: Dhhoo…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414982
    m_Localized: 'Foreigner: Dhoobrze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414983
    m_Localized: 'Foreigner: Ęhfż? Ńłav fł kłńłav…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414984
    m_Localized: 'Foreigner: Yrvpżd qvhfvń, ybc d ńłrń piżqę wbrvqv hru kłwłznrv.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414985
    m_Localized: 'Foreigner: Ył bż płhbńżi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414986
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414987
    m_Localized: Jak zamierzasz trafić do domu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414988
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414989
    m_Localized: 'Foreigner: (Składasz dłonie nad głową na kształt dachu).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414990
    m_Localized: 'Foreigner: Włń? Ybc kcfżhb ńnrv ł włń?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414991
    m_Localized: 'Foreigner: Kibcóvyrżovń b drbcfź wł bnżqłńvśł, żóv kłfvń fł dhbchfpł hru dcwżibcoł.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414992
    m_Localized: 'Foreigner: Nrv ńż ył ępicdżx, hcfężyqż qvhf kibvqvzżnż.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414993
    m_Localized: Jak mam cię wysłać do domu? Samolotem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414994
    m_Localized: Sprawdzałeś ceny biletów na statki?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414995
    m_Localized: 'Foreigner: (Rozpościerasz ramiona szerokim ruchem).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414996
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414997
    m_Localized: 'Foreigner: Hżńłółf? Ńcgórhb, av dyrźa óżfżqź?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414998
    m_Localized: 'Foreigner: Ńęhrżozcń hru śwbrvg włdrvwbrvx.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414999
    m_Localized: 'Foreigner: Ńłav dyrźa ńlśozcń qżpłg dilyrx wł hrvzrv.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415000
    m_Localized: 'Foreigner: (Ruszasz dłonią, przypominając kołysanie się statku na falach).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415001
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415002
    m_Localized: 'Foreigner: Kocnźx hfżfprvń?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415003
    m_Localized: 'Foreigner: Ybc dyrźa dcysłwbź d ńłibv? Ńęhbu fł hkiżdwbrx, wbrupr!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415004
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415005
    m_Localized: Dlaczego wyglądasz na podekscytowanego?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415006
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415007
    m_Localized: 'Foreigner: (Uśmiechasz się i wskazujesz palcem na swój uśmiech, a potem na niego).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415008
    m_Localized: 'Foreigner: Łys, ńżhb nż ńcgór fł.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415009
    m_Localized: 'Foreigner: Zcór d hfżnrv ńr kibvpżbżx, av kłyrźśr dyrźa pęihęqź! Wżqvhb drżiu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415010
    m_Localized: 'Foreigner: (Rusza dłonią wzdłuż drugiego ramienia, przypominając jadący pociąg).'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415011
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415012
    m_Localized: Czy ktoś może zawieźć cię do domu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415013
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415014
    m_Localized: 'Foreigner: Nrv iłbęńrvń, kibcqżyrvóę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415015
    m_Localized: 'Foreigner: Qęfił qżwu wł włńę! Ż kibcnżqńnrvq nż hfżyqu płóvqłdź.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415016
    m_Localized: 'Foreigner: Dcqvaważń fvq nłyc. Wł drwbvnrż!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415017
    m_Localized: 'Foreigner: Dwdzenia!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415018
    m_Localized: Masz na myśli pociąg?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415019
    m_Localized: Jedziesz dokądś?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415020
    m_Localized: 'Foreigner: Kibvkiżhbżń, nrv iłbęńrvń.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415021
    m_Localized: 'Foreigner: Żóv qęfił ęwżqu hru nż hfżyqu r hżń błzżybu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415022
    m_Localized: 'Foreigner: Ńłav d płmyę dilyu wł włńę kł fcń yżocń ybżhrv…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415023
    m_Localized: 'Foreigner: POWWDZHENIA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415024
    m_Localized: 'Edgar: Sonet ciszy…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415025
    m_Localized: Jak pana ręka?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415026
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415027
    m_Localized: 'Edgar: Chociaż wciąż krew w niej bije, czucia ni ciepła w niej nie ma. Jeno przejmujący ból i widmowy chłód.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415028
    m_Localized: 'Edgar: To normalne, gdyż staram się opóźnić tę przenajwspanialszą chwilę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415029
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415030
    m_Localized: 'Edgar: Miłowałem jedną białogłowę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415031
    m_Localized: 'Edgar: Ukochany mi był nasz wspólny czas. Milcząc, siedzieliśmy, acz znałem ją w pełni. Wtem myśl mnie dopadła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415032
    m_Localized: 'Edgar: Zwodzę się na manowce. Nigdy jej nie znałem. Być może takież tylko było moje marzenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415033
    m_Localized: 'Edgar: Nadziei jednak nie tracę, że nadejdzie dzień miłości silniejszej niż miłość.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415034
    m_Localized: 'Edgar: Sonet ciszy…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415035
    m_Localized: Proszę mi opowiedzieć o tej dziewczynie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415036
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415037
    m_Localized: 'Edgar: W jej oczach płonął zawsze chłód bladego księżycowego światła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415038
    m_Localized: 'Edgar: Antytezą była kataklizmu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415039
    m_Localized: 'Edgar: Piękności wybitnej nie ma bez szczypty proporcjonalnej osobliwości.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415040
    m_Localized: 'Edgar: A jam pragnienia pełny, by zdjąć jej woal tajemnicy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415041
    m_Localized: 'Edgar: Teraz mi ona ostoją.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415042
    m_Localized: 'Edgar: Moim światłem przewodnim, gdym daleko.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415043
    m_Localized: 'Edgar: Sonet ciszy…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415044
    m_Localized: Jak się państwo poznali?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415045
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415046
    m_Localized: 'Edgar: Wtem pojąłem, co mi pisane: sepsa puka do mych drzwi, niezłomna i chłodna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415047
    m_Localized: 'Edgar: Przestrach jak lód ogarnął mnie, rychło zniknę stąd, w miesięcy zaledwie kilka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415048
    m_Localized: 'Edgar: Wówczas, gdy Przybysze z ziemi byli zrodzeni… Ujrzałem ją w murach samotną.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415049
    m_Localized: 'Edgar: Dziewczę odziane w blady całun, twarzyczka portretem niebywałej urody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415050
    m_Localized: 'Edgar: W okrutnym świecie tym, gdzie człowiek człowiekowi wilkiem, żaden nie przystanął nad podobnym wdziękiem. Jeno ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415051
    m_Localized: 'Edgar: Czy padły do pańskich uszu kiedyś słowa „Zbyt cudaczny, by żyć i zbyt wyjątkowy, by umrzeć”?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415052
    m_Localized: 'Edgar: Prawda to, a jednak… Ująłem jej kruchość w ramiona i do domu zaniosłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415053
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415054
    m_Localized: 'Edgar: Gdy nadejdzie koniec, z czystym sercem powiem, że cokolwiek robiłem, robiłem to z miłości.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415055
    m_Localized: 'Edgar: Sonet ciszy…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415056
    m_Localized: Gdzie jest ta białogłowa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415057
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415058
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415059
    m_Localized: 'Edgar: Oddałem swój żywot uchwyceniu jej piękna i odczuwaniu przerażającej werwy jej milczenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415060
    m_Localized: 'Edgar: To znaczy do czasu, aż…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415061
    m_Localized: 'Edgar: Bez twarzy ludzie przyodziani w żółć wtargnęli do naszej ostoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415062
    m_Localized: 'Edgar: Porwali ją, wywlekli w dal. Podejrzewam, że obaj wiemy iż oczywistym był powód.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415063
    m_Localized: 'Edgar: Żałuję… Nie dane mi było poznać jej w pełni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415064
    m_Localized: 'Edgar: Zanurzanie się w myślach o niej jest niczym spijanie z pamięci…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415065
    m_Localized: 'Edgar: Ludzie fechtują się, w jaki sposób poratować świat, lecz nie potrafią dojść do porozumienia. Argument jest prosty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415066
    m_Localized: 'Edgar: Odpowiedź leży w ciszy. W pięknie. Jeśli dane ci jest… je poczuć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415067
    m_Localized: 'Edgar: Ona starała się dać mi te nauki, ale przyjąłem tylko spokój. Wizję wdzięku pośród maszkar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415068
    m_Localized: 'Edgar: Teraz jednak… gotowym podążyć za nią.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415069
    m_Localized: 'TaxiDriver: No, nie wstydź się, stary. Pytaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415070
    m_Localized: Wciąż myślisz, że FEMA cię ściga?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415071
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415072
    m_Localized: 'TaxiDriver: Oby nie, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415073
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415074
    m_Localized: 'TaxiDriver: No, schrzaniłem, podjeżdżając pod ich siedzibę. Powinienem wiedzieć, że mnie też będą chcieli, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415075
    m_Localized: 'TaxiDriver: Ale myślałem, że wezmą tylko pasażera, a mnie puszczą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415076
    m_Localized: 'TaxiDriver: Zarekwirowali jednak wóz i niemal mnie nie zastrzelili.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415077
    m_Localized: 'TaxiDriver: Ale co miałem niby zrobić? Ten gość był Przybyszem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713957
    m_Localized: A jeśli nie był?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713958
    m_Localized: Nie miałeś wyboru
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713959
    m_Localized: 'TaxiDriver: Ejże, nie mów tak, stary.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713960
    m_Localized: 'TaxiDriver: Nie czuję się zbyt dobrze z powodu tej sytuacji, rozumiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713961
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713962
    m_Localized: 'TaxiDriver: Cóż… masz rację, wiesz? Pewno nie było innego wyjścia.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713963
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713964
    m_Localized: 'TaxiDriver: Stary, brakuje mi dni, kiedy można było tylko siedzieć za kółkiem i nie przejmować się niczym.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713965
    m_Localized: 'TaxiDriver: Teraz z tymi Przybyszami… Do licha, następny pasażer może posłać ci kulkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713966
    m_Localized: 'TaxiDriver: Ech…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415078
    m_Localized: 'TaxiDriver: No, nie wstydź się, stary. Pytaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415079
    m_Localized: Jak długo jeździsz taryfą?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415080
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415081
    m_Localized: 'TaxiDriver: No, już jakiś czas w tym siedzę, wiesz? Ostatnio nie pracuję dla żadnych firm, robię na własny rachunek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415082
    m_Localized: 'TaxiDriver: FEMA nie pozwala na dobrowolne przemieszczanie się cywili.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415083
    m_Localized: 'TaxiDriver: Ale ten obłęd się kiedyś skończy, nie? A forsa… forsę zawsze lepiej mieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415084
    m_Localized: 'TaxiDriver: Ludzie dobrze płacą za ryzykowne trasy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415085
    m_Localized: 'TaxiDriver: A jeżdżenie po zmroku przywołuje wspomnienia z dzieciństwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415086
    m_Localized: 'TaxiDriver: Wiesz, zostałem taryfiarzem po tatku. Chciałem pojechać w jego ślady, kumasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713967
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713968
    m_Localized: 'TaxiDriver: Nie chcę skończyć na poboczu, gdzie znikąd pomocy… jak mój staruszek.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713969
    m_Localized: 'TaxiDriver: Oby szczęście jeszcze mi dopisywało…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415087
    m_Localized: 'TaxiDriver: No, nie wstydź się, stary. Pytaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415088
    m_Localized: Wyglądasz dziś na przygnębionego
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415089
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415090
    m_Localized: 'TaxiDriver: Ech, to tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415091
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415092
    m_Localized: 'TaxiDriver: Nie mogę się pogodzić z tym, że zwinęli mi moje auto, wiesz…?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713970
    m_Localized: Jaki miałeś samochód?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713971
    m_Localized: Dlaczego jesteś do niego taki przywiązany?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713972
    m_Localized: 'TaxiDriver: Och, stary, to była piękna, klasyczna bryka…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713973
    m_Localized: 'TaxiDriver: Jasnożółty lakier, chromowane felgi, zaokrąglone linie nadwozia…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713974
    m_Localized: 'TaxiDriver: Ale przepadła…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713975
    m_Localized: 'TaxiDriver: Cholerna FEMA… Ten samochód był dla mnie wszystkim! Dranie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713976
    m_Localized: 'TaxiDriver: Należał do mojego ojca. Też był taryfiarzem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713977
    m_Localized: 'TaxiDriver: Jak byłem mały, lubiłem jeździć z nim nocami. Zawsze zasypiałem na tylnym siedzeniu, by mnie zabierał. Wtem…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713978
    m_Localized: 'TaxiDriver: Można powiedzieć, że fortuna go opuściła…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415096
    m_Localized: 'TaxiDriver: No, nie wstydź się, stary. Pytaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415097
    m_Localized: Co się stało z twoim ojcem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415098
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713979
    m_Localized: 'TaxiDriver: Nie lubię o tym rozmawiać, ale… tobie chyba mogę zaufać.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713980
    m_Localized: 'TaxiDriver: Pewnego razu matka musiała pojechać w delegację, więc tatko woził mnie w taksówce.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713981
    m_Localized: 'TaxiDriver: Podjęliśmy wtedy pasażera, którego nigdy nie zapomnę.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713982
    m_Localized: 'TaxiDriver: Elegancki garnitur, łysy, diabelski uśmieszek…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713983
    m_Localized: 'TaxiDriver: Wszyscy w mieście go znali. Nawet ja, mały brzdąc. Temu człowiekowi nie można było odmówić.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713984
    m_Localized: 'TaxiDriver: Tatko czcił wszakże honor. Jego wybór… odbił się nam wszystkim czkawką.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713985
    m_Localized: 'TaxiDriver: Ten diabeł w garniaku upewnił się, że za to bekniemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713986
    m_Localized: 'TaxiDriver: Straciliśmy dom. Nie mogliśmy też na długo pozostać w jednym miejscu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713987
    m_Localized: 'TaxiDriver: A że gotówką nie śmierdzieliśmy, tatko zachował taryfę.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713988
    m_Localized: 'TaxiDriver: Później, gdy nagromadziły się długi, zaczął żałować, że jej nie sprzedał.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713989
    m_Localized: 'TaxiDriver: Mówił, że ciąży nad nią klątwa i przynosi nam pecha.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713990
    m_Localized: 'TaxiDriver: Jednakowoż nigdy nie zrozumiał.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713991
    m_Localized: 'TaxiDriver: To jego duma wpędziła nas w tarapaty, a nie samochód.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713992
    m_Localized: 'TaxiDriver: Jego decyzje spowodowały, że musiałem wcześnie zacząć pracować, by wyżywić rodzinę… i wiesz co?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713993
    m_Localized: 'TaxiDriver: Wciąż go kocham.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713994
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713995
    m_Localized: 'TaxiDriver: Brakuje mi ciebie, tatku…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713996
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713997
    m_Localized: 'TaxiDriver: Nie proszę o wiele, ale… jeśli to nie kłopot, czy mógłbyś do niego… zadzwonić?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713998
    m_Localized: 'TaxiDriver: To jego numer: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713999
    m_Localized: 'TaxiDriver: Powiedz mu, że u mnie wszystko w porządku. Sam bym to zrobił, ale… teraz nie mogę wychylać nosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415106
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415128
    m_Localized: 'Provocateur: Co za świat…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415129
    m_Localized: Co teraz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415130
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415131
    m_Localized: 'Provocateur: Mości panie, czyż to nie oczywiste? Musimy sfinalizować odpowiednią umowę najmu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415132
    m_Localized: I jak niby mam to zrobić?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415133
    m_Localized: Czy to teraz takie ważne?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415134
    m_Localized: 'Provocateur: Hmm, czy szanowny pan chce mi powiedzieć, że nie ma pod ręką odpowiednich formularzy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415135
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415136
    m_Localized: 'Provocateur: Sugeruję wtedy skontaktować się z notariuszem i takie pozyskać, hm? Co za ambaras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415137
    m_Localized: Czy pan żartuje? Gdzie mam teraz znaleźć notariusza?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415138
    m_Localized: Czemu sam pan tego nie załatwi?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415139
    m_Localized: 'Provocateur: Proszę także uprzejmie zwracać się do mnie odpowiednio i z należytym szacunkiem. Może być per „szanowny panie”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415140
    m_Localized: 'Provocateur: Gdzież się podziały maniery…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415141
    m_Localized: Jak pan sobie chce
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415142
    m_Localized: A weź pan spierdalaj
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415143
    m_Localized: 'Provocateur: Czy mości pan wie, jak czytać mapę? To banalnie proste.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415144
    m_Localized: 'Provocateur: Nalegam, by mości pan zwracał się do mnie z szacunkiem i per „szanowny panie”, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415145
    m_Localized: Jak pan sobie chce
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415146
    m_Localized: A weź pan spierdalaj
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415147
    m_Localized: 'Provocateur: Z jakiegoż to powodu to ja miałbym zajmować się tą sprawą? I proszę adresować mnie per „szanowny pan”!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415148
    m_Localized: 'Provocateur: Jestem szanowanym obywatelem, a nie chłopcem na posyłki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415149
    m_Localized: Jak pan sobie chce
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415150
    m_Localized: A weź pan spierdalaj
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415151
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415152
    m_Localized: 'Provocateur: Czy szanowny pan robi to umyślnie? Mógłby pan chociaż udawać, że panu zależy, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415153
    m_Localized: 'Provocateur: Hmm, tak się składa, że artykuł 21. Konstytucji gwarantuje prawa do okazywania szacunku, więc proszę zważać na ton.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415154
    m_Localized: 'Provocateur: Usilnie nalegam także, by zaczął pan okazywać mi należyty szacunek, zanim stanie się… nieprzyjemnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415155
    m_Localized: 'Provocateur: Co za świat…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415156
    m_Localized: Czy może pan już odpuścić?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415157
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415158
    m_Localized: 'Provocateur: Absolutnie nie. Szanowny pan jest prawnie zobowiązany sfinalizować umowę najmu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415159
    m_Localized: Nie mam niczego do jej finalizacji
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415160
    m_Localized: Pan chyba żartuje
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415161
    m_Localized: 'Provocateur: Hmm. Wielka szkoda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415162
    m_Localized: 'Provocateur: Obawiam się, że to stanowi wykroczenie na podstawie artykułu 131.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415163
    m_Localized: Zaczyna mnie pan wnerwiać
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415164
    m_Localized: Nie męczy się panu język od cytowania prawa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415165
    m_Localized: 'Provocateur: Hmm, dla pana informacji artykuł 131. wymaga pisemnego kontraktu. Ja jestem jedynie odpowiedzialnym obywatelem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415166
    m_Localized: Wkurwiasz mnie pan
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415167
    m_Localized: Nie więdnie panu język od cytowania prawa?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415168
    m_Localized: 'Provocateur: Yhym, są i one, inwektywy, punktualnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415169
    m_Localized: 'Provocateur: To podlega pod kodeks cywilny, artykuł 5., podpunkt 61.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415170
    m_Localized: 'Provocateur: Proszę sobie pofolgować. Pożałuje pan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415171
    m_Localized: 'Provocateur: I nie, nie męczy mnie cytowanie ani prawa, ani konstytucji.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415172
    m_Localized: 'Provocateur: Znam swoje prawa! Pana ignorancja w tej dziedzinie nie oznacza tego samego dla innych.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415173
    m_Localized: 'Provocateur: Ponownie przypominam i nalegam, by mości pan zwracał się do mnie odpowiednio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415174
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415175
    m_Localized: 'Provocateur: Phi, co za wstyd, kiedy szanowny pan się nauczy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415176
    m_Localized: 'Provocateur: Co za świat…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415177
    m_Localized: Co teraz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415178
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415179
    m_Localized: 'Provocateur: Nie umknęło mojej uwadze, że mości pan posiada broń. Czy mogę zobaczyć pozwolenie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415180
    m_Localized: To nie pana interes
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415181
    m_Localized: Dlaczego się pan na mnie uwziął?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415182
    m_Localized: 'Provocateur: Ach, rozumiem, nie ma pan takowego? To nasuwa się samo po pana reakcji, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415183
    m_Localized: 'Provocateur: Czy szanowny gospodarz uważa, że posiadanie broni daje przywilej stanowienia prawa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415184
    m_Localized: 'Provocateur: I uprawnia do przesłuchiwania wszystkich, samemu tego unikając?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415185
    m_Localized: 'Provocateur: Srogo się pan myli, mości panie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415186
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415187
    m_Localized: 'Provocateur: Wie pan, jak się mówi: „trafiła kosa na kamień”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415188
    m_Localized: Dość. Mam już wystarczająco dużo na głowie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415189
    m_Localized: Proszę, skończ pan pierdolić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415190
    m_Localized: 'Provocateur: Ja wyłącznie próbuję ustalić, z kim mam do czynienia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415191
    m_Localized: 'Provocateur: Zacny pan wycofał się… więc trafiłem w sedno. Nie ma pan pozwolenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415192
    m_Localized: 'Provocateur: Uważa pan, że stoi ponad prawem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415193
    m_Localized: 'Provocateur: Szanowny pan myśli, że może wykrywać zagrożenia, i że z kolei nikt pana nie zweryfikuje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415194
    m_Localized: 'Provocateur: Jet pan w błędzie, mości gospodarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415195
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415196
    m_Localized: 'Provocateur: Wie pan, jak się mówi: „trafiła kosa na kamień”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415197
    m_Localized: Dość. Mam już wystarczająco dużo na głowie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415198
    m_Localized: Proszę, skończ pan pierdolić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415199
    m_Localized: 'Provocateur: Och, biedaczysko. Nikt się panu nie sprzeciwia ani nie sprawdzi, czy jest pan Przybyszem. Ech, zaiste wielki to ciężar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415200
    m_Localized: 'Provocateur: Kto szanownemu panu pozwolił decydować o czyimś życiu lub śmierci, hm? Skąd ten autorytet, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415201
    m_Localized: 'Provocateur: A my tu się modlimy, żeby nie być następną ofiarą pana eliminacji. I pan chce mojej sympatii? Jest pan niepoważny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415202
    m_Localized: 'Provocateur: Proszę wybaczyć język, ale jeśli mam się posłużyć pana słownictwem, czyż to nie pan tu wszystkim „pierdoli” o testach?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415203
    m_Localized: 'Provocateur: Węszy mości pan i traktuje wszystkich jak morderców.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415204
    m_Localized: 'Provocateur: Ale dobrze, nie wytykajmy palcami prawdziwego zabójcy. Bo być może… jest szansa… że Przybysze w ogóle nie istnieją.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415205
    m_Localized: 'Provocateur: I kim by pan wtedy był, hm? Szaleńcem… nadużywającym swojej pozycji i zaspokajającym swe żądze w chaosie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415206
    m_Localized: 'Provocateur: A inni ludzie? Słyszą panikę w radiu i pędzą do drzwi zacnego pana jak muchy do gówna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415207
    m_Localized: 'Provocateur: Proszę mi powiedzieć, ilu z pana pierwszych gości przeżyło do tego momentu, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415208
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415209
    m_Localized: 'Provocateur: Właśnie tak myślałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415210
    m_Localized: 'Provocateur: Co za świat…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415211
    m_Localized: Szanowny panie? Pan wciąż tu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415212
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415213
    m_Localized: 'Provocateur: Niewiarygodne… Odniosłeś się pan do mnie z należytym szacunkiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415214
    m_Localized: 'Provocateur: Szkoda, że o wiele za późno. Na wszystko tutaj bardzo niedługo doniosę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415215
    m_Localized: Na co niby pan doniesie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415216
    m_Localized: Do kogo niby pan doniesie?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415217
    m_Localized: 'Provocateur: Już mnie zacny pan nie przechytrzy. Dokładnie wiem, co z pana za ziółko.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415218
    m_Localized: 'Provocateur: To nie jest pana dom. Nie, nie, nie. Ubił pan właściciela i podszył się pod niego. Zawiadomię o tym FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415219
    m_Localized: 'Provocateur: Dokładnie tak, dopadną szanownego pana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415220
    m_Localized: Gówno prawda
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415221
    m_Localized: Czas zamknąć panu gębę na zawsze
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415222
    m_Localized: 'Provocateur: Front Ewakuacji Medyczno‑Awaryjnej, w skrócie „FEMA”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415223
    m_Localized: 'Provocateur: Z początku chciałem puścić płazem zaniedbanie szanownego pana odnośnie banalnej umowy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415224
    m_Localized: 'Provocateur: Ale im dłużej prowadziliśmy rozmowę, tym wszystko stawało się jaśniejsze.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415225
    m_Localized: 'Provocateur: Teraz wszystko się zgadza. To nie pana dom, zacny gospodarzu. Jest pan oszustem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415226
    m_Localized: 'Provocateur: Mości pan jest… PRZYBYSZEM!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415227
    m_Localized: 'Provocateur: Proszę się więc zacząć pakować. Przyjadą po pana dziś wieczorem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415228
    m_Localized: Gówno prawda
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415229
    m_Localized: Czas zamknąć panu gębę na zawsze
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415230
    m_Localized: 'Provocateur: Och, doniosę na to. A oni się zjawią. Sam pan zobaczy, gospodarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415231
    m_Localized: Gadaj pan zdrów. Fora ze dwora
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415232
    m_Localized: Już nie żyjesz (wyciągnij broń)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415233
    m_Localized: 'Provocateur: Mości pan myśli, że można mnie uciszyć? Życzę powodzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415234
    m_Localized: 'Provocateur: Proszę zaczekać… Co takiego?! Czy pan oszalał? T‑to zbrodnia!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415235
    m_Localized: 'Provocateur: Nie, nie, nie. Nie wywinie się pan z tego, gospodarzu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609280
    m_Localized: 'Provocateur: Zostaję tu, aż nie zjawi się FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609281
    m_Localized: 'Provocateur: Powiem im o wszystkim, co pan tu wyprawia i jaki mości pan jest niebezpieczny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609282
    m_Localized: 'Provocateur: Proszę zaczekać… Co takiego?! Czy szanowny pan oszalał? T‑to zbrodnia!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609283
    m_Localized: 'Provocateur: Mości pan się nie waży!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609284
    m_Localized: Lepiej niech pan zmyka, zanim strzelę
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609285
    m_Localized: Strzelę bez wahania, jeśli pan nie wyjdzie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609286
    m_Localized: Nie zostawia mi pan wyjścia
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609287
    m_Localized: (Zastrzel go)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609288
    m_Localized: 'Provocateur: Nie pozwolę panu uniknąć funkcjonariuszy FEMA. Chyba że po moim trupie!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609289
    m_Localized: 'Provocateur: Wtedy sami pana dopadną!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609290
    m_Localized: 'Provocateur: I vice versa!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609291
    m_Localized: 'Provocateur: JEST PAN PRZYBYSZEM! MORDERCĄ! NIE JEST PAN CZŁOWIEKIEM!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609292
    m_Localized: 'Provocateur: NIE! TO WBREW PRAWU!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609293
    m_Localized: 'Provocateur: AAA!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609294
    m_Localized: 'Marauder: Obfity szaber… tak… tego potrzebuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609295
    m_Localized: Jak idzie szaberek?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609296
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609297
    m_Localized: 'Marauder: Hej, druhu. Myślałem, że tu żywej duszy, dlatego się podkradłem… Nie wiedziałem, że ktoś tu mieszka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609298
    m_Localized: 'Marauder: Nie okradam żywych.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609299
    m_Localized: 'Marauder: Ma to sens, nie? Pomyśl, na co trupowi płaszcz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609300
    m_Localized: 'Marauder: Go już nie ma, a towar tylko leży. Ja jednak wciąż dycham. Może uratować życie mnie lub komuś bliskiemu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609301
    m_Localized: 'Marauder: Na pewno też byś zdarł jakieś łachy z nieboszczyka, żeby uratować najbliższych.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609302
    m_Localized: 'Marauder: Na moje to może pora przestać traktować każde zwłoki jak święte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609303
    m_Localized: 'Marauder: Obfity szaber… tak… tego potrzebuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609304
    m_Localized: Dlaczego zostałeś szabrownikiem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609305
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609306
    m_Localized: 'Marauder: Co innego miałem począć, hę? Nie chcę nikomu wyrządzać krzywdy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609307
    m_Localized: 'Marauder: Wszedłem więc na spokojniejszą ścieżkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609308
    m_Localized: 'Marauder: Sztywni się nie bronią, no nie? Ich szpargały tylko… leżą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609309
    m_Localized: 'Marauder: Nie robię nikomu krzywdy. Chcę jeno przeżyć i może pomóc komuś przy okazji.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609310
    m_Localized: 'Marauder: Obfity szaber… tak… tego potrzebuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609311
    m_Localized: Znalazłeś coś ciekawego?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609312
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609313
    m_Localized: 'Marauder: Druhu, widziałem zbyt wiele, by wszystko spamiętać…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609314
    m_Localized: 'Marauder: Niech no pomyślę…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609315
    m_Localized: 'Marauder: Raz natknąłem się na opuszczoną bibliotekę. Półki pełne zakurzonych książek, jakby lada chwila ktoś miał je wypożyczyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609316
    m_Localized: 'Marauder: Och, byłem też na jakiejś wystawie początkującego artysty. Wszędzie wisiały rysunki.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609317
    m_Localized: 'Marauder: A innego razu… widziałem zachód słońca. I to nie byle jaki, wyglądał jak z obrazka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609318
    m_Localized: 'Marauder: Teraz nikt nie ryzykuje obserwacji nieba, ale kiedyś…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609319
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609320
    m_Localized: 'Marauder: Brak mi dawnego porządku rzeczy, druhu. Wstawałem wcześnie rano. Ulice były ciche. Kłębiła się mgła, trawa wciąż mokra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609321
    m_Localized: 'Marauder: A słońce… Och, druhu, wschodziło takie jasne, jakby obiecując wspaniały dzień.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609322
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609323
    m_Localized: 'Marauder: A teraz spójrz no na nas. Jak do tego doszło?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609324
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609325
    m_Localized: 'Marauder: Chciałbym, żeby ktoś znał na to wszystko odpowiedzi. Może byłoby łatwiej to znieść, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609326
    m_Localized: 'Marauder: Obfity szaber… tak… tego potrzebuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609327
    m_Localized: Kończysz z szabrowaniem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609328
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609329
    m_Localized: 'Marauder: Nie, skąd. Ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609330
    m_Localized: 'Marauder: Sam nie wiem… Jednego razu miałem dość.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609331
    m_Localized: 'Marauder: Znalazłem taki dom. Pusty. Sztywniak na podłodze, standardzik. Żadnych zagrożeń.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609332
    m_Localized: 'Marauder: Gość miał podziurawione całe plecy i na czymś leżał.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609333
    m_Localized: 'Marauder: Myślę sobie, może chciał coś ukryć? Podchodzę, turlam go na bok…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609334
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609335
    m_Localized: 'Marauder: Wiesz co, nie. Powiem ci później. Nie jestem gotów sobie tego przypominać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609336
    m_Localized: 'Marauder: Obfity szaber… tak… tego potrzebuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609337
    m_Localized: Co było pod zwłokami?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609338
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609339
    m_Localized: 'Marauder: No dobra…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609340
    m_Localized: 'Marauder: Kulam gościa na bok, a tam leży ona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609341
    m_Localized: 'Marauder: Mała dziewczynka, martwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609342
    m_Localized: 'Marauder: Dorośli… nie robią na mnie wrażenia, ale dzieci? Zawsze to przeżywam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609343
    m_Localized: 'Marauder: Widok ich martwych ciałek wyciska ze mnie łzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609344
    m_Localized: 'Marauder: Tuliła małego, pluszowego kotka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609345
    m_Localized: 'Marauder: Było tam tyle krwi, druhu…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609346
    m_Localized: 'Marauder: Jej twarzyczka zastygła z wyrazem… jakby wiedziała, że nadchodzi śmierć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609347
    m_Localized: 'Marauder: Przez moment myślałem, że boi się, że zabiorę jej pluszaka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609348
    m_Localized: 'Marauder: Jakby nawet po śmierci wciąż groziła jej ludzka niegodziwość.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609349
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609350
    m_Localized: 'Marauder: Wpłynęło to na moje serce bardziej, niż myślałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609351
    m_Localized: 'Marauder: Tamtego dnia chciałem przestać i zostawić martwych w spokoju… Teraz na to za późno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609352
    m_Localized: 'Marauder: Mogę tylko ciągnąć tak dalej. Wciąż szabrować. Nie umiem przetrwać w inny sposób.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609353
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609354
    m_Localized: 'Marauder: Ludzie mówią, że los i tak cię dopadnie. To prawda, zdaję się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609355
    m_Localized: 'GraveDigger: Oby te Przybysze wróciły nazad pod ziemię…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609356
    m_Localized: Dlaczego zostałeś grabarzem?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609357
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609358
    m_Localized: 'GraveDigger: Hę? Rety, moja praca? Po prawdzie to nie wiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609359
    m_Localized: 'GraveDigger: Cmentarz przypomina mi… jakby bibliotekę, jo? Ale te księgi nie są do czytania… tylko tam legły. Cichutkie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609360
    m_Localized: 'GraveDigger: Zwykłem znać każdy grób. Kto gdzie leży, jak mieli złożone ręce, w co byli ubrani, jak się nazywali…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609361
    m_Localized: 'GraveDigger: Wtedy kopię świeży grób, jo? Dzień jak co dzień, nic dziwnego. Jestem odpowiednio głęboko i bum, pusto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609362
    m_Localized: 'GraveDigger: Pusto, powiadam! A papiery mówiły, że ktoś miał tam leżeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609363
    m_Localized: 'GraveDigger: Jakiś gość, pewno martwy. Pamiętam, że miał wąsy. A tu czary‑mary! Ulotnił się jak poranna mgła.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609364
    m_Localized: 'GraveDigger: Jeśli nieboszczyk znika, czy to nie jakby znowu zemrzeć?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609365
    m_Localized: 'GraveDigger: Oby te Przybysze wróciły nazad pod ziemię…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609366
    m_Localized: Co zrobiłeś po odkryciu pustego grobu?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609367
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609368
    m_Localized: 'GraveDigger: Usiadłem na samej krawędzi. Spojrzałem w dół i tam wciąż nic. Spojrzałem w dal, a tam daleko… ktoś stoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609369
    m_Localized: 'GraveDigger: Patrzy. Jak na pogrzebie. Gał mu brak. Zęby bieluśkie. Niemal lśnią. Szczerzy się. Stoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609370
    m_Localized: 'GraveDigger: Niemal się posrałem, nie będę ściemniał.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609371
    m_Localized: 'GraveDigger: Prędko stamtąd dałem drapaka. Mam szybkie nogi. Nie ścigał mnie jednak. Tylko… zniknął. Jak bąk w gaciach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609372
    m_Localized: 'GraveDigger: Pojebane to było… Wtedy zaczął się cały ten burdel z Przybyszami…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609373
    m_Localized: 'GraveDigger: Oby te Przybysze wróciły nazad pod ziemię…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609374
    m_Localized: Po co kopać groby, skoro nikt już nie grzebie zmarłych?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609375
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609376
    m_Localized: 'GraveDigger: Nie kopię już. Doglądam jeno… zwykle. Po tym rejwachu jednak? Zacząłem wybadywać świeże mogiły.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609377
    m_Localized: 'GraveDigger: Byłem bardzo ostrożny. Nic na „hura”.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609378
    m_Localized: 'GraveDigger: Myślałem, że może któryś z nich został pochowany omyłkowo. Szpadel był mi mieczem. Byłem gotów walnąć każdemu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609379
    m_Localized: 'GraveDigger: Ale nie… Kości były tam, gdzie być powinny. Zwłoki leżakowały. Nic nie wypełzało.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609380
    m_Localized: 'GraveDigger: Naszło mnie wtem… może to nie zmarli wstają. Może Przybysze to ludzie, którzy powinni być pogrzebani, a nie byli.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609381
    m_Localized: 'GraveDigger: Oby te Przybysze wróciły nazad pod ziemię…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609382
    m_Localized: Nie kopiesz nowych grobów, prawda?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609383
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609384
    m_Localized: 'GraveDigger: Ja?! Nie, do diabła z tym! Jam nie głupi… Patrzaj, całe życie miałem ze zmarłymi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609385
    m_Localized: 'GraveDigger: Śmierć nie była mi obca. Umierasz, wkładają cię do piachu. Teraz? Komu kogo grzebać?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609386
    m_Localized: 'GraveDigger: A nawet jeśli, to skąd wiesz, że zostaniesz w ziemi? Widziałem grób, w którym kogoś złożyłem… a teraz on pusty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609387
    m_Localized: 'GraveDigger: Tymi rękoma go tam pochowałem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609388
    m_Localized: 'GraveDigger: Teraz myślę… może mój grób też będzie pusty.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609389
    m_Localized: 'GraveDigger: Może… może już teraz jestem Przybyszem…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609390
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609391
    m_Localized: 'GraveDigger: Ech… nie przejmujta się mną. Wystraszyłem się jeno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609392
    m_Localized: 'GraveDigger: Oby te Przybysze wróciły nazad pod ziemię…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609393
    m_Localized: Jak myślisz, skąd są Przybysze?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609394
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609395
    m_Localized: 'GraveDigger: Poznałeś, że wyglądają jakoś tak znajomo? Nie jak ludzie… ale jak pamięć po człowieku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609396
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609397
    m_Localized: 'GraveDigger: Mam taki pomyślunek. Chcesz usłyszeć? Dobra, słuchaj…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609398
    m_Localized: 'GraveDigger: Może Przybysze… nie są martwi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609399
    m_Localized: 'GraveDigger: Może są myślami. Tymi, których nie grzebiemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609400
    m_Localized: 'GraveDigger: Obawy, żałości, uczucia, których się nie pozbywamy. Gromadzą się… a gdy w ziemi jest zbyt spokojnie, wyłażą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609401
    m_Localized: 'GraveDigger: Nie węszą za ciałem, lecz atencją.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609402
    m_Localized: 'GraveDigger: Im niemożebniej się ktoś boi, tym bardziej się zbliżają. Bo się je pamięta. A wszystko, co jest pamiętane… chce żyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609403
    m_Localized: 'FormerFema: Mam nadzieję, że nie wystawiłem się za bardzo na słońce…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609404
    m_Localized: Na pewno nie jesteś funkcjonariuszem FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609405
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609406
    m_Localized: 'FormerFema: Na pewno. Już tobie mówiłem, naprawiałem chłodnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609407
    m_Localized: 'FormerFema: Kombinezon znalazłem w samochodzie…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609408
    m_Localized: Wcześniej mówiłeś, że zdjąłeś go ze zwłok
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609409
    m_Localized: Nie kręcisz mi aby tutaj?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609410
    m_Localized: 'FormerFema: Eee… tak, jasne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609411
    m_Localized: 'FormerFema: Miał go na sobie… trup w samochodzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609412
    m_Localized: 'FormerFema: Uznałem, że ochroni mnie przed Przybyszami. W końcu po coś ci goście z FEMA je noszą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609413
    m_Localized: 'FormerFema: Nie bajeruję. Pokićkało mi się z nerwów. Co w tym dziwnego?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609414
    m_Localized: 'FormerFema: Wierz mi, gdybyś widział to, co ja… Zrozumiałbyś.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609415
    m_Localized: 'FormerFema: Nawet po drodze tutaj… Wiesz, że niektóre trupy na ziemi wciąż wierzgają? Prawie kipnąłem ze strachu…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609416
    m_Localized: 'FormerFema: Mam nadzieję, że nie wystawiłem się za bardzo na słońce…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609417
    m_Localized: Nie uważasz, że kombinezon FEMA to zły pomysł?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609418
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609419
    m_Localized: 'FormerFema: Słucham? Nie… wcale nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609420
    m_Localized: 'FormerFema: Okej, jasne, niektórzy nie przepadają za FEMA, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609421
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609422
    m_Localized: 'FormerFema: O rany, chodzi ci, że mogę mieć kłopoty za podawanie się za funkcjonariusza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609423
    m_Localized: 'FormerFema: Słuchaj… chyba jak im wszystko wytłumaczę, to mnie puszczą…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609424
    m_Localized: 'FormerFema: Nie ma powodów, żeby ich demonizować. Nie są przecież żadną tajemną sektą ani czymś takim…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609425
    m_Localized: 'FormerFema: Mam nadzieję, że nie wystawiłem się za bardzo na słońce…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609426
    m_Localized: Pokaż, co masz w kieszeniach
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609427
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609428
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609429
    m_Localized: 'FormerFema: Ej! D‑dlaczego chcesz mnie przeszukiwać?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609430
    m_Localized: Szukam tylko identyfikatora FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609431
    m_Localized: A czemu nie? Masz coś do ukrycia?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609432
    m_Localized: 'FormerFema: Co? Jakiego identyfikatora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609433
    m_Localized: 'FormerFema: Daję słowo, że nic nie mam…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609434
    m_Localized: Dobra, zróbmy to w nieprzyjemny sposób… wywracaj kieszenie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609435
    m_Localized: (Wyciągnij broń)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609436
    m_Localized: 'FormerFema: Kto? Ja?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609437
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609438
    m_Localized: 'FormerFema: Nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609439
    m_Localized: Dobra, zróbmy to w nieprzyjemny sposób… wywracaj kieszenie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609440
    m_Localized: (Wyciągnij broń)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609441
    m_Localized: 'FormerFema: W porządku, w porządku, nie trzeba mnie obmacywać…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609442
    m_Localized: 'FormerFema: Już. Zadowolony?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609443
    m_Localized: 'FormerFema: Dobra, przyłapałeś mnie. Pracuję dla FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609444
    m_Localized: 'FormerFema: Błagam, nie mów pozostałym.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609445
    m_Localized: 'FormerFema: O cholera…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609446
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609447
    m_Localized: 'FormerFema: Masz. Tylko… nie strzelaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609448
    m_Localized: 'FormerFema: Tak… pracuję dla FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609449
    m_Localized: 'FormerFema: Ale najlepiej niech to zostanie między nami…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491072
    m_Localized: Czemu ukrywałeś, że byłeś z FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491073
    m_Localized: I po co te podchody?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491074
    m_Localized: 'FormerFema: Naprawdę nie rozumiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491075
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491076
    m_Localized: 'FormerFema: Naprawdę o to pytasz?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491077
    m_Localized: 'FormerFema: Jeśli ktoś się dowie, że byłem z FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491078
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491079
    m_Localized: 'FormerFema: Słuchaj, już dla nich nie pracuję. Powiedzmy, że… odszedłem stamtąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491080
    m_Localized: 'FormerFema: Słuchaj, już dla nich nie pracuję. Powiedzmy, że… odszedłem stamtąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491081
    m_Localized: 'FormerFema: Tak, musiałem robić pewne rzeczy, które nie były wspaniałe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491082
    m_Localized: 'FormerFema: Łapanki… wysyłanie ludzi do stref kwarantanny…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491083
    m_Localized: 'FormerFema: Wierz mi, to była tylko praca, okej? Tylko wykonywałem rozkazy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491084
    m_Localized: 'FormerFema: Nie pytaj mnie o pojmanych. To były decyzje wyżej postawionych ode mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491085
    m_Localized: 'FormerFema: A wyzywanie mnie od morderców i innych takich… jest nie fair.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491086
    m_Localized: 'FormerFema: Kim byłbym, jeśli ratowałem ludzi, wysyłając zabójców do stref kwarantanny?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609450
    m_Localized: 'FormerFema: Mam nadzieję, że nie wystawiłem się za bardzo na słońce…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609451
    m_Localized: Czemu ukrywałeś, że byłeś z FEMA?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609452
    m_Localized: Chcę się tobie przyjrzeć
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491087
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491088
    m_Localized: 'FormerFema: Raz złapałem delikwenta z objawami Przybysza.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491089
    m_Localized: 'FormerFema: Długo nie opowiadając, w strefie mu się pogorszyło i zmarł. Zdarza się.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491090
    m_Localized: 'FormerFema: Potem przyszła jego żona. Chciała wiedzieć, kiedy go wypuścimy. Oznajmiliśmy, że nie ma kogo wypuszczać.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491091
    m_Localized: 'FormerFema: Oczywiste, że była w szoku. Zaczęła wrzeszczeć, wyzywała od morderców, żądała wydania ciała.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491092
    m_Localized: 'FormerFema: Mówimy, że protokół zabrania. Nie powstrzymało jej to.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491093
    m_Localized: 'FormerFema: Usiadła i czekała zaraz naprzeciwko bramy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491094
    m_Localized: 'FormerFema: Zmiękliśmy i zwróciliśmy jej zwłoki. Potem zwolnili wszystkich zaangażowanych za złamanie przepisów.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491095
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491096
    m_Localized: 'FormerFema: Musiała się uprzeć o te przeklęte zwłoki. Psychiczna szajbuska kosztowała mnie pracę.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491097
    m_Localized: 'FormerFema: Teraz nie mam, dokąd iść…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491098
    m_Localized: 'FormerFema: I wiesz co? Zamiast go pogrzebać, wszędzie go ze sobą wlecze.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491099
    m_Localized: 'FormerFema: Warto było za to wylecieć na zbity pysk, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491100
    m_Localized: Wy wszyscy z FEMA to prawdziwe gnoje
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491101
    m_Localized: A to feler, westchnął seler
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491102
    m_Localized: 'FormerFema: Że co?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491103
    m_Localized: 'FormerFema: Wykonuję swoją pracę, swój obowiązek, zwalniają mnie z powodu jakiejś wariatki…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491104
    m_Localized: 'FormerFema: A ty nas tu od gnojów?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491105
    m_Localized: 'FormerFema: Wiesz co, weź spierdalaj. Zjeżdżam stąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491106
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491107
    m_Localized: 'FormerFema: Chryste, czy wszyscy ogłupieli?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491108
    m_Localized: 'FormerFema: Nie, nie, tak dokładnie było.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491109
    m_Localized: 'FormerFema: Od kiedy słońcu odwaliło i zaczęły się infekcje, wszyscy ześwirowali.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491110
    m_Localized: 'FormerFema: Czy te zwłoki były warte naszej pracy? Doprawdy?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491111
    m_Localized: Dobrze, że mąż do niej wrócił
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491112
    m_Localized: Nie powinniście oddawać zwłok
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491113
    m_Localized: 'FormerFema: Twierdzisz, że dobrze, że nas wywalili?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491114
    m_Localized: 'FormerFema: Wy cywile nic nie rozumiecie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491115
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491116
    m_Localized: 'FormerFema: Powinna dostać kulkę jak jej mąż.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491117
    m_Localized: Co żeś powiedział?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491118
    m_Localized: (Wyciągnij broń)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491119
    m_Localized: 'FormerFema: Co się tak patrzysz?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491120
    m_Localized: 'FormerFema: Protokół mówi, że jeśli zarażony cywil jest w złym stanie…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491121
    m_Localized: 'FormerFema: Mamy wtedy natychmiast rozwiązać problem, żeby nam Przybysz nie latał po strefie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491122
    m_Localized: Puść go wolno
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491123
    m_Localized: (Wyciągnij broń)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491124
    m_Localized: 'FormerFema: Dzięki za wyrozumiałość.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491125
    m_Localized: 'FormerFema: Nie jestem mordercą, wykonywałem rozkazy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491126
    m_Localized: 'FormerFema: Ej, co ty, u licha, wyrabiasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491127
    m_Localized: 'FormerFema: Opamiętaj się, on był Przybyszem! Ledwo zipał! Nie mogliśmy go wypuścić.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491128
    m_Localized: 'FormerFema: Nie strzelaj! Tylko wykonywałem rozkazy!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491129
    m_Localized: 'FormerFema: Też tak myślę. Powinniśmy zachować protokół.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491130
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491131
    m_Localized: 'FormerFema: Dobra, nie będę cię zanudzał resztą. Tak czy siak dzięki, że mnie wpuściłeś, nawet dowiadując się, że byłem z FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491132
    m_Localized: 'FormerFema: Jeśli odzyskam posadę, udokumentuję twój wkład w sprawę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609476
    m_Localized: 'Intruder: Czy Przybysze mają sny…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609477
    m_Localized: Udało ci się zasnąć?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609478
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609479
    m_Localized: 'Intruder: Hm? Nie, nawet nie próbowałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609480
    m_Localized: 'Intruder: Liczę tylko, że ktoś tu jeszcze śni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609481
    m_Localized: 'Intruder: Ale… nikt nie podzielił się jeszcze ze mną swoimi snami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609482
    m_Localized: 'Intruder: Może nie wzbudzam zaufania.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609483
    m_Localized: 'Intruder: Kto wie, może później się przede mną otworzą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609484
    m_Localized: 'Intruder: Czy Przybysze mają sny…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609485
    m_Localized: Skąd obsesja na punkcie snów?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609486
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609487
    m_Localized: 'Intruder: Jaka obsesja?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609488
    m_Localized: 'Intruder: Dziwna konkluzja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609489
    m_Localized: 'Intruder: Ani trochę nie ciekawi cię, co chce nam przekazać podświadomość?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609490
    m_Localized: 'Intruder: Co chowa się w naszych głowach? Wszyscy coś przed sobą ukrywamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609491
    m_Localized: 'Intruder: Na przykład ty. Czy unikasz ludzi, bo ktoś cię skrzywdził?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609492
    m_Localized: 'Intruder: Właśnie dlatego mnie to tak fascynuje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609493
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609494
    m_Localized: 'Intruder: Wiesz co? Opowiem ci mój ostatni sen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609495
    m_Localized: 'Intruder: Pędziła za mną ogromna, czarna lokomotywa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609496
    m_Localized: 'Intruder: Nogi wrosły mi w ziemię. Krzyknąłem i obudziłem się.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609497
    m_Localized: 'Intruder: Ale byłem także maszynistą. Prułem prosto na siebie, nie mogąc przestać.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609498
    m_Localized: 'Intruder: Czy Przybysze mają sny…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609499
    m_Localized: A ty jak? Co skrywasz w swoich snach?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609500
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609501
    m_Localized: 'Intruder: A ja co?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609502
    m_Localized: 'Intruder: Nie spałem od tygodnia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609503
    m_Localized: 'Intruder: Ale w porządku, zdradzę ci pewien sekret. I tak nikt nie uwierzy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609504
    m_Localized: 'Intruder: Widzę sny innych. To… ekscytujące.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609505
    m_Localized: 'Intruder: Nie mam bladego pojęcia, jak to działa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609506
    m_Localized: 'Intruder: Ale od kiedy to wszystko się zaczęło… sny ucichły.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609507
    m_Localized: 'Intruder: Jakby wszyscy wstrzymywali oddech.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609508
    m_Localized: 'Intruder: A ja nie mogę ponownie zasnąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609509
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609510
    m_Localized: 'Intruder: Skąd będziesz wiedział, czy mówię prawdę, czy wyssałem wszystko z palca?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609511
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609512
    m_Localized: Kim panowie są?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609513
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609514
    m_Localized: 'Cultist1: Zagubionymi duszami. Tak jak tabuny innych, które krążą po tej schorzałej ziemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609515
    m_Localized: 'Cultist1: Pragniemy spokoju… wiecznej martwoty. Odnaleźliśmy drogę do Niej…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609516
    m_Localized: 'Cultist1: …do Śmierci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609517
    m_Localized: 'Cultist1: Czemuż drżą przed Nią? Czy to doprawdy strach przed czymś nieznanym? Czy może przed dogmatami wyrytymi w duszach?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609518
    m_Localized: 'Cultist1: Od tysiącleci szarpaliśmy za tenże woal, poszukując sensu życia. I objawione zostało, a odpowiedź zaiste jest klarowna…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609519
    m_Localized: 'Cultist1: Naszym celem jest Śmierć. Jesteśmy Jej wyznawcami.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609520
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609521
    m_Localized: Dlaczego oddajecie hołd śmierci?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609522
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609523
    m_Localized: 'Cultist1: Ponieważ Śmierć jest ucieleśnieniem miłosierdzia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609524
    m_Localized: 'Cultist1: Wszyscy trwożymy się przed Nią, ale czy mamy ku temu podstawy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609525
    m_Localized: 'Cultist1: Proszę się dobrze zastanowić… nasz świat to nie raj, lecz czyściec, który nas dręczy. Nasuwa się palące pytanie: dlaczego?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609526
    m_Localized: 'Cultist1: Tyle strachu, bólu i cierpienia… Czy zasługujemy na spokój?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609527
    m_Localized: 'Cultist1: Śmierć to raj, którego nie możemy objąć umysłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609528
    m_Localized: 'Cultist1: Religia podejmuje próbę uproszczenia wizerunku Nieba, aby ulżyć ludzkim żałościom. Czy życie jest jednak takie proste?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609529
    m_Localized: 'Cultist1: To samo odnosi się do Śmierci. Nie pojmiesz Jej, dopóty cię nie tknie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609530
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609531
    m_Localized: Dlaczego panowie wybrali mój dom?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609532
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609533
    m_Localized: 'Cultist1: Pana dom jest powiązany ze Śmiercią jak żaden inny.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609534
    m_Localized: 'Cultist1: Z początku wątpiłem w wybór naszego guru. Teraz rozumiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609535
    m_Localized: 'Cultist1: Śmierć snuje się w tych murach. Nieuchwytna, acz dusząca. Przygniata duszę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609536
    m_Localized: 'Cultist1: Beton aż cuchnie przelaną krwią.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609537
    m_Localized: 'Cultist1: Niech pan nie myśli, że naglimy pana do mordu. Przelewa pan krew z własnej inicjatywy i bez naszej agitacji.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609538
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609539
    m_Localized: 'Cultist1: Wierzę, że pana więź ze Śmiercią jest mocniejsza niż któregokolwiek z nas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609540
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609541
    m_Localized: Co to za stosy drewna, które panowie układacie na zewnątrz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609542
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609543
    m_Localized: 'Cultist1: Nadchodzi nasza pora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609544
    m_Localized: 'Cultist1: Podziemne Anioły wezmą nasze popioły jako dar i udzielą przejścia do królestwa Śmierci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609545
    m_Localized: 'Cultist1: W ten sposób zyskamy Jej łaskawość.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609546
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609547
    m_Localized: Wygląda pan na przestraszonego
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609548
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609549
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609550
    m_Localized: 'Cultist2: Jest pan spostrzegawczy, gospodarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609551
    m_Localized: 'Cultist2: W przeciwieństwie do moich braci w wierze… Wciąż zmagam się z obawą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609552
    m_Localized: 'Cultist2: Dręczą mnie wątpliwości: co jest po życiu? Jak tam jest?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609553
    m_Localized: 'Cultist2: Nasz guru uczy, iż nie jest to ani Niebo, ani Piekło, tylko coś zupełnie innego. Nie pojmuję tego…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609554
    m_Localized: 'Cultist2: Jeśli nawet on w pełni nie rozumie Śmierci, czy nam to będzie dane?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609555
    m_Localized: 'Cultist2: Co, jeśli samo padnięcie u Jej stóp nie wystarczy? Co, jeśli Ona wymyka się naszemu zrozumieniu…?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609556
    m_Localized: 'Cultist2: Nie ważę się podważać zdania guru, gdyż w jego oczach widzę pewność i obeznanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609557
    m_Localized: 'Cultist2: Ponagla nas do przyjęcia wiary i umocnienia woli. Do gotowości.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609558
    m_Localized: 'Cultist2: Tylko wtedy przekroczymy rzeki umarłych i góry kości. Trafimy do Niej…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609559
    m_Localized: 'Cultist2: …do Śmierci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609560
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609561
    m_Localized: Dlaczego oddajecie hołd śmierci?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609562
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609563
    m_Localized: 'Cultist2: Proszę, łaskawy gospodarzu. Nie wyrażaj się nieprzychylnie o Śmierci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609564
    m_Localized: 'Cultist2: Ona gardzi bluźniercami, którzy mają Ją za niesprawiedliwą, i karze ich bez litości.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609565
    m_Localized: 'Cultist2: Przeraża mnie Jej istota, ale guru rzecze, iż Śmierć jest najłaskawszą ze wszystkich bogów i bogiń.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803584
    m_Localized: 'Cultist2: Nie przynosi głodu, choroby ani wojny. Ofiarowuje jeno… wieczny spoczynek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803585
    m_Localized: 'Cultist2: A my musimy przed Nią stanąć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803586
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803587
    m_Localized: Dlaczego tak ochoczo chcecie spotkać śmierć?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803588
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803589
    m_Localized: 'Cultist2: Ta podróż nie jest naszym wyborem. Takoż życzy sobie Ona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803590
    m_Localized: 'Cultist2: Wezwała nas. Pragnie nas w swoim królestwie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803591
    m_Localized: 'Cultist2: Guru mówi, że to dlatego słońce pali teraz tak niemożebnie. Stara się zmieść nas z powierzchni.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803592
    m_Localized: 'Cultist2: Śmierć oferuje ciszę, spokój i jedność. To w jej dziedzinie dane nam będzie się zjednoczyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803593
    m_Localized: 'Cultist2: Na próżno opłakujemy zmarłych, zapominając, iż znów ich kiedyś spotkamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803594
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803595
    m_Localized: Co planujecie zrobić?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803596
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803597
    m_Localized: 'Cultist2: Nadszedł czas…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803598
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803599
    m_Localized: 'Cultist2: B‑boję się. Wciąż drżę… Lecz muszę przyjąć wiarę i umocnić wolę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803600
    m_Localized: 'Cultist2: Guru we mnie wierzy. Nie mogę go zawieść.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803601
    m_Localized: 'Cultist2: Strach wszakże… nie daje mi spokoju.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803602
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803603
    m_Localized: 'Cultist2: Uwolnij nas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803604
    m_Localized: 'Cultist2: Uwolnij nas. UWOLNIJ NAS!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803605
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803606
    m_Localized: Na jak długo panowie zostają?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803607
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803608
    m_Localized: 'Cultist3: Nie troskaj się, gospodarzu. Nie będziemy jarzmem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803609
    m_Localized: 'Cultist3: Szanujemy twoją gościnę i nie naszym zamiarem cię irytować. Już tyle dla nas, gospodarzu, żeś zrobił.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803610
    m_Localized: 'Cultist3: Spoczniemy w tym pokoju i zajmiemy się cichą modlitwą.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803611
    m_Localized: 'Cultist3: Potrzeba nam wytchnienia. Dalsza podróż będzie długa i ciężka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803612
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803613
    m_Localized: Dokąd panowie zmierzają?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803614
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803615
    m_Localized: 'Cultist3: Do ziem intruzów.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803616
    m_Localized: 'Cultist3: Ludzkie życie nie jest wieczne. Jesteśmy ledwie gośćmi na tym padole. Przybyliśmy i odejdziemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803617
    m_Localized: 'Cultist3: Intruzi muszą po nas przejąć te ziemie. Osiąść tu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803618
    m_Localized: 'Cultist3: Ich przybycie to nie przypadek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803619
    m_Localized: 'Cultist3: Przyzwała ich tu Śmierć…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803620
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803621
    m_Localized: Z jakiego powodu pan uważa, że śmierć wezwała Przybyszy?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803622
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803623
    m_Localized: 'Cultist3: Twierdzę tak, gdyż Śmierć nie wyróżnia czy to człowiek, bestia, intruz…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803624
    m_Localized: 'Cultist3: Śmierć jest tym samym dla wszystkich i wszystkiego. Przed Nią wszyscy jesteśmy równi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803625
    m_Localized: 'Cultist3: Oczekiwała na ten właśnie moment, a teraz czas niemal nadszedł.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803626
    m_Localized: 'Cultist3: Musimy przygotować się do rytuału…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803627
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803628
    m_Localized: Co to będzie za rytuał?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803629
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803630
    m_Localized: 'Cultist3: Nastał czas przejścia, podróży do naszego siedliska.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803631
    m_Localized: 'Cultist3: Trzeba nam udać się w objęcia Śmierci, do krainy wiecznego spokoju i ukojenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803632
    m_Localized: 'Cultist3: Pora stąd odejść…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803633
    m_Localized: 'FatalDame: Tak, mój miły? O czym myślisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803634
    m_Localized: Jak ci się tu podoba?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803635
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803636
    m_Localized: 'FatalDame: Jest przytulnie. Przyjemniej, niż się spodziewałam… w tych okolicznościach.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803637
    m_Localized: 'FatalDame: Dzięki, że mnie wpuściłeś. Obawiałam się, że zostanę na ulicy do rana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803638
    m_Localized: 'FatalDame: A ty? Jak się czujesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803639
    m_Localized: Zlękniony
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803640
    m_Localized: W porządku. Przeżycie jest najważniejsze
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803641
    m_Localized: 'FatalDame: Rozumiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803642
    m_Localized: 'FatalDame: Ostatnimi czasy… planowanie na zapas to nonsens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803643
    m_Localized: 'FatalDame: Nigdy nie wiesz, co cię dopadnie jako pierwsze: słońce, szaleńcy czy Przybysze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803644
    m_Localized: 'FatalDame: Ludzkość jednakże przetrwała mnóstwo katastrof.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803645
    m_Localized: 'FatalDame: Jak nas zabranie, zostawimy po sobie pewną spuściznę.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803646
    m_Localized: 'FatalDame: Ktoś odnajdzie nasze ślady.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803647
    m_Localized: 'FatalDame: Będzie dobrze, mój miły.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803648
    m_Localized: 'FatalDame: Cenię takie nastawienie. Do twarzy ci z nim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803649
    m_Localized: 'FatalDame: Ale nie duś wszystkiego w sobie, dobrze? Emocje mają w zwyczaju gwałtownie się wylewać…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803650
    m_Localized: 'FatalDame: Zwłaszcza w momentach, gdy ich wcale nie chcesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803651
    m_Localized: 'FatalDame: Nie wstydź się porozmawiać o tym ze mną.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803652
    m_Localized: 'FatalDame: A jeśli nie ze mną, to z kimś innym. Kimkolwiek.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803653
    m_Localized: 'FatalDame: Obiecaj mi to, dobrze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803654
    m_Localized: 'FatalDame: Tak, mój miły? O czym myślisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803655
    m_Localized: Zeszłej nocy widziałem coś dziwnego
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803656
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803657
    m_Localized: 'FatalDame: Naprawdę? Co takiego?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803658
    m_Localized: Twój brzuch. Był większy
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803659
    m_Localized: Nic takiego… może tylko mi się zdawało
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803660
    m_Localized: 'FatalDame: Znaczy się… jakbym była w ciąży?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803661
    m_Localized: 'FatalDame: Aha, w porządku, mój miły. Dobrze, że jesteś ze mną szczery.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803662
    m_Localized: 'FatalDame: Może jesteś pod ogromną presją? Odpowiadasz teraz za wielu ludzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803663
    m_Localized: 'FatalDame: Rozumiem, mój miły. Każdy wschód słońca może być naszym ostatnim. Trudno opiekować się sobą, a co dopiero innymi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803664
    m_Localized: 'FatalDame: Nawet nie wiemy, czy dożyjemy jutra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803665
    m_Localized: Tak… to mnie przeraża
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803666
    m_Localized: Nie, nie o to chodzi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803667
    m_Localized: 'FatalDame: Więc coś nie daje ci spokoju?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803668
    m_Localized: 'FatalDame: To nic takiego, mój miły. Wszyscy się boimy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803669
    m_Localized: 'FatalDame: Widziałam cię, wiesz? Wstajesz późno w nocy, robisz obchody.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803670
    m_Localized: 'FatalDame: Jak na kogoś tak skrytego, naprawdę zależy ci na tych, których u siebie gościsz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803671
    m_Localized: 'FatalDame: To… ciekawe. Jesteś pełen przeciwieństw.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803672
    m_Localized: 'FatalDame: A może tylko z braku snu. Strach jest okropnym kochankiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803673
    m_Localized: Tak… to mnie przeraża
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803674
    m_Localized: Nie, nie o to chodzi
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803675
    m_Localized: 'FatalDame: Potrzeba odwagi, żeby się do tego przyznać, mój miły.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803676
    m_Localized: 'FatalDame: Co możemy począć ze strachem, hmm?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803677
    m_Localized: 'FatalDame: Przyznasz przecież, że… życie ma swój koniec? Że wszyscy umrzemy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803678
    m_Localized: 'FatalDame: Ważne jest, co przyniesie ci zbawienie. Czy możesz to jeszcze odnaleźć?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803679
    m_Localized: 'FatalDame: W porządku.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803680
    m_Localized: 'FatalDame: Tak czy siak, martwię się o ciebie, mój miły. Zadbaj o siebie czasem, dobrze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803681
    m_Localized: 'FatalDame: Chcę, abyś czuł się bezpieczny. W końcu żyjemy pod tym samym dachem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803682
    m_Localized: 'FatalDame: Kiedy jednak tobie zacznie brakować piątej klepki, to potem i nas czeka oklep…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803683
    m_Localized: 'FatalDame: Żarcik niezamierzony…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803684
    m_Localized: 'FatalDame: Ale całkiem śmieszny, prawda, mój miły?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803685
    m_Localized: 'FatalDame: Tak, mój miły? O czym myślisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803686
    m_Localized: Wiem, że wczoraj byłaś w ciąży. Wyjaśnij to
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803687
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803688
    m_Localized: 'FatalDame: Zaczynam się ciebie bać…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803689
    m_Localized: 'FatalDame: Jesteś pewien, że coś widziałeś w nocy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803690
    m_Localized: 'FatalDame: Czemu mnie nie obudziłeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803691
    m_Localized: 'FatalDame: Czy znów przemawia przez ciebie obawa przed śmiercią? Czy może trudy opieki nad innymi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803692
    m_Localized: 'FatalDame: A może to ja…? Czy może chodzi ci po głowie ktoś inny?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803693
    m_Localized: Cholera, nie mieszaj mi w głowie
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803694
    m_Localized: Ale… byłem pewien, że coś widziałem
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803695
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803696
    m_Localized: 'FatalDame: Wspominałeś ostatnio o swoim ojcu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803697
    m_Localized: 'FatalDame: Później już o nim nie mówiłeś, więc nie wiem wiele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803698
    m_Localized: 'FatalDame: Teraz… mam takie dziwne przeczucie, że jesteś zupełnie jak on. Lustrzane odbicie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803699
    m_Localized: 'FatalDame: Obawiasz się tego?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803700
    m_Localized: 'FatalDame: Że utkwiłeś w jego cieniu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803701
    m_Localized: 'FatalDame: Przecież go wykreśliłeś ze swojego życia, prawda? Po co wtedy wracasz do tych wspomnień?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803702
    m_Localized: 'FatalDame: Nie spotkacie się po drugiej stronie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803703
    m_Localized: 'FatalDame: Zdaje się, że udamy się do innych miejsc, więc nie przejmuj się, mój miły.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803704
    m_Localized: 'FatalDame: Nie szukaj odpowiedzi na wszystkie pytania naraz. Trakt buduje się kamień po kamieniu. Rozumiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803705
    m_Localized: 'FatalDame: I, mój miły… Już nigdy się tak do mnie nie odzywaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803706
    m_Localized: 'FatalDame: Przykro mi patrzeć, co się z tobą dzieje.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803707
    m_Localized: 'FatalDame: Nie powinieneś obawiać się śmierci ani odpowiedzialności, ani bliskości, ani niczego innego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803708
    m_Localized: 'FatalDame: To wszystko jest częścią życia, mój miły.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803709
    m_Localized: 'FatalDame: Nie szukaj odpowiedzi na wszystkie pytania naraz. Trakt buduje się kamień po kamieniu. Rozumiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803710
    m_Localized: 'FatalDame: Pomocna jest myśl, że nie znikamy zupełnie, gdy nadchodzi nasza pora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803711
    m_Localized: 'FatalDame: Zwykłam wierzyć w niebo i piekło, ale teraz? Nie jestem pewna.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803712
    m_Localized: 'FatalDame: Może jest tam coś zupełnie innego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803713
    m_Localized: 'FatalDame: Co ty na to?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803714
    m_Localized: 'FatalDame: Tak, mój miły? O czym myślisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803715
    m_Localized: Jesteś w ciąży i niedługo masz poród, czy to prawda?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803716
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803717
    m_Localized: 'FatalDame: Och.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803718
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803719
    m_Localized: 'FatalDame: Widzę, że zupełnie ogarnęła cię rozpacz, nieprawdaż?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803720
    m_Localized: 'FatalDame: Wszystko, w co wierzyłeś, okazuje się nieprawdą… i nie masz sił się z tym pogodzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803721
    m_Localized: 'FatalDame: Czy to dlatego, że tak bardzo nie chcesz udać się tam, dokąd zmierzamy?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803722
    m_Localized: 'FatalDame: Czy może dlatego, że nie już nie pasujesz do tego świata? Albo nawet do żadnego świata?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803723
    m_Localized: Przestań mącić. Jesteś w ciąży
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803724
    m_Localized: A ty się nie boisz?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803725
    m_Localized: 'FatalDame: Mój miły… to przecież niemożliwe. Spójrz, nie mam nawet małego brzuszka.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803726
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803727
    m_Localized: 'FatalDame: Mogę cię o coś spytać?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803728
    m_Localized: 'FatalDame: Gdyby to dziecię było prawdziwe…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803729
    m_Localized: 'FatalDame: I, tak jak mówisz, poród byłby niedługo…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803730
    m_Localized: 'FatalDame: Co byś wtedy zrobił, mój miły? Odszukałbyś je?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803731
    m_Localized: Ono nie powinno istnieć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803732
    m_Localized: Jeszcze nie wiem
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803733
    m_Localized: 'FatalDame: Hm. Dobre pytanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803734
    m_Localized: 'FatalDame: Tak, boję się umrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803735
    m_Localized: 'FatalDame: Głównie dlatego, że nie jestem pewna, co jest potem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803736
    m_Localized: 'FatalDame: Niebo, reinkarnacja czy coś innego.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803737
    m_Localized: 'FatalDame: Nikt nigdy nie wrócił, żeby zdać relację.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803738
    m_Localized: 'FatalDame: Ale wracając do twojej wizji…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803739
    m_Localized: 'FatalDame: Gdyby to dziecię było prawdziwe…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803740
    m_Localized: 'FatalDame: I, tak jak mówisz, poród byłby niedługo…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803741
    m_Localized: 'FatalDame: Co byś wtedy zrobił, mój miły? Odszukałbyś je?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803742
    m_Localized: Ono nie powinno istnieć
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803743
    m_Localized: Jeszcze nie wiem
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803744
    m_Localized: 'FatalDame: Czasem instynktownie chcemy zachować to, co znane… nawet jeśli już nam nie służy…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803745
    m_Localized: 'FatalDame: Być może…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803746
    m_Localized: 'FatalDame: Może już czas otworzyć umysł na coś nowego?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803747
    m_Localized: 'FatalDame: Czy aż tak lękasz się nieznanego?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803748
    m_Localized: Znajdę to dziecko
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803749
    m_Localized: Nadchodzi. Wiem to
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803750
    m_Localized: 'FatalDame: Nie obawiaj się odpuszczać. Zwłaszcza wtedy, gdy coś ci już nie służy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803751
    m_Localized: 'FatalDame: Czasem kurczowo trzymamy się czegoś tylko dlatego, że to znamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803752
    m_Localized: 'FatalDame: Tak, zmiana przyzwyczajeń jest bolesna… ale kto wie, dokąd nas zabierze?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803753
    m_Localized: Znajdę to dziecko
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803754
    m_Localized: Nadchodzi. Wiem to
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803755
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803756
    m_Localized: 'FatalDame: Skoro tak mówisz, mój miły.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803757
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803758
    m_Localized: 'FatalDame: Powiedz mi, co znajdziesz… gdy nadejdzie pora.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713856
    m_Localized: 'Neighbour: Dobra, ode mnie to wszystko.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713857
    m_Localized: 'Neighbour: Och, racja, prawie zapomniałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713858
    m_Localized: 'Neighbour: Jutro w nocy wracam do domu. Zapisz sobie mój numer, niedawno podłączyli nam telefon.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713859
    m_Localized: 'Neighbour: {0}. Będziemy w kontakcie przez telefon.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713860
    m_Localized: 'Neighbour: Dobra, teraz to na pewno wszystko.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713861
    m_Localized: 'Neighbour: Golnij piwko i prześpij się.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491133
    m_Localized: 'Cat: Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491134
    m_Localized: Pogłaszcz kota
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491135
    m_Localized: Podnieś kota
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491136
    m_Localized: Nakarm kota jedzeniem z puszki
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491137
    m_Localized: 'Cat: (Sięgasz ręką i głaszczesz kota).'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491138
    m_Localized: 'Cat: (Trudno stwierdzić, czy mu się to podoba, czy nie).'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491139
    m_Localized: 'Cat: Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491140
    m_Localized: Pogłaszcz kota
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491141
    m_Localized: Podnieś kota
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491142
    m_Localized: Nakarm kota jedzeniem z puszki
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491143
    m_Localized: 'Cat: (Decydujesz się pogłaskać kota).'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491144
    m_Localized: 'Cat: (Chyba mu się to podoba).'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491145
    m_Localized: 'Cat: (Nie jest taki markotny, jak się z początku wydawało).'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491146
    m_Localized: 'Cat: (Zdaje się do ciebie przyzwyczajać).'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491147
    m_Localized: 'Cat: Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491148
    m_Localized: Pogłaszcz kota
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491149
    m_Localized: Podnieś kota
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491150
    m_Localized: Nakarm kota jedzeniem z puszki
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491151
    m_Localized: 'Cat: (Kotek bardzo lubi być tak często głaskany).'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491152
    m_Localized: 'Cat: (Zdaje się, że podsuwa główkę do głaskania).'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491153
    m_Localized: 'Cat: (Jak można by odmówić takiemu słodziakowi?).'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491154
    m_Localized: 'Cat: Miau! MIAU! Miau!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491155
    m_Localized: 'Cat: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491156
    m_Localized: 'Cat: (Ciężko coś wyczytać z jego małego pyszczka, ale wygląda na to, że jest szczęśliwy).'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491157
    m_Localized: 'Cat: (Masz dziwne przeczucie, że możesz dziś spać spokojnie).'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491158
    m_Localized: 'Cat: (Czujesz, że twój futrzasty przyjaciel podzielił się z tobą w podzięce jednym z jego żyć).'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491159
    m_Localized: 'Cat: (Któż wie… może śmierć ominie dziś twój dom).'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547465932800
    m_Localized: 'Teacher: Te biedne dzieciaczki…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292928
    m_Localized: Czy coś się stało?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292929
    m_Localized: Chcę panią sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292930
    m_Localized: 'Teacher: Hę?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292931
    m_Localized: 'Teacher: Tak tylko… myślałam…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292932
    m_Localized: 'Teacher: Jeśli to nie jest następny przypadek masowego wymierania i jakoś przeżyjemy… Co poczniemy, gdy to przeminie?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292933
    m_Localized: 'Teacher: Jaka przyszłość nas czeka?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292934
    m_Localized: Obawia się pani, że w nowym świecie zabraknie dla pani miejsca?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292935
    m_Localized: Wrażliwe osoby nie przetrwają długo w obecnej sytuacji. Niech się pani kogoś blisko trzyma
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292936
    m_Localized: 'Teacher: Wrażliwe osoby…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292937
    m_Localized: 'Teacher: Nie znoszę przemocy… nie wspominając o jej stosowaniu. Nie jestem taką osobą.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292938
    m_Localized: 'Teacher: Nie mam pewności, czy… jak pan to nazwał? „Nowym świecie”? Czy będę do niego pasowała.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292939
    m_Localized: Ale nie podda się pani chyba i nie będzie czekać na śmierć?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292940
    m_Localized: Ma pani inne wyjście?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292941
    m_Localized: Mroczne czasy to nie pierwszyzna dla ludzkości…
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292942
    m_Localized: 'Teacher: Tego bym nie chciała. Nawet jeśli miałabym kogoś, na kim mogę polegać…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292943
    m_Localized: 'Teacher: Mordom nie byłoby końca. Przemoc prowadzi donikąd.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292944
    m_Localized: Ale nie podda się pani chyba i nie będzie czekać na śmierć?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292945
    m_Localized: Ma pani inne wyjście?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292946
    m_Localized: Mroczne czasy to nie pierwszyzna dla ludzkości…
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292947
    m_Localized: 'Teacher: Jestem taka zagubiona.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292948
    m_Localized: 'Teacher: Czy doprawdy od teraz po wsze czasy będą wszędzie otaczać nas mordercy?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292949
    m_Localized: 'Teacher: Czy w tym nowym świecie nasze dzieci będą przyjmować nauki od zabójców i rozbójników?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292950
    m_Localized: Nie możemy sobie pozwolić na zamartwianie się
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292951
    m_Localized: PROSZĘ SIĘ WZIĄĆ W GARŚĆ!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292952
    m_Localized: 'Teacher: Nie wiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292953
    m_Localized: 'Teacher: Nie mam nic do zaoferowania.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292954
    m_Localized: 'Teacher: Chcę tylko, aby się to wszystko skończyło.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292955
    m_Localized: 'Teacher: Więcej… nie wytrzymam.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292956
    m_Localized: 'Teacher: Tak, nie myli się pan, lecz…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292957
    m_Localized: 'Teacher: Jak mamy teraz żyć?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292958
    m_Localized: 'Teacher: Cały świat oszalał, zabiją cię za… najmniejsze odstępstwo od normy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292959
    m_Localized: 'Teacher: Bez znaczenia, kto stanie im na drodze.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292960
    m_Localized: Nie możemy sobie pozwolić na zamartwianie się
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292961
    m_Localized: PROSZĘ SIĘ WZIĄĆ W GARŚĆ!
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292962
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292963
    m_Localized: 'Teacher: Dlaczego nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292964
    m_Localized: 'Teacher: Nieczułość może służy panu w radzeniu sobie z tym wszystkim, ale nie mnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292965
    m_Localized: 'Teacher: Jeśli tylko by pan widział to, co ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292966
    m_Localized: 'Teacher: Każdą chwilę… będę widziała po wieczność przy każdym zamknięciu oczu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292967
    m_Localized: 'Teacher: Ogień. Wrzaski. Przerażone małe twarzyczki. Rodziny i domy… zniszczone.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292968
    m_Localized: 'Teacher: Nie mogę być jak pan. Nie jestem dość silna.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292969
    m_Localized: 'Teacher: Dla podobnych mnie… jest tylko jedno wyjście.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292970
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292971
    m_Localized: 'Teacher: (Kobieta wzdryga się, spogląda na ciebie ze strachem).'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292972
    m_Localized: 'Teacher: (Wstrząs pomógł jej zapomnieć o koszmarze, ale tylko na moment).'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292973
    m_Localized: 'Teacher: (Zakrywa twarz dłońmi i płacze cicho).'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292974
    m_Localized: 'Teacher: (Nie wiesz, co masz zrobić. Nikt nie pokazał ci, jak radzić sobie w takich sytuacjach).'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292975
    m_Localized: 'Teacher: (Ostrożnie kładziesz dłoń na jej ramieniu i stoisz tak w ciszy przez chwilę).'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292976
    m_Localized: 'Teacher: (Najlepiej pewnie zostawić ją w spokoju).'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487232
    m_Localized: 'Mother: Hej, mam pomysł. Może to pan do niego zadzwoni? Jego numer to {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487233
    m_Localized: 'Mother: Niech mu pan powie, co o nim myślę.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487234
    m_Localized: 'Mother: Przecież to są też jego dzieci. Powinien pomagać w opiece nad nimi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487235
    m_Localized: 'Anger: Jeśli uda się panu połączyć, czy zadzwoni pan do niej w moim imieniu? Numer to: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487236
    m_Localized: 'Anger: Proszę jej powiedzieć, że… jest mi przykro… i wciąż chcę się za to ukatrupić.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487237
    m_Localized: 'Anger: Albo może pan na nią nakrzyczeć. Sam nie wiem… Może wtedy będzie łatwiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487238
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875840
    m_Localized: 'FortuneTeller: Niektórzy uważają, że rady z zaświatów mogą pomóc…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875841
    m_Localized: 'FortuneTeller: Są ludzie… eksperci… którzy wiedzą, jak oczyścić mrok.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875842
    m_Localized: 'FortuneTeller: Jeśli pan chce, zapoznam pana z nimi. Wyczuwam, że może ich pan potrzebować…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875843
    m_Localized: 'FortuneTeller: Proszę zadzwonić pod numer: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875844
    m_Localized: 'FortuneTeller: I proszę wspomnieć, że jest pan ode mnie…!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547533041664
    m_Localized: 'Alkonost: Jeśli to nie kłopot, czy mógłby pan do niego zatelefonować? Jego numer to: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235968
    m_Localized: 'Foreigner: (Wręcza ci kawałek papieru z zapisanym numerem telefonu: {0}).'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235969
    m_Localized: 'Foreigner: (Być może to numer kontaktowy do ambasady).'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818880
    m_Localized: 'Jacob: Ależ bym się teraz napił…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818881
    m_Localized: Co miał pan na myśli, mówiąc, że jesteśmy „nieśmiertelni”?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818882
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818883
    m_Localized: 'Jacob: Jeśli pan chce, mógłby pan strzelić sobie w łeb i samemu sprawdzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818884
    m_Localized: 'Jacob: Ale osobiście nie polecam.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818885
    m_Localized: 'Jacob: To jasne, że nie jesteśmy nieśmiertelni w sposób, o którym pan myśli.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818886
    m_Localized: 'Jacob: Po śmierci czeka nas reinkarnacja i ponowne życie. Wtedy znowu umieramy i cykl odrodzenia się powtarza.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818887
    m_Localized: 'Jacob: Wiem, jak to brzmi, ale gdyby widział pan to, co ja… zrozumiałby pan.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818888
    m_Localized: 'Jacob: Może Przybysze byli ludźmi, a teraz są odrodzeni.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818889
    m_Localized: 'Jacob: Ciężko powiedzieć. Nie wiem, jak to draństwo działa…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818890
    m_Localized: 'Jacob: Przyroda z całą pewnością skrywa przed nami masę sekretów.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818891
    m_Localized: 'Jacob: Niemniej jednak kiedyś odnajdę córkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818892
    m_Localized: 'Jacob: Jeśli nie w tym życiu to w następnym… ale znajdę ją.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818893
    m_Localized: 'Jacob: Bo tak naprawdę nigdy nie umieramy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818894
    m_Localized: 'Jacob: Ależ bym się teraz napił…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818895
    m_Localized: Dlaczego FEMA pana szuka?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818896
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818897
    m_Localized: 'Jacob: Byłem w samym centrum wydarzeń, gdy zaczynało się całe to gówno.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818898
    m_Localized: 'Jacob: W okolicy, skąd zaczęły wypełzać te szkaradztwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818899
    m_Localized: 'Jacob: Słyszał pan kiedyś te niedorzeczne miejskie legendy o demonach na przedmieściach?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818900
    m_Localized: 'Jacob: Nieważne, teraz nikt nie pamięta o takich rzeczach.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818901
    m_Localized: 'Jacob: Jak się okazuje, to nie były tylko plotki. A FEMA wiedziała od początku.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818902
    m_Localized: 'Jacob: Twierdzili, że nie dzieje się nic nadprzyrodzonego.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818903
    m_Localized: 'Jacob: A teraz słońce przypala wszystkich na węgielki…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818904
    m_Localized: 'Jacob: Podczas gdy straszydła spod ziemi wykańczają ocalałych.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818905
    m_Localized: 'Jacob: Wtedy w FEMA zdali sobie sprawę, że poważnie schrzanili sprawę…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818906
    m_Localized: 'Jacob: I starają się ze wszystkich sił zamieść swoją nieudolność pod dywan…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818907
    m_Localized: 'Jacob: Przypadkowo znalazłem się w złym miejscu o złej porze.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818908
    m_Localized: 'Jacob: Ależ bym się teraz napił…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818909
    m_Localized: Jak pan przeżył?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818910
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818911
    m_Localized: 'Jacob: Zapomniał pan? Jestem nieśmiertelny.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818912
    m_Localized: 'Jacob: Sam nie wiem…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818913
    m_Localized: 'Jacob: Wciąż zadaję sobie to samo pytanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818914
    m_Localized: 'Jacob: Może miałem fuksa. A może czuwa nade mną jakaś ponadludzka moc…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818915
    m_Localized: 'Jacob: Bóg, czy jakkolwiek to nazwać.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818916
    m_Localized: 'Jacob: Być może już nie żyję i odrodziłem się w tej postaci. Nie mam pewności.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818917
    m_Localized: 'Jacob: Dobre pytanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818918
    m_Localized: 'Jacob: Szkoda, że nie mam broni, zapytałbym się o to samo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818919
    m_Localized: 'Jacob: I szkoda, że nie ma pan nic innego prócz piwa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818920
    m_Localized: 'Jacob: Gdybym miał beczułkę, uwarzyłbym nam świetną partię.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818921
    m_Localized: 'Jacob: Ależ bym się teraz napił…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818922
    m_Localized: Co jeszcze pan wie?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818923
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818924
    m_Localized: 'Jacob: Całą strukturę wewnętrzną FEMA znam od podszewki.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818925
    m_Localized: 'Jacob: Hierarchię, obowiązki, kto z kim sypia. Wszystko.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818926
    m_Localized: 'Jacob: Te łajdaki wiedziały wszystko o Przybyszach i jak bardzo są niebezpieczni…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818927
    m_Localized: 'Jacob: I mimo tego wpuścili ich do miasta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818928
    m_Localized: 'Jacob: Wszyscy tam mają w dupie nasze bezpieczeństwo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818929
    m_Localized: 'Jacob: Zajęci byli defraudacją rządowych środków.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818930
    m_Localized: 'Jacob: Wszyscy tego świadkowie także padli ich ofiarą.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818931
    m_Localized: 'Jacob: Nie chcieli, żeby to wyszło na jaw.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818932
    m_Localized: 'Jacob: To działo się nawet, zanim powstały strefy kwarantanny.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818933
    m_Localized: 'Jacob: Ledwo udało mi się uciec.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818934
    m_Localized: 'Jacob: Chce pan poznać odrobinę supertajnych informacji? No więc…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818935
    m_Localized: 'Jacob: Za wszystko ponosi winę FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818936
    m_Localized: 'Jacob: Wszystko, co mówią w telewizji, można od kant dupy roztrzaskać.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818937
    m_Localized: 'Jacob: Jeśli istnieje coś gorszego od Przybyszy…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818938
    m_Localized: 'Jacob: To jest to FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818939
    m_Localized: 'Jacob: Ależ bym się napił…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818940
    m_Localized: Skąd się wzięli Przybysze?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818941
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818942
    m_Localized: 'Jacob: Ze skraju miasta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818943
    m_Localized: 'Jacob: Tak, wiem, że to daleko od stref kwarantanny…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818944
    m_Localized: 'Jacob: Ale jestem pewien.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818945
    m_Localized: 'Jacob: Nie jestem przesądny, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818946
    m_Localized: 'Jacob: To te same diabły, o których mówili ludzie dwa lata temu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818947
    m_Localized: 'Jacob: Nie wiem, jak dostały się do miasta…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818948
    m_Localized: 'Jacob: Ale wiem, kto do tego dopuścił.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818949
    m_Localized: 'Jacob: FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818950
    m_Localized: 'Jacob: Przybysze to nie jacyś kosmici, jak wielu uważa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818951
    m_Localized: 'Jacob: To żyjące istoty jak ja lub pan.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818952
    m_Localized: 'Jacob: I są tak samo jak my rdzennymi mieszkańcami planety!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818953
    m_Localized: 'Jacob: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818954
    m_Localized: 'Jacob: Nie mogę tu dłużej zostać.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818955
    m_Localized: 'Jacob: Muszę odnaleźć córkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818956
    m_Localized: 'Jacob: Dziękuję… nieśmiertelny.'
    m_Metadata:
      m_Items: []
  - m_Id: 53577620711792640
    m_Localized: 'Player: (Wygląda na to, że rozmowa dobiegła końca).'
    m_Metadata:
      m_Items: []
