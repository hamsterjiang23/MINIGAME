  - m_Id: 55784900568014861
    m_Localized: 'Wolfhound: Niech tak będzie…'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792075
    m_Localized: 'Player: Co to takiego?'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792076
    m_Localized: 'Player: …'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792077
    m_Localized: 'Player: Dobra, wezmę to.'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792078
    m_Localized: 'Player: Co? Oddajesz mi to?'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792079
    m_Localized: 'Player: …'
    m_Metadata:
      m_Items: []
  - m_Id: 55784900584792080
    m_Localized: 'Player: Teraz to po mnie przyjdą…'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539790462976
    m_Localized: Dobre pytanie
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434496
    m_Localized: Nie czekam
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434497
    m_Localized: 'Ballerina: Moje pytanka? Ty lubić? Czemuż?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434498
    m_Localized: 'Ballerina: Odpowiedź. Zawsze unika pytań.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434499
    m_Localized: 'Ballerina: Taki jak on.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434500
    m_Localized: Nie. Czekam. Na. Nic
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434501
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434502
    m_Localized: 'Ballerina: Tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434503
    m_Localized: 'Ballerina: Co ty tak robić? Siedzenie w mnogich ścianach.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434504
    m_Localized: 'Ballerina: Długo, długo czekanie. Po ludzie? Po odpowiedź?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434505
    m_Localized: Nie. Czekam. Na. Nic
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434506
    m_Localized: Wyciągnij broń
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434507
    m_Localized: 'Ballerina: Jak tam sobie chce. Ja też, tak przy okazja.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434508
    m_Localized: 'Ballerina: Och, już powiedziała. Ja czekamy.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434509
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434510
    m_Localized: 'Ballerina: Tako czy owako. Ona przyjdą. Ja wiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434511
    m_Localized: 'Ballerina: HA, HA, HA, HA, HA!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434512
    m_Localized: 'Ballerina: MIŁOŚĆ TANIEC. Pokazała? Strzel i patrzaj!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434513
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434514
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434515
    m_Localized: 'Ballerina: Ta‑da!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434516
    m_Localized: 'Ballerina: Próba jeszcze raz?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434517
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434518
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434519
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434520
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434521
    m_Localized: 'Ballerina: Trele morele!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434522
    m_Localized: 'Ballerina: Stoję blisko. A jednak…!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434523
    m_Localized: 'Ballerina: Strzelasz z zamkniętym okami? Czy może tylko dużo głupi?'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434524
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434525
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434526
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434527
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434528
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434529
    m_Localized: Zastrzel ją
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434530
    m_Localized: 'Ballerina: Tra, la, la, la!'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434531
    m_Localized: 'Ballerina: Ja zmęczenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 57953539811434532
    m_Localized: 'Ballerina: Robaki niech zeżrą. Szybciej.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683264
    m_Localized: 'Foreigner: Ył fł qvhf?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683265
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683266
    m_Localized: 'Foreigner: Łpvq, dvbńu fł…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683267
    m_Localized: 'Unstable: Kurczę, jadę na oparach…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683268
    m_Localized: Co to za historie, o których wspominałeś?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683269
    m_Localized: 'Unstable: A, tak… Może nawzajem coś sobie opowiemy? Chcesz zacząć?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683270
    m_Localized: Nic tobie nie opowiem
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683271
    m_Localized: Przejdź do sedna
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683272
    m_Localized: 'Unstable: Jasne, jasne. Bez przymusu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683273
    m_Localized: 'Unstable: Więęęc… Byłem w barze, no nie? A może to nie był bar? Mogłem być gdzieś indziej.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683274
    m_Localized: 'Unstable: Kuuurde, jak to się nazywało…?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683275
    m_Localized: No i…?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683276
    m_Localized: 'Unstable: Racja, racja.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683277
    m_Localized: 'Unstable: Nieważne. A więc, pilnuję swojego nosa i siorbię sobie EnerJekę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683278
    m_Localized: 'Unstable: Staaary, uwielbiam ten napój. Nie masz pojęcia, jak bardzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683279
    m_Localized: 'Unstable: Normalnie… czacha dymi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683280
    m_Localized: 'Unstable: Posmak pozostaje na cały dzień! Szkoda, że nie sprzedają jej wszędzie…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683281
    m_Localized: A więc…?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683282
    m_Localized: 'Unstable: Ach, tak… na czym to ja skończyłem…?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683283
    m_Localized: 'Unstable: Siedzę tam, no nie? Prawie nie ma ludzi. Muzyka wali mi po uszach.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683284
    m_Localized: 'Unstable: I wtedy słyszę czyiś krzyk. Na tyle głośny, że usłyszałem go w słuchawkach.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683285
    m_Localized: 'Unstable: I to samym środku najlepszej partii. A ja nie lubię, kiedy mi się przeszkadza w słuchaniu muzyki, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683286
    m_Localized: 'Unstable: Na przykład gdy… wczuwam się dźwięk i świat jakby przestawał istnieć…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683287
    m_Localized: Co, do chuja?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683288
    m_Localized: 'Unstable: Dobra, dobra.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683289
    m_Localized: 'Unstable: Zrywam słuchawki z uszu i widzę, jak jakiś wysoki gość wrzeszczy na jakiegoś typka.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683290
    m_Localized: 'Unstable: Nie wiem, o co poszło, ale gość zdania nie potrafił sklecić. Pijany w trzy dupy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683291
    m_Localized: 'Unstable: Wysoki krzyczy, a potem sprzedaje drugiemu takiego plaskacza, że tamten padł jak długi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683292
    m_Localized: 'Unstable: Ale to nie koniec. Wysoki włazi na bar, ledwo trzyma się na nogach, głowa pod samym sufitem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683293
    m_Localized: 'Unstable: I wtedy drze japę „Wszyscy z was to chuje!”.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683294
    m_Localized: 'Unstable: Wtedy wiedziałem, że zaraz się zacznie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683295
    m_Localized: 'Unstable: A wcale nie chciałem tego oglądać. Dałem nogę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683296
    m_Localized: I potem co?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683297
    m_Localized: 'Unstable: Nic. Rzeczy mają się jakoś… dziwnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683298
    m_Localized: 'Unstable: Gdziekolwiek się nie udam, tam ktoś wsadza kij w mrowisko.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683299
    m_Localized: 'Unstable: To znaczy, jeśli gdzieś zostanę dłużej niż na kilka dni.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683300
    m_Localized: 'Unstable: Bójka. Śmierć. Trumna. Grób. Zazwyczaj w tej kolejności…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683301
    m_Localized: 'Unstable: Oby sprawy tutaj miały się inaczej.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683302
    m_Localized: 'Unstable: Kurczę, jadę na oparach…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683303
    m_Localized: To jak myślisz? Czy u mnie jest bezpiecznie?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683304
    m_Localized: 'Unstable: Ciężko stwierdzić.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683305
    m_Localized: 'Unstable: Bije od ciebie jakaś taka… spokojna i domowa aura.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683306
    m_Localized: 'Unstable: Może dlatego, że jesteśmy w twoich czterech ścianach. Ha, ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683307
    m_Localized: 'Unstable: Czuję, że starasz się tu stworzyć bezpieczny azyl czy coś w ten deseń.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683308
    m_Localized: 'Unstable: A nie, że wpuszczasz kogo popadnie i w ogóle.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683309
    m_Localized: 'Unstable: Ale… ty też to czujesz, prawda? Coś jest nie tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683310
    m_Localized: 'Unstable: Ha, z całym światem coś jest nie tak. Ale tutaj… to…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683311
    m_Localized: 'Unstable: Sam nie wiem, co chcę powiedzieć.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683312
    m_Localized: 'Unstable: Ech, trudno. Golnij sobie EnerJekę i zapomnij o tym.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683313
    m_Localized: 'Unstable: Luzik.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683314
    m_Localized: To kiedy się zwijasz?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683315
    m_Localized: Czy wciąż przed czymś uciekasz?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683316
    m_Localized: 'Unstable: Chyba niedługo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683317
    m_Localized: 'Unstable: Nie lubię zagrzewać miejsca, jak pewnie zauważyłeś.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683318
    m_Localized: 'Unstable: A jeśli nie… wspominałem już o tym kilka razy, ha, ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683319
    m_Localized: 'Unstable: Pomyślałem, że u ciebie może bunkrów nie ma, ale też może być zajebiście.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683320
    m_Localized: 'Unstable: Ale tu śmierć dosłownie wygląda zza każdego winkla, wiesz? Nie do końca to kumam, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683321
    m_Localized: 'Unstable: …widziałem swoje. Niedługo będę zmykał.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683322
    m_Localized: 'Unstable: Nie uciekam, ale oddalam się.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683323
    m_Localized: 'Unstable: Więcej problemów mi nie potrzeba. Mam ich wiele.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683324
    m_Localized: 'Unstable: Zostań w jednym miejscu wystarczająco długo, a ktoś w końcu ci jebnie, strzeli do ciebie, lub gdzieś zamknie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683325
    m_Localized: 'Unstable: A wtedy kto wie, dokąd to doprowadzi…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683326
    m_Localized: 'Unstable: Pewnie, im dłużej jestem w drodze, tym większa szansa, że trafię na jakiegoś świra.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683327
    m_Localized: 'Unstable: Ale już lepiej to, niż skończyć z nożem w plecach od kogoś zaufanego.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683328
    m_Localized: 'Unstable: Kurczę, jadę na oparach…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683329
    m_Localized: To jak? Spakowałeś się?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683330
    m_Localized: 'Unstable: Hę? Och, tak. Pójdę sobie tej nocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683331
    m_Localized: 'Unstable: Więc… trzymaj się!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683332
    m_Localized: Nie uciekniesz od każdego okropieństwa na świecie
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683333
    m_Localized: Komu w drogę, temu rak pod nogę. Obyś nie trafił na świrów
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683334
    m_Localized: 'Unstable: Tak, tak, wiem. Ale hej, może mi się uda.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683335
    m_Localized: 'Unstable: Czy naprawdę uważasz, że siedzenie w jednym miejscu ma tak duże znaczenie?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683336
    m_Localized: Powodzenia
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683337
    m_Localized: Wiedz, że z powrotem cię nie wpuszczę
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683338
    m_Localized: 'Unstable: To nie był sarkazm, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683339
    m_Localized: 'Unstable: Tak czy siak, dzięki. Nieźle odpocząłem. Będę mógł biec przez kilka dni.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683340
    m_Localized: 'Unstable: EnerJeka uskrzydla, wiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683341
    m_Localized: 'Unstable: Jeśli to miało być błyskotliwe… Robienie czegoś, czegokolwiek, jest lepsze niż siedzenie i czekanie, aż ci mózg wyparuje.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683342
    m_Localized: 'Unstable: I tak nie mam nic do stracenia. Wszystko zostawiłem za sobą.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683343
    m_Localized: 'Unstable: Więc czemu nie oddać się poszukiwaniom za czymś więcej? Lepsze to niż wywiesić białą flagę i czekać, aż opadnie kurtyna.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683344
    m_Localized: 'Unstable: Nie chcę tak skończyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683345
    m_Localized: Powodzenia
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683346
    m_Localized: Wiedz, że z powrotem cię nie wpuszczę
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683347
    m_Localized: 'Unstable: Dzięki, tobie też.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683348
    m_Localized: 'Unstable: Może jeszcze kiedyś się spotkamy. Może będę miał kolejną historię albo dwie za moje trudy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683349
    m_Localized: 'Unstable: I może nawet będę miał ochotę je opowiedzieć, bo teraz to niezbyt. Nie, gdy masz taką żałosną minę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683350
    m_Localized: 'Unstable: Ale to bez znaczenia. Nie wrócę tutaj.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683351
    m_Localized: 'Unstable: Nie mam po co. Nigdy nie pozostaje nic, do czego mógłbym wrócić. Tylko spalona ziemia i zwęglone kości.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683352
    m_Localized: 'Unstable: Bez urazy, dzielę się tylko tym, co widziałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683353
    m_Localized: 'Unstable: Łatwiej jest to wszystko zostawić w diabli. Zatem… lepiej, gdybyśmy się już nigdy nie zobaczyli.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683354
    m_Localized: 'Unstable: Kurczę, jadę na oparach…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683355
    m_Localized: Nie miałeś już sobie pójść?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683356
    m_Localized: 'Unstable: Tak, ale najpierw chciałem cię ostrzec!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683357
    m_Localized: 'Unstable: Ostatniej nocy poczułem przez okno coś złego. Pomyślałem, żeby cię obudzić, ale dałem ci spać.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683358
    m_Localized: 'Unstable: Uważaj na siebie… okej? Śmierć bez wątpienia depcze ci po piętach.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683359
    m_Localized: 'Unstable: Nie umiem tego wyjaśnić.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683360
    m_Localized: 'Unstable: Ogarnęły mnie jakieś dziwne dreszcze, pewnie od całej tej kofeiny.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683361
    m_Localized: 'Unstable: Ale nie o to chodzi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683362
    m_Localized: 'Unstable: Poczułem, że muszę cię ostrzec, okej? Zanim wydarzy się coś złego.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683363
    m_Localized: 'Unstable: Może też powinieneś pomyśleć o wyprowadzce?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683364
    m_Localized: 'Unstable: Nie patrz tak na mnie. Wiem, że gadam od rzeczy. Nieważne.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683365
    m_Localized: 'Unstable: Tak czy owak, przekazałem ostrzeżenie. Zbieram się, tym razem na pewno. Obyś nie spłonął jak reszta.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683366
    m_Localized: 'Rocker: Stary, brakuje mi mojej gitary…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713516683367
    m_Localized: Śnisz na jawie?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460480
    m_Localized: 'Rocker: Hm? Zastanawiałem się właśnie, kto jeszcze żyje ze starego zespołu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460481
    m_Localized: 'Rocker: Wtedy po każdym pogrzebie włączaliśmy sprzęt i graliśmy na całego. Lepsze to niż gnicie w łóżku lub picie na umór.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460482
    m_Localized: 'Rocker: Jednego razu grałem jeden riff trzy noce z rzędu. Szarpałem struny, aż mi palce zaczęły krwawić.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460483
    m_Localized: 'Rocker: Tylko ja i moja gitara. W takim skupieniu nie mogłem myśleć o twarzy tego skurczybyka, który właśnie wykorkował.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460484
    m_Localized: 'Rocker: Teraz dzień za dniem jest to samo gówno: Przybysze i palące słońce. Następna dolewka z piekła, pijmy do dna!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460485
    m_Localized: 'Rocker: Stary, brakuje mi mojej gitary…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460486
    m_Localized: Ciężko ci? Bez gitary?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460487
    m_Localized: 'Rocker: Jak jasna cholera…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460488
    m_Localized: 'Rocker: Pamiętam nasze brzdąkania w kuchni, ha. Piecyk na zydlu, głośność do połowy, żeby sąsiedzi nie wezwali psów.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460489
    m_Localized: 'Rocker: Po każdym kawałku któryś ze skurczybyków dodawał „Ku pamięci tego‑i‑tego”. I tyle, żadnych łez ani niczego.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460490
    m_Localized: 'Rocker: Lepiej rozwalić starą gitarę niż własny łeb. Gitarę przynajmniej możesz wymienić.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460491
    m_Localized: 'Rocker: W tamtych czasach myślałem, że nasze kanapowe granie doprowadzi do czegoś większego.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460492
    m_Localized: 'Rocker: Ale miasto dawało nam w kość szybciej, niż potrafiliśmy zbierać się do kupy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460493
    m_Localized: 'Rocker: Jakiś sukinsyn zawsze przedawkował albo rozwalił się samochodem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460494
    m_Localized: 'Rocker: Chuj, a nie życie…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460495
    m_Localized: 'Rocker: Jutro w nocy stąd spadam. Muszę pójść w jedno miejsce.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460496
    m_Localized: 'Rocker: Stary, brakuje mi mojej gitary…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460497
    m_Localized: Więc? Byłeś gdzieś zeszłej nocy?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460498
    m_Localized: 'Rocker: Tak, wbiłem do naszej starej miejscówki, gdzie mieliśmy próby. Pleśń na ścianach, kable leżą luzem, wszystko zniszczone.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460499
    m_Localized: 'Rocker: Włączyłem na moment metronom, posłuchałem chwilę… i nic. Pustka.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460500
    m_Localized: 'Rocker: Marzenia straciły jakikolwiek sens…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460501
    m_Localized: 'Rocker: Rock and roll nie umiera? Ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460502
    m_Localized: 'Rocker: Wiesz, stary, nawet gdyby słońce nie zaczęło nas przysmażać, coś innego by nam dowaliło.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460503
    m_Localized: 'Rocker: Jak byłem małym smarkiem, myślałem, że całe gówno mamy już za sobą, że może być tylko lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460504
    m_Localized: 'Rocker: Kryzys gospodarczy, wojna… Zdawało się, że można zacząć żyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460505
    m_Localized: 'Rocker: Kurwa, ale byłem w błędzie…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460506
    m_Localized: 'Rocker: Stary, brakuje mi mojej gitary…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460507
    m_Localized: O czym myślisz?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460508
    m_Localized: 'Rocker: Moja historia to same rozgrzewki i zapchaj dziury. Nigdy nie stanąłem w świetle jupiterów i pewnie już nie stanę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460509
    m_Localized: 'Rocker: Nawet nie wiem, dlaczego ci ściemniałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460510
    m_Localized: 'Rocker: Może choć przez chwilę chciałem udać, że mi się poszczęściło.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460511
    m_Localized: 'Rocker: Mówiłem, że przeprawiłem się przez piekło i że teraz jestem kozak, ale to bujda. Schowałem się pod kołdrą jak dziecko.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460512
    m_Localized: 'Rocker: Gdy do mnie wycelowałeś, coś we mnie pękło. Zabiłem moje stare „ja”, być stać się kimś… ale wyszedłem na tym żałośnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460513
    m_Localized: 'Rocker: Jak tak dalej pójdzie, skończę jak cała reszta. Zeżrę pełno tabletek albo wezmę żyletkę do ciepłej kąpieli.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460514
    m_Localized: 'Rocker: Nie jestem Przybyszem, tylko wypalonym sukinkotem na skraju załamania.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460515
    m_Localized: 'Rocker: Jeśli masz zamiar strzelić…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460516
    m_Localized: 'Rocker: Ech, chuj z tym, stary'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460517
    m_Localized: 'Rocker: Mam to w dupie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460518
    m_Localized: 'Experienced: Wszystko wporzo, waflu?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460519
    m_Localized: Jeśli siedziałeś, gdzie masz tatuaże?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460520
    m_Localized: 'Experienced: Waflu, brak dziar nie oznacza, że nie odsiedziałem swojego.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460521
    m_Localized: 'Experienced: To proste, nie ocenia się książki po okładce.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460522
    m_Localized: 'Experienced: Przyznaję, nie stroniłem od kłopotów. Nigdy jednak nikogo nie zaciukałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460523
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460524
    m_Localized: 'Experienced: Nie zrozum mnie źle, herbatniku, ale muszę zapytać: jak ty tu wszystkich ustawiasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460525
    m_Localized: A co, coś nie tak?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460526
    m_Localized: Nie interesuj się
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460527
    m_Localized: 'Experienced: Mam przeczucie, że wpuszczasz tu niemal każdego. Bezdomnych, dziwaków…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460528
    m_Localized: 'Experienced: To się źle skończy. Byłem tu i tam, i wiem, co i jak.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460529
    m_Localized: 'Experienced: Będą z tego problemy, waflu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460530
    m_Localized: 'Experienced: Wpuścisz jakiegoś starucha, a on ci wykituje na kanapie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460531
    m_Localized: 'Experienced: Co wtedy? Oskarżą cię o to, jego śmierć będzie na twoich rękach. Kapujesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460532
    m_Localized: 'Experienced: Albo kobietę, powiedzmy. Zaciąży u ciebie. Co wtedy?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460533
    m_Localized: 'Experienced: Zaopiekujesz się bachorem? Chcesz tego bajzlu? Co?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460534
    m_Localized: 'Experienced: Podstawa, herbatniku, to wpuszczać tylko prawdziwych facetów. Ja, ty, nie jesteśmy dla nikogo ciężarem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460535
    m_Localized: Mówisz, że mam przeganiać staruszków oraz kobiety i dzieci?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460536
    m_Localized: I tak twierdzi eks‑więzień?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460537
    m_Localized: 'Experienced: Zrozumiano, waflu. Nie będę się wtryniał.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460538
    m_Localized: 'Experienced: Nie chciałem cię wpieniać. Twój dom, twoje zasady.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460539
    m_Localized: 'Experienced: Tylko jedno mnie dręczy…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460540
    m_Localized: 'Experienced: Dlaczego wszyscy wciąż noszą ciuchy?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460541
    m_Localized: 'Experienced: Nie wypadłeś sroce spod ogona. Tak, są niepotrzebni.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460542
    m_Localized: Niezły masz, kurwa, tupet, wiesz?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460543
    m_Localized: Od kiedy jesteś ekspertem? Od chwili, gdy wyszedłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460544
    m_Localized: 'Experienced: Słuchaj, mówię tylko, żebyś nie wpuszczał wszystkich jak leci. To się na tobie zemści.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460545
    m_Localized: Niezły masz, kurwa, tupet, wiesz?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460546
    m_Localized: Od kiedy jesteś ekspertem? Od chwili, gdy wyszedłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460547
    m_Localized: 'Experienced: Myślisz, że taki z ciebie śmieszek?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460548
    m_Localized: 'Experienced: Zrozumiano, waflu. Nie będę się wtryniał. Nie musisz powtarzać.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460549
    m_Localized: 'Experienced: Tylko jedno mnie dręczy…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460550
    m_Localized: 'Experienced: Dlaczego wszyscy wciąż noszą ciuchy w tym skwarze?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460551
    m_Localized: 'Experienced: Wszystko wporzo, waflu?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460552
    m_Localized: Nie jest ci tak zimno?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460553
    m_Localized: 'Experienced: Jak to „tak”?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460554
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460555
    m_Localized: 'Experienced: Wycinasz mi tu przekręt?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460556
    m_Localized: 'Experienced: Słońce smaży nas jak jajecznicę. Ulice spalone są bardziej niż kiełbasy na ognisku.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460557
    m_Localized: 'Experienced: A ty paradujesz tu w swetrze. Kto tu wtedy jest prawdziwym idiotą, herbatniku?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460558
    m_Localized: Te ciuchy są jakby częścią mnie
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460559
    m_Localized: Nie wadzi mi
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460560
    m_Localized: 'Experienced: „Częścią ciebie”, hę?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460561
    m_Localized: 'Experienced: Skoro tak twierdzisz, waflu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460562
    m_Localized: 'Experienced: Na ulicach goręcej niż w piecu, a wy wszyscy błaznujecie wystrojeni jak szczury na otwarcie kanału.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460563
    m_Localized: 'Experienced: Porąbało was. Rowy w dupach zapocone, ale broń Boże, żeby ktoś zobaczył wasze spocone poślady!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460564
    m_Localized: 'Experienced: Albo… jeśli ktoś nie jest spocony pod tymi wszystkimi warstwami, może nie jest normalny…?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460565
    m_Localized: Więc twierdzisz, że jestem Przybyszem?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460566
    m_Localized: Do czego pijesz?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460567
    m_Localized: 'Experienced: Żartujesz, herbatniku? Ja tu się gotuję z dupą na wierzchu, a tobie nie jest gorąco w pioruńskim swetrze?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460568
    m_Localized: 'Experienced: Nie czaję. Rowy w dupach zapocone, ale broń Boże, żeby ktoś zobaczył wasze spocone poślady!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460569
    m_Localized: 'Experienced: Kurde, spójrz na ludzi na plaży – stroje kąpielowe i bikini to normalka.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460570
    m_Localized: 'Experienced: Ten sam gorąc, mniej zabawy!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460571
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460572
    m_Localized: 'Experienced: Albo… jeśli ktoś nie jest spocony pod tymi wszystkimi warstwami, może nie jest normalny…?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460573
    m_Localized: Więc twierdzisz, że jestem Przybyszem?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460574
    m_Localized: Do czego pijesz?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460575
    m_Localized: 'Experienced: Luzuj poślady, waflu. Nie czyham na ciebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460576
    m_Localized: 'Experienced: Zdajesz się być charakterny. Chcesz się pocić, twoja wola.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460577
    m_Localized: 'Experienced: Mówię o tych innych gamoniach. Jakby pójść w płaszczu na plażę…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460578
    m_Localized: To co, mam się rozebrać?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460579
    m_Localized: Kawał teorii. Sam to wykoncypowałeś?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460580
    m_Localized: 'Experienced: Waflu, słuchaj. Są teraz tylko dwie przyczyny ubierania się. Kompletny debilizm albo nie bycie człowiekiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460581
    m_Localized: 'Experienced: Te dziwadła powinny wąchać kwiatki od spodu! To dlatego nie czują gorąca. Kumasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460582
    m_Localized: To co, mam się rozebrać?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460583
    m_Localized: Kawał teorii. Sam to wykoncypowałeś?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460584
    m_Localized: 'Experienced: Kurczę, herbatniku. Nie o to mi chodziło.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460585
    m_Localized: 'Experienced: Chcesz się pocić, twoja wola.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460586
    m_Localized: 'Experienced: Mówię tylko, że to dziwne. Trzeba być albo zupełnym durniem, albo…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460587
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460588
    m_Localized: 'Experienced: Nie żartuję, herbatniku! Łażenie w ciuchach jak na cebulkę to porąbana sprawa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460589
    m_Localized: 'Experienced: Jaka ciemna masa robi tak w taki skwar? Właśnie o to mi chodzi, że trzeba być albo kompletnym durniem, albo…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460590
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460591
    m_Localized: 'Experienced: Mam to gdzieś. Skończyłem trzepać jęzorem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460592
    m_Localized: 'Experienced: Wszystko wporzo, waflu?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460593
    m_Localized: Więc co chciałeś mi poprzednio powiedzieć?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460594
    m_Localized: 'Experienced: Popatrz, waflu, mogę ci to wszystko łopatologicznie przedstawić, ale czy będziesz słuchał?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460595
    m_Localized: Tak
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460596
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460597
    m_Localized: 'Experienced: No dobra, to zaczynam.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460598
    m_Localized: 'Experienced: Tak pokrótce to nikt tu nie ma czystych rączek.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460599
    m_Localized: Dlaczego tak uważasz?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460600
    m_Localized: Czy zawsze uważałeś ludzi za brudasów?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460601
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460602
    m_Localized: 'Experienced: Co, kurwa?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460603
    m_Localized: 'Experienced: To po co się w ogóle pytałeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460604
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460605
    m_Localized: 'Experienced: Zdaje się, że wszystkim odjebało i tylko ci, którzy siedzą pod dachem, się jakoś trzymają.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460606
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460607
    m_Localized: 'Experienced: Wiesz co, herbatniku? Zamknę gębę, bo jeszcze mnie też coś trafi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460608
    m_Localized: 'Experienced: Waflu, czy według ciebie świeciłbym tyłkiem w slipach jeśli nie byłoby mi tak gorąco?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460609
    m_Localized: 'Experienced: To, że inni chodzą poubierani, jakby nie czuli gorąca, nie daje mi spokoju.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460610
    m_Localized: 'Experienced: Byłeś tu dłużej ode mnie, ale zachowujesz się, jakby cię chowali w szafie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460611
    m_Localized: 'Experienced: Czy ty w ogóle wiesz, jak rozpoznawać te dziwadła?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460612
    m_Localized: Tak, znam objawy. Widziałem je w telewizji
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460613
    m_Localized: Nikt nie wie na pewno
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460614
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460615
    m_Localized: 'Experienced: Chyba żartujesz, waflu…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460616
    m_Localized: 'Experienced: Przecież ci mówię! Ci w ciuchach to Przybysze!'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460617
    m_Localized: 'Experienced: Czy ty w ogóle wiesz, jak rozpoznawać te dziwadła?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460618
    m_Localized: Tak, znam objawy. Widziałem je w telewizji
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460619
    m_Localized: Nikt nie wie na pewno
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460620
    m_Localized: 'Experienced: Kurde, oby tak było, herbatniku.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460621
    m_Localized: 'Experienced: Słabo by było, gdyby te objawy okazały się wyssane z palca. W mig wpakowaliby cię do paki.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460622
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460623
    m_Localized: 'Experienced: To co, teraz wybiera się ich na chybił‑trafił?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460624
    m_Localized: 'Experienced: Kurczę, cóż zrobić, skoro nie ma innego sposobu? Jest, jak jest.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460625
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460626
    m_Localized: 'Experienced: Waflu, tak szczerze to z tym jak się sprawy mają… ludzie nie są już ludźmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460627
    m_Localized: 'Experienced: Bezpieczniej czułem się w pierdlu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460628
    m_Localized: 'Experienced: Wszystko wporzo, waflu?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460629
    m_Localized: Jeśli czułeś się tam bezpieczniej, czemu nie tam nie zostałeś?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460630
    m_Localized: 'Experienced: Już ci mówiłem, waflu. Odsiedziałem swoje. Trzeci raz garowałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460631
    m_Localized: 'Experienced: Pierwszy raz siedziałem za młodu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460632
    m_Localized: 'Experienced: Myślałem wtedy, że jak wyjdę, to postaram się być porządnym obywatelem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460633
    m_Localized: 'Experienced: I udało mi się, herbatniku. Ożeniłem się i miałem dziecko. Stare życie zostawiłem za sobą.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460634
    m_Localized: 'Experienced: Wtedy nastąpił kryzys gospodarczy. Wykonywałem najgorsze roboty, żeby coś do garnka wrzucić.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460635
    m_Localized: 'Experienced: I zanim się zorientowałem, wróciłem do starych nawyków.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460636
    m_Localized: 'Experienced: Więc drugie kiblowanie było kwestią czasu. Za trzecim razem poszedłem z wyboru. Na zewnątrz nic mnie już nie trzymało.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460637
    m_Localized: 'Experienced: Żona odeszła, dziecko się mnie bało, a nikt nie zatrudnia recydywistów.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460638
    m_Localized: 'Experienced: Więc tak – pół życia mi, kurde, przepadło.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460639
    m_Localized: To co cię trzyma przed powrotem?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460640
    m_Localized: Przykro mi to słyszeć
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460641
    m_Localized: 'Experienced: Nic, waflu. Nie znalazłem jeszcze wystarczająco dobrego powodu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460642
    m_Localized: 'Experienced: Wszystko w swoim czasie…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460643
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460644
    m_Localized: 'Experienced: Nie potrzebuję twojego współczucia. Sam to sobie zrobiłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460645
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460646
    m_Localized: 'Experienced: Świat się zmienił podczas mojej odsiadki.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460647
    m_Localized: 'Experienced: Jestem teraz starą wygą. Nowe sztuczki to domena młodych.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460648
    m_Localized: 'Experienced: Niby jak moja stara prycza z celi. I wtedy była z litego drewna i teraz nadal taka jest.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460649
    m_Localized: 'Experienced: Przyzwyczajeń już raczej nie zmienię, waflu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460650
    m_Localized: 'Experienced: Trudno teraz wtopić się w tłum. Nikt nikomu nie ufa. Niektórzy wybebeszyliby cię prędzej, niźli spojrzeli na ciebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460651
    m_Localized: 'Experienced: A ja nie lubię owijać w bawełnę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460652
    m_Localized: 'Experienced: Wierz lub nie, ale ludzie w pace niczego nie kryją. Od razu widać, kto jakim jest.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460653
    m_Localized: 'Experienced: A tutaj? Nie sposób stwierdzić, kto jest człowiekiem, a kto dziwadłem. Wszystko jest pokręcone.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460654
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460655
    m_Localized: 'Experienced: Filozof ze mnie jak z kozich cycków kastaniety, ale… czy tak ciężko jest pozostać człowiekiem? W pace jakoś dają radę…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460656
    m_Localized: 'Experienced: Na zewnątrz jest więcej niegodziwości, niż mi się zdawało.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460657
    m_Localized: 'Jacket: Ja pierniczę… to wszystko jest nieźle porąbane.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460658
    m_Localized: Mieszkałeś w akademiku, tak?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460659
    m_Localized: 'Jacket: Tak, nie wspominałem o tym wcześniej, ale nie jestem stąd. Przyjechałem na studia, a wtedy wszystko poszło do diabła…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460660
    m_Localized: 'Jacket: Najpierw pozamykali nas w akademikach w obawie, że wirus się rozniesie. A wtem… zjawiły się typy w żółtych skafandrach.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460661
    m_Localized: 'Jacket: Już wtedy zaczynałem się martwić, a potem usłyszałem, że zainfekowanych biorą do stref kwarantanny…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460662
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460663
    m_Localized: 'Jacket: Nie zamierzałem czekać, aż mnie wywloką, więc uciekłem przez okno.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460664
    m_Localized: 'Jacket: Wziąłem ze sobą tylko kurtkę. Nie wiedziałem, dokąd pójść. W ten sposób skończyłem pod twoimi drzwiami.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460665
    m_Localized: Wziąłeś tylko kurtkę?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460666
    m_Localized: Co innego jeszcze wziąłeś?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460667
    m_Localized: 'Jacket: Tak, to moja ulubiona kurtka.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460668
    m_Localized: 'Jacket: Wziąłem dowód osobisty i kilka innych rzeczy, ale kurtka była najważniejsza.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460669
    m_Localized: 'Jacket: Nie myśl tylko, że chodzi tu o jej markę, albo że była droga.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460670
    m_Localized: 'Jacket: To jedna z niewielu rzeczy, która została mi po bracie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460671
    m_Localized: 'Jacket: Ja pierniczę… to wszystko jest nieźle porąbane.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460672
    m_Localized: Co się stało twojemu bratu?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460673
    m_Localized: 'Jacket: Tak w skrócie to FEMA go wzięła i od tamtej pory go nie widziałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460674
    m_Localized: 'Jacket: Wcześniej był marynarzem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460675
    m_Localized: 'Jacket: A tę kurtkę… przywiózł zza oceanu jako prezent z jednego z rejsów.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460676
    m_Localized: 'Jacket: Myślałem, że da mi jakąś pierdółkę jak pluszową gęś lub magnes na lodówkę.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460677
    m_Localized: 'Jacket: Ale zamiast tego wydał kupę kasy na prawdziwą kurtkę! Byłem wniebowzięty.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460678
    m_Localized: 'Jacket: Naprawdę rzadko go widywałem, więc ucieszyłem się, że o mnie pamiętał.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460679
    m_Localized: 'Jacket: Przyznam, że z powodu tej kurtki nie raz miałem problemy. U nas się takiej nie dostanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460680
    m_Localized: 'Jacket: Ludzie na nią patrzą i chcą mnie z niej skroić, a wtedy…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460681
    m_Localized: 'Jacket: Ale nigdy się nie poddaję. To nie tylko kurtka, ale pamiątka po bracie.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460682
    m_Localized: 'Jacket: Oby nic mu nie było…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460683
    m_Localized: 'Jacket: Ja pierniczę… to wszystko jest nieźle porąbane.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460684
    m_Localized: Pomyślałeś, że może twój brat jest w strefie kwarantanny?
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460685
    m_Localized: 'Jacket: To nie takie proste.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460686
    m_Localized: 'Jacket: Nie wzięli go do strefy, ale dosłownie wcielili w swoje szeregi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460687
    m_Localized: To znaczy…
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460688
    m_Localized: O cholera
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460689
    m_Localized: 'Jacket: Tak, jest teraz jednym z nich.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460690
    m_Localized: 'Jacket: Nawet nie dali mu wyboru. Pojawili się w progu i oznajmili „Nadajesz się”.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460691
    m_Localized: 'Jacket: Przenigdy by sam do nich nie dołączył.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460692
    m_Localized: 'Jacket: Dlatego nie mogę dać się złapać.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460693
    m_Localized: 'Jacket: To nie tylko dlatego, że boję się Przybyszy. Wszyscy się ich boją.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460694
    m_Localized: 'Jacket: Ale gdy większość w przerażeniu zastanawia się, czy stojąca przed nimi osoba jest człowiekiem… ja mam inne obawy.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460695
    m_Localized: 'Jacket: A co, jeśli okaże się, że schwytał mnie mój własny brat?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460696
    m_Localized: 'Jacket: Co miałby zrobić? Zignorować rozkaz i wypuścić mnie? Co by mu za to zrobili?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460697
    m_Localized: 'Jacket: Czy może wypełniłby polecenie i zawlókł mnie razem z innymi do strefy kwarantanny?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460698
    m_Localized: 'Jacket: A gdyby kazali mu mnie zastrzelić…?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460699
    m_Localized: 'Jacket: Czy poczułbym się lepiej, wiedząc, że zginąłem z ręki brata? Czy może pogorszyłoby to sytuację?'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460700
    m_Localized: 'Jacket: Wszystko jest nie tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460701
    m_Localized: 'Jacket: Mrowie lęków krąży mi po głowie, ale dogłębnie przeraża mnie jeden…'
    m_Metadata:
      m_Items: []
  - m_Id: 73445713533460702
    m_Localized: 'Jacket: Jeśli kiedyś mnie porwą… mogę się nigdy nie dowiedzieć, czy osobą kryjącą się za maską był mój brat.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725184
    m_Localized: 'Tough: Nic nie przychodzi łatwo. Nic a nic.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725185
    m_Localized: Nie miałaś lekko w życiu, co?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725186
    m_Localized: 'Tough: Podejrzewam, że ci, których życie rozpieszczało, już nie żyją.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725187
    m_Localized: 'Tough: Gdy pieniądze przestały czynić ich władcami świata, ich miękkie dupska dostały klapsa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725188
    m_Localized: 'Tough: Będąc mięczakiem, łatwo jest paść ofiarą gwałciciela, oportunisty albo jakiegoś wariata.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725189
    m_Localized: 'Tough: Też to zauważyłeś, prawda? Ludzie się zezwierzęcili, ale my nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725190
    m_Localized: 'Tough: Nie upadliśmy tak nisko. Stawiamy opór i pomagamy innym przetrwać.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725191
    m_Localized: 'Tough: To właśnie ludzie tacy jak my chcą żyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725192
    m_Localized: 'Tough: Męty, tchórze i ci, którzy się poddali, zostali odsiani przez ten świat.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725193
    m_Localized: 'Tough: Tak, brzmi to dość skrajnie, ale tak właśnie jest. Nic z tym nie zrobimy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725194
    m_Localized: 'Tough: Jedyne, co nam pozostało, to starać się zachować resztki człowieczeństwa. Oby to miejsce to ułatwiło.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725195
    m_Localized: 'Tough: Nic nie przychodzi łatwo. Nic a nic.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725196
    m_Localized: No nie wiem…
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725197
    m_Localized: 'Tough: Nie wolno mówić „wszystko będzie dobrze”. Okej, wolno, ale to nic nie zmieni.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725198
    m_Localized: 'Tough: Truizmy nie mają sensu. Albo jest się gotowym na piekielne trudy… albo nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725199
    m_Localized: Nie rozumiem, dlaczego to ja miałbym pocieszać ludzi
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725200
    m_Localized: A nie chciałabyś sama tego choć raz usłyszeć?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725201
    m_Localized: 'Tough: I o tym właśnie mówię.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725202
    m_Localized: 'Tough: Niektórzy są jak dzieci, trzeba ich trzymać za rękę, podcierać im dupę i wszystko za nich robić.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725203
    m_Localized: 'Tough: A wtedy, gdy przychodzi moment do działania, wychodzi szydło z worka.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725204
    m_Localized: 'Tough: Załamują się w oka mgnieniu i sieją zamęt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725205
    m_Localized: 'Tough: „Wszystko będzie dobrze” nic tu nie zmieni.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725206
    m_Localized: 'Tough: Nie chcę znowu tego doświadczać.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725207
    m_Localized: 'Tough: Tu nie ma miejsca na słabość.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725208
    m_Localized: 'Tough: Może i jestem nieco szorstka, wspomnienia wciąż mam świeże.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725209
    m_Localized: 'Tough: Porozmawiajmy później, okej?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725210
    m_Localized: 'Tough: Słucham?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725211
    m_Localized: 'Tough: I jaki w tym sens?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725212
    m_Localized: 'Tough: Słowa rzucane są na wiatr. Czy przywrócą życie zmarłym? Czy sprawią, że gwałciciel urżnie sobie jajca?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725213
    m_Localized: 'Tough: Wolę być mądra przed szkodą, dlatego noszę ze sobą nóż.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725214
    m_Localized: 'Tough: Albo się przystosujemy do nowej rzeczywistości, albo zginiemy. Wszystko inne nie ma znaczenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725215
    m_Localized: 'Tough: Nie chciałam być uszczypliwa. Nie zadawaj mi więcej takich głupich pytań.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725216
    m_Localized: 'Tough: Nic nie przychodzi łatwo. Nic a nic.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725217
    m_Localized: Więc… co tam masz?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725218
    m_Localized: 'Tough: Powiem wprost.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725219
    m_Localized: 'Tough: Widziałam, jak się gapisz na to pudełko w schowku, i jak stoisz w bezruchu przy oknie w sypialni.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725220
    m_Localized: 'Tough: Zerknęłam wczoraj w nocy. Jesteś tu uwięziony.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725221
    m_Localized: 'Tough: Nie walczysz o przetrwanie. Zwyczajnie boisz się umrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725222
    m_Localized: 'Tough: Mam rację?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725223
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725224
    m_Localized: Spieprzaj
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725225
    m_Localized: 'Tough: Gówno prawda.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725226
    m_Localized: 'Tough: Widzę, jak cały zesztywniałeś.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725227
    m_Localized: 'Tough: Za bardzo boisz się strzelić sobie samobója.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725228
    m_Localized: 'Tough: Z początku myślałam, że twoje życie nie było usłane różami i że jesteś taki twardy przez to, co fundował ci los.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725229
    m_Localized: 'Tough: Ale naprawdę jesteś tylko kolejną trusią, która jakimś cudem uniknęła najgorszego.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725230
    m_Localized: 'Tough: Zawiodłeś mnie…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725231
    m_Localized: 'Tough: Nie chce mi się już z tobą gadać.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725232
    m_Localized: 'Tough: Jesteś jak jakiś młokos z podstawówki zagoniony w kozi róg przez łobuzów.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725233
    m_Localized: 'Tough: To utwierdza mnie w przekonaniu, że jesteś kolejnym słabeuszem, który chwycił za giwerę.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725234
    m_Localized: 'Tough: Nikim więcej.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725235
    m_Localized: 'Tough: Z początku myślałam, że twoje życie nie było usłane różami i że jesteś taki twardy przez to, co fundował ci los.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725236
    m_Localized: 'Tough: Ale naprawdę jesteś tylko kolejną trusią, która jakimś cudem uniknęła najgorszego.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725237
    m_Localized: 'Tough: Zawiodłeś mnie…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725238
    m_Localized: 'Tough: Nie chce mi się już z tobą gadać.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725239
    m_Localized: 'Tough: Nic nie przychodzi łatwo. Nic a nic.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725240
    m_Localized: W czym jeszcze myszkowałaś?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725241
    m_Localized: 'Tough: Zrobiłam to, bo nie cofnę się przed niczym, by przeżyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725242
    m_Localized: 'Tough: Musiałam wiedzieć, z kim mam do czynienia, i na co muszę uważać.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725243
    m_Localized: 'Tough: Ten dom kryje wiele wspomnień. Martwą rodzinę.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725244
    m_Localized: 'Tough: To dało mi do myślenia… nie potrafisz zapomnieć o przeszłości.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725245
    m_Localized: 'Tough: Ale to nie mój interes.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725246
    m_Localized: 'Tough: Tylko…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725247
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725248
    m_Localized: 'Tough: Kiedyś byłam milsza. Młodsza. Spotkałam kiedyś faceta.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725249
    m_Localized: 'Tough: Powiedział, że musimy do niego wstąpić, zanieść coś jego matce. Nie chciałam wejść do środka.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725250
    m_Localized: 'Tough: Poczekałam na zewnątrz, ale po chwili zawołał mnie z okna, żebym przyszła na górę.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725251
    m_Localized: 'Tough: No to poszłam. Nie było tam żadnej matki. Tylko ten bydlak i jego znajomek.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725252
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725253
    m_Localized: 'Tough: Gdy świat poszedł w diabły, odnalazłam ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725254
    m_Localized: 'Tough: Potem nie czułam się wcale lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725255
    m_Localized: 'Tough: Przez długi czas zdawałam się brudna. Tak jakbym nie była w stanie tego z siebie zmyć…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725256
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725257
    m_Localized: 'Tough: Dla takich gnojów nie ma litości. Ani dla słabeuszy, bo oni dają sobie wejść na głowę.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725258
    m_Localized: 'Tough: Nie będę już grzebać w twoich szpargałach, ale teraz chyba mnie rozumiesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725259
    m_Localized: 'Bald: Raz, dwa, trzy, cztery… Może wszystko sfajczę bez kozery… Żartuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725260
    m_Localized: Co z twoimi przyjaciółmi?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725261
    m_Localized: 'Bald: Aha! Poznaliśmy się na uczelni teatralnej.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725262
    m_Localized: 'Bald: Ja mam magistra jako producent teatralny. I powiem od razu, przyjacielu: nikomu nie polecam!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725263
    m_Localized: 'Bald: Właściwie to niczego związanego z teatrem. Postronnym może wydawać, że to sam prestiż, ale nikt już nie szanuje kunsztu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725264
    m_Localized: 'Bald: Znaczy się, jeśli robisz to wyłącznie dla sztuki i chcesz klepać biedę całe życie, droga wolna.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725265
    m_Localized: 'Bald: Pewnie, jest kilka znanych ugrupowań, które występują na znanych scenach, ale to rzadkość.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725266
    m_Localized: 'Bald: Wszystko inne to przedsięwzięcia niskobudżetowe. Ludzie wolą pójść do kina. Taniej, efektowniej, łatwiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725267
    m_Localized: 'Bald: Więc tak… to jedno, wielkie rozczarowanie, przyjacielu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725268
    m_Localized: 'Bald: Raz, dwa, trzy, cztery… Może wszystko sfajczę bez kozery… Żartuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725269
    m_Localized: Okej, teatr jest do bani, a co z twoimi przyjaciółmi?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725270
    m_Localized: 'Bald: Racja, zszedłem z tematu. Wybacz, często robię dygresje. Trudno mi się skupić na jednej rzeczy. Wracam do meritum.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725271
    m_Localized: 'Bald: Moi przyjaciele to sami aktorzy, producenci, nagłośnieniowcy, oświetleniowcy i tym podobni.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725272
    m_Localized: 'Bald: Od początku razem dawaliśmy w palnik. Na urodziny wynajmowałem nawet niewielkie sceny – zjawiało się nawet sto osób!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725273
    m_Localized: 'Bald: Coś wspaniałego! Wyobraź sobie, że masz setkę gości na urodzinach! To były czasy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725274
    m_Localized: 'Bald: Ale świat teatru toczy też wiele zawiści. Każdy pod każdym dołki kopie. Kasy brakło, stresu zbyt wiele.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725275
    m_Localized: 'Bald: Z czasem zaprzestałem tych imprez.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725276
    m_Localized: 'Bald: Zdałem sobie też sprawę, że większość z obecnych nie było moimi przyjaciółmi… przychodzili tylko… popatrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725277
    m_Localized: 'Bald: Wykorzystywali mnie, gdy było im to wygodne, lub obgadywali mnie za moimi plecami.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725278
    m_Localized: 'Bald: Ale hej, nie zrozum mnie źle! Przysiadłem, zrobiłem listę i doszedłem do tego, kogo wywalić na zbity pysk.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725279
    m_Localized: 'Bald: Raz, dwa, trzy, cztery… Może wszystko sfajczę bez kozery… Żartuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725280
    m_Localized: I gdzie są ci przyjaciele z listy?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725281
    m_Localized: 'Bald: Gdy zaczęła się heca z komornikami, zacząłem szukać pomocy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725282
    m_Localized: 'Bald: I wtedy oczywiście słońce zaczęło nas smażyć i przypełzli Przybysze. Normalnie z deszczu pod rynnę.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725283
    m_Localized: 'Bald: Chodziłem więc od przyjaciela do przyjaciela.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725284
    m_Localized: 'Bald: Jeden spalił się żywcem, bo zasnął po pijaku na placu zabaw i nie obudził się przed wschodem.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725285
    m_Localized: 'Bald: Inny został zamordowany… Dajesz wiarę? Myśleli, że był Przybyszem!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725286
    m_Localized: 'Bald: Czyste szaleństwo! Te „objawy” z dupy są wyjęte! Mój przyjaciel zginął na marne.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725287
    m_Localized: 'Bald: Tak strasznie mnie to wkurwia i nie wiem nawet, co zrobić z tym gniewem.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725288
    m_Localized: 'Bald: Złość i bezsilność sprawia, że nie wiadomo, co począć. Zaczyna się nienawidzić wszystkich wokół i samego siebie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725289
    m_Localized: 'Bald: Oby chuj strzelił… tych wydymańców.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725290
    m_Localized: 'Bald: Raz, dwa, trzy, cztery… Może wszystko sfajczę bez kozery… Żartuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725291
    m_Localized: Co to za historia z komornikami?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725292
    m_Localized: 'Bald: Mieszkałem z matką i babcią.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725293
    m_Localized: 'Bald: Ojciec odszedł, też był aktorem. Pijak zdradzający matkę. Teatralny klasyk, nie? Matka pracowała przy kostiumach.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725294
    m_Localized: 'Bald: Całe życie starała się mnie chronić. Kiedy dorosłem, dowiedziałem się, że tonęliśmy w problemach.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725295
    m_Localized: 'Bald: U matki niełatwo było z pracą. Duże teatry? Zapomnij, to niemożliwe. Małe? Płaciły grosze lub nie miały wakatów.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725296
    m_Localized: 'Bald: Wzięła więc pożyczkę. Nie od znajomego, ale od jakiejś firmy. Żebyśmy z głodu nie poumierali.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725297
    m_Localized: 'Bald: No i nie była w stanie jej spłacić. Wtedy zaczęli przychodzić komornicy.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725298
    m_Localized: 'Bald: Pamiętam naszą żelazną zasadę: nie otwieraj drzwi, jeśli się nikogo nie spodziewasz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725299
    m_Localized: 'Bald: A jeśli po powrocie do domu ktoś kręcił się pod drzwiami? Szło się na spacer i wracało po kilku godzinach.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725300
    m_Localized: 'Bald: Było przejebanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725301
    m_Localized: 'Bald: I ze wszystkim innym, co się działo… ludziom odwaliło, a szczególnie komornikom.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725302
    m_Localized: 'Bald: Raz wracam do domu, a tam drzwi na oścież. W środku wszystko rozwalone. Matka i babka… Cholera… palce i nogi… połamane.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725303
    m_Localized: 'Bald: To był, kurwa… koszmar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725304
    m_Localized: 'Bald: Wtem zjawiło się dwóch dryblasów…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725305
    m_Localized: 'Bald: I wziąłem nogi za pas. Nie mogłem inaczej.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725306
    m_Localized: 'Bald: Robiłem w gacie ze strachu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725307
    m_Localized: 'Bald: Ale, kurwa, nienawidzę się za to, że nie stanąłem w ich obronie. Za tchórzowską ucieczkę. Za to, że nigdy nie wróciłem.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725308
    m_Localized: 'Bald: Zbyt bardzo się boję.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725309
    m_Localized: 'Bald: O własną skórę.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725310
    m_Localized: 'Bald: I aż brak mi słów… jak bardzo jest to pojebane.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725311
    m_Localized: 'Nervous: Nie chcę tam wracać. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725312
    m_Localized: Jesteś… dosyć dziwny
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725313
    m_Localized: 'Nervous: O, serio? I co ci do tego? Hę? Hę?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725314
    m_Localized: 'Nervous: Też mnie szpiegujesz? Hę? Hę?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725315
    m_Localized: 'Nervous: Wiedz, że tego nie lubię. Od czasu pobytu w wariatkowie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725316
    m_Localized: 'Nervous: Wyobrażasz sobie, że rodzina mnie oddała do domu dla obłąkanych? Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725317
    m_Localized: 'Nervous: No, mówili mi, że też troszkę kogoś śledziłem. I co z tego?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725318
    m_Localized: 'Nervous: Nie zrobiłem nic złego. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725319
    m_Localized: 'Nervous: Ale rodzice mieli mnie za stuuukniętego. Może wciąż tak myślą.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725320
    m_Localized: 'Nervous: W wariatkowie trzymali mnie przez dziesięć lat. Jakbym był jakimś psychopatą. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725321
    m_Localized: 'Nervous: A to wszystko z powodu tego jednego razu…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725322
    m_Localized: 'Nervous: Ach, mniejsza z tym. Muszę zadzwonić do hotelu. Dzyń, dzyń, dzyń!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725323
    m_Localized: 'Nervous: Nie chcę tam wracać. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725324
    m_Localized: O czym przed chwilą wspomniałeś?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725325
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725326
    m_Localized: 'Nervous: W szkole mi dokuczali. Nie dawali mi spokoju. Dzień za dniem. Dokuczanie, dokuczanie, dokuczanie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725327
    m_Localized: 'Nervous: W końcu miałem dość. Nie jestem niczyim popychadłem ani słabeuszem do kopania, że aż zaczyna piszczeć…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725328
    m_Localized: 'Nervous: Oddałem mu. On upadł… i już nie wstał. Słyszałem, że trafił do szpitala. Nie przeżył.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725329
    m_Localized: 'Nervous: Nie chciałem go zabić. Jednak, jednak, jednak… moim rodzicom udało się to jakoś załagodzić. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725330
    m_Localized: 'Nervous: Wciąż o mnie szepczą… Słyszysz? Ciii…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725331
    m_Localized: 'Nervous: Wtedy wysłali mnie do czubków. I jesteśmy w punkcie wyjścia!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725332
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725333
    m_Localized: 'Nervous: Ta bójka… Była przyjemnym uczuciem… Władza… Zemsta…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725334
    m_Localized: 'Nervous: Ból w knykciach był przyjemny. Smak krwi na ustach, języku… Mmm…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725335
    m_Localized: 'Nervous: Wyrzucili mnie ze szkoły, a tylko się broniłem. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725336
    m_Localized: 'Nervous: Nie chcę tam wracać. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725337
    m_Localized: W domu wariatów chyba ci nie pomogli
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725338
    m_Localized: 'Nervous: Ani odrobineczkę. Hi, hi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725339
    m_Localized: 'Nervous: Gdy tabletkami zmieniają cię w warzywo… dusisz się!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725340
    m_Localized: 'Nervous: Nie polepszyło mi się. Nic nie było łatwiej. Dziesięć lat minęło i taki oto jestem. Ta‑da!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725341
    m_Localized: 'Nervous: I wszystko z powodu tego jednego, maleńkiego razu, kiedy…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725342
    m_Localized: 'Nervous: Hi, hi, hi, hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725343
    m_Localized: 'Nervous: Och, jak gdyby nie można było popełnić błędu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725344
    m_Localized: 'Nervous: Spójrz na siebie i twoją osądzająco‑srającą minę.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725345
    m_Localized: 'Nervous: Chcesz mi przyłożyć? Dawaj!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725346
    m_Localized: 'Nervous: Rozwal mi facjatę, połam palce! TAK! Daj mi tę adrenalinę, nakarm mnie nią! Taaak!'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725347
    m_Localized: 'Nervous: Co? Nie uderzysz mnie? Nie masz ochoty?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725348
    m_Localized: 'Nervous: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725349
    m_Localized: 'Nervous: Hi, hi… Wtedy tutaj poczekam.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725350
    m_Localized: 'Nervous: Tutaj jest… spokojniej niż w hotelu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725351
    m_Localized: 'Nervous: Dzięki, że mnie wpuściłeś. Hi, hi…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725352
    m_Localized: 'Nervous: Przynajmniej wszyscy mamy tutaj bzika…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725353
    m_Localized: 'Leper: Tak? O co chodzi?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725354
    m_Localized: Pewnie niełatwo jest żyć z takim wyglądem?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725355
    m_Localized: 'Leper: Nie, nie całkiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725356
    m_Localized: 'Leper: Za wyjątkiem szkoły. Nazywali mnie tam „trędowaty” i nikt się ze mną nie bawił. Wszyscy myśleli, że się czymś zarażą.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725357
    m_Localized: 'Leper: Byłem pewny, że jak dorosnę, to się to skończy. I tak było… prawie. Ludzie wciąż się gapią, ale to nic.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725358
    m_Localized: 'Leper: Wtedy nadszedł kataklizm i nagle wróciły wszystkie stare uprzedzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725359
    m_Localized: 'Leper: Tylko teraz jest gorzej, bo stawką jest przeżycie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725360
    m_Localized: 'Leper: No i przez tę skórę wyglądam na Przybysza.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725361
    m_Localized: 'Leper: Ale po począć? Ciężkie czasy wywlekają z ludzi to, co najgorsze.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725362
    m_Localized: 'Leper: Tak? O co chodzi?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725363
    m_Localized: Mają cię za Przybysza z powodu twojej skóry?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725364
    m_Localized: 'Leper: Oczywiście. A czego innego się spodziewałeś?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725365
    m_Localized: 'Leper: Wszyscy na wszystkich patrzą spode łba.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725366
    m_Localized: 'Leper: Każdy, kto nie wygląda „normalnie”, jest podejrzanym. A FEMA pełni rolę i sędziego, i kata.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725367
    m_Localized: 'Leper: Zastanawiam się, czy to oni czasem za tym wszystkim nie stoją.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725368
    m_Localized: 'Leper: A co, jeśli to oni sami wymyślili Przybyszy? Jak myślisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725369
    m_Localized: Może masz rację
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725370
    m_Localized: Myślę, że Przybysze istnieją naprawdę
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725371
    m_Localized: 'Leper: Fajnie, że się zgadzasz. Przybysze‑srybysze.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725372
    m_Localized: 'Leper: To brzmi bardziej jak fabuła z jakiegoś filmu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725373
    m_Localized: 'Leper: Może to ich sposób na obalenie rządu. Strach jest przecież narzędziem władzy, nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725374
    m_Localized: 'Leper: Pewnie dlatego wrzucają wszystkich, który się stawiają, do „stref kwarantanny”.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725375
    m_Localized: 'Leper: A przez to także wydaje się, że walczą z Przybyszami.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725376
    m_Localized: 'Leper: Nawet jeśli Przybysze nie istnieją, wolałbym, by ludzie z FEMA nie zaczęli się mną interesować.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725377
    m_Localized: 'Leper: Nie mogę oprzeć się wrażeniu, że zrobiliby mi coś okropnego.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725378
    m_Localized: 'Leper: Naprawdę tak uważasz?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725379
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725380
    m_Localized: 'Leper: Nawet jeśli to prawda, czy nie wydaje ci się, że działania FEMA są dziwne?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725381
    m_Localized: 'Leper: Twierdzą, że Przybysze to jakiś wirus, ale nie wyjaśnią, jak się można nim zarazić?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473045725382
    m_Localized: 'Leper: To powinno być pierwszym, co trzeba zrobić, by go powstrzymać.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919488
    m_Localized: 'Leper: Sam nie wiem… Może pracują nad jakąś „szczepionką”.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919489
    m_Localized: 'Leper: Czuję jednak w kościach… że gdybym trafił do strefy kwarantanny, zrobiliby mi coś okropnego.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919490
    m_Localized: 'Leper: Tak? O co chodzi?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919491
    m_Localized: Dlaczego uważasz, że FEMA zrobi coś złego?
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919492
    m_Localized: 'Leper: To przez nich ludzie nie widzą we mnie nic innego, prócz mojego problemu skórnego…'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919493
    m_Localized: 'Leper: Stałem się przez to łatwym celem. Większe prawdopodobieństwo, że to mnie wybiorą z grupy ludzi do ich… eksperymentów.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919494
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919495
    m_Localized: 'Leper: A to wszystko przez moją cholerną skórę.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919496
    m_Localized: Jesteś u mnie, nie masz powodów do obaw
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919497
    m_Localized: Za bardzo się martwisz
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919498
    m_Localized: 'Leper: Ach tak? Więc nie pukali jeszcze do twoich drzwi, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919499
    m_Localized: 'Leper: Naprawdę myślisz, że tak po prostu by mnie zignorowali? Z moim wyglądem?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919500
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919501
    m_Localized: 'Leper: Tak uważasz, co?! A słyszałeś o podpaleniu przedszkola?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919502
    m_Localized: 'Leper: Gdzie rodzice spalili żywcem własne dzieci?'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919503
    m_Localized: 'Leper: Nie pojmujesz, że mentalnie cofnęliśmy się o kilkaset lat? Szaleństwo szerzy się jak zaraza, a dla FEMA to sama pożywka.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919504
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919505
    m_Localized: 'Leper: Chciałbym, aby ludzie przestali oceniać innych po wyglądzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919506
    m_Localized: 'Leper: Ale wygląda na to, że nieważne, ile trwać będzie ludzkość, uprzedzenia nie odejdą do lamusa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919507
    m_Localized: 'Leper: W ten sposób łatwiej określić, kto jest „nasz”, a kto nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919508
    m_Localized: 'Leper: I z powodu tego prostackiego okrucieństwa cierpią tacy ludzie, jak ja.'
    m_Metadata:
      m_Items: []
  - m_Id: 74175473049919509
    m_Localized: 'Leper: To jest takie… tragiczne.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891008
    m_Localized: 'Fairytaller: Potrzebuje pan czegoś, gospodarzu?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891009
    m_Localized: Zdajesz się być pogrążony w myślach
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891010
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891011
    m_Localized: Wręcz wezwanie od FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891012
    m_Localized: 'Fairytaller: Rozmyślałem właśnie o opowieści z dzieciństwa. O pewnym grodzie Kraka, gdzie bestia pożerała dziewice…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891013
    m_Localized: 'Fairytaller: Był to Smok Wawelski, który palił wszystko – zwierzęta, pastwiska…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891014
    m_Localized: 'Fairytaller: Widzisz, ludzie i smoki żyli kiedyś w zgodzie. Byli równi wobec życia i korzystali z dobrodziejstw ziemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891015
    m_Localized: 'Fairytaller: Lecz smok zaczął chełpić się swoją siłą i zaczął wszystko niszczyć, nawet to, co mógłby kiedyś wielbić.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891016
    m_Localized: 'Fairytaller: Ojciec powtarzał nam, że taki smok drzemie w każdym człowieku.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891017
    m_Localized: 'Fairytaller: Z siostrą nigdy w to nie wierzyliśmy i śmialiśmy się. „Smoki są wielkie, a ludzie malutcy” – mówiliśmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891018
    m_Localized: 'Fairytaller: Ale potem wydoroślałem i w końcu zrozumiałem. Szkoda, że tata nigdy o tym się nie dowie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891019
    m_Localized: 'Fairytaller: Od czasu do czasu zastanawiam się… czy będę w stanie ubić własnego smoka? Czy może ulegnę pokusie?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891020
    m_Localized: 'Fairytaller: Potrzebuje pan czegoś, gospodarzu?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891021
    m_Localized: Znowu myślisz o baśniach?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891022
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891023
    m_Localized: Wręcz wezwanie od FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891024
    m_Localized: 'Fairytaller: Tak. O poszukiwaczu przygód, co pomógł zacnemu panu serce przez diabła w kamień obrócone odmienić.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891025
    m_Localized: 'Fairytaller: Diabeł, by pakt wypełnić, kazał panu wypełnić trzy niemal niemożliwe do wykonania zadania.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891026
    m_Localized: 'Fairytaller: Ten wedle umowy nie mógł ich wykonać osobiście, ale poszukiwacz przygód mu w tym pomógł.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891027
    m_Localized: 'Fairytaller: Zajęło to poszukiwaczowi mnóstwo czasu i wiele trudów kosztowało. Szmat świata i zaświatów musiał przebyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891028
    m_Localized: 'Fairytaller: Po spełnieniu wszystkich trzech zadań i pokonaniu przebiegłego diabła, poszukiwacz przygód zyskał wdzięczność pana.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891029
    m_Localized: 'Fairytaller: Morał jest taki, że nawet, jak coś wydaje się niemożliwe, można to osiągnąć, jeśli bardzo się chce.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891030
    m_Localized: 'Fairytaller: Trzeba tylko zachować światełko w sercu, nawet jeśli świat dookoła pełny jest mroku.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891031
    m_Localized: 'Fairytaller: Moja świętej pamięci matka zawsze żartowała, że morał jest prosty: bez chęci się zmian nie zanęci.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891032
    m_Localized: 'Fairytaller: Bo w końcu to my dbamy o ten świat i o bliskich. Jeśli nie będziemy się starać, marny nasz los.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891033
    m_Localized: 'Fairytaller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891034
    m_Localized: 'Fairytaller: Staram się zachować uprzejmość i człowieczeństwo. Pomimo bólu. Wbrew nadziei wierząc, że to odmieni innych.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891035
    m_Localized: 'Fairytaller: Potrzebuje pan czegoś, gospodarzu?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891036
    m_Localized: Jaką ma pan dla mnie dzisiaj opowiastkę?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891037
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891038
    m_Localized: Wręcz wezwanie od FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891039
    m_Localized: 'Fairytaller: Wciąż mam ich pełno do opowiedzenia… nocy żywych trupów, i o tych, co przeżyli…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891040
    m_Localized: 'Fairytaller: O diable w ludzkiej skórze, pukającym do drzwi i mamiącym ludzi do świtu pytaniami…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891041
    m_Localized: 'Fairytaller: O gniewie szkarłatnego słońca wobec ludzi, co zgubę przyniósł zbiorom i wytruł rzeki…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891042
    m_Localized: 'Fairytaller: Ale zawsze zjawia się bohater, grupa prawych ludzi lub cały ich naród, który ratuje świat.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891043
    m_Localized: 'Fairytaller: Dobro zawsze zwycięża.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891044
    m_Localized: 'Fairytaller: Chcę wierzyć, że to, co się dzieje, też przeminie. Że nadejdzie, rok, dzień, a może chwila, kiedy to się skończy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891045
    m_Localized: 'Fairytaller: I nasi rodzice będą wciąż żywi i wszyscy będą mogli robić to, co kochają. A także…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891046
    m_Localized: 'Fairytaller: Wybacz, trochę się zagalopowałem. Potrzebuję pobyć trochę w samotności.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891047
    m_Localized: 'FunnyGuy: Moglibyśmy żyć bez żadnych zmartwień!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891048
    m_Localized: Skąd pewność, że zapomnieli o twoim kredycie?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891049
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891050
    m_Localized: Wręcz wezwanie od FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891051
    m_Localized: 'FunnyGuy: Stroisz sobie żarty?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891052
    m_Localized: 'FunnyGuy: Człowieku, jest koniec świata! Gdzie masz banki, gdzie ekonomię?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891053
    m_Localized: 'FunnyGuy: Nikogo to nie obchodzi. Sam widziałem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891054
    m_Localized: 'FunnyGuy: Zazwyczaj, jak zwlekam ze spłatą, to dostaje upomnienia, listy, groźby i inne takie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891055
    m_Localized: 'FunnyGuy: Ale tym razem… nic a nic. Piękna sprawa!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891056
    m_Localized: 'FunnyGuy: I co by mieli zrobić z listą dłużników, których można znaleźć tylko po zmroku?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891057
    m_Localized: 'FunnyGuy: Nikt nie oferuje też nowych pożyczek. Próbowałem!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891058
    m_Localized: 'FunnyGuy: Ale co tam! Wolność od kajdan finansowego niewolnictwa jest tego warta!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891059
    m_Localized: Jeszcze bym tego nie świętował
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891060
    m_Localized: To jak? Trzeba to jakoś uczcić!
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891061
    m_Localized: 'FunnyGuy: Oj, daj spokój!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891062
    m_Localized: 'FunnyGuy: Po co się martwić? Zapomnieli o mnie. Pewnie zajęci są budową bunkrów lub czegoś takiego.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891063
    m_Localized: 'FunnyGuy: Po co mieliby się kłopotać ściganiem jakiegoś chłopka roztropka?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891064
    m_Localized: To czemu nie siedzisz u siebie?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891065
    m_Localized: Przyszedłeś mi się tu tym pochwalić?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891066
    m_Localized: 'FunnyGuy: Żebyś wiedział!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891067
    m_Localized: 'FunnyGuy: Tak mi dopisuje humor, że musiałem się wygadać, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891068
    m_Localized: To czemu nie siedzisz u siebie?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891069
    m_Localized: Przyszedłeś mi się tu tym pochwalić?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891070
    m_Localized: 'FunnyGuy: Cóż…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891071
    m_Localized: 'FunnyGuy: Wynajmowałem komuś. Wciąż to, teoretycznie, robię. Ostatnio jednak kasa straciła na znaczeniu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311406891072
    m_Localized: 'FunnyGuy: Wystarczy się przejść, wybić witrynę i wziąć, co się potrzebuje.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862528
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862529
    m_Localized: 'FunnyGuy: Co? Co się tak patrzysz?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862530
    m_Localized: Dlaczego unikasz odpowiedzi?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862531
    m_Localized: Właśnie mnie naszło, że mam to gdzieś
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862532
    m_Localized: 'FunnyGuy: No weź, stary. Nie trzeba być uszczypliwym. Nie powiedziałem nic złego.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862533
    m_Localized: 'FunnyGuy: Jezu, jeśli chciałeś być dowcipny, nie musiałeś być taki wredny.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862534
    m_Localized: 'FunnyGuy: Aż uszła ze mnie cała wesołość.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862535
    m_Localized: Dlaczego unikasz odpowiedzi?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862536
    m_Localized: Właśnie mnie naszło, że mam to gdzieś
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862537
    m_Localized: 'FunnyGuy: Tak, tak…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862538
    m_Localized: 'FunnyGuy: Słuchaj…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862539
    m_Localized: 'FunnyGuy: Niczego nie unikam. Tylko… boję się, okej? Boję się tam wrócić.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862540
    m_Localized: 'FunnyGuy: Wynająłem mieszkanie dwuosobowej rodzinie. Pomagało to w spłacie kredytu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862541
    m_Localized: 'FunnyGuy: A teraz… nie wiem, czy oni wciąż… są ludźmi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862542
    m_Localized: 'FunnyGuy: Sąsiedzi dzwonili kilka razy. Skarżyli się na walenie w ściany, krzyki, uciążliwy ruch ludzi w te i we wte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862543
    m_Localized: 'FunnyGuy: Z drugiej strony ci sąsiedzi to stare pierniki i do tego panikarze. Mam ich dość.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862544
    m_Localized: 'FunnyGuy: Ale co, jeśli mają rację?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862545
    m_Localized: 'FunnyGuy: Czekaj, pozwól, że skończę.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862546
    m_Localized: 'FunnyGuy: Muszę się z czegoś zwierzyć. Nie widzisz, jakie to dla mnie niezręczne?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862547
    m_Localized: 'FunnyGuy: Kupiłem sobie mieszkanie, a teraz mam zbyt dużego pietra, żeby w nim żyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862548
    m_Localized: 'FunnyGuy: Wynająłem je takiej jednej rodzinie, a opłatą spłacałem raty kredytu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862549
    m_Localized: 'FunnyGuy: A teraz… kurwa… Trzęsę gaciami przed zapukaniem do drzwi…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862550
    m_Localized: 'FunnyGuy: Sąsiedzi mówili, że działy się tam dziwne rzeczy, że rzadko stamtąd wychodzili.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862551
    m_Localized: 'FunnyGuy: Racja, może i kredyt mi już nie ciąży, ale, kurde, przecież nie wyrzucę ich stamtąd na ulicę!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862552
    m_Localized: 'FunnyGuy: Moglibyśmy żyć bez żadnych zmartwień!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862553
    m_Localized: Jakieś wieści o lokatorach?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862554
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862555
    m_Localized: Wręcz wezwanie od FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862556
    m_Localized: 'FunnyGuy: Hę? Ach, o nich? Miałem inne sprawy na głowie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862557
    m_Localized: 'FunnyGuy: Zadzwoniłem dziś do sąsiadów, mam nadzieję, że nie masz mi tego za złe.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862558
    m_Localized: 'FunnyGuy: Mówili, że zjawili się jacyś goście z banku i pytali o moją spłatę.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862559
    m_Localized: 'FunnyGuy: Dobrze, że tam nie mieszkam, ale…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862560
    m_Localized: 'FunnyGuy: Czy te typy będą mnie ścigać, nawet gdy słońce wybuchnie, czy coś?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862561
    m_Localized: 'FunnyGuy: Wyobrażasz sobie?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862562
    m_Localized: 'FunnyGuy: Bez kitu, zaraz pewnie zaczną wskrzeszać swoich dłużników.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862563
    m_Localized: 'FunnyGuy: Czy nie powinni zająć się ratowaniem własnej skóry? Po co uganiać się za nami?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862564
    m_Localized: 'FunnyGuy: Sukinsyny.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862565
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862566
    m_Localized: 'FunnyGuy: Zostanę u ciebie na trochę, a potem może znowu z rodziną.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862567
    m_Localized: 'FunnyGuy: W kupie raźniej, co nie?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862568
    m_Localized: 'FunnyGuy: Ale nie no, serio, pieprzone dusigrosze. Jest koniec świata, a oni wciąż swoje! Ja pierdolę!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862569
    m_Localized: 'FunnyGuy: Bóg ich osądzi…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862570
    m_Localized: 'FunnyGuy: Moglibyśmy żyć bez żadnych zmartwień!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862571
    m_Localized: Wracasz do swojego mieszkania?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862572
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862573
    m_Localized: Wręcz wezwanie od FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862574
    m_Localized: 'FunnyGuy: Ale z tym bałagan, prawdziwy burdel.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862575
    m_Localized: 'FunnyGuy: Znowu skorzystałem z twojego telefonu, nie masz nic przeciwko, nie? Tym razem zadzwoniłem do banku.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862576
    m_Localized: 'FunnyGuy: Zamrozili mi konta, a miałem nieco oszczędności!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862577
    m_Localized: 'FunnyGuy: Teraz nie mogę wyciągnąć ani grosza.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862578
    m_Localized: 'FunnyGuy: Mówili, że to z powodu długu, ale to bujda. Mogliby sami co miesiąc ściągać należności z konta.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862579
    m_Localized: 'FunnyGuy: Ale żeby zaraz zamrażać? Nonsens.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862580
    m_Localized: 'FunnyGuy: Założę się, że zrobili to, by finansować projekty FEMA. Wypłaty, eksperymenty i inne takie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862581
    m_Localized: 'FunnyGuy: Jebać ich… Nie będę płacił.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862582
    m_Localized: 'FunnyGuy: Zostanę u ciebie na trochę, jeśli ci to nie wadzi. Jestem zbyt skrępowany, żeby wracać teraz do rodziny.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862583
    m_Localized: 'FunnyGuy: A moje mieszkanie to teraz już pewnie gniazdo Przybyszy albo laboratorium FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862584
    m_Localized: 'Alt: Z dnia na dzień jest coraz ciężej…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862585
    m_Localized: Nieźle się rozgadałaś na progu
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862586
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862587
    m_Localized: Wręcz wezwanie od FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862588
    m_Localized: 'Alt: Ach, zauważyłeś.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862589
    m_Localized: 'Alt: Zboczenie zawodowe, tak sądzę. Ta moja gadanina. Zwłaszcza, gdy jestem poddenerwowana.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862590
    m_Localized: 'Alt: Zawsze uważam, że muszę załagodzić sprawę, rozwiązać wszystkie problemy. Sprawić, by obie strony były zadowolone.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862591
    m_Localized: 'Alt: Byłam dziennikarką w radiu…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862592
    m_Localized: O kurczę
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862593
    m_Localized: Nigdy bym nie zgadł
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862594
    m_Localized: 'Alt: Słucham?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862595
    m_Localized: 'Alt: Wierz mi lub nie, ale mam to gdzieś. Niestety pozostanie tam było niemożliwe.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862596
    m_Localized: 'Alt: Odwala się tam totalny cyrk. Każdy wyłudzacz chce coś komuś sprzedać, oferując spokój ducha za wygórowane ceny.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862597
    m_Localized: 'Alt: „Cudny balsam na wszystkie problemy”. „Połóż szklankę z wodą przy radiu! Wchłonie wszystkie fale!”.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862598
    m_Localized: 'Alt: I było tylko gorzej.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862599
    m_Localized: 'Alt: Miałam dość, nie chciałam zostawać tam ani chwili dłużej.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862600
    m_Localized: 'Alt: A nawet nie wspomnę o wiadomościach. Słuchałam tego i zastanawiałam się, jakim cudem jeszcze żyjemy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862601
    m_Localized: 'Alt: Więc jak według ciebie wygląda radiowy dziennikarz? Jakiś mądrala w okularach i garniturze?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862602
    m_Localized: 'Alt: Myślisz stereotypowo. Rozumiem, ale to twoja wina.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862603
    m_Localized: 'Alt: Ja też myślałam, że będę dyskutowała z interesującymi przybyszami do studia… Ekhm, to znaczy gośćmi w studiu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862604
    m_Localized: 'Alt: Zamiast tego składałam ponure nowiny jedną za drugą. Walka z pokusą, by nie skończyć ze wszystkim, była coraz trudniejsza.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862605
    m_Localized: 'Alt: Na dodatek wciąż wciskali się do nas debile, by sprzedawać powietrze. Dosłownie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862606
    m_Localized: 'Alt: Z radia stał się cyrk. A ja byłam głównym klaunem na scenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862607
    m_Localized: 'Alt: Z dnia na dzień jest coraz ciężej…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862608
    m_Localized: Więc miałaś tego po dziurki w nosie i odeszłaś?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862609
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862610
    m_Localized: Wręcz wezwanie od FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862611
    m_Localized: 'Alt: Hm… jeśli mielibyśmy podsumować naszą rozmowę…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862612
    m_Localized: 'Alt: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862613
    m_Localized: 'Alt: Wiesz, co było kroplą, która przepełniła czarę goryczy? Wywiad z kolejnym z wielu świrów.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862614
    m_Localized: 'Alt: Powiedziano nam, że do audycji na żywo przyjdzie jakiś „ekspert”, aby porozmawiać o Przybyszach.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862615
    m_Localized: 'Alt: Zaklinał się, że znalazł na nich sposób… Zapomniałam już, co to miało być. Jakiś nadmiernie drogi stek bzdur.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862616
    m_Localized: 'Alt: Nawet zapłacił z góry za czas na antenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862617
    m_Localized: 'Alt: Tydzień szukałam o nim informacji. Wygrzebałam wszystkie brudy i przygotowałam się, by go zniszczyć na żywo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862618
    m_Localized: 'Alt: Byłby to niezapomniany wywiad…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862619
    m_Localized: 'Alt: Ale nigdy nie doszedł do skutku. Wiesz czemu?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862620
    m_Localized: 'Alt: Nie przyszedł, bo ktoś ukradł jego opracowania.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862621
    m_Localized: 'Alt: Teczki ponoć pękały w szwach!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862622
    m_Localized: 'Alt: Jakim trzeba być imbecylem, żeby do tego dopuścić.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862623
    m_Localized: 'Alt: Mój cały plan spełzł na niczym. Całe dochodzenie o nim na nic. Przestał odbierać od nas telefony.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862624
    m_Localized: 'Alt: Drań.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862625
    m_Localized: 'Alt: Z dnia na dzień jest coraz ciężej…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862626
    m_Localized: Skończyłaś wtedy z dziennikarstwem?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862627
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862628
    m_Localized: Wręcz wezwanie od FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862629
    m_Localized: 'Alt: Przeżycie jest jedynym planem, jaki mi pozostał.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862630
    m_Localized: 'Alt: Próbowałam wślizgnąć się do innych wydziałów. Zwłaszcza po tym, jak zaczęły się wyrzuty masy słonecznej.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862631
    m_Localized: 'Alt: Ale trend był jasny – równia pochyła w dół.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862632
    m_Localized: 'Alt: Policja przysyłała nam raporty z całego miasta. To było nasze główne źródło wiadomości.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862633
    m_Localized: 'Alt: Wtedy te nowiny zaczęto wysyłać z opóźnieniem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862634
    m_Localized: 'Alt: I zauważyłam, że spisane były jakoś inaczej. Można było to zauważyć, czytając to samo dzień za dniem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862635
    m_Localized: 'Alt: Nagle coś było z nimi… nie tak.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862636
    m_Localized: 'Alt: To był moment, w którym zdecydowałam trzymać się z dala od miast.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862637
    m_Localized: 'Alt: Lepiej pozostać gdzieś na obrzeżach. Brałam także pod uwagę życie w lesie, ale to teraz nienajlepszy pomysł.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862638
    m_Localized: 'Alt: Życie stało się… trudne do przeżycia.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862639
    m_Localized: 'Tourist: Gdybym tylko mógł się stąd wydostać.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862640
    m_Localized: Dokąd pan zmierzał?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862641
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862642
    m_Localized: Wręcz wezwanie od FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862643
    m_Localized: 'Tourist: A jakie to ma znaczenie? I tak nigdy nie wrócę do domu…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862644
    m_Localized: 'Tourist: Przeklęte słońce, do diabła z nim i z całą tą epidemią Przybyszy.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862645
    m_Localized: 'Tourist: Czy to dzieje się tylko tutaj, czy wszędzie?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862646
    m_Localized: 'Tourist: Od tak dawna planowałem ten wyjazd.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862647
    m_Localized: 'Tourist: Oszczędzałem, błagałem o urlop…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862648
    m_Localized: 'Tourist: I co z tego mam? Wakacje skończyły się, zanim się rozpoczęły.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862649
    m_Localized: 'Tourist: Gdybym tylko mógł się stąd wydostać.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862650
    m_Localized: Dlaczego nie wyjechał pan prędzej?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862651
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862652
    m_Localized: Wręcz wezwanie od FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862653
    m_Localized: 'Tourist: Wspominałem, gospodarzu. Dostawałem same kłody pod nogi, jedna za drugą…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862654
    m_Localized: 'Tourist: A poza tym uważałem, że teraz to najlepszy czas na wyjazd.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862655
    m_Localized: 'Tourist: W końcu móc się opalić…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862656
    m_Localized: 'Tourist: Gdybym wiedział, że do tego dojdzie, wyjechałbym wcześniej. Zobaczyć świat, póki jeszcze było można.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862657
    m_Localized: 'Tourist: Teraz pozostało mi oglądanie go na zdjęciach. Wszystkie te kraje piorun trafił.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862658
    m_Localized: 'Tourist: Gdybym tylko mógł się stąd wydostać.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862659
    m_Localized: A może miał pan szczęście? Przynajmniej nie spłonął pan żywcem
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862660
    m_Localized: Chcę pana sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862661
    m_Localized: Wręcz wezwanie od FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862662
    m_Localized: 'Tourist: Szczęście? Szanowny pan raczy żartować.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862663
    m_Localized: 'Tourist: Całe życie chciałem zobaczyć świat, a teraz nie wiem nawet, czy w ogóle coś zobaczę.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862664
    m_Localized: 'Tourist: I pan, gospodarzu, nazywa to szczęściem? Gdzie tu szczęście?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862665
    m_Localized: No kurwa, żyje pan, no nie?
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862666
    m_Localized: Panie, to tylko wakacyjna podróż
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862667
    m_Localized: 'Tourist: No, na razie żyję. A co dalej?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862668
    m_Localized: 'Tourist: Słońce wybuchnie i tyle z tego będzie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862669
    m_Localized: 'Tourist: Umrę bez zwiedzenia świata…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862670
    m_Localized: I mam panu przez to współczuć? Przestań się pan użalać nad sobą
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862671
    m_Localized: To psioczenie zaczyna mi srogo działać na nerwy
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862672
    m_Localized: 'Tourist: To nie były tylko wakacje, ale moje marzenie.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862673
    m_Localized: 'Tourist: Całe życie chciałem zobaczyć świat, a teraz co?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862674
    m_Localized: 'Tourist: Przepadło. Nie będzie drugiej okazji.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862675
    m_Localized: 'Tourist: Powinienem był wyjechać przed tym wszystkim. Teraz czekamy tylko na śmierć…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862676
    m_Localized: I mam panu przez to współczuć? Przestań się pan użalać nad sobą
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862677
    m_Localized: To psioczenie zaczyna mi srogo działać na nerwy
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862678
    m_Localized: 'Tourist: Ale ja… ja…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862679
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862680
    m_Localized: 'Tourist: Nie jestem w stanie się z tym pogodzić, przykro mi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862681
    m_Localized: 'Tourist: Zdałem sobie sprawę… że nic mnie nie powstrzymywało przed wcześniejszym wyjazdem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862682
    m_Localized: 'Tourist: Ale wciąż przekładałem terminy, wmawiając sobie, że później przyjdzie na to czas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862683
    m_Localized: 'Tourist: A teraz… jest za późno.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862684
    m_Localized: 'Tourist: Świat się kończy, a wciąż jest tyle rzeczy, które chciałem zobaczyć… i zrobić.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862685
    m_Localized: 'Tourist: Będę musiał jakoś z tym żyć.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862686
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862687
    m_Localized: 'Tourist: Panie, weź pan wypierdalaj!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862688
    m_Localized: 'Tourist: Co, nie mogę boleć nad tym, co utraciłem?'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862689
    m_Localized: 'Tourist: Sam pan przecież widzi, że stare czasy nigdy nie wrócą. Nadszedł koniec!'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862690
    m_Localized: 'Tourist: Widzę to w pana oczach, pogodził się pan z tym. Ja jednak nie chcę umierać.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862691
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862692
    m_Localized: 'Tourist: Co ja w ogóle mówię… Pan pewnie stopy za progiem nigdy nie postawił. Dla pana pewnie nic się nie zmieniło.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862693
    m_Localized: Zaczyna mi pan działać na nerwy
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862694
    m_Localized: Może wyrzucę pana na zbity pysk i popatrzę, jak słońce usmaży panu oczy w oczodołach
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862695
    m_Localized: 'Tourist: Co pan…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862696
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862697
    m_Localized: 'Tourist: Zacny panie, wie pan co? Chyba sobie pójdę. Boję się pana.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862698
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862699
    m_Localized: 'Tourist: Chcę tylko zaznaczyć, że pan zadaje się akceptować, co nadchodzi, ale nie każdy tak ma.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862700
    m_Localized: 'Tourist: Ja przykładowo przejęty jestem tym, co będzie dalej. To dla mnie wyjątkowo trudne.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862701
    m_Localized: 'Tourist: Rozmyślam nad każdą zaprzepaszczoną okazją, bo obawiałem się chwytać dnia.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862702
    m_Localized: Proszę powspominać o czymś pozytywnym. Może wtedy będzie panu lżej
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862703
    m_Localized: Musi pan przestać pogrążać się w żalu
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862704
    m_Localized: 'Tourist: Może ma pan rację, gospodarzu…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862705
    m_Localized: 'Tourist: Z łatwością wpadam w błędne koło „co by było, gdyby”…'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862706
    m_Localized: 'Tourist: Ale, szanowny panie, ma pan rację. Nie ma sensu płakać nad rozlanym mlekiem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862707
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862708
    m_Localized: 'Tourist: Dziękuję, że mnie pan wysłuchał, gospodarzu.'
    m_Metadata:
      m_Items: []
  - m_Id: 76333311427862709
    m_Localized: 'Tourist: Nie wiem, czy to będzie panu potrzebne, ale oto {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602560
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602561
    m_Localized: 'Dude: Ziooom, przypomniałem obie, że została mi jeszcze jedna, specjalna maczuga.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602562
    m_Localized: 'Dude: Ooo, stary, bakanie będzie zajebiaszcze!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602563
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602564
    m_Localized: 'Dude: Wybacz, ziom…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602565
    m_Localized: 'Dude: Zapomniałem podać dalej…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602566
    m_Localized: 'Dude: Propsy, ziomuś… weź tego zwykłego papierosa…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602567
    m_Localized: 'Dude: Ja się tutaj tylko jakby na moment zrelaksuję… O taaak…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602568
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602569
    m_Localized: 'Wheelchair: Kurdę, muszę tylko się na chwilę wyciągnąć…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602570
    m_Localized: 'Wheelchair: Czekaj no.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602571
    m_Localized: 'Wheelchair: O, tak lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602572
    m_Localized: Co, u licha?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602573
    m_Localized: 'Wheelchair: Wyluzuj, stary. Noga mi zdrętwiała, co w tym dziwnego?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602574
    m_Localized: To na chuj ta cała szopka?!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602575
    m_Localized: Dlaczego, u diabła, jeździsz na wózku?!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602576
    m_Localized: 'Wheelchair: Nigdy nie twierdziłem, że coś udaję… W ten sposób cieplej mi w nogi.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602577
    m_Localized: 'Wheelchair: Ech… lubię po prostu się w nim kulać.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602578
    m_Localized: Dziwak z ciebie
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602579
    m_Localized: Wynoś się stąd. NATYCHMIAST
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602580
    m_Localized: 'Wheelchair: Znaczy się, no weź, można w nim całkiem nieźle driftować.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602581
    m_Localized: 'Wheelchair: Nie mów mi, że nigdy nie próbowałeś.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602582
    m_Localized: Dziwak z ciebie
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602583
    m_Localized: Wynoś się stąd. NATYCHMIAST
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602584
    m_Localized: 'Wheelchair: Nieważne.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602585
    m_Localized: 'Wheelchair: Przynajmniej ja mam niezłą frajdę!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602586
    m_Localized: 'Wheelchair: O ja pierdolę.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602587
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602588
    m_Localized: 'Wheelchair: Dobra, zjeżdżam stąd. Ale wózek biorę ze sobą.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602589
    m_Localized: '>>'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602590
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602591
    m_Localized: 'Esenin: Znalazłem u ciebie kilka tomików poezji.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602592
    m_Localized: 'Esenin: Czy mogę przeczytać na głos jeden z wierszy, druhu?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602593
    m_Localized: Pewnie
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602594
    m_Localized: Wolałbym nie
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602595
    m_Localized: 'Esenin: Proszę, koniec. Co o nim myślisz?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602596
    m_Localized: Był piękny
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602597
    m_Localized: To tylko słowa
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602598
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602599
    m_Localized: 'Esenin: Wiesz, czuję się teraz lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602600
    m_Localized: 'Esenin: Dzięki, że mnie wysłuchałeś, druhu.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602601
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602602
    m_Localized: 'Esenin: Dobra, jak tam chcesz.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602603
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602604
    m_Localized: 'FortuneTeller: Chyba wiem, co poradzić, by pomóc w przepchnięciu pana energii.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602605
    m_Localized: 'FortuneTeller: Musi pan…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602606
    m_Localized: 'FortuneTeller: PRZEPROWADZIĆ ZAWIROWANIA KOZIOROŻCA!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602607
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602608
    m_Localized: 'FortuneTeller: I jak? Zadziałało? Czy czuje już pan radość płynącą w czakrach?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602609
    m_Localized: A powinienem?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602610
    m_Localized: Co, u licha?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602611
    m_Localized: 'FortuneTeller: Nie podziałało?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602612
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602613
    m_Localized: 'FortuneTeller: A to ambaras. Powinno zadziałać…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602614
    m_Localized: 'FortuneTeller: Cóż, proszę się nie zniechęcać. Codzienne afirmacje panu pomogą.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602615
    m_Localized: 'FortuneTeller: A skoro o tym mowa… Poćwiczmy.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602616
    m_Localized: 'FortuneTeller: Proszę za mną powtarzać: jestem szczęśliwy!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602617
    m_Localized: Jestem szczęśliwy!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602618
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602619
    m_Localized: To jakieś farmazony
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602620
    m_Localized: 'FortuneTeller: Znakomicie! Proszę nie przestawać.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602621
    m_Localized: Jestem szczęśliwy!
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602622
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602623
    m_Localized: To jakieś farmazony
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602624
    m_Localized: 'FortuneTeller: Nawet pan nie próbuje!'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602625
    m_Localized: 'FortuneTeller: Chwileczkę… Jak mogłam tego nie zauważyć…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602626
    m_Localized: 'FortuneTeller: Widzę to w pana aurze… stroni pan od szczęścia. W panu jest sama pustka.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602627
    m_Localized: 'FortuneTeller: A bez chęci nie będzie rezultatów. Wszechświat do tego nie dopuści.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602628
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602629
    m_Localized: 'FortuneTeller: Obawiam się, że nie można panu pomóc. Przykro mi. Nawet afirmacje do pana nie dosięgły.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602630
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602631
    m_Localized: Co robisz?
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602632
    m_Localized: 'Intruder: Szukam twoich snów.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602633
    m_Localized: 'Intruder: Chcę odrobiny spokoju. Tylko go posmakować.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602634
    m_Localized: 'Intruder: Gdzie je ukrywasz? Powiedz mi.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602635
    m_Localized: Odsuń się, albo cię rozwalę
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602636
    m_Localized: Nie mam żadnych snów
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602637
    m_Localized: Jazda mi sprzed facjaty
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602638
    m_Localized: 'Intruder: Musisz zrozumieć. Potrzebuję snów.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602639
    m_Localized: 'Intruder: Ale widziałem już w twoich oczach, że żadnych nie masz.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602640
    m_Localized: 'Intruder: Możesz się już uspokoić.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602641
    m_Localized: 'Intruder: Ciekawe… Czy mam rację? Czy muszę tylko poczekać, aż opuścisz gardę?'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558321602642
    m_Localized: 'Intruder: Ale znalazłem jeden niepokojący koszmar…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796864
    m_Localized: 'Intruder: Pełzniesz korytarzem jako… paskudny ślimak.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796865
    m_Localized: 'Intruder: Nie masz pojęcia, przez czyje oczy patrzysz.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796866
    m_Localized: 'Intruder: Zdradzę tyle, że jest to spojrzenie pożądające ciał. Przyciągają je miejsca śmierci…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796867
    m_Localized: 'Intruder: Może kiedyś to ujrzysz…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796868
    m_Localized: 'Intruder: Ale znalazłem jeden nietypowy koszmar…'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796869
    m_Localized: 'Intruder: Pełzniesz przez tunel, w którym rosną grzyby.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796870
    m_Localized: 'Intruder: Jest ich zbyt wiele i rosną w zastraszającym tempie.'
    m_Metadata:
      m_Items: []
  - m_Id: 79733558325796871
    m_Localized: 'Intruder: Dziwne. Jak mogłeś doświadczyć takiej wizji…?'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821952
    m_Localized: 'Esenin: W ten wieczór, rozciągnięty bezwładnie na niebie'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821953
    m_Localized: 'Esenin: Jak pacjent pod eterem na stole;'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821954
    m_Localized: 'Esenin: Chodźmy przez te uliczki, na wpół wyludnione,'
    m_Metadata:
      m_Items: []
  - m_Id: 88413620717821955
    m_Localized: 'Esenin: Zapewniające mrukliwą osłonę'
    m_Metadata:
      m_Items: []
  - m_Id: 92376539113529344
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74175582101823488
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
      m_Items: []
  - m_Id: 74175582101823489
    m_Localized: Wręcz wezwanie od FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 74175582101823490
    m_Localized: Chcę ciebie sprawdzić
    m_Metadata:
