    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112392
    m_Localized: 'Alkonost: Das ist das Ende.'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112393
    m_Localized: Erschießen
