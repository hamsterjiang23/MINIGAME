%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_de
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 9ca4ee10b5b962b4993a5133922046c2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377490604032
    m_Localized: 'Firefighter: *hust* Nur zu. Ich habe nichts zu verbergen. Bei mir ist sowieso alles verbrannt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769856
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: Sehen Sie gut hin.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: 'Firefighter: *hust* Aber urteilen Sie nicht zu streng. Rauch ist nicht gerade förderlich für gesunde Zähne.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: Hier, sehen Sie ... *hust*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: 'Firefighter: Wie zwei verkohlte Baumstämme. Aber saubere Fingernägel. Schon komisch, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: Kein Problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: 'Firefighter: Sehen Sie? *hust* Rot wie glühende Kohlen. Das kommt vom Rauch.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: 'Firefighter: Sind Sie sicher? Das wird kein schöner Anblick.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: 'Firefighter: Alles ist verbrannt ... Meine Haut ist aufgeplatzt wie alte Baumrinde. Ich hebe meine Arme nur, wenn ich unbedingt muss.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: 'Firefighter: Wie Sie wollen. Aber Sie könnten genauso gut eine verkohlte Waldleiche fotografieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: Sind Sie zufrieden? *hust*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: 'Firefighter: Das wird einfach. Sie sind bis auf den Knorpel abgebrannt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: 'Firefighter: Bald kann ich nichts mehr hören. Wahrscheinlich ist es besser so.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: 'Firefighter: Na los, schießen Sie schon. Aber zielen Sie nicht auf die Zähne. Die sind sowieso schon hinüber.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: 'Firefighter: Ich habe vor nichts Angst. Erschießen Sie mich ruhig, wenn es Ihnen das Leben erleichtert.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: Vielleicht ist es so am einfachsten ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: 'Firefighter: Wissen Sie eigentlich, was diese Hände durchgemacht haben?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: 'Firefighter: Wenn dieses Foto mein Todesurteil ist, *hust* bringen wir es hinter uns. Mich hält hier nichts mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: 'Firefighter: Alles brennt ... Ich schätze, meine Zeit ist gekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: 'Firefighter: Ich konnte meine Kinder *hust* nie dazu bringen, täglich ihre Zähne zu putzen. Jetzt erinnert sie keiner mehr daran.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: 'Firefighter: Diese Hände *hust* haben Menschenleben gerettet. Jetzt können sie kaum noch eine Tasse halten.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: Dann soll es wohl so sein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: Meine Zeit ist gekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: 'Firefighter: *hust* Wenn der Wald brennt, kann man nur zusehen, wie er zu Asche wird. Und man weiß, dass man nichts tun kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: 'Firefighter: Manchmal wache ich nachts auf und denke, dass meine Haut aufreißt. Nichts hilft. Das Feuer hat mir alles genommen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: 'Firefighter: Nur die Erinnerung bleibt vom Feuer verschont. Der Körper ist vergänglich.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: 'Firefighter: Wenn um einen herum das Feuer wütet, weiß man die Stille zu schätzen. Die Ohren mögen intakt sein, aber die Seele?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: 'Wheelchair: Na gut, dann mal her mit ihren Tests. Ich werde sie alle bestehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964176
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964177
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964178
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964179
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: Hier, sehen Sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: Mein Mund ist eine wahre Goldgrube.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: 'Wheelchair: Nicht alle meine Zähne sind aus Gold, aber es werden immer mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: 'Wheelchair: Wenn Sie wüssten, wie einfach es ist, Bierdosen mit den Schneidezähnen zu öffnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: Das geht wie von selbst.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: 'Wheelchair: Ich bin ja dankbar, dass ich überhaupt noch Hände habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: 'Wheelchair: Ohne Hände könnte ich überhaupt keine Rennen mehr fahren.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: Moment mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: Meine Finger sind weg!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: 'Wheelchair: Gestern hat nur einer gefehlt. Wo ist der Rest?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: 'Wheelchair: Na ja, die wachsen wieder nach. Irgendwann.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: Mein Finger ist weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: 'Wheelchair: Nur eine Kleinigkeit, aber trotzdem unangenehm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: 'Wheelchair: ABER MEIN FINGERNAGEL IST NACHGEWACHSEN, SEHEN SIE?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: 'Wheelchair: Das heißt, meine Beine wachsen auch wieder nach. Irgendwann.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: 'Wheelchair: Wo soll ich hinsehen? Direkt in Ihre Richtung?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: 'Wheelchair: Haben Sie das Zucken bemerkt? Das ist ein Tick.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: 'Wheelchair: Seit damals, als ich noch aufs Gas treten konnte, nehme ich meine Umgebung kaum wahr.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: 'Wheelchair: Ich bin wohl noch nicht bereit, vom Gas zu gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: Ah.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: 'Wheelchair: Nur zu. HAHAHAHA.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: Das ist der Gipfel der Komik.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: 'Wheelchair: Sie wollen meine Achselhöhlen sehen und ich zeige sie Ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: 'Wheelchair: Draußen tobt das Höllenfeuer und das Universum will den ganzen Planeten ausradieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: Die Besucher wollen uns alle umbringen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: 'Wheelchair: Und Sie so: „Zeigen Sie mir Ihre Achselhöhlen!“'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: HAHAHAHA.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: Ein Foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: 'Wheelchair: Ich bin zwar nicht fotogen, aber was soll’s.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: Verdammt, ich hab geblinzelt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: 'Wheelchair: HAHAHAHA! Alles klar!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: Das war ein Witz, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: 'Wheelchair: Oder etwa nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: Moment mal, Sie haben das ernst gemeint?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: Das ist doch krank.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: 'Wheelchair: Hey, ich trinke Ihnen nie wieder Bier weg. Nehmen Sie’s nicht so persönlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: Wissen Sie, was wir mit nachtragenden Leuten machen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: Wir überrollen sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: 'Wheelchair: Wenn Sie schon wütend sind, will ich auch meinen Spaß haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: Warum?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: Das wird mir wohl kaum helfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: 'Wheelchair: Ihnen wahrscheinlich auch nicht. Also, wozu die Knarre?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: 'Wheelchair: Ich werde die Kugel wahrscheinlich nicht kommen sehen, aber ich kann versuchen, ihr auszuweichen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: 'Wheelchair: Es war mir schon immer schleierhaft, warum Leute sich rasieren. Haare sind die natürliche Verteidigung des Körpers.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: 'Wheelchair: Sehen Sie diesen Stumpf? Dort züchte ich Finger heran. Ersatzfinger.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: 'Wheelchair: Ah, der eigentliche Spaß hat noch gar nicht angefangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: 'Wheelchair: Wo sind wir im Leben falsch abgebogen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: 'Wheelchair: Warum das Foto? Kennen Sie das Sprichwort „Ein tiefer Atemzug kann den Tod nicht hinauszögern“?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: 'Wheelchair: Irgendwas wollte ich gerade noch sagen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: Kann ich einfach gehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: 'Wheelchair: Wahrscheinlich haben wir es nicht besser verdient.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: 'Wheelchair: Früher oder später wird Gott über Sie richten.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: Ich werde nicht einfach sang- und klanglos verschwinden.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: 'Wheelchair: Letztlich sind wir doch nur alberne Fleischsäcke, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: 'Wheelchair: Erst lachen wir zusammen und dann pusten wir uns gegenseitig den Schädel weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: Ich muss mich aufs Sterben vorbereiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: Meine Hände sind jetzt mein einziger Motor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: Und ich habe keine Kupplung.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: 'Wheelchair: Ehrlich gesagt habe ich Angst davor, dass ich sie irgendwann auch verliere. Was dann?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: 'Wheelchair: Wie furchtbar, sich überhaupt nicht mehr bewegen zu können.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: Nicht mal der Tod macht mir solche Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: 'Wheelchair: Wie man es dreht und wendet, die Zeit kann man nicht einholen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: 'Wheelchair: Ist Ihnen aufgefallen, dass die Zeit mit zunehmendem Alter schneller vergeht?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: 'Wheelchair: Als Kind hatten wir alle Zeit der Welt. Alles war so einfach. Keine Verpflichtungen oder schwierigen Entscheidungen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: 'Wheelchair: Aber jetzt können wir uns abhetzen und haben trotzdem zu wenig Zeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: 'Wheelchair: Irgendwie ist mir nicht mehr zum Lachen zumute.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: Ihre albernen Tests und Vorsichtsmaßnahmen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: 'Wheelchair: Alle wollen die Welt retten, aber jeder auf seine eigene Weise.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: 'Wheelchair: Und was haben wir davon? Vielleicht sollten wir das Ganze einfach viel entspannter sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: Hören Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: Finden Sie nicht, dass unsere Fahrt zu Ende ist?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: 'Wheelchair: Wir sind kurz vor der Ziellinie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: Der letzte Halt ist durchs Fenster zu sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: Sind Sie bereit?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: 'Wheelchair: Das dachte ich mir. Ärgern Sie sich nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: 'Wheelchair: Wenn Sie sich nicht auf die Anzeichen verlassen können, wie soll ich mich dann darauf verlassen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: 'Wheelchair: Vielleicht weisen sie alle mit derselben Zuverlässigkeit auf Besucher hin.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: 'Wheelchair: Menschen machen Fehler.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: 'Wheelchair: Aber diese Fehler können schlimme Folgen haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: 'Wheelchair: Wenn Sie sich auf dieses Anzeichen verlassen, wie soll ich mich dann auf die vorherigen verlassen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: 'Wheelchair: Vielleicht taugen die anderen auch nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: 'Wheelchair: Wir sind Menschen, und Menschen machen nun mal Fehler.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: 'Wheelchair: Aber diese Fehler können schlimme Folgen haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: 'Wheelchair: Sie ... Mit einer einzigen Bewegung könnten Sie ein Leben beenden.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: 'Wheelchair: Wenn Sie sich Ihrer Entscheidung sicher sind, dann ... beneide ich Sie darum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: 'Mother: Na los, teste mich. Ich habe nichts zu verbergen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: Bitte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: 'Mother: Ich habe mich nie besonders um sie gekümmert. Ich hatte einfach nicht die Zeit. Aber inzwischen ... bereue ich es.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964303
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964304
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: Sieh sie dir an.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: 'Mother: Das sind Schaufeln, keine Hände. Alles für die Kinder.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964307
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964308
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: Nur zu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: 'Mother: Siehst du die Augenringe? Die kommen vom Schlafmangel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964311
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964312
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: Nur zu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964314
    m_Localized: 'Mother: Mir ist schon lange das Deo ausgegangen. Nimm es mir nicht übel.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964315
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964316
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: 'Mother: Kann ich sitzen? Nein?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964318
    m_Localized: 'Mother: Zerzaust wie immer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964319
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964320
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: 'Mother: Ich habe sie lange nicht mehr geputzt. Wahrscheinlich sind sie verstopft.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: 'Mother: Ich bin sowieso schon halb taub vom ganzen Kindergeschrei.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964323
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964324
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: 'Mother: Seit einer Woche habe ich Zahnfleischbluten, wenn ich mir die Zähne putze.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: 'Mother: Und meine Zähne sind ganz gelb. Aber wie soll ich bei solchen Kindern aufhören zu rauchen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964327
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964328
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: 'Mother: Ich habe irgendeinen Ausschlag von Pflegeprodukten. Ich hatte nie Zeit, zum Arzt zu gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: 'Mother: Diese Hände könnten dir Suppe machen, wenn du lange genug lebst! Und du holst deine Waffe raus ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964331
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964332
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: 'Mother: Selbst wenn du eine Granate auspackst, kann ich dadurch nicht besser schlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964334
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964335
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: 'Mother: Willst du mich wegen dem Geruch erschießen? Du bist ja verrückt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964337
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964338
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: 'Mother: Du verurteilst mich wegen einem Foto? Du bist ja verrückt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964340
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964341
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: 'Mother: Du bist ja krank, wenn du mich wegen meinen Ohren erschießen willst. Was stört dich daran? Ich wickle einen Schal drum!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964343
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964344
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: Endlich geht mir keiner mehr auf die Nerven ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: Wie furchtbar ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: 'Mother: Eines meiner Kinder hat perfekte Zähne, aber es hat noch nie gelächelt. Vielleicht geht es gar nicht um die Zähne?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: 'Mother: Hände ... Damit habe ich Kinder umarmt, Hausarbeit erledigt und meinen Mann gestreichelt. Und niemand hat mir gedankt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964349
    m_Localized: 'Mother: Wenn das eigene Kind krank ist, schläft man tagelang nicht. Dann gewöhnt man sich dran und akzeptiert den Albtraum.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964350
    m_Localized: 'Mother: Einmal war ich so müde, dass ich eine Woche lang nicht geduscht habe. Den Kindern ist es gar nicht aufgefallen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964351
    m_Localized: 'Mother: Ich habe mal ein Foto gefunden, auf dem alle Kinder lächeln. Ich habe es mir angesehen, bis ich eingeschlafen bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964352
    m_Localized: 'Mother: Manchmal wäre ich lieber taub. Aber wenn die Kinder schlafen, herrscht endlich Stille ... Dafür lohnt es sich zu leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: 'Anger: Ernsthaft? Scheiße ... Na gut, aber beeilen Sie sich!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: 'Anger: Von mir aus. Hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: 'Anger: Gelb? Scheiß drauf.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: 'Anger: Weiß? Wie kann das sein, wenn ich nur an mich selbst denke?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: 'Anger: Ich dachte immer, wenn meine Zähne so werden, sollte ich mir wenigstens einen Goldzahn gönnen. Wie die Filmbösewichte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: Wie Sie meinen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: 'Anger: Mann, sind die groß.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: 'Anger: Ha. Meine Oma hat immer gesagt, dass ich mit solchen Händen Holz hacken sollte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: 'Anger: Aber hier gibt es kein Holz zum Hacken, also brauche ich irgendein anderes Ventil für meine Wut.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: 'Anger: Tun Sie, was Sie nicht lassen können.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: 'Anger: Gefällt Ihnen die Farbe? Blaue Augen. Das hat schon immer gereicht, um das Interesse der Damen zu wecken.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: Tun Sie sich keinen Zwang an.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: Ja, ich bin rasiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: 'Anger: Ich will keinen Busch unter den Achseln haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: Nur zu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: 'Anger: Was? Warum starren Sie mich so an?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: Scheiße ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: 'Anger: Was starren Sie denn so? Passt Ihnen irgendwas nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: 'Anger: Drehen Sie jetzt völlig durch? Ich habe Ihnen gerade meine Zähne gezeigt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: 'Anger: Glauben Sie, ich könnte Ihnen nicht den Hals umdrehen, bevor Sie abdrücken?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: 'Anger: Was zur Hölle wollen Sie? Sind Sie neidisch oder was?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: 'Anger: Es juckt wie verrückt, das treibt mich noch in den Wahnsinn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: 'Anger: Wenn ich so lange kratze, bis es blutet, wird es erträglich.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: 'Anger: Ich traue Ihnen nicht. Sie sind vollkommen irre!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: 'Anger: Sie wollten mich wegen einem albernen Foto erschießen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: 'Anger: Wedeln Sie nicht so mit der Knarre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: 'Anger: Am Ende erschießen Sie mich noch aus Versehen wegen meinen Ohren.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: 'Anger: Sie sind ja völlig durchgeknallt. Na los, machen Sie schon!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: 'Anger: Sie herzloses Arschloch.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: Fahren Sie zur Hölle.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: 'Anger: Meine Oma hatte einen Goldzahn. Ich wusste schon früh, dass ich irgendwann auch einen will.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: 'Anger: Er hat geglänzt, als würde ihr die Sonne aus dem Mund scheinen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: 'Anger: Meine Oma hat gesagt, sie hat ihn bekommen, als der alte Zahn verfault war.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: 'Anger: Das hat mich glücklich gemacht. Ich dachte: „Wie praktisch! Wenn es bei mir so weit ist, geben sie mir auch einen.“'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: 'Anger: Und dann ... Dann war es wirklich so weit. Aber niemand hat mir irgendwas gegeben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: 'Anger: Mir scheint keine Sonne aus dem Mund. Nur pissgelbe Zähne.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: 'Anger: Sehen Sie diese Hände? Dreck, Blut, was Sie wollen. Aber nur mein eigenes Blut.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: 'Anger: Manchmal jucken meine Hände so sehr, dass ich mir die Haut abreißen will. Oder die Wand einschlagen. Oder beides.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: 'Anger: Ich kann mich nicht beherrschen. Aber ich will niemandem wehtun.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: 'Anger: Sehen Sie diese Fingernägel? Dreck, Blut, was Sie wollen. Aber nur mein eigenes Blut.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: 'Anger: Manchmal jucken meine Hände so sehr, dass ich mir die Haut abreißen will. Oder die Wand einschlagen. Oder beides.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: 'Anger: Wenn ich anders gestrickt wäre, hätte ich Angst, mir selbst was anzutun. Aber mir ist alles scheißegal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: 'Anger: Meine Oma hat mich wegen meiner Augenfarbe immer einen „kleinen Engel“ genannt. „Engel“, dass ich nicht lache.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: 'Anger: Jetzt stehe ich hier, blicke in die Fenster zur Seele und denke mir: „Wo bin ich ein gottverdammter Engel?“'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: 'Anger: Ich weiß, wie sie über mich gedacht hat. Sie war enttäuscht.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: 'Anger: Rasierklingen sind scharf genug für ... gewisse Dinge. Wenn es nur so einfach wäre ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: 'Anger: Mein Arm ist schon ganz wund. Jetzt ist es so, als würde die Klinge nicht meine Haare, sondern mich selbst schneiden.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: 'Anger: Aber ich rasiere mich trotzdem. Ich hasse diesen Busch einfach zu sehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: 'Anger: Ich habe nicht mal ein Foto von meiner Oma. Sie hat Fotos gehasst.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: 'Anger: Sie hat gesagt, dass einem beim Fotografieren die Seele geraubt und auf das Foto gebannt wird.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: 'Anger: Ich habe getobt und ihr gesagt, dass das totaler Blödsinn ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: 'Anger: Und sie hat gesagt: „Wenn ich sterbe, siehst du dir ein Foto von mir an und fragst dich, ob ich im Himmel bin.“'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: 'Anger: Scheiß drauf. Jetzt habe ich keine Fotos und keine Oma.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: 'Anger: Manchmal ertappe ich mich dabei, wie ich an meinem Ohrläppchen zupfe, aber nur, wenn es brennt wie die Hölle.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: 'Anger: Früher dachte ich, das wäre aus Nervosität.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: 'Anger: Irgendwann wurde mir klar, dass ich einen Teil von mir abreißen wollte, als ob er mir im Weg wäre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: 'Anger: Aber ich bin doch nicht verrückt genug, um mich selbst zu verstümmeln, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: Oder??'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: 'FortuneTeller: Oh, ich wusste, dass deine Energie Widerstand leisten würde. Aber mach ruhig deine Tests. Ich durchschaue dich sowieso.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: Na gut, sieh sie dir an.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: 'FortuneTeller: Die Augen spiegeln den inneren Kosmos wider, nicht die Zähne. Willst du dein Schicksal darin lesen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: 'FortuneTeller: Die Augen spiegeln den inneren Kosmos wider, nicht die Zähne. Was erhoffst du dir davon?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: Nur zu, sieh sie dir an.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: 'FortuneTeller: Aber sei vorsichtig – ich habe die Splitter noch nicht rausgezogen, die ich mir bei einem Traumfänger geholt habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: 'FortuneTeller: Oh, meine Augen? Die sind natürlich braun.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: 'FortuneTeller: Zumindest, wenn man die roten Punkte vernachlässigt. Daran ist der Mond schuld.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: 'FortuneTeller: Oh ... Das Universum meint es nicht gut mit mir ... Na gut, sieh ruhig nach.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: 'FortuneTeller: Unter diesen Umständen ist Körperpflege nicht gerade einfach, wenn du verstehst ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: 'FortuneTeller: Sei vorsichtig. Meine Aura könnte dich blenden!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: 'FortuneTeller: Na? Was meinst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: 'FortuneTeller: Sieh sie dir ruhig an, aber sei vorsichtig. Sie hören alles – sogar deine Gedanken.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: 'FortuneTeller: Na? Hast du deine Antworten gefunden?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: 'FortuneTeller: Du willst mich wegen meiner Zähne erschießen? Ich kann doch auch nichts dafür, wenn Mars sauer auf Venus ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: 'FortuneTeller: Ernsthaft? Du erschießt mich, weil ich Splitter in den Händen habe? So ist das eben, wenn man mit Traumfängern arbeitet.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: 'FortuneTeller: Bist du wahnsinnig?! Siehst du denn nicht, dass der Mond dir einen Streich spielt? Er ist schwer zu durchschauen!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: 'FortuneTeller: Bist du wahnsinnig?! Siehst du denn nicht, dass der Mond dir einen Streich spielt?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: 'FortuneTeller: Das ist keine Astrologie, sondern Barbarei! Wenn du die Waffe weglegst, verrate ich dir noch mehr meiner Geheimnisse!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: 'FortuneTeller: Hey! Es ist nicht meine Schuld, dass du noch nicht bereit dafür warst, mein Lieber!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: 'FortuneTeller: Kannst du das Ding weglegen? Was lässt sich an Ohren schon ablesen? Man braucht sie, um weisen Worten zu lauschen!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: 'FortuneTeller: Wenn du mich tötest, erwartet dich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: Ewiger Durchfall!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: 'FortuneTeller: Einmal kam ein Mann mit perfekten Zähnen zu mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: 'FortuneTeller: Ich sagte ihm: „Nach außen hin ist alles gut, aber deine Seele ist verdorben!“ Was glaubst du wohl, was wichtiger ist?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: 'FortuneTeller: Einmal musste ich nach einem Ritual die ganze Nacht Splitter zupfen. Jeder einzelne war eine Lektion des Universums.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: 'FortuneTeller: Die Augen sind Tore zu einer anderen Welt. Ein Mann mit leuchtenden Augen sagte mir, es sei Liebe, aber es war der Mars.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: 'FortuneTeller: Einmal lebte ich drei Wochen in Askese und dachte nur über meine Träume nach.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: 'FortuneTeller: Gedanken sind Materie, die bei der Erfüllung meiner Wünsche hilft. Ich muss nur den richtigen Wunsch hegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: Meine jetzige Situation ist wahrscheinlich mit damals vergleichbar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: 'FortuneTeller: Einmal wurde ich fotografiert und dachte: „Das ist ein Zeichen der Sterne!“ Dann merkte ich, dass es nur der Blitz war.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: 'FortuneTeller: Einmal glaubte ich zu hören, dass das Universum zu mir sprechen wollte. Aber vielleicht war es etwas viel Mächtigeres.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: 'FortuneTeller: Einmal glaubte ich zu hören, dass das Universum zu mir sprechen wollte. Es war nur ein Luftzug, aber er gefiel mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158522
    m_Localized: 'Fanatic: Was wollen Sie testen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158523
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158524
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158525
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158526
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158527
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158528
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158529
    m_Localized: 'Fanatic: Ich soll Ihnen meine Zähne zeigen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158530
    m_Localized: 'Fanatic: MEINE ZÄHNE SIND FÜR DIE WAHRHEIT EINGESTANDEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158531
    m_Localized: 'Fanatic: Und sind daran zugrunde gegangen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158532
    m_Localized: 'Fanatic: Überzeugen Sie sich selbst.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158533
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158534
    m_Localized: 'Fanatic: Ich pflege meine Zähne mit einer Bierlösung. Das ist gut für den Zahnschmelz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158535
    m_Localized: 'Fanatic: Ansonsten hätte ich schon lange keine Zähne mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158536
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158537
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158538
    m_Localized: 'Fanatic: Ich kann Sie verstehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158539
    m_Localized: 'Fanatic: Im Moment herrscht so viel Chaos, aber wir leben noch.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158540
    m_Localized: 'Fanatic: Wir leben weiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158541
    m_Localized: 'Fanatic: Haben Sie zu lange im Schatten gesessen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158542
    m_Localized: 'Fanatic: Ruhen Sie sich aus, mein Freund.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158543
    m_Localized: 'Fanatic: Tun Sie sich keinen Zwang an, mein Freund!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158544
    m_Localized: 'Fanatic: Sehen Sie sich nach Herzenslust meine Fingernägel an.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158545
    m_Localized: 'Fanatic: Ich habe sie darauf trainiert, das Sonnenlicht zu absorbieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158546
    m_Localized: 'Fanatic: Und Bierdosen zu öffnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158547
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158548
    m_Localized: 'Fanatic: Wollten Sie sich selbst überzeugen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158549
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158550
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158551
    m_Localized: 'Fanatic: SEHEN SIE MIR IN DIE AUGEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158552
    m_Localized: 'Fanatic: Sie sind voller Wut und Hass.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158553
    m_Localized: 'Fanatic: SEHEN SIE IN MEINE DUNKLEN AUGEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158554
    m_Localized: 'Fanatic: Sie absorbieren das Licht und wandeln es in Energie um.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158555
    m_Localized: 'Fanatic: Ich bekomme meine ganze Energie durch meine AUGEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158556
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158557
    m_Localized: 'Fanatic: HABEN SIE DIE GERECHTE MACHT DER SONNE IN MEINEN AUGEN GESEHEN?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158558
    m_Localized: 'Fanatic: Wenn nicht, sind Sie wohl blind. Sie sollten länger in die Sonne schauen, SO WIE ICH.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158559
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158560
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158561
    m_Localized: 'Fanatic: Ein Foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158562
    m_Localized: 'Fanatic: Hm ... Hm-hm-hm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158563
    m_Localized: 'Fanatic: Haben Sie schon gehört, dass ich den SONNENFÜHRER persönlich begrüßt habe?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158564
    m_Localized: 'Fanatic: Ja, ich habe ihm beigebracht, in die Sonne zu schauen, aber das erzähle ich Ihnen später.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158565
    m_Localized: 'Fanatic: Na los. FOTOGRAFIEREN SIE MICH!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158566
    m_Localized: 'Fanatic: (Du fotografierst den ungepflegten Mann.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158567
    m_Localized: 'Fanatic: (Das Foto zeigt ihn ungekämmt und schmutzig wie im echten Leben.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158568
    m_Localized: 'Fanatic: (Es sind keinerlei Verzerrungen zu sehen.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158569
    m_Localized: 'Fanatic: WIE WUNDERBAR!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158570
    m_Localized: 'Fanatic: Kommen Sie zu mir, dann erzähle ich Ihnen alles über mein Leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158571
    m_Localized: 'Fanatic: Und dann geben Sie mir ein bisschen Geld dafür.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158572
    m_Localized: 'Fanatic: ICH VERWENDE ES FÜR DIE RETTUNG DER SONNENENERGIE!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158573
    m_Localized: 'Fanatic: Schießen Sie ruhig! Die Wahrheit wird mich beschützen!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158574
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158575
    m_Localized: 'Fanatic: Wollen Sie die Waffe nicht weglegen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158576
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158577
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158578
    m_Localized: 'Fanatic: Es ist ziiiiiemlich schwer für mich ohne Bier in der Hand.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158579
    m_Localized: 'Fanatic: Ziiiiiemlich schwer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158580
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158581
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158582
    m_Localized: 'Fanatic: Mensch, warum tun Sie das?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158583
    m_Localized: 'Fanatic: DIESE UNGLÄUBIGEN SIND ALLE VERRÜCKT GEWORDEN!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158584
    m_Localized: 'Fanatic: Sie reden nicht nur hinter meinem Rücken, jetzt wollen sie mich auch noch erschießen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158585
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158586
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158587
    m_Localized: 'Fanatic: Das ist zu viel!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158588
    m_Localized: 'Fanatic: Das wird uns nicht helfen zu überleben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158589
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158590
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158591
    m_Localized: 'Fanatic: Moment mal, meine Hände gefallen Ihnen nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158592
    m_Localized: 'Fanatic: WARUM NICHT?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158593
    m_Localized: 'Fanatic: Sie sind ein Geizkragen und ein Ignorant. Und ich will Bier.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158594
    m_Localized: 'Fanatic: Wie heißt es so schön: „Stehen und Schauen, beides hat seine Zeit.“'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158595
    m_Localized: 'Fanatic: Also kann ich nicht beides gleichzeitig machen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158596
    m_Localized: 'Fanatic: Moment, warten Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158597
    m_Localized: 'Fanatic: Oder war es „Stehen und Sitzen“ ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158598
    m_Localized: 'Fanatic: Einen Augenblick ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158599
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158600
    m_Localized: 'Fanatic: Mir ist das alles egal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158601
    m_Localized: 'Fanatic: So ist es richtig.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158602
    m_Localized: 'Fanatic: Warum sollten Sie auch die Sonne erschießen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158603
    m_Localized: 'Fanatic: Keine Sorge, ich nehme es Ihnen nicht übel.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158604
    m_Localized: 'Fanatic: Sie haben einen großen Vorrat an kalter, lebensspendender Flüssigkeit!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158605
    m_Localized: 'Fanatic: Ah, Sie treiben gerne Scherze, was?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158606
    m_Localized: 'Fanatic: Schnüffeln Sie ruhig mal, wenn Sie wollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158607
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158608
    m_Localized: 'Fanatic: Das ist das Ergebnis von Körperpflege.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158609
    m_Localized: 'Fanatic: Ah, Sie treiben gerne Scherze, was?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158610
    m_Localized: 'Fanatic: Schnüffeln Sie ruhig mal, wenn Sie wollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158611
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158612
    m_Localized: 'Fanatic: Das ist das Werk der Sonne.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158613
    m_Localized: 'Fanatic: Wir dünsten erquickende Feuchtigkeit aus, um am Leben zu bleiben!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158614
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158615
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: Was willst du testen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: 'Anxiety: Was, du willst eine Entscheidung aufgrund meiner Zähne treffen? Puuh.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: Ich habe mir die Zähne vor Kurzem richten lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: Wobei, wenn ich ehrlich bin ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: 'Anxiety: Ich kann mich gar nicht erinnern, beim Zahnarzt gewesen zu sein. War ich überhaupt dort?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: 'Anxiety: Gott, ich weiß vor lauter Angst nicht mal mehr, ob ich gestern was gegessen habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158629
    m_Localized: 'Anxiety: Also ... Passt die Beschreibung auf mich?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158632
    m_Localized: 'Anxiety: Ich bin eine Besucherin? Was? WAS? Das kann nicht sein!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158633
    m_Localized: 'Anxiety: Oh mein Gott, erst verliere ich mein Haus und meinen Job, und jetzt werde ich aus meinem eigenen Kopf vertrieben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: 'Anxiety: Du willst meine Fingernägel sehen? Was für ein komisches Kriterium ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: 'Anxiety: Aber gut, sieh sie dir an.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: 'Anxiety: Was ist das an meinen Fingernägeln? Dreck kann es nicht sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: 'Anxiety: Ich ... Ich erinnere mich nicht, in der Erde gegraben zu haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: Wo kommt dieser Dreck her?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158644
    m_Localized: 'Anxiety: Ich kann doch nicht tagelang mit dreckigen Fingernägeln rumgelaufen sein?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158645
    m_Localized: 'Anxiety: Wie ... merkwürdig.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158648
    m_Localized: 'Anxiety: Stell dir vor! Ich kann mich nicht erinnern, woher der Dreck kommt. Ich war die ganze Zeit hier in deinem Haus.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158649
    m_Localized: 'Anxiety: Hat mir jemand ... absichtlich Dreck unter die Fingernägel getan? Wer sollte so was tun?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: Willst du meine Augen überprüfen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158651
    m_Localized: 'Anxiety: Ich kann mir schon vorstellen, was dabei rauskommt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158652
    m_Localized: 'Anxiety: Was passiert, wenn ich auf die Beschreibung passe?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158654
    m_Localized: 'Anxiety: Das musste ja so kommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158657
    m_Localized: 'Anxiety: Bin ich wirklich eine Besucherin? Was meinst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158658
    m_Localized: 'Anxiety: Warum weiß ich dann nichts davon? Vielleicht geht es allen so, die zu Besuchern werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158659
    m_Localized: 'Anxiety: Vielleicht reicht es schon, wenn man denkt, dass man irgendwie anders ist und nicht in die Gesellschaft passt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: Ich habe Angst vor dem Sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158663
    m_Localized: 'Anxiety: Warte, kann ich einen Verband haben?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158664
    m_Localized: 'Anxiety: Oder wenigstens noch ein bisschen stehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158665
    m_Localized: 'Anxiety: Wenn ich wirklich eine Besucherin bin, fange ich dann irgendwann an, Menschen umzubringen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158666
    m_Localized: 'Anxiety: Werde ich gefährlich? Oder war ich schon immer gefährlich?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158667
    m_Localized: 'Anxiety: Vielleicht habe ich schon Menschen umgebracht?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: (Du fotografierst sie.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158669
    m_Localized: 'Anxiety: (Auf dem entwickelten Foto siehst du einen verschwommenen Körper vor einem scharfen Hintergrund.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158670
    m_Localized: 'Anxiety: (Es sieht aus, als hätte die Person gezuckt, als das Foto gemacht wurde.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158671
    m_Localized: 'Anxiety: Hahaha, kannst du dir das vorstellen? Ich bin gerade zusammengezuckt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158672
    m_Localized: 'Anxiety: Was passiert jetzt?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158673
    m_Localized: 'Anxiety: Kannst du mich am Leben lassen? Oder wäre es besser, mich zu töten? Was hast du vor?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: Warum?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: Wäre es nicht einfacher, mich zu erschießen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158678
    m_Localized: 'Anxiety: Ich will hier weg, aber ich habe zu viel Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158679
    m_Localized: 'Anxiety: Vielleicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158680
    m_Localized: 'Anxiety: Ich weiß nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158681
    m_Localized: 'Anxiety: Wenn du mich erschießt, verwandle ich mich dann in etwas noch Schlimmeres?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158682
    m_Localized: 'Anxiety: Vielleicht sollte ich weglaufen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158683
    m_Localized: 'Anxiety: Aber ich weiß nicht mal mehr, ob ich überhaupt ein Mensch bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158684
    m_Localized: 'Anxiety: Was soll ich nur machen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158685
    m_Localized: 'Anxiety: Genau wie diese Besucher zu Hause ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158686
    m_Localized: 'Anxiety: Tut mir leid, das war furchtbar ... Ich zeig’s dir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158687
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: 'Anxiety: Bin ich ein Mensch? Ja? Sag mir, dass ich ein Mensch bin, bitte!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: 'Anxiety: Warum wolltest du mich testen, wenn du sowieso eine Waffe ziehst?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: Macht es dir Spaß, andere zu erniedrigen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158695
    m_Localized: 'Anxiety: Was für ein Albtraum. Nirgends kann man sich sicher fühlen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158696
    m_Localized: 'Anxiety: Entweder kommen Besucher ins Haus oder irgendein Irrer will einen erschießen, weil er misstrauisch ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158697
    m_Localized: 'Anxiety: Das macht mir Angst! WENN WENIGSTENS JEMAND SAGEN WÜRDE, DASS ALLES WIEDER GUT WIRD!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158698
    m_Localized: 'Anxiety: Warum macht mich dieses eine Merkmal zu einer Besucherin?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158699
    m_Localized: 'Anxiety: Womit habe ich so einen Körper verdient ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158700
    m_Localized: 'Anxiety: Alles ist schief und krumm. Kein Wunder, dass sie auf der Arbeit Angst vor mir hatten.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158701
    m_Localized: 'Anxiety: Letzte Woche war ich wegen meinem Rücken im Krankenhaus ... glaube ich zumindest.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158702
    m_Localized: 'Anxiety: War ... War ich dann auch beim Zahnarzt?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158703
    m_Localized: 'Anxiety: Wie viel habe ich ausgegeben ...?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: Was wollen Sie testen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: Ich soll Ihnen meine Zähne zeigen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: 'Esenin: Dann werfen Sie einen Blick drauf. Der Geruch von Traurigkeit und Rauch haftet noch daran.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: Ziemlich gelb, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: Schieben Sie sich Ihre Tests sonst wohin.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: Ich bin kein Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: Wo kommen die überhaupt her?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: 'Esenin: Dreckige Fingernägel sind ein sicheres Zeichen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: Sie können sich doch einfach die Hände waschen!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: 'Esenin: Nach Ihrer Logik wäre jeder Gärtner automatisch ein Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: Was für ein Blödsinn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: Sehen Sie sich meine Nägel an.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: 'Esenin: Und? Bin ich ein Besucher?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: Ich glaube nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: Es wird jeden Tag lächerlicher.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: 'Esenin: Was, wenn ich nicht geschlafen habe? Oder wenn ich geweint habe?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: 'Esenin: Ich verstehe das alles nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: 'Esenin: Und was wollen Sie tun, wenn ein Anzeichen verdächtig ist? Oder mehrere?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: 'Esenin: Heute Nacht werde ich zum Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: 'Esenin: Ich bringe mich zum Weinen, indem ich mich an friedliche Zeiten erinnere.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: 'Esenin: Diese ganzen Tests auf irgendwelche Anzeichen, Typen in gelben Anzügen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: Das ist doch alles ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: Das ist doch alles verkorkst.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: 'Esenin: Haben Sie auch das Gefühl, dass alles vor die Hunde geht?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: 'Esenin: Angeblich ist alles unter Kontrolle, aber um uns herum herrscht das reinste Chaos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: Machen Sie doch Ihr verdammtes Foto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: (Du fotografierst ihn.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: 'Esenin: (Er sitzt ruhig da, nicht vollständig im Bild, aber dir fällt nichts Ungewöhnliches auf.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: 'Esenin: Ich habe Angst davor, was als Nächstes passiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: 'Esenin: Ernsthaft? Sind Sie völlig verblödet?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: Hat die FEMA Ihnen das Gehirn vernebelt?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: 'Esenin: Oder sind Sie besoffen? Ich dachte, das harte Zeug wäre schon aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: 'Esenin: Aber wie Sie wollen, ich zeig’s Ihnen!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: Haben Sie jetzt, was Sie wollten?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: Haben Sie sich sattgeschnüffelt?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: 'Esenin: Ich bin ja dankbar, dass Sie nicht meinen Arsch sehen wollen!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: Beeilen Sie sich bitte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158751
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158752
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158753
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158754
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158755
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352768
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: Was?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: 'Widow: Äh ... Na gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: Fertig?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: Können Sie mich jetzt in Ruhe lassen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352774
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352775
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: 'Widow: Hände ... Warten Sie kurz.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: 'Widow: Meine Hände sind müde. Sie haben denjenigen getragen, den sie nicht retten wollten.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: 'Widow: Können Sie aufhören, mich diesen ganzen Quatsch zu fragen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: 'Widow: Wenn Sie mich unbedingt erschießen wollen, dann tun Sie’s einfach.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: Ich habe keine Kraft mehr ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352782
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352783
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: 'Widow: Wonach suchen Sie? Rötungen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: Nur zu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: 'Widow: Wenn ich irgendeine Gefühlsregung zeige, macht mich das zu einer Besucherin?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352788
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352789
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: Können wir jetzt offen reden?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352791
    m_Localized: 'Widow: Man kann nicht glücklich sein, man kann nicht weinen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352792
    m_Localized: 'Widow: Man kann nicht immer reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352793
    m_Localized: 'Widow: Was bleibt einem übrig? Man kann nur rumsitzen und das Gesicht in die Hände legen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352794
    m_Localized: 'Widow: Geht es wirklich so einfach zu Ende?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352795
    m_Localized: 'Widow: Kein Leiden mehr?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352796
    m_Localized: 'Widow: Aber ich konnte dich nicht retten, mein ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352797
    m_Localized: 'Widow: Finden Sie das nicht beschämend?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352798
    m_Localized: 'Widow: Erst hilft niemand, meinen Mann zu retten, und jetzt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352799
    m_Localized: 'Widow: JETZT WOLLEN SIE SEINEM TOD EIN DENKMAL SETZEN?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352801
    m_Localized: 'Widow: Mir fehlen die Worte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352802
    m_Localized: 'Widow: Tun Sie, was Sie wollen, und lassen Sie mich in Ruhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352803
    m_Localized: 'Widow: (Du fotografierst sie.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352804
    m_Localized: 'Widow: (Dir fällt nichts Ungewöhnliches auf.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352805
    m_Localized: 'Widow: (Der tote Mann ist auch im Bild zu sehen, was dich zum Nachdenken über das Leben zwingt.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352806
    m_Localized: 'Widow: Gehen Sie einfach.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352807
    m_Localized: 'Widow: Er mochte meine Zähne.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352808
    m_Localized: 'Widow: Aber ich wollte eine Zahnspange.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352809
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352810
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: Sie wollen mich erschießen? Klar, warum auch nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352812
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352813
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: 'Widow: Kann man in dieser neuen Welt überhaupt noch weinen? Lachen kann man jedenfalls nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352815
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352816
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: Sind Sie verrückt?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: 'Widow: Sagen Sie, SIND SIE VERRÜCKT?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: 'Widow: Wenn diese Teufel Ihnen sagen würden, dass Sie auf einer Bratpfanne tanzen sollen, würden Sie das auch sofort tun?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: 'Widow: Sie ... Zur Hölle ... Mir fehlen die Worte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: 'Widow: Na? Holen Sie doch Ihre Waffe raus.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352823
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352824
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: Verdammt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: 'Widow: Drücken Sie ruhig ab. Die FEMA hat mir meine Seele genommen. Sie können meinem Körper den Rest geben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352827
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352828
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352829
    m_Localized: 'Widow: Ich mache mir keine Gedanken mehr über Zahnspangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352830
    m_Localized: 'Widow: Bis Sie meine Zähne sehen wollten, hatte ich völlig vergessen, dass es so was gibt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352832
    m_Localized: 'Widow: Oh, Mann ... Ich bin so erschöpft.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352833
    m_Localized: 'Widow: Ich lasse es an allen anderen aus, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352834
    m_Localized: 'Widow: Niemand ist schuld daran. Außer diesen Mistkerlen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352835
    m_Localized: 'Widow: Ich verstehe es nicht. Und ich will es auch gar nicht verstehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352836
    m_Localized: 'Widow: Jemanden zu demütigen, der gerade jemanden verloren hat ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352837
    m_Localized: 'Widow: Warten Sie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352838
    m_Localized: 'Widow: Sie haben Ihre Waffe rausgeholt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352839
    m_Localized: 'Widow: Und Sie haben mich nicht getötet.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352840
    m_Localized: 'Widow: Was war das? Ihre Unsicherheit? Die können Sie auch anders zeigen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: Was wollen Sie testen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352842
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352843
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352844
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352845
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352846
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352847
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352848
    m_Localized: 'Scammer: Zähne sind kein Problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352849
    m_Localized: 'Scammer: Mein Kumpel war Zahnarzt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352850
    m_Localized: 'Scammer: Und wissen Sie was? Sie haben ihm alle Zähne ausgeschlagen! HAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352851
    m_Localized: 'Scammer: Ach so, Sie wollen sie sehen. Na gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352853
    m_Localized: 'Scammer: Nicht schlecht, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352854
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352855
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352856
    m_Localized: 'Scammer: Was zur Hölle? Das war eine ganz normale Geschichte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352857
    m_Localized: 'Scammer: Aber mich wegen meiner Zähne in den Kopf zu schießen ... Das müssen Sie mir erklären.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352858
    m_Localized: 'Scammer: Bitte?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352859
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352860
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: Sind Sie wahnsinnig?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: 'Scammer: Ach, lecken Sie mich doch ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: 'Scammer: Was zur Hölle? Ich bin nur ein ganz normaler Kerl.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: 'Scammer: Ich mache keine schmutzigen Dinge mit meinen Fingernägeln.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352866
    m_Localized: 'Scammer: Nicht, dass Sie einen falschen Eindruck bekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352867
    m_Localized: 'Scammer: Ich wasche mir die Hände. Aber vorhin habe ich eine Münze vom Boden aufgehoben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352868
    m_Localized: 'Scammer: Sie sind sauber. Ich wasche mir heute die Hände, Mann.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352869
    m_Localized: 'Scammer: Normalerweise wasche ich sie immer. Aber heute hatte ich keine Zeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352870
    m_Localized: 'Scammer: Sie sind sauber. Größtenteils.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352871
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352872
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352873
    m_Localized: 'Scammer: Sie wollten jemanden erschießen, weil er schmutzige Fingernägel hat?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352874
    m_Localized: 'Scammer: Wie Sie meinen. Ich dachte nicht, dass ich auf so dumme Art sterben würde.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352875
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352876
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352877
    m_Localized: 'Scammer: Eine seltsame Art, diese Monster zu identifizieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352878
    m_Localized: 'Scammer: Dumme Arschlöcher und Schmarotzer kann man an ihren Händen erkennen. Aber was haben Besucher damit zu tun?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352879
    m_Localized: 'Scammer: Man müsste um 9 Uhr aufstehen und mindestens 4 Stunden arbeiten. Scheiße.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352880
    m_Localized: 'Scammer: In letzter Zeit jucken meine Augen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352881
    m_Localized: 'Scammer: Glauben Sie, das kommt von der Sonne? Woher sonst?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352883
    m_Localized: 'Scammer: Scheiße, Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352884
    m_Localized: 'Scammer: Das ist irgendeine Krankheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352885
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352886
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352887
    m_Localized: 'Scammer: Hören Sie, ich habe einen Plan.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352888
    m_Localized: 'Scammer: Nehmen wir anderen Leuten ihr Geld weg, damit wir sie nicht erschießen müssen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352889
    m_Localized: 'Scammer: Was? Sie müssen darüber nachdenken?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352890
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352891
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352892
    m_Localized: 'Scammer: Na schön, wenn Ihnen der Plan nicht gefällt, kann ich Sie verstehen. Aber ich habe wirklich eine Augenkrankheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352893
    m_Localized: 'Scammer: Wenn Sie doch nur Augentropfen hätten ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352894
    m_Localized: 'Scammer: Ich würde sie sowieso nicht benutzen. Aus gewissen Gründen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352895
    m_Localized: 'Scammer: Sie wollen ein Foto machen? Nur zu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352896
    m_Localized: 'Scammer: Ich bin sehr lichtempfindlich. Es könnte sein, dass ich zucke.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352897
    m_Localized: 'Scammer: (Du fotografierst ihn.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352898
    m_Localized: 'Scammer: (Das Bild wirkt normal, aber sein Gesicht ...)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352899
    m_Localized: 'Scammer: (Es ist ziemlich verschwommen.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352900
    m_Localized: 'Scammer: Ich hab’s Ihnen ja gesagt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352901
    m_Localized: 'Scammer: Wollen Sie noch eins machen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352902
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352903
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352904
    m_Localized: 'Scammer: Ziehen Sie mich nicht ab, Kumpel, kümmern Sie sich lieber um diese Schmarotzer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352905
    m_Localized: 'Scammer: Machen Sie Ihnen Feuer unterm Hintern.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352906
    m_Localized: 'Scammer: Sonst machen sie’s sich bequem, vergessen, in wessen Haus sie sind, und bezahlen nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352907
    m_Localized: 'Scammer: Warten Sie!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352908
    m_Localized: 'Scammer: Scheiß auf Sie und Ihr Haus. Ich bin raus.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352909
    m_Localized: 'Scammer: Ich stelle mich direkt unter die Sonne. Das müssen Sie mit Ihrem Gewissen vereinbaren.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352910
    m_Localized: 'Scammer: Verdammt noch mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352911
    m_Localized: 'Scammer: Sie haben sich das falsche Geschäft ausgesucht.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352912
    m_Localized: 'Scammer: Sie sind hier der Boss.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352913
    m_Localized: 'Scammer: Na, wie lautet das Urteil? Alles gut?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352914
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352915
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352916
    m_Localized: 'Scammer: Warten Sie! Okay, Scheiße, einmal habe ich mich aus Neugier rasiert und beschlossen, es beizubehalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352917
    m_Localized: 'Scammer: Sagen Sie es niemandem. Sie sind doch kein Plappermaul, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352918
    m_Localized: 'Scammer: Moment mal! Das ist so, als ob sie meine Unterhosen sehen wollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352919
    m_Localized: 'Scammer: Sie wissen doch, dass ein zivilisierter Kerl keine verbrannten Achselhöhlen haben kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352920
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352921
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352922
    m_Localized: 'Scammer: Ich wusste, dass Sie vernünftig sind. Sie würden niemals auf normale Menschen losgehen. Hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352923
    m_Localized: 'Scammer: Warum setzen wir nicht lieber diese Trottel unter Druck?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352924
    m_Localized: 'Scammer: Nein? Na gut. Bis später.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352925
    m_Localized: 'Scammer: Ich weiß, dass Sie wegen dieser Geschichte mit den Besuchern gestresst sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352926
    m_Localized: 'Scammer: Und Sie tun das alles nur für uns.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352927
    m_Localized: 'Scammer: Also, Schwamm drüber.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: Was willst du testen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: 'Daughter: Meine Zähne? Du willst, dass ich dir meine Zähne zeige?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: 'Daughter: Warum? Ich hab noch meine Milchzähne. Das hat Papa gesagt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: Ich will nicht mehr weinen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: Hier sind sie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: Was heißt das?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: Ist alles gut?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: Ich kann mir die Nägel schon selber schneiden.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: Aber ich muss noch mehr üben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: Guck.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: Hübsch, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: 'Daughter: Ich hab sie selber geschnitten. Ganz alleine.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: 'Daughter: Ich gehe. Ich will alleine sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: Kannst du durch meine Augen gucken?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: 'Daughter: Siehst du dann, was ich denke?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: 'Daughter: Dann pass ich gut auf, was ich denke. Keine Sorge.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352953
    m_Localized: 'Daughter: Warum guckst du so?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352954
    m_Localized: 'Daughter: Hast du g-g-gesehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547072
    m_Localized: 'Daughter: Du ... Waaaaaaah.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: 'Daughter: Ich w-will was t-t-trinken.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: Was soll ich machen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: 'Daughter: (Du siehst sie an und erkennst, dass das zu viel ist.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: Du willst nur wissen, wer ich bin?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: 'Daughter: Ich bin müde. Darf ich alleine sein?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: Ein Foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: Ich bin noch nicht oft fotografiert worden.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: Zeigst du mir danach das Foto?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: (Du fotografierst sie.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: (Das Bild ist leicht verschwommen.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: 'Daughter: (Sie kam auf dich zugerannt, bevor das Bild fertig aufgenommen war.)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: Hmmm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: 'Daughter: Es gefällt mir nicht. Ich will nicht mehr fotografiert werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: 'NotTrue: Hehe. Testen Sie ruhig, Schätzchen. Sie werden nichts finden, was Sie noch nicht gesehen haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: Meine Zähne?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NotTrue: Aaaaaah.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: 'NotTrue: Ich habe diese Zähne immer gehasst. Ich dachte, ich sollte sie einfach alle rausreißen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: 'NotTrue: Sehen Sie sich meine Finger an. Damit kann ich nicht mal richtig zählen oder messen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: 'NotTrue: Sie geben einem nur so viel, dass es gerade so reicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: 'NotTrue: Oh, Schätzchen ... Sind Sie sicher, dass Sie das wollen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: 'NotTrue: Die Augen sind wie Fenster, die Licht ins Haus lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: 'NotTrue: Aber meine sind staubig ... Das Glas hat Risse ... Die Vorhänge sind schon lange von Motten zerfressen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: 'NotTrue: Sparen Sie es sich, Schätzchen. Es gibt nichts zu sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: 'NotTrue: Einer alten Dame unter die Arme sehen wollen ... Haben Sie überhaupt kein Schamgefühl? Ich kann ja kaum aufstehen!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: 'NotTrue: Aber was soll ich machen? Sie haben hier das Sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: Und?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: 'NotTrue: Was? Warum wollen Sie den wertvollen Film für mich verschwenden? Nun gut, ich fühle mich geschmeichelt!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: Na, was meinen Sie, Schätzchen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: 'NotTrue: Haha! Sie haben vielleicht Ideen, Schätzchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: 'NotTrue: Meine Ohren sind ganz normal. Ich höre so gut wie immer. Aber manchmal habe ich das Gefühl, gar nicht mehr da zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: 'NotTrue: Als ob ich nur durch eine Dachluke zu sehen wäre, und manchmal überhaupt nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: 'NotTrue: He, warum richten Sie dieses Ding auf mich?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: 'NotTrue: Es gibt nichts Schlimmeres als eine zahnlose alte Dame.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: 'NotTrue: Denken Sie, ich habe Angst? Denken Sie, ich hänge an meinen Fingern?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: 'NotTrue: Ich habe so oft in die Luft gegriffen – meine Finger wissen genau, dass ich an gar nichts hänge.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: So ist das also ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: 'NotTrue: Sie glauben mir nicht? Wollen Sie sich selbst überzeugen? Dann sehen Sie nach ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: 'NotTrue: Ich habe den Leuten früher auch oft in die Augen gesehen. Das weckt Erinnerungen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: 'NotTrue: Tja, das ist wie eine Auszeichnung für das Alter. Irgendwann bekommt jeder so ein Geschenk. Wussten Sie das nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: 'NotTrue: Der Pilz fühlt keinen Schmerz. Er bettelt nicht um Essen. Er ist einfach nur da. Er lebt, um zu leben. So wie ich, hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: 'NotTrue: Warum rasten Sie denn gleich so aus?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: 'NotTrue: Was ist los, Schätzchen? Stört Sie irgendetwas an meinen Ohren?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: 'NotTrue: Na schön, von mir aus. Was macht das schon, Schätzchen? Ich wollte Gott sowieso schon lange treffen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: Aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: 'NotTrue: Ich habe einen Arzt dafür bezahlt, dass er sie alle rauszieht, aber er konnte nicht alle auf einmal ziehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: 'NotTrue: Bei jedem Besuch zog er mir einen oder zwei ... Alle hat er nicht geschafft. Ärzte haben für so was keine Zeit mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: 'NotTrue: Und deshalb lebe ich mit dieser Baustelle in meinem Mund.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: 'NotTrue: Hände sind für diejenigen, die sie halten. Ich halte schon lange keine Hände mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: 'NotTrue: Ich soll meine Hände ausstrecken? Warum? Sie können doch ihre ausstrecken.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: 'NotTrue: „Springen Sie in den Wind und lassen Sie sich treiben ...“ In meine Hütte, Schätzchen. Treten Sie ein.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: 'NotTrue: Glauben Sie, dass Sie diesem Schicksal entfliehen können? Nur, wenn Sie jung sterben. Passen Sie lieber auf sich auf!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: 'NotTrue: Sie sind so gutaussehend! Es wäre eine Sünde, solche Schönheit zu vernichten.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: 'NotTrue: Früher hatten nur die Reichen solche Gerätschaften. Aber jetzt kann sie jeder benutzen!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: 'NotTrue: Ich habe Ihnen nichts zu sagen. Sie verhalten sich wie ein Dummkopf. Rechtschaffene Leute grundlos zu behelligen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547160
    m_Localized: 'Alkonost: Solange du meine Schwester in Ruhe lässt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547161
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547162
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547163
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547164
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547165
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547166
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547167
    m_Localized: 'Alkonost: In unserer Familie hatten wir schon immer kräftige Zähne.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547168
    m_Localized: 'Alkonost: Als Jugendliche habe ich mal probiert, ein Bier mit den Zähnen zu öffnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547169
    m_Localized: 'Alkonost: Es ist nicht gut ausgegangen. Aber es hat mir beigebracht, auf meine Zähne aufzupassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547170
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547171
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547172
    m_Localized: 'Alkonost: Meine Schwester kann sich in ihrem Zustand um nichts kümmern. Also bin ich die Einzige, die ihre Hände benutzt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547173
    m_Localized: 'Alkonost: Und wie sollen menschliche Hände schon aussehen, wenn sie für zwei Leben gleichzeitig verantwortlich sind?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547174
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547175
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547176
    m_Localized: 'Alkonost: Meine Schwester weint viel, aber unsere Augen sind trotzdem immer noch ähnlich. Ihr Blick ist vielleicht ausdrucksloser.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547177
    m_Localized: 'Alkonost: Das macht mir Sorgen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547178
    m_Localized: 'Alkonost: Meine Schwester weint viel, aber unsere Augen sind trotzdem immer noch ähnlich. Sie sind nicht rot, meine ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547179
    m_Localized: 'Alkonost: Vielleicht hat sie sich schon leergeweint.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547180
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547181
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547182
    m_Localized: 'Alkonost: Von mir aus. Aber behellige nicht meine Schwester damit, ja? Sie ist zu erschöpft dafür.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547183
    m_Localized: 'Alkonost: Ich rasiere mich normalerweise. Ich versuche, auf mein Äußeres zu achten.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547184
    m_Localized: 'Alkonost: Selbst in diesen verrückten Zeiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547185
    m_Localized: 'Alkonost: Normalerweise rasiere ich mich, aber ich habe keinen Rasierer dabei.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547186
    m_Localized: 'Alkonost: Jetzt ist sowieso nicht die Zeit dafür.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547187
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547188
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547189
    m_Localized: 'Alkonost: Meine Schwester und ich haben genug durchgemacht. Nimm die Waffe runter.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547190
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547191
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547192
    m_Localized: 'Alkonost: Neulich habe ich angefangen zu rauchen. Wegen Leuten wie dir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547193
    m_Localized: 'Alkonost: Denkst du, du bist der Einzige, der es schwer hat?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547194
    m_Localized: 'Alkonost: Denkst du, du kannst einfach mit einer Waffe auf Leute zielen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547195
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547196
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547197
    m_Localized: 'Alkonost: Was soll das? War dir mein Blick zu unruhig oder zu leer?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547198
    m_Localized: 'Alkonost: Was soll das? War dir mein Blick zu leer?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547199
    m_Localized: 'Alkonost: Denkst du, du siehst anders aus?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547200
    m_Localized: 'Alkonost: Man sollte die Ruhe bewahren und keine voreiligen Entscheidungen treffen. Das sage ich meiner Schwester immer wieder.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547201
    m_Localized: 'Alkonost: Schade, dass ich es dir auch sagen muss.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547202
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547203
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547204
    m_Localized: 'Alkonost: Moment mal. Haben die in den Nachrichten wirklich gesagt, dass SOLCHE Achselhöhlen auf Besucher hindeuten?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547205
    m_Localized: 'Alkonost: Denk doch mal nach. Mach keine Dummheiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547206
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547207
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547208
    m_Localized: 'Alkonost: So endet also die Ballade meines Lebens.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547209
    m_Localized: 'Alkonost: Bitter.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547210
    m_Localized: 'Alkonost: Das Leben hat schon immer unsere Stärke getestet. Alles war immer so schwer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547211
    m_Localized: 'Alkonost: Meine Schwester konnte es nicht aushalten. Sie hat aufgegeben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547212
    m_Localized: 'Alkonost: Ich verstehe dich jetzt. Deine Situation ist nicht zu beneiden.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547213
    m_Localized: 'Alkonost: Aber wenn du dich von der Panik leiten lässt, was unterscheidet dich dann noch von den Besuchern?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547214
    m_Localized: 'Alkonost: Was passiert, wenn du von anderen isoliert bleibst?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547215
    m_Localized: 'Alkonost: Ich habe das alles so satt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547216
    m_Localized: 'Alkonost: Ich will hier einfach nur eine kleine Auszeit nehmen und nicht in ständiger Angst leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547217
    m_Localized: 'Alkonost: Aber es ist überall dasselbe und kein Ende ist in Sicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547218
    m_Localized: 'Alkonost: Um ehrlich zu sein, habe ich auch furchtbare Angst.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547219
    m_Localized: 'Alkonost: Was kommt als Nächstes? Werden die Besucher verschwinden oder müssen wir unsere Städte für immer mit ihnen teilen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547220
    m_Localized: 'Sirin: Mach schon.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547221
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547222
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547223
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547224
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547225
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547226
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547227
    m_Localized: 'Sirin: Sieh gut hin.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547228
    m_Localized: 'Sirin: Willst du sie mir ausschlagen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547229
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547230
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547231
    m_Localized: 'Sirin: Meine Schwester hilft mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547232
    m_Localized: 'Sirin: Aber es ist sinnlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547233
    m_Localized: 'Sirin: Sie hätte ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547234
    m_Localized: 'Sirin: Sie hätte mich einfach sterben lassen sollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547235
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547236
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547237
    m_Localized: 'Sirin: Meine Schwester und ich haben ähnliche Augen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547238
    m_Localized: 'Sirin: Aber ihre sind nicht so leer.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547239
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547240
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547241
    m_Localized: 'Sirin: Meine Schwester rasiert mir die Achselhöhlen. Sie kümmert sich um mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547242
    m_Localized: 'Sirin: Vielleicht war es nicht umsonst.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547243
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547244
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547245
    m_Localized: 'Sirin: Umso besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547246
    m_Localized: 'Sirin: Nimm meine Seele.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547247
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547248
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547249
    m_Localized: 'Sirin: Das ist nicht nötig.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547250
    m_Localized: 'Sirin: Der Tod kommt sowieso bald.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547251
    m_Localized: 'Sirin: Du kannst es auch mir überlassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547252
    m_Localized: 'Sirin: Gib mir die Waffe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547253
    m_Localized: 'Sirin: Ich bringe es selbst zu Ende.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547254
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547255
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547256
    m_Localized: 'Sirin: Die Leere verschwindet nicht, wenn ich die Augen schließe.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547257
    m_Localized: 'Sirin: Ich übertrage sie einfach auf dich.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547258
    m_Localized: 'Sirin: Gefällt dir das?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547259
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547260
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547261
    m_Localized: 'Sirin: Und?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547262
    m_Localized: 'Sirin: Drückst du ab?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547263
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547264
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547265
    m_Localized: 'Sirin: Fehlt dir der Mut?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547266
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547267
    m_Localized: 'Sirin: Du wirst sowieso sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547268
    m_Localized: 'Sirin: Schade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547269
    m_Localized: 'Sirin: Vielleicht nächstes Mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547270
    m_Localized: 'Sirin: Schade.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547271
    m_Localized: 'Sirin: Ich habe keine verdächtigen Anzeichen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547272
    m_Localized: 'Sirin: Vielleicht nächstes Mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547273
    m_Localized: 'Sirin: Was, wenn wir von einem schwarzen Loch verschlungen werden?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547274
    m_Localized: 'Sirin: Es wird lange dauern, bis wir im Ereignishorizont verschwunden sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547275
    m_Localized: 'Sirin: Und wir werden unser eigenes Ende niemals sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547276
    m_Localized: 'Sirin: Ewige Qualen und Todesangst.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547277
    m_Localized: 'Sirin: Egal.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547278
    m_Localized: 'Sirin: Dann warte ich eben auf mein Ende.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547279
    m_Localized: 'Sirin: Mein Lied ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547280
    m_Localized: 'Sirin: Aber es war für dich bestimmt!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547281
    m_Localized: 'Sirin: Es hatte ein gutes Ende!'
    m_Metadata:
      m_Items: []
