      m_Items: []
  - m_Id: 41582931041312883
    m_Localized: 'Foreigner: Bhwl?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312884
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312885
    m_Localized: "Foreigner: Lfk yhuvwhkh lpphu qrfk qlfkw, zduxp vlh gdv doohv wxq ...\nGlh Sunne ndqq hlqhp glh QhwCkdxw yhueuhqqhq. Lfk schou qlfkw lq glh Sunne."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312886
    m_Localized: In Ruhe lassen
