  - m_Id: 41582931041312887
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312888
    m_Localized: 'Foreigner: Lfk yhuvwhkh gdv doohv qlfkw ... dehu hjdo ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312889
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312890
    m_Localized: "Foreigner: Cxiulhghq?\n"
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312891
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312892
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312893
    m_Localized: 'Foreigner: Zr lvw glhvhv Irwr? Gdv yhuglhqw hv, dxijhkäqjw cx zhughq!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312894
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312895
    m_Localized: 'Foreigner: Nöqqhq Vlh hv plu chljhq?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312896
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312897
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312898
    m_Localized: 'Foreigner: Gdv vlqg hlqidfk qxu Rkuhq.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312899
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312900
    m_Localized: 'Foreigner: Hlq Rkuulqj yrq phlqhp olhehq Iuhxqg.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312901
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312902
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312903
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312904
    m_Localized: 'Foreigner: Zduxp, zdv cxu Köooh?! Lfk kdeh jhwdq, zdv Vlh zroowhq!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312905
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312906
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312907
    m_Localized: 'Foreigner: Qhkphq Vlh glh Zdiih uxqwhu! Lfk kdeh Lkqhq qlfkwv jhwdq!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312908
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312909
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312910
    m_Localized: 'Foreigner: Qhlq! Lfk elq hlqhu yrq ghq Jxwhq! Zlu yhuvwhkhq xqv qxu qlfkw!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312911
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312912
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312913
    m_Localized: 'Foreigner: Pdqq! Köuhq Vlh dxi! Gdv lvw Zdkqvlqq!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312914
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312915
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312916
    m_Localized: 'Foreigner: Haha ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312917
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312918
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312919
    m_Localized: 'Foreigner: Xqg gdqq?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312920
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312921
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312922
    m_Localized: 'Foreigner: Vlh zlvvhq, gdvv pdq plu ghq Pxqg zxjhqäkw kdw. Xqg mhwCw schiesn Vlh dxi Ohxwh ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312923
    m_Localized: 'Foreigner: Lfk vroowh plu glh Käqgh zdvfkhq ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312924
    m_Localized: 'Foreigner: Dxjhq vlqg Dxjhq. Zduxp zroohq Vlh plu Dqjvw pdfkhq?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312925
    m_Localized: 'Foreigner: Vlh pdfkhq gruw Dests ... Gdv iükow vlfk qlfkw ulfkwlj dq ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312926
    m_Localized: 'Foreigner: Lfk pdj Irwrv. Dehu Vlh vlqg nhlq jurßhu Idq gdyrq, rghu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312927
    m_Localized: 'Foreigner: Lfk züugh doohv jhehq, xp lkq zlhghucxvhkhq. Lfk yhuplvvh lkq vr. Hatt gdv hwzdv cx ehghxwhq?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312928
    m_Localized: 'Foreigner: Vr oäxiw gdv. Vlh yhuvwhkhq hlqhq qlfkw, vlh iüufkwhq hlqhq, xqg gdqq ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312929
    m_Localized: 'Foreigner: wöwhq vlh hlqhq ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312930
    m_Localized: 'Edgar: Alles, was ich bin, ist schon lange nur noch eine Geschichte.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312931
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312932
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312933
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312934
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312935
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312936
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312937
    m_Localized: 'Edgar: Ich erinnere mich an ihre Zähne ... Wie ich ihr Lächeln geliebt habe ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312938
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312939
    m_Localized: 'Edgar: Und meine ... Wie Herbstlaub, das zu lange im Regen lag.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312940
    m_Localized: 'Edgar: Und das ... Das ist der Preis der Liebe.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312941
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312942
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312943
    m_Localized: 'Edgar: Sie hatte solche zarten Hände. Manchmal hatte ich Angst, dass sie mit meinen verschmelzen, wie Geisterhände ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312944
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312945
    m_Localized: 'Edgar: Die rechte Hand ist nicht mehr meine. Sie verrottet ... Stück für Stück.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312946
    m_Localized: 'Edgar: Die linke hält sich noch. Sehen Sie die Fingernägel? Schön sauber.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312947
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312948
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312949
    m_Localized: 'Edgar: Sogar die Erinnerung an ihre Augen ist verstörend ... Tut mir leid, Sie wollten meine sehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312950
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312951
    m_Localized: 'Edgar: Es heißt, wenn man viel weint, werden die Farben intensiver. Aber ich habe lange nicht mehr geweint.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312952
    m_Localized: 'Edgar: Ich suche nicht mehr nach ihrem Gesicht. Das Akzeptieren ist am schwierigsten.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312953
    m_Localized: 'Edgar: Aber aus Gewohnheit suche ich immer noch unbewusst nach ihr. Aus dem Augenwinkel versuche ich, irgendeine Spur zu erhaschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312954
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312955
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312956
    m_Localized: 'Edgar: Ja, natürlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312957
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312958
    m_Localized: 'Edgar: Der Körper mag es nicht, zu lange in einer Position zu bleiben. Am Anfang habe ich mich für sie gepflegt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312959
    m_Localized: 'Edgar: Aber das hat sich als müßig erwiesen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312960
    m_Localized: 'Edgar: Der Körper mag es nicht, zu lange in einer Position zu bleiben. Und ich hatte keine Wahl.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312961
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312962
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312963
    m_Localized: 'Edgar: Na gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312964
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312965
    m_Localized: 'Edgar: Und? Wie sehe ich aus?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312966
    m_Localized: 'Edgar: Oder besser gesagt ... Was haben Sie gesehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312967
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312968
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312969
    m_Localized: 'Edgar: Was einmal war, bleibt erhalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312970
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312971
    m_Localized: 'Edgar: Eines der wenigen Dinge, die unverändert sind.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312972
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312973
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312974
    m_Localized: 'Edgar: Wollen Sie mir Angst machen? Nein, mein Freund. Das hier ist nur eine Hülle. Sie fällt schon auseinander.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312975
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312976
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312977
    m_Localized: 'Edgar: Ich wollte eigentlich auf meine eigene Art abtreten, nicht so ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312978
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312979
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312980
    m_Localized: 'Edgar: Lassen Sie mich auf meine Art gehen. Sparen Sie Ihre Kugeln ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312981
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312982
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312983
    m_Localized: 'Edgar: Wenn man lange genug neben jemandem liegt ... nimmt man seine Eigenarten an. Ich glaube, ich bin ein Teil von ihr geworden.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312984
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312985
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312986
    m_Localized: 'Edgar: Interessant ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312987
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312988
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312989
    m_Localized: 'Edgar: Nun denn ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312990
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312991
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312992
    m_Localized: 'Edgar: Wissen Sie ... Sie hat mich immer geküsst, als hätte sie Angst, es könnte das letzte Mal sein. Jetzt verstehe ich, warum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312993
    m_Localized: 'Edgar: Ich habe so lange versucht, meine Hand zu bewahren ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312994
    m_Localized: 'Edgar: Ich dachte, wenn ein Teil von mir sauber bleibt, würde es als Andenken dienen. Aber jetzt ... Welche Bedeutung hat das noch?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312995
    m_Localized: 'Edgar: Viel besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312996
    m_Localized: 'Edgar: Wenn ich ihr in die Augen sah, fühlte es sich an, als ob dort der Himmel wohnte. Immer.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312997
    m_Localized: 'Edgar: Und jetzt ... nur noch Leere. Ein schwarzes Loch, das mich anzieht. Mir wurde immer klarer, dass es nicht ihr Blick war, sondern ein Echo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312998
    m_Localized: 'Edgar: Fremde Worte. Fremde Stimmen. Die Toten sprechen an ihrer Stelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312999
    m_Localized: 'Edgar: Seltsam ... Es heißt, die Lebenden nehmen etwas von den Toten an, wenn sie zu lange an ihrer Seite bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313000
    m_Localized: 'Edgar: Aber was, wenn es umgekehrt ist?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313001
    m_Localized: 'Edgar: Fotos halten die Erscheinung fest, nicht die Seele. Wenn ich ein Maler wäre, hätte ich sie auf der Leinwand verewigt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313002
    m_Localized: 'Edgar: Aber ich bin nur ein hoffnungsloser Romantiker ... und so lebt sie nur in meiner Erinnerung weiter, bis ich auch nicht mehr bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313003
    m_Localized: 'Edgar: Sie liebte es, mir ins Ohr zu flüstern. Ich wusste nie, was sie sagte.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313004
    m_Localized: 'Edgar: Vielleicht weil ich mir wünschte, dass es etwas Nettes ist. Aber sie war schon tot ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313005
    m_Localized: 'Edgar: Ich komme zu dir ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313006
    m_Localized: 'Edgar: Meine Liebste ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313007
    m_Localized: 'TaxiDriver: Äh, hey, Mann ... Versteh mich nicht falsch. Ich sag nicht nein, aber ... na ja, du wirst es ja selbst sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313008
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313009
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313010
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313011
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313012
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313013
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313014
    m_Localized: 'TaxiDriver: Zähne sind einfach nur Zähne, nichts Besonderes.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313015
    m_Localized: 'TaxiDriver: Ich hab mich immer um sie gekümmert. Schon als Kind hab ich sie gebleicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313016
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313017
    m_Localized: 'TaxiDriver: Meine Eltern haben immer gesagt: „Dein Lächeln ist das Erste, was die Leute sehen.“'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313018
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313019
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313020
    m_Localized: 'TaxiDriver: Sie sind aber nicht gerade hübsch ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313021
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313022
    m_Localized: 'TaxiDriver: Ganz normale Hände, Mann ... Wenn ich nicht rauchen würde, hätte ich sie mir wahrscheinlich vor Nervosität blutig gekaut.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313023
    m_Localized: 'TaxiDriver: Ganz normale Hände, Mann ... Ja, die Nägel sind dreckig, ich weiß. Ich kratze immer am Lenkrad, damit ich nicht den Verstand verliere.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313024
    m_Localized: 'TaxiDriver: Ich will ja nicht meine Kunden in die Flucht schlagen, haha.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313025
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313026
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313027
    m_Localized: 'TaxiDriver: Meine Augen sind immer müde. Es fällt mir schwer, sie zuzumachen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313028
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313029
    m_Localized: 'TaxiDriver: Die Macht der Gewohnheit. Ich muss immer alles sehen. Wer hinter mir fährt, wer mich anstarrt, wer zu lange still ist. Berufskrankheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313030
    m_Localized: 'TaxiDriver: Und jetzt leide ich unter Schlaflosigkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313031
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313032
    m_Localized: 'TaxiDriver: Seit sie mir mein Auto genommen haben, kann ich nachts nicht mehr schlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313033
    m_Localized: 'TaxiDriver: Dazu kommt die Gewohnheit. Ich muss immer alles sehen. Wer hinter mir fährt, wer mich anstarrt, wer zu lange still ist. Berufskrankheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313034
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313035
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313036
    m_Localized: 'TaxiDriver: Nichts Besonderes.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313037
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313038
    m_Localized: 'TaxiDriver: Aber wenn ich zu lange fahre, tun mir die Schultern weh. Manchmal kann ich die Arme gar nicht mehr heben.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313039
    m_Localized: 'TaxiDriver: Aber egal, ich bin’s gewohnt. Vor allem jetzt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313040
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313041
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313042
    m_Localized: 'TaxiDriver: Mach ruhig, Mann. Ich bin bereit.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313043
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313044
    m_Localized: 'TaxiDriver: Und? Was siehst du? Wahrscheinlich nur mich. Nichts Besonderes.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313045
    m_Localized: 'TaxiDriver: Ich hatte immer Fotos von mir und meinem Vater im Auto. Jetzt sind die Inspekteure die Einzigen, die noch Fotos machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313046
    m_Localized: 'TaxiDriver: Oder du.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313047
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313048
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313049
    m_Localized: 'TaxiDriver: Meine Ohren sind wie die von jedem anderen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313050
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313051
    m_Localized: 'TaxiDriver: Ich hör viel zu – Fahrgäste reden gerne. Ich unterbreche sie nicht. Ich ... hör einfach nur zu. Und merke mir, was sie sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313052
    m_Localized: 'TaxiDriver: Manchmal hör ich aber auch zu viel.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313053
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313054
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313055
    m_Localized: 'TaxiDriver: Hey, Mann! Ich bin nicht verrückt. Es hat damals angefangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313056
    m_Localized: 'TaxiDriver: Die Zähne haben mich an jemanden erinnert. Jemanden Schlimmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313057
    m_Localized: 'TaxiDriver: Mein Vater ist ihm einmal begegnet ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313058
    m_Localized: 'TaxiDriver: Seitdem rauche ich, und du siehst ja, was dieser Dreck mit meinen Zähnen gemacht hat ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313059
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313060
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313061
    m_Localized: 'TaxiDriver: Hehe ... Machst du Witze? Am Steuer zu sitzen ist eine verdammte Prüfung. Du weißt bestimmt, was ich meine.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313062
    m_Localized: 'TaxiDriver: Manche schlagen aufs Lenkrad, manche schreien, manche lassen die Fäuste fliegen. Jeder auf seine Art. Also spar dir die Scherze ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313063
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313064
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313065
    m_Localized: 'TaxiDriver: Komm schon, Mann. Ich bin nicht dumm. Ich weiß, dass du mich für einen Besucher hältst.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313066
    m_Localized: 'TaxiDriver: Aber du irrst dich. Willst du wirklich einen Unschuldigen erschießen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313067
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313068
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313069
    m_Localized: 'TaxiDriver: Na los, bring’s hinter dich. Ich hatte sowieso nie jemanden, der zu mir hält.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313070
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313071
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313072
    m_Localized: 'TaxiDriver: Wenn deine Kamera die Entscheidung getroffen hat ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313073
    m_Localized: 'TaxiDriver: Dann gibt’s nichts mehr hinzuzufügen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313074
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313075
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313076
    m_Localized: 'TaxiDriver: Hey, Mann, hör zu. Wenn du willst, hör ich dir zu. Darin bin ich gut. Von meiner eigenen Geschichte gibt’s nicht mehr viel zu erzählen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313077
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313078
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313079
    m_Localized: 'TaxiDriver: Du fragst dich wahrscheinlich, warum ich nicht mit dem Rauchen aufhöre, wenn es mir die Zähne ruiniert hat ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507072
    m_Localized: 'TaxiDriver: Du fragst dich wahrscheinlich, warum ich mir die Zähne bleiche ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507073
    m_Localized: 'TaxiDriver: Vielleicht, damit ich wie jemand anders aussehe. Nicht wie das Kind, das auf der Rückbank saß, als er einstieg.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507074
    m_Localized: 'TaxiDriver: Einflussreicher Typ in der Gegend. Jeder kannte ihn. Sogar ich als kleines Kind.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507075
    m_Localized: 'TaxiDriver: Auf den ersten Blick sah er normal aus. Rauchte wie ein Schlot.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507076
    m_Localized: 'TaxiDriver: Auf den ersten Blick sah er normal aus. Aber dieses Lächeln ... Weiß wie Porzellan.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507077
    m_Localized: 'TaxiDriver: Mein Vater hat damals einen Fehler gemacht. Wir haben dafür bezahlt. Haben gelebt wie die Ratten. Kein Zuhause, kein Geld, keine Ruhe.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507078
    m_Localized: 'TaxiDriver: Ich dachte immer, Hände stehen für Stärke. Kontrolle – über das Auto, über das Leben. Aber jetzt ... verdammt, was soll das alles?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507079
    m_Localized: 'TaxiDriver: Ich blicke mich ständig um.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507080
    m_Localized: 'TaxiDriver: Ich suche nach dem nächsten Fahrgast und frage mich, ob er wirklich der ist, der er zu sein vorgibt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507081
    m_Localized: 'TaxiDriver: Tut mir leid, falls dir das unheimlich ist. Ohne das Auto sollte ich wahrscheinlich aufhören, die Leute so nervös zu machen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507082
    m_Localized: 'TaxiDriver: Manchmal denke ich ... Wenn ich jemanden gehabt hätte, der zu mir hält, wäre es vielleicht nicht so weit gekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507083
    m_Localized: 'TaxiDriver: Ich hätte ihn nicht mitgenommen, hätte nicht alles verloren ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507084
    m_Localized: 'TaxiDriver: Vielleicht hast du in mir ja doch was Menschliches gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507085
    m_Localized: 'TaxiDriver: Ich bin nicht perfekt. Aber ich hab’s versucht. Auf ehrliche Weise.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507086
    m_Localized: 'TaxiDriver: Hehe ... Weißt du, was am gruseligsten ist, wenn ein Fahrgast einfach nur still dasitzt?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507087
    m_Localized: 'TaxiDriver: Man fängt an, seine eigenen Gedanken zu hören. Lauter als das Radio. Es hört nicht auf und lässt einem keine Ruhe ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507088
    m_Localized: 'TaxiDriver: Lass den Wind die Asche wegwehen, ja? Ich will nicht, dass meine Leiche hier rumliegt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507089
    m_Localized: 'TaxiDriver: *hust* In diesem ganzen Dreck.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507090
    m_Localized: 'Provocateur: Sie haben also ferngesehen und glauben diese ganze Besuchergeschichte? Ihre Entscheidung. Na los, testen Sie mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507091
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507092
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507093
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507094
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507095
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507096
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507097
    m_Localized: 'Provocateur: Was kommt als Nächstes? Wollen Sie in meinen Zähnen pulen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507098
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507099
    m_Localized: 'Provocateur: Und? Zufrieden? Oder schießen Sie mir jetzt den halben Kopf weg, nur weil ich mir die Zähne putze?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507100
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507101
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507102
    m_Localized: 'Provocateur: Meine Hände? Warum?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507103
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507104
    m_Localized: 'Provocateur: Sagen Sie bloß, dass Dreck unter meinen Fingernägeln mich zum Besucher macht.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507105
    m_Localized: 'Provocateur: Sagen Sie bloß, dass ungeschnittene Fingernägel mich zum Besucher machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507106
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507107
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507108
    m_Localized: 'Provocateur: Und wonach wollen Sie in meinen Augen suchen? Rötungen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507109
    m_Localized: 'Provocateur: Und was hoffen Sie dort zu finden? Einen bösen Blick?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507110
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507111
    m_Localized: 'Provocateur: Sehen Sie? Keine Rötungen!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507112
    m_Localized: 'Provocateur: Und? Irgendwas gefunden!?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507113
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507114
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507115
    m_Localized: 'Provocateur: Was!? Meine Achselhöhlen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507116
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507117
    m_Localized: 'Provocateur: Ich rasiere sie, ich hasse Schweiß. Sie glauben doch nicht ernsthaft, dass ich ein Besucher bin, weil ich mir die Achselhaare rasiere?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507118
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507119
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507120
    m_Localized: 'Provocateur: Ah, Sie wollen ein Foto ... Vielleicht soll ich noch für Sie lächeln?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507121
    m_Localized: 'Provocateur: Nein, im Ernst, machen Sie Ihr Foto. Das wird sicher irgendwas beweisen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507122
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507123
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507124
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507125
    m_Localized: 'Provocateur: Gott, Sie glauben auch alles, was im Fernsehen erzählt wird.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507126
    m_Localized: 'Provocateur: Was, wenn das nächste Erkennungszeichen Schamhaare sind? Ziehen Sie dann allen die Hosen runter, um sie zu inspizieren?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507127
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507128
    m_Localized: 'Provocateur: Spielen Sie jetzt Doktor? Und, was sehen Sie? Ohrenschmalz? Können Sie mir was dagegen verschreiben, Doktor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507129
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507130
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507131
    m_Localized: 'Provocateur: War ja klar. Von Ihnen habe ich nichts anderes erwartet.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507132
    m_Localized: 'Provocateur: Na los, drücken Sie ab. Saubere Zähne sind Ihr Beweis, dass ich ein Besucher bin, stimmt’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507133
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507134
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507135
    m_Localized: 'Provocateur: Was zur Hölle? Macht mich Dreck unter den Fingernägeln jetzt zum Besucher?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507136
    m_Localized: 'Provocateur: Was haben Sie diesmal für ein Problem!?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507137
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507138
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507139
    m_Localized: 'Provocateur: Ernsthaft!? Was ist denn jetzt schon wieder?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507140
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507141
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507142
    m_Localized: 'Provocateur: Soll das ein Scherz sein!? Sie sind misstrauisch, weil ich auf dem Foto gezuckt habe?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507143
    m_Localized: 'Provocateur: Wollen Sie mich verarschen!? Jetzt lesen Sie schon die „Aura“ eines Menschen von einem Foto ab?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507144
    m_Localized: 'Provocateur: Dann können Sie auch gleich eine Münze werfen, um zu entscheiden, wen Sie als Nächstes erschießen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507145
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507146
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507147
    m_Localized: 'Provocateur: Sind Sie verrückt? Wie sollen rasierte Achselhöhlen beweisen, dass ich ein Besucher bin?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507148
    m_Localized: 'Provocateur: Heißt das, Ihre sogenannten Besucher haben unter der Erde einen Vorrat an Rasierklingen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507149
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507150
    m_Localized: 'Provocateur: Großartig! Frei von jeder Logik! Aber klar, warum nicht einfach daran glauben?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507151
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507152
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507153
    m_Localized: 'Provocateur: Vielleicht sollten Sie aufhören, jedes Mal die Waffe auf Leute zu richten, wenn etwas nicht Ihren Infos aus dem Fernsehen entspricht!?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507154
    m_Localized: 'Provocateur: Oder glauben Sie, ein Schuss mit einer Schrotflinte hilft gegen Ohrenschmalz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507155
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507156
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507157
    m_Localized: 'Provocateur: Sieh an, sieh an! Sie haben ja doch noch einen Funken Verstand übrig!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507158
    m_Localized: 'Provocateur: Warum lassen Sie die Leute überhaupt rein, wenn Sie sie sofort umbringen wollen? Sie sind ja vollkommen irre!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507159
    m_Localized: 'Provocateur: Sie können doch nicht wegen jeder winzigen Unstimmigkeit die Waffe rausholen!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507160
    m_Localized: 'Provocateur: Was stimmt mit Ihnen nicht? Erst zielen Sie mit der Waffe auf mich und dann legen Sie sie weg, als wäre nichts gewesen. Sie Verrückter!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507161
    m_Localized: 'Provocateur: Hören Sie auf mit diesem Theater! Es gibt keine Besucher!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507162
    m_Localized: 'Provocateur: Wenn Sie so weitermachen, bekomme ich noch graue Haare!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507163
    m_Localized: 'Provocateur: Was? Soll ich aufhören, mir die Achselhaare zu rasieren, damit Sie nicht mit der Knarre auf mich zielen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507164
    m_Localized: 'Provocateur: Unglaublich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507165
    m_Localized: 'Provocateur: Und erwarten Sie keine Dankbarkeit, nur weil Sie mir nicht den Schädel weggepustet haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507166
    m_Localized: 'Provocateur: Was zur Hölle stimmt nicht mit Ihnen, dass Sie ständig diese Waffe auspacken? Seit wann hat Ohrenschmalz irgendwas zu bedeuten?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507167
    m_Localized: 'Provocateur: Moment mal – Sie wollen doch nicht wirklich abdrücken, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507168
    m_Localized: 'Provocateur: Nein, aufhören!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507169
    m_Localized: 'Provocateur: NEIN!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507170
    m_Localized: 'Marauder: Klar, warum nicht. Ich bin es gewohnt, misstrauisch beäugt zu werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507171
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507172
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507173
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507174
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507175
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507176
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507177
    m_Localized: 'Marauder: Hehe, ich hab schon mal solche Zähne gesehen. Na gut, ich zeige Ihnen meine, bevor ich die Geschichte erzähle.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507178
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507179
    m_Localized: 'Marauder: Was glotzen Sie so? Ich putze mir nicht die Zähne, na und? Hab ich noch nie. Ist doch meine freie Entscheidung.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507180
    m_Localized: 'Marauder: Was soll das bringen? Die Leute meiden mich sowieso. Ich trinke das Wasser lieber, anstatt es fürs Zähneputzen zu vergeuden.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507181
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507182
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507183
    m_Localized: 'Marauder: Hände, Handflächen, Finger.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507184
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507185
    m_Localized: 'Marauder: Die Fingernägel ... sind nicht besonders sauber. Warum sollte ich sie schrubben, wenn sie sowieso wieder schmutzig werden?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507186
    m_Localized: 'Marauder: Die Fingernägel ... sind nicht besonders sauber. Ja ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507187
    m_Localized: 'Marauder: Schon komisch. Diese Finger haben so viel gutes Zeug berührt, so viele Schätze ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507188
    m_Localized: 'Marauder: Und nichts davon konnte ich behalten. Vielleicht soll es so sein. Zumindest habe ich überlebt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507189
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507190
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507191
    m_Localized: 'Marauder: Nur ganz normale Augen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507192
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507193
    m_Localized: 'Marauder: Nichts Besonderes. Sehen Sie selbst.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507194
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507195
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507196
    m_Localized: 'Marauder: Verdammt ... Eigentlich bin ich derjenige, der nicht mit anderen Leuten kann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507197
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507198
    m_Localized: 'Marauder: Ja, es juckt. Aber was soll man machen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507199
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507200
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507201
    m_Localized: 'Marauder: Ach, kommen Sie. Wirklich?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507202
    m_Localized: 'Marauder: Schon gut. Ihr Haus, Ihre Regeln ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507203
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507204
    m_Localized: 'Marauder: Glauben Sie, Ihre Maschine kann in mich hineinschauen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507205
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507206
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507207
    m_Localized: 'Marauder: Nicht eingerissen oder angeknabbert wie bei einem streunenden Hund. Nur ein ganz normales Ohr.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507208
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507209
    m_Localized: 'Marauder: Zufrieden?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507210
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507211
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507212
    m_Localized: 'Marauder: Haha. Schlechte Zähne sind jetzt also ein Todesurteil? Dann schießen Sie. Ich wusste nicht, dass die Welt inzwischen so funktioniert.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507213
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507214
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507215
    m_Localized: 'Marauder: Schon ironisch, oder? Einen Plünderer erschießen, weil er sich nimmt, was sowieso schon nutzlos ist. Ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507216
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507217
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507218
    m_Localized: 'Marauder: Was hat Ihnen nicht gefallen? Vielleicht können wir darüber reden wie zivilisierte Männer?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507219
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507220
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507221
    m_Localized: 'Marauder: Selbst wenn ich irgendwelche Heilsalben gefunden hab, hab ich sie verkauft, anstatt sie zu benutzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507222
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507223
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507224
    m_Localized: 'Marauder: Wenn Ihnen ein Foto ausreicht, um mich zu verurteilen, worauf warten Sie dann noch? Tun Sie’s.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507225
    m_Localized: 'Marauder: Wenigstens muss ich dieses Leben dann nicht mehr weiter in die Länge ziehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507226
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507227
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507228
    m_Localized: 'Marauder: Was, gefällt Ihnen das Ohr etwa nicht?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507229
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507230
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507231
    m_Localized: 'Marauder: Ich hatte mal einen Kumpel, der sich über seine verlorene Füllung geärgert hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507232
    m_Localized: 'Marauder: Dann hat er seinen ganzen verdammten Kopf verloren. Ich glaube kaum, dass er danach noch mal an seine Zähne gedacht hat ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507233
    m_Localized: 'Marauder: Einmal hab ich ein Haus gefunden, das leer aussah.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507234
    m_Localized: 'Marauder: Ich nahm eine alte Taschenuhr aus dem Regal. Ich dachte, die könnte was wert sein. Dann hörte ich oben Schritte.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507235
    m_Localized: 'Marauder: Ich bekam eine Heidenangst und machte mich sofort aus dem Staub. Ob wirklich jemand dort war, war mir egal.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507236
    m_Localized: 'Marauder: Was mich viel mehr interessieren würde, ist ... ob diese Taschenuhr noch dort ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507237
    m_Localized: 'Marauder: Schon besser.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507238
    m_Localized: 'Marauder: Da fällt mir ein, ich hab mal diese Brille gefunden. Eine Kinderbrille, winziges Ding.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507239
    m_Localized: 'Marauder: Ich hob sie auf und sah Fingerabdrücke auf den Gläsern. Ich stellte mir vor, wie der kleine Junge dadurch die Welt sah ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507240
    m_Localized: 'Marauder: Tja, jetzt hat er entweder Probleme ohne seine Brille, oder er sieht überhaupt nichts mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507241
    m_Localized: 'Marauder: Ich? Es juckt und brennt für ein paar Tage, das kann ich aushalten. Ist nicht das erste Mal. Und auch nicht das letzte Mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507242
    m_Localized: 'Marauder: Ich leide schon mein ganzes Leben darunter. Und ich würde es wieder genauso machen. Geld kann man immer gebrauchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507243
    m_Localized: 'Marauder: Einmal hab ich ein altes Foto gefunden. Zwei Kinder, Vater und Mutter. Alle mit breitem Lächeln.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507244
    m_Localized: 'Marauder: Ich frage mich, ob noch jemand von ihnen lebt. Oder ist das Bild alles, was noch übrig ist?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507245
    m_Localized: 'Marauder: Wenn man allein ist, hört man Dinge. Geflüster. Als ob jemand einen ruft. Aber da ist niemand. Trotzdem hört man hin, nur für alle Fälle.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507246
    m_Localized: 'Marauder: Ich hätte nicht herkommen sollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507247
    m_Localized: 'Marauder: Zu so einem Bastard ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507248
    m_Localized: 'GraveDigger: Tss ... Na los, testen Sie. Ich bin ein offenes Buch.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507249
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507250
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507251
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507252
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507253
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507254
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507255
    m_Localized: 'GraveDigger: Wenn man zu tief gräbt, findet man manchmal nicht nur Knochen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507256
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507257
    m_Localized: 'GraveDigger: Die weißen sind meine eigenen. Die glänzenden dagegen ... Sagen wir einfach, ich habe sie gefunden. In einem alten Sarg.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507258
    m_Localized: 'GraveDigger: Sie wurden sowieso nicht mehr gebraucht, aber für mich sind sie praktisch.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507259
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507260
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507261
    m_Localized: 'GraveDigger: Diese Hände haben mich ernährt und am Leben gehalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507262
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507263
    m_Localized: 'GraveDigger: Finger wie Wurzeln. Schwarze Fingernägel, die nie sauber werden. Der Dreck steckt in ihnen fest wie die Erinnerung an all die Jahre ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507264
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507265
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507266
    m_Localized: 'GraveDigger: Ich arbeite nur nachts.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507267
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507268
    m_Localized: 'GraveDigger: Wer buddelt schon tagsüber? Andere sehen die Sonne. Ich habe eine Lampe auf dem Kopf und sehe Schatten im Grab. Immer auf der Hut.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507269
    m_Localized: 'GraveDigger: Meine Augen sind ständig auf der Suche nach einem Besucher, der sich anschleicht. Verdammt hartes Leben. Ich will nur, dass das vorbeigeht.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507270
    m_Localized: 'GraveDigger: Wer buddelt schon tagsüber? Andere sehen die Sonne. Ich habe eine Lampe auf dem Kopf und sehe Schatten im Grab.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507271
    m_Localized: 'GraveDigger: Vielleicht ist es besser so. Ich habe nie die Sonne gesehen, und das wird auch so bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507272
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507273
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507274
    m_Localized: 'GraveDigger: Sie sind ein komischer Kauz ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507275
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507276
    m_Localized: 'GraveDigger: Manchmal juckt es, als ob der Dreck unter meine Haut gekrochen ist. Ich habe keine Zeit zum Rasieren. Wen interessiert das schon?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507277
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507278
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507279
    m_Localized: 'GraveDigger: Ein Foto ist eine gefährliche Sache. Wie ein Spiegel. Es hält fest, was es sieht.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507280
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507281
    m_Localized: 'GraveDigger: Ha ... Das sieht ja lustig aus. Sind das Schatten? Wahrscheinlich nur Staub auf der Linse.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507282
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507283
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507284
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507285
    m_Localized: 'GraveDigger: Einfach nur Ohren. Nichts Besonderes.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507286
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507287
    m_Localized: 'GraveDigger: Normaler geht nicht. Weder verbrannt noch sonst was. Sie hören noch einwandfrei ... leider.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507288
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507289
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507290
    m_Localized: 'GraveDigger: Schießen Sie ruhig. Aber verschonen Sie das Gold, das ist mein Rentenfonds, hehe. Sonst komme ich vielleicht als Besucher zurück ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507291
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507292
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507293
    m_Localized: 'GraveDigger: Vielleicht ist meine Zeit gekommen ... Diese Hände haben zu viele Tote berührt. Zeit, mich ihnen anzuschließen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507294
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507295
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507296
    m_Localized: 'GraveDigger: Vielleicht ist es besser, überhaupt nichts zu sehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507297
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507298
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507299
    m_Localized: 'GraveDigger: Wenn schon meine Achselhöhlen Ihnen Angst machen, wollen Sie gar nicht wissen, was in meinem Kopf vor sich geht.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507300
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507301
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507302
    m_Localized: 'GraveDigger: Sehen Sie irgendwas auf diesem Foto? Da, hinter mir? Das ist nur Rauch. Ist doch so, oder? Sagen Sie mir, dass das nur Rauch ist ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507303
    m_Localized: 'GraveDigger: Also, was ist es? Ein Geist? Asche? Oder nur ein Fleischklops?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507304
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507305
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507306
    m_Localized: 'GraveDigger: Die Erde spricht.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507307
    m_Localized: 'GraveDigger: Na los. Drücken Sie ab. Vielleicht hält sie dann den Mund.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507308
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507309
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507310
    m_Localized: 'GraveDigger: Ich hatte es immer für eine Sünde gehalten. Aber dann ... lag da diese Leiche mit offenem Mund, das Gold funkelte ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507311
    m_Localized: 'GraveDigger: Wer wird es vermissen? Die Toten nicht. Die Lebenden brauchen es dringender. Aber vielleicht sind die Toten sauer auf Leute wie mich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507312
    m_Localized: 'GraveDigger: Manchmal gräbt man mit der Schaufel, manchmal mit der Hand bei gefrorenem Boden. Nägel brechen, Finger bluten, aber man gräbt weiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507313
    m_Localized: 'GraveDigger: Man hat keine andere Wahl. Wenn man aufhört, hört man die Erde flüstern. Und das vergisst man nie.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507314
    m_Localized: 'GraveDigger: Manchmal vergräbt man eine Leiche und hört dann nachts ein Rascheln. Man sieht sich um – nichts. Passiert immer wieder.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507315
    m_Localized: 'GraveDigger: Die Augen brennen ... weil sie schlimme Dinge gesehen haben. Und weil sie wissen, dass ich die Besucher wiedersehen werde.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507316
    m_Localized: 'GraveDigger: Manchmal vergräbt man eine Leiche und hört dann nachts ein Rascheln. Man sieht sich um – nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507317
    m_Localized: 'GraveDigger: Die Augen brennen ... weil sie schlimme Dinge gesehen haben. Mehr als sie sollten.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507318
    m_Localized: 'GraveDigger: Einmal zog ich in der Sommerhitze einen Sarg, völlig verschwitzt. Ein Typ witzelte: „Fühlt sich an, als würden wir uns selbst beerdigen.“'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507319
    m_Localized: 'GraveDigger: Und ich dachte ... vielleicht tun wir das wirklich. Ich beerdige mich selbst mit den Toten, Stück für Stück.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507320
    m_Localized: 'GraveDigger: Manchmal denk ich ... da unten ... im letzten Loch. Da, wo er war. Ich habe ihn selbst begraben, ich erinnere mich ... Ach, vergessen Sie’s.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507321
    m_Localized: 'GraveDigger: Ein Foto ist wie ein Blitz zwischen den Welten. Es zeigt diejenigen, die nicht gegangen sind ... Aber am Ende ist es nur Licht, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507322
    m_Localized: 'GraveDigger: Früher hieß es, Fotos würden einem die Seele rauben. Inzwischen denke ich ... vielleicht rauben sie nur den warmen Teil.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507323
    m_Localized: 'GraveDigger: Ich bin schon lange wie erstarrt. Selbst auf dem Foto ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507324
    m_Localized: 'GraveDigger: Manchmal lege ich mich hin und horche am Boden. Seit damals ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507325
    m_Localized: 'GraveDigger: Ich höre jemanden rufen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507326
    m_Localized: 'GraveDigger: Vielleicht bilde ich es mir nur ein. Aber ... denken Sie mal darüber nach.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507327
    m_Localized: 'GraveDigger: Da unten könnten sich Besucher verstecken, und einer nach dem anderen kriechen sie hervor ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507328
    m_Localized: 'GraveDigger: Nun ... Mal sehen, ob nach dem Tod noch etwas kommt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507329
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507330
    m_Localized: 'FormerFema: Mach ruhig, aber verschwende nicht meine Zeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507331
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507332
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507333
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507334
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507335
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507336
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507337
    m_Localized: 'FormerFema: Du nimmst deinen Job ja wirklich ernst.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507338
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507339
    m_Localized: 'FormerFema: Hör zu, ich habe schon bessere Tage gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507340
    m_Localized: 'FormerFema: Da war dieser Fall ... Wir haben einen erwischt. Der Kommandeur sah seinen Mund an und sagte, er sei ein Besucher. Und dann ... bumm.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507341
    m_Localized: 'FormerFema: Also dachte ich mir, man sollte nicht zu gründlich mit den Zähnen sein. Nur um Fragen zu vermeiden, wenn du verstehst.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507342
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507343
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507344
    m_Localized: 'FormerFema: Soll ich die Handschuhe ausziehen? Vergiss es. Das ist mir zu unsicher. Du wirst mich so testen müssen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507345
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507346
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507347
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507348
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507349
    m_Localized: 'FormerFema: Ah, ja. Das gefällt mir. Augen sind schließlich etwas Wunderschönes.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507350
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507351
    m_Localized: 'FormerFema: Rot? Na ja, wenn man die ganze Zeit unter dieser Maske steckt ... Das hinterlässt Spuren.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507352
    m_Localized: 'FormerFema: Man sieht schlechter. Alles erscheint enger. Als ob man durch Sehschlitze blickt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507353
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507354
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507355
    m_Localized: 'FormerFema: Willst du das wirklich sehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507356
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507357
    m_Localized: 'FormerFema: Ekelhaft, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507358
    m_Localized: 'FormerFema: Das passiert, wenn man im Anzug schwitzt. Die Haut reißt, manchmal fault sie sogar. Aber mir ist schon Schlimmeres passiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507359
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507360
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507361
    m_Localized: 'FormerFema: Ich muss dich warnen ... Es könnte ... ungewöhnlich aussehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507362
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507363
    m_Localized: 'FormerFema: Mir wurde gesagt, dass man eine merkwürdige Aura bekommt, wenn man beruflich viel mit Besuchern zu tun hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507364
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507365
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507366
    m_Localized: 'FormerFema: Soll das ein Witz sein? Das war aber nicht Teil der Ausbildung. Zumindest nicht in unserer Abteilung.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507367
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507368
    m_Localized: 'FormerFema: Ein ganz normales Ohr. Du verschwendest deine Zeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507369
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507370
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507371
    m_Localized: 'FormerFema: Warte, warte. Mit meinen Zähnen ist alles in Ordnung. Was soll das?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507372
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507373
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507374
    m_Localized: 'FormerFema: Soll ich wirklich die Handschuhe ausziehen? Dann muss ich mich vorbereiten ... Auf die Schnelle geht das nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507375
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507376
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507377
    m_Localized: 'FormerFema: Diese Augen haben zu viel gesehen. Vielleicht ist es wirklich an der Zeit, sie zu schließen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507378
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507379
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507380
    m_Localized: 'FormerFema: Ich weiß, das macht dir Angst, aber hör mir zu ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507381
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507382
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507383
    m_Localized: 'FormerFema: Ich habe dich gewarnt. Mach erst ein Foto von deiner eigenen Aura, bevor du deine Waffe auf mich richtest ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507384
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507385
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507386
    m_Localized: 'FormerFema: Ist dir klar, dass du nach den falschen Dingen suchst?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507387
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507388
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507389
    m_Localized: 'FormerFema: Ich kann das nicht vergessen. Anstatt gründlich zu prüfen, einfach nur ... bumm, und weg war er. Vielleicht war er gar kein Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507390
    m_Localized: 'FormerFema: Seitdem pfeife ich auf Zahnpflege, nur für alle Fälle ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507391
    m_Localized: 'FormerFema: Tagelang in diesem Anzug. Hitze, Schweiß, faulig riechende Hände ... und man kann ihn nicht ausziehen. Dann wird es zur Gewohnheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507392
    m_Localized: 'FormerFema: Man zieht die Handschuhe aus und ... die Hände sind wie Fremdkörper.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507393
    m_Localized: 'FormerFema: Man läuft durchs Feuer und macht seine Arbeit. Plötzlich wird einem klar, dass man keine Menschen mehr sieht, sondern Silhouetten.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507394
    m_Localized: 'FormerFema: Dann Rauch, dann glühende Asche.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507395
    m_Localized: 'FormerFema: Dann ... nur noch Leere.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507396
    m_Localized: 'FormerFema: Manchmal arbeitet man sich kaputt. Man redet sich ein, dass die Vorgesetzten sich um einen kümmern, um seine Sicherheit. Aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507397
    m_Localized: 'FormerFema: In Wirklichkeit kümmert sich niemand um einen. Wenn man gut leben will, muss man dafür kämpfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507398
    m_Localized: 'FormerFema: Und wenn man nicht kämpft, gewöhnt man sich ans Leiden ... Es wird einfach normal und man lebt damit bis zum Ende ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507399
    m_Localized: 'FormerFema: Ich frage mich, warum du das alles tust. Warum lässt du Leute rein und verwendest deine Energie darauf, sie zu testen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507400
    m_Localized: 'FormerFema: Was, wenn du jemanden ins Herz schließt, der sich dann als Besucher entpuppt? Der Schmerz ... jemanden zu töten, den man mochte ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507401
    m_Localized: 'FormerFema: Man kann nicht alles glauben, was man sieht. Man muss alles kritisch hinterfragen. Lernen, Wahrheit und Lüge zu unterscheiden.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507402
    m_Localized: 'FormerFema: Das gilt vor allem fürs Fernsehen. Es steht völlig unter Kontrolle von diesen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507403
    m_Localized: 'FormerFema: Aber wem kann man überhaupt vertrauen? Warum ist diese Welt so kompliziert?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507404
    m_Localized: 'FormerFema: Wenn irgendjemand sie einfacher machen könnte, würde man ihn als Heiligen verehren. Ha ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507405
    m_Localized: 'FormerFema: Warte, du machst da einen Fehler!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507406
    m_Localized: 'FormerFema: ICH BIN VON DER FEMA!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507407
    m_Localized: 'Intruder: Hmm. Mal sehen, was sich über Nacht geändert hat.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507408
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507409
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507410
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507411
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507412
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507413
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507414
    m_Localized: 'Intruder: Ja. Ich zeig’s Ihnen sofort.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507415
    m_Localized: 'Intruder: Ich bin so müde, dass ich ständig Sachen vergesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507416
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507417
    m_Localized: 'Intruder: Manche Dinge darf man einfach nicht so eng sehen. Dann erscheint alles ein bisschen normaler.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507418
    m_Localized: 'Intruder: Ich bin so müde, dass ich ständig Sachen vergesse. Aber meine Zähne pflege ich nach wie vor.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507420
    m_Localized: 'Intruder: Man darf seinen eigenen Körper nicht vernachlässigen. Dann erscheint alles ein bisschen normaler.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507421
    m_Localized: 'Intruder: Ich frage mich, ob Sie einen Besucher an seinen Träumen erkennen können.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507422
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507423
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507424
    m_Localized: 'Intruder: Um das Ziel zu erreichen, sind wir bereit, alle Barrieren niederzureißen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507425
    m_Localized: 'Intruder: Vielleicht bahne ich mir gerade meinen Weg in meinen eigenen Traum?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507426
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507427
    m_Localized: 'Intruder: Gegen wen kämpfe ich eigentlich?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507428
    m_Localized: 'Intruder: Ich muss die Träume sehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507429
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507430
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507431
    m_Localized: 'Intruder: Ich habe irgendwo gehört, dass Schlaflosigkeit die Augen dunkel macht.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507432
    m_Localized: 'Intruder: Ich frage mich, ob das stimmt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507433
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507434
    m_Localized: 'Intruder: Hmm. Ja ... Früher waren sie heller. Jetzt sind sie richtig rot geworden.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507435
    m_Localized: 'Intruder: Ich habe übrigens seit ... langer Zeit nicht mehr geschlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507436
    m_Localized: 'Intruder: Warum sind meine Augen gar nicht rot?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507437
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507438
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507439
    m_Localized: 'Intruder: Aus irgendeinem Grund tut es weh, als wäre die Haut irgendwie gereizt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507440
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507441
    m_Localized: 'Intruder: Und? Nicht gut?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507442
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507443
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507444
    m_Localized: 'Intruder: Ich bin gespannt auf das Foto.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507445
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507446
    m_Localized: 'Intruder: Ah, das ist also kein normales Foto, sondern hat eine Art Aura?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507447
    m_Localized: 'Intruder: Irgendwie ... leer.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507448
    m_Localized: 'Intruder: Sind Sie sicher, dass dieses Ding funktioniert?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507449
    m_Localized: 'Intruder: Ich meine ... gibt es überhaupt so was wie eine Aura? Haben Sie schon mal eine gesehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507450
    m_Localized: 'Intruder: Träume existieren. Zumindest früher. Aber eine Aura ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507451
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507452
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507453
    m_Localized: 'Intruder: Hm? Davon habe ich noch gar nichts gehört.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507454
    m_Localized: 'Intruder: Na dann, probieren wir es aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507455
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507456
    m_Localized: 'Intruder: Na, wie lautet das Urteil?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507457
    m_Localized: 'Intruder: Wissen Sie überhaupt, wonach Sie suchen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507458
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507459
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507460
    m_Localized: 'Intruder: Wissen Sie, ich habe so lange nicht geschlafen, dass ich nicht weiß, ob das hier alles nur ein Traum ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507461
    m_Localized: 'Intruder: Das würde jedenfalls einiges erklären.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507462
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507463
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507464
    m_Localized: 'Intruder: Oh. Interessant. Wenn die Leute noch Träume hätten, könnte ich dann in einen fremden Traum flüchten?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507465
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507466
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507467
    m_Localized: 'Intruder: Ich suche nach einer Gelegenheit zum Schlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507468
    m_Localized: 'Intruder: Ich fühl mich so träge, aber meine Augen werden immer wacher.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507469
    m_Localized: 'Intruder: Moment mal, habe ich diese Besuchermerkmale aus dem Fernsehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507470
    m_Localized: 'Intruder: Was hat Sie so misstrauisch gemacht?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507471
    m_Localized: 'Intruder: Ich verstehe nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507472
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507473
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507474
    m_Localized: 'Intruder: Was? Wirklich?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507475
    m_Localized: 'Intruder: Der Schlafmangel trocknet meinen Körper aus. Geht es Ihnen nicht genauso?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507476
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507477
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507478
    m_Localized: 'Intruder: Ich habe ein paar Fragen zu dieser Sache.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507479
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507480
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507481
    m_Localized: 'Intruder: Könnten Sie den Körper dann erschießen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507482
    m_Localized: 'Intruder: So, dass ich nicht in ihn zurückkehren kann, wenn ich aufwache.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507483
    m_Localized: 'Intruder: Und der Körper liegt dann einfach rum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507484
    m_Localized: 'Intruder: Ich gebe mich einfach eine Weile dem Tod hin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507485
    m_Localized: 'Intruder: Ich komme schon ohne ihn zurecht.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507486
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507487
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507488
    m_Localized: 'Intruder: Wäre es nicht sinnvoller, wenn Besucher schmutzige Zähne hätten?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507489
    m_Localized: 'Intruder: Wenn sie aus dem Untergrund kriechen, könnten sie sich doch durch die Erde beißen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507490
    m_Localized: 'Intruder: Warum dachten Sie, dass ich schmutzige Fingernägel habe?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507491
    m_Localized: 'Intruder: Ich versuche nur verzweifelt, in einen Traum zu gelangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507492
    m_Localized: 'Intruder: Wenn ich es schaffe, tue ich mir selbst nicht mehr weh.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507493
    m_Localized: 'Intruder: Es würde seine Bedeutung verlieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507494
    m_Localized: 'Intruder: Nein ... wirklich. Warum werden die Augen dunkler?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507495
    m_Localized: 'Intruder: Trocknen sie nicht aus und ermüden, wenn sie dauernd angestrengt werden? Sie sollten wahrscheinlich eher glasig werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507496
    m_Localized: 'Intruder: Nein ... wirklich. Warum sind die Augen nicht rot?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507497
    m_Localized: 'Intruder: Trocknen sie nicht aus und ermüden, wenn sie dauernd angestrengt werden?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507498
    m_Localized: 'Intruder: Und ich habe schon lange nicht mehr geträumt. Was ist an dieser Logik falsch?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507499
    m_Localized: 'Intruder: Das hat also niemand?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507500
    m_Localized: 'Intruder: Wenn man lange nicht schläft, spürt man eine Kälte ... und nach einer Weile Trockenheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507501
    m_Localized: 'Intruder: Und irgendwann bekommt man eine Art Fieber.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507502
    m_Localized: 'Intruder: Und es wird immer schlimmer.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507503
    m_Localized: 'Intruder: Wo haben Sie von diesem Merkmal gehört?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507504
    m_Localized: 'Intruder: Ah, im Fernsehen. Seltsam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507505
    m_Localized: 'Intruder: Ich ... Ich weiß nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507506
    m_Localized: 'Intruder: Alles andere kann ich verstehen, aber die Aura ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507507
    m_Localized: 'Intruder: Es macht mir Angst, wie viele Leute sich in letzter Zeit mit übernatürlichem Zeug beschäftigen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507508
    m_Localized: 'Intruder: Wir haben ja noch nicht mal die natürlichen Dinge verstanden.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507509
    m_Localized: 'Intruder: Es war ein interessanter Bericht. An der Grenze zwischen Traum und Wirklichkeit.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507510
    m_Localized: 'Intruder: Sind Sie sicher, dass Sie den Bericht auch wirklich gesehen haben?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507511
    m_Localized: 'Intruder: Vielleicht war es nur ein Traum.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507512
    m_Localized: 'Intruder: Wobei ... ich es verstehen würde. Seltsam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507513
    m_Localized: 'Intruder: Irgendwie komisch, wie Sie wegen irgendwas einfach beschlossen haben, jemanden zu töten.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507514
    m_Localized: 'Intruder: Oder vielleicht eher unheimlich als komisch.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507515
    m_Localized: 'Intruder: Keine Träume. Die Leute sind verrückt geworden. Ich werde sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507516
    m_Localized: 'Intruder: Oder einschlafen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507517
    m_Localized: 'Cultist1: Der Tod wird uns mit seinen kalten Händen wärmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507518
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507519
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507520
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507521
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507522
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507523
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507524
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507525
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507526
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507527
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507528
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507529
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507530
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507531
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507532
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507533
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507534
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507535
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507536
    m_Localized: 'Cultist1: Ich bin es leid, mich vorzubereiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507537
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507538
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507539
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507540
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507541
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507542
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507543
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507544
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507545
    m_Localized: 'Cultist1: Warum auch nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507546
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507547
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507548
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507549
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507550
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507551
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507552
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507553
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507554
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507555
    m_Localized: 'Cultist1: Es ist noch nicht so weit.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507556
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507557
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507558
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507559
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507560
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507561
    m_Localized: 'Cultist1: Das sollten Sie nicht tun.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507562
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507563
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507564
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507565
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507566
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507567
    m_Localized: 'Cultist1: Lieber nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507568
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507569
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507570
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507571
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507572
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507573
    m_Localized: 'Cultist1: Warum machen Sie sich die Mühe mit diesen Tests?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507574
    m_Localized: 'Cultist1: Seien Sie einfach bereit zu gehen, wenn die Zeit gekommen ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507575
    m_Localized: 'Cultist1: Ich weiß nicht, worauf Sie warten.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507576
    m_Localized: 'Cultist1: Ich habe nichts zu sagen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507577
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507578
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507579
    m_Localized: 'Cultist1: Ich wurde schon lange nicht mehr fotografiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507580
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507581
    m_Localized: 'Cultist1: Sie werden für Ihre Taten geradestehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507582
    m_Localized: 'Cultist1: Es war ein Fehler.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507583
    m_Localized: 'Cultist2: Es gibt keinen Grund, Angst zu haben. Uns alle erwartet ein besseres Leben. Wir werden gerettet.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507584
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507585
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507586
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507587
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507588
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507589
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507590
    m_Localized: 'Cultist2: Ja, natürlich.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507591
    m_Localized: 'Cultist2: Ein bisschen schief ... und vielleicht ein bisschen größer als normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507592
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507593
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507594
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507595
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507596
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507597
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507598
    m_Localized: 'Cultist2: Ja ... Unser Leben ist voller Strapazen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507599
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507600
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507601
    m_Localized: 'Cultist2: Wir schlafen nicht viel.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507602
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507603
    m_Localized: 'Cultist2: Man sagt, das bringt den Tod näher.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507604
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507605
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507606
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507607
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507608
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507609
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507610
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507611
    m_Localized: 'Cultist2: Ich wurde noch nie fotografiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507612
    m_Localized: 'Cultist2: Ich bin ... ein wenig nervös.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507613
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507614
    m_Localized: 'Cultist2: Wie ... interessant.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507615
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507616
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507617
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507618
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507619
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507620
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507621
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507622
    m_Localized: 'Cultist2: Oh. Ich dachte nicht, dass es mir so viel Angst machen würde.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507623
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507624
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507625
    m_Localized: 'Cultist2: Es ist zu früh ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507626
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507627
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507628
    m_Localized: 'Cultist2: Lassen Sie mich noch ein wenig leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507629
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507630
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507631
    m_Localized: 'Cultist2: Oh ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507632
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507633
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507634
    m_Localized: 'Cultist2: Ich habe gerade erst eine neue Erfahrung gemacht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507635
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507636
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507637
    m_Localized: 'Cultist2: Uns wurde nicht gesagt, dass die Zeit gekommen ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507638
    m_Localized: 'Cultist2: Tun Sie das nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507639
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507640
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507641
    m_Localized: 'Cultist2: Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507642
    m_Localized: 'Cultist2: Uns wird gesagt, dass nach dem Tod sämtliches Leiden endet.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507643
    m_Localized: 'Cultist2: Ich hoffe wirklich, dass es stimmt ... Ich habe schon genug gelitten, ich muss mich ausruhen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507644
    m_Localized: 'Cultist2: Ja, sie bringen uns bei, dass nach diesem Leben ein Leben der Ruhe wartet.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507645
    m_Localized: 'Cultist2: Aber Sie wissen nicht, wie entsetzlich es ist, wenn man weiß, dass man bald sterben wird.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507646
    m_Localized: 'Cultist2: Aus irgendeinem Grund ... ist das furchtbar peinlich. Obwohl mit meinen Achselhöhlen alles in Ordnung ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507647
    m_Localized: 'Cultist2: Selbst das Wort auszusprechen, fühlt sich komisch an.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507648
    m_Localized: 'Cultist2: Ah, das ist nicht nur ein gewöhnliches Foto.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507649
    m_Localized: 'Cultist2: Ich verstehe das nicht. Aber es sieht wunderschön aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507650
    m_Localized: 'Cultist2: Danke, dass Sie es mir gezeigt haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507651
    m_Localized: 'Cultist2: So viele Möglichkeiten, einen Besucher zu erkennen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507652
    m_Localized: 'Cultist2: Warum wurden dann nicht schon alle erwischt?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507653
    m_Localized: 'Cultist2: Alles wird gut ... Wir werden beschützt ... Ein besseres Leben erwartet mich ... Alles wird gut ... Es gibt nichts zu befürchten ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507654
    m_Localized: 'Cultist2: Sch-Scheiße ... Ich hab Angst!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507655
    m_Localized: 'Cultist3: Tun Sie, was Sie nicht lassen können. Aber stehen Sie uns nicht im Weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507656
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507657
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507658
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507659
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507660
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507661
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507662
    m_Localized: 'Cultist3: Ich finde es amüsant, wie unterschiedlich Ober- und Unterkiefer sein können.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507663
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507664
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507665
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507666
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507667
    m_Localized: 'Cultist3: Dadurch sehen wir aus wie Fremde.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507668
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507669
    m_Localized: 'Cultist3: Das sollte den Tod anlocken. Und uns retten.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507670
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507671
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507672
    m_Localized: 'Cultist3: Meine Augen können fast nichts mehr sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507673
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507674
    m_Localized: 'Cultist3: Vielleicht werde ich meinen Brüdern vorausgehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507675
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507676
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507677
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507678
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507679
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701376
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701377
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701378
    m_Localized: 'Cultist3: Augenblick, das Gewand ist im Weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701379
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701380
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701381
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701382
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701383
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701384
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701385
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701386
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701387
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701388
    m_Localized: 'Cultist3: Stehen Sie uns nicht im Weg. Bitte.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701389
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701390
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701391
    m_Localized: 'Cultist3: Sie sind verwirrt. Legen Sie die Waffe lieber weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701392
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701393
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701394
    m_Localized: 'Cultist3: Greifen Sie nicht in den Ablauf ein.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701395
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701396
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701397
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701398
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701399
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701400
    m_Localized: 'Cultist3: Was hat Sie auf die Idee gebracht, dass es besser ist, mich zu töten?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701401
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701402
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701403
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701404
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701405
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701406
    m_Localized: 'Cultist3: Ich habe alles gezeigt. Jetzt werde ich mich vorbereiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701407
    m_Localized: 'Cultist3: Lassen Sie jeden seine eigene Arbeit tun.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701408
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701409
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701410
    m_Localized: 'Cultist3: Fotos haben keinerlei Bedeutung.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701411
    m_Localized: 'Cultist3: Alles, was wichtig ist, bleibt in der Erinnerung.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701412
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701413
    m_Localized: 'Cultist3: Tun Sie das lieber nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701414
    m_Localized: 'Cultist3: Man wird Sie verbrennen, und doch bleibt Ihnen der Tod verwehrt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701415
    m_Localized: 'FatalDame: Spürst du jemals diese Angst, dass derjenige, der vor dir steht, vielleicht kein Mensch ist?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701416
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701417
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701418
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701419
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701420
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701421
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701422
    m_Localized: 'FatalDame: Gefällt dir, was du siehst?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701423
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701424
    m_Localized: 'FatalDame: Warum dieser Blick? Hast du schon mal solche Zähne gesehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701425
    m_Localized: 'FatalDame: Habe ich dich an jemanden erinnert?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701426
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701427
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701428
    m_Localized: 'FatalDame: Man sagt, es gäbe nichts Schöneres, als die Hand eines geliebten Menschen zu halten.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701429
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701430
    m_Localized: 'FatalDame: Man spürt einen Puls.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701431
    m_Localized: 'FatalDame: Was verraten verschwitzte Hände? Nervosität? Überwältigende Emotionen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701432
    m_Localized: 'FatalDame: Oder einfach nur blinde Wut?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701433
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701434
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701435
    m_Localized: 'FatalDame: Augen verraten eine Menge über die Gedanken.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701436
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701437
    m_Localized: 'FatalDame: Na, was glaubst du, woran ich gerade denke?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701438
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701439
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701440
    m_Localized: 'FatalDame: Natürlich. Sieh ruhig nach. Ich kann dich nicht daran hindern.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701441
    m_Localized: 'FatalDame: Der Körper dankt es einem, wenn man ihn pflegt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701442
    m_Localized: 'FatalDame: Ich bin froh, dass wir beide das verstehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701443
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701444
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701445
    m_Localized: 'FatalDame: Tut mir leid, aber das raubt mir nur die Nerven.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701446
    m_Localized: 'FatalDame: Bringen wir es schnell hinter uns.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701447
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701448
    m_Localized: 'FatalDame: Was hast du mit dem Foto vor?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701449
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701450
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701451
    m_Localized: 'FatalDame: Ist das dein Fetisch?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701452
    m_Localized: 'FatalDame: Das macht mir nichts aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701453
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701454
    m_Localized: 'FatalDame: Aber warum bist du so fasziniert von Ohren? Was gefällt dir an ihnen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701455
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701456
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701457
    m_Localized: 'FatalDame: Siehst du in mir die Person, die dich verletzt hat?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701458
    m_Localized: 'FatalDame: Warum lässt du es an mir aus? Wir sind uns doch gerade erst begegnet.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701459
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701460
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701461
    m_Localized: 'FatalDame: Es ist also Wut.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701462
    m_Localized: 'FatalDame: Wessen Schatten siehst du in mir? An wem willst du dich rächen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701463
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701464
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701465
    m_Localized: 'FatalDame: Was mir Angst macht, ist das Fehlen von Zweifel in deinen Augen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701466
    m_Localized: 'FatalDame: Du hältst dich an ein starres Muster. Aber wir Menschen ... Wir hinterfragen, wir zweifeln, wir suchen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701467
    m_Localized: 'FatalDame: Du hältst dich an ein starres Muster. Hast du es dir selbst ausgedacht?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701468
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701469
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701470
    m_Localized: 'FatalDame: Hast du Angst vor Schönheit? Weil sie unzuverlässig wirkt? Oder ist es etwas anderes?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701471
    m_Localized: 'FatalDame: Hältst du schöne Menschen für gefährlich? Was könnte ich dir schon antun?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701472
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701473
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701474
    m_Localized: 'FatalDame: Höre ich da ein sadistisches Vergnügen?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701475
    m_Localized: 'FatalDame: Wie romantisch, Fotos von seinen Opfern aufzubewahren.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701476
    m_Localized: 'FatalDame: Ich frage mich, ob ich nicht die Erste bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701477
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701478
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701479
    m_Localized: 'FatalDame: Tut mir leid ... Ich verstehe dich nicht mehr. Was ist los?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701480
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701481
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701482
    m_Localized: 'FatalDame: Es ist besser, schmerzhafte Erinnerungen loszulassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701483
    m_Localized: 'FatalDame: Es bringt nichts, sich jedes Mal zu quälen, wenn sie ausgelöst werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701484
    m_Localized: 'FatalDame: Tu, was ich getan habe. Nicht sofort ... aber mit der Zeit fühlst du dich leichter.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701485
    m_Localized: 'FatalDame: Ich weiß, dass du dich schützen willst. Deine Grenzen verteidigen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701486
    m_Localized: 'FatalDame: Aber ich bitte dich, auch meine Grenzen zu respektieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701487
    m_Localized: 'FatalDame: Projiziere deine Vergangenheit nicht auf mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701488
    m_Localized: 'FatalDame: Schon komisch, wie viele Menschen sich nicht mehr gegenseitig in die Augen sehen können.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701489
    m_Localized: 'FatalDame: Manche sehen weg, manche suchen nach Antworten und manche prüfen einfach nur auf Merkmale von Besuchern.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701490
    m_Localized: 'FatalDame: Manche sehen weg, manche prüfen einfach nur auf Merkmale von Besuchern.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701491
    m_Localized: 'FatalDame: Aber du ... Du siehst einen aufmerksam an.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701492
    m_Localized: 'FatalDame: Das ist interessant.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701493
    m_Localized: 'FatalDame: Ich verstehe, dass du Angst um dich selbst und um andere hast.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701494
    m_Localized: 'FatalDame: Der Gedanke, dass man den Tod eines anderen verursachen könnte, ist furchtbar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701495
    m_Localized: 'FatalDame: Aber es ist nur menschlich, sich verletzt zu fühlen, wenn jemand mit der Waffe auf einen zielt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701496
    m_Localized: 'FatalDame: Ich glaube, du hast eine besondere Eigenschaft. Oder vielleicht gibt es ein besseres Wort dafür ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701497
    m_Localized: 'FatalDame: Du liebst die Menschen nicht so, wie du die Erinnerung an sie liebst.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701498
    m_Localized: 'FatalDame: Ich wette, du hast jede Menge Fotos. Aber du wahrst Distanz zu anderen Menschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701499
    m_Localized: 'FatalDame: Hm. Nein, vergiss es. Tut mir leid. Beachte mich gar nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701500
    m_Localized: 'FatalDame: Ja, in diesen Zeiten ist es schwer, Wahrheit und Lüge zu unterscheiden.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701501
    m_Localized: 'FatalDame: Aber ... du musst für dich selbst entscheiden, was wahr ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701502
    m_Localized: 'FatalDame: Vor lauter Angst vor Veränderung hältst du alle auf Distanz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701503
    m_Localized: 'FatalDame: Fremde. Familie. Geliebte Menschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701504
    m_Localized: 'FatalDame: ... Was wird aus dir werden?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313600
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313601
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313602
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313603
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313604
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313605
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313606
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722172313607
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090816
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090817
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090818
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090819
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090820
    m_Localized: 'Esenin: Was fuchteln Sie so mit der Waffe rum?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090821
    m_Localized: 'Esenin: Wenn Sie vollkommen irre sind, dann schießen Sie einfach. Aber hören Sie auf mit dem Quatsch.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090822
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090823
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090824
    m_Localized: 'Esenin: Ach, du Scheiße ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090825
    m_Localized: 'Esenin: Lassen Sie mich raten. Wenn ich keinen Dreck unter den Fingernägeln habe, ist es meine Körpergröße, die Ihnen Angst macht?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090826
    m_Localized: 'Esenin: Finden Sie, dass jeder großgewachsene Mensch umgebracht werden sollte?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090827
    m_Localized: 'Esenin: Hauen Sie bloß ab mit Ihrer blödsinnigen Ideologie.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090828
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090829
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090830
    m_Localized: 'Esenin: Und wie zur Hölle sind Sie darauf gekommen?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090831
    m_Localized: 'Esenin: Meine Zähne waren in Ordnung. Meine Hände auch. Und jetzt überprüfen Sie meine Augen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090832
    m_Localized: 'Esenin: Wenn Sie mich nicht mögen, sagen Sie es einfach. Dann gehe ich. So stolz bin ich nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090833
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090834
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090835
    m_Localized: 'Esenin: Was jetzt, soll ich mich für Sie bücken?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090836
    m_Localized: 'Esenin: Wie zur Hölle soll ich das ertragen?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090837
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090838
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090839
    m_Localized: 'Esenin: Ernsthaft.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090840
    m_Localized: 'Esenin: Sehen Sie nicht, was in diesem Haus passiert?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090841
    m_Localized: 'Esenin: Sie verheddern sich in bedeutungslosem Unsinn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090842
    m_Localized: 'Esenin: Und dann töten Sie Leute, als wäre nichts dabei.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090843
    m_Localized: 'Esenin: Denken Sie doch mal darüber nach, was Sie da machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090844
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090845
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090846
    m_Localized: Scheiße, diese ganzen Berichte ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090847
    m_Localized: 'Esenin: Und der verdammte Staat ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090848
    m_Localized: 'Esenin: So „kümmern“ sie sich um uns.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090849
    m_Localized: 'Esenin: Erbärmlich ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090850
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090851
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090852
    m_Localized: 'Esenin: Wissen Sie was? Fahren Sie zur Hölle.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090853
    m_Localized: 'Esenin: Ich habe Sie und Ihre Waffe satt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090854
    m_Localized: 'Esenin: Als ob es mir gefallen würde, so groß zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090855
    m_Localized: 'Esenin: Ständig stoße ich mir den Kopf an. In Bussen ist es am schlimmsten.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090856
    m_Localized: 'Esenin: Aber es gibt auch Vorteile.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090857
    m_Localized: 'Esenin: Einmal habe ich gesehen, wie ein Typ von einem Truck überrollt wurde.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090858
    m_Localized: 'Esenin: Und der Truck ist nicht mal schnell gefahren, verstehen Sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090859
    m_Localized: 'Esenin: Er steckte im Verkehr fest. Der Typ lief direkt vor dem Truck über die Straße.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090860
    m_Localized: 'Esenin: Im toten Winkel.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090861
    m_Localized: 'Esenin: Dann fuhr der Truck an und überrollte ihn ... GAAANZ langsam.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090862
    m_Localized: 'Esenin: Gruselige Geschichte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090863
    m_Localized: 'Esenin: Zumindest werde ich nicht so lächerlich abtreten.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090864
    m_Localized: 'Esenin: Scheiße ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090865
    m_Localized: 'Esenin: Waren Sie jemals in einer Bar?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090866
    m_Localized: 'Esenin: Vor diesem ganzen Mist mit den Besuchern gab es viele Leute mit den gleichen „Merkmalen“. Rote Augen, dreckige Hände, sogar perfekte Zähne!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090867
    m_Localized: 'Esenin: Und wissen Sie was?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090868
    m_Localized: 'Esenin: Manche davon sind gestorben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090869
    m_Localized: 'Esenin: Aber darum geht es nicht. Es geht darum, dass Sie sich mit solchen Mätzchen eine Tracht Prügel abgeholt hätten.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090870
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090871
    m_Localized: 'Esenin: Ich verstehe nicht, wie Sie überhaupt mit einer Waffe auf jemanden zielen können.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090872
    m_Localized: 'Esenin: Das ist vollkommen verrückt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090873
    m_Localized: 'Esenin: Sie sind völlig durchgedreht.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090874
    m_Localized: 'Esenin: Hauen Sie ab, verstanden?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090875
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090876
    m_Localized: 'Esenin: Danke?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090877
    m_Localized: 'Esenin: Oder was?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090878
    m_Localized: 'Esenin: Überall gibt es nur noch Heulsusen oder Psychos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090879
    m_Localized: 'Esenin: Und dann soll man auch noch nüchtern bleiben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090880
    m_Localized: 'Esenin: Also ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722189090881
    m_Localized: 'Esenin: Scheiße ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285120
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285121
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285122
    m_Localized: 'Daughter: Ich gebe auf, ich gebe auf!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285123
    m_Localized: 'Daughter: Du hast gewonnen!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285124
    m_Localized: 'Daughter: Ich weiß gar nicht, was das für ein Spiel ist!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285125
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285126
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285127
    m_Localized: 'Daughter: Papa hat mir mal von so einem Spiel erzählt!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285128
    m_Localized: 'Daughter: Also, äh, man teilt sich in zwei Gruppen auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285129
    m_Localized: 'Daughter: Die eine Gruppe versteckt einen Schatz und malt ein Gefängnis, in das sie die Leute aus der anderen Gruppe steckt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285130
    m_Localized: 'Daughter: Und die anderen müssen entweder die andere Gruppe besiegen oder den Schatz finden!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285131
    m_Localized: 'Daughter: Und alle haben Waffen!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285132
    m_Localized: 'Daughter: Aber Papa hat gesagt, dass sie Stöcke benutzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285133
    m_Localized: 'Daughter: Oh! Ich erinnere mich! Es hieß „Räuber und Gendarm“!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285134
    m_Localized: 'Daughter: Hast du das auch gespielt, als du klein warst? Und jetzt spielst du es mit mir?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285135
    m_Localized: 'Daughter: Oh ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285136
    m_Localized: 'Daughter: Aber ich hab den Schatz noch gar nicht versteckt!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285137
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285138
    m_Localized: 'Daughter: Und ich hab auch gar nichts, was ich verstecken könnte ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285139
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285140
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285141
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285142
    m_Localized: 'Daughter: Ich mag dieses Spiel nicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285143
    m_Localized: 'Daughter: Kannst du bitte aufhören, mir Angst zu machen?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285144
    m_Localized: 'Daughter: Ich hab dir meine Fingernägel gezeigt!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285145
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285146
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285147
    m_Localized: 'Daughter: Ich mochte Mamas Fingernägel.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285148
    m_Localized: 'Daughter: Aber ich kann mich gar nicht mehr richtig an sie erinnern.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285149
    m_Localized: 'Daughter: Ich weiß nur noch, dass sie hübsch waren.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285150
    m_Localized: 'Daughter: Und sie hatte ein richtig schönes Kleid!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285151
    m_Localized: 'Daughter: So wie meins!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285152
    m_Localized: 'Daughter: Papa sagt, dass ich genauso schön bin wie Mama!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285153
    m_Localized: 'Daughter: Papa ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285154
    m_Localized: 'Daughter: Nein, ich werde nicht weinen. Ich bin ein großes Mädchen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285155
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285156
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285157
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285158
    m_Localized: 'Daughter: Bitteeeee!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285159
    m_Localized: 'Daughter: Ich steeeerbeeee!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285160
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285161
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285162
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285163
    m_Localized: 'Daughter: Einmal war ich auf einem Spielplatz, der richtig weit weg war!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285164
    m_Localized: 'Daughter: Und da war die größte Rutsche der Welt!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285165
    m_Localized: 'Daughter: So eine hatte ich noch nie gesehen!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285166
    m_Localized: 'Daughter: Und ich hatte überhaupt keine Angst. Kein bisschen! Das hat so viel Spaß gemacht!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285167
    m_Localized: 'Daughter: Ich bin so oft hochgeklettert, dass ich ganz durstig war. Ich hätte einen ganzen See trinken können. Nein, ein ganzes Meer!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285168
    m_Localized: 'Daughter: Aber dann hat Papa sich verirrt. Er ist irgendwo hingegangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285169
    m_Localized: 'Daughter: Und ich hatte solche Angst, dass ich ohne ihn sterbe!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285170
    m_Localized: 'Daughter: Ich wusste nicht mal, wie ich nach Hause kommen sollte, wir waren so weit weg!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285171
    m_Localized: 'Daughter: Aber dann ist Papa zurückgekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285172
    m_Localized: 'Daughter: Ich hoffe, dass er diesmal auch zurückkommt. Er hat sich einfach nur verirrt. Ja ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285173
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285174
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285175
    m_Localized: 'Daughter: Oh, einmal hab ich einen Zeichentrickfilm gesehen!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285176
    m_Localized: 'Daughter: Da war ein Hund mit einer Waffe, und wenn er abgedrückt hat, hat sie Fotos gemacht!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285177
    m_Localized: 'Daughter: Ist deine Waffe auch so?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722193285178
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479424
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479425
    m_Localized: 'Daughter: ... Wahrscheinlich nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479426
    m_Localized: 'Daughter: Oh, mir ist noch was anderes eingefallen!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479427
    m_Localized: 'Daughter: Einmal bin ich mit Papa zum Markt gegangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479428
    m_Localized: 'Daughter: Und dann hat ein Mann eine Waffe auf uns gerichtet.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479429
    m_Localized: 'Daughter: Er hatte lange Haare und einen langen Mantel.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479430
    m_Localized: 'Daughter: Papa hat Angst bekommen, aber dann haben sie sich umarmt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479431
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479432
    m_Localized: 'Daughter: Oder war das nur ein Traum?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479433
    m_Localized: 'Daughter: Ich weiß nicht meeeeehr ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479434
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479435
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479436
    m_Localized: 'Daughter: Oh ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479437
    m_Localized: 'Daughter: Ich sag dir noch was!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479438
    m_Localized: 'Daughter: Versuchst du, gemein zu mir zu sein?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479439
    m_Localized: 'Daughter: Meine beste Freundin ist manchmal genauso ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479440
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479441
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479442
    m_Localized: 'Daughter: Also, ich spiele mit meiner Freundin ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479443
    m_Localized: 'Daughter: Und dann macht sie auf einmal was Gemeines!'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479444
    m_Localized: 'Daughter: Aber eigentlich ist sie nett, das weiß ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479445
    m_Localized: 'Daughter: Sie hat es zu Hause schwer. Ihre Mama ist superstreng.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479446
    m_Localized: 'Daughter: Sie darf nicht viel machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479447
    m_Localized: 'Daughter: Vielleicht ist ihre Mama eine Besucherin?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479448
    m_Localized: 'Daughter: Vielleicht ist ihre Mama eine Besucherin?'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479449
    m_Localized: 'Daughter: Ich gehe zu ihr, sobald Papa mich abholt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479450
    m_Localized: 'Daughter: Papa ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722197479451
    m_Localized: Mama ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062336
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062337
    m_Localized: Ich muss mich selbst testen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062338
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062339
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062340
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722210062341
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450944
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450945
    m_Localized: Waschen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450946
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450947
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450948
    m_Localized: Scheiße. Weiß ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450949
    m_Localized: Raucher würden dafür töten
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450950
    m_Localized: Gelbe Zähne ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450951
    m_Localized: Besser so, dann hält mich niemand für einen Besucher
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450952
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450953
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450954
    m_Localized: Schmutzige Fingernägel ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450955
    m_Localized: Weil ich diese verdammte Höhle gegraben habe
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450956
    m_Localized: Saubere Hände ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450957
    m_Localized: Ein paar Schmauchspuren, sonst nichts
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450958
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450959
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450960
    m_Localized: Verdammt, sie sind rot ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450961
    m_Localized: Ich hätte diesen Koffeinmüll nicht trinken sollen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450962
    m_Localized: Die Augen sehen gut aus
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450963
    m_Localized: Nicht rot, so bin ich unverdächtig
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450964
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450965
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450966
    m_Localized: Haarige Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450967
    m_Localized: So, wie es sein soll
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450968
    m_Localized: Verdammt, was zur Hölle ist das!?
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450969
    m_Localized: Sieht aus wie ein Ausschlag, oder ein Pilz
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450970
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450971
    m_Localized: Ich muss mich waschen, vielleicht hilft das
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450972
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450973
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450974
    m_Localized: Die Ohren sehen gut aus
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450975
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450976
    m_Localized: Was war das überhaupt für ein Bericht?
    m_Metadata:
      m_Items: []
  - m_Id: 43886722218450977
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219577463595008
    m_Localized: 'Anger: Manchmal spanne ich meinen Kiefer so stark an, dass ich ihn knacken höre.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577476177920
    m_Localized: 'Anger: Das macht mich ganz wahnsinnig ... aber ich erwische mich jedes Mal zu spät dabei.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577501343744
    m_Localized: 'Alkonost: Meine Schwester ... Warum?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577501343745
    m_Localized: 'Alkonost: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577501343746
    m_Localized: 'Alkonost: Was bringt es überhaupt noch, irgendwas zu machen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577501343747
    m_Localized: 'Alkonost: Schieß einfach.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577505538048
    m_Localized: 'Sirin: Der Tod hat meine Schwester geholt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577505538049
    m_Localized: 'Sirin: Wie ... Wie soll ich ohne sie weiterleben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577505538050
    m_Localized: 'Sirin: Ich bin bereit ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315264
    m_Localized: 'Jacob: Ich wusste, dass Sie das sagen würden.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315265
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315266
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315267
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315268
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315269
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315270
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315271
    m_Localized: 'Jacob: Na gut ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315272
    m_Localized: 'Jacob: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315273
    m_Localized: 'Jacob: Ich hatte in den letzten Wochen keine Gelegenheit, mir die Zähne zu putzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315274
    m_Localized: 'Jacob: Glück gehabt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315275
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315276
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315277
    m_Localized: 'Jacob: Hände? Wirklich?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315278
    m_Localized: 'Jacob: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315279
    m_Localized: 'Jacob: Tut mir leid, ich habe in letzter Zeit viel im Dreck gewühlt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315280
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315281
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315282
    m_Localized: 'Jacob: Ich habe seit Tagen nicht geschlafen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315283
    m_Localized: 'Jacob: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315284
    m_Localized: 'Jacob: Es ist schwer zu schlafen, wenn man seine Tochter vermisst.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315285
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315286
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315287
    m_Localized: 'Jacob: Gibt es nichts anderes, was ich Ihnen zeigen kann?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315288
    m_Localized: 'Jacob: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315289
    m_Localized: 'Jacob: Werfen Sie einen Blick drauf.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315290
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315291
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315292
    m_Localized: 'Jacob: Zeigen Sie das bloß niemandem von der FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315293
    m_Localized: 'Jacob: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315294
    m_Localized: 'Jacob: ... Wissen Sie über Vampire Bescheid?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315295
    m_Localized: 'Jacob: Sie erscheinen nicht auf Fotos. Sie sind nachtaktiv und ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315296
    m_Localized: 'Jacob: Sie sind unsterblich.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315297
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315298
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315299
    m_Localized: 'Jacob: Finden Sie diese Tests nicht irgendwie albern?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315300
    m_Localized: 'Jacob: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315301
    m_Localized: 'Jacob: Ich verrate Ihnen ein Geheimnis: Ohrenschmalz ist ganz normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315302
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315303
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315304
    m_Localized: 'Jacob: Einen kleineren Zahnstocher haben Sie wohl nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315305
    m_Localized: 'Jacob: Sie wollen schießen? Nur zu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315306
    m_Localized: 'Jacob: Aber ich dachte, Sie könnten zuhören.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315307
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315308
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315309
    m_Localized: 'Jacob: Vorsicht mit diesem Ding.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315310
    m_Localized: 'Jacob: Ich bin unsterblich, aber wenn Sie den Abzug drücken ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315311
    m_Localized: 'Jacob: Dann rede ich kein Wort mehr mit Ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315312
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315313
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315314
    m_Localized: 'Jacob: Wenn Sie mich für einen Besucher halten, liegen Sie falsch.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315315
    m_Localized: 'Jacob: Ich bin unsterblich. Sie können mich nicht töten.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315316
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315317
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315318
    m_Localized: 'Jacob: Haben Sie den Verstand verloren?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315319
    m_Localized: 'Jacob: Wenn Sie abdrücken, erfahren Sie nichts mehr über die Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315320
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315321
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315322
    m_Localized: 'Jacob: Hoffentlich haben Sie Silberkugeln geladen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315323
    m_Localized: 'Jacob: Ansonsten verschwenden Sie nur Patronen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315324
    m_Localized: 'Jacob: Und den Rest meiner Geduld.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315325
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315326
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315327
    m_Localized: 'Jacob: Na los, drücken Sie ab, wenn Sie diesem Lügenapparat vertrauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315328
    m_Localized: 'Jacob: Aber das werde ich Ihnen nicht durchgehen lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315329
    m_Localized: 'Jacob: Ich warne Sie: Ich werde zurückkommen und Ihnen den Hals umdrehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315330
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315331
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315332
    m_Localized: 'Jacob: Wenn meine Zähne Sie so sehr stören ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315333
    m_Localized: 'Jacob: Dann putze ich sie eben nächstes Mal ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315334
    m_Localized: 'Jacob: Mit meinem Finger.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315335
    m_Localized: 'Jacob: Ich weiß, wie das aussieht.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315336
    m_Localized: 'Jacob: Aber wenn man hier draußen in diesem ganzen Mist wühlt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315337
    m_Localized: 'Jacob: Da hätte doch jeder dreckige Hände.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315338
    m_Localized: 'Jacob: Glauben Sie nicht alles, was im Fernsehen kommt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315339
    m_Localized: 'Jacob: Heutzutage ist es schwer, sauber zu bleiben.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315340
    m_Localized: 'Jacob: Ich würde mir Ihre Augen ansehen, wenn Sie nicht schlaflose Nächte hinter sich hätten.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315341
    m_Localized: 'Jacob: Ich habe die halbe Stadt durchquert ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315342
    m_Localized: 'Jacob: Tagsüber habe ich mich vor der Sonne versteckt, nachts vor der FEMA und den Besuchern ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315343
    m_Localized: 'Jacob: Ich konnte nicht für einen einzigen Moment die Augen zumachen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315344
    m_Localized: 'Jacob: Achselhöhlen, was? Sehr vielsagend.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315345
    m_Localized: 'Jacob: Die FEMA ist komplett durchgedreht.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315346
    m_Localized: 'Jacob: Vielleicht lecken Sie den Besuchern inzwischen die Eier, um neue Merkmale zu finden?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315347
    m_Localized: 'Jacob: Sollen sie ruhig kommen. Sie dürfen gern meine probieren.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315348
    m_Localized: 'Jacob: Zielen Sie lieber nicht mehr mit der Waffe auf mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315349
    m_Localized: 'Jacob: Sonst könnte es für Sie übel ausgehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315350
    m_Localized: 'Jacob: Aber wenn Sie respektvoll sind ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315351
    m_Localized: 'Jacob: Dann bleibt Ihr Hals unversehrt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315352
    m_Localized: 'Jacob: Ich hoffe, Sie nehmen die FEMA-Typen genauso hart ran.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315353
    m_Localized: 'Jacob: Im Gegensatz zu den Besuchern gaukeln die einem keine Menschlichkeit vor ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315354
    m_Localized: 'Jacob: Das sind einfach nur Arschlöcher durch und durch.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315355
    m_Localized: 'Jacob: Sparen Sie sich Ihre Kugeln.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315356
    m_Localized: 'Jacob: Ich garantiere Ihnen, dass Sie für diese Bastarde mehr Munition verballern werden als für die Besucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315357
    m_Localized: 'Jacob: Mistkerl ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315358
    m_Localized: 'Jacob: Ich hätte Sie für schlauer gehalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315359
    m_Localized: 'Jacob: Ich wusste immer, dass ich wegen der Dummheit eines anderen sterben würde.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219577522315360
    m_Localized: Scheiß drauf.
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535907
    m_Localized: 'Blind:'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535940
    m_Localized: 'Blind:'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507419
    m_Localized: 'Intruder:'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341556
    m_Localized: 'Nun: Sie wurden zum Narren gehalten, und es macht Ihnen gar nichts aus, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535899
    m_Localized: 'Blind: Sie können mich testen, so viel Sie wollen. Aber ... nichts wird sich ändern. Das hier ist alles nur vorübergehend.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924201
    m_Localized: 'Fanatic: Ha! Was für einen Unsinn Sie da reden.'
    m_Metadata:
      m_Items: []
  - m_Id: 58333830346432512
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 58333830346432513
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 58333830400958464
    m_Localized: Waschen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535808
    m_Localized: 'Unstable: Alles klar. Lass mich nur meinen EnerJeka austrinken ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535809
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535810
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535811
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535812
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535813
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535814
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535815
    m_Localized: 'Unstable: Hab ich dir schon erzählt, dass ich EnerJeka schmecken kann, selbst wenn ich gar nicht trinke?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535816
    m_Localized: 'Unstable: Da scheinen irgendwelche krassen Chemikalien drin zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535817
    m_Localized: 'Unstable: Aber wen kümmert’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535818
    m_Localized: 'Unstable: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535819
    m_Localized: 'Unstable: Oh, Scheiße. Meine Zunge ist verfärbt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535820
    m_Localized: 'Unstable: Oh, Scheiße. Meine Zähne sind ruiniert.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535821
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535822
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535823
    m_Localized: 'Unstable: Die Hände also. Sicher doch.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535824
    m_Localized: 'Unstable: Manchmal juckt’s mich, als würden überall Ameisen rumkrabbeln ... Ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535825
    m_Localized: 'Unstable: Ich glaub nicht, dass ich an irgendwas rumgefummelt hab, also sollten meine Hände vorzeigbar sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535826
    m_Localized: 'Unstable: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535827
    m_Localized: 'Unstable: Hmm, hab sie wohl irgendwie verdreht.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535828
    m_Localized: 'Unstable: Hehe, zu viel Koffein. Das erklärt das Zittern.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535829
    m_Localized: 'Unstable: Gib mir zehn Minuten, vielleicht geht es dann weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535830
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535831
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535832
    m_Localized: 'Unstable: Ich hab den Bericht gesehen. Die Augen sollten so ein dunkles, trübes Grün haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535833
    m_Localized: 'Unstable: Aber nicht verwechseln, heutzutage gibt’s jede Menge Arten von Grün auf der Welt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535834
    m_Localized: 'Unstable: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535835
    m_Localized: 'Unstable: Moment, was ist los?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535836
    m_Localized: 'Unstable: ROT? SIE SOLLEN ROT SEIN?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535837
    m_Localized: 'Unstable: Warum waren die im Fernsehen dann grün? Und wie sehen meine überhaupt aus?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535838
    m_Localized: 'Unstable: Warum waren die im Fernsehen dann grün?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535839
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535840
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535841
    m_Localized: 'Unstable: Ah, das einzige Anzeichen, das Sinn ergibt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535842
    m_Localized: 'Unstable: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535843
    m_Localized: 'Unstable: Keine spezielle Farbe, kein Schmutz, nichts von dem ganzen Blödsinn.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535844
    m_Localized: 'Unstable: Einfach nur ganz normale Achselhöhlen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535845
    m_Localized: 'Unstable: Gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535846
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535847
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535848
    m_Localized: 'Unstable: Bisher wurde ich immer nur auf Partys fotografiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535849
    m_Localized: 'Unstable: Heutzutage feiern die Leute gar nicht mehr richtig. Oder vielleicht laden sie mich einfach nicht mehr ein. Ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535850
    m_Localized: 'Unstable: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535851
    m_Localized: 'Unstable: Ja, mein Herz rast wie verrückt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535852
    m_Localized: 'Unstable: Kein EnerJeka der Welt kann mit mir mithalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535853
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535854
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535855
    m_Localized: 'Unstable: Na gut, warum nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535856
    m_Localized: 'Unstable: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535857
    m_Localized: 'Unstable: Hätte ich sie vorher putzen sollen?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535858
    m_Localized: 'Unstable: Oder was?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535859
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535860
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535861
    m_Localized: 'Unstable: Oha.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535862
    m_Localized: 'Unstable: Ich dachte, du wärst keiner von den Typen, die auf alles schießen, was sich bewegt. Davon gibt’s schon genug.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535863
    m_Localized: 'Unstable: Ehrlich gesagt dachte ich, ich hätte hier mal meine Ruhe vor der ganzen Gewalt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535864
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535865
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535866
    m_Localized: 'Unstable: Du hast dir ja einen tollen Zeitpunkt ausgesucht, was?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535867
    m_Localized: 'Unstable: Du wirst doch nicht schießen, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535868
    m_Localized: 'Unstable: Oder ist Zittern jetzt auch schon verdächtig?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535869
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535870
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535871
    m_Localized: 'Unstable: Das ist nicht richtig.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535872
    m_Localized: 'Unstable: Du hast doch selbst die rote Farbe erwähnt. Oder ... sind meine Augen etwa rot?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535873
    m_Localized: 'Unstable: Sprich Klartext, ich blick hier nicht mehr durch.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535874
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535875
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535876
    m_Localized: 'Unstable: Nicht cool.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535877
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535878
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535879
    m_Localized: 'Unstable: Warte mal, ich hab kein Loch im Herzen oder so was.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535880
    m_Localized: 'Unstable: Es schlägt einfach nur wie verrückt. Verstehst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535881
    m_Localized: 'Unstable: Warte mal kurz, ich kriege kaum noch Luft.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535882
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535883
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535884
    m_Localized: 'Unstable: Sag mir doch wenigstens zuerst die Regeln!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535885
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535886
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535887
    m_Localized: 'Unstable: Ich versteh schon, Sicherheit, Vorsichtsmaßnahmen und der ganze Kram.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535888
    m_Localized: 'Unstable: So dreht man doch irgendwann durch. Am Ende erschießt man jeden, nur weil er einem komisch vorkommt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535889
    m_Localized: 'Unstable: Vielleicht wäre es einfacher, wenn du auch weggehst. Und versuchst, ein bisschen Frieden zu finden.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535890
    m_Localized: 'Unstable: Irgendwo weit weg von hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535891
    m_Localized: 'Unstable: Weißt du, was mir Angst macht? Wenn man nicht mal die Hände heben kann, kann man auch keine Waffe abwehren.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535892
    m_Localized: 'Unstable: Klingt vielleicht dumm, aber wer würde nicht wenigstens versuchen, sich vor einer Kugel zu schützen?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535893
    m_Localized: 'Unstable: Warte mal ... Also ist in Wirklichkeit gar nicht alles grünlich?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535894
    m_Localized: 'Unstable: Welche Farbe ... haben die Dinge dann?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535895
    m_Localized: 'Unstable: Ich hab’s nicht mal bemerkt, als alles grün wurde ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535896
    m_Localized: 'Unstable: Das macht mich total fertig.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535897
    m_Localized: 'Unstable: Man gibt den Leuten nicht gerade ein sicheres Gefühl, wenn man mit einer Waffe rumhantiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535898
    m_Localized: 'Unstable: Die Besucher hören nicht auf zu töten, nur weil du ein paar Leute bedroht hast.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535899
    m_Localized: 'Unstable: Am Ende bist du nur selbst derjenige, vor dem alle Angst haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535900
    m_Localized: 'Unstable: Ist es das wert?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535901
    m_Localized: 'Unstable: Es hat keinen Sinn, Leute einzuschüchtern.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535902
    m_Localized: 'Unstable: Du ... Haaah ... Du bringst nur alle gegen dich auf.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535903
    m_Localized: 'Unstable: Warte mal ... Hnng ... Mein verdammtes Herz.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535904
    m_Localized: 'Unstable: Egal ... Hör einfach auf, mit der Waffe ... auf Leute zu zielen. Das ... bringt rein gar nichts.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535905
    m_Localized: 'Unstable: Ich geh dann mal und ... Haaah ... Haaah ... hör auf, dich in den Wahnsinn zu treiben, ja?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535906
    m_Localized: 'Unstable: Was?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535907
    m_Localized: 'Unstable: Das war’s also?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535908
    m_Localized: 'Rocker: Legen wir los. Vielleicht ist es noch nicht zu spät, um diese Welt zu rocken!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535909
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535910
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535911
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535912
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535913
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535914
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535915
    m_Localized: 'Rocker: Jaaa ... Diese Zähne haben echt zu viel Rauch abbekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535916
    m_Localized: 'Rocker: Schon komisch, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535917
    m_Localized: 'Rocker: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535918
    m_Localized: 'Rocker: Das ist alles, was mir von meiner Crew geblieben ist. Erinnerungen und Flecken.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535919
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535920
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535921
    m_Localized: 'Rocker: Ich hab dieses eine Tattoo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535922
    m_Localized: 'Rocker: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535923
    m_Localized: 'Rocker: Wilde Nacht. Der Tätowierer war hackedicht und ich war auch breit genug, um endlich die Eier dafür zu haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535924
    m_Localized: 'Rocker: Warte mal ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535925
    m_Localized: 'Rocker: Vielleicht war das gar kein Tattoo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535926
    m_Localized: 'Rocker: Ich kann mich nicht mal mehr erinnern ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535927
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535928
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535929
    m_Localized: 'Rocker: Wir dachten früher mal, es wär cool, uns Tinte direkt in die Augen zu spritzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535930
    m_Localized: 'Rocker: Ich hab immer noch Flashbacks von diesem wilden Ritt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535931
    m_Localized: 'Rocker: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535932
    m_Localized: 'Rocker: Nein, nicht meine Augen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535933
    m_Localized: 'Rocker: Ein anderer Typ ist komplett erblindet. Mann, du hättest seine Augen sehen sollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535934
    m_Localized: 'Rocker: Für solche Augen würde ich töten ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535935
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535936
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535937
    m_Localized: 'Rocker: Nur zu.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535938
    m_Localized: 'Rocker: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535939
    m_Localized: 'Rocker: Irgendwas gefunden?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535940
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535941
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535942
    m_Localized: 'Rocker: Ja, Mann, machen wir ein Foto zusammen. Vielleicht unterschreib ich’s sogar!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535943
    m_Localized: 'Rocker: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535944
    m_Localized: 'Rocker: Hey.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535945
    m_Localized: 'Rocker: Vielleicht nimmst du erst mal den Deckel von der Linse.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535946
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535947
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535948
    m_Localized: 'Rocker: Früher hab ich meine Ohren gedehnt. Dann ... wurde es mir zu öde.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599660535949
    m_Localized: 'Rocker: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924416
    m_Localized: 'Rocker: Jetzt sind sie nur noch eingerissen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924417
    m_Localized: 'Rocker: Aber der Look gefällt mir irgendwie immer noch.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924418
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924419
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924420
    m_Localized: 'Rocker: Ganz ehrlich? Ist mir mittlerweile scheißegal.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924421
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924422
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924423
    m_Localized: 'Rocker: Es gibt nicht mehr viel, wovor ich Angst haben müsste.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924424
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924425
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924426
    m_Localized: 'Rocker: Bleib locker, Mann. Du musst nicht mit dem Ding rumfuchteln.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924427
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924428
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924429
    m_Localized: 'Rocker: Ich will nicht stinken. Ist das ein Grund, mich zu erschießen?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924430
    m_Localized: 'Rocker: Beeindruckt, was?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924431
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924432
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924433
    m_Localized: 'Rocker: Oh, das ist wohl die ohne Deckel.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924434
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924435
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924436
    m_Localized: 'Rocker: Mein Stil scheint nicht so dein Ding zu sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924437
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924438
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924439
    m_Localized: 'Rocker: Vielleicht wartet dieses fette, perfekte Riff noch irgendwo auf mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924440
    m_Localized: 'Rocker: Ich hab noch keine konkrete Idee dafür. Nur so ein dumpfes Summen im Kopf.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924441
    m_Localized: 'Rocker: Aber mal ehrlich, was würde sich ändern, wenn du abdrückst?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924442
    m_Localized: 'Rocker: Ich komm doch eh nie wieder auf ’ne Bühne.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924443
    m_Localized: 'Rocker: Ich würde dafür töten, jetzt ein Festival aufzumischen. Ich hab grade richtig Bock drauf.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924444
    m_Localized: 'Rocker: Schade, dass du nichts Stärkeres als Bier hast.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924445
    m_Localized: 'Rocker: Ich würde mich verdammt gerne volllaufen lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924446
    m_Localized: 'Rocker: Ich weiß gar nicht, was ich sagen soll, Mann.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924447
    m_Localized: 'Rocker: Danke fürs Nachsehen, schätze ich.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924448
    m_Localized: 'Rocker: Warum ist das Foto eigentlich so dunkel?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924449
    m_Localized: 'Rocker: Selbst unser alter Proberaum war heller – obwohl du hier Licht hast.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924450
    m_Localized: 'Rocker: Ich hab noch nie drüber nachgedacht, Kirchenglocken in einen unserer Songs einzubauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924451
    m_Localized: 'Rocker: Irgendwie hätte ich Lust, ein paar Kirchenglocken in unsere Songs einzubauen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924452
    m_Localized: 'Rocker: „Unsere Songs“ ... Als ob noch irgendjemand da wäre, der sie mit mir spielen könnte.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924453
    m_Localized: 'Rocker: Ich sag dir was ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924454
    m_Localized: 'Rocker: Das könnte mein größter Auftritt überhaupt sein.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924455
    m_Localized: 'Rocker: Vielleicht warten die Jungs da oben schon auf mich.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924456
    m_Localized: 'Rocker: ROCKT DIE VERDAMMTE BÜHNE!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924457
    m_Localized: 'Experienced: Alles klar, Kumpel. Sag einfach Bescheid und ich zeig dir, was du sehen willst.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924458
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924459
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924460
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924461
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924462
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924463
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924464
    m_Localized: 'Experienced: Die Zähne? Die sind gelb. Karies oder so was in der Art.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924465
    m_Localized: 'Experienced: Im Knast verteilen nicht gerade Minz-Zahnbürsten. Also flipp nicht aus wegen dem Zahnfleischbluten.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924466
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924467
    m_Localized: 'Experienced: Das hat doch nichts zu bedeuten, oder, Kumpel?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924468
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924469
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924470
    m_Localized: 'Experienced: Kein Problem, Kumpel. Wirf einen Blick drauf.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924471
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924472
    m_Localized: 'Experienced: Siehst du? Ganz normal. Na ja, bis auf ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924473
    m_Localized: 'Experienced: Ich hab da ’ne Kleinigkeit an den Händen. Mach dir keinen Kopf, ist nur ein Ausschlag wegen der Hitze.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924474
    m_Localized: 'Experienced: Diese Hände haben ’ne Menge Sachen erledigt ... aber dafür hab ich meine Zeit schon abgesessen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924475
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924476
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924477
    m_Localized: 'Experienced: Willst du sehen, ob du da drin ein Gewissen siehst?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924478
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924479
    m_Localized: 'Experienced: Na gut, dann sieh sie dir an.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924480
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924481
    m_Localized: 'Experienced: Ich dachte, ’ne dunkle Brille würde gegen die Sonne helfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924482
    m_Localized: 'Experienced: Aber sie macht’s nur noch schlimmer. Nutzloses Ding.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924483
    m_Localized: 'Experienced: Aber sie hat sich als nutzlos erwiesen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924484
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924485
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924486
    m_Localized: 'Experienced: Kumpel, hör zu ... Ich zeig’s dir, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924487
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924488
    m_Localized: 'Experienced: Ich hab mich damals verbrannt, als ich besoffen rumgealbert hab. Also flipp nicht gleich aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924489
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924490
    m_Localized: 'Experienced: Da. Und? Ich bin keiner von diesen Freaks, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924491
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924492
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924493
    m_Localized: 'Experienced: Kumpel, versuchst du, mich einzubuchten? Wozu brauchst du ein Fahndungsfoto?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924494
    m_Localized: 'Experienced: ... Oder ist das irgendeine Art Test?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924495
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924496
    m_Localized: 'Experienced: Fühlt sich an wie damals bei der Erfassung im Knast. Foto für meine Akte und der ganze Kram.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924497
    m_Localized: 'Experienced: Na gut, mach das Foto, wenn’s sein muss.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924498
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924499
    m_Localized: 'Experienced: Fertig?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924500
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924501
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924502
    m_Localized: 'Experienced: Was zur Hölle? Die Ohren?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924503
    m_Localized: 'Experienced: Du spinnst total, Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924504
    m_Localized: 'Experienced: Musst du die wirklich sehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924505
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924506
    m_Localized: 'Experienced: Na gut, scheiß drauf.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924507
    m_Localized: 'Experienced: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924508
    m_Localized: 'Experienced: Na? Irgendwelche lockeren Schrauben da drin gefunden?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924509
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924510
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924511
    m_Localized: 'Experienced: Sicher, dass du noch recht bei Trost bist?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924512
    m_Localized: 'Experienced: Die Zähne sind gelb, warum also die Knarre ziehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924513
    m_Localized: 'Experienced: Oder willst du mir für das Zahnfleischbluten kaltmachen?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924514
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924515
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924516
    m_Localized: 'Experienced: Kumpel, warum greifst du nach dem Ding? Steck das weg.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924517
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924518
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924519
    m_Localized: 'Experienced: Denkst du, ich lüg dich an?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924520
    m_Localized: 'Experienced: Ich sag dir, ’ne dunkle Brille hält die Sonne nicht auf. Probier’s doch selbst aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924521
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924522
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924523
    m_Localized: 'Experienced: Ich kapier’s ja, meine Achselhöhlen sind kein schöner Anblick ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924524
    m_Localized: 'Experienced: Aber warum so feindselig? Wir haben uns doch vorher ganz normal unterhalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924525
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924526
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924527
    m_Localized: 'Experienced: Kumpel, verwechselst du mich mit irgendeinem anderen Arschloch?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924528
    m_Localized: 'Experienced: Ich hab mein Verbrechen begangen und meine Zeit abgesessen – bin erst vor Kurzem rausgekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924529
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924530
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924531
    m_Localized: 'Experienced: Dein Ernst, Kumpel? Das geht eindeutig zu weit.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924532
    m_Localized: 'Experienced: Zähne und Dreck kapier ich ja noch. Aber Ohren? Von Ohren war nie die Rede.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924533
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924534
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924535
    m_Localized: 'Experienced: Gut. Zieh nicht bei jeder kleinen Zuckung gleich das Ding.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924536
    m_Localized: 'Experienced: Ein unruhiger Finger am Abzug und das war’s. Alles vorbei.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924537
    m_Localized: 'Experienced: Ich wusste ja, dass du ein pragmatischer Typ bist, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924538
    m_Localized: 'Experienced: Du musst mir nicht wegen jeder Kleinigkeit gleich ’ne Knarre an den Kopf halten, kapiert?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924539
    m_Localized: 'Experienced: Die Wärter haben mir in der Hinsicht schon gereicht, glaub mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924540
    m_Localized: 'Experienced: Das ist deine Bude, also will ich nix sagen. Aber führ dich hier nicht auf wie ein Tyrann.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924541
    m_Localized: 'Experienced: Du bist doch hier nicht der Rudelführer, der alles bis auf die Knochen abnagt, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924542
    m_Localized: 'Experienced: Spar dir lieber deine Munition, Kumpel.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924543
    m_Localized: 'Experienced: Glaub mir, ich bin kein Blender. Hand aufs Herz!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924544
    m_Localized: 'Experienced: Es ist das Einzige, was ich besitze und nicht geklaut habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924545
    m_Localized: 'Experienced: Spinnst du, Kumpel? Willst du mich wegen eines dämlichen Fotos umlegen?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924546
    m_Localized: 'Experienced: Nicht mal die verdammten Wärter haben mich so hart rangenommen, Mann ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924547
    m_Localized: 'Experienced: Sieh an, du bist ja doch noch zur Vernunft gekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924548
    m_Localized: 'Experienced: Für einen Moment dachte ich, du knallst mich wegen irgendeinem Mist ab, der im Fernsehen nie erwähnt wurde.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924549
    m_Localized: 'Experienced: Scheiße, du bist so ein dummer Hurensohn. Ich dachte, du wärst in Ordnung. Aber du bist ein fauler Apfel!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924550
    m_Localized: 'Experienced: Dein Gewehrlauf soll verflucht sein!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924551
    m_Localized: 'Jacket: Oh Mann ... Wenn ich wirklich ein Besucher bin, sag’s mir nicht. Schieß einfach, okay?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924552
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924553
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924554
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924555
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924556
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924557
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924558
    m_Localized: 'Jacket: Ja, wirf einen Blick drauf.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924559
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924560
    m_Localized: 'Jacket: Ich habe einen starken Überbiss. Manchmal beiße ich mir auf die Wangen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924561
    m_Localized: 'Jacket: Dann bekomme ich wunde Stellen ... Das ist kein Spaß.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924562
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924563
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924564
    m_Localized: 'Jacket: Kein Problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924565
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924566
    m_Localized: 'Jacket: Tja, die Jacke ist aus billigstem Material. Davon bekomme ich Ausschlag, das ist alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924567
    m_Localized: 'Jacket: Siehst du? Nichts Besonderes.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924568
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924569
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924570
    m_Localized: 'Jacket: Ich zeige dir meine Augen, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924571
    m_Localized: 'Jacket: Ehrlich gesagt bin ich ein bisschen nervös. Sei nicht zu streng.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924572
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924573
    m_Localized: 'Jacket: Und? Alles in Ordnung?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924574
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924575
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924576
    m_Localized: 'Jacket: Was meine Achselhöhlen angeht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924577
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924578
    m_Localized: 'Jacket: Ich weiß, dass Hautreizungen zu den Merkmalen von Besuchern gehören.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924579
    m_Localized: 'Jacket: Aber das kommt von der Jacke – ich schwitze darin und heutzutage kann man ja nirgends duschen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924580
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924581
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924582
    m_Localized: 'Jacket: Ich habe nichts gegen ein Foto, aber deine Kamera sieht irgendwie komisch aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924583
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924584
    m_Localized: 'Jacket: Hey, ist das einer dieser Aura-Filme aus der Werbung?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924585
    m_Localized: 'Jacket: Ehrlich gesagt wirkst du nicht wie jemand, der an solches Zeug glaubt.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924586
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924587
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924588
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924589
    m_Localized: 'Jacket: Ohren stehen aber nicht auf der Liste der Merkmale, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924590
    m_Localized: 'Jacket: Wobei ich zugeben muss, dass ich nicht genau weiß, was die Merkmale sind. Vielleicht habe ich eins übersehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924591
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924592
    m_Localized: 'Jacket: Und? Alles gut?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924593
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924594
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924595
    m_Localized: 'Jacket: Ich bin ein Besucher?! Aber meine Zähne sind doch schief!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924596
    m_Localized: 'Jacket: NICHT SCHIESSEN, BITTE!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924597
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924598
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924599
    m_Localized: 'Jacket: Warte, ich hab’s dir doch gesagt – der Ausschlag kommt von der Jacke!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924600
    m_Localized: 'Jacket: Warte, an meinen Händen ist nichts!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924601
    m_Localized: 'Jacket: ICH BIN KEIN BESUCHER!!! ERSCHIESS MICH NICHT, BITTE!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924602
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924603
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924604
    m_Localized: 'Jacket: Was?! Ich bin ein Besucher?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924605
    m_Localized: 'Jacket: Aber meine Augen sind nicht mal rot!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924606
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924607
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924608
    m_Localized: 'Jacket: Scheiße ... Bin ich wirklich ein Besucher?!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924609
    m_Localized: 'Jacket: SCHEISSE, SCHEISSE, SCHEISSE!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924610
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924611
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924612
    m_Localized: 'Jacket: Warte, warte! Was ist los?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924613
    m_Localized: 'Jacket: Hat das Aura-Ding irgendwas gezeigt?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924614
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924615
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924616
    m_Localized: 'Jacket: Warte, was stimmt mit meinen Ohren nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924617
    m_Localized: 'Jacket: Was ist das Problem?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924618
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924619
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924620
    m_Localized: 'Jacket: Danke ... dass du mich nicht erschossen hast.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924621
    m_Localized: 'Jacket: Mein ganzes Leben ist gerade an mir vorbeigezogen.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924622
    m_Localized: 'Jacket: Das hast du mit Absicht gemacht, oder?!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924623
    m_Localized: 'Jacket: Mir ist das Herz in die Hose gerutscht. Warum machst du so was?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924624
    m_Localized: 'Jacket: Was war das Anzeichen?! Warum hast du ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924625
    m_Localized: 'Jacket: Moment mal ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924626
    m_Localized: 'Jacket: Eine zuckende Pupille ist ein Anzeichen für einen Besucher?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924627
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924628
    m_Localized: 'Jacket: Das wusste ich gar nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924629
    m_Localized: 'Jacket: Willst du mich jetzt doch nicht mehr umbringen?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924630
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924631
    m_Localized: 'Jacket: Danke, dass du nicht abgedrückt hast, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924632
    m_Localized: 'Jacket: Wenn du dir nicht sicher bist, wer ich bin, dann zieh beim nächsten Mal vielleicht nicht gleich die Waffe, ja?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924633
    m_Localized: 'Jacket: Du dachtest, das Muster auf meiner Jacke wäre ein Besuchermerkmal?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924634
    m_Localized: 'Jacket: Puh ... Ich dachte schon, da wären dunkle Flecken.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924635
    m_Localized: 'Jacket: Komisches Ding, diese Aura-Kamera ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924636
    m_Localized: 'Jacket: Ich bin also kein Besucher?'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924637
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924638
    m_Localized: 'Jacket: Warum hast du dann die Waffe gezogen? WARUM ZUR HÖLLE?!'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924639
    m_Localized: 'Jacket: Mutter, Vater ... Es tut mir leid.'
    m_Metadata:
      m_Items: []
  - m_Id: 73444599668924640
    m_Localized: 'Jacket: Es tut mir so leid ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414656
    m_Localized: 'Tough: Ich lasse mich nicht rumschubsen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414657
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414658
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414659
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414660
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414661
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414662
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414663
    m_Localized: 'Tough: Meine Eckzähne stehen hervor, das war schon als Kind so.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414664
    m_Localized: 'Tough: Ich wurde deswegen oft gehänselt. Jetzt nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414665
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414666
    m_Localized: 'Tough: Ich könnte ihnen die Zähne aus ihren grinsenden Fressen reißen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414667
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414668
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414669
    m_Localized: 'Tough: Ich mag es, mich hübsch zu fühlen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414670
    m_Localized: 'Tough: Mir sagt das zwar nie jemand, aber es ist schön, sich selbst so zu fühlen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414671
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414672
    m_Localized: 'Tough: Ach, verdammt noch mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414673
    m_Localized: 'Tough: Die Nägel sind abgesplittert? Wie ist das denn passiert?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414674
    m_Localized: 'Tough: Egal ... Scheiß drauf.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414675
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414676
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414677
    m_Localized: 'Tough: Ich habe in meinem Leben schon eine Menge Scheiße gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414678
    m_Localized: 'Tough: Man sieht es mir bestimmt an, wenn man genau hinsieht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414679
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414680
    m_Localized: 'Tough: Wie ich’s mir dachte.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414681
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414682
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414683
    m_Localized: 'Tough: Nein. Das werden wir nicht tun.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414684
    m_Localized: 'Tough: Gehörst du zu diesen Perverslingen, die auf so was abfahren?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414685
    m_Localized: 'Tough: Ich will nicht wieder jemanden umbringen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414686
    m_Localized: 'Tough: Ich will nicht wieder enttäuscht werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414687
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414688
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414689
    m_Localized: 'Tough: Ich mache nicht oft Fotos. Aber mal sehen, was dabei rauskommt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414690
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414691
    m_Localized: 'Tough: Ich kann nicht behaupten, dass ich an diesen ganzen „Aura“-Blödsinn glaube, aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414692
    m_Localized: 'Tough: Irgendwie ergibt das schon Sinn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414693
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414694
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414695
    m_Localized: 'Tough: Ich hab mir gerade erst Ohrlöcher stechen lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414696
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414697
    m_Localized: 'Tough: Mir gefällt’s.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414698
    m_Localized: 'Tough: Früher hab ich kleine Ohrringe getragen, aber ich konnte nie das richtige Paar finden.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414699
    m_Localized: 'Tough: Aber die hier ... die gefallen mir.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414700
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414701
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414702
    m_Localized: 'Tough: Du zielst auf die Falsche.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414703
    m_Localized: 'Tough: Nicht ich bin das Monster in diesem Haus, verdammt noch mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414704
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414705
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414706
    m_Localized: 'Tough: Was, ich soll meine Acrylnägel abnehmen? Vergiss es.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414707
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414708
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414709
    m_Localized: 'Tough: Ich muss alles im Auge behalten.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414710
    m_Localized: 'Tough: Und ich meine wirklich alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414711
    m_Localized: 'Tough: Dagegen kann man nichts machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414712
    m_Localized: 'Tough: Ich wünschte, ich könnte die Hälfte der Dinge vergessen, die ich gesehen habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414713
    m_Localized: 'Tough: Oder eigentlich alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414714
    m_Localized: 'Tough: Aber das geht leider nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414715
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414716
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414717
    m_Localized: 'Tough: Verdammte Scheiße ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414718
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414719
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414720
    m_Localized: 'Tough: Aber für dich nicht, was?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414721
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414722
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414723
    m_Localized: 'Tough: Was zum Teufel hast du da überhaupt gesehen? Ohrenschmalz?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414724
    m_Localized: 'Tough: Warum zur Hölle richtest du eine Waffe auf mich?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414725
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414726
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414727
    m_Localized: 'Tough: Ist das eine Art Test? Na? Hab ich bestanden? Hab nicht gezuckt, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414728
    m_Localized: 'Tough: Es ist trotzdem kein tolles Gefühl, eine Waffe im Gesicht zu haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414729
    m_Localized: 'Tough: Klar, Aussehen bedeutet jetzt nicht mehr viel.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414730
    m_Localized: 'Tough: Aber es fühlt sich trotzdem gut an ... anständig auszusehen. Zu mögen, was man im Spiegel sieht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414731
    m_Localized: 'Tough: Ich hasse es zu sehen, was da draußen passiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414732
    m_Localized: 'Tough: Aber das wird sich so schnell nicht ändern.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414733
    m_Localized: 'Tough: Alles, was wir tun können, ist weiterzukämpfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414734
    m_Localized: 'Tough: Glaubst du wirklich, dass es das wert ist? Würdest du mich erschießen, nur weil dir gerade danach ist?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414735
    m_Localized: 'Tough: Und würdest du meine Leiche danach überhaupt eines Blickes würdigen?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414736
    m_Localized: 'Tough: Diese Welt ist die reinste Hölle.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414737
    m_Localized: 'Tough: Glaubst du an Auren? Seelen? Dieses ganze Zeug?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414738
    m_Localized: 'Tough: Glaubst du, ein Drecksack bleibt auch nach dem Tod ein Drecksack?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414739
    m_Localized: 'Tough: Ich frage mich die ganze Zeit ... Wenn das hier vorbei ist, was wird dann aus den ganzen Schwächlingen?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414740
    m_Localized: 'Tough: Wie wird es für sie sein?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414741
    m_Localized: 'Tough: Willst du wirklich abdrücken?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414742
    m_Localized: 'Tough: Das war’s dann wohl ... Mein ganzer Kampf ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414743
    m_Localized: 'Tough: Beendet im Haus von irgendeinem einsamen Irren.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414744
    m_Localized: 'Bald: Kein Problem, Kumpel. Was willst du sehen?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414745
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414746
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414747
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414748
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414749
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414750
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414751
    m_Localized: 'Bald: Äh ... klar. Ich rauche manchmal. Hoffentlich stinke ich nicht zu sehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414752
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414753
    m_Localized: 'Bald: Na? Alles paletti?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414754
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414755
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414756
    m_Localized: 'Bald: Ich hab, äh ... ein Ekzem. Deswegen ist da ein Verband an meinem Arm.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414757
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414758
    m_Localized: 'Bald: Ich hab irgendwo gehört, dass Abdecken bei so was helfen kann.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414759
    m_Localized: 'Bald: Es ist schon fast verheilt. Trotzdem würde ich sicherheitshalber gerne das Pflaster wechseln. Hast du zufällig eins übrig?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414760
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414761
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414762
    m_Localized: 'Bald: Dir ist wahrscheinlich aufgefallen, dass ich dieses Mistding am Auge habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414763
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414764
    m_Localized: 'Bald: Keine Ahnung, wann das aufgetaucht ist. Hat mir jedenfalls eine Heidenangst eingejagt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414765
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414766
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414767
    m_Localized: 'Bald: Dreh nicht gleich durch, okay?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414768
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414769
    m_Localized: 'Bald: Ist nur so eine Hautsache. Ich hab ’ne Glatze und überall solche Flecken.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414770
    m_Localized: 'Bald: Scheiße, ich hab ewig nicht geduscht. Mein Fehler.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414771
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414772
    m_Localized: 'Bald: Achselhöhlen sind einfach nur ... Achselhöhlen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414773
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414774
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414775
    m_Localized: 'Bald: Oh, das gefällt mir. Nur her mit der Kamera!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414776
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414777
    m_Localized: 'Bald: Und? Lass mich mal sehen!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414778
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414779
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414780
    m_Localized: 'Bald: Ja, klar doch.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414781
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414782
    m_Localized: 'Bald: Ehrlich gesagt hasse ich es, sie sauberzumachen. Wenn man zu tief stochert, tut es höllisch weh.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414783
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414784
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414785
    m_Localized: 'Bald: Ach, komm schon, was soll das alles? Vor einer Sekunde war doch noch alles gut ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414786
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414787
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414788
    m_Localized: 'Bald: Schon gut, schon gut! Du musst das Ding nicht auf mich richten!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414789
    m_Localized: 'Bald: Vergiss den Verband. Mit mir ist alles in Ordnung!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414790
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414791
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414792
    m_Localized: 'Bald: Komm schon! Alles gut! Ist ja nicht so, als würde ich sterben oder so.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414793
    m_Localized: 'Bald: Ein Arztbesuch bringt sowieso nichts. Wie heißt es so schön: „Kleinkram heilt, echter Scheiß nicht.“'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414794
    m_Localized: 'Bald: Und das hier? Das ist Kleinkram.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414795
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414796
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414797
    m_Localized: 'Bald: Entspann dich mal. Alles ist gut! Fuchtel nicht mit der Waffe vor mir rum!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414798
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414799
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414800
    m_Localized: 'Bald: Scheiße, Mann! Wir können ein neues Foto machen, wenn’s so schlimm ist!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414801
    m_Localized: 'Bald: Oder vielleicht ist einfach nur deine Kamera kaputt?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414802
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414803
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414804
    m_Localized: 'Bald: Ich hab doch gar nichts gemacht!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414805
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414806
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414807
    m_Localized: 'Bald: Ich konnte mir keinen Zahnarzt leisten, das ist alles.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414808
    m_Localized: 'Bald: Außer Essen konnten wir uns sowieso kaum was leisten.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414809
    m_Localized: 'Bald: Meine Mutter hat mir ab und zu Klamotten aus Stoffresten genäht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414810
    m_Localized: 'Bald: Einmal hab ich mich mit meinen Theaterfreunden komplett abgeschossen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414811
    m_Localized: 'Bald: Das war sooo krank.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414812
    m_Localized: 'Bald: Ich hab nicht mal meine eigenen Hände wiedererkannt. Als hätte ich einen Film aus der Egoperspektive gesehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414813
    m_Localized: 'Bald: Zum Glück hab ich nichts Dummes angestellt. Ich bin nur mit zwei verschiedenen Schuhen nach Hause gelaufen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414814
    m_Localized: 'Bald: Aber das war gruselig. Danach hab ich mit dem Trinken aufgehört. Vielleicht wär ich schon tot, wenn ich so weitergemacht hätte.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414815
    m_Localized: 'Bald: Trotzdem hatte ich am Anfang eine Scheißangst.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414816
    m_Localized: 'Bald: Ich hab angefangen, mich total verrückt zu machen. Ich dachte, ich werde blind oder so.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414817
    m_Localized: 'Bald: Aber nein. Das ist schon seit Jahren so.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414818
    m_Localized: 'Bald: Und eine Behandlung würde ein Vermögen kosten, das ich nicht habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414819
    m_Localized: 'Bald: Tja, was soll ich sagen?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414820
    m_Localized: 'Bald: Du bist gefährlich, mein Freund. Du entscheidest, wer lebt und wer stirbt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414821
    m_Localized: 'Bald: Das ist doch krank.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414822
    m_Localized: 'Bald: Wir hatten mal wieder getrunken, so wie immer.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414823
    m_Localized: 'Bald: Ein paar Tage später haben wir erfahren, dass eine unserer Freundinnen nie nach Hause gekommen ist.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414824
    m_Localized: 'Bald: Wir haben Fotos von ihr ausgedruckt und überall Zettel aufgehängt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414825
    m_Localized: 'Bald: Und weißt du, was sich später rausgestellt hat?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414826
    m_Localized: 'Bald: Sie ist ausgerutscht, in den Fluss gefallen und ertrunken.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414827
    m_Localized: 'Bald: Das ist doch krank.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414828
    m_Localized: 'Bald: Sie war ein nettes Mädchen. Hübsch war sie auch.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414829
    m_Localized: 'Bald: Ich hab’s geliebt, wenn Mama mir die Ohren saubergemacht hat. Sie war so vorsichtig und hat mir nie wehgetan.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414830
    m_Localized: 'Bald: Aber das wird sie nie wieder tun ... Jetzt nicht mehr ... Nicht mit solchen Fingern ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414831
    m_Localized: 'Bald: Scheiße ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414832
    m_Localized: 'Bald: Du Wichser!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414833
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414834
    m_Localized: 'Nervous: Erinnert mich ein bisschen an die Anstalt, hihi ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414835
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414836
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414837
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414838
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414839
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414840
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414841
    m_Localized: 'Nervous: Von den Medikamenten sind meine Zähne ganz dünn geworden ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414842
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414843
    m_Localized: 'Nervous: Diese Nadelstifte sind gut, um an meinen Wangen zu reißen. Kleine Hautstreifen abzuziehen, Schicht für Schicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414844
    m_Localized: 'Nervous: Bis ich das Blut spüre. Und den Schmerz. Oh, der Schmerz ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414845
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414846
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414847
    m_Localized: 'Nervous: Ich habe gelernt, nicht mehr an meinen Nägeln zu pulen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414848
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414849
    m_Localized: 'Nervous: Aber wenn die Haut absteht, will ich sie einfach abziehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414850
    m_Localized: 'Nervous: Das Fleisch langsam abpellen, damit ich das Brennen spüre. Hihihi ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414851
    m_Localized: 'Nervous: Es brennt eine Weile. Also wühle ich in der Erde, solange es noch wund ist ... Mmm ... Hart, spitz, rau ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414852
    m_Localized: 'Nervous: Es brennt eine Weile.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414853
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414854
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414855
    m_Localized: 'Nervous: Ich mag deine Augen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414856
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414857
    m_Localized: 'Nervous: Ich beobachte dich, wenn du schläfst. Wenn du nachts herumläufst ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414858
    m_Localized: 'Nervous: Misstraust du jemandem? Hihi ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414859
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414860
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414861
    m_Localized: 'Nervous: Mir hat nie jemand beigebracht, wie man sich pflegt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414862
    m_Localized: 'Nervous: Aber im Krankenhaus hab ich gesehen, wie sie so ein Wischiwaschi gemacht haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414863
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414864
    m_Localized: 'Nervous: Ich hab’s selbst nie richtig hingekriegt, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414865
    m_Localized: 'Nervous: Jetzt kann ich das auch, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414866
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414867
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414868
    m_Localized: 'Nervous: Das gefällt mir nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414869
    m_Localized: 'Nervous: Hm.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414870
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414871
    m_Localized: 'Nervous: Früher haben sie mich ausgelacht ... Jetzt lachen sie nie wieder.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414872
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414873
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414874
    m_Localized: 'Nervous: Ich beachte sie gar nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414875
    m_Localized: 'Nervous: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414876
    m_Localized: 'Nervous: Sinnlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414877
    m_Localized: 'Nervous: Keine Freude, kein Schmerz, kein Sinn.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414878
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414879
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414880
    m_Localized: 'Nervous: Raue Borsten, die übers Zahnfleisch schrubben ... Oh, ja ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414881
    m_Localized: 'Nervous: Aber das ... Das ist zu viel ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414882
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414883
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414884
    m_Localized: 'Nervous: WARUM?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414885
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414886
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414887
    m_Localized: 'Nervous: MICH?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414888
    m_Localized: 'Nervous: Ich hab dich nicht im Schlaf umgebracht ... noch nicht!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414889
    m_Localized: 'Nervous: Warum solltest du das tun? Mich doch nicht ... Hihi ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414890
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414891
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414892
    m_Localized: 'Nervous: Oh?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414893
    m_Localized: 'Nervous: Meine glatten Achseln machen mich böse?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414894
    m_Localized: 'Nervous: Wobei ... Hihi ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414895
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414896
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414897
    m_Localized: 'Nervous: Wie ... nett von dir, hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414898
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414899
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414900
    m_Localized: 'Nervous: Warum wirst du denn gleich so schießwütig?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414901
    m_Localized: 'Nervous: Bist du etwas besser? Sauberer?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414902
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414903
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414904
    m_Localized: 'Nervous: Im Krankenhaus haben sie mir das Hirn gebraten. Bzzzt, bzzzt, bzzzt!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414905
    m_Localized: 'Nervous: Aber der Einzige, der mir helfen konnte ... war ich selbst. Hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414906
    m_Localized: 'Nervous: Ich hab aufgehört, an den Fingern zu pulen, als ich angefangen hab, auf meinen Wangen zu kauen!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414907
    m_Localized: 'Nervous: Hihi.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414908
    m_Localized: 'Nervous: Mit einer Waffe auf jemanden zielen, der weiß, wo und wann du schläfst? Hihi ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414909
    m_Localized: 'Nervous: Unterscheiden sich Besucher wirklich von Außenseitern?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414910
    m_Localized: 'Nervous: Die Gesellschaft verachtet beide ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414911
    m_Localized: 'Nervous: Wie kannst du sie auseinanderhalten? Kannst du das überhaupt? Hihi ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414912
    m_Localized: 'Nervous: Über mir schwebt ein Schatten ... Hihi ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414913
    m_Localized: 'Nervous: Was kann das sein? Ist da jemand? Oder nur eine seltsame Spiegelung?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414914
    m_Localized: 'Nervous: Was sind das für Streifchen?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414915
    m_Localized: 'Nervous: Sind das ... NADELN?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414916
    m_Localized: 'Nervous: Oder nur Lichtstrahlen?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414917
    m_Localized: 'Nervous: Warum hast du eine Waffe auf mich gerichtet?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414918
    m_Localized: 'Nervous: Hat dir das jemand befohlen?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414919
    m_Localized: 'Nervous: Na? War es so? War es so?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414920
    m_Localized: 'Nervous: Nein? War nur so ein Gedanke.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414921
    m_Localized: 'Nervous: Hihi ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414922
    m_Localized: 'Nervous: Vielleicht hätte ich nicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414923
    m_Localized: 'Nervous: ... herkommen sollen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414924
    m_Localized: 'Leper: Nur zu, wenn du dich dann besser fühlst.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414925
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414926
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414927
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414928
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414929
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414930
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414931
    m_Localized: 'Leper: Siehst du? Ganz normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414932
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414933
    m_Localized: 'Leper: Und schön gerade. Meine Haut ist ein hoffnungsloser Fall, aber meine Beißer sind perfekt.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414934
    m_Localized: 'Leper: Du willst mich doch nicht wegen der einzigen guten Sache an mir umbringen, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414935
    m_Localized: 'Leper: Ja, sie sind schief. Kein Grund, mich für einen Besucher zu halten.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414936
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414937
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414938
    m_Localized: 'Leper: Ja, auch an den Händen habe ich schlechte Haut.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414939
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414940
    m_Localized: 'Leper: Das ist für dich doch kein Anzeichen für einen Besucher, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414941
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414942
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414943
    m_Localized: 'Leper: Na gut, sieh ruhig hin.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414944
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414945
    m_Localized: 'Leper: Ich weiß, dass rote Augen ein Merkmal sind. Aber das hier ist nur dieselbe verdammte Hautkrankheit wie überall sonst.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414946
    m_Localized: 'Leper: Ich habe dir noch gar nicht gesagt, dass mein Auge manchmal zuckt. Das kommt auch von meiner angeborenen Krankheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414947
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414948
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414949
    m_Localized: 'Leper: Was? Wofür soll das gut sein?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414950
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414951
    m_Localized: 'Leper: Na ja, was soll’s?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414952
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414953
    m_Localized: 'Leper: Siehst du? Nichts Besonderes. Seltsamerweise habe ich da keine Hautprobleme.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414954
    m_Localized: 'Leper: Ja, auch da habe ich Hautprobleme.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414955
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414956
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414957
    m_Localized: 'Leper: Ein Foto? Das soll ein Merkmal sein?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414958
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414959
    m_Localized: 'Leper: Na gut, mach ruhig ein Foto.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414960
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414961
    m_Localized: 'Leper: Ich habe wohl geblinzelt. Und was soll das jetzt für ein Merkmal sein?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414962
    m_Localized: 'Leper: Und was soll das jetzt für ein Merkmal sein, hm?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414963
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414964
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414965
    m_Localized: 'Leper: Was? Was willst du mit meinen Ohren?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414966
    m_Localized: 'Leper: Nichts für ungut, aber ich kenne die Besuchermerkmale, und das ist keines davon.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414967
    m_Localized: 'Leper: Aber wenn du unbedingt meine Ohren sehen willst, nur zu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414968
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414969
    m_Localized: 'Leper: Na? Siehst du irgendwas Ungewöhnliches?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414970
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414971
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414972
    m_Localized: 'Leper: Was zum Teufel stimmt nicht mit dir?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414973
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414974
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414975
    m_Localized: 'Leper: Ich habe dir doch gesagt, es liegt an meiner Haut.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414976
    m_Localized: 'Leper: Das ist alles. Eine verdammte Hautkrankheit.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414977
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414978
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414979
    m_Localized: 'Leper: Ich habe doch schon gesagt, dass das von der Krankheit kommt!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414980
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414981
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414982
    m_Localized: 'Leper: Willst du mich verarschen?! Wofür?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414983
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414984
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414985
    m_Localized: 'Leper: Warte mal. Das ist ja gar keine normale Kamera.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414986
    m_Localized: 'Leper: Ist das ... ein Aura-Foto? Willst du mich jetzt wegen so einem spirituellen Quatsch umbringen?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414987
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414988
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414989
    m_Localized: 'Leper: Ist das dein Ernst?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414990
    m_Localized: 'Leper: Ohren sind nicht mal ein Besuchermerkmal! Das haben sie im Fernsehen nie gesagt!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414991
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414992
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414993
    m_Localized: 'Leper: Scheiße ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414994
    m_Localized: 'Leper: Warum zur Hölle zielst du mit einer Waffe auf mich?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414995
    m_Localized: 'Leper: Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414996
    m_Localized: 'Leper: Einen Moment lang dachte ich wirklich, du würdest mich wegen meines Aussehens erschießen.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414997
    m_Localized: 'Leper: Scheiße.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414998
    m_Localized: 'Leper: Ziehst du jedes Mal die Waffe, wenn du glaubst, ein Merkmal gefunden zu haben?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657414999
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415000
    m_Localized: 'Leper: Du bist keinen Deut besser als die Leute, die mich für ansteckend halten.'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415001
    m_Localized: 'Leper: Bist du noch ganz dicht?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415002
    m_Localized: 'Leper: Seit wann hat so eine Quacksalber-Kamera zu entscheiden, wer ein Besucher ist?!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415003
    m_Localized: 'Leper: Verdammt ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415004
    m_Localized: 'Leper: Ich kriege hier noch einen Herzinfarkt. Wo hast du das mit den Ohren überhaupt her?'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415005
    m_Localized: 'Leper: Die FEMA hat nie gesagt, dass das ein Merkmal ist!'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415006
    m_Localized: 'Leper: Scheiße, ich will nicht ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74174599657415007
    m_Localized: 'Leper: ... sterben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621056
    m_Localized: 'Fairytaller: Kein Problem! Was genau möchten Sie überprüfen?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621057
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621058
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621059
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621060
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621061
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621062
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621063
    m_Localized: 'Fairytaller: Hier, bitte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621064
    m_Localized: 'Fairytaller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621065
    m_Localized: 'Fairytaller: Meine Zähne waren nie die besten, und seit meinem Abschluss hatte ich keine Gelegenheit, zum Zahnarzt zu gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621066
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621067
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621068
    m_Localized: 'Fairytaller: Hier, bitte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621069
    m_Localized: 'Fairytaller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621070
    m_Localized: 'Fairytaller: Das habe ich schon seit meiner Kindheit. Wir haben früher verlassene Orte erkundet und da lag ein Drahtgitter auf dem Boden ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621071
    m_Localized: 'Fairytaller: Ein Freund hat mir dann versehentlich einen Schrank auf die Hände fallen lassen. Mit dem Abdruck muss ich wohl für immer leben.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621072
    m_Localized: 'Fairytaller: Die Kratzer sind allerdings neu. Ich war einfach ... nervös.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621073
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621074
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621075
    m_Localized: 'Fairytaller: Hier, bitte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621076
    m_Localized: 'Fairytaller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621077
    m_Localized: 'Fairytaller: Meine Augen werden von der Hitze oft rot. Kalte Kompressen haben gut geholfen, aber die sind inzwischen schwer zu bekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621078
    m_Localized: 'Fairytaller: Die Leute haben schon alles Mögliche über meine Augenfarbe gesagt. Manches war nett, manches ... nicht so sehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621079
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621080
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621081
    m_Localized: 'Fairytaller: Äh ... Wenn Sie darauf bestehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621082
    m_Localized: 'Fairytaller: Hier, bitte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621083
    m_Localized: 'Fairytaller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621084
    m_Localized: 'Fairytaller: Ich weiß. Bitte entschuldigen Sie den Geruch.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621085
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621086
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621087
    m_Localized: 'Fairytaller: Klingt interessant.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621088
    m_Localized: 'Fairytaller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621089
    m_Localized: 'Fairytaller: Huch. Interessantes Ergebnis.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621090
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621091
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621092
    m_Localized: 'Fairytaller: Hier, bitte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621093
    m_Localized: 'Fairytaller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621094
    m_Localized: 'Fairytaller: Ja, ich weiß. Ein bisschen schmutzig. Ich hatte in letzter Zeit nicht viel Zeit für die Körperpflege.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621095
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621096
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621097
    m_Localized: 'Fairytaller: Ich spüle mir den Mund aus! Entschuldigung! I-Ich habe keine Zahnbürste dabei. Bitte, erschießen Sie mich nicht!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621098
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621099
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621100
    m_Localized: 'Fairytaller: Meine Nägel?! Das ist erst neulich passiert! Ich bin im Dunkeln an einem losen Stück Metall hängen geblieben!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621101
    m_Localized: 'Fairytaller: Das ist nur eine Narbe aus meiner Kindheit! Ansonsten sind meine Hände einwandfrei! Ich schwöre es!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621102
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621103
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621104
    m_Localized: 'Fairytaller: Könnte ich kurz etwas Kaltes aus dem Kühlschrank holen? Ich habe das schon mein ganzes Leben, i-ich zeige es Ihnen!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621105
    m_Localized: 'Fairytaller: Schon gut, schon gut! Keine Witze mehr! Bitte, bringen Sie mich nicht um! Bitte!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621106
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621107
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621108
    m_Localized: 'Fairytaller: Tut mir leid. Ich habe keine Hygieneartikel dabei und es schien mir unhöflich, die von jemand anderem zu benutzen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621109
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621110
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621111
    m_Localized: 'Fairytaller: Ich hoffe, Sie verurteilen mich nicht wegen so einer Kleinigkeit. Es ist wirklich nichts Schlimmes.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780248621112
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009664
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009665
    m_Localized: 'Fairytaller: I-ich mache sie sauber! Bitte nicht schießen!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009666
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009667
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009668
    m_Localized: 'Fairytaller: Danke.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009669
    m_Localized: 'Fairytaller: Ich werde versuchen, mich besser um meine Zähne zu kümmern.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009670
    m_Localized: 'Fairytaller: Puh ... Ich dachte schon, Sie würden mich wegen dieser Narbe erschießen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009671
    m_Localized: 'Fairytaller: Heutzutage ist es schwer, seine Nägel gut zu pflegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009672
    m_Localized: 'Fairytaller: Aber ich werde versuchen, sie öfter zu säubern, nur für alle Fälle.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009673
    m_Localized: 'Fairytaller: Danke für Ihr Verständnis.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009674
    m_Localized: 'Fairytaller: Ich bin selbst auch nicht gerade begeistert von diesem Zustand.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009675
    m_Localized: 'Fairytaller: ... Sie haben übrigens eine schöne Augenfarbe.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009676
    m_Localized: 'Fairytaller: Danke, dass Sie mich nicht erschossen haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009677
    m_Localized: 'Fairytaller: Ich werde versuchen, mir Zeit für die Körperpflege zu nehmen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009678
    m_Localized: 'Fairytaller: Ich dachte mir, es wäre ziemlich rabiat, jemanden wegen eines Fotos zu töten.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009679
    m_Localized: 'Fairytaller: Das war eine interessante Erfahrung ... aber ich würde nicht dafür sterben wollen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009680
    m_Localized: 'Fairytaller: Danke, dass Sie mich verschont haben. Ich werde sie so schnell wie möglich säubern.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009681
    m_Localized: 'Fairytaller: Ich versuche, ein Wattestäbchen zu finden.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009682
    m_Localized: 'Fairytaller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009683
    m_Localized: 'Fairytaller: Mami ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009684
    m_Localized: 'FunnyGuy: Nur zu. Ist ja nicht so, als hätte ich was Besseres zu tun!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009685
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009686
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009687
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009688
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009689
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009690
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009691
    m_Localized: 'FunnyGuy: Ach, komm schon. Wenn man zu fest schrubbt, geht der Zahnschmelz kaputt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009692
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009693
    m_Localized: 'FunnyGuy: Haha, ich hatte ganz vergessen, dass mir ein Zahn fehlt. Dazu gibt es eine lustige Geschichte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009694
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009695
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009696
    m_Localized: 'FunnyGuy: Nur ganz normale, von der Arbeit geschundene Hände.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009697
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009698
    m_Localized: 'FunnyGuy: Vierzehn Jahre in der Fabrik.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009699
    m_Localized: 'FunnyGuy: Und wofür? Es musste ja so enden.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009700
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009701
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009702
    m_Localized: 'FunnyGuy: Ich habe einen dunklen Fleck auf meiner Iris.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009703
    m_Localized: 'FunnyGuy: Sieh’s dir an.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009704
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009705
    m_Localized: 'FunnyGuy: Deswegen habe ich immer einen kleinen Fleck im Sichtfeld.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009706
    m_Localized: 'FunnyGuy: Aber wenn man lange genug damit lebt, bemerkt man es gar nicht mehr.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009707
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009708
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009709
    m_Localized: 'FunnyGuy: Unsere Fabrik schreit förmlich danach, verklagt zu werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009710
    m_Localized: 'FunnyGuy: Ich sollte eigentlich bald in Rente gehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009711
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009712
    m_Localized: 'FunnyGuy: Und jetzt habe ich wegen der Feuchtigkeit dieses Ding. Salben bringen gar nichts! Und dann sollen wir uns auch noch rasieren!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009713
    m_Localized: 'FunnyGuy: Und jetzt habe ich wegen der Feuchtigkeit dieses Ding. Salben bringen gar nichts!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009714
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009715
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009716
    m_Localized: 'FunnyGuy: Oh, ich sollte vielleicht lieber mein Hemd zuknöpfen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009717
    m_Localized: 'FunnyGuy: Ach, scheiß drauf. Ist ja nur ein Foto.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009718
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009719
    m_Localized: 'FunnyGuy: Zeig’s mir gar nicht erst. Zur Hölle damit, ich will’s nicht sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009720
    m_Localized: 'FunnyGuy: Na gut, dann lass mal sehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009721
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009722
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009723
    m_Localized: 'FunnyGuy: Nur zu, warum nicht.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009724
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009725
    m_Localized: 'FunnyGuy: In der Fabrik gab es nichts, was unsere Ohren hätte schädigen können.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009726
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009727
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009728
    m_Localized: 'FunnyGuy: Hey, immer mit der Ruhe. Du musst dich nicht so von deinem Temperament mitreißen lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009729
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009730
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009731
    m_Localized: 'FunnyGuy: Warum regst du dich so auf? Beruhig dich mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009732
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009733
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009734
    m_Localized: 'FunnyGuy: Ach, das ist doch alles Scheiße.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009735
    m_Localized: 'FunnyGuy: Wenn du schießen willst, dann schieß.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009736
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009737
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009738
    m_Localized: 'FunnyGuy: Ha! Ja, dadurch wird bestimmt alles wieder gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009739
    m_Localized: 'FunnyGuy: Die Lösung aller Probleme!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009740
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009741
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009742
    m_Localized: 'FunnyGuy: Aha, das deutlichste Merkmal von allen! Eine große Knarre!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009743
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009744
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009745
    m_Localized: 'FunnyGuy: Wird es dir nicht langsam zu blöd, mit dem Ding rumzufuchteln?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009746
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009747
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009748
    m_Localized: 'FunnyGuy: Danke, dass du mich nicht erschossen hast.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009749
    m_Localized: 'FunnyGuy: Die Zahngeschichte? Vergiss es. Glaubst du, du kannst einfach ’ne Knarre ziehen und dann quatschen, als wäre nichts gewesen?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009750
    m_Localized: 'FunnyGuy: Kannst du dir vorstellen, eines Tages zur Arbeit zu gehen und dann einfach gefeuert zu werden?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009751
    m_Localized: 'FunnyGuy: Ich hab mir den Arsch aufgerissen, und wofür?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009752
    m_Localized: 'FunnyGuy: Sie schließen die ganze Fabrik wegen steigender Verluste.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009753
    m_Localized: 'FunnyGuy: Man kann nicht mal mehr in Frieden sterben.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009754
    m_Localized: 'FunnyGuy: Was willst du denn noch hören?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009755
    m_Localized: 'FunnyGuy: Ich kann dich gut sehen. Genauso wie die Knarre, die du gerade auf mich gerichtet hast.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009756
    m_Localized: 'FunnyGuy: Gott wird über dich richten.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009757
    m_Localized: 'FunnyGuy: So fühlt sich wohl der Ruhestand an.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009758
    m_Localized: 'FunnyGuy: Kein Job, die Banken haben sich mein Geld ergaunert und die Sonne verbrennt den ganzen Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009759
    m_Localized: 'FunnyGuy: Was für ein Leben, oder? Wie im Märchen! HAHAHA!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009760
    m_Localized: 'FunnyGuy: Meine Familie hat schon immer eigenwillig auf Fotos reagiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009761
    m_Localized: 'FunnyGuy: Dann hieß es zum Beispiel: „Was willst du hier mit der Kamera? Geh lieber Frösche fotografieren.“'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009762
    m_Localized: 'FunnyGuy: Das habe ich wohl von ihnen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009763
    m_Localized: 'FunnyGuy: Trotzdem ist es ungerecht, wie sie mir mein Geld abgeknöpft haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009764
    m_Localized: 'FunnyGuy: Und wie sie uns aus der Fabrik geschmissen haben.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009765
    m_Localized: 'FunnyGuy: Oh, du bist ein echter Witzbold, was?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009766
    m_Localized: 'FunnyGuy: Na ja, wenigstens ist es für mich jetzt vorbei.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009767
    m_Localized: 'FunnyGuy: Mein endgültiger Ruhestand.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009768
    m_Localized: 'Alt: Wenn schon die Infoberichte so schlampig sind, will ich gar nicht wissen, wie die Tests aussehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009769
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009770
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009771
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009772
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009773
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009774
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009775
    m_Localized: 'Alt: Ich warne dich, ich bin ein echter Geschäftshai.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009776
    m_Localized: 'Alt: Hahaha.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009777
    m_Localized: 'Alt: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009778
    m_Localized: 'Alt: Wie könnte ich meine schönen Zähne vernachlässigen?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009779
    m_Localized: 'Alt: Ich habe sie mir gerade erst feilen lassen. Das Zahnfleisch tut noch weh. Aber dafür sehe ich aus wie eine Wahnsinnige!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009780
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009781
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009782
    m_Localized: 'Alt: Bei den Nägeln hab ich echt die Arschkarte gezogen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009783
    m_Localized: 'Alt: Ich hab ein Taxi gerufen, um friedlich an den Stadtrand zu kommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009784
    m_Localized: 'Alt: Aber ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009785
    m_Localized: 'Alt: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009786
    m_Localized: 'Alt: Irgendein arroganter Idiot hat mich beiseitegestoßen. Hat nur gelächelt und ist eingestiegen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009787
    m_Localized: 'Alt: Ich erinnere mich noch genau an seine perfekten weißen Zähne.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009788
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009789
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009790
    m_Localized: 'Alt: Oh, meine Augen? Die mag ich fast so sehr wie meine Tattoos.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009791
    m_Localized: 'Alt: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009792
    m_Localized: 'Alt: Was meinst du?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009793
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009794
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009795
    m_Localized: 'Alt: Es macht mir nichts aus, meine Achselhöhlen zu zeigen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009796
    m_Localized: 'Alt: Aber es ist ... kein schöner Anblick.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009797
    m_Localized: 'Alt: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009798
    m_Localized: 'Alt: Ich hab’s dir ja gesagt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009799
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009800
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009801
    m_Localized: 'Alt: Wow, du hast auch eine Kamera.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009802
    m_Localized: 'Alt: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009803
    m_Localized: 'Alt: Dann wollen wir mal sehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009804
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009805
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009806
    m_Localized: 'Alt: Hm. Na gut.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009807
    m_Localized: 'Alt: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009808
    m_Localized: 'Alt: Ich musste die Tunnel rausnehmen. Zu viele Betrunkene haben mich belästigt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009809
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009810
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009811
    m_Localized: 'Alt: Warte mal. Stört es dich gar nicht, wie vage diese „Merkmale“ sind?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009812
    m_Localized: 'Alt: Ganz normale Leute können die auch haben. Kommt dir das Ganze nicht ... verdächtig unpräzise vor?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009813
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009814
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009815
    m_Localized: 'Alt: Projizierst du die Geschichte, die ich dir erzählt habe, etwa auf mich?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009816
    m_Localized: 'Alt: Was habe ich deiner Meinung nach getan? Es ist nicht meine Schuld, dass ich hingefallen bin und mir einen Nagel abgerissen habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009817
    m_Localized: 'Alt: Was habe ich deiner Meinung nach getan?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009818
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009819
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009820
    m_Localized: 'Alt: Was? Warum?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009821
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009822
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009823
    m_Localized: 'Alt: Keine Panik, ich habe ein Tattoo verblassen lassen, und durch die Hitze ist was Seltsames passiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009824
    m_Localized: 'Alt: Versuch doch selbst mal, bei dieser Hitze Tinte zu entfernen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009825
    m_Localized: 'Alt: Tut höllisch weh und man schwitzt ununterbrochen am ganzen Körper.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009826
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009827
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009828
    m_Localized: 'Alt: Ich weiß, das ist seltsam.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009829
    m_Localized: 'Alt: Ich wollte einfach nur eindrucksvoll aussehen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009830
    m_Localized: 'Alt: Ich hatte auf keinen Fall vor, mein Abschiedsfoto zu machen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009831
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009832
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009833
    m_Localized: 'Alt: Irgendwie wünschte ich, ich hätte sie nicht rausgenommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009834
    m_Localized: 'Alt: Dann wäre wenigstens klar, wofür ich umgebracht werde.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009835
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009836
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009837
    m_Localized: 'Alt: Ich nehme mir eine kleine Auszeit von der ganzen Action, okay?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009838
    m_Localized: 'Alt: Ziemlich nervenaufreibend, mit dem Tod bedroht zu werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009839
    m_Localized: 'Alt: Ich gehe nicht wegen ein paar Nägeln zurück in die Stadt. Auf keinen Fall.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009840
    m_Localized: 'Alt: Wer weiß, was passiert, wenn ich in dieses Chaos zurückkomme?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009841
    m_Localized: 'Alt: Die meisten meiner Tattoos habe ich mir stechen lassen, nachdem jemand gestorben ist, der mir nahestand.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009842
    m_Localized: 'Alt: Wie in Tinte konservierte Erinnerungen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009843
    m_Localized: 'Alt: Wie du siehst, war das Leben nicht einfach.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009844
    m_Localized: 'Alt: Aber als ich meinen Seelenverwandten verlor ... da habe ich mir die Augen tätowiert.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009845
    m_Localized: 'Alt: Damit ich ihn immer sehe, wenn ich in den Spiegel schaue.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009846
    m_Localized: 'Alt: Man sollte sich keine Tattoos an den falschen Stellen stechen lassen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009847
    m_Localized: 'Alt: Schade, dass niemand um mich trauern wird. Niemand wird mein Andenken bewahren, wenn ich weg bin.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009848
    m_Localized: 'Alt: In was für seltsamen Zeiten wir leben ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009849
    m_Localized: 'Alt: Selbst wenn man den ganzen verdammten Zirkus hinter sich lässt, verfolgen einen die Clowns.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009850
    m_Localized: 'Alt: Beängstigend.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009851
    m_Localized: 'Tourist: Glauben Sie, ich bin infiziert?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009852
    m_Localized: Zähne
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009853
    m_Localized: Hände
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009854
    m_Localized: Augen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009855
    m_Localized: Achselhöhlen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009856
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009857
    m_Localized: Ohren
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009858
    m_Localized: 'Tourist: Sie meinen ... an den Zähnen kann man erkennen, ob ich das Virus habe?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009859
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009860
    m_Localized: 'Tourist: Na schön, wenn es hilft ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009861
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009862
    m_Localized: 'Tourist: Gerade, oder? Dort, wo ich wohne, sind Zahnärzte nicht teuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009863
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009864
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009865
    m_Localized: 'Tourist: Meine Hände? Suchen Sie nach einer Art Ausschlag?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009866
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009867
    m_Localized: 'Tourist: Seien Sie unbesorgt, meine Haut juckt immer nach dem Sonnen. Vielleicht habe ich mich ein bisschen gekratzt.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009868
    m_Localized: 'Tourist: Das ist nur ein kleiner Sonnenbrand, keine Infektion.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009869
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009870
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009871
    m_Localized: 'Tourist: Meine Augen? Kein Problem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009872
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009873
    m_Localized: 'Tourist: Leider konnte die Sonnenbrille gegen diese Sonne nicht viel ausrichten.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009874
    m_Localized: 'Tourist: Gut, dass ich meine Sonnenbrille mitgenommen habe.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009875
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009876
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009877
    m_Localized: 'Tourist: Wie bitte?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009878
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009879
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009880
    m_Localized: 'Tourist: Ehrlich, das kommt nur von der Hitze. Ich habe wie verrückt geschwitzt und davon einen Ausschlag bekommen.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009881
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009882
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009883
    m_Localized: 'Tourist: Ist das irgendeine Regierungstechnologie, um Infektionen aufzuspüren?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009884
    m_Localized: 'Tourist: Wenn das so ist, probiere ich es gerne aus.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009885
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009886
    m_Localized: 'Tourist: Hm ... Dieser Film ist ... seltsam.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009887
    m_Localized: 'Tourist: Und diese Punkte ... sind auch seltsam.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009888
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009889
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009890
    m_Localized: 'Tourist: Oh, verstehe. Was, wenn sich das Virus über den Gehörgang ausbreitet?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009891
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009892
    m_Localized: 'Tourist: Ich glaube, es ist alles in Ordnung.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009893
    m_Localized: In Ruhe lassen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009894
    m_Localized: Waffe rausholen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009895
    m_Localized: 'Tourist: Was ist los? Stimmt etwas nicht?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009896
    m_Localized: Schießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009897
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009898
    m_Localized: 'Tourist: Um Himmels willen, ich habe Ihnen doch gesagt – ich habe mich nur gekratzt! Das ist eine Hautreizung!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009899
    m_Localized: 'Tourist: Seit wann ist ein Sonnenbrand ein Symptom?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009900
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009901
    m_Localized: 'Tourist: Warum richten Sie dieses Ding auf mich? Weil meine Augen rot sind?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009902
    m_Localized: 'Tourist: Warum richten Sie diese Waffe auf mich?!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009903
    m_Localized: 'Tourist: Mit meinen Augen ist alles in bester Ordnung!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009904
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009905
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009906
    m_Localized: 'Tourist: Wollen Sie damit sagen, dass Ausschläge ein Symptom sind?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009907
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009908
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009909
    m_Localized: 'Tourist: Warum? Ich habe doch nur gesagt, dass der Film seltsam aussieht! So einen habe ich noch nie gesehen!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009910
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009911
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009912
    m_Localized: 'Tourist: Warten Sie, was ist das Problem? Ich habe nicht mal Ohrenschmalz!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009913
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009914
    m_Localized: Zuhören
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009915
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009916
    m_Localized: 'Tourist: Warum haben Sie eine Waffe auf mich gerichtet?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009917
    m_Localized: 'Tourist: Können Sie sie bitte endlich wegpacken?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009918
    m_Localized: 'Tourist: Ich verstehe Sie ja, aber das geht zu weit.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009919
    m_Localized: 'Tourist: Gott, das ist doch nur ein Sonnenbrand!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009920
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009921
    m_Localized: 'Tourist: Behandeln Sie jeden in Ihrem Haus so?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009922
    m_Localized: 'Tourist: Und? Wollen Sie nicht schießen?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009923
    m_Localized: 'Tourist: Was?! Achselhöhlen? Das ist jetzt auch ein Symptom?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009924
    m_Localized: 'Tourist: Beruhigen Sie sich!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009925
    m_Localized: 'Tourist: Warum greifen Sie jedes Mal zur Waffe, verdammt noch mal?'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009926
    m_Localized: 'Tourist: Sie wollten das Foto doch unbedingt machen!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009927
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009928
    m_Localized: 'Tourist: Sind Sie wahnsinnig? Das ist kein Spielzeug.'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009929
    m_Localized: 'Tourist: Hören Sie auf, mit der Waffe herumzufuchteln, sonst vertreiben Sie noch alle!'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009930
    m_Localized: 'Tourist: Verdammt ... Ich habe nie ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76332780257009931
    m_Localized: 'Tourist: ... die Welt gesehen ...'
    m_Metadata:
      m_Items: []
  - m_Id: 94177391876841472
    m_Localized: Erschießen
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
