%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NotCharacterDialogs_zh-Hant
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: zh-Hant
  m_SharedData: {fileID: 11400000, guid: fdb5e7c1e1a06f94cb20bf63a5da666e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21953783779328
    m_Localized: 'TV: 重大事件！'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556544
    m_Localized: 'TV: 今天早上6點28分，太陽釋放出了一股異常猛烈的能量。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556545
    m_Localized: 'TV: 這次爆發的強度遠超科學家先前的預測。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556546
    m_Localized: 'TV: 室外的氣溫已達臨界水平。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556547
    m_Localized: 'TV: 政府已宣佈進入緊急狀態。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556548
    m_Localized: 'TV: 我們呼籲各位民眾盡量不要於白天外出。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556549
    m_Localized: 'TV: 接下來是……'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556550
    m_Localized: 'TV: 稍等一下……'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556551
    m_Localized: 'TV: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556552
    m_Localized: 'TV: 演播室收到了一則緊急消息——我們與……偽人進行了接觸。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556553
    m_Localized: 'TV: 據目擊者描述，這種生物能模仿人類的外表和舉止。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556554
    m_Localized: 'TV: 請務必避免與偽人進行接觸。於其中一個案例中，我們確認了這種生物的一項特徵……'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556555
    m_Localized: 'TV: 長了一口完美無瑕的潔白牙齒。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556556
    m_Localized: 'TV: 其中一名目擊者可以證實這點。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556557
    m_Localized: 'TV: 具體來說，他遇到了一個沒有住處的人、長著一口完美無瑕的潔白牙齒——結果，對方是個偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556558
    m_Localized: 'TV: 新聞到此為止——請務必保持冷靜，不要於白天外出。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556559
    m_Localized: 'TV: 接下來是綜藝節目。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556560
    m_Localized: 'TV: 大家，午安——您現在收看的是天氣預報。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556561
    m_Localized: 'TV: 一股暖鋒即將抵達這片區域，所帶來的熱浪會打破此前的最高記錄。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556562
    m_Localized: 'TV: 據氣象學家分析，溫度預計會飆升。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556563
    m_Localized: 'TV: 隨著太陽活動的增強，紫外線輻射也會提升。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556564
    m_Localized: 'TV: 為了您的安全，請避免日光浴。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556565
    m_Localized: 'TV: 否則，非常有可能會引發中暑。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556566
    m_Localized: 'TV: 目前，尚不清楚待在陽光之下是否會對健康產生負面影響……'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556567
    m_Localized: 'TV: 不過——為了避免遭受三度灼傷，還請不要出門。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556568
    m_Localized: 'TV: 遺憾的是……對於這種情況，防曬乳完全派不上用場。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556569
    m_Localized: 'TV: 天氣預報到此為止，接下來是娛樂節目。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556570
    m_Localized: 'TV: 芭蕾舞伶翩然起舞、剛勁卻又輕盈地躍過舞台。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556571
    m_Localized: 'TV: 舞姿固然高雅、優美，卻喚起了焦慮的思緒。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556572
    m_Localized: 'TV: 政府似乎是想要把大眾的目光從當前所發生的一切給轉移開來。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556573
    m_Localized: 'TV: 要是有人能解釋一下究竟發生了什麼事就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556574
    m_Localized: 'TV: 大家，午安——您現在收看的是新聞報道。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556575
    m_Localized: 'TV: 太陽的活動沒有降低的跡象。與此同時，犯罪率則出現了小幅的提升。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556576
    m_Localized: 'TV: 根據最新資料，過去幾晚所發生的兇殺案件、其數量已遠遠超出平均水平。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556577
    m_Localized: 'TV: 專家猜測這一現象與偽人和社會日益增長的焦慮有關。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556578
    m_Localized: 'TV: 接下來是最新資訊——據目擊者報告，已確定了偽人的一項全新特徵。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556579
    m_Localized: 'TV: 指甲縫裡沾有泥土。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556580
    m_Localized: 'TV: 據專家指出，這項特徵能幫助我們辨別剛於地下爬出來不久的偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556581
    m_Localized: 'TV: 新聞到此為止——請務必保持冷靜，不要於白天外出。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556582
    m_Localized: 'TV: 接下來是關於某個通體蒼白的殺人狂魔的報告——不過，先插播一則廣告。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556583
    m_Localized: 'TV: 過去，購買日常雜貨需要大老遠地跑到商店裡去。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556584
    m_Localized: 'TV: 現在，拿起電話就能下單。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556585
    m_Localized: 'TV: 快來使用安憩速遞吧！只要撥打XXX-XXX-XXXX，東西就會在一天之內送達你的家門。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556586
    m_Localized: 'TV: 安憩速遞——於家中享受美好的休閒時光。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556587
    m_Localized: 'TV: 某個通體蒼白的殺人狂魔出現在了城裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556588
    m_Localized: 'TV: 根據目擊者的證詞，警方了解到受害者具備一個共同的特徵——獨自一人過著生活。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556589
    m_Localized: 'TV: 而且，此人下手之前還會先與對方進行交談。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556590
    m_Localized: 'TV: 警方按照目擊者的描述繪製了素描。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556591
    m_Localized: 'TV: 嫌犯是一名通體蒼白的中年黑髮男子，體型瘦長、只穿了一條褲子。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556592
    m_Localized: 'TV: 據數名民眾報告，此人披著他人的外皮。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556593
    m_Localized: 'TV: 不過，這一資訊目前尚未得到確認。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556594
    m_Localized: 'TV: 如果碰上了此人，請務必不要打開大門、一定要告訴對方你並非獨自一人在家。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556595
    m_Localized: 'TV: 新聞到此為止。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556596
    m_Localized: 'TV: 大家，午安——您現在收看的是新聞報道。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556597
    m_Localized: 'TV: 異常的天氣持續加劇，偽人的侵襲尚未停歇。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750848
    m_Localized: 'TV: 政府已成立特殊部門來應對這一局面。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750849
    m_Localized: 'TV: 即聯邦緊急事件管理局，通稱——FEMA。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750850
    m_Localized: 'TV: 各位可以透過黃色的災害物質防護服和防毒面具來甄別其工作人員。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750851
    m_Localized: 'TV: 雖然這一機構才剛剛開始工作不久，不過卻已確認偽人的一項全新特徵。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750852
    m_Localized: 'TV: 鮮紅的眼睛。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750853
    m_Localized: 'TV: 根據資料，FEMA在對受到羈押的偽人進行過觀察之後發現了這項特徵。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750854
    m_Localized: 'TV: 這種生物對光線非常敏感，因此導致眼睛出現紅腫、發炎的症狀。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750855
    m_Localized: 'TV: 新聞到此為止——請務必保持冷靜，不要於白天外出。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750856
    m_Localized: 'TV: 接下來是來自FEMA的報告——不過，先插播一則廣告。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750857
    m_Localized: 'TV: 動蕩不安、恐怖肆虐、苦不堪言——一切，都因偽人而起……'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750858
    m_Localized: 'TV: 不過，於這淚水如同江河般決堤危難之際……'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750859
    m_Localized: 'TV: 聯邦緊急事件管理局的工作人員將會挺身而出！'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750860
    m_Localized: 'TV: 這些無私、無畏的英雄會保護我們免受偽人的侵襲。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750861
    m_Localized: 'TV: 截至目前，這一機構已經成功識別了超過27000個危險生物。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750862
    m_Localized: 'TV: 記住——檢舉自己周遭的可疑活動，就是在幫助他們開展工作。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750863
    m_Localized: 'TV: 為此，只要使用邀請函造訪FEMA即可。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750864
    m_Localized: 'TV: 如果大家開始懷疑自己有可能會是偽人，請撥打服務電話：{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750865
    m_Localized: 'TV: 協助FEMA、就是在抵禦偽人的侵襲。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750866
    m_Localized: 'TV: FEMA——這是什麼機構、又是因何成立？'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750867
    m_Localized: 'TV: 聯邦緊急事件管理局是政府為了緩解這次危機而成立的特殊部門。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750868
    m_Localized: 'TV: 會幫助大家處理因偽人侵襲引發的各種問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750869
    m_Localized: 'TV: 目前，尚不清楚其具體正在執行何種工作……'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750870
    m_Localized: 'TV: 不過，我們可以滿懷信心地說——大家的命運已經交到了可以信任之人的手中……'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750871
    m_Localized: 'TV: 這一機構由各個領域的專家組成，其中也包括了享譽盛名的科學家。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750872
    m_Localized: 'TV: 如果FEMA的工作人員前來造訪，建議大家積極地進行配合、好好遵循他們的指示。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750873
    m_Localized: 'TV: 記住——協助FEMA、就是在抵禦偽人的侵襲。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750874
    m_Localized: 'TV: 大家，午安——您現在收看的是新聞報道。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750875
    m_Localized: 'TV: 為應對偽人引起的各種情況，FEMA決定採取全新措施。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750876
    m_Localized: 'TV: 建立隔離區——專門收容潛在危險的對象。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750877
    m_Localized: 'TV: 與此同時，FEMA還在對受到羈押的偽人進行過實驗之後確定了偽人的一項全新特徵……'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750878
    m_Localized: 'TV: 腋窩非常乾淨。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750879
    m_Localized: 'TV: 據FEMA報告，之所以會存在這項特徵、是由於偽人的這片區域並不會生長毛髮。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750880
    m_Localized: 'TV: 這一機構呼籲市民耐心配合檢查以及前往隔離區的護送安排。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750881
    m_Localized: 'TV: 新聞到此為止——請務必保持冷靜，不要於白天外出。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750882
    m_Localized: 'TV: 接下來是關於辨別出偽人之後該採取何種措施的報導。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750883
    m_Localized: 'TV: 據FEMA指出，「偽人」這一現象具有傳染性、或會構成其他生物威脅。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750884
    m_Localized: 'TV: 因此，對可疑人士進行檢舉、實施隔離至關重要。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750885
    m_Localized: 'TV: 如果無法立即將偽人移送至隔離區，請給對方出具一份特別指示、要求其前往FEMA報到。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750886
    m_Localized: 'TV: 於次輪檢查時，工作人員會將持有該文件的市民帶離。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750887
    m_Localized: 'TV: 報告到此為止，接下來插播一則廣告。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750888
    m_Localized: 'TV: 無懼炎熱，盡情馳騁！'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750889
    m_Localized: 'TV: 只要有了EnerJeka，就能重獲新生！'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750890
    m_Localized: 'TV: 一種煥發精神的能量飲料——相比於水，能更加迅速、更為有效地解渴。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750891
    m_Localized: 'TV: 現在，已於安憩速遞推出！快撥打電話、進行訂購吧——XXX-XXX-XXXX。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750892
    m_Localized: 'Window: 鄰居的房子坐落於乾草地上。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750893
    m_Localized: 'Window: 窗戶沒有亮光，看來已經就寢。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750894
    m_Localized: 'Window: 一隻瘦骨嶙峋的小狗立於田間小徑之上。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750895
    m_Localized: 'Window: 正哀傷地四處張望、試圖尋找一些食物。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750896
    m_Localized: 'Window: 幾個醉漢四仰八叉地躺在大街之上。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750897
    m_Localized: 'Window: 雖然地面非常冰冷，不過似乎睡得很熟。對於他們來說，此時此刻、一切安好。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750898
    m_Localized: 'Window: 不遠處是鄰居的房子——現在，他正於你家做客。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750899
    m_Localized: 'Window: 窗戶映照出了一點亮光，看來……他的家人正等待其歸去。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750900
    m_Localized: 'Window: 幾個十來歲的孩子正在院子裡打鬧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750901
    m_Localized: 'Window: 無憂無慮地坐在一起、聊天打屁，根本就沒有注意到你。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750902
    m_Localized: 'Window: 外面……一片死寂。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750903
    m_Localized: 'Window: 空無一人。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750904
    m_Localized: 'Window: 就連醉漢也沒有出門。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750905
    m_Localized: 'Window: 難道，是在害怕著什麼嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750906
    m_Localized: 'Window: 透過窗戶，能看到鄰居和他的女兒。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750907
    m_Localized: 'Window: 兩人正在開心地玩耍，想要忘記周遭的恐怖……'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750908
    m_Localized: 'Window: 即便，只有一瞬也好。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750909
    m_Localized: 'Window: 地上躺著幾具十來歲孩子的屍體。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750910
    m_Localized: 'Window: 恐怕，是遭到了某人的毒手。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750911
    m_Localized: 'Window: 血液都還沒有凝固，看起來是剛死不久。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750912
    m_Localized: 'Window: 路上站著個人，通體蒼白、如同死者。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750913
    m_Localized: 'Window: 對方的皮膚有著奇怪的褶皺。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750914
    m_Localized: 'Window: 就好像披著一件尺寸不合的外衣一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750915
    m_Localized: 'Window: 雖然無法從此處看到他的眼睛，不過你能感到對方正死盯著你。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750916
    m_Localized: 'Window: 恐懼湧上心頭，你向上帝祈禱——希望這個陰森、恐怖的偽人徑直離開，不要前來造訪。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750917
    m_Localized: 'Window: 一群FEMA的工作人員站在鄰居的房子旁邊。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750918
    m_Localized: 'Window: 不知，他們正在談論什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750919
    m_Localized: 'Window: 也許，想要採集土壤樣本？'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750920
    m_Localized: 'Window: 抑或，是在找地方建基地？'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750921
    m_Localized: 'Window: 地上躺著幾具十來歲孩子的屍體——全都被燒成了焦炭。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750922
    m_Localized: 'Window: 看來，已經被暴曬了足足一整天。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750923
    m_Localized: 'Window: 兩名FEMA的工作人員站在旁邊、埋頭寫著什麼東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750924
    m_Localized: 'Window: 還好，他們來把屍體搬走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750925
    m_Localized: 'Window: 不然，要是任由它們就此腐爛的話、不敢想像會引發什麼傳染病。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750926
    m_Localized: 'Window: 透過窗戶，你看到一群全副武裝的士兵。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750927
    m_Localized: 'Window: 顯然，是從城裡派來此處的、專門為FEMA的工作人員提供保全。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750928
    m_Localized: 'Window: 能零零碎碎地聽見他們正在談論某個通體蒼白、赤裸上身的男性。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750929
    m_Localized: 'Window: 也許，他們想要搜尋那個詭異的偽人？'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750930
    m_Localized: 'Window: 鄰居先前塗白的房子已被燒毀、變得焦黑。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750931
    m_Localized: 'Window: 看來，烈焰剛熄滅不久。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750932
    m_Localized: 'Window: 難道，有人故意縱火？'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750933
    m_Localized: 'Window: 鄰居一家人到底怎樣了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750934
    m_Localized: 'Window: 不知，是否還活著？'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750935
    m_Localized: 'Window: 憂慮的思緒在腦海裡不斷翻騰，因無法理解這一切而產生的絕望徹底地壓垮了你。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750936
    m_Localized: 'Window: 一個通體蒼白、極其詭異的人站在路上，面露微笑。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750937
    m_Localized: 'Window: 手裡還捧著某人戴著頭盔的首級。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750938
    m_Localized: 'Window: 一名士兵的頭顱，表情因恐懼扭曲。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750939
    m_Localized: 'Window: 通體蒼白的偽人、迫在眉睫的死亡——不知，他到底更怕那邊。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750940
    m_Localized: 'Window: 昨天剛來的整隊士兵都已經死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750941
    m_Localized: 'Window: 看來，這裡上演過一場大規模的屠殺。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750942
    m_Localized: 'Window: 整條大街上都散落著屍體——其中一具的頭顱不知所蹤。'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750943
    m_Localized: 'Window: 難道，是之前那個通體蒼白、極其詭異的傢伙所下的手？'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750944
    m_Localized: 「你好，這裡是緊急服務調度中心——請問，有什麼需要？」「大家……燒了起來。」
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750945
    m_Localized: 「能跟我描述一下你都看到了什麼嗎？請問，是失火了嗎？」「不對，是太陽——大家……大家被陽光照到、燒了起來。」
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750946
    m_Localized: 「太陽下山之前，都請不要出門。」「不、不……夜幕降臨之後，那個傢伙就會出現——那個通體蒼白、骨瘦如柴的傢伙。那個傢伙……不是人類。」
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750947
    m_Localized: 接下來是全新節目——「沒錯，我就是人類。」
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750948
    m_Localized: 規則非常簡單……只要把自己的照片提交上來，我們就會揭開你的真實面目。
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750949
    m_Localized: 將你的照片透過電郵寄送至yesiam@humanverification.agency，後續就交給我們處理吧。
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750950
    m_Localized: 不過，我們只接受眼睛、牙齒和指甲的照片——除此之外，一概不收。
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750951
    m_Localized: 不知，你的眼睛是否突然變紅、你的牙齒是否瞬間變白、你的指甲縫裡是否於不知不覺之間沾上了泥土？
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750952
    m_Localized: 一旦出現這種情況，說明已遭惡靈附體——你，已化為一個偽人！
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750953
    m_Localized: 不要放任這一禍害佔據你的軀體！立即撥打電話、向我們的專家尋求幫助吧——777-460。
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750954
    m_Localized: 於他們的幫助下，惡靈將被驅逐、邪氣將被淨化，同時還能給予你更為強大的庇護。
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750955
    m_Localized: 歡迎收聽「想要相信」——我們將會透過這一節目解密各種謎團、揭開政府陰謀。
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750956
    m_Localized: 今天，我們將會與一位特別的來賓共同探討偽人的真相——理學博士，來自……
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750957
    m_Localized: 蛤？等等，他不來了？
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750958
    m_Localized: 怎麼可能會被全部偷走——他的文件總量大得驚人！
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750959
    m_Localized: 該死，我就知道政府不會讓我們這麼簡單地揭開這一切背後的真相。一群混蛋……
    m_Metadata:
      m_Items: []
  - m_Id: 17738415503822848
    m_Localized: 'TV: 從前，有兄弟倆住在水壩附近。'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182976
    m_Localized: 'TV: 潺潺流水讓人聯想到冰涼、起泡的飲品……'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182977
    m_Localized: 'TV: 兄弟倆長大後，一起創立了Bober釀酒廠。'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182978
    m_Localized: 'TV: Bober Černý啤酒已成為商店和酒吧裡最受歡迎的酒精飲品之一。'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182979
    m_Localized: 'TV: Bober Černý啤酒：喝好酒，多喝酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182980
    m_Localized: 'Window: 你正看著鄰居房子的廢墟。'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182981
    m_Localized: 'Window: 只剩下一個幽靈般的外殼，儘管直到最近還有一個幸福的家庭住在那裡……'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182982
    m_Localized: 'Window: 一種奇怪的感覺襲來，彷彿你早就知道會發生這種事……'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182983
    m_Localized: 'Window: 就像……你感覺到死亡很快就會降臨到這所房子。'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182984
    m_Localized: 'Window: 你看到一根木樁，上面插著一個戴著頭盔的頭骨。'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182985
    m_Localized: 'Window: 頭骨上還有一些焦黑的皮膚，看起來像是有人把牙齒都拔掉了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182986
    m_Localized: 'Window: 這顆頭顱已經在這裡一整天了。'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182987
    m_Localized: 'Window: 整個恐怖的景象看起來像是一種威脅。可能是那個詭異蒼白的偽人留下的。'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182988
    m_Localized: 'Window: FEMA官員正在檢查最近大屠殺的現場。'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182989
    m_Localized: 'Window: 他們收走了所有死去士兵的裝備和武器，以免落入掠奪者手中。'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182990
    m_Localized: 'Window: 他們可能原本期望那個蒼白的偽人不會在與一群武裝人員的遭遇中倖存下來。'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182991
    m_Localized: 'Window: 現在又多了幾個屍袋。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576140324864
    m_Localized: 'TV: 大家，下午好——您現在收看的是天氣預報。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102080
    m_Localized: 'TV: 一股暖鋒即將抵達這片區域，所帶來的熱浪會打破此前的最高記錄。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102081
    m_Localized: 'TV: 據氣象學家分析，溫度預計會飆升。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102082
    m_Localized: 'TV: 隨著太陽活動的增強，紫外線輻射也會提升。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102083
    m_Localized: 'TV: 為了您的安全，請避免日光浴。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102084
    m_Localized: 'TV: 否則，非常有可能會引發中暑。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102085
    m_Localized: 'TV: 目前，尚不清楚待在陽光之下是否會對健康產生負面影響……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102086
    m_Localized: 'TV: 不過——為了避免遭受三度灼傷，還請不要出門。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102087
    m_Localized: 'TV: 遺憾的是……對於這種情況，防曬乳完全派不上用場。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102088
    m_Localized: 'TV: 接下來是更為詳細的天氣預報。不過，在此之前——先讓我們進入工商時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102089
    m_Localized: 'TV: 芭蕾舞伶翩然起舞、剛勁卻又輕盈地躍過舞台。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102090
    m_Localized: 'TV: 舞姿固然高雅、優美，卻喚起了焦慮的思緒。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102091
    m_Localized: 'TV: 就好像是要把你的目光從當前所發生的一切給轉移開來一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102092
    m_Localized: 'TV: 要是有人能解釋一下究竟發生了什麼事就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102093
    m_Localized: 'TV: 過去，購買日常雜貨需要大老遠地跑到商店裡去。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102094
    m_Localized: 'TV: 現在，拿起電話就能下單。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102095
    m_Localized: 'TV: 快來使用安憩速遞吧！只要撥打{0}，東西就會在一天之內送達你的家門。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102096
    m_Localized: 'TV: 安憩速遞——於家中享受美好的休閒時光。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102097
    m_Localized: 'TV: 某個通體蒼白的殺人狂魔出現在了城裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102098
    m_Localized: 'TV: 根據目擊者的證詞，警方了解到受害者具備一個共同的特徵——獨自一人過著生活。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102099
    m_Localized: 'TV: 而且，此人下手之前還會先與對方進行交談。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102100
    m_Localized: 'TV: 警方按照目擊者的描述繪製了素描。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102101
    m_Localized: 'TV: 嫌犯是一名通體蒼白的中年黑髮男子，體型瘦長、只穿了一條褲子。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102102
    m_Localized: 'TV: 據數名民眾報告，此人披著他人的外皮。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102103
    m_Localized: 'TV: 不過，這一資訊目前尚未得到確認。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102104
    m_Localized: 'TV: 如果碰上了此人，請務必不要打開大門、一定要告訴對方你並非獨自一人在家。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102105
    m_Localized: 'TV: 新聞到此為止。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102106
    m_Localized: 'TV: 動蕩不安、恐怖肆虐、苦不堪言——一切，都因偽人而起……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102107
    m_Localized: 'TV: 不過，於這淚水如同江河般決堤危難之際……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102108
    m_Localized: 'TV: 聯邦緊急事件管理局的工作人員將會挺身而出！'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102109
    m_Localized: 'TV: 這些無私、無畏的英雄會保護我們免受偽人的侵襲。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102110
    m_Localized: 'TV: 截至目前，這一機構已經成功識別了超過27000個危險生物。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102111
    m_Localized: 'TV: 記住——檢舉自己周遭的可疑活動，就是在幫助他們開展工作。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102112
    m_Localized: 'TV: 為此，只要使用邀請函造訪FEMA即可。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102113
    m_Localized: 'TV: 如果大家開始懷疑自己有可能會是偽人，請撥打服務電話：{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102114
    m_Localized: 'TV: 協助FEMA、就是在抵禦偽人的侵襲。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102115
    m_Localized: 'TV: FEMA——這是什麼機構、又是因何成立？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102116
    m_Localized: 'TV: 聯邦緊急事件管理局是政府為了緩解這次危機而成立的特殊部門。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102117
    m_Localized: 'TV: 會幫助大家處理因偽人侵襲引發的各種問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102118
    m_Localized: 'TV: 目前，尚不清楚其具體正在執行何種工作……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102119
    m_Localized: 'TV: 不過，我們可以滿懷信心地說——大家的命運已經交到了可以信任之人的手中……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102120
    m_Localized: 'TV: 這一機構由各個領域的專家組成，其中也包括了享譽盛名的科學家。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102121
    m_Localized: 'TV: 如果FEMA的工作人員前來造訪，建議大家積極地進行配合、好好遵循他們的指示。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102122
    m_Localized: 'TV: 記住——協助FEMA、就是在抵禦偽人的侵襲。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102123
    m_Localized: 'TV: 據FEMA指出，「偽人」這一現象具有傳染性、或會構成其他生物威脅。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102124
    m_Localized: 'TV: 因此，對可疑人士進行檢舉、實施隔離至關重要。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102125
    m_Localized: 'TV: 如果無法立即將偽人移送至隔離區，請給對方出具一份特別指示、要求其前往FEMA報到。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102126
    m_Localized: 'TV: 於次輪檢查時，工作人員會將持有該文件的市民帶離。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102127
    m_Localized: 'TV: 新聞到此為止。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102128
    m_Localized: 'TV: 無懼炎熱，盡情馳騁！'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102129
    m_Localized: 'TV: 只要有了EnerJeka，就能重獲新生！'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102130
    m_Localized: 'TV: 一種煥發精神的能量飲料——相比於水，能更加迅速、更為有效地解渴。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102131
    m_Localized: 'TV: 現在，已於安憩速遞推出！快撥打電話、進行訂購吧——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102132
    m_Localized: 'TV: 大家，午安——您現在收看的是新聞報導。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102133
    m_Localized: 'TV: 由於表現出了偽人特徵的市民人數急遽增長，FEMA決定採取全新措施。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102134
    m_Localized: 'TV: 自即日起，將對所有主要城市實施全面隔離管制。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102135
    m_Localized: 'TV: 禁止跨城、跨鎮流動。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102136
    m_Localized: 'TV: 還請大家留在各自的指定區域之內。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102137
    m_Localized: 'TV: 與此同時，FEMA公佈了一項全新的特徵：'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102138
    m_Localized: 'TV: 靈光照片。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102139
    m_Localized: 'TV: 如果被攝對象的圖像出現了黑色的斑點，對方非常有可能會是偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102140
    m_Localized: 'TV: 以上便是目前掌握的最新資訊——還請各位保持冷靜，盡量於日間留在室內、不要外出。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102141
    m_Localized: 'TV: 現在是工商時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102142
    m_Localized: 'TV: 神出鬼沒的幽靈、來自地下的生物——偽人到底是什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102143
    m_Localized: 'TV: 既非憑空捏造的科幻小說，也非聳人聽聞的小報頭條。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102144
    m_Localized: 'TV: 而是我們現在必須得面對的現實。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102145
    m_Localized: 'TV: 關於偽人的真實起源，至今依舊是眾說紛紜。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102146
    m_Localized: 'TV: 異星來客？行屍走肉？又或者是……某次實驗失敗的產物？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102147
    m_Localized: 'TV: 據FEMA判斷，以上觀點均與事實相悖。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102148
    m_Localized: 'TV: 研究表明，偽人其實是接觸到了某種病毒或者生物製劑的人類。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102149
    m_Localized: 'TV: 雖然尚不清楚具體的傳播方式，不過FEMA呼籲各位繼續保持警惕、留意偽人的特徵。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102150
    m_Localized: 'TV: 如果你認為自身已經受到感染、又或者無法確定自己是否偽人，還請撥打FEMA的服務電話：'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102151
    m_Localized: 'TV: {0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102152
    m_Localized: 'TV: 以上便是目前掌握的最新資訊，敬請關注後續消息。現在，插播一則廣告。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102153
    m_Localized: 'TV: 如今，辨別偽人的難度與日俱增。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102154
    m_Localized: 'TV: 雖然能透過特徵在一定程度上判斷，不過——到底有沒有什麼萬無一失的方法呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102155
    m_Localized: 'TV: 我們在此向大家隆重介紹一種稱之為革命性產品也毫不為過的全新底片！'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102156
    m_Localized: 'TV: 其特別之處在於能確實地捕捉到靈魂所散發出來的能量，令大家得以區分正常的人類以及危險的偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102157
    m_Localized: 'TV: 拍下照片之後，如果上面出現了黑色的斑點……對方就是偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102158
    m_Localized: 'TV: 現在，將向廣大民眾免費發放新手套件。機不可失、時不再來，快點撥打我們的電話吧——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102159
    m_Localized: 'TV: 突發消息。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102160
    m_Localized: 'TV: 太陽再次發威——野火正在森林地帶肆虐，不斷蔓延、愈演愈烈。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102161
    m_Localized: 'TV: 據專家稱，異常活躍的太陽活動正是導致這一情況的罪魁禍首。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102162
    m_Localized: 'TV: 雖然災害的全貌尚未明朗，不過鄰近城市的都已經緊急出動、壓制猛烈的火勢。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296384
    m_Localized: 'TV: 以上便是目前掌握的最新資訊——還請各位保持冷靜，盡量於日間留在室內、不要外出。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296385
    m_Localized: 'TV: 還請各位保持冷靜，盡量於日間留在室內、不要外出。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296386
    m_Localized: 'TV: 接下來是工商時間。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296387
    m_Localized: 'TV: 從前，有兄弟倆住在水壩附近。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296388
    m_Localized: 'TV: 潺潺流水讓人聯想到冰涼、起泡的飲品……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296389
    m_Localized: 'TV: 兄弟倆長大後，一起創立了Bober釀酒廠。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296390
    m_Localized: 'TV: Bober Černý啤酒已成為商店和酒吧裡最受歡迎的酒精飲品之一。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296391
    m_Localized: 'TV: Bober Černý啤酒：喝好酒，多喝酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296392
    m_Localized: 'TV: 現在，插播一則突發消息。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296393
    m_Localized: 'TV: 我們收到了接連不斷的報告——鄰近城市現正發生群眾暴動。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296394
    m_Localized: 'TV: 由於情況尚未得到解決，FEMA的工作人員已經封鎖了該片區域。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296395
    m_Localized: 'TV: 還請各位盡量留在室內、不要外出，晚點將會發佈更為詳細的指示。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296396
    m_Localized: 'TV: 不要忘了——協助他們，就是在拯救我們的世界。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296397
    m_Localized: 'TV: 以上便是目前掌握的最新資訊。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296398
    m_Localized: 'TV: 還請大家固守原處，耐心等待後續指令。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296399
    m_Localized: 'TV: 就連機器也需要休息，更何況是人類。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296400
    m_Localized: 'TV: 只要抽上一口馬爾戈羅香菸，即可盡情放鬆、擺脫壓力。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296401
    m_Localized: 'TV: 馬爾戈羅香菸——專為男人而生。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296402
    m_Localized: 'TV: （免責聲明：對於因吸菸而造成的生命、健康損害，本公司一概不負任何責任）'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296403
    m_Localized: 'TV: 大家，午安——您現在收看的是新聞報導。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296404
    m_Localized: 'TV: 突發消息。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296405
    m_Localized: 'TV: 城裡最近發生的事件浮出全新細節。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296406
    m_Localized: 'TV: 不久之前，某個隔離區受到了一名持械暴徒的襲擊。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296407
    m_Localized: 'TV: 目前，尚不清楚對方目的、也不知道是否存在共犯。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296408
    m_Localized: 'TV: 其中數名身份不明的觀察對象藉機逃離。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296409
    m_Localized: 'TV: 寂靜，是死亡的信號。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296410
    m_Localized: 'TV: 寂靜，會將靈魂抽乾。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296411
    m_Localized: 'TV: 然而，比虛無更糟的……是鐘鳴。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296412
    m_Localized: 'TV: 喪禮的鐘鳴。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296413
    m_Localized: 'TV: 一旦鐘鳴，耳朵裡面將會滋生某種東西。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296414
    m_Localized: 'TV: 最後，剩下的只有耳垢、以及糟糕的念頭。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296415
    m_Localized: 'TV: 偽人便是靠此存活。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296416
    m_Localized: 'TV: 偽人會陷入如同蛛絲的思緒中，難以掙脫。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296417
    m_Localized: 'TV: 對於它們來說，鐘鳴更為響亮——因而產生的耳垢也更多。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296418
    m_Localized: 'TV: 今天的這起事件引發了眾多的猜測。不僅如此，目擊者的描述也各不相同。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296419
    m_Localized: 'TV: 既有報告提及槍手為獨自一人行動、沒有其他共犯，也有消息指出下手的是一群戴著兜帽的武裝分子。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296420
    m_Localized: 'TV: 然而，最為嚴峻的挑戰或許仍在前方等待著我們。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296421
    m_Localized: 'TV: 由於城市已被封鎖，附近區域的屍體處理工作也不得不暫時停止。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296422
    m_Localized: 'TV: 不過，針對市民展開的常規檢查仍將繼續進行。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296423
    m_Localized: 'TV: 如果有條件火化遺體，還請立即執行。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296424
    m_Localized: 'TV: 否則，希望大家耐心等待。直至情況得到解決之前，還請不要拋棄任何積壓在手頭上的屍體。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296425
    m_Localized: 'TV: 以上便是目前掌握的最新資訊，敬請關注後續消息。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296426
    m_Localized: 'TV: 大家，午安——您現在收看的是新聞報導。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296427
    m_Localized: 'TV: 目前，FEMA正在為受到隔離區襲擊一事影響的災民提供援助。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296428
    m_Localized: 'TV: 由於現有設施均已人滿為患，經過研討之後、他們決定採取以下措施：'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296429
    m_Localized: 'TV: 受到疏散的群眾將會暫時被安置於城郊的各棟房子之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296430
    m_Localized: 'TV: 幸運的是，當地的房主非常理解FEMA的難處，願意配合、提供庇護。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296431
    m_Localized: 'TV: 然而，令人擔心的是……目前只找到了小部分流竄人員。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296432
    m_Localized: 'TV: 此外，FEMA還公佈了一項全新的特徵：'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296433
    m_Localized: 'TV: 流血的牙齦。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296434
    m_Localized: 'TV: 如果具備這種症狀的人來到門前，千萬不要於對方有所接觸。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296435
    m_Localized: 'TV: 耐心等待定期巡邏的工作人員到來之後，立即對其進行檢舉即可。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296436
    m_Localized: 'TV: 以上便是目前掌握的最新資訊。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296437
    m_Localized: 'TV: 還請大家固守原處，耐心等待後續指令。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296438
    m_Localized: 'TV: 接下來是關於某個新興邪教的特別報導。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296439
    m_Localized: 'TV: 偽人不僅偽裝著自己、混於公眾之間，甚至有可能已經滲透進了我們的思緒之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296440
    m_Localized: 'TV: 據報告稱，數座城市都出現了有組織、有預謀的邪教活動。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296441
    m_Localized: 'TV: 針對他們的指控包括：'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296442
    m_Localized: 'TV: 活人獻祭、敬拜未知神袛，以及非常有可能與偽人存在某種關聯。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296443
    m_Localized: 'TV: 據最近的報告稱，這一團體現已公開表態、堅決反對FEMA。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296444
    m_Localized: 'TV: 起初，只是停留在進行口頭騷擾、發佈不當言論。如今，已經開始變得肆無忌憚、直接採取各種行動。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296445
    m_Localized: 'TV: 最近，城裡發生的一系列事件恐怕都與他們脫不了關係。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296446
    m_Localized: 'TV: 我們在此向各位觀眾朋友發出呼籲——千萬不要與這些「新興信徒」進行接觸。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296447
    m_Localized: 'TV: 幫助——甚至是對其行為表示贊同、產生共鳴，都有可能會導致被捕。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296448
    m_Localized: 'TV: 以上便是目前掌握的最新資訊，敬請關注後續消息。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296449
    m_Localized: 'TV: 大家，午安——您現在收看的是新聞報導。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296450
    m_Localized: 'TV: 雖然城裡的狀況已經逐漸穩定下來，不過還是沒能找到全部的流竄人員。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296451
    m_Localized: 'TV: 同時，屍體處理工作也已經恢復正常。只是，新的難題亦接踵而至。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296452
    m_Localized: 'TV: 據最近的報告稱，大街出現了數批成群結隊的流浪犬隻。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296453
    m_Localized: 'TV: FEMA已經派遣工作人員前往處理這一威脅。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296454
    m_Localized: 'TV: 此外，還公佈了潛在危險人士的一項全新的特徵：'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296455
    m_Localized: 'TV: 皮膚過敏。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296456
    m_Localized: 'TV: 針對城市的襲擊事件目前仍舊處於調查之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296457
    m_Localized: 'TV: 雖說，尚不清楚下手的人究竟是單獨行動、抑或是團夥作案……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296458
    m_Localized: 'TV: 然而——連同偽人造成的種種威脅之內，FEMA一定會遏止情況惡化下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296459
    m_Localized: 'TV: 如果就識別他人是否具備偽人的特徵一事抱持任何疑問，隨時都可以撥打FEMA的服務電話：'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296460
    m_Localized: 'TV: {0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296461
    m_Localized: 'TV: 以上便是目前掌握的最新資訊。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296462
    m_Localized: 'TV: 還請大家固守原處，耐心等待後續指令。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296463
    m_Localized: 'TV: 接下來是關於赤道一帶各個國家目前所處狀況的報導。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296464
    m_Localized: 'TV: 今晚，來自該處的消息令人無比擔憂。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296465
    m_Localized: 'TV: 不斷蔓延的野火、極端的炎熱天氣以及隨之而來的乾旱對各地造成了近乎毀滅性的打擊。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296466
    m_Localized: 'TV: 據最近的報告稱，溫度已經飆升至一個難以置信的水準、光是接觸地面就可能會造成三度灼燒。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296467
    m_Localized: 'TV: 目前，尚不清楚具體傷亡人數、也無辦法進行疏散工作。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296468
    m_Localized: 'TV: 至今為止，我們的政府也未能與受災地區的相關當局取得聯絡。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296469
    m_Localized: 'TV: 不過——一旦條件允許，FEMA將會立即派遣工作人員前往現場協助開展救援工作。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296470
    m_Localized: 'TV: 以上便是目前掌握的最新資訊，敬請關注後續消息。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296471
    m_Localized: 'TV: 大家，午安——您現在收看的是新聞報導。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296472
    m_Localized: 'TV: 城裡的狀況依舊不容樂觀。鑒此，封鎖也並未得到解除。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296473
    m_Localized: 'TV: 正所謂一波未平、一波又起，我們收到了目擊報告——受到取締的邪教成員最近出現在城郊一帶。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296474
    m_Localized: 'TV: 據稱，他們正在籌備某種需要用到明火的儀式。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296475
    m_Localized: 'TV: FEMA相信這一團體直接參與到了針對隔離區的發起的數次襲擊之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296476
    m_Localized: 'TV: 遺憾的是——鑒於城裡的局勢……不管是FEMA、抑或是軍隊，目前都沒有餘力派遣專門的部隊前來進行調查。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296477
    m_Localized: 'TV: 如果有邪教成員來到門前，還請立即撥打FEMA的服務電話：{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296478
    m_Localized: 'TV: 此外，他們還公佈了一項全新的特徵：'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296479
    m_Localized: 'TV: 腋窩長出真菌。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296480
    m_Localized: 'TV: 以上便是目前掌握的最新資訊。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296481
    m_Localized: 'TV: 還請大家固守原處，耐心等待後續指令。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296482
    m_Localized: 'TV: 接下來是關於兩極地區的熱點速遞。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296483
    m_Localized: 'TV: 太陽再次發威。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296484
    m_Localized: 'TV: 科學家、研究者發佈了令人擔憂的最新預測。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296485
    m_Localized: 'TV: 如果當前的熱浪持續不退，極地冰蓋將完全融化、進而引發嚴重的洪災。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296486
    m_Localized: 'TV: 雖說全國上下的頂尖專家都已經殫精竭慮地對當前的氣候異常進行探究、解構，然而——至今，仍然沒有找到解決問題的答案。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296487
    m_Localized: 'TV: 以上便是目前掌握的最新資訊，敬請關注後續消息。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296488
    m_Localized: 'TV: 突發消息。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296489
    m_Localized: 'TV: 城裡的狀況完全沒有絲毫想要好轉的跡象。這次災變仍在不斷惡化。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296490
    m_Localized: 'TV: 隨著冰川的融化，海平面正在迅速上升。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296491
    m_Localized: 'TV: 沿海地區——以及坐落其中的各大城市，將有可能被洪水淹沒。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296492
    m_Localized: 'TV: 幾個受到汙染、包含放射性物質的湖泊已經開始蒸發。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296493
    m_Localized: 'TV: 據科學家、研究者預測，這一現象非常有可能會因此導致酸雨。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296494
    m_Localized: 'TV: 如果聽見雷聲，還請立即尋找可以躲藏的地方、避免遇害。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296495
    m_Localized: 'TV: 此外，遺憾的是……城裡的封鎖依舊並未得到解除。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296496
    m_Localized: 'TV: 目前，FEMA尚未將所有流竄人員抓捕歸案。同時，他們公佈了關於偽人的一項全新的特徵：'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296497
    m_Localized: 'TV: 快速移動的瞳孔。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296498
    m_Localized: 'TV: 以上便是目前掌握的最新資訊……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296499
    m_Localized: 'TV: 由於攝影棚有可能會遭到襲擊，我們不得不提前中止本次報導。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296500
    m_Localized: 'TV: 如果就識別偽人一事抱持任何疑問，還請撥打服務電話：{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296501
    m_Localized: 'TV: 播報結束。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296502
    m_Localized: 'TV: 重大事件。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296503
    m_Localized: 'TV: 不久之前，FEMA逮捕了絕大多數的政府官員。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296504
    m_Localized: 'TV: 據報告稱，其中一些被認定是偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296505
    m_Localized: 'TV: 由於國會已無法正常運作，FEMA將暫時接管政府職能。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296506
    m_Localized: 'TV: 與此同時……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296507
    m_Localized: 'TV: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296508
    m_Localized: 'TV: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296509
    m_Localized: 'TV: 稍等一下……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296510
    m_Localized: 'TV: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296511
    m_Localized: 'TV: 剛剛收到來自FEMA的訊息：'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296512
    m_Localized: 'TV: 針對城裡的隔離區發起數次襲擊的暴徒已突破封鎖。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296513
    m_Localized: 'TV: 重複——針對城裡的隔離區發起數次襲擊的暴徒已突破封鎖，現正四處逃遁。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296514
    m_Localized: 'TV: 還請大家封好窗戶、鎖緊大門。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296515
    m_Localized: 'TV: 固守原處，耐心等待後續指令。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296516
    m_Localized: 'TV: 播報結束。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296517
    m_Localized: 'Window: 鄰居的房子坐落於乾草地上。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296518
    m_Localized: 'Window: 窗戶沒有亮光，看來已經就寢。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296519
    m_Localized: 'Window: 幾個醉漢四仰八叉地躺在大街之上。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296520
    m_Localized: 'Window: 雖然地面非常冰冷，不過似乎睡得很熟。對於他們來說，此時此刻、一切安好。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296521
    m_Localized: 'Window: 不遠處是鄰居的房子——現在，他正於你家做客。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296522
    m_Localized: 'Window: 窗戶映照出了一點亮光，看來……他的家人正等待其歸去。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296523
    m_Localized: 'Window: 外面……一片死寂。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296524
    m_Localized: 'Window: 空無一人。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296525
    m_Localized: 'Window: 就連醉漢也沒有出門。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296526
    m_Localized: 'Window: 難道，是在害怕著什麼嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296527
    m_Localized: 'Window: 透過窗戶，能看到鄰居和他的女兒。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296528
    m_Localized: 'Window: 兩人正在開心地玩耍，想要忘記周遭的恐怖……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296529
    m_Localized: 'Window: 即便，只有一瞬也好。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296530
    m_Localized: 'Window: 路上站著個人，通體蒼白、如同死者。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296531
    m_Localized: 'Window: 對方的皮膚有著奇怪的褶皺。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296532
    m_Localized: 'Window: 就好像披著一件尺寸不合的外衣一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296533
    m_Localized: 'Window: 雖然無法從此處看到他的眼睛，不過你能感到對方正死盯著你。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296534
    m_Localized: 'Window: 恐懼湧上心頭，你向上帝祈禱——希望這個陰森、恐怖的偽人徑直離開，不要前來造訪。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296535
    m_Localized: 'Window: 一群FEMA的工作人員站在鄰居的房子旁邊。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296536
    m_Localized: 'Window: 不知，他們正在談論什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296537
    m_Localized: 'Window: 也許，想要採集土壤樣本？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296538
    m_Localized: 'Window: 抑或，是在找地方建基地？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296539
    m_Localized: 'Window: 透過窗戶，你看到一群全副武裝的士兵。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296540
    m_Localized: 'Window: 顯然，是從城裡派來此處的、專門為FEMA的工作人員提供保全。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296541
    m_Localized: 'Window: 能零零碎碎地聽見他們正在談論某個通體蒼白、赤裸上身的男性。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296542
    m_Localized: 'Window: 也許，他們想要搜尋那個詭異的偽人？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296543
    m_Localized: 'Window: 鄰居先前塗白的房子已被燒毀、變得焦黑。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296544
    m_Localized: 'Window: 看來，烈焰剛熄滅不久。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296545
    m_Localized: 'Window: 難道，有人故意縱火？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296546
    m_Localized: 'Window: 鄰居一家人到底怎樣了？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296547
    m_Localized: 'Window: 不知，是否還活著？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296548
    m_Localized: 'Window: 憂慮的思緒在腦海裡不斷翻騰，因無法理解這一切而產生的絕望徹底地壓垮了你。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296549
    m_Localized: 'Window: 昨天剛來的整隊士兵都已經死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296550
    m_Localized: 'Window: 看來，這裡上演過一場大規模的屠殺。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296551
    m_Localized: 'Window: 整條大街上都散落著屍體——其中一具的頭顱不知所蹤。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296552
    m_Localized: 'Window: 難道，是之前那個通體蒼白、極其詭異的傢伙所下的手？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296553
    m_Localized: 'Window: 你正看著鄰居房子的廢墟。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296554
    m_Localized: 'Window: 只剩下一個幽靈般的外殼，儘管直到最近還有一個幸福的家庭住在那裡……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296555
    m_Localized: 'Window: 一種奇怪的感覺襲來，彷彿你早就知道會發生這種事……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296556
    m_Localized: 'Window: 就像……你感覺到死亡很快就會降臨到這所房子。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296557
    m_Localized: 'Window: 你看到一根木樁，上面插著一個戴著頭盔的頭骨。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296558
    m_Localized: 'Window: 頭骨上還有一些焦黑的皮膚，看起來像是有人把牙齒都拔掉了。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296559
    m_Localized: 'Window: 這顆頭顱已經在這裡一整天了。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296560
    m_Localized: 'Window: 整個恐怖的景象看起來像是一種威脅。可能是那個詭異蒼白的偽人留下的。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296561
    m_Localized: 'Window: FEMA官員正在檢查最近大屠殺的現場。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296562
    m_Localized: 'Window: 他們收走了所有死去士兵的裝備和武器，以免落入掠奪者手中。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296563
    m_Localized: 'Window: 他們可能原本期望那個蒼白的偽人不會在與一群武裝人員的遭遇中倖存下來。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296564
    m_Localized: 'Window: 現在又多了幾個屍袋。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296565
    m_Localized: 'Window: 你看見一名女性伏在自己受了重傷的丈夫身上失聲痛哭。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296566
    m_Localized: 'Window: 你分辨不出這名男性是否還活著。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296567
    m_Localized: 'Window: 她吃力地拖拽著他的軀體，試圖遠離炮火……臉龐早已被淚水打濕。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296568
    m_Localized: 'Window: 你的腦海裡盤踞著一個念頭——恐怕，事情只會變得更加糟糕。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296569
    m_Localized: 'Window: 田間小徑之上，散落著一具又一具的屍體……全部都是想要逃跑的市民。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296570
    m_Localized: 'Window: 附近站著一名FEMA的工作人員。看來，就是他做的好事。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296571
    m_Localized: 'Window: 手裡握著來福槍，炮管還在冒著煙。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296572
    m_Localized: 'Window: 驚慌失措的民眾如同無頭蒼蠅一般蜂擁至附近的房子。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296573
    m_Localized: 'Window: 不斷捶打著大門，迫切地需要庇護。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296574
    m_Localized: 'Window: 然而，看來……沒人願意讓他們進去。畢竟，誰也不想自尋麻煩。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296575
    m_Localized: 'Window: 一群遭到驅逐的市民站在鄰居那棟早就已經變成廢墟的房子旁邊。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296576
    m_Localized: 'Window: 看得出來，他們尚未從震驚之中緩過神來……正你一言、我一語地低聲交談著。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296577
    m_Localized: 'Window: 似乎，想要在那裡避難。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296578
    m_Localized: 'Window: 只是，這個世界上真的還有能供人躲藏、保證安全的地方嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296579
    m_Localized: 'Window: 路上站著一個拿著來福槍的傢伙，看著已經完全失去了理智。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296580
    m_Localized: 'Window: 他的夾克上佈滿了拔下來的牙齒、挖出來的眼球，以及……無法辨認的殘骸。從這裡看不清楚。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296581
    m_Localized: 'Window: 萬一這個傢伙殺人並非出於自衛，而是為了取樂、收集戰利品——該怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296582
    m_Localized: 'Window: 無論如何，你衷心希望自己不會成為他的敵人。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296583
    m_Localized: 'Window: 燈桿上吊著一個人，還掛了個牌子、上頭寫著——「你奪走了我的一切。」'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296584
    m_Localized: 'Window: 難道，他遭遇了搶劫？抑或，自己的家人被FEMA給抓走了？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296585
    m_Localized: 'Window: 思緒在腦海中狂奔，卻還是得不到答案——唯有猜測。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296586
    m_Localized: 'Window: 一群遭到FEMA驅逐的市民在鄰居那棟早就已經成為廢墟的房子裡安頓了下來。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296587
    m_Localized: 'Window: 雖然地上的部分幾近全毀，不過……地下的空間卻令人出乎意料地逃過了一劫。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296588
    m_Localized: 'Window: 因此，成為了他們安全的港灣。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296589
    m_Localized: 'Window: 然而，又能躲多久呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296590
    m_Localized: 'Window: 野狗遊蕩在大街之上。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296591
    m_Localized: 'Window: 軀體上佈滿了淺淺的灼痕，飢餓使它們變得瘦弱不堪。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296592
    m_Localized: 'Window: 雖然，你待在自己的房子裡面、根本就沒有必要去害怕……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296593
    m_Localized: 'Window: 不過，你的心頭始終縈繞著一個揮之不去的想法——現在，還是不要到外面去為好。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296594
    m_Localized: 'Window: 一群帶著行李的市民聚集在了房子附近，正你一言、我一語地低聲交談著。似乎，是想要避免被FEMA的工作人員給聽到。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296595
    m_Localized: 'Window: 看來，他們來自隔離區——取代先前的房主、被安置於這一帶。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296596
    m_Localized: 'Window: 此刻，燈桿上吊著的傢伙看著就像一個糟糕透頂的「歡迎」標誌。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296597
    m_Localized: 'Window: 一個全副武裝、專門獵殺偽人的傢伙正持槍脅迫一群倖存者。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296598
    m_Localized: 'Window: 恐怕，是偶然之間發現的他們。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296599
    m_Localized: 'Window: 你聽到了斷斷續續的叫喊、一個瘋狂的聲音正在怒吼。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296600
    m_Localized: 'Window: 到底，誰能活在這個新的世界之中？恐怕……並不會是人數佔優的那一方。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296601
    m_Localized: 'Window: FEMA的工作人員站在死去的野狗旁邊。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296602
    m_Localized: 'Window: 其中一個正往平板電腦上記錄著些什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296603
    m_Localized: 'Window: 只是……憑藉在場屈指可數的幾人，真的能阻擋一群如饑似渴的野獸嗎？看著並不可能。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296604
    m_Localized: 'Window: 兩名工作人員站在燈桿旁邊、盯著吊在上面的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296605
    m_Localized: 'Window: 看來，他們終於發現了這一帶的……「主要景點」。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296606
    m_Localized: 'Window: 兩人就像丈二和尚一樣，摸不著頭腦——搞不懂在沒有梯子的情況下，他到底是怎麼掛到上面去的。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296607
    m_Localized: 'Window: 一整群的人都已經死光了。飢餓的野狗正對著他們的屍體大快朵頤。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296608
    m_Localized: 'Window: 附近散落著大量的彈殼。看來，是那個獵人下的手——甚至，還拿走了一些戰利品。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296609
    m_Localized: 'Window: 這個世界的瘋狂已經遠遠地超出了我們的想像。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296610
    m_Localized: 'Window: 邪教徒把柴火堆到了一起。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296611
    m_Localized: 'Window: 難道，他們是想要燒死某人嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296612
    m_Localized: 'Window: 答案很快就會自動揭曉。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296613
    m_Localized: 'Window: 然而，為了完成他們所追求的事業、多少無辜的生命會因此犧牲？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296614
    m_Localized: 'Window: 路上站著一個已經陷入了瘋狂的槍手。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296615
    m_Localized: 'Window: 一手拎著汽油桶，一手拿著燃燒彈。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296616
    m_Localized: 'Window: 難道，他是想要把整座小鎮給燒成平地嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296617
    m_Localized: 'Window: 沒人告訴過他，這裡住的都是受到疏散、來自隔離區的民眾嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296618
    m_Localized: 'Window: 之前躲在鄰居那棟早就已經成為廢墟的房子裡的人、屍體正被中午的太陽不斷灼燒。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296619
    m_Localized: 'Window: 以此為食的野狗已經落荒而逃——就好像是害怕著什麼東西一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296620
    m_Localized: 'Window: 萬一這個「東西」不是FEMA，而是其他的什麼……該怎麼辦？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296621
    m_Localized: 'Window: 邪教徒把自己綁在了篝火附近。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296622
    m_Localized: 'Window: 難道，他們想進行活人獻祭？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296623
    m_Localized: 'Window: 一想到這個，你的思緒就變得無比混亂。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296624
    m_Localized: 'Window: 對死亡的恐懼令人失去僅剩的理智，開始做出一些難以言喻的瘋狂舉動。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296625
    m_Localized: 'Window: 只是經過短短數週，就已經出現了如此可怖的行徑……你不完全敢想像接下來會變成什麼樣子。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296626
    m_Localized: 'Window: 熊熊燃燒的房子閃爍著詭譎的光芒，遠處傳來了陣陣尖叫、嘶吼……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296627
    m_Localized: 'Window: 你很清楚——造成這一切的元兇就是那個想要把偽人給通通消滅殆盡的瘋子。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490688
    m_Localized: 'Window: 你的房子是下一個目標嗎？他會在什麼時候動手——明天？下週？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490689
    m_Localized: 'Window: 遲早，你得直接面對這個早就已經殺紅了眼的傢伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490690
    m_Localized: 'Window: 焦黑的屍體已經消失不見。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490691
    m_Localized: 'Window: 只剩一團怪異、黏糊的物質，看起來……就跟淤泥沒什麼兩樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490692
    m_Localized: 'Window: 你很好奇。難道……有什麼東西先是把殘留的血肉給融化掉了，然後將其大口吞進肚子？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490693
    m_Localized: 'Window: 要真是這樣的話，你希望這個生物能一直躲在暗處。否則——在看到它的瞬間，你的心智……說不定會頃刻崩潰。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490694
    m_Localized: 'Window: FEMA的工作人員圍在焦黑的屍體旁邊。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490695
    m_Localized: 'Window: 記錄著這些邪教成員的死亡情況。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490696
    m_Localized: 'Window: 因恐懼和痛苦而扭曲的表情永遠凝固在了他們的臉上，就好像是在臨終之前看到了什麼毛骨悚然的東西一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490697
    m_Localized: 'Window: 附近的每棟房子都已經成為廢墟。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490698
    m_Localized: 'Window: 只剩你的房子。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490699
    m_Localized: 'Window: 再也沒有其他人可以阻止這個瘋子的步伐。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490700
    m_Localized: 'Window: 無論如何，都得鼓起勇氣、好好面對了。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490701
    m_Localized: 這裡是調度中心——呼叫隔離區，我們需要進行狀況核查。代碼51。請詳細報告凌晨3點發生的爆炸事件。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490702
    m_Localized: 編號32-8，正在回報。代碼60。平民出現重大傷亡，工作人員受到波及……
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490703
    m_Localized: 編號28-8，正在回報。代碼451。請求調派焚燒小組前來處理屍體。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490704
    m_Localized: 收到。啟動代碼984。封鎖整座城市，以待調查。請固守原處、等待增援。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490705
    m_Localized: 如果你能聽到這則廣播——切記，千萬不要靠近城郊。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490706
    m_Localized: FEMA的工作人員正在射殺任何試圖離開的民眾。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490707
    m_Localized: 我不清楚發生了什麼事……我只是想離開這裡而已。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490708
    m_Localized: 救命——
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490709
    m_Localized: 襲擊了隔離區的並不是這些傢伙。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490710
    m_Localized: 我看見了。我……親眼看見了。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490711
    m_Localized: 罪魁禍首根本就不是人類。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490712
    m_Localized: 我們是受到驅逐的市民。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490713
    m_Localized: 現正躲在一棟燒毀房子的地下室裡——如果你也被FEMA趕出了家門，不妨……到這裡來避避風頭。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490714
    m_Localized: 距離隱士的住處很近。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490715
    m_Localized: 我們已經不剩什麼食物，很快就會開始餓肚子了。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490716
    m_Localized: 如果有人能伸出援手、分我們一點吃的，就太好了。還請幫幫我們。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490717
    m_Localized: 致所有正在收聽的民眾……
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490718
    m_Localized: FEMA正在試圖干擾整座城市的通訊信號，以封鎖消息。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490719
    m_Localized: 他們想要隱瞞在這裡發生的事情。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490720
    m_Localized: 他們想要把一切都歸咎於那個在隔離區大開殺戒的瘋子身上。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490721
    m_Localized: 如果你還待在城裡——趕……緊逃跑，這裡……並不安……全。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490722
    m_Localized: 避……開FEMA的巡邏人員，他們會……毫不猶……豫地殺了……你。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490723
    m_Localized: 趁……還有機……會，趕緊……逃……跑——
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490724
    m_Localized: 他們……不應……該……把屍體……給……燒毀的。這樣……做，會把……吸引過……來……
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490725
    m_Localized: 如果……他們把……屍體，會……把那……個東西給——
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490726
    m_Localized: 調……中心……呼叫所有……F……MA……人員……
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490727
    m_Localized: 全新……指……令——停……用代碼955，啟用代……碼451。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490728
    m_Localized: 不要……燒……毀屍體。改用……進行處……理。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490729
    m_Localized: 重……複，啟用代碼451。如果燒……毀屍體，將會引……來威脅——
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490730
    m_Localized: 編……號18-8，正在……回報。我們……無法阻止……對方。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490731
    m_Localized: 目……標離開了城市範……圍，請……求立即……增援。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490732
    m_Localized: 重……複：我們需……要增援。我們無法獨自……阻止對方。
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490733
    m_Localized: 'Phone: 你好，鄰居——很高興能聽到你的聲音。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490734
    m_Localized: 'Phone: 好了……你有讓其他人進屋嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490735
    m_Localized: 'Phone: 要是還沒有的話，你就得抓緊時間、不能再拖下去了。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490736
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490737
    m_Localized: 'Phone: 你有什麼想問的事情嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490738
    m_Localized: 你也有讓其他人進屋嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490739
    m_Localized: 要判斷某人是否偽人，到底得對上幾項特徵？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490740
    m_Localized: 你是怎麼解決食物問題的？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490741
    m_Localized: 再見（掛斷電話）
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490742
    m_Localized: 'Phone: 是的。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490743
    m_Localized: 'Phone: 雖說，我的女兒討厭這樣。然而……又能怎麼辦呢，對吧？畢竟，除此以外、別無他法。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490744
    m_Localized: 'Phone: 她一直跟我說要出門，因為——這樣就能擺脫、遠離待在家裡的陌生人了。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490745
    m_Localized: 'Phone: 只是，白天沒有辦法出去。於是，我們就只好等到晚上。沒錯，的確非常危險……我也知道。不過，實在是禁不住她的死纏爛打。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490746
    m_Localized: 'Phone: 我也想知道……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490747
    m_Localized: 'Phone: 誰都不知道究竟得對上幾項特徵，才能心有成竹、蓋棺定論地確定自己眼前的傢伙是個偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490748
    m_Localized: 'Phone: 我能說的，只有——如果只發現了一項，就不要急著下定論。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490749
    m_Localized: 'Phone: 畢竟，有可能只是虛驚一場。譬如……對方剛好在這一系列的爛事開始之前去看了牙醫，諸如此類。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490750
    m_Localized: 'Phone: 我運氣不錯——災變開始之前，剛好囤了些貨。要是沒記錯的話……你應該也是，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490751
    m_Localized: 'Phone: 如果需要什麼比較特殊的東西，我記得最近新出了一項食品配送服務——安憩速遞。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490752
    m_Localized: 'Phone: 只是，我忘了他們的號碼。不過，你可以留意一下電視、或是收音機裡的廣告，上面應該有說。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490753
    m_Localized: 'Phone: 保重。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490754
    m_Localized: 'Phone: 你好，鄰居。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490755
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490756
    m_Localized: 'Phone: 你看到外面的慘狀了嗎？好幾個十來歲的孩子……被殺死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490757
    m_Localized: 'Phone: 我還以為街上並沒有太過危險。看來，我錯得離譜。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490758
    m_Localized: 'Phone: 我的女兒一直想要出去玩。之前，我還覺得沒什麼……現在，看到這些屍體之後——我就不這麼認為了。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490759
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490760
    m_Localized: 'Phone: 我絕對不會再像這樣拿她的性命來冒險了。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490761
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490762
    m_Localized: 'Phone: 天啊……要是她出了什麼事的話，我這輩子沒有辦法原諒自己。要知道，她——可是我的整個世界。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490763
    m_Localized: 你的女兒還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490764
    m_Localized: 是誰下的手？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490765
    m_Localized: 一定要小心（掛斷電話）
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490766
    m_Localized: 'Phone: 是誰下的手？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490767
    m_Localized: 'Phone: 草叢長得很高、非常茂密，照理她應該是注意不到的。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490768
    m_Localized: 'Phone: 不過，到家之後……她卻說，自己在裡面看到了一張人臉。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490769
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490770
    m_Localized: 'Phone: 我試著說服她，一切都只不過是錯覺罷了。然而……她並不這麼認為。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490771
    m_Localized: 'Phone: 某個高高瘦瘦、通體蒼白的……東西。要是我沒記錯的話，它不是只會襲擊獨自一人待在房子裡的市民嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490772
    m_Localized: 'Phone: 我還以為一切都在自己的掌握之中。心想——如果看到了那個傢伙，我們就直接回家。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490773
    m_Localized: 'Phone: 我根本就沒想到她有可能會見到屍體……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490774
    m_Localized: 'Phone: 謝謝。你也要小心。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490775
    m_Localized: 'Phone: 你好，鄰居。謝謝你打電話過來。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490776
    m_Localized: 'Phone: 說實話，我直到現在還心有餘悸。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490777
    m_Localized: 'Phone: 殺人兇手、士兵，以及——FEMA……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490778
    m_Localized: 'Phone: 昨晚，他們甚至找上門來了。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490779
    m_Localized: 'Phone: 先是一邊問裡面都住了什麼人、一邊在平板電腦上寫著些東西，然後……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490780
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490781
    m_Localized: 'Phone: 其中的一個傢伙就把我的一個住客給從房子裡揪了出來、帶走了。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490782
    m_Localized: 他們把你的住客帶到哪裡去了？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490783
    m_Localized: 幸好他們沒把你的女兒帶走
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490784
    m_Localized: 其實……FEMA到底是個什麼機構？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490785
    m_Localized: 保重（掛斷電話）
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490786
    m_Localized: 'Phone: 我也不知道。他們只說，要把人帶回去進行「檢查」。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490787
    m_Localized: 'Phone: 我還以為有了士兵和聯邦緊急事件管理局的工作人員出來干預，事情很快就會有所好轉。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490788
    m_Localized: 'Phone: 早該知道……他們根本就不會幫助我們、也不會護送大家前往安全的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490789
    m_Localized: 'Phone: 我是絕對不會讓這種事情發生的。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490790
    m_Localized: 'Phone: 想都別想。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490791
    m_Localized: 'Phone: 要是那群混蛋敢動她一根手指頭的話，我對天發誓——絕對會把他們給煎皮拆骨。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490792
    m_Localized: 'Phone: 我也不太清楚。說實話，大家都沒怎麼聽說過他們的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490793
    m_Localized: 'Phone: 只知道，這些傢伙突然之間就冒了出來、表現出一副……一切盡在自己掌控之中、居高臨下的態度。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490794
    m_Localized: 'Phone: 不過，他們到底是怎麼察覺到這一系列特徵的？畢竟，尋常人類同樣也有相同、或是相似的特質。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490795
    m_Localized: 'Phone: 我感覺，他們應該還有什麼東西瞞著大家……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490796
    m_Localized: 'Phone: 謝謝。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490797
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490798
    m_Localized: 'Phone: 真是做夢都想不到，我們現在竟然會活在人間煉獄之中。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490799
    m_Localized: 'Phone: 不光有能活活曬死人的太陽、有會大開殺戒的偽人，現在——還得應付FEMA……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490800
    m_Localized: 'Phone: 問題一個接著一個地冒出來，卻從來沒辦法得到任何的解答。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490801
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490802
    m_Localized: 'Phone: 聽好，鄰居……我想鄭重地拜託你一件事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490803
    m_Localized: 'Phone: 要是我有什麼三長兩短的話，答應我——一定要幫忙照顧好我的女兒。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490804
    m_Localized: 我答應你
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490805
    m_Localized: 我無法做出任何承諾
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490806
    m_Localized: 'Phone: 謝謝，鄰居。我就知道，自己可以信任你。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490807
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490808
    m_Localized: 'Phone: 好啦，我得掛斷了。一定要堅持下去，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490809
    m_Localized: 'Phone: 我……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490810
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490811
    m_Localized: 'Phone: 你真的不願意向她伸出援手？唉……她還小，我不想讓她就這樣孤單一人。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490812
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490813
    m_Localized: 'Phone: 該死，我得掛斷了……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490814
    m_Localized: 'Phone: 再見，鄰居。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490815
    m_Localized: 'Phone: 你好。你已撥通安憩速遞的服務電話。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490816
    m_Localized: 'Phone: 請問，你想要購買什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490817
    m_Localized: 一罐EnerJeka，謝謝
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490818
    m_Localized: 一罐咖啡，謝謝
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490819
    m_Localized: 我改變主意了，不想下訂單了
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490820
    m_Localized: 'Phone: 抱歉。我們無法接受這筆訂單，因為你先前已下過一筆訂單。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490821
    m_Localized: 'Phone: 由於需求旺盛，每人、每天只能下一筆訂單。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490822
    m_Localized: 'Phone: 如果想要下新的訂單，還請改天再打給我們。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490823
    m_Localized: 'Phone: 謝謝，再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490824
    m_Localized: 'Phone: 好的。我們已經收到了你的訂單，商品預計將會在明天送達。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490825
    m_Localized: 'Phone: 好的。我們已經收到了你的訂單，商品預計將會在明天送達。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490826
    m_Localized: 'Phone: 你好。你已撥通聯邦緊急事件管理局醫務組的服務電話。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490827
    m_Localized: 'Phone: 我們可以就偽人的篩查一事、以及相關的流程提供諮詢。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490829
    m_Localized: 'Phone: 你有什麼想問的事情嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490830
    m_Localized: 關於牙齒，有什麼需要注意的地方？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490831
    m_Localized: 關於指甲，有什麼需要注意的地方？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490832
    m_Localized: 關於眼睛，有什麼需要注意的地方？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490833
    m_Localized: 謝謝，我沒有其他問題了
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490834
    m_Localized: 'Phone: 為確保檢查的準確程度，建議避免吸食菸草產品。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490835
    m_Localized: 'Phone: 抽菸很有可能會對牙齒的狀態造成不良影響，導致結果不可靠。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490836
    m_Localized: 'Phone: 為確保檢查的準確程度，還請不要在檢查前洗手。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490837
    m_Localized: 'Phone: 水會沖去表面汙垢，導致結果出現錯誤。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490838
    m_Localized: 'Phone: 為確保檢查的準確程度，還請避免飲用咖啡或其他包含咖啡鹼的飲品。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490839
    m_Localized: 'Phone: 不僅會導致失眠、心神不寧，還會引起雙眼紅腫。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490840
    m_Localized: 'Phone: 非常感謝你配合聯邦緊急事件管理局的工作。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490841
    m_Localized: 'Phone: 我們會記住你為解決目前面臨的這個危機所作出的一切努力。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490842
    m_Localized: 'Phone: 確保檢查的準確程度，不光是在幫你自己、還有整個人類的族群。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490843
    m_Localized: 'Phone: 你好。正在為你轉接偽人驅離專家——還請稍候。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490844
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490845
    m_Localized: 'Phone: 你好？請問哪位？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490846
    m_Localized: 你是什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490847
    m_Localized: 你為什麼想要知道我是哪位？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490848
    m_Localized: 'Phone: 看來，你沒有辦法立即回答說自己是個人類……我明白了。看來，喚作「偽人」的邪靈早就已經在你體內扎根了。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490849
    m_Localized: 'Phone: 你的時間已經所剩無幾——現在，聽好。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490850
    m_Localized: 'Phone: 告訴我，你有試過把一塊麵包留在廚房裡面嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490851
    m_Localized: 沒有……歸根到底，我為什麼要這樣做？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490852
    m_Localized: 一塊麵包？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490853
    m_Localized: 'Phone: 當然是為了能把喚作「偽人」的邪靈從你的體內給驅離出去。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490854
    m_Localized: 'Phone: 唉，無所謂了……你的時間已經所剩無幾——現在，聽好。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490855
    m_Localized: 'Phone: 告訴我，你有試過把一塊麵包留在廚房裡面嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490856
    m_Localized: 沒有……歸根到底，我為什麼要這樣做？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490857
    m_Localized: 一塊麵包？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490858
    m_Localized: 'Phone: 哎呀……原來如此。看來，你並沒有和自己的宅靈保持一個良好的關係。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490859
    m_Localized: 'Phone: 正因如此，喚作「偽人」的邪靈才能乘機而入。不過，不必擔心——我們還是可以解決這個問題。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490860
    m_Localized: 'Phone: 你的家裡有個人電腦嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490861
    m_Localized: 沒有
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490862
    m_Localized: 個人什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490863
    m_Localized: 'Phone: 你……都沒有在祭拜宅靈嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490864
    m_Localized: 'Phone: 難怪喚作「偽人」的邪靈會對你感興趣。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490865
    m_Localized: 'Phone: 你的家裡有個人電腦嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490866
    m_Localized: 沒有
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490867
    m_Localized: 個人什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490868
    m_Localized: 'Phone: 好的，看來直接按下Alt+F4的法子是行不通了……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490869
    m_Localized: 'Phone: 好吧，告訴我——你有在攝取什麼蘑菇嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490870
    m_Localized: 三不五時會來上一罐紅茶菌
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490871
    m_Localized: 沒有
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490872
    m_Localized: 'Phone: 你……真的不知道什麼是個人電腦嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490873
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490874
    m_Localized: 'Phone: 好吧，沒有關係。繼續……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490875
    m_Localized: 三不五時會來上一罐紅茶菌
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490876
    m_Localized: 沒有
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490877
    m_Localized: 'Phone: 不好……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490878
    m_Localized: 'Phone: 你得立即停止飲用這些東西——要知道，紅茶菌是一種古老的邪惡之物……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490879
    m_Localized: 'Phone: 它會使菌絲體在你的體內生長。正因如此，喚作「偽人」的邪靈才會有機可乘、把你當成木偶來擺佈。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490880
    m_Localized: 'Phone: 如果你的記憶被觸及到了，將會造成無可挽救的後果。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490881
    m_Localized: 'Phone: 不僅可以消除它們，甚至……還能一遍又一遍地進行讀取、進而改變你所作出的每一次抉擇。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490882
    m_Localized: 'Phone: 最糟糕的是，你根本就不會意識到自己正在受其操縱。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490883
    m_Localized: 'Phone: 好了，接下來的將會是最後一個問題——你的家裡……見過血嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490884
    m_Localized: 有的
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490885
    m_Localized: 沒有
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490886
    m_Localized: 'Phone: 很好。切記，千萬不要再飲用那些東西了。否則，喚作「偽人」的邪靈很快就會再次佔據你的身體。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490887
    m_Localized: 'Phone: 不然，菌絲體很有可能會開始在你的體內四處蔓延、逐漸控制你——將你當作木偶。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490888
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490889
    m_Localized: 'Phone: 呼……真不簡單、真不簡單……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490890
    m_Localized: 有的
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490891
    m_Localized: 沒有
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490892
    m_Localized: 'Phone: 哎呀，這樣就說得通了……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490893
    m_Localized: 'Phone: 看來，附在你身上的並非喚作「偽人」的邪靈、而是幽靈——也即，死者的魂魄。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490894
    m_Localized: 'Phone: 驅除這種存在並非我的專長。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490895
    m_Localized: 'Phone: 你得找驅魔人來幫忙。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490896
    m_Localized: 'Phone: 我對此無能為力。再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490897
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490898
    m_Localized: 'Phone: 本次偽人驅離流程已經結束，非常感謝您使用我們的服務。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490899
    m_Localized: 'Phone: 稍後會將帳單發往你處。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490900
    m_Localized: 帳單？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490901
    m_Localized: 我還以為是免費的呢
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490902
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490903
    m_Localized: 'Phone: 哎呀……真是遺憾。恐怕，我無法辨別出這到底是一隻什麼樣的靈體——因此，也實在是幫不上什麼忙。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490904
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490905
    m_Localized: 'Phone: 本次流程，只好就此結束。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490906
    m_Localized: 'Phone: 一定要堅持下去……再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490907
    m_Localized: 'Phone: 本次偽人驅離流程已經結束，非常感謝您使用我們的服務。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490908
    m_Localized: 'Phone: 稍後會將帳單發往你處。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490909
    m_Localized: 帳單？
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490910
    m_Localized: 我還以為是免費的呢
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490911
    m_Localized: 'Phone: 沒錯，畢竟——我們的偽人驅離專家也是需要養家餬口的。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490912
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490913
    m_Localized: 'Phone: 不知，您對今天的體驗評價如何呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490914
    m_Localized: 滿分
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684992
    m_Localized: 完全沒有一點幫助
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684993
    m_Localized: 去你媽的，殺千刀的詐騙犯
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684994
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684995
    m_Localized: 'Phone: 如果你有仔細看過廣告……就會發現這麼一行小字，清楚地寫著要進行收費。'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684996
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684997
    m_Localized: 'Phone: 不知，您對今天的體驗評價如何呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684998
    m_Localized: 滿分
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684999
    m_Localized: 完全沒有一點幫助
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685000
    m_Localized: 去你媽的，殺千刀的詐騙犯
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685001
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685002
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685003
    m_Localized: 'Phone: 謝謝。您的回饋對於我們來說非常寶貴。再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610048
    m_Localized: 'TV: 以上便是目前掌握的最新資訊。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610049
    m_Localized: 'TV: 現在已於安憩速遞推出！快撥打電話、進行訂購吧——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610050
    m_Localized: 'TV: 大家，午安——您現在收看的是新聞報導。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610051
    m_Localized: 'TV: 不光是不斷蔓延的大火，偽人也在持續破壞著我們的國家。'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610052
    m_Localized: 'TV: 鑒此，FEMA公佈了一項全新的特徵……'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610053
    m_Localized: 'TV: 接下來是關於偽人本質的特別報導。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113249218560
    m_Localized: 'Phone: 你好？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995776
    m_Localized: 你的妻子給了我這個號碼
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995777
    m_Localized: 你的妻子需要幫助
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995778
    m_Localized: 'Phone: 好吧，然後呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995779
    m_Localized: 她把自己的孩子都弄丟了
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995780
    m_Localized: 他們有和你在一起嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995781
    m_Localized: 'Phone: 沒完沒了了，是吧？總是要我來收拾殘局。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995782
    m_Localized: 'Phone: 而她，就只是坐在一旁、嘴裡念叨著——「哎喲，我好累喔。」'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995783
    m_Localized: 'Phone: 一點都不帶變的。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995784
    m_Localized: 她把自己的孩子都弄丟了
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995785
    m_Localized: 他們有和你在一起嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995786
    m_Localized: 'Phone: 對的、對的——你猜怎麼樣？她根本就不關心自己的親生骨肉。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995787
    m_Localized: 'Phone: 然而，卻要我來替她收拾殘局……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995788
    m_Localized: 'Phone: 你有去看過她媽媽家嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995789
    m_Localized: 沒有
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995790
    m_Localized: 你可以過來接她離開嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995791
    m_Localized: 'Phone: 沒有。他們竟然沒有跟她在一起？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995792
    m_Localized: 'Phone: 不出所料。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995793
    m_Localized: 'Phone: 你有去看過她媽媽家嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995794
    m_Localized: 沒有
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995795
    m_Localized: 你可以過來接她離開嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995796
    m_Localized: 'Phone: 嗯哼。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995797
    m_Localized: 'Phone: 也許，他們會在那裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995798
    m_Localized: 'Phone: 不過，我可不會去看。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995799
    m_Localized: 'Phone: 讓她自己去吧。問問她——到底是什麼樣的母親，才會把自己的親生骨肉盡數拋下、不聞不問。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995800
    m_Localized: 你們之間的事情，麻煩自己去解決
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995801
    m_Localized: 總而言之，我會告訴她你還活著
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995802
    m_Localized: 'Phone: 讓她自己回來。搞什麼鬼……整得自己像個公主一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995803
    m_Localized: 'Phone: 又不是瘸了，對吧？那就沒問題了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995804
    m_Localized: 你們之間的事情，麻煩自己去解決
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995805
    m_Localized: 總而言之，我會告訴她你還活著
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995806
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995807
    m_Localized: 'Phone: 既然如此，你又為何要撥打這通電話？難道，是想解救「某個」身處困境的女子？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995808
    m_Localized: 'Phone: 愛怎樣就怎樣好了。不過，記好——無論你做了些什麼，這賤人都不會感恩戴德。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995809
    m_Localized: 'Phone: 不要再來煩我了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995810
    m_Localized: 總而言之，我會告訴她你還活著
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995811
    m_Localized: 'Phone: 沒有這個必要——沒有半點意義。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995812
    m_Localized: 'Phone: 我們根本就不在乎彼此的死活。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995813
    m_Localized: 'Phone: 歸根到底，我完全無法理解她為什麼會把你給扯進來。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995814
    m_Localized: 'Phone: 無所謂了……保重——希望你們過得開心。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995815
    m_Localized: 'Phone: 你相信死亡嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995816
    m_Localized: 你的丈夫要我打給你
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995817
    m_Localized: 不要再傳教了，之所以會打給你、是因為你的丈夫
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995818
    m_Localized: 'Phone: 蛤——我的丈夫？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995819
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995820
    m_Localized: 'Phone: 他做了一些令我無法原諒的事情……我並不想聽到關於他的任何消息。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995821
    m_Localized: 他想讓我轉告你——他對自己的所作所為感到非常抱歉
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995822
    m_Localized: 他想讓我轉告你——趕緊去死吧
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995823
    m_Localized: 'Phone: 我的丈夫？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995824
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995825
    m_Localized: 'Phone: 他做了一些令我無法原諒的事情……我並不想聽到關於他的任何消息。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995826
    m_Localized: 他想讓我轉告你——他對自己的所作所為感到非常抱歉
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995827
    m_Localized: 他想讓我轉告你——趕緊去死吧
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995828
    m_Localized: 'Phone: 哈……「感到非常抱歉」？！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995829
    m_Localized: 'Phone: 真假？沒完沒了了是吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995830
    m_Localized: 'Phone: 你猜怎麼樣？他已經不是第一次去找別人來幫自己道歉了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995831
    m_Localized: 'Phone: 你知道他為什麼不敢親自打電話給我嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995832
    m_Localized: 'Phone: 非常簡單……他根本就沒有勇氣去面對、去接受自己做出的事情。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995833
    m_Localized: 'Phone: 他還在妄想自己能彌補一切、回到從前。然而，人生沒有重演——誰也無法讓時光倒流。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995834
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995835
    m_Localized: 'Phone: 我現在過得快樂多了，有一群理解我、支持我的人陪在身邊。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995836
    m_Localized: 你……真的認為一群狂熱分子能理解自己？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995837
    m_Localized: 歸根到底，你為什麼會選擇加入一個邪教？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995838
    m_Localized: 隨你便吧
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995839
    m_Localized: 'Phone: 不管你怎麼稱呼……現在，他們是我的家人。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995840
    m_Localized: 'Phone: 我們有共同的信仰——我們知道死亡將至。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995841
    m_Localized: 'Phone: 為我們帶來安寧、而非痛苦。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995842
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995843
    m_Localized: 'Phone: 保重。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995844
    m_Localized: 'Phone: 我們有一致的見解——我們深信死亡將至。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995845
    m_Localized: 'Phone: 雖然聽起來很奇怪，不過——死亡並不會帶來悲傷、而是快樂。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995846
    m_Localized: 'Phone: 終結世間一切疾苦，於安寧中收穫幸福。相信……你也應該經歷過一些劫難，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995847
    m_Localized: 'Phone: 也許，總有一天你會明白、開始以與我們相同的方式看待萬物。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995848
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995849
    m_Localized: 'Phone: 保重。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995850
    m_Localized: 'Phone: 非常感謝你的理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995851
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995852
    m_Localized: 'Phone: 保重。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995853
    m_Localized: 'Phone: 你好，請問哪位？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995854
    m_Localized: 你好——你的兄弟給了我這個號碼
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995855
    m_Localized: 之所以會打給你，是因為你的兄弟
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995856
    m_Localized: 'Phone: 兄弟？我根本就沒有……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995857
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995858
    m_Localized: 'Phone: 我知道了——你是在說爸爸的兒子，對吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995859
    m_Localized: 'Phone: 等等……既然如此，你又是誰——他為什麼會和你在一起？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995860
    m_Localized: 他的父母不知所蹤了
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995861
    m_Localized: 他來我這裡尋求庇護
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995862
    m_Localized: 'Phone: 不知所蹤？怎會這樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995863
    m_Localized: 'Phone: 難道……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995864
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995865
    m_Localized: 'Phone: 該死……怎麼可能——他們死了？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995866
    m_Localized: 我不知道
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995867
    m_Localized: 極有可能
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995868
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995869
    m_Localized: 'Phone: 尋求庇護？要是我沒記錯的話，他不是和自己的父母住在一起嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995870
    m_Localized: 'Phone: 難道……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995871
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995872
    m_Localized: 'Phone: 該死……怎麼可能——他們死了？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995873
    m_Localized: 我不知道
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995874
    m_Localized: 極有可能
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995875
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995876
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995877
    m_Localized: 'Phone: 天啊……到底出什麼事了？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995878
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995879
    m_Localized: 'Phone: 我可以收留他——就這麼告訴他，他知道我住哪。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995880
    m_Localized: 'Phone: 還有……非常感謝你向他伸出援手。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995881
    m_Localized: 'Phone: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995882
    m_Localized: 'Phone: 你好，哪位？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995883
    m_Localized: 你的妻子和她的姊妹在我這裡
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995884
    m_Localized: 你的妻子給了我這個號碼
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995885
    m_Localized: 'Phone: 你……是想要索取贖金嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995886
    m_Localized: 'Phone: 我本就已經一無所有。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995887
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995888
    m_Localized: 'Phone: 看來，很快也會變成孤家寡人。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995889
    m_Localized: 你在說些什麼？你是怎麼回事？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995890
    m_Localized: 你的妻子很好
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995891
    m_Localized: 'Phone: 求求你告訴我她沒事。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995892
    m_Localized: 'Phone: 我的妻子是個非常堅強的人、能克服萬難——甚至，還會盡己所能幫助沿途每一個有需要的人！'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995893
    m_Localized: 'Phone: 而我……大概沒救了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995894
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995895
    m_Localized: 'Phone: 恐怕……時日無多了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995896
    m_Localized: 你在說些什麼？你是怎麼回事？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995897
    m_Localized: 你的妻子很好
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995898
    m_Localized: 'Phone: 我……我已經再也沒有辦法繼續承受下去了。灼熱的太陽、狡詐的偽人、兇殘的暴徒——太可怕了。我無法動彈。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995899
    m_Localized: 'Phone: 我……我只想結束這一切。我只剩下一條出路了……你能明白我的意思嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995900
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995901
    m_Localized: 'Phone: 告訴我的妻子——我很愛她。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995902
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995903
    m_Localized: 'Phone: 等等……還是什麼都別說吧。我不希望她來找我。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995904
    m_Localized: 'Phone: 我不想讓她知道——自己拋下她走了……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995905
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995906
    m_Localized: 'Phone: 謝謝你能打給我……謝謝你能聽下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995907
    m_Localized: 'Phone: 再見……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995908
    m_Localized: 'Phone: 她應該還在照顧自己的姊妹吧，總是不懂得什麼時候該去放手……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995909
    m_Localized: 'Phone: 她很不幸，身邊盡是一些軟弱、無能之人。因此，我選擇了離開、不再去拖累她。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995910
    m_Localized: 'Phone: FEMA接待處——你好，請問有什麼需要嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995911
    m_Localized: 我這裡住了一名女性……說自己的丈夫是FEMA的工作人員
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995912
    m_Localized: 我這裡住了一名利他主義者……說自己想要成為你們的一員
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995913
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995914
    m_Localized: 'Phone: 好的，不過……這有什麼問題嗎？我不是很確定該如何幫你。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995915
    m_Localized: 'Phone: 前提是……這不是什麼威脅的話。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995916
    m_Localized: ……我就是在威脅你
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995917
    m_Localized: 她之前曾在邊境工作，想要成為你們的一員
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995918
    m_Localized: 'Phone: （你聽到對方大聲地嘆了一口氣）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995919
    m_Localized: 'Phone: 你也是個激進分子，對吧？一天到晚抱怨這、抱怨那。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995920
    m_Localized: 'Phone: 不要浪費我們的時間。此刻，真正有需要的市民可能正嘗試接通、尋求幫助。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995921
    m_Localized: 'Phone: 或許正有偽人試圖闖進某人家裡、甚至更糟——他們說不定會因為你的這通電話白白喪命。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995922
    m_Localized: 'Phone: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995923
    m_Localized: 'Phone: 好的。她應該知道這份工作……並不簡單，對吧？她真的做好準備了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995924
    m_Localized: 'Phone: 要是沒有問題的話，就先讓她去填寫31-G表格——一式三份。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995925
    m_Localized: 'Phone: 然後，通過體檢……接著，再去填寫……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995926
    m_Localized: 'Phone: （你掛斷了電話——你也不知道自己為什麼要幫這名女性做這些亂七八糟的事情）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995927
    m_Localized: 'Phone: 她想申請什麼職位呢？希望你不要說是「局長」。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995928
    m_Localized: 'Phone: 今天已經有兩個人這樣說了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995929
    m_Localized: 局長
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995930
    m_Localized: 追蹤者——或者，斥候兵之類的
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995931
    m_Localized: 'Phone: 媽的……不要再打這些整人電話啦。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995932
    m_Localized: 'Phone: 如果你佔用著這條線路，其他有需要的人就無法接通——也許，此刻正有人遭到偽人的毒手。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995933
    m_Localized: 'Phone: 為你愚蠢且又不合時宜的玩笑負起責任來吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995934
    m_Localized: 'Phone: （對方掛斷了電話。真假？）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995935
    m_Localized: 'Phone: 我們並沒有這樣的職位空缺。我們需要的是流行病學的專家以及具備資質的科學家、研究者。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995936
    m_Localized: 'Phone: 你的這位好友……恐怕並不適合。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995937
    m_Localized: 'Phone: 不如，這樣好了——鑒於情況瞬息萬變，一週之後再打來吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995938
    m_Localized: 'Phone: 我想，到時應該會有適合……怎麼說來著？對了——利他主義者的職位。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995939
    m_Localized: 'Phone: 蘋果的構造——頂蓋、蘑菇之地和紙張。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995940
    m_Localized: 'Phone: 畏懼……蘑菇……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995941
    m_Localized: 'Phone: 雖然如此……美妙……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995942
    m_Localized: 'Phone: 它們……遇到……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995943
    m_Localized: 'Phone: 只會剩下淚水，以及離別的厄運。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995944
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995945
    m_Localized: 'Phone: 檢查她的呼吸。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995946
    m_Localized: 'Phone: 為何不予回復？我希望能死去。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995947
    m_Localized: 'Phone: （對方掛斷了電話。這……與你想的不太一樣。）'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995948
    m_Localized: 'Phone: 還請注意，目前……不管是坐飛機、抑或是搭火車，都無法抵達我們的國家。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995949
    m_Localized: 'Phone: 你好，請問有什麼需要嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995950
    m_Localized: 我想把一名遊客給送回家
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995951
    m_Localized: 為何不能搭火車？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995952
    m_Localized: 'Phone: 建議等到航班恢復運營後再出發。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995953
    m_Localized: 'Phone: 雖說渡輪還在正常行駛，然而並不安全——夜間颱風來襲的風險太高了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995954
    m_Localized: 'Phone: 再者，海水會將陽光反射到船上……水手無法堅持太久。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995955
    m_Localized: 好吧……既然如此，我到底該怎麼把這個可憐的傢伙給送回家？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995956
    m_Localized: 他現在住在我家。也許……你們可以接他過去？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995957
    m_Localized: 'Phone: 軌道因受熱而膨脹，白天行駛太過危險。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995958
    m_Localized: 'Phone: 也就是說，火車只會在夜間運行——因此，根本走不了太遠。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995959
    m_Localized: 'Phone: 否則，就得進行數次轉乘。建議等到航班恢復運營後再出發。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995960
    m_Localized: 好吧……既然如此，我到底該怎麼把這個可憐的傢伙給送回家？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995961
    m_Localized: 他現在住在我家。也許……你們可以接他過去？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995962
    m_Localized: 'Phone: 只能繼續耐心等待。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995963
    m_Localized: 'Phone: 目前，我們也無能為力了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995964
    m_Localized: 他甚至不會說我們的語言
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995965
    m_Localized: 媽的，這也不行、那也不行——要你們來有什麼用？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995966
    m_Localized: 'Phone: 我們也找不到任何的旅社可以供他、或者其他人入住。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995967
    m_Localized: 'Phone: 我們已經無能為力了。我們正在努力想辦法——現在，處於這種狀況的人並不止他一個。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995968
    m_Localized: 他甚至不會說我們的語言
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995969
    m_Localized: 媽的，這也不行、那也不行——要你們來有什麼用？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995970
    m_Localized: 'Phone: 我們的員工已經忙得四腳朝天了。想必你也已經聽說了，大使館的預算遭到了大幅的削減。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995971
    m_Localized: 'Phone: 我們已經在盡己所能了。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995972
    m_Localized: 哇哦，你們還真是一群英雄呢
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995973
    m_Localized: 我最討厭渾水摸魚的傢伙了
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995974
    m_Localized: 'Phone: 沒有必要出口成髒。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995975
    m_Localized: 'Phone: 我們沒有辦法把他給背回去。如果你真心想要幫忙，就自己來吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995976
    m_Localized: 'Phone: 預算遭到了大幅的削減，我們之所以還在工作、全靠一股熱情在撐著。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995977
    m_Localized: 哇哦，你們還真是一群英雄呢
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995978
    m_Localized: 我最討厭渾水摸魚的傢伙了
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995979
    m_Localized: 'Phone: 不喜歡我們的處理方式？好啊，你自己來唄。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995980
    m_Localized: 'Phone: 祝你能頂著中午炎熱的太陽、順利地通過邊境的偽人檢查。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995981
    m_Localized: 好吧，謝謝
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995982
    m_Localized: 去你的吧
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995983
    m_Localized: 'Phone: 既然如此——你為什麼在家裡待著、無所事事，而不是辛勤工作？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995984
    m_Localized: 'Phone: 不如……親自過來給我們示範一下該如何去解決現在這一棘手的局面，怎樣？'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995985
    m_Localized: 'Phone: 要是能有專家親臨指導的話，我們可是求之不得。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995986
    m_Localized: 好吧，謝謝
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995987
    m_Localized: 去你的吧
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995988
    m_Localized: 'Phone: 抱歉，向你發了牢騷。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995989
    m_Localized: 'Phone: 來電傾瀉怒火的人……並不是只有你一個。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995990
    m_Localized: 'Phone: 祝你過得愉快。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995991
    m_Localized: 'Phone: 祝你一路平安。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995992
    m_Localized: 'Phone: 我真心希望你偶爾可以出門旅行一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995993
    m_Localized: 'Phone: 絕對會有所幫助。'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995994
    m_Localized: 通往其他房間的窗戶。以前，人們會為了省電而這樣做——讓一個房間的燈光流瀉到其他房間裡去。
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995995
    m_Localized: 後來，又把它封了起來……不過，卻只是封了一側。
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995996
    m_Localized: 我不會往那邊看——再也不會。
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995997
    m_Localized: 我不喜歡睡在床頭櫃旁邊，總會勾起一些糟糕的回憶……
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995998
    m_Localized: 不是很清楚為何不在角落——我記得好像是有規定的吧。
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995999
    m_Localized: 不過……爸爸從來都不會把這些東西放在眼裡就對了。
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996000
    m_Localized: 托托——這是我小時候擁有的唯一一件玩具。
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996001
    m_Localized: 非要說的話……還有我們以前拿來撲打草叢的樹枝就是了。
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996002
    m_Localized: 奶奶會把每個櫥櫃都塞得滿滿當當，全是餐具。
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996003
    m_Localized: 每逢假日、節日，就會把最好看的那一套給端出來。現在……誰還需要這種東西呢？
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996004
    m_Localized: 說實話，一個人待在家裡反而會更加自在。
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996005
    m_Localized: 甚至可以毫無顧忌、大聲地自言自語。
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996006
    m_Localized: 某種要讀者在人群中找出某個特定角色的雜誌……
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996007
    m_Localized: 又有什麼意義呢？真心希望能放我一個人靜一靜……
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996008
    m_Localized: 以前，他這樣說過——「等我死了之後，你就自己決定要不要打開這個盒子吧。」
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996009
    m_Localized: 一轉眼已經過去了十五年，而我還是沒辦法拿定主意。
    m_Metadata:
      m_Items: []
  - m_Id: 48219295719612416
    m_Localized: 感到寂寞難耐？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583936
    m_Localized: 沒人可以傾訴？總是心煩意亂？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583937
    m_Localized: 既然如此——不妨來試試電話樂透吧！
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583938
    m_Localized: 只要撥打891-533，我們就會立即為你配對最為合適的聊天對象。
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583939
    m_Localized: 你的女兒還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583940
    m_Localized: 是誰下的手？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583941
    m_Localized: 一定要小心（掛斷電話）
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583942
    m_Localized: 你的女兒還好嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583943
    m_Localized: 是誰下的手？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583944
    m_Localized: 一定要小心（掛斷電話）
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583945
    m_Localized: 他們把你的住客帶到哪裡去了？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583946
    m_Localized: 幸好他們沒把你的女兒帶走
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583947
    m_Localized: FEMA是什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583948
    m_Localized: 保重（掛斷電話）
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583949
    m_Localized: 他們把你的住客帶到哪裡去了？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583950
    m_Localized: 幸好他們沒把你的女兒帶走
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583951
    m_Localized: FEMA是什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583952
    m_Localized: 保重（掛斷電話）
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583953
    m_Localized: 他們把你的住客帶到哪裡去了？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583954
    m_Localized: 幸好他們沒把你的女兒帶走
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583955
    m_Localized: FEMA是什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583956
    m_Localized: 保重（掛斷電話）
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583957
    m_Localized: 'Phone: 你好。你已撥通FEMA的服務電話——請問有什麼需要嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583958
    m_Localized: 蛤——FEMA？什麼東西？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583959
    m_Localized: 你在說什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583960
    m_Localized: 'Phone: （她還沒來得及說完，電話的那頭就傳來了一股震耳欲聾的怒吼）'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583961
    m_Localized: 'Phone: 你他媽是不是傻！趕緊把電話掛斷！'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583962
    m_Localized: 我該如何……處理自己的腋窩？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583963
    m_Localized: 我該如何……處理自己的耳朵？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583964
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583965
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583966
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583967
    m_Localized: 'Phone: 為了確保檢查的準確程度，一定要避免沾水。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583968
    m_Localized: 'Phone: 既不能洗澡、也不能洗手。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583969
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583970
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583971
    m_Localized: 'Phone: 耳朵？等等……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583972
    m_Localized: 'Phone: 我們需要與管理層進行討論，稍後再告知你結果。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583973
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583974
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583975
    m_Localized: 'Phone: 好吧。既然如此，請問——你有在食用菌類嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583976
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583977
    m_Localized: 'Phone: 好了，接下來的將會是最後一個問題——你的家裡……見過血嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583978
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583979
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778240
    m_Localized: 'Phone: 你好。你已接通電話樂透。我們會立即為你配對最為合適的聊天對象。稍等。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778241
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778242
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778243
    m_Localized: 'Phone: 你好。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778244
    m_Localized: 你好
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778245
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778246
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778247
    m_Localized: 'Phone: 你好？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778248
    m_Localized: 你好
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778249
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778250
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778251
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778252
    m_Localized: 'Phone: 好像……沒人？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778253
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778254
    m_Localized: 'Phone: 我……我想找人聊聊。最近，實在是發生了太多的事情……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778255
    m_Localized: 'Phone: 我試過聯絡自己的好友還有認識的人，卻都完全沒有回應……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778256
    m_Localized: 'Phone: 然後，就聽到了電話樂透的廣告。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778257
    m_Localized: 'Phone: 雖然……也許並不是什麼傾訴心事的最佳場所，不過也比沒有要強。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778258
    m_Localized: 'Phone: 我也知道，把自己的問題強加在一個陌生人的身上是不對的……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778259
    m_Localized: 'Phone: 你應該無法想像吧——只要能與人說說話、聊聊天，對我來說就已經能有很大的幫助了。會讓我感覺……好很多。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778260
    m_Localized: 'Phone: 你願意聽我說說嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778261
    m_Localized: 好吧
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778262
    m_Localized: 我並不想進行長篇大論的對話
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778263
    m_Localized: 'Phone: 哎呀……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778264
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778265
    m_Localized: 'Phone: 好吧。不好意思，打擾你了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778266
    m_Localized: 'Phone: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778267
    m_Localized: 'Phone: 謝謝——真的非常謝謝你！'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778268
    m_Localized: 'Phone: 我想……要是能先跟你介紹一下自己的話，應該會比較容易開啟接下來的話題。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778269
    m_Localized: 'Phone: 你想知道些什麼？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778270
    m_Localized: 你住在哪裡？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778271
    m_Localized: 你為什麼選擇打給電話樂透，而不是自己的親朋、好友？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778272
    m_Localized: 'Phone: 其實……我現在離家很遠。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778273
    m_Localized: 'Phone: 為了躲避這股異常的酷熱，我找了個自己所能找到的、最為寒冷的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778274
    m_Localized: 'Phone: 這裡非常偏僻，而且……寒風刺骨。幾乎什麼東西都長不出來，就連野草也不例外。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778275
    m_Localized: 'Phone: 相對來說還是比較安全的，而且前不著村、後不著店。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778276
    m_Localized: 'Phone: 話說回來，要是九層地獄裡面有什麼地方是比較涼快的話……也許，並不會差到哪裡去。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778277
    m_Localized: 'Phone: 說來也是有趣——我之前特別討厭寒冷。然而，現在……感覺就像是一種恩賜。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778278
    m_Localized: 'Phone: 雖說，我很想要相信太陽的溫度會逐漸降低、一切終將會結束——'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778279
    m_Localized: 'Phone: 然而，我卻已經失去了對美好結局的希冀……如果太陽真的停止爆發了，之後又會發生什麼事情呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778280
    m_Localized: 'Phone: 譬如——偽人很有可能不會消失。它們很有可能會取代我們的親朋、好友，而我們卻無從得知……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778281
    m_Localized: 你為什麼會選擇獨自一人、踏上旅程？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778282
    m_Localized: 你想念自己的家鄉嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778283
    m_Localized: 'Phone: 雖然我也很想打給大家，不過……根本就不知道該如何聯絡上他們……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778284
    m_Localized: 'Phone: 事情是這樣的——災變開始之後，我就決定要離開自己的家鄉、飛到一個熱浪無法侵襲的地方。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778285
    m_Localized: 'Phone: 我答應過大家，會定期打電話回去跟他們報告一下各自的近況、看看彼此過得還好不好……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778286
    m_Localized: 'Phone: 然而，抵達之後……卻無法聯絡上任何人。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778287
    m_Localized: 'Phone: 很快，我就得知了原因——他們的線路被切斷了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778288
    m_Localized: 'Phone: 整座城市都可以說是與世隔絕了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778289
    m_Localized: 'Phone: 沒錯，我在這裡是很安全。只是，我的親朋、好友卻……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778290
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778291
    m_Localized: 'Phone: 一想到有可能再也見不到這些我所在乎、關愛的人了，就令我感到非常、非常的害怕。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778292
    m_Localized: 'Phone: 我很懷念過去波瀾不驚的日子——生活簡單而美好，未來也充滿期待。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778293
    m_Localized: 你為什麼會選擇獨自一人、踏上旅程？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778294
    m_Localized: 你想念自己的家鄉嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778295
    m_Localized: 'Phone: 其實，我也不想這樣……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778296
    m_Localized: 'Phone: 我的死黨本來想要跟我一起出發。結果，卻沒辦法……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778297
    m_Localized: 'Phone: 因為，他沒有出行所需的文件。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778298
    m_Localized: 'Phone: 再說……災變開始之後，就聯絡不上大家了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778299
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778300
    m_Localized: 'Phone: 他十分懊惱……後悔沒有早點申請這些文件。雖然我很想幫他，不過——卻不知道該怎麼做。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778301
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778302
    m_Localized: 'Phone: 我很想念大家。相比那座城市，我更牽掛留在那裡的親朋、好友……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778303
    m_Localized: 'Phone: 特別是我最好、最棒的朋友……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778304
    m_Localized: 'Phone: 雖然他想跟我一起出發，不過——卻沒辦法。我答應過他，會保持聯絡。結果……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778305
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778306
    m_Localized: 'Phone: 我想，他應該是喜歡我的吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778307
    m_Localized: 'Phone: 他非常關心我……總是不遺餘力地支持我，總是專心致志地聽我說話。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778308
    m_Localized: 'Phone: 久而久之，我突然意識到了——我們其實……兩情相悅。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778309
    m_Localized: 'Phone: 我一直都在等待他表明心意。我想要他主動。然而，他卻總是無法鼓起勇氣、或是找不到合適的機會。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778310
    m_Localized: 'Phone: 然後……災變開始了。現在，已經不是談情說愛的時候了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778311
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778312
    m_Localized: 'Phone: 我很後悔自己沒有將這份心情給先說出口……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778313
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778314
    m_Localized: 'Phone: 好了，我的事情就說到這裡吧。現在，該輪到你了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778315
    m_Localized: 我不太擅長談論自己的事情……
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778316
    m_Localized: 我不知道……
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778317
    m_Localized: 'Phone: 不要害羞——我會好好聽的。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778318
    m_Localized: 好吧……我的身邊並沒有什麼親近的人
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778319
    m_Localized: 我……是個孤獨的人
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778320
    m_Localized: 'Phone: 不要擔心——只不過是談論自己的事情罷了，並沒有什麼不妥。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972544
    m_Localized: 好吧……我的身邊並沒有什麼親近的人
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972545
    m_Localized: 我……是個孤獨的人
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972546
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972547
    m_Localized: 我……和父親的關係一直都非常緊張
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972548
    m_Localized: 我……很討厭自己的父親
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972549
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972550
    m_Localized: 我已經不再是家族的一員了
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972551
    m_Localized: 某天，我被斷絕了關係、不再是他的兒子了
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972555
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972556
    m_Localized: 現在，就只剩下這棟該死的房子了
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972557
    m_Localized: 現在，就只剩下這棟房子了
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972558
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972559
    m_Localized: 'Phone: 我替你感到難過……聽起來，你對這棟房子最終落到了你的頭上一事——不是特別高興？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972560
    m_Localized: 的確
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972561
    m_Localized: 要是能一把火把它給燒成平地的話，就好了
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972562
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972563
    m_Localized: 'Phone: 我……我根本無法想像你都經歷了些什麼。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972564
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972565
    m_Localized: 'Phone: 竟然想把它付之一炬——我根本無法想像你究竟有多麼的討厭自己的父親……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972566
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972567
    m_Localized: 'Phone: 謝謝你願意和我聊天。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972568
    m_Localized: 'Phone: 再見。一定要堅持下去，好嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972569
    m_Localized: 'Phone: 你好？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972570
    m_Localized: 你好——請問，能讓你的女兒接電話嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972571
    m_Localized: 你好——不知，能否讓你的女兒過來、跟她的朋友一起玩呢？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972572
    m_Localized: 'Phone: 蛤？怎麼了嗎？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972573
    m_Localized: 她的朋友想問，能不能讓她來我這裡一起玩
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972574
    m_Localized: 我這收留了一個女孩……她的爸爸已經不在了
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972575
    m_Localized: 'Phone: 他……他也是個……偽人？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972576
    m_Localized: 「也」？什麼意思？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972577
    m_Localized: 你誤會了——他是被一群瘋子無緣無故燒死的。
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972578
    m_Localized: 'Phone: 誰會無緣無故把人燒死啊？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972579
    m_Localized: 'Phone: 看來，他的確是個偽人……就跟我們的寶貝女兒一樣。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972580
    m_Localized: 'Phone: 她也被燒死了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972581
    m_Localized: 'Phone: 就在自己的幼稚園裡。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972582
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972583
    m_Localized: 'Phone: 起初，我痛不欲生、想要一死了之。沒有了她，我根本就活不下去。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972584
    m_Localized: 'Phone: 幸好，我的丈夫幫我度過了這段艱難的時期。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972585
    m_Localized: 'Phone: 你也能度過這段艱難的時期……還有，你收留的那個女孩也是。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972586
    m_Localized: 'Phone: 你也知道……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972587
    m_Localized: 'Phone: 正所謂——事出必有因。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972588
    m_Localized: 'Phone: 如果他的父親被人給燒死了……背後肯定有著相應的理由。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972589
    m_Localized: 'Phone: 再怎麼落淚，也無濟於事。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972590
    m_Localized: 'Phone: 還請……將這些話轉告給她。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972591
    m_Localized: 'Phone: 再見。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972592
    m_Localized: 'Phone: 我們的寶貝女兒……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972593
    m_Localized: 'Phone: 已經不在了……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972594
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972595
    m_Localized: 'Phone: 我們別無選擇，只得……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972596
    m_Localized: 'Phone: 只得殺了她。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972597
    m_Localized: 蛤？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972598
    m_Localized: （掛斷電話）
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972599
    m_Localized: 'Phone: 我們殺了她。相信我——只有這個辦法。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972600
    m_Localized: 'Phone: 每項特徵都能對上……我的丈夫堅持如此。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972601
    m_Localized: 你……竟然決定要殺掉自己的親生骨肉？
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972602
    m_Localized: ……
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972603
    m_Localized: 'Phone: 不要對我評頭論足！'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972604
    m_Localized: 'Phone: 她是個偽人——全部特徵都能對上，絕對不可能會搞錯！'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972605
    m_Localized: 媽的……
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972606
    m_Localized: 我能理解
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972607
    m_Localized: 'Phone: 你沒有聽錯——她是個偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972608
    m_Localized: 'Phone: 各項特徵，一個不落……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972609
    m_Localized: 'Phone: 我對她瞭如指掌。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972610
    m_Localized: 'Phone: 因此，我立即就注意到了這些特徵。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972611
    m_Localized: 'Phone: 全部都能對上。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972612
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972613
    m_Localized: 'Phone: 我告訴了自己的丈夫之後，他……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972614
    m_Localized: 'Phone: 立即就解決了這個偽人。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972615
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972616
    m_Localized: 'Phone: 起初，我對他恨之入骨、想要把他給殺了。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972617
    m_Localized: 'Phone: 後來，我終於醒悟了……它，根本就不是我們的寶貝女兒。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972618
    m_Localized: 'Phone: 我的丈夫使我明白了這點。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972619
    m_Localized: 'Phone: 唯一的遺憾就是沒來得及問那個冒名頂替東西，它究竟對我們的小孩做了什麼……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972620
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972621
    m_Localized: 'Phone: 抱歉。'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972622
    m_Localized: 'Phone: 不要再打電話過來了……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972623
    m_Localized: 'Phone: 拜託……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972624
    m_Localized: 'Phone: 我為什麼要跟你解釋這些？'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972625
    m_Localized: 'Phone: 見鬼去吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972626
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972627
    m_Localized: 'Phone: 然而……我還是非常地想念她……'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972628
    m_Localized: 'Phone: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096192
    m_Localized: 'TV: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096193
    m_Localized: 'TV: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096194
    m_Localized: 'TV: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096195
    m_Localized: 'TV: 接下來是關於屍體處理工作將會暫時停止的報導。'
    m_Metadata:
      m_Items: []
  - m_Id: 58690054376120320
    m_Localized: 'TV: 現在已於安憩速遞推出！快撥打電話、進行訂購吧——{0}。'
    m_Metadata:
      m_Items: []
  - m_Id: 58231803335401472
    m_Localized: 兩罐貓食，謝謝
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790080
    m_Localized: 一包香菸，謝謝
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790081
    m_Localized: 一罐紅茶菌，謝謝
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
