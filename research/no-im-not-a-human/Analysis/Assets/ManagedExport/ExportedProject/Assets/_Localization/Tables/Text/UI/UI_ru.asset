  - m_Id: 101527150292357120
    m_Localized: '<color=#444444>Отдано</color> x{0} <color=#225555>{1}</color>'
    m_Metadata:
      m_Items: []
  - m_Id: 102986315954982912
    m_Localized: огромный бородатый мужик
    m_Metadata:
      m_Items: []
  - m_Id: 104046912809275392
    m_Localized: безглазый
    m_Metadata:
      m_Items: []
  - m_Id: 104046924544937984
    m_Localized: женщина с картами таро
    m_Metadata:
      m_Items: []
  - m_Id: 104046925161500672
    m_Localized: парень в футболке amogus
    m_Metadata:
      m_Items: []
  - m_Id: 104046926415597568
    m_Localized: агрессивный чел с огромной башкой
    m_Metadata:
      m_Items: []
  - m_Id: 104046927208321024
    m_Localized: этот в очках и с усами
    m_Metadata:
