%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_uk
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: uk
  m_SharedData: {fileID: 11400000, guid: e2adf5c0928e69a42a85516c84d58249, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: Привіт, кхе-кхе.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: Впустиш, друже?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: Хто ти?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: Що з тобою сталося?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: 'Firefighter: Я пожежник, кхе-кхе.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: 'Firefighter: Ми вдень гасили ліси та потрапили під сонце.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: 'Firefighter: Я не згорів живцем завдяки завісі з диму, кхе-кхе, але там все одно страшно.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: 'Firefighter: Дерева, кхе-кхе… Горіли як сірники.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: Ніколи не бачив нічого подібного.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: 'Firefighter: По всьому лісі ліжали зотлілі тіла тварин.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: Чому ти не в лікарні?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: Що ти збираєшся робити?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: 'Firefighter: Ми вдень гасили ліси та потрапили під сонце.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: Я єдиний, хто вижив з бригади.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: 'Firefighter: Решту, кхе-кхе… просто не відпустило начальство.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: І вони залишились на вічну зміну.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: Чому ти не в лікарні?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: Що ти збираєшся робити?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: 'Firefighter: Лікарня? Та які зараз лікарні, друже?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: 'Firefighter: З приходом Гостей лікарні втратили свій сенс.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: 'Firefighter: Важко лікуватись, якщо не можна довіряти тому, хто тебе лікує.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: Ніхто мені не допоможе.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: 'Firefighter: Краще б я залишився гасити пожежу та помер там зі своїми друзями.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: Все одно недовго лишилося.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: 'Firefighter: Я хотів гасити ліс далі. Краще б я там загинув замість наших хлопців.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: 'Firefighter: Але мені чітко дали зрозуміти, кхе-кхе… Що з мене досить.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: 'Firefighter: Додому я вже не дістануся. Транспорт більше не ходить.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: Доведеться сподіватись на людську доброту.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: Дякую тобі, друже, кхе-кхе.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: 'Firefighter: Думаю, я надовго у тебе не затримаюсь, кхе-кхе.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: 'Firefighter: Хоч не на сирій землі доведеться вмирати.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: От лихо, друже, кхе-кхе.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: Не хочеться помирати на сирій землі.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: 'Firefighter: Сподіваюся, кхе-кхе, пожежі не розповсюдяться до міст.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: Хеей, здоров''ячка!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: 'WheelChair: Давно не бачились. Як сам?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: Ми знайомі?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: Ти хто?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: 'Wheelchair: Як це, ти що… Не пам''ятаєш мене?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: Та ми ж це…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: 'Wheelchair: Стривай, у тебе інший голос…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: А ти давно тут хазяйнуєш?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: Цей дім завжди належав моїй родині
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: Мені здається, ти помилився адресою
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: Ой, ти не…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: Ти не мій приятель.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: А ти вже давно тут живеш?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: Цей дім завжди належав нашій родині
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: Мені здається, ти помилився адресою
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: Та ні, ну що ти.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: 'Wheelchair: Я не міг помилитися, пам''ять мене ніколи не підводить.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: 'Wheelchair: Мій приятель точно живе… тобто жив тут.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: 'Wheelchair: Слухай, я стільки колесив, можеш, будь ласка, пустити до себе?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: Та ні, ну не міг же я…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: Ні-і-і…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: Бля…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: Здається, я реально переплутав.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: 'Wheelchair: Слухай, я стільки колесив, можеш, будь ласка, пустити до себе?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: Ось це діло!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: Поганяємо в тебе вдома, га?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: 'Wheelchair: Піти? Ти довбойоб?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: 'Wheelchair: Як я піду?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: 'Wheelchair: Йо-о-о-ой, покотив я від тебе, довбня.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: 'Mother: Все, стій спокійно, не вертись.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: 'Mother: Здрастуйте. Допоможіть, будь ласка.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: Що сталося?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: Що ви хочете від мене?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: 'Mother: Я з ніг падаю. Дуже хочу спати.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: З п''ятьох дітей лишився один син.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: 'Mother: Чоловік кудись зник. Я вже не знаю, чи його вбили, чи він нас кинув, чи що.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: 'Mother: Зараз просто б лягти та проспати кілька днів.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: Куди поділися інші діти?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: Ваші діти померли?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: 'Mother: Пустіть мене відпочити, я страшенно втомилася.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: 'Mother: У мене було п''ятеро дітей. Лишився ось один син.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: 'Mother: Навіть не знаю, де кого шукати, мені б тільки добре виспатися.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: Куди поділися інші діти?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: Ваші діти померли?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: 'Mother: Не знаю, може, їхній батько їх забрав? Хотіла дійти до його дому, але вже просто не можу.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: 'Mother: Так, ми з ним посварились, але це не дивно. Важко ужитись з тим, хто поводиться як мудак.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: 'Mother: Хай би йому грець. Для мене головне — знайти дітей.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: Проходьте
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: Вам краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: Ні, ви так не кажіть.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: 'Mother: Звичайно, важко наглядати за цілою юрбою непосидючих дітей, але…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: 'Mother: З ними нічого не трапилося. Напевно, вони у моєї матері.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: 'Mother: Вони можуть до неї втекти, коли їм зі мною геть нудно.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: 'Mother: Або коли їхній батько знову приходить грошей у мене просити.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: 'Mother: Ви можете мене впустити? Я відпочину та піду шукати дітей.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: Проходьте
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: Вам краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: Нарешті трохи відпочинку.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: 'Mother: Ходімо, скоріше, займай собі місце.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: Завтра вже підемо з тобою.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: 'Mother: Ну гаразд. Тоді зараз спробую дійти до матері.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: Може, вже не встигну…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: Та ні, маю встигнути.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: Привіт, мешканцю.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: 'Anger: Настрій ні до біса, одразу перепрошую.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: 'Anger: Так багато виродків навколо. Сподіваюся, ти не один з них.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: Ти про кого?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: Ти раптом не з цих… тварюк?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: Та… про всіх.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: 'Anger: Про покидьків, яких стримувала тільки віра чи ще щось.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: 'Anger: А коли бог для них помер — ніхуя людського не залишилося.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: Просто тварини їбучі.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: 'Anger: Мало нам було цих приколів із Гостями… тут ще ці.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: Чого ти так завівся?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: Ти чимось відрізняєшся від них?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: Гарне питання.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: 'Anger: Ти ж помітив, що люди зараз ніби діляться на два… табори, чи як назвати.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: 'Anger: В одному — срані садисти. Гірше за будь-яких Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: 'Anger: Витворюють що хочуть, та все кричать, мов оскаженілі: «Вбивати, вбивати, вбивати!»'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: 'Anger: У другому — просто барани. Витреш об них ноги, вони ще подякують, що не вбив.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: І мене, сука, бісять обидва ці табори.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: Чого ти так завівся?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: Ти чимось відрізняєшся від них?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: 'Anger: Та ти не бери на свій карб. Просто…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: 'Anger: Після цього жаху з сонцем та приходу Гостей є таке відчуття, що разом з богом померла людяність.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: 'Anger: А злюсь… розумієш, хотілося ж нормальними справами займатися.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: 'Anger: Я музику писав. Зараз воно всім до сраки.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: Просто намагаюся не потрапити до одного з цих таборів.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: Я хочу вірити, що відрізняюсь.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: 'Anger: Знаєш, мене до усрачки лякає можливість перетворитися на одного з цих маніяків.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: 'Anger: Або на їх жертву. Обидві сторони — це пиздець.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: Хоча…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: Жертви гірші.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: 'Anger: Вони просто сидять і чекають, поки їх розтопчуть, виб''ють їм зуби чи ще щось зроблять.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: 'Anger: Ти б зрозумів мою лють, якби бачив те саме, що я.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: 'Anger: Ти не переймайся, зі мною проблем не буде.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: Пиздити когось я не збираюсь.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: 'Anger: Свою лють я зганяю на собі, ніхто не постраждає.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: 'Anger: Блять, то ти такий самий уїбан, як інші труси.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: 'Anger: Сиди, терпи, поки тобі на обличчя не насеруть.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: Пиздець.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: Я відчуваю тут застій якоїсь енергії.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: Щось дуже недобре зріє у вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: 'FortuneTeller: Сонце, Лев, п''ятий дім. Все зрозуміло.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: 'FortuneTeller: Ви досить наполеглива людина, так?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: Що?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: Мені нічого не треба
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: Бачу, ви полюбляєте діяти, а не говорити.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: Типовий Лев, розумієте, так?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: 'FortuneTeller: І ви тут зібрали занадто багато неприємної темної енергії.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: Поки що не розумію, чому.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: 'FortuneTeller: Все так запущено, мабуть, треба починати тут з афірмацій.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: Якого біса ти мене цим грузиш?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: То й що?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: Так я не пропоную нічого зайвого.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: 'FortuneTeller: Я допоможу вам зрозуміти причинно-наслідковий зв''язок, розумієте, так?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: 'FortuneTeller: Є карма шість-дев''ять, вони наче рибки, одна за одною.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: 'FortuneTeller: Спочатку ви, потім вам, розумієте, так?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: Якого біса ти мене цим грузиш?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: То й що?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: 'FortuneTeller: Я розумію, що для вас це все стрес, оскільки ви — асцендентний Козеріг.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: 'FortuneTeller: Ви поєднуєте кілька сузір''їв відразу, ви комплексна людина.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: 'FortuneTeller: Так ось, афірмації допоможуть нам дійти до глибин вашого космосу, розумієте, так?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: 'FortuneTeller: Відразу все стане на свої місця.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: 'FortuneTeller: У вашому роді та реінкарнаціях були тюремні наглядачі.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: 'FortuneTeller: Дайте їм місце, ви просто повторюєте досвід минулих перероджень.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: 'FortuneTeller: Вам зараз треба пробачити та прийняти це в собі.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: 'FortuneTeller: Тільки тоді ви зможете розірвати ланцюжок нескінченного циклу.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: Розумієте, так?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: 'FortuneTeller: Добре, у вас тут розташування ну дуже ресурсне, якщо чесно.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: Через ваш дім іде енергетичний потік.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: 'FortuneTeller: То що, вам не цікаво працювати над собою?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: Стати найкращою версією себе?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: Дуже сумно.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: 'FortuneTeller: Займусь афірмацією вам на довгий та міцний пронос.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: Доброї ночі.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: 'Gasmask: Я з бригади КНС, обходимо ваш район.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: Ти прийшов сам?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: Чому я мушу тобі довіряти?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: Звісно, ні.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: 'Gasmask: Наша бригада розділилася на кілька невеликих груп, щоб охопити більше будинків.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: Думаю, наша розмова багато часу не забере.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: Чому ти у захисному костюмі? Нам вони теж потрібні?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: Як ти нам допоможеш?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: Я можу показати посвідчення.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: 'Gasmask: До того ж, Гості рідко ходять гуртом. Може навіть, ніколи.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: Чому ти у захисному костюмі? Нам вони теж потрібні?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: Як ти нам допоможеш?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: 'Gasmask: Ні. Але ви можете купити такий, якщо вважаєте за потрібне.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: 'Gasmask: Ми поки що в процесі вивчення впливу сонця на довкілля.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: 'Gasmask: Ми часто знаходимося на вулиці, тож нам важливо себе захистити.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: І що далі?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: Ви маєте план дій?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: 'Gasmask: Насамперед ми зберемо дані та відправимо їх керівництву.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: Далі вони розроблять алгоритм дій.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: 'Gasmask: Вам зараз потрібно просто зберігати спокій.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: І що далі?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: Ви маєте план дій?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: Я візьму одного мешканця.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: 'Gasmask: Ми зберемо аналізи, щоб переконатися, що з ним все добре і він може безпечно жити у цьому районі.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: 'Gasmask: Також, звичайно, перевіримо, чи є він людиною.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: Мені треба збиратися?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: Мені просто чекати чогось?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: 'Gasmask: Авжеж. Ми не можемо діяти спонтанно.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: Ми відвеземо одного з ваших мешканців до нашої лабораторії.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: 'Gasmask: Він просто здасть аналізи, ми переконаємося, що все гаразд, і повернемо його.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: Мені треба збиратися?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: Мені просто чекати чогось?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: Це ваш дім?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: 'Gasmask: Тоді не треба, залишайтеся з іншими мешканцями. Якщо потрібно буде евакуюватись — ми повідомимо.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: Ми лише заберемо одну людину і підемо.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: На все добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: 'Gasmask: Так. Коли ми матимемо всю інформацію, то видамо інструкції.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: Не варто зараз хвилюватись.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: 'Gasmask: Ми лише заберемо одну людину, постараємося повернути її якнайшвидше.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: До побачення.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: 'Prophet: Ми знову зустрілися.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: 'Prophet: Я пам''ятаю, що минулого разу було інакше. Але ми живемо…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: 'Prophet: Хм, дивно, не знаю, як пояснити.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: 'Prophet: Мені хочеться розпочати наше спілкування… з ворожіння.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: 'Prophet: Поворожиш мені по книзі? Яку сторінку відкрити?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: Давай десь на початку
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: Відкрий просто у середині
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: Відкрий у кінці
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: 'Prophet: «Мертвий прийде і скаже, і йому не повірять».'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: Ти дивись…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: Все ще актуально.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: Хоча зараз це й не дивно.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: Що це означає?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: І ти в це віриш?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: «Хто ти такий?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: 'Prophet: Я? Це я. А ти… ти була моїм домом».'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: 'Prophet: Хм. Так. Сумна історія.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: 'Prophet: Невже це нас чекає?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: Цілком можливо, що й так.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: Що це означає?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: І ти в це віриш?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: 'Prophet: «Так давно це було. Може, бачив уві сні? Можливо, ми з тобою як ті риби.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: 'Prophet: Лише чиїсь спогади, того, кого давно немає.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: 'Prophet: Може, нічого більше не залишилося, крім дощу».'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: Хм. Може, навіть, скоро саме це з нами і станеться.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: 'Prophet: Як ти гадаєш? Ми вже чийсь сон чи тільки станемо у майбутньому?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: Цікавий тобі випав рядок.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: Що це означає?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: І ти в це віриш?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: 'Prophet: Це треба добре обміркувати. Чи є в тебе самого думки щодо цього?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: Насправді я прийшов сказати тобі дещо.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: Про те, що відбудеться через деякий час…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: Тобі треба бути готовим.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: 'Prophet: Я розумію, звучить дивно, але особу з котом треба впустити.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: 'Prophet: Я впевнений, що тобі це допоможе. Поки що не можу сказати, як.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: 'Prophet: Але, звичайно, тобі вибирати, ​​що робити з цією інформацією.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: 'Prophet: А поки що я поміркую над тим, що саме ти мені наворожив.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: Не зовсім.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: 'Prophet: Краще дивитись на це як на пораду. Щоб не забути щось зробити чи звернути увагу.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: Поки я думав над цим, мені спало на думку знання.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: 'Prophet: Скоро прийде особа з котом. Тобі важливо впустити їх до себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: Не можу поки що сказати, навіщо. Але так має стати простіше.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: 'Prophet: А поки що я мушу йти. Обміркую твій вибір з книги.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: Привіт тобі, людино.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: 'Fanatic: Оце нам пощастило! Ми на власні очі побачимо страшний суд над людьми!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: 'Fanatic: Земля очищається від гріхів, Сонце взялося за священну справу.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: Ми на шляху до нового чистого світу!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: 'Fanatic: ОСЬ ТАКА СРАНА БЛАГОДАТЬ!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: Що?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: Ти мене лякаєш
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: Що тобі неясно, ЛЮДИНО?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: 'Fanatic: Зараз розтлумачу тобі по-простому, що до чого.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: 'Fanatic: Сонце не просто так горить і СМАЖИТЬ НАС ЖИВЦЕМ! Воно спалює наші гріхи!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: 'Fanatic: Ми опаскудили світ своєю хтивістю та жадобою і ПРОГНІВИЛИ СОНЦЕ!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: 'Fanatic: НАСТАВ ЧАС ПОКАРАННЯ!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: 'Fanatic: Бо це справа добра. Не буде гріхів, мі всі перетворимось на святі купи попелу під його сраним поглядом!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: Тобто ми маємо померти?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: А що буде з тобою?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: Ти з глузду з''їхав чи що?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: 'Fanatic: Зараз розтлумачу тобі по-простому, що до чого.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: 'Fanatic: Сонце не просто так горить і СМАЖИТЬ НАС ЖИВЦЕМ! Воно спалює наші гріхи!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: 'Fanatic: Ми опаскудили світ своєю хтивістю та жадобою і ПРОГНІВИЛИ СОНЦЕ!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: 'Fanatic: НАСТАВ ЧАС ПОКАРАННЯ!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: 'Fanatic: Бо це справа добра. Не буде гріхів, мі всі перетворимось на святі купи попелу під його сраним поглядом!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: Тобто ми маємо померти?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: А що буде з тобою?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: З чого ти взяв?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: 'Fanatic: Гріхи помруть, Сонце, можливо, помре. АЛЕ МИ БУДЕМО ЖИТИ.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: 'Fanatic: Більше не буде ні смерті, ні крадіжок, ні жадібних виродків, які деруть шалені гроші за те, що я хочу.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: 'Fanatic: Ти можеш собі уявити? Тепер розумієш, чому все це почалося?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: Та я тут до чого?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: 'Fanatic: Ми всі будемо ДОБРЕ ЖИТИ, коли Сонце нас врятує.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: 'Fanatic: Його святі промені допоможуть нам позбутися всього цього, розумієш?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: 'Fanatic: Та все ти розумієш, тому ти й живий!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: ЧУДОВО! Ще поговоримо з тобою про все це!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: 'Fanatic: Забув запитати: у тебе пиво хоч є?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: 'Fanatic: Ти що, придурювався, що не знаєш нічого про Сонце?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: 'Fanatic: Ну і йди тоді у сраку, а Я ВРЯТУЮ КОГОСЬ ІНШОГО-О-О!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: 'Fanatic: Бувай, йолопе! БУВА-А-А-АЙ!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: Здрастуйте!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: 'Anxiety: Вибачте, що так пізно, вдень якось жарко, по телевізору казали, що краще не виходити на сонце.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: Чи не знайдеться у вас містечка для мене?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: Ти хто?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: Як ти тут опинилась?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: Ммм, я жила ближче до міста.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: 'Anxiety: Там, звичайно, асфальт нагрівається страшенно, хе-хех. Е-е-ех.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: 'Anxiety: Я взагалі касиром працювала. Колись, зараз вже ні.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: 'Anxiety: Мене звільнили, з роботою якось не пощастило…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: Що тепер робитимеш?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: Як гадаєш, що буде далі?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: 'Anxiety: Я не те щоб хотіла приходити. Так, асфальт вже плавиться під ногами, але поки не так все й погано.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: Ви будете сміятися.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: 'Anxiety: У мене в хаті оселилися Гості. Хах, уявляєте? Вони мене вигнали зі власного дому.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: 'Anxiety: Ось, ходжу тепер, шукаю, де б сховатися від сонця.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: Що тепер робитимеш?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: Як гадаєш, що буде далі?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: 'Anxiety: Мммм. Постараюсь якось вижити. Авжеж, страшно, коли довкола якісь Гості, та сонце смажить усе підряд.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: 'Anxiety: Дуже хочеться пожити. Хе-хех. О-о-о-й.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: Хіба вам не страшно?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: 'Anxiety: Скажіть, що все скоро скінчиться, будь ласка.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: Я не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: 'Anxiety: Чи виживу я? Хто мені допоможе? Чи довго шукати допомогу?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: 'Anxiety: Я не знаю, що взагалі буде далі. Навіть не можу припустити.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: 'Anxiety: А вам хіба не страшно від цього? Мені — дуже.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: 'Anxiety: Дякую. Хахах, дякую, правда!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: 'Anxiety: Господи, я проживу ще трохи.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: 'Anxiety: Хахах, о-о-о-х, та-а-а-ак.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: 'Anxiety: Все одно дякую, що вислухали мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: 'Anxiety: М… добре, мабуть, я піду далі тоді.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: 'Anxiety: Бувайте? Так, м… бувайте…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: Можна до вас?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: Я ховався у барі неподалік, але…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: Мене просто взяли і вигнали.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: 'Esenin: За що? Хм. Не всім там прийшовся до вподоби мій темперамент.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: 'Esenin: Я не ображаю нікого, не хвилюйся. Просто… іноді так огидно від усього.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: 'Esenin: То що скажеш? Впустиш мене?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: Ти ж не Гість?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: З тобою не буде проблем?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: Я що, схожий на цих потвор?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: 'Esenin: Ні, я не Гість. Та й взагалі, питати кожного в обличчя про це — тупа маячня.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: 'Esenin: Схоже, тут буде те ж саме, що у барі.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: Чому тебе виперли з іншого притулку?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: Чому ти думаєш, що тут буде інакше?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: Що таке для тебе проблеми, хазяїне?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: 'Esenin: Вбивства і жорстокість я на дух не переношу. Але й образити себе не дам.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: 'Esenin: Ось випити та поїсти я люблю. Люблю погутарити, коли у настрої. Це проблема?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: Чому тебе виперли з іншого притулку?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: Чому ти думаєш, що тут буде інакше?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: 'Esenin: Хотів спочатку нагрубити, але передумав.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: 'Esenin: Я вже казав: незручно комусь зі мною там було. Сиділи якісь… чортзна-хто.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: 'Esenin: Так воно, може, й добре, що виперли.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: 'Esenin: Ці живцем зжерли б і навіть не помітили б.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: 'Esenin: А що мені, здохнути під сонцем тепер?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: Ні, хазяїне, мені таке не цікаво.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: 'Esenin: Поки ще живий, пошукаю, з ким побалакати. Ти не впустиш — пощастить в іншому місці.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: 'Esenin: Може, навіть, пощастить зустрітись у цьому новому світі не з повним мудаком.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: 'Esenin: Дякую. Довіри до людей зараз — як у зайця хвоста.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: 'Esenin: Тому ціную твою довіру. Може, навіть… Хоча краще нічого не обіцяти.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: 'Esenin: Хм. Зрозуміло.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: 'Esenin: Розумію тебе, але все одно бісить. Ти такий само боягуз, як і всі.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: 'Esenin: Спи спокійно, дорогий хазяїне. А ще йди у сраку.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: Можна у тебе відпочити?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: Звідки ти прийшла?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: А далі куди підеш?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: 'Widow: Я вже не пам''ятаю. Та й яка різниця.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: 'Widow: Я дуже втомилась. Якщо не відпочину — просто впаду під вікнами.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: Твоєму другу погано?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: Твоєму другу потрібна допомога?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: 'Widow: Я… я просто хочу впасти десь і більше не вставати.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: Мені все одно, де я опинюсь.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: Твоєму другу погано?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: Твоєму другу потрібна допомога?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: Це мій чоловік.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: Він помер.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: 'Widow: Я не можу його нормально поховати. А кидати його десь безглуздо.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: 'Widow: Вже ні. Коли треба було, ніхто не допоміг.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: Тепер він помер.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: 'Widow: Він міг би досі жити, якби…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: 'Widow: Усім було не насрати.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: Навряд чи я залишусь надовго.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: 'Widow: Мені б тільки перепочити.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: Ти…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: О, здоров був.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: 'Scammer: Бачив, що діється? Обісратись можна.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: Як ся маєш тут взагалі?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: Що тобі треба?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: І що саме діється?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: 'Scammer: Так, просто цікавлюся.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: 'Scammer: А взагалі я маю одну темку, як можна легко грошей наварити.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: 'Scammer: Поки всі харапудяться від сонця, можна розбагатіти на раз-два.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: 'Scammer: Всякі чмошники сруть собі в штани, а треба просто ворушитися!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: То навіщо ти до мене прийшов?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: Що ти пропонуєш?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: 'Scammer: Нові можливості! Ти зовсім сліпий чи як?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: 'Scammer: Щось усі метушаться, як сцикуни, а можна робити свої справи від душі, та й усе.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: 'Scammer: Радіти треба, от що.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: То навіщо ти до мене прийшов?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: Що ти пропонуєш?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: Одразу до діла! Оце я люблю!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: 'Scammer: Всі думають, що ти тут щось каламутиш. Народ збираєш, ворушню затіяв.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: 'Scammer: Тож давай мутити разом! Ми тут з тобою справжнє свято влаштуємо!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: Виживати, а що ще?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: 'Scammer: Саме час мутити схеми, поки є можливість. До біса сонце!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: 'Scammer: Ворушитись треба, розумієш? Ну що, погнали?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: 'Scammer: О-о-о-о, ось це тема.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: Ну все, нарешті на розумну людину натрапив.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: 'Scammer: От же дурандас. Не побачив одразу, з ким справу маю.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: 'Scammer: Піду до твоїх сусідів, може, вони тямлять більше.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: Все, бувай.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: 'Neighbour: Привіт, сусіде. Давно не бачились. Як справи?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: Як завжди
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: Нормально
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: 'Neighbour: Слухай, я, власне, зайшов, бо трохи турбуюсь за тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: Насувається щось дуже погане.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: 'Neighbour: Мені дзвонила двоюрідна сестра. У них в новинах кажуть, що з сонцем відбувається щось дивне.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: 'Neighbour: А ще, що з-під землі вилазять люди. Їх чомусь називають Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: 'Neighbour: Жах якийсь. Сподіваюся, це все неправда.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: А що з сонцем?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: Гості?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: 'Neighbour: Слухай, я, власне, зайшов, бо трохи турбуюсь за тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: Насувається щось дуже погане.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: 'Neighbour: Мені дзвонила двоюрідна сестра. У них в новинах кажуть, що з сонцем відбувається щось дивне.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060952
    m_Localized: 'Neighbour: А ще, що з-під землі вилазять люди. Їх чомусь називають Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060953
    m_Localized: 'Neighbour: Жах якийсь. Сподіваюся, це все неправда.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060954
    m_Localized: А що з сонцем?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060955
    m_Localized: Гості?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060956
    m_Localized: 'Neighbour: Воно чи вибухає, чи спалахи на ньому…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060957
    m_Localized: 'Neighbour: Відомо лише, що з ним щось не так.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060958
    m_Localized: 'Neighbour: Такої спеки, як цього літа, ще ніколи не було. Ти ж помітив?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060959
    m_Localized: 'Neighbour: Схоже, час готуватися до гіршого.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060960
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060961
    m_Localized: 'Neighbour: Сестра сказала, що залишатися вдома одному небезпечно.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060962
    m_Localized: 'Neighbour: То я й прийшов, щоб тебе раптом не угробили.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060963
    m_Localized: Добре
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060964
    m_Localized: Я можу за себе постояти
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060965
    m_Localized: А як же твоя дочка та дружина?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060966
    m_Localized: 'Neighbour: Так. Нібито так називають людей з-під землі.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060967
    m_Localized: 'Neighbour: Хрін знає, чому саме така назва.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060968
    m_Localized: 'Neighbour: Може, тому що вони гості на цій землі.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060969
    m_Localized: 'Neighbour: Або тому, що вони намагаються потрапити до чужих домівок.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060970
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060971
    m_Localized: 'Neighbour: Сестра сказала, що залишатися вдома одному небезпечно.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060972
    m_Localized: 'Neighbour: То я й прийшов, щоб тебе раптом не угробили.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060973
    m_Localized: Добре
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060974
    m_Localized: Я можу за себе постояти
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060975
    m_Localized: А як же твоя дочка та дружина?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060976
    m_Localized: 'Neighbour: Гаразд, давай тоді продовжимо розмову зранку.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060977
    m_Localized: 'Neighbour: Я чекатиму тебе на кухні.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060978
    m_Localized: 'Neighbour: Вранці побачимось.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060979
    m_Localized: 'Neighbour: Знаю. Але мені здається, що зараз залишатися наодинці набагато небезпечніше, ніж ти думаєш.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060980
    m_Localized: 'Neighbour: Давай я побуду у тебе одну ніч про всяк випадок. Мені так буде спокійніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060981
    m_Localized: 'Neighbour: Щодо моїх дружини та дочки не переживай. До мене якраз днями приїхав добрий друг. Він наглядить за моєю сім''єю.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060982
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060983
    m_Localized: 'Neighbour: Гаразд, давай тоді продовжимо розмову зранку.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060984
    m_Localized: 'Neighbour: Я чекатиму тебе на кухні.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060985
    m_Localized: 'Neighbour: Вранці побачимось.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060986
    m_Localized: 'Neighbour: Не переживай, до мене якраз днями приїхав добрий друг. Він наглядить за моєю сім''єю.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060987
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060988
    m_Localized: 'Neighbour: Гаразд, давай тоді продовжимо розмову зранку.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060989
    m_Localized: 'Neighbour: Я чекатиму тебе на кухні.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060990
    m_Localized: 'Neighbour: Вранці побачимось.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060991
    m_Localized: 'Daughter: Здрастуйте!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060992
    m_Localized: 'Daughter: Мій тато у вас? Покличете його?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060993
    m_Localized: 'Daughter: Вдень було не страшно, але зараз багато людей повиходило вночі гуляти, і я боюсь…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060994
    m_Localized: Як звуть твого тата?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060995
    m_Localized: Розкажи щось про свого тата
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060996
    m_Localized: 'Daughter: Ви забули, як його звуть? А, ви перевіряєте, чи не Гість я.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060997
    m_Localized: 'Daughter: А ви хитрий! Буду теж людей перевіряти.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060998
    m_Localized: Спокійно дійшла сюди?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060999
    m_Localized: Боїшся Гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061000
    m_Localized: 'Daughter: Хм, я багато про нього знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061001
    m_Localized: 'Daughter: Перед тим, як піти в гості, він любить випити трохи пива, хі-хі.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061002
    m_Localized: 'Daughter: Мені він залишає смачний обід і вечерю. І сік.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061003
    m_Localized: 'Daughter: Я сьогодні скуштувала пиво, яке він п''є. Фу, гидота яка!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061004
    m_Localized: 'Daughter: Нащо таке пити, якщо є сік?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061005
    m_Localized: 'Daughter: Ой, тільки не кажіть йому, будь ласка.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061006
    m_Localized: Спокійно дійшла сюди?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061007
    m_Localized: Боїшся Гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061008
    m_Localized: 'Daughter: Знаєте, наче все перевернулося з ніг на голову.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061009
    m_Localized: 'Daughter: Люди вдень тепер сидять вдома чи сплять. А вночі гуляють та роблять справи.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061010
    m_Localized: 'Daughter: Я ще не відвикла боятися темряви, але наче й нема чого боятися.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061011
    m_Localized: 'Daughter: Чи є?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061012
    m_Localized: Покличу тата. Хай вам щастить!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061013
    m_Localized: На все добре!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061014
    m_Localized: 'Daughter: Не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061015
    m_Localized: 'Daughter: Усі їх бояться, мені теж страшно. Я жодного з них не бачила.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061016
    m_Localized: 'Daughter: Вони страшні? Боляче б''ють?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061017
    m_Localized: 'Daughter: Може, мій друг зі школи теж Гість. Він мене боляче вдарив.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061018
    m_Localized: 'Daughter: Тато сказав бути обережним, я дуууже обережна!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061019
    m_Localized: 'Daughter: Дуже тихенько прийшла сюди, ніхто мене не бачив.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061020
    m_Localized: Покличу тата. Хай вам щастить!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061021
    m_Localized: На все добре!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061022
    m_Localized: 'Daughter: Дякую, вам теж!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061023
    m_Localized: 'Daughter: Я вже хочу додому, бо мені страшно вночі.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061024
    m_Localized: 'Daughter: Ми гратимемо в нову гру. Він її сам придумав. Треба кидати кубики.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061025
    m_Localized: 'Daughter: І потім ти соваєш по хаті різні речі, крісло чи диван.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061026
    m_Localized: 'Daughter: Щоб виграти, треба зібрати все біля дверей. Я вам потім покажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061027
    m_Localized: 'Daughter: До побачення!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061028
    m_Localized: 'Daughter: З-зд-здрастуйте.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061029
    m_Localized: 'Daughter: Пустіть м-мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061030
    m_Localized: У тебе істерика?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061031
    m_Localized: Щось сталося?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061032
    m_Localized: 'Daughter: Я не-не знаю-ю-ю, що мені робити.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061033
    m_Localized: 'Daughter: В-В-Вони…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061034
    m_Localized: 'Daughter: А-а-а-а-а-а…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061035
    m_Localized: 'Daughter: Вбили та…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061036
    m_Localized: 'Daughter: А-а-а-аха-а-а-а…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061037
    m_Localized: 'Daughter: Та-та.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061038
    m_Localized: Хто це зробив?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061039
    m_Localized: Чому вони це зробили?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061040
    m_Localized: 'Daughter: А-а-а-а-а-а…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061041
    m_Localized: 'Daughter: Мо-мо-мого та-та…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061042
    m_Localized: 'Daughter: А-а-а-а-а-а-а-ах…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061043
    m_Localized: 'Daughter: Тата вби-или.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061044
    m_Localized: Хто це зробив?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061045
    m_Localized: Чому вони це зробили?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061046
    m_Localized: 'Daughter: До нас прийшли Го-о-ості. Вони си-сиділи в нас.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061047
    m_Localized: 'Daughter: Тато про щось го-го-говорив із ними. А потім вони його вбили.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061048
    m_Localized: 'Daughter: Аааааааааа-хааааааа!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061049
    m_Localized: 'Daughter: Наша хата те-тепер го-горииииить.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061050
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061051
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061052
    m_Localized: 'Daughter: Я не-не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061053
    m_Localized: 'Daughter: Вони спокійно си-си-сиділи з татом на кухні.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061054
    m_Localized: 'Daughter: А потім вони що-щось зроби-би-били, а потім під-підпалили хату.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061055
    m_Localized: 'Daughter: Я по-побігла, а вони просто сміялися.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061056
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061057
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061058
    m_Localized: 'Daughter: Ви до-допоможе-жете мені?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061059
    m_Localized: 'Daughter: Мені стра-а-а-шно.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061060
    m_Localized: 'Daughter: Куди я піду-у-у-ууууу?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061061
    m_Localized: 'Daughter: Ааааааааааа!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061062
    m_Localized: 'Daughter: ААААААААААААА!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061063
    m_Localized: 'Daughter: МЕНІ ДУЖЕ СТРА-А-АААШНООООО!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061064
    m_Localized: 'SuperFake: Привіт!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061065
    m_Localized: Що треба?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061066
    m_Localized: Я тебе не пущу
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061067
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061068
    m_Localized: 'SuperFake: Просторий будинок.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061069
    m_Localized: 'SuperFake: Мені подобається.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061070
    m_Localized: Мені нічого не треба
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061071
    m_Localized: У мене зброя
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061072
    m_Localized: 'SuperFake: А двері надійні у тебе?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061073
    m_Localized: 'SuperFake: Раптом що трапиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061074
    m_Localized: 'SuperFake: Сам розумієш.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061075
    m_Localized: Мені нічого не треба
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061076
    m_Localized: У мене зброя
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061077
    m_Localized: 'SuperFake: Так-так, розумію.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061078
    m_Localized: 'SuperFake: Слуууухай…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061079
    m_Localized: 'SuperFake: Ти сам вдома?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061080
    m_Localized: Ні, не сам
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061081
    m_Localized: Так, сам
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061082
    m_Localized: 'SuperFake: Це чудово!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061083
    m_Localized: 'SuperFake: «Все, що лишить мені совість, я би заїв і зубами», так?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061084
    m_Localized: 'SuperFake: Але скажи…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061085
    m_Localized: 'SuperFake: Ти сам вдома?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061086
    m_Localized: Ні, не сам
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061087
    m_Localized: Так, сам
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061088
    m_Localized: 'SuperFake: Сьогодні тобі пощастило.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061089
    m_Localized: 'SuperFake: Я чую, як хтось шепочеться у кімнатах.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061090
    m_Localized: 'SuperFake: Але хто знає, що буде за кілька днів?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061091
    m_Localized: 'SuperFake: Хахахахаха.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061092
    m_Localized: 'SuperFake: Мені зрозуміло, що ти один.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061093
    m_Localized: 'SuperFake: Хотів перевірити, чи збрешеш, чи ні.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061094
    m_Localized: 'SuperFake: Я відкрию.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061095
    m_Localized: 'NotTrue: Привіт, голубчику! Щось я притомилася сюди йти.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061096
    m_Localized: 'NotTrue: Відпочити у тебе можна?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061097
    m_Localized: Ви прямо сюди йшли?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061098
    m_Localized: Довго йшли?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061099
    m_Localized: 'NotTrue: Та не прямо сюди, звісна річ, хаха.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061100
    m_Localized: 'NotTrue: З ким треба, життя саме зведе, нікого не пропустимо.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061101
    m_Localized: 'NotTrue: Якщо сюди прийшла, значить, сюди ноги привели, очі примітили.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255104
    m_Localized: 'NotTrue: Мабуть, судилося так.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255105
    m_Localized: Не розумію, вам треба щось?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255106
    m_Localized: Так ішли б далі. Чому зупинились?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255107
    m_Localized: 'NotTrue: Та чи довго, не скажу. І як зрозуміти, що таке довго?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255108
    m_Localized: 'NotTrue: Взяти ось тебе. Сидиш, певно, вдома, а все одно ходиш.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255109
    m_Localized: 'NotTrue: Довго ходиш? Та вже, либонь, довго.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255110
    m_Localized: 'NotTrue: А я довше за тебе топчу-гарцюю.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255111
    m_Localized: 'NotTrue: Такі справи, голубчику.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255112
    m_Localized: Не розумію, вам треба щось?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255113
    m_Localized: Так ішли б далі. Чому зупинились?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255114
    m_Localized: 'NotTrue: Та як і всім.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255115
    m_Localized: 'NotTrue: Дах знайти, історій яких послухати, самій чимось цікавим поділитись.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255116
    m_Localized: 'NotTrue: А ще прилягти, очі солодко заплющити.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255117
    m_Localized: 'NotTrue: І видихнути як слід.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255118
    m_Localized: 'NotTrue: Більше нічого й не треба. А то самій нудно-сумно.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255119
    m_Localized: Проходьте
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255120
    m_Localized: Вам краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255121
    m_Localized: 'NotTrue: Ти мене наче не слухаєш, голубчику.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255122
    m_Localized: 'NotTrue: Притомилася йти вже.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255123
    m_Localized: 'NotTrue: У тебе можна хоч подих перевести, погутарити з кимось.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255124
    m_Localized: 'NotTrue: Вже якась розвага мені, старій.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255125
    m_Localized: 'NotTrue: Ти що-небудь розповіси, я чим поділюся.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255126
    m_Localized: 'NotTrue: А там уже можна й повіки хоч стулити.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255127
    m_Localized: Проходьте
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255128
    m_Localized: Вам краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255129
    m_Localized: 'NotTrue: Спасибі, голубе!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255130
    m_Localized: 'NotTrue: Відчуваю, у тебе нудно не буде. Хоч подивлюсь, що тут діється.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255131
    m_Localized: 'NotTrue: Всюди мене женуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255132
    m_Localized: 'NotTrue: Бо ж не вовча та кров, що живе у мені, моє місце в сосновій труні.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255133
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255134
    m_Localized: 'NotTrue: А врешті-решт все одно звертаються до мене, навіть якщо кажуть, що ніколи не прийдуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255135
    m_Localized: 'NotTrue: Та я не образлива, всім допомагаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255136
    m_Localized: 'NotTrue: Навіть тобі допомогти доведеться. А куди подітись?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255137
    m_Localized: 'Twins: Здрастуйте. Ох, тримайся поки за мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255138
    m_Localized: 'Twins: Нічого, що ми до вас?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255139
    m_Localized: Вашій подрузі погано?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255140
    m_Localized: Ви обидві хворі? Чи лише одна?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255141
    m_Localized: 'Twins: Це моя сестра. У неї депресія.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255142
    m_Localized: 'Twins: Вона не може сама ходити, купатися, іноді їй тяжко навіть підвестися з ліжка.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255143
    m_Localized: 'Twins: Але нічого, з часом одужає. Так, сестричко?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255144
    m_Localized: 'Twins: Вона поки не в змозі вести розмову, але іноді знаходить для цього сили.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255145
    m_Localized: Що робитимете далі?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255146
    m_Localized: Вам не набридло возитися з нею?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255147
    m_Localized: 'Twins: Ми всі різною мірою хворі на депресію.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255148
    m_Localized: 'Twins: Ми розуміли, до чого все йде, ще до початку проблем із сонцем.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255149
    m_Localized: 'Twins: Ви стежили за новинами? Все йшло до цього. Але, я вважаю, до вибуху сонця все ж таки не дійде.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255150
    m_Localized: Що робитимете далі?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255151
    m_Localized: Вам не набридло возитися з нею?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255152
    m_Localized: 'Twins: Треба знайти місце, де сестра почуватиметься трохи спокійніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255153
    m_Localized: 'Twins: А потім сплануємо нове життя.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255154
    m_Localized: 'Twins: Кажуть, жити далі неможливо.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255155
    m_Localized: 'Twins: Та я не погоджуюся. Далі має стати легше.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255156
    m_Localized: Проходьте
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255157
    m_Localized: Вам краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255158
    m_Localized: 'Twins: Ви слова підбирайте, будь ласка.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255159
    m_Localized: 'Twins: Так, це забирає сили, але я не можу її кинути, якщо ви про це.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255160
    m_Localized: 'Twins: Ми разом з нею пішли з дому батьків. Більше у нас немає жодного якоря у житті.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255161
    m_Localized: Проходьте
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255162
    m_Localized: Вам краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255163
    m_Localized: 'Twins: Дякую! Допоможіть мені її завести.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255164
    m_Localized: 'Twins: Смерть батьків наче підкосила її ще сильніше, але вона вже довго в такому стані.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255165
    m_Localized: 'Twins: Може, у вас вона трохи прийде до тями.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255166
    m_Localized: 'Twins: Уф. Нічого, сестричко, пошукаємо щастя ще десь.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255167
    m_Localized: 'Twins: Ну ж бо, ходімо, допоможи мені трохи.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255168
    m_Localized: 'Twins: Ох, лишенько, коли це скінчиться…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714688
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714689
    m_Localized: 'Firefighter: Нам перед тим, як відправити гасити пожежу, дали на роботі ось цей папірець.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714690
    m_Localized: 'Firefighter: Хотіли, щоб ми з''явилися до каранітних зон КНС. Тільки хто ж туди піде, якщо там усі гинуть…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714691
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714692
    m_Localized: 'Firefighter: Мені він все одно більше не потрібен. Тримай. Можеш його викинути чи якось використати.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714693
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714694
    m_Localized: 'Firefighter: У мене з собою є, кхе-кхе, папірець один. Нібито важливий.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714695
    m_Localized: 'Firefighter: Я готовий тобі його віддати, якщо все ж таки впустиш мене і даси мені спокійно дожити свої дні…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714696
    m_Localized: Добре, проходь
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714697
    m_Localized: Не треба, залиш собі
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714698
    m_Localized: 'Wheelchair: Та що ти? Га?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714699
    m_Localized: 'Wheelchair: Я ж бачу, що ти нормальний чувак. Може, Енержека змусить тебе передумати?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714700
    m_Localized: 'Wheelchair: Бо я так заїбався сюди котити, якби ти знав!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714701
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714702
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714703
    m_Localized: 'Wheelchair: На, хапай Енержеку! За те, що впустив!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908992
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908993
    m_Localized: 'Anger: Ну ти й гандон.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908994
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908995
    m_Localized: 'Anger: Гаразд, слухай, я…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908996
    m_Localized: 'Anger: Давай я дам тобі Енержеку, а ти мене впустиш?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908997
    m_Localized: 'Anger: Щоб, блять, всім було добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908998
    m_Localized: Забирайся звідси
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909000
    m_Localized: 'Anger: Ти не хвилюйся… Я нікого не чіпаю. А цю кофеїнову бурду тобі віддам. Від гріха подалі.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909001
    m_Localized: 'Anger: Візьми банку.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909002
    m_Localized: 'Anger: Мені б краще заспокоїтись, а не пити ось це.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909003
    m_Localized: 'Anger: ...Ага. Бачу, тут вже {0}. Зрозуміло: тут всі слово сказати бояться, прогинаються, аби до них не лізли. Таких я не терплю.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909004
    m_Localized: 'Anger: Гидко навіть бути з такими поруч. Або ось ця хуйня, або я. По-іншому не буде.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909005
    m_Localized: 'Anger: Я не вмію жити з тими, хто все проковтне мовчки замість того, щоб вити.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909006
    m_Localized: Я розберуся. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909007
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909008
    m_Localized: 'Anger: Скажу тобі чесно.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909009
    m_Localized: 'Anger: Дякую, що вирішив не мовчати, коли від тебе щось залежить.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909010
    m_Localized: 'Anger: Я постараюся… Ну, ти зрозумів.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909011
    m_Localized: 'Anger: Оце, сука, просто чудово.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909012
    m_Localized: 'Anger: Краще влаштувати сраку в теплі, поруч з тими, хто вже прижився, га?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909013
    m_Localized: 'Anger: Та срав я на всіх вас. Йдіть ви нахуй, блядь!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909014
    m_Localized: 'Fanatic: Ось тобі щедра нагорода від САМОГО Сонцеликого: тримай Енержеку! Ти це заслужив, ЛЮДИНО! '
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909015
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909016
    m_Localized: 'Fanatic: Ти що, зовсім довбня?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909017
    m_Localized: 'Fanatic: Ти проганяєш ПРАВЕДНУ ЛЮДИНУ!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909018
    m_Localized: 'Fanatic: Якщо пустиш мене, отримаєш щедру нагороду від самого СОНЦЕЛИКОГО. Подумай ще раз як слід!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909019
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909020
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297600
    m_Localized: 'Super: Ніхто не дізнається, що сталося, коли прийшов останній Гість.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297601
    m_Localized: 'Super: Ваш дім дуже надовго залишився без мешканців.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297602
    m_Localized: 'Super: Після вашого страшного зникнення всі його залишили та уникають, як чуми.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297603
    m_Localized: 'NotTrue: Ой, голубе ... а хто це у тебе тут, {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297604
    m_Localized: 'NotTrue: То хтось гримить, то шепочеться собі під ніс з тінями… Я таких місць боюся.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297605
    m_Localized: 'NotTrue: Я ж не дарма мандрую одна, знаєш? Де надто багато гамору чи надто багато облич — там мені не бувати.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297606
    m_Localized: 'NotTrue: Краще ти вже будь з ними, якщо вони тобі миліші. А я постою на ґанку, зачекаю, поки вітри змін вщухнуть. Не гнівись, але такі чвари не для мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297607
    m_Localized: 'NotTrue: Я не витримаю — розвіюся прахом.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297608
    m_Localized: Я розберуся. Заходьте
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297609
    m_Localized: Краще йдіть звідси
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297610
    m_Localized: 'NotTrue: Ну, коли так, я спробую. Але якщо знову запахне грозою чи дзеркальною брехнею — я піду. Старе серце не любить тривоги.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297611
    m_Localized: 'NotTrue: Та я відчуваю, що тут мені не місце. То й хай… Зберу я свої казки та піду далі.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297612
    m_Localized: 'NotTrue: Ти тільки дивися пильно. Не всяка правда гучна. Бува, що й шепоче, а наче ножем ріже.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297613
    m_Localized: 'Twins: Ну будь ласка…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297614
    m_Localized: 'Twins: Впустіть нас хоча б на днинку, прошу. У нас тут дещо є…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297615
    m_Localized: 'Twins: Ми в боргу не залишимося…'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297616
    m_Localized: Гаразд, заходьте
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297617
    m_Localized: Забирайтеся звідси
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297618
    m_Localized: 'Twins: Дякую велике!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297619
    m_Localized: 'Twins: Ось, візьміть Енержеку. Це все, що ми маємо з собою.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297620
    m_Localized: 'Twins: Тепер допоможіть мені завести сестру.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297621
    m_Localized: 'Twins: …'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297622
    m_Localized: 'Twins: Мабуть, ні, тут {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297623
    m_Localized: 'Twins: Немов повітря тисне надто сильно. Начебто чужі думки звучать голосніше за свої.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297624
    m_Localized: 'Twins: Їй не можна в таке. Вона одразу… стискається. Начебто її зовсім нема.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297625
    m_Localized: 'Twins: А мені… мені теж важко дихати поряд з такою людиною.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297626
    m_Localized: 'Twins: Вибачте. Ми зачекаємо, поки… поки що все не уляжеться. Може, просто якось мине.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297627
    m_Localized: Я розберуся. Заходьте
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297628
    m_Localized: Краще йдіть звідси
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297629
    m_Localized: 'Twins: Дякую. Обережно, під спину їй руку… Ось так.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297630
    m_Localized: 'Twins: Смерть батьків, здається, щось у ній… зламала. Але вона тримається як може.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297631
    m_Localized: 'Twins: Довго вже у цьому. Я сподівалася, що тут їй стане трохи легше.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297632
    m_Localized: 'Twins: …Зрозуміла.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297633
    m_Localized: 'Twins: Сестричко, потерпи ще трохи. Ми знайдемо де перепочити. Ось. Обіприся. Я з тобою.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297634
    m_Localized: 'Twins: Іноді все здається… занадто. Навіть прості двері. Але ж треба йти. Ну ж бо… крок за кроком.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861312
    m_Localized: 'Firefighter: Дякую тобі, друже, кхе-кхе.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861313
    m_Localized: 'Firefighter: Думаю, я надовго у тебе не затримаюсь, кхе-кхе.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861314
    m_Localized: 'Firefighter: Хоч не на сирій землі доведеться вмирати.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861315
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861316
    m_Localized: 'Firefighter: Нам перед тим, як відправити гасити пожежу, дали на роботі ось цей папірець.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861317
    m_Localized: 'Firefighter: Хотіли, щоб ми з''явилися до каранітних зон КНС. Тільки хто ж туди піде, якщо там усі гинуть…'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861318
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861319
    m_Localized: 'Firefighter: Мені він все одно більше не потрібен. Тримай. Можеш його викинути чи якось використати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257472
    m_Localized: 'Theorist: Здрастуйте, скажіть, чи можу я вам довіряти?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257473
    m_Localized: 'Theorist: Ви ж ніяк не пов''язані з КНС?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257474
    m_Localized: Довіряти? Ти про що?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257475
    m_Localized: Ні, я не з КНС
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257476
    m_Localized: 'Theorist: Як про що? Про важливу інформацію.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257477
    m_Localized: 'Theorist: Мені потрібен притулок, щоб продовжувати дослідження.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257478
    m_Localized: 'Theorist: У мене з собою дуже цінні папери.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257479
    m_Localized: 'Theorist: Там кілотонни інформації, важливі відомості, які я хочу оприлюднити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257480
    m_Localized: Що це за важливі відомості?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257481
    m_Localized: Звідки в тебе ці відомості?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257482
    m_Localized: 'Theorist: Фух, радий це чути. Отже, вам можна довіряти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257483
    m_Localized: 'Theorist: Розумієте, за протоколом співробітники КНС не мають права приховувати свій рід діяльності.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257484
    m_Localized: 'Theorist: Отже, якби ви були одним з них, то не змогли б збрехати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257485
    m_Localized: 'Theorist: Виходить, я можу поділитись з вами дуже важливими відомостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257486
    m_Localized: Що це за важливі відомості?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257487
    m_Localized: Звідки в тебе ці відомості?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257488
    m_Localized: 'Theorist: Ох, друже мій, приготуйтеся. Я вам відкрию очі багато на що…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257489
    m_Localized: 'Theorist: Підтасовування виборів. Факти, що спростовують політ на Місяць…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257490
    m_Localized: 'Theorist: Як нас контролюють за допомогою фаст-фуду та, нарешті…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257491
    m_Localized: 'Theorist: Чому чіпси зі смаком картоплі — це неймовірна помилка науки та й просто найстрашніший несмак.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257492
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257493
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257494
    m_Localized: 'Theorist: Що ж, я сам вирішив вам довіритись, тож скажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257495
    m_Localized: 'Theorist: Але пообіцяйте, що це залишиться строго між нами.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257496
    m_Localized: 'Theorist: Я співробітник НДІ, зі скандалом звільнений через мою наукову роботу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257497
    m_Localized: 'Theorist: Я стверджую, що справжня загроза — це не Гості, а паразити, які сидять у їхніх мізках.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257498
    m_Localized: 'Theorist: Але ці ідіоти не хочуть визнавати науковість моїх відкриттів.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257499
    m_Localized: 'Theorist: Насправді достатньо всього лише носити беруші, щоб паразити не залізли у вуха. Це б могло врятувати тисячі людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257500
    m_Localized: 'Theorist: Тому я з гордістю пішов, прихопивши з собою ще кілька цінних архівів.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257501
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257502
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257503
    m_Localized: 'Theorist: Я знав, що можу вам довіряти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257504
    m_Localized: 'Theorist: Повірте, я вже ж бо знаю правду! Усі колишні правди — геть!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257505
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257506
    m_Localized: 'Theorist: Ви робите помилку!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257507
    m_Localized: 'Theorist: Людство заслуговує знати правду!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257508
    m_Localized: 'Theorist: Прощавайте. Я вам вірив, а ви зруйнували мою віру в людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257509
    m_Localized: 'Wifefema: Вітаннячко! Можна у вас оселитись ненадовго?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257510
    m_Localized: 'Wifefema: Я приїхала в місто до свого чоловіка. Його перевели працювати сюди.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257511
    m_Localized: 'Wifefema: Хотіла зробити сюрприз та побачитись.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257512
    m_Localized: 'Wifefema: Але, на жаль, на його роботі не можуть надати мені житло.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257513
    m_Localized: Як ви сюди дісталися?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257514
    m_Localized: Ким працює ваш чоловік?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257515
    m_Localized: 'Wifefema: Та як, на таксі!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257516
    m_Localized: 'Wifefema: Майже розорилася на ньому, воно зараз коштує як крило від літака.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257517
    m_Localized: 'Wifefema: Але богом присягаюся, зубки у таксиста були білесенькі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257518
    m_Localized: 'Wifefema: Ось добереться до нього мій чоловік з КНС — ми йому миттю зубки перерахуємо, хе-хе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257519
    m_Localized: Ви теж з КНС?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257520
    m_Localized: Ким ваш чоловік працював раніше?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257521
    m_Localized: 'Wifefema: О, я вам на це з гордістю відповім: КНС!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257522
    m_Localized: 'Wifefema: Я коли дізналася, що його туди перевели — стрибала від щастя!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257523
    m_Localized: 'Wifefema: Ось і хотіла зробити йому сюрприз, аж на таксі розщедрилась.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257524
    m_Localized: 'Wifefema: Ну дуже багато з мене здер таксист проклятий.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257525
    m_Localized: Ви теж з КНС?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257526
    m_Localized: Ким ваш чоловік працював раніше?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257527
    m_Localized: 'Wifefema: Хех, та хотіла б. Але жінок туди не беруть, як на лихо.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257528
    m_Localized: 'Wifefema: А шкода, я б з чоловіком Гостей добряче вишукувала. У мене на них нюх.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257529
    m_Localized: 'Wifefema: Я раніше на митниці працювала, людей пропускала через кордон.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257530
    m_Localized: 'Wifefema: Хех, багато я там виродків з усяким лайном відловила.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257531
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257532
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257533
    m_Localized: 'Wifefema: Хех, так я вам й сказала. Навіщо вам це знати?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257534
    m_Localized: 'Wifefema: Яка різниця, якщо зараз він працює у КНС? Ехх, от би жінок теж туди брали…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257535
    m_Localized: 'Wifefema: Це несправедливо, ось чим я гірша за чоловіка?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257536
    m_Localized: 'Wifefema: Я ж на митниці працювала раніше, у мене вже нюх з''явився на підозрілих осіб.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257537
    m_Localized: 'Wifefema: Оце все, що КНС не жіноча робота — я вважаю, це маячня.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257538
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257539
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257540
    m_Localized: 'Wifefema: Ось це діло!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257541
    m_Localized: 'Wifefema: Нічого, ось повбиваємо всіх Гостей — відразу заживемо як раніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257542
    m_Localized: 'Wifefema: Та як так, га?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257543
    m_Localized: 'Wifefema: Ви мене за Гостя прийняли чи що?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257544
    m_Localized: 'Wifefema: Ви що, дурень? У мене ж чоловік з КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257545
    m_Localized: 'Wifefema: Я щось вас не розумію. Я вам тут душу розкриваю, а ви мені харкаєте туди, виходить?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257546
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257547
    m_Localized: 'Wifefema: А знаєш що, хуй з тобою. Піду до твоїх сусідів. Прощавай, бовдуре.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257548
    m_Localized: 'Raskolnikov: Привіт, друже.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257549
    m_Localized: 'Raskolnikov: Скажи, ти озброєний?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257550
    m_Localized: Навіщо тобі це знати?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257551
    m_Localized: Так, у мене є рушниця
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257552
    m_Localized: 'Raskolnikov: Ох, вибач, не хотів здатися грубим.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257553
    m_Localized: 'Raskolnikov: Просто часи зараз небезпечні, сам розумієш. Треба знати, чи можеш ти постояти за себе та знищити будь-яку загрозу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257554
    m_Localized: 'Raskolnikov: Хто буде судити людей під час катаклізму за вбивство? Це все одно, що штрафувати за перевищення швидкості на перегонах.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257555
    m_Localized: 'Raskolnikov: Але звучиш ти грізно, тож натура у тебе, мабуть, теж сувора.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257556
    m_Localized: 'Raskolnikov: Напевно, ти без проблем когось застрелиш чи навіть вб''єш голими руками, якщо треба.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257557
    m_Localized: Чому тебе так цікавлять вбивства?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257558
    m_Localized: Від кого тобі потрібен захист?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257559
    m_Localized: 'Raskolnikov: О, чудово! Тобто ти зможеш вбивати всіх Гостей, що прийдуть сюди.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257560
    m_Localized: 'Raskolnikov: Ти тільки не подумай, що я хочу тебе налаштувати проти інших.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257561
    m_Localized: 'Raskolnikov: Просто я зіткнувся з одним озброєним психопатом, який при мені допитував когось, чи не Гість він.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257562
    m_Localized: 'Raskolnikov: Добре, що він мене не помітив, а то дивись, ще б прихлопнув.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257563
    m_Localized: 'Raskolnikov: Але нічого, колись і я навчуся вбивати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257564
    m_Localized: 'Raskolnikov: І тоді не я боятимуся інших, а інші боятимуться мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257565
    m_Localized: Чому тебе так цікавлять вбивства?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257566
    m_Localized: Від кого тобі потрібен захист?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257567
    m_Localized: 'Raskolnikov: Що? Чому тобі так здалося?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257568
    m_Localized: 'Raskolnikov: Я не хочу виглядати якимось психопатом. Просто, знаєш…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257569
    m_Localized: 'Raskolnikov: Раніше, у спокійні часи, я навіть мухи не образив би. Але зараз м''якотілі люди довго не живуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257570
    m_Localized: 'Raskolnikov: Боюся, що зі мною може статися, якщо не навчуся вбивати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257571
    m_Localized: 'Raskolnikov: Тому я й хочу знайти людину, яка здатна, ну, розібратись з ким треба.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257572
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257573
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257574
    m_Localized: 'Raskolnikov: Ні, ні, не подумай, я не про того психопата з рушницею.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257575
    m_Localized: 'Raskolnikov: Мені, звісно, потрібен захист від Гостей. І від людей, які полюють на них.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257576
    m_Localized: 'Raskolnikov: Зараз будь-хто тут же тисне на спуск, якщо ти хоч трохи схожий на Гостя.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257577
    m_Localized: 'Raskolnikov: А от я… просто боягуз, нездатний постояти за себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257578
    m_Localized: 'Raskolnikov: Тому я дуже хочу знайти людину, яка може мене захистити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257579
    m_Localized: 'Raskolnikov: А ще я хотів би, щоб ти, як би це сказати, навчив мене…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257580
    m_Localized: 'Raskolnikov: Вбивати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257581
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257582
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257583
    m_Localized: 'Raskolnikov: Дякую, друже.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257584
    m_Localized: 'Raskolnikov: До речі, якщо ти будеш не проти, після того, як перевіриш мене…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257585
    m_Localized: 'Raskolnikov: Покажи мені, як ти вбиваєш Гостей. Хочу подивитись страху в очі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257586
    m_Localized: 'Raskolnikov: Ти вирішив мене не впускати?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257587
    m_Localized: 'Raskolnikov: Напевно, я здався тобі божевільним або психопатом…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257588
    m_Localized: 'Raskolnikov: Я насправді не такий, просто на нервах останнім часом.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257589
    m_Localized: 'Raskolnikov: Вибач, що забрав твій час. Сподіваюсь, я навчуся вбивати та зможу постояти за себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257590
    m_Localized: 'Nun: Бачу, ваш будиночок на відшибі стоїть.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257591
    m_Localized: 'Nun: Здається, мені якраз підійде.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257592
    m_Localized: Підійде для чого?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257593
    m_Localized: Що вам треба?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257594
    m_Localized: 'Nun: Господи, я ж з вами однією мовою розмовляю…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257595
    m_Localized: 'Nun: Для поселення, рідненький!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257596
    m_Localized: 'Nun: І якщо ми торкнулися цієї теми, скажіть, будь ласка…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257597
    m_Localized: 'Nun: Сподіваюсь, у вас є ікони? Попереджаю, мені потрібна повна тиша для молитви та роздумів.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257598
    m_Localized: Тобі тут не готель!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257599
    m_Localized: Ти охуїла чи що?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257600
    m_Localized: 'Nun: Мені потрібне місце у вашій оселі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257601
    m_Localized: 'Nun: Ви ж приймаєте до себе людей, правда? У мене лише кілька умов.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257602
    m_Localized: 'Nun: По-перше, я терпіти не можу алкоголіків та наркоманів.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257603
    m_Localized: 'Nun: Якщо вони у вас є — краще кажіть мені одразу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257604
    m_Localized: 'Nun: По-друге, у вас часом блощиці не завелися? Щури у стінах не живуть?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257605
    m_Localized: 'Nun: Моя душа їх не терпить. Шкіра також — у мене від них подразнення.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257606
    m_Localized: Тобі тут не готель!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257607
    m_Localized: Ти охуїла чи що?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257608
    m_Localized: 'Nun: Ох, дякую, що пояснили, бо я сама не помітила.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257609
    m_Localized: 'Nun: Я просто хочу знати, чи варто мені у вас селитись. А то, знаєте, у мене алергія на всякий бруд.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257610
    m_Localized: 'Nun: Хіба я так багато прошу?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257611
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257612
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257613
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257614
    m_Localized: 'Nun: Ви хам і нахабник!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257615
    m_Localized: 'Nun: Побійтеся Бога! Як вам не соромно!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257616
    m_Localized: 'Nun: Я питаю, чи у вас нормальний будинок, а ви мене матюками криєте?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257617
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257618
    m_Localized: 'Nun: Нічого, я вже постараюсь, щоб тут не було місця брудним словам.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257619
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257620
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257621
    m_Localized: 'Nun: Ох, дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257622
    m_Localized: 'Nun: Ах от воно як, значить.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257623
    m_Localized: 'Nun: Не пустити мене, бідну бабусю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257624
    m_Localized: 'Nun: Моя смерть буде на вашій совісті.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257625
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257626
    m_Localized: 'Nun: Вам ще віддячиться!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257627
    m_Localized: 'Fugitive: Допоможи…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257628
    m_Localized: 'Fugitive: Мене підстрелили, довго не протягну.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257629
    m_Localized: Хто тебе так?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257630
    m_Localized: Що сталося?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257631
    m_Localized: 'Fugitive: КНС-ники, падлюки, підстрелили мене, коли я… Через паркан перелізав, щоб втекти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257632
    m_Localized: 'Fugitive: Скажу так: вони закінчені мазїї. Але одна куля… все ж таки зачепила.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257633
    m_Localized: 'Fugitive: На щастя, пройшла наскрізь. Тільки от крові… пиздець скільки крові, в живіт влучили.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257634
    m_Localized: 'Fugitive: Стікаю кров''ю, як заколота свиня. Добре, що хоч кишки не навиворіт, хе-хе, кх-кх.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257635
    m_Localized: Розкажи про карантинні зони КНС
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257636
    m_Localized: КНС тебе переслідують?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257637
    m_Localized: 'Fugitive: Я втік із… карантинної зони КНС. Мене забрали туди, коли наш будинок перевіряли.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257638
    m_Localized: 'Fugitive: Згодом постукали до мене в квартиру. Відкрив, а вони почали мене оглядати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257639
    m_Localized: 'Fugitive: А коли закінчили та в планшети щось записали, одразу сказали, що треба проїхати з ними.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257640
    m_Localized: 'Fugitive: А я взяв та й послав їх у сраку з такими вимогами. Ось вони й пов''язали мене, наче злочинця. А потім я втік.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257641
    m_Localized: Розкажи про карантинні зони КНС
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257642
    m_Localized: КНС тебе переслідують?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257643
    m_Localized: 'Fugitive: Уяви собі огороджений парканом пустир із парою наметів.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257644
    m_Localized: 'Fugitive: А ще там великий вантажний контейнер, куди людей заганяють щоранку, як худобу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257645
    m_Localized: 'Fugitive: Ось тобі й карантинна зона КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257646
    m_Localized: 'Fugitive: А захист у них — курям на сміх.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257647
    m_Localized: 'Fugitive: Мені взагалі не довелося якось готуватися. Треба було лише… момент підгадати та через паркан перелізти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257648
    m_Localized: 'Fugitive: Вони там дуже зайняті. Відчувається… що до чогось готуються.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257649
    m_Localized: 'Fugitive: Правда, мені трохи не пощастило. Один з цих… виродків повернувся та помітив мене. І почав стріляти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257650
    m_Localized: 'Fugitive: Я відразу хряпнувся з паркану прямо в калюжу, а потім побіг.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257651
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257652
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257653
    m_Localized: 'Fugitive: Ох, приятелю, будь у цьому впевнений.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257654
    m_Localized: 'Fugitive: Може, ти чув, що КНС… проводять досліди для виявлення Гостей?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257655
    m_Localized: 'Fugitive: Так от, це, сука, не чутки!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257656
    m_Localized: 'Fugitive: БЛЯТЬ, у мене на очах забрали людину і відвели в один із наметів!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257657
    m_Localized: 'Fugitive: Звідти пролунали заглушені крики, а потім… винесли чорний мішок, а той бідолаха так і не вийшов! Дійшло?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257658
    m_Localized: 'Fugitive: Вони забирають нас, щоб ставити досліди. Тож звідти ніхто й не повертається!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257659
    m_Localized: 'Fugitive: Коли я побачив це лайно, одразу зрозумів, що до чого, та вирішив — треба драпати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257660
    m_Localized: 'Fugitive: Тому я й втік, хоч і не пощастило — надало заробити кулю, поки через паркан перелазив.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257661
    m_Localized: 'Fugitive: Боюся, що тепер я для них… небезпечний свідок, і вони мене шукатимуть…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257662
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257663
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257664
    m_Localized: 'Fugitive: Ох, дякую, приятелю. Життям тобі зобов''язаний.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257665
    m_Localized: 'Fugitive: Добре, що ти не такий, як твої сусіди.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257666
    m_Localized: 'Fugitive: БЛЯТЬ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257667
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257668
    m_Localized: 'Fugitive: Зрозуміло, ви всі тут такі. Маленькі боягузливі звірята.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257669
    m_Localized: 'Fugitive: Закопуєтесь у свої хатинки та нікого не пускаєте.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257670
    m_Localized: 'Fugitive: На добраніч, мудило.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257671
    m_Localized: 'Bestson: Можете мені сказати, що відбувається?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257672
    m_Localized: 'Bestson: Спека така, що задихаєшся, та ще й з людьми щось не те.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257673
    m_Localized: 'Bestson: Шмаляють, б''ють один одного, я не розумію…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257674
    m_Localized: Стривай, ти взагалі не в курсі останніх подій?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257675
    m_Localized: Ти хоч телевізор дивишся?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257676
    m_Localized: 'Bestson: Ні. Я не стежу за новинами, від них мені тривожно. А от батьки…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257677
    m_Localized: 'Bestson: Якось я прокинувся, а вони в паніці. Сказали, що їм треба негайно кудись їхати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257678
    m_Localized: 'Bestson: Вже минув тиждень… а вони так і не повернулися. Я все чекаю, але вони просто зникли…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257679
    m_Localized: 'Bestson: Мені треба знати правду: куди вони ділись. Скажіть, що відбувається?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257680
    m_Localized: З-під землі вилізли Гості. Нікому не можна довіряти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257681
    m_Localized: На сонці вибухи. Тепер воно спалює людей живцем
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257682
    m_Localized: 'Bestson: Розумієте, у новинах кажуть тільки погане. Після них я дуже панікую, тож не дивлюся.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257683
    m_Localized: 'Bestson: Крім того, я чув, що ті, хто не стежить за новинами, живуть довше.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257684
    m_Localized: 'Bestson: А от моя мати з батьком постійно їх дивилися.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257685
    m_Localized: 'Bestson: Та якось почули, що сталося щось жахливе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257686
    m_Localized: 'Bestson: Я не вмикав телевізор, щоб не хвилюватись. Але батьки так і не повернулись, а я навіть не знаю, що діється.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257687
    m_Localized: 'Bestson: Вони подивились новини та за кілька годин вже поїхали. І досі не повернулися. Тепер мені ще страшніше включати телек.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257688
    m_Localized: 'Bestson: Я подумав, що простіше буде дізнатися всю правду від людей. Можете сказати, що трапилось?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257689
    m_Localized: З-під землі вилізли Гості. Нікому не можна довіряти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257690
    m_Localized: На сонці вибухи. Тепер воно спалює людей живцем
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257691
    m_Localized: 'Bestson: Боже. Невже Гості їх убили…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257692
    m_Localized: 'Bestson: Чорт, навіщо вони поїхали? Чому не взяли мене з собою?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257693
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257694
    m_Localized: 'Bestson: Не знаю тепер, що думати. Мабуть, ви й мені не довіряєте.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257695
    m_Localized: 'Bestson: І що робити?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257696
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257697
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257698
    m_Localized: 'Bestson: Господи, невже вони згоріли на сонці…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257699
    m_Localized: 'Bestson: Це… Це якийсь жах…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257700
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257701
    m_Localized: 'Bestson: І що мені робити?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257702
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257703
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257704
    m_Localized: 'Bestson: Не знаю, чи хороша це ідея.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257705
    m_Localized: 'Bestson: Раптом вони повернуться, а мене не буде вдома.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257706
    m_Localized: 'Bestson: Але… Напевно, поки що краще побути у вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257707
    m_Localized: 'Bestson: Що ж, мабуть, так буде краще.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257708
    m_Localized: 'Bestson: Піду назад додому. Раптом мої батьки повернуться.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257709
    m_Localized: 'Bestson: Так, я думаю, повернуться… Напевно…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257710
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257711
    m_Localized: 'Bestson: Бувайте, незнайомцю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257712
    m_Localized: 'Buddy: Привіт, дружище. Пусти, будь ласка, добру людину до себе в хату.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257713
    m_Localized: А що в тебе сталося?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257714
    m_Localized: Звідки мені знати, що ти «добра» людина?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257715
    m_Localized: 'Buddy: Та дрібниці.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257716
    m_Localized: 'Buddy: Всього-навсього теща виставила за те, що я КНС-ника з дому вишпурнув. Тепер боїться, що прийдуть за нами.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451776
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451777
    m_Localized: 'Buddy: Хе-хе-хе, ти що, повірив? Та це я так, жартую.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451778
    m_Localized: 'Buddy: Немає у мене ніякої тещі, та й дружини навіть немає.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451779
    m_Localized: 'Buddy: То якщо раптом захочеш до шинка, я тобі підтримаю компанію.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451780
    m_Localized: Ти що, комік?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451781
    m_Localized: Здається, ти напідпитку
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451782
    m_Localized: 'Buddy: Повір мені, я найбільший добряк на світі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451783
    m_Localized: 'Buddy: Я б''ю лише тих, у кого білі зуби та гарні очі, бо заздрю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451784
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451785
    m_Localized: 'Buddy: Хе-хе-хе, ти що, повірив? Та жартую я, не бери у голову.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451786
    m_Localized: 'Buddy: Одна-дві незвичних риси не означають, що ти Гість.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451787
    m_Localized: 'Buddy: Я б не став вбивати через якісь зуби, очі чи що там ще вигадали по телевізору. У мене б рука не…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451788
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451789
    m_Localized: 'Buddy: Проїхали.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451790
    m_Localized: Ти що, комік?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451791
    m_Localized: Здається, ти напідпитку
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451792
    m_Localized: 'Buddy: Ну не те щоб прям комік. Але чому б трохи не пожартувати, коли скрізь все погано?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451793
    m_Localized: 'Buddy: Гумор — він, дружище, допомагає пережити важкі часи. Без нього я б загнувся давно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451794
    m_Localized: 'Buddy: Ти не сердись, якщо мої жарти тебе дратують, я просто намагаюся не здуріти. Ну, розумієш?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451795
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451796
    m_Localized: 'Buddy: То що, пустиш до себе, дружище?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451797
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451798
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451799
    m_Localized: 'Buddy: Це тому що я чудово поснідав. Роблю все, як мені друг порадив: пиво на сніданок, вино на вечерю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451800
    m_Localized: 'Buddy: Смачно, корисно і навіть дієтично. Он, тільки поглянь на мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451801
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451802
    m_Localized: 'Buddy: Хе-хе-хе, та не переймайся, пожартувати люблю. Не сердись за це. Без гумору зараз ніяк.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451803
    m_Localized: 'Buddy: Та й чому б трохи не випити? Тверезим поглядом дивитись на це все якось… важко.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451804
    m_Localized: 'Buddy: Гаразд, без жартів, пустиш мене, дружище?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451805
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451806
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451807
    m_Localized: 'Buddy: Дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451808
    m_Localized: 'Buddy: А то б я лишився без нікого.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451809
    m_Localized: 'Buddy: Ехх, дружище…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451810
    m_Localized: 'Buddy: Що ж, гаразд, не мозолитиму очі. Я пішов.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451811
    m_Localized: 'Fatman: Вітаннячко… чорт… як мені спекотно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451812
    m_Localized: Зараз же ніч
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451813
    m_Localized: Все добре?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451814
    m_Localized: 'Fatman: І що? Жарко все одно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451815
    m_Localized: 'Fatman: Так, вночі трохи… прохолодніше, але… душно, що пиздець.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451816
    m_Localized: 'Fatman: Дихати нема чим. А в тебе той… ванна є?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451817
    m_Localized: Так, у мене є ванна
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451818
    m_Localized: А навіщо тобі ванна?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451819
    m_Localized: 'Fatman: Та ні… яке там добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451820
    m_Localized: 'Fatman: У мене шкіра… наче горить.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451821
    m_Localized: 'Fatman: Сука, так спекотно… навіть на курорті не було.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451822
    m_Localized: 'Fatman: Мені б у холодненьку ванну. А можна у тебе в душ сходити?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451823
    m_Localized: Так, у мене є ванна
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451824
    m_Localized: А навіщо тобі ванна?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451825
    m_Localized: 'Fatman: Чудово, дружище… я вже думав, розтану, як морозиво.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451826
    m_Localized: 'Fatman: Бляха, морозива захотілося… навіщо я про це подумав…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451827
    m_Localized: 'Fatman: Одним словом, будь ласка, пусти, мені треба охолонути у ванні.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451828
    m_Localized: 'Fatman: Інакше я тут зомлію та… вдень підсмажуся до єбені матері.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451829
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451830
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451831
    m_Localized: 'Fatman: Мені погано, треба… зануритись у холодну воду.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451832
    m_Localized: 'Fatman: Дружище, будь ласка… пусти мене, мені прям реально зле.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451833
    m_Localized: 'Fatman: Я й сюди ледве-ледве дістався.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451834
    m_Localized: 'Fatman: Не кидай поважного члена суспільства. Я раніше міністром був.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451835
    m_Localized: 'Fatman: Якщо впустиш, то коли все це скінчиться… у тебе буде багато грошей. Дуже багато.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451836
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451837
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451838
    m_Localized: 'Fatman: Ти не пошкодуєш… дружище.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451839
    m_Localized: 'Fatman: Я тобі заплачу, коли все це скінчиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451840
    m_Localized: 'Fatman: Дружище, мені ж… погано.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451841
    m_Localized: 'Fatman: Куди я піду? Мені пизда.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451842
    m_Localized: 'Blind: Нарешті хоч якийсь будинок знайшов.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451843
    m_Localized: Що у тебе з очима?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451844
    m_Localized: Це хто тебе так?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451845
    m_Localized: 'Blind: Я бачив дещо жахливе. Те, що не смію описати. Хто наважиться сказати, які жахи породжує розум на межі божевілля?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451846
    m_Localized: 'Blind: Ця картина, вона… вона застигла перед зором.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451847
    m_Localized: 'Blind: Не описати словами той нескінченно давній страх, що стряс мою душу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451848
    m_Localized: 'Blind: Повір мені, якби ти зустрів ЦЕ, то зробив би так само.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451849
    m_Localized: Що ти бачив?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451850
    m_Localized: Ти про бліду людину?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451851
    m_Localized: 'Blind: Це… це я сам собі зробив.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451852
    m_Localized: 'Blind: Щоб не збожеволіти, мені довелося принести в жертву очі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451853
    m_Localized: 'Blind: Думав, що вирізавши їх, я позбудуся жахливої ​​картини перед очима. Тепер я бачу нескінченну темряву.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451854
    m_Localized: Що ти бачив?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451855
    m_Localized: Ти про бліду людину?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451856
    m_Localized: 'Blind: Тобі краще не знати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451857
    m_Localized: 'Blind: Для НЬОГО наше горе — це бенкет наяву! Шведський стіл! ВОНО зжирає страхи, страждання та розум живих.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451858
    m_Localized: 'Blind: Я просто забрів не туди… і невчасно…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451859
    m_Localized: 'Blind: ВОНО… ВОНО не зважало на мене, жадібно пожираючи горілу плоть…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451860
    m_Localized: 'Blind: Повільно перетравлювало огидні чорні тіла, схожі на вугілля, У МЕНЕ ПЕРЕД ОЧИМА!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451861
    m_Localized: 'Blind: Боже, навіть лютому ворогові не побажаю цього побачити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451862
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451863
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451864
    m_Localized: 'Blind: Ти правда думаєш, що я вирізав собі очі через якусь бліду людину?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451865
    m_Localized: 'Blind: Ооо ні-і-і… Є дещо страшніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451866
    m_Localized: 'Blind: Воно більше, небезпечніше. Його… Його не описати. Воно приходить на запах смаженого та пожинає те, що ми сіємо.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451867
    m_Localized: 'Blind: Ця твар взагалі не повинна існувати…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451868
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451869
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451870
    m_Localized: 'Blind: Спасибі, нарешті зможу ненадовго перевести дух.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451871
    m_Localized: 'Blind: Чорт, як важко без очей…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451872
    m_Localized: 'Blind: Та я піду, але…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451873
    m_Localized: 'Blind: Заради всього святого, не наближайся до спалених тіл уночі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451874
    m_Localized: 'Blind: Інакше ВОНО прийде за тобою.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451875
    m_Localized: 'Dude: Йоу, що там, як там?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451876
    m_Localized: 'Dude: Ти бачив, що за фігня навколо відбувається?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451877
    m_Localized: 'Dude: Розтлумач мені по-братньому, що я пропустив.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451878
    m_Localized: Сонце розгоряється та спалює людей днем
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451879
    m_Localized: З-під землі почали вилазити істоти, схожі на людей
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451880
    m_Localized: 'Dude: Драний йосип!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451881
    m_Localized: 'Dude: Бляха, я це в кіно бачив.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451882
    m_Localized: 'Dude: А ми той, вже відправиили крутих астронавтів на сонце?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451883
    m_Localized: 'Dude: Ну типу, ракетами, щоб вони там його погасили, не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451884
    m_Localized: 'Dude: А, і команду треба з чотирьох людей. Це щасливе число, вони тоді точно виживуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451885
    m_Localized: Що за маячню ти несеш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451886
    m_Localized: Ти взагалі стежиш за останніми подіями?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451887
    m_Localized: 'Dude: ЗОМБІ! АГА, Я ЗНАВ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451888
    m_Localized: 'Dude: Братан, можеш покластися на мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451889
    m_Localized: 'Dude: Я той, купу фільмів переглянув на цю тему. Вважай, що я гуру з виживання.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451890
    m_Localized: 'Dude: Ти тільки скажи мені, які це зомбі?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451891
    m_Localized: 'Dude: Вони бігають чи шкандибають? Це вірус чи ожилі мерці?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451892
    m_Localized: 'Dude: Від цього залежить вся наша тактика, я тобі реально кажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451893
    m_Localized: 'Dude: До речі, у тебе є рушниця чи там гранати? Нам зброя знадобиться для виживання.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451894
    m_Localized: 'Dude: Ооо, і ще хавчик. Та-а-ак, хачвику нам треба багато.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451895
    m_Localized: Що за маячню ти несеш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451896
    m_Localized: Ти взагалі стежиш за останніми подіями?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451897
    m_Localized: 'Dude: Та ні, це… не маячня, чувак. Я знаю, про що говорю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451898
    m_Localized: 'Dude: Ось ти чув, що фантасти той, часто здогадуються, що буде в майбутньому?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451899
    m_Localized: 'Dude: Всякі там наукові винаходи, події та інше…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451900
    m_Localized: 'Dude: Бляха, прикинь, ми б вийшли у космос та почали б листи до інопланетян відправляти…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451901
    m_Localized: 'Dude: Ха-ха, ось це був би прикол. Мені друг розповів, що у якійсь книжці таке було.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451902
    m_Localized: 'Dude: Добре, я тиснути не буду. Але прошу по-братньому, чувак, пусти мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451903
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451904
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451905
    m_Localized: 'Dude: Та ні-і-і, там нічого хорошого.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451906
    m_Localized: 'Dude: Одні мудаки говорять про інших, про всяке лайно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451907
    m_Localized: 'Dude: І після новин — одна туга.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451908
    m_Localized: 'Dude: А ось у кіно…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451909
    m_Localized: 'Dude: Там все є. Драми, зради, інтриги. Переживаєш!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451910
    m_Localized: 'Dude: І взагалі, кіно цікавіше за книжки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451911
    m_Localized: 'Dude: Та-а-ак, завжди мріяв у фільм якийсь потрапити…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451912
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451913
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451914
    m_Localized: 'Dude: Йоу, клас, від душі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451915
    m_Localized: 'Dude: Бляха, це найкраще, що сталося в моєму житті.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451916
    m_Localized: 'Dude: Треба, щоб з нашої історії якийсь фільм зняли.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451917
    m_Localized: 'Dude: Бляяяха…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451918
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451919
    m_Localized: 'Dude: Ну гаразд, чувак, не парся, я все розумію. Все пучком.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451920
    m_Localized: 'Dude: Бережи себе та своїх близьких.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451921
    m_Localized: 'Teacher: Вибачте, що я вас турбую, мені дуже погано…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451922
    m_Localized: 'Teacher: Можна вам вилити душу?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451923
    m_Localized: Що трапилось?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451924
    m_Localized: Хто ви?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451925
    m_Localized: 'Teacher: Я… Я лише хотіла подарувати покинутим дітям хоч трохи надії.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451926
    m_Localized: 'Teacher: Брала всіх дітей, яких вважали Гостями, обзивали «прокаженими»…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451927
    m_Localized: 'Teacher: Ми ховалися у будівлі колишнього дитячого садка.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451928
    m_Localized: 'Teacher: Вони потребували любові та співчуття. Я дбала про них…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451929
    m_Localized: 'Teacher: Але… через пожежу… я не змогла їх врятувати…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451930
    m_Localized: Що трапилось з дітьми?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451931
    m_Localized: Чому сталася пожежа?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451932
    m_Localized: 'Teacher: Вихователька з дитячого садка.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451933
    m_Localized: 'Teacher: Я… брала покинутих дітей під свою опіку. Ми жили там, де раніше був дитячий садок.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451934
    m_Localized: 'Teacher: Вони залишилися без батьків з різних причин.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451935
    m_Localized: 'Teacher: Когось забрали КНС, когось вбили, а хтось…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451936
    m_Localized: 'Teacher: Хтось відмовлявся від власної дитини, коли виявляв у неї ознаку Гостя.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451937
    m_Localized: 'Teacher: Але тепер… Усіх дітей вбили… Ніхто не вцілів після пожежі…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451938
    m_Localized: Що трапилось з дітьми?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451939
    m_Localized: Чому сталася пожежа?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451940
    m_Localized: 'Teacher: Вони…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451941
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451942
    m_Localized: 'Teacher: Вони всі загинули… У вогні…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451943
    m_Localized: 'Teacher: Це зробили місцеві. Вони боялися, що діти можуть бути Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451944
    m_Localized: 'Teacher: Мене змусили… дивитися на те, як вони замкнули двері, забили вікна і підпалили дитячий садок…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451945
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451946
    m_Localized: 'Teacher: Я досі бачу ці маленькі налякані дитячі оченята…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451947
    m_Localized: Проходьте
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451948
    m_Localized: Вам краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451949
    m_Localized: 'Teacher: Це все… місцеві жителі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451950
    m_Localized: 'Teacher: Хтось дізнався, що я беру під опіку дітей з ознаками Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451951
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451952
    m_Localized: 'Teacher: На що перетворилися люди? Вирішили влаштувати самосуд над нещасними малятами?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451953
    m_Localized: 'Teacher: За що з ними так, вони ж ні в чому не винні…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451954
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451955
    m_Localized: 'Teacher: Люди підпалили дитячий садок і змусили мене дивитися…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451956
    m_Localized: Проходьте
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451957
    m_Localized: Вам краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451958
    m_Localized: 'Teacher: Дякую, що вислухали і впустили мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451959
    m_Localized: 'Teacher: Шкода, що діточок не повернути.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451960
    m_Localized: 'Teacher: Я не виню вас. Але пообіцяйте…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451961
    m_Localized: 'Teacher: Пообіцяйте, що як зустрінете самотніх дітей, то подбаєте про них. Прощавайте.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451962
    m_Localized: 'Ballerina: Привіт.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451963
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451964
    m_Localized: 'Ballerina: У тебе відкрито?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451965
    m_Localized: Ти знаєш… лисого мужика?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451966
    m_Localized: Що тобі треба?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451967
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451968
    m_Localized: 'Ballerina: Багато питаєш. Так, знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451969
    m_Localized: 'Ballerina: Як допоможе тобі?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451970
    m_Localized: Хто ти?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451971
    m_Localized: Як ти знайшла мій дім?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451972
    m_Localized: 'Ballerina: Ящик пива. Тумбочку. Окіст. Не знаю. Дай що хочеш.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451973
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451974
    m_Localized: 'Ballerina: То відчиниш, ні?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451975
    m_Localized: 'Ballerina: Сказали сюди йти, я йду.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451976
    m_Localized: Хто ти?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451977
    m_Localized: Як ти знайшла мій дім?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451978
    m_Localized: 'Ballerina: Танцюю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451979
    m_Localized: 'Ballerina: Балетом займалась. Видно?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451980
    m_Localized: Тебе хтось послав сюди?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451981
    m_Localized: Ти мені нагадуєш одну… людину
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451982
    m_Localized: 'Ballerina: Місто бачиш? Жила там.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451983
    m_Localized: 'Ballerina: Побачила твій дім, прийшла.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451984
    m_Localized: 'Ballerina: Тут не жарко.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451985
    m_Localized: Тебе хтось послав сюди?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451986
    m_Localized: Ти мені нагадуєш одну… людину
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451987
    m_Localized: 'Ballerina: Не знаю. Яка різниця?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451988
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451989
    m_Localized: 'Ballerina: Хе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451990
    m_Localized: Я не вірю, що ти людина
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451991
    m_Localized: Доведи, що ти людина
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451992
    m_Localized: 'Ballerina: Ну… добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451993
    m_Localized: 'Ballerina: Що далі? Розкажеш про неї? Чи що?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451994
    m_Localized: 'Ballerina: Дивна фраза.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451995
    m_Localized: Я не вірю, що ти людина
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646080
    m_Localized: Доведи, що ти людина
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646081
    m_Localized: 'Ballerina: То й що?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646082
    m_Localized: 'Ballerina: Станцювати тобі?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646083
    m_Localized: 'Ballerina: Може, станцюю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646084
    m_Localized: 'Ballerina: Я балетка.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646085
    m_Localized: 'Ballerina: Давай, вирішуй. Що робимо?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646086
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646087
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646088
    m_Localized: 'Ballerina: Дві руки, дві ноги, одна голова.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646089
    m_Localized: 'Ballerina: Тобі мало?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646090
    m_Localized: 'Ballerina: Пройшла твій тест?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646091
    m_Localized: 'Ballerina: Відчиниш? Ні?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646092
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646093
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646094
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646095
    m_Localized: 'Ballerina: Бідна жінка змерзла на вулиці… Бррр.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646096
    m_Localized: 'Ballerina: І не муч кицю. Вона холод не любить.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646097
    m_Localized: 'Ballerina: Бачиш кицю?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646098
    m_Localized: 'Ballerina: Подумай ще.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646099
    m_Localized: …Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646100
    m_Localized: Іди вже до біса
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646101
    m_Localized: 'Ballerina: Буду як вдома.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646102
    m_Localized: 'Ballerina: Ходімо, кицю, будеш мене розважати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646103
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646104
    m_Localized: 'Ballerina: Знайдеш кицю під домом.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646105
    m_Localized: 'Ballerina: Мій тобі подаруночок.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646106
    m_Localized: 'Couple: …Ось, вже краще.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646107
    m_Localized: 'Couple: Ой, здоров''ячка! Ми з дружиною шукаємо безпечне містечко.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646108
    m_Localized: 'Couple: Ви не будете проти, якщо ми у вас посидимо? Якщо це вас, звісно, не обтяжить.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646109
    m_Localized: Мій будинок схожий на безпечне місце?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646110
    m_Localized: А якщо обтяжить?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646111
    m_Localized: 'Couple: Чесно кажучи, ваш дім здається безпечнішим за інші.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646112
    m_Localized: 'Couple: Не знаю, не можу це пояснити, хах.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646113
    m_Localized: 'Couple: Великий будинок на околиці, сусіди на відстані. Менше шансів, що прийде якась потвора.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646114
    m_Localized: Твоя дружина може говорити за себе?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646115
    m_Localized: Від чого ви так стомилися?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646116
    m_Localized: 'Couple: Що ж… певно, буде важко. Але що вдієш, пошукаємо інше місце.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646117
    m_Localized: 'Couple: Моя дружина дуже втомилась, їй би відпочити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646118
    m_Localized: 'Couple: Якщо, звичайно, це вам не завадить.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646119
    m_Localized: Твоя дружина може говорити за себе?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646120
    m_Localized: Від чого ви так стомилися?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646121
    m_Localized: 'Couple: Авжеж! Зайчику, скажи щось.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646122
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646123
    m_Localized: 'Couple: Вона просто знемоглася. Вибачте.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646124
    m_Localized: 'Couple: Але ми можемо поговорити іншим разом. Якщо ще побачимось, звісно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646125
    m_Localized: 'Couple: Так, люба моя?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646126
    m_Localized: 'Couple: Ах, вибач, не мучитиму тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646127
    m_Localized: Проходьте
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646128
    m_Localized: Вам краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646129
    m_Localized: 'Couple: Та від всього, ви ж самі розумієте. Гості, сонце смажить, з роботи звільнили.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646130
    m_Localized: 'Couple: Все одразу… Важко стало.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646131
    m_Localized: 'Couple: Дякую моїй дружині, без неї я б цього жаху не пережив. А ви як справляєтесь?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646132
    m_Localized: 'Couple: О, це не моя справа, вибачте.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646133
    m_Localized: Проходьте
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646134
    m_Localized: Вам краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646135
    m_Localized: 'Couple: Ох, дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646136
    m_Localized: 'Couple: Що ти завмерла, заходь, нас же впустили.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646137
    m_Localized: 'Couple: Така соромлива. Нічого, зараз відпочинемо.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646138
    m_Localized: 'Couple: Зрозумів, вибачте, що потурбували.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646139
    m_Localized: 'Couple: Пошукаємо інше місце. Так, сонечко?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646140
    m_Localized: 'Couple: Ну, ворушися вже, я теж втомився.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646141
    m_Localized: 'BigLebowski: Привіт. Чи… вітаю, якщо так краще.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646142
    m_Localized: 'BigLebowski: Це твій, тобто ваш дім?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646143
    m_Localized: Ти когось конкретно шукаєш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646144
    m_Localized: Так, мій дім
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646145
    m_Localized: 'BigLebowski: Та ні, мені б просто віддихнути.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646146
    m_Localized: 'BigLebowski: Вже задовбало никатися по підвалах. Скоро вже забуду, як з людьми спілкуватись.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646149
    m_Localized: Чому ти ховаєшся по підвалах?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646150
    m_Localized: А де твої батьки?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646151
    m_Localized: 'BigLebowski: Мені, ну, незручно, але… можете мене впустити, щоб я у вас перечекала день?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646152
    m_Localized: 'BigLebowski: Я вже з ніг валюсь, а підвалу чи іншого затишного місця досі не знайшла.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646155
    m_Localized: Чому ти ховаєшся по підвалах?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646156
    m_Localized: А де твої батьки?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646157
    m_Localized: 'BigLebowski: Доводиться, життя таке. Я типу мандрую. Світ хочу подивитись. Різні місця побачити. Може, десь знайду собі новий дім.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646158
    m_Localized: 'BigLebowski: А грошей ніфіга нема. От і доводиться або домовлятися про житло, або шукати незайняті підвали.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646159
    m_Localized: 'BigLebowski: Щоправда, часом натрапляю на повних мудаків.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646160
    m_Localized: 'BigLebowski: Якщо ви теж з них, то знайте, що я себе скривдити не дам! Дам такої бубни, що більше не захочете у мій бік дивитись!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646161
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646162
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646163
    m_Localized: 'BigLebowski: Та хрін знає. Вдома, мабуть. Де їм ще бути?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646164
    m_Localized: 'BigLebowski: Чи вже Гостями стали. Їм би це личило. Хаха.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646165
    m_Localized: 'BigLebowski: У мене ще мама дуже любила на сонечку ніжитись. Тож ще один цікавий варіант є.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633024
    m_Localized: 'BigLebowski: Хоча мені пофігу, бо я тут, а не там. І мені не завадив би дах над головою.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633025
    m_Localized: 'BigLebowski: Ви ж не залишите маленьку дівчину саму під пекучим сонцем і з Гостями?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646166
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646167
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646168
    m_Localized: 'BigLebowski: Ніфіга! Прикол…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646169
    m_Localized: 'BigLebowski: О, у вас навіть килим є. Кльовий.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646170
    m_Localized: 'BigLebowski: Хоча… пофігу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646171
    m_Localized: 'BigLebowski: Та й посрати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646172
    m_Localized: 'BigLebowski: Певно, ви теж один з цих мудаків.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646173
    m_Localized: 'BigLebowski: Від вас небезпекою віє.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646174
    m_Localized: 'Luka: Агов, ви вже біля дверей? Я чую кроки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646175
    m_Localized: 'Luka: Чи можна до вас зайти переночувати?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646176
    m_Localized: Ти чого такий радісний?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646177
    m_Localized: Що з обличчям?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646178
    m_Localized: 'Luka: Злості скрізь і так вистачає.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646179
    m_Localized: 'Luka: Часи зараз непрості, та все одно багато за що варто боротися.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646180
    m_Localized: 'Luka: За майбутнє покоління, мистецтво, життя загалом.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646181
    m_Localized: 'Luka: Слід намагатися думати, що все буде гаразд. Тоді стане трохи простіше.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646182
    m_Localized: Чому радіти?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646183
    m_Localized: Ти готовий брехати людям?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646184
    m_Localized: 'Luka: А що з ним? Наче все добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646185
    m_Localized: 'Luka: А, ти, мабуть, про мою посмішку?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646186
    m_Localized: 'Luka: Я теж давно вже не бачив, як хтось посміхається.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646187
    m_Localized: 'Luka: Люди в страху забули, чому можна радіти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646188
    m_Localized: 'Luka: Відчай не дає нам побачити щасливі хвилини, які ще залишились.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646189
    m_Localized: Чому радіти?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646190
    m_Localized: Ти готовий брехати людям?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646191
    m_Localized: 'Luka: Та причин багато. Але я не можу вказати, чому радіти саме тобі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646192
    m_Localized: 'Luka: Що тобі подобалося до всіх цих подій?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646193
    m_Localized: 'Luka: Згадай, що приносило радість.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646194
    m_Localized: 'Luka: Мені здається, зараз дуже важливо не впадати у відчай.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646195
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646196
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646197
    m_Localized: 'Luka: Чому брехати? Усі вони вгрузли у власні проблеми, і це зрозуміло.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646198
    m_Localized: Але якщо нагадати людям, що колись вони були щасливі…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646199
    m_Localized: 'Luka: Колись у них було на меті не вижити, а зробити щось… приємне для всіх.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646200
    m_Localized: 'Luka: Розумієш, про що я? Нині надто гірко жити стало.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646201
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646202
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646203
    m_Localized: 'Luka: Сподіваюся, ти теж згадаєш, що значить бути щасливим.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646204
    m_Localized: 'Luka: Може, думки про смерть залишать тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646205
    m_Localized: 'Luka: Ти краще не закопуйся у своєму горі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646206
    m_Localized: 'Luka: Якщо занадто на ньому зациклюватись, можна збожеволіти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646207
    m_Localized: 'Luka: А там недалеко і до чогось жахливого.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646208
    m_Localized: 'Luka: Бережи себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840384
    m_Localized: 'Gasmask: Доброї ночі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840385
    m_Localized: 'Gasmask: Ми з бригади КНС. Проводимо обстеження вашого району.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840386
    m_Localized: 'Gasmask: Не хвилюйтеся, це недовго.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840387
    m_Localized: Коли повернуть нашого мешканця?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840388
    m_Localized: А минуле обстеження?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840389
    m_Localized: 'Gasmask: Повернуть?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840390
    m_Localized: 'Gasmask: А, у вас, здається, вже були наші представники.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840391
    m_Localized: 'Gasmask: Після перевірок необхідно дотримуватись карантину. Ваша людина побуде у нас ще якийсь час.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840392
    m_Localized: 'Gasmask: Після цього її відправлять назад з карантинної зони.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840393
    m_Localized: Добре. Якщо інакше не можна
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840394
    m_Localized: Мені ці дослідження не цікаві
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840395
    m_Localized: 'Gasmask: Результати надто неоднозначні.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840396
    m_Localized: 'Gasmask: Щоб краще вивчити вплив сонця, нам потрібно взяти ще когось із вашого будинку.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840397
    m_Localized: Добре. Якщо інакше не можна
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840398
    m_Localized: Мені ці дослідження не цікаві
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840399
    m_Localized: 'Gasmask: Не хвилюйтесь, процедури, звичайно, виснажливі, але ми даємо час на відпочинок.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840400
    m_Localized: 'Gasmask: Як тільки дослідження закінчаться, ми скажемо, що робити далі, і допоможемо.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840401
    m_Localized: 'Gasmask: Ви не зрозуміли.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840402
    m_Localized: 'Gasmask: Це не добровільна процедура.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840403
    m_Localized: 'Gasmask: Вам доведеться зробити те, що потрібно. Не будете сперечатись — ми швидше підемо, і все закінчиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840404
    m_Localized: 'Gasmask: Вітаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840405
    m_Localized: 'Gasmask: Нам потрібно взяти у вас ще людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840406
    m_Localized: 'Gasmask: Чим швидше, тим краще.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840407
    m_Localized: Що відбувається у місті?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840408
    m_Localized: Повертайте тих, кого вже забрали
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840409
    m_Localized: 'Gasmask: Наслідки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840410
    m_Localized: 'Gasmask: Будете сперечатись — доведеться зачистити ще більше місць.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840411
    m_Localized: 'Gasmask: Приховування Гостей призводить до їх непередбачуванного розмноження.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840412
    m_Localized: 'Gasmask: А отже, і до зростання насильства.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840413
    m_Localized: Скільки це все ще триватиме?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840414
    m_Localized: Коли ви розберетеся з цими Гостями?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840415
    m_Localized: 'Gasmask: Не ставте нам умов.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840416
    m_Localized: 'Gasmask: Ви не в тому положенні. Кожен намагається нам завадити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840417
    m_Localized: 'Gasmask: І подивіться, до чого це призвело. Довелося знищити цілу колонію Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840418
    m_Localized: 'Gasmask: А там… там був і мій будинок.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840419
    m_Localized: Скільки це все ще триватиме?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840420
    m_Localized: Коли ви розберетеся з цими Гостями?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840421
    m_Localized: 'Gasmask: Ми ще вивчаємо питання. Не лізьте.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840422
    m_Localized: 'Gasmask: Зараз важко сказати. Потрібні нові люди для контролю ситуації.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840423
    m_Localized: 'Gasmask: Якщо будете менше упиратись — може, скоро все і скінчиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840424
    m_Localized: І що ж далі?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840425
    m_Localized: Мені треба знову віддати вам когось?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840426
    m_Localized: 'Gasmask: Якби це було так легко, КНС був би не потрібний.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840427
    m_Localized: 'Gasmask: Просто дайте нам зробити свою справу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840428
    m_Localized: 'Gasmask: Ми тримаємо ситуацію під контролем.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840429
    m_Localized: І що ж далі?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840430
    m_Localized: Мені треба знову віддати вам когось?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840431
    m_Localized: 'Gasmask: Нам потрібно забрати у вас людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840432
    m_Localized: 'Gasmask: Якщо точніше, двох.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840433
    m_Localized: 'Gasmask: Це пришвидшить нашу роботу. Так буде найкраще.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840434
    m_Localized: Добре. Якщо це допоможе…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840435
    m_Localized: Ні. З мене досить
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840436
    m_Localized: 'Gasmask: Так.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840437
    m_Localized: 'Gasmask: Але цього разу нам потрібні двоє.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840438
    m_Localized: 'Gasmask: Не важливо, хто, просто скоріше дайте когось.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840439
    m_Localized: 'Gasmask: Скоро все налагодиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840440
    m_Localized: Добре. Якщо це допоможе…
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840441
    m_Localized: Ні. З мене досить
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840442
    m_Localized: 'Gasmask: Так, це допоможе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840443
    m_Localized: 'Gasmask: Дякую, що почули мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840444
    m_Localized: 'Gasmask: Ми зараз заберемо двох, але скоро повернемо всіх.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840445
    m_Localized: 'Gasmask: І розберемося з Гостями.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840446
    m_Localized: 'Gasmask: Трясця твоїй матері…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840447
    m_Localized: 'Gasmask: Добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840448
    m_Localized: 'Gasmask: Вам подобається видовище позаду мене?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840449
    m_Localized: 'Gasmask: Це тому, що вперті довбограї заважають нам працювати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840450
    m_Localized: 'Gasmask: Якщо ви опиратиметеся, вибухнуть ще будинки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840451
    m_Localized: 'Gasmask: Нам не байдуже це місто.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840452
    m_Localized: 'Gasmask: Просто. Дайте. Людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840453
    m_Localized: 'Gasmask: Скоро їх повернемо. Дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840454
    m_Localized: 'Gasmask: Нам потрібні ще люди.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840455
    m_Localized: 'Gasmask: Інакше буде катастрофа.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840456
    m_Localized: Де. Ті. Кого. Забрали?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840457
    m_Localized: Яка катастрофа?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840458
    m_Localized: 'Gasmask: ТА ДОСІ ВЖЕ, ЗАЇБАЛИ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840459
    m_Localized: 'Gasmask: СВІТ НА ГРАНІ КІНЦЯ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840460
    m_Localized: 'Gasmask: Якщо будете виябуватись, ми просто заберемо всіх у цьому будинку.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840461
    m_Localized: І що треба для порятунку?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840462
    m_Localized: Та нахуй ви потрібні, якщо у вас нічого не виходить?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840463
    m_Localized: 'Gasmask: Це пиздець.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840464
    m_Localized: 'Gasmask: Влада хоче підірвати все місто, бо це неможливо контролювати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840465
    m_Localized: 'Gasmask: Плани ставлять нездійсненні.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840466
    m_Localized: 'Gasmask: Якщо ми зараз не придумаємо, як врятуватись, це придумають за нас.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840467
    m_Localized: І що треба для порятунку?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840468
    m_Localized: Та нахуй ви потрібні, якщо у вас нічого не виходить?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840469
    m_Localized: 'Gasmask: Ще два мешканця.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840470
    m_Localized: 'Gasmask: Ми не забираємо всіх. Потрібні лише двоє.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840471
    m_Localized: 'Gasmask: І тоді ми або знайдемо, як вплинути на Гостей, або більше не побачимося з вами.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840472
    m_Localized: Сподіваюся, більше не побачимось
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840473
    m_Localized: Я не віддам нікого більше
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840474
    m_Localized: 'Gasmask: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840475
    m_Localized: 'Gasmask: Мій терпець вже уривається.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840476
    m_Localized: 'Gasmask: Я не збираюся сперечатись.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840477
    m_Localized: 'Gasmask: Або ми зараз вибиваємо двері і забираємо все ваше погане кубло, або ви добровільно віддаєте двох людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840478
    m_Localized: 'Gasmask: Ви не перший, хто чинить опір. Проходили вже таких.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840479
    m_Localized: 'Gasmask: Пройдемо й по вам.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840480
    m_Localized: Сподіваюся, більше не побачимось
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840481
    m_Localized: Я не віддам нікого більше
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840482
    m_Localized: 'Gasmask: Я також.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840483
    m_Localized: 'Gasmask: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840484
    m_Localized: 'Gasmask: Все, щасливо залишатись.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840485
    m_Localized: 'Gasmask: Як зі стіною розмовляю. Не хочете по-доброму — буде по-іншому.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840486
    m_Localized: 'Gasmask: Ми виб''ємо двері.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840487
    m_Localized: 'Gasmask: Заберемо всіх.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840488
    m_Localized: 'Gasmask: А ви залишитесь тут помирати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840489
    m_Localized: 'Gasmask: Тому ВІДДАВАЙТЕ ДВОХ ЛЮДЕЙ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840490
    m_Localized: 'Gasmask: І ми підемо.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840491
    m_Localized: 'Prophet: Чудово. Кіт у тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840492
    m_Localized: 'Prophet: Як учинити з тим, хто тобі приніс його… вирішуй сам.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840493
    m_Localized: Звідки ти знаєш про кота?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840494
    m_Localized: Навіщо ти просив впустити когось із котом?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840495
    m_Localized: 'Prophet: Я можу бачити далі, ніж будь-хто. Мені дали таку можливість.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840496
    m_Localized: 'Prophet: Звичайно, мені не все відомо, але щодо тебе… я знаю, що станеться, якщо дотримуватися вказівок.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840497
    m_Localized: 'Prophet: Ще я знаю, що незабаром настане трагедія.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840498
    m_Localized: 'Prophet: Ти тут ні до чого, але тебе це торкнеться.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840499
    m_Localized: 'Prophet: Цікаво, чи розкажуть про це по радіо? Послухаєш?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840500
    m_Localized: То що мені з цим робити?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840501
    m_Localized: Що станеться?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840502
    m_Localized: 'Prophet: Це дозволить тобі наблизитися до дуже потужної сутності.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840503
    m_Localized: 'Prophet: Завдяки їй я можу зазирнути далі будь-кого. Та навіть мені не видно всього.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840504
    m_Localized: 'Prophet: Але я бачу точно, що незабаром станеться дещо дуже погане.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840505
    m_Localized: 'Prophet: І ти не зможеш це зупинити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840506
    m_Localized: 'Prophet: Цікаво, чи розкажуть про це по радіо? Послухаєш?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840507
    m_Localized: То що мені з цим робити?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840508
    m_Localized: Що станеться?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840509
    m_Localized: 'Prophet: Нічого. Я сказав зайвого.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840510
    m_Localized: 'Prophet: Але далі тобі варто нікого не перевіряти два дні.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840511
    m_Localized: 'Prophet: Загалом нічого, взагалі ні в кого.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840512
    m_Localized: 'Prophet: Якщо виконаєш ці умови, я зможу підказувати тобі далі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840513
    m_Localized: 'Prophet: Може, це зробить тебе щасливішим. Або хоча б залишиш все у минулому.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840514
    m_Localized: 'Prophet: Сподіваюсь, побачимося за кілька днів.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840515
    m_Localized: 'Prophet: Не можу сказати. Вже і без того прозвучало більше, ніж тобі варто було б знати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840516
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840517
    m_Localized: 'Prophet: Можеш сприймати мої слова як прохання, але…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840518
    m_Localized: 'Prophet: Буде добре, якщо ти не перевірятимеш нікого. Два дні поспіль.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840519
    m_Localized: 'Prophet: Коли я вперше прийшов сюди, то відчув дещо… дивне.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840520
    m_Localized: 'Prophet: Зараз це відчуття слабкіше. Мабуть, ми робимо правильно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840521
    m_Localized: 'Prophet: Сподіваюсь, побачимося за кілька днів.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840522
    m_Localized: 'Prophet: Ти ж тут? Біля дверей?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840523
    m_Localized: 'Prophet: Я почуваюся гірше. Так дивно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840524
    m_Localized: 'Prophet: Це через руйнування?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840525
    m_Localized: Тобі потрібна… якась допомога?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840526
    m_Localized: Ти сам з собою говориш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840527
    m_Localized: 'Prophet: Мені вже допомагають. Просто…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840528
    m_Localized: 'Prophet: Я почуваюся слабшим. Бачу вже не так далеко, як минулої нашої зустрічі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840529
    m_Localized: 'Prophet: Ти... навряд чи справа в тобі. І навряд чи в ній…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840530
    m_Localized: 'Prophet: Так вже було на самому початку. Все буде гаразд.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840531
    m_Localized: 'Prophet: Стебла нові з попелу проб''ються до небес.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840532
    m_Localized: Я взагалі тебе не розумію
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840533
    m_Localized: Я вже шкодую, що довірився тобі
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840534
    m_Localized: 'Prophet: Ні. Ні, точно ні.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840535
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840536
    m_Localized: 'Prophet: Знаєш, є сутність, яка набагато сильніша за нас.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840537
    m_Localized: 'Prophet: Але не треба її боятися. Ми просто нічого не знаємо.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840538
    m_Localized: 'Prophet: Вона може допомогти, якщо правильно звернутися.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840539
    m_Localized: 'Prophet: Але зараз… щось трапилося. Може, той чоловік з грибами…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840540
    m_Localized: Я взагалі тебе не розумію
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840541
    m_Localized: Я вже шкодую, що довірився тобі
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840542
    m_Localized: 'Prophet: Так, вибач, якщо налякав. Думки вголос.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840543
    m_Localized: 'Prophet: Поки я не прийшов до тебе, мені було ясно, що робити. Нині це знання як в тумані.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840544
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840545
    m_Localized: 'Prophet: Підвал. У тебе є підвал.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840546
    m_Localized: 'Prophet: Спробуй прокопати землю. Там щось було…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840547
    m_Localized: 'Prophet: Ніяк не можу побачити, що має бути за цією землею.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840548
    m_Localized: Навіщо воно мені?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840549
    m_Localized: Ти впевнений у своїх словах?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840550
    m_Localized: 'Prophet: Ні, вибач, розумію, як дивно це звучить для тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840551
    m_Localized: 'Prophet: Але я точно бачив, знав, пам''ятав, що робити і для чого.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840552
    m_Localized: 'Prophet: Зараз це все… наче затягло туманом. Я бачу, що ти опинився в темному лісі. І довкола звірі…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840553
    m_Localized: 'Prophet: Я згадав, що має бути далі. У тебе є підвал.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840554
    m_Localized: 'Prophet: Потрібно викопати щось під землею.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840555
    m_Localized: 'Prophet: Ти маєш там щось знайти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840556
    m_Localized: Навіщо воно мені?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840557
    m_Localized: Ти впевнений у своїх словах?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840558
    m_Localized: 'Prophet: Вибач. У мене немає ясності в думках.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840559
    m_Localized: 'Prophet: Хоча… згадав ще дещо.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840560
    m_Localized: 'Prophet: Коли знайдеш — не стрибай. Рано.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840561
    m_Localized: 'Prophet: Я, мабуть, піду відпочину.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840562
    m_Localized: 'Prophet: Я… я пам''ятаю, що це було правильно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840563
    m_Localized: 'Prophet: Так треба було зробити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840564
    m_Localized: 'Prophet: І тобі…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840565
    m_Localized: 'Prophet: Коли знайдеш там, під землею — не стрибай. Зараз це тобі не допоможе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840566
    m_Localized: 'Prophet: Я хочу побути наодинці зі своїми думками.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840567
    m_Localized: 'Prophet: Я забув твоє обличчя.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840568
    m_Localized: 'Prophet: Мій зір ослаб. Я тепер навіть фізично бачу дуже погано.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840569
    m_Localized: 'Prophet: Вона покинула мене?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840570
    m_Localized: Ти на ґанку не вмирай тільки
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840571
    m_Localized: Виглядаєш… погано
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840572
    m_Localized: 'Prophet: Думаю, ти давно запізнився з цим побажанням.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840573
    m_Localized: 'Prophet: Думок поменшало.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034688
    m_Localized: 'Prophet: Я зрозумів. Що давно вже час.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034689
    m_Localized: 'Prophet: Досить зі мною грати. Залиш мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034690
    m_Localized: Ти про кого?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034691
    m_Localized: Ти вмираєш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034692
    m_Localized: 'Prophet: Вона мене підтримувала.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034693
    m_Localized: 'Prophet: А тепер що? Просто забере все назад?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034694
    m_Localized: 'Prophet: Навіщо тоді ти затіяла це?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034695
    m_Localized: Ти про кого?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034696
    m_Localized: Ти вмираєш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034697
    m_Localized: 'Prophet: Я… вже навіть не пам''ятаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034698
    m_Localized: 'Prophet: Тільки одна думка в голові: «Стрибай».'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034699
    m_Localized: 'Prophet: Не розумію, це мені? Чи це повідомлення для тебе?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034700
    m_Localized: 'Prophet: Я сам вже заплутався.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034701
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034702
    m_Localized: 'Prophet: А погадай мені ще раз, будь ласка. По книзі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034703
    m_Localized: 'Prophet: Може, ти мені підкажеш.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034704
    m_Localized: Відкрий ближче до кінця
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034705
    m_Localized: Нехай буде середина 200-ї сторінки
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034706
    m_Localized: Десята сторінка?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034707
    m_Localized: 'Prophet: Дивне питання. Я сам більше не розумію, що відбувається.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034708
    m_Localized: 'Prophet: Раніше розумів. Точно це пам''ятаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034709
    m_Localized: 'Prophet: І ще пам''ятаю слово «стрибай». Це щось означає?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034710
    m_Localized: 'Prophet: Це слово для тебе?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034711
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034712
    m_Localized: 'Prophet: Пам''ятаєш, ти гадав мені по книзі? Хочеш знову це зробити?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034713
    m_Localized: 'Prophet: Щось мені страшно. Може, це допоможе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034714
    m_Localized: Відкрий ближче до кінця
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034715
    m_Localized: Нехай буде середина 200-ї сторінки
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034716
    m_Localized: Десята сторінка?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034717
    m_Localized: 'Prophet: «Наш потяг давно вже нікуди не йде, це просто під ним мчить і гуркоче дорога».'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034718
    m_Localized: 'Prophet: А, ось воно як.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034719
    m_Localized: 'Prophet: Я згадав трохи. Дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034720
    m_Localized: 'Prophet: Піду. Прощавай.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034721
    m_Localized: 'Prophet: «Хтось співає між двох світів, Вогонь, йди зі мною».'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034722
    m_Localized: 'Prophet: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034723
    m_Localized: 'Prophet: Дуже шкода.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034724
    m_Localized: 'Prophet: Дякую, звісно. Але краще не стало.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034725
    m_Localized: 'Prophet: Прощавай.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034726
    m_Localized: 'Prophet: «Наша молодість кричала, як вогнище Руан».'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034727
    m_Localized: 'Prophet: Щось немає сил читати далі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034728
    m_Localized: 'Prophet: Вибач. Я, мабуть, піду.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034729
    m_Localized: 'Prophet: Прощавай.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034730
    m_Localized: 'Hunter: Агов! Що тут у тебе навколо робиться?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034731
    m_Localized: 'Hunter: Я не тутешній, не дуже люблю стояти на одному місці.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034732
    m_Localized: 'Hunter: Хоча тепер довго не походиш — роки не ті.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034733
    m_Localized: Чому ти подорожуєш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034734
    m_Localized: Що ти тут шукаєш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034735
    m_Localized: 'Hunter: Та цей… Ти бачив, що Гості витворяють?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034736
    m_Localized: 'Hunter: Що не будинок, то когось вбили, когось роздерли.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034737
    m_Localized: 'Hunter: Видають себе за своїх, а потім, бляха, влаштовують людям пекло.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034738
    m_Localized: 'Hunter: Треба їх винищувати, Гостей цих.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034739
    m_Localized: Ти хочеш вбивати Гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034740
    m_Localized: І де твоя зброя проти Гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034741
    m_Localized: 'Hunter: Де, у місті? Та просто відпочити хочу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034742
    m_Localized: 'Hunter: Як ця проклята спека почалась, Гості стали активніше виповзати, кудись залазити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034743
    m_Localized: 'Hunter: Ось що скажу: гасити їх треба. Вони щось проти нас затівають.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034744
    m_Localized: Ти хочеш вбивати Гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034745
    m_Localized: І де твоя зброя проти Гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034746
    m_Localized: 'Hunter: А ти хіба не цим займаєшся?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034747
    m_Localized: 'Hunter: Чи ти просто кажеш їм «дзуськи»? Ти ж не дурень, правда?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034748
    m_Localized: 'Hunter: Ти їх виженеш, а вони завтра тебе пошматують і не згадають, як звали, розумієш?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034749
    m_Localized: 'Hunter: Обережніше з ними треба, ось що.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034750
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034751
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034752
    m_Localized: 'Hunter: Та була у мене рушниця. Мене самого мало не вбили.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034753
    m_Localized: 'Hunter: Вони підстерегли мене у наметі та просто її вкрали, коли я спав!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034754
    m_Localized: 'Hunter: Я втік, а вони стріляли. Ось такі у них розваги.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034755
    m_Localized: 'Hunter: Нічого людського й нема, крім оболонки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034756
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034757
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034758
    m_Localized: 'Hunter: Я знав, що ти не тюхтій. Нормальний мужик.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034759
    m_Localized: 'Hunter: Знищимо цих Гостей, вони до нас на кілометр не підійдуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034760
    m_Localized: 'Hunter: І добре. Можливо, ти й сам теж Гість.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034761
    m_Localized: 'Hunter: Ще вночі мене прирізав би.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034762
    m_Localized: 'Hunter: Знаєш, а я цим Гостям влаштую веселе життя. От побачиш.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034763
    m_Localized: 'Cold: Привіт.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034764
    m_Localized: 'Cold: Одразу скажу, мені жар не страшний. Але я все одно шукаю спокійне місце.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034765
    m_Localized: 'Cold: Чи зможу я знайти спокій у тебе?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034766
    m_Localized: Ти хто?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034767
    m_Localized: І давно ти шукаєш спокійне місце?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034768
    m_Localized: 'Cold: Це більше не має значення. Ти ж питаєш, чи не Гість я?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034769
    m_Localized: 'Cold: Ні, я не Гість. Але у мене буде прохання до тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034770
    m_Localized: 'Cold: Потім. Я поки що не впевнений.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034771
    m_Localized: Тобі не страшна спека?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034772
    m_Localized: Зніми куртку
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034773
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034774
    m_Localized: 'Cold: Для мене спокою ніколи не було.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034775
    m_Localized: 'Cold: Тому… так, давно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034776
    m_Localized: Тобі не страшна спека?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034777
    m_Localized: Зніми куртку
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034778
    m_Localized: 'Cold: Мені завжди холодно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034779
    m_Localized: 'Cold: Поки одні згоряють на сонці, я закутуюсь у куртки, і мені все одно холодно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034780
    m_Localized: 'Cold: Мені страшно зняти одяг.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034781
    m_Localized: 'Cold: Що, як стане ще гірше? Не зможу померти, тільки буду більше страждати?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034782
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034783
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034784
    m_Localized: 'Cold: Ні.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034785
    m_Localized: 'Cold: Ти можеш мене не впускати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034786
    m_Localized: 'Cold: Я просто піду далі. Не благатиму. І набридати не буду.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034787
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034788
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034789
    m_Localized: 'Cold: Дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034790
    m_Localized: 'Cold: Низькувато у тебе трохи. Але мені підійде.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034791
    m_Localized: 'Cold: Розумію.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034792
    m_Localized: 'Cold: Добре, я піду.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034793
    m_Localized: 'Cold: Я бачу, в тебе руки всі в пороху.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034794
    m_Localized: 'Cold: Ти можеш мене застрелити?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034795
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034796
    m_Localized: 'Cold: Авжеж, кулі тобі самому потрібні. Бувай.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228992
    m_Localized: 'Greatmother: Вітаннячко!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228993
    m_Localized: 'Greatmother: Вдома є хтось?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228994
    m_Localized: А ти хто?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228995
    m_Localized: Когось шукаєш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228996
    m_Localized: 'Greatmother: Я зі своїми жила у парі кварталів звідси.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228997
    m_Localized: 'Greatmother: Нас жовті комбези евакуювали з будинку, але так нікуди й не відвезли.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228998
    m_Localized: 'Greatmother: Ані житла, ані допомоги. Куди ж іти? Що робити?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228999
    m_Localized: 'Greatmother: Ось хто куди, а я тут намагаюсь врятуватися.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229000
    m_Localized: Чому вас вигнали?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229001
    m_Localized: Чи багато вас пішло?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229002
    m_Localized: 'Greatmother: Та нікого не шукаю. Мені тільки треба десь врятуватися.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229003
    m_Localized: 'Greatmother: Повиганяли цілий район, а куди, ніхто не знає.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229004
    m_Localized: 'Greatmother: Бігаю тепер у шоці, шукаю, де жити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229005
    m_Localized: Чому вас вигнали?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229006
    m_Localized: Чи багато вас пішло?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229007
    m_Localized: 'Greatmother: Сказали, що наш будинок потрапив під великий сонячний удар чи щось таке.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229008
    m_Localized: 'Greatmother: Жовті комбези нас повиганяли. Когось схопили, повезли на дослідження.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229009
    m_Localized: 'Greatmother: Когось відпустили.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229010
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229011
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229012
    m_Localized: 'Greatmother: Та весь будинок, я ж кажу!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229013
    m_Localized: 'Greatmother: Хтось не сам поїхав: жовті схопили деяких, наче навмання, і відвезли на дослідження.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229014
    m_Localized: 'Greatmother: Мені здалося, десь половину схопили. За рештою не сильно гналися.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229015
    m_Localized: 'Greatmother: Тепер от якось треба виживати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229016
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229017
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229018
    m_Localized: 'Greatmother: Ага, дякую. Ти цим жовтим не відкривай, добре?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229019
    m_Localized: 'Greatmother: Бо вони ще нас з тобою заберуть кудись.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229020
    m_Localized: 'Greatmother: Ну ти все одно не відкривай жовтим.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229021
    m_Localized: 'Greatmother: Та й взагалі нікому більше не відкривай.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229022
    m_Localized: 'Greatmother: ХАХАХАХАХАХ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229023
    m_Localized: 'Greatmother: Я сюди приведу своїх, допоможемо тобі врятуватися, ахахахах.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229024
    m_Localized: 'SuperFake: А ти все вдома сидиш.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229025
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229026
    m_Localized: 'SuperFake: Як тобі цей, у костюмі?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229027
    m_Localized: Робить свою справу
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229028
    m_Localized: Не знаю, як до нього ставитися
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229029
    m_Localized: 'SuperFake: Часи зараз непрості.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229030
    m_Localized: 'SuperFake: То одне, то інше, так?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229031
    m_Localized: 'SuperFake: Може, хоч ці наведуть лад?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229032
    m_Localized: 'SuperFake: Чи краще ми самі візьмемо все в свої руки?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229033
    m_Localized: Я не можу нічого зробити
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229034
    m_Localized: Я роблю, що можу
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229035
    m_Localized: 'SuperFake: Нема чого й думати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229036
    m_Localized: 'SuperFake: Усе вирішили за нас.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229037
    m_Localized: 'SuperFake: Благодать, не інакше.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229038
    m_Localized: 'SuperFake: Чи хочеться самому все виправити?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229039
    m_Localized: Я не можу нічого зробити
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229040
    m_Localized: Я роблю, що можу
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229041
    m_Localized: 'SuperFake: Це мені якраз відомо!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229042
    m_Localized: 'SuperFake: А що ти зробиш проти стихійних лих?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229043
    m_Localized: 'SuperFake: Проти Біди з космосу?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229044
    m_Localized: 'SuperFake: Проти смерті?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229045
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229046
    m_Localized: 'SuperFake: Слууууухай.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229047
    m_Localized: 'SuperFake: Ти сам вдома?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229048
    m_Localized: Так, сам
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229049
    m_Localized: Ні, не сам
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229050
    m_Localized: 'SuperFake: А що ти можеш?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229051
    m_Localized: 'SuperFake: Зупиниш смерть?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423296
    m_Localized: 'SuperFake: Зупиниш потопи, пожежі, старіння?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423297
    m_Localized: 'SuperFake: Ти можеш лише зупинити серце.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423298
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423299
    m_Localized: 'SuperFake: Слууууухай.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423300
    m_Localized: 'SuperFake: Ти сам вдома?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423301
    m_Localized: Так, сам
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423302
    m_Localized: Ні, не сам
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423303
    m_Localized: 'SuperFake: Ти все ж таки один.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423304
    m_Localized: 'SuperFake: Не вдалося ні з ким ужитися?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423305
    m_Localized: 'SuperFake: Я зараз загляну швиденько, передам гостинці.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423306
    m_Localized: 'SuperFake: Все намагаєшся налагодити життя.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423307
    m_Localized: 'SuperFake: Навіщо?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423308
    m_Localized: 'SuperFake: Світом правлять собаки. І залишаться тільки собаки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423309
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423310
    m_Localized: 'SuperFake: Ти ж розумієш, що як раніше вже не буде.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423311
    m_Localized: 'SuperFake: Життя змінилося.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423312
    m_Localized: 'SuperFake: І ти не встигаєш за новим ритмом.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423313
    m_Localized: 'SuperFake: Наступна наша зустріч буде цікавішою.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423314
    m_Localized: 'SuperFake: Відчуваєш?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423315
    m_Localized: 'SuperFake: Зміни тебе переслідують.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423316
    m_Localized: 'SuperFake: Я також.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423317
    m_Localized: 'SuperFake: А от є одна людина, їй вмирати не пасує.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423318
    m_Localized: 'SuperFake: Вона має тільки слово, та яке, якби ви знали!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423319
    m_Localized: 'SuperFake: Розумієш, про кого я?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423320
    m_Localized: 'SuperFake: Цікаве навколо тебе твориться.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423321
    m_Localized: Я цього не відчуваю
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423322
    m_Localized: Мені все одно
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423323
    m_Localized: 'SuperFake: Тяжко тобі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423324
    m_Localized: 'SuperFake: Здається, потрібно допомогти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423325
    m_Localized: 'SuperFake: Давай спробуємо з тобою нові правила.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423326
    m_Localized: 'SuperFake: Якщо в тебе вдома є хоча б двоє з НАШИХ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423327
    m_Localized: 'SuperFake: Ти відчиниш мені двері.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423328
    m_Localized: 'SuperFake: Бо тепер у тілах оселились собаки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423329
    m_Localized: Я не розумію
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423330
    m_Localized: Можеш прийти пізніше?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423331
    m_Localized: 'SuperFake: Якийсь ти байдужий.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423332
    m_Localized: 'SuperFake: Ніби тобі начхати на самого себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423333
    m_Localized: 'SuperFake: Давай-но це змінимо.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423334
    m_Localized: 'SuperFake: Якщо в тебе вдома є хоча б двоє з НАШИХ…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423335
    m_Localized: 'SuperFake: Ти відчиниш мені двері.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423336
    m_Localized: Я не розумію
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423337
    m_Localized: Можеш прийти пізніше?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423338
    m_Localized: 'SuperFake: Все просто.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423339
    m_Localized: 'SuperFake: Зараз спробуємо.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423340
    m_Localized: 'SuperFake: Але для початку…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423341
    m_Localized: 'SuperFake: Ти сам вдома?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423342
    m_Localized: Так, сам
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423343
    m_Localized: Ні, не сам
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423344
    m_Localized: 'SuperFake: Звісно! Зараз піду.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423345
    m_Localized: 'SuperFake: Але спершу ми перевіримо наше нове правило.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423346
    m_Localized: 'SuperFake: Ти сам вдома?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423347
    m_Localized: Так, сам
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423348
    m_Localized: Ні, не сам
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423349
    m_Localized: 'SuperFake: Хмм…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423350
    m_Localized: 'SuperFake: Ну от і зіграло наше нове правило.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423351
    m_Localized: 'SuperFake: Ходімо зі мною.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423352
    m_Localized: 'SuperFake: Оце так-так.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423353
    m_Localized: 'SuperFake: Навіть нас не так багато. Що говорити про вас, замкнених у своїх будинках.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423354
    m_Localized: 'SuperFake: Зміни — ще не найжахливіше, що на тебе чекає.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423355
    m_Localized: 'SuperFake: Ти ж не вважаєш мене тут… головним?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423356
    m_Localized: 'SuperFake: Є сили, що вищі за мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423357
    m_Localized: 'SuperFake: Я лише виконую їхню волю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423358
    m_Localized: 'SuperFake: Ну…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423359
    m_Localized: 'SuperFake: До зустрічі?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423360
    m_Localized: 'SuperFake: Мені сказали, це остання зустріч із тобою.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423361
    m_Localized: 'SuperFake: Вся ця історія добігає кінця.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423362
    m_Localized: 'SuperFake: Якщо не ми, ви самі далі впораєтеся.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423363
    m_Localized: Ти про що?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423364
    m_Localized: Якого кінця?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423365
    m_Localized: 'SuperFake: Ділюсь з тобою тим, що мені сказали.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423366
    m_Localized: 'SuperFake: От і все.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423367
    m_Localized: 'SuperFake: А ти відчуваєш, як Смерть підходить дедалі ближче?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423368
    m_Localized: 'SuperFake: Вона вже вам на п''ятки наступає.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423369
    m_Localized: Навіщо ти приходиш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423370
    m_Localized: Чому ти не вибиваєш двері?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423371
    m_Localized: 'SuperFake: Цього не скажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423372
    m_Localized: 'SuperFake: Смішно, що ти сам нічого не відчуваєш.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423373
    m_Localized: 'SuperFake: Не хвилюйся, ми допоможемо.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423374
    m_Localized: Навіщо ти приходиш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423375
    m_Localized: Чому ти не вибиваєш двері?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423376
    m_Localized: 'SuperFake: Ти це питаєш тільки зараз?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423377
    m_Localized: 'SuperFake: А ти не думав, що тебе обрали? Ха-ха.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423378
    m_Localized: 'SuperFake: Мене посилають тільки до тебе, щоб…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423379
    m_Localized: 'SuperFake: Щось змінити?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423380
    m_Localized: 'SuperFake: Але результат один.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423381
    m_Localized: 'SuperFake: Ти помреш.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423382
    m_Localized: 'SuperFake: Не сьогодні, так завтра. Не завтра, так потім.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423383
    m_Localized: 'SuperFake: Але ти точно зникнеш.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423384
    m_Localized: 'SuperFake: А поки що…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423385
    m_Localized: 'SuperFake: Чи ти впустив когось з моїх?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423386
    m_Localized: 'SuperFake: Ти сам вдома?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423387
    m_Localized: У мене багато людей
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423388
    m_Localized: Я нікого не впускав
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423389
    m_Localized: У мене багато нелюдів
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423390
    m_Localized: Я впускав тільки кого треба
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423391
    m_Localized: Я позбавився всіх зайвих
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423392
    m_Localized: Я позбавився кількох зайвих
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423393
    m_Localized: 'SuperFake: Лякає невідомість?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423394
    m_Localized: 'SuperFake: Часто запитуєш себе, чому ти ще живий?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423395
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423396
    m_Localized: 'SuperFake: Схоже, тебе більше цікавить, що буде після.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423397
    m_Localized: 'SuperFake: Ось помреш ти. А потім?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423398
    m_Localized: 'SuperFake: Просто зникнеш? Назавжди?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423399
    m_Localized: 'SuperFake: Щось відчуватимеш?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423400
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423401
    m_Localized: 'SuperFake: А мені інше цікаво.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423402
    m_Localized: 'SuperFake: У тебе в будинку зараз є хтось з моїх?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423403
    m_Localized: У мене багато людей
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423404
    m_Localized: Я нікого не впускав
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423405
    m_Localized: У мене багато нелюдів
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423406
    m_Localized: Я впускав тільки кого треба
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423407
    m_Localized: Я позбавився всіх зайвих
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423408
    m_Localized: Я позбавився кількох зайвих
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423409
    m_Localized: 'SuperFake: Отже, ти готовий.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423410
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423411
    m_Localized: 'SuperFake: Чи відчуваєш ти страх?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423412
    m_Localized: 'SuperFake: Таааак.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423413
    m_Localized: 'SuperFake: Не готовий взяти справу в свої руки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423414
    m_Localized: 'SuperFake: І тому я тут.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423415
    m_Localized: 'SuperFake: Все бігаєш. Від нашого брата, від проблем.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423416
    m_Localized: 'SuperFake: Навіщо?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423417
    m_Localized: 'SuperFake: За що ти чіпляєшся?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423418
    m_Localized: 'SuperFake: ЗНАЮ, що скоро все визначиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423419
    m_Localized: 'SuperFake: Навіщо ж чинити опір?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423420
    m_Localized: 'Wolfhound: Здоров''ячка.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423421
    m_Localized: 'Wolfhound: Капець, що скрізь діється. Бачив?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423422
    m_Localized: 'Wolfhound: Яке це суспільство? Повилазило звір''я навколо.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423423
    m_Localized: 'Wolfhound: Нарешті ніхто не прикидається.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423424
    m_Localized: Ти про що?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423425
    m_Localized: Ти теж з цього звір'я?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423426
    m_Localized: 'Wolfhound: Ти не був у інших вдома? Чи на вулиці?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423427
    m_Localized: 'Wolfhound: Ці ваші норми, мораль та інша хрінь більше не працюють.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423428
    m_Localized: 'Wolfhound: Хто сильніший, той і правий. Зможеш перегризти інших — вважай, переміг та можеш порядкувати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423429
    m_Localized: Скільки будинків ти обійшов?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423430
    m_Localized: Як ти сам виживав увесь цей час?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423431
    m_Localized: 'Wolfhound: Так ми всі — те саме звір''я.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423432
    m_Localized: 'Wolfhound: Не захочеш це визнати — тебе живцем зжеруть. Кісток не залишать.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423433
    m_Localized: 'Wolfhound: Тепер новий порядок — хто сильніший, той і правий.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423434
    m_Localized: 'Wolfhound: Хто каже, що він не такий, той не доживе до завтра.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423435
    m_Localized: Скільки будинків ти обійшов?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423436
    m_Localized: Як ти сам виживав увесь цей час?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423437
    m_Localized: 'Wolfhound: Я ніде не був довго.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423438
    m_Localized: 'Wolfhound: Але скрізь бачу хаос. Страх засліплює людей, ховає від них правду.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423439
    m_Localized: 'Wolfhound: У тебе тут ще порядок. Це цікаво, я б подивився, як ти його підтримуєш.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423440
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423441
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423442
    m_Localized: 'Wolfhound: Багато будеш знати — скоро постарієш.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423443
    m_Localized: 'Wolfhound: Я не питаю, як ти живеш, тож ти не питай, як живу я.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423444
    m_Localized: 'Wolfhound: Головне, що зі мною проблем не буде.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423445
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423446
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423447
    m_Localized: 'Wolfhound: Оце розумно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423448
    m_Localized: 'Wolfhound: Сила тепер керує життям, і ти або приймаєш це, або отримуєш проблеми.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423449
    m_Localized: 'Wolfhound: А-а-а-а. Ось воно як.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423450
    m_Localized: 'Wolfhound: Ну чекай від мене звістки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423451
    m_Localized: 'Doctor: О, я вже думав, нікого немає вдома.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423452
    m_Localized: 'Doctor: Так тихо тут вночі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423453
    m_Localized: 'Doctor: Доброго вечора! Можна до вас?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423454
    m_Localized: Ви стежили за будинком?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617600
    m_Localized: Ви щось шукаєте?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617601
    m_Localized: 'Doctor: Що? Ахахах, ні, що ви!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617602
    m_Localized: 'Doctor: Рідко коли у повному людей будинку немає вночі жодних звуків.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617603
    m_Localized: 'Doctor: Хтось напивається та волає у нестямі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617604
    m_Localized: 'Doctor: Хтось кричить від болю та опіків.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617605
    m_Localized: 'Doctor: Хтось — від нестерпної туги.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617606
    m_Localized: Хто ви?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617607
    m_Localized: Звідки ви прийшли?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617608
    m_Localized: 'Doctor: Чому вам так здалося?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617609
    m_Localized: 'Doctor: Тобто насправді шукаю, але те саме, що й усі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617610
    m_Localized: 'Doctor: Безпеку та якусь компанію, щоб вбити нудьгу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617611
    m_Localized: 'Doctor: А у вас тут така тиша, я навіть не думав, що хтось ночує тут, якщо чесно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617612
    m_Localized: 'Doctor: Думаю, зайду перевірити, а тут зачинено. Вирішив постукати, перш ніж ламати двері.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617613
    m_Localized: Хто ви?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617614
    m_Localized: Звідки ви прийшли?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617616
    m_Localized: 'Doctor: Я хірург, оперував людей у ​​лікарнях.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617617
    m_Localized: 'Doctor: У нашій лікарні бракувало грошей, тому часто доводилося мати справу з пацієнтами поза моїм профілем.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617618
    m_Localized: 'Doctor: А зараз… лікарень більше немає… Тепер я просто ходжу та допомагаю, кому можу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617619
    m_Localized: Проходьте
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617620
    m_Localized: Вам краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668864
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668865
    m_Localized: 'Doctor: Якщо впустите, я розповім, що сталося з лікарнями.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617621
    m_Localized: 'Doctor: У центрі міста була лікарня. Але…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617622
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617623
    m_Localized: 'Doctor: Це довга історія.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617624
    m_Localized: 'Doctor: Якщо впустите, я розповім, що сталося з лікарнями.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617625
    m_Localized: Проходьте
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617626
    m_Localized: Вам краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617627
    m_Localized: 'Doctor: Дякую. Сподіваюсь, я зможу комусь допомогти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617628
    m_Localized: 'Doctor: Розумію, зараз не найкращий час для довіри.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617629
    m_Localized: 'Doctor: Якщо пощастить, я буду поряд, тож звертайтеся.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617630
    m_Localized: 'Foreigner: Мммф.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617631
    m_Localized: 'Foreigner: Ммммммффф?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617632
    m_Localized: Що з тобою?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617633
    m_Localized: Що-що?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617634
    m_Localized: 'Foreigner: (Він дивиться на вас, піднявши брови.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617635
    m_Localized: 'Foreigner: (Здається, він не може відповісти.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617636
    m_Localized: Тобі рота зашили?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617637
    m_Localized: І що з тобою робити?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617638
    m_Localized: 'Foreigner: (Його брови скидаються у відчаї.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617639
    m_Localized: 'Foreigner: (Він знову щось мимрить, але ви не можете нічого розібрати.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617640
    m_Localized: Тобі рота зашили?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617641
    m_Localized: І що з тобою робити?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617642
    m_Localized: 'Foreigner: (Він щось мимрить, розмахуючи руками.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617643
    m_Localized: 'Foreigner: (Ви не впевнені, але, здається, у нього на щоках сльози.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617644
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617645
    m_Localized: Іди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617646
    m_Localized: 'Foreigner: (Він мовчки стоїть і дивиться у вічко.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617647
    m_Localized: 'Foreigner: (Ви не впевнені, але, здається, у нього на щоках сльози.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617648
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617649
    m_Localized: Іди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617650
    m_Localized: 'Foreigner: (Він киває вам і заходить у двері.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617651
    m_Localized: 'Foreigner: (Він продовжує стояти і щось мимрити.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617652
    m_Localized: 'Foreigner: Геть, я сказав!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617653
    m_Localized: 'Foreigner: (Він смикається від вашого крику.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617654
    m_Localized: 'Foreigner: (Згодом він розвертається та відходить.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617655
    m_Localized: 'Edgar: Привіт. Гарно у тебе тут.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617656
    m_Localized: 'Edgar: Навіть тихіше, ніж у місті. Там такий шум, метушня.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617657
    m_Localized: 'Edgar: Сподіваюсь, можна буде залишитись у тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617658
    m_Localized: Чого вдома не сидиться?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617659
    m_Localized: Що тут гарного?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617660
    m_Localized: 'Edgar: Мені дуже погано. Справа, нажаль, не лише у гангрені.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617661
    m_Localized: 'Edgar: Кожного дня думаю, чи настане завтра.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617662
    m_Localized: 'Edgar: Таке буття треба пити одним змахом.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617663
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617664
    m_Localized: 'Edgar: Мене вганяє в піт від суєти, яка зараз у місті.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617665
    m_Localized: 'Edgar: Там… усі у відчаї шукають порятунок. А тут ти вже приготувався до того, чого не минути.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617666
    m_Localized: 'Edgar: Мені б хотілося померти тут. Повільно, неквапливо. Насолодитися моментом.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617667
    m_Localized: Звідки у тебе гангрена?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617668
    m_Localized: Давай відріжемо руку?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617669
    m_Localized: 'Edgar: Тиша… Порожнеча. Тут так спокійно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617670
    m_Localized: 'Edgar: Мене тіпає та морозить, навіть у цю спеку в місті.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617671
    m_Localized: 'Edgar: Вулиці тепер не встигають охолонути навіть уночі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617672
    m_Localized: 'Edgar: Хоча мене б все одно морозило, гангрена все ж таки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617673
    m_Localized: 'Edgar: Кожного дня думаю, чи настане завтра.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617674
    m_Localized: 'Edgar: Таке буття треба пити одним змахом.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617675
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617676
    m_Localized: 'Edgar: Мені не подобається паніка у місті. Там усе… наче проти течії.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617677
    m_Localized: Звідки у тебе гангрена?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617678
    m_Localized: Давай відріжемо руку?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617679
    m_Localized: 'Edgar: Це гарне питання. Поки що… скажу тобі так.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617680
    m_Localized: 'Edgar: Я жив разом з дівчиною, яку обожнював.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617681
    m_Localized: 'Edgar: Вона змінювалася… щодня, але це було чудово.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617682
    m_Localized: 'Edgar: Потім прийшли Гості, і тут вже, мабуть, ти розумієш, що далі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617683
    m_Localized: 'Edgar: Тепер я тут. Перед тобою. Один.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617684
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617685
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617686
    m_Localized: 'Edgar: Ти думаєш, це допоможе проти суворого зараження крові?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617687
    m_Localized: 'Edgar: Я так не хочу. Мені чомусь здається, що тут всі готові зустріти неминуче.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617688
    m_Localized: 'Edgar: Тож і мене сюди потягнуло.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617689
    m_Localized: 'Edgar: Я хочу спокійно стати частиною найпрекраснішого світу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617690
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617691
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617692
    m_Localized: 'Edgar: А в тебе справді тихіше, ніж будь-де.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617693
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617694
    m_Localized: 'Edgar: Не знаю, наскільки ти поділяєш мої погляди на красу, але ж ти не викидаєш тіла?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617695
    m_Localized: 'Edgar: Збережи моє, коли настане час.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617696
    m_Localized: 'Edgar: Ти не проти, якщо я залишусь тут, неподалік?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617697
    m_Localized: 'Edgar: Чекатиму, поки смерть не прибере мене до м''яких обійм.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617698
    m_Localized: 'Edgar: Від сонця я вже якось сховаюсь. Але ти не викидай моє тіло, як настане час.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617699
    m_Localized: 'TaxiDriver: Привіт, дядьку.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617700
    m_Localized: 'TaxiDriver: Слухай, я по вуха в лайні, можна в тебе сховатися?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617701
    m_Localized: Що сталося?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617702
    m_Localized: З чим тобі допомогти?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617703
    m_Localized: 'TaxiDriver: З чого ж почати? Я так-то таксист.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617704
    m_Localized: 'TaxiDriver: Віз, значить, пасажира, але потім…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617705
    m_Localized: 'TaxiDriver: Клієнт виявився не тим, за кого себе видавав.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617706
    m_Localized: 'TaxiDriver: Тепер немає більше ні його, ні моєї тачки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617707
    m_Localized: Що трапилося з твоєю машиною?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617708
    m_Localized: Що з твоїм пасажиром?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617709
    m_Localized: 'TaxiDriver: У мене, наче, тачка була, але її більше немає.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617710
    m_Localized: 'TaxiDriver: У мене її віджали через мою ж дурість.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617711
    m_Localized: 'TaxiDriver: Тобто я не прям дурень, просто довірився не тій людині.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617712
    m_Localized: Що трапилося з твоєю машиною?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617713
    m_Localized: Що з твоїм пасажиром?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617714
    m_Localized: 'TaxiDriver: Мою тачку віджали срані КНС-ники.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617715
    m_Localized: 'TaxiDriver: Я так-то віз пасажира, але раптом помітив, що у нього зуби надто білі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617716
    m_Localized: 'TaxiDriver: Я потай поїхав до КНС, а потім, як опинився у них, вибіг з машини і зачинив Гостя.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617717
    m_Localized: 'TaxiDriver: Спочатку КНС мене похвалили, що я, наче, їм допоміг, але потім…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617718
    m_Localized: 'TaxiDriver: Вони відвели мене подалі від машини, і тут я пошкодував. Зрозумів, що ці виродки хочуть і мене загребти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617719
    m_Localized: 'TaxiDriver: Ну, я огрів одного з них пляшкою, що в куртці була, і втік.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617720
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617721
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617722
    m_Localized: 'TaxiDriver: Та як тобі сказати… Я так-то не параноїк, але…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617723
    m_Localized: 'TaxiDriver: Він виявився Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617724
    m_Localized: 'TaxiDriver: Я просто глянув одним оком у дзеркало заднього виду і побачив у нього білі зуби, як із реклами.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617725
    m_Localized: 'TaxiDriver: Навіть не вагався, повіз його одразу до КНС. Як виявилось, помилився.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617726
    m_Localized: 'TaxiDriver: Вони захотіли мене загребти разом з цим типом.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617727
    m_Localized: 'TaxiDriver: Ось я і втік від них. Але додому повернутись страшно. Напевно, вже чекають там, хитрі виродки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617728
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617729
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617730
    m_Localized: 'TaxiDriver: Фух, спасибі, дядьку.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617731
    m_Localized: 'TaxiDriver: Запам''ятай, цим гандонам у жовтому не можна довіряти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617732
    m_Localized: 'TaxiDriver: Озирнутись не встигнеш, як тебе загребуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617733
    m_Localized: 'TaxiDriver: Та годі, дядьку, ну не треба так!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617734
    m_Localized: 'TaxiDriver: Ну так, я, наче, злякався, але це ж не привід мене не пускати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617735
    m_Localized: 'TaxiDriver: Пиздець…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617736
    m_Localized: 'TaxiDriver: Ти не кращий за тих гандонів з КНС. Щоб ти здох.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617737
    m_Localized: 'Provocateur: Вітаю вас, домовласнику. Ви здаєте тут кімнати?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617738
    m_Localized: Можна і так сказати
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617739
    m_Localized: Я просто пускаю до себе людей
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617740
    m_Localized: 'Provocateur: Якась неоднозначна відповідь…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617741
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617742
    m_Localized: 'Provocateur: Що ж, мабуть, договір тоді оформимо пізніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617743
    m_Localized: 'Provocateur: Хоча… про всяк випадок уточню — скільки ви берете за добу?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617744
    m_Localized: Плати скільки хочеш, мені все одно
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617745
    m_Localized: Мені не потрібні твої гроші
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617746
    m_Localized: 'Provocateur: Як це просто пускаєте? Ви волонтер? Надаєте притулок бомжам?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617747
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617748
    m_Localized: 'Provocateur: Вибачте, я не збираюся займати дорогоцінні квадратні метри житлової площі, не платячи за себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617749
    m_Localized: Плати скільки хочеш, мені все одно
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617750
    m_Localized: Мені не потрібні твої гроші
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617751
    m_Localized: 'Provocateur: Ви мені послугу робите, чи що?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617752
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617753
    m_Localized: 'Provocateur: Дожили, власник відвертає ніс від грошей…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617754
    m_Localized: 'Provocateur: Гаразд, просто складемо потім договір, як належить за законом, і все.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617755
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617756
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617757
    m_Localized: 'Provocateur: Ну, вибачте, я не можу жити у вас, не платячи грошей за оренду.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617758
    m_Localized: 'Provocateur: Це якось неправильно, не по закону…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617759
    m_Localized: 'Provocateur: Або я вам платитиму, або навіть не ступлю до вашого будинку.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617760
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617761
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617762
    m_Localized: 'Provocateur: Дякую вам, власнику.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617763
    m_Localized: 'Provocateur: Потім у деталях все обговоримо з приводу оренди.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617764
    m_Localized: 'Provocateur: Що значить МЕНІ краще піти?! Це погроза?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617765
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617766
    m_Localized: 'Provocateur: Краще слідкуйте за словами! Я можу сприйняти це як загрозу моєму життю! А це вже тягне на 119 статтю Конституції.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617767
    m_Localized: 'Provocateur: І, повірте, це матиме для вас не дуже приємні наслідки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617768
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617769
    m_Localized: 'Provocateur: На все добре…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617770
    m_Localized: 'Marauder: Ох ти ж… Тут що, люди є?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617771
    m_Localized: 'Marauder: Привіт. Я думав, тут вже ніхто не мешкає. Все, я пішов.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617772
    m_Localized: 'Marauder: Хоча…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617773
    m_Localized: 'Marauder: Слухай, а можна у тебе залишитись? Давно вже не був у, так би мовити, колективі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617774
    m_Localized: Чому ти бродиш сам?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617775
    m_Localized: Чому ти вважаєш, що це гарна ідея?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617776
    m_Localized: 'Marauder: А хто зі мною захоче піти? Всі вважають мене босотою, найогиднішою людиною.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617777
    m_Localized: 'Marauder: Наче вони всі набагато кращі. Що такого я зробив?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617778
    m_Localized: 'Marauder: Я бачив, на що здатні інші. Якщо з ними порівняти, то я не такий вже й поганий.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617779
    m_Localized: 'Marauder: Але якщо досі не прибився ні до кого, то тепер виживаю один.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617780
    m_Localized: І як ти виживаєш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617781
    m_Localized: Ти обкрадаєш людей?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617782
    m_Localized: 'Marauder: А чому ні?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617783
    m_Localized: 'Marauder: З тих пір, як Гості повилазили, я не зміг ні до кого прибитись.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617784
    m_Localized: 'Marauder: Спочатку мені здавалося, що так безпечніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617785
    m_Localized: 'Marauder: Та насправді мені вже набридло ходити одному. З глузду можна з''їхати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617786
    m_Localized: 'Marauder: Мені вже таке ввижається…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617787
    m_Localized: І як ти виживаєш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617788
    m_Localized: Ти обкрадаєш людей?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617789
    m_Localized: 'Marauder: Хм. Мабуть, немає сенсу тобі брехати — я залізаю до покинутих будинків.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617790
    m_Localized: 'Marauder: Тягну все, що бачу. Щось потім продаю, щось сам використовую.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617791
    m_Localized: 'Marauder: Хоча був випадок, після якого майже кинув цим займатись. Майже.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617792
    m_Localized: 'Marauder: Але, чесно сказати, до тебе хотів залізти. Думав, нікого нема.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617793
    m_Localized: 'Marauder: Ти вже вибачай. Але якщо ти тут, може, впустиш?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617794
    m_Localized: 'Marauder: Розкажу тобі, що бачив за час своїх поневірянь.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617795
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617796
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617797
    m_Localized: 'Marauder: Ти мене зовсім бандитом вважаєш?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617798
    m_Localized: 'Marauder: Я розумію, що не святий, але принципи є. З живих людей речі не знімаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617799
    m_Localized: 'Marauder: Хоча був випадок… ну, потім розповім, там довга історія.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617800
    m_Localized: 'Marauder: До речі, якщо вже живеш тут, чи пустиш переночувати?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617801
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617802
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617803
    m_Localized: 'Marauder: О, хоч відпочину як людина!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617804
    m_Localized: 'Marauder: Ти заходь до мене, розповім історій, що бачив, де був.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617805
    m_Localized: 'Marauder: Зі мною не скучиш.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617806
    m_Localized: 'Marauder: Гаразд, без проблем.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617807
    m_Localized: 'Marauder: Не знаєш, який тут будинок пустує?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617808
    m_Localized: 'Marauder: Я у вашому районі нещодавно, але затримуватись не буду.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617809
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617810
    m_Localized: 'Marauder: Ти що, вже пішов?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617811
    m_Localized: 'Marauder: Ех. Ну, тоді я теж піду.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617812
    m_Localized: 'GraveDigger: Гей, там! Є хтось живий?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617813
    m_Localized: 'GraveDigger: Не пустите до себе?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617814
    m_Localized: Не ломись сюди
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617815
    m_Localized: По довбешці собі постукай
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617816
    m_Localized: 'GraveDigger: Ти не ображайся, якщо розбудив.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617817
    m_Localized: 'GraveDigger: Мені от сон на очі не йде.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617818
    m_Localized: 'GraveDigger: Я ж могильником працюю. Точніше, працював.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617819
    m_Localized: 'GraveDigger: Ніхто більше не хоронить людей, залишають гнити на вулицях і все.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617820
    m_Localized: І що цікавого ти бачив?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617821
    m_Localized: Ти покинув робоче місце?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617822
    m_Localized: 'GraveDigger: Мужиче, вибач, що я тут гупаю в двері.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617823
    m_Localized: 'GraveDigger: Якби ти бачив те саме, що я бачив, поки копав чергову яму…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617824
    m_Localized: 'GraveDigger: Останнім часом люди вмирають пачками, але ніхто їх не ховає.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617825
    m_Localized: 'GraveDigger: Як лежать на вулиці, так їх і залишають. На сонці все одно згорять.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811904
    m_Localized: І що цікавого ти бачив?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811905
    m_Localized: Ти покинув робоче місце?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811906
    m_Localized: 'GraveDigger: Та капець! Попросив мене хтось викопати могилу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811907
    m_Localized: 'GraveDigger: Стоїть він, значить, чекає, поки я закінчу. Ну, я копаю собі та копаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811908
    m_Localized: 'GraveDigger: Вже глибока яма вийшла. І тут розумію, що лопата у щось упирається.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811909
    m_Localized: 'GraveDigger: Я вже подумав, що каміння, а звідти рука як потяглася!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811910
    m_Localized: 'GraveDigger: Це Гість поліз, уявляєш! І той, що поряд стояв, засміявся.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811911
    m_Localized: 'GraveDigger: Я побіг щодуху. Додому страшно йти, краще вже серед людей побути.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811912
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811913
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811914
    m_Localized: 'GraveDigger: Та яке місце. Тьху, а не робота.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811915
    m_Localized: 'GraveDigger: Ніхто тіла не привозить. Усім стало не до смерті, не до ритуалів.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811916
    m_Localized: 'GraveDigger: Спека все одно спалить трупи, а вночі часу обмаль і без того, щоб мертвими займатись.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811917
    m_Localized: 'GraveDigger: Гляділа б нас біда, як ми її глядим.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811918
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811919
    m_Localized: 'GraveDigger: Словом, я більше не працюю. До біса.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811920
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811921
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811922
    m_Localized: 'GraveDigger: Дякую, мужиче!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811923
    m_Localized: 'GraveDigger: Тільки відкривай швидше, бо я боюся, що ці Гості мене наздоженуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811924
    m_Localized: 'GraveDigger: Ехехееее, друже.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811925
    m_Localized: 'GraveDigger: Ось так горбатишся на роботі цілими днями, а заради чого?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811926
    m_Localized: 'GraveDigger: Прийдеш додому, а там нікого.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811927
    m_Localized: 'GraveDigger: Та ще Гості постукають або чекатимуть у будинку.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811928
    m_Localized: 'GraveDigger: Я такі історії чув: хтось виходить з дому, повертається — і все.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811929
    m_Localized: 'GraveDigger: Більше взагалі нікуди не вийду.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811930
    m_Localized: 'FormerFema: Чи є тут хто?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811931
    m_Localized: 'FormerFema: Я чув кроки, тож до дверей ви підійшли.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811932
    m_Localized: 'FormerFema: Можете… відкрити?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811933
    m_Localized: Спершу поверни тих, кого забрали
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811934
    m_Localized: На цей раз за мною прийшли?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811935
    m_Localized: 'FormerFema: Забрали?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811936
    m_Localized: 'FormerFema: А, ви подумали, що я співробітник КНС? Через форму?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811937
    m_Localized: 'FormerFema: Ні, я просто зняв її з трупа.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811938
    m_Localized: 'FormerFema: Раптом так безпечніше? Вони ж для чогось носять ці костюми.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811939
    m_Localized: 'FormerFema: Може, вночі зберігається радіація від сонця? Чи ще щось. Не хочу навіть знати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811940
    m_Localized: Хто ж ти тоді?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811941
    m_Localized: І який у тебе план?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811942
    m_Localized: 'FormerFema: М?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811943
    m_Localized: 'FormerFema: Не зрозумів.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811944
    m_Localized: 'FormerFema: А, ні, я не з КНС. Це ви через форму подумали?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811945
    m_Localized: 'FormerFema: Їх усі ненавидять, як я зрозумів.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811946
    m_Localized: 'FormerFema: За всяке. Людей кудись відвозять. Щось роблять.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811947
    m_Localized: 'FormerFema: Потім не привозять нікого.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811948
    m_Localized: 'FormerFema: Хто знає, що там відбувається.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811949
    m_Localized: Хто ж ти тоді?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811950
    m_Localized: І який у тебе план?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811951
    m_Localized: 'FormerFema: Та простий роботяга з заводу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811952
    m_Localized: 'FormerFema: Ми там збирали холодильники. І ремонтували.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811953
    m_Localized: 'FormerFema: І… тепер я туди не ходжу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811954
    m_Localized: 'FormerFema: Людей не вистачає. А роботи все більше. Ми вже не справляємось.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811955
    m_Localized: 'FormerFema: Я не витримав перевантажень і кинув роботу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811956
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811957
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811958
    m_Localized: 'FormerFema: Це гарне питання. Поки що почуваюся… розгублено.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811959
    m_Localized: 'FormerFema: У мене була робота. Я думав, що все буде добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811960
    m_Localized: 'FormerFema: Потім прийшло розчарування.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811961
    m_Localized: 'FormerFema: Займався взагалі не тим, що мені обіцяли.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811962
    m_Localized: 'FormerFema: Я про програмування, якщо цікаво. Кодив різні штуки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811963
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811964
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811965
    m_Localized: 'FormerFema: Що? А, дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811966
    m_Localized: 'FormerFema: Де я можу присісти?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811967
    m_Localized: 'FormerFema: Чомусь не думав, що ви мене впустите.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811968
    m_Localized: 'FormerFema: Що? А, дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811969
    m_Localized: 'FormerFema: Ой, не те сказав. Розумію.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811970
    m_Localized: 'FormerFema: Напевно, цей костюм відлякує людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811971
    m_Localized: 'FormerFema: Сам не знаю, чого я в нього вчепився.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811972
    m_Localized: 'FormerFema: Бувайте.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811973
    m_Localized: 'Intruder: Тобі щось сниться?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811974
    m_Localized: Що?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811975
    m_Localized: Наче нічого
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811976
    m_Localized: 'Intruder: Ну, сни. Сам знаєш, що таке сни. Ти щось бачиш, коли спиш?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811977
    m_Localized: 'Intruder: Знаєш, що я зрозумів?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811978
    m_Localized: 'Intruder: Люди нині майже не бачать снів.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811979
    m_Localized: 'Intruder: Як гадаєш, чому?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811980
    m_Localized: А тобі що до того?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811981
    m_Localized: А ти сам бачиш сни?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811982
    m_Localized: 'Intruder: Оооот.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811983
    m_Localized: 'Intruder: І у багатьох те ж саме. Хтось не бачить сни навіть у гарячці.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811984
    m_Localized: 'Intruder: Цікаво, це сонце так впливає на людей? Чи ще щось?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811985
    m_Localized: А тобі що до того?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811986
    m_Localized: А ти сам бачиш сни?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811987
    m_Localized: 'Intruder: Сни — дуже тонка незвичайна матерія.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811988
    m_Localized: 'Intruder: Людина там розслабляється, шукає відповіді, втіху… просто заспокоюється.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811989
    m_Localized: 'Intruder: Але зараз люди впадають у безумство, втрачають розум.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811990
    m_Localized: 'Intruder: Мені здається, це тому, що вони більше не знаходять час порефлексувати, відпочити уві сні.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811991
    m_Localized: Проходь… мабуть
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811992
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811993
    m_Localized: 'Intruder: Важко сказати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811994
    m_Localized: 'Intruder: Я вже шостий день взагалі не сплю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811995
    m_Localized: 'Intruder: Якби спав, може, щось і наснилося б.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811996
    m_Localized: Проходь… мабуть
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811997
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811998
    m_Localized: 'Intruder: Дякую. Спробую поспати в тебе, але навряд чи вийде.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811999
    m_Localized: 'Intruder: Якщо іншим у цьому будинку щось присниться — теж добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812000
    m_Localized: 'Intruder: Як гадаєш, чи почнуть люди знову бачити сни?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812001
    m_Localized: 'Intruder: Це було б добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812002
    m_Localized: 'Intruder: Тяжко без снів. Будь-кому буде тяжко.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812003
    m_Localized: 'Courier: Вітаю, це доставка їжі «For Rest».'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812005
    m_Localized: Не знав, що кур'єри все ще працюють
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812011
    m_Localized: 'Courier: Гарного дня… Тобто ночі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812012
    m_Localized: 'Courier: Вибачте, ще не звик.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812013
    m_Localized: 'Courier: Вітаю, це доставка їжі «For Rest».'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812015
    m_Localized: Як ти став кур'єром?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812016
    m_Localized: 'Courier: Пройшов тести, мене за всіма ознаками признали людиною та…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812017
    m_Localized: 'Courier: А, ти про те, чому я працюю кур''єром у цьому безладді?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812018
    m_Localized: 'Courier: Ну а що мені, засісти вдома і тужити, як більшість людей?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812019
    m_Localized: 'Courier: На роботі я хоча б можу забутись і не думати про весь цей пиздець…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812020
    m_Localized: 'Courier: Доброї ночі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812021
    m_Localized: 'Courier: Вітаю… Доставка.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812023
    m_Localized: Якийсь ти похмурий
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812024
    m_Localized: 'Courier: Мого колегу забрали КНС…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812025
    m_Localized: 'Courier: Ранковий огляд, як завжди. І в нього помітили очі. Гребані червоні очі!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812026
    m_Localized: 'Courier: І все… Його забрали. І тепер я не знаю, що сталось. І чи випустять його взагалі звідти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812027
    m_Localized: 'Courier: А якщо й у мене від безсоння очі почервоніють? Мене теж заберуть у ці срані карантинні зони?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812029
    m_Localized: 'Courier: Доброї ночі…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812030
    m_Localized: 'Courier: Доставка…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812033
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812034
    m_Localized: Що в тебе сталося?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812035
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812036
    m_Localized: 'Courier: Мого друга вбили.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812037
    m_Localized: 'Courier: Він приїхав віддавати замовлення, а той домовласник…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812038
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812039
    m_Localized: 'Courier: Люди остаточно їбанулись.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812040
    m_Localized: 'Courier: З чого той уїбан вирішив, що простий кур''єр небезпечний? На який ляд було його вбивати? Навіщо?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812041
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812050
    m_Localized: 'Courier: Тримайте. {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812051
    m_Localized: 'CultistPriest: Таааак. Твій дім підходить.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812052
    m_Localized: 'CultistPriest: Я прямо відчуваю це.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812053
    m_Localized: Що саме ти відчув?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812054
    m_Localized: Мій дім підходить тільки мені
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812055
    m_Localized: 'CultistPriest: Смерть.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812056
    m_Localized: 'CultistPriest: Смерті дуже подобається твій дім.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812057
    m_Localized: 'CultistPriest: Не знаю, скільки людей тут померло, але Її присутність тут міцна.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812058
    m_Localized: А ти хо? Начепив ганчірки якісь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812059
    m_Localized: Ти схожий на якогось сектанта
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812060
    m_Localized: 'CultistPriest: О, це правда.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812061
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812062
    m_Localized: 'CultistPriest: Навколо одна лише смерть.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812063
    m_Localized: 'CultistPriest: Когось спалили, когось витягли з укриття та вбили.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812064
    m_Localized: 'CultistPriest: Ти сподобався Смерті, таааак.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812065
    m_Localized: А ти хо? Начепив ганчірки якісь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812066
    m_Localized: Ти схожий на якогось сектанта
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812067
    m_Localized: 'CultistPriest: Ми несемо нову віру.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812068
    m_Localized: 'CultistPriest: Смерть прийшла до нас. Вона хоче заспокоїти людство, позбавити нас від паніки, жалю та метушні.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812069
    m_Localized: 'CultistPriest: Ми допомагаємо Смерті опинитися поряд з нами.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812070
    m_Localized: 'CultistPriest: Тільки так ми знайдемо спокій. Часи тепер такі, що жити як раніше… вже не вийде.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812071
    m_Localized: І чого ти хочеш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812072
    m_Localized: Ти хочеш зайти чи що?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812073
    m_Localized: 'CultistPriest: Може й так. Я не проти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812074
    m_Localized: 'CultistPriest: Це мій саван. Коли помираєш, з ним не треба шукати, у що тебе загорнути.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812075
    m_Localized: 'CultistPriest: Ми не віримо в жодний порятунок, окрім того, що принесе сама Смерть.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812076
    m_Localized: 'CultistPriest: Вона вже поряд, ми лише допоможемо Їй дарувати всім спокій.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812077
    m_Localized: І чого ти хочеш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812078
    m_Localized: Ти хочеш зайти чи що?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812079
    m_Localized: 'CultistPriest: Ми повинні здійснювати ритуал поховання. По-новому.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812080
    m_Localized: 'CultistPriest: І твій будинок ідеально для цього підходить, таааак.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812081
    m_Localized: 'CultistPriest: Тут відчувається сильний вплив Смерті.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812082
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812083
    m_Localized: 'CultistPriest: Цікаво, що тут в тебе відбувається.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812084
    m_Localized: 'CultistPriest: Отже, я попрошу тебе впустити моїх людей та охороняти їх.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812085
    m_Localized: 'CultistPriest: Поки вони роблять свої справи, вони мусять вижити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812086
    m_Localized: Не горю бажанням про когось дбати
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812087
    m_Localized: Завдання не таке вже й просте
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812088
    m_Localized: 'CultistPriest: Мені не треба заходити. Наша місія — розповсюджувати віру, яка дарує людству спокій.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812089
    m_Localized: 'CultistPriest: Але зайдуть мої люди. Смерть тяжіє до цього місця.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812090
    m_Localized: 'CultistPriest: Вони будуть проводити обряди по покійних, а ти просто їх забезпечуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812091
    m_Localized: Не горю бажанням про когось дбати
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812092
    m_Localized: Завдання не таке вже й просте
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812093
    m_Localized: 'CultistPriest: Горіти тобі, може, все одно доведеться…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812094
    m_Localized: 'CultistPriest: Наглядай за моїми людьми. І пам''ятай: помре один — від твого дома нічого не залишиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812095
    m_Localized: 'CultistPriest: Не можна цього допустити. Це зведе все нанівець.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812096
    m_Localized: 'CultistPriest: І ми просто спалимо вщент твій дім.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812097
    m_Localized: 'CultistPriest: Вибач. Я знаю, що це неприємно, але по-іншому своїх цілей не досягти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812098
    m_Localized: Я тоді вас усіх перестріляю
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812099
    m_Localized: Мені не подобаються погрози. Але я готовий допомогти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812100
    m_Localized: 'CultistPriest: Це так. Шлях до мети завжди непростий.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812101
    m_Localized: 'CultistPriest: Хіба ти сам не прагнеш заспокоєння? Не бажаєш, щоб кожна людина перестала бути тягарем для інших?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812102
    m_Localized: 'CultistPriest: Наглядай за моїми людьми. І пам''ятай: помре один — від твого дома нічого не залишиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812103
    m_Localized: 'CultistPriest: Не можна цього допустити. Це завадить нашій меті.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812104
    m_Localized: 'CultistPriest: Тому я мушу сказати: якщо у нас не вийде, ми спалимо твій дім.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812105
    m_Localized: 'CultistPriest: Ще раз вибач. Не можу інакше.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812106
    m_Localized: Я тоді вас усіх перестріляю
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812107
    m_Localized: Мені не подобаються погрози. Але я готовий допомогти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812108
    m_Localized: 'CultistPriest: Ти вважаєш, що це всі, хто розділяє нашу віру?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812109
    m_Localized: 'CultistPriest: Прийдуть інші. Поки ти спатимеш, твій дім заллють бензином і підпалять.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812110
    m_Localized: 'CultistPriest: Навіть якщо виживеш, залишишся без оселі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812111
    m_Localized: 'CultistPriest: Куди тікатимеш?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812112
    m_Localized: 'CultistPriest: То може, хай вони все ж побудуть у тебе, таааак.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812113
    m_Localized: 'CultistPriest: Швидше за все, це ненадовго.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812114
    m_Localized: 'CultistPriest: Дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812115
    m_Localized: 'CultistPriest: Багато часу їм не знадобиться. Але все одно доглядай моїх людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812116
    m_Localized: 'CultistPriest: Побачимося пізніше, я прийду відвідати їх.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812117
    m_Localized: 'CultistPriest: Не буду гаяти час. Як мої люди?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812118
    m_Localized: Живі-здорові
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812119
    m_Localized: Мені посрати. У мене своїх справ вистачає
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812120
    m_Localized: 'CultistPriest: Дякую, що допомагаєш.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812121
    m_Localized: 'CultistPriest: Певно, ти теж вже втомився від нескінченної метушні, важких часів, непорозуміння.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812122
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812123
    m_Localized: 'CultistPriest: Смерть нещодавно говорила зі мною. Вона сподівається тебе зустріти, коли настане час.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812124
    m_Localized: 'CultistPriest: Вона може допомогти. Сховати від усього. Навіть від самого кінця.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812125
    m_Localized: 'CultistPriest: Я поки що сам не уявляю, як це, але… хіба не принадно?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812126
    m_Localized: 'CultistPriest: Почекай…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812127
    m_Localized: 'CultistPriest: Їх немає?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812128
    m_Localized: 'CultistPriest: Ти… ти забрав у нас єдину можливість…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812129
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812130
    m_Localized: 'CultistPriest: Прощавай.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812131
    m_Localized: 'CultistPriest: Смерть більше не говорить зі мною.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812132
    m_Localized: 'CultistPriest: Ось як скінчиться світ. Не вибух, але схлип…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812133
    m_Localized: 'CultistPriest: У тебе все добре?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812134
    m_Localized: З твоїми людьми все гаразд
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812135
    m_Localized: Звали, не до тебе зараз
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812136
    m_Localized: 'CultistPriest: Таааак. Все як треба. Її погляд усе ще спрямований на нас.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812137
    m_Localized: 'CultistPriest: Тоді не буду затримуватись. Мабуть, піду далі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812138
    m_Localized: Забери свою потолоч
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812139
    m_Localized: Що ще про вашу «Смерть» розкажеш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812140
    m_Localized: 'CultistPriest: Вони залишили цей світ?..'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812141
    m_Localized: 'CultistPriest: Ось чому…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812142
    m_Localized: 'CultistPriest: Знаєш… Якщо Смерть вибрала тебе, то я допоможу Їй побачити тебе ближче.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812143
    m_Localized: 'CultistPriest: Доброї ночі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812144
    m_Localized: Забери свою потолоч
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812145
    m_Localized: Що ще про вашу «Смерть» розкажеш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812146
    m_Localized: 'CultistPriest: Чому?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812147
    m_Localized: Відчепіться від мене
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812148
    m_Localized: У мене тут не дитячий садок
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812149
    m_Localized: 'CultistPriest: Я відчуваю, що ми все ближче до Її приходу, таааак…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812150
    m_Localized: 'CultistPriest: Якщо ми до кінця не розуміємо, що прикликаємо, це не страшно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812151
    m_Localized: 'CultistPriest: Головне — нас поєднує втома від усього.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812152
    m_Localized: 'CultistPriest: Зникати після смерті назовсім — страшно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812153
    m_Localized: 'CultistPriest: Посмертя, яке малюють нам релігії — це марна мрія.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812154
    m_Localized: 'CultistPriest: Переродження звучить як вічні тортури з невеликим перепочинком.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812155
    m_Localized: 'CultistPriest: Але… сама Смерть, можливо, вбереже від найжахливішого — порожнечі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812156
    m_Localized: 'CultistPriest: Нам нічого не залишається, окрім як прикликати Її далі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812157
    m_Localized: Відчепіться від мене
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812158
    m_Localized: У мене тут не дитячий садок
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812159
    m_Localized: 'CultistPriest: Гаразд… ти зробив достатньо.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812160
    m_Localized: 'CultistPriest: Я заберу їх. Так чи інакше, дякую за допомогу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812161
    m_Localized: 'CultistPriest: Хіба вони заважали тобі? Докучали?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812162
    m_Localized: 'CultistPriest: Чи ти насправді не прагнеш спокою?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812163
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812164
    m_Localized: 'CultistPriest: У будь-якому випадку, дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812165
    m_Localized: 'CultistPriest: Ми підемо. Все, що хотіли, ми зробили.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006208
    m_Localized: 'MushroomEater: Здоровенький був, любий друже.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006209
    m_Localized: Ти хто?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006210
    m_Localized: Ти мене знаєш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006211
    m_Localized: 'MushroomEater: Хе-хе, я звичайнісінький старий дід, знаюся на грибочках.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006212
    m_Localized: 'MushroomEater: Але досить про мене, не зараз. Міцелій розповів мені про страшні речі…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006213
    m_Localized: 'MushroomEater: Наближається фестиваль грибів. І часу на підготовку у нас скупенько.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006214
    m_Localized: 'MushroomEater: Так що прошу слухати уважно та запам''ятовувати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006215
    m_Localized: Міцелій?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006216
    m_Localized: Я не розумію
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006217
    m_Localized: 'MushroomEater: Звісно, ​​знаю. Міцелій розповів, хто ти такий.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006218
    m_Localized: 'MushroomEater: Нелегкою була його мова, але я нарешті в ній розібрався.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006219
    m_Localized: 'MushroomEater: Тому слухай мене уважно, бо роботи у нас багато, а часу обмаль.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006220
    m_Localized: Міцелій?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006221
    m_Localized: Я не розумію
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006222
    m_Localized: 'MushroomEater: Так. Але прості люди не мають змоги його зрозуміти. Він говорить особливою мовою.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006223
    m_Localized: 'MushroomEater: Міцелій служить засобом зв''язку та спілкування між грибами.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006224
    m_Localized: 'MushroomEater: Я вивчив його мову за допомогою «Підручника посмішок». І останнє, що я від нього дізнався… дуже насторожує.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006225
    m_Localized: 'MushroomEater: Він почав розмову про фестиваль грибів, що дуже скоро відбудеться. А це, мій любий друже, кепська справа…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006226
    m_Localized: Який ще «Підручник посмішок»?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006227
    m_Localized: Який ще фестиваль грибів?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006228
    m_Localized: 'MushroomEater: Не хвилюйся. Наразі ти мало що зрозумієш, але запам''ятай: нам попри все треба зупинити фестиваль грибів.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006229
    m_Localized: 'MushroomEater: У мене є те, що допоможе нам у цьому спасенному ділі — «Підручник посмішок».'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006230
    m_Localized: Який ще «Підручник посмішок»?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006231
    m_Localized: Який ще фестиваль грибів?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006232
    m_Localized: 'MushroomEater: Це найцінніша книга у світі. Вона підкаже тобі, що робити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006233
    m_Localized: 'MushroomEater: Боюся, тобі важкувато буде прочитати її цілком: вона величезна. На це просто не вистачить часу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006234
    m_Localized: 'MushroomEater: Тому я вирвав лише найважливіші сторінки. Візьми їх.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006235
    m_Localized: Гаразд, я візьму сторінки з «Підручника посмішок»
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006236
    m_Localized: Залиш їх собі
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006237
    m_Localized: 'MushroomEater: О, любий друже…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006238
    m_Localized: 'MushroomEater: Я можу розповісти лише те, що сам вичитав у «Підручнику посмішок» про фестиваль.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006239
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006240
    m_Localized: 'MushroomEater: І здійметься величний гриб, що сіятиме спори по всіх усюдах.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006241
    m_Localized: 'MushroomEater: Не буде краю, де тінь шапки його не закриватиме промені сонця.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006242
    m_Localized: 'MushroomEater: І гриб цей буде не єдиний. Бо фестиваль грибів настав.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006243
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006244
    m_Localized: 'MushroomEater: Нам не можна допустити цього фестивалю. Ти повинен мені допомогти, дорогий юначе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006245
    m_Localized: 'MushroomEater: Я вирвав кілька сторінок із «Підручника посмішок». Прошу, візьми їх. Там ти дізнаєшся, що треба робити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006246
    m_Localized: Гаразд, я візьму сторінки з «Підручника посмішок»
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006247
    m_Localized: Залиш їх собі
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006248
    m_Localized: 'MushroomEater: Добре. Подивись ці сторінки на дозвіллі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006249
    m_Localized: 'MushroomEater: А тепер… мені час іти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006250
    m_Localized: 'MushroomEater: Як тільки зробиш все, що написано на сторінках, чекай на мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006251
    m_Localized: 'MushroomEater: Гарного тобі дня, здоров''я, щастя і більше посмішок, любий друже.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006252
    m_Localized: 'MushroomEater: Навіщо? Це крихітний уривочок з книги, я знаю його напам''ять…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006253
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006254
    m_Localized: 'MushroomEater: Ех… Видно, дарма я тут час витрачаю…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006255
    m_Localized: 'MushroomEater: Привіт, юначе. Молодець, ти зробив усе, що написано на сторінках «Підручника посмішок».'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006256
    m_Localized: 'MushroomEater: Сподіваюся, нам вдалося перешкодити їхньому фестивалю…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006257
    m_Localized: Як ти це відчув?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006258
    m_Localized: Ти щось не дуже впевнений
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006259
    m_Localized: 'MushroomEater: Я дізнався про це від міцелію.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006260
    m_Localized: 'MushroomEater: Це величезне джерело знань. Та зараз він опинився у такій самій небезпеці, як і всі ми.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006261
    m_Localized: 'MushroomEater: Все через те, що гриби ростуть надто швидко.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006262
    m_Localized: Як саме наші дії зупинять фестиваль грибів?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006263
    m_Localized: Ти не можеш сказати грибам не проводити фестиваль?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006264
    m_Localized: 'MushroomEater: О, любий друже… Не все так просто. Поки що невідомо, чи вдалося нам щось змінити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006265
    m_Localized: 'MushroomEater: Залишається тільки чекати і сподіватися, що ми зупинили ріст грибів.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006266
    m_Localized: Як саме наші дії зупинять фестиваль грибів?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006267
    m_Localized: Ти не можеш сказати грибам не проводити фестиваль?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006268
    m_Localized: 'MushroomEater: Ми провели старий ритуал, дорогий друже.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006269
    m_Localized: 'MushroomEater: Ми не можемо говорити безпосередньо з грибами, бо ми не є частиною міцелію.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006270
    m_Localized: 'MushroomEater: Але можна вгамувати ріст грибів за допомогою стародавнього ритуалу, що був описаний у «Підручнику посмішок».'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006271
    m_Localized: 'MushroomEater: І ми з тобою його провели.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006272
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006273
    m_Localized: 'MushroomEater: Я прийду знову, коли настане час.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006274
    m_Localized: 'MushroomEater: Ми переконаємось, що гриби не виростуть, а фестиваль не настане.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006275
    m_Localized: 'MushroomEater: І пам''ятай: гриби — не те, чим здаються.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006276
    m_Localized: 'MushroomEater: Не прощаємося, о любий друже.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006277
    m_Localized: 'MushroomEater: Здорова думка, дорогий юнак. Але я спілкуюсь не з грибами.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006278
    m_Localized: 'MushroomEater: Вони є лише частиною міцелію.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006279
    m_Localized: 'MushroomEater: Міцелій — ось що має розум. Але, на жаль, я можу лише слухати його. Він не відає людської мови.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006280
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006281
    m_Localized: 'MushroomEater: Я прийду знову, коли настане час.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006282
    m_Localized: 'MushroomEater: Ми переконаємось, що гриби не виростуть, а фестиваль не настане.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006283
    m_Localized: 'MushroomEater: І пам''ятай: гриби — не те, чим здаються.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006284
    m_Localized: 'MushroomEater: Не прощаємося, о любий друже.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006285
    m_Localized: 'MushroomEater: Схоже, фестиваль грибів все ж таки настає…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006286
    m_Localized: 'MushroomEater: Усередині міцелію такий безлад, що ритуал… анітрішечки не подіяв…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006287
    m_Localized: Чому ритуал не допоміг?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006288
    m_Localized: Чому відбувається фестиваль грибів?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006289
    m_Localized: 'MushroomEater: Міцелій… Схоже, у ньому щось збочилось…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006290
    m_Localized: 'MushroomEater: Коли у зв''язках його утворюються клубки злості, вони заважають обміну речовин.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006291
    m_Localized: 'MushroomEater: Гриби, немов печінка у людини, виводять цю гидоту, щоб міцелій був здоровим.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006292
    m_Localized: 'MushroomEater: Схоже, останнім часом, злості настільки багато, що гриб розрісся без усякої міри.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006293
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006294
    m_Localized: 'MushroomEater: Я не хотів цього, але… схоже, нам з тобою доведеться вирушити до країни грибів…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006295
    m_Localized: Країни грибів?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006296
    m_Localized: Звучить непогано
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006297
    m_Localized: 'MushroomEater: Фестиваль грибів знаменує їх бурхливий ріст.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006298
    m_Localized: 'MushroomEater: А це означає, що міцелію прийде халепа.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006299
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006300
    m_Localized: 'MushroomEater: Я не хотів цього, але… схоже, нам з тобою доведеться вирушити до країни грибів…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006301
    m_Localized: Країни грибів?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006302
    m_Localized: Звучить непогано
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006303
    m_Localized: 'MushroomEater: Це страшне місце, куди ніколи не ступала нога людини.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006304
    m_Localized: 'MushroomEater: І повір, краще б так і було. Але ми не маємо вибору.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006305
    m_Localized: 'MushroomEater: Нам треба будь-що-будь зупинити цей фестиваль.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006306
    m_Localized: 'MushroomEater: Ти готовий вирушити до країни грибів?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006307
    m_Localized: Так
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006308
    m_Localized: Ні
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006309
    m_Localized: 'MushroomEater: Не обманюйся простою назвою, дорогий друже.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006310
    m_Localized: 'MushroomEater: На людській мові, воно може, й звучить як щось веселе. Але на грибній…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006311
    m_Localized: 'MushroomEater: Це зовсім не райдужне місце.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006312
    m_Localized: 'MushroomEater: Так, там ми не застанемо фестиваль, але решта людей… міцелій…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006313
    m_Localized: 'MushroomEater: Все згине, якщо ми не втрутимось.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006314
    m_Localized: 'MushroomEater: Людині не слід туди ступати. Ніколи. Але нам доведеться зупинити цей фестиваль.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006315
    m_Localized: 'MushroomEater: Ти готовий вирушити до країни грибів?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006316
    m_Localized: Так
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006317
    m_Localized: Ні
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006318
    m_Localized: 'MushroomEater: Молодчина, добрий юначе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006319
    m_Localized: 'MushroomEater: Збирай речі, та…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006320
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006321
    m_Localized: 'MushroomEater: Стривай-но секунду. Можеш показати годинник?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006322
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006323
    m_Localized: 'MushroomEater: ПІВНІЧ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006324
    m_Localized: 'MushroomEater: От лихо, ми запізнюємось. Біжимо!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006325
    m_Localized: 'MushroomEater: Швидше, поки брама до країни грибів відчинена!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006326
    m_Localized: 'MushroomEater: О, любий друже… Це сумно…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006327
    m_Localized: 'MushroomEater: Боюся, один я не впораюся. І мені потрібна твоя допомога.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006328
    m_Localized: 'MushroomEater: Ми з тобою летимо крізь часи, які зігнули країну грибів у баранячий ріг. Усі з нього пили — і ми з тобою сьорбнемо. Мабуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006329
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006330
    m_Localized: 'MushroomEater: Я не знаю, що нас чекає в країні грибів, але що буде небезпечно — це точно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006331
    m_Localized: 'MushroomEater: Тому, о добрий друже, я все ж спитаю ще раз. Чи вирушиш зі мною до країни грибів?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006332
    m_Localized: Так
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006333
    m_Localized: Ні
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006334
    m_Localized: 'MushroomEater: Що ж…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006335
    m_Localized: 'MushroomEater: Тоді ми всі приречені.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006336
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006337
    m_Localized: 'MushroomEater: Гарного тобі дня, здоров''я, щастя і більше посмішок, дорогий друже.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006338
    m_Localized: 'MushroomEater: Прощавай.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006339
    m_Localized: 'Miner: А? Хто тут? Я чув шум якийсь.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006340
    m_Localized: 'Miner: Начебто.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006341
    m_Localized: Що ти робиш у мене під будинком?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006342
    m_Localized: Ти застряг там?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006343
    m_Localized: 'Miner: Що?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006344
    m_Localized: 'Miner: Говори гучніше, я весь у пилюці та сажі. Не чую ні біса.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006345
    m_Localized: 'Miner: Ми у тебе під будинком?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006346
    m_Localized: 'Miner: Ну, сподіваюся, він не звалиться на нас.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006347
    m_Localized: Навіщо ти тут?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006348
    m_Localized: Що ти шукаєш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006349
    m_Localized: 'Miner: А?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006350
    m_Localized: 'Miner: Застряг? Ні. Ми тут знайшли дещо.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006351
    m_Localized: 'Miner: Чорт, через пил у вухах майже тебе не чую. Як крізь вату кажеш, чесслово.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006352
    m_Localized: Навіщо ти тут?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006353
    m_Localized: Що ти шукаєш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006354
    m_Localized: 'Miner: Ми з мужиками хотіли прорити тунелі, щоб ховатись тут від спеки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006355
    m_Localized: 'Miner: Тільки-но почали копати — знайшли цілий підземний лабіринт!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006356
    m_Localized: 'Miner: Взагалі він був більшим, але частину нещодавно засипало.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006357
    m_Localized: 'Miner: Ці тунелі дуже довгі, дядьку. Я навіть не знаю, куди вони ведуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006358
    m_Localized: 'Miner: Але це не головне, бо ми тут ще дещо знайшли.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006359
    m_Localized: Що там цікавого?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006360
    m_Localized: Спіймали Гостя?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006361
    m_Localized: 'Miner: Порятунок від спеки, їдрі твою мать.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006362
    m_Localized: 'Miner: Коли ми надумали копати, дуже швидко натрапили на СИСТЕМУ ТУНЕЛІВ!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006363
    m_Localized: 'Miner: Хто їх копав, для чого ми не знаємо. Але, звісно, є здогади.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006364
    m_Localized: 'Miner: Ми думаємо, що це якраз Гості повзуть по цих тунелях.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006365
    m_Localized: 'Miner: Поки не бачили жодного, то нічого не скажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006366
    m_Localized: 'Miner: Але тунелі — то ще дрібниці, тут є дещо цікавіше.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006367
    m_Localized: Що там цікавого?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006368
    m_Localized: Спіймали Гостя?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006369
    m_Localized: 'Miner: Ну, діра якась.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006370
    m_Localized: 'Miner: Але поруч із нею щось відбувається. Там усередині завжди щось тихо гуде.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006371
    m_Localized: 'Miner: Тварини затихають. Компас не працює. Світло від ліхтаря крізь темряву до краю не дістає.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006372
    m_Localized: 'Miner: Ось один наш спустився, а я чергую, щоб витягати, раптом що.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006373
    m_Localized: 'Miner: Ти це, якщо хочеш дійти до мене, то цю дірку не розкопуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006374
    m_Localized: 'Miner: Ми починали, то тут мало все не посипалося нам на голови.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006375
    m_Localized: 'Miner: Що?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006376
    m_Localized: 'Miner: А, та ні, в цьому нічого цікавого немає.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006377
    m_Localized: 'Miner: Ми знайшли прірву, поряд з якою щось відбувається.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006378
    m_Localized: 'Miner: Один із наших десь прочитав чи чув, що… ну, там щось цікаве.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006379
    m_Localized: 'Miner: Ти це, якщо хочеш дійти до мене, то цю дірку не розкопуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006380
    m_Localized: 'Miner: Ми починали, то тут мало все не посипалося нам на голови.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006381
    m_Localized: 'Miner: Розкажу більше, як дійдеш до нас.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006382
    m_Localized: 'Miner: А? Це ти знову? Ти став тихіше говорити, чи це я оглухнув від цього гулу? Ну? Що скажеш?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006383
    m_Localized: Ти давно сидиш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006384
    m_Localized: Друзі твої не повернулись?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006385
    m_Localized: 'Miner: Що? Не чую, голосніше кажи! Сиджу, так. Другу добу, а може, й третю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006386
    m_Localized: 'Miner: Слухай, час тут якось дивно йде. Тут ні сонця, ні годинника немає. Так що хрін знає, скільки вже ми тут.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006387
    m_Localized: 'Miner: Ти хоч поїж там, нагорі, а то ще сам скоро, як я, з ліхтарем засядеш. А жерти тут нема чого.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006388
    m_Localized: Ти сам хоч заглядав у діру?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006389
    m_Localized: А що як з твоїм другом щось трапилося в дірі?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006390
    m_Localized: 'Miner: А? Друзі? Та ще ні. Один туди спустився, далеко, але він… він точно повернеться, не хвилюйся. Він завжди повертається, він вихід навіть за запахом знайде.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006391
    m_Localized: 'Miner: А другий — на тому кінці мотузки. Смикне, коли буде готовий. Або коли допомога знадобиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006392
    m_Localized: 'Miner: Ти ж бачиш, мотузка натягнута. Значить, він там, усе гаразд. Слухай, ти їх, напевно, зустрінеш раніше за мене. Ну… якщо вийдеш назовні, може, хтось із них з''явиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006393
    m_Localized: Ти сам хоч заглядав у діру?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006394
    m_Localized: А що як з твоїм другом щось трапилося в дірі?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006395
    m_Localized: 'Miner: Та як заглядав, то наче й не заглядав!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006396
    m_Localized: 'Miner: Я б радий був, але ти бачиш, як тут все: смикнеш зайвий раз мотузку — і все, привіт!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006397
    m_Localized: 'Miner: Ну а так підходив, дивився, коли ми всі тут були… там темінь така, наче очі заплющив, і нічого-нічого.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006398
    m_Localized: 'Miner: Але знаєш, іноді, як станеш поруч, здається, ніби щось кличе. Просто ось… кличе. Спробуй підійди. Прислухайся…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006399
    m_Localized: 'Miner: Не те, щоб я боявся, але воно… ну… затягує. Зазирнути б ще раз, трішечки ближче.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006400
    m_Localized: 'Miner: Тільки вдвох краще, ти зрозумів? Раптом самому витягувати доведеться!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006401
    m_Localized: 'Miner: А? Що там про Гостей? А! Ну! Ось і я про це! Ми думаємо, що це їхні тунелі. А ця діра, ну… наче як ворота.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006402
    m_Localized: 'Miner: Слухай, а раптом там відповіді? Ну, не всі, звичайно, але хоча б на те, чому вони тут. Або навіщо. Ти уяви, скільки можна дізнатися!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006403
    m_Localized: 'Miner: Один раз спуститись — і все стане ясно. Я б сам, але розумієш, хто тоді підстрахує?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006404
    m_Localized: 'Miner: Ти наче хирлявий, то я тебе, раптом що, швидко витягну! Ну? Зробимо так: ти зазираєш, а я тут… за все відповідаю. Ти подумай над цим.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006405
    m_Localized: 'Miner: О, це ти? А я вже думав, що не прийдеш. Знаєш, тут щось не так. Світло дивне, мотузка наче важча.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006406
    m_Localized: 'Miner: Або це я від втоми вже себе накручую…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006407
    m_Localized: 'Miner: Але ця діра… Ну ти сам подумай, скільки разів ти до неї підходив? Зізнайся, щось у ній тебе тягне.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006408
    m_Localized: Думаєш, твій друг ще живий?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006409
    m_Localized: Інший ще не повернувся?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006410
    m_Localized: 'Miner: Друган мій? Ааа, та живий, звісно! Мотузка натягнута, бачиш? Значить, він там, працює. Якби щось трапилося, я б одразу помітив.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006411
    m_Localized: 'Miner: Але, знаєш, доки він там, є час. Час дізнатись, що тут взагалі відбувається. Ти сам не хочеш з''ясувати? Тобі ж цікаво, зізнайся!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006412
    m_Localized: Чому ти сам туди не полізеш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006413
    m_Localized: А якщо ми взагалі не дізнаємось, що там?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006414
    m_Localized: 'Miner: Який інший? Я вже давно зрозумів, що хтось із нас має діяти. Вічність тут не просидиш — або зараз, або ніколи.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006415
    m_Localized: 'Miner: Ти відчуваєш? Це місце, ця діра — вона тебе кличе. Ти ж це відчуваєш?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006416
    m_Localized: Чому ти сам туди не полізеш?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006417
    m_Localized: А якщо ми взагалі не дізнаємось, що там?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006418
    m_Localized: 'Miner: А хто тоді мене витягне, раптом що? Ти? Ну, без образ, але ж ти — самі кістки та шкіра. То краще ти спускайся, а я тебе підстрахую.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006419
    m_Localized: 'Miner: Я тебе однією лівою витягну. А якщо полізу я, хто мене тоді витягне, га? Логіка проста.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006420
    m_Localized: 'Miner: І потім, невже не хочеться дізнатись, що там? Слухай, я бачу, ти людина не боягузлива. Приходиш сюди вже втретє, чи не так?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006421
    m_Localized: 'Miner: Давай, сміліше. Ти спустишся, а я тут нагорі буду напоготові.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006422
    m_Localized: 'Miner: Ти ж не хочеш все життя сушити мозок і гадати, що ж там могло бути?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006423
    m_Localized: 'Miner: Ну? Чого чекаєш? Адже ми для цього тут.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006424
    m_Localized: 'Miner: Не дізнаємось? Ти серйозно? Слухай, адже це не проста діра. Ти сам це знаєш. Вона манить, і не дарма.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006425
    m_Localized: 'Miner: А раптом там щось, що переверне все з ніг на голову? Що відкриє тобі правду. Чи… зробить тебе героєм. Невже ти просто підеш?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006426
    m_Localized: 'Miner: Житимеш далі, начебто нічого не сталося? Давай, спускайся. Дізнаємось, що там. Разом. Ну?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006427
    m_Localized: 'Vigilante: Тримаєшся осторонь від решти?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006428
    m_Localized: 'Vigilante: Добре, більше шансів вижити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006429
    m_Localized: 'Vigilante: Якщо ти не Гість, звісно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006430
    m_Localized: А ти сам хто?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006431
    m_Localized: Чому не ховаєшся вдома?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006432
    m_Localized: 'Vigilante: Приїхав навести лад.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006433
    m_Localized: 'Vigilante: Проблеми у своєму районї я вже вирішив.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006434
    m_Localized: 'Vigilante: Більше тобі знати не потрібно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006435
    m_Localized: Це у тебе мітла для наведення ладу?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006436
    m_Localized: Що це ти на себе начепив? Залякуєш Гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006437
    m_Localized: 'Vigilante: Це не для мене розвага.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006438
    m_Localized: 'Vigilante: Хтось шкодує Гостей і вважає, що вони, не знаю… вилікуються згодом.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006439
    m_Localized: 'Vigilante: А через пару днів дізнаєшся, що Гості повбивали всіх у домі та пішли собі.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006440
    m_Localized: 'Vigilante: Безкарними.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006441
    m_Localized: 'Vigilante: Не можу я сидіти вдома. Я покарання для Гостей. Наводжу лад.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006442
    m_Localized: Це у тебе мітла для наведення ладу?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006443
    m_Localized: Що це ти на себе начепив? Залякуєш Гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006444
    m_Localized: 'Vigilante: Хахах. А мені подобається ця назва.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006445
    m_Localized: 'Vigilante: Так. Це мітла.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006446
    m_Localized: 'Vigilante: Я можу прибирати бруд і руками, але так простіше.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006447
    m_Localized: 'Vigilante: А ще краще просто заперти покидьків в одному будинку і спалити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006448
    m_Localized: 'Vigilante: А хто шкодуватиме Гостей — сам не кращий за них.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006449
    m_Localized: Ти чого прийшов?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006450
    m_Localized: І довго ти збираєшся «прибирати бруд»?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006451
    m_Localized: 'Vigilante: Залякую? А, ти про намисто.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006452
    m_Localized: 'Vigilante: Хех, авжеж. Добре сказано, запам''ятаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006453
    m_Localized: 'Vigilante: Це як нагадування собі, скільки вже вдалося зачистити будинків чи міст.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006454
    m_Localized: 'Vigilante: Найчастіше смикаю у Гостей по одному зубу, їх простіше взяти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006455
    m_Localized: 'Vigilante: А якщо хтось з них… справив враження, беру ще щось.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006456
    m_Localized: Ти чого прийшов?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006457
    m_Localized: І довго ти збираєшся «прибирати бруд»?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006458
    m_Localized: 'Vigilante: Почекай.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006459
    m_Localized: 'Vigilante: Досить твоїх запитань. Тепер моя черга.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006460
    m_Localized: 'Vigilante: Розкажи, що тут відбувається? З ким мені треба бути обережнішим?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006461
    m_Localized: Напівголий Гість роздер цілий загін військових
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006462
    m_Localized: Тут блукають Гості. Але в мене рушниця
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006463
    m_Localized: КНС забирають людей. Не впевнений, що їх повернуть
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006464
    m_Localized: 'Vigilante: Один? Напівголий?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006465
    m_Localized: 'Vigilante: Тобто без броні?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006466
    m_Localized: 'Vigilante: Оце цікаво. Ти навіть його бачив?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006467
    m_Localized: 'Vigilante: Здаєтться, що бачив. Навряд чи ти з тих пустобрехів, що розносять усякі плітки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006468
    m_Localized: 'Vigilante: Заінтригував. Я ще прийду.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006469
    m_Localized: 'Vigilante: То ти теж тут стежиш за порядком. Це добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200512
    m_Localized: 'Vigilante: Але я тобі не довіряю.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200513
    m_Localized: 'Vigilante: Мені треба розвідати все самому. Цим і займусь.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200514
    m_Localized: 'Vigilante: А ти поки що відпочивай. Побачимося пізніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200515
    m_Localized: 'Vigilante: Вони знають свою справу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200516
    m_Localized: 'Vigilante: І вміють визначають ознаки Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200517
    m_Localized: 'Vigilante: Чому це ти ними незадоволений?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200518
    m_Localized: 'Vigilante: Знаєш, мені треба декого провідати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200519
    m_Localized: 'Vigilante: Згодом ще обов''язково прийду… Цікавий ти.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200520
    m_Localized: 'Vigilante: Я повернувся.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200521
    m_Localized: 'Vigilante: Намагався знайти декого, але марно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200522
    m_Localized: 'Vigilante: Зате пройшовся будинками. Гостей тут у вас до біса.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200523
    m_Localized: 'Vigilante: КНС що, забили на це місто? Чи на цей район?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200524
    m_Localized: Як ти визначаєш Гостей?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200525
    m_Localized: Що ти робиш, якщо збігається лише одна чи дві ознаки?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200526
    m_Localized: 'Vigilante: Так само, як, блять, і ти!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200527
    m_Localized: 'Vigilante: По телеку та радіо говорять про ознаки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200528
    m_Localized: 'Vigilante: Якщо побачу хоч одну — відразу шмаляю не вагаючись.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200529
    m_Localized: 'Vigilante: Якщо я вже тут, підкажи, чи не знаєш такого товстенького мужичка у синій джинсовій куртці?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200530
    m_Localized: 'Vigilante: У нього ще мала дочка, не знаю, скільки років.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200531
    m_Localized: 'Vigilante: Дружина… та до біса її.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200532
    m_Localized: Його хату спалили. Більше не бачив його
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200533
    m_Localized: Вижила лише дочка. Твій знайомий згорів
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200534
    m_Localized: 'Vigilante: Починаю правосуддя.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200535
    m_Localized: 'Vigilante: Гості користуються добротою слабаків. Через таких квачів людей і вбивають у власних будинках.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200536
    m_Localized: 'Vigilante: Якщо я вже тут, підкажи, чи не знаєш такого товстенького мужичка у синій джинсовій куртці?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200537
    m_Localized: 'Vigilante: У нього ще мала дочка, не знаю, скільки років.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200538
    m_Localized: 'Vigilante: Дружина… та до біса її.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200539
    m_Localized: Його хату спалили. Більше не бачив його
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200540
    m_Localized: Вижила лише дочка. Твій знайомий згорів
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200541
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200542
    m_Localized: 'Vigilante: Ммм…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200543
    m_Localized: 'Vigilante: Покажи, що ти людина. Будь-яку ознаку.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200544
    m_Localized: 'Vigilante: Навіть якщо ти там зі зброєю стоїш — насрати, перестріляємо один одного.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200545
    m_Localized: (Показати зуби)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200546
    m_Localized: (Показати руки)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200547
    m_Localized: (Показати очі)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200548
    m_Localized: (Показати пахви)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200549
    m_Localized: (Показати фото)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200550
    m_Localized: (Показати вуха)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200551
    m_Localized: 'Vigilante: Ширше покажи. Давай, не сци.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200552
    m_Localized: 'Vigilante: Хм… нормально. Навіть прикро, якщо чесно.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200553
    m_Localized: 'Vigilante: Гаразд, живи. Але май на увазі: якщо наступного разу побачу щось не те, розмова буде короткою.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200554
    m_Localized: 'Vigilante: Все, не до тебе зараз. Потрібно дещо перевірити. Бувай.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200555
    m_Localized: 'Vigilante: Чисті… ну звичайно, бляха, чисті.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200556
    m_Localized: 'Vigilante: Ось що я тобі скажу: ті, хто нормально виглядає, потім швидше за всіх перетворюються.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200557
    m_Localized: 'Vigilante: Але мені не до твоїх рук зараз. Іншим разом продовжимо, і я перевірю тебе як слід.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200558
    m_Localized: 'Vigilante: Ширше, ширше давай розтуляй їх. Руцями, давай!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200559
    m_Localized: 'Vigilante: Хех, нічого підозрілого, звісно… Бляха.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200560
    m_Localized: 'Vigilante: Ти хоч розумієш, що здатні наробити в одну ніч ті, хто наче нормально виглядає?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200561
    m_Localized: 'Vigilante: Все, поки вільний. Але якщо побачу щось дивне, стрілятиму без попередження.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200562
    m_Localized: 'Vigilante: Мені зараз не до тебе. Є важливіші справи.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200563
    m_Localized: 'Vigilante: Хм…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200564
    m_Localized: 'Vigilante: Все гаразд. Але ж ти розумієш, що це нічого не означає? Ці тварюки можуть так замаскуватись, що навіть я відразу не помічу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200565
    m_Localized: 'Vigilante: Радій, що ти поки що чистий. Ховай свої бісові пахви, у мене є важливіші справи. Я ще повернуся.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200566
    m_Localized: 'Vigilante: Фото, значить. Аури, так? Ну давай, подивлюся на твою «чистоту».'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200567
    m_Localized: 'Vigilante: Хм… нормально. Точніше, на перший погляд нормально. Але знаєш, скільки таких «нормальних» вже у землі лежать?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200568
    m_Localized: 'Vigilante: Якщо чесно, мені зараз начхати на твоє фото. У мене є важливіші справи. Живи поки що. Наступного разу перевіримо щось серйозніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200569
    m_Localized: 'Vigilante: Вуха? Ти мене, блять, за ідіота тримаєш? Думаєш, я на таке поведусь?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200570
    m_Localized: 'Vigilante: Якби не брат…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200571
    m_Localized: 'Vigilante: Ти вдруге про вуха мені не заливай. Застрелю одразу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200572
    m_Localized: 'Vigilante: Все, зараз нема на тебе часу. У мене є важливіші справи. Але я ще повернуся.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200573
    m_Localized: 'Vigilante: Це знову я. Блять, взагалі не розумію, навіщо сюди поперся.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200574
    m_Localized: 'Vigilante: Якби брат не був таким сраним слиньком, може, хоч сім''ю вберіг би. А так тепер хрін зрозумієш, де його мала вештається.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200575
    m_Localized: Як ти тримаєшся?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200576
    m_Localized: Ти хочеш її знайти?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200577
    m_Localized: 'Vigilante: Та тримаюсь як завжди. Казав я брату — мужиком будь, сім''ю захищай. А він що?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200578
    m_Localized: 'Vigilante: Охляв, як баба. Що вийшло, сам бачиш — дружина з дитиною чи в землі, чи чортзна-де.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200579
    m_Localized: 'Vigilante: Ось через таких слабаків вся ця срань і відбувається.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200580
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200581
    m_Localized: 'Vigilante: Знаєш, нещодавно бачив, як одна сім''я трималася. Батько їх, кремезний такий мужик, не зламався, навіть коли Гості вже під вікнами вили.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200582
    m_Localized: 'Vigilante: Витяг сім''ю через задні двері і пішов у ліс. Я Гостей завалив, але вони так і не повернулись.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200583
    m_Localized: 'Vigilante: Думав, що здохли. Але хрін там — через пару днів знайшли мене самі, і знаєш, хто прийшов першим? Дочка цього мужика з рушницею.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200584
    m_Localized: 'Vigilante: Очі шалені, але жива. Ось це я розумію. Не те, що мій брат… здох би він раніше, може, хоч рідня б врятувалась.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200585
    m_Localized: 'Vigilante: Все, годі, забалакався я. Давай показуй щось на перевірку.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200586
    m_Localized: (Показати зуби)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200587
    m_Localized: (Показати руки)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200588
    m_Localized: (Показати очі)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200589
    m_Localized: (Показати пахви)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200590
    m_Localized: (Показати фото)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200591
    m_Localized: (Показати вуха)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200592
    m_Localized: 'Vigilante: Немає сенсу шукати. Марна справа. Якби брат хоч щось собою являв, може б, шанс був.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200593
    m_Localized: 'Vigilante: А так ... начхати вже. Досить про це.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200594
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200595
    m_Localized: 'Vigilante: Знаєш, був випадок на околиці міста. Сім''я в будинку забарикадувалася, батько ще стояв, тримав оборону.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200596
    m_Localized: 'Vigilante: А у дружини вже почалися ознаки… Але він до останнього благав: «Це моя дружина, не чіпайте її!»'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200597
    m_Localized: 'Vigilante: Коли Гості на дах полізли, цей довбограй відчинив двері, щоб вона втекла. Ну а я що? Прийшов і розібрався сам.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200598
    m_Localized: 'Vigilante: Її завалив першою, потім мужика. Діти з сусідами встигли кудись звалити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200599
    m_Localized: 'Vigilante: КНС тільки надвечір підтяглися, ніби зачищати. Я їм кажу: «Пізно, я вже лад навів».'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200600
    m_Localized: 'Vigilante: А вони іржуть: «Тебе до нас взяти треба». Та пішли вони у сраку. Тільки й вміють, що людей забирати, а Гості потім все одно залишаються.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200601
    m_Localized: 'Vigilante: Все, годі, забалакався я. Давай показуй щось на перевірку.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200602
    m_Localized: (Показати зуби)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200603
    m_Localized: (Показати руки)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200604
    m_Localized: (Показати очі)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200605
    m_Localized: (Показати пахви)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200606
    m_Localized: (Показати фото)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200607
    m_Localized: (Показати вуха)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200608
    m_Localized: 'Vigilante: Роззявляй пащу ширше. Не щулись, бля, я не стоматолог.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200609
    m_Localized: 'Vigilante: Гаразд, нормально. Хоча чесно? Краще б щось знайшов — потім менше клопоту.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200610
    m_Localized: 'Vigilante: І не зазнавайся. Якщо наступного разу щось не те побачу, розмова буде короткою.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200611
    m_Localized: 'Vigilante: Досить балачок. Мені зараз ніколи тут стирчати.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200612
    m_Localized: 'Vigilante: Ну? Давай швидше. Не соромся, не укушу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200613
    m_Localized: 'Vigilante: Хм… Брудні чи ні — мені взагалі насрати. Гості і без цього добре прикидаються.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200614
    m_Localized: 'Vigilante: Все, більше часу на це немає.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200615
    m_Localized: 'Vigilante: Очі ширше розплющ. Не дури мене тут.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200616
    m_Localized: 'Vigilante: Гаразд. Але це все одно не значить, що ти нормальний.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200617
    m_Localized: 'Vigilante: Все, поки вільний. Мені зараз не до цього.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200619
    m_Localized: 'Vigilante: Ти що, бляха, знущаєшся?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200620
    m_Localized: 'Vigilante: Якщо у тебе там щось цвіте — краще, щоб я цього не побачив.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200621
    m_Localized: 'Vigilante: Все, вільний. Мені не до твоїх пахв.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200622
    m_Localized: 'Vigilante: Знову ця срань?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200623
    m_Localized: 'Vigilante: Нічого особливого. Але таких «нормальних», яких довелося закопувати, вже була безліч.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200624
    m_Localized: 'Vigilante: Чесно? Начхати мені на твоє фото.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200626
    m_Localized: 'FatalDame: Як тобі нове життя?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200627
    m_Localized: 'FatalDame: Чи вдалося пристосуватись?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200628
    m_Localized: 'FatalDame: Хоча чому я питаю, якщо ти тут живеш.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200629
    m_Localized: Ти не схожа на інших
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200630
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200631
    m_Localized: 'FatalDame: Ти помітив. Дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200632
    m_Localized: 'FatalDame: Подобається?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200633
    m_Localized: 'FatalDame: Мені часто це говорять, особливо останнім часом.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200634
    m_Localized: 'FatalDame: А ти не говірливий. Розкажи про себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200635
    m_Localized: Я не хочу
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200636
    m_Localized: Я бажав своєму батьку смерті. Цього достатньо?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200637
    m_Localized: Стосунки з людьми — це не моє. Що раніше, що зараз
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200638
    m_Localized: 'FatalDame: Ого, ти різкий.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200639
    m_Localized: 'FatalDame: Що сталося? Від тебе нещодавно пішла дружина?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200640
    m_Localized: 'FatalDame: Гості вбили близьку людину, і тепер ти замкнувся у собі?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200641
    m_Localized: 'FatalDame: Чи в дитинстві пережив важкі часи, а всі ці події викликали погані спогади?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200642
    m_Localized: 'FatalDame: Розкажи. Я просто людина за дверима. Можливо, ми ніколи не побачимось більше.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200643
    m_Localized: Я не хочу
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200644
    m_Localized: Я бажав своєму батьку смерті. Цього достатньо?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200645
    m_Localized: Стосунки з людьми — це не моє. Що раніше, що зараз
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200646
    m_Localized: 'FatalDame: Можливо, тобі допоможе розкритися.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200647
    m_Localized: 'FatalDame: Але я не можу тебе змусити.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200648
    m_Localized: 'FatalDame: Хм…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200649
    m_Localized: 'FatalDame: Можу дати інше, на що мало хто погодиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200650
    m_Localized: 'FatalDame: Зараз через те, що відбувається, всі думають лише про кінець світу.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200651
    m_Localized: 'FatalDame: Але навіть найсамотнішим у таку хвилину потрібна… особлива увага.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200652
    m_Localized: 'FatalDame: Впусти мене, і ти відчуєш щось інше.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200653
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200654
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200655
    m_Localized: 'FatalDame: Твій батько був тираном? Це жахливо. Добре, що все залишилось у минулому.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200656
    m_Localized: 'FatalDame: Злість дуже важко відпустити. Пробачити ще важче.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200657
    m_Localized: 'FatalDame: Я відчувала таке. Якщо захочеш, можемо обговорити це… згодом.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200658
    m_Localized: 'FatalDame: І ще…'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200659
    m_Localized: 'FatalDame: Якщо ти впустиш мене, ми б разом впоралися з нашими проблемами.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200660
    m_Localized: 'FatalDame: Кожному з нас потрібна втіха в цей час. Трохи уваги. І ласки.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200661
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200662
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200663
    m_Localized: 'FatalDame: Я це розумію. Мало хто може вислухати і не вставити «а в мене от…»'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200664
    m_Localized: 'FatalDame: Зближатися з людьми загалом дуже непросто. Ти не один з такою проблемою.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200665
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200666
    m_Localized: 'FatalDame: Я можу допомогти тобі з цим.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200667
    m_Localized: 'FatalDame: Давай спробуємо… зблизитись?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200668
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200669
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200670
    m_Localized: 'FatalDame: Давай спробуємо уникнути всіх жахів життя разом.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200671
    m_Localized: 'FatalDame: Може, вдасться навіть відволіктися на щось цікавіше, ніж параноя та нескінченна жалість до себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200672
    m_Localized: 'FatalDame: Я не очікувала іншої відповіді.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200673
    m_Localized: 'FatalDame: Думаєш, буде простіше, коли все станеться?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200674
    m_Localized: 'FatalDame: …А він так не вважає.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633026
    m_Localized: 'BigLebowski: Зовсім як від батька.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633027
    m_Localized: 'BigLebowski: Ну вас к бісовій матері…'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633028
    m_Localized: 'BigLebowski: От бляха. У тебе, бач, на класному містечку вже є {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633029
    m_Localized: 'BigLebowski: Якщо вирішив впустити, місце треба той, звільнити.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633030
    m_Localized: 'BigLebowski: Хехе, зовсім як вірш. Прикол!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633031
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633032
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633033
    m_Localized: 'BigLebowski: Клас!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633034
    m_Localized: 'BigLebowski: Пфф… ну гаразд.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633035
    m_Localized: 'BigLebowski: Тільки дарма з вами час гаяла…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077071142912
    m_Localized: 'Theorist: О, чудово!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114432
    m_Localized: 'Theorist: Хоча… зачекайте. А це хто у вас?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114433
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114434
    m_Localized: 'Theorist: От вже ні!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114435
    m_Localized: 'Theorist: Цей… цей… {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114436
    m_Localized: 'Theorist: Я в жодному разі не готовий при ньому відкривати вам усю правду!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114437
    m_Localized: 'Theorist: Проженіть його, і я з радістю прийму ваше запрошення!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114438
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114439
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114440
    m_Localized: 'Theorist: Радий, що ви зробили правильне рішення! Повірте, ви не пошкодуєте.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114441
    m_Localized: 'Theorist: Після наших розмов ви змінитесь назавжди!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114442
    m_Localized: 'Theorist: Як це «йди звідси»?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114443
    m_Localized: 'Theorist: Ви… та ви…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114444
    m_Localized: 'Theorist: Ви надзвичайно вузьколоба людина, якщо ось так просто відмовляєтесь від правди!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114445
    m_Localized: 'Theorist: Прощавайте. Довго ви точно не протягнете!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114446
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114447
    m_Localized: 'Wifefema: Що це за {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114448
    m_Localized: 'Wifefema: Знаєте, я таких у своєму житті побачила багато. Не знаю, навіщо ви ось це впустили, але проблем точно дочекаєтесь.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114449
    m_Localized: 'Wifefema: Краще женіть в шию, поки не пізно!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114450
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114451
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114452
    m_Localized: 'Wifefema: Ох вже ці дармоїди… А ну геть!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114453
    m_Localized: 'Wifefema: Ви що, дурень? У мене ж чоловік з КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114454
    m_Localized: 'Wifefema: Я щось вас не розумію. Я вам тут душу розкриваю, а ви мені харкаєте туди, виходить?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114455
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114456
    m_Localized: 'Wifefema: А знаєш що, хуй з тобою. Піду до твоїх сусідів. Прощавай, бовдуре.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114457
    m_Localized: 'Raskolnikov: Ти пробач, я не хочу здатися грубим, але в тебе вже є {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114458
    m_Localized: 'Raskolnikov: Я з такими не можу уживатися. Просто не виходить.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114459
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114460
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114461
    m_Localized: 'Raskolnikov: Дякую, друже.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114462
    m_Localized: 'Raskolnikov: До речі, якщо ти будеш не проти, після того, як перевіриш мене…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114463
    m_Localized: 'Raskolnikov: Покажи мені, як ти вбиваєш Гостей. Хочу подивитись страху в очі.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114464
    m_Localized: 'Raskolnikov: Ох, вибач. Не хотів тебе ставити у незручне становище.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114465
    m_Localized: 'Raskolnikov: Ця людина, напевно, для тебе важлива. Вибач, що забрав твій час.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114466
    m_Localized: 'Raskolnikov: Сподіваюсь, я навчуся вбивати і зможу постояти за себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503040
    m_Localized: 'Nun: А це ще хто тут у вас — {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503041
    m_Localized: 'Nun: Та жодного життя не вистачить, щоб відмолити таким людям гріхи! Побоялися б Бога водитися з ними!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503042
    m_Localized: 'Nun: Виганяйте їх, наче демонів, і буде вам благодать!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503043
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503044
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503045
    m_Localized: 'Nun: Господи помилуй…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503046
    m_Localized: 'Nun: Бач ви який! Вам пропонують можливість стати на добрий шлях, а ви її втрачаєте. Нечувано!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503047
    m_Localized: 'Nun: Моя смерть буде на вашій совісті.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503048
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503049
    m_Localized: 'Nun: Вам ще віддячиться!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503050
    m_Localized: 'Fugitive: Не можу… Слухай, приятелю, у тебе тут є {0}. Я з такими людьми вже був стикався.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503051
    m_Localized: 'Fugitive: Він наче тихенько сидить, займається своїми справами, але заради своєї шкури буде готовий по трупах ходити.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503052
    m_Localized: 'Fugitive: Тобто, боюся, що така людина здасть та й оком не моргне!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503053
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503054
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503055
    m_Localized: 'Fugitive: Ти мені просто життя врятував, приятелю!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503056
    m_Localized: 'Fugitive: Сподіваюся, в тебе сусіди не повні мерзоти…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503057
    m_Localized: 'Fugitive: Ти, бляха, серйозно???'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503058
    m_Localized: 'Fugitive: Що, боїшся, що КНС на мене полюватиме? Та пиздець!..'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503059
    m_Localized: 'Fugitive: Ну давай, закопуйся у свою хатинку та нікого не пускай.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503060
    m_Localized: 'Fugitive: На добраніч, мудило.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503061
    m_Localized: 'Bestson: Бачу, у вас вже сидить {0} на дивані. Мене… ну… лякають такі чоловіки.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503062
    m_Localized: 'Bestson: Якось на мене напав схожий мужик у парку. Більше я туди ні ногою!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503063
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503064
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503065
    m_Localized: 'Bestson: Дякую! Але я все одно хвилююся…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503066
    m_Localized: 'Bestson: Раптом батьки повернуться, а мене не буде вдома.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503067
    m_Localized: 'Bestson: Але… Напевно, поки що краще побути у вас. Так спокійнйше.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503068
    m_Localized: 'Bestson: Мабуть, ви маєте рацію. Якраз почекаю батьків вдома. Може, вони вже повернулись…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503069
    m_Localized: 'Buddy: О-о, дружище, бачу, в тебе вже {0} гріє містечко.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503070
    m_Localized: 'Buddy: Я хлопець доброзичливий, але відчуваю, що нам усім в одній будці буде дещо тісно. Виручиш?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503071
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503072
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503073
    m_Localized: 'Buddy: Дякую! Дуже виручив!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697344
    m_Localized: 'Fatman: Бляха, у тебе тут… {0}. Жени під три чорти! Я не готовий пиздитись… за ванну.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697345
    m_Localized: 'Fatman: Краще я тобі чимось віддячу, щоб ти їх своєю рушницею… того-цього!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697346
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697347
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697348
    m_Localized: 'Fatman: Дружище, ти зробив… правильний вибір.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697349
    m_Localized: 'Fatman: Я тобі добре заплачу, коли все це скінчиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697350
    m_Localized: 'Fatman: Дружище, мені ж… погано.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697351
    m_Localized: 'Fatman: Куди я піду? Мені пизда.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697352
    m_Localized: 'Blind: Я відчуваю, що тут у тебе {0}. Щось не так із цією людиною.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697353
    m_Localized: 'Blind: Пробач, не можу пояснити, але я в цьому цілком упевнений.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697354
    m_Localized: 'Blind: Краще знайду інше місце.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697355
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697356
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697357
    m_Localized: 'Blind: Дякую тобі.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697358
    m_Localized: 'Blind: Та я піду, але…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697359
    m_Localized: 'Blind: Заради всього святого, не наближайся до спалених тіл уночі.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697360
    m_Localized: 'Blind: Інакше ВОНО прийде за тобою.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697361
    m_Localized: 'Dude: Оооо, братан, від душі!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697362
    m_Localized: 'Dude: Хоча, стривай… Це що за {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697363
    m_Localized: 'Dude: Бляха, та він всю тусовку нахрін загубить.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697364
    m_Localized: 'Dude: Чувачелло, нам би його випхати швидше, поки він не розсмердівся тут!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697365
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697366
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697367
    m_Localized: 'Dude: Оце я розумію! Ти красунчик!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697368
    m_Localized: 'Dude: Бляяяха…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697369
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697370
    m_Localized: 'Dude: Ну гаразд, чувак, не парся, я все розумію. Все пучком.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697371
    m_Localized: 'Dude: Бережи себе та своїх близьких.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697372
    m_Localized: 'Teacher: Вибачте, я бачу, у вас тут є {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697373
    m_Localized: 'Teacher: Я не можу жити з такою людиною в одному будинку.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697374
    m_Localized: 'Teacher: Мені здається, він схожий на… тих самих людей, які діточок…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697375
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697376
    m_Localized: 'Teacher: Вибачте…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697377
    m_Localized: Зараз прожену. Заходьте
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697378
    m_Localized: Краще йдіть звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697379
    m_Localized: 'Teacher: Дякую вам.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891648
    m_Localized: 'Ballerina: У тебе є {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891649
    m_Localized: 'Ballerina: Ее, мені сказали, тут таких не треба. Давай виганяй.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891650
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891651
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891652
    m_Localized: 'Ballerina: Ходімо, кицю, будеш мене розважати.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891653
    m_Localized: 'Ballerina: Я не тобі, а киці.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891654
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891655
    m_Localized: 'Ballerina: Бачиш пухнастика?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891656
    m_Localized: 'Mother: Хм… У тебе тут {0}. Мій малюк і так вже переляканий…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891657
    m_Localized: 'Mother: А чи можна… якось… вигнати цю людину, щоб дитина хоч раз заснула спокійно?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891658
    m_Localized: Зараз прожену. Заходьте
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891659
    m_Localized: Краще йдіть звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891660
    m_Localized: 'Mother: Ухх, чудово.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891661
    m_Localized: 'Mother: Давай, не стій на місці, проходь, дядько не буде всю ніч чекати.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891662
    m_Localized: 'Mother: Ну гаразд. Ходімо, спробуємо дістатися до твого дурного батька.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891663
    m_Localized: 'Mother: Може, вже не встигнемо…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891664
    m_Localized: 'Mother: Та ні, маємо встигнути.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891665
    m_Localized: 'Anger: У тебе тут {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891666
    m_Localized: 'Anger: Ні, з такою гидотою я під одним дахом не житиму. Бо тут вже не стримаюсь.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891667
    m_Localized: 'Anger: Ти не переймайся, я інших не чіпатиму.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891668
    m_Localized: 'Anger: Я не буйний.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891669
    m_Localized: 'Anger: Всю лють я зганяю на собі, ніхто не постраждає.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891670
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891671
    m_Localized: 'Anger: Блять, то ти такий самий сцикун, як інші труси.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891672
    m_Localized: 'Anger: Сиди, терпи, поки тобі на обличчя не насеруть.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891673
    m_Localized: 'Anger: Пиздець.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891674
    m_Localized: 'Couple: Ох, не знаю, як вам дякувати.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891675
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891676
    m_Localized: 'Couple: Хто це у вас?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891677
    m_Localized: 'Couple: Ох, не подумайте, що я прискіпуюсь, але ми та {0} разом не уживемось…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891678
    m_Localized: 'Couple: Моя дружина не дуже любить дітей, розумієте. Не очікував побачити тут когось у такому віці.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891679
    m_Localized: Зараз прожену. Заходьте
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891680
    m_Localized: Краще йдіть звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891681
    m_Localized: 'Couple: Ох, дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891682
    m_Localized: 'Couple: Що ти завмерла, заходь, нас же впустили.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891683
    m_Localized: 'Couple: Така соромлива. Нічого, зараз відпочинемо.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891684
    m_Localized: 'Couple: Зрозумів, вибачте, що потурбували.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891685
    m_Localized: 'Couple: Пошукаємо інше місце. Так, сонечко?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891686
    m_Localized: 'Couple: Ну, ворушися вже, я теж втомився.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891687
    m_Localized: 'Luka: Із задоволенням увійшов би, але зараз там {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891688
    m_Localized: 'Luka: Не хочу тіснити людину — раптом їй цей дах потрібніший.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891689
    m_Localized: 'Luka: Якщо зможеш звільнити для мене куточок, я буду вдячний.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891690
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891691
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891692
    m_Localized: 'Luka: Дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891693
    m_Localized: 'Luka: Сподіваюся, ти теж згадаєш, що значить бути щасливим.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891694
    m_Localized: 'Luka: Може, думки про смерть залишать тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891695
    m_Localized: 'Luka: Ти краще не закопуйся у своєму горі.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891696
    m_Localized: 'Luka: Якщо занадто на ньому зациклюватись, можна збожеволіти.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891697
    m_Localized: 'Luka: А там недалеко і до чогось жахливого.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891698
    m_Localized: 'Luka: Бережи себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085952
    m_Localized: 'FortuneTeller: Ой… я відчуваю… відчуваю, що у вас тут дуже важка аура. Така погубить нас усіх, весь дім!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085953
    m_Localized: 'FortuneTeller: Точно… {0}. Це вам про щось говорить?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085954
    m_Localized: 'FortuneTeller: Його потрібно позбутись, інакше зірки зійдуться на біду, розумієте, так?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085955
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085956
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085957
    m_Localized: 'FortuneTeller: Добре, у вас тут розташування ну дуже ресурсне, якщо чесно.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085958
    m_Localized: 'FortuneTeller: Через ваш дім іде енергетичний потік.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280256
    m_Localized: 'Fanatic: Людино! Я не можу зайти, поки в домі ховається {0}. СОНЦЕ НЕ ВЕЛИТЬ!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280257
    m_Localized: 'Fanatic: Його тінь, навіть він сам гасить праведне світло! Вигнати єретика! Геть, геть!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280258
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280259
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280260
    m_Localized: 'Fanatic: ОЦЕ ТАК! Благословення Сонцеликого засяє у твоїх ОЧАХ!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280261
    m_Localized: 'Fanatic: А я поки ось тут присяду… хо-о-о-оба!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280262
    m_Localized: 'Fanatic: То й іди у сраку!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280263
    m_Localized: 'Fanatic: Грішно тримати двері зачиненими перед світлом… ні, перед ПРОСВІТЛЕННЯМ!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280264
    m_Localized: 'Fanatic: Піду поділюсь променями свого знання з кимось іншим, а ти продовжуй тут гнити!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280265
    m_Localized: 'Hunter: Хм, у тебе тут вже {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280266
    m_Localized: 'Hunter: У цієї людини руки пахнуть кров''ю. Не знаю, навіщо ти таких пускаєш до себе. Може, тобі подобається лоскотати собі нерви?..'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280267
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280268
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280269
    m_Localized: 'Hunter: Оце правильно. У мене хоча б досвід є. Зможу допомогти тобі, якщо нагряне цей…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280270
    m_Localized: 'Anxiety: Т-там вже {0} якийсь.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280271
    m_Localized: 'Anxiety: Я… я не можу поряд. Не знаю, раптом він Гість?..'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280272
    m_Localized: 'Anxiety: Будь ласка, перевірте його чи…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280273
    m_Localized: 'Anxiety: Можете його, е-е-е… попросити піти?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280274
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280275
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280276
    m_Localized: 'Anxiety: Дякую. Я тихо посиджу в кутку. Тільки не зачиняйте двері, гаразд, хахах? Раптом що…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280277
    m_Localized: 'Anxiety: Добре, хахах… Гаразд, я піду. Ммм, все одно сонце нас доб''є. Ми всі помремо…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280278
    m_Localized: 'Esenin: Нехай спершу звалить {0}, потім поговоримо.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280279
    m_Localized: 'Esenin: Таких у барі викидали навіть швидше за мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280280
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280281
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280282
    m_Localized: 'Esenin: Ну, хоч раз все по-моєму. Веди.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280283
    m_Localized: 'Esenin: Та й ну тебе к бісовій матері. Ти ще й не п''єш, мабуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280284
    m_Localized: 'Cold: Дякую… А, у тебе вже хтось є. Я не зайду, доки тут сидить {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280285
    m_Localized: 'Cold: Я… мені страшно бути з людьми в одній кімнаті. Згодом… трапляється щось дуже неприємне. Щоразу…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280286
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280287
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280288
    m_Localized: 'Cold: Дякую. Повір мені, так буде краще.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280289
    m_Localized: 'Cold: Розумію…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280290
    m_Localized: 'Cold: Гаразд, я піду. Може, сонцю вдасться нарешті зігріти мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280291
    m_Localized: 'Cold: Так… десь у полі… подалі від усіх…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280292
    m_Localized: 'Scammer: Чуєш, у тебе тут уже {0}. З такого ні грошей струсити, ні історій якихось прикольних.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280293
    m_Localized: 'Scammer: Дай йому штурханця, і буде між нами все чітко.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280294
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280295
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280296
    m_Localized: 'Scammer: Ніштяк. Ти підійди до мене, як час буде. Поділюся з тобою своїми думками.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280297
    m_Localized: 'Scammer: Ну ти когутяра. Я одразу відчув, що ми з тобою кашу не зваримо.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280298
    m_Localized: 'Scammer: Та й пох. Знайду ще лошків — їх на світі багато!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474560
    m_Localized: 'Daughter: Я… мені… для мене немає місця!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474561
    m_Localized: 'Daughter: Там {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474562
    m_Localized: 'Daughter: А я… я тільки там хочу. Ну хочуууу! Там… там наче тато сидів… Він розповідав.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474563
    m_Localized: 'Daughter: Хочу до тааааатааа…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474564
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474565
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474566
    m_Localized: 'Daughter: ТАТООО, ТАТОНЬКУУУ!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474567
    m_Localized: 'Daughter: КУДИИИ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474568
    m_Localized: 'Daughter: Я ніко-о-о-го-о-о б-більше не зна-а-а-а-ю…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474569
    m_Localized: 'Daughter: МЕНІ ДУЖЕ СТРА-А-А-А-А-ШНО…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474570
    m_Localized: 'Daughter: Ааааааааа…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474571
    m_Localized: 'NotTrue: Ой, лишенько! Та у тебе тут у кріслі вже {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474572
    m_Localized: 'NotTrue: З такими людьми буде тяжко-тяженько…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474573
    m_Localized: 'NotTrue: Я б, напевно, присіла тут на ґаночку, трохи перепочила, а потім і далі пішла б, коли в тебе такі гості.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474574
    m_Localized: Зараз прожену. Заходьте
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474575
    m_Localized: Краще йдіть звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474576
    m_Localized: 'NotTrue: Ой, дякую, голубе! Виручив бабусю! Шкода, звичайно, що тобі довелося когось вигнати заради мене…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474577
    m_Localized: 'NotTrue: Ох, голубчику. Ну, нічого, можеш бабусі стільчика винести?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474578
    m_Localized: 'NotTrue: Я тут посиджу трошки та далі піду.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668866
    m_Localized: 'Doctor: Хм, бачу, у вас тут мешкає {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668867
    m_Localized: 'Doctor: Я не можу забезпечити йому нормальний догляд.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668868
    m_Localized: 'Doctor: Йому варто піти та знайти того, хто зможе дійсно допомогти.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668869
    m_Localized: Зараз прожену. Заходьте
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668870
    m_Localized: Краще йдіть звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668871
    m_Localized: 'Doctor: Дякую. Сподіваюсь, я зможу комусь допомогти.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668872
    m_Localized: 'Doctor: Розумію, зараз не найкращий час для довіри.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668873
    m_Localized: 'Doctor: Якщо пощастить, я буду поряд, тож звертайтеся.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668874
    m_Localized: 'Foreigner: Ммммф. Ффффив!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668875
    m_Localized: 'Foreigner: (Схоже, йому не подобається {0}. Він показує нього, потім на себе, потім знову на нього.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668876
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668877
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668878
    m_Localized: 'Foreigner: (Він киває вам і заходить у двері.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668879
    m_Localized: 'Edgar: Я б увійшов, але там уже {0}. Ця людина все ще турбується про завтра…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668880
    m_Localized: 'Edgar: А я прийшов слухати, як затихає сьогодні.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668881
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668882
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668883
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668884
    m_Localized: 'Edgar: Не знаю, наскільки ти поділяєш мої погляди на красу, але ж ти не викидаєш тіла?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668885
    m_Localized: 'Edgar: Збережи моє, коли настане час.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863168
    m_Localized: 'TaxiDriver: Ти це, не зрозумій мене неправильно, але в тебе вдома є {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863169
    m_Localized: 'TaxiDriver: Мені цей хлопець нагадує одного з тих, хто переслідував мою родину та…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863170
    m_Localized: 'TaxiDriver: Словом, вирішуй: або він, або я.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863171
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863172
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863173
    m_Localized: 'TaxiDriver: Фух, спасибі, дядьку. Виручаєш!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863174
    m_Localized: 'TaxiDriver: Ти це, підходь до мене якось, побалакаємо.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863175
    m_Localized: 'TaxiDriver: Я так-то розумію. Але все одно це пиздець…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863176
    m_Localized: 'Provocateur: Егеж… бачу, у вас вже мешкає {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863177
    m_Localized: 'Provocateur: А ви знали, що ця людина — злісний порушник закону!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863178
    m_Localized: 'Provocateur: Статті 28, 48 та 7.3 Конституції вам про що-небудь говорять?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863179
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863180
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863181
    m_Localized: 'Provocateur: Дякую вам, власнику.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863182
    m_Localized: 'Provocateur: Потім у деталях все обговоримо з приводу оренди.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863183
    m_Localized: 'Marauder: Йой, а в тебе затишний куточок вже зайнятий.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863184
    m_Localized: 'Marauder: Ким? Та ось, дивись, ця {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863185
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863186
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863187
    m_Localized: 'Marauder: Оце діло!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863188
    m_Localized: 'Marauder: Еех, думав, зможу трохи перепочити.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863189
    m_Localized: 'Marauder: Ну, нічого. Варто було спробувати.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863190
    m_Localized: 'GraveDigger: Йоханий бабай, та у тебе тут вже {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863191
    m_Localized: 'GraveDigger: Я б з радістю до тебе зайшов, але розумієш…'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863192
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863193
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863194
    m_Localized: 'GraveDigger: Ох, дякую, мужиче!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863195
    m_Localized: 'FormerFema: Що? А, дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863196
    m_Localized: 'FormerFema: Тобто зачекайте.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863197
    m_Localized: 'FormerFema: О-ох… бачу, у ванній вже є {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863198
    m_Localized: 'FormerFema: Знаєте, я весь день у цьому сраному костюмі, так вже хочеться його зняти, змити весь пил та чужу кров.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863199
    m_Localized: 'FormerFema: Якщо зможете переселити цю людину, присягаюся — тихо сидітиму і нікому не буду заважати.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863200
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863201
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863202
    m_Localized: 'FormerFema: Правда?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863203
    m_Localized: 'FormerFema: Чомусь не думав, що ви мене впустите.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863204
    m_Localized: 'FormerFema: Гаразд, розумію.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863205
    m_Localized: 'FormerFema: Напевно, цей костюм відлякує людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863206
    m_Localized: 'FormerFema: Сам не знаю, чого я в нього вчепився.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863207
    m_Localized: 'FormerFema: Бувайте.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863208
    m_Localized: 'Intruder: Дякую, але я бачу, хтось вже зайняв моє місце. Ось… {0}. '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863209
    m_Localized: 'Intruder: Нам удвох тут не вміститись.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863210
    m_Localized: 'Intruder: Я бачив цю людину у своїх снах і, знаєш, мені вистачило.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863211
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863212
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863213
    m_Localized: 'Intruder: Сподіваюсь, хоча б тут вийде поспати.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446720741376
    m_Localized: 'Wifefema: Слухайте, нюх у мене що треба. Миттєво розпізнаю і людей, і Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518592
    m_Localized: 'Wifefema: Давайте по-простому: ось від мене {0} авансом, а ви пустите погрітися, хех.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518593
    m_Localized: 'Wifefema: Не захочете? Одне слово чоловікові, і завтра люди в жовтих комбінезонах влаштують позаплановий рейдик.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518594
    m_Localized: 'Wifefema: З папірцями, песиками… І так щоранку. Подумайте, що дешевше.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518595
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518596
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518597
    m_Localized: 'Wifefema: Ви що, дурень? У мене ж чоловік з КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518598
    m_Localized: 'Wifefema: Я щось вас не розумію. Я вам тут душу розкриваю, а ви мені харкаєте туди, виходить?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518599
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518600
    m_Localized: 'Wifefema: А знаєш що, хуй з тобою. Піду до твоїх сусідів. Прощавай, бовдуре.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518601
    m_Localized: 'Fugitive: Я зараз, блять, стеку кров''ю прямо у тебе під дверима, якщо не впустиш та не допоможеш підлататись.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518602
    m_Localized: 'Fugitive: Слухай, я готовий все віддати, що маю. Ось, як тобі {0}? Знайшов по дорозі. Більше ні чорта не маю.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518603
    m_Localized: 'Fugitive: Впусти, бо я тут здохну!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518604
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518605
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518606
    m_Localized: 'Bestson: Я… я навіть не знаю, що робити…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518607
    m_Localized: 'Bestson: Може, ви хочете щось від мене? {0} підійде?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518608
    m_Localized: 'Bestson: Ще є жуйка. Але там залишилося кілька штучок. Можу їх теж віддати…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518609
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518610
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712896
    m_Localized: 'Fatman: Я розумію, дружище. Здається, я… знаю, що може допомогти.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712897
    m_Localized: 'Fatman: Ось тобі ПОДАРУНОЧОК… від мене. {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712898
    m_Localized: 'Fatman: Хех, ну що? Так… краще буде? Ми домовились?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712899
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712900
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712901
    m_Localized: 'Blind: Я… у мене щось було з собою. Почекай, будь ласка…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712902
    m_Localized: 'Blind: Здається, це {0}. Можеш взяти. Мені потрібен хоча б день, щоб перевести дух. Але… яке там…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712903
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712904
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712905
    m_Localized: 'Dude: Камоооон, бро…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712906
    m_Localized: 'Dude: А, зараз, у мене той… Є дещо.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712907
    m_Localized: 'Dude: О! {0}! Це, типу, як в іграх. Заробляєш бали, щоб покращити стосунки. Я все розумію, бро!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712908
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712909
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712910
    m_Localized: 'Wheelchair: Не пускаєш? Зараз виправимо! Ось {0}, береш, махаєш біля входу — і хоп! Ти невидимий.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712911
    m_Localized: 'Wheelchair: Сто пудів, спрацює!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712912
    m_Localized: 'Wheelchair: Он, мої ноги — ходячий пруф! Бачиш, ніфіга їх нема, ха?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712913
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712914
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907200
    m_Localized: 'Couple: Ви пробачте, будь ласка, за мою наполегливість, але поставте себе на наше місце.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907201
    m_Localized: 'Couple: Моя дружина ослабла останнім часом. Швидко втомлюється. А я… я для неї на все готовий, розумієте?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907202
    m_Localized: 'Couple: Дуже її люблю. Готовий останню сорочку з себе продати заради неї.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907203
    m_Localized: 'Couple: До речі, про сорочку!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907204
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907205
    m_Localized: 'Couple: У нас дещо є.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907206
    m_Localized: 'Couple: {0}. Я готовий останнє віддати, аби моя люба змогла перепочити.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907207
    m_Localized: 'Couple: То що скажете? Чи допоможете нам?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907208
    m_Localized: Гаразд, заходьте
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907209
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907210
    m_Localized: 'Luka: Я б хотів тобі допомогти. Може, ти чогось хочеш?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907211
    m_Localized: 'Luka: У мене є {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907212
    m_Localized: 'Luka: Тебе це зацікавить?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907213
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 48213446750101504
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490112
    m_Localized: 'Widow: Дякую, що допоміг. Не те що…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490113
    m_Localized: 'Widow: У тебе тут {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490114
    m_Localized: 'Widow: Ні.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490115
    m_Localized: 'Widow: Я з таким в одному домі не буду.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490116
    m_Localized: Я розберуся. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490117
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490118
    m_Localized: 'Widow: Дякую… Я надовго не затримаюся… Мені б перепочити…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684416
    m_Localized: 'Greatmother: Опа, це що, {0} сидить у тебе тут? Оце так зустріч!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684417
    m_Localized: 'Greatmother: Ні, з такою людиною каші не навариш.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684418
    m_Localized: 'Greatmother: Може, той, виженемо? А я сяду там!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684419
    m_Localized: Я розберуся. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684420
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684421
    m_Localized: 'Greatmother: Ай, молодець! Від таких людей нічого, крім лиха, чекати не можна.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878720
    m_Localized: 'Twins: Боюся, що у вас вже сидить {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878721
    m_Localized: 'Twins: Я відчуваю, що на мою сестричку посипляться слова осуду від цієї людини.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878722
    m_Localized: 'Twins: А їй цього зараз не треба. Їй потрібні спокій та турбота.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878723
    m_Localized: Зараз прожену. Заходьте
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878724
    m_Localized: Краще йдіть звідси
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878725
    m_Localized: У вас тут {0}…
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878726
    m_Localized: Мені буде важко з такою людиною під одним дахом.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878727
    m_Localized: Знаєте, до того, як я зустріла свого чоловіка, у мене… скажімо так, ця людина дуже нагадує мені одного знайомого.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878728
    m_Localized: Відчуваю, що ми тут разом не уживемося.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878729
    m_Localized: Зараз прожену. Заходьте
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878730
    m_Localized: Краще йдіть звідси
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878731
    m_Localized: 'Twins: Я бачу, що у вас вдома вже сидять {0} та {1}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878732
    m_Localized: 'Twins: Вони… боюся, моїй сестрі стане тільки гірше, поки ці двоє тут.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878733
    m_Localized: 'Twins: Вони дуже нагадують наших… батьків… а це… не найкраще оточення для моєї сестри в такому стані…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878734
    m_Localized: Зараз прожену. Заходьте
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878735
    m_Localized: Краще йдіть звідси
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878736
    m_Localized: 'Twins: Хм, я розумію, що ви нас не знаєте. Можете думати, що ми втягнемо вас у халепу. Але ми не такі. Моїй сестричці просто дуже важко.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878737
    m_Localized: 'Twins: У нас із собою є… Що ж там було?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878738
    m_Localized: 'Twins: {0}. Візьміть, може, вам знадобиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878739
    m_Localized: Гаразд, заходьте
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878740
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878741
    m_Localized: 'Wolfhound: У тебе вже {0} псує повітря? Я одразу бачу, що це вовчиця в овечій шкурі.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878742
    m_Localized: 'Wolfhound: Гони її до біса, якщо хочеш залишити дім за собою.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878743
    m_Localized: Я розберусь. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878744
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878745
    m_Localized: 'Wolfhound: Оце розумно.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878746
    m_Localized: 'Wolfhound: Сила тепер керує життям, і ти або приймаєш це, або отримуєш проблеми.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073024
    m_Localized: 'Marauder: Йой, та не жени одразу… Дай-но пориюся в мішку.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073025
    m_Localized: 'Marauder: Так, ножичок самому потрібен, бинти теж у пригоді стануть… М-м, ось ще стара фляга, але нащо вона без води…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073026
    m_Localized: 'Marauder: А! Знайшов — {0}. Забирай, хазяїне, тільки дай до ранку перекантуватися.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073027
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073028
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073029
    m_Localized: 'GraveDigger: Та Йосип на кобилі! Давай підкуплю тебе чимось.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073030
    m_Localized: 'GraveDigger: Чого твоя душа бажає?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073031
    m_Localized: 'GraveDigger: {0}? Годиться?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073032
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073033
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267329
    m_Localized: 'Courier: А я не очікував, що люди не запаслися продуктами на кінець світу.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267330
    m_Localized: 'Courier: Апокаліпсис чи ні, а обід за розкладом.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267331
    m_Localized: 'Courier: До того ж, за доставку зараз дуже добре платять. Ризик великий, як не крути.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267332
    m_Localized: 'Courier: Щоправда, довбане сонце… Через нього нас перевели на нічні зміни.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267333
    m_Localized: 'Courier: І тепер люди замовляють по 20 літрів води. Ех, якби надбавку, чи хоч на чай залишали за такий тягар…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267334
    m_Localized: 'Courier: Гаразд, вибачте, я щось відволікся. Ви візьмете замовлення?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267335
    m_Localized: (Забрати замовлення)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267336
    m_Localized: 'Courier: Ось ваше замовлення: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267338
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267339
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267340
    m_Localized: 'Courier: До того ж, всі мої рідні не тут. Я не тутешній — приїхав сюди навчатися в університеті. Тож я тут сам…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267341
    m_Localized: Самому бути не так вже й погано
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267342
    m_Localized: Співчуваю
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267343
    m_Localized: 'Courier: Ага, звісно. У вас тут купа народу вдома, вам легко казати.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267344
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267345
    m_Localized: 'Courier: Та власне, не так вже й погано кур''єром працювати.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267346
    m_Localized: 'Courier: Та й яке тут навчання, якщо все одно мене нікуди не візьмуть.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267347
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267348
    m_Localized: 'Courier: Гаразд, ви тут начебто замовлення маєте. Візьмете?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267349
    m_Localized: (Забрати замовлення)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267350
    m_Localized: 'Courier: Ось ваше замовлення: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267352
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267353
    m_Localized: Не заганяйся, все буде нормально
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267354
    m_Localized: Хочеш вижити — не скигли як баба
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267355
    m_Localized: 'Courier: Нормально? А що взагалі у цьому катаклізму лишилося нормального?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267356
    m_Localized: 'Courier: Всі ці Гості, їх ознаки, та ще довбане Сонце…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267357
    m_Localized: 'Courier: Я думав, гірше вже не буде. Але кожного дня якась нова шиза.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267358
    m_Localized: 'Courier: Нехай ще лобкове волосся оголосять новою ознакою, щоб всі геть сказились…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267359
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267360
    m_Localized: 'Courier: Все, мені треба йти далі. Бери своє замовлення, і я піду.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267361
    m_Localized: (Забрати замовлення)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267362
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267363
    m_Localized: 'Courier: Ну ти, блять, вмієш мотивувати. Дякую тобі велике.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267364
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267365
    m_Localized: 'Courier: Знаєш що, бери вже своє замовлення, і я піду звідси.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267366
    m_Localized: (Забрати замовлення)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267367
    m_Localized: 'Courier: Ось ваше замовлення: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267368
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267370
    m_Localized: По-іншому зараз ніяк
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267371
    m_Localized: Мені шкода
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267372
    m_Localized: 'Courier: А, ось воно як… Хочеш сказати, це добре, що мого друга вбили?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267373
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267374
    m_Localized: 'Courier: Бери вже замовлення, і я заберуся звідси, поки ти й мене не застрелив.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267375
    m_Localized: (Забрати замовлення)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267376
    m_Localized: 'Courier: Еххх…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267377
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267378
    m_Localized: 'Courier: Пам''ятаєш, я казав, що робота кур''єром допомагає мені відволіктися? Здається, більше не виходить.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267379
    m_Localized: 'Courier: Я постійно бачу стомлені, похмурі, злісні обличчя…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267380
    m_Localized: 'Courier: Ці вічні ранкові огляди з КНС-никами, які наставляють на тебе автомати…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267381
    m_Localized: 'Courier: Як все це вже…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267382
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267383
    m_Localized: 'Courier: Я втомився від цього лайна. Мені просто хочеться, щоб уся ця срань скінчилась…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267384
    m_Localized: 'Courier: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267385
    m_Localized: 'Courier: Давай, бери замовлення, та я піду.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267386
    m_Localized: (Забрати замовлення)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267387
    m_Localized: 'Courier: Тримай: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267388
    m_Localized: 'Courier: Доброї ночі…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267389
    m_Localized: 'CultistPriest: Це дуже добре. Але спочатку треба вигнати твоїх людей:'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267390
    m_Localized: 'CultistPriest: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267391
    m_Localized: 'CultistPriest: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267392
    m_Localized: 'CultistPriest: Вони заважають досягненню нашої мети.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267393
    m_Localized: Зараз прожену. Заходьте
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267394
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267395
    m_Localized: 'CultistPriest: Дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267396
    m_Localized: 'CultistPriest: Багато часу їм не знадобиться. Але все одно доглядай моїх людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267397
    m_Localized: 'CultistPriest: Побачимося пізніше, я прийду відвідати їх.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267398
    m_Localized: 'CultistPriest: Ти думаєш, у тебе є вибір?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267399
    m_Localized: 'CultistPriest: Побачимося пізніше, я прийду відвідати їх.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267400
    m_Localized: 'CultistPriest: Наглядай за моїми людьми. І пам''ятай: помре один — від твого дома нічого не залишиться.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655936
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655937
    m_Localized: 'StaticBoy: Він не спить?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655938
    m_Localized: 'StaticBoy: Має спати…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655939
    m_Localized: Ти загубився?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655940
    m_Localized: Де твої батьки?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655941
    m_Localized: 'StaticBoy: Двері всі схожі у темряві.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655942
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655943
    m_Localized: 'StaticBoy: Мені потрібне було світло кухні, але тут… інше відлуння.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655944
    m_Localized: 'StaticBoy: Я чув, як рипнула сходинка — отже, хтось чекає.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655945
    m_Localized: Що ти тут шукаєш?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655946
    m_Localized: Тобі допомогти знайти твій дім?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655947
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655948
    m_Localized: 'StaticBoy: Батьки?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655949
    m_Localized: 'StaticBoy: У мене їх нема. І ніколи не було.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655950
    m_Localized: 'StaticBoy: Вони взагалі потрібні?..'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655951
    m_Localized: Що ти тут шукаєш?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655952
    m_Localized: Тобі допомогти знайти твій дім?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655953
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655954
    m_Localized: 'StaticBoy: Не той запах. Не той голос.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655955
    m_Localized: 'StaticBoy: Вибачте.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655956
    m_Localized: 'StaticBoy: Я переплутав будинок.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655957
    m_Localized: 'StaticBoy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655958
    m_Localized: 'StaticBoy: Не той запах. Не той голос.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655959
    m_Localized: 'StaticBoy: Вибачте.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655960
    m_Localized: 'StaticBoy: Я переплутав будинок.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655961
    m_Localized: 'Jacob: Здоров був.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655962
    m_Localized: 'Jacob: До тебе раптом не заходила дівчинка в пончо з фіолетовим волоссям?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655963
    m_Localized: Таких у нас немає
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655964
    m_Localized: Розпусний дім за іншою адресою
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655965
    m_Localized: 'Jacob: Вона моя дочка.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655966
    m_Localized: 'Jacob: Я ніяк не можу її знайти після того, як почалося все це лайно.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655967
    m_Localized: 'Jacob: Ми збиралися покинути місто…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655968
    m_Localized: 'Jacob: Але потім почалась аномальна спека, я знепритомнів…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655969
    m_Localized: 'Jacob: Прийшов до тями, а вдома нікого.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655970
    m_Localized: 'Jacob: Ані записки, ані сліду. Дочка просто кудись зникла.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655971
    m_Localized: Куди ви хочете поїхати?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655972
    m_Localized: Її тут нема. Бувай
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655973
    m_Localized: 'Jacob: Тобі краще не говорити так про мою дочку.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655974
    m_Localized: 'Jacob: Я її шукаю з самого початку цієї херні.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655975
    m_Localized: 'Jacob: І не маю жодного уявлення, де вона.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655976
    m_Localized: 'Jacob: Як тільки її знайду, ми одразу поїдемо з міста.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655977
    m_Localized: Куди ви хочете поїхати?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655978
    m_Localized: Її тут нема. Бувай
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655979
    m_Localized: 'Jacob: Кудись, де КНС до нас не добереться.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655980
    m_Localized: 'Jacob: Словом, якомога далі.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655981
    m_Localized: 'Jacob: Я, бач, у розшуку, бо надто багато знаю про них.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655982
    m_Localized: 'Jacob: Можливо, якраз ці виродки й забрали мою дочку, але я не певен.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655983
    m_Localized: 'Jacob: Якщо це так, вони її не чіпатимуть, тому що їм потрібен саме я.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655984
    m_Localized: 'Jacob: Дозволь у тебе перекантуватися пару днів, поки КНС не залишить район.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655985
    m_Localized: 'Jacob: Потім я піду та шукатиму дочку далі.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655986
    m_Localized: 'Jacob: Та що там, я тобі все розповім.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655987
    m_Localized: 'Jacob: Я точно знаю, звідки взялися Гості!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655988
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655989
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655990
    m_Localized: 'Jacob: Стій, почекай!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655991
    m_Localized: 'Jacob: Мені потрібен притулок на кілька днів.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655992
    m_Localized: 'Jacob: КНС мене розшукує, тому що я знаю деяку інформацію…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655993
    m_Localized: 'Jacob: Уряд точно не хоче, щоб про це хтось ще дізнався.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655994
    m_Localized: 'Jacob: Обіцяю, коли КНС покине район, я піду та шукатиму дочку далі.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655995
    m_Localized: 'Jacob: Та що там, я тобі все розповім.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655996
    m_Localized: 'Jacob: Я точно знаю, звідки взялися Гості!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655997
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655998
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655999
    m_Localized: 'Jacob: Дякую тобі.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656000
    m_Localized: 'Jacob: Нині лишилося не так багато людей, які вміють слухати.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656001
    m_Localized: 'Jacob: Саме такі люди, як ти, зможуть пережити цей жах.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656002
    m_Localized: 'Jacob: Бо ми з тобою безсмертні.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656003
    m_Localized: 'Jacob: Тоді тобі варто засвоїти от що:'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656004
    m_Localized: 'Jacob: Неправильно кидати людей на порозі смерті.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656005
    m_Localized: 'Jacob: Але я не помру. Ніколи не помру.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656006
    m_Localized: 'Jacob: І ми з тобою ще зустрінемось.'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311552
    m_Localized: 'Fanatic: Ось тобі щедра нагорода від САМОГО Сонцеликого! Ти це заслужив, ЛЮДИНО!'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311553
    m_Localized: 'Fanatic: {0}. Якщо пустиш мене, отримаєш щедру нагороду від самого СОНЦЕЛИКОГО. Ну що, передумав?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283080
    m_Localized: 'MushroomEater: Привіт, юначе. Невже ти не виконав моє прохання? Невже ти не зрозумів натяків зі сторінки «Підручника посмішок»?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283081
    m_Localized: 'MushroomEater: Ех… Значить, я дарма витрачаю свій час…'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283082
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283083
    m_Localized: 'MushroomEater: Прощавай.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336336011264
    m_Localized: 'Gasmask: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205568
    m_Localized: 'Gasmask: У вас нікого немає?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205569
    m_Localized: 'Gasmask: Нелегко вам. І нам. Як перевіряти квартал, якщо людей нема?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205570
    m_Localized: 'Gasmask: Гаразд, до побачення.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177088
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177089
    m_Localized: 'CultistPriest: На знак подяки я міг би запропонувати тобі спасіння…'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177090
    m_Localized: 'CultistPriest: Взяти участь у нашому обряді і знайти спокій. Що скажеш? Вирушиш із нами у священний похід до Смерті?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177091
    m_Localized: Якщо ви так хочете здохнути — будь ласка. А я залишаюсь
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177092
    m_Localized: Я давно хотів знайти спокій… Я йду з вами
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177093
    m_Localized: 'CultistPriest: Що ж, це твій вибір. Смерть рано чи пізно все одно візьме своє.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177094
    m_Localized: 'CultistPriest: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177095
    m_Localized: 'CultistPriest: Прощавай.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371392
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371393
    m_Localized: 'Vigilante: Показуй свої руки.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371394
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371395
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371396
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371397
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371398
    m_Localized: 'Vigilante: Вуха? Які до сраки вуха? Це ніхуя не ознака Гостей!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371399
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371400
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371401
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371402
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371403
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371404
    m_Localized: 'Vigilante: Вуха? Які до сраки вуха? Це ніхуя не ознака Гостей!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371405
    m_Localized: 'Vigilante: Я звалюю звідси.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371406
    m_Localized: 'Vigilante: Більше ти мене не побачиш.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371407
    m_Localized: 'Vigilante: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371408
    m_Localized: 'Vigilante: Бувай здоров.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303872
    m_Localized: 'SuperFake: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303873
    m_Localized: 'SuperFake: Ти чого так напружився? Прямо вчепився у життя.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303874
    m_Localized: 'SuperFake: А що в ньому лишилося важливого? Адже ти залишився один. Без рідні.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303875
    m_Localized: 'SuperFake: Гаразд…'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303876
    m_Localized: 'SuperFake: Ти сам вдома?'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303877
    m_Localized: Так, сам
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303878
    m_Localized: Ні, не сам
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692480
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692481
    m_Localized: 'MushroomEater: …'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306387824640
    m_Localized: 'MushroomEater: О, добрий друже… Це дуже прикро…'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306408796160
    m_Localized: 'MushroomEater: Схоже, фестиваль грибів все ж настає…'
    m_Metadata:
      m_Items: []
  - m_Id: 58250202325180416
    m_Localized: 'TV: Якщо у вас немає можливості одразу здати Гостя до карантинної зони, видайте йому сповіщення щодо явки до КНС.'
    m_Metadata:
      m_Items: []
  - m_Id: 58250202329374720
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 61235008206004224
    m_Localized: Пропустити вступ
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264640
    m_Localized: (Забрати замовлення)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264641
    m_Localized: (Забрати замовлення)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264642
    m_Localized: (Забрати замовлення)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264643
    m_Localized: (Забрати замовлення)
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417792
    m_Localized: 'Unstable: О, привіт! Тут хтось є, це добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417793
    m_Localized: 'Unstable: Я потужно заряджений, але «Енержека» вже якось не бадьорить. Мені б відпочити.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417794
    m_Localized: Ти куди такий заряджений ідеш?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417795
    m_Localized: У мене немає для тебе зарядки
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417796
    m_Localized: 'Unstable: Та подалі, щоб на місці не стояти.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417797
    m_Localized: 'Unstable: Насувається катастрофа, цікаво подивитись, як у різних місцях на неї реагують.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417798
    m_Localized: 'Unstable: Буду йти, доки не підсмажусь або Гості мене не зжеруть.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417799
    m_Localized: А рятуватись не збираєшся?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417800
    m_Localized: Ці пригоди тебе не врятують
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417801
    m_Localized: 'Unstable: Так у мене «Енержека» з собою.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417802
    m_Localized: 'Unstable: Я взяв вдосталь, щоб вистачило. Навіть не питай, де її ховаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417803
    m_Localized: 'Unstable: Ходжу в нічному режимі. Поки сонце не бахне, кудись вже дійду.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417804
    m_Localized: А рятуватись не збираєшся?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417805
    m_Localized: Ці пригоди тебе не врятують
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417806
    m_Localized: 'Unstable: Тобто?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417807
    m_Localized: 'Unstable: Чим більше йду, тим більше шансів щось знайти! Хіба не тямиш?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417808
    m_Localized: 'Unstable: Хто знає, може, у тебе в хаті десь захована остання надія людства.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417809
    m_Localized: 'Unstable: А якби я залишився у своїй квартирі, то не дізнався б про це.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417810
    m_Localized: 'Unstable: І здох би.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417811
    m_Localized: 'Unstable: Самісінький.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417812
    m_Localized: 'Unstable: Воно мені треба?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417813
    m_Localized: І що далі робитимеш?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417814
    m_Localized: Ти від когось тікаєш?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417815
    m_Localized: 'Unstable: Ну, ось ти вдома сидиш, тебе це врятує?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417816
    m_Localized: 'Unstable: Звісно, ти живий, мені от відповідаєш.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417817
    m_Localized: 'Unstable: Але я теж не мертвий! Виходить, ми обидва праві.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417818
    m_Localized: 'Unstable: Можемо обмінятися досвідом з виживання, хех.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417819
    m_Localized: І що далі робитимеш?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417820
    m_Localized: Ти від когось тікаєш?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417821
    m_Localized: 'Unstable: Буду йти.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417822
    m_Localized: 'Unstable: Йтиму, поки щось цікаве не знайду.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417823
    m_Localized: 'Unstable: Ось у тебе, здається, цікаво.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417824
    m_Localized: 'Unstable: Впустиш?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417825
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417826
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417827
    m_Localized: 'Unstable: Ти мене не слухаєш.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417828
    m_Localized: 'Unstable: Кажу ж, просто дивлюся, як люди виживають.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417829
    m_Localized: 'Unstable: Бачив кілька цікавих місць, але в цілому нудно.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417830
    m_Localized: 'Unstable: Або не відкривають, або у паніці стріляють у все, що рухається.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417831
    m_Localized: 'Unstable: Стратегія так собі, якщо чесно.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417832
    m_Localized: 'Unstable: Слухай, я втомився на порозі стояти. Якщо впустиш, розповім ще всякого.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417833
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417834
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417835
    m_Localized: 'Unstable: О, круто!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417836
    m_Localized: 'Unstable: Розкажеш тоді, що в тебе тут цікавого.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417837
    m_Localized: 'Unstable: І я щось вкину. Погутаримо.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417838
    m_Localized: 'Unstable: Облом. Стривай, у мене тут багато всього.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417839
    m_Localized: 'Unstable: «Енержеку» візьмеш? Хоча у мене не тільки вона!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417840
    m_Localized: 'Unstable: Або…. почекай.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417841
    m_Localized: 'Unstable: Коротше, ось {0}. Будеш?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417842
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417843
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417844
    m_Localized: 'Unstable: Опа, у тебе тут {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417845
    m_Localized: 'Unstable: Я з такими людьми нічим ділитись не хочу. Вони всі історії перекручують.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417846
    m_Localized: 'Unstable: Вигадують бозна-що. Ні, давай без такого.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417847
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417848
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417849
    m_Localized: 'Unstable: Ахахах, я навіть не знаю, хто це був.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417850
    m_Localized: 'Unstable: Ти вибач, але я подумав, це буде тупо смішно.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417851
    m_Localized: 'Unstable: Гаразд, зате я тобі стільки розповім!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417852
    m_Localized: 'Unstable: Та без проблем, зганяю ще кудись.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417853
    m_Localized: 'Unstable: Я чув, там хтось повітря холодне продає. Оце ржака!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417854
    m_Localized: 'Unstable: Цікаво, чи багато він заробив на такому фуфлі.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417855
    m_Localized: 'Unstable: Давай, побачимось.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417856
    m_Localized: 'Unstable: Зануда. Знову якась фігня.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417857
    m_Localized: 'Unstable: Гаразд, гляну, що цікавого відбувається у інших.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417858
    m_Localized: 'Unstable: Чув історії про якогось психа, який набирає до себе всяких людей, промиває їм мізки.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417859
    m_Localized: 'Unstable: А потім спалює к бісовій матері!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417860
    m_Localized: 'Unstable: Цікаво, спробую до них податися.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417861
    m_Localized: 'Rocker: Чувак, відкрий. Сонце їбашить, як прожектор на репетиції, я так скоро, бляха, осліпну.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417862
    m_Localized: 'Rocker: Дай сховатися на пару ночей, я не збираюся тут зависати навічно. Я не якийсь… еее, як їх там називають?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417863
    m_Localized: 'Rocker: А, не дармоїд, от.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417864
    m_Localized: 'Rocker: А то надворі зараз повна срака, ніби купу людей загнали у крихітну концертну залу, та ще без довбаного вентилятора!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417865
    m_Localized: Що в тебе з собою?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417866
    m_Localized: Чому ти виглядаєш так, ніби не спав тиждень?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417867
    m_Localized: 'Rocker: Нічого небезпечного, тільки сумка з міні-комбіком та пара пляшок води. Якщо на гітарі теребонькаєш, можу дати комбік поганяти.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417868
    m_Localized: 'Rocker: Я чув, що у висотці десь поруч Гостя знайшли, тому тепер дуже жорстко всіх перевіряють. Я не проти, тільки щоб без істерик.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417869
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417870
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417871
    m_Localized: 'Rocker: Бо я й не спав.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417872
    m_Localized: 'Rocker: Репав до світанку, а потім нашу точку накрили якісь психи. Почали все пиздити, ми з ними побилися.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417873
    m_Localized: 'Rocker: Суки мою гітару зламали! Люди через всю цю хрінь, бляха, звіріють.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417874
    m_Localized: 'Rocker: Та й взагалі, якби я був Гостем, то вже б двері виламував чи у вікно б заліз. А я тут, бач, спокійно дихаю та розмовляю.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417875
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417876
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417877
    m_Localized: 'Rocker: Дякую, чувак. Я іноді музло врубатиму, тобі це ок? Якщо роздобуду гітару, то зіграю тобі щось!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417878
    m_Localized: 'Rocker: Чи не хочеш? Ну, діло хазяйське!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417879
    m_Localized: 'Rocker: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417880
    m_Localized: 'Rocker: Зрозумів тебе, брате. Без образ.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417881
    m_Localized: 'Rocker: Піду спробую у когось із друзів перекантуватись. Сподіваюся, ті, хто залишився, ще дуба не дали…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417882
    m_Localized: 'Rocker: Ні, я з такими людьми в одному полі срати не сяду.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417883
    m_Localized: 'Rocker: Та {0}, ось я про кого. Нехай котиться під три чорти, га?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417884
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417885
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417886
    m_Localized: 'Rocker: О, навалимо джазу тепер!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417887
    m_Localized: 'Rocker: Без гітари, правда, щось не того…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417888
    m_Localized: 'Rocker: Гаразд. Пофігу.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417889
    m_Localized: 'Rocker: Не ти, то хтось інший пустить.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417890
    m_Localized: 'Experienced: Вечір в хату. Пустиш, фраер?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417891
    m_Localized: А ти чого в самих трусах?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417892
    m_Localized: Ти звідки такий взявся?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417893
    m_Localized: 'Experienced: Та жарить, як у чорта в дупі. Хрін його знає, чому інші до цього не дотумкали.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417894
    m_Localized: 'Experienced: Ходять скрізь у светрах та куртках, і всім посрати.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417895
    m_Localized: 'Experienced: Але я ж головатий — як вийшов на волю, зняв з себе всі манатки, і тепер все в ажурі.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417896
    m_Localized: А до мене якого бісового батька приперся?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417897
    m_Localized: А чого на зоні не лишився?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417898
    m_Localized: 'Experienced: Та я на зоні чалився, фраер.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417899
    m_Localized: 'Experienced: Я б і далі сидів, та ось тільки-но випустили.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417900
    m_Localized: 'Experienced: А тут повний кабздець! Всюди шамотня, сонце, сука, наче очманіло…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417901
    m_Localized: 'Experienced: Ось тепер і тусуюся на вулиці.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417902
    m_Localized: А до мене якого бісового батька приперся?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417903
    m_Localized: А чого на зоні не лишився?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417904
    m_Localized: 'Experienced: Та нема куди мені йти, фраер.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417905
    m_Localized: 'Experienced: Бабок нема, жінка давно вже за іншого хахаля пішла, приткнутись нема де.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417906
    m_Localized: 'Experienced: А тут бац, дивлюсь, хата що треба.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417907
    m_Localized: 'Experienced: На відчепі, подалі від усіх, всяка шпана сюди не полізе. Гарне місце.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417908
    m_Localized: 'Experienced: Гаразд, годі язиком верзти. Даси перекантуватися, фраер?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417909
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417910
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417911
    m_Localized: 'Experienced: Та я б лишився. Але думаєш, мене хтось питав?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417912
    m_Localized: 'Experienced: Строк відмотав — і все, на волю.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417913
    m_Localized: 'Experienced: Бабок нема, жінка давно вже за іншого хахаля пішла, приткнутись нема де.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417914
    m_Localized: 'Experienced: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417915
    m_Localized: 'Experienced: Гаразд, годі язиком верзти. Даси перекантуватися, фраер?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417916
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417917
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417918
    m_Localized: 'Experienced: О, ніштяк!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417919
    m_Localized: 'Experienced: Оце ти, звісно, фуфел.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417920
    m_Localized: 'Experienced: Чао, редиска.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417921
    m_Localized: 'Experienced: Фраер, та в тебе тут задрипанці сидять.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417922
    m_Localized: 'Experienced: Мені от не до вподоби {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417923
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417924
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417925
    m_Localized: 'Experienced: Молоток, фраер. Я знав, що ти чіткий пацанчик.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417926
    m_Localized: 'Jacket: Вітаю. Пустіть до себе, будь ласка.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417927
    m_Localized: Що тобі треба?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417928
    m_Localized: Притулок шукаєш?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417929
    m_Localized: 'Jacket: Потрібно десь сховатися. Мені більше нема де жити.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417930
    m_Localized: 'Jacket: А вертатися до гуртожитку вже не варіант…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417931
    m_Localized: Чому?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417932
    m_Localized: І що ж сталося у твоєму гуртожитку?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417933
    m_Localized: 'Jacket: Так. Якщо можете, пустіть, будь ласка.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417934
    m_Localized: 'Jacket: Я з гуртожитку, але довелося піти звідти…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417935
    m_Localized: Чому?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417936
    m_Localized: І що ж сталося у твоєму гуртожитку?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417937
    m_Localized: 'Jacket: КНС-ники…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417938
    m_Localized: 'Jacket: Вони почали забирати звідти людей. А я…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417939
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417940
    m_Localized: 'Jacket: Я дуже не хочу опинитись у карантинній зони.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417941
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417942
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417943
    m_Localized: 'Jacket: КНС-ники…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417944
    m_Localized: 'Jacket: Вони з''явились і сказали, що повинні перевірити всіх мешканців.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417945
    m_Localized: 'Jacket: Але як пішла чутка, що заражених забирають до карантинних зон…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417946
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417947
    m_Localized: 'Jacket: Я не хочу там опинитись.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417948
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417949
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417950
    m_Localized: 'Jacket: Дуже вам дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417951
    m_Localized: 'Jacket: Ось, у мене є {0}. Це небагато, але, сподіваюся, стане в пригоді.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417952
    m_Localized: 'Jacket: Ні, будь ласка, впустіть.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417953
    m_Localized: 'Jacket: Я не хочу натрапити на патруль чи ще гірше — на Гостей.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417954
    m_Localized: 'Jacket: Якщо треба, є {0}. Вас це влаштує?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417955
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417956
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417957
    m_Localized: 'Jacket: О… Вибачте, але у вас {0}. Я не дуже довіряю таким людям…'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417958
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417959
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417960
    m_Localized: 'Jacket: Дуже вам дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417961
    m_Localized: 'Jacket: Ось, у мене є {0}. Це небагато, але, сподіваюся, стане в пригоді.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346842873856
    m_Localized: 'Tough: Я багато чула про тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039680
    m_Localized: 'Tough: Більшість людей тримаються від твого дома подалі.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039681
    m_Localized: 'Tough: Заходять сюди або зневірені, або не дуже розумні.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039682
    m_Localized: 'Tough: Але я тебе поважаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039683
    m_Localized: Дякую?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039684
    m_Localized: Що розповідають про мій дім?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039685
    m_Localized: 'Tough: Ні, правда.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039686
    m_Localized: 'Tough: Я бачила багато людей, які здалися. Не готові жити далі.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039687
    m_Localized: 'Tough: Хтось вбиває себе. Хтось просто повільно вмирає, безсилий щось зробити.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039688
    m_Localized: 'Tough: Але ти… Ти себе в образу не даси.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039689
    m_Localized: А ти теж зневірена?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039690
    m_Localized: Ти говориш як маніяк
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039691
    m_Localized: 'Tough: Що тут непросто вижити.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039692
    m_Localized: 'Tough: Що ТИ не дозволяєш Гостям забрати те, що твоє по праву. Життя.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039693
    m_Localized: 'Tough: Я не могла обминути таке місце. Тож, сподіваюсь, нам вдасться порозумітися.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039694
    m_Localized: 'Tough: Треба вижити будь-якою ціною.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039695
    m_Localized: А ти теж зневірена?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039696
    m_Localized: Ти говориш як маніяк
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039697
    m_Localized: 'Tough: Що?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039698
    m_Localized: 'Tough: А, ти про те, чому я прийшла сюди? Хахаха, хтозна. Може, я божевільна.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039699
    m_Localized: 'Tough: Але точно не зневірилася.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039700
    m_Localized: 'Tough: Це не перша катастрофа для людей. Чому ми маємо просто лягти та померти?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039701
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039702
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039703
    m_Localized: 'Tough: А, вибач, якщо створила таке враження.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039704
    m_Localized: 'Tough: Я просто щиро думаю, якщо ми всі попливемо за течією, то людство не матиме майбутнього.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039705
    m_Localized: 'Tough: Ми виживаємо лише тоді, коли прикладаємо хоч якісь зусилля.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039706
    m_Localized: 'Tough: Жити — це робити все всупереч. Нічого не дається просто так.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039707
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039708
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039709
    m_Localized: 'Tough: Чудово. Дякую!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039710
    m_Localized: 'Tough: Знаєш, це для мене честь. Опинитися тут, коли життя летить шкереберть.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039711
    m_Localized: 'Tough: Буду рада обмінятися парою слів.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039712
    m_Localized: 'Tough: Це перевірка?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039713
    m_Localized: 'Tough: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039714
    m_Localized: 'Tough: Ні?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039715
    m_Localized: 'Tough: Що ж, нічого іншого не очікувала.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039716
    m_Localized: 'Tough: От же…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039717
    m_Localized: 'Tough: Гандон.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039718
    m_Localized: 'Bald: Вітаю, брате!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039719
    m_Localized: 'Bald: Можна розміститись у тебе? А то всіх друзів чи вдома немає, чи вигнали до біса, чи ще щось.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039720
    m_Localized: 'Bald: Думав, у мене повно друзів, якось разом упораємось, але, як бачиш, доводиться йти до незнайомців.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039721
    m_Localized: 'Bald: Раніше я з мамою та бабусею разом жив, та нас колектори вигнали з квартири. Просто срака. Якщо впустиш, якось розповім.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039722
    m_Localized: Це хіба друзі?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039723
    m_Localized: Тобто тебе шукають колектори?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039724
    m_Localized: 'Bald: Та всі театральні. Ми разом тусили, разом бухали.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039725
    m_Localized: 'Bald: Хлопці були добрі, завжди підтримували, готові були впустити на ніч, пригостити.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039726
    m_Localized: 'Bald: Ось тільки зараз ні до кого з них не додзвонитись. У кожного якась фігня раптом сталась.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039727
    m_Localized: 'Bald: Та ще й це сонце. Словом, все не слава Богу…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039728
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039729
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039730
    m_Localized: 'Bald: Ні, брате, не за мною.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039731
    m_Localized: 'Bald: За мамою моєю.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039732
    m_Localized: 'Bald: Розумієш, вона мене захистити хотіла, тому нічого не розповідала.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039733
    m_Localized: 'Bald: Але я тобі клопоту не завдам. Все розповім, тільки впусти мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039734
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039735
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039736
    m_Localized: 'Bald: Бляха, брате, оце врятував так врятував.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039737
    m_Localized: 'Bald: Ти підійди до мене, як буде час. У мене стільки шалених історій буде, що ти сам ошалієш, хахах.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039738
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039739
    m_Localized: 'Bald: Гаразд, брате. Я все розумію. Зла не триматиму.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039740
    m_Localized: 'Bald: Нехай тобі пощастить протриматися в цьому сраному безладі!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039741
    m_Localized: 'Nervous: Привіт, хі-хі.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039742
    m_Localized: 'Nervous: Вибач, я щось трохи на нервах.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039743
    m_Localized: 'Nervous: Я зупинився в готелі «Надія», але вирішив прогулятись.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039744
    m_Localized: 'Nervous: Повр-тися страшнувато, можна я залишусь тут?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039745
    m_Localized: Навіщо? Вертайся у готель
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039746
    m_Localized: Тут краще, ніж у готелі?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039747
    m_Localized: 'Nervous: Та я б к-краще пошукав інше місце.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039748
    m_Localized: 'Nervous: Готель сам по собі хороший, але там живе дівчинка у жовтому дощовику.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039749
    m_Localized: 'Nervous: Вона мене лякає, хі-хі.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039750
    m_Localized: 'Nervous: Не можу довести, але здається, вона — Гість.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039751
    m_Localized: 'Nervous: КНС якось приїжджали, та більше я їх не бачив…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039752
    m_Localized: Чого до рідних не підеш?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039753
    m_Localized: Ти не маєш тут друзів?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039754
    m_Localized: 'Nervous: Там, звсно, непогано, але що як тут мені буде безпечніше, хі-хі.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039755
    m_Localized: 'Nervous: Будинок просторий, всі вліземо.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039756
    m_Localized: 'Nervous: А в готелі кімнатки маленькі. Та ще й н-гадують про неприємні часи.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039757
    m_Localized: 'Nervous: Про це якось потім розповім, хі-хі.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039758
    m_Localized: Чого до рідних не підеш?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039759
    m_Localized: Ти не маєш тут друзів?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039760
    m_Localized: 'Nervous: Вони мене не хотіли. Я випадково у них вийшов, хі-хі.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039761
    m_Localized: 'Nervous: Так що їм просто насрати.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039762
    m_Localized: 'Nervous: Одного разу вони допомогли, але все одно я до них не хочу.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039763
    m_Localized: 'Nervous: Тоді краще назад до готелю.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039764
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039765
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039766
    m_Localized: 'Nervous: Та які друзі…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039767
    m_Localized: 'Nervous: Ще зі школи з мене знущаються всякі кретини.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039768
    m_Localized: 'Nervous: Один дістав по заслузі, але я тепер обережніший.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039769
    m_Localized: 'Nervous: Вже простіше спробувати порозумітися з новими людьми, хі-хі.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039770
    m_Localized: 'Nervous: Тим більше, я чув неподалік постріли. Може, тут краще слідкують за безпекою.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039771
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039772
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039773
    m_Localized: 'Nervous: О, це прсто чудово!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039774
    m_Localized: 'Nervous: Нарешті можна десь спокійно перечекати цю катастрофу.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039775
    m_Localized: 'Nervous: Що, ти теж вважаєш мене якимсь не таким?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039776
    m_Localized: 'Nervous: Шизанутим?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039777
    m_Localized: 'Nervous: Ти нічим не кращий за тих катів у білих халатах.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039778
    m_Localized: 'Nervous: Нічого. Ще подивимось, як ти тут закінчиш.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039779
    m_Localized: 'Nervous: Хі-хі.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039780
    m_Localized: 'Leper: Привіт. Сподіваюсь, я не занадто налякав? Впустиш?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039781
    m_Localized: Є привід лякатись?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039782
    m_Localized: Що у тебе зі шкірою?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039783
    m_Localized: 'Leper: У тому й річ, що немає.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039784
    m_Localized: 'Leper: У мене дефекти шкіри з нарождення, ось і все…'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039785
    m_Localized: 'Leper: Вважають тепер мене якимось прокаженим — мовляв, я Гість.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039786
    m_Localized: Зараз у всіх параноя
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039787
    m_Localized: Ти чекав чогось іншого?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039788
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039789
    m_Localized: 'Leper: Ось про це я й кажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039790
    m_Localized: 'Leper: Це вроджене, тут нічого не вдієш. І чомусь усі вважають, що я Гість. Маячня.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039791
    m_Localized: Зараз у всіх параноя
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039792
    m_Localized: Ти чекав чогось іншого?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039793
    m_Localized: 'Leper: Розумію, але я не Гість.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039794
    m_Localized: Це ми ще побачимо
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039795
    m_Localized: Чому така впевненість?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039796
    m_Localized: 'Leper: Що значить «чекав чогось іншого»? Я що, навмисно таким народився?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039797
    m_Localized: 'Leper: Кажу тобі, я не Гість.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039798
    m_Localized: Це ми ще побачимо
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039799
    m_Localized: Чому така впевненість?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039800
    m_Localized: 'Leper: Як скажеш.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039801
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039802
    m_Localized: 'Leper: Гаразд, то ти мене все-таки пустиш чи ні?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039803
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039804
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039805
    m_Localized: 'Leper: Бо я знаю, що це так. Я не один з них.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039806
    m_Localized: 'Leper: …'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039807
    m_Localized: 'Leper: Гаразд, то ти мене все-таки пустиш чи ні?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039808
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039809
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039810
    m_Localized: 'Leper: Дякую, що пустив, не зважаючи на зовнішність.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039811
    m_Localized: 'Leper: Гаразд, як скажеш. Я пішов.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722816
    m_Localized: 'Fairytaller: Доброго вечора. Чи не знайдеться у вас ще вільного містечка? Мені багато не треба.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722817
    m_Localized: Що тебе привело сюди?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722818
    m_Localized: Звідки мені знати, що ти не Гість?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722819
    m_Localized: 'Fairytaller: Я тільки закінчив універ цього літа. Роботу за фахом знайти непросто. Тому влаштувався на підробіток у кафе.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722820
    m_Localized: 'Fairytaller: Але після останніх подій люди перестали ходити до нас, і всіх працівників скоротили.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722821
    m_Localized: 'Fairytaller: А колишнім одногрупникам, хто влаштувався в нічні клуби, пощастило. Вони тільки краще зажили.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722822
    m_Localized: 'Fairytaller: У кризу людям завжди хочеться забути про проблеми, відчути безтурботність хоча б на деякий час.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722823
    m_Localized: 'Fairytaller: Як у дитинстві.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722824
    m_Localized: 'Fairytaller: Мені орендодавець спочатку не хотів здавати квартиру, бо я випускник без постійного прибутку.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722825
    m_Localized: 'Fairytaller: А після цих подій вигнав під приводом, що у мене нема роботи, і заселив своїх зведених родичів.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722826
    m_Localized: 'Fairytaller: Загалом зрозуміти його можна. Прошу тільки зрозуміти й мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722827
    m_Localized: 'Fairytaller: Мені самому не подобається висіти у когось на шиї, але у скрутну годину потрібно якось виживати.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722828
    m_Localized: 'Fairytaller: Я постараюся бути корисним, поки не стану на ноги. І обов''язково відплачу за доброту пізніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722829
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722830
    m_Localized: Мені нахлібники не потрібні. Іди геть
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722831
    m_Localized: 'Fairytaller: Я сам до кінця не зрозумів, хто такі Гості та чим конкретно вони відрізняються від людей.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722832
    m_Localized: 'Fairytaller: Можливо, за якимись ознаками я Гість. Не знаю. Останнім часом все так дивно.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722833
    m_Localized: 'Fairytaller: Але начебто я така сама людина, як і завжди. Як мінімум, не прагну нікого вбивати. Хе-хе.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722834
    m_Localized: 'Fairytaller: Чимось це навіть нагадує дитячі казки. Де є зло, яке захоплює світ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722835
    m_Localized: 'Fairytaller: Всі люди бояться, ховаються у себе вдома, не довіряють один одному.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722836
    m_Localized: 'Fairytaller: От би і в нашому світі знайшовся герой, який переможе зло, і все стане, як раніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722837
    m_Localized: 'Fairytaller: Сумніваюся, що я той самий герой, але все ж таки попрошу у вас притулку на цей тяжкий час. У всіх історіях добро перемагає.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722838
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722839
    m_Localized: Мені нахлібники не потрібні. Іди геть
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722840
    m_Localized: 'Fairytaller: Що ж. Розумію ваше рішення.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722841
    m_Localized: 'Fairytaller: Знаю, мені нема чого дати вам. Але подумайте, будь ласка, ще раз.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722842
    m_Localized: 'Fairytaller: Я обов''язково відплачу у майбутньому. І зараз допоможу чим зможу.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722843
    m_Localized: 'Fairytaller: Мені зовсім нема куди йти. Хто знав, що доросле життя почнеться так важко. Хоч би воно не закінчилося так скоро.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722844
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722845
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722846
    m_Localized: 'Fairytaller: Дуже вам вдячний! Я в боргу не залишусь!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722847
    m_Localized: 'Fairytaller: Добре, що хороші люди є не лише у казках, а і в реальному світі.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722848
    m_Localized: 'Fairytaller: Що ж. Розумію. На все добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722849
    m_Localized: 'FunnyGuy: Хе-е-ей, здоров був!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722850
    m_Localized: 'FunnyGuy: Оце чарівна ніч, скажи? Відчуваєш?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722851
    m_Localized: Ти їбанувся чи що?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722852
    m_Localized: Чого такий радісний?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722853
    m_Localized: 'FunnyGuy: Та ну, годі сваритися! Ти просто не зрозумів.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722854
    m_Localized: 'FunnyGuy: Друже… ні, брате! Іпотека для мене більше не біда!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722855
    m_Localized: 'FunnyGuy: Як стало вільніше дихати, якби ти знав.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722856
    m_Localized: А… тут ти що робиш?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722857
    m_Localized: І що робитимеш із врятованим багатством?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722858
    m_Localized: 'FunnyGuy: Я вже наче був у фінансовій дупі.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722859
    m_Localized: 'FunnyGuy: Ну просто все, знаєш, було не дуже.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722860
    m_Localized: 'FunnyGuy: АЛЕ ТЕПЕР!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722861
    m_Localized: 'FunnyGuy: Тепер у мене немає боргу!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722862
    m_Localized: 'FunnyGuy: З цим катаклізмом людям вже посрати на всі ці фінанси, банки, кредити.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722863
    m_Localized: 'FunnyGuy: І це чудово!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722864
    m_Localized: А… тут ти що робиш?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722865
    m_Localized: І що робитимеш із врятованим багатством?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722866
    m_Localized: 'FunnyGuy: Бляха, а це гарне питання.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722867
    m_Localized: 'FunnyGuy: Не хочу на вулиці говорити, якщо чесно.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722868
    m_Localized: 'FunnyGuy: Без образ.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722869
    m_Localized: Щось ти малоговіркий
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722870
    m_Localized: 'FunnyGuy: Слухай, ну це вже надто саркастично.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722871
    m_Localized: 'FunnyGuy: Чесно, мені таке не подобається.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722872
    m_Localized: Щось ти малоговіркий
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722873
    m_Localized: 'FunnyGuy: Ну а чого ти, бляха, не радий за мене?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722874
    m_Localized: 'FunnyGuy: Хоча зрозуміло, не твоя ж іпотека. У тебе он свої хороми.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722875
    m_Localized: 'FunnyGuy: Будь у мене такий будиночок, я б теж, звісно, жив як мед пив.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722876
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722877
    m_Localized: 'FunnyGuy: То що, впустиш?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722878
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722879
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722880
    m_Localized: 'FunnyGuy: О-о-о-о, відсвяткуємо разом, га?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722881
    m_Localized: 'FunnyGuy: Для мене це таке свято, ти б знав!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722882
    m_Localized: 'FunnyGuy: Що, взагалі без варіантів?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722883
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722884
    m_Localized: 'FunnyGuy: Бля.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722885
    m_Localized: 'FunnyGuy: Ну, щось придумаю, ще час є до світанку.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722886
    m_Localized: 'Alt: О, тут таки хтось є. Можна увійти?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722887
    m_Localized: Чому тут нікого не має бути?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722888
    m_Localized: Оце ти жвава. Куди ломишся?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722889
    m_Localized: 'Alt: Ні, я не мала на увазі, що дім виглядає покинутим.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722890
    m_Localized: 'Alt: Я просто чула, що на околицях коїться справжнє пекелище.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722891
    m_Localized: 'Alt: І не лише у нашому місті так.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722892
    m_Localized: 'Alt: Мало неприємностей з маніяками та Гостями, так ще сонце дає прочухана.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722893
    m_Localized: Від чого біжиш?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722894
    m_Localized: Думаєш, тут буде спокійніше?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722895
    m_Localized: 'Alt: Чого так грубо?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722896
    m_Localized: 'Alt: Я ніякого зла не вчинила. І засуджуючих поглядів також не треба. Якщо ви там раптом їх кидаєте.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722897
    m_Localized: 'Alt: Моя зовнішність не заважає роботі. І я не бажаю зла нікому. Сподіваюся, ви не судитимете лише за зовнішністю.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722898
    m_Localized: Від чого біжиш?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722899
    m_Localized: Думаєш, тут буде спокійніше?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722900
    m_Localized: 'Alt: З чого ви взяли, що я біжу від чогось?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722901
    m_Localized: 'Alt: Ми можемо на «ти» перейти? Для зручності.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722902
    m_Localized: 'Alt: Я здогадуюсь, що зараз у містах буде небезпечно.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722903
    m_Localized: 'Alt: І щодалі стає страшніше. Дихати нема чим. Злочинність зростає. Параної в багатоповерхівках все більше.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722904
    m_Localized: 'Alt: Я думаю, попереду нас чекає ще те шоу.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722905
    m_Localized: 'Alt: І не хочеться бути в перших рядах, коли раптом що станеться.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722906
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722907
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722908
    m_Localized: 'Alt: Ми можемо на «ти» перейти? Для зручності.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722909
    m_Localized: 'Alt: Звісно.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722910
    m_Localized: 'Alt: Тут хоча б ночами повітря встигає охолонути. І ніхто не дивиться цілодобово новини.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722911
    m_Localized: 'Alt: Не знаю, чи є у тебе світло, але якщо ні — навіть краще.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722912
    m_Localized: 'Alt: Від перегляду телека легше не стає.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722913
    m_Localized: 'Alt: Найстрашніше, коли розумієш, що весь жах з чергового випуску новин треба множити на п''ять чи навіть на десять.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722914
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722915
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722916
    m_Localized: 'Alt: Добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722917
    m_Localized: 'Alt: Тоді поговоримо вдень, я вже дуже втомилася сьогодні.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722918
    m_Localized: 'Alt: Це був суперважкий тиждень.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722919
    m_Localized: 'Alt: Загалом тут є ще будинки. Може, хтось не подивиться на мою зовнішність і вчинить по-людськи.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722920
    m_Localized: 'Alt: Гаразд, треба поспішати.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722921
    m_Localized: 'Tourist: Привіт. Можете мені допомогти? Я не тутешній.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722922
    m_Localized: А в чому річ?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722923
    m_Localized: Ти як взагалі тут опинився?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722924
    m_Localized: 'Tourist: Виникла помилка, і я не можу виїхати з міста.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722925
    m_Localized: 'Tourist: Аеропорти більше не працюють, потяги не ходять.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722926
    m_Localized: Невдалий час ти вибрав для туризму
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722927
    m_Localized: І тобі от зовсім нема куди поїхати?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722928
    m_Localized: 'Tourist: Я їхав до столиці потягом, планував подорож…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722929
    m_Localized: 'Tourist: А потім кордони закрили, і я тепер не можу вибратися.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722930
    m_Localized: 'Tourist: Вважайте, я тут взагалі проїздом.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722931
    m_Localized: Невдалий час ти вибрав для туризму
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722932
    m_Localized: І тобі от зовсім нема куди поїхати?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722933
    m_Localized: 'Tourist: Та я вже зрозумів. Повірте, якби я знав, що трапиться з сонцем, то нізащо б не поїхав.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722934
    m_Localized: 'Tourist: Але я вже тут, а на готель не маю грошей. Прошу, дозвольте пожити у вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722935
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722936
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722937
    m_Localized: 'Tourist: Ні…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722938
    m_Localized: 'Tourist: Я жив деякий час у готелі, але гроші скінчилися.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722939
    m_Localized: 'Tourist: Тепер не знаю, куди мені податися.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722940
    m_Localized: 'Tourist: Прошу, дозвольте пожити у вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722941
    m_Localized: Проходь
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722942
    m_Localized: Тобі краще піти
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722943
    m_Localized: 'Tourist: Дуже вдячний.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722944
    m_Localized: 'Tourist: Чорт, а куди мені ще піти? Я всі будинки навколо обійшов…'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722945
    m_Localized: 'Tourist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722946
    m_Localized: 'Tourist: Дуже шкода, що ви не допоможете.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769344
    m_Localized: 'Jacket: Чорт, мене ж знайдуть КНС…'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769345
    m_Localized: 'Jacket: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769346
    m_Localized: 'Jacket: Гаразд, я краще піду.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769347
    m_Localized: 'Tough: Хто це у тебе тут, {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769348
    m_Localized: 'Tough: Давай без цієї людини. Або я почекаю десь, поки тут не стане вільніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769349
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769350
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769351
    m_Localized: 'Tough: Дякую. Не думала, що підеш мені назустріч.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769352
    m_Localized: 'Tough: Мабуть, цей мешканець слабкий духом, якщо ти так легко його викинув.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769353
    m_Localized: 'Tough: Та якого біса? Я думала, ти теж поважаєш рішучість. Жагу до життя.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769354
    m_Localized: 'Tough: А в тобі такого нема?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769355
    m_Localized: 'Tough: Це… розчаровує.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769356
    m_Localized: 'Bald: Брате, от їй-богу, я можу порозумітися будь з ким. Але тут буде тяжко. Всі червоні прапорці одразу видно.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769357
    m_Localized: 'Bald: Ну тобто, тут у тебе {0}. Може, якось витуримо?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769358
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769359
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769360
    m_Localized: 'Bald: Звісно, незручно просто виганяти людину. Але життя таке. Деколи стає не до чемності.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769361
    m_Localized: 'Bald: Бляха.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769362
    m_Localized: 'Bald: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769363
    m_Localized: 'Bald: Гаразд, брате. Я все розумію. Зла не триматиму.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769364
    m_Localized: 'Bald: Нехай тобі пощастить протриматися в цьому сраному безладі!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769365
    m_Localized: 'Nervous: Ох, тут є {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769366
    m_Localized: 'Nervous: Я знаю, що трапилось місяць тому.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769367
    m_Localized: 'Nervous: Це дуже дивна людина.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769368
    m_Localized: 'Nervous: Я бачив…'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769369
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769370
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769371
    m_Localized: 'Nervous: Оце ти правильно зробив.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769372
    m_Localized: 'Nervous: Знаю, звучить дивно. Але мені все одно.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769373
    m_Localized: 'Nervous: Буде знати, як займатися дивними справами.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769374
    m_Localized: 'Nervous: Серйозно?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769375
    m_Localized: 'Nervous: Може, навіть добре, що я до тебе не потраплю.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769376
    m_Localized: 'Nervous: Якщо набираєш собі таких мудаків, навряд чи сам кращий за них.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769377
    m_Localized: 'Leper: Пробач, але я, мабуть, не зможу зайти.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769378
    m_Localized: 'Leper: Тут вже є {0}. Саме ця людина з мене знущалась за мій вигляд.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769379
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769380
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769381
    m_Localized: 'Leper: Дякую. Мені правда не хочеться, щоб мене знову на глузи брали.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769382
    m_Localized: 'Leper: Ти вважаєш, що люди, які знущаються з інших, заслуговують на місце у тебе в хаті?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157952
    m_Localized: 'Leper: Втім, твоя справа. Тоді я пішов.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157953
    m_Localized: 'Leper: Гаразд, а якщо я тобі щось дам? Ось, наприклад, {0}. Тоді пустиш?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157954
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157955
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157956
    m_Localized: 'Fairytaller: Дякую! Але… Здається, у вас тут є дехто, з ким у нас був конфлікт, поки я недовго працював у кафе.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157957
    m_Localized: 'Fairytaller: І я досі вважаю, що то була не моя провина.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157958
    m_Localized: 'Fairytaller: Розумію, що витратив багато вашого часу і напросився до вас.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157959
    m_Localized: 'Fairytaller: Але боюся, що мені буде некомфортно, поки {0} є зі мною в одному приміщенні.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157960
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157961
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157962
    m_Localized: 'Fairytaller: Що? Дякую! Але не варто було так жорстоко поводитись з мешканцем… Я б міг знайти інше місце.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157963
    m_Localized: 'Fairytaller: Але дуже вдячний за довіру!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157964
    m_Localized: 'Fairytaller: Що ж. Розумію. На все добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157965
    m_Localized: 'FunnyGuy: Так, ні, у тебе тут чувак, який зіпсує всю малину.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157966
    m_Localized: 'FunnyGuy: Та ось, бачиш, {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157967
    m_Localized: 'FunnyGuy: У моєму житті тухляка вже вистачило. Давай хоч тут обійдемося?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157968
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157969
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157970
    m_Localized: 'FunnyGuy: Оце інша справа!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157971
    m_Localized: 'FunnyGuy: Відсвяткуємо закриття моєї іпотеки, га? Ахахахах!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157972
    m_Localized: 'FunnyGuy: Ех. Зрозумів тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157973
    m_Localized: 'FunnyGuy: Ну, я тоді піду. Ще встигну до світанку щось знайти.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157974
    m_Localized: 'FunnyGuy: Ось ти мені нагадуєш ці самі банки. Та йопт.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157975
    m_Localized: 'FunnyGuy: Гаразд. Востаннє ведуся на це.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157976
    m_Localized: 'FunnyGuy: Давай я тобі дам… що тут?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157977
    m_Localized: 'FunnyGuy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157978
    m_Localized: 'FunnyGuy: Ось що знайшов — {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157979
    m_Localized: 'FunnyGuy: Вирішимо питання?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157980
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157981
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157982
    m_Localized: 'Alt: Опа, тут {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157983
    m_Localized: 'Alt: Це довга історія, і я точно не готова все тут вивалювати.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157984
    m_Localized: 'Alt: Але в одній кімнаті ти нас не побачиш.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157985
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157986
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157987
    m_Localized: 'Alt: Спасибі. Не чекала, але дуже сподівалася.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157988
    m_Localized: 'Alt: Що ж.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157989
    m_Localized: 'Alt: Час є, знайду інший варіант.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157990
    m_Localized: 'Alt: Шкода, що мудакам щастить.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157991
    m_Localized: 'Alt: Я звикла до такого підходу. І розумію, до чого ти хилиш.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157992
    m_Localized: 'Alt: Добре. {0} підійде?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157993
    m_Localized: 'Alt: Тепер ми домовились?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157994
    m_Localized: Гаразд, заходь
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157995
    m_Localized: Хабарів не беру
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157996
    m_Localized: 'Tourist: Вибачте, шановний, але боюсь, я поки не можу зайти.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157997
    m_Localized: 'Tourist: Тут знаходиться {0}. Я не впевнений, що ми порозуміємось.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157998
    m_Localized: Зараз прожену. Заходь
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157999
    m_Localized: Краще йди звідси
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158000
    m_Localized: 'Tourist: Дуже дякую вам.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158001
    m_Localized: 'Tourist: Ну що ж… Дуже шкода.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908999
    m_Localized:
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
