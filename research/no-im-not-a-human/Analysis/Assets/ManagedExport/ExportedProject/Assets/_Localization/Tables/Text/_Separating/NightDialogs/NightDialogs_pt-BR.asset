%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NightDialogs_pt-BR
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: e2adf5c0928e69a42a85516c84d58249, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16038821089280
    m_Localized: 'Firefighter: Ei. *cof cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672192
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672193
    m_Localized: 'Firefighter: Você pode me deixar entrar, amigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672194
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672195
    m_Localized: O que aconteceu com você?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672196
    m_Localized: 'Firefighter: Eu sou *cof* um bombeiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672197
    m_Localized: 'Firefighter: O sol me pegou enquanto apagávamos incêndios na floresta hoje.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672198
    m_Localized: 'Firefighter: A fumaça densa ajuda a gente a não virar churrasco, mas *cof* ainda dá medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672199
    m_Localized: 'Firefighter: As árvores... *cof cof* Queimaram como palitos de fósforo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672200
    m_Localized: 'Firefighter: Nunca vi nada igual.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672201
    m_Localized: 'Firefighter: Carcaças de animais ainda em chamas por toda a floresta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672202
    m_Localized: Por que você não está no hospital?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672203
    m_Localized: O que você vai fazer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672204
    m_Localized: 'Firefighter: Fui pego pelo sol da tarde *cof cof* enquanto apagava incêndios na mata.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672205
    m_Localized: 'Firefighter: Sou o único que sobrou do meu esquadrão.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672206
    m_Localized: 'Firefighter: Os outros, eles... *cof* O chefe simplesmente não deixou ninguém sair.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672207
    m_Localized: 'Firefighter: Agora estão em plantão eterno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672208
    m_Localized: Por que você não está no hospital?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672209
    m_Localized: O que você vai fazer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672210
    m_Localized: 'Firefighter: O hospital? Não existem mais hospitais, cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672211
    m_Localized: 'Firefighter: Quando os Visitantes chegaram, hospitais deixaram de fazer sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672212
    m_Localized: 'Firefighter: É difícil ser tratado quando não dá pra confiar em quem cuida de você.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672213
    m_Localized: 'Firefighter: Ninguém vai me ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672214
    m_Localized: 'Firefighter: Era melhor ter morrido apagando fogo com meus amigos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672215
    m_Localized: 'Firefighter: De qualquer jeito, não me resta muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672216
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672217
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672218
    m_Localized: 'Firefighter: Eu queria continuar apagando incêndios. Queria ter morrido lá, no lugar dos caras.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672219
    m_Localized: 'Firefighter: Mas eles deixaram bem claro *cof cof* que meu tempo acabou.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672220
    m_Localized: 'Firefighter: Não consigo mais voltar pra casa. O transporte público parou de funcionar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672221
    m_Localized: 'Firefighter: Tenho que confiar na bondade das pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672222
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672223
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672224
    m_Localized: 'Firefighter: Valeu, cara. *cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672225
    m_Localized: 'Firefighter: Acho que não vou incomodar por muito tempo. *cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672226
    m_Localized: 'Firefighter: Pelo menos não vou morrer no chão molhado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672227
    m_Localized: 'Firefighter: Que merda, cara. *cof*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672228
    m_Localized: 'Firefighter: Não quero morrer no chão molhado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038833672229
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866496
    m_Localized: 'Firefighter: Espero que *cof cof* os incêndios não cheguem às cidades.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866497
    m_Localized: 'Wheelchair: Heeey, e aí!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866498
    m_Localized: 'WheelChair: Quanto tempo! Como vai a vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866499
    m_Localized: Eu te conheço?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866500
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866501
    m_Localized: 'Wheelchair: Ah, qual é... Não lembra de mim?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866502
    m_Localized: 'Wheelchair: A gente era...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866503
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866504
    m_Localized: 'Wheelchair: Peraí, sua voz está diferente...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866505
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866506
    m_Localized: 'Wheelchair: Há quanto tempo esse lugar trocou de dono?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866507
    m_Localized: Essa casa sempre foi da minha família
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866508
    m_Localized: Acho que você só errou o endereço
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866509
    m_Localized: 'Wheelchair: Ah, você não é...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866510
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866511
    m_Localized: 'Wheelchair: Você não é meu amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866512
    m_Localized: 'Wheelchair: Há quanto tempo você mora aqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866513
    m_Localized: Essa casa sempre foi da minha família
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866514
    m_Localized: Acho que você só errou o endereço
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866515
    m_Localized: 'Wheelchair: Não, fala sério.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866516
    m_Localized: 'Wheelchair: Eu não erro! Minha memória é impecável.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866517
    m_Localized: 'Wheelchair: Meu amigo com certeza mora... bom, morava aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866518
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866519
    m_Localized: 'Wheelchair: Ei, vim de longe. Pode me deixar entrar, por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866520
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866521
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866522
    m_Localized: 'Wheelchair: Não, não pode ser...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866523
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866524
    m_Localized: 'Wheelchair: Não...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866525
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866526
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866527
    m_Localized: 'Wheelchair: Droga...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866528
    m_Localized: 'Wheelchair: Acho que me enganei mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866529
    m_Localized: 'Wheelchair: Ei, eu percorri um longo caminho. Você poderia me deixar entrar, por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866530
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866531
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866532
    m_Localized: 'Wheelchair: É disso que eu tô falando!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866533
    m_Localized: 'Wheelchair: Vamos apostar uma corrida?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866534
    m_Localized: 'Wheelchair: Sair? Que porra é essa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866535
    m_Localized: 'Wheelchair: Eu só devia sair, é isso?!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866536
    m_Localized: 'Wheelchair: Ahhh, tô indo embora. Lunático.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866537
    m_Localized: 'Mother: Chega! Para de se mexer e fica parada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866538
    m_Localized: 'Mother: Olá. Por favor, me ajude.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866539
    m_Localized: O que aconteceu?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866540
    m_Localized: O que você quer de mim?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866541
    m_Localized: 'Mother: Estou exausta. Só quero dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866542
    m_Localized: 'Mother: Tive cinco filhos. Essa aqui é a única que sobrou.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866543
    m_Localized: 'Mother: Meu marido desapareceu. Não sei se morreu, se nos abandonou, ou o quê.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866544
    m_Localized: 'Mother: Agora só queria deitar e dormir por uns dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866545
    m_Localized: Pra onde foram seus outros filhos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866546
    m_Localized: Seus filhos estão mortos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866547
    m_Localized: 'Mother: Deixe-me entrar. Estou morrendo de cansaço.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866548
    m_Localized: 'Mother: Eu costumava ter cinco filhos. Essa aqui é a última.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866549
    m_Localized: 'Mother: Não sei onde procurar por eles. Só quero descansar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866550
    m_Localized: Pra onde foram seus outros filhos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866551
    m_Localized: Seus filhos estão mortos?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866552
    m_Localized: 'Mother: Não sei. Talvez o pai deles tenha levado. Queria ir até a casa dele, mas não consigo mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866553
    m_Localized: 'Mother: Sim, a gente brigava muito, mas também, quem consegue viver com alguém sendo um babaca?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866554
    m_Localized: 'Mother: Claro que não. Olha, o importante é encontrar meus filhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866555
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866556
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866557
    m_Localized: 'Mother: Não fala isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866558
    m_Localized: 'Mother: É difícil cuidar de um monte de criança cheia de energia, mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866559
    m_Localized: 'Mother: Não aconteceu nada com eles. Devem estar na casa da minha mãe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866560
    m_Localized: 'Mother: Eles fogem pra lá quando se cansam de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866561
    m_Localized: 'Mother: Ou quando o pai deles aparece pra me pedir dinheiro de novo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866562
    m_Localized: 'Mother: Pode me deixar entrar? Preciso descansar e ir atrás dos meus filhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866563
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866564
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866565
    m_Localized: 'Mother: Finalmente. Um descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866566
    m_Localized: 'Mother: Vamos, anda logo. Escolhe seu canto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866567
    m_Localized: 'Mother: Amanhã a gente parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866568
    m_Localized: 'Mother: Tá bom. Vou tentar chegar na casa da minha mãe, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866569
    m_Localized: 'Mother: Talvez eu nem consiga...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866570
    m_Localized: 'Mother: Não, eu tenho que conseguir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866571
    m_Localized: 'Anger: Olá, morador.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866572
    m_Localized: 'Anger: Tô de mau humor, então já peço desculpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866573
    m_Localized: 'Anger: Tanta gente escrota por aí. Espero que você não seja um deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866574
    m_Localized: De quem você tá falando?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866575
    m_Localized: Você não é uma dessas bestas, é?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866576
    m_Localized: 'Anger: Bom, de todo mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866577
    m_Localized: 'Anger: Os idiotas que só se seguravam por causa da fé ou qualquer outra merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866578
    m_Localized: 'Anger: E quando Deus morreu pra eles, não sobrou mais nada de humano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866579
    m_Localized: 'Anger: Animais de merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866580
    m_Localized: 'Anger: Como se os Visitantes já não fossem problema o bastante... Ainda tem esses aqui também.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866581
    m_Localized: Por que você tá tão na defensiva?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866582
    m_Localized: E você, é diferente de quê jeito?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866583
    m_Localized: 'Anger: Boa pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866584
    m_Localized: 'Anger: Você deve ter notado que existem dois tipos de pessoas, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866585
    m_Localized: 'Anger: Um deles é feito de sádicos malditos. Piores que qualquer Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866586
    m_Localized: 'Anger: :Fazem o que querem: encostam uma arma na sua cabeça, apertam o gatilho e já era!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866587
    m_Localized: 'Anger: O outro tipo são só animais. Você pisa neles e eles ainda agradecem por não terem morrido.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866588
    m_Localized: 'Anger: E os dois me tiram do sério.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866589
    m_Localized: Por que você tá tão na defensiva?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866590
    m_Localized: E você, é diferente de quê jeito?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866591
    m_Localized: 'Anger: Não leva pro lado pessoal. É só que...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866592
    m_Localized: 'Anger: Depois da merda com o sol e os Visitantes, parece que a humanidade morreu junto com Deus.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866593
    m_Localized: 'Anger: E eu tô com raiva... Só queria fazer coisas normais, sabe?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866594
    m_Localized: 'Anger: Eu escrevia música. Agora ninguém precisa disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866595
    m_Localized: 'Anger: Tô tentando não virar nem um nem outro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866596
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866597
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866598
    m_Localized: 'Anger: Quero acreditar que sou diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866599
    m_Localized: 'Anger: Me apavora só de pensar em virar um maníaco.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866600
    m_Localized: 'Anger: Ou uma vítima. Os dois lados são uma merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866601
    m_Localized: 'Anger: Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866602
    m_Localized: 'Anger: As vítimas são piores.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866603
    m_Localized: 'Anger: Ficam sentadas, esperando alguém espancar, quebrar os dentes, ou pior.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866604
    m_Localized: 'Anger: Se você tivesse visto o que eu vi, entenderia minha raiva.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866605
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866606
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866607
    m_Localized: 'Anger: Relaxa, não vou incomodar ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866608
    m_Localized: 'Anger: Nem bater em ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866609
    m_Localized: 'Anger: Descarrego minha raiva em mim mesmo, pra não machucar mais ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866610
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866611
    m_Localized: 'Anger: Merda, você é tão fodido quanto os outros covardes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866612
    m_Localized: 'Anger: Fica aí parado, levando porrada na cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866613
    m_Localized: 'Anger: Maldição.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866614
    m_Localized: 'FortuneTeller: Sinto que a energia aqui tá estagnada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866615
    m_Localized: 'FortuneTeller: Algo muito ruim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866616
    m_Localized: 'FortuneTeller: O Sol, o Leão, a Quinta Casa. Eu entendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866617
    m_Localized: 'FortuneTeller: Você é uma pessoa bem assertiva, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866618
    m_Localized: Hã?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866619
    m_Localized: Eu não preciso de nada
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866620
    m_Localized: 'FortuneTeller: Dá pra ver que você é de agir, não de falar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866621
    m_Localized: 'FortuneTeller: Típico Leão, acertei?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866622
    m_Localized: 'FortuneTeller: E você acumulou uma carga pesada de energia negativa aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866623
    m_Localized: 'FortuneTeller: Ainda não sei o motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866624
    m_Localized: 'FortuneTeller: Tá tudo tão largado que acho melhor começar com afirmações.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866625
    m_Localized: Por que diabos você tá jogando isso em cima de mim?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866626
    m_Localized: Tá, e...?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866627
    m_Localized: 'FortuneTeller: Não tô sugerindo nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866628
    m_Localized: 'FortuneTeller: Só posso te ajudar a entender as causas e consequências, entendeu?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866629
    m_Localized: 'FortuneTeller: Karma 6-9, tipo peixes nadando em círculo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866630
    m_Localized: 'FortuneTeller: Olho por olho, coça minhas costas que eu coço as suas. Entende?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866631
    m_Localized: Por que diabos você tá jogando isso em cima de mim?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866632
    m_Localized: Tá, e...?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866633
    m_Localized: 'FortuneTeller: Eu entendo que isso te estresse, já que você tem ascendente em Capricórnio.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866634
    m_Localized: 'FortuneTeller: Você tá carregando várias constelações ao mesmo tempo. É uma pessoa complexa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866635
    m_Localized: 'FortuneTeller: Podemos usar afirmações pra alcançar as profundezas do seu cosmos. Você entende, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866636
    m_Localized: 'FortuneTeller: Aí tudo vai se encaixar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866637
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866638
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866639
    m_Localized: 'FortuneTeller: Você teve carcereiros na sua linhagem e em reencarnações passadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866640
    m_Localized: 'FortuneTeller: Dá espaço pra eles. Você só tá repetindo os ciclos das vidas passadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866641
    m_Localized: 'FortuneTeller: Você precisa perdoá-los e aceitar isso em você.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866642
    m_Localized: 'FortuneTeller: Aí vai conseguir quebrar as correntes do ciclo infinito.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866643
    m_Localized: 'FortuneTeller: Entendeu?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866644
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866645
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866646
    m_Localized: 'FortuneTeller: Muito bem. Pra ser sincero, você está numa ótima posição aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866647
    m_Localized: 'FortuneTeller: Tem uma corrente energética fluindo por essa casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866648
    m_Localized: 'FortuneTeller: Então, você não quer trabalhar em si mesmo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866649
    m_Localized: 'FortuneTeller: Se tornar sua melhor versão?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866650
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866651
    m_Localized: 'FortuneTeller: Uma tragédia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866652
    m_Localized: 'FortuneTeller: Vou fazer umas rezas pra você ter diarreia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866653
    m_Localized: 'Gasmask: Boa noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866654
    m_Localized: 'Gasmask: Sou da FEMA. Estamos fazendo ronda na vizinhança.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866655
    m_Localized: Você está sozinho?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866656
    m_Localized: Por que eu deveria confiar em você?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866657
    m_Localized: 'Gasmask: Não, claro que não.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866658
    m_Localized: 'Gasmask: Nossa brigada se dividiu em alguns pequenos grupos para cobrir mais terreno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866659
    m_Localized: 'Gasmask: Essa conversa não deve tomar muito do seu tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866660
    m_Localized: Por que você está com equipamento de proteção? Precisamos disso também?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866661
    m_Localized: Como você vai nos ajudar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866662
    m_Localized: 'Gasmask: Posso mostrar minhas credenciais.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866663
    m_Localized: 'Gasmask: E de qualquer forma, os Visitantes raramente se movem em grupo. Talvez nunca.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866664
    m_Localized: Por que você está com equipamento de proteção? Precisamos disso também?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866665
    m_Localized: Como você vai nos ajudar?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866666
    m_Localized: 'Gasmask: Não. Mas você pode comprar, se achar necessário.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866667
    m_Localized: 'Gasmask: Estamos estudando o efeito do sol no meio ambiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866668
    m_Localized: 'Gasmask: Como estamos frequentemente expostos ao sol, é importante termos cuidado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866669
    m_Localized: O que então?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866670
    m_Localized: Você tem um plano de ação?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866671
    m_Localized: 'Gasmask: Nossa primeira tarefa é coletar dados para enviar à liderança.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866672
    m_Localized: 'Gasmask: Depois disso, eles vão elaborar um procedimento de resposta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866673
    m_Localized: 'Gasmask: O que então?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866674
    m_Localized: Você tem um plano de ação?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866675
    m_Localized: Agora, você só precisa manter a calma.
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866676
    m_Localized: 'Gasmask: Vou levar uma pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866677
    m_Localized: 'Gasmask: Faremos alguns testes pra garantir que ela está bem, e que é seguro morar aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866678
    m_Localized: 'Gasmask: E claro, vamos verificar se ela é humana.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866679
    m_Localized: Eu preciso fazer as malas?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866680
    m_Localized: Devo só esperar que algo aconteça?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866681
    m_Localized: 'Gasmask: Claro. Não podemos agir por impulso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866682
    m_Localized: 'Gasmask: Vamos levar uma pessoa ao nosso laboratório.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866683
    m_Localized: 'Gasmask: Ela só fará alguns testes pra garantir que está tudo certo e depois será devolvida.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866684
    m_Localized: Eu preciso fazer as malas?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866685
    m_Localized: Devo só esperar que algo aconteça?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866686
    m_Localized: 'Gasmask: Esta é a sua casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866687
    m_Localized: 'Gasmask: Então não. Fique com os outros moradores. Se precisar evacuar, avisaremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866688
    m_Localized: 'Gasmask: Vamos levar só uma pessoa e ir embora.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866689
    m_Localized: 'Gasmask: Tenha uma boa noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866690
    m_Localized: 'Gasmask: Sim. Assim que tivermos todas as informações, daremos instruções.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866691
    m_Localized: 'Gasmask: Por enquanto, não precisa se preocupar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866692
    m_Localized: 'Gasmask: Vamos pegar apenas uma pessoa e tentar trazê-la de volta o mais rápido possível.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866693
    m_Localized: 'Gasmask: Se cuida.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866694
    m_Localized: 'Prophet: Então, nos encontramos de novo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866695
    m_Localized: 'Prophet: Lembro que da última vez tudo era diferente. Mas nós vivemos...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866696
    m_Localized: 'Prophet: Hm. É estranho — não sei como explicar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866697
    m_Localized: 'Prophet: Gostaria de começar nossa conversa com... uma ação.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866698
    m_Localized: 'Prophet: Você pode prever minha sorte com um livro? Em qual página devo abrir?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866699
    m_Localized: Vamos começar pelo começo
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866700
    m_Localized: Só abre no meio
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866701
    m_Localized: Vai até o fim
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866702
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866703
    m_Localized: 'Prophet: Os mortos se erguerão e falarão, mas ninguém dará ouvidos às suas palavras.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866704
    m_Localized: 'Prophet: Nossa...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866705
    m_Localized: 'Prophet: Isso ainda faz sentido.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866706
    m_Localized: 'Prophet: Embora agora não seja mais surpresa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866707
    m_Localized: O que isso quer dizer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866708
    m_Localized: Você realmente acredita nisso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866709
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866710
    m_Localized: 'Prophet: O que é você?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866711
    m_Localized: 'Prophet: Eu? Eu sou eu. Você? Você estava em casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866712
    m_Localized: 'Prophet: Hm. Sim. Uma história trágica.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866713
    m_Localized: 'Prophet: É isso que nos espera?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866714
    m_Localized: 'Prophet: É bem possível.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866715
    m_Localized: O que isso quer dizer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866716
    m_Localized: Você realmente acredita nisso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866717
    m_Localized: 'Prophet: Foi há muito tempo. Talvez tenha sido um sonho. Talvez você, eu e os peixes…'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866718
    m_Localized: 'Prophet: ... só existamos na memória de alguém que já se foi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866719
    m_Localized: 'Prophet: Talvez ninguém exista de verdade, e só esteja chovendo lá fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866720
    m_Localized: 'Prophet: Hm. Ou talvez vá se tornar assim em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866721
    m_Localized: 'Prophet: O que você acha? Já somos o sonho de alguém ou ainda vamos nos tornar um?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866722
    m_Localized: 'Prophet: Essa frase é interessante.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866723
    m_Localized: O que isso quer dizer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866724
    m_Localized: Você realmente acredita nisso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866725
    m_Localized: 'Prophet: Preciso refletir. Você tem alguma opinião sobre isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866726
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866727
    m_Localized: 'Prophet: Enfim, vim aqui pra te contar algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866728
    m_Localized: 'Prophet: Coisas importantes vão acontecer em breve...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866729
    m_Localized: 'Prophet: Você precisa estar pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866730
    m_Localized: 'Prophet: Eu sei que parece estranho, mas você precisa deixar entrar a pessoa com um gato.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866731
    m_Localized: 'Prophet: Tenho certeza de que isso vai te ajudar. Ainda não posso dizer como.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866732
    m_Localized: 'Prophet: Mas claro, você faz o que quiser com essa informação.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866733
    m_Localized: 'Prophet: Por enquanto, vou pensar no significado da sua escolha de adivinhação.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866734
    m_Localized: 'Prophet: Não exatamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866735
    m_Localized: 'Prophet: É melhor ver isso como um aviso. Pra não esquecer de fazer algo ou prestar atenção.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866736
    m_Localized: 'Prophet: Enquanto pensava, algo me veio à cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866737
    m_Localized: 'Prophet: Uma pessoa com um gato vai chegar em breve. É importante deixá-la entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866738
    m_Localized: 'Prophet: Ainda não posso dizer o motivo. Mas isso vai facilitar as coisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866739
    m_Localized: 'Prophet: Agora preciso ir pensar sobre o que você escolheu no livro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866740
    m_Localized: 'Fanatic: Olá, humano.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866741
    m_Localized: 'Fanatic: Que sorte a nossa! Pudemos ver com nossos próprios olhos o castigo da luxúria humana.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866742
    m_Localized: 'Fanatic: A Terra está sendo purificada. O sol está fazendo seu trabalho.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866743
    m_Localized: 'Fanatic: E nós seguimos rumo a um novo mundo, puro!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866744
    m_Localized: 'Fanatic: VEJA ESSA PORRA DE BÊNÇÃO!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866745
    m_Localized: O quê?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866746
    m_Localized: Você está me assustando
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866747
    m_Localized: 'Fanatic: O que você esperava, HUMANO?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866748
    m_Localized: 'Fanatic: Escuta — vou te dar um resuminho.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866749
    m_Localized: 'Fanatic: O sol não queima e TORRA A GENTE à toa! Ele está nos purificando dos pecados!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866750
    m_Localized: 'Fanatic: Fizemos um caos de tudo, e agora IRRITAMOS O SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866751
    m_Localized: 'Fanatic: ELE ESTÁ NOS DANDO O QUE MERECEMOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866752
    m_Localized: 'Fanatic: Isso é uma bênção. Todo pecado vai acabar, e viveremos como devíamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866753
    m_Localized: Então... Temos que morrer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866754
    m_Localized: O que vai acontecer com você?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866755
    m_Localized: 'Fanatic: Você tá maluco?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866756
    m_Localized: 'Fanatic: Ouça — vou lhe dar um pequeno resumo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866757
    m_Localized: 'Fanatic: O sol não queima e TORRA A GENTE à toa! Ele está nos purificando dos pecados!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866758
    m_Localized: 'Fanatic: Fizemos um caos de tudo, e agora IRRITAMOS O SOL!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866759
    m_Localized: 'Fanatic: ELE ESTÁ NOS DANDO O QUE MERECEMOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866760
    m_Localized: 'Fanatic: Isso é uma bênção. Todo pecado terminará e viveremos como deveríamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866761
    m_Localized: Então... Temos que morrer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866762
    m_Localized: O que vai acontecer com você?
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866763
    m_Localized: 'Fanatic: Muito pelo contrário!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866764
    m_Localized: 'Fanatic: Nossos pecados perecerão. Talvez o mesmo aconteça com o próprio sol. MAS VIVEREMOS.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866765
    m_Localized: 'Fanatic: Não haverá mais morte, roubo, gananciosos imundos que não podem me vender o que eu quero por um preço justo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866766
    m_Localized: 'Fanatic: Você pode imaginar isso? Você entende do que isso se trata?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866767
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866768
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866769
    m_Localized: 'Fanatic: O que isso tem a ver comigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038837866770
    m_Localized: 'Fanatic: Todos viveremos BEM assim que o sol nos ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060800
    m_Localized: 'Fanatic: O sol vai nos ajudar a escapar de tudo isso, você não entende?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060801
    m_Localized: 'Fanatic: Você entende — é por isso que você está vivo!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060802
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060803
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060804
    m_Localized: 'Fanatic: Vou te contar muito mais sobre tudo isso!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060805
    m_Localized: 'Fanatic: Ah, esqueci de perguntar — você tem cerveja?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060806
    m_Localized: 'Fanatic: Você estava fingindo não saber nada sobre o sol ou o quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060807
    m_Localized: 'Fanatic: Bem, então foda-se! VOU SALVAR O-O-OUTRA PESSOA!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060808
    m_Localized: 'Fanatic: Até logo! ADEUUU-S-S-S!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060809
    m_Localized: 'Anxiety: Olá!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060810
    m_Localized: 'Anxiety: Desculpe, é tão tarde... Estava tão quente hoje que a TV disse que era melhor não sair ao sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060811
    m_Localized: 'Anxiety: Você poderia encontrar algum espaço para mim?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060812
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060813
    m_Localized: Como você acabou aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060814
    m_Localized: 'Anxiety: Hum, eu morava perto da cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060815
    m_Localized: 'Anxiety: Claro, o asfalto lá está esquentando muito, heh. Heh heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060816
    m_Localized: 'Anxiety: Na verdade, trabalhava como caixa. Um dia. Não mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060817
    m_Localized: 'Anxiety: Eles, hum, eles me demitiram. Tive azar com trabalhos...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060818
    m_Localized: O que você vai fazer agora?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060819
    m_Localized: O que você acha que vai acontecer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060820
    m_Localized: 'Anxiety: Não é que eu quisesse vir aqui. Hum, o asfalto já está derretendo sob nossos pés, mas ainda não é tão ruim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060821
    m_Localized: 'Anxiety: Você vai rir, heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060822
    m_Localized: 'Anxiety: Visitantes vieram à minha casa. Heh... Imagina só! Eles me expulsaram de minha própria casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060823
    m_Localized: 'Anxiety: Então, agora eu quero encontrar um lugar para me esconder do sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060824
    m_Localized: O que você vai fazer agora?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060825
    m_Localized: O que você acha que vai acontecer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060826
    m_Localized: 'Anxiety: Hummmm. Tentar sobreviver de alguma forma. É assustador, é claro, com esses Visitantes em todos os lugares e o sol queimando com o fogo do inferno.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060827
    m_Localized: 'Anxiety: Eu realmente gostaria de viver. Heh heh. Oooof.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060828
    m_Localized: 'Anxiety: Você não está com medo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060829
    m_Localized: 'Anxiety: Me diz que tudo vai acabar em breve, por favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060830
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060831
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060832
    m_Localized: 'Anxiety: Eu não sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060833
    m_Localized: 'Anxiety: Eu vou sobreviver? Quem vai me ajudar? Quanto tempo terei que procurar ajuda?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060834
    m_Localized: 'Anxiety: Não tenho ideia do que vai acontecer. Eu não posso nem adivinhar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060835
    m_Localized: 'Anxiety: Isso não te assusta? Isso me aterroriza.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060836
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060837
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060838
    m_Localized: 'Anxiety: Obrigada. Haha! Obrigada, sério!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060839
    m_Localized: 'Anxiety: Vou viver um pouco mais, graças a Deus.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060840
    m_Localized: 'Anxiety: Haha, uuuuuufa, ok, claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060841
    m_Localized: 'Anxiety: Obrigada por ouvir, de qualquer maneira.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060842
    m_Localized: 'Anxiety: Hum, ok, eu deveria ir mesmo, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060843
    m_Localized: 'Anxiety: Tchau? Sim, hum, tchau.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060844
    m_Localized: 'Esenin: Posso entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060845
    m_Localized: 'Esenin: Eu estava me abrigando no bar, mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060846
    m_Localized: 'Esenin: Eles só me expulsaram.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060847
    m_Localized: 'Esenin: O motivo? Hunf. Acho que nem todos lá foram com a minha personalidade... carismática.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060848
    m_Localized: 'Esenin: Mas eu não vou machucar ninguém, não se preocupe. Eu só... a vida é uma merda às vezes. Você entende.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060849
    m_Localized: 'Esenin: Então? Posso entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060850
    m_Localized: Você não é um visitante, né?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060851
    m_Localized: Tem certeza de que não vai causar problemas?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060852
    m_Localized: 'Esenin: Você acha que eu sou um desses monstros?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060853
    m_Localized: 'Esenin: Não. Eu não sou um Visitante. Mas perguntar a todos isso diretamente é um absurdo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060854
    m_Localized: 'Esenin: De qualquer jeito, acho que aqui não vai ser diferente do bar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060855
    m_Localized: Por que eles te expulsaram do seu abrigo anterior?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060856
    m_Localized: Por que você acha que será diferente aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060857
    m_Localized: 'Esenin: O que você considera problema?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060858
    m_Localized: 'Esenin: Assassinato e violência me enojam. Mas não vou deixar os outros passarem por cima de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060859
    m_Localized: 'Esenin: Eu gosto de beber e comer. Gosto de conversar quando estou de bom humor. Isso é "problema"?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060860
    m_Localized: Por que eles o expulsaram do seu abrigo anterior?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060861
    m_Localized: Por que você acha que será diferente aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060862
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060863
    m_Localized: 'Esenin: Pensei em dizer algo rude no início, mas mudei de ideia.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060864
    m_Localized: 'Esenin: Eu te disse: as pessoas de lá não gostavam de mim. Só Deus sabe quem foi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060865
    m_Localized: 'Esenin: Então, parando pra pensar, talvez eles tenham me expulsado pra valer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060866
    m_Localized: 'Esenin: Eles poderiam ter me comido vivo, e ninguém teria notado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060867
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060868
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060869
    m_Localized: 'Esenin: O que devo fazer agora? Apenas queimar sob o sol?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060870
    m_Localized: 'Esenin: Não, acho que não vou.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060871
    m_Localized: 'Esenin: Enquanto eu estiver vivo, continuarei procurando alguém com quem conversar. Se você não me deixar entrar, terei sorte em outro lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060872
    m_Localized: 'Esenin: Se ainda houver alguma sorte neste mundo, e qualquer um que não seja um idiota.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060873
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060874
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060875
    m_Localized: 'Esenin: Obrigado. A confiança nas pessoas agora não equivale a um monte de feijão.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060876
    m_Localized: 'Esenin: Portanto, agradeço sua confiança. Talvez... Bem, eu não posso prometer nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060877
    m_Localized: 'Esenin: Hm. Eu entendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060878
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060879
    m_Localized: 'Esenin: Eu entendo, mas estou com raiva. Você é tão covarde quanto todo mundo por aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060880
    m_Localized: 'Esenin: Durma bem, bom homem. E vá se fuder.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060881
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060882
    m_Localized: 'Widow: Posso entrar para descansar?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060883
    m_Localized: De onde você veio?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060884
    m_Localized: E para onde você está indo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060885
    m_Localized: 'Widow: Eu não me lembro. Mas não importa mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060886
    m_Localized: 'Widow: Estou muito cansada. Se eu não descansar um pouco, vou desmaiar debaixo das janelas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060887
    m_Localized: Seu companheiro está doente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060888
    m_Localized: Seu amigo precisa de ajuda?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060889
    m_Localized: 'Widow: Eu... Eu só quero cair em algum lugar e nunca mais me levantar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060890
    m_Localized: 'Widow: Não importa onde eu acabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060891
    m_Localized: Seu companheiro está doente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060892
    m_Localized: Seu amigo precisa de ajuda?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060893
    m_Localized: 'Widow: Ele é meu marido.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060894
    m_Localized: 'Widow: Ele está morto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060895
    m_Localized: 'Widow: Não posso dar a ele um enterro adequado. Não adianta deixá-lo ir agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060896
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060897
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060898
    m_Localized: 'Widow: Não mais. Quando ele precisava, ninguém ajudou.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060899
    m_Localized: 'Widow: Agora ele está morto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060900
    m_Localized: 'Widow: Ele poderia ter vivido se...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060901
    m_Localized: 'Widow: Se alguém se importasse.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060902
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060903
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060904
    m_Localized: 'Widow: Acho que não vou ficar muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060905
    m_Localized: 'Widow: Eu só preciso descansar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060906
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060907
    m_Localized: 'Widow: Você...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060908
    m_Localized: 'Scammer: Ei!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060909
    m_Localized: 'Scammer: Você viu o que está acontecendo? Loucura total.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060910
    m_Localized: 'Scammer: Como estão as coisas com você?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060911
    m_Localized: O que você quer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060912
    m_Localized: O que está acontecendo, exatamente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060913
    m_Localized: 'Scammer: Nada, só curiosidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060914
    m_Localized: 'Scammer: Mas eu tenho uma maneira fácil de você ganhar dinheiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060915
    m_Localized: 'Scammer: Com esse pânico todo do sol, dá pra fazer dinheiro sem nem levantar um dedo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060916
    m_Localized: 'Scammer: Esse povo todo tá com medo de algo, quando só precisam é começar a agir!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060917
    m_Localized: Por que você está aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060918
    m_Localized: O que você sugere?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060919
    m_Localized: 'Scammer: Novas possibilidades. Você não tá vendo nada?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060920
    m_Localized: 'Scammer: Tá todo mundo correndo feito barata tonta, quando podia só fazer as coisas de coração.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060921
    m_Localized: 'Scammer: Eles precisam é ser felizes, é isso que tô dizendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060922
    m_Localized: Por que você está aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060923
    m_Localized: O que você sugere?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060924
    m_Localized: 'Scammer: Você vai direto ao ponto!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060925
    m_Localized: 'Scammer: Todo mundo acha que você tá aprontando alguma coisa aqui. Aprontando alguma merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060926
    m_Localized: 'Scammer: A gente podia fazer a festa da vida aqui!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060927
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060928
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060929
    m_Localized: 'Scammer: Quer sobreviver?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060930
    m_Localized: 'Scammer: Tem que fazer planos enquanto ainda dá tempo, foda-se o sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060931
    m_Localized: 'Scammer: Dá o seu jeito, entendeu? Bora! O que você acha?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060932
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060933
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060934
    m_Localized: 'Scammer: Isso aí, parceiro! É disso que eu tô falando!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060935
    m_Localized: 'Scammer: Finalmente alguém esperto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060936
    m_Localized: 'Scammer: Você é um idiota, isso é óbvio. Mas beleza. Vai se fuder.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060937
    m_Localized: 'Scammer: Então vou bater na porta do seu vizinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060938
    m_Localized: 'Scammer: Falou.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060939
    m_Localized: 'Neighbour: Ei, vizinho. Quanto tempo. Como vai a vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060940
    m_Localized: O mesmo de sempre
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060941
    m_Localized: Tudo bem
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060942
    m_Localized: 'Neighbour: Ei, vim aqui por um motivo. Tô meio preocupado com você.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060943
    m_Localized: 'Neighbour: Tem coisa ruim vindo aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060944
    m_Localized: 'Neighbour: Meu primo me ligou. As notícias por lá tão dizendo que tem algo estranho acontecendo com o sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060945
    m_Localized: 'Neighbour: E que tem gente saindo de baixo da terra. Estão chamando eles de Visitantes por algum motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060946
    m_Localized: 'Neighbour: Assustador. Espero que não seja verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060947
    m_Localized: O que está acontecendo com o sol?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060948
    m_Localized: Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060949
    m_Localized: 'Neighbour: Ei, vim aqui por um motivo. Tô meio preocupado com você.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060950
    m_Localized: 'Neighbour: Tem coisa ruim vindo aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060951
    m_Localized: 'Neighbour: Meu primo me ligou. As notícias por lá tão dizendo que tem algo estranho acontecendo com o sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060952
    m_Localized: 'Neighbour: E que tem gente saindo de baixo da terra. Estão chamando eles de Visitantes por algum motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060953
    m_Localized: 'Neighbour: Assustador. Espero que não seja verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060954
    m_Localized: O que está acontecendo com o sol?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060955
    m_Localized: Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060956
    m_Localized: 'Neighbour: Ou ele vai explodir ou algo vai explodir dentro dele... Não sei bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060957
    m_Localized: 'Neighbour: Só sei que tem algo errado com ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060958
    m_Localized: 'Neighbour: Você reparou que esse verão foi o mais quente de todos, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060959
    m_Localized: 'Neighbour: Acho que a gente tem que se preparar pro pior.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060960
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060961
    m_Localized: 'Neighbour: Meu primo disse que é perigoso ficar sozinho em casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060962
    m_Localized: 'Neighbour: Então vim aqui pra garantir que você não morra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060963
    m_Localized: Ok
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060964
    m_Localized: Eu sei me cuidar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060965
    m_Localized: Como estão sua esposa e sua filha?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060966
    m_Localized: 'Neighbour: Sim. É assim que estão chamando o pessoal que vem de baixo da terra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060967
    m_Localized: 'Neighbour: Vai saber por quê.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060968
    m_Localized: 'Neighbour: Acho que é porque são "visitantes" da Terra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060969
    m_Localized: 'Neighbour: Ou porque ficam tentando entrar nas casas dos outros.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060970
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060971
    m_Localized: 'Neighbour: Meu primo disse que é perigoso ficar sozinho em casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060972
    m_Localized: 'Neighbour: Então vim aqui pra garantir que você não morra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060973
    m_Localized: Ok
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060974
    m_Localized: Eu sei me cuidar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060975
    m_Localized: Como estão sua esposa e sua filha?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060976
    m_Localized: 'Neighbour: Beleza, a gente continua essa conversa de manhã, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060977
    m_Localized: 'Neighbour: Vou te esperar na cozinha.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060978
    m_Localized: 'Neighbour: Te vejo de manhã.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060979
    m_Localized: 'Neighbour: Eu sei. Mas acho que é mais perigoso do que parece ficar sozinho agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060980
    m_Localized: 'Neighbour: Por que eu não fico com você só essa noite? Vai me deixar mais tranquilo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060981
    m_Localized: 'Neighbour: Não se preocupa com minha esposa e filha. Um amigo chegou lá esses dias. Vai cuidar delas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060982
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060983
    m_Localized: 'Neighbour: Beleza, a gente continua essa conversa de manhã, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060984
    m_Localized: 'Neighbour: Vou te esperar na cozinha.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060985
    m_Localized: 'Neighbour: Te vejo de manhã.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060986
    m_Localized: 'Neighbour: Não se preocupa. Um bom amigo apareceu lá outro dia. Ele vai cuidar da minha família.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060987
    m_Localized: 'Neighbour: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060988
    m_Localized: 'Neighbour: Beleza, a gente continua essa conversa de manhã, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060989
    m_Localized: 'Neighbour: Vou te esperar na cozinha.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060990
    m_Localized: 'Neighbour: Te vejo de manhã.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060991
    m_Localized: 'Daughter: Oi!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060992
    m_Localized: 'Daughter: Meu pai tá aí? Você pode chamar ele pra mim?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060993
    m_Localized: 'Daughter: De manhã eu tava bem, mas agora tô com medo. Tem muita gente andando na rua à noite...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060994
    m_Localized: Qual é o nome do seu pai?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060995
    m_Localized: Me conta uma coisa sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060996
    m_Localized: 'Daughter: Você esqueceu o nome dele? Ah — você só tá testando se eu sou um Visitante, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060997
    m_Localized: 'Daughter: Você é sabido! Vou começar a fazer perguntas pras pessoas, também.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060998
    m_Localized: Como é que você chegou aqui inteira?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842060999
    m_Localized: Você tá com medo dos Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061000
    m_Localized: 'Daughter: Hum, eu sei muita coisa sobre ele, tá? Afinal, ele é o meu pai.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061001
    m_Localized: 'Daughter: Eu sei que ele gosta de beber cerveja antes de sair, hehehe!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061002
    m_Localized: 'Daughter: E quando ele sai, sempre deixa pra mim um suco e uma comida bem gostosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061003
    m_Localized: 'Daughter: Mas, hoje eu experimentei esse negócio que vocês chamam de cerveja. Afe, que negócio ruim!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061004
    m_Localized: 'Daughter: Por que alguém beberia isso quando elas poderiam só tomar um suquinho?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061005
    m_Localized: 'Daughter: Ah, por favor, não conta pra ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061006
    m_Localized: Você chegou aqui em segurança?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061007
    m_Localized: Você tem medo dos Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061008
    m_Localized: 'Daughter: Não sei, parece que agora tá tudo do avesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061009
    m_Localized: 'Daughter: Agora as pessoas ficam em casa e dormem durante o dia, e só saem de noite para fazer suas coisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061010
    m_Localized: 'Daughter: Eu ainda sinto medo do escuro, mas acho que não tem pra quê ter medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061011
    m_Localized: 'Daughter: Ou será que tem?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061012
    m_Localized: Vou chamar seu pai pra você. Boa sorte!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061013
    m_Localized: Tenha um bom dia!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061014
    m_Localized: 'Daughter: E... Eu não sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061015
    m_Localized: 'Daughter: Todo mundo tem medo deles, então eu também tenho. Nunca vi nenhum de verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061016
    m_Localized: 'Daughter: Eles dão medo? Eles batem forte em você?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061017
    m_Localized: 'Daughter: Se sim, talvez o meu amigo da escola seja um Visitante. Ele vive me dando murros.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061018
    m_Localized: 'Daughter: Papai disse pra eu ter cuidado. Eu sou super cuidadosa!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061019
    m_Localized: 'Daughter: Vim até aqui beeeeem quietinha, ninguém me viu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061020
    m_Localized: Vou chamar seu pai pra você. Boa sorte!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061021
    m_Localized: Tenha um bom dia!
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061022
    m_Localized: 'Daughter: Valeu, pra você também!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061023
    m_Localized: 'Daughter: Eu quero ir pra casa... Aqui é assustador...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061024
    m_Localized: 'Daughter: A gente vai jogar um jogo que ele inventou pra mim. Você tem que rolar uns dados!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061025
    m_Localized: 'Daughter: Aí você movimenta uns objetos por aí, como o braço da cadeira ou o sofá.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061026
    m_Localized: 'Daughter: Pra vencer você precisa construir uma pilha enorme perto da porta. Depois eu te mostro como joga.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061027
    m_Localized: 'Daughter: Tchau!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061028
    m_Localized: 'Daughter: O-oi.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061029
    m_Localized: 'Daughter: M-me deixa entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061030
    m_Localized: Você tá em pânico?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061031
    m_Localized: O que aconteceu?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061032
    m_Localized: 'Daughter: E-eu não s-sei o que f-f-fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061033
    m_Localized: 'Daughter: P-p-pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061034
    m_Localized: 'Daughter: U-um...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061035
    m_Localized: 'Daughter: M-m-mataram m-meu pa...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061036
    m_Localized: 'Daughter: M-m-meu...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061037
    m_Localized: 'Daughter: P-pai.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061038
    m_Localized: Quem fez isso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061039
    m_Localized: Por que fizeram isso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061040
    m_Localized: 'Daughter: U-um...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061041
    m_Localized: 'Daughter: M-m-meu pa...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061042
    m_Localized: 'Daughter: Eles m-m-m...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061043
    m_Localized: 'Daughter: Mataram meu pai.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061044
    m_Localized: Quem fez isso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061045
    m_Localized: Por que fizeram isso?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061046
    m_Localized: 'Daughter: V-v-visitantes vieram até a casa. Estavam s-sentados com a gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061047
    m_Localized: 'Daughter: Papai tava f-falando com eles sobre a-alguma coisa. E aí e-eles mataram ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061048
    m_Localized: 'Daughter: Ele... Nossa... *soluços*'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061049
    m_Localized: 'Daughter: Agora nossa c-casa tá pegando f-f-fogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061050
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061051
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061052
    m_Localized: 'Daughter: Eu n-não sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061053
    m_Localized: 'Daughter: Eles só tavam s-sentados com o papai na c-cozinha.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061054
    m_Localized: 'Daughter: E aí f-f-fizeram alguma coisa e colocaram f-fogo na c-casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061055
    m_Localized: 'Daughter: Enquanto eu fugia, eles só r-r-riam.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061056
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061057
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061058
    m_Localized: 'Daughter: Você vai m-me a-ajudar?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061059
    m_Localized: 'Daughter: Tô com m-m-medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061060
    m_Localized: 'Daughter: O-o-onde é que eu v-vou ir?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061061
    m_Localized: 'Daughter: Uaaaaaaah.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061062
    m_Localized: 'Daughter: UAAAAAAAAH.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061063
    m_Localized: 'Daughter: Tô c-c-com muito m-m-medo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061064
    m_Localized: 'SuperFake: Oi!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061065
    m_Localized: O que você quer?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061066
    m_Localized: Eu não vou deixar você entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061067
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061068
    m_Localized: 'SuperFake: Casa espaçosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061069
    m_Localized: 'SuperFake: Eu gosto disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061070
    m_Localized: Eu não preciso de nada
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061071
    m_Localized: Eu tenho uma arma
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061072
    m_Localized: 'SuperFake: Sua porta é bem resistente né?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061073
    m_Localized: 'SuperFake: Nunca se sabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061074
    m_Localized: 'SuperFake: Você sabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061075
    m_Localized: Eu não preciso de nada
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061076
    m_Localized: Eu tenho uma arma
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061077
    m_Localized: 'SuperFake: Sim, sim, eu sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061078
    m_Localized: 'SuperFake: Então...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061079
    m_Localized: 'SuperFake: Você está sozinho em casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061080
    m_Localized: Não, eu não estou sozinho
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061081
    m_Localized: Sim, eu estou sozinho
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061082
    m_Localized: 'SuperFake: Fantástico!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061083
    m_Localized: 'SuperFake: O desespero dá coragem ao covarde, certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061084
    m_Localized: 'SuperFake: Mas, ei...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061085
    m_Localized: 'SuperFake: Você está sozinho em casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061086
    m_Localized: Não, eu não estou sozinho
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061087
    m_Localized: Sim, eu estou sozinho
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061088
    m_Localized: 'SuperFake: É o seu dia de sorte.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061089
    m_Localized: 'SuperFake: Eu posso ouvir alguém sussurrando lá dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061090
    m_Localized: 'SuperFake: Mas quem sabe o que vai acontecer em alguns dias?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061091
    m_Localized: 'SuperFake: Hahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061092
    m_Localized: 'SuperFake: Eu sei que você está sozinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061093
    m_Localized: 'SuperFake: Eu só queria ver se você mentiria ou não.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061094
    m_Localized: 'SuperFake: Vou atender a porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061095
    m_Localized: 'NotTrue: Ei, querido! Aquela caminhada até aqui me deixou exausta.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061096
    m_Localized: 'NotTrue: Posso entrar para descansar?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061097
    m_Localized: Você veio direto pra cá?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061098
    m_Localized: Você estava andando por muito tempo?
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061099
    m_Localized: 'NotTrue: Não direto aqui, é claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061100
    m_Localized: 'NotTrue: A vida traz pra gente quem precisa trazer. Ninguém cruza nosso caminho por acaso.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038842061101
    m_Localized: 'NotTrue: Já que estou aqui, é porque meus pés e meus olhos me trouxeram até aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255104
    m_Localized: 'NotTrue: Como deveria ser, eu suponho.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255105
    m_Localized: Eu não entendi. Você precisa de alguma coisa?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255106
    m_Localized: Então por que não continuou andando? Por que parou aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255107
    m_Localized: 'NotTrue: Eu não saberia dizer quanto tempo. O que é “muito tempo”, afinal?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255108
    m_Localized: 'NotTrue: Olha pra você. Está em casa, mas ainda andando por aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255109
    m_Localized: 'NotTrue: Você andou muito? Deve ter andado.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255110
    m_Localized: 'NotTrue: Mas eu já andei por mais décadas do que você já teve uma refeição quente na mesa.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255111
    m_Localized: 'NotTrue: É assim que a vida é, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255112
    m_Localized: Eu não entendi. Você precisa de alguma coisa?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255113
    m_Localized: Então por que não continuou andando? Por que parou aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255114
    m_Localized: 'NotTrue: O que alguém precisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255115
    m_Localized: 'NotTrue: Ouvir umas histórias, contar outras interessantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255116
    m_Localized: 'NotTrue: Depois se deitar e fechar os olhos com tranquilidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255117
    m_Localized: 'NotTrue: E respirar direito.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255118
    m_Localized: 'NotTrue: Não preciso de mais nada. Viver sozinha é muito chato.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255119
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255120
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255121
    m_Localized: 'NotTrue: É como se você não tivesse ouvido uma palavra do que eu disse, querido.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255122
    m_Localized: 'NotTrue: Estou cansada de andar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255123
    m_Localized: 'NotTrue: Eu só queria sentar um pouco, respirar e bater um papo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255124
    m_Localized: 'NotTrue: Isso já é entretenimento suficiente pra uma velha como eu.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255125
    m_Localized: 'NotTrue: Você me conta algo, e eu retribuo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255126
    m_Localized: 'NotTrue: E aí, quem sabe, posso fechar os olhos por uns minutos.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255127
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255128
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255129
    m_Localized: 'NotTrue: Obrigada, querido!'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255130
    m_Localized: 'NotTrue: Acho que não vou me entediar com você. Pelo menos vou ver o que está acontecendo por aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255131
    m_Localized: 'NotTrue: Sou rejeitada em todo lugar onde vou.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255132
    m_Localized: 'NotTrue: Minhas asas foram cortadas, mas ainda abro a garganta pra cantar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255133
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255134
    m_Localized: 'NotTrue: Mesmo assim, acabam se voltando pra mim por mais que relutem, mesmo que digam que não.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255135
    m_Localized: 'NotTrue: Mas não guardo rancor. Eu ajudo todo mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255136
    m_Localized: 'NotTrue: Até você vai precisar de ajuda. E vai correr pra onde?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255137
    m_Localized: 'Twins: Olá. Ah, se apoia em mim por enquanto.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255138
    m_Localized: 'Twins: Tudo bem a gente estar aqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255139
    m_Localized: Sua companheira está doente?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255140
    m_Localized: Vocês duas estão doentes? Ou só uma de vocês?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255141
    m_Localized: 'Twins: Ela é minha irmã. Ela está com depressão.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255142
    m_Localized: 'Twins: Ela não consegue andar nem tomar banho sozinha. Às vezes, sair da cama já é difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255143
    m_Localized: 'Twins: Mas tudo bem. Um dia melhora, né minha irmã?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255144
    m_Localized: 'Twins: Ela não está com vontade de falar agora, mas às vezes ela encontra forças.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255145
    m_Localized: O que você vai fazer a seguir?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255146
    m_Localized: Você não está cansada de carregar ela?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255147
    m_Localized: 'Twins: Todos nós sofremos de depressão em algum grau.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255148
    m_Localized: 'Twins: A gente já sabia pra onde as coisas estavam indo antes mesmo dos problemas com o sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255149
    m_Localized: 'Twins: Você tem acompanhado as notícias? Tudo tá levando a isso. Mas eu não acho que o sol vai explodir.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255150
    m_Localized: O que você vai fazer a seguir?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255151
    m_Localized: Você não está cansada de carregar ela?
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255152
    m_Localized: 'Twins: Preciso encontrar um lugar onde minha irmã se sinta um pouco mais confortável.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255153
    m_Localized: 'Twins: E aí vamos recomeçar nossa vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255154
    m_Localized: 'Twins: Você acha que nossas vidas acabaram?'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255155
    m_Localized: 'Twins: Eu discordo. Deve melhorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255156
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255157
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255158
    m_Localized: 'Twins: Por favor, cuidado com o que você diz.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255159
    m_Localized: 'Twins: Sim, pode ser cansativo, mas eu não vou abandonar ela, se é isso que você quer dizer.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255160
    m_Localized: 'Twins: Saímos juntas da casa dos nossos pais. Agora só temos uma a outra.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255161
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255162
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255163
    m_Localized: 'Twins: Obrigada! Me ajuda a trazer ela pra dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255164
    m_Localized: 'Twins: A morte dos nossos pais deixou ela ainda mais frágil, mas ela já estava assim há bastante tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255165
    m_Localized: 'Twins: Talvez aqui ela consiga melhorar um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255166
    m_Localized: 'Twins: Ai. Bem, minha irmã, vamos procurar outro lugar pra tentar entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255167
    m_Localized: 'Twins: Vamos lá, me ajuda um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 16038846255168
    m_Localized: 'Twins: Pelo amor de Deus, quando tudo isso acabar...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714688
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714689
    m_Localized: 'Firefighter: Nos deram esse papel no trabalho antes de irmos apagar o fogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714690
    m_Localized: 'Firefighter: Queriam que fôssemos pras zonas de quarentena da FEMA. Mas quem vai querer ir pra lá se todo mundo que vai morre...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714691
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714692
    m_Localized: 'Firefighter: Aqui, eu não preciso disso de qualquer forma. Ou joga fora ou usa pra outra coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714693
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714694
    m_Localized: 'Firefighter: Tenho um papel comigo, cof cof. É meio importante.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714695
    m_Localized: 'Firefighter: Estou disposto a te dar se você me deixar entrar e viver meus últimos dias em paz...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714696
    m_Localized: Ok, entra
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714697
    m_Localized: Não, fica com ele.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714698
    m_Localized: 'Wheelchair: Mas que diabos? O quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714699
    m_Localized: 'Wheelchair: Vejo que você é um cara normal. Talvez uma EnerJeka te faça mudar de ideia?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714700
    m_Localized: 'Wheelchair: Me embalar pra cá me cansou! Isso sim foi trabalho!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714701
    m_Localized: Ok, entra
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714702
    m_Localized: É melhor você ir embora.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308953714703
    m_Localized: 'Wheelchair: Ei, toma uma EnerJeka! Obrigado por me deixar entrar!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908992
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908993
    m_Localized: 'Anger: Caralho... Mas que CARALHO...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908994
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908995
    m_Localized: 'Anger: Olha, eu faria a porra...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908996
    m_Localized: 'Anger: Que tal eu te dar uma EnerJeka, e você me deixar entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908997
    m_Localized: 'Anger: Assim todo mundo fica feliz nessa merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908998
    m_Localized: Ok, entra
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957908999
    m_Localized: Cai fora.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909000
    m_Localized: 'Anger: Não se preocupa comigo... Eu só estou... Merda... De qualquer jeito...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909001
    m_Localized: 'Anger: Pega a EnerJeka.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909002
    m_Localized: 'Anger: Acho que não preciso dessa porcaria. Seria melhor se eu conseguisse me acalmar.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909003
    m_Localized: 'Anger: :Tô vendo que {0} já está aqui. Dei uma olhada e foi óbvio: todo mundo está respirando baixinho e abaixando a cabeça, só para não serem tocados. Eu não aguento isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909004
    m_Localized: 'Anger: Detesto estar perto deles. É como se fosse essa merda dessa coisa, ou eu. Não tem outro jeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909005
    m_Localized: 'Anger: Não suporto viver com pessoas que estão sempre segurando a língua.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909006
    m_Localized: Deixa comigo. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909007
    m_Localized: É melhor ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909008
    m_Localized: 'Anger: Justo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909009
    m_Localized: 'Anger: Obrigado por falar quando realmente importa.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909010
    m_Localized: 'Anger: Vou tentar... Bom, você entendeu.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909011
    m_Localized: 'Anger: Lá vamos nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909012
    m_Localized: 'Anger: Melhor andar com quem já passou por muita coisa, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909013
    m_Localized: 'Anger: Eu não dou a mínima pra você. Pode ir pro inferno!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909014
    m_Localized: 'Fanatic: Aqui está uma generosa recompensa do PRÓPRIO Santo Sol. Você merece isso, CARA. Toma essa EnerJeka!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909015
    m_Localized: 'Fanatic: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909016
    m_Localized: 'Fanatic: Como você pode ser tão burro?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909017
    m_Localized: 'Fanatic: Vocês estão espantando um HOMEM JUSTO!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909018
    m_Localized: 'Fanatic: Por me deixar entrar, você vai receber uma generosa recompensa do próprio SANTO SOL. Reconsidere, meu bom homem!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909019
    m_Localized: Ok, entra
    m_Metadata:
      m_Items: []
  - m_Id: 17732308957909020
    m_Localized: Cai fora.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297600
    m_Localized: 'Super: Ninguém sabe o que aconteceu quando o último Visitante chegou.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297601
    m_Localized: 'Super: A casa ficou sem moradores por um bom tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297602
    m_Localized: 'Super: Depois do desaparecimento terrível, todo mundo evita a casa abandonada.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297603
    m_Localized: 'NotTrue: Ei, velho amigo... o que você tem aí, {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297604
    m_Localized: 'NotTrue: Numa hora tem barulho, na outra alguém está sussurrando nas sombras... Esse tipo de lugar me assusta.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297605
    m_Localized: 'NotTrue: Eu não ando sozinha por diversão, sabe? Não aguento quando tem muito grito ou muita gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297606
    m_Localized: 'NotTrue: Se você gosta mais deles, melhor ficar com eles. Eu vou ficar na varanda esperando o vento da mudança acalmar. Não fica bravo, mas eu não saio em tempestade assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297607
    m_Localized: 'NotTrue: Eu não aguento, vou desmoronar.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297608
    m_Localized: Eu cuido disso. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297609
    m_Localized: É melhor ir embora
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297610
    m_Localized: 'NotTrue: Quer dizer, se for esse o caso, eu vou tentar. Mas se cheirar a tempestade ou mentiras de espelho de novo, eu vou embora. Estou velha demais pra lidar com isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297611
    m_Localized: 'NotTrue: Bom, sabe, eu não sinto que pertenço aqui. Então... vou juntar minhas histórias e seguir meu caminho.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297612
    m_Localized: 'NotTrue: Mas fica de olho. Às vezes a verdade é silenciosa, mas mortal.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297613
    m_Localized: 'Twins: Por favor...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297614
    m_Localized: 'Twins: Por favor, deixa a gente entrar, mesmo que seja só por um dia. Nós temos algo...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297615
    m_Localized: 'Twins: A gente vai te recompensar...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297616
    m_Localized: Ok, entrem.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297617
    m_Localized: Cai fora.
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297618
    m_Localized: 'Twins: Muito obrigado!'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297619
    m_Localized: 'Twins: Aqui, pega uma EnerJeka. É tudo o que temos.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297620
    m_Localized: 'Twins: Agora me ajuda a trazer minha irmã pra dentro...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297621
    m_Localized: 'Twins: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297622
    m_Localized: 'Twins: Provavelmente não, {0} está aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297623
    m_Localized: 'Twins: É como se o ar estivesse mais pesado do que deveria. Como se os pensamentos de outra pessoa fossem mais altos que os meus.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297624
    m_Localized: 'Twins: Ela não consegue lidar com isso. Ela só começa... a encolher. É como se deixasse de existir.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297625
    m_Localized: 'Twins: Eu... Eu também tenho dificuldade de respirar perto disso.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297626
    m_Localized: 'Twins: Desculpa. Vamos esperar até... até as coisas acalmarem. Talvez isso passe.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297627
    m_Localized: Eu cuido disso. Entra
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297628
    m_Localized: É melhor sair
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297629
    m_Localized: 'Twins: Obrigado. Cuidado, tem que deixar uma mão nas costas dela... assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297630
    m_Localized: 'Twins: Acho que a morte dos nossos pais... quebrou algo nela. Mas ela está se aguentando o melhor que pode.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297631
    m_Localized: 'Twins: A gente já tá na rua há um tempo. Eu esperava que ela se sentisse um pouco melhor aqui, pelo menos.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297632
    m_Localized: 'Twins: ...Pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297633
    m_Localized: 'Twins: Maninha, só aguenta mais um pouco. Só temos que chegar lá. Aqui. Se apoia em mim. Eu te seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 17732308966297634
    m_Localized: 'Twins: Às vezes tudo é simplesmente... demais. Até mesmo uma porta. Mas a gente precisa continuar. Vamos lá... um pé na frente do outro.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158001
    m_Localized: 'Tourist: Bom... é uma pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068158000
    m_Localized: 'Tourist: Muito obrigado mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157995
    m_Localized: Eu não aceito subornos
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157998
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157999
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157997
    m_Localized: 'Tourist: Você tá com {0} aqui. Não sei se vamos nos dar bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157996
    m_Localized: 'Tourist: Com licença, senhor, mas temo que não posso entrar ainda.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157994
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157993
    m_Localized: 'Alt: Temos um acordo?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157992
    m_Localized: 'Alt: Tá bom. E {0}, seria o suficiente?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157991
    m_Localized: 'Alt: Já tô acostumada. E eu consigo entender onde você quer chegar com isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157990
    m_Localized: 'Alt: Uma pena que os imbecis tem toda a sorte.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157989
    m_Localized: 'Alt: Ainda tem tempo. Eu vou encontrar outra opção.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157988
    m_Localized: 'Alt: Bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157987
    m_Localized: 'Alt: Obrigada. Eu não esperava por isso, mas tinha esperança.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157986
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157985
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157984
    m_Localized: 'Alt: Mas você nunca vai nos ver juntos na mesma sala.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157983
    m_Localized: 'Alt: É uma longa história, e eu não vou despejar ela em você.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157982
    m_Localized: 'Alt: Ah, olha só, {0} tá aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157981
    m_Localized: Eu não aceito subornos
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157980
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157979
    m_Localized: 'FunnyGuy: Isso ajudaria a melhorar as coisas?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157978
    m_Localized: 'FunnyGuy: Ah, olha o que eu achei, é {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157977
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157976
    m_Localized: 'FunnyGuy: Aqui, deixa eu te dar... o que eu tenho aqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157975
    m_Localized: 'FunnyGuy: Tá bom. Última vez que caio nessa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157974
    m_Localized: 'FunnyGuy: Cara, você me lembra dos malditos bancos. Merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157973
    m_Localized: 'FunnyGuy: Tudo bem, vou indo então. Ainda tem tempo até o amanhecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157972
    m_Localized: 'FunnyGuy: Bom... entendi.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157971
    m_Localized: 'FunnyGuy: Vamos brindar pela morte das dividas, que tal? Hahaha!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157970
    m_Localized: 'FunnyGuy: Agora sim!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157969
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157968
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157967
    m_Localized: 'FunnyGuy: Eu já tive sorte podre o suficiente na minha vida. Podemos pelo menos manter esse lugar limpo?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157966
    m_Localized: 'FunnyGuy: Tá vendo aquela pessoa ali? Isso, {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157965
    m_Localized: 'FunnyGuy: Sem chance. Você tem uma pessoa aqui que vai estragar tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157964
    m_Localized: 'Fairytaller: Entendi. Eu entendo. Se cuida.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157963
    m_Localized: 'Fairytaller: Mas eu agradeço pela sua confiança!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157962
    m_Localized: 'Fairytaller: O que?! Obrigado! Você não precisava... eu poderia ter encontrado outro lugar se quisesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157961
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157960
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157959
    m_Localized: 'Fairytaller: Mas tempo que eu não me sinta confortável compartilhando o espaço com {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157958
    m_Localized: 'Fairytaller: Eu sei que já tomei muito do seu tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157957
    m_Localized: 'Fairytaller: E honestamente, não acho que essa seja culpa minha.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157956
    m_Localized: 'Fairytaller: Muito obrigado! Mas... parece que tem uma pessoa aqui com quem eu tive problemas na cafeteria antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157955
    m_Localized: Eu não aceito subornos
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157954
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157953
    m_Localized: 'Leper: Tá, e se eu der algo pra você? Tipo, {0}? Você então me deixaria entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707068157952
    m_Localized: 'Leper: De qualquer forma, é você quem manda. Eu vou embora então.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769382
    m_Localized: 'Leper: Você acha mesmo que as pessoas que ofendem as outras pela sua aparência merecem um lugar na sua casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769381
    m_Localized: 'Leper: Obrigado. Eu não queria mesmo ter que lidar com isso de novo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769380
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769379
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769378
    m_Localized: 'Leper: Você tá com {0} aqui. É essa pessoa que me provocava pela minha aparência.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769377
    m_Localized: 'Leper: Desculpa, mas acho que não posso entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769376
    m_Localized: 'Nervous: Se você se mistura com imbecis, as chances são que você também seja um. Tehehe!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769375
    m_Localized: 'Nervous: Talvez seja melhor eu não me envolver com você mesmo. Sim...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769374
    m_Localized: 'Nervous: Sério?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769373
    m_Localized: 'Nervous: Não é bom se envolver em maluquicesss.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769372
    m_Localized: 'Nervous: Parece suspeito. Mas... que seja! Tehehe!'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769371
    m_Localized: 'Nervous: Muito bom...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769370
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769369
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769368
    m_Localized: 'Nervous: Eu saberia...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769367
    m_Localized: 'Nervous: Ele é um graaaaande maluco.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769366
    m_Localized: 'Nervous: Eu sei o que aconteceu há um mês atrás. Eu sei mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769365
    m_Localized: 'Nervous: Ah... Você tá com {0} aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769364
    m_Localized: 'Bald: Cuidado por aí, viu? Espero que você sobreviva a essa merda toda.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769363
    m_Localized: 'Bald: Beleza, amigo. Entendo. Sem rancor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769362
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769361
    m_Localized: 'Bald: Droga.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769360
    m_Localized: 'Bald: É constrangedor, eu sei... ter que mandar alguém embora assim. Mas é a vida. As vezes você precisa parar de ser o bonzinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769359
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769358
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769357
    m_Localized: 'Bald: É, eu digo {0} ali. Talvez seria melhor... convidar para sair?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769356
    m_Localized: 'Bald: Cara, eu me dou bem com quase todo mundo, sério. Mas aí me complica. É alerta pra todo lado.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769355
    m_Localized: 'Tough: Isso é... decepcionante.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769354
    m_Localized: 'Tough: Não me diga que você não tem coragem.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769353
    m_Localized: 'Tough: Mas que merda? Eu achei que você iria respeitar um pouco de firmeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769352
    m_Localized: 'Tough: Acho que essa pessoa era fraca. Já que mandou ela embora tão fácil assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769351
    m_Localized: 'Tough: Hum. Não achei que iria mesmo fazer isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769350
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769349
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769348
    m_Localized: 'Tough: Ou se livra dela, ou eu vou pra outro lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769347
    m_Localized: 'Tough: Quem é aquela pessoa ali, {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769346
    m_Localized: 'Jacket: Tá bom, melhor ir indo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769345
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76820707059769344
    m_Localized: 'Jacket: Droga... a FEMA vai me encontrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722946
    m_Localized: 'Tourist: Eu queria nunca ter vindo aqui...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722945
    m_Localized: 'Tourist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722944
    m_Localized: 'Tourist: Droga... para onde eu deveria ir? Eu já tentei todas as outras casas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722943
    m_Localized: 'Tourist: Eu agradeço.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722942
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722941
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722940
    m_Localized: 'Tourist: Por favor, deixa eu ficar aqui com você.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722939
    m_Localized: 'Tourist: Então agora não tenho para onde ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722938
    m_Localized: 'Tourist: Eu fiquei em um hotel por um tempo, mas o dinheiro acabou.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722937
    m_Localized: 'Tourist: Não...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722936
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722935
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722934
    m_Localized: 'Tourist: Mas estou aqui agora, e não posso pagar um hotel. Por favor, deixa eu ficar aqui com você.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722933
    m_Localized: 'Tourist: É, deu para perceber. Acredite, se eu soubesse o que ia acontecer com o sol, nunca teria vindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722932
    m_Localized: Você não tem mesmo pra onde ir?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722931
    m_Localized: Você escolheu uma hora e tanto pra turistar.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722930
    m_Localized: 'Tourist: Só estou de passagem mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722929
    m_Localized: 'Tourist: Mas então eles fecharam as fronteiras... e agora estou preso aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722928
    m_Localized: 'Tourist: Eu estava indo para a capital, planejando uma viagem...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722927
    m_Localized: Você não tem mesmo pra onde ir?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722926
    m_Localized: Você escolheu uma hora e tanto pra turistar
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722925
    m_Localized: 'Tourist: O aeroporto fechou, os trens também.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722924
    m_Localized: 'Tourist: Teve um engano. Eu não consigo sair da cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722923
    m_Localized: Como você acabou aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722922
    m_Localized: Qual o problema?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722921
    m_Localized: 'Tourist: Ei. Você pode me ajudar? Eu não sou daqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722920
    m_Localized: 'Alt: Certo. Melhor ir andando então.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722919
    m_Localized: 'Alt: Ainda tem algumas casas por aqui. Talvez alguém vá ignorar o meu rosto e finalmente agir como um ser humano decente.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722918
    m_Localized: 'Alt: Foi uma semana intensa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722917
    m_Localized: 'Alt: Então vamos conversar amanhã. Tô acabada por hoje.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722916
    m_Localized: 'Alt: Perfeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722915
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722914
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722913
    m_Localized: 'Alt: A pior parte é ouvir outro relato e perceber que você precisa multiplicar o horror por cinco... talvez até dez.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722912
    m_Localized: 'Alt: A TV não torna as coisas mais fáceis de qualquer forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722911
    m_Localized: 'Alt: Não sei se você tem eletricidade, mas se não tiver melhor ainda.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722910
    m_Localized: 'Alt: O ar fica mais fresco aqui durante a noite. E ninguém tá grudado no noticiário o dia todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722909
    m_Localized: 'Alt: Vou pular as formalidades e ir direto ao ponto.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722908
    m_Localized: 'Alt: Claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722907
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722906
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722905
    m_Localized: 'Alt: E eu prefiro não estar nas primeira fileiras quando começar.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722904
    m_Localized: 'Alt: Acho que estamos indo em direção a um total show de horrores.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722903
    m_Localized: 'Alt: Quanto mais isso se arrastar, pior vai ficar. Sem ar, mais crimes, a paranóia crescendo naqueles condomínios.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722902
    m_Localized: 'Alt: Além do mais, eu sinto que as cidades não vão ficar seguras por muito mais tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722901
    m_Localized: 'Alt: Eu só não curto formalidades. Facilita ser mais objetiva.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722900
    m_Localized: 'Alt: O que faz você pensar que eu tô fugindo de algo?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722899
    m_Localized: Você acha que vai ser melhor aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722898
    m_Localized: Do que você está fugindo?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722897
    m_Localized: 'Alt: A minha aparência não significa nada. Eu não desejo machucar ninguém. E eu espero que você não seja do tipo que julga.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722896
    m_Localized: 'Alt: Eu não fiz nada errado. E você pode parar com o olhar de julgamento, se é isso que tá rolando aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722895
    m_Localized: 'Alt: Ei, pra que tanta ignorância?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722894
    m_Localized: Você acha que vai ser melhor aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722893
    m_Localized: Do que você está fugindo?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722892
    m_Localized: 'Alt: Como se os maníacos e Visitantes não fossem o suficiente, agora o sol quer nos foder também.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722891
    m_Localized: 'Alt: E não só na nossa cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722890
    m_Localized: 'Alt: É só que... Eu ouvi que umas coisas bem ruins tavam acontecendo por esses lados.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722889
    m_Localized: 'Alt: Não, eu não quis dizer que a sua casa parece abandonada.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722888
    m_Localized: Você é ousada
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722887
    m_Localized: Por acaso parece vazio?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722886
    m_Localized: 'Alt: Ah, então tem alguém aqui. Se importa se eu entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722885
    m_Localized: 'FunnyGuy: Eh, vou pensar em algo. Ainda tem tempo até o amanhecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722884
    m_Localized: 'FunnyGuy: Porra.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722883
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722882
    m_Localized: 'FunnyGuy: Sem chance nenhuma?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722881
    m_Localized: 'FunnyGuy: Você não tem ideia de como esse dia é significativo pra mim!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722880
    m_Localized: 'FunnyGuy: Assim que se fala! Vamos abrir umas geladas e celebrar!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722879
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722878
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722877
    m_Localized: 'FunnyGuy: Então, vai me deixar entrar ou o quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722876
    m_Localized: 'FunnyGuy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722875
    m_Localized: 'FunnyGuy: Se eu tivesse uma casa assim, estaria vivendo meu sonho, isso é certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722874
    m_Localized: 'FunnyGuy: Tanto faz. Não é o seu empréstimo pra pagar, né? Você tem uma casa boa aqui, afinal de contas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722873
    m_Localized: 'FunnyGuy: Vou fazer o quê? Você obviamente não está feliz por mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722872
    m_Localized: Não é muito de falar, pelo jeito
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722871
    m_Localized: 'FunnyGuy: Não sou muito fã disso, pra ser honesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722870
    m_Localized: 'FunnyGuy: Tá bom, isso pareceu super sarcástico.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722869
    m_Localized: Não é muito de falar, pelo jeito
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722868
    m_Localized: 'FunnyGuy: Sem ofensas.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722867
    m_Localized: 'FunnyGuy: Pra ser sincero, eu preferia não falar sobre isso aqui fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722866
    m_Localized: 'FunnyGuy: Caramba, é uma boa pergunta.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722865
    m_Localized: Então o que você vai fazer com todo o dinheiro que economizou?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722864
    m_Localized: E... o que você tá fazendo aí fora?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722863
    m_Localized: 'FunnyGuy: É incrível!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722862
    m_Localized: 'FunnyGuy: Com todo esse caos acontecendo, ninguém dá a mínima pra bancos ou empréstimos!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722861
    m_Localized: 'FunnyGuy: Agora eu não devo nada!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722860
    m_Localized: 'FunnyGuy: MAS AGORA!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722859
    m_Localized: 'FunnyGuy: Tava tudo indo por água abaixo, sabe?'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722858
    m_Localized: 'FunnyGuy: Bom, eu tava com dívida até o pescoço.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722857
    m_Localized: Então o que você vai fazer com todo o dinheiro que economizou?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722856
    m_Localized: E... o que você tá fazendo aí fora?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722855
    m_Localized: 'FunnyGuy: É como se eu pudesse finalmente respirar. Você não tem noção.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722854
    m_Localized: 'FunnyGuy: Amigo... não... Irmão! Minha hipoteca não é mais problema meu!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722853
    m_Localized: 'FunnyGuy: Ah, não seja assim! Você só não entendeu ainda.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722852
    m_Localized: Por que tão feliz?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722851
    m_Localized: Você é maluco ou o que?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722850
    m_Localized: 'FunnyGuy: Que noite, hein? Você tá sentindo? Pura magia!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722849
    m_Localized: 'FunnyGuy: Ei, ei, ei, qual é!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722848
    m_Localized: 'Fairytaller: Bom. Eu entendo. Se cuida.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722847
    m_Localized: 'Fairytaller: É bom saber que boas pessoas ainda existem, e não só nas histórias.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722846
    m_Localized: 'Fairytaller: Muito obrigado! Eu não vou esquecer isso!'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722845
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722844
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722843
    m_Localized: 'Fairytaller: Eu nunca pensei que a vida adulta ia começar tão difícil assim... e eu não tenho mais nenhum lugar pra ir...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722842
    m_Localized: 'Fairytaller: Eu vou te retribuir um dia. E eu posso ajudar agora, do jeito que puder.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722841
    m_Localized: 'Fairytaller: Eu sei que não tenho muito a oferecer... mas por favor, pense melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722840
    m_Localized: 'Fairytaller: Entendi...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722839
    m_Localized: Eu não preciso de folgados aqui. Se manda.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722838
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722837
    m_Localized: 'Fairytaller: Eu duvido que eu possa ser nosso salvador. Mas em toda a história, o bem sempre vence no final.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722836
    m_Localized: 'Fairytaller: Se pelo menos um herói pudesse aparecer para derrotar o verdadeiro mal, então tudo poderia voltar a ser como era antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722835
    m_Localized: 'Fairytaller: A pessoas se assustam, se escondem, param de confiar umas nas outras...'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722834
    m_Localized: 'Fairytaller: Tudo parece um pouco com os contos de fadas que cresci ouvindo. Aqueles onde o mal se espalha pelo mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722833
    m_Localized: 'Fairytaller: Mas eu acho que sou a mesma pessoa que sempre fui. Pelo menos não sinto o desejo de machucar ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722832
    m_Localized: 'Fairytaller: Talvez eu tenha alguns dos sinais. Eu não sei. Tudo tem sido tão estranho ultimamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722831
    m_Localized: 'Fairytaller: Pra ser sincero, eu ainda não sei quem são esses Visitantes exatamente, ou o que torna eles diferentes de nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722830
    m_Localized: Eu não preciso de folgados aqui. Se manda.
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722829
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722828
    m_Localized: 'Fairytaller: Eu vou tentar ser útil até me restabelecer. E eu prometo que um dia vou retribuir o favor.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722827
    m_Localized: 'Fairytaller: Eu odeio ser um problema para as pessoas. Mas quando as coisas ficam difíceis, você faz o que precisar pra sobreviver.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722826
    m_Localized: 'Fairytaller: Ele botou os parentes dele no lugar logo depois. Não posso dizer que culpo ele. Mas espero que possa ver meu lado também.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722825
    m_Localized: 'Fairytaller: Então depois que isso tudo começou, ele me mandou embora, disse que era por causa do meu desemprego.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722824
    m_Localized: 'Fairytaller: O proprietário de onde moro não queria alugar para um recém formado sem renda fixa.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722823
    m_Localized: 'Fairytaller: ... Assim como quando éramos crianças.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722822
    m_Localized: 'Fairytaller: Quando os tempos ficam difíceis, as pessoas simplesmente querem se desligar um pouco... ficarem despreocupadas por um momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722821
    m_Localized: 'Fairytaller: Acho que quem conseguiu bicos em casas noturnas deu sorte. Parece que as coisas acabaram melhores pra eles no fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722820
    m_Localized: 'Fairytaller: Mas depois de tudo que aconteceu, as pessoas pararam de aparecer, e nos tornou irrelevantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722819
    m_Localized: 'Fairytaller: Eu recém terminei a faculdade, mas encontrar um trabalho na minha área tem sido difícil, então eu peguei uns turnos em uma cafeteria.'
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722818
    m_Localized: Como eu vou saber que você não é um Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722817
    m_Localized: O que traz você aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 76327285458722816
    m_Localized: 'Fairytaller: Boa noite. Alguma chance de você ter espaço pra mais alguém aí? Eu não preciso de muito.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039811
    m_Localized: 'Leper: Tá bom então. Como você quiser Tô indo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039810
    m_Localized: 'Leper: Obrigado... por me deixar entrar. E, bem, não fazer um alarde sobre minha aparência.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039809
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039808
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039807
    m_Localized: 'Leper: Então, vai me deixar entrar ou não?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039806
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039805
    m_Localized: 'Leper: Por que eu sei o que eu sou. E eu não sou um deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039804
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039803
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039802
    m_Localized: 'Leper: Então, vai me deixar entrar ou não?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039801
    m_Localized: 'Leper: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039800
    m_Localized: 'Leper: Tanto faz.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039799
    m_Localized: O que faz você ter tanta certeza?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039798
    m_Localized: Isso vamos descobrir
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039797
    m_Localized: 'Leper: Eu tô dizendo, não sou um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039796
    m_Localized: 'Leper: Como assim, “o que eu esperava”? Se liga. Você acha que eu escolhi ser assim?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039795
    m_Localized: O que faz você ter tanta certeza?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039794
    m_Localized: Isso vamos descobrir
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039793
    m_Localized: 'Leper: Eu entendo, mas eu não sou um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039792
    m_Localized: O que você esperava?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039791
    m_Localized: Todos estão paranóicos ultimamente
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039790
    m_Localized: 'Leper: É congênito. Eu não posso fazer nada quanto a isso. Mas, por alguma razão, as pessoas pensam que eu sou um Visitante. Isso é insano.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039789
    m_Localized: 'Leper: É exatamente isso que eu digo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039788
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039787
    m_Localized: O que você esperava?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039786
    m_Localized: Todos estão paranóicos ultimamente
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039785
    m_Localized: 'Leper: Não param de falar que sou contagioso... ou pior, um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039784
    m_Localized: 'Leper: Eu só nasci com uma pele ruim. Só isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039783
    m_Localized: 'Leper: Não! Esse é o problema. Não tem nada errado comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039782
    m_Localized: O que aconteceu com a sua pele?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039781
    m_Localized: Eu devo me preocupar?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039780
    m_Localized: 'Leper: Ei. Espero que eu não tenha uma aparência muito ferrada pra ser deixado entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039779
    m_Localized: 'Nervous: Tehehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039778
    m_Localized: 'Nervous: Vai vendo pra onde isso te leva... Marque minhas palavras...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039777
    m_Localized: 'Nervous: Você não é diferente daqueles torturadore...s em jalecos.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039776
    m_Localized: 'Nervous: Com um parafuzinho a menos? Hum?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039775
    m_Localized: 'Nervous: Então... você acha que eu sou loooouco também?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039774
    m_Localized: 'Nervous: Um lugar onde posso esperar passar essa loucura...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039773
    m_Localized: 'Nervous: Finalmente!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039772
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039771
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039770
    m_Localized: 'Nervous: Além disso, eu ouvi tiros por perto. Mas você leva a segurança mais a sério. Siiiim...?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039769
    m_Localized: 'Nervous: Agora eu tento... me entrosar com novas pessoas!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039768
    m_Localized: 'Nervous: Um deles teve o que mereci...a, mas eu tenho mais cuidado agora. Tehehe!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039767
    m_Localized: 'Nervous: Todos me querem mal. Todos os imbecis... desde a escola.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039766
    m_Localized: 'Nervous: Que amigos?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039765
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039764
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039763
    m_Localized: 'Nervous: Preferia voltar pro hotel.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039762
    m_Localized: 'Nervous: Entãããão... Eu não tenho interesse em tentar de novo! Tehehe!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039761
    m_Localized: 'Nervous: Eles me ajudaram uma vez, mas nem se importam!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039760
    m_Localized: 'Nervous: Eu fui meio que um aciden...te. E oops aqui estou!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039759
    m_Localized: Você não tem amigos?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039758
    m_Localized: Por que você não vai ficar com seus parentes?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039757
    m_Localized: 'Nervous: Eu vou te contar tudo sobre isso... depois. Tehehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039756
    m_Localized: 'Nervous: Os quartos de hotel são pequeninhos. Me lem...bra de... tempos ruins.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039755
    m_Localized: 'Nervous: Sua casa é grande o suficiente para todos os tamanhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039754
    m_Localized: 'Nervous: Bom lá. Melhor aqui. Tehehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039753
    m_Localized: Você não tem amigos?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039752
    m_Localized: Por que você não vai ficar com seus parentes?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039751
    m_Localized: 'Nervous: A FEMA veio e então eles foram... sumidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039750
    m_Localized: 'Nervous: Eu não tenho como provar isso, não não... Mas eu acho que ela é uma Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039749
    m_Localized: 'Nervous: Ela me assusta, tehehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039748
    m_Localized: 'Nervous: Tem uma menina com uma capa de chuva amarela lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039747
    m_Localized: 'Nervous: Eu não gosto. Prefiro achar outr...o lugar'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039746
    m_Localized: Você acha que vai ser melhor aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039745
    m_Localized: Por quê? Não pode só voltar?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039744
    m_Localized: 'Nervous: Eu tenho me...do de voltar, posso ficar aqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039712
    m_Localized: 'Tough: Isso é um teste?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039711
    m_Localized: 'Tough: Vamos conversar outra hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039710
    m_Localized: 'Tough: Sabe, me sinto honrada. De estar aqui, agora, quando nossas vidas estão em pedaços.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039709
    m_Localized: 'Tough: Ótimo!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039708
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039707
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039706
    m_Localized: 'Tough: A vida é sobre ir contra a maré. Nada vem fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039705
    m_Localized: 'Tough: Só sobrevivemos quando lutamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039704
    m_Localized: 'Tough: Eu só acho que se ficarmos parados deixando as coisas acontecerem, a humanidade já era.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039703
    m_Localized: 'Tough: Ah. Desculpa se eu passei a impressão errada.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039702
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039701
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039700
    m_Localized: 'Tough: A humanidade já sobreviveu coisa pior. Por que deveríamos desistir agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039699
    m_Localized: 'Tough: Mas eu definitivamente não estou desesperada.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039698
    m_Localized: 'Tough: Ah, você quer saber por que eu vim? Hah. Vai saber. Talvez eu seja maluca.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039697
    m_Localized: 'Tough: O que?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039696
    m_Localized: Você parece meio maluca
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039695
    m_Localized: Você também está desesperada?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039694
    m_Localized: 'Tough: Iremos sobreviver, não importa o que seja.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039693
    m_Localized: 'Tough: Eu não poderia só passar reto por um lugar assim. Acho que nos entendemos, você e eu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039692
    m_Localized: 'Tough: Que você não deixa os Visitantes tomarem a única coisa que é sua por direito. ... A vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039691
    m_Localized: 'Tough: Que sobreviver aqui não é fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039690
    m_Localized: Você parece meio maluca
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039689
    m_Localized: Você também está desesperada?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039688
    m_Localized: 'Tough: Mas você não é um deles. Você não vai desistir sem lutar.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039687
    m_Localized: 'Tough: Os mais corajosos apontam uma arma para a própria cabela. Os outros só definham, um dia de cada vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039686
    m_Localized: 'Tough: A maioria das pessoas já desistiu. Muito fracos pra continuarem vivendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039685
    m_Localized: 'Tough: Não, sério.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039684
    m_Localized: Hum... Exatamente O QUE falam sobre a minha casa?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039683
    m_Localized: Obrigado?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039682
    m_Localized: 'Tough: Mas você tem meu respeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039681
    m_Localized: 'Tough: Aqueles que vem aqui estão ou desesperados... ou são burros.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039680
    m_Localized: 'Tough: A maioria das pessoas fica longe da sua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346842873856
    m_Localized: 'Tough: Eu ouvi falar de você.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417961
    m_Localized: 'Jacket: Aqui, eu tenho isso aqui. É {0}. Não é muito, mas espero que ajude.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417960
    m_Localized: 'Jacket: Muito obrigado.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417959
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417958
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417957
    m_Localized: 'Jacket: Ah... desculpa, mas {0} tá aqui. Eu não confio em gente assim...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417956
    m_Localized: Eu não aceito subornos
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417955
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417954
    m_Localized: 'Jacket: Se você quiser eu tenho isso. É {0}. Isso ajudaria a mudar sua decisão?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417953
    m_Localized: 'Jacket: Eu não quero dar de cara com uma patrulha. Ou pior, com os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417952
    m_Localized: 'Jacket: Não, por favor... Deixa eu entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417951
    m_Localized: 'Jacket: Aqui, pode ficar com isso. É {0}. Não é muito, mas espero que ajude.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417950
    m_Localized: 'Jacket: Muito obrigado.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417949
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417948
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417947
    m_Localized: 'Jacket: Eu não quero ir pra uma delas.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417946
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417945
    m_Localized: 'Jacket: Mas eu ouvi dizer que estavam levando os infectados para zonas de quarentena...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417944
    m_Localized: 'Jacket: Eles apareceram um dia e disseram que tinham que inspecionar todo mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417943
    m_Localized: 'Jacket: FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417942
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417941
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417940
    m_Localized: 'Jacket: Eu não quero acabar em uma zona de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417939
    m_Localized: 'Jacket: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417938
    m_Localized: 'Jacket: Eles começaram a juntar as pessoas... E eu...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417937
    m_Localized: 'Jacket: FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417936
    m_Localized: O que aconteceu com o seu dormitório?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417935
    m_Localized: Por quê?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417934
    m_Localized: 'Jacket: Eu costumava morar em um dormitório de faculdade, mas precisei sair...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417933
    m_Localized: 'Jacket: Sim. Por favor... se for tudo bem, só me deixa entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417932
    m_Localized: O que aconteceu com o seu dormitório?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417931
    m_Localized: Por quê?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417930
    m_Localized: 'Jacket: O dormitório não é mais uma opção...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417929
    m_Localized: 'Jacket: Sim, preciso de um lugar para ficar. Eu não tenho pra onde ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417928
    m_Localized: Está buscando abrigo?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417927
    m_Localized: Você precisa de algo?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417926
    m_Localized: 'Jacket: Olá. Você poderia por favor me deixar entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417925
    m_Localized: 'Experienced: Boa escolha, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417924
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417923
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417922
    m_Localized: 'Experienced: Sabe, {0}? Já vi esse tipo antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417921
    m_Localized: 'Experienced: Olha amigo. Você tem uma pessoa podre aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417920
    m_Localized: 'Experienced: Adios, imbecil.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417919
    m_Localized: 'Experienced: Ora, cê é um comediante mesmo, não é.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417918
    m_Localized: 'Experienced: Boa escolha, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417917
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417916
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417915
    m_Localized: 'Experienced: Enfim, chega de papo. Vai me deixar ficar aqui ou não?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417914
    m_Localized: 'Experienced:'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417913
    m_Localized: 'Experienced: Sem dinheiro, a patroa se juntou com outro palhaço, e não tenho um teto pra me abrigar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417912
    m_Localized: 'Experienced: A contagem acaba, e cê sai pelo portão.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417911
    m_Localized: 'Experienced: Eu teria ficado, certamente. Mas cê acha que alguém me perguntou?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417910
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417909
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417908
    m_Localized: 'Experienced: Enfim, chega de papo. Vai me deixar ficar aqui, amigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417907
    m_Localized: 'Experienced: No subúrbio sem idiotas bisbilhotando. Lugar legal.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417906
    m_Localized: 'Experienced: Então eu vi esse lugar: limpo, quieto, fora do caminho.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417905
    m_Localized: 'Experienced: Sem dinheiro, a patroa se juntou com outro palhaço, e não tenho um teto pra me abrigar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417904
    m_Localized: 'Experienced: Não tem lugar nenhum pra ir, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417903
    m_Localized: Por que você não ficou na cadeia?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417902
    m_Localized: E o que diabos você tá fazendo na minha casa?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417901
    m_Localized: 'Experienced: Acho que tô de volta nas ruas.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417900
    m_Localized: 'Experienced: E agora? O mundo todo foi pro caralho. O sol tá torando como se quisesse fritar minhas bolas.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417899
    m_Localized: 'Experienced: Teria ficado mais, mas me chutaram pra fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417898
    m_Localized: 'Experienced: Fiz um tempo lá dentro, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417897
    m_Localized: Por que você não ficou na cadeia?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417896
    m_Localized: E o que diabos você tá fazendo na minha casa?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417895
    m_Localized: 'Experienced: Já eu, tenho experiência. A primeira coisa que eu fiz depois de voltar pra rua foi arrancar tudo fora. Agora tô conseguindo respirar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417894
    m_Localized: 'Experienced: Andando por aí como se estivesse nevando ou algo assim. Um bando de palhaços.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417893
    m_Localized: 'Experienced: Não é óbvio? Tá mais quente que o cu do diabo aqui fora. Não entendo por que o resto das pessoas ainda não se deu conta.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417892
    m_Localized: De onde diabos você veio?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417891
    m_Localized: Por que você está andando por aí só de cueca?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417890
    m_Localized: 'Experienced: Que tal me deixar entrar, amigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417889
    m_Localized: 'Rocker: Se não for você, outra pessoa vai me deixar entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417888
    m_Localized: 'Rocker: Foda-se.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417887
    m_Localized: 'Rocker: Mas sem uma guitarra... não é a mesma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417886
    m_Localized: 'Rocker: Beleza, isso aí!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417885
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417884
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417883
    m_Localized: 'Rocker: Sim, {0}, é dessa pessoa que eu falo. Se livra dessa pessoa, falou?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417882
    m_Localized: 'Rocker: Ah, eu não chegaria nem perto desse tipo de lixo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417881
    m_Localized: 'Rocker: Vou tentar colar na casa de um dos meuis amigos. Espero que os poucos que sobraram não tenham morrido ainda...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417880
    m_Localized: 'Rocker: Entendido, irmão. Sem ressentimentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417879
    m_Localized: 'Rocker: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417878
    m_Localized: 'Rocker: ... Ou não! Você que manda, cara!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417877
    m_Localized: 'Rocker: Valeu, cara. Vou fazer um som de vez em quando, se for tudo bem. Se eu conseguir uma guitarra, toco algo pra você.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417876
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417875
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417874
    m_Localized: 'Rocker: E honestamente, se eu fosse um Visitante, estaria chutando a porta ou entrando pela janela. Mas ao invés disso só... tô aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417873
    m_Localized: 'Rocker: Esses filhos da puta até detonaram a minha guitarra. Toda essa merda tá transformando as pessoas em animais, cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417872
    m_Localized: 'Rocker: Toquei um show até o amanhecer, então uns esquisitos aparecerem no nosso ponto e começaram a roubar as coisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417871
    m_Localized: 'Rocker: Por que eu não perdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417870
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417869
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417868
    m_Localized: 'Rocker: Ouvi dizer que encontraram um Visitante por perto. Agora tão verificando todos. Tudo bem por mim, desde que ninguém pire a cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417867
    m_Localized: 'Rocker: Nada de mais. Só um mini amplificador e umas garrafas de água. Eu deixo você usar o amplificador se souber mandar ver na guitarra mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417866
    m_Localized: Por que parece que você não dorme faz uma semana?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417865
    m_Localized: O que você tá carregando aí?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417864
    m_Localized: 'Rocker: Tá tudo uma merda agora, é tipo receber um astro mundial num boteco sem nem um segurança!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417863
    m_Localized: 'Rocker: Ah, um aproveitador.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417862
    m_Localized: 'Rocker: Deixa eu ficar aí por umas noites. Não vou ficar pra sempre. Não sou um... Hum... Qual a palavra?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417861
    m_Localized: 'Rocker: Ei cara, abre aí. O sol tá forte pra caramba. Eu vou ficar cego desse jeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417860
    m_Localized: 'Unstable: Vou tentar entrar nessa. Parece interessante.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417859
    m_Localized: 'Unstable: E aí ele atira elas no fogo!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417858
    m_Localized: 'Unstable: Ouvi histórias sobre um esquisito reunindo pessoas, fazendo lavagem cerebral.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417857
    m_Localized: 'Unstable: Tá bom, eu vou ver o que tá rolando em outro lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417856
    m_Localized: 'Unstable: Sem graça. Sempre a mesma coisa...'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417855
    m_Localized: 'Unstable: Beleza, até.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417854
    m_Localized: 'Unstable: Eu me pergunto quanto dinheiro ele fez com essa baboseira.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417853
    m_Localized: 'Unstable: Ouvi dizer que tem um cara vendendo ar. Só faltava essa!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417852
    m_Localized: 'Unstable: Sem problemas, eu vou dar um pulo em outros lugares.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417851
    m_Localized: 'Unstable: Bom, eu vou te contar várias coisas diferentes então!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417850
    m_Localized: 'Unstable: Foi mal, eu pensei que seria muito engraçado.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417849
    m_Localized: 'Unstable: Hahaha, eu nem sabia quem era essa pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417848
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417847
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417846
    m_Localized: 'Unstable: Fazem uma bagunça. Sem chance, tô fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417845
    m_Localized: 'Unstable: Eu não gosto de conversar com gente assim em volta. Essas pessoas distorcem toda a história em coisas diferentes'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417844
    m_Localized: 'Unstable: Uou, você tá com {0} aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417843
    m_Localized: Eu não aceito subornos
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417842
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417841
    m_Localized: 'Unstable: Aqui, {0}. Quer?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417840
    m_Localized: 'Unstable: Ou... peraí.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417839
    m_Localized: 'Unstable: Quer uma Enerjeka? Mas eu tenho mais do que só isso!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417838
    m_Localized: 'Unstable: Pena. Peraí, tenho várias coisas aqui comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417837
    m_Localized: 'Unstable: Eu vou contribuir também, tenho minhas próprias histórias. Vamos bater um papo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417836
    m_Localized: 'Unstable: Então você vai me dizer o que tá acontecendo por aqui, combinado?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417835
    m_Localized: 'Unstable: Ah, legal!'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417834
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417833
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417832
    m_Localized: 'Unstable: Enfim, eu tô ficando cansado de estar em pé aqui na sua porta. Se você me deixar entrar, eu vou dizer o que eu vi.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417831
    m_Localized: 'Unstable: Não são as melhores estratégias, honestamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417830
    m_Localized: 'Unstable: As pessoas entram em pânico, elas ou não abrem ou atiram em tudo que se move.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417829
    m_Localized: 'Unstable: Vi alguns lugares interessantes, mas no geral é só sempre mesma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417828
    m_Localized: 'Unstable: Eu já disse. Só estou observando como as pessoas sobrevivem.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417827
    m_Localized: 'Unstable: Você não tá ouvindo?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417826
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417825
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417824
    m_Localized: 'Unstable: Você me deixaria entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417823
    m_Localized: 'Unstable: Mas acho que sua casa parece interessante.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417822
    m_Localized: 'Unstable: Eu vou continuar correndo até encontrar o que eu procuro... seja lá o que for isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417821
    m_Localized: 'Unstable: E aí eu corro.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417820
    m_Localized: Você tá fugindo de alguém?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417819
    m_Localized: E aí o que?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417818
    m_Localized: 'Unstable: Deveríamos compartilhar estratégias de sobrevivência, heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417817
    m_Localized: 'Unstable: Mas ei, eu não morri também! Parece que ambos descobrimos algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417816
    m_Localized: 'Unstable: Bom, sim, você tá vivo. Falando comigo... realmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417815
    m_Localized: 'Unstable: E você tá preso aqui. Você acha que é isso que te mantém seguro?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417814
    m_Localized: Você tá correndo de algo?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417813
    m_Localized: E aí o que?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417812
    m_Localized: 'Unstable: Pro inferno com isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417811
    m_Localized: 'Unstable: Sozinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417810
    m_Localized: 'Unstable: Eu só iria morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417809
    m_Localized: 'Unstable: Se eu ficasse no meu apartamento nunca iria descobrir.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417808
    m_Localized: 'Unstable: Vai saber, talvez você tenha a última esperança da humanidade guardada aí em algum lugar da sua casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417807
    m_Localized: 'Unstable: Quanto mais longe eu vou, mais chances eu tenho de encontrar uma solução. Você não entende, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417806
    m_Localized: 'Unstable: Como assim?'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417805
    m_Localized: Não da pra fugir do problema
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417804
    m_Localized: Não vai tentar buscar abrigo?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417803
    m_Localized: 'Unstable: Eu me movimento à noite. Então sim, eu vou entrar antes do sol me cozinhar.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417802
    m_Localized: 'Unstable: Tem o suficiente pra durar, tipo, um MONTE. Nem me pergunte onde eu guardo ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417801
    m_Localized: 'Unstable: Eu tenho minha confiável Enerjeka comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417800
    m_Localized: Não da pra fugir do problema
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417799
    m_Localized: Não vai tentar buscar abrigo?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417798
    m_Localized: 'Unstable: Eu vou continuar me mexendo até fritar. Ou até o Visitantes me devorarem. Seja o que vier primeiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417797
    m_Localized: 'Unstable: Uma tempestade se aproxima. E eu tô meio curioso pra ver como as pessoas irão lidar com ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417796
    m_Localized: 'Unstable: Pra algum lugar bem longe. Não dá pra ficar em um lugar só.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417795
    m_Localized: Eu não tenho nenhum carregador aqui.
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417794
    m_Localized: Onde você vai, energizado desse jeito?
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417793
    m_Localized: 'Unstable: Eu tô mega vidrado agora. Mas a Enerjeka não tá batendo igual antes. Queria dar uma recarregada.'
    m_Metadata:
      m_Items: []
  - m_Id: 73440359936417792
    m_Localized: 'Unstable: Ah, ei! Tem gente aqui. Boa!'
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264643
    m_Localized: (Pegar a entrega)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264642
    m_Localized: (Pegar a entrega)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264641
    m_Localized: (Pegar a entrega)
    m_Metadata:
      m_Items: []
  - m_Id: 61235119057264640
    m_Localized: (Pegar a entrega)
    m_Metadata:
      m_Items: []
  - m_Id: 61235008206004224
    m_Localized: Pular introdução
    m_Metadata:
      m_Items: []
  - m_Id: 58250202329374720
    m_Localized: Eu vou expulsar. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 58250202325180416
    m_Localized: 'TV: Se você está impossibilitado de transferir imediatamente algum indivíduo suspeito de ser Visitante para uma zona de quarentena, emita para o suspeito um Comprovante de Comparecimento Obrigatório.'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306408796160
    m_Localized: 'MushroomEater: Parece que, no fim das contas, o Festival ainda vai acontecer...'
    m_Metadata:
      m_Items: []
  - m_Id: 57947306387824640
    m_Localized: 'MushroomEater: Ah, meu garoto... Isso não é bom...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692481
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206428692480
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177088
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205570
    m_Localized: 'Gasmask: Tudo bem, então. Tchau.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205569
    m_Localized: 'Gasmask: Deve ser uma barra pra você. Pra gente. Como é que a gente verifica um distrito que não tem gente nele?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336340205568
    m_Localized: 'Gasmask: Você está só?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336336011264
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283083
    m_Localized: 'MushroomEater: Até logo.'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283082
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283081
    m_Localized: 'MushroomEater: Ah... talvez eu só esteja desperdiçando tempo...'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490353283080
    m_Localized: 'MushroomEater: Olá, meu garoto. Me diga, você esqueceu do pequeno favor que eu lhe pedi? Você não percebeu as dicas escondidas no Livro do Sorriso?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311553
    m_Localized: 'Fanatic: {0}. Deixa eu entrar e você ganha essa generosa recompensa diretamente do GRANDE SOL. Já mudou de opinião?'
    m_Metadata:
      m_Items: []
  - m_Id: 53209490332311552
    m_Localized: 'Fanatic: Aqui tá uma recompensa generosa do próprio GRANDE SOL! Você merece, CARA!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656006
    m_Localized: 'Jacob: E você e eu... a gente vai se encontrar outra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656005
    m_Localized: 'Jacob: Mas eu não vou morrer. Nunca.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656004
    m_Localized: 'Jacob: Deixar pessoas quase morrendo na entrada da sua casa? Isso é errado.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656003
    m_Localized: 'Jacob: Então, tem uma coisa que você precisa aprender:'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656002
    m_Localized: 'Jacob: Por que, você e eu... nós somos imortais.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656001
    m_Localized: 'Jacob: Pessoas como você, são essas as que vão sobreviver nesse apocalipse.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783656000
    m_Localized: 'Jacob: Hoje em dia não se encontra mais pessoas que escutam de verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655999
    m_Localized: 'Jacob: Obrigado.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655998
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655997
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655996
    m_Localized: 'Jacob: Eu sei exatamente de onde vieram os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655995
    m_Localized: 'Jacob: E eu vou te contar tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655994
    m_Localized: 'Jacob: Eu juro, assim que a FEMA sair eu sigo na minha busca pela minha filha.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655993
    m_Localized: 'Jacob: O governo não quer que ninguém descubra isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655992
    m_Localized: 'Jacob: A FEMA está procurando por mim por eu saber de coisas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655991
    m_Localized: 'Jacob: Eu preciso de um abrigo por alguns dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655990
    m_Localized: 'Jacob: Espera, calma aí!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655989
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655988
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655987
    m_Localized: 'Jacob: Eu sei exatamente de onde vieram os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655986
    m_Localized: 'Jacob: E eu vou te contar tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655985
    m_Localized: 'Jacob: Aí eu sigo o meu rumo, procurando pela minha filha.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655984
    m_Localized: 'Jacob: Me deixa ficar aqui por uns dias, até a FEMA sair da área.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655983
    m_Localized: 'Jacob: Se levaram, não vão encostar nela. Sou eu quem eles querem.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655982
    m_Localized: 'Jacob: Talvez aqueles malditos tenham levado a minha filha, mas talvez não.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655981
    m_Localized: 'Jacob: Olha, eu estou sendo procurado por saber demais sobre eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655980
    m_Localized: 'Jacob: Resumindo, um lugar bem longe daqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655979
    m_Localized: 'Jacob: Em algum lugar onde a FEMA não encontre a gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655978
    m_Localized: Ela não está aqui. Tchau
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655977
    m_Localized: Para onde você quer ir?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655976
    m_Localized: 'Jacob: Assim que eu encontrar ela, a gente vai dar o fora dessa cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655975
    m_Localized: 'Jacob: Não faço ideia de onde ela pode estar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655974
    m_Localized: 'Jacob: Estou procurando por ela desde que toda essa bagunça começou.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655973
    m_Localized: 'Jacob: É melhor não falar assim da minha filha.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655972
    m_Localized: Ela não está aqui. Tchau
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655971
    m_Localized: Onde você quer ir?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655970
    m_Localized: 'Jacob: Sem bilhete, sem rastros. Minha filha só desapareceu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655969
    m_Localized: 'Jacob: Quando acordei, não tinha ninguém em casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655968
    m_Localized: 'Jacob: Aí, veio aquela onda anormal de calor e eu desmaiei...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655967
    m_Localized: 'Jacob: Nós deveríamos ter saído da cidade...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655966
    m_Localized: 'Jacob: Não consigo encontrar ela desde que essa merda toda começou.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655965
    m_Localized: 'Jacob: Ela é a minha filha.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655964
    m_Localized: O puteiro fica em outra rua
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655963
    m_Localized: Não temos ninguém assim
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655962
    m_Localized: 'Jacob: Uma garota de cabelo roxo usando um poncho passou por aqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655961
    m_Localized: 'Jacob: Ei.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655960
    m_Localized: 'StaticBoy: Eu errei de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655959
    m_Localized: 'StaticBoy: Desculpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655958
    m_Localized: 'StaticBoy: Cheiro errado. Voz errada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655957
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655956
    m_Localized: 'StaticBoy: Eu errei de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655955
    m_Localized: 'StaticBoy: Desculpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655954
    m_Localized: 'StaticBoy: Cheiro errado. Voz errada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655953
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655952
    m_Localized: Precisa de ajuda para encontrar a sua casa?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655951
    m_Localized: O que você está procurando?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655950
    m_Localized: 'StaticBoy: Mas as pessoas precisam mesmo deles?..'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655949
    m_Localized: 'StaticBoy: Eu não tenho. Nunca tive.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655948
    m_Localized: 'StaticBoy: Pais?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655947
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655946
    m_Localized: Precisa de ajuda para encontrar a sua casa?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655945
    m_Localized: O que você está procurando?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655944
    m_Localized: 'StaticBoy: Eu ouvi um barulho de passo. Isso significa que tem alguém esperando.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655943
    m_Localized: 'StaticBoy: Eu precisava da luz da cozinha, mas aqui... tem um eco diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655942
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655941
    m_Localized: 'StaticBoy: As paredes são todas iguais no escuro.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655940
    m_Localized: Onde estão seus pais?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655939
    m_Localized: Você se perdeu?
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655938
    m_Localized: 'StaticBoy: Deveria...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655937
    m_Localized: 'StaticBoy: Ele não está dormindo?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446783655936
    m_Localized: 'StaticBoy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267400
    m_Localized: 'CultistPriest: Olhe pelos nossos membros. E lembre-se, se um deles morrer... sua casa será reduzia ao nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267399
    m_Localized: 'CultistPriest: Vejo você depois. Voltarei para conferir como eles estão.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267398
    m_Localized: 'CultistPriest: Você acha que tem uma escolha?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267397
    m_Localized: 'CultistPriest: Vejo você depois. Voltarei para conferir como eles estão.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267396
    m_Localized: 'CultistPriest: Eles não precisam de muito tempo. Mas ainda assim, fique de olho no meu pessoal.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267395
    m_Localized: 'CultistPriest: Obrigado.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267394
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267393
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267392
    m_Localized: 'CultistPriest: Eles estão no caminho do nosso objetivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267391
    m_Localized: 'CultistPriest: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267390
    m_Localized: 'CultistPriest: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267389
    m_Localized: 'CultistPriest: Isso é muito bom. Mas primeiro você precisa se livrar do seu pessoal:'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267388
    m_Localized: 'Courier: Tenha uma boa noite...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267387
    m_Localized: 'Courier: Aqui está sua entrega: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267386
    m_Localized: (Pegar a entrega)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267385
    m_Localized: 'Courier: Tá bom, pega o pedido, e eu tô fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267384
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267383
    m_Localized: 'Courier: Eu já cansei disso. Eu só quero que acabe...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267382
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267381
    m_Localized: 'Courier: Essa confusão toda...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267380
    m_Localized: 'Courier: Aquelas checagens matinais e sem fim, o pessoal da FEMA com suas armas apontadas em nossa direção...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267379
    m_Localized: 'Courier: Eu continuo vendo os rostos cansados, amargurados e deprimidos...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267378
    m_Localized: 'Courier: Lembra quando eu disse que ser um entregador ajuda a distrair a minha mente? Parece que isso já não dá mais certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267377
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267376
    m_Localized: 'Courier: Ai ai...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267375
    m_Localized: (Pegar a entrega)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267374
    m_Localized: 'Courier: Só pega o pedido e eu vou dar o fora daqui, antes que você também atire em mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267373
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267372
    m_Localized: 'Courier: Ah, entendi... Você está dizendo que foi bom meu amigo ter morrido?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267371
    m_Localized: Me desculpa
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267370
    m_Localized: Não tem outro jeito
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267368
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267367
    m_Localized: 'Courier: Aqui está sua entrega: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267366
    m_Localized: (Pegar a entrega)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267365
    m_Localized: 'Courier: Quer saber, só pega logo o pedido e eu vou embora.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267364
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267363
    m_Localized: 'Courier: Porra, é verdade, valeu mesmo pelo conselho. Aquilo que você disse ajudou muito.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267362
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267361
    m_Localized: (Pegar a entrega)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267360
    m_Localized: 'Courier: Certo, preciso ir. Pega o seu pedido e eu vou dar o fora daqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267359
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267358
    m_Localized: 'Courier: Daqui a pouco vão dizer que os pelos pubianos são um novo sinal de Visitante, aí o mundo inteiro se lascou...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267357
    m_Localized: 'Courier: Eu achei que não tinha como piorar. Mas, cada dia é mais maluco que o outro.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267356
    m_Localized: 'Courier: Todos esses Visitantes, os sinais, o maldito Sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267355
    m_Localized: 'Courier: Bem? Seja o que for “bem”, depois dessa catástrofe isso já não existe mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267354
    m_Localized: É só virar homem que vai sobreviver. Pare de choramingar como um perdedor
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267353
    m_Localized: Não se preocupe. Você vai ficar bem
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267352
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267350
    m_Localized: 'Courier: Aqui está sua entrega: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267349
    m_Localized: (Pegar a entrega)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267348
    m_Localized: 'Courier: Tá bom, era pra você pegar o pedido. Vai pegar ou não?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267347
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267346
    m_Localized: 'Courier: Além do mais, pra que estudar, se ninguém vai me contratar mesmo?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267345
    m_Localized: 'Courier: Ah, que seja. Ser um entregador não é tão ruim assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267344
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267343
    m_Localized: 'Courier: É, claro. Você tem várias pessoas em casa, é fácil você falar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267342
    m_Localized: Isso é ruim
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267341
    m_Localized: Ficar sozinho não é tão ruim
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267340
    m_Localized: 'Courier: Além disso, a minha família não está por perto. Eu não sou daqui, estou aqui para estudar. Então, eu estou só...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267339
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267338
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267336
    m_Localized: 'Courier: Aqui está sua entrega: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267335
    m_Localized: (Pegar a entrega)
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267334
    m_Localized: 'Courier: Enfim, foi mal, eu me distraí. Vai pegar a entrega?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267333
    m_Localized: 'Courier: E agora as pessoas pedem, tipo, 20 litros de água. Cara, se ao menos a gente ganhasse um pagamento por insalubridade ou até mesmo umas gorjetas por carregar coisas pesadas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267332
    m_Localized: 'Courier: Mas, esse maldito sol... Foi por isso que eles nos mudaram para o turno da noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267331
    m_Localized: 'Courier: E as entregas pagam muito bem agora. O risco é altíssimo, não importa como você veja.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267330
    m_Localized: 'Courier: Apocalipse ou não, o almoço ainda está de pé.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446775267329
    m_Localized: 'Courier: Eu não esperava que as pessoas iriam parar de estocar suprimentos para o fim do mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073033
    m_Localized: Eu não aceito suborno
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073032
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073031
    m_Localized: 'GraveDigger: {0}? Isso já serve?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073030
    m_Localized: 'GraveDigger: O que é preciso?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073029
    m_Localized: 'GraveDigger: Ah, pelo amor! Posso te subornar com uma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073028
    m_Localized: Eu não aceito suborno
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073027
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073026
    m_Localized: 'Marauder: Ah, achei! {0}. Fique com isso, senhor proprietário. Só me deixa ficar aqui até amanhã de manhã.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073025
    m_Localized: 'Marauder: Tá, uma faca, vou precisar disso... gaze, também... humm, uma garrafa velha, mas vazia, não vai ser tão útil...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446771073024
    m_Localized: 'Marauder: Ah, ei, não me manda embora... deixa eu dar uma olhada na mochila primeiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878746
    m_Localized: 'Wolfhound: A força comanda tudo agora. Ou você se alinha a ela, ou ela se volta contra você.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878745
    m_Localized: 'Wolfhound: Escolha inteligente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878744
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878743
    m_Localized: Eu vou dar um jeito nisso. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878742
    m_Localized: 'Wolfhound: É melhor mandar ela ir embora se você quiser que esse lugar continue sendo só seu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878741
    m_Localized: 'Wolfhound: Eu estou vendo que {0} está esquentando o lugar. Eu consigo dizer de cara que ela é lobo em pele de cordeiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878740
    m_Localized: Eu não aceito suborno
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878739
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878738
    m_Localized: 'Twins: {0}. Aqui, toma. Isso pode ser útil.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878737
    m_Localized: 'Twins: Nós temos... o que era mesmo?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878736
    m_Localized: 'Twins: Humm... eu entendo, você não conhece a gente. Você deve tá pensando que a gente só vai trazer mais problema. Mas não somos assim. Minha irmã... ela está passando por um momento difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878735
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878734
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878733
    m_Localized: 'Twins: Essas pessoas nos lembram muito de nossos... pais... e isso... não é o melhor ambiente para a condição dela.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878732
    m_Localized: 'Twins: Estou preocupada... minha irmã só vai sofrer enquanto elas estiverem aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878731
    m_Localized: 'Twins: Vejo que você já tem uma dessas pessoas na sua casa, {0} e {1}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878730
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878729
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878728
    m_Localized: Acho que a gente não vai se dar bem.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878727
    m_Localized: Sabe, antes de conhecer meu marido, eu... bem, esse cara me lembra muito de alguém que eu conheci.
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878726
    m_Localized: Vai ser uma barra... viver embaixo do mesmo teto que esse homem...
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878725
    m_Localized: Você tá com {0} aí…
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878724
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878723
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878722
    m_Localized: 'Twins: E isso é a última coisa que ela precisa agora. Ela precisa de paz... e de cuidado.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878721
    m_Localized: 'Twins: Eu posso sentir minha irmãzinha se afogando em palavras de julgamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446766878720
    m_Localized: 'Twins: Receio que você já esteja com {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684421
    m_Localized: 'Greatmother: Hehe, é assim que se faz! Te disse, não seria nada além de problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684420
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684419
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684418
    m_Localized: 'Greatmother: A gente só precisa expulsar ele, e eu me instalo bem ali!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684417
    m_Localized: 'Greatmother: Nah, ele não vai te trazer nada de bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446762684416
    m_Localized: 'Greatmother: Ora, ora... veja só quem está aqui, hein? {0}. Que engraçado encontrar você aqui!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490118
    m_Localized: 'Widow: Obrigada... não vou ficar muito... Só preciso de um tempo pra descansar...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490117
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490116
    m_Localized: Eu expulso. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490115
    m_Localized: 'Widow: Eu não vou compartilhar o mesmo teto com alguém como ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490114
    m_Localized: 'Widow: Não.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490113
    m_Localized: 'Widow: Você tá com {0} aqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446758490112
    m_Localized: 'Widow: Obrigada por ajudar. Diferente daqueles...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446750101504
    m_Localized: Eu não aceito suborno
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907213
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907212
    m_Localized: 'Luka: Isso te interessa?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907211
    m_Localized: 'Luka: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907210
    m_Localized: 'Luka: Eu gostaria de ajudar você. Tem alguma coisa que você queira?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907209
    m_Localized: Eu não aceito suborno
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907208
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907207
    m_Localized: 'Couple: Então, o que você me diz, você vai ajudar?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907206
    m_Localized: 'Couple: {0}? Estou disposto a dar tudo o que me resta, para que minha amada possa ter um momento de descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907205
    m_Localized: 'Couple: A gente tem uma coisa aqui. Não é a minha roupa, mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907204
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907203
    m_Localized: 'Couple: Falando disso...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907202
    m_Localized: 'Couple: Eu amo muito ela. Eu daria minha roupa do corpo por ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907201
    m_Localized: 'Couple: Minha esposa não é muito forte. Ela se cansa rápido. E eu... eu faria qualquer coisa por ela, tá entendendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446745907200
    m_Localized: 'Couple: Por favor, perdoe a minha insistência, mas se coloque no nosso lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712914
    m_Localized: Eu não aceito suborno
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712913
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712912
    m_Localized: 'Wheelchair: Olha, minhas pernas são a prova viva! Não tem nada ali, né? Te peguei!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712911
    m_Localized: 'Wheelchair: Funciona que é uma beleza!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712910
    m_Localized: 'Wheelchair: Não vai me deixar entrar? Bora resolver isso! Toma essa {0}, é só balançar na entrada, e bam! Você fica invisível.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712909
    m_Localized: Eu não aceito suborno
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712908
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712907
    m_Localized: 'Dude: Ah! {0}! É igual aos jogos, cara. Tem que construir um relacionamento. Eu tô ligado, meu irmão!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712906
    m_Localized: 'Dude: Tá, saca só isso. Eu tenho um bagulho aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712905
    m_Localized: 'Dude: Qualé, mano...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712904
    m_Localized: Eu não aceito suborno
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712903
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712902
    m_Localized: 'Blind: Acho que é {0}. Pode ficar. Eu preciso de pelo menos um dia pra recuperar o fôlego. Mas... é pouco provável...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712901
    m_Localized: 'Blind: Eu... eu tinha uma coisa aqui comigo. Espera, por favor...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712900
    m_Localized: Eu não aceito suborno
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712899
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712898
    m_Localized: 'Fatman: Hehe, o que você acha? Tá se sentindo melhor? Estamos numa boa?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712897
    m_Localized: 'Fatman: Aqui, um PRESENTINHO meu... {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446741712896
    m_Localized: 'Fatman: Certo, amigo. Eu acho... acho que sei o que vai ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518610
    m_Localized: Eu não aceito suborno
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518609
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518608
    m_Localized: 'Bestson: Eu... também tenho chiclete. Tenho só um pouco, mas posso te dar...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518607
    m_Localized: 'Bestson: Você quer algo de mim? Que tal {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518606
    m_Localized: 'Bestson: Eu... eu não sei o que fazer.…'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518605
    m_Localized: Eu não aceito suborno
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518604
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518603
    m_Localized: 'Fugitive: Por favor... ou eu vou morrer aqui!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518602
    m_Localized: 'Fugitive: Cara, eu tô pronto pra dar tudo o que tenho. Aqui, que tal essa {0}? Encontrei no meio do caminho. Não tenho mais nada comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518601
    m_Localized: 'Fugitive: Merda, agora eu vou ou sangrar até morrer na sua porta... ou você me deixa entrar e me ajuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518600
    m_Localized: 'Wifefema: Quer saber? Vá se foder. Vou falar com seus vizinhos. Tchau, imbecil.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518599
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518598
    m_Localized: 'Wifefema: Tu tem merda na cabeça? Eu tô botando tudo pra fora e cê vai e caga em cima?'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518597
    m_Localized: 'Wifefema: Tá falando sério? Meu marido trabalha na FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518596
    m_Localized: Eu não aceito suborno
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518595
    m_Localized: Tá, pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518594
    m_Localized: 'Wifefema: Pense no que vai sair mais barato.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518593
    m_Localized: 'Wifefema: Não quer? Só preciso dizer um ai pro meu marido e amanhã o pessoal de trajes amarelos vão fazer uma limpa sem avisar antes: documentos, cachorros... Pode ser qualquer manhã.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446737518592
    m_Localized: 'Wifefema: Vamos direto ao ponto: Eu te adianto {0} e você me deixa entrar, hehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 48213446720741376
    m_Localized: 'Wifefema: Escuta, meu nariz é afiado. Eu consigo identificar pessoas normais e Visitantes como ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863213
    m_Localized: Eu só espero finalmente conseguir dormir um pouco, pelo menos aqui.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863212
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863211
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863210
    m_Localized: Eu já vi essa pessoa nos meus sonhos, e acredite, foi o suficiente.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863209
    m_Localized: Não tem lugar pra nós dois aqui.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863208
    m_Localized: 'Obrigado, mas... parece que alguém já pegou meu lugar. Tem que falar com {0}. '
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863207
    m_Localized: 'FormerFema: Tchau.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863206
    m_Localized: 'FormerFema: Eu não sei nem porque tô segurando ele ainda.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863205
    m_Localized: 'FormerFema: Acho que esse uniforme é meio assustador.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863204
    m_Localized: 'FormerFema: Certo, eu entendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863203
    m_Localized: 'FormerFema: Achei mesmo que você não me deixaria entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863202
    m_Localized: 'FormerFema: Sério?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863201
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863200
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863199
    m_Localized: 'FormerFema: Se você pudesse expulsar aquela pessoa. Eu juro que fico quieto e não incomodo ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863198
    m_Localized: 'FormerFema: Sabe, tô preso nesse uniforme o dia todo... só queria poder tirar, lavar toda a sujeira e... o sangue de alguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863197
    m_Localized: 'FormerFema: A-ah... Parece que {0} já tá no banheiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863196
    m_Localized: 'FormerFema: Digo, espera um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863195
    m_Localized: 'FormerFema: O quê? Ah, valeu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863194
    m_Localized: 'GraveDigger: Ah, valeu, cara!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863193
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863192
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863191
    m_Localized: 'GraveDigger: Eu entraria, mesmo... Mas, bem, você entende.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863190
    m_Localized: 'GraveDigger: Poxa, você já está com {0} aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863189
    m_Localized: Ah, pelo menos valeu a tentativa.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863188
    m_Localized: Merda, achei que eu finalmente fosse ter um descanso.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863187
    m_Localized: Hehe. Agora sim.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863186
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863185
    m_Localized: Eu vou expulsar ela. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863184
    m_Localized: Por quem? Olha ali, viu? Se não é {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863183
    m_Localized: Ah, veja só. O lugar aconchegante já foi pego.
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863182
    m_Localized: 'Provocateur: Vamos discutir os termos de aluguel em detalhe depois.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863181
    m_Localized: 'Provocateur: Obrigado, proprietário.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863180
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863179
    m_Localized: Eu vou expulsar ele. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863178
    m_Localized: 'Provocateur: Os artigos 28, 48 e 7.3 da Constituição não significam nada pra você?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863177
    m_Localized: 'Provocateur: Você sabe que esse indivíduo inflige as leis sem medo, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863176
    m_Localized: 'Provocateur: Hum... Vejo que {0} já está vivendo aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863175
    m_Localized: 'TaxiDriver: Eu entendo você, sabe. Mas merda, é foda isso...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863174
    m_Localized: 'TaxiDriver: Ei, hã, vem conversar comigo uma hora, precisamos bater um papo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863173
    m_Localized: 'TaxiDriver: Ufa, valeu, cara. Você fez uma boa por mim!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863172
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863171
    m_Localized: Eu vou expulsar ele. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863170
    m_Localized: 'TaxiDriver: Enfim, você precisa escolher: eu ou ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863169
    m_Localized: 'TaxiDriver: Esse cara me lembra de uma das pessoas que tava atrás da minha família e...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077129863168
    m_Localized: 'TaxiDriver: Olha, não me entenda errado, mas você tá com {0} na sua casa, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668885
    m_Localized: 'Edgar: Quando chegar a hora, fique com o meu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668884
    m_Localized: 'Edgar: Eu não sei se você vê beleza como eu. Mas diga... Você não atira os corpos fora, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668883
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668882
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668881
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668880
    m_Localized: 'Edgar: E eu, eu vim escutar o silêncio do dia terminando.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668879
    m_Localized: 'Edgar: Eu entraria... mas {0} já está ali. Essa pessoa ainda se prende aos pensamentos do amanhã.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668878
    m_Localized: 'Foreigner: (Ele acena com a cabeça e entra)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668877
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668876
    m_Localized: Eu vou expulsar ele. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668875
    m_Localized: 'Foreigner: (Parece que ele não gosta do {0}. Ele aponta para o homem, e então pra si mesmo, e de novo para o homem)'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668874
    m_Localized: 'Foreigner: Pffyyv. Ffffffpt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668873
    m_Localized: 'Doctor: Se eu tiver sorte, estarei por perto. Não hesite em pedir ajuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668872
    m_Localized: 'Doctor: Eu entendo, não é a melhor hora pra se confiar em alguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668871
    m_Localized: 'Doctor: Obrigado. Espero que eu consiga ajudar alguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668870
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668869
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668868
    m_Localized: 'Doctor: É melhor ele encontrar alguém que pode realmente ajudá-lo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668867
    m_Localized: 'Doctor: Não posso oferecer um tratamento adequado para ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668866
    m_Localized: 'Doctor: Humm, vejo que {0} está aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474578
    m_Localized: 'NotTrue: Só vou descansar as juntas aqui um pouquinho e depois vou embora.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474577
    m_Localized: 'NotTrue: Ah, docinho. Será que você não consegue arrumar um banquinho para esta senhorinha?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474576
    m_Localized: 'NotTrue: Ah, obrigada, querido! Você salvou a pela dessa senhorinha! Uma pena ter precisado mandar uma pessoa embora por mim...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474575
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474574
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474573
    m_Localized: 'NotTrue: Eu provavelmente me sentaria um pouco à frente, recuperaria o fôlego e sairia engatinhando se você tivesse uma companhia assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474572
    m_Localized: 'NotTrue: Com gente assim, não vai ser fácil, docinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474571
    m_Localized: 'NotTrue: Ah, pela minha alma! Parece que você está com {0} ali na cadeira.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474570
    m_Localized: 'Daughter: Nããããão...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474569
    m_Localized: 'Daughter: Eu tô c-com ta-a-a-anto MEDOOOOOOO...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474568
    m_Localized: 'Daughter: E nã-ã-ã-ão c-conhe-e-e-eço ma-a-a-ais ningué-é-é-ém...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474567
    m_Localized: 'Daughter: IR PRA ONDE?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474566
    m_Localized: 'Daughter: PAAAAAAAAAI! PAPAAAAAAAAAAAIII!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474565
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474564
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474563
    m_Localized: 'Daughter: Eu quero ver o papaaaaaaaiii...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474562
    m_Localized: 'Daughter: Mas, eu... eu só quero sentar naquele lugar! Eu quero, eu quero, eu quero! Lá é onde... o papai sentava... Ele me disse.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474561
    m_Localized: 'Daughter: {0} tá aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077121474560
    m_Localized: 'Daughter: Eu... eu não... não tem lugar pra mim!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280298
    m_Localized: 'Scammer: Tanto faz. Eu encontro outros otários por aí, tem gente assim de sobra.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280297
    m_Localized: 'Scammer: Merda, você é um belo dum cagão. Foda-se, eu soube de cara que a gente não ia se dar bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280296
    m_Localized: 'Scammer: Foda. Ei, dá um pulo quando tiver um tempo. Tenho uma ideia pra trocar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280295
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280294
    m_Localized: Eu vou expulsar ele. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280293
    m_Localized: 'Scammer: Manda ele pastar e ficamos de boa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280292
    m_Localized: 'Scammer: Ei, você já tá com {0} aí. Sem chance que vai vir dinheiro ou boas histórias desse aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280291
    m_Localized: 'Cold: Sim... em algum lugar lá fora... longe de todos...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280290
    m_Localized: 'Cold: Certo. Vou embora. Talvez o sol consiga me aquecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280289
    m_Localized: 'Cold: Eu entendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280288
    m_Localized: 'Cold: Obrigado. Acredite, assim é mais seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280287
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280286
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280285
    m_Localized: 'Cold: Eu... Eu tenho medo de ficar no mesmo quarto que outras pessoas. As vezes... coisas desagradáveis acontecem. Aconteceu todas as vezes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280284
    m_Localized: 'Cold: Obrigado. Ah, esse lugar já está ocupado. Eu não vou entrar enquanto {0} estiver aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280283
    m_Localized: 'Esenin: Bom, que você se foda. Aposto que você também é um esquisitão que não bebe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280282
    m_Localized: 'Esenin: Bom, pelo menos uma vez as coisas estão indo bem pra mim. Vai na frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280281
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280280
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280279
    m_Localized: 'Esenin: Pessoas assim são expulsas na hora de um bar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280278
    m_Localized: 'Esenin: É melhor deixar {0} sair primeiro, aí conversamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280277
    m_Localized: 'Anxiety: Tá, haha... Tá bom, eu vou embora. Humm, o sol vai nos matar de qualquer jeito. Todo mundo vai morrer...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280276
    m_Localized: 'Anxiety: Obrigada. Eu vou esperar quieta. Só não fecha a porta, tá bom? Haha. Só por precaução...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280275
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280274
    m_Localized: Eu vou expulsar ele. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280273
    m_Localized: 'Anxiety: Poderia, hum... pedir pra ele sair?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280272
    m_Localized: 'Anxiety: Por favor, você poderia verificar ele ou...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280271
    m_Localized: 'Anxiety: Eu... Eu não posso ficar com ele. E se ele for um Visitante?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280270
    m_Localized: 'Anxiety: Ele...{0}... já está aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280269
    m_Localized: 'Hunter: Você agiu bem. Pelo menos eu sei o que eu tô fazendo. Eu posso ajudar... se aquilo aparecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280268
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280267
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280266
    m_Localized: 'Hunter: Eu sinto o cheiro de sangue nas mãos dessa pessoa. Não sei por que você deixou entrar. Você gosta de viver no perigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280265
    m_Localized: 'Hunter: Você já tá com {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280264
    m_Localized: 'Fanatic: Tô indo ajudar outra pessoa. Que você fique aqui e apodreça!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280263
    m_Localized: 'Fanatic: É um pecado manter a porta fechada para a luz... Não, para a ILUMINAÇÃO!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280262
    m_Localized: 'Fanatic: Então vai se lascar!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280261
    m_Localized: 'Fanatic: Eu vou só sentar aqui um pouco... Ooopa!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280260
    m_Localized: 'Fanatic: Ahhhh, que maravilha! Receba a bênção do Grande Sol, e que ele olhe por você!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280259
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280258
    m_Localized: Eu vou expulsar ele. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280257
    m_Localized: 'Fanatic: A sombra dele... não, o próprio herege expulsa a luz divina! Precisamos expulsá-lo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077117280256
    m_Localized: 'Fanatic: Humano! O SOL diz que não posso entrar enquanto {0} estiver se escondendo aí dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085958
    m_Localized: 'FortuneTeller: Tem uma linha central de pura energia passando bem no meio da sua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085957
    m_Localized: 'FortuneTeller: Ótimo. Francamente, você está em posse de uma rara fonte metafísica.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085956
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085955
    m_Localized: Eu vou expulsar ele. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085954
    m_Localized: 'FortuneTeller: Precisamos nos livrar dele, ou as estrelas irão se alinhar para o desastre. Você entende isso, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085953
    m_Localized: 'FortuneTeller: Te lembra de algo, {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077113085952
    m_Localized: 'FortuneTeller: Ah... eu consigo sentir... uma aura tão densa e tão opressiva. Uma sombra... É forte o suficiente para amaldiçoar a todos nós e envenenar a casa inteira!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891698
    m_Localized: 'Luka: Se cuida, viu?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891697
    m_Localized: 'Luka: E, a partir daí, as coisas ficam feias em um segundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891696
    m_Localized: 'Luka: Você vai ser devorado vivo se der muita atenção a isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891695
    m_Localized: 'Luka: Não se enterre em sofrimento.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891694
    m_Localized: 'Luka: Então, talvez a morte não seja a única coisa na sua mente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891693
    m_Localized: 'Luka: Espero que você consiga lembrar de como é sentir alegria.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891692
    m_Localized: 'Luka: Obrigado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891691
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891690
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891689
    m_Localized: 'Luka: Mas eu iria gostar muito se pudesse arrumar um espaço pra mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891688
    m_Localized: 'Luka: Não quero expulsar ninguém, vai saber, talvez essa pessoa precisasse mais do que eu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891687
    m_Localized: 'Luka: Eu adoraria entrar, mas parece que {0} já está aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891686
    m_Localized: 'Couple: Vamos, mexe essas pernas, eu também tô cansado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891685
    m_Localized: 'Couple: A gente continua procurando, né, meu amorzinho?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891684
    m_Localized: 'Couple: Entendi. Desculpa o incômodo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891683
    m_Localized: 'Couple: Ela é muito envergonhada, mas tudo bem. A gente vai descansar já, já.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891682
    m_Localized: 'Couple: Por que você tá parada aí? Bora, ele convidou a gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891681
    m_Localized: 'Couple: Ah, obrigado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891680
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891679
    m_Localized: Eu vou expulsar ela. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891678
    m_Localized: 'Couple: Minha esposa não gosta muito de crianças, sabe. Não esperava encontrar alguém tão jovem assim por aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891677
    m_Localized: 'Couple: Olha, não ser difícil, mas a gente acabou... a gente não pode ficar aqui com {0} por perto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891676
    m_Localized: 'Couple: E quem é essa pessoa aí?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891675
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891674
    m_Localized: 'Couple: Ah, obrigado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891673
    m_Localized: 'Anger: Inferno.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891672
    m_Localized: 'Anger: Fica tranquilo aí e engole a merda deles, até se engasgar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891671
    m_Localized: 'Anger: Porra, você é tão patético quanto o resto desses covardes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891670
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891669
    m_Localized: 'Anger: Eu desconto tudo em mim, assim ninguém se machuca.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891668
    m_Localized: 'Anger: Ou destruir a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891667
    m_Localized: 'Anger: Não se preocupe, eu não vou descontar em mais ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891666
    m_Localized: 'Anger: Nada. Não vou ficar no mesmo teto que essa aberração. Eu vou perder a cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891665
    m_Localized: 'Anger: Você tá com {0} aí?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891664
    m_Localized: 'Mother: Não, não. Eu ainda preciso tentar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891662
    m_Localized: 'Mother: Tá certo. Vou ver se agora consigo ir até o meu marido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891661
    m_Localized: 'Mother: Vamos, não fica aí parada. Entra, o tio não vai ficar esperando aí pra sempre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891660
    m_Localized: 'Mother: Uh, perfeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891659
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891658
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891657
    m_Localized: 'Mother: Você poderia... Não sei... Mandar essa pessoa embora? Para podermos finalmente descansar uma noite em paz?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891656
    m_Localized: 'Mother: Hum... Você tá com {0} aqui. Meu bebê já está assustado o suficiente...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891655
    m_Localized: 'Ballerina: Tá vendo a bola de pelo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891654
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891653
    m_Localized: 'Ballerina: Ô, eu não tava falando com você. Era o gatinho mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891652
    m_Localized: 'Ballerina: Vai, gatinho. Cê vai me entreter agora, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891651
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891650
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891649
    m_Localized: 'Ballerina: Humm, eles disseram que isso não era para estar aqui. Vai, faz eles saírem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891648
    m_Localized: 'Ballerina: Você tem {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697379
    m_Localized: 'Teacher: Obrigado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697378
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697377
    m_Localized: Eu vou expulsar ele. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697376
    m_Localized: 'Teacher: Sinto muito...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697375
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697374
    m_Localized: 'Teacher: Ele me lembra das... das pessoas que... que... as crianças...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697373
    m_Localized: 'Teacher: Não posso ficar sob o mesmo teto que alguém assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697372
    m_Localized: 'Teacher: Desculpe, mas... {0} é quem está ali?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697371
    m_Localized: 'Dude: Te cuida aê... e da tua galera.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697370
    m_Localized: 'Dude: Tá tranquilo, meu mano, eu entendo. Sem ressentimentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697369
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697368
    m_Localized: 'Dude: Maaaaaaano...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697367
    m_Localized: 'Dude: É disso que eu tô falando! Porra, tu é uma lenda!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697366
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697365
    m_Localized: Eu vou expulsar ele. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697364
    m_Localized: 'Dude: Cara, a gente precisa mandar ele vazar! O cara ta acabando com a vibe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697363
    m_Localized: 'Dude: Merda, esse maluco vai estragar a vibe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697362
    m_Localized: 'Dude: Pera, só um pouco... Quem é {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697361
    m_Localized: 'Dude: Ooooh, mano, saudações!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697360
    m_Localized: 'Blind: Ou AQUILO vai ir atrás de você.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697359
    m_Localized: 'Blind: Pelo amor de tudo que é sagrado, não chegue perto dos corpos carbonizados durante a noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697358
    m_Localized: 'Blind: Eu vou sair, mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697357
    m_Localized: 'Blind: Obrigado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697356
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697355
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697354
    m_Localized: 'Blind: É melhor eu encontrar outro lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697353
    m_Localized: 'Blind: Foi mal, não consigo explicar. Eu só sei que não é normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697352
    m_Localized: 'Blind: Eu consigo sentir {0} aqui. Tem algo errado com essa pessoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697351
    m_Localized: 'Fatman: Pra onde é que eu iria? Eu tô fudido.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697350
    m_Localized: 'Fatman: Cara... puta merda, você sabe que eu não tô bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697349
    m_Localized: 'Fatman: Eu vou te pagar... quando tudo isso acabar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697348
    m_Localized: 'Fatman: Cara, você... acabou de fazer a escolha certa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697347
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697346
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697345
    m_Localized: 'Fatman: Eu prefiro te conseguir uma coisa, então... pois é... você tem uma arma... dá um jeito!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077104697344
    m_Localized: 'Fatman: Merda, você tá com... {0} aí. Tira essa pessoa daí! Eu não vou brigar pela porra de uma banheira!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503073
    m_Localized: 'Buddy: Valeuzão, parceiro! Tu é mesmo um santo!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503072
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503071
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503070
    m_Localized: 'Buddy: Olha, eu não tenho problema em compartilhar, mas esse muquifo tá parecendo meio lotado, hein? Você se importa em dar um "chega pra lá" em alguém?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503069
    m_Localized: 'Buddy: Opa, amigo, já tem alguém ali.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503068
    m_Localized: 'Bestson: É... você provavelmente tá certo. Eu vou pra casa, vai que eles já voltaram...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503067
    m_Localized: 'Bestson: Mas... talvez seja melhor eu ficar com você por enquanto, é mais seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503066
    m_Localized: 'Bestson: E se meus pais voltarem casa e eu não estiver lá?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503065
    m_Localized: 'Bestson: Obrigado! Eu só... não consigo parar de me preocupar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503064
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503063
    m_Localized: Eu vou expulsar ele. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503062
    m_Localized: 'Bestson: Teve uma vez no parque em que um homem como ele me atacou. Desde isso, eu nunca mais botei o pé lá!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503061
    m_Localized: 'Bestson: Eu tô vendo que você já ta com {0} no sofá. Homens assim... Digo... eles me assustam.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503060
    m_Localized: 'Fugitive: Uma boa noite de merda pra ti, seu zé ruela.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503059
    m_Localized: 'Fugitive: Tá. Se esconde aí atrás dessa porta e deixa ela trancada.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503058
    m_Localized: 'Fugitive: Qual é? Tá com medinho da FEMA vir me procurar? Que porra é essa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503057
    m_Localized: 'Fugitive: Você tá falando sério, caralho?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503056
    m_Localized: 'Fugitive: Espero que seus vizinhos não sejam uns arrombados...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503055
    m_Localized: 'Fugitive: Cara, você acabou de salvar a porra da minha vida!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503054
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503053
    m_Localized: Eu vou expulsar ele. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503052
    m_Localized: 'Fugitive: Eu tô te dizendo, homens assim vão te trair em um piscar de olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503051
    m_Localized: 'Fugitive: Fica quieto, na dele. Até que chega a hora de salvar a própria pele. Aí ele vai te jogar na frente de um ônibus sem nem pensar duas vezes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503050
    m_Localized: 'Fugitive: Eu não consigo... Escuta, cara. Eu já me deparei com gente assim antes. Você tem um bem aí na sua casa, {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503049
    m_Localized: 'Nun: O Senhor lembrará disso. Ele vê tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503048
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503047
    m_Localized: 'Nun: Minha morte pesará em sua alma, guarde minhas palavras.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503046
    m_Localized: 'Nun: Se enxergue, tolo! Uma chance de salvação oferecida de mão beijada e você a recusa dessa forma. Quanta vergonha!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503045
    m_Localized: 'Nun: Deus tenha piedade...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503044
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503043
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503042
    m_Localized: 'Nun: Expulsai-os, demônios, e sereis abençoados!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503041
    m_Localized: 'Nun: Uma vida inteira não vai ser o suficiente pra limpar tantos pecados! Você deve temer a Deus, mantendo tal companhia!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077100503040
    m_Localized: 'Nun: E quem é essa pessoa, {0}, que mal lhe pergunte?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114466
    m_Localized: 'Raskolnikov: Eu... Eu só espero um dia aprender a matar. Para que eu consiga me defender sozinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114465
    m_Localized: 'Raskolnikov: Aquela pessoa deve ser especial pra você. Me perdoe por ter desperdiçado o seu tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114464
    m_Localized: 'Raskolnikov: Ah, me desculpa. Eu não quis pressionar você assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114463
    m_Localized: 'Raskolnikov: Poderia me mostrar como você faz? Como você mata um Visitante. Eu quero encarar o medo no olho.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114462
    m_Localized: 'Raskolnikov: E... se não for pedir muito... depois de me verificar...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114461
    m_Localized: 'Raskolnikov: Obrigado, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114460
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114459
    m_Localized: Eu vou expulsar essa pessoa. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114458
    m_Localized: 'Raskolnikov: Eu não... Não consigo viver com alguém assim. Eu já tentei. Não funciona.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114457
    m_Localized: 'Raskolnikov: Desculpe. Não quero ser inconveniente, mas {0} já tá aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114456
    m_Localized: 'Wifefema: Quer saber? Vá se foder. Vou falar com seus vizinhos. Tchau, imbecil.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114455
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114454
    m_Localized: 'Wifefema: Tu tem merda na cabeça? Eu tô botando tudo pra fora e cê vai e caga em cima?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114453
    m_Localized: 'Wifefema: Você tá falando sério? Meu marido trabalha na FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114452
    m_Localized: 'Wifefema: Esses malditos sanguessugas...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114451
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114450
    m_Localized: Eu vou expulsar ele. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114449
    m_Localized: 'Wifefema: Chuta ele pra fora, antes que seja tarde!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114448
    m_Localized: 'Wifefema: Eu conheço o tipo dele. Você não deveria ter deixado ele entrar. Caras assim? São problema na certa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114447
    m_Localized: 'Wifefema: Quem diabos é {0}?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114446
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114445
    m_Localized: 'Theorist: Adeus! Duvido que você vá durar muito!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114444
    m_Localized: 'Theorist: Só uma mente realmente pequena poderia negar a verdade assim tão fácil!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114443
    m_Localized: 'Theorist: Você... você...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114442
    m_Localized: 'Theorist: O que você quer dizer com eu "deveria sair"?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114441
    m_Localized: 'Theorist: O mundo nunca mais vai parecer o mesmo depois que a gente conversar!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114440
    m_Localized: 'Theorist: Fico contente por você ter feito a escolha certa! Acredita em mim, você não vai se arrepender.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114439
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114438
    m_Localized: Eu vou expulsar ele. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114437
    m_Localized: 'Theorist: Faz ele sair e eu aceito o seu convite!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114436
    m_Localized: 'Theorist: Sem chance eu revelar qualquer coisa com ele por perto!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114435
    m_Localized: 'Theorist: O... o... {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114434
    m_Localized: 'Theorist: Ah não. Nem pensar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114433
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077092114432
    m_Localized: 'Theorist: Mas... pera um segundo. Quem é aquele?'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077071142912
    m_Localized: 'Theorist: Maravilha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633035
    m_Localized: 'BigLebowski: Não devia ter perdido meu tempo com você...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633034
    m_Localized: 'BigLebowski: Pfft... Tanto faz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646136
    m_Localized: 'Couple: Tá fazendo o que aí, parada? Anda, nós fomos convidados.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039743
    m_Localized: 'Nervous: Eu tô ficando no Hotel Hope, mas eu decidi dar uma caminhada.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039742
    m_Localized: 'Nervous: Desculpa, sou meio nervo...so.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039741
    m_Localized: 'Nervous: Olá. Tehehe.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039740
    m_Localized: 'Bald: Cuidado por aí, viu? Espero que você sobreviva a essa merda toda.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039739
    m_Localized: 'Bald: Beleza, amigo. Entendo. Sem rancor.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039738
    m_Localized: 'Bald: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039737
    m_Localized: 'Bald: Chega mais depois, beleza? Eu tenho umas histórias malucas. Elas vão explodir a sua mente, ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039736
    m_Localized: 'Bald: Cara, você é o salvador da pátria.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039735
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039734
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039733
    m_Localized: 'Bald: Basicamente, eu não vou incomodar. Vou te contar tudo, só... Só me deixa entrar, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039732
    m_Localized: 'Bald: Ela tava tentando me proteger, nunca me disse nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039731
    m_Localized: 'Bald: Eles querem a minha mãe.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039730
    m_Localized: 'Bald: Nem, eles não tão atrás de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039729
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039728
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039727
    m_Localized: 'Bald: E com essa porcaria de sol, tudo foi pro espaço.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039726
    m_Localized: 'Bald: Mas agora... eu... Bom, não consegui falar com nenhum deles. Todo mundo tem seus próprios problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039725
    m_Localized: 'Bald: Eles eram caras legais, sempre prontos pra ajudar, compartilhar uma cerveja ou só passar o tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039724
    m_Localized: 'Bald: Tudo pessoal do teatro. Bebíamos juntos, ficávamos de bobeira, nos ajudávamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039723
    m_Localized: Então você tem um monte de gente furiosa atrás de você?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039722
    m_Localized: Que tipo de amigos são esses?
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039721
    m_Localized: 'Bald: Eu costumava morar com a minha mãe e minha vó, mas fomos mandados embora. Coleta de dívidas... Tudo tá um caos...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039720
    m_Localized: 'Bald: Achei que eu tinha vários amigos, sabe? Que iríamos nos manter juntos durante essa situação... Mas aqui estou.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039719
    m_Localized: 'Bald: Se importa se eu ficar aqui um pouco? Todos os outros ou não estão em casa, ou foram chutados pra fora, ou só deus sabe o que.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039718
    m_Localized: 'Bald: Ei amigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039717
    m_Localized: 'Tough: ... pau no cu.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039716
    m_Localized: 'Tough: Mas que...'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039715
    m_Localized: 'Tough: Hum, não esperava diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039714
    m_Localized: 'Tough: Não?'
    m_Metadata:
      m_Items: []
  - m_Id: 74170346868039713
    m_Localized: 'Tough: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303878
    m_Localized: Não estou só
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303877
    m_Localized: Estou só
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303876
    m_Localized: 'SuperFake: Você tá só em casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303875
    m_Localized: 'SuperFake: Tá certo...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303874
    m_Localized: 'SuperFake: E do que restou, o que importa? Você está totalmente sozinho agora. Sem família.'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303873
    m_Localized: 'SuperFake: Que tensão é essa? Esse apego com a vida...'
    m_Metadata:
      m_Items: []
  - m_Id: 53568206420303872
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371408
    m_Localized: 'Vigilante: Aproveite o que sobrou.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371407
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371406
    m_Localized: 'Vigilante: Você não vai me ver outra vez. Eu já fiz o que tinha que fazer aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371405
    m_Localized: 'Vigilante: Já deu pra mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371404
    m_Localized: 'Vigilante: Orelhas? Que porra de orelha?! Isso não é sinal nenhum de ser um Visitante!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371403
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371402
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371401
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371400
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371399
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371398
    m_Localized: 'Vigilante: Orelhas? Que porra de orelha?! Isso não é sinal nenhum de ser um Visitante!'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371397
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371396
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371395
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371394
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371393
    m_Localized: 'Vigilante: Me mostre as suas mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336365371392
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177095
    m_Localized: 'CultistPriest: Até logo.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177094
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177093
    m_Localized: 'CultistPriest: Muito bem, essa é a sua escolha. A Morte vai reivindicar o que é dela por direito, cedo ou tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177092
    m_Localized: Eu desejei por muito tempo encontrar paz... Eu vou com você
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177091
    m_Localized: Se você quer tanto assim morrer então vai em frente. Eu vou ficar
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177090
    m_Localized: 'CultistPriest: Participe do nosso ritual, e encontre paz. O que você me diz? Você vai participar da nossa caminhada sagrada em direção a Morte?'
    m_Metadata:
      m_Items: []
  - m_Id: 53210336361177089
    m_Localized: 'CultistPriest: Como um símbolo de gratidão, eu poderia oferecer você a salvação...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077108891663
    m_Localized: 'Mother: Talvez já seja tarde demais...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633033
    m_Localized: 'BigLebowski: Massa!'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633032
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633031
    m_Localized: Eu vou expulsar. Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633030
    m_Localized: 'BigLebowski: Ei, isso rimou. Massa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633029
    m_Localized: 'BigLebowski: Se eu ficar as coisas vão ser do jeito que eu comandar.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633028
    m_Localized: 'BigLebowski: Ugh, esquece. Você já tem {0} no lugar que junta as casas.'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633027
    m_Localized: 'BigLebowski: Vai se lascar, mano...'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633026
    m_Localized: 'BigLebowski: Você é que nem o meu pai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200674
    m_Localized: 'FatalDame: Bem... Ele não acha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200673
    m_Localized: 'FatalDame: Você acha que enfrentar o fim totalmente só vai fazer com que as coisas fiquem mais fáceis?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200672
    m_Localized: 'FatalDame: Eu não esperava uma resposta diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200671
    m_Localized: 'FatalDame: Tenho certeza que vamos nos distrair com algo... melhor... do que a paranóia e a autopiedade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200670
    m_Localized: 'FatalDame: Vamos fugir dos horrores desse mundo, só eu e você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200669
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200668
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200667
    m_Localized: 'FatalDame: Talvez a gente devesse tentar... se conectar... juntos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200666
    m_Localized: 'FatalDame: Eu posso te ajudar se você quiser, neném. Você poderia praticar em mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200665
    m_Localized: 'FatalDame: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200664
    m_Localized: 'FatalDame: Conectar com as pessoas é difícil. Você não é o único sofrendo com isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200663
    m_Localized: 'FatalDame: Entendo. Não tem muitas pessoas que sabem como escutar sem se meter falando, “Bom, já me aconteceu coisa pior...”'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200662
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200661
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200660
    m_Localized: 'FatalDame: Todo mundo precisa de conforto. Um pouco de mimo... um pouco de afeto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200659
    m_Localized: 'FatalDame: Se você deixar eu entrar eu ainda vou poder ajudar você com a dor, e nos curaremos juntos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200658
    m_Localized: 'FatalDame: E...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200657
    m_Localized: 'FatalDame: Eu senti o mesmo, neném. Nós podemos conversar sobre isso... se você quiser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200656
    m_Localized: 'FatalDame: Se libertar da raiva é difícil. E perdoar é mais complicado ainda...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200655
    m_Localized: 'FatalDame: Você cresceu com um pai abusivo? Isso é horrível. Fico feliz por você ter superado isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200654
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200653
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200652
    m_Localized: 'FatalDame: Me deixa entrar e eu te dou isso... vou fazer você sentir alguma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200651
    m_Localized: 'FatalDame: Mas até mesmo a alma mais solitária merece... atenção.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200650
    m_Localized: 'FatalDame: Nos dias de hoje, todos estão obcecados com o fim do mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200649
    m_Localized: 'FatalDame: Eu posso te oferecer algo que a maioria não ofereceria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200648
    m_Localized: 'FatalDame: Hum...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200647
    m_Localized: 'FatalDame: Mas eu não vou forçar você a desabafar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200646
    m_Localized: 'FatalDame: Talvez isso ajude, assim que você botar tudo pra fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200645
    m_Localized: Eu nunca levei jeito com as pessoas. E não é agora que isso vai mudar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200644
    m_Localized: Eu rezava para que meu pai caísse morto. Isso é o suficiente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200643
    m_Localized: Eu não quero te ver outra vez
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200642
    m_Localized: 'FatalDame: Me diz, neném. Eu sou só uma estranha na sua porta. Talvez a gente nem se veja outra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200641
    m_Localized: 'FatalDame: Ou foi a sua infância? Tempos difíceis, eu sei. As memórias estão voltando de uma vez? Coitadinho...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200640
    m_Localized: 'FatalDame: Talvez os visitantes tenham matado alguém próximo a você e isso te forçou a se fechar emocionalmente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200639
    m_Localized: 'FatalDame: Alguma coisa te entristeceu? A sua esposa te largou?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200638
    m_Localized: 'FatalDame: Ah, você me machuca!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200637
    m_Localized: Eu nunca levei jeito com as pessoas. E não é agora que isso vai mudar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200636
    m_Localized: Eu rezava para que meu pai caísse morto. Isso é o suficiente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200635
    m_Localized: Prefiro não fazer isso
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200634
    m_Localized: 'FatalDame: Você não é de falar muito, né? Me fala sobre você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200633
    m_Localized: 'FatalDame: Recentemente as pessoas ficam reparando na minha aparência. Mais do que costumavam fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200632
    m_Localized: 'FatalDame: Você gostou, neném?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200631
    m_Localized: 'FatalDame: Então você percebeu. Obrigada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200630
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200629
    m_Localized: Você parece ser... diferente.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200628
    m_Localized: 'FatalDame: Que bobo da minha parte fazer essa pergunta. Afinal, você vive aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200627
    m_Localized: 'FatalDame: Já conseguiu se adaptar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200626
    m_Localized: 'FatalDame: Como essa nova vida está te tratando, neném?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200624
    m_Localized: 'Vigilante: Sinceramente? Eu não dou a mínima pra sua foto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200623
    m_Localized: 'Vigilante: Parece que tá tudo certo, assim como metade desses sorrateiros que eu enterrei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200622
    m_Localized: 'Vigilante: De novo com essa merda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200621
    m_Localized: 'Vigilante: Vai se fuder. Eu não vou cheirar teu sovaco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200620
    m_Localized: 'Vigilante: Se tem algo crescendo aí, é melhor eu não descobrir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200619
    m_Localized: 'Vigilante: Tá de brincadeira comigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200617
    m_Localized: 'Vigilante: Tá livre pra ir... por hora. Não tenho tempo pra essa merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200616
    m_Localized: 'Vigilante: Tá. Ainda não significa que você tá limpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200615
    m_Localized: 'Vigilante: Abra mais a porra dos olhos. Para de me fazer de besta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200614
    m_Localized: 'Vigilante: Não tenho tempo pra isso agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200613
    m_Localized: 'Vigilante: Hunf... Sujo ou limpo, pouco importa. Os Visitantes se misturam com facilidade de qualquer forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200612
    m_Localized: 'Vigilante: Então? Anda. Eu não mordo, a não ser que seja preciso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200611
    m_Localized: 'Vigilante: Chega de conversa. Eu tô perdendo meu tempo aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200610
    m_Localized: 'Vigilante: Não fica se achando. Uma escorregada e você já era.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200609
    m_Localized: 'Vigilante: Certo. Me parece limpo. Mas, de verdade? Seria mais fácil se não fosse o caso. É menos problema pra gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200608
    m_Localized: 'Vigilante: Abre a porra da boca. Abre mais. Não sou dentista, caralho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200607
    m_Localized: (Mostrar orelhas)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200606
    m_Localized: (Mostrar foto)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200605
    m_Localized: (Mostras as axilas)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200604
    m_Localized: (Mostrar os olhos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200603
    m_Localized: (Mostrar as mãos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200602
    m_Localized: (Mostrar os dentes)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200601
    m_Localized: 'Vigilante: Enfim. Chega de conversa. Me mostre os sinais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200600
    m_Localized: 'Vigilante: Eles riram. Disseram que eu devia me inscrever. Nem a pau. Tudo que eles fazem é arrastar as pessoas pra longe, e os Visitantes continuam aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200599
    m_Localized: 'Vigilante: A FEMA apareceu, falando de limpeza. Falei pra eles que já tava feito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200598
    m_Localized: 'Vigilante: Matei ela primeiro. Depois ele. As crianças escaparam com os vizinhos de alguma forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200597
    m_Localized: 'Vigilante: Quando os Visitantes começaram a escalar o telhado, o maldito abriu a porta. Deixou ela fugir. Então eu fiz o que ele não conseguia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200596
    m_Localized: 'Vigilante: Mas a esposa... ela estava mostrando sinais. E ele continuou implorando, “Ela é minha esposa. Não toque nela!”'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200595
    m_Localized: 'Vigilante: Tinha essa família na beira da cidade. Estavam barricados, o pai segurando a porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200594
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200593
    m_Localized: 'Vigilante: Mas agora? Não me importo mais. Já terminei com isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200592
    m_Localized: 'Vigilante: Não tem porque olhar. Perda de tempo. Se meu irmão tivesse coragem, talvez ainda tivesse uma chance.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200591
    m_Localized: (Mostrar orelhas)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200590
    m_Localized: (Mostrar foto)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200589
    m_Localized: (Mostras as axilas)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200588
    m_Localized: (Mostrar os olhos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200587
    m_Localized: (Mostrar as mãos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200586
    m_Localized: (Mostrar os dentes)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200585
    m_Localized: 'Vigilante: Enfim. Chega de historinha. Me mostre os sinais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200584
    m_Localized: 'Vigilante: Os olhos selvagens, mas ela ainda estava viva. Isso é o que eu respeito. Não como o meu irmão. Porra, se ele tivesse morrido antes quem sabe a família dele tivesse escapado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200583
    m_Localized: 'Vigilante: Achei que tivessem morrido. Mas alguns dias depois eles me encontraram. A primeira a sair do meio das árvores? A filha dele. Com a espingarda na mão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200582
    m_Localized: 'Vigilante: Conseguiu levar a família pelos fundos, para a floresta. Eu matei aquelas aberrações, mas eles nunca voltaram.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200581
    m_Localized: 'Vigilante: Eu vi uma família não faz muito tempo. Pai grandinho. Ele aguentou, mesmo com os Visitantes gritando pelas janelas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200580
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200579
    m_Localized: 'Vigilante: Essa merda toda? Culpa de covardes como ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200578
    m_Localized: 'Vigilante: Amarelou feito um covarde. Agora a família dele está enterrado ou sabe-se lá onde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200577
    m_Localized: 'Vigilante: O mesmo de sempre. Eu fali pro meu irmão... Seja homem, proteja sua família. E o que ele fez?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200576
    m_Localized: Você quer encontrar ela?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200575
    m_Localized: Como você está?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200574
    m_Localized: 'Vigilante: Se meu irmão não tivesse sido um fracote, talvez tivesse mantido a filha e a esposa seguras. Agora vai saber onde a criança foi parar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200573
    m_Localized: 'Vigilante: Voltei. Não sei nem por que eu ainda me importo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200572
    m_Localized: 'Vigilante: Eu não tenho tempo pra isso. Eu tenho coisas mais importantes pra resolver. Eu vou voltar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200571
    m_Localized: 'Vigilante: Tente essa coisa da orelha de novo, e vou te matar na hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200570
    m_Localized: 'Vigilante: Se não fosse pelo meu irmão...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200569
    m_Localized: 'Vigilante: Orelhas? Você pensa que eu sou um imbecil?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200568
    m_Localized: 'Vigilante: Honestamente? Não dou a mínima pra sua foto de merda. Tenho problemas reais pra resolver. Você vai viver por hoje. Vamos fazer uma verificação de verdade depois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200567
    m_Localized: 'Vigilante: Humpf... Parece tudo certo, claramente. Mas eu já enterrei muitos “limpos” pra aceitar assim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200566
    m_Localized: 'Vigilante: Uma foto? Auras, é? Tá bom, vamos ver o quão “limpo” você é.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200565
    m_Localized: 'Vigilante: Nada. Sorte sua. Agora tira isso da minha cara, tenho problemas maiores pra resolver. Eu vou voltar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200564
    m_Localized: 'Vigilante: Parece que tá bom. Mas isso não significa merda nenhuma. Esses esquisitos conseguem fingir melhor do que eu consigo detectar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200563
    m_Localized: 'Vigilante: Humpf...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200562
    m_Localized: 'Vigilante: Agora não. Tenho coisas mais importantes pra resolver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200561
    m_Localized: 'Vigilante: Você se safou por hora. Mas da próxima vez que eu vir algo estranho, eu atiro primeiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200560
    m_Localized: 'Vigilante: Você sabe o que um desses “normais” pode fazer em uma única noite? Um descuido e todos morrem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200559
    m_Localized: 'Vigilante: Heh... Nada, é? Ótimo. Muito bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200558
    m_Localized: 'Vigilante: Vamos. Use suas mãos, porra. Abra bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200557
    m_Localized: 'Vigilante: Não tenho tempo pra ver suas mãos agora. Vou verificar direito da próxima vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200556
    m_Localized: 'Vigilante: Vou te dizer uma coisa. Uma dica: aqueles que parecem normais? Eles são os primeiros a te trair.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200555
    m_Localized: 'Vigilante: Limpo... Sim, é claro que tá limpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200554
    m_Localized: 'Vigilante: Merda, eu não tenho tempo pra isso. Tem algo que preciso verificar. Até.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200553
    m_Localized: 'Vigilante: Tá bom. Viva por hoje. Mas da próxima vez que eu vir algo estranho, vamos pular a conversa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200552
    m_Localized: 'Vigilante: Humpf... Limpo. Uma pena, realmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200551
    m_Localized: 'Vigilante: Abre mais. Vamos, não se cague todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200550
    m_Localized: (Mostrar orelhas)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200549
    m_Localized: (Mostrar foto)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200548
    m_Localized: (Mostras as axilas)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200547
    m_Localized: (Mostrar os olhos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200546
    m_Localized: (Mostrar as mãos)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200545
    m_Localized: (Mostrar os dentes)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200544
    m_Localized: 'Vigilante: Você tem uma arma? Foda-se. Vamos os dois cair atirando, então.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200543
    m_Localized: 'Vigilante: Me mostre um sinal. Qualquer um deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200542
    m_Localized: 'Vigilante: Humm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200541
    m_Localized: 'Vigilante: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200540
    m_Localized: Só a filha dele escapou. Esse cara morreu
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200539
    m_Localized: A casa dele queimou. Não vi ele desde então
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200538
    m_Localized: 'Vigilante: A esposa... foda-se a esposa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200537
    m_Localized: 'Vigilante: Ele tá com uma criança. Uma menina. Não sei quantos anos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200536
    m_Localized: 'Vigilante: Já que estou aqui... Viu um cara corpulento, com uma jaqueta jeans azul?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200535
    m_Localized: 'Vigilante: Os Visitantes se alimentam da fraqueza daqueles de coração mole. É assim que as pessoas são mortas nas próprias casas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200534
    m_Localized: 'Vigilante: A justiça começa agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200533
    m_Localized: Só a filha dele escapou. Esse cara morreu
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200532
    m_Localized: A casa dele queimou. Não vi ele desde então
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200531
    m_Localized: 'Vigilante: A esposa... foda-se a esposa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200530
    m_Localized: 'Vigilante: Ele tá com uma criança. Uma menina. Não sei quantos anos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200529
    m_Localized: 'Vigilante: Já que estou aqui... Viu um cara corpulento, com uma jaqueta jeans azul?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200528
    m_Localized: 'Vigilante: Um único sinal é o suficiente pra eliminar eles. Eu não espero um segundo sequer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200527
    m_Localized: 'Vigilante: A TV e o rádio dizem tudo pra gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200526
    m_Localized: 'Vigilante: Ora, aposto que da mesma forma que você, caramba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200525
    m_Localized: E se eles mostrarem só um ou dois sinais?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200524
    m_Localized: Como você identifica um Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200523
    m_Localized: 'Vigilante: A FEMA desistiu dessa cidade? Ou é só esse quarteirão?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200522
    m_Localized: 'Vigilante: Eu passei por algumas casas. Esse lugar está infestado de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200521
    m_Localized: 'Vigilante: Tentei encontrar aquela pessoa que eu falei antes. Não tive sorte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200520
    m_Localized: 'Vigilante: Voltei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200519
    m_Localized: 'Vigilante: Eu volto aqui mais tarde... Você fisgou meu interesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200518
    m_Localized: 'Vigilante: Tem uma pessoa que eu preciso saber como está.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200517
    m_Localized: 'Vigilante: Por que você diz que eles são uma ameaça?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200516
    m_Localized: 'Vigilante: Eles possuem o jeito deles de detectar sinais de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200515
    m_Localized: 'Vigilante: Eles sabem o que estão fazendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200514
    m_Localized: 'Vigilante: E você, descanse. A gente conversa mais tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200513
    m_Localized: 'Vigilante: Eu preciso lidar com isso do meu jeito. E é o que eu pretendo fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152875200512
    m_Localized: 'Vigilante: Mas, eu não acredito em você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006469
    m_Localized: 'Vigilante: Então você está tentando manter a ordem também. Ótimo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006468
    m_Localized: 'Vigilante: Você conseguiu a minha atenção. Voltarei aqui outra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006467
    m_Localized: 'Vigilante: Sim, acho que você viu. Você não me parece alguém que sai espalhando mentiras por aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006466
    m_Localized: 'Vigilante: Interessante. Você viu mesmo ele?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006465
    m_Localized: 'Vigilante: Então ele não tava usando nenhum tipo de armadura?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006464
    m_Localized: 'Vigilante: Só um? Quase pelado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006463
    m_Localized: A FEMA tem levado pessoas embora. Não faço ideia se eles vão voltar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006462
    m_Localized: Os Visitantes não param de aparecer. Mas eu tenho a minha arma
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006461
    m_Localized: Um Visitante quase pelado aniquilou uma patrulha inteira
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006460
    m_Localized: 'Vigilante: O que tá acontecendo aqui? Algum tipo de ameaça para eu ficar esperto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006459
    m_Localized: 'Vigilante: Você tinha suas perguntas. Agora eu tenho as minhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006458
    m_Localized: 'Vigilante: Espera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006457
    m_Localized: Quanto tempo você planeja “fazer faxina”?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006456
    m_Localized: Então por que você está aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006455
    m_Localized: 'Vigilante: E se algum deles me impressionar de alguma forma... aí talvez eu leve outra coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006454
    m_Localized: 'Vigilante: Geralmente eu arranco o dente dos Visitantes. São os troféus mais fáceis de obter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006453
    m_Localized: 'Vigilante: É um lembrete para que eu não esqueça de quantas casas e quantas cidades eu purifiquei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006452
    m_Localized: 'Vigilante: Heh. Boa. Eu vou lembrar dessa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006451
    m_Localized: 'Vigilante: Repelente? Ah, você quer dizer o colar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006450
    m_Localized: Quanto tempo você planeja “fazer faxina”?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006449
    m_Localized: Então por que você está aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006448
    m_Localized: 'Vigilante: E todos que sentem pena de Visitantes... são a mesma coisa que um deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006447
    m_Localized: 'Vigilante: Mas a forma mais efetiva? Trancar em uma casa e botar fogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006446
    m_Localized: 'Vigilante: Eu posso limpar a sujeira com as minhas mãos. Isso só consegue resultados melhores.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006445
    m_Localized: 'Vigilante: Sim. É uma vassoura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006444
    m_Localized: 'Vigilante: Heh. Eu gosto da forma que você fala.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006443
    m_Localized: Qual é a do equipamento todo? Repelente de Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006442
    m_Localized: Deixa eu adivinhar, é uma vassoura nas suas mão?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006441
    m_Localized: 'Vigilante: Eu não me escondo dentro de casa. Eu sou a justiça. Eu trago ordem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006440
    m_Localized: 'Vigilante: Sem justiça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006439
    m_Localized: 'Vigilante: Então alguns dias passam e os Visitantes matam todos dentro da casa e fogem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006438
    m_Localized: 'Vigilante: Algumas pessoas tem pena dos Visitantes. Pensam que eles pode, sei lá... se recuperar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006437
    m_Localized: 'Vigilante: Isso não é uma porra de uma aventura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006436
    m_Localized: Qual é a do equipamento todo? Repelente de Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006435
    m_Localized: Deixa eu adivinhar, é uma vassoura nas suas mão?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006434
    m_Localized: 'Vigilante: O resto? Não é da sua conta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006433
    m_Localized: 'Vigilante: Meu setor já tá arrumado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006432
    m_Localized: 'Vigilante: Tô aqui pra fazer a limpeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006431
    m_Localized: Por que você tá nas ruas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006430
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006429
    m_Localized: 'Vigilante: A não ser que você seja um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006428
    m_Localized: 'Vigilante: Ótimo. Isso aumenta as suas chances de sobrevivência.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006427
    m_Localized: 'Vigilante: Mantendo a distância, é?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006426
    m_Localized: 'Miner: Voltar para sua vida como se nada tivesse acontecido? Vamos, desce lá. Vamos descobrir. Juntos. Então?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006425
    m_Localized: 'Miner: E se tem algo lá em baixo que vai mudar tudo? Que dirá a verdade. O tornará um herói. Você vai só dar as costas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006424
    m_Localized: 'Miner: Nunca descobrir? Você tá de brincadeira? Você sabe que não é só um buraco. Você também sente isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006423
    m_Localized: 'Miner: E aí? O que você tá esperando? A gente tá aqui pra isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006422
    m_Localized: 'Miner: Você quer mesmo passar o resto da sua vida se perguntando "e se eu tivesse ido" só por que você tá com medo agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006421
    m_Localized: 'Miner: Vai. Mostra um pouco de coragem. Você desce e eu protejo você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006420
    m_Localized: 'Miner: Você quer saber o que tem lá embaixo, né? Eu vejo que você não é um covarde. Você já desceu aqui três vezes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006419
    m_Localized: 'Miner: Eu puxo você de volta com um braço. Mas se eu for, quem vai segurar a corda? É pura lógica.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006418
    m_Localized: 'Miner: Quem vai puxar você se eu for, HEIN? Você? Sem ofensas amigo, mas você é um graveto. Você entra, eu fico. Faze sentido, não?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006417
    m_Localized: E se nunca descobrirmos o que tem lá em baixo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006416
    m_Localized: Por que não desce você mesmo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006415
    m_Localized: 'Miner: Você sente isso também, não? Aquela atração... como se o buraco estivesse chamando. Você sente, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006414
    m_Localized: 'Miner: Que outro? Olha, alguém tem que fazer alguma coisa. Não dá pra ficar parado pra sempre. É agora ou nunca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006413
    m_Localized: E se nunca descobrirmos o que tem lá em baixo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006412
    m_Localized: Por que não desce você mesmo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006411
    m_Localized: 'Miner: Mas, ei, ainda temos tempo de sobra enquanto esperamos. Talvez seja hora de descobrir esse lugar inteiro. Admita, você tá curioso!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006410
    m_Localized: 'Miner: Ah, CLARO QUE SIM. A corda ainda tá fazendo tensão, TÁ VENDO? Isso significa que ele tá lá embaixo, trabalhando. Eu saberia se alguma coisa tivesse dado errado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006409
    m_Localized: O outro ainda está desaparecido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006408
    m_Localized: Acha que o seu amigo ainda está vivo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006407
    m_Localized: Mas, aquele buraco... seja honesto, quantas vezes ele já atraiu você? Ele meio que te puxa, né? Admite.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006406
    m_Localized: Ou talvez eu só esteja aqui por tanto tempo e a minha imaginação começou a descarrilhar.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006405
    m_Localized: 'Miner: AH, É VOCÊ! Achei que tinha amarelado. Tem coisa estranha, é claro. As luzes estão bizarras, a corda parece estar estranhamente pesada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006404
    m_Localized: 'Miner: Você não foi feito pra levantar peso, mas eu poderia puxar você sem esforço. Então, o que você acha? Você vai lá dar uma olhada e eu... fico de vigia?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006403
    m_Localized: 'Miner: Uma ida lá em baixo e a gente vai finalmente descobrir. Eu mesmo iria, mas... alguém precisa deixar a corda firme, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006402
    m_Localized: 'Miner: E se as respostas estiverem lá em baixo? Não todas elas, é claro. Mas o por que vieram, o que eles realmente querem... pensa nisso!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006401
    m_Localized: 'Miner: VISITANTES? É isso o que eu venho dizendo! Nós achamos que esses túneis são deles. E o buraco dever ser um tipo de... porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006400
    m_Localized: 'Miner: A gente tem que ficar junto, tá? Alguém precisa estar pronto para ajudar o outro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006399
    m_Localized: 'Miner: Não que eu esteja com medo, mas... isso te chama. Se eu pudesse dar mais uma olhada... só um pouco mais perto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006398
    m_Localized: 'Miner: Ainda assim, às vezes quando você fica perto dele... você sente. Como se algo estivesse chamando você. Experimenta. Só... escuta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006397
    m_Localized: 'Miner: Cheguei perto, quando os outros caras ainda estavam aqui. Mas lá em baixo... é como ficar olhando para o abismo. Um vazio completo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006396
    m_Localized: 'Miner: Eu adoraria, mas, olha só... uma puxada em falso naquela corda e já era.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006395
    m_Localized: 'Miner: Uma olhada? Mais ou menos. Não de verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006394
    m_Localized: Você não está preocupado que alguma coisa tenha acontecido com os seus amigos lá embaixo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006393
    m_Localized: Você já deu uma olhada no buraco?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006392
    m_Localized: 'Miner: VIU? A corda está firme. Isso significa que ele ainda tá lá embaixo, trabalhando. A gente saberia se alguma coisa tivesse dado errado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006391
    m_Localized: 'Miner: O outro está na corda. Ele vai dar uma puxada quando estiver pronto, ou se algo der errado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006390
    m_Localized: 'Miner: HÃ? MEUS AMIGOS? Nadinha, eles tão tranquilos. Um foi fundo, mas ele volta. O cara sabe como detectar uma saída.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006389
    m_Localized: Você não está preocupado que alguma coisa tenha acontecido com os seus amigos lá embaixo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006388
    m_Localized: Você já deu uma olhada no buraco?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006387
    m_Localized: 'Miner: É melhor comer alguma coisa aí em cima ou você vai acabar que nem eu, passando fome em um buraco e só com uma lanterna para conversar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006386
    m_Localized: 'Miner: O tempo é esquisito aqui em baixo. Sem luz, sem relógios. Eu sei lá quantas horas já se passaram.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006385
    m_Localized: 'Miner: COMO É? FALA ALTO! Acho que já fazem uns três dias que eu tô sentado aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006384
    m_Localized: Seus amigos ainda não voltaram?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006383
    m_Localized: Você está aqui embaixo por quanto tempo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006382
    m_Localized: 'Miner: Hum? Voltou? Tá mais quieto agora, né? Hum? Ou sou só eu ficando surdo por causa do sussurro? Então? Fala.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006381
    m_Localized: 'Miner: Vou dizer mais quando você chegar aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006380
    m_Localized: 'Miner: A gente tentou e o lugar inteiro quase desmorona nas nossas cabeças.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006379
    m_Localized: 'Miner: Olha, se você tá pensando em descer aqui... fica longe do buraco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006378
    m_Localized: 'Miner: Um dos caras ouviu uma coisa sobre isso. Falou que talvez seja uma boa dar uma olhada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006377
    m_Localized: 'Miner: É só um fosso, mas tem coisa estranha acontecendo por perto dele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006376
    m_Localized: 'Miner: Nem, nada de mais, mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006375
    m_Localized: 'Miner: O que?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006374
    m_Localized: 'Miner: Nós tentamos, e quase desmoronamos tudo nas nossas cabeças.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006373
    m_Localized: 'Miner: Escuta, se você está pensando em descer aqui... fica longe daquele buraco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006372
    m_Localized: 'Miner: Um dos nossos caras entrou. Eu fiquei aqui, caso ele precise de uma mão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006371
    m_Localized: 'Miner: Os animais ficam em silêncio. A bússola fica maluca. As lanternas não iluminam a escuridão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006370
    m_Localized: 'Miner: Algo está acontecendo por perto dele. Um sussurro bem quieto, sempre lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006369
    m_Localized: 'Miner: TEM UM BURACO!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006368
    m_Localized: Vocês pegaram um Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006367
    m_Localized: O que é? Algo interessante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006366
    m_Localized: 'Miner: Mas, escuta, esses túneis não são nem a parte mais esquisita. Tem mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006365
    m_Localized: 'Miner: Ainda não vi nenhum, então não posso dizer com certeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006364
    m_Localized: 'Miner: A gente acha que os Visitantes usam eles para se locomoverem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006363
    m_Localized: 'Miner: Não faço ideia de quem cavou ou por quê. E sim, temos uma teoria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006362
    m_Localized: 'Miner: Começamos a cavar, e o que encontramos? Um SISTEMA DE TÚNEIS inteiro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006361
    m_Localized: 'Miner: UM ABRIGO, CARAMBA! Pra fugir da porra do calor do sol!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006360
    m_Localized: Vocês pegaram um Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006359
    m_Localized: O que é? Algo interessante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006358
    m_Localized: 'Miner: Mas esquece isso, porque encontramos outra coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006357
    m_Localized: 'Miner: Esses túneis são compridos. BEM COMPRIDOS. Não tenho ideia de onde eles acabam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006356
    m_Localized: 'Miner: Existiam mais dessas redes subterrâneas, mas elas desmoronaram recentemente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006355
    m_Localized: 'Miner: A gente mal começou a cavar e, OLHA SÓ! A gente encontrou toda uma rede subterrânea!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006354
    m_Localized: 'Miner: Eu e os caras pensamos em cavar uns túneis para se esconder do calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006353
    m_Localized: O que você está procurando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006352
    m_Localized: Por que você está aí embaixo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006351
    m_Localized: 'Miner: Tem tanta poeira no meu ouvido que parece que você tá falando com uma máscara no rosto. Juro por Deus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006350
    m_Localized: 'Miner: Preso? Que nada. A gente encontrou uma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006349
    m_Localized: 'Miner: Hã?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006348
    m_Localized: O que você está procurando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006347
    m_Localized: Por que você está aí embaixo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006346
    m_Localized: 'Miner: Bom, tomara que ela não desmorone na gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006345
    m_Localized: 'Miner: Estamos em baixo da sua casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006344
    m_Localized: 'Miner: Meu ouvido tá coberto de poeira e fuligem, não consigo escutar nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006343
    m_Localized: 'Miner: O quê Fala mais alto!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006342
    m_Localized: Você está preso aí?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006341
    m_Localized: O que você está fazendo em baixo da minha casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006340
    m_Localized: 'Miner: Eu acho...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006339
    m_Localized: 'Miner: Hã? Quem está aí? Pensei ter ouvido algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006338
    m_Localized: 'MushroomEater: Inté!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006337
    m_Localized: 'MushroomEater: Desejo um ótimo dia, boa saúde, grande felicidade e muitos sorrisos, meu bom garoto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006336
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006335
    m_Localized: 'MushroomEater: Temo que toda a esperança esteja perdida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006334
    m_Localized: 'MushroomEater: Pois bem...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006333
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006332
    m_Localized: Sim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006331
    m_Localized: 'MushroomEater: Então, bom garoto, me deixa perguntar mais uma vez. Você vai vir comigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006330
    m_Localized: 'MushroomEater: Eu não sei o que espera a gente na Terra dos Cogumelos... mas podemos ter certeza de uma coisa... do perigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006329
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006328
    m_Localized: 'MushroomEater: Estamos passando por momentos turbulentos, meu garoto. Dançando, enquanto a Terra dos Cogumelos vira história. Talvez a gente dance, também... talvez...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006327
    m_Localized: 'MushroomEater: Temo que não consigo fazer isso sozinho. Preciso da sua ajuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006326
    m_Localized: 'MushroomEater: Ah, meu bom garoto... Isso não é bom...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006325
    m_Localized: 'MushroomEater: Antes que o portão para a Terra dos Cogumelos se feche!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006324
    m_Localized: 'MushroomEater: Ai, minha nossa! Estamos atrasados! Vem comigo, agora! Agiliza!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006323
    m_Localized: 'MushroomEater: MEIA-NOITE?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006322
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006321
    m_Localized: 'MushroomEater: Pera só um bendito minuto. Deixa eu ver o seu relógio!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006320
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006319
    m_Localized: 'MushroomEater: Junte suas coisas e...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006318
    m_Localized: 'MushroomEater: Hoho! O espírito é esse aí, meu bom garoto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006317
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006316
    m_Localized: Sim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006315
    m_Localized: 'MushroomEater: Você está pronto para ir comigo para a Terra dos Cogumelos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006314
    m_Localized: 'MushroomEater: Ninguém deveria pisar lá, nunca. Nunquinha mesmo. Mas precisamos, se quisermos parar o Festival.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006313
    m_Localized: 'MushroomEater: Se não agirmos agora, pode não ter mais jeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006312
    m_Localized: 'MushroomEater: A gente não vai ver o Festival lá... mas os outros, o Micélio...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006311
    m_Localized: 'MushroomEater: Não é uma terra de sol e felicidade. Não, na-ni-na-não!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006310
    m_Localized: 'MushroomEater: Pode parecer quase divertido na nossa língua mas, na língua dos cogumelos, isso significa algo totalmente diferente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006309
    m_Localized: 'MushroomEater: Não deixe o nome enganar você, meu bom garoto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006308
    m_Localized: Não
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006307
    m_Localized: Sim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006306
    m_Localized: 'MushroomEater: Você está pronto para ir comigo para a Terra dos Cogumelos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006305
    m_Localized: 'MushroomEater: Precisamos parar o Festival, não importa o quê!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006304
    m_Localized: 'MushroomEater: E, verdade seja dita... seria melhor assim. Mas, nós não temos escolha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006303
    m_Localized: 'MushroomEater: Hoho, e é mesmo assustador, meu bom garoto! Um lugar onde nenhum homem já pisou antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006302
    m_Localized: Isso parece ser meio assustador
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006301
    m_Localized: A Terra dos Cogumelos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006300
    m_Localized: 'MushroomEater: Eu não queria isso, mas... Acho que vamos precisar ir para a Terra dos Cogumelos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006299
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006298
    m_Localized: 'MushroomEater: O que significa que o Micélio está em grande perigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006297
    m_Localized: 'MushroomEater: O Festival significa que os cogumelos estão crescendo fora de controle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006296
    m_Localized: Não parece tão assustador
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006295
    m_Localized: A Terra dos Cogumelos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006294
    m_Localized: 'MushroomEater: Eu não queria isso, mas... Acho que vamos precisar ir para a Terra dos Cogumelos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006293
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006292
    m_Localized: 'MushroomEater: Mas ultimamente tem tanta malícia, que o cogumelo cresceu além dos limites.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006291
    m_Localized: 'MushroomEater: Os cogumelos são como um fígado, tentando limpar todo aquele veneno.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006290
    m_Localized: 'MushroomEater: Quando muita malícia se prolifera nos fios dele, isso entope tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006289
    m_Localized: 'MushroomEater: Tem alguma coisa errada no Micélio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006288
    m_Localized: Por que o Festival está acontecendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006287
    m_Localized: Por que não funcionou?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006286
    m_Localized: 'MushroomEater: Tem muito caos no Micélio que o ritual... ele não funcionou...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006285
    m_Localized: 'MushroomEater: Parece que o Festival está chegando de qualquer forma...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006284
    m_Localized: 'MushroomEater: Isso não é um adeus, meu bom garoto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006283
    m_Localized: 'MushroomEater: E lembre-se, os cogumelos nem sempre são o que parecem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006282
    m_Localized: 'MushroomEater: Vamos garantir que os cogumelos fiquem pequenos, e que o Festival não comece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006281
    m_Localized: 'MushroomEater: Eu voltarei quando a hora chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006280
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006279
    m_Localized: 'MushroomEater: O Micélio é o único capaz de pensar. Uma pena que posso somente escutar ele... ele não fala nossa língua...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006278
    m_Localized: 'MushroomEater: Eles são só uma parte do Micélio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006277
    m_Localized: 'MushroomEater: Isso faz sentido. Mas eu não posso falar com os cogumelos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006276
    m_Localized: 'MushroomEater: Isso não é adeus, meu bom garoto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006275
    m_Localized: 'MushroomEater: E lembre-se, os cogumelos nem sempre são o que parecem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006274
    m_Localized: 'MushroomEater: Vamos garantir que os cogumelos fiquem pequenos, e que o Festival não comece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006273
    m_Localized: 'MushroomEater: Eu voltarei quando a hora chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006272
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006271
    m_Localized: 'MushroomEater: E, bem, foi exatamente isso o que fizemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006270
    m_Localized: 'MushroomEater: Mas o Livro dos Sorrisos nos mostrou um caminho... um caminho para acalmar as raízes e crescimento imparável.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006269
    m_Localized: 'MushroomEater: Nós não conseguimos falar diretamente com os cogumelos, já que não somos parte do Micélio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006268
    m_Localized: 'MushroomEater: Nós realizamos um ritual antigo, meu bom garoto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006267
    m_Localized: Você só não poderia pedir para os cogumelos não começarem o Festival?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006266
    m_Localized: Como exatamente as nossas ações param o Festival?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006265
    m_Localized: 'MushroomEater: Tudo o que podemos fazer agora é aguardar. E torcer para que tenha sido o suficiente para impedir o crescimento dos cogumelos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006264
    m_Localized: 'MushroomEater: Ah, meu bom garoto... se ao menos fosse simples assim. Ainda não sabemos se o que fizemos realmente ajudou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006263
    m_Localized: Você só não pode pedir para os cogumelos não iniciarem o Festival?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006262
    m_Localized: Como exatamente as nossas ações param o Festival?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006261
    m_Localized: 'MushroomEater: Os cogumelos estão crescendo rápido demais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006260
    m_Localized: 'MushroomEater: Ele sabe de muita coisa. Mas, agora, ele também está em perigo... assim como o resto de nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006259
    m_Localized: 'MushroomEater: O Micélio me contou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006258
    m_Localized: Você não me parece convencido disso
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006257
    m_Localized: Como você pode ter certeza?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006256
    m_Localized: 'MushroomEater: Espero que tenha sido o suficiente para impedir o Festival...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006255
    m_Localized: 'MushroomEater: Aí está você de novo, meu garoto. Você fez tudo o que o Livro dos Sorrisos pediu para você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006254
    m_Localized: 'MushroomEater: Ah, talvez eu só esteja desperdiçando tempo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006253
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006252
    m_Localized: 'MushroomEater: Mas, por quê? É só uma parte pequena do livro... e eu sei de cor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006251
    m_Localized: 'MushroomEater: Desejo ao senhor um ótimo dia. Repleto de saúde, com alegria e uma enxurrada de sorrisos, meu bom garoto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006250
    m_Localized: 'MushroomEater: Voltarei assim que você concluir o que as páginas estão pedindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006249
    m_Localized: 'MushroomEater: Agora... eu preciso ir andando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006248
    m_Localized: 'MushroomEater: Muito bem. Dê uma olhada quando você tiver só.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006247
    m_Localized: Fique com elas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006246
    m_Localized: Certo, eu vou pegar as páginas do Livro dos Sorrisos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006245
    m_Localized: 'MushroomEater: Rasguei umas páginas do Livro dos Sorrisos. Por favor, pegue-as. Elas te dirão o que você precisa fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006244
    m_Localized: 'MushroomEater: Não podemos deixar isso acontecer. Nós... precisamos parar. Nós dois juntos, meu garoto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006243
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006242
    m_Localized: 'MushroomEater: E esse cogumelo não ficará só. Já que o Festival está chegando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006241
    m_Localized: 'MushroomEater: Sua sombra vai engolir o sol e nenhum lugar nesta terra será poupado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006240
    m_Localized: 'MushroomEater: Um cogumelo enorme vai surgir... e arremessar seus esporos para longe, bem longe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006239
    m_Localized: 'MushroomEater: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006238
    m_Localized: 'MushroomEater: Tudo o que eu posso dizer é o que o Livro dos Sorrisos diz sobre o Festival.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006237
    m_Localized: 'MushroomEater: Ah, meu bom garoto...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006236
    m_Localized: Fique com elas
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006235
    m_Localized: Certo, eu vou pegar as páginas do Livro dos Sorrisos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006234
    m_Localized: 'MushroomEater: Então rasguei só as páginas mais importantes. Aqui... pegue-as.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006233
    m_Localized: 'MushroomEater: Mas receio que não há tempo para lê-lo por inteiro. É um livro bem grande... e o tempo não está nos ajudando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006232
    m_Localized: 'MushroomEater: É um livro especial. Pode-se dizer que é o livro mais especial do mundo. Ele te conta o que precisa ser feito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006231
    m_Localized: O Festival do Cogumelo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006230
    m_Localized: O Livro dos Sorrisos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006229
    m_Localized: 'MushroomEater: Eu tenho algo que pode nos ajudar. O Livro dos Sorrisos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006228
    m_Localized: 'MushroomEater: Não se preocupe, isso tudo logo vai fazer sentido. Mas não se esqueça, nós devemos parar o Festival a qualquer custo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006227
    m_Localized: O Festival do Cogumelo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006226
    m_Localized: O Livro dos Sorrisos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006225
    m_Localized: 'MushroomEater: Ele falou da chegada do Festival do Cogumelo... e isso, meu bom garoto, não é nada bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006224
    m_Localized: 'MushroomEater: Eu aprendi a ouvir eles ao estudar o Livro dos Sorrisos. E o que o Micélio me contou da última vez... Bem, digamos que coisa boa não é.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006223
    m_Localized: 'MushroomEater: O Micélio é o que faz os cogumelos se comunicarem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006222
    m_Localized: 'MushroomEater: Sim, sim, eu sei que é difícil para as pessoas normais entenderem. Elas se expressam de uma forma única e estranha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006221
    m_Localized: Eu não entendi muito bem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006220
    m_Localized: Micélio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006219
    m_Localized: 'MushroomEater: Agora, escute bem, meu bom garoto. Nós temos trabalho para fazer e o tempo está curto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006218
    m_Localized: 'MushroomEater: Ele fala de forma enigmática, mas eu aprendi a entender como decifrar os sinais que eles transmitem, ah sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006217
    m_Localized: 'MushroomEater: É claro que eu sei quem é você, o Micélio me contou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006216
    m_Localized: Eu não entendi muito bem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006215
    m_Localized: Micélio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006214
    m_Localized: 'MushroomEater: Então, por favor, escute com atenção e guarde bem minhas palavras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006213
    m_Localized: 'MushroomEater: O Festival do Cogumelo já vem chegando e, o tempo, meu bom garoto, já se esvai por nossos dedos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006212
    m_Localized: 'MushroomEater: Mas não se importe comigo. O Micélio me contou algo alarmante...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006211
    m_Localized: 'MushroomEater: He he he hehe, eu sou apenas um senhor que sabe uma coisa ou outra sobre cogumelos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006210
    m_Localized: Você me conhece?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006209
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152871006208
    m_Localized: 'MushroomEater: Ei, olá para você, meu bom garoto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812165
    m_Localized: 'CultistPriest: Nós sairemos. O que precisava ser feito, foi feito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812164
    m_Localized: 'CultistPriest: De qualquer maneira, obrigado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812163
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812162
    m_Localized: 'CultistPriest: Ou é por que você não quer paz?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812161
    m_Localized: 'CultistPriest: Eles estavam mesmo incomodando você?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812160
    m_Localized: 'CultistPriest: Vou levá-los comigo. De uma forma ou de outra, obrigado por ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812159
    m_Localized: 'CultistPriest: Certo... você fez o suficiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812158
    m_Localized: Isso aqui não é creche
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812157
    m_Localized: Me deixa em paz
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812156
    m_Localized: 'CultistPriest: Nós não temos outra escolha a não ser continuar clamando por ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812155
    m_Localized: 'CultistPriest: Mas a Morte... ela pode nos poupar do pior... do vazio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812154
    m_Localized: 'CultistPriest: O renascer parece um tormento interminável com pequenas pausas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812153
    m_Localized: 'CultistPriest: A vida depois da morte é só um conceito prometido pelas religiões.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812152
    m_Localized: 'CultistPriest: Pensar em desaparecer por completo é aterrorizante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812151
    m_Localized: 'CultistPriest: O que importa é: Estamos todos cansados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812150
    m_Localized: 'CultistPriest: Está tudo bem se nós não entendemos por inteiro o que estamos invocando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812149
    m_Localized: 'CultistPriest: Creio que estamos nos aproximando da chegada dela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812148
    m_Localized: Isso aqui não é creche
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812147
    m_Localized: Me deixa em paz
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812146
    m_Localized: 'CultistPriest: Posso saber o motivo da pergunta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812145
    m_Localized: Então, qual é o lance com essa Morte de vocês?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812144
    m_Localized: Leva as suas aberrações com você
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812143
    m_Localized: 'CultistPriest: Boa noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812142
    m_Localized: 'CultistPriest: Sabe, se a morte escolheu você eu vou ajudá-la a olhar mais de perto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812141
    m_Localized: 'CultistPriest: É esse o motivo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812140
    m_Localized: 'CultistPriest: Eles não conseguiram...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812139
    m_Localized: Então, qual é o lance com essa Morte de vocês?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812138
    m_Localized: Leva as suas aberrações com você
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812137
    m_Localized: 'CultistPriest: Então não vou demorar. Vou seguir em frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812136
    m_Localized: 'CultistPriest: Muito bom. É assim que as coisas devem ser. O olhar dela ainda paira em nossas cabeças.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812135
    m_Localized: Cai fora. Eu estou ocupado
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812134
    m_Localized: O seu pessoal está bem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812133
    m_Localized: 'CultistPriest: Você está bem?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812132
    m_Localized: 'CultistPriest: Então, é assim que o mundo acaba. Sem estouro, sem explosões... mas com lágrimas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812131
    m_Localized: 'CultistPriest: A Morte já não conversa mais comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812130
    m_Localized: 'CultistPriest: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812129
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812128
    m_Localized: 'CultistPriest: Você... usurpou a nossa única chance.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812127
    m_Localized: 'CultistPriest: Eles estão mortos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812126
    m_Localized: 'CultistPriest: Espera...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812125
    m_Localized: 'CultistPriest: Eu ainda não sei o que isso significa. Mas não parece tentador?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812124
    m_Localized: 'CultistPriest: Talvez ela te ofereça um lugar para se esconder. De tudo. Mesmo do próprio conceito de "estar morto".'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812123
    m_Localized: 'CultistPriest: A Morte falou comigo a pouco tempo. Ela espera encontrar você quando a hora chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812122
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812121
    m_Localized: 'CultistPriest: Estou certo de que você também está cansado. De todo esse barulho. Esses dias de peso. Essa confusão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812120
    m_Localized: 'CultistPriest: Agradeço pela sua ajuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812119
    m_Localized: Eu não dou a mínima. Já tenho meus problemas para lidar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812118
    m_Localized: É, é, eles estão vivos
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812117
    m_Localized: 'CultistPriest: Vamos direto ao assunto. Como estão os meus?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812116
    m_Localized: 'CultistPriest: Até logo. Eu voltarei para verificar como eles estão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812115
    m_Localized: 'CultistPriest: Eles não precisarão de muito tempo. Mas, ainda assim, fique de olho neles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812114
    m_Localized: 'CultistPriest: Agradeço.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812113
    m_Localized: 'CultistPriest: Geralmente não leva muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812112
    m_Localized: 'CultistPriest: Resumindo, só deixa eles ficarem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812111
    m_Localized: 'CultistPriest: Para onde você vai correr?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812110
    m_Localized: 'CultistPriest: Mesmo se você sobreviver, a sua casa será completamente demolida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812109
    m_Localized: 'CultistPriest: Outros virão. Enquanto você dorme, eles vão encharcar a sua casa de gasolina e acender um fósforo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812108
    m_Localized: 'CultistPriest: Você acha que só existe a gente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812107
    m_Localized: Eu não gosto de ameaças. Mas vou ajudar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812106
    m_Localized: Então eu só vou atirar em cada um de vocês
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812105
    m_Localized: 'CultistPriest: Me perdoe. Mas é a única maneira.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812104
    m_Localized: 'CultistPriest: Então, sim. Devo dizer que, se isso falhar, nós vamos atear fogo na sua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812103
    m_Localized: 'CultistPriest: Mas se for além disso, então nós estamos em perigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812102
    m_Localized: 'CultistPriest: Olhe pelos nossos membros. E lembre-se, se um deles morrer... sua casa será reduzia ao nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812101
    m_Localized: 'CultistPriest: Você também não deseja pela paz? Um mundo onde ninguém é um peso para o outro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812100
    m_Localized: 'CultistPriest: Exato. O caminho para um propósito maior nunca é fácil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812099
    m_Localized: Eu não gosto de ameaças. Mas vou ajudar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812098
    m_Localized: Então eu só vou atirar em cada um de vocês
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812097
    m_Localized: 'CultistPriest: Me perdoe. Mas é a única maneira.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812096
    m_Localized: 'CultistPriest: E então nós atearemos fogo na sua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812095
    m_Localized: 'CultistPriest: Mas se passar disso, nós fracassamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812094
    m_Localized: 'CultistPriest: Olhe pelos nossos membros. E lembre-se, se um deles morrer... sua casa será reduzia ao nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812093
    m_Localized: 'CultistPriest: No fim das contas, talvez você morra pelas chamas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812092
    m_Localized: Parece uma exigência absurda
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812091
    m_Localized: Não é como se eu estivesse morrendo de alegria
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812090
    m_Localized: 'CultistPriest: Eles conduzirão os rituais para os que já partiram. Você só precisa mantê-los seguros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812089
    m_Localized: 'CultistPriest: Mas o meu povo vai. A Morte é atraída por esse lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812088
    m_Localized: 'CultistPriest: Eu não vou entrar. A nossa missão é disseminar a fé que carrega a paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812087
    m_Localized: Parece uma exigência absurda
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812086
    m_Localized: Não é como se eu estivesse morrendo de alegria
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812085
    m_Localized: 'CultistPriest: Eles precisam sobreviver o suficiente até concluírem suas tarefas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812084
    m_Localized: 'CultistPriest: De qualquer forma, rogo para que você deixe o meu povo ficar aqui. Proteja-os.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812083
    m_Localized: 'CultistPriest: O que está acontecendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812082
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812081
    m_Localized: 'CultistPriest: A influência da Morte aqui é forte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812080
    m_Localized: 'CultistPriest: A sua casa é perfeita para isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812079
    m_Localized: 'CultistPriest: Nós precisamos realizar os ritos funerários de uma nova maneira.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812078
    m_Localized: Pretende entrar ou não?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812077
    m_Localized: Então, o que você quer?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812076
    m_Localized: 'CultistPriest: Ela já está bem perto. Nós só estamos facilitando o processo de transpor o limiar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812075
    m_Localized: 'CultistPriest: Nós não acreditamos na salvação. A não ser que ela venha da própria Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812074
    m_Localized: 'CultistPriest: Esse é o meu sudário, para quando morrermos. Não é preciso procurar por farrapos para embrulhar os mortos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812073
    m_Localized: 'CultistPriest: Talvez. Não me incomoda nem um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812072
    m_Localized: Pretende entrar ou não?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812071
    m_Localized: Então, o que você quer?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812070
    m_Localized: 'CultistPriest: É o único caminho para a paz. Em tempos assim, as coisas não voltam mais a ser como eram.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812069
    m_Localized: 'CultistPriest: Nós só estamos acelerando a chegada dela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812068
    m_Localized: 'CultistPriest: A Morte chegou. Ela quer acalmar a humanidade, nos arrancar da prisão do pânico, da amargura e do barulho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812067
    m_Localized: 'CultistPriest: Nós pregamos uma nova fé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812066
    m_Localized: Você parece um fanático de algum culto
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812065
    m_Localized: E quem é mesmo você, vestido desse jeito?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812064
    m_Localized: 'CultistPriest: A Morte se afeiçoou a você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812063
    m_Localized: 'CultistPriest: Aqui, alguns foram queimados e outros executados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812062
    m_Localized: 'CultistPriest: A Morte está em todos os lugares.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812061
    m_Localized: 'CultistPriest: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812060
    m_Localized: 'CultistPriest: Correto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812059
    m_Localized: Você parece um fanático de algum culto
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812058
    m_Localized: E quem é mesmo você, vestido desse jeito?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812057
    m_Localized: 'CultistPriest: Desconheço quantos morreram aqui, mas a presença dela é forte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812056
    m_Localized: 'CultistPriest: A Morte gosta da sua casa. Ela tem muito carinho pelo lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812055
    m_Localized: 'CultistPriest: Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812054
    m_Localized: Essa casa é minha
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812053
    m_Localized: O que você está exatamente sentindo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812052
    m_Localized: 'CultistPriest: Eu posso sentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812051
    m_Localized: 'CultistPriest: Sssiim! A sua casa vai servir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812050
    m_Localized: 'Courier: Toma. {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812041
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812040
    m_Localized: 'Courier: Por que aquele pau no cu pensaria que um humilde entregador é perigoso? Por que tirar a vida dele? Porra, pra quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812039
    m_Localized: 'Courier: As pessoas perderam a porra de suas cabeças.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812038
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812037
    m_Localized: 'Courier: Ele veio deixar um pedido, e o proprietário...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812036
    m_Localized: 'Courier: Meu amigo foi executado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812035
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812034
    m_Localized: O que aconteceu com você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812033
    m_Localized: 'Courier: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812030
    m_Localized: 'Courier: Entrega...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812029
    m_Localized: 'Courier: Tenha uma boa noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812027
    m_Localized: 'Courier: E daí se os meus olhos estão vermelhos por falta de sono? Eles também vão me arrastar pra porra das zonas de quarentena?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812026
    m_Localized: 'Courier: E foi isso. Eles levaram o cara. Agora, eu não sei nem o que rolou com ele. Ou se até mesmo vão o deixar sair em algum momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812025
    m_Localized: 'Courier: Verificação matutina, como sempre. Eles perceberam os olhos dele. Olhos vermelhos, porra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812024
    m_Localized: 'Courier: Meu colega de trabalho foi levado pela FEMA...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812023
    m_Localized: Você parece meio triste
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812021
    m_Localized: 'Courier: Olá... é o entregador.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812020
    m_Localized: 'Courier: Tenha uma boa noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812019
    m_Localized: 'Courier: Pelo menos posso trabalhar, me distrair e não pensar sobre essa maluquice toda...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812018
    m_Localized: 'Courier: Bom, o que mais eu deveria fazer? Ficar em casa e apodrecer, como todo mundo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812017
    m_Localized: 'Courier: Ah, você quis dizer "como é que eu acabei fazendo isso?"'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812016
    m_Localized: 'Courier: Passei pelas verificações, eles conferiram todos os sinais, decidiram que eu sou um humano e...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812015
    m_Localized: Como foi que você virou um entregador?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812013
    m_Localized: 'Courier: Olá, aqui é do serviço de entrega For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812012
    m_Localized: 'Courier: Desculpa, ainda não me acostumei com isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812011
    m_Localized: 'Courier: Tenha um bom dia. Ah! Quis dizer, boa noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812005
    m_Localized: Achei que os serviços de entrega não estavam mais funcionando.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812003
    m_Localized: 'Courier: Olá, aqui é do serviço de entrega For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812002
    m_Localized: 'Intruder: É difícil tocar a vida sem sonhar. É difícil para qualquer um.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812001
    m_Localized: 'Intruder: Espero que sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866812000
    m_Localized: 'Intruder: Você acha que as pessoas vão voltar a sonhar novamente?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811999
    m_Localized: 'Intruder: Mas se outra pessoa nessa casa sonhar, isso também já é alguma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811998
    m_Localized: 'Intruder: Valeu. Vou tentar dormir aqui, embora isso provavelmente não aconteça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811997
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811996
    m_Localized: Pode entrar, eu acho
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811995
    m_Localized: 'Intruder: Talvez se eu tivesse pregado os olhos eu poderia ter visto alguma coisa, também.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811994
    m_Localized: 'Intruder: Eu não durmo fazem seis dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811993
    m_Localized: 'Intruder: Difícil dizer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811992
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811991
    m_Localized: Pode entrar, eu acho
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811990
    m_Localized: 'Intruder: Acho que perderam aquele espaço. Aquele tempo para descansar, para refletir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811989
    m_Localized: 'Intruder: Mas, agora? Elas estão perdidas e despedaçadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811988
    m_Localized: 'Intruder: É onde as pessoas soltam as rédeas e procuram por respostas, encontram conforto e ainda conseguem se acalmar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811987
    m_Localized: 'Intruder: O onírico é... delicado. Coisas estranhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811986
    m_Localized: Você sonha?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811985
    m_Localized: E por que você se importa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811984
    m_Localized: 'Intruder: Eu me pergunto, é o sol? Ou outra coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811983
    m_Localized: 'Intruder: O mesmo com várias pessoas. Até mesmo quando elas estão com febre... nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811982
    m_Localized: 'Intruder: Aí está.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811981
    m_Localized: Você sonha?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811980
    m_Localized: E por que você se importa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811979
    m_Localized: 'Intruder: Você acha que isso acontece por quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811978
    m_Localized: 'Intruder: As pessoas quase já não sonham mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811977
    m_Localized: 'Intruder: Sabe o que eu percebi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811976
    m_Localized: 'Intruder: Eu tô falando de sonhos. Você sabe o que é um sonho. Quando você sonha.... vê alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811975
    m_Localized: Na verdade, não
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811974
    m_Localized: Quê?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811973
    m_Localized: 'Intruder: Você sonha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811972
    m_Localized: 'FormerFema: Tchau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811971
    m_Localized: 'FormerFema: Eu nem sei porque estou tão apegado a ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811970
    m_Localized: 'FormerFema: Acho que esse uniforme é meio amedrontador.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811969
    m_Localized: 'FormerFema: Espera... isso soou errado. É, eu entendi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811968
    m_Localized: 'FormerFema: Hã? Ah, obrigado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811967
    m_Localized: 'FormerFema: Achei que você não ia me deixar entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811966
    m_Localized: 'FormerFema: Posso sentar em algum lugar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811965
    m_Localized: 'FormerFema: Hâ? Pô, valeu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811964
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811963
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811962
    m_Localized: 'FormerFema: Aliás, comecei a programar. Escrevendo códigos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811961
    m_Localized: 'FormerFema: Acabei fazendo nada como o que eles me prometeram.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811960
    m_Localized: 'FormerFema: Aí, veio a decepção.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811959
    m_Localized: 'FormerFema: Eu tinha um emprego. Achei que as coisas fossem ficar bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811958
    m_Localized: 'FormerFema: É uma boa pergunta. Nesse momento eu só me sinto... perdido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811957
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811956
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811955
    m_Localized: 'FormerFema: Eu tive um burnout e pedi demissão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811954
    m_Localized: 'FormerFema: Não sobrou gente o suficiente. A gente não dava conta. E o trabalho só acumulava.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811953
    m_Localized: 'FormerFema: E... eu não trabalho mais lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811952
    m_Localized: 'FormerFema: Montava geladeiras. Consertava, também.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811951
    m_Localized: 'FormerFema: Só um mero operário.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811950
    m_Localized: Qual é o seu plano?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811949
    m_Localized: Então, quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811948
    m_Localized: 'FormerFema: Quem é que sabe de verdade o que acontece lá?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811947
    m_Localized: 'FormerFema: E nunca mais voltam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811946
    m_Localized: 'FormerFema: Por... seja lá qualquer coisa que eles façam. As pessoas são levadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811945
    m_Localized: 'FormerFema: Pelo que eu vi, todo mundo odeia eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811944
    m_Localized: 'FormerFema: Ah! Não, eu não tô com a FEMA. Você pensou isso por conta do uniforme?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811943
    m_Localized: 'FormerFema: Não entendi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811942
    m_Localized: 'FormerFema: Hum?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811941
    m_Localized: Qual é o seu plano?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811940
    m_Localized: Então, quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811939
    m_Localized: 'FormerFema: Talvez o sol reduza a radiação durante a noite? Ou, sei lá. Eu nem quero saber.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811938
    m_Localized: 'FormerFema: Achei que fosse mais seguro assim. Eles usam essa roupa por algum motivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811937
    m_Localized: 'FormerFema: Não é isso, eu só peguei de um corpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811936
    m_Localized: 'FormerFema: Ah... você acha que eu sou um oficial da FEMA pela roupa que tô usando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811935
    m_Localized: 'FormerFema: Levei?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811934
    m_Localized: Dessa vez você veio por mim?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811933
    m_Localized: Primeiro devolva quem você levou
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811932
    m_Localized: 'FormerFema: Você vai... abrir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811931
    m_Localized: 'FormerFema: Escutei uns passos... significa que você veio até a porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811930
    m_Localized: 'FormerFema: Oi? Tem alguém aí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811929
    m_Localized: 'GraveDigger: Não saio nunca mais da casa. Não agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811928
    m_Localized: 'GraveDigger: Ouvi histórias... que se alguém sai de casa e depois volta, já era.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811927
    m_Localized: 'GraveDigger: Então os Visitantes batem na porta... ou pior, eles já estão dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811926
    m_Localized: 'GraveDigger: Você volta para casa e ela está vazia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811925
    m_Localized: 'GraveDigger: Você quebra as costas cavando o dia inteiro e durante a vida inteira, e para qual propósito, hein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811924
    m_Localized: 'GraveDigger: Aiai...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811923
    m_Localized: 'GraveDigger: Só seja rápido com essa porta, tá? Eu tenho medo dos Visitantes me alcançarem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811922
    m_Localized: 'GraveDigger: Valeu, cara!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811921
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811920
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811919
    m_Localized: 'GraveDigger: Enfim, eu tô fora. Que seja cheguei no meu limite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811918
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811917
    m_Localized: 'GraveDigger: Se pelo menos a desgraça cuidasse da gente da forma que a gente se preocupa com ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811916
    m_Localized: 'GraveDigger: O sol queimará os corpos mesmo, e as noite é curta demais para lidar com os mortos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811915
    m_Localized: 'GraveDigger: Ninguém mais traz os corpos. O pessoal parou de se importar com a morte e com as devidas despedidas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811914
    m_Localized: 'GraveDigger: Esse serviço não vale um centavo'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811913
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811912
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811911
    m_Localized: 'GraveDigger: Eu corri pra caralho e nem olhei pra trás. Não me atrevi a voltar pra casa. Estaria mais seguro no meio de uma multidão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811910
    m_Localized: 'GraveDigger: Um Visitante! Rastejando na terra! E aquele cara? Ele só gargalhou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811909
    m_Localized: 'GraveDigger: Pensei que fosse uma pedra, mas não. Do nada aparece uma mão apontando para o céu!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811908
    m_Localized: 'GraveDigger: Eu cavando, cavando, cavando e aí houve um barulho. A pá atingiu alguma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811907
    m_Localized: 'GraveDigger: Ele parado ali, vendo eu com a mão na massa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811906
    m_Localized: 'GraveDigger: Caramba, vi sim. Eu tava cavando uma cova. Uma que um cara pediu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811905
    m_Localized: Você simplesmente se demitiu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152866811904
    m_Localized: Você viu alguma coisa de interessante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617825
    m_Localized: 'GraveDigger: Os corpos ficam largados onde caíram. O sol cozinhará eles de qualquer forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617824
    m_Localized: 'GraveDigger: O pessoal anda caindo que nem mosca ultimamente, mas ninguém tá enterrando ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617823
    m_Localized: 'GraveDigger: Você não viu o que eu vi, cavando aquele último buraco...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617822
    m_Localized: 'GraveDigger: Ei, foi mal sobre a batida na porta. Eu só...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617821
    m_Localized: Você só largou o trabalho?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617820
    m_Localized: Você viu alguma coisa de interessante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617819
    m_Localized: 'GraveDigger: Os túmulos não significam mais nada. As pessoas são enterradas onde caem mortas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617818
    m_Localized: 'GraveDigger: Costumava trabalhar de coveiro, sabe? Não que tenha muito por que ser um agora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617817
    m_Localized: 'GraveDigger: Eu não tô pregando os olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617816
    m_Localized: 'GraveDigger: Ei, sem ressentimentos. Não quis te acordar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617815
    m_Localized: Por que não bate logo com a porra da sua cabeça hein!?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617814
    m_Localized: Não bata na minha porta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617813
    m_Localized: 'GraveDigger: Posso entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617812
    m_Localized: 'GraveDigger: Ei, oi? Tem alguém vivo aqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617811
    m_Localized: 'Marauder: Bom. Então tá certo. Acho que também já vou indo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617810
    m_Localized: 'Marauder: Hã? Você já foi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617809
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617808
    m_Localized: 'Marauder: Só de passagem. Não vou ficar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617807
    m_Localized: 'Marauder: Você não sabe de nenhum lugar vazio por perto, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617806
    m_Localized: 'Marauder: Tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617805
    m_Localized: 'Marauder: Não vão ser um pé no saco, eu prometo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617804
    m_Localized: 'Marauder: Vem conversar comigo outra hora. Eu vou te contar umas histórias, e não são poucas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617803
    m_Localized: 'Marauder: Ah, finalmente! Vou descansar como uma pessoa de verdade, por uma vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617802
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617801
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617800
    m_Localized: 'Marauder: Enfim, se você vai ficar aqui, existe alguma possibilidade de só pernoitar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617799
    m_Localized: 'Marauder: Mas... houve uma vez. Não é uma história curta. Eu te conto mais tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617798
    m_Localized: 'Marauder: Olha, santo eu não sou mas existem limites que eu não desobedeço. Eu não roubo dos vivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617797
    m_Localized: 'Marauder: Ei, o que foi? Você acha que eu sou um ladrão?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617796
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617795
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617794
    m_Localized: 'Marauder: Eu tenho umas histórias para contar. Sobre as coisas que eu vi por aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617793
    m_Localized: 'Marauder: Sem se ofender, beleza? Mas, já que você está aqui, será que poderia me deixar ficar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617792
    m_Localized: 'Marauder: Mas, é... eu ia limpar a sua casa. Pensei que tava vazia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617791
    m_Localized: 'Marauder: Teve um momento onde eu quase parei. Quase.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617790
    m_Localized: 'Marauder: Pego o que consigo, vendo alguns e fico com os que mais me interessam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617789
    m_Localized: 'Marauder: Hum. Não tem pra quê mentir. Eu vasculho lugares abandonados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617788
    m_Localized: Você rouba as pessoas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617787
    m_Localized: Como você sobreviveu sozinho?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617786
    m_Localized: 'Marauder: As coisas estão começando a me afetar demais. Acho que eu vou perder a cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617785
    m_Localized: 'Marauder: Mas quer saber a verdade? Tô cansado disso. Cansado de conversar com as sombras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617784
    m_Localized: 'Marauder: De primeira eu pensei que ficar sozinho era o mais seguro a se fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617783
    m_Localized: 'Marauder: Eu estive por conta própria desde que os Visitantes rastejaram de onde quer que eles tenham vindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617782
    m_Localized: 'Marauder: Por quê não?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617781
    m_Localized: Você rouba as pessoas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617780
    m_Localized: Como foi que você sobreviveu sozinho?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617779
    m_Localized: 'Marauder: Mas, é. Eu não conseguia permanecer em nenhum grupo, então agora eu estou aqui fora, sozinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617778
    m_Localized: 'Marauder: O negócio é, eu já presenciei o que as pessoas são realmente capazes de fazer. E eu não chego nem perto de ser o pior.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617777
    m_Localized: 'Marauder: Como se eu fosse pior que todos eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617776
    m_Localized: 'Marauder: Quem é que vai querer andar comigo, hein? As pessoas acham que eu sou a escória.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617775
    m_Localized: Por quê você acha que isso é uma boa ideia?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617774
    m_Localized: Você tá sozinho por quê?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617773
    m_Localized: 'Marauder: Ei, escuta, hã... você se importa se eu ficar aqui um pouco? Já faz um tempo que tô andando por aí...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617772
    m_Localized: 'Marauder: Embora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617771
    m_Localized: 'Marauder: Ei. Achei que o lugar tava abandonado. Vou me mandar daqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617770
    m_Localized: 'Marauder: Ah, pera... Tem mesmo gente vivendo aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617769
    m_Localized: 'Provocateur: Tenha um magnífico dia...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617768
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617767
    m_Localized: 'Provocateur: E, acredite em mim, isso não acabaria nem um pouco bem para você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617766
    m_Localized: 'Provocateur: É melhor você baixar o tom. Eu poderia ter interpretado isso como uma ameaça ao meu bem estar. Que, a propósito, é regida pelo artigo 119 da Constituição.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617765
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617764
    m_Localized: 'Provocateur: Como é? Você acabou de dizer que eu deveria sair? Isso foi uma ameaça?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617763
    m_Localized: 'Provocateur: Discutiremos as cláusulas do aluguel em mais detalhes mais tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617762
    m_Localized: 'Provocateur: Muito obrigado, proprietário.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617761
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617760
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617759
    m_Localized: 'Provocateur: Ou eu pago ou eu não dou mais um passo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617758
    m_Localized: 'Provocateur: É inapropriado. É ilegal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617757
    m_Localized: 'Provocateur: Eu peço desculpas, mas eu não posso, em sã consciência, me alocar aqui sem pagar o aluguel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617756
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617755
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617754
    m_Localized: 'Provocateur: Certo. Mais tarde nós fazemos isso da maneira correta, um acordo jurídico e dentro da lei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617753
    m_Localized: 'Provocateur: Inacreditável... o proprietário negando dinheiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617752
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617751
    m_Localized: 'Provocateur: Você tá me fazendo um favor, é?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617750
    m_Localized: Eu não preciso do seu dinheiro
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617749
    m_Localized: Olha, você só paga se quiser
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617748
    m_Localized: 'Provocateur: Perdão, mas eu me recuso a ocupar um lote valioso de terra sem pagar a minha parte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617747
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617746
    m_Localized: 'Provocateur: O que você quer dizer com "eu só deixo as pessoas entrarem"? Você é voluntário de alguma ONG? Cuidando de um abrigo para os sem-teto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617745
    m_Localized: Eu não preciso do seu dinheiro
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617744
    m_Localized: Olha, você só paga se quiser
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617743
    m_Localized: 'Provocateur: No entanto, me diz uma coisa, só para ter certeza. Quanto você cobra por noite?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617742
    m_Localized: 'Provocateur: Bom, tá certo. Presumo que fecharemos o contrato mais tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617741
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617740
    m_Localized: 'Provocateur: Isso foi uma resposta meio vaga.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617739
    m_Localized: Eu só deixo as pessoas entrarem
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617738
    m_Localized: Algo assim
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617737
    m_Localized: 'Provocateur: Bom dia, proprietário. Você está alugando esta residência?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617736
    m_Localized: 'TaxiDriver: Tu não é melhor do que aqueles filhos da puta da FEMA. Espero que você apodreça aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617735
    m_Localized: 'TaxiDriver: Porra...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617734
    m_Localized: 'TaxiDriver: Sim, eu entrei em pânico, claro, mas isso não é motivo para me despejar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617733
    m_Localized: 'TaxiDriver: Ei, qual é, cara, não faz isso comigo!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617732
    m_Localized: 'TaxiDriver: Você pisca um olho e eles te capturam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617731
    m_Localized: 'TaxiDriver: Não se esquece: não dê moral pras ideias daqueles escrotos de amarelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617730
    m_Localized: 'TaxiDriver: Pô, valeu, mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617729
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617728
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617727
    m_Localized: 'TaxiDriver: Aí eu dei no pé. Agora não posso nem voltar pra casa. Aposto que aqueles sorrateiros malditos já estão me esperando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617726
    m_Localized: 'TaxiDriver: Eles queriam me levar com todas as coisas que eu tinha trazido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617725
    m_Localized: 'TaxiDriver: Eu nem pensei duas vezes e só levei ele pra FEMA. Um erro grotesco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617724
    m_Localized: 'TaxiDriver: Eu dei uma olhada no retrovisor e vi aqueles dentes, brancos como um holofote.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617723
    m_Localized: 'TaxiDriver: Ele era um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617722
    m_Localized: 'TaxiDriver: Não pensa que eu sou meio paranóico ou coisa assim, mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617721
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617720
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617719
    m_Localized: 'TaxiDriver: Eu espatifei uma garrafa que eu tinha guardada na minha jaqueta, e eu corri.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617718
    m_Localized: 'TaxiDriver: Eu me arrependi na hora, sabe. Assim que eles me arrastaram pra longe do carro, eu percebi que aqueles filhos da puta também estavam atrás de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617717
    m_Localized: 'TaxiDriver: Na hora, eles me deram uma boa moral, tipo, "Ótimo trabalho, você nos trouxe um Visitante". Mas, aí...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617716
    m_Localized: 'TaxiDriver: Aí eu meio que levei ele, sem ele saber, lá pra FEMA. Prenderam o cara assim que pisamos lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617715
    m_Localized: 'TaxiDriver: Aí eu tava levando esse passageiro, sabe, aí eu percebi que os dentes do cara eram brancos pra caramba. Tipo, dente de ator de novela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617714
    m_Localized: 'TaxiDriver: Aqueles filhos da puta da FEMA levaram meu carro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617713
    m_Localized: O que aconteceu com o passageiro?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617712
    m_Localized: O que aconteceu com o seu carro?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617711
    m_Localized: 'TaxiDriver: Não que eu seja idiota de fato. Só confiei no cara errado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617710
    m_Localized: 'TaxiDriver: Perdi ele pela minha própria burrice.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617709
    m_Localized: 'TaxiDriver: É, eu tinha um carro, sabe... mas ela já era.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617708
    m_Localized: O que aconteceu com o passageiro?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617707
    m_Localized: O que aconteceu com o seu carro?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617706
    m_Localized: 'TaxiDriver: Agora eu não tenho nem ele... e nem meu carro, tá ligado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617705
    m_Localized: 'TaxiDriver: Rolou que ele não era quem dizia ser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617704
    m_Localized: 'TaxiDriver: Eu tava na corrida com esse passageiro, aí...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617703
    m_Localized: 'TaxiDriver: Por onde eu começo? Eu sou um taxista, sabe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617702
    m_Localized: Você precisa ajuda com o que?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617701
    m_Localized: O que aconteceu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617700
    m_Localized: 'TaxiDriver: Escuta, tô atolado de merda até o joelho. Posso ficar um pouco aqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617699
    m_Localized: 'TaxiDriver: Ei, cara.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617698
    m_Localized: 'Edgar: Vou encontrar uma sombra em algum lugar. Mas, por favor... não abandone meu corpo quando a hora chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617697
    m_Localized: 'Edgar: Vou aguardar a morte e seu suave abraço virem me buscar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617696
    m_Localized: 'Edgar: Se importa se eu ficar por perto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617695
    m_Localized: 'Edgar: Fique com o meu, quando a hora chegar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617694
    m_Localized: 'Edgar: Eu não sei se você vê a beleza como eu. Mas, me conte... Você não descarta os corpos, certo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617693
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617692
    m_Localized: 'Edgar: Aqui é realmente mais quieto e calmo do que qualquer lugar que já fui antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617691
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617690
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617689
    m_Localized: 'Edgar: Eu quero fazer parte da última beleza do mundo. Gentilmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617688
    m_Localized: 'Edgar: É por isso que eu vim até aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617687
    m_Localized: 'Edgar: Eu não quero isso. Eu sinto que, de certa forma... as pessoas aqui estão prontas para o inevitável.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617686
    m_Localized: 'Edgar: Você acha que isso pode me ajudar com a sepsia?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617685
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617684
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617683
    m_Localized: 'Edgar: Agora eu estou aqui. Na sua frente. Sozinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617682
    m_Localized: 'Edgar: Então, os Visitantes vieram. E, bom... acho que do resto você já sabe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617681
    m_Localized: 'Edgar: Ela mudava... todos os dias. E era a coisa mais linda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617680
    m_Localized: 'Edgar: Certa vez eu morei com uma garota que eu adorava.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617679
    m_Localized: 'Edgar: É uma pergunta justa. Por agora, só posso dizer isso...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617678
    m_Localized: Devemos amputar o seu braço?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617677
    m_Localized: Como foi que você pegou essa gangrena?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617676
    m_Localized: 'Edgar: Eu não pertenço ao pânico da cidade. Todo mundo lá se movimenta contra as correntezas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617675
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617674
    m_Localized: 'Edgar: Uma história como a minha só pode ser bem degustada em uma só "golada".'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617673
    m_Localized: 'Edgar: Todo dia eu penso se vou conseguir sobreviver para ver o próximo dia nascer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617672
    m_Localized: 'Edgar: É claro, eu vou sentir calafrio de qualquer jeito. É a putrefação.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617671
    m_Localized: 'Edgar: Você sabia que as ruas não ficam mais frias? Nem mesmo durante a noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617670
    m_Localized: 'Edgar: Sinto calafrios até mesmo no calor da cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617669
    m_Localized: 'Edgar: O silêncio... o vazio. Aqui tudo é estável.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617668
    m_Localized: Devemos amputar o braço?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617667
    m_Localized: Como foi que você pegou essa gangrena?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617666
    m_Localized: 'Edgar: Eu adoraria morrer aqui. Lentamente. Silenciosamente. Para saborear o momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617665
    m_Localized: 'Edgar: O homem busca uma chance de sobreviver a todo custo. Mas, aqui fora... você faz as pazes com o que está por vir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617664
    m_Localized: 'Edgar: O barulho da cidade gruda em mim como o suor de uma tarde ensolarada. A loucura, a correria de todo dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617663
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617662
    m_Localized: 'Edgar: Uma história como a minha só pode ser bem degustada em uma só "golada".'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617661
    m_Localized: 'Edgar: Todo dia eu penso se vou conseguir sobreviver para ver o próximo dia raiar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617660
    m_Localized: 'Edgar: Me sinto realmente mal. E eu não estou falando só da gangrena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617659
    m_Localized: O que tem de bonito nesse lugar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617658
    m_Localized: Você não ficou em casa por quê?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617657
    m_Localized: "Edgar: Pensei em abusar um pouco da sua gentileza.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617656
    m_Localized: 'Edgar: Aqui tudo é bem mais quieto. Na cidade, tudo é uma gritaria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617655
    m_Localized: 'Edgar: Oi. Vejo que você tem uma bela casa aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617654
    m_Localized: 'Foreigner: (Um segundo se passa, ele dá as costas, e vai embora)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617653
    m_Localized: 'Foreigner: (O seu grito assusta ele)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617652
    m_Localized: 'Foreigner: Só sai logo daqui!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617651
    m_Localized: 'Foreigner: (Ele continua parado, murmurando)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617650
    m_Localized: 'Foreigner: (Ele acena e entra na casa)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617649
    m_Localized: Vá embora
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617648
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617647
    m_Localized: 'Foreigner: (Você não tem certeza, mas parece que as bochechas estão molhadas por lágrimas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617646
    m_Localized: 'Foreigner: (Ele só ficou parado ali, encarando pelo olho mágico)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617645
    m_Localized: Vá embora
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617644
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617643
    m_Localized: 'Foreigner: (Você não tem certeza, mas parece que as bochechas estão molhadas por lágrimas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617642
    m_Localized: 'Foreigner: (Ele murmura alguma coisa, balançando os braços)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617641
    m_Localized: Então, o que eu devo fazer com você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617640
    m_Localized: Você teve a boca costurada?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617639
    m_Localized: "Foreigner: (Ele murmura novamente, mas você não entende nada)\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617638
    m_Localized: 'Foreigner: (Ele arqueia as sobrancelhas, angustiado)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617637
    m_Localized: Então, o que eu devo fazer com você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617636
    m_Localized: Você teve a boca costurada?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617635
    m_Localized: 'Foreigner: (Parece que ele não consegue responder)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617634
    m_Localized: 'Foreigner: (A pessoa olha para você com as sobrancelhas levantadas)'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617633
    m_Localized: Que?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617632
    m_Localized: Qual é o seu problema?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617631
    m_Localized: 'Foreigner: Mmmmmmmmmmf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617630
    m_Localized: 'Foreigner: Mmmmf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617629
    m_Localized: 'Doctor: Se eu tiver sorte, estarei por perto. Não hesite em pedir ajuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617628
    m_Localized: 'Doctor: Eu entendo, não é a melhor hora para se confiar em alguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617627
    m_Localized: 'Doctor: Agradeço. Espero conseguir ajudar alguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617626
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617625
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617624
    m_Localized: 'Doctor: Se você me deixar entrar eu te conto o que aconteceu com os hospitais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617623
    m_Localized: 'Doctor: É uma história demorada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617622
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617621
    m_Localized: 'Doctor: Tinha um hospital lá no centro. Mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668865
    m_Localized: 'Doctor: Se você me deixar entrar, eu posso falar o que aconteceu com os hospitais.'
    m_Metadata:
      m_Items: []
  - m_Id: 43881077125668864
    m_Localized: 'Doctor: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617620
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617619
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617618
    m_Localized: 'Doctor: E então... Os hospitais se foram. E eu só perambulo por aí, ajudando onde posso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617617
    m_Localized: 'Doctor: Nosso hospital estava sempre com a verba curta, então eu acabei fazendo muito mais do que estava no meu contrato.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617616
    m_Localized: 'Doctor: Um cirurgião. Eu operava pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617614
    m_Localized: De onde é que você veio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617613
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617612
    m_Localized: 'Doctor: Então eu pensei: "Vou lá ver". Mas, a porta estava trancada e eu decidi bater, antes de quebrá-la.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617611
    m_Localized: 'Doctor: E com todo esse silêncio... achei de verdade que ninguém vivia aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617610
    m_Localized: 'Doctor: Segurança... e algo para distrair a cabeça do tédio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617609
    m_Localized: 'Doctor: Bem, eu estou procurando, sim, mas pelas mesmas coisas que as outras pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617608
    m_Localized: 'Doctor: Por que a pergunta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617607
    m_Localized: De onde é que você veio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617606
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617605
    m_Localized: 'Doctor: Ou um indivíduo chorando por uma mágoa que a própria alma não consegue sustentar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617604
    m_Localized: 'Doctor: Ou alguém gritando de dor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617603
    m_Localized: 'Doctor: Geralmente tem alguém gritando com uma voz embriagada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617602
    m_Localized: 'Doctor: É difícil ver uma casa tão cheia ficar tão quieta durante a noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617601
    m_Localized: 'Doctor: Como é? Haha, não, é claro que não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152862617600
    m_Localized: Você está procurando alguma coisa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423454
    m_Localized: Você estava observando a casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423453
    m_Localized: 'Doctor: Boa noite! Posso entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423452
    m_Localized: 'Doctor: Aqui é tão silencioso durante a noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423451
    m_Localized: 'Doctor: Ah, achei que não tinha ninguém em casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423450
    m_Localized: 'Wolfhound: Pode esperar notícias minhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423449
    m_Localized: 'Wolfhound: Aaaah... tô vendo como vai ser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423448
    m_Localized: 'Wolfhound: Agora é a força que manda aqui. Ou você se une a ela ou ela se vira contra você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423447
    m_Localized: 'Wolfhound: Uma escolha inteligente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423446
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423445
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423444
    m_Localized: 'Wolfhound: O ponto é, eu não estou aqui para causar problemas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423443
    m_Localized: 'Wolfhound: Eu não pergunto como você escolhe viver, então também não me questione.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423442
    m_Localized: 'Wolfhound: Aquilo que você não conhece não pode te afetar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423441
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423440
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423439
    m_Localized: 'Wolfhound: Você? Você ainda mantém as coisas em ordem por aqui. Isso é difícil de se ver. Estou curioso para saber como você faz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423438
    m_Localized: 'Wolfhound: Mas eu vi o mesmo caos em todo lugar. O medo cega as pessoas para o que realmente está acontecendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423437
    m_Localized: 'Wolfhound: Eu nunca fiquei em um lugar por muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423436
    m_Localized: Como você sobreviveu por tanto tempo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423435
    m_Localized: Quantos lugares você já visitou?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423434
    m_Localized: 'Wolfhound: E qualquer um que se oponha a isso morrerá ao amanhecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423433
    m_Localized: 'Wolfhound: Essa é a nova ordem: Os mais fortes decidem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423432
    m_Localized: 'Wolfhound: Continue negando isso e eles vão devorar você vivo. Não vai restar nem a ossada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423431
    m_Localized: 'Wolfhound: Nós todos somos animais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423430
    m_Localized: Como você sobreviveu por tanto tempo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423429
    m_Localized: Quantos lugares você já visitou?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423428
    m_Localized: 'Wolfhound: Agora, é tudo simples. Se você consegue rasgar a garganta de alguém, você ganha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423427
    m_Localized: 'Wolfhound: Todas as suas regras e a sua moral não existem, elas não funcionam mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423426
    m_Localized: 'Wolfhound: Você já foi em outras casas? Já caminhou pelas ruas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423425
    m_Localized: Você é uma dessas feras?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423424
    m_Localized: Do que você está falando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423423
    m_Localized: 'Wolfhound: Finalmente... chega de fingir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423422
    m_Localized: 'Wolfhound: Isso já não é mais uma sociedade. As feras já estão soltas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423421
    m_Localized: 'Wolfhound: O mundo já era, hein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423420
    m_Localized: 'Wolfhound: Ei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423419
    m_Localized: 'SuperFake: Então por que resistir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423418
    m_Localized: 'SuperFake: EU SEI que logo tudo vai ser decidido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423417
    m_Localized: 'SuperFake: O que você vai fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423416
    m_Localized: 'SuperFake: Por quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423415
    m_Localized: 'SuperFake: Fugindo, sempre fugindo. Do meu povo, da minha verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423414
    m_Localized: 'SuperFake: É por isso que estou aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423413
    m_Localized: 'SuperFake: Ainda não consegue lidar com as coisas por si só.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423412
    m_Localized: 'SuperFake: Siiiiim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423411
    m_Localized: 'SuperFake: Você sente medo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423410
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423409
    m_Localized: 'SuperFake: Então você está preparado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423408
    m_Localized: Eu me livrei de alguns
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423407
    m_Localized: Eu me livro de todos os extras
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423406
    m_Localized: Eu só deixo entrar os verdadeiros
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423405
    m_Localized: Tem vários "não humanos" aqui
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423404
    m_Localized: Eu não deixei ninguém entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423403
    m_Localized: Tem muita gente aqui
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423402
    m_Localized: 'SuperFake: Tem alguém do meu pessoal na sua casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423401
    m_Localized: 'SuperFake: Mas quero saber mesmo é de outra coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423400
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423399
    m_Localized: 'SuperFake: Você vai sentir alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423398
    m_Localized: 'SuperFake: Só sumiu? Pra sempre?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423397
    m_Localized: 'SuperFake: Você morre. E aí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423396
    m_Localized: 'SuperFake: Parece que você se preocupa mais com o que vem depois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423395
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423394
    m_Localized: 'SuperFake: Você costuma pensar porque você ainda está vivo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423393
    m_Localized: 'SuperFake: O desconhecido te dá medo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423392
    m_Localized: Eu me livrei de alguns
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423391
    m_Localized: Eu me livro de todos os extras
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423390
    m_Localized: Eu só deixo entrar os verdadeiros
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423389
    m_Localized: Tem vários "não humanos" aqui
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423388
    m_Localized: Eu não deixei ninguém entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423387
    m_Localized: Tem muita gente aqui
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423386
    m_Localized: 'SuperFake: Você está sozinho em casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423385
    m_Localized: 'SuperFake: Você deixou o meu pessoal entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423384
    m_Localized: 'SuperFake: Por agora...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423383
    m_Localized: 'SuperFake: Mas você vai desaparecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423382
    m_Localized: 'SuperFake: Não vai ser hoje e nem amanhã. Nem depois de amanhã, e nem mais tarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423381
    m_Localized: 'SuperFake: Você vai morrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423380
    m_Localized: 'SuperFake: Mas os resultados são os mesmos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423379
    m_Localized: 'SuperFake: Para mudar alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423378
    m_Localized: 'SuperFake: Eles me enviaram por um motivo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423377
    m_Localized: 'SuperFake: Já parou pra pensar que foi escolhido por algum motivo? Ha ha ha ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423376
    m_Localized: 'SuperFake: Você pergunta isso só agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423375
    m_Localized: Por que você só não derruba a porta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423374
    m_Localized: Por que você veio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423373
    m_Localized: 'SuperFake: Não se preocupe, nós vamos ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423372
    m_Localized: 'SuperFake: Engraçado como *você* não sente nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423371
    m_Localized: 'SuperFake: Não posso dizer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423370
    m_Localized: Por que você só não derruba a porta?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423369
    m_Localized: Por que você veio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423368
    m_Localized: 'SuperFake: Já tá cheirando o teu cangote.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423367
    m_Localized: 'SuperFake: Mas você sente? A morte chegando mais perto, e mais perto?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423366
    m_Localized: 'SuperFake: Isso é tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423365
    m_Localized: 'SuperFake: Eu só tô replicando o que me foi dito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423364
    m_Localized: Que fim?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423363
    m_Localized: O que você quer dizer com isso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423362
    m_Localized: 'SuperFake: Se não for a gente, você carregará o fardo e terminará o que começamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423361
    m_Localized: 'SuperFake: Isso tudo vai chegar ao fim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423360
    m_Localized: 'SuperFake: Eles me disseram que essa seria a nossa última conversa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423359
    m_Localized: 'SuperFake: Até a próxima?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423358
    m_Localized: 'SuperFake: Bom, então...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423357
    m_Localized: 'SuperFake: Eu só sigo ordens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423356
    m_Localized: 'SuperFake: Existem poderes maiores que eu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423355
    m_Localized: 'SuperFake: Você não tá achando que eu sou o encarregado de tudo, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423354
    m_Localized: 'SuperFake: A mudança não é o pior que vai te acontecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423353
    m_Localized: 'SuperFake: Agora até mesmo o meu pessoal é raro. Imagine o seu, todos trancafiados em casas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423352
    m_Localized: 'SuperFake: Ora, ora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423351
    m_Localized: 'SuperFake: Venha comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423350
    m_Localized: 'SuperFake: Olha só, a regra funcionou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423349
    m_Localized: 'SuperFake: Humm...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423348
    m_Localized: Não estou só
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423347
    m_Localized: Estou só
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423346
    m_Localized: 'SuperFake: Você está sozinho em casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423345
    m_Localized: 'SuperFake: Mas antes de ir, vamos testar a nossa nova regra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423344
    m_Localized: 'SuperFake: É claro! Já estou de saída.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423343
    m_Localized: Não estou só
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423342
    m_Localized: Estou só
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423341
    m_Localized: 'SuperFake: Você está sozinho em casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423340
    m_Localized: 'SuperFake: Mas, primeiro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423339
    m_Localized: 'SuperFake: Vamos tentar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423338
    m_Localized: 'SuperFake: É simples.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423337
    m_Localized: Você pode voltar depois?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423336
    m_Localized: Eu não entendo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423335
    m_Localized: 'SuperFake: Você abrirá a porta para mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423334
    m_Localized: 'SuperFake: Se você tiver pelo menos dois dos meus dentro da sua casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423333
    m_Localized: 'SuperFake: Vamos dar um jeito nisso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423332
    m_Localized: 'SuperFake: Como se você não se preocupasse nem com você mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423331
    m_Localized: 'SuperFake: Desapegado, hein?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423330
    m_Localized: Você pode voltar depois?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423329
    m_Localized: Eu não entendo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423328
    m_Localized: 'SuperFake: Pois agora os corpos pertencem aos cães.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423327
    m_Localized: 'SuperFake: Você abrirá a porta para mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423326
    m_Localized: 'SuperFake: Se você tiver pelo menos dois dos meus dentro da sua casa...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423325
    m_Localized: 'SuperFake: Vamos tentar umas regras novas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423324
    m_Localized: 'SuperFake: Parece que você precisa de ajuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423323
    m_Localized: 'SuperFake: Deve ser difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423322
    m_Localized: Eu não me importo
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423321
    m_Localized: Eu não sinto nada
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423320
    m_Localized: 'SuperFake: Coisas estranhas rodeiam você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423319
    m_Localized: 'SuperFake: Você sabe de quem eu falo, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423318
    m_Localized: 'SuperFake: Tudo por conta de uma palavra. Uma só palavra... mas bote palavra nisso!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423317
    m_Localized: 'SuperFake: E uma pessoa em específico... parou de morrer por ela.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423316
    m_Localized: 'SuperFake: Assim como eu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423315
    m_Localized: 'SuperFake: A mudança está perseguindo você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423314
    m_Localized: 'SuperFake: Você sentiu isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423313
    m_Localized: 'SuperFake: A próxima vez que nos encontrarmos vai ser... mais interessante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423312
    m_Localized: 'SuperFake: Você tá fora da batida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423311
    m_Localized: 'SuperFake: A vida mudou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423310
    m_Localized: 'SuperFake: Você não entende, né? As coisas não vão voltar a ser as mesmas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423309
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423308
    m_Localized: 'SuperFake: O mundo é dos cachorros agora, só vão sobrar eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423307
    m_Localized: 'SuperFake: Por quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423306
    m_Localized: 'SuperFake: Ainda tentando dar um jeito na sua vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423305
    m_Localized: 'SuperFake: Eu só vou abrir a porta e deixar uma coisinha pra você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423304
    m_Localized: 'SuperFake: Não deu certo com ninguém, foi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423303
    m_Localized: 'SuperFake: Então você está só.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423302
    m_Localized: Não estou só
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423301
    m_Localized: Estou só
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423300
    m_Localized: 'SuperFake: Você está sozinho em casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423299
    m_Localized: 'SuperFake: Escuuuuta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423298
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423297
    m_Localized: 'SuperFake: A única coisa que você consegue parar é o batimento cardíaco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152858423296
    m_Localized: 'SuperFake: Parar os alagamentos, os incêndios e o declínio?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229051
    m_Localized: 'SuperFake: Você pode impedir a morte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229050
    m_Localized: 'SuperFake: E o que você pode fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229049
    m_Localized: Não estou só
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229048
    m_Localized: Estou só
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229047
    m_Localized: 'SuperFake: Você está sozinho em casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229046
    m_Localized: 'SuperFake: Escuuuuta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229045
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229044
    m_Localized: 'SuperFake: Sobre a morte?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229043
    m_Localized: 'SuperFake: Sobre a calamidade cósmica?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229042
    m_Localized: 'SuperFake: Mas o que você pode fazer sobre os desastres naturais?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229041
    m_Localized: 'SuperFake: Disso eu sei bem!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229040
    m_Localized: Estou fazendo o que posso
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229039
    m_Localized: Eu não consigo fazer nada
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229038
    m_Localized: 'SuperFake: Ou você quer resolver tudo sozinho?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229037
    m_Localized: 'SuperFake: Uma bênção, não acha?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229036
    m_Localized: 'SuperFake: Já foi tudo decidido sem o nosso consentimento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229035
    m_Localized: 'SuperFake: Não se incomode em elaborar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229034
    m_Localized: Estou fazendo o que posso
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229033
    m_Localized: Eu não consigo fazer nada
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229032
    m_Localized: 'SuperFake: Ou talvez a questão seja a gente resolver as coisas com as próprias mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229031
    m_Localized: 'SuperFake: Talvez esses aí instaurem alguma ordem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229030
    m_Localized: 'SuperFake: Uma coisa aqui, outra ali, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229029
    m_Localized: 'SuperFake: Os tempos estão difíceis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229028
    m_Localized: Eu não sei o que pensar sobre ele
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229027
    m_Localized: Ele está trabalhando
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229026
    m_Localized: 'SuperFake: O que você acha daquele ali, de farda?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229025
    m_Localized: 'SuperFake: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229024
    m_Localized: 'SuperFake: Você ainda tá enfiado nessa casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229023
    m_Localized: 'Greatmother: Vou trazer a minha gente até aqui. A gente te ajuda a sobreviver, hahahah!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229022
    m_Localized: 'Greatmother: HAHAHAHAHAH!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229021
    m_Localized: 'Greatmother: Na verdade, não abra a porta de jeito nenhum.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229020
    m_Localized: 'Greatmother: Só... não abra a porta para os fardados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229019
    m_Localized: 'Greatmother: Quando você menos perceber eles vão estar nos arrastando pra algum lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229018
    m_Localized: 'Greatmother: Hahaha, que gentil. Não vai abrir a porta pros de farda amarela, tá?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229017
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229016
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229015
    m_Localized: 'Greatmother: Então, agora tudo se resume a sobreviver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229014
    m_Localized: 'Greatmother: Acho que metade do pessoal foi levado. Eles nem perseguiram tanto assim quem restou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229013
    m_Localized: 'Greatmother: Teve gente que não saiu por conta própria, os fardados só os arrancaram de lá, como se tivessem escolhendo no aleatório.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229012
    m_Localized: 'Greatmother: Tô te dizendo, foi a porra do prédio inteiro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229011
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229010
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229009
    m_Localized: 'Greatmother: Deixaram outros livres, como se nada tivesse acontecendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229008
    m_Localized: 'Greatmother: Os de farda amarela entraram de uma vez e expulsaram o pessoal. Também pegaram alguns para pesquisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229007
    m_Localized: 'Greatmother: Disseram que nosso prédio levou uma onda solar ou coisa do tipo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229006
    m_Localized: Tinham mais pessoas com você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229005
    m_Localized: Você foi despejada por quê?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229004
    m_Localized: 'Greatmother: Tive correndo desde então, procurando um lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229003
    m_Localized: 'Greatmother: O bloco inteiro foi evacuado e ninguém sabe pra onde ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229002
    m_Localized: 'Greatmother: Não tô procurando ninguém. Só preciso de um lugar para ficar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229001
    m_Localized: Tinham mais pessoas com você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854229000
    m_Localized: Você foi despejada por quê?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228999
    m_Localized: 'Greatmother: O pessoal correu pra tudo que é lado. Eu vim até aqui para tentar sobreviver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228998
    m_Localized: 'Greatmother: Sem abrigo, sem ajuda. Pra onde é que a gente ia? O que a gente devia fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228997
    m_Localized: 'Greatmother: Os fardados de amarelo nos chutaram do prédio, mas nunca nos deram um lugar para ficar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228996
    m_Localized: 'Greatmother: Eu morava só a uns quarteirões daqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228995
    m_Localized: Você está procurando alguém?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228994
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228993
    m_Localized: 'Greatmother: Tem alguém em casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152854228992
    m_Localized: 'Greatmother: Olááá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034796
    m_Localized: 'Cold: Entendi, as balas são para você. Tchau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034795
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034794
    m_Localized: 'Cold: Você poderia atirar em mim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034793
    m_Localized: 'Cold: Você tem muitas manchas de pólvora nas suas mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034792
    m_Localized: 'Cold: Tudo bem, até logo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034791
    m_Localized: 'Cold: Eu entendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034790
    m_Localized: 'Cold: O teto é meio baixo, mas tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034789
    m_Localized: 'Cold: Eu agradeço.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034788
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034787
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034786
    m_Localized: 'Cold: Eu vou sair. Não vou implorar e nem incomodar você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034785
    m_Localized: 'Cold: Você não precisa me deixar entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034784
    m_Localized: 'Cold: Não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034783
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034782
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034781
    m_Localized: 'Cold: E se piorar? E eu ainda não conseguir morrer por isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034780
    m_Localized: 'Cold: Estou com medo de tirar as roupas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034779
    m_Localized: 'Cold: Os outros queimam no sol. Eu me embrulho de várias cobertas e ainda sinto frio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034778
    m_Localized: 'Cold: Eu estou sempre com frio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034777
    m_Localized: Tira a jaqueta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034776
    m_Localized: O calor não incomoda você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034775
    m_Localized: 'Cold: Então, a um tempo atrás...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034774
    m_Localized: 'Cold: Eu nunca tive isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034773
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034772
    m_Localized: Tira a jaqueta
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034771
    m_Localized: O calor não incomoda você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034770
    m_Localized: 'Cold: Mais tarde. Ainda não sei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034769
    m_Localized: 'Cold: Não sou. Mas tenho um pedido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034768
    m_Localized: 'Cold: Não importa mais. Está se perguntando se sou um Visitante, não é?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034767
    m_Localized: Por quanto tempo você esteve procurando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034766
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034765
    m_Localized: 'Cold: Eu posso encontrar a paz aqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034764
    m_Localized: 'Cold: O calor não me incomoda mas, ainda assim, estou procurando por algum lugar com silêncio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034763
    m_Localized: 'Cold: Oi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034762
    m_Localized: 'Hunter: Mas, eu juro, eu vou punir cada um deles. Você vai ver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034761
    m_Localized: 'Hunter: Rasgaria minha garganta ao amanhecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034760
    m_Localized: 'Hunter: É o melhor a se fazer. Talvez você mesmo seja um deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034759
    m_Localized: 'Hunter: A gente vai deitar cada um deles. Não vão chegar nem perto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034758
    m_Localized: 'Hunter: Sabia que você não era molenga. Você tem colhão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034757
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034756
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034755
    m_Localized: 'Hunter: Não resta nada de humano neles além da pele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034754
    m_Localized: 'Hunter: Eu corri. Eles atiraram. É esse o conceito de diversão deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034753
    m_Localized: 'Hunter: Eles esperaram fora da minha cabana até eu dormir. Roubaram enquanto eu estava dormindo, simples assim!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034752
    m_Localized: 'Hunter: Eu tinha um rifle. Quase me custou a vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034751
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034750
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034749
    m_Localized: 'Hunter: Tem que ter cuidado com eles, isso sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034748
    m_Localized: 'Hunter: Você deixa um escapar e amanhã eles voltam para rasgar a sua garganta. Entendeu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034747
    m_Localized: 'Hunter: Ou você só tá espantando eles? Você não me parece ser burro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034746
    m_Localized: 'Hunter: Você não está fazendo a mesma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034745
    m_Localized: Então onde é que está a sua arma?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034744
    m_Localized: Você quer caçar os Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034743
    m_Localized: 'Hunter: Tô te dizendo, eles pretendem fazer alguma coisa e precisam ser abatidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034742
    m_Localized: 'Hunter: Desde aquela porra que aconteceu com o sol eles tem saído mais, espreitando por aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034741
    m_Localized: 'Hunter: Onde, na cidade? Eu só vim descansar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034740
    m_Localized: Então onde é que está a sua arma?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034739
    m_Localized: Você quer caçar os Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034738
    m_Localized: 'Hunter: Precisam ser aniquilados. Cada um deles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034737
    m_Localized: 'Hunter: Eles fingem ser a gente e aí já era...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034736
    m_Localized: 'Hunter: E é uma, duas, três casas com alguém morto ou estraçalhado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034735
    m_Localized: 'Hunter: Viu o que os Visitantes estão fazendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034734
    m_Localized: O que você está procurando aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034733
    m_Localized: Por que você está viajando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034732
    m_Localized: 'Hunter: Os tempos de andarilho já eram. A idade não perdoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034731
    m_Localized: 'Hunter: Não sou daqui. Nunca fui de ficar em um lugar por muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034730
    m_Localized: 'Hunter: Opa. Como é que estão as coisas por aqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034729
    m_Localized: 'Prophet: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034728
    m_Localized: 'Prophet: Perdão. Acho que já vou indo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034727
    m_Localized: 'Prophet: Eu não tenho forças para continuar lendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034726
    m_Localized: 'Prophet: Nossos jovens gritaram como o fogo que consumiu a Catedral de Ruão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034725
    m_Localized: 'Prophet: Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034724
    m_Localized: 'Prophet: Obrigado. Mas não ajudou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034723
    m_Localized: 'Prophet: Que pena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034722
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034721
    m_Localized: 'Prophet: Alguém canta entre os dois mundos. Fogo, venha comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034720
    m_Localized: 'Prophet: Vou indo agora. Tchau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034719
    m_Localized: 'Prophet: Eu lembrei de uma coisa. Obrigado'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034718
    m_Localized: 'Prophet: Ah. Então é isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034717
    m_Localized: 'Prophet: O nosso trem já não vai mais para qualquer lugar mas, ainda assim, o trilho continua a seguir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034716
    m_Localized: Décima página?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034715
    m_Localized: Meio da página duzentos.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034714
    m_Localized: Diante do fim.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034713
    m_Localized: 'Prophet: Eu estou assustado. Talvez você consiga ajudar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034712
    m_Localized: 'Prophet: Lembra quando você leu minha mão usando o livro? Quer fazer isso outra vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034711
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034710
    m_Localized: 'Prophet: É para você?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034709
    m_Localized: 'Prophet: E eu também lembro da palavra "pular". Isso significa alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034708
    m_Localized: 'Prophet: Mas eu entendia. Disso eu lembro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034707
    m_Localized: 'Prophet: Pergunta estranha. Eu não entendo mais isso tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034706
    m_Localized: Décima página?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034705
    m_Localized: Meio da página duzentos.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034704
    m_Localized: Até a hora do fim.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034703
    m_Localized: 'Prophet: Talvez ajude.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034702
    m_Localized: 'Prophet: Lê minha mão mais uma vez, pode ser?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034701
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034700
    m_Localized: 'Prophet: Eu me perdi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034699
    m_Localized: 'Prophet: Eu não sei se é para mim... ou para você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034698
    m_Localized: 'Prophet: Só existe um pensamento, que fica repetindo: Pula.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034697
    m_Localized: 'Prophet: Eu... eu já nem lembro mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034696
    m_Localized: Você está morrendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034695
    m_Localized: De quem você está falando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034694
    m_Localized: 'Prophet: Então por que você começou isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034693
    m_Localized: 'Prophet: E agora? Ela só vai tirar tudo de mim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034692
    m_Localized: 'Prophet: Ela me fazia continuar seguindo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034691
    m_Localized: Você está morrendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034690
    m_Localized: De quem você está falando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034689
    m_Localized: 'Prophet: Pare de brincar comigo. Só me deixe em paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152850034688
    m_Localized: 'Prophet: Agora eu entendo... que já passou da hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840573
    m_Localized: 'Prophet: Os pensamentos, eles se aquietaram.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840572
    m_Localized: 'Prophet: Tarde demais para aquele desejo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840571
    m_Localized: Você parece estar bem... mal
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840570
    m_Localized: Só não morre na varanda
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840569
    m_Localized: 'Prophet: Ela me deixou?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840568
    m_Localized: 'Prophet: Minha visão está indo embora. Eu mal consigo ver você agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840567
    m_Localized: 'Prophet: Eu esqueci do seu rosto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840566
    m_Localized: 'Prophet: Preciso ficar a sós com meus pensamentos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840565
    m_Localized: 'Prophet: Quando você encontrar o que está lá embaixo... não pule. Não vai ajudar você agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840564
    m_Localized: 'Prophet: E você...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840563
    m_Localized: 'Prophet: Precisava ser feito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840562
    m_Localized: 'Prophet: Eu... eu lembro... era a coisa certa a se fazer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840561
    m_Localized: 'Prophet: Devo descansar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840560
    m_Localized: 'Prophet: Quando você encontrar... não pule, ainda...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840559
    m_Localized: 'Prophet: No entanto... eu lembrei de uma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840558
    m_Localized: 'Prophet: Foi mal. Não consigo pensar com clareza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840557
    m_Localized: Você tem certeza?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840556
    m_Localized: E eu preciso por quê?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840555
    m_Localized: 'Prophet: E você está destinado a encontrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840554
    m_Localized: 'Prophet: Você precisa cavar. Tem alguma coisa enterrada lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840553
    m_Localized: 'Prophet: Eu lembrei do que vinha depois. O porão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840552
    m_Localized: 'Prophet: Agora... está tudo cheio de névoa. Eu vejo você, perdido em uma floresta escura. Cercado criaturas bestiais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840551
    m_Localized: 'Prophet: Mas eu sabia que havia uma motivo. Eu lembrei claramente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840550
    m_Localized: 'Prophet: Foi mal. Eu sei que digo umas coisas estranhas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840549
    m_Localized: Você tem certeza?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840548
    m_Localized: E eu preciso por quê?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840547
    m_Localized: 'Prophet: Eu consigo enxergar o que está embaixo da terra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840546
    m_Localized: 'Prophet: Tenta cavar. Tem alguma coisa lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840545
    m_Localized: 'Prophet: O porão. Você tem um, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840544
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840543
    m_Localized: 'Prophet: Antes de vir até você tudo estava claro. Agora... é como se fosse só névoa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840542
    m_Localized: 'Prophet: É. Foi mal se te assustei. Tô pensando em voz alta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840541
    m_Localized: Estou começando a me arrepender de ter confiado em você
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840540
    m_Localized: Eu não entendo você quer dizer
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840539
    m_Localized: 'Prophet: Mas deu alguma coisa de errado. Talvez tenha sido aquele homem com os cogumelos...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840538
    m_Localized: 'Prophet: Ela pode vir ajudar, se pedir da maneira correta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840537
    m_Localized: 'Prophet: Mas não precisa ter medo. A gente só não tem conhecimento o suficiente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840536
    m_Localized: 'Prophet: Existe uma entidade mais forte que nós, sabe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840535
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840534
    m_Localized: 'Prophet: Não. Definitivamente não.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840533
    m_Localized: Estou começando a me arrepender de ter confiado em você
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840532
    m_Localized: Eu não entendo você quer dizer
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840531
    m_Localized: 'Prophet: Novos caules surgirão das cinzas e alcançarão os céus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840530
    m_Localized: 'Prophet: Isso aconteceu uma vez, bem no começo. Vai ficar tudo bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840529
    m_Localized: 'Prophet: Não acho que seja você. Ou ela...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840528
    m_Localized: 'Prophet: Me sinto mais fraco. O alcance da minha visão não é o mesmo de antes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840527
    m_Localized: 'Prophet: Eu já estou sendo ajudado. Só...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840526
    m_Localized: Você está falando sozinho?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840525
    m_Localized: Ei, você precisa de uma ajuda?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840524
    m_Localized: 'Prophet: Será que é por conta da destruição?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840523
    m_Localized: 'Prophet: Estou me sentindo mal... me sentindo estranho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840522
    m_Localized: 'Prophet: Você tá aí, né? Na porta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840521
    m_Localized: 'Prophet: Espero te ver daqui uns dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840520
    m_Localized: 'Prophet: Agora o sentimento diminuiu. Acho que estamos fazendo a coisa certa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840519
    m_Localized: 'Prophet: Quando vim aqui pela primeira vez eu senti uma coisa... bem estranha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840518
    m_Localized: 'Prophet: Seria melhor você não verificar ninguém. Por dois dias seguidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840517
    m_Localized: 'Prophet: Você pode encarar como um pedido, mas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840516
    m_Localized: 'Prophet: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840515
    m_Localized: 'Prophet: Não posso dizer mais. Eu já falei muita coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840514
    m_Localized: 'Prophet: Espero te ver daqui uns dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840513
    m_Localized: 'Prophet: Talvez te traga um pouco de paz. Ou pelo menos te ajuda a seguir em frente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840512
    m_Localized: 'Prophet: Se você concordar, eu vou continuar guiando você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840511
    m_Localized: 'Prophet: Ninguém, nem uma só.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840510
    m_Localized: 'Prophet: Mas... você não deve testar ninguém por dois dias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840509
    m_Localized: 'Prophet: Nada. Eu já falei demais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840508
    m_Localized: O que vai acontecer?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840507
    m_Localized: E o que eu devo fazer com isso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840506
    m_Localized: 'Prophet: Me pergunto se vão falar alguma coisa no rádio. Você vai ouvir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840505
    m_Localized: 'Prophet: Você não vai conseguir impedir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840504
    m_Localized: 'Prophet: Ainda assim, eu vejo com clareza, algo de ruim está próximo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840503
    m_Localized: 'Prophet: Graças a essa entidade eu consigo enxergar além do que qualquer pessoa. Mas eu não consigo ver tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840502
    m_Localized: 'Prophet: Vai te aproximar de... uma entidade poderosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840501
    m_Localized: O que vai acontecer?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840500
    m_Localized: E... o que eu devo fazer com isso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840499
    m_Localized: 'Prophet: Me pergunto se vão falar alguma coisa no rádio. Você vai ouvir?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840498
    m_Localized: 'Prophet: Você não é a causa, mas isso vai te tocar de qualquer maneira.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840497
    m_Localized: 'Prophet: E sei que tem uma coisa horrível vindo aí.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840496
    m_Localized: 'Prophet: Não sei de tudo. Mas sobre você... eu sei o que acontece se você seguir o caminho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840495
    m_Localized: 'Prophet: Eu enxergo além do que a maioria consegue enxergar. É um presente que me foi dado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840494
    m_Localized: Por que você me pediu para eu deixar alguém com um gato entrar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840493
    m_Localized: Como você sabe do gato?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840492
    m_Localized: 'Prophet: Como lidar com quem o trouxe é uma decisão sua para tomar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840491
    m_Localized: 'Prophet: Perfeito. O gato tá contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840490
    m_Localized: 'Gasmask: E estaremos de saída.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840489
    m_Localized: 'Gasmask: Então, nós VAMOS LEVAR DOIS INDIVÍDUOS AGORA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840488
    m_Localized: 'Gasmask: Você fica pra atrás e morre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840487
    m_Localized: 'Gasmask: Pegamos todo mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840486
    m_Localized: 'Gasmask: Nós quebramos a porta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840485
    m_Localized: 'Gasmask: É como conversar com uma parede.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840484
    m_Localized: 'Gasmask: Certo, cuide-se.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840483
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840482
    m_Localized: 'Gasmask: Igualmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840481
    m_Localized: Não vou dar mais ninguém
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840480
    m_Localized: Espero que nunca mais
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840479
    m_Localized: 'Gasmask: E lidaremos com você, também.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840478
    m_Localized: 'Gasmask: Você não é o primeiro a resistir. Nós já lidamos com outros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840477
    m_Localized: 'Gasmask: Ou derrubamos a porta e fazemos a limpa na porra do seu muquifo ou você nos entrega dois indivíduos, agora mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840476
    m_Localized: 'Gasmask: Não estou discutindo sobre o assunto com você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840475
    m_Localized: 'Gasmask: Não tenho mais palavras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840474
    m_Localized: 'Gasmask: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840473
    m_Localized: Não vou dar mais ninguém
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840472
    m_Localized: Espero que nunca mais
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840471
    m_Localized: 'Gasmask: E aí, ou encontramos alguma maneira de lidar com os Visitantes ou nunca mais nos veremos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840470
    m_Localized: 'Gasmask: Não vamos levar todo mundo. Só dois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840469
    m_Localized: 'Gasmask: Mais dois indivíduos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840468
    m_Localized: Para que caralhos vocês servem, se nada está dando resultado?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840467
    m_Localized: O que é preciso para consertar isso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840466
    m_Localized: 'Gasmask: Se não encontrarmos uma maneira de sobreviver, uma outra pessoa vai decidir por nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840465
    m_Localized: 'Gasmask: Nos deram uma missão impossível.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840464
    m_Localized: 'Gasmask: As autoridades estão prontas para explodir a cidade toda. Eles não conseguem se conter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840463
    m_Localized: 'Gasmask: É um desastre da porra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840462
    m_Localized: Para que caralhos vocês servem, se nada está dando resultado?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840461
    m_Localized: O que é preciso para consertar isso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840460
    m_Localized: 'Gasmask: Continua brincando e nós levaremos todos nessa casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840459
    m_Localized: 'Gasmask: O MUNDO ESTÁ A BEIRA DE UM COLAPSO.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840458
    m_Localized: 'Gasmask: PAROU AGORA COM A LADAINHA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840457
    m_Localized: Que catástrofe?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840456
    m_Localized: Onde. Estão. As. Pessoas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840455
    m_Localized: 'Gasmask: Ou então vai acontecer uma catástrofe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840454
    m_Localized: 'Gasmask: Precisamos de mais indivíduos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840453
    m_Localized: 'Gasmask: Obrigado. Eles voltarão em breve para você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840452
    m_Localized: 'Gasmask: Só. Entregue. Alguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840451
    m_Localized: 'Gasmask: Nos preocupamos com essa cidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840450
    m_Localized: 'Gasmask: Se você resistir, não vamos parar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840449
    m_Localized: 'Gasmask: É o que acontece quando gente teimosa atrapalha a gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840448
    m_Localized: 'Gasmask: Tá gostando do que vê aqui atrás de mim?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840447
    m_Localized: 'Gasmask: Certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840446
    m_Localized: 'Gasmask: Puta que pariu...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840445
    m_Localized: 'Gasmask: E lidaremos com os Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840444
    m_Localized: 'Gasmask: Nós vamos levar dois agora, mas os traremos de volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840443
    m_Localized: 'Gasmask: Agradecemos a compreensão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840442
    m_Localized: 'Gasmask: Sim, ajuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840441
    m_Localized: Não. Chega disso
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840440
    m_Localized: Certo. Se vai ajudar...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840439
    m_Localized: 'Gasmask: As coisas vão se estabilizar em breve.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840438
    m_Localized: 'Gasmask: Não importa quem. Só nos dê alguém. Agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840437
    m_Localized: 'Gasmask: Mas dessa vez nós levamos dois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840436
    m_Localized: 'Gasmask: Sim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840435
    m_Localized: Não. Chega disso
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840434
    m_Localized: Certo. Se vai ajudar...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840433
    m_Localized: 'Gasmask: Vai fazer as coisas correrem mais rápidas. É para o bem de todos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840432
    m_Localized: 'Gasmask: Nós precisamos de dois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840431
    m_Localized: 'Gasmask: Precisamos de indivíduos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840430
    m_Localized: Eu tenho que te dar alguém mais uma vez?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840429
    m_Localized: E agora?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840428
    m_Localized: 'Gasmask: A situação está sob o nosso controle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840427
    m_Localized: 'Gasmask: Só deixa a gente fazer o nosso trabalho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840426
    m_Localized: 'Gasmask: Se fosse simples assim a FEMA não teria serventia alguma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840425
    m_Localized: Eu tenho que te dar alguém mais uma vez?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840424
    m_Localized: E agora?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840423
    m_Localized: 'Gasmask: Coopere mais e talvez isso acabe logo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840422
    m_Localized: 'Gasmask: Difícil dizer. Precisamos de mais indivíduos para manter tudo sob controle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840421
    m_Localized: 'Gasmask: Ainda estamos realizando pesquisas. Não é da sua conta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840420
    m_Localized: Quando você vai se livrar dos Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840419
    m_Localized: Por quanto mais tempo isso vai continuar acontecendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840418
    m_Localized: 'Gasmask: E esse lugar em outro tempo era... o meu lar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840417
    m_Localized: 'Gasmask: E veja onde nós fomos parar. Tivemos que dar fim em um ninho de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840416
    m_Localized: 'Gasmask: Você não está em uma posição para pedir qualquer coisa. Todo mundo tenta atrapalhar a gente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840415
    m_Localized: 'Gasmask: Não faça exigências.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840414
    m_Localized: Quando vocês vão se livrar dos Visitantes?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840413
    m_Localized: Por quanto mais tempo isso vai continuar acontecendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840412
    m_Localized: 'Gasmask: E isso faz com que a violência aumente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840411
    m_Localized: 'Gasmask: Esconder os Visitantes só faz as consequências se multiplicarem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840410
    m_Localized: 'Gasmask: Recuse e você verá mais explosões.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840409
    m_Localized: 'Gasmask: Consequências.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840408
    m_Localized: Traga o pessoal que você levou!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840407
    m_Localized: O que está acontecendo na cidade?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840406
    m_Localized: 'Gasmask: Quanto mais cedo, melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840405
    m_Localized: 'Gasmask: Precisamos de mais do seu pessoal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840404
    m_Localized: 'Gasmask: Olá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840403
    m_Localized: 'Gasmask: Acontecerá como deve acontecer. Quanto mais cedo você cooperar, mais rápido vai terminar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840402
    m_Localized: 'Gasmask: Você não tem escolha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840401
    m_Localized: 'Gasmask: Você entendeu errado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840400
    m_Localized: 'Gasmask: Assim que os testes forem concluídos nós notificaremos você sobre as próximas etapas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840399
    m_Localized: 'Gasmask: Não se preocupe. Os procedimentos são, sim, obrigatórios, mas nós damos um tempo de descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840398
    m_Localized: Não tenho interesse nesses testes
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840397
    m_Localized: Certo, se não existe outra saída
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840396
    m_Localized: 'Gasmask: Para aprofundar as pesquisas sobre os efeitos do sol nós precisamos de mais alguém da sua moradia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840395
    m_Localized: 'Gasmask: Os resultados são inconclusivos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840394
    m_Localized: Não tenho interesse nesses testes
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840393
    m_Localized: Certo, se não existe outra saída
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840392
    m_Localized: 'Gasmask: Depois, eles serão enviados de volta da zona de quarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840391
    m_Localized: 'Gasmask: Depois da triagem a quarentena é obrigatória. Seu pessoal vai ficar com a gente por um tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840390
    m_Localized: 'Gasmask: Ah. Então nossa equipe já veio aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840389
    m_Localized: 'Gasmask: Devolver?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840388
    m_Localized: E sobre a última inspeção?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840387
    m_Localized: Quando você vai devolver alguém dos nossos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840386
    m_Localized: 'Gasmask: Sem alarde. Não vamos demorar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840385
    m_Localized: 'Gasmask: Somos da FEMA. Dia de inspeção de rotina neste bairro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152845840384
    m_Localized: 'Gasmask: Boa noite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646208
    m_Localized: 'Luka: Se cuida, beleza?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646207
    m_Localized: 'Luka: Aí, já era. As coisas podem ficar feias em um estalar de dedos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646206
    m_Localized: 'Luka: Se você focar muito na dor ela vai começar a te comer vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646205
    m_Localized: 'Luka: Não se enterre no luto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646204
    m_Localized: 'Luka: Aí, talvez a morte não seja a única coisa fincada na sua mente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646203
    m_Localized: 'Luka: Espero que você consiga lembrar de como era sentir alegria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646202
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646201
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646200
    m_Localized: 'Luka: Entende o que eu tô dizendo? A vida anda azeda nesses últimos tempos. Azeda demais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646199
    m_Localized: 'Luka: Nos tempos em que seus objetivos de vida não eram só sobreviver e sim fazer algo de... bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646198
    m_Localized: 'Luka: Mas às vezes, se você lembrá-las que eram felizes...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646197
    m_Localized: 'Luka: Por que chamar de mentira? As pessoas estão atoladas em suas dores e eu entendo isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646196
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646195
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646194
    m_Localized: 'Luka: Agora, mais do que nunca, nós não podemos deixar a escuridão nos engolir por inteiros.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646193
    m_Localized: 'Luka: Tente lembrar o que te trouxe alegria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646192
    m_Localized: 'Luka: Antes de tudo isso acontecer, o que você amava?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646191
    m_Localized: 'Luka: Existem muitos motivos. Mas eu não posso te dizer o que deve te fazer feliz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646190
    m_Localized: Você está preparado para mentir para as pessoas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646189
    m_Localized: O que existe para estar feliz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646188
    m_Localized: 'Luka: O desespero nos cega para as coisas pequenas que ainda restam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646187
    m_Localized: 'Luka: O medo fez com que as pessoas se esquecessem de como é a sensação da alegria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646186
    m_Localized: 'Luka: Sim, eu também não vi ninguém sorrindo já faz um tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646185
    m_Localized: 'Luka: Ah, você quis dizer o sorriso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646184
    m_Localized: 'Luka: O que há de errado? Pra mim parece tudo certo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646183
    m_Localized: Você está preparado para mentir para as pessoas?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646182
    m_Localized: O que existe para estar feliz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646181
    m_Localized: 'Luka: Se repetirmos que tá tudo bem pra nossa mente pode ser que as coisas fiquem mais fáceis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646180
    m_Localized: 'Luka: A próxima geração, todos os tipos de arte. A vida por si só.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646179
    m_Localized: 'Luka: É, os tempos estão difíceis. Mas ainda tem muita coisa que vale a pena lutar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646178
    m_Localized: 'Luka: Já existe raiva demais aqui fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646177
    m_Localized: O que aconteceu com o seu rosto?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646176
    m_Localized: Que animação toda é essa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646175
    m_Localized: 'Luka: Tudo bem eu passar a noite aqui?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646174
    m_Localized: 'Luka: Você já tá na porta, hein? Eu escutei uns passos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646173
    m_Localized: 'BigLebowski: Não passa segurança'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646172
    m_Localized: 'BigLebowski: Enfim, a tua vibe é horrível.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646171
    m_Localized: 'BigLebowski: Beleza. Então vai se fuder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646170
    m_Localized: 'BigLebowski: Mas... tanto faz.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646169
    m_Localized: 'BigLebowski: Ah, você tem até um carpete. Legal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646168
    m_Localized: 'BigLebowski: Caramba... tá de brincadeira?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646167
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646166
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633025
    m_Localized: 'BigLebowski: Você vai mesmo deixar uma criança aqui fora? No sol escaldante? Com os Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 41577268789633024
    m_Localized: 'BigLebowski: Tanto faz. Eu tô aqui, não tô? E seria ótimo ter um teto pra me abrigar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646165
    m_Localized: 'BigLebowski: A minha mãe também adora se bronzear no sol. Então, é... isso é uma possibilidade divertida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646164
    m_Localized: 'BigLebowski: Ou talvez eles já sejam Visitantes. Isso meio que combinaria com eles. Há.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646163
    m_Localized: 'BigLebowski: Como se eu soubesse... Em casa, provavelmente. Onde mais eles estariam?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646162
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646161
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646160
    m_Localized: 'BigLebowski: Se você for um desses loucos, é melhor lembrar que eu não vou aceitar! Tente qualquer coisa e eu te dou um murro na cara!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646159
    m_Localized: 'BigLebowski: Mas, vez ou outra a gente se depara com um bocado de zé mané.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646158
    m_Localized: 'BigLebowski: Mas, tô quebrada. Então, ou é fechar negócio com outras pessoas ou me esconder em porões ainda não habitados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646157
    m_Localized: 'BigLebowski: A vida é assim. Obriga você. Eu... tô viajando, eu acho. Quero ver o mundo e vários lugares diferentes. Talvez eu encontre um novo lar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646156
    m_Localized: Onde estão os seus pais?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646155
    m_Localized: O que você faz se escondendo em porões?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646152
    m_Localized: 'BigLebowski: Tô cansada pra caramba e eu não consegui encontrar nenhum porão ou um lugar seguro pra me esconder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646151
    m_Localized: 'BigLebowski: Meio bizarro, mas... me deixa entrar e ficar só até amanhã?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646150
    m_Localized: Onde estão os seus pais?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646149
    m_Localized: O que você faz se escondendo em porões?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646146
    m_Localized: 'BigLebowski: Cansei de me esconder em porões. Se eu continuar desse jeito vou acabar esquecendo de como se conversa com as pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646145
    m_Localized: 'BigLebowski: Não, só... preciso de um lugar pra descansar um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646144
    m_Localized: Sim, é minha
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646143
    m_Localized: Você está procurando por alguém?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646142
    m_Localized: 'BigLebowski: Aqui é, tipo, tua casa? Quer dizer... a sua casa, senhor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646141
    m_Localized: 'BigLebowski: Olá. Hã... oi, eu acho, se for melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646140
    m_Localized: 'Couple: Vai, mexe essas pernas, o cansaço também me pegou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646139
    m_Localized: 'Couple: A gente continua procurando, né, meu bem?'
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582080
    m_Localized: (Pegar entrega)
    m_Metadata:
      m_Items: []
  - m_Id: 53571425137582081
    m_Localized: (Pegar entrega)
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776384
    m_Localized: (Pegar entrega)
    m_Metadata:
      m_Items: []
  - m_Id: 53571425141776385
    m_Localized: (Pegar entrega)
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646138
    m_Localized: 'Couple: Entendi. Desculpa incomodar você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646137
    m_Localized: 'Couple: Ela é bem tímida. Tá tudo bem. Nós vamos descansar logo, logo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646135
    m_Localized: 'Couple: Ah, muito obrigado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646134
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646133
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646132
    m_Localized: 'Couple: Oopa, foi mal. Não é da minha conta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646131
    m_Localized: 'Couple: Valeu por ajudar a minha esposa. Sem ela eu não teria sobrevivido a nada disso. E você, como tem passado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646130
    m_Localized: 'Couple: Tudo isso somatizado, tem sido difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646129
    m_Localized: 'Couple: Assim, você entende, né? Os Visitantes, o calor, a demissão...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646128
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646127
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646126
    m_Localized: 'Couple: Ah, mil perdões. Eu não devia estar enchendo você desse jeito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646125
    m_Localized: 'Couple: Certo, querida?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646124
    m_Localized: 'Couple: Mas talvez a gente consiga conversar em outro dia. É claro, se a gente se encontrar outra vez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646123
    m_Localized: 'Couple: Me desculpa. Ela só está mesmo muito cansada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646122
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646121
    m_Localized: 'Couple: Mas é claro! Querida, pode dizer alguma coisa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646120
    m_Localized: E do que é mesmo que você está cansado?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646119
    m_Localized: A sua esposa consegue falar por conta própria?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646118
    m_Localized: 'Couple: Quer dizer... se isso não incomodar você, é claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646117
    m_Localized: 'Couple: Minha esposa está exausta. Ela precisa descansar um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646116
    m_Localized: 'Couple: Bom... acho que vamos ter que procurar em outro lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646115
    m_Localized: E do que é mesmo que você está cansado?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646114
    m_Localized: A sua esposa consegue falar por conta própria?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646113
    m_Localized: 'Couple: Casa grande, um pouco fora do caminho, sem vizinhos barulhentos... a chance de algum esquisitão aparecer é menor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646112
    m_Localized: 'Couple: Eu não sei como explicar, ha ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646111
    m_Localized: 'Couple: Honestamente, sua casa parece mais segura do que qualquer uma que tenhamos visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646110
    m_Localized: E se você for encrenca?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646109
    m_Localized: A minha casa parece um lugar seguro pra você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646108
    m_Localized: 'Couple: Se importaria se ficássemos um pouco aqui? Se não for um problema, é claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646107
    m_Localized: 'Couple: Ah, olá! Minha esposa e eu estamos procurando por um lugar seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646106
    m_Localized: 'Couple: ... Isso, bem melhor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646105
    m_Localized: 'Ballerina: Um presente meu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646104
    m_Localized: 'Ballerina: Você vai encontrar o gatinho embaixo da casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646103
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646102
    m_Localized: 'Ballerina: Vai, gatinho. Tá na hora de correr e se divertir!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646101
    m_Localized: 'Ballerina: Eu me sinto em casa aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646100
    m_Localized: Só pica a mula daqui, porra
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646099
    m_Localized: Tá. Pode entrar...
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646098
    m_Localized: 'Ballerina: Pense bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646097
    m_Localized: 'Ballerina: Olha o gatinho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646096
    m_Localized: 'Ballerina: Não torture o gatinho. O gatinho é friorento.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646095
    m_Localized: 'Ballerina: A pobre dançarina congela no frio... Que triste...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646094
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646093
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646092
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646091
    m_Localized: 'Ballerina: Vai abrir ou não?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646090
    m_Localized: 'Ballerina: Eu passei no teste?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646089
    m_Localized: 'Ballerina: Isso não é o suficiente pra você?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646088
    m_Localized: 'Ballerina: Eu tenho dois braços, duas pernas, uma cabeça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646087
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646086
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646085
    m_Localized: 'Ballerina: Então? Decide logo. O que estamos fazendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646084
    m_Localized: 'Ballerina: Sou uma balé-ina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646083
    m_Localized: 'Ballerina: Talvez eu dance.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646082
    m_Localized: 'Ballerina: Quer me ver dançar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646081
    m_Localized: 'Ballerina: E daí?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152841646080
    m_Localized: Prove que é uma pessoa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451995
    m_Localized: Acho que você não é humana
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451994
    m_Localized: 'Ballerina: Isso parece estranho'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451993
    m_Localized: 'Ballerina: E agora? Você vai me dizer mais? Ou o quê?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451992
    m_Localized: 'Ballerina: Provar? Claro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451991
    m_Localized: Prove que é uma pessoa
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451990
    m_Localized: Acho que você não é humana
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451989
    m_Localized: 'Ballerina: Heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451988
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451987
    m_Localized: 'Ballerina: Não sei. Por que isso importa?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451986
    m_Localized: Você me lembra de... alguém.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451985
    m_Localized: Alguém mandou você aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451984
    m_Localized: 'Ballerina: Não é quente aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451983
    m_Localized: 'Ballerina: Vi sua casa. Entrei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451982
    m_Localized: 'Ballerina: Vê aquela cidade? Morava lá.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451981
    m_Localized: Você me lembra de... alguém.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451980
    m_Localized: Alguém mandou você aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451979
    m_Localized: 'Ballerina: Fazia balé. Consegue ver?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451978
    m_Localized: 'Ballerina: Eu danço.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451977
    m_Localized: Como você encontrou minha casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451976
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451975
    m_Localized: 'Ballerina: Me disseram pra vir aqui, então eu vim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451974
    m_Localized: 'Ballerina: Vai abrir ou não vai? Sim? Não?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451973
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451972
    m_Localized: 'Ballerina: Fardo de cerveja. As gavetas. O Pernil. Não sei. Dá qualquer coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451971
    m_Localized: Como você encontrou minha casa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451970
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451969
    m_Localized: 'Ballerina: Como isso vai te ajudar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451968
    m_Localized: 'Ballerina: Você pergunta demais. Sim, eu conheço ele.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451967
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451966
    m_Localized: O que você quer?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451965
    m_Localized: Você conhece... o homem careca?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451964
    m_Localized: 'Ballerina: Vai abrir ou não?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451963
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451962
    m_Localized: 'Ballerina: Oi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451961
    m_Localized: 'Teacher: Se cruzar com uma criança... me prometa que vai cuidar dela. Adeus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451960
    m_Localized: 'Teacher: Eu não o culpo. Mas por favor... me prometa uma coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451959
    m_Localized: 'Teacher: Eu sei que não tem como trazer eles de volta.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451958
    m_Localized: 'Teacher: Obrigada... Por escutar. E por me deixar entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451957
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451956
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451955
    m_Localized: 'Teacher: Eles queimaram tudo. E me fizeram assistir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451954
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451953
    m_Localized: 'Teacher: O que elas fizeram para merecer isso?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451952
    m_Localized: 'Teacher: O que nos tornamos? Uma multidão, fazendo julgamentos sobre crianças indefesas?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451951
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451950
    m_Localized: 'Teacher: Elas descobriram que eu estava abrigando as crianças com sinais de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451949
    m_Localized: 'Teacher: Por causa... Por causa das pessoas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451948
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451947
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451946
    m_Localized: 'Teacher: Eu ainda sinto os olhos assustados das crianças me olhando...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451945
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451944
    m_Localized: 'Teacher: Elas me fizeram olhar... enquanto trancavam as portas, pregavam as janelas fechadas... e colocavam fogo no prédio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451943
    m_Localized: 'Teacher: As pessoas que fizeram isso. Elas estavam aterrorizadas com as crianças poderem ser Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451942
    m_Localized: 'Teacher: Elas morreram todas... nas chamas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451941
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451940
    m_Localized: 'Teacher: Elas...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451939
    m_Localized: Por que aconteceu o incêndio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451938
    m_Localized: O que aconteceu com as crianças?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451937
    m_Localized: 'Teacher: Mas agora... todas se foram. Nem sequer uma sobreviveu ao fogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451936
    m_Localized: 'Teacher: Alguns abandonavam as próprias crianças no momento que vissem um sinal de Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451935
    m_Localized: 'Teacher: Alguns levados pela FEMA. Outros mortos. Alguns...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451934
    m_Localized: 'Teacher: Elas perderam os pais por diversas razões.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451933
    m_Localized: 'Teacher: Eu... Quando o mundo começou a ruir, eu trouxe aquelas que ficaram para trás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451932
    m_Localized: 'Teacher: Eu era uma professora... no jardim de infância.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451931
    m_Localized: Por que aconteceu o incêndio?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451930
    m_Localized: O que aconteceu com as crianças?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451929
    m_Localized: 'Teacher: Mas... não pude salvar elas. Eu falhei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451928
    m_Localized: 'Teacher: Elas só precisavam de alguém pra cuidar delas. Alguém para dar amor. Eu fiz meu melhor...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451927
    m_Localized: 'Teacher: Nós ficávamos no antigo prédio do jardim de infância.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451926
    m_Localized: 'Teacher: Eu aceitava qualquer criança que chamassem de “corrompida”, qualquer criança que temiam ser um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451925
    m_Localized: 'Teacher: Eu... Eu só queria dar um pouco de esperança para as crianças abandonadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451924
    m_Localized: Quem é você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451923
    m_Localized: O que aconteceu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451922
    m_Localized: 'Teacher: Posso... conversar com você?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451921
    m_Localized: 'Teacher: Desculpe por incomodar... me sinto muito mal.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451920
    m_Localized: 'Dude: Tome cuidado... e da sua galera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451919
    m_Localized: 'Dude: Tudo bem, mano. Entendo. Sem rancor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451918
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451917
    m_Localized: 'Dude: Caaaara...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451916
    m_Localized: 'Dude: Precisamos fazer um filme sobre isso um dia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451915
    m_Localized: 'Dude: Cara, isso deve ser a melhor coisa que já me aconteceu recentemente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451914
    m_Localized: 'Dude: Ei, mano, agradeço.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451913
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451912
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451911
    m_Localized: 'Dude: Sempre quis poder fazer parte de um filme um dia...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451910
    m_Localized: 'Dude: Muito mais divertidos do que livros, mano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451909
    m_Localized: 'Dude: Eles tem sentimentos. Drama. Traições.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451908
    m_Localized: 'Dude: Mas os filmes, cara...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451907
    m_Localized: 'Dude: E depois das notícias? É só miséria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451906
    m_Localized: 'Dude: As pessoas falando merda uma das outras, todo esse desespero e tristeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451905
    m_Localized: 'Dude: Nem cara, lá fora tá uma bagunça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451904
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451903
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451902
    m_Localized: 'Dude: Tá bom, não vou insistir. Mas vamo mano, me deixa entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451901
    m_Localized: 'Dude: Haha, seria massa demais. Meu amigo leu um livro onde isso acontecia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451900
    m_Localized: 'Dude: Imagina se tivéssemos conquistado o espaço e começado a enviar cartas para aliens...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451899
    m_Localized: 'Dude: Tipo, eles acertam coisas tecnológicas e eventos antes mesmo de acontecerem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451898
    m_Localized: 'Dude: Você já viu como os escritores de ficção científica sempre acertam o futuro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451897
    m_Localized: 'Dude: Nah, mano, não tô viajando. Eu sei o que eu tô falando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451896
    m_Localized: Você tem alguma ideia do que tá acontecendo aí fora?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451895
    m_Localized: Que merda você tá falando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451894
    m_Localized: 'Dude: E comida, mano. Muita comida.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451893
    m_Localized: 'Dude: Aliás, tem uma espingarda ou algo assim? Vamos precisar do poder de fogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451892
    m_Localized: 'Dude: Isso muda totalmente o plano.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451891
    m_Localized: 'Dude: É um vírus ou são mortos-vivos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451890
    m_Localized: 'Dude: Mas diz aí, zumbis rápidos ou lentos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451889
    m_Localized: 'Dude: Eu vi muitos filmes sobre isso, sou basicamente um guru da sobrevivência.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451888
    m_Localized: 'Dude: Mano, pode contar comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451887
    m_Localized: 'Dude: ZUMBIS! HA! SABIA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451886
    m_Localized: Você tem alguma ideia do que tá acontecendo aí fora?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451885
    m_Localized: Que merda você tá falando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451884
    m_Localized: 'Dude: Ah ah, e o time tem que ser de quatro pessoas. Esse é, tipo, o número certo pra sobrevivência.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451883
    m_Localized: 'Dude: Tipo, boom! Foguete lança, missão pra parar a bola de fogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451882
    m_Localized: 'Dude: Então estamos mandando um grupo de astronautas fodões pro sol, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451881
    m_Localized: 'Dude: Mano, eu vi esse filme!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451880
    m_Localized: 'Dude: Sem chance!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451879
    m_Localized: Criaturas que parecem humanos começaram a sair do chão.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451878
    m_Localized: O sol está explodindo, queimando as pessoas vivas durante o dia.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451877
    m_Localized: 'Dude: Fala a real aí, mano, o que eu perdi?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451876
    m_Localized: 'Dude: Caaaaara, o que tá acontecendo aqui fora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451875
    m_Localized: 'Dude: Eai, mano, qual é?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451874
    m_Localized: 'Blind: Ou AQUILO vai ir atrás de você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451873
    m_Localized: 'Blind: Pelo amor de tudo que é sagrado, NÃO VÁ pra perto de QUALQUER corpo carbonizado depois de escurecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451872
    m_Localized: 'Blind: Certo, eu vou sair. Mas, antes, preciso te avisar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451871
    m_Localized: 'Blind: Caramba... Será que vai ser mais difícil dormir, já que não tenho olhos pra fechar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451870
    m_Localized: 'Blind: Obrigado... Eu finalmente posso descansar um pouco.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451869
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451868
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451867
    m_Localized: 'Blind: Aquela coisa não é desse mundo, não deveria existir... ELE NÃO DEVERIA EXISTIR.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451866
    m_Localized: 'Blind: Maior... e mais forte. AQUILO não pode ser nomeado e AQUILO segue o aroma da carne carbonizada, ceifando o que semeamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451865
    m_Localized: 'Blind: Não... Ah, não. Tem uma coisa muito pior vagando por aí...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451864
    m_Localized: 'Blind: Você acha mesmo que um homem pálido seria o suficiente para eu arrancar meus olhos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451863
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451862
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451861
    m_Localized: 'Blind: Meu bom Deus... eu não desejaria uma visão DAQUILO nem para o meu pior inimigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451860
    m_Localized: 'Blind: Digerindo lentamente aqueles corpos escurecidos, como se fossem carvão... BEM NA FRENTE DOS MEUS OLHOS!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451859
    m_Localized: 'Blind: AQUILO... AQUILO nem tinha me notado de primeira. Estava ocupado demais devorando a carne...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451858
    m_Localized: 'Blind: O meu único erro foi estar vagando pelo lugar errado, na hora errada...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451857
    m_Localized: 'Blind: Para AQUILO, o nosso sofrimento é um banquete! Um rodízio de dor! Ele se esbanja no medo, na dor... nas nossas consciências!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451856
    m_Localized: 'Blind: Acredite em mim, é melhor você não saber...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451855
    m_Localized: Você diz o homem pálido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451854
    m_Localized: O que você viu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451853
    m_Localized: 'Blind: Eu pensei que conseguiria apagar aquela imagem assustadora se eu arrancasse os dois olhos. Agora, tudo o que eu vejo é um vazio infinito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451852
    m_Localized: 'Blind: Para evitar que minha sanidade fosse pelo ralo, eu tive que sacrificar meus olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451851
    m_Localized: 'Blind: Eu... fiz isso comigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451850
    m_Localized: Você diz o homem pálido?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451849
    m_Localized: O que você viu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451848
    m_Localized: 'Blind: Acredite... se tivesse visto AQUILO, você teria feito o mesmo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451847
    m_Localized: 'Blind: Não existem palavras catalogadas pela humanidade que possam descrever o mal que rompeu minha alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451846
    m_Localized: 'Blind: Está sempre na minha frente. Queimando na escuridão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451845
    m_Localized: 'Blind: Eu vi uma coisa que não consigo colocar em  palavras. Eu não vou ousar descrever... pois quem se aprofunda no que a mente gera quando ela se fragmenta?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451844
    m_Localized: Quem fez isso com você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451843
    m_Localized: O que aconteceu com seus olhos?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451842
    m_Localized: 'Blind: Finalmente... algum tipo de abrigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451841
    m_Localized: 'Fatman: Pra onde cacetas eu vou, então? Tô fodido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451840
    m_Localized: 'Fatman: Pô, meu caro... Não tá vendo que eu tô na pior?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451839
    m_Localized: 'Fatman: Eu te pago de volta quando todo esse caos acabar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451838
    m_Localized: 'Fatman: Você não vai se arrepender, meu caro'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451837
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451836
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451835
    m_Localized: 'Fatman: Me deixa entrar e quando isso tudo terminar... você vai nadar em dinheiro. Em muito dinheiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451834
    m_Localized: 'Fatman: Você não ignora um homem importante. Eu administrava esse lugar, eu já fui um ministro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451833
    m_Localized: 'Fatman: Eu penei pra conseguir me arrastar e chegar até aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451832
    m_Localized: 'Fatman: Me ajuda aí, cara... me deixa entrar, eu não consigo aguentar isso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451831
    m_Localized: 'Fatman: Eu tô me sentindo mal, não é brincadeira. Preciso de água gelada, agora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451830
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451829
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451828
    m_Localized: 'Fatman: Ou então eu vou desmaiar aqui e vou virar espetinho quando o sol nascer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451827
    m_Localized: 'Fatman: Olha, abre a porta aí. Eu preciso usar a banheira.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451826
    m_Localized: 'Fatman: Agora... eu tô pensando em sorvete. Porra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451825
    m_Localized: 'Fatman: Massa, é melhor assim. Rapaz, eu achei que ia derreter aqui fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451824
    m_Localized: Por que você precisa do meu banheiro?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451823
    m_Localized: Sim. Tenho um aqui
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451822
    m_Localized: 'Fatman: Eu só preciso de uma ducha gelada. Se importa se eu usar o teu chuveiro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451821
    m_Localized: 'Fatman: Mais quente do que a sauna de qualquer hotel 5 estrelas que eu já visitei.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451820
    m_Localized: 'Fatman: Parece que a minha pele tá queimando.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451819
    m_Localized: 'Fatman: Não, caralho, eu não tô bem. Olha pra mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451818
    m_Localized: Por que você precisa de um banheiro?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451817
    m_Localized: Sim. Tenho um aqui
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451816
    m_Localized: 'Fatman: Dá nem pra respirar. Você, hã... tem um banheiro aí que eu possa usar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451815
    m_Localized: 'Fatman: Claro, tá um pouco mais frio, mas o ar tá seco pra caramba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451814
    m_Localized: 'Fatman: Não importa. Ainda parece um forno a céu aberto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451813
    m_Localized: Você está bem?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451812
    m_Localized: Estamos no meio da madrugada
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451811
    m_Localized: 'Fatman: Cacete... ei, cara, aqui fora tá quente pra caramba.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451810
    m_Localized: 'Buddy: Tá beleza, eu não vou ser um incômodo pra você. Tô indo nessa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451809
    m_Localized: 'Buddy: Caramba, parceiro...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451808
    m_Localized: 'Buddy: Se você tivesse recusado, eu já era.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451807
    m_Localized: 'Buddy: Obrigadão, meu bom.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451806
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451805
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451804
    m_Localized: 'Buddy: Deixando as piadas de lado... você vai me deixar entrar, parceiro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451803
    m_Localized: 'Buddy: E aí, você me diz, por que não afogar as mágoas um pouquinho? Lidar com isso tudo... sóbrio... é muita coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451802
    m_Localized: 'Buddy: He he, fica tranquilo, só tô enchendo teu saco de novo. Não fica magoado comigo, tá? Esses tempos em que estamos vivendo... dar umas risadas é um ótimo remédio.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451801
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451800
    m_Localized: 'Buddy: É gostoso, saudável e ainda serve de dieta se você fizer tudo certinho. Tô dizendo, dá uma conferida no meu físico!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451799
    m_Localized: 'Buddy: Hoje eu tive o café da manhã de um rei. Segui o meu planejamento alimentar à risca: cerveja de manhã e vinho no jantar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451798
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451797
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451796
    m_Localized: 'Buddy: Então, hã, você vai me deixar entrar, parceiro?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451795
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451794
    m_Localized: 'Buddy: Foi mal se as minhas piadas te incomodaram. Só tô tentando manter a minha sanidade, sabe?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451793
    m_Localized: 'Buddy: Rir não faz mal, parceiro. Mesmo quando tudo ao nosso redor tá indo pra casa do caralho. Sem isso, eu já teria ido dessa pra outra há muito tempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451792
    m_Localized: 'Buddy: Eu não sou ESSE tipo de "cara íntegro". Mas, ei! O que tem de errado em ter um pouco de senso de humor enquanto o mundo tá desmoronando?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451791
    m_Localized: Você tá me parecendo embriagado. Estava bebendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451790
    m_Localized: E você é o que, um comediante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451789
    m_Localized: 'Buddy: Esquece.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451788
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451787
    m_Localized: 'Buddy: Eu nunca machucaria alguém por conta de dente, olho ou qualquer coisa que estejam dizendo na TV. Eu não conseguiria nem...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451786
    m_Localized: 'Buddy: Uma ou duas características estranhas não fazem de você um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451785
    m_Localized: 'Buddy: Qualé, cara, eu tô te zoando! Não vem com essa rigidez pra cima de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451784
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451783
    m_Localized: 'Buddy: Claro, eu posso até dar uns socos por aí, em gente que tem a dentição e os olhos perfeitos... mas, é por pura inveja.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451782
    m_Localized: 'Buddy: Ah, pode acreditar, eu tenho um coração maior do que qualquer homem que você vai conhecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451781
    m_Localized: Você tá me parecendo embriagado. Estava bebendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451780
    m_Localized: E você é o que, um comediante?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451779
    m_Localized: 'Buddy: O que significa que tô livre pra dar um pulo nos bares se quiser beber uma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451778
    m_Localized: 'Buddy: Eu nem tenho uma sogra. Não sou nem casado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451777
    m_Localized: 'Buddy: Heh, te peguei, né? Tava só de brincadeira, parceiro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152837451776
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257716
    m_Localized: 'Buddy: Só fui expulso da casa do meu cunhado porque eu joguei um cara da FEMA pra fora. Agora ele tem medo que outros venham atrás.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257715
    m_Localized: 'Buddy: Ah, não é nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257714
    m_Localized: Como eu vou saber se você é um "cara íntegro"?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257713
    m_Localized: O que aconteceu com você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257712
    m_Localized: 'Buddy: E aí, meu bom. Tá com algum quarto sobrando aí pra um cara íntegro como eu?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257711
    m_Localized: 'Bestson: Tchau, estranho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257710
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257709
    m_Localized: 'Bestson: Sim... sim, eles vão voltar. Eu acho. Eu espero que sim...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257708
    m_Localized: 'Bestson: Eu vou voltar pra casa. Caso eles retornem...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257707
    m_Localized: 'Bestson: Sim. Isso é mais seguro provavelmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257706
    m_Localized: 'Bestson: Mas... talvez eu devesse ficar com você por hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257705
    m_Localized: 'Bestson: E se eles voltarem e eu não estiver lá?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257704
    m_Localized: 'Bestson: Eu não sei se isso é uma boa ideia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257703
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257702
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257701
    m_Localized: 'Bestson: O que eu deveria fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257700
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257699
    m_Localized: 'Bestson: Isso... Isso é um pesadelo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257698
    m_Localized: 'Bestson: Meu Deus, e se eles queimaram... e se o sol queimou eles?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257697
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257696
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257695
    m_Localized: 'Bestson: Então o que eu deveria fazer?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257694
    m_Localized: 'Bestson: Eu nem sei mais o que pensar. Talvez você também não acredite em mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257693
    m_Localized: 'Bestson: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257692
    m_Localized: 'Bestson: Merda, por que eles foram embora? Por que não me levaram?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257691
    m_Localized: 'Bestson: Meu Deus. E se aqueles Visitantes mataram eles...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257690
    m_Localized: O sol está explodindo. Está queimando as pessoas vivas agora
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257689
    m_Localized: Os visitantes saíram do chão. Você não pode acreditar em ninguém.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257688
    m_Localized: 'Bestson: Eu pensei que se conversasse com alguém, iriam me dizer o que tinha acontecido. Você pode? Por favor?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257687
    m_Localized: 'Bestson: Umas horas depois da transmissão, eles saíram com pressa... e não voltaram mais. Agora tenho ainda mais medo de ligar a TV.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257686
    m_Localized: 'Bestson: Eu não liguei a TV, não queria me estressar. Mas eles nunca mais voltaram, e eu ainda não sei o que tá acontecendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257685
    m_Localized: 'Bestson: Um dia, eles ouviram que algo terrível tinha acontecido.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257684
    m_Localized: 'Bestson: Mas a mãe e o pai sempre assistiam.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257683
    m_Localized: 'Bestson: E eu li em um lugar que as pessoas que evitam as notícias vivem mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257682
    m_Localized: 'Bestson: O noticiário nunca diz nada bom. Só me faz entrar em pânico, por isso parei de assistir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257681
    m_Localized: O sol está explodindo. Está queimando as pessoas vivas agora.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257680
    m_Localized: Os visitantes saíram do chão. Você não pode acreditar em ninguém.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257679
    m_Localized: 'Bestson: Eu preciso saber a verdade. Pra onde eles foram? Me diz, o que tá acontecendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257678
    m_Localized: 'Bestson: Mas... já foi uma semana inteira. Eles ainda não voltaram. Eu fiquei esperando, mas eles só... sumiram.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257677
    m_Localized: 'Bestson: Uma manhã eu acordei e eles estavam em pânico. Dizendo que precisavam sair imediatamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257676
    m_Localized: 'Bestson: Não, eu não assisto. As notícias me fazem entrar em pânico. Eu só... tento não olhar. Mas meus pais...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257675
    m_Localized: Você ao menos assiste TV?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257674
    m_Localized: Pera, você não sabe mesmo o que tá acontecendo?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257673
    m_Localized: 'Bestson: Atirando, brigando... eu não entendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257672
    m_Localized: 'Bestson: Tá tão quente que mal consigo respirar, e as pessoas estão... diferentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257671
    m_Localized: 'Bestson: Você pode me dizer o que tá acontecendo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257670
    m_Localized: 'Fugitive: Tanto faz. Tenha uma boa noite, pau no cu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257669
    m_Localized: 'Fugitive: Se escondendo em suas tocas e trancando todos os outros pra fora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257668
    m_Localized: 'Fugitive: É claro. Eu deveria saber. Você é como os outros. Ratos covardes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257667
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257666
    m_Localized: 'Fugitive: PORRA'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257665
    m_Localized: 'Fugitive: Bom ver que você não é como seus vizinhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257664
    m_Localized: 'Fugitive: Obrigado. Sério. Te devo uma.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257663
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257662
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257661
    m_Localized: 'Fugitive: Agora sou uma testemunha... Eu sei demais. Eles virão atrás de mim.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257660
    m_Localized: 'Fugitive: E por isso que eu fugi, mesmo tomando um tiro enquanto escalava a maldita cerca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257659
    m_Localized: 'Fugitive: Quando eu vi essa merda, eu sabia que precisava dar o fora dali.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257658
    m_Localized: 'Fugitive: Eles tão fazendo coisas com as pessoas. É por isso que ninguém sai daqueles lugares.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257657
    m_Localized: 'Fugitive: Eu ouvi gritos abafados... e então eles arrastaram embora um saco preto. O cara nunca mais voltou. Entende agora?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257656
    m_Localized: 'Fugitive: Eu VI isso. Eles levaram um coitado pra uma tenda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257655
    m_Localized: 'Fugitive: Isso não é rumor nenhum!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257654
    m_Localized: 'Fugitive: Já ouviu falar que a FEMA tá fazendo testes pra encontrar Visitantes?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257653
    m_Localized: 'Fugitive: Ah, acredite se quiser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257652
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257651
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257650
    m_Localized: 'Fugitive: Eu caí da cerca direto em uma poça, e saí correndo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257649
    m_Localized: 'Fugitive: É só que eu não tive tanta sorte. Um daqueles porcos se virou e me viu, começou a atirar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257648
    m_Localized: 'Fugitive: Eles estão ocupados lá. Dá pra ver que... estão se preparando pra algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257647
    m_Localized: 'Fugitive: Não precisei nem de um plano, só esperei o momento certo e escalei a cerca.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257646
    m_Localized: 'Fugitive: E a segurança deles é uma piada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257645
    m_Localized: 'Fugitive: Essa é a zona de quarentena da FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257644
    m_Localized: 'Fugitive: Um contêiner enorme onde eles enfiam as pessoas pra dentro toda manhã como se fosse gado.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257643
    m_Localized: 'Fugitive: Pense em um terreno vazio, cercado, algumas tendas espalhadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257642
    m_Localized: Então a FEMA está atrás de você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257641
    m_Localized: Me conte sobre as zonas de quarentena da FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257640
    m_Localized: 'Fugitive: Eu mandei eles se fuderem. Então me algemaram como algum criminoso. Mas eu fugi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257639
    m_Localized: 'Fugitive: Um segundo depois estão rabiscando alguma merda nos tablets e me mandando acompanhar eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257638
    m_Localized: 'Fugitive: Abri a porta e já estavam me escaneando direto.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257637
    m_Localized: 'Fugitive: Eu fugi de uma das zonas deles. Eles me pegaram quando bateram na minha porta durante uma varredura.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257636
    m_Localized: Então a FEMA está atrás de você?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257635
    m_Localized: Me conte sobre as zonas de quarentena da FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257634
    m_Localized: "Fugitive: Pelo menos minhas tripas não tão saindo... Não que tenha muito pra sair de qualquer forma..\n heh... Argh... Dói pra caralho."
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257633
    m_Localized: "Fugitive: Passou reto pelo menos, ainda bem.\n Mas porra, tô sangrando igual porco no abate."
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257632
    m_Localized: 'Fugitive: Uma mira de merda, aqueles lixos. Mas uma maldita bala... sim, uma me acertou.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257631
    m_Localized: 'Fugitive: Os porcos malditos da FEMA me pegaram... Eu tava escalando uma cerca, fugindo...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257630
    m_Localized: O que aconteceu?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257629
    m_Localized: Quem fez isso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257628
    m_Localized: 'Fugitive: Eu tomei um tiro. Não vou durar muito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257627
    m_Localized: 'Fugitive: Me ajude...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257626
    m_Localized: 'Nun: O Senhor lembrará disso. Ele vê tudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257625
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257624
    m_Localized: 'Nun: Minha morte pesará em sua alma, guarde minhas palavras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257623
    m_Localized: 'Nun: Você mandaria embora uma pobre velha mulher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257622
    m_Localized: 'Nun: Então vai ser assim, é?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257621
    m_Localized: 'Nun: Ora, muito obrigada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257620
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257619
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257618
    m_Localized: 'Nun: Bom, pode ter certeza que vou extirpar tal linguagem chula deste lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257617
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257616
    m_Localized: 'Nun: Eu faço uma simples pergunta sobre sua casa, e você me xinga?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257615
    m_Localized: 'Nun: Você não teme o Senhor?! Você não tem vergonha?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257614
    m_Localized: 'Nun: Seu bárbaro sem-Deus!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257613
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257612
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257611
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257610
    m_Localized: 'Nun: Isso é pedir demais?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257609
    m_Localized: 'Nun: Estou apenas tentando ver se sua casa é habitável. Eu não tenho tolerância para imundície.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257608
    m_Localized: 'Nun: Ah, muito obrigada! Eu jamais resolveria isso sem você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257607
    m_Localized: Você tá completamente maluca?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257606
    m_Localized: Isso não é um hotel!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257605
    m_Localized: 'Nun: Não posso lidar com eles. Deixam minha pele toda vermelha e embolotada.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257604
    m_Localized: 'Nun: Segundo... você tem percevejos? Ratos?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257603
    m_Localized: 'Nun: Se tem gente assim aí, é melhor me falar logo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257602
    m_Localized: 'Nun: Primeiro, não tenho paciência para bêbados e drogados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257601
    m_Localized: 'Nun: Você acolhe pessoas, não? Eu só preciso garantir algumas coisas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257600
    m_Localized: 'Nun: Eu preciso de um quarto na sua casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257599
    m_Localized: Você tá completamente maluca?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257598
    m_Localized: Isso não é um hotel!
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257597
    m_Localized: 'Nun: Você tem símbolos sagrados, não tem? E... Eu preciso de silêncio completo. Para oração e contemplação.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257596
    m_Localized: 'Nun: E já que estamos falando disso... Deixa eu te perguntar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257595
    m_Localized: 'Nun: Para ficar, querido, ficar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257594
    m_Localized: 'Nun: Deus tenha piedade, estou falando claramente, não estou?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257593
    m_Localized: O que exatamente você precisa?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257592
    m_Localized: Servir pra que?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257591
    m_Localized: 'Nun: Acredito que vai me servir bem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257590
    m_Localized: 'Nun: Vejo que sua pequena casa é a mais afastada por aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257589
    m_Localized: Desculpe por desperdiçar seu tempo. Eu... Eu só espero um dia aprender a matar. Pra então poder me defender sozinho.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257588
    m_Localized: Eu juro que não sou. Só tenho... estado no limite ultimamente.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257587
    m_Localized: 'Raskolnikov: Acho que dei muita pinta de maluco. Ou pior.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257586
    m_Localized: 'Raskolnikov: Você não vai me deixar entrar?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257585
    m_Localized: 'Raskolnikov: Poderia me mostrar como você faz? Como você mata um Visitante. Eu quero olhar o medo olho no olho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257584
    m_Localized: 'Raskolnikov: E... se não for pedir muito... depois de me testar...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257583
    m_Localized: 'Raskolnikov: Obrigado, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257582
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257581
    m_Localized: Pode entrar.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257580
    m_Localized: 'Raskolnikov: Você poderia me ensinar... como matar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257579
    m_Localized: 'Raskolnikov: Mas também, talvez... Quer dizer, se você estiver disposto... Bem...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257578
    m_Localized: 'Raskolnikov: É por isso que espero encontrar alguém... Alguém que possa me proteger.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257577
    m_Localized: 'Raskolnikov: E eu? Sou apenas um covarde. Não consigo me defender.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257576
    m_Localized: 'Raskolnikov: Hoje em dia tudo que precisa é um olhar torto e alguém puxa o gatilho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257575
    m_Localized: 'Raskolnikov: Eu quis dizer proteção dos Visitantes. E das pessoas que estão caçando eles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257574
    m_Localized: 'Raskolnikov: Não, não. Espera. Eu não tava falando daquele maníaco com o rifle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257573
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257572
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257571
    m_Localized: 'Raskolnikov: É por isso que eu preciso de alguém que entenda como o mundo funciona.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257570
    m_Localized: 'Raskolnikov: Tenho medo do que vai acontecer se eu não aprender a revidar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257569
    m_Localized: 'Raskolnikov: Quando as coisas eram normais, eu não conseguia matar nem uma mosca. Mas agora... pessoas moles como eu não duram...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257568
    m_Localized: 'Raskolnikov: Eu não queria parecer nenhum maníaco. É só que...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257567
    m_Localized: 'Raskolnikov: O que? Pera... eu pareço... estranho pra você?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257566
    m_Localized: Do que exatamente você quer se proteger?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257565
    m_Localized: Porque você é tão fissurado em matar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257564
    m_Localized: 'Raskolnikov: E então... Não serei aquele vivendo com medo. Eles serão.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257563
    m_Localized: 'Raskolnikov: Mas tanto faz. Um dia vou aprender a matar também.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257562
    m_Localized: 'Raskolnikov: Ainda bem que ele não me viu. Teria torcido meu pescoço na hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257561
    m_Localized: 'Raskolnikov: É só que... Eu me encontrei com um lunático armado um tempo atrás. Vi ele interrogando um homem... sempre perguntando se era um Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257560
    m_Localized: 'Raskolnikov: Mas não me entenda mal, eu não estou tentando voltar você contra ninguém.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257559
    m_Localized: 'Raskolnikov: Prefeito! Então você pode dar conta de qualquer Visitante que aparecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257558
    m_Localized: Do que exatamente você quer se proteger?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257557
    m_Localized: Porque você é tão fissurado em matar?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257556
    m_Localized: 'Raskolnikov: Aposto que você poderia matar com as próprias mãos, se fosse necessário.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257555
    m_Localized: 'Raskolnikov: Mas você tem aquele tom na sua voz. Eu diria que seu temperamento combina.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257554
    m_Localized: 'Raskolnikov: Julgar alguém por matar durante um apocalipse... Não seria como dar multas por alta velocidade em uma pista de corrida?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257553
    m_Localized: 'Raskolnikov: É só que... são tempos difíceis. Sabe? É preciso saber se você pode se virar. Se pode eliminar uma ameaça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257552
    m_Localized: 'Raskolnikov: Ah... Desculpe. Eu não queria ser rude.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257551
    m_Localized: Sim, tenho uma arma.
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257550
    m_Localized: Por que você quer saber?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257549
    m_Localized: 'Raskolnikov: Diz aí, está armado?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257548
    m_Localized: 'Raskolnikov: Olá, amigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257547
    m_Localized: 'Wifefema: Quer saber? Vá se fuder. Vou falar com seus vizinhos. Tchau, imbecil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257546
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257545
    m_Localized: 'Wifefema: Tem merda na cabeça? Tô aqui falando a real e cê tá brincando comigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257544
    m_Localized: 'Wifefema: Tá falando sério? Meu marido é da FEMA!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257543
    m_Localized: 'Wifefema: Cê pensa que eu sou um Visitante?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257542
    m_Localized: 'Wifefema: Pera... mas o que?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257541
    m_Localized: 'Wifefema: Assim que matarmos esses Visitantes, vamos voltar a viver direito.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257540
    m_Localized: 'Wifefema: Agora sim!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257539
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257538
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257537
    m_Localized: 'Wifefema: Toda essa coisa de “FEMA não é para mulheres” é pura merda.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257536
    m_Localized: 'Wifefema: Eu trabalhava na fronteira. Tenho um nariz bom pra gente suspeita.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257535
    m_Localized: 'Wifefema: Não é justo, sabe? O que, não sou boa como o meu marido?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257534
    m_Localized: 'Wifefema: Importa de quê? Ela é da FEMA agora. E eu poderia ser também, se eles aceitassem mulheres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257533
    m_Localized: 'Wifefema: Heh, como se eu fosse falar. Por que quer saber?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257532
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257531
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257530
    m_Localized: 'Wifefema: Peguei vários vagabundos carregando todos os tipos de porcarias.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257529
    m_Localized: 'Wifefema: Eu costumava trabalhar na alfândega, sabe? Cuidava as pessoas atravessando a fronteira.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257528
    m_Localized: 'Wifefema: Uma pena, também. Eu seria ótima em farejar os Visitantes com o meu homem.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257527
    m_Localized: 'Wifefema: Heh, quem dera fosse. Mas não, eles não aceitam mulheres, quem diria.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257526
    m_Localized: O que o seu marido fazia antes disso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257525
    m_Localized: Você é da FEMA também?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257524
    m_Localized: 'Wifefema: O taxista maldito meteu a faca com esse preço.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257523
    m_Localized: 'Wifefema: Queria fazer uma surpresa, então gastei uma grana no táxi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257522
    m_Localized: 'Wifefema: Quando ouvi que levaram ele pra lá, eu fiquei maluca!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257521
    m_Localized: 'Wifefema: Ah, eu digo pra todos ouvirem! Ele trabalha para a FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257520
    m_Localized: O que o seu marido fazia antes disso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257519
    m_Localized: Você é da FEMA também?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257518
    m_Localized: 'Wifefema: Assim que meu queridinho da FEMA botar as mãos nele... Vai arrancar fora esses dentes branquinhos no soco. Heh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257517
    m_Localized: 'Wifefema: Mas juro por Deus, os dentes daquele taxista eram brancos como porcelana.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257516
    m_Localized: 'Wifefema: Precisei pagar uma fortuna. Essas coisas custam um rim ultimamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257515
    m_Localized: 'Wifefema: Como? Com um táxi, oras.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257514
    m_Localized: O que o seu marido faz?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257513
    m_Localized: Como você chegou aqui?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257512
    m_Localized: 'Wifefema: Mas parece que no trabalho dele não tem onde eu ficar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257511
    m_Localized: 'Wifefema: Achei que seria legal uma visita surpresa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257510
    m_Localized: 'Wifefema: Eu vim atrás do meu marido. Ele foi realocado por causa do trabalho.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257509
    m_Localized: 'Wifefema: Opa. Se importa se eu ficar aqui um pouco?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257508
    m_Localized: 'Theorist: Adeus. Eu acreditei em você... e você acabou com a minha fé na humanidade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257507
    m_Localized: 'Theorist: As pessoas merecem saber a verdade!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257506
    m_Localized: 'Theorist: Você está cometendo um erro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257505
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257504
    m_Localized: 'Theorist: Acredite em mim, eu vi a verdade! Esqueça dessas mentiras!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257503
    m_Localized: 'Theorist: Eu sabia que podia confiar em você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257502
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257501
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257500
    m_Localized: 'Theorist: Então eu saí de cabeça erguida. Com os poucos arquivos valiosos que tinha em mãos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257499
    m_Localized: 'Theorist: Se as pessoas tivessem simplesmente usado tampões de orelha... os parasitas não iriam conseguir entrar e milhares seriam salvos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257498
    m_Localized: 'Theorist: Mas aqueles imbecis se recusaram a ver o mérito das minhas descobertas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257497
    m_Localized: 'Theorist: Eu disse que os Visitantes não eram o perigo real. É o que tem dentro deles. Parasitas cerebrais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257496
    m_Localized: 'Theorist: Eu costumava trabalhar em um instituto de pesquisa. Eles me demitiram por causa das minhas descobertas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257495
    m_Localized: 'Theorist: Mas você tem que jurar que isso fica entre nós.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257494
    m_Localized: 'Theorist: Bom, eu escolhi confiar em você então vou falar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257493
    m_Localized: Você deveria sair
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257492
    m_Localized: Pode entrar
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257491
    m_Localized: 'Theorist: ... por quê salgadinhos sabor batata são tanto uma abominação científica quando um desastre sem sabor.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257490
    m_Localized: 'Theorist: Controle mental. Através de fast food. Sim, é real. E finalmente...'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257489
    m_Localized: 'Theorist: Fraude eleitoral. Provas de que o pouso na lua foi falso.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257488
    m_Localized: 'Theorist: Ah, meu amigo. Prepare-se. Estou prestes a abrir seus olhos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257487
    m_Localized: Onde você conseguiu tudo isso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257486
    m_Localized: Do que você está falando?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257485
    m_Localized: 'Theorist: O que significa... Que posso compartilhar algo com você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257484
    m_Localized: 'Theorist: Então já que você não se identificou isso então quer dizer que você deve estar contando a verdade.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257483
    m_Localized: 'Theorist: Veja, de acordo com o protocolo os agentes da FEMA são obrigados a se identificarem quando questionados.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257482
    m_Localized: 'Theorist: Ah, perfeito. Isso significa que posso confiar em você.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257481
    m_Localized: Onde você conseguiu tudo isso?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257480
    m_Localized: Que tipo de informação?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257479
    m_Localized: 'Theorist: Estamos falando de quilotons de dados, coisas que eu planejo soltar na mídia.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257478
    m_Localized: 'Theorist: Eu estou em posse de documentos confidenciais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257477
    m_Localized: 'Theorist: Preciso de um lugar seguro. Um lugar onde eu possa continuar minha pesquisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257476
    m_Localized: 'Theorist: Com informações importantíssimas, é claro!'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257475
    m_Localized: Não, eu não estou com a FEMA
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257474
    m_Localized: Confiar em relação ao quê, exatamente?
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257473
    m_Localized: 'Theorist: Você não tá com a... FEMA, né?'
    m_Metadata:
      m_Items: []
  - m_Id: 31158152833257472
    m_Localized: 'Theorist: Ei, oi. Me diz uma coisa, eu posso confiar em você?'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861319
    m_Localized: 'Firefighter: Aqui, eu não preciso disso de qualquer forma. Ou joga fora ou usa para outra coisa.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861318
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861317
    m_Localized: 'Firefighter: Queriam que fôssemos para as zonas de quarentena da FEMA. Mas quem vai para lá se todo mundo que vai morre...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861316
    m_Localized: 'Firefighter: Deram-nos esse papel no trabalho antes de irmos apagar o fogo.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861315
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861314
    m_Localized: 'Firefighter: Pelo menos não vou morrer no chão molhado.'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861313
    m_Localized: 'Firefighter: Acho que não vou atrapalhar por muito tempo. *tosse*'
    m_Metadata:
      m_Items: []
  - m_Id: 25631127038861312
    m_Localized: 'Firefighter: Valeu, cara. *tosse*'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
